fn crlf() -> String = from_code_points(['\r', '\n'])

## An ASCII code point as the character it names. Every call site below has
## already bounded the value (a byte read from a header, a nibble turned into a
## hex digit), so a failure here is a broken invariant and not an input.
## `char.of` is the checked bridge outside std; the unchecked one is internal.
fn char_of_code(n: Int) -> Char = char.of(n).expect("ASCII code point")

# ---- position mapping (offsets are UTF-16 code units, LSP's encoding) ----

fn line_of(ls: List[Int], offset: Int) -> Int = {
  var lo = 0
  var hi = len(ls) - 1
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if ls[mid] <= offset { lo = mid } else { hi = mid - 1 }
  }
  lo
}

## code-point offset → (0-based line, 0-based UTF-16 column), clamped. The line
## comes from the code-point line starts; the column is the UTF-16 distance from
## the line start (the wire encoding), read off the view's offset table. This is
## the only place code-point positions cross into UTF-16.
fn lsp_position(v: SourceView, ls: List[Int], cpoff: Int) -> (Int, Int) = {
  let n = len(v.cps)
  let clamped = if cpoff < 0 {
    0
  } else if cpoff > n {
    n
  } else {
    cpoff
  }
  let line = line_of(ls, clamped)
  (line, v.offs[clamped] - v.offs[ls[line]])
}

## (0-based line, 0-based UTF-16 column) → code-point offset, clamped to the
## line. The incoming UTF-16 column is resolved back to a code-point index by
## walking the line's offset table.
fn lsp_offset(v: SourceView, ls: List[Int], line0: Int, character: Int) -> Int = {
  let n = len(v.cps)
  if line0 < 0 { return 0 }
  if line0 >= len(ls) { return n }
  let line_start = ls[line0]
  let line_end = if line0 + 1 < len(ls) { ls[line0 + 1] - 1 } else { n }
  let target = v.offs[line_start] + character
  var cp = line_start
  while cp < line_end && v.offs[cp] < target { cp = cp + 1 }
  cp
}

fn jrange(v: SourceView, ls: List[Int], lo: Int, hi: Int) -> Json = {
  let (sl, sc) = lsp_position(v, ls, lo)
  let (el, ec) = lsp_position(v, ls, hi)
  jobj([("start", jpos(sl, sc)), ("end", jpos(el, ec))])
}

fn jpos(line: Int, ch: Int) -> Json =
  jobj([("line", JInt(line)), ("character", JInt(ch))])

## Run `body` with no host environment behind it, for the tests below whose
## `--std` is an absolute directory of their own making. `handle` above
## installs the real handler because a real editor session is what it serves.
fn no_host[T](body: fn() -> T !Env !Fs !io) -> T !Fs !io = {
  let (out, _) = envmem.with_env_table(envmem.TABLE_CWD, [], body)
  out
}

test "positions bridge code-point offsets and utf-16 columns at the boundary" {
  # "a🎈b\nx": 🎈 is one code point but two UTF-16 units. `b` is code-point
  # offset 2; on the wire it must be UTF-16 column 3, and the round trip back
  # must recover the same code-point offset.
  let text = "a🎈b\nx"
  let v = view_of(text)
  let ls = line_starts_of(text)
  let (l0, c0) = lsp_position(v, ls, 2)
  assert l0 == 0
  assert c0 == 3
  assert lsp_offset(v, ls, 0, 3) == 2
  let (l1, c1) = lsp_position(v, ls, 4)
  assert l1 == 1
  assert c1 == 0
}

# ---- json helpers ----

fn jobj(entries: List[(String, Json)]) -> Json = {
  var m: Map[String, Json] = map.empty()
  for e in entries {
    let (k, v) = e
    m = map.insert(m, k, v)
  }
  JObj(m)
}

fn oget(j: Json, k: String) -> Option[Json] =
  match j {
    JObj(m) -> map.get(m, k)
    _ -> None
  }

fn ostr(j: Json, k: String) -> String =
  match oget(j, k) {
    Some(JStr(s)) -> s
    _ -> ""
  }

fn oint(j: Json, k: String) -> Int =
  match oget(j, k) {
    Some(JNum(f)) -> to_int(f)
    Some(JInt(n)) -> n
    _ -> 0
  }

## Echo a request id the way lsp4j does: integral numbers render as integers.
fn echo_id(id: Json) -> Json =
  match id {
    JNum(f) -> {
      let n = to_int(f)
      if to_float(n) == f { JInt(n) } else { JNum(f) }
    }
    _ -> id
  }

# ---- uri ↔ path ----

fn hex_val(c: Char) -> Int =
  if c >= '0' && c <= '9' {
    char.code(c) - char.code('0')
  } else if c >= 'a' && c <= 'f' {
    char.code(c) - char.code('a') + 10
  } else if c >= 'A' && c <= 'F' {
    char.code(c) - char.code('A') + 10
  } else {
    -1
  }

## file:// URI → filesystem path, or None for anything this process cannot
## open as a local file (LSP-02).
##
## Four things the old two-line version got wrong, all of them shapes a real
## client sends:
##
## * **authority**. `file://server/share/x` used to yield the *relative* path
##   `server/share/x` -- a path that either does not exist or, worse, exists
##   somewhere unrelated. An empty authority (`file:///x`, what every editor
##   sends) and `localhost` mean "this machine"; any other host is a file this
##   process cannot open, so it is `None` rather than a guess.
## * **query and fragment**. A URI may carry `?` / `#`; a path may not. They
##   are cut before decoding, so a percent escape inside them cannot leak into
##   the path either.
## * **Windows drive letters**. `file:///C:/x` decodes to `/C:/x`, which is not
##   a path on the platform that spells it `C:/x`. A leading slash before a
##   drive letter is dropped -- harmless on POSIX, where no such path exists.
## * **percent-decoding is still validated** (LSP-01): a malformed sequence
##   becomes U+FFFD, so the result is a path that does not exist rather than a
##   path assembled from bytes nobody wrote.
pub fn uri_to_path(uri: String) -> Option[String] = {
  if not str.starts_with(uri, "file://") { return None }
  var rest = str.strip_prefix(uri, "file://").unwrap_or(uri)
  # authority: everything before the first `/` of the path
  if not str.starts_with(rest, "/") {
    let cut = match str.index_of(rest, "/") {
      Some(i) -> i
      None -> str.len(rest)
    }
    let authority = str.take(rest, cut)
    if authority != "" && str.to_lower(authority) != "localhost" { return None }
    rest = str.drop(rest, cut)
  }
  # a path carries neither query nor fragment
  match str.index_of(rest, "#") {
    Some(i) -> { rest = str.take(rest, i) }
    None -> ()
  }
  match str.index_of(rest, "?") {
    Some(i) -> { rest = str.take(rest, i) }
    None -> ()
  }
  if rest == "" { return None }
  rest = drive_path(rest)
  # percent-decode into UTF-8 bytes, then decode
  var bs: List[Int] = []
  let cps = code_points(rest)
  var i = 0
  let n = len(cps)
  while i < n {
    let c = cps[i]
    if c == '%' && i + 2 < n {
      let h = hex_val(cps[i + 1])
      let l = hex_val(cps[i + 2])
      if h >= 0 && l >= 0 {
        bs = bs ++ [h * 16 + l]
        i = i + 3
      } else {
        bs = bs ++ utf8_bytes(c)
        i = i + 1
      }
    } else {
      bs = bs ++ utf8_bytes(c)
      i = i + 1
    }
  }
  Some(utf8_decode(bs))
}

## Decode UTF-8 bytes to a string (percent-decoded URI bytes), validating
## (LSP-01): a continuation byte must be 0x80..0xBF, an overlong encoding, a
## surrogate and anything past U+10FFFF are malformed. Each malformed
## sequence becomes one U+FFFD and decoding resumes at the next byte — the
## URI came from an editor, and a bad one should degrade, not crash or smuggle
## a code point the encoder could never have produced. One pure-Dawn
## implementation, shared by both toolchains (the JDK is not on the native
## side, and an unvalidating decoder was not worth keeping on either).
fn utf8_decode(bs: List[Int]) -> String = {
  var cps: List[Int] = []
  var i = 0
  let n = len(bs)
  while i < n {
    let b0 = bs[i]
    if b0 < 128 {
      cps = cps ++ [b0]
      i = i + 1
    } else if b0 >= 194 && b0 <= 223 && i + 1 < n && is_cont(bs[i + 1]) {
      # 0xC2..0xDF: two bytes; 0xC0/0xC1 would be overlong and fall through
      cps = cps ++ [(b0 - 192) * 64 + (bs[i + 1] - 128)]
      i = i + 2
    } else if b0 >= 224 && b0 <= 239 && i + 2 < n && is_cont(bs[i + 1]) &&
      is_cont(bs[i + 2]) {
        let cp = (b0 - 224) * 4096 + (bs[i + 1] - 128) * 64 + (bs[i + 2] - 128)
        # below 0x800 is overlong; D800..DFFF is a surrogate
        if cp < 2048 || (cp >= 55296 && cp <= 57343) {
          cps = cps ++ [65533]
          i = i + 1
        } else {
          cps = cps ++ [cp]
          i = i + 3
        }
      } else if b0 >= 240 && b0 <= 244 && i + 3 < n && is_cont(bs[i + 1]) &&
      is_cont(bs[i + 2]) && is_cont(bs[i + 3]) {
        let cp = (b0 - 240) * 262144 + (bs[i + 1] - 128) * 4096 +
          (bs[i + 2] - 128) * 64 + (bs[i + 3] - 128)
        # below 0x10000 is overlong; above 0x10FFFF is out of range
        if cp < 65536 || cp > 1114111 {
          cps = cps ++ [65533]
          i = i + 1
        } else {
          cps = cps ++ [cp]
          i = i + 4
        }
      } else {
        # lone continuation, overlong lead (C0/C1), out-of-range lead (F5..FF),
        # or a truncated sequence
        cps = cps ++ [65533]
        i = i + 1
      }
  }
  # every branch above has already established its value is a scalar -- the
  # overlong, surrogate and out-of-range cases are the ones that become U+FFFD
  from_code_points(list.map(cps, c => char_of_code(c)))
}

fn is_cont(b: Int) -> Bool = b >= 128 && b <= 191

test "file URIs: authority, query, fragment and drive letters (LSP-02)" {
  # the shape every editor sends
  assert uri_to_path("file:///tmp/a.dawn") == Some("/tmp/a.dawn")
  # localhost means this machine; another host is a file we cannot open
  assert uri_to_path("file://localhost/tmp/a.dawn") == Some("/tmp/a.dawn")
  assert uri_to_path("file://server/share/a.dawn") == None
  # a path carries neither query nor fragment
  assert uri_to_path("file:///tmp/a.dawn?v=2") == Some("/tmp/a.dawn")
  assert uri_to_path("file:///tmp/a.dawn#L10") == Some("/tmp/a.dawn")
  # a drive-letter path does not begin with a separator...
  assert uri_to_path("file:///C:/src/a.dawn") == Some("C:/src/a.dawn")
  # ...and a single letter without a colon is not a drive
  assert uri_to_path("file:///c/src/a.dawn") == Some("/c/src/a.dawn")
  # non-file schemes and the empty path stay None
  assert uri_to_path("http://x/y") == None
  assert uri_to_path("file://") == None
  # the other direction roots what it emits: three slashes, never two
  assert path_to_uri("/tmp/a.dawn") == "file:///tmp/a.dawn"
  assert path_to_uri("C:/src/a.dawn") == "file:///C:/src/a.dawn"
  # and both directions compose, drive letter included
  let accented = "/tmp/caf" ++ from_code_points(['\u{00E9}']) ++ ".dawn"
  assert uri_to_path(path_to_uri(accented)) == Some(accented)
}

test "uri decoding validates utf-8 instead of trusting it" {
  let fffd = from_code_points(['\u{FFFD}'])
  # the happy path: percent-encoded multibyte decodes exactly (U+00E9)
  assert uri_to_path("file:///tmp/caf%C3%A9.dawn") ==
    Some("/tmp/caf" ++ from_code_points(['\u{00E9}']) ++ ".dawn")
  # a continuation byte that never comes: C3 '(' is malformed, becomes U+FFFD
  assert uri_to_path("file:///a%C3%28b") == Some("/a" ++ fffd ++ "(b")
  # overlong '/' (C0 AF) must not decode to '/': two malformed bytes
  assert uri_to_path("file:///x%C0%AFy") == Some("/x" ++ fffd ++ fffd ++ "y")
  # a surrogate half is not a code point
  assert uri_to_path("file:///s%ED%A0%80e") == Some("/s" ++ fffd ++ fffd ++ fffd ++ "e")
  # a lone continuation byte
  assert uri_to_path("file:///l%80r") == Some("/l" ++ fffd ++ "r")
}

fn utf8_bytes(c: Char) -> List[Int] = {
  let cp = char.code(c)
  if cp < 128 {
    [cp]
  } else if cp < 2048 {
    [192 + cp / 64, 128 + cp % 64]
  } else if cp < 65536 {
    [224 + cp / 4096, 128 + cp / 64 % 64, 128 + cp % 64]
  } else {
    [240 + cp / 262144, 128 + cp / 4096 % 64, 128 + cp / 64 % 64, 128 + cp % 64]
  }
}

fn uri_ok(c: Char) -> Bool =
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
  c == '/' || c == '-' || c == '_' || c == '.' || c == '~' ||
  # ':' is a legal path character (RFC 3986 pchar) and has to survive
  # unencoded, or a Windows drive would round-trip as `%3A` -- readable to a
  # parser, unrecognisable to a human reading the log
  c == ':'

## `/C:/x` → `C:/x`: a drive-letter path does not begin with a separator.
## Left alone anywhere else, including `/c/x` (a single letter is not a drive
## without the colon) and plain POSIX paths.
fn drive_path(p: String) -> String = {
  let cps = code_points(p)
  if len(cps) < 3 { return p }
  if cps[0] != '/' { return p }
  let c = cps[1]
  let alpha = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
  if alpha && cps[2] == ':' { str.drop(p, 1) } else { p }
}

## filesystem path → file:// URI, with the empty authority the standard asks
## for: `file:///x`, never `file://x` (LSP-02). A Windows path (`C:/x`) gains
## the leading slash it needs -- without it the drive letter would parse as the
## authority, and the URI would name a host called `C:`.
pub fn path_to_uri(path: String) -> String = {
  var out: List[Char] = []
  for c in code_points(path) {
    if uri_ok(c) {
      out = out ++ [c]
    } else {
      for b in utf8_bytes(c) {
        out = out ++ ['%', hex_digit(b / 16), hex_digit(b % 16)]
      }
    }
  }
  let body = from_code_points(out)
  let rooted = if str.starts_with(body, "/") { body } else { "/${body}" }
  "file://${rooted}"
}

fn hex_digit(v: Int) -> Char =
  char_of_code(if v < 10 { char.code('0') + v } else { char.code('A') + v - 10 })

# ---- document and workspace ownership ----

## Host-specific Java setup without leaking Java-backed modules into this
## shared server. A project failure is already located at dawn.toml/dawn.lock
## so the server can publish it as an ordinary project diagnostic. `ct` is the
## comptime budget behind the server's analysis; both hosts pass ir/interp
## `ct_lsp`, which is narrower than a build's.
pub type LspLeaseHost = {
  standalone: fn() -> JsigLease !io,
  project: fn(source.SourcePlan) -> Result[JsigLease, LocDiag] !io,
  ct: CtOpts
}

## Analysis policy is fixed before any lease-backed owner is created. The
## ordinary entry reuses every module step whose input and entering carry are
## unchanged (driver/incremental), and every parse whose text is; `Cold`
## re-parses and re-checks every module, which is the reference a reusing
## session is compared against.
pub type LspAnalysisMode = Legacy | Cold
pub type LspAnalysisConfig = { mode: LspAnalysisMode, max_modules: Int }

pub fn legacy_analysis_config() -> LspAnalysisConfig =
  LspAnalysisConfig { mode: Legacy, max_modules: 128 }

fn validate_analysis_config(config: LspAnalysisConfig) -> Unit = {
  if config.max_modules < 0 {
    panic("negative LSP analysis cache limit")
  }
}

type WorkspaceIdentity = {
  source_root: String,
  lookup_key: String
}

## Length-prefixed components make the canonical path pair injective without
## assuming that any ordinary path character is unavailable as a separator.
fn workspace_key_part(value: String) -> String =
  to_string(str.len(value)) ++ ":" ++ value

## Both halves are identities (`canon_identity`), so a file an editor opens
## through a link and one it opens through the real path are members of one
## workspace and meet the duplicate-text rule there (#207).
fn workspace_identity(plan: ProjectPlan) -> WorkspaceIdentity !Fs !Env = {
  let project = canon_identity(plan.source.project)
  let source_root = canon_identity(plan.source.source_root)
  WorkspaceIdentity {
    source_root: source_root,
    lookup_key: workspace_key_part(project) ++ workspace_key_part(source_root)
  }
}

type DocAnalysis =
  | Standalone(prog: Program, entry: String, modules: Option[Map[String, String]])
  | WorkspaceMember(identity: WorkspaceIdentity)

type Doc = {
  uri: String,
  version: Int,
  path: Option[String],
  canonical_path: Option[String],
  text: String,
  view: SourceView,
  ls: List[Int],
  analysis: DocAnalysis
}

## A target whose Java setup succeeded. `prog = None` is an intentional
## fail-closed conflict snapshot, never the previous successful program.
type Workspace = {
  plan: ProjectPlan,
  path_by_uri: Map[String, String],
  prog: Option[Program],
  entry_by_uri: Map[String, String],
  lease: JsigLease,
  cache: incremental.Session,
  analysis_stats: Option[incremental.Stats],
  # the parses of the latest load, which the next one reuses for every file
  # whose text is unchanged. Never evicted: a parse is a function of the text
  # alone and cannot go stale, and the latest load's files are all it holds.
  parses: ParseMemo,
  diag_by_uri: Map[String, List[Json]],
  # the setup failure of the latest manifest refresh, which left this
  # workspace in place (its plan and lease are the ones that last succeeded).
  # Kept beside the program rather than in `diag_by_uri` because every
  # rebuild recomputes that map; cleared by the next refresh that succeeds.
  refresh_problem: Option[LocDiag],
  # what workspace references read (`refs_world`): None until the first
  # request; marked out of date by every rebuild, dropped with a conflict
  world: Option[RefsWorld]
}

## The program references search (docs/lsp-references-design.md §R2): the
## open documents and every other module of the project's tree, so that a use
## in a file no open document imports is found. It is not the program the
## diagnostics come from, which stays the open documents' import closure: an
## editor pays for the rest of the tree only once it asks for references.
## It has its own session, so its modules' steps are remembered between
## requests the way `prog`'s are between edits, and its own parses.
type RefsWorld = {
  # the tree's modules, as the walk spelled them; walked again each time
  # the program is analyzed, so a module created since is read
  seeds: List[String],
  cache: incremental.Session,
  parses: ParseMemo,
  prog: Option[Program],
  # the text each module of `prog` was analyzed from, by module path
  texts: Map[String, String],
  # the reference index, by module path: one entry per module whose step the
  # session still holds as it was when the entry was read. Bringing the
  # program up to date keeps exactly the entries of the steps it reused; a
  # request fills in the rest (`workspace_references`).
  refs: Map[String, ModRefs],
  # whether `prog` was analyzed from the documents as they are now
  current: Bool
}

## Maven, lock or loader setup failed before a usable workspace existed. Open
## buffers remain here for formatting and a later explicit retry, but semantic
## queries cannot observe a stale or half-installed program.
type UnavailableWorkspace = {
  plan: ProjectPlan,
  path_by_uri: Map[String, String],
  problem: LocDiag,
  diag_by_uri: Map[String, List[Json]]
}

type WorkspaceSlot = Ready(workspace: Workspace) | Unavailable(workspace: UnavailableWorkspace)

type Analysis = {
  prog: Program,
  entry: String,
  modules: Option[Map[String, String]],
  workspace_key: Option[String],
  definition_root: Option[String]
}

fn workspace_modules(ws: Workspace, current_uri: String) -> Map[String, String] = {
  let current_entry = map.get(ws.entry_by_uri, current_uri).expect("current workspace entry")
  var out = map.remove(ws.plan.modules.by_use, current_entry)
  for uri in sort(map.keys(ws.entry_by_uri)) {
    let entry = map.get(ws.entry_by_uri, uri).expect("workspace entry")
    if entry != current_entry {
      let path = map.get(ws.path_by_uri, uri).expect("workspace path")
      out = map.insert(out, entry, path)
    }
  }
  out
}

## The only semantic ownership seam. Every feature either gets one coherent
## analysis or fails closed while a workspace is unavailable/conflicted.
fn analysis_of(st: LspState, d: Doc) -> Option[Analysis] =
  match d.analysis {
    Standalone(prog, entry, modules) -> Some(Analysis {
      prog: prog,
      entry: entry,
      modules: modules,
      workspace_key: None,
      definition_root: None
    })
    WorkspaceMember(identity) ->
      match map.get(st.workspaces, identity.lookup_key) {
        Some(Ready(ws)) ->
          match ws.prog {
            Some(prog) ->
              match map.get(ws.entry_by_uri, d.uri) {
                Some(entry) -> Some(Analysis {
                  prog: prog,
                  entry: entry,
                  modules: Some(workspace_modules(ws, d.uri)),
                  workspace_key: Some(identity.lookup_key),
                  definition_root: Some(identity.source_root)
                })
                None -> None
              }
            None -> None
          }
        _ -> None
      }
  }

fn doc_qcx(st: LspState, d: Doc, analysis: Analysis) -> Option[QCx] = {
  let entry = list.find(analysis.prog.modules, cm => cm.mod_path == analysis.entry)
  match entry {
    Some(e) -> Some(module_qcx(st, analysis.prog, program_exports(st, analysis.prog), e, d.view.cps))
    None -> None
  }
}

## Every export surface in the program, std's and each module's own, before
## anyone's visibility is applied. A request that reads many modules builds it
## once (docs/lsp-references-design.md §R2).
fn program_exports(st: LspState, prog: Program) -> Map[String, ModExports] = {
  var env = st.std.exports
  for cm in prog.modules {
    env = map.insert(env, cm.mod_path, exports_of(cm.cx, cm.m, cm.mod_path, cm.class_name))
  }
  env
}

## The query context of the module `e`, whose text's code points are `cps`.
fn module_qcx(st: LspState, prog: Program, env: Map[String, ModExports], e: CheckedMod, cps: List[Char]) -> QCx = {
  # every surface the editor offers from here on is the one this document
  # may name: the same `exports_seen_by` pass_imports applies, once, so a
  # completion never offers another package's `pub(pkg)` name
  let viewer = package_of(e.cx)
  var seen: Map[String, ModExports] = map.empty()
  for pr in map.entries(env) {
    let (path, exp) = pr
    seen = map.insert(seen, path, exports_seen_by(exp, viewer))
  }
  QCx {
    entry: e,
    prog: prog,
    std: st.std,
    exports_env: seen,
    bins: visible_bins(st.bins, e.cx),
    typed: typed_trees(e.tm),
    cps: cps
  }
}

type Lifecycle = PreInit | Running | Shutdown

type LifecycleGate =
  | LgActivate
  | LgDispatch
  | LgBeginShutdown
  | LgReject(code: Int, message: String)
  | LgIgnore
  | LgExit(code: Int)

type LspState = {
  std: StdCtx,
  bins: Map[String, Sig],
  docs: Map[String, Doc],
  workspaces: Map[String, WorkspaceSlot],
  standalone: Option[JsigLease],
  host: LspLeaseHost,
  analysis_config: LspAnalysisConfig,
  lifecycle: Lifecycle,
  # whether the client said at `initialize` that it accepts a dynamic
  # `workspace/didChangeWatchedFiles` registration (LSP 3.17 forbids sending
  # one otherwise); read once at `initialized`
  watch_manifests: Bool,
  # whether the client said at `initialize` that it reads
  # `relatedInformation` on a published diagnostic; without it a diagnostic's
  # notes are folded into its message instead (`diagnostic_json`)
  related_information: Bool,
  # the comment tables hover read docs from, by the text they were read from
  # (`doc_src_memo`, docs/lsp-hover-design.md §A3.4)
  doc_memo: Map[String, DocMemo],
  # which inlay hints the client asked for in `initializationOptions`
  # (`inlay_opts_of`, docs/lsp-hover-design.md §A4.3)
  inlay: InlayOpts,
  # whether the client applies `CompletionList.itemDefaults.data` (LSP 3.17);
  # then a completion reply names the document once instead of on every item
  # (`client_defaults_item_data`, docs/lsp-hover-design.md §D7.2)
  default_item_data: Bool
}

## One text's comment table, kept with the text it was lexed from: a lookup
## whose text differs, by any character, lexes again.
type DocMemo = { text: String, src: DocSrc }

## At most this many texts' comment tables are kept. A hover session touches
## a handful of files; past the bound the table starts over rather than
## tracking recency, which is all a cache this cheap to refill needs.
const DOC_MEMO_FILES: Int = 32

## The comment table of `text`, filed under `key` (which file it is), reused
## when the text is the one the kept table was lexed from.
fn doc_src_memo(st: LspState, key: String, text: String) -> (DocSrc, LspState) = {
  match map.get(st.doc_memo, key) {
    Some(m) -> if m.text == text { return (m.src, st) }
    None -> ()
  }
  let src = doc_src_of(text)
  let none: Map[String, DocMemo] = map.empty()
  let kept = if len(map.keys(st.doc_memo)) >= DOC_MEMO_FILES { none } else { st.doc_memo }
  (src, LspState { ..st, doc_memo: map.insert(kept, key, DocMemo { text: text, src: src }) })
}

fn analysis_session(st: LspState, js: Jsig) -> incremental.Session = {
  let config = st.analysis_config
  validate_analysis_config(config)
  match config.mode {
    Legacy -> incremental.new(st.std, st.host.ct, js, config.max_modules)
    Cold -> incremental.disable_reuse(incremental.new(st.std, st.host.ct, js, config.max_modules))
  }
}

## What a workspace keeps of a load's parses. `Cold` is the reference the
## reusing configuration is compared against, so it parses every file again
## as well.
fn retained_parses(st: LspState, parses: ParseMemo) -> ParseMemo =
  match st.analysis_config.mode {
    Legacy -> parses
    Cold -> no_parses()
  }

## Close one lease without allowing its failure to skip the remaining leases.
fn close_lease(lease: JsigLease) -> Unit !Console !io =
  match catch_panic(() => lease.close()) {
    Ok(_) -> ()
    Err(e) -> console_eprintln("lsp: failed to close a Java signature lease: " ++ e.message)
  }

## Release every host resource exactly once. Clearing ownership in the
## returned state makes shutdown followed by exit harmless.
fn close_all_leases(st0: LspState) -> LspState !Console !io = {
  # Neither query Programs nor document-owned Sessions may survive disposal
  # of the shared standalone oracle in the state returned by teardown.
  let none: Option[JsigLease] = None
  let no_workspaces: Map[String, WorkspaceSlot] = map.empty()
  let no_docs: Map[String, Doc] = map.empty()
  let st = LspState { ..st0, docs: no_docs, workspaces: no_workspaces, standalone: none }
  for workspace_key in sort(map.keys(st0.workspaces)) {
    match map.get(st0.workspaces, workspace_key).expect("workspace") {
      Ready(ws) -> close_lease(ws.lease)
      Unavailable(_) -> ()
    }
  }
  match st0.standalone {
    Some(lease) -> close_lease(lease)
    None -> ()
  }
  st
}

fn has_request_id(msg: Json) -> Bool =
  match oget(msg, "id") {
    Some(_) -> true
    None -> false
  }

fn is_response(msg: Json) -> Bool =
  match oget(msg, "method") {
    Some(_) -> false
    None ->
      match oget(msg, "result") {
        Some(_) -> true
        None ->
          match oget(msg, "error") {
            Some(_) -> true
            None -> false
          }
      }
  }

const ABNORMAL_EXIT_STATUS: Int = 1

fn lifecycle_gate(lifecycle: Lifecycle, msg: Json) -> LifecycleGate = {
  # A message with a result or an error and no method answers a request this
  # server sent (the watcher registration). It is not a request, and answering
  # it with MethodNotFound would be a reply to a reply.
  if is_response(msg) { return LgIgnore }
  let method = ostr(msg, "method")
  let request = has_request_id(msg)
  match lifecycle {
    PreInit -> {
      if method == "exit" && not request {
        LgExit(ABNORMAL_EXIT_STATUS)
      } else if method == "initialize" && request {
        LgActivate
      } else if request {
        LgReject(-32002, "Server not initialized")
      } else {
        LgIgnore
      }
    }
    Running -> {
      if method == "exit" && not request {
        LgExit(ABNORMAL_EXIT_STATUS)
      } else if method == "exit" && request {
        LgReject(-32600, "Invalid Request")
      } else if method == "initialize" {
        if request { LgReject(-32600, "Invalid Request") } else { LgIgnore }
      } else if method == "shutdown" {
        if request { LgBeginShutdown } else { LgIgnore }
      } else {
        LgDispatch
      }
    }
    Shutdown -> {
      if method == "exit" && not request {
        LgExit(0)
      } else if request {
        LgReject(-32600, "Invalid Request")
      } else {
        LgIgnore
      }
    }
  }
}

# ---- the server loop ----

## The `--std <dir>` a client passed on the server's command line, if any.
##
## Every other subcommand parses this; `lsp` did not, so there was not even an
## escape hatch when the default landed somewhere wrong.
pub fn lsp_std_flag(rest: List[String]) -> Option[String] = {
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      return Some(rest[i + 1])
    }
    i = i + 1
  }
  None
}

## The driver supplies resource factories rather than one process-global Java
## oracle. The JVM host creates a platform-only standalone lease and one lease
## per target; the native host creates lifecycle-compatible refusals.
pub fn run_lsp(std_flag: Option[String], host: LspLeaseHost) -> Unit !Fs !Proc !Env !Exit !Console !io =
  run_lsp_configured(std_flag, host, legacy_analysis_config())

## An explicit test/measurement entry, not a command-line or protocol switch.
pub fn run_lsp_configured(std_flag: Option[String], host: LspLeaseHost,
  config: LspAnalysisConfig) -> Unit !Fs !Proc !Env !Exit !Console !io = {
  validate_analysis_config(config)
  # The same order as every other subcommand (driver/stdlib `std_choice`):
  # the flag, then DAWN_STD, then the embedded copy. An editor spawns the
  # server with a cwd nobody chose, which is why this one stopped reading the
  # cwd first; the rest of the CLI followed in #291. `bin/dawn` exports
  # DAWN_STD from its own location, so a checkout's server still knows its own
  # std files as std.
  let std = match load_chosen_std(cli_std_choice(std_flag)) {
    Ok(sc) -> sc
    Err(e) -> panic(std_load_error_text(e))
  }
  let standalone = host.standalone()
  var st = LspState {
    std: std,
    bins: builtins(),
    docs: map.empty(),
    workspaces: map.empty(),
    standalone: Some(standalone),
    host: host,
    analysis_config: config,
    lifecycle: PreInit,
    watch_manifests: false,
    related_information: false,
    doc_memo: map.empty(),
    inlay: default_inlay_opts(),
    default_item_data: false
  }
  # The newest text of the one document whose analysis has not run yet.
  #
  # At most one, and that is what makes deferring the work invisible: an
  # update naming a *different* document flushes the one already waiting, so
  # analyses still happen in the order the client asked for. Only repeats of
  # the same document coalesce — which is the whole point, since `didChange`
  # is Full sync and each one supersedes the last.
  var pending: Option[(String, String, Int)] = None
  var serving = true
  var exit_status: Option[Int] = None
  while serving {
    # Three branches, and the third is what makes the second safe. Readiness
    # never reports end of input (std/io.stdin_ready says why), so a loop that
    # only ever waited on it would spin the moment its client went away. With
    # nothing pending there is nothing to wait for and blocking is the right
    # thing to do — and the blocking read is what reports end of input.
    let take = match pending {
      Some(_) -> io.stdin_ready(DEBOUNCE_MS)
      None -> true
    }
    if take {
      match read_message() {
        Eof -> { serving = false }
        Message(msg) -> {
          let gate = lifecycle_gate(st.lifecycle, msg)
          match gate {
            LgActivate -> {
              st = LspState { ..st, lifecycle: Running }
              st = handle(st, msg)
            }
            LgDispatch ->
              match update_of(msg) {
                Some(u) -> {
                  let (uri, text, version) = u
                  match pending {
                    Some(p0) -> {
                      let (uri0, _, _) = p0
                      if uri0 != uri { st = flush(st, pending) }
                    }
                    None -> ()
                  }
                  pending = Some((uri, text, version))
                }
                # Anything else may read the analysed program or write about it,
                # so the deferred work has to have happened first. That is also
                # why the deferral is not observable: every answer about a
                # document passes this point.
                None -> {
                  st = flush(st, pending)
                  pending = None
                  st = handle(st, msg)
                }
              }
            LgBeginShutdown -> {
              pending = None
              st = LspState { ..st, lifecycle: Shutdown }
              st = handle(st, msg)
              st = close_all_leases(st)
            }
            LgReject(code, message) -> {
              let id = match oget(msg, "id") {
                Some(value) -> value
                None -> JNull
              }
              respond_error(id, code, message)
            }
            LgIgnore -> ()
            LgExit(code) -> {
              pending = None
              exit_status = Some(code)
              serving = false
            }
          }
        }
        # The declared body was read in full, so malformed JSON leaves the next
        # frame boundary known and the session can continue.
        Malformed(code, why) -> {
          st = flush(st, pending)
          pending = None
          send(jobj([("jsonrpc", JStr("2.0")), ("id", JNull),
            ("error", jobj([("code", JInt(code)), ("message", JStr(why))]))]))
        }
        # A framing failure has no trustworthy resynchronisation point. Emit
        # one fixed parse error and stop reading; bytes after the failure are
        # deliberately never interpreted as another frame.
        Fatal -> {
          pending = None
          send(jobj([("jsonrpc", JStr("2.0")), ("id", JNull),
            ("error", jobj([("code", JInt(-32700)), ("message", JStr("Parse error"))]))]))
          serving = false
        }
      }
    } else {
      # The window elapsed with nothing arriving: the client has stopped
      # typing, so analyse the newest text it sent.
      st = flush(st, pending)
      pending = None
    }
  }
  st = close_all_leases(st)
  match exit_status {
    Some(code) -> { let _ = io.exit(code) }
    None -> ()
  }
}

## How long standard input must stay quiet before a pending edit is analysed.
##
## The wait happens inside `io.stdin_ready`, which sleeps rather than polls, so
## a session that is merely idle costs nothing — scripts/lsp-liveness.py's
## `idle` assertion measures exactly that, and its `debounce` assertion
## measures the coalescing this number buys.
##
## 150 ms is the design's placeholder and has no measurement behind it yet
## (docs/audit/lsp-robustness-design.md §六 step 4 is the job of finding one:
## time `didChange` → published diagnostics while typing into selfhost's own
## 31k lines). It is stated here rather than inlined so that step has one place
## to land.
const DEBOUNCE_MS: Int = 150

## Run the analysis a document sync deferred, if there is one.
fn flush(st: LspState, pending: Option[(String, String, Int)]) -> LspState !Fs !Proc !Env !Console !io =
  match pending {
    Some(p) -> {
      let (uri, text, version) = p
      update_doc(st, uri, text, version)
    }
    None -> st
  }

## The (uri, text, version) a document-sync notification carries, or `None`
## when the message is anything else. Keeping the version beside the text is
## what makes a debounced publish name the snapshot it actually analyzed.
##
## A sync notification with no text in it — `didChange` with an empty
## `contentChanges` — is `None` too, and lands in `handle` where it has always
## been ignored. There is nothing to defer about an update that carries no
## document.
fn update_of(msg: Json) -> Option[(String, String, Int)] = {
  let method = ostr(msg, "method")
  let params = match oget(msg, "params") {
    Some(j) -> j
    None -> JNull
  }
  let td = get_or_null(params, "textDocument")
  if method == "textDocument/didOpen" {
    Some((ostr(td, "uri"), ostr(td, "text"), oint(td, "version")))
  } else if method == "textDocument/didChange" {
    match oget(params, "contentChanges") {
      Some(JArr(changes)) ->
        match get(changes, 0) {
          Some(c) -> Some((ostr(td, "uri"), ostr(c, "text"), oint(td, "version")))
          None -> None
        }
      _ -> None
    }
  } else {
    None
  }
}

const HEADER_MAX_BYTES: Int = 8192
const BODY_MAX_BYTES: Int = 67108864

fn ascii_ci_equal(left: String, right: String) -> Bool = {
  let left_cps = code_points(left)
  let right_cps = code_points(right)
  if len(left_cps) != len(right_cps) { return false }
  var index = 0
  while index < len(left_cps) {
    let left_code = char.code(left_cps[index])
    let right_code = char.code(right_cps[index])
    let left_folded = if left_code >= char.code('A') && left_code <= char.code('Z') {
      left_code + 32
    } else {
      left_code
    }
    let right_folded = if right_code >= char.code('A') && right_code <= char.code('Z') {
      right_code + 32
    } else {
      right_code
    }
    if left_folded != right_folded { return false }
    index = index + 1
  }
  true
}

fn is_header_pad(code: Int) -> Bool = code == char.code(' ') || code == char.code('\t')

fn is_header_name_code(code: Int) -> Bool =
  (code >= char.code('a') && code <= char.code('z')) ||
  (code >= char.code('A') && code <= char.code('Z')) ||
  (code >= char.code('0') && code <= char.code('9')) ||
  code == char.code('!') || code == char.code('#') || code == char.code('$') ||
  code == char.code('%') || code == char.code('&') || code == char.code('\'') ||
  code == char.code('*') || code == char.code('+') || code == char.code('-') ||
  code == char.code('.') || code == char.code('^') || code == char.code('_') ||
  code == char.code('`') || code == char.code('|') || code == char.code('~')

fn valid_header_name(name: String) -> Bool = {
  let cps = code_points(name)
  if len(cps) == 0 { return false }
  for cp in cps {
    if not is_header_name_code(char.code(cp)) { return false }
  }
  true
}

## Content-Length is deliberately not parsed by the language's general
## `parse_int`: the wire grammar has no sign and trims only SP/HTAB. Accumulate
## negatively so an oversized decimal is rejected before any host conversion.
fn parse_content_length_value(raw: String) -> Option[Int] = {
  let cps = code_points(raw)
  var first = 0
  var last = len(cps)
  while first < last && is_header_pad(char.code(cps[first])) { first = first + 1 }
  while last > first && is_header_pad(char.code(cps[last - 1])) { last = last - 1 }
  if first == last { return None }

  let limit = 0 - 9223372036854775807
  let multmin = limit / 10
  var value = 0
  var index = first
  while index < last {
    let code = char.code(cps[index])
    if code < char.code('0') || code > char.code('9') { return None }
    let digit = code - char.code('0')
    if value < multmin { return None }
    value = value * 10
    if value < limit + digit { return None }
    value = value - digit
    index = index + 1
  }
  Some(0 - value)
}

## Parse the completed header block. Duplicate Content-Length fields agree by
## value, not spelling; any invalid occurrence poisons the whole frame.
fn parse_content_length(header: String) -> Option[Int] = {
  if str.len(header) > HEADER_MAX_BYTES || not str.ends_with(header, "\r\n\r\n") {
    return None
  }
  var found: Option[Int] = None
  for line in str.split(header, "\r\n") {
    if line != "" {
      match str.split_once(line, ":") {
        Some((name, raw)) -> {
          if not valid_header_name(name) { return None }
          if ascii_ci_equal(name, "Content-Length") {
            let parsed = match parse_content_length_value(raw) {
              Some(value) -> value
              None -> return None
            }
            if parsed > BODY_MAX_BYTES { return None }
            match found {
              Some(previous) -> if previous != parsed { return None }
              None -> { found = Some(parsed) }
            }
          }
        }
        None -> return None
      }
    }
  }
  found
}

test "Content-Length accepts exact wire bounds and ASCII spelling variants" {
  let suffix = "\r\nContent-Length: 0\r\n\r\n"
  let exact = "X:" ++ str.repeat("a", HEADER_MAX_BYTES - 2 - str.len(suffix)) ++ suffix
  assert str.len(exact) == HEADER_MAX_BYTES
  assert parse_content_length(exact) == Some(0)
  assert parse_content_length("X:a${exact}") == None

  assert parse_content_length("Content-Length: 0\r\n\r\n") == Some(0)
  assert parse_content_length("cOnTeNt-LeNgTh:\t 00042 \t\r\n\r\n") == Some(42)
  assert parse_content_length("Content-Length: 67108864\r\n\r\n") == Some(67108864)
  assert parse_content_length("Content-Length: 67108865\r\n\r\n") == None
}

test "Content-Length is unsigned ASCII decimal within Int range" {
  for value in [
    "", "+1", "-0", "1.0", "1e2", "1_0", "４",
    "9223372036854775808", "2147483648"
  ] {
    assert parse_content_length("Content-Length: " ++ value ++ "\r\n\r\n") == None
  }
}

test "duplicate Content-Length fields agree by parsed value" {
  assert parse_content_length(
    "Content-Length: 42\r\ncontent-length:\t00042 \t\r\n\r\n"
  ) == Some(42)
  assert parse_content_length(
    "Content-Length: 42\r\nCONTENT-LENGTH: 43\r\n\r\n"
  ) == None
  assert parse_content_length(
    "Content-Length: 42\r\nCONTENT-LENGTH: +42\r\n\r\n"
  ) == None
  assert parse_content_length("X-Test: value\r\n\r\n") == None
}

test "header lines require a nonempty ASCII token name" {
  assert parse_content_length(
    "X-Test: ignored\r\nContent-Length: 0\r\n\r\n"
  ) == Some(0)
  for line in ["NoColon", ": value", "Bad Name: value", "Bad(Name): value"] {
    assert parse_content_length("${line}\r\nContent-Length: 0\r\n\r\n") == None
  }
}

fn bytes_of(values: List[Int]) -> Bytes = {
  var out = bytes.buf()
  for value in values { out = bytes.put(out, value) }
  bytes.freeze(out)
}

## The outcome of one read. `Malformed` is reserved for a complete, bounded
## frame whose JSON body is bad and therefore leaves the next boundary known;
## framing errors are fatal because their next byte cannot be trusted.
type Frame = Eof | Message(value: Json) | Malformed(code: Int, why: String) | Fatal

## A complete body, decoded and parsed. LSP JSON must reject malformed UTF-8
## rather than accept its replacement decoding, so the strict decoder is the
## boundary: `decode_utf8_checked` answers `Ok` for exactly the inputs the
## lossy one returns unchanged (LIB-06).
fn decode_body(body: Bytes) -> Frame =
  match bytes.decode_utf8_checked(body) {
    Ok(text) -> match parser.parse(text) {
      Ok(j) -> Message(j)
      Err(e) -> Malformed(-32700, "Parse error: ${error_text(e)}")
    }
    Err(_) -> Malformed(-32700, "Parse error: invalid UTF-8")
  }

test "LSP bodies require strict UTF-8 before decoding" {
  assert decode_body(bytes.utf8("\"plain 中😀�\"")) == Message(JStr("plain 中😀�"))
  # Replacement decoding turns each of these into the valid JSON string "�";
  # accepting the decoded text would therefore hide an invalid wire body.
  assert decode_body(bytes_of([0x22, 0x80, 0x22])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
  assert decode_body(bytes_of([0xC0, 0xAF])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
  assert decode_body(bytes_of([0xED, 0xA0, 0x80])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
  assert decode_body(bytes_of([0xF4, 0x90, 0x80, 0x80])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
  assert decode_body(bytes_of([0xE2, 0x82])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
}

## One framed message: headers to CRLFCRLF, then Content-Length bytes of JSON.
fn read_message() -> Frame !io = {
  var header: List[Int] = []
  var state = 0
  while state < 4 {
    let one = io.read_stdin(1)
    if bytes.len(one) == 0 {
      return if len(header) == 0 { Eof } else { Fatal }
    } else {
      let b = bytes.at(one, 0)
      header = header ++ [b]
      # CR LF CR LF
      if state == 0 && b == char.code('\r') {
        state = 1
      } else if state == 1 && b == char.code('\n') {
        state = 2
      } else if state == 2 && b == char.code('\r') {
        state = 3
      } else if state == 3 && b == char.code('\n') {
        state = 4
      } else {
        state = if b == char.code('\r') { 1 } else { 0 }
      }
      # Completion on byte 8192 is legal. Anything still incomplete at that
      # point is fatal immediately; byte 8193 is never read or accumulated.
      if state < 4 && len(header) >= HEADER_MAX_BYTES { return Fatal }
    }
  }
  # Preserve one code point per byte; Content-Length itself is ASCII-only.
  let htext = from_code_points(list.map(header, b => char_of_code(b)))
  let clen = match parse_content_length(htext) {
    Some(value) -> value
    None -> return Fatal
  }
  # The cap was checked by the pure parser before this call. Neither JVM's
  # L2I nor native's allocation can therefore observe an unbounded value.
  let body = io.read_stdin(clen)
  if bytes.len(body) < clen { return Fatal }
  # Exactly clen bytes were consumed, so a Malformed body still leaves the
  # next frame starting where it should.
  decode_body(body)
}

fn send(j: Json) -> Unit !io = {
  let payload = render(j)
  let n = bytes.len(bytes.utf8(payload))
  print("Content-Length: " ++ to_string(n) ++ crlf() ++ crlf() ++ payload)
}

fn respond(id: Json, result: Json) -> Unit !io =
  send(jobj([("jsonrpc", JStr("2.0")), ("id", echo_id(id)), ("result", result)]))

fn respond_error(id: Json, code: Int, message: String) -> Unit !io =
  send(jobj([
    ("jsonrpc", JStr("2.0")),
    ("id", echo_id(id)),
    ("error", jobj([("code", JInt(code)), ("message", JStr(message))]))
  ]))

fn notify(method: String, params: Json) -> Unit !io =
  send(jobj([("jsonrpc", JStr("2.0")), ("method", JStr(method)), ("params", params)]))

## One message, under the real file system, real processes and the real
## environment. The handlers are installed per message rather than once around
## the read loop because the loop's state threads through `var`s the loop
## reads back, and `with` cannot see a `var` declared before it (spec §4.10);
## the innermost boundary that owns a whole unit of work is the message.
## `Proc` arrives here through the project plan, which may fetch a url
## dependency, and `Env` through the same plan's `canon`.
fn handle(st0: LspState, msg: Json) -> LspState !io =
  io.with_fs_real(() =>
      io.with_proc_real(() => io.with_env_real(() =>
          io.with_console_real(() => handle_fs(st0, msg)))))

## The `serverInfo` of the `initialize` result (LSP 3.15): which build is
## answering. A client that starts `dawn` off PATH can run a stale toolchain
## for weeks without anything saying so; the editor prints this line instead.
fn server_info() -> Json =
  jobj([("name", JStr("dawn")), ("version", JStr(VERSION))])

test "serverInfo names the build that answers" {
  assert ostr(server_info(), "name") == "dawn"
  assert ostr(server_info(), "version") == VERSION
}

fn handle_fs(st0: LspState, msg: Json) -> LspState !Fs !Proc !Env !Console !io = {
  var st = st0
  let method = ostr(msg, "method")
  let id = match oget(msg, "id") {
    Some(j) -> j
    None -> JNull
  }
  let params = match oget(msg, "params") {
    Some(j) -> j
    None -> JNull
  }
  if method == "initialize" {
    st = LspState {
      ..st,
      watch_manifests: client_watches_files(params),
      related_information: client_relates_diagnostics(params),
      inlay: inlay_opts_of(params),
      default_item_data: client_defaults_item_data(params)
    }
    respond(id, jobj([("capabilities", jobj([
      ("textDocumentSync", JInt(1)),
      ("hoverProvider", JBool(true)),
      ("completionProvider", jobj([
        ("resolveProvider", JBool(true)),
        ("triggerCharacters", JArr([JStr("!")]))
      ])),
      ("signatureHelpProvider", jobj([
        ("triggerCharacters", JArr([JStr("("), JStr(",")]))
      ])),
      ("definitionProvider", JBool(true)),
      ("referencesProvider", JBool(true)),
      ("documentHighlightProvider", JBool(true)),
      ("renameProvider", jobj([("prepareProvider", JBool(true))])),
      ("documentSymbolProvider", JBool(true)),
      ("documentFormattingProvider", JBool(true)),
      ("codeActionProvider", JBool(true)),
      ("inlayHintProvider", JBool(true)),
      ("semanticTokensProvider", semantic_tokens_provider())
    ])), ("serverInfo", server_info())]))
  } else if method == "initialized" {
    if st.watch_manifests { send(manifest_watch_registration()) }
  } else if method == "textDocument/didOpen" || method == "textDocument/didChange" {
    # `update_of` claimed every sync notification that carried a document, so
    # what reaches here is one that carried none — nothing to analyse, which
    # is what this arm did with it before the read loop debounced.
    ()
  } else if method == "textDocument/didClose" {
    let td = get_or_null(params, "textDocument")
    let uri = ostr(td, "uri")
    st = close_doc(st, uri)
  } else if method == "textDocument/didSave" {
    let td = get_or_null(params, "textDocument")
    let uri = ostr(td, "uri")
    # a client whose selector covers dawn.toml saves it as a document, and
    # that save is the same event a file watcher would have reported
    st = match manifest_path_of(uri) {
      Some(path) -> refresh_manifests(st, set.from([path]))
      None -> retry_unavailable(st, uri)
    }
  } else if method == "workspace/didChangeWatchedFiles" {
    st = refresh_manifests(st, watched_manifests(params))
    st = sources_changed(st, params)
  } else if method == "textDocument/completion" {
    respond(id, handle_completion(st, params))
  } else if method == "completionItem/resolve" {
    let (reply, st2) = handle_completion_resolve(st, params)
    respond(id, reply)
    st = st2
  } else if method == "textDocument/hover" {
    let (reply, st2) = handle_hover(st, params)
    respond(id, reply)
    st = st2
  } else if method == "textDocument/signatureHelp" {
    let (reply, st2) = handle_signature_help(st, params)
    respond(id, reply)
    st = st2
  } else if method == "textDocument/definition" {
    respond(id, handle_definition(st, params))
  } else if method == "textDocument/references" {
    let (reply, st2) = handle_references(st, params)
    respond(id, reply)
    st = st2
  } else if method == "textDocument/prepareRename" || method == "textDocument/rename" {
    let (reply, st2) = if method == "textDocument/rename" { handle_rename(st, params) } else { handle_prepare_rename(st, params) }
    match reply {
      Ok(r) -> respond(id, r)
      # RequestFailed: the editor shows the message
      Err(why) -> respond_error(id, -32803, why)
    }
    st = st2
  } else if method == "textDocument/documentHighlight" {
    respond(id, handle_document_highlight(st, params))
  } else if method == "textDocument/documentSymbol" {
    respond(id, handle_symbols(st, params))
  } else if method == "textDocument/formatting" {
    respond(id, handle_formatting(st, params))
  } else if method == "textDocument/codeAction" {
    respond(id, handle_code_action(st, params))
  } else if method == "textDocument/inlayHint" {
    respond(id, handle_inlay_hint(st, params))
  } else if method == "textDocument/semanticTokens/full" {
    respond(id, handle_semantic_tokens(st, params, false))
  } else if method == "textDocument/semanticTokens/range" {
    respond(id, handle_semantic_tokens(st, params, true))
  } else if method == "shutdown" {
    respond(id, JNull)
  } else {
    # a request we do not implement: MethodNotFound; notifications are ignored
    if has_request_id(msg) {
      send(jobj([("jsonrpc", JStr("2.0")), ("id", echo_id(id)),
        ("error", jobj([
          ("code", JInt(-32601)),
          ("message", JStr("Unsupported request method: ${method}"))
        ]))]))
    }
  }
  st
}

fn get_or_null(j: Json, k: String) -> Json =
  match oget(j, k) {
    Some(v) -> v
    None -> JNull
  }

# ---- document sync ----

type WorkspaceInputs =
  | InputsReady(
    overlay: Map[String, String],
    entries: List[String],
    entry_by_uri: Map[String, String]
  )
  | InputsConflict(paths: Set[String])

## One published diagnostic. Its notes are in the same file, so each one's
## location is `uri` again. A client that declared
## `publishDiagnostics.relatedInformation` gets them as related locations it
## can jump to; any other client may not read that field (LSP 3.17 makes it a
## client capability), so it gets them folded into the message instead, one
## `note:` line each with the line it points at, in the order the CLI prints
## them (docs/diag-notes-design.md §4). A diagnostic without notes is the
## same JSON either way.
fn diagnostic_json(view: SourceView, ls: List[Int], uri: String, related: Bool, dg: Diag) -> Json = {
  var message = dg.msg
  if not related {
    for n in dg.notes {
      let (line, _) = lsp_position(view, ls, n.lo)
      message = message ++ "\nnote: " ++ n.msg ++ " (line ${to_string(line + 1)})"
    }
  }
  if dg.hint != "" { message = message ++ "\nhint: " ++ dg.hint }
  var fields = [
    ("range", jrange(view, ls, dg.lo, dg.hi)),
    ("severity", JInt(1)),
    ("source", JStr("dawn")),
    ("message", JStr(message))
  ]
  if related && len(dg.notes) > 0 {
    var infos: List[Json] = []
    for n in dg.notes {
      infos = infos ++ [jobj([
        ("location", jobj([("uri", JStr(uri)), ("range", jrange(view, ls, n.lo, n.hi))])),
        ("message", JStr(n.msg))
      ])]
    }
    fields = fields ++ [("relatedInformation", JArr(infos))]
  }
  jobj(fields)
}

fn append_diagnostic(
  out0: Map[String, List[Json]],
  uri: String,
  value: Json
) -> Map[String, List[Json]] = {
  let before = match map.get(out0, uri) {
    Some(values) -> values
    None -> []
  }
  map.insert(out0, uri, before ++ [value])
}

fn add_loc_diag(
  st: LspState,
  path_by_uri: Map[String, String],
  out0: Map[String, List[Json]],
  ld: LocDiag
) -> Map[String, List[Json]] !Fs !Env = {
  var out = out0
  let target = canon_identity(ld.path)
  var matched = false
  for uri in sort(map.keys(path_by_uri)) {
    if map.get(path_by_uri, uri).expect("workspace path") == target {
      match map.get(st.docs, uri) {
        Some(d) -> {
          out = append_diagnostic(out, uri,
            diagnostic_json(d.view, d.ls, uri, st.related_information, ld.d))
          matched = true
        }
        None -> ()
      }
    }
  }
  if not matched {
    let text = match io.read_file(target) {
      Ok(found) -> found
      Err(_) -> ""
    }
    let uri = path_to_uri(target)
    out = append_diagnostic(out, uri,
      diagnostic_json(view_of(text), line_starts_of(text), uri, st.related_information, ld.d))
  }
  out
}

fn diagnostics_of_program(
  st: LspState,
  path_by_uri: Map[String, String],
  prog: Program
) -> Map[String, List[Json]] !Fs !Env = {
  var out: Map[String, List[Json]] = map.empty()
  # Positions go out to the editor, so they are resolved against the program
  # being published rather than against whatever revision produced them.
  for ld in rendered_diags(prog) { out = add_loc_diag(st, path_by_uri, out, ld) }
  out
}

## Every module under the project's source root, when the project has a
## manifest (docs/lsp-references-design.md §R2). A directory without one is
## where a loose file happens to sit, and its other files are not one program
## with it. The tree is walked again rather than read from the plan: the plan
## is as old as the workspace, and a module created since must be found.
fn project_seeds(plan: ProjectPlan) -> List[String] !Fs !Env = {
  if not io.exists(canon(plan.source.project) ++ "/dawn.toml") { return [] }
  var out: List[String] = []
  for f in project_files_now(plan) {
    match project_module_path(plan, f) {
      Some(_) -> { out = out ++ [f] }
      None -> ()
    }
  }
  out
}

## The references program of `ws`, brought up to date with the documents
## (§R2), or None while they conflict. The first call walks the tree and
## checks all of it; a later one after an edit reuses every step the edit
## left as it was, and keeps the index entries of exactly those modules.
## Every call that analyzes walks the tree again, so a module created or
## deleted since is in or out. A file no document holds can change on disk
## with no edit to say so: a watched-file notification marks the program out
## of date (`sources_changed`), and `verify` reads the files again whatever
## the client sent, which rename asks for because an edit computed from a
## stale text lands on the wrong characters.
fn refs_world(st: LspState, ws: Workspace, verify: Bool) -> Option[RefsWorld] !Fs !Env !io = {
  let w0 = match ws.world {
    Some(w) -> {
      if w.current && not (verify && world_stale(ws, w)) { return Some(w) }
      RefsWorld { ..w, seeds: project_seeds(ws.plan) }
    }
    None -> {
      let no_prog: Option[Program] = None
      RefsWorld {
        seeds: project_seeds(ws.plan), cache: analysis_session(st, ws.lease.jsig),
        parses: ws.parses, prog: no_prog, texts: map.empty(), refs: map.empty(), current: false
      }
    }
  }
  match workspace_inputs(st, ws.plan, ws.path_by_uri) {
    InputsConflict(_) -> None
    InputsReady(overlay, entries, _) -> {
      # the open documents first, then the rest of the tree; the loader reads
      # a file reached twice once
      let read = load_entries_reusing(ws.plan, entries ++ w0.seeds, overlay, w0.parses)
      let checked = incremental.analyze(w0.cache, read.loaded)
      var texts: Map[String, String] = map.empty()
      for lm in read.loaded.modules { texts = map.insert(texts, lm.mod_path, lm.text) }
      # an index entry lives exactly as long as the step it was read from
      var refs: Map[String, ModRefs] = map.empty()
      for pr in map.entries(w0.refs) {
        let (mod_path, mr) = pr
        if set.has(checked.reused, mod_path) { refs = map.insert(refs, mod_path, mr) }
      }
      Some(RefsWorld {
        ..w0,
        cache: checked.session,
        parses: retained_parses(st, read.parses),
        prog: Some(checked.program),
        texts: texts,
        refs: refs,
        current: true
      })
    }
  }
}

## Does the references program `w` read the project otherwise than the disk
## does now: another set of modules, or a module no open document holds whose
## file has another text than the one it was analyzed from?
fn world_stale(ws: Workspace, w: RefsWorld) -> Bool !Fs !Env = {
  let seeds = project_seeds(ws.plan)
  if seeds != w.seeds { return true }
  let prog = match w.prog {
    Some(p) -> p
    None -> return true
  }
  var held: Set[String] = set.empty()
  for pr in map.entries(ws.path_by_uri) {
    let (_, p) = pr
    held = set.insert(held, canon_identity(p))
  }
  var tree: Set[String] = set.empty()
  for f in seeds { tree = set.insert(tree, canon_identity(f)) }
  for cm in prog.modules {
    let id = canon_identity(cm.path)
    if set.has(held, id) || not set.has(tree, id) { continue }
    let disk = match io.read_file(cm.path) {
      Ok(t) -> t
      Err(_) -> return true
    }
    if map.get(w.texts, cm.mod_path) != Some(disk) { return true }
  }
  false
}

## Mark out of date the references program of every workspace whose source
## root holds a `.dawn` file a watched-file notification names: a file no
## document holds was edited, created or deleted on disk.
fn sources_changed(st: LspState, params: Json) -> LspState !Fs !Env = {
  var paths: List[String] = []
  match oget(params, "changes") {
    Some(JArr(changes)) -> {
      for change in changes {
        let uri = ostr(change, "uri")
        if str.ends_with(uri, ".dawn") {
          match uri_to_path(uri) {
            Some(p) -> { paths = paths ++ [canon_identity(p)] }
            None -> ()
          }
        }
      }
    }
    _ -> ()
  }
  if len(paths) == 0 { return st }
  var out = st
  for key in sort(map.keys(st.workspaces)) {
    match map.get(st.workspaces, key) {
      Some(Ready(ws)) ->
        match ws.world {
          Some(w) -> {
            let root = canon_identity(ws.plan.source.source_root)
            if list.any(paths, p => path_in_root(p, root)) {
              let next = Workspace { ..ws, world: Some(RefsWorld { ..w, current: false }) }
              out = LspState { ..out, workspaces: map.insert(out.workspaces, key, Ready(next)) }
            }
          }
          None -> ()
        }
      _ -> ()
    }
  }
  out
}

fn diagnostics_of_problem(
  st: LspState,
  path_by_uri: Map[String, String],
  problem: LocDiag
) -> Map[String, List[Json]] !Fs !Env = {
  let out: Map[String, List[Json]] = map.empty()
  add_loc_diag(st, path_by_uri, out, problem)
}

fn workspace_inputs(
  st: LspState,
  plan: ProjectPlan,
  path_by_uri: Map[String, String]
) -> WorkspaceInputs !Fs !Env = {
  var texts: Map[String, String] = map.empty()
  var overlay: Map[String, String] = map.empty()
  var entries: List[String] = []
  var entry_by_uri: Map[String, String] = map.empty()
  var conflicts: Set[String] = set.empty()
  for uri in sort(map.keys(path_by_uri)) {
    let path = map.get(path_by_uri, uri).expect("workspace path")
    let d = map.get(st.docs, uri).expect("workspace document")
    match map.get(texts, path) {
      Some(before) -> {
        if before != d.text { conflicts = set.insert(conflicts, path) }
      }
      None -> {
        texts = map.insert(texts, path, d.text)
        overlay = map.insert(overlay, path, d.text)
      }
    }
    entries = entries ++ [path]
    let entry = project_module_path(plan, path).expect("valid workspace member")
    entry_by_uri = map.insert(entry_by_uri, uri, entry)
  }
  if set.is_empty(conflicts) {
    InputsReady(overlay, entries, entry_by_uri)
  } else {
    InputsConflict(conflicts)
  }
}

fn conflict_diagnostics(
  st: LspState,
  path_by_uri: Map[String, String],
  paths: Set[String]
) -> Map[String, List[Json]] = {
  var out: Map[String, List[Json]] = map.empty()
  let dg = mk_diag(
    "multiple open documents resolve to the same file with different text",
    0,
    0,
    "close one duplicate URI or make their contents identical"
  )
  for uri in sort(map.keys(path_by_uri)) {
    let path = map.get(path_by_uri, uri).expect("workspace path")
    if set.has(paths, path) {
      let d = map.get(st.docs, uri).expect("workspace document")
      out = append_diagnostic(out, uri, diagnostic_json(d.view, d.ls, uri, st.related_information, dg))
    }
  }
  out
}

## Rebuild one coherent workspace snapshot, then lay a failed manifest
## refresh's setup diagnostic over it: the snapshot's own map is recomputed on
## every rebuild, and the failure has to outlive edits until a refresh clears it.
fn rebuild_workspace(st: LspState, ws0: Workspace) -> Workspace !Fs !Env !io = {
  let ws = rebuild_snapshot(st, ws0)
  match ws.refresh_problem {
    Some(problem) -> Workspace {
      ..ws,
      diag_by_uri: merge_diagnostics(ws.diag_by_uri,
        diagnostics_of_problem(st, ws.path_by_uri, problem))
    }
    None -> ws
  }
}

fn merge_diagnostics(
  base: Map[String, List[Json]],
  extra: Map[String, List[Json]]
) -> Map[String, List[Json]] = {
  var out = base
  for uri in sort(map.keys(extra)) {
    for value in map.get(extra, uri).expect("diagnostics") {
      out = append_diagnostic(out, uri, value)
    }
  }
  out
}

## Conflict detection happens before the overlay map can overwrite either live
## text, and discards the old program.
fn rebuild_snapshot(st: LspState, ws0: Workspace) -> Workspace !Fs !Env !io =
  match workspace_inputs(st, ws0.plan, ws0.path_by_uri) {
    InputsConflict(paths) -> {
      let no_entries: Map[String, String] = map.empty()
      let no_prog: Option[Program] = None
      let no_world: Option[RefsWorld] = None
      Workspace {
        ..ws0,
        prog: no_prog,
        cache: incremental.evict(ws0.cache),
        analysis_stats: None,
        entry_by_uri: no_entries,
        diag_by_uri: conflict_diagnostics(st, ws0.path_by_uri, paths),
        world: no_world
      }
    }
    InputsReady(overlay, entries, entry_by_uri) -> {
      let reusing = load_entries_reusing(ws0.plan, entries, overlay, ws0.parses)
      let loaded = reusing.loaded
      let update = incremental.analyze(ws0.cache, loaded)
      let prog = update.program
      Workspace {
        ..ws0,
        prog: Some(prog),
        cache: update.session,
        analysis_stats: Some(update.stats),
        parses: retained_parses(st, reusing.parses),
        entry_by_uri: entry_by_uri,
        diag_by_uri: diagnostics_of_program(st, ws0.path_by_uri, prog),
        # the references program is brought up to date by the next request
        # that reads it, not here: this is the path every keystroke takes
        world: match ws0.world {
          Some(w) -> Some(RefsWorld { ..w, current: false })
          None -> None
        }
      }
    }
  }

fn unavailable_workspace(
  st: LspState,
  plan: ProjectPlan,
  path_by_uri: Map[String, String],
  problem: LocDiag
) -> UnavailableWorkspace !Fs !Env =
  UnavailableWorkspace {
    plan: plan,
    path_by_uri: path_by_uri,
    problem: problem,
    diag_by_uri: diagnostics_of_problem(st, path_by_uri, problem)
  }

## Construct the lease before installing a ready workspace. Failure installs
## only an explicit unavailable state, never a platform/system fallback.
fn activate_workspace(
  st: LspState,
  plan: ProjectPlan,
  path_by_uri: Map[String, String]
) -> WorkspaceSlot !Fs !Env !Console !io =
  match st.host.project(plan.source) {
    Ok(lease) -> {
      let no_prog: Option[Program] = None
      let no_entries: Map[String, String] = map.empty()
      let no_diags: Map[String, List[Json]] = map.empty()
      let candidate = Workspace {
        plan: plan,
        path_by_uri: path_by_uri,
        prog: no_prog,
        entry_by_uri: no_entries,
        lease: lease,
        cache: analysis_session(st, lease.jsig),
        analysis_stats: None,
        parses: no_parses(),
        diag_by_uri: no_diags,
        refresh_problem: None,
        world: None
      }
      match catch_panic(() => rebuild_workspace(st, candidate)) {
        Ok(workspace) -> Ready(workspace)
        Err(e) -> {
          close_lease(lease)
          panic("lsp workspace rebuild failed before installation: ${e.message}")
        }
      }
    }
    Err(problem) -> Unavailable(unavailable_workspace(st, plan, path_by_uri, problem))
  }

fn slot_paths(slot: WorkspaceSlot) -> Map[String, String] =
  match slot {
    Ready(ws) -> ws.path_by_uri
    Unavailable(ws) -> ws.path_by_uri
  }

fn slot_diagnostics(slot: WorkspaceSlot) -> Map[String, List[Json]] =
  match slot {
    Ready(ws) -> ws.diag_by_uri
    Unavailable(ws) -> ws.diag_by_uri
  }

fn add_uris(out0: Set[String], values: List[String]) -> Set[String] = {
  var out = out0
  for value in values { out = set.insert(out, value) }
  out
}

fn slot_uris(slot: WorkspaceSlot) -> Set[String] = {
  var out: Set[String] = set.empty()
  out = add_uris(out, map.keys(slot_paths(slot)))
  add_uris(out, map.keys(slot_diagnostics(slot)))
}

fn standalone_diagnostics(d: Doc, prog: Program, related: Bool) -> List[Json] !Fs !Env = {
  var out: List[Json] = []
  for ld in rendered_diags(prog) {
    let own = match d.canonical_path {
      Some(path) -> canon_identity(ld.path) == path
      None -> true
    }
    if own { out = out ++ [diagnostic_json(d.view, d.ls, d.uri, related, ld.d)] }
  }
  out
}

## Aggregate every root's contribution before publishing one URI. This is the
## clearing rule that prevents one root from erasing another root's diagnostic
## when both point at the same manifest, lock or dependency file.
fn diagnostics_for_uri(st: LspState, uri: String) -> List[Json] !Fs !Env = {
  var out: List[Json] = []
  for workspace_key in sort(map.keys(st.workspaces)) {
    let slot = map.get(st.workspaces, workspace_key).expect("workspace")
    match map.get(slot_diagnostics(slot), uri) {
      Some(values) -> { out = out ++ values }
      None -> ()
    }
  }
  match map.get(st.docs, uri) {
    Some(d) ->
      match d.analysis {
        Standalone(prog, _, _) -> { out = out ++ standalone_diagnostics(d, prog, st.related_information) }
        WorkspaceMember(_) -> ()
      }
    None -> ()
  }
  out
}

fn publish_uris(st: LspState, uris: Set[String]) -> Unit !Fs !Env !io = {
  for uri in sort(set.to_list(uris)) {
    var fields: List[(String, Json)] = [
      ("uri", JStr(uri)),
      ("diagnostics", JArr(diagnostics_for_uri(st, uri)))
    ]
    match map.get(st.docs, uri) {
      Some(d) -> { fields = fields ++ [("version", JInt(d.version))] }
      None -> ()
    }
    notify("textDocument/publishDiagnostics", jobj(fields))
  }
}

fn install_workspace(
  st0: LspState,
  identity: WorkspaceIdentity,
  slot: WorkspaceSlot,
  affected0: Set[String]
) -> LspState !Fs !Env !io = {
  var affected = add_uris(affected0, set.to_list(slot_uris(slot)))
  let st = LspState {
    ..st0,
    workspaces: map.insert(st0.workspaces, identity.lookup_key, slot)
  }
  publish_uris(st, affected)
  st
}

## A standalone buffer borrows the shared oracle and is analysed cold on
## every revision; it owns no session a close of another URI could replace.
fn standalone_analysis(st: LspState, source_path: String, text: String) -> Program !Fs !Env !io = {
  let lease = st.standalone.expect("standalone LSP lease used after shutdown")
  analyze_standalone(source_path, text, st.std, st.host.ct, lease.jsig)
}

fn standalone_doc(
  st: LspState,
  uri: String,
  path: Option[String],
  canonical_path: Option[String],
  text: String,
  version: Int,
  modules: Option[Map[String, String]]
) -> Doc !Fs !Env !io = {
  let source_path = match path {
    Some(found) -> found
    None -> "<lsp>"
  }
  let prog = standalone_analysis(st, source_path, text)
  Doc {
    uri: uri,
    version: version,
    path: path,
    canonical_path: canonical_path,
    text: text,
    view: view_of(text),
    ls: line_starts_of(text),
    analysis: Standalone(prog, standalone_entry(prog), modules)
  }
}

fn open_new_doc(st0: LspState, uri: String, text: String, version: Int) -> LspState !Fs !Proc !Env !Console !io =
  match uri_to_path(uri) {
    None -> {
      let no_path: Option[String] = None
      let no_modules: Option[Map[String, String]] = None
      let d = standalone_doc(st0, uri, no_path, no_path, text, version, no_modules)
      let st = LspState { ..st0, docs: map.insert(st0.docs, uri, d) }
      publish_uris(st, set.from([uri]))
      st
    }
    Some(path) -> {
      let canonical_path = canon_identity(path)
      let plan = project_plan(source.SourceFile(path))
      match project_module_path(plan, path) {
        None -> {
          let modules: Option[Map[String, String]] = Some(plan.modules.by_use)
          let d = standalone_doc(
            st0, uri, Some(path), Some(canonical_path), text, version, modules)
          let st = LspState { ..st0, docs: map.insert(st0.docs, uri, d) }
          publish_uris(st, set.from([uri]))
          st
        }
        Some(_) -> {
          let identity = workspace_identity(plan)
          let d = Doc {
            uri: uri,
            version: version,
            path: Some(path),
            canonical_path: Some(canonical_path),
            text: text,
            view: view_of(text),
            ls: line_starts_of(text),
            analysis: WorkspaceMember(identity)
          }
          var st = LspState { ..st0, docs: map.insert(st0.docs, uri, d) }
          let old = map.get(st0.workspaces, identity.lookup_key)
          var affected: Set[String] = set.empty()
          let captured = match old {
            Some(slot) -> {
              affected = slot_uris(slot)
              match slot {
                Ready(ws) -> ws.plan
                Unavailable(ws) -> ws.plan
              }
            }
            None -> plan
          }
          var paths = match old {
            Some(slot) -> slot_paths(slot)
            None -> {
              let empty: Map[String, String] = map.empty()
              empty
            }
          }
          paths = map.insert(paths, uri, canonical_path)
          let slot = match old {
            Some(Ready(ws)) -> Ready(rebuild_workspace(st, Workspace { ..ws, path_by_uri: paths }))
            Some(Unavailable(_)) -> activate_workspace(st, captured, paths)
            None -> activate_workspace(st, captured, paths)
          }
          install_workspace(st, identity, slot, affected)
        }
      }
    }
  }

fn update_existing_doc(st0: LspState, old: Doc, text: String, version: Int) -> LspState !Fs !Env !io =
  match old.analysis {
    Standalone(_, _, modules) -> {
      let source_path = match old.path {
        Some(found) -> found
        None -> "<lsp>"
      }
      let prog = standalone_analysis(st0, source_path, text)
      # re-read rather than carry the old one: the identity is settled by the
      # analysis, and an edit re-runs the analysis
      let d = Doc {
        ..old,
        version: version,
        text: text,
        view: view_of(text),
        ls: line_starts_of(text),
        analysis: Standalone(prog, standalone_entry(prog), modules)
      }
      let st = LspState { ..st0, docs: map.insert(st0.docs, old.uri, d) }
      publish_uris(st, set.from([old.uri]))
      st
    }
    WorkspaceMember(identity) -> {
      let d = Doc {
        ..old,
        version: version,
        text: text,
        view: view_of(text),
        ls: line_starts_of(text)
      }
      var st = LspState { ..st0, docs: map.insert(st0.docs, old.uri, d) }
      let before = map.get(st.workspaces, identity.lookup_key).expect("workspace member identity")
      let affected = slot_uris(before)
      let slot = match before {
        Ready(ws) -> Ready(rebuild_workspace(st, ws))
        Unavailable(ws) -> Unavailable(unavailable_workspace(
          st, ws.plan, ws.path_by_uri, ws.problem))
      }
      install_workspace(st, identity, slot, affected)
    }
  }

fn update_doc(st: LspState, uri: String, text: String, version: Int) -> LspState !Fs !Proc !Env !Console !io =
  match map.get(st.docs, uri) {
    Some(old) -> update_existing_doc(st, old, text, version)
    None -> open_new_doc(st, uri, text, version)
  }

## An unavailable root retries only at an explicit low-frequency boundary.
## didChange never reaches this function; new members use `activate_workspace`
## directly, and a fully closed root is newly planned when reopened.
fn retry_unavailable(st: LspState, uri: String) -> LspState !Fs !Env !Console !io =
  match map.get(st.docs, uri) {
    Some(d) ->
      match d.analysis {
        WorkspaceMember(identity) ->
          match map.get(st.workspaces, identity.lookup_key) {
            Some(Unavailable(ws)) -> {
              let affected = slot_uris(Unavailable(ws))
              let slot = activate_workspace(st, ws.plan, ws.path_by_uri)
              install_workspace(st, identity, slot, affected)
            }
            _ -> st
          }
        Standalone(_, _, _) -> st
      }
    None -> st
  }

# ---- manifest refresh ----
#
# A workspace keeps the plan it captured at open (§3.1); a changed dawn.toml
# or dawn.lock is the one event that replaces it. The client reports the
# change through `workspace/didChangeWatchedFiles`, from the registration sent
# at `initialized` or from its own watcher (editors/vscode registers one for
# clients that cannot take a dynamic registration).

## The dynamic registration of both manifest names (LSP 3.17
## `client/registerCapability`). The
## registration is per name, not per project: which projects a change touches
## is the server's question (`slot_manifest_dirs`), answered on arrival.
fn manifest_watch_registration() -> Json =
  jobj([
    ("jsonrpc", JStr("2.0")),
    ("id", JStr("dawn/registerManifestWatchers")),
    ("method", JStr("client/registerCapability")),
    ("params", jobj([("registrations", JArr([jobj([
      ("id", JStr("dawn/manifests")),
      ("method", JStr("workspace/didChangeWatchedFiles")),
      ("registerOptions", jobj([("watchers", JArr([
        jobj([("globPattern", JStr("**/dawn.toml"))]),
        jobj([("globPattern", JStr("**/dawn.lock"))])
      ]))]))
    ]), jobj([
      # a module no document holds, edited, created or deleted on disk: the
      # references program reads it (`sources_changed`)
      ("id", JStr("dawn/sources")),
      ("method", JStr("workspace/didChangeWatchedFiles")),
      ("registerOptions", jobj([("watchers", JArr([
        jobj([("globPattern", JStr("**/*.dawn"))])
      ]))]))
    ])]))]))
  ])

test "a diagnostic's notes are related locations only for a client that reads them" {
  let text = "fn f() = {\n  g()\n"
  let v = view_of(text)
  let ls = line_starts_of(text)
  let d = Diag {
    ..mk_diag("unclosed `{`", 9, 10, "add the missing `}`"),
    notes: [Note { msg: "the file ends here", lo: 17, hi: 17 }]
  }
  let uri = "file:///w/a.dawn"
  let related = render(diagnostic_json(v, ls, uri, true, d))
  assert related == render(jobj([
    ("range", jrange(v, ls, 9, 10)),
    ("severity", JInt(1)),
    ("source", JStr("dawn")),
    ("message", JStr("unclosed `{`\nhint: add the missing `}`")),
    ("relatedInformation", JArr([jobj([
      ("location", jobj([("uri", JStr(uri)), ("range", jrange(v, ls, 17, 17))])),
      ("message", JStr("the file ends here"))
    ])]))
  ]))
  # a client that did not declare the capability may not read the field, so
  # the note travels in the message, in the order the CLI prints it
  let folded = render(diagnostic_json(v, ls, uri, false, d))
  assert folded == render(jobj([
    ("range", jrange(v, ls, 9, 10)),
    ("severity", JInt(1)),
    ("source", JStr("dawn")),
    ("message", JStr("unclosed `{`\nnote: the file ends here (line 3)\nhint: add the missing `}`"))
  ]))
  # without notes the capability changes nothing
  let plain = mk_diag("unclosed `{`", 9, 10, "")
  assert render(diagnostic_json(v, ls, uri, true, plain)) == render(diagnostic_json(v, ls, uri, false, plain))
}

test "the related-information capability is read from publishDiagnostics" {
  let declared = jobj([("capabilities", jobj([("textDocument", jobj([
    ("publishDiagnostics", jobj([("relatedInformation", JBool(true))]))
  ]))]))])
  assert client_relates_diagnostics(declared)
  let refused = jobj([("capabilities", jobj([("textDocument", jobj([
    ("publishDiagnostics", jobj([("relatedInformation", JBool(false))]))
  ]))]))])
  assert not client_relates_diagnostics(refused)
  assert not client_relates_diagnostics(jobj([("capabilities", jobj([]))]))
  assert not client_relates_diagnostics(JNull)
}

fn client_relates_diagnostics(params: Json) -> Bool = {
  let td = get_or_null(get_or_null(params, "capabilities"), "textDocument")
  match oget(get_or_null(td, "publishDiagnostics"), "relatedInformation") {
    Some(JBool(b)) -> b
    _ -> false
  }
}

## Whether the client said it applies a completion list's `itemDefaults.data`
## to the items that carry none (LSP 3.17,
## `textDocument.completion.completionList.itemDefaults`).
fn client_defaults_item_data(params: Json) -> Bool = {
  let td = get_or_null(get_or_null(params, "capabilities"), "textDocument")
  match oget(get_or_null(get_or_null(td, "completion"), "completionList"), "itemDefaults") {
    Some(JArr(xs)) -> list.contains(xs, JStr("data"))
    _ -> false
  }
}

## The inlay hints the client asked for: `initializationOptions.inlayHints`,
## six optional booleans over `default_inlay_opts`. A key that is missing or
## not a boolean keeps its default; read once, at `initialize`
## (docs/lsp-hover-design.md §A4.3 says why not `workspace/configuration`).
fn inlay_opts_of(params: Json) -> InlayOpts = {
  let j = get_or_null(get_or_null(params, "initializationOptions"), "inlayHints")
  let d = default_inlay_opts()
  InlayOpts {
    let_types: json_flag(j, "letTypes", d.let_types),
    lambda_param_types: json_flag(j, "lambdaParamTypes", d.lambda_param_types),
    call_effects: json_flag(j, "callEffects", d.call_effects),
    param_names: json_flag(j, "parameterNames", d.param_names),
    default_args: json_flag(j, "defaultArguments", d.default_args),
    default_values: json_flag(j, "defaultArgumentValues", d.default_values)
  }
}

fn json_flag(j: Json, k: String, dflt: Bool) -> Bool =
  match oget(j, k) {
    Some(JBool(b)) -> b
    _ -> dflt
  }

fn client_watches_files(params: Json) -> Bool = {
  let workspace = get_or_null(get_or_null(params, "capabilities"), "workspace")
  match oget(get_or_null(workspace, "didChangeWatchedFiles"), "dynamicRegistration") {
    Some(JBool(b)) -> b
    _ -> false
  }
}

## A changed file a plan may have read: a dawn.toml or a dawn.lock, in its
## directory's identity, which is how `slot_manifest_dirs` spells the
## directories it watches. The directory and not the file is resolved, so a
## deleted manifest still names the directory it was deleted from. Anything
## else a notification names is not ours to act on.
fn manifest_path_of(uri: String) -> Option[String] !Fs !Env =
  match uri_to_path(uri) {
    Some(path) -> {
      let target = canon(path)
      if str.ends_with(target, "/dawn.toml") || str.ends_with(target, "/dawn.lock") {
        let name = str.drop(target, str.len(parent_dir(target)))
        Some(canon_identity(parent_dir(target)) ++ name)
      } else {
        None
      }
    }
    None -> None
  }

fn watched_manifests(params: Json) -> Set[String] !Fs !Env = {
  var out: Set[String] = set.empty()
  match oget(params, "changes") {
    Some(JArr(changes)) -> {
      for change in changes {
        match manifest_path_of(ostr(change, "uri")) {
          Some(path) -> { out = set.insert(out, path) }
          None -> ()
        }
      }
    }
    _ -> ()
  }
  out
}

fn parent_dir(path: String) -> String =
  match str.last_index_of(path, "/") {
    Some(i) -> str.take(path, i)
    None -> path
  }

fn slot_plan(slot: WorkspaceSlot) -> ProjectPlan =
  match slot {
    Ready(ws) -> ws.plan
    Unavailable(ws) -> ws.plan
  }

## The directory of every manifest a package graph was planned from. A
## package root is its canonical `<dir>/src`.
fn pkg_manifest_dirs(pkg: source.PkgR, dirs0: Set[String]) -> Set[String] = {
  let dir = parent_dir(pkg.root)
  if set.has(dirs0, dir) { return dirs0 }
  var dirs = set.insert(dirs0, dir)
  for dep in sort(map.keys(pkg.deps)) {
    dirs = pkg_manifest_dirs(map.get(pkg.deps, dep).expect("resolved package"), dirs)
  }
  dirs
}

## Where a change can alter what this slot was planned from: the project's own
## manifest directory, each resolved package's (the set
## `bootstrap_source_input_manifest` records as inputs), and every directory a
## planner or setup diagnostic points into, so that fixing a broken manifest is
## itself noticed. All as identities, as a package root already is.
fn slot_manifest_dirs(slot: WorkspaceSlot) -> Set[String] !Fs !Env = {
  let plan = slot_plan(slot)
  var dirs = set.from([canon_identity(plan.source.project)])
  for dep in sort(map.keys(plan.source.pkgs)) {
    dirs = pkg_manifest_dirs(map.get(plan.source.pkgs, dep).expect("resolved package"), dirs)
  }
  for ld in plan.source.diags {
    dirs = set.insert(dirs, canon_identity(parent_dir(canon(ld.path))))
  }
  let problem = match slot {
    Ready(ws) -> ws.refresh_problem
    Unavailable(ws) -> Some(ws.problem)
  }
  match problem {
    Some(ld) -> { dirs = set.insert(dirs, canon_identity(parent_dir(canon(ld.path)))) }
    None -> ()
  }
  dirs
}

## Re-plan every workspace one of `changed` belongs to, each at most once per
## notification: VS Code's own watcher and the dynamic registration report
## the same save, and the client batches both into one notification.
fn refresh_manifests(st0: LspState, changed: Set[String]) -> LspState !Fs !Proc !Env !Console !io = {
  var st = st0
  for key in sort(map.keys(st0.workspaces)) {
    let slot = map.get(st.workspaces, key).expect("workspace")
    let dirs = slot_manifest_dirs(slot)
    var touched = false
    for path in set.to_list(changed) {
      if set.has(dirs, parent_dir(path)) { touched = true }
    }
    if touched { st = refresh_workspace(st, key, slot) }
  }
  st
}

## Build the new plan and lease completely, install, and only then close the
## old lease (docs/lsp-workspace-design.md §3.2). A setup failure keeps the
## old workspace serving and hangs the failure on the manifest it names; an
## unavailable workspace has nothing to keep and takes the new state.
fn refresh_workspace(
  st: LspState,
  key: String,
  slot: WorkspaceSlot
) -> LspState !Fs !Proc !Env !Console !io = {
  let fresh = project_plan(slot_plan(slot).source.target)
  let planned = workspace_identity(fresh)
  # The identity is the target path resolved (`source_roots`, then
  # `canon_identity`), and a refresh re-plans the same target, so no manifest
  # can move it. The file system can: a link retargeted or a root removed
  # while the server runs resolves differently now. The members were filed
  # under `key` when they were opened, so the slot stays there rather than
  # leaving them pointing at nothing; a document opened afterwards gets the
  # new answer. `install_workspace` reads the key alone.
  let identity = WorkspaceIdentity { ..planned, lookup_key: key }
  let affected = slot_uris(slot)
  match activate_workspace(st, fresh, slot_paths(slot)) {
    Ready(ws) -> {
      let next = install_workspace(st, identity, Ready(ws), affected)
      match slot {
        Ready(old) -> close_lease(old.lease)
        Unavailable(_) -> ()
      }
      next
    }
    Unavailable(failed) ->
      match slot {
        Ready(old) -> {
          let kept = Workspace { ..old, refresh_problem: Some(failed.problem) }
          install_workspace(st, identity, Ready(rebuild_workspace(st, kept)), affected)
        }
        Unavailable(_) -> install_workspace(st, identity, Unavailable(failed), affected)
      }
  }
}

fn close_doc(st0: LspState, uri: String) -> LspState !Fs !Env !Console !io =
  match map.get(st0.docs, uri) {
    None -> {
      publish_uris(st0, set.from([uri]))
      st0
    }
    Some(d) ->
      match d.analysis {
        Standalone(_, _, _) -> {
          let st = LspState { ..st0, docs: map.remove(st0.docs, uri) }
          publish_uris(st, set.from([uri]))
          st
        }
        WorkspaceMember(identity) -> {
          let before = map.get(st0.workspaces, identity.lookup_key)
            .expect("workspace member identity")
          var affected = slot_uris(before)
          affected = set.insert(affected, uri)
          let paths = map.remove(slot_paths(before), uri)
          var st = LspState { ..st0, docs: map.remove(st0.docs, uri) }
          if len(map.keys(paths)) == 0 {
            st = LspState {
              ..st,
              workspaces: map.remove(st.workspaces, identity.lookup_key)
            }
            publish_uris(st, affected)
            match before {
              Ready(ws) -> close_lease(ws.lease)
              Unavailable(_) -> ()
            }
            st
          } else {
            let slot = match before {
              Ready(ws) -> Ready(rebuild_workspace(st, Workspace { ..ws, path_by_uri: paths }))
              Unavailable(ws) -> Unavailable(unavailable_workspace(
                st, ws.plan, paths, ws.problem))
            }
            install_workspace(st, identity, slot, affected)
          }
        }
      }
  }

fn doc_of(st: LspState, params: Json) -> Option[Doc] = {
  let td = get_or_null(params, "textDocument")
  map.get(st.docs, ostr(td, "uri"))
}

fn pos_offset(d: Doc, params: Json) -> Int = {
  let p = get_or_null(params, "position")
  lsp_offset(d.view, d.ls, oint(p, "line"), oint(p, "character"))
}

# ---- language features ----

fn handle_completion(st: LspState, params: Json) -> Json !Fs !Proc !Env !io = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, d, analysis) {
            Some(qc) -> {
              var items: List[Json] = []
              let found = completions_at(qc, analysis.modules, d.text, pos_offset(d, params))
              for it in found.items {
                var fields: List[(String, Json)] = [("label", JStr(it.label))]
                fields = fields ++ [("kind", JInt(it.kind))]
                match it.detail {
                  Some(dt) -> { fields = fields ++ [("detail", JStr(dt))] }
                  None -> ()
                }
                match it.sort_text {
                  Some(s2) -> { fields = fields ++ [("sortText", JStr(s2))] }
                  None -> ()
                }
                if may_have_item_doc(it.kind) {
                  match it.from {
                    Some(mp) -> {
                      fields = fields ++ [("data", jobj([("uri", JStr(d.uri)), ("module", JStr(mp))]))]
                    }
                    None -> if not st.default_item_data {
                      fields = fields ++ [("data", jobj([("uri", JStr(d.uri))]))]
                    }
                  }
                }
                # the `use` line a std name the buffer has not imported needs,
                # sent with the list: it costs one position per module, and a
                # client that never resolves still gets a name that compiles
                # (docs/lsp-auto-import-design.md §5)
                match it.edit {
                  Some(e) -> {
                    fields = fields ++ [
                      ("labelDetails", jobj([("description", JStr("use ${e.path}"))])),
                      ("additionalTextEdits", JArr([jobj([
                        ("range", jrange(d.view, d.ls, e.at, e.at)),
                        ("newText", JStr(e.text))
                      ])]))
                    ]
                  }
                  None -> ()
                }
                items = items ++ [jobj(fields)]
              }
              # A client that applies `itemDefaults.data` is told the document
              # once; every item then costs no bytes for its resolve. A list
              # that is not whole has to say so, which only the object form can.
              if st.default_item_data {
                jobj([
                  ("isIncomplete", JBool(found.incomplete)),
                  ("itemDefaults", jobj([("data", jobj([("uri", JStr(d.uri))]))])),
                  ("items", JArr(items))
                ])
              } else if found.incomplete {
                jobj([("isIncomplete", JBool(true)), ("items", JArr(items))])
              } else {
                JArr(items)
              }
            }
            None -> JArr([])
          }
        None -> JArr([])
      }
    None -> JArr([])
  }
}

## The completion kinds a declaration with a `##` doc can stand behind:
## Function, Class, Interface, Module, EnumMember, Constant, TypeParameter
## (an effect). Only these items carry `data`, so a list's keywords, locals and
## builtin types cost no bytes for a resolve that could never find a doc.
fn may_have_item_doc(kind: Int) -> Bool =
  kind == 3 || kind == 7 || kind == 8 || kind == 9 || kind == 20 || kind == 21 || kind == 23

## `completionItem/resolve` (docs/lsp-hover-design.md §D7): the item as the
## client sent it, with `documentation` added when its declaration has a doc.
## The doc is the one hover shows, links resolved and cut the same way, without
## hover's fence: the item's `detail` already carries the signature. It is
## found here rather than in `textDocument/completion` because a list offers
## hundreds of names from dozens of modules, and reading every one's doc
## would lex every one of those modules for the one or two a reader stops on.
##
## `data` carries the document's uri and, for an item a `use` line offered, the
## module it came from; label and kind say the rest. A module that line has
## not loaded yet is read from the file it would load.
fn handle_completion_resolve(st: LspState, params: Json) -> (Json, LspState) !Fs !Proc !Env !io = {
  let data = get_or_null(params, "data")
  let label = ostr(params, "label")
  let kind = oint(params, "kind")
  # with list defaults the client sends a keyword back with the document's data
  # too; no declaration stands behind one, so nothing is looked up
  if not may_have_item_doc(kind) { return (params, st) }
  let from = match oget(data, "module") {
    Some(JStr(mp)) -> Some(mp)
    _ -> None
  }
  let (doc, st2) = match map.get(st.docs, ostr(data, "uri")) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, d, analysis) {
            Some(qc) ->
              match item_doc_site(qc, label, kind, from) {
                Some(site) -> site_doc(st, d, analysis, qc, site)
                None ->
                  match from {
                    Some(mp) -> unloaded_doc(st, d, analysis, qc, mp, label, kind)
                    None -> (None, st)
                  }
              }
            None -> (None, st)
          }
        None -> (None, st)
      }
    None -> (None, st)
  }
  match doc {
    Some(text) -> (with_field(params, "documentation", markdown(cut_doc(text))), st2)
    None -> (params, st2)
  }
}

## The doc of `label` (or, for a Module item, of the module) in module `mp`,
## which the program has not loaded: the file the `use` line being written
## would load, read and parsed for this alone. Its links stay as written, since
## nothing has checked the module whose scope they would resolve in.
fn unloaded_doc(
  st: LspState,
  d: Doc,
  analysis: Analysis,
  qc: QCx,
  mp: String,
  label: String,
  kind: Int
) -> (Option[String], LspState) !Fs !Proc !Env !io = {
  let candidates = match analysis.modules {
    Some(modules) -> modules
    None -> use_candidates(qc.entry.path)
  }
  let file = match map.get(candidates, mp) {
    Some(f) -> f
    None -> return (None, st)
  }
  let (key, text) = match def_source(st, d, analysis.workspace_key, analysis.definition_root, Some(file)) {
    Some(InBuffer(d2)) -> ("doc ${d2.uri}", d2.text)
    Some(OnDisk(p, t)) -> ("file ${p}", t)
    None -> return (None, st)
  }
  let (m, _) = source_parser.parse_module(text)
  let (src, st2) = doc_src_memo(st, key, text)
  if kind == 9 { return (blank_none(module_doc_of(src, m)), st2) }
  match decl_lo_named(m, member_name(label)) {
    Some(lo) -> (doc_in(src, lo), st2)
    None -> (None, st2)
  }
}

## A doc of blank lines only is no doc (`lspdoc.doc_in` says why).
fn blank_none(doc: Option[String]) -> Option[String] =
  match doc {
    Some(t) -> if str.trim(t) == "" { None } else { Some(t) }
    None -> None
  }

## LSP's `MarkupContent` in Markdown.
fn markdown(value: String) -> Json = jobj([("kind", JStr("markdown")), ("value", JStr(value))])

## `j` with `key` set to `v`; a value that is not an object is returned as is.
fn with_field(j: Json, key: String, v: Json) -> Json =
  match j {
    JObj(m) -> JObj(map.insert(m, key, v))
    _ -> j
  }

fn handle_hover(st: LspState, params: Json) -> (Json, LspState) !Fs !Env !io = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, d, analysis) {
            Some(qc) ->
              match find_target(qc, pos_offset(d, params)) {
                Some(t) -> {
                  let (value, st2) = hover_value(st, d, analysis, qc, t)
                  let reply = jobj([
                    ("contents", jobj([("kind", JStr("markdown")), ("value", JStr(value))])),
                    ("range", jrange(d.view, d.ls, t.lo, t.hi))
                  ])
                  (reply, st2)
                }
                None -> (JNull, st)
              }
            None -> (JNull, st)
          }
        None -> (JNull, st)
      }
    None -> (JNull, st)
  }
}

## `textDocument/signatureHelp`: the one signature of the call open at the
## cursor, the way hover renders it (defaults included), with each parameter's
## label as a [start, end) range of that rendering in UTF-16 units -- offsets
## rather than substrings, since a client resolves a substring label by
## searching and `a: Int` would be found inside `aa: Int`. `null` when the
## cursor is in no call this can resolve (`lspc.signature_at` says which).
fn handle_signature_help(st: LspState, params: Json) -> (Json, LspState) !Fs !Env !io = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, d, analysis) {
            Some(qc) ->
              match signature_at(qc, d.text, pos_offset(d, params)) {
                Some(found) -> {
                  let (s, active) = found
                  let (head, ps, tail) = sig_render_parts(qc.entry.cx.adts, qc.entry.cx.traits, s)
                  var at = utf16_len(head)
                  var labels: List[Json] = []
                  var first = true
                  for p in ps {
                    if not first { at = at + 2 }
                    first = false
                    let end = at + utf16_len(p)
                    labels = labels ++ [jobj([("label", JArr([JInt(at), JInt(end)]))])]
                    at = end
                  }
                  var sig_fields: List[(String, Json)] = [
                    ("label", JStr(head ++ join(ps, ", ") ++ tail)),
                    ("parameters", JArr(labels))
                  ]
                  # the function's doc, whole: Dawn has no per-parameter doc
                  # syntax to fill `ParameterInformation.documentation` from
                  # (docs/lsp-hover-design.md §D7)
                  let (doc, st2) = match sig_doc_site(qc, s) {
                    Some(site) -> site_doc(st, d, analysis, qc, site)
                    None -> (None, st)
                  }
                  match doc {
                    Some(text) -> { sig_fields = sig_fields ++ [("documentation", markdown(cut_doc(text)))] }
                    None -> ()
                  }
                  let reply = jobj([
                    ("signatures", JArr([jobj(sig_fields)])),
                    ("activeSignature", JInt(0)),
                    ("activeParameter", JInt(active))
                  ])
                  (reply, st2)
                }
                None -> (JNull, st)
              }
            None -> (JNull, st)
          }
        None -> (JNull, st)
      }
    None -> (JNull, st)
  }
}

fn handle_definition(st: LspState, params: Json) -> Json !Fs !Env = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, d, analysis) {
            Some(qc) ->
              match find_target(qc, pos_offset(d, params)) {
                Some(t) ->
                  match t.def {
                    Some(sp) -> {
                      let (dlo, dhi) = sp
                      match location_of(
                        st,
                        d,
                        analysis.workspace_key,
                        analysis.definition_root,
                        t.def_path,
                        dlo,
                        dhi
                      ) {
                        Some(loc) -> JArr([loc])
                        None -> JArr([])
                      }
                    }
                    None -> JArr([])
                  }
                None -> JArr([])
              }
            None -> JArr([])
          }
        None -> JArr([])
      }
    None -> JArr([])
  }
}

## The occurrences in the requested document of the declaration the name at
## the position resolves to (docs/lsp-references-design.md §R1), or None when
## there is no analysis to ask.
fn occurrences_at(st: LspState, params: Json, with_decl: Bool) -> Option[(Doc, List[Occurrence])] =
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, d, analysis) {
            Some(qc) -> Some((d, occurrences(qc, pos_offset(d, params), with_decl)))
            None -> None
          }
        None -> None
      }
    None -> None
  }

## `textDocument/references`: across the workspace for a project document
## (§R2), inside the document for a standalone one (§R1); the declaration's
## own name only when `context.includeDeclaration` is true.
fn handle_references(st: LspState, params: Json) -> (Json, LspState) !Fs !Env !io = {
  let with_decl = match oget(get_or_null(params, "context"), "includeDeclaration") {
    Some(JBool(b)) -> b
    _ -> false
  }
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match analysis.workspace_key {
            Some(key) -> workspace_references(st, d, analysis, key, pos_offset(d, params), with_decl)
            None -> (local_references(st, params, with_decl), st)
          }
        None -> (JArr([]), st)
      }
    None -> (JArr([]), st)
  }
}

fn local_references(st: LspState, params: Json, with_decl: Bool) -> Json =
  match occurrences_at(st, params, with_decl) {
    Some(pr) -> {
      let (d, os) = pr
      JArr(map(os, o => jobj([("uri", JStr(d.uri)), ("range", jrange(d.view, d.ls, o.lo, o.hi))])))
    }
    None -> JArr([])
  }

## One reference found, for ordering the reply: the file's identity, the
## offset, and the location.
type Found = { path: String, lo: Int, loc: Json }

## The references of a workspace document (docs/lsp-references-design.md §R2).
## The requesting document answers from its own walk, as §R1 does; every
## other module of the program, the ones no open document imports included,
## answers from the workspace's index, read again only for a module whose
## step the last rebuild did not reuse or whose entry names a site an edit
## touched. What this request read or moved is kept for the next one.
fn workspace_references(
  st: LspState, d: Doc, analysis: Analysis, key: String, offset: Int, with_decl: Bool
) -> (Json, LspState) !Fs !Env !io = {
  let ws = match map.get(st.workspaces, key) {
    Some(Ready(w)) -> w
    _ -> return (JArr([]), st)
  }
  let world = match refs_world(st, ws, false) {
    Some(w) -> w
    None -> return (JArr([]), st)
  }
  let prog = world.prog.expect("a current references program")
  let env = program_exports(st, prog)
  let entry = match list.find(prog.modules, cm => cm.mod_path == analysis.entry) {
    Some(e) -> e
    None -> return (JArr([]), st)
  }
  let qc = module_qcx(st, prog, env, entry, d.view.cps)
  let t = match find_target(qc, offset) {
    Some(t) -> t
    None -> return (JArr([]), st)
  }
  let def = match t.def {
    Some(sp) -> sp
    None -> return (JArr([]), st)
  }
  # every program file by identity, with the text it was analyzed from
  var ident: Map[String, String] = map.empty()
  var texts: Map[String, String] = map.empty()
  for cm in prog.modules {
    let id = canon_identity(cm.path)
    ident = map.insert(ident, cm.path, id)
    match map.get(world.texts, cm.mod_path) {
      Some(text) -> { texts = map.insert(texts, id, text) }
      None -> ()
    }
  }
  let own = map.get(ident, entry.path).expect("the requesting module's identity")
  let target = match t.def_path {
    None -> own
    Some(p) -> map.get(ident, p).unwrap_or(p)
  }
  var found: List[Found] = []
  for o in occurrences(qc, offset, with_decl) {
    let loc = jobj([("uri", JStr(d.uri)), ("range", jrange(d.view, d.ls, o.lo, o.hi))])
    found = found ++ [Found { path: own, lo: o.lo, loc: loc }]
  }
  var uri_of: Map[String, String] = map.empty()
  for uri in sort(map.keys(ws.path_by_uri)) {
    let p = map.get(ws.path_by_uri, uri).expect("workspace path")
    if not map.has(uri_of, p) { uri_of = map.insert(uri_of, p, uri) }
  }
  var index = world.refs
  var shifts: Map[String, (String, Shift)] = map.empty()
  for cm in prog.modules {
    if cm.mod_path == analysis.entry { continue }
    let text = match map.get(world.texts, cm.mod_path) {
      Some(found_text) -> found_text
      None -> continue
    }
    let id = map.get(ident, cm.path).expect("module identity")
    let kept = match map.get(index, cm.mod_path) {
      Some(old) -> {
        let (fresh, next) = refresh(old, texts, shifts)
        shifts = next
        fresh
      }
      None -> None
    }
    let mr = match kept {
      Some(m) -> m
      None -> mod_refs(module_qcx(st, prog, env, cm, code_points(text)), id, text, ident, texts)
    }
    index = map.insert(index, cm.mod_path, mr)
    let hits = refs_to(mr, target, def, with_decl)
    if len(hits) > 0 {
      let view = view_of(text)
      let ls = line_starts_of(text)
      let uri = map.get(uri_of, id).unwrap_or(path_to_uri(id))
      for r in hits {
        let loc = jobj([("uri", JStr(uri)), ("range", jrange(view, ls, r.lo, r.hi))])
        found = found ++ [Found { path: id, lo: r.lo, loc: loc }]
      }
    }
  }
  let ordered = sort_by(found, (a, b) =>
      if a.path == b.path { a.lo - b.lo } else if a.path < b.path { -1 } else { 1 })
  let next = Workspace { ..ws, world: Some(RefsWorld { ..world, refs: index }) }
  (JArr(map(ordered, f => f.loc)), LspState { ..st, workspaces: map.insert(st.workspaces, key, Ready(next)) })
}

## `textDocument/documentHighlight`: the same occurrences, the declaration's
## own name included, each a Write (3) where it binds or assigns the name and
## a Read (2) everywhere else.
fn handle_document_highlight(st: LspState, params: Json) -> Json =
  match occurrences_at(st, params, true) {
    Some(pr) -> {
      let (d, os) = pr
      JArr(map(os, o => jobj([("range", jrange(d.view, d.ls, o.lo, o.hi)), ("kind", JInt(if o.write { 3 } else { 2 }))])))
    }
    None -> JArr([])
  }

# ---- rename (docs/lsp-references-design.md §R3) ----

## What a rename starts from: the name at the cursor, the declaration it
## resolves to, and the workspace's references program both were read in.
type RenameStart = {
  ws: Workspace,
  lookup: String,
  # the identity of the workspace's source root: no file outside it is edited
  root: String,
  world: RefsWorld,
  prog: Program,
  entry: CheckedMod,
  # every program file's identity, by the path the program loaded it from
  ident: Map[String, String],
  # every program file's analyzed text, by identity
  texts: Map[String, String],
  target: Key,
  # the name as the cursor's occurrence spells it, and that occurrence
  old: String,
  lo: Int,
  hi: Int,
  # the name is one a `use m.{f as h}` binds, `h`: only this module's
  # spelling of it changes, and `f` is left alone (Gleam's rule for a name
  # from another package, here for any)
  as_name: Bool
}

## Is `name` the local name of an `as` in one of `m`'s import lists?
fn import_alias(m: Module, name: String) -> Bool = {
  for d in m.decls {
    match d {
      DUseModule(_, selective, _, _, _, _, _) ->
        match selective {
          Some(names) -> {
            for n in names {
              match n.local {
                Some(r) -> if r.name == name && n.name != name { return true }
                None -> ()
              }
            }
          }
          None -> ()
        }
      _ -> ()
    }
  }
  false
}

## Is the declaration at `def` of `m` its top-level `main`?
fn is_main(m: Module, def: (Int, Int)) -> Bool = {
  let (lo, _) = def
  for d in m.decls {
    match d {
      DFn(f) -> if f.name == "main" && f.nlo == lo { return true }
      _ -> ()
    }
  }
  false
}

## The first diagnostic of `prog` in the file whose identity is `id`.
fn first_diag_in(prog: Program, id: String) -> Option[LocDiag] !Fs !Env = {
  for ld in prog.diags {
    if canon_identity(ld.path) == id { return Some(ld) }
  }
  None
}

## The rename at `offset` of `d`, as far as the name and its declaration go,
## or why there is none (§R3.2). The references program is brought up to
## date on the way, and the state returned keeps it either way.
fn rename_start(st: LspState, d: Doc, offset: Int) -> (Result[RenameStart, String], LspState) !Fs !Env !io = {
  let analysis = match analysis_of(st, d) {
    Some(a) -> a
    None -> return (Err("this document has no analysis to rename in"), st)
  }
  let lookup = match analysis.workspace_key {
    Some(k) -> k
    None -> return (Err("rename works in the files of a project, not in a buffer with no file"), st)
  }
  let root = analysis.definition_root.expect("a workspace document's source root")
  let ws = match map.get(st.workspaces, lookup) {
    Some(Ready(w)) -> w
    _ -> return (Err("this document has no analysis to rename in"), st)
  }
  # verified against the disk: the edit is computed from these texts
  let world = match refs_world(st, ws, true) {
    Some(w) -> w
    None -> return (Err("two open documents disagree about one file"), st)
  }
  # the program is kept whatever the answer: building it the first time
  # checks the whole tree, and a refusal is no reason to pay that again
  let kept = keep_world_of(st, lookup, ws, world)
  let prog = world.prog.expect("a current references program")
  let entry = match list.find(prog.modules, cm => cm.mod_path == analysis.entry) {
    Some(e) -> e
    None -> return (Err("this document has no analysis to rename in"), kept)
  }
  let qc = module_qcx(st, prog, program_exports(st, prog), entry, d.view.cps)
  let t = match find_target(qc, offset) {
    Some(t) -> t
    None -> return (Err("there is no name here to rename"), kept)
  }
  let def = match t.def {
    Some(sp) -> sp
    None -> return (Err("this name is not declared in this project's sources"), kept)
  }
  let here = match list.find(occurrences(qc, offset, true), o => o.lo <= offset && offset <= o.hi) {
    Some(o) -> o
    None -> return (Err("there is no name here to rename"), kept)
  }
  let old = slice_cps(d.view.cps, here.lo, here.hi)
  if name_class(old) == Err("`${old}` is not a name") { return (Err("there is no name here to rename"), kept) }
  var ident: Map[String, String] = map.empty()
  var texts: Map[String, String] = map.empty()
  for cm in prog.modules {
    let id = canon_identity(cm.path)
    ident = map.insert(ident, cm.path, id)
    match map.get(world.texts, cm.mod_path) {
      Some(text) -> { texts = map.insert(texts, id, text) }
      None -> ()
    }
  }
  let own = map.get(ident, entry.path).expect("the requesting module's identity")
  let tpath = match t.def_path {
    None -> own
    Some(p) -> map.get(ident, p).unwrap_or(p)
  }
  let (dlo, dhi) = def
  if dlo == 0 && dhi == 0 && t.def_path != None {
    return (Err("`${old}` names a module; a module is renamed by moving its file"), kept)
  }
  # an `as` name only where the cursor's name is not the declaration's own
  # spelling: with `use lib.{first as scale}`, `lib.scale` is lib's `scale`
  let declared = match map.get(texts, tpath) {
    Some(dt) -> Some(slice_cps(code_points(dt), dlo, dhi))
    None -> None
  }
  let as_name = import_alias(entry.m, old) && declared != Some(old)
  if not as_name {
    let ids = ident
    let decl = match list.find(prog.modules, cm => map.get(ids, cm.path) == Some(tpath)) {
      Some(cm) -> cm
      None -> return (Err("`${old}` is declared outside this project's sources (in std, a builtin or a dependency); rename only changes the project's own declarations"), kept)
    }
    if package_of(decl.cx) != PkgRoot || not path_in_root(tpath, root) {
      return (Err("`${old}` is declared outside this project's sources (in std, a builtin or a dependency); rename only changes the project's own declarations"), kept)
    }
    if is_main(decl.m, def) { return (Err("`main` is the program's entry point and keeps its name"), kept) }
    match first_diag_in(prog, tpath) {
      Some(_) -> return (Err("`${decl.mod_path}` has errors; rename reads every name, so fix them first"), kept)
      None -> ()
    }
  }
  match first_diag_in(prog, own) {
    Some(_) -> return (Err("`${entry.mod_path}` has errors; rename reads every name, so fix them first"), kept)
    None -> ()
  }
  (Ok(RenameStart {
    ws: ws, lookup: lookup, root: root, world: world, prog: prog, entry: entry, ident: ident, texts: texts,
    target: Key { path: tpath, def: def }, old: old, lo: here.lo, hi: here.hi, as_name: as_name
  }), kept)
}

## `st` keeping `world` as the references program of the workspace `ws`,
## filed under `lookup`.
fn keep_world_of(st: LspState, lookup: String, ws: Workspace, world: RefsWorld) -> LspState = {
  let next = Workspace { ..ws, world: Some(world) }
  LspState { ..st, workspaces: map.insert(st.workspaces, lookup, Ready(next)) }
}

## `st` keeping the references program (and index) a rename read.
fn keep_world(st: LspState, rs: RenameStart, world: RefsWorld) -> LspState = keep_world_of(st, rs.lookup, rs.ws, world)

## `textDocument/prepareRename`: the name's range and its spelling, or why
## the name at the position cannot be renamed.
fn handle_prepare_rename(st: LspState, params: Json) -> (Result[Json, String], LspState) !Fs !Env !io =
  match doc_of(st, params) {
    Some(d) ->
      match rename_start(st, d, pos_offset(d, params)) {
        (Ok(rs), st1) -> (Ok(jobj([("range", jrange(d.view, d.ls, rs.lo, rs.hi)), ("placeholder", JStr(rs.old))])), st1)
        (Err(why), st1) -> (Err(why), st1)
      }
    None -> (Err("this document is not open"), st)
  }

## `textDocument/rename`: a `WorkspaceEdit` renaming the name at the position
## everywhere it is spelled in the project's sources, its doc links included,
## or why not (§R3.3). The edited program is analyzed before the edit is
## handed out, and refused when it has an error the program did not have or
## when any name in it resolves elsewhere than it did.
fn handle_rename(st: LspState, params: Json) -> (Result[Json, String], LspState) !Fs !Env !io = {
  let d = match doc_of(st, params) {
    Some(d) -> d
    None -> return (Err("this document is not open"), st)
  }
  let new = ostr(params, "newName")
  let rs = match rename_start(st, d, pos_offset(d, params)) {
    (Ok(r), _) -> r
    (Err(why), st1) -> return (Err(why), st1)
  }
  match check_new_name(rs.old, new) {
    Ok(_) -> ()
    Err(why) -> return (Err(why), keep_world(st, rs, rs.world))
  }
  let none: Map[String, Json] = map.empty()
  if new == rs.old { return (Ok(jobj([("changes", JObj(none))])), keep_world(st, rs, rs.world)) }
  let prog = rs.prog
  let env = program_exports(st, prog)
  var mods: Map[String, Module] = map.empty()
  for tr in st.std.srcs {
    let (mp, _, m) = tr
    mods = map.insert(mods, mp, m)
  }
  for cm in prog.modules { mods = map.insert(mods, cm.mod_path, cm.m) }
  # every module's names, read as references reads them, and the edits
  var index = rs.world.refs
  var shifts: Map[String, (String, Shift)] = map.empty()
  var edits: List[Edit] = []
  for cm in prog.modules {
    let text = match map.get(rs.world.texts, cm.mod_path) {
      Some(t) -> t
      None -> continue
    }
    let id = map.get(rs.ident, cm.path).expect("module identity")
    let kept = match map.get(index, cm.mod_path) {
      Some(old_refs) -> {
        let (fresh, next) = refresh(old_refs, rs.texts, shifts)
        shifts = next
        fresh
      }
      None -> None
    }
    let mr = match kept {
      Some(m) -> m
      None -> mod_refs(module_qcx(st, prog, env, cm, code_points(text)), id, text, rs.ident, rs.texts)
    }
    index = map.insert(index, cm.mod_path, mr)
    if rs.as_name && cm.mod_path != rs.entry.mod_path { continue }
    let cs = code_points(text)
    let (tlo, thi) = rs.target.def
    for r in refs_to(mr, rs.target.path, (tlo, thi), true) {
      # a name a `use .. as` bound keeps its own spelling
      if slice_cps(cs, r.lo, r.hi) == rs.old { edits = edits ++ [name_edit(id, r.lo, r.hi, r.pun, rs.old, new)] }
    }
    # a link spelling the old name as one of its segments: the segment is
    # renamed when the link cut after it resolves to the declaration, which
    # covers the member (`Point.x`, `geo.scale`) and the owner (`Point.x`
    # when `Point` is renamed)
    if str.contains(text, "[`") && str.contains(text, rs.old) {
      let sc = LinkScope { path: cm.mod_path, m: cm.m, cx: cm.cx }
      for sp in doc_link_spans(text) {
        let (lo, _, ltext) = sp
        for seg in link_segments(lo, ltext) {
          let (alo, ahi, prefix) = seg
          if slice_cps(cs, alo, ahi) != rs.old { continue }
          match resolve_link(sc, mods, prefix) {
            Ok(lt) ->
              match list.find(prog.modules, m2 => m2.mod_path == lt.module) {
                Some(m2) ->
                  if map.get(rs.ident, m2.path) == Some(rs.target.path) && lt.nlo == tlo {
                    edits = edits ++ [name_edit(id, alo, ahi, NotPun, rs.old, new)]
                  }
                None -> ()
              }
            Err(_) -> ()
          }
        }
      }
    }
  }
  let world = RefsWorld { ..rs.world, refs: index }
  let st1 = keep_world(st, rs, world)
  # the edits by file, and the files as they would read
  var by_path: Map[String, List[Edit]] = map.empty()
  for e in edits {
    if not path_in_root(e.path, rs.root) {
      return (Err("renaming `${rs.old}` would edit ${e.path}, which is outside this project's sources"), st1)
    }
    by_path = map.insert(by_path, e.path, map.get(by_path, e.path).unwrap_or([]) ++ [e])
  }
  var after_texts = rs.texts
  for pr in map.entries(by_path) {
    let (p, es) = pr
    let one = ordered(es)
    by_path = map.insert(by_path, p, one)
    after_texts = map.insert(after_texts, p, apply_edits(map.get(rs.texts, p).expect("an edited file's text"), one))
  }
  # the edited program, analyzed from the references program's own session
  # and parses; what it remembers is not kept, the edit is not applied yet
  let after = match workspace_inputs(st, rs.ws.plan, rs.ws.path_by_uri) {
    InputsConflict(_) -> return (Err("two open documents disagree about one file"), st1)
    InputsReady(overlay, entries, _) -> {
      var over = overlay
      for cm in prog.modules {
        let id = map.get(rs.ident, cm.path).expect("module identity")
        if map.has(by_path, id) { over = map.insert(over, cm.path, map.get(after_texts, id).expect("edited text")) }
      }
      for pr in map.entries(rs.ws.path_by_uri) {
        let (_, p) = pr
        let id = canon_identity(p)
        if map.has(by_path, id) { over = map.insert(over, p, map.get(after_texts, id).expect("edited text")) }
      }
      let read = load_entries_reusing(rs.ws.plan, entries ++ rs.world.seeds, over, rs.world.parses)
      incremental.analyze(rs.world.cache, read.loaded).program
    }
  }
  # no error the program did not have
  var before_counts: Map[String, Int] = map.empty()
  for ld in prog.diags {
    let id = canon_identity(ld.path)
    before_counts = map.insert(before_counts, id, map.get(before_counts, id).unwrap_or(0) + 1)
  }
  var after_counts: Map[String, Int] = map.empty()
  for ld in rendered_diags(after) {
    let id = canon_identity(ld.path)
    let n = map.get(after_counts, id).unwrap_or(0) + 1
    after_counts = map.insert(after_counts, id, n)
    if n > map.get(before_counts, id).unwrap_or(0) {
      let text = map.get(after_texts, id).unwrap_or("")
      let (line, ch) = lsp_position(view_of(text), line_starts_of(text), ld.d.lo)
      return (Err("renaming `${rs.old}` to `${new}` breaks the program: ${id}:${line + 1}:${ch + 1}: ${ld.d.msg}"), st1)
    }
  }
  # no name that resolves elsewhere than it did: in every edited module and
  # every module that spells the new name somewhere
  let after_env = program_exports(st, after)
  let ixs = edit_index(by_path)
  for cm in after.modules {
    let id = match map.get(rs.ident, cm.path) {
      Some(i) -> i
      None -> continue
    }
    let text = match map.get(after_texts, id) {
      Some(t) -> t
      None -> continue
    }
    if not map.has(by_path, id) && not spells(text, new) { continue }
    let before = match map.get(index, cm.mod_path) {
      Some(mr) -> mr.refs
      None -> continue
    }
    let mr2 = mod_refs(module_qcx(st, after, after_env, cm, code_points(text)), id, text, rs.ident, after_texts)
    match changed_name(id, before, mr2.refs, ixs, rs.target) {
      Some(at) -> {
        let (line, ch) = lsp_position(view_of(text), line_starts_of(text), at)
        return (Err("renaming `${rs.old}` to `${new}` would change what the name at ${id}:${line + 1}:${ch + 1} refers to"), st1)
      }
      None -> ()
    }
  }
  # the edit, by document
  var uri_of: Map[String, String] = map.empty()
  for uri in sort(map.keys(rs.ws.path_by_uri)) {
    let p = canon_identity(map.get(rs.ws.path_by_uri, uri).expect("workspace path"))
    if not map.has(uri_of, p) { uri_of = map.insert(uri_of, p, uri) }
  }
  var changes: Map[String, Json] = map.empty()
  for pr in map.entries(by_path) {
    let (p, es) = pr
    let text = map.get(rs.texts, p).expect("an edited file's text")
    let view = view_of(text)
    let ls = line_starts_of(text)
    let uri = map.get(uri_of, p).unwrap_or(path_to_uri(p))
    changes = map.insert(changes, uri, JArr(map(es, e => jobj([("range", jrange(view, ls, e.lo, e.hi)), ("newText", JStr(e.text))]))))
  }
  (Ok(jobj([("changes", JObj(changes))])), st1)
}

## Resolve a definition site to a Location: a None def_path (or one naming the
## requesting document) maps through the live buffer; another file maps
## through a live buffer only when it belongs to the requesting source root,
## else the text on disk. The lookup key is never interpreted as a path, and a
## standalone analysis never borrows another document's world.
fn path_in_root(path: String, root: String) -> Bool =
  if path == root {
    true
  } else if root == "/" {
    str.starts_with(path, "/")
  } else {
    str.starts_with(path, "${root}/")
  }

fn location_of(
  st: LspState,
  d: Doc,
  workspace_key: Option[String],
  definition_root: Option[String],
  def_path: Option[String],
  lo: Int,
  hi: Int
) -> Option[Json] !Fs !Env =
  match def_source(st, d, workspace_key, definition_root, def_path) {
    Some(InBuffer(d2)) -> Some(jobj([("uri", JStr(d2.uri)), ("range", jrange(d2.view, d2.ls, lo, hi))]))
    Some(OnDisk(path, text)) ->
      Some(jobj([
        ("uri", JStr(path_to_uri(path))),
        ("range", jrange(view_of(text), line_starts_of(text), lo, hi))
      ]))
    None -> None
  }

## Where the text of a definition's file is read: a live buffer, or the file
## on disk at its canonical path.
type DefSource = InBuffer(d: Doc) | OnDisk(path: String, text: String)

## The one lookup behind a definition's location and a hover's doc, so the two
## never read different texts for the same declaration (the rule is the one
## above `location_of`).
fn def_source(
  st: LspState,
  d: Doc,
  workspace_key: Option[String],
  definition_root: Option[String],
  def_path: Option[String]
) -> Option[DefSource] !Fs !Env = {
  let same = match def_path {
    None -> true
    Some(dp) ->
      match d.canonical_path {
        Some(p) -> canon_identity(dp) == p
        None -> false
      }
  }
  if same { return Some(InBuffer(d)) }
  let dp = match def_path {
    Some(p) -> p
    None -> return None
  }
  let dc = canon_identity(dp)
  let slot = match workspace_key {
    Some(key) -> map.get(st.workspaces, key)
    None -> None
  }
  match slot {
    Some(Ready(ws)) ->
      match definition_root {
        Some(root) ->
          if path_in_root(dc, root) {
            for uri in sort(map.keys(ws.path_by_uri)) {
              if map.get(ws.path_by_uri, uri).expect("workspace path") == dc {
                return Some(InBuffer(map.get(st.docs, uri).expect("workspace document")))
              }
            }
          }
        None -> ()
      }
    _ -> ()
  }
  match io.read_file(dc) {
    Ok(text) -> Some(OnDisk(dc, text))
    Err(_) -> None
  }
}

## The `##` doc of a hovered declaration (docs/lsp-hover-design.md §A3), read
## from the text its spans index: this document, std's own copy of a std
## module (embedded or not), or another project file the way go to definition
## reads it. The key names the file for `doc_src_memo`.
fn target_doc(st: LspState, d: Doc, analysis: Analysis, qc: QCx, t: Target) -> (Option[String], LspState) !Fs !Env =
  match t.doc {
    Some(site) -> site_doc(st, d, analysis, qc, site)
    None -> (None, st)
  }

## The doc at `site`, links resolved: what hover, completion resolve and
## signature help all show, so the three never disagree about a declaration.
fn site_doc(st: LspState, d: Doc, analysis: Analysis, qc: QCx, site: DocSite) -> (Option[String], LspState) !Fs !Env = {
  let found: Option[(String, String)] = match site.home {
    DocHere -> Some(("doc ${d.uri}", d.text))
    DocStd(mp) -> {
      var hit: Option[(String, String)] = None
      for tr in qc.std.srcs {
        let (smp, stext, _) = tr
        if smp == mp && hit == None { hit = Some(("std ${mp}", stext)) }
      }
      hit
    }
    DocFile(path) ->
      match def_source(st, d, analysis.workspace_key, analysis.definition_root, Some(path)) {
        Some(InBuffer(d2)) -> Some(("doc ${d2.uri}", d2.text))
        Some(OnDisk(p, text)) -> Some(("file ${p}", text))
        None -> None
      }
  }
  let (key, text) = match found {
    Some(kt) -> kt
    None -> return (None, st)
  }
  let (doc, st2) = match site.at {
    DeclAt(lo) -> {
      if not may_have_doc(text, lo) { return (None, st) }
      let (src, st1) = doc_src_memo(st, key, text)
      (doc_in(src, lo), st1)
    }
    ModuleDoc -> {
      # a module doc opens the file, so a text that does not start with `##`
      # has none, and is not lexed
      if not str.starts_with(str.trim_start(text), "##") { return (None, st) }
      let m = match scope_of(qc, site.home) {
        Some(sc) -> sc.m
        None -> {
          let (pm, _) = source_parser.parse_module(text)
          pm
        }
      }
      let (src, st1) = doc_src_memo(st, key, text)
      (blank_none(module_doc_of(src, m)), st1)
    }
  }
  match doc {
    Some(text2) -> (Some(linked_doc(st2, d, analysis, qc, site.home, text2)), st2)
    None -> (None, st2)
  }
}

## A hover doc with its `[`name`]` links turned into Markdown links to the
## declarations they name (docs/lsp-hover-design.md §A5): resolved by the
## resolver `dawn doc` uses, in the scope of the module the doc is written in,
## and pointed at the declaration's file and line as a `file://` URI with a
## `#L<line>,<column>` fragment, which is what an editor opens a hover link
## with. A link that resolves to nothing, or to something with no file (the
## prelude, a std read from the embedded copy), stays as written: CommonMark
## renders it as bracketed code, which is also what it looks like to a client
## that renders no Markdown at all.
fn linked_doc(st: LspState, d: Doc, analysis: Analysis, qc: QCx, home: DocHome, doc: String) -> String !Fs !Env = {
  if not str.contains(doc, "[`") { return doc }
  let sc = match scope_of(qc, home) {
    Some(s) -> s
    None -> return doc
  }
  var mods: Map[String, Module] = map.empty()
  for tr in qc.std.srcs {
    let (mp, _, m) = tr
    mods = map.insert(mods, mp, m)
  }
  for cm in qc.prog.modules { mods = map.insert(mods, cm.mod_path, cm.m) }
  mods = map.insert(mods, qc.entry.mod_path, qc.entry.m)
  var to: Map[String, String] = map.empty()
  for l in doc_links(doc) {
    if map.has(to, l.text) { continue }
    match resolve_link(sc, mods, l.text) {
      Ok(t) -> {
        let def_path: Option[Option[String]] =
          if t.module == qc.entry.mod_path {
            Some(None)
          } else {
            var found: Option[Option[String]] = None
            for cm in qc.prog.modules {
              if cm.mod_path == t.module && found == None { found = Some(Some(cm.path)) }
            }
            if found == None && t.module != "" {
              match std_file_of(qc.std, t.module) {
                Some(f) -> { found = Some(Some(f)) }
                None -> ()
              }
            }
            found
          }
        match def_path {
          Some(dp) -> {
            let lo = if t.nlo < 0 { 0 } else { t.nlo }
            match def_source(st, d, analysis.workspace_key, analysis.definition_root, dp) {
              Some(InBuffer(d2)) -> {
                let (line, ch) = lsp_position(d2.view, d2.ls, lo)
                to = map.insert(to, l.text, "${d2.uri}#L${line + 1},${ch + 1}")
              }
              Some(OnDisk(path, text)) -> {
                let (line, ch) = lsp_position(view_of(text), line_starts_of(text), lo)
                to = map.insert(to, l.text, "${path_to_uri(path)}#L${line + 1},${ch + 1}")
              }
              None -> ()
            }
          }
          None -> ()
        }
      }
      Err(_) -> ()
    }
  }
  let uris = to
  rewrite_links(doc, text => match map.get(uris, text) {
    Some(uri) -> Some(link_markdown(text, uri))
    None -> None
  })
}

## The module a doc is written in, with the import tables its links resolve
## against: the analyzed document, another program file, or a std module.
fn scope_of(qc: QCx, home: DocHome) -> Option[LinkScope] =
  match home {
    DocHere -> Some(LinkScope { path: qc.entry.mod_path, m: qc.entry.m, cx: qc.entry.cx })
    DocFile(path) -> {
      for cm in qc.prog.modules {
        if cm.path == path { return Some(LinkScope { path: cm.mod_path, m: cm.m, cx: cm.cx }) }
      }
      None
    }
    DocStd(mp) -> {
      for i in range(0, len(qc.std.mods)) {
        let (smp, cx, _, _) = qc.std.mods[i]
        let (_, _, m) = qc.std.srcs[i]
        if smp == mp { return Some(LinkScope { path: mp, m: m, cx: cx }) }
      }
      None
    }
  }

## The markdown a hover replies with: `lspdoc.hover_markdown` over the target,
## whose text gains the value of a closed, pure expression (§C5). The budget is
## the editor's on this host (`ct_hover`), so the JVM and native servers fold
## to the same answer.
fn hover_value(st: LspState, d: Doc, analysis: Analysis, qc: QCx, t: Target) -> (String, LspState) !Fs !Env !io = {
  let (doc, st2) = target_doc(st, d, analysis, qc, t)
  (hover_markdown(with_value(qc, t, ct_hover(st.host.ct)), doc), st2)
}

## `textDocument/inlayHint`: the hints `lspq.inlay_hints` finds inside the
## requested range, in LSP 3.17's shape. Padding is written only where it is
## on, which is what the protocol defaults the absent field to. Left-out
## defaults get their values folded under hover's budget (§C4), so the JVM and
## native servers show the same ones.
fn handle_inlay_hint(st: LspState, params: Json) -> Json !io = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, d, analysis) {
            Some(qc) -> {
              let r = get_or_null(params, "range")
              let rs = get_or_null(r, "start")
              let re = get_or_null(r, "end")
              let lo = lsp_offset(d.view, d.ls, oint(rs, "line"), oint(rs, "character"))
              let hi = lsp_offset(d.view, d.ls, oint(re, "line"), oint(re, "character"))
              var out: List[Json] = []
              let found = inlay_hints(qc, lo, hi, st.inlay)
              let hints = if st.inlay.default_args && st.inlay.default_values {
                with_default_values(qc, found, ct_hover(st.host.ct))
              } else { found }
              for h in hints {
                let (line, ch) = lsp_position(d.view, d.ls, h.at)
                var fields: List[(String, Json)] = [
                  ("position", jpos(line, ch)),
                  ("label", JStr(h.label)),
                  ("kind", JInt(if h.kind == HintParam { 2 } else { 1 }))
                ]
                if h.pad_left { fields = fields ++ [("paddingLeft", JBool(true))] }
                if h.pad_right { fields = fields ++ [("paddingRight", JBool(true))] }
                out = out ++ [jobj(fields)]
              }
              JArr(out)
            }
            None -> JNull
          }
        None -> JNull
      }
    None -> JNull
  }
}

## The legend and the two requests answered (docs/lsp-references-design.md
## §T1): `full` and `range`, no `delta`, whose saving is the payload while the
## cost is the walk.
fn semantic_tokens_provider() -> Json =
  jobj([
    ("legend", jobj([
      ("tokenTypes", JArr(map(token_types(), t => JStr(t)))),
      ("tokenModifiers", JArr(map(token_modifiers(), m => JStr(m))))
    ])),
    ("full", JBool(true)),
    ("range", JBool(true))
  ])

## `textDocument/semanticTokens/full` and `/range`: `lsptok.semantic_tokens`
## in LSP's relative encoding over UTF-16 columns. A document with no analysis
## (unknown, not yet analyzed, its workspace still loading) answers with no
## tokens rather than an error: the grammar's colours stand until one exists.
fn handle_semantic_tokens(st: LspState, params: Json, ranged: Bool) -> Json = {
  let none: List[Json] = []
  let empty = jobj([("data", JArr(none))])
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, d, analysis) {
            Some(qc) -> {
              let (lo, hi) = if ranged {
                let r = get_or_null(params, "range")
                let rs = get_or_null(r, "start")
                let re = get_or_null(r, "end")
                (lsp_offset(d.view, d.ls, oint(rs, "line"), oint(rs, "character")),
                  lsp_offset(d.view, d.ls, oint(re, "line"), oint(re, "character")))
              } else {
                (0, len(d.view.cps))
              }
              var rows: List[(Int, Int, Int, Int, Int)] = []
              for t in semantic_tokens(qc, lo, hi) {
                let (line, col) = lsp_position(d.view, d.ls, t.lo)
                let (eline, ecol) = lsp_position(d.view, d.ls, t.hi)
                if eline == line && ecol > col { rows = rows ++ [(line, col, ecol - col, t.ty, t.mods)] }
              }
              jobj([("data", JArr(map(encode_tokens(rows), n => JInt(n))))])
            }
            None -> empty
          }
        None -> empty
      }
    None -> empty
  }
}

fn handle_symbols(st: LspState, params: Json) -> Json !io = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, d, analysis) {
            Some(qc) -> {
              var out: List[Json] = []
              for dc in qc.entry.m.decls {
                match decl_symbol(qc, d, dc) {
                  Some(j) -> { out = out ++ [j] }
                  None -> ()
                }
              }
              JArr(out)
            }
            None -> JArr([])
          }
        None -> JArr([])
      }
    None -> JArr([])
  }
}

## One top-level declaration as a DocumentSymbol (Function=12, Class=5).
fn decl_symbol(qc: QCx, d: Doc, dc: Decl) -> Option[Json] !io = {
  let info: Option[(String, Bool, Int, Int, Int, Int)] = match dc {
    DFn(f) -> Some((f.name, true, f.lo, f.hi, f.nlo, f.nhi))
    DType(t) -> Some((t.name, false, t.lo, t.hi, t.nlo, t.nhi))
    DConst(name, _, _, _, lo, hi, nlo, nhi) -> Some((name, false, lo, hi, nlo, nhi))
    DTrait(name, _, _, _, _, _, _, _, lo, hi, nlo, nhi) -> Some((name, false, lo, hi, nlo, nhi))
    DEffect(e) -> Some((e.name, false, e.lo, e.hi, e.nlo, e.nhi))
    DImpl(_, trait_name, tlo, thi, _, _, _, _, lo, hi) -> Some((trait_name, false, lo, hi, tlo, thi))
    DUseJava(fqcn, lo, hi, nlo, nhi) -> {
      let simple = match str.last_index_of(fqcn, ".") {
        Some(i) -> str.drop(fqcn, i + 1)
        None -> fqcn
      }
      Some((simple, false, lo, hi, nlo, nhi))
    }
    DUseModule(segs, _, aname, lo, hi, nlo, nhi) -> {
      let nm = match aname {
        Some(a) -> a.name
        None -> segs[len(segs) - 1]
      }
      Some((nm, false, lo, hi, nlo, nhi))
    }
    DTest(name, _, lo, hi, nlo, nhi, _) -> Some((name, false, lo, hi, nlo, nhi))
  }
  match info {
    Some(k) -> {
      let (name, is_fn, lo, hi, nlo, nhi) = k
      var fields: List[(String, Json)] = [("name", JStr(name))]
      if is_fn {
        match map.get(qc.entry.cx.fns, name) {
          Some(sig) -> {
            fields = fields ++
              [("detail", JStr(sig_render(qc.entry.cx.adts, qc.entry.cx.traits, sig)))]
          }
          None -> ()
        }
      }
      fields = fields ++ [
        ("kind", JInt(if is_fn { 12 } else { 5 })),
        ("range", jrange(d.view, d.ls, lo, hi)),
        ("selectionRange", jrange(d.view, d.ls, nlo, nhi))
      ]
      Some(jobj(fields))
    }
    None -> None
  }
}

fn handle_formatting(st: LspState, params: Json) -> Json !io = {
  match doc_of(st, params) {
    Some(d) -> {
      # No edits when the document does not lex. The formatter reprints tokens,
      # and an unrecognized character produces none, so an edit built from a
      # failed lex deletes what the lexer skipped -- which format-on-save would
      # then apply to a file the user is in the middle of typing.
      let formatted = match fmt.format(d.text) {
        Ok(s) -> s
        Err(_) -> return JArr([])
      }
      if formatted == d.text { return JArr([]) }
      # replace the whole document
      let lines = str.split(d.text, "\n")
      let last = lines[len(lines) - 1]
      JArr([jobj([
        ("range", jobj([
          ("start", jpos(0, 0)),
          ("end", jpos(len(lines) - 1, utf16_len(last)))
        ])),
        ("newText", JStr(formatted))
      ])])
    }
    None -> JArr([])
  }
}

# ---- code actions ----

## `dawn fmt` reads tokens and cannot know what a module uses, so removing an
## unused import -- a compile error (docs/unused-imports-design.md §6) -- is
## offered here instead: one quickfix per `unused import: <name>` diagnostic
## the client hands back. Only those: any other diagnostic, or a range with
## none, gets no action. The edit is computed on the buffer as it is now, and
## a buffer that no longer has that import at that place gets nothing rather
## than a guess.
fn handle_code_action(st: LspState, params: Json) -> Json = {
  let d = match doc_of(st, params) {
    Some(found) -> found
    None -> return JArr([])
  }
  let uri = ostr(get_or_null(params, "textDocument"), "uri")
  let given = match oget(get_or_null(params, "context"), "diagnostics") {
    Some(JArr(xs)) -> xs
    _ -> []
  }
  let (m, _) = source_parser.parse_module(d.text)
  var out: List[Json] = []
  for dj in given {
    let first = str.split(ostr(dj, "message"), "\n")[0]
    match str.strip_prefix(first, "unused import: ") {
      Some(name) -> {
        let start = get_or_null(get_or_null(dj, "range"), "start")
        let at = lsp_offset(d.view, d.ls, oint(start, "line"), oint(start, "character"))
        match import_use.removal_span(m, at, name) {
          Some((lo, hi0, whole)) -> {
            # a whole declaration takes its line break with it
            let hi = if whole && hi0 < len(d.view.cps) && d.view.cps[hi0] == '\n' { hi0 + 1 } else { hi0 }
            let edit = jobj([("range", jrange(d.view, d.ls, lo, hi)), ("newText", JStr(""))])
            out = out ++ [jobj([
              ("title", JStr("Remove unused import `" ++ name ++ "`")),
              ("kind", JStr("quickfix")),
              ("diagnostics", JArr([dj])),
              ("isPreferred", JBool(true)),
              ("edit", jobj([("changes", jobj([(uri, JArr([edit]))]))]))
            ])]
          }
          None -> ()
        }
      }
      None -> ()
    }
  }
  JArr(out)
}

test "a bundled std buffer keeps its std identity through the document seam" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    # `standalone_doc` is where `textDocument/didOpen` records what a buffer is.
    # It used to write the literal "main", which `analyze_standalone` proposes
    # and is not always what comes back: a source file of the bundled std is
    # checked under its real std module path, and every query keyed by mod_path
    # -- hover, go to definition -- resolves through `analysis.entry`. Writing
    # the literal here leaves the diagnostics right and every query on a std
    # buffer answering nothing, which is the shape of failure no diagnostic
    # count can see.
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let no_docs: Map[String, Doc] = map.empty()
    let no_ws: Map[String, WorkspaceSlot] = map.empty()
    let st = LspState {
      std: std,
      bins: builtins(),
      docs: no_docs,
      workspaces: no_ws,
      standalone: Some(jsig_refused_lease()),
      host: LspLeaseHost {
        standalone: () => jsig_refused_lease(),
        project: (_plan: source.SourcePlan) => Ok(jsig_refused_lease()),
        ct: ct_default()
      },
      analysis_config: legacy_analysis_config(),
      lifecycle: Running,
      watch_manifests: false,
      related_information: false,
      doc_memo: map.empty(),
      inlay: default_inlay_opts(),
      default_item_data: false
    }
    let path = "std/cursor.dawn"
    let text = match io.read_file(path) {
      Ok(t) -> t
      Err(e) -> panic("std/cursor.dawn: ${e.message}")
    }
    let no_modules: Option[Map[String, String]] = None
    let d = standalone_doc(st, "file://${canon_identity(path)}", Some(path), Some(canon_identity(path)),
      text, 0, no_modules)
    match d.analysis {
      Standalone(prog, entry, _) -> {
        assert len(prog.diags) == 0
        assert entry == "std/cursor"
        # the identity is not decoration: this is the lookup every query makes
        match doc_qcx(st, d, Analysis {
          prog: prog,
          entry: entry,
          modules: no_modules,
          workspace_key: None,
          definition_root: None
        }) {
          Some(qc) -> { assert qc.entry.cx.is_std_module }
          None -> panic("the std buffer's entry module was not found by mod_path")
        }
      }
      WorkspaceMember(_) -> panic("a std source is not a workspace member")
    }

    # a buffer that is not one of the bundle's files stays `main`
    let elsewhere = "/tmp/dawn-selfhost-lsp-std/cursor.dawn"
    let _ = io.mkdirs("/tmp/dawn-selfhost-lsp-std")
    match io.write_file(elsewhere, text) {
      Ok(_) -> ()
      Err(e) -> panic("test setup: ${e.message}")
    }
    let d2 = standalone_doc(st, "file://${elsewhere}", Some(elsewhere),
      Some(canon_identity(elsewhere)), text, 0, no_modules)
    match d2.analysis {
      Standalone(prog2, entry2, _) -> {
        assert entry2 == "main"
        assert len(prog2.diags) > 0
      }
      WorkspaceMember(_) -> panic("a standalone buffer is not a workspace member")
    }
  }))
}

test "the language server's std is the toolchain's, not the client's cwd" {
  # `run_lsp` used to be called with the bare literal "std", resolved against
  # whatever directory the editor happened to spawn the server in. Same binary,
  # same file, cwd one level above the checkout: 0 diagnostics became 7, all of
  # them "undefined function" on a std source that `dawn check` calls clean.
  # The rule this pins is the order, and the middle entry is the fix. It is
  # every subcommand's order since #291 (driver/stdlib `std_choice`, pinned
  # there as well); this is the server's half of that contract.
  let none: Option[String] = None

  # an explicit --std is the client speaking and wins over everything
  assert std_choice(Some("/asked/for/std"), Some("/toolchain/std")) == Some("/asked/for/std")
  assert std_choice(Some("/asked/for/std"), none) == Some("/asked/for/std")

  # otherwise the std belonging to this toolchain, handed down by the launcher
  assert std_choice(none, Some("/toolchain/std")) == Some("/toolchain/std")

  # and with nothing to go on, the embedded copy: no directory, and in
  # particular not `std` under the cwd, which is what answered here before
  # #291. An installed release has no directory either way.
  assert std_choice(none, none) == none

  # the flag itself, which `lsp` did not parse at all before
  assert lsp_std_flag(["--std", "/x"]) == Some("/x")
  assert lsp_std_flag(["--std", "/x", "--std", "/y"]) == Some("/x")
  assert lsp_std_flag([]) == none
  # a trailing `--std` names no directory, so there is nothing to honour
  assert lsp_std_flag(["--std"]) == none
  assert lsp_std_flag(["--stdlib", "/x"]) == none
}

# ---- go to definition: which file the reply names ----

fn def_probe_state(std: StdCtx) -> LspState = {
  let no_docs: Map[String, Doc] = map.empty()
  let no_ws: Map[String, WorkspaceSlot] = map.empty()
  LspState {
    std: std,
    bins: builtins(),
    docs: no_docs,
    workspaces: no_ws,
    standalone: Some(jsig_refused_lease()),
    host: LspLeaseHost {
      standalone: () => jsig_refused_lease(),
      project: (_plan: source.SourcePlan) => Ok(jsig_refused_lease()),
      ct: ct_default()
    },
    analysis_config: legacy_analysis_config(),
    lifecycle: Running,
    watch_manifests: false,
    related_information: false,
    doc_memo: map.empty(),
    inlay: default_inlay_opts(),
    default_item_data: false
  }
}

test "LSP analysis configuration keeps legacy defaults and rejects negative limits" {
  let legacy = legacy_analysis_config()
  assert legacy.mode == Legacy && legacy.max_modules == 128
  let negative = LspAnalysisConfig { ..legacy, max_modules: -1 }
  assert match catch_panic(() => validate_analysis_config(negative)) { Err(_) -> true, Ok(_) -> false }
}

test "workspace commits its module memo with its Program and drops it on conflict" {
  let root = memfs.BASE ++ "/prefix-project"
  let path = root ++ "/src/main.dawn"
  let uri = "file://" ++ path
  let text = "use lib\npub fn answer() -> Int = lib.value() + 1\n"
  var files = fsmem.mem_std(memfs.BASE)
  files = memfs.put(files, root ++ "/dawn.toml", "schema = 1\nname = \"prefix_project\"\n")
  files = memfs.put(files, root ++ "/src/lib.dawn", "pub fn value() -> Int = 41\n")
  files = memfs.put(files, path, text)
  let _ = memfs.with_fs(files, () => io.with_proc_real(() =>
      envmem.with_env_table(memfs.BASE, [], () => {
        let std = match load_std(fsmem.mem_std_dir(memfs.BASE)) {
          Ok(s) -> s
          Err(e) -> panic(std_load_error_text(e))
        }
        let plan = project_plan(source.SourceFile(path))
        let identity = workspace_identity(plan)
        let doc = Doc {
          uri: uri, version: 1, path: Some(path), canonical_path: Some(path),
          text: text, view: view_of(text), ls: line_starts_of(text),
          analysis: WorkspaceMember(identity)
        }
        let base = def_probe_state(std)
        let st = LspState { ..base, docs: map.insert(base.docs, uri, doc) }
        let lease = jsig_refused_lease()
        let empty = Workspace {
          plan: plan, path_by_uri: map.insert(map.empty(), uri, path),
          prog: None, entry_by_uri: map.empty(), lease: lease,
          cache: incremental.new(std, ct_default(), lease.jsig, 128),
          analysis_stats: None, parses: no_parses(), diag_by_uri: map.empty(),
          refresh_problem: None, world: None
        }
        let first = rebuild_workspace(st, empty)
        assert len(first.prog.expect("first Program").diags) == 0
        assert first.analysis_stats.expect("first counts").checked_modules == 2
        assert first.parses.reused == 0
        let warm = rebuild_workspace(st, first)
        assert warm.analysis_stats.expect("warm counts").reused_modules == 2
        assert warm.analysis_stats.expect("warm counts").checked_modules == 0
        assert warm.parses.reused == 2
        let changed = text ++ "# edit\n"
        let edited = Doc { ..doc, text: changed, view: view_of(changed), ls: line_starts_of(changed), version: 2 }
        let next = LspState { ..st, docs: map.insert(st.docs, uri, edited) }
        let updated = rebuild_workspace(next, warm)
        assert len(updated.prog.expect("updated Program").diags) == 0
        assert updated.analysis_stats.expect("edited counts").reused_modules == 1
        assert updated.analysis_stats.expect("edited counts").checked_modules == 1
        # the edited buffer is parsed again and its import is not
        assert updated.parses.reused == 1
        assert map.get(updated.entry_by_uri, uri) == Some("main")
        let duplicate_uri = "file://" ++ root ++ "/src/./main.dawn"
        let duplicate = Doc { ..doc, uri: duplicate_uri }
        let conflicted = LspState { ..next, docs: map.insert(next.docs, duplicate_uri, duplicate) }
        let conflict = rebuild_workspace(conflicted,
          Workspace { ..updated, path_by_uri: map.insert(updated.path_by_uri, duplicate_uri, path) })
        match conflict.prog {
          None -> ()
          Some(_) -> { assert false }
        }
        assert conflict.analysis_stats == None
        assert len(map.keys(conflict.entry_by_uri)) == 0
        let restored = rebuild_workspace(next,
          Workspace { ..conflict, path_by_uri: updated.path_by_uri })
        assert len(restored.prog.expect("restored Program").diags) == 0
        assert restored.analysis_stats.expect("restored counts").reused_modules == 0
        assert restored.analysis_stats.expect("restored counts").checked_modules == 2
      })))
}

## A buffer that names a std function, deliberately written outside the
## checkout: the file a definition reply names has to come from the std the
## compiler loaded, never from where the buffer happens to sit.
fn def_probe_text() -> String =
  join([
    "use std/list",
    "",
    "fn helper(n: Int) -> Int = n + 1",
    "",
    "pub fn main() -> Unit !io = {",
    "  let xs = list.reverse([1, 2, 3])",
    "  if helper(xs[0]) > 0 { println(\"ok\") }",
    "}",
    ""
  ], "\n")

fn def_probe_put(path: String, text: String) -> Unit !Fs =
  match io.write_file(path, text) {
    Ok(_) -> ()
    Err(e) -> panic("test setup: ${e.message}")
  }

fn def_probe_doc_named(st: LspState, name: String, text: String) -> Doc !Fs !Env !io = {
  let dir = "/tmp/dawn-selfhost-lsp-def"
  let path = dir ++ "/" ++ name
  let _ = io.mkdirs(dir)
  def_probe_put(path, text)
  let no_modules: Option[Map[String, String]] = None
  standalone_doc(st, path_to_uri(canon_identity(path)), Some(path), Some(canon_identity(path)), text,
    0, no_modules)
}

fn def_probe_doc(st: LspState, text: String) -> Doc !Fs !Env !io =
  def_probe_doc_named(st, "main.dawn", text)

fn def_probe_at(st: LspState, d: Doc, text: String, needle: String, skip: Int) -> Target = {
  let off = match str.index_of(text, needle) {
    Some(i) -> i + skip
    None -> panic("probe text has no ${needle}")
  }
  match analysis_of(st, d) {
    Some(analysis) ->
      match doc_qcx(st, d, analysis) {
        Some(qc) ->
          match find_target(qc, off) {
            Some(t) -> t
            None -> panic("nothing under the cursor at ${needle}")
          }
        None -> panic("the probe buffer has no QCx")
      }
    None -> panic("the probe buffer has no analysis")
  }
}

fn def_probe_span(t: Target, what: String) -> (Int, Int) =
  match t.def {
    Some(sp) -> sp
    None -> panic("no definition offered for ${what}")
  }

test "a definition in std names std's file and points at the declaration" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    # The bug this pins: `def_path` None means "the document being analyzed", and
    # std used to answer with it. `location_of` then mapped std's offsets through
    # the requesting buffer's line table and replied with that buffer's uri, so
    # "go to definition" on `reverse` jumped to an unrelated place in the file the
    # request came from. A confidently wrong location, not a missing one.
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = def_probe_text()
    let d = def_probe_doc(st, text)

    let t = def_probe_at(st, d, text, "list.reverse", 5)
    let dp = match t.def_path {
      Some(p) -> p
      None -> panic("a definition in std must name std's file")
    }
    assert dp == canon_identity("std/list.dawn")

    # The span is std's, so it only means anything read against std's own text.
    # Slicing the file is what tells a right answer from a plausible one: the
    # pre-fix reply had a range too, and it addressed the wrong document.
    let (lo, hi) = def_probe_span(t, "list.reverse")
    let src = match io.read_file(dp) {
      Ok(s) -> s
      Err(e) -> panic("std/list.dawn: ${e.message}")
    }
    assert str.slice(src, lo, hi) == "reverse"

    # and the Location the client is handed names that file, not this buffer
    let nokey: Option[String] = None
    match location_of(st, d, nokey, nokey, t.def_path, lo, hi) {
      Some(loc) -> {
        assert ostr(loc, "uri") == path_to_uri(canon_identity("std/list.dawn"))
        assert ostr(loc, "uri") != d.uri
      }
      None -> panic("a std file that exists must resolve to a Location")
    }

    # `use std/list` reaches location_of through DUseModule, which reads
    # ModExports.src_path -- and std modules are checked with no src_path on
    # purpose, so the bundle's own record is the only thing that can answer.
    let u = def_probe_at(st, d, text, "std/list", 0)
    assert u.def_path == Some(canon_identity("std/list.dawn"))
  }))
}

test "an embedded std offers no definition instead of one in the wrong file" {
  io.with_fs_real(() => no_host(() => {
    # A released toolchain in a project with no std directory: the embedded copy
    # answers, and there is no file on disk to jump into. The honest reply is no
    # definition at all. Emitting a None path here would be the original bug --
    # None is the entry document, and std is not it.
    let emb = match load_std("/tmp/dawn-selfhost-lsp-def/no-std-here") {
      Ok(sc) -> sc
      Err(e) -> panic("embedded std: ${std_load_error_text(e)}")
    }
    let absent: Option[String] = None
    assert emb.dir == absent
    let st = def_probe_state(emb)
    let text = def_probe_text()
    let d = def_probe_doc(st, text)

    let t = def_probe_at(st, d, text, "list.reverse", 5)
    match t.def {
      Some(_) -> panic("an embedded std module has no file to point into")
      None -> ()
    }
    # `handle_definition` replies [] on a None def, so location_of is never
    # reached and cannot invent a range.

    # What must survive: hover travels independently of def/def_path, and losing
    # the jump must not cost the text.
    assert str.contains(t.hover, "reverse")
    assert str.contains(t.hover, "List[T]")

    # local definitions are unaffected by which half of std answered
    let l = def_probe_at(st, d, text, "helper(xs", 0)
    assert l.def_path == absent
    let (llo, lhi) = def_probe_span(l, "helper")
    assert str.slice(text, llo, lhi) == "helper"
  }))
}

test "a definition of a std constant names std's file too" {
  io.with_fs_real(() => no_host(() => {
    # `site_of_const_in` reaches std by module path (`holder_by_path`) rather
    # than through `holder_by_class`, and today's bundle declares no
    # `pub const` at all, so the real std cannot exercise it: a mutant
    # reverting that branch on its own survived the whole suite. The probe std
    # is what makes the branch reachable, and it is a one-module std for the
    # same reason the id-counter probe in driver/stdlib is -- the real bundle's
    # contents are not the thing under test.
    let root = "/tmp/dawn-selfhost-lsp-def/conststd"
    let _ = io.mkdirs(root)
    def_probe_put("${root}/modules.txt", "constprobe\n")
    def_probe_put("${root}/constprobe.dawn", "pub const PROBE_LIMIT: Int = 7\n")
    let cstd = match load_std(root) {
      Ok(sc) -> sc
      Err(e) -> panic("probe std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(cstd)
    let text = join([
      "use std/constprobe.{PROBE_LIMIT}",
      "",
      "fn limit() -> Int = PROBE_LIMIT + 1",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "constuser.dawn", text)

    let t = def_probe_at(st, d, text, "PROBE_LIMIT + 1", 0)
    let dp = match t.def_path {
      Some(p) -> p
      None -> panic("a std constant must name std's file")
    }
    assert dp == canon_identity("${root}/constprobe.dawn")
    let (lo, hi) = def_probe_span(t, "PROBE_LIMIT")
    let src = match io.read_file(dp) {
      Ok(s) -> s
      Err(e) -> panic("probe std module: ${e.message}")
    }
    assert str.slice(src, lo, hi) == "PROBE_LIMIT"
  }))
}

test "a local definition still resolves against the requesting document" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    # The contract the std fix leans on, from the other side. `def_path` None has
    # to keep meaning "this buffer" -- that is what makes a definition in the file
    # being edited resolve against the live text rather than whatever is on disk.
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = def_probe_text()
    let d = def_probe_doc(st, text)

    let t = def_probe_at(st, d, text, "helper(xs", 0)
    let absent: Option[String] = None
    assert t.def_path == absent
    let (lo, hi) = def_probe_span(t, "helper")
    assert str.slice(text, lo, hi) == "helper"

    let nokey: Option[String] = None
    match location_of(st, d, nokey, nokey, t.def_path, lo, hi) {
      Some(loc) -> {
        assert ostr(loc, "uri") == d.uri
        let r = match oget(loc, "range") {
          Some(j) -> j
          None -> panic("a Location has a range")
        }
        let start = match oget(r, "start") {
          Some(j) -> j
          None -> panic("a range has a start")
        }
        # line 2 of the probe text, where `fn helper` is written
        assert oint(start, "line") == 2
      }
      None -> panic("a definition in the requesting document must resolve")
    }
  }))
}

# ---- handler state cells: what the reader points at, and what answers ----

## A `with handle` with one state cell, written at every spelling a cell has:
## the declaration, a write from inside an arm, a read inside that write's
## right-hand side, and a read from the block below the handler.
fn cell_probe_text() -> String =
  join([
    "effect Emit {",
    "  fn emit(w: Int) -> Unit",
    "}",
    "",
    "fn collect(body: fn() -> Unit !Emit) -> List[Int] = {",
    "  with handle Emit {",
    "    var acc: List[Int] = []",
    "    emit(w) => { acc = acc ++ [w * 2] }",
    "  }",
    "  body()",
    "  acc",
    "}",
    ""
  ], "\n")

test "a handler state cell answers at every spelling of it" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    # A cell is not an ordinary binding by the time it is typed: the checker
    # rewrites every read into `cell_get`/`cell_take` and every write into
    # `cell_set`, and the binding itself holds an erased slot
    # (docs/handler-state-design.md). Left to the shapes an `XLocal` and a
    # `TSAssign` make, the query answers nothing here -- and the type it would
    # answer with is the erased cell, which names nothing the author wrote.
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = cell_probe_text()
    let d = def_probe_doc_named(st, "cells.dawn", text)
    let absent: Option[String] = None

    # the declaration: the slot's type, not the erased cell, and its own name as
    # the place to jump to
    let decl = def_probe_at(st, d, text, "acc: List[Int]", 0)
    assert decl.hover == "var acc: List[Int]"
    let (dlo, dhi) = def_probe_span(decl, "the cell declaration")
    assert str.slice(text, dlo, dhi) == "acc"
    assert decl.def_path == absent

    # the write, whose left-hand side is a name the author wrote and the checker
    # did not keep: same text, and the jump lands on the declaration
    let w = def_probe_at(st, d, text, "acc = acc", 0)
    assert w.hover == "var acc: List[Int]"
    let (wlo, whi) = def_probe_span(w, "the cell write")
    assert (wlo, whi) == (dlo, dhi)

    # the read inside that write's right-hand side
    let r = def_probe_at(st, d, text, "acc ++", 0)
    assert r.hover == "var acc: List[Int]"
    assert def_probe_span(r, "the cell read") == (dlo, dhi)

    # the right-hand side itself has a type again -- `Int` and not the block's
    # `List[Int]`, which is what the whole handler answered with when nothing
    # inside it was walked
    let rhs = def_probe_at(st, d, text, "w * 2", 2)
    assert rhs.hover == "Int"

    # the arm's parameter, which is only reachable once the arm is paired with
    # the closure the checker made of it
    let p = def_probe_at(st, d, text, "emit(w) =>", 5)
    assert p.hover == "w: Int"
    let (plo, phi) = def_probe_span(p, "the arm parameter")
    assert str.slice(text, plo, phi) == "w"

    # and a read from the block below the handler, which is the remainder
    # closure rather than the arm
    let tail = def_probe_at(st, d, text, "acc\n}", 0)
    assert tail.hover == "var acc: List[Int]"
    assert def_probe_span(tail, "the cell read below the handler") == (dlo, dhi)
  }))
}

# ---- comptime values on hover (docs/lsp-hover-design.md §3) ----

fn value_probe_text() -> String =
  join([
    "const LIMIT: Int = 6 * 7",
    "const SMALL: Int = 7",
    "const NAME: String = \"da\\\"wn\"",
    "const TABLE: List[Int] = comptime { squares(200) }",
    "const HASHED: Int = hash(1)",
    "",
    "fn squares(n: Int) -> List[Int] = {",
    "  var out: List[Int] = []",
    "  var i = 0",
    "  while i < n {",
    "    out = out ++ [i * i]",
    "    i = i + 1",
    "  }",
    "  out",
    "}",
    "",
    "fn f() -> Int = LIMIT + comptime { 1 << 20 }",
    ""
  ], "\n")

test "hover shows a constant's value and a comptime block's, as analysis left them" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = value_probe_text()
    let d = def_probe_doc_named(st, "values.dawn", text)

    # the declaration and a reference read the same table entry
    assert def_probe_at(st, d, text, "LIMIT: Int", 0).hover == "const LIMIT: Int = 42  (0x2A)"
    assert def_probe_at(st, d, text, "LIMIT + comptime", 0).hover == "const LIMIT: Int = 42  (0x2A)"
    # below 10 the hexadecimal says nothing the decimal does not
    assert def_probe_at(st, d, text, "SMALL", 0).hover == "const SMALL: Int = 7"
    assert def_probe_at(st, d, text, "NAME", 0).hover == "const NAME: String = \"da\\\"wn\""
    # a long value is cut where the line ends and says how long it was
    let table = def_probe_at(st, d, text, "TABLE", 0).hover
    assert str.starts_with(table, "const TABLE: List[Int] = [0, 1, 4, 9, ")
    assert str.ends_with(table, "…]  (200 elements)")
    # the keyword answers with the block's value; inside the block the
    # innermost node still wins
    assert def_probe_at(st, d, text, "comptime { 1", 0).hover == "comptime: Int = 1048576  (0x100000)"
    assert def_probe_at(st, d, text, "1 << 20", 2).hover == "Int"
    assert def_probe_at(st, d, text, "1 << 20", 0).hover == "Int"
    # a constant comptime refused: its diagnostic, first line, says why
    assert def_probe_at(st, d, text, "HASHED", 0).hover ==
      "const HASHED: Int\n(not evaluated: builtin `hash` is not available at comptime)"
  }))
}

test "hover says a constant was not evaluated when its module has errors" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    # comptime runs only over a module the checker accepted; the value is
    # missing for that reason and the hover has to say so
    let text = join([
      "const LIMIT: Int = 42",
      "",
      "fn bad() -> Int = \"no\"",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "broken.dawn", text)
    assert def_probe_at(st, d, text, "LIMIT", 0).hover ==
      "const LIMIT: Int\n(not evaluated: module has errors)"
  }))
}

test "hover reads a std constant's value from std's own comptime results" {
  io.with_fs_real(() => no_host(() => {
    # the same one-module probe std as the definition test above, for the same
    # reason: the real bundle's constants are not the thing under test
    let root = "/tmp/dawn-selfhost-lsp-def/valstd"
    let _ = io.mkdirs(root)
    def_probe_put("${root}/modules.txt", "valprobe\n")
    def_probe_put("${root}/valprobe.dawn", "pub const PROBE_MASK: Int = 255\n")
    let cstd = match load_std(root) {
      Ok(sc) -> sc
      Err(e) -> panic("probe std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(cstd)
    let text = join([
      "use std/valprobe.{PROBE_MASK}",
      "use std/valprobe as v",
      "",
      "fn mask() -> Int = PROBE_MASK + v.PROBE_MASK",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "valuser.dawn", text)
    let want = "const PROBE_MASK: Int = 255  (0xFF)"
    assert def_probe_at(st, d, text, "PROBE_MASK}", 0).hover == want
    assert def_probe_at(st, d, text, "PROBE_MASK +", 0).hover == want
    assert def_probe_at(st, d, text, "PROBE_MASK\n", 0).hover == want
  }))
}

# ---- folded values on hover (docs/lsp-hover-design.md §C5) ----

fn eval_probe_text() -> String =
  join([
    "const LIMIT: Int = 10",
    "",
    "fn fib(n: Int) -> Int = if n < 2 { n } else { fib(n - 1) + fib(n - 2) }",
    "",
    "fn down(n: Int) -> Int = if n == 0 { 0 } else { 1 + down(n - 1) }",
    "",
    "fn spin(n: Int) -> Int = {",
    "  var i = 0",
    "  var acc = 0",
    "  while i < n {",
    "    acc = acc + i",
    "    i = i + 1",
    "  }",
    "  acc",
    "}",
    "",
    "fn noisy(n: Int) -> Int !io = n + 1",
    "",
    "fn probe(k: Int) -> Int !io = {",
    "  let a = fib(15) + 1",
    "  let b = \"n=\${fib(10)} limit=\${LIMIT}\"",
    "  let c = map([1, 2, 3], x => x * x)",
    "  let d = {",
    "    let z = 3",
    "    z * z",
    "  }",
    "  let e = k + 1",
    "  let f = noisy(1) + 2",
    "  let g = map([1, 2], x => noisy(x))",
    "  let h = spin(60000) + 3",
    "  let i = down(1600) + 4",
    "  let j = down(1400) + 5",
    "  let l = [1, 2, 3]",
    "  let m = if 1 > 2 { () } else { () }",
    "  let n = if 1 > 3 { return 0 } else { 5 * 2 }",
    "  println(to_string(a))",
    "  a + j",
    "}",
    ""
  ], "\n")

## The code line of a hover's single fence: the type, and the value after
## ` = ` when the expression was folded.
fn eval_probe_at(st: LspState, d: Doc, text: String, needle: String, skip: Int) -> String !Fs !Env !io = {
  let md = hover_probe_at(st, d, text, needle, skip)
  let body = match str.strip_prefix(md, "```dawn\n") {
    Some(x) -> x
    None -> panic("hover at ${needle} is not one fence: ${md}")
  }
  match str.strip_suffix(body, "\n```") {
    Some(x) -> x
    None -> panic("hover at ${needle} is not one fence: ${md}")
  }
}

test "hover folds a closed, pure expression and shows its value after the type" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = eval_probe_text()
    let d = def_probe_doc_named(st, "evals.dawn", text)
    # a call of the module's own function, with A1's hexadecimal
    assert eval_probe_at(st, d, text, "fib(15) + 1", 8) == "Int = 611  (0x263)"
    # interpolation reading a constant: the string the program would build
    assert eval_probe_at(st, d, text, "\"n=", 0) == "String = \"n=55 limit=10\""
    # an effect-polymorphic callee, instantiated with a pure lambda
    assert eval_probe_at(st, d, text, "map([1, 2, 3]", 3) == "List[Int] = [1, 4, 9]"
    # a block binds its own `z`, so the whole block is closed ...
    assert eval_probe_at(st, d, text, "{\n    let z", 0) == "Int = 9"
    # ... but `z * z` alone names a `z` bound outside it, and the cursor's
    # innermost node is folded, never an ancestor
    assert eval_probe_at(st, d, text, "z * z", 2) == "Int"
    # just under the editor's depth: folded
    assert eval_probe_at(st, d, text, "down(1400) + 5", 11) == "Int = 1405  (0x57D)"
  }))
}

test "hover shows the type alone where it may not fold or folding fails" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = eval_probe_text()
    let d = def_probe_doc_named(st, "evals.dawn", text)
    # a free local: nothing to fold, and no line saying so
    assert eval_probe_at(st, d, text, "k + 1", 2) == "Int"
    # an effect declared on the callee, though its body does nothing: the
    # judgement reads the row, so the interpreter never runs it
    assert eval_probe_at(st, d, text, "noisy(1) + 2", 9) == "Int"
    # an effectful lambda handed to an effect-polymorphic callee
    assert eval_probe_at(st, d, text, "map([1, 2], x", 3) == "List[Int]"
    # past the fuel: a build would fold this, a hover gives up
    assert eval_probe_at(st, d, text, "spin(60000) + 3", 12) == "Int"
    # past the depth, 1,600 calls where the editor allows 1,500 on every host
    assert eval_probe_at(st, d, text, "down(1600) + 4", 11) == "Int"
    # a value that only repeats its source, and Unit, say nothing new
    assert eval_probe_at(st, d, text, "[1, 2, 3]\n", 0) == "List[Int]"
    assert eval_probe_at(st, d, text, "if 1 > 2", 0) == "Unit"
    # `return` leaves the expression: in place this `if` may return from
    # `probe`, so its other branch's 10 is not what it means
    assert eval_probe_at(st, d, text, "if 1 > 3", 0) == "Int"
    # io, and the call's Unit
    assert eval_probe_at(st, d, text, "println(", 7) == "Unit"
  }))
}

test "hover folds nothing in a module with errors" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = join([
      "fn ok() -> Int = 6 * 7",
      "",
      "fn bad() -> Int = \"no\"",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "evalbroken.dawn", text)
    assert eval_probe_at(st, d, text, "6 * 7", 2) == "Int"
  }))
}

# ---- literals on hover (docs/lsp-hover-design.md §4) ----

fn literal_probe_text() -> String =
  join([
    "const MASK: Int = 0xFF",
    "",
    "fn lits() -> (Int, Char, Char, Float, String, String) =",
    "  (0b1010 + MASK, 'é', '\\u{1F600}', 1.1, \"héllo\\n\", \"n = \${MASK}\")",
    ""
  ], "\n")

test "hover on a literal shows its type and a value line in the one fence" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = literal_probe_text()
    let d = def_probe_doc_named(st, "literals.dawn", text)
    # a 0x or 0b spelling is echoed, with its decimal
    assert def_probe_at(st, d, text, "0xFF", 2).hover == "Int\n0xFF = 255"
    assert def_probe_at(st, d, text, "0b1010", 0).hover == "Int\n0b1010 = 10"
    # an escape spelling shows the code point it stands for, and its bytes
    assert def_probe_at(st, d, text, "'\\u{1F600}'", 3).hover == "Char\n'😀'  U+1F600  UTF-8: F0 9F 98 80"
    assert def_probe_at(st, d, text, "'é'", 1).hover == "Char\n'é'  U+00E9  UTF-8: C3 A9"
    assert def_probe_at(st, d, text, "1.1", 0).hover == "Float\n1.1  (not exactly representable)"
    # a string counts code points and UTF-8 bytes of its value, escapes undone
    assert def_probe_at(st, d, text, "\"héllo", 2).hover == "String\n\"héllo\\n\"  (6 code points, 7 UTF-8 bytes)"
    # with an interpolation it is an expression: the type alone, and the
    # interpolated name still answers as itself
    assert def_probe_at(st, d, text, "\"n = ", 1).hover == "String"
    assert def_probe_at(st, d, text, "MASK}", 0).hover == "const MASK: Int = 255  (0xFF)"
  }))
}

## Where `needle` + `skip` is in the probe text.
fn probe_offset(text: String, needle: String, skip: Int) -> Int =
  match str.index_of(text, needle) {
    Some(i) -> i + skip
    None -> panic("probe text has no ${needle}")
  }

# The collection `resolutions` makes for references and semantic tokens
# (docs/lsp-references-design.md §T0) is the definition walk read another way:
# each name it reports is one definition answers for, with the same site, and
# the names T0 added -- a written type, a row's effect, an operation call --
# are among them.
test "a collection reports the names definition resolves, at the same sites" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = join([
      "effect Ask {",
      "  fn ask() -> Int",
      "}",
      "",
      "type Box = { v: Int }",
      "",
      "fn open(b: Box) -> Int !Ask = b.v + ask()",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "collect.dawn", text)
    let analysis = analysis_of(st, d).expect("the probe buffer has an analysis")
    let qc = doc_qcx(st, d, analysis).expect("the probe buffer has a QCx")
    let rs = resolutions(qc, 0, str.len(text))
    var starts: List[Int] = []
    for r in rs {
      starts = starts ++ [r.lo]
      let t = find_target(qc, r.lo).expect("definition answers at ${r.lo}")
      if (t.lo, t.hi) == (r.lo, r.hi) { assert t.def == Some(r.def) }
    }
    let ty = probe_offset(text, "Box) ->", 0)
    let row = probe_offset(text, "Ask = b", 0)
    let call = probe_offset(text, "ask()", 0)
    assert list.contains(starts, ty)
    assert list.contains(starts, row)
    assert list.contains(starts, call)
    for r in rs {
      if r.lo == ty { assert r.def == (probe_offset(text, "Box =", 0), probe_offset(text, "Box =", 3)) }
      if r.lo == call { assert r.def == (probe_offset(text, "ask() -> Int", 0), probe_offset(text, "ask() -> Int", 3)) }
    }
    # a range keeps the names that start inside it, and only those
    let one = resolutions(qc, row, row)
    assert len(one) == 1
    assert one[0].lo == row
  }))
}

# References read the same collection by declaration (docs/lsp-references-design.md
# §R1): a `let` that shadows a parameter, and a parameter named like a
# function, each have their own occurrences, and the declaration's own name
# comes only when asked for.
test "references follow the declaration a name resolves to, not its spelling" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = join([
      "fn n() -> Int = 1",
      "",
      "fn f(n: Int) -> Int = {",
      "  let m = n + 1",
      "  let n = m",
      "  n + n()",
      "}",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "refs.dawn", text)
    let analysis = analysis_of(st, d).expect("the probe buffer has an analysis")
    let qc = doc_qcx(st, d, analysis).expect("the probe buffer has a QCx")
    let param = probe_offset(text, "n: Int", 0)
    let read = probe_offset(text, "n + 1", 0)
    let inner = probe_offset(text, "n = m", 0)
    let last = probe_offset(text, "n + n()", 0)
    let call = probe_offset(text, "n()\n}", 0)
    assert map(occurrences(qc, read, true), o => o.lo) == [param, read]
    assert map(occurrences(qc, read, false), o => o.lo) == [read]
    assert map(occurrences(qc, last, true), o => o.lo) == [inner, last]
    assert map(occurrences(qc, call, true), o => o.lo) == [probe_offset(text, "n()", 0), call]
    # the declarations write, a read reads
    assert map(occurrences(qc, last, true), o => o.write) == [true, false]
  }))
}

test "on a constant's name the constant answers, on its literal the literal does" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = literal_probe_text()
    let d = def_probe_doc_named(st, "literals.dawn", text)
    let name = def_probe_at(st, d, text, "MASK: Int", 0)
    assert name.hover == "const MASK: Int = 255  (0xFF)"
    let lit = def_probe_at(st, d, text, "0xFF", 0)
    assert lit.hover == "Int\n0xFF = 255"
    # the literal's own span, not the declaration's
    let at = match str.index_of(text, "0xFF") {
      Some(i) -> i
      None -> panic("no literal")
    }
    assert (lit.lo, lit.hi) == (at, at + 4)
    assert lit.def == None
  }))
}

# ---- doc comments on hover (docs/lsp-hover-design.md §A3) ----

## The reply's markdown at `needle` + `skip`: what `textDocument/hover` sends.
fn hover_probe_at(st: LspState, d: Doc, text: String, needle: String, skip: Int) -> String !Fs !Env !io = {
  let off = match str.index_of(text, needle) {
    Some(i) -> i + skip
    None -> panic("probe text has no ${needle}")
  }
  let analysis = analysis_of(st, d).expect("the probe buffer has an analysis")
  let qc = doc_qcx(st, d, analysis).expect("the probe buffer has a QCx")
  let t = find_target(qc, off).expect("something under the cursor at ${needle}")
  let (value, _) = hover_value(st, d, analysis, qc, t)
  value
}

fn doc_probe_text() -> String =
  join([
    "## Doubles `n`.",
    "##",
    "## - twice as much",
    "fn double(n: Int) -> Int = n * 2",
    "",
    "fn plain(n: Int) -> Int = n",
    "",
    "type Shape =",
    "  ## A round one.",
    "  | Circle(r: Float)",
    "  | Square(s: Float)",
    "",
    "## The limit.",
    "const LIMIT: Int = 3",
    "",
    "fn use_all() -> Int = {",
    "  ## not a doc: a local has none",
    "  let k = double(LIMIT) + plain(1)",
    "  let c = Circle(1.0)",
    "  k + 0",
    "}",
    "",
    "type Pt = {",
    "  ## Across.",
    "  x: Int,",
    "  y: Int",
    "}",
    "",
    "trait Sized[T] {",
    "  ## How big.",
    "  fn size(t: T) -> Int",
    "}",
    "",
    "fn read_pt(p: Pt) -> Int = p.x + p.y",
    "",
    "## Two ways.",
    "type Two = Yes | No",
    ""
  ], "\n")

test "hover puts a declaration's ## doc under the fence, and nothing else changes" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(std)
    let text = doc_probe_text()
    let d = def_probe_doc_named(st, "docs.dawn", text)
    let doubled = "```dawn\nfn double(n: Int) -> Int\n```\n\n---\n\nDoubles `n`.\n\n- twice as much"
    # at the call and at the declaration, the doc as written
    assert hover_probe_at(st, d, text, "double(LIMIT)", 1) == doubled
    assert hover_probe_at(st, d, text, "double(n", 1) == doubled
    assert hover_probe_at(st, d, text, "LIMIT) +", 1) ==
      "```dawn\nconst LIMIT: Int = 3\n```\n\n---\n\nThe limit."
    # a constructor reads the ## line above its own `|`
    assert hover_probe_at(st, d, text, "Circle(1.0)", 1) ==
      "```dawn\nCircle(r: Float): Shape\n```\n\n---\n\nA round one."
    # no doc: the single fence, byte for byte the reply before docs existed
    let plain = def_probe_at(st, d, text, "plain(1)", 1)
    assert hover_probe_at(st, d, text, "plain(1)", 1) == "```dawn\n" ++ plain.hover ++ "\n```"
    assert hover_probe_at(st, d, text, "Square", 1) == "```dawn\nSquare(s: Float): Shape\n```"
    # a local has no declaration doc, whatever comment sits above it
    let local = hover_probe_at(st, d, text, "k + 0", 0)
    assert local == "```dawn\n" ++ def_probe_at(st, d, text, "k + 0", 0).hover ++ "\n```"
    # and a literal (A2) carries none either
    assert not str.contains(hover_probe_at(st, d, text, "1.0", 0), "---")
    # a record field reads the ## line above its own, at the declaration and
    # at a use; the field under it has a code line above and no doc
    let across = "```dawn\nx: Int\n```\n\n---\n\nAcross."
    assert hover_probe_at(st, d, text, "x: Int,", 0) == across
    assert hover_probe_at(st, d, text, "p.x", 2) == across
    assert hover_probe_at(st, d, text, "p.y", 2) == "```dawn\ny: Int\n```"
    # a constructor on its type's line has no doc of its own (`dawn doc`
    # writes null); hover falls back to the type's block
    assert hover_probe_at(st, d, text, "Yes |", 0) == "```dawn\nYes: Two\n```\n\n---\n\nTwo ways."
    # a trait method, as `dawn doc` publishes it
    assert str.ends_with(hover_probe_at(st, d, text, "size(t", 0), "\n```\n\n---\n\nHow big.")
  }))
}

test "hover reads a std declaration's doc from std's text, file or embedded" {
  io.with_fs_real(() => no_host(() => {
    let root = "/tmp/dawn-selfhost-lsp-def/docstd"
    let _ = io.mkdirs(root)
    def_probe_put("${root}/modules.txt", "docprobe\n")
    def_probe_put("${root}/docprobe.dawn", join([
      "## Probes `n`.",
      "pub fn probe(n: Int) -> Int = n",
      "",
      "## How far a probe reaches.",
      "pub const REACH: Int = 9",
      "",
      "pub fn bare(n: Int) -> Int = n",
      ""
    ], "\n"))
    let pstd = match load_std(root) {
      Ok(sc) -> sc
      Err(e) -> panic("probe std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(pstd)
    let text = join([
      "use std/docprobe",
      "use std/docprobe.{REACH}",
      "",
      "fn f() -> Int = docprobe.probe(REACH) + docprobe.bare(1)",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "docuser.dawn", text)
    assert hover_probe_at(st, d, text, "probe(REACH", 1) ==
      "```dawn\nfn probe(n: Int) -> Int\n```\n\n---\n\nProbes `n`."
    let reach = "```dawn\nconst REACH: Int = 9\n```\n\n---\n\nHow far a probe reaches."
    assert hover_probe_at(st, d, text, "REACH}", 0) == reach
    assert hover_probe_at(st, d, text, "REACH) +", 0) == reach
    assert hover_probe_at(st, d, text, "bare(1)", 1) == "```dawn\nfn bare(n: Int) -> Int\n```"

    # The embedded copy has no file, so `reverse` offers no definition (the
    # test above this section); its doc is in `StdCtx.srcs` all the same.
    let emb = match load_std("/tmp/dawn-selfhost-lsp-def/no-std-here") {
      Ok(sc) -> sc
      Err(e) -> panic("embedded std: ${std_load_error_text(e)}")
    }
    let est = def_probe_state(emb)
    let etext = def_probe_text()
    let ed = def_probe_doc(est, etext)
    assert def_probe_at(est, ed, etext, "list.reverse", 5).def == None
    let rev = hover_probe_at(est, ed, etext, "list.reverse", 5)
    assert str.ends_with(rev, "\n```\n\n---\n\nA reversed copy; the input is not changed.")
  }))
}

test "hover turns a doc's [`name`] links into links to the declarations" {
  io.with_fs_real(() => no_host(() => {
    let root = "/tmp/dawn-selfhost-lsp-def/doclinks"
    let _ = io.mkdirs(root)
    def_probe_put("${root}/modules.txt", "linkprobe\n")
    def_probe_put("${root}/linkprobe.dawn", join([
      "## Probes `n`; see [`REACH`].",
      "pub fn probe(n: Int) -> Int = n",
      "",
      "## How far a probe reaches.",
      "pub const REACH: Int = 9",
      ""
    ], "\n"))
    let pstd = match load_std(root) {
      Ok(sc) -> sc
      Err(e) -> panic("probe std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(pstd)
    let text = join([
      "use std/linkprobe",
      "",
      "## Twice [`plain`], unlike [`linkprobe.probe`]; [`Pt.x`], [`Option.Some`],",
      "## and [`nowhere`] is not a link.",
      "fn double(n: Int) -> Int = plain(n) * 2",
      "",
      "fn plain(n: Int) -> Int = n",
      "",
      "type Pt = { x: Int }",
      "",
      "fn f() -> Int = double(linkprobe.probe(1))",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "doclinks.dawn", text)
    let file = path_to_uri(canon_identity("${root}/linkprobe.dawn"))
    # this module's declarations point into the buffer, std's into its file;
    # a prelude name and a broken link stay as written
    assert hover_probe_at(st, d, text, "double(linkprobe", 1) ==
      "```dawn\nfn double(n: Int) -> Int\n```\n\n---\n\n" ++
      "Twice [`plain`](${d.uri}#L7,4), unlike [`linkprobe.probe`](${file}#L2,8); " ++
      "[`Pt.x`](${d.uri}#L9,13), [`Option.Some`],\nand [`nowhere`] is not a link."
    # a std doc's links resolve in std's module, not in the document's
    assert hover_probe_at(st, d, text, "probe(1)", 1) ==
      "```dawn\nfn probe(n: Int) -> Int\n```\n\n---\n\nProbes `n`; see [`REACH`](${file}#L5,11)."
  }))
}

test "the comment table is kept per text, and a changed text is lexed again" {
  io.with_fs_real(() => no_host(() => {
    let st0 = def_probe_state(match load_std("/tmp/dawn-selfhost-lsp-def/no-std-here") {
      Ok(sc) -> sc
      Err(e) -> panic("embedded std: ${std_load_error_text(e)}")
    })
    let one = "## One.\nfn f() -> Int = 1\n"
    let (a, st1) = doc_src_memo(st0, "doc x", one)
    assert len(map.keys(st1.doc_memo)) == 1
    # the same text answers from the table it was lexed into
    let (b, st2) = doc_src_memo(st1, "doc x", one)
    assert b == a && len(map.keys(st2.doc_memo)) == 1
    # a different text under the same key replaces it, and says the new thing
    let two = "## Two.\nfn f() -> Int = 1\n"
    let (c, st3) = doc_src_memo(st2, "doc x", two)
    assert doc_in(c, 8) == Some("Two.")
    assert doc_in(map.get(st3.doc_memo, "doc x").expect("kept").src, 8) == Some("Two.")
    # past the bound the table starts over instead of growing
    var st = st3
    var i = 0
    while i < DOC_MEMO_FILES {
      let (_, next) = doc_src_memo(st, "doc ${i}", one)
      st = next
      i = i + 1
    }
    assert len(map.keys(st.doc_memo)) <= DOC_MEMO_FILES
  }))
}

# ---- docs in completion, signature help and `use` lines (§D7) ----

## A std of one module, `std/docprobe`, with a module doc and declarations
## with and without docs of their own.
fn d7_probe_std() -> StdCtx !Fs !Env !io = {
  let root = "/tmp/dawn-selfhost-lsp-def/d7std"
  let _ = io.mkdirs(root)
  def_probe_put("${root}/modules.txt", "docprobe\n")
  def_probe_put("${root}/docprobe.dawn", join([
    "## Probes things.",
    "## See [`probe`].",
    "",
    "## Probes `n`.",
    "pub fn probe(n: Int) -> Int = n",
    "",
    "## How far a probe reaches.",
    "pub const REACH: Int = 9",
    "",
    "pub fn bare(n: Int) -> Int = n",
    "",
    "## A tool.",
    "pub trait Tool[T] {",
    "  fn wield(t: T) -> Int",
    "}",
    "",
    "## Asks.",
    "pub effect Ask {",
    "  fn ask() -> Int",
    "}",
    ""
  ], "\n"))
  match load_std(root) {
    Ok(sc) -> sc
    Err(e) -> panic("probe std: ${std_load_error_text(e)}")
  }
}

fn d7_probe_text() -> String =
  join([
    "use std/docprobe",
    "use std/docprobe.{probe, REACH, Tool, Ask}",
    "",
    "## Local and documented.",
    "fn local_fn(k: Int) -> Int = k",
    "",
    "fn plain_fn(k: Int) -> Int = k",
    "",
    "fn f() -> Int = probe(local_fn(1)) + plain_fn(2) + docprobe.bare(REACH)",
    ""
  ], "\n")

## The position of `needle` + `skip` in `d`, as a request's params carry it.
fn d7_params(d: Doc, needle: String, skip: Int) -> Json = {
  let off = match str.index_of(d.text, needle) {
    Some(i) -> i + skip
    None -> panic("probe text has no ${needle}")
  }
  let (line, ch) = lsp_position(d.view, d.ls, off)
  jobj([("textDocument", jobj([("uri", JStr(d.uri))])), ("position", jpos(line, ch))])
}

## The completion item labelled `label` at `needle` + `skip`.
fn d7_item(st: LspState, d: Doc, needle: String, skip: Int, label: String) -> Json !Fs !Proc !Env !io = {
  let items = match handle_completion(st, d7_params(d, needle, skip)) {
    JArr(xs) -> xs
    other -> panic("completion replied ${render(other)}")
  }
  match list.find(items, it => ostr(it, "label") == label) {
    Some(it) -> it
    None -> panic("no completion item ${label} at ${needle}")
  }
}

## The item labelled `label` in a completion reply of either shape.
fn d7_item_in(reply: Json, label: String) -> Json = {
  let items = match reply {
    JArr(xs) -> xs
    other -> match get_or_null(other, "items") {
      JArr(xs) -> xs
      _ -> panic("completion replied ${render(other)}")
    }
  }
  list.find(items, it => ostr(it, "label") == label).expect("no completion item ${label}")
}

## What `completionItem/resolve` puts in `documentation`, or "-" for none.
fn d7_resolved(st: LspState, item: Json) -> String !Fs !Proc !Env !io = {
  let (reply, _) = handle_completion_resolve(st, item)
  match oget(reply, "documentation") {
    Some(doc) -> {
      if ostr(doc, "kind") != "markdown" { panic("documentation is not markdown") }
      ostr(doc, "value")
    }
    None -> "-"
  }
}

test "completion resolve adds the doc hover shows, and only where there is one" {
  io.with_fs_real(() => no_host(() => io.with_proc_real(() => {
    let st0 = def_probe_state(d7_probe_std())
    let d = def_probe_doc_named(st0, "d7user.dawn", d7_probe_text())
    let st = LspState { ..st0, docs: map.insert(st0.docs, d.uri, d) }
    let at = "probe(local"
    # the list itself carries no doc: that is resolve's to fetch
    let local = d7_item(st, d, at, 2, "local_fn")
    assert oget(local, "documentation") == None
    assert ostr(get_or_null(local, "data"), "uri") == d.uri
    assert d7_resolved(st, local) == "Local and documented."
    # the resolved item is the one sent, plus its doc
    let (back, _) = handle_completion_resolve(st, local)
    assert ostr(back, "label") == "local_fn" && oint(back, "kind") == 3
    assert ostr(back, "detail") == ostr(local, "detail")
    # a std function imported by name: std's doc, its link resolved in std
    assert d7_resolved(st, d7_item(st, d, at, 2, "probe")) == "Probes `n`."
    # no doc, no field
    assert d7_resolved(st, d7_item(st, d, at, 2, "plain_fn")) == "-"
    # a keyword has nothing to resolve, and no data to resolve it with
    let kw = d7_item(st, d, at, 2, "let")
    assert oget(kw, "data") == None
    assert d7_resolved(st, kw) == "-"
    # an item for a document the server does not have resolves to itself
    let gone = jobj([("label", JStr("local_fn")), ("kind", JInt(3)),
      ("data", jobj([("uri", JStr("file:///nowhere.dawn"))]))])
    assert d7_resolved(st, gone) == "-"
  })))
}

test "a client that applies itemDefaults.data is told the document once" {
  io.with_fs_real(() => no_host(() => io.with_proc_real(() => {
    let st0 = def_probe_state(d7_probe_std())
    let d = def_probe_doc_named(st0, "d7defaults.dawn", d7_probe_text())
    let caps = jobj([("capabilities", jobj([("textDocument", jobj([("completion", jobj([
      ("completionList", jobj([("itemDefaults", JArr([JStr("commitCharacters"), JStr("data")]))]))
    ]))]))]))])
    assert client_defaults_item_data(caps)
    assert not client_defaults_item_data(jobj([]))
    let st = LspState { ..st0, docs: map.insert(st0.docs, d.uri, d), default_item_data: true }
    let reply = handle_completion(st, d7_params(d, "probe(local", 2))
    assert ostr(get_or_null(get_or_null(reply, "itemDefaults"), "data"), "uri") == d.uri
    let items = match get_or_null(reply, "items") {
      JArr(xs) -> xs
      other -> panic("completion replied ${render(other)}")
    }
    let local = list.find(items, it => ostr(it, "label") == "local_fn").expect("local_fn offered")
    # no item names the document itself; the client fills it in from the
    # default. Only an item offered out of a module (`docprobe.bare`) carries
    # data of its own, the module it came from.
    assert list.all(items, it => oget(it, "data") == None || ostr(get_or_null(it, "data"), "module") != "")
    assert list.any(items, it => oget(it, "data") == None)
    let filled = with_field(local, "data", jobj([("uri", JStr(d.uri))]))
    assert d7_resolved(st, filled) == "Local and documented."
    # a keyword comes back with the default data as well, and resolves to itself
    let kw = jobj([("label", JStr("let")), ("kind", JInt(14)), ("data", jobj([("uri", JStr(d.uri))]))])
    let (same, _) = handle_completion_resolve(st, kw)
    assert same == kw
    # an item a `use` line offered keeps its own data, module and all
    let m = d7_item_in(handle_completion(st, d7_params(d, "docprobe\n", 3)), "docprobe")
    assert ostr(get_or_null(m, "data"), "module") == "std/docprobe"
  })))
}

test "dbg is a builtin the editor offers and explains, and its argument hovers as written" {
  io.with_fs_real(() => no_host(() => io.with_proc_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st0 = def_probe_state(std)
    let text = "pub fn main() -> Unit !io = println(to_string(dbg(40 + 2)))\n"
    let d = def_probe_doc_named(st0, "dbgprobe.dawn", text)
    let st = LspState { ..st0, docs: map.insert(st0.docs, d.uri, d) }
    assert def_probe_at(st, d, text, "dbg(", 0).hover == "fn dbg[T: Show](x: T) -> T"
    # the head the declaration's exit appends is taken back off before the
    # written arguments are paired with the typed ones (`split_site`)
    assert def_probe_at(st, d, text, "40", 0).hover == "Int\n40  (0x28)"
    let item = d7_item(st, d, "dbg(", 2, "dbg")
    assert ostr(item, "detail") == "fn dbg[T: Show](x: T) -> T"
  })))
}

# ---- std names the buffer has not imported (docs/lsp-auto-import-design.md) ----

## The items of a completion reply of either shape.
fn ai_items(reply: Json) -> List[Json] =
  match reply {
    JArr(xs) -> xs
    other -> match get_or_null(other, "items") {
      JArr(xs) -> xs
      _ -> panic("completion replied ${render(other)}")
    }
  }

## The `use` text an item inserts and the position it inserts it at, or "-".
fn ai_edit(item: Json) -> String =
  match oget(item, "additionalTextEdits") {
    Some(JArr([e])) -> {
      let start = get_or_null(get_or_null(e, "range"), "start")
      "${oint(start, "line")}:${oint(start, "character")} ${ostr(e, "newText")}"
    }
    _ -> "-"
  }

fn ai_labels(reply: Json) -> List[String] = list.map(ai_items(reply), it => ostr(it, "label"))

test "a std name the buffer has not imported is offered with the use it needs" {
  io.with_fs_real(() => no_host(() => io.with_proc_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st0 = def_probe_state(std)
    let doc = (name: String, text: String) => {
      let d = def_probe_doc_named(st0, name, text)
      (LspState { ..st0, docs: map.insert(st0.docs, d.uri, d) }, d)
    }
    # bare word: `tri` offers `str.trim`, with `use std/str` above the code
    let (st, d) = doc("aibare.dawn", "# Head.\n\npub fn main() -> Unit !io = {\n  let a = tri\n}\n")
    let bare = handle_completion(st, d7_params(d, "tri\n", 3))
    let trim = d7_item_in(bare, "str.trim")
    assert ai_edit(trim) == "2:0 use std/str\n\n"
    assert ostr(trim, "sortText") == "4str.trim"
    assert ostr(get_or_null(trim, "labelDetails"), "description") == "use std/str"
    assert ostr(trim, "detail") == "fn trim(s: String) -> String"
    # only names whose member or alias starts with the word's first letter
    assert not list.contains(ai_labels(bare), "str.split")
    assert list.contains(ai_labels(bare), "list.take")
    # the item resolves to std's doc, under its qualified label
    assert d7_resolved(st, trim) == "`s` without leading or trailing whitespace."
    # imported: the same name, no edit, ranked with the prelude
    let (st2, d2) = doc("aiused.dawn", "use std/list\nuse std/str\n\npub fn main() -> Unit !io = {\n  let a = tri\n}\n")
    let used = d7_item_in(handle_completion(st2, d7_params(d2, "tri\n", 3)), "str.trim")
    assert ai_edit(used) == "-" && ostr(used, "sortText") == "2str.trim"
    # an unimported module goes in sorted place among sorted std imports
    let (st3, d3) = doc("aisorted.dawn", "use std/list\nuse std/str\n\npub fn main() -> Unit !io = {\n  let a = ma\n}\n")
    assert ai_edit(d7_item_in(handle_completion(st3, d7_params(d3, "ma\n", 2)), "map.get")) == "1:0 use std/map\n"
    # no word yet: no module names, and the list says it is not whole
    let empty = handle_completion(st, d7_params(d, "tri\n", 0))
    assert get_or_null(empty, "isIncomplete") == JBool(true)
    assert not list.any(ai_labels(empty), l => str.contains(l, "."))
    assert get_or_null(bare, "isIncomplete") == JNull
  })))
}

test "after alias dot, the module's members, with the use when it is missing" {
  io.with_fs_real(() => no_host(() => io.with_proc_real(() => {
    let std = match load_std("std") {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let st0 = def_probe_state(std)
    let doc = (name: String, text: String) => {
      let d = def_probe_doc_named(st0, name, text)
      (LspState { ..st0, docs: map.insert(st0.docs, d.uri, d) }, d)
    }
    let (st, d) = doc("aidot.dawn", "pub fn main() -> Unit !io = {\n  let a = str.\n}\n")
    let trim = d7_item_in(handle_completion(st, d7_params(d, "str.", 4)), "trim")
    assert ai_edit(trim) == "0:0 use std/str\n\n"
    assert ostr(get_or_null(trim, "data"), "module") == "std/str"
    assert d7_resolved(st, trim) == "`s` without leading or trailing whitespace."
    # imported, renamed: the alias it is imported as, and no edit
    let (st2, d2) = doc("aidotas.dawn", "use std/str as s\n\npub fn main() -> Unit !io = {\n  let a = s.\n}\n")
    assert ai_edit(d7_item_in(handle_completion(st2, d7_params(d2, "s.\n", 2)), "trim")) == "-"
    # renamed, `str.` is no longer the module: adding a second use would not compile
    let (st3, d3) = doc("aidotas2.dawn", "use std/str as s\n\npub fn main() -> Unit !io = {\n  let a = str.\n}\n")
    assert ai_items(handle_completion(st3, d7_params(d3, "str.\n", 4))) == []
    # a local of that name: its fields, not the module's members
    let (st4, d4) = doc("aidotlocal.dawn", "pub fn f(str: String) -> Int = {\n  str.\n  0\n}\n")
    assert ai_items(handle_completion(st4, d7_params(d4, "str.\n", 4))) == []
    # even when the module is imported under that alias: the local shadows it
    let (st6, d6) = doc("aidotshadow.dawn", "use std/str\n\npub fn f(str: String) -> Int = {\n  str.\n  0\n}\n")
    assert ai_items(handle_completion(st6, d7_params(d6, "str.\n", 4))) == []
    # not a module std has
    let (st5, d5) = doc("aidotnone.dawn", "pub fn main() -> Unit !io = {\n  let a = nosuch.\n}\n")
    assert ai_items(handle_completion(st5, d7_params(d5, "nosuch.", 7))) == []
  })))
}

test "completion resolve on a use line: the module's doc, and its members'" {
  io.with_fs_real(() => no_host(() => io.with_proc_real(() => {
    let st0 = def_probe_state(d7_probe_std())
    let d = def_probe_doc_named(st0, "d7use.dawn", d7_probe_text())
    let st = LspState { ..st0, docs: map.insert(st0.docs, d.uri, d) }
    let file = path_to_uri(canon_identity("/tmp/dawn-selfhost-lsp-def/d7std/docprobe.dawn"))
    # a module path, offered one segment at a time, carries the module it names
    let m = d7_item(st, d, "docprobe\n", 3, "docprobe")
    assert oint(m, "kind") == 9
    assert ostr(get_or_null(m, "data"), "module") == "std/docprobe"
    assert d7_resolved(st, m) == "Probes things.\nSee [`probe`](${file}#L5,8)."
    # the names inside `.{ }`, from the module that declares them
    let reach = d7_item(st, d, "REACH, Tool", 1, "bare")
    assert ostr(get_or_null(reach, "data"), "module") == "std/docprobe"
    assert d7_resolved(st, reach) == "-"
    let item = (label: String, kind: Int) => jobj([("label", JStr(label)), ("kind", JInt(kind)),
      ("data", jobj([("uri", JStr(d.uri)), ("module", JStr("std/docprobe"))]))])
    assert d7_resolved(st, item("REACH", 21)) == "How far a probe reaches."
    assert d7_resolved(st, item("Tool", 8)) == "A tool."
    assert d7_resolved(st, item("Ask", 23)) == "Asks."
    assert d7_resolved(st, item("nothing", 3)) == "-"
  })))
}

test "completion resolve reads a module the use line has not loaded from its file" {
  io.with_fs_real(() => no_host(() => io.with_proc_real(() => {
    let dir = "/tmp/dawn-selfhost-lsp-def/d7sib"
    let _ = io.mkdirs(dir)
    def_probe_put("${dir}/sib.dawn", join([
      "## A sibling.",
      "",
      "## Helps.",
      "pub fn help() -> Int = 1",
      ""
    ], "\n"))
    let st0 = def_probe_state(d7_probe_std())
    let d = def_probe_doc_named(st0, "d7sib/user.dawn", "fn main() -> Int = 0\n")
    let st = LspState { ..st0, docs: map.insert(st0.docs, d.uri, d) }
    let item = (label: String, kind: Int) => jobj([("label", JStr(label)), ("kind", JInt(kind)),
      ("data", jobj([("uri", JStr(d.uri)), ("module", JStr("sib"))]))])
    assert d7_resolved(st, item("sib", 9)) == "A sibling."
    assert d7_resolved(st, item("help", 3)) == "Helps."
    assert d7_resolved(st, item("main", 3)) == "-"
  })))
}

test "signature help carries the function's doc, whole, and nothing without one" {
  io.with_fs_real(() => no_host(() => io.with_proc_real(() => {
    let st0 = def_probe_state(d7_probe_std())
    let d = def_probe_doc_named(st0, "d7sig.dawn", d7_probe_text())
    let st = LspState { ..st0, docs: map.insert(st0.docs, d.uri, d) }
    let sig_doc = (needle: String, skip: Int) => {
      let (reply, _) = handle_signature_help(st, d7_params(d, needle, skip))
      let sigs = match get_or_null(reply, "signatures") {
        JArr(xs) -> xs
        other -> panic("signatureHelp replied ${render(other)}")
      }
      match oget(sigs[0], "documentation") {
        Some(doc) -> ostr(doc, "value")
        None -> "-"
      }
    }
    assert sig_doc("probe(local", 6) == "Probes `n`."
    assert sig_doc("local_fn(1)", 9) == "Local and documented."
    assert sig_doc("plain_fn(2)", 9) == "-"
    assert sig_doc("bare(REACH", 5) == "-"
  })))
}

test "hover on a use line: the module's doc on its path, a name's on the name" {
  io.with_fs_real(() => no_host(() => io.with_proc_real(() => {
    let st = def_probe_state(d7_probe_std())
    let text = d7_probe_text()
    let d = def_probe_doc_named(st, "d7hover.dawn", text)
    let file = path_to_uri(canon_identity("/tmp/dawn-selfhost-lsp-def/d7std/docprobe.dawn"))
    assert hover_probe_at(st, d, text, "docprobe\n", 0) ==
      "```dawn\nuse std/docprobe\n```\n\n---\n\nProbes things.\nSee [`probe`](${file}#L5,8)."
    assert hover_probe_at(st, d, text, "probe, REACH", 0) ==
      "```dawn\nfn probe(n: Int) -> Int\n```\n\n---\n\nProbes `n`."
    assert hover_probe_at(st, d, text, "REACH, Tool", 0) ==
      "```dawn\nconst REACH: Int = 9\n```\n\n---\n\nHow far a probe reaches."
    assert hover_probe_at(st, d, text, "Tool,", 0) ==
      "```dawn\ntrait Tool[T]\n```\n\n---\n\nA tool."
    assert hover_probe_at(st, d, text, "Ask}", 0) == "```dawn\neffect Ask\n```\n\n---\n\nAsks."
  })))
}

# ---- inlay hints (docs/lsp-hover-design.md §A4) ----

fn inlay_probe_text() -> String =
  join([
    "use std/io",
    "use std/io.{Fs}",
    "effect Ask {",
    "  fn ask() -> Int",
    "}",
    "",
    "fn pad(s: String, width: Int, fill: String) -> String = s ++ fill",
    "",
    "fn twice[!e](f: fn() -> Int !e) -> Int !e = f() + f()",
    "",
    "fn ask_twice() -> Int !Ask = ask() + ask()",
    "",
    "fn load(p: String) -> String !Fs !Ask = {",
    "  let text = io.read_file(p)",
    "  let (a, b) = (1, \"x\")",
    "  let n: Int = a",
    "  let xs = map([1, 2], x => x + n)",
    "  let ys = map(xs, (y: Int) => y)",
    "  let width = len(ys)",
    "  let long = [[(1, \"a\", 1.5, true)]]",
    "  var k = ask_twice()",
    "  let cut = pad(p, width, b)",
    "  let got = twice(() => n)",
    "  let peek = () => io.exists(p)",
    "  let seen = peek()",
    "  match text {",
    "    Ok(t) -> t ++ cut",
    "    Err(_) -> \"\${got}\${len(long)}\${seen}\"",
    "  }",
    "}",
    ""
  ], "\n")

## The lines of `text` that hold a hint, each with its hints written into it
## where an editor would draw them (`«…»`, padding as a blank inside), from
## the reply of a `textDocument/inlayHint` over `l0:c0..l1:c1`. Positions are
## UTF-16 columns, which the ASCII probe texts make code points.
fn inlay_probe(st: LspState, d: Doc, l0: Int, c0: Int, l1: Int, c1: Int) -> List[String] !io = {
  let params = jobj([
    ("textDocument", jobj([("uri", JStr(d.uri))])),
    ("range", jobj([("start", jpos(l0, c0)), ("end", jpos(l1, c1))]))
  ])
  let st1 = LspState { ..st, docs: map.insert(st.docs, d.uri, d) }
  let hints = match handle_inlay_hint(st1, params) {
    JArr(xs) -> xs
    other -> panic("inlayHint replied ${render(other)}")
  }
  let lines = str.split(d.text, "\n")
  var by_line: Map[Int, List[(Int, String)]] = map.empty()
  for h in hints {
    let pos = get_or_null(h, "position")
    let line = oint(pos, "line")
    let left = if get_or_null(h, "paddingLeft") == JBool(true) { " " } else { "" }
    let right = if get_or_null(h, "paddingRight") == JBool(true) { " " } else { "" }
    let shown = "«" ++ left ++ ostr(h, "label") ++ right ++ "»"
    let prev = match map.get(by_line, line) {
      Some(xs) -> xs
      None -> []
    }
    by_line = map.insert(by_line, line, prev ++ [(oint(pos, "character"), shown)])
  }
  var out: List[String] = []
  for line in sort(map.keys(by_line)) {
    let src = lines[line]
    var at = 0
    var row = ""
    for pr in map.get(by_line, line).expect("hints of the line") {
      let (ch, shown) = pr
      row = row ++ str.slice(src, at, ch) ++ shown
      at = ch
    }
    out = out ++ [str.trim(row ++ str.slice(src, at, str.len(src)))]
  }
  out
}

fn inlay_probe_doc(st: LspState) -> Doc !Fs !Env !io = def_probe_doc_named(st, "inlay.dawn", inlay_probe_text())

fn std_for_probe() -> StdCtx !Fs !Env !io =
  match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: ${std_load_error_text(e)}")
  }

test "inlay hints: inferred let types, one per destructured name, none where written" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st = def_probe_state(std_for_probe())
    let d = inlay_probe_doc(st)
    let got = inlay_probe(st, d, 13, 0, 16, 99)
    # `text` is a Result[String, ForeignError], 29 code points: past the
    # bound, so not shown; `n` is annotated, so not shown
    assert got == [
      "let text = io.read_file(p)« !Fs»",
      "let (a«: Int», b«: String») = (1, \"x\")",
      "let xs«: List[Int]» = map([1, 2], x«: Int» => x + n)"
    ]
  }))
}

test "inlay hints: lambda parameters without a written type, and long types left out" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st = def_probe_state(std_for_probe())
    let d = inlay_probe_doc(st)
    let got = inlay_probe(st, d, 17, 0, 19, 99)
    # `y` is annotated; `long` is List[List[(Int, String, Float, Bool)]]
    assert got == [
      "let ys«: List[Int]» = map(xs, (y: Int) => y)",
      "let width«: Int» = len(ys)"
    ]
  }))
}

test "inlay hints: a call's named effects, none for pure or effect-polymorphic calls" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st = def_probe_state(std_for_probe())
    let d = inlay_probe_doc(st)
    let got = inlay_probe(st, d, 0, 0, 30, 0)
    # an operation call, a call of a function with a label, a local function
    # value whose type carries one; `pad` is pure, `twice` is `!e`
    assert list.contains(got, "fn ask_twice() -> Int !Ask = ask()« !Ask» + ask()« !Ask»")
    assert list.contains(got, "var k«: Int» = ask_twice()« !Ask»")
    assert list.contains(got, "let cut«: String» = pad(p, width, b)")
    assert list.contains(got, "let got«: Int» = twice(() => n)")
    assert list.contains(got, "let peek«: fn() -> Bool !Fs» = () => io.exists(p)« !Fs»")
    assert list.contains(got, "let seen«: Bool» = peek()« !Fs»")
    # a match arm's binder is not a let
    assert not list.any(got, l => str.contains(l, "Ok(t«"))
  }))
}

test "inlay hints: only inside the requested range, by position, kind by LSP's numbers" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st = def_probe_state(std_for_probe())
    let d = inlay_probe_doc(st)
    # one line, and only its first half: the `x` past column 22 is out
    assert inlay_probe(st, d, 16, 0, 16, 22) == ["let xs«: List[Int]» = map([1, 2], x => x + n)"]
    # an empty range at a hint's own position still holds it (both ends count)
    assert inlay_probe(st, d, 16, 8, 16, 8) == ["let xs«: List[Int]» = map([1, 2], x => x + n)"]
    assert inlay_probe(st, d, 4, 0, 5, 0) == []
    let params = jobj([
      ("textDocument", jobj([("uri", JStr(d.uri))])),
      ("range", jobj([("start", jpos(13, 0)), ("end", jpos(13, 99))]))
    ])
    match handle_inlay_hint(LspState { ..st, docs: map.insert(st.docs, d.uri, d) }, params) {
      JArr(hs) -> {
        assert len(hs) == 1
        assert get_or_null(hs[0], "kind") == JInt(1)
        assert get_or_null(hs[0], "paddingLeft") == JBool(true)
        assert get_or_null(hs[0], "paddingRight") == JNull
      }
      _ -> { assert false }
    }
  }))
}

test "inlay hints: parameter names are off unless asked for, and hide what the call says" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st0 = def_probe_state(std_for_probe())
    let d = inlay_probe_doc(st0)
    assert inlay_probe(st0, d, 21, 0, 21, 99) == ["let cut«: String» = pad(p, width, b)"]
    let st = LspState {
      ..st0,
      inlay: inlay_opts_of(jobj([("initializationOptions", jobj([("inlayHints", jobj([
        ("parameterNames", JBool(true)),
        ("letTypes", JBool(false)),
        # not a boolean: the default stands
        ("callEffects", JStr("no"))
      ]))]))]))
    }
    # `width` is passed to `width`, so only `s` and `fill` are named
    assert inlay_probe(st, d, 21, 0, 21, 99) == ["let cut = pad(«s: »p, width, «fill: »b)"]
    # one argument: no names; the effect hint is still on
    assert inlay_probe(st, d, 13, 0, 13, 99) == ["let text = io.read_file(p)« !Fs»"]
    # `letTypes: false` turned the let hints off and left the lambda's; the
    # lambda is an argument like any other
    assert inlay_probe(st, d, 16, 0, 16, 99) == ["let xs = map(«xs: »[1, 2], «f: »x«: Int» => x + n)"]
  }))
}

test "inlay hints: a trailing block puts the effect after the call's parentheses" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st = def_probe_state(std_for_probe())
    let text = join([
      "use std/io",
      "use std/io.{Fs}",
      "fn each(xs: List[Int], f: fn(Int) -> Unit) -> Unit !Fs = {",
      "  let _ = io.exists(\"x\")",
      "  for x in xs { f(x) }",
      "}",
      "",
      "fn run() -> Unit !Fs = {",
      "  each([1]) { n =>",
      "    let m = n + 1",
      "    let _ = m",
      "  }",
      "}",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "trailing.dawn", text)
    assert inlay_probe(st, d, 8, 0, 10, 99) == [
      "each([1])« !Fs» { n«: Int» =>",
      "let m«: Int» = n + 1"
    ]
  }))
}

# ---- left-out default arguments (docs/lsp-hover-design.md §B1) ----

fn defaults_probe_text() -> String =
  join([
    "use std/str",
    "use std/cursor",
    "",
    "fn pad(s: String, width: Int, fill: String = \" \") -> String = s ++ fill",
    "fn zero(n: Int = 0, m: Int = 1) -> Int = n + m",
    "fn mid(s: String, gap: Int = 1, last: Int = 0) -> Int = gap + last",
    "fn each(xs: List[Int], step: Int = 1, f: fn(Int) -> Unit) -> Unit = { for x in xs { f(x + step) } }",
    "fn wordy(n: Int, why: String = \"a default far wider than any hint shows\") -> Int = n",
    "",
    "fn run(s: String) -> Int = {",
    "  let a = pad(s, 4)",
    "  let b = zero()",
    "  let c = pad(width: 4, s: \"x\")",
    "  let d = mid(s, last: 2)",
    "  each([1]) { n =>",
    "    let _ = n",
    "  }",
    "  let e = s.pad(4)",
    "  let f = str.pad_start(s, 4)",
    "  let g = cursor.find(s, \"a\")",
    "  let h = \"x\" |> pad(2)",
    "  let i = 5 |> zero",
    "  let j = wordy(1)",
    "  let k = pad(s, 4, \"-\")",
    "  let l = zero(1, m: 2)",
    "  str.len(a ++ c ++ e ++ f ++ h) + b + d + i + j + str.len(k) + l + (if g == None { 0 } else { 1 })",
    "}",
    ""
  ], "\n")

## The probe's hinted lines with only the left-out-default hints kept, so the
## let types around them do not crowd the assertions.
fn defaults_probe(st: LspState, d: Doc) -> List[String] !io = {
  let st1 = LspState {
    ..st,
    inlay: InlayOpts { ..st.inlay, let_types: false, lambda_param_types: false, call_effects: false }
  }
  inlay_probe(st1, d, 0, 0, 30, 0)
}

test "inlay hints: a left-out default shows its written text, after the last argument" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st = def_probe_state(std_for_probe())
    let d = def_probe_doc_named(st, "defaults.dawn", defaults_probe_text())
    let got = defaults_probe(st, d)
    # by position, and with nothing written: the hint opens the parentheses
    assert list.contains(got, "let a = pad(s, 4«, fill: \" \"»)")
    assert list.contains(got, "let b = zero(«n: 0, m: 1»)")
    # named out of order, and a default left out between written ones
    assert list.contains(got, "let c = pad(width: 4, s: \"x\"«, fill: \" \"»)")
    assert list.contains(got, "let d = mid(s, last: 2«, gap: 1»)")
    # a trailing block fills the last parameter; the hint stays in the parentheses
    assert list.contains(got, "each([1]«, step: 1») { n =>")
    # UFCS: the receiver fills the first parameter
    assert list.contains(got, "let e = s.pad(4«, fill: \" \"»)")
    # std, module-qualified; a default that reads an earlier parameter is the
    # callee's text, `s` being `find`'s own
    assert list.contains(got, "let f = str.pad_start(s, 4«, pad: \" \"»)")
    assert list.contains(got, "let g = cursor.find(s, \"a\"«, from: start(s)»)")
    # a pipe's argument is outside the parentheses; with none, the hint brings its own
    assert list.contains(got, "let h = \"x\" |> pad(2«, fill: \" \"»)")
    assert list.contains(got, "let i = 5 |> zero«(m: 1)»")
    # past the bound the text is elided, the argument still shown
    assert list.contains(got, "let j = wordy(1«, why: …»)")
    # nothing left out, nothing shown
    assert not list.any(got, l => str.contains(l, "let k ") || str.contains(l, "let l "))
    assert len(got) == 11
  }))
}

test "inlay hints: a left-out default is a parameter hint with no padding, and can be turned off" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st0 = def_probe_state(std_for_probe())
    let d = def_probe_doc_named(st0, "defaults.dawn", defaults_probe_text())
    let params = jobj([
      ("textDocument", jobj([("uri", JStr(d.uri))])),
      ("range", jobj([("start", jpos(11, 0)), ("end", jpos(11, 99))]))
    ])
    let st1 = LspState {
      ..st0,
      docs: map.insert(st0.docs, d.uri, d),
      inlay: InlayOpts { ..st0.inlay, let_types: false }
    }
    match handle_inlay_hint(st1, params) {
      JArr(hs) -> {
        assert len(hs) == 1
        assert get_or_null(hs[0], "label") == JStr("n: 0, m: 1")
        assert get_or_null(hs[0], "kind") == JInt(2)
        assert get_or_null(hs[0], "paddingLeft") == JNull
        assert get_or_null(hs[0], "paddingRight") == JNull
      }
      _ -> { assert false }
    }
    let off = LspState {
      ..st0,
      inlay: inlay_opts_of(jobj([("initializationOptions", jobj([("inlayHints", jobj([
        ("defaultArguments", JBool(false))
      ]))]))]))
    }
    assert defaults_probe(off, d) == []
  }))
}

# ---- left-out default arguments' values (docs/lsp-hover-design.md §C4) ----

fn values_probe_text() -> String =
  join([
    "const GAP: Int = 4",
    "fn twice(n: Int) -> Int = n * 2",
    "fn spin(n: Int) -> Int = if n == 0 { 0 } else { spin(n - 1) + 1 }",
    "fn sep(s: String, gap: Int = GAP, wide: Int = twice(GAP) + 1, tag: String = \"<\${GAP}>\") -> String = s",
    "fn span(lo: Int = 1, hi: Int = lo + 9) -> Int = hi - lo",
    "fn slow(n: Int, k: Int = spin(5000)) -> Int = n + k",
    "fn listed(n: Int, xs: List[Int] = [1, 2, 3], ys: String = str.repeat(\"ab\", 20)) -> Int = n",
    "",
    "fn run(s: String) -> Int = {",
    "  let a = sep(s)",
    "  let b = sep(s, wide: 2)",
    "  let c = span()",
    "  let d = span(lo: 5)",
    "  let e = span(lo: str.len(s))",
    "  let f = slow(1)",
    "  let g = listed(1)",
    "  let h = s.sep(gap: 1)",
    "  str.len(a ++ b ++ h) + c + d + e + f + g",
    "}",
    ""
  ], "\n")

test "inlay hints: a left-out default shows its value where it folds, else its text" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st = def_probe_state(std_for_probe())
    let d = def_probe_doc_named(st, "values.dawn", "use std/str\n" ++ values_probe_text())
    let got = defaults_probe(st, d)
    # a constant, an expression over a call and an interpolation, all left
    # out; the written argument is an outer local none of them reads
    assert list.contains(got, "let a = sep(s«, gap: 4, wide: 9, tag: \"<4>\"»)")
    # a named argument given, the defaults around it still folded
    assert list.contains(got, "let b = sep(s, wide: 2«, gap: 4, tag: \"<4>\"»)")
    # a default that reads an earlier parameter folds with the call's value
    # of it, the left-out one's or the written one's
    assert list.contains(got, "let c = span(«lo: 1, hi: 10»)")
    assert list.contains(got, "let d = span(lo: 5«, hi: 14»)")
    # ... and is refused when that value is an outer local's: the text
    assert list.contains(got, "let e = span(lo: str.len(s)«, hi: lo + 9»)")
    # past the depth budget the fold is refused: the text
    assert list.contains(got, "let f = slow(1«, k: spin(5000)»)")
    # a value that repeats its text, and one too long to show: the text
    assert list.contains(got, "let g = listed(1«, xs: [1, 2, 3], ys: str.repeat(\"ab\", 20)»)")
    # UFCS: the receiver fills `s`, which no default reads
    assert list.contains(got, "let h = s.sep(gap: 1«, wide: 9, tag: \"<4>\"»)")
    assert len(got) == 8
  }))
}

test "inlay hints: left-out default values can be turned off, leaving the text" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st0 = def_probe_state(std_for_probe())
    let d = def_probe_doc_named(st0, "values.dawn", "use std/str\n" ++ values_probe_text())
    let off = LspState {
      ..st0,
      inlay: inlay_opts_of(jobj([("initializationOptions", jobj([("inlayHints", jobj([
        ("defaultArgumentValues", JBool(false))
      ]))]))]))
    }
    let got = defaults_probe(off, d)
    assert list.contains(got, "let a = sep(s«, gap: GAP, wide: twice(GAP) + 1, tag: \"<\${GAP}>\"»)")
    assert list.contains(got, "let c = span(«lo: 1, hi: lo + 9»)")
    assert len(got) == 8
  }))
}

test "inlay hints: a module-qualified call that leaves out its first parameter has no receiver" {
  io.with_fs_real(() => no_host(() => {
    # the default that fills `lo` is spanned over the whole call, so it starts
    # where the alias does, as a UFCS receiver would
    let root = "/tmp/dawn-selfhost-lsp-def/dfltstd"
    let _ = io.mkdirs(root)
    def_probe_put("${root}/modules.txt", "dfltprobe\n")
    def_probe_put("${root}/dfltprobe.dawn", "pub fn span(lo: Int = 0, hi: Int = 9) -> Int = hi - lo\n")
    let cstd = match load_std(root) {
      Ok(sc) -> sc
      Err(e) -> panic("probe std: ${std_load_error_text(e)}")
    }
    let st = def_probe_state(cstd)
    let text = join([
      "use std/dfltprobe as df",
      "",
      "fn r() -> Int = df.span() + df.span(hi: 3)",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "dfltuser.dawn", text)
    assert defaults_probe(st, d) == ["fn r() -> Int = df.span(«lo: 0, hi: 9») + df.span(hi: 3«, lo: 0»)"]
  }))
}

test "inlay hints: a call in error gets no default hint" {
  io.with_fs_real(() => io.with_env_real(() => {
    let st = def_probe_state(std_for_probe())
    let text = join([
      "fn pad(s: String, width: Int, fill: String = \" \") -> String = s ++ fill",
      "fn run() -> String = {",
      "  let a = pad(\"x\")",
      "  let b = pad(\"x\", 1, \"-\", 9)",
      "  let c = pad(\"x\", 1, nope: 2)",
      "  let e = pad(\"x\", 1, width: 2)",
      "  a ++ b ++ c ++ e",
      "}",
      ""
    ], "\n")
    let d = def_probe_doc_named(st, "defaults_err.dawn", text)
    # a required parameter missing and one argument too many, which the
    # checker types as an error node; a name that is not a parameter and a
    # parameter given twice, which it still types as a call to `pad` with the
    # argument in error -- and whose `fill` is left out all the same
    assert defaults_probe(st, d) == []
  }))
}

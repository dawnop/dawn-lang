# The string face of the runtime-intrinsic contract, checked against a written
# expectation rather than against whichever backend answered first.
#
# The JVM implements these over `java.lang.String`, which is UTF-16, and the C
# runtime over UTF-8. That difference is supposed to be invisible, and the two
# places it could leak are here: `str.len` and `str.index_of` report *code
# point* counts, so neither backend may report its own storage units.
#
# Length, trimming and the four searches are std/str functions rather than
# intrinsics now -- one definition over the cursor walk, compiled by both
# backends (docs/native-backend-plan.md 14.12) -- so this exercises the walk
# underneath as well. `Cursor` itself stays out of reach: those intrinsics are
# `internal`, and only std may name them.
#
# `parse_float` is not here: `str_of_float` is not byte-identical to Java's
# Double.toString, so no float can be printed in a differential corpus.
#
# `use std/raw` is where the primitives std does something to come from:
# `bytes_at`'s -1, `bytes_decode`'s `None` and `io_read_file`'s raise are what
# the two backends have to agree on, and std turns each into something else.
use std/io
use std/bytes
use std/raw
use std/str

fn opt_int(o: Option[Int]) -> String =
  match o {
    Some(i) -> to_string(i)
    None -> "none"
  }

fn ok_or_err(r: Result[String, ForeignError]) -> String =
  match r {
    Ok(_) -> "ok"
    # deliberately not the payload: the JVM's is an exception's toString and
    # native's is the panic message, and that divergence is documented
    Err(_) -> "err"
  }

pub fn main() -> Unit !io = {
  io.println("-- length is in code points --")
  # "aé中𝄞": one byte, two, three, four. Four code points, five UTF-16 units,
  # ten UTF-8 bytes -- so a backend reporting its own units is visible here.
  let mixed = "aé中𝄞"
  io.println("str.len            = " ++ to_string(str.len(mixed)))
  io.println("str.len ascii      = " ++ to_string(str.len("abc")))

  io.println("-- search reports a code-point index --")
  io.println("index_of 中        = " ++ opt_int(str.index_of(mixed, "中")))
  io.println("index_of missing   = " ++ opt_int(str.index_of(mixed, "z")))
  io.println("index_of empty     = " ++ opt_int(str.index_of(mixed, "")))
  io.println("last_index_of l    = " ++ opt_int(str.last_index_of("hello", "l")))
  io.println("last_index_of miss = " ++ opt_int(str.last_index_of("hello", "z")))
  io.println("last_index_of ''   = " ++ opt_int(str.last_index_of("hello", "")))

  io.println("-- predicates --")
  io.println("contains           = " ++ to_string(str.contains(mixed, "é中")))
  io.println("starts_with        = " ++ to_string(str.starts_with(mixed, "aé")))
  io.println("ends_with          = " ++ to_string(str.ends_with(mixed, "𝄞")))
  io.println("ends_with false    = " ++ to_string(str.ends_with(mixed, "中")))

  io.println("-- trimming and case --")
  io.println("trim               = [" ++ str.trim("  \t hi \n ") ++ "]")
  io.println("trim nothing       = [" ++ str.trim("hi") ++ "]")
  io.println("trim all           = [" ++ str.trim("   ") ++ "]")
  io.println("lower              = " ++ str.to_lower("MiXeD 42"))
  io.println("upper              = " ++ str.to_upper("MiXeD 42"))

  io.println("-- classification --")
  io.println("is_letter a        = " ++ to_string(char_is_letter(97)))
  io.println("is_digit a         = " ++ to_string(char_is_digit(97)))
  io.println("is_space tab       = " ++ to_string(char_is_space(9)))
  io.println("is_space ideo      = " ++ to_string(char_is_space(12288)))
  io.println("is_space nbsp      = " ++ to_string(char_is_space(160)))

  io.println("-- parsing --")
  io.println("parse_int          = " ++ opt_int(parse_int("42")))
  io.println("parse_int signed   = " ++ opt_int(parse_int("-42")))
  io.println("parse_int spaced   = " ++ opt_int(parse_int("  7 ")))
  io.println("parse_int min      = " ++ opt_int(parse_int("-9223372036854775808")))
  io.println("parse_int over     = " ++ opt_int(parse_int("9223372036854775808")))
  io.println("parse_int junk     = " ++ opt_int(parse_int("4x")))
  io.println("parse_int empty    = " ++ opt_int(parse_int("")))
  io.println("radix 16           = " ++ opt_int(parse_int_radix("ff", 16)))
  io.println("radix 2            = " ++ opt_int(parse_int_radix("1011", 2)))
  io.println("radix bad digit    = " ++ opt_int(parse_int_radix("12", 2)))

  io.println("-- code points --")
  io.println("code_points        = " ++ to_string(code_points("aé中")))
  io.println("round trip         = " ++ from_code_points(code_points(mixed)))
  io.println("from_code_points   = " ++ from_code_points([104, 105]))
  io.println("join               = " ++ join(["a", "b", "c"], "-"))
  io.println("join empty sep     = " ++ join(["a", "b"], ""))
  io.println("join one           = " ++ join(["only"], "-"))

  io.println("-- bytes --")
  let b = bytes.utf8(mixed)
  io.println("bytes_len          = " ++ to_string(bytes.len(b)))
  io.println("bytes_at 0         = " ++ to_string(raw.byte_at(b, 0)))
  io.println("bytes_at oob       = " ++ to_string(raw.byte_at(b, 99)))
  io.println("decode round trip  = " ++
      match raw.decode(b, "UTF-8") {
        Some(s) -> s
        None -> "none"
      })
  io.println("decode bad charset = " ++
      match raw.decode(b, "NoSuchCharset") {
        Some(_) -> "some"
        None -> "none"
      })

  io.println("-- the barrier --")
  # catch_fault catches an exception on the JVM and a panic natively; both make
  # this an Err, which is the part that has to agree.
  io.println("try missing file   = " ++ ok_or_err(catch_fault(fn() => raw.read_file("no-such-file"))))
  io.println("try ok             = " ++ ok_or_err(catch_fault(fn() => str.to_upper("fine"))))
}

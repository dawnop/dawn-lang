# Source dependency planning and bootstrap input discovery.
#
# Package manifests, source dependency selection and archive fetching must run
# before the compiler frontend can load a module. Keeping that work in this
# package makes the planning contract usable without linking the compiler or
# its ASM-backed JVM emitter. Planner diagnostics deliberately use the local
# diagnostic record; compiler consumers convert it only at rendering edges.

use std/io
use std/io.{Fs, Proc, Env}
use std/str
use std/map
use std/set
use std/memfs
use diagnostic.{Diag, diag}
use envmem
use procmem
use manifestv.{
  ManifestV, VPath, VUrl, SemV, MCoord, semv_show, semv_lt, semv_compat_class, mcoord_show,
  validate, check_v2_name
}
use pkgfetch
use fspath/fspath

## A resolved `[deps]` package: its manifest name, src/ root, and its own
## dependencies. Packages reached through different consumers but the same
## directory share one entry, preserving one package instance per path.
##
## `version` is what a build manifest reports for the package: for a url
## dependency the version MVS selected (the archive's own dawn.toml, when it
## names one, was already checked to agree), for a path dependency whatever its
## dawn.toml declares, None when it declares nothing. `origin` says which of the
## two it was; see docs/build-info-design.md §4.3 for why a url package keeps
## its manifest `hash` beside the source digest computed from it.
pub type PkgR = {
  name: String,
  root: String,
  deps: Map[String, PkgR],
  java_deps: List[MCoord],
  version: Option[SemV],
  origin: PkgOrigin
}

## Where a resolved package came from. A url package carries the `hash` and
## `subdir` the winning requirement named; the url itself is left out, since
## one hash may be served by several mirrors and the content is the same.
pub type PkgOrigin = FromPath | FromUrl(hash: String, subdir: String)

## The requirement MVS selected for one package name, and the cache directory
## it unpacked to.
type UrlWin = { root: String, version: SemV, hash: String, subdir: String }

## A planner diagnostic paired with the path where it should be reported.
pub type LocDiag = { path: String, d: Diag }

## The caller's explicit source target. Filesystem state must not silently
## change file-mode loading into project-mode loading or vice versa.
pub type SourceTarget = ProjectDirectory(path: String) | SourceFile(path: String)

## Source dependency planning shared by loading, Java dependency resolution,
## and bootstrap input discovery. `source_root` is the single root decision
## for both directory and file targets; consumers must not rediscover it.
pub type SourcePlan = {
  target: SourceTarget,
  project: String,
  source_root: String,
  pkgs: Map[String, PkgR],
  java_coords: List[MCoord],
  # `mcoord_show` of each Java coordinate -> the dawn.toml that declared it
  # first, in the same order `java_coords` is deduplicated in. A resolution
  # failure is reported against this file rather than the root's, which may
  # not contain the coordinate at all.
  java_coord_origin: Map[String, String],
  diags: List[LocDiag]
}

type SourceInputKind = InputFile | InputOptional | InputTree

type SourceInput = { kind: SourceInputKind, path: String }

## A path absolute and normalized, lexically. It does not resolve symbolic
## links or fold case, and it does not ask the file system anything, so it is
## the spelling for what a path *says*: a project root shown in a diagnostic,
## a module path derived from a root and a file, the closed input list of a
## bootstrap. What a path *is* -- the key two spellings of one file have to
## meet on -- is `canon_identity` below.
##
## This is the only definition. `driver/analyze`, `driver/stdlib` and
## `lsp/server` import it from here, because compiler-plan is the lowest layer
## all of them can reach: `driver/stdlib` sits below `driver/analyze` and
## cannot import it, and this package does not depend on the compiler. It
## stays out of `packages/fspath`, which is pure; asking for the working
## directory would give that published package an `Env` effect.
##
## A path that is already absolute is normalized without asking the host where
## it is: `absolute` ignores its base for such a path, but an argument is
## evaluated whether or not the callee reads it, so an eager `io.cwd()` would
## be one system call per path for an answer nobody looked at.
pub fn canon(p: String) -> String !Env =
  if fspath.is_absolute(p) { fspath.normalize(p) } else { fspath.absolute(p, io.cwd()) }

## The spelling identity is compared by: the path with every symbolic link
## resolved, as `realpath(3)` resolves it, or `canon(p)` when it cannot be
## (the path does not exist, or the host has no absolute paths, as on wasi).
## Two spellings of one existing file get one answer, so a package reached
## through a link is one package, and a file an editor opens through a link is
## the file the loader read (#207, docs/fs-real-path-design.md R3).
##
## The path handed to the host is absolute but *not* normalized first. A `..`
## after a link leaves the link's target, not the directory the link sits in:
## `home/app -> ../work/app` makes `home/app/../lib` the directory `work/lib`,
## while folding it lexically first gives `home/lib`, which does not exist, and
## the fallback would then hand back that same wrong directory. That is the
## failure this function exists to remove, so the order is the point.
##
## Only a relative path costs a working-directory read, for `canon`'s reason;
## the fallback reuses the absolute path rather than asking again.
pub fn canon_identity(p: String) -> String !Fs !Env = {
  let abs = if fspath.is_absolute(p) { p } else { io.cwd() ++ "/" ++ p }
  match io.real_path(abs) {
    Ok(resolved) -> resolved
    Err(_) -> canon(abs)
  }
}

## The manifest beside `dir`'s dawn.toml, validated once per directory
## (the Kotlin ResolveCtx.manifest), keyed by `canon_identity` so that two
## spellings of one directory read it once: a missing file is None without
## diagnostics; an invalid one reports its span diagnostics at first touch and
## caches None.
fn mf_get(
  cache0: Map[String, Option[ManifestV]],
  dir: String
) -> (Option[ManifestV], List[LocDiag], Map[String, Option[ManifestV]]) !Fs !Env = {
  let dc = canon_identity(dir)
  if map.has(cache0, dc) {
    return (map.get(cache0, dc).expect("cached manifest"), [], cache0)
  }
  let path = dir ++ "/dawn.toml"
  let text = match io.read_file(path) {
    Ok(t) -> t
    Err(_) -> return (None, [], map.insert(cache0, dc, None))
  }
  match validate(dir, text) {
    Ok(mv) -> (Some(mv), [], map.insert(cache0, dc, Some(mv)))
    Err(ds) -> {
      var out: List[LocDiag] = []
      for d in ds { out = out ++ [LocDiag { path: path, d: d }] }
      (None, out, map.insert(cache0, dc, None))
    }
  }
}

## Coordinates in resolution order, each paired with the manifest that
## declared it first; `seen` holds the coordinates already taken.
type JavaCoords = { coords: List[MCoord], origin: Map[String, String], seen: Set[String] }

fn append_java_coord(acc: JavaCoords, coord: MCoord, manifest: String) -> JavaCoords = {
  let key = mcoord_show(coord)
  if set.has(acc.seen, key) {
    acc
  } else {
    JavaCoords {
      coords: acc.coords ++ [coord],
      origin: map.insert(acc.origin, key, manifest),
      seen: set.insert(acc.seen, key)
    }
  }
}

## The manifest a resolved package was read from: its root is `<dir>/src`.
fn pkg_manifest(pkg: PkgR) -> String = proj_of_root(pkg.root) ++ "/dawn.toml"

fn collect_pkg_java_coords(
  pkg: PkgR,
  acc0: JavaCoords,
  seen_roots0: Set[String]
) -> (JavaCoords, Set[String]) = {
  if set.has(seen_roots0, pkg.root) { return (acc0, seen_roots0) }
  var acc = acc0
  var seen_roots = set.insert(seen_roots0, pkg.root)
  for key in map.keys(pkg.deps) {
    let child = map.get(pkg.deps, key).expect("resolved package")
    let (acc1, roots1) = collect_pkg_java_coords(child, acc, seen_roots)
    acc = acc1
    seen_roots = roots1
  }
  for coord in pkg.java_deps { acc = append_java_coord(acc, coord, pkg_manifest(pkg)) }
  (acc, seen_roots)
}

fn collect_java_coords(
  root_manifest: String,
  root_coords: List[MCoord],
  pkgs: Map[String, PkgR]
) -> JavaCoords = {
  var acc = JavaCoords { coords: [], origin: map.empty(), seen: set.empty() }
  for coord in root_coords { acc = append_java_coord(acc, coord, root_manifest) }
  var seen_roots: Set[String] = set.empty()
  for key in map.keys(pkgs) {
    let pkg = map.get(pkgs, key).expect("resolved package")
    let (acc1, roots1) = collect_pkg_java_coords(pkg, acc, seen_roots)
    acc = acc1
    seen_roots = roots1
  }
  acc
}

# Compute the project and source root together so no consumer has to rediscover
# the nearest `src` ancestor independently.
fn source_roots(target: SourceTarget) -> (String, String) !Env =
  match target {
    ProjectDirectory(dir) -> (dir, dir ++ "/src")
    SourceFile(file) -> {
      let source_root = nearest_src_root(file)
      (proj_of_root(source_root), source_root)
    }
  }

## Resolve source packages once, then derive Java coordinates from the final
## selected graph. Callers choose the target kind explicitly; CLI
## existence/type rejection belongs to main.dawn.
pub fn source_plan(target: SourceTarget) -> SourcePlan !Fs !Proc !Env = {
  let (project, source_root) = source_roots(target)
  let no_mfc: Map[String, Option[ManifestV]] = map.empty()
  let (url_resolved, url_names, sdiags, mfc) = select_url_deps(project, no_mfc)
  let no_cache: Map[String, Option[PkgR]] = map.empty()
  let no_names: Map[String, String] = map.empty()
  let (pkgs, mdiags, _, _, mfc1) =
    resolve_src_deps(project, no_cache, set.empty(), url_resolved, url_names, no_names, mfc)
  let (root_manifest, rdiags, _) = mf_get(mfc1, project)
  let root_coords: List[MCoord] = match root_manifest {
    Some(m) -> m.java_deps
    None -> []
  }
  let java = collect_java_coords("${project}/dawn.toml", root_coords, pkgs)
  SourcePlan {
    target: target,
    project: project,
    source_root: source_root,
    pkgs: pkgs,
    java_coords: java.coords,
    java_coord_origin: java.origin,
    diags: sdiags ++ mdiags ++ rdiags
  }
}

fn source_input_display(path: String) -> String = str.replace(path, "\n", "\\n")

fn source_input_path_ok(path: String) -> Result[Unit, String] !Fs = {
  if str.contains(path, "\n") {
    return Err("source input path contains LF: " ++ source_input_display(path))
  }
  var prefix = ""
  for seg in str.split(path, "/") {
    if seg == "" { continue }
    prefix = prefix ++ "/" ++ seg
    if io.is_symlink(prefix) {
      return Err("source input path crosses a symbolic link: " ++ source_input_display(prefix))
    }
  }
  Ok(())
}

fn validate_source_file(path: String, optional: Bool) -> Result[Unit, String] !Fs = {
  match source_input_path_ok(path) {
    Err(e) -> return Err(e)
    Ok(_) -> ()
  }
  if not io.exists(path) {
    if optional { return Ok(()) }
    return Err("required source input is missing: " ++ source_input_display(path))
  }
  if io.is_dir(path) {
    return Err("source input must be a file: " ++ source_input_display(path))
  }
  match io.read_bytes(path) {
    Ok(_) -> Ok(())
    Err(_) -> Err("source input file cannot be read: " ++ source_input_display(path))
  }
}

fn validate_source_tree(path: String) -> Result[Unit, String] !Fs = {
  match source_input_path_ok(path) {
    Err(e) -> return Err(e)
    Ok(_) -> ()
  }
  if not io.exists(path) {
    return Err("required source input is missing: " ++ source_input_display(path))
  }
  if not io.is_dir(path) {
    return Err("source input must be a directory tree: " ++ source_input_display(path))
  }
  let names = match io.list_dir(path) {
    Ok(ns) -> ns
    Err(_) ->
      return Err("source input tree cannot be traversed: " ++ source_input_display(path))
  }
  for name in names {
    let child = path ++ "/" ++ name
    match source_input_path_ok(child) {
      Err(e) -> return Err(e)
      Ok(_) -> ()
    }
    if io.is_dir(child) {
      match validate_source_tree(child) {
        Err(e) -> return Err(e)
        Ok(_) -> ()
      }
    } else if not io.exists(child) {
      return Err("source input tree entry disappeared: " ++ source_input_display(child))
    } else {
      match io.read_bytes(child) {
        Ok(_) -> ()
        Err(_) ->
          return Err("source input file cannot be read: " ++ source_input_display(child))
      }
    }
  }
  Ok(())
}

fn validate_source_input(input: SourceInput) -> Result[Unit, String] !Fs =
  match input.kind {
    InputFile -> validate_source_file(input.path, false)
    InputOptional -> validate_source_file(input.path, true)
    InputTree -> validate_source_tree(input.path)
  }

fn collect_source_pkg_inputs(
  pkg: PkgR,
  inputs0: List[SourceInput],
  seen0: Set[String]
) -> (List[SourceInput], Set[String]) !Env = {
  let root = canon(pkg.root)
  if set.has(seen0, root) { return (inputs0, seen0) }
  var inputs = inputs0
  var seen = set.insert(seen0, root)
  let parent = fspath.parent(root).expect("package source root has a parent")
  inputs = inputs ++ [
    SourceInput { kind: InputFile, path: parent ++ "/dawn.toml" },
    SourceInput { kind: InputTree, path: root }
  ]
  for key in map.keys(pkg.deps) {
    let child = map.get(pkg.deps, key).expect("resolved package")
    let (next, visited) = collect_source_pkg_inputs(child, inputs, seen)
    inputs = next
    seen = visited
  }
  (inputs, seen)
}

fn source_input_record(base: String, input: SourceInput) -> String = {
  let scope_path =
    if input.path == base {
      ("R", ".")
    } else {
      let prefix = if base == "/" { "/" } else { base ++ "/" }
      if str.starts_with(input.path, prefix) {
        ("R", str.drop(input.path, str.len(prefix)))
      } else {
        ("A", input.path)
      }
    }
  let (scope, path) = scope_path
  let kind = match input.kind {
    InputFile -> "F"
    InputOptional -> "O"
    InputTree -> "T"
  }
  scope ++ "\t" ++ kind ++ "\t" ++ path
}

pub fn bootstrap_source_input_manifest(
  plan: SourcePlan,
  base: String
) -> Result[String, String] !Fs !Env = {
  match plan.target {
    SourceFile(_) ->
      return Err("cannot serialize bootstrap source inputs for a source file target")
    ProjectDirectory(_) -> ()
  }
  if len(plan.diags) > 0 {
    return Err("cannot serialize source inputs from a plan with diagnostics")
  }
  if base == "" { return Err("source input base must not be empty") }
  let base_abs = canon(base)
  match source_input_path_ok(base_abs) {
    Err(e) -> return Err(e)
    Ok(_) -> ()
  }
  if not io.is_dir(base_abs) {
    return Err("source input base must be a directory: " ++ source_input_display(base_abs))
  }

  let project = canon(plan.project)
  var inputs: List[SourceInput] = [
    SourceInput { kind: InputFile, path: project ++ "/dawn.toml" },
    SourceInput { kind: InputOptional, path: project ++ "/dawn.lock" },
    SourceInput { kind: InputTree, path: canon(plan.source_root) }
  ]
  var seen: Set[String] = set.empty()
  for key in map.keys(plan.pkgs) {
    let pkg = map.get(plan.pkgs, key).expect("resolved package")
    let (next, visited) = collect_source_pkg_inputs(pkg, inputs, seen)
    inputs = next
    seen = visited
  }

  var records: List[String] = []
  for input in inputs {
    match validate_source_input(input) {
      Err(e) -> return Err(e)
      Ok(_) -> { records = records ++ [source_input_record(base_abs, input)] }
    }
  }
  Ok("dawn-source-inputs-v1\n" ++ join(sort(records), "\n") ++ "\n")
}

# The content-addressed package cache root lives in pkgfetch (one definition;
# $DAWN_PKG_CACHE, then ~/.dawn/pkg).

type UrlReq = { url: String, version: SemV, hash: String, subdir: String, mf_path: String }

type UrlFailures = {
  mirrors: Set[(String, String)],
  subdirs: Set[(String, String)]
}

fn url_failures_empty() -> UrlFailures = UrlFailures {
  mirrors: set.empty(),
  subdirs: set.empty()
}

fn mirror_failure_seen(failed: UrlFailures, hash: String, url: String) -> Bool =
  set.has(failed.mirrors, (hash, url))

fn subdir_failure_seen(failed: UrlFailures, hash: String, subdir: String) -> Bool =
  set.has(failed.subdirs, (hash, subdir))

fn remember_mirror_failure(failed: UrlFailures, hash: String, url: String) -> UrlFailures =
  UrlFailures { ..failed, mirrors: set.insert(failed.mirrors, (hash, url)) }

fn remember_subdir_failure(
  failed: UrlFailures,
  hash: String,
  subdir: String
) -> UrlFailures =
  UrlFailures { ..failed, subdirs: set.insert(failed.subdirs, (hash, subdir)) }

## A failed mirror is provisional until every requirement for the same content
## hash has been tried. One successful mirror makes the archive available and
## suppresses those transport diagnostics; a missing subdir remains a real
## content error and is appended immediately.
fn record_url_attempt(
  hash: String,
  attempt_diags: List[LocDiag],
  mirror_ok: Bool,
  available0: Set[String],
  pending0: List[(String, LocDiag)],
  diags0: List[LocDiag]
) -> (Set[String], List[(String, LocDiag)], List[LocDiag]) = {
  var available = available0
  var pending = pending0
  var diags = diags0
  if mirror_ok {
    available = set.insert(available, hash)
    diags = diags ++ attempt_diags
  } else if not set.has(available, hash) {
    for d in attempt_diags { pending = pending ++ [(hash, d)] }
  }
  (available, pending, diags)
}

## The package root for a url requirement: the cache, fetched and verified on
## a miss (pkgfetch). Mirror failures de-duplicate per (hash, url), so aliases,
## subdirs and the selection phase do not retry one bad mirror while another
## url for the same bytes can still be tried. Missing subdirs de-duplicate per
## (hash, subdir). The final Bool says whether this attempt validated a mirror,
## including a valid archive whose requested subdir was absent.
fn url_pkg_root(
  name: String,
  r: UrlReq,
  failed0: UrlFailures
) -> (Option[String], List[LocDiag], UrlFailures, Bool) !Fs !Proc !Env = {
  let entry = pkgfetch.cache_dir(pkgfetch.cache_root(), r.hash)
  let root = if r.subdir == "" { entry } else { entry ++ "/" ++ r.subdir }
  if mirror_failure_seen(failed0, r.hash, r.url) {
    return (None, [], failed0, false)
  }
  if subdir_failure_seen(failed0, r.hash, r.subdir) {
    return (None, [], failed0, io.is_dir(entry))
  }
  # A warm entry returns without `ensure_cached` ever running, so the url/hash
  # guard has to be asked here too — this is the path a manifest that bumped
  # `url` and kept `hash` takes, and the only one it takes.
  #
  # Its failures are remembered per mirror rather than per dependency: one tag
  # archive commonly serves several packages by `subdir`, but a second mirror
  # for the same hash is still a legitimate source and must be attempted.
  if io.is_dir(root) {
    match pkgfetch.check_origin(r.url, r.hash) {
      Ok(_) -> return (Some(root), [], failed0, true)
      Err(e) -> {
        let d = [LocDiag { path: r.mf_path, d: diag(
          "package `" ++ name ++ "` " ++ semv_show(r.version) ++ ": " ++ e,
          0,
          0,
          ""
        ) }]
        return (None, d, remember_mirror_failure(failed0, r.hash, r.url), false)
      }
    }
  }
  match pkgfetch.ensure_cached(r.url, r.hash) {
    Ok(_) -> {
      if io.is_dir(root) { return (Some(root), [], failed0, true) }
      let d = [LocDiag { path: r.mf_path, d: diag(
        "package `" ++ name ++ "` " ++ semv_show(r.version) ++ ": subdir `" ++ r.subdir ++
          "` does not exist in the archive",
        0,
        0,
        "the archive fetched and verified, but the `subdir` points nowhere inside it"
      ) }]
      (None, d, remember_subdir_failure(failed0, r.hash, r.subdir), true)
    }
    Err(e) -> {
      let d = [LocDiag { path: r.mf_path, d: diag(
        "package `" ++ name ++ "` " ++ semv_show(r.version) ++ ": " ++ e,
        0,
        0,
        ""
      ) }]
      (None, d, remember_mirror_failure(failed0, r.hash, r.url), false)
    }
  }
}

## The selected requirement for one name: the highest version, the first
## requirement at that version on a tie (MVS, package-design.md §4.5).
fn max_req(rlist: List[UrlReq]) -> UrlReq = {
  var win = rlist[0]
  for r in rlist { if semv_lt(win.version, r.version) { win = r } }
  win
}

## One diagnostic per requirement whose compatibility class is not the
## selected version's (package-design.md §6.3). This is a check after
## selection, not a constraint inside it: selection stays one pass with no
## upper bounds and no backtracking, and a graph that crosses a class fails
## instead of quietly handing `win` to a requirer it may break. A selected
## major of 2 or more under a name that does not carry it is left to the
## v2-in-name rule, which reports it after this: telling the lagging side to
## raise its requirement to a version that rule refuses would be wrong advice.
## So in practice this catches 0.x and 0 to 1. The report sits on the lagging manifest,
## because raising that requirement is the fix: the other side cannot be
## lowered under MVS without also lowering whatever made it ask for more.
fn class_conflicts(name: String, rlist: List[UrlReq], win: UrlReq) -> List[LocDiag] = {
  if len(check_v2_name(name, win.version, 0, 0)) > 0 { return [] }
  let want = semv_compat_class(win.version)
  var out: List[LocDiag] = []
  var seen: Set[(String, String)] = set.empty()
  for r in rlist {
    let have = semv_compat_class(r.version)
    let key = (r.mf_path, semv_show(r.version))
    if have != want && not set.has(seen, key) {
      seen = set.insert(seen, key)
      out = out ++ [LocDiag { path: r.mf_path, d: diag(
        "package `" ++ name ++ "` is required at " ++ semv_show(r.version) ++ " by " ++
          r.mf_path ++ " and at " ++ semv_show(win.version) ++ " by " ++ win.mf_path ++
          ", and " ++ have ++ " is not compatible with " ++ want,
        0,
        0,
        "one version per package is selected, so " ++ r.mf_path ++ " would get " ++
          semv_show(win.version) ++ ": raise its `" ++ name ++ "` requirement to " ++
          semv_show(win.version) ++ " (a 0.x minor, a 0.0.x patch and 0 to 1 break like a major)"
      ) }]
    }
  }
  out
}

## Minimal Version Selection over `[deps.<alias>]` requirements (the Kotlin
## selectUrlDeps, package-design.md §4.5): walk the whole requirement graph —
## every version any reachable manifest mentions — then pick the maximum
## required version per name. The name is the package's own manifest name, not
## the consumer's alias (§4.3: the alias is local sugar), so two consumers
## spelling one package differently still share a single selection. Same
## version under two hashes is an integrity error, and so are requirements on
## one name in two compatibility classes (`class_conflicts`). Returns name → the
## chosen requirement and its package root (None = errored) plus hash:subdir →
## real name for the linker.
fn select_url_deps(
  root_dir: String,
  mfc0: Map[String, Option[ManifestV]]
) -> (Map[String, Option[UrlWin]], Map[String, String], List[LocDiag],
  Map[String, Option[ManifestV]]) !Fs !Proc !Env = {
  var mfc = mfc0
  var reqs: Map[String, List[UrlReq]] = map.empty()
  var url_names: Map[String, String] = map.empty()
  var seen: Set[String] = set.empty()
  var failed = url_failures_empty()
  var available_hashes: Set[String] = set.empty()
  var pending_mirror_diags: List[(String, LocDiag)] = []
  var diags: List[LocDiag] = []
  var queue: List[String] = [root_dir]
  var qi = 0
  while qi < len(queue) {
    let dir = queue[qi]
    qi = qi + 1
    let dc = canon_identity(dir)
    if set.has(seen, dc) { continue }
    seen = set.insert(seen, dc)
    let (mopt, mds, mfc1) = mf_get(mfc, dir)
    mfc = mfc1
    diags = diags ++ mds
    match mopt {
      Some(m) -> {
        for dep in m.deps {
          match dep {
            VPath(_, pdir, _, _) -> { if io.is_dir(pdir) { queue = queue ++ [pdir] } }
            VUrl(aname, ver, url, hash, sub_opt, _, _) -> {
              let sub = sub_opt.unwrap_or("")
              let r = UrlReq {
                url: url, version: ver, hash: hash, subdir: sub,
                mf_path: dir ++ "/dawn.toml"
              }
              let (ro, ds, f1, mirror_ok) = url_pkg_root(aname, r, failed)
              failed = f1
              let (available1, pending1, diags1) = record_url_attempt(
                hash, ds, mirror_ok, available_hashes, pending_mirror_diags, diags)
              available_hashes = available1
              pending_mirror_diags = pending1
              diags = diags1
              var name = aname
              match ro {
                Some(rt) -> {
                  let (pmo, pmds, mfc2) = mf_get(mfc, rt)
                  mfc = mfc2
                  diags = diags ++ pmds
                  match pmo {
                    Some(pm) -> { if pm.name != "" { name = pm.name } }
                    None -> ()
                  }
                }
                None -> ()
              }
              url_names = map.insert(url_names, hash ++ ":" ++ sub, name)
              let prev: List[UrlReq] = match map.get(reqs, name) {
                Some(l) -> l
                None -> []
              }
              reqs = map.insert(reqs, name, prev ++ [r])
              match ro {
                Some(rt) -> { queue = queue ++ [rt] }
                None -> ()
              }
            }
          }
        }
      }
      None -> ()
    }
  }
  var resolved: Map[String, Option[UrlWin]] = map.empty()
  for name in map.keys(reqs) {
    let rlist = map.get(reqs, name).expect("reqs")
    let win = max_req(rlist)
    var conflict = false
    for r in rlist { if r.version == win.version && r.hash != win.hash { conflict = true } }
    if conflict {
      diags = diags ++ [LocDiag { path: win.mf_path, d: diag(
        "package `" ++ name ++ "` version " ++ semv_show(win.version) ++
          " is required under different hashes",
        0,
        0,
        "the same version must mean the same content everywhere; align the `hash` values"
      ) }]
      resolved = map.insert(resolved, name, None)
      continue
    }
    let crossed = class_conflicts(name, rlist, win)
    if len(crossed) > 0 {
      diags = diags ++ crossed
      resolved = map.insert(resolved, name, None)
      continue
    }
    let (ro, ds, f1, mirror_ok) = url_pkg_root(name, win, failed)
    failed = f1
    let (available1, pending1, diags1) = record_url_attempt(
      win.hash, ds, mirror_ok, available_hashes, pending_mirror_diags, diags)
    available_hashes = available1
    pending_mirror_diags = pending1
    diags = diags1
    match ro {
      None -> { resolved = map.insert(resolved, name, None) }
      Some(rt) -> {
        # v2 = new name (§6.3), against the selected name rather than the
        # alias. One predicate, shared with the manifest's own check; see
        # `manifestv.check_v2_name` for why the two callers differ.
        let name_problems = check_v2_name(name, win.version, 0, 0)
        let (dmo, dmds, mfc3) = mf_get(mfc, rt)
        mfc = mfc3
        diags = diags ++ dmds
        let declared: Option[SemV] = match dmo {
          Some(m) -> m.version
          None -> None
        }
        let declared_differs = match declared {
          Some(v) -> v != win.version
          None -> false
        }
        if len(name_problems) > 0 {
          for d in name_problems {
            diags = diags ++ [LocDiag { path: win.mf_path, d: d }]
          }
          resolved = map.insert(resolved, name, None)
        } else if declared_differs {
          let declared_version = declared.expect("different declared version")
          diags = diags ++ [LocDiag { path: win.mf_path, d: diag(
            "package `" ++ name ++ "` declares version " ++ semv_show(declared_version) ++
              " but " ++ semv_show(win.version) ++ " was selected",
            0,
            0,
            "the archive's dawn.toml disagrees with the requirement; fix the version or the url"
          ) }]
          resolved = map.insert(resolved, name, None)
        } else {
          let picked = UrlWin { root: rt, version: win.version, hash: win.hash, subdir: win.subdir }
          resolved = map.insert(resolved, name, Some(picked))
        }
      }
    }
  }
  for pending in pending_mirror_diags {
    let (hash, d) = pending
    if not set.has(available_hashes, hash) { diags = diags ++ [d] }
  }
  (resolved, url_names, diags, mfc)
}

## `[deps]` → alias → package, recursively (transitive packages resolve their
## own manifests). Mirrors the Kotlin ModuleLoader.link: the name a dependency's
## own dawn.toml declares is its identity, the alias only this consumer's
## spelling (§4.3). `cache` (canonical dir → resolved package, None = known
## bad), `visiting` (cycle guard) and `names` (package name → owning dir, one
## copy program-wide) are threaded through the recursion; url deps arrive
## pre-selected, looked up through `url_names` (hash:subdir → real name).
fn resolve_src_deps(
  dir: String,
  cache0: Map[String, Option[PkgR]],
  visiting: Set[String],
  url_resolved: Map[String, Option[UrlWin]],
  url_names: Map[String, String],
  names0: Map[String, String],
  mfc0: Map[String, Option[ManifestV]]
) -> (Map[String, PkgR], List[LocDiag], Map[String, Option[PkgR]], Map[String, String],
  Map[String, Option[ManifestV]]) !Fs !Env = {
  var out: Map[String, PkgR] = map.empty()
  var diags: List[LocDiag] = []
  var cache = cache0
  var names = names0
  var mfc = mfc0
  let mf_path = dir ++ "/dawn.toml"
  let (mopt0, mds0, mfca) = mf_get(mfc, dir)
  mfc = mfca
  diags = diags ++ mds0
  match mopt0 {
    Some(m) -> {
      for dep in m.deps {
        let aname = match dep {
          VPath(a, _, _, _) -> a
          VUrl(a, _, _, _, _, _, _) -> a
        }
        # A url dependency resolves to the requirement MVS selected, which may
        # be another consumer's: its version and hash describe the package,
        # this consumer's request does not.
        let ddir_opt: Option[(String, Option[UrlWin])] = match dep {
          VPath(_, d, _, _) -> Some((d, None))
          VUrl(_, _, _, hash, sub_opt, _, _) -> {
            let sub = sub_opt.unwrap_or("")
            let nm = match map.get(url_names, hash ++ ":" ++ sub) {
              Some(n) -> n
              None -> aname
            }
            match map.get(url_resolved, nm) {
              Some(Some(w)) -> Some((w.root, Some(w)))
              Some(None) -> None
              None -> None
            }
          }
        }
        let unresolved = match ddir_opt {
          Some(_) -> false
          None -> true
        }
        if unresolved { continue } # selection already errored
        let (ddir_given, url_win) = ddir_opt.expect("dep dir")
        # The directory is resolved once, where it enters the graph, and read
        # through that spelling from here on: the package's identity, its
        # manifest, its src/ and its own relative dependencies. A kernel
        # answers the given spelling the same way, so on a host this changes
        # which name is read and not what is read; it is what keeps one
        # package reached through a link from being two (#207). Diagnostics
        # below still show the spelling the consumer wrote.
        let dcanon = canon_identity(ddir_given)
        let ddir = dcanon
        if map.has(cache, dcanon) {
          # an earlier link of this directory claimed its name; same dir = same claim
          match map.get(cache, dcanon).expect("cached") {
            Some(hit) -> { out = map.insert(out, aname, hit) }
            None -> ()
          }
          continue
        }
        if set.has(visiting, dcanon) {
          diags = diags ++ [LocDiag { path: mf_path, d: diag(
            "package dependency cycle through `" ++ aname ++ "`",
            0,
            0,
            "a package cannot depend on itself, directly or through its dependencies"
          ) }]
          continue
        }
        let (dmo, dmds, mfcb) = mf_get(mfc, ddir)
        mfc = mfcb
        diags = diags ++ dmds
        match dmo {
          Some(dm) ->
            if map.get(names, dm.name).unwrap_or(dcanon) != dcanon {
              let claimed = map.get(names, dm.name).expect("claim")
              diags = diags ++ [LocDiag { path: mf_path, d: diag(
                "package `" ++ dm.name ++ "` is linked from two different directories",
                0,
                0,
                "one package name means one copy program-wide (coherence, package-design.md §4.5);\n" ++
                  "  here:      " ++ dcanon ++ "\n  elsewhere: " ++ claimed
              ) }]
            } else if not io.is_dir(ddir ++ "/src") {
              diags = diags ++ [LocDiag { path: mf_path, d: diag(
                "package `" ++ dm.name ++ "` has no src/ folder (expected " ++
                  ddir_given ++ "/src)",
                0,
                0,
                ""
              ) }]
              cache = map.insert(cache, dcanon, None)
            } else {
              let (tdeps, tdiags, cache1, names1, mfc1) =
                resolve_src_deps(ddir, cache, set.insert(visiting, dcanon), url_resolved,
                  url_names, names, mfc)
              diags = diags ++ tdiags
              cache = cache1
              names = names1
              mfc = mfc1
              let info = PkgR {
                name: dm.name,
                root: canon_identity(ddir ++ "/src"),
                deps: tdeps,
                java_deps: dm.java_deps,
                version: match url_win {
                  Some(w) -> Some(w.version)
                  None -> dm.version
                },
                origin: match url_win {
                  Some(w) -> FromUrl(w.hash, w.subdir)
                  None -> FromPath
                }
              }
              cache = map.insert(cache, dcanon, Some(info))
              names = map.insert(names, dm.name, dcanon)
              out = map.insert(out, aname, info)
            }
          None -> {
            diags = diags ++ [LocDiag { path: mf_path, d: diag(
              "dependency `" ++ aname ++ "` has no dawn.toml (looked in " ++
                ddir_given ++ ")",
              0,
              0,
              "a Dawn source package is a directory with dawn.toml (name = \"" ++
                aname ++ "\") and src/"
            ) }]
            cache = map.insert(cache, dcanon, None)
          }
        }
      }
    }
    None -> ()
  }
  (out, diags, cache, names, mfc)
}

fn nearest_src_root(file: String) -> String !Env = {
  let abs = canon(file)
  var dir = match str.last_index_of(abs, "/") {
    Some(i) -> str.take(abs, i)
    None -> abs
  }
  var out = dir
  var found = false
  while not found && str.contains(dir, "/") {
    let name = match str.last_index_of(dir, "/") {
      Some(i) -> str.drop(dir, i + 1)
      None -> dir
    }
    if name == "src" {
      out = dir
      found = true
    } else {
      dir = match str.last_index_of(dir, "/") {
        Some(i) -> str.take(dir, i)
        None -> dir
      }
    }
  }
  out
}

## The project directory a source root belongs to: `<proj>/src` → `<proj>`;
## a root that is not called `src` is its own project (file mode falls back to
## the file's own directory, which has no `src` above it to strip).
fn proj_of_root(root: String) -> String =
  match str.last_index_of(root, "/") {
    Some(i) -> if str.drop(root, i + 1) == "src" { str.take(root, i) } else { root }
    None -> root
  }

## Run `body` with no host environment behind it. Every path the tests below
## name is absolute, so `canon` asks for the working directory and resolves a
## name the answer cannot move; a directory no host has says so.
fn no_host[T](body: fn() -> T !Env !Fs) -> T !Fs !io = {
  let (out, _) = envmem.with_env_table(envmem.TABLE_CWD, [], body)
  out
}

test "SourcePlan owns the directory and file source roots" {
  let (_, log) = envmem.with_env_table(envmem.TABLE_CWD, [], () => {
    let (dir_project, dir_root) =
      source_roots(ProjectDirectory("/tmp/dawn-planner-dir"))
    assert dir_project == "/tmp/dawn-planner-dir"
    assert dir_root == "/tmp/dawn-planner-dir/src"

    let (file_project, file_root) =
      source_roots(SourceFile("/tmp/dawn-planner-file/src/nested/main.dawn"))
    assert file_project == "/tmp/dawn-planner-file"
    assert file_root == "/tmp/dawn-planner-file/src"
  })
  # an absolute target is planned without one question to the host: both roots
  # above are arithmetic on the name that was handed in
  assert log == []
}

test "bootstrap source inputs reject file plans before inspecting the base" {
  io.with_fs_real(() => no_host(() => {
    let no_pkgs: Map[String, PkgR] = map.empty()
    let no_diags: List[LocDiag] = []
    let plan = SourcePlan {
      target: SourceFile("/tmp/dawn-planner-file/src/main.dawn"),
      project: "/tmp/dawn-planner-file",
      source_root: "/tmp/dawn-planner-file/src",
      pkgs: no_pkgs,
      java_coords: [],
      java_coord_origin: map.empty(),
      diags: no_diags
    }
    match bootstrap_source_input_manifest(plan, "") {
      Ok(_) -> { assert false }
      Err(error) -> {
        assert error == "cannot serialize bootstrap source inputs for a source file target"
      }
    }
  }))
}

test "Java coordinates follow the final source graph order once" {
  let no_deps: Map[String, PkgR] = map.empty()
  let root_1 = MCoord { group: "g", artifact: "root-1", version: "1", aname: "r1" }
  let root_2 = MCoord { group: "g", artifact: "root-2", version: "1", aname: "r2" }
  let grand_a = PkgR {
    name: "grand",
    root: "/canonical/grand/src",
    deps: no_deps,
    java_deps: [MCoord { group: "g", artifact: "grandchild", version: "1", aname: "ga" }],
    version: None,
    origin: FromPath
  }
  let grand_b = PkgR {
    name: "grand",
    root: "/canonical/grand/src",
    deps: no_deps,
    java_deps: [MCoord { group: "g", artifact: "must-not-repeat", version: "1", aname: "gb" }],
    version: None,
    origin: FromPath
  }
  let child_a = PkgR {
    name: "child_a",
    root: "/canonical/child-a/src",
    deps: map.insert(no_deps, "grand", grand_a),
    java_deps: [
      MCoord { group: "g", artifact: "root-1", version: "1", aname: "duplicate-alias" },
      MCoord { group: "g", artifact: "child-a", version: "1", aname: "ca" }
    ],
    version: None,
    origin: FromPath
  }
  let child_b = PkgR {
    name: "child_b",
    root: "/canonical/child-b/src",
    deps: map.insert(no_deps, "grand", grand_b),
    java_deps: [MCoord { group: "g", artifact: "child-b", version: "1", aname: "cb" }],
    version: None,
    origin: FromPath
  }
  var roots: Map[String, PkgR] = map.empty()
  roots = map.insert(roots, "z_first", child_a)
  roots = map.insert(roots, "a_second", child_b)
  let java = collect_java_coords("/canonical/app/dawn.toml", [root_1, root_2], roots)
  var got: List[String] = []
  for coord in java.coords {
    got = got ++ [mcoord_show(coord)]
  }
  assert got == [
    "g:root-1:1",
    "g:root-2:1",
    "g:grandchild:1",
    "g:child-a:1",
    "g:child-b:1"
  ]
  # each coordinate names the manifest that declared it first: child_a also
  # declares root-1, and the grand package's second copy is never read
  var origins: List[String] = []
  for coord in java.coords {
    origins = origins ++ [map.get(java.origin, mcoord_show(coord)).expect("origin")]
  }
  assert origins == [
    "/canonical/app/dawn.toml",
    "/canonical/app/dawn.toml",
    "/canonical/grand/dawn.toml",
    "/canonical/child-a/dawn.toml",
    "/canonical/child-b/dawn.toml"
  ]
  assert len(map.keys(java.origin)) == len(java.coords)
}

test "mixed manifest declaration order reaches SourcePlan Java coordinates" {
  let hash = "d1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let root_coord = MCoord { group: "g", artifact: "root", version: "1", aname: "root" }
  let no_deps: Map[String, PkgR] = map.empty()
  let url_pkg = PkgR {
    name: "remote",
    root: "/canonical/remote/src",
    deps: no_deps,
    java_deps: [MCoord { group: "g", artifact: "url", version: "1", aname: "url" }],
    version: None,
    origin: FromPath
  }
  let path_pkg = PkgR {
    name: "local",
    root: "/canonical/local/src",
    deps: no_deps,
    java_deps: [MCoord { group: "g", artifact: "path", version: "1", aname: "path" }],
    version: None,
    origin: FromPath
  }

  let url_first_text = "schema = 1\nname = \"app\"\n\n[deps.remote]\n" ++
    "url = \"file:///remote.zip\"\nversion = \"1.0.0\"\nhash = \"" ++ hash ++
    "\"\n\n[deps]\nlocal = \"../local\"\n"
  let url_first = match validate("/p", url_first_text) {
    Ok(m) -> m
    Err(_) -> panic("url-first manifest must validate")
  }
  var url_first_pkgs: Map[String, PkgR] = map.empty()
  for dep in url_first.deps {
    match dep {
      VUrl(aname, _, _, _, _, _, _) -> {
        url_first_pkgs = map.insert(url_first_pkgs, aname, url_pkg)
      }
      VPath(aname, _, _, _) -> {
        url_first_pkgs = map.insert(url_first_pkgs, aname, path_pkg)
      }
    }
  }
  var got: List[String] = []
  for coord in collect_java_coords("/p/dawn.toml", [root_coord], url_first_pkgs).coords {
    got = got ++ [mcoord_show(coord)]
  }
  assert got == ["g:root:1", "g:url:1", "g:path:1"]

  let path_first_text = "schema = 1\nname = \"app\"\n\n[deps]\nlocal = \"../local\"\n\n" ++
    "[deps.remote]\nurl = \"file:///remote.zip\"\nversion = \"1.0.0\"\nhash = \"" ++
    hash ++ "\"\n"
  let path_first = match validate("/p", path_first_text) {
    Ok(m) -> m
    Err(_) -> panic("path-first manifest must validate")
  }
  var path_first_pkgs: Map[String, PkgR] = map.empty()
  for dep in path_first.deps {
    match dep {
      VUrl(aname, _, _, _, _, _, _) -> {
        path_first_pkgs = map.insert(path_first_pkgs, aname, url_pkg)
      }
      VPath(aname, _, _, _) -> {
        path_first_pkgs = map.insert(path_first_pkgs, aname, path_pkg)
      }
    }
  }
  got = []
  for coord in collect_java_coords("/p/dawn.toml", [root_coord], path_first_pkgs).coords {
    got = got ++ [mcoord_show(coord)]
  }
  assert got == ["g:root:1", "g:path:1", "g:url:1"]
}

test "mirror failure state retries another url but not another alias" {
  let hash = "archive-a"
  let bad_url = "file:///bad.zip"
  let good_url = "file:///good.zip"
  var failed = url_failures_empty()
  var attempts = 0
  var diags = 0
  # Two aliases and the winner-resolution phase share one failed mirror.
  for subdir in ["one", "two", "one"] {
    if not mirror_failure_seen(failed, hash, bad_url) {
      attempts = attempts + 1
      diags = diags + 1
      failed = remember_mirror_failure(failed, hash, bad_url)
    }
  }
  assert attempts == 1
  assert diags == 1
  assert not mirror_failure_seen(failed, hash, good_url)
  assert not mirror_failure_seen(failed, "archive-b", bad_url)

  # A valid archive with one missing subdir must not suppress another subdir.
  let subdir_failed = remember_subdir_failure(url_failures_empty(), hash, "one")
  assert subdir_failure_seen(subdir_failed, hash, "one")
  assert not subdir_failure_seen(subdir_failed, hash, "two")
}

fn req_at(version: String, mf_path: String) -> UrlReq = {
  let parts = str.split(version, ".")
  UrlReq {
    url: "file:///" ++ version ++ ".zip",
    version: SemV {
      major: parse_int(parts[0]).expect("major"),
      minor: parse_int(parts[1]).expect("minor"),
      patch: parse_int(parts[2]).expect("patch")
    },
    hash: "h-" ++ version,
    subdir: "",
    mf_path: mf_path
  }
}

## The selection and the class check for requirements `a` (from a/dawn.toml)
## and `b` (from b/dawn.toml) on one name.
fn select_pair(a: String, b: String) -> (String, List[LocDiag]) = {
  let rlist = [req_at(a, "a/dawn.toml"), req_at(b, "b/dawn.toml")]
  let win = max_req(rlist)
  (semv_show(win.version), class_conflicts("foo", rlist, win))
}

test "requirements on one name across compatibility classes are rejected" {
  for pair in [("0.3.0", "1.0.0"), ("0.1.0", "0.2.0"), ("0.0.1", "0.0.2")] {
    let (lo, hi) = pair
    for flip in [false, true] {
      let (got, ds) = if flip { select_pair(hi, lo) } else { select_pair(lo, hi) }
      # selection itself is unchanged: still the maximum
      assert got == hi
      assert len(ds) == 1
      # the report sits on the lagging manifest, and it names both
      let lag = if flip { "b/dawn.toml" } else { "a/dawn.toml" }
      let lead = if flip { "a/dawn.toml" } else { "b/dawn.toml" }
      assert ds[0].path == lag
      assert ds[0].d.msg == "package `foo` is required at " ++ lo ++ " by " ++ lag ++
        " and at " ++ hi ++ " by " ++ lead ++ ", and " ++
        semv_compat_class(req_at(lo, "").version) ++ " is not compatible with " ++
        semv_compat_class(req_at(hi, "").version)
      # the hint says which side to raise, and to what
      assert str.contains(ds[0].d.hint, lag ++ " would get " ++ hi)
      assert str.contains(ds[0].d.hint, "raise its `foo` requirement to " ++ hi)
    }
  }
  let (_, ds) = select_pair("0.3.0", "1.0.0")
  assert ds[0].d.msg ==
    "package `foo` is required at 0.3.0 by a/dawn.toml and at 1.0.0 by b/dawn.toml, " ++
    "and 0.3.x is not compatible with 1.x"
}

test "requirements on one name within a compatibility class select the highest" {
  for pair in [("0.3.0", "0.3.4"), ("1.0.0", "1.7.0")] {
    let (lo, hi) = pair
    assert select_pair(lo, hi) == (hi, [])
    assert select_pair(hi, lo) == (hi, [])
  }
  # one lagging manifest asking twice is reported once; a third requirer in
  # the selected class is not reported at all
  let rlist = [
    req_at("0.2.0", "a/dawn.toml"),
    req_at("0.2.0", "a/dawn.toml"),
    req_at("0.3.0", "b/dawn.toml"),
    req_at("0.3.1", "c/dawn.toml")
  ]
  let win = max_req(rlist)
  assert semv_show(win.version) == "0.3.1"
  let ds = class_conflicts("foo", rlist, win)
  assert len(ds) == 1
  assert ds[0].path == "a/dawn.toml"
}

test "a major the name does not carry is left to the v2-in-name rule" {
  # `foo` at 2.0.0 is refused by `check_v2_name`; advising the 1.0.0 side to
  # raise to it would point at a version that cannot be selected
  let (got, ds) = select_pair("1.0.0", "2.0.0")
  assert got == "2.0.0"
  assert ds == []
  # under a name that carries the major the classes are compared as usual
  let rlist = [req_at("1.0.0", "a/dawn.toml"), req_at("2.0.0", "b/dawn.toml")]
  assert len(class_conflicts("foo2", rlist, max_req(rlist))) == 1
}

## `st` with a link at `at` to `target` and `files` readable through it.
##
## A `std/memfs` link is seen by `fs_real_path` and by nothing else: reading
## `at/dawn.toml` does not follow it. A kernel does follow it, so the files a
## reader would find through the link are written out at the link's spelling
## too, with the same text as at the target. The tree then answers both
## spellings the way a host does, and only the identity question can tell
## them apart, which is the question under test.
fn mem_linked(
  st0: memfs.MemFs,
  at: String,
  target: String,
  files: List[(String, String)]
) -> memfs.MemFs = {
  var st = memfs.link(st0, at, target)
  for (rel, text) in files { st = memfs.put(st, "${at}/${rel}", text) }
  st
}

## `source_plan` over a table: the tree is `seed`, the environment is empty,
## and a child process would panic for want of a reply.
fn plan_in_table(seed: memfs.MemFs, target: SourceTarget) -> SourcePlan !io = {
  let (planned, _) = memfs.with_fs(seed, () => procmem.with_proc_table([], () => {
    let (plan, _) = envmem.with_env_table(envmem.TABLE_CWD, [], () => source_plan(target))
    plan
  }))
  let (plan, calls) = planned
  if calls != [] { panic("a path-only plan spawned a process") }
  plan
}

test "a package reached through a link and through its own path is one package" {
  # A diamond: `app` depends on `lib` and on `mid`, and `mid` names the same
  # `lib` through `lib_link -> lib`. The lexical spellings differ, the
  # directory does not, so this is one package and not a coherence error.
  let lib_toml = "schema = 1\nname = \"lib\"\n"
  let lib_src = "pub fn tag() -> Int = 1\n"
  var st = memfs.empty(memfs.BASE)
  st = memfs.put(st, "/p/lib/dawn.toml", lib_toml)
  st = memfs.put(st, "/p/lib/src/util.dawn", lib_src)
  st = mem_linked(st, "/p/lib_link", "lib",
    [("dawn.toml", lib_toml), ("src/util.dawn", lib_src)])
  st = memfs.put(st, "/p/mid/dawn.toml",
    "schema = 1\nname = \"mid\"\n\n[deps]\nlib = \"../lib_link\"\n")
  st = memfs.put(st, "/p/mid/src/m.dawn", "pub fn m() -> Int = 2\n")
  st = memfs.put(st, "/p/app/dawn.toml",
    "schema = 1\nname = \"app\"\n\n[deps]\nlib = \"../lib\"\nmid = \"../mid\"\n")
  st = memfs.put(st, "/p/app/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
  let plan = plan_in_table(st, ProjectDirectory("/p/app"))
  for ld in plan.diags {
    assert not str.contains(ld.d.msg, "linked from two different directories")
  }
  assert len(plan.diags) == 0
  let direct = map.get(plan.pkgs, "lib").expect("lib")
  let through_mid =
    map.get(map.get(plan.pkgs, "mid").expect("mid").deps, "lib").expect("mid's lib")
  assert direct.root == "/p/lib/src"
  assert through_mid.root == "/p/lib/src"
}

test "a dependency's `..` after a link leaves the link's target" {
  # `home/app -> ../work/app`, and app's `lib = "../lib"` is `work/lib` to a
  # kernel. Folding `home/app/../lib` lexically gives `home/lib`, which is not
  # there; the plan has to land on the directory the kernel lands on.
  let app_toml = "schema = 1\nname = \"app\"\n\n[deps]\nlib = \"../lib\"\n"
  let app_src = "pub fn main() -> Unit !io = ()\n"
  var st = memfs.empty(memfs.BASE)
  st = memfs.put(st, "/w/work/app/dawn.toml", app_toml)
  st = memfs.put(st, "/w/work/app/src/main.dawn", app_src)
  st = memfs.put(st, "/w/work/lib/dawn.toml", "schema = 1\nname = \"lib\"\n")
  st = memfs.put(st, "/w/work/lib/src/util.dawn", "pub fn tag() -> Int = 1\n")
  st = mem_linked(st, "/w/home/app", "../work/app",
    [("dawn.toml", app_toml), ("src/main.dawn", app_src)])
  let plan = plan_in_table(st, ProjectDirectory("/w/home/app"))
  assert len(plan.diags) == 0
  assert map.get(plan.pkgs, "lib").expect("lib").root == "/w/work/lib/src"
  # the project keeps the spelling it was named by: a root is shown to the
  # user, and only identity is resolved
  assert plan.project == "/w/home/app"
}

test "canon_identity resolves what exists and spells the rest lexically" {
  var st = memfs.empty(memfs.BASE)
  st = memfs.put(st, "/w/work/app/src/main.dawn", "")
  st = memfs.put(st, "/w/work/lib/src/util.dawn", "")
  st = memfs.link(st, "/w/home/app", "../work/app")
  let ((got, log), _) = memfs.with_fs(st, () =>
      envmem.with_env_table("/w/home", [], () => [
        canon_identity("/w/home/app/src/main.dawn"),
        # `..` after the link leaves its target: lexically this is `/w/home/lib`
        canon_identity("/w/home/app/../lib"),
        canon_identity("app/src"),
        # nothing there: the lexical spelling, `..` folded as written
        canon_identity("/w/home/app/../missing/x.dawn"),
        canon_identity("missing/../y")
      ]))
  assert got == [
    "/w/work/app/src/main.dawn",
    "/w/work/lib",
    "/w/work/app/src",
    "/w/home/missing/x.dawn",
    "/w/home/y"
  ]
  # one working-directory read per relative path, the fallback included
  assert log == [envmem.AskedCwd, envmem.AskedCwd]
}

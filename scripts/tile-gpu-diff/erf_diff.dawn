# Layer 2 for the error function kernels (knife 15), the eleventh of these
# programs after vadd_diff, mask_diff, red_diff, mm_diff, stride_diff,
# int_diff, wide_diff, gath_diff, scan_diff and atom_diff: one `!Gpu`
# program runs each of the two kernels scripts/tile-golden pins under
# `with_gpu_real` against the machine's GPU and under `with_gpu_fake`
# against hand-written host references, and prints what each device
# answered.
#
#   erf_diff [--corpus positive] <erf_sweep.cubin> <geglu.cubin>
#
# What is new here and nowhere else: the kernel computes something the
# DIALECT DOES NOT HAVE. Every other kernel in this tree spells an
# operation the device performs; `tileir/dev.erf` is Abramowitz-Stegun
# 7.1.26, a rational function of `exp` that approximates the error function
# to 1.5e-7, because Tile IR has no `erf` among its hundred operations and
# leetgpu 65 is stated in terms of one.
#
# THE TIER: both kernels are TOLERANCE and cannot be anything else. That is
# not a property of the device this time, it is a property of the
# composition: 7.1.26 is an approximation with a published error bound, and
# the bound is what puts it inside leetgpu's `atol = 1e-5`. So the host
# reference must NOT be the same rational. `std/gpu.ref_erf` is a series
# accurate to about 4e-15, which makes the difference this program reports
# the approximation's own error rather than a disagreement between two
# guesses at the same thing. The `error` line prints that difference; it is
# the measurement the doc comment's 1.5e-7 claim is held to.
#
# THE CORPUS IS HALF THE CLAIM, and this program is where that is measured
# rather than asserted in prose:
#
#   * `--corpus main` carries lanes with `|x| > 4` (where both factors of
#     7.1.26 are near their limits: `t` goes to zero and `exp(-x^2)`
#     underflows), lanes with `x < 0` (which 7.1.26 does not cover at all --
#     the negative half is the odd symmetry `erf(-x) = -erf(x)`, one
#     `select` on the sign) and lanes near zero. The `index` line counts all
#     three and scripts/tile-gpu-diff/run.sh holds each above zero.
#   * `--corpus positive` is the same kernels on the absolute value of the
#     same corpus: every lane non-negative, so the sign `select` never
#     chooses its negated arm. run.sh runs the mutant that DROPS the flip
#     against it as the CONTROL: it must stay green there, which is what
#     says the negative lanes and not something else are what make it bite.
#     The tanh mutant must red on both, because a wrong approximation is
#     wrong on either half.
use std/io
use std/io.{Exit, with_fs_real}
use std/gpu
use std/gpu.{Gpu, with_gpu_fake, with_gpu_real, WideRefFn, last_out, erf_sweep_ref, geglu_ref}
use std/list
use std/map

## The sentinel every output buffer holds before a launch: a value no
## kernel here computes, so a lane that still has it is a lane nothing
## wrote.
pub const SENTINEL: Float = 0.0 - 12345.678

## leetgpu's own agreement criterion, and the tolerance tier's. leetgpu 65
## itself compares under 1e-4; this is the stricter number the rest of this
## tree uses, and 7.1.26 is inside it.
pub const ATOL: Float = 1.0e-5
pub const RTOL: Float = 1.0e-5

## The shapes the kernels were recorded with. These must agree with
## scripts/tile-golden/kernels.dawn.
pub const ERF_N: Int = 500
pub const ERF_TILE: Int = 128
pub const GEGLU_HALF: Int = 300
pub const GEGLU_TILE: Int = 128

type Trace = {
  alloc: String,
  upload: String,
  launch: String,
  sync: String,
  download: String,
  result: Option[List[Float]],
  note: String
}

fn kind[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> "ok"
  Err(e) -> e.kind
}

fn message[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> ""
  Err(e) -> e.message
}

fn blank() -> Trace =
  Trace { alloc: "-", upload: "-", launch: "-", sync: "-", download: "-", result: None, note: "" }

# Allocate and fill one buffer per (format, contents) pair, in order.
# Written as recursion rather than a `for` with `?` in it, for the reason
# gath_diff gives (dawn-lang issue #68).
fn alloc_all(bufs: List[(String, List[Float])], i: Int, acc: List[Int]) -> Result[List[Int], ForeignError] !Gpu =
  if i >= len(bufs) {
    Ok(acc)
  } else {
    let (dt, data) = bufs[i]
    match gpu.gpu_alloc(dt, len(data)) {
      Ok(h) -> alloc_all(bufs, i + 1, acc ++ [h])
      Err(e) -> Err(e)
    }
  }

fn upload_all(hs: List[Int], bufs: List[(String, List[Float])], i: Int) -> Result[Unit, ForeignError] !Gpu =
  if i >= len(hs) {
    Ok(())
  } else {
    let (_dt, data) = bufs[i]
    match gpu.gpu_upload(hs[i], data) {
      Ok(_) -> upload_all(hs, bufs, i + 1)
      Err(e) -> Err(e)
    }
  }

fn release(hs: List[Int]) -> Unit !Gpu = {
  for h in hs {
    let _ = gpu.gpu_free(h)
  }
}

## One kernel over `bufs` (each a format and its initial contents) on a
## `gx` by 1 by 1 grid, one stage at a time, stopping at the first refusal
## and saying which stage it was. The LAST buffer is the output, and the
## one this reads back.
fn stages(kernel: String, gx: Int, bufs: List[(String, List[Float])]) -> Trace !Gpu =
  match alloc_all(bufs, 0, []) {
    Err(e) -> Trace { ..blank(), alloc: e.kind, note: e.message }
    Ok(hs) -> {
      let t0 = Trace { ..blank(), alloc: "ok" }
      match upload_all(hs, bufs, 0) {
        Err(e) -> {
          release(hs)
          Trace { ..t0, upload: e.kind, note: e.message }
        }
        Ok(_) -> {
          let t1 = Trace { ..t0, upload: "ok" }
          match gpu.gpu_launch(kernel, gx, 1, 1, hs) {
            Err(e) -> {
              release(hs)
              Trace { ..t1, launch: e.kind, note: e.message }
            }
            Ok(_) -> {
              let s = gpu.gpu_sync()
              let r = gpu.gpu_download(hs[len(hs) - 1])
              release(hs)
              let value = match r {
                Ok(v) -> Some(v)
                Err(_) -> None
              }
              Trace {
                ..t1,
                launch: "ok",
                sync: kind(s),
                download: kind(r),
                result: value,
                note: message(s) ++ message(r)
              }
            }
          }
        }
      }
    }
  }

## Where the real device stopped, as `<kind>@<stage>`, or "" if it did not.
fn stopped(t: Trace) -> String =
  if t.alloc != "ok" {
    t.alloc ++ "@alloc"
  } else if t.upload != "ok" {
    t.upload ++ "@upload"
  } else if t.launch != "ok" {
    t.launch ++ "@launch"
  } else if t.sync != "ok" {
    t.sync ++ "@sync"
  } else if t.download != "ok" {
    t.download ++ "@download"
  } else {
    ""
  }

# ---- the tier ----

## Whether `got` is within the tolerance tier's distance of `want`, by
## leetgpu's own criterion. A NaN on either side is never within: two NaNs
## are not agreement, they are two failures.
pub fn within(got: Float, want: Float) -> Bool =
  if got != got || want != want {
    false
  } else if got == want {
    true
  } else if got - got != 0.0 || want - want != 0.0 {
    false
  } else {
    let d = if got > want { got - want } else { want - got }
    let m = if want > 0.0 { want } else { 0.0 - want }
    d <= ATOL + RTOL * m
  }

fn all_within(got: List[Float], want: List[Float]) -> Bool =
  len(got) == len(want) && list.all(range(0, len(want)), i => within(got[i], want[i]))

## The largest miss as the tolerance criterion measures it: 1.0 is exactly
## the tolerance, 0.0 is bit-identical.
fn scaled_miss(got: List[Float], want: List[Float]) -> Float =
  list.fold(range(0, len(want)), 0.0, (acc, i) => {
    let a = got[i]
    let b = want[i]
    let d = if a > b { a - b } else { b - a }
    let m = if b > 0.0 { b } else { 0.0 - b }
    let s = d / (ATOL + RTOL * m)
    if s > acc { s } else { acc }
  })

## The largest ABSOLUTE difference between the device's answer and the
## reference's. On `erf_sweep` this number is 7.1.26's error, because
## nothing is multiplied on top of it and the reference is accurate to
## 4e-15.
fn abs_miss(got: List[Float], want: List[Float]) -> Float =
  list.fold(range(0, len(want)), 0.0, (acc, i) => {
    let d = if got[i] > want[i] { got[i] - want[i] } else { want[i] - got[i] }
    if d > acc { d } else { acc }
  })

fn pair(real: Trace, fake: Trace) -> Option[(List[Float], List[Float])] =
  match (real.result, fake.result) {
    (Some(a), Some(b)) -> if len(a) == len(b) { Some((a, b)) } else { None }
    _ -> None
  }

fn miss_line(real: Trace, fake: Trace) -> String = match pair(real, fake) {
  Some((a, b)) -> "${scaled_miss(a, b)} (1.0 is exactly the tolerance atol=${ATOL} rtol=${RTOL})"
  None -> "-"
}

fn error_of(real: Trace, fake: Trace) -> Float = match pair(real, fake) {
  Some((a, b)) -> abs_miss(a, b)
  None -> 0.0 / 0.0
}

fn rendered(o: Option[List[Float]]) -> String = match o {
  Some(v) -> to_string(v)
  None -> "-"
}

## The verdict for one kernel: `close:tolerance` where the two agree within
## atol/rtol, `identical:tolerance` where they happen to agree bit for bit
## as well (worth seeing, and not expected here: the device runs a rational
## and the reference runs a series), `differ:result`, or `blocked:..`.
fn verdict(fake: Trace, real: Trace) -> String = {
  let stop = stopped(real)
  if stop != "" {
    "blocked:" ++ stop
  } else if rendered(real.result) == rendered(fake.result) {
    "identical:tolerance"
  } else {
    match pair(real, fake) {
      Some((a, b)) -> if all_within(a, b) { "close:tolerance" } else { "differ:result" }
      None -> "differ:result"
    }
  }
}

# ---- the corpora ----

fn sentinel_buffer(n: Int) -> List[Float] = list.map(range(0, n), _i => SENTINEL)

fn positive(xs: List[Float], on: Bool) -> List[Float] =
  if on { list.map(xs, x => if x < 0.0 { 0.0 - x } else { x }) } else { xs }

## The sweep: `(i - 250) * 0.06`, which runs from -15 to 14.94 in even
## steps through exact zero. Even steps rather than a scattered corpus
## because every claim here is about a smooth function of one argument, and
## a sweep is the corpus a reader can check the counts of by arithmetic.
fn sweep_values() -> List[Float] =
  list.map(range(0, ERF_N), i => to_float(i - 250) * 0.06)

## The gate's input: the values to gate first, then the gates, which is
## leetgpu 65's `input.chunk(2)`. The gates sweep -7.5 to 7.45, so their
## `x / sqrt(2)` reaches past 5; the multipliers cycle through seven values
## of both signs and are small, so a lane's error is the gate's error and
## not a large number's.
fn geglu_values() -> List[Float] =
  list.map(range(0, GEGLU_HALF), j => 1.25 - to_float(j % 7) * 0.5)
  ++ list.map(range(0, GEGLU_HALF), j => to_float(j - 150) * 0.05)

## The lanes of a corpus that matter to 7.1.26, counted: how many are
## negative (the odd symmetry's half, and the only thing the sign `select`
## is for), how many are past `|x| = 4` (the tail, where `t` goes to zero
## and `exp(-x^2)` underflows) and how many are inside `|x| = 0.5`.
## run.sh holds all three above zero on the main corpus and the first at
## zero on the control.
fn shape_of(xs: List[Float]) -> String = {
  let neg = list.filter(xs, x => x < 0.0)
  let tail = list.filter(xs, x => x > 4.0 || x < 0.0 - 4.0)
  let near = list.filter(xs, x => x < 0.5 && x > 0.0 - 0.5)
  "lanes=${len(xs)} negative=${len(neg)} tail=${len(tail)} near_zero=${len(near)}"
}

# ---- the cases ----

## The kernels this program runs, in the order their cubins are given.
fn case_name(i: Int) -> String = ["erf_sweep", "geglu"][i]

## Both kernels are tolerance tier, and by construction rather than by
## corpus: 7.1.26 is an approximation.
##
## scripts/leetgpu-diff/check.py READS THIS LIST and holds the `tier`
## column of scripts/leetgpu-diff/problems.txt against it.
pub fn tolerance_tier() -> List[String] = ["erf_sweep", "geglu"]

fn case_grid(i: Int) -> Int =
  if case_name(i) == "erf_sweep" { ERF_N / ERF_TILE + 1 } else { GEGLU_HALF / GEGLU_TILE + 1 }

## The arguments the erf-shaped lanes of each case are: the sweep itself
## for `erf_sweep`, and the gate half for `geglu` (scaled by `1/sqrt(2)`
## before it reaches the composition, which is why the tail count below is
## the count of what 7.1.26 actually sees).
fn case_argument(i: Int, pos: Bool) -> List[Float] =
  if case_name(i) == "erf_sweep" {
    positive(sweep_values(), pos)
  } else {
    list.map(list.drop(positive(geglu_values(), pos), GEGLU_HALF), x => x * gpu.INV_SQRT2)
  }

## The buffers each kernel is handed: a FORMAT and the initial contents, in
## argument order. Every output buffer is LONGER than the answer, so the
## sentinel in its tail says whether a write went past the end.
fn case_bufs(i: Int, pos: Bool) -> List[(String, List[Float])] =
  if case_name(i) == "erf_sweep" {
    [("f64", positive(sweep_values(), pos)), ("f64", sentinel_buffer(ERF_N + 8))]
  } else {
    [("f64", positive(geglu_values(), pos)), ("f64", sentinel_buffer(GEGLU_HALF + 8))]
  }

## The reference table the fake device answers with, for one case.
fn case_kernels(i: Int) -> Map[String, (Int, WideRefFn)] =
  if case_name(i) == "erf_sweep" {
    map.from([("erf_sweep", (2, last_out((dts, ins) => erf_sweep_ref(ERF_N, dts, ins))))])
  } else {
    map.from([("geglu", (2, last_out((dts, ins) => geglu_ref(GEGLU_HALF, dts, ins))))])
  }

## A vector as a line: its length, its first lanes and its last ones.
fn digest(v: List[Float]) -> String =
  if len(v) <= 8 {
    to_string(v)
  } else {
    "len=${len(v)} head=${to_string(list.take(v, 3))} tail=${to_string(list.drop(v, len(v) - 3))}"
  }

fn shown(o: Option[List[Float]]) -> String = match o {
  Some(v) -> digest(v)
  None -> "-"
}

fn buffers_of(i: Int, pos: Bool) -> String = {
  let bufs = case_bufs(i, pos)
  list.fold(bufs, "", (acc, b) => {
    let (dt, data) = b
    let sep = if acc == "" { "" } else { "," }
    acc ++ sep ++ dt ++ "[" ++ to_string(len(data)) ++ "]"
  })
}

fn read_cubin(path: String) -> Bytes !Exit !io = match with_fs_real(() => io.read_bytes(path)) {
  Ok(b) -> b
  Err(e) -> {
    io.eprintln("erf_diff: cannot read ${path}: ${e.message}")
    io.exit(2)
    bytes_of_nothing()
  }
}

fn usage() -> Unit !Exit !io = {
  io.eprintln("usage: erf_diff [--corpus positive] <erf_sweep.cubin> <geglu.cubin>")
  io.exit(2)
}

# `io.exit` needs a handler above it now, and this program is the only
# frame with nothing above it. `Fs` stays where it was, installed per read.
pub fn main() -> Unit !io = io.with_exit_real(() => {
    let argv = args()
    let count = 2
    let pos = len(argv) == count + 2 && argv[0] == "--corpus" && argv[1] == "positive"
    let paths = if pos { list.drop(argv, 2) } else { argv }
    if len(paths) != count { usage() } else { () }
    var cubins: Map[String, Bytes] = map.empty()
    for i in range(0, count) {
      cubins = map.insert(cubins, case_name(i), read_cubin(paths[i]))
    }
    var all_agreed = true
    var blocked = ""
    var any_differ = false
    var tolerance_count = 0
    var errors = ""
    for i in range(0, count) {
      let name = case_name(i)
      let bufs = case_bufs(i, pos)
      let gx = case_grid(i)
      let refs = case_kernels(i)
      let fake = with_gpu_fake(refs, () => stages(name, gx, bufs))
      let real = with_gpu_real(cubins, () => stages(name, gx, bufs))
      let v = verdict(fake, real)
      io.println("kernel ${name} tier=tolerance bufs=${buffers_of(i, pos)} grid=(${gx}, 1, 1)")
      io.println("  index corpus=${if pos { "positive" } else { "main" }} ${shape_of(case_argument(i, pos))}")
      io.println("  fake  launch=${fake.launch} result=${shown(fake.result)}")
      io.println("  real  alloc=${real.alloc} upload=${real.upload} launch=${real.launch}"
          ++ " sync=${real.sync} download=${real.download} result=${shown(real.result)}")
      io.println("  miss  ${miss_line(real, fake)}")
      io.println("  error max|device - reference| = ${error_of(real, fake)}")
      if real.note != "" { io.println("  note  ${real.note}") } else { () }
      io.println("  verdict ${v}")
      if stopped(real) == "" {
        let sep = if errors == "" { "" } else { " " }
        errors = errors ++ sep ++ name ++ "=" ++ to_string(error_of(real, fake))
      } else {
        ()
      }
      if v == "close:tolerance" || v == "identical:tolerance" {
        tolerance_count = tolerance_count + 1
      } else {
        ()
      }
      if v != "close:tolerance" && v != "identical:tolerance" { all_agreed = false } else { () }
      if v == "differ:result" { any_differ = true } else { () }
      if blocked == "" && not any_differ && v != "close:tolerance" && v != "identical:tolerance" {
        blocked = v
      } else {
        ()
      }
    }
    # The measurement, recorded and not asserted: what Abramowitz-Stegun
    # 7.1.26 costs on this device, on this corpus. Its claimed bound is
    # 1.5e-7 and run.sh holds the sweep's number under it.
    io.println("probe as-error ${errors}")
    io.println("tiers exact=0 tolerance=${tolerance_count}")
    if all_agreed {
      io.println("tile-gpu-diff: pass")
    } else if any_differ {
      io.println("tile-gpu-diff: fail")
      io.exit(1)
    } else {
      io.println("tile-gpu-diff: ${blocked}")
    }
})

# `io.exit` is typed Unit, so the branch that cannot continue still owes a
# Bytes; this is never reached.
fn bytes_of_nothing() -> Bytes = panic("unreachable: exit did not exit")

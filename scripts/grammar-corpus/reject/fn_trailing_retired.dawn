# expect: the `fn` trailing-closure spelling has retired
# expect: the `fn` trailing-closure spelling has retired
# expect: the `fn` trailing-closure spelling has retired
# The retired spelling is recognized at the postfix decision so all three old
# forms teach the tail-block replacement instead of cascading at `(` or `=>`.
fn call_form(xs: List[Int]) -> Unit = map(xs) fn(x) => x
fn bare_name_form() -> Unit = twice fn(x) => x
fn method_form(xs: List[Int]) -> Unit = xs.each fn(x) => x

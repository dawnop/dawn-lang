# Bodies leave more than a typed tree: inferred signatures and lazy aliases
# write module-visible tables, while type bounds accumulate across bodies.
# Function entry resets dictionaries, so they belong to the final frame.
# Save keyed changes, not two complete checker contexts. Admission of
# dependencies and relocation are separate from capturing these writes.
use std/map
use std/list
use std/set
use check/cx.{Cx, Frame, cx_new, slot_of, slots_of, installed_slots, with_slots, write_symbol, write_signature, write_alias, write_bounds}
use check/types.{Sig, Sym, Ty, Eff, CtorI, FieldI, EffectI, AWorld, TyInt, TyUnit, TyVar, TyAdt, TyList, TyAssoc, TyFn, EPure, EffVar, EUnion, ELabeled, BuiltinTypeI, BtStdOnly, BtLeaf}
use check/tast.{TFun, TConst, XUnit, XLocal, XInt, XCallBuiltin}
use front/token.{Diag, DiagOwner}
use front/ast.{TypeRef, TNamed}
use check/body_admit
use check/body_admit.{View}
use check/evidence_spelling
use check/semantic_reads
use check/write_journal
use check/jsig.{JClass, JMethod, JCtor, JField}
use check/semantic_reads.{UnificationRead, InferenceBindings, FunctionRead, NamedFunctionRead, FunctionAnswer, FunctionCandidates, QualifiedConstant, QualifiedConstructor,
  AliasTypeHeader, ConstructorHeader, QualifiedAliasHeader, QualifiedAliasTarget, NominalTypeName, NominalTypeShape, LocalTypeDiagnostic, ExportDiagnostic, LocalAliasSource,
  LocalAliasTarget, LocalAliasResolving, LocalAliasHeader, LocalAliasBinders }

pub type Change[K, V] = { key: K, value: Option[V] }

pub fn changes[K: Eq + Hash, V](before: Map[K, V], after: Map[K, V], same: fn(V, V) -> Bool) -> List[Change[K, V]] = {
  var out: List[Change[K, V]] = []
  for (key, value) in map.entries(after) {
    let equal = match map.get(before, key) {
      Some(old) -> same(old, value)
      None -> false
    }
    if not equal { out = out ++ [Change { key: key, value: Some(value) }] }
  }
  for key in map.keys(before) {
    let missing: Option[V] = None
    if not map.has(after, key) { out = out ++ [Change { key: key, value: missing }] }
  }
  out
}

pub fn apply_changes[K: Eq + Hash, V](current: Map[K, V], writes: List[Change[K, V]]) -> Map[K, V] = {
  var out = current
  for w in writes {
    out = match w.value {
      Some(value) -> map.insert(out, w.key, value)
      None -> map.remove(out, w.key)
    }
  }
  out
}

## This is still in the producing revision's ID and source coordinate space.
## Never install it in another revision before projecting every reference.
pub type BodyProduct[T] = {
  tree: T,
  # The declaration this body was checked inside, and how many bindings that
  # declaration had minted when it was done. The pair this replaced -- where
  # the body's allocations started and how many it made -- was a coordinate
  # in one module-wide counter, which is why installing a product used to ask
  # the installing context where its counter stood. This pair names the
  # declaration instead, so it means the same thing in any revision that
  # still has that declaration, and installing it is one row put back.
  owner_decl: Int,
  owner_slots: Int,
  symbols: List[Change[Int, Sym]],
  signatures: List[Change[String, Sig]],
  aliases: List[Change[String, Ty]],
  bounds: List[Change[Int, List[Int]]],
  diagnostics: List[Diag],
  frame: Frame,
  tparams: Map[String, Ty],
  effect_vars: Map[String, Eff],
  loop_jumps: Set[Int],
  in_test: Bool,
  const_cutoff: Option[Set[String]],
  take_cell: Option[Int],
  function_reads: Option[List[FunctionRead]],
  body_writes: Option[List[write_journal.Key]]
}

pub alias Product = BodyProduct[TFun]
pub alias ConstantProduct = BodyProduct[TConst]

# The Java oracle is a capability, not an equality-comparable value. Capture
# and replay belong to one owner/lease; that invariant is held by the caller.
# Every other Cx field not recorded above must remain unchanged. A body may
# fill alias_resolved, but must not leave alias resolution in flight.
# Map equality ordinarily materializes insertion-ordered entries, including a
# sort. Environment admission needs membership, not order. Walking the trie
# preserves the same cardinality/key/value proof without that allocation and
# sorting cost. Strict capture still uses the independent standard Eq path.
fn environment_map_same[K: Eq + Hash, V: Eq](a: Map[K, V], b: Map[K, V], tracked: Bool) -> Bool =
  if not tracked { a == b } else {
    map.len(a) == map.len(b) && map.fold(a, true, (same, key, value) =>
        same && match map.get(b, key) { Some(other) -> value == other, None -> false })
  }

fn environment_unchanged(a: Cx, b: Cx, tracked: Bool) -> Bool =
  environment_map_same(a.identities, b.identities, tracked) &&
  environment_map_same(a.adts, b.adts, tracked) && environment_map_same(a.traits, b.traits, tracked) && environment_map_same(a.fn_origin, b.fn_origin, tracked) &&
  environment_map_same(a.std_fns, b.std_fns, tracked) && environment_map_same(a.bins, b.bins, tracked) && a.hidden_bins == b.hidden_bins &&
  environment_map_same(a.btypes, b.btypes, tracked) && environment_map_same(a.adts_by_name, b.adts_by_name, tracked) && environment_map_same(a.aliases, b.aliases, tracked) &&
  a.alias_resolving == b.alias_resolving && environment_map_same(a.ctors_by_name, b.ctors_by_name, tracked) &&
  environment_map_same(a.traits_by_name, b.traits_by_name, tracked) && a.local_traits == b.local_traits &&
  a.local_impls == b.local_impls && a.observable_impls == b.observable_impls &&
  environment_map_same(a.impl_table, b.impl_table, tracked) && environment_map_same(a.module_aliases, b.module_aliases, tracked) &&
  environment_map_same(a.module_fn_sigs, b.module_fn_sigs, tracked) && environment_map_same(a.imported_names, b.imported_names, tracked) &&
  environment_map_same(a.import_renames, b.import_renames, tracked) &&
  environment_map_same(a.consts, b.consts, tracked) && a.const_order == b.const_order && a.all_const_names == b.all_const_names &&
  environment_map_same(a.java_classes, b.java_classes, tracked) && environment_map_same(a.effects, b.effects, tracked) && environment_map_same(a.effect_infos, b.effect_infos, tracked) &&
  a.is_std_module == b.is_std_module && a.owner_class == b.owner_class &&
  a.mod_path == b.mod_path && a.owner == b.owner && a.owner_lo == b.owner_lo &&
  a.src_path == b.src_path && a.line_starts == b.line_starts && environment_map_same(a.moved, b.moved, tracked) &&
  environment_map_same(a.module_exports, b.module_exports, tracked) && environment_map_same(a.ty_spans, b.ty_spans, tracked) && a.record_ty_spans == b.record_ty_spans &&
  a.owner_decl == b.owner_decl

## Top-level function/default/method bodies finish their nested frames. This
## boundary is not an independently cached expression or suspended lambda.
pub fn capture(before: Cx, after: Cx, function: TFun) -> Option[Product] = {
  capture_body(before, after, function)
}

pub fn capture_constant(before: Cx, after: Cx, constant: TConst) -> Option[ConstantProduct] = {
  capture_body(before, after, constant)
}

fn capture_body[T](before: Cx, after: Cx, tree: T) -> Option[BodyProduct[T]] = {
  capture_with_mode(before, after, tree, false)
}

## Only the instrumented canonical body producer may use touched-key capture.
## The strict extractor above remains an independent completeness oracle.
pub fn capture_journaled(before: Cx, after: Cx, tree: TFun) -> Option[Product] =
  capture_with_mode(before, after, tree, true)

pub fn capture_constant_journaled(before: Cx, after: Cx, tree: TConst) -> Option[ConstantProduct] =
  capture_with_mode(before, after, tree, true)

fn touched_changes[K: Eq + Hash, V](before: Map[K, V], after: Map[K, V], keys: List[K],
  same: fn(V, V) -> Bool) -> Option[List[Change[K, V]]] = {
  var seen: Set[K] = set.empty()
  var out: List[Change[K, V]] = []
  var removed: List[Change[K, V]] = []
  var expected_size = map.len(before)
  for key in keys {
    if not set.has(seen, key) {
      seen = set.insert(seen, key)
      let old = map.get(before, key)
      let next = map.get(after, key)
      match (old, next) {
        (Some(a), Some(b)) -> if not same(a, b) { out = out ++ [Change { key: key, value: Some(b) }] }
        (None, Some(b)) -> {
          expected_size = expected_size + 1
          out = out ++ [Change { key: key, value: Some(b) }]
        }
        (Some(_), None) -> {
          expected_size = expected_size - 1
          let absent: Option[V] = None
          removed = removed ++ [Change { key: key, value: absent }]
        }
        (None, None) -> ()
      }
    }
  }
  if expected_size != map.len(after) { return None }
  Some(out ++ removed)
}

fn capture_with_mode[T](before: Cx, after: Cx, tree: T, tracked: Bool) -> Option[BodyProduct[T]] = {
  if not environment_unchanged(before, after, tracked) { return None }
  capture_transition(before, after, tree, tracked)
}

# Only strict capture or this module's own assembly may enter this remainder.
# Assembly preserves every environment field by construction, not by a log
# claiming that an arbitrary callback left those fields untouched.
fn capture_transition[T](before: Cx, after: Cx, tree: T, tracked: Bool) -> Option[BodyProduct[T]] = {
  # A body mints inside the declaration it was entered for and inside no
  # other, so a transition that reissued slots it had already handed out is
  # not one body. Which declaration it is, is `environment_unchanged`'s.
  if slot_of(after) < slot_of(before) { return None }
  if len(after.frame.lambda_stack) != 0 || len(after.frame.loop_stack) != 0 { return None }
  if len(after.diags) < len(before.diags) || list.take(after.diags, len(before.diags)) != before.diags { return None }
  let journal = write_journal.capture(before.body_writes, after.body_writes)?
  let (symbols, signatures, aliases, bounds) = if tracked {
    let keys = journal?
    var symbols: List[Int] = []
    var signatures: List[String] = []
    var aliases: List[String] = []
    var bounds: List[Int] = []
    for key in keys {
      match key {
        write_journal.SymbolKey(id) -> { symbols = symbols ++ [id] }
        write_journal.SignatureKey(name) -> { signatures = signatures ++ [name] }
        write_journal.AliasKey(name) -> { aliases = aliases ++ [name] }
        write_journal.BoundsKey(id) -> { bounds = bounds ++ [id] }
      }
    }
    (touched_changes(before.syms, after.syms, symbols, (a, b) => a == b)?,
      touched_changes(before.fns, after.fns, signatures, (a, b) => a == b)?,
      touched_changes(before.alias_resolved, after.alias_resolved, aliases, (a, b) => a == b)?,
      touched_changes(before.current_tparam_bounds, after.current_tparam_bounds, bounds, (a, b) => a == b)?)
  } else {
    (changes(before.syms, after.syms, (a, b) => a == b), changes(before.fns, after.fns, (a, b) => a == b),
      changes(before.alias_resolved, after.alias_resolved, (a, b) => a == b),
      changes(before.current_tparam_bounds, after.current_tparam_bounds, (a, b) => a == b))
  }
  Some(BodyProduct {
    tree: tree, owner_decl: after.owner_decl, owner_slots: slot_of(after),
    symbols: symbols, signatures: signatures, aliases: aliases, bounds: bounds,
    diagnostics: list.drop(after.diags, len(before.diags)),
    frame: after.frame,
    tparams: after.current_tparams, effect_vars: after.current_eff_vars,
    loop_jumps: after.loop_jumps, in_test: after.in_test,
    const_cutoff: after.const_cutoff, take_cell: after.take_cell,
    function_reads: semantic_reads.capture(before.function_reads, after.function_reads)?,
    body_writes: journal
  })
}

## Assembly for a dependency-validated input. This API does not validate
## reads and cannot be used as a cache-validity predicate.
##
## It no longer asks the installing context where its allocations had reached,
## because there is no longer a coordinate for them to agree on. The change
## list is self-describing: each key names the declaration that bound it, so
## installing a product in a revision that still has that declaration puts
## every row back where it belongs, and a revision that does not have it
## failed admission long before this.
pub fn assemble[T](current: Cx, product: BodyProduct[T]) -> Option[Cx] = {
  if slots_of(current, product.owner_decl) > product.owner_slots { return None }
  Some(Cx {
    ..current,
    decl_slots: installed_slots(current, product.owner_decl, product.owner_slots),
    syms: apply_changes(current.syms, product.symbols),
    fns: apply_changes(current.fns, product.signatures),
    alias_resolved: apply_changes(current.alias_resolved, product.aliases),
    current_tparam_bounds: apply_changes(current.current_tparam_bounds, product.bounds),
    frame: product.frame,
    diags: current.diags ++ product.diagnostics,
    current_tparams: product.tparams, current_eff_vars: product.effect_vars,
    loop_jumps: product.loop_jumps, in_test: product.in_test,
    const_cutoff: product.const_cutoff, take_cell: product.take_cell,
    function_reads: semantic_reads.append(current.function_reads, product.function_reads)?,
    body_writes: write_journal.append(current.body_writes, product.body_writes)?
  })
}

type InstallationData = { cx: Cx, tree: TFun, captured: Option[Product] }
pub opaque type Installation = InstallationData

## The recording owner must supply its actual scheduler input here. Neither
## an old input nor a separately supplied output can certify a transition.
## Capture refusal retains successful assembly; it is not a cold-check request.
pub fn assemble_captured(current: Cx, product: Product) -> Option[Installation] = {
  let after = assemble(current, product)?
  Some(InstallationData { cx: after, tree: product.tree,
    captured: capture_transition(current, after, product.tree, true) })
}

pub fn installation_output(value: Installation) -> (Cx, TFun, Option[Product]) = {
  let data: InstallationData = value
  (data.cx, data.tree, data.captured)
}

fn projected_changes[K, V, L, W](writes: List[Change[K, V]], key: fn(K) -> Option[L],
  value: fn(V) -> Option[W]) -> Option[List[Change[L, W]]] = {
  var out: List[Change[L, W]] = []
  for w in writes {
    let next = match w.value {
      Some(v) -> Some(value(v)?)
      None -> None
    }
    out = out ++ [Change { key: key(w.key)?, value: next }]
  }
  Some(out)
}

## A symbol's declaring span is an offset from the declaration that minted it,
## the same currency the tree that reads the symbol is in, so only its
## identity moves here.
fn projected_symbol(v: View, s: Sym) -> Option[Sym] = evidence_spelling.checked_symbol(s)

fn projected_frame(v: View, f: Frame) -> Option[Frame] = {
  if len(f.lambda_stack) != 0 || len(f.loop_stack) != 0 { return None }
  var scopes: List[Map[String, Int]] = []
  for scope in f.scopes {
    var next: Map[String, Int] = map.empty()
    for (name, id) in map.entries(scope) {
      let old = map.get(v.symbols, id)?
      if old.name != name { return None }
      let symbol = evidence_spelling.checked_symbol(old)?
      if map.has(next, symbol.name) { return None }
      next = map.insert(next, symbol.name, id)
    }
    scopes = scopes ++ [next]
  }
  var used: List[Eff] = []
  for e in f.used_effects { used = used ++ [e] }
  var witnesses: Map[Eff, (Int, Int, String)] = map.empty()
  for (e, span) in map.entries(f.eff_witness) {
    let moved = e
    if map.has(witnesses, moved) { return None }
    # The witness span is an offset from the declaration that recorded it,
    # like everything else a body records, so only the effect it is keyed by
    # moves here. `cx.eff_witness_at` is where a diagnostic site turns it back
    # into a position.
    witnesses = map.insert(witnesses, moved, span)
  }
  let signature = f.current_sig
  var dictionaries: Map[(Int, Int), Int] = map.empty()
  for (key, id) in map.entries(f.dict_syms) {
    let (tv, tr) = key
    let next = (tv, tr)
    if map.has(dictionaries, next) { return None }
    dictionaries = map.insert(dictionaries, next, id)
  }
  Some(Frame { ..f, scopes: scopes, used_effects: used, eff_witness: witnesses,
    current_sig: signature, dict_syms: dictionaries })
}

## Carry one body's product onto a candidate revision. What used to be an
## interval landing on a coordinate is now nothing at all in the binder
## domains: a key names its declaration, so it is the same key in both
## revisions, and what this still does is the source projection and the
## admission refusals that go with it.
pub fn project(v: View, p: Product) -> Option[Product] = {
  project_with_source(v, p, (owner, source) => None)
}

## The read log in the candidate's coordinates, on its own. Revalidation does
## not need it: it compares the recorded log in place. A caller that installs
## the log asks for it here.
##
## A fact is carried whole, because every domain it names is the same integer
## in both revisions. The one thing that moves is the source node an alias
## read carries, which belongs to another declaration's file and is the
## caller's to supply.
pub fn projected_reads[T](v: View, p: BodyProduct[T],
  source_value: fn(String, TypeRef) -> Option[TypeRef]) -> Option[Option[List[FunctionRead]]] =
  semantic_reads.project(p.function_reads, source_value)

## `project` for a caller that revalidates the recorded log in place and does
## not install the projected one. The product comes back with no log rather
## than a rebuilt one, which is the coordinate-free answer: every leaf the
## rebuild would map is mapped by the comparison, and both refuse on the same
## missing mapping, so skipping the rebuild admits nothing extra.
pub fn project_without_reads(v: View, p: Product) -> Option[Product] =
  project_body(v, p, tree => body_admit.function(v, tree), (owner, source) => None, false)

pub fn project_constant(v: View, p: ConstantProduct) -> Option[ConstantProduct] = {
  project_constant_with_source(v, p, (owner, source) => None)
}

pub fn project_with_source(v: View, p: Product,
  source_value: fn(String, TypeRef) -> Option[TypeRef]) -> Option[Product] = {
  project_body(v, p, tree => body_admit.function(v, tree), source_value, true)
}

pub fn project_constant_with_source(v: View, p: ConstantProduct,
  source_value: fn(String, TypeRef) -> Option[TypeRef]) -> Option[ConstantProduct] = {
  project_body(v, p, tree => body_admit.constant(v, tree), source_value, true)
}

fn project_body[T](v: View, p: BodyProduct[T],
  admit_tree: fn(T) -> Bool, source_value: fn(String, TypeRef) -> Option[TypeRef],
  keep_reads: Bool) -> Option[BodyProduct[T]] = {
  if not admit_tree(p.tree) { return None }
  let moved_symbols = projected_changes(p.symbols, id => Some(id), s => projected_symbol(v, s))?
  # The change list is put in key order rather than in the order the two
  # tables were walked. It used to be here because an evidence ABI
  # permutation could reverse the mapped keys; nothing permutes them now, but
  # the recorded order is still whatever `changes` saw when it compared two
  # maps, and a product should not carry that.
  let symbols = sort_by(moved_symbols, (a, b) => cmp(a.key, b.key))
  let signatures = projected_changes(p.signatures, name => Some(name), s => Some(s))?
  let aliases = projected_changes(p.aliases, name => Some(name), t => Some(t))?
  let bounds = projected_changes(p.bounds, id => Some(id), bs => Some(bs))?
  # Diagnostics travel whole. An owned one is measured from the declaration
  # that raised it and the render sites add that declaration's start in the
  # revision they render, so a declaration that moved needs nothing done to
  # them; admission requires the declaration's own text to be identical, so
  # there is nothing inside it that moved either.
  let diagnostics = p.diagnostics
  var tparams: Map[String, Ty] = map.empty()
  for (name, t) in map.entries(p.tparams) { tparams = map.insert(tparams, name, t) }
  var effect_vars: Map[String, Eff] = map.empty()
  for (name, e) in map.entries(p.effect_vars) { effect_vars = map.insert(effect_vars, name, e) }
  Some(BodyProduct { ..p,
    symbols: symbols, signatures: signatures, aliases: aliases, bounds: bounds, diagnostics: diagnostics,
    frame: projected_frame(v, p.frame)?, tparams: tparams, effect_vars: effect_vars,
    body_writes: write_journal.project(p.body_writes, id => Some(id), id => Some(id))?,
    function_reads: if keep_reads { projected_reads(v, p, source_value)? } else { None } })
}

test "body product keyed writes preserve unrelated preceding products" {
  let before = map.from([("old", 1), ("removed", 2)])
  let after = map.from([("old", 3), ("added", 4)])
  let writes = changes(before, after, (a, b) => a == b)
  assert apply_changes(before, writes) == after
  assert apply_changes(map.insert(before, "preceding", 5), writes) == map.insert(after, "preceding", 5)
  assert changes(before, before, (a, b) => a == b) == []
}

test "assembly certified capture matches strict transition and preserves refusal" {
  let before = Cx { ..cx_new(Some("sample"), Some("sample.dawn")),
    function_reads: Some([]), body_writes: Some([]) }
  let tree = fixture_function(before)
  let product = capture_journaled(before, before, tree).expect("assembly capture fixture")
  let (after, installed, saved) = installation_output(assemble_captured(before, product).expect("assembly certified output"))
  assert installed == tree
  assert saved == capture_journaled(before, after, installed)
  assert saved == Some(product)
  # The caller may propose an unbalanced product, but successful installation
  # must not be confused with capture success or trigger another execution.
  let bad = BodyProduct { ..product, frame: Frame { ..product.frame, loop_stack: [1] } }
  let (bad_after, bad_tree, refused) = installation_output(assemble_captured(before, bad).expect("assembly refused capture output"))
  assert bad_after.frame.loop_stack == [1] && bad_tree == tree
  assert refused == None && capture_journaled(before, bad_after, bad_tree) == None
  # A no-op saved change normalizes against the real installation input.
  let symbol = Sym { name: "kept", ty: TyInt, mutable: false, dlo: 0, dhi: 0,
    dict_of: None, ev_of: None, cell_of: None }
  let current = Cx { ..before, syms: map.from([(10, symbol)]) }
  let noop = BodyProduct { ..product, symbols: [Change { key: 10, value: Some(symbol) }],
    body_writes: Some([write_journal.SymbolKey(10)]) }
  let (normalized, normalized_tree, normalized_saved) = installation_output(assemble_captured(current, noop).expect("assembly no-op change"))
  assert normalized_saved == capture_journaled(current, normalized, normalized_tree)
  assert normalized_saved.expect("assembly normalized capture").symbols == []
}

test "body product constants project their real tree and share state admission" {
  let before = Cx { ..cx_new(None, None), body_writes: Some([]) }
  let ty = TyVar("T", 1)
  let constant = TConst { name: "VALUE", ty: ty, init: XLocal(10, "x", 0, 1, ty), lo: 0, hi: 1 }
  let symbol = Sym { name: "x", ty: ty, mutable: false, dlo: 0, dhi: 1,
    dict_of: None, ev_of: None, cell_of: None }
  let after = Cx { ..before, decl_slots: map.insert(before.decl_slots, before.owner_decl, 1), syms: map.from([(10, symbol)]),
    body_writes: Some([write_journal.SymbolKey(10), write_journal.BoundsKey(1)]),
    current_tparams: map.from([("T", ty)]) }
  let saved = capture_constant(before, after, constant).expect("constant capture")
  let v = View { symbols: after.syms,
    callee: (owner, name, builtin, tr) => None }
  let moved = project_constant(v, saved).expect("constant projection")
  # every reference the constant names is the same integer in the candidate
  # revision: a binder is a slot of the declaration that binds it
  assert moved.body_writes == saved.body_writes
  assert moved.tree == constant
  # the tree is still projected rather than carried, which is what refuses a
  # recorded constant naming a binding this revision does not have
  assert project_constant(v, BodyProduct { ..saved,
    tree: TConst { ..constant, init: XLocal(11, "x", 0, 1, ty) } }) == None
  let assembled = assemble(before, moved).expect("constant state assembly")
  assert slots_of(assembled, before.owner_decl) == 1
  assert map.get(assembled.syms, 10).expect("constant symbol").ty == ty
  assert assembled.current_tparams == map.from([("T", ty)])
  assert capture_constant(before, Cx { ..after, owner_class: Some("foreign") }, constant) == None
}

fn fixture_function(cx: Cx) -> TFun = {
  let sig = Sig { name: "fixture", param_tys: [], param_names: [], param_defaults: [], ret: TyUnit,
    eff: EPure, is_builtin: false, tparams: [], constraints: [], eparams: [],
    owner: cx.owner_class, trait_id: None, op_of: None, inferring: false }
  TFun { name: "fixture", sig: sig, param_syms: [], dict_syms: [], ev_syms: [], defaults: [],
    body: XUnit(0, 1), is_test: false, impl_of: None, default_of: None }
}

test "body product separates alias declaration positions from body positions" {
  let before = Cx { ..cx_new(Some("consumer"), None), function_reads: Some([]) }
  let target = TNamed("Int", [], [], 0, 1)
  let after = Cx { ..before, function_reads: Some([semantic_reads.LocalAliasSource("Alias", "provider", Some(target))]) }
  let f = fixture_function(before)
  let p = capture(before, after, f).expect("capture source read")
  let view = View { symbols: after.syms,
    callee: (owner, name, builtin, tr) => Some(f.sig) }
  # The one reference domain a recorded fact can carry that is spelled in
  # another declaration's file. Only that declaration's own owner can move
  # one, which is what the caller below supplies and what the two refusals
  # around it are about.
  let provider_source: fn(String, TypeRef) -> Option[TypeRef] =
    (owner, node) => match node {
      TNamed(n, args, effs, lo, hi) ->
        if owner == "provider" { Some(TNamed(n, args, effs, lo + 1000, hi + 2000)) } else { None }
      _ -> None
    }
  assert project(view, p) == None
  let q = project_with_source(view, p, provider_source).expect("project owned source")
  assert q.tree.body == XUnit(0, 1)
  let cx = assemble(before, q).expect("assemble owned source")
  assert cx.function_reads == Some([semantic_reads.LocalAliasSource("Alias", "provider", Some(TNamed("Int", [], [], 1000, 2001)))])
  assert project_with_source(view, p, (owner, node) => provider_source("consumer", node)) == None
  let constant = TConst { name: "VALUE", ty: TyUnit, init: XUnit(0, 1), lo: 0, hi: 1 }
  let saved_constant = capture_constant(before, after, constant).expect("capture constant source read")
  assert project_constant(view, saved_constant) == None
  let moved_constant = project_constant_with_source(view, saved_constant,
    provider_source).expect("project constant owned source")
  assert moved_constant.tree == TConst { name: "VALUE", ty: TyUnit, init: XUnit(0, 1), lo: 0, hi: 1 }
  let constant_cx = assemble(before, moved_constant).expect("assemble constant owned source")
  assert constant_cx.function_reads == cx.function_reads
}

test "body product captures state writes without retaining old cumulative tables" {
  let cx = cx_new(None, None)
  let before = Cx { ..cx, current_tparam_bounds: map.from([(10, [20])]),
    frame: Frame { ..cx.frame, dict_syms: map.from([((10, 20), 30)]) } }
  let f = fixture_function(before)
  let d = Diag { msg: "body", lo: 0, hi: 1, hint: "", owner: None }
  let after = Cx { ..before, decl_slots: map.insert(before.decl_slots, before.owner_decl, 2),
    fns: map.insert(before.fns, "inferred", f.sig), alias_resolved: map.from([("Alias", TyInt)]),
    current_tparam_bounds: map.insert(before.current_tparam_bounds, 11, [21]),
    frame: Frame { ..before.frame, dict_syms: map.insert(before.frame.dict_syms, (11, 21), 31) },
    diags: [d] }
  let p = capture(before, after, f).expect("capture")
  assert len(p.bounds) == 1
  assert p.frame.dict_syms == after.frame.dict_syms
  let input = Cx { ..before, current_tparam_bounds: map.insert(before.current_tparam_bounds, 12, [22]),
    frame: Frame { ..before.frame, dict_syms: map.insert(before.frame.dict_syms, (12, 22), 32) } }
  let result = assemble(input, p).expect("assemble")
  assert slots_of(result, before.owner_decl) == 2 && result.diags == [d]
  assert result.fns == after.fns && result.alias_resolved == after.alias_resolved
  assert map.get(result.current_tparam_bounds, 12) == Some([22])
  assert map.get(result.current_tparam_bounds, 11) == Some([21])
  assert map.get(result.frame.dict_syms, (12, 22)) == None
  assert map.get(result.frame.dict_syms, (11, 21)) == Some(31)
  assert match assemble(with_slots(input, before.owner_decl, 3), p) { None -> true, Some(_) -> false }
}

test "body product journaled extraction agrees with strict table differences" {
  let initial = cx_new(None, None)
  let tree = fixture_function(initial)
  let symbol = Sym { name: "x", ty: TyInt, mutable: false, dlo: 0, dhi: 1,
    dict_of: None, ev_of: None, cell_of: None }
  let before = Cx { ..initial, body_writes: Some([]),
    syms: map.from([(10, symbol)]), fns: map.from([("fixture", tree.sig)]),
    alias_resolved: map.from([("A", TyInt)]), current_tparam_bounds: map.from([(7, [1])]) }
  let a = write_symbol(before, 10, Sym { ..symbol, mutable: true })
  let b = write_symbol(a, 10, Sym { ..symbol, name: "updated" })
  let c = write_signature(b, "fixture", Sig { ..tree.sig, ret: TyInt })
  let d = write_alias(c, "A", TyUnit)
  let after = write_bounds(d, 7, [2, 3])
  let strict = capture(before, after, tree).expect("strict capture")
  let saved = capture_journaled(before, after, tree)
  assert match saved { Some(_) -> true, None -> false }
  let fast = saved.expect("journaled capture")
  assert fast.symbols == strict.symbols && fast.signatures == strict.signatures
  assert fast.aliases == strict.aliases && fast.bounds == strict.bounds
  assert len(fast.symbols) == 1 && len(fast.body_writes.expect("write keys")) == 5
  let replay = assemble(before, fast).expect("journaled replay")
  assert replay.syms == after.syms && replay.fns == after.fns && replay.alias_resolved == after.alias_resolved
  assert map.get(replay.current_tparam_bounds, 7) == Some([2, 3])
  assert replay.body_writes == after.body_writes
  let absent = Cx { ..after, body_writes: None }
  assert capture_journaled(before, absent, tree) == None
  assert capture_journaled(before, Cx { ..after, effects: map.from([("Unexpected", 9)]) }, tree) == None
  let unreported = Cx { ..before, syms: map.insert(before.syms, 11, symbol) }
  assert capture_journaled(before, unreported, tree) == None
}

test "body product journaled environment equality preserves membership and values" {
  let original = map.from([("A", 1), ("B", 2)])
  let reordered = map.from([("B", 2), ("A", 1)])
  let changed = map.from([("A", 3), ("B", 2)])
  let replaced = map.from([("A", 1), ("C", 2)])
  let missing = map.from([("A", 1)])
  let extra = map.from([("A", 1), ("B", 2), ("C", 3)])
  for candidate in [original, reordered, changed, replaced, missing, extra] {
    assert environment_map_same(original, candidate, true) == (original == candidate)
    let before = Cx { ..cx_new(None, None), body_writes: Some([]), effects: original }
    let after = Cx { ..before, effects: candidate }
    let tree = fixture_function(before)
    let strict = capture(before, after, tree)
    let tracked = capture_journaled(before, after, tree)
    assert strict == tracked
    assert match tracked { Some(_) -> original == candidate, None -> original != candidate }
  }
  assert environment_map_same(original, reordered, true)
  assert not environment_map_same(original, changed, true)
  assert not environment_map_same(original, replaced, true)
  assert not environment_map_same(original, missing, true)
  assert not environment_map_same(original, extra, true)
}

test "body product rejects unowned writes and diagnostic prefix replacement" {
  let cx = cx_new(None, None)
  let d = Diag { msg: "before", lo: 0, hi: 1, hint: "", owner: None }
  let before = Cx { ..cx, diags: [d] }
  let f = fixture_function(before)
  assert capture(before, Cx { ..before, effects: map.from([("New", 42)]) }, f) == None
  assert capture(before, Cx { ..before, diags: [] }, f) == None
  assert capture(before, Cx { ..before, diags: [Diag { ..d, msg: "changed" }] }, f) == None
  let advanced = with_slots(before, before.owner_decl, 3)
  assert capture(advanced, with_slots(before, before.owner_decl, 2), f) == None
  # and one transition cannot span two declarations
  assert capture(before, Cx { ..before, owner_decl: before.owner_decl + 1 }, f) == None
  assert capture(before, Cx { ..before, frame: Frame { ..before.frame, loop_stack: [0] } }, f) == None
}

test "body product hands its symbol changes over in key order" {
  # The recorded order is whatever comparing two tables produced, which is
  # neither allocation order nor anything a reader should depend on; a
  # product carries them sorted.
  let before = cx_new(None, None)
  let f = fixture_function(before)
  let x = Sym { name: "x", ty: TyInt, mutable: false, dlo: 0, dhi: 1,
    dict_of: None, ev_of: None, cell_of: None }
  let y = Sym { ..x, name: "y" }
  # inserted the other way round, so the order the comparison sees is not
  # the order a product hands over
  let after = Cx { ..before, syms: map.from([(11, y), (10, x)]) }
  let p = capture(before, after, f).expect("capture two symbols")
  let view = View { symbols: after.syms,
    callee: (owner, name, builtin, tr) => Some(f.sig) }
  let projected = project(view, p).expect("project two symbols")
  var keys: List[Int] = []
  for change in projected.symbols { keys = keys ++ [change.key] }
  assert keys == [10, 11]
  let result = assemble(before, projected).expect("assemble two symbols")
  assert map.get(result.syms, 10) == Some(x) && map.get(result.syms, 11) == Some(y)
}

test "body product carries an allocation that never becomes a symbol" {
  # A handler installation is an identifier the body mints and no symbol ever
  # names: it reaches the tree as the prompt operand of `ctl_run`. It used to
  # need the interval to cover it, because nothing recorded it; it needs
  # nothing now, because it is a slot of the declaration that opened it and
  # is the same integer in the candidate revision.
  let before = cx_new(None, None)
  let base = fixture_function(before)
  let prompt = XCallBuiltin("ctl_run", [XInt(11, 0, 1)], [], [], 0, 1, TyUnit)
  let f = TFun { ..base, body: prompt }
  let x = Sym { name: "x", ty: TyInt, mutable: false, dlo: 0, dhi: 1,
    dict_of: None, ev_of: None, cell_of: Some((11, TyInt)) }
  let after = Cx { ..before, syms: map.from([(10, x)]) }
  let p = capture(before, after, f).expect("capture installation")
  let view = View { symbols: after.syms,
    callee: (owner, name, builtin, tr) => Some(f.sig) }
  let projected = project(view, p).expect("project installation")
  assert projected.tree.body == prompt
  let result = assemble(before, projected).expect("assemble installation")
  assert map.get(result.syms, 10).expect("installed symbol").cell_of == Some((11, TyInt))
}

test "body product projects every state reference and the whole allocation interval" {
  let diagnostic = ExportDiagnostic { message: "unknown type `Missing`", hint: Some("did you mean `Record`?") }
  let methods = [JMethod { name: "get", param_cls: ["long"], ret_cls: "pkg.Result", is_static: true,
    is_varargs: false, is_abstract: false, desc: "get descriptor", decl_cls: "pkg.Parent" }]
  let constructors = [JCtor { param_cls: ["long"], is_varargs: false, desc: "constructor descriptor" }]
  let fields = [JField { name: "VALUE", type_cls: "long", decl_cls: "pkg.Parent" }]
  let found_class = JClass { fqcn: "pkg.Actual", simple: "Actual", display: "ReadableActual",
    is_interface: false, is_primitive: false, is_array: true }
  let before = Cx { ..cx_new(None, None),
    function_reads: Some([FunctionAnswer(NamedFunctionRead { name: "earlier", answer: None })]) }
  let f = fixture_function(before)
  let symbol = Sym { name: "x", ty: TyVar("T", 1), mutable: false, dlo: 0, dhi: 1,
    dict_of: Some((2, 1)), ev_of: None, cell_of: Some((10, TyInt)) }
  let after = Cx { ..before, syms: map.from([(10, symbol)]),
    function_reads: Some([FunctionAnswer(NamedFunctionRead { name: "earlier", answer: None }),
      FunctionAnswer(NamedFunctionRead { name: "callee", answer: Some(Sig { ..f.sig, ret: TyVar("T", 1) }) }),
      FunctionAnswer(NamedFunctionRead { name: "missing", answer: None }), FunctionCandidates(["callee", "other"]),
      QualifiedConstant("h", "VALUE", Some(("provider", TyVar("T", 1)))), QualifiedConstructor("h", "Item", Some((4, 1))),
      QualifiedAliasHeader("h", "Alias", Some(AliasTypeHeader { name: "Alias", tparams: [TyVar("T", 1)],
        eparams: [EffVar("e", 3)], opaque_id: Some(4), owner: "provider" })),
      QualifiedAliasTarget("h", "Alias", Some(TyVar("T", 1))), NominalTypeName(Some("h"), "Record", Some(4)),
      NominalTypeShape(4, "Record", 1, ["e"], true), LocalTypeDiagnostic("Missing", diagnostic),
      LocalAliasTarget("Alias", Some(TyVar("T", 1))), LocalAliasResolving("Alias", true),
      LocalAliasHeader("Alias", Some(AliasTypeHeader { name: "Alias", tparams: [TyVar("T", 1)], eparams: [EffVar("e", 3)],
        opaque_id: Some(4), owner: "provider" })), LocalAliasBinders("Alias", [TyVar("T", 1)], [EffVar("e", 3)]),
      semantic_reads.ScopedTypeParameter("T", Some(TyVar("T", 1))),
      semantic_reads.ParameterBounds(TyVar("T", 1), Some([2])),
      semantic_reads.TraitAssociatedMembers(2, semantic_reads.AssociatedType, ["Item"]),
      semantic_reads.DeclaredEffect("Ask", Some(ELabeled(EPure, [(3, "Ask")]))),
      semantic_reads.ScopedEffectVariable("e", Some(EffVar("e", 3))),
      semantic_reads.BuiltinTypeAnswer("Builtin", Some(BuiltinTypeI { name: "Builtin", params: ["T"], access: BtStdOnly, build: BtLeaf(TyVar("T", 1)) })),
      semantic_reads.StdModuleMode(false), semantic_reads.JavaClassName("Foreign", Some("pkg.Box")),
      semantic_reads.JavaClassInfo("pkg.Box", JClass { fqcn: "pkg.Box", simple: "Box", display: "ReadableBox",
        is_interface: true, is_primitive: false, is_array: false }),
      semantic_reads.JavaMethods("pkg.Box", methods), semantic_reads.JavaConstructors("pkg.Box", constructors),
      semantic_reads.JavaStaticFields("pkg.Box", fields), semantic_reads.JavaEnabled(true),
      semantic_reads.JavaFindClass("lookup.Class", Some(found_class)), semantic_reads.JavaClassNames(["Z", "A"]),
      semantic_reads.JavaAssignable("pkg.Parent", "pkg.Child", false),
      semantic_reads.JavaSam("pkg.Callback", Some(methods[0])),
      semantic_reads.JavaComponent("[Lpkg.Child;", Some("pkg.Child")),
      semantic_reads.LocalConstructor("Box", Some((4, 0))), semantic_reads.LocalConstant("VALUE", Some(TyVar("T", 1))),
      semantic_reads.ConstantVisible("LATER", false), semantic_reads.ConstructorCount(4, 2), semantic_reads.ConstructorArity(4, 0, 1),
      semantic_reads.ConstructorHeaderAnswer(4, ConstructorHeader { id: 4, name: "Box", is_record: true, tparams: [TyVar("T", 1)] }),
      semantic_reads.ConstructorFields(4, 0, CtorI { adt: 4, name: "Box", fields: [FieldI { name: "value", ty: TyVar("T", 1) }] }),
      semantic_reads.ConstructorNames(4, ["Z", "A"]), semantic_reads.DeclaredConstantName("LATER", true),
      semantic_reads.LocalValueCandidates(true, ["Z", "A", "VALUE"]),
      semantic_reads.LocalEffectName("Ask", Some(4)), semantic_reads.EffectCandidates(["Z", "Ask"]),
      semantic_reads.DeclaredEffectInfo(4, EffectI { id: 4, name: "Ask", owner: Some("provider"),
        audience: AWorld, ops: ["second", "first"], ctl: true }),
      semantic_reads.AssignableType(TyVar("T", 1), TyAdt(4, []), false),
      semantic_reads.ConcreteType(TyVar("T", 1), true),
      semantic_reads.UnifiedTypes(UnificationRead { declared: TyVar("T", 1), actual: TyAdt(4, []),
        before: InferenceBindings { types: [], effects: [(3, EffVar("e", 3))] },
        after: InferenceBindings { types: [(1, TyAdt(4, []))], effects: [(3, EIo)] }, matched: false }),
      semantic_reads.ReducedTypeEffects(TyAdt(4, []), [(1, TyVar("T", 1))], TyVar("T", 1)),
      semantic_reads.ReducedEffect(EffVar("e", 3), [(1, TyAdt(4, []))], EIo),
      semantic_reads.ReducedAssociatedType(TyAdt(4, [TyVar("T", 1)]), TyVar("T", 1)),
      semantic_reads.DictionarySymbol(1, 2, Some(10)),
      semantic_reads.DictionarySymbol(1, 2, None),
      semantic_reads.TraitName(2, "Readable"),
      semantic_reads.ImplementationPresence(2, TyAdt(4, [TyVar("T", 1)]), true),
      semantic_reads.ImplementationArity(2, TyAdt(4, [TyVar("T", 1)]), Some(1)),
      semantic_reads.ImplementationSubgoals(2, TyAdt(4, [TyVar("T", 1)]), [(2, TyVar("T", 1)), (2, TyVar("T", 1))]),
      semantic_reads.RenderedType(TyAdt(4, [TyVar("T", 1)]), "Box[T]"),
      semantic_reads.RenderedSignature(Sig { ..f.sig, ret: TyVar("T", 1) }, "fn body() -> T"),
      semantic_reads.RenderedFunctionReturn(TyVar("T", 1), EffVar("e", 3), "T"),
      semantic_reads.RenderedConstructor(CtorI { adt: 4, name: "Box", fields: [FieldI { name: "value", ty: TyVar("T", 1) }] }, "Box { value: T }")]),
    fns: map.from([("inferred", Sig { ..f.sig, ret: TyVar("T", 1) })]),
    alias_resolved: map.from([("Alias", TyVar("T", 1))]),
    current_tparams: map.from([("T", TyVar("T", 1))]), current_eff_vars: map.from([("e", EffVar("e", 3))]),
    current_tparam_bounds: map.from([(1, [2])]), take_cell: Some(10),
    diags: [owned_diagnostic()],
    frame: Frame { ..before.frame, scopes: [map.from([("x", 10)])],
      current_sig: Some(Sig { ..f.sig, ret: TyVar("T", 1) }),
      dict_syms: map.from([((1, 2), 10)]), used_effects: [EffVar("e", 3)],
      eff_witness: map.from([(EffVar("e", 3), (0, 1, "callee"))]) } }
  let p = capture(before, after, f).expect("capture projected fixture")
  let view = View { symbols: after.syms,
    callee: (owner, name, builtin, tr) => Some(f.sig) }
  let q = project(view, p).expect("project product")
  let cx = assemble(before, q).expect("assemble projected product")
  assert q.tree.body == XUnit(0, 1)
  # Every reference in the product is the same integer in the candidate
  # revision, so the whole of it -- sixty-one recorded facts, every state
  # table, the frame and the symbol -- comes back as what was recorded. The
  # corpus below is what keeps that from being a comparison of nothing: each
  # arm of the projection is exercised on a fact that names a reference, and
  # the arm that forgot one would have to forget it in the same way on both
  # sides to agree.
  assert len(p.function_reads.expect("read delta")) == 61
  assert cx.function_reads == after.function_reads
  let moved = map.get(cx.syms, 10).expect("projected symbol")
  assert moved == symbol
  assert cx.take_cell == Some(10)
  assert cx.current_tparams == after.current_tparams
  assert cx.current_eff_vars == after.current_eff_vars
  assert map.len(cx.current_tparam_bounds) == map.len(after.current_tparam_bounds)
  for (id, bounds) in map.entries(after.current_tparam_bounds) {
    assert map.get(cx.current_tparam_bounds, id) == Some(bounds)
  }
  assert cx.alias_resolved == after.alias_resolved
  assert cx.fns == after.fns
  assert cx.frame == after.frame
  # The frame is projected rather than carried, and what projecting it still
  # decides is whether it agrees with the symbol table: a recorded scope that
  # spells a binding differently from the symbol it names is a product this
  # compiler did not write.
  let mis_spelled = Cx { ..after, frame: Frame { ..after.frame, scopes: [map.from([("y", 10)])] } }
  assert project(view, capture(before, mis_spelled, f).expect("capture a mis-spelled scope")) == None
  # The diagnostic stays measured from the declaration that raised it, and the
  # render sites add that declaration's start in the revision they render, so
  # a product carries it through untouched whatever moved.
  assert cx.diags == [owned_diagnostic()]
  # A recorded symbol whose compiler-owned spelling does not match the key it
  # carries is not a product this compiler wrote, and is refused.
  let forged = Sym { ..symbol, name: "ev\$v\$0", ev_of: Some(9999) }
  let bad = View { ..view, symbols: map.from([(10, forged)]) }
  assert project(bad, capture(before, Cx { ..after, syms: map.from([(10, forged)]) }, f)
      .expect("capture forged symbol")) == None
}

## A diagnostic the way the checker records one inside a declaration: the
## positions are offsets from that declaration, and the owner says which one.
fn owned_diagnostic() -> Diag =
  Diag { msg: "body", lo: 0, hi: 1, hint: "",
    owner: Some(DiagOwner { module: "pkg/m", decl: "Nf4:body" }) }

## Every constructor of `semantic_reads.FunctionRead`, named once, in the
## order that type declares them. This is the list `read_tag` hands out and
## the list `fixture_read_corpus` has to cover.
fn read_vocabulary() -> List[String] =
  ["FunctionAnswer", "FunctionCandidates", "QualifiedFunction", "ModuleAlias",
    "QualifiedConstant", "QualifiedConstructor", "ExportPresence", "ExportDiagnosticAnswer",
    "QualifiedAliasHeader", "QualifiedAliasTarget", "NominalTypeName", "NominalTypeShape",
    "LocalTypeDiagnostic", "LocalAliasTarget", "LocalAliasResolving", "LocalAliasSource",
    "LocalAliasHeader", "LocalAliasBinders", "ScopedTypeParameter", "ParameterBounds",
    "TraitAssociatedMembers", "TraitName", "DictionarySymbol", "ReducedAssociatedType",
    "ReducedEffect", "ReducedTypeEffects", "UnifiedTypes", "ConcreteType", "AssignableType",
    "DeclaredEffect", "ScopedEffectVariable", "BuiltinTypeAnswer", "StdModuleMode",
    "JavaClassName", "JavaClassInfo", "JavaMethods", "JavaConstructors", "JavaStaticFields",
    "JavaEnabled", "JavaFindClass", "JavaClassNames", "JavaAssignable", "JavaSam",
    "JavaComponent", "LocalConstructor", "LocalConstant", "ConstantVisible", "ConstructorCount",
    "ConstructorArity", "ConstructorHeaderAnswer", "ConstructorFields", "ConstructorNames",
    "DeclaredConstantName", "LocalValueCandidates", "DeclaredEffectInfo", "MovedName",
    "ConstSerializable", "LocalEffectName", "QualifiedEffectName", "QualifiedEffectDiagnostic",
    "EffectCandidates", "RenderedType", "RenderedFunctionReturn", "RenderedConstructor",
    "RenderedSignature", "ImplementationPresence", "ImplementationSubgoals",
    "ImplementationArity"]

## The constructor a recorded fact was built with. The match is exhaustive on
## purpose, and that is the mechanism behind the corpus below: a constructor
## added to `FunctionRead` does not compile until it is named here, and a
## constructor named here with no fact in the corpus fails the coverage test.
## Before this existed the corpus claimed the whole vocabulary in a comment,
## and a sixty fifth constructor would have left every gate green.
##
## The step it cannot force is the one in between. An arm added here whose tag
## is left out of `read_vocabulary` as well is still green, because a language
## with no reflection has no way to ask a type how many constructors it has.
## The compile error is what brings a person to both lists.
fn read_tag(r: FunctionRead) -> String =
  match r {
    semantic_reads.FunctionAnswer(_) -> "FunctionAnswer"
    semantic_reads.FunctionCandidates(_) -> "FunctionCandidates"
    semantic_reads.QualifiedFunction(_, _) -> "QualifiedFunction"
    semantic_reads.ModuleAlias(_, _) -> "ModuleAlias"
    semantic_reads.QualifiedConstant(_, _, _) -> "QualifiedConstant"
    semantic_reads.QualifiedConstructor(_, _, _) -> "QualifiedConstructor"
    semantic_reads.ExportPresence(_, _) -> "ExportPresence"
    semantic_reads.ExportDiagnosticAnswer(_, _, _, _) -> "ExportDiagnosticAnswer"
    semantic_reads.QualifiedAliasHeader(_, _, _) -> "QualifiedAliasHeader"
    semantic_reads.QualifiedAliasTarget(_, _, _) -> "QualifiedAliasTarget"
    semantic_reads.NominalTypeName(_, _, _) -> "NominalTypeName"
    semantic_reads.NominalTypeShape(_, _, _, _, _) -> "NominalTypeShape"
    semantic_reads.LocalTypeDiagnostic(_, _) -> "LocalTypeDiagnostic"
    semantic_reads.LocalAliasTarget(_, _) -> "LocalAliasTarget"
    semantic_reads.LocalAliasResolving(_, _) -> "LocalAliasResolving"
    semantic_reads.LocalAliasSource(_, _, _) -> "LocalAliasSource"
    semantic_reads.LocalAliasHeader(_, _) -> "LocalAliasHeader"
    semantic_reads.LocalAliasBinders(_, _, _) -> "LocalAliasBinders"
    semantic_reads.ScopedTypeParameter(_, _) -> "ScopedTypeParameter"
    semantic_reads.ParameterBounds(_, _) -> "ParameterBounds"
    semantic_reads.TraitAssociatedMembers(_, _, _) -> "TraitAssociatedMembers"
    semantic_reads.TraitName(_, _) -> "TraitName"
    semantic_reads.DictionarySymbol(_, _, _) -> "DictionarySymbol"
    semantic_reads.ReducedAssociatedType(_, _) -> "ReducedAssociatedType"
    semantic_reads.ReducedEffect(_, _, _) -> "ReducedEffect"
    semantic_reads.ReducedTypeEffects(_, _, _) -> "ReducedTypeEffects"
    semantic_reads.UnifiedTypes(_) -> "UnifiedTypes"
    semantic_reads.ConcreteType(_, _) -> "ConcreteType"
    semantic_reads.AssignableType(_, _, _) -> "AssignableType"
    semantic_reads.DeclaredEffect(_, _) -> "DeclaredEffect"
    semantic_reads.ScopedEffectVariable(_, _) -> "ScopedEffectVariable"
    semantic_reads.BuiltinTypeAnswer(_, _) -> "BuiltinTypeAnswer"
    semantic_reads.StdModuleMode(_) -> "StdModuleMode"
    semantic_reads.JavaClassName(_, _) -> "JavaClassName"
    semantic_reads.JavaClassInfo(_, _) -> "JavaClassInfo"
    semantic_reads.JavaMethods(_, _) -> "JavaMethods"
    semantic_reads.JavaConstructors(_, _) -> "JavaConstructors"
    semantic_reads.JavaStaticFields(_, _) -> "JavaStaticFields"
    semantic_reads.JavaEnabled(_) -> "JavaEnabled"
    semantic_reads.JavaFindClass(_, _) -> "JavaFindClass"
    semantic_reads.JavaClassNames(_) -> "JavaClassNames"
    semantic_reads.JavaAssignable(_, _, _) -> "JavaAssignable"
    semantic_reads.JavaSam(_, _) -> "JavaSam"
    semantic_reads.JavaComponent(_, _) -> "JavaComponent"
    semantic_reads.LocalConstructor(_, _) -> "LocalConstructor"
    semantic_reads.LocalConstant(_, _) -> "LocalConstant"
    semantic_reads.ConstantVisible(_, _) -> "ConstantVisible"
    semantic_reads.ConstructorCount(_, _) -> "ConstructorCount"
    semantic_reads.ConstructorArity(_, _, _) -> "ConstructorArity"
    semantic_reads.ConstructorHeaderAnswer(_, _) -> "ConstructorHeaderAnswer"
    semantic_reads.ConstructorFields(_, _, _) -> "ConstructorFields"
    semantic_reads.ConstructorNames(_, _) -> "ConstructorNames"
    semantic_reads.DeclaredConstantName(_, _) -> "DeclaredConstantName"
    semantic_reads.LocalValueCandidates(_, _) -> "LocalValueCandidates"
    semantic_reads.DeclaredEffectInfo(_, _) -> "DeclaredEffectInfo"
    semantic_reads.MovedName(_, _) -> "MovedName"
    semantic_reads.ConstSerializable(_, _) -> "ConstSerializable"
    semantic_reads.LocalEffectName(_, _) -> "LocalEffectName"
    semantic_reads.QualifiedEffectName(_, _, _) -> "QualifiedEffectName"
    semantic_reads.QualifiedEffectDiagnostic(_, _, _) -> "QualifiedEffectDiagnostic"
    semantic_reads.EffectCandidates(_) -> "EffectCandidates"
    semantic_reads.RenderedType(_, _) -> "RenderedType"
    semantic_reads.RenderedFunctionReturn(_, _, _) -> "RenderedFunctionReturn"
    semantic_reads.RenderedConstructor(_, _) -> "RenderedConstructor"
    semantic_reads.RenderedSignature(_, _) -> "RenderedSignature"
    semantic_reads.ImplementationPresence(_, _, _) -> "ImplementationPresence"
    semantic_reads.ImplementationSubgoals(_, _, _) -> "ImplementationSubgoals"
    semantic_reads.ImplementationArity(_, _, _) -> "ImplementationArity"
  }

## One recorded fact per `FunctionRead` constructor, spelled in the recording
## revision's coordinates. The whole read vocabulary is here, so a rebuild
## that dropped a reference would be caught rather than left to a corpus that
## did not exercise it. `read_tag` is what keeps that true: the test below
## reads this list back through it and requires every constructor to answer.
fn fixture_read_corpus() -> List[FunctionRead] = {
  let element = TyVar("T", 4)
  let subject = TyAdt(1, [element])
  let row = EffVar("e", 5)
  let ctor = CtorI { adt: 1, name: "Make", fields: [FieldI { name: "value", ty: subject }] }
  let header = AliasTypeHeader { name: "A", tparams: [element], eparams: [row],
    opaque_id: Some(1), owner: "provider" }
  let signature = Sig { name: "f", param_tys: [subject], param_names: ["x"], param_defaults: [false],
    ret: element, eff: row, is_builtin: false, tparams: [element], constraints: [[3]],
    eparams: [row], owner: Some("provider"), trait_id: Some(3), op_of: Some((2, 0)), inferring: false }
  let bindings = InferenceBindings { types: [(4, subject)], effects: [(5, row)] }
  let diagnostic = ExportDiagnostic { message: "not exported", hint: Some("export it") }
  let jclass = JClass { fqcn: "java.lang.String", simple: "String", display: "String",
    is_interface: false, is_primitive: false, is_array: false }
  let jmethod = JMethod { name: "length", param_cls: [], ret_cls: "int", is_static: false,
    is_varargs: false, is_abstract: false, desc: "()I", decl_cls: "java.lang.String" }
  let jctor = JCtor { param_cls: [], is_varargs: false, desc: "()V" }
  let jfield = JField { name: "CASE_INSENSITIVE_ORDER", type_cls: "java.util.Comparator",
    decl_cls: "java.lang.String" }
  [FunctionAnswer(NamedFunctionRead { name: "f", answer: Some(signature) }),
    FunctionAnswer(NamedFunctionRead { name: "gone", answer: None }),
    semantic_reads.QualifiedFunction("h", NamedFunctionRead { name: "f", answer: Some(signature) }),
    FunctionCandidates(["f", "gone"]),
    semantic_reads.ModuleAlias("h", Some("provider")),
    semantic_reads.LocalConstructor("Make", Some((1, 0))),
    semantic_reads.LocalConstant("value", Some(subject)),
    semantic_reads.ConstantVisible("value", true),
    semantic_reads.ConstructorCount(1, 2),
    semantic_reads.ConstructorArity(1, 0, 1),
    semantic_reads.ConstructorNames(1, ["Make"]),
    semantic_reads.ConstructorHeaderAnswer(1, ConstructorHeader { id: 1, name: "Box",
      is_record: true, tparams: [element] }),
    semantic_reads.ConstructorFields(1, 0, ctor),
    semantic_reads.DeclaredEffectInfo(2, EffectI { id: 2, name: "Ask", owner: Some("provider"),
      audience: AWorld, ops: ["ask"], ctl: false }),
    semantic_reads.LocalEffectName("Ask", Some(2)),
    semantic_reads.QualifiedEffectName("h", "Ask", Some(2)),
    semantic_reads.QualifiedEffectDiagnostic("h", "Missing", Some(diagnostic)),
    NominalTypeName(None, "Box", Some(1)),
    NominalTypeName(Some("h"), "Other", Some(2)),
    NominalTypeShape(1, "Box", 1, ["e"], true),
    semantic_reads.RenderedType(subject, "Box[T]"),
    semantic_reads.RenderedSignature(signature, "fn f(x: Box[T]) -> T !e"),
    semantic_reads.RenderedFunctionReturn(subject, row, "Box[T] !e"),
    semantic_reads.RenderedConstructor(ctor, "Make(Box[T])"),
    semantic_reads.ReducedAssociatedType(TyAssoc(subject, 3, "Item"), subject),
    semantic_reads.ConcreteType(subject, false),
    semantic_reads.AssignableType(subject, TyList(subject), true),
    semantic_reads.ReducedEffect(row, [(4, subject)], EPure),
    semantic_reads.ReducedTypeEffects(TyFn([subject], element, row), [(4, subject)],
      TyFn([subject], element, EPure)),
    semantic_reads.UnifiedTypes(UnificationRead { declared: subject, actual: TyList(subject),
      before: bindings, after: InferenceBindings { types: [(4, element)], effects: [(5, EPure)] },
      matched: false }),
    semantic_reads.ImplementationPresence(3, subject, true),
    semantic_reads.ImplementationArity(3, subject, Some(1)),
    semantic_reads.ImplementationSubgoals(3, subject, [(3, element)]),
    QualifiedConstant("h", "VALUE", Some(("provider", subject))),
    QualifiedConstructor("h", "Make", Some((1, 0))),
    semantic_reads.ExportPresence("h", true),
    QualifiedAliasHeader("h", "A", Some(header)),
    QualifiedAliasTarget("h", "A", Some(subject)),
    LocalAliasHeader("A", Some(header)),
    LocalAliasBinders("A", [element], [row]),
    LocalAliasTarget("A", Some(subject)),
    LocalAliasResolving("A", true),
    LocalAliasSource("A", "provider", Some(TNamed("Int", [], [], 0, 1))),
    semantic_reads.ScopedTypeParameter("T", Some(element)),
    semantic_reads.ScopedEffectVariable("e", Some(row)),
    semantic_reads.DeclaredEffect("Ask", Some(ELabeled(EPure, [(2, "Ask")]))),
    semantic_reads.ParameterBounds(element, Some([3])),
    semantic_reads.TraitAssociatedMembers(3, semantic_reads.AssociatedType, ["Item"]),
    semantic_reads.TraitName(3, "Eq"),
    semantic_reads.DictionarySymbol(4, 3, Some(6)),
    semantic_reads.BuiltinTypeAnswer("Int", Some(BuiltinTypeI { name: "Int", params: [],
        access: BtStdOnly, build: BtLeaf(subject) })),
    semantic_reads.StdModuleMode(true),
    semantic_reads.ExportDiagnosticAnswer(semantic_reads.ValueDiagnostic, "h", "v", Some(diagnostic)),
    LocalTypeDiagnostic("A", diagnostic),
    semantic_reads.DeclaredConstantName("VALUE", true),
    semantic_reads.LocalValueCandidates(true, ["a", "b"]),
    semantic_reads.EffectCandidates(["Ask"]),
    semantic_reads.MovedName("print", Some("use `std/io.println`")),
    semantic_reads.ConstSerializable(subject, false),
    semantic_reads.JavaClassName("String", Some("java.lang.String")),
    semantic_reads.JavaClassInfo("java.lang.String", jclass),
    semantic_reads.JavaMethods("java.lang.String", [jmethod]),
    semantic_reads.JavaConstructors("java.lang.String", [jctor]),
    semantic_reads.JavaStaticFields("java.lang.String", [jfield]),
    semantic_reads.JavaEnabled(true),
    semantic_reads.JavaFindClass("String", Some(jclass)),
    semantic_reads.JavaClassNames(["java.lang.String"]),
    semantic_reads.JavaAssignable("java.lang.Object", "java.lang.String", true),
    semantic_reads.JavaSam("java.lang.Runnable", Some(jmethod)),
    semantic_reads.JavaComponent("java.lang.String[]", Some("java.lang.String"))]
}

test "the read corpus holds a fact for every FunctionRead constructor" {
  # The corpus is a statement about the read vocabulary only for as long as it
  # still covers it, and the two tests below rest on that. `read_tag` is
  # exhaustive over `FunctionRead`, so this compares the corpus against the
  # vocabulary itself rather than against a count that a constructor added
  # later would still satisfy.
  let tags = list.map(fixture_read_corpus(), read_tag)
  let vocabulary = read_vocabulary()
  # One name per constructor. A tag standing for two of them would let the
  # corpus cover the vocabulary while leaving a constructor unexercised.
  assert len(list.unique(vocabulary)) == len(vocabulary)
  var unexercised = ""
  for tag in vocabulary { if not list.contains(tags, tag) { unexercised = unexercised ++ " " ++ tag } }
  if unexercised != "" { panic("the read corpus has no fact for:${unexercised}") }
  # The other direction, so the two cannot drift apart in either: a fact whose
  # tag is not in the vocabulary is a tag that was renamed out from under it.
  var unnamed = ""
  for tag in tags { if not list.contains(vocabulary, tag) { unnamed = unnamed ++ " " ++ tag } }
  if unnamed != "" { panic("the read corpus holds a fact read_vocabulary does not name:${unnamed}") }
}

test "body product read comparison answers for the projection it replaces" {
  # A source node is the one reference a recorded fact can carry that is
  # spelled in another declaration's file, so it is the only thing the
  # candidate's log has to move. Everything else names its own declaration and
  # is the same integer in both revisions, so it is carried whole. Over the
  # whole read vocabulary, that is what this says: exactly the alias source
  # arm moves and the other sixty-five constructors come back untouched.
  let source: fn(String, TypeRef) -> Option[TypeRef] =
    (owner, node) => match node {
      TNamed(n, args, effs, lo, hi) -> Some(TNamed(n, args, effs, lo + 1000, hi + 1000))
      _ -> None
    }
  let corpus = fixture_read_corpus()
  var answers: List[FunctionRead] = []
  var moved_facts = 0
  for fact in corpus {
    let moved = semantic_reads.project(Some([fact]), source).expect("projected fact").expect("enabled log")
    assert len(moved) == 1
    let is_source = match fact { LocalAliasSource(name, owner, target) -> true, _ -> false }
    if is_source {
      assert moved[0] != fact
      moved_facts = moved_facts + 1
    } else {
      assert moved == [fact]
    }
    answers = answers ++ moved
  }
  assert moved_facts == 1
  # The comparison side, over every ordered pair the corpus and its rebuilt
  # copies make. It used to walk each fact arm by arm under the same
  # relocation the rebuild carried; with every domain the identity, what is
  # left of it is that the recorded fact validates the observed one exactly
  # when the two are the same value. An observation that is not exactly one
  # fact is not an observation of this query, whatever the facts in it are.
  let candidates = corpus ++ answers
  for fact in corpus {
    for other in candidates {
      assert semantic_reads.observed_equal(fact, Some([other])) == (fact == other)
      assert not semantic_reads.observed_equal(fact, Some([other, other]))
    }
    assert not semantic_reads.observed_equal(fact, Some([]))
    assert not semantic_reads.observed_equal(fact, None)
  }
}

test "body product read comparison compares normalized rows" {
  # A recorded row is normalized where it was built, so a candidate that
  # carries the same atoms in the other order is a different value and is
  # refused. Nothing renormalizes it on the way in any more, because nothing
  # renumbers the atoms it is ordered by.
  let recorded = semantic_reads.ScopedEffectVariable("e",
    Some(EUnion([(5, "a"), (7, "b")], [], false)))
  let reordered = semantic_reads.ScopedEffectVariable("e",
    Some(EUnion([(7, "b"), (5, "a")], [], false)))
  assert semantic_reads.observed_equal(recorded, Some([recorded]))
  assert not semantic_reads.observed_equal(recorded, Some([reordered]))
}

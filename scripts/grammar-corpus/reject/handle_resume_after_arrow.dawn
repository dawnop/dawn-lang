# expect: expected a newline or `}` after this handler arm
# expect: allowed at module top level
# The clause belongs to the arm's header, ahead of the arrow. After the arrow
# everything is the body, so `resume k` there is two expressions written side
# by side -- an ordinary name followed by another one -- and the arm separator
# is what refuses it. The binder is a header mark precisely so that a reader
# never has to enter the body to learn whether the arm suspends.
effect Ask {
  fn ask(n: Int) -> Int
}

fn f() -> Int = {
  with handle Ask { ask(n) => resume k }
  ask(1)
}

# A comptime value as hover shows it (docs/lsp-hover-design.md §3): Dawn
# syntax read off the value's *type*, not off its representation. The
# interpreter's `CValue` erases what the reader needs -- a `Char` is a `VInt`,
# a record is a positional `VAdt` -- so the type that the checker gave the
# constant is walked alongside the value: `'a'` rather than `97`,
# `P { x: 1 }` rather than `P(1)`.
#
# `driver/checkdump.cv_show` renders the same values and is deliberately not
# used: it is the `__check` golden's format, held byte-for-byte against the
# previous release, so it can never learn about types without moving that
# golden; and its job (one exact line per constant) is not this one (one line a
# person can read, cut when it is long).
#
# Cutting reuses `check/types.cut_balanced`, the cutter K0 wrote for parameter
# defaults: the rendered value is the same kind of text (literals, brackets,
# strings), so the same rule keeps it balanced. The width differs, for the
# reason given at `VALUE_SHOWN`. Rendering itself stops a little past the
# width, so a 100,000-element table costs as much as a 100-element one.
#
# A literal's hover (§4) renders here too, through the same pieces -- the
# Char and String escapes, the hexadecimal, the cut -- so a literal and the
# constant it initializes never disagree about how a value is written. What a
# literal adds is what its spelling hides: the code point and UTF-8 bytes of a
# Char, both lengths of a String, and whether a Float literal is exactly a
# double, decided on the decimal itself (`float_exact`) because Dawn has no
# exact expansion of a double and this file does not write one.

use std/map
use std/str
use std/char
use check/types.{
  Ty, Eff, Adts, TyInt, TyFloat, TyBool, TyString, TyUnit, TyVar, TyAdt, TyList,
  TyTuple, TyOpaque, TyError, CHAR_OPAQUE_ID, adt_of, peel_opaque, subst, cut_balanced,
  AdtI, CtorI, FieldI, OPTION_ID, ty_char
}
use ir/core.{CValue, VInt, VFloat, VBool, VStr, VUnit, VList, VTuple, VAdt, VClosure, VDict}

## The widest a value renders, in code points, before its suffix. A default
## (`DEFAULT_SHOWN`, 40) shares its line with every other parameter of the
## signature; a constant's value is the rest of its own line, after
## `const NAME: T = `. 80 is the line a reader already expects to read whole --
## the width `dawn fmt` and most editors' rulers settle on -- and is about what
## an editor's hover popup shows without wrapping. A table (the case this is
## for) still shows its first dozen elements, which is what a reader checks
## against the code that built it.
pub(pkg) const VALUE_SHOWN: Int = 80

## The text after `= ` in a hover: the value, cut to `VALUE_SHOWN`, then a
## suffix -- the hexadecimal of an `Int` of 10 or more (clangd's threshold: below
## that the two spellings are the same digit), or the full length of a list or
## string that was cut. `None` for a function value: `<fn>` would tell the
## reader nothing the type does not.
pub(pkg) fn value_text(adts: Adts, t: Ty, v: CValue) -> Option[String] =
  match v {
    VClosure(_, _, _) -> None
    VDict(_, _) -> None
    _ -> {
      let full = render(adts, t, v, VALUE_SHOWN + 1)
      let shown = cut_balanced(full, VALUE_SHOWN)
      let cut = shown != full
      Some(shown ++ suffix(t, v, cut))
    }
  }

fn suffix(t: Ty, v: CValue, cut: Bool) -> String =
  match v {
    VInt(n) -> if not is_char(t) && n >= 10 { "  (0x" ++ hex(n) ++ ")" } else { "" }
    VList(es) ->
      if cut { "  (" ++ to_string(len(es)) ++ (if len(es) == 1 { " element)" } else { " elements)" }) }
      else { "" }
    VStr(s) ->
      if cut { "  (" ++ to_string(str.len(s)) ++ " code points)" } else { "" }
    _ -> ""
  }

## Uppercase hexadecimal of a non-negative Int. A negative one has no suffix:
## its two's complement depends on a width Dawn's `Int` does not expose.
pub(pkg) fn hex(n0: Int) -> String = {
  if n0 == 0 { return "0" }
  let digits = "0123456789ABCDEF"
  var n = n0
  var out = ""
  while n > 0 {
    out = str.slice(digits, n % 16, n % 16 + 1) ++ out
    n = n / 16
  }
  out
}

fn is_char(t: Ty) -> Bool =
  match t {
    TyOpaque(id, _, _, _, tgt) -> id == CHAR_OPAQUE_ID || is_char(tgt)
    _ -> false
  }

## `v` as Dawn source, read through `t`. `room` is how far past the cut the
## text needs to reach: a collection stops adding elements once it is wider,
## so the cut (which always lands inside `room`) still has something to mark.
## A type that does not describe the value (`TyError`, or a shape mismatch the
## checker would not produce) falls back to the value's own shape.
fn render(adts: Adts, t: Ty, v: CValue, room: Int) -> String =
  match v {
    VInt(n) -> if is_char(t) { char_lit(n) } else { to_string(n) }
    VFloat(f) -> to_string(f)
    VBool(b) -> to_string(b)
    VStr(s) -> str_lit(s, room)
    VUnit -> "()"
    VList(es) -> {
      let et = match peel_opaque(t) {
        TyList(e) -> e
        _ -> TyError
      }
      "[" ++ seq(adts, et, [], es, room) ++ "]"
    }
    VTuple(es) -> {
      let tys = match peel_opaque(t) {
        TyTuple(ts) -> ts
        _ -> []
      }
      "(" ++ seq(adts, TyError, tys, es, room) ++ ")"
    }
    VAdt(aid, ci, fs) -> adt_text(adts, t, aid, ci, fs, room)
    VClosure(_, _, _) -> "<fn>"
    VDict(_, _) -> "<fn>"
  }

## Elements joined by `, `, each read through its own type in `tys` or, past
## the end of `tys`, through `rest` (a list's element type), stopping once the
## text is wider than `room`.
fn seq(adts: Adts, rest: Ty, tys: List[Ty], es: List[CValue], room: Int) -> String = {
  var out = ""
  var i = 0
  for e in es {
    if str.len(out) > room { return out ++ ", …" }
    let et = if i < len(tys) { tys[i] } else { rest }
    let part = render(adts, et, e, room - str.len(out))
    out = if i == 0 { part } else { out ++ ", " ++ part }
    i = i + 1
  }
  out
}

fn adt_text(adts: Adts, t: Ty, aid: Int, ci: Int, fs: List[CValue], room: Int) -> String = {
  let a = adt_of(adts, aid)
  let c = a.ctors[ci]
  # the declared field types, instantiated at the arguments `t` gives the
  # type's parameters: an `Option[Char]` field is a `Char`
  var m: Map[Int, Ty] = map.empty()
  match peel_opaque(t) {
    TyAdt(tid, args) ->
      if tid == aid {
        var i = 0
        for p in a.tparams {
          match p {
            TyVar(_, id) -> if i < len(args) { m = map.insert(m, id, args[i]) }
            _ -> ()
          }
          i = i + 1
        }
      }
    _ -> ()
  }
  let em: Map[Int, Eff] = map.empty()
  var tys: List[Ty] = []
  for f in c.fields { tys = tys ++ [subst(f.ty, m, em)] }
  if len(fs) == 0 && not a.is_record { return c.name }
  if a.is_record {
    var out = ""
    var i = 0
    for f in fs {
      if str.len(out) > room { return c.name ++ " { " ++ out ++ ", … }" }
      let fname = if i < len(c.fields) { c.fields[i].name } else { "_" }
      let et = if i < len(tys) { tys[i] } else { TyError }
      let part = fname ++ ": " ++ render(adts, et, f, room - str.len(out))
      out = if i == 0 { part } else { out ++ ", " ++ part }
      i = i + 1
    }
    if out == "" { c.name ++ " {}" } else { c.name ++ " { " ++ out ++ " }" }
  } else {
    c.name ++ "(" ++ seq(adts, TyError, tys, fs, room) ++ ")"
  }
}

## A character literal, escaped the way the lexer reads one back.
fn char_lit(n: Int) -> String =
  match char.of(n) {
    Some(c) -> "'" ++ esc_char(c, '\'') ++ "'"
    # not a character at all (only an unchecked bridge makes one): say what it is
    None -> to_string(n)
  }

## A string literal, escaped, holding at most `room` of the string's code
## points -- the cut that follows marks where it stopped.
fn str_lit(s: String, room: Int) -> String = {
  var out = "\""
  var i = 0
  let cps = code_points(str.take(s, room + 1))
  let n = len(cps)
  while i < n {
    let c = cps[i]
    if c == '$' && i + 1 < n && cps[i + 1] == '{' {
      out = out ++ "\\$"
    } else {
      out = out ++ esc_char(c, '"')
    }
    i = i + 1
  }
  out ++ "\""
}

## One code point inside a literal delimited by `quote`: the escapes the
## lexer accepts (`lex_escape`), and `\u{...}` for any other control.
fn esc_char(c: Char, quote: Char) -> String =
  if c == '\n' { "\\n" }
  else if c == '\t' { "\\t" }
  else if c == '\r' { "\\r" }
  else if c == '\\' { "\\\\" }
  else if c == quote { "\\" ++ str.from_char(c) }
  else if char.code(c) < 0x20 || char.code(c) == 0x7F { "\\u{" ++ hex(char.code(c)) ++ "}" }
  else { str.from_char(c) }

# ---- literals (docs/lsp-hover-design.md §4) ----
#
# A literal's hover is its type and then one value line. The value comes from
# the parse tree (what the lexer made of the literal); the spelling, where it
# matters, from the document text, because the tree keeps only the value. A
# spelling that does not read back as that value -- the buffer moved under an
# analysis of an older revision -- costs the echo, never the value.

## An `Int` literal's value line. Written in decimal (underscores or not), it is
## the value as a constant shows one: `1000000  (0xF4240)`, the hexadecimal from
## 10 up. Written `0x`/`0b` (the only prefixes the lexer reads), the spelling is
## echoed and the decimal given: `0xFF = 255`. A plain decimal digit `0`..`9`
## has no line (`None`): its spelling, value and hexadecimal are one character,
## so the line would only echo it (gopls draws the same line).
pub(pkg) fn int_literal_text(spelling: String, v: Int) -> Option[String] = {
  let body = match str.strip_prefix(spelling, "-") {
    Some(b) -> b
    None -> spelling
  }
  if str.starts_with(body, "0x") || str.starts_with(body, "0b") {
    Some(spelling ++ " = " ++ to_string(v))
  } else if v >= 0 && v <= 9 && not str.contains(spelling, "_") && not str.starts_with(spelling, "-") {
    None
  } else {
    Some(to_string(v) ++ suffix(TyInt, VInt(v), false))
  }
}

## A `Char` literal's value line: the character as a literal (escaped the way
## the lexer reads one back, so `'\n'` stays visible), its code point, and the
## bytes UTF-8 encodes it as -- `'é'  U+00E9  UTF-8: C3 A9`. An escape spelling
## (`'\u{1F600}'`) gets the same line: the code point is the same either way.
pub(pkg) fn char_literal_text(cp: Int) -> String =
  char_lit(cp) ++ "  U+" ++ str.pad_start(hex(cp), 4, "0") ++ "  UTF-8: " ++ utf8_hex(cp)

## A `Float` literal's value line: the shortest spelling that reads back as the
## same double (`to_string`, std/fmt.dtoa -- what the program prints), and
## whether the literal *is* that double or was rounded to it. Dawn has no
## exact decimal expansion of a double and this does not write one: whether
## the written decimal is exactly a double is decided on the decimal itself
## (`float_exact`).
pub(pkg) fn float_literal_text(spelling: String, v: Float) -> String = {
  let shown = to_string(v)
  let reads_back = match parse_float(str.replace(spelling, "_", "")) {
    Some(f) -> f == v
    None -> false
  }
  if not reads_back { return shown }
  match float_exact(spelling) {
    Some(true) -> shown ++ "  (exact)"
    Some(false) -> shown ++ "  (not exactly representable)"
    None -> shown
  }
}

## A `String` literal's value line: the literal, escaped and cut as a constant's
## string is, then its length both ways a reader asks for it -- code points
## (what `str.len` counts, spec §11) and UTF-8 bytes (what it costs on the
## wire). Both always: the counts are the point of hovering, not a cut's mark.
pub(pkg) fn string_literal_text(s: String) -> String = {
  var cps = 0
  var bytes = 0
  for c in code_points(s) {
    cps = cps + 1
    bytes = bytes + len(utf8_bytes(char.code(c)))
  }
  cut_balanced(str_lit(s, VALUE_SHOWN + 1), VALUE_SHOWN) ++
    "  (" ++ counted(cps, "code point") ++ ", " ++ counted(bytes, "UTF-8 byte") ++ ")"
}

fn counted(n: Int, what: String) -> String =
  to_string(n) ++ " " ++ what ++ (if n == 1 { "" } else { "s" })

## The UTF-8 encoding of a scalar value (spec §1.5: `Char` holds no surrogate).
pub(pkg) fn utf8_bytes(cp: Int) -> List[Int] =
  if cp < 0x80 {
    [cp]
  } else if cp < 0x800 {
    [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)]
  } else if cp < 0x10000 {
    [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
  } else {
    [0xF0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3F), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
  }

fn utf8_hex(cp: Int) -> String = {
  var out = ""
  for b in utf8_bytes(cp) {
    let h = str.pad_start(hex(b), 2, "0")
    out = if out == "" { h } else { out ++ " " ++ h }
  }
  out
}

## The most significant digits a decimal can have and still be exactly a
## double: the longest exact expansion (a subnormal's) has 767. Past this the
## answer is no without dividing anything.
const EXACT_DIGITS: Int = 800

## 2^53: an odd significand at or above it is not a double's.
const TWO_53: Int = 9007199254740992

## Whether the decimal `spelling` (a Float literal: digits, a point, an
## exponent, underscores) is exactly a double; `None` for text that is not one.
##
## The literal's value is D × 10^k = D × 5^k × 2^k for an integer D. It is a
## double exactly when it is a dyadic rational odd × 2^e with odd < 2^53 and e
## inside the format (e >= -1074 for the smallest subnormal step, odd × 2^e
## below 2^1024). So: strip D's trailing zeros into k; for k < 0 divide D by
## 5^-k, failing on a remainder (then the value is not dyadic at all); halve
## out D's factors of two into e; what is left, times 5^k for k > 0, must be
## under 2^53. The arithmetic is long division of a short digit list by 5 or
## 2 -- bounded by `EXACT_DIGITS` -- never an expansion of the double.
fn float_exact(spelling: String) -> Option[Bool] = {
  var mant: List[Int] = []
  var frac = 0
  var seen_point = false
  var in_exp = false
  var exp_signed = false
  var exp_neg = false
  var exp = 0
  var exp_digits = 0
  for c in code_points(spelling) {
    let d = char.code(c) - char.code('0')
    if c == '_' {
      ()
    } else if in_exp {
      if (c == '+' || c == '-') && exp_digits == 0 && not exp_signed {
        exp_signed = true
        exp_neg = c == '-'
      } else if d >= 0 && d <= 9 {
        exp_digits = exp_digits + 1
        # far past any exponent a double reaches: saturate, do not overflow
        if exp < 100000 { exp = exp * 10 + d }
      } else {
        return None
      }
    } else if c == 'e' || c == 'E' {
      in_exp = true
    } else if c == '.' {
      if seen_point { return None }
      seen_point = true
    } else if d >= 0 && d <= 9 {
      mant = mant ++ [d]
      if seen_point { frac = frac + 1 }
    } else {
      return None
    }
  }
  if len(mant) == 0 || (in_exp && exp_digits == 0) { return None }
  # D's significant digits, most significant first; value = D × 10^k
  var k = (if exp_neg { -exp } else { exp }) - frac
  var first = 0
  while first < len(mant) && mant[first] == 0 { first = first + 1 }
  if first == len(mant) { return Some(true) }
  var last = len(mant)
  while mant[last - 1] == 0 {
    last = last - 1
    k = k + 1
  }
  if last - first > EXACT_DIGITS { return Some(false) }
  var ds: List[Int] = []
  var i = first
  while i < last {
    ds = ds ++ [mant[i]]
    i = i + 1
  }
  var fives = 0
  var e = 0
  if k >= 0 {
    # 5^23 > 2^53: no odd part survives that many fives
    if k > 22 { return Some(false) }
    fives = k
    e = k
  } else {
    var m = -k
    while m > 0 {
      match div_small(ds, 5) {
        Some(q) -> { ds = q }
        None -> return Some(false)
      }
      m = m - 1
    }
    e = k
  }
  while ds[len(ds) - 1] % 2 == 0 {
    match div_small(ds, 2) {
      Some(q) -> { ds = q }
      None -> return None
    }
    e = e + 1
  }
  # 10^16 > 2^53, so a longer odd part is already too wide (and would not
  # fit an Int to compare)
  if len(ds) > 16 { return Some(false) }
  var odd = 0
  for d in ds { odd = odd * 10 + d }
  while fives > 0 {
    if odd >= TWO_53 / 5 + 1 { return Some(false) }
    odd = odd * 5
    fives = fives - 1
  }
  if odd >= TWO_53 { return Some(false) }
  var bits = 0
  var n = odd
  while n > 0 {
    bits = bits + 1
    n = n / 2
  }
  Some(e >= -1074 && bits + e <= 1024)
}

## `ds / d` for a decimal digit list, most significant digit first, with no
## leading zero; `None` when `d` does not divide it.
fn div_small(ds: List[Int], d: Int) -> Option[List[Int]] = {
  var out: List[Int] = []
  var r = 0
  for x in ds {
    let cur = r * 10 + x
    let q = cur / d
    r = cur % d
    if len(out) > 0 || q != 0 { out = out ++ [q] }
  }
  if r == 0 { Some(out) } else { None }
}

# ---- tests ----

use check/cx.{cx_new}

fn prelude_adts() -> Adts = cx_new(None, None).adts

fn show(t: Ty, v: CValue) -> String =
  value_text(prelude_adts(), t, v).expect("a value with text")

test "each kind of value renders as Dawn source, read through its type" {
  assert show(TyInt, VInt(7)) == "7"
  assert show(TyInt, VInt(-300)) == "-300"
  assert show(TyFloat, VFloat(1.5)) == "1.5"
  assert show(TyBool, VBool(true)) == "true"
  assert show(TyUnit, VUnit) == "()"
  assert show(TyString, VStr("a\"b\n\${x}$5")) == "\"a\\\"b\\n\\\${x}$5\""
  assert show(ty_char(), VInt(97)) == "'a'"
  assert show(ty_char(), VInt(39)) == "'\\''"
  assert show(ty_char(), VInt(1)) == "'\\u{1}'"
  assert show(TyList(ty_char()), VList([VInt(120), VInt(121)])) == "['x', 'y']"
  assert show(TyTuple([TyInt, ty_char()]), VTuple([VInt(1), VInt(98)])) == "(1, 'b')"
  let opt = TyAdt(OPTION_ID, [ty_char()])
  assert show(opt, VAdt(OPTION_ID, 0, [VInt(122)])) == "Some('z')"
  assert show(opt, VAdt(OPTION_ID, 1, [])) == "None"
  # with no type to read, the value's own shape answers
  assert show(TyError, VAdt(OPTION_ID, 0, [VInt(122)])) == "Some(122)"
}

test "a record shows its field names, a sum constructor its positions" {
  let p = AdtI {
    ..adt_of(prelude_adts(), OPTION_ID),
    id: 900001, name: "P", is_record: true, tparams: [],
    ctors: [CtorI { adt: 900001, name: "P", fields: [
      FieldI { name: "x", ty: TyInt }, FieldI { name: "c", ty: ty_char() }] }]
  }
  let s = AdtI {
    ..adt_of(prelude_adts(), OPTION_ID),
    id: 900002, name: "Sh", is_record: false, tparams: [],
    ctors: [CtorI { adt: 900002, name: "Circle", fields: [FieldI { name: "r", ty: TyFloat }] },
      CtorI { adt: 900002, name: "Dot", fields: [] }]
  }
  let adts = map.insert(map.insert(prelude_adts(), 900001, p), 900002, s)
  let pv = VAdt(900001, 0, [VInt(1), VInt(122)])
  assert value_text(adts, TyAdt(900001, []), pv) == Some("P { x: 1, c: 'z' }")
  let sv = VList([VAdt(900002, 0, [VFloat(1.5)]), VAdt(900002, 1, [])])
  assert value_text(adts, TyList(TyAdt(900002, [])), sv) == Some("[Circle(1.5), Dot]")
}

test "an Int of 10 or more carries its hexadecimal; a negative one does not" {
  assert show(TyInt, VInt(9)) == "9"
  assert show(TyInt, VInt(10)) == "10  (0xA)"
  assert show(TyInt, VInt(42)) == "42  (0x2A)"
  assert show(TyInt, VInt(1048576)) == "1048576  (0x100000)"
  assert show(TyInt, VInt(-42)) == "-42"
  # a Char is an Int underneath, but its code point is not what it says
  assert show(ty_char(), VInt(120)) == "'x'"
  assert hex(0) == "0"
  assert hex(255) == "FF"
}

test "a long value is cut, closed, and says how long it was" {
  var xs: List[CValue] = []
  var i = 0
  while i < 360 {
    xs = xs ++ [VFloat(0.25)]
    i = i + 1
  }
  let lt = show(TyList(TyFloat), VList(xs))
  assert str.ends_with(lt, "…]  (360 elements)")
  assert str.len(lt) == VALUE_SHOWN + str.len("  (360 elements)")
  let st = show(TyString, VStr(str.repeat("ab", 100)))
  assert str.ends_with(st, "…\"  (200 code points)")
  assert str.starts_with(st, "\"abab")
  # one that fits is left alone, with no length
  assert show(TyList(TyInt), VList([VInt(1), VInt(2)])) == "[1, 2]"
}

test "a function value has no text" {
  let no_caps: Map[Int, CValue] = map.empty()
  assert value_text(prelude_adts(), TyInt, VClosure("m", "f", no_caps)) == None
}

test "an Int literal shows its value, and echoes a 0x or 0b spelling" {
  # a single decimal digit would only echo itself: the type alone
  assert int_literal_text("0", 0) == None
  assert int_literal_text("9", 9) == None
  assert int_literal_text("10", 10) == Some("10  (0xA)")
  assert int_literal_text("255", 255) == Some("255  (0xFF)")
  # underscores are spelling, not value
  assert int_literal_text("1_000_000", 1000000) == Some("1000000  (0xF4240)")
  assert int_literal_text("0_7", 7) == Some("7")
  assert int_literal_text("0x0", 0) == Some("0x0 = 0")
  assert int_literal_text("0xFF", 255) == Some("0xFF = 255")
  assert int_literal_text("0xff_ff", 65535) == Some("0xff_ff = 65535")
  assert int_literal_text("0b1010", 10) == Some("0b1010 = 10")
  # the one literal that carries its minus sign (spec §1.5)
  assert int_literal_text("-0x8000000000000000", -9223372036854775807 - 1) ==
    Some("-0x8000000000000000 = -9223372036854775808")
  assert int_literal_text("-9223372036854775808", -9223372036854775807 - 1) == Some("-9223372036854775808")
  # no spelling to read (another revision's span): the value alone
  assert int_literal_text("", 255) == Some("255  (0xFF)")
}

test "a Char literal shows its code point and UTF-8 bytes" {
  assert char_literal_text(0x61) == "'a'  U+0061  UTF-8: 61"
  assert char_literal_text(0xE9) == "'é'  U+00E9  UTF-8: C3 A9"
  assert char_literal_text(0x4E16) == "'世'  U+4E16  UTF-8: E4 B8 96"
  assert char_literal_text(0x1F600) == "'😀'  U+1F600  UTF-8: F0 9F 98 80"
  assert char_literal_text(10) == "'\\n'  U+000A  UTF-8: 0A"
  assert char_literal_text(0) == "'\\u{0}'  U+0000  UTF-8: 00"
  # each encoding length's last code point
  assert utf8_bytes(0x7F) == [0x7F]
  assert utf8_bytes(0x7FF) == [0xDF, 0xBF]
  assert utf8_bytes(0xFFFF) == [0xEF, 0xBF, 0xBF]
  assert str.ends_with(char_literal_text(0x10FFFF), "  U+10FFFF  UTF-8: F4 8F BF BF")
}

test "a Float literal shows its shortest spelling and whether it is exact" {
  assert float_literal_text("1.5", 1.5) == "1.5  (exact)"
  assert float_literal_text("1.1", 1.1) == "1.1  (not exactly representable)"
  assert float_literal_text("0.1", 0.1) == "0.1  (not exactly representable)"
  assert float_literal_text("0.0", 0.0) == "0.0  (exact)"
  assert float_literal_text("1_000.25", 1000.25) == "1000.25  (exact)"
  assert float_literal_text("2.50e3", 2500.0) == "2500.0  (exact)"
  # 0.1's double, written out in full, is that double exactly
  assert float_literal_text("0.1000000000000000055511151231257827021181583404541015625", 0.1) ==
    "0.1  (exact)"
  assert float_exact("0.1000000000000000055511151231257827021181583404541015625") == Some(true)
  assert float_exact("0.1000000000000000055511151231257827021181583404541015624") == Some(false)
  # integers: exact up to 2^53, and past it only with enough factors of two
  assert float_exact("9007199254740992.0") == Some(true)
  assert float_exact("9007199254740993.0") == Some(false)
  assert float_exact("1180591620717411303424.0") == Some(true)
  assert float_exact("1e22") == Some(true)
  assert float_exact("1e23") == Some(false)
  # out of range both ways
  assert float_exact("1e400") == Some(false)
  assert float_exact("1e-400") == Some(false)
  assert float_exact("5e-324") == Some(false)
  assert float_exact("0.5e-1073") == Some(false)
  assert float_exact("1.5e-3") == Some(false)
  assert float_exact("0.000_000_000_000_000_000_000_000_000_000_000_000_000_000_000_0") == Some(true)
  assert float_exact("1..5") == None
  # a spelling that is not this value claims nothing
  assert float_literal_text("2.5", 1.5) == "1.5"
}

test "a String literal shows its code points and UTF-8 bytes" {
  assert string_literal_text("") == "\"\"  (0 code points, 0 UTF-8 bytes)"
  assert string_literal_text("a") == "\"a\"  (1 code point, 1 UTF-8 byte)"
  assert string_literal_text("héllo\n") == "\"héllo\\n\"  (6 code points, 7 UTF-8 bytes)"
  assert string_literal_text("世😀") == "\"世😀\"  (2 code points, 7 UTF-8 bytes)"
  # a long one is cut where a constant's is, and still counts all of it
  let long = string_literal_text(str.repeat("ab", 100))
  assert str.starts_with(long, "\"abab")
  assert str.ends_with(long, "…\"  (200 code points, 200 UTF-8 bytes)")
  assert str.len(long) == VALUE_SHOWN + str.len("  (200 code points, 200 UTF-8 bytes)")
}

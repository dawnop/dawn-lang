## `TileProg` as Tile IR text: the `cuda_tile` dialect's assembly, one module
## with one entry, spelled the way `cuda-tile-translate` prints it. The text is
## layer 0 of tile-backend-design 6.2: scripts/tile-golden pins it byte for
## byte, and it is what a person reads when the bytecode (bytecode.dawn)
## disagrees with the device.
#
# The renderer spells; it does not decide. Which operations a program becomes,
# in what order, with which operands and value numbers, is lower.dawn's
# answer, shared with the bytecode writer, so this module is one line of
# assembly per `Instr` and nothing else, a `ForLoop` being its header line, its
# body two columns further in, and a closing brace. Spelling follows the
# specification's appendix example (vector add over `tile<ptr<f32>>`
# parameters) and the dialect's own round-trip tests
# (`test/Bytecode/operationsTest.mlir`: `make_token`, `token=%N` on the
# token-ordered memory operations, `for %iv in (%lo to %hi, step %st) :
# tile<i32> iter_values(%a = %init) -> (ty) { ... continue %v : ty }`).
use std/list
use std/str
use prog.{TileProg, TileOp, MakeToken, BlockId, Load, Store, ConstF, ConstI, Iota, Lanes, UnaryF, BinaryF, Fma, CmpF, CmpI, Select, IdxConst, IdxAdd, IdxMul, For, Continue}
use lower.{Kernel, Instr, Ty, Elem, Ref, lower, Token, Tile, Num, PtrTo, Arg, Val, MakeTok, BlockIds, ConstInt, ConstFloat, MulInt, AddInt, Reshape, Broadcast, IotaTile, Offset, LoadPtr, StorePtr, FloatUn, FloatBin, FloatFma, CmpFloat, CmpInt, SelectTile, ForLoop, Cont, Ret}

fn elem(e: Elem) -> String = match e {
  Num(name) -> name
  PtrTo(name) -> "ptr<${name}>"
}

## `t` as the assembly spells it: `token`, `tile<f64>`, `tile<128xf64>`.
pub fn ty(t: Ty) -> String = match t {
  Token -> "token"
  Tile(shape, e) -> match shape {
    [] -> "tile<${elem(e)}>"
    [n] -> "tile<${n}x${elem(e)}>"
    _ -> panic("tileir: a tile of rank ${len(shape)} has no spelling in this release")
  }
}

fn name(r: Ref) -> String = match r {
  Arg(pos) -> "%arg${pos}"
  Val(id) -> "%${id}"
}

fn v(id: Int) -> String = "%${id}"

fn commas(xs: List[String]) -> String =
  list.fold(xs, "", (acc, x) => if acc == "" { x } else { acc ++ ", " ++ x })

# `%a, %b = ` for the values an instruction defines, or nothing for none.
fn results(ids: List[Int]) -> String = if len(ids) == 0 { "" } else { commas(list.map(ids, v)) ++ " = " }

# The element format a tile type holds, as a constant's `<f64: ..>` prefix
# spells it.
fn elem_of(t: Ty) -> String = match t {
  Token -> panic("tileir: a token holds no element format")
  Tile(_shape, e) -> elem(e)
}

# `, %x` for an operand the assembly prints when it is there, "" for one it
# leaves out; `sep_ty` the same for the type list.
fn opt_operand(r: Option[Ref]) -> String = match r {
  Some(x) -> ", ${name(x)}"
  None -> ""
}

fn opt_ty(r: Option[Ref], t: Ty) -> String = match r {
  Some(_x) -> ", ${ty(t)}"
  None -> ""
}

# The predicate, as `custom<ComparisonPredicate>` prints it.
fn predicate(pred: String) -> String = match pred {
  "eq" -> "equal"
  "ne" -> "not_equal"
  "lt" -> "less_than"
  "le" -> "less_than_or_equal"
  "gt" -> "greater_than"
  "ge" -> "greater_than_or_equal"
  _ -> panic("tileir: `${pred}` is not a comparison predicate")
}

# The rounding mode is spelled by the operations that take one, and by no
# other: `maxf` and `minf` have `flush_to_zero` and `propagate_nan` and no
# rounding mode at all, and this is the list the bytecode writer encodes
# from as well.
fn rounds(op: String) -> Bool = op == "addf" || op == "subf" || op == "mulf" || op == "divf"

fn rounding(op: String) -> String = if rounds(op) { " rounding<nearest_even>" } else { "" }

fn line(i: Instr) -> String = match i {
  MakeTok(dst) -> "${v(dst)} = make_token : token"
  BlockIds(x, y, z) -> "${v(x)}, ${v(y)}, ${v(z)} = get_tile_block_id : tile<i32>"
  ConstInt(dst, t, value) -> "${v(dst)} = constant <${elem_of(t)}: ${value}> : ${ty(t)}"
  ConstFloat(dst, t, value) -> "${v(dst)} = constant <${elem_of(t)}: ${value}> : ${ty(t)}"
  MulInt(dst, t, lhs, rhs) -> "${v(dst)} = muli ${name(lhs)}, ${name(rhs)} : ${ty(t)}"
  AddInt(dst, t, lhs, rhs) -> "${v(dst)} = addi ${name(lhs)}, ${name(rhs)} : ${ty(t)}"
  Reshape(dst, src, from, to) -> "${v(dst)} = reshape ${name(src)} : ${ty(from)} -> ${ty(to)}"
  Broadcast(dst, src, from, to) -> "${v(dst)} = broadcast ${name(src)} : ${ty(from)} -> ${ty(to)}"
  IotaTile(dst, t) -> "${v(dst)} = iota : ${ty(t)}"
  Offset(dst, ptrs, offs, ptr_ty, off_ty) ->
    "${v(dst)} = offset ${name(ptrs)}, ${name(offs)} : ${ty(ptr_ty)}, ${ty(off_ty)} -> ${ty(ptr_ty)}"
  LoadPtr(dst, tok_out, ptrs, mask, pad, tok_in, ptr_ty, mask_ty, val_ty) ->
    "${v(dst)}, ${v(tok_out)} = load_ptr_tko weak ${name(ptrs)}${opt_operand(mask)}${opt_operand(pad)}"
    ++ " token=${name(tok_in)} : ${ty(ptr_ty)}${opt_ty(mask, mask_ty)}${opt_ty(pad, val_ty)}"
    ++ " -> ${ty(val_ty)}, token"
  StorePtr(tok_out, ptrs, value, mask, tok_in, ptr_ty, mask_ty, val_ty) ->
    "${v(tok_out)} = store_ptr_tko weak ${name(ptrs)}, ${name(value)}${opt_operand(mask)}"
    ++ " token=${name(tok_in)} : ${ty(ptr_ty)}, ${ty(val_ty)}${opt_ty(mask, mask_ty)} -> token"
  FloatUn(dst, op, t, src) -> "${v(dst)} = ${op} ${name(src)} : ${ty(t)}"
  FloatBin(dst, op, t, lhs, rhs) -> "${v(dst)} = ${op} ${name(lhs)}, ${name(rhs)}${rounding(op)} : ${ty(t)}"
  FloatFma(dst, t, lhs, rhs, acc) ->
    "${v(dst)} = fma ${name(lhs)}, ${name(rhs)}, ${name(acc)} rounding<nearest_even> : ${ty(t)}"
  CmpFloat(dst, pred, t, res_ty, lhs, rhs) ->
    "${v(dst)} = cmpf ${predicate(pred)} ordered ${name(lhs)}, ${name(rhs)} : ${ty(t)} -> ${ty(res_ty)}"
  CmpInt(dst, pred, t, res_ty, lhs, rhs) ->
    "${v(dst)} = cmpi ${predicate(pred)} ${name(lhs)}, ${name(rhs)}, signed : ${ty(t)} -> ${ty(res_ty)}"
  SelectTile(dst, cond_ty, t, cond, lhs, rhs) ->
    "${v(dst)} = select ${name(cond)}, ${name(lhs)}, ${name(rhs)} : ${ty(cond_ty)}, ${ty(t)}"
  ForLoop(res, tys, iv, lower, upper, step, inits, carried, _body) -> {
    let iters = if len(inits) == 0 {
      ""
    } else {
      let pairs = list.map(range(0, len(inits)), k => "${v(carried[k])} = ${name(inits[k])}")
      " iter_values(${commas(pairs)}) -> (${commas(list.map(tys, ty))})"
    }
    "${results(res)}for ${v(iv)} in (${name(lower)} to ${name(upper)}, step ${name(step)}) : tile<i32>${iters} {"
  }
  Cont(values, tys) ->
    if len(values) == 0 { "continue" } else { "continue ${commas(list.map(values, name))} : ${commas(list.map(tys, ty))}" }
  Ret -> "return"
}

# An instruction at `indent` columns: one line, or for a loop its header,
# its body two columns further in, and the closing brace.
fn lines(indent: String, i: Instr) -> List[String] = match i {
  ForLoop(_res, _tys, _iv, _lower, _upper, _step, _inits, _carried, body) ->
    [indent ++ line(i)] ++ block(indent ++ "  ", body) ++ [indent ++ "}"]
  _ -> [indent ++ line(i)]
}

fn block(indent: String, body: List[Instr]) -> List[String] = {
  let none: List[String] = []
  list.fold(body, none, (acc, i) => acc ++ lines(indent, i))
}

fn join(lines: List[String]) -> String = list.fold(lines, "", (acc, l) => acc ++ l ++ "\n")

## `k` as one `cuda_tile.module @m` holding one `entry @<name>`. Every
## parameter is a scalar pointer tile of its dtype; the body is `k.body` in
## order, one line each. The text ends with a newline.
pub fn render_kernel(k: Kernel) -> String = {
  var args: List[String] = []
  var i = 0
  for dt in k.params {
    args = args ++ ["%arg${i}: ${ty(Tile([], PtrTo(dt)))}"]
    i = i + 1
  }
  let head = commas(args)
  join(["cuda_tile.module @m {", "  entry @${k.name}(${head}) {"] ++ block("    ", k.body) ++ ["  }", "}"])
}

## `prog` lowered and rendered.
pub fn render(prog: TileProg) -> String = render_kernel(lower(prog))

# ---- tests ----
#
# The byte-for-byte pin is scripts/tile-golden (both backends, against the
# recorded .mlir). These blocks pin the pieces a golden diff would only show
# as a whole: the ladder is emitted once per parameter, the token chain is the
# program's, and the value names are the table's numbers.

fn two_loads_one_param() -> TileProg = TileProg {
  name: "twice",
  params: ["f64"],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    Load(2, 3, 0, "f64", 1, 128, None, None, 0),
    Load(4, 5, 0, "f64", 1, 128, None, None, 3),
    BinaryF(6, "addf", "f64", 128, 2, 4),
    Store(7, 0, "f64", 1, 128, 6, None, 5)
  ]
}

fn count(hay: String, needle: String) -> Int = len(str.split(hay, needle)) - 1

test "the pointer ladder for one parameter at one index is emitted once, not once per memory operation" {
  let text = render(two_loads_one_param())
  assert count(text, " = offset ") == 1
  assert count(text, " = iota ") == 1
  assert count(text, "load_ptr_tko weak ") == 2
  assert count(text, "store_ptr_tko weak ") == 1
}

test "the token chain in the text is the program's: make_token feeds the first load, each memory op feeds the next" {
  let text = render(two_loads_one_param())
  assert str.contains(text, "%0 = make_token : token\n")
  assert str.contains(text, "%13, %14 = load_ptr_tko weak %12 token=%0 :")
  assert str.contains(text, "%15, %16 = load_ptr_tko weak %12 token=%14 :")
  assert str.contains(text, "%18 = store_ptr_tko weak %12, %17 token=%16 :")
  assert str.contains(text, "%17 = addf %13, %15 rounding<nearest_even> : tile<128xf64>\n")
}

test "the entry signature lists every parameter as a scalar pointer tile of its format" {
  let p = TileProg { name: "k", params: ["f32", "f64"], ops: [MakeToken(0)] }
  let text = render(p)
  assert str.starts_with(text, "cuda_tile.module @m {\n  entry @k(%arg0: tile<ptr<f32>>, %arg1: tile<ptr<f64>>) {\n")
  assert str.ends_with(text, "    return\n  }\n}\n")
}

test "block ids along the three axes bind the matching result of one get_tile_block_id" {
  let p = TileProg {
    name: "axes",
    params: ["f64"],
    ops: [MakeToken(0), BlockId(1, 2), Load(2, 3, 0, "f64", 1, 8, None, None, 0)]
  }
  let text = render(p)
  assert str.contains(text, "%1, %2, %3 = get_tile_block_id : tile<i32>\n")
  assert str.contains(text, "= muli %3, %4 : tile<i32>\n")
}

test "types are spelled as the assembly spells them" {
  assert ty(Token) == "token"
  assert ty(Tile([], Num("i32"))) == "tile<i32>"
  assert ty(Tile([64], PtrTo("f32"))) == "tile<64xptr<f32>>"
}

test "rendering the same program twice gives the same text" {
  assert render(two_loads_one_param()) == render(two_loads_one_param())
}

fn sum_prog() -> TileProg = TileProg {
  name: "sum",
  params: ["f64", "f64"],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 4),
    IdxMul(3, 1, 2),
    Load(4, 5, 0, "f64", 3, 128, None, None, 0),
    IdxConst(6, 1),
    IdxAdd(7, 3, 6),
    IdxAdd(8, 3, 2),
    For(9, 7, 8, 6, [4, 5], [10, 11], [15, 16], [
      Load(12, 13, 0, "f64", 9, 128, None, None, 11),
      BinaryF(14, "addf", "f64", 128, 10, 12),
      Continue([14, 13])
    ]),
    Store(17, 1, "f64", 1, 128, 15, None, 16)
  ]
}

test "a loop is its header with the carried values, a body two columns in, and a closing brace" {
  let text = render(sum_prog())
  assert str.contains(text, "\n    %20, %21 = for %22 in (%18 to %19, step %17) : tile<i32> iter_values(%23 = %15, %24 = %16) -> (tile<128xf64>, token) {\n")
  assert str.contains(text, "\n      %34, %35 = load_ptr_tko weak %33 token=%24 : tile<128xptr<f64>> -> tile<128xf64>, token\n")
  assert str.contains(text, "\n      %36 = addf %23, %34 rounding<nearest_even> : tile<128xf64>\n")
  assert str.contains(text, "\n      continue %36, %35 : tile<128xf64>, token\n    }\n")
  # after the loop, the store takes the loop's results
  assert str.contains(text, "store_ptr_tko weak %45, %20 token=%21 :")
  assert str.ends_with(text, "    return\n  }\n}\n")
}

test "index arithmetic spells as scalar i32 constant, addi and muli" {
  let text = render(sum_prog())
  assert str.contains(text, "\n    %4 = constant <i32: 4> : tile<i32>\n    %5 = muli %1, %4 : tile<i32>\n")
  assert str.contains(text, "\n    %18 = addi %5, %17 : tile<i32>\n    %19 = addi %5, %4 : tile<i32>\n")
}

# A real continue/backedge and break abandon uninitialized receiver locals.
# The first NEW must still initialize its Java class before argument effects.
use std/io
use java "operandprobe.InitOrder"

pub fn main() -> Unit !io = {
  if args() == ["control"] {
    let value = InitOrder.new({
      println("argument 1")
      1
    })
    println("done")
  } else {
    for h in [-1, 1, 0, 2] {
      let value = InitOrder.new({
        println("argument ${h}")
        if h < 0 { continue }
        if h == 0 { break }
        h
      })
      println("done")
    }
  }
}

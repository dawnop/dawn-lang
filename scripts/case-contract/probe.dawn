# Contract for simple (1:1) Unicode case mapping, and the generator for the C
# runtime's table.
#
# `str.lower`/`str.upper` are *simple* mapping: one code point in, one out, no
# locale and no context (docs/native-backend-plan.md 14.12). The JVM backend
# gets that from `Character.toUpperCase(int)`, which is exactly the simple
# mapping; the C runtime has no Unicode tables of its own, so it carries one
# generated from the same oracle.
#
# That makes the oracle the single definition and each backend an implementation
# of it, which is the whole point -- but only as long as the two stay tied
# together. Hence the two modes:
#
#   (default)            checks both implementations against the oracle: the
#                        *committed* table, code point by code point, and the
#                        compiled `str.upper`/`str.lower` over every code point
#                        that has a mapping plus a spread of ones that do not.
#   DAWN_CASE_EMIT=1     print the table, for regenerating the header.
#
# The default mode reads the header rather than regenerating and diffing it,
# because what the C runtime compiles is the header -- a byte diff would also
# fail on a formatting change, and would say "these files differ" where this
# says which code point and what it should have been.
use std/io
use std/list
use std/str
use java "java.lang.Character"
use java "java.lang.System"

const LAST: Int = 0x10FFFF

## Surrogates are not characters; `Character.toUpperCase` maps them to
## themselves and no string can hold one, so they are left out of both halves.
fn is_surrogate(cp: Int) -> Bool = cp >= 0xD800 && cp <= 0xDFFF

fn oracle(cp: Int, up: Bool) -> Int !io =
  if up { Character.toUpperCase(cp) } else { Character.toLowerCase(cp) }

fn one(cp: Int) -> String = from_code_points([cp])

fn only_cp(s: String) -> Int = get(code_points(s), 0).expect("one code point")

# ---- the table ----

## Runs of consecutive code points whose mapping is the same offset from the
## code point itself, which is how a table this sparse stays small: 1.1M code
## points come out as a few hundred ranges.
fn ranges(up: Bool) -> List[(Int, Int, Int)] !io = {
  var out: List[(Int, Int, Int)] = []
  var lo = -1
  var hi = -1
  var delta = 0
  var cp = 0
  while cp <= LAST {
    if is_surrogate(cp) {
      cp = cp + 1
    } else {
      let d = oracle(cp, up) - cp
      if d == 0 {
        if lo >= 0 {
          out = out ++ [(lo, hi, delta)]
          lo = -1
        }
      } else if lo >= 0 && d == delta && cp == hi + 1 {
        hi = cp
      } else {
        if lo >= 0 { out = out ++ [(lo, hi, delta)] }
        lo = cp
        hi = cp
        delta = d
      }
      cp = cp + 1
    }
  }
  if lo >= 0 { out = out ++ [(lo, hi, delta)] }
  out
}

const HEX: String = "0123456789ABCDEF"

fn hex4(n: Int) -> String =
  if n >= 16 { hex4(n / 16) ++ hex_digit(n % 16) } else { hex_digit(n) }

fn hex_digit(n: Int) -> String = str.substring(HEX, n, n + 1)

fn pad4(s: String) -> String = if str.len(s) >= 4 { s } else { pad4("0" ++ s) }

fn cp_lit(n: Int) -> String = "0x" ++ pad4(hex4(n))

fn row(r: (Int, Int, Int)) -> String = {
  let (lo, hi, delta) = r
  "    {" ++ cp_lit(lo) ++ ", " ++ cp_lit(hi) ++ ", " ++ to_string(delta) ++ "},"
}

fn emit_table(name: String, rs: List[(Int, Int, Int)]) -> Unit !io = {
  io.println("static const dawn_case_range " ++ name ++ "[] = {")
  for r in rs { io.println(row(r)) }
  io.println("};")
  io.println("")
}

fn emit() -> Unit !io = {
  io.println("/* Simple (1:1) Unicode case mapping, as ranges of code points that share")
  io.println(" * one offset. GENERATED by scripts/case-contract/probe.dawn -- do not edit;")
  io.println(" * scripts/case-contract/run.sh regenerates this and fails on a difference.")
  io.println(" *")
  io.println(" * The JVM backend calls Character.toUpperCase/toLowerCase, which *is* this")
  io.println(" * mapping, so this table is how the C runtime answers the same function.")
  io.println(" * Full mapping (the one where a sharp s uppercases to two letters) is")
  io.println(" * locale- and context-sensitive and belongs in a library, not here. */")
  io.println("#ifndef DAWN_CASE_TABLE_H")
  io.println("#define DAWN_CASE_TABLE_H")
  io.println("")
  io.println("#include <stdint.h>")
  io.println("")
  io.println("typedef struct {")
  io.println("  int32_t lo;")
  io.println("  int32_t hi;")
  io.println("  int32_t delta;")
  io.println("} dawn_case_range;")
  io.println("")
  emit_table("dawn_upper_ranges", ranges(true))
  emit_table("dawn_lower_ranges", ranges(false))
  io.println("#endif /* DAWN_CASE_TABLE_H */")
}

# ---- the contract ----

## Every code point the oracle maps somewhere, plus one in every 1009 that it
## should leave alone. This is the JVM backend's half: what it catches is the
## *walk* -- surrogate pairs rebuilt wrong, a code-point count that did not
## survive, a mapping applied to the wrong unit.
fn interesting(cp: Int) -> Bool !io =
  not is_surrogate(cp) &&
  (oracle(cp, true) != cp || oracle(cp, false) != cp || cp % 1009 == 0)

fn check_walk() -> (Int, Int) !io = {
  var bad = 0
  var seen = 0
  var cp = 0
  while cp <= LAST {
    if interesting(cp) {
      seen = seen + 1
      let s = one(cp)
      let u = str.to_upper(s)
      let l = str.to_lower(s)
      if str.len(u) != 1 || str.len(l) != 1 {
        bad = bad + 1
        io.println("count " ++ cp_lit(cp) ++ " upper=" ++ to_string(str.len(u)) ++
            " lower=" ++ to_string(str.len(l)))
      } else if only_cp(u) != oracle(cp, true) {
        bad = bad + 1
        io.println("upper " ++ cp_lit(cp) ++ " got " ++ cp_lit(only_cp(u)) ++
            " want " ++ cp_lit(oracle(cp, true)))
      } else if only_cp(l) != oracle(cp, false) {
        bad = bad + 1
        io.println("lower " ++ cp_lit(cp) ++ " got " ++ cp_lit(only_cp(l)) ++
            " want " ++ cp_lit(oracle(cp, false)))
      }
    }
    cp = cp + 1
  }
  (seen, bad)
}

# ---- the C runtime's half: the committed table, against the same oracle ----

fn header_path() -> String !io =
  match io.getenv("DAWN_CASE_HEADER") {
    Some(p) -> p
    None -> "runtime/c/dawn_case_table.h"
  }

fn hex_val(s: String) -> Int =
  if str.starts_with(s, "0x") {
    parse_int_radix(str.substring(s, 2, str.len(s)), 16).expect("hex literal")
  } else {
    parse_int(s).expect("decimal literal")
  }

## `    {0x0061, 0x007A, -32},` -> (0x61, 0x7A, -32).
fn parse_row(line: String) -> (Int, Int, Int) = {
  let inner = str.substring(line, 1, str.len(line) - 2)
  let parts = str.split(inner, ",")
  (hex_val(str.trim(parts[0])), hex_val(str.trim(parts[1])), hex_val(str.trim(parts[2])))
}

## The two arrays out of the header, in the order they are declared.
fn read_table(text: String) -> (List[(Int, Int, Int)], List[(Int, Int, Int)]) = {
  var upper: List[(Int, Int, Int)] = []
  var lower: List[(Int, Int, Int)] = []
  var in_upper = false
  var in_lower = false
  for line in str.split(text, "\n") {
    let t = str.trim(line)
    if str.contains(t, "dawn_upper_ranges[]") {
      in_upper = true
      in_lower = false
    } else if str.contains(t, "dawn_lower_ranges[]") {
      in_lower = true
      in_upper = false
    } else if str.starts_with(t, "{") {
      let r = parse_row(t)
      if in_upper { upper = upper ++ [r] } else if in_lower { lower = lower ++ [r] }
    } else if t == "};" {
      in_upper = false
      in_lower = false
    }
  }
  (upper, lower)
}

## Walk the code points and the (sorted, disjoint) ranges together, so this is
## one pass over each rather than a search per code point.
fn check_table(rs: List[(Int, Int, Int)], up: Bool) -> Int !io = {
  var bad = 0
  var i = 0
  var cp = 0
  while cp <= LAST {
    if is_surrogate(cp) {
      cp = cp + 1
    } else {
      while i < len(rs) && {
        let (_, hi, _) = rs[i]
        hi < cp
      } {
        i = i + 1
      }
      var got = cp
      if i < len(rs) {
        let (lo, hi, delta) = rs[i]
        if lo <= cp && cp <= hi { got = cp + delta }
      }
      let want = oracle(cp, up)
      if got != want {
        if bad < 12 {
          io.println("table " ++ (if up { "upper " } else { "lower " }) ++ cp_lit(cp) ++
              " has " ++ cp_lit(got) ++ " want " ++ cp_lit(want))
        }
        bad = bad + 1
      }
      cp = cp + 1
    }
  }
  bad
}

fn check() -> Unit !io = {
  let (seen, walk_bad) = check_walk()
  let text =
    match io.read_file(header_path()) {
      Ok(t) -> t
      Err(e) -> panic("cannot read " ++ header_path() ++ ": " ++ e)
    }
  let (upper, lower) = read_table(text)
  # the JDK is the oracle, so which one answered is part of the result: a
  # mismatch here is almost always a Unicode version that moved under the table
  io.println("jdk " ++
      match System.getProperty("java.version") {
        Some(v) -> v
        None -> "?"
      })
  io.println("ranges " ++ to_string(len(upper)) ++ " upper, " ++ to_string(len(lower)) ++ " lower")
  let table_bad = check_table(upper, true) + check_table(lower, false)
  io.println("checked " ++ to_string(seen))
  io.println("mismatches " ++ to_string(walk_bad + table_bad))
}

pub fn main() -> Unit !io =
  match io.getenv("DAWN_CASE_EMIT") {
    Some(_) -> emit()
    None -> check()
  }

## The host side of a GPU: a `Gpu` effect whose operations a handler answers,
## typed tensors over it, a fake device that answers every operation from
## host memory so a `!Gpu` program runs on a machine with no GPU at all, and
## the real device, `with_gpu_real`, which answers the same operations from
## the CUDA driver through the native runtime. The device side (kernels,
## Tile IR) is not here; see docs/tile-backend-design.md.
#
# The shape is std/io's `Fs`: a plain `effect` declaration, plain functions
# over its operations, and a plain wrapper function as each handler. Effect
# operations cannot be generic (spec §6.5), so the operations traffic in raw
# handles and dtype names; the functions below add the phantom-typed
# `Tensor[D]` and are the only surface a program uses.
#
# The seam sits BELOW the error surface, as `Fs`'s does. A handler answers
# with the raw outcome of the device it stands for; the checks std makes
# itself (`alloc`'s length, `upload`'s length, `launch`'s grid) live in the
# functions above the operations, so they are the code under test under
# every handler, and the three failure kinds they mint are the same string
# under every handler.
#
# Two handlers. `with_gpu_fake` is pure, which is what lets it run inside
# `dawn test --stdlib` and at comptime; `with_gpu_real` is `!io` and stands on
# the `gpu_*_host` intrinsics (tile-backend-design §4.2, §4.4), which only the
# native runtime implements: on the JVM every one of them answers
# `gpu.unsupported_backend`, and the handler passes that on unchanged.
use std/bytes
use std/list
use std/map
use std/narrow

# ---- element formats ----

## Marker types for element formats: values with no content, passed where a
## function needs to know the format of a tensor it is about to create.
## `Dtype` is implemented for each; nothing else is. A marker names a format
## a buffer holds; the values a program moves in and out are `Float` under
## every format (`upload` / `download`), so a marker is not std/narrow's
## value type of the same name (`narrow.BF16` is a number, `gpu.BF16` is a
## label), the way `gpu.F32` was never `narrow.F32`.
pub type F64 = | F64

## The 32-bit float format. Neither handler moves it in this release, so a
## tensor of this format can be typed but not allocated.
pub type F32 = | F32

## The bfloat16 format: two bytes an element. A buffer of it holds bf16
## values; `upload` rounds each Float to the nearest one (ties to even, the
## conversion a device's own load would perform) and `download` answers each
## exactly, as a Float. The device's `addf` over bf16 tiles is then
## `narrow.round_bf16` of the exact sum, bit for bit (tile-backend-design
## 3.2's theorem), which is what the fake device computes.
pub type BF16 = | BF16

## What a device needs to know about an element format. The marker value is
## the first argument so the methods can be called by name (spec §3.5: a type
## parameter that appears in no argument position cannot be inferred).
pub trait Dtype[D] {
  fn dtype_name(d: D) -> String
  fn dtype_bytes(d: D) -> Int
}

impl Dtype[F64] {
  fn dtype_name(d: F64) -> String = "f64"
  fn dtype_bytes(d: F64) -> Int = 8
}

impl Dtype[F32] {
  fn dtype_name(d: F32) -> String = "f32"
  fn dtype_bytes(d: F32) -> Int = 4
}

impl Dtype[BF16] {
  fn dtype_name(d: BF16) -> String = "bf16"
  fn dtype_bytes(d: BF16) -> Int = 2
}

## The bytes one element of the named format occupies in a device buffer, or
## `None` for a format this release's handlers do not move: `f64` (8) and
## `bf16` (2). Both handlers consult this and nothing else to accept a
## `gpu_alloc`, so they refuse the same formats with `gpu.unsupported_dtype`.
pub fn element_bytes(dtype: String) -> Option[Int] = match dtype {
  "f64" -> Some(8)
  "bf16" -> Some(2)
  _ -> None
}

## `x` as a buffer of the named format holds it: rounded to bfloat16 for
## `bf16`, to binary32 for `f32`, unchanged for `f64`. What a store into such
## a buffer does to a value, and what a reference implementation does after
## every operation whose result the device would keep at that width.
pub fn round_to(dtype: String, x: Float) -> Float = match dtype {
  "bf16" -> narrow.round_bf16(x)
  "f32" -> narrow.round_f32(x)
  _ -> x
}

# ---- the bf16 wire format ----

## `xs` as the bytes a bf16 buffer holds: each value rounded to the nearest
## bfloat16, then its 16-bit pattern, low byte first. The rounding is this
## function's: `narrow.bf16_bits` truncates a value off the grid, and a
## truncating upload would put a different number on the device than the
## fake device holds.
pub fn pack_bf16(xs: List[Float]) -> Bytes = {
  var b = bytes.buf()
  for x in xs {
    let bits = narrow.bf16_bits(narrow.round_bf16(x))
    b = bytes.put(bytes.put(b, bits & 0xFF), bits >>> 8)
  }
  bytes.freeze(b)
}

## The values a bf16 buffer holds, from its bytes: one per two bytes, each
## the exact Float of its pattern.
pub fn unpack_bf16(b: Bytes) -> List[Float] =
  list.map(range(0, bytes.len(b) / 2), i => narrow.bf16_of_bits(bytes.at(b, 2 * i) | (bytes.at(b, 2 * i + 1) << 8)))

# ---- tensors ----

## A tensor on the device: the handle the handler issued and its element
## count. `D` is a phantom (spec §2.7): `Tensor[F64]` and `Tensor[F32]` are two
## types over one representation, so a kernel argument of the wrong format is
## a type error and not a launch failure.
pub opaque type Tensor[D] = (Int, Int)

## The handle a handler issued for `t`, as `launch` wants it.
pub fn handle_of[D](t: Tensor[D]) -> Int = {
  let p: (Int, Int) = t
  let (h, _n) = p
  h
}

## The number of elements `t` was allocated with.
pub fn size[D](t: Tensor[D]) -> Int = {
  let p: (Int, Int) = t
  let (_h, n) = p
  n
}

# ---- the effect ----

## The device, as operations a handler answers. Names carry a `gpu_` prefix
## because `use std/gpu.{Gpu}` brings every operation into the importing
## module's own namespace (spec §6.5).
##
## Every operation answers `Result`, with an `Err` for what the device
## refused. `gpu_alloc` answers a fresh handle for `len` elements of the named
## format; `gpu_upload` and `gpu_download` move a whole buffer; `gpu_launch`
## runs the kernel of that name over a one-dimensional grid with the given
## buffers as its arguments; `gpu_sync` waits for every launch so far.
## Handles are opaque integers a program never invents.
pub effect Gpu {
  fn gpu_alloc(dtype: String, len: Int) -> Result[Int, ForeignError]
  fn gpu_upload(handle: Int, data: List[Float]) -> Result[Unit, ForeignError]
  fn gpu_download(handle: Int) -> Result[List[Float], ForeignError]
  fn gpu_launch(kernel: String, grid: Int, args: List[Int]) -> Result[Unit, ForeignError]
  fn gpu_free(handle: Int) -> Result[Unit, ForeignError]
  fn gpu_sync() -> Result[Unit, ForeignError]
}

# std's own refusals. Minted above the operations, so they read the same under
# every handler; a device's own refusals arrive as whatever it called them.
fn refuse(kind: String, message: String) -> ForeignError =
  ForeignError { kind: kind, message: message, cause: None }

## A tensor of `len` elements of format `d`. `Err(kind: "gpu.bad_length")`
## for a `len` below one, before any handler is asked.
pub fn alloc[D: Dtype](d: D, len: Int) -> Result[Tensor[D], ForeignError] !Gpu =
  if len < 1 {
    Err(refuse("gpu.bad_length", "gpu.alloc: a tensor has at least one element, got ${len}"))
  } else {
    match gpu_alloc(dtype_name(d), len) {
      Ok(h) -> {
        let t: Tensor[D] = (h, len)
        Ok(t)
      }
      Err(e) -> Err(e)
    }
  }

## Copy `data` into `t`. `Err(kind: "gpu.length_mismatch")` when `data` does
## not have exactly `size(t)` elements, before any handler is asked.
pub fn upload[D](t: Tensor[D], data: List[Float]) -> Result[Unit, ForeignError] !Gpu = {
  let n = size(t)
  if len(data) != n {
    Err(refuse("gpu.length_mismatch",
      "gpu.upload: the tensor holds ${n} element(s), the data has ${len(data)}"))
  } else {
    gpu_upload(handle_of(t), data)
  }
}

## The contents of `t`, `size(t)` elements.
pub fn download[D](t: Tensor[D]) -> Result[List[Float], ForeignError] !Gpu =
  gpu_download(handle_of(t))

## Release `t`. Its handle answers nothing afterwards.
pub fn free[D](t: Tensor[D]) -> Result[Unit, ForeignError] !Gpu = gpu_free(handle_of(t))

## Run the kernel named `kernel` over `grid` blocks with `args` as its
## arguments, in order. `Err(kind: "gpu.bad_grid")` for a `grid` below one,
## before any handler is asked; a name no handler knows is the handler's
## refusal (`gpu.no_kernel` from the fake device).
pub fn launch(kernel: String, grid: Int, args: List[Int]) -> Result[Unit, ForeignError] !Gpu =
  if grid < 1 {
    Err(refuse("gpu.bad_grid", "gpu.launch: a grid has at least one block, got ${grid}"))
  } else {
    gpu_launch(kernel, grid, args)
  }

## Wait until every launch so far has finished. A launch returning is not the
## kernel having run; a download after `sync` sees the kernel's writes.
pub fn sync() -> Result[Unit, ForeignError] !Gpu = gpu_sync()

# ---- the fake device ----

## Element-wise addition of the first two arguments, each sum rounded to
## the format of the last (the output): the host-side reference for the
## `vadd` kernels of every format, and the first entry of
## `reference_kernels`. `dtypes` is the format of each argument buffer in
## order, as the fake device passes it; the device's `addf` rounds its
## result to the tile's format, and so does this.
pub fn vadd_ref(dtypes: List[String], ins: List[List[Float]]) -> List[Float] = {
  let a = ins[0]
  let b = ins[1]
  let out = dtypes[len(dtypes) - 1]
  list.map(range(0, len(a)), i => round_to(out, a[i] + b[i]))
}

## Block-wise tile sum of the first argument into the second: the host-side
## reference for the `sum` kernel. `out` has `128 * blocks` elements and `x`
## has `chunks` times as many; block `b` folds the `chunks` consecutive
## 128-wide tiles of `x` numbered `b * chunks` onward into one tile of `out`,
## lane by lane: `out[b * 128 + j]` is the first of those tiles' lane `j`,
## plus the second's, plus the third's, and so on in tile order. That is
## the order the kernel adds in (its loop carries the first tile in and adds
## one tile per iteration), so the two agree bit for bit under IEEE double
## addition; a fold from zero would differ on `-0.0`, a pairwise or reversed
## fold on carries. `chunks` is `len(x) / len(out)`; a shape the kernel
## would read out of bounds on (`len(out)` not a multiple of 128, `len(x)`
## not a multiple of `len(out)`) is the caller's bug and reads out of range
## here as it would there. Every addition is rounded to the output's format
## (`dtypes[1]`), the way the kernel's accumulator tile is at that width.
pub fn sum_ref(dtypes: List[String], ins: List[List[Float]]) -> List[Float] = {
  let x = ins[0]
  let out = ins[1]
  let dt = dtypes[1]
  let w = 128
  let n = len(out)
  let chunks = if n == 0 { 0 } else { len(x) / n }
  list.map(range(0, n), i => {
    let b = i / w
    let j = i % w
    if chunks == 0 {
      0.0
    } else {
      list.fold(range(1, chunks), x[(b * chunks) * w + j], (acc, k) => round_to(dt, acc + x[(b * chunks + k) * w + j]))
    }
  })
}

## The reference implementations the fake device answers `launch` with, by
## kernel name: `vadd`, `vadd_bf16` (one reference; the buffers tell it the
## format) and `sum` in this release.
pub fn reference_kernels() -> Map[String, fn(List[String], List[List[Float]]) -> List[Float]] =
  map.from([("vadd", vadd_ref), ("vadd_bf16", vadd_ref), ("sum", sum_ref)])

fn no_such_buffer(who: String, handle: Int) -> ForeignError =
  refuse("gpu.no_such_buffer", "${who}: no buffer with handle ${handle}")

fn no_kernel(who: String, kernel: String) -> ForeignError =
  refuse("gpu.no_kernel", "${who}: no kernel named `${kernel}`")

fn no_arguments(who: String, kernel: String) -> ForeignError =
  refuse("gpu.no_arguments", "${who}: `${kernel}` launched with no buffers")

## Run `body` against a device that is a table in host memory. Handles count
## up from 1 per installation; a buffer is its format and a `List[Float]`
## holding values of that format, and the formats are `element_bytes`'s
## (`gpu.unsupported_dtype` otherwise); a handle that was never issued or
## was freed answers `gpu.no_such_buffer`. `gpu_launch` looks `kernel` up in
## `kernels`, hands the reference implementation the format and the contents
## of every argument buffer in order, and stores what it returns as the
## contents of the LAST argument; `grid` is not consulted, a reference
## implementation computes the whole vector at once; an unknown name answers
## `gpu.no_kernel`. A buffer holds what memory of its format would: what
## `gpu_upload` stores and what a launch writes is rounded to the buffer's
## format (`round_to`), which for `f64` is the data as given. The length
## check is `upload`'s, above the operation, and is the same code under
## every handler.
##
## Pure. Two installations share nothing.
#
# No `|> list.map(...)` anywhere in this module's non-test code: the pipe
# contract's drop-method-prepend mutant removes the parser arm that pipes
# into a qualified call, and std has to keep compiling under it so that the
# mutant reddens the assertions it owns and nothing else (measured: one such
# pipe here turned every pipe-contract assertion red).
pub fn with_gpu_fake[T](kernels: Map[String, fn(List[String], List[List[Float]]) -> List[Float]],
  body: fn() -> T !Gpu) -> T = {
  with handle Gpu {
    var next: Int = 1
    var store: Map[Int, (String, List[Float])] = map.empty()
    gpu_alloc(dtype, len) => match element_bytes(dtype) {
      None -> Err(refuse("gpu.unsupported_dtype", "fake device: buffers are f64 or bf16, got ${dtype}"))
      Some(_w) -> {
        let h = next
        next = next + 1
        store = map.insert(store, h, (dtype, list.map(range(0, len), _i => 0.0)))
        Ok(h)
      }
    }
    gpu_upload(handle, data) => match map.get(store, handle) {
      Some(b) -> {
        let (dt, _old) = b
        store = map.insert(store, handle, (dt, list.map(data, x => round_to(dt, x))))
        Ok(())
      }
      None -> Err(no_such_buffer("fake device", handle))
    }
    gpu_download(handle) => match map.get(store, handle) {
      Some(b) -> {
        let (_dt, v) = b
        Ok(v)
      }
      None -> Err(no_such_buffer("fake device", handle))
    }
    gpu_launch(kernel, _grid, args) => match map.get(kernels, kernel) {
      Some(f) ->
        if len(args) == 0 {
          Err(no_arguments("fake device", kernel))
        } else {
          # a handler's state cell cannot be captured by a lambda: read it first
          let s = store
          match list.find(args, a => not map.has(s, a)) {
            Some(missing) -> Err(no_such_buffer("fake device", missing))
            None -> {
              let bufs = list.map(args, a => unwrap_or(map.get(s, a), ("f64", [])))
              let dtypes = list.map(bufs, b => {
                let (dt, _v) = b
                dt
              })
              let ins = list.map(bufs, b => {
                let (_dt, v) = b
                v
              })
              let out_dt = dtypes[len(dtypes) - 1]
              let written = list.map(f(dtypes, ins), x => round_to(out_dt, x))
              store = map.insert(store, args[len(args) - 1], (out_dt, written))
              Ok(())
            }
          }
        }
      None -> Err(no_kernel("fake device", kernel))
    }
    gpu_free(handle) =>
      if map.has(store, handle) {
        store = map.remove(store, handle)
        Ok(())
      } else {
        Err(no_such_buffer("fake device", handle))
      }
    gpu_sync() => Ok(())
  }
  body()
}

# ---- the real device ----

# The intrinsics traffic in `Array`, the one container shape both backends
# can name across the runtime boundary; the list walk stays here.
fn to_array(xs: List[Float]) -> Array[Float] = {
  var a: Array[Float] = array_new()
  for x in xs {
    a = array_push(a, x)
  }
  a
}

fn of_array(a: Array[Float]) -> List[Float] = list.map(range(0, array_len(a)), i => array_get(a, i))

# The device pointers behind `args`, in order. Every handle was checked
# against the table before this is called.
fn device_pointers(table: Map[Int, (Int, Int, String)], args: List[Int]) -> Array[Int] = {
  var a: Array[Int] = array_new()
  for h in args {
    match map.get(table, h) {
      Some(b) -> {
        let (p, _n, _dt) = b
        a = array_push(a, p)
      }
      None -> ()
    }
  }
  a
}

## Run `body` against the machine's GPU through the CUDA driver. `kernels`
## maps a kernel name to the cubin that defines an entry of that name (the
## `tileiras` output for one `packages/tileir` program), the way
## `with_gpu_fake`'s table maps a name to a reference implementation.
##
## Handles are the same currency as the fake device's: they count up from 1
## per installation, a buffer is `(device pointer, element count, format)`
## in a table the handler owns, and a handle never issued or already freed
## answers `gpu.no_such_buffer` before the device is asked. `gpu_alloc`
## accepts the formats `element_bytes` knows, `f64` and `bf16`, and answers
## `gpu.unsupported_dtype` otherwise, as the fake device does. An f64 buffer
## crosses to the runtime as an `Array[Float]` the runtime copies double for
## double; a bf16 buffer crosses as `Bytes`, packed here (`pack_bf16`,
## which rounds) and unpacked here (`unpack_bf16`), so the runtime copies
## bytes and knows nothing about the format.
## `gpu_launch` looks the name up first (`gpu.no_kernel`), then the
## arguments (`gpu.no_arguments`, `gpu.no_such_buffer`), and only then
## touches the device: the cubin is handed to the driver the first time its
## kernel is launched and the module handle is kept for the rest of the
## installation, so a program that never launches never loads a module. The
## grid counts tile blocks; the intrinsic launches with block dims (1, 1, 1)
## and no shared memory, which is how a Tile IR kernel is launched.
##
## The seam is below the error surface: everything the driver refuses
## arrives as the `ForeignError` the runtime built from the CUresult, with
## kind `cuda.<CUresult name>` (`gpu.no_driver` when there is no libcuda to
## load, `gpu.unsupported_backend` on the JVM, which has no device runtime),
## unchanged. The first operation that needs the device opens it; when
## `body` has returned the context and the library are released, which also
## frees any buffer the program did not.
pub fn with_gpu_real[T](kernels: Map[String, Bytes], body: fn() -> T !Gpu !io) -> T !io = {
  with handle Gpu {
    var next: Int = 1
    var bufs: Map[Int, (Int, Int, String)] = map.empty()
    var mods: Map[String, Int] = map.empty()
    gpu_alloc(dtype, len) => match element_bytes(dtype) {
      None -> Err(refuse("gpu.unsupported_dtype", "real device: this release moves f64 and bf16, got ${dtype}"))
      Some(w) -> match gpu_alloc_host(len * w) {
        Ok(p) -> {
          let h = next
          next = next + 1
          bufs = map.insert(bufs, h, (p, len, dtype))
          Ok(h)
        }
        Err(e) -> Err(e)
      }
    }
    gpu_upload(handle, data) => match map.get(bufs, handle) {
      Some(b) -> {
        let (p, _n, dt) = b
        if dt == "bf16" { gpu_upload_bytes_host(p, pack_bf16(data)) } else { gpu_upload_host(p, to_array(data)) }
      }
      None -> Err(no_such_buffer("real device", handle))
    }
    gpu_download(handle) => match map.get(bufs, handle) {
      Some(b) -> {
        let (p, n, dt) = b
        if dt == "bf16" {
          match gpu_download_bytes_host(p, n * 2) {
            Ok(raw) -> Ok(unpack_bf16(raw))
            Err(e) -> Err(e)
          }
        } else {
          match gpu_download_host(p, n) {
            Ok(a) -> Ok(of_array(a))
            Err(e) -> Err(e)
          }
        }
      }
      None -> Err(no_such_buffer("real device", handle))
    }
    gpu_launch(kernel, grid, args) => match map.get(kernels, kernel) {
      Some(cubin) ->
        if len(args) == 0 {
          Err(no_arguments("real device", kernel))
        } else {
          # a handler's state cell cannot be captured by a lambda: read it first
          let table = bufs
          match list.find(args, a => not map.has(table, a)) {
            Some(missing) -> Err(no_such_buffer("real device", missing))
            None -> {
              let loaded: Result[Int, ForeignError] = match map.get(mods, kernel) {
                Some(m) -> Ok(m)
                None -> gpu_load_module_host(cubin)
              }
              match loaded {
                Ok(m) -> {
                  mods = map.insert(mods, kernel, m)
                  gpu_launch_host(m, kernel, grid, device_pointers(table, args))
                }
                Err(e) -> Err(e)
              }
            }
          }
        }
      None -> Err(no_kernel("real device", kernel))
    }
    gpu_free(handle) => match map.get(bufs, handle) {
      Some(b) -> {
        let (p, _n, _dt) = b
        bufs = map.remove(bufs, handle)
        gpu_free_host(p)
      }
      None -> Err(no_such_buffer("real device", handle))
    }
    gpu_sync() => gpu_sync_host()
  }
  let out = body()
  gpu_close_host()
  out
}

# ---- tests ----
#
# Every block below but the last runs the fake device, and the assertion the
# module exists for is the first one, a `!Gpu` program finishing a vector add
# on a machine with no GPU. Failure kinds are asserted by name only where std
# or a handler minted them above the device; a real device's kinds are its
# own (the same rule std/io's blocks follow), and nothing here reaches one:
# `dawn test --stdlib` runs on both backends and on machines with and without
# a driver, and its report is compared byte for byte. The real handler
# against a real device is scripts/tile-gpu-diff, and its ledger.

fn vadd_as[D: Dtype](d: D, kernel: String, xs: List[Float], ys: List[Float]) -> Result[List[Float], ForeignError] !Gpu = {
  let n = len(xs)
  let a = alloc(d, n)?
  let b = alloc(d, n)?
  let out = alloc(d, n)?
  upload(a, xs)?
  upload(b, ys)?
  launch(kernel, 1, [handle_of(a), handle_of(b), handle_of(out)])?
  sync()?
  let r = download(out)?
  free(a)?
  free(b)?
  free(out)?
  Ok(r)
}

fn vadd_on_device(xs: List[Float], ys: List[Float]) -> Result[List[Float], ForeignError] !Gpu =
  vadd_as(F64, "vadd", xs, ys)

test "a !Gpu program runs vadd on a machine without a GPU and gets the right answer" {
  let xs = [1.0, 2.5, -3.0, 4.0, 0.125, 1000000.0, -0.5, 7.0]
  let ys = [10.0, 0.5, 3.0, -4.0, 0.875, 0.5, -0.5, 0.0]
  let r = with_gpu_fake(reference_kernels(), () => vadd_on_device(xs, ys))
  assert r == Ok([11.0, 3.0, 0.0, 0.0, 1.0, 1000000.5, -1.0, 7.0])
  # a single element, and the last argument is the one written
  assert with_gpu_fake(reference_kernels(), () => vadd_on_device([2.0], [3.0])) == Ok([5.0])
}

fn sum_on_device(xs: List[Float], blocks: Int) -> Result[List[Float], ForeignError] !Gpu = {
  let x = alloc(F64, len(xs))?
  let out = alloc(F64, blocks * 128)?
  upload(x, xs)?
  launch("sum", blocks, [handle_of(x), handle_of(out)])?
  sync()?
  let r = download(out)?
  free(x)?
  free(out)?
  Ok(r)
}

# Two blocks of four 128-wide tiles. Block 0's four tiles are 2^53, 1, 1,
# -2^53 in every lane: added first to last that is ((2^53 + 1) + 1) - 2^53 =
# 0.0 (2^53 + 1 ties to the even 2^53), while last to first gives 2.0 and
# pairwise gives 1.0, so the answer says which order was used. Block 1's
# tile k holds 1000 k + j in lane j, exact in any order, so it says which
# lanes and tiles each block read.
fn sum_input() -> List[Float] = list.map(range(0, 1024), i => {
  let tile = i / 128
  let j = i % 128
  if tile < 4 {
    if tile == 0 { 9007199254740992.0 } else if tile == 3 { 0.0 - 9007199254740992.0 } else { 1.0 }
  } else {
    to_float(1000 * (tile - 4) + j)
  }
})

test "a !Gpu program runs the sum kernel on the fake device, and the answer is the kernel's own left-to-right order" {
  let r = with_gpu_fake(reference_kernels(), () => sum_on_device(sum_input(), 2))
  let want = list.map(range(0, 256), i => if i < 128 { 0.0 } else { to_float(6000 + 4 * (i - 128)) })
  assert r == Ok(want)
  # the same sum on the host, tile by tile from the first, is bit for bit the device's
  let xs = sum_input()
  let host = list.map(range(0, 256), i => {
    let b = i / 128
    let j = i % 128
    let first = xs[(b * 4) * 128 + j]
    ((first + xs[(b * 4 + 1) * 128 + j]) + xs[(b * 4 + 2) * 128 + j]) + xs[(b * 4 + 3) * 128 + j]
  })
  assert r == Ok(host)
  # one block, one chunk: the loop runs zero times and the first tile is the answer
  let one = list.map(range(0, 128), i => to_float(i) * 0.5)
  assert with_gpu_fake(reference_kernels(), () => sum_on_device(one, 1)) == Ok(one)
}

fn kind_of[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> "ok"
  Err(e) -> e.kind
}

fn wrong_length_upload() -> Result[List[Float], ForeignError] !Gpu = {
  let t = alloc(F64, 3)?
  match upload(t, [1.0, 2.0, 3.0, 4.0]) {
    Ok(_) -> Err(refuse("test.accepted", "a wrong-length upload was accepted"))
    Err(e) ->
      if e.kind == "gpu.length_mismatch" { download(t) } else { Err(e) }
  }
}

test "upload of a vector of the wrong length is refused above the effect" {
  # refused with std's own kind, and the buffer is untouched
  assert with_gpu_fake(reference_kernels(), wrong_length_upload) == Ok([0.0, 0.0, 0.0])
  # the same refusal under a handler that would have accepted anything: the
  # check is not the fake device's
  let under_yes = {
    with handle Gpu {
      gpu_alloc(_dtype, _len) => Ok(1)
      gpu_upload(_handle, _data) => Ok(())
      gpu_download(_handle) => Ok([])
      gpu_launch(_kernel, _grid, _args) => Ok(())
      gpu_free(_handle) => Ok(())
      gpu_sync() => Ok(())
    }
    wrong_length_upload()
  }
  # had the check been the handler's, this handler accepts and `test.accepted` comes back
  assert under_yes == Ok([])
}

fn alloc_refusals() -> (String, String, String) !Gpu = {
  let empty: Result[Tensor[F64], ForeignError] = alloc(F64, 0)
  let negative: Result[Tensor[F64], ForeignError] = alloc(F64, 0 - 4)
  let f32: Result[Tensor[F32], ForeignError] = alloc(F32, 4)
  (kind_of(empty), kind_of(negative), kind_of(f32))
}

test "alloc refuses an empty tensor above the effect, and the fake device refuses a format it cannot hold" {
  assert with_gpu_fake(reference_kernels(), alloc_refusals)
    == ("gpu.bad_length", "gpu.bad_length", "gpu.unsupported_dtype")
  assert dtype_name(F64) == "f64"
  assert dtype_bytes(F64) == 8
  assert dtype_name(F32) == "f32"
  assert dtype_bytes(F32) == 4
  assert dtype_name(BF16) == "bf16"
  assert dtype_bytes(BF16) == 2
  # the one table both handlers accept formats from
  assert element_bytes("f64") == Some(8)
  assert element_bytes("bf16") == Some(2)
  assert element_bytes("f32") == None
}

# ---- bf16 ----

test "packing rounds every value to bf16 and lays the pattern down low byte first; unpacking is exact" {
  # 1 + 3/512 is off the grid; its nearest bf16 is 1 + 1/128, and the two
  # pack alike. A truncating pack would give 1.0's bytes instead.
  assert pack_bf16([1.0 + 3.0 / 512.0]) == pack_bf16([1.0 + 1.0 / 128.0])
  assert bytes.to_hex(pack_bf16([1.0 + 3.0 / 512.0])) == "813f"
  assert bytes.to_hex(pack_bf16([1.0, -1.5, 0.0])) == "803fc0bf0000"
  let inf = 1.0 / 0.0
  let xs = [0.1, -2.0, 1.0e-40, 3.4e38, 0.0 * (0.0 - 1.0), inf, 65504.0]
  let back = unpack_bf16(pack_bf16(xs))
  assert to_string(back) == to_string(list.map(xs, x => narrow.round_bf16(x)))
  assert 1.0 / back[4] == 0.0 - inf
  assert back[3] == inf
  assert bytes.len(pack_bf16(xs)) == 14
  assert unpack_bf16(bytes.utf8("")) == []
}

# A fixed-seed 31-bit LCG: the random half of every pair below is a function
# of nothing but its position, so the test is the same on every run and on
# both backends.
fn lcg(seed: Int) -> Int = (seed * 1103515245 + 12345) & 0x7FFFFFFF

# Every bf16 pattern in order, paired with a pseudo-random pattern.
fn all_patterns() -> (List[Float], List[Float]) = {
  var xs: List[Float] = []
  var ys: List[Float] = []
  var r = 20260902
  var i = 0
  while i < 65536 {
    r = lcg(r)
    xs = xs ++ [narrow.bf16_of_bits(i)]
    ys = ys ++ [narrow.bf16_of_bits((r >>> 8) & 0xFFFF)]
    i = i + 1
  }
  (xs, ys)
}

# The sum narrow computes, value by value: round each operand to bf16, add
# exactly, round once, which is the device's addf by the theorem.
fn narrow_sums(xs: List[Float], ys: List[Float]) -> List[Float] =
  list.map(range(0, len(xs)), i => narrow.to_f64(narrow.add(narrow.bf16(xs[i]), narrow.bf16(ys[i]))))

test "bf16 vadd on the fake device is narrow's add, bit for bit, over every bf16 pattern paired with a random one" {
  let (xs, ys) = all_patterns()
  let r = with_gpu_fake(reference_kernels(), () => vadd_as(BF16, "vadd_bf16", xs, ys))
  match r {
    Ok(got) -> {
      assert len(got) == 65536
      # `to_string` tells -0.0 from 0.0 and NaN from anything, so equal
      # renderings are equal bits
      assert to_string(got) == to_string(narrow_sums(xs, ys))
    }
    Err(_) -> { assert false }
  }
}

# 1024 pairs of Floats off the bf16 grid (thousandths and ten-thousandths).
fn off_grid_pairs() -> (List[Float], List[Float]) = {
  var xs: List[Float] = []
  var ys: List[Float] = []
  var r = 7
  var i = 0
  while i < 1024 {
    r = lcg(r)
    let x = to_float(r % 200001) / 1000.0 - 100.0
    r = lcg(r)
    let y = to_float(r % 20001) / 10000.0 - 1.0
    xs = xs ++ [x]
    ys = ys ++ [y]
    i = i + 1
  }
  (xs, ys)
}

fn there_and_back(xs: List[Float]) -> Result[List[Float], ForeignError] !Gpu = {
  let t = alloc(BF16, len(xs))?
  upload(t, xs)?
  download(t)
}

test "uploading Floats off the bf16 grid rounds them on the way in, so the fake device adds what a bf16 buffer holds" {
  # off-grid operands: the device holds their nearest bf16 and adds those;
  # adding the Floats and rounding once would differ
  let (xs, ys) = off_grid_pairs()
  let r2 = with_gpu_fake(reference_kernels(), () => vadd_as(BF16, "vadd", xs, ys))
  match r2 {
    Ok(got) -> {
      assert to_string(got) == to_string(narrow_sums(xs, ys))
      # and a download of an input answers the rounded values, not the Floats
      let back = with_gpu_fake(reference_kernels(), () => there_and_back(xs))
      let rounded: Result[List[Float], ForeignError] = Ok(list.map(xs, x => narrow.round_bf16(x)))
      let as_given: Result[List[Float], ForeignError] = Ok(xs)
      assert to_string(back) == to_string(rounded)
      assert to_string(back) != to_string(as_given)
    }
    Err(_) -> { assert false }
  }
}

fn launch_refusals() -> List[String] !Gpu = {
  let a: Result[Tensor[F64], ForeignError] = alloc(F64, 2)
  let h = match a {
    Ok(t) -> handle_of(t)
    Err(_) -> 0 - 1
  }
  [
    # the grid is checked before the name is looked up: `nope` never reaches the device
    kind_of(launch("nope", 0, [h])),
    kind_of(launch("nope", 1, [h])),
    kind_of(launch("vadd", 1, [])),
    kind_of(launch("vadd", 1, [h, h, 99])),
    kind_of(launch("vadd", 4, [h, h, h]))
  ]
}

test "launch refuses a grid of zero above the effect; the fake device refuses what it does not have" {
  assert with_gpu_fake(reference_kernels(), launch_refusals)
    == ["gpu.bad_grid", "gpu.no_kernel", "gpu.no_arguments", "gpu.no_such_buffer", "ok"]
}

fn use_after_free() -> (Int, Int, String, String) !Gpu = {
  let a: Result[Tensor[F64], ForeignError] = alloc(F64, 2)
  let b: Result[Tensor[F64], ForeignError] = alloc(F64, 2)
  match (a, b) {
    (Ok(ta), Ok(tb)) -> {
      let freed = kind_of(free(ta))
      let after = kind_of(download(ta))
      let twice = kind_of(free(ta))
      let still = kind_of(download(tb))
      (handle_of(ta), size(tb), freed ++ "/" ++ after ++ "/" ++ twice, still)
    }
    _ -> (0, 0, "alloc failed", "alloc failed")
  }
}

test "a freed buffer answers nothing, and two installations share nothing" {
  let first = with_gpu_fake(reference_kernels(), use_after_free)
  assert first == (1, 2, "ok/gpu.no_such_buffer/gpu.no_such_buffer", "ok")
  # handles start over: the second installation did not inherit the first's table
  let second = with_gpu_fake(reference_kernels(), use_after_free)
  assert second == first
}

fn real_refusals() -> List[String] !Gpu = {
  # a handle nothing issued: every operation on it is answered from the table
  let ghost: Tensor[F64] = (7, 2)
  let f32: Result[Tensor[F32], ForeignError] = alloc(F32, 4)
  [
    kind_of(f32),
    kind_of(upload(ghost, [1.0, 2.0])),
    kind_of(download(ghost)),
    kind_of(free(ghost)),
    # the name is looked up before anything else
    kind_of(launch("nope", 1, [handle_of(ghost)])),
    # a known name with no buffers, and with a buffer nobody has
    kind_of(launch("vadd", 1, [])),
    kind_of(launch("vadd", 1, [handle_of(ghost)]))
  ]
}

test "the real handler refuses, above the device, what it can answer without one" {
  # None of these reaches the driver, so the answer is the same on a machine
  # with a GPU, one without, and on the JVM, where there is no device runtime
  # at all: the dtype check, the handle table and the kernel table are the
  # handler's own, and `launch` consults all three before it loads a module.
  # The bytes are never handed to the driver, so they need not be a cubin.
  let r = with_gpu_real(map.from([("vadd", bytes.utf8("not a cubin"))]), real_refusals)
  assert r
    == [
      "gpu.unsupported_dtype", "gpu.no_such_buffer", "gpu.no_such_buffer", "gpu.no_such_buffer",
      "gpu.no_kernel", "gpu.no_arguments", "gpu.no_such_buffer"
    ]
}

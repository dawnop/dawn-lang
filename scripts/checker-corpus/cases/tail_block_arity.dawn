# a tail block counts as one argument (#206 K4): a call already full before
# the block overflows, and the report is the ordinary arity sentence with the
# block counted in.
use std/io

fn once(body: fn() -> Unit !io) -> Unit !io = body()

pub fn bad_overflow() -> Unit !io = once(noop) { io.println("x") }

pub fn bad_no_params() -> Unit !io = tick() { io.println("y") }

fn tick() -> Unit !io = ()

fn noop() -> Unit !io = ()

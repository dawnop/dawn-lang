# A callee whose declared row is `!io` still owes its caller the labels its
# effect variables were instantiated with.
#
# `base_union` lets io absorb the variables written beside it, so `-> Int !io
# !e` normalizes to `!io` and the declared row keeps no trace of `!e`. The
# caller used to charge that declared row and nothing else, so instantiating
# `!e := !AskE` charged it nothing: the label never entered the caller's own
# row, the `with handle` remainder was therefore built with a pack that had no
# node for it, and the call read `ev_get` off an empty pack and panicked with
# "effect evidence missing" on a program that checks clean. The caller now
# charges what it packed.
#
# Every function here is one the compiler's own diagnostic recommends: the
# advice on an unbindable variable is "declare !io, which covers any row", and
# following it is what walked into this.
#
# The same absorption bit an **inferred** row as well, which is the half no
# rule about signatures can reach: a closure that did io and called an `!e`
# parameter had its own row collapse to `!io`, and then the call that ran it
# built a pack out of that row. `lambda_absorbs` is that one, and nothing in it
# is declared.
#
# `plain` is the control that was always green -- its row has no io, so the
# variable survived normalization and the charge came out right by accident of
# the shape rather than by rule. Keeping it here means a fix that widened
# something instead of charging would still have to answer for it.
use std/io

effect AskE {
  fn ask() -> Int
}

effect TellE {
  fn tell() -> Int
}

## The variable is written in the row and absorbed by the io beside it.
fn under_io(f: fn() -> Int !e) -> Int !io !e = {
  println("under_io ran")
  f()
}

## The variable is not written in the row at all: `!io` alone, which is the
## spelling the diagnostic asks for.
fn only_io(f: fn() -> Int !e) -> Int !io = f()

## The control: no io in the row, so nothing is absorbed.
fn plain(f: fn() -> Int !e) -> Int !e = f()

## Two absorbed variables in one signature, so the charge is a union and not a
## single row that happened to be the last one seen.
fn two_under_io(g: fn() -> Int !e1, h: fn() -> Int !e2) -> Int !io = g() + h()

## An absorbed variable forwarded through a second absorbing signature: the
## instantiation here is a variable rather than a label, and the label is
## charged one level up.
fn nested(f: fn() -> Int !e) -> Int !io = only_io(f)

## The absorption inside an **inferred** row, which is the half a rule about
## call sites cannot reach. This lambda does io and calls an `!e` parameter, so
## its own row was the union of the two -- and the union used to hand back
## `!io` alone. The pack the call built came from that row, so it had no node
## for the variable, and the `f()` inside read a key nobody had put there.
## Nothing here is declared: only `base_union` decides what this closure's type
## says, which is why a signature-shaped fix leaves it standing.
fn lambda_absorbs(f: fn() -> Int !r) -> Int !io !r =
  plain(() => {
    println("inside the lambda")
    f()
  })

## The same shape with two variables, so the lambda's row is io over a union
## rather than io over one atom.
fn lambda_absorbs_two(g: fn() -> Int !e1, h: fn() -> Int !e2) -> Int !io !e1 !e2 =
  plain(() => {
    println("inside the second lambda")
    g() + h()
  })

pub fn main() -> Unit !io = {
  with handle AskE { ask() => 300 }
  with handle TellE { tell() => 7 }
  println("-- a variable absorbed by the io written beside it --")
  println(to_string(under_io(() => ask())))
  println("-- the row that says only !io --")
  println(to_string(only_io(() => ask())))
  println("-- the control: a row with no io to absorb anything --")
  println(to_string(plain(() => ask())))
  println("-- two absorbed variables, two labels, one charge --")
  println(to_string(two_under_io(() => ask(), () => tell())))
  println("-- forwarded through a second absorbing signature --")
  println(to_string(nested(() => tell())))
  println("-- a lambda whose own inferred row mixed io with a variable --")
  println(to_string(lambda_absorbs(() => ask())))
  println("-- and the same with two variables under the io --")
  println(to_string(lambda_absorbs_two(() => ask(), () => tell())))
  println("-- and a pure closure through the same signatures --")
  println(to_string(only_io(() => 1)))
}

# The kernels scripts/tile-golden pins. Each is traced twice (the two records
# must be equal, or this program panics) and then either rendered once, the
# text being the layer-0 golden, or encoded once into the bytecode file the
# layer-1 golden pins and `tileiras` assembles. run.sh copies this file to
# src/main.dawn of a project whose [deps] names packages/tileir, and runs it
# as `kernels <name>` (text to stdout), `kernels <name> --bytecode <path>`
# (bytes to the file) or `kernels --bytecode-version` (the header's version,
# which run.sh holds against toolchain.txt).
use std/io
use std/io.{with_fs_real, write_bytes}
use std/gpu.{F64, F32}
use tileir/dev.{Dev, Param, param, block_id, load, store, addf, idx_const, idx_add, idx_mul, d_for}
use tileir/prog.{TileProg, trace_kernel}
use tileir/render.{render}
use tileir/bytecode.{encode, bytecode_version}

# f64 vector add over 128-wide tiles: the first milestone's kernel
# (tile-backend-design 1), and the shape std/gpu's vadd_ref answers for.
fn vadd(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let ta = load(a, i, 128)
  let tb = load(b, i, 128)
  store(out, i, 128, addf(F64, 128, ta, tb))
}

# The same kernel over f32 and 64-wide tiles: the case that reds when a load
# stops reading its parameter's format (run.sh's load-dtype-f64 mutant).
fn vadd_f32(a: Param[F32], b: Param[F32], out: Param[F32]) -> Unit !Dev = {
  let i = block_id(0)
  let ta = load(a, i, 64)
  let tb = load(b, i, 64)
  store(out, i, 64, addf(F32, 64, ta, tb))
}

# f64 block-wise tile sum, the second milestone's loop kernel
# (tile-backend-design 5.2): block b folds the `chunks` consecutive 128-wide
# tiles of x numbered b*chunks .. b*chunks+chunks-1 into one tile of out,
# the first tile entering the loop and the rest added in order, which is
# the order std/gpu's sum_ref adds in. `chunks` is a host constant: fixed
# when the kernel is recorded, 4 in the golden.
fn sum(x: Param[F64], out: Param[F64], chunks: Int) -> Unit !Dev = {
  let b = block_id(0)
  let n = idx_const(chunks)
  let base = idx_mul(b, n)
  let first = load(x, base, 128)
  let one = idx_const(1)
  let lo = idx_add(base, one)
  let up = idx_add(base, n)
  let acc = d_for(lo, up, one, first, (k, t) => addf(F64, 128, t, load(x, k, 128)))
  store(out, b, 128, acc)
}

fn trace(name: String) -> TileProg = match name {
  "vadd" ->
    trace_kernel("vadd", ["f64", "f64", "f64"], () => vadd(param(F64, 0), param(F64, 1), param(F64, 2)))
  "vadd_f32" ->
    trace_kernel("vadd_f32", ["f32", "f32", "f32"], () => vadd_f32(param(F32, 0), param(F32, 1), param(F32, 2)))
  "sum" ->
    trace_kernel("sum", ["f64", "f64"], () => sum(param(F64, 0), param(F64, 1), 4))
  _ -> panic("tile-golden: no kernel named `${name}`")
}

# Trace `name` twice and answer the record, or panic if the two runs differ.
fn trace_twice(name: String) -> TileProg = {
  let first = trace(name)
  let second = trace(name)
  if first != second { panic("tile-golden: `${name}` traced twice gave two different programs") } else { () }
  first
}

pub fn main() -> Unit !io = match args() {
  ["--bytecode-version"] -> println(bytecode_version())
  [name] -> print(render(trace_twice(name)))
  [name, "--bytecode", path] -> {
    let bytes = encode(trace_twice(name))
    match with_fs_real(() => write_bytes(path, bytes)) {
      Ok(_) -> ()
      Err(_e) -> panic("tile-golden: cannot write the bytecode to `${path}`")
    }
  }
  _ -> panic("usage: kernels <vadd|vadd_f32|sum> [--bytecode <path>] | kernels --bytecode-version")
}

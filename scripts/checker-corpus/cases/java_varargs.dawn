# checker.dawn: a varargs call whose arguments do not fit the component type.
# The report names the argument types it saw and lists every candidate -- with
# only "no overload matches", an author reading it has no way to learn which
# shapes exist (varargs-design.md §6.2). `Path.of` is the corpus's varargs
# subject because its two overloads have not moved since Java 11.
use java "java.nio.file.Path"

pub fn f() -> String !io = {
  let p = Path.of("a", 1, true)!
  p.toString()!
}

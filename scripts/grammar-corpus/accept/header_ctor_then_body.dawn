# The control for reject/header_record_literal_*.dawn: in a header, a type name
# followed by braces that do not hold fields is a constructor value followed by
# the body (spec §4.3). `{ x }` would be a record shorthand anywhere else; here
# it is a body whose value is `x`, and `{ g() }` is a body, not a tail block.
type B = | B
fn f(b: B, x: Int) -> Int = {
  if b == B { x } else { 0 }
}
fn g(b: B) -> Unit = {
  while b == B { h() }
  match B {
    B -> h()
  }
  if b == B {
    h()
  }
}

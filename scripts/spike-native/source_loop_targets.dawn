# Source loops keep every named Core jump target after the native-only RC pass.
# The iterable case is a control: its item binding already kept the old broad
# match unloop recognizer from firing, while range and while exposed the bug.
use std/io

pub fn main() -> Unit !io = {
  for _i in 0..3 {
    break
  }
  io.println("range-break")

  for _i in 0..3 {
    continue
  }
  io.println("range-continue")

  for _x in [1, 2] {
    break
  }
  io.println("iterable-break")

  var go = true
  while go {
    break
  }
  io.println("while-break")

  while true {
    break
  }
  io.println("while-true-break")

  for _outer in 0..2 {
    while true {
      break
    }
    io.println("nested-inner")
    break
  }
  io.println("nested-outer")

  for i in 0..2 {
    if i == 0 { break }
  }
  io.println("conditional-break")
}

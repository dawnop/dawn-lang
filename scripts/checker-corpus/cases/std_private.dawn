# A std function that exists but is not `pub` (#296). std is not the user's to
# edit, so neither the qualified call nor the selective import may answer with
# the user-module hint "add `pub` to its declaration"; both say the name is
# not part of std's public API. The user-module answer, hint included, stays
# pinned by `qualified` and `imports`.
use std/fmt
use std/fmt.{atod}

pub fn main() -> Unit !io = {
  let d: Option[Int] = fmt.atoi("42")
  let f: Option[Float] = atod("1.5")
  println(to_string(d) ++ to_string(f))
}

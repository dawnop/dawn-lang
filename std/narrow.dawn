## Narrow binary floating point: bfloat16, IEEE binary16 and binary32 as
## opaque types over Float, with correctly rounded arithmetic on each, and the
## five storage-only formats the tile dialect also has.
#
# Dawn has one floating type, the 64-bit `Float`. Code that wants to know what
# a computation does at a narrower width (quantised weights, a kernel that
# will run on hardware in bf16) needs the narrow formats as *values* whose
# every operation rounds the way the hardware rounds. The compiler owns two
# numbers, Int and Float, and no float-to-bits primitive
# (docs/literal-system-design.md D1), so this is not a new numeric type; it
# is three opaque types (spec 2.7) whose invariant is "the Float inside is
# representable in the format", a rounding function that establishes it, and
# arithmetic whose every operation re-rounds.
#
# The arithmetic has two spellings and one definition. `a + b`, `a - b`,
# `a * b`, `a / b`, `a % b` and `-a` on a BF16 are the impls of `Add` ..
# `Neg` below (spec 3.5): the format's default operation, ties to even,
# which is the only one the hardware's plain instruction performs. The
# `Narrow` trait's members are the same operations by name; `+` IS
# `narrow.add`, the impl calls it, and the names stay because `sqrt` and
# `abs` have no operator and removing the others would break every caller
# for nothing. A literal at one of these types goes through `FromFloat`
# (`let w: BF16 = 0.1` is `bf16(0.1)`, folded at compile time), and an
# integer literal does not: a format that only holds a few hundred integers
# exactly should not look as if it took any. Inside this module none of that
# applies to literals: the module sees through its own types, so
# `let w: BF16 = 0.1` here is the unrounded Float (literal design D7), which
# is why the code below builds its values with `bf16(..)` and friends.
#
# Why "compute in Float, then round" is the format's own answer, and for
# which operations: Figueroa's double-rounding theorem. When the wide format
# has at least 2p + 2 significand bits, rounding the exact result to wide and
# then to narrow equals rounding it to narrow once, for + - * / and square
# root. Float has 53 bits; the widest format here needs 2 * 24 + 2 = 50. So
# `add`, `sub`, `mul` and `div` below are the correctly rounded operations of
# their format, bit for bit, and scripts/narrow-contract pins that against an
# exact rational oracle on both backends. `sqrt` is correctly rounded too,
# by a different route: Dawn has no Float square root primitive, and a
# p-bit root needs only about 2p + 2 bits of integer work, so it is computed
# exactly in Int and never rounds twice. The theorem does not cover fused
# multiply-add or the transcendental functions, and neither is offered: a
# `bf16` exp would be "exp in Float, then round", which is a definition and
# not the hardware's answer, and a name that looks like the others while
# meaning something weaker is the mistake this module is here to avoid.
#
# `round_binary` is pure arithmetic on purpose. Without `float_to_bits` the
# exponent is found by exact doublings and halvings, the significand is
# scaled to the integer domain by an exact power of two, `to_int` truncates
# it and ties are broken by hand. That is a few hundred iterations in the
# worst case (a Float subnormal), which is what a reference implementation
# may cost; a faster decomposition would be held to the same oracle.
#
# The widening member is `to_f64` and not `to_float`: a trait method shadows
# the builtin of the same spelling throughout the declaring module (spec
# 10.3), and `round_binary` needs the builtin `to_float` to bring its integer
# significand back.

# The rounding direction is a `Rounding` value and not a string or a family
# of suffixed names. Before parameters had defaults the module grew
# `round_binary_away`, `round_binary_toward(.., mode: String)` and three more
# like them; a misspelt mode was a runtime panic and "f32, ties away" was a
# function nobody had written. Now `mode` is the last parameter of
# `round_binary`, `round_f32` and `round_tf32`, it defaults to the IEEE
# default `NearestEven`, and a mode that does not exist cannot be spelt.
# The variants follow IEEE 754's names, shortened, and correspond one to one
# to the Tile IR dialect's rounding attribute:
#
#   NearestEven  roundTiesToEven      nearest_even
#   NearestAway  roundTiesToAway      nearest_away
#   TowardZero   roundTowardZero      zero
#   Down         roundTowardNegative  negative_inf
#   Up           roundTowardPositive  positive_inf
#
# The type is public so that packages/tileir can take the same value for its
# own `rounding` attribute; the function from variant to dialect spelling
# belongs there, next to the dialect, and not in a module about arithmetic.
# The per-format functions (`round_bf16`, `round_f16`, the f8 family) take
# no mode: the format is the function's identity, the f8 formats saturate
# and so are not IEEE roundings at all, and no caller has asked for one.

# ---- the formats ----

# Each format is also a device format (std/dtype): the constant spelled like
# its type is the format's witness, so that `use std/narrow.{BF16}` brings in
# the type and the witness together, and `alloc(BF16, n)`, `p.to(BF16)` and
# `Tile[BF16]` read as they always did. `impl HasDtype` lets generic code ask
# for the witness by type. The names are the tile dialect's.

use std/dtype.{Dtype, HasDtype, dtype_name, dtype_named, dtype_of}

## A bfloat16 value: 8 significand bits, exponents -126..127.
pub opaque type BF16 = Float

## The bfloat16 device format, the witness of [`BF16`].
pub const BF16: Dtype[BF16] = dtype_named("bf16")

impl HasDtype[BF16] {
  fn dtype_of() -> Dtype[BF16] = BF16
}

## An IEEE binary16 value: 11 significand bits, exponents -14..15.
pub opaque type F16 = Float

## The binary16 device format, the witness of [`F16`].
pub const F16: Dtype[F16] = dtype_named("f16")

impl HasDtype[F16] {
  fn dtype_of() -> Dtype[F16] = F16
}

## An IEEE binary32 value: 24 significand bits, exponents -126..127.
pub opaque type F32 = Float

## The binary32 device format, the witness of [`F32`].
pub const F32: Dtype[F32] = dtype_named("f32")

impl HasDtype[F32] {
  fn dtype_of() -> Dtype[F32] = F32
}

# The storage-only formats: the dialect has them as tile and buffer element
# types and gives them no arithmetic (tf32 only reaches `ftof` and memory,
# the fp8 and fp4 types only conversions), so each is an opaque Float with a
# literal and a rendering and nothing else, and its rounding is the
# `round_*` function of the same format. There is no `to_f64` for them: that
# name is a member of `Narrow` and trait methods share the function namespace,
# so a second one would not compile. cutile-rs has the same split ("no host
# arithmetic, storage only").

## A TensorFloat-32 value: `round_tf32`'s grid.
pub opaque type TF32 = Float

## The TensorFloat-32 device format, the witness of [`TF32`].
pub const TF32: Dtype[TF32] = dtype_named("tf32")

impl HasDtype[TF32] {
  fn dtype_of() -> Dtype[TF32] = TF32
}

## An OCP fp8 value with four exponent bits and three significand bits and
## no infinity: `round_f8e4m3fn`'s grid.
pub opaque type F8E4M3FN = Float

## The `f8E4M3FN` device format, the witness of [`F8E4M3FN`].
pub const F8E4M3FN: Dtype[F8E4M3FN] = dtype_named("f8E4M3FN")

impl HasDtype[F8E4M3FN] {
  fn dtype_of() -> Dtype[F8E4M3FN] = F8E4M3FN
}

## An OCP fp8 value with five exponent bits and two significand bits:
## `round_f8e5m2`'s grid.
pub opaque type F8E5M2 = Float

## The `f8E5M2` device format, the witness of [`F8E5M2`].
pub const F8E5M2: Dtype[F8E5M2] = dtype_named("f8E5M2")

impl HasDtype[F8E5M2] {
  fn dtype_of() -> Dtype[F8E5M2] = F8E5M2
}

## An fp8 exponent value, a power of two: `round_f8e8m0`'s grid.
pub opaque type F8E8M0FNU = Float

## The `f8E8M0FNU` device format, the witness of [`F8E8M0FNU`].
pub const F8E8M0FNU: Dtype[F8E8M0FNU] = dtype_named("f8E8M0FNU")

impl HasDtype[F8E8M0FNU] {
  fn dtype_of() -> Dtype[F8E8M0FNU] = F8E8M0FNU
}

## An OCP MX fp4 value: `round_f4e2m1`'s grid.
pub opaque type F4E2M1FN = Float

## The `f4E2M1FN` device format, the witness of [`F4E2M1FN`].
pub const F4E2M1FN: Dtype[F4E2M1FN] = dtype_named("f4E2M1FN")

impl HasDtype[F4E2M1FN] {
  fn dtype_of() -> Dtype[F4E2M1FN] = F4E2M1FN
}

# ---- rounding ----

## How a value between two neighbours of a format picks one: the five
## rounding-direction attributes of IEEE 754 section 4.3, under short names.
##
## - `NearestEven`: roundTiesToEven, the nearest neighbour, a tie to the one
##   with an even last digit. The default everywhere, and the one Figueroa's
##   theorem covers.
## - `NearestAway`: roundTiesToAway, the nearest neighbour, a tie to the one
##   of larger magnitude.
## - `TowardZero`: roundTowardZero, the neighbour of smaller magnitude.
## - `Down`: roundTowardNegative, the neighbour below.
## - `Up`: roundTowardPositive, the neighbour above.
##
## The Tile IR dialect (`AttrDefs.td`'s `RoundingMode`) spells the same five
## `nearest_even`, `nearest_away`, `zero`, `negative_inf` and `positive_inf`.
pub type Rounding = NearestEven | NearestAway | TowardZero | Down | Up

## The value of the binary format with `p` significand bits (hidden bit
## included), minimum normal exponent `emin` and maximum exponent `emax`
## that `mode` picks for `x`. Below the normal range the answer lies on the
## subnormal grid 2^(emin - p + 1), and may be zero of the sign. NaN, the
## two zeros and the two infinities pass through unchanged.
##
## A finite `x` too big for the format is where the modes differ in kind,
## not just in which neighbour: the two nearest modes overflow to the
## infinity of the sign, and of the directed ones, rounding TOWARDS the
## value's own infinity overflows to it while rounding away from it answers
## the largest finite value. IEEE 754 section 4.3 says so, and a caller
## comparing against hardware would otherwise read an infinity where the
## device holds a finite number.
pub fn round_binary(x: Float, p: Int, emin: Int, emax: Int, mode: Rounding = NearestEven) -> Float =
  if x != x || x == 0.0 {
    x
  } else {
    let neg = x < 0.0
    let a = if neg { -x } else { x }
    let inf = 1.0 / 0.0
    if a == inf {
      x
    } else {
      let e = exponent(a)
      # the quantum: one unit in the last place at this exponent, clamped
      # to the subnormal grid below emin
      let qe = (if e < emin { emin } else { e }) - p + 1
      let q = pow2(qe)
      # a / q is exact (a power-of-two scaling), and lies below 2^p, so
      # `to_int` truncates without saturating; `r` is what was cut off
      let m = a / q
      let fl = to_int(m)
      let r = m - to_float(fl)
      # whether the magnitude goes up to the next quantum; the directed
      # modes ask in terms of the sign, so they are answered in terms of it
      let up = match mode {
        NearestEven -> r > 0.5 || (r == 0.5 && fl % 2 == 1)
        NearestAway -> r >= 0.5
        TowardZero -> false
        Down -> neg && r > 0.0
        Up -> not neg && r > 0.0
      }
      let n = if up { fl + 1 } else { fl }
      let v = to_float(n) * q
      # the largest finite value is (2 - 2^(1 - p)) * 2^emax; a result above
      # it (a carry out of the top exponent included) is the infinity,
      # unless the mode rounds that sign's magnitude down
      let max_finite = (2.0 - pow2(1 - p)) * pow2(emax)
      let saturates = match mode {
        NearestEven | NearestAway -> false
        TowardZero -> true
        Down -> not neg
        Up -> neg
      }
      let out = if v > max_finite { if saturates { max_finite } else { inf } } else { v }
      if neg { -out } else { out }
    }
  }

# 2^k by exact doublings or halvings; k stays within Float's exponent range
# for every caller here (the quantum of a Float subnormal is 2^-1074).
fn pow2(k: Int) -> Float = {
  var q = 1.0
  var i = k
  while i > 0 {
    q = q * 2.0
    i = i - 1
  }
  while i < 0 {
    q = q * 0.5
    i = i + 1
  }
  q
}

## `x` rounded to bfloat16.
pub fn round_bf16(x: Float) -> Float = round_binary(x, 8, -126, 127)

## `x` rounded to binary16.
pub fn round_f16(x: Float) -> Float = round_binary(x, 11, -14, 15)

## `x` rounded to binary32 in the direction `mode` names.
pub fn round_f32(x: Float, mode: Rounding = NearestEven) -> Float = round_binary(x, 24, -126, 127, mode)

## `x` rounded to TensorFloat-32 in the direction `mode` names: binary32's
## exponent range with eleven significand bits instead of twenty-four. It is
## a rounding and not a storage format in this module's sense -- [`tf32_bits`]
## puts it in a 32-bit word with thirteen zero bits at the bottom, which is
## where the hardware keeps it. [`NearestAway`] is what the device answers for
## `ftof` from f32 to tf32 under `nearest_away` (measured, knife T17).
pub fn round_tf32(x: Float, mode: Rounding = NearestEven) -> Float = round_binary(x, 11, -126, 127, mode)

## `x` rounded to f8E5M2: three significand bits, exponents -14..15, and
## SATURATING at the largest finite value.
##
## The format is an ordinary IEEE binary format at eight bits, infinities
## and all, so [`round_binary`] is the arithmetic; what is not IEEE is the top
## end. An IEEE conversion sends everything above the midpoint 61440 to
## infinity, and this format has an infinity to send it to ([`f8e5m2_bits`]
## and [`f8e5m2_of_bits`] keep the two 0x7C encodings, because a value ALREADY
## in the format can be one). The device does not: knife TA converted
## 1e30, -1e30 and an infinity on a B200 and got 57344, -57344 and 57344.
##
## So the codec and this function part company at exactly two inputs, and
## the reason is that they answer different questions. [`f8e5m2_of_bits`] says
## what an octet MEANS; this says what `ftof` DOES, and `ftof` saturates.
## The two fp8 formats below say the same thing and f4E2M1FN says it too, so
## saturation is this assembler's rule for the narrow floats and not a
## property of any one of them.
pub fn round_f8e5m2(x: Float) -> Float =
  if x != x {
    x
  } else {
    let v = round_binary(x, 3, -14, 15)
    if magnitude(v) <= 57344.0 { v } else if v < 0.0 { -57344.0 } else { 57344.0 }
  }

## `x` rounded to f8E4M3FN: four significand bits, exponents -6..8.
##
## FN is the whole of what this function adds to [`round_binary`]. The format
## has no infinity: the all-ones exponent field is a normal exponent, and
## only the single encoding with an all-ones significand under it is taken,
## as NaN. So the largest finite value is 1.75 * 2^8 = 448 rather than the
## 1.875 * 2^8 = 480 an IEEE format of these widths would have, and there is
## nothing above it to overflow to except NaN.
##
## THE OVERFLOW ANSWER IS SATURATION, AND IT IS NOW MEASURED. The dialect
## gives `ftof` no saturation attribute, so this function used to read IEEE's
## rule with the infinity replaced by the only encoding left over: anything
## above the midpoint 464 answered NaN. That was a guess, written down as
## one, because no device this tree could reach accepted the type. Knife TA
## reached one: on a B200 (sm_100) `ftof` answers 448 for 480, -448 for -480
## and 448 for an infinity, and NaN only for NaN.
##
## 464 is unchanged and was never the question: it is the midpoint between
## 448 and the 480 an IEEE format of these widths would have, and 448's
## significand is the even one, so it ties DOWN under either reading. What
## the measurement settled is everything above it.
pub fn round_f8e4m3fn(x: Float) -> Float =
  if x != x {
    x
  } else {
    let v = round_binary(x, 4, -6, 8)
    if magnitude(v) <= 448.0 { v } else if v < 0.0 { -448.0 } else { 448.0 }
  }

## `x` rounded to f4E2M1FN: two significand bits, exponents 0..2, and
## SIXTEEN VALUES IN ALL: +/-0, +/-0.5, +/-1, +/-1.5, +/-2, +/-3, +/-4,
## +/-6. The whole value set fits on one line, which is what makes this
## format different from the eight-bit ones rather than merely smaller.
##
## FN here is stronger than `f8E4M3FN`'s. That format has no infinity and
## keeps two NaN encodings; this one has NEITHER, so every one of the
## sixteen bit patterns is a finite number and there is nothing to answer
## with when a value does not fit. So the two answers below are CHOICES,
## and this tree cannot measure either: `tileiras` 13.3.36 refuses the type
## at sm_86 and sm_89 and takes it only from sm_100, and the machine of the
## ledger is an RTX 3080 (docs/tile-backend-design.md 6.12).
##
##   * a magnitude above the largest finite value SATURATES to it, sign
##     kept, rather than overflowing. There is no infinity to overflow to,
##     and the OCP MX specification's conversions saturate.
##   * NaN answers +0.0. There is no NaN encoding either, and zero is the
##     one value that is not a plausible answer to any finite input, so a
##     corpus that reads it back knows it hit this arm.
##
## The rounding itself is [`round_binary`]'s: two significand bits (the
## hidden one included), minimum normal exponent 0 and maximum 2, so the
## subnormal grid is 2^-1 and 0.5 is the one subnormal. Types.td's own
## example says the same in bits: 0001 is 0.5 and 0011 is 1.5.
pub fn round_f4e2m1(x: Float) -> Float =
  if x != x {
    0.0
  } else {
    let v = round_binary(x, 2, 0, 2)
    if magnitude(v) <= 6.0 { v } else if v < 0.0 { -6.0 } else { 6.0 }
  }

## `x` rounded to f8E8M0FNU: the exponent alone.
##
## The value set is the 255 powers 2^-127 .. 2^127 and NaN, and that is all
## of it: no sign bit, no significand, no zero, no infinity. So this is not
## a [`round_binary`] at some width, it is a different function, and its
## rounding mode is different too -- `ftof` accepts only `zero` and
## `positive_inf` for this target (Ops.td's FToFOp), never the
## `nearest_even` every other conversion here takes. This is the `zero` one,
## which is what packages/tileir writes: the answer is the largest power of
## two at or below `x`.
##
## NOTHING BUT NaN ANSWERS NaN, and that too is measured rather than
## chosen. This function used to send zero, every negative number and the
## infinities to NaN, on the reading that a format with no encoding for them
## has nothing else to answer. Knife TA asked a B200: zero answers 2^-127,
## -1 answers 1, an infinity answers 2^127, and 2^140 answers 2^127. So
## `ftof` into this format takes the MAGNITUDE and then clamps into the
## range, which is the same saturation the two fp8 formats above do, with
## the sign dropped because there is no sign bit to keep it in.
##
## A positive number below 2^-127 has no representable value below it and
## clamps UP to 2^-127; that arm was a guess too and the device agrees with
## it (2^-140 answers 2^-127).
##
## [`f8e8m0_bits`] is NOT changed to match: it answers what an octet means,
## and zero and the negatives are still not values of this format. The two
## functions answer different questions, and [`round_f8e5m2`] records the same
## split at the other end of the range.
pub fn round_f8e8m0(x: Float) -> Float =
  if x != x {
    x
  } else {
    let a = magnitude(x)
    if a == 0.0 {
      pow2(-127)
    } else if a == 1.0 / 0.0 {
      pow2(127)
    } else {
      let e = exponent(a)
      if e > 127 {
        pow2(127)
      } else if e < -127 {
        pow2(-127)
      } else {
        pow2(e)
      }
    }
  }

# ---- construction ----

## The bfloat16 nearest to `x`.
pub fn bf16(x: Float) -> BF16 = round_bf16(x)

## The binary16 nearest to `x`.
pub fn f16(x: Float) -> F16 = round_f16(x)

## The binary32 nearest to `x`.
pub fn f32(x: Float) -> F32 = round_f32(x)

# ---- rendering ----

# Each format renders as the Float it holds: every value of a narrow format is
# a Float, so the shortest round trip of that Float is also the shortest text
# that reads back as the format's value. Written out because an opaque type
# inherits no rendering from its target (spec 2.7); a narrow number is a value
# a caller prints, which is what earns these three their impl. `to_f64` rather
# than a conversion by binding keeps each body one expression.

impl Show[BF16] {
  fn show(x: BF16) -> String = show(to_f64(x))
}

impl Show[F16] {
  fn show(x: F16) -> String = show(to_f64(x))
}

impl Show[F32] {
  fn show(x: F32) -> String = show(to_f64(x))
}

# ---- arithmetic ----

## The operations every narrow format offers. `add`, `sub`, `mul`, `div` and
## `sqrt` are the format's correctly rounded operations (ties to even, overflow
## to infinity, gradual underflow); `neg` and `abs` are exact. Equality and
## order are the Float's, as on any opaque type, so `==` and `<` need no
## member. `a + b`, `a - b`, `a * b`, `a / b` and `-a` are `add`, `sub`,
## `mul`, `div` and `neg` under the operator's name, and `a % b` is the
## exact truncating remainder.
pub trait Narrow[T] {
  ## The value as a Float; exact, since every value of the format is one.
  fn to_f64(a: T) -> Float
  ## Correctly rounded sum.
  fn add(a: T, b: T) -> T
  ## Correctly rounded difference.
  fn sub(a: T, b: T) -> T
  ## Correctly rounded product.
  fn mul(a: T, b: T) -> T
  ## Correctly rounded quotient.
  fn div(a: T, b: T) -> T
  ## Correctly rounded square root.
  fn sqrt(a: T) -> T
  ## The negation.
  fn neg(a: T) -> T
  ## The magnitude.
  fn abs(a: T) -> T
}

impl Narrow[BF16] {
  fn to_f64(a: BF16) -> Float = a
  fn add(a: BF16, b: BF16) -> BF16 = {
    let x: Float = a
    let y: Float = b
    round_bf16(x + y)
  }
  fn sub(a: BF16, b: BF16) -> BF16 = {
    let x: Float = a
    let y: Float = b
    round_bf16(x - y)
  }
  fn mul(a: BF16, b: BF16) -> BF16 = {
    let x: Float = a
    let y: Float = b
    round_bf16(x * y)
  }
  fn div(a: BF16, b: BF16) -> BF16 = {
    let x: Float = a
    let y: Float = b
    round_bf16(x / y)
  }
  fn sqrt(a: BF16) -> BF16 = {
    let x: Float = a
    sqrt_binary(x, 8)
  }
  fn neg(a: BF16) -> BF16 = {
    let x: Float = a
    -x
  }
  fn abs(a: BF16) -> BF16 = {
    let x: Float = a
    magnitude(x)
  }
}

impl Narrow[F16] {
  fn to_f64(a: F16) -> Float = a
  fn add(a: F16, b: F16) -> F16 = {
    let x: Float = a
    let y: Float = b
    round_f16(x + y)
  }
  fn sub(a: F16, b: F16) -> F16 = {
    let x: Float = a
    let y: Float = b
    round_f16(x - y)
  }
  fn mul(a: F16, b: F16) -> F16 = {
    let x: Float = a
    let y: Float = b
    round_f16(x * y)
  }
  fn div(a: F16, b: F16) -> F16 = {
    let x: Float = a
    let y: Float = b
    round_f16(x / y)
  }
  fn sqrt(a: F16) -> F16 = {
    let x: Float = a
    sqrt_binary(x, 11)
  }
  fn neg(a: F16) -> F16 = {
    let x: Float = a
    -x
  }
  fn abs(a: F16) -> F16 = {
    let x: Float = a
    magnitude(x)
  }
}

impl Narrow[F32] {
  fn to_f64(a: F32) -> Float = a
  fn add(a: F32, b: F32) -> F32 = {
    let x: Float = a
    let y: Float = b
    round_f32(x + y)
  }
  fn sub(a: F32, b: F32) -> F32 = {
    let x: Float = a
    let y: Float = b
    round_f32(x - y)
  }
  fn mul(a: F32, b: F32) -> F32 = {
    let x: Float = a
    let y: Float = b
    round_f32(x * y)
  }
  fn div(a: F32, b: F32) -> F32 = {
    let x: Float = a
    let y: Float = b
    round_f32(x / y)
  }
  fn sqrt(a: F32) -> F32 = {
    let x: Float = a
    sqrt_binary(x, 24)
  }
  fn neg(a: F32) -> F32 = {
    let x: Float = a
    -x
  }
  fn abs(a: F32) -> F32 = {
    let x: Float = a
    magnitude(x)
  }
}

# ---- operators and literals ----
#
# The operators are the `Narrow` members above under the operator's name,
# one impl per operator and format. Each body is a call, not a copy: the
# rounding is written once, and scripts/narrow-contract runs the operator
# and the named member over the same oracle cases, so a body that drifted
# from its name would be red there. Inside an impl body `add` names the
# `Narrow` member, since an operator trait's methods are not functions of
# the module (docs/arith-operator-traits-design.md D9).
#
# `%` has no `Narrow` member and needs no rounding. Float's `%` is the
# truncating remainder (the JVM's DREM, C's `fmod`), and that operation is
# exact in every binary format: the answer is `a - n * b` for an integer `n`,
# smaller in magnitude than `b`, and a multiple of the coarser of the two
# operands' quanta, so it is a value of the format both came from. The
# contract checks that against the rational definition rather than taking it
# on trust. tileir's `remf` rests on the same fact.
#
# `FromFloat` is the constructor: a literal at a format is the format's
# nearest value to the Float the literal denotes (literal design D8). There
# is no `FromInt`. bf16 has 256 consecutive integers and f16 2048; a
# `let w: BF16 = 1000001` that quietly meant 999424 is the surprise a
# literal at a narrow type must not have, and `1000001.0` says what it
# costs.

impl Add[BF16] {
  fn add(a: BF16, b: BF16) -> BF16 = add(a, b)
}

impl Sub[BF16] {
  fn sub(a: BF16, b: BF16) -> BF16 = sub(a, b)
}

impl Mul[BF16] {
  fn mul(a: BF16, b: BF16) -> BF16 = mul(a, b)
}

impl Div[BF16] {
  fn div(a: BF16, b: BF16) -> BF16 = div(a, b)
}

impl Rem[BF16] {
  fn rem(a: BF16, b: BF16) -> BF16 = {
    let x: Float = a
    let y: Float = b
    x % y
  }
}

impl Neg[BF16] {
  fn neg(a: BF16) -> BF16 = neg(a)
}

impl FromFloat[BF16] {
  fn from_float(x: Float) -> BF16 = bf16(x)
}

impl Add[F16] {
  fn add(a: F16, b: F16) -> F16 = add(a, b)
}

impl Sub[F16] {
  fn sub(a: F16, b: F16) -> F16 = sub(a, b)
}

impl Mul[F16] {
  fn mul(a: F16, b: F16) -> F16 = mul(a, b)
}

impl Div[F16] {
  fn div(a: F16, b: F16) -> F16 = div(a, b)
}

impl Rem[F16] {
  fn rem(a: F16, b: F16) -> F16 = {
    let x: Float = a
    let y: Float = b
    x % y
  }
}

impl Neg[F16] {
  fn neg(a: F16) -> F16 = neg(a)
}

impl FromFloat[F16] {
  fn from_float(x: Float) -> F16 = f16(x)
}

impl Add[F32] {
  fn add(a: F32, b: F32) -> F32 = add(a, b)
}

impl Sub[F32] {
  fn sub(a: F32, b: F32) -> F32 = sub(a, b)
}

impl Mul[F32] {
  fn mul(a: F32, b: F32) -> F32 = mul(a, b)
}

impl Div[F32] {
  fn div(a: F32, b: F32) -> F32 = div(a, b)
}

impl Rem[F32] {
  fn rem(a: F32, b: F32) -> F32 = {
    let x: Float = a
    let y: Float = b
    x % y
  }
}

impl Neg[F32] {
  fn neg(a: F32) -> F32 = neg(a)
}

impl FromFloat[F32] {
  fn from_float(x: Float) -> F32 = f32(x)
}

impl FromFloat[TF32] {
  fn from_float(x: Float) -> TF32 = round_tf32(x)
}

impl FromFloat[F8E4M3FN] {
  fn from_float(x: Float) -> F8E4M3FN = round_f8e4m3fn(x)
}

impl FromFloat[F8E5M2] {
  fn from_float(x: Float) -> F8E5M2 = round_f8e5m2(x)
}

impl FromFloat[F8E8M0FNU] {
  fn from_float(x: Float) -> F8E8M0FNU = round_f8e8m0(x)
}

impl FromFloat[F4E2M1FN] {
  fn from_float(x: Float) -> F4E2M1FN = round_f4e2m1(x)
}

impl Show[TF32] {
  fn show(x: TF32) -> String = {
    let v: Float = x
    show(v)
  }
}

impl Show[F8E4M3FN] {
  fn show(x: F8E4M3FN) -> String = {
    let v: Float = x
    show(v)
  }
}

impl Show[F8E5M2] {
  fn show(x: F8E5M2) -> String = {
    let v: Float = x
    show(v)
  }
}

impl Show[F8E8M0FNU] {
  fn show(x: F8E8M0FNU) -> String = {
    let v: Float = x
    show(v)
  }
}

impl Show[F4E2M1FN] {
  fn show(x: F4E2M1FN) -> String = {
    let v: Float = x
    show(v)
  }
}

# `<=` rather than `<` so that -0.0 comes out as +0.0, as the IEEE operation
# does. NaN is not <= 0 and passes through.
fn magnitude(x: Float) -> Float = if x <= 0.0 { 0.0 - x } else { x }

# The correctly rounded p-bit square root of `x`, a value of the p-bit format.
#
# Scale x by an even power of two to an integer N in [2^(2p), 2^(2p + 2)), so
# that sqrt(N) is in [2^p, 2^(p + 1)): p bits plus one. Scaling is exact
# because x has at most p significant bits (the caller's invariant) and N is
# at most 50 bits. The integer root t = floor(sqrt(N)) then carries the p-bit
# significand in its high bits, the rounding bit in its low bit, and whether
# anything was thrown away in N - t * t. A square root is never exactly
# halfway between two p-bit values (the square of a midpoint has 2p + 2
# significant bits and x has p), so the tie branch is unreachable and kept
# only so the rule reads whole. No overflow or underflow is possible: the
# root of the largest finite value is finite and the root of the smallest
# subnormal is a normal number.
fn sqrt_binary(x: Float, p: Int) -> Float =
  if x != x || x == 0.0 || x == 1.0 / 0.0 {
    x
  } else if x < 0.0 {
    0.0 / 0.0
  } else {
    let e = exponent(x)
    # 2k = 2p - e, made even by taking one more when e is odd
    let k2 = if e % 2 == 0 { 2 * p - e } else { 2 * p - e + 1 }
    let n = to_int(x * pow2(k2))
    let t = isqrt(n)
    let q = t / 2
    let rounded = if t % 2 == 0 {
      q
    } else if t * t != n {
      q + 1
    } else if q % 2 == 0 {
      q
    } else {
      q + 1
    }
    # sqrt(x) = sqrt(N) / 2^k, and sqrt(N) rounds to 2 * rounded
    to_float(rounded) * pow2(1 - k2 / 2)
  }

# floor(sqrt(n)) for n >= 0, by Newton's method from a power-of-two
# overestimate; the iterate decreases monotonically to the answer.
fn isqrt(n: Int) -> Int =
  if n < 2 {
    n
  } else {
    var guess = 1
    while guess * guess < n {
      guess = guess * 2
    }
    var next = (guess + n / guess) / 2
    while next < guess {
      guess = next
      next = (guess + n / guess) / 2
    }
    guess
  }

# e with 2^e <= x < 2^(e + 1), for finite positive x, by exact doublings and
# halvings of a running power of two.
fn exponent(x: Float) -> Int = {
  var pow = 1.0
  var e = 0
  while x >= pow * 2.0 {
    pow = pow * 2.0
    e = e + 1
  }
  while x < pow {
    pow = pow * 0.5
    e = e - 1
  }
  e
}

# ---- bit patterns ----
#
# The one place a narrow format's bits matter to a Dawn program is a device
# whose memory holds them (std/gpu's bf16 tensors). There is no float-to-bits
# primitive, so the pattern is assembled from the same exact arithmetic
# `round_binary` uses: the exponent by doublings and halvings, the
# significand by an exact power-of-two scaling. bfloat16 and binary16 have a
# codec here, the second because a device buffer of f16 elements needed one
# (std/gpu's `pack_f16`); binary32 would take the same shape with its own
# widths, and gets one when something needs it.

## The 16-bit pattern of the bfloat16 value `x`: the sign bit, eight exponent
## bits biased by 127, seven significand bits, as the value sits in memory.
## `x` is a value of the format, as [`round_bf16`] leaves it. For a Float off
## the bf16 grid the answer is the pattern with the extra significand bits
## dropped (truncation toward zero, what reading the high half of a binary32
## gives), NOT the nearest bf16: round first. A value beyond the format's
## range answers the infinity of its sign. NaN answers the canonical quiet
## NaN `0x7FC0`: a Float carries no payload a program can read, so none can
## be preserved.
pub fn bf16_bits(x: Float) -> Int =
  if x != x {
    0x7FC0
  } else {
    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)
    let sign = if neg { 0x8000 } else { 0 }
    let a = if neg { -x } else { x }
    if a == 0.0 {
      sign
    } else if a == 1.0 / 0.0 {
      sign | 0x7F80
    } else {
      let e = exponent(a)
      if e < -126 {
        # below the normal range: no hidden bit, the significand counts
        # quanta of 2^-133
        sign | to_int(a / pow2(-133))
      } else if e > 127 {
        sign | 0x7F80
      } else {
        sign | ((e + 127) << 7) | to_int((a / pow2(e) - 1.0) * 128.0)
      }
    }
  }

## The 16-bit pattern of the IEEE binary16 value `x`: the sign bit, five
## exponent bits biased by 15, ten significand bits, as the value sits in
## memory. The bfloat16 function's shape at binary16's widths, and the same
## contract: `x` is a value of the format, as [`round_f16`] leaves it, and a
## Float off the binary16 grid answers the pattern with the extra
## significand bits dropped rather than the nearest binary16. A value beyond
## the format's range answers the infinity of its sign; NaN answers the
## canonical quiet NaN `0x7E00`.
##
## The subnormal arm counts quanta of 2^-24, which is binary16's least
## positive value, where bfloat16 counts 2^-133; the two formats differ in
## every constant here and in nothing else.
pub fn f16_bits(x: Float) -> Int =
  if x != x {
    0x7E00
  } else {
    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)
    let sign = if neg { 0x8000 } else { 0 }
    let a = if neg { -x } else { x }
    if a == 0.0 {
      sign
    } else if a == 1.0 / 0.0 {
      sign | 0x7C00
    } else {
      let e = exponent(a)
      if e < -14 {
        # below the normal range: no hidden bit, the significand counts
        # quanta of 2^-24
        sign | to_int(a / pow2(-24))
      } else if e > 15 {
        sign | 0x7C00
      } else {
        sign | ((e + 15) << 10) | to_int((a / pow2(e) - 1.0) * 1024.0)
      }
    }
  }

## The IEEE binary16 value whose 16-bit pattern is the low 16 bits of `bits`,
## exactly, as a Float (every binary16 value is one). An exponent field of
## all ones is the infinity of the sign when the significand field is zero
## and NaN otherwise; an exponent field of zero is a subnormal, or the zero
## of the sign.
pub fn f16_of_bits(bits: Int) -> Float = {
  let b = bits & 0xFFFF
  let neg = (b & 0x8000) != 0
  let e = (b >>> 10) & 0x1F
  let m = b & 0x3FF
  let a = if e == 0x1F {
    if m == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }
  } else if e == 0 {
    to_float(m) * pow2(-24)
  } else {
    (1.0 + to_float(m) / 1024.0) * pow2(e - 15)
  }
  if neg { -a } else { a }
}

## The bfloat16 value whose 16-bit pattern is the low 16 bits of `bits`,
## exactly, as a Float (every bf16 value is one). An exponent field of all
## ones is the infinity of the sign when the significand field is zero and
## NaN otherwise; an exponent field of zero is a subnormal, or the zero of
## the sign.
pub fn bf16_of_bits(bits: Int) -> Float = {
  let b = bits & 0xFFFF
  let neg = (b & 0x8000) != 0
  let e = (b >>> 7) & 0xFF
  let m = b & 0x7F
  let a = if e == 0xFF {
    if m == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }
  } else if e == 0 {
    to_float(m) * pow2(-133)
  } else {
    (1.0 + to_float(m) / 128.0) * pow2(e - 127)
  }
  if neg { -a } else { a }
}

## The 32-bit pattern of the binary32 value `x`: the sign bit, eight
## exponent bits biased by 127, twenty-three significand bits. The bfloat16
## function's shape at binary32's widths and the same contract: `x` is a
## value of the format, as [`round_f32`] leaves it, and a Float off the grid
## answers the pattern with the extra bits dropped rather than the nearest
## binary32.
##
## This is the codec the module's header said would arrive "when something
## needs it". [`tf32_bits`] is what needs it: TensorFloat-32 lives in a
## binary32 word.
pub fn f32_bits(x: Float) -> Int =
  if x != x {
    0x7FC00000
  } else {
    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)
    let sign = if neg { 0x80000000 } else { 0 }
    let a = if neg { -x } else { x }
    if a == 0.0 {
      sign
    } else if a == 1.0 / 0.0 {
      sign | 0x7F800000
    } else {
      let e = exponent(a)
      if e < -126 {
        # below the normal range: no hidden bit, the significand counts
        # quanta of 2^-149
        sign | to_int(a / pow2(-149))
      } else if e > 127 {
        sign | 0x7F800000
      } else {
        sign | ((e + 127) << 23) | to_int((a / pow2(e) - 1.0) * pow2(23))
      }
    }
  }

## The binary32 value whose 32-bit pattern is the low 32 bits of `bits`,
## exactly, as a Float (every binary32 value is one).
pub fn f32_of_bits(bits: Int) -> Float = {
  let b = bits & 0xFFFFFFFF
  let neg = (b & 0x80000000) != 0
  let e = (b >>> 23) & 0xFF
  let m = b & 0x7FFFFF
  let a = if e == 0xFF {
    if m == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }
  } else if e == 0 {
    to_float(m) * pow2(-149)
  } else {
    (1.0 + to_float(m) / pow2(23)) * pow2(e - 127)
  }
  if neg { -a } else { a }
}

## The 32-bit pattern of the TensorFloat-32 value `x`: a binary32 word whose
## bottom THIRTEEN bits are zero. tf32 is nineteen bits of information (a
## sign, binary32's eight exponent bits and ten significand bits) and the
## hardware keeps it in a 32-bit slot, so a tf32 buffer is a buffer of
## 32-bit words and this is how one is laid out. `x` is a value of the
## format, as [`round_tf32`] leaves it.
pub fn tf32_bits(x: Float) -> Int = f32_bits(x) & 0xFFFFE000

## The TensorFloat-32 value whose 32-bit pattern is the low 32 bits of
## `bits`. The bottom thirteen bits are not part of the format and are
## ignored, so this is total on every word and `tf32_of_bits(tf32_bits(v))`
## is `v` for every value of the format.
pub fn tf32_of_bits(bits: Int) -> Float = f32_of_bits(bits & 0xFFFFE000)

## The octet of the f8E5M2 value `x`: the sign bit, five exponent bits
## biased by 15, two significand bits. The binary16 function's shape at
## eight bits; the subnormal arm counts quanta of 2^-16 and the canonical
## quiet NaN is `0x7E`.
pub fn f8e5m2_bits(x: Float) -> Int =
  if x != x {
    0x7E
  } else {
    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)
    let sign = if neg { 0x80 } else { 0 }
    let a = if neg { -x } else { x }
    if a == 0.0 {
      sign
    } else if a == 1.0 / 0.0 {
      sign | 0x7C
    } else {
      let e = exponent(a)
      if e < -14 {
        sign | to_int(a / pow2(-16))
      } else if e > 15 {
        sign | 0x7C
      } else {
        sign | ((e + 15) << 2) | to_int((a / pow2(e) - 1.0) * 4.0)
      }
    }
  }

## The f8E5M2 value whose octet is the low eight bits of `bits`, exactly.
pub fn f8e5m2_of_bits(bits: Int) -> Float = {
  let b = bits & 0xFF
  let neg = (b & 0x80) != 0
  let e = (b >>> 2) & 0x1F
  let m = b & 0x3
  let a = if e == 0x1F {
    if m == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }
  } else if e == 0 {
    to_float(m) * pow2(-16)
  } else {
    (1.0 + to_float(m) / 4.0) * pow2(e - 15)
  }
  if neg { -a } else { a }
}

## The octet of the f8E4M3FN value `x`: the sign bit, four exponent bits
## biased by 7, three significand bits. The subnormal arm counts quanta of
## 2^-9.
##
## THE ALL-ONES EXPONENT IS A NORMAL EXPONENT here, which is the whole
## difference from [`f8e5m2_bits`]: `0x7F` and `0xFF` are the format's only
## two NaN encodings and everything below them is finite, so `0x7E` is 448
## and not an infinity. A value beyond the range answers the canonical NaN
## `0x7F`, because there is no infinity to answer with.
pub fn f8e4m3fn_bits(x: Float) -> Int =
  if x != x {
    0x7F
  } else {
    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)
    let sign = if neg { 0x80 } else { 0 }
    let a = if neg { -x } else { x }
    if a == 0.0 {
      sign
    } else if a > 448.0 {
      0x7F
    } else {
      let e = exponent(a)
      if e < -6 {
        sign | to_int(a / pow2(-9))
      } else {
        sign | ((e + 7) << 3) | to_int((a / pow2(e) - 1.0) * 8.0)
      }
    }
  }

## The f8E4M3FN value whose octet is the low eight bits of `bits`, exactly.
## `0x7F` and `0xFF` are NaN and every other octet is a finite value.
pub fn f8e4m3fn_of_bits(bits: Int) -> Float = {
  let b = bits & 0xFF
  let neg = (b & 0x80) != 0
  let e = (b >>> 3) & 0xF
  let m = b & 0x7
  if e == 0xF && m == 0x7 {
    0.0 / 0.0
  } else {
    let a = if e == 0 {
      to_float(m) * pow2(-9)
    } else {
      (1.0 + to_float(m) / 8.0) * pow2(e - 7)
    }
    if neg { -a } else { a }
  }
}

## The NIBBLE of the f4E2M1FN value `x`: the sign bit, two exponent bits
## biased by 1, one significand bit, in the low four bits of the answer.
## The value set is small enough to lay out whole, and this does: the
## magnitude picks one of eight patterns and the sign is the top bit.
##
## `x` is a value of the format, as [`round_f4e2m1`] leaves it. Anything else
## is not on the grid and answers the nibble of the nearest value below it
## in magnitude, which is what [`f8e8m0_bits`] does with the same problem.
pub fn f4e2m1_bits(x: Float) -> Int = {
  let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)
  let a = magnitude(x)
  let m = if x != x {
    0
  } else if a >= 6.0 {
    7
  } else if a >= 4.0 {
    6
  } else if a >= 3.0 {
    5
  } else if a >= 2.0 {
    4
  } else if a >= 1.5 {
    3
  } else if a >= 1.0 {
    2
  } else if a >= 0.5 {
    1
  } else {
    0
  }
  if neg { m | 0x8 } else { m }
}

## The f4E2M1FN value whose nibble is the low four bits of `bits`, exactly.
## Every one of the sixteen patterns is a finite number, so this is total
## and has no NaN arm; `0x8` is negative zero.
pub fn f4e2m1_of_bits(bits: Int) -> Float = {
  let b = bits & 0xF
  let e = (b >>> 1) & 0x3
  let m = b & 0x1
  let a = if e == 0 {
    to_float(m) * 0.5
  } else {
    (1.0 + to_float(m) / 2.0) * pow2(e - 1)
  }
  if (b & 0x8) != 0 { -a } else { a }
}

## The octet of the f8E8M0FNU value `x`: the biased exponent alone, `e + 127`
## for `x = 2^e`, and `0xFF` for NaN. There is no sign bit and no
## significand, so an octet is a value and the codec is a shift.
## `x` is a value of the format, as [`round_f8e8m0`] leaves it; anything else
## answers NaN rather than the nearest power of two.
pub fn f8e8m0_bits(x: Float) -> Int =
  if x != x || x <= 0.0 || x == 1.0 / 0.0 {
    0xFF
  } else {
    let e = exponent(x)
    if e < -127 || e > 127 || x != pow2(e) { 0xFF } else { e + 127 }
  }

## The f8E8M0FNU value whose octet is the low eight bits of `bits`: `2^(b -
## 127)`, and NaN for `0xFF`. Every one of the other 255 octets is a
## distinct positive power of two, so this format has no zero.
pub fn f8e8m0_of_bits(bits: Int) -> Float = {
  let b = bits & 0xFF
  if b == 0xFF { 0.0 / 0.0 } else { pow2(b - 127) }
}

# ---- tests ----
#
# Representative cases only. The exact-oracle corpus that pins every path of
# `round_binary` and every trait operation on both backends, boundaries and
# random bit patterns alike, is scripts/spike-native/narrow_round.dawn, which
# scripts/narrow-contract generates from a rational oracle.

test "rounding breaks ties to even and rounds away otherwise" {
  # NearestEven is the default mode, so naming it changes nothing
  assert round_f32(1.0 + 1.0 / 16777216.0, mode: NearestEven) == round_f32(1.0 + 1.0 / 16777216.0)
  assert round_binary(1.0 + 3.0 / 256.0, 8, -126, 127, mode: NearestEven) == 1.0 + 1.0 / 64.0
  # 1 + 2^-8 sits exactly between 1 and 1 + 2^-7 in bf16; the even one wins
  assert round_bf16(1.0 + 1.0 / 256.0) == 1.0
  # 1 + 3 * 2^-8 sits between 1 + 2^-7 and 1 + 2^-6; even is the upper one
  assert round_bf16(1.0 + 3.0 / 256.0) == 1.0 + 1.0 / 64.0
  # just above the midpoint rounds up, just below rounds down
  assert round_bf16(1.0 + 3.0 / 512.0) == 1.0 + 1.0 / 128.0
  assert round_bf16(1.0 + 1.0 / 512.0) == 1.0
  # the same tie in the two other formats, at their own last places
  assert round_f16(1.0 + 1.0 / 2048.0) == 1.0
  assert round_f32(1.0 + 1.0 / 16777216.0) == 1.0
}

test "rounding overflows to infinity and keeps the largest finite value" {
  let inf = 1.0 / 0.0
  # bf16 max finite is (2 - 2^-7) * 2^127
  assert round_bf16(3.3895313892515355e38) == 3.3895313892515355e38
  assert round_bf16(3.4e38) == inf
  assert round_bf16(-3.4e38) == -inf
  # f16 max finite is 65504; 65520 is the midpoint above it and rounds even,
  # which is the carry out of the top exponent, so infinity
  assert round_f16(65504.0) == 65504.0
  assert round_f16(65519.0) == 65504.0
  assert round_f16(65520.0) == inf
  # f32 max finite
  assert round_f32(3.4028234663852886e38) == 3.4028234663852886e38
  assert round_f32(3.4028235677973366e38) == inf
  # the non-finite values pass through
  assert round_bf16(inf) == inf
  assert round_f16(-inf) == -inf
  let nan = round_f32(0.0 / 0.0)
  assert nan != nan
}

test "rounding lands tiny values on the subnormal grid" {
  # the bf16 subnormal quantum is 2^-133; 1e-40 is 1.09 quanta, so one
  assert round_bf16(1.0e-40) == 9.183549615799121e-41
  # the smallest bf16 subnormal, and half of it, which is a tie down to zero
  assert round_bf16(9.183549615799121e-41) == 9.183549615799121e-41
  assert round_bf16(4.591774807899561e-41) == 0.0
  # a negative underflow is the negative zero
  assert 1.0 / round_bf16(-4.591774807899561e-41) == -1.0 / 0.0
  # f16: quantum 2^-24, so 1e-7 (1.68 quanta) rounds to two of them
  assert round_f16(1.0e-7) == 1.1920928955078125e-7
  # f32: the smallest subnormal is 2^-149
  assert round_f32(1.401298464324817e-45) == 1.401298464324817e-45
  assert round_f32(1.0e-46) == 0.0
  # a Float subnormal is far below every grid here
  assert round_bf16(5.0e-324) == 0.0
  assert round_f32(5.0e-324) == 0.0
}

test "the operators are the named members, and remainder is exact" {
  let one = bf16(1.0)
  let half_ulp = bf16(1.0 / 256.0)
  # 1 + 2^-8 is the bf16 tie from the first test: `+` rounds it, to even
  assert to_f64(one + half_ulp) == 1.0
  assert one + half_ulp == add(one, half_ulp)
  assert to_f64(one - half_ulp) == round_bf16(1.0 - 1.0 / 256.0)
  assert f16(3.0) * f16(1.0 / 3.0) == mul(f16(3.0), f16(1.0 / 3.0))
  assert to_f64(f32(1.0) / f32(3.0)) == round_f32(1.0 / 3.0)
  assert to_f64(-bf16(1.5)) == -1.5
  # a negative zero survives negation, as the format's own does
  assert 1.0 / to_f64(-bf16(0.0)) == -1.0 / 0.0
  # 7 % 2.5 is 2 exactly, and so is 1e10 % 3, whose answer 1 lies far below
  # the last place of 1e10 in binary32 (1024)
  assert to_f64(bf16(7.0) % bf16(2.5)) == 2.0
  assert to_f64(f32(1.0e10) % f32(3.0)) == 1.0
  assert to_f64(f16(-7.0) % f16(2.0)) == -1.0
}

test "directed rounding takes the neighbour on the named side" {
  let inf = 1.0 / 0.0
  # 1 + 2^-8 lies strictly between 1 and 1 + 2^-7 in bf16, so the three
  # modes disagree with each other and with the tie-to-even answer above
  let between = 1.0 + 1.0 / 256.0
  assert round_binary(between, 8, -126, 127, mode: TowardZero) == 1.0
  assert round_binary(between, 8, -126, 127, mode: Down) == 1.0
  assert round_binary(between, 8, -126, 127, mode: Up) == 1.0 + 1.0 / 128.0
  # the same value negated: `TowardZero` and `Up` now name the same
  # neighbour and `Down` names the other one
  assert round_binary(-between, 8, -126, 127, mode: TowardZero) == -1.0
  assert round_binary(-between, 8, -126, 127, mode: Up) == -1.0
  assert round_binary(-between, 8, -126, 127, mode: Down) == -(1.0 + 1.0 / 128.0)
  # a value already on the grid does not move, in any mode or sign
  assert round_binary(1.0 + 1.0 / 128.0, 8, -126, 127, mode: TowardZero) == 1.0 + 1.0 / 128.0
  assert round_binary(-1.0, 8, -126, 127, mode: Down) == -1.0
  assert round_f32(0.5, mode: Up) == 0.5
  # binary32, where the last place is 2^-24 at 1: a third of it up and down
  assert round_f32(1.0 + 1.0 / 50331648.0, mode: Up) == 1.0 + 1.0 / 8388608.0
  assert round_f32(1.0 + 1.0 / 50331648.0, mode: Down) == 1.0
  # subnormals: the f32 quantum below 2^-126 is 2^-149, and 1.5 quanta
  # goes to one or to two depending on the side
  let subnormal = 1.5 * 1.401298464324817e-45
  assert round_f32(subnormal, mode: TowardZero) == 1.401298464324817e-45
  assert round_f32(subnormal, mode: Up) == 2.802596928649634e-45
  assert round_f32(-subnormal, mode: Down) == -2.802596928649634e-45
  # under the smallest subnormal, one side is zero and the other is it
  assert round_f32(1.0e-46, mode: TowardZero) == 0.0
  assert round_f32(1.0e-46, mode: Up) == 1.401298464324817e-45
  # OVERFLOW is the one place these differ from round_binary in kind:
  # towards the sign it is the infinity, away from it the largest finite
  assert round_f32(1.0e39, mode: Up) == inf
  assert round_f32(1.0e39, mode: TowardZero) == 3.4028234663852886e38
  assert round_f32(1.0e39, mode: Down) == 3.4028234663852886e38
  assert round_f32(-1.0e39, mode: Down) == -inf
  assert round_f32(-1.0e39, mode: TowardZero) == -3.4028234663852886e38
  assert round_f32(-1.0e39, mode: Up) == -3.4028234663852886e38
  # the non-finite values pass through, as they do for round_binary
  assert round_f32(inf, mode: TowardZero) == inf
  assert round_f32(-inf, mode: Up) == -inf
  let nan = round_f32(0.0 / 0.0, mode: Down)
  assert nan != nan
  assert round_f32(0.0, mode: Up) == 0.0
  assert 1.0 / round_f32(-0.0, mode: Up) == -inf
}

test "ties away from zero move a tie up in magnitude and leave everything else to round_binary" {
  let inf = 1.0 / 0.0
  # tf32's last place at 1 is 2^-10, so 1 + 2^-11 is exactly halfway between
  # 1 (even) and 1 + 2^-10 (odd): the two rules disagree, in both signs
  let tie = 1.0 + 1.0 / 2048.0
  assert round_tf32(tie) == 1.0
  assert round_tf32(tie, mode: NearestAway) == 1.0 + 1.0 / 1024.0
  assert round_tf32(-tie) == -1.0
  assert round_tf32(-tie, mode: NearestAway) == -(1.0 + 1.0 / 1024.0)
  # a tie whose lower neighbour is ODD goes up under both rules
  let odd_tie = 1.0 + 3.0 / 2048.0
  assert round_tf32(odd_tie) == 1.0 + 1.0 / 512.0
  assert round_tf32(odd_tie, mode: NearestAway) == 1.0 + 1.0 / 512.0
  # off a tie the two agree, on either side of it
  assert round_tf32(tie + 1.0 / 1048576.0, mode: NearestAway) == round_tf32(tie + 1.0 / 1048576.0)
  assert round_tf32(tie - 1.0 / 1048576.0, mode: NearestAway) == 1.0
  # the general function, at bfloat16's eight bits: 1 + 2^-8 is a tie there
  assert round_binary(1.0 + 1.0 / 256.0, 8, -126, 127, mode: NearestAway) == 1.0 + 1.0 / 128.0
  assert round_binary(1.0 + 1.0 / 256.0, 8, -126, 127) == 1.0
  # a tie on the subnormal grid: tf32's quantum below 2^-126 is 2^-136, and
  # half of it rounds to it under ties-away and to zero under ties-to-even
  let q = 1.401298464324817e-45 * 8192.0
  assert round_tf32(q / 2.0, mode: NearestAway) == q
  assert round_tf32(q / 2.0) == 0.0
  # the largest binary32 value is past tf32's last midpoint, so it
  # overflows under both rules
  assert round_tf32(3.4028234663852886e38, mode: NearestAway) == inf
  assert round_tf32(3.4028234663852886e38) == inf
  # the non-finite values and the zeros pass through
  assert round_tf32(inf, mode: NearestAway) == inf
  assert round_tf32(-inf, mode: NearestAway) == -inf
  let nan = round_tf32(0.0 / 0.0, mode: NearestAway)
  assert nan != nan
  assert 1.0 / round_tf32(-0.0, mode: NearestAway) == -inf
}

test "the trait operations are the format's, with the theorem's rounding" {
  # bf16 cannot hold 1 + 2^-8: the sum of two exact operands ties to even
  let one = bf16(1.0)
  let tiny = bf16(1.0 / 256.0)
  assert to_f64(add(one, tiny)) == 1.0
  assert to_f64(add(bf16(1.0 + 1.0 / 128.0), tiny)) == 1.0 + 1.0 / 64.0
  # 0.1 is not a bf16; the constructor rounds and the value is closed
  assert to_f64(bf16(0.1)) == 0.10009765625
  assert to_f64(mul(bf16(0.1), bf16(3.0))) == round_bf16(0.10009765625 * 3.0)
  # division and square root round the same way
  assert to_f64(div(bf16(1.0), bf16(3.0))) == 0.333984375
  assert to_f64(sqrt(bf16(2.0))) == 1.4140625
  assert to_f64(sqrt(f16(2.0))) == 1.4140625
  assert to_f64(sqrt(f32(2.0))) == 1.4142135381698608
  # overflow is the infinity, underflow the zero of the sign
  let inf = 1.0 / 0.0
  assert to_f64(mul(bf16(3.0e38), bf16(2.0))) == inf
  assert to_f64(div(f16(1.0), f16(0.0))) == inf
  assert 1.0 / to_f64(mul(f16(-1.0e-7), f16(0.25))) == -inf
  # the exact operations
  assert to_f64(neg(bf16(1.5))) == -1.5
  assert to_f64(abs(bf16(-1.5))) == 1.5
  assert 1.0 / to_f64(abs(bf16(-0.0))) == inf
  assert to_f64(sub(f32(1.0), f32(1.0e-8))) == 1.0
  # equality and order are the Float's
  assert bf16(1.0) == bf16(1.0 + 1.0 / 512.0)
  assert bf16(1.0) < bf16(1.01)
}

test "every bf16 bit pattern round-trips through its value, and the value is on round_bf16's grid" {
  # 65536 patterns: every one that is not a NaN comes back as itself, and
  # `round_bf16` leaves its value alone, so the codec's grid is the
  # rounding's grid. The 254 NaN patterns (exponent all ones, significand
  # nonzero, either sign) decode to a NaN and re-encode to the canonical one.
  var bad = 0
  var nans = 0
  var b = 0
  while b < 65536 {
    let v = bf16_of_bits(b)
    if v != v {
      nans = nans + 1
      if bf16_bits(v) != 0x7FC0 { bad = bad + 1 } else { () }
    } else if bf16_bits(v) != b || round_bf16(v) != v {
      bad = bad + 1
    } else {
      ()
    }
    b = b + 1
  }
  assert bad == 0
  assert nans == 254
}

test "every f16 bit pattern round-trips through its value, and the value is on round_f16's grid" {
  # The bf16 exhaustive check at binary16's widths. 2046 NaN patterns here
  # against bf16's 254: binary16 has a ten-bit significand under an
  # all-ones exponent, and both signs.
  var bad = 0
  var nans = 0
  var b = 0
  while b < 65536 {
    let v = f16_of_bits(b)
    if v != v {
      nans = nans + 1
      if f16_bits(v) != 0x7E00 { bad = bad + 1 } else { () }
    } else if f16_bits(v) != b || round_f16(v) != v {
      bad = bad + 1
    } else {
      ()
    }
    b = b + 1
  }
  assert bad == 0
  assert nans == 2046
}

test "the f16 codec spells the special values and the named boundaries" {
  let inf = 1.0 / 0.0
  assert f16_bits(1.0) == 0x3C00
  assert f16_bits(-1.5) == 0xBE00
  assert f16_bits(0.0) == 0x0000
  # the negative zero keeps its sign, both ways
  assert f16_bits(0.0 * (0.0 - 1.0)) == 0x8000
  assert 1.0 / f16_of_bits(0x8000) == -inf
  assert f16_bits(inf) == 0x7C00
  assert f16_bits(-inf) == 0xFC00
  assert f16_of_bits(0x7C00) == inf
  let nan = f16_of_bits(0x7C01)
  assert nan != nan
  assert f16_bits(0.0 / 0.0) == 0x7E00
  # the smallest subnormal (2^-24), the largest subnormal, the smallest normal
  assert f16_of_bits(0x0001) == 5.960464477539063e-8
  assert f16_bits(5.960464477539063e-8) == 0x0001
  assert f16_of_bits(0x03FF) == 1023.0 * 5.960464477539063e-8
  assert f16_of_bits(0x0400) == 0.00006103515625
  # the largest finite value
  assert f16_of_bits(0x7BFF) == 65504.0
  assert f16_bits(65504.0) == 0x7BFF
  # off the grid: the bits truncate, the rounding does not; a value past the
  # range is the infinity
  assert f16_bits(1.0 + 3.0 / 4096.0) == 0x3C00
  assert f16_bits(round_f16(1.0 + 3.0 / 4096.0)) == 0x3C01
  assert f16_bits(1.0e300) == 0x7C00
  # bits above the sixteenth are ignored
  assert f16_of_bits(0x13C00) == 1.0
}

test "the bf16 codec spells the special values and the named boundaries" {
  let inf = 1.0 / 0.0
  assert bf16_bits(1.0) == 0x3F80
  assert bf16_bits(-1.5) == 0xBFC0
  assert bf16_bits(0.0) == 0x0000
  # the negative zero keeps its sign, both ways
  assert bf16_bits(0.0 * (0.0 - 1.0)) == 0x8000
  assert 1.0 / bf16_of_bits(0x8000) == -inf
  assert bf16_bits(inf) == 0x7F80
  assert bf16_bits(-inf) == 0xFF80
  assert bf16_of_bits(0x7F80) == inf
  let nan = bf16_of_bits(0x7F81)
  assert nan != nan
  assert bf16_bits(0.0 / 0.0) == 0x7FC0
  # the smallest subnormal, the largest subnormal, the smallest normal
  assert bf16_of_bits(0x0001) == 9.183549615799121e-41
  assert bf16_bits(9.183549615799121e-41) == 0x0001
  assert bf16_of_bits(0x007F) == 127.0 * 9.183549615799121e-41
  assert bf16_of_bits(0x0080) == 1.1754943508222875e-38
  # the largest finite value
  assert bf16_of_bits(0x7F7F) == 3.3895313892515355e38
  assert bf16_bits(3.3895313892515355e38) == 0x7F7F
  # off the grid: the bits truncate, the rounding does not; a value past the
  # range is the infinity
  assert bf16_bits(1.0 + 3.0 / 512.0) == 0x3F80
  assert bf16_bits(round_bf16(1.0 + 3.0 / 512.0)) == 0x3F81
  assert bf16_bits(1.0e300) == 0x7F80
  # bits above the sixteenth are ignored
  assert bf16_of_bits(0x13F80) == 1.0
}

# ---- the formats knife T3 added ----
#
# Four roundings and five codecs, tested at the four places a rounding can
# be wrong: a tie, the subnormal grid, the largest finite value and NaN.
# The exhaustive checks are the two eight-bit ones, which are cheap enough
# to run over every octet and are the only ones here where "every pattern"
# is a small number.

test "the tf32 rounding is binary32's exponents with eleven significand bits" {
  # 1 + 2^-11 is the midpoint between 1 and 1 + 2^-10; the even one wins
  assert round_tf32(1.0 + 1.0 / 2048.0) == 1.0
  assert round_tf32(1.0 + 3.0 / 2048.0) == 1.0 + 1.0 / 512.0
  # just off the midpoint, both ways
  assert round_tf32(1.0 + 3.0 / 4096.0) == 1.0 + 1.0 / 1024.0
  assert round_tf32(1.0 + 1.0 / 4096.0) == 1.0
  # binary32 keeps the whole of a value tf32 cuts: the two differ on
  # anything with more than eleven significand bits
  assert round_f32(1.0 + 1.0 / 4096.0) == 1.0 + 1.0 / 4096.0
  # the exponent range is binary32's, so the largest finite value has
  # binary32's exponent and tf32's significand
  let max_tf32 = (2.0 - pow2(-10)) * pow2(127)
  assert round_tf32(max_tf32) == max_tf32
  assert round_f32(max_tf32) == max_tf32
  # the midpoint above it carries out of the top exponent, so it is the
  # infinity, exactly as binary16's 65520 is
  assert round_tf32((2.0 - pow2(-11)) * pow2(127)) == 1.0 / 0.0
  assert round_tf32(-3.5e38) == 0.0 - 1.0 / 0.0
  # the subnormal grid is 2^(-126 - 10) = 2^-136
  assert round_tf32(pow2(-136)) == pow2(-136)
  assert round_tf32(pow2(-138)) == 0.0
}

test "the tf32 codec is a binary32 word with thirteen zero bits" {
  assert tf32_bits(1.0) == 0x3F800000
  assert tf32_bits(-1.5) == 0xBFC00000
  assert tf32_bits(0.0) == 0
  assert tf32_bits(1.0 / 0.0) == 0x7F800000
  assert tf32_bits(0.0 / 0.0) == 0x7FC00000
  # the low thirteen bits are not part of the format, in both directions
  assert tf32_bits(round_tf32(1.0 + 1.0 / 1024.0)) == 0x3F802000
  assert tf32_of_bits(0x3F802000 | 0x1FFF) == 1.0 + 1.0 / 1024.0
  # every value of the format round-trips, and it is on round_tf32's grid
  var bad = 0
  var b = 0
  while b < 512 {
    let word = (b << 23) | ((b % 1024) << 13)
    let v = tf32_of_bits(word)
    if v != v {
      ()
    } else if tf32_bits(v) != (word & 0xFFFFE000) || round_tf32(v) != v {
      bad = bad + 1
    } else {
      ()
    }
    b = b + 1
  }
  assert bad == 0
}

test "every f8E5M2 octet round-trips through its value, and the value is on round_f8e5m2's grid" {
  var bad = 0
  var nans = 0
  var infinities = 0
  var b = 0
  while b < 256 {
    let v = f8e5m2_of_bits(b)
    if v != v {
      nans = nans + 1
      if f8e5m2_bits(v) != 0x7E { bad = bad + 1 } else { () }
    } else if v - v != 0.0 {
      # the two infinity octets: the codec keeps them (they are values of
      # the format) and the conversion never answers one, so they are the
      # only octets that are not fixed points of `round_f8e5m2`
      infinities = infinities + 1
      if f8e5m2_bits(v) != b { bad = bad + 1 } else { () }
    } else if f8e5m2_bits(v) != b || round_f8e5m2(v) != v {
      bad = bad + 1
    } else {
      ()
    }
    b = b + 1
  }
  assert bad == 0
  # exponent all ones, significand nonzero, either sign: 3 + 3
  assert nans == 6
  # and the two whose significand is zero
  assert infinities == 2
}

test "the f8E5M2 rounding and codec spell the named boundaries" {
  let inf = 1.0 / 0.0
  assert f8e5m2_bits(1.0) == 0x3C
  assert f8e5m2_bits(-1.5) == 0xBE
  assert f8e5m2_bits(inf) == 0x7C
  assert f8e5m2_of_bits(0x7C) == inf
  # the largest finite value is 1.75 * 2^15, and the midpoint above it
  # carries out of the top exponent
  assert round_f8e5m2(57344.0) == 57344.0
  assert round_f8e5m2(61439.0) == 57344.0
  # and the conversion SATURATES rather than overflowing, although the
  # format has an infinity and the codec above keeps it (knife TA measured
  # it on a B200: 1e30, -1e30 and an infinity all answer +/-57344)
  assert round_f8e5m2(61440.0) == 57344.0
  assert round_f8e5m2(1.0e30) == 57344.0
  assert round_f8e5m2(0.0 - 1.0e30) == 0.0 - 57344.0
  assert round_f8e5m2(inf) == 57344.0
  assert f8e5m2_of_bits(0x7B) == 57344.0
  # ties to even at the last place: 1 + 2^-3 sits between 1 and 1 + 2^-2
  assert round_f8e5m2(1.0 + 1.0 / 8.0) == 1.0
  assert round_f8e5m2(1.0 + 3.0 / 8.0) == 1.0 + 1.0 / 2.0
  # the subnormal quantum is 2^-16
  assert f8e5m2_of_bits(0x01) == pow2(-16)
  assert round_f8e5m2(pow2(-17)) == 0.0
  assert round_f8e5m2(pow2(-16) * 1.5) == pow2(-16) * 2.0
}

test "every f8E4M3FN octet round-trips through its value, and the value is on round_f8e4m3fn's grid" {
  var bad = 0
  var nans = 0
  var b = 0
  while b < 256 {
    let v = f8e4m3fn_of_bits(b)
    if v != v {
      nans = nans + 1
      if f8e4m3fn_bits(v) != 0x7F { bad = bad + 1 } else { () }
    } else if f8e4m3fn_bits(v) != b || round_f8e4m3fn(v) != v {
      bad = bad + 1
    } else {
      ()
    }
    b = b + 1
  }
  assert bad == 0
  # FN: the ONLY NaN encodings are 0x7F and 0xFF, and there is no infinity,
  # where f8E5M2 has three NaNs a sign
  assert nans == 2
}

test "f8E4M3FN has no infinity, so its overflow is NaN and its largest finite value is 448" {
  assert f8e4m3fn_of_bits(0x7E) == 448.0
  assert f8e4m3fn_bits(448.0) == 0x7E
  assert round_f8e4m3fn(448.0) == 448.0
  # 464 is the midpoint between 448 and the 480 an IEEE format of these
  # widths would have; 448's significand is the even one, so it ties down
  assert round_f8e4m3fn(464.0) == 448.0
  # above it the conversion SATURATES; knife TA measured 480, -480 and an
  # infinity on a B200 and got 448, -448 and 448
  assert round_f8e4m3fn(465.0) == 448.0
  assert round_f8e4m3fn(1.0e30) == 448.0
  assert round_f8e4m3fn(-465.0) == 0.0 - 448.0
  assert round_f8e4m3fn(1.0 / 0.0) == 448.0
  let nan = round_f8e4m3fn(0.0 / 0.0)
  assert nan != nan
  # ties to even at the last place, and the subnormal quantum 2^-9
  assert round_f8e4m3fn(1.0 + 1.0 / 16.0) == 1.0
  assert round_f8e4m3fn(1.0 + 3.0 / 16.0) == 1.0 + 1.0 / 4.0
  assert f8e4m3fn_of_bits(0x01) == pow2(-9)
  assert round_f8e4m3fn(pow2(-10)) == 0.0
  assert round_f8e4m3fn(pow2(-9) * 1.5) == pow2(-9) * 2.0
}

test "f8E8M0FNU is the exponent alone, rounded toward zero" {
  # the conversion takes the MAGNITUDE and clamps into the range; only NaN
  # answers NaN (knife TA measured all four of these on a B200)
  assert round_f8e8m0(0.0) == pow2(-127)
  assert round_f8e8m0(-1.0) == 1.0
  assert round_f8e8m0(-3.0) == 2.0
  assert round_f8e8m0(1.0 / 0.0) == pow2(127)
  let nan = round_f8e8m0(0.0 / 0.0)
  assert nan != nan
  # rounding toward zero is the largest power of two at or below x: 1.99
  # answers 1 and not 2, which is where this differs from every other
  # rounding in this module
  assert round_f8e8m0(1.99) == 1.0
  assert round_f8e8m0(2.0) == 2.0
  assert round_f8e8m0(0.75) == 0.5
  # the ends: 2^127 is the largest, 2^-127 the smallest, and there is
  # nothing below it to round down to, so a smaller value clamps up
  assert round_f8e8m0(pow2(127)) == pow2(127)
  assert round_f8e8m0(pow2(128)) == pow2(127)
  assert round_f8e8m0(pow2(-127)) == pow2(-127)
  assert round_f8e8m0(pow2(-200)) == pow2(-127)
  # every octet is a value and every value an octet; 0xFF alone is NaN
  var bad = 0
  var b = 0
  while b < 256 {
    let v = f8e8m0_of_bits(b)
    if v != v {
      if b != 0xFF { bad = bad + 1 } else { () }
    } else if f8e8m0_bits(v) != b || round_f8e8m0(v) != v {
      bad = bad + 1
    } else {
      ()
    }
    b = b + 1
  }
  assert bad == 0
  assert f8e8m0_bits(1.0) == 127
  assert f8e8m0_bits(0.0 / 0.0) == 0xFF
  # a value off the grid is not a value of the format, and the codec says
  # so rather than snapping it to a neighbour
  assert f8e8m0_bits(1.5) == 0xFF
}

test "the binary32 codec spells the special values and the named boundaries" {
  let inf = 1.0 / 0.0
  assert f32_bits(1.0) == 0x3F800000
  assert f32_bits(-1.5) == 0xBFC00000
  assert f32_bits(0.0) == 0
  assert f32_bits(0.0 * (0.0 - 1.0)) == 0x80000000
  assert 1.0 / f32_of_bits(0x80000000) == -inf
  assert f32_bits(inf) == 0x7F800000
  assert f32_bits(-inf) == 0xFF800000
  assert f32_bits(0.0 / 0.0) == 0x7FC00000
  let nan = f32_of_bits(0x7F800001)
  assert nan != nan
  # the smallest subnormal (2^-149), the smallest normal, the largest finite
  assert f32_of_bits(0x00000001) == pow2(-149)
  assert f32_bits(pow2(-149)) == 0x00000001
  assert f32_of_bits(0x00800000) == pow2(-126)
  assert f32_of_bits(0x7F7FFFFF) == 3.4028234663852886e38
  assert f32_bits(3.4028234663852886e38) == 0x7F7FFFFF
  # off the grid the bits truncate, as bf16_bits and f16_bits do
  assert f32_bits(1.0 + pow2(-30)) == 0x3F800000
}

test "the sixteen f4E2M1FN nibbles are sixteen finite values, and the codec is a bijection" {
  var seen: List[Float] = []
  var bad = 0
  var b = 0
  while b < 16 {
    let v = f4e2m1_of_bits(b)
    if v != v || f4e2m1_bits(v) != b || round_f4e2m1(v) != v {
      bad = bad + 1
    } else {
      ()
    }
    seen = seen ++ [v]
    b = b + 1
  }
  assert bad == 0
  # 0x0 and 0x8 are the two zeros, so fifteen distinct Floats
  assert seen == [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
    -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0]
}

test "f4E2M1FN rounds to nearest even, saturates instead of overflowing, and sends NaN to zero" {
  # Types.td's own example: 0.5 is 0001 and 1.5 is 0011
  assert f4e2m1_bits(0.5) == 0x1
  assert f4e2m1_bits(1.5) == 0x3
  # ties to even on the two grids: 0.25 is between 0 and 0.5, 1.25 between 1 and 1.5
  assert round_f4e2m1(0.25) == 0.0
  assert round_f4e2m1(0.75) == 1.0
  assert round_f4e2m1(1.25) == 1.0
  assert round_f4e2m1(1.75) == 2.0
  assert round_f4e2m1(2.5) == 2.0
  assert round_f4e2m1(3.5) == 4.0
  assert round_f4e2m1(5.0) == 4.0
  assert round_f4e2m1(5.5) == 6.0
  # saturation, the first of the two choices this format leaves open
  assert round_f4e2m1(6.5) == 6.0
  assert round_f4e2m1(1.0e30) == 6.0
  assert round_f4e2m1(0.0 - 1.0e30) == -6.0
  assert round_f4e2m1(1.0 / 0.0) == 6.0
  # NaN, the second
  assert round_f4e2m1(0.0 / 0.0) == 0.0
  # the subnormal grid is 0.5 and nothing lives under it
  assert round_f4e2m1(0.2) == 0.0
  assert round_f4e2m1(0.3) == 0.5
}

test "every narrow format is a device format, named as the dialect names it, by witness and by type" {
  assert dtype_name(BF16) == "bf16"
  assert dtype_name(F16) == "f16"
  assert dtype_name(F32) == "f32"
  assert dtype_name(TF32) == "tf32"
  assert dtype_name(F8E4M3FN) == "f8E4M3FN"
  assert dtype_name(F8E5M2) == "f8E5M2"
  assert dtype_name(F8E8M0FNU) == "f8E8M0FNU"
  assert dtype_name(F4E2M1FN) == "f4E2M1FN"
  let by_type: Dtype[F16] = dtype_of()
  assert dtype_name(by_type) == "f16"
  let again: Dtype[BF16] = dtype_of()
  assert dtype_name(again) == dtype_name(BF16)
}

test "a storage-only value shows as the Float it holds, and a literal at one is the nearest value (compile-time fold)" {
  # inside this module a literal at an own type is the unrounded Float (D7), so
  # the values are made with the rounding functions; the literal rule itself
  # is held by the impls' bodies, which are those functions
  let a: TF32 = round_tf32(1.0000001)
  assert show(a) == "1.0"
  let b: F8E4M3FN = round_f8e4m3fn(0.3)
  assert show(b) == "0.3125"
  let c: F8E5M2 = round_f8e5m2(0.3)
  assert show(c) == "0.3125"
  let d: F8E8M0FNU = round_f8e8m0(3.0)
  assert show(d) == "2.0"
  let e: F4E2M1FN = round_f4e2m1(2.4)
  assert show(e) == "2.0"
}

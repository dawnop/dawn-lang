entry @vadd_debug(%arg0: tile<ptr<f64>>, %arg1: tile<ptr<f64>>, %arg2: tile<ptr<f64>>) {
  %0 = make_token : token loc(#loc21)
  %gridSize_x, %gridSize_y, %gridSize_z = get_num_tile_blocks : tile<i32> loc(#loc22)
  %cst_128_i32 = constant <i32: 128> : tile<i32> loc(#loc23)
  %1 = muli %gridSize_x, %cst_128_i32 : tile<i32> loc(#loc24)
  %assume = assume div_by<16>, %arg0 : tile<ptr<f64>> loc(#loc25)
  %tview = make_tensor_view %assume, shape = [%1], strides = [1] : tile<i32> -> tensor_view<?xf64, strides=[1]> loc(#loc26)
  %pview = make_partition_view %tview : partition_view<tile=(128), padding_value = zero, tensor_view<?xf64, strides=[1]>> loc(#loc27)
  %blockId_x, %blockId_y, %blockId_z = get_tile_block_id : tile<i32> loc(#loc28)
  %tile, %result_token = load_view_tko weak %pview[%blockId_x] token = %0 : partition_view<tile=(128), padding_value = zero, tensor_view<?xf64, strides=[1]>>, tile<i32> -> tile<128xf64>, token loc(#loc29)
  %assume_0 = assume div_by<16>, %arg1 : tile<ptr<f64>> loc(#loc30)
  %tview_1 = make_tensor_view %assume_0, shape = [%1], strides = [1] : tile<i32> -> tensor_view<?xf64, strides=[1]> loc(#loc31)
  %pview_2 = make_partition_view %tview_1 : partition_view<tile=(128), padding_value = zero, tensor_view<?xf64, strides=[1]>> loc(#loc32)
  %tile_3, %result_token_4 = load_view_tko weak %pview_2[%blockId_x] token = %0 : partition_view<tile=(128), padding_value = zero, tensor_view<?xf64, strides=[1]>>, tile<i32> -> tile<128xf64>, token loc(#loc33)
  %2 = addf %tile, %tile_3  : tile<128xf64> loc(#loc34)
  %assume_5 = assume div_by<16>, %arg2 : tile<ptr<f64>> loc(#loc35)
  %tview_6 = make_tensor_view %assume_5, shape = [%1], strides = [1] : tile<i32> -> tensor_view<?xf64, strides=[1]> loc(#loc36)
  %pview_7 = make_partition_view %tview_6 : partition_view<tile=(128), padding_value = zero, tensor_view<?xf64, strides=[1]>> loc(#loc37)
  %3 = store_view_tko weak %2, %pview_7[%blockId_x] token = %0 : tile<128xf64>, partition_view<tile=(128), padding_value = zero, tensor_view<?xf64, strides=[1]>>, tile<i32> -> token loc(#loc38)
  return loc(#loc39)
} loc(#loc20)

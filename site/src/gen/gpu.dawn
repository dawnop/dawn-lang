# The cuTile backend's page, gpu.html: the two layers, a kernel lined up line
# by line with the Tile IR it records, the three coverage tables, the three
# gates and the mutants they catch, and the last line of every device ledger.
#
# Why every number on it is read and none is written. The backend's evidence
# already lives in tables the tile gates keep: scripts/tileir-features has a
# row per opcode, type tag and attribute value, scripts/tile-golden a pinned
# file per kernel, scripts/tile-gpu-diff a ledger line per run on a device.
# They move with every knife. A page that copied their totals by hand would be
# right on the day it was written and wrong from the next knife on, with
# nothing to say so; read at build time, it cannot disagree with them. The
# counting rule is not trusted either: a test below runs the gate that owns
# the tables (scripts/tileir-features/check.py) and holds this module's counts
# to the ones it prints, so two implementations of "how many are implemented"
# are compared instead of one being assumed to match the other.
#
# Why the files are read in place, from scripts/. They are the tile gates'
# own records, and a copy of them would be one more thing that could be
# stale. The one reader that does not run from the repository root is the
# JVM-against-native differential (scripts/site-dist-diff.sh), which runs
# this generator over a snapshot; the three tile directories are in that
# snapshot's list for this page's sake.
#
# Why the kernel section is a line map, and why `vadd` is the one embedded.
# Two code windows side by side (6 lines of Dawn, 27 of Tile IR) showed that
# a kernel becomes IR but not which line became which; the map puts each run
# of Dawn lines on the same row as the Tile IR it recorded. The pairing is
# never written here: packages/tileir's side table says which call wrote
# which line (recorded in site/gpu-map/calls.txt), and gen/gpumap.dawn
# reads which line of kernels.dawn each call is on, refusing a kernel where
# the two do not line up exactly. `vadd` is embedded, so the map is complete
# with no script: its body is four lines, its golden fits one screen, and it
# is the kernel layer 2 has compared bit for bit since the first device run.
# It has to line up or the build stops. Every other kernel that lines up is
# written as gpu/k/<name>.json and fetched only when a reader picks it; the
# page states how many of the goldens that is, counted when it is built.
#
# Why the rest of the page moves. The coverage cards count up and list the
# rows that are not implemented, the gates draw every mutant at the gate its
# harness proves, and real Tile IR drifts behind the head. Each is the
# markup's final state without gpu.js or under reduced motion; the script
# only starts it from nothing.
#
# The words are site/pages/gpu.md and its translation gpu.zh.md, in
# home.md's shape: the same keys in both, which a test below holds.

use std/str
use std/list
use std/io
use std/bytes
use std/io.{Fs, with_fs_real, with_proc_real}
use html/page.{Assets, Lang, En, Zh, PageHead, shell_ext, section_crumb, chip, plain_assets, repo_url}
use hl/dawn.{highlight_dawn}
use html/escape.{escape_html}
use gen/common.{must_read, must_list, write_page, map_doc_url, doc_files, fn_source}
use gen/fingerprint.{fingerprint}
use json/parser.{parse}
use json/value.{JObj, JArr, JStr, JInt}
use std/map
use gen/copy.{Copy, load_copy, line, plain, body}
use gen/gpumap.{KernelMap, Row, parse_calls, map_kernels, map_json, json_str, pure_fns}

# ---- the coverage tables ----

## The statuses a coverage row may carry, in the order check.py's STATUSES
## lists them and prints them.
pub fn statuses() -> List[String] = ["implemented", "unimplemented", "deferred", "structural"]

## One coverage table, counted: its name as check.py prints it, how many rows
## it has, and how many rows carry each status, in [statuses] order.
pub type Coverage = { name: String, total: Int, counts: List[(String, Int)] }

## How many rows of `c` carry `status`.
pub fn count_of(c: Coverage, status: String) -> Int = {
  var n = 0
  for e in c.counts {
    let (s, k) = e
    if s == status {
      n = k
    }
  }
  n
}

## The rows of one table, counted the way check.py's `parse_rows` reads them:
## a line that is blank or starts with `#` once trimmed is not a row, every
## other line is split on `|` into exactly eight trimmed fields, and the
## fourth is the status. A row of any other width, or with a status check.py
## does not know, is an error rather than a row skipped: a column dropped from
## the table is the change this has to notice, and skipping would count the
## remaining rows as if nothing had happened.
pub fn parse_table(name: String, text: String) -> Result[Coverage, String] = {
  var problems: List[String] = []
  var seen: List[String] = []
  var n = 0
  for raw in str.split(text, "\n") {
    n = n + 1
    let s = str.trim(raw)
    if s != "" && not str.starts_with(s, "#") {
      let fields = map(str.split(s, "|"), f => str.trim(f))
      if len(fields) != 8 {
        problems = problems ++ ["${name} line ${n}: ${len(fields)} fields, not 8"]
      } else if not list.contains(statuses(), fields[3]) {
        problems = problems ++ ["${name} line ${n}: status \"${fields[3]}\" is not one check.py knows"]
      } else {
        seen = seen ++ [fields[3]]
      }
    }
  }
  if len(problems) > 0 {
    Err(problems[0])
  } else if len(seen) == 0 {
    Err("${name}: no rows")
  } else {
    let rows = seen
    Ok(Coverage {
      name: name,
      total: len(rows),
      counts: map(statuses(), st => (st, len(filter(rows, x => x == st)))),
    })
  }
}

## The three tables, in the order check.py checks them, under its names.
fn table_files() -> List[(String, String)] =
  [("features", "features.txt"), ("types", "types.txt"), ("attrs", "attrs.txt")]

fn read_tables() -> List[Coverage] !Fs =
  map(table_files(), t => {
    let (name, file) = t
    match parse_table(name, must_read("scripts/tileir-features/${file}")) {
      Ok(c) -> c
      Err(e) -> panic("scripts/tileir-features/${file}: ${e}")
    }
  })

## One row of a coverage table, the columns this page reads: its name,
## status, knife, evidence entries and note (`-` read as none).
pub type CovRow = { table: String, name: String, status: String, knife: String, evidence: List[String], note: String }

## The rows of one table, by the column layout `parse_table` checks.
pub fn table_rows(table: String, text: String) -> List[CovRow] = {
  var out: List[CovRow] = []
  for raw in str.split(text, "\n") {
    let s = str.trim(raw)
    if s != "" && not str.starts_with(s, "#") {
      let fields = map(str.split(s, "|"), f => str.trim(f))
      if len(fields) == 8 {
        let none: List[String] = []
        let ev = if fields[6] == "-" { none } else { filter(str.split(fields[6], ","), e => e != "") }
        let note = if fields[7] == "-" { "" } else { fields[7] }
        let knife = if fields[4] == "-" { "" } else { fields[4] }
        out = out ++ [CovRow { table: table, name: fields[0], status: fields[3], knife: knife, evidence: ev, note: note }]
      }
    }
  }
  out
}

fn read_rows() -> List[CovRow] !Fs = {
  var out: List[CovRow] = []
  for t in table_files() {
    let (name, file) = t
    out = out ++ table_rows(name, must_read("scripts/tileir-features/${file}"))
  }
  out
}

## What check.py printed, as the same counts: one `PASS  tileir <name>:
## <total> <unit>(s): <status>=<n> ...; layer...` line per table. A status it
## does not print is zero, which is how it prints one (`if counts[s]`).
pub fn parse_check_output(out: String) -> List[Coverage] = {
  var found: List[Coverage] = []
  for l in str.split(out, "\n") {
    match str.strip_prefix(l, "PASS  tileir ") {
      Some(rest) ->
        match str.split_once(rest, ": ") {
          Some((name, tail)) -> {
            let total = unwrap_or(parse_int(unwrap_or(get(str.split(tail, " "), 0), "")), -1)
            let kinds =
              match str.split_once(tail, "(s): ") {
                Some((_, after)) ->
                  match str.split_once(after, ";") {
                    Some((ks, _)) -> ks
                    None -> after
                  }
                None -> ""
              }
            var pairs: List[(String, Int)] = []
            for tok in str.split(kinds, " ") {
              match str.split_once(tok, "=") {
                Some((k, v)) -> {
                  pairs = pairs ++ [(k, unwrap_or(parse_int(v), -1))]
                }
                None -> ()
              }
            }
            let said = pairs
            let counts = map(statuses(), st => {
              var k = 0
              for p in said {
                let (s, v) = p
                if s == st {
                  k = v
                }
              }
              (st, k)
            })
            found = found ++ [Coverage { name: name, total: total, counts: counts }]
          }
          None -> ()
        }
      None -> ()
    }
  }
  found
}

# ---- the golden kernels ----

## The kernels scripts/tile-golden pins, by the stems of their `.mlir` files.
pub fn golden_names() -> List[String] !Fs = {
  var out: List[String] = []
  for f in must_list("scripts/tile-golden") {
    match str.strip_suffix(f, ".mlir") {
      Some(stem) -> {
        out = out ++ [stem]
      }
      None -> ()
    }
  }
  out
}

## One function cut out of a file, with the lines it came from (1-based,
## both ends included). The text is [fn_source]'s, so the cut follows the
## front page's rule; the line numbers are found here and checked against it.
pub type Cut = { first: Int, last: Int, text: String }

pub fn cut_fn(src: String, name: String) -> Cut = {
  let text = fn_source(src, name)
  let lines = str.split(src, "\n")
  let head = "fn ${name}("
  var first = 0
  var i = 0
  for l in lines {
    i = i + 1
    if first == 0 && str.starts_with(l, head) {
      first = i
    }
  }
  let last = first + len(str.split(text, "\n")) - 1
  if first < 1 || last <= first || lines[first - 1] != str.split(text, "\n")[0] || lines[last - 1] != "}" {
    panic("cutting `${head}...`: lines ${first} to ${last} are not the function fn_source cut")
  }
  Cut { first: first, last: last, text: text }
}

# ---- the device ledgers ----

## The last line of one device ledger, field by field. `exact` and
## `tolerance` are the kernels the run compared at each tier, summed over the
## `tiers` pairs in the note; a line with no pair (a `blocked` run) has 0 and 0.
pub type Ledger = {
  file: String,
  commit: String,
  date: String,
  driver: String,
  tileiras: String,
  arch: String,
  result: String,
  exact: Int,
  tolerance: Int,
}

## The last line of a ledger that is a record and not a comment.
pub fn last_entry(text: String) -> Option[String] = {
  var last: Option[String] = None
  for raw in str.split(text, "\n") {
    let s = str.trim(raw)
    if s != "" && not str.starts_with(s, "#") {
      last = Some(s)
    }
  }
  last
}

## The two tier counts of a note: every `exact=<n>` token, bare or behind a
## family's `name:`, that is followed directly by a `tolerance=<m>` token.
## That adjacency is what makes it a tier pair; a lone `exact=` elsewhere in
## the note (dyn_diff's twin summary prints one) counts something else.
pub fn tiers(note: String) -> (Int, Int) = {
  let toks = filter(str.split(note, " "), t => t != "")
  var ex = 0
  var tol = 0
  var i = 0
  while i + 1 < len(toks) {
    let t = toks[i]
    let bare =
      match str.rsplit_once(t, ":") {
        Some((_, after)) -> after
        None -> t
      }
    match (str.strip_prefix(bare, "exact="), str.strip_prefix(toks[i + 1], "tolerance=")) {
      (Some(e), Some(m)) ->
        match (parse_int(e), parse_int(m)) {
          (Some(a), Some(b)) -> {
            ex = ex + a
            tol = tol + b
          }
          _ -> ()
        }
      _ -> ()
    }
    i = i + 1
  }
  (ex, tol)
}

fn all_chars(s: String, ok: fn(Char) -> Bool) -> Bool = {
  var good = s != ""
  for c in code_points(s) {
    if not ok(c) {
      good = false
    }
  }
  good
}

fn is_digit(c: Char) -> Bool = c >= '0' && c <= '9'

fn is_hex(c: Char) -> Bool = is_digit(c) || (c >= 'a' && c <= 'f')

## One ledger line, `<commit> <date> <driver> <tileiras> <gpu-name> <result>
## [# note]`, as the header of every ledger states it. Six columns before the
## note and no other number: a column dropped or one added is an error, and so
## is a commit that is not hex, a date that is not YYYY-MM-DD and a GPU name
## that is not `sm_<n>`, which is what a column moved to the wrong place
## would look like.
pub fn parse_ledger_line(file: String, l: String) -> Result[Ledger, String] = {
  let (head, note) =
    match str.split_once(l, " # ") {
      Some((h, n)) -> (h, n)
      None -> (l, "")
    }
  let cols = filter(str.split(str.trim(head), " "), x => x != "")
  if len(cols) != 6 {
    Err("${file}: the last line has ${len(cols)} columns before its note, not 6 "
        ++ "(commit date driver tileiras gpu-name result)")
  } else {
    let date_ok = str.len(cols[1]) == 10 && str.at(cols[1], 4) == '-' && str.at(cols[1], 7) == '-'
      && all_chars(str.replace(cols[1], "-", ""), is_digit)
    if str.len(cols[0]) < 12 || not all_chars(cols[0], is_hex) {
      Err("${file}: \"${cols[0]}\" is not a commit")
    } else if not date_ok {
      Err("${file}: \"${cols[1]}\" is not a date")
    } else if not all_chars(str.replace(cols[2], ".", ""), is_digit)
      || not all_chars(str.replace(cols[3], ".", ""), is_digit) {
        Err("${file}: \"${cols[2]}\" and \"${cols[3]}\" are not a driver and a tileiras version")
      } else if not (str.starts_with(cols[4], "sm_") && all_chars(str.drop(cols[4], 3), is_digit)) {
        Err("${file}: \"${cols[4]}\" is not a GPU name")
      } else {
        let (ex, tol) = tiers(note)
        Ok(Ledger {
          file: file,
          commit: str.take(cols[0], 12),
          date: cols[1],
          driver: cols[2],
          tileiras: cols[3],
          arch: cols[4],
          result: cols[5],
          exact: ex,
          tolerance: tol,
        })
      }
  }
}

fn arch_number(l: Ledger) -> Int = unwrap_or(parse_int(str.drop(l.arch, 3)), 0)

## Every `ledger*.txt` in scripts/tile-gpu-diff, last line parsed, in order of
## architecture. Found by listing rather than named, so a fourth machine's
## ledger is on the page the day it is recorded.
pub fn read_ledgers() -> List[Ledger] !Fs = {
  let dir = "scripts/tile-gpu-diff"
  var out: List[Ledger] = []
  for f in must_list(dir) {
    if str.starts_with(f, "ledger") && str.ends_with(f, ".txt") {
      let rel = "scripts/tile-gpu-diff/${f}"
      match last_entry(must_read("${dir}/${f}")) {
        Some(l) ->
          match parse_ledger_line(rel, l) {
            Ok(x) -> {
              out = out ++ [x]
            }
            Err(e) -> panic(e)
          }
        None -> panic("${rel}: no record line")
      }
    }
  }
  # by architecture, smallest first: a selection over a handful of lines
  var left = out
  var sorted: List[Ledger] = []
  while len(left) > 0 {
    var best = 0
    var i = 0
    for x in left {
      if arch_number(x) < arch_number(left[best]) {
        best = i
      }
      i = i + 1
    }
    sorted = sorted ++ [left[best]]
    left = list.take(left, best) ++ list.drop(left, best + 1)
  }
  sorted
}

# ---- the mutants ----

## One mutant and the gate that is shown catching it: 0 the text and bytes,
## 1 the assembler, 2 the device.
##
## Which gate a mutant belongs to is read from the harness that runs it, by
## a rule that can be checked against the files rather than by a list:
##
##   - scripts/tile-golden/run.sh lists its mutants (`mutants=(`), each run in
##     an `if run_item <name>; then` block. A block that goes through
##     `writer_mutant_checks` or hands the mutant's bytecode to `tileiras`
##     (`if [ -n "$tileiras" ]`) is proving the assembler's net: gate 1. The
##     rest are red in the text or at trace time: gate 0. (A gate-1 mutant's
##     bytes also differ from the golden; it is drawn at the gate it was
##     written to prove, which is what "each gate has to turn its own mutants
##     red" means.)
##   - scripts/tile-gpu-diff/run.sh builds its mutants in many shapes and
##     lists none, so its mutants are the ones the coverage tables cite as
##     evidence (`mutant:<name>`) that are not tile-golden's and that its
##     run.sh names as a whole word: gate 2. A device mutant no row cites is
##     not drawn; a cited one neither harness names is not drawn either, and
##     the test below holds that set empty.
pub type Mutant = { name: String, gate: Int }

## tile-golden's mutants, in its run order.
pub fn golden_mutants(run_sh: String) -> List[String] = {
  var out: List[String] = []
  var on = false
  for l in str.split(run_sh, "\n") {
    if l == "mutants=(" {
      on = true
    } else if on && l == ")" {
      on = false
    } else if on {
      out = out ++ [str.trim(l)]
    }
  }
  out
}

## The gate of one tile-golden mutant, from its block, or why it has none.
pub fn golden_gate(run_sh: String, name: String) -> Result[Int, String] =
  match str.split_once(run_sh, "\nif run_item ${name}; then\n") {
    None -> Err("scripts/tile-golden/run.sh lists `${name}` and runs no block for it")
    Some((_a, after)) -> {
      let block =
        match str.split_once(after, "\nfi\n") {
          Some((b, _c)) -> b
          None -> after
        }
      if str.contains(block, "writer_mutant_checks ") || str.contains(block, "if [ -n \"\$tileiras\" ]") {
        Ok(1)
      } else {
        Ok(0)
      }
    }
  }

fn is_name_cp(c: Char) -> Bool = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-'

## Whether `text` names `word` as a whole word (not inside a longer
## hyphenated name).
pub fn names_word(text: String, word: String) -> Bool = {
  let parts = str.split(text, word)
  var found = false
  var k = 0
  while not found && k + 1 < len(parts) {
    let before = parts[k]
    let after = parts[k + 1]
    let b = code_points(before)
    let a = code_points(after)
    let left = len(b) == 0 || not is_name_cp(b[len(b) - 1])
    let right = len(a) == 0 || not is_name_cp(a[0])
    if left && right {
      found = true
    }
    k = k + 1
  }
  found
}

## Every mutant the page draws, gate by gate in harness order, and the
## cited mutants neither harness names (which the page does not draw).
pub fn place_mutants(golden_run: String, device_run: String, rows: List[CovRow]) -> (List[Mutant], List[String]) = {
  let golden = golden_mutants(golden_run)
  var out: List[Mutant] = []
  for n in golden {
    match golden_gate(golden_run, n) {
      Ok(g) -> {
        out = out ++ [Mutant { name: n, gate: g }]
      }
      Err(e) -> panic(e)
    }
  }
  var cited: List[String] = []
  for r in rows {
    for e in r.evidence {
      match str.strip_prefix(e, "mutant:") {
        Some(m) -> {
          if not list.contains(cited, m) {
            cited = cited ++ [m]
          }
        }
        None -> ()
      }
    }
  }
  var lost: List[String] = []
  for m in cited {
    if not list.contains(golden, m) {
      if names_word(device_run, m) {
        out = out ++ [Mutant { name: m, gate: 2 }]
      } else {
        lost = lost ++ [m]
      }
    }
  }
  let zero = filter(out, x => x.gate == 0)
  let one = filter(out, x => x.gate == 1)
  let two = filter(out, x => x.gate == 2)
  (zero ++ one ++ two, lost)
}

# ---- everything the page states ----

pub type Facts = {
  tables: List[Coverage],
  rows: List[CovRow],
  golden: Int,
  ledgers: List[Ledger],
  kernel: Cut,
  maps: List[(String, Result[KernelMap, String])],
  vadd: KernelMap,
  bytes: List[(String, Int)],
  mutants: List[Mutant],
}

## The kernel the page draws first, embedded, and where both halves live.
fn kernel_name() -> String = "vadd"

fn kernels_file() -> String = "scripts/tile-golden/kernels.dawn"

## Everything the page states, read from the tile gates' files in place.
## `vadd` has to line up: it is the kernel the page shows with no script, so
## a recording or a kernels.dawn it no longer lines up with stops the build.
pub fn load_facts() -> Facts !Fs = {
  let golden = len(golden_names())
  if golden == 0 {
    panic("scripts/tile-golden holds no .mlir golden")
  }
  let maps = load_maps()
  let vadd =
    match filter(maps, m => {
      let (nm, _r) = m
      nm == kernel_name()
    }) {
      [(_, Ok(m))] -> m
      [(_, Err(e))] -> panic("`${kernel_name()}` does not line up with its Tile IR: ${e}")
      _ -> panic("site/gpu-map/calls.txt does not record `${kernel_name()}` once")
    }
  var sizes: List[(String, Int)] = []
  for m in maps {
    let (nm, _r) = m
    let path = "scripts/tile-golden/${nm}.tilebc"
    match io.read_bytes(path) {
      Ok(b) -> {
        sizes = sizes ++ [(nm, bytes.len(b))]
      }
      Err(e) -> panic("cannot read ${path}: ${e}")
    }
  }
  let rows = read_rows()
  let (muts, _lost) = place_mutants(must_read("scripts/tile-golden/run.sh"), must_read("scripts/tile-gpu-diff/run.sh"), rows)
  Facts {
    tables: read_tables(),
    rows: rows,
    golden: golden,
    ledgers: read_ledgers(),
    kernel: cut_fn(must_read(kernels_file()), kernel_name()),
    maps: maps,
    vadd: vadd,
    bytes: sizes,
    mutants: muts,
  }
}

## Every golden kernel lined up with its Tile IR, or why not, in the order
## site/gpu-map/calls.txt records them (kernels.dawn's dispatch order).
pub fn load_maps() -> List[(String, Result[KernelMap, String])] !Fs = {
  let traced =
    match parse_calls(must_read("site/gpu-map/calls.txt")) {
      Ok(ts) -> ts
      Err(e) -> panic("site/gpu-map/calls.txt: ${e}")
    }
  let src = must_read(kernels_file())
  var golden: List[(String, String)] = []
  for t in traced {
    golden = golden ++ [(t.name, must_read("scripts/tile-golden/${t.name}.mlir"))]
  }
  let table = golden
  let pure = pure_fns(src) ++ pure_fns(must_read("packages/tileir/src/dev.dawn"))
  map_kernels(src, traced, nm => {
    let hits = filter(table, g => {
      let (k, _v) = g
      k == nm
    })
    let (_k, v) = hits[0]
    v
  }, pure)
}

## The kernels that line up, in dispatch order.
pub fn mapped(f: Facts) -> List[KernelMap] = {
  var out: List[KernelMap] = []
  for m in f.maps {
    let (_nm, r) = m
    match r {
      Ok(k) -> {
        out = out ++ [k]
      }
      Err(_e) -> ()
    }
  }
  out
}

## The coverage rows whose evidence names kernel `k` (`golden:k`,
## `device:k`, `device@sm100:k`), and the mutants those rows name.
pub fn cited_by(f: Facts, k: String) -> (List[CovRow], List[String]) = {
  let cites = (e: String) =>
    match str.split_once(e, ":") {
      Some((kind, who)) -> who == k && (kind == "golden" || str.starts_with(kind, "device"))
      None -> false
    }
  let rows = filter(f.rows, r => list.any(r.evidence, cites))
  var muts: List[String] = []
  for r in rows {
    for e in r.evidence {
      match str.strip_prefix(e, "mutant:") {
        Some(m) -> {
          if not list.contains(muts, m) {
            muts = muts ++ [m]
          }
        }
        None -> ()
      }
    }
  }
  (rows, muts)
}

fn bytes_of(f: Facts, k: String) -> Int = {
  var n = 0
  for b in f.bytes {
    let (nm, v) = b
    if nm == k {
      n = v
    }
  }
  n
}

# ---- markup ----

fn gh(path: String) -> String = "${repo_url()}/blob/main/${path}"

fn code_link(path: String) -> String = """<a href="${gh(path)}"><code>${escape_html(path)}</code></a>"""

## The two layers, each a row of steps. Every word on a step is code and
## reads the same in both languages; the row's name and its sentence are
## the page's.
fn layers(c: Copy, mu: fn(String) -> String) -> String = {
  let t = (k: String) => line(c, k, mu)
  let step = (s: String) => "<li><code>${escape_html(s)}</code></li>"
  let arrow = `<li class="gpu-arrow" aria-hidden="true">→</li>`
  let row = (cls: String, name: String, lib: String, eff: String, steps: List[String], text: String) =>
    """<section class="gpu-layer ${cls}">
<header><span class="gpu-layer-name">${name}</span>${code_link(lib)}<code class="gpu-eff">${eff}</code></header>
<ol class="gpu-steps">${join(steps, arrow)}</ol>
<p>${text}</p>
</section>"""
  let fork = `<li class="gpu-fork"><code>with_gpu_real</code><code>with_gpu_fake</code></li>`
  let host = row("host", t("layer-host"), "std/gpu.dawn", "!Gpu", [step("main"), step("launch(\"vadd\")"), fork],
    t("layer-host-body"))
  let device = row("device", t("layer-device"), "packages/tileir", "!Dev",
    [step("vadd"), step("record"), step("Tile IR"), step("tileiras"), step("cubin")], t("layer-device-body"))
  `<div class="gpu-layers">` ++ "\n" ++ host ++ "\n" ++ device ++ "\n</div>"
}

# ---- the line map ----

## The six colours a map cycles through, so that two neighbouring rows never
## share one. They tell rows apart and mean nothing else.
fn hue_of(k: Int) -> String = "g${k % 6}"

## One line of either side: its number in its own file, then its text
## (already markup).
fn map_line(n: Int, html: String) -> String = """<span class="gm-l"><i>${n}</i>${html}</span>"""

## The source lines of `m`, highlighted one by one: a row is a run of whole
## lines, and the script redraws a fetched kernel from the same pieces.
pub fn highlighted(m: KernelMap) -> List[String] = map(m.src, l => highlight_dawn(l))

## The Tile IR lines a row owns, as line numbers in order.
pub fn row_lines(r: Row) -> List[Int] = {
  var out: List[Int] = []
  for g in r.ir {
    let (a, b) = g
    out = out ++ range(a, b)
  }
  out
}

## One row of the map: its Dawn lines, the calls on them, and the Tile IR
## lines they recorded. Pointing at either half lights the row (style.css);
## `aria-describedby` ties the Dawn half to the Tile IR it wrote.
fn map_row(m: KernelMap, hl: List[String], k: Int, r: Row) -> String = {
  let d = map(range(r.src_from, r.src_to), i => map_line(m.first + i, hl[i]))
  let t = map(row_lines(r), n => map_line(n, escape_html(m.ir[n - 1])))
  let calls =
    if len(r.calls) == 0 {
      ""
    } else {
      """<span class="gm-calls">""" ++ join(map(r.calls, x => "<code>${escape_html(x)}</code>"), "") ++ "</span>"
    }
  """<li class="gm-row ${hue_of(k)}" tabindex="0" data-ops="${r.ops}" aria-describedby="gm-t${k}">"""
    ++ """<div class="gm-d"><pre><code>${join(d, "\n")}</code></pre>${calls}</div>"""
    ++ """<div class="gm-t" id="gm-t${k}"><pre><code>${join(t, "\n")}</code></pre></div></li>"""
}

## The rows of a map as the `<ol>` the page carries and the script redraws.
fn map_rows(m: KernelMap) -> String = {
  let hl = highlighted(m)
  var out: List[String] = []
  var k = 0
  for r in m.rows {
    out = out ++ [map_row(m, hl, k, r)]
    k = k + 1
  }
  join(out, "\n")
}

## What the page says about a kernel beside its map, as numbers and names:
## its calls, the operations they recorded, its Tile IR lines, its bytecode's
## size, the coverage rows that cite it and the mutants those rows name.
pub type KernelFacts = { calls: Int, ops: Int, lines: Int, bytes: Int, rows: List[String], mutants: List[String] }

pub fn kernel_facts(f: Facts, m: KernelMap) -> KernelFacts = {
  let (rows, muts) = cited_by(f, m.name)
  KernelFacts {
    calls: m.calls,
    ops: m.ops,
    lines: len(m.ir),
    bytes: bytes_of(f, m.name),
    rows: map(rows, r => r.name),
    mutants: muts,
  }
}

## A kernel's map with its facts, as the file the picker fetches.
pub fn kernel_json(f: Facts, m: KernelMap) -> String = {
  let kf = kernel_facts(f, m)
  let names = (xs: List[String]) => "[" ++ join(map(xs, json_str), ",") ++ "]"
  map_json(m, highlighted(m), [
    "\"lines\":${kf.lines}",
    "\"bytes\":${kf.bytes}",
    "\"cites\":${names(kf.rows)}",
    "\"mutants\":${names(kf.mutants)}",
  ])
}

## The facts strip under the map. Every number has a `data-f` the script
## rewrites when another kernel is picked, and the two lists of names are
## redrawn the same way.
fn map_facts(c: Copy, mu: fn(String) -> String, kf: KernelFacts) -> String = {
  let t = (k: String) => line(c, k, mu)
  let fact = (key: String, n: Int, label: String) => """<li><b data-f="${key}">${n}</b> ${label}</li>"""
  let codes = (xs: List[String]) => join(map(xs, x => "<code>${escape_html(x)}</code>"), "")
  # a list with nothing in it says nothing; the script shows it again for a
  # kernel that has some
  let none = (xs: List[String]) => if len(xs) == 0 { " hidden" } else { "" }
  """<ul class="gm-facts">"""
    ++ fact("calls", kf.calls, t("fact-calls"))
    ++ """<li class="gm-arrow" aria-hidden="true">→</li>""" ++ fact("ops", kf.ops, t("fact-ops"))
    ++ """<li class="gm-arrow" aria-hidden="true">→</li>""" ++ fact("lines", kf.lines, t("fact-lines"))
    ++ fact("bytes", kf.bytes, t("fact-bytes")) ++ "</ul>\n"
    ++ """<p class="gm-names"${none(kf.rows)}><b data-f="rows">${len(kf.rows)}</b> ${t("fact-rows")} <span data-f="cites">${codes(kf.rows)}</span></p>\n"""
    ++ """<p class="gm-names"${none(kf.mutants)}><b data-f="mutantn">${len(kf.mutants)}</b> ${t("fact-mutants")} <span data-f="mutants">${codes(kf.mutants)}</span></p>"""
}

## How many kernels line up, in the copy's own sentence.
fn mapped_line(c: Copy, mu: fn(String) -> String, f: Facts) -> String =
  str.replace(str.replace(line(c, "kernel-mapped", mu), "{n}", "${len(mapped(f))}"), "{total}", "${f.golden}")

## The kernel section's figure: a bar (the picker, the count of kernels that
## line up, the replay button and its counter), the two columns' heads, the
## rows, and the facts. `root` is the page's distance from the site root,
## for the directory the picker fetches from. The picker and the button are
## `hidden` until the script is there to work them; with no script the rows
## and the facts are the whole of it, and they are complete.
fn map_figure(c: Copy, mu: fn(String) -> String, f: Facts, root: String) -> String = {
  let m = f.vadd
  let p = (k: String) => escape_html(plain(c, k))
  let opts = join(map(mapped(f), k => {
    let sel = if k.name == m.name { " selected" } else { "" }
    """<option value="${escape_html(k.name)}"${sel}>${escape_html(k.name)}</option>"""
  }), "")
  let last = m.first + len(m.src) - 1
  """<figure class="gpu-map" data-map-base="${root}/gpu/k/">
<div class="gm-bar">
<label class="gm-pick" hidden><span>${p("kernel-pick")}</span><select>${opts}</select></label>
<span class="gm-mapped">${mapped_line(c, mu, f)}</span>
<span class="gm-count" aria-live="polite"><b data-f="count">${m.ops}</b> ${p("kernel-ops")}</span>
<button type="button" class="gm-replay" hidden>${p("kernel-replay")}</button>
</div>
<div class="gm-grid">
<div class="gm-head" aria-hidden="true"><span>${p("kernel-left")} · <code data-f="src">kernels.dawn:${m.first}–${last}</code></span><span>${p("kernel-right")} · <code data-f="ir">${escape_html(m.name)}.mlir</code></span></div>
<ol class="gm-rows">
${map_rows(m)}
</ol>
</div>
${map_facts(c, mu, kernel_facts(f, m))}
</figure>"""
}

## What a table's figure says under its count: every status other than
## `implemented` that has rows, as `<n> <status>`.
fn rest_of(cov: Coverage) -> String =
  join(map(filter(statuses(), s => s != "implemented" && count_of(cov, s) > 0), s =>
      "${count_of(cov, s)} <code>${s}</code>"), " · ")

pub fn table_named(f: Facts, name: String) -> Coverage = {
  let hits = filter(f.tables, x => x.name == name)
  if len(hits) != 1 {
    panic("no coverage table called ${name}")
  }
  hits[0]
}

## A share as a CSS percentage with one decimal, `94.2%`.
fn percent(n: Int, total: Int) -> String = {
  let p = if total == 0 { 0 } else { n * 1000 / total }
  "${p / 10}.${p % 10}%"
}

## The rows of a table that are not implemented, as the list a card shows
## when it is pointed at: the name, its status and knife, and its note.
fn misses(f: Facts, table: String) -> String = {
  let rows = filter(f.rows, r => r.table == table && r.status != "implemented")
  if len(rows) == 0 {
    ""
  } else {
    let item = (r: CovRow) => {
      let tag = if r.knife == "" { r.status } else { "${r.status} · ${r.knife}" }
      let note = if r.note == "" { "" } else { " <span>${escape_html(r.note)}</span>" }
      "<li><code>${escape_html(r.name)}</code> <small>${escape_html(tag)}</small>${note}</li>"
    }
    """<ul class="gpu-fig-miss">""" ++ join(map(rows, item), "") ++ "</ul>"
  }
}

## One card: the count (which gpu.js counts up to, from `data-count`), a bar
## filled to the implemented share, the caption, the other statuses, the
## table it is read from, and the rows that are not implemented.
fn figure(n: Int, total: Int, caption: String, rest: String, file: String, href: String, miss: String) -> String = {
  let of = if total == n { "" } else { "<small>/${total}</small>" }
  let focus = if miss == "" { "" } else { ` tabindex="0"` }
  """<div class="gpu-fig" data-count="${n}"${focus}><strong><b>${n}</b>${of}</strong>"""
    ++ """<span class="gpu-fig-bar" style="--p:${percent(n, total)}" aria-hidden="true"><i></i></span>"""
    ++ """<span>${caption}</span><span class="gpu-fig-rest">${rest}</span>"""
    ++ """<a href="${href}"><code>${file}</code></a>${miss}</div>"""
}

fn table_figure(f: Facts, name: String, caption: String, file: String) -> String = {
  let cov = table_named(f, name)
  figure(count_of(cov, "implemented"), cov.total, caption, rest_of(cov), file,
    gh("scripts/tileir-features/" ++ file), misses(f, name))
}

fn figures(c: Copy, mu: fn(String) -> String, f: Facts) -> String = {
  let t = (k: String) => line(c, k, mu)
  """<div class="gpu-figs">
${table_figure(f, "features", t("fig-opcodes"), "features.txt")}
${table_figure(f, "types", t("fig-types"), "types.txt")}
${table_figure(f, "attrs", t("fig-attrs"), "attrs.txt")}
${figure(f.golden, f.golden, t("fig-golden"), "", "tile-golden/", gh("scripts/tile-golden"), "")}
</div>"""
}

## The mutants caught, as a pipeline: the kernel on the left, the three
## gates as nets, every mutant a dot sitting in the net that catches it
## (`title` names it), and each net's count. gpu.js flies the dots in from
## the left once; without it, or with reduced motion, they are where they
## stop.
fn trap(c: Copy, mu: fn(String) -> String, f: Facts) -> String = {
  let t = (k: String) => line(c, k, mu)
  var k = 0
  var zones: List[String] = []
  for g in [0, 1, 2] {
    let ms = filter(f.mutants, m => m.gate == g)
    var dots: List[String] = []
    for m in ms {
      dots = dots ++ ["""<i title="${escape_html(m.name)}" style="--i:${k}"></i>"""]
      k = k + 1
    }
    zones = zones ++ ["""<div class="gt-zone gt-z${g}"><span class="gt-net" aria-hidden="true"></span>"""
        ++ """<span class="gpu-gate-n">${g}</span><span class="gt-name">${t("gate-${g}-title")}</span>"""
        ++ """<span class="gt-dots" aria-hidden="true">${join(dots, "")}</span>"""
        ++ """<span class="gt-count"><b>${len(ms)}</b> ${t("gates-caught")}</span></div>"""]
  }
  """<figure class="gpu-trap"><div class="gt-src" aria-hidden="true"><code>kernel</code></div>"""
    ++ join(zones, "") ++ """<div class="gt-dev" aria-hidden="true"><code>cubin</code></div></figure>"""
}

fn gates(c: Copy, mu: fn(String) -> String) -> String = {
  let t = (k: String) => line(c, k, mu)
  let gate = (n: Int, script: String) =>
    """<li><span class="gpu-gate-n">${n}</span><h3>${t("gate-${n}-title")}</h3><p>${t("gate-${n}-body")}</p>${code_link(script)}</li>"""
  """<ol class="gpu-gates">
${gate(0, "scripts/tile-golden/run.sh")}
${gate(1, "scripts/tile-golden/run.sh")}
${gate(2, "scripts/tile-gpu-diff/run.sh")}
</ol>"""
}

## The kernels whose Tile IR drifts behind the page's head: a few shapes
## (a vector add, a scan, a softmax, a layer norm, a matrix product), so
## that the lines are not one kernel's repeated.
fn hero_kernels() -> List[String] = ["vadd", "prefix_sum", "softmax", "layer_norm", "matmul"]

## Real Tile IR lines for the head's background: up to twelve operation
## lines of each [hero_kernels] golden, unindented, read when the site is
## built.
pub fn hero_lines() -> List[String] !Fs = {
  var out: List[String] = []
  for k in hero_kernels() {
    let ops = filter(map(str.split(must_read("scripts/tile-golden/${k}.mlir"), "\n"), l => str.trim(l)),
      l => str.contains(l, " = "))
    out = out ++ list.take(ops, 12)
  }
  out
}

## The head's background: those lines, twice, so that a scroll through one
## copy ends where the next begins (style.css scrolls it, and holds it still
## under reduced motion). Decoration only: `aria-hidden`.
fn hero_ir(lines: List[String]) -> String = {
  let text = escape_html(join(lines, "\n"))
  """<div class="gpu-hero-ir" aria-hidden="true"><pre>${text}\n${text}</pre></div>"""
}

fn ledger_table(c: Copy, mu: fn(String) -> String, f: Facts) -> String = {
  let p = (k: String) => escape_html(plain(c, k))
  let row = (l: Ledger) =>
    """<tr><td class="key"><a href="${gh(l.file)}"><code>${escape_html(l.arch)}</code></a></td>"""
    ++ """<td class="date">${escape_html(l.date)}</td><td>${escape_html(l.driver)}</td>"""
    ++ """<td>${escape_html(l.tileiras)}</td><td><code>${escape_html(l.result)}</code></td>"""
    ++ "<td>${l.exact}</td><td>${l.tolerance}</td><td><code>${escape_html(l.commit)}</code></td></tr>"
  """<div class="table-wrap gpu-ledgers"><table>
<thead><tr><th>${p("th-gpu")}</th><th>${p("th-date")}</th><th>${p("th-driver")}</th><th>${p("th-tileiras")}</th><th>${p("th-result")}</th><th>${p("th-exact")}</th><th>${p("th-tolerance")}</th><th>${p("th-tree")}</th></tr></thead>
<tbody>
${join(map(f.ledgers, row), "\n")}
</tbody>
</table></div>
<p class="gpu-note">${line(c, "ledger-tiers", mu)}</p>"""
}

## The page's sections, in order: each heading's id and the copy key its
## `<key>-title` and `<key>-body` are under. The page writes its headings from
## this list and gen/search indexes them from it, so a section renamed or
## moved here moves in both, and a fragment the search names is one the page
## carries.
pub fn prose_sections() -> List[(String, String)] =
  [("layers", "layers"), ("kernel", "kernel"), ("coverage", "coverage"), ("gates", "gates"),
    ("ledgers", "ledger")]

## The copy file of one language.
pub fn copy_file(lang: Lang) -> String =
  match lang {
    En -> "site/pages/gpu.md"
    Zh -> "site/pages/gpu.zh.md"
  }

fn section_key(id: String) -> String = {
  let hits = filter(prose_sections(), e => {
    let (i, _) = e
    i == id
  })
  match get(hits, 0) {
    Some((_, k)) -> k
    None -> panic("no section `${id}` on the cuTile page")
  }
}

## A column of prose: a section heading and its body from the copy.
fn prose(c: Copy, mu: fn(String) -> String, id: String) -> String = {
  let key = section_key(id)
  """<div class="col prose"><h2 id="${id}">${line(c, "${key}-title", mu)}</h2>""" ++ "\n"
    ++ body(c, "${key}-body", mu) ++ "</div>"
}

## The page as markup, in one language, without writing it: what the tests
## read, so that they check the document a browser gets.
##
## Paired: `pair` is "gpu.html", so each language's header offers the other
## and carries both hreflang alternates. The trail is the nav's own GPU item,
## as on the other pages the nav lists, so the two cannot name it apart.
fn gpu_page(a: Assets, js: String, lang: Lang, f: Facts, docs: List[String]) -> String !Fs = {
  let root =
    match lang {
      En -> "."
      Zh -> ".."
    }
  let c = load_copy(copy_file(lang))
  let mu = (u: String) => map_doc_url(root, docs, u)
  let title = plain(c, "title")
  let head = PageHead {
    crumbs: [section_crumb(lang, root, "gpu", false)],
    title: line(c, "title", mu),
    lede: line(c, "lede", mu),
    meta: [chip("<code>!Dev</code> · Tile IR · <code>tileiras</code>"),
      chip("${f.golden} " ++ line(c, "chip-golden", mu)), chip("${len(f.ledgers)} " ++ line(c, "chip-gpus", mu))],
    extra: hero_ir(hero_lines()),
    cls: "col",
  }
  let main = `<main class="wrap page gpu-page">` ++ "\n"
    ++ prose(c, mu, "layers") ++ "\n" ++ layers(c, mu) ++ "\n"
    ++ prose(c, mu, "kernel") ++ "\n" ++ map_figure(c, mu, f, root) ++ "\n"
    ++ prose(c, mu, "coverage") ++ "\n" ++ figures(c, mu, f) ++ "\n"
    ++ prose(c, mu, "gates") ++ "\n" ++ trap(c, mu, f) ++ "\n" ++ gates(c, mu) ++ "\n"
    ++ prose(c, mu, "ledgers") ++ "\n" ++ ledger_table(c, mu, f) ++ "\n</main>"
  # deferred: everything it does waits for the document, and nothing on the
  # page needs it to be readable (the rows and the figures are complete
  # without it)
  let script = """<script src="${root}/assets/${js}" defer></script>"""
  shell_ext(a, lang, "gpu.html", title, root, "gpu", script, head, main)
}

## Write the page: English at the site root, Chinese under `/zh/`. The
## English run also writes what both pages share: the script, under a
## content-hashed name as every asset is (gen/pages.emit_asset), and one
## file per kernel that lines up, `gpu/k/<name>.json`, which the picker
## fetches only when a reader asks for that kernel.
pub fn gen_gpu(out: String, a: Assets, lang: Lang) -> Unit !Fs !io = {
  let f = load_facts()
  let js_text = bytes.utf8(str.trim(must_read("site/assets/gpu.js")) ++ "\n")
  let js = fingerprint("gpu.js", js_text)
  let dst =
    match lang {
      En -> {
        for name in [js, "gpu.js"] {
          match io.write_bytes("${out}/assets/${name}", js_text) {
            Ok(_) -> ()
            Err(e) -> panic("cannot write assets/${name}: ${e}")
          }
        }
        match io.mkdirs("${out}/gpu/k") {
          Ok(_) -> ()
          Err(e) -> panic("cannot make ${out}/gpu/k: ${e}")
        }
        for m in mapped(f) {
          match io.write_file("${out}/gpu/k/${m.name}.json", kernel_json(f, m) ++ "\n") {
            Ok(_) -> ()
            Err(e) -> panic("cannot write gpu/k/${m.name}.json: ${e}")
          }
        }
        println("  wrote ${out}/gpu/k/*.json: ${len(mapped(f))} of ${f.golden} kernels line up")
        "${out}/gpu.html"
      }
      Zh -> "${out}/zh/gpu.html"
    }
  write_page(dst, gpu_page(a, js, lang, f, doc_files()))
}

# ---- tests ----

## The gate that owns the tables, run, and its counts compared with these.
## Hard-coding today's numbers would test nothing the next knife does not
## change; running check.py tests that the two readings of "what a row's
## status is" agree, which is the claim the page makes.
test "the coverage counts are the ones check.py prints" {
  with_fs_real(() => {
    let dir =
      match io.temp_dir("", "dawn-site-gpu") {
        Ok(d) -> d
        Err(e) -> panic("no temporary directory: ${e.message}")
      }
    let out_path = "${dir}/out.txt"
    let err_path = "${dir}/err.txt"
    let status = with_proc_real(() => io.run(["python3", "scripts/tileir-features/check.py"], out_path, err_path))
    let printed = must_read(out_path)
    let complaint = must_read(err_path)
    for gone in [out_path, err_path, dir] {
      match io.delete(gone) {
        Ok(_) -> ()
        Err(e) -> panic("cannot delete ${gone}: ${e.message}")
      }
    }
    match status {
      Ok(code) -> {
        assert code == 0
      }
      Err(e) -> panic("python3 did not start: ${e.message}")
    }
    assert complaint == ""
    let theirs = parse_check_output(printed)
    let ours = read_tables()
    assert len(theirs) == 3
    assert map(theirs, x => (x.name, x.total, x.counts)) == map(ours, x => (x.name, x.total, x.counts))
    for x in ours {
      assert x.total > 0
      assert count_of(x, "implemented") > 0
    }
  })
}

test "check.py's summary line reads as counts" {
  let out = "PASS  tileir features: 105 opcode(s): implemented=99 unimplemented=3 structural=3; layer0=3\n"
    ++ "PASS  tileir types: 24 type tag(s): implemented=23 unimplemented=1; layer0=1\n"
  let cs = parse_check_output(out)
  assert len(cs) == 2
  assert cs[0].name == "features"
  assert cs[0].total == 105
  assert count_of(cs[0], "structural") == 3
  assert count_of(cs[0], "deferred") == 0
  assert cs[1].name == "types"
  assert cs[1].total == 24
  assert count_of(cs[1], "unimplemented") == 1
}

## The format negative control for the tables: one field gone from one row,
## or a status nobody declared, is not a row to skip.
test "a coverage row of the wrong width or status is an error" {
  let good = "# header\n\nadd | 0x01 | 13.1 | implemented | 1 | 2 | golden:vadd | note\n"
  match parse_table("t", good) {
    Ok(c) -> {
      assert c.total == 1
      assert count_of(c, "implemented") == 1
    }
    Err(_) -> { assert false }
  }
  match parse_table("t", "add | 0x01 | 13.1 | implemented | 1 | golden:vadd | note\n") {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "7 fields, not 8") }
  }
  match parse_table("t", "add | 0x01 | 13.1 | done | 1 | 2 | golden:vadd | note\n") {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "status \"done\"") }
  }
}

test "every ledger's last line parses into every field" {
  with_fs_real(() => {
    let ls = read_ledgers()
    assert len(ls) >= 1
    assert ls[0].file == "scripts/tile-gpu-diff/ledger.txt" || arch_number(ls[0]) <= arch_number(ls[len(ls) - 1])
    for l in ls {
      assert str.len(l.commit) == 12
      assert str.len(l.date) == 10
      assert l.driver != ""
      assert l.tileiras != ""
      assert str.starts_with(l.arch, "sm_")
      assert l.result != ""
      assert l.exact + l.tolerance > 0
    }
    # in order of architecture
    var prev = 0
    for l in ls {
      assert arch_number(l) >= prev
      prev = arch_number(l)
    }
  })
}

## The format negative control for the ledgers: each of the six columns
## taken out in turn, and two moved, and every one of them is refused.
test "a ledger line with a column missing or moved is an error" {
  let cols = ["83b71036b16a", "2026-10-02", "616.56", "13.4.92", "sm_86", "pass"]
  let note = " # inputs=a9eccc0dc802 exact=7 tolerance=7 2d:exact=2 tolerance=6 twin=same exact=7"
  match parse_ledger_line("l", join(cols, " ") ++ note) {
    Ok(l) -> {
      assert l.arch == "sm_86"
      assert l.result == "pass"
      assert l.exact == 9
      assert l.tolerance == 13
    }
    Err(_) -> { assert false }
  }
  for i in range(0, 6) {
    let short = list.take(cols, i) ++ list.drop(cols, i + 1)
    match parse_ledger_line("l", join(short, " ") ++ note) {
      Ok(_) -> { assert false }
      Err(e) -> { assert str.contains(e, "5 columns before its note, not 6") }
    }
  }
  let swapped = ["2026-10-02", "83b71036b16a", "616.56", "13.4.92", "sm_86", "pass"]
  match parse_ledger_line("l", join(swapped, " ") ++ note) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  let arch_moved = ["83b71036b16a", "2026-10-02", "616.56", "sm_86", "13.4.92", "pass"]
  match parse_ledger_line("l", join(arch_moved, " ") ++ note) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
}

test "the kernel beside its golden is the whole function, from the lines it names" {
  with_fs_real(() => {
    let src = must_read(kernels_file())
    let k = cut_fn(src, kernel_name())
    assert k.text != ""
    assert str.starts_with(k.text, "fn vadd(")
    assert str.contains(k.text, "!Dev")
    assert str.ends_with(k.text, "\n}")
    assert not str.contains(k.text, "vadd_f32")
    let lines = str.split(src, "\n")
    assert join(list.slice(lines, k.first - 1, k.last), "\n") == k.text
    let mlir = must_read("scripts/tile-golden/vadd.mlir")
    assert str.contains(mlir, "entry @vadd(")
  })
}

## The golden count against an independent one: kernels.dawn dispatches on
## each kernel's name (`  "<name>" ->`), and the set of those names is the set
## of `.mlir` files. A count that came from a listing of the wrong directory,
## or a golden left behind by a kernel that was renamed, is red here.
test "the golden kernels are the ones kernels.dawn dispatches" {
  with_fs_real(() => {
    let names = golden_names()
    assert len(names) > 0
    var arms: List[String] = []
    for l in str.split(must_read(kernels_file()), "\n") {
      match str.strip_prefix(l, "  \"") {
        Some(rest) ->
          match str.strip_suffix(rest, "\" ->") {
            Some(name) -> {
              if not str.contains(name, "\"") {
                arms = arms ++ [name]
              }
            }
            None -> ()
          }
        None -> ()
      }
    }
    assert sort(arms) == sort(names)
    assert len(names) == len(filter(must_list("scripts/tile-golden"), x => str.ends_with(x, ".tilebc")))
  })
}

test "the page states what the files say, and links nowhere it should not" {
  with_fs_real(() => {
    let f = load_facts()
    let p = gpu_page(plain_assets(), "gpu.js", En, f, [])
    assert str.contains(p, "<title>Dawn's cuTile backend</title>")
    assert str.contains(p, "<h1>Dawn's cuTile backend</h1>")
    let feats = table_named(f, "features")
    assert str.contains(p, "<strong><b>${count_of(feats, "implemented")}</b><small>/${feats.total}</small></strong>")
    assert str.contains(p, "<strong><b>${f.golden}</b></strong>")
    for l in f.ledgers {
      assert str.contains(p, "<code>${l.commit}</code>")
    }
    assert str.contains(p, `<span class="k">fn</span> <span class="f">vadd</span>`)
    assert str.contains(p, "entry @vadd(")
    # paired: the header switches to the twin and both alternates are there
    assert str.contains(p, `class="lang"`)
    assert str.contains(p, `hreflang="zh-CN"`)
    assert str.contains(p, `hreflang="en"`)
  })
}

## The translation is the same page: the same numbers and kernel, its own
## words, under /zh/, with the switch pointing back at the English one.
test "the Chinese page is the same page in its own words" {
  with_fs_real(() => {
    let f = load_facts()
    let p = gpu_page(plain_assets(), "gpu.js", Zh, f, [])
    assert str.contains(p, `<html lang="zh-CN">`)
    assert str.contains(p, "<h1>Dawn 的 cuTile 后端</h1>")
    assert not str.contains(p, "Dawn's cuTile backend")
    let feats = table_named(f, "features")
    assert str.contains(p, "<strong><b>${count_of(feats, "implemented")}</b><small>/${feats.total}</small></strong>")
    assert str.contains(p, `<span class="k">fn</span> <span class="f">vadd</span>`)
    assert str.contains(p, `class="lang"`)
    assert str.contains(p, `href="../gpu.html"`)
    # the assets are one level up
    assert not str.contains(p, `href="./assets/`)
    # every section gen/search sends a reader to is a heading here, in both
    for e in prose_sections() {
      let (id, _) = e
      assert str.contains(p, """<h2 id="${id}">""")
      assert str.contains(gpu_page(plain_assets(), "gpu.js", En, f, []), """<h2 id="${id}">""")
    }
  })
}

## The same page with one section gone from either copy file is not a page.
## Pinned here, as home's is, because a generator that read the copy through
## a lenient lookup would pass every assertion above.
test "every section the page reads is in both copy files" {
  with_fs_real(() => {
    let en = load_copy(copy_file(En))
    let zh = load_copy(copy_file(Zh))
    let keys = (c: Copy) => map(c.sections, e => {
      let (k, _) = e
      k
    })
    assert keys(en) == keys(zh)
    for e in prose_sections() {
      let (_, k) = e
      assert list.contains(keys(en), "${k}-title")
      assert list.contains(keys(en), "${k}-body")
    }
  })
}

## The nav's GPU item is lit on this page and on no other item, in both
## languages, and the trail is that item's label.
test "the nav marks GPU as the page you are on" {
  with_fs_real(() => {
    let f = load_facts()
    let en = gpu_page(plain_assets(), "gpu.js", En, f, [])
    let zh = gpu_page(plain_assets(), "gpu.js", Zh, f, [])
    assert str.contains(en, `<a class="active" aria-current="page" href="./gpu.html">GPU</a>`)
    assert str.contains(zh, `<a class="active" aria-current="page" href="../zh/gpu.html">GPU</a>`)
    assert len(str.split(en, `class="active"`)) == 2
    assert len(str.split(zh, `class="active"`)) == 2
  })
}

## vadd, the kernel the page carries with no script, against the files it
## comes from: its rows' source is kernels.dawn's function as the page's
## other cut reads it, its Tile IR is the golden's, every golden line is in
## exactly one row, and every row of the body has Tile IR of its own.
test "vadd lines up with its golden, row by row" {
  with_fs_real(() => {
    let f = load_facts()
    let m = f.vadd
    let cut = cut_fn(must_read(kernels_file()), "vadd")
    assert join(m.src, "\n") == cut.text
    assert m.first == cut.first
    assert m.ir == str.split(str.trim_end(must_read("scripts/tile-golden/vadd.mlir")), "\n")
    var owned: List[Int] = []
    for r in m.rows {
      owned = owned ++ row_lines(r)
    }
    assert owned == range(1, len(m.ir) + 1)
    for r in m.rows {
      assert len(row_lines(r)) > 0
      assert r.src_to > r.src_from
    }
    var calls: List[String] = []
    for r in m.rows {
      calls = calls ++ r.calls
    }
    assert calls == ["block_id", "tile_at", "load", "load", "addf", "store"]
    assert m.calls == len(calls)
  })
}

## How many kernels line up is counted, not stated, and the page says the
## count it was given. A refused kernel carries its reason, which is what
## the report of the next knife lists.
test "the page states how many kernels line up, and every refusal says why" {
  with_fs_real(() => {
    let f = load_facts()
    let n = len(mapped(f))
    assert len(f.maps) == f.golden
    assert n > 0
    for m in f.maps {
      let (_nm, r) = m
      match r {
        Ok(_) -> ()
        Err(e) -> { assert e != "" }
      }
    }
    let p = gpu_page(plain_assets(), "gpu.js", En, f, [])
    assert str.contains(p, "${n} of ${f.golden} golden kernels map line by line")
    assert len(str.split(p, "<option ")) == n + 1
    assert str.contains(p, `<option value="vadd" selected>vadd</option>`)
    let z = gpu_page(plain_assets(), "gpu.js", Zh, f, [])
    assert str.contains(z, "${f.golden} 个 golden kernel 中有 ${n} 个逐行对上")
  })
}

## The facts strip under the map holds the numbers the map and the files
## give, each where the script rewrites it.
test "the facts under the map are the map's and the files' numbers" {
  with_fs_real(() => {
    let f = load_facts()
    let m = f.vadd
    let kf = kernel_facts(f, m)
    let p = gpu_page(plain_assets(), "gpu.js", En, f, [])
    let size =
      match io.read_bytes("scripts/tile-golden/vadd.tilebc") {
        Ok(b) -> bytes.len(b)
        Err(e) -> panic("cannot read vadd.tilebc: ${e}")
      }
    assert kf.bytes == size
    assert kf.lines == len(m.ir)
    for e in [("calls", m.calls), ("ops", m.ops), ("lines", len(m.ir)), ("bytes", size), ("count", m.ops)] {
      let (key, v) = e
      assert str.contains(p, """<b data-f="${key}">${v}</b>""")
    }
    # every row it cites names vadd in its evidence, and every one that does is cited
    let (rows, muts) = cited_by(f, "vadd")
    assert len(rows) > 0
    assert len(filter(f.rows, r => list.contains(r.evidence, "golden:vadd"))) <= len(rows)
    for r in rows {
      assert str.contains(p, "<code>${escape_html(r.name)}</code>")
    }
    for x in muts {
      assert str.contains(p, "<code>${x}</code>")
    }
    # the rows' operations add up to the recording's
    var ops = 0
    for r in m.rows {
      ops = ops + r.ops
    }
    assert ops == m.ops
  })
}

## The file the picker fetches is JSON, and it holds what the page would
## draw for that kernel.
test "a kernel's file is JSON with its rows, its lines and its facts" {
  with_fs_real(() => {
    let f = load_facts()
    for m in [f.vadd] ++ list.take(mapped(f), 3) {
      match parse(kernel_json(f, m)) {
        Ok(JObj(entries)) -> {
          assert map.get(entries, "name") == Some(JStr(value: m.name))
          match map.get(entries, "rows") {
            Some(JArr(rows)) -> { assert len(rows) == len(m.rows) }
            _ -> { assert false }
          }
          match map.get(entries, "ir") {
            Some(JArr(ir)) -> { assert len(ir) == len(m.ir) }
            _ -> { assert false }
          }
          assert map.get(entries, "bytes") == Some(JInt(value: bytes_of(f, m.name)))
          assert map.get(entries, "ops") == Some(JInt(value: m.ops))
        }
        _ -> { assert false }
      }
    }
  })
}

## Every mutant is drawn once, at a gate read from its harness, and no
## mutant a coverage row cites goes undrawn.
test "every mutant is placed at the gate its harness proves" {
  with_fs_real(() => {
    let golden_run = must_read("scripts/tile-golden/run.sh")
    let (ms, lost) = place_mutants(golden_run, must_read("scripts/tile-gpu-diff/run.sh"), read_rows())
    assert lost == []
    let names = map(ms, m => m.name)
    assert len(names) == len(list.unique(names))
    let golden = golden_mutants(golden_run)
    assert len(golden) > 0
    assert len(filter(ms, m => m.gate < 2)) == len(golden)
    for g in [0, 1, 2] {
      assert len(filter(ms, m => m.gate == g)) > 0
    }
    let f = load_facts()
    let p = gpu_page(plain_assets(), "gpu.js", En, f, [])
    assert len(str.split(p, "<i title=")) == len(ms) + 1
  })
}

## The rule on a harness made up for it: a writer check or a tileiras block
## is gate 1, anything else gate 0, and a listed mutant with no block, or a
## device name that is only part of a longer one, is not placed.
test "the gate rule reads the block, and only the block" {
  let run_sh = "mutants=(\n  a-text\n  b-writer\n  c-asm\n)\n"
    ++ "if run_item a-text; then\n  mutant_run a-text vadd\nfi\n"
    ++ "if run_item b-writer; then\n  writer_mutant_checks b-writer vadd same-size x\nfi\n"
    ++ "if run_item c-asm; then\n  if [ -n \"\$tileiras\" ]; then\n    true\n  fi\nfi\n"
  assert golden_mutants(run_sh) == ["a-text", "b-writer", "c-asm"]
  assert golden_gate(run_sh, "a-text") == Ok(0)
  assert golden_gate(run_sh, "b-writer") == Ok(1)
  assert golden_gate(run_sh, "c-asm") == Ok(1)
  match golden_gate(run_sh, "d-none") {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "runs no block") }
  }
  assert names_word("x grid-zero y", "grid-zero")
  assert not names_word("x grid-zero-two y", "grid-zero")
  assert not names_word("x big-grid-zero y", "grid-zero")
}

## Each card counts up to the implemented rows and lists, on pointing, every
## row that is not implemented.
test "the coverage cards carry their counts, their bars and the rows not implemented" {
  with_fs_real(() => {
    let f = load_facts()
    let p = gpu_page(plain_assets(), "gpu.js", En, f, [])
    for t in f.tables {
      let n = count_of(t, "implemented")
      assert str.contains(p, """<div class="gpu-fig" data-count="${n}" tabindex="0"><strong><b>${n}</b><small>/${t.total}</small></strong>""")
      assert str.contains(p, "--p:${percent(n, t.total)}")
      for r in filter(f.rows, r => r.table == t.name && r.status != "implemented") {
        assert str.contains(p, "<li><code>${escape_html(r.name)}</code>")
      }
    }
    assert percent(99, 105) == "94.2%"
    assert percent(3, 3) == "100.0%"
  })
}

test "the head's background is real Tile IR from the goldens" {
  with_fs_real(() => {
    let ls = hero_lines()
    assert len(ls) > 20
    for l in ls {
      assert list.any(hero_kernels(), k => str.contains(must_read("scripts/tile-golden/${k}.mlir"), l))
    }
  })
}

# expect: parameters defaulting to `caller()`
pub effect Rec calls(enter = a, exit = b, body_enter = c, body_exit = d) {
  fn a(name: String, at: Option[Loc]) -> Unit
  fn b() -> Unit
  fn c() -> Unit
  fn d() -> Unit
}

pub fn twice(x: Int, a: Loc = caller(), b: Loc = caller()) -> Int !Rec = x

pub fn main() -> Unit = ()

# What `dawn doc` publishes of a module that uses all three levels: the `pub`
# items only. Every `pub(pkg)` twin below is left out, including the impl of
# a package-private trait.
pub(pkg) type Seam = { n: Int }

pub type Open = { k: Int }

pub(pkg) fn seam(n: Int) -> Seam = Seam { n: n }

pub fn api(n: Int) -> Int = seam(n).n

pub(pkg) const LIMIT: Int = 3

pub const MAX: Int = 4

pub(pkg) trait Walk[T] {
  fn walk(x: T) -> Int
}

pub trait Measure[T] {
  fn measure(x: T) -> Int
}

impl Walk[Open] {
  fn walk(x: Open) -> Int = x.k
}

impl Measure[Open] {
  fn measure(x: Open) -> Int = x.k
}

pub(pkg) effect Trace {
  fn trace(m: String) -> Unit
}

pub effect Ask {
  fn ask() -> Int
}

pub(pkg) alias Row = List[Seam]

pub alias Col = List[Open]

# dawn-play: the Dawn Playground runner. Receives source over HTTP, compiles and
# runs it inside a throwaway sandbox, streams back the output. The first real
# server written in Dawn (spec §9 interop dogfood, M6 warm-up) — and the first
# service on the `web` framework, which it doubles as the acceptance test for.
use std/io
use web/types.{Response, HttpError, raw}
use web/router.{route_get, route_post}
use web/server.{serve_app}
use web/middleware.{with_logging}
use play/routes.{Reply, JSON_CT, MAX_CONCURRENT, health, rpc, compile_rpc, view_of}
use play/exec.{compiler_id, native_ready, javap_id, sweep_work_root}
use play/gate.{new_gate}
use play/config.{port}
use play/serve.{serve_one}

# The framework's Response is the Reply with the runner's one content type.
fn wrap(r: Reply) -> Result[Response, HttpError] = Ok(raw(r.status, JSON_CT, r.body))

pub fn main() -> Unit !io =
  # `dawn run playground serve` is the process-per-request entry (play/serve.dawn):
  # no sweep, since the sweep would delete the work dirs of requests running now
  match args() {
    ["serve", ..] -> serve_one()
    _ -> serve_forever()
  }

fn serve_forever() -> Unit !io = {
  sweep_work_root()
  let gate = new_gate(MAX_CONCURRENT)
  let id = compiler_id()
  let javap = javap_id()
  let native = native_ready(id)
  if javap == "" {
    io.eprintln("dawn-play: javap is not available; POST /compile will answer 503 until it is installed (a JDK, not only a JRE)")
  }
  let view = view_of(id, native, javap)
  serve_app(port(), [
    route_get("/health", req => wrap(health(id))),
    route_post("/run", req => wrap(rpc(req.body, gate, false, native))),
    route_post("/check", req => wrap(rpc(req.body, gate, true, native))),
    route_post("/compile", req => wrap(compile_rpc(req.body, gate, view))),
  ], [with_logging])
}

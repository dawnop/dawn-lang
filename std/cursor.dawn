# std/cursor — positions in a String (spec §11).
#
# Short names, module-qualified at the call site: `use std/cursor`, then
# `cursor.next(s, c)`. The underlying operations are compiler intrinsics; these
# wrappers give them their public, qualified spelling.
#
# A position is opaque: `Cursor` is this module's own type, and only this
# module may see it as the Int it is. Arithmetic on one is a type error
# anywhere else, which is the point — only arithmetic can conjure a position
# that lands in the middle of a surrogate pair.
#
# It used to be a type the compiler minted: a `Ty` variant, a `Head`, an entry
# in the eq/hash scalar tables and an arm in seven files. Same guarantee, and
# now no mechanism of its own — `opaque type` (spec §2.7) is the mechanism.

## A position in a String: an index the language will not let you compute.
pub opaque type Cursor = Int

## The position before the first character.
pub fn start(s: String) -> Cursor = cursor_start(s)

## The position after the last character.
pub fn end(s: String) -> Cursor = cursor_end(s)

## Whether `c` is at the end of `s`.
pub fn done(s: String, c: Cursor) -> Bool = cursor_done(s, c)

## The code point at `c`, or -1 at the end.
pub fn char(s: String, c: Cursor) -> Int = cursor_char(s, c)

## The position one character forward (clamped to the end).
pub fn next(s: String, c: Cursor) -> Cursor = cursor_next(s, c)

## The position one character back (clamped to the start).
pub fn prev(s: String, c: Cursor) -> Cursor = cursor_prev(s, c)

## The text between two positions.
pub fn slice(s: String, from: Cursor, to: Cursor) -> String = cursor_slice(s, from, to)

# The three below used to be intrinsics too — `cursor_skip` and
# `index_of_from`, each with a hand-written implementation in the JVM emitter
# and another in the C runtime, and a third route in the comptime interpreter
# that reflected into the emitted JVM class. Search is not a representation
# question: it is a walk, and the walk is above. Writing it here leaves seven
# intrinsics under this module, which is the whole representation boundary
# (docs/native-backend-plan.md 14.12).

## The position just past `sub`, which is known to start at `c` — the one
## sanctioned "advance past a literal" that would otherwise be cursor arithmetic.
##
## Walks both strings together rather than counting `sub` first, so it needs no
## length and no arithmetic.
pub fn skip(s: String, c: Cursor, sub: String) -> Cursor = skip_go(s, c, sub, start(sub))

fn skip_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Cursor =
  if done(t, tc) || done(s, sc) {
    sc
  } else {
    skip_go(s, next(s, sc), t, next(t, tc))
  }

## Whether `sub` occurs in `s` starting exactly at `c`. An empty `sub` is at
## every position, including the end.
pub fn starts_at(s: String, c: Cursor, sub: String) -> Bool =
  match_go(s, c, sub, start(sub))

fn match_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Bool =
  if done(t, tc) {
    true
  } else if done(s, sc) {
    false
  } else if char(s, sc) != char(t, tc) {
    false
  } else {
    match_go(s, next(s, sc), t, next(t, tc))
  }

## The position of the first occurrence of `sub` at or after `from`, or `None`.
pub fn find(s: String, sub: String, from: Cursor) -> Option[Cursor] =
  if starts_at(s, from, sub) {
    Some(from)
  } else if done(s, from) {
    None
  } else {
    find(s, sub, next(s, from))
  }

## The position `n` characters back from `c` (clamped to the start).
pub fn back(s: String, c: Cursor, n: Int) -> Cursor =
  if n <= 0 { c } else { back(s, prev(s, c), n - 1) }

## Positions in one string are ordered, and that order is the Int's.
##
## It used to come from a row in the compiler's scalar tables, and only half
## of one: `a < b` was allowed while `list.sort` reported Cursor unordered,
## because two different tables answered the two questions. One impl answers
## both.
impl Ord[Cursor] {
  fn cmp(a: Cursor, b: Cursor) -> Int = {
    let x: Int = a
    let y: Int = b
    if x < y { -1 } else if x > y { 1 } else { 0 }
  }
}

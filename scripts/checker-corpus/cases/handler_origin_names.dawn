# Every old use of origin remains an identifier, including the operation name.
effect Ask { fn origin(n: Int) -> Int }
type Box = { origin: Int }
fn f(origin: Int) -> Int = origin
fn g() -> Int = {
  let value = {
    let origin = Box { origin = f(origin = 40) }
    origin.origin
  }
  with handle Ask { origin(n) => n + 2 }
  origin(value)
}

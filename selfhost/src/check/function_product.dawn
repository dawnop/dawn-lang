# Entry signatures and syntax must stay paired when declarations move. The
# ordered keys describe the current source; lookup uses declaration identity,
# never a saved list index. This is provenance, not dependency validity, and
# the full header checker still runs before constructing this view.
use std/map
use std/set
use check/checker.{ModuleHeaders, check_module_headers}
use check/cx.{Cx, ModExports, cx_new}
use check/types.{Sig, Ty, TyInt, TyString, ImplI, TraitI, MethodSig}
use check/identity
use check/identity.{ModuleKey, DeclKey, Named, FunctionDecl, ImplHead, MethodDecl, TraitDecl, ConstDecl, TestDecl, module_key}
use front/ast.{FnDecl, TraitMethod, TypeRef, ConstView, TestView, DFn, DImpl, DTrait, DConst, DTest}
use front/parser

pub type Header = { key: DeclKey, syntax: FnDecl, signature: Sig }
type Data = { order: List[DeclKey], entries: Map[DeclKey, Header] }
pub opaque type Headers = Data

## An ambiguous or erroneous header set has no reusable function view. The
## ordinary checker still owns error recovery; refusal here changes no output.
fn admitted(scope: ModuleKey, checked: ModuleHeaders) -> Bool = {
  if len(checked.cx.diags) != 0 || checked.cx.owner_class != Some(scope.emission_owner) { return false }
  match checked.cx.src_path {
    Some(path) -> if path == "" || scope.source != path { return false }
    None -> if scope.source != "" { return false }
  }
  true
}

pub fn headers(scope: ModuleKey, checked: ModuleHeaders) -> Option[Headers] = {
  if not admitted(scope, checked) { return None }
  let declarations = identity.declarations(scope, checked.syntax)
  var locations: Map[DeclKey, (Int, Option[Int])] = map.empty()
  for e in declarations { locations = map.insert(locations, e.key, (e.declaration, e.member)) }
  var entries: Map[DeclKey, Header] = map.empty()
  var order: List[DeclKey] = []
  var declaration = 0
  var function = 0
  for d in checked.syntax.decls {
    match d {
      DFn(syntax) -> {
        if function >= len(checked.sigs) { return None }
        let signature = checked.sigs[function]
        if signature.name != syntax.name || signature.owner != checked.cx.owner_class { return None }
        let key = DeclKey { scope: scope, path: [Named(FunctionDecl, syntax.name)] }
        if map.get(locations, key) != Some((declaration, None)) { return None }
        entries = map.insert(entries, key, Header { key: key, syntax: syntax, signature: signature })
        order = order ++ [key]
        function = function + 1
      }
      _ -> ()
    }
    declaration = declaration + 1
  }
  if function != len(checked.sigs) { return None }
  Some(Data { order: order, entries: entries })
}

pub fn keys(headers: Headers) -> List[DeclKey] = { let data: Data = headers
  data.order
}

pub fn get(headers: Headers, key: DeclKey) -> Option[Header] = { let data: Data = headers
  map.get(data.entries, key)
}

## Constants see only preceding constants; tests run after all other bodies.
## Keep these role orders separate from source interleaving. The visible set
## describes a current input, not permission to reuse a previously read name.
pub type ValueHeader =
  | ConstantHeader(key: DeclKey, syntax: ConstView, declared: Ty, visible: Set[String])
  | TestHeader(key: DeclKey, syntax: TestView)
type ValueData = { constants: List[DeclKey], tests: List[DeclKey], entries: Map[DeclKey, ValueHeader] }
pub opaque type Values = ValueData

pub fn values(scope: ModuleKey, checked: ModuleHeaders) -> Option[Values] = {
  if not admitted(scope, checked) { return None }
  var locations: Map[DeclKey, (Int, Option[Int])] = map.empty()
  for e in identity.declarations(scope, checked.syntax) {
    locations = map.insert(locations, e.key, (e.declaration, e.member))
  }
  var entries: Map[DeclKey, ValueHeader] = map.empty()
  var constants: List[DeclKey] = []
  var tests: List[DeclKey] = []
  var visible: Set[String] = set.empty()
  var declaration = 0
  var ci = 0
  for d in checked.syntax.decls {
    match d {
      DConst(name, is_pub, ann, init, lo, hi, nlo, nhi) -> {
        if ci >= len(checked.const_tys) { return None }
        let declared = checked.const_tys[ci]?
        if map.get(checked.cx.consts, name) != Some(declared) { return None }
        let key = DeclKey { scope: scope, path: [Named(ConstDecl, name)] }
        let expected: (Int, Option[Int]) = (declaration, None)
        if map.get(locations, key) != Some(expected) { return None }
        let syntax = ConstView { name: name, is_pub: is_pub, ann: ann, init: init,
          lo: lo, hi: hi, nlo: nlo, nhi: nhi }
        entries = map.insert(entries, key, ConstantHeader(key, syntax, declared, visible))
        constants = constants ++ [key]
        visible = set.insert(visible, name)
        ci = ci + 1
      }
      DTest(name, body, lo, hi, nlo, nhi) -> {
        let key = DeclKey { scope: scope, path: [Named(TestDecl, name)] }
        let expected: (Int, Option[Int]) = (declaration, None)
        if map.get(locations, key) != Some(expected) { return None }
        let syntax = TestView { name: name, body: body, lo: lo, hi: hi, nlo: nlo, nhi: nhi }
        entries = map.insert(entries, key, TestHeader(key, syntax))
        tests = tests ++ [key]
      }
      _ -> ()
    }
    declaration = declaration + 1
  }
  if ci != len(checked.const_tys) { return None }
  Some(ValueData { constants: constants, tests: tests, entries: entries })
}

pub fn constant_keys(values: Values) -> List[DeclKey] = { let data: ValueData = values
  data.constants
}

pub fn test_keys(values: Values) -> List[DeclKey] = { let data: ValueData = values
  data.tests
}

pub fn value(values: Values, key: DeclKey) -> Option[ValueHeader] = { let data: ValueData = values
  map.get(data.entries, key)
}

## Registered impl identity is not a substitute for the checker's body-output
## tagging rules. Keep it as header provenance, not an eagerly retagged TFun.
pub type MethodHeader =
  | ImplMethod(key: DeclKey, syntax: FnDecl, signature: Sig, registered: ImplI)
  | TraitDefault(key: DeclKey, syntax: TraitMethod, signature: Sig, trait_id: Int)

pub type ImplGroup = { key: DeclKey, trait_name: String, subject: TypeRef, methods: List[DeclKey] }
type MethodData = { impls: List[DeclKey], defaults: List[DeclKey], entries: Map[DeclKey, MethodHeader], groups: List[ImplGroup] }
pub opaque type Methods = MethodData

pub fn methods(scope: ModuleKey, checked: ModuleHeaders) -> Option[Methods] = {
  if not admitted(scope, checked) { return None }
  var locations: Map[DeclKey, (Int, Option[Int])] = map.empty()
  for e in identity.declarations(scope, checked.syntax) {
    locations = map.insert(locations, e.key, (e.declaration, e.member))
  }
  var registered: Map[(Int, Int), ImplI] = map.empty()
  for info in checked.cx.local_impls {
    if not info.derived && info.owner == checked.cx.owner_class && info.src_path == checked.cx.src_path {
      let span = (info.lo, info.hi)
      if map.has(registered, span) { return None }
      registered = map.insert(registered, span, info)
    }
  }
  var entries: Map[DeclKey, MethodHeader] = map.empty()
  var impls: List[DeclKey] = []
  var defaults: List[DeclKey] = []
  var groups: List[ImplGroup] = []
  var declaration = 0
  var impl_index = 0
  for d in checked.syntax.decls {
    match d {
      DImpl(params, trait_name, _, _, subject, members, _, _, lo, hi) -> {
        if impl_index >= len(checked.impl_sigs) { return None }
        let sigs = checked.impl_sigs[impl_index]
        let info = map.get(registered, (lo, hi))?
        if map.get(checked.cx.traits_by_name, trait_name) != Some(info.trait_id) ||
          len(sigs) != len(members) || len(info.tparams) != len(params) { return None }
        let parent = ImplHead(trait_name, identity.type_shape(subject, map(params, p => p.name)))
        let parent_key = DeclKey { scope: scope, path: [parent] }
        if map.get(locations, parent_key) != Some((declaration, None)) { return None }
        var group_keys: List[DeclKey] = []
        var member = 0
        for syntax in members {
          let sig = sigs[member]?
          if sig.name != syntax.name || sig.owner != checked.cx.owner_class || sig.tparams != info.tparams ||
            sig.is_builtin || sig.trait_id != None || sig.op_of != None { return None }
          let key = DeclKey { scope: scope, path: [parent, Named(MethodDecl, syntax.name)] }
          if map.get(locations, key) != Some((declaration, Some(member))) { return None }
          entries = map.insert(entries, key, ImplMethod(key, syntax, sig, info))
          impls = impls ++ [key]
          group_keys = group_keys ++ [key]
          member = member + 1
        }
        groups = groups ++ [ImplGroup { key: parent_key, trait_name: trait_name, subject: subject, methods: group_keys }]
        impl_index = impl_index + 1
      }
      DTrait(name, _, _, _, members, _, _, _, _, _, _, _) -> {
        let tid = map.get(checked.cx.traits_by_name, name)?
        let info = map.get(checked.cx.traits, tid)?
        if info.name != name || info.owner != checked.cx.owner_class || info.src_path != checked.cx.src_path { return None }
        let parent = Named(TraitDecl, name)
        if map.get(locations, DeclKey { scope: scope, path: [parent] }) != Some((declaration, None)) { return None }
        var signatures: Map[String, MethodSig] = map.empty()
        for (method_name, method) in info.methods {
          if map.has(signatures, method_name) { return None }
          signatures = map.insert(signatures, method_name, method)
        }
        var member = 0
        for syntax in members {
          # Presence needs no equality dictionary for the entire expression AST.
          let has_body = match syntax.body { Some(_) -> true, None -> false }
          if has_body {
            let method = map.get(signatures, syntax.name)?
            if not method.has_default { return None }
            let sig = method.sig
            if sig.name != syntax.name || sig.owner != checked.cx.owner_class ||
              sig.trait_id != Some(tid) || sig.is_builtin || sig.op_of != None { return None }
            let key = DeclKey { scope: scope, path: [parent, Named(MethodDecl, syntax.name)] }
            if map.get(locations, key) != Some((declaration, Some(member))) { return None }
            entries = map.insert(entries, key, TraitDefault(key, syntax, sig, tid))
            defaults = defaults ++ [key]
          }
          member = member + 1
        }
      }
      _ -> ()
    }
    declaration = declaration + 1
  }
  if impl_index != len(checked.impl_sigs) { return None }
  Some(MethodData { impls: impls, defaults: defaults, entries: entries, groups: groups })
}

pub fn impl_groups(methods: Methods) -> List[ImplGroup] = { let data: MethodData = methods
  data.groups
}

pub fn impl_keys(methods: Methods) -> List[DeclKey] = { let data: MethodData = methods
  data.impls
}

pub fn default_keys(methods: Methods) -> List[DeclKey] = { let data: MethodData = methods
  data.defaults
}

pub fn method(methods: Methods, key: DeclKey) -> Option[MethodHeader] = { let data: MethodData = methods
  map.get(data.entries, key)
}

test "function products bind entry signatures to stable current declarations" {
  let scope = module_key("world", "module", "module", "module.dawn")
  let (syntax, ds) = parser.parse_module("fn first(x: Int) -> Int = x\nconst K: Int = 1\nfn second() = K\n")
  let (edited, eds) = parser.parse_module("# moved\nfn second() = K\nconst K: Int = 1\nfn first(x: Int) -> Int = x\n")
  assert ds == [] && eds == []
  let env: Map[String, ModExports] = map.empty()
  let initial = cx_new(Some("module"), Some("module.dawn"))
  let old = check_module_headers(initial, syntax, env)
  let next = check_module_headers(initial, edited, env)
  let a = headers(scope, old).expect("old function headers")
  let b = headers(scope, next).expect("new function headers")
  let ka = keys(a)
  let kb = keys(b)
  assert len(ka) == 2
  assert ka[0] == kb[1] && ka[1] == kb[0]
  let second = get(b, ka[1]).expect("moved second")
  assert second.signature.inferring
  assert second.syntax.name == "second"
  assert second.syntax != get(a, ka[1]).expect("old second").syntax
  assert get(b, DeclKey { ..ka[0], scope: ModuleKey { ..scope, world: "other" } }) == None
  assert headers(ModuleKey { ..scope, source: "elsewhere.dawn" }, old) == None
  assert headers(ModuleKey { ..scope, emission_owner: "other" }, old) == None
  assert headers(scope, ModuleHeaders { ..old, sigs: [] }) == None
  assert headers(scope, ModuleHeaders { ..old, sigs: old.sigs ++ [old.sigs[0]] }) == None
  assert headers(scope, ModuleHeaders { ..old, sigs: [old.sigs[1], old.sigs[0]] }) == None
  let (duplicate, _) = parser.parse_module("fn same() -> Int = 1\nfn same() -> Int = 2\n")
  let bad = check_module_headers(initial, duplicate, env)
  assert headers(scope, bad) == None
  # Identity must still refuse a duplicate if a caller accidentally drops diagnostics.
  assert headers(scope, ModuleHeaders { ..bad, cx: Cx { ..bad.cx, diags: [] } }) == None
}

test "value products preserve constant visibility and separate test identities" {
  let scope = module_key("world", "module", "module", "module.dawn")
  let env: Map[String, ModExports] = map.empty()
  let initial = cx_new(Some("module"), Some("module.dawn"))
  let (syntax, ds) = parser.parse_module("const A: Int = 1\ntest \"A\" { assert true }\nconst B: Int = A\ntest \"B\" { assert true }\n")
  let (edited, eds) = parser.parse_module("test \"B\" { assert true }\nconst B: Int = A\nconst A: Int = 1\ntest \"A\" { assert true }\n")
  assert ds == [] && eds == []
  let old = check_module_headers(initial, syntax, env)
  let next = check_module_headers(initial, edited, env)
  let a = values(scope, old).expect("old values")
  let b = values(scope, next).expect("new values")
  let ac = constant_keys(a)
  let at = test_keys(a)
  assert len(ac) == 2 && len(at) == 2
  assert constant_keys(b) == [ac[1], ac[0]] && test_keys(b) == [at[1], at[0]]
  assert ac[0] != at[0]
  match value(a, ac[1]).expect("old B") {
    ConstantHeader(key, d, declared, visible) -> {
      assert key == ac[1] && d.name == "B" && declared == TyInt
      assert visible == set.from(["A"])
    }
    _ -> { assert false }
  }
  match value(b, ac[1]).expect("moved B") {
    ConstantHeader(_, _, _, visible) -> { assert visible == set.empty() }
    _ -> { assert false }
  }
  match value(b, at[0]).expect("moved test A") {
    TestHeader(key, d) -> { assert key == at[0] && d.name == "A" }
    _ -> { assert false }
  }
  assert values(ModuleKey { ..scope, emission_owner: "foreign" }, old) == None
  assert values(ModuleKey { ..scope, source: "foreign.dawn" }, old) == None
  assert values(scope, ModuleHeaders { ..old, const_tys: [] }) == None
  assert values(scope, ModuleHeaders { ..old, const_tys: old.const_tys ++ [Some(TyInt)] }) == None
  assert values(scope, ModuleHeaders { ..old, const_tys: [Some(TyString), Some(TyInt)] }) == None
  let (duplicate, _) = parser.parse_module("test \"same\" {}\ntest \"same\" {}\n")
  let bad = check_module_headers(initial, duplicate, env)
  assert values(scope, ModuleHeaders { ..bad, cx: Cx { ..bad.cx, diags: [] } }) == None
}

test "method products preserve impl and default owners across declaration reorder" {
  let forward = "trait Forward[T] {\n fn forward(x: T) -> Int\n fn twice(x: T) -> Int = forward(x) + forward(x)\n}\n"
  let repeat = "trait Repeat[T] {\n fn repeat(x: T) -> Int\n fn again(x: T) -> Int = repeat(x)\n}\n"
  let first = "impl[T] Forward[List[T]] { fn forward(x: List[T]) -> Int = 1 }\n"
  let second = "impl[T] Repeat[List[T]] { fn repeat(x: List[T]) -> Int = 2 }\n"
  let (syntax, ds) = parser.parse_module(forward ++ repeat ++ first ++ second)
  let (edited, eds) = parser.parse_module(repeat ++ forward ++ second ++ first)
  assert ds == [] && eds == []
  let scope = module_key("methods", "module", "module", "module.dawn")
  let initial = cx_new(Some("module"), Some("module.dawn"))
  let env: Map[String, ModExports] = map.empty()
  let old = check_module_headers(initial, syntax, env)
  let next = check_module_headers(initial, edited, env)
  assert old.cx.diags == [] && next.cx.diags == []
  let a = methods(scope, old).expect("old methods")
  let b = methods(scope, next).expect("next methods")
  let ai = impl_keys(a)
  let bi = impl_keys(b)
  let ad = default_keys(a)
  let bd = default_keys(b)
  assert len(ai) == 2 && len(ad) == 2
  assert ai[0] == bi[1] && ai[1] == bi[0]
  assert ad[0] == bd[1] && ad[1] == bd[0]
  let groups = impl_groups(a)
  assert len(groups) == 2
  assert groups[0].methods == [ai[0]] && groups[1].methods == [ai[1]]
  assert groups[0].key.path ++ [Named(MethodDecl, "forward")] == ai[0].path
  assert groups[0].trait_name == "Forward"
  assert impl_groups(b)[0].key == groups[1].key
  match method(b, ai[0]).expect("moved impl") {
    ImplMethod(key, syntax, sig, info) -> {
      assert key == ai[0]
      assert syntax.name == "forward" && sig.name == "forward"
      assert sig.tparams == info.tparams
      assert len(info.tparams) == 1
      assert Some(info.trait_id) == map.get(next.cx.traits_by_name, "Forward")
    }
    _ -> { assert false }
  }
  match method(b, ad[0]).expect("moved default") {
    TraitDefault(key, syntax, sig, tid) -> {
      assert key == ad[0]
      assert syntax.name == "twice" && syntax.body != None
      assert sig.trait_id == Some(tid)
      assert Some(tid) == map.get(next.cx.traits_by_name, "Forward")
      assert Some(tid) != map.get(old.cx.traits_by_name, "Forward")
    }
    _ -> { assert false }
  }
  assert methods(scope, ModuleHeaders { ..old, impl_sigs: [] }) == None
  let sig = old.impl_sigs[0][0].expect("registered signature")
  assert methods(scope, ModuleHeaders { ..old, impl_sigs: [[Some(Sig { ..sig, is_builtin: true })], old.impl_sigs[1]] }) == None
  assert methods(scope, ModuleHeaders { ..old, impl_sigs: [[Some(Sig { ..sig, tparams: [] })], old.impl_sigs[1]] }) == None
  let foreign = map(old.cx.local_impls, i => ImplI { ..i, owner: Some("foreign") })
  assert methods(scope, ModuleHeaders { ..old, cx: Cx { ..old.cx, local_impls: foreign } }) == None
  let tid = map.get(old.cx.traits_by_name, "Forward").expect("Forward trait")
  let info = map.get(old.cx.traits, tid).expect("Forward info")
  let (name, ms) = info.methods[1]
  let missing = TraitI { ..info, methods: [info.methods[0], (name, MethodSig { ..ms, has_default: false })] }
  assert methods(scope, ModuleHeaders { ..old, cx: Cx { ..old.cx, traits: map.insert(old.cx.traits, tid, missing) } }) == None
  let wrong_owner = TraitI { ..info, owner: Some("foreign") }
  assert methods(scope, ModuleHeaders { ..old, cx: Cx { ..old.cx, traits: map.insert(old.cx.traits, tid, wrong_owner) } }) == None
  let (empty_impl, empty_ds) = parser.parse_module("trait Only[T] { fn only(x: T) -> Int = 1 }\nimpl[T] Only[List[T]] {}\n")
  assert empty_ds == []
  let empty_methods = methods(scope, check_module_headers(initial, empty_impl, env)).expect("empty impl group")
  assert len(impl_groups(empty_methods)) == 1
  assert impl_groups(empty_methods)[0].methods == []
  assert impl_keys(empty_methods) == [] && len(default_keys(empty_methods)) == 1
}

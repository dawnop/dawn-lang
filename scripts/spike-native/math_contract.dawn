  "tanh" -> math.tanh
  "cbrt" -> math.cbrt
  "sqrt" -> math.sqrt
  "floor" -> math.floor
  "ceil" -> math.ceil
  "trunc" -> math.trunc
  "round" -> math.round
  "round_even" -> math.round_even
  _ -> math.abs
}
fn binary(op: String) -> fn(Float, Float) -> Float = match op {
  "pow" -> math.pow
  "hypot" -> math.hypot
  "atan2" -> math.atan2
  _ -> math.hypot
}

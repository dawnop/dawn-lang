# checker.dawn EIndex: Dawn has no call-site type arguments, and `f[T](x)` --
# the spelling Go 1.18 gave explicit instantiation -- parses as indexing the
# function `f` with the expression `T`. Said first and said once, for a user
# generic function and for a builtin, with a builtin type name, a user type
# name and a nested type; a non-generic function and a list are left to the
# ordinary index diagnostics.
use std/io

pub type Point = { x: Int }

fn id[T](x: T) -> T = x

fn plain(x: Int) -> Int = x

pub fn user_fn() -> String = to_string(id[Int](3))

pub fn user_type(p: Point) -> Point = id[Point](p)

pub fn nested() -> List[Int] = id[List[Int]]([1])

pub fn builtin() -> Result[Int, String] = catch_panic[Int](() => 1)

pub fn not_generic() -> Int = plain[Int](3)

pub fn a_list(xs: List[Int]) -> Int = xs[Int]

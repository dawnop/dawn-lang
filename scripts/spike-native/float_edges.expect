-- a fold and a runtime call answer alike in one binary --
0.1
0.1
-- shortest round trip, plain form inside 10^-3 <= |v| < 10^7 --
2.0 100.0 123.456 0.001 0.0015 9999999.0 1.0000000000000002
-- scientific outside it, E, no exponent sign when positive --
1.0E7 9.999999999999998E-4 3.0E-7 1.0E300 1.0E-300
-- the three spellings, signed zero, integer .0 --
NaN Infinity -Infinity 0.0 -0.0
-- extremes: subnormals, the largest finite, 2^53 and its neighbor --
4.9E-324 2.225073858507201E-308 2.2250738585072014E-308 1.7976931348623157E308 9.007199254740992E15 9.007199254740992E15
-- parse(to_string(x)) closes over every family --
true true true true true true
-- parse_float: the EBNF and the three spellings, nothing else --
Some(1.5) Some(1.5) Some(1.0) Some(0.5) Some(1000.0) Some(0.5) Some(2.5)
Some(Infinity) Some(-Infinity) Some(NaN)
None None None None None None None None
None None None None
-- parse_int: ASCII digits, sign, Dawn's own trim, range refusal --
Some(7) Some(5) Some(-12) Some(9223372036854775807)
None Some(-9223372036854775808) None None None None None
-- parse_int_radix: 0-9a-zA-Z cut at radix, radix in 2..36 --
Some(255) Some(255) Some(35) None Some(-2) None None None
Some(-9223372036854775808) None

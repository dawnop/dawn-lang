# The other side of the dispatch: what it refuses. Each line is named in
# run.sh by the exact sentence it must produce.
use java "fixture.Syn09"
use lib

# a Java name is matched against the JVM declaration exactly, in both directions
pub fn wrong_case_down() -> Int !io = Syn09.upperstatic(1)

pub fn wrong_case_up() -> Int !io = Syn09.LOWERSTATIC(1)

# staticness is part of the match: an instance method is not on the class ...
pub fn instance_on_class() -> Int !io = Syn09.UpperInstance(1)

# ... and a static method is not reachable through an instance
pub fn static_on_instance() -> Int !io = {
  let v = Syn09.new()
  v.UpperStatic(1)
}

# instance fields stay unreadable, uppercase members or not
pub fn instance_field() -> Int !io = Syn09.inst

# a module alias receiver keeps the Dawn answers rather than falling into Java
pub fn const_called() -> Int !io = lib.LIMIT(1)

pub fn missing_called() -> Int !io = lib.NOPE(1)

pub fn main() -> Unit !io = ()

# Fetching and verifying remote source packages (the Kotlin manifest/PkgFetch):
# download an archive, unpack it, d1-hash the file tree, and file it into the
# content-addressed cache. Errors are pre-formatted strings — the message plus,
# when the Kotlin side carries one, "\n  " and the hint — so callers print them
# behind "error: " exactly as the Kotlin CLI does.
#
# Nothing here reaches the host any more. What is left of the outside world is
# `curl`, spawned like any other program, and the filesystem through std/io.

use std/char
use std/str
use std/bytes
use std/list
use std/io
use std/io.{Fs}
use fspath/fspath
use sha2/sha256
use inflate/gzip
use inflate/zip

## The content-addressed cache root: $DAWN_PKG_CACHE, then ~/.dawn/pkg. An
## environment variable and nothing else — the tests set it too, and there is
## no JVM system property in the chain for a native build to be missing.
pub fn cache_root() -> String !io =
  match io.getenv("DAWN_PKG_CACHE") {
    Some(p) -> p
    None ->
      match io.getenv("HOME") {
        Some(h) -> h ++ "/.dawn/pkg"
        None -> ".dawn-pkg"
      }
  }

pub fn cache_dir(hash: String) -> String !io = cache_root() ++ "/" ++ str.replace(hash, ":", "-")

# ---- origin records: which urls were seen to produce which hash ----
#
# The cache is addressed by content, so `url` is consulted on a miss and never
# again. That is right for reproducibility and wrong for the one mistake this
# scheme invites: bump `[deps.x] url` to a new tag, forget `hash`, and the
# build resolves the *old* tree out of the cache and goes green with nothing
# to read. Only a warm cache can do this — a cold one fetches the new url and
# the hash mismatch is already caught — so the record lives with the cache,
# per machine, and needs no lockfile.
#
# The record is a sibling of the entry, never a file inside it: the entry's
# name is the d1 hash of its own tree, so anything added under it would make
# `verify_cached` fail. `.origins` also stays out of `dawn cache verify`'s
# `d1-` sweep.

fn origins_dir(root: String) -> String = root ++ "/.origins"

fn origins_file(root: String, hash: String) -> String =
  origins_dir(root) ++ "/" ++ str.replace(hash, ":", "-")

## One url per line, blanks ignored.
fn origins_parse(text: String) -> List[String] = {
  var out: List[String] = []
  for line in str.split(text, "\n") {
    let u = str.trim(line)
    if u != "" { out = out ++ [u] }
  }
  out
}

fn origins_render(urls: List[String]) -> String = {
  var out = ""
  for u in urls { out = out ++ u ++ "\n" }
  out
}

## The urls recorded for `hash` under cache root `root`. A missing record is
## an empty list, not an error: the entry may predate this file or have been
## copied in by hand.
pub fn recorded_origins(root: String, hash: String) -> List[String] !Fs =
  match io.read_file(origins_file(root, hash)) {
    Ok(t) -> origins_parse(t)
    Err(_) -> []
  }

## Add `url` to `hash`'s record. A failed write is dropped on purpose: the
## record is an optimization over re-fetching, so losing it costs one download
## and never a build. Concurrent writers can lose an entry the same way.
pub fn record_origin(root: String, hash: String, url: String) -> Unit !Fs = {
  let have = recorded_origins(root, hash)
  for u in have { if u == url { return () } }
  mkdirs(origins_dir(root))
  let _ = io.write_file(origins_file(root, hash), origins_render(have ++ [url]))
  ()
}

# ---- d1: SHA-256 over the sorted file tree, `relpath \0 size \0 bytes` ----

fn zero_byte() -> Bytes = bytes.utf8(str.from_char('\u{0000}'))

fn read_bytes(path: String) -> Result[Bytes, String] !Fs =
  match io.read_bytes(path) {
    Ok(b) -> Ok(b)
    Err(e) -> Err("cannot read " ++ path ++ ": " ++ e.message)
  }

## Regular files under `root`, sorted by relative path; symlinks are refused
## (they do not survive archives portably, so the hash refuses them).
fn collect_files(root: String, rel: String) -> Result[List[String], String] !Fs = {
  var out: List[String] = []
  let dir = if rel == "" { root } else { root ++ "/" ++ rel }
  match io.list_dir(dir) {
    Ok(names) -> {
      for f in sort(names) {
        let r2 = if rel == "" { f } else { rel ++ "/" ++ f }
        let full = root ++ "/" ++ r2
        if io.is_symlink(full) {
          return Err("symbolic link in package tree: " ++ r2 ++
              "\n  the d1 hash refuses symlinks — they do not survive archives portably")
        }
        if io.is_dir(full) {
          match collect_files(root, r2) {
            Ok(sub) -> { out = out ++ sub }
            Err(e) -> return Err(e)
          }
        } else {
          out = out ++ [r2]
        }
      }
      Ok(out)
    }
    Err(e) -> Err("cannot list " ++ dir ++ ": " ++ e.message)
  }
}

## The d1 canonical tree hash of a directory: `d1:` + 64 hex digits.
pub fn tree_hash(root: String) -> Result[String, String] !Fs = {
  let files = match collect_files(root, "") {
    Ok(fs) -> sort(fs)
    Err(e) -> return Err(e)
  }
  var digest = sha256.new()
  for rel in files {
    let content = match read_bytes(root ++ "/" ++ rel) {
      Ok(b) -> b
      Err(e) -> return Err(e)
    }
    digest = sha256.update(digest, bytes.utf8(rel))
    digest = sha256.update(digest, zero_byte())
    digest = sha256.update(digest, bytes.utf8(to_string(bytes.len(content))))
    digest = sha256.update(digest, zero_byte())
    digest = sha256.update(digest, content)
  }
  Ok("d1:" ++ sha256.finish(digest))
}

# ---- download ----

## Fetch over HTTP by running `curl`.
##
## Not a client of our own, and not the host's: TLS is the one thing in this
## file that cannot be written in Dawn, and reaching for the JDK's would mean
## the package manager only works on the backend that has a JDK under it --
## while fetching a source package by url and hash has nothing to do with what
## the compiler emits. One implementation, one dependency, both backends.
##
## Resource ceilings for fetching and unpacking a source package.
##
## A never-answering host used to hold the compiler forever (no connect or
## request timeout at all), and a zip or tar.gz bomb — a few hundred KB that
## expands to gigabytes — was unpacked without a single check on total size,
## entry count or per-entry size. Both are one hostile `[deps]` URL away, and
## `dawn build` is the thing that follows it. The numbers are far above any
## real source package (the largest thing this fetches is a GitHub tag
## archive) and far below anything that endangers the machine.
const FETCH_CONNECT_TIMEOUT_SECS: Int = 30
const FETCH_REQUEST_TIMEOUT_SECS: Int = 300
const MAX_ARCHIVE_BYTES: Int = 268435456
const MAX_ENTRIES: Int = 65536
const MAX_ENTRY_BYTES: Int = 67108864

fn too_big(what: String, n: Int, limit: Int) -> String =
  "archive rejected: " ++ what ++ " (" ++ to_string(n) ++ " exceeds the " ++
  to_string(limit) ++ " limit)" ++
  "\n  a source package that legitimately needs this much is not one this fetcher handles"

## `--fail` turns a 4xx/5xx into a non-zero status with a line on stderr, which
## is why no status code is parsed here. The proxy environment variables need
## no code at all: curl reads them, which the JDK never did. `--max-filesize`
## is advisory (servers may not send a length), so the size is checked again
## on the downloaded bytes.
fn http_get(url: String) -> Result[Bytes, String] !Fs !io = {
  let staged = match io.temp_dir("", "dawn-fetch-") {
    Ok(d) -> d
    Err(e) -> return Err("cannot create a temp directory: " ++ e.message)
  }
  with work <- bracket(staged, delete_tree)
  let body = work ++ "/body"
  let diag = work ++ "/stderr"
  let ran = io.run([
    "curl", "--silent", "--show-error", "--location", "--fail",
    "--connect-timeout", to_string(FETCH_CONNECT_TIMEOUT_SECS),
    "--max-time", to_string(FETCH_REQUEST_TIMEOUT_SECS),
    "--max-filesize", to_string(MAX_ARCHIVE_BYTES),
    url
  ], body, diag)
  let out: Result[Bytes, String] = match ran {
    Ok(0) ->
      match read_bytes(body) {
        Ok(b) ->
          if bytes.len(b) > MAX_ARCHIVE_BYTES {
            Err(too_big("downloaded " ++ url, bytes.len(b), MAX_ARCHIVE_BYTES))
          } else {
            Ok(b)
          }
        Err(e) -> Err("cannot fetch " ++ url ++ ": " ++ e)
      }
    Ok(code) -> {
      let said = str.trim(match io.read_file(diag) {
        Ok(s) -> s
        Err(_) -> ""
      })
      let why = if said == "" { "curl exited " ++ to_string(code) } else { said }
      Err("cannot fetch " ++ url ++ ": " ++ why ++
          "\n  check the network (https_proxy is honored) or pre-seed the cache")
    }
    Err(e) ->
      Err("cannot fetch " ++ url ++ ": " ++ e.message ++
          "\n  fetching a remote package needs `curl` on PATH")
  }
  out
}

fn download(url: String) -> Result[Bytes, String] !Fs !io =
  if str.starts_with(url, "file://") {
    let path = str.strip_prefix(url, "file://").unwrap_or(url)
    if io.is_dir(path) {
      Err("no such file: " ++ url)
    } else {
      match read_bytes(path) {
        Ok(b) -> Ok(b)
        Err(_) -> Err("no such file: " ++ url)
      }
    }
  } else {
    http_get(url)
  }

# ---- unpack: zip or tar.gz, told apart by magic bytes ----

fn mkdirs(path: String) -> Unit !Fs = {
  let _ = io.mkdirs(path)
  ()
}

fn write_file_bytes(path: String, bs: Bytes) -> Result[Unit, String] !Fs = {
  match str.last_index_of(path, "/") {
    Some(i) -> mkdirs(str.take(path, i))
    None -> ()
  }
  match io.write_bytes(path, bs) {
    Ok(_) -> Ok(())
    Err(e) -> Err("cannot write " ++ path ++ ": " ++ e.message)
  }
}

## The extraction target for an archive entry, with the zip-slip guard.
##
## The guard is lexical. It used to resolve both sides with getCanonicalPath,
## which also follows symbolic links -- but nothing has been extracted yet, so
## there are no links of the archive's making to follow, and a link already in
## the destination would be the caller's own. What has to be refused is `..`,
## and that is arithmetic on the name.
fn entry_path(dest: String, name: String) -> Result[String, String] !io = {
  let base = fspath.absolute(dest, io.cwd())
  let out = fspath.absolute(dest ++ "/" ++ name, io.cwd())
  if out == base || str.starts_with(out, base ++ "/") {
    Ok(dest ++ "/" ++ name)
  } else {
    Err("archive entry escapes the extraction root: " ++ name)
  }
}

## Unpack a zip, one entry at a time and never more than the budget allows.
##
## The central directory is read first, on its own: it says how many entries
## there are and how big each one claims to be, so the count and the declared
## sizes are decided before a single byte is decompressed. Those are claims,
## not measurements, which is why the reader also gets a ceiling -- what is
## left of the archive budget -- and stops the entry mid-expansion when its
## directory lied. Between the two there is no point at which a bomb has been
## materialised and is waiting to be measured.
fn unzip(bs: Bytes, dest: String) -> Result[Unit, String] !Fs !io = {
  let metas = match zip.headers(bs) {
    Ok(ms) -> ms
    Err(e) -> return Err(e ++
        "\n  .zip and .tar.gz archives are supported; for GitHub use .../archive/refs/tags/<tag>.zip")
  }
  if len(metas) > MAX_ENTRIES {
    return Err(too_big("entry count", len(metas), MAX_ENTRIES))
  }
  var declared = 0
  for m in metas {
    if m.size > MAX_ENTRY_BYTES {
      return Err(too_big("entry " ++ m.name, m.size, MAX_ENTRY_BYTES))
    }
    declared = declared + m.size
    if declared > MAX_ARCHIVE_BYTES {
      return Err(too_big("expanded size", declared, MAX_ARCHIVE_BYTES))
    }
  }
  var any = false
  # running total of what actually landed, which is what the per-entry ceiling
  # is derived from
  var total = 0
  for m in metas {
    let out = match entry_path(dest, m.name) {
      Ok(p) -> p
      Err(e) -> return Err(e)
    }
    if m.is_dir {
      mkdirs(out)
    } else {
      var room = MAX_ARCHIVE_BYTES - total
      if room > MAX_ENTRY_BYTES { room = MAX_ENTRY_BYTES }
      let data = match zip.read_bounded(bs, m, Some(room)) {
        Ok(d) -> d
        Err(e) -> return Err(e)
      }
      total = total + bytes.len(data)
      match write_file_bytes(out, data) {
        Ok(_) -> ()
        Err(e) -> return Err(e)
      }
    }
    any = true
  }
  if not any {
    Err("not a zip archive (or an empty one)" ++
        "\n  .zip and .tar.gz archives are supported; for GitHub use .../archive/refs/tags/<tag>.zip")
  } else {
    Ok(())
  }
}

# ---- tar.gz: gunzip whole, then walk 512-byte ustar blocks in memory ----

## The NUL-terminated string in `[off, off+len)`.
fn tar_str(b: Bytes, off: Int, len_: Int) -> String = {
  var end = off
  while end < off + len_ && bytes.at(b, end) != 0 { end = end + 1 }
  bytes.decode_utf8_lossy(bytes.slice(b, off, end))
}

fn tar_octal(b: Bytes, off: Int, len_: Int) -> Result[Int, String] = {
  if bytes.at(b, off) >= 128 { return Err("GNU base-256 tar sizes are not supported") }
  let s = str.trim(tar_str(b, off, len_))
  if s == "" { return Ok(0) }
  var n = 0
  for c in str.chars(s) {
    match str.index_of("01234567", c) {
      Some(d) -> { n = n * 8 + d }
      None -> return Err("bad size field in tar header")
    }
  }
  Ok(n)
}

fn block_all_zero(b: Bytes, off: Int) -> Bool = {
  var i = off
  while i < off + 512 {
    if bytes.at(b, i) != 0 { return false }
    i = i + 1
  }
  true
}

## pax extended header records are "<len> key=value\n"; the path override wins.
fn pax_path(recs: String) -> Option[String] = {
  let n = str.len(recs)
  var out: Option[String] = None
  var i = 0
  while i < n {
    let sp = match str.index_of(str.slice(recs, i, n), " ") {
      Some(s) -> i + s
      None -> break
    }
    let rec_len = match parse_int(str.slice(recs, i, sp)) {
      Some(m) -> m
      None -> break
    }
    if rec_len <= 0 || i + rec_len > n { break }
    var rec = str.slice(recs, sp + 1, i + rec_len)
    rec = str.strip_suffix(rec, "\n").unwrap_or(rec)
    if str.starts_with(rec, "path=") {
      out = Some(str.strip_prefix(rec, "path=").unwrap_or(rec))
    }
    i = i + rec_len
  }
  out
}

fn untar(gz: Bytes, dest: String) -> Result[Unit, String] !Fs !io = {
  # The ceiling goes in, rather than a length check coming out: `gunzip` used
  # to materialise the whole member first, so the archive budget was a thing
  # this learned about a bomb after paying for it. The caller has already
  # matched the gzip magic, so a failure here is a broken archive and its
  # reason is worth printing.
  let raw = match gzip.gunzip_bounded(gz, Some(MAX_ARCHIVE_BYTES)) {
    Ok(b) -> b
    Err(e) -> return Err(e ++
        "\n  .zip and .tar.gz archives are supported; for GitHub use .../archive/refs/tags/<tag>.tar.gz")
  }
  var any = false
  var off = 0
  var pending: Option[String] = None
  while off + 512 <= bytes.len(raw) {
    if block_all_zero(raw, off) { break }
    let size = match tar_octal(raw, off + 124, 12) {
      Ok(n) -> n
      Err(e) -> return Err(e)
    }
    let tchar = bytes.at(raw, off + 156)
    let magic = tar_str(raw, off + 257, 6)
    let prefix = if str.starts_with(magic, "ustar") { tar_str(raw, off + 345, 155) } else { "" }
    let raw_name = tar_str(raw, off, 100)
    let name = match pending {
      Some(p) -> p
      None -> if prefix == "" { raw_name } else { prefix ++ "/" ++ raw_name }
    }
    pending = None
    let data_start = off + 512
    if data_start + size > bytes.len(raw) { return Err("truncated tar archive") }
    let padded = size + (512 - size % 512) % 512
    # type bytes: 'L' 76, 'x' 120, 'g' 103, '5' 53, '0' 48, NUL 0, '7' 55, links 49/50
    if tchar == 76 {
      let long_name = bytes.decode_utf8_lossy(bytes.slice(raw, data_start, data_start + size))
      pending = Some(match str.index_of(long_name, str.from_char('\u{0000}')) {
        Some(i) -> str.take(long_name, i)
        None -> long_name
      })
    } else if tchar == 120 {
      let recs = bytes.decode_utf8_lossy(bytes.slice(raw, data_start, data_start + size))
      pending = pax_path(recs)
    } else if tchar == 103 {
      ()
    } else if tchar == 53 {
      match entry_path(dest, name) {
        Ok(p) -> mkdirs(p)
        Err(e) -> return Err(e)
      }
      any = true
    } else if tchar == 48 || tchar == 0 || tchar == 55 {
      let out = match entry_path(dest, name) {
        Ok(p) -> p
        Err(e) -> return Err(e)
      }
      match write_file_bytes(out, bytes.slice(raw, data_start, data_start + size)) {
        Ok(_) -> ()
        Err(e) -> return Err(e)
      }
      any = true
    } else if tchar == 49 || tchar == 50 {
      return Err("link in tar archive: " ++ name ++
          "\n  the d1 hash refuses links — they do not survive archives portably")
    } else {
      return Err("unsupported tar entry type `" ++
          str.from_char(char.of(tchar).unwrap_or('?')) ++ "`: " ++ name)
    }
    off = data_start + padded
  }
  if not any {
    Err("not a tar.gz archive (or an empty one)" ++
        "\n  .zip and .tar.gz archives are supported; for GitHub use .../archive/refs/tags/<tag>.tar.gz")
  } else {
    Ok(())
  }
}

fn unpack(bs: Bytes, dest: String) -> Result[Unit, String] !Fs !io =
  if bytes.len(bs) >= 2 && bytes.at(bs, 0) == 31 && bytes.at(bs, 1) == 139 {
    untar(bs, dest)
  } else {
    unzip(bs, dest)
  }

## GitHub-style archives wrap everything in `<repo>-<tag>/`: when the unpacked
## root holds exactly one directory and nothing else, that directory is the tree.
fn strip_single_top_dir(work: String) -> String !Fs =
  match io.list_dir(work) {
    Ok(names) ->
      if len(names) == 1 && io.is_dir(work ++ "/" ++ names[0]) {
        work ++ "/" ++ names[0]
      } else {
        work
      }
    Err(_) -> work
  }

## Remove `path` and everything under it. A missing path is not an error, and
## a symbolic link is removed rather than followed.
pub fn delete_tree(path: String) -> Unit !Fs = {
  if io.is_dir(path) && not io.is_symlink(path) {
    match io.list_dir(path) {
      Ok(names) -> { for f in names { delete_tree(path ++ "/" ++ f) } }
      Err(_) -> ()
    }
  }
  let _ = io.delete(path)
  ()
}

## Fetch `url`, unpack, hash, and file the tree into the cache under its own
## (actual) hash. Returns (cache entry, d1 hash) — `add` uses this to learn the
## hash of an archive it has never seen.
pub fn fetch_and_hash(url: String) -> Result[(String, String), String] !Fs !io = {
  mkdirs(cache_root())
  # staged inside the cache root, so the publishing rename below stays on one
  # filesystem and is therefore atomic
  let staged = match io.temp_dir(cache_root(), "fetch-") {
    Ok(d) -> d
    Err(e) -> return Err("cannot create a temp directory under " ++ cache_root() ++ ": " ++ e.message)
  }
  with work <- bracket(staged, delete_tree)
  let got = fetch_into(url, work)
  match got {
    Ok(pr) -> {
      let (_, actual) = pr
      record_origin(cache_root(), actual, url)
    }
    Err(_) -> ()
  }
  got
}

## The body of the fetch. Still its own function, but no longer *because* of
## the release: the staging directory now has a bracket around it, and this
## keeps its four early `Err` returns, which the sugared region would refuse.
fn fetch_into(url: String, work: String) -> Result[(String, String), String] !Fs !io = {
  let body = match download(url) {
    Ok(b) -> b
    Err(e) -> return Err(e)
  }
  match unpack(body, work) {
    Ok(_) -> ()
    Err(e) -> return Err(e)
  }
  let root = strip_single_top_dir(work)
  let actual = match tree_hash(root) {
    Ok(h) -> h
    Err(e) -> return Err(e)
  }
  let target = cache_dir(actual)
  var adopted = true
  if not io.is_dir(target) {
    # rename into place; a concurrent fetch of the same hash yields the same bytes
    let moved = io.rename(root, target)
    match moved {
      Ok(_) -> { adopted = false }
      Err(e) -> { if not io.is_dir(target) { return Err("cannot move into the cache: " ++ e.message) } }
    }
  }
  # An entry that was already there is *adopted*, not written, and adopting it
  # used to be unconditional: the freshly downloaded tree was dropped and the
  # directory returned on the strength of its name. The caller then wrote an
  # origin record saying this url produced these bytes -- for bytes the url had
  # just been observed not to produce. That is a local cache injection turning
  # itself into a permanent, trusted fact, and it is exactly the case
  # `check_origin` exists to catch.
  #
  # This is also the one moment where both halves are in hand: a tree whose
  # hash is known and a directory claiming to be it. Verifying is cheap here
  # and impossible later.
  if adopted {
    match verify_cached(target, actual) {
      Ok(_) -> ()
      Err(e) -> return Err(e)
    }
  }
  Ok((target, actual))
}

## Re-hash a cache entry and compare against the hash its directory name
## claims (PKG-02): the cache is content-addressed, so the name is the
## declaration and a fresh d1 walk is the whole verification — hand edits,
## disk rot and a half-written concurrent unpack all surface as a mismatch.
pub fn verify_cached(dir: String, hash: String) -> Result[Unit, String] !Fs =
  match tree_hash(dir) {
    Err(e) -> Err("cache entry " ++ dir ++ " is unreadable: " ++ e ++
        "\n  delete it and re-run; the next fetch re-downloads")
    Ok(actual) ->
      if actual != hash {
        Err("cache entry " ++ dir ++ " does not match its own name" ++
            "\n  named:     " ++ hash ++ "\n  actual:    " ++ actual ++
            "\n  the local copy was modified or damaged after fetch; delete it and re-run")
      } else {
        Ok(())
      }
  }

## The url/hash guard, for a cache entry that is already there: has *this* url
## ever been seen to produce `hash` on this machine? If it has, the entry is
## the right one and nothing happens. If it has not, the question is answered
## the only way it can be — fetch the url and hash what comes back:
##
##   - same hash: a new source for the same bytes (a mirror, a moved tag, an
##     entry that predates this record or was pre-seeded by hand). Recorded,
##     so it costs one download once and nothing afterwards.
##   - different hash: `url` moved and `hash` did not. This is the bug the
##     record exists for, and it is now the same hard error a cold cache
##     would have given.
##
## An entry with no record is verified rather than adopted. Adopting would be
## cheaper and would let exactly one bump through — the first one after this
## code ships, which is the occurrence it was written for.
pub fn check_origin(url: String, hash: String) -> Result[Unit, String] !Fs !io = {
  let root = cache_root()
  for u in recorded_origins(root, hash) { if u == url { return Ok(()) } }
  match fetch_and_hash(url) {
    Err(e) -> Err(e)
    Ok(pr) -> {
      let (_, actual) = pr
      # fetch_and_hash records `url -> actual` itself: that is the one moment
      # a url is ever observed to produce a hash, so it is the only place the
      # record is written, and `actual == hash` makes it this hash's record
      if actual == hash { Ok(()) } else {
        Err("url changed but hash did not: " ++ url ++
            "\n  declared:  " ++ hash ++ "\n  this url:  " ++ actual ++
            "\n  the cache already holds the declared hash from a different url, so the build" ++
            " would have used the old package; copy the actual value into `hash`")
      }
    }
  }
}

## The unpacked archive for `hash`, fetching from `url` on a cache miss.
## A hit is re-verified every time (PKG-02): fetch-time verification alone
## means a later modification of the local copy is trusted forever — the
## seed jars had the same hole until scripts/seed-checksums.txt. Re-hashing
## costs one read of the package's bytes (measured ~0.9s for a 7MB tree,
## milliseconds for typical source packages).
##
## "Every time" is narrower than it reads, and has been since before that
## claim was written: the resolver returns a warm entry without calling this
## at all (source.url_pkg_root), so on the build path a hit reaches here only
## when the entry exists and the `subdir` inside it does not. The url/hash
## guard therefore hangs off the resolver as well; extending PKG-02's re-hash
## to every warm build is a separate decision with a per-build price tag.
pub fn ensure_cached(url: String, hash: String) -> Result[String, String] !Fs !io = {
  let target = cache_dir(hash)
  if io.is_dir(target) {
    match verify_cached(target, hash) {
      Ok(_) -> ()
      Err(e) -> return Err(e)
    }
    match check_origin(url, hash) {
      Ok(_) -> return Ok(target)
      Err(e) -> return Err(e)
    }
  }
  match fetch_and_hash(url) {
    Ok(pr) -> {
      let (dir, actual) = pr
      if actual != hash {
        Err("hash mismatch for " ++ url ++
            "\n  declared:  " ++ hash ++ "\n  actual:    " ++ actual ++
            "\n  if you just wrote this dependency, copy the actual value into `hash`")
      } else {
        Ok(dir)
      }
    }
    Err(e) -> Err(e)
  }
}

test "origin records round-trip and accumulate urls" {
  io.with_fs_real(() => {
    let h = "d1:" ++ str.repeat("a", 64)
    let root = match io.temp_dir("", "dawn-origins-") {
      Ok(d) -> d
      Err(e) -> panic("temp dir: " ++ e.message)
    }
    with r <- bracket(root, delete_tree)
    # an entry nobody fetched has no record, which is what makes check_origin
    # verify it instead of trusting it
    assert recorded_origins(r, h) == []
    record_origin(r, h, "file:///one.zip")
    assert recorded_origins(r, h) == ["file:///one.zip"]
    # a second url for the same bytes (a mirror) joins the first, and neither
    # url nor a repeat of it is written twice
    record_origin(r, h, "file:///one.zip")
    record_origin(r, h, "https://mirror/two.zip")
    assert recorded_origins(r, h) == ["file:///one.zip", "https://mirror/two.zip"]
    # the record is a sibling of the entry, never a file under it: the entry's
    # name is the d1 hash of its own tree, so a file inside would fail verify
    assert not io.exists(r ++ "/d1-" ++ str.repeat("a", 64))
    assert io.exists(r ++ "/.origins/d1-" ++ str.repeat("a", 64))
  })
}

test "origin records ignore blank lines" {
  assert origins_parse("") == []
  assert origins_parse("\n  \n") == []
  assert origins_parse("a\nb\n") == ["a", "b"]
  assert origins_render(["a", "b"]) == "a\nb\n"
}

test "tar octal and pax records parse" {
  let b = bytes.utf8("0000644" ++ str.from_char('\u{0000}'))
  assert tar_octal(b, 0, 8) == Ok(420)
  # the length field counts the whole record, its own digits included
  assert pax_path("32 path=some/very/long/name.txt\n") == Some("some/very/long/name.txt")
  assert pax_path("16 uid=1000\n") == None
}

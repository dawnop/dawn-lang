# checker.dawn: where `caller()` may be written (docs/caller-location-design.md
# section 3.2). Only as a parameter's whole default: wrapped in a call, in a
# function body, in a const, or as a value it is refused, and a default of
# the wrong type is the ordinary mismatch. Calls into the dependency omit or
# pass `at` like any defaulted argument.
use lib/check

fn wrapped(at: Loc = id(caller())) -> Loc = at

fn id(l: Loc) -> Loc = l

fn body() -> Loc = caller()

fn taken() -> fn() -> Loc = caller

fn wrong(s: String = caller()) -> String = s

const C: Loc = caller()

fn omitted(n: Int) -> Int = check.positive(n)

fn passed(n: Int, at: Loc = caller()) -> Int = check.positive(n, at: at)

# expect: unclosed `{`	this `{` is probably missing its own `}`	note	733	734	this `}` closes it but is indented differently, so it probably belongs to an outer `{`	note	735	736	expected `}` before the end of the file
# The `if` block is the one missing its `}`. The call above it spans lines and
# its `)` trails the last argument, so that line's indent is its continuation's,
# not the closer's: it says nothing about where the `)` belongs and the call is
# no suspect. Only a closer that starts its line can be misindented. The report
# lands on the `if`'s `{`, the pair whose `}` is the one that really is off.
pub fn main() -> Unit !io = {
  let a = list.fold(
    [1, 2, 3], 0, (s, x) => s + x)
  if a > 0 {
    println("pos")

}

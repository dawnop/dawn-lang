# Builtin names on a bare type RHS are parsed as constructors, then diagnosed
# uniformly by the checker. Valid aliases and an ordinary constructor stay
# silent in the same module.
type AliasInt = Int
type AliasChar = Char
type AliasFloat = Float
type AliasBool = Bool
type AliasString = String
type AliasBytes = Bytes
type AliasUnit = Unit

alias Letter = Char
alias Blob = Bytes
type Color = Red

fn keep_letter(value: Letter) -> Char = value
fn keep_blob(value: Blob) -> Bytes = value
fn red() -> Color = Red

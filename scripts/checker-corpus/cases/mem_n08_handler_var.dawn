# A legal buffer annotation still reaches the handler cell's transport fence.
use std/mem
effect Tick { fn tick() -> Unit }
fn body() -> Unit !Tick = tick()
pub fn held() -> Int = mem.with_mem([@s] () => {
  with handle Tick {
    var h: List[I64Buf@s] = []
    tick() => { h = h }
  }
  body()
  0
})

# Qualified values must lift the real module/package function on both backends.
use std/io
use helper
use paths/fspath as path

fn apply(f: fn(Int) -> Int, x: Int) -> Int = f(x)

fn apply_same[T](f: fn(T) -> T, x: T) -> T = f(x)

fn apply_generic[T, U](f: fn(T) -> U, x: T) -> U = f(x)

fn transform(f: fn(String) -> String, x: String) -> String = f(x)

pub fn main() -> Unit !io = {
  io.println(show(helper.double(3)))
  io.println(show(apply(helper.double, 4)))
  io.println(show(apply(helper.identity, 9)))
  let twice = helper.double
  io.println(show(twice(5)))
  io.println(transform(path.basename, "src/main.dawn"))
  let same = apply_same(helper.identity, 11)
  let generic = apply_generic(helper.identity, 12)
  io.println(show(same))
  io.println(show(generic))
}

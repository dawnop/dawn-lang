# The left side goes in front of the call's written arguments. `cat` is
# asymmetric on purpose: with a commutative function, appending the left side
# and inserting it print the same answer and the assertion would be green for
# the wrong reason.
fn cat(a: String, b: String) -> String = a ++ b

pub fn main() -> Unit !io = println("${"a" |> cat("b")}")

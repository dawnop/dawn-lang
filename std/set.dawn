## The persistent hash set. Insert and remove answer a new set and leave
## the old one intact; elements need `Eq + Hash` (spec §2.2, §11).
#
# Short names, module-qualified at the call site: `use std/set`, then
# `set.insert(s, x)`. Forwards to the compiler primitives over the same Dawn
# hash trie a Map is (std/hamt), exactly like std/map does -- a set is a map to
# a value nobody reads. Bounds follow the same line: finding an element needs
# `[T: Eq + Hash]`, counting and listing them do not.

## A set with no elements. The element type comes from the use site.
pub fn empty[T]() -> Set[T] = set_empty()

## A set from a list; duplicates collapse, first occurrence keeps its position.
pub fn from[T: Eq + Hash](xs: List[T]) -> Set[T] = set_from(xs)

## A copy with `x` added; an existing element keeps its insertion position.
pub fn insert[T: Eq + Hash](s: Set[T], x: T) -> Set[T] = set_insert(s, x)

## A copy without `x`; absent elements are fine.
pub fn remove[T: Eq + Hash](s: Set[T], x: T) -> Set[T] = set_remove(s, x)

## Whether `x` is an element.
pub fn has[T: Eq + Hash](s: Set[T], x: T) -> Bool = set_has(s, x)

## Number of elements.
pub fn len[T](s: Set[T]) -> Int = set_size(s)

## Whether there are no elements. The same question `str.is_empty` answers, in
## the same words (CONTRIBUTING §naming).
pub fn is_empty[T](s: Set[T]) -> Bool = set_size(s) == 0

## The elements, in insertion order.
pub fn to_list[T](s: Set[T]) -> List[T] = set_to_list(s)

# ---- Eq / Hash for Set ----
#
# Same reasoning as Map's, which these are: element order is an artifact of
# insertion, not of the value, so both relations are defined on membership.
# No `Ord[Set[T]]` for the same reason there is none for Map.
#
# As in std/map, the walks take the element count as a parameter: `len` here is
# the set's, declared above, so it does not answer for the list being walked.

fn eq_go[T: Eq + Hash](b: Set[T], xs: List[T], i: Int, n: Int) -> Bool =
  if i == n {
    true
  } else if has(b, xs[i]) {
    eq_go(b, xs, i + 1, n)
  } else {
    false
  }

## Same size, and every element of one an element of the other.
impl[T: Eq + Hash] Eq[Set[T]] {
  fn eq(a: Set[T], b: Set[T]) -> Bool =
    if len(a) != len(b) { false } else { eq_go(b, to_list(a), 0, len(a)) }
}

fn hash_go[T: Hash](xs: List[T], i: Int, n: Int, acc: Int) -> Int =
  if i == n { acc } else { hash_go(xs, i + 1, n, acc + hash(xs[i])) }

## A sum over the elements, order-independent like `eq` above.
impl[T: Hash] Hash[Set[T]] {
  fn hash(s: Set[T]) -> Int = hash_go(to_list(s), 0, len(s), 0)
}

fn show_go[T: Show](xs: List[T], i: Int, n: Int, acc: String) -> String =
  if i == n {
    acc
  } else {
    show_go(xs, i + 1, n, acc ++ (if i == 0 { "" } else { ", " }) ++ show(xs[i]))
  }

## `set.from([e0, e1])`, for the same reason a map renders as `map.from`: the
## rendering names a function the reader can call.
impl[T: Show] Show[Set[T]] {
  fn show(s: Set[T]) -> String = "set.from([" ++ show_go(to_list(s), 0, len(s), "") ++ "])"
}

# ---- iteration (prelude Iter, #44 knife 2) ----

## `for x in s` yields elements in `to_list`'s order (first-occurrence
## insertion order, like every set walk). Same materialised cursor as the
## Map impl, for the same reasons -- see std/map.
impl[T: Eq + Hash] Iter[Set[T]] {
  type Cur = (List[T], Int)
  type Item = T

  fn iter_start(s: Set[T]) -> (List[T], Int) = (to_list(s), 0)
  fn iter_done(s: Set[T], c: (List[T], Int)) -> Bool = {
    let (_es, i) = c
    i >= set_size(s)
  }
  fn iter_next(s: Set[T], c: (List[T], Int)) -> (List[T], Int) = {
    let (es, i) = c
    (es, i + 1)
  }
  fn iter_get(s: Set[T], c: (List[T], Int)) -> T = {
    let (es, i) = c
    es[i]
  }
}

# The insertion-order clause is the one with a caller depending on it:
# `list.unique` is `set`'s ordering, observed from outside, and its promise
# ("every value once, at its first occurrence") is only true while this one is.
# std/list cannot see this module to say so, so it is said here.
#
# As in std/map, `len` is this module's, so the blocks compare whole lists
# rather than asking one for its length.

test "has and remove answer about an element; an absent one is fine" {
  let s: Set[String] = from(["a", "b"])
  assert has(s, "a")
  assert has(s, "b")
  assert not has(s, "zz")
  assert len(s) == 2
  assert not is_empty(s)
  let e: Set[String] = empty()
  assert not has(e, "a")
  assert len(e) == 0
  assert is_empty(e)
  # removing something that is not there answers an equal set, not an error
  assert remove(s, "zz") == s
  assert len(remove(s, "zz")) == 2
  assert remove(e, "a") == e
  assert len(remove(s, "a")) == 1
  assert not has(remove(s, "a"), "a")
  # persistent: the original is untouched
  assert has(s, "a")
  assert len(s) == 2
}

test "insertion order is first occurrence, and insert and remove keep it" {
  # This is what list.unique's promise rests on. Not sorted and not hash
  # order: the order the elements first arrived in.
  let s: Set[String] = from(["b", "a", "c"])
  assert to_list(s) == ["b", "a", "c"]
  # a duplicate collapses onto the *first* occurrence's position, so the
  # earlier arrival is what survives in the ordering
  assert to_list(from(["b", "a", "b", "c", "a"])) == ["b", "a", "c"]
  assert len(from(["b", "a", "b", "c", "a"])) == 3
  # re-inserting an element already there does not move it to the end
  assert to_list(insert(s, "b")) == ["b", "a", "c"]
  assert len(insert(s, "b")) == 3
  # a genuinely new element does go on the end
  assert to_list(insert(s, "d")) == ["b", "a", "c", "d"]
  # removing one leaves the others in their order
  assert to_list(remove(s, "a")) == ["b", "c"]
  assert to_list(remove(s, "b")) == ["a", "c"]
  # ... but a removed element that comes back has lost its place
  assert to_list(insert(remove(s, "b"), "b")) == ["a", "c", "b"]
  let e: Set[String] = empty()
  assert to_list(e) == []
  let nothing: List[String] = []
  assert to_list(from(nothing)) == []
  assert to_list(insert(e, "only")) == ["only"]
  # numbers order by arrival too, not by value
  assert to_list(from([3, 1, 2])) == [3, 1, 2]
}

test "Eq and Hash are about membership, not about arrival order" {
  let a: Set[String] = from(["x", "y"])
  let b: Set[String] = from(["y", "x"])
  let c: Set[String] = remove(from(["x", "y", "z"]), "z")
  assert a == b
  assert a == c
  assert hash(a) == hash(b)
  assert hash(a) == hash(c)
  # ... while each keeps its own walk order
  assert to_list(a) == ["x", "y"]
  assert to_list(b) == ["y", "x"]
  # size counts, so neither a subset nor a superset is equal
  assert not (a == from(["x"]))
  assert not (a == from(["x", "y", "z"]))
  assert not (a == from(["x", "z"]))
  let e1: Set[String] = empty()
  let nothing: List[String] = []
  let e2: Set[String] = from(nothing)
  assert e1 == e2
  assert hash(e1) == hash(e2)
  assert not (e1 == a)
}

test "Show names the call that rebuilds it" {
  let s: Set[String] = from(["b", "a"])
  assert show(s) == "set.from([\"b\", \"a\"])"
  let e: Set[String] = empty()
  assert show(e) == "set.from([])"
  assert show(from(["only"])) == "set.from([\"only\"])"
  assert show(from([2, 1])) == "set.from([2, 1])"
}

test "for over a Set yields every element once, in to_list's order" {
  let s: Set[String] = from(["b", "a", "c"])
  var seen: List[String] = []
  var n = 0
  for x in s {
    seen = seen ++ [x]
    n = n + 1
  }
  assert n == 3
  assert seen == to_list(s)
  assert seen == ["b", "a", "c"]
  let e: Set[String] = empty()
  var empty_steps = 0
  for _x in e { empty_steps = empty_steps + 1 }
  assert empty_steps == 0
}

-- join --
relative       = [a/b/c.dawn]
trailing slash = [a/b/c.dawn]
absolute wins  = [/etc/x]
empty base     = [c.dawn]
empty path     = [a/b]
both empty     = []
at the root    = [/x]
climbing       = [a/c]
past the root  = [/b]
-- basename --
absolute       = [c.dawn]
bare name      = [c.dawn]
trailing slash = [b]
dot segment    = [b]
the root       = []
empty          = []
non-ascii      = [中文.dawn]
-- extension (spec 4.8, criterion 2) --
has one        = [dawn]
has none       = none
dotfile        = none
trailing dot   = none
dot above only = none
two dots       = [gz]
empty          = none
-- with_extension --
replaced       = [src/main.class]
added          = [src/main.class]
removed        = [src/main]
dot above only = [/a.b/c.d]
dotfile kept   = [/a/.gitignore.bak]
two dots       = [a.tar.bz2]

# Or-pattern alternatives bind one shared environment.
type Mixed = IntCase(value: Int) | StringCase(value: String) | Empty

fn missing(v: Mixed) -> Int =
  match v {
    IntCase(x) | Empty -> x
    StringCase(_) -> 0
  }

fn extra(v: Mixed) -> Int =
  match v {
    Empty | IntCase(y) -> 0
    StringCase(_) -> 0
  }

fn different_type(v: Mixed) -> Int =
  match v {
    IntCase(x) | StringCase(x) -> 0
    Empty -> 0
  }

fn refutable_let(flag: Bool) -> Bool = {
  let true | true = flag
  flag
}

fn suppress_type_mismatch(xs: List[Int]) -> Unit = {
  for "wrong" in xs { () }
}

fn suppress_missing_ctor(xs: List[Option[Int]]) -> Unit = {
  for Missing(value) in xs { let _ = value }
}

fn suppress_binding_set(xs: List[Option[Int]]) -> Unit = {
  for Some(value) | None in xs { let _ = value }
}

# Explicit contracts exercise data introduction and nominal boundaries.
use std/mem
type First[T] = Done | Into(second: Second[T])
type Second[T] = { value: T, next: First[List[T]] }
fn attempted() !io = mem.with_mem([@s] () => { let tail: First[List[I64Buf@s]] = Done
  Into(Second { value = mem.new(1), next = tail }) })
pub fn main() -> Unit !io = println("probe")

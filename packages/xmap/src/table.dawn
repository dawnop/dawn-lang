# The call table: which calls of a function there are, where each is in the
# source, and which call is inside which.
#
# Where the table comes from, and why there are two ways. For a plain program
# the table is what the two host maps agree on: the C map and the JVM map each
# say, per call of the source, a span and a name span, and a call is in the
# table when both say it, in the same words. A call one map has and the other
# lacks is a gap and stays out, because a call with an account in one pane and
# none in the other would draw a click that lights half a page. A call's name is
# where its name span starts: an identifier for a call written `f(..)`, and for
# the two written calls that are not (an operator on a type with an `Add` impl,
# a number literal at a type with a `FromFloat` impl, both common in a tileir
# kernel) the operator or the literal, read off what the row says it calls. For a Tile IR
# kernel the table is the recording `site/gpu-map/flash_attn.map` keeps, which
# is packages/tileir's account of the kernel's calls (the host maps cannot say
# which calls the *kernel* made: it runs on the host, and its calls are
# `trace_calls`' to record).
#
# Nesting is read off spans, whatever the recording's own parent says. The
# Tile IR recording's parent is the region a call ran in, which is not what a
# reader means by a call inside a call (`mul(mma(..), ..)`); in C and bytecode
# it is the span that says whose code sits inside whose. A call's parent is the
# innermost other call whose span holds its own.
#
# What it checks, and what a failed check is. Every check returns a message
# naming the call, never a panic and never a silent fix: the strict entry
# (xmap.explore_strict) refuses a table with any, the degrading entry reports
# them as gaps and leaves the table as it is.

use std/str
use std/list
use std/set
use dawnmap.{CMap, JMap}
use source.{Src, src_of, at, off, pos, ident_at, text_between}

## One call of the table. `id` is its row (source order, from 0) and `parent`
## the row of the call that holds it, -1 at the top. The span `[lo, hi)` and
## the name's `[nlo, nhi)` are code point offsets into the source. `lines` is
## what the Tile IR recording says the call wrote (`a-b` words), empty
## otherwise. `defn` is the `[lo, hi)` of the definition of what the call ran
## when that is a function written in this source (a helper), else `(-1, -1)`:
## a helper's own calls lie in that span, not in the call that ran it.
pub type Call = { id: Int, parent: Int, name: String, lo: Int, hi: Int, nlo: Int, nhi: Int, defn: (Int, Int), lines: List[String] }

## A call row of `flash_attn.map`, before its positions are offsets.
pub type TileCall = { id: Int, parent: Int, name: String, lo: (Int, Int), hi: (Int, Int), nlo: (Int, Int), nhi: (Int, Int),
  defn: Option[((Int, Int), (Int, Int))], lines: List[String] }

## `flash_attn.map` read: the revision of the source it was recorded from, the
## lines `first` to `last` of the kernel's source its function is on, and its
## calls.
pub type TileMap = { source: String, first: Int, last: Int, calls: List[TileCall] }

# ---- the Tile IR recording ----

fn parse_pos(s: String) -> Option[(Int, Int)] =
  match str.split_once(s, ":") {
    Some((a, b)) ->
      match (parse_int(a), parse_int(b)) {
        (Some(x), Some(y)) -> Some((x, y))
        _ -> None
      }
    None -> None
  }

fn parse_span(s: String) -> Option[((Int, Int), (Int, Int))] =
  match str.split_once(s, "-") {
    Some((a, b)) ->
      match (parse_pos(a), parse_pos(b)) {
        (Some(x), Some(y)) -> Some((x, y))
        _ -> None
      }
    None -> None
  }

## `flash_attn.map` as a `TileMap`, or why `text` is not one. The calls `var_open`,
## `var_get` and `var_set` are what a `var` is to the Tile IR (its loop arguments, its
## reads, its assignments): a host map has no call for any of them, they wrote
## no Tile IR line of their own, and a click on one would light nothing, so
## they are left out.
pub fn parse_tile_map(text: String) -> Result[TileMap, String] = {
  let rows = map(filter(str.split(text, "\n"), l => l != ""), l => str.split(l, " "))
  let fnrow = list.find(rows, w => w[0] == "fn")
  let sources = filter(rows, w => w[0] == "source")
  if len(sources) != 1 || len(sources[0]) != 2 || sources[0][1] == "" {
    return Err("the recording names no source revision")
  }
  var calls: List[TileCall] = []
  for w in rows {
    if w[0] == "call" && len(w) >= 6 && not list.contains(["var_open", "var_get", "var_set"], w[3]) {
      let has_def = len(w) >= 7 && str.starts_with(w[6], "def=")
      let defn: Option[((Int, Int), (Int, Int))] = if has_def { parse_span(str.drop(w[6], 4)) } else { None }
      if has_def && defn == None { return Err("not a definition span: ${w[6]}") }
      match (parse_span(w[4]), parse_span(w[5]), parse_int(w[1]), parse_int(w[2])) {
        (Some((a, b)), Some((na, nb)), Some(id), Some(parent)) -> {
          if parent < -1 || parent >= id || list.any(calls, c => c.id >= id) { return Err("invalid recorded call identity or parent") }
          calls = calls ++ [TileCall { id = id, parent = parent, name = w[3], lo = a, hi = b, nlo = na, nhi = nb, defn = defn,
            lines = list.drop(w, if has_def { 7 } else { 6 }) }]
        }
        _ -> {
          return Err("not a call row: ${join(w, " ")}")
        }
      }
    }
  }
  match fnrow {
    Some(w) ->
      if len(w) < 2 {
        Err("the fn row has no lines")
      } else {
        match str.split_once(w[1], "-") {
          Some((a, b)) ->
            match (parse_int(a), parse_int(b)) {
              (Some(x), Some(y)) -> Ok(TileMap { source = sources[0][1], first = x, last = y, calls = calls })
              _ -> Err("the fn row's lines are not numbers: ${w[1]}")
            }
          None -> Err("the fn row's lines are not a range: ${w[1]}")
        }
      }
    None -> Err("the recording has no fn row")
  }
}

# ---- the tree ----

fn by_span(a: Call, b: Call) -> Int = if a.lo != b.lo { a.lo - b.lo } else if a.hi != b.hi { b.hi - a.hi } else { a.nlo - b.nlo }

fn holds(p: Call, r: Call) -> Bool = p.lo <= r.lo && r.hi <= p.hi && not (p.lo == r.lo && p.hi == r.hi)

# The first of `ps` with the shortest span.
fn narrowest(ps: List[Call]) -> Call = list.fold(list.drop(ps, 1), ps[0], (best, p) => if p.hi - p.lo < best.hi - best.lo { p } else { best })

## `rows` in source order, numbered from 0, each with its innermost enclosing
## call by span as its parent.
pub fn tree(rows: List[Call]) -> List[Call] = {
  let sorted = sort_by(rows, by_span)
  let numbered = map(range(0, len(sorted)), i => Call { ..sorted[i], id = i })
  map(numbered, r => {
    let holders = filter(numbered, p => holds(p, r))
    Call { ..r, parent = if len(holders) == 0 { -1 } else { narrowest(holders).id } }
  })
}

## The calls of the Tile IR recording as the table, in the source's own
## coordinates, or why the recording is not of this source. `revision` is the
## caller's own digest of `src`; a recording of another revision, or a
## definition span that is not inside the source, is refused, never mapped.
pub fn table_from_tile(src: Src, revision: String, t: TileMap) -> Result[List[Call], String] = {
  if revision == "" { return Err("the source has no revision to hold the recording to") }
  if t.source != revision { return Err("the recording is of another revision of the source") }
  var raw: List[Call] = []
  for c in t.calls {
    let (l0, c0) = c.lo
    let (l1, c1) = c.hi
    let (n0, m0) = c.nlo
    let (n1, m1) = c.nhi
    var defn = (-1, -1)
    match c.defn {
      Some(((d0, e0), (d1, e1))) -> {
        if d0 < 1 || d1 > len(src.lines) || d0 > d1 { return Err("the definition of `${c.name}` is outside the source") }
        defn = (off(src, d0, e0), off(src, d1, e1))
      }
      None -> ()
    }
    raw = raw ++ [Call { id = c.id, parent = c.parent, name = c.name, lo = off(src, l0, c0), hi = off(src, l1, c1),
      nlo = off(src, n0, m0), nhi = off(src, n1, m1), defn = defn, lines = c.lines }]
  }
  # A recorded parent holds its child in the call's own span or, for a helper,
  # in the definition the recording names; anything else is a recording that
  # does not describe this source.
  for c in raw {
    if c.parent >= 0 {
      match list.find(raw, p => p.id == c.parent) {
        Some(p) -> {
          if not ((p.lo <= c.lo && c.hi <= p.hi) || within_definition(p, c)) {
            return Err("call ${c.id} (`${c.name}`) is inside neither the span nor the definition of its recorded parent")
          }
        }
        None -> {
          return Err("call ${c.id} (`${c.name}`) has a recorded parent that is not a call of the table")
        }
      }
    }
  }
  let sorted = sort_by(raw, by_span)
  let lexical = tree(raw)
  Ok(map(range(0, len(sorted)), i => {
    let c = sorted[i]
    let parent = list.find(range(0, len(sorted)), j => sorted[j].id == c.parent && within_definition(sorted[j], c))
    match parent { Some(j) -> Call { ..lexical[i], parent = j }
      None -> lexical[i] }
  }))
}

# ---- the host maps ----

fn key_of(lo: Option[Int], hi: Option[Int], nlo: Option[Int]) -> (Int, Int, Int) = (unwrap_or(lo, -1), unwrap_or(hi, -1), unwrap_or(nlo, -1))

# The `(lo, hi, nlo)` of each call of `module` that lies on lines `first` to
# `last` of the source, once each.
fn c_keys(src: Src, module: String, first: Int, last: Int, m: CMap) -> List[(Int, Int, Int)] = {
  let rows = filter(m.calls, r => r.module == module && r.lo != None)
  let inside = filter(rows, r => {
    let (l, _c) = at(src, unwrap_or(r.lo, 0))
    first <= l && l <= last
  })
  list.unique(map(inside, r => key_of(r.lo, r.hi, r.nlo)))
}

fn j_keys(src: Src, module: String, first: Int, last: Int, m: JMap) -> List[(Int, Int, Int)] = {
  let rows = filter(m.calls, r => r.module == module && r.lo != None)
  let inside = filter(rows, r => {
    let (l, _c) = at(src, unwrap_or(r.lo, 0))
    first <= l && l <= last
  })
  list.unique(map(inside, r => key_of(r.lo, r.hi, r.nlo)))
}

# What the row of key `k` calls, as the map says it (`impl mul`, `direct m.f`),
# when every row of `module` with that key says the same; "" otherwise.
fn what_of(rows: List[String]) -> String = if len(rows) > 0 && list.all(rows, w => w == rows[0]) { rows[0] } else { "" }

fn c_what(m: CMap, module: String, k: (Int, Int, Int)) -> List[String] =
  map(filter(m.calls, r => r.module == module && key_of(r.lo, r.hi, r.nlo) == k), r => r.what)

fn j_what(m: JMap, module: String, k: (Int, Int, Int)) -> List[String] =
  map(filter(m.calls, r => r.module == module && key_of(r.lo, r.hi, r.nlo) == k), r => r.what)

# The operator each arithmetic trait method is written as.
fn op_of(method: String) -> String =
  match method {
    "add" -> "+"
    "sub" -> "-"
    "mul" -> "*"
    "div" -> "/"
    "rem" -> "%"
    "neg" -> "-"
    _ -> ""
  }

fn digit(c: String) -> Bool = str.contains("0123456789", c)

# Whether `text` is a number as a literal is written: digits first (after a
# `-` for the negative literal `-0.0`), then digits, `.`, `_`, an exponent or a
# letter of a radix prefix, and no space.
fn number_text(text: String) -> Bool = {
  let body = if str.starts_with(text, "-") { str.drop(text, 1) } else { text }
  len(body) > 0 && digit(str.take(body, 1)) && list.all(str.chars(body), ch => digit(ch) || str.contains("._eE+-xXoObBabcdefABCDEF", ch))
}

## The name and name span of a call whose name span starts at no identifier,
## when what the row calls says how such a call is written. The compilers
## record a written call that is not spelled `f(..)` in two shapes
## (docs/source-span-map-design.md section 4, docs/literal-system-design.md
## D4): an operator on a type with an `Add`..`Neg` impl, its name the operator
## token (`a * b` is `impl mul`, its name at the `*`), and a number literal
## at a type with a `FromInt`/`FromFloat` impl, its name the literal itself
## (`0.0` where a tile is expected is `impl from_float`, `nlo` its start). The
## name is the method's, as the Tile IR recording names the same call; the
## format keeps only the start of a name, so its end is the token's.
pub fn unspelled_name(src: Src, lo: Int, hi: Int, nlo: Int, what: String) -> Option[(String, Int)] = {
  let words = str.split(what, " ")
  # a trait method, however it was resolved; a `direct` call is spelled by
  # the name of the function it calls
  if len(words) != 2 || not list.contains(["impl", "default", "method"], words[0]) {
    return None
  }
  let method = words[1]
  let op = op_of(method)
  if op != "" && text_between(src, nlo, nlo + len(op)) == op && lo <= nlo && nlo + len(op) <= hi {
    return Some((method, nlo + len(op)))
  }
  if (method == "from_int" || method == "from_float") && nlo == lo && number_text(text_between(src, lo, hi)) {
    return Some((method, hi))
  }
  None
}

fn by_key(a: (Int, Int, Int), b: (Int, Int, Int)) -> Int = {
  let (alo, ahi, anlo) = a
  let (blo, bhi, bnlo) = b
  if alo != blo { alo - blo } else if ahi != bhi { bhi - ahi } else { anlo - bnlo }
}

## The calls of `module` on lines `first` to `last` that both host maps have a
## row for, in source order with the tree read off their spans, and a message
## for each call only one of the maps has.
pub fn table_from_maps(src: Src, module: String, first: Int, last: Int, c: CMap, j: JMap) -> (List[Call], List[String]) = {
  let ck = c_keys(src, module, first, last, c)
  let jk = j_keys(src, module, first, last, j)
  let cs = set.from(ck)
  let js = set.from(jk)
  let both = filter(sort_by(ck, by_key), k => set.has(js, k))
  var gaps: List[String] = []
  for k in sort_by(filter(ck, k => not set.has(js, k)), by_key) {
    let (lo, _hi, _nlo) = k
    gaps = gaps ++ ["the call at ${pos(at(src, lo))} has a row in the c map and not in the other"]
  }
  for k in sort_by(filter(jk, k => not set.has(cs, k)), by_key) {
    let (lo, _hi, _nlo) = k
    gaps = gaps ++ ["the call at ${pos(at(src, lo))} has a row in the jvm map and not in the other"]
  }
  var rows: List[Call] = []
  for k in both {
    let (lo, hi, nlo) = k
    match ident_at(src, nlo) {
      Some(name) -> {
        rows = rows ++ [Call { id = 0, parent = -1, name = name, lo = lo, hi = hi, nlo = nlo, nhi = nlo + len(name), defn = (-1, -1), lines = [] }]
      }
      None -> {
        let cw = what_of(c_what(c, module, k))
        let named: Option[(String, Int)] = if cw != "" && cw == what_of(j_what(j, module, k)) { unspelled_name(src, lo, hi, nlo, cw) } else { None }
        match named {
          Some((name, nhi)) -> {
            rows = rows ++ [Call { id = 0, parent = -1, name = name, lo = lo, hi = hi, nlo = nlo, nhi = nhi, defn = (-1, -1), lines = [] }]
          }
          None -> {
            gaps = gaps ++ ["the call at ${pos(at(src, lo))} has its name at ${pos(at(src, nlo))}, which is no identifier"]
          }
        }
      }
    }
  }
  (tree(rows), gaps)
}

## The calls recorded by C alone. A zero-gap table says nothing about the
## other backend; the paired oracle above deliberately keeps its own rules.
pub fn table_from_c(src: Src, module: String, first: Int, last: Int, c: CMap) -> (List[Call], List[String]) = {
  var rows: List[Call] = []
  var gaps: List[String] = []
  for k in sort_by(c_keys(src, module, first, last, c), by_key) {
    let (lo, hi, nlo) = k
    let named = match ident_at(src, nlo) {
      Some(name) -> Some((name, nlo + len(name)))
      None -> {
        let what = what_of(c_what(c, module, k))
        if what == "" { None } else { unspelled_name(src, lo, hi, nlo, what) }
      }
    }
    match named {
      Some((name, nhi)) -> {
        rows = rows ++ [Call { id = 0, parent = -1, name = name, lo = lo, hi = hi, nlo = nlo, nhi = nhi, defn = (-1, -1), lines = [] }]
      }
      None -> {
        gaps = gaps ++ ["the call at ${pos(at(src, lo))} has its name at ${pos(at(src, nlo))}, which is no identifier"]
      }
    }
  }
  (tree(rows), gaps)
}

# ---- checking it ----

## Whether the source text at a call's name span is how that call is spelled:
## the callee's own name, an operator for the arithmetic calls (`a + b` is
## `add`, `addi`...), or, for the three calls a `var` makes (`var_open`
## where a loop opens it, `var_get` where it is read, `var_set` where it is assigned),
## the variable's name or the loop's `for`, and a staged `for` is spelled by the
## range constructor it loops over (`d_range`). A `from_float` is also spelled by the bare
## number it was made from (`mma(a, b, 0.0)`), which has no call of its own.
pub fn spelled(name: String, text: String) -> Bool = {
  if text == name {
    return true
  }
  if (name == "from_int" || name == "from_float") && number_text(text) {
    return true
  }
  if list.contains(["var_open", "var_get", "var_set", "staged_for"], name) {
    return text != ""
  }
  let ops = [("add", "+"), ("sub", "-"), ("mul", "*"), ("div", "/"), ("rem", "%"), ("neg", "-")]
  list.any(ops, o => {
    let (stem, op) = o
    str.starts_with(name, stem) && text == op
  })
}

# A helper's own calls lie in its definition, not in the call that ran it. The
# relation holds for any function the recording names a definition span for,
# and for nothing else: there is no list of helper names.
fn within_definition(p: Call, c: Call) -> Bool = {
  let (dlo, dhi) = p.defn
  dlo >= 0 && dlo <= c.lo && c.hi <= dhi
}

## What is wrong with `table` as a table of the function on lines `first` to
## `last` of `src`, one message for each fault, in call order.
pub fn check_table(src: Src, table: List[Call], first: Int, last: Int) -> List[String] = {
  var gaps: List[String] = []
  for c in table {
    let (l0, _a) = at(src, c.lo)
    let (l1, _b) = at(src, c.hi)
    let who = "call ${c.id} (`${c.name}`)"
    if not (first <= l0 && l1 <= last) {
      gaps = gaps ++ ["${who} is outside the function"]
    }
    let written = text_between(src, c.nlo, c.nhi)
    if not spelled(c.name, written) {
      gaps = gaps ++ ["${who}: the text at ${pos(at(src, c.nlo))} is ${repr(written)}"]
    }
    if not (c.lo <= c.nlo && c.nhi <= c.hi) {
      gaps = gaps ++ ["${who}: its name is outside its span"]
    }
    if c.parent >= 0 {
      let p = table[c.parent]
      if not ((p.lo <= c.lo && c.hi <= p.hi) || within_definition(p, c)) {
        gaps = gaps ++ ["${who} is not inside its parent's span"]
      }
    }
  }
  gaps
}

# A string as Python's repr writes one, for the cases that happen: single
# quotes unless the text holds one and no double quote.
fn repr(s: String) -> String =
  if str.contains(s, "'") && not str.contains(s, "\"") { "\"${s}\"" } else { "'${esc(s)}'" }

fn esc(s: String) -> String = str.replace(str.replace(str.replace(str.replace(s, "\\", "\\\\"), "\n", "\\n"), "\t", "\\t"), "'", "\\'")

## The row numbers of the calls each call holds directly, by row.
pub fn children_of(table: List[Call]) -> List[List[Int]] =
  map(table, c => map(filter(table, k => k.parent == c.id), k => k.id))

fn sample_map() -> String =
  "source r1\n"
  ++ "fn 4-9 flash\n"
  ++ "call 0 -1 mul 5:3-5:21 5:13-5:14 1-3\n"
  ++ "call 1 0 mma 5:3-5:12 5:3-5:6 4-6\n"
  ++ "call 2 0 get 6:3-6:4 6:3-6:4 4-6\n"
  ++ "call 3 -1 add 7:3-7:8 7:5-7:6 6-7\n"

fn sample_src() -> Src = src_of("\n\n\nfn f(a) = {\n  mma(a, b) * lit(a)\n  a\n  x + y\n}\n")

test "the Tile IR recording is read, var calls left out, and nested by span" {
  match parse_tile_map(sample_map()) {
    Err(e) -> { assert e == "" }
    Ok(t) -> {
      assert (t.first, t.last) == (4, 9)
      assert map(t.calls, c => c.name) == ["mul", "mma", "add"]
      let table = mapped(sample_src(), t)
      assert map(table, c => (c.name, c.parent)) == [("mul", -1), ("mma", 0), ("add", -1)]
    }
  }
}

test "a call that wrote no Tile IR line is still a call of the recording" {
  match parse_tile_map("source r1\nfn 4-9 f\ncall 0 -1 from_float 5:3-5:8 5:3-5:6\ncall 1 -1 mul 5:9-5:12 5:9-5:12 1-2\n") {
    Ok(t) -> {
      assert map(t.calls, c => (c.name, len(c.lines))) == [("from_float", 0), ("mul", 1)]
    }
    Err(e) -> { assert e == "" }
  }
  assert is_err(parse_tile_map("source r1\ncall 0 -1 from_float 5:3-5:8 5:3-5:6\n"))
  assert is_err(parse_tile_map("source r1\nfn 4-9 f\ncall 0 -1 lit x 5:3-5:6\n"))
}

fn mapped(src: Src, t: TileMap) -> List[Call] =
  match table_from_tile(src, "r1", t) {
    Ok(table) -> table
    Err(e) -> panic(e)
  }

fn is_err[A](r: Result[A, String]) -> Bool =
  match r {
    Err(_) -> true
    Ok(_) -> false
  }

test "a call inside another's span has it as its parent, the innermost one" {
  let src = sample_src()
  let outer = Call { id = 0, parent = -1, name = "f", lo = 10, hi = 40, nlo = 10, nhi = 11, defn = (-1, -1), lines = [] }
  let mid = Call { ..outer, name = "g", lo = 12, hi = 30, nlo = 12, nhi = 13 }
  let inner = Call { ..outer, name = "h", lo = 14, hi = 20, nlo = 14, nhi = 15 }
  let t = tree([inner, outer, mid])
  assert map(t, c => (c.name, c.id, c.parent)) == [("f", 0, -1), ("g", 1, 0), ("h", 2, 1)]
  assert children_of(t) == [[1], [2], []]
  assert len(src.lines) > 0
}

test "a name is spelled as itself, an operator or a var's own name" {
  assert spelled("mma", "mma")
  assert spelled("add", "+")
  assert spelled("rem", "%")
  assert spelled("var_get", "x")
  assert not spelled("var_get", "")
  assert spelled("from_float", "0.0")
  assert spelled("from_float", "2")
  assert not spelled("from_float", "x")
  assert not spelled("mma", "0.0")
  assert not spelled("mma", "mmb")
  assert not spelled("mul", "+")
}

test "a table is checked against the source it names" {
  let src = sample_src()
  match parse_tile_map(sample_map()) {
    Err(e) -> { assert e == "" }
    Ok(t) -> {
      let table = mapped(src, t)
      assert check_table(src, table, 4, 9) == []
      assert len(check_table(src, table, 8, 9)) > 0
      let moved = map(table, c => if c.name == "mma" { Call { ..c, nlo = c.nlo + 1, nhi = c.nhi + 1 } } else { c })
      assert str.contains(check_table(src, moved, 4, 9)[0], "the text at 5:4 is")
    }
  }
}

test "an operator or a literal that the maps record as a call is named by its method" {
  let src = src_of("fn f(a, b) = a * b - -0.0 + c\n")
  assert unspelled_name(src, 13, 18, 15, "impl mul") == Some(("mul", 16))
  assert unspelled_name(src, 13, 25, 19, "impl sub") == Some(("sub", 20))
  assert unspelled_name(src, 21, 25, 21, "impl from_float") == Some(("from_float", 25))
  # the operator is not the one the method is written as, or not where the
  # row says, or the literal is not a number: still no name
  assert unspelled_name(src, 13, 18, 15, "impl add") == None
  assert unspelled_name(src, 13, 18, 16, "impl mul") == None
  assert unspelled_name(src, 13, 18, 13, "impl from_float") == None
  assert unspelled_name(src, 13, 18, 15, "direct m.mul") == None
  assert unspelled_name(src, 13, 18, 15, "default mul") == Some(("mul", 16))
  assert spelled("from_float", "-0.0")
  assert spelled("from_int", "3")
  assert not spelled("from_int", "x")
  assert spelled("rem", "%")
}

fn helper_text() -> String = "fn fa_exp(x: Int) -> Int = {\n  exp(x)\n}\nfn kernel() -> Unit = {\n  fa_exp(1)\n  fa_exp(2)\n}\n"

fn helper_raw(source: String, def: String) -> String =
  "kernel kernel\n" ++ source ++ "fn 1-7\nops 2\nhead 1-2\n"
  ++ "call 0 -1 fa_exp 5:3-5:12 5:3-5:9 ${def}\ncall 1 0 exp 2:3-2:9 2:3-2:6 2-3\n"
  ++ "call 2 -1 fa_exp 6:3-6:12 6:3-6:9 ${def}\ncall 3 2 exp 2:3-2:9 2:3-2:6 3-4\ntail 4-5\n"

test "helper calls keep two invocation parents for one definition span, by the recorded definition" {
  let src = src_of(helper_text())
  match parse_tile_map(helper_raw("source r1\n", "def=1:1-3:2")) {
    Err(e) -> panic(e)
    Ok(t) -> {
      let table = mapped(src, t)
      assert check_table(src, table, 1, 7) == []
      let exps = filter(table, c => c.name == "exp")
      assert len(exps) == 2 && exps[0].lo == exps[1].lo
      assert exps[0].parent != exps[1].parent
      assert list.all(exps, c => c.parent >= 0 && table[c.parent].name == "fa_exp")
      let broken = map(table, c => if c.name == "exp" { Call { ..c, lo = off(src, 7, 1), hi = off(src, 7, 2), nlo = off(src, 7, 1), nhi = off(src, 7, 2) } } else { c })
      assert len(check_table(src, broken, 1, 7)) > 0
    }
  }
}

test "the relation names no helpers: another function with a definition span gets it, one without gets none" {
  # the same recording but for a function called `my_exp` instead of fa_exp
  let text = "fn my_exp(x: Int) -> Int = {\n  exp(x)\n}\nfn kernel() -> Unit = {\n  my_exp(1)\n  my_exp(2)\n}\n"
  let raw = str.replace(helper_raw("source r1\n", "def=1:1-3:2"), "fa_exp", "my_exp")
  match parse_tile_map(raw) {
    Err(e) -> panic(e)
    Ok(t) -> {
      let table = mapped(src_of(text), t)
      assert check_table(src_of(text), table, 1, 7) == []
      assert list.all(filter(table, c => c.name == "exp"), c => c.parent >= 0 && table[c.parent].name == "my_exp")
    }
  }
  # without a recorded definition the same rows are not inside their parents and the recording is refused
  match parse_tile_map(helper_raw("source r1\n", "")) {
    Err(e) -> panic(e)
    Ok(t) -> {
      assert is_err(table_from_tile(src_of(helper_text()), "r1", t))
    }
  }
}

test "a recording with no source revision, or of another one, or with a definition off the source, is refused" {
  assert is_err(parse_tile_map(helper_raw("", "def=1:1-3:2")))
  assert is_err(parse_tile_map(helper_raw("source \n", "def=1:1-3:2")))
  assert is_err(parse_tile_map(helper_raw("source r1\nsource r2\n", "def=1:1-3:2")))
  match parse_tile_map(helper_raw("source r2\n", "def=1:1-3:2")) {
    Err(e) -> panic(e)
    Ok(t) -> {
      assert is_err(table_from_tile(src_of(helper_text()), "r1", t))
      assert is_err(table_from_tile(src_of(helper_text()), "", t))
    }
  }
  match parse_tile_map(helper_raw("source r1\n", "def=1:1-9:2")) {
    Err(e) -> panic(e)
    Ok(t) -> { assert is_err(table_from_tile(src_of(helper_text()), "r1", t)) }
  }
  assert is_err(parse_tile_map(helper_raw("source r1\n", "def=1:1-x")))
}

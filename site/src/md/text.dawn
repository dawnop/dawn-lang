# Shared code-point level text helpers for the Markdown parser.

use std/str

## The character at i, or NUL past the end.
##
## The sentinel used to be -1, which stopped being spellable when a character
## became its own type: `Char` has no value outside the code points, which is
## the whole of what the type says. NUL works here because nothing ever asks
## whether the answer *is* the sentinel -- every caller compares it against a
## markup character, and NUL is none of them.
pub fn cp_at(cs: List[Char], i: Int) -> Char = unwrap_or(get(cs, i), '\u{0000}')

## The substring [from, to) of a code point list.
pub fn seg(cs: List[Char], from: Int, to: Int) -> String = {
  var out: List[Char] = []
  var i = from
  while i < to {
    out = out ++ [cp_at(cs, i)]
    i = i + 1
  }
  from_code_points(out)
}

## Number of leading spaces.
pub fn indent_of(s: String) -> Int = {
  let cs = code_points(s)
  var i = 0
  while i < len(cs) && cp_at(cs, i) == ' ' {
    i = i + 1
  }
  i
}

## Strip up to n leading spaces.
pub fn strip_indent(s: String, n: Int) -> String = {
  let k = indent_of(s)
  if k < n { str.drop(s, k) } else { str.drop(s, n) }
}

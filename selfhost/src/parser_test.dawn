# Unit tests for the self-hosted parser. The exhaustive acceptance test is the
# golden diff (scripts/selfhost-prev-diff.sh, byte-identical to the previous release's `__parse`
# over the whole repo corpus); these are fast structural checks for the shapes
# that carry the most parser logic — rewrites, recovery, precedence.

use std/str
use parser.{parse_module}
use astdump.{render_module}
use ast.{
  Expr, EInt, EVar, EApply, EBinary, ECtor, EBlock,
  BinOp, OpAdd, OpMul,
  Stmt, SWhile,
  Decl, DFn, DConst, DUseModule, DImpl, Module,
  TypeRef, TQual, TNamed
}

fn rendered(src: String) -> String = {
  let (m, ds) = parse_module(src)
  render_module(m, ds)
}

test "a function declaration parses to one decl" {
  let (m, ds) = parse_module("fn f(x: Int) -> Int = x")
  assert len(ds) == 0
  assert len(m.decls) == 1
  match m.decls[0] {
    DFn(f) -> {
      assert f.name == "f"
      assert len(f.params) == 1
      assert f.params[0].name == "x"
    }
    _ -> { assert false }
  }
}

test "multiplication binds tighter than addition" {
  let (m, ds) = parse_module("const A: Int = 1 + 2 * 3")
  match m.decls[0] {
    DConst(name, is_pub, ann, init, lo, hi, nlo, nhi) ->
      match init {
        EBinary(op, left, right, olo, ohi, xlo, xhi) -> {
          assert op == OpAdd
          match right {
            EBinary(op2, l2, r2, a, b, c, d) -> { assert op2 == OpMul }
            _ -> { assert false }
          }
        }
        _ -> { assert false }
      }
    _ -> { assert false }
  }
}

test "pipe rewrites into a call with the left side first" {
  let (m, ds) = parse_module("fn f() = x |> g(y)")
  match m.decls[0] {
    DFn(f) ->
      match f.body {
        EApply(callee, args, c, d) -> {
          match callee {
            EVar(n, a, b) -> { assert n == "g" }
            _ -> { assert false }
          }
          assert len(args) == 2
          match args[0].e {
            EVar(n, e2, f2) -> { assert n == "x" }
            _ -> { assert false }
          }
        }
        _ -> { assert false }
      }
    _ -> { assert false }
  }
  # the pipe still only takes a named call, a bare name or a lambda on the
  # right: a construction or an applied call result is an error, as before
  let (_, ds2) = parse_module("fn f() = x |> Some(1)")
  assert len(ds2) > 0
  let (_, ds3) = parse_module("fn f() = x |> make()(1)")
  assert len(ds3) > 0
}

test "every call is one application node" {
  # `f(x)` and `Circle(1.0)` had a parse special case each; both are gone, so
  # both are an Apply over whatever the callee spelling parses to (SYN-02)
  let out = rendered("fn f() = g(1)")
  assert str.contains(out, "Apply nargs=1")
  assert str.contains(out, "Var g ")
  let out2 = rendered("fn f() = Some(1)")
  assert str.contains(out2, "Apply nargs=1")
  assert str.contains(out2, "CtorCall Some parens=false")
  # a record literal is not an application -- braces, not parens
  let out3 = rendered("fn f() = Point { x: 1 }")
  assert not str.contains(out3, "Apply")
  assert str.contains(out3, "CtorCall Point parens=true")
}

test "an argument may be named at every call position" {
  # `IDENT: expr` is grammatical wherever arguments are (SYN-03). Whether the
  # callee accepts names is a type question, so none of these is a parse error.
  for src in [
    "fn f() = Rect(2.0, h: 3.0)",
    "fn f() = g(h: 1)",
    "fn f() = x.m(h: 1)",
    "fn f() = make()(h: 1)",
    "fn f() = m.C(h: 1)"
  ] {
    let (_, ds2) = parse_module(src)
    assert len(ds2) == 0
  }
  assert str.contains(rendered("fn f() = g(h: 1)"), "Arg name=h")
  assert str.contains(rendered("fn f() = x.m(h: 1)"), "Arg name=h")
}

test "a `(` on the next line is not a call" {
  # spec 4.3: a newline ends the postfix chain (only `.` continues one), so
  # this is a let, a parenthesized expression statement, and a tail
  let out = rendered("fn f() -> Int = {\n  let x = g\n  (1 + 2)\n  x\n}\n")
  assert not str.contains(out, "Apply")
  assert str.contains(out, "Binary ADD")
}

test "a broken declaration is reported and the next one still parses" {
  let (m, ds) = parse_module("fn f( = 1\n\nfn g() = 2")
  assert len(ds) > 0
  match m.decls[len(m.decls) - 1] {
    DFn(f) -> { assert f.name == "g" }
    _ -> { assert false }
  }
}

test "a binary operator may lead its continuation line" {
  # && at the start of the next line continues the expression (spec §1.7)
  let (m, ds) = parse_module("const A: Bool = x\n  && y")
  assert len(ds) == 0
  match m.decls[0] {
    DConst(name, is_pub, ann, init, lo, hi, nlo, nhi) ->
      match init {
        EBinary(op, l, r, a, b, c, d) -> ()
        _ -> { assert false }
      }
    _ -> { assert false }
  }
  # comparison and concat lead too
  let (m2, ds2) = parse_module("const B: Bool = x\n  == y")
  assert len(ds2) == 0
  let (m3, ds3) = parse_module("const C: String = x\n  ++ y")
  assert len(ds3) == 0
}

test "leading `-` does not continue (ambiguous with unary minus)" {
  # unlike &&, a `-` at line start starts fresh — here `- y` strands at top level
  let (m, ds) = parse_module("const A: Int = x\n  - y")
  assert len(ds) > 0
}

test "a bare assignment arm is reported and later arms/decls still parse" {
  # `A -> q = 1` has a bare assignment body; the arm resyncs, the `B` arm and the
  # following `g` both still parse — no cascade to end of file.
  let (m, ds) = parse_module("fn f() = match x {\n  A -> q = 1\n  B -> 2\n}\n\nfn g() = 3")
  assert len(ds) > 0
  assert str.contains(ds[0].hint, "braces")
  match m.decls[len(m.decls) - 1] {
    DFn(f) -> { assert f.name == "g" }
    _ -> { assert false }
  }
}

test "a keyword may be a member name after `.`" {
  # Java members can be named with Dawn keywords (`System.in`, `x.type`); after
  # `.` a keyword is unambiguously a member name, not syntax (spec §9.1).
  let out = rendered("fn f() = x.in")
  assert str.contains(out, "FieldAccess in")
  # the method form with a keyword name parses too
  let out2 = rendered("fn g() = x.type()")
  assert str.contains(out2, "MethodCall type")
  # a non-word after `.` is still an error
  let (m, ds) = parse_module("fn h() = x.42")
  assert len(ds) > 0
}

test "chained comparisons are an error" {
  let (m, ds) = parse_module("fn f() = a < b < c")
  assert len(ds) > 0
  assert ds[0].msg == "comparison operators cannot be chained"
  assert ds[0].hint == "write a < b && b < c"
}

test "interpolation holds a parsed expression" {
  let out = rendered("const A: String = \"x=\${1 + 2}\"")
  assert str.contains(out, "SInterp")
  assert str.contains(out, "Binary ADD")
}

test "a header expression refuses a record literal" {
  # `while C { g() }` — C stays a bare constructor and the brace opens the body
  let (m, ds) = parse_module("fn f() -> Unit = { while C { g() } }")
  assert len(ds) == 0
  match m.decls[0] {
    DFn(f) ->
      match f.body {
        EBlock(stmts, tail, a, b) ->
          match stmts[0] {
            SWhile(cond, body, c, d) ->
              match cond {
                ECtor(name, args, spread, has_parens, e2, f2, g2, h2) -> {
                  assert name == "C"
                  assert has_parens == false
                }
                _ -> { assert false }
              }
            _ -> { assert false }
          }
        _ -> { assert false }
      }
    _ -> { assert false }
  }
}

test "use ... as binds an explicit alias" {
  let (m, ds) = parse_module("use json/lexer as lex\n\nfn f() = 1")
  assert len(ds) == 0
  match m.decls[0] {
    DUseModule(segs, sel, aname, a, b, c, d) -> {
      assert segs == ["json", "lexer"]
      match aname {
        Some(n) -> { assert n.name == "lex" }
        None -> { assert false }
      }
    }
    _ -> { assert false }
  }
}

test "a module-qualified type parses in type position" {
  # `m.T` — a lowercase name in type position can only be a module alias
  let (m, ds) = parse_module("fn f(x: v.Json) -> v.Box[Int] = x\n")
  assert len(ds) == 0
  match m.decls[0] {
    DFn(f) -> {
      match f.params[0].tref {
        TQual(q, name, targs, _, _) -> {
          assert q == "v"
          assert name == "Json"
          assert len(targs) == 0
        }
        _ -> { assert false }
      }
      match f.ret {
        Some(TQual(q2, name2, targs2, _, _)) -> {
          assert q2 == "v"
          assert name2 == "Box"
          assert len(targs2) == 1
        }
        _ -> { assert false }
      }
    }
    _ -> { assert false }
  }
  # a lowercase name with no dot is still an error, and says why
  let (_, ds2) = parse_module("fn f(x: json) -> Int = 1\n")
  assert len(ds2) > 0
}

test "application is a postfix: call results and groups apply directly" {
  # each of these was a syntax error before the postfix arm existed
  let (_, ds) = parse_module("fn f() -> Int = add(3)(4)\n")
  assert len(ds) == 0
  let (_, ds2) = parse_module("fn g() -> Int = (pick(true))(1)\n")
  assert len(ds2) == 0
  let (_, ds3) = parse_module("fn h() -> Int = {\n  let x = 5\n  (0 - 1)\n  x\n}\n")
  # the parenthesized line is its own statement, not an application of x --
  # a newline ends the chain (only `.` may continue across lines)
  assert len(ds3) == 0
}

test "a qualified constructor pattern parses" {
  let (m, ds) = parse_module(
    "fn f(x: Int) -> Int =\n  match x {\n    v.JInt(n) -> n\n    other -> 0\n  }\n")
  assert len(ds) == 0
  assert len(m.decls) == 1
}

test "selective use keeps its import names" {
  let (m, ds) = parse_module("use json/value.{Json, render}\n\nfn f() = 1")
  match m.decls[0] {
    DUseModule(segs, selective, _al, a, b, c, d) -> {
      assert segs == ["json", "value"]
      match selective {
        Some(names) -> {
          assert len(names) == 2
          assert names[0].name == "Json"
        }
        None -> { assert false }
      }
    }
    _ -> { assert false }
  }
}

test "assert statements capture their source text" {
  let out = rendered("test \"t\" {\n  assert 1 + 1 == 2\n}")
  assert str.contains(out, "Assert src=1 + 1 == 2 ")
}

test "unterminated string in an interpolation-free file recovers" {
  let (m, ds) = parse_module("fn f() = \"abc")
  assert len(ds) > 0
  assert ds[0].msg == "unterminated string"
}

test "a conditional impl carries its own type parameters" {
  let (m, ds) = parse_module("impl[T: Eq] Eq[List[T]] {\n  fn eq(a: List[T], b: List[T]) -> Bool = true\n}")
  assert len(ds) == 0
  match m.decls[0] {
    DImpl(tparams, trait_name, _tlo, _thi, _subject, methods, _lo, _hi) -> {
      assert trait_name == "Eq"
      assert len(tparams) == 1
      assert tparams[0].name == "T"
      assert len(tparams[0].bounds) == 1
      assert tparams[0].bounds[0].name == "Eq"
      assert len(methods) == 1
    }
    _ -> { assert false }
  }
}

test "an unconditional impl parses with no type parameters" {
  let (m, ds) = parse_module("impl Ord[Point] {\n  fn cmp(a: Point, b: Point) -> Int = 0\n}")
  assert len(ds) == 0
  match m.decls[0] {
    DImpl(tparams, trait_name, _tlo, _thi, _subject, _methods, _lo, _hi) -> {
      assert trait_name == "Ord"
      assert len(tparams) == 0
    }
    _ -> { assert false }
  }
}

test "`with` turns the rest of its block into a trailing closure" {
  # the canonical shape: one `with`, two statements after it (spec §4.10)
  let out = rendered("fn f(p: String) -> Unit !io = {\n" ++
      "  with h <- bracket(open(p), close)\n  a(h)\n  b(h)\n}")
  # the call grew one argument, and that argument is the marked lambda
  assert str.contains(out, "Apply nargs=3")
  assert str.contains(out, "Lambda(with)")
  # the closure's body is the rest of the block, both statements inside it
  assert str.contains(out, "Block")
  assert str.contains(out, "Apply nargs=1")
}

test "`with` on a bare name applies it to the closure" {
  let (m, ds) = parse_module("fn f() -> Unit = {\n  with x <- g\n  h(x)\n}")
  assert len(ds) == 0
  match m.decls[0] {
    DFn(f) ->
      match f.body {
        EBlock(stmts, tail, _, _) -> {
          assert len(stmts) == 0
          match tail {
            Some(EApply(callee, args, _, _)) -> {
              match callee {
                EVar(n, _, _) -> { assert n == "g" }
                _ -> { assert false }
              }
              assert len(args) == 1
            }
            _ -> { assert false }
          }
        }
        _ -> { assert false }
      }
    _ -> { assert false }
  }
}

test "two `with`s in one block nest, they do not sit side by side" {
  let out = rendered("fn f() -> Unit !io = {\n  with a <- p()\n  with b <- q()\n  r(a, b)\n}")
  # one closure inside the other: two markers, and the inner one is deeper
  assert str.contains(out, "Lambda(with)")
  let (m, ds) = parse_module("fn f() -> Unit !io = {\n  with a <- p()\n  with b <- q()\n  r(a, b)\n}")
  assert len(ds) == 0
}

test "`with` needs a name and an arrow, and only lives in a block" {
  let (_, d1) = parse_module("fn f() -> Unit = {\n  with <- g()\n  h()\n}")
  assert len(d1) > 0
  assert str.contains(d1[0].msg, "a name to bind")
  let (_, d2) = parse_module("fn f() -> Unit = {\n  with x = g()\n  h()\n}")
  assert len(d2) > 0
  assert str.contains(d2[0].msg, "`<-`")
  # outside a block there is no rest-of-block to close over
  let (_, d3) = parse_module("fn f() -> Unit = with x <- g()")
  assert len(d3) > 0
  assert str.contains(d3[0].msg, "`with` is a statement")
}

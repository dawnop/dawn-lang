-- the split is the same as the plain-named pair's --
no failure     ok  same as the plain-named pair: true
panic          through  same as the plain-named pair: true
read_file      caught  same as the plain-named pair: true
-- the payload of a taken fault --
kind is a name        true
message is not empty  true
message is not kind   true
kind is not rendered  true
cause                 None
-- and Ok still carries the value --
ok            7

## GENERATED FILE -- do not edit. Regenerate with `python3 scripts/gen-stdsrc.py`
## after any edit under std/; the round-trip test in stdlib.dawn fails when stale.
##
## The embedded standard library: std/modules.txt and every module it lists,
## verbatim, as string constants. stdlib.std_read falls back to this when the
## --std directory is absent, which is what makes a standalone toolchain
## self-contained on every backend without a host resource API
## (docs/std-audit.md §2, native-backend-plan §14.20).

## The file's text, or None for a name that is not part of the embedded std.
pub fn source(name: String) -> Option[String] =
  if name == "modules.txt" {
    Some("# Bundled std modules, in dependency order (spec §10.6). Each name is a\n# resource std/<name>.dawn, importable as `use std/<name>`; the file's name is\n# the qualification alias (map.insert, str.trim, ...).\ncursor\nstr\n# char before fmt and bytes: both scan ASCII digits, and reading a character\n# as its code point is `char.code`, so the module has to be checked first.\n# Its own tests therefore stop at std/str -- the \"a character can be a Map\n# key\" claim lives in std/map's tests, which are checked after both.\nchar\nfmt\n# narrow depends on nothing but the builtins; it sits here so the modules\n# below may use it. gpu does: the bf16 rounding and bit codec.\nnarrow\n# list precedes bytes: `for` desugars through the prelude Iter trait, and\n# bytes' own for-loops need the `impl Iter[List[T]]` std/list registers\nlist\nbytes\nio\n# The reactor pump owns a process/module-lifetime root through internal io\n# runtime primitives. It depends only on io and precedes the collections.\nreactor\nmap\nset\nhamt\npvec\n# gpu is host-side only (the Gpu effect, typed tensors, the fake device) and\n# needs list, map, bytes and narrow; nothing in std uses it.\ngpu\n")
  } else if name == "cursor.dawn" {
    Some("## Positions in a `String`. A cursor is a position rather than a count, so\n## stepping through a string costs the same at every offset — where a\n## code-point index costs a walk from the start (spec §11).\n#\n# Short names, module-qualified at the call site: `use std/cursor`, then\n# `cursor.next(s, c)`. The underlying operations are compiler intrinsics; these\n# wrappers give them their public, qualified spelling.\n#\n# A position is opaque: `Cursor` is this module's own type, and only this\n# module may see it as the Int it is. Arithmetic on one is a type error\n# anywhere else, which is the point — only arithmetic can conjure a position\n# that lands in the middle of a surrogate pair.\n#\n# It used to be a type the compiler minted: a `Ty` variant, a `Head`, an entry\n# in the eq/hash scalar tables and an arm in seven files. Same guarantee, and\n# now no mechanism of its own — `opaque type` (spec §2.7) is the mechanism.\n#\n# What a position is measured in is the backend's business and nobody else's:\n# a UTF-16 code-unit offset on the JVM, a UTF-8 byte offset on native, and a\n# code-point index in the comptime interpreter, which has no representation to\n# offset into. Every function below takes its string afresh, so within one\n# string the measure never escapes and all three answer alike.\n#\n# The number itself is not a value anyone else may hold. It cannot be read --\n# that is what `opaque` buys. It cannot be folded into a constant: the checker\n# refuses a `const` of this type, because a constant is folded once and written\n# into the Core both backends read (spec 7.2). And it does not print: the\n# `Show` below renders `<cursor>` rather than the measure, which is why the\n# same program's output does not depend on who compiled it. The number that is\n# shared is `offset(s, c)`, the position counted in characters.\n#\n# Which leaves one seam, and it is a decision rather than an omission: a cursor\n# taken from one string and used on another. An out-of-range position is\n# clamped by `char`/`next`/`prev` and refused by `slice`, but an in-range one\n# is indistinguishable from a position of this string, so nothing here rejects\n# it and the answer differs by backend. Binding a cursor to its string needs a\n# tag that is itself backend-independent (otherwise the check diverges where\n# the cursor did), which costs a walk to compute and a second word in the\n# hottest loop any parser has. That was weighed and declined on 2026-08-16:\n# the seam is named instead. A cursor belongs to the string it came from.\n# Everything else the measure could leak through is held shut by\n# scripts/spike-native/cursor_currency.dawn, which runs this module's public\n# answers on both backends and compares them against a written expectation.\n# SEM-04, docs/codebase-audit-v2/02-types-effects-and-semantics.md.\n\n## A position in a String: an index the language will not let you compute.\npub opaque type Cursor = Int\n\n## The position before the first character.\npub fn start(s: String) -> Cursor = cursor_start(s)\n\n## The position after the last character.\npub fn end(s: String) -> Cursor = cursor_end(s)\n\n## Whether `c` is at the end of `s`.\npub fn done(s: String, c: Cursor) -> Bool = cursor_done(s, c)\n\n## The code point at `c`, or -1 at the end.\npub fn char(s: String, c: Cursor) -> Int = cursor_char(s, c)\n\n## The position one character forward (clamped to the end).\npub fn next(s: String, c: Cursor) -> Cursor = cursor_next(s, c)\n\n## The position one character back (clamped to the start).\npub fn prev(s: String, c: Cursor) -> Cursor = cursor_prev(s, c)\n\n## The text between two positions.\npub fn slice(s: String, from: Cursor, to: Cursor) -> String = cursor_slice(s, from, to)\n\n# The three below used to be intrinsics too — `cursor_skip` and\n# `index_of_from`, each with a hand-written implementation in the JVM emitter\n# and another in the C runtime, and a third route in the comptime interpreter\n# that reflected into the emitted JVM class. Search is not a representation\n# question: it is a walk, and the walk is above. Writing it here leaves seven\n# intrinsics under this module, which is the whole representation boundary\n# (docs/native-backend-plan.md 14.12).\n\n## The position just past `sub`, which is known to start at `c` — the one\n## sanctioned \"advance past a literal\" that would otherwise be cursor arithmetic.\n##\n## Walks both strings together rather than counting `sub` first, so it needs no\n## length and no arithmetic.\npub fn skip(s: String, c: Cursor, sub: String) -> Cursor = skip_go(s, c, sub, start(sub))\n\nfn skip_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Cursor =\n  if done(t, tc) || done(s, sc) {\n    sc\n  } else {\n    skip_go(s, next(s, sc), t, next(t, tc))\n  }\n\n## Whether `sub` occurs in `s` starting exactly at `c`. An empty `sub` is at\n## every position, including the end.\npub fn starts_at(s: String, c: Cursor, sub: String) -> Bool =\n  match_go(s, c, sub, start(sub))\n\nfn match_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Bool =\n  if done(t, tc) {\n    true\n  } else if done(s, sc) {\n    false\n  } else if char(s, sc) != char(t, tc) {\n    false\n  } else {\n    match_go(s, next(s, sc), t, next(t, tc))\n  }\n\n## The position of the first occurrence of `sub` at or after `from`, or `None`.\npub fn find(s: String, sub: String, from: Cursor) -> Option[Cursor] =\n  if starts_at(s, from, sub) {\n    Some(from)\n  } else if done(s, from) {\n    None\n  } else {\n    find(s, sub, next(s, from))\n  }\n\n## The position `n` characters back from `c` (clamped to the start).\npub fn back(s: String, c: Cursor, n: Int) -> Cursor =\n  if n <= 0 { c } else { back(s, prev(s, c), n - 1) }\n\n# ---- the bridge to code-point indices ----\n#\n# There are two ways to say where you are in a string -- a code-point `Int`\n# and a `Cursor` -- and until these two functions existed there was no way to\n# get from either to the other. `str.index_of` answers in the first and\n# `cursor.slice` demands the second, so a scanner whose state is an `Int` (the\n# TOML one, for instance) had to re-derive its position from the start of the\n# string on every character: O(n) per step, O(n^2) per line. Neither of these\n# makes that cheap -- each is one walk -- but one walk at the boundary is not\n# one walk per character.\n\n## The position `i` characters from the start of `s`.\n##\n## Clamped, not asserted: a negative `i` is the start and an `i` past the end\n## is the end (spec §4.8, criterion 3, the same clause `next`, `prev` and\n## `back` already answer to). Every position in a string is a legal *answer*\n## here -- the guarantee `Cursor` carries is that arithmetic cannot land you\n## between the halves of a surrogate pair, and walking `i` characters cannot.\n##\n## Named `seek` and not `at` because those two words are the language's two\n## out-of-range policies and one name cannot hold both: `at` is criterion 1\n## (`str.at`, `bytes.at`, `xs[i]` -- the caller asserts the position exists and\n## a miss panics), this is criterion 3. Spelled `cursor.at` until v0.54.0;\n## rationale in `docs/stdlib-naming.md`.\n##\n## O(i). Use it once, at the point where an `Int` index arrives from outside;\n## a loop that calls it per character is the O(n^2) it exists to remove.\npub fn seek(s: String, i: Int) -> Cursor = seek_go(s, start(s), i)\n\nfn seek_go(s: String, c: Cursor, i: Int) -> Cursor =\n  if i <= 0 || done(s, c) { c } else { seek_go(s, next(s, c), i - 1) }\n\n## How many characters lie before `c`: the code-point index `seek` would take.\n##\n## One pass, counting forward from the start, rather than the two-scan version\n## `packages/json` wrote for itself.\n##\n## `c` must be a position in `s`. Handing it one from another string is not a\n## thing this function has an answer for -- see the module note above.\npub fn offset(s: String, c: Cursor) -> Int = offset_go(s, start(s), c, 0)\n\nfn offset_go(s: String, p: Cursor, c: Cursor, n: Int) -> Int = {\n  let x: Int = p\n  let y: Int = c\n  if x >= y || done(s, p) { n } else { offset_go(s, next(s, p), c, n + 1) }\n}\n\n## A cursor renders as `<cursor>`: a position, without saying which. The number\n## is the backend's own measure, so printing it would put \"2 here, 4 there\" in\n## a program's output, and a third answer again when the render is folded at\n## compile time. Nothing above this module can act on that number anyway.\n## `offset(s, c)` is the position in characters, and characters are what every\n## backend agrees on -- print that.\n##\n## An opaque type with no impl of its own renders as its target, which for this\n## one is the measure (scripts/spike-native/show_opaque.dawn pins the general\n## rule, and that this impl wins over it).\nimpl Show[Cursor] {\n  fn show(_c: Cursor) -> String = \"<cursor>\"\n}\n\n## Positions in one string are ordered, and that order is the Int's. One impl\n## answers every question about that order -- `<` and `list.sort` alike.\nimpl Ord[Cursor] {\n  fn cmp(a: Cursor, b: Cursor) -> Int = {\n    let x: Int = a\n    let y: Int = b\n    if x < y { -1 } else if x > y { 1 } else { 0 }\n  }\n}\n\n# ---- tests ----\n#\n# The bridge functions (`seek` / `offset`) and the walks around them, checked at\n# the boundaries: both ends of the string, and the one character whose UTF-16\n# representation is two units. `😀` is U+1F600, a surrogate pair, so every\n# clause below that says \"by character\" is only tested by it -- a BMP character\n# cannot tell a walk by character from a walk by unit.\n#\n# Positions are compared through `offset`, `char` and `slice` rather than\n# through the Int inside them: this module is the only one that may look, and\n# a test that looks would be checking the representation instead of the promise.\n\ntest \"start and end bracket the string, and the end holds no character\" {\n  assert done(\"\", start(\"\"))\n  assert done(\"abc\", end(\"abc\"))\n  assert not done(\"abc\", start(\"abc\"))\n  assert char(\"abc\", start(\"abc\")) == 97\n  assert char(\"abc\", end(\"abc\")) == 0 - 1\n  assert char(\"\", start(\"\")) == 0 - 1\n  assert slice(\"abc\", start(\"abc\"), end(\"abc\")) == \"abc\"\n  assert slice(\"abc\", start(\"abc\"), start(\"abc\")) == \"\"\n  assert slice(\"\", start(\"\"), end(\"\")) == \"\"\n}\n\ntest \"next and prev step one character and clamp at both ends\" {\n  let s = \"a😀z\"\n  let c1 = next(s, start(s))\n  let c2 = next(s, c1)\n  assert char(s, start(s)) == 97\n  assert char(s, c1) == 0x1F600\n  assert char(s, c2) == 122\n  assert done(s, next(s, c2))\n  # clamped: a step past either end stays where it was\n  assert offset(s, next(s, end(s))) == 3\n  assert offset(s, prev(s, start(s))) == 0\n  # prev crosses the pair whole -- it never lands between the two units\n  assert char(s, prev(s, end(s))) == 122\n  assert char(s, prev(s, prev(s, end(s)))) == 0x1F600\n  assert slice(s, prev(s, prev(s, end(s))), end(s)) == \"😀z\"\n}\n\ntest \"back walks n characters and clamps at the start\" {\n  let s = \"abcde\"\n  assert slice(s, back(s, end(s), 2), end(s)) == \"de\"\n  assert slice(s, back(s, end(s), 0), end(s)) == \"\"\n  assert slice(s, back(s, end(s), 0 - 3), end(s)) == \"\"\n  assert slice(s, back(s, end(s), 99), end(s)) == \"abcde\"\n  assert slice(s, back(s, end(s), 5), end(s)) == \"abcde\"\n  # one step back over an astral character lands before both of its units\n  assert slice(\"a😀\", back(\"a😀\", end(\"a😀\"), 1), end(\"a😀\")) == \"😀\"\n}\n\ntest \"at and offset are the two directions of one bridge, and at clamps\" {\n  let s = \"a中😀z\"\n  assert offset(s, seek(s, 0)) == 0\n  assert offset(s, seek(s, 2)) == 2\n  assert offset(s, seek(s, 4)) == 4\n  # spec 4.8 criterion 3: an index outside the string is clamped, not refused\n  assert offset(s, seek(s, 0 - 5)) == 0\n  assert offset(s, seek(s, 99)) == 4\n  assert char(s, seek(s, 1)) == 0x4E2D\n  assert char(s, seek(s, 2)) == 0x1F600\n  assert char(s, seek(s, 4)) == 0 - 1\n  # the index counts characters, so the astral one advances it by one\n  assert slice(s, seek(s, 1), seek(s, 3)) == \"中😀\"\n  assert slice(s, seek(s, 2), seek(s, 3)) == \"😀\"\n  assert offset(s, start(s)) == 0\n  assert offset(s, end(s)) == 4\n  assert offset(\"\", start(\"\")) == 0\n  assert offset(\"\", end(\"\")) == 0\n}\n\ntest \"starts_at matches at a position, and the empty string is at every one\" {\n  let s = \"abcabc\"\n  assert starts_at(s, start(s), \"abc\")\n  assert starts_at(s, seek(s, 3), \"abc\")\n  assert not starts_at(s, seek(s, 1), \"abc\")\n  # running off the end is a miss, not a match on what is left\n  assert not starts_at(s, seek(s, 4), \"abc\")\n  assert starts_at(s, start(s), \"\")\n  assert starts_at(s, end(s), \"\")\n  assert starts_at(\"\", start(\"\"), \"\")\n  assert not starts_at(\"\", start(\"\"), \"a\")\n  assert starts_at(\"a😀\", seek(\"a😀\", 1), \"😀\")\n}\n\ntest \"find answers with a position at or after where it was told to look\" {\n  let s = \"abcabc\"\n  match find(s, \"bc\", start(s)) {\n    Some(c) -> { assert offset(s, c) == 1 }\n    None -> { assert false }\n  }\n  match find(s, \"bc\", seek(s, 2)) {\n    Some(c) -> { assert offset(s, c) == 4 }\n    None -> { assert false }\n  }\n  match find(s, \"z\", start(s)) {\n    Some(_) -> { assert false }\n    None -> ()\n  }\n  # the empty needle is found where the search began, including at the end\n  match find(s, \"\", seek(s, 3)) {\n    Some(c) -> { assert offset(s, c) == 3 }\n    None -> { assert false }\n  }\n  match find(s, \"\", end(s)) {\n    Some(c) -> { assert offset(s, c) == 6 }\n    None -> { assert false }\n  }\n}\n\ntest \"skip advances past an occurrence it is told is there\" {\n  let s = \"prefix/rest\"\n  assert slice(s, skip(s, start(s), \"prefix/\"), end(s)) == \"rest\"\n  # nothing to skip, and nothing to skip past: both stay put\n  assert slice(s, skip(s, start(s), \"\"), end(s)) == \"prefix/rest\"\n  assert done(s, skip(s, end(s), \"anything\"))\n  # a `sub` longer than what is left stops at the end rather than walking off\n  assert done(s, skip(s, start(s), \"prefix/rest and more\"))\n  assert slice(\"a😀z\", skip(\"a😀z\", start(\"a😀z\"), \"a😀\"), end(\"a😀z\")) == \"z\"\n}\n\ntest \"a cursor renders without its number\" {\n  # the number under this one is 2 on the JVM, 4 on native and 1 in the\n  # comptime interpreter. Rendering it would be the one way left for that\n  # difference to reach a program's output.\n  let s = \"😀ab\"\n  let c = next(s, start(s))\n  assert to_string(c) == \"<cursor>\"\n  assert \"\${c}\" == \"<cursor>\"\n  # nested rendering is checked from a program rather than from here: the\n  # conditional `Show[List[T]]` lives in std/list, which this module does not\n  # import. scripts/spike-native/cursor_currency.dawn has it.\n  #\n  # and the number that is shared is still reachable, by walking for it\n  assert offset(s, c) == 1\n}\n\ntest \"positions in one string are ordered, and the order is the walk's\" {\n  let s = \"abcd\"\n  assert cmp(seek(s, 0), seek(s, 1)) < 0\n  assert cmp(seek(s, 2), seek(s, 2)) == 0\n  assert cmp(end(s), start(s)) > 0\n  assert cmp(start(s), seek(s, 0)) == 0\n  assert cmp(seek(s, 99), end(s)) == 0\n}\n")
  } else if name == "str.dawn" {
    Some("## String operations, over code points: trimming, case, search, slicing,\n## splitting and padding (spec §11).\n#\n# Short names, module-qualified at the call site: `use std/str`, then\n# `str.len(s)` / `str.trim(s)`; hot names can be pulled in selectively\n# (`use std/str.{trim}`).\n#\n# Ordinary Dawn source, bundled into the compiler jar as a resource, checked\n# before user code, and with its `pub` surface implicitly visible in every\n# module — no `use` needed (spec §10.6). This is the landing place for functions\n# moving out of the compiler's builtin table (docs/builtins-to-stdlib.md).\n#\n# Two implementation styles live here, on purpose (docs/pure-ffi-design.md §九):\n#   - plain Dawn over the cursor walk, which is nearly everything;\n#   - a str_* intrinsic, only where the answer is a Unicode table rather than a\n#     walk: case folding, and `char_is_*` underneath `trim`.\n#\n# Length, trimming, and all four searches used to be intrinsics too. Each had a\n# hand-written implementation in the JVM emitter and another in the C runtime,\n# and they disagreed with nothing to say so; the comptime interpreter had no\n# copy at all and reflected into the emitted JVM class, which is a route a\n# native compiler does not have (docs/native-backend-plan.md 14.12). They are\n# walks, not representation, so they are written here once and every consumer\n# reads that one definition.\n#\n# Nothing here names a JVM class; the backend owns the seven cursor primitives\n# and the two case foldings in dawn/rt/Strings (docs/runtime-intrinsics-design.md).\n\nuse std/cursor\nuse std/cursor.{Cursor}\n\n## Number of Unicode code points in `s` (not UTF-16 units, and not `chars`' list length).\npub fn len(s: String) -> Int = count(s, cursor.start(s), 0)\n\nfn count(s: String, c: Cursor, n: Int) -> Int =\n  if cursor.done(s, c) { n } else { count(s, cursor.next(s, c), n + 1) }\n\n## True when the string has no characters.\npub fn is_empty(s: String) -> Bool = cursor.done(s, cursor.start(s))\n\n## `s` without leading or trailing whitespace.\npub fn trim(s: String) -> String = {\n  let a = skip_space(s, cursor.start(s))\n  cursor.slice(s, a, last_kept(s, a, a))\n}\n\n## `s` without leading whitespace.\npub fn trim_start(s: String) -> String =\n  cursor.slice(s, skip_space(s, cursor.start(s)), cursor.end(s))\n\n## `s` without trailing whitespace.\npub fn trim_end(s: String) -> String = {\n  let a = cursor.start(s)\n  cursor.slice(s, a, last_kept(s, a, a))\n}\n\nfn skip_space(s: String, c: Cursor) -> Cursor =\n  if cursor.done(s, c) || not char_is_space(char_unchecked(cursor.char(s, c))) {\n    c\n  } else {\n    skip_space(s, cursor.next(s, c))\n  }\n\n## The position just past the last non-space at or after `c`. Walking forward\n## and remembering, rather than walking back from the end, so no two positions\n## ever have to be compared.\nfn last_kept(s: String, c: Cursor, best: Cursor) -> Cursor =\n  if cursor.done(s, c) {\n    best\n  } else {\n    let n = cursor.next(s, c)\n    last_kept(s, n, if char_is_space(char_unchecked(cursor.char(s, c))) { best } else { n })\n  }\n\n## `s` lowercased by simple (1:1) Unicode mapping: one code point in, one out,\n## no locale and no context, so the code-point count is unchanged.\npub fn to_lower(s: String) -> String = str_lower(s)\n\n## `s` uppercased by simple (1:1) Unicode mapping. Not the length-changing full\n## mapping -- `ß` stays `ß` rather than becoming `SS`, because full mapping is\n## locale- and context-sensitive and so is not a function a second backend can\n## implement from a table (spec 11). That belongs in a library taking a locale.\npub fn to_upper(s: String) -> String = str_upper(s)\n\n## Whether `sub` occurs anywhere in `s`.\npub fn contains(s: String, sub: String) -> Bool =\n  match cursor.find(s, sub, cursor.start(s)) {\n    Some(_) -> true\n    None -> false\n  }\n\n## Whether `s` begins with `prefix`.\npub fn starts_with(s: String, prefix: String) -> Bool =\n  cursor.starts_at(s, cursor.start(s), prefix)\n\n## Whether `s` ends with `suffix`.\n##\n## O(len(suffix)), not O(len(s)). The walk back from the end was always the\n## short one; the cost was the guard in front of it, which asked for `len(s)`\n## and so read the whole string to answer a question about its last few\n## characters. The guard was redundant: `back` clamps to the start when\n## `suffix` is longer than `s` (criterion 3), and `starts_at` then runs out of\n## `s` before it runs out of `suffix` and answers false on its own.\npub fn ends_with(s: String, suffix: String) -> Bool =\n  cursor.starts_at(s, cursor.back(s, cursor.end(s), len(suffix)), suffix)\n\n## `s` with `prefix` removed, or `None` when `s` does not begin with it.\n##\n## Inquiry (spec §4.8, criterion 2): \"no such prefix\" is a branch the caller\n## takes, not a bug. Testing and peeling in one call is the point -- the pair\n## `starts_with` plus a hand-computed `slice(s, 16, len(s))` is what put\n## magic offsets in 33 call sites, and an offset that is one out still compiles.\n## No arithmetic happens here either: `cursor.skip` walks past the prefix.\npub fn strip_prefix(s: String, prefix: String) -> Option[String] =\n  if starts_with(s, prefix) {\n    Some(cursor.slice(s, cursor.skip(s, cursor.start(s), prefix), cursor.end(s)))\n  } else {\n    None\n  }\n\n## `s` with `suffix` removed, or `None` when `s` does not end with it.\n## The mirror of `strip_prefix`, and the answer to `- 5` meaning `len(\".dawn\")`.\npub fn strip_suffix(s: String, suffix: String) -> Option[String] =\n  if ends_with(s, suffix) {\n    Some(cursor.slice(s, cursor.start(s), cursor.back(s, cursor.end(s), len(suffix))))\n  } else {\n    None\n  }\n\n## Where the first occurrence of `sub` begins, in code points, or `None`.\n##\n## The answer is a *position* in `[0, len]`, not the index of an element: an\n## empty `sub` occurs at position 0 of the empty string, and `len(s)` is a\n## legal answer here (see `last_index_of`) though no character lives there.\n## \"Index\" in the name is the unit it counts in -- code points, not UTF-16\n## units and not bytes -- and `cursor.find` is the one that answers with a\n## position you can slice at directly.\npub fn index_of(s: String, sub: String) -> Option[Int] = idx(s, sub, cursor.start(s), 0)\n\nfn idx(s: String, sub: String, c: Cursor, i: Int) -> Option[Int] =\n  if cursor.starts_at(s, c, sub) {\n    Some(i)\n  } else if cursor.done(s, c) {\n    None\n  } else {\n    idx(s, sub, cursor.next(s, c), i + 1)\n  }\n\n## Where the last occurrence of `sub` begins, in code points, or `None`. A\n## position in `[0, len]`: an empty `sub` is found at the end, which is\n## `len(s)` -- past the last character, which is why the answer is a position\n## and not an element index.\npub fn last_index_of(s: String, sub: String) -> Option[Int] =\n  last_idx(s, sub, cursor.start(s), 0, None)\n\nfn last_idx(s: String, sub: String, c: Cursor, i: Int, best: Option[Int]) -> Option[Int] = {\n  let seen = if cursor.starts_at(s, c, sub) { Some(i) } else { best }\n  if cursor.done(s, c) { seen } else { last_idx(s, sub, cursor.next(s, c), i + 1, seen) }\n}\n\n## The one-character string for `c`, asked for by name.\n##\n## `\"\${c}\"` is the same string, through `std/char`'s `impl Display[Char]`\n## (spec §4.3). This one does not depend on an impl being in scope, and it is\n## the spelling to reach for where a `Char` is being *converted* rather than\n## rendered -- which is what nearly every caller in this repository is doing.\n## A `Char` nested inside a structure still renders as its code point, because\n## that is `Show`, and `Show[Char]` is still the `Int`'s (spec §2.7).\npub fn from_char(c: Char) -> String = from_code_points([c])\n\n## `s` repeated `n` times; n <= 0 yields the empty string.\n##\n## Doubling: O(len(s) * n) on both backends, and stack-safe at any `n`. Why the\n## two obvious shapes are not, in `docs/stdlib-impl-notes.md`.\npub fn repeat(s: String, n: Int) -> String = {\n  var out = \"\"\n  var chunk = s\n  var k = n\n  while k > 0 {\n    if k % 2 == 1 { out = out ++ chunk }\n    k = k / 2\n    if k > 0 { chunk = chunk ++ chunk }\n  }\n  out\n}\n\n# The code-point helpers below recurse over `code_points(s)` with an explicit\n# index because `len` here is str.len (String → code points) and so shadows the\n# builtin list length; `str.len(s)` doubles as the code-point count of that list.\n\n## The code points of `s` in `[from, to)`. Both ends are clamped into range\n## (a negative index reads as 0, one past the end as `len`) and `from > to`\n## yields the empty string, so this never panics — a range parameter selects\n## a stretch, it does not assert its endpoints exist (spec §4.8).\n##\n## Spelled `substring` until v0.54.0; rationale in `docs/stdlib-naming.md`.\n##\n## O(to), not O(len(s)). It walked the whole string until 2026-08-17, three\n## times over: `len(s)` to clamp with, `code_points(s)` to materialise every\n## character of it as a `List[Char]`, and a rebuild. So `slice(s, 0, 1)` cost\n## and allocated in proportion to a string it was asked for one character of.\n## `at` went through `cursor.seek` and this did not; positions are what the\n## cursor layer is for, and it clamps on its own (criterion 3), which is why no\n## length is needed to clamp against.\npub fn slice(s: String, from: Int, to: Int) -> String = {\n  let f = if from < 0 { 0 } else { from }\n  let t = if to < 0 { 0 } else { to }\n  if f >= t {\n    \"\"\n  } else {\n    cursor.slice(s, cursor.seek(s, f), cursor.seek(s, t))\n  }\n}\n\n## The first `n` characters, or all of them when there are fewer. `n` is\n## clamped into `[0, len]`, so this never panics: it names a stretch rather\n## than asserting that position `n` exists (spec §4.8, criterion 3), the same\n## way `slice` and `list.take` do.\n##\n## `truncate` would be this function under another name, so there is no\n## `truncate`.\npub fn take(s: String, n: Int) -> String = slice(s, 0, n)\n\n## Everything after the first `n` characters; `n` is clamped into `[0, len]`,\n## so this never panics. This is the \"the rest of it\" that 50 call sites spell\n## `slice(x, i, str.len(x))`.\n##\n## O(len(s) - n): what it returns, and nothing on top. Spelled through `slice`\n## it also paid a `len(s)` to name the far end, which is the one thing the end\n## cursor already is.\npub fn drop(s: String, n: Int) -> String =\n  if n <= 0 { s } else { cursor.slice(s, cursor.seek(s, n), cursor.end(s)) }\n\n## The character at `i`. Panics when `i` is out of range -- `i` is a position\n## the caller says exists, exactly like `xs[i]` and `bytes.at`\n## (spec §4.8, criterion 1); `get`-style inquiry about a character is\n## `cursor.char` on a position you already hold.\n##\n## A `Char`, not a one-character string: it is the currency `code_points` and\n## `from_char` trade in, and `chars` is the function that answers with strings.\n## `cursor.char` stays an `Int` one layer down, because it answers `-1` past\n## the end and a sentinel cannot live in a type whose every value is a\n## character (spec §4.8).\npub fn at(s: String, i: Int) -> Char = {\n  let c = cursor.seek(s, i)\n  if i < 0 || cursor.done(s, c) {\n    panic(\"str.at: index out of range\")\n  } else {\n    char_unchecked(cursor.char(s, c))\n  }\n}\n\n## `s` left-padded with `pad` until it is `width` code points wide. Returns `s`\n## unchanged when it is already wide enough or `pad` is empty; the filler is\n## truncated to land exactly on width.\npub fn pad_start(s: String, width: Int, pad: String) -> String = {\n  let have = len(s)\n  if have >= width || pad == \"\" {\n    s\n  } else {\n    let acc: List[Char] = []\n    from_code_points(pad_fill(code_points(pad), len(pad), width - have, 0, acc)) ++ s\n  }\n}\n\nfn pad_fill(pad: List[Char], plen: Int, need: Int, i: Int, acc: List[Char]) -> List[Char] =\n  if i >= need { acc }\n  else { pad_fill(pad, plen, need, i + 1, acc ++ [get(pad, i % plen).expect(\"cycle in range\")]) }\n\n## `s` right-padded with `pad` until it is `width` code points wide. The mirror\n## of `pad_start`, with the same clauses: `s` comes back unchanged when it is\n## already wide enough or `pad` is empty, and the filler is truncated to land\n## exactly on width.\npub fn pad_end(s: String, width: Int, pad: String) -> String = {\n  let have = len(s)\n  if have >= width || pad == \"\" {\n    s\n  } else {\n    let acc: List[Char] = []\n    s ++ from_code_points(pad_fill(code_points(pad), len(pad), width - have, 0, acc))\n  }\n}\n\n## `s` with its code points in reverse order (surrogate pairs stay intact).\npub fn reverse(s: String) -> String = {\n  let acc: List[Char] = []\n  from_code_points(rev_cps(code_points(s), len(s) - 1, acc))\n}\n\nfn rev_cps(cps: List[Char], i: Int, acc: List[Char]) -> List[Char] =\n  if i < 0 { acc } else { rev_cps(cps, i - 1, acc ++ [get(cps, i).expect(\"in range\")]) }\n\n# ---- cursors ----\n#\n# Positions come from std/cursor, whose `Cursor` is opaque: only that module\n# may see one as the Int it is, so the raw `cursor_*` builtins have exactly\n# one caller in the whole ecosystem. chars/split below thread positions\n# without ever computing one, which is the guarantee the type carries.\n\n## The characters of `s`, each as a one-character string.\n## A surrogate pair stays one element — this splits by character, not by unit.\npub fn chars(s: String) -> List[String] = {\n  let empty: List[String] = []\n  chars_go(s, cursor.start(s), empty)\n}\n\nfn chars_go(s: String, c: Cursor, acc: List[String]) -> List[String] =\n  if cursor.done(s, c) {\n    acc\n  } else {\n    let n = cursor.next(s, c)\n    chars_go(s, n, acc ++ [cursor.slice(s, c, n)])\n  }\n\n## `s` cut at each occurrence of `sep`, left to right. Adjacent separators yield\n## empty pieces, and the result always has one more piece than there were\n## separators. An empty `sep` yields the characters, as `chars` does.\npub fn split(s: String, sep: String) -> List[String] =\n  if sep == \"\" {\n    chars(s)\n  } else {\n    let empty: List[String] = []\n    split_go(s, sep, cursor.start(s), empty)\n  }\n\nfn split_go(s: String, sep: String, at: Cursor, acc: List[String]) -> List[String] =\n  match cursor.find(s, sep, at) {\n    None -> acc ++ [cursor.slice(s, at, cursor.end(s))]\n    # cursor.skip is the one sanctioned \"advance past a known occurrence\"\n    Some(i) -> split_go(s, sep, cursor.skip(s, i, sep), acc ++ [cursor.slice(s, at, i)])\n  }\n\n## `s` cut in two at the *first* occurrence of `sep`: what came before it and\n## what came after, or `None` when `sep` does not occur.\n##\n## Inquiry (spec §4.8, criterion 2), the same shape as `strip_prefix`: \"no\n## separator\" is a branch the caller takes. `split` answers a different\n## question -- it has no way to say \"there was no separator\", because one piece\n## is also what a string with no separator yields, and the two are different\n## answers to `key=value` parsing.\n##\n## Testing and cutting in one call is the point. The pair\n## `index_of` plus two `slice` calls is three passes and two chances to be one\n## out; this is one pass and no arithmetic. An empty `sep` occurs at the start,\n## so it answers `(\"\", s)`.\npub fn split_once(s: String, sep: String) -> Option[(String, String)] =\n  match cursor.find(s, sep, cursor.start(s)) {\n    None -> None\n    Some(c) -> Some(cut_at(s, c, sep))\n  }\n\n## `s` cut in two at the *last* occurrence of `sep`. The mirror of\n## `split_once`, and the one to reach for when the separator also occurs inside\n## the left part: `rsplit_once(\"a/b/c.d\", \"/\")` is `(\"a/b\", \"c.d\")`.\npub fn rsplit_once(s: String, sep: String) -> Option[(String, String)] =\n  match last_at(s, sep, cursor.start(s), None) {\n    None -> None\n    Some(c) -> Some(cut_at(s, c, sep))\n  }\n\n## The two sides of an occurrence of `sep` known to start at `c`. `cursor.skip`\n## walks past it, so neither side is computed by subtracting a length.\nfn cut_at(s: String, c: Cursor, sep: String) -> (String, String) =\n  (cursor.slice(s, cursor.start(s), c),\n    cursor.slice(s, cursor.skip(s, c, sep), cursor.end(s)))\n\n## Where the last occurrence of `sep` begins. Walks forward remembering, the\n## way `last_idx` does, rather than walking back from the end -- a backward\n## search would have to compare two positions to know when to stop.\nfn last_at(s: String, sep: String, c: Cursor, best: Option[Cursor]) -> Option[Cursor] = {\n  let b2 = if cursor.starts_at(s, c, sep) { Some(c) } else { best }\n  if cursor.done(s, c) { b2 } else { last_at(s, sep, cursor.next(s, c), b2) }\n}\n\n## `s` with every occurrence of `from` replaced by `to`, left to right and\n## non-overlapping. An empty `from` splices `to` between the characters, the\n## same way `split` with an empty separator yields them.\npub fn replace(s: String, from: String, to: String) -> String =\n  join(split(s, from), to)\n\n# ---- iteration (prelude Iter, #44 knife 2) ----\n\n## `for ch in s` walks the string by code point; each element is a\n## one-character String, the same shape `chars` hands out, without\n## materialising the list. The cursor is `Cursor`, so a position mid-walk is\n## as impossible to conjure from arithmetic here as anywhere else.\nimpl Iter[String] {\n  type Cur = Cursor\n  type Item = String\n\n  fn iter_start(s: String) -> Cursor = cursor.start(s)\n  fn iter_done(s: String, c: Cursor) -> Bool = cursor.done(s, c)\n  fn iter_next(s: String, c: Cursor) -> Cursor = cursor.next(s, c)\n  fn iter_get(s: String, c: Cursor) -> String = cursor.slice(s, c, cursor.next(s, c))\n}\n\n# ---- tests ----\n#\n# Behaviour, not implementation: every assertion below is a promise one of the\n# doc comments above makes, and the ones about code points are made twice --\n# once with a BMP character and once with an astral one. `中` is a single\n# UTF-16 unit, so a walk written in units agrees with a walk written in code\n# points about it and the test says nothing; `😀` (U+1F600) is a surrogate\n# pair, and it is the character that tells the two apart.\n\ntest \"len and is_empty count code points, not UTF-16 units\" {\n  assert len(\"\") == 0\n  assert is_empty(\"\")\n  assert not is_empty(\" \")\n  assert len(\"abc\") == 3\n  assert len(\"中文字\") == 3\n  assert len(\"😀\") == 1\n  assert len(\"a中😀z\") == 4\n}\n\ntest \"asking about the end does not read the front\" {\n  # A cost, not a value: every assertion here also passes on the implementation\n  # this replaced, so the size is what distinguishes them. `ends_with` guarded\n  # itself with `len(suffix) > len(s)`, and `len(s)` is a walk, so a question\n  # about the last character cost a pass over the whole string. Asked once that\n  # is invisible; the shape that indicts it is a loop, which is how callers use\n  # it (`while ends_with(t, \"/\")`, path suffix tests over a file list).\n  #\n  # 200000 questions against a million characters. Measured on this machine:\n  # the whole std suite runs in 1.2s with this implementation and 77s with the\n  # guarded one, so a revert shows up as the suite taking about sixty times\n  # longer rather than as a wrong answer. There is no per-test timeout to catch\n  # it, which is why the multiple is made large enough to be unmissable.\n  #\n  # First in the block on purpose, as `repeat`'s stack witness is: the cheap\n  # assertions below would otherwise run first and a reverted implementation\n  # would grind for a minute before reaching the one that indicts it.\n  let long = repeat(\"a\", 1000000)\n  var hits = 0\n  var i = 0\n  while i < 200000 {\n    if ends_with(long, \"a\") { hits = hits + 1 }\n    if ends_with(long, \"b\") { hits = hits + 100 }\n    i = i + 1\n  }\n  assert hits == 200000\n  # the answer is still the answer at that size, including the case the guard\n  # used to handle: a suffix longer than the string\n  assert ends_with(long, \"aaa\")\n  assert not ends_with(\"ab\", \"xxxab\")\n  assert not ends_with(\"ab\", \"aaab\")\n  assert ends_with(\"ab\", \"ab\")\n  assert ends_with(\"\", \"\")\n}\n\ntest \"the affix predicates ask about the ends, and the empty affix is at both\" {\n  assert starts_with(\"abcdef\", \"abc\")\n  assert starts_with(\"abc\", \"abc\")\n  assert starts_with(\"abc\", \"\")\n  assert not starts_with(\"abcdef\", \"bcd\")\n  assert not starts_with(\"ab\", \"abc\")\n  assert ends_with(\"abcdef\", \"def\")\n  assert ends_with(\"abc\", \"abc\")\n  assert ends_with(\"abc\", \"\")\n  assert not ends_with(\"abcdef\", \"cde\")\n  assert not ends_with(\"ab\", \"abc\")\n  assert starts_with(\"\", \"\")\n  assert ends_with(\"\", \"\")\n  assert not starts_with(\"\", \"a\")\n  assert not ends_with(\"\", \"a\")\n  # the walk back is by character, not by unit: half a surrogate pair is not\n  # a suffix of anything\n  assert ends_with(\"a😀\", \"😀\")\n  assert not ends_with(\"a😀\", \"a\")\n  assert starts_with(\"😀a\", \"😀\")\n}\n\ntest \"strip_prefix and strip_suffix peel, or answer None\" {\n  assert strip_prefix(\"dawn.lang\", \"dawn.\").unwrap_or(\"!\") == \"lang\"\n  assert strip_prefix(\"abc\", \"\").unwrap_or(\"!\") == \"abc\"\n  assert strip_prefix(\"abc\", \"abc\").unwrap_or(\"!\") == \"\"\n  assert strip_prefix(\"dawn.lang\", \"lang\") == None\n  assert strip_prefix(\"ab\", \"abc\") == None\n  assert strip_suffix(\"main.dawn\", \".dawn\").unwrap_or(\"!\") == \"main\"\n  assert strip_suffix(\"abc\", \"\").unwrap_or(\"!\") == \"abc\"\n  assert strip_suffix(\"abc\", \"abc\").unwrap_or(\"!\") == \"\"\n  assert strip_suffix(\"main.dawn\", \".x\") == None\n  assert strip_suffix(\"ab\", \"abc\") == None\n  assert strip_prefix(\"😀ok\", \"😀\").unwrap_or(\"!\") == \"ok\"\n  assert strip_suffix(\"ok😀\", \"😀\").unwrap_or(\"!\") == \"ok\"\n}\n\ntest \"index_of and last_index_of answer in code points, and find the empty string\" {\n  assert index_of(\"abcabc\", \"b\").unwrap_or(0 - 1) == 1\n  assert last_index_of(\"abcabc\", \"b\").unwrap_or(0 - 1) == 4\n  assert index_of(\"abc\", \"abc\").unwrap_or(0 - 1) == 0\n  assert index_of(\"abc\", \"z\") == None\n  assert last_index_of(\"abc\", \"z\") == None\n  # an empty needle is at the start, and last is at the end -- which is len,\n  # a position no character occupies\n  assert index_of(\"abc\", \"\").unwrap_or(0 - 1) == 0\n  assert last_index_of(\"abc\", \"\").unwrap_or(0 - 1) == 3\n  assert index_of(\"\", \"\").unwrap_or(0 - 1) == 0\n  assert index_of(\"\", \"a\") == None\n  # a code-point index, so the astral character before the needle counts once\n  assert index_of(\"😀x\", \"x\").unwrap_or(0 - 1) == 1\n  assert last_index_of(\"x😀x\", \"x\").unwrap_or(0 - 1) == 2\n  assert contains(\"abcdef\", \"cd\")\n  assert contains(\"abc\", \"\")\n  assert not contains(\"abc\", \"cb\")\n}\n\ntest \"split yields one more piece than there were separators\" {\n  assert join(split(\"a,b,c\", \",\"), \"|\") == \"a|b|c\"\n  # a separator that is not there leaves one piece, which is the whole string\n  assert join(split(\"abc\", \",\"), \"|\") == \"abc\"\n  # adjacent, leading and trailing separators each yield an empty piece\n  assert join(split(\"a,,b\", \",\"), \"|\") == \"a||b\"\n  assert join(split(\",a,\", \",\"), \"|\") == \"|a|\"\n  assert join(split(\",\", \",\"), \"|\") == \"|\"\n  assert join(split(\"\", \",\"), \"|\") == \"\"\n  # a multi-character separator matches as a whole, and overlapping runs of it\n  # are consumed left to right without backtracking\n  assert join(split(\"a--b---c\", \"--\"), \"|\") == \"a|b|-c\"\n  # the empty separator is `chars`\n  assert join(split(\"a中😀\", \"\"), \"|\") == \"a|中|😀\"\n  assert join(split(\"\", \"\"), \"|\") == \"\"\n}\n\ntest \"split_once and rsplit_once cut in two, or answer None\" {\n  assert split_once(\"k=v\", \"=\") == Some((\"k\", \"v\"))\n  assert split_once(\"k=v=w\", \"=\") == Some((\"k\", \"v=w\"))\n  assert rsplit_once(\"k=v=w\", \"=\") == Some((\"k=v\", \"w\"))\n  # \"there was no separator\" is an answer `split` cannot give: it and\n  # `split_once(\"a=\", \"=\")` would both be one-piece results\n  assert split_once(\"abc\", \"=\") == None\n  assert rsplit_once(\"abc\", \"=\") == None\n  assert split_once(\"=v\", \"=\") == Some((\"\", \"v\"))\n  assert split_once(\"k=\", \"=\") == Some((\"k\", \"\"))\n  assert split_once(\"=\", \"=\") == Some((\"\", \"\"))\n  # a multi-character separator is consumed whole, and the empty one is at the\n  # start (`cursor.find` finds it there), so it cuts before the first character\n  assert split_once(\"a--b--c\", \"--\") == Some((\"a\", \"b--c\"))\n  assert rsplit_once(\"a--b--c\", \"--\") == Some((\"a--b\", \"c\"))\n  assert split_once(\"abc\", \"\") == Some((\"\", \"abc\"))\n  assert rsplit_once(\"abc\", \"\") == Some((\"abc\", \"\"))\n  assert split_once(\"\", \"\") == Some((\"\", \"\"))\n  assert split_once(\"\", \"a\") == None\n  # the halves are cut by character: an astral separator is not split, and\n  # neither is an astral character next to one\n  assert split_once(\"a😀b\", \"😀\") == Some((\"a\", \"b\"))\n  assert split_once(\"😀=😀\", \"=\") == Some((\"😀\", \"😀\"))\n}\n\ntest \"replace is split then join, and an empty needle splices between characters\" {\n  assert replace(\"a,b,c\", \",\", \";\") == \"a;b;c\"\n  assert replace(\"aaa\", \"a\", \"bb\") == \"bbbbbb\"\n  assert replace(\"abc\", \"z\", \"!\") == \"abc\"\n  assert replace(\"a,b\", \",\", \"\") == \"ab\"\n  assert replace(\"\", \"a\", \"b\") == \"\"\n  # non-overlapping, left to right: the second `aa` starts after the first ends\n  assert replace(\"aaaa\", \"aa\", \"x\") == \"xx\"\n  assert replace(\"aaa\", \"aa\", \"x\") == \"xa\"\n  assert replace(\"ab\", \"\", \"-\") == \"a-b\"\n}\n\ntest \"slice, take and drop clamp their ends instead of panicking\" {\n  assert slice(\"abcdef\", 1, 4) == \"bcd\"\n  assert slice(\"abcdef\", 0, 6) == \"abcdef\"\n  assert slice(\"abcdef\", 4, 1) == \"\"\n  assert slice(\"abcdef\", 3, 3) == \"\"\n  assert slice(\"abcdef\", 0 - 5, 2) == \"ab\"\n  assert slice(\"abcdef\", 4, 99) == \"ef\"\n  assert slice(\"abcdef\", 99, 200) == \"\"\n  assert slice(\"\", 0, 5) == \"\"\n  assert take(\"abcdef\", 2) == \"ab\"\n  assert take(\"abcdef\", 0) == \"\"\n  assert take(\"abcdef\", 99) == \"abcdef\"\n  assert take(\"abcdef\", 0 - 1) == \"\"\n  assert drop(\"abcdef\", 2) == \"cdef\"\n  assert drop(\"abcdef\", 0) == \"abcdef\"\n  assert drop(\"abcdef\", 99) == \"\"\n  assert drop(\"abcdef\", 0 - 1) == \"abcdef\"\n  # the cut is between characters: an astral one is never halved\n  assert take(\"a😀z\", 2) == \"a😀\"\n  assert drop(\"a😀z\", 1) == \"😀z\"\n  assert slice(\"a😀z\", 1, 2) == \"😀\"\n}\n\ntest \"at asserts the index exists -- it is the one that panics\" {\n  assert at(\"abc\", 0) == 'a'\n  assert at(\"abc\", 2) == 'c'\n  assert at(\"😀\", 0) == '😀'\n  assert at(\"a😀z\", 2) == 'z'\n  # spec 4.8 criterion 1: `i` is a position the caller says exists, so a miss\n  # is a broken invariant and not a branch. `slice`/`take`/`drop` above are\n  # criterion 3 and clamp; this one does not, and that difference is the pin.\n  match catch_panic(() => at(\"abc\", 3)) {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  match catch_panic(() => at(\"abc\", 0 - 1)) {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  match catch_panic(() => at(\"\", 0)) {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n}\n\ntest \"pad_start and pad_end land exactly on width, or hand the string back\" {\n  assert pad_start(\"7\", 3, \"0\") == \"007\"\n  assert pad_end(\"7\", 3, \"0\") == \"700\"\n  # already wide enough, and wider than asked: unchanged, never truncated\n  assert pad_start(\"abcd\", 4, \"0\") == \"abcd\"\n  assert pad_start(\"abcd\", 2, \"0\") == \"abcd\"\n  assert pad_end(\"abcd\", 2, \"0\") == \"abcd\"\n  # an empty filler cannot reach the width, so it hands the string back\n  assert pad_start(\"ab\", 8, \"\") == \"ab\"\n  assert pad_end(\"ab\", 8, \"\") == \"ab\"\n  assert pad_start(\"\", 3, \"x\") == \"xxx\"\n  # a multi-character filler cycles and is cut mid-cycle to hit the width\n  assert pad_start(\"x\", 6, \"ab\") == \"ababax\"\n  assert pad_end(\"x\", 6, \"ab\") == \"xababa\"\n  assert pad_start(\"x\", 4, \"ab\") == \"abax\"\n  # width is in code points, so an astral filler counts one per character\n  assert pad_start(\"x\", 3, \"😀\") == \"😀😀x\"\n  assert len(pad_start(\"x\", 3, \"😀\")) == 3\n}\n\ntest \"trim removes whitespace at the ends and nothing in the middle\" {\n  assert trim(\"  ab  \") == \"ab\"\n  assert trim_start(\"  ab  \") == \"ab  \"\n  assert trim_end(\"  ab  \") == \"  ab\"\n  assert trim(\"ab\") == \"ab\"\n  assert trim(\"\") == \"\"\n  assert trim(\"   \") == \"\"\n  assert trim_start(\"   \") == \"\"\n  assert trim_end(\"   \") == \"\"\n  assert trim(\" a b \") == \"a b\"\n  assert trim(\"\\t\\n ab \\r\\n\") == \"ab\"\n  # not whitespace: an astral character at either end survives\n  assert trim(\" 😀 \") == \"😀\"\n}\n\ntest \"case mapping is simple and 1:1 -- the code-point count never moves\" {\n  assert to_lower(\"ABC\") == \"abc\"\n  assert to_upper(\"abc\") == \"ABC\"\n  assert to_lower(\"AbC1!\") == \"abc1!\"\n  assert to_upper(\"\") == \"\"\n  # the documented refusal: full mapping would make this \"SS\", and full\n  # mapping is locale- and context-sensitive, so it is not this function\n  assert to_upper(\"ß\") == \"ß\"\n  assert len(to_upper(\"ß\")) == 1\n  # a script without case passes through\n  assert to_upper(\"中文\") == \"中文\"\n  assert to_lower(\"中文\") == \"中文\"\n  assert to_upper(\"😀\") == \"😀\"\n}\n\ntest \"chars, reverse and repeat keep a surrogate pair whole\" {\n  assert join(chars(\"abc\"), \"|\") == \"a|b|c\"\n  assert join(chars(\"\"), \"|\") == \"\"\n  assert join(chars(\"a中😀\"), \"|\") == \"a|中|😀\"\n  assert reverse(\"abc\") == \"cba\"\n  assert reverse(\"\") == \"\"\n  assert reverse(\"a\") == \"a\"\n  # reversed by character: the pair moves as one, and is still one character\n  assert len(reverse(\"a😀z\")) == 3\n  assert reverse(\"a😀z\") == \"z😀a\"\n  assert repeat(\"ab\", 3) == \"ababab\"\n  assert repeat(\"ab\", 2) == \"abab\"\n  assert repeat(\"ab\", 1) == \"ab\"\n  assert repeat(\"ab\", 0) == \"\"\n  assert repeat(\"ab\", 0 - 2) == \"\"\n  assert repeat(\"\", 5) == \"\"\n  # the odd/even split of the doubling loop, at every arity a carry can reach\n  assert repeat(\"x\", 5) == \"xxxxx\"\n  assert repeat(\"x\", 6) == \"xxxxxx\"\n  assert repeat(\"x\", 7) == \"xxxxxxx\"\n  assert repeat(\"x\", 8) == \"xxxxxxxx\"\n  assert repeat(\"😀\", 3) == \"😀😀😀\"\n  assert len(repeat(\"😀\", 3)) == 3\n  assert from_char('😀') == \"😀\"\n  assert from_char('a') == \"a\"\n  assert at(from_char('中'), 0) == '中'\n}\n\ntest \"repeat needs no stack, at a count that used to exhaust it\" {\n  # The count here is chosen against the stack, and is the only assertion in\n  # this block the old implementation fails. `s ++ repeat(s, n - 1)` is one\n  # frame per repetition: it dies past n = 4000 under a default -Xss, but the\n  # test runner forks programs with -Xss512m, where it survives to about 8.2\n  # million. So a count that catches it has to clear that, and 9 million does --\n  # measured, on both backends. A one-character unit keeps it affordable: 0.1s\n  # and 9 MB, against 1.8s for the same count of \"ab\".\n  #\n  # First in the block on purpose. The implementation it guards against is also\n  # quadratic, so putting the cheaper assertions ahead of this one would make a\n  # reverted `repeat` grind through them for minutes before reaching the\n  # assertion that actually indicts it.\n  #\n  # If a future runtime gets deeper stacks this stops distinguishing the two\n  # implementations, but it degrades into an ordinary large-input test rather\n  # than into a false red.\n  let deep = repeat(\"a\", 9000000)\n  assert len(deep) == 9000000\n  assert take(deep, 3) == \"aaa\"\n  assert drop(deep, 8999997) == \"aaa\"\n\n  # Content at scale, with a two-character unit so the assertions can see the\n  # repetitions line up rather than just counting characters. Asserted through\n  # the length and three windows -- comparing the whole 200000-character answer\n  # would put it in the failure report.\n  let big = repeat(\"ab\", 100000)\n  assert len(big) == 200000\n  assert take(big, 6) == \"ababab\"\n  assert drop(big, 199994) == \"ababab\"\n  assert slice(big, 99999, 100003) == \"baba\"\n  assert repeat(\"ab\", 100000) == repeat(\"ab\", 99999) ++ \"ab\"\n}\n\ntest \"for over a String walks it one code point at a time\" {\n  var seen = \"\"\n  var n = 0\n  for ch in \"a中😀\" {\n    seen = seen ++ \"[\" ++ ch ++ \"]\"\n    n = n + 1\n  }\n  assert n == 3\n  assert seen == \"[a][中][😀]\"\n  var empty = 0\n  for _ch in \"\" { empty = empty + 1 }\n  assert empty == 0\n}\n")
  } else if name == "char.dawn" {
    Some("## Characters: the type `'a'` is heading for, and the questions worth asking\n## about one (spec §1.5, §11).\n#\n# Short names, module-qualified at the call site: `use std/char`, then\n# `char.code(c)` / `char.is_digit(c)`.\n#\n# `Char` is an opaque type over `Int` minted by the compiler (`types.ty_char`)\n# because character literals need a type before any module is in scope. This\n# module is its owner, which is what lets the two conversions below stay two\n# lines instead of two intrinsics. `==`, `<` and hashing are the Int's, which\n# is what an `opaque type` over Int means and what costs nothing (spec §2.7).\n#\n# Rendering is where this module has an opinion, and it has one at both layers\n# (spec §4.3). `impl Display[Char]` is the top level: `\"\${c}\"` is the\n# character. `impl Show[Char]` is the nested one: a `Char` in a list or a\n# record renders as the source literal `'a'`, the way a nested String renders\n# as `\"a\"`. Writing an impl of its own is the ordinary thing an opaque type\n# may do (spec §2.7 names `impl Show[UserId]`); what it costs is that `Char`\n# is no longer an *example* of \"an opaque type is its target\", which is why\n# `scripts/opaque-twin/char.dawn` pins both layers against the Int explicitly.\n#\n# The predicates are `char_is_*` intrinsics underneath, table-driven from the\n# compiler's own Unicode class table (selfhost/src/embed/unicode_class.dawn), so the\n# answers do not move when the host JDK does.\n\nuse std/cursor\nuse std/str\n\n## The code point `c` stands for.\npub fn code(c: Char) -> Int = c\n\n## The character with code point `n`, or `None` when `n` is not one.\n##\n## `Option` rather than a panic because \"is this integer a character\" is a\n## question with a legitimate negative answer -- it is exactly what a parser\n## reading a `\\u` escape needs to ask (spec §4.8, criterion 2). The bulk\n## conversion `from_code_points` is not asking, and keeps its panic.\n##\n## Not a Unicode scalar value: negative, above U+10FFFF, or in the surrogate\n## range D800..DFFF. Those last are halves of a UTF-16 pair and never stand\n## for a character on their own, which is the whole reason `Cursor` exists.\npub fn of(n: Int) -> Option[Char] =\n  if n < 0 || n > 0x10FFFF || (n >= 0xD800 && n <= 0xDFFF) { None } else { Some(n) }\n\n## Whether `c` is a letter.\npub fn is_letter(c: Char) -> Bool = char_is_letter(c)\n\n## Whether `c` is a decimal digit.\npub fn is_digit(c: Char) -> Bool = char_is_digit(c)\n\n## Whether `c` is a letter or a digit.\npub fn is_alnum(c: Char) -> Bool = char_is_alnum(c)\n\n## Whether `c` is an upper-case letter.\npub fn is_upper(c: Char) -> Bool = char_is_upper(c)\n\n## Whether `c` is a lower-case letter.\npub fn is_lower(c: Char) -> Bool = char_is_lower(c)\n\n## Whether `c` is whitespace.\npub fn is_space(c: Char) -> Bool = char_is_space(c)\n\n## What `to_string` and `\${...}` make of a character: the one-character string.\n##\n## `Display` is the top-level rendering and nothing else consumes it, so this\n## impl says \"a character reads as itself\" without saying anything about the\n## nested one, which is the `Show` below.\n##\n## `str.from_char` is the same string asked for by name, and stays: this impl\n## is the rendering, not a replacement for the function.\nimpl Display[Char] {\n  fn display(c: Char) -> String = str.from_char(c)\n}\n\n## What a character looks like inside a structure: the source literal `'a'`.\n##\n## The nested layer renders a value so that it reads back as source, which is\n## why a nested String carries its quotes (spec §4.3). A character is the same\n## question with a different delimiter, and answering it with the code point\n## instead made a `List[Char]` print exactly like a `List[Int]`.\n##\n## The escape set is the one `lex_escape` accepts, so the output is a literal\n## the lexer would take back. It is deliberately the same five the nested\n## String escapes, minus `\"` (not a delimiter here) plus `'` (which is): a\n## backslash first, or the quote escape it introduces gets doubled.\nimpl Show[Char] {\n  fn show(c: Char) -> String = \"'\" ++ escaped(c) ++ \"'\"\n}\n\nfn escaped(c: Char) -> String =\n  match c {\n    '\\\\' -> \"\\\\\\\\\"\n    '\\'' -> \"\\\\'\"\n    '\\n' -> \"\\\\n\"\n    '\\t' -> \"\\\\t\"\n    '\\r' -> \"\\\\r\"\n    _ -> str.from_char(c)\n  }\n\n# ---- tests ----\n#\n# These tests exercise the explicit `Char`/`Int` boundary. Nothing below\n# assumes the two types are interchangeable (spec §1.5).\n\ntest \"of admits the scalar values and refuses the rest\" {\n  assert code(of(97).expect(\"a\")) == 97\n  assert code(of(0).expect(\"nul\")) == 0\n  assert code(of(0x10FFFF).expect(\"max\")) == 0x10FFFF\n  assert of(-1) == None\n  assert of(0x110000) == None\n  # the surrogate halves: legal UTF-16 units, never characters\n  assert of(0xD800) == None\n  assert of(0xDBFF) == None\n  assert of(0xDC00) == None\n  assert of(0xDFFF) == None\n  # and the code points on either side of that hole are fine\n  assert of(0xD7FF) != None\n  assert of(0xE000) != None\n}\n\ntest \"a literal is a character, and code is the way back to Int\" {\n  assert code('a') == 97\n  assert code('\\n') == 10\n  assert code('中') == 0x4E2D\n  assert code('😀') == 0x1F600\n  assert of(97) == Some('a')\n  # equality, ordering and hashing come from the target type, which is what an\n  # opaque type over Int means. Hashing is the third of those and needs a\n  # Map, which is checked after this module -- so std/map's tests pin \"a\n  # character can be a Map key\" and these two pin the other two.\n  assert 'a' == 'a'\n  assert 'a' != 'b'\n  assert 'a' < 'b'\n  # match on a character is match on its target\n  let name = match 'x' {\n    'x' -> \"ex\"\n    _ -> \"other\"\n  }\n  assert name == \"ex\"\n}\n\ntest \"a character renders as itself on top and as a literal inside\" {\n  # the Display impl above, which is the whole top-level rendering\n  assert to_string('a') == \"a\"\n  assert \"\${'中'}\" == \"中\"\n  assert \"\${'😀'}\" == \"😀\"\n  assert to_string('\\n') == \"\\n\"\n  # the same string `str.from_char` answers with, by construction\n  assert \"\${'中'}\" == str.from_char('中')\n  # and the Show impl, which is the nested one. A tuple is the only structure\n  # available here -- List's `Show` impl is std/list, which is checked after\n  # this module.\n  assert show('a') == \"'a'\"\n  assert to_string(('a', 'b')) == \"('a', 'b')\"\n  # the two layers disagree, which is the whole reason there are two\n  assert show('a') != to_string('a')\n  # neither layer is the Int's any more, and that is what stopped a nested\n  # Char from printing like a nested Int\n  assert show('a') != show(code('a'))\n  assert to_string(('a', 'b')) != to_string((97, 98))\n}\n\ntest \"the nested literal escapes exactly what the lexer would read back\" {\n  assert show('\\\\') == \"'\\\\\\\\'\"\n  assert show('\\'') == \"'\\\\''\"\n  assert show('\\n') == \"'\\\\n'\"\n  assert show('\\t') == \"'\\\\t'\"\n  assert show('\\r') == \"'\\\\r'\"\n  # `\"` is not a delimiter inside single quotes, so it stays as it is -- the\n  # one place this set differs from the nested String's\n  assert show('\"') == \"'\\\"'\"\n  # nothing else is escaped, including outside the BMP\n  assert show('中') == \"'中'\"\n  assert show('😀') == \"'😀'\"\n}\n\ntest \"the predicates read the compiler's Unicode table, not the host's\" {\n  assert is_letter('a')\n  assert is_letter('中')\n  assert not is_letter('1')\n  assert is_digit('7')\n  assert not is_digit('a')\n  assert is_alnum('a')\n  assert is_alnum('7')\n  assert not is_alnum(' ')\n  assert is_upper('A')\n  assert not is_upper('a')\n  assert is_lower('a')\n  assert not is_lower('A')\n  assert is_space(' ')\n  assert is_space('\\t')\n  assert is_space('\\n')\n  assert not is_space('a')\n}\n\ntest \"the walk over a string hands out characters\" {\n  let s = \"a中😀\"\n  assert str.at(s, 0) == 'a'\n  assert str.at(s, 1) == '中'\n  assert str.at(s, 2) == '😀'\n  assert code_points(s) == ['a', '中', '😀']\n  assert from_code_points(['a', 'b']) == \"ab\"\n  # cursor.char stays an Int: it answers -1 at the end, and a sentinel that is\n  # not a code point cannot live in a type whose every value is one (spec §4.8,\n  # nominal-types-design.md §7.3)\n  assert cursor.char(s, cursor.start(s)) == 97\n  assert cursor.char(s, cursor.end(s)) == -1\n}\n")
  } else if name == "fmt.dawn" {
    Some("## The language's own number rendering and parsing: `to_string(Float)` and\n## the `parse_*` family are answered here, by Dawn source rather than by\n## whichever host is running (spec §4.3 and §11's grammar).\n#\n# `to_string(Float)` is answered here, by a Dawn port of the Schubfach\n# algorithm (Giulietti, \"The Schubfach way to render doubles\"; the same\n# algorithm OpenJDK's `Double.toString` has used since JDK 19). Both backends\n# and the comptime interpreter call this one definition, so the answer no\n# longer depends on which host happens to be running — it is pinned by spec\n# §4.3, byte for byte. The C runtime's `%.17g` approximation and the JVM's\n# `String.valueOf(double)` used to be two different answers to the same\n# question (audit RP-01); this module is the one answer.\n#\n# `parse_int` / `parse_float` / `parse_int_radix` are answered here too\n# (audit RP-05): the accepted language is the EBNF in spec §11, checked by\n# this module's own scanner, never by a host parser's grammar. The one thing\n# still delegated is the final decimal-to-binary conversion of a *validated*\n# float string (`parse_float` below), because correct rounding of decimal\n# strings is a large algorithm both hosts already implement identically on\n# the validated subset.\n#\n# Rendering discipline: nothing in this module may render a Float with\n# `to_string` or `\${...}` — lowering rewrites those to `fmt.dtoa`, so a use\n# here would be a self-call. Ints are fine (`str_of_int` is a backend\n# intrinsic, not this module).\n\nuse std/char\nuse std/str\nuse std/cursor\nuse std/cursor.{Cursor}\n\n# ---- shared integer helpers ----\n#\n# No module-level consts in here: a comptime fold interprets these bodies as\n# the program's own std Core, and the interpreter resolves const references\n# in the *folding module's* view only -- a std-module const would not be\n# found there. Literals are spelled inline instead (2^63 - 1 in rop()).\n\nfn pow10(e: Int) -> Int =\n  match e {\n    0 -> 1\n    1 -> 10\n    2 -> 100\n    3 -> 1000\n    4 -> 10000\n    5 -> 100000\n    6 -> 1000000\n    7 -> 10000000\n    8 -> 100000000\n    9 -> 1000000000\n    10 -> 10000000000\n    11 -> 100000000000\n    12 -> 1000000000000\n    13 -> 10000000000000\n    14 -> 100000000000000\n    15 -> 1000000000000000\n    16 -> 10000000000000000\n    17 -> 100000000000000000\n    _ -> panic(\"fmt: pow10 out of range\")\n  }\n\n## floor(a * b / 2^64) for 0 <= a, b < 2^63: the high word of the unsigned\n## product, from 32-bit halves. Both call sites keep the operands under 2^63,\n## so the signed/unsigned distinction never bites.\nfn umulh(a: Int, b: Int) -> Int = {\n  let a0 = a & 4294967295\n  let a1 = a >>> 32\n  let b0 = b & 4294967295\n  let b1 = b >>> 32\n  let lo = a0 * b0\n  let m1 = a1 * b0\n  let m2 = a0 * b1\n  let w = (lo >>> 32) + (m1 & 4294967295) + (m2 & 4294967295)\n  (a1 * b1) + (m1 >>> 32) + (m2 >>> 32) + (w >>> 32)\n}\n\n# ---- floor logarithms (multiplier-and-shift, exact over the needed ranges) --\n#\n# floor(e * log10(2)), floor(log10(3/4 * 2^e)) and floor(e * log2(10)) as one\n# multiply and an arithmetic shift. The constants are floor(log10(2) * 2^41),\n# floor(log10(3/4) * 2^41) and floor(log2(10) * 2^38); each identity was\n# checked exhaustively against exact rational arithmetic over |e| <= 1100\n# (flog10*) and |e| <= 350 (flog2pow10), which covers every exponent a double\n# can put through them.\n\nfn flog10pow2(e: Int) -> Int = (e * 661971961083) >> 41\n\nfn flog10_three_quarters_pow2(e: Int) -> Int = (e * 661971961083 - 274743187321) >> 41\n\nfn flog2pow10(e: Int) -> Int = (e * 913124641741) >> 38\n\n# ---- the powers-of-10 table ----\n#\n# g_pair(i) is the 126-bit significand of 10^(-k) for k = i - 324, split as\n# (high 63 bits, low 63 bits): write 10^(-k) = b * 2^r with 2^125 <= b < 2^126,\n# then the pair encodes g = floor(b) + 1. One entry per k in [-324, 292] —\n# every power a finite double's decimal exponent can ask for. GENERATED from\n# exact rational arithmetic (the table equals OpenJDK MathUtils.g, verified\n# entry for entry); the chunks keep any one function's match small.\n\nfn g_pair(i: Int) -> (Int, Int) =\n  if i < 300 {\n    if i < 100 { g_chunk0(i) } else if i < 200 { g_chunk1(i) } else { g_chunk2(i) }\n  } else {\n    if i < 400 { g_chunk3(i) } else if i < 500 { g_chunk4(i) } else if i < 600 {\n      g_chunk5(i)\n    } else {\n      g_chunk6(i)\n    }\n  }\n\nfn g_chunk0(i: Int) -> (Int, Int) =\n  match i {\n    0 -> (5696189077778435540, 6557778377634271669)\n    1 -> (9113902524445496865, 1269073367360058862)\n    2 -> (7291122019556397492, 1015258693888047090)\n    3 -> (5832897615645117993, 6346230177223303157)\n    4 -> (4666318092516094394, 8766332956520552849)\n    5 -> (7466108948025751031, 8492109508320019073)\n    6 -> (5972887158420600825, 4949013199285060097)\n    7 -> (4778309726736480660, 3959210559428048077)\n    8 -> (7645295562778369056, 6334736895084876923)\n    9 -> (6116236450222695245, 3223115108696946377)\n    10 -> (4892989160178156196, 2578492086957557102)\n    11 -> (7828782656285049914, 436238524390181040)\n    12 -> (6263026125028039931, 2193665226883099993)\n    13 -> (5010420900022431944, 9133629810990300641)\n    14 -> (8016673440035891111, 9079784475471615541)\n    15 -> (6413338752028712889, 5419153173006337271)\n    16 -> (5130671001622970311, 6179996945776024979)\n    17 -> (8209073602596752498, 6198646298499729642)\n    18 -> (6567258882077401998, 8648265853541694037)\n    19 -> (5253807105661921599, 1384589460720489745)\n    20 -> (8406091369059074558, 5904691951894693915)\n    21 -> (6724873095247259646, 8413102376257665455)\n    22 -> (5379898476197807717, 4885807493635177203)\n    23 -> (8607837561916492348, 438594360332462878)\n    24 -> (6886270049533193878, 4040224303007880625)\n    25 -> (5509016039626555102, 6921528257148214824)\n    26 -> (8814425663402488164, 3695747581953323071)\n    27 -> (7051540530721990531, 48012724729336136
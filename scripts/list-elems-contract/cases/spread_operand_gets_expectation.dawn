# The element type crosses the `..`: the operand is expected to be a List of
# it, which is the only thing that can type the empty literal inside.
#
# No annotation anywhere: `x` is the only thing that settles the element type,
# so the expectation the empty literal receives can only have come through the
# spread. An annotated binding would have typed it without any of that.
fn f(x: Int) -> Int = {
  let out = [x, ..[]]
  len(out)
}

pub fn main() -> Unit = ()

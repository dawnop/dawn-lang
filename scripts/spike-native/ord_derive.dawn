# `derive Ord`, which no corpus covered until now (measured 2026-07-26).
#
# The gap that absence hid was not a panic. The C backend emitted a *call* to
# `impl$0$Adt<n>$cmp` and never defined it, so the program failed at link time
# with an undefined symbol -- no diagnostic, no `not implemented`, nothing for
# a reader to find. The reason was that the derived body was not lowered at
# all: `emit.dawn` wrote it directly as JVM bytecode, so Core never carried it
# and the other backend had nothing to compile. It is lowered now, which is
# what this file watches.
#
# `derive Show` is the same shape and still listed in known-red; this is its
# sibling, and how it will be closed.
#
# Covered here: a record (fields left to right), a tagged union (constructor
# order first, then fields), a nested one whose fields are themselves derived,
# the relation reached through an `[T: Ord]` bound rather than directly -- the
# two doors that have to give the same answer -- and `derive Ord` on a generic
# type, which was refused outright until the body became something that can
# take a dictionary.
use std/io

pub type Point = { x: Int, y: Int } derive Ord

pub type Shape = | Dot | Line(a: Int, b: Int) | Named(s: String) derive Ord

pub type Nested = { at: Point, what: Shape } derive Ord

## `derive Ord` on a generic type: `Box[T]` orders exactly as far as `T` does.
pub type Box[T] = { v: T } derive Ord

pub type Two[A, B] = { l: A, r: B } derive Ord

pub type Maybe[T] = | Nothing | Just(v: T) derive Ord

fn sign(n: Int) -> String =
  if n < 0 { "lt" } else if n > 0 { "gt" } else { "eq" }

fn direct(label: String, n: Int) -> String = label ++ ": " ++ sign(n)

## The other door: the same relation reached through a bound, so a dictionary
## carries it instead of the call site naming the impl.
fn through[T: Ord](label: String, a: T, b: T) -> String =
  label ++ ": " ++ sign(cmp(a, b))

pub fn main() -> Unit !io = {
  let p11 = Point { x: 1, y: 1 }
  let p12 = Point { x: 1, y: 2 }
  let p21 = Point { x: 2, y: 1 }

  println("-- record: fields left to right --")
  println(direct("cmp(p11, p12)", cmp(p11, p12)))
  println(direct("cmp(p21, p12)", cmp(p21, p12)))
  println(direct("cmp(p11, p11)", cmp(p11, p11)))

  println("-- union: constructor order first --")
  println(direct("cmp(Dot, Line)  ", cmp(Dot, Line(0, 0))))
  println(direct("cmp(Line, Named)", cmp(Line(9, 9), Named("a"))))
  println(direct("cmp(Line, Line) ", cmp(Line(1, 2), Line(1, 3))))
  println(direct("cmp(Named,Named)", cmp(Named("b"), Named("a"))))

  println("-- nested: a derived field --")
  let n1 = Nested { at: p11, what: Line(1, 2) }
  let n2 = Nested { at: p11, what: Line(1, 3) }
  let n3 = Nested { at: p12, what: Dot }
  println(direct("cmp(n1, n2)", cmp(n1, n2)))
  println(direct("cmp(n1, n3)", cmp(n1, n3)))

  println("-- through a bound --")
  println(through("through(p11, p12)", p11, p12))
  println(through("through(n1, n2)  ", n1, n2))
  println(through("through(Dot, Dot)", Dot, Dot))

  println("-- derived on a generic type --")
  println(direct("cmp(Box 1, Box 2)  ", cmp(Box { v: 1 }, Box { v: 2 })))
  println(direct("cmp(Box p12, Box p11)", cmp(Box { v: p12 }, Box { v: p11 })))
  println(direct("cmp(Two, Two)      ",
    cmp(Two { l: 1, r: "a" }, Two { l: 1, r: "b" })))
  println(direct("cmp(Just, Nothing) ", cmp(Just(0), Nothing)))
  println(direct("cmp(Box Box, Box Box)",
    cmp(Box { v: Box { v: 3 } }, Box { v: Box { v: 3 } })))

  println("-- generic, and through a bound: the dictionary travels --")
  println(through("through(Box 1, Box 2)", Box { v: 1 }, Box { v: 2 }))
  println(through("through(Just Box, Just Box)", Just(Box { v: 5 }), Just(Box { v: 4 })))
}

# parameter defaults (#207): `= expr` after the type, any expression, and not
# only in tail position. Parse-only -- which declarations *consume* a default
# is the checker's decision (the trait method here is a type error, not a
# syntax error).
fn column(kids: List[Int], align: Int = 0, gap: Int = 2 + 2) -> Int = align + gap

fn head_default(fill: String = ", ", s: String) -> String = fill ++ s

fn call_default(mark: String = stamp(), n: Int = len([1, 2])) -> Int = n

fn lambda_default(on_click: fn(Int) -> Int = x => x) -> Int = on_click(1)

fn stamp() -> String = "s"

trait Shape[T] {
  fn area(self: T, scale: Int = 1) -> Int
}

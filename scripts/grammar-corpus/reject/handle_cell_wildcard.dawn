# expect: `var _` is meaningless
# expect: a trailing closure must use a tail block
# expect: allowed at module top level
# `var _` is refused inside a handler for the reason it is refused in a block
# (`let_stmt`): a cell exists to be read back, and `_` names nothing to read.
effect Ask {
  fn ask() -> Int
}

fn f() -> Int = {
  with handle Ask {
    var _: Int = 0
    ask() => 1
  }
  ask()
}

## ADT ids declared by `cls` (and not yet emitted), in id order.
fn own_adts_of(adts: Adts, cls: String, seen: Set[String]) -> List[Int] = {
  var out: List[Int] = []
  for aid in sort(map.keys(adts)) {
    let a = adt_of(adts, aid)
    let is_own = match a.owner {
      Some(o) -> o == cls
      None -> false
    }
    if is_own && not set.has(seen, adt_jvm_name(a)) { out = out ++ [aid] }
  }
  out
}

## Trait ids declared by `cls`, in id order.
fn own_trait_ids(traits: Traits, cls: String) -> List[Int] = {
  var out: List[Int] = []
  for tid in sort(map.keys(traits)) {
    let is_own = match trait_of(traits, tid).owner {
      Some(o) -> o == cls
      None -> false
    }
    if is_own { out = out ++ [tid] }
  }
  out
}

## Add a prelude trait to the set whose interface the program needs. Ord is
## unconditional and its methods are reached by name, so it is never wanted
## here; a user trait's interface comes from the module that declares it.
##
## Read off `prelude_trait_ids()` rather than transcribed. The transcription
## was the sixth copy of the prelude set and the one #119 missed when it
## collapsed the other five, which is a worse miss than it looks: forgetting a
## trait here is not a compile error but a `NoClassDefFoundError` at run time,
## because the dictionary class implements an interface nobody emitted.
fn want_iface(wants: List[Int], tid: Int) -> List[Int] = {
  if tid == ORD_ID { return wants }
  var prelude = false
  for p in prelude_trait_ids() {
    if p == tid { prelude = true }
  }
  if not prelude { return wants }
  for w in wants {
    if w == tid { return wants }
  }
  wants ++ [tid]
}

## Whether any module of the program imports the named Java class.
fn imports_java(cx0: Cx, fqcn: String) -> Bool = {
  for pr in map.entries(cx0.java_classes) {
    let (_simple, name) = pr
    if name == fqcn { return true }
  }
  false
}

## Whether ASM will be on the built program's class path.
##
## `dawn/rt/Asm` names `org/objectweb/asm/ClassWriter`, which no ordinary
## program has -- and emitting a class that references an absent type into
## every program is a cost paid by everyone for a class only the compiler
## itself can use. A resolved `ClassWriter` import proves ASM is present;
## explicit imports of either generated bridge make the same promise and must
## also make emission match what target-scoped checking accepted.
fn program_has_asm(std_mods: List[(String, Cx, TModule, CtOut)], mods: List[CheckedMod]) -> Bool = {
  for sm in std_mods {
    let (_cls, cx0, _tm, _ct) = sm
    if imports_java(cx0, "org.objectweb.asm.ClassWriter") ||
      imports_java(cx0, "dawn.rt.Asm") || imports_java(cx0, "dawn.rt.AsmWriter") {
        return true
      }
  }
  for cm in mods {
    if imports_java(cm.cx, "org.objectweb.asm.ClassWriter") ||
      imports_java(cm.cx, "dawn.rt.Asm") || imports_java(cm.cx, "dawn.rt.AsmWriter") {
        return true
      }
  }
  false
}

## Whether the program can suspend: does any module declare a `ctl` effect?
##
## Conditional for the reason ASM is (above), and the reason is sharper here.
## `dawn/rt/Ctl` names `jdk/internal/vm/Continuation`, which is in `java.base`
## but not exported: reaching it needs the `Add-Exports` this compiler writes
## into the manifest and onto a spawned JVM's command line. A program that
## never suspends should not carry that reference at all -- not because it
## would fail to load (it would not; resolution is lazy), but because every jar
## would then name an internal API it has no use for, and every tool that reads
## a jar's references would have to be told why.
##
## The declaration is the signal rather than the arms, because that is what §11.6
## S1 made suspendability a property of: a `ctl` effect whose handlers all
## happen to be tail-resumptive emits three classes it never enters, which costs
## a jar entry and nothing else.
fn program_has_ctl(std_mods: List[(String, Cx, TModule, CtOut)], mods: List[CheckedMod]) -> Bool = {
  for sm in std_mods {
    let (_cls, cx0, _tm, _ct) = sm
    if cx_declares_ctl(cx0) { return true }
  }
  for cm in mods {
    if cx_declares_ctl(cm.cx) { return true }
  }
  false
}

fn cx_declares_ctl(cx0: Cx) -> Bool = {
  for pr in map.entries(cx0.effect_infos) {
    let (_id, i) = pr
    if i.ctl { return true }
  }
  false
}

## The platform's class-path separator — ':' on Unix, ';' on Windows.
##
## `dawn --help` has said "platform path separator" since the beginning while
## every split and join in this file hardcoded ':'. On Windows that tears
## `C:\lib\a.jar` in half at the drive letter, and the halves are then two
## nonexistent class-path entries. java.io.File already knows the answer, so
## nothing here has any business guessing it.
fn path_sep() -> String !io = File.pathSeparator!

## Write one class file, reporting the first I/O failure instead of hiding it.
##
## Both java_try results used to be discarded. A full disk, a read-only output
## directory or a path the filesystem rejects then produced no message at all:
## the build "succeeded" with classes missing, and the failure resurfaced much
## later as a NoClassDefFoundError naming something the user never wrote — or
## did not resurface, and shipped a jar with a hole in it. The path and the real
## exception are both worth having at the moment they are known.
fn write_class(dir: String, name: String, bs: Bytes) -> Result[Unit, String] !Fs = {
  let path = dir ++ "/" ++ name ++ ".class"
  let parent = match str.last_index_of(path, "/") {
    Some(i) -> str.take(path, i)
    None -> dir
  }
  match io.mkdirs(parent) {
    Err(m) -> Err("cannot create " ++ parent ++ ": " ++ m.message)
    Ok(_) ->
      match io.write_bytes(path, bs) {
        Err(m) -> Err("cannot write " ++ path ++ ": " ++ m.message)
        Ok(_) -> Ok(())
      }
  }
}

## Full program emission — shared runtime, prelude ADTs, every std and user
## module class, vendored rt — in a stable order, plus the entry class name
## ("" when no user module declares `fn main`) and, per module with test
## blocks, (class name, module path, test names) in run order. Without a
## target: the runtime subset only.
##
## `std_tests` is `dawn test --stdlib`: the bundled std's own test blocks are
## lowered and emitted, and they are what gets reported. It is off everywhere
## else, so a `dawn build` of a user program carries no std test body — the
## std modules are lowered without them, exactly as before.
fn collect_program(
  target: String,
  std_dir: String,
  opts: CtOpts,
  closure: Bool,
  std_tests: Bool
) -> (List[(String, Bytes)], String, List[(String, String, List[String])]) !Fs !io = {
  var classes: List[(String, Bytes)] = []
  var adts = prelude_adts()
  var mods: List[CheckedMod] = []
  var std_mods: List[(String, Cx, TModule, CtOut)] = []
  if target != "" || std_tests {
    if target != "" {
      if not io.exists(target) {
        cli_error("no such file or directory: " ++ target)
      }
      if io.exists(target) && not io.is_dir(target) && not str.ends_with(target, ".dawn") {
        cli_error("source files must end in .dawn: " ++ target)
      }
    }
    let std = match load_std(std_dir) {
      Ok(sc) -> sc
      Err(e) -> fail_std(e)
    }
    std_mods = std.mods
    for pr in map.entries(std.adts) {
      let (k, v) = pr
      adts = map.insert(adts, k, v)
    }
    # --closure: seed from the entry and follow its use edges only, instead of
    # loading everything under src/ (module-access-design 2.2). The full-load
    # default stays: unreferenced modules still check, which is bit-rot
    # protection worth keeping as the default.
    if target != "" {
      let loaded =
        if closure && io.is_dir(target) {
          let entry_file = target ++ "/src/main.dawn"
          if not io.exists(entry_file) {
            cli_error("--closure needs an entry module (expected " ++ entry_file ++ ")")
          }
          load_file(entry_file)
        } else {
          load_target(std, target)
        }
      let prog = analyze_program(loaded, std, opts, jsig_real())
      if len(prog.diags) > 0 { fail_compile(prog.diags) }
      mods = prog.modules
    }
    for cm in mods {
      for pr in map.entries(cm.cx.adts) {
        let (k, v) = pr
        adts = map.insert(adts, k, v)
      }
    }
  }
  # The hierarchy every frame-computing writer answers from. Built once, here,
  # because it is a fact about the whole program: `adts` is complete at this
  # point and every class below is emitted against the same table.
  let sup = supers_of(adts, sort(map.keys(adts)))
  # one past the widest written parameter list, because a function value's
  # evidence pack is a parameter of the value (`types.fn_arity`): a written
  # `fn(a, b, c, d, e, f, g, h)` is a Fn9
  var n = 0
  while n <= 9 {
    classes = classes ++ [(fn_iface(n), gen_fn_interface(n))]
    n = n + 1
  }
  n = 2
  while n <= 8 {
    classes = classes ++ [(tuple_class(n), gen_tuple_class(sup, n))]
    n = n + 1
  }
  classes = classes ++ [(PANIC_CLASS, gen_panic_class())]
  # The discard poison, for every program and not only for one that suspends:
  # `bracket` tells it from a failure, and every program has a bracket. It
  # names `java/lang/Error` and nothing else, which is what separates it from
  # the three below (see CTL_DISCARD_CLASS).
  classes = classes ++ [(CTL_DISCARD_CLASS, gen_ctl_discard_class())]
  classes = classes ++ [(UNIT_CLASS, gen_unit_class())]
  classes = classes ++ [(SHOW_CLASS, gen_show_class(sup))]
  # dawn/rt/Strings is emitted further down: which Unicode tables it carries
  # depends on what the user's modules can reach, and answering that needs
  # the program tables built below
  classes = classes ++ [(BYTES_CLASS, gen_bytes_class(sup))]
  classes = classes ++ [(ARRAY_CLASS, gen_array_class(sup))]
  classes = classes ++ [(IO_CLASS, gen_io_class(sup))]
  classes = classes ++ [(GPU_CLASS, gen_gpu_class(sup))]
  # The five ASM null adapters, from tree source: every emitter drives its
  # ClassWriter through them (jvm-base-plan §5.7). Conditional because the
  # class names ASM types -- see program_has_asm.
  if program_has_asm(std_mods, mods) {
    classes = classes ++ [(ASM_CLASS, gen_asm_class())]
    # The frame half of the same story: a ClassWriter subclass answering the
    # common-superclass question from the compiler's own hierarchy, which is
    # what COMPUTE_FRAMES needs and what Dawn source cannot express. Since
    # K-A8.2 every writer below is one of these and every `match` on an ADT
    # reaches the callback -- see gen_asm_writer_class, and
    # scripts/asm-adapter-contract for the differential against the reference.
    classes = classes ++ [(ASM_WRITER_CLASS, gen_asm_writer_class())]
  }
  # The driving loop for one-shot resumption, for a program that declares a
  # `ctl` effect (docs/oneshot-design.md §11.3, and program_has_ctl above).
  if program_has_ctl(std_mods, mods) {
    classes = classes ++ [(CTL_CLASS, gen_ctl_class(sup))]
    classes = classes ++ [(CTL_CONT_CLASS, gen_ctl_cont_class(sup))]
    classes = classes ++ [(CTL_K_CLASS, gen_ctl_k_class(sup))]
  }
  classes = classes ++ [(tr_iface(None, "Ord"), gen_ord_interface(sup))]
  classes = classes ++ [(FN_CMP_CLASS, gen_fn_comparator(sup))]
  # the evidence pack joins the three: it is program-wide, owned by no module,
  # and every function value's hidden slot may carry one
  for aid in [OPTION_ID, RESULT_ID, FOREIGN_ERROR_ID, EV_PACK_ID] {
    classes = classes ++ gen_adt(sup, adts, adt_of(adts, aid), no_override())
  }
  # program-wide tables for module emission: traits/impls/fn sigs unioned
  # over std and user modules (ids are unique program-wide)
  var traits: Traits = map.empty()
  var impl_table: Impls = map.empty()
  var prog_fns: Map[(String, String), Sig] = map.empty()
  for sm in std_mods {
    let (cls, cx, _, _) = sm
    for pr in map.entries(cx.traits) {
      let (k, v) = pr
      traits = map.insert(traits, k, v)
    }
    for pr in map.entries(cx.impl_table) {
      let (k, v) = pr
      impl_table = map.insert(impl_table, k, v)
    }
    for pr in map.entries(cx.fns) {
      let (k, v) = pr
      prog_fns = map.insert(prog_fns, (cls, k), v)
    }
  }
  for cm in mods {
    for pr in map.entries(cm.cx.traits) {
      let (k, v) = pr
      traits = map.insert(traits, k, v)
    }
    for pr in map.entries(cm.cx.impl_table) {
      let (k, v) = pr
      impl_table = map.insert(impl_table, k, v)
    }
    for pr in map.entries(cm.cx.fns) {
      let (k, v) = pr
      prog_fns = map.insert(prog_fns, (cm.class_name, k), v)
    }
  }
  # The prelude Eq/Hash/Show trait *interfaces*, and only where a dictionary of
  # that trait can exist -- a program with no `[T: Eq]` carries no Eq
  # machinery. The dictionaries themselves are no longer built here: lowering
  # registers exactly the ones it referenced and emit_module writes those, so
  # this scan survives only for the interfaces, which have no Core
  # representation of their own. (Ord's is unconditional, above.)
  var wants: List[Int] = []
  for pr in map.entries(prog_fns) {
    let (_k, sg) = pr
    # a trait method's own bound on its subject is the declaration, not a use:
    # `eq` is declared `[T: Eq]` and is in every module's fn namespace
    if sg.trait_id != None { continue }
    var i = 0
    for _tp in sg.tparams {
      for b in bounds_of(sg, i) {
        wants = want_iface(wants, b)
      }
      i = i + 1
    }
  }
  # A conditional impl is the other way a dictionary appears: its own
  # dictionary class implements the trait's interface, and the arguments it
  # is built from implement the interfaces its bounds name. A program can
  # reach both without any function ever carrying a bound.
  for pr in map.entries(impl_table) {
    let (_k, imp) = pr
    if len(imp.tparams) == 0 { continue }
    wants = want_iface(wants, imp.trait_id)
    for cs in imp.constraints {
      for b in cs {
        wants = want_iface(wants, b)
      }
    }
  }
  for tid in wants {
    let tr = trait_of(traits, tid)
    classes = classes ++ [(tr_iface(None, tr.name), gen_trait_interface(sup, adts, tr))]
  }

  # Every module's Core, lowered once. `reach` reads it below and emit_module
  # reads it further down -- the same value, not two lowerings that are
  # asserted to agree (docs/audit/re-audit-2026-07-30.md RC-04). Test blocks
  # ride along for the user's modules only, because only those are emitted --
  # unless `dawn test --stdlib` asked for std's, in which case there is no
  # user module and std's are the whole program.
  var std_lm: List[lower.LMod] = []
  for sm in std_mods {
    let (cls, _cx2, tm2, _ct2) = sm
    std_lm = std_lm ++
      [lower.lower_module_full(cls, tm2, traits, impl_table, adts, prog_fns, std_tests)]
  }
  var user_lm: List[lower.LMod] = []
  for cm in mods {
    user_lm = user_lm ++
      [lower.lower_module_full(cm.class_name, cm.tm, traits, impl_table, adts, prog_fns, true)]
  }

  # Which Unicode tables dawn/rt/Strings carries: what the user's modules can
  # reach decides (reach.dawn). Without a target there is no program to reason
  # from, so the runtime-only jar carries everything.
  #
  # `emitted_core`, not `.m`: this path emits the test blocks too, and a table
  # a test alone reaches has to ride or that test dies on a missing method.
  var tuse = reach.all_tables()
  if target != "" {
    var cmods: List[CModule] = []
    var reach_roots: List[String] = []
    for l in std_lm { cmods = cmods ++ [lower.emitted_core(l)] }
    for l in user_lm {
      cmods = cmods ++ [lower.emitted_core(l)]
      reach_roots = reach_roots ++ [l.m.owner]
    }
    tuse = reach.table_use(cmods, reach_roots)
  }
  classes = classes ++ [(STRINGS_CLASS, gen_strings_class(sup, tuse))]

  # const values by declaring module, so importers can materialize them
  var const_vals: Map[String, Map[String, CValue]] = map.empty()
  for sm in std_mods {
    let (cls, _, _, ct) = sm
    const_vals = map.insert(const_vals, cls, ct.consts)
  }
  for cm in mods { const_vals = map.insert(const_vals, cm.mod_path, cm.ct.consts) }
  var seen: Set[String] = set.empty()
  var si = 0
  for sm in std_mods {
    let (cls, cx, tm, ct) = sm
    # std carries no source path or AST here (StdCtx keeps neither), so a std
    # class that outgrows the class file format reports what it always did
    let no_decls: List[Decl] = []
    classes = classes ++ emit_module(sup, adts, traits, impl_table, prog_fns, cls,
      own_trait_ids(cx.traits, cls), own_adts_of(cx.adts, cls, seen),
      tm, std_lm[si], ct, cdriver.merged_consts(cx, ct, const_vals), "", no_decls)
    si = si + 1
    for aid in own_adts_of(cx.adts, cls, seen) {
      seen = set.insert(seen, adt_jvm_name(adt_of(cx.adts, aid)))
    }
  }
  var entry = ""
  var tests_info: List[(String, String, List[String])] = []
  if std_tests {
    for sm in std_mods {
      let (cls, _cx3, tm3, _ct3) = sm
      if len(tm3.tests) > 0 {
        var names: List[String] = []
        for tf in tm3.tests { names = names ++ [tf.name] }
        tests_info = tests_info ++ [(cls, cls, names)]
      }
    }
  }
  var ui = 0
  for cm in mods {
    classes = classes ++ emit_module(sup, adts, traits, impl_table, prog_fns,
      cm.class_name, own_trait_ids(cm.cx.traits, cm.class_name),
      own_adts_of(cm.cx.adts, cm.class_name, seen), cm.tm, user_lm[ui], cm.ct,
      cdriver.merged_consts(cm.cx, cm.ct, const_vals), cm.path, cm.m.decls)
    ui = ui + 1
    for aid in own_adts_of(cm.cx.adts, cm.class_name, seen) {
      seen = set.insert(seen, adt_jvm_name(adt_of(cm.cx.adts, aid)))
    }
    if entry == "" {
      for tf in cm.tm.fns {
        let plain = match tf.impl_of { Some(_) -> false, None -> match tf.default_of { Some(_) -> false, None -> true } }
        if plain && tf.name == "main" { entry = cm.class_name }
      }
    }
    if len(cm.tm.tests) > 0 {
      var names: List[String] = []
      for tf in cm.tm.tests { names = names ++ [tf.name] }
      tests_info = tests_info ++ [(cm.class_name, cm.mod_path, names)]
    }
  }
  for outer in vendor.vendored_outers() {
    classes = classes ++ vendor.rt_class_family(outer)
  }
  (classes, entry, tests_info)
}

## The JVM this process is running on, not whatever `java` PATH resolves to.
##
## Both spawns below continue this run -- one re-execs the same invocation with
## more class path, the other runs the classes this process just emitted -- so
## the JVM that answers should be the one the build chose. It was not: it was
## whatever came first on PATH, which on a machine with a newer JDK installed
## beside the one JAVA_HOME names is a different runtime, silently. That gap is
## measurable rather than theoretical -- a JDK 21 and a JDK 26 disagree about
## 18 code points, which is why the case tables were moved into the compiler in
## the first place (dawn_rt.h's note on dawn_case_range).
##
## `java.home` is the running JVM's own home and is always set, so there is no
## fallback worth arguing about: with it missing the process is not on a JVM.
fn host_java() -> String !io =
  match System.getProperty("java.home") {
    Some(h) -> h ++ "/bin/java"
    None -> "java"
  }

fn host_classpath() -> String !io =
  match System.getProperty("java.class.path") {
    Some(s) -> s
    None -> ""
  }

## The argv prefix shared by every JVM this driver spawns: the child is a
## continuation of this process, so it should be configured like it rather than
## be handed back to JVM ergonomics.
##
## Stated once because the two spawn sites had already drifted apart. One
## propagated the heap ceiling and the other did not, which left `dawn run` and
## `dawn build` executing on a child whose ceiling was MaxRAMPercentage of the
## *host's* RAM -- measured at 4192206848 against a parent pinned to 2 GiB, so
## how much memory a build may use was a property of the machine rather than of
## the workload, which is exactly what pinning -Xmx in bin/dawn exists to deny.
##
## The heap is this JVM's own `-Xmx`, forwarded verbatim, so a re-exec is a
## fixed point: `-Xmx2g` stays `-Xmx2g` however many hops deep it goes. The
## obvious `maxMemory()` is not, and the difference is not cosmetic. It reports
## the heap a program may *fill*, which under a generational collector excludes
## a survivor space, so `-Xmx2g` came back as 2075918336 and each hop shaved
## another 3% off the ceiling. It happened to round-trip under G1 and stopped
## doing so the moment the collector changed, which is how it went unnoticed:
## the shrink is a property of the collector, not of the API. `-Xmx` is what
## the ceiling was actually stated as, so it is what gets passed on.
##
## SerialGC because a compile's resident set is mostly space G1 touched and
## never released: the live set of a hello-world compile stays under 15 MB
## while G1's young generation expands to 810M. That is where the whole saving
## is. Capping the heap here costs nothing and gains nothing on its own; the
## collector took peak RSS from 532 to 390 MB on `run fib` and from 1365 to
## 614 MB on `check selfhost`, at no wall-time cost. Keep this in step with
## bin/dawn's DAWN_JVM_OPTS, which carries the full measurement.
##
## `-Xss512m` is load-bearing, not slack: ir/interp.dawn pins MAX_CALL_DEPTH at
## 100000, which only binds below the real stack limit from -Xss 128m up.
## `--add-exports java.base/jdk.internal.vm=ALL-UNNAMED` is what lets a
## `ctl` handler's driving loop reach `jdk.internal.vm.Continuation`
## (docs/oneshot-design.md §3.5, `jvm/rtclasses.gen_ctl_class`). It is stated
## here and in the jar manifest (`jvm/jarw.write_jar_cp`) because those are the
## two ways a compiled program is started, and neither reads the other: `dawn
## run` and `dawn test` spawn `java -cp`, where a manifest attribute means
## nothing, and `java -jar` takes no options from here. **A user never types
## it.**
##
## Unconditional, and cheap to be: it is one option on a class-path the JVM
## checks once at startup, `jdk.internal.vm` exists on every JDK this compiler
## supports, and a program that never suspends never loads a class that names
## the package. Making it conditional would mean deciding here what the emitter
## decided, from an argv rather than from the program.
fn child_java_cmd() -> List[String] !io =
  [host_java(), "-Xss512m", own_xmx(), "-XX:+UseSerialGC",
    "--add-exports", "java.base/jdk.internal.vm=ALL-UNNAMED"]

## This JVM's `-Xmx` as it was written on its own command line. A JVM started
## without one has no ceiling to state, so the fallback is `maxMemory()`: it is
## the wrong number by a survivor space, but a wrong ceiling still beats
## MaxRAMPercentage of the host's RAM, which is the only other answer.
fn own_xmx() -> String !io = {
  let bean = ManagementFactory.getRuntimeMXBean().expect("runtime mx bean")
  let given = bean.getInputArguments().expect("input arguments")
  var found = ""
  var i = 0
  # last wins, matching the JVM's own reading of a repeated option
  while i < given.size() {
    let arg: Result[String, ForeignError] = cast(given.get(i).expect("argument"))
    match arg {
      Ok(a) -> if str.starts_with(a, "-Xmx") { found = a }
      Err(_) -> ()
    }
    i = i + 1
  }
  if found != "" { return found }
  let rt = Runtime.getRuntime().expect("runtime")
  "-Xmx" ++ to_string(rt.maxMemory())
}

## The toolchain's own help text. It began as the Kotlin cli/Main.kt USAGE
## copied verbatim, and inherited that file's habit of appending each new
## subcommand at the bottom of the list -- which left two entries stranded
## from their descriptions. Continuation lines are the ones starting with 39
## spaces: keep every one of them directly under the entry it describes.
fn usage() -> String = join([
  "dawn — the Dawn language toolchain",
  "",
  "A <target> is a single .dawn file or a project directory (src/main.dawn entry).",
  "A project directory may carry a dawn.toml declaring [java-deps]; run/test/build fetch",
  "those from Maven and put them on the class path automatically.",
  "",
  "usage:",
  "  dawn check <target>...               type-check only; exit 1 if anything is reported",
  "  dawn run [options] <target> [-- <args>...]",
  "                                       compile and run; -- starts program args",
  "  dawn test <target>                   compile with test blocks and run them",
  "  dawn test --stdlib                   run the bundled standard library's own test blocks",
  "  dawn build <target> [-o out.jar]     produce an executable jar (tests stripped)",
  "  dawn build <target> --native [-o out]",
  "                                       package that jar ahead of time with GraalVM",
  "                                       native-image (which must be on PATH). Your code is",
  "                                       still compiled by the JVM backend, so `use java`",
  "                                       and [java-deps] work. This is NOT the C backend:",
  "                                       that one is a separate compiler, `dawnc`",
  "  dawn run/test/build ... --closure    load only the entry's use closure (default: all of src/)",
  "  dawn fmt <file.dawn | dir>...        format files in place (a dir formats all .dawn under it)",
  "  dawn fmt --check <target>...         report files that are not formatted (exit 1 if any)",
  "  dawn doc <target>                    emit the pub API (## doc comments) as JSON on stdout",
  "  dawn doc --stdlib                    emit the standard library reference (the prelude, its",
  "                                       traits, and every std module) as JSON",
  "  dawn doc --builtins                  emit the builtin function reference as JSON",
  "  dawn add <spec> [--subdir <p>] [--as <alias>] [--dir <project>]",
  "                                       add a dependency to dawn.toml, preserving the file's",
  "                                       formatting: a Maven coordinate (group:artifact:version",
  "                                       → [java-deps]), an archive url (fetched and hashed",
  "                                       → [deps.<name>]), or a local package path (→ [deps])",
  "  dawn cache verify                    re-hash every cached package against its name",
  "  dawn lock [--check] [<dir>]          freeze (or verify) the resolved [java-deps] closure",
  "  dawn --version                       print the toolchain version and commit",
  "",
  "options (run/test/build):",
  "  --cp <jars>                          third-party jars for `use java`, separated by the",
  "                                       platform path separator; repeatable. `build` records",
  "                                       them in the jar manifest's Class-Path. Merged with",
  "                                       anything dawn.toml's [java-deps] resolves to.",
  "  --comptime-ffi                       let a const or comptime block fold a `use java` call by",
  "                                       invoking it inside the compiler. Off by default: that is",
  "                                       running the compiled source's code on this machine, so it",
  "                                       is yours to grant, not the source's to take.",
  "",
  "environment:",
  "  DAWN_MAVEN_MIRROR                    Maven repository to fetch [java-deps] from",
  "                                       (default: Maven Central)",
  "",
  "the other compiler:",
  "  dawnc                                the C backend: Dawn to C to cc, and Dawn to wasm,",
  "                                       with no JVM in the compiler or in anything it",
  "                                       produces. A separate binary, not a subcommand here:",
  "                                       take dawnc-linux-x86_64 off the release page, or",
  "                                       compile selfhost/src/nmain.dawn from a source",
  "                                       checkout. It refuses `use java`; run it with no",
  "                                       arguments for its own usage."
], "\n") ++ "\n"

## `--comptime-fuel N` / `--comptime-fuel=N` and `--comptime-ffi`;
## (options, args without the flags).
fn extract_ct_opts(rest: List[String]) -> (CtOpts, List[String]) !io = {
  var fuel = DEFAULT_FUEL
  var ffi = false
  var out: List[String] = []
  var i = 0
  while i < len(rest) {
    let a = rest[i]
    if a == "--comptime-fuel" && i + 1 < len(rest) {
      match parse_int(rest[i + 1]) {
        Some(n) -> { fuel = n }
        None -> { cli_error("--comptime-fuel needs a number") }
      }
      i = i + 2
    } else if str.starts_with(a, "--comptime-fuel=") {
      match parse_int(str.strip_prefix(a, "--comptime-fuel=").unwrap_or(a)) {
        Some(n) -> { fuel = n }
        None -> { cli_error("--comptime-fuel needs a number") }
      }
      i = i + 1
    } else if a == "--comptime-ffi" {
      ffi = true
      i = i + 1
    } else {
      out = out ++ [a]
      i = i + 1
    }
  }
  # this main runs on a JVM, so a granted `--comptime-ffi` gets the real
  # reflective hook; a main without a host would leave the refusing default
  (CtOpts { fuel: fuel, ffi: ffi, jcall: fold_call }, out)
}

## `--cp <jars>` / `--cp=jars`; repeatable, `:`-separated, every entry must
## exist; (jars, args without the flag).
fn extract_cp(rest: List[String]) -> (List[String], List[String]) !Fs !io = {
  var jars: List[String] = []
  var out: List[String] = []
  var i = 0
  while i < len(rest) {
    let a = rest[i]
    var spec = ""
    if a == "--cp" && i + 1 < len(rest) {
      spec = rest[i + 1]
      i = i + 2
    } else if a == "--cp" {
      cli_error("--cp needs a path")
      i = i + 1
    } else if str.starts_with(a, "--cp=") {
      spec = str.strip_prefix(a, "--cp=").unwrap_or(a)
      i = i + 1
    } else {
      out = out ++ [a]
      i = i + 1
    }
    if spec != "" {
      for pth in str.split(spec, path_sep()) {
        if pth != "" {
          if not io.exists(pth) { cli_error("--cp entry not found: " ++ pth) }
          jars = jars ++ [pth]
        }
      }
    }
  }
  (jars, out)
}

## One-pass `run` plan: no later helper may rescan `program_args` as options.
type RunArgs = {
  cpjars: List[String],
  opts: CtOpts,
  closure: Bool,
  std_dir: String,
  target: String,
  program_args: List[String]
}

fn run_usage() -> String =
  "usage: dawn run [compiler-options] <target> [-- <program-args>...]"

## Parse compiler options through the target, then preserve program argv raw.
fn parse_run_args(rest: List[String]) -> RunArgs !Fs !io = {
  var cpjars: List[String] = []
  var fuel = DEFAULT_FUEL
  var ffi = false
  var closure = false
  var std_dir = "std"
  var target = ""
  var seen_target = false
  var program_args: List[String] = []
  var i = 0
  while i < len(rest) && not seen_target {
    let a = rest[i]
    var cp_spec = ""
    if a == "--cp" {
      if i + 1 >= len(rest) { cli_error("--cp needs a path") }
      cp_spec = rest[i + 1]
      i = i + 2
    } else if str.starts_with(a, "--cp=") {
      cp_spec = str.strip_prefix(a, "--cp=").unwrap_or(a)
      i = i + 1
    } else if a == "--comptime-fuel" {
      if i + 1 >= len(rest) { cli_error("--comptime-fuel needs a number") }
      match parse_int(rest[i + 1]) {
        Some(n) -> { fuel = n }
        None -> { cli_error("--comptime-fuel needs a number") }
      }
      i = i + 2
    } else if str.starts_with(a, "--comptime-fuel=") {
      match parse_int(str.strip_prefix(a, "--comptime-fuel=").unwrap_or(a)) {
        Some(n) -> { fuel = n }
        None -> { cli_error("--comptime-fuel needs a number") }
      }
      i = i + 1
    } else if a == "--comptime-ffi" {
      ffi = true
      i = i + 1
    } else if a == "--closure" {
      closure = true
      i = i + 1
    } else if a == "--std" {
      if i + 1 >= len(rest) { cli_error(run_usage()) }
      std_dir = rest[i + 1]
      i = i + 2
    } else if a == "--" {
      cli_error(run_usage())
      i = i + 1
    } else {
      target = a
      seen_target = true
      i = i + 1
    }
    if cp_spec != "" {
      for pth in str.split(cp_spec, path_sep()) {
        if pth != "" {
          if not io.exists(pth) { cli_error("--cp entry not found: " ++ pth) }
          cpjars = cpjars ++ [pth]
        }
      }
    }
  }
  if not seen_target { cli_error(run_usage()) }
  if i < len(rest) {
    if rest[i] != "--" { cli_error(run_usage()) }
    i = i + 1
    while i < len(rest) {
      program_args = program_args ++ [rest[i]]
      i = i + 1
    }
  }
  RunArgs {
    cpjars: cpjars,
    opts: CtOpts { fuel: fuel, ffi: ffi, jcall: fold_call },
    closure: closure,
    std_dir: std_dir,
    target: target,
    program_args: program_args
  }
}

## Render compile diagnostics, the count line, and exit 1 (the Kotlin
## compileProject failure shape).
fn fail_compile(diags: List[LocDiag]) -> Unit !Fs !io = {
  var pairs: List[(String, Diag)] = []
  for ld in diags { pairs = pairs ++ [(ld.path, ld.d)] }
  io.eprint(diag.render_all(pairs))
  io.eprintln(diag.count_line(len(diags)))
  let _ = io.exit(1)
  ()
}

# Planner diagnostics have the same rendering fields but belong to an
# independent package type. Keep the conversion at the CLI boundary.
fn planner_diags(ds: List[source.LocDiag]) -> List[LocDiag] = {
  var out: List[LocDiag] = []
  for ld in ds {
    out = out ++ [LocDiag {
      path: ld.path,
      d: Diag { msg: ld.d.msg, lo: ld.d.lo, hi: ld.d.hi, hint: ld.d.hint }
    }]
  }
  out
}

## Render the lexer diagnostics that made `fmt` refuse a file, say plainly that
## nothing was written, and exit 1. Separate from `fail_compile` because the
## last line is the whole point: the user asked for a rewrite and did not get
## one, and a bare diagnostic dump leaves that ambiguous.
fn fail_fmt(pairs: List[(String, Diag)]) -> Unit !Fs !io = {
  io.eprint(diag.render_all(pairs))
  io.eprintln(diag.count_line(len(pairs)))
  io.eprintln("these files do not lex and were left unchanged")
  let _ = io.exit(1)
  ()
}

## Render diagnostics without the count line and exit 1 (the Kotlin cmdDoc
## failure shape).
fn fail_doc(diags: List[LocDiag]) -> Unit !Fs !io = {
  var pairs: List[(String, Diag)] = []
  for ld in diags { pairs = pairs ++ [(ld.path, ld.d)] }
  io.eprint(diag.render_all(pairs))
  let _ = io.exit(1)
  ()
}

## Maven and lock setup is neither a usage mistake nor a source diagnostic.
## It fails the command at status 1 after any target lease has been released.
fn fail_target_setup(msg: String) -> Unit !io = {
  io.eprintln("error: " ++ msg)
  let _ = io.exit(1)
  ()
}

## Print the Kotlin CLI's error shape and exit 2.
## Refuse a second bare positional.
##
## `target = rest[i]` in a bare `else` made every one of these subcommands take
## the *last* target on the line and say nothing about the others, so a typo'd
## flag (`dawn build proj -0 out`) built `out` -- a real directory name to the
## loop -- and reported success. run instead owns a `--`-delimited program argv
## namespace, which is why it is not here.
fn refuse_second_target(cmd: String, have: String, got: String) -> Unit !io =
  if have != "" {
    cli_error(cmd ++ " takes one target, got `" ++ have ++ "` and `" ++ got ++
        "`; a bare word after the target is not a flag this subcommand knows")
  }

## Require exactly one input mode after each mode's flags and target have been
## collected. Keeping this separate from option extraction makes cardinality a
## single policy point without making the JVM and native argv plumbing shared.
fn require_one_input(
  cmd: String,
  choices: String,
  usage_text: String,
  selected: Int
) -> Unit !io = {
  if selected == 0 { return cli_error(usage_text) }
  if selected > 1 { return cli_error(cmd ++ " accepts exactly one of " ++ choices) }
}

fn cli_error(msg: String) -> Unit !io = {
  io.eprintln("error: " ++ msg)
  let _ = io.exit(2)
  ()
}

## A std that will not load. Only the copy compiled into this jar is the
## compiler's own fault; a directory is the user's environment, so it gets
## `error:` and the CLI exit code instead of a panic. `cli_error` exits, so the
## panic under it is the unreachable value this function's type needs.
fn fail_std(e: StdLoadError) -> StdCtx !io = {
  let text = std_load_error_text(e)
  if std_load_is_bug(e) { panic(text) }
  cli_error(text)
  panic(text)
}

## `dawn cache verify` — re-hash every entry in the package cache and compare
## it with the hash its directory name claims (PKG-02's companion command:
## the per-use check catches the entry a build touches, this sweeps them all).
fn run_cache(rest: List[String]) -> Unit !Fs !io = {
  if len(rest) != 1 || rest[0] != "verify" {
    return cli_error("usage: dawn cache verify")
  }
  let root = pkgfetch.cache_root()
  let names = match io.list_dir(root) {
    Ok(ns) -> ns
    Err(_) -> {
      println("cache is empty (" ++ root ++ ")")
      return ()
    }
  }
  var checked = 0
  var bad = 0
  for n in sort(names) {
    if str.starts_with(n, "d1-") {
      let hash = str.replace(n, "d1-", "d1:")
      checked = checked + 1
      match pkgfetch.verify_cached(root ++ "/" ++ n, hash) {
        Ok(_) -> println("ok   " ++ n)
        Err(e) -> {
          println("BAD  " ++ n)
          io.eprintln(e)
          bad = bad + 1
        }
      }
    }
  }
  println(to_string(checked) ++ " entr" ++ (if checked == 1 { "y" } else { "ies" }) ++
      " checked, " ++ to_string(bad) ++ " bad")
  if bad > 0 { let _ = io.exit(1) }
}

## `selfhost __pkghash <dir>` — the d1 canonical tree hash (dawn __pkghash).
fn run_pkghash(rest: List[String]) -> Unit !Fs !io = {
  let dir = if len(rest) > 0 { rest[0] } else { "." }
  if not io.is_dir(dir) { return cli_error("not a directory: " ++ dir) }
  match pkgfetch.tree_hash(dir) {
    Ok(h) -> println(h)
    Err(e) -> cli_error(e)
  }
}

fn run_source_inputs(rest: List[String]) -> Unit !Fs !io = {
  if len(rest) != 3 || rest[0] != "--base" {
    return cli_error("usage: dawn __source-inputs --base <repo> <project-dir>")
  }
  let base = rest[1]
  let target = rest[2]
  if not io.exists(target) {
    return cli_error("no such file or directory: " ++ target)
  }
  if not io.is_dir(target) {
    return cli_error("__source-inputs requires a project directory: " ++ target)
  }
  let plan = source.source_plan(source.ProjectDirectory(target))
  let pdiags = planner_diags(plan.diags)
  if len(pdiags) > 0 { return fail_compile(pdiags) }
  match source.bootstrap_source_input_manifest(plan, base) {
    Ok(text) -> print(text)
    Err(e) -> {
      io.eprintln("error: " ++ e)
      let _ = io.exit(1)
      ()
    }
  }
}

# ---- [java-deps]: target loaders for check/doc; re-exec remains for emission
# and comptime Java FFI, whose direct reflection still reads the system path ----

## Pull a boolean `--flag` out of an argument list.
fn extract_flag(rest: List[String], flag: String) -> (Bool, List[String]) = {
  var found = false
  var out: List[String] = []
  for a in rest {
    if a == flag { found = true } else { out = out ++ [a] }
  }
  (found, out)
}

## The positional target: the first token no known `--flag value` pair claims.
fn peek_target(rest: List[String]) -> String = {
  var i = 0
  while i < len(rest) {
    let a = rest[i]
    if a == "--std" || a == "-o" || a == "--vendor" || a == "--comptime-fuel" || a == "--cp" {
      i = i + 2
    } else if a == "--native" || a == "--check" || a == "--comptime-ffi" ||
      a == "--closure" {
        i = i + 1
      } else {
        return a
      }
  }
  ""
}

## The target's resolved java-deps jars, with the Kotlin CLI's progress line.
fn resolve_java_deps(target: String) -> List[String] !Fs !io = {
  let none: List[String] = []
  if not io.exists(target) { return none }
  if not io.is_dir(target) && not str.ends_with(target, ".dawn") { return none }
  let planner_target =
    if io.is_dir(target) { source.ProjectDirectory(target) } else { source.SourceFile(target) }
  let plan = source.source_plan(planner_target)
  let pdiags = planner_diags(plan.diags)
  if len(pdiags) > 0 { fail_compile(pdiags) }
  let coords = plan.java_coords
  if len(coords) > 0 {
    io.eprintln("resolving " ++ to_string(len(coords)) ++ " java-deps from " ++
        plan.project ++ "/dawn.toml...")
  }
  match maven.fetch_checked(plan.project, coords) {
    Ok(js) -> js
    Err(e) -> {
      cli_error(e)
      none
    }
  }
}

fn source_target(target: String) -> source.SourceTarget !Fs =
  if io.is_dir(target) { source.ProjectDirectory(target) } else { source.SourceFile(target) }

## Analyze one already planned and loaded target under only its resolved Java
## dependencies. Returning errors keeps every render, print and process exit
## outside the bracket that owns the classloader.
fn analyze_target_scoped(
  plan: ProjectPlan,
  loaded: LoadResult,
  std: StdCtx
) -> Result[Program, String] !Fs !io = {
  let no_jars: List[String] = []
  let jars = if len(plan.source.diags) > 0 {
    # Planner diagnostics keep their existing precedence. In particular, an
    # invalid manifest must not make a stale lock or the network the command's
    # answer; analysis can still report source diagnostics through a platform-
    # only lease.
    no_jars
  } else {
    match maven.fetch_checked(plan.source.project, plan.source.java_coords) {
      Ok(found) -> found
      Err(e) -> return Err(e)
    }
  }
  let lease = jsig_for(jars)
  Ok(bracket(
    lease,
    held => held.close(),
    held => analyze_program(loaded, std, ct_default(), held.jsig)
  ))
}

fn lsp_lease_problem(path: String, message: String) -> LocDiag =
  LocDiag { path: path, d: Diag {
    msg: message,
    lo: 0,
    hi: 0,
    hint: "save to retry lock or transient setup failures; after changing dawn.toml, close every document in this project and reopen one to capture a fresh plan"
  } }

## The lease is taken from a frame that does not otherwise touch the file
## system, so the handler is installed here rather than threaded through it.
fn lsp_target_lease(plan: source.SourcePlan) -> Result[JsigLease, LocDiag] !io =
  io.with_fs_real(() => lsp_target_lease_fs(plan))

fn lsp_target_lease_fs(plan: source.SourcePlan) -> Result[JsigLease, LocDiag] !Fs !io = {
  let no_jars: List[String] = []
  let jars = if len(plan.diags) > 0 {
    no_jars
  } else {
    match maven.fetch_checked_report(plan.project, plan.java_coords) {
      Ok(found) -> found
      Err(e) -> return Err(lsp_lease_problem(e.path, e.message))
    }
  }
  match catch_fault(() => jsig_for(jars)) {
    Ok(lease) -> Ok(lease)
    Err(e) -> Err(lsp_lease_problem(plan.project ++ "/dawn.toml",
      "cannot create the target Java classpath: " ++ e.message))
  }
}

fn lsp_standalone_lease() -> JsigLease !io = jsig_for([])

## `dawn lock [--check] [<dir>]` — write (or verify) the resolved [java-deps]
## closure. This is the only command that rewrites dawn.lock; every other one
## only refuses to disagree with it.
fn run_lock(rest: List[String]) -> Unit !Fs !io = {
  var check_only = false
  var target = "."
  var seen_target = false
  for a in rest {
    if a == "--check" {
      check_only = true
    } else if not seen_target {
      target = a
      seen_target = true
    } else {
      return cli_error("usage: dawn lock [--check] [<project-dir>]")
    }
  }
  if not io.is_dir(target) { return cli_error("not a directory: " ++ target) }
  let plan = source.source_plan(source.ProjectDirectory(target))
  let pdiags = planner_diags(plan.diags)
  if len(pdiags) > 0 { fail_compile(pdiags) }
  let path = maven.lock_path(plan.project)
  let coords = plan.java_coords
  if len(coords) == 0 {
    if io.exists(path) {
      return cli_error(path ++ " exists but " ++ plan.project ++
          "/dawn.toml declares no [java-deps]\n  delete the lock, or add the dependency back")
    }
    println("no [java-deps] to lock")
    return ()
  }
  io.eprintln("resolving " ++ to_string(len(coords)) ++ " java-deps...")
  let jars = match maven.fetch(coords) {
    Ok(js) -> js
    Err(e) -> {
      cli_error(e)
      return ()
    }
  }
  let fresh = match maven.lock_of(coords, jars) {
    Ok(l) -> l
    Err(e) -> {
      cli_error(e)
      return ()
    }
  }
  if check_only {
    match io.read_file(path) {
      Err(_) -> cli_error(path ++ " does not exist -- run `dawn lock`")
      Ok(text) ->
        match maven.parse_lock(text) {
          Err(e) -> cli_error(path ++ ": " ++ e)
          Ok(locked) ->
            match maven.check_lock(locked, fresh) {
              Err(e) -> cli_error(e)
              Ok(_) -> println(path ++ " is up to date (" ++
                  to_string(len(fresh.arts)) ++ " artifacts)")
            }
        }
    }
  } else {
    # Same reason as the manifest in pkg/add: this is the only writer of
    # dawn.lock and every other command refuses to disagree with it, so a
    # half-written lock would fail all of them rather than just this one.
    match io.atomic_write_file(path, maven.render_lock(fresh)) {
      Ok(_) -> println("wrote " ++ path ++ " (" ++ to_string(len(fresh.arts)) ++
          " artifacts from " ++ to_string(len(coords)) ++ " direct)")
      Err(e) -> cli_error("cannot write " ++ path ++ ": " ++ e.message)
    }
  }
}

## Jar paths the parent invocation resolved, carried across the re-exec.
fn deps_from_env() -> List[String] !io = {
  let none: List[String] = []
  match io.getenv("DAWN_SELFHOST_CP") {
    Some(s) -> if s == "" { none } else { str.split(s, path_sep()) }
    None -> none
  }
}

## Re-exec one invocation after its target and explicit classpath have already
## been identified. `rest` remains the caller's original list: in particular,
## a run separator, empty strings and option-looking program arguments are not
## normalized away while the classpath is extended.
fn maybe_with_known_deps(
  mode: String,
  rest: List[String],
  target: String,
  cpjars: List[String]
) -> Unit !Fs !io = {
  match io.getenv("DAWN_SELFHOST_CP") {
    Some(_) -> return
    None -> ()
  }
  if target == "" && len(cpjars) == 0 { return }
  let no_jars: List[String] = []
  let jars = if target == "" { no_jars } else { resolve_java_deps(target) }
  if len(jars) == 0 && len(cpjars) == 0 { return }
  var cp = host_classpath()
  for j in jars { cp = cp ++ path_sep() ++ j }
  for j in cpjars { cp = cp ++ path_sep() ++ j }
  var cmd: List[String] = child_java_cmd() ++ ["-cp", cp, "main", mode]
  cmd = cmd ++ rest
  let pb = ProcessBuilder.new(cmd)
  let env = pb.environment().expect("env")
  let _ = env.put("DAWN_SELFHOST_CP", join(jars, path_sep()))
  let _ = pb.inheritIO()
  let code = wait_reaped(pb.start().expect("java process"), "")
  let _ = io.exit(code)
  ()
}

## test/build have no program argv, so their existing filters remain safe here.
fn maybe_with_deps(mode: String, rest: List[String]) -> Unit !Fs !io = {
  match io.getenv("DAWN_SELFHOST_CP") {
    Some(_) -> return
    None -> ()
  }
  let (cpjars, rest1) = extract_cp(rest)
  let (_, rest2) = extract_ct_opts(rest1)
  let target = peek_target(rest2)
  maybe_with_known_deps(mode, rest, target, cpjars)
}

## Arrange for `child` to be destroyed -- and for `scratch` (empty for none) to
## be removed -- if this driver is terminated before it has finished with them.
##
## This driver never runs a program itself: `run`, `test`, the re-exec above and
## `--native` each hand the work to a child process and do nothing but wait. So
## a SIGTERM to the driver -- what `timeout` sends, and what any gate that
## bounds a hang sends -- used to kill the waiter and leave the child running:
## measured at 101% CPU, reparented to init, long after the driver was gone. A
## shutdown hook is where the JVM lets a program answer that signal (it runs for
## SIGTERM/SIGINT/SIGHUP and for every ordinary exit), so the destroy rides the
## path that already unwinds the driver. SIGKILL has no handler anywhere, on
## purpose; killing the process *group* is the only answer to it, and that is
## the caller's half of this (scripts/native-cli-diff.sh, scripts/doc-check.py).
##
## The hook is never removed. It does not need to be: each caller spawns exactly
## one child and the command is over when that child is, so there is nothing to
## accumulate, and both of its actions are idempotent -- `destroy` on an exited
## process and a delete of an already-deleted tree are no-ops, which is what
## makes running it again on the ordinary exit path harmless. Removing it would
## also have to cope with `removeShutdownHook` throwing once shutdown has begun,
## which is precisely the case this exists for.
fn reap_on_exit(child: Process, scratch: String) -> Unit !Fs !io = {
  let rt = Runtime.getRuntime().expect("runtime")
  let _ = rt.addShutdownHook(Thread.new(() => {
    let _ = child.destroy()
    if scratch != "" { pkgfetch.delete_tree(scratch) }
    ()
  }))
  ()
}

## `reap_on_exit` and then wait; the child's exit code.
fn wait_reaped(child: Process, scratch: String) -> Int !Fs !io = {
  reap_on_exit(child, scratch)
  child.waitFor()
}

## Emit `classes` under a fresh temp directory and return its path. The caller
## owns it: it removes the tree once the child it hands it to has finished, and
## `wait_reaped` removes it if the driver is terminated before that. Nothing
## else ever would -- the directories used to survive every ordinary run, and
## 3384 of them holding 2.9G had piled up in /tmp by the time anyone looked.
fn write_temp_classes(classes: List[(String, Bytes)]) -> String !Fs !io = {
  let dir =
    match io.temp_dir("", "selfhost-run") {
      Ok(d) -> d
      Err(e) -> panic("cannot create a temporary directory: " ++ e.message)
    }
  for pair in classes {
    let (nm, bs) = pair
    # nothing sensible to continue with: the classes about to be executed would
    # be missing one, so stop at the first failure and say which file it was
    # (cli_error exits the process)
    match write_class(dir, nm, bs) {
      Ok(_) -> ()
      Err(m) -> cli_error(m)
    }
  }
  dir
}

## Spawn `java <child_java_cmd> -cp <cp> <cls> <args...>` inheriting stdio;
## the exit code. `scratch` is the directory the classes were written to, which
## the reaping wait removes if this driver is terminated mid-run.
fn spawn_java(cp: String, cls: String, args: List[String], scratch: String) -> Int !Fs !io = {
  var cmd: List[String] = child_java_cmd() ++ ["-cp", cp, cls]
  cmd = cmd ++ args
  let pb = ProcessBuilder.new(cmd)
  let _ = pb.inheritIO()
  wait_reaped(pb.start().expect("java process"), scratch)
}

## `selfhost run [compiler-options] <target> [-- <program-args>...]` — mirror
## of `dawn run`,
## via a subprocess over freshly emitted classes (the host class path rides
## along so `use java` third-party classes stay visible).
fn run_run(run: RunArgs) -> Unit !Fs !io = {
  let (classes, entry, _) =
    collect_program(run.target, run.std_dir, run.opts, run.closure, false)
  if entry == "" {
    return cli_error(run.target ++ " has no pub fn main() -> Unit !io, nothing to run")
  }
  let dir = write_temp_classes(classes)
  let code = spawn_java(dir ++ path_sep() ++ host_classpath(), entry, run.program_args, dir)
  pkgfetch.delete_tree(dir)
  if code != 0 { let _ = io.exit(code) }
}

## `selfhost test [--std <dir>] <target>` — mirror of `dawn test`: emit with
## test blocks plus a synthesized dawn$TestMain runner, and run it.
##
## `--stdlib` runs the bundled std's own test blocks instead of a target's,
## the way `dawn doc --stdlib` documents it instead of a target. std is not a
## project — its modules see the intrinsics no user module may name, and its
## `impl Iter[String]` is an orphan anywhere else — so `dawn test std/str.dawn`
## cannot be made to work, and a flag is the whole mechanism.
fn run_test(rest0: List[String]) -> Unit !Fs !io = {
  let (_, rest1) = extract_cp(rest0)
  let (opts, restb) = extract_ct_opts(rest1)
  let (closure2, restc) = extract_flag(restb, "--closure")
  let (std_tests, rest) = extract_flag(restc, "--stdlib")
  var target = ""
  var std_dir = "std"
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else {
      refuse_second_target("dawn test", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  require_one_input(
    "dawn test",
    "a target or --stdlib",
    "usage: dawn test [--cp jars] <file.dawn | project-dir> | dawn test --stdlib",
    (if target != "" { 1 } else { 0 }) + (if std_tests { 1 } else { 0 })
  )
  let (classes, _, tests_info) = collect_program(target, std_dir, opts, closure2, std_tests)
  if len(tests_info) == 0 {
    return cli_error(if std_tests { std_dir ++ " has no test blocks" }
    else { target ++ " has no test blocks" })
  }
  var runner_tests: List[(String, Int, String)] = []
  for mi in tests_info {
    let (cls, mod_path, names) = mi
    var idx = 0
    for nm in names {
      let label = if len(tests_info) > 1 { mod_path ++ " :: " ++ nm } else { nm }
      runner_tests = runner_tests ++ [(cls, idx, label)]
      idx = idx + 1
    }
  }
  let all = classes ++ [(TESTMAIN_CLASS, gen_test_main(runner_tests))]
  let dir = write_temp_classes(all)
  let code = spawn_java(dir ++ path_sep() ++ host_classpath(), TESTMAIN_CLASS, [], dir)
  pkgfetch.delete_tree(dir)
  if code != 0 { let _ = io.exit(code) }
}

## `selfhost emit [<target>] [--std <dir>] -o <dir>`: write every class of the
## compiled program under <dir> (`emitrt` is the historical alias).
fn run_emitrt(rest: List[String]) -> Unit !Fs !io = {
  var out = ""
  var target = ""
  var std_dir = "std"
  var i = 0
  while i < len(rest) {
    if rest[i] == "-o" && i + 1 < len(rest) {
      out = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else {
      refuse_second_target("dawn __emit", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  if out == "" {
    return cli_error("usage: dawn __emit <file.dawn | project-dir> -o <dir>")
  }
  let (classes, _, _) = collect_program(target, std_dir, ct_default(), false, false)
  var seen: Set[String] = set.empty()
  var n = 0
  for pair in classes {
    let (nm, bs) = pair
    match write_class(out, nm, bs) {
      Ok(_) -> ()
      Err(m) -> return cli_error(m)
    }
    if not set.has(seen, nm) {
      seen = set.insert(seen, nm)
      n = n + 1
    }
  }
  println(to_string(n) ++ " classes -> " ++ out)
}

## The target's basename, `.dawn` stripped — what `-o` defaults derive from.
fn target_stem(target: String) -> String = {
  var t = target
  while str.ends_with(t, "/") { t = str.take(t, str.len(t) - 1) }
  let base = match str.last_index_of(t, "/") {
    Some(i) -> str.drop(t, i + 1)
    None -> t
  }
  str.strip_suffix(base, ".dawn").unwrap_or(base)
}

## The absolute directory a jar path lands in.
fn abs_parent(path: String) -> String !io =
  match fspath.parent(fspath.absolute(path, io.cwd())) {
    Some(p) -> p
    None -> "."
  }

## The last segment of `path`, by exactly the rule `maven.artifacts` names an
## artifact after: the text after the final `/`, with no normalization. Not
## `fspath.basename`, which normalizes first and so answers differently for a
## trailing slash — the two must agree here, and agreeing only for the paths
## Coursier happens to hand back is not agreeing.
fn jar_basename(path: String) -> String =
  match str.last_index_of(path, "/") {
    Some(i) -> str.drop(path, i + 1)
    None -> path
  }

fn any_repeat(xs: List[String]) -> Bool = {
  var seen: Set[String] = set.empty()
  for x in xs {
    if set.has(seen, x) { return true }
    seen = set.insert(seen, x)
  }
  false
}

## Each resolved jar with the file name it is vendored under. `maven.artifacts`
## answers this, and answers it by content: two coordinates can produce one jar
## file name, and copying both to `lib/<basename>` dropped one of them without a
## word — a deployment jar missing a dependency that was on the class path when
## it compiled. So a name that collides is qualified by its hash.
##
## Hashing the closure to find that out is the same work the parent invocation
## already did to verify dawn.lock, one process earlier: `build` re-execs with
## the resolved jars on its class path (`maybe_with_known_deps`), and the child
## was then reading and hashing all 11.1 MB of them again, 1.4s of the compiler's
## own build, to learn names that are just the file names whenever no two jars
## share one. Which is every resolution in practice.
##
## So: ask the file names first. They collide or they do not, and only when they
## do is content the deciding question -- which is what `maven.artifacts` is for,
## and it still gets asked. Nothing here makes the hash cheaper, on purpose:
## `java.security.MessageDigest` and a `sha256` intrinsic are both ruled out,
## for the reason recorded in packages/sha2/src/sha256.dawn.
##
## The one thing the two paths do not share: `maven.artifacts` reads every jar
## before the caller copies any, so an unreadable jar used to be reported before
## `lib/` was touched. The fast path finds it mid-copy, with the same message.
## `lib/` was never all-or-nothing anyway -- a failing write panics mid-loop too.
fn vendored_names(jars: List[String]) -> List[(String, String)] !Fs = {
  var names: List[String] = []
  for j in jars { names = names ++ [jar_basename(j)] }
  if any_repeat(names) {
    var out: List[(String, String)] = []
    match maven.artifacts(jars) {
      Ok(found) -> {
        for a in found { out = out ++ [(a.path, a.name)] }
      }
      Err(e) -> panic(e)
    }
    out
  } else {
    var out: List[(String, String)] = []
    var i = 0
    while i < len(jars) {
      out = out ++ [(jars[i], names[i])]
      i = i + 1
    }
    out
  }
}

## Copy resolved jars next to the output jar, under lib/ — coursier's cache is
## a content-addressed path in the user's home, fine to compile against and
## useless to a deployed jar. Returns the manifest Class-Path entries.
fn vendor_jars(jars: List[String], jar_path: String) -> List[String] !Fs !io = {
  var entries: List[String] = []
  if len(jars) == 0 { return entries }
  let found = vendored_names(jars)
  let lib_dir = abs_parent(jar_path) ++ "/lib"
  let _ = io.mkdirs(lib_dir)
  for a in found {
    let (src, name) = a
    let dst = lib_dir ++ "/" ++ name
    let bs =
      match io.read_bytes(src) {
        Ok(b) -> b
        Err(e) -> panic("cannot read " ++ src ++ ": " ++ e.message)
      }
    # Content, where this used to compare name and size and argue that the
    # cache is immutable. The bytes are in hand either way -- there is no
    # `size` primitive to be cheaper with, and the answer is now the real one.
    let same =
      match io.read_bytes(dst) {
        Ok(d) -> d == bs
        Err(_) -> false
      }
    if not same {
      match io.write_bytes(dst, bs) {
        Ok(_) -> ()
        Err(e) -> panic("cannot copy " ++ src ++ " to " ++ dst ++ ": " ++ e.message)
      }
    }
    entries = entries ++ ["lib/" ++ uri_path(name)]
  }
  entries
}

## A path as the URI reference a manifest Class-Path is made of.
##
## The attribute is a *space-separated list of URIs*, and a raw path is not
## one. A space in a directory name split one entry into two, a `#` began a
## fragment and truncated the rest, and any non-ASCII character was simply not
## a URI character -- in each case the jar compiled and then could not find its
## dependencies at run time, which is the worst place to learn it.
##
## Everything outside the unreserved set is percent-encoded, `/` kept as the
## separator it is. That is more than strictly required -- some sub-delimiters
## are legal unencoded in a path segment -- and it is always decodable back to
## the original, which the narrower rule is only ever equal to. Ordinary names
## (`lib/asm-9.7.1.jar`) are unreserved throughout and come through untouched.
fn uri_path(p: String) -> String = {
  var out = ""
  for c in str.chars(p) {
    if c == "/" || str.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~", c) {
      out = out ++ c
    } else {
      let bs = bytes.utf8(c)
      var i = 0
      while i < bytes.len(bs) {
        out = out ++ "%" ++ str.to_upper(bytes.to_hex(bytes.slice(bs, i, i + 1)))
        i = i + 1
      }
    }
  }
  out
}

## The names `maven.artifacts` gives `jars`, which is what `vendored_names` must
## answer whichever path it takes.
fn hashed_names(jars: List[String]) -> List[(String, String)] !Fs = {
  var out: List[(String, String)] = []
  match maven.artifacts(jars) {
    Ok(found) -> {
      for a in found { out = out ++ [(a.path, a.name)] }
    }
    Err(e) -> panic(e)
  }
  out
}

# The differential between not hashing and hashing. The expected names are
# written out rather than compared only against `hashed_names`, because for the
# colliding case that comparison is the slow path against itself: skipping the
# hash there would answer two identical names, agree with nothing, and this test
# is the only thing that says so.
test "vendored file names are the hashed ones, hash or no hash" {
  io.with_fs_real(() => {
    let root = match io.temp_dir("", "dawn-vendored-names-") {
      Ok(d) -> d
      Err(e) -> panic("temp dir: " ++ e.message)
    }
    with r <- bracket(root, p => pkgfetch.delete_tree(p))
    let a = r ++ "/a"
    let b = r ++ "/b"
    let _ = io.mkdirs(a)
    let _ = io.mkdirs(b)
    for pair in [(a ++ "/api-1.0.jar", "one"), (b ++ "/api-1.0.jar", "two"),
      (a ++ "/util-2.0.jar", "three"), (a ++ "/dup-3.0.jar", "same"),
      (b ++ "/dup-3.0.jar", "same")] {
      let (path, text) = pair
      match io.write_file(path, text) {
        Ok(_) -> ()
        Err(e) -> panic("cannot write " ++ path ++ ": " ++ e.message)
      }
    }
    # distinct file names: no hash is read, and the answer is the file names
    let plain = [a ++ "/api-1.0.jar", a ++ "/util-2.0.jar"]
    assert vendored_names(plain) ==
      [(a ++ "/api-1.0.jar", "api-1.0.jar"), (a ++ "/util-2.0.jar", "util-2.0.jar")]
    assert vendored_names(plain) == hashed_names(plain)
    # one file name over two contents: every member of the group is qualified by
    # twelve hex digits of its content, so the answer does not depend on the order
    # Coursier returned them in
    let clash = [a ++ "/api-1.0.jar", b ++ "/api-1.0.jar"]
    assert vendored_names(clash) ==
      [(a ++ "/api-1.0.jar", "7692c3ad3540-api-1.0.jar"),
        (b ++ "/api-1.0.jar", "3fc4ccfe7458-api-1.0.jar")]
    assert vendored_names(clash) == hashed_names(clash)
    # the same bytes twice under one name is one artifact, not a collision, and
    # the second copy does not become a second lib/ entry
    let dup = [a ++ "/dup-3.0.jar", b ++ "/dup-3.0.jar"]
    assert vendored_names(dup) == [(a ++ "/dup-3.0.jar", "dup-3.0.jar")]
    assert vendored_names(dup) == hashed_names(dup)
    # no jars at all, and a path with no directory in it
    let none: List[String] = []
    assert vendored_names(none) == []
    assert jar_basename("api-1.0.jar") == "api-1.0.jar"
  })
}

test "a class-path entry is a URI reference, not a path" {
  # the ordinary case, and the reason this is invisible day to day
  assert uri_path("lib/asm-9.7.1.jar") == "lib/asm-9.7.1.jar"
  assert uri_path("/opt/build/out.jar") == "/opt/build/out.jar"
  # a space ended one entry and started another; `#` began a fragment and
  # discarded the rest of the name
  assert uri_path("my libs/a b.jar") == "my%20libs/a%20b.jar"
  assert uri_path("lib/c#1.jar") == "lib/c%231.jar"
  # non-ASCII is not a URI character at all, and encodes as its UTF-8 bytes
  assert uri_path("lib/\u{4E2D}.jar") == "lib/%E4%B8%AD.jar"
}

## Manifest Class-Path entries for --cp jars: relative when the jar sits
## under the output jar's directory, else an absolute file: URL (the Kotlin
## URI.relativize behavior).
fn rel_entries(jars: List[String], jar_path: String) -> List[String] !io = {
  var out: List[String] = []
  let base = abs_parent(jar_path) ++ "/"
  for j in jars {
    let abs = fspath.absolute(j, io.cwd())
    if str.starts_with(abs, base) {
      out = out ++ [uri_path(str.drop(abs, str.len(base)))]
    } else {
      out = out ++ ["file:" ++ uri_path(abs)]
    }
  }
  out
}

fn find_native_image() -> Option[String] !io = {
  var candidates: List[String] = []
  match io.getenv("GRAALVM_HOME") {
    Some(h) -> { candidates = candidates ++ [h ++ "/bin/native-image"] }
    None -> ()
  }
  match io.getenv("JAVA_HOME") {
    Some(h) -> { candidates = candidates ++ [h ++ "/bin/native-image"] }
    None -> ()
  }
  match io.getenv("PATH") {
    Some(p) -> {
      for dir in str.split(p, path_sep()) { candidates = candidates ++ [dir ++ "/native-image"] }
    }
    None -> ()
  }
  for c in candidates {
    let ok = match catch_fault(() => File.new(c).canExecute()) {
      Ok(b) -> b
      Err(_) -> false
    }
    if ok { return Some(c) }
  }
  None
}

## Hand the finished jar to native-image (the Kotlin cmdBuild native branch):
## stream its output indented, delete the temp jar, report.
fn run_native_image(
  jar_path: String,
  bin_out: String,
  user_cp: List[String],
  entry: String
) -> Unit !Fs !io = {
  let ni = match find_native_image() {
    Some(p) -> p
    None ->
      return cli_error(
        "native-image not found. Install GraalVM and add it to PATH, or set GRAALVM_HOME")
  }
  println("invoking native-image (takes a minute or two the first time)...")
  # with --cp jars the -jar form would ignore them: explicit class path + main
  var cmd: List[String] = [ni, "-jar", jar_path, "-o", bin_out, "--no-fallback"]
  if len(user_cp) > 0 {
    var cp = jar_path
    for j in user_cp { cp = cp ++ path_sep() ++ j }
    var dotted = ""
    for part in str.split(entry, "/") {
      if dotted == "" { dotted = part } else { dotted = dotted ++ "." ++ part }
    }
    cmd = [ni, "-cp", cp, dotted, "-o", bin_out, "--no-fallback"]
  }
  let pb = ProcessBuilder.new(cmd)
  let _ = pb.redirectErrorStream(true)
  let proc = pb.start().expect("native-image process")
  # before the read, not just before the wait: the read is where this blocks
  # for the minute or two native-image takes, so it is where a terminated
  # driver would otherwise abandon it
  reap_on_exit(proc, "")
  let outs = proc.getInputStream().expect("stream")
  let all = outs.readAllBytes().expect("output")
  for line in str.split(bytes.decode_utf8_lossy(all), "\n") {
    if line != "" { println("  " ++ line) }
  }
  let code = proc.waitFor()
  # the jar and the temp directory `run_build` staged it in -- there is no
  # `temp_file` primitive, so the directory is the unit that gets cleaned up
  let _ = io.delete(jar_path)
  match fspath.parent(jar_path) {
    Some(d) -> { let _ = io.delete(d) }
    None -> ()
  }
  if code != 0 {
    return cli_error("native-image failed (exit code " ++ to_string(code) ++ ")")
  }
  println("wrote " ++ bin_out ++ " (standalone binary, run it directly: ./" ++ bin_out ++ ")")
}

## `selfhost build <target> [-o out] [--native] [--std <dir>] [--vendor <pkg>]...`:
## pack the compiled program as an executable jar (java-deps vendored into
## lib/ beside it), or hand it to native-image. Each `--vendor` names an
## internal package path (e.g. org/objectweb/asm) whose classes are copied in
## from java.class.path — building selfhost itself vendors ASM and the
## coursier interface, which is what makes the jar standalone.
fn run_build(rest0: List[String]) -> Unit !Fs !io = {
  let (user_cp, rest1) = extract_cp(rest0)
  let (opts, restb) = extract_ct_opts(rest1)
  let (closure, rest) = extract_flag(restb, "--closure")
  var out = ""
  var target = ""
  var std_dir = "std"
  var vendor_pkgs: List[String] = []
  var native = false
  var i = 0
  while i < len(rest) {
    if rest[i] == "-o" && i + 1 < len(rest) {
      out = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--vendor" && i + 1 < len(rest) {
      vendor_pkgs = vendor_pkgs ++ [rest[i + 1]]
      i = i + 2
    } else if rest[i] == "--native" {
      native = true
      i = i + 1
    } else {
      refuse_second_target("dawn build", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  if target == "" {
    return cli_error("usage: dawn build [--cp jars] <file.dawn | project-dir> [-o out] [--native]")
  }
  let stem = target_stem(target)
  let jar_path = if native {
    match io.temp_dir("", "dawn-build-") {
      Ok(d) -> d ++ "/" ++ stem ++ ".jar"
      Err(e) -> panic("cannot create a temp jar: " ++ e.message)
    }
  } else if out != "" {
    out
  } else {
    stem ++ ".jar"
  }
  let (classes, entry, _) = collect_program(target, std_dir, opts, closure, false)
  if entry == "" {
    return cli_error(target ++ " has no pub fn main() -> Unit !io to use as an entry point")
  }
  # dedupe defensively: ZipOutputStream throws on a repeated entry name
  var seen: Set[String] = set.empty()
  var all: List[(String, Bytes)] = []
  for pair in classes {
    let (nm, _) = pair
    if not set.has(seen, nm) {
      seen = set.insert(seen, nm)
      all = all ++ [pair]
    }
  }
  for pkg in vendor_pkgs {
    for pair in vendor.classpath_package(pkg) {
      let (nm, _) = pair
      if not set.has(seen, nm) {
        seen = set.insert(seen, nm)
        all = all ++ [pair]
      }
    }
  }
  let deps = deps_from_env()
  # native-image inlines everything, so it reads the jars where they already
  # live; a plain jar needs them at a stable path next to itself, and --cp
  # jars stay where the user put them (relative when under the jar's dir)
  let cp_entries = if native {
    deps ++ user_cp
  } else {
    vendor_jars(deps, jar_path) ++ rel_entries(user_cp, jar_path)
  }
  # no std resources any more: the toolchain's own jar carries std as the
  # compiled stdsrc module, so embedding happens by being a source file
  jarw.write_jar_cp(jar_path, entry, all, cp_entries)
  if native {
    let bin_out = if out != "" { out } else { stem }
    return run_native_image(jar_path, bin_out, user_cp, entry)
  }
  if len(cp_entries) == 0 {
    println("wrote " ++ jar_path ++ " (run it with: java -jar " ++ jar_path ++ ")")
  } else if len(deps) == 0 {
    println("wrote " ++ jar_path ++ " (run it with: java -jar " ++ jar_path ++
        "; manifest Class-Path points at the --cp jars, keep them in place)")
  } else {
    println("wrote " ++ jar_path ++ " and " ++ to_string(len(deps)) ++ " jar(s) into " ++
        abs_parent(jar_path) ++ "/lib (run it with: java -jar " ++ jar_path ++
        "; keep lib/ next to the jar)")
  }
}

## Every .dawn file under `dir`, recursively; paths are `dir`-prefixed.
fn dawn_files_under(dir: String) -> List[String] !Fs = {
  var out: List[String] = []
  match io.list_dir(dir) {
    Ok(files) -> {
      for f in files {
        let p = dir ++ "/" ++ f
        if io.is_dir(p) {
          out = out ++ dawn_files_under(p)
        } else if str.ends_with(f, ".dawn") {
          out = out ++ [p]
        }
      }
    }
    Err(e) -> panic("cannot list " ++ dir ++ ": " ++ e.message)
  }
  out
}

## `selfhost fmt [--check] <file.dawn | dir>...` — mirror of `dawn fmt`:
## reformat in place, or report unformatted files and exit 1.
##
## Two refusals guard the in-place write, because it is the one command whose
## normal outcome is overwriting the user's file:
##
##   * a named file must end in `.dawn`. The directory walk already filtered by
##     extension; a directly named path did not, so `dawn fmt README.md` fed
##     Markdown to the Dawn formatter and wrote the result back over it. One
##     path typo was enough.
##   * a file the lexer cannot read whole is left exactly as it was. See
##     `front/fmt.dawn`: an unrecognized character produces no token, and the
##     formatter reprints tokens, so formatting it deletes it.
##
## The lexer refusal is per file: the rest of the batch still formats, and the
## diagnostics for every refused file are rendered together at the end.
fn run_fmt(rest: List[String]) -> Unit !Fs !io = {
  var check = false
  var paths: List[String] = []
  for a in rest {
    if a == "--check" { check = true } else { paths = paths ++ [a] }
  }
  if len(paths) == 0 { return cli_error("usage: dawn fmt [--check] <file.dawn | dir>...") }
  var files: List[String] = []
  for p in paths {
    if not io.exists(p) { return cli_error("no such file or directory: " ++ p) }
    if io.is_dir(p) {
      files = files ++ sort(dawn_files_under(p))
    } else {
      if not str.ends_with(p, ".dawn") {
        return cli_error("source files must end in .dawn: " ++ p)
      }
      files = files ++ [p]
    }
  }
  var unformatted = 0
  var refused: List[(String, Diag)] = []
  for f in files {
    match io.read_file(f) {
      Ok(original) -> {
        match fmt.format(original) {
          Err(ds) -> {
            for d in ds { refused = refused ++ [(f, d)] }
          }
          Ok(formatted) ->
            if formatted != original {
              if check {
                println(f)
                unformatted = unformatted + 1
              } else {
                match io.write_file(f, formatted) {
                  Ok(_) -> println("formatted " ++ f)
                  Err(e) -> panic("cannot write " ++ f ++ ": " ++ e.message)
                }
              }
            }
        }
      }
      Err(e) -> panic("cannot read " ++ f ++ ": " ++ e.message)
    }
  }
  if len(refused) > 0 { return fail_fmt(refused) }
  if check && unformatted > 0 { let _ = io.exit(1) }
}

## `selfhost doc <target>` / `selfhost doc --builtins` — mirror of `dawn doc`.
fn run_doc(rest: List[String]) -> Unit !Fs !io = {
  var std_dir = "std"
  var builtins_mode = false
  var stdlib_mode = false
  var target = ""
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--builtins" {
      builtins_mode = true
      i = i + 1
    } else if rest[i] == "--stdlib" {
      # not `--std`: that spelling is taken, and by five bootstrap scripts at
      # that (it names the std *source directory*)
      stdlib_mode = true
      i = i + 1
    } else {
      refuse_second_target("dawn doc", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  require_one_input(
    "dawn doc",
    "a target, --stdlib, or --builtins",
    "usage: dawn doc <file.dawn | project-dir> | dawn doc --stdlib | dawn doc --builtins",
    (if target != "" { 1 } else { 0 }) +
      (if stdlib_mode { 1 } else { 0 }) +
      (if builtins_mode { 1 } else { 0 })
  )
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> fail_std(e)
  }
  if stdlib_mode {
    print(doc.stdlib_json(std))
    return
  }
  if builtins_mode {
    print(doc.builtins_json(std))
    return
  }
  if not io.exists(target) {
    return cli_error("no such file or directory: " ++ target)
  }
  let plan = match project_plan_for_load(source_target(target)) {
    Ok(found) -> found
    Err(rejected) -> {
      fail_doc(rejected.diags)
      return
    }
  }
  let loaded = load_planned(plan)
  let prog = match analyze_target_scoped(plan, loaded, std) {
    Ok(found) -> found
    Err(e) -> {
      fail_target_setup(e)
      return
    }
  }
  if len(prog.diags) > 0 { fail_doc(prog.diags) }
  print(doc.project_json(prog))
}

## Lowering coverage gate (docs/native-backend-plan.md Phase 0): lower every
## module of a program to Core IR and report which ones survive. Retargeting
## emit.dawn is gated on this reaching the whole language -- the compiler
## cannot compile itself through an IR that cannot represent it.
##
## Each module is lowered inside catch_panic so one gap does not hide the
## rest: a single run lists everything still missing.
fn run_lower(rest: List[String]) -> Unit !Fs !io = {
  var std_dir = "std"
  var dump_dir = ""
  var targets: List[String] = []
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--dump" && i + 1 < len(rest) {
      dump_dir = rest[i + 1]
      i = i + 2
    } else {
      targets = targets ++ [rest[i]]
      i = i + 1
    }
  }
  if len(targets) != 1 {
    cli_error("__lower takes exactly one target")
  }
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> fail_std(e)
  }
  let t = targets[0]
  let loaded = load_target(std, t)
  let prog = analyze_program(loaded, std, ct_default(), jsig_real())
  if len(prog.diags) > 0 { fail_compile(prog.diags) }
  let (adts, traits, impl_table, prog_fns) = cdriver.program_tables(std, prog.modules)

  # `--dump` writes one .core per module next to the coverage count. The
  # golden it feeds is the only detector for the parts of Core no shipping
  # backend reads -- see coredump.dawn.
  let dump_to = dump_dir
  let dumping = dump_to != ""

  ## Lower one module; the counting and the dump happen in the second phase,
  ## once every module's Core exists and the mode inference has seen it all.
  fn one(cls: String, tm: TModule) -> CModule =
    lower.lower_module(cls, tm, traits, impl_table, adts, prog_fns)

  ## Count one lowered module and, when dumping, render it. Returns the node
  ## count so the coverage gate keeps working unchanged, and the rendered
  ## text for the loop below to write.
  ##
  ## The write is not in here on purpose. A local fn is `!io` or pure and
  ## cannot spell `Fs`; one whose body reached `io.write_file` anyway is now
  ## refused by the checker (spec §6.5 "boundaries"). It was not always: the
  ## label resolved from the enclosing frame, the program checked clean, and
  ## `--dump` failed at run time with "effect evidence missing" when the io.*
  ## file functions moved onto Fs (dawn-lang #43). Keeping the local fn pure
  ## keeps its row honest either way.
  fn two(cls: String, core: CModule, modes: Map[(String, String), List[CMode]]) -> (Int, String) = {
    let m = rc.rc_module(infer.stamp_modes(core, modes), modes)
    let text = if dumping { coredump.render(adts, m) } else { "" }
    (lower_size(m), text)
  }

  var ok = 0
  var bad = 0
  var seen: Set[String] = set.empty()
  # Phase one: lower everything, so the golden carries the same parameter
  # modes production carries -- the inference is whole-program, and running
  # it per module would dump an all-owned world no shipping backend compiles.
  # std first: the compiler is compiled against it, so a gap there matters
  # just as much.
  var cores: List[(String, CModule)] = []
  for sm in std.mods {
    let (cls, _cx, tm, _ct) = sm
    match catch_panic(() => one(cls, tm)) {
      Ok(m) -> { cores = cores ++ [(cls, m)] }
      Err(e) -> {
        bad = bad + 1
        if not set.has(seen, e.message) {
          seen = set.insert(seen, e.message)
          println("GAP  " ++ cls ++ ": " ++ e.message)
        }
      }
    }
  }
  for cm in prog.modules {
    match catch_panic(() => one(cm.class_name, cm.tm)) {
      Ok(m) -> { cores = cores ++ [(cm.class_name, m)] }
      Err(e) -> {
        bad = bad + 1
        if not set.has(seen, e.message) {
          seen = set.insert(seen, e.message)
          println("GAP  " ++ cm.class_name ++ ": " ++ e.message)
        }
      }
    }
  }
  # Phase two: infer modes over what lowered, then count and dump each.
  var bare: List[CModule] = []
  for pr in cores {
    let (_cls, m) = pr
    bare = bare ++ [m]
  }
  let modes = infer.infer_modes(bare)
  for pr in cores {
    let (cls, m) = pr
    match catch_panic(() => two(cls, m, modes)) {
      Ok(counted) -> {
        let (_n, text) = counted
        if dumping {
          let path = dump_to ++ "/" ++ join(str.split(cls, "/"), ".") ++ ".core"
          match io.write_file(path, text) {
            Ok(_u) -> ()
            Err(e) -> panic("cannot write " ++ path ++ ": " ++ e.message)
          }
        }
        ok = ok + 1
      }
      Err(e) -> {
        bad = bad + 1
        if not set.has(seen, e.message) {
          seen = set.insert(seen, e.message)
          println("GAP  " ++ cls ++ ": " ++ e.message)
        }
      }
    }
  }
  println("")
  println("lowered " ++ to_string(ok) ++ " module(s), " ++ to_string(bad) ++ " failed")
  if bad > 0 {
    let _ = io.exit(1)
    ()
  }
}

## Force the lowered module so a panic happens inside catch_panic rather
## than lazily afterwards.
fn lower_size(m: CModule) -> Int = {
  var n = 0
  for f in m.fns {
    n = n + len(f.params) + len(f.dicts) + 1
  }
  n + len(m.dicts)
}

## Trait/impl/ADT/signature tables unioned over std and user modules, as
## collect_program builds them for the JVM path: ids are unique program-wide.
## The Phase -1 native seam spike (docs/native-backend-plan.md): emit C for
## the trivial subset instead of class files. Hidden and unsupported --
## `emitc.dawn` panics on anything outside that subset, and both are
## superseded once Core IR lands.
fn run_emitc(rest: List[String]) -> Unit !Fs !io = {
  var std_dir = "std"
  var out = ""
  var target = ""
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "-o" && i + 1 < len(rest) {
      out = rest[i + 1]
      i = i + 2
    } else {
      refuse_second_target("dawn emitc", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  if target == "" {
    cli_error("usage: dawn emitc [--std <dir>] <file.dawn | project-dir> [-o out]")
  }
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> fail_std(e)
  }
  let t = target
  let loaded = load_target(std, t)
  let prog = analyze_program(loaded, std, ct_default(), jsig_real())
  if len(prog.diags) > 0 { fail_compile(prog.diags) }
  let text = match cdriver.c_text(std, prog) {
    Ok(s) -> s
    Err(e) -> return cli_error(e ++ " in " ++ t)
  }
  if out == "" {
    print(text)
  } else {
    match io.write_file(out, text) {
      Ok(_) -> ()
      Err(e) -> cli_error("cannot write " ++ out ++ ": " ++ e.message)
    }
  }
}

## `[--std <dir>] <target>...`, shared by `check` and `__check`.
fn check_args(rest: List[String]) -> (String, List[String]) = {
  var std_dir = "std"
  var targets: List[String] = []
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else {
      targets = targets ++ [rest[i]]
      i = i + 1
    }
  }
  (std_dir, targets)
}

fn check_std(std_dir: String) -> StdCtx !Fs !io =
  match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> fail_std(e)
  }

## `dawn check [--std <dir>] <target>...` — type-check and report.
##
## This is the command the spec points third-party CI at, so its exit status is
## its answer: `ok` and 0 when clean, rendered diagnostics and 1 when not, 2 for
## a usage mistake. It used to print the `__check` golden dump and exit 0 no
## matter what, which made every CI that followed the spec green on a type
## error. `dawn __check` keeps that dump -- machine format, always 0 -- because
## the differential compares dumps rather than statuses.
##
## Diagnostics from every target are rendered together, so a multi-target run
## reports all of them rather than the first target's.
fn run_check(rest: List[String]) -> Unit !Fs !io = {
  let (std_dir, targets) = check_args(rest)
  if len(targets) == 0 {
    return cli_error("usage: dawn check [--std <dir>] <target>...")
  }
  for t in targets {
    if not io.exists(t) {
      return cli_error("no such file or directory: " ++ t)
    }
    if not io.is_dir(t) && not str.ends_with(t, ".dawn") {
      return cli_error("source files must end in .dawn: " ++ t)
    }
  }
  let std = check_std(std_dir)
  var all: List[LocDiag] = []
  for t in targets {
    # this command plans its own load rather than going through `load_target`,
    # so the std directory has to be answered here too -- and with the same
    # words, because scripts/native-cli-diff.sh compares the two drivers
    match std_dir_target(std, t) {
      Some(refusal) -> { all = all ++ refusal.diags }
      None ->
        match project_plan_for_load(source_target(t)) {
          Err(rejected) -> { all = all ++ rejected.diags }
          Ok(plan) -> {
            let loaded = load_planned(plan)
            match analyze_target_scoped(plan, loaded, std) {
              Ok(prog) -> { all = all ++ prog.diags }
              Err(e) -> return fail_target_setup(e)
            }
          }
        }
    }
  }
  if len(all) > 0 { return fail_compile(all) }
  println("ok")
}

## `dawn __check` — the golden dump (driver/checkdump.dawn), one block per
## target, exit 0 either way. Read by scripts/checker-corpus/run.sh and the
## N vs N-1 differential.
fn run_checkdump(rest: List[String]) -> Unit !Fs !io = {
  let (std_dir, targets) = check_args(rest)
  let std = check_std(std_dir)
  for t in targets {
    println("== " ++ t ++ " ==")
    let loaded = load_target(std, t)
    let prog = analyze_program(loaded, std, ct_default(), jsig_real())
    print(checkdump.render(prog))
  }
}

## The file system handler is installed here, once, for every subcommand:
## main is the outermost frame and the one place with nothing above it to
## answer `Fs` (spec §6.5). The dispatch itself runs under it.
pub fn main() -> Unit !io = io.with_fs_real(() => dispatch())

fn dispatch() -> Unit !Fs !io = {
  match args() {
    [] -> {
      print(usage())
      let _ = io.exit(2)
      ()
    }
    [mode, ..rest] ->
      if mode == "check" {
        run_check(rest)
      } else if mode == "__check" {
        run_checkdump(rest)
      } else if mode == "emit" || mode == "emitrt" || mode == "__emit" {
        run_emitrt(rest)
      } else if mode == "__emitc" {
        run_emitc(rest)
      } else if mode == "__lower" {
        run_lower(rest)
      } else if mode == "build" {
        maybe_with_deps(mode, rest)
        run_build(rest)
      } else if mode == "fmt" {
        run_fmt(rest)
      } else if mode == "run" {
        let run = parse_run_args(rest)
        maybe_with_known_deps(mode, rest, run.target, run.cpjars)
        run_run(run)
      } else if mode == "test" {
        maybe_with_deps(mode, rest)
        run_test(rest)
      } else if mode == "doc" {
        run_doc(rest)
      } else if mode == "add" {
        match add.run_add(rest) {
          Ok(s) -> println(s)
          Err(e) -> cli_error(e)
        }
      } else if mode == "lsp" {
        run_lsp(lsp_std_flag(rest), LspLeaseHost {
          standalone: lsp_standalone_lease,
          project: lsp_target_lease
        })
      } else if mode == "lock" {
        run_lock(rest)
      } else if mode == "cache" {
        run_cache(rest)
      } else if mode == "__source-inputs" {
        run_source_inputs(rest)
      } else if mode == "__pkghash" {
        run_pkghash(rest)
      } else if mode == "lex" || mode == "__lex" || mode == "parse" || mode == "__parse" {
        for pth in rest {
          println("== " ++ pth ++ " ==")
          match io.read_file(pth) {
            Ok(text) ->
              if mode == "lex" || mode == "__lex" {
                let (toks, diags) = lexer.lex(text)
                println(lexdump.render(toks, diags))
              } else {
                let (m, diags) = parser.parse_module(text)
                println(astdump.render_module(m, diags))
              }
            Err(e) -> panic("cannot read " ++ pth ++ ": " ++ e.message)
          }
        }
      } else if mode == "--version" || mode == "-V" || mode == "version" {
        println("dawn " ++ VERSION ++ " (selfhost)")
      } else if mode == "--help" || mode == "-h" || mode == "help" {
        print(usage())
      } else {
        io.eprintln("unknown command: " ++ mode ++ "\n")
        print(usage())
        let _ = io.exit(2)
        ()
      }
  }
}

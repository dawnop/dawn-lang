  fn_iface, tuple_class, gen_fn_interface, gen_tuple_class, gen_panic_class,
  gen_unit_class, supers_of, PANIC_CLASS, UNIT_CLASS, gen_bytes_class,
  gen_io_class, gen_fn_comparator, gen_ord_interface, no_override,
  tr_iface, BYTES_CLASS, IO_CLASS,
  FN_CMP_CLASS, gen_show_class, SHOW_CLASS,
  gen_strings_class, STRINGS_CLASS,
  gen_array_class, ARRAY_CLASS, gen_adt
}
use types.{
  prelude_adts, adt_of, adt_jvm_name, trait_of, OPTION_ID, RESULT_ID,
  EQ_ID, HASH_ID, SHOW_ID, bounds_of,
  Ty, Sig, Traits, ImplI, Adts, Impls
}
use emit.{emit_module, gen_trait_interface}
use core.{CModule, CValue}
use reach

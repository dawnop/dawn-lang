# expect: expected a newline or `}` after this handler arm
# expect: allowed at module top level
# A handler arm's body is an expression, like a match arm's, so an assignment
# needs braces. This is the slip a state cell invites, which is why the arm
# separator says so instead of leaving `want_sep` to report the consequence.
effect Ask {
  fn ask() -> Int
}

fn f() -> Int = {
  with handle Ask {
    var n: Int = 0
    ask() => n = 1
  }
  ask()
}

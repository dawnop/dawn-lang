# checker.dawn: constructor patterns
pub type Shape = Dot | Line(a: Int, b: Int)

type Other = Blob

pub fn wrong_adt(s: Shape) -> Int =
  match s {
    Blob -> 1
    _ -> 2
  }

pub fn unknown(s: Shape) -> Int =
  match s {
    Nope -> 1
    _ -> 2
  }

pub fn bare_with_fields(s: Shape) -> Int =
  match s {
    Line -> 1
    _ -> 2
  }

pub fn bad_field(s: Shape) -> Int =
  match s {
    Line(z: q) -> q
    _ -> 2
  }

pub fn positional_after_named(s: Shape) -> Int =
  match s {
    Line(a: p, q) -> p
    _ -> 2
  }

pub fn twice(s: Shape) -> Int =
  match s {
    Line(a: p, a: q) -> p
    _ -> 2
  }

pub fn wrong_arity(s: Shape) -> Int =
  match s {
    Line(p, q, r) -> p
    _ -> 2
  }

pub fn missing_fields(s: Shape) -> Int =
  match s {
    Line(a: p) -> p
    _ -> 2
  }

pub fn empty_parens(s: Shape) -> Int =
  match s {
    Line() -> 1
    _ -> 2
  }

# a sum-type constructor is matched with parentheses and a record with braces,
# the way each is built (spec 2.3/2.4); the other brackets are refused before
# any field is looked at
pub fn ctor_with_braces(s: Shape) -> Int =
  match s {
    Line { a, b } -> a + b
    _ -> 2
  }

pub type Pt = { x: Int, y: Int }

pub fn record_with_parens(p: Pt) -> Int =
  match p {
    Pt(x: a, y: b) -> a + b
  }

pub fn record_bare(p: Pt) -> Int =
  match p {
    Pt -> 1
  }

# Deterministic executable-jar writer for `selfhost build`: manifest first,
# then each class entry, with every timestamp pinned — so the same class list
# always produces the same jar bytes. The standalone closure check relies on
# that: the jar the self-hosted compiler builds of itself must equal, byte for
# byte, the jar it was launched from.

use std/str
use std/bytes
use java "java.io.FileOutputStream"
use java "java.util.zip.ZipOutputStream"
use java "java.util.zip.ZipEntry"
use java "java.time.LocalDateTime"

# Fixed entry mtime, 2020-01-01T00:00:00 — as a *local* date-time, written with
# setTimeLocal.
#
# setTime takes an epoch millisecond and converts it to the zip format's DOS
# time through the default zone, so the same source produced different jar bytes
# in different zones: reproducible per machine, which is all the B == C closure
# check needs, but not reproducible at all in the sense the word usually means.
# A release is a byte-for-byte fixed point, so "same bytes only if you are in my
# timezone" is too weak a claim to build one on. setTimeLocal (Java 9+) writes
# the DOS fields directly, with no zone in the path.
fn entry_time() -> LocalDateTime !io = LocalDateTime.of(2020, 1, 1, 0, 0, 0)!

fn crlf() -> String = str.from_char(13) ++ "\n"

fn dotted(cls: String) -> String = {
  var out = ""
  for part in str.split(cls, "/") {
    if out == "" { out = part } else { out = out ++ "." ++ part }
  }
  out
}

fn put(zos: ZipOutputStream, name: String, bs: Bytes) -> Unit !io = {
  let e = ZipEntry.new(name)
  let _ = e.setTimeLocal(entry_time())
  let _ = zos.putNextEntry(e)
  let _ = zos.write(bs)
  let _ = zos.closeEntry()
  ()
}

# The two releases `write_jar_cp` brackets with. Closing the zip stream writes
# the central directory and closes the file under it, so the outer release is
# a no-op on the way out the front door; it exists for the window between
# opening the file and wrapping it, and for a `put` that never gets that far.
#
# Neither swallows a close failure. Finishing a jar is where a full disk shows
# up, and a truncated jar that reports success would defeat the byte-for-byte
# closure check this module exists for. The cost is that a failure raised while
# the zip is still empty gets replaced by ZipOutputStream's "at least one
# entry" complaint — the manifest is written first, so that window is one call
# wide.
fn close_zip(z: ZipOutputStream) -> Unit !io = {
  let _ = z.close()
  ()
}

fn close_file(f: FileOutputStream) -> Unit !io = {
  let _ = f.close()
  ()
}

## A manifest Class-Path line, wrapped: physical lines stay under the spec's
## 72-byte cap, continuations start with one space and re-join on read.
fn class_path_lines(entries: List[String]) -> String = {
  if len(entries) == 0 { return "" }
  var rest = "Class-Path: " ++ join(entries, " ")
  var out = ""
  while str.len(rest) > 70 {
    out = out ++ str.take(rest, 70) ++ crlf()
    rest = " " ++ str.drop(rest, 70)
  }
  out ++ rest ++ crlf()
}

## Write `classes` (internal name → bytes, no ".class" suffix) as an
## executable jar with `Main-Class: <main_class>`.
pub fn write_jar(path: String, main_class: String, classes: List[(String, Bytes)]) -> Unit !io = {
  let none: List[String] = []
  write_jar_cp(path, main_class, classes, none)
}

## Same, with manifest Class-Path entries (relative to the jar's directory) —
## how `build` points a jar at the java-deps vendored beside it.
pub fn write_jar_cp(
  path: String,
  main_class: String,
  classes: List[(String, Bytes)],
  cp_entries: List[String]
) -> Unit !io = {
  let fos = match catch_fault(() => FileOutputStream.new(path)) {
    Ok(f) -> f
    Err(e) -> panic("cannot write " ++ path ++ ": " ++ e.message)
  }
  with file <- bracket(fos, close_file)
  with zos <- bracket(ZipOutputStream.new(file), close_zip)
  let manifest =
    "Manifest-Version: 1.0" ++ crlf() ++
    "Main-Class: " ++ dotted(main_class) ++ crlf() ++
    class_path_lines(cp_entries) ++ crlf()
  put(zos, "META-INF/MANIFEST.MF", bytes.utf8(manifest))
  for pair in classes {
    let (nm, bs) = pair
    put(zos, nm ++ ".class", bs)
  }
}

test "dotted turns an internal name into a binary name" {
  assert dotted("main") == "main"
  assert dotted("a/b/c") == "a.b.c"
}

test "class-path lines wrap under the 72-byte cap and stay joinable" {
  let none: List[String] = []
  assert class_path_lines(none) == ""
  assert class_path_lines(["lib/a.jar"]) == "Class-Path: lib/a.jar" ++ crlf()
  let long = class_path_lines([
    "lib/a-very-long-artifact-name-1.0.0.jar", "lib/another-quite-long-name-2.3.4.jar"
  ])
  for line in str.split(long, crlf()) { assert str.len(line) <= 70 }
}

# Post-generation link check: every internal href must resolve to a file we
# actually wrote, *and* every `#fragment` must name an element that file
# actually has. Broken links fail the build.
#
# The fragment half was missing until 2026-08-05, and missing in both
# directions at once: `resolve` threw the fragment away before comparing, and
# `is_external` classified a bare `#frag` as external -- i.e. as somebody
# else's problem. Between them, all 281 fragments on this site went
# unexamined (272 same-page, 9 cross-page; the cross-page ones had their file
# half checked and their fragment dropped). The summary line meanwhile said
# every href resolved, which was true of the 474 file halves it still looked
# at and said nothing about the fragments -- a count that is honest about its
# own subject and silent about the one nobody had noticed was missing.
#
# The check comes in two parts because existence alone is not enough here.
# Heading ids are POSITIONAL, not derived from the heading text
# (html/render.dawn assigns `s$h2-$h3` from running counters), while the
# number a reader sees is typed into the heading by hand. `#s3-5` therefore
# means "§3.5" only while those two agree, and nothing but check_heading
# numbers forces them to: insert a `###` into the middle of a spec chapter
# and renumber nothing after it, and every id from there on names the section
# before the one it prints. Every link still resolves. That is why the
# numbering half exists, and it is the half the mutant proved -- breaking the
# fragments is caught by existence, but this failure is invisible to it.
#
# Still not caught, so that the next reader does not assume otherwise: a link
# whose fragment resolves to a correctly-numbered heading that is simply not
# the section the author meant. The id carries no evidence of intent, so no
# check here can recover it.
#
# scripts/doc-check.py has an anchor check of the same shape over docs/*.md.
# That one is sound -- both its halves fail on a bad fragment when one is
# planted -- and has been matching zero references since the day it was
# written, because docs/ prose links to whole files and never to fragments.
# Every fragment in this repository is here, in the generated site, which is
# why the check had to be here too.

use std/str
use std/io
use std/io.{Fs}
use std/set
use std/map
use json/parser.{parse}
use json/value.{Json, JArr, JStr, JInt, JObj, error_text}
use md/text.{cp_at, seg}
use gen/common.{must_read, must_list, take_n}
use gen/fingerprint.{is_fingerprinted}
use html/play.{play_decode}

fn files_under(base: String, rel: String) -> List[String] !Fs = {
  let path = if rel == "" { base } else { "${base}/${rel}" }
  if io.is_dir(path) {
    var out: List[String] = []
    for name in must_list(path) {
      let child = if rel == "" { name } else { "${rel}/${name}" }
      out = out ++ files_under(base, child)
    }
    out
  } else {
    [rel]
  }
}

## Index of pattern pat in cs at or after from, or -1.
fn find_sub(cs: List[Char], from: Int, pat: List[Char]) -> Int = {
  var i = from
  var found = -1
  while found < 0 && i + len(pat) <= len(cs) {
    var k = 0
    var ok = true
    while ok && k < len(pat) {
      if cp_at(cs, i + k) != cp_at(pat, k) {
        ok = false
      }
      k = k + 1
    }
    if ok {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

## Every value of one quoted attribute, given its `name="` opener.
fn attr_values(html: String, opener: String) -> List[String] = {
  let cs = code_points(html)
  let pat = code_points(opener)
  var out: List[String] = []
  var i = 0
  var going = true
  while going {
    let at = find_sub(cs, i, pat)
    if at < 0 {
      going = false
    } else {
      let start = at + len(pat)
      var e = start
      while e < len(cs) && cp_at(cs, e) != '"' {
        e = e + 1
      }
      out = out ++ [seg(cs, start, e)]
      i = e
    }
  }
  out
}

## Every URL on the page that the browser will go and fetch: `href` for the
## links and the stylesheet, `src` for the brand mark and the Playground's
## module script.
##
## `src` was outside this check until 2026-08-08, which cost nothing while the
## two of them were spelled by hand in one template and never changed. Asset
## names are now derived from the content (gen/fingerprint), so a name that
## does not exist is a thing the generator can produce -- and the two
## references it can produce it for were exactly the two nobody was looking at.
##
## `data-wasm` is the demo page's (gen/pages.gen_tea): the URL of the reactor a
## frame fetches. HTML has no element whose job is "a thing script will fetch",
## so it is an attribute the page's own script reads -- but it is still a URL
## this generator produced from a content hash, and it fails the same way the
## other two would. Putting it here is what lets the page name the reactor in
## markup instead of in a string inside a program, which nothing here reads.
##
## The three `data-search-*` URLs are the header's (html/page.search_button):
## the bridge module the panel imports, the reactor it mounts and the index it
## fetches. Same reasoning as `data-wasm`, one page later -- they are on every
## page of the site rather than on one, so a name that stopped existing would
## be 92 dead fetches instead of two.
##
## `data-search-body` is the fourth (html/page.search_host): the body index
## the panel fetches once a reader types, named on the panel's mount point.
fn hrefs_of(html: String) -> List[String] =
  attr_values(html, "href=\"") ++ attr_values(html, "src=\"")
  ++ attr_values(html, "data-wasm=\"")
  ++ attr_values(html, "data-search-app=\"")
  ++ attr_values(html, "data-search-wasm=\"")
  ++ attr_values(html, "data-search-index=\"")
  ++ attr_values(html, "data-search-body=\"")

## Every id this page offers as a link target. The opener carries its leading
## space so that `data-id="` and friends cannot be mistaken for an id.
fn ids_of(html: String) -> List[String] = attr_values(html, " id=\"")

## Each `<hN id="...">text...` on the page, as (id, text-before-any-markup).
## The text stops at the first tag, which is enough: what this is read for is
## the section number, and that is always the first thing in a heading.
##
## Since 2026-10-02 the renderer sets that number apart in `<span class="hn">`
## (html/render.heading_html), so the first thing in a numbered heading is a
## tag. Read as before, every numbered heading would print "" and be skipped
## as unnumbered, and this whole check would pass by checking nothing; so the
## span is stepped into, and the number is its text.
fn headings_at(html: String, lvl: Int) -> List[(String, String)] = {
  let cs = code_points(html)
  let open = code_points("<h${lvl} id=\"")
  var out: List[(String, String)] = []
  var i = 0
  var going = true
  while going {
    let at = find_sub(cs, i, open)
    if at < 0 {
      going = false
    } else {
      let s = at + len(open)
      var e = s
      while e < len(cs) && cp_at(cs, e) != '"' {
        e = e + 1
      }
      var t = e
      while t < len(cs) && cp_at(cs, t) != '>' {
        t = t + 1
      }
      var from = t + 1
      if starts_at(cs, from, hn_open()) {
        from = from + len(hn_open())
      }
      var te = from
      while te < len(cs) && cp_at(cs, te) != '<' {
        te = te + 1
      }
      out = out ++ [(seg(cs, s, e), seg(cs, from, te))]
      i = te
    }
  }
  out
}

fn hn_open() -> List[Char] = code_points(`<span class="hn">`)

## Whether `pat` sits in `cs` at exactly `at`.
fn starts_at(cs: List[Char], at: Int, pat: List[Char]) -> Bool = {
  var k = 0
  var ok = at + len(pat) <= len(cs)
  while ok && k < len(pat) {
    if cp_at(cs, at + k) != cp_at(pat, k) {
      ok = false
    }
    k = k + 1
  }
  ok
}

fn headings_of(html: String) -> List[(String, String)] =
  headings_at(html, 2) ++ headings_at(html, 3) ++ headings_at(html, 4)

## The section number an id claims: `s9-8-1` -> `9.8.1`. Empty if the id is
## not of that shape.
fn id_number(id: String) -> String =
  if str.starts_with(id, "s") {
    let rest = seg(code_points(id), 1, len(code_points(id)))
    var ok = rest != ""
    for part in str.split(rest, "-") {
      if part == "" {
        ok = false
      }
      for c in code_points(part) {
        if c < '0' || c > '9' {
          ok = false
        }
      }
    }
    if ok { join(str.split(rest, "-"), ".") } else { "" }
  } else {
    ""
  }

## The dotted number a heading prints, or empty: `9.8.1 载荷` -> `9.8.1`,
## `6. 效果系统` -> `6` (the trailing dot is punctuation, not a level), and
## `安装` -> `` (this page does not number its headings).
fn leading_number(text: String) -> String = {
  let cs = code_points(text)
  var i = 0
  while i < len(cs) && ((cp_at(cs, i) >= '0' && cp_at(cs, i) <= '9') || cp_at(cs, i) == '.') {
    i = i + 1
  }
  let raw = seg(cs, 0, i)
  if str.ends_with(raw, ".") { seg(cs, 0, i - 1) } else { raw }
}

## The one page on this site whose `#fragment` is not an element id. The
## Playground reads `location.hash` as a program (play-ui's `decodeShare`,
## html/play.dawn's `play_hash`), and the tutorial hands it one per runnable block.
##
## So this is a redirection, not an exemption. Checked against the ids of
## playground.html, every one of those links would be reported broken;
## waved through, none of them would be looked at at all -- and the failure
## worth catching is not "that id is missing", it is "the generator wrote a
## fragment the editor cannot read". That is checkable here without the
## source: the fragment has to be standard-alphabet Base64 (the url-safe one
## is what `atob` refuses) decoding to well-formed UTF-8 (which a byte lost
## from a Chinese comment is not). What this cannot see is whether the program
## it decodes to is the program printed above the link; that is
## gen/tutorial.dawn's test, which has both halves in hand.
fn is_play_target(target: String) -> Bool =
  target == "playground.html" || str.ends_with(target, "/playground.html")

fn is_editor_payload(frag: String) -> Bool =
  match play_decode(frag) {
    Some(_) -> true
    None -> false
  }

fn is_external(u: String) -> Bool =
  str.starts_with(u, "http://") || str.starts_with(u, "https://") || str.starts_with(u, "mailto:")

## The path half of an href, i.e. everything before the `#`. Empty when the
## href is a bare fragment, which names the page it is written on.
fn path_of(href: String) -> String =
  match str.split(href, "#") {
    [path] -> path
    [path, _] -> path
    _ -> href
  }

## The fragment half, without the `#`. Empty when there is none.
fn frag_of(href: String) -> String =
  match str.split(href, "#") {
    [_] -> ""
    [_, frag] -> frag
    _ -> ""
  }

## Resolve href against the page's directory and normalize . / .. segments.
fn resolve(dir: String, href: String) -> String = {
  let no_anchor = path_of(href)
  let raw = if dir == "" { no_anchor } else { "${dir}/${no_anchor}" }
  var stack: List[String] = []
  for part in str.split(raw, "/") {
    if part == ".." {
      stack = take_n(stack, len(stack) - 1)
    } else if part != "" && part != "." {
      stack = stack ++ [part]
    }
  }
  join(stack, "/")
}

## The file name at the end of a path.
fn last_segment(rel: String) -> String = {
  let parts = str.split(rel, "/")
  unwrap_or(get(parts, len(parts) - 1), rel)
}

fn dir_of(rel: String) -> String = {
  let parts = str.split(rel, "/")
  join(take_n(parts, len(parts) - 1), "/")
}

## Which assets are search indexes: `search-<code>.json`, under the plain name
## rather than the fingerprinted alias, so that each one is read once. The
## body indexes (`search-body-<code>.json`) match that pattern too and are a
## different shape, so they are told apart here and read by [body_hrefs].
fn is_search_index(name: String) -> Bool =
  str.starts_with(name, "search-") && str.ends_with(name, ".json")
  && not is_fingerprinted(name) && not is_search_body(name)

fn is_search_body(name: String) -> Bool =
  str.starts_with(name, "search-body-") && str.ends_with(name, ".json")
  && not is_fingerprinted(name)

## Every href a search index carries, in the order it carries them.
##
## This is the one place on the site where a generator writes a URL that no
## document contains: the index is JSON, it is read by a program on the far
## side of a wasm boundary, and the URL only becomes a link when a reader types
## something that matches. `hrefs_of` cannot see it and nothing else looks --
## so an anchor that stopped existing (a heading counter that moved, an id rule
## that changed in gen/stdlib) would ship as a search result that lands on the
## wrong section, or on nothing at all, with every gate green.
##
## The rows are `[group, title, detail, note, href]`; the href is the fifth.
## A row of another shape is a generator that changed the format without
## telling the panel, and is reported rather than skipped.
fn index_hrefs(name: String, text: String) -> List[String] = {
  var out: List[String] = []
  match parse(text) {
    Ok(doc) -> {
      for item in items_of(doc) {
        match item {
          JArr(fields) ->
            match get(fields, 4) {
              Some(JStr(href)) -> {
                out = out ++ [href]
              }
              _ -> panic("assets/${name}: an index row is not five strings")
            }
          _ -> panic("assets/${name}: an index row is not an array")
        }
      }
    }
    Err(e) -> panic("assets/${name} is not JSON: " ++ error_text(e))
  }
  out
}

## Every href a body index carries: the second field of each entry of its
## section table (docs/site-search-design.md 2.1). Same reasoning as
## [index_hrefs], and more of them -- every anchored heading of four documents
## -- so a renderer that moved its ids would show up here in hundreds.
##
## The shape around the hrefs is checked as far as reading them needs: the
## asset is an array whose first field is the version the panel knows (1)
## and whose second is the section table of three-string rows. Anything else
## is a generator that changed the format without bumping the version, and is
## reported rather than skipped.
fn body_hrefs(name: String, text: String) -> List[String] = {
  var out: List[String] = []
  match parse(text) {
    Ok(JArr(fields)) -> {
      match get(fields, 0) {
        Some(JInt(v)) -> {
          if v != 1 {
            panic("assets/${name}: body index version ${v}, and the panel reads 1")
          }
        }
        _ -> panic("assets/${name}: a body index opens with its version number")
      }
      match get(fields, 1) {
        Some(JArr(sections)) -> {
          for sec in sections {
            match sec {
              JArr([JStr(_), JStr(href), JStr(_)]) -> {
                out = out ++ [href]
              }
              _ -> panic("assets/${name}: a body section is not three strings")
            }
          }
        }
        _ -> panic("assets/${name}: a body index's second field is its section table")
      }
    }
    Ok(_) -> panic("assets/${name}: a body index is an array")
    Err(e) -> panic("assets/${name} is not JSON: " ++ error_text(e))
  }
  out
}

fn items_of(doc: Json) -> List[Json] =
  match doc {
    JObj(entries) ->
      match map.get(entries, "items") {
        Some(JArr(items)) -> items
        _ -> []
      }
    _ -> []
  }

pub fn check_links(out: String) -> Unit !Fs !io = {
  let files = set.from(files_under(out, ""))
  # Every page's ids, indexed before any page is judged: a fragment is checked
  # against the page it points AT, which for the cross-page ones is not the
  # page it is written on.
  var id_entries: List[(String, Set[String])] = []
  for f in set.to_list(files) {
    if str.ends_with(f, ".html") {
      id_entries = id_entries ++ [(f, set.from(ids_of(must_read("${out}/${f}"))))]
    }
  }
  let ids = map.from(id_entries)
  var broken: List[String] = []
  var pages = 0
  var checked = 0
  var assets = 0
  var anchors = 0
  var payloads = 0
  var numbered = 0
  for f in set.to_list(files) {
    if str.ends_with(f, ".html") {
      pages = pages + 1
      # The half an existence check cannot reach. `#s3-5` resolving proves
      # only that *an* element is called s3-5; it is worth linking to only
      # because the id's number and the number the heading prints are the
      # same number. Nothing forces them to be -- the id is a counter, the
      # printed number is typed by hand -- so insert one `###` into the middle
      # of a spec chapter without renumbering the rest and every later link
      # keeps resolving while naming the section before the one it means.
      # That is the failure this catches and the previous paragraph's check
      # cannot. A heading whose text prints no number is skipped, not
      # guessed at: 25 of them are unnumbered on purpose.
      for h in headings_of(must_read("${out}/${f}")) {
        let (hid, htext) = h
        let want = id_number(hid)
        let got = leading_number(htext)
        if want != "" && got != "" {
          numbered = numbered + 1
          if want != got {
            broken = broken ++ ["${f}: id \"${hid}\" claims §${want} but the heading prints §${got}"]
          }
        }
      }
      for href in hrefs_of(must_read("${out}/${f}")) {
        if not is_external(href) {
          let path = path_of(href)
          let frag = frag_of(href)
          # A bare `#frag` names this page; anything else names the page the
          # path resolves to.
          let target = if path == "" { f } else { resolve(dir_of(f), path) }
          var target_exists = true
          if path != "" {
            checked = checked + 1
            target_exists = set.has(files, target)
            if not target_exists {
              broken = broken ++ ["${f} -> ${href} (resolved: ${target})"]
            }
            # A page must reach the shared assets by their fingerprinted names.
            # Existence cannot see this one: both names are on disk, so a page
            # that went back to linking `assets/style.css` resolves, passes,
            # and quietly puts the one-year `immutable` header back on a URL
            # whose bytes change -- which is the bug the fingerprints were
            # added to fix. The plain copies are the alias older cached HTML
            # asks for; nothing this generator writes may ask for them.
            if str.starts_with(target, "assets/") {
              assets = assets + 1
              let name = last_segment(target)
              if not is_fingerprinted(name) {
                broken = broken
                  ++ ["${f} -> ${href}: assets/${name} carries no content hash, so its URL "
                      ++ "cannot change when its bytes do"]
              }
            }
          }
          # Only .html has ids to check against, and a target we already
          # reported as missing is not reported twice.
          if frag != "" && target_exists && str.ends_with(target, ".html") {
            if is_play_target(target) {
              payloads = payloads + 1
              if not is_editor_payload(frag) {
                broken = broken
                  ++ ["${f} -> ${target}#...: the fragment is not standard Base64 over "
                      ++ "well-formed UTF-8, so the editor cannot load it"]
              }
            } else {
              anchors = anchors + 1
              let page_ids = unwrap_or(map.get(ids, target), set.empty())
              if not set.has(page_ids, frag) {
                broken = broken ++ ["${f} -> ${href} (no id \"${frag}\" in ${target})"]
              }
            }
          }
        }
      }
    }
  }
  # The search indexes, whose hrefs are in an asset rather than in a page: the
  # title indexes and the body indexes, checked alike.
  var indexes = 0
  var bodies = 0
  var index_links = 0
  for name in must_list("${out}/assets") {
    let is_body = is_search_body(name)
    if is_search_index(name) || is_body {
      let text = must_read("${out}/assets/${name}")
      let hrefs = if is_body { body_hrefs(name, text) } else { index_hrefs(name, text) }
      if is_body {
        bodies = bodies + 1
      } else {
        indexes = indexes + 1
      }
      if len(hrefs) == 0 {
        broken = broken
          ++ ["assets/${name}: the search index is empty, so the panel can find nothing"]
      }
      for href in hrefs {
        index_links = index_links + 1
        let target = resolve("", href)
        let frag = frag_of(href)
        if not set.has(files, target) {
          broken = broken
            ++ ["assets/${name} -> ${href}: the index names a page that was never written "
                ++ "(resolved: ${target})"]
        } else if frag != "" {
          let page_ids = unwrap_or(map.get(ids, target), set.empty())
          if not set.has(page_ids, frag) {
            broken = broken ++ ["assets/${name} -> ${href} (no id \"${frag}\" in ${target})"]
          }
        }
      }
    }
  }
  if indexes == 0 {
    broken = broken
      ++ ["assets/: no search index was written, so every page's search button "
          ++ "fetches a file that is not there"]
  }
  if bodies == 0 {
    broken = broken
      ++ ["assets/: no search body index was written, so the panel can search titles only"]
  }
  if len(broken) > 0 {
    for b in broken {
      println("BROKEN LINK: ${b}")
    }
    panic("${len(broken)} broken links")
  }
  println(
    "  link check: ${checked} internal href/src(s), ${anchors} #fragment(s) and ${numbered} numbered "
      ++ "heading id(s) across ${pages} pages, all resolve; ${assets} of them reach assets/ "
      ++ "and every one is content-hashed; ${payloads} prefilled Playground fragment(s) decode; "
      ++ "${index_links} search-index href(s) in ${indexes} title and ${bodies} body index(es) "
      ++ "resolve, fragments included")
}

test "resolution normalizes relative segments" {
  assert resolve("tutorial", "../spec.html") == "spec.html"
  assert resolve("tutorial", "02.html") == "tutorial/02.html"
  assert resolve("", "./assets/style.css") == "assets/style.css"
  assert resolve("examples", "../tutorial/index.html#s2") == "tutorial/index.html"
}

test "href extraction" {
  assert hrefs_of(`<a href="a.html">x</a> <link href="b.css">`) == ["a.html", "b.css"]
}

## The fetched-URL half a stylesheet link and an <img> do not share.
test "src is fetched too, so it is checked too" {
  assert hrefs_of(`<img src="assets/logo.png"><script src="assets/p.js"></script>`)
    == ["assets/logo.png", "assets/p.js"]
  assert hrefs_of(`<a href="a.html"><img src="b.png"></a>`) == ["a.html", "b.png"]
}

## The third one: a URL the browser fetches on the page's own instruction. It
## resolves and it is content-hashed or it is not, exactly like the other two.
test "the demo page's reactor is a fetched URL too" {
  assert hrefs_of(`<div class="tea-mount" data-wasm="./assets/tea-counter.ab12cd34.wasm"></div>`)
    == ["./assets/tea-counter.ab12cd34.wasm"]
}

## The Playground's `data-endpoint` is a service, not a file this generator
## wrote: `/api/run` resolves to nothing under site/dist on purpose, and with
## DAWN_SITE_PLAY_ORIGIN set it is on another origin entirely. So it is not one
## of the fetched URLs above, in either form, and were it ever added the
## absolute form would still be classed external rather than a dead link.
test "the playground's service endpoint is not a link into the site" {
  assert hrefs_of(`<div id="dawn-playground" data-endpoint="/api/run"></div>`) == []
  assert hrefs_of(`<div id="dawn-playground" data-endpoint="https://play.example.test/api/run"></div>`)
    == []
  assert is_external("https://play.example.test/api/run")
}

## The title index and the body index share a prefix and not a shape; each is
## read by the reader that knows its shape.
test "a body index is told apart from a title index and read for its hrefs" {
  assert is_search_index("search-en.json")
  assert not is_search_index("search-body-en.json")
  assert is_search_body("search-body-zh.json")
  assert not is_search_body("search-body-zh.0123abcd.json")
  assert hrefs_of(`<div id="dawn-search" data-search-body="../assets/search-body-en.ab12cd34.json" hidden>`)
    == ["../assets/search-body-en.ab12cd34.json"]
  let text = "[1,[[\"spec\",\"spec.html\",\"Spec\"],[\"spec\",\"spec.html#s1\",\"One\"]],[],[],[]]"
  assert body_hrefs("search-body-en.json", text) == ["spec.html", "spec.html#s1"]
}

test "id extraction" {
  assert ids_of(`<h2 id="s3">t</h2><h3 id="s3-1">u</h3>`) == ["s3", "s3-1"]
  # The leading space in the opener is what keeps these out.
  assert ids_of(`<div data-id="x"></div><p aria-id="y">`) == []
}

## A bare `#frag` is a link into this page, not somebody else's page. Calling
## it external is how 272 of them went unchecked.
test "a same-page fragment is not an external link" {
  assert not is_external("#s2-3")
  assert is_external("https://example.com/#s2-3")
  assert path_of("#s2-3") == ""
  assert frag_of("#s2-3") == "s2-3"
}

## The redirection, both ways: a fragment on the Playground is read as a
## program, and a fragment anywhere else is still read as an id.
test "the playground's fragment is a program, not an id" {
  assert is_play_target("playground.html")
  assert is_play_target("zh/playground.html")
  assert not is_play_target("tutorial/03.html")
  # `bGV0IHggPSAx` is `let x = 1`; the url-safe alphabet and a truncated
  # multi-byte character are the two ways the generator could get it wrong.
  assert is_editor_payload("bGV0IHggPSAx")
  assert not is_editor_payload("Zm4-bWFpbg==")
  assert not is_editor_payload("5Lg=")
  assert not is_editor_payload("s3-1")
}

test "an href splits into path and fragment" {
  assert path_of("../spec.html#s9-5-1") == "../spec.html"
  assert frag_of("../spec.html#s9-5-1") == "s9-5-1"
  assert path_of("spec.html") == "spec.html"
  assert frag_of("spec.html") == ""
}

test "an id states the section number it claims" {
  assert id_number("s9-8-1") == "9.8.1"
  assert id_number("s6") == "6"
  # Not a heading counter: the stdlib page ids names, not numbers.
  assert id_number("str-split") == ""
  assert id_number("s") == ""
}

test "a heading's printed number is read off its text" {
  assert leading_number("9.8.1 载荷") == "9.8.1"
  assert leading_number("6. 效果系统") == "6"
  assert leading_number("安装") == ""
}

## The pairing the whole numbering check rests on.
test "headings pair their id with their text" {
  let html = `<h2 id="s6">6. 效果系统</h2><h3 id="s6-5">6.5 具名效果与 <code>with</code></h3>`
  assert headings_of(html) == [("s6", "6. 效果系统"), ("s6-5", "6.5 具名效果与 ")]
  # the number set apart by the renderer is still the number this reads
  let split = `<h2 id="s6"><span class="hn">6.</span>效果系统<a class="anchor" href="#s6">#</a></h2>`
    ++ `<h3 id="s6-5"><span class="hn">6.5</span>具名效果</h3><h3 id="s7-1">无节号</h3>`
  assert headings_of(split) == [("s6", "6."), ("s6-5", "6.5"), ("s7-1", "无节号")]
  assert leading_number("6.") == "6"
}

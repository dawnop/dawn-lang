# A literal outside a std fixed-width type's range is a compile error worded
# by the library's own FromInt impl (docs/literal-system-design.md D6, D13),
# at both ends and for a negated literal; U64 refuses a negative literal,
# since its large values are `u64.wrap` of a bit pattern and not literals.
use std/int/u8
use std/int/u64
use std/int/i8

fn bytes() -> (u8.U8, u8.U8, i8.I8, i8.I8) = (300, -1, -129, 128)

fn wide() -> u64.U64 = -1

pub fn main() -> Unit !io = println("${bytes()} ${wide()}")

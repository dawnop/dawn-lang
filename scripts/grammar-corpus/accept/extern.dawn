# F1 parses a whole extern body with or without a fallback. Placement,
# visibility, effects and ABI types belong to checker fixtures instead.
fn bare(x: Int) -> Int !io = extern c "bare"
fn fallback(x: Int) -> Int !io = extern c "fallback" else x
pub(pkg) fn lines(x: Int) -> Int !io =
  extern c "lines"
  else {
    x
  }
fn contextual(extern: Int, c: Int) -> Int = extern + c

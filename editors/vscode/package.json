{
  "name": "dawn-lang",
  "displayName": "Dawn Language",
  "description": "Language support for Dawn: diagnostics, hover, go to definition, outline.",
  "version": "0.1.0",
  "publisher": "dawnop",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dawnop/dawn-lang",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/dawnop/dawn-lang/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "scripts": {
    "test": "node test/scope-contract.js",
    "package": "vsce package --out dawn-lang.vsix"
  },
  "activationEvents": ["onLanguage:dawn"],
  "contributes": {
    "languages": [
      {
        "id": "dawn",
        "aliases": ["Dawn"],
        "extensions": [".dawn"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dawn",
        "scopeName": "source.dawn",
        "path": "./syntaxes/dawn.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Dawn",
      "properties": {
        "dawn.lspPath": {
          "type": "string",
          "default": "dawn",
          "description": "Path to the dawn CLI (the language server runs as `dawn lsp`)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}

# An interactive todo list built on packages/tea, the Elm architecture v1:
# the model, messages, update and view live in todo.dawn as pure functions.
# Since renderer knife 3 the io loop lives in the library too
# (tea/runtime.run, incremental repaint included), so this file is down to
# naming the app's pure hooks: how a line becomes a message, which ticks the
# model wants (none), and when to stop.
#
# Commands: `add <title>`, `tog <id>`, `del <id>`, `press <n>` (push the
# n-th button of the current view), `quit` (or `q`).

use tea/runtime.{run}
use tea/sub.{Sub}
use todo.{Model, Msg, initial, parse_cmd}

pub fn main() -> Unit !io =
  run(initial(), (m, line) => parse_cmd(m, line), m => no_ticks(m), m => m.quit)

fn no_ticks(m: Model) -> List[Sub[Msg]] = []

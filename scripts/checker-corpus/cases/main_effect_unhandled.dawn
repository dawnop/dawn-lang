# checker.dawn: an unanswered effect in main gets only the handler way out,
# because main may not declare a label at all (see main_effect.dawn). The
# sibling function is here for the contrast: it still gets both ways out.
effect Ask { fn get() -> Int }

pub fn sibling() -> Int = get()

pub fn main() -> Unit !io = {
  let _ = get()
  ()
}

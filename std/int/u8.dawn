## Unsigned 8-bit integers: `U8`, an opaque type over `Int` holding
## 0..255, with arithmetic that wraps the way `Int`'s does.
#
# GENERATED by scripts/fixed-ints/gen.py -- edit there and rerun it; the
# tree-policy gate fails on a hand edit here.
#
# One of seven sibling modules (std/int/i8, i16, i32, u8, u16, u32, u64) that
# share one shape; docs/literal-system-design.md D13 is the design and spec
# 11 the contract. Why they are std and not the compiler's: the compiler owns
# two numbers, Int and Float (D1), and a fixed-width integer is an Int with
# an invariant, which is what an opaque type is. Measured before this was
# written: packages/sha2's compression loop over std/int/u32 runs within 1% of
# the `Int` + `& MASK` form on both backends.
#
# They live under std/int/ so that seven of them do not crowd the top of
# std; `use` binds a path's last segment, so `use std/int/u32` still
# qualifies as `u32`.
#
# Why one module per width and not one module for all seven: a module is
# Dawn's namespace, so `u32.wrap(n)`, `u32.rotr(x, 7)` and `u8.wrap(n)` are
# the same names qualified differently, as `char.code` is for `Char`. One
# module would need either a width in every name (`wrap_u32`) or a trait
# whose `to_int` member shadows the builtin `to_int` in every importer, and
# the constructors could not be trait members anyway, since their subject is
# only in the return position. A program imports the widths it uses.
#
# The Int inside is always in 0..255, so equality, hashing and order
# are the Int's, inherited (spec 2.7), and correct as they stand: an impl
# of `Ord` of its own would say the same thing and turn every `<` from a
# native comparison into a call. Arithmetic is not inherited (an opaque
# type never inherits it, docs/arith-operator-traits-design.md D4) and is
# written below: each result is computed in Int and wrapped back to its
# low 8 bits, so `0 - 1` is 255. `/` and `%` are Int's on non-negative
# operands, and a zero divisor panics with Int's message.
#
# Wrapping and not trapping, as `Int` does (spec 4.3): two overflow rules in
# one family of types would have every reader looking up which one applies.
# `checked_add`, `checked_sub` and `checked_mul` answer `None` instead. A
# literal at `U8` is `FromInt`'s, range-checked at compile time, so
# `let b: U8 = 256` does not compile (outside this module: inside it the
# type is seen through and a literal is the Int it always was, literal design
# D7). The bitwise operations are named functions until the operators have
# traits of their own; `complement` and not `not`, which is a keyword. A
# shift or rotation count is taken modulo 8, as the JVM and the hardware do
# for Int's own shifts.

## A unsigned 8-bit integer.
pub opaque type U8 = Int

## The least `U8`, 0.
pub const MIN: U8 = 0

## The greatest `U8`, 255.
pub const MAX: U8 = 255

## `n` as a `U8`, or `None` when it is outside 0..255.
pub fn of(n: Int) -> Option[U8] = if n < 0 || n > 255 { None } else { Some(n) }

## The `U8` with the low 8 bits of `n`: `wrap(-1)` is 255.
pub fn wrap(n: Int) -> U8 = n & 0xFF

## The value of `x` as an Int.
pub fn to_int(x: U8) -> Int = x

# The literal's range check, run at compile time for every literal at this
# type outside this module.
impl FromInt[U8] {
  fn from_int(n: Int) -> U8 = {
    if n < 0 || n > 255 { panic("out of range for U8: ${n}") }
    n
  }
}

impl Show[U8] {
  fn show(x: U8) -> String = {
    let n: Int = x
    to_string(n)
  }
}

impl Add[U8] {
  fn add(a: U8, b: U8) -> U8 = {
    let x: Int = a
    let y: Int = b
    wrap(x + y)
  }
}

impl Sub[U8] {
  fn sub(a: U8, b: U8) -> U8 = {
    let x: Int = a
    let y: Int = b
    wrap(x - y)
  }
}

impl Mul[U8] {
  fn mul(a: U8, b: U8) -> U8 = {
    let x: Int = a
    let y: Int = b
    wrap(x * y)
  }
}

impl Div[U8] {
  fn div(a: U8, b: U8) -> U8 = {
    let x: Int = a
    let y: Int = b
    x / y
  }
}

impl Rem[U8] {
  fn rem(a: U8, b: U8) -> U8 = {
    let x: Int = a
    let y: Int = b
    x % y
  }
}

impl Neg[U8] {
  fn neg(a: U8) -> U8 = {
    let x: Int = a
    wrap(0 - x)
  }
}

## `a + b`, or `None` where it wraps.
pub fn checked_add(a: U8, b: U8) -> Option[U8] = {
  let x: Int = a
  let y: Int = b
  let r = x + y
  if r < 0 || r > 255 { None } else { Some(r) }
}

## `a - b`, or `None` where it wraps.
pub fn checked_sub(a: U8, b: U8) -> Option[U8] = {
  let x: Int = a
  let y: Int = b
  let r = x - y
  if r < 0 || r > 255 { None } else { Some(r) }
}

## `a * b`, or `None` where it wraps.
pub fn checked_mul(a: U8, b: U8) -> Option[U8] = {
  let x: Int = a
  let y: Int = b
  let r = x * y
  if r < 0 || r > 255 { None } else { Some(r) }
}

## The bitwise and.
pub fn and(a: U8, b: U8) -> U8 = {
  let x: Int = a
  let y: Int = b
  x & y
}

## The bitwise or.
pub fn or(a: U8, b: U8) -> U8 = {
  let x: Int = a
  let y: Int = b
  x | y
}

## The bitwise exclusive or.
pub fn xor(a: U8, b: U8) -> U8 = {
  let x: Int = a
  let y: Int = b
  x ^ y
}

## Every bit flipped.
pub fn complement(a: U8) -> U8 = {
  let x: Int = a
  wrap(~x)
}

## `a` shifted left by `n` modulo 8 places, zeros in at the bottom.
pub fn shl(a: U8, n: Int) -> U8 = {
  let x: Int = a
  wrap(x << (n & 7))
}

## `a` shifted right by `n` modulo 8 places, zeros in at the top.
pub fn shr(a: U8, n: Int) -> U8 = {
  let x: Int = a
  x >>> (n & 7)
}

## `a`'s 8 bits rotated left by `n` modulo 8 places.
pub fn rotl(a: U8, n: Int) -> U8 = {
  let x: Int = a
  let u = x & 0xFF
  let k = n & 7
  wrap((u << k) | (u >>> (8 - k)))
}

## `a`'s 8 bits rotated right by `n` modulo 8 places.
pub fn rotr(a: U8, n: Int) -> U8 = {
  let x: Int = a
  let u = x & 0xFF
  let k = n & 7
  wrap((u >>> k) | (u << (8 - k)))
}

# Representative cases; scripts/spike-native/fixed_ints holds the seven types
# to an oracle computed outside Dawn, on both backends.

test "the ends wrap into each other and the conversions agree" {
  assert MAX + wrap(1) == MIN
  assert MIN - wrap(1) == MAX
  assert to_int(wrap(7) / wrap(2)) == 3
  assert to_int(wrap(7) % wrap(2)) == 1
  assert rotl(wrap(1), 8) == wrap(1)
  assert rotr(wrap(1), 1) == shl(wrap(1), 7)
  assert checked_add(MAX, wrap(1)) == None
  assert checked_sub(MIN, wrap(1)) == None
  assert of(256) == None
  assert of(0) == Some(MIN)
  assert to_int(wrap(256)) == 0
  assert show(MIN) == "0"
  assert to_int(-wrap(1)) == 255
  assert to_int(complement(MIN)) == 255
}

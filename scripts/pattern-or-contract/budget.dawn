fn classify(value: (
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
)) -> Int =
  match value {
    (
      Some(true) | Some(false) | None,
      Some(true) | Some(false) | None,
      Some(true) | Some(false) | None,
      Some(true) | Some(false) | None,
      Some(true) | Some(false) | None,
      Some(true) | Some(false) | None,
      Some(true) | Some(false) | None,
      Some(true) | Some(false) | None,
    ) -> 1
  }

test "semantic reads project associated bounds in the trait domain" {
  let reads = Some([ScopedTypeParameter("T", Some(TyVar("T", 1))), ScopedTypeParameter("Missing", None),
    ParameterBounds(TyVar("T", 1), Some([1, 2, 1])), ParameterBounds(TyVar("U", 2), None),
    TraitAssociatedMembers(1, AssociatedType, ["Item", "Item", "Other"]), TraitAssociatedMembers(2, AssociatedEffect, [])])
  let type_map: fn(Ty) -> Option[Ty] = t => match t { TyVar(n, id) -> Some(TyVar(n, id + 10)), _ -> None }
  let moved = project_with_traits(reads, s => None, type_map, id => Some(id + 1000), e => None,
    (owner, source) => None, id => Some(id + 100))
  assert moved == Some(Some([ScopedTypeParameter("T", Some(TyVar("T", 11))), ScopedTypeParameter("Missing", None),
    ParameterBounds(TyVar("T", 11), Some([101, 102, 101])), ParameterBounds(TyVar("U", 12), None),
    TraitAssociatedMembers(101, AssociatedType, ["Item", "Item", "Other"]), TraitAssociatedMembers(102, AssociatedEffect, [])]))
  assert project(reads, s => None, type_map, id => Some(id), e => None) == None
  assert project_with_traits(reads, s => None, type_map, id => Some(id), e => None,
    (owner, source) => None, id => None) == None
  assert project_with_traits(reads, s => None, t => None, id => Some(id), e => None,
    (owner, source) => None, id => Some(id)) == None
  let empty = Some([ParameterBounds(TyVar("T", 1), Some([])), ScopedTypeParameter("Missing", None)])
  assert project_with_traits(empty, s => None, type_map, id => None, e => None,
    (owner, source) => None, id => None) == Some(Some([ParameterBounds(TyVar("T", 11), Some([])), ScopedTypeParameter("Missing", None)]))
}

test "semantic reads require owner scoped alias source projection" {
  let old = TNamed("Int", [], [], 0, 3)
  let next = TNamed("Int", [], [], 100, 104)
  let reads = Some([LocalAliasSource("Alias", "provider", Some(old)), LocalAliasSource("Imported", "other", None)])
  assert project(reads, s => Some(s), t => Some(t), id => Some(id), e => Some(e)) == None
  let moved = project_with_source(reads, s => Some(s), t => Some(t), id => Some(id), e => Some(e),
    (owner, source) => if owner == "provider" && source == old { Some(next) } else { None })
  assert moved == Some(Some([LocalAliasSource("Alias", "provider", Some(next)), LocalAliasSource("Imported", "other", None)]))
  assert project_with_source(reads, s => Some(s), t => Some(t), id => Some(id), e => Some(e),
    (owner, source) => if owner == "consumer" { Some(next) } else { None }) == None
  let absent = Some([LocalAliasSource("Imported", "provider", None)])
  assert project(absent, s => None, t => None, id => None, e => None) == Some(absent)
}

test "semantic reads project type and effect binders independently" {
  let diagnostic = ExportDiagnostic { message: "unknown type `Missing`", hint: Some("did you mean `Record`?") }
  let header = AliasTypeHeader { name: "Alias", tparams: [TyVar("T", 1)], eparams: [EffVar("e", 1)],
    opaque_id: Some(1), owner: "provider" }
  let reads = Some([QualifiedAliasHeader("h", "Alias", Some(header)), QualifiedAliasHeader("h", "Missing", None),
    QualifiedAliasTarget("h", "Alias", Some(TyVar("T", 1))), QualifiedAliasTarget("h", "Missing", None),
    NominalTypeName(Some("h"), "Record", Some(1)), NominalTypeName(None, "Missing", None),
    NominalTypeShape(1, "Record", 1, ["e"], true), LocalTypeDiagnostic("Missing", diagnostic),
    LocalAliasTarget("Alias", Some(TyVar("T", 1))), LocalAliasTarget("Missing", None),
    LocalAliasResolving("Alias", true), LocalAliasResolving("Other", false),
    LocalAliasHeader("Alias", Some(header)), LocalAliasHeader("Missing", None),
    LocalAliasBinders("Alias", [TyVar("T", 1)], [EffVar("e", 1)])])
  let moved = project(reads, s => None, t => Some(TyInt), id => Some(id + 10), e => Some(EIo)).expect("type reads projection")
  assert moved == Some([QualifiedAliasHeader("h", "Alias", Some(AliasTypeHeader { ..header,
    tparams: [TyInt], eparams: [EIo], opaque_id: Some(11) })), QualifiedAliasHeader("h", "Missing", None),
    QualifiedAliasTarget("h", "Alias", Some(TyInt)), QualifiedAliasTarget("h", "Missing", None),
    NominalTypeName(Some("h"), "Record", Some(11)), NominalTypeName(None, "Missing", None),
    NominalTypeShape(11, "Record", 1, ["e"], true), LocalTypeDiagnostic("Missing", diagnostic),
    LocalAliasTarget("Alias", Some(TyInt)), LocalAliasTarget("Missing", None),
    LocalAliasResolving("Alias", true), LocalAliasResolving("Other", false),
    LocalAliasHeader("Alias", Some(AliasTypeHeader { ..header, tparams: [TyInt], eparams: [EIo], opaque_id: Some(11) })),
    LocalAliasHeader("Missing", None), LocalAliasBinders("Alias", [TyInt], [EIo])])
  assert project(reads, s => None, t => None, id => Some(id), e => Some(e)) == None
  assert project(reads, s => None, t => Some(t), id => None, e => Some(e)) == None
  assert project(reads, s => None, t => Some(t), id => Some(id), e => None) == None
  let transparent = Some([QualifiedAliasHeader("h", "Alias", Some(AliasTypeHeader { ..header, opaque_id: None }))])
  assert project(transparent, s => None, t => Some(t), id => None, e => Some(e)) == Some(transparent)
  let prefix = record(Some([]), "earlier", None)
  assert capture(prefix, append(prefix, reads).expect("append type reads")) == Some(reads)
}

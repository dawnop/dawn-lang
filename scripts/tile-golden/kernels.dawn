# The kernels scripts/tile-golden pins. Each is traced twice (the two records
# must be equal, or this program panics) and then either rendered once, the
# text being the layer-0 golden, or encoded once into the bytecode file the
# layer-1 golden pins and `tileiras` assembles. run.sh copies this file to
# src/main.dawn of a project whose [deps] names packages/tileir, and runs it
# as `kernels <name>` (text to stdout), `kernels <name> --bytecode <path>`
# (bytes to the file) or `kernels --bytecode-version` (the header's version,
# which run.sh holds against toolchain.txt).
use std/io
use std/io.{with_fs_real, write_bytes}
use std/gpu.{F64, F32, BF16, F16, I32, I8}
use tileir/dev.{Dev, Param, Tile, Idx, param, block_id, tile_at, load, load_masked, load_strided, store, store_masked,
  store_strided, load_strided_masked, store_strided_masked, row_major, permute, coord, and_mask, or_mask, in_range, axis_mask,
  gather, gather_masked, scatter, scatter_masked, axis_strides,
  atomic_add_masked, atomic_cas_masked, ge_i,
  mmaf, addf, sub, mul, div,
  maxf, minf, neg, abs, fma, f_const, lt, le, gt, ge, eq, ne, eq_i, select, tail_mask, idx_const, idx_add, idx_mul, idx_eq,
  d_for, d_for3, exp, exp2, log, log2, sqrt, rsqrt, tanh, floor, ceil, pow, lanes,
  spread, d_reduce, d_reduce_dim, d_reduce2, d_if, s_addf, s_maxf, s_gt, s_select,
  i_const, i8_const, add_i, sub_i, mul_i, div_i, rem_i, max_i, min_i, mulhi_i, and_i, or_i, xor_i, shl_i, shr_i, lt_i,
  shr_u, neg_i, abs_i, int_to_float, float_to_int, mask_to_int, int_to_mask, bits_to_float, bits_to_int,
  float_to_float, ext_u8, trunc_u8, mmai,
  d_reduce_i, s_addi, s_maxi,
  d_scan, d_scan_i, d_scan2, s_mulf, s_fma, s_const, erf }
use tileir/prog.{TileProg, trace_kernel}
use tileir/render.{render}
use tileir/bytecode.{encode, bytecode_version}

# f64 vector add over 128-wide tiles: the first milestone's kernel
# (tile-backend-design 1), and the shape std/gpu's vadd_ref answers for.
fn vadd(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let blk = tile_at(block_id(0), 128)
  let ta = load(a, blk, [128])
  let tb = load(b, blk, [128])
  store(out, blk, [128], addf(F64, [128], ta, tb))
}

# The same kernel over f32 and 64-wide tiles: the case that reds when a load
# stops reading its parameter's format (run.sh's load-dtype-f64 mutant).
fn vadd_f32(a: Param[F32], b: Param[F32], out: Param[F32]) -> Unit !Dev = {
  let blk = tile_at(block_id(0), 64)
  let ta = load(a, blk, [64])
  let tb = load(b, blk, [64])
  store(out, blk, [64], addf(F32, [64], ta, tb))
}

# The same kernel over bf16 and 128-wide tiles: the second milestone's format
# (tile-backend-design 3.2). `addf` over a bf16 tile with
# `rounding<nearest_even>` is, by the double-rounding theorem, bit for bit
# `narrow.round_bf16` of the exact sum, which is what std/gpu's vadd_ref
# answers for a bf16 output buffer; scripts/tile-gpu-diff holds the device
# to it.
fn vadd_bf16(a: Param[BF16], b: Param[BF16], out: Param[BF16]) -> Unit !Dev = {
  let blk = tile_at(block_id(0), 128)
  let ta = load(a, blk, [128])
  let tb = load(b, blk, [128])
  store(out, blk, [128], addf(BF16, [128], ta, tb))
}

# f64 block-wise tile sum, the second milestone's loop kernel
# (tile-backend-design 5.2): block b folds the `chunks` consecutive 128-wide
# tiles of x numbered b*chunks .. b*chunks+chunks-1 into one tile of out,
# the first tile entering the loop and the rest added in order, which is
# the order std/gpu's sum_ref adds in. `chunks` is a host constant: fixed
# when the kernel is recorded, 4 in the golden.
fn sum(x: Param[F64], out: Param[F64], chunks: Int) -> Unit !Dev = {
  let b = block_id(0)
  let n = idx_const(chunks)
  let base = idx_mul(b, n)
  let first = load(x, tile_at(base, 128), [128])
  let one = idx_const(1)
  let lo = idx_add(base, one)
  let up = idx_add(base, n)
  let acc = d_for(lo, up, one, first, (k, t) => addf(F64, [128], t, load(x, tile_at(k, 128), [128])))
  store(out, tile_at(b, 128), [128], acc)
}

# ---- the boundary kernels (knife 7a) ----
#
# Every kernel below covers a vector whose length is NOT a multiple of the
# tile width, which is the shape every leetgpu problem has: the last block's
# lanes past the end are masked off, so they are neither read nor written,
# and the load answers the padding value there instead. The lengths and the
# widths are host constants, fixed when the kernel is recorded.

# The length and tile width of the 128-wide kernels: 1000 = 7 * 128 + 104, so
# the last of the eight blocks has 24 lanes past the end.
const TAIL_N: Int = 1000
const TAIL_TILE: Int = 128

# The clipping kernel is the second shape: 333 = 5 * 64 + 13, five full
# blocks and 51 lanes past the end of the sixth.
const CLIP_N: Int = 333
const CLIP_TILE: Int = 64

# f64 vector add over a vector of TAIL_N elements: leetgpu 1 (Vector
# Addition) and, over a flattened matrix, 8 (Matrix Addition).
fn vadd_tail(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, TAIL_TILE)
  let m = tail_mask(blk, [TAIL_TILE], TAIL_N)
  let pad = f_const(F64, [TAIL_TILE], 0.0)
  let ta = load_masked(a, blk, [TAIL_TILE], m, pad)
  let tb = load_masked(b, blk, [TAIL_TILE], m, pad)
  store_masked(out, blk, [TAIL_TILE], m, addf(F64, [TAIL_TILE], ta, tb))
}

# Element-wise copy: leetgpu 31 (Matrix Copy). The mask is the whole kernel.
fn copy(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, TAIL_TILE)
  let m = tail_mask(blk, [TAIL_TILE], TAIL_N)
  let pad = f_const(F64, [TAIL_TILE], 0.0)
  store_masked(out, blk, [TAIL_TILE], m, load_masked(x, blk, [TAIL_TILE], m, pad))
}

# max(x, 0): leetgpu 21 (ReLU).
fn relu(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, TAIL_TILE)
  let m = tail_mask(blk, [TAIL_TILE], TAIL_N)
  let zero = f_const(F64, [TAIL_TILE], 0.0)
  let t = load_masked(x, blk, [TAIL_TILE], m, zero)
  store_masked(out, blk, [TAIL_TILE], m, maxf(F64, [TAIL_TILE], t, zero))
}

# x where x >= 0, 0.01 * x where x < 0: leetgpu 23 (Leaky ReLU). Written with
# `lt` and `select` rather than `maxf`, because that is the shape every
# masked-branch kernel later takes.
fn leaky_relu(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, TAIL_TILE)
  let m = tail_mask(blk, [TAIL_TILE], TAIL_N)
  let zero = f_const(F64, [TAIL_TILE], 0.0)
  let alpha = f_const(F64, [TAIL_TILE], 0.01)
  let t = load_masked(x, blk, [TAIL_TILE], m, zero)
  let leaked = mul(F64, [TAIL_TILE], t, alpha)
  store_masked(out, blk, [TAIL_TILE], m, select(F64, [TAIL_TILE], lt(F64, [TAIL_TILE], t, zero), leaked, t))
}

# min(max(x, -1), 1) over a second shape: leetgpu 62 (Value Clipping).
fn clip(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, CLIP_TILE)
  let m = tail_mask(blk, [CLIP_TILE], CLIP_N)
  let zero = f_const(F64, [CLIP_TILE], 0.0)
  let lo = f_const(F64, [CLIP_TILE], -1.0)
  let hi = f_const(F64, [CLIP_TILE], 1.0)
  let t = load_masked(x, blk, [CLIP_TILE], m, zero)
  store_masked(out, blk, [CLIP_TILE], m, minf(F64, [CLIP_TILE], maxf(F64, [CLIP_TILE], t, lo), hi))
}

# No leetgpu problem needs this one: it exists so that every operation knife
# 7a added crosses `tileiras` (layer 1) and is computed on the device against
# a hand-written reference (layer 2). An opcode copied from the wrong row of
# the frozen table assembles as some other operation, and the only thing that
# tells `subf` from `divf` is an answer.
#
# The fused multiply-add is `a * 2 + b`: the product is exact, so a host
# reference that multiplies and then adds rounds once as well and the two
# agree bit for bit (a general `fma` does not, and the reference says so).
fn elemops(x: Param[F64], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, TAIL_TILE)
  let m = tail_mask(blk, [TAIL_TILE], TAIL_N)
  let zero = f_const(F64, [TAIL_TILE], 0.0)
  let two = f_const(F64, [TAIL_TILE], 2.0)
  let a = load_masked(x, blk, [TAIL_TILE], m, zero)
  let b = load_masked(y, blk, [TAIL_TILE], m, zero)
  let d = sub(F64, [TAIL_TILE], a, b)
  let q = div(F64, [TAIL_TILE], mul(F64, [TAIL_TILE], a, b), two)
  let v = abs(F64, [TAIL_TILE], neg(F64, [TAIL_TILE], q))
  let f = fma(F64, [TAIL_TILE], a, two, b)
  let s1 = select(F64, [TAIL_TILE], lt(F64, [TAIL_TILE], a, b), d, v)
  let s2 = select(F64, [TAIL_TILE], ge(F64, [TAIL_TILE], a, b), s1, f)
  let s3 = select(F64, [TAIL_TILE], eq(F64, [TAIL_TILE], a, b), minf(F64, [TAIL_TILE], a, b), s2)
  let s4 = select(F64, [TAIL_TILE], ne(F64, [TAIL_TILE], a, b), s3, maxf(F64, [TAIL_TILE], a, b))
  let s5 = select(F64, [TAIL_TILE], gt(F64, [TAIL_TILE], a, b), s4, d)
  let s6 = select(F64, [TAIL_TILE], le(F64, [TAIL_TILE], a, b), s5, v)
  store_masked(out, blk, [TAIL_TILE], m, s6)
}

# ---- the reduction, transcendental and region kernels (knife 7b) ----
#
# Every kernel below covers the WHOLE vector in one tile block: the shape a
# reduction over a vector has, since a reduce folds along a tile's dimension
# and this release has no cross-block reduction. 1000 elements in a
# 1024-wide tile, one block, the last 24 lanes masked off.
#
# The tiers these kernels are compared under are docs/tile-backend-design.md
# 6.5's, and scripts/leetgpu-diff/problems.txt records one per problem:
#
#   exact      every operation is IEEE-exact AND the corpus is one on which
#              every fold order of the reduction gives the same bits (the
#              order is not specified: Tile IR asks the function to be
#              associative and commutative and says nothing about the tree).
#   tolerance  an `exp`, `log`, `tanh`, `pow` or `rsqrt` is in the kernel;
#              those are libdevice approximations and no corpus makes them
#              bit-exact.
const RED_N: Int = 1000
const RED_TILE: Int = 1024

# Monte Carlo integration over [MC_A, MC_B] with RED_N samples: the estimate
# is the sample mean times the width of the interval, and the whole factor
# is one host constant fixed when the kernel is recorded.
const MC_A: Float = 0.0
const MC_B: Float = 2.0

# The epsilon under the root of the RMS normalisation, and the clipping
# half-width of the PPO surrogate: leetgpu's own defaults.
const RMS_EPS: Float = 1.0e-5
const PPO_EPS: Float = 0.2

# The temperature of the DPO loss.
const DPO_BETA: Float = 0.1

# The shape of the loop-and-branch kernel: two blocks, four 128-wide tiles
# each, so its input is 1024 elements and its output 256.
const FOLD_TILE: Int = 128
const FOLD_CHUNKS: Int = 4

fn mc_scale() -> Float = (MC_B - MC_A) / to_float(RED_N)

# `-inf`, the identity of a maximum and the padding value of a load whose
# masked-off lanes must lose every comparison. Written as a quotient because
# a Dawn source has no spelling for it.
fn neg_inf() -> Float = 0.0 - 1.0 / 0.0

# The mask, the zero tile and the whole vector of a one-block kernel, read
# with `pad` in the lanes past the end.
fn whole(x: Param[F64], pad: Float) -> (Tile[F64], Tile[F64], Tile[F64]) !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let p = f_const(F64, [RED_TILE], pad)
  (load_masked(x, blk, [RED_TILE], m, p), p, p)
}

# The sum of an RED_TILE-wide tile as one rank-0 tile.
fn sum_of(t: Tile[F64]) -> Tile[F64] !Dev =
  spread(F64, [1], d_reduce(F64, [RED_TILE], t, 0.0, (acc, e) => s_addf(F64, acc, e)))

# Write one f64 at element 0 of `out`. Every one-answer kernel here ends in
# this: a 1-wide tile at index 0, so the rest of the output buffer is left
# exactly as it was and scripts/tile-gpu-diff's sentinel is still there.
fn store_one(out: Param[F64], i: Idx, v: Tile[F64]) -> Unit !Dev = store(out, tile_at(i, 1), [1], v)

# Sum of a vector: leetgpu 4 (Reduction). The identity is 0.0 and the fold
# is the device's own; `tileiras` accepts a wrong identity (measured), which
# is what scripts/tile-gpu-diff's reduce-identity-wrong mutant rests on.
fn reduce_sum(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let zero = f_const(F64, [RED_TILE], 0.0)
  store_one(out, i, sum_of(load_masked(x, blk, [RED_TILE], m, zero)))
}

# exp(x - max) / sum(exp(x - max)): leetgpu 5 (Softmax). Two reductions, a
# transcendental and a division. The maximum is subtracted so that a corpus
# of large values does not overflow, which is the claim
# softmax-no-max-subtract removes.
fn softmax(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let ninf = f_const(F64, [RED_TILE], neg_inf())
  let zero = f_const(F64, [RED_TILE], 0.0)
  let t = load_masked(x, blk, [RED_TILE], m, ninf)
  let mx = spread(F64, [RED_TILE], d_reduce(F64, [RED_TILE], t, neg_inf(), (acc, e) => s_maxf(F64, acc, e)))
  let ex = exp(F64, [RED_TILE], sub(F64, [RED_TILE], t, mx))
  let inside = select(F64, [RED_TILE], m, ex, zero)
  let total = spread(F64, [RED_TILE], d_reduce(F64, [RED_TILE], inside, 0.0, (acc, e) => s_addf(F64, acc, e)))
  store_masked(out, blk, [RED_TILE], m, div(F64, [RED_TILE], ex, total))
}

# sum(a * b): leetgpu 17 (Dot Product). The masked-off lanes read 0.0, so
# their product is 0.0 and the identity carries them.
fn dot(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let zero = f_const(F64, [RED_TILE], 0.0)
  let ta = load_masked(a, blk, [RED_TILE], m, zero)
  let tb = load_masked(b, blk, [RED_TILE], m, zero)
  store_one(out, i, sum_of(mul(F64, [RED_TILE], ta, tb)))
}

# mean((p - t)^2): leetgpu 27 (Mean Squared Error).
fn mse(pred: Param[F64], target: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let zero = f_const(F64, [RED_TILE], 0.0)
  let d = sub(F64, [RED_TILE], load_masked(pred, blk, [RED_TILE], m, zero), load_masked(target, blk, [RED_TILE], m, zero))
  let s = sum_of(mul(F64, [RED_TILE], d, d))
  store_one(out, i, div(F64, [1], s, f_const(F64, [1], to_float(RED_N))))
}

# (b - a) * mean(y): leetgpu 35 (Monte Carlo Integration). `a` and `b` are
# host constants of the recorded kernel, as every shape here is.
fn monte_carlo(y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let zero = f_const(F64, [RED_TILE], 0.0)
  let s = sum_of(load_masked(y, blk, [RED_TILE], m, zero))
  store_one(out, i, mul(F64, [1], s, f_const(F64, [1], mc_scale())))
}

# x / sqrt(mean(x^2) + eps): leetgpu 50 (RMS Normalization). `sqrt` is the
# one operation knife 7b adds that IEEE 754 requires to be correctly
# rounded, so this kernel can be held to the bit-exact tier while its
# neighbours cannot.
fn rms_norm(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let zero = f_const(F64, [RED_TILE], 0.0)
  let t = load_masked(x, blk, [RED_TILE], m, zero)
  let s = spread(F64, [RED_TILE], d_reduce(F64, [RED_TILE], mul(F64, [RED_TILE], t, t), 0.0, (acc, e) => s_addf(F64, acc, e)))
  let mean = div(F64, [RED_TILE], s, f_const(F64, [RED_TILE], to_float(RED_N)))
  let r = sqrt(F64, [RED_TILE], addf(F64, [RED_TILE], mean, f_const(F64, [RED_TILE], RMS_EPS)))
  store_masked(out, blk, [RED_TILE], m, div(F64, [RED_TILE], t, r))
}

# x / (1 + exp(-x)): leetgpu 52 (Sigmoid Linear Unit). No reduction, so the
# tolerance is `exp`'s alone.
fn silu(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let zero = f_const(F64, [RED_TILE], 0.0)
  let one = f_const(F64, [RED_TILE], 1.0)
  let t = load_masked(x, blk, [RED_TILE], m, zero)
  let d = addf(F64, [RED_TILE], one, exp(F64, [RED_TILE], neg(F64, [RED_TILE], t)))
  store_masked(out, blk, [RED_TILE], m, div(F64, [RED_TILE], t, d))
}

# 1 / (1 + exp(-x)): leetgpu 68 (Sigmoid Activation).
fn sigmoid(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let zero = f_const(F64, [RED_TILE], 0.0)
  let one = f_const(F64, [RED_TILE], 1.0)
  let t = load_masked(x, blk, [RED_TILE], m, zero)
  let d = addf(F64, [RED_TILE], one, exp(F64, [RED_TILE], neg(F64, [RED_TILE], t)))
  store_masked(out, blk, [RED_TILE], m, div(F64, [RED_TILE], one, d))
}

# -mean(min(r * A, clip(r, 1 - e, 1 + e) * A)) with r = exp(new - old):
# leetgpu 107 (PPO Clipped Surrogate Loss).
fn ppo_loss(new: Param[F64], old: Param[F64], adv: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let zero = f_const(F64, [RED_TILE], 0.0)
  let tn = load_masked(new, blk, [RED_TILE], m, zero)
  let to = load_masked(old, blk, [RED_TILE], m, zero)
  let ta = load_masked(adv, blk, [RED_TILE], m, zero)
  let r = exp(F64, [RED_TILE], sub(F64, [RED_TILE], tn, to))
  let lo = f_const(F64, [RED_TILE], 1.0 - PPO_EPS)
  let hi = f_const(F64, [RED_TILE], 1.0 + PPO_EPS)
  let clipped = minf(F64, [RED_TILE], maxf(F64, [RED_TILE], r, lo), hi)
  let both = minf(F64, [RED_TILE], mul(F64, [RED_TILE], r, ta), mul(F64, [RED_TILE], clipped, ta))
  let s = sum_of(select(F64, [RED_TILE], m, both, zero))
  store_one(out, i, neg(F64, [1], div(F64, [1], s, f_const(F64, [1], to_float(RED_N)))))
}

# -mean(log(sigmoid(beta * ((pc - pr) - (rc - rr))))): leetgpu 108 (DPO
# Sequence Loss). `log` and `exp` in one kernel, so the tolerance covers
# both.
fn dpo_loss(pc: Param[F64], pr: Param[F64], rc: Param[F64], rr: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let zero = f_const(F64, [RED_TILE], 0.0)
  let one = f_const(F64, [RED_TILE], 1.0)
  let a = sub(F64, [RED_TILE], load_masked(pc, blk, [RED_TILE], m, zero), load_masked(pr, blk, [RED_TILE], m, zero))
  let b = sub(F64, [RED_TILE], load_masked(rc, blk, [RED_TILE], m, zero), load_masked(rr, blk, [RED_TILE], m, zero))
  let z = mul(F64, [RED_TILE], f_const(F64, [RED_TILE], DPO_BETA), sub(F64, [RED_TILE], a, b))
  let sg = div(F64, [RED_TILE], one, addf(F64, [RED_TILE], one, exp(F64, [RED_TILE], neg(F64, [RED_TILE], z))))
  let s = sum_of(select(F64, [RED_TILE], m, log(F64, [RED_TILE], sg), zero))
  store_one(out, i, neg(F64, [1], div(F64, [1], s, f_const(F64, [1], to_float(RED_N)))))
}

# No leetgpu problem needs this one: it is to `exp`, `log` and their
# neighbours what `elemops` is to `subf` and `divf`. Every transcendental
# knife 7b adds is applied to the same tile and the ten results are summed
# in a fixed order, so an opcode copied from the wrong row of the frozen
# table -- which `tileiras` would accept, since every one of them takes a
# float tile and answers one -- moves the sum by far more than the
# tolerance. Tolerance tier, and no corpus could make it exact.
fn mathops(x: Param[F64], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, TAIL_TILE)
  let m = tail_mask(blk, [TAIL_TILE], TAIL_N)
  let one = f_const(F64, [TAIL_TILE], 1.0)
  let a = load_masked(x, blk, [TAIL_TILE], m, one)
  let b = load_masked(y, blk, [TAIL_TILE], m, one)
  let s1 = addf(F64, [TAIL_TILE], exp(F64, [TAIL_TILE], a), exp2(F64, [TAIL_TILE], a))
  let s2 = addf(F64, [TAIL_TILE], s1, log(F64, [TAIL_TILE], a))
  let s3 = addf(F64, [TAIL_TILE], s2, log2(F64, [TAIL_TILE], a))
  let s4 = addf(F64, [TAIL_TILE], s3, sqrt(F64, [TAIL_TILE], a))
  let s5 = addf(F64, [TAIL_TILE], s4, rsqrt(F64, [TAIL_TILE], a))
  let s6 = addf(F64, [TAIL_TILE], s5, tanh(F64, [TAIL_TILE], a))
  let s7 = addf(F64, [TAIL_TILE], s6, pow(F64, [TAIL_TILE], a, b))
  let s8 = addf(F64, [TAIL_TILE], s7, floor(F64, [TAIL_TILE], b))
  let s9 = addf(F64, [TAIL_TILE], s8, ceil(F64, [TAIL_TILE], b))
  store_masked(out, blk, [TAIL_TILE], m, s9)
}

# Nor does any problem need this one: it is the oracle for the two region
# shapes a reduction does not reach. A loop carrying THREE tiles (`d_for3`,
# which an online softmax needs) folds the sum, the maximum and the minimum
# of a block's chunks at once, and an `if` over a rank-0 mask -- the first
# operation in this package with two regions -- chooses the sum in block 0
# and the range everywhere else. Both branches are taken by the corpus,
# because the grid has two blocks.
fn foldif(x: Param[F64], out: Param[F64], chunks: Int) -> Unit !Dev = {
  let b = block_id(0)
  let n = idx_const(chunks)
  let base = idx_mul(b, n)
  let one = idx_const(1)
  let first = load(x, tile_at(base, FOLD_TILE), [FOLD_TILE])
  let (total, hi, lo) = d_for3(idx_add(base, one), idx_add(base, n), one, first, first, first, (k, s, h, l) => {
    let t = load(x, tile_at(k, FOLD_TILE), [FOLD_TILE])
    (addf(F64, [FOLD_TILE], s, t), maxf(F64, [FOLD_TILE], h, t), minf(F64, [FOLD_TILE], l, t))
  })
  let r = d_if(idx_eq(b, idx_const(0)), () => total, () => sub(F64, [FOLD_TILE], hi, lo))
  store(out, tile_at(b, FOLD_TILE), [FOLD_TILE], r)
}

# And nor does this one: it is the oracle for the N-ary reduction, the shape
# argmax has, where the winning value and the lane it came from must travel
# through one fold together. The answer is the one-hot vector of the argmax,
# so that both halves of the pair are visible in an f64 buffer: the value
# decides who wins and the INDEX decides where the 1 lands.
fn argmax(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, RED_TILE)
  let m = tail_mask(blk, [RED_TILE], RED_N)
  let ninf = f_const(F64, [RED_TILE], neg_inf())
  let t = load_masked(x, blk, [RED_TILE], m, ninf)
  let (_best, where) = d_reduce2(F64, [RED_TILE], t, lanes(blk, [RED_TILE]), neg_inf(), 0 - 1, (av, ai, ev, ei) => {
    let win = s_gt(F64, av, ev)
    (s_select(F64, win, av, ev), s_select(I32, win, ai, ei))
  })
  let hot = eq_i([RED_TILE], lanes(blk, [RED_TILE]), spread(I32, [RED_TILE], where))
  store_masked(out, blk, [RED_TILE], m, select(F64, [RED_TILE], hot, f_const(F64, [RED_TILE], 1.0), f_const(F64, [RED_TILE], 0.0)))
}

# ---- the two-dimensional kernels (knife 8) ----
#
# Every kernel below reads a BLOCK of a larger array rather than a
# contiguous run of it, which is what `load_strided` is for: the shape is
# the tile and the strides are the array's, both host constants fixed when
# the kernel is recorded. Nothing here is masked: every shape divides its
# tile exactly, so the boundary machinery of knife 7a is not in the way of
# reading what the two dimensions do.

# The GEMM: C = A * B over 256x256 matrices in 64x64 tiles, walking K in
# steps of 32. The grid is two-dimensional (M/TM by N/TN) and the
# accumulator travels through the K loop as its carried value, which is the
# claim scripts/tile-gpu-diff's mma-acc-not-carried removes.
const MM_M: Int = 256
const MM_N: Int = 256
const MM_K: Int = 256
const MM_TM: Int = 64
const MM_TN: Int = 64
const MM_TK: Int = 32

fn matmul(a: Param[F64], b: Param[F64], c: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let a_row = idx_mul(bm, idx_const(MM_TM * MM_K))
  let b_col = idx_mul(bn, idx_const(MM_TN))
  let zero = f_const(F64, [MM_TM, MM_TN], 0.0)
  let acc = d_for(idx_const(0), idx_const(MM_K / MM_TK), idx_const(1), zero, (k, sofar) => {
    let ta = load_strided(a, idx_add(a_row, idx_mul(k, idx_const(MM_TK))), [MM_TM, MM_TK], [MM_K, 1])
    let tb = load_strided(b, idx_add(b_col, idx_mul(k, idx_const(MM_TK * MM_N))), [MM_TK, MM_TN], [MM_N, 1])
    mmaf(F64, MM_TM, MM_TK, MM_TN, ta, tb, sofar)
  })
  store_strided(c, idx_add(idx_mul(bm, idx_const(MM_TM * MM_N)), b_col), [MM_TM, MM_TN], [MM_N, 1], acc)
}

# The batched GEMM: BMM_B independent 64x64 products in 32x32 tiles, the
# batch on the grid's THIRD axis. leetgpu 30.
const BMM_B: Int = 4
const BMM_M: Int = 64
const BMM_N: Int = 64
const BMM_K: Int = 64
const BMM_T: Int = 32

fn batched_matmul(a: Param[F64], b: Param[F64], c: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let bb = block_id(2)
  let a_row = idx_add(idx_mul(bb, idx_const(BMM_M * BMM_K)), idx_mul(bm, idx_const(BMM_T * BMM_K)))
  let b_col = idx_add(idx_mul(bb, idx_const(BMM_K * BMM_N)), idx_mul(bn, idx_const(BMM_T)))
  let zero = f_const(F64, [BMM_T, BMM_T], 0.0)
  let acc = d_for(idx_const(0), idx_const(BMM_K / BMM_T), idx_const(1), zero, (k, sofar) => {
    let ta = load_strided(a, idx_add(a_row, idx_mul(k, idx_const(BMM_T))), [BMM_T, BMM_T], [BMM_K, 1])
    let tb = load_strided(b, idx_add(b_col, idx_mul(k, idx_const(BMM_T * BMM_N))), [BMM_T, BMM_T], [BMM_N, 1])
    mmaf(F64, BMM_T, BMM_T, BMM_T, ta, tb, sofar)
  })
  let c_base = idx_add(idx_add(idx_mul(bb, idx_const(BMM_M * BMM_N)), idx_mul(bm, idx_const(BMM_T * BMM_N))),
    idx_mul(bn, idx_const(BMM_T)))
  store_strided(c, c_base, [BMM_T, BMM_T], [BMM_N, 1], acc)
}

# The transpose of a 128x64 matrix in 32x32 tiles. No leetgpu problem here:
# 3 (Matrix Transpose) has shapes that are not multiples of a tile and needs
# the boundary of a later knife. This one is the ORACLE for a store whose
# strides are not row-major: the tile is read `[C, 1]` and written `[1, R]`,
# so the same values land transposed with no shape operation at all. The
# matrix is deliberately not square, so swapping the two strides is a wrong
# answer rather than a different spelling of the same one.
const TR_ROWS: Int = 128
const TR_COLS: Int = 64
const TR_TILE: Int = 32

fn transpose(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let bi = block_id(0)
  let bj = block_id(1)
  let base_in = idx_add(idx_mul(bi, idx_const(TR_TILE * TR_COLS)), idx_mul(bj, idx_const(TR_TILE)))
  let t = load_strided(x, base_in, [TR_TILE, TR_TILE], [TR_COLS, 1])
  let base_out = idx_add(idx_mul(bj, idx_const(TR_TILE * TR_ROWS)), idx_mul(bi, idx_const(TR_TILE)))
  store_strided(out, base_out, [TR_TILE, TR_TILE], [1, TR_ROWS], t)
}

# Layer normalisation over the last dimension of a LN_ROWS by LN_D matrix,
# one row a block: leetgpu 113. `gamma` and `beta` are one LN_D-long vector
# each, read at offset 0 by every block.
const LN_ROWS: Int = 64
const LN_D: Int = 256
const LN_EPS: Float = 1.0e-5

# `(t - mean) / sqrt(var + eps)`, the normalisation every kernel below
# shares, over a tile of `shape` holding `count` values.
fn normalise(shape: List[Int], count: Int, eps: Float, t: Tile[F64]) -> Tile[F64] !Dev = {
  let n = f_const(F64, shape, to_float(count))
  let total = spread(F64, shape, d_reduce(F64, shape, t, 0.0, (acc, e) => s_addf(F64, acc, e)))
  let mean = div(F64, shape, total, n)
  let d = sub(F64, shape, t, mean)
  let sq = spread(F64, shape, d_reduce(F64, shape, mul(F64, shape, d, d), 0.0, (acc, e) => s_addf(F64, acc, e)))
  let variance = div(F64, shape, sq, n)
  div(F64, shape, d, sqrt(F64, shape, addf(F64, shape, variance, f_const(F64, shape, eps))))
}

fn layer_norm(x: Param[F64], gamma: Param[F64], beta: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let row = tile_at(block_id(0), LN_D)
  let t = load(x, row, [LN_D])
  let g = load(gamma, idx_const(0), [LN_D])
  let b = load(beta, idx_const(0), [LN_D])
  let r = normalise([LN_D], LN_D, LN_EPS, t)
  store(out, row, [LN_D], addf(F64, [LN_D], mul(F64, [LN_D], r, g), b))
}

# Batch normalisation over a BN_ROWS by BN_CHANNELS matrix, one CHANNEL a
# block: leetgpu 40. The column a block reads is a stride of BN_CHANNELS,
# and its `gamma` and `beta` are one element each, read with a stride of
# ZERO so that the whole column sees the same value without a broadcast
# operation of its own.
const BN_ROWS: Int = 128
const BN_CHANNELS: Int = 64
const BN_EPS: Float = 1.0e-5

fn batch_norm(x: Param[F64], gamma: Param[F64], beta: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let col = block_id(0)
  let t = load_strided(x, col, [BN_ROWS], [BN_CHANNELS])
  let g = load_strided(gamma, col, [BN_ROWS], [0])
  let b = load_strided(beta, col, [BN_ROWS], [0])
  let r = normalise([BN_ROWS], BN_ROWS, BN_EPS, t)
  store_strided(out, col, [BN_ROWS], [BN_CHANNELS], addf(F64, [BN_ROWS], mul(F64, [BN_ROWS], r, g), b))
}

# Group normalisation over a (GN_N, GN_C, GN_HW) tensor with GN_GROUPS
# groups of channels, one (sample, group) a block: leetgpu 105. The tile is
# TWO-dimensional -- the group's channels by the spatial extent -- so the
# mean is a reduction along dimension 1 followed by one along dimension 0,
# which is the first kernel here whose `dim` is not 0.
const GN_N: Int = 2
const GN_C: Int = 8
const GN_HW: Int = 32
const GN_GROUPS: Int = 4
const GN_EPS: Float = 1.0e-5

fn gn_per_group() -> Int = GN_C / GN_GROUPS

fn group_norm(x: Param[F64], gamma: Param[F64], beta: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let per = gn_per_group()
  let shape = [per, GN_HW]
  let s = block_id(0)
  let g = block_id(1)
  let base = idx_add(idx_mul(s, idx_const(GN_C * GN_HW)), idx_mul(g, idx_const(per * GN_HW)))
  let t = load_strided(x, base, shape, [GN_HW, 1])
  let chan = idx_mul(g, idx_const(per))
  let gt = load_strided(gamma, chan, shape, [1, 0])
  let bt = load_strided(beta, chan, shape, [1, 0])
  let count = per * GN_HW
  let n = f_const(F64, shape, to_float(count))
  let rows = d_reduce_dim(F64, shape, 1, t, 0.0, (acc, e) => s_addf(F64, acc, e))
  let total = spread(F64, shape, d_reduce(F64, [per], rows, 0.0, (acc, e) => s_addf(F64, acc, e)))
  let mean = div(F64, shape, total, n)
  let d = sub(F64, shape, t, mean)
  let sqrows = d_reduce_dim(F64, shape, 1, mul(F64, shape, d, d), 0.0, (acc, e) => s_addf(F64, acc, e))
  let sq = spread(F64, shape, d_reduce(F64, [per], sqrows, 0.0, (acc, e) => s_addf(F64, acc, e)))
  let variance = div(F64, shape, sq, n)
  let r = div(F64, shape, d, sqrt(F64, shape, addf(F64, shape, variance, f_const(F64, shape, GN_EPS))))
  store_strided(out, base, shape, [GN_HW, 1], addf(F64, shape, mul(F64, shape, r, gt), bt))
}

# The fused residual add and RMS normalisation of a FR_ROWS by FR_D matrix,
# one row a block: leetgpu 83. `w` is one FR_D-long vector read at offset 0
# by every block.
const FR_ROWS: Int = 64
const FR_D: Int = 256
const FR_EPS: Float = 1.0e-5

fn fused_rms_norm(x: Param[F64], res: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let row = tile_at(block_id(0), FR_D)
  let h = addf(F64, [FR_D], load(x, row, [FR_D]), load(res, row, [FR_D]))
  let g = load(w, idx_const(0), [FR_D])
  let n = f_const(F64, [FR_D], to_float(FR_D))
  let sq = spread(F64, [FR_D], d_reduce(F64, [FR_D], mul(F64, [FR_D], h, h), 0.0, (acc, e) => s_addf(F64, acc, e)))
  let ms = div(F64, [FR_D], sq, n)
  let r = div(F64, [FR_D], h, sqrt(F64, [FR_D], addf(F64, [FR_D], ms, f_const(F64, [FR_D], FR_EPS))))
  store(out, row, [FR_D], mul(F64, [FR_D], r, g))
}

# ---- the strided kernels (knife 9) ----
#
# Every kernel below reads or writes a tile whose LAYOUT is not the array's
# own row-major one: a transpose is `permute`d strides, a convolution is one
# load a tap at a shifted base, a pooling window is a stride of the window
# size, an interleave is a store with a stride of two, and a colour channel
# is a stride of three. Nothing here is a new instruction: the ladder was
# already `iota * stride` summed over the dimensions (knife 8), and what
# knife 9 adds is the arithmetic that puts arbitrary numbers in it and the
# per-axis masks (`axis_mask`, `in_range`) that keep a tile whose array
# extent is not a multiple of it from reading or writing past the end along
# EITHER axis.
#
# So every kernel here is an EXACT-tier kernel: the arithmetic is the same
# `mulf` and `addf` (and `maxf`) the earlier knives already pinned, and only
# the addressing is new. A reference that folds its taps in the kernel's
# order agrees bit for bit.
#
# Every extent below is deliberately NOT a multiple of its tile, and every
# two-dimensional one is deliberately RECTANGULAR: a square array hides a
# swap of the two strides (scripts/tile-gpu-diff's stride-row-major-swapped
# says why).

# leetgpu 3 (Matrix Transpose): a 100 by 60 matrix in 32 by 32 tiles. The
# tile is read with the input's row-major strides and written with the
# OUTPUT's permuted: `permute(row_major([cols, rows]), [1, 0])`, which is
# `[1, rows]`. No element moves inside the tile and no shape operation is
# issued; the transpose is the layout.
const TT_ROWS: Int = 100
const TT_COLS: Int = 60
const TT_TILE: Int = 32

fn transpose_tail(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [TT_TILE, TT_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let r0 = idx_mul(bi, idx_const(TT_TILE))
  let c0 = idx_mul(bj, idx_const(TT_TILE))
  let m = and_mask(shape, axis_mask(r0, shape, 0, TT_ROWS), axis_mask(c0, shape, 1, TT_COLS))
  let pad = f_const(F64, shape, 0.0)
  let base_in = idx_add(idx_mul(bi, idx_const(TT_TILE * TT_COLS)), c0)
  let t = load_strided_masked(x, base_in, shape, row_major([TT_ROWS, TT_COLS]), m, pad)
  let base_out = idx_add(idx_mul(bj, idx_const(TT_TILE * TT_ROWS)), r0)
  store_strided_masked(out, base_out, shape, permute(row_major([TT_COLS, TT_ROWS]), [1, 0]), m, t)
}

# leetgpu 9 (1D Convolution), valid mode: `out[i] = sum(x[i + t] * w[t])`
# over C1_K taps, so the output is C1_K - 1 shorter than the input. Each tap
# is one load at a base one element further on, and the weight is one load
# with a stride of ZERO: every lane of the tile reads the same `w[t]`,
# which is a layout rather than a broadcast operation.
const C1_N: Int = 1000
const C1_K: Int = 5
const C1_TILE: Int = 128

fn c1_out() -> Int = C1_N - C1_K + 1

fn conv1d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [C1_TILE]
  let blk = tile_at(block_id(0), C1_TILE)
  let m = tail_mask(blk, shape, c1_out())
  let zero = f_const(F64, shape, 0.0)
  var acc = zero
  for t in range(0, C1_K) {
    let xt = load_masked(x, idx_add(blk, idx_const(t)), shape, m, zero)
    let wt = load_strided(w, idx_const(t), shape, [0])
    acc = addf(F64, shape, acc, mul(F64, shape, xt, wt))
  }
  store_masked(out, blk, shape, m, acc)
}

# leetgpu 10 (2D Convolution), valid mode over a 40 by 36 image with a 3 by
# 3 kernel, in 16 by 16 tiles. One load a tap again, now at a base shifted
# by `p * width + q`, and the weight read with strides `[0, 0]`.
const C2_H: Int = 40
const C2_W: Int = 36
const C2_K: Int = 3
const C2_TILE: Int = 16

fn c2_oh() -> Int = C2_H - C2_K + 1

fn c2_ow() -> Int = C2_W - C2_K + 1

fn conv2d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [C2_TILE, C2_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let r0 = idx_mul(bi, idx_const(C2_TILE))
  let c0 = idx_mul(bj, idx_const(C2_TILE))
  let m = and_mask(shape, axis_mask(r0, shape, 0, c2_oh()), axis_mask(c0, shape, 1, c2_ow()))
  let zero = f_const(F64, shape, 0.0)
  let corner = idx_add(idx_mul(bi, idx_const(C2_TILE * C2_W)), c0)
  var acc = zero
  for p in range(0, C2_K) {
    for q in range(0, C2_K) {
      let xt = load_strided_masked(x, idx_add(corner, idx_const(p * C2_W + q)), shape, [C2_W, 1], m, zero)
      let wt = load_strided(w, idx_const(p * C2_K + q), shape, [0, 0])
      acc = addf(F64, shape, acc, mul(F64, shape, xt, wt))
    }
  }
  store_strided_masked(out, idx_add(idx_mul(bi, idx_const(C2_TILE * c2_ow())), c0), shape, [c2_ow(), 1], m, acc)
}

# leetgpu 42 (Max Pooling) over a 36 by 20 image with a 2 by 2 window and a
# stride of 2. The window's stride is the tile's layout: the output tile
# reads the input with strides `[MP_K * width, MP_K]`, so a pooling window
# is addressing and nothing else, and the four elements of one window are
# four loads a constant apart.
const MP_H: Int = 36
const MP_W: Int = 20
const MP_K: Int = 2
const MP_TILE: Int = 16

fn mp_oh() -> Int = MP_H / MP_K

fn mp_ow() -> Int = MP_W / MP_K

fn max_pool(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [MP_TILE, MP_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let r0 = idx_mul(bi, idx_const(MP_TILE))
  let c0 = idx_mul(bj, idx_const(MP_TILE))
  let m = and_mask(shape, axis_mask(r0, shape, 0, mp_oh()), axis_mask(c0, shape, 1, mp_ow()))
  let ninf = f_const(F64, shape, neg_inf())
  let corner = idx_add(idx_mul(bi, idx_const(MP_TILE * MP_K * MP_W)), idx_mul(bj, idx_const(MP_TILE * MP_K)))
  let window = [MP_K * MP_W, MP_K]
  var acc = ninf
  for p in range(0, MP_K) {
    for q in range(0, MP_K) {
      let t = load_strided_masked(x, idx_add(corner, idx_const(p * MP_W + q)), shape, window, m, ninf)
      acc = maxf(F64, shape, acc, t)
    }
  }
  store_strided_masked(out, idx_add(idx_mul(bi, idx_const(MP_TILE * mp_ow())), c0), shape, [mp_ow(), 1], m, acc)
}

# leetgpu 63 (Interleave): `out[2i] = a[i]`, `out[2i + 1] = b[i]`. Two
# stores of the same tile width with a stride of TWO, one at an even base
# and one an element on. The output buffer is longer than the answer, so
# what the mask keeps is compared too.
const IL_N: Int = 500
const IL_TILE: Int = 128

fn interleave(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [IL_TILE]
  let blk = tile_at(block_id(0), IL_TILE)
  let m = tail_mask(blk, shape, IL_N)
  let zero = f_const(F64, shape, 0.0)
  let ta = load_masked(a, blk, shape, m, zero)
  let tb = load_masked(b, blk, shape, m, zero)
  let even = idx_mul(blk, idx_const(2))
  store_strided_masked(out, even, shape, [2], m, ta)
  store_strided_masked(out, idx_add(even, idx_const(1)), shape, [2], m, tb)
}

# leetgpu 66 (RGB to Grayscale) over RG_N interleaved pixels: the three
# channels are three loads of the same tile with a stride of THREE, three
# elements apart. The weighted sum is folded red, then green, then blue,
# which is the order the reference folds it in.
const RG_N: Int = 1000
const RG_TILE: Int = 128
const RG_R: Float = 0.299
const RG_G: Float = 0.587
const RG_B: Float = 0.114

fn rgb_gray(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [RG_TILE]
  let blk = tile_at(block_id(0), RG_TILE)
  let m = tail_mask(blk, shape, RG_N)
  let zero = f_const(F64, shape, 0.0)
  let base = idx_mul(blk, idx_const(3))
  let r = load_strided_masked(x, base, shape, [3], m, zero)
  let g = load_strided_masked(x, idx_add(base, idx_const(1)), shape, [3], m, zero)
  let b = load_strided_masked(x, idx_add(base, idx_const(2)), shape, [3], m, zero)
  let lit = addf(F64, shape,
    addf(F64, shape, mul(F64, shape, r, f_const(F64, shape, RG_R)), mul(F64, shape, g, f_const(F64, shape, RG_G))),
    mul(F64, shape, b, f_const(F64, shape, RG_B)))
  store_masked(out, blk, shape, m, lit)
}

# leetgpu 69 (Jacobi Stencil): one sweep of the five-point stencil over a 34
# by 34 grid. The interior is the average of its four neighbours and the
# BOUNDARY KEEPS ITS VALUE, so there are two masks: `inside` says which
# lanes are in the grid at all (the extent is not a multiple of the tile),
# and `interior` says which have four neighbours. The four neighbour loads
# carry `interior`, so the lane at row 0 never reads the row before it --
# an unmasked load there would be an offset of -34 elements from the buffer.
const JC_H: Int = 34
const JC_W: Int = 34
const JC_TILE: Int = 16

fn jacobi(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [JC_TILE, JC_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let rows = coord(idx_mul(bi, idx_const(JC_TILE)), shape, 0, 1)
  let cols = coord(idx_mul(bj, idx_const(JC_TILE)), shape, 1, 1)
  let inside = and_mask(shape, in_range(shape, rows, 0, JC_H), in_range(shape, cols, 0, JC_W))
  let interior = and_mask(shape, in_range(shape, rows, 1, JC_H - 1), in_range(shape, cols, 1, JC_W - 1))
  let zero = f_const(F64, shape, 0.0)
  let lay = row_major([JC_H, JC_W])
  let base = idx_add(idx_mul(bi, idx_const(JC_TILE * JC_W)), idx_mul(bj, idx_const(JC_TILE)))
  let centre = load_strided_masked(x, base, shape, lay, inside, zero)
  let up = load_strided_masked(x, idx_add(base, idx_const(0 - JC_W)), shape, lay, interior, zero)
  let down = load_strided_masked(x, idx_add(base, idx_const(JC_W)), shape, lay, interior, zero)
  let left = load_strided_masked(x, idx_add(base, idx_const(0 - 1)), shape, lay, interior, zero)
  let right = load_strided_masked(x, idx_add(base, idx_const(1)), shape, lay, interior, zero)
  let s = addf(F64, shape, addf(F64, shape, addf(F64, shape, up, down), left), right)
  let avg = mul(F64, shape, s, f_const(F64, shape, 0.25))
  store_strided_masked(out, base, shape, lay, inside, select(F64, shape, interior, avg, centre))
}

# leetgpu 90 (Depthwise 1D Convolution): DW_C channels of length DW_L, each
# convolved with its OWN DW_K taps. The tile is two-dimensional -- channels
# by positions -- so one block covers four channels at once, and the tap's
# weight is read with strides `[DW_K, 0]`: it walks the channel axis and
# stands still along the position axis, which is the per-row broadcast this
# kernel needs and the reason `axis_strides` exists.
const DW_C: Int = 6
const DW_L: Int = 100
const DW_K: Int = 3
const DW_TC: Int = 4
const DW_TL: Int = 32

fn dw_out() -> Int = DW_L - DW_K + 1

fn depthwise_conv1d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [DW_TC, DW_TL]
  let bc = block_id(0)
  let bl = block_id(1)
  let c0 = idx_mul(bc, idx_const(DW_TC))
  let l0 = idx_mul(bl, idx_const(DW_TL))
  let m = and_mask(shape, axis_mask(c0, shape, 0, DW_C), axis_mask(l0, shape, 1, dw_out()))
  let zero = f_const(F64, shape, 0.0)
  let corner = idx_add(idx_mul(bc, idx_const(DW_TC * DW_L)), l0)
  let wcorner = idx_mul(bc, idx_const(DW_TC * DW_K))
  var acc = zero
  for t in range(0, DW_K) {
    let xt = load_strided_masked(x, idx_add(corner, idx_const(t)), shape, [DW_L, 1], m, zero)
    let wt = load_strided_masked(w, idx_add(wcorner, idx_const(t)), shape, [DW_K, 0], m, zero)
    acc = addf(F64, shape, acc, mul(F64, shape, xt, wt))
  }
  store_strided_masked(out, idx_add(idx_mul(bc, idx_const(DW_TC * dw_out())), l0), shape, [dw_out(), 1], m, acc)
}

# leetgpu 28 (Gaussian Blur): a 3 by 3 kernel over a 20 by 24 image, SAME
# size out, with what falls outside the image treated as zero. Unlike the
# valid-mode convolution above, every tap here has a HALO: the tap `(p, q)`
# reads the neighbour `(r + p - 1, c + q - 1)`, which is outside the image
# for the first and last row and column, so each tap carries its own mask.
# `gb_lo` and `gb_hi` are that mask's bounds, intersected with the image's
# own, and an off-by-one in either is a wrong answer at the boundary that
# every layer below the device accepts (scripts/tile-gpu-diff's
# halo-one-lane-short).
const GB_H: Int = 20
const GB_W: Int = 24
const GB_K: Int = 3
const GB_TILE: Int = 16

fn gb_half() -> Int = GB_K / 2

# The first coordinate along an axis whose tap-`t` neighbour is inside the
# image, and the first one past the last: `[max(0, half - t), min(n, n + half - t))`.
fn gb_lo(t: Int) -> Int = if t < gb_half() { gb_half() - t } else { 0 }

fn gb_hi(n: Int, t: Int) -> Int = if t > gb_half() { n - (t - gb_half()) } else { n }

fn gaussian_blur(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [GB_TILE, GB_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let rows = coord(idx_mul(bi, idx_const(GB_TILE)), shape, 0, 1)
  let cols = coord(idx_mul(bj, idx_const(GB_TILE)), shape, 1, 1)
  let inside = and_mask(shape, in_range(shape, rows, 0, GB_H), in_range(shape, cols, 0, GB_W))
  let zero = f_const(F64, shape, 0.0)
  let lay = row_major([GB_H, GB_W])
  let corner = idx_add(idx_mul(bi, idx_const(GB_TILE * GB_W)), idx_mul(bj, idx_const(GB_TILE)))
  var acc = zero
  for p in range(0, GB_K) {
    for q in range(0, GB_K) {
      let tap = and_mask(shape, in_range(shape, rows, gb_lo(p), gb_hi(GB_H, p)),
        in_range(shape, cols, gb_lo(q), gb_hi(GB_W, q)))
      let shift = (p - gb_half()) * GB_W + (q - gb_half())
      let xt = load_strided_masked(x, idx_add(corner, idx_const(shift)), shape, lay, tap, zero)
      let wt = load_strided(w, idx_const(p * GB_K + q), shape, [0, 0])
      acc = addf(F64, shape, acc, mul(F64, shape, xt, wt))
    }
  }
  store_strided_masked(out, corner, shape, lay, inside, acc)
}

# ---- the integer kernels (knife 10) ----
#
# Every kernel below is EXACT tier, and not because a corpus was chosen for
# it: an i32 result has one value, integer addition modulo 2^32 is exactly
# associative and commutative, so a reduction's unspecified fold tree cannot
# move the answer, and the `List[Float]` channel carries every i32 without
# rounding (53 significand bits over a 32-bit range). This family is the
# control group for the tolerance tiers of knives 7b and 8: on the same
# pipeline there is a set of kernels held to the bit, so "tolerance" is a
# property of the operations and not of what layer 2 can measure.

# The one-block shape the two reductions have: 1000 elements in a 1024-wide
# tile, the last 24 lanes masked off. RED_N / RED_TILE's shape over i32.
const CNT_N: Int = 1000
const CNT_TILE: Int = 1024

# The value `count_eq` counts, and the padding a masked-off lane reads,
# which must not equal it or the tail would be counted.
const CNT_TARGET: Int = 7
const CNT_MISS: Int = 8

# The half-open window `subarray_sum` adds up. Neither bound is a multiple
# of anything: a window that started at 0 or ended at CNT_N would be a
# kernel whose mask does nothing on one side.
const SUB_LO: Int = 137
const SUB_HI: Int = 902

# The eight-block shape the two element-wise integer kernels have: 1000
# elements in 128-wide tiles, so the last block has 24 lanes past the end.
const IOP_N: Int = 1000
const IOP_TILE: Int = 128

# The hash chain's rounds and its three constants. Odd multipliers, so the
# multiply is invertible modulo 2^32 and the chain does not collapse.
const RB_ROUNDS: Int = 3
const RB_K1: Int = 0x9E3779B1
const RB_K2: Int = 0x7F4A7C15
const RB_K3: Int = 0x85EBCA77

# The number of elements of the first buffer equal to CNT_TARGET, at element
# 0 of the second: leetgpu 43 (Count Array Element) and its 2D and 3D shapes
# (44, 45), which are this same count read with more indices.
#
# The comparison mask is widened with `exti`, not turned into 1 and 0 with a
# `select`: `exti` is UNSIGNED here, and a signed widening of a one-bit 1 is
# -1, so the count would come out negated. That is the claim the conversion
# carries and the reason this kernel is the one that makes it.
fn count_eq(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, CNT_TILE)
  let m = tail_mask(blk, [CNT_TILE], CNT_N)
  let miss = i_const([CNT_TILE], CNT_MISS)
  let t = load_masked(x, blk, [CNT_TILE], m, miss)
  let hit = mask_to_int([CNT_TILE], eq_i([CNT_TILE], t, i_const([CNT_TILE], CNT_TARGET)))
  let n = d_reduce_i([CNT_TILE], hit, 0, (acc, e) => s_addi(acc, e))
  store(out, tile_at(i, 1), [1], spread(I32, [1], n))
}

# The wrapping sum of the elements of the first buffer whose index is in
# `[SUB_LO, SUB_HI)`, at element 0 of the second: leetgpu 47 (Subarray Sum).
# The window is a mask over the element index (`lanes` + `in_range`), so a
# lane outside it is neither read nor added.
#
# The sum wraps modulo 2^32, exactly as `addi` does, and the corpus is
# chosen so that it does wrap: a total that stayed inside the range would
# leave `wrap_i32` untested on both sides.
fn subarray_sum(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, CNT_TILE)
  let c = lanes(blk, [CNT_TILE])
  let inside = in_range([CNT_TILE], c, SUB_LO, SUB_HI)
  let zero = i_const([CNT_TILE], 0)
  let t = load_masked(x, blk, [CNT_TILE], inside, zero)
  let s = d_reduce_i([CNT_TILE], t, 0, (acc, e) => s_addi(acc, e))
  store(out, tile_at(i, 1), [1], spread(I32, [1], s))
}

# One round of the hash chain: multiply, xor with a LOGICAL right shift,
# add, xor with an ARITHMETIC one, multiply, xor with a logical one. The two
# kinds of shift are the same opcode under two signedness attributes and
# differ on every negative value, which is what makes this chain the corpus
# scripts/tile-gpu-diff's shri-always-logical mutant reddens; a chain of
# non-negative values would forgive it.
fn rb_round(h: Tile[I32]) -> Tile[I32] !Dev = {
  let s = [IOP_TILE]
  let h1 = mul_i(s, h, i_const(s, RB_K1))
  let h2 = xor_i(s, h1, shr_u(s, h1, i_const(s, 15)))
  let h3 = add_i(s, h2, i_const(s, RB_K2))
  let h4 = xor_i(s, h3, shr_i(s, h3, i_const(s, 13)))
  let h5 = mul_i(s, h4, i_const(s, RB_K3))
  xor_i(s, h5, shr_u(s, h5, i_const(s, 16)))
}

# RB_ROUNDS applications of that round to each seed: leetgpu 24 (Rainbow
# Table), whose chain is one hash applied over and over. The rounds are
# unrolled on the host, as every count fixed at recording time is.
fn rainbow(seeds: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, IOP_TILE)
  let m = tail_mask(blk, [IOP_TILE], IOP_N)
  let zero = i_const([IOP_TILE], 0)
  var h = load_masked(seeds, blk, [IOP_TILE], m, zero)
  for _r in range(0, RB_ROUNDS) {
    h = rb_round(h)
  }
  store_masked(out, blk, [IOP_TILE], m, h)
}

# Every integer operation and every conversion the package can emit, folded
# into one lane: the integer twin of `elemops` and `mathops`. Nothing here
# is a leetgpu problem; it is the kernel that gives each opcode a golden and
# a device.
#
# The divisor is `b | 1`, never zero. Two things the device leaves undefined
# the corpus must avoid, and scripts/tile-gpu-diff's int_diff says so beside
# its data: no lane of `a` may be -2^31, and the shift counts are host
# constants inside [0, 32).
fn int_ops(x: Param[I32], y: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let s = [IOP_TILE]
  let i = block_id(0)
  let blk = tile_at(i, IOP_TILE)
  let m = tail_mask(blk, s, IOP_N)
  let one = i_const(s, 1)
  let a = load_masked(x, blk, s, m, one)
  let b = load_masked(y, blk, s, m, one)
  let odd = or_i(s, b, one)
  let d = sub_i(s, a, b)
  let hi = mulhi_i(s, a, b)
  let q = div_i(s, a, odd)
  let r = rem_i(s, a, odd)
  let mx = max_i(s, a, b)
  let mn = min_i(s, a, b)
  let ng = neg_i(s, a)
  let av = abs_i(s, d)
  let sh = shl_i(s, a, i_const(s, 3))
  let ar = shr_i(s, a, i_const(s, 5))
  let lo = shr_u(s, a, i_const(s, 5))
  # itof, one EXACT halving in f64, then ftoi: `a / 2` truncated toward
  # zero. Halving is exact for every i32, so the only inexact step would be
  # the rounding, and there is none: `ftoi` takes `nearest_int_to_zero` and
  # the reference's `a / 2` truncates toward zero as well. On an odd `a` the
  # two disagree with every other rounding mode, which is what
  # scripts/tile-gpu-diff's ftoi-rounds-instead-of-truncates rests on.
  let hf = float_to_int(F64, s, mul(F64, s, int_to_float(F64, s, a), f_const(F64, s, 0.5)))
  # trunci to i1 and exti back: the low bit of `a`
  let bit = mask_to_int(s, int_to_mask(s, a))
  # bitcast there and back: the value itself, bit for bit
  let bc = bits_to_int(s, bits_to_float(s, a))
  let c0 = add_i(s, d, hi)
  let c1 = xor_i(s, c0, q)
  let c2 = add_i(s, c1, r)
  let c3 = xor_i(s, c2, mx)
  let c4 = add_i(s, c3, mn)
  let c5 = xor_i(s, c4, ng)
  let c6 = add_i(s, c5, av)
  let c7 = xor_i(s, c6, sh)
  let c8 = add_i(s, c7, ar)
  let c9 = xor_i(s, c8, lo)
  let c10 = add_i(s, c9, and_i(s, a, b))
  let c11 = xor_i(s, c10, or_i(s, a, b))
  let c12 = add_i(s, c11, xor_i(s, a, b))
  let c13 = xor_i(s, c12, hf)
  let c14 = add_i(s, c13, bit)
  store_masked(out, blk, s, m, xor_i(s, c14, bc))
}

# ---- the wide kernels (knife 11) ----
#
# What is new here is on the HOST side, not in the tile instructions: a
# kernel may fill more than one buffer, and it may write the buffer it read.
# Neither is visible in the Tile IR -- a store is a store, and the entry
# signature does not say which parameters are outputs -- so the claim lives
# entirely in std/gpu's references, which now say WHICH argument positions
# moved, and in the device, which is what says whether the kernel agrees.
#
# The formats are new as well: `f16` tiles (and the `ftof` that widens them),
# and `i8` tiles under a `u8` buffer. There is no `u8` TILE in the dialect;
# a kernel over an unsigned octet buffer declares `Param[I8]` and widens
# with `exti`, whose UNSIGNED signedness is where the format's reading
# lives.

const WIDE_N: Int = 1000
const WIDE_TILE: Int = 128

# Two outputs from two inputs: `sum` gets a + b and `diff` gets a - b, over
# the same masked lanes. No leetgpu problem is this; it is the kernel that
# gives the multi-output path a golden and a device, the way `int_ops` did
# for the integer opcodes. A device that wrote only its last argument would
# leave `sum` holding the sentinel.
fn sum_diff(a: Param[F64], b: Param[F64], sum: Param[F64], diff: Param[F64]) -> Unit !Dev = {
  let s = [WIDE_TILE]
  let blk = tile_at(block_id(0), WIDE_TILE)
  let m = tail_mask(blk, s, WIDE_N)
  let z = f_const(F64, s, 0.0)
  let ta = load_masked(a, blk, s, m, z)
  let tb = load_masked(b, blk, s, m, z)
  store_masked(sum, blk, s, m, addf(F64, s, ta, tb))
  store_masked(diff, blk, s, m, sub(F64, s, ta, tb))
}

# In-place reversal of a vector: leetgpu 19 (Reverse Array). ONE parameter,
# read and written.
#
# Each block owns a tile of the FIRST HALF and the mirror of that tile in
# the second half: it loads both, then stores each where the other was. The
# mirror is a stride of -1 from `REV_N - 1 - base`, which is the first use
# of a negative stride in this file and needs nothing from the ladder that a
# positive one does not. The grid covers `REV_N / 2` lanes, so every element
# is touched exactly once and no two blocks touch the same one.
#
# REV_N is EVEN. An odd length would leave the middle element to a block
# that does not exist, and the reference says so as well.
const REV_N: Int = 1000
const REV_TILE: Int = 128

fn reverse(x: Param[F64]) -> Unit !Dev = {
  let s = [REV_TILE]
  let blk = tile_at(block_id(0), REV_TILE)
  let m = tail_mask(blk, s, REV_N / 2)
  let z = f_const(F64, s, 0.0)
  let fwd = load_masked(x, blk, s, m, z)
  let back = idx_add(idx_const(REV_N - 1), idx_mul(blk, idx_const(0 - 1)))
  let rev = load_strided_masked(x, back, s, [0 - 1], m, z)
  store_strided_masked(x, back, s, [0 - 1], m, fwd)
  store_masked(x, blk, s, m, rev)
}

# In-place colour inversion of a u8 image: leetgpu 7 (Color Inversion). ONE
# parameter, read and written, and the first kernel over an 8-bit buffer.
#
# The arithmetic is done at i32: `exti` widens each octet UNSIGNED (so a
# byte holding 200 is 200 and not -56), the subtraction happens there, and
# `trunci` puts the low octet back. Doing it in i8 would need an i8 constant
# 255, which is not an i8 value; doing it unsigned at 8 bits would need a
# `u8` tile, which the dialect does not have.
const INV_N: Int = 1000
const INV_TILE: Int = 128

fn invert(img: Param[I8]) -> Unit !Dev = {
  let s = [INV_TILE]
  let blk = tile_at(block_id(0), INV_TILE)
  let m = tail_mask(blk, s, INV_N)
  let t = load_masked(img, blk, s, m, i8_const(s, 0))
  store_masked(img, blk, s, m, trunc_u8(s, sub_i(s, i_const(s, 255), ext_u8(s, t))))
}

# `((a + b) * a) - b` over f16 tiles: the f16 twin of `elemops` and
# `int_ops`, and no leetgpu problem. Three operations the double-rounding
# theorem covers, each landing its result in an f16 tile, so every one of
# them is `narrow.round_fp16` of the exact answer and the whole kernel is
# bit-exact against a host reference that rounds after each step.
const F16E_N: Int = 1000
const F16E_TILE: Int = 128

fn f16_ops(a: Param[F16], b: Param[F16], out: Param[F16]) -> Unit !Dev = {
  let s = [F16E_TILE]
  let blk = tile_at(block_id(0), F16E_TILE)
  let m = tail_mask(blk, s, F16E_N)
  let z = f_const(F16, s, 0.0)
  let ta = load_masked(a, blk, s, m, z)
  let tb = load_masked(b, blk, s, m, z)
  store_masked(out, blk, s, m, sub(F16, s, mul(F16, s, addf(F16, s, ta, tb), ta), tb))
}

# The dot product of two f16 vectors into an f64 answer: leetgpu 58 (FP16
# Dot Product), and the one client of `ftof`.
#
# The operands are f16 and the arithmetic is not: each tile is widened with
# `ftof` (exact in this direction, f16 to f64) and the product and the
# reduction happen at f64. That is what the problem asks for -- a dot
# product of half-precision inputs accumulated at full precision -- and it
# is also what makes a bit-exact comparison possible at all, since an f16
# accumulator over a thousand lanes would lose more than any tolerance
# worth writing down.
const DF16_N: Int = 1000
const DF16_TILE: Int = 1024

fn dot_f16(a: Param[F16], b: Param[F16], out: Param[F64]) -> Unit !Dev = {
  let s = [DF16_TILE]
  let i = block_id(0)
  let blk = tile_at(i, DF16_TILE)
  let m = tail_mask(blk, s, DF16_N)
  let z = f_const(F16, s, 0.0)
  let ta = float_to_float(F16, F64, s, load_masked(a, blk, s, m, z))
  let tb = float_to_float(F16, F64, s, load_masked(b, blk, s, m, z))
  let prod = mul(F64, s, ta, tb)
  store(out, tile_at(i, 1), [1],
    spread(F64, [1], d_reduce(F64, s, prod, 0.0, (acc, e) => s_addf(F64, acc, e))))
}

# The f16 GEMM: leetgpu 22. Knife 8's `matmul` at f16, with an f16
# accumulator (the dialect allows f16 operands with an f16 or an f32
# result; this surface's `mmaf` takes one format for all three).
#
# `--remarks=tensorcore` says this one DOES reach a tensor core on sm_86
# (`Tensor-core SM80, Shape = [16, 8, 16]`), which knife 8 found only bf16
# did among the formats it tried.
const MMF_M: Int = 64
const MMF_N: Int = 64
const MMF_K: Int = 64
const MMF_T: Int = 32

fn matmul_f16(a: Param[F16], b: Param[F16], c: Param[F16]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let a_row = idx_mul(bm, idx_const(MMF_T * MMF_K))
  let b_col = idx_mul(bn, idx_const(MMF_T))
  let zero = f_const(F16, [MMF_T, MMF_T], 0.0)
  let acc = d_for(idx_const(0), idx_const(MMF_K / MMF_T), idx_const(1), zero, (k, sofar) => {
    let ta = load_strided(a, idx_add(a_row, idx_mul(k, idx_const(MMF_T))), [MMF_T, MMF_T], [MMF_K, 1])
    let tb = load_strided(b, idx_add(b_col, idx_mul(k, idx_const(MMF_T * MMF_N))), [MMF_T, MMF_T], [MMF_N, 1])
    mmaf(F16, MMF_T, MMF_T, MMF_T, ta, tb, sofar)
  })
  store_strided(c, idx_add(idx_mul(bm, idx_const(MMF_T * MMF_N)), b_col), [MMF_T, MMF_T], [MMF_N, 1], acc)
}

# The batched f16 GEMM: leetgpu 57. `batched_matmul` at f16, the batch on
# the grid's third axis.
const BMF_B: Int = 2
const BMF_M: Int = 32
const BMF_N: Int = 32
const BMF_K: Int = 32
const BMF_T: Int = 16

fn batched_matmul_f16(a: Param[F16], b: Param[F16], c: Param[F16]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let bb = block_id(2)
  let a_row = idx_add(idx_mul(bb, idx_const(BMF_M * BMF_K)), idx_mul(bm, idx_const(BMF_T * BMF_K)))
  let b_col = idx_add(idx_mul(bb, idx_const(BMF_K * BMF_N)), idx_mul(bn, idx_const(BMF_T)))
  let zero = f_const(F16, [BMF_T, BMF_T], 0.0)
  let acc = d_for(idx_const(0), idx_const(BMF_K / BMF_T), idx_const(1), zero, (k, sofar) => {
    let ta = load_strided(a, idx_add(a_row, idx_mul(k, idx_const(BMF_T))), [BMF_T, BMF_T], [BMF_K, 1])
    let tb = load_strided(b, idx_add(b_col, idx_mul(k, idx_const(BMF_T * BMF_N))), [BMF_T, BMF_T], [BMF_N, 1])
    mmaf(F16, BMF_T, BMF_T, BMF_T, ta, tb, sofar)
  })
  let c_base = idx_add(idx_add(idx_mul(bb, idx_const(BMF_M * BMF_N)), idx_mul(bm, idx_const(BMF_T * BMF_N))),
    idx_mul(bn, idx_const(BMF_T)))
  store_strided(c, c_base, [BMF_T, BMF_T], [BMF_N, 1], acc)
}

# The int8 GEMM: leetgpu 32 (INT8 Quantized MatMul). `mmai`, whose operands
# are i8 tiles and whose accumulator and result are i32 ones, so the three
# buffers are two i8 and one i32.
#
# Bit-exact by ALGEBRA, not by corpus: every partial product of two i8
# values fits in fifteen bits and the accumulator is i32, so the sum over
# `k` is one integer whatever order the device folds it in. That is the
# same argument knife 10's integer family rests on, and it is why an
# `mmai` kernel is exact tier where an `mmaf` one cannot be.
const MMI_M: Int = 64
const MMI_N: Int = 64
const MMI_K: Int = 64
const MMI_T: Int = 32

fn matmul_i8(a: Param[I8], b: Param[I8], c: Param[I32]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let a_row = idx_mul(bm, idx_const(MMI_T * MMI_K))
  let b_col = idx_mul(bn, idx_const(MMI_T))
  let zero = i_const([MMI_T, MMI_T], 0)
  let acc = d_for(idx_const(0), idx_const(MMI_K / MMI_T), idx_const(1), zero, (k, sofar) => {
    let ta = load_strided(a, idx_add(a_row, idx_mul(k, idx_const(MMI_T))), [MMI_T, MMI_T], [MMI_K, 1])
    let tb = load_strided(b, idx_add(b_col, idx_mul(k, idx_const(MMI_T * MMI_N))), [MMI_T, MMI_T], [MMI_N, 1])
    mmai(MMI_T, MMI_T, MMI_T, ta, tb, sofar)
  })
  store_strided(c, idx_add(idx_mul(bm, idx_const(MMI_T * MMI_N)), b_col), [MMI_T, MMI_T], [MMI_N, 1], acc)
}

# ---- the gather and scatter kernels (knife 12) ----
#
# The four kernels below address memory with a TILE OF INDICES rather than
# with a base and a stride ladder. Nothing new reaches the device: `offset`,
# the instruction every load already goes through, takes any `tile<Nxi32>`
# as its offset operand, so `gather` hands it a tile somebody computed
# instead of the ladder `load_strided` builds. What is new is that the
# numbers may come from memory, which is what "data dependent" means.
#
# Two rules the corpora carry, and this is where they are stated:
#
#   * an index OUTSIDE the array is legal wherever a mask blocks its lane,
#     and illegal everywhere else. `token_embed` and `scatter_perm` both
#     carry such indices, and both clamp the address arithmetic as well
#     (`and_i` against a power-of-two extent), so a blocked lane still
#     forms an address inside the buffer. The mask decides the VALUE; the
#     clamp decides the ADDRESS. That separation is what lets
#     scripts/tile-gpu-diff's gather-mask-dropped mutant answer a WRONG
#     number rather than fault, which is the only way layer 2 can see it.
#   * a scatter whose lanes name one element twice has no answer at all.
#     Every scatter here writes a permutation and the corpora keep it one:
#     `sort_rank`'s ranks are distinct because ties are broken by lane,
#     `merge_rank`'s are the merge-path ranks (distinct by the same
#     argument), and `scatter_perm`'s corpus is a permutation with some
#     lanes taken out of range, never two lanes put on one destination.
#
# Duplicate GATHER indices are ordinary: `token_embed`'s corpus repeats
# token ids on purpose.

# The embedding table: EMB_ROWS rows of EMB_DIM, TOK_TILE tokens a block.
# EMB_ROWS is a power of two so the address clamp is one `andi`. TOK_N is
# the token count the grid was sized for and the KERNEL never reads it: 100
# tokens is 13 blocks of 8, so the last block covers four lanes past the
# last token, and the corpus fills those with ids outside the table (it
# carries out-of-range ids inside the hundred as well).
const EMB_ROWS: Int = 64
const EMB_DIM: Int = 16
const TOK_TILE: Int = 8
const TOK_N: Int = 100

# What a token id outside [0, EMB_ROWS) reads: a value no row of the table
# holds, so a lane that read the table instead of this is visible.
const EMB_MISS: Float = 0.0 - 777.0

# Row `i` of the output is row `ids[i]` of the table, and the MISS row
# where that id is outside the table: leetgpu 106 (Token Embedding).
#
# The id tile is a load with a stride of zero along the embedding
# dimension (knife 9's `axis_strides`), so one id serves a whole row; the
# gather's index is that id scaled by the row length plus the column
# coordinate. The store is NOT masked: an out-of-range id is a defined
# answer here (the MISS row), not a lane to leave alone, which is what
# gives the gather's mask something the output can show.
fn token_embed(ids: Param[I32], table: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [TOK_TILE, EMB_DIM]
  let b = block_id(0)
  let blk = tile_at(b, TOK_TILE)
  let id = load_strided(ids, blk, s, axis_strides(2, 0, 1))
  let ok = in_range(s, id, 0, EMB_ROWS)
  let row = and_i(s, id, i_const(s, EMB_ROWS - 1))
  let off = add_i(s, mul_i(s, row, i_const(s, EMB_DIM)), coord(idx_const(0), s, 1, 1))
  store(out, tile_at(b, TOK_TILE * EMB_DIM), s,
    gather_masked(table, off, s, ok, f_const(F64, s, EMB_MISS)))
}

# The rank sort's shape: one block, SORT_N values, a SORT_N by SORT_N
# comparison tile. O(n^2) comparisons is the sort a tile machine with no
# shuffle can write in one launch, and it is exact: nothing is added but
# ones and zeroes.
const SORT_N: Int = 32

# The SORT_N values of the first buffer, sorted, in the second: leetgpu 15
# (Sorting).
#
# The rank of x[i] is the number of j whose value comes BEFORE it, where
# "before" is `x[j] < x[i]`, or `x[j] == x[i]` and `j < i`. That tie-break
# is not decoration: it is what makes the ranks a permutation, and a
# scatter whose lanes collided would have no answer. The corpus repeats
# values on purpose so that the tie-break is exercised.
#
# The count is folded in f64 over ones and zeroes, so the fold order the
# dialect leaves unspecified cannot show: every partial sum is an integer
# below 32 and exact in binary64.
fn sort_rank(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s2 = [SORT_N, SORT_N]
  let s1 = [SORT_N]
  let zero = idx_const(0)
  let row = load_strided(x, zero, s2, [1, 0])
  let col = load_strided(x, zero, s2, [0, 1])
  let tie = and_mask(s2, eq(F64, s2, col, row),
    lt_i(s2, coord(zero, s2, 1, 1), coord(zero, s2, 0, 1)))
  let before = or_mask(s2, lt(F64, s2, col, row), tie)
  let hit = select(F64, s2, before, f_const(F64, s2, 1.0), f_const(F64, s2, 0.0))
  let rank = d_reduce_dim(F64, s2, 1, hit, 0.0, (acc, e) => s_addf(F64, acc, e))
  scatter(out, float_to_int(F64, s1, rank), s1, load(x, zero, s1))
}

# The merge's shape: two sorted runs of MG_N in one block.
const MG_N: Int = 32

# The two sorted buffers merged into the third: leetgpu 71 (Parallel
# Merge). The merge-path rank of a[i] is `i` plus the number of b below
# it, and of b[j] is `j` plus the number of a at or below it. The strict
# comparison on one side and the loose one on the other is what makes the
# two rank sets disjoint when the buffers share a value, so the two
# scatters never write one element twice; the corpus puts values in both
# buffers on purpose.
fn merge_rank(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s2 = [MG_N, MG_N]
  let s1 = [MG_N]
  let zero = idx_const(0)
  let one = f_const(F64, s2, 1.0)
  let nought = f_const(F64, s2, 0.0)
  let arow = load_strided(a, zero, s2, [1, 0])
  let bcol = load_strided(b, zero, s2, [0, 1])
  let below = select(F64, s2, lt(F64, s2, bcol, arow), one, nought)
  let atmost = select(F64, s2, le(F64, s2, arow, bcol), one, nought)
  let ca = d_reduce_dim(F64, s2, 1, below, 0.0, (acc, e) => s_addf(F64, acc, e))
  let cb = d_reduce_dim(F64, s2, 0, atmost, 0.0, (acc, e) => s_addf(F64, acc, e))
  let lane = lanes(zero, s1)
  scatter(out, add_i(s1, lane, float_to_int(F64, s1, ca)), s1, load(a, zero, s1))
  scatter(out, add_i(s1, lane, float_to_int(F64, s1, cb)), s1, load(b, zero, s1))
}

# The permutation scatter's shape: SC_N destinations, SC_TILE lanes a
# block. SC_N is a power of two so the address clamp is one `andi`.
const SC_N: Int = 256
const SC_TILE: Int = 128

# `out[perm[i]] = x[i]`, and nothing at all where `perm[i]` is outside the
# output: the scatter twin of `int_ops`, a kernel with no leetgpu problem
# behind it whose only job is to give the masked scatter a golden and a
# device. `reverse` (knife 11) writes a permutation too, but with a
# STRIDE; this one reads its permutation out of a buffer.
fn scatter_perm(perm: Param[I32], x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [SC_TILE]
  let b = block_id(0)
  let blk = tile_at(b, SC_TILE)
  let p = load(perm, blk, s)
  let ok = in_range(s, p, 0, SC_N)
  let dst = and_i(s, p, i_const(s, SC_N - 1))
  scatter_masked(out, dst, s, ok, load(x, blk, s))
}

# ---- the scan kernels (knife 13) ----
#
# `scan` is `reduce` with the intermediate results kept: position `j` of the
# answer is the fold of everything at or before `j` along the scanned
# dimension, and the answer has the operand's shape rather than the
# operand's shape with that dimension dropped. One new opcode (0x5E), one
# attribute more than `reduce` (`reverse`), the same region encoding.
#
# Three facts about it were MEASURED on the device rather than read, and
# every kernel below rests on them (packages/tileir/src/dev.dawn says where):
#
#   * the region's FIRST argument is the accumulator and the second the
#     element, in both directions. `reduce`'s bodies are all commutative and
#     could never say which; a scan's need not be, and three of the six
#     kernels here are wrong under the other reading.
#   * the IDENTITY is not folded in at the first position: the prefix of one
#     element is that element. So `linrec`'s first output is `x[0]` whatever
#     `a[0]` is, which is what leetgpu 82 asks for, and no kernel here may
#     lean on an identity to fix up its first lane.
#   * a MULTI-OPERAND scan runs, though the dialect's prose says `scan` "is
#     restricted to only support single tile input". Its verifier does not
#     say so and neither does tileiras. Three kernels here need it: a
#     first-order linear recurrence composes affine maps, and an affine map
#     is two numbers.
#
# The float scans are TOLERANCE tier and cannot be anything else: the
# evaluation order inside a prefix is implementation-defined, and the
# device's is measurably not the sequential left fold a host reference
# writes. The integer scans are exact tier by the same algebra the integer
# reductions use (knife 10): addition modulo 2^32 is associative, so every
# regrouping of one prefix is one value.

# The scan family's shape: one block, a 128-wide tile, 100 live lanes. One
# block because a prefix sum crosses every lane of its dimension, which is
# the same reason every reduction in this backend covers its problem in one
# launch.
const SCAN_TILE: Int = 128
const SCAN_N: Int = 100

# The inclusive prefix sum of the first SCAN_N lanes: leetgpu 16 (Prefix
# Sum). Masked at both ends of the operation, so the lanes past the end are
# neither read nor written and the padding zero they fold in is the sum's
# identity.
fn prefix_sum(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [SCAN_TILE]
  let z = idx_const(0)
  let m = tail_mask(z, s, SCAN_N)
  let t = load_masked(x, z, s, m, f_const(F64, s, 0.0))
  store_masked(out, z, s, m, d_scan(F64, s, 0, false, t, 0.0, (acc, e) => s_addf(F64, acc, e)))
}

# The sliding window's shape: MSA_W consecutive of MSA_N values, in one
# block of MSA_TILE lanes. MSA_W + MSA_N is below MSA_TILE, which is what
# lets the shifted run live in the same tile.
const MSA_TILE: Int = 128
const MSA_N: Int = 100
const MSA_W: Int = 7

# Nothing is a smaller window sum than this, and it is not INT_MIN: the
# reduction below never adds it, but a value at the edge of the range is a
# hazard nobody needs.
const MSA_FLOOR: Int = 0 - 2000000000

# The largest sum of MSA_W consecutive of the first MSA_N elements, at
# element 0 of the output: leetgpu 51 (Max Subarray Sum).
#
# The window sum ending at lane `j` is `P[j] - P[j - MSA_W]`, where `P` is
# the inclusive prefix sum. A tile cannot be shifted along itself -- there
# is no lane-to-lane move in this dialect and a tile is not in memory -- so
# the shifted prefix is a SECOND scan of the same buffer read MSA_W lanes
# late: `Q[j] = sum of x[0 .. j - MSA_W]`, which is `P[j - MSA_W]` for
# `j >= MSA_W` and 0 at `j = MSA_W - 1`, where the first window's left
# neighbour is nothing at all.
#
# Integer throughout, so this is exact tier whatever the device's fold tree
# is, and the subtraction of two prefix sums is exact for the same reason.
fn max_subarray(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let s = [MSA_TILE]
  let z = idx_const(0)
  let zero = i_const(s, 0)
  let lane = lanes(z, s)
  let live = tail_mask(z, s, MSA_N)
  let t = load_masked(x, z, s, live, zero)
  let p = d_scan_i(s, 0, false, t, 0, (acc, e) => s_addi(acc, e))
  # the same run read MSA_W lanes late; the address is clamped as well as
  # masked, so a blocked lane still names an element of the buffer
  let late = in_range(s, lane, MSA_W, MSA_W + MSA_N)
  let back = max_i(s, sub_i(s, lane, i_const(s, MSA_W)), zero)
  let q = d_scan_i(s, 0, false, gather_masked(x, back, s, late, zero), 0, (acc, e) => s_addi(acc, e))
  let ends = in_range(s, lane, MSA_W - 1, MSA_N)
  let win = select(I32, s, ends, sub_i(s, p, q), i_const(s, MSA_FLOOR))
  store(out, tile_at(z, 1), [1],
    spread(I32, [1], d_reduce_i(s, win, MSA_FLOOR, (acc, e) => s_maxi(acc, e))))
}

# The exclusive prefix sum of each segment of the first SCAN_N lanes, where
# a segment starts at every lane whose flag is 1: leetgpu 70 (Segmented
# Exclusive Prefix Sum).
#
# Two scans and a subtraction, which is leetgpu's own reference written in
# tiles: the segment's exclusive sum at `j` is the GLOBAL exclusive sum at
# `j` minus the global exclusive sum at the segment's first lane. The
# global exclusive sum is the inclusive scan less the lane's own value; the
# segment start's is a scan whose body is "the last element that carried a
# flag, and otherwise what came before", which is associative and NOT
# commutative -- the first body in this tree that would answer differently
# under the other reading of the region's arguments.
#
# That body needs the flag and the value of one lane together, so it is a
# two-operand scan. The corpus must set the flag of lane 0: with no
# segment open at all there is nothing to subtract, and leetgpu's own tests
# always open one there.
fn seg_scan(values: Param[F64], flags: Param[I32], out: Param[F64]) -> Unit !Dev = {
  let s = [SCAN_TILE]
  let z = idx_const(0)
  let m = tail_mask(z, s, SCAN_N)
  let v = load_masked(values, z, s, m, f_const(F64, s, 0.0))
  let f = int_to_float(F64, s, load_masked(flags, z, s, m, i_const(s, 0)))
  let incl = d_scan(F64, s, 0, false, v, 0.0, (acc, e) => s_addf(F64, acc, e))
  let excl = sub(F64, s, incl, v)
  let (_open, carry) = d_scan2(F64, s, 0, false, f, excl, 0.0, 0.0, (af, av, ef, ev) => {
    let start = s_gt(F64, ef, s_const(F64, 0.5))
    (s_select(F64, start, ef, af), s_select(F64, start, ev, av))
  })
  store_masked(out, z, s, m, sub(F64, s, excl, carry))
}

# The positive values of the first SCAN_N lanes, packed to the front of the
# output and nothing written after them: leetgpu 72 (Stream Compaction).
#
# The destination of a kept lane is the number of kept lanes before it,
# which is the EXCLUSIVE prefix count: an inclusive integer scan of the
# predicate less the lane's own bit. Exclusive is spelled that way and not
# with the identity, because the identity is not folded in.
#
# Exact tier: the values are moved and never arithmetic, and the counts are
# integers. The destinations are distinct by construction (a strictly
# increasing count over the kept lanes), which is what a scatter requires;
# the lanes that are not kept are masked and write nothing.
fn compact(a: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [SCAN_TILE]
  let z = idx_const(0)
  let live = tail_mask(z, s, SCAN_N)
  let t = load_masked(a, z, s, live, f_const(F64, s, 0.0))
  let keep = and_mask(s, live, gt(F64, s, t, f_const(F64, s, 0.0)))
  let ones = select(I32, s, keep, i_const(s, 1), i_const(s, 0))
  let incl = d_scan_i(s, 0, false, ones, 0, (acc, e) => s_addi(acc, e))
  scatter_masked(out, sub_i(s, incl, ones), s, keep, t)
}

# The recurrence family's shape: LR_B rows of LR_L, one block a row.
const LR_B: Int = 4
const LR_L: Int = 64

# `h[t] = a[t] * h[t-1] + x[t]`, with `h[0] = x[0]`: leetgpu 82 (Linear
# Recurrence).
#
# The scan folds AFFINE MAPS. Element `t` is the map `u -> a[t] * u + x[t]`,
# written as the pair `(a[t], x[t])`, and composing the accumulated map
# `(A, X)` with it gives `(a[t] * A, a[t] * X + x[t])` -- associative,
# because function composition is, and not commutative, because
# composition is not. The second half of the answer at `t` is `h[t]`,
# because the accumulated map applied to the initial state 0 is its own
# addend.
#
# `h[0] = x[0]` falls out of the identity not being folded in: the prefix
# of one element is that element, so lane 0 is `(a[0], x[0])` and `a[0]` is
# never used. That is exactly what leetgpu's reference does.
fn linrec(a: Param[F64], x: Param[F64], h: Param[F64]) -> Unit !Dev = {
  let s = [LR_L]
  let b = block_id(0)
  let blk = tile_at(b, LR_L)
  let (_c, hh) = d_scan2(F64, s, 0, false, load(a, blk, s), load(x, blk, s), 1.0, 0.0,
    (ac, av, ec, ev) => (s_mulf(F64, ec, ac), s_fma(F64, ec, av, ev)))
  store(h, blk, s, hh)
}

# The advantage estimator's shape: GAE_B rows of GAE_S. GAE_B * GAE_S is a
# power of two so the shifted read's address clamp is one `andi`.
const GAE_B: Int = 4
const GAE_S: Int = 64

# The discount and the trace decay, host constants folded in at recording
# time, as every scalar parameter of a leetgpu problem is.
fn gae_gamma() -> Float = 0.99
fn gae_lam() -> Float = 0.95

# The generalised advantage estimate, a REVERSE scan: leetgpu 110 (Parallel
# Reverse Scan).
#
# `A[t] = delta[t] + gamma * lam * A[t+1]`, which is `linrec`'s affine
# composition with a constant coefficient, run from the end. `reverse` is
# what makes it one launch instead of a loop, and it is the only kernel in
# this tree that sets the attribute -- so scripts/tile-gpu-diff's
# scan-reverse-ignored mutant reds here and nowhere else.
#
# `delta[t] = rewards[t] + gamma * values[t+1] - values[t]`, with
# `values[t+1]` past the end of the row taken as zero. The shifted read is
# a gather one lane late: masked at the row's last lane and clamped into
# the buffer, so the blocked lane still names an element.
fn gae(rewards: Param[F64], values: Param[F64], adv: Param[F64]) -> Unit !Dev = {
  let s = [GAE_S]
  let b = block_id(0)
  let blk = tile_at(b, GAE_S)
  let nxt = and_i(s, add_i(s, lanes(blk, s), i_const(s, 1)), i_const(s, GAE_B * GAE_S - 1))
  let ok = in_range(s, lanes(idx_const(0), s), 0, GAE_S - 1)
  let nv = gather_masked(values, nxt, s, ok, f_const(F64, s, 0.0))
  let v = load(values, blk, s)
  let delta = sub(F64, s, addf(F64, s, load(rewards, blk, s),
    mul(F64, s, f_const(F64, s, gae_gamma()), nv)), v)
  let dec = f_const(F64, s, gae_gamma() * gae_lam())
  let (_c, ad) = d_scan2(F64, s, 0, true, dec, delta, 1.0, 0.0,
    (ac, av, ec, ev) => (s_mulf(F64, ec, ac), s_fma(F64, ec, av, ev)))
  store(adv, blk, s, ad)
}

# The selective scan's shape: SSM_BATCH sequences of SSM_T steps, SSM_D
# channels, SSM_N hidden states a channel. One block per (sequence,
# channel), so the grid has two axes and the tile is the whole (step,
# state) plane of that channel.
const SSM_BATCH: Int = 2
const SSM_T: Int = 32
const SSM_D: Int = 8
const SSM_N: Int = 16

# The Mamba-style selective scan: leetgpu 94 (SSM Selective Scan).
#
# `h[t, n] = exp(delta[t] * A[n]) * h[t-1, n] + delta[t] * B[t, n] * u[t]`
# for each channel, and `y[t] = sum_n C[t, n] * h[t, n] + skip * u[t]`.
# The recurrence is `linrec`'s affine composition run over a RANK-2 tile:
# one scan along the step axis carries SSM_N independent states at once,
# which is what "the operands are tiles" buys over "the operands are
# numbers". The output is then a reduction along the state axis, so this
# kernel is a scan and a reduce over the same plane.
#
# Every operand is a strided read of the same plane: `delta` and `u` are
# constant along the state axis (stride 0), `A` is constant along the step
# axis, and `B` and `C` are dense in both. Nothing is masked: every extent
# divides its tile.
fn ssm_scan(u: Param[F64], delta: Param[F64], amat: Param[F64], bmat: Param[F64],
  cmat: Param[F64], skip: Param[F64], y: Param[F64]) -> Unit !Dev = {
  let s2 = [SSM_T, SSM_N]
  let s1 = [SSM_T]
  let b = block_id(0)
  let d = block_id(1)
  # the (sequence, channel) row of a (batch, step, channel) buffer, the
  # (sequence) plane of a (batch, step, state) one, and row `d` of A
  let ud = idx_add(idx_mul(b, idx_const(SSM_T * SSM_D)), d)
  let bc = idx_mul(b, idx_const(SSM_T * SSM_N))
  let ad = idx_mul(d, idx_const(SSM_N))
  let dt = load_strided(delta, ud, s2, [SSM_D, 0])
  let uu = load_strided(u, ud, s2, [SSM_D, 0])
  let abar = exp(F64, s2, mul(F64, s2, dt, load_strided(amat, ad, s2, [0, 1])))
  let bbar = mul(F64, s2, mul(F64, s2, dt, load_strided(bmat, bc, s2, [SSM_N, 1])), uu)
  let (_c, h) = d_scan2(F64, s2, 0, false, abar, bbar, 1.0, 0.0,
    (ac, av, ec, ev) => (s_mulf(F64, ec, ac), s_fma(F64, ec, av, ev)))
  let cy = mul(F64, s2, load_strided(cmat, bc, s2, [SSM_N, 1]), h)
  let yt = d_reduce_dim(F64, s2, 1, cy, 0.0, (acc, e) => s_addf(F64, acc, e))
  let side = mul(F64, s1, load_strided(skip, d, s1, [0]), load_strided(u, ud, s1, [SSM_D]))
  store_strided(y, ud, s1, [SSM_D], addf(F64, s1, yt, side))
}

# ---- the atomic kernels (knife 14) ----
#
# An atomic is what a scatter is not: two lanes may name ONE element, and
# the update still happens once per lane. That is the whole of the
# difference, and it is why 13 Histogramming is the only leetgpu problem
# in this backend's range that needs one. Everything else that looks like
# it needs an atomic (72 Stream Compaction, 36 Radix Sort, 46 BFS) has an
# ordered spelling through `scan` and `scatter`, and an ordered spelling is
# the one a bit-exact reference can be written against.
#
# What the corpora have to carry, and this is where it is stated:
#
#   * the histogram's corpus must have grid > 1 AND lanes in different
#     blocks landing on ONE bin. With one block, or with one lane a bin,
#     an atomic add and a plain load-add-store answer the same thing, and
#     scripts/tile-gpu-diff's atomic-as-plain-store mutant would be green.
#     The layer-2 harness counts the collisions and holds them above zero,
#     and runs the same kernel a second time on a corpus with NO collisions
#     to show that the corpus is what makes the mutant bite.
#   * the mode must be one whose answer does not depend on the order the
#     lanes arrive in. Integer `add` is; `xchg` is not. This is the same
#     argument knife 10 made for the integer reductions: addition modulo
#     2^32 is exactly associative and commutative, so the histogram is
#     EXACT tier and not a tolerance claim.
#   * a bin index outside the histogram is masked, and its address is
#     clamped as well, for knife 12's reason: a mutant that drops the mask
#     must answer a wrong NUMBER rather than fault, or layer 2 records
#     `blocked` and `blocked` is not a difference.

# The histogram's shape: HIST_BINS bins (a power of two, so the address
# clamp is one `andi`), HIST_TILE lanes a block, HIST_N values. 500 is not
# a multiple of 64, so the last of the eight blocks runs 12 lanes past the
# end of the input and the tail mask is doing real work.
const HIST_BINS: Int = 16
const HIST_TILE: Int = 64
const HIST_N: Int = 500

# How many of the first HIST_N values fall in each bin: leetgpu 13
# (Histogramming). The histogram buffer must arrive ZEROED, which is what
# the problem's own reference does before it counts.
#
# Values outside [0, HIST_BINS) are not counted, as leetgpu's reference
# says (it counts under a validity mask), and the corpus carries some.
fn histogram(input: Param[I32], hist: Param[I32]) -> Unit !Dev = {
  let s = [HIST_TILE]
  let b = block_id(0)
  let blk = tile_at(b, HIST_TILE)
  let live = tail_mask(blk, s, HIST_N)
  let x = load_masked(input, blk, s, live, i_const(s, 0 - 1))
  let ok = and_mask(s, live, in_range(s, x, 0, HIST_BINS))
  let bin = and_i(s, x, i_const(s, HIST_BINS - 1))
  atomic_add_masked(hist, bin, s, ok, i_const(s, 1))
}

# The compare-and-swap's shape: CAS_SLOTS slots, CAS_TILE lanes a block,
# so the four blocks cover every slot exactly once.
const CAS_SLOTS: Int = 128
const CAS_TILE: Int = 32

# Every slot whose contents equal the lane's expected value takes the
# lane's new value; the rest are left alone; and what each slot held
# before goes into the fourth buffer. A coverage kernel with no leetgpu
# problem behind it, the way `int_ops` and `scatter_perm` are: nothing in
# the range of this backend needs a compare-and-swap, and the operation
# still has to be exercised.
#
# One lane a slot, so the answer does not depend on the order the lanes
# arrive in and the tier is exact. A lane whose expected value is negative
# does not take part at all: that is the mask, and the slot and the
# fourth buffer both keep what they had.
fn cas_swap(state: Param[I32], cmp: Param[I32], val: Param[I32], old: Param[I32]) -> Unit !Dev = {
  let s = [CAS_TILE]
  let b = block_id(0)
  let blk = tile_at(b, CAS_TILE)
  let c = load(cmp, blk, s)
  let v = load(val, blk, s)
  let active = ge_i(s, c, i_const(s, 0))
  let prev = atomic_cas_masked(state, lanes(blk, s), s, active, c, v)
  store_masked(old, blk, s, active, prev)
}

# ---- the error function kernels (knife 15) ----
#
# Tile IR has no `erf`. Its hundred operations carry `exp`, `log`, `tanh`,
# `pow` and the roots, and stop there; `ct` has no erf either. leetgpu 65
# is stated in terms of `torch.erf`, so what answers it is a COMPOSITION,
# `tileir/dev.erf`, which is Abramowitz-Stegun 7.1.26 over the arithmetic
# that is already in the dialect. Zero new opcodes: this knife adds no
# bytecode, only two kernels and a function in the package.
#
# What the corpora have to carry, and this is where it is stated:
#
#   * lanes with `|x| > 4`. 7.1.26 is a rational function of
#     `t = 1 / (1 + p|x|)` times `exp(-x^2)`, and both factors are near
#     their limits out there: `t` goes to 0 and `exp(-x^2)` underflows.
#     A corpus that stopped at `|x| = 2` would never look at the tail.
#   * lanes with `x < 0`. 7.1.26 holds for `x >= 0` and nothing else; the
#     negative half is the odd symmetry, a `select` on the sign, and it is
#     the one branch in the composition. scripts/tile-gpu-diff runs an
#     all-non-negative CONTROL corpus beside the real one, so that the
#     mutant that drops the flip can be shown to be caught by the negative
#     lanes and not by anything else.
#   * lanes near zero, where the approximation's absolute error is largest
#     relative to the answer (7.1.26 is worst around |x| = 1.4 in absolute
#     terms and the tier is absolute, so this is coverage rather than a
#     hazard).
#
# Both kernels are TOLERANCE tier and cannot be anything else: 7.1.26's
# error is 1.5e-7 by construction, and its host reference is an accurate
# series rather than the same rational.

# The sweep's shape: ERF_N values over ERF_TILE lanes a block. 500 is not a
# multiple of 128, so the last of the four blocks runs 12 lanes past the end
# and the tail mask is doing real work.
const ERF_N: Int = 500
const ERF_TILE: Int = 128

# `erf(x)`, lane by lane: a coverage kernel with no leetgpu problem behind
# it, the way `int_ops`, `scatter_perm` and `cas_swap` have none. 65 uses
# the error function inside a product, where a large multiplier could hide
# where the error is; here it is on its own, so what layer 2 measures is
# 7.1.26's error and nothing else.
fn erf_sweep(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [ERF_TILE]
  let blk = tile_at(block_id(0), ERF_TILE)
  let m = tail_mask(blk, s, ERF_N)
  let t = load_masked(x, blk, s, m, f_const(F64, s, 0.0))
  store_masked(out, blk, s, m, erf(F64, s, t))
}

# The gate's shape: the input is one buffer of 2 * GEGLU_HALF values, its
# first half the values to gate and its second half the gates, which is
# leetgpu 65's `input.chunk(2)`. The output is GEGLU_HALF long. 300 is not
# a multiple of 128, so the last of the three blocks runs 84 lanes past the
# end of each half.
const GEGLU_HALF: Int = 300
const GEGLU_TILE: Int = 128

# One over the square root of two, to the nearest Float: the problem's
# `x / math.sqrt(2.0)` as a multiplication.
const GEGLU_INV_SQRT2: Float = 0.7071067811865475

# `x1 * 0.5 * x2 * (1 + erf(x2 / sqrt(2)))` with `x1, x2 = input.chunk(2)`:
# leetgpu 65 (Gaussian Error Gated Linear Unit). The gate is the EXACT
# gelu and not the tanh approximation, because the problem says
# `torch.erf`.
#
# The second half is read with the SAME mask as the first, at a base
# GEGLU_HALF elements further on: the two halves are one buffer, so the
# lane's own tail mask is what keeps both loads inside it.
fn geglu(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [GEGLU_TILE]
  let blk = tile_at(block_id(0), GEGLU_TILE)
  let m = tail_mask(blk, s, GEGLU_HALF)
  let zero = f_const(F64, s, 0.0)
  let a = load_masked(x, blk, s, m, zero)
  let b = load_masked(x, idx_add(blk, idx_const(GEGLU_HALF)), s, m, zero)
  let g = erf(F64, s, mul(F64, s, b, f_const(F64, s, GEGLU_INV_SQRT2)))
  let gate = mul(F64, s, mul(F64, s, f_const(F64, s, 0.5), b), addf(F64, s, f_const(F64, s, 1.0), g))
  store_masked(out, blk, s, m, mul(F64, s, a, gate))
}

# ---- the multi-launch kernels (knife 16) ----
#
# Each of these is one STEP of a host-side sequence, not a whole problem.
# Nothing about the kernel says so: a step is a kernel like any other, and
# what makes leetgpu 85 three launches rather than one is that its
# intermediate results are device buffers no host ever reads.
# scripts/tile-gpu-diff/seq_diff.dawn is where the sequences live.
#
# The shapes here and seq_diff's constants must agree, the way every other
# family's do.

# leetgpu 85 (LoRA Linear): output = x W^T + scale * (x A^T) B^T over a
# batch of LORA_M rows. The weights are stored `out` by `in`, which is what
# makes all three products A times B-TRANSPOSED: the second operand's tile
# is read with its two strides swapped (`permute`), not moved.
const LORA_M: Int = 32
const LORA_DIN: Int = 64
const LORA_DOUT: Int = 64
const LORA_RANK: Int = 16
const LORA_T: Int = 32
const LORA_SCALE: Float = 0.5

# The base linear, launch 1 of 3: base[M, DOUT] = x[M, DIN] * W[DOUT, DIN]^T.
fn lora_base(x: Param[F64], w: Param[F64], base: Param[F64]) -> Unit !Dev = {
  let bn = block_id(1)
  let zero = f_const(F64, [LORA_M, LORA_T], 0.0)
  let acc = d_for(idx_const(0), idx_const(LORA_DIN / LORA_T), idx_const(1), zero, (k, sofar) => {
    let ta = load_strided(x, idx_mul(k, idx_const(LORA_T)), [LORA_M, LORA_T], [LORA_DIN, 1])
    let tb = load_strided(w, idx_add(idx_mul(bn, idx_const(LORA_T * LORA_DIN)), idx_mul(k, idx_const(LORA_T))),
      [LORA_T, LORA_T], permute([LORA_DIN, 1], [1, 0]))
    mmaf(F64, LORA_M, LORA_T, LORA_T, ta, tb, sofar)
  })
  store_strided(base, idx_mul(bn, idx_const(LORA_T)), [LORA_M, LORA_T], [LORA_DOUT, 1], acc)
}

# The low-rank projection, launch 2 of 3: h[M, RANK] = x[M, DIN] * A[RANK, DIN]^T.
# One block: RANK is narrower than a tile, which is the point of a rank.
fn lora_hidden(x: Param[F64], a: Param[F64], h: Param[F64]) -> Unit !Dev = {
  let zero = f_const(F64, [LORA_M, LORA_RANK], 0.0)
  let acc = d_for(idx_const(0), idx_const(LORA_DIN / LORA_T), idx_const(1), zero, (k, sofar) => {
    let ta = load_strided(x, idx_mul(k, idx_const(LORA_T)), [LORA_M, LORA_T], [LORA_DIN, 1])
    let tb = load_strided(a, idx_mul(k, idx_const(LORA_T)), [LORA_T, LORA_RANK], permute([LORA_DIN, 1], [1, 0]))
    mmaf(F64, LORA_M, LORA_T, LORA_RANK, ta, tb, sofar)
  })
  store(h, idx_const(0), [LORA_M, LORA_RANK], acc)
}

# The sum, launch 3 of 3: out = base + scale * (h[M, RANK] * B[DOUT, RANK]^T).
# This is the launch that reads what BOTH earlier launches wrote.
fn lora_out(base: Param[F64], h: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let bn = block_id(1)
  let s = [LORA_M, LORA_T]
  let zero = f_const(F64, s, 0.0)
  let th = load(h, idx_const(0), [LORA_M, LORA_RANK])
  let tb = load_strided(b, idx_mul(bn, idx_const(LORA_T * LORA_RANK)), [LORA_RANK, LORA_T],
    permute([LORA_RANK, 1], [1, 0]))
  let delta = mmaf(F64, LORA_M, LORA_RANK, LORA_T, th, tb, zero)
  let tbase = load_strided(base, idx_mul(bn, idx_const(LORA_T)), s, [LORA_DOUT, 1])
  store_strided(out, idx_mul(bn, idx_const(LORA_T)), s, [LORA_DOUT, 1],
    addf(F64, s, tbase, mul(F64, s, f_const(F64, s, LORA_SCALE), delta)))
}

# leetgpu 6 (Softmax Attention): softmax(Q K^T / sqrt(d)) V, three launches
# over two intermediate matrices that never leave the device. The standard
# shape of the whole attention family, which is twelve of the problems this
# knife's mechanism reaches.
const ATT_M: Int = 64
const ATT_N: Int = 64
const ATT_D: Int = 32
const ATT_T: Int = 32

# 1 / sqrt(ATT_D), to the nearest Float: the problem's `/ d ** 0.5` as a
# multiplication, and a constant of the recording the way LORA_SCALE is.
const ATT_INV_SQRT_D: Float = 0.17677669529663687

# Launch 1 of 3: S[M, N] = Q[M, D] * K[N, D]^T / sqrt(D). K is stored one
# key a row, so this is the transposed product again.
fn attn_scores(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let sh = [ATT_T, ATT_T]
  let tq = load_strided(q, idx_mul(bm, idx_const(ATT_T * ATT_D)), [ATT_T, ATT_D], [ATT_D, 1])
  let tk = load_strided(k, idx_mul(bn, idx_const(ATT_T * ATT_D)), [ATT_D, ATT_T], permute([ATT_D, 1], [1, 0]))
  let acc = mmaf(F64, ATT_T, ATT_D, ATT_T, tq, tk, f_const(F64, sh, 0.0))
  store_strided(s, idx_add(idx_mul(bm, idx_const(ATT_T * ATT_N)), idx_mul(bn, idx_const(ATT_T))), sh, [ATT_N, 1],
    mul(F64, sh, acc, f_const(F64, sh, ATT_INV_SQRT_D)))
}

# Launch 2 of 3: the softmax of each row of S, one row a block. Reads the
# whole row, so no mask: ATT_N is the tile.
fn attn_softmax(s: Param[F64], p: Param[F64]) -> Unit !Dev = {
  let sh = [ATT_N]
  let row = tile_at(block_id(0), ATT_N)
  let t = load(s, row, sh)
  let mx = spread(F64, sh, d_reduce(F64, sh, t, neg_inf(), (acc, e) => s_maxf(F64, acc, e)))
  let ex = exp(F64, sh, sub(F64, sh, t, mx))
  let total = spread(F64, sh, d_reduce(F64, sh, ex, 0.0, (acc, e) => s_addf(F64, acc, e)))
  store(p, row, sh, div(F64, sh, ex, total))
}

# Launch 3 of 3: O[M, D] = P[M, N] * V[N, D], an ordinary row-major product.
fn attn_context(p: Param[F64], v: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let sh = [ATT_T, ATT_D]
  let zero = f_const(F64, sh, 0.0)
  let acc = d_for(idx_const(0), idx_const(ATT_N / ATT_T), idx_const(1), zero, (k, sofar) => {
    let tp = load_strided(p, idx_add(idx_mul(bm, idx_const(ATT_T * ATT_N)), idx_mul(k, idx_const(ATT_T))),
      [ATT_T, ATT_T], [ATT_N, 1])
    let tv = load_strided(v, idx_mul(k, idx_const(ATT_T * ATT_D)), [ATT_T, ATT_D], [ATT_D, 1])
    mmaf(F64, ATT_T, ATT_T, ATT_D, tp, tv, sofar)
  })
  store_strided(o, idx_mul(bm, idx_const(ATT_T * ATT_D)), sh, [ATT_D, 1], acc)
}

# leetgpu 37 (Matrix Power): one square product, launched P-1 times with the
# host ping-ponging between two accumulators. The only kernel here that is
# the WHOLE of its problem: the sequence's length is the problem's exponent,
# a host value, and the kernel does not know how many times it runs.
const MP_N: Int = 32

fn matpow_step(a: Param[F64], b: Param[F64], c: Param[F64]) -> Unit !Dev = {
  let sh = [MP_N, MP_N]
  let ta = load(a, idx_const(0), sh)
  let tb = load(b, idx_const(0), sh)
  store(c, idx_const(0), sh, mmaf(F64, MP_N, MP_N, MP_N, ta, tb, f_const(F64, sh, 0.0)))
}

# leetgpu 84 (SwiGLU MLP Block): (silu(x Wg) * (x Wu)) Wd, four launches
# over three kernels -- the projection kernel is launched TWICE, on two
# different weight buffers into two different outputs. That is the case a
# one-kernel-one-problem ledger cannot spell at all.
const SW_M: Int = 32
const SW_DMODEL: Int = 64
const SW_DFFN: Int = 128
const SW_T: Int = 32

# Launches 1 and 2 of 4: y[M, DFFN] = x[M, DMODEL] * w[DMODEL, DFFN].
fn swiglu_proj(x: Param[F64], w: Param[F64], y: Param[F64]) -> Unit !Dev = {
  let bn = block_id(1)
  let sh = [SW_M, SW_T]
  let zero = f_const(F64, sh, 0.0)
  let acc = d_for(idx_const(0), idx_const(SW_DMODEL / SW_T), idx_const(1), zero, (k, sofar) => {
    let ta = load_strided(x, idx_mul(k, idx_const(SW_T)), [SW_M, SW_T], [SW_DMODEL, 1])
    let tb = load_strided(w, idx_add(idx_mul(k, idx_const(SW_T * SW_DFFN)), idx_mul(bn, idx_const(SW_T))),
      [SW_T, SW_T], [SW_DFFN, 1])
    mmaf(F64, SW_M, SW_T, SW_T, ta, tb, sofar)
  })
  store_strided(y, idx_mul(bn, idx_const(SW_T)), sh, [SW_DFFN, 1], acc)
}

# Launch 3 of 4: h = silu(gate) * up, element-wise over the whole M by DFFN
# block. The launch that reads what the two projections wrote.
const SW_ACT_TILE: Int = 128

fn swiglu_act(gate: Param[F64], up: Param[F64], h: Param[F64]) -> Unit !Dev = {
  let sh = [SW_ACT_TILE]
  let blk = tile_at(block_id(0), SW_ACT_TILE)
  let tg = load(gate, blk, sh)
  let tu = load(up, blk, sh)
  let d = addf(F64, sh, f_const(F64, sh, 1.0), exp(F64, sh, neg(F64, sh, tg)))
  store(h, blk, sh, mul(F64, sh, div(F64, sh, tg, d), tu))
}

# Launch 4 of 4: out[M, DMODEL] = h[M, DFFN] * Wd[DFFN, DMODEL].
fn swiglu_down(h: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let bn = block_id(1)
  let sh = [SW_M, SW_T]
  let zero = f_const(F64, sh, 0.0)
  let acc = d_for(idx_const(0), idx_const(SW_DFFN / SW_T), idx_const(1), zero, (k, sofar) => {
    let ta = load_strided(h, idx_mul(k, idx_const(SW_T)), [SW_M, SW_T], [SW_DFFN, 1])
    let tb = load_strided(w, idx_add(idx_mul(k, idx_const(SW_T * SW_DMODEL)), idx_mul(bn, idx_const(SW_T))),
      [SW_T, SW_T], [SW_DMODEL, 1])
    mmaf(F64, SW_M, SW_T, SW_T, ta, tb, sofar)
  })
  store_strided(out, idx_mul(bn, idx_const(SW_T)), sh, [SW_DMODEL, 1], acc)
}

# leetgpu 73 (All-Pairs Shortest Paths): one Floyd-Warshall round,
# `d = min(d, d[:, k] + d[k, :])`, launched APSP_N times IN PLACE on one
# matrix. The round index `k` is a one-element i32 buffer rather than an
# argument, because a launch carries a grid and buffers and nothing else;
# the kernel reads it by gathering it through an all-zero index tile, which
# broadcasts one element over the whole tile.
#
# The pivot row and column are gathered rather than loaded, for the same
# reason: their offsets depend on a value that is not known when the kernel
# is recorded. `k * N + j` and `i * N + k` are the two index tiles.
#
# One block over one tile, so every gather and the load all precede the
# store: the round reads the matrix as it was before it.
const APSP_N: Int = 16

fn apsp_step(d: Param[F64], kb: Param[I32]) -> Unit !Dev = {
  let sh = [APSP_N, APSP_N]
  let k = gather(kb, i_const(sh, 0), sh)
  let row = add_i(sh, mul_i(sh, k, i_const(sh, APSP_N)), coord(idx_const(0), sh, 1, 1))
  let col = add_i(sh, coord(idx_const(0), sh, 0, APSP_N), k)
  let through = addf(F64, sh, gather(d, col, sh), gather(d, row, sh))
  store(d, idx_const(0), sh, minf(F64, sh, load(d, idx_const(0), sh), through))
}

# leetgpu 53, 55, 59, 92 and 112 (knife 17): five more score kernels, and
# nothing else. Every one of them is `attn_scores` plus a rule on the
# position (i, j) of the score it is about to store, and four of the five
# hand their result to the SAME `attn_softmax` and `attn_context` knife 16
# recorded. That reuse is the point: an attention variant is a rule on a
# score, so the family costs one kernel a problem rather than three.
#
# All five run at knife 16's attention shape (ATT_M by ATT_D queries against
# ATT_N keys), which is what makes the two reused recordings applicable
# without re-recording them.

## The scaled product both `attn_scores` and the five below start from:
## `Q[bm] K[bn]^T / sqrt(D)` for one ATT_T by ATT_T block of the score
## matrix. Written once here rather than five more times; the trace is the
## same operations in the same order either way.
fn att_scaled(q: Param[F64], k: Param[F64], bm: Idx, bn: Idx) -> Tile[F64] !Dev = {
  let sh = [ATT_T, ATT_T]
  let tq = load_strided(q, idx_mul(bm, idx_const(ATT_T * ATT_D)), [ATT_T, ATT_D], [ATT_D, 1])
  let tk = load_strided(k, idx_mul(bn, idx_const(ATT_T * ATT_D)), [ATT_D, ATT_T], permute([ATT_D, 1], [1, 0]))
  let acc = mmaf(F64, ATT_T, ATT_D, ATT_T, tq, tk, f_const(F64, sh, 0.0))
  mul(F64, sh, acc, f_const(F64, sh, ATT_INV_SQRT_D))
}

## The block's store, at the same place `attn_scores` writes it.
fn att_store(s: Param[F64], bm: Idx, bn: Idx, v: Tile[F64]) -> Unit !Dev =
  store_strided(s, idx_add(idx_mul(bm, idx_const(ATT_T * ATT_N)), idx_mul(bn, idx_const(ATT_T))),
    [ATT_T, ATT_T], [ATT_N, 1], v)

## The two GLOBAL coordinates every rule below is a function of: the query
## index `i` and the key index `j` of each lane, counted from the block's
## own base rather than from the tile's.
fn att_row(bm: Idx) -> Tile[I32] !Dev = coord(idx_mul(bm, idx_const(ATT_T)), [ATT_T, ATT_T], 0, 1)

fn att_col(bn: Idx) -> Tile[I32] !Dev = coord(idx_mul(bn, idx_const(ATT_T)), [ATT_T, ATT_T], 1, 1)

# leetgpu 53 (Causal Self-Attention): the score at a key in the query's
# future is -inf, so `attn_softmax` gives it weight exactly zero.
fn attn_causal(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let sh = [ATT_T, ATT_T]
  let v = att_scaled(q, k, bm, bn)
  let allowed = ge_i(sh, att_row(bm), att_col(bn))
  att_store(s, bm, bn, select(F64, sh, allowed, v, f_const(F64, sh, neg_inf())))
}

# leetgpu 55 (Attention with Linear Biases): ALiBi. No mask at all -- the
# rule ADDS `alpha * (i - j)` to every score, so the whole matrix stays
# finite and the slope is a host constant of the recording.
const ATT_ALIBI: Float = 0.0 - 0.125

fn attn_alibi(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let sh = [ATT_T, ATT_T]
  let v = att_scaled(q, k, bm, bn)
  let bias = mul(F64, sh, f_const(F64, sh, ATT_ALIBI),
    int_to_float(F64, sh, sub_i(sh, att_row(bm), att_col(bn))))
  att_store(s, bm, bn, addf(F64, sh, v, bias))
}

# leetgpu 59 (Sliding Window Self-Attention): a band of half-width
# ATT_WINDOW about the diagonal, both directions. The only rule here that is
# not causal.
const ATT_WINDOW: Int = 8

fn attn_window(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let sh = [ATT_T, ATT_T]
  let v = att_scaled(q, k, bm, bn)
  let near = lt_i(sh, abs_i(sh, sub_i(sh, att_row(bm), att_col(bn))), i_const(sh, ATT_WINDOW + 1))
  att_store(s, bm, bn, select(F64, sh, near, v, f_const(F64, sh, neg_inf())))
}

# leetgpu 112 (Attention with Sinks): causal, and within that either one of
# the first ATT_SINKS keys or inside the trailing window. Two masks joined
# by an `or` under an `and`, which is the widest rule of the five.
const ATT_SINKS: Int = 4
const ATT_SINK_WINDOW: Int = 16

fn attn_sinks(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let sh = [ATT_T, ATT_T]
  let v = att_scaled(q, k, bm, bn)
  let gi = att_row(bm)
  let gj = att_col(bn)
  let causal = ge_i(sh, gi, gj)
  let sink = lt_i(sh, gj, i_const(sh, ATT_SINKS))
  let window = ge_i(sh, gj, add_i(sh, gi, i_const(sh, 1 - ATT_SINK_WINDOW)))
  let allowed = and_mask(sh, causal, or_mask(sh, sink, window))
  att_store(s, bm, bn, select(F64, sh, allowed, v, f_const(F64, sh, neg_inf())))
}

# leetgpu 92 (Decaying Causal Attention): the one variant with NO softmax.
# The weight of key `j` for query `i` is the raw score times `gamma^(i - j)`
# for `i >= j` and zero otherwise, so this kernel's output goes straight to
# `attn_context` and the sequence is two launches rather than three.
#
# `gamma^d` is `exp(d * ln gamma)` here, with `ln gamma` a host constant of
# the recording: the same `exp` the rest of this family already runs on the
# device and the same `ref_exp` the host reference already has, rather than
# a `pow` whose two sides would be two different approximations.
const ATT_LN_GAMMA: Float = 0.0 - 0.10536051565782628

fn attn_decay(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let sh = [ATT_T, ATT_T]
  let v = att_scaled(q, k, bm, bn)
  let gi = att_row(bm)
  let gj = att_col(bn)
  let ahead = int_to_float(F64, sh, max_i(sh, sub_i(sh, gi, gj), i_const(sh, 0)))
  let decay = exp(F64, sh, mul(F64, sh, ahead, f_const(F64, sh, ATT_LN_GAMMA)))
  att_store(s, bm, bn,
    select(F64, sh, ge_i(sh, gi, gj), mul(F64, sh, v, decay), f_const(F64, sh, 0.0)))
}

# leetgpu 25 (Categorical Cross Entropy Loss): two launches, a row at a time
# and then the mean. The only sequence of this knife that is not attention,
# and the first recorded kernel to read an INDEX out of an integer buffer to
# pick a column with (the `apsp` rounds gather a scalar, not a choice).
const CCE_N: Int = 64
const CCE_C: Int = 32

# Launch 1 of 2: `logsumexp(row) - row[label]`, one row a block. The row
# index is not an argument, so it is read out of the lane numbers: lane `l`
# of a 1-wide tile at block `i` is `i`, and `i * C + label[i]` is the
# element of `logits` the true class sits at.
fn cce_row(logits: Param[F64], labels: Param[I32], loss: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let sh = [CCE_C]
  let one = [1]
  let t = load(logits, tile_at(i, CCE_C), sh)
  let mx = d_reduce(F64, sh, t, neg_inf(), (acc, e) => s_maxf(F64, acc, e))
  let ex = exp(F64, sh, sub(F64, sh, t, spread(F64, sh, mx)))
  let total = d_reduce(F64, sh, ex, 0.0, (acc, e) => s_addf(F64, acc, e))
  let at = lanes(tile_at(i, 1), one)
  let lab = gather(labels, at, one)
  let true_logit = gather(logits, add_i(one, mul_i(one, at, i_const(one, CCE_C)), lab), one)
  let lse = addf(F64, one, spread(F64, one, mx), log(F64, one, spread(F64, one, total)))
  store_one(loss, i, sub(F64, one, lse, true_logit))
}

# Launch 2 of 2: the mean of the CCE_N row losses, one block over one tile.
# It reads no block id at all, which is why the grid mutant is invisible
# here (run.sh's table says so beside the other two).
fn cce_mean(l: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let sh = [CCE_N]
  let t = load(l, idx_const(0), sh)
  let total = spread(F64, [1], d_reduce(F64, sh, t, 0.0, (acc, e) => s_addf(F64, acc, e)))
  store(out, idx_const(0), [1], div(F64, [1], total, f_const(F64, [1], to_float(CCE_N))))
}

# ---- knife 18: the mechanism-complete singles, and the head axis ----
#
# Nothing below adds an operation to the package. Seven of these eight
# kernels are one launch each, written out of what knives 7a to 12 already
# had, and the two at the end are the attention family read one HEAD at a
# time. What knife 18 adds is the observation that a mechanism nobody has
# spent is not the same as a problem nobody can solve.

# leetgpu 18 (Sparse Matrix-Vector Multiplication). `A` is handed to
# `solve` as a DENSE M by N buffer and the problem's own reference is
# `torch.matmul(A, x)`, so "sparse" describes the data and not the format:
# the zeroes are values. The vector is read with a stride of ZERO along the
# row axis, so one `x[j]` serves every row, and the row sums are the
# product folded along dimension 1. No `mmaf`, so a corpus of small whole
# numbers makes this EXACT where the GEMMs are tolerance.
const MV_M: Int = 64
const MV_N: Int = 64

fn matvec(a: Param[F64], x: Param[F64], y: Param[F64]) -> Unit !Dev = {
  let sh = [MV_M, MV_N]
  let ta = load(a, idx_const(0), sh)
  let tx = load_strided(x, idx_const(0), sh, axis_strides(2, 1, 1))
  let row = d_reduce_dim(F64, sh, 1, mul(F64, sh, ta, tx), 0.0, (acc, e) => s_addf(F64, acc, e))
  store(y, idx_const(0), [MV_M], row)
}

# leetgpu 48 (2D Subarray Sum): the i32 sum of a RECTANGLE of an
# S2_ROWS by S2_COLS matrix, at element 0 of the second buffer. leetgpu 47
# is the same sum over a run of a flat buffer and `subarray_sum` masks it
# with one `in_range` over `lanes`; a rectangle needs one per axis, because
# a lane outside the window along the rows may be inside it along the
# columns.
#
# The tile is RANK 1 and the two coordinates are recovered from the lane
# number by a `divi` and a `remi`, rather than rank 2 with a `coord` an
# axis. That is not a preference: `d_reduce_i` reduces to a SCALAR and so
# reduces one dimension, and a rank-2 integer sum would need two of them.
# The array's rank and the tile's are independent, which is the thing to
# take from this kernel and the next.
#
# Both bounds are INCLUSIVE in the problem's statement, so the mask's upper
# limits are one past them. Neither window touches an edge of the matrix,
# so a mask that dropped either bound would show.
const S2_ROWS: Int = 32
const S2_COLS: Int = 64
const S2_R0: Int = 5
const S2_R1: Int = 27
const S2_C0: Int = 9
const S2_C1: Int = 52

fn subarray_sum2d(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let sh = [S2_ROWS * S2_COLS]
  let zero = idx_const(0)
  let flat = lanes(zero, sh)
  let cols = i_const(sh, S2_COLS)
  let inside = and_mask(sh,
    in_range(sh, div_i(sh, flat, cols), S2_R0, S2_R1 + 1),
    in_range(sh, rem_i(sh, flat, cols), S2_C0, S2_C1 + 1))
  let t = load_masked(x, zero, sh, inside, i_const(sh, 0))
  let s = d_reduce_i(sh, t, 0, (acc, e) => s_addi(acc, e))
  store(out, zero, [1], spread(I32, [1], s))
}

# leetgpu 49 (3D Subarray Sum): the same over a BOX of an
# S3_DEP by S3_ROWS by S3_COLS array. One more axis is one more division
# and nothing else: the tile stays rank 1, the depth is the lane number
# divided by the plane, and the row is what is left over divided by the
# width. A third dimension costs arithmetic here, not a tile rank.
const S3_DEP: Int = 4
const S3_ROWS: Int = 8
const S3_COLS: Int = 32
const S3_D0: Int = 1
const S3_D1: Int = 2
const S3_R0: Int = 2
const S3_R1: Int = 6
const S3_C0: Int = 3
const S3_C1: Int = 29

fn subarray_sum3d(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let sh = [S3_DEP * S3_ROWS * S3_COLS]
  let zero = idx_const(0)
  let flat = lanes(zero, sh)
  let cols = i_const(sh, S3_COLS)
  let plane = i_const(sh, S3_ROWS * S3_COLS)
  let inside = and_mask(sh,
    and_mask(sh,
      in_range(sh, div_i(sh, flat, plane), S3_D0, S3_D1 + 1),
      in_range(sh, rem_i(sh, div_i(sh, flat, cols), i_const(sh, S3_ROWS)), S3_R0, S3_R1 + 1)),
    in_range(sh, rem_i(sh, flat, cols), S3_C0, S3_C1 + 1))
  let t = load_masked(x, zero, sh, inside, i_const(sh, 0))
  let s = d_reduce_i(sh, t, 0, (acc, e) => s_addi(acc, e))
  store(out, zero, [1], spread(I32, [1], s))
}

# leetgpu 54 (Swish-Gated Linear Unit): `silu(x1) * x2` with
# `x1, x2 = input.chunk(2)`, one buffer read at two bases the way `geglu`
# reads its own. NOT leetgpu 84's third launch: that one is handed two
# separate buffers a projection wrote, and this one is handed one buffer
# and has to find its own halves. SWH_HALF is not a multiple of the tile,
# so the last block runs past the end of both halves under one mask.
const SWH_HALF: Int = 500
const SWH_TILE: Int = 128

fn swiglu_half(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let sh = [SWH_TILE]
  let blk = tile_at(block_id(0), SWH_TILE)
  let m = tail_mask(blk, sh, SWH_HALF)
  let zero = f_const(F64, sh, 0.0)
  let a = load_masked(x, blk, sh, m, zero)
  let b = load_masked(x, idx_add(blk, idx_const(SWH_HALF)), sh, m, zero)
  let d = addf(F64, sh, f_const(F64, sh, 1.0), exp(F64, sh, neg(F64, sh, a)))
  store_masked(out, blk, sh, m, mul(F64, sh, div(F64, sh, a, d), b))
}

# leetgpu 64 (Weight Dequantization): `Y = X * S` where one element of `S`
# scales a DQ_TS by DQ_TS block of `X`. The scale's address is
# `(i / TS) * s_cols + (j / TS)`, an index each lane computes out of its
# own coordinates, so this is knife 12's gather with no buffer read for the
# index at all: the arithmetic is the whole of the indirection. Every index
# is inside `S` by construction, so the gather is unmasked and this kernel
# is `token_embed`'s control in run.sh's gather-mask-dropped.
const DQ_M: Int = 64
const DQ_N: Int = 64
const DQ_TS: Int = 16

fn dq_cols() -> Int = DQ_N / DQ_TS

fn dequant(x: Param[F64], s: Param[F64], y: Param[F64]) -> Unit !Dev = {
  let sh = [DQ_M, DQ_N]
  let zero = idx_const(0)
  let ts = i_const(sh, DQ_TS)
  let at = add_i(sh,
    mul_i(sh, div_i(sh, coord(zero, sh, 0, 1), ts), i_const(sh, dq_cols())),
    div_i(sh, coord(zero, sh, 1, 1), ts))
  store(y, zero, sh, mul(F64, sh, load(x, zero, sh), gather(s, at, sh)))
}

# leetgpu 11 (3D Convolution), valid mode. `conv2d` is one load a tap at a
# base shifted by `p * width + q`; this is the same with the third
# dimension on the GRID: block `d` computes output plane `d`, and the tap's
# depth offset is a constant times the plane. The three extents differ and
# so do the three kernel extents, so a kernel that confused two of them
# would answer a different shape rather than a different number.
const C3_D: Int = 8
const C3_H: Int = 12
const C3_W: Int = 16
const C3_KD: Int = 2
const C3_KH: Int = 3
const C3_KW: Int = 3
const C3_TILE: Int = 16

fn c3_od() -> Int = C3_D - C3_KD + 1

fn c3_oh() -> Int = C3_H - C3_KH + 1

fn c3_ow() -> Int = C3_W - C3_KW + 1

fn conv3d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let sh = [C3_TILE, C3_TILE]
  let bd = block_id(0)
  let zero = idx_const(0)
  let m = and_mask(sh, axis_mask(zero, sh, 0, c3_oh()), axis_mask(zero, sh, 1, c3_ow()))
  let pad = f_const(F64, sh, 0.0)
  let corner = idx_mul(bd, idx_const(C3_H * C3_W))
  var acc = pad
  for p in range(0, C3_KD) {
    for q in range(0, C3_KH) {
      for r in range(0, C3_KW) {
        let xt = load_strided_masked(x, idx_add(corner, idx_const(p * C3_H * C3_W + q * C3_W + r)), sh,
          [C3_W, 1], m, pad)
        let wt = load_strided(w, idx_const((p * C3_KH + q) * C3_KW + r), sh, [0, 0])
        acc = addf(F64, sh, acc, mul(F64, sh, xt, wt))
      }
    }
  }
  store_strided_masked(out, idx_mul(bd, idx_const(c3_oh() * c3_ow())), sh, [c3_ow(), 1], m, acc)
}

# leetgpu 12 (Multi-Head Attention): the attention family with a HEAD axis.
# `Q`, `K` and `V` are one N by d_model matrix each, head `h` owning the
# columns `[h * DK, (h + 1) * DK)`, and the answer goes back into the same
# columns of the output. So the head is not a separate matrix: it is a
# COLUMN SLICE, which is a base offset and a row stride and nothing else.
#
# The middle launch is knife 16's `attn_softmax`, unchanged and
# un-re-recorded: the scores of all MHA_H heads are written one head after
# another, each head an MHA_N by MHA_N block, so the whole scores buffer is
# MHA_H * MHA_N rows of MHA_N and a softmax by row is a softmax by row. The
# grid does the rest. That is knife 17's lesson spent once more, on an axis
# rather than on a mask.
const MHA_N: Int = 64
const MHA_DMODEL: Int = 64
const MHA_H: Int = 2
const MHA_DK: Int = 32
const MHA_T: Int = 32

# 1 / sqrt(MHA_DK), to the nearest Float.
const MHA_INV_SQRT_DK: Float = 0.17677669529663687

# Launch 1 of 3: S[h, M, N] = Q_h * K_h^T / sqrt(DK), the head on the
# grid's THIRD axis and the head's columns at `bh * MHA_DK`.
fn mha_scores(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let bh = block_id(2)
  let sh = [MHA_T, MHA_T]
  let head = idx_mul(bh, idx_const(MHA_DK))
  let tq = load_strided(q, idx_add(idx_mul(bm, idx_const(MHA_T * MHA_DMODEL)), head),
    [MHA_T, MHA_DK], [MHA_DMODEL, 1])
  let tk = load_strided(k, idx_add(idx_mul(bn, idx_const(MHA_T * MHA_DMODEL)), head),
    [MHA_DK, MHA_T], permute([MHA_DMODEL, 1], [1, 0]))
  let acc = mmaf(F64, MHA_T, MHA_DK, MHA_T, tq, tk, f_const(F64, sh, 0.0))
  let base = idx_add(idx_add(idx_mul(bh, idx_const(MHA_N * MHA_N)),
    idx_mul(bm, idx_const(MHA_T * MHA_N))), idx_mul(bn, idx_const(MHA_T)))
  store_strided(s, base, sh, [MHA_N, 1], mul(F64, sh, acc, f_const(F64, sh, MHA_INV_SQRT_DK)))
}

# Launch 3 of 3: O[:, h] = P_h * V_h, reading the head's block of the
# probabilities and the head's columns of `V`, and writing the head's
# columns of the output.
fn mha_context(p: Param[F64], v: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bh = block_id(2)
  let sh = [MHA_T, MHA_DK]
  let head = idx_mul(bh, idx_const(MHA_DK))
  let rows = idx_add(idx_mul(bh, idx_const(MHA_N * MHA_N)), idx_mul(bm, idx_const(MHA_T * MHA_N)))
  let acc = d_for(idx_const(0), idx_const(MHA_N / MHA_T), idx_const(1), f_const(F64, sh, 0.0), (kk, sofar) => {
    let tp = load_strided(p, idx_add(rows, idx_mul(kk, idx_const(MHA_T))), [MHA_T, MHA_T], [MHA_N, 1])
    let tv = load_strided(v, idx_add(idx_mul(kk, idx_const(MHA_T * MHA_DMODEL)), head),
      [MHA_T, MHA_DK], [MHA_DMODEL, 1])
    mmaf(F64, MHA_T, MHA_T, MHA_DK, tp, tv, sofar)
  })
  store_strided(o, idx_add(idx_mul(bm, idx_const(MHA_T * MHA_DMODEL)), head), sh, [MHA_DMODEL, 1], acc)
}

fn trace(name: String) -> TileProg = match name {
  "vadd" ->
    trace_kernel("vadd", ["f64", "f64", "f64"], () => vadd(param(F64, 0), param(F64, 1), param(F64, 2)))
  "vadd_f32" ->
    trace_kernel("vadd_f32", ["f32", "f32", "f32"], () => vadd_f32(param(F32, 0), param(F32, 1), param(F32, 2)))
  "vadd_bf16" ->
    trace_kernel("vadd_bf16", ["bf16", "bf16", "bf16"], () => vadd_bf16(param(BF16, 0), param(BF16, 1), param(BF16, 2)))
  "sum" ->
    trace_kernel("sum", ["f64", "f64"], () => sum(param(F64, 0), param(F64, 1), 4))
  "vadd_tail" ->
    trace_kernel("vadd_tail", ["f64", "f64", "f64"], () => vadd_tail(param(F64, 0), param(F64, 1), param(F64, 2)))
  "copy" ->
    trace_kernel("copy", ["f64", "f64"], () => copy(param(F64, 0), param(F64, 1)))
  "relu" ->
    trace_kernel("relu", ["f64", "f64"], () => relu(param(F64, 0), param(F64, 1)))
  "leaky_relu" ->
    trace_kernel("leaky_relu", ["f64", "f64"], () => leaky_relu(param(F64, 0), param(F64, 1)))
  "clip" ->
    trace_kernel("clip", ["f64", "f64"], () => clip(param(F64, 0), param(F64, 1)))
  "elemops" ->
    trace_kernel("elemops", ["f64", "f64", "f64"], () => elemops(param(F64, 0), param(F64, 1), param(F64, 2)))
  "reduce_sum" ->
    trace_kernel("reduce_sum", ["f64", "f64"], () => reduce_sum(param(F64, 0), param(F64, 1)))
  "softmax" ->
    trace_kernel("softmax", ["f64", "f64"], () => softmax(param(F64, 0), param(F64, 1)))
  "dot" ->
    trace_kernel("dot", ["f64", "f64", "f64"], () => dot(param(F64, 0), param(F64, 1), param(F64, 2)))
  "mse" ->
    trace_kernel("mse", ["f64", "f64", "f64"], () => mse(param(F64, 0), param(F64, 1), param(F64, 2)))
  "monte_carlo" ->
    trace_kernel("monte_carlo", ["f64", "f64"], () => monte_carlo(param(F64, 0), param(F64, 1)))
  "rms_norm" ->
    trace_kernel("rms_norm", ["f64", "f64"], () => rms_norm(param(F64, 0), param(F64, 1)))
  "silu" ->
    trace_kernel("silu", ["f64", "f64"], () => silu(param(F64, 0), param(F64, 1)))
  "sigmoid" ->
    trace_kernel("sigmoid", ["f64", "f64"], () => sigmoid(param(F64, 0), param(F64, 1)))
  "ppo_loss" ->
    trace_kernel("ppo_loss", ["f64", "f64", "f64", "f64"],
      () => ppo_loss(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "dpo_loss" ->
    trace_kernel("dpo_loss", ["f64", "f64", "f64", "f64", "f64"],
      () => dpo_loss(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3), param(F64, 4)))
  "mathops" ->
    trace_kernel("mathops", ["f64", "f64", "f64"], () => mathops(param(F64, 0), param(F64, 1), param(F64, 2)))
  "foldif" ->
    trace_kernel("foldif", ["f64", "f64"], () => foldif(param(F64, 0), param(F64, 1), FOLD_CHUNKS))
  "argmax" ->
    trace_kernel("argmax", ["f64", "f64"], () => argmax(param(F64, 0), param(F64, 1)))
  "matmul" ->
    trace_kernel("matmul", ["f64", "f64", "f64"], () => matmul(param(F64, 0), param(F64, 1), param(F64, 2)))
  "batched_matmul" ->
    trace_kernel("batched_matmul", ["f64", "f64", "f64"],
      () => batched_matmul(param(F64, 0), param(F64, 1), param(F64, 2)))
  "transpose" ->
    trace_kernel("transpose", ["f64", "f64"], () => transpose(param(F64, 0), param(F64, 1)))
  "layer_norm" ->
    trace_kernel("layer_norm", ["f64", "f64", "f64", "f64"],
      () => layer_norm(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "batch_norm" ->
    trace_kernel("batch_norm", ["f64", "f64", "f64", "f64"],
      () => batch_norm(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "group_norm" ->
    trace_kernel("group_norm", ["f64", "f64", "f64", "f64"],
      () => group_norm(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "fused_rms_norm" ->
    trace_kernel("fused_rms_norm", ["f64", "f64", "f64", "f64"],
      () => fused_rms_norm(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "transpose_tail" ->
    trace_kernel("transpose_tail", ["f64", "f64"], () => transpose_tail(param(F64, 0), param(F64, 1)))
  "conv1d" ->
    trace_kernel("conv1d", ["f64", "f64", "f64"], () => conv1d(param(F64, 0), param(F64, 1), param(F64, 2)))
  "conv2d" ->
    trace_kernel("conv2d", ["f64", "f64", "f64"], () => conv2d(param(F64, 0), param(F64, 1), param(F64, 2)))
  "max_pool" ->
    trace_kernel("max_pool", ["f64", "f64"], () => max_pool(param(F64, 0), param(F64, 1)))
  "interleave" ->
    trace_kernel("interleave", ["f64", "f64", "f64"], () => interleave(param(F64, 0), param(F64, 1), param(F64, 2)))
  "rgb_gray" ->
    trace_kernel("rgb_gray", ["f64", "f64"], () => rgb_gray(param(F64, 0), param(F64, 1)))
  "jacobi" ->
    trace_kernel("jacobi", ["f64", "f64"], () => jacobi(param(F64, 0), param(F64, 1)))
  "depthwise_conv1d" ->
    trace_kernel("depthwise_conv1d", ["f64", "f64", "f64"],
      () => depthwise_conv1d(param(F64, 0), param(F64, 1), param(F64, 2)))
  "gaussian_blur" ->
    trace_kernel("gaussian_blur", ["f64", "f64", "f64"],
      () => gaussian_blur(param(F64, 0), param(F64, 1), param(F64, 2)))
  "count_eq" ->
    trace_kernel("count_eq", ["i32", "i32"], () => count_eq(param(I32, 0), param(I32, 1)))
  "subarray_sum" ->
    trace_kernel("subarray_sum", ["i32", "i32"], () => subarray_sum(param(I32, 0), param(I32, 1)))
  "rainbow" ->
    trace_kernel("rainbow", ["i32", "i32"], () => rainbow(param(I32, 0), param(I32, 1)))
  "int_ops" ->
    trace_kernel("int_ops", ["i32", "i32", "i32"],
      () => int_ops(param(I32, 0), param(I32, 1), param(I32, 2)))
  "sum_diff" ->
    trace_kernel("sum_diff", ["f64", "f64", "f64", "f64"],
      () => sum_diff(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "reverse" ->
    trace_kernel("reverse", ["f64"], () => reverse(param(F64, 0)))
  "invert" ->
    trace_kernel("invert", ["i8"], () => invert(param(I8, 0)))
  "f16_ops" ->
    trace_kernel("f16_ops", ["f16", "f16", "f16"],
      () => f16_ops(param(F16, 0), param(F16, 1), param(F16, 2)))
  "dot_f16" ->
    trace_kernel("dot_f16", ["f16", "f16", "f64"],
      () => dot_f16(param(F16, 0), param(F16, 1), param(F64, 2)))
  "matmul_f16" ->
    trace_kernel("matmul_f16", ["f16", "f16", "f16"],
      () => matmul_f16(param(F16, 0), param(F16, 1), param(F16, 2)))
  "batched_matmul_f16" ->
    trace_kernel("batched_matmul_f16", ["f16", "f16", "f16"],
      () => batched_matmul_f16(param(F16, 0), param(F16, 1), param(F16, 2)))
  "matmul_i8" ->
    trace_kernel("matmul_i8", ["i8", "i8", "i32"],
      () => matmul_i8(param(I8, 0), param(I8, 1), param(I32, 2)))
  "token_embed" ->
    trace_kernel("token_embed", ["i32", "f64", "f64"],
      () => token_embed(param(I32, 0), param(F64, 1), param(F64, 2)))
  "sort_rank" ->
    trace_kernel("sort_rank", ["f64", "f64"], () => sort_rank(param(F64, 0), param(F64, 1)))
  "merge_rank" ->
    trace_kernel("merge_rank", ["f64", "f64", "f64"],
      () => merge_rank(param(F64, 0), param(F64, 1), param(F64, 2)))
  "scatter_perm" ->
    trace_kernel("scatter_perm", ["i32", "f64", "f64"],
      () => scatter_perm(param(I32, 0), param(F64, 1), param(F64, 2)))
  "prefix_sum" ->
    trace_kernel("prefix_sum", ["f64", "f64"], () => prefix_sum(param(F64, 0), param(F64, 1)))
  "max_subarray" ->
    trace_kernel("max_subarray", ["i32", "i32"], () => max_subarray(param(I32, 0), param(I32, 1)))
  "seg_scan" ->
    trace_kernel("seg_scan", ["f64", "i32", "f64"],
      () => seg_scan(param(F64, 0), param(I32, 1), param(F64, 2)))
  "compact" ->
    trace_kernel("compact", ["f64", "f64"], () => compact(param(F64, 0), param(F64, 1)))
  "linrec" ->
    trace_kernel("linrec", ["f64", "f64", "f64"],
      () => linrec(param(F64, 0), param(F64, 1), param(F64, 2)))
  "gae" ->
    trace_kernel("gae", ["f64", "f64", "f64"],
      () => gae(param(F64, 0), param(F64, 1), param(F64, 2)))
  "ssm_scan" ->
    trace_kernel("ssm_scan", ["f64", "f64", "f64", "f64", "f64", "f64", "f64"],
      () => ssm_scan(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3),
        param(F64, 4), param(F64, 5), param(F64, 6)))
  "histogram" ->
    trace_kernel("histogram", ["i32", "i32"], () => histogram(param(I32, 0), param(I32, 1)))
  "cas_swap" ->
    trace_kernel("cas_swap", ["i32", "i32", "i32", "i32"],
      () => cas_swap(param(I32, 0), param(I32, 1), param(I32, 2), param(I32, 3)))
  "erf_sweep" ->
    trace_kernel("erf_sweep", ["f64", "f64"], () => erf_sweep(param(F64, 0), param(F64, 1)))
  "geglu" ->
    trace_kernel("geglu", ["f64", "f64"], () => geglu(param(F64, 0), param(F64, 1)))
  "lora_base" ->
    trace_kernel("lora_base", ["f64", "f64", "f64"],
      () => lora_base(param(F64, 0), param(F64, 1), param(F64, 2)))
  "lora_hidden" ->
    trace_kernel("lora_hidden", ["f64", "f64", "f64"],
      () => lora_hidden(param(F64, 0), param(F64, 1), param(F64, 2)))
  "lora_out" ->
    trace_kernel("lora_out", ["f64", "f64", "f64", "f64"],
      () => lora_out(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "attn_scores" ->
    trace_kernel("attn_scores", ["f64", "f64", "f64"],
      () => attn_scores(param(F64, 0), param(F64, 1), param(F64, 2)))
  "attn_softmax" ->
    trace_kernel("attn_softmax", ["f64", "f64"], () => attn_softmax(param(F64, 0), param(F64, 1)))
  "attn_context" ->
    trace_kernel("attn_context", ["f64", "f64", "f64"],
      () => attn_context(param(F64, 0), param(F64, 1), param(F64, 2)))
  "matpow_step" ->
    trace_kernel("matpow_step", ["f64", "f64", "f64"],
      () => matpow_step(param(F64, 0), param(F64, 1), param(F64, 2)))
  "swiglu_proj" ->
    trace_kernel("swiglu_proj", ["f64", "f64", "f64"],
      () => swiglu_proj(param(F64, 0), param(F64, 1), param(F64, 2)))
  "swiglu_act" ->
    trace_kernel("swiglu_act", ["f64", "f64", "f64"],
      () => swiglu_act(param(F64, 0), param(F64, 1), param(F64, 2)))
  "swiglu_down" ->
    trace_kernel("swiglu_down", ["f64", "f64", "f64"],
      () => swiglu_down(param(F64, 0), param(F64, 1), param(F64, 2)))
  "apsp_step" ->
    trace_kernel("apsp_step", ["f64", "i32"], () => apsp_step(param(F64, 0), param(I32, 1)))
  "attn_causal" ->
    trace_kernel("attn_causal", ["f64", "f64", "f64"],
      () => attn_causal(param(F64, 0), param(F64, 1), param(F64, 2)))
  "attn_alibi" ->
    trace_kernel("attn_alibi", ["f64", "f64", "f64"],
      () => attn_alibi(param(F64, 0), param(F64, 1), param(F64, 2)))
  "attn_window" ->
    trace_kernel("attn_window", ["f64", "f64", "f64"],
      () => attn_window(param(F64, 0), param(F64, 1), param(F64, 2)))
  "attn_sinks" ->
    trace_kernel("attn_sinks", ["f64", "f64", "f64"],
      () => attn_sinks(param(F64, 0), param(F64, 1), param(F64, 2)))
  "attn_decay" ->
    trace_kernel("attn_decay", ["f64", "f64", "f64"],
      () => attn_decay(param(F64, 0), param(F64, 1), param(F64, 2)))
  "cce_row" ->
    trace_kernel("cce_row", ["f64", "i32", "f64"],
      () => cce_row(param(F64, 0), param(I32, 1), param(F64, 2)))
  "cce_mean" ->
    trace_kernel("cce_mean", ["f64", "f64"], () => cce_mean(param(F64, 0), param(F64, 1)))
  "matvec" ->
    trace_kernel("matvec", ["f64", "f64", "f64"],
      () => matvec(param(F64, 0), param(F64, 1), param(F64, 2)))
  "subarray_sum2d" ->
    trace_kernel("subarray_sum2d", ["i32", "i32"], () => subarray_sum2d(param(I32, 0), param(I32, 1)))
  "subarray_sum3d" ->
    trace_kernel("subarray_sum3d", ["i32", "i32"], () => subarray_sum3d(param(I32, 0), param(I32, 1)))
  "swiglu_half" ->
    trace_kernel("swiglu_half", ["f64", "f64"], () => swiglu_half(param(F64, 0), param(F64, 1)))
  "dequant" ->
    trace_kernel("dequant", ["f64", "f64", "f64"],
      () => dequant(param(F64, 0), param(F64, 1), param(F64, 2)))
  "conv3d" ->
    trace_kernel("conv3d", ["f64", "f64", "f64"],
      () => conv3d(param(F64, 0), param(F64, 1), param(F64, 2)))
  "mha_scores" ->
    trace_kernel("mha_scores", ["f64", "f64", "f64"],
      () => mha_scores(param(F64, 0), param(F64, 1), param(F64, 2)))
  "mha_context" ->
    trace_kernel("mha_context", ["f64", "f64", "f64"],
      () => mha_context(param(F64, 0), param(F64, 1), param(F64, 2)))
  _ -> panic("tile-golden: no kernel named `${name}`")
}

# Trace `name` twice and answer the record, or panic if the two runs differ.
fn trace_twice(name: String) -> TileProg = {
  let first = trace(name)
  let second = trace(name)
  if first != second { panic("tile-golden: `${name}` traced twice gave two different programs") } else { () }
  first
}

pub fn main() -> Unit !io = match args() {
  ["--bytecode-version"] -> println(bytecode_version())
  [name] -> print(render(trace_twice(name)))
  [name, "--bytecode", path] -> {
    let bytes = encode(trace_twice(name))
    match with_fs_real(() => write_bytes(path, bytes)) {
      Ok(_) -> ()
      Err(_e) -> panic("tile-golden: cannot write the bytecode to `${path}`")
    }
  }
  _ -> panic("usage: kernels <vadd|vadd_f32|vadd_bf16|sum|vadd_tail|copy|relu|leaky_relu|clip|elemops"
      ++ "|reduce_sum|softmax|dot|mse|monte_carlo|rms_norm|silu|sigmoid|ppo_loss|dpo_loss|mathops|foldif|argmax"
      ++ "|matmul|batched_matmul|transpose|layer_norm|batch_norm|group_norm|fused_rms_norm"
      ++ "|transpose_tail|conv1d|conv2d|max_pool|interleave|rgb_gray|jacobi|depthwise_conv1d|gaussian_blur"
      ++ "|count_eq|subarray_sum|rainbow|int_ops"
      ++ "|sum_diff|reverse|invert|f16_ops|dot_f16|matmul_f16|batched_matmul_f16|matmul_i8"
      ++ "|token_embed|sort_rank|merge_rank|scatter_perm"
      ++ "|prefix_sum|max_subarray|seg_scan|compact|linrec|gae|ssm_scan"
      ++ "|histogram|cas_swap|erf_sweep|geglu>"
      ++ " [--bytecode <path>] | kernels --bytecode-version")
}

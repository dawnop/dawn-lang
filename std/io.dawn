## The outside world: console, files, environment and subprocesses.
## The file system is the named effect `Fs`, running another program is
## `Proc` and the process environment is `Env`, each with a production handler
## `with_*_real`. The console and ending the process are `!io` today; the
## effects that will carry them, `Console` and `Exit`, are declared below and
## their consumers are a release away. Everything that can fail answers
## `Result[T, ForeignError]` (spec §9.8.1).
#
# These write over the io_* intrinsics, which every backend implements; the
# handwritten dawn.rt.StdIo is retired. They need no `unsafe_pure`: they are
# honestly effectful, so their signatures just say `!io`.
#
# stderr was missing until 2026-07-28, and its absence was not free: the
# compiler's own `errio.dawn` existed to reach `System.err`, a static field
# the `use java` interop cannot name, through a method handle.
#
# `args` is deliberately NOT here: it is the language builtin for whole-program
# startup input, not an `std/io` wrapper. On the JVM argv still lives on the
# program's entry class, but the emitter gives every emitted module (including
# std) that program-known owner so each call names the same field. Parking argv
# on a runtime class instead would make it shared by every program in one JVM —
# see pure-ffi-design.md §十七.
#
# The failing ones compose with `catch_fault`, which is an intrinsic and stays
# in the compiler. That is not a workaround: `Result` is a Dawn ADT and cannot be
# a Java return type, and the barrier is precisely the built-in bridge from "the
# outside world said no" to an `Err`.
#
# That `Err` carries a `ForeignError`, not a String (docs/audit/error-model-design.md
# 六). A rendered message is a dead end for a caller: the only thing it can do
# with one is match on its text, which is what spec §9.8 used to advise and what
# the error model exists to stop. The record hands over `kind` (the backend's own
# name for the failure class), `message` and `cause` separately, so a caller that
# wants to *decide* reads `kind` and a caller that wants to *report* reads
# `message` — neither has to parse. Rendering one back into a line of text is
# still a `to_string(e)` away for whoever actually wants the line.
use std/list
use std/str

## Print a string followed by a newline.
pub fn println(s: String) -> Unit !io = io_println(s)

## Print a string without a newline.
pub fn print(s: String) -> Unit !io = io_print(s)

## Print a string to stderr, followed by a newline.
pub fn eprintln(s: String) -> Unit !io = io_eprintln(s)

## Print a string to stderr without a newline.
pub fn eprint(s: String) -> Unit !io = io_eprint(s)

## End the process with an exit status. Nothing after the call runs.
##
## The result remains `Unit`, as it was when the body was `io_exit` directly:
## `exit_now` answers `Never`, and `Never` is under every type, so the public
## contract this function had before the operation existed is the one it still
## has. What changed is the row -- a caller now owes `!Exit`, and somebody above
## it has to say what ending the process means.
pub fn exit(code: Int) -> Unit !Exit = exit_now(code)

## Read one line from stdin; `None` at end of input.
## The intrinsic maps Java's `null`-or-line straight onto `Option`.
pub fn read_line() -> Option[String] !io = io_read_line()

## Whether `path` names a directory. Invalid host path spellings, including an
## embedded NUL, answer `false` rather than escaping this Bool interface.
pub fn is_dir(path: String) -> Bool !Fs = fs_is_dir(path)

## Whether anything exists at `path` -- a file, a directory, anything. Invalid
## host path spellings, including an embedded NUL, answer `false`.
pub fn exists(path: String) -> Bool !Fs = fs_exists(path)

## Create `path` and every missing directory above it.
## An existing directory is not a failure; an existing *file* is.
pub fn mkdirs(path: String) -> Result[Unit, ForeignError] !Fs = fs_mkdirs(path)

## Read a whole file as a UTF-8 string.
pub fn read_file(path: String) -> Result[String, ForeignError] !Fs = fs_read_file(path)

## Write a string to a file, creating missing parent directories.
## `Ok` carries nothing: the only count worth returning would be bytes on disk.
pub fn write_file(path: String, content: String) -> Result[Unit, ForeignError] !Fs =
  fs_write_file(path, content)

## The process's working directory, as an absolute path.
pub fn cwd() -> String !Env = env_cwd()

## The value of the environment variable `name`, or `None` when it is unset or
## cannot be represented by the host environment API, including an embedded NUL.
pub fn getenv(name: String) -> Option[String] !Env = env_get(name)

## Read a whole file as bytes. The text half is `read_file`.
pub fn read_bytes(path: String) -> Result[Bytes, ForeignError] !Fs = fs_read_bytes(path)

## Write bytes to a file, creating missing parent directories.
pub fn write_bytes(path: String, content: Bytes) -> Result[Unit, ForeignError] !Fs =
  fs_write_bytes(path, content)

## The two normal outcomes of deleting a path. Host failures are not outcomes:
## they stay in `delete`'s `Err` branch.
pub type DeleteOutcome = Deleted | NotFound

## Delete a file or an empty directory. A missing path is `Ok(NotFound)`;
## every other host refusal, including a non-empty directory, is an `Err`.
##
## The empty path and a path ending in `/` are rejected before a backend sees
## them. Hosts normalize those spellings differently, and delete must never
## change which filesystem object the caller named as a side effect of choosing
## a backend.
pub fn delete(path: String) -> Result[DeleteOutcome, ForeignError] !Fs =
  if path == "" {
    Err(ForeignError {
      kind: "io.invalid_delete_path",
      message: "io.delete: path must not be empty",
      cause: None
    })
  } else if str.ends_with(path, "/") {
    Err(ForeignError {
      kind: "io.invalid_delete_path",
      message: "io.delete: path must not end with '/'",
      cause: None
    })
  } else {
    match fs_delete(path) {
      Ok(gone) -> if gone { Ok(Deleted) } else { Ok(NotFound) }
      Err(e) -> Err(e)
    }
  }

## Move `src` onto `dst`, replacing it. Atomic when the two are on one
## filesystem and an error when they are not -- which is the whole point: the
## caller is publishing something it has already verified, and a move that can
## be observed half-done would defeat that. Stage with `temp_dir` under the
## destination's own directory to stay on one filesystem.
pub fn rename(src: String, dst: String) -> Result[Unit, ForeignError] !Fs = fs_rename(src, dst)

## A fresh directory under `parent`, named after `prefix`. An empty `parent`
## means the system temporary directory.
pub fn temp_dir(parent: String, prefix: String) -> Result[String, ForeignError] !Fs =
  fs_temp_dir(parent, prefix)

## A fresh, empty file under `parent`, named after `prefix`. An empty `parent`
## means the system temporary directory.
##
## The host picks the name *and creates the file* in one step (`mkstemp(3)`,
## `Files.createTempFile`), which is the difference that matters: a caller that
## spelled a name and opened it afterwards has a window in which another
## process can put something else -- a symbolic link, say -- at that name. On a
## POSIX host the file arrives readable and writable by its owner alone.
pub fn temp_file(parent: String, prefix: String) -> Result[String, ForeignError] !Fs =
  fs_temp_file(parent, prefix)

## Give `dst` the permissions `src` has.
##
## `src` is inspected without following a link. POSIX hosts copy the mode bits;
## a host with no POSIX permission model copies the read-only flag, which is
## the whole of what it has. Neither copies ACLs or extended attributes.
##
## This exists because publishing by rename loses them: the file that ends up
## at the destination is a *new* file, whose mode came from the call that
## created it and the umask, and nothing else remembers what it replaced.
pub fn copy_permissions(src: String, dst: String) -> Result[Unit, ForeignError] !Fs =
  fs_copy_permissions(src, dst)

## Whether `path` is a symbolic link. The link itself is examined, not its
## target, so a link to a directory is a link and not a directory. Invalid host
## path spellings, including an embedded NUL, answer `false`.
pub fn is_symlink(path: String) -> Bool !Fs = fs_is_symlink(path)

## Write `content` to `path` so that a reader ever only sees the old file or
## the new one, never a half-written one and never nothing at all.
##
## The staging file is created by `temp_file` in the destination's own
## directory -- the host picks its name, so nothing can be squatting on it, and
## the shared directory is what keeps the final `rename` on one filesystem and
## therefore atomic. What is written is read back and compared before anything
## is published, the destination's permissions are carried over when it already
## exists, and only then does a single `rename` install it. Any step that fails
## takes the staging file away and leaves the destination exactly as it was.
##
## What this does **not** promise:
##
## - **Durability.** It orders nothing against a power cut: no `fsync` of the
##   file and none of the directory. The guarantee is about what a *reader*
##   can observe on a running system, which is what a manifest rewrite needs;
##   surviving a crash is a different (and much more expensive) property.
## - **Anything about concurrent writers.** Two of these racing both succeed
##   and the last `rename` wins. Detecting that someone else changed the file
##   since it was read is a compare-and-set, and that is a different primitive
##   with a different signature.
## - **Link identity.** A destination with other hard links to it is detached:
##   this directory entry gets the new file and the other links keep the old
##   one. Writing through to the shared inode is the opposite of what is wanted
##   here -- it is exactly the non-atomic overwrite this replaces.
##
## A destination that *is* a symbolic link is refused rather than followed
## (`io.atomic_write_target_is_symlink`). Following would let whatever placed
## the link choose which file gets written, and a caller publishing a file it
## named is not asking to write wherever that name currently points.
##
## The four failure kinds minted here are `io.invalid_atomic_write_path`,
## `io.atomic_write_target_is_symlink`, `io.atomic_write_staging_failed` and
## `io.atomic_write_verify_failed`; every other `Err` carries whatever the
## backend called the failure, as everywhere else in this module.
##
## `io.atomic_write_staging_failed` is the one place that rewrites a backend
## message instead of passing it on, and it earns the exception: the failure is
## about a randomly named file this function invented, so passing it on would
## name that file to a caller who never asked for it. The backend's own words
## are kept in `cause`.
pub fn atomic_write_file(path: String, content: String) -> Result[Unit, ForeignError] !Fs =
  if path == "" {
    Err(ForeignError {
      kind: "io.invalid_atomic_write_path",
      message: "io.atomic_write_file: path must not be empty",
      cause: None
    })
  } else if str.ends_with(path, "/") {
    Err(ForeignError {
      kind: "io.invalid_atomic_write_path",
      message: "io.atomic_write_file: path must not end with '/'",
      cause: None
    })
  } else if is_symlink(path) {
    Err(ForeignError {
      kind: "io.atomic_write_target_is_symlink",
      message: "io.atomic_write_file: refusing to replace a symbolic link: " ++ path,
      cause: None
    })
  } else {
    match temp_file(parent_dir(path), ".dawn-atomic-") {
      # The staging file is this function's own device, and its name is a
      # random one nobody asked for. Passing the backend's message through
      # verbatim -- the way every other failure here does -- would put that
      # name in front of a caller who never created it: `dawn lock` into an
      # unwritable directory used to report a `.dawn-atomic-...tmp` it had
      # never heard of. So this one failure is re-attributed to the directory
      # that actually refused, and the backend's own words move to `cause`,
      # which is where the layer below belongs (spec §9.8.1).
      Err(e) -> Err(ForeignError {
        kind: "io.atomic_write_staging_failed",
        message: "io.atomic_write_file: cannot create a staging file in "
          ++ parent_dir(path),
        cause: Some(e.kind ++ ": " ++ e.message)
      })
      Ok(tmp) -> stage_replace(path, content, tmp)
    }
  }

## The directory `path` names a file in. Not a general path library: it answers
## the one question `atomic_write_file` asks, which is where to stage, and a
## staging directory that is merely *equivalent* to the destination's is enough
## for both properties wanted of it -- same filesystem, and reachable.
fn parent_dir(path: String) -> String =
  match str.last_index_of(path, "/") {
    None -> "."
    Some(i) -> if i == 0 { "/" } else { str.slice(path, 0, i) }
  }

## Everything after the staging file exists. Split out because every failure
## from here on has to take that file away again, and a single expression with
## five nested `match`es would have five copies of the same cleanup.
fn stage_replace(path: String, content: String, tmp: String) -> Result[Unit, ForeignError] !Fs =
  match write_file(tmp, content) {
    Err(e) -> abandon(tmp, e)
    Ok(_) ->
      match read_bytes(tmp) {
        Err(e) -> abandon(tmp, e)
        Ok(seen) ->
          # Read back, rather than trust the write: `write_file` reports what
          # the host accepted, and a host can accept bytes it did not keep --
          # a short write on a full filesystem is the ordinary way. The
          # comparison is on bytes and not on the string, because the string
          # would come back through a decoder that replaces what it cannot
          # read, and a corruption that decodes to the same text is still a
          # corruption. `bytes_utf8` is the intrinsic behind `std/bytes.utf8`,
          # spelled directly so this module gains no import for one call.
          if seen != bytes_utf8(content) {
            abandon(tmp, ForeignError {
              kind: "io.atomic_write_verify_failed",
              message: "io.atomic_write_file: the staged file did not read back " ++
                "as it was written: " ++ path,
              cause: None
            })
          } else {
            match carry_permissions(path, tmp) {
              Err(e) -> abandon(tmp, e)
              Ok(_) ->
                match rename(tmp, path) {
                  Err(e) -> abandon(tmp, e)
                  Ok(_) -> Ok(())
                }
            }
          }
      }
  }

## Carry the destination's permissions onto the staging file, when there is a
## destination to carry them from. A path that does not exist yet has no mode
## to preserve, and the new file keeps the one its creation gave it.
fn carry_permissions(path: String, tmp: String) -> Result[Unit, ForeignError] !Fs =
  if exists(path) { copy_permissions(path, tmp) } else { Ok(()) }

## Give up: take the staging file away and hand back the failure that caused
## it. The delete's own outcome is dropped on purpose -- the caller is being
## told why the write did not happen, and replacing that with "and also the
## cleanup failed" would lose the reason.
fn abandon(tmp: String, e: ForeignError) -> Result[Unit, ForeignError] !Fs = {
  let _ = delete(tmp)
  Err(e)
}

## Exactly `n` bytes of standard input, shorter only at end of input -- so a
## short read is how end of input is reported.
##
## This reads the stream directly while `read_line` reads a buffered reader
## over it. A program that used both would lose whatever the reader had already
## buffered; pick one.
pub fn read_stdin(n: Int) -> Bytes !io = io_read_stdin(n)

## Whether at least one byte of standard input can be read right now, waiting
## up to `timeout_ms` for one to arrive.
##
## **End of input is not readiness.** When the writer has gone away this
## answers `false`, exactly as a silent-but-open stream does; the difference
## is reported by `read_stdin`, which stays the only reader. A loop driven by
## this alone would therefore spin once its input ended -- the third branch is
## not optional:
##
##     if have_work_pending {
##       if stdin_ready(window) { read a message } else { do the work }
##     } else {
##       read a message          # nothing to do, so blocking is the right thing
##     }
##
## `timeout_ms` is an upper bound, not a lower one. Returning `false` early is
## always allowed -- a regular file at end of input answers immediately -- and
## it is safe because the only thing a caller may do with `false` is stop
## waiting. `true` is the answer that is never given on a guess.
pub fn stdin_ready(timeout_ms: Int) -> Bool !io = io_stdin_ready(timeout_ms)

## The entry names directly under `path`, sorted in code-point order.
## A non-directory is reported as an `Err`, not a panic, and — matching the old
## behaviour — is checked before anything is read, so a missing path and a plain
## file give the same message.
##
## The sort happens here, not in the backends: the `io_list_names` intrinsic
## answers whatever order the OS gave, and one `list.sort` over the language's
## own `Ord[String]` is what makes every backend agree.
##
## Its `kind` is `"io.not_a_directory"`, one of the three failure kinds std
## mints itself (`run`'s `io.no_program` and `delete`'s
## `io.invalid_delete_path` are the others): every other one in this module is
## whatever the backend called it, and this failure never reaches a backend,
## because the check happens first. It is spelled as a name rather than a
## sentence for the same reason every other `kind` is — a caller may match on it.
pub fn list_dir(path: String) -> Result[List[String], ForeignError] !Fs =
  if is_dir(path) {
    match fs_list_names(path) {
      Ok(names) -> Ok(list.sort(names))
      Err(e) -> Err(e)
    }
  } else {
    Err(ForeignError {
      kind: "io.not_a_directory",
      message: "not a directory: " ++ path,
      cause: None
    })
  }

## Run `argv[0]` (found on PATH) with `argv` as its arguments, wait for it, and
## answer its exit status. A non-zero status is not an error -- it is the
## answer; an `Err` means the program could not be started at all.
##
## Each stream goes to the file named by its path, truncating it, and an empty
## path leaves that stream pointing wherever this process's already points.
## Files rather than pipes: see the note on the `io_run` intrinsic.
##
## An empty `argv` is `"io.no_program"`, another failure kind std mints itself,
## and for `list_dir`'s reason: the check happens first, so the failure never
## reaches a backend and every backend words it the same.
pub fn run(argv: List[String], out_path: String, err_path: String) -> Result[Int, ForeignError] !Proc =
  if len(argv) == 0 {
    Err(ForeignError {
      kind: "io.no_program",
      message: "io.run: argv is empty, so there is no program to run",
      cause: None
    })
  } else {
    proc_run(argv, out_path, err_path)
  }

# ---- the file system as a named effect ----
#
# The file functions above are the public face of the operations below: one
# operation per host primitive, answered in production by `with_fs_real` and
# in a test by arms over a table. `Fs` is the first `effect` std declares, and
# the shape is the one dawnop-site's Clock and Upstream effects settled: a
# plain declaration, a plain wrapper function as the default handler, and no
# language support beyond `with handle`.
#
# The seam sits BELOW the error surface on purpose, as Upstream's does. An
# arm answers with the raw `ForeignError` the host would have raised, not with
# a finished outcome, so `delete`'s spelling checks and its `DeleteOutcome`,
# `list_dir`'s sort and its `io.not_a_directory`, and the whole staging
# protocol of `atomic_write_file` stay the code under test when a fake
# answers. That is also why there are fourteen operations and not fifteen:
# `atomic_write_file` is composed of the others and has no primitive of its own.
#
# No operation declares effects of its own (spec §6.5): what an arm does is
# charged where the handler is installed, and `with_fs_real` is `!io`.
#
# The declaration shipped one release before the functions moved onto it:
# the compiler and the differential corpora are built by the previous
# release's toolchain against the std it shipped with (docs/bootstrap.md, the
# seed feature discipline), so a std that had renamed the row and a compiler
# that spelled the old one could not have met.

## The file system, as operations a handler answers. Names carry an `fs_`
## prefix because `use std/io.{Fs}` brings every operation into the importing
## module's own namespace (spec §6.5), where `mkdirs` or `read_bytes` is a
## name a module may well have taken for a helper of its own.
##
## The Bool queries answer `false` for whatever the host cannot spell, as
## their `io.*` twins do; everything else answers `Result`, with an `Err` for
## what the host refused. `fs_delete` answers whether something was removed
## (`true`) or was already absent (`false`); `fs_list_names` answers the
## entries in whatever order the host gave them.
pub effect Fs {
  fn fs_is_dir(path: String) -> Bool
  fn fs_exists(path: String) -> Bool
  fn fs_is_symlink(path: String) -> Bool
  fn fs_mkdirs(path: String) -> Result[Unit, ForeignError]
  fn fs_read_file(path: String) -> Result[String, ForeignError]
  fn fs_write_file(path: String, content: String) -> Result[Unit, ForeignError]
  fn fs_read_bytes(path: String) -> Result[Bytes, ForeignError]
  fn fs_write_bytes(path: String, content: Bytes) -> Result[Unit, ForeignError]
  fn fs_delete(path: String) -> Result[Bool, ForeignError]
  fn fs_rename(src: String, dst: String) -> Result[Unit, ForeignError]
  fn fs_temp_dir(parent: String, prefix: String) -> Result[String, ForeignError]
  fn fs_temp_file(parent: String, prefix: String) -> Result[String, ForeignError]
  fn fs_copy_permissions(src: String, dst: String) -> Result[Unit, ForeignError]
  fn fs_list_names(path: String) -> Result[List[String], ForeignError]
}

## Run `body` against the real file system. Every arm is the host primitive
## behind the `io.*` function of the same name, through the barrier that used
## to sit inside the function.
##
## This is the production handler: a program's `main` (or the innermost
## boundary that owns a whole unit of file work) installs it once, and
## everything beneath sees `Fs`. A test installs arms of its own instead.
pub fn with_fs_real[T](body: fn() -> T !Fs !io) -> T !io = {
  with handle Fs {
    fs_is_dir(path) => io_is_dir(path)
    fs_exists(path) => io_exists(path)
    fs_is_symlink(path) => io_is_symlink(path)
    fs_mkdirs(path) => catch_fault(() => io_mkdirs(path))
    fs_read_file(path) => catch_fault(() => io_read_file(path))
    fs_write_file(path, content) => catch_fault(() => io_write_file(path, content))
    fs_read_bytes(path) => catch_fault(() => io_read_bytes(path))
    fs_write_bytes(path, content) => catch_fault(() => io_write_bytes(path, content))
    fs_delete(path) => catch_fault(() => io_delete(path))
    fs_rename(src, dst) => catch_fault(() => io_rename(src, dst))
    fs_temp_dir(parent, prefix) => catch_fault(() => io_temp_dir(parent, prefix))
    fs_temp_file(parent, prefix) => catch_fault(() => io_temp_file(parent, prefix))
    fs_copy_permissions(src, dst) => catch_fault(() => io_copy_permissions(src, dst))
    fs_list_names(path) => catch_fault(() => io_list_names(path))
  }
  body()
}

# ---- running a program as a named effect ----
#
# `run` above is the public face of the one operation below, on the shape the
# `Fs` block settled: a plain declaration, a plain wrapper function as the
# production handler, and the seam below the error surface. An arm answers the
# raw `ForeignError` a host refusal would have carried rather than a finished
# outcome, so `run`'s own empty-argv check and the `io.no_program` it mints
# stay the code under test when a fake answers.
#
# One operation, not four. `exit`, `cwd` and `getenv` were set aside here on
# the rule that an operation is worth its label only where it makes an
# assertion writable that is not writable today. All three were later found to
# fail that rule rather than pass it: `cwd` and `getenv` are `Env` below, and
# `exit` is `Exit` below, declared alongside `Console` because a CLI failure
# is a status and a line and neither half is the assertion on its own.
# `args` does not join `Proc`: it remains the language
# builtin for immutable whole-program startup input, not a handler operation
# or wrapper owned by this module. Its JVM field still lives on the program's
# entry class, and every emitted module names that same program-known owner
# (the note at the top of this file).
#
# What such a handler sees is narrower than what an `Fs` handler sees, and the
# difference is worth stating rather than discovering. The file system belongs
# to `Fs` because this module is the only way a Dawn program reaches it. A
# process is not like that: `io_run` waits for a child and sends each stream to
# a file, and a caller that wants an environment, an inherited console, a
# handle or a deadline reaches past this module for `ProcessBuilder` or
# `posix_spawn` directly. Nothing on that path passes through an arm here.
#
# The wrapper's body row is `!e` rather than a closed `!(Proc | io)`, and that
# is not decoration. A closed row can only be the outermost wrapper:
# `with_fs_real`'s is closed, so `with_proc_real(() => with_fs_real(...))` does
# not check, and with a closed row here neither would the order that does. The
# first test below is that claim, made machine-checked. A new wrapper in this
# module takes `!e`; `with_fs_real` keeps the closed row it has until something
# needs to sit outside it, because widening it costs a release.
#
# As with `Fs`, the declaration shipped one release before anything moved onto
# it (docs/bootstrap.md, the seed feature discipline). `run` is that caller
# now: it forwards to `proc_run`, and the empty-argv check stays above the
# operation so an arm is never handed an argv with no program in it.

## Running another program, as the one operation a handler answers. The name
## carries a `proc_` prefix for the reason the `fs_` ones do: `use
## std/io.{Proc}` brings the operation into the importing module's own
## namespace (spec §6.5), where `run` is a name a module may well have taken.
##
## The arguments are `run`'s, and so is the answer: an exit status for a child
## that ran, an `Err` for one that could not be started. Nothing here declares
## effects of its own (spec §6.5); what an arm does is charged where the
## handler is installed.
pub effect Proc {
  fn proc_run(argv: List[String], out_path: String, err_path: String) -> Result[Int, ForeignError]
}

## Run `body` against real processes. The arm is the host primitive behind
## `run`, through the barrier that sits inside `run` today.
##
## This is the production handler: a program installs it at the boundary that
## owns a whole unit of work, and everything beneath sees `Proc`. A test
## installs an arm of its own instead.
pub fn with_proc_real[T, !e](body: fn() -> T !Proc !e) -> T !io = {
  with handle Proc {
    proc_run(argv, out_path, err_path) =>
      catch_fault(() => io_run(argv, out_path, err_path))
  }
  body()
}

# ---- the process environment as a named effect ----
#
# `cwd` and `getenv` above are the public face of the two operations below, on
# the shape `Fs` settled and `Proc` repeated: a plain declaration, a plain
# wrapper function as the production handler, and the seam below the error
# surface. There is no `Result` here to put the seam under, and there does not
# need to be: `env_get` answers `Option[String]`, so an unset name and a name
# the host cannot represent are values a caller branches on, and whatever a
# caller does with `None` stays the code under test when a fake answers.
#
# Two operations, and they are the pair the `Proc` block set aside. What
# changed is not their price but what the tree turned out to be doing with
# them unlabelled: `pkgfetch.cache_root`'s three branches,
# `nmain.cc_command`'s four, and `c/cdriver.mode_flips_from_env` all read the
# environment, all decide something, and none of them has a single assertion.
# That is not an oversight anyone can fix in place, because there is no
# `setenv` and no `chdir` in this language to write one with -- the only way
# to ask what a function does with an environment is to be the environment.
# `exit` is not here: its assertion is a different shape, and it arrives with
# `Console`. Both are the two blocks below this one.
#
# `args` does not join, for the reason the `Proc` block gives about it: it is
# the language builtin for immutable whole-program startup input, and its JVM
# field lives on the program's own entry class.
#
# The wrapper's body row is `!e` rather than a closed `!(Env | io)`, for the
# reason `with_proc_real`'s is. A closed row can only be the outermost
# wrapper, and this one is meant to be the innermost of three: a program
# installs `with_fs_real`, then `with_proc_real`, then this. The third test
# below is that claim, made machine-checked rather than remembered.
#
# As with `Fs` and `Proc`, the declaration shipped one release before anything
# moved onto it (docs/bootstrap.md, the seed feature discipline). `cwd` and
# `getenv` are those callers now: each forwards to the operation of the same
# meaning, and neither reaches `io_cwd` or `io_getenv` anywhere but in the
# production handler's arms.

## The process environment, as the two operations a handler answers. The names
## carry an `env_` prefix for the reason the `fs_` and `proc_` ones do: `use
## std/io.{Env}` brings every operation into the importing module's own
## namespace (spec §6.5), where `cwd` and `get` are names a module may well
## have taken for something of its own.
##
## `env_get` answers `None` for a name the host has no value for and for one
## it cannot represent, including an embedded NUL, as its `io.*` twin does.
## Nothing here declares effects of its own (spec §6.5); what an arm does is
## charged where the handler is installed.
pub effect Env {
  fn env_cwd() -> String
  fn env_get(name: String) -> Option[String]
}

## Run `body` against the real process environment. Each arm is the host
## primitive behind the `io.*` function of the same meaning.
##
## This is the production handler: a program installs it at the boundary that
## owns a whole unit of work, innermost of the three this module offers, and
## everything beneath sees `Env`. A test installs arms of its own instead.
pub fn with_env_real[T, !e](body: fn() -> T !Env !e) -> T !io = {
  with handle Env {
    env_cwd() => io_cwd()
    env_get(name) => io_getenv(name)
  }
  body()
}

# ---- ending the process as a named effect ----
#
# `exit` above is the public face of the one operation below, and it is the
# first effect this module declares `ctl`. What forces that is what an arm has
# to be able to do: end the block. A tail-resumptive arm always comes back, so
# a handler answering `exit` could only imitate the ending with a `panic` and
# a `catch_panic` around it, which puts an exit status on the error surface
# and makes a test read it back out of a message. A control arm has no such
# problem: the arm's value is the value of the whole `with handle` block, and
# the block remainder after the suspension point does not run (spec §6.5).
# That is `exit`'s own documented behaviour, "Nothing after the call runs",
# written as a type rather than as a sentence.
#
# The operation answers `Never`, which is legal exactly here: `Never` is
# return-only, and an effect operation's return position is one of the places
# it may be written (spec §2). `io.exit` keeps its `Unit` signature, because
# `io_exit` is the existing void intrinsic ABI and naming `Never` on an
# operation does not change that public contract.
#
# The production arm drops `k` bare rather than handing it to `discard`, for
# three reasons that agree. `discard(k)` cannot be typed here at all: `k` is
# `fn(Never) -> T`, `discard`'s type parameter lands on `Never`, and nothing
# infers it ("cannot infer type parameter(s) T for `discard`"). Spelled over
# an operation returning `Unit` so that it can be typed, `discard` charges
# `!io` on the wrapper for a reason unrelated to the host: `k`'s row is the
# block remainder's row, so unwinding owes what resuming owes. And the two
# behaviours are not equal anyway -- `discard` runs every `bracket` release
# under the suspension and `System.exit` runs none of them, so an arm that
# ran them would be the one misreporting what the host does.
#
# One operation. A status is an `Int` and there is nothing underneath it for a
# seam to sit below, so this block has no error surface to be careful about
# the way the three above it do.
#
# The wrapper's body row is `!e`, for the reason `with_proc_real`'s and
# `with_env_real`'s are: only `with_fs_real`'s row is closed, and only a
# closed row has to be outermost.
#
# `io.exit` is the one caller: its body is `exit_now(code)`, so every process
# that ends does it through this effect and the primitive is reachable from
# nowhere else in the tree.

## Ending the process, as the one operation a handler answers. The name
## carries an `exit_` prefix for the reason the `fs_`, `proc_` and `env_` ones
## do: `use std/io.{Exit}` brings the operation into the importing module's
## own namespace (spec §6.5), and here the bare name is taken by this very
## module.
##
## `ctl` is what licenses an arm to bind the continuation instead of resuming
## it (spec §6.5), and it is what this effect is for: an arm that does not
## resume is how a process ends. The answer type is `Never` because a caller
## has no answer to read, and an arm that ends the block owes none.
pub ctl effect Exit {
  fn exit_now(code: Int) -> Never
}

## Run `body` on a host that can really end this process. The arm calls the
## exit primitive and never resumes, so nothing after a call to `exit_now`
## runs, here or anywhere below.
##
## This is the production handler: a program installs it at the boundary that
## owns a whole unit of work, and everything beneath sees `Exit`. A test
## installs an arm that answers the status as a value instead, and the test
## process goes on running.
pub fn with_exit_real[T, !e](body: fn() -> T !Exit !e) -> T !io = {
  with handle Exit {
    exit_now(code) resume k => {
      io_exit(code)
      panic("io.exit returned")
    }
  }
  body()
}

# ---- the console as a named effect ----
#
# The four print functions above are the public face of the four operations
# below, on the shape the effects above settled: a plain declaration, a plain
# wrapper function as the production handler, one operation per host
# primitive. There is no error surface to put a seam below here. A host that
# refuses a write does not tell these primitives about it, and the `Unit` an
# operation answers is the `Unit` the function answers.
#
# Four operations, not two and not one. stdout and stderr are different
# destinations and which one a diagnostic went to is precisely the assertion
# this effect exists to make, so the destination is in the operation name
# rather than in an argument a handler would have to branch on. Print and
# print-with-newline stay apart for the reason they are apart in the public
# functions: a handler that collects lines has to be told where a line ended.
#
# `read_line` and the rest of stdin do not join. They are the console read the
# other way round, and an operation is worth its label where it makes an
# assertion writable that is not writable today; no test in either tree asks
# what a program read from a terminal.
#
# `Exit` and `Console` are declared together because the assertion that wants
# them wants both halves. `main.cli_error`, `nmain.cli_error` and the six
# `fail_*` wrappers print one diagnostic and then end the process: the status
# is `Exit`'s half, the line is `Console`'s, and either alone reads back half
# of a CLI failure. `scripts/native-cli-diff.sh` is 913 lines of exactly those
# cases, run out of process because in process there was nothing to observe
# them with; a table over both effects is what brings them inside a test
# block, and that is the point of the pair.
#
# This is also the first effect in this module with consumers inside `std`
# itself (`std/reactor.serve`) and inside a bundled package
# (`packages/web`'s logging middleware), which `Fs`, `Proc` and `Env` do not
# have. Nothing about that changes this knife, which declares and moves
# nobody, but it is the reason the next one is larger than theirs.
#
# The wrapper's body row is `!e`, as `with_exit_real`'s is and for the same
# reason.
#
# What no test in this module can say: the four production arms are one-liners
# onto the host primitives, and a process cannot read back its own console.
# `Fs` can be checked against itself (a file is written and read again) and so
# can `Env` (`env_cwd() == cwd()`), but write `console_eprintln(s) =>
# io_println(s)` here and every test in this file still passes. Two things
# stand in for the assertion, and neither is one. The table handler below
# fixes what an arm is supposed to mean, because it records the stream and the
# line ending separately. And `scripts/native-cli-diff.sh` compares the whole
# `dawn test --stdlib` transcript byte for byte across the two backends, which
# catches one backend's arms disagreeing with the other's but not both being
# wrong the same way. The first real assertion on this seam is knife 2's
# `consolemem` clients, where a diagnostic read back off the wrong stream is a
# failing test.
#
# As with the three effects above, the declaration ships one release before
# anything moves onto it (docs/bootstrap.md, the seed feature discipline).
# `print`, `println`, `eprint` and `eprintln` are unchanged here and still
# reach `io_print` and its three siblings themselves.

## The console, as the four operations a handler answers. The names carry a
## `console_` prefix for the reason the `fs_`, `proc_` and `env_` ones do:
## `use std/io.{Console}` brings every operation into the importing module's
## own namespace (spec §6.5), and here all four bare names are taken by this
## very module.
##
## Each operation is one host write. The pairing is the public functions':
## `console_println` and `console_eprintln` end the line, `console_print` and
## `console_eprint` do not, and the `e` names write to stderr. Nothing here
## declares effects of its own (spec §6.5); what an arm does is charged where
## the handler is installed.
pub effect Console {
  fn console_print(s: String) -> Unit
  fn console_println(s: String) -> Unit
  fn console_eprint(s: String) -> Unit
  fn console_eprintln(s: String) -> Unit
}

## Run `body` against the real console. Each arm is the host primitive behind
## the `io.*` function of the same meaning.
##
## This is the production handler: a program installs it at the boundary that
## owns a whole unit of work, and everything beneath sees `Console`. A test
## installs arms of its own instead, and can then say what a program printed
## and which stream it went to.
pub fn with_console_real[T, !e](body: fn() -> T !Console !e) -> T !io = {
  with handle Console {
    console_print(s) => io_print(s)
    console_println(s) => io_println(s)
    console_eprint(s) => io_eprint(s)
    console_eprintln(s) => io_eprintln(s)
  }
  body()
}

# What these blocks may and may not assert is decided by one fact: `kind` is
# whatever the backend called the failure. On the JVM a missing file is
# `java.nio.file.NoSuchFileException`; a second backend has no reason to spell
# it the same, and `dawn test --stdlib` is run under both with the reports
# compared byte for byte (scripts/native-cli-diff.sh). So a failure that
# reaches a backend is asserted to *be* an `Err` and nothing more.
#
# The exceptions are `list_dir`'s `io.not_a_directory`, `run`'s
# `io.no_program`, and `delete`'s `io.invalid_delete_path`, which std mints
# itself above the barrier and which are the same string on every backend --
# and being match-able is the whole reason they are names rather than
# sentences, so they are the `kind`s worth pinning.
#
# `Unit` has no equality, so `Result[Unit, ForeignError]` cannot be compared
# with `==` and the blocks below carry a local `ok` lambda instead of a
# module-level helper -- a private `fn` here would be dead code in every build
# that is not `dawn test --stdlib`, and would show up in std/io's own Core.
#
# Each block makes its own temp directory and takes it away again. Nothing here
# reads the repository: a test that depends on the tree it is run from breaks
# when the tree moves, and these run from wherever the runner was started.

test "temp_dir makes a fresh directory, and a file round trips through it" {
  with_fs_real(() => {
    let ok = (r: Result[Unit, ForeignError]) => match r {
      Ok(_) -> true
      Err(_) -> false
    }
    let made = (r: Result[String, ForeignError]) => match r {
      Ok(p) -> p
      Err(_) -> ""
    }
    let d = made(temp_dir("", "dawn-std-test-"))
    assert d != ""
    assert exists(d)
    assert is_dir(d)
    # fresh: a second call is a different directory, not the same one again
    let d2 = made(temp_dir("", "dawn-std-test-"))
    assert d2 != ""
    assert d != d2
    # and `parent` is honoured, so a caller can stage on one filesystem
    let inner = made(temp_dir(d, "inner-"))
    assert inner != ""
    assert is_dir(inner)

    let f = d ++ "/hello.txt"
    assert not exists(f)
    assert ok(write_file(f, "hello"))
    assert exists(f)
    assert not is_dir(f)
    assert read_file(f) == Ok("hello")
    # overwriting is not appending
    assert ok(write_file(f, "again"))
    assert read_file(f) == Ok("again")
    assert ok(write_file(f, ""))
    assert read_file(f) == Ok("")
    # missing parents are created on the way
    let nested = d ++ "/a/b/c.txt"
    assert ok(write_file(nested, "deep"))
    assert read_file(nested) == Ok("deep")
    assert is_dir(d ++ "/a/b")

    assert delete(f) == Ok(Deleted)
    assert delete(nested) == Ok(Deleted)
    assert delete(d ++ "/a/b") == Ok(Deleted)
    assert delete(d ++ "/a") == Ok(Deleted)
    assert delete(inner) == Ok(Deleted)
    assert delete(d) == Ok(Deleted)
    assert delete(d2) == Ok(Deleted)
    assert not exists(d)
  })
}

test "a path that is not there is an Err, and never a panic" {
  with_fs_real(() => with_env_real(() => {
    let made = (r: Result[String, ForeignError]) => match r {
      Ok(p) -> p
      Err(_) -> ""
    }
    let d = made(temp_dir("", "dawn-std-test-"))
    # spec 9.8.1: the outside world saying no is a value, so every one of these
    # is a branch the caller takes. Which failure it was is the backend's word
    # and is not asserted here -- on the JVM these are java.nio names, and a
    # second backend has no reason to spell them the same.
    match read_file(d ++ "/nope.txt") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    match read_bytes(d ++ "/nope.bin") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    match rename(d ++ "/nope", d ++ "/x") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    # a directory is not a file, in both directions
    match read_file(d) {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    match write_file(d, "x") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    # ... and the queries that answer Bool rather than Result just say no
    assert not exists(d ++ "/nope")
    assert not is_dir(d ++ "/nope")
    assert not is_symlink(d ++ "/nope")
    let nul_path = d ++ "\u{0}suffix"
    assert not exists(nul_path)
    assert not is_dir(nul_path)
    assert not is_symlink(nul_path)
    assert is_dir(d)
    assert delete(d ++ "/nope") == Ok(NotFound)
    assert getenv("DAWN_STD_TEST_DEFINITELY_UNSET_VARIABLE") == None
    assert getenv("DAWN_STD_TEST\u{0}INVALID_VARIABLE") == None
    # cwd is somewhere, and it is a directory
    assert cwd() != ""
    assert is_dir(cwd())
    assert delete(d) == Ok(Deleted)
  }))
}

test "list_dir sorts by code point, and names a non-directory itself" {
  with_fs_real(() => {
    let ok = (r: Result[Unit, ForeignError]) => match r {
      Ok(_) -> true
      Err(_) -> false
    }
    let made = (r: Result[String, ForeignError]) => match r {
      Ok(p) -> p
      Err(_) -> ""
    }
    let d = made(temp_dir("", "dawn-std-test-"))
    let nothing: List[String] = []
    assert list_dir(d) == Ok(nothing)
    assert ok(write_file(d ++ "/zeta", "1"))
    assert ok(write_file(d ++ "/Alpha", "1"))
    assert ok(write_file(d ++ "/mid", "1"))
    # not the order the OS handed over, and not case-insensitive: 'A' is 65
    assert list_dir(d) == Ok(["Alpha", "mid", "zeta"])
    assert delete(d ++ "/zeta") == Ok(Deleted)
    assert delete(d ++ "/Alpha") == Ok(Deleted)
    assert delete(d ++ "/mid") == Ok(Deleted)

    # The clause the sort exists for. In code-point order U+FFFD (65533) comes
    # before U+1F600 (128512); in UTF-16 unit order it does not, because the
    # astral name begins with the surrogate 0xD83D (55357). A backend sorting
    # its own way -- `Arrays.sort` is UTF-16 units -- answers these two the
    # other way round, which is why the sort is in std and not below it.
    assert ok(write_file(d ++ "/\u{1F600}", "1"))
    assert ok(write_file(d ++ "/\u{FFFD}", "1"))
    assert list_dir(d) == Ok(["\u{FFFD}", "\u{1F600}"])
    assert delete(d ++ "/\u{1F600}") == Ok(Deleted)
    assert delete(d ++ "/\u{FFFD}") == Ok(Deleted)

    # the one kind std mints, so the one a caller may match on
    assert ok(write_file(d ++ "/plain.txt", "1"))
    match list_dir(d ++ "/plain.txt") {
      Ok(_) -> { assert false }
      Err(e) -> { assert e.kind == "io.not_a_directory" }
    }
    # a missing path is the same answer as a plain file: the check happens before
    # anything is read, so the two are deliberately not told apart
    match list_dir(d ++ "/nope") {
      Ok(_) -> { assert false }
      Err(e) -> { assert e.kind == "io.not_a_directory" }
    }
    assert delete(d ++ "/plain.txt") == Ok(Deleted)
    assert delete(d) == Ok(Deleted)
  })
}

test "mkdirs is idempotent on a directory; delete says what it removed" {
  with_fs_real(() => {
    let ok = (r: Result[Unit, ForeignError]) => match r {
      Ok(_) -> true
      Err(_) -> false
    }
    let made = (r: Result[String, ForeignError]) => match r {
      Ok(p) -> p
      Err(_) -> ""
    }
    let d = made(temp_dir("", "dawn-std-test-"))
    # every missing directory above it, in one call
    assert ok(mkdirs(d ++ "/m1/m2"))
    assert is_dir(d ++ "/m1")
    assert is_dir(d ++ "/m1/m2")
    # an existing directory is not a failure
    assert ok(mkdirs(d ++ "/m1/m2"))
    assert ok(mkdirs(d))
    # an existing *file* is
    assert ok(write_file(d ++ "/f.txt", "x"))
    assert not ok(mkdirs(d ++ "/f.txt"))

    # Missing is a normal outcome. A non-empty directory is a host refusal, not
    # another spelling of absence, and delete never empties it for the caller.
    assert delete(d ++ "/nope") == Ok(NotFound)
    match delete(d ++ "/m1") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    assert is_dir(d ++ "/m1")
    assert delete(d ++ "/m1/m2") == Ok(Deleted)
    assert delete(d ++ "/m1") == Ok(Deleted)
    assert not exists(d ++ "/m1")
    assert delete(d ++ "/f.txt") == Ok(Deleted)
    assert delete(d ++ "/f.txt") == Ok(NotFound)
    assert delete(d) == Ok(Deleted)
  })
}

test "delete rejects ambiguous path spellings without changing the target" {
  with_fs_real(() => {
    let ok = (r: Result[Unit, ForeignError]) => match r {
      Ok(_) -> true
      Err(_) -> false
    }
    let made = (r: Result[String, ForeignError]) => match r {
      Ok(p) -> p
      Err(_) -> ""
    }
    let d = made(temp_dir("", "dawn-std-test-"))
    let f = d ++ "/kept"
    assert ok(write_file(f, "x"))

    match delete("") {
      Ok(_) -> { assert false }
      Err(e) -> {
        assert e.kind == "io.invalid_delete_path"
        assert e.message == "io.delete: path must not be empty"
      }
    }
    assert exists(f)

    match delete(f ++ "/") {
      Ok(_) -> { assert false }
      Err(e) -> {
        assert e.kind == "io.invalid_delete_path"
        assert e.message == "io.delete: path must not end with '/'"
      }
    }
    assert exists(f)

    # A backend may name this failure differently, but it must reject the whole
    # path rather than silently delete the prefix before the NUL.
    match delete(f ++ "\u{0}suffix") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    assert exists(f)
    assert delete(f) == Ok(Deleted)
    assert delete(d) == Ok(Deleted)
  })
}

test "rename replaces the destination; bytes survive what a String need not" {
  with_fs_real(() => {
    let ok = (r: Result[Unit, ForeignError]) => match r {
      Ok(_) -> true
      Err(_) -> false
    }
    let made = (r: Result[String, ForeignError]) => match r {
      Ok(p) -> p
      Err(_) -> ""
    }
    let d = made(temp_dir("", "dawn-std-test-"))
    assert ok(write_file(d ++ "/src.txt", "moved"))
    assert ok(rename(d ++ "/src.txt", d ++ "/dst.txt"))
    assert not exists(d ++ "/src.txt")
    assert read_file(d ++ "/dst.txt") == Ok("moved")
    # onto an existing destination: replaced, not refused
    assert ok(write_file(d ++ "/src.txt", "second"))
    assert ok(rename(d ++ "/src.txt", d ++ "/dst.txt"))
    assert read_file(d ++ "/dst.txt") == Ok("second")
    assert not exists(d ++ "/src.txt")
    assert not ok(rename(d ++ "/nope", d ++ "/dst.txt"))

    # the byte pair is the point: 0x00 0xFF is not UTF-8, so this round trip is
    # one `read_file`/`write_file` could not make
    let raw = bytes_from_array(array_push(array_push(array_new(), 0x00), 0xFF))
    assert ok(write_bytes(d ++ "/raw.bin", raw))
    assert read_bytes(d ++ "/raw.bin") == Ok(raw)
    let none_at_all = bytes_from_array(array_new())
    assert ok(write_bytes(d ++ "/empty.bin", none_at_all))
    assert read_bytes(d ++ "/empty.bin") == Ok(none_at_all)
    # and the two halves see the same file
    assert ok(write_file(d ++ "/text.txt", "abc"))
    assert read_bytes(d ++ "/text.txt") == Ok(bytes_utf8("abc"))

    assert delete(d ++ "/dst.txt") == Ok(Deleted)
    assert delete(d ++ "/raw.bin") == Ok(Deleted)
    assert delete(d ++ "/empty.bin") == Ok(Deleted)
    assert delete(d ++ "/text.txt") == Ok(Deleted)
    assert delete(d) == Ok(Deleted)
  })
}

test "run answers the exit status; a program that cannot start is an Err" {
  with_fs_real(() => with_proc_real(() => {
    let ok = (r: Result[Unit, ForeignError]) => match r {
      Ok(_) -> true
      Err(_) -> false
    }
    let made = (r: Result[String, ForeignError]) => match r {
      Ok(p) -> p
      Err(_) -> ""
    }
    let d = made(temp_dir("", "dawn-std-test-"))
    # `sh` rather than a coreutil, because POSIX guarantees it is on PATH
    assert run(["sh", "-c", "exit 0"], "", "") == Ok(0)
    # a non-zero status is the answer, not a failure -- the distinction this
    # signature exists to make
    assert run(["sh", "-c", "exit 3"], "", "") == Ok(3)
    assert run(["sh", "-c", "exit 1"], "", "") == Ok(1)
    # not being able to start it at all is the failure
    match run(["dawn-no-such-program-anywhere-on-this-path"], "", "") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    # no argv[0] to run. std mints this one, so unlike every other kind here it
    # is the same string on both backends and is worth pinning -- it is what the
    # JVM used to answer with `java.lang.ArrayIndexOutOfBoundsException`.
    match run([], "", "") {
      Ok(_) -> { assert false }
      Err(e) -> { assert e.kind == "io.no_program" }
    }
    # each stream goes to the file named, truncating it
    let out = d ++ "/out.txt"
    assert run(["sh", "-c", "printf first"], out, "") == Ok(0)
    assert read_file(out) == Ok("first")
    assert run(["sh", "-c", "printf second"], out, "") == Ok(0)
    assert read_file(out) == Ok("second")
    # stdout and stderr are separated
    let err = d ++ "/err.txt"
    assert run(["sh", "-c", "printf out; printf err 1>&2"], out, err) == Ok(0)
    assert read_file(out) == Ok("out")
    assert read_file(err) == Ok("err")
    assert ok(write_file(d ++ "/keep.txt", "x"))
    assert delete(d ++ "/keep.txt") == Ok(Deleted)
    assert delete(out) == Ok(Deleted)
    assert delete(err) == Ok(Deleted)
    assert delete(d) == Ok(Deleted)
  }))
}

test "with_fs_real answers every operation from the host" {
  let ok = (r: Result[Unit, ForeignError]) => match r {
    Ok(_) -> true
    Err(_) -> false
  }
  with_fs_real(() => {
    let d = match fs_temp_dir("", "dawn-std-fs-") {
      Ok(p) -> p
      Err(_) -> ""
    }
    assert d != ""
    assert fs_is_dir(d)
    assert fs_exists(d)
    assert not fs_is_symlink(d)
    # the operations see the same file system the functions do
    assert exists(d)
    assert ok(fs_mkdirs(d ++ "/sub"))
    assert is_dir(d ++ "/sub")
    let f = d ++ "/sub/a.txt"
    assert ok(fs_write_file(f, "alpha"))
    assert fs_read_file(f) == Ok("alpha")
    assert read_file(f) == Ok("alpha")
    assert fs_read_bytes(f) == Ok(bytes_utf8("alpha"))
    assert ok(fs_write_bytes(d ++ "/sub/b.bin", bytes_utf8("beta")))
    assert ok(fs_rename(d ++ "/sub/b.bin", d ++ "/sub/c.bin"))
    assert not fs_exists(d ++ "/sub/b.bin")
    assert ok(fs_copy_permissions(f, d ++ "/sub/c.bin"))
    # unsorted is the contract of the primitive; the sort is list_dir's
    match fs_list_names(d ++ "/sub") {
      Ok(names) -> { assert list.sort(names) == ["a.txt", "c.bin"] }
      Err(_) -> { assert false }
    }
    let t = match fs_temp_file(d, "stage-") {
      Ok(p) -> p
      Err(_) -> ""
    }
    assert t != ""
    assert fs_exists(t)
    # what the host refuses comes back as an Err, not a panic
    match fs_read_file(d ++ "/nope") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    match fs_list_names(d ++ "/nope") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    # delete answers the bare flag: removed, or already absent
    assert fs_delete(t) == Ok(true)
    assert fs_delete(t) == Ok(false)
    assert fs_delete(f) == Ok(true)
    assert fs_delete(d ++ "/sub/c.bin") == Ok(true)
    assert fs_delete(d ++ "/sub") == Ok(true)
    assert fs_delete(d) == Ok(true)
    assert not exists(d)
  })
}

test "a handler over a table answers Fs without a host" {
  let ok = (r: Result[Unit, ForeignError]) => match r {
    Ok(_) -> true
    Err(_) -> false
  }
  let absent = (p: String) => ForeignError {
    kind: "test.absent",
    message: "no such entry: " ++ p,
    cause: None
  }
  with handle Fs {
    var writes: List[(String, String)] = []
    fs_is_dir(path) => path == "/virt"
    fs_exists(path) => path == "/virt" || path == "/virt/a.txt"
    fs_is_symlink(_path) => false
    fs_mkdirs(_path) => Ok(())
    fs_read_file(path) => if path == "/virt/a.txt" { Ok("alpha") } else { Err(absent(path)) }
    fs_write_file(path, content) => {
      writes = writes ++ [(path, content)]
      Ok(())
    }
    fs_read_bytes(path) => Err(absent(path))
    fs_write_bytes(path, _content) => Err(absent(path))
    fs_delete(path) => Ok(path == "/virt/a.txt")
    fs_rename(src, _dst) => Err(absent(src))
    fs_temp_dir(parent, prefix) => Ok(parent ++ "/" ++ prefix ++ "0")
    fs_temp_file(parent, prefix) => Ok(parent ++ "/" ++ prefix ++ "0")
    fs_copy_permissions(_src, _dst) => Ok(())
    fs_list_names(path) => if path == "/virt" { Ok(["b", "a"]) } else { Err(absent(path)) }
  }
  assert fs_is_dir("/virt")
  assert not fs_is_dir("/virt/a.txt")
  assert fs_read_file("/virt/a.txt") == Ok("alpha")
  match fs_read_file("/virt/z.txt") {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.kind == "test.absent" }
  }
  assert fs_list_names("/virt") == Ok(["b", "a"])
  assert fs_temp_dir("/virt", "t-") == Ok("/virt/t-0")
  assert fs_delete("/virt/a.txt") == Ok(true)
  assert fs_delete("/virt/gone") == Ok(false)
  assert ok(fs_write_file("/virt/n.txt", "new"))
  assert ok(fs_write_file("/virt/m.txt", "more"))
  # the table saw the writes in order, and no host was involved
  assert writes == [("/virt/n.txt", "new"), ("/virt/m.txt", "more")]
  # and the public functions ride the same handler
  assert exists("/virt/a.txt")
  assert not exists("/virt/nothing")
  assert read_file("/virt/a.txt") == Ok("alpha")
  assert list_dir("/virt") == Ok(["a", "b"])
  assert delete("/virt/a.txt") == Ok(Deleted)
  assert delete("/virt/gone") == Ok(NotFound)
}

test "with_proc_real answers run from the host, one wrapper inside the other" {
  # The nesting is an assertion, not a setting. `with_fs_real`'s body row is
  # closed, so it can only be the outer one; this order checks only because
  # `with_proc_real`'s row is `!e`. Spell that row `!(Proc | io)` instead and
  # this block stops compiling: `argument type mismatch: expected fn() -> Unit
  # !(Proc|io), got fn() -> Unit !(Fs|Proc)`.
  with_fs_real(() => with_proc_real(() => {
    let made = (r: Result[String, ForeignError]) => match r {
      Ok(p) -> p
      Err(_) -> ""
    }
    let d = made(temp_dir("", "dawn-std-proc-"))
    assert d != ""
    # `sh` rather than a coreutil, because POSIX guarantees it is on PATH.
    # A non-zero status is the answer, not a failure, and the status proves
    # the second and third elements of argv arrived as separate words.
    assert proc_run(["sh", "-c", "exit 0"], "", "") == Ok(0)
    assert proc_run(["sh", "-c", "exit 5"], "", "") == Ok(5)
    # not being able to start it at all is the failure, and it arrives as the
    # host's own `ForeignError` rather than as a status
    match proc_run(["dawn-no-such-program-anywhere-on-this-path"], "", "") {
      Ok(_) -> { assert false }
      Err(_) -> ()
    }
    # the stream paths are the operation's, not the wrapper's: what the child
    # wrote is at the file the caller named
    let out = d ++ "/out.txt"
    assert proc_run(["sh", "-c", "printf hello"], out, "") == Ok(0)
    assert read_file(out) == Ok("hello")
    let err = d ++ "/err.txt"
    assert proc_run(["sh", "-c", "printf out; printf err 1>&2"], out, err) == Ok(0)
    assert read_file(out) == Ok("out")
    assert read_file(err) == Ok("err")
    assert delete(out) == Ok(Deleted)
    assert delete(err) == Ok(Deleted)
    assert delete(d) == Ok(Deleted)
  }))
}

test "a handler over a table answers Proc without a host" {
  # What the fake is for: a command line is a list, and the only way to hold
  # one is to compare the whole list. Nothing below starts a process.
  let refused = ForeignError {
    kind: "test.refused",
    message: "nothing was started",
    cause: None
  }
  with handle Proc {
    var calls: List[(List[String], String, String)] = []
    proc_run(argv, out_path, err_path) => {
      calls = calls ++ [(argv, out_path, err_path)]
      if len(argv) > 0 && argv[0] == "curl" { Ok(22) } else { Err(refused) }
    }
  }
  assert proc_run(["curl", "--fail", "--max-time", "30", "https://example.invalid"],
    "/virt/body", "/virt/diag") == Ok(22)
  # the seam is below the error surface, so an arm's `Err` reaches the caller
  # with the arm's own `kind` and nothing rewritten on the way
  match proc_run(["cc", "--target=wasm32-wasip1", "-print-file-name=crt1.o"], "", "") {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.kind == "test.refused" }
  }
  # every element, in order, and both stream paths, for both calls
  assert calls == [
    (["curl", "--fail", "--max-time", "30", "https://example.invalid"],
      "/virt/body", "/virt/diag"),
    (["cc", "--target=wasm32-wasip1", "-print-file-name=crt1.o"], "", "")
  ]
}

test "run reaches the table, and the empty-argv check stays above it" {
  # The seam is real from the public function, not only from the operation:
  # what `run` is handed is what the arm sees, element for element, and the
  # status the arm answers is what `run` returns. Nothing below starts a
  # process.
  with handle Proc {
    var calls: List[(List[String], String, String)] = []
    proc_run(argv, out_path, err_path) => {
      calls = calls ++ [(argv, out_path, err_path)]
      Ok(7)
    }
  }
  assert run(["true"], "", "") == Ok(7)
  assert run(["sh", "-c", "printf hi"], "/virt/out", "/virt/err") == Ok(7)
  # the empty-argv check happens first, so `io.no_program` is still minted
  # here and the arm is never handed an argv with no program in it
  match run([], "/virt/out", "") {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.kind == "io.no_program" }
  }
  assert calls == [
    (["true"], "", ""),
    (["sh", "-c", "printf hi"], "/virt/out", "/virt/err")
  ]
}

test "with_env_real answers cwd and getenv from the host" {
  with_env_real(() => {
    # the arm is the host primitive, so the operation and the `io.*` function
    # of the same meaning are the same question asked twice
    assert env_cwd() == cwd()
    assert env_cwd() != ""
    # a name nothing sets, and a name the host environment API cannot
    # represent at all: both are `None`, and neither is an error
    assert env_get("DAWN_STD_TEST_DEFINITELY_UNSET_VARIABLE") == None
    assert env_get("DAWN_STD_TEST\u{0}INVALID_VARIABLE") == None
    # whatever the host says about a name it may or may not have, the
    # operation says the same
    assert env_get("HOME") == getenv("HOME")
    assert env_get("PATH") == getenv("PATH")
  })
}

test "a handler over a table answers Env without a host" {
  # What the fake is for: which name a function asks for is the thing worth
  # asserting, and no host is consulted below.
  with handle Env {
    var asked: List[String] = []
    env_cwd() => "/virt/work"
    env_get(name) => {
      asked = asked ++ [name]
      if name == "DAWN_PKG_CACHE" { Some("/virt/cache") } else { None }
    }
  }
  assert env_cwd() == "/virt/work"
  assert env_get("DAWN_PKG_CACHE") == Some("/virt/cache")
  # the seam is below the error surface: an unset name is `None` at the
  # operation, and what that means is the caller's decision, not the arm's
  assert env_get("DAWN_PKG_CACHE_NOT_SET") == None
  assert env_get("HOME") == None
  # every name, in order, and nothing the caller did not ask for
  assert asked == ["DAWN_PKG_CACHE", "DAWN_PKG_CACHE_NOT_SET", "HOME"]
}

test "the three real wrappers nest, and the order is the body rows' doing" {
  # The nesting is an assertion, not a setting. `with_fs_real`'s body row is
  # closed, so it can only be the outer one; `with_proc_real` and
  # `with_env_real` take `!e`, so each can sit inside. Spell `with_env_real`'s
  # row `!(Env | io)` instead and this block stops compiling: `argument type
  # mismatch: expected fn() -> Unit !(Env|io), got fn() -> Unit
  # !(Env|Fs|Proc)`.
  with_fs_real(() => with_proc_real(() => with_env_real(() => {
    # all three effects are live in here, and each is answered by its own
    # wrapper: the environment says where the process is, the file system
    # agrees that is a directory, and a child process runs there.
    let here = env_cwd()
    assert here != ""
    assert is_dir(here)
    assert proc_run(["sh", "-c", "exit 0"], "", "") == Ok(0)
    assert env_get("DAWN_STD_TEST_DEFINITELY_UNSET_VARIABLE") == None
  })))
}

test "cwd and getenv reach the table, name for name" {
  # The seam is real from the public functions, not only from the operations:
  # what `getenv` is handed is what the arm sees, and what the arm answers is
  # what `cwd` and `getenv` return. Nothing below asks the host.
  with handle Env {
    var asked: List[String] = []
    env_cwd() => "/virt/elsewhere"
    env_get(name) => {
      asked = asked ++ [name]
      if name == "DAWN_WASM_CC" { Some("clang-20") } else { None }
    }
  }
  assert cwd() == "/virt/elsewhere"
  assert getenv("DAWN_WASM_CC") == Some("clang-20")
  assert getenv("HOME") == None
  assert asked == ["DAWN_WASM_CC", "HOME"]
}

test "an Exit arm that does not resume ends the block, and the test lives on" {
  # The arm a test installs in place of `with_exit_real`: the arm's value is
  # the value of the whole block (spec §6.5), so a status arrives as an `Int`,
  # and `k` is dropped bare exactly as the production arm drops it. Nothing
  # below ends anything.
  let attempt = (code: Int, stop: Bool) => {
    with handle Exit {
      exit_now(c) resume k => (c, "stopped")
    }
    if stop {
      exit_now(code)
    }
    (-1, "ran to the end")
  }
  # the status is a value, which is the thing `exit` cannot be asked for today
  assert attempt(2, true) == (2, "stopped")
  # nothing after the operation runs: the remainder is the block's answer
  # whenever it is reached, and in the stopping case it never is
  assert attempt(2, false) == (-1, "ran to the end")
  # and this line runs after two calls to `exit_now`, which is the third
  # claim: the process the test is in is still here to be asked
  assert attempt(0, true) == (0, "stopped")
}

test "with_console_real writes through the host and answers the body" {
  # The arms are the host primitives, so these four lines really are written,
  # into the middle of a test report; they say where they came from. The
  # stdout write without a newline comes first and the stderr write after it,
  # which is the ordering both runtimes promise (runtime/c/dawn_rt.c flushes
  # stdout before it touches stderr, and System.err autoflushes).
  let answered = with_console_real(() => {
    console_print("std/io: ")
    console_println("Console reaches stdout, print then println")
    console_eprint("std/io: ")
    console_eprintln("Console reaches stderr, eprint then eprintln")
    7
  })
  # the wrapper is transparent: the body's value is the block's value
  assert answered == 7
}

test "a handler over a table answers Console without a host" {
  # What the fake is for: which stream a write went to, and whether it ended
  # the line, are the things worth asserting, and nothing below writes
  # anywhere.
  with handle Console {
    var written: List[(String, String)] = []
    console_print(s) => { written = written ++ [("out", s)] }
    console_println(s) => { written = written ++ [("out", s ++ "\n")] }
    console_eprint(s) => { written = written ++ [("err", s)] }
    console_eprintln(s) => { written = written ++ [("err", s ++ "\n")] }
  }
  console_print("usage: ")
  console_println("dawn build <project>")
  console_eprint("error: ")
  console_eprintln("no such file")
  # every write, in order, on the stream and with the ending its operation
  # name promised
  assert written == [
    ("out", "usage: "),
    ("out", "dawn build <project>\n"),
    ("err", "error: "),
    ("err", "no such file\n")
  ]
}

test "the five real wrappers nest, and the order is the body rows' doing" {
  # The nesting is an assertion, not a setting. `with_fs_real`'s body row is
  # closed, so it can only be the outer one; the other four take `!e`, so each
  # can sit anywhere inside. Spell `with_exit_real`'s or `with_console_real`'s
  # row as a closed `!(Exit | io)` or `!(Console | io)` and this block stops
  # compiling, the way the three-wrapper test above says it does for `Env`.
  with_fs_real(() => with_proc_real(() => with_env_real(() => with_exit_real(() =>
      with_console_real(() => {
        # four of the five effects are exercised here; the fifth is `Exit`, and
        # calling `exit_now` under its real handler would end the test run,
        # which is the whole reason the test above installs an arm of its own.
        let here = env_cwd()
        assert here != ""
        assert is_dir(here)
        assert proc_run(["sh", "-c", "exit 0"], "", "") == Ok(0)
        console_println("std/io: all five real handlers are installed")
      })))))
}

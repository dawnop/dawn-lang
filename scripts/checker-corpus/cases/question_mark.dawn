# checker.dawn: `?` and the function return type it needs
pub fn no_wrapper(x: Option[Int]) -> Int = x? + 1

pub fn opt_in_result(x: Option[Int]) -> Result[Int, String] = Ok(x?)

pub fn res_in_opt(x: Result[Int, String]) -> Option[Int] = Some(x?)

pub fn err_differs(x: Result[Int, String]) -> Result[Int, Int] = Ok(x?)

pub fn not_wrapped(x: Int) -> Option[Int] = Some(x?)

fn inferred(x: Option[Int]) = x?

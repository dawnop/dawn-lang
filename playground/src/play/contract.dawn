# The /run wire contract. Request: {"code": "<source>"}. Response, one of:
#   {"ok": true,  "phase": "run",     "exit": 0, "output": "...", "truncated": false, "ms": 620}
#   {"ok": false, "phase": "compile", "output": "<Dawn diagnostics>"}
#   {"ok": false, "phase": "timeout", "output": "<partial output>"}
# POST /compile takes {"code": ..., "target": "c" | "jvm" | "tile"} and answers like
# /check when the program does not compile; what it answers when it does is
# play/view.dawn's. Only "tile" runs the program (the Tile IR is what it prints).
# GET /health answers {"ok": true, "version": "0.81.0", "build": "b1:2bfef5fb3622"}.
# Everything is a JSON object built from the vendored M4 json library and
# rendered with its RFC-8259 string escaping — no hand-rolled quoting.
# `exit` and `ms` are `JInt`, not `JNum`: a `JNum` renders as a float
# (`"exit":0.0`), which a client comparing `exit === 0` in a stricter language
# reads as a different value. test/contract.sh checks the literal bytes.
use std/map
use std/list
use std/str
use json/value.{Json, JBool, JInt, JStr, JObj, error_text}
use json/parser.{parse}
use json/render.{render}

# The outcome of one run, produced by the executor (stage 4c).
pub type Outcome =
  | Compiled(output: String, exit: Int, truncated: Bool, ms: Int)
  | CompileError(output: String)
  | Timeout(output: String)
derive Show

# The request body as a JSON object's entries. Errors are the client's fault
# (400): malformed JSON, or not an object.
fn request_object(body: String) -> Result[Map[String, Json], String] =
  match parse(body) {
    Err(e) -> Err("invalid JSON: " ++ error_text(e))
    Ok(j) ->
      match j {
        JObj(entries) -> Ok(entries)
        _ -> Err("request must be a JSON object")
      }
  }

# A string field of a request, or why it is not one.
fn string_field(entries: Map[String, Json], name: String) -> Result[String, String] =
  match map.get(entries, name) {
    Some(JStr(v)) -> Ok(v)
    Some(_) -> Err("field \"${name}\" must be a string")
    None -> Err("missing field \"${name}\"")
  }

# Pull the "code" field out of a request body. Errors are the client's fault
# (400): malformed JSON, not an object, or no string "code".
pub fn parse_request(body: String) -> Result[String, String] =
  match request_object(body) {
    Err(e) -> Err(e)
    Ok(entries) -> string_field(entries, "code")
  }

## What /compile can show, in the order of the tabs.
pub fn targets() -> List[String] = ["c", "jvm", "tile"]

## Whether a program is one the Tile IR view is for: it imports the package.
## The page asks the same question of the same text to decide whether to show
## the tab, and the server asks it again because the page is not trusted. It is
## a courtesy to the visitor, not a security boundary (the packages a program
## can reach are fixed by the manifest the runner writes): a comment holding
## the words passes it and gets the compiler's answer instead.
pub fn wants_tileir(code: String) -> Bool = str.contains(code, "use tileir/")

# A /compile request: the "code" and a "target" from [`targets`]. The target
# is checked against that list and nothing else reaches the sandbox.
pub fn parse_compile_request(body: String) -> Result[(String, String), String] =
  match request_object(body) {
    Err(e) -> Err(e)
    Ok(entries) -> match string_field(entries, "code") {
      Err(e) -> Err(e)
      Ok(code) -> match string_field(entries, "target") {
        Err(e) -> Err(e)
        Ok(target) ->
          if list.contains(targets(), target) {
            Ok((code, target))
          } else {
            Err("field \"target\" must be one of: ${join(targets(), ", ")}")
          }
      }
    }
  }

fn obj(entries: List[(String, Json)]) -> String = render(JObj(map.from(entries)))

pub fn render_outcome(o: Outcome) -> String =
  match o {
    Compiled(output, exit, truncated, ms) ->
      obj([
        ("ok", JBool(true)),
        ("phase", JStr("run")),
        ("exit", JInt(exit)),
        ("output", JStr(output)),
        ("truncated", JBool(truncated)),
        ("ms", JInt(ms)),
      ])
    CompileError(output) ->
      obj([("ok", JBool(false)), ("phase", JStr("compile")), ("output", JStr(output))])
    Timeout(output) ->
      obj([("ok", JBool(false)), ("phase", JStr("timeout")), ("output", JStr(output))])
  }

# /check responses: a compile failure uses the exact same shape as /run's, so
# the client parses one diagnostics format; success is a bare all-clear (the
# program never ran, so there is no exit code or output to report).
pub fn render_check(o: Outcome) -> String =
  match o {
    Compiled(_, _, _, ms) ->
      obj([("ok", JBool(true)), ("phase", JStr("check")), ("ms", JInt(ms))])
    CompileError(output) ->
      obj([("ok", JBool(false)), ("phase", JStr("compile")), ("output", JStr(output))])
    Timeout(output) ->
      obj([("ok", JBool(false)), ("phase", JStr("timeout")), ("output", JStr(output))])
  }

# /health: liveness plus the compiler release (`version`, from
# exec.compiler_id), which the editor shows in its toolbar, and the short
# digest of the sources that compiler was built from (`build`), which tells a
# release from a later build of the same version. Either, when unknown, is
# left out rather than sent empty.
pub fn render_health(version: String, build: String) -> String = {
  var known: List[(String, Json)] = []
  if version != "" { known = known ++ [("version", JStr(version))] }
  if build != "" { known = known ++ [("build", JStr(build))] }
  obj([("ok", JBool(true))] ++ known)
}

test "health names what it knows and leaves out what it does not" {
  # compared as parsed objects: the field order is the map's, not a promise
  let parsed = (v: String, b: String) => match parse(render_health(v, b)) {
    Ok(j) -> j
    Err(e) -> panic("health is not JSON: " ++ error_text(e))
  }
  assert parsed("0.83.0", "b1:2bfef5fb3622") == JObj(map.from([
    ("ok", JBool(true)), ("version", JStr("0.83.0")), ("build", JStr("b1:2bfef5fb3622"))
  ]))
  assert parsed("0.81.0", "") ==
    JObj(map.from([("ok", JBool(true)), ("version", JStr("0.81.0"))]))
  assert parsed("", "") == JObj(map.from([("ok", JBool(true))]))
}

pub fn render_error(message: String) -> String =
  render(JObj(map.from([("ok", JBool(false)), ("phase", JStr("error")), ("output", JStr(message))])))

test "only a program that imports tileir is one the Tile IR view is for" {
  assert wants_tileir("use std/io\nuse tileir/dev.{Dev}\n")
  assert not wants_tileir("use std/io\npub fn main() -> Unit !io = println(\"hi\")\n")
  assert not wants_tileir("use tileir.dev")
  assert list.contains(targets(), "tile")
}

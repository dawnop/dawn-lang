# checker.dawn: the same hole with an effect-polymorphic wrapper (N12). The
# extra effect variable changes the row, not the result, so the rule must not
# depend on the row being closed.
use std/mem
use std/mem.{Mem}

pub fn scope2[T, !e](f: fn() -> T !Mem !e) -> T !e = mem.with_mem(f)

pub fn escaped() -> Int = len(scope2(() => mem.new(4)))

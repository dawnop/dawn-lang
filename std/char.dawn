## Characters: the type `'a'` is heading for, and the questions worth asking
## about one (spec §1.5, §11).
#
# Short names, module-qualified at the call site: `use std/char`, then
# `char.code(c)` / `char.is_digit(c)`.
#
# `Char` is an opaque type over `Int` minted by the compiler (`types.ty_char`)
# because character literals need a type before any module is in scope. This
# module is its owner, which is what lets the two conversions below stay two
# lines instead of two intrinsics. `==`, `<` and hashing are the Int's, which
# is what an `opaque type` over Int means and what costs nothing (spec §2.7).
#
# Rendering is where this module has an opinion, and it has one at both layers
# (spec §4.3). `impl Display[Char]` is the top level: `"${c}"` is the
# character. `impl Show[Char]` is the nested one: a `Char` in a list or a
# record renders as the source literal `'a'`, the way a nested String renders
# as `"a"`. Writing an impl of its own is the ordinary thing an opaque type
# may do (spec §2.7 names `impl Show[UserId]`); what it costs is that `Char`
# is no longer an *example* of "an opaque type is its target", which is why
# `scripts/opaque-twin/char.dawn` pins both layers against the Int explicitly.
#
# The predicates are `char_is_*` intrinsics underneath, table-driven from the
# compiler's own Unicode class table (selfhost/src/embed/unicode_class.dawn), so the
# answers do not move when the host JDK does.

use std/cursor
use std/str

## The code point `c` stands for.
pub fn code(c: Char) -> Int = c

## The character with code point `n`, or `None` when `n` is not one.
##
## `Option` rather than a panic because "is this integer a character" is a
## question with a legitimate negative answer -- it is exactly what a parser
## reading a `\u` escape needs to ask (spec §4.8, criterion 2). The bulk
## conversion `from_code_points` is not asking, and keeps its panic.
##
## Not a Unicode scalar value: negative, above U+10FFFF, or in the surrogate
## range D800..DFFF. Those last are halves of a UTF-16 pair and never stand
## for a character on their own, which is the whole reason `Cursor` exists.
pub fn of(n: Int) -> Option[Char] =
  if n < 0 || n > 0x10FFFF || (n >= 0xD800 && n <= 0xDFFF) { None } else { Some(n) }

## Whether `c` is a letter.
pub fn is_letter(c: Char) -> Bool = char_is_letter(c)

## Whether `c` is a decimal digit.
pub fn is_digit(c: Char) -> Bool = char_is_digit(c)

## Whether `c` is a letter or a digit.
pub fn is_alnum(c: Char) -> Bool = char_is_alnum(c)

## Whether `c` is an upper-case letter.
pub fn is_upper(c: Char) -> Bool = char_is_upper(c)

## Whether `c` is a lower-case letter.
pub fn is_lower(c: Char) -> Bool = char_is_lower(c)

## Whether `c` is whitespace.
pub fn is_space(c: Char) -> Bool = char_is_space(c)

## What `to_string` and `${...}` make of a character: the one-character string.
##
## `Display` is the top-level rendering and nothing else consumes it, so this
## impl says "a character reads as itself" without saying anything about the
## nested one, which is the `Show` below.
##
## `str.from_char` is the same string asked for by name, and stays: this impl
## is the rendering, not a replacement for the function.
impl Display[Char] {
  fn display(c: Char) -> String = str.from_char(c)
}

## What a character looks like inside a structure: the source literal `'a'`.
##
## The nested layer renders a value so that it reads back as source, which is
## why a nested String carries its quotes (spec §4.3). A character is the same
## question with a different delimiter, and answering it with the code point
## instead made a `List[Char]` print exactly like a `List[Int]`.
##
## The escape set is the one `lex_escape` accepts, so the output is a literal
## the lexer would take back. It is deliberately the same five the nested
## String escapes, minus `"` (not a delimiter here) plus `'` (which is): a
## backslash first, or the quote escape it introduces gets doubled.
impl Show[Char] {
  fn show(c: Char) -> String = "'" ++ escaped(c) ++ "'"
}

fn escaped(c: Char) -> String =
  match c {
    '\\' -> "\\\\"
    '\'' -> "\\'"
    '\n' -> "\\n"
    '\t' -> "\\t"
    '\r' -> "\\r"
    _ -> str.from_char(c)
  }

# ---- tests ----
#
# These tests exercise the explicit `Char`/`Int` boundary. Nothing below
# assumes the two types are interchangeable (spec §1.5).

test "of admits the scalar values and refuses the rest" {
  assert code(of(97).expect("a")) == 97
  assert code(of(0).expect("nul")) == 0
  assert code(of(0x10FFFF).expect("max")) == 0x10FFFF
  assert of(-1) == None
  assert of(0x110000) == None
  # the surrogate halves: legal UTF-16 units, never characters
  assert of(0xD800) == None
  assert of(0xDBFF) == None
  assert of(0xDC00) == None
  assert of(0xDFFF) == None
  # and the code points on either side of that hole are fine
  assert of(0xD7FF) != None
  assert of(0xE000) != None
}

test "a literal is a character, and code is the way back to Int" {
  assert code('a') == 97
  assert code('\n') == 10
  assert code('中') == 0x4E2D
  assert code('😀') == 0x1F600
  assert of(97) == Some('a')
  # equality, ordering and hashing come from the target type, which is what an
  # opaque type over Int means. Hashing is the third of those and needs a
  # Map, which is checked after this module -- so std/map's tests pin "a
  # character can be a Map key" and these two pin the other two.
  assert 'a' == 'a'
  assert 'a' != 'b'
  assert 'a' < 'b'
  # match on a character is match on its target
  let name = match 'x' {
    'x' -> "ex"
    _ -> "other"
  }
  assert name == "ex"
}

test "a character renders as itself on top and as a literal inside" {
  # the Display impl above, which is the whole top-level rendering
  assert to_string('a') == "a"
  assert "${'中'}" == "中"
  assert "${'😀'}" == "😀"
  assert to_string('\n') == "\n"
  # the same string `str.from_char` answers with, by construction
  assert "${'中'}" == str.from_char('中')
  # and the Show impl, which is the nested one. A tuple is the only structure
  # available here -- List's `Show` impl is std/list, which is checked after
  # this module.
  assert show('a') == "'a'"
  assert to_string(('a', 'b')) == "('a', 'b')"
  # the two layers disagree, which is the whole reason there are two
  assert show('a') != to_string('a')
  # neither layer is the Int's any more, and that is what stopped a nested
  # Char from printing like a nested Int
  assert show('a') != show(code('a'))
  assert to_string(('a', 'b')) != to_string((97, 98))
}

test "the nested literal escapes exactly what the lexer would read back" {
  assert show('\\') == "'\\\\'"
  assert show('\'') == "'\\''"
  assert show('\n') == "'\\n'"
  assert show('\t') == "'\\t'"
  assert show('\r') == "'\\r'"
  # `"` is not a delimiter inside single quotes, so it stays as it is -- the
  # one place this set differs from the nested String's
  assert show('"') == "'\"'"
  # nothing else is escaped, including outside the BMP
  assert show('中') == "'中'"
  assert show('😀') == "'😀'"
}

test "the predicates read the compiler's Unicode table, not the host's" {
  assert is_letter('a')
  assert is_letter('中')
  assert not is_letter('1')
  assert is_digit('7')
  assert not is_digit('a')
  assert is_alnum('a')
  assert is_alnum('7')
  assert not is_alnum(' ')
  assert is_upper('A')
  assert not is_upper('a')
  assert is_lower('a')
  assert not is_lower('A')
  assert is_space(' ')
  assert is_space('\t')
  assert is_space('\n')
  assert not is_space('a')
}

test "the walk over a string hands out characters" {
  let s = "a中😀"
  assert str.at(s, 0) == 'a'
  assert str.at(s, 1) == '中'
  assert str.at(s, 2) == '😀'
  assert code_points(s) == ['a', '中', '😀']
  assert from_code_points(['a', 'b']) == "ab"
  # cursor.char stays an Int: it answers -1 at the end, and a sentinel that is
  # not a code point cannot live in a type whose every value is one (spec §4.8,
  # nominal-types-design.md §7.3)
  assert cursor.char(s, cursor.start(s)) == 97
  assert cursor.char(s, cursor.end(s)) == -1
}

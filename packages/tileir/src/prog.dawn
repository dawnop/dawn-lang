        check_shape(name, shape)
        held = hold(held, next, dtype, shape)
        let d = next
        let tv = next + 1
        next = mint(name, next, 2)
        ops = ops ++ [LoadAt(d, tv, dtype, shape, ptrs, mask, pad, tok)]
        tok = tv
        d
      }
      t_assert(shape, cond0, message) => {
        check_shape(name, shape)
        let (g, cond) = widen(name, frames, grown(next, ops, held, spreads, pending), cond0, "i1", shape)
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        ops = ops ++ [Assert(shape, cond, message)]
        ()
      }
      t_assume(pred, dtype, shape, src0) => {
        check_shape(name, shape)
        let (g, src) = widen(name, frames, grown(next, ops, held, spreads, pending), src0, dtype, shape)
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        check_int_dtype(name, dtype)
        check_assume(name, pred, shape)
        held = hold(held, next, dtype, shape)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [Assume(d, pred, dtype, shape, src)]
        d
      }
      t_print(fmt, dtype, shape, args0) => {
        let (g, args) = settle_all(name, frames, grown(next, ops, held, spreads, pending), args0)
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        let open = frames
        if list.any(open, is_pure_region) {
          refuse(name, "a print inside a reduce, scan or if region has no memory order")
        } else {
          ()
        }
        check_shape(name, shape)
        let wanted = format_args(name, fmt)
        if wanted != len(args) {
          refuse(name, "print format `${fmt}` has ${wanted} format expression(s) and ${len(args)} operand(s)")
        } else {
          ()
        }
        let tv = next
        next = mint(name, next, 1)
        ops = ops ++ [Print(tv, fmt, dtype, shape, args, tok)]
        tok = tv
        ()
      }
      t_store_ptrs(dtype, shape, ptrs, value0, mask0) => {
        let (g0, value) = widen(name, frames, grown(next, ops, held, spreads, pending), value0, dtype, shape)
        let (g, mask) = widen_opt(name, frames, g0, mask0, "i1", shape)
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        let open = frames
        if list.any(open, is_pure_region) {
          refuse(name, "a store inside a reduce, scan or if region has no memory order")
        } else {
          ()
        }
        check_shape(name, shape)
        check_write(name, frames, ops, roles, map.get(aims, ptrs), writer(marks, calls, "store_ptrs"), false)
        let t = next
        next = mint(name, next, 1)
        ops = ops ++ [StoreAt(t, dtype, shape, ptrs, value, mask, tok)]
        tok = t
        ()
      }
      t_global(sym, dtype, values, align, is_private, constant) => {
        # A global belongs to the module, not to a region of the entry, and
        # the Global section has no place to say otherwise.
        if len(frames) != 0 {
          refuse(name, "the global `${sym}` is declared inside a region; a global belongs to the module")
        } else {
          ()
        }
        if sym == "" { refuse(name, "a global has a name") } else { () }
        let seen = globals
        if list.any(seen, g => g.sym == sym) {
          refuse(name, "the global `${sym}` is declared twice")
        } else {
          ()
        }
        # GlobalOp's verifier requires rank 1, so the initializer decides
        # the extent and an empty one has no type to give.
        if len(values) == 0 {
          refuse(name, "the global `${sym}` is initialized with no values; its type is tile<Nxdtype> and N comes from them")
        } else {
          ()
        }
        if align < 0 {
          refuse(name, "the global `${sym}` asks for alignment ${align}")
        } else {
          ()
        }
        globals = globals ++ [Global { sym: sym, dtype: dtype, values: values, align: align, is_private: is_private, constant: constant }]
        ()
      }
      t_get_global(sym, dtype, shape) => {
        check_shape(name, shape)
        let seen = globals
        match list.find(seen, g => g.sym == sym) {
          None -> refuse(name, "get_global names `${sym}`, which no global declares")
          Some(g) ->
            if g.dtype != dtype {
              refuse(name, "the global `${sym}` holds ${g.dtype}, and get_global reads it as ${dtype}")
            } else {
              ()
            }
        }
        held = hold(held, next, ptr_of(dtype), shape)
        aims = map.insert(aims, next, NO_PARAM)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [GetGlobal(d, sym, dtype, shape)]
        d
      }
      t_alloca(dtype, num_elem, align, shared, shape) => {
        check_shape(name, shape)
        # AllocaOp's verifier: the alignment is a non-zero power of two, and
        # it is at least the natural size of the element. The first half is
        # checked here because it is arithmetic on one number; the second
        # needs a width per format, which this package keeps in the writer's
        # type table and not on this surface, so `tileiras` is left to say
        # it (`'alignment' (4) must be at least the natural size (8 bytes)
        # for element type f64`, measured).
        if num_elem < 0 {
          refuse(name, "alloca asks for ${num_elem} elements")
        } else {
          ()
        }
        if align <= 0 || (align & (align - 1)) != 0 {
          refuse(name, "alloca asks for alignment ${align}, which is not a non-zero power of two")
        } else {
          ()
        }
        held = hold(held, next, ptr_of(dtype), shape)
        aims = map.insert(aims, next, NO_PARAM)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [Alloca(d, dtype, num_elem, align, shared, shape)]
        d
      }
      t_tensor_view(param, dtype, base0, shape, strides, dyn_shape0, dyn_strides0) => {
        let (g, hs) = settle_all(name, frames, grown(next, ops, held, spreads, pending), [base0] ++ dyn_shape0 ++ dyn_strides0)
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        let base = hs[0]
        let dyn_shape = list.take(list.drop(hs, 1), len(dyn_shape0))
        let dyn_strides = list.drop(hs, 1 + len(dyn_shape0))
        # TensorViewType's verifier, the half that is arithmetic on this
        # record alone: shape and strides are the same rank and every
        # entry of both is strictly positive. A stride of ZERO is the one
        # a strided load may have and a tensor view may not, which is why
        # a broadcast read has no view spelling at all
        # (docs/tile-backend-design.md 6.14).
        #
        # `DYN_DIM` is the exception and the only one: a dimension whose
        # extent (or stride) an operand carries is not a number this
        # recorder can hold to anything, and the verifier does not either
        # (`kDynamic` is exempt from both `any_of` checks). What IS held
        # here is the count: `MakeTensorViewOp::verify` wants one operand
        # per marker, and a mismatch is a lie about the operand segment
        # that the reader would take as the next instruction's opcode.
        check_strides(name, shape, strides)
        if len(shape) == 0 {
          refuse(name, "a tensor view of rank 0 has no partition; the dialect allows it and nothing here can use one")
        } else {
          ()
        }
        match list.find(shape, d => d < 1 && d != DYN_DIM) {
          Some(d) -> refuse(name, "a tensor view dimension is strictly positive or dynamic, got ${d} in ${show(shape)}")
          None -> ()
        }
        match list.find(strides, s => s < 1 && s != DYN_DIM) {
          Some(s) -> refuse(name, "a tensor view stride is strictly positive or dynamic, got ${s} in ${show(strides)}")
          None -> ()
        }
        let want_shape = len(list.filter(shape, d => d == DYN_DIM))
        if len(dyn_shape) != want_shape {
          refuse(name, "a tensor view with ${want_shape} dynamic dimension(s) takes ${want_shape} shape operand(s), got ${len(dyn_shape)}")
        } else {
          ()
        }
        let want_strides = len(list.filter(strides, s => s == DYN_DIM))
        if len(dyn_strides) != want_strides {
          refuse(name, "a tensor view with ${want_strides} dynamic stride(s) takes ${want_strides} stride operand(s), got ${len(dyn_strides)}")
        } else {
          ()
        }
        held = hold_view(held, next, TensorViewRow, dtype, shape)
        aims = map.insert(aims, next, param)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [TensorViewOf(d, param, dtype, base, shape, strides, dyn_shape, dyn_strides)]
        d
      }
      t_partition_view(dtype, view, tile_shape, dim_map, padding) => {
        # verifyPartitionViewLike, the half that reads this record alone.
        # The half that needs the tensor view (the ranks matching, and a
        # target dimension being in range) is in the lowering, which is
        # where a handle's type is known.
        check_view_record(name, dtype, tile_shape, dim_map, padding, "partition view")
        held = hold_view(held, next, GridViewRow("partition view"), dtype, tile_shape)
        aims = follow(aims, view, next)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [PartitionViewOf(d, dtype, view, tile_shape, dim_map, padding)]
        d
      }
      t_strided_view(dtype, view, tile_shape, traversal, dim_map, padding) => {
        # StridedViewType::verify, the half that reads this record alone:
        # verifyPartitionViewLike's own rules and then the two the traversal
        # brings, which are that it is one number a tile dimension and that
        # every one of them is strictly positive. A traversal of zero would
        # make every index name the same tile.
        check_view_record(name, dtype, tile_shape, dim_map, padding, "strided view")
        if len(traversal) != len(tile_shape) {
          refuse(name, "expected ${len(tile_shape)} traversal stride(s), got ${len(traversal)}")
        } else {
          ()
        }
        match list.find(traversal, t => t < 1) {
          Some(t) -> refuse(name, "traversal strides must be strictly positive but got ${t} in ${show(traversal)}")
          None -> ()
        }
        held = hold_view(held, next, GridViewRow("strided view"), dtype, tile_shape)
        aims = follow(aims, view, next)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [StridedViewOf(d, dtype, view, tile_shape, traversal, dim_map, padding)]
        d
      }
      t_gather_view(dtype, view, tile_shape, sparse_dim, padding) => {
        # GatherScatterViewType::verify, the half that reads this record
        # alone. There is no `dim_map` here, so `check_view_record` is
        # handed the identity: the rules it shares with the other two views
        # are the tile's, and the map is not one of them.
        check_view_record(name, dtype, tile_shape, range(0, len(tile_shape)), padding,
          "gather/scatter view")
        if sparse_dim < 0 || sparse_dim >= len(tile_shape) {
          refuse(name, "a gather/scatter view of rank ${len(tile_shape)} gathers along dimension ${sparse_dim}, which is not one of 0 to ${len(tile_shape) - 1}")
        } else {
          ()
        }
        held = hold_view(held, next, GridViewRow("gather/scatter view"), dtype, tile_shape)
        aims = follow(aims, view, next)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [GatherViewOf(d, dtype, view, tile_shape, sparse_dim, padding)]
        d
      }
      t_atomic_red_view(dtype, view, indices0, mode, scope, value0) => {
        let (g, hs) = settle_all(name, frames, grown(next, ops, held, spreads, pending), indices0 ++ [value0])
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        let indices = list.take(hs, len(indices0))
        let value = hs[len(indices0)]
        # The two enum domains the operation NARROWS (Ops.td's
        # OnlyVariants): nine of the ten atomic modes, and two of the three
        # memory scopes. Its ordering is narrowed to one value and is
        # therefore not a parameter here at all. A reduction is a memory
        # operation, so the region rule every load and store has is here
        # too.
        let open = frames
        if list.any(open, is_pure_region) {
          refuse(name, "an atomic reduction inside a reduce, scan or if region has no memory order")
        } else {
          ()
        }
        if not list.any(red_modes(), m => m == mode) {
          refuse(name, "`${mode}` is not one of the modes an atomic_red_view_tko takes (${show(red_modes())})")
        } else {
          ()
        }
        if scope != "tl_blk" && scope != "device" {
          refuse(name, "memory scope `${scope}` is not supported for view-based atomic reductions; use `tl_blk` or `device`")
        } else {
          ()
        }
        check_write(name, frames, ops, roles, map.get(aims, view), writer(marks, calls, "atomic_red_view"), false)
        let tv = next
        next = mint(name, next, 1)
        ops = ops ++ [AtomicRedViewOf(tv, dtype, view, indices, mode, scope, value, tok)]
        tok = tv
        ()
      }
      t_load_view(dtype, view, indices0) => {
        let (g, indices) = settle_all(name, frames, grown(next, ops, held, spreads, pending), indices0)
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        let open = frames
        if list.any(open, is_pure_region) {
          refuse(name, "a load inside a reduce, scan or if region has no memory order")
        } else {
          ()
        }
        # The tile a grid view moves, in the view's format: the type the
        # lowering gives the result (`view_tile_of`). `load_gather` comes
        # here too, and a gather/scatter view's tile is its result as well.
        # A handle that is not a grid view leaves the result without a
        # row; the lowering refuses that program by name.
        held = match map.get(held, view) {
          Some(x) -> match x.what {
            GridViewRow(_w) -> hold(held, next, x.dtype, x.shape)
            _ -> held
          }
          None -> held
        }
        let d = next
        let tv = next + 1
        next = mint(name, next, 2)
        ops = ops ++ [LoadView(d, tv, dtype, view, indices, tok)]
        tok = tv
        d
      }
      t_store_view(dtype, view, indices0, value0) => {
        let open = frames
        if list.any(open, is_pure_region) {
          refuse(name, "a store inside a reduce, scan or if region has no memory order")
        } else {
          ()
        }
        let is_cell = match map.get(cell_marks, view) {
          Some(_p) -> true
          None -> false

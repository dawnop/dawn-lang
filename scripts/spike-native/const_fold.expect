-- scalars fold --
N     = 42
NEG   = -5
FLAG  = true
TEXT  = abc
LEN   = 5
-- folded rendering vs the same expression at runtime --
const   int   = 42
runtime int   = 42
const   bool  = true
runtime bool  = true
const   point = Point(1, 2)
runtime point = Point(1, 2)
const   suit  = Hearts
runtime suit  = Hearts
const   list  = [1, 2, 3]
runtime list  = [1, 2, 3]
const   opt   = Some(9)
runtime opt   = Some(9)
const   interp= p=Point(3, 4)
runtime interp= p=Point(3, 4)
-- a String is bare at the top and quoted inside a value --
const   str   = [a
b]
runtime str   = [a
b]
const   named = Named { tag: "a\nb", n: 1 }
runtime named = Named { tag: "a\nb", n: 1 }
const   strs  = ["x", "y"]
runtime strs  = ["x", "y"]
-- the cursor walk, folded vs live --
const   len   = 5
runtime len   = 5
const   idx   = Some(2)
runtime idx   = Some(2)
const   last  = Some(4)
runtime last  = Some(4)
const   sub   = 𝄞中b
runtime sub   = 𝄞中b
const   split = a|中b|
runtime split = a|中b|
const   trim  = [a𝄞中b𝄞]
runtime trim  = [a𝄞中b𝄞]
const   ends  = true
runtime ends  = true

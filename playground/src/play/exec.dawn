# The execution pipeline: compile with `dawn build`, then run the jar with
# `java`. Two phases keep the compile diagnostics clean and separate from the
# program's own output.
#
# Each child's combined stdout+stderr goes to a file rather than a pipe, and
# where that file lives is the security boundary of this module. A request's
# directory is laid out as
#
#   dawn-play-<uuid>/          runner-owned, 0711: build.txt, run.txt
#   dawn-play-<uuid>/box/      0777 under the sandbox: prog.dawn, prog.jar
#
# and the sandbox is handed `box/` only. The output files used to sit in the
# directory the sandbox could write, and the runner read them back by name
# after the child exited, so the child could swap one for a link to a file
# only the runner could read, or for a file that never reaches end of file.
# Now the child can only write *through* the descriptor the runner opened for
# it; the names are in a directory it cannot change. The read still refuses
# anything but a regular file and never follows a link, as a second line.
#
# The read is also bounded: at most OUTPUT_LIMIT + 1 bytes ever reach memory,
# whatever the child wrote. It used to read the whole file and truncate after,
# so output that outgrew the runner's heap ended the request with an
# OutOfMemoryError and no response. The disk side is the sandbox's: the unit
# runs with LimitFSIZE (sandbox/run-sandboxed.sh).
#
# Why a file and not a pipe: a pipe needs the runner to keep draining it, and
# once the child is gone the JDK drains whatever is left into memory with no
# bound of its own, which a writer that outlives the direct child (the sandbox
# unit behind a killed `sudo`) keeps refilling. A file has no such reader.
use std/str
use std/bytes
use std/io
use std/io.{Fs, with_fs_real}
use java "java.lang.ProcessBuilder"
use java "java.lang.Process"
use java "java.io.File"
use java "java.io.InputStream"
use java "java.nio.file.Files"
use java "java.nio.file.Path"
use java "java.nio.file.LinkOption"
use java "java.nio.file.attribute.PosixFilePermissions"
use java "java.util.concurrent.TimeUnit"
use java "java.util.UUID"
use java "java.lang.System"
use play/contract.{Outcome, Compiled, CompileError, Timeout}
use play/config.{dawn_bin, java_bin, timeout_secs, compile_timeout_secs, sandbox_enabled, sandbox_script, work_root}

## The most output, in bytes, a response carries. Bytes rather than
## characters because bytes are what the read can bound before decoding.
const OUTPUT_LIMIT: Int = 65536

## The run phase's heap ceiling. The compile phase gets its own from
## run-sandboxed.sh; the program's JVM otherwise aims at a quarter of host
## RAM and meets the unit's MemoryMax as a SIGKILL instead of an
## OutOfMemoryError it can print. Passed on the command line, not through
## JAVA_TOOL_OPTIONS, whose "Picked up" banner would land in the output.
const RUN_HEAP: String = "-Xmx256m"

# Where per-request work dirs live: PLAY_WORK_ROOT if set (the sandbox needs a
# non-/tmp path, see config.work_root), else java.io.tmpdir. Trailing slash is
# dropped (java.io.tmpdir carries one on macOS) so paths match diagnostics.
fn temp_root() -> String !io = {
  let configured = work_root()
  let d = if configured != "" {
    configured
  } else {
    match System.getProperty("java.io.tmpdir") {
      Some(v) -> v
      None -> "/tmp"
    }
  }
  str.strip_suffix(d, "/").unwrap_or(d)
}

# How many bytes the UTF-8 sequence led by `b` occupies, 1 for anything that
# does not lead a multi-byte sequence.
fn utf8_width(b: Int) -> Int =
  if b >= 0xF8 { 1 } else if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 1 }

# `b` without a multi-byte sequence the cut at its end left incomplete, so a
# truncation never shows up as a replacement character.
fn whole_chars(b: Bytes) -> Bytes = {
  let n = bytes.len(b)
  var i = n - 1
  # step back over at most three continuation bytes to the sequence's lead
  while i >= 0 && i > n - 4 && (bytes.at(b, i) & 0xC0) == 0x80 {
    i = i - 1
  }
  if i >= 0 && i + utf8_width(bytes.at(b, i)) > n { bytes.slice(b, 0, i) } else { b }
}

fn close_in(s: InputStream) -> Unit !io = {
  let _ = catch_fault(() => s.close())
  ()
}

# The first OUTPUT_LIMIT bytes of the file at `path`, decoded, and whether
# there was more. Anything but a regular file, links included, reads as empty:
# the runner created this file itself, so anything else means something else
# put it there. A read that fails reads as empty too; the outcome still says
# whether the program finished.
fn read_capped(path: String) -> (String, Bool) !io = {
  let got = catch_fault(() => {
    let p = Path.of(path)!
    let nofollow = LinkOption.valueOf("NOFOLLOW_LINKS")!
    if not Files.isRegularFile(p, nofollow) {
      ("", false)
    } else {
      with s <- bracket(Files.newInputStream(p, nofollow)!, close_in)
      let raw = s.readNBytes(OUTPUT_LIMIT + 1)!
      if bytes.len(raw) > OUTPUT_LIMIT {
        (bytes.decode_utf8_lossy(whole_chars(bytes.slice(raw, 0, OUTPUT_LIMIT))), true)
      } else {
        (bytes.decode_utf8_lossy(raw), false)
      }
    }
  })
  match got {
    Ok(v) -> v
    Err(_) -> ("", false)
  }
}

# Strip the throwaway temp directory out of diagnostics so users see a clean
# "prog.dawn:line:col" instead of /var/folders/.../dawn-play-<uuid>/prog.dawn.
# The run phase's output goes through it too. The compiler no longer bakes
# the path it was handed into a position (dawn-lang #401: an `x!` failure
# says `at prog.dawn:4`), so this is defence in depth: a runtime error that
# names a file under the staging directory, or the directory itself, still
# does not hand the server's work root to the browser. The bare directory
# reads as `.`, which is what it is relative to the files the user sees.
fn strip_dir(text: String, dir: String) -> String =
  join(str.split(join(str.split(text, "${dir}/"), ""), dir), ".")

# A child's output as the response shows it: capped, then the request's
# directories stripped from what is left (the box first, since its path
# starts with the request directory's), then the truncation marked.
fn shown(path: String, dir: String, box: String) -> (String, Bool) !io = {
  let (raw, cut) = read_capped(path)
  let clean = strip_dir(strip_dir(raw, box), dir)
  if cut { (clean ++ "\n… (output truncated)", true) } else { (clean, false) }
}

# Prepend the sudo-whitelisted sandbox wrapper: `run <unit id> <box> <argv>`
# runs argv inside a throwaway systemd unit named after the id (stage 4d), and
# `stop <unit id>` ends that unit. Only PLAY_UNSAFE_LOCAL=1 leaves argv
# unchanged; config.sandbox_enabled is fail-closed. `box` is the only
# directory the unit can write.
fn sandboxed(unit: String, box: String, argv: List[String]) -> List[String] !io =
  if sandbox_enabled() {
    ["sudo", "-n", sandbox_script(), "run", unit, box] ++ argv
  } else {
    argv
  }

# How to end the unit a timed-out phase is still running, or nothing when
# there is no unit.
fn stop_argv(unit: String) -> List[String] !io =
  if sandbox_enabled() { ["sudo", "-n", sandbox_script(), "stop", unit] } else { [] }

# A fresh unit id: 32 lowercase hex digits, the only shape the wrapper takes.
fn fresh_unit() -> String !io =
  str.replace(UUID.randomUUID().expect("uuid").toString().expect("uuid string"), "-", "")

## How long a `stop` may take before the runner gives up on it. The unit's
## own TimeoutStopSec is 3 s; past this the unit's RuntimeMaxSec is the
## backstop.
const STOP_SECS: Int = 10

# Wait up to `secs` for `proc`. On a timeout, stop it and wait until it has
# ended, so the gate is released only when the work is gone; answer whether it
# finished on its own.
#
# Under the sandbox `proc` is `sudo`, and the work is a systemd unit that
# `systemd-run --wait` started on its behalf. A SIGKILL to `sudo` does not
# reach the unit, and an unprivileged runner may not be allowed to signal a
# root `sudo` at all. Killing only `proc` therefore either let the unit run
# on to RuntimeMaxSec while the gate admitted the next request, or blocked
# here until it did. `stop` ends the unit, after which `systemd-run`, and
# `sudo` with it, exits by itself; `destroyForcibly` is left for the
# unsandboxed case, where `proc` is the work.
fn finish_or_stop(proc: Process, secs: Int, stop: List[String]) -> Bool !io = {
  let unit = TimeUnit.valueOf("SECONDS").expect("seconds")
  if proc.waitFor(secs, unit) {
    true
  } else {
    if len(stop) > 0 {
      let sp = ProcessBuilder.new(stop)
      sp.redirectErrorStream(true)
      sp.redirectOutput(File.new("/dev/null"))
      match sp.start() {
        Some(s) ->
          if not s.waitFor(STOP_SECS, unit) {
            let _ = s.destroyForcibly()
            ()
          }
        None -> ()
      }
    }
    proc.destroyForcibly()
    proc.waitFor()
    false
  }
}

# Set a directory's mode outright, umask aside, without a child process.
fn set_mode(dir: String, mode: String) -> Unit !io = {
  let _ = Files.setPosixFilePermissions(Path.of(dir)!, PosixFilePermissions.fromString(mode)!)
  ()
}

# Under the sandbox each phase runs as a fresh DynamicUser (a different
# transient uid), so the box must be world-writable for the compiler to write
# the jar and the JVM to read it back, and the request directory must be
# traversable but nothing more. The name is an unguessable uuid and the work
# root is 0711, so neither can be listed or found.
fn open_box(dir: String, box: String) -> Unit !io =
  if sandbox_enabled() {
    set_mode(dir, "rwx--x--x")
    set_mode(box, "rwxrwxrwx")
  } else {
    ()
  }

# Remove a per-request work dir. The runner owns it, and the 0777 box inside,
# so it can unlink files there even though the sandbox's DynamicUser wrote
# them. `rm -rf` does not follow links.
fn cleanup(dir: String) -> Unit !io = {
  let p = ProcessBuilder.new(["rm", "-rf", dir])
  p.start().expect("rm").waitFor()
  ()
}

# A fresh request directory under the work root, not yet created.
fn fresh_dir() -> String !io = {
  let id = UUID.randomUUID().expect("uuid").toString().expect("uuid string")
  "${temp_root()}/dawn-play-${id}"
}

# Stage the source into a fresh box and run `body` with the request directory
# and the box, removing the directory on every way out: a normal return, a
# panic, and a JVM Error (bracket catches Throwable on the JVM). Without it, a
# failure between staging and cleanup left the directory, and whatever the
# child had written into it, on disk for good.
fn with_request(code: String, body: fn(String, String) -> Outcome !io) -> Outcome !Fs !io = {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  let box = "${d}/box"
  # write_file creates parent directories as needed
  match io.write_file("${box}/prog.dawn", code) {
    Err(e) -> CompileError("cannot stage source: ${e}")
    Ok(_) -> {
      open_box(d, box)
      body(d, box)
    }
  }
}

# Run `dawn build` on the staged source. Ok(ms), or Err(diagnostics) with the
# request's directories stripped. Shared by execute (/run) and check.
#
# The compiler gets its own wall-clock limit, and it needs one as much as the
# run phase does: `comptime` executes user code *inside the compiler*, and a
# long enough fold can block there for as long as it likes. This used to
# be a bare waitFor(). Production's systemd RuntimeMaxSec=15 caught it, but only
# for the deployment that had the sandbox on — locally, and anywhere the sandbox
# is off, one request could hold a compiler process forever and, with a gate
# permit in hand, keep the next request out too.
#
# The budget is `compile_timeout_secs()` — separate from the run budget, since
# a cold compiler is legitimately slower than the program it produces. The
# diagnostics are capped like the run output: comptime can print too.
fn compile_phase(dir: String, box: String) -> Result[Int, String] !io = {
  let build_out = "${dir}/build.txt"
  let unit = fresh_unit()
  let bp = ProcessBuilder.new(sandboxed(unit, box, [dawn_bin(), "build", "${box}/prog.dawn", "-o", "${box}/prog.jar"]))
  bp.redirectErrorStream(true)
  bp.redirectOutput(File.new(build_out))
  let started = System.nanoTime()
  let build = bp.start().expect("failed to start compiler")
  if not finish_or_stop(build, compile_timeout_secs(), stop_argv(unit)) {
    Err("compilation timed out after ${compile_timeout_secs()}s")
  } else if build.exitValue() != 0 {
    let (diags, _) = shown(build_out, dir, box)
    Err(str.trim(diags))
  } else {
    Ok((System.nanoTime() - started) / 1000000)
  }
}

# Compile-only entry for /check (editor diagnostics): stage and compile, never
# run. Success carries no output — the client only cares whether diagnostics
# exist. Same sandbox as /run: comptime executes user code at compile time.
## Both entry points install the file system handler themselves: main hands
## them to `with_gate` as a `fn() -> T !io` body, a closed row the label
## cannot travel through (spec §6.5), and one snippet's staging directory is
## the whole unit of file work anyway.
pub fn check(code: String) -> Outcome !io = with_fs_real(() => with_request(code, check_staged))

pub fn execute(code: String) -> Outcome !io = with_fs_real(() => with_request(code, execute_staged))

fn check_staged(dir: String, box: String) -> Outcome !io =
  match compile_phase(dir, box) {
    Err(diags) -> CompileError(diags)
    Ok(ms) -> Compiled("", 0, false, ms)
  }

fn execute_staged(dir: String, box: String) -> Outcome !io =
  match compile_phase(dir, box) {
    Err(diags) -> CompileError(diags)
    Ok(_) -> run_phase(dir, box)
  }

# Phase 2: run the compiled jar under a wall-clock limit.
fn run_phase(dir: String, box: String) -> Outcome !io = {
  let run_out = "${dir}/run.txt"
  let unit = fresh_unit()
  let rp = ProcessBuilder.new(sandboxed(unit, box, [java_bin(), RUN_HEAP, "-jar", "${box}/prog.jar"]))
  rp.redirectErrorStream(true)
  rp.redirectOutput(File.new(run_out))
  let started = System.nanoTime()
  let proc = rp.start().expect("failed to start program")
  if finish_or_stop(proc, timeout_secs(), stop_argv(unit)) {
    let ms = (System.nanoTime() - started) / 1000000
    let (out, cut) = shown(run_out, dir, box)
    Compiled(out, proc.exitValue(), cut, ms)
  } else {
    let (out, _) = shown(run_out, dir, box)
    Timeout(out)
  }
}

# The compiler release this runner compiles with, for /health and so for the
# version the editor shows: "0.81.0" out of `dawn --version`'s
# "dawn 0.81.0 (selfhost)", and the build, "b1:2bfef5fb3622", the short digest
# of the sources that compiler was built from, which `--version` appends when
# its jar carries a build manifest (docs/build-info-design.md). The version
# alone cannot tell a release from a later main build: both say 0.81.0.
# Asked once at startup, not per request, because the answer only changes
# with a redeploy, which restarts this process.
#
# The probe runs before the socket opens and redeploy.sh gives the whole
# restart 28 seconds of health checks, so it has a 5-second budget of its
# own instead of the compile budget. A probe that fails or times out answers
# "" for both, and /health still says ok: they are labels, not a liveness test.
# Unsandboxed: it runs the operator's own binary with a fixed argv.
pub type CompilerId = { version: String, build: String }

pub fn compiler_id() -> CompilerId !io = {
  let id = UUID.randomUUID().expect("uuid").toString().expect("uuid string")
  with out <- bracket("${temp_root()}/dawn-play-version-${id}.txt", cleanup)
  let p = ProcessBuilder.new([dawn_bin(), "--version"])
  p.redirectErrorStream(true)
  p.redirectOutput(File.new(out))
  let unknown = CompilerId { version: "", build: "" }
  match p.start() {
    None -> unknown
    Some(proc) -> {
      let secs = TimeUnit.valueOf("SECONDS").expect("seconds")
      if proc.waitFor(5, secs) {
        let (text, _) = read_capped(out)
        id_of(text)
      } else {
        proc.destroyForcibly()
        proc.waitFor()
        unknown
      }
    }
  }
}

# The words after "dawn " on the first line that starts with it. bin/dawn may
# print toolchain chatter ("resolving 2 java-deps ...") before it.
fn dawn_words(text: String) -> List[String] = {
  for line in str.split(text, "\n") {
    match str.strip_prefix(line, "dawn ") {
      Some(rest) -> return str.split(str.trim(rest), " ")
      None -> ()
    }
  }
  []
}

# The second word of the `dawn <version> ...` line.
fn version_of(text: String) -> String =
  match dawn_words(text) {
    [v, ..] -> str.trim(v)
    [] -> ""
  }

# The version and the `b1:` word after it, if there is one: an older compiler
# prints none, and then the build is "" like an unknown version.
fn id_of(text: String) -> CompilerId = {
  var build = ""
  for w in dawn_words(text) {
    if build == "" && str.starts_with(w, "b1:") { build = str.trim(w) }
  }
  CompilerId { version: version_of(text), build: build }
}

test "version_of skips launcher chatter" {
  assert version_of("resolving 2 java-deps from x\ndawn 0.81.0 (selfhost)\n") == "0.81.0"
  assert version_of("dawn 0.81.0") == "0.81.0"
  assert version_of("no such file\n") == ""
}

test "id_of takes the build digest when the compiler prints one" {
  assert id_of("resolving 2 java-deps from x\ndawn 0.83.0 (selfhost) b1:2bfef5fb3622\n") ==
    CompilerId { version: "0.83.0", build: "b1:2bfef5fb3622" }
  assert id_of("dawn 0.81.0 (selfhost)\n") == CompilerId { version: "0.81.0", build: "" }
  assert id_of("no such file\n") == CompilerId { version: "", build: "" }
}

# Test-only: run a fixed argv to completion.
fn sh_run(argv: List[String]) -> Unit !io = {
  ProcessBuilder.new(argv).start().expect("start").waitFor()
  ()
}

test "whole_chars drops only a sequence the cut left incomplete" {
  let e = bytes.utf8("aé")
  assert whole_chars(bytes.slice(e, 0, 2)) == bytes.utf8("a")
  assert whole_chars(e) == e
  let wide = bytes.utf8("a😀")
  assert whole_chars(bytes.slice(wide, 0, 4)) == bytes.utf8("a")
  assert whole_chars(wide) == wide
  assert whole_chars(bytes.utf8("")) == bytes.utf8("")
}

test "read_capped holds at most the limit and says it cut" {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  with_fs_real(() => {
    let line = str.repeat("x", 1023) ++ "\n"
    # twenty times the limit, which the old read held whole
    assert match io.write_file("${d}/big.txt", str.repeat(line, 20 * 64)) { Ok(_) -> true, Err(_) -> false }
    assert match io.write_file("${d}/small.txt", "hi\n") { Ok(_) -> true, Err(_) -> false }
  })
  let (big, cut) = read_capped("${d}/big.txt")
  assert cut
  assert str.len(big) == OUTPUT_LIMIT
  assert read_capped("${d}/small.txt") == ("hi\n", false)
  assert read_capped("${d}/absent.txt") == ("", false)
}

test "read_capped neither follows a link nor waits on a special file" {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  with_fs_real(() => {
    assert match io.write_file("${d}/secret.txt", "secret\n") { Ok(_) -> true, Err(_) -> false }
  })
  sh_run(["ln", "-s", "${d}/secret.txt", "${d}/link.txt"])
  sh_run(["mkfifo", "${d}/fifo.txt"])
  assert read_capped("${d}/link.txt") == ("", false)
  # a FIFO with no writer would block an open for good; this returning at all
  # is half the assertion
  assert read_capped("${d}/fifo.txt") == ("", false)
  # and the link's target is still readable when asked for by its own name
  assert read_capped("${d}/secret.txt") == ("secret\n", false)
}

test "shown strips the box before the request directory, then marks a cut" {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  let box = "${d}/box"
  with_fs_real(() => {
    assert match io.write_file("${d}/out.txt", "${box}/prog.dawn:1:1 in ${d}\n") { Ok(_) -> true, Err(_) -> false }
  })
  assert shown("${d}/out.txt", d, box) == ("prog.dawn:1:1 in .\n", false)
}

# Test-only: a request body that fails after the box exists, naming its
# request directory so the test can look for it afterwards. The `|` ends the
# name; the panic appends its call site after it.
fn fails_in(dir: String, box: String) -> Outcome !io = panic(dir ++ "|")

test "with_request removes the request directory when the body fails" {
  let failed: Result[Outcome, ForeignError] = catch_panic(() => with_fs_real(() => with_request("x", fails_in)))
  let named = match failed {
    Ok(_) -> ""
    Err(e) -> str.split(e.message, "|").get(0).unwrap_or("")
  }
  assert str.contains(named, "/dawn-play-")
  assert not Files.exists(Path.of(named)!, LinkOption.valueOf("NOFOLLOW_LINKS")!)
}

# Test-only: a stand-in for the sandbox wrapper with the property that matters.
# `run` starts the work in the background and waits for it, so killing the
# wrapper leaves the work running, as killing `sudo` leaves the unit; `stop`
# ends the work by the pid `run` recorded under the unit id.
fn fake_wrapper(d: String) -> String !io = {
  let path = "${d}/fake-sandbox.sh"
  let body =
    "#!/bin/sh\n" ++
    "d=\$(dirname \"\$0\")\n" ++
    "case \"\$1\" in\n" ++
    "  run) id=\$2; shift 2; \"\$@\" & echo \$! > \"\$d/\$id.pid\"; wait \$! ;;\n" ++
    "  stop) kill \"\$(cat \"\$d/\$2.pid\")\" ;;\n" ++
    "esac\n"
  let _ = with_fs_real(() => io.write_file(path, body))
  path
}

# Test-only: whether the pid recorded for `unit` is still a live process.
fn alive(d: String, unit: String) -> Bool !io = {
  let pid = with_fs_real(() => match io.read_file("${d}/${unit}.pid") {
    Ok(t) -> t
    Err(_) -> ""
  })
  let p = ProcessBuilder.new(["kill", "-0", str.trim(pid)]).start().expect("start")
  p.waitFor() == 0
}

test "a timed-out phase is stopped through the wrapper, not only killed" {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  let fake = fake_wrapper(d)
  let unit = fresh_unit()
  assert str.len(unit) == 32
  let p = ProcessBuilder.new(["sh", fake, "run", unit, "sleep", "30"]).start().expect("start")
  assert not finish_or_stop(p, 1, ["sh", fake, "stop", unit])
  # the work the wrapper started is gone by the time the phase returns
  assert not alive(d, unit)
}

test "with no stop command a timed-out wrapper's work outlives it" {
  # the shape of the bug, kept as the control: killing the wrapper alone
  # leaves its work running
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  let fake = fake_wrapper(d)
  let unit = fresh_unit()
  let p = ProcessBuilder.new(["sh", fake, "run", unit, "sleep", "30"]).start().expect("start")
  assert not finish_or_stop(p, 1, [])
  assert alive(d, unit)
  sh_run(["sh", fake, "stop", unit])
}

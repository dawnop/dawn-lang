# A trait call's witness is determined by its actual argument substitution,
# not merely by the existence of a dictionary in the saved frame. This closed
# class checks that relationship under a freshly reconstructed caller entry;
# it never executes expressions or admits concrete implementation witnesses.
use std/map
use check/checker
use check/cx.{Cx}
use check/types.{Ty, TyInt, TyVar, Sig, Sym, Eff, EPure, subst}
use check/tast.{TExpr, XInt, XLocal, XCallFn, XBinary, XUnary, XBlock,
  BAdd, BSub, BMul, BDiv, BMod, UNeg, WForward, WitRef, tex_ty }
use check/body_product.{Product}
use check/semantic_reads
use check/semantic_reads.{FunctionRead}
use front/ast.{FnDecl, Expr, EInt, EVar, EApply, EBinary, EUnary, EBlock,
  OpAdd, OpSub, OpMul, OpDiv, OpMod, OpNeg }

pub fn header(d: FnDecl, sig: Sig) -> Bool = {
  if sig.inferring || sig.is_builtin || sig.trait_id != None || sig.op_of != None ||
    sig.eff != EPure || sig.ret != TyInt || len(sig.constraints) == 0 ||
    len(sig.constraints) != len(sig.tparams) || len(d.tparams) != len(sig.tparams) ||
    len(sig.eparams) != 0 || len(d.eparams) != 0 || len(d.effs) != 0 ||
    len(d.params) != len(sig.param_tys) || len(d.params) != len(sig.param_names) ||
    len(d.params) != len(sig.param_defaults) { return false }
  match d.ret { None -> return false, Some(_) -> () }
  for present in sig.param_defaults { if present { return false } }
  var index = 0
  for parameter in d.params {
    match parameter.default { Some(_) -> return false, None -> () }
    if parameter.name != sig.param_names[index] || not carried(sig, sig.param_tys[index]) { return false }
    index = index + 1
  }
  syntax(d.body)
}

fn carried(sig: Sig, ty: Ty) -> Bool = {
  if ty == TyInt { return true }
  for parameter in sig.tparams { if parameter == ty { return true } }
  false
}

fn syntax(e: Expr) -> Bool = match e {
  EInt(_, _, _) -> true
  EVar(_, _, _) -> true
  EApply(EVar(_, _, _), args, _, _) -> {
    for argument in args {
      match argument.name { Some(_) -> return false, None -> () }
      if argument.trailing || not syntax(argument.e) { return false }
    }
    true
  }
  EBinary(op, left, right, _, _, _, _) ->
    (op == OpAdd || op == OpSub || op == OpMul || op == OpDiv || op == OpMod) && syntax(left) && syntax(right)
  EUnary(OpNeg, operand, _, _) -> syntax(operand)
  EBlock(statements, Some(tail), _, _) -> len(statements) == 0 && syntax(tail)
  _ -> false
}

# This is deliberately separate from the ordinary-callee index. The canonical
# named-function resolver retains local/std lookup precedence and trait identity.
pub(pkg) fn callee(cx: Cx, owner: Option[String], name: String, builtin: Bool, trait_id: Option[Int]) -> Option[Sig] = {
  if builtin { return None }
  let tid = trait_id?
  let found = checker.lookup_fn_sig(cx, name)?
  if found.owner != owner || found.name != name || found.trait_id != Some(tid) ||
    found.is_builtin || found.inferring || found.op_of != None || found.eff != EPure ||
    found.ret != TyInt || len(found.eparams) != 0 || len(found.tparams) == 0 ||
    len(found.constraints) != len(found.tparams) ||
    len(found.param_names) != len(found.param_tys) || len(found.param_defaults) != 0 { return None }
  # Canonical trait method signatures use an empty defaults vector: trait
  # parameter defaults are forbidden, unlike ordinary padded false vectors.
  for ty in found.param_tys { if not carried(found, ty) { return None } }
  Some(found)
}

pub fn read_allowed(read: FunctionRead) -> Bool = match read {
  semantic_reads.TraitName(_, _) -> true
  semantic_reads.FunctionAnswer(q) -> match q.answer { Some(s) -> s.trait_id != None, None -> false }
  semantic_reads.ReducedAssociatedType(_, _) -> true
  semantic_reads.ReducedTypeEffects(_, _, _) -> true
  semantic_reads.ReducedEffect(_, _, _) -> true
  semantic_reads.ConcreteType(_, _) -> true
  semantic_reads.UnifiedTypes(_) -> true
  semantic_reads.DictionarySymbol(_, _, _) -> true
  semantic_reads.AssignableType(_, _, _) -> true
  _ -> false
}

# The recording selects a bounded claim without inventing an old entry Cx.
# Candidate entry proof checks every slot, symbol and frame before a hit.
pub(pkg) fn recorded(d: FnDecl, sig: Sig, product: Product) -> Option[Map[Int, Sym]] = {
  if not header(d, sig) || product.tree.name != d.name || product.tree.sig != sig ||
    len(product.diagnostics) != 0 || len(product.signatures) != 0 || len(product.aliases) != 0 ||
    len(product.bounds) != 0 || len(product.tree.ev_syms) != 0 || len(product.tree.dict_syms) == 0 { return None }
  let reads = product.function_reads?
  if len(reads) == 0 { return None }
  for read in reads { if not read_allowed(read) { return None } }
  var symbols: Map[Int, Sym] = map.empty()
  for change in product.symbols {
    let symbol = change.value?
    if map.has(symbols, change.key) { return None }
    symbols = map.insert(symbols, change.key, symbol)
  }
  Some(symbols)
}

pub(pkg) fn expression(cx: Cx, caller: Sig, e: TExpr) -> Bool = match e {
  XInt(_, _, _) -> true
  XLocal(id, name, _, _, ty) -> match map.get(cx.syms, id) {
    Some(symbol) -> {
      if symbol.name != name || symbol.ty != ty || not carried(caller, ty) || symbol.mutable ||
        symbol.dict_of != None || symbol.ev_of != None || symbol.cell_of != None { return false }
      # Only the independently generated entry parameters may appear as values.
      for scope in cx.frame.scopes {
        if map.get(scope, name) == Some(id) { return true }
      }
      false
    }
    None -> false
  }
  XBinary(op, left, right, witness, _, _, _, _, ty) -> {
    match witness { Some(_) -> return false, None -> () }
    (op == BAdd || op == BSub || op == BMul || op == BDiv || op == BMod) &&
      ty == TyInt && tex_ty(left) == TyInt && tex_ty(right) == TyInt &&
      expression(cx, caller, left) && expression(cx, caller, right)
  }
  XUnary(UNeg, operand, _, _, ty) ->
    ty == TyInt && tex_ty(operand) == TyInt && expression(cx, caller, operand)
  XBlock(statements, Some(tail), _, _, ty) ->
    len(statements) == 0 && ty == tex_ty(tail) && expression(cx, caller, tail)
  XCallFn(owner, name, args, witnesses, evidence, trait_id, lo, hi, result) -> {
    let target = match callee(cx, owner, name, false, trait_id) { Some(s) -> s, None -> return false }
    if len(args) != len(target.param_tys) || len(evidence) != 0 { return false }
    var types: Map[Int, Ty] = map.empty()
    var effects: Map[Int, Eff] = map.empty()
    var index = 0
    for argument in args {
      if not expression(cx, caller, argument) || not carried(caller, tex_ty(argument)) { return false }
      let (next_types, next_effects, matched) = checker.unify_into(cx, target.param_tys[index], tex_ty(argument), types, effects)
      if not matched || map.len(next_effects) != 0 { return false }
      types = next_types
      effects = next_effects
      index = index + 1
    }
    if subst(target.ret, types, effects) != result || result != TyInt { return false }
    var expected: List[WitRef] = []
    index = 0
    for parameter in target.tparams {
      let id = match parameter { TyVar(_, binder) -> binder, _ -> return false }
      let subject = match map.get(types, id) { Some(ty) -> ty, None -> return false }
      let binder = match subject { TyVar(_, own) -> own, _ -> return false }
      if not carried(caller, subject) { return false }
      for bound in target.constraints[index] {
        let (resolved, witness) = checker.resolve_witness(cx, bound, subject, cx.owner_lo + lo, cx.owner_lo + hi, "`" ++ name ++ "`")
        if len(resolved.diags) != len(cx.diags) { return false }
        match witness {
          Some(WForward(symbol)) -> {
            if map.get(cx.frame.dict_syms, (binder, bound)) != Some(symbol) { return false }
            expected = expected ++ [WForward(symbol)]
          }
          _ -> return false
        }
      }
      index = index + 1
    }
    len(expected) != 0 && witnesses == expected
  }
  _ -> false
}

# Whole-container arguments to std/list functions reached as ordinary
# CDirect calls (unlike xs[i], which is the list_index intrinsic and outside
# the mode table's reach -- that boundary is pvec_index.dawn's subject). The
# copies are read afterwards so original and copy are both live across the
# flipped calls.
use std/list

pub fn main() -> Unit !io = {
  var xs: List[Int] = []
  var i = 0
  while i < 40 {
    xs = xs ++ [i * 3]
    i = i + 1
  }
  let ys = list.reverse(xs)
  let zs = list.take(xs, 5)
  println(to_string(ys[0]) ++ " " ++ to_string(ys[39]) ++ " " ++
    to_string(zs[4]) ++ " " ++ to_string(xs[0]))
}

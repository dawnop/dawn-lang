# The String Len impl's parameter (len(s)) flows onward into an owned position (count) -- the
# "borrowed root dup'ed at a consuming use" account, distinct from
# cursor_scan's pure borrow-position reads.

pub fn main() -> Unit !io = {
  var total = 0
  var i = 0
  while i < 50 {
    total = total + len(to_string(i * 31) ++ "x")
    i = i + 1
  }
  println(to_string(total))
}

# Inputs come from argv so C optimization cannot fold the rounding witness.
# Both expression shapes occur in polynomial evaluation; either can contract.
use std/narrow

fn subtract_product(a: Float, b: Float, c: Float) -> Float = a - b * c
fn add_product(a: Float, b: Float, c: Float) -> Float = b * c + a

pub fn main() -> Unit !io = {
  let xs = args()
  let a = parse_float(xs[0]).expect("a")
  let b = parse_float(xs[1]).expect("b")
  let c = parse_float(xs[2]).expect("c")
  println(to_string(narrow.f64_bits(subtract_product(a, b, c))))
  println(to_string(narrow.f64_bits(add_product(-a, b, c))))
}

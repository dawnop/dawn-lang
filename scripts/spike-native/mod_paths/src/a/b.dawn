# Half of the pair that made the C backend mint one symbol for two modules:
# `a/b` and `a_b` both folded to `dawn_a_b__*`. Every declaration here has a
# twin of the same name in `a_b.dawn`, so a lossy escape shows up as `cc`
# refusing the program, not as a wrong answer.

pub fn who() -> String = "a/b"

pub fn scale(xs: List[Int]) -> List[Int] = map(xs, x => x * 2)

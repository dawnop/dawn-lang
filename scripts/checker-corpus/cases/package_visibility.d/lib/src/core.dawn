# The package this case imports from. Its `pub(pkg)` names are the
# seam a sibling module of the same package may use and the importing
# project may not.
pub(pkg) type Seam = { n: Int }

pub(pkg) fn seam(n: Int) -> Seam = Seam { n: n }

pub(pkg) const LIMIT: Int = 3

pub(pkg) effect Trace {
  fn trace(msg: String) -> Unit
}

pub fn api(n: Int) -> Int = seam(n).n + LIMIT

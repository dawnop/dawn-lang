# The char_is_* intrinsics over the ASCII range, where both backends must
# agree exactly. Above U+007F the native runtime has no Unicode table and
# panics rather than guess, so this corpus deliberately stays inside ASCII --
# see runtime/c/dawn_rt.h. A corpus that classified CJK would not be a harder
# test of the same thing, it would be a test of a feature native does not have.
#
# Written without a list literal on purpose: emitc has no collections until
# D1-D3, and this corpus is about classification, not about containers.

fn show6(c: Int) -> String =
  to_string(char_is_letter(c)) ++ to_string(char_is_digit(c)) ++
  to_string(char_is_alnum(c)) ++ to_string(char_is_upper(c)) ++
  to_string(char_is_lower(c)) ++ to_string(char_is_space(c))

fn line(c: Int) -> String = to_string(c) ++ " " ++ show6(c)

pub fn main() -> Unit !io = {
  println(line('A'))
  println(line('z'))
  println(line('0'))
  println(line('_'))
  println(line(' '))
  println(line('\t'))
  println(line('\n'))
  println(line('~'))
}

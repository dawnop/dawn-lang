# Explicit contracts exercise data introduction and nominal boundaries.
use std/mem
type Box[T] = { value: T }
fn wrap[T: ^{c}, ^c](value: T) -> Box[T] = Box { value = value }
fn probe() -> Int = mem.with_mem([@s] () => { let x: Box[I64Buf@s] = wrap(mem.new(3))
  len(x.value) })
pub fn main() -> Unit !io = println(to_string(probe()))

# Structural tuple ordering still requires Ord for every element and every
# nested element. Float deliberately has no Ord implementation; Bool has one
# since 2026-09-24, so the first function is the positive control.

pub fn bool_part(a: (Int, Bool), b: (Int, Bool)) -> Int = cmp(a, b)

pub fn nested_float_part(a: (Int, (String, Float)), b: (Int, (String, Float))) -> Bool = a < b

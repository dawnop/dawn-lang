# The kernels scripts/tile-golden pins. Each is traced twice (the two records
# must be equal, or this program panics) and then either rendered once, the
# text being the layer-0 golden, or encoded once into the bytecode file the
# layer-1 golden pins and `tileiras` assembles. run.sh copies this file to
# src/main.dawn of a project whose [deps] names packages/tileir, and runs it
# as `kernels <name>` (text to stdout), `kernels <name> --bytecode <path>`
# (bytes to the file) or `kernels --bytecode-version` (the header's version,
# which run.sh holds against toolchain.txt).
use std/list
use std/io.{with_fs_real, write_bytes}
use std/gpu.{F64, F32, BF16, F16, I32, I8, I16, I64, TF32, F8E4M3FN, F8E5M2, F8E8M0FNU, I4, F4E2M1FN}
use std/narrow.{Rounding}
use tileref/ref.{global_table_a, global_table_b, global_syms_c}
use tileir/dev.{Dev, Param, Tile, Idx, I1, param, block_id, tile_at, load, store, row_major, permute, coord,
  and_mask, or_mask, in_range, axis_mask, gather, scatter, axis_strides, ge_i, mmaf, addf, sub, mul, div, maxf, minf,
  neg, abs, fma, f_const, lt, le, gt, ge, eq, ne, eq_i, select, tail_mask, idx_const, idx_add, idx_mul, idx_eq,
  d_for, d_for2, d_for3, d_loop, d_loop2, exp, exp2, log, log2, sqrt, rsqrt, tanh, floor, ceil, pow, lanes, d_reduce,
  d_reduce2, d_if, i_const, add_i, sub_i, mul_i, Overflow, div_i, rem_i, max_i, min_i, mulhi_i, and_i,
  or_i, xor_i, shl_i, shr_i, lt_i, shr_u, neg_i, abs_i, int_to_float, float_to_int, mask_to_int, int_to_mask,
  bits_to_float, bits_to_int, float_to_float, ext_u8, trunc_u8, mmai, d_return_if, pack_bytes, unpack_bytes, ext_i4,
  ext_u4, trunc_i4, arange, d_assert, d_print, assume_div_by, assume_same_elements, assume_in_range, d_scan, d_scan2,
  erf, sin, cos, tan, sinh, cosh, atan2, remf, extract, cat, permute_tile, num_blocks, d_fork2, insert, powi, ptrs,
  ptr_offset, ptr_to_int, int_to_ptr, ptr_to_ptr, load_ptrs, store_ptrs, i64_const, add_i64, d_global, Visibility,
  global_ptrs, alloca_ptrs, mmaf_scaled, addi, subi, muli, shli, shri, consti, sqrt_approx, eq_u, ne_u, lt_u, le_u,
  gt_u, ge_u, atomic_rmw, Hints, for_arch, hint_num_cta_in_cga, hint_num_worker_warps_per_cta, hint_occupancy,
  hint_latency, tensor_view, partition_view, load_view, store_view, tensor_view_dyn, tensor_dim, index_space_dim,
  idx_of, Dyn, strided_view, gather_scatter_view, load_gather, atomic_red_view, At, Rows, NoPadding, PadZero,
  PadNegZero, PadNan, PadPosInf, PadNegInf, Padding, broadcast, reshape, idx_as_tile, le_i, atomic_cas, atomic_add, load_cell, load_at,
  store_cell, store_sub, zeros, reduce_sum, reduce_max, d_range, DYN_DIM }
use tileir/prog.{TileProg, Cells, trace_kernel, trace1, trace2, trace3, trace4, trace5, cells, In, Out, Shared,
  Whole, FREE_AXIS }
use tileir/render.{render}
use tileir/bytecode.{encode, bytecode_version}

# f64 vector add over 128-wide tiles: the first milestone's kernel
# (tile-backend-design 1), and the shape std/gpu's vadd_ref answers for.
#
# Since the batch's PR-3 every one of its three parameters is cut into
# cells of 128 (`run_of(128)`, a run as long as the grid makes it), so the
# body names no shape and no offset: the cells are the addressing.
fn vadd(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev =
  store_cell(out, addf(load_cell(a), load_cell(b)))

# The same kernel over f32 and 64-wide tiles: the case that reds when a load
# stops reading its parameter's format (run.sh's load-dtype-f64 mutant).
fn vadd_f32(a: Param[F32], b: Param[F32], out: Param[F32]) -> Unit !Dev =
  store_cell(out, addf(load_cell(a), load_cell(b)))

# The same kernel over bf16 and 128-wide tiles: the second milestone's format
# (tile-backend-design 3.2). `addf` over a bf16 tile with
# `rounding<nearest_even>` is, by the double-rounding theorem, bit for bit
# `narrow.round_bf16` of the exact sum, which is what std/gpu's vadd_ref
# answers for a bf16 output buffer; scripts/tile-gpu-diff holds the device
# to it.
fn vadd_bf16(a: Param[BF16], b: Param[BF16], out: Param[BF16]) -> Unit !Dev =
  store_cell(out, addf(load_cell(a), load_cell(b)))

# f64 block-wise tile sum, the second milestone's loop kernel
# (tile-backend-design 5.2): block b folds the `chunks` consecutive 128-wide
# tiles of x numbered b*chunks .. b*chunks+chunks-1 into one tile of out,
# the first tile entering the loop and the rest added in order, which is
# the order std/gpu's sum_ref adds in. `chunks` is a host constant: fixed
# when the kernel is recorded, 4 in the golden.
#
# `x`'s cells are the chunks and follow no grid axis (the block picks them
# itself, `load_at`); `out`'s are one per block.
fn sum(x: Param[F64], out: Param[F64], chunks: Int) -> Unit !Dev = {
  let b = block_id(0)
  let n = idx_const(chunks)
  let base = idx_mul(b, n)
  let first = load_at(x, [base])
  let one = idx_const(1)
  let lo = idx_add(base, one)
  let up = idx_add(base, n)
  store_cell(out, d_for(lo, up, one, first, (k, t) => addf(t, load_at(x, [k]))))
}

# ---- the boundary kernels (knife 7a) ----
#
# Every kernel below covers a vector whose length is NOT a multiple of the
# tile width, which is the shape every leetgpu problem has: the last block's
# lanes past the end are masked off, so they are neither read nor written,
# and the load answers the padding value there instead. The lengths and the
# widths are host constants, fixed when the kernel is recorded.

# The length and tile width of the 128-wide kernels: 1000 = 7 * 128 + 104, so
# the last of the eight blocks has 24 lanes past the end.
const TAIL_N: Int = 1000
const TAIL_TILE: Int = 128

# The clipping kernel is the second shape: 333 = 5 * 64 + 13, five full
# blocks and 51 lanes past the end of the sixth.
const CLIP_N: Int = 333
const CLIP_TILE: Int = 64

# f64 vector add over a vector of TAIL_N elements: leetgpu 1 (Vector
# Addition) and, over a flattened matrix, 8 (Matrix Addition).
#
# Since the batch's PR-3 the boundary is the cells': `tail_of(TAIL_N,
# TAIL_TILE)` is a tensor of TAIL_N cut into 128-wide cells, so the last
# block's 24 lanes past the end read the padding (0) and are not written.
# The mask the kernels below used to build and carry to every load and
# store is gone; `copy` and `relu` are the same two lines over one cell.
fn vadd_tail(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev =
  store_cell(out, addf(load_cell(a), load_cell(b)))

# Element-wise copy: leetgpu 31 (Matrix Copy). The mask is the whole kernel.
fn copy(x: Param[F64], out: Param[F64]) -> Unit !Dev = store_cell(out, load_cell(x))

# max(x, 0): leetgpu 21 (ReLU).
fn relu(x: Param[F64], out: Param[F64]) -> Unit !Dev = store_cell(out, maxf(load_cell(x), f_const(F64, 0.0)))

# x where x >= 0, 0.01 * x where x < 0: leetgpu 23 (Leaky ReLU). Written with
# `lt` and `select` rather than `maxf`, because that is the shape every
# masked-branch kernel later takes.
fn leaky_relu(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let t = load_cell(x)
  store_cell(out, select(lt(t, f_const(F64, 0.0)), mul(t, f_const(F64, 0.01)), t))
}

# min(max(x, -1), 1) over a second shape: leetgpu 62 (Value Clipping).
fn clip(x: Param[F64], out: Param[F64]) -> Unit !Dev =
  store_cell(out, minf(maxf(load_cell(x), f_const(F64, -1.0)), f_const(F64, 1.0)))

# No leetgpu problem needs this one: it exists so that every operation knife
# 7a added crosses `tileiras` (layer 1) and is computed on the device against
# a hand-written reference (layer 2). An opcode copied from the wrong row of
# the frozen table assembles as some other operation, and the only thing that
# tells `subf` from `divf` is an answer.
#
# The fused multiply-add is `a * 2 + b`: the product is exact, so a host
# reference that multiplies and then adds rounds once as well and the two
# agree bit for bit (a general `fma` does not, and the reference says so).
fn elemops(x: Param[F64], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let two = f_const(F64, 2.0)
  let a = load_cell(x)
  let b = load_cell(y)
  let d = sub(a, b)
  let q = div(mul(a, b), two)
  let v = abs(neg(q))
  let f = fma(a, two, b)
  let s1 = select(lt(a, b), d, v)
  let s2 = select(ge(a, b), s1, f)
  let s3 = select(eq(a, b), minf(a, b), s2)
  let s4 = select(ne(a, b), s3, maxf(a, b))
  let s5 = select(gt(a, b), s4, d)
  store_cell(out, select(le(a, b), s5, v))
}

# ---- the reduction, transcendental and region kernels (knife 7b) ----
#
# Every kernel below covers the WHOLE vector in one tile block: the shape a
# reduction over a vector has, since a reduce folds along a tile's dimension
# and this release has no cross-block reduction. 1000 elements in a
# 1024-wide tile, one block, the last 24 lanes masked off.
#
# The tiers these kernels are compared under are docs/tile-backend-design.md
# 6.5's, and scripts/leetgpu-diff/problems.txt records one per problem:
#
#   exact      every operation is IEEE-exact AND the corpus is one on which
#              every fold order of the reduction gives the same bits (the
#              order is not specified: Tile IR asks the function to be
#              associative and commutative and says nothing about the tree).
#   tolerance  an `exp`, `log`, `tanh`, `pow` or `rsqrt` is in the kernel;
#              those are libdevice approximations and no corpus makes them
#              bit-exact.
const RED_N: Int = 1000
const RED_TILE: Int = 1024

# Monte Carlo integration over [MC_A, MC_B] with RED_N samples: the estimate
# is the sample mean times the width of the interval, and the whole factor
# is one host constant fixed when the kernel is recorded.
const MC_A: Float = 0.0
const MC_B: Float = 2.0

# The epsilon under the root of the RMS normalisation, and the clipping
# half-width of the PPO surrogate: leetgpu's own defaults.
const RMS_EPS: Float = 1.0e-5
const PPO_EPS: Float = 0.2

# The temperature of the DPO loss.
const DPO_BETA: Float = 0.1

# The shape of the loop-and-branch kernel: two blocks, four 128-wide tiles
# each, so its input is 1024 elements and its output 256.
const FOLD_TILE: Int = 128
const FOLD_CHUNKS: Int = 4
const FOLD_BLOCKS: Int = 2

fn mc_scale() -> Float = (MC_B - MC_A) / to_float(RED_N)

# `-inf`, the identity of a maximum and the padding value of a load whose
# masked-off lanes must lose every comparison. Written as a quotient because
# a Dawn source has no spelling for it.
fn neg_inf() -> Float = 0.0 - 1.0 / 0.0

# `+inf`, the identity of a minimum and the score a pair that must never win
# is given. Knife 19's two argmin kernels are its only readers.
fn pos_inf() -> Float = 1.0 / 0.0

# The sum of a tile, rank 0: what a one-answer kernel stores.
fn sum_of(t: Tile[F64]) -> Tile[F64] !Dev = reduce_sum(t)

# The one-block reductions below read their RED_N values through cells of
# RED_TILE (`red_in(pad)`), so the 24 lanes past the end read `pad` and the
# kernels need no mask of their own where the padding is the identity of
# what they fold; the one-answer ones write a single cell of one element
# (`one_out()`), a rank-0 answer widened to it, so the rest of the output
# buffer is left exactly as it was and scripts/tile-gpu-diff's sentinel is
# still there.

# Sum of a vector: leetgpu 4 (Reduction). The identity is the named
# reduction's own and the fold is the device's; `tileiras` accepts a wrong
# identity (measured), which is what scripts/tile-gpu-diff's
# reduce-identity-wrong mutant rests on.
fn sum_reduction(x: Param[F64], out: Param[F64]) -> Unit !Dev = store_cell(out, sum_of(load_cell(x)))

# exp(x - max) / sum(exp(x - max)): leetgpu 5 (Softmax). Two reductions, a
# transcendental and a division. The maximum is subtracted so that a corpus
# of large values does not overflow, which is the claim
# softmax-no-max-subtract removes. The lanes past RED_N read -inf, so their
# exponential is exactly 0 and the sum is the row's; nothing past RED_N is
# written.
fn softmax(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let t = load_cell(x)
  let ex = exp(sub(t, reduce_max(t)))
  store_cell(out, div(ex, reduce_sum(ex)))
}

# sum(a * b): leetgpu 17 (Dot Product). The lanes past the end read 0.0, so
# their product is 0.0 and the identity carries them.
fn dot(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev =
  store_cell(out, sum_of(mul(load_cell(a), load_cell(b))))

# mean((p - t)^2): leetgpu 27 (Mean Squared Error).
fn mse(pred: Param[F64], target: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let d = sub(load_cell(pred), load_cell(target))
  store_cell(out, div(sum_of(mul(d, d)), f_const(F64, to_float(RED_N))))
}

# (b - a) * mean(y): leetgpu 35 (Monte Carlo Integration). `a` and `b` are
# host constants of the recorded kernel, as every shape here is.
fn monte_carlo(y: Param[F64], out: Param[F64]) -> Unit !Dev =
  store_cell(out, mul(sum_of(load_cell(y)), f_const(F64, mc_scale())))

# x / sqrt(mean(x^2) + eps): leetgpu 50 (RMS Normalization). `sqrt` is the
# one operation knife 7b adds that IEEE 754 requires to be correctly
# rounded, so this kernel can be held to the bit-exact tier while its
# neighbours cannot.
fn rms_norm(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let t = load_cell(x)
  let mean = div(reduce_sum(mul(t, t)), f_const(F64, to_float(RED_N)))
  store_cell(out, div(t, sqrt(addf(mean, f_const(F64, RMS_EPS)))))
}

# x / (1 + exp(-x)): leetgpu 52 (Sigmoid Linear Unit). No reduction, so the
# tolerance is `exp`'s alone.
fn silu(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let t = load_cell(x)
  store_cell(out, div(t, addf(f_const(F64, 1.0), exp(neg(t)))))
}

# 1 / (1 + exp(-x)): leetgpu 68 (Sigmoid Activation).
fn sigmoid(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let one = f_const(F64, 1.0)
  store_cell(out, div(one, addf(one, exp(neg(load_cell(x))))))
}

# The lanes of the one block that hold one of the RED_N values: what a
# kernel whose folded term is not 0 at a padded lane selects with.
fn red_live() -> Tile[I1] !Dev = tail_mask(tile_at(block_id(0), RED_TILE), [RED_TILE], RED_N)

# -mean(min(r * A, clip(r, 1 - e, 1 + e) * A)) with r = exp(new - old):
# leetgpu 107 (PPO Clipped Surrogate Loss).
fn ppo_loss(new: Param[F64], old: Param[F64], adv: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let ta = load_cell(adv)
  let r = exp(sub(load_cell(new), load_cell(old)))
  let clipped = minf(maxf(r, f_const(F64, 1.0 - PPO_EPS)), f_const(F64, 1.0 + PPO_EPS))
  let both = minf(mul(r, ta), mul(clipped, ta))
  let s = sum_of(select(red_live(), both, f_const(F64, 0.0)))
  store_cell(out, neg(div(s, f_const(F64, to_float(RED_N)))))
}

# -mean(log(sigmoid(beta * ((pc - pr) - (rc - rr))))): leetgpu 108 (DPO
# Sequence Loss). `log` and `exp` in one kernel, so the tolerance covers
# both. A padded lane's term is log(1/2), not 0, which is why this one keeps
# its mask.
fn dpo_loss(pc: Param[F64], pr: Param[F64], rc: Param[F64], rr: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let one = f_const(F64, 1.0)
  let a = sub(load_cell(pc), load_cell(pr))
  let b = sub(load_cell(rc), load_cell(rr))
  let z = mul(f_const(F64, DPO_BETA), sub(a, b))
  let sg = div(one, addf(one, exp(neg(z))))
  let s = sum_of(select(red_live(), log(sg), f_const(F64, 0.0)))
  store_cell(out, neg(div(s, f_const(F64, to_float(RED_N)))))
}

# No leetgpu problem needs this one: it is to `exp`, `log` and their
# neighbours what `elemops` is to `subf` and `divf`. Every transcendental
# knife 7b adds is applied to the same tile and the ten results are summed
# in a fixed order, so an opcode copied from the wrong row of the frozen
# table -- which `tileiras` would accept, since every one of them takes a
# float tile and answers one -- moves the sum by far more than the
# tolerance. Tolerance tier, and no corpus could make it exact. The lanes
# past the end read 0 and take a logarithm of it; nothing stores them.
fn mathops(x: Param[F64], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let a = load_cell(x)
  let b = load_cell(y)
  let s1 = addf(exp(a), exp2(a))
  let s2 = addf(s1, log(a))
  let s3 = addf(s2, log2(a))
  let s4 = addf(s3, sqrt(a))
  let s5 = addf(s4, rsqrt(a))
  let s6 = addf(s5, tanh(a))
  let s7 = addf(s6, pow(a, b))
  let s8 = addf(s7, floor(b))
  store_cell(out, addf(s8, ceil(b)))
}

# Nor does any problem need this one: it is the oracle for the two region
# shapes a reduction does not reach. A loop carrying THREE tiles (`d_for3`,
# which an online softmax needs) folds the sum, the maximum and the minimum
# of a block's chunks at once, and an `if` over a rank-0 mask -- the first
# operation in this package with two regions -- chooses the sum in block 0
# and the range everywhere else. Both branches are taken by the corpus,
# because the grid has two blocks. `x`'s cells are the chunks, which no grid
# axis picks: the block reads them `load_at`.
fn foldif(x: Param[F64], out: Param[F64], chunks: Int) -> Unit !Dev = {
  let b = block_id(0)
  let n = idx_const(chunks)
  let base = idx_mul(b, n)
  let one = idx_const(1)
  let first = load_at(x, [base])
  let (total, hi, lo) = d_for3(idx_add(base, one), idx_add(base, n), one, first, first, first, (k, s, h, l) => {
    let t = load_at(x, [k])
    (addf(s, t), maxf(h, t), minf(l, t))
  })
  store_cell(out, d_if(idx_eq(b, idx_const(0)), () => total, () => sub(hi, lo)))
}

# And nor does this one: it is the oracle for the N-ary reduction, the shape
# argmax has, where the winning value and the lane it came from must travel
# through one fold together. The answer is the one-hot vector of the argmax,
# so that both halves of the pair are visible in an f64 buffer: the value
# decides who wins and the INDEX decides where the 1 lands. The lanes past
# RED_N read -inf and lose.
fn argmax(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let lane = lanes(tile_at(block_id(0), RED_TILE), [RED_TILE])
  let (_best, where) = d_reduce2(load_cell(x), lane, neg_inf(), 0 - 1, (av, ai, ev, ei) => {
    let win = gt(av, ev)
    (select(win, av, ev), select(win, ai, ei))
  })
  store_cell(out, select(eq_i(lane, where), f_const(F64, 1.0), f_const(F64, 0.0)))
}

# ---- the two-dimensional kernels (knife 8) ----
#
# Every kernel below reads a BLOCK of a larger array rather than a
# contiguous run of it: a cell of a two-dimensional marker since the batch's
# PR-3, or a strided `load` where no cell describes the read (a transposed
# write, a batch of matrices, a column of a row-major tensor). Nothing here
# is masked: every shape divides its tile exactly, so the boundary
# machinery of knife 7a is not in the way of reading what the two
# dimensions do.

# The GEMM: C = A * B over 256x256 matrices in 64x64 tiles, walking K in
# steps of 32. The grid is two-dimensional (M/TM by N/TN) and the
# accumulator travels through the K loop as its carried value, which is the
# claim scripts/tile-gpu-diff's mma-acc-not-carried removes.
const MM_M: Int = 256
const MM_N: Int = 256
const MM_K: Int = 256
const MM_TM: Int = 64
const MM_TN: Int = 64
const MM_TK: Int = 32

#
# Since the batch's PR-3 the three matrices are cut into cells on their
# markers (`mm_cells`): A's rows follow grid axis 0 and its K the loop,
# B's columns follow axis 1 and its K the loop, C's cell is the block's.
# So the body is the textbook loop, with no base, no stride and no shape.
fn matmul(a: Param[F64], b: Param[F64], c: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, MM_K / MM_TK, zeros(c), (k, sofar) => mmaf(load_at(a, [k]), load_at(b, [k]), sofar))
  store_cell(c, acc)
}

# The batched GEMM: BMM_B independent 64x64 products in 32x32 tiles, the
# batch on the grid's THIRD axis. leetgpu 30.
const BMM_B: Int = 4
const BMM_M: Int = 64
const BMM_N: Int = 64
const BMM_K: Int = 64
const BMM_T: Int = 32

#
# The batch is on the grid's THIRD axis and is the matrices' FIRST
# dimension: `c` is cut [1, T, T] with `along: [2, 0, 1]`, the batch
# following axis 2, and the product is reshaped to the cell. The batch
# stays on the axis that varies slowest: put on axis 0, as the identity cut
# would have it, the same kernel runs 46 to 78 percent slower on sm_86
# (docs/tile-backend-design.md 6.27), because the blocks running together
# then belong to different products. The reads stay on the pointer path,
# which is what run.sh's load-dtype-f64 mutant aims at.
fn batched_matmul(a: Param[F64], b: Param[F64], c: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let bb = block_id(2)
  let a_row = idx_add(idx_mul(bb, idx_const(BMM_M * BMM_K)), idx_mul(bm, idx_const(BMM_T * BMM_K)))
  let b_col = idx_add(idx_mul(bb, idx_const(BMM_K * BMM_N)), idx_mul(bn, idx_const(BMM_T)))
  let zero = broadcast(f_const(F64, 0.0), [BMM_T, BMM_T])
  let acc = d_for(idx_const(0), idx_const(BMM_K / BMM_T), idx_const(1), zero, (k, sofar) => {
    let ta = load(a, idx_add(a_row, idx_mul(k, idx_const(BMM_T))), [BMM_T, BMM_T], strides: Some([BMM_K, 1]))
    let tb = load(b, idx_add(b_col, idx_mul(k, idx_const(BMM_T * BMM_N))), [BMM_T, BMM_T], strides: Some([BMM_N, 1]))
    mmaf(ta, tb, sofar)
  })
  store_cell(c, reshape(acc, [1, BMM_T, BMM_T]))
}

# The transpose of a 128x64 matrix in 32x32 tiles. No leetgpu problem here:
# 3 (Matrix Transpose) has shapes that are not multiples of a tile and needs
# the boundary of a later knife. This one is the ORACLE for a store whose
# strides are not row-major: the tile is read `[C, 1]` and written `[1, R]`,
# so the same values land transposed with no shape operation at all. The
# matrix is deliberately not square, so swapping the two strides is a wrong
# answer rather than a different spelling of the same one.
const TR_ROWS: Int = 128
const TR_COLS: Int = 64
const TR_TILE: Int = 32

#
# The input is read by its cells; the output cannot be an Out, because block
# (i, j) writes the tile at (j, i), and an Out's cells are the grid in the
# grid's own order. It is a Shared, written through the pointer path, which
# is this kernel's whole point.
fn transpose(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let bi = block_id(0)
  let bj = block_id(1)
  let t = load_cell(x)
  let base_out = idx_add(idx_mul(bj, idx_const(TR_TILE * TR_ROWS)), idx_mul(bi, idx_const(TR_TILE)))
  store(out, base_out, t, strides: Some([1, TR_ROWS]))
}

# Layer normalisation over the last dimension of a LN_ROWS by LN_D matrix,
# one row a block: leetgpu 113. `gamma` and `beta` are one LN_D-long vector
# each, read at offset 0 by every block.
const LN_ROWS: Int = 64
const LN_D: Int = 256
const LN_EPS: Float = 1.0e-5

# `(t - mean) / sqrt(var + eps)`, the normalisation every kernel below
# shares, over a tile of `shape` holding `count` values.
fn normalise(count: Int, eps: Float, t: Tile[F64]) -> Tile[F64] !Dev = {
  let n = f_const(F64, to_float(count))
  let d = sub(t, div(reduce_sum(t), n))
  let variance = div(reduce_sum(mul(d, d)), n)
  div(d, sqrt(addf(variance, f_const(F64, eps))))
}

# `x` and `out` are cut into rows (one a block); `gamma` and `beta` are one
# cell each, which no grid axis picks: every block reads cell 0.
fn layer_norm(x: Param[F64], gamma: Param[F64], beta: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let at = [idx_const(0)]
  let r = normalise(LN_D, LN_EPS, load_cell(x))
  store_cell(out, addf(mul(r, load_at(gamma, at)), load_at(beta, at)))
}

# Batch normalisation over a BN_ROWS by BN_CHANNELS matrix, one CHANNEL a
# block: leetgpu 40. The column a block reads is a stride of BN_CHANNELS,
# and its `gamma` and `beta` are one element each, read with a stride of
# ZERO so that the whole column sees the same value without a broadcast
# operation of its own.
const BN_ROWS: Int = 128
const BN_CHANNELS: Int = 64
const BN_EPS: Float = 1.0e-5

#
# A block owns a COLUMN, the grid runs along the matrix's second dimension,
# and the scale is read with a stride of zero: neither cut is a cell in the
# grid's own order, so all four parameters are read and written through the
# pointer path, `out` as a Shared.
fn batch_norm(x: Param[F64], gamma: Param[F64], beta: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let col = block_id(0)
  let t = load(x, col, [BN_ROWS], strides: Some([BN_CHANNELS]))
  let g = load(gamma, col, [BN_ROWS], strides: Some([0]))
  let b = load(beta, col, [BN_ROWS], strides: Some([0]))
  let r = normalise(BN_ROWS, BN_EPS, t)
  store(out, col, addf(mul(r, g), b), strides: Some([BN_CHANNELS]))
}

# Group normalisation over a (GN_N, GN_C, GN_HW) tensor with GN_GROUPS
# groups of channels, one (sample, group) a block: leetgpu 105. The tile is
# TWO-dimensional -- the group's channels by the spatial extent -- so the
# mean is a reduction along dimension 1 followed by one along dimension 0,
# which is the first kernel here whose `dim` is not 0.
const GN_N: Int = 2
const GN_C: Int = 8
const GN_HW: Int = 32
const GN_GROUPS: Int = 4
const GN_EPS: Float = 1.0e-5

fn gn_per_group() -> Int = GN_C / GN_GROUPS

#
# Since the batch's PR-3 the tensor is read as what it is, (GN_N, GN_C,
# GN_HW), cut into one (sample, group) cell a block, so the tile is
# [1, per, GN_HW] and the mean is a reduction along dimension 2, then 1,
# then the length-1 dimension 0, which folds the same values in the same
# groups as before. The scale is a [1, per, 1] cell of the (1, GN_C, 1)
# view of `gamma`, widened along the spatial dimension by `broadcast`.
fn sum3(t: Tile[F64]) -> Tile[F64] !Dev = reduce_sum(reduce_sum(reduce_sum(t, dim: 2), dim: 1))

fn group_norm(x: Param[F64], gamma: Param[F64], beta: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [1, gn_per_group(), GN_HW]
  let t = load_cell(x)
  let at = [idx_const(0), idx_const(0)]
  let gt = broadcast(load_at(gamma, at), shape)
  let bt = broadcast(load_at(beta, at), shape)
  let n = f_const(F64, to_float(gn_per_group() * GN_HW))
  let d = sub(t, div(sum3(t), n))
  let variance = div(sum3(mul(d, d)), n)
  let r = div(d, sqrt(addf(variance, f_const(F64, GN_EPS))))
  store_cell(out, addf(mul(r, gt), bt))
}

# The fused residual add and RMS normalisation of a FR_ROWS by FR_D matrix,
# one row a block: leetgpu 83. `w` is one FR_D-long vector read at offset 0
# by every block.
const FR_ROWS: Int = 64
const FR_D: Int = 256
const FR_EPS: Float = 1.0e-5

fn fused_rms_norm(x: Param[F64], res: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let h = addf(load_cell(x), load_cell(res))
  let ms = div(reduce_sum(mul(h, h)), f_const(F64, to_float(FR_D)))
  store_cell(out, mul(div(h, sqrt(addf(ms, f_const(F64, FR_EPS)))), load_at(w, [idx_const(0)])))
}

# ---- the strided kernels (knife 9) ----
#
# Every kernel below reads or writes a tile whose LAYOUT is not the array's
# own row-major one: a transpose is `permute`d strides, a convolution is one
# load a tap at a shifted base, a pooling window is a stride of the window
# size, an interleave is a store with a stride of two, and a colour channel
# is a stride of three. Nothing here is a new instruction: the ladder was
# already `iota * stride` summed over the dimensions (knife 8), and what
# knife 9 adds is the arithmetic that puts arbitrary numbers in it and the
# per-axis masks (`axis_mask`, `in_range`) that keep a tile whose array
# extent is not a multiple of it from reading or writing past the end along
# EITHER axis.
#
# So every kernel here is an EXACT-tier kernel: the arithmetic is the same
# `mulf` and `addf` (and `maxf`) the earlier knives already pinned, and only
# the addressing is new. A reference that folds its taps in the kernel's
# order agrees bit for bit.
#
# Every extent below is deliberately NOT a multiple of its tile, and every
# two-dimensional one is deliberately RECTANGULAR: a square array hides a
# swap of the two strides (scripts/tile-gpu-diff's stride-row-major-swapped
# says why).
#
# Since the batch's PR-3 the READS here stay on the pointer path, which is
# what this family is about: a tap is a tile that starts between two cells,
# a weight is a stride of zero, a window is a stride of the window. The
# WRITES are each block's own cell wherever the block's tile is one (the
# convolutions, the pooling, the stencils, the grey image: an Out cut into
# the output's tiles, so the tail and the boundary masks of the store are
# the cut's), and a Shared written through the pointer path where it is not:
# `transpose_tail` writes the tile at (j, i), `interleave` every other
# element.

# leetgpu 3 (Matrix Transpose): a 100 by 60 matrix in 32 by 32 tiles. The
# tile is read with the input's row-major strides and written with the
# OUTPUT's permuted: `permute(row_major([cols, rows]), [1, 0])`, which is
# `[1, rows]`. No element moves inside the tile and no shape operation is
# issued; the transpose is the layout.
const TT_ROWS: Int = 100
const TT_COLS: Int = 60
const TT_TILE: Int = 32

fn transpose_tail(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [TT_TILE, TT_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let r0 = idx_mul(bi, idx_const(TT_TILE))
  let c0 = idx_mul(bj, idx_const(TT_TILE))
  let m = and_mask(axis_mask(r0, shape, 0, TT_ROWS), axis_mask(c0, shape, 1, TT_COLS))
  let pad = f_const(F64, 0.0)
  let base_in = idx_add(idx_mul(bi, idx_const(TT_TILE * TT_COLS)), c0)
  let t = load(x, base_in, shape, strides: Some(row_major([TT_ROWS, TT_COLS])), mask: Some(m), pad: Some(pad))
  let base_out = idx_add(idx_mul(bj, idx_const(TT_TILE * TT_ROWS)), r0)
  store(out, base_out, t, strides: Some(permute(row_major([TT_COLS, TT_ROWS]), [1, 0])), mask: Some(m))
}

# leetgpu 9 (1D Convolution), valid mode: `out[i] = sum(x[i + t] * w[t])`
# over C1_K taps, so the output is C1_K - 1 shorter than the input. Each tap
# is one load at a base one element further on, and the weight is one load
# with a stride of ZERO: every lane of the tile reads the same `w[t]`,
# which is a layout rather than a broadcast operation.
const C1_N: Int = 1000
const C1_K: Int = 5
const C1_TILE: Int = 128

fn c1_out() -> Int = C1_N - C1_K + 1

fn conv1d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [C1_TILE]
  let blk = tile_at(block_id(0), C1_TILE)
  let m = tail_mask(blk, shape, c1_out())
  let zero = f_const(F64, 0.0)
  var acc = zero
  for t in range(0, C1_K) {
    let xt = load(x, idx_add(blk, idx_const(t)), shape, mask: Some(m), pad: Some(zero))
    let wt = load(w, idx_const(t), shape, strides: Some([0]))
    acc = addf(acc, mul(xt, wt))
  }
  store_cell(out, acc)
}

# leetgpu 10 (2D Convolution), valid mode over a 40 by 36 image with a 3 by
# 3 kernel, in 16 by 16 tiles. One load a tap again, now at a base shifted
# by `p * width + q`, and the weight read with strides `[0, 0]`.
const C2_H: Int = 40
const C2_W: Int = 36
const C2_K: Int = 3
const C2_TILE: Int = 16

fn c2_oh() -> Int = C2_H - C2_K + 1

fn c2_ow() -> Int = C2_W - C2_K + 1

fn conv2d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [C2_TILE, C2_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let r0 = idx_mul(bi, idx_const(C2_TILE))
  let c0 = idx_mul(bj, idx_const(C2_TILE))
  let m = and_mask(axis_mask(r0, shape, 0, c2_oh()), axis_mask(c0, shape, 1, c2_ow()))
  let zero = f_const(F64, 0.0)
  let corner = idx_add(idx_mul(bi, idx_const(C2_TILE * C2_W)), c0)
  var acc = zero
  for p in range(0, C2_K) {
    for q in range(0, C2_K) {
      let xt = load(x, idx_add(corner, idx_const(p * C2_W + q)), shape, strides: Some([C2_W, 1]), mask: Some(m), pad: Some(zero))
      let wt = load(w, idx_const(p * C2_K + q), shape, strides: Some([0, 0]))
      acc = addf(acc, mul(xt, wt))
    }
  }
  store_cell(out, acc)
}

# leetgpu 42 (Max Pooling) over a 36 by 20 image with a 2 by 2 window and a
# stride of 2. The window's stride is the tile's layout: the output tile
# reads the input with strides `[MP_K * width, MP_K]`, so a pooling window
# is addressing and nothing else, and the four elements of one window are
# four loads a constant apart.
const MP_H: Int = 36
const MP_W: Int = 20
const MP_K: Int = 2
const MP_TILE: Int = 16

fn mp_oh() -> Int = MP_H / MP_K

fn mp_ow() -> Int = MP_W / MP_K

fn max_pool(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [MP_TILE, MP_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let r0 = idx_mul(bi, idx_const(MP_TILE))
  let c0 = idx_mul(bj, idx_const(MP_TILE))
  let m = and_mask(axis_mask(r0, shape, 0, mp_oh()), axis_mask(c0, shape, 1, mp_ow()))
  let ninf = f_const(F64, neg_inf())
  let corner = idx_add(idx_mul(bi, idx_const(MP_TILE * MP_K * MP_W)), idx_mul(bj, idx_const(MP_TILE * MP_K)))
  let window = [MP_K * MP_W, MP_K]
  var acc = ninf
  for p in range(0, MP_K) {
    for q in range(0, MP_K) {
      let t = load(x, idx_add(corner, idx_const(p * MP_W + q)), shape, strides: Some(window), mask: Some(m), pad: Some(ninf))
      acc = maxf(acc, t)
    }
  }
  store_cell(out, acc)
}

# leetgpu 63 (Interleave): `out[2i] = a[i]`, `out[2i + 1] = b[i]`. Two
# stores of the same tile width with a stride of TWO, one at an even base
# and one an element on. The output buffer is longer than the answer, so
# what the mask keeps is compared too.
const IL_N: Int = 500
const IL_TILE: Int = 128

fn interleave(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [IL_TILE]
  let blk = tile_at(block_id(0), IL_TILE)
  let m = tail_mask(blk, shape, IL_N)
  let zero = f_const(F64, 0.0)
  let ta = load(a, blk, shape, mask: Some(m), pad: Some(zero))
  let tb = load(b, blk, shape, mask: Some(m), pad: Some(zero))
  let even = idx_mul(blk, idx_const(2))
  store(out, even, ta, strides: Some([2]), mask: Some(m))
  store(out, idx_add(even, idx_const(1)), tb, strides: Some([2]), mask: Some(m))
}

# leetgpu 66 (RGB to Grayscale) over RG_N interleaved pixels: the three
# channels are three loads of the same tile with a stride of THREE, three
# elements apart. The weighted sum is folded red, then green, then blue,
# which is the order the reference folds it in.
const RG_N: Int = 1000
const RG_TILE: Int = 128
const RG_R: Float = 0.299
const RG_G: Float = 0.587
const RG_B: Float = 0.114

fn rgb_gray(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [RG_TILE]
  let blk = tile_at(block_id(0), RG_TILE)
  let m = tail_mask(blk, shape, RG_N)
  let zero = f_const(F64, 0.0)
  let base = idx_mul(blk, idx_const(3))
  let r = load(x, base, shape, strides: Some([3]), mask: Some(m), pad: Some(zero))
  let g = load(x, idx_add(base, idx_const(1)), shape, strides: Some([3]), mask: Some(m), pad: Some(zero))
  let b = load(x, idx_add(base, idx_const(2)), shape, strides: Some([3]), mask: Some(m), pad: Some(zero))
  let lit = addf(addf(mul(r, f_const(F64, RG_R)), mul(g, f_const(F64, RG_G))), mul(b, f_const(F64, RG_B)))
  store_cell(out, lit)
}

# leetgpu 69 (Jacobi Stencil): one sweep of the five-point stencil over a 34
# by 34 grid. The interior is the average of its four neighbours and the
# BOUNDARY KEEPS ITS VALUE, so there are two masks: `inside` says which
# lanes are in the grid at all (the extent is not a multiple of the tile),
# and `interior` says which have four neighbours. The four neighbour loads
# carry `interior`, so the lane at row 0 never reads the row before it --
# an unmasked load there would be an offset of -34 elements from the buffer.
const JC_H: Int = 34
const JC_W: Int = 34
const JC_TILE: Int = 16

fn jacobi(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [JC_TILE, JC_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let rows = coord(idx_mul(bi, idx_const(JC_TILE)), shape, 0, 1)
  let cols = coord(idx_mul(bj, idx_const(JC_TILE)), shape, 1, 1)
  let inside = and_mask(in_range(rows, 0, JC_H), in_range(cols, 0, JC_W))
  let interior = and_mask(in_range(rows, 1, JC_H - 1), in_range(cols, 1, JC_W - 1))
  let zero = f_const(F64, 0.0)
  let lay = row_major([JC_H, JC_W])
  let base = idx_add(idx_mul(bi, idx_const(JC_TILE * JC_W)), idx_mul(bj, idx_const(JC_TILE)))
  let centre = load(x, base, shape, strides: Some(lay), mask: Some(inside), pad: Some(zero))
  let up = load(x, idx_add(base, idx_const(0 - JC_W)), shape, strides: Some(lay), mask: Some(interior), pad: Some(zero))
  let down = load(x, idx_add(base, idx_const(JC_W)), shape, strides: Some(lay), mask: Some(interior), pad: Some(zero))
  let left = load(x, idx_add(base, idx_const(0 - 1)), shape, strides: Some(lay), mask: Some(interior), pad: Some(zero))
  let right = load(x, idx_add(base, idx_const(1)), shape, strides: Some(lay), mask: Some(interior), pad: Some(zero))
  let s = addf(addf(addf(up, down), left), right)
  let avg = mul(s, f_const(F64, 0.25))
  store_cell(out, select(interior, avg, centre))
}

# leetgpu 90 (Depthwise 1D Convolution): DW_C channels of length DW_L, each
# convolved with its OWN DW_K taps. The tile is two-dimensional -- channels
# by positions -- so one block covers four channels at once, and the tap's
# weight is read with strides `[DW_K, 0]`: it walks the channel axis and
# stands still along the position axis, which is the per-row broadcast this
# kernel needs and the reason `axis_strides` exists.
const DW_C: Int = 6
const DW_L: Int = 100
const DW_K: Int = 3
const DW_TC: Int = 4
const DW_TL: Int = 32

fn dw_out() -> Int = DW_L - DW_K + 1

fn depthwise_conv1d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [DW_TC, DW_TL]
  let bc = block_id(0)
  let bl = block_id(1)
  let c0 = idx_mul(bc, idx_const(DW_TC))
  let l0 = idx_mul(bl, idx_const(DW_TL))
  let m = and_mask(axis_mask(c0, shape, 0, DW_C), axis_mask(l0, shape, 1, dw_out()))
  let zero = f_const(F64, 0.0)
  let corner = idx_add(idx_mul(bc, idx_const(DW_TC * DW_L)), l0)
  let wcorner = idx_mul(bc, idx_const(DW_TC * DW_K))
  var acc = zero
  for t in range(0, DW_K) {
    let xt = load(x, idx_add(corner, idx_const(t)), shape, strides: Some([DW_L, 1]), mask: Some(m), pad: Some(zero))
    let wt = load(w, idx_add(wcorner, idx_const(t)), shape, strides: Some([DW_K, 0]), mask: Some(m), pad: Some(zero))
    acc = addf(acc, mul(xt, wt))
  }
  store_cell(out, acc)
}

# leetgpu 28 (Gaussian Blur): a 3 by 3 kernel over a 20 by 24 image, SAME
# size out, with what falls outside the image treated as zero. Unlike the
# valid-mode convolution above, every tap here has a HALO: the tap `(p, q)`
# reads the neighbour `(r + p - 1, c + q - 1)`, which is outside the image
# for the first and last row and column, so each tap carries its own mask.
# `gb_lo` and `gb_hi` are that mask's bounds, intersected with the image's
# own, and an off-by-one in either is a wrong answer at the boundary that
# every layer below the device accepts (scripts/tile-gpu-diff's
# halo-one-lane-short).
const GB_H: Int = 20
const GB_W: Int = 24
const GB_K: Int = 3
const GB_TILE: Int = 16

fn gb_half() -> Int = GB_K / 2

# The first coordinate along an axis whose tap-`t` neighbour is inside the
# image, and the first one past the last: `[max(0, half - t), min(n, n + half - t))`.
fn gb_lo(t: Int) -> Int = if t < gb_half() { gb_half() - t } else { 0 }

fn gb_hi(n: Int, t: Int) -> Int = if t > gb_half() { n - (t - gb_half()) } else { n }

fn gaussian_blur(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let shape = [GB_TILE, GB_TILE]
  let bi = block_id(0)
  let bj = block_id(1)
  let rows = coord(idx_mul(bi, idx_const(GB_TILE)), shape, 0, 1)
  let cols = coord(idx_mul(bj, idx_const(GB_TILE)), shape, 1, 1)
  let inside = and_mask(in_range(rows, 0, GB_H), in_range(cols, 0, GB_W))
  let zero = f_const(F64, 0.0)
  let lay = row_major([GB_H, GB_W])
  let corner = idx_add(idx_mul(bi, idx_const(GB_TILE * GB_W)), idx_mul(bj, idx_const(GB_TILE)))
  var acc = zero
  for p in range(0, GB_K) {
    for q in range(0, GB_K) {
      let tap = and_mask(in_range(rows, gb_lo(p), gb_hi(GB_H, p)), in_range(cols, gb_lo(q), gb_hi(GB_W, q)))
      let shift = (p - gb_half()) * GB_W + (q - gb_half())
      let xt = load(x, idx_add(corner, idx_const(shift)), shape, strides: Some(lay), mask: Some(tap), pad: Some(zero))
      let wt = load(w, idx_const(p * GB_K + q), shape, strides: Some([0, 0]))
      acc = addf(acc, mul(xt, wt))
    }
  }
  store_cell(out, acc)
}

# ---- the integer kernels (knife 10) ----
#
# Every kernel below is EXACT tier, and not because a corpus was chosen for
# it: an i32 result has one value, integer addition modulo 2^32 is exactly
# associative and commutative, so a reduction's unspecified fold tree cannot
# move the answer, and the `List[Float]` channel carries every i32 without
# rounding (53 significand bits over a 32-bit range). This family is the
# control group for the tolerance tiers of knives 7b and 8: on the same
# pipeline there is a set of kernels held to the bit, so "tolerance" is a
# property of the operations and not of what layer 2 can measure.

# The one-block shape the two reductions have: 1000 elements in a 1024-wide
# tile, the last 24 lanes masked off. RED_N / RED_TILE's shape over i32.
const CNT_N: Int = 1000
const CNT_TILE: Int = 1024

# The value `count_eq` counts. The padding a lane past the end reads (0)
# must not equal it, or the tail would be counted.
const CNT_TARGET: Int = 7

# The half-open window `subarray_sum` adds up. Neither bound is a multiple
# of anything: a window that started at 0 or ended at CNT_N would be a
# kernel whose mask does nothing on one side.
const SUB_LO: Int = 137
const SUB_HI: Int = 902

# The eight-block shape the two element-wise integer kernels have: 1000
# elements in 128-wide tiles, so the last block has 24 lanes past the end.
const IOP_N: Int = 1000
const IOP_TILE: Int = 128

# The hash chain's rounds and its three constants. Odd multipliers, so the
# multiply is invertible modulo 2^32 and the chain does not collapse.
const RB_ROUNDS: Int = 3
const RB_K1: Int = 0x9E3779B1
const RB_K2: Int = 0x7F4A7C15
const RB_K3: Int = 0x85EBCA77

# The number of elements of the first buffer equal to CNT_TARGET, at element
# 0 of the second: leetgpu 43 (Count Array Element) and its 2D and 3D shapes
# (44, 45), which are this same count read with more indices.
#
# The comparison mask is widened with `exti`, not turned into 1 and 0 with a
# `select`: `exti` is UNSIGNED here, and a signed widening of a one-bit 1 is
# -1, so the count would come out negated. That is the claim the conversion
# carries and the reason this kernel is the one that makes it.
#
# Since the batch's PR-3 the lanes past CNT_N read the cut's padding, which
# for an integer tile is 0 (the four special values are a float format's):
# 0 is not CNT_TARGET, so they are not counted, which is what a padding of
# CNT_MISS (8) used to say.
fn count_eq(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let hit = mask_to_int(eq_i(load_cell(x), i_const(CNT_TARGET)))
  store_cell(out, reduce_sum(hit))
}

# The wrapping sum of the elements of the first buffer whose index is in
# `[SUB_LO, SUB_HI)`, at element 0 of the second: leetgpu 47 (Subarray Sum).
# The window is a mask over the element index (`lanes` + `in_range`), so a
# lane outside it is neither read nor added.
#
# The sum wraps modulo 2^32, exactly as `addi` does, and the corpus is
# chosen so that it does wrap: a total that stayed inside the range would
# leave `wrap_i32` untested on both sides.
fn subarray_sum(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let i = block_id(0)
  let blk = tile_at(i, CNT_TILE)
  let c = lanes(blk, [CNT_TILE])
  let inside = in_range(c, SUB_LO, SUB_HI)
  let zero = i_const(0)
  let t = load(x, blk, [CNT_TILE], mask: Some(inside), pad: Some(zero))
  store_cell(out, reduce_sum(t))
}

# One round of the hash chain: multiply, xor with a LOGICAL right shift,
# add, xor with an ARITHMETIC one, multiply, xor with a logical one. The two
# kinds of shift are the same opcode under two signedness attributes and
# differ on every negative value, which is what makes this chain the corpus
# scripts/tile-gpu-diff's shri-always-logical mutant reddens; a chain of
# non-negative values would forgive it.
fn rb_round(h: Tile[I32]) -> Tile[I32] !Dev = {
  let h1 = mul_i(h, i_const(RB_K1))
  let h2 = xor_i(h1, shr_u(h1, i_const(15)))
  let h3 = add_i(h2, i_const(RB_K2))
  let h4 = xor_i(h3, shr_i(h3, i_const(13)))
  let h5 = mul_i(h4, i_const(RB_K3))
  xor_i(h5, shr_u(h5, i_const(16)))
}

# RB_ROUNDS applications of that round to each seed: leetgpu 24 (Rainbow
# Table), whose chain is one hash applied over and over. The rounds are
# unrolled on the host, as every count fixed at recording time is.
fn rainbow(seeds: Param[I32], out: Param[I32]) -> Unit !Dev = {
  var h = load_cell(seeds)
  for _r in range(0, RB_ROUNDS) {
    h = rb_round(h)
  }
  store_cell(out, h)
}

# Every integer operation and every conversion the package can emit, folded
# into one lane: the integer twin of `elemops` and `mathops`. Nothing here
# is a leetgpu problem; it is the kernel that gives each opcode a golden and
# a device.
#
# The divisor is `b | 1`, never zero. Two things the device leaves undefined
# the corpus must avoid, and scripts/tile-gpu-diff's int_diff says so beside
# its data: no lane of `a` may be -2^31, and the shift counts are host
# constants inside [0, 32).
fn int_ops(x: Param[I32], y: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let one = i_const(1)
  let a = load_cell(x)
  let b = load_cell(y)
  let odd = or_i(b, one)
  let d = sub_i(a, b)
  let hi = mulhi_i(a, b)
  let q = div_i(a, odd)
  let r = rem_i(a, odd)
  let mx = max_i(a, b)
  let mn = min_i(a, b)
  let ng = neg_i(a)
  let av = abs_i(d)
  let sh = shl_i(a, i_const(3))
  let ar = shr_i(a, i_const(5))
  let lo = shr_u(a, i_const(5))
  # itof, one EXACT halving in f64, then ftoi: `a / 2` truncated toward
  # zero. Halving is exact for every i32, so the only inexact step would be
  # the rounding, and there is none: `ftoi` takes `nearest_int_to_zero` and
  # the reference's `a / 2` truncates toward zero as well. On an odd `a` the
  # two disagree with every other rounding mode, which is what
  # scripts/tile-gpu-diff's ftoi-rounds-instead-of-truncates rests on.
  let hf = float_to_int(mul(int_to_float(a, F64), f_const(F64, 0.5)), I32)
  # trunci to i1 and exti back: the low bit of `a`
  let bit = mask_to_int(int_to_mask(a))
  # bitcast there and back: the value itself, bit for bit
  let bc = bits_to_int(bits_to_float(a))
  let c0 = add_i(d, hi)
  let c1 = xor_i(c0, q)
  let c2 = add_i(c1, r)
  let c3 = xor_i(c2, mx)
  let c4 = add_i(c3, mn)
  let c5 = xor_i(c4, ng)
  let c6 = add_i(c5, av)
  let c7 = xor_i(c6, sh)
  let c8 = add_i(c7, ar)
  let c9 = xor_i(c8, lo)
  let c10 = add_i(c9, and_i(a, b))
  let c11 = xor_i(c10, or_i(a, b))
  let c12 = add_i(c11, xor_i(a, b))
  let c13 = xor_i(c12, hf)
  let c14 = add_i(c13, bit)
  store_cell(out, xor_i(c14, bc))
}

# ---- the wide kernels (knife 11) ----
#
# What is new here is on the HOST side, not in the tile instructions: a
# kernel may fill more than one buffer, and it may write the buffer it read.
# Neither is visible in the Tile IR -- a store is a store, and the entry
# signature does not say which parameters are outputs -- so the claim lives
# entirely in std/gpu's references, which now say WHICH argument positions
# moved, and in the device, which is what says whether the kernel agrees.
#
# The formats are new as well: `f16` tiles (and the `ftof` that widens them),
# and `i8` tiles under a `u8` buffer. There is no `u8` TILE in the dialect;
# a kernel over an unsigned octet buffer declares `Param[I8]` and widens
# with `exti`, whose UNSIGNED signedness is where the format's reading
# lives.

const WIDE_N: Int = 1000
const WIDE_TILE: Int = 128

# Two outputs from two inputs: `sum` gets a + b and `diff` gets a - b, over
# the same masked lanes. No leetgpu problem is this; it is the kernel that
# gives the multi-output path a golden and a device, the way `int_ops` did
# for the integer opcodes. A device that wrote only its last argument would
# leave `sum` holding the sentinel.
fn sum_diff(a: Param[F64], b: Param[F64], sum: Param[F64], diff: Param[F64]) -> Unit !Dev = {
  let ta = load_cell(a)
  let tb = load_cell(b)
  store_cell(sum, addf(ta, tb))
  store_cell(diff, sub(ta, tb))
}

# In-place reversal of a vector: leetgpu 19 (Reverse Array). ONE parameter,
# read and written.
#
# Each block owns a tile of the FIRST HALF and the mirror of that tile in
# the second half: it loads both, then stores each where the other was. The
# mirror is a stride of -1 from `REV_N - 1 - base`, which is the first use
# of a negative stride in this file and needs nothing from the ladder that a
# positive one does not. The grid covers `REV_N / 2` lanes, so every element
# is touched exactly once and no two blocks touch the same one.
#
# REV_N is EVEN. An odd length would leave the middle element to a block
# that does not exist, and the reference says so as well.
const REV_N: Int = 1000
const REV_TILE: Int = 128

#
# Two regions a block, its tile and the mirror of it, so the parameter is a
# Shared and the kernel stays on the pointer path: a cell is one region.
fn reverse(x: Param[F64]) -> Unit !Dev = {
  let s = [REV_TILE]
  let blk = tile_at(block_id(0), REV_TILE)
  let m = tail_mask(blk, s, REV_N / 2)
  let z = f_const(F64, 0.0)
  let fwd = load(x, blk, s, mask: Some(m), pad: Some(z))
  let back = idx_add(idx_const(REV_N - 1), idx_mul(blk, idx_const(0 - 1)))
  let rev = load(x, back, s, strides: Some([0 - 1]), mask: Some(m), pad: Some(z))
  store(x, back, fwd, strides: Some([0 - 1]), mask: Some(m))
  store(x, blk, rev, mask: Some(m))
}

# In-place colour inversion of a u8 image: leetgpu 7 (Color Inversion). ONE
# parameter, read and written, and the first kernel over an 8-bit buffer.
#
# The arithmetic is done at i32: `exti` widens each octet UNSIGNED (so a
# byte holding 200 is 200 and not -56), the subtraction happens there, and
# `trunci` puts the low octet back. Doing it in i8 would need an i8 constant
# 255, which is not an i8 value; doing it unsigned at 8 bits would need a
# `u8` tile, which the dialect does not have.
const INV_N: Int = 1000
const INV_TILE: Int = 128

#
# An Out read before it is written: a block reads its own cell and writes
# it back, which is what "in place" means under the cells.
fn invert(img: Param[I8]) -> Unit !Dev =
  store_cell(img, trunc_u8(sub_i(i_const(255), ext_u8(load_cell(img)))))

# `((a + b) * a) - b` over f16 tiles: the f16 twin of `elemops` and
# `int_ops`, and no leetgpu problem. Three operations the double-rounding
# theorem covers, each landing its result in an f16 tile, so every one of
# them is `narrow.round_fp16` of the exact answer and the whole kernel is
# bit-exact against a host reference that rounds after each step.
const F16E_N: Int = 1000
const F16E_TILE: Int = 128

fn f16_ops(a: Param[F16], b: Param[F16], out: Param[F16]) -> Unit !Dev = {
  let ta = load_cell(a)
  let tb = load_cell(b)
  store_cell(out, sub(mul(addf(ta, tb), ta), tb))
}

# The dot product of two f16 vectors into an f64 answer: leetgpu 58 (FP16
# Dot Product), and the one client of `ftof`.
#
# The operands are f16 and the arithmetic is not: each tile is widened with
# `ftof` (exact in this direction, f16 to f64) and the product and the
# reduction happen at f64. That is what the problem asks for -- a dot
# product of half-precision inputs accumulated at full precision -- and it
# is also what makes a bit-exact comparison possible at all, since an f16
# accumulator over a thousand lanes would lose more than any tolerance
# worth writing down.
const DF16_N: Int = 1000
const DF16_TILE: Int = 1024

fn dot_f16(a: Param[F16], b: Param[F16], out: Param[F64]) -> Unit !Dev = {
  let ta = float_to_float(load_cell(a), F64)
  let tb = float_to_float(load_cell(b), F64)
  store_cell(out, reduce_sum(mul(ta, tb)))
}

# The f16 GEMM: leetgpu 22. Knife 8's `matmul` at f16, with an f16
# accumulator (the dialect allows f16 operands with an f16 or an f32
# result; this surface's `mmaf` takes one format for all three).
#
# `--remarks=tensorcore` says this one DOES reach a tensor core on sm_86
# (`Tensor-core SM80, Shape = [16, 8, 16]`), which knife 8 found only bf16
# did among the formats it tried.
const MMF_M: Int = 64
const MMF_N: Int = 64
const MMF_K: Int = 64
const MMF_T: Int = 32

#
# Cut as `matmul` is. At 32-wide tiles the occupancy hint the batch's PR-3
# measured for 128-wide f16 tiles on sm_86 is not wanted (docs
# tile-backend-design.md 6.26): `tileiras` budgets this one 6 KB of shared
# memory either way.
fn matmul_f16(a: Param[F16], b: Param[F16], c: Param[F16]) -> Unit !Dev = {
  let acc = d_range(0, MMF_K / MMF_T, zeros(c), (k, sofar) => mmaf(load_at(a, [k]), load_at(b, [k]), sofar))
  store_cell(c, acc)
}

# The batched f16 GEMM: leetgpu 57. `batched_matmul` at f16, the batch on
# the grid's third axis.
const BMF_B: Int = 2
const BMF_M: Int = 32
const BMF_N: Int = 32
const BMF_K: Int = 32
const BMF_T: Int = 16

#
# Written as `batched_matmul` is, and for its reasons.
fn batched_matmul_f16(a: Param[F16], b: Param[F16], c: Param[F16]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let bb = block_id(2)
  let a_row = idx_add(idx_mul(bb, idx_const(BMF_M * BMF_K)), idx_mul(bm, idx_const(BMF_T * BMF_K)))
  let b_col = idx_add(idx_mul(bb, idx_const(BMF_K * BMF_N)), idx_mul(bn, idx_const(BMF_T)))
  let zero = broadcast(f_const(F16, 0.0), [BMF_T, BMF_T])
  let acc = d_for(idx_const(0), idx_const(BMF_K / BMF_T), idx_const(1), zero, (k, sofar) => {
    let ta = load(a, idx_add(a_row, idx_mul(k, idx_const(BMF_T))), [BMF_T, BMF_T], strides: Some([BMF_K, 1]))
    let tb = load(b, idx_add(b_col, idx_mul(k, idx_const(BMF_T * BMF_N))), [BMF_T, BMF_T], strides: Some([BMF_N, 1]))
    mmaf(ta, tb, sofar)
  })
  store_cell(c, reshape(acc, [1, BMF_T, BMF_T]))
}

# The int8 GEMM: leetgpu 32 (INT8 Quantized MatMul). `mmai`, whose operands
# are i8 tiles and whose accumulator and result are i32 ones, so the three
# buffers are two i8 and one i32.
#
# Bit-exact by ALGEBRA, not by corpus: every partial product of two i8
# values fits in fifteen bits and the accumulator is i32, so the sum over
# `k` is one integer whatever order the device folds it in. That is the
# same argument knife 10's integer family rests on, and it is why an
# `mmai` kernel is exact tier where an `mmaf` one cannot be.
const MMI_M: Int = 64
const MMI_N: Int = 64
const MMI_K: Int = 64
const MMI_T: Int = 32

fn matmul_i8(a: Param[I8], b: Param[I8], c: Param[I32]) -> Unit !Dev = {
  let acc = d_range(0, MMI_K / MMI_T, zeros(c), (k, sofar) => mmai(load_at(a, [k]), load_at(b, [k]), sofar))
  store_cell(c, acc)
}

# ---- the gather and scatter kernels (knife 12) ----
#
# The four kernels below address memory with a TILE OF INDICES rather than
# with a base and a stride ladder. Nothing new reaches the device: `offset`,
# the instruction every load already goes through, takes any `tile<Nxi32>`
# as its offset operand, so `gather` hands it a tile somebody computed
# instead of the ladder a strided `load` builds. What is new is that the
# numbers may come from memory, which is what "data dependent" means.
#
# Two rules the corpora carry, and this is where they are stated:
#
#   * an index OUTSIDE the array is legal wherever a mask blocks its lane,
#     and illegal everywhere else. `token_embed` and `scatter_perm` both
#     carry such indices, and both clamp the address arithmetic as well
#     (`and_i` against a power-of-two extent), so a blocked lane still
#     forms an address inside the buffer. The mask decides the VALUE; the
#     clamp decides the ADDRESS. That separation is what lets
#     scripts/tile-gpu-diff's gather-mask-dropped mutant answer a WRONG
#     number rather than fault, which is the only way layer 2 can see it.
#   * a scatter whose lanes name one element twice has no answer at all.
#     Every scatter here writes a permutation and the corpora keep it one:
#     `sort_rank`'s ranks are distinct because ties are broken by lane,
#     `merge_rank`'s are the merge-path ranks (distinct by the same
#     argument), and `scatter_perm`'s corpus is a permutation with some
#     lanes taken out of range, never two lanes put on one destination.
#
# Duplicate GATHER indices are ordinary: `token_embed`'s corpus repeats
# token ids on purpose.

# The embedding table: EMB_ROWS rows of EMB_DIM, TOK_TILE tokens a block.
# EMB_ROWS is a power of two so the address clamp is one `andi`. TOK_N is
# the token count the grid was sized for and the KERNEL never reads it: 100
# tokens is 13 blocks of 8, so the last block covers four lanes past the
# last token, and the corpus fills those with ids outside the table (it
# carries out-of-range ids inside the hundred as well).
const EMB_ROWS: Int = 64
const EMB_DIM: Int = 16
const TOK_TILE: Int = 8
const TOK_N: Int = 100

# What a token id outside [0, EMB_ROWS) reads: a value no row of the table
# holds, so a lane that read the table instead of this is visible.
const EMB_MISS: Float = 0.0 - 777.0

# Row `i` of the output is row `ids[i]` of the table, and the MISS row
# where that id is outside the table: leetgpu 106 (Token Embedding).
#
# The id tile is a load with a stride of zero along the embedding
# dimension (knife 9's `axis_strides`), so one id serves a whole row; the
# gather's index is that id scaled by the row length plus the column
# coordinate. The store is NOT masked: an out-of-range id is a defined
# answer here (the MISS row), not a lane to leave alone, which is what
# gives the gather's mask something the output can show.
#
# The id tile is the pointer path's (a stride of zero is no cell) and the
# table is gathered from, so both are an In of the whole tensor; the output
# is the block's TOK_TILE rows, an Out cell whose row count is the grid's
# (`DYN_DIM`): the last block's four rows past TOK_N are written too, MISS
# rows, exactly as the unmasked store wrote them.
fn token_embed(ids: Param[I32], table: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [TOK_TILE, EMB_DIM]
  let id = load(ids, tile_at(block_id(0), TOK_TILE), s, strides: Some(axis_strides(2, 0, 1)))
  let ok = in_range(id, 0, EMB_ROWS)
  let row = and_i(id, i_const(EMB_ROWS - 1))
  let off = add_i(mul_i(row, i_const(EMB_DIM)), coord(idx_const(0), s, 1, 1))
  store_cell(out, gather(table, off, mask: Some(ok), pad: Some(f_const(F64, EMB_MISS))))
}

# The rank sort's shape: one block, SORT_N values, a SORT_N by SORT_N
# comparison tile. O(n^2) comparisons is the sort a tile machine with no
# shuffle can write in one launch, and it is exact: nothing is added but
# ones and zeroes.
const SORT_N: Int = 32

# The SORT_N values of the first buffer, sorted, in the second: leetgpu 15
# (Sorting).
#
# The rank of x[i] is the number of j whose value comes BEFORE it, where
# "before" is `x[j] < x[i]`, or `x[j] == x[i]` and `j < i`. That tie-break
# is not decoration: it is what makes the ranks a permutation, and a
# scatter whose lanes collided would have no answer. The corpus repeats
# values on purpose so that the tie-break is exercised.
#
# The count is folded in f64 over ones and zeroes, so the fold order the
# dialect leaves unspecified cannot show: every partial sum is an integer
# below 32 and exact in binary64.
fn sort_rank(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s2 = [SORT_N, SORT_N]
  let s1 = [SORT_N]
  let zero = idx_const(0)
  let row = load(x, zero, s2, strides: Some([1, 0]))
  let col = load(x, zero, s2, strides: Some([0, 1]))
  let tie = and_mask(eq(col, row), lt_i(coord(zero, s2, 1, 1), coord(zero, s2, 0, 1)))
  let before = or_mask(lt(col, row), tie)
  let hit = select(before, f_const(F64, 1.0), f_const(F64, 0.0))
  let rank = reduce_sum(hit, dim: 1)
  scatter(out, float_to_int(rank, I32), load(x, zero, s1))
}

# The merge's shape: two sorted runs of MG_N in one block.
const MG_N: Int = 32

# The two sorted buffers merged into the third: leetgpu 71 (Parallel
# Merge). The merge-path rank of a[i] is `i` plus the number of b below
# it, and of b[j] is `j` plus the number of a at or below it. The strict
# comparison on one side and the loose one on the other is what makes the
# two rank sets disjoint when the buffers share a value, so the two
# scatters never write one element twice; the corpus puts values in both
# buffers on purpose.
fn merge_rank(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s2 = [MG_N, MG_N]
  let s1 = [MG_N]
  let zero = idx_const(0)
  let one = f_const(F64, 1.0)
  let nought = f_const(F64, 0.0)
  let arow = load(a, zero, s2, strides: Some([1, 0]))
  let bcol = load(b, zero, s2, strides: Some([0, 1]))
  let below = select(lt(bcol, arow), one, nought)
  let atmost = select(le(arow, bcol), one, nought)
  let ca = reduce_sum(below, dim: 1)
  let cb = reduce_sum(atmost, dim: 0)
  let lane = lanes(zero, s1)
  scatter(out, add_i(lane, float_to_int(ca, I32)), load(a, zero, s1))
  scatter(out, add_i(lane, float_to_int(cb, I32)), load(b, zero, s1))
}

# The permutation scatter's shape: SC_N destinations, SC_TILE lanes a
# block. SC_N is a power of two so the address clamp is one `andi`.
const SC_N: Int = 256
const SC_TILE: Int = 128

# `out[perm[i]] = x[i]`, and nothing at all where `perm[i]` is outside the
# output: the scatter twin of `int_ops`, a kernel with no leetgpu problem
# behind it whose only job is to give the masked scatter a golden and a
# device. `reverse` (knife 11) writes a permutation too, but with a
# STRIDE; this one reads its permutation out of a buffer.
fn scatter_perm(perm: Param[I32], x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let p = load_cell(perm)
  let dst = and_i(p, i_const(SC_N - 1))
  scatter(out, dst, load_cell(x), mask: Some(in_range(p, 0, SC_N)))
}

# ---- the scan kernels (knife 13) ----
#
# `scan` is `reduce` with the intermediate results kept: position `j` of the
# answer is the fold of everything at or before `j` along the scanned
# dimension, and the answer has the operand's shape rather than the
# operand's shape with that dimension dropped. One new opcode (0x5E), one
# attribute more than `reduce` (`reverse`), the same region encoding.
#
# Three facts about it were MEASURED on the device rather than read, and
# every kernel below rests on them (packages/tileir/src/dev.dawn says where):
#
#   * the region's FIRST argument is the accumulator and the second the
#     element, in both directions. `reduce`'s bodies are all commutative and
#     could never say which; a scan's need not be, and three of the six
#     kernels here are wrong under the other reading.
#   * the IDENTITY is not folded in at the first position: the prefix of one
#     element is that element. So `linrec`'s first output is `x[0]` whatever
#     `a[0]` is, which is what leetgpu 82 asks for, and no kernel here may
#     lean on an identity to fix up its first lane.
#   * a MULTI-OPERAND scan runs, though the dialect's prose says `scan` "is
#     restricted to only support single tile input". Its verifier does not
#     say so and neither does tileiras. Three kernels here need it: a
#     first-order linear recurrence composes affine maps, and an affine map
#     is two numbers.
#
# The float scans are TOLERANCE tier and cannot be anything else: the
# evaluation order inside a prefix is implementation-defined, and the
# device's is measurably not the sequential left fold a host reference
# writes. The integer scans are exact tier by the same algebra the integer
# reductions use (knife 10): addition modulo 2^32 is associative, so every
# regrouping of one prefix is one value.

# The scan family's shape: one block, a 128-wide tile, 100 live lanes. One
# block because a prefix sum crosses every lane of its dimension, which is
# the same reason every reduction in this backend covers its problem in one
# launch.
const SCAN_TILE: Int = 128
const SCAN_N: Int = 100

# The inclusive prefix sum of the first SCAN_N lanes: leetgpu 16 (Prefix
# Sum). Masked at both ends of the operation, so the lanes past the end are
# neither read nor written and the padding zero they fold in is the sum's
# identity.
fn prefix_sum(x: Param[F64], out: Param[F64]) -> Unit !Dev =
  store_cell(out, d_scan(load_cell(x), 0.0, (acc, e) => addf(acc, e)))

# The sliding window's shape: MSA_W consecutive of MSA_N values, in one
# block of MSA_TILE lanes. MSA_W + MSA_N is below MSA_TILE, which is what
# lets the shifted run live in the same tile.
const MSA_TILE: Int = 128
const MSA_N: Int = 100
const MSA_W: Int = 7

# Nothing is a smaller window sum than this, and it is not INT_MIN: the
# reduction below never adds it, but a value at the edge of the range is a
# hazard nobody needs.
const MSA_FLOOR: Int = 0 - 2000000000

# The largest sum of MSA_W consecutive of the first MSA_N elements, at
# element 0 of the output: leetgpu 51 (Max Subarray Sum).
#
# The window sum ending at lane `j` is `P[j] - P[j - MSA_W]`, where `P` is
# the inclusive prefix sum. A tile cannot be shifted along itself -- there
# is no lane-to-lane move in this dialect and a tile is not in memory -- so
# the shifted prefix is a SECOND scan of the same buffer read MSA_W lanes
# late: `Q[j] = sum of x[0 .. j - MSA_W]`, which is `P[j - MSA_W]` for
# `j >= MSA_W` and 0 at `j = MSA_W - 1`, where the first window's left
# neighbour is nothing at all.
#
# Integer throughout, so this is exact tier whatever the device's fold tree
# is, and the subtraction of two prefix sums is exact for the same reason.
fn max_subarray(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let zero = i_const(0)
  let lane = lanes(idx_const(0), [MSA_TILE])
  let p = d_scan(load_cell(x), 0.0, (acc, e) => add_i(acc, e))
  # the same run read MSA_W lanes late; the address is clamped as well as
  # masked, so a blocked lane still names an element of the buffer
  let late = in_range(lane, MSA_W, MSA_W + MSA_N)
  let back = max_i(sub_i(lane, i_const(MSA_W)), zero)
  let q = d_scan(gather(x, back, mask: Some(late), pad: Some(zero)), 0.0, (acc, e) => add_i(acc, e))
  let ends = in_range(lane, MSA_W - 1, MSA_N)
  let win = select(ends, sub_i(p, q), i_const(MSA_FLOOR))
  store_cell(out, d_reduce(win, to_float(MSA_FLOOR), (acc, e) => max_i(acc, e)))
}

# The exclusive prefix sum of each segment of the first SCAN_N lanes, where
# a segment starts at every lane whose flag is 1: leetgpu 70 (Segmented
# Exclusive Prefix Sum).
#
# Two scans and a subtraction, which is leetgpu's own reference written in
# tiles: the segment's exclusive sum at `j` is the GLOBAL exclusive sum at
# `j` minus the global exclusive sum at the segment's first lane. The
# global exclusive sum is the inclusive scan less the lane's own value; the
# segment start's is a scan whose body is "the last element that carried a
# flag, and otherwise what came before", which is associative and NOT
# commutative -- the first body in this tree that would answer differently
# under the other reading of the region's arguments.
#
# That body needs the flag and the value of one lane together, so it is a
# two-operand scan. The corpus must set the flag of lane 0: with no
# segment open at all there is nothing to subtract, and leetgpu's own tests
# always open one there.
fn seg_scan(values: Param[F64], flags: Param[I32], out: Param[F64]) -> Unit !Dev = {
  let v = load_cell(values)
  let f = int_to_float(load_cell(flags), F64)
  let excl = sub(d_scan(v, 0.0, (acc, e) => addf(acc, e)), v)
  let (_open, carry) = d_scan2(f, excl, 0.0, 0.0, (af, av, ef, ev) => {
    let start = gt(ef, f_const(F64, 0.5))
    (select(start, ef, af), select(start, ev, av))
  })
  store_cell(out, sub(excl, carry))
}

# The positive values of the first SCAN_N lanes, packed to the front of the
# output and nothing written after them: leetgpu 72 (Stream Compaction).
#
# The destination of a kept lane is the number of kept lanes before it,
# which is the EXCLUSIVE prefix count: an inclusive integer scan of the
# predicate less the lane's own bit. Exclusive is spelled that way and not
# with the identity, because the identity is not folded in.
#
# Exact tier: the values are moved and never arithmetic, and the counts are
# integers. The destinations are distinct by construction (a strictly
# increasing count over the kept lanes), which is what a scatter requires;
# the lanes that are not kept are masked and write nothing.
#
# The lanes past SCAN_N read 0, which is not positive, so `keep` leaves
# them out with no mask of its own; the output is a scatter, a Shared.
fn compact(a: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let t = load_cell(a)
  let keep = gt(t, f_const(F64, 0.0))
  let ones = select(keep, i_const(1), i_const(0))
  let incl = d_scan(ones, 0.0, (acc, e) => add_i(acc, e))
  scatter(out, sub_i(incl, ones), t, mask: Some(keep))
}

# The recurrence family's shape: LR_B rows of LR_L, one block a row.
const LR_B: Int = 4
const LR_L: Int = 64

# `h[t] = a[t] * h[t-1] + x[t]`, with `h[0] = x[0]`: leetgpu 82 (Linear
# Recurrence).
#
# The scan folds AFFINE MAPS. Element `t` is the map `u -> a[t] * u + x[t]`,
# written as the pair `(a[t], x[t])`, and composing the accumulated map
# `(A, X)` with it gives `(a[t] * A, a[t] * X + x[t])` -- associative,
# because function composition is, and not commutative, because
# composition is not. The second half of the answer at `t` is `h[t]`,
# because the accumulated map applied to the initial state 0 is its own
# addend.
#
# `h[0] = x[0]` falls out of the identity not being folded in: the prefix
# of one element is that element, so lane 0 is `(a[0], x[0])` and `a[0]` is
# never used. That is exactly what leetgpu's reference does.
fn linrec(a: Param[F64], x: Param[F64], h: Param[F64]) -> Unit !Dev = {
  let (_c, hh) = d_scan2(load_cell(a), load_cell(x), 1.0, 0.0, (ac, av, ec, ev) => (mul(ec, ac), fma(ec, av, ev)))
  store_cell(h, hh)
}

# The advantage estimator's shape: GAE_B rows of GAE_S. GAE_B * GAE_S is a
# power of two so the shifted read's address clamp is one `andi`.
const GAE_B: Int = 4
const GAE_S: Int = 64

# The discount and the trace decay, host constants folded in at recording
# time, as every scalar parameter of a leetgpu problem is.
fn gae_gamma() -> Float = 0.99
fn gae_lam() -> Float = 0.95

# The generalised advantage estimate, a REVERSE scan: leetgpu 110 (Parallel
# Reverse Scan).
#
# `A[t] = delta[t] + gamma * lam * A[t+1]`, which is `linrec`'s affine
# composition with a constant coefficient, run from the end. `reverse` is
# what makes it one launch instead of a loop, and it is the only kernel in
# this tree that sets the attribute -- so scripts/tile-gpu-diff's
# scan-reverse-ignored mutant reds here and nowhere else.
#
# `delta[t] = rewards[t] + gamma * values[t+1] - values[t]`, with
# `values[t+1]` past the end of the row taken as zero. The shifted read is
# a gather one lane late: masked at the row's last lane and clamped into
# the buffer, so the blocked lane still names an element.
#
# `values` is read twice, by its cell and one lane late by a gather: an In
# with cells takes both, since a gather is a read.
fn gae(rewards: Param[F64], values: Param[F64], adv: Param[F64]) -> Unit !Dev = {
  let s = [GAE_S]
  let blk = tile_at(block_id(0), GAE_S)
  let nxt = and_i(add_i(lanes(blk, s), i_const(1)), i_const(GAE_B * GAE_S - 1))
  let ok = in_range(lanes(idx_const(0), s), 0, GAE_S - 1)
  let nv = gather(values, nxt, mask: Some(ok), pad: Some(f_const(F64, 0.0)))
  let delta = sub(addf(load_cell(rewards), mul(f_const(F64, gae_gamma()), nv)), load_cell(values))
  let dec = broadcast(f_const(F64, gae_gamma() * gae_lam()), s)
  let (_c, ad) = d_scan2(dec, delta, 1.0, 0.0, (ac, av, ec, ev) => (mul(ec, ac), fma(ec, av, ev)), reverse: true)
  store_cell(adv, ad)
}

# The selective scan's shape: SSM_BATCH sequences of SSM_T steps, SSM_D
# channels, SSM_N hidden states a channel. One block per (sequence,
# channel), so the grid has two axes and the tile is the whole (step,
# state) plane of that channel.
const SSM_BATCH: Int = 2
const SSM_T: Int = 32
const SSM_D: Int = 8
const SSM_N: Int = 16

# The Mamba-style selective scan: leetgpu 94 (SSM Selective Scan).
#
# `h[t, n] = exp(delta[t] * A[n]) * h[t-1, n] + delta[t] * B[t, n] * u[t]`
# for each channel, and `y[t] = sum_n C[t, n] * h[t, n] + skip * u[t]`.
# The recurrence is `linrec`'s affine composition run over a RANK-2 tile:
# one scan along the step axis carries SSM_N independent states at once,
# which is what "the operands are tiles" buys over "the operands are
# numbers". The output is then a reduction along the state axis, so this
# kernel is a scan and a reduce over the same plane.
#
# Every operand is a strided read of the same plane: `delta` and `u` are
# constant along the state axis (stride 0), `A` is constant along the step
# axis, and `B` and `C` are dense in both. Nothing is masked: every extent
# divides its tile.
fn ssm_scan(u: Param[F64], delta: Param[F64], amat: Param[F64], bmat: Param[F64],
  cmat: Param[F64], skip: Param[F64], y: Param[F64]) -> Unit !Dev = {
  let s2 = [SSM_T, SSM_N]
  let s1 = [SSM_T]
  let b = block_id(0)
  let d = block_id(1)
  # the (sequence, channel) row of a (batch, step, channel) buffer, the
  # (sequence) plane of a (batch, step, state) one, and row `d` of A
  let ud = idx_add(idx_mul(b, idx_const(SSM_T * SSM_D)), d)
  let bc = idx_mul(b, idx_const(SSM_T * SSM_N))
  let ad = idx_mul(d, idx_const(SSM_N))
  let dt = load(delta, ud, s2, strides: Some([SSM_D, 0]))
  let uu = load(u, ud, s2, strides: Some([SSM_D, 0]))
  let abar = exp(mul(dt, load(amat, ad, s2, strides: Some([0, 1]))))
  let bbar = mul(mul(dt, load(bmat, bc, s2, strides: Some([SSM_N, 1]))), uu)
  let (_c, h) = d_scan2(abar, bbar, 1.0, 0.0, (ac, av, ec, ev) => (mul(ec, ac), fma(ec, av, ev)), dim: 0)
  let cy = mul(load(cmat, bc, s2, strides: Some([SSM_N, 1])), h)
  let yt = reduce_sum(cy, dim: 1)
  let side = mul(load(skip, d, s1, strides: Some([0])), load(u, ud, s1, strides: Some([SSM_D])))
  store(y, ud, addf(yt, side), strides: Some([SSM_D]))
}

# ---- the atomic kernels (knife 14) ----
#
# An atomic is what a scatter is not: two lanes may name ONE element, and
# the update still happens once per lane. That is the whole of the
# difference, and it is why 13 Histogramming is the only leetgpu problem
# in this backend's range that needs one. Everything else that looks like
# it needs an atomic (72 Stream Compaction, 36 Radix Sort, 46 BFS) has an
# ordered spelling through `scan` and `scatter`, and an ordered spelling is
# the one a bit-exact reference can be written against.
#
# What the corpora have to carry, and this is where it is stated:
#
#   * the histogram's corpus must have grid > 1 AND lanes in different
#     blocks landing on ONE bin. With one block, or with one lane a bin,
#     an atomic add and a plain load-add-store answer the same thing, and
#     scripts/tile-gpu-diff's atomic-as-plain-store mutant would be green.
#     The layer-2 harness counts the collisions and holds them above zero,
#     and runs the same kernel a second time on a corpus with NO collisions
#     to show that the corpus is what makes the mutant bite.
#   * the mode must be one whose answer does not depend on the order the
#     lanes arrive in. Integer `add` is; `xchg` is not. This is the same
#     argument knife 10 made for the integer reductions: addition modulo
#     2^32 is exactly associative and commutative, so the histogram is
#     EXACT tier and not a tolerance claim.
#   * a bin index outside the histogram is masked, and its address is
#     clamped as well, for knife 12's reason: a mutant that drops the mask
#     must answer a wrong NUMBER rather than fault, or layer 2 records
#     `blocked` and `blocked` is not a difference.

# The histogram's shape: HIST_BINS bins (a power of two, so the address
# clamp is one `andi`), HIST_TILE lanes a block, HIST_N values. 500 is not
# a multiple of 64, so the last of the eight blocks runs 12 lanes past the
# end of the input and the tail mask is doing real work.
const HIST_BINS: Int = 16
const HIST_TILE: Int = 64
const HIST_N: Int = 500

# How many of the first HIST_N values fall in each bin: leetgpu 13
# (Histogramming). The histogram buffer must arrive ZEROED, which is what
# the problem's own reference does before it counts.
#
# Values outside [0, HIST_BINS) are not counted, as leetgpu's reference
# says (it counts under a validity mask), and the corpus carries some.
#
# The bins are a Shared: an atomic is not a cell write. The input is read
# by its cells, whose lanes past HIST_N read 0, a bin: `live` is what keeps
# them out of the count, where a padding of -1 used to.
fn histogram(input: Param[I32], hist: Param[I32]) -> Unit !Dev = {
  let x = load_cell(input)
  let live = tail_mask(tile_at(block_id(0), HIST_TILE), [HIST_TILE], HIST_N)
  let ok = and_mask(live, in_range(x, 0, HIST_BINS))
  atomic_add(hist, and_i(x, i_const(HIST_BINS - 1)), i_const(1), mask: Some(ok))
}

# The compare-and-swap's shape: CAS_SLOTS slots, CAS_TILE lanes a block,
# so the four blocks cover every slot exactly once.
const CAS_SLOTS: Int = 128
const CAS_TILE: Int = 32

# Every slot whose contents equal the lane's expected value takes the
# lane's new value; the rest are left alone; and what each slot held
# before goes into the fourth buffer. A coverage kernel with no leetgpu
# problem behind it, the way `int_ops` and `scatter_perm` are: nothing in
# the range of this backend needs a compare-and-swap, and the operation
# still has to be exercised.
#
# One lane a slot, so the answer does not depend on the order the lanes
# arrive in and the tier is exact. A lane whose expected value is negative
# does not take part at all: that is the mask, and the slot and the
# fourth buffer both keep what they had.
#
# The slots are a Shared (an atomic); the fourth buffer is the block's own
# cell, an Out, and a lane that took no part writes back what the cell held,
# which is what "keeps what it had" is when the whole cell is written.
fn cas_swap(state: Param[I32], cmp: Param[I32], val: Param[I32], old: Param[I32]) -> Unit !Dev = {
  let c = load_cell(cmp)
  let active = ge_i(c, i_const(0))
  let prev = atomic_cas(state, lanes(tile_at(block_id(0), CAS_TILE), [CAS_TILE]), c, load_cell(val), mask: Some(active))
  store_cell(old, select(active, prev, load_cell(old)))
}

# ---- the error function kernels (knife 15) ----
#
# Tile IR has no `erf`. Its hundred operations carry `exp`, `log`, `tanh`,
# `pow` and the roots, and stop there; `ct` has no erf either. leetgpu 65
# is stated in terms of `torch.erf`, so what answers it is a COMPOSITION,
# `tileir/dev.erf`, which is Abramowitz-Stegun 7.1.26 over the arithmetic
# that is already in the dialect. Zero new opcodes: this knife adds no
# bytecode, only two kernels and a function in the package.
#
# What the corpora have to carry, and this is where it is stated:
#
#   * lanes with `|x| > 4`. 7.1.26 is a rational function of
#     `t = 1 / (1 + p|x|)` times `exp(-x^2)`, and both factors are near
#     their limits out there: `t` goes to 0 and `exp(-x^2)` underflows.
#     A corpus that stopped at `|x| = 2` would never look at the tail.
#   * lanes with `x < 0`. 7.1.26 holds for `x >= 0` and nothing else; the
#     negative half is the odd symmetry, a `select` on the sign, and it is
#     the one branch in the composition. scripts/tile-gpu-diff runs an
#     all-non-negative CONTROL corpus beside the real one, so that the
#     mutant that drops the flip can be shown to be caught by the negative
#     lanes and not by anything else.
#   * lanes near zero, where the approximation's absolute error is largest
#     relative to the answer (7.1.26 is worst around |x| = 1.4 in absolute
#     terms and the tier is absolute, so this is coverage rather than a
#     hazard).
#
# Both kernels are TOLERANCE tier and cannot be anything else: 7.1.26's
# error is 1.5e-7 by construction, and its host reference is an accurate
# series rather than the same rational.

# The sweep's shape: ERF_N values over ERF_TILE lanes a block. 500 is not a
# multiple of 128, so the last of the four blocks runs 12 lanes past the end
# and the tail mask is doing real work.
const ERF_N: Int = 500
const ERF_TILE: Int = 128

# `erf(x)`, lane by lane: a coverage kernel with no leetgpu problem behind
# it, the way `int_ops`, `scatter_perm` and `cas_swap` have none. 65 uses
# the error function inside a product, where a large multiplier could hide
# where the error is; here it is on its own, so what layer 2 measures is
# 7.1.26's error and nothing else.
fn erf_sweep(x: Param[F64], out: Param[F64]) -> Unit !Dev = store_cell(out, erf(load_cell(x)))

# The gate's shape: the input is one buffer of 2 * GEGLU_HALF values, its
# first half the values to gate and its second half the gates, which is
# leetgpu 65's `input.chunk(2)`. The output is GEGLU_HALF long. 300 is not
# a multiple of 128, so the last of the three blocks runs 84 lanes past the
# end of each half.
const GEGLU_HALF: Int = 300
const GEGLU_TILE: Int = 128

# One over the square root of two, to the nearest Float: the problem's
# `x / math.sqrt(2.0)` as a multiplication.
const GEGLU_INV_SQRT2: Float = 0.7071067811865475

# `x1 * 0.5 * x2 * (1 + erf(x2 / sqrt(2)))` with `x1, x2 = input.chunk(2)`:
# leetgpu 65 (Gaussian Error Gated Linear Unit). The gate is the EXACT
# gelu and not the tanh approximation, because the problem says
# `torch.erf`.
#
# The second half is read with the SAME mask as the first, at a base
# GEGLU_HALF elements further on: the two halves are one buffer, so the
# lane's own tail mask is what keeps both loads inside it.
#
# The two halves are one buffer read at two bases under one mask, which is
# the pointer path's (an In of the whole tensor); the output is the block's
# cell.
fn geglu(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [GEGLU_TILE]
  let blk = tile_at(block_id(0), GEGLU_TILE)
  let m = tail_mask(blk, s, GEGLU_HALF)
  let zero = f_const(F64, 0.0)
  let a = load(x, blk, s, mask: Some(m), pad: Some(zero))
  let b = load(x, idx_add(blk, idx_const(GEGLU_HALF)), s, mask: Some(m), pad: Some(zero))
  let g = erf(mul(b, f_const(F64, GEGLU_INV_SQRT2)))
  let gate = mul(mul(f_const(F64, 0.5), b), addf(f_const(F64, 1.0), g))
  store_cell(out, mul(a, gate))
}

# ---- the trigonometric kernels (knife T1) ----

# The sweep's shape: TRIG_N arguments over TRIG_TILE lanes a block, and an
# output buffer SEVEN segments long. 500 is not a multiple of 128, so the
# last of the four blocks runs 12 lanes past the end of every segment and
# the tail mask is doing real work at seven base offsets rather than one.
const TRIG_N: Int = 500
const TRIG_TILE: Int = 128

# The seven operations knife T1 adds, each over the same block of lanes and
# each written to its OWN segment of the output rather than summed into a
# total. `mathops` sums its ten, which is enough to catch an opcode copied
# from the wrong row of the frozen table but not enough to say WHICH lane
# of which function moved; here every lane of every function is its own
# comparison, and the layer-2 mutant that writes `sin`'s opcode as `cos`
# reddens the first segment and leaves the other six alone.
#
# Three buffers in: `x` is the argument of the five unary operations and
# the numerator of the `atan2`, `y` is that `atan2`'s denominator (its
# zeros are the axes), and `z` is the remainder's divisor (never zero: a
# remainder by zero is a NaN, and a NaN is not within a tolerance of
# anything). Masked-off lanes take 0 for `x` and 1 for the two divisors, so
# nothing outside the corpus divides by zero even in a lane no store keeps.
#
# Tolerance tier: five of the seven are libdevice approximations and the
# `atan2` is one too. `remf` alone is exact, and it is exact here as well;
# it rides in this kernel because its corpus and its shape are the same.
#
# Seven segments of one buffer, a block writing the same place in each: read
# as seven rows of TRIG_N, the block's lanes of every segment are one cell
# of eight rows (seven is not a power of two; the extent stops the eighth),
# its columns following grid axis 0 and its rows axis 1, which has one
# block (`along: [1, 0]`), and a segment is the piece `[j, 0]`. The extent
# TRIG_N is also what stops the tail; the mask is the reads'. So is every
# other segmented kernel below (the element format kernels and the pack
# round trip).
fn trig_sweep(x: Param[F64], y: Param[F64], z: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [TRIG_TILE]
  let blk = tile_at(block_id(0), TRIG_TILE)
  let m = tail_mask(blk, s, TRIG_N)
  let zero = f_const(F64, 0.0)
  let one = f_const(F64, 1.0)
  let a = load(x, blk, s, mask: Some(m), pad: Some(zero))
  let b = load(y, blk, s, mask: Some(m), pad: Some(one))
  let c = load(z, blk, s, mask: Some(m), pad: Some(one))
  let seg = (j: Int, t: Tile[F64]) => store_sub(out, [j, 0], reshape(t, [1, TRIG_TILE]))
  seg(0, sin(a))
  seg(1, cos(a))
  seg(2, tan(a))
  seg(3, sinh(a))
  seg(4, cosh(a))
  seg(5, atan2(a, b))
  seg(6, remf(a, c))
}

# leetgpu 61's shape: ROPE_M rows of ROPE_D, one block a row block.
const ROPE_M: Int = 96
const ROPE_D: Int = 32
const ROPE_HALF: Int = 16
const ROPE_ROWS: Int = 32

# `Q * cos + rotate_half(Q) * sin` over an M by D buffer: leetgpu 61
# (Rotary Positional Embedding). `rotate_half` swaps a row's two halves and
# negates what lands first, so the answer is
# `[x1 c - x2 s, x2 c + x1 s]` with `x1` and `x2` the halves.
#
# IT COMPUTES NO TRIGONOMETRIC FUNCTION. The problem hands `cos` and `sin`
# in as buffers, exactly as leetgpu 93 does, so this kernel is the same
# arithmetic `llama_rope` is and needs nothing knife T1 adds. That makes it
# this family's KERNEL-LEVEL CONTROL: the three trigonometric mutants may
# not move it, at layer 0 or on the device. Its row in the leetgpu ledger
# is a knife-18 style spending of mechanism already paid for, and the
# reason it lands in this knife rather than another is written in
# docs/tile-backend-design.md.
#
# The two tables are read at the FIRST HALF's columns only, with the row
# stride ROPE_D, because the problem guarantees them half-split (column `j`
# and column `j + D/2` hold the same value). `tileref/ref.rope61_ref` reads
# them at the full column instead, so the two are one shortcut apart and a
# corpus whose tables were not half-split would separate them.
#
# Since the batch's PR-3 every buffer is cut into the halves of a row block
# (`rope_half()`, one half picked by `load_at`), and the output's cell, the
# whole row block, is written in its two halves (`store_sub`).
fn rope(q: Param[F64], cs: Param[F64], sn: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let lo = [idx_const(0)]
  let x1 = load_at(q, lo)
  let x2 = load_at(q, [idx_const(1)])
  let c = load_at(cs, lo)
  let s = load_at(sn, lo)
  store_sub(out, [0, 0], sub(mul(x1, c), mul(x2, s)))
  store_sub(out, [0, 1], addf(mul(x2, c), mul(x1, s)))
}

# ---- the element format kernels (knife T3) ----
#
# One kernel a format, and every one of them the same shape: `DT_SEG`
# segments of `DT_N` lanes in one output buffer, so a lane of one operation
# is its own comparison and a mutant that moves one segment leaves the
# others alone (`trig_sweep`'s shape, and for its reason).
#
# The four float ones are ROUND TRIPS and not arithmetic. The dialect gives
# `tf32` and the three fp8 formats to `ftof` and to memory and keeps them
# out of `addf` (Ops.td's BaseFloatTileType is f16, bf16, f32 and f64), so
# what there is to say about them is what a conversion does and what a
# buffer holds, said twice: once reading a buffer OF the format and once
# converting an f64 into it and back.
#
# The lengths are multiples of the tile width on purpose: these kernels
# carry no mask, because a masked load would need a padding CONSTANT of the
# format and a constant of tf32 or of an fp8 format has no encoding in this
# writer (bytecode.dawn's float_payload says so by refusing). Nothing here
# needs one.
const DT_N: Int = 512
const DT_TILE: Int = 128

# The i16 kernel: five segments, the four arithmetic operations this width
# has a spelling for and the itof / ftoi round trip.
#
# The wrap at 2^15 is the point of the first three. i16 is the narrowest
# format whose whole range fits in a Float exactly, so the device's wrap and
# std/gpu's `wrap_i16` are a bit-exact comparison and the corpus can reach
# both ends of the range (scripts/tile-gpu-diff/dtype_diff.dawn counts how
# often it does).
fn dtype_i16(a: Param[I16], b: Param[I16], out: Param[I16]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[I16]) => store_sub(out, [j, 0], reshape(t, [1, DT_TILE]))
  let ta = load_cell(a)
  let tb = load_cell(b)
  seg(0, addi(ta, tb))
  seg(1, subi(ta, tb))
  seg(2, muli(ta, tb))
  seg(3, shri(shli(ta, consti(I16, 3)), consti(I16, 2)))
  seg(4, float_to_int(int_to_float(ta, F64), I16))
}

# The i64 kernel: four segments, the three arithmetic operations and the
# itof / ftoi round trip.
#
# The PRODUCTS are what says this is 64-bit arithmetic and not i32's: the
# corpus multiplies operands whose product leaves the i32 range, and an i32
# `muli` would wrap where this one does not. What the corpus cannot say
# anything about is the wrap at 2^63, because the host channel is
# `List[Float]` and a binary64 significand stops at 2^53; that debt is named
# in std/gpu's `I64` and in scripts/tileir-features/types.txt.
fn dtype_i64(a: Param[I64], b: Param[I64], out: Param[I64]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[I64]) => store_sub(out, [j, 0], reshape(t, [1, DT_TILE]))
  let ta = load_cell(a)
  let tb = load_cell(b)
  seg(0, addi(ta, tb))
  seg(1, subi(ta, tb))
  seg(2, muli(ta, tb))
  # the one CONSTANT of this width in the tree: 2^32 needs five of its
  # eight bytes, so a payload written four bytes wide is a blob the reader
  # measures against the type and refuses (the mutant
  # i64-payload-four-bytes)
  seg(3, addi(ta, consti(I64, I64_STEP)))
  seg(4, float_to_int(int_to_float(ta, F64), I64))
}

# 2^32: a constant no i32 tile could hold, and the smallest round number
# that says so.
const I64_STEP: Int = 4294967296

# The four narrow float formats, one kernel each and one body: segment 0
# reads a buffer OF the format and widens it to f64, segment 1 takes an f64
# and goes there and back. The first is the storage form and the second is
# the conversion, and a format that had only one of them would still have a
# kernel here.
fn dtype_tf32(x: Param[TF32], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[F64]) => store_sub(out, [j, 0], reshape(t, [1, DT_TILE]))
  seg(0, float_to_float(load_cell(x), F64))
  seg(1, float_to_float(float_to_float(load_cell(y), TF32), F64))
}

fn dtype_e4m3(x: Param[F8E4M3FN], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[F64]) => store_sub(out, [j, 0], reshape(t, [1, DT_TILE]))
  seg(0, float_to_float(load_cell(x), F64))
  seg(1, float_to_float(float_to_float(load_cell(y), F8E4M3FN), F64))
}

fn dtype_e5m2(x: Param[F8E5M2], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[F64]) => store_sub(out, [j, 0], reshape(t, [1, DT_TILE]))
  seg(0, float_to_float(load_cell(x), F64))
  seg(1, float_to_float(float_to_float(load_cell(y), F8E5M2), F64))
}

# The one kernel whose SECOND conversion carries a rounding mode nothing
# else here does: `ftof` into f8E8M0FNU takes only `zero` or `positive_inf`,
# never the `nearest_even` every other conversion in this file writes
# (bytecode.dawn's ftof_rounding). The mutant
# e8m0-rounding-as-nearest-even is that sentence turned into a refusal.
#
# AND IT IS THE ONE KERNEL THAT DETOURS THROUGH f32. `ftof` from f64
# straight into f8E8M0FNU makes tileiras 13.3.36 die of SIGILL with nothing
# on either stream (measured 2026-09-05, exit 132, at every --gpu-name);
# from f32 it is accepted. So this goes f64 -> f32 -> f8E8M0FNU -> f32 ->
# f64 and the host reference rounds the same way twice
# (std/gpu.dtype_e8m0_ref). The detour is a WORKAROUND FOR AN ASSEMBLER BUG
# and not a property of the format: docs/tile-backend-design.md 6.6 records
# it, because a later tileiras that fixes it should let this kernel lose
# two conversions.
fn dtype_e8m0(x: Param[F8E8M0FNU], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[F64]) => store_sub(out, [j, 0], reshape(t, [1, DT_TILE]))
  seg(0, float_to_float(load_cell(x), F64))
  let narrowed = float_to_float(load_cell(y), F32)
  let exponent = float_to_float(narrowed, F8E8M0FNU)
  seg(1, float_to_float(float_to_float(exponent, F32), F64))
}

# ---- the sub-byte formats (knife T9) ----
#
# `i4` and `f4E2M1FN` are the two element formats narrower than a byte, and
# `pack` / `unpack` are the two operations that reach them: nothing else in
# the dialect does. There is no `ptr<i4>` (Types.td leaves `i4` out of
# `CudaTile_AnyInt`, so the pointer type will not parse), so a buffer of
# either format does not exist and a kernel over one has to bring the bytes
# in itself. That is why every parameter below is an ordinary buffer and the
# first thing each kernel does is `pack` it into an `i8` tile.
#
# `pack` and `unpack` move no bits. `pack` reads a rank-1 tile as the byte
# array it occupies and `unpack` reads a rank-1 byte tile as a tile of
# another format, so the pair is the identity on every bit pattern and the
# lane count scales by the ratio of the widths. Two elements of a sub-byte
# format share a byte, the EVEN one in the low nibble (Types.td spells the
# order out).
const I4_N: Int = 512
const I4_TILE: Int = 32
const I4_BYTES: Int = 128
const I4_LANES: Int = 256
const I4_HALVES: Int = 64

# The i4 kernel: five segments, each 32 i32 lanes wide, each one nibble
# operation packed back into the words it came from.
#
# THE SIGNEDNESS OF THE WIDENING IS SEGMENTS 1 AND 2, and they are the same
# expression under the two readings. `i4` has no arithmetic of its own (it
# is in none of the dialect's integer tile constraints), so a kernel widens,
# computes at 32 bits and truncates back; and + - * are blind to which
# widening was used, because they agree modulo 16. An arithmetic SHIFT is
# not: -1 >> 1 is -1 and 15 >> 1 is 7, and they are different nibbles. So
# segment 1 shifts the sign-extended nibble and segment 2 the zero-extended
# one, and they differ on exactly the lanes whose top bit is set.
#
# SEGMENT 4 IS THE NIBBLE ORDER, and it is here because nothing else in this
# kernel can see it. Every other segment applies ONE function to every lane,
# and a reader who had the two nibbles of a byte the wrong way round would
# read lane k as lane k^1, compute the same thing and write it back to k^1:
# the word that comes out is the same word. So the order is only visible
# where the operation depends on the lane INDEX, and this segment takes a's
# nibble on even lanes and b's on odd ones.
fn dtype_i4(a: Param[I32], b: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[I32]) => store_sub(out, [j, 0], reshape(t, [1, I4_TILE]))
  let na = unpack_bytes(pack_bytes(load_cell(a)), I4)
  let nb = unpack_bytes(pack_bytes(load_cell(b)), I4)
  let sa = ext_i4(na)
  let sb = ext_i4(nb)
  let ua = ext_u4(na)
  let odd = int_to_mask(arange(I4_LANES))
  let words = (v: Tile[I32]) => unpack_bytes(pack_bytes(trunc_i4(v)), I32)
  seg(0, words(add_i(sa, sb)))
  seg(1, words(shr_i(sa, i_const(1))))
  seg(2, words(shr_i(ua, i_const(1))))
  seg(3, words(mul_i(sa, sb)))
  seg(4, words(select(odd, sb, sa)))
}

# The fp4 kernel: two segments, the storage form and the conversion, the
# shape knife T3 gave the four narrow float formats.
#
# Segment 0 is the BIT PATTERN read: an i32 buffer of packed nibbles becomes
# an `f4E2M1FN` tile and is widened to f64, so what it asks is which value
# each of the sixteen encodings is. Segment 1 is the conversion: an f64
# taken into the format and back, so what it asks is where the rounding
# boundaries are, what 6.0 saturates from and what happens above it.
const E2M1_N: Int = 512
const E2M1_TILE: Int = 128
const E2M1_BYTES: Int = 64
const E2M1_WORDS: Int = 16

fn dtype_e2m1(x: Param[I32], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[F64]) => store_sub(out, [j, 0], reshape(t, [1, E2M1_TILE]))
  let nibbles = unpack_bytes(pack_bytes(load_cell(x)), F4E2M1FN)
  seg(0, float_to_float(nibbles, F64))
  seg(1, float_to_float(float_to_float(load_cell(y), F4E2M1FN), F64))
}

# The round trip: `unpack` then `pack`, twice, once in each direction, and
# the answer is the bytes that went in.
#
# This is the kernel that says the PAIR is an identity rather than that
# either one is right, and it says it at two widths: segment 0 through the
# sub-byte format, where the lane count doubles, and segment 1 through
# `i16`, where it halves. The dialect's own examples of `pack` are an f16
# tile and an f4E2M1FN one, and those are the two directions.
#
# THIS KERNEL DOES NOT GO THROUGH f4E2M1FN, and that is a measurement.
# `tileiras` 13.3.36 refuses the TYPE at sm_86 and sm_89 (`Incompatibility
# with architecture 'sm_86': unsupported type 'f4E2M1FN'`), not merely fp4
# arithmetic, so even a round trip that converts nothing cannot be loaded on
# this machine. fp4 therefore stops at layer 1 here exactly as the three fp8
# formats do, and dtype_e2m1 is where it is spelled.
fn pack_roundtrip(a: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[I32]) => store_sub(out, [j, 0], reshape(t, [1, I4_TILE]))
  let packed = pack_bytes(load_cell(a))
  seg(0, unpack_bytes(pack_bytes(unpack_bytes(packed, I4)), I32))
  seg(1, unpack_bytes(pack_bytes(unpack_bytes(packed, I16)), I32))
}

# ---- the multi-launch kernels (knife 16) ----
#
# Each of these is one STEP of a host-side sequence, not a whole problem.
# Nothing about the kernel says so: a step is a kernel like any other, and
# what makes leetgpu 85 three launches rather than one is that its
# intermediate results are device buffers no host ever reads.
# scripts/tile-gpu-diff/seq_diff.dawn is where the sequences live.
#
# The shapes here and seq_diff's constants must agree, the way every other
# family's do.

# leetgpu 85 (LoRA Linear): output = x W^T + scale * (x A^T) B^T over a
# batch of LORA_M rows. The weights are stored `out` by `in`, which is what
# makes all three products A times B-TRANSPOSED: the second operand's tile
# is read with its two strides swapped (`permute`), not moved.
const LORA_M: Int = 32
const LORA_DIN: Int = 64
const LORA_DOUT: Int = 64
const LORA_RANK: Int = 16
const LORA_T: Int = 32
const LORA_SCALE: Float = 0.5

# The base linear, launch 1 of 3: base[M, DOUT] = x[M, DIN] * W[DOUT, DIN]^T.
#
# Since the batch's PR-3 the weights are read by their cells, which are rows
# of `w` (`out` by `in`), and turned into the column block the product
# wants by `permute_tile` in registers, where the pointer path read them
# with the two strides swapped; the three LoRA launches and the attention
# family below read every transposed operand that way.
fn lora_base(x: Param[F64], w: Param[F64], base: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, LORA_DIN / LORA_T, zeros(base),
    (k, sofar) => mmaf(load_at(x, [k]), permute_tile(load_at(w, [k]), [1, 0]), sofar))
  store_cell(base, acc)
}

# The low-rank projection, launch 2 of 3: h[M, RANK] = x[M, DIN] * A[RANK, DIN]^T.
# One block: RANK is narrower than a tile, which is the point of a rank.
fn lora_hidden(x: Param[F64], a: Param[F64], h: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, LORA_DIN / LORA_T, zeros(h),
    (k, sofar) => mmaf(load_at(x, [k]), permute_tile(load_at(a, [k]), [1, 0]), sofar))
  store_cell(h, acc)
}

# The sum, launch 3 of 3: out = base + scale * (h[M, RANK] * B[DOUT, RANK]^T).
# This is the launch that reads what BOTH earlier launches wrote.
fn lora_out(base: Param[F64], h: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let at = [idx_const(0)]
  let delta = mmaf(load_at(h, at), permute_tile(load_at(b, at), [1, 0]), f_const(F64, 0.0))
  store_cell(out, addf(load_cell(base), mul(f_const(F64, LORA_SCALE), delta)))
}

# leetgpu 6 (Softmax Attention): softmax(Q K^T / sqrt(d)) V, three launches
# over two intermediate matrices that never leave the device. The standard
# shape of the whole attention family, which is twelve of the problems this
# knife's mechanism reaches.
const ATT_M: Int = 64
const ATT_N: Int = 64
const ATT_D: Int = 32
const ATT_T: Int = 32

# 1 / sqrt(ATT_D), to the nearest Float: the problem's `/ d ** 0.5` as a
# multiplication, and a constant of the recording the way LORA_SCALE is.
const ATT_INV_SQRT_D: Float = 0.17677669529663687

# Launch 1 of 3: S[M, N] = Q[M, D] * K[N, D]^T / sqrt(D). K is stored one
# key a row, so this is the transposed product again.
fn attn_scores(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = store_cell(s, att_scaled(q, k))

# Launch 2 of 3: the softmax of each row of S, one row a block. Reads the
# whole row, so no mask: ATT_N is the tile.
#
# Its rows are a run as long as the grid makes it (`run_of(ATT_N)`), which
# is what lets the multi-head and the int8-cache sequences launch it over
# more rows than this family has.
fn attn_softmax(s: Param[F64], p: Param[F64]) -> Unit !Dev = {
  let t = load_cell(s)
  let ex = exp(sub(t, reduce_max(t)))
  store_cell(p, div(ex, reduce_sum(ex)))
}

# Launch 3 of 3: O[M, D] = P[M, N] * V[N, D], an ordinary row-major product.
fn attn_context(p: Param[F64], v: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, ATT_N / ATT_T, zeros(o), (k, sofar) => mmaf(load_at(p, [k]), load_at(v, [k]), sofar))
  store_cell(o, acc)
}

# FlashAttention (Dao et al. 2022): the same softmax(Q K^T / sqrt(d)) V as
# the three launches above, in ONE launch that never writes S or P. Each
# block owns FA_BQ queries and walks the keys and values FA_BK at a time,
# carrying three tiles across the walk: the running maximum `m` of each
# query's scores, the running sum `l` of their exponentials, and the
# running weighted sum `acc` of the values. The final answer is `acc / l`.
#
# Why the ONLINE softmax. A softmax needs the maximum of the whole row
# before its first exponential (that is what keeps `exp` from overflowing),
# and the three-launch version gets it by writing the whole score row to
# memory and reading it back. The online form instead subtracts the maximum
# seen SO FAR, and when a later block raises it, rescales what is already
# summed by `exp(m_old - m_new)`. In exact arithmetic that factor turns
# every term already summed into the one the larger maximum would have
# given, so the answer is the same softmax (in floating point it is within
# the tolerance of it: the `probe flash` line of scripts/tile-gpu-diff's
# seq_diff measures how far), and the score matrix only ever exists one
# FA_BQ by FA_BK block at a time, in registers.
#
# Two choices here that a reader of the textbook form should know about.
#
# A row statistic is a [FA_BQ, 1] tile: `reduce_max` and `reduce_sum` with
# `keepdims` keep the folded dimension at length 1, and `broadcast` widens
# it back to the scores and the accumulator where it meets them. (Before
# tileir 0.8.0 the surface had no way back from a [FA_BQ] vector, and this
# kernel spelt a row's maximum as the larger of its prefix and suffix scans
# and a row's sum as a product with a block of ones.)
#
# FA_BK is ATT_D: the key block is as wide as a head, so the scores, the
# probabilities and the accumulator are all one FA_BQ by ATT_D shape.
#
# Format and shape: f64, ATT_M by ATT_D queries against ATT_N keys, which
# are knife 16's. The same format as the three launches is what lets the
# host compare the two algorithms at one tolerance (packages/tileref's
# `flash_attn_ref` is this loop on the host, held to the three references
# chained), and sm_86 assembles f64 `mmaf` the way it does for the rest of
# the attention family. The FlashAttention of the paper is f16 operands with
# an f32 accumulator; that is a different tolerance, not a different
# algorithm.
const FA_BQ: Int = 32
const FA_BK: Int = ATT_D

fn flash_attn(q: Param[F64], k: Param[F64], v: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let tq = load_cell(q)
  let m0 = broadcast(f_const(F64, neg_inf()), [FA_BQ, 1])
  let l0 = broadcast(f_const(F64, 0.0), [FA_BQ, 1])
  let (_m, l, acc) = d_for3(idx_const(0), idx_const(ATT_N / FA_BK), idx_const(1), m0, l0, zeros(o), (j, m, l, acc) => {
    let qk = mmaf(tq, permute_tile(load_at(k, [j]), [1, 0]), f_const(F64, 0.0))
    let s = mul(qk, f_const(F64, ATT_INV_SQRT_D))
    let m_new = maxf(m, reduce_max(s, keepdims: true))
    let p = exp(sub(s, broadcast(m_new, [FA_BQ, FA_BK])))
    let alpha = exp(sub(m, m_new))
    let l_new = addf(mul(l, alpha), reduce_sum(p, keepdims: true))
    let acc_new = mmaf(p, load_at(v, [j]), mul(acc, broadcast(alpha, [FA_BQ, ATT_D])))
    (m_new, l_new, acc_new)
  })
  store_cell(o, div(acc, broadcast(l, [FA_BQ, ATT_D])))
}

# leetgpu 37 (Matrix Power): one square product, launched P-1 times with the
# host ping-ponging between two accumulators. The only kernel here that is
# the WHOLE of its problem: the sequence's length is the problem's exponent,
# a host value, and the kernel does not know how many times it runs.
const MP_N: Int = 32

fn matpow_step(a: Param[F64], b: Param[F64], c: Param[F64]) -> Unit !Dev =
  store_cell(c, mmaf(load_cell(a), load_cell(b), f_const(F64, 0.0)))

# leetgpu 84 (SwiGLU MLP Block): (silu(x Wg) * (x Wu)) Wd, four launches
# over three kernels -- the projection kernel is launched TWICE, on two
# different weight buffers into two different outputs. That is the case a
# one-kernel-one-problem ledger cannot spell at all.
const SW_M: Int = 32
const SW_DMODEL: Int = 64
const SW_DFFN: Int = 128
const SW_T: Int = 32

# Launches 1 and 2 of 4: y[M, DFFN] = x[M, DMODEL] * w[DMODEL, DFFN].
fn swiglu_proj(x: Param[F64], w: Param[F64], y: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, SW_DMODEL / SW_T, zeros(y), (k, sofar) => mmaf(load_at(x, [k]), load_at(w, [k]), sofar))
  store_cell(y, acc)
}

# Launch 3 of 4: h = silu(gate) * up, element-wise over the whole M by DFFN
# block. The launch that reads what the two projections wrote.
const SW_ACT_TILE: Int = 128

fn swiglu_act(gate: Param[F64], up: Param[F64], h: Param[F64]) -> Unit !Dev = {
  let tg = load_cell(gate)
  let d = addf(f_const(F64, 1.0), exp(neg(tg)))
  store_cell(h, mul(div(tg, d), load_cell(up)))
}

# Launch 4 of 4: out[M, DMODEL] = h[M, DFFN] * Wd[DFFN, DMODEL].
fn swiglu_down(h: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, SW_DFFN / SW_T, zeros(out), (k, sofar) => mmaf(load_at(h, [k]), load_at(w, [k]), sofar))
  store_cell(out, acc)
}

# leetgpu 73 (All-Pairs Shortest Paths): one Floyd-Warshall round,
# `d = min(d, d[:, k] + d[k, :])`, launched APSP_N times IN PLACE on one
# matrix. The round index `k` is a one-element i32 buffer rather than an
# argument, because a launch carries a grid and buffers and nothing else;
# the kernel reads it by gathering it through an all-zero index tile, which
# broadcasts one element over the whole tile.
#
# The pivot row and column are gathered rather than loaded, for the same
# reason: their offsets depend on a value that is not known when the kernel
# is recorded. `k * N + j` and `i * N + k` are the two index tiles.
#
# One block over one tile, so every gather and the load all precede the
# store: the round reads the matrix as it was before it.
const APSP_N: Int = 16

fn apsp_step(d: Param[F64], kb: Param[I32]) -> Unit !Dev = {
  let sh = [APSP_N, APSP_N]
  let k = gather(kb, i_const(0))
  let row = add_i(mul_i(k, i_const(APSP_N)), coord(idx_const(0), sh, 1, 1))
  let col = add_i(coord(idx_const(0), sh, 0, APSP_N), k)
  let through = addf(gather(d, col), gather(d, row))
  store(d, idx_const(0), minf(load(d, idx_const(0), sh), through))
}

# leetgpu 53, 55, 59, 92 and 112 (knife 17): five more score kernels, and
# nothing else. Every one of them is `attn_scores` plus a rule on the
# position (i, j) of the score it is about to store, and four of the five
# hand their result to the SAME `attn_softmax` and `attn_context` knife 16
# recorded. That reuse is the point: an attention variant is a rule on a
# score, so the family costs one kernel a problem rather than three.
#
# All five run at knife 16's attention shape (ATT_M by ATT_D queries against
# ATT_N keys), which is what makes the two reused recordings applicable
# without re-recording them.

## The scaled product both `attn_scores` and the five below start from:
## `Q[bm] K[bn]^T / sqrt(D)` for one ATT_T by ATT_T block of the score
## matrix, the query rows following grid axis 0 and the key rows axis 1
## (`att_qk`), each read as its one cell along the head dimension. Written once here rather than five more times; the trace is the
## same operations in the same order either way.
fn att_scaled(q: Param[F64], k: Param[F64]) -> Tile[F64] !Dev = {
  let at = [idx_const(0)]
  let acc = mmaf(load_at(q, at), permute_tile(load_at(k, at), [1, 0]), f_const(F64, 0.0))
  mul(acc, f_const(F64, ATT_INV_SQRT_D))
}

## The two GLOBAL coordinates every rule below is a function of: the query
## index `i` and the key index `j` of each lane, counted from the block's
## own base rather than from the tile's.
fn att_row(bm: Idx) -> Tile[I32] !Dev = coord(idx_mul(bm, idx_const(ATT_T)), [ATT_T, ATT_T], 0, 1)

fn att_col(bn: Idx) -> Tile[I32] !Dev = coord(idx_mul(bn, idx_const(ATT_T)), [ATT_T, ATT_T], 1, 1)

# leetgpu 53 (Causal Self-Attention): the score at a key in the query's
# future is -inf, so `attn_softmax` gives it weight exactly zero.
fn attn_causal(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let v = att_scaled(q, k)
  let allowed = ge_i(att_row(bm), att_col(bn))
  store_cell(s, select(allowed, v, f_const(F64, neg_inf())))
}

# leetgpu 55 (Attention with Linear Biases): ALiBi. No mask at all -- the
# rule ADDS `alpha * (i - j)` to every score, so the whole matrix stays
# finite and the slope is a host constant of the recording.
const ATT_ALIBI: Float = 0.0 - 0.125

fn attn_alibi(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let v = att_scaled(q, k)
  let bias = mul(f_const(F64, ATT_ALIBI), int_to_float(sub_i(att_row(bm), att_col(bn)), F64))
  store_cell(s, addf(v, bias))
}

# leetgpu 59 (Sliding Window Self-Attention): a band of half-width
# ATT_WINDOW about the diagonal, both directions. The only rule here that is
# not causal.
const ATT_WINDOW: Int = 8

fn attn_window(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let v = att_scaled(q, k)
  let near = lt_i(abs_i(sub_i(att_row(bm), att_col(bn))), i_const(ATT_WINDOW + 1))
  store_cell(s, select(near, v, f_const(F64, neg_inf())))
}

# leetgpu 112 (Attention with Sinks): causal, and within that either one of
# the first ATT_SINKS keys or inside the trailing window. Two masks joined
# by an `or` under an `and`, which is the widest rule of the five.
const ATT_SINKS: Int = 4
const ATT_SINK_WINDOW: Int = 16

fn attn_sinks(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let v = att_scaled(q, k)
  let gi = att_row(bm)
  let gj = att_col(bn)
  let causal = ge_i(gi, gj)
  let sink = lt_i(gj, i_const(ATT_SINKS))
  let window = ge_i(gj, add_i(gi, i_const(1 - ATT_SINK_WINDOW)))
  let allowed = and_mask(causal, or_mask(sink, window))
  store_cell(s, select(allowed, v, f_const(F64, neg_inf())))
}

# leetgpu 92 (Decaying Causal Attention): the one variant with NO softmax.
# The weight of key `j` for query `i` is the raw score times `gamma^(i - j)`
# for `i >= j` and zero otherwise, so this kernel's output goes straight to
# `attn_context` and the sequence is two launches rather than three.
#
# `gamma^d` is `exp(d * ln gamma)` here, with `ln gamma` a host constant of
# the recording: the same `exp` the rest of this family already runs on the
# device and the same `ref_exp` the host reference already has, rather than
# a `pow` whose two sides would be two different approximations.
const ATT_LN_GAMMA: Float = 0.0 - 0.10536051565782628

fn attn_decay(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bm = block_id(0)
  let bn = block_id(1)
  let v = att_scaled(q, k)
  let gi = att_row(bm)
  let gj = att_col(bn)
  let ahead = int_to_float(max_i(sub_i(gi, gj), i_const(0)), F64)
  let decay = exp(mul(ahead, f_const(F64, ATT_LN_GAMMA)))
  store_cell(s,
    select(ge_i(gi, gj), mul(v, decay), f_const(F64, 0.0)))
}

# leetgpu 25 (Categorical Cross Entropy Loss): two launches, a row at a time
# and then the mean. The only sequence of this knife that is not attention,
# and the first recorded kernel to read an INDEX out of an integer buffer to
# pick a column with (the `apsp` rounds gather a scalar, not a choice).
const CCE_N: Int = 64
const CCE_C: Int = 32

# Launch 1 of 2: `logsumexp(row) - row[label]`, one row a block. The row
# index is not an argument, so it is read out of the lane numbers: lane `l`
# of a 1-wide tile at block `i` is `i`, and `i * C + label[i]` is the
# element of `logits` the true class sits at.
fn cce_row(logits: Param[F64], labels: Param[I32], loss: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let t = load(logits, tile_at(i, CCE_C), [CCE_C])
  let mx = reduce_max(t)
  let total = reduce_sum(exp(sub(t, mx)))
  let at = lanes(tile_at(i, 1), [1])
  let true_logit = gather(logits, add_i(mul_i(at, i_const(CCE_C)), gather(labels, at)))
  store_cell(loss, sub(addf(mx, log(total)), true_logit))
}

# Launch 2 of 2: the mean of the CCE_N row losses, one block over one tile.
# It reads no block id at all, which is why the grid mutant is invisible
# here (run.sh's table says so beside the other two).
fn cce_mean(l: Param[F64], out: Param[F64]) -> Unit !Dev =
  store_cell(out, div(reduce_sum(load_cell(l)), f_const(F64, to_float(CCE_N))))

# ---- knife 18: the mechanism-complete singles, and the head axis ----
#
# Nothing below adds an operation to the package. Seven of these eight
# kernels are one launch each, written out of what knives 7a to 12 already
# had, and the two at the end are the attention family read one HEAD at a
# time. What knife 18 adds is the observation that a mechanism nobody has
# spent is not the same as a problem nobody can solve.

# leetgpu 18 (Sparse Matrix-Vector Multiplication). `A` is handed to
# `solve` as a DENSE M by N buffer and the problem's own reference is
# `torch.matmul(A, x)`, so "sparse" describes the data and not the format:
# the zeroes are values. The vector is read with a stride of ZERO along the
# row axis, so one `x[j]` serves every row, and the row sums are the
# product folded along dimension 1. No `mmaf`, so a corpus of small whole
# numbers makes this EXACT where the GEMMs are tolerance.
const MV_M: Int = 64
const MV_N: Int = 64

fn matvec(a: Param[F64], x: Param[F64], y: Param[F64]) -> Unit !Dev = {
  let tx = load(x, idx_const(0), [MV_M, MV_N], strides: Some(axis_strides(2, 1, 1)))
  store_cell(y, reduce_sum(mul(load_cell(a), tx)))
}

# leetgpu 48 (2D Subarray Sum): the i32 sum of a RECTANGLE of an
# S2_ROWS by S2_COLS matrix, at element 0 of the second buffer. leetgpu 47
# is the same sum over a run of a flat buffer and `subarray_sum` masks it
# with one `in_range` over `lanes`; a rectangle needs one per axis, because
# a lane outside the window along the rows may be inside it along the
# columns.
#
# The tile is RANK 1 and the two coordinates are recovered from the lane
# number by a `divi` and a `remi`, rather than rank 2 with a `coord` an
# axis. That is not a preference: `d_reduce_i` reduces to a SCALAR and so
# reduces one dimension, and a rank-2 integer sum would need two of them.
# The array's rank and the tile's are independent, which is the thing to
# take from this kernel and the next.
#
# Both bounds are INCLUSIVE in the problem's statement, so the mask's upper
# limits are one past them. Neither window touches an edge of the matrix,
# so a mask that dropped either bound would show.
const S2_ROWS: Int = 32
const S2_COLS: Int = 64
const S2_R0: Int = 5
const S2_R1: Int = 27
const S2_C0: Int = 9
const S2_C1: Int = 52

fn subarray_sum2d(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let sh = [S2_ROWS * S2_COLS]
  let zero = idx_const(0)
  let flat = lanes(zero, sh)
  let cols = i_const(S2_COLS)
  let inside = and_mask(in_range(div_i(flat, cols), S2_R0, S2_R1 + 1), in_range(rem_i(flat, cols), S2_C0, S2_C1 + 1))
  let t = load(x, zero, sh, mask: Some(inside), pad: Some(i_const(0)))
  store_cell(out, d_reduce(t, 0.0, (acc, e) => add_i(acc, e)))
}

# leetgpu 49 (3D Subarray Sum): the same over a BOX of an
# S3_DEP by S3_ROWS by S3_COLS array. One more axis is one more division
# and nothing else: the tile stays rank 1, the depth is the lane number
# divided by the plane, and the row is what is left over divided by the
# width. A third dimension costs arithmetic here, not a tile rank.
const S3_DEP: Int = 4
const S3_ROWS: Int = 8
const S3_COLS: Int = 32
const S3_D0: Int = 1
const S3_D1: Int = 2
const S3_R0: Int = 2
const S3_R1: Int = 6
const S3_C0: Int = 3
const S3_C1: Int = 29

fn subarray_sum3d(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let sh = [S3_DEP * S3_ROWS * S3_COLS]
  let zero = idx_const(0)
  let flat = lanes(zero, sh)
  let cols = i_const(S3_COLS)
  let plane = i_const(S3_ROWS * S3_COLS)
  let depth = in_range(div_i(flat, plane), S3_D0, S3_D1 + 1)
  let rows = in_range(rem_i(div_i(flat, cols), i_const(S3_ROWS)), S3_R0, S3_R1 + 1)
  let inside = and_mask(and_mask(depth, rows), in_range(rem_i(flat, cols), S3_C0, S3_C1 + 1))
  let t = load(x, zero, sh, mask: Some(inside), pad: Some(i_const(0)))
  store_cell(out, d_reduce(t, 0.0, (acc, e) => add_i(acc, e)))
}

# leetgpu 54 (Swish-Gated Linear Unit): `silu(x1) * x2` with
# `x1, x2 = input.chunk(2)`, one buffer read at two bases the way `geglu`
# reads its own. NOT leetgpu 84's third launch: that one is handed two
# separate buffers a projection wrote, and this one is handed one buffer
# and has to find its own halves. SWH_HALF is not a multiple of the tile,
# so the last block runs past the end of both halves under one mask.
const SWH_HALF: Int = 500
const SWH_TILE: Int = 128

fn swiglu_half(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let sh = [SWH_TILE]
  let blk = tile_at(block_id(0), SWH_TILE)
  let m = tail_mask(blk, sh, SWH_HALF)
  let zero = f_const(F64, 0.0)
  let a = load(x, blk, sh, mask: Some(m), pad: Some(zero))
  let b = load(x, idx_add(blk, idx_const(SWH_HALF)), sh, mask: Some(m), pad: Some(zero))
  let d = addf(f_const(F64, 1.0), exp(neg(a)))
  store_cell(out, mul(div(a, d), b))
}

# leetgpu 64 (Weight Dequantization): `Y = X * S` where one element of `S`
# scales a DQ_TS by DQ_TS block of `X`. The scale's address is
# `(i / TS) * s_cols + (j / TS)`, an index each lane computes out of its
# own coordinates, so this is knife 12's gather with no buffer read for the
# index at all: the arithmetic is the whole of the indirection. Every index
# is inside `S` by construction, so the gather is unmasked and this kernel
# is `token_embed`'s control in run.sh's gather-mask-dropped.
const DQ_M: Int = 64
const DQ_N: Int = 64
const DQ_TS: Int = 16

fn dq_cols() -> Int = DQ_N / DQ_TS

fn dequant(x: Param[F64], s: Param[F64], y: Param[F64]) -> Unit !Dev = {
  let sh = [DQ_M, DQ_N]
  let zero = idx_const(0)
  let ts = i_const(DQ_TS)
  let at = add_i(mul_i(div_i(coord(zero, sh, 0, 1), ts), i_const(dq_cols())), div_i(coord(zero, sh, 1, 1), ts))
  store_cell(y, mul(load_cell(x), gather(s, at)))
}

# leetgpu 11 (3D Convolution), valid mode. `conv2d` is one load a tap at a
# base shifted by `p * width + q`; this is the same with the third
# dimension on the GRID: block `d` computes output plane `d`, and the tap's
# depth offset is a constant times the plane. The three extents differ and
# so do the three kernel extents, so a kernel that confused two of them
# would answer a different shape rather than a different number.
const C3_D: Int = 8
const C3_H: Int = 12
const C3_W: Int = 16
const C3_KD: Int = 2
const C3_KH: Int = 3
const C3_KW: Int = 3
const C3_TILE: Int = 16

fn c3_od() -> Int = C3_D - C3_KD + 1

fn c3_oh() -> Int = C3_H - C3_KH + 1

fn c3_ow() -> Int = C3_W - C3_KW + 1

fn conv3d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let sh = [C3_TILE, C3_TILE]
  let bd = block_id(0)
  let zero = idx_const(0)
  let m = and_mask(axis_mask(zero, sh, 0, c3_oh()), axis_mask(zero, sh, 1, c3_ow()))
  let pad = f_const(F64, 0.0)
  let corner = idx_mul(bd, idx_const(C3_H * C3_W))
  var acc = pad
  for p in range(0, C3_KD) {
    for q in range(0, C3_KH) {
      for r in range(0, C3_KW) {
        let xt = load(x, idx_add(corner, idx_const(p * C3_H * C3_W + q * C3_W + r)), sh, strides: Some([C3_W, 1]), mask: Some(m), pad: Some(pad))
        let wt = load(w, idx_const((p * C3_KH + q) * C3_KW + r), sh, strides: Some([0, 0]))
        acc = addf(acc, mul(xt, wt))
      }
    }
  }
  store_cell(out, reshape(acc, [1, C3_TILE, C3_TILE]))
}

# leetgpu 12 (Multi-Head Attention): the attention family with a HEAD axis.
# `Q`, `K` and `V` are one N by d_model matrix each, head `h` owning the
# columns `[h * DK, (h + 1) * DK)`, and the answer goes back into the same
# columns of the output. So the head is not a separate matrix: it is a
# COLUMN SLICE, which is a base offset and a row stride and nothing else.
#
# The middle launch is knife 16's `attn_softmax`, unchanged and
# un-re-recorded: the scores of all MHA_H heads are written one head after
# another, each head an MHA_N by MHA_N block, so the whole scores buffer is
# MHA_H * MHA_N rows of MHA_N and a softmax by row is a softmax by row. The
# grid does the rest. That is knife 17's lesson spent once more, on an axis
# rather than on a mask.
const MHA_N: Int = 64
const MHA_DMODEL: Int = 64
const MHA_H: Int = 2
const MHA_DK: Int = 32
const MHA_T: Int = 32

# 1 / sqrt(MHA_DK), to the nearest Float.
const MHA_INV_SQRT_DK: Float = 0.17677669529663687

# Launch 1 of 3: S[h, M, N] = Q_h * K_h^T / sqrt(DK), the head on the
# grid's THIRD axis and the head's columns at `bh * MHA_DK`. The scores are
# cut [1, T, T] with the head following axis 2 (`along: [2, 0, 1]`), and
# the product is reshaped to the cell.
fn mha_scores(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let acc = mmaf(load_cell(q), permute_tile(load_cell(k), [1, 0]), f_const(F64, 0.0))
  store_cell(s, reshape(mul(acc, f_const(F64, MHA_INV_SQRT_DK)), [1, MHA_T, MHA_T]))
}

# Launch 3 of 3: O[:, h] = P_h * V_h, reading the head's block of the
# probabilities and the head's columns of `V`, and writing the head's
# columns of the output: its cell, whose columns follow axis 2 where the
# head is (`along: [0, 2]`).
fn mha_context(p: Param[F64], v: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let rows = idx_add(idx_mul(block_id(2), idx_const(MHA_N * MHA_N)), idx_mul(block_id(0), idx_const(MHA_T * MHA_N)))
  let acc = d_range(0, MHA_N / MHA_T, zeros(o), (kk, sofar) => {
    let tp = load(p, idx_add(rows, idx_mul(kk, idx_const(MHA_T))), [MHA_T, MHA_T], strides: Some([MHA_N, 1]))
    mmaf(tp, load_at(v, [kk]), sofar)
  })
  store_cell(o, acc)
}

# ---- knife 19: the pairwise pair, and four more sequences ----
#
# Nothing below adds an operation to the package either. Two of these ten
# are the whole of a problem (leetgpu 14 and 38, the last two in the
# "mechanism complete, nobody wrote it" bucket); the other eight are steps
# of four sequences whose middle launch is a kernel knives 16 and 17
# already recorded.

# leetgpu 14 (Multi-Agent Simulation). Each agent is four consecutive
# floats -- x, y, vx, vy -- so the buffer is AG_N by 4 read with a stride
# of 4 down each column, and an agent's own four are the same reads with a
# stride of ZERO. One block an agent, and the block's tile runs over all
# the OTHER agents: a lane is a pair, which is what makes this and
# `nearest_idx` one shape and two problems.
#
# The self pair is removed the way the problem's own reference removes it,
# by scoring the diagonal above the radius rather than by a second mask,
# and an agent with no neighbour keeps its own velocity -- which is why the
# division's denominator is a `select` and never a zero.
const AG_N: Int = 64
const AG_R2: Float = 25.0
const AG_ALPHA: Float = 0.05

fn agent_step(a: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let i = block_id(0)
  let sh = [AG_N]
  let one = [1]
  let base = idx_mul(i, idx_const(4))
  let px = load(a, idx_const(0), sh, strides: Some([4]))
  let py = load(a, idx_const(1), sh, strides: Some([4]))
  let vx = load(a, idx_const(2), sh, strides: Some([4]))
  let vy = load(a, idx_const(3), sh, strides: Some([4]))
  let mx = load(a, base, sh, strides: Some([0]))
  let my = load(a, idx_add(base, idx_const(1)), sh, strides: Some([0]))
  let ex = sub(mx, px)
  let ey = sub(my, py)
  let d2 = addf(mul(ex, ex), mul(ey, ey))
  let is_self = eq_i(coord(i, sh, 0, 0), coord(idx_const(0), sh, 0, 1))
  let scored = select(is_self, f_const(F64, AG_R2 + 1.0), d2)
  let near = lt(scored, f_const(F64, AG_R2))
  let nil = f_const(F64, 0.0)
  let sx = reduce_sum(select(near, vx, nil))
  let sy = reduce_sum(select(near, vy, nil))
  let n = reduce_sum(select(near, f_const(F64, 1.0), nil))
  let has = gt(n, f_const(F64, 0.0))
  let den = select(has, n, f_const(F64, 1.0))
  let ox = load(a, base, one, strides: Some([0]))
  let oy = load(a, idx_add(base, idx_const(1)), one, strides: Some([0]))
  let ovx = load(a, idx_add(base, idx_const(2)), one, strides: Some([0]))
  let ovy = load(a, idx_add(base, idx_const(3)), one, strides: Some([0]))
  let avx = select(has, div(sx, den), ovx)
  let avy = select(has, div(sy, den), ovy)
  let alpha = f_const(F64, AG_ALPHA)
  let nvx = addf(ovx, mul(alpha, sub(avx, ovx)))
  let nvy = addf(ovy, mul(alpha, sub(avy, ovy)))
  store_sub(out, [0], addf(ox, nvx))
  store_sub(out, [1], addf(oy, nvy))
  store_sub(out, [2], nvx)
  store_sub(out, [3], nvy)
}

# leetgpu 38 (Nearest Neighbor). The same pairwise tile as `agent_step`
# over three coordinates instead of two, and the answer is an INDEX rather
# than a number: `argmax`'s two-accumulator fold, but written into an i32
# buffer instead of spread over a one-hot f64 one. It is the only kernel
# recorded here that reads f64 and writes i32.
#
# The self pair is scored +inf rather than removed. Ties are not broken:
# `d_reduce2`'s order is unspecified, so a corpus with two equally near
# neighbours would have no answer, and stride_diff's `distinct` line counts
# that the corpus has none.
const NN_N: Int = 64

fn nearest_idx(p: Param[F64], out: Param[I32]) -> Unit !Dev = {
  let i = block_id(0)
  let sh = [NN_N]
  let base = idx_mul(i, idx_const(3))
  let jx = load(p, idx_const(0), sh, strides: Some([3]))
  let jy = load(p, idx_const(1), sh, strides: Some([3]))
  let jz = load(p, idx_const(2), sh, strides: Some([3]))
  let ix = load(p, base, sh, strides: Some([0]))
  let iy = load(p, idx_add(base, idx_const(1)), sh, strides: Some([0]))
  let iz = load(p, idx_add(base, idx_const(2)), sh, strides: Some([0]))
  let ex = sub(ix, jx)
  let ey = sub(iy, jy)
  let ez = sub(iz, jz)
  let d2 = addf(addf(mul(ex, ex), mul(ey, ey)), mul(ez, ez))
  let lane = coord(idx_const(0), sh, 0, 1)
  let is_self = eq_i(coord(i, sh, 0, 0), lane)
  let scored = select(is_self, f_const(F64, pos_inf()), d2)
  let (_best, which) = d_reduce2(scored, lane, pos_inf(), 0 - 1, (av, ai, ev, ei) => {
    let win = gt(ev, av)
    (select(win, av, ev), select(win, ai, ei))
  })
  store_cell(out, which)
}

# leetgpu 26 (Multi-Head Cross-Attention). `mha_scores` and `mha_context`
# at TWO sequence lengths: Q has XA_M rows and K and V have XA_N, which is
# the whole of what "cross" means here. The layout is knife 18's -- head
# `h` owns the columns `[h * XA_D, (h + 1) * XA_D)` of a row of
# XA_DMODEL -- so these two are that pair with the row count of the query
# and the key told apart, and the middle launch is `attn_softmax` again,
# over XA_H * XA_M rows of XA_N.
const XA_M: Int = 32
const XA_N: Int = 64
const XA_H: Int = 2
const XA_D: Int = 32
const XA_DMODEL: Int = 64
const XA_T: Int = 32

# 1 / sqrt(XA_D), to the nearest Float.
const XA_INV_SQRT_D: Float = 0.17677669529663687

fn xattn_scores(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let acc = mmaf(load_cell(q), permute_tile(load_cell(k), [1, 0]), f_const(F64, 0.0))
  store_cell(s, reshape(mul(acc, f_const(F64, XA_INV_SQRT_D)), [1, XA_T, XA_T]))
}

fn xattn_context(p: Param[F64], v: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let rows = idx_add(idx_mul(block_id(2), idx_const(XA_M * XA_N)), idx_mul(block_id(0), idx_const(XA_T * XA_N)))
  let acc = d_range(0, XA_N / XA_T, zeros(o), (kk, sofar) => {
    let tp = load(p, idx_add(rows, idx_mul(kk, idx_const(XA_T))), [XA_T, XA_T], strides: Some([XA_N, 1]))
    mmaf(tp, load_at(v, [kk]), sofar)
  })
  store_cell(o, acc)
}

# leetgpu 80 (Grouped Query Attention). GQ_HQ query heads share GQ_HKV key
# and value heads, `GQ_GROUPS` of the first to one of the second, and each
# head is a CONTIGUOUS GQ_S by GQ_D matrix rather than a column slice. So
# the head arithmetic runs the other way from leetgpu 12's: the grid's
# third axis is the KV head and its first is the query's position INSIDE
# the group, and `qh = kv * GQ_GROUPS + g` recovers the query head.
#
# That spelling is not a preference. A grid has three axes; a row block, a
# column block, a group and a KV head are four, and `Idx` has no division
# to fold two of them into one. Recording at GQ_S == GQ_T -- one block a
# whole head -- is what frees the first axis for the group.
const GQ_HQ: Int = 4
const GQ_HKV: Int = 2
const GQ_GROUPS: Int = 2
const GQ_S: Int = 64
const GQ_D: Int = 32
const GQ_T: Int = 32

# 1 / sqrt(GQ_D), to the nearest Float.
const GQ_INV_SQRT_D: Float = 0.17677669529663687

# Read as GQ_HKV by GQ_GROUPS * GQ_S by GQ_S, the scores buffer is the same
# memory as GQ_HQ by GQ_S by GQ_S (row-major, `kv * GQ_GROUPS + g` is a
# mixed-radix number), and query head `kv * GQ_GROUPS + g` is the cell at
# `(kv, g)`: `kv` follows axis 2 and `g` axis 0 (`along: [2, 0, 1]`), and
# the product is reshaped to the cell's leading 1. `gqa_context`'s output
# is cut the same way.
fn gqa_scores(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let qh = idx_add(idx_mul(block_id(2), idx_const(GQ_GROUPS)), block_id(0))
  let tq = load(q, idx_mul(qh, idx_const(GQ_S * GQ_D)), [GQ_S, GQ_D])
  let acc = mmaf(tq, permute_tile(load_cell(k), [1, 0]), f_const(F64, 0.0))
  store_cell(s, reshape(mul(acc, f_const(F64, GQ_INV_SQRT_D)), [1, GQ_S, GQ_S]))
}

fn gqa_context(p: Param[F64], v: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let bkv = block_id(2)
  let qh = idx_add(idx_mul(bkv, idx_const(GQ_GROUPS)), block_id(0))
  let rows = idx_mul(qh, idx_const(GQ_S * GQ_S))
  let acc = d_range(0, GQ_S / GQ_T, broadcast(f_const(F64, 0.0), [GQ_S, GQ_D]), (kk, sofar) => {
    let tp = load(p, idx_add(rows, idx_mul(kk, idx_const(GQ_T))), [GQ_S, GQ_T], strides: Some([GQ_S, 1]))
    let tv = load(v, idx_add(idx_mul(bkv, idx_const(GQ_S * GQ_D)), idx_mul(kk, idx_const(GQ_T * GQ_D))),
      [GQ_T, GQ_D])
    mmaf(tp, tv, sofar)
  })
  store_cell(o, reshape(acc, [1, GQ_S, GQ_D]))
}

# leetgpu 109 (GRPO Surrogate Loss). Three launches, and the third is knife
# 17's `cce_mean` byte for byte: the loss is a mean over GR_B * GR_G rows,
# and `cce_mean` averages 64 lanes into one. The NEGATION the problem asks
# for is folded into the row launch rather than added after the mean --
# negation is exact, so the mean of the negated rows is the negated mean --
# which is the whole of why the last kernel is reused rather than written.
const GR_B: Int = 8
const GR_G: Int = 8
const GR_S: Int = 32
const GR_CLIP: Float = 0.2
const GR_BETA: Float = 0.1
const GR_STD_EPS: Float = 1.0e-8

# Launch 1 of 3: the group-normalised advantage of every reward, one batch
# a block. The problem's standard deviation is the BIASED one (torch's
# `unbiased=False`), so both moments divide by GR_G.
fn grpo_adv(r: Param[F64], adv: Param[F64]) -> Unit !Dev = {
  let g = f_const(F64, to_float(GR_G))
  let t = load_cell(r)
  let d = sub(t, div(reduce_sum(t), g))
  let sd = sqrt(div(reduce_sum(mul(d, d)), g))
  store_cell(adv, div(d, addf(sd, f_const(F64, GR_STD_EPS))))
}

# Launch 2 of 3: minus the mean over the sequence of the clipped surrogate
# less the KL penalty, one (batch, group) row a block. The row's advantage
# is one number read with a stride of ZERO.
fn grpo_row(lp: Param[F64], lo: Param[F64], lr: Param[F64], adv: Param[F64],
  rows: Param[F64]) -> Unit !Dev = {
  let a = broadcast(load_cell(adv), [GR_S])
  let p = load_cell(lp)
  let ratio = exp(sub(p, load_cell(lo)))
  let clipped = minf(maxf(ratio, f_const(F64, 1.0 - GR_CLIP)), f_const(F64, 1.0 + GR_CLIP))
  let surrogate = minf(mul(ratio, a), mul(clipped, a))
  let kd = sub(load_cell(lr), p)
  let kl = sub(sub(exp(kd), kd), f_const(F64, 1.0))
  let term = sub(surrogate, mul(f_const(F64, GR_BETA), kl))
  store_cell(rows, neg(div(reduce_sum(term), f_const(F64, to_float(GR_S)))))
}

# leetgpu 20 (K-Means Clustering). Two kernels launched KM_ITERS times
# each, alternately: the first `repeat` client whose ROUND is two launches
# rather than one, and the first sequence whose intermediate is an i32
# buffer the next launch reads as a label.
#
# `kmeans_centroid` writes TWO buffers and reads them both, in place, and
# masks its store to `KM_K`: a block past the last cluster owns no
# centroid, which is what keeps the grid mutant from writing off the end of
# a four-element buffer.
const KM_N: Int = 64
const KM_K: Int = 4

fn kmeans_assign(dx: Param[F64], dy: Param[F64], cx: Param[F64], cy: Param[F64],
  lab: Param[I32]) -> Unit !Dev = {
  let i = block_id(0)
  let sh = [KM_K]
  let at = [idx_const(0)]
  let ex = sub(load(dx, i, sh, strides: Some([0])), load_at(cx, at))
  let ey = sub(load(dy, i, sh, strides: Some([0])), load_at(cy, at))
  let d2 = addf(mul(ex, ex), mul(ey, ey))
  let lane = coord(idx_const(0), sh, 0, 1)
  let (_best, which) = d_reduce2(d2, lane, pos_inf(), 0 - 1, (av, ai, ev, ei) => {
    let win = gt(ev, av)
    (select(win, av, ev), select(win, ai, ei))
  })
  store_cell(lab, which)
}

fn kmeans_centroid(dx: Param[F64], dy: Param[F64], lab: Param[I32], cx: Param[F64],
  cy: Param[F64]) -> Unit !Dev = {
  let at = [idx_const(0)]
  let nil = f_const(F64, 0.0)
  let mine = eq_i(load_at(lab, at), idx_as_tile(block_id(0)))
  let sx = reduce_sum(select(mine, load_at(dx, at), nil))
  let sy = reduce_sum(select(mine, load_at(dy, at), nil))
  let n = reduce_sum(select(mine, f_const(F64, 1.0), nil))
  let has = gt(n, f_const(F64, 0.0))
  let den = select(has, n, f_const(F64, 1.0))
  store_cell(cx, select(has, div(sx, den), load_cell(cx)))
  store_cell(cy, select(has, div(sy, den), load_cell(cy)))
}

# ---- knife 20: an int8 cache, a backward pass, a linear attention and a
# ---- solve ----
#
# Four more sequences, nine kernels, and the reuse is heavier here than in
# any knife before: leetgpu 111 runs SEVEN launches over five kernels and
# only two of them are new, and leetgpu 56 runs three launches over two.
#
# The one thing genuinely new in kind is leetgpu 33: its sequence is a
# GAUSSIAN ELIMINATION, so the launches are not a pipeline of different
# computations but the SAME kernel driven `n_features` times over one
# matrix, with the pivot index in a one-element i32 buffer the way knife
# 16's Floyd-Warshall rounds carry theirs. It is also this file's third
# exact-tier sequence: every operation in it is an `addf`, `subf`, `mulf`
# or `divf` at f64 in an order both sides fix, and IEEE 754 requires all
# four to be correctly rounded, so there is no fold whose tree could
# differ.

# leetgpu 96 (INT8 KV-Cache Attention): one query a head against a cache of
# KV_S keys and values held as int8 with a per-position f32 scale. KV_S is
# knife 16's ATT_N so that the middle launch can be `attn_softmax`
# unchanged: the scores are KV_H rows of KV_S, which is what a softmax by
# row reads whatever the rows mean.
const KV_H: Int = 8
const KV_S: Int = 64
const KV_D: Int = 32

# 1 / sqrt(KV_D), the problem's `1 / math.sqrt(head_dim)`.
const KV_INV_SQRT_D: Float = 0.17677669529663687

## An i8 tile read SIGNED, at i32. The dialect's `exti` here is unsigned
## (knife 11's `invert` is why: a u8 image wants the octet as [0, 255]),
## and the signed widening it does not have is `(u ^ 128) - 128` -- the
## standard two's-complement fold, exact for every octet and costing two
## integer operations rather than a new opcode. std/gpu's `I8` format is
## the host side of the same reading.
fn i8_signed(t: Tile[I8]) -> Tile[I32] !Dev =
  sub_i(xor_i(ext_u8(t), i_const(128)), i_const(128))

## The dequantised cache block of head `h`: `K[h, j, d] * scale[h, j]` as
## an f64 tile of KV_S rows by KV_D columns, the scale broadcast along the
## row with a stride of zero.
fn kv_dequant(c: Param[I8], scale: Param[F64], h: Idx) -> Tile[F64] !Dev = {
  let ts = load(scale, idx_mul(h, idx_const(KV_S)), [KV_S, KV_D], strides: Some(axis_strides(2, 0, 1)))
  mul(int_to_float(i8_signed(load_cell(c)), F64), ts)
}

# Launch 1 of 3: s[h, j] = (Q[h, :] . dequant(K)[h, j, :]) / sqrt(D). One
# block a head, and the query row is read with a stride of ZERO down the
# key axis so that one row of Q serves all KV_S keys.
fn kv_scores(q: Param[F64], k: Param[I8], ks: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let h = block_id(0)
  let tq = load(q, idx_mul(h, idx_const(KV_D)), [KV_S, KV_D], strides: Some(axis_strides(2, 1, 1)))
  let dot = reduce_sum(mul(tq, kv_dequant(k, ks, h)))
  store_cell(s, mul(dot, f_const(F64, KV_INV_SQRT_D)))
}

# Launch 3 of 3: o[h, d] = sum_j p[h, j] * dequant(V)[h, j, d]. The weight
# is the one read with a stride of zero this time, down the FEATURE axis,
# and the fold is along the key axis rather than across it.
fn kv_context(p: Param[F64], v: Param[I8], vs: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let h = block_id(0)
  let tw = load(p, idx_mul(h, idx_const(KV_S)), [KV_S, KV_D], strides: Some(axis_strides(2, 0, 1)))
  store_cell(o, reduce_sum(mul(tw, kv_dequant(v, vs, h)), dim: 0))
}

# leetgpu 111 (Softmax Attention Backward): dQ, dK and dV of the attention
# knife 16 recorded forwards. Seven launches, THREE outputs, and only two
# new kernels -- the other five launches are `attn_scores` twice,
# `attn_softmax` and `attn_context`, all at the shape they were recorded
# at (ATT_M by ATT_D queries against ATT_N keys).
#
# The second `attn_scores` is the reuse worth naming. The gradient wants
# `dP = dO V^T` with NO scale, and `attn_scores` divides by sqrt(d); but
# the row that consumes it,
#
#   dS = (dP * P - P * rowsum(dP * P)) / sqrt(d)
#
# is LINEAR in dP, so dividing dP by sqrt(d) up front and dropping the
# final division gives the same dS. A scale that factors out of an
# expression can be moved to whichever launch already applies it, which is
# the same algebra that let knife 19's leetgpu 109 fold a negation into
# its row launch and reuse `cce_mean`.

# Launch 3 and 7: C[N, D] = A[M, N]^T * B[M, D], the transposed product
# both dV = P^T dO and dK = dS^T Q are. One block a row block of C,
# folding over M in ATT_T-wide chunks; the transpose is in the STRIDES of
# A's tile and nowhere else.
fn attn_bwd_mmt(a: Param[F64], b: Param[F64], c: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, ATT_M / ATT_T, zeros(c),
    (k, sofar) => mmaf(permute_tile(load_at(a, [k]), [1, 0]), load_at(b, [k]), sofar))
  store_cell(c, acc)
}

# Launch 5 of 7: dS = dP * P - P * rowsum(dP * P), one row a block. The
# softmax Jacobian, and the same row-wide reduction `attn_softmax` does
# with the maximum replaced by nothing: the row is ATT_N wide and the tile
# is the whole of it, so there is no mask.
fn attn_bwd_ds(dp: Param[F64], p: Param[F64], ds: Param[F64]) -> Unit !Dev = {
  let tp = load_cell(p)
  let prod = mul(load_cell(dp), tp)
  store_cell(ds, sub(prod, mul(tp, reduce_sum(prod))))
}

# leetgpu 56 (Linear Self-Attention): phi(x) = ELU(x) + 1, S = phi(K)^T V,
# z = sum_j phi(K)[j], out = (phi(Q) S) / (phi(Q) z). THREE launches over
# TWO kernels, and the reuse is on an OPERAND rather than on a grid or a
# mask: a column sum is a product with a column of ones, so `z` is
# `lin_attn_s` run a second time with a buffer of ones where V was. It
# costs the D-fold redundancy of computing the same column in every column
# and saves a kernel, which at this shape is the better trade.
const LA_M: Int = 64
const LA_D: Int = 32
const LA_T: Int = 32

## `phi(x) = ELU(x) + 1`, which is `x + 1` above zero and `exp(x)` at or
## below it: `ELU(x) = exp(x) - 1` there, so the +1 cancels exactly and no
## kernel here ever computes `exp(x) - 1 + 1`.
fn la_phi(t: Tile[F64]) -> Tile[F64] !Dev =
  select(gt(t, f_const(F64, 0.0)), addf(t, f_const(F64, 1.0)), exp(t))

# Launch 1 and 2 of 3: S[a, b] = sum_j phi(K[j, a]) * V[j, b]. One block
# over the whole D by D answer, folding over the M rows in LA_T chunks.
fn lin_attn_s(k: Param[F64], v: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, LA_M / LA_T, zeros(s),
    (j, sofar) => mmaf(la_phi(permute_tile(load_at(k, [j]), [1, 0])), load_at(v, [j]), sofar))
  store_cell(s, acc)
}

# Launch 3 of 3: out[i, b] = (phi(Q) S)[i, b] / (phi(Q) z)[i]. The
# denominator is computed as a SECOND product rather than as a reduction
# followed by a broadcast, because `z` arrives as the first column of a D
# by D matrix and reading it with a column stride of zero makes every
# column of the product the row's denominator. One product, one divide,
# and no rank-1 tile to spread back out.
fn lin_attn_out(q: Param[F64], s: Param[F64], z: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let zero = f_const(F64, 0.0)
  let tq = la_phi(load_cell(q))
  let tz = load(z, idx_const(0), [LA_D, LA_D], strides: Some(axis_strides(2, 0, LA_D)))
  store_cell(out, div(mmaf(tq, load_at(s, [idx_const(0), idx_const(0)]), zero), mmaf(tq, tz, zero)))
}

# leetgpu 33 (Ordinary Least Squares): beta solves X^T X beta = X^T y.
# TWO plus n_features launches -- one to build the augmented normal
# equations, one Gauss-Jordan step per feature, one to read the answer out
# -- and the count is a host value the way leetgpu 37's exponent and 73's
# node count are.
#
# The problem's own reference is a Cholesky factorisation with forward and
# backward substitution, which is a different algorithm; what is compared
# is beta, and the tolerance the problem states is 1e-2. Gauss-Jordan
# needs no pivot search here because a Gram matrix is symmetric positive
# definite, so its leading minors are all positive and no pivot is zero.
#
# The augmented matrix is OLS_F rows of OLS_W, where OLS_W is a power of
# two above n_features + 1: columns 0..F-1 are X^T X, column F is X^T y,
# and the rest are zero and stay zero (they are divided and subtracted
# like every other column, which costs nothing and keeps the tile
# rectangular).
const OLS_N: Int = 64
const OLS_F: Int = 8
const OLS_W: Int = 16

# Launch 1: the augmented normal equations, one block over the whole F by
# W answer. The fold is a `d_for` over the samples, so both the device and
# a host reference add them in index order and every partial sum is the
# same f64 -- which is why this sequence is exact tier and the GEMM
# sequences beside it are not.
fn ols_gram(x: Param[F64], y: Param[F64], a: Param[F64]) -> Unit !Dev = {
  let sh = [OLS_F, OLS_W]
  let col = coord(idx_const(0), sh, 1, 1)
  let inside = lt_i(col, i_const(OLS_F))
  let is_rhs = eq_i(col, i_const(OLS_F))
  let zero = f_const(F64, 0.0)
  let acc = d_range(0, OLS_N, zeros(a), (i, sofar) => {
    let base = idx_mul(i, idx_const(OLS_F))
    let xr = load(x, base, sh, strides: Some(axis_strides(2, 0, 1)))
    let xc = load(x, base, sh, strides: Some(axis_strides(2, 1, 1)), mask: Some(inside), pad: Some(zero))
    let ty = load(y, i, sh, strides: Some([0, 0]))
    addf(sofar, mul(xr, select(is_rhs, ty, xc)))
  })
  store_cell(a, acc)
}

# Launch 2 to F+1: one Gauss-Jordan step in place. The pivot index is a
# one-element i32 buffer and the three things that depend on it -- the
# pivot row, the pivot column and the pivot itself -- are GATHERED through
# index tiles, for the reason knife 16's `apsp_step` gathers its round:
# their offsets are not known when the kernel is recorded.
#
# One block over the whole matrix, so every read precedes the store and
# the step sees the matrix as it was. That is not a preference here but a
# requirement: a block writing row r reads row k, so two blocks would race.
fn ols_elim(a: Param[F64], kb: Param[I32]) -> Unit !Dev = {
  let sh = [OLS_F, OLS_W]
  let k = gather(kb, i_const(0))
  let row = coord(idx_const(0), sh, 0, 1)
  let col = coord(idx_const(0), sh, 1, 1)
  let kw = mul_i(k, i_const(OLS_W))
  let piv = gather(a, add_i(kw, k))
  let prow = div(gather(a, add_i(kw, col)), piv)
  let colk = gather(a, add_i(mul_i(row, i_const(OLS_W)), k))
  let elim = sub(load(a, idx_const(0), sh), mul(colk, prow))
  store(a, idx_const(0), select(eq_i(row, k), prow, elim))
}

# Launch F+2: beta is the augmented column of the reduced matrix, read
# with a stride of OLS_W. The whole of the last launch, and the reason the
# sequence has one at all: what the caller asked for is F numbers and what
# the elimination leaves is an F by W matrix.
fn ols_beta(a: Param[F64], beta: Param[F64]) -> Unit !Dev =
  store_cell(beta, load(a, idx_const(OLS_F), [OLS_F], strides: Some([OLS_W])))

# ---- knife 21: the two transformer blocks ----
#
# Nothing below adds an operation to the package. What is new in kind is the
# SIZE of the sequence: leetgpu 74 is twelve launches and 93 is seventeen,
# where the longest sequence before this knife was leetgpu 33's ten, and
# both are a whole published block rather than one stage of one. Six of
# their twenty-nine launches are kernels earlier knives recorded and this
# one does not touch: `attn_softmax` (knives 16), `gqa_context` (knife 19),
# `swiglu_act` (knife 16) and `vadd` (the first milestone's kernel, whose
# length is its GRID and so is a residual add at any width).
#
# BOTH ARE RECORDED AT A REDUCED MODEL. Every other row of the ledger names
# a problem whose dimensions are the caller's; these two fix theirs (GPT-2
# 124M is D = 768, H = 12, FFN = 3072; the Llama block is D = 512, 8 query
# heads over 2 key heads, FFN 1408). The kernels below are the same programs
# at the published constants -- a recording constant is a loop bound and a
# stride, not a mechanism -- but the SECOND OPINION is a host reference over
# a `List[Float]`, and GPT-2's weight buffer alone is seven million of them.
# So the recording is the block's structure at a shape a host reference can
# answer for, and the ledger's rows say so.

# leetgpu 74 (GPT-2 Transformer Block). Twelve launches: layer norm, the
# fused QKV projection, per-head scores, the softmax, the context product,
# the output projection, the residual, the second layer norm, the two feed
# forward projections with a gelu between them, and the second residual.
#
# The QKV projection writes ONE GP_S by 3 * GP_D buffer, the way the problem
# packs it, so `gpt_scores` and `gpt_context` read Q, K and V out of one
# buffer at column offsets 0, GP_D and 2 * GP_D with a row stride of
# 3 * GP_D. That is why they are not knife 18's `mha_scores` and
# `mha_context`, which read three buffers of GP_D-wide rows.
const GP_S: Int = 64
const GP_D: Int = 64
const GP_H: Int = 2
const GP_DH: Int = 32
const GP_F: Int = 128
const GP_T: Int = 32
const GP_EPS: Float = 1.0e-5

# 1 / sqrt(GP_DH), to the nearest Float.
const GP_INV_SQRT_DH: Float = 0.17677669529663687

# The tile the two element-wise launches of this block cover.
const GP_ACT_TILE: Int = 128

# sqrt(2 / pi) and the cubic coefficient of the TANH approximation of the
# gaussian error linear unit. The reference implementation asks for
# `F.gelu(x, approximate="tanh")` and not for the erf form knife 15
# composed, so `gpt_gelu` is a `tanh` and not an `erf`; the two differ by
# about 1e-3 at |x| = 2, which is far outside the tolerance this sequence
# is judged at.
const GP_GELU_C: Float = 0.7978845608028654
const GP_GELU_K: Float = 0.044715

# Launches 1 and 8 of 12: layer normalisation with an affine, one row a
# block. `layer_norm` is this kernel at another shape (64 rows of 256); a
# recording is one shape, so the block's own 64 by 64 is a recording of its
# own.
fn gpt_ln(x: Param[F64], gamma: Param[F64], beta: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let at = [idx_const(0)]
  let r = normalise(GP_D, GP_EPS, load_cell(x))
  store_cell(out, addf(mul(r, load_at(gamma, at)), load_at(beta, at)))
}

# Launch 2 of 12: qkv[GP_S, 3 * GP_D] = x[GP_S, GP_D] * W[GP_D, 3 * GP_D]
# + b[3 * GP_D], the column tile on the grid's second axis. The bias is one
# row read with a stride of ZERO down the tile's first axis, the way
# `batch_norm` reads its per-channel scale.
## The `[GP_S, GP_T]` block of `bias` this block's columns add: a stride of
## zero down the rows, which is a pointer read (a cell is never a broadcast).
fn gpt_bias(bias: Param[F64]) -> Tile[F64] !Dev =
  load(bias, idx_mul(block_id(1), idx_const(GP_T)), [GP_S, GP_T], strides: Some([0, 1]))

fn gpt_qkv(x: Param[F64], w: Param[F64], bias: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, GP_D / GP_T, zeros(out), (k, sofar) => mmaf(load_at(x, [k]), load_at(w, [k]), sofar))
  store_cell(out, addf(acc, gpt_bias(bias)))
}

# Launch 3 of 12: S[h] = Q_h * K_h^T / sqrt(DH), one head a block on the
# grid's third axis, both operands read out of the packed QKV buffer. The
# scores are GP_H * GP_S rows of GP_S, a head one cell, its rows following
# axis 2 (`along: [2, 0]`).
fn gpt_scores(qkv: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let bh = block_id(2)
  let tq = load_at(qkv, [bh])
  let tk = load_at(qkv, [idx_add(idx_const(GP_D / GP_DH), bh)])
  let acc = mmaf(tq, permute_tile(tk, [1, 0]), f_const(F64, 0.0))
  store_cell(s, mul(acc, f_const(F64, GP_INV_SQRT_DH)))
}

# Launch 5 of 12: O[:, h] = P_h * V_h, the head's block of the
# probabilities against V's columns of the packed buffer, into the head's
# columns of a GP_S by GP_D output: its cell, the columns following axis 2
# where the head is (`along: [0, 2]`).
fn gpt_context(p: Param[F64], qkv: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let vh = idx_add(idx_const(2 * GP_D / GP_DH), block_id(2))
  let acc = d_range(0, GP_S / GP_T, zeros(o), (k, sofar) => mmaf(load_at(p, [k]), load_at(qkv, [k, vh]), sofar))
  store_cell(o, acc)
}

# Launch 6 of 12: the attention output projection, y[GP_S, GP_D] =
# a[GP_S, GP_D] * W[GP_D, GP_D] + b[GP_D].
fn gpt_dense(a: Param[F64], w: Param[F64], bias: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, GP_D / GP_T, zeros(out), (k, sofar) => mmaf(load_at(a, [k]), load_at(w, [k]), sofar))
  store_cell(out, addf(acc, gpt_bias(bias)))
}

# Launch 9 of 12: the first feed-forward projection, y[GP_S, GP_F] =
# a[GP_S, GP_D] * W[GP_D, GP_F] + b[GP_F]. Not `gpt_dense`: the output is
# GP_F wide, and a width is a store stride and a weight stride.
fn gpt_fc(a: Param[F64], w: Param[F64], bias: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, GP_D / GP_T, zeros(out), (k, sofar) => mmaf(load_at(a, [k]), load_at(w, [k]), sofar))
  store_cell(out, addf(acc, gpt_bias(bias)))
}

# Launch 10 of 12: `0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))`
# element-wise, the tanh approximation of the gelu. The one launch of this
# block that is a transcendental function, and `tanh` is an operation the
# package has had since knife 7b.
fn gpt_gelu(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let t = load_cell(x)
  let cube = mul(t, mul(t, t))
  let inner = mul(f_const(F64, GP_GELU_C), addf(t, mul(f_const(F64, GP_GELU_K), cube)))
  let gate = addf(f_const(F64, 1.0), tanh(inner))
  store_cell(out, mul(mul(f_const(F64, 0.5), t), gate))
}

# Launch 11 of 12: the second feed-forward projection, out[GP_S, GP_D] =
# h[GP_S, GP_F] * W[GP_F, GP_D] + b[GP_D]. `gpt_dense`'s shape with GP_F
# where its inner dimension is, so its loop runs twice as many rounds.
fn gpt_down(h: Param[F64], w: Param[F64], bias: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, GP_F / GP_T, zeros(out), (k, sofar) => mmaf(load_at(h, [k]), load_at(w, [k]), sofar))
  store_cell(out, addf(acc, gpt_bias(bias)))
}

# leetgpu 93 (Llama Transformer Block). Seventeen launches, the longest
# sequence in this file, and three things the GPT-2 block does not have:
# weights stored OUT by IN (so every projection is a transposed product),
# grouped query attention with a causal mask, and a rotary position
# embedding.
#
# The rotary embedding needs no trigonometry: the problem's own signature
# hands `cos` and `sin` in as buffers, seq_len by HEAD_DIM/2 each. That was
# the open question this knife was told to settle before recording anything,
# and the answer is in the signature.
#
# The projections write HEAD-MAJOR -- head h's LM_S by LM_HD block at
# h * LM_S * LM_HD -- which is the layout knife 19's `gqa_scores` and
# `gqa_context` were recorded on, and the reason the middle two launches of
# the attention are kernels this knife does not touch.
const LM_S: Int = 64
const LM_HQ: Int = 4
const LM_HKV: Int = 2
const LM_HD: Int = 32
const LM_D: Int = 128
const LM_F: Int = 64
const LM_T: Int = 32
const LM_HALF: Int = 16
const LM_EPS: Float = 1.0e-5

# 1 / sqrt(LM_HD), to the nearest Float. The same number `gqa_scores`
# carries, which is why this block's scores can be its shape.
const LM_INV_SQRT_HD: Float = 0.17677669529663687

# Launches 1 and 12 of 17: root-mean-square normalisation with a learned
# weight, one row a block. Not `rms_norm` (leetgpu 50 has no weight and is
# recorded over a masked 1000-lane vector) and not `fused_rms_norm` (which
# adds a residual first and is 64 rows of 256).
fn llama_rms(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let t = load_cell(x)
  let ms = div(reduce_sum(mul(t, t)), f_const(F64, to_float(LM_D)))
  let r = mul(t, rsqrt(addf(ms, f_const(F64, LM_EPS))))
  store_cell(out, mul(r, load_at(w, [idx_const(0)])))
}

# Launches 2, 3 and 4 of 17: one HEAD of a projection whose weight is
# stored OUT by IN, out[h][s][d] = sum_i x[s][i] * W[h * LM_HD + d][i].
# The head is the grid's second axis and the head's block is one LM_S by
# LM_HD cell of an output as many rows long as the grid makes it
# (`DYN_DIM`, its rows following axis 1), so the SAME kernel is Q at a grid
# of LM_HQ heads and K and V at a grid of LM_HKV: the buffer's total width
# never enters it.
fn llama_qkv(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, LM_D / LM_T, zeros(out),
    (k, sofar) => mmaf(load_at(x, [k]), permute_tile(load_at(w, [k]), [1, 0]), sofar))
  store_cell(out, acc)
}

# Launches 5 and 6 of 17: the rotary position embedding of one head-major
# buffer, `[x1 * c - x2 * s, x1 * s + x2 * c]` over the two halves of each
# head's row. The head's block is its cell, cut as `llama_qkv`'s, and the
# two halves are its pieces `[0, 0]` and `[0, 1]`; `cos` and `sin` are LM_S
# by LM_HALF and every head reads the same table.
fn llama_rope(x: Param[F64], cs: Param[F64], sn: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let x1 = load_at(x, [idx_const(0)])
  let x2 = load_at(x, [idx_const(1)])
  let at = [idx_const(0), idx_const(0)]
  let c = load_at(cs, at)
  let s = load_at(sn, at)
  store_sub(out, [0, 0], sub(mul(x1, c), mul(x2, s)))
  store_sub(out, [0, 1], addf(mul(x1, s), mul(x2, c)))
}

# Launch 7 of 17: `gqa_scores` with a CAUSAL mask. The query head is
# `bkv * groups + bg` as it is there, its cell cut the same way, and the
# score at a key in the query's future is -inf, so `attn_softmax` gives it
# weight exactly zero. One block a query head over the whole LM_S by LM_S
# block, so the coordinates are read from the tile's own base.
fn llama_scores(q: Param[F64], k: Param[F64], s: Param[F64]) -> Unit !Dev = {
  let qh = idx_add(idx_mul(block_id(2), idx_const(LM_HQ / LM_HKV)), block_id(0))
  let sh = [LM_S, LM_S]
  let tq = load(q, idx_mul(qh, idx_const(LM_S * LM_HD)), [LM_S, LM_HD])
  let acc = mmaf(tq, permute_tile(load_cell(k), [1, 0]), f_const(F64, 0.0))
  let scaled = mul(acc, f_const(F64, LM_INV_SQRT_HD))
  let allowed = ge_i(coord(idx_const(0), sh, 0, 1), coord(idx_const(0), sh, 1, 1))
  store_cell(s, reshape(select(allowed, scaled, f_const(F64, neg_inf())), [1, LM_S, LM_S]))
}

# Launch 10 of 17: the heads are merged and projected, out[LM_S, LM_D] =
# concat_h(A_h) * W^T for a W stored OUT by IN. The merge is the LOOP: round
# h reads head h's contiguous LM_S by LM_HD block and the weight columns
# h * LM_HD onward, so no launch ever writes a merged copy.
fn llama_out(a: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, LM_D / LM_HD, zeros(out),
    (h, sofar) => mmaf(load_at(a, [h]), permute_tile(load_at(w, [h]), [1, 0]), sofar))
  store_cell(out, acc)
}

# Launches 13 and 14 of 17: the gate and up projections, y[LM_S, LM_F] =
# x[LM_S, LM_D] * W^T for W stored LM_F by LM_D. One kernel, two launches,
# two weight buffers into two outputs: knife 16's `swiglu_proj` spends the
# same coin on a weight stored IN by OUT.
fn llama_ffn(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, LM_D / LM_T, zeros(out),
    (k, sofar) => mmaf(load_at(x, [k]), permute_tile(load_at(w, [k]), [1, 0]), sofar))
  store_cell(out, acc)
}

# Launch 16 of 17: the down projection, out[LM_S, LM_D] = h[LM_S, LM_F] *
# W^T for W stored LM_D by LM_F. `llama_ffn` with the two widths exchanged.
fn llama_down(h: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let acc = d_range(0, LM_F / LM_T, zeros(out),
    (k, sofar) => mmaf(load_at(h, [k]), permute_tile(load_at(w, [k]), [1, 0]), sofar))
  store_cell(out, acc)
}

# ---- knife T2: shapes, the grid's extent, token joins and pointers ----

# The three shape operations on ONE block of 128 f64, read twice: once as a
# 16 by 8 tile (which `extract` halves and `cat` puts back the other way
# round) and once as a 4 by 4 by 8 one (which `permute` transposes across
# its first two axes).
#
# Two things about the shapes are deliberate and neither is decoration.
# `extract`'s source is 16 by 8 and its result 8 by 4, so BOTH dimensions
# have two slices and the pair of slice indices `[1, 0]` names a different
# quarter from `[0, 1]`: that is what makes extract-indices-reversed a
# wrong answer rather than an out-of-bounds read. And `permute`'s first two
# dimensions are EQUAL, so the identity permutation and `[1, 0, 2]` give
# the same result TYPE: every other permutation of a tile whose dimensions
# differ is refused by the assembler (PermuteOp's verifier derives the
# result shape from the attribute), and a mutant that never reaches the
# device says nothing about what the device does.
fn shape_ops(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let b = block_id(0)
  let base = tile_at(b, 128)
  let obase = tile_at(b, 192)
  let t2 = load(x, base, [16, 8])
  let lower = extract(t2, [8, 4], [idx_const(1), idx_const(0)])
  let upper = extract(t2, [8, 4], [idx_const(0), idx_const(0)])
  store(out, obase, cat(lower, upper, 0))
  let t3 = load(x, base, [4, 4, 8])
  store(out, idx_add(obase, idx_const(64)), permute_tile(t3, [1, 0, 2]))
}

# A grid-stride loop: the grid is SMALLER than the work, and block `b`
# takes tiles `b`, `b + nblocks`, `b + 2 * nblocks` and so on. `rounds` is
# a host constant, so the loop steps by one and multiplies by the grid's
# extent rather than stepping by it -- a loop whose STEP came from
# `get_num_tile_blocks` would not terminate under a mutant that answered
# the block id instead (block 0 would step by zero), and a mutant that
# hangs the device is not a verdict.
#
# This is the only shape in which `get_num_tile_blocks` is visible at
# layer 2: a kernel that merely stored the number would be testing the
# store.
fn grid_stride(x: Param[F64], out: Param[F64], rounds: Int) -> Unit !Dev = {
  let b = block_id(0)
  let nb = num_blocks(0)
  let seed = f_const(F64, 0.0)
  let _last = d_range(0, rounds, seed, (k, acc) => {
    let base = tile_at(idx_add(b, idx_mul(k, nb)), 128)
    store(out, base, mul(load(x, base, [128]), f_const(F64, 2.0)))
    acc
  })
  ()
}

# Two stores issued from ONE token, joined, and a load that depends on the
# join. Without `join_tokens` the two stores would be a chain and the load
# would take the second one's token; here neither store is ordered against
# the other and the load is ordered after both.
#
# The judgement is that the load reads what the two stores wrote, so the
# scratch buffer's own contents before the launch are the sentinel and
# nothing here reproduces them.
fn token_join(x: Param[F64], mid: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let base = tile_at(block_id(0), 128)
  let high = idx_add(base, idx_const(64))
  let lo = load(x, base, [64])
  let hi = load(x, high, [64])
  d_fork2(() => store(mid, base, addf(lo, lo)), () => store(mid, high, mul(hi, f_const(F64, 3.0))))
  store_cell(out, load(mid, base, [128]))
}

# An address taken apart and put back: the pointer tile of a block's own
# chunk becomes i64, an offset of `delta` ELEMENTS is added as `8 * delta`
# BYTES, and the answer is read back as pointers and loaded through. The
# judgement is that this reads exactly what a load at `base + delta` would,
# so the input buffer carries `delta` elements past the last block's chunk.
fn ptr_roundtrip(x: Param[F64], out: Param[F64], delta: Int) -> Unit !Dev = {
  let b = block_id(0)
  let base = tile_at(b, 128)
  let here = ptr_offset(ptrs(x, [128]), lanes(base, [128]))
  let moved = add_i64(ptr_to_int(here), i64_const(8 * delta))
  store_cell(out, load_ptrs(int_to_ptr(moved, F64)))
}

# The same bytes read as another format: an i32 buffer holding binary32
# patterns, its pointer tile reinterpreted as pointers to f32, and the f32
# values widened to f64 on the way out. i32 and f32 are four bytes each, so
# the addresses are the same numbers and only the READING changes; that is
# the whole of what `ptr_to_ptr` does, and the reason the two formats here
# have one width.
fn ptr_recast(x: Param[I32], out: Param[F64]) -> Unit !Dev = {
  let b = block_id(0)
  let base = tile_at(b, 128)
  let words = ptr_offset(ptrs(x, [128]), lanes(base, [128]))
  let reals = ptr_to_ptr(words, F32)
  store_cell(out, float_to_float(load_ptrs(reals), F64))
}

# ---- knife T5: the loop whose trip count the data decides ----
#
# `loop` and `break` are the one region shape the tree was missing: `for`
# counts iterations that the host or the grid fixes, and this one runs
# until a value the kernel computed says stop. All four kernels below are
# one block wide, because what is under test is the iteration and not the
# grid.
#
# THE SHAPE THE PACKAGE EMITS, measured against the dialect rather than
# guessed (tile-backend-design 6.7):
#
#   loop iter_values(%v = %init, %tk = %tok) : ... {
#     <body>
#     if %done { break %v, %tk2 : ... } else { yield }
#     continue %next, %tk2 : ...
#   }
#
# `break` may sit inside an `if` nested in the loop (Ops.td gives it
# `ParentOneOf<["IfOp", "LoopOp"]>`), which is what lets the exit be a C
# style condition rather than a two-part `loop_until`.

## How wide one loop tile is, and how many lanes each corpus fills.
const LOOP_TILE: Int = 128

## How many iterations `loop_bound`'s `for` runs. It has to be at least the
## longest Collatz chain the corpus holds (118, for 27), or the two kernels
## would not answer the same thing.
const COLLATZ_ROUNDS: Int = 128

## The residual `loop_until` stops at, and the value its iteration starts
## from. Newton on `x^2 = a` from 1.0 halves the error every step once it
## is close, so the corpus below settles well inside the bound.
const NEWTON_START: Float = 1.0

## The residual the square root stops under. 1e-12 is far above the level
## the iteration settles at for this corpus (the fixed point's residual is
## about `2 * x * ulp(x)`, which is 4e-14 at the corpus's largest root), so
## the loop terminates rather than oscillating under the bound.
const NEWTON_EPS: Float = 1.0e-12

## `loop_none`'s threshold and step. The corpus is under the threshold, so
## the loop stops before its first step; the step is far over it, so one
## iteration is enough to stop even when the condition is read backwards.
const LOOP_NONE_THRESHOLD: Float = 1.0
const LOOP_NONE_STEP: Float = 1000.0

# One Collatz step per lane, saturating at 1: a lane that has reached 1
# stays there, which is what makes "every lane is 1" a condition that
# stays true once it is true. Answers the next value and the next count.
fn collatz_step(v: Tile[I32], steps: Tile[I32]) -> (Tile[I32], Tile[I32]) !Dev = {
  let one = i_const(1)
  let two = i_const(2)
  let zero = i_const(0)
  let running = lt_i(one, v)
  let even = eq_i(rem_i(v, two), zero)
  let moved = select(even, div_i(v, two), add_i(mul_i(v, i_const(3)), one))
  (select(running, moved, v), add_i(steps, select(running, one, zero)))
}

# The number of Collatz steps each lane needs to reach 1, and the number of
# iterations the loop took, as two tiles of the output buffer. The loop
# carries the values and the counts and stops when the largest value left
# is 1; the round count is the largest step count, because every lane that
# is still moving adds one on every iteration.
#
# The trip count is DATA: 128 lanes of 1 to 128 need 118 iterations, and
# no host constant in this kernel says so.
fn loop_count(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let none = broadcast(i_const(0), [LOOP_TILE])
  let (_left, steps) = d_loop2(load_cell(x), none, (v, s) => {
    let done = le_i(d_reduce(v, 1.0, (acc, e) => max_i(acc, e)), i_const(1))
    let (nv, ns) = collatz_step(v, s)
    (done, nv, ns)
  })
  let rounds = d_reduce(steps, 0.0, (acc, e) => max_i(acc, e))
  store_sub(out, [0], steps)
  store_sub(out, [1], broadcast(rounds, [LOOP_TILE]))
}

# The same answer with no `loop` in it: a `for` over a host constant number
# of rounds, saturating the same way. It is the kernel-level control of
# both loop mutants (its bytecode holds neither opcode, so a writer that
# spells them wrongly cannot move it) and, because it answers the same
# counts, a second opinion on `loop_count` at the same time.
fn loop_bound(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let none = broadcast(i_const(0), [LOOP_TILE])
  let (_left, steps) = d_for2(idx_const(0), idx_const(COLLATZ_ROUNDS), idx_const(1),
    load_cell(x), none, (_k, v, s) => collatz_step(v, s))
  store_cell(out, steps)
}

# Newton's iteration for a square root, run until the largest residual in
# the tile is under `eps`: the second data-dependent trip count, and the
# one whose carried value is a float. Every step is
# `x <- 0.5 * (x + a / x)`, three correctly rounded operations in an order
# the host reference repeats, so the answer is exact tier; the round count
# is carried alongside and lands in the second tile of the output.
fn loop_until(a: Param[F64], out: Param[F64], eps: Float) -> Unit !Dev = {
  let av = load_cell(a)
  let half = f_const(F64, 0.5)
  let start = broadcast(f_const(F64, NEWTON_START), [LOOP_TILE])
  let (x, rounds) = d_loop2(start, broadcast(f_const(F64, 0.0), [LOOP_TILE]), (v, r) => {
    let worst = reduce_max(abs(sub(mul(v, v), av)))
    let nv = mul(half, addf(v, div(av, v)))
    (gt(f_const(F64, eps), worst), nv, addf(r, f_const(F64, 1.0)))
  })
  store_sub(out, [0], x)
  store_sub(out, [1], rounds)
}

# A loop that stops on its FIRST test, before its body has changed
# anything: the corpus is under the threshold, so the condition is true on
# entry and the answer is what went in. It is the zero-iteration case, the
# one a `for` cannot express without a bound of zero, and the one that says
# `break` is reached from inside the `if` rather than at the end of the
# body.
#
# The step is deliberately large enough to take the tile OVER the threshold
# in one iteration. That is what keeps the break-condition mutant a
# terminating program on this kernel: reading the condition backwards makes
# it run exactly one iteration and stop, rather than never stopping, and a
# mutant that hangs the device is not a verdict (the same sentence
# `grid_stride` is written under).
fn loop_none(x: Param[F64], out: Param[F64], threshold: Float, step: Float) -> Unit !Dev = {
  let v = d_loop(load_cell(x), v => (gt(f_const(F64, threshold), reduce_max(v)), addf(v, f_const(F64, step))))
  store_cell(out, v)
}

# ---- knife T17: `return` inside a `loop` (bytecode 13.4) ----

## Where `loop_return`'s blocks leave. A block returns on the first
## iteration whose ENTERING tile holds a value at or above RETURN_AT, and
## breaks on the iteration that is its RETURN_LIMIT-th, whichever test comes
## first in the body; the return test does.
const RETURN_AT: Int = 200
const RETURN_LIMIT: Int = 100

# A loop with two ways out, and the kernel-ending one is the subject: on
# each iteration a block stores how many iterations it has begun, then
# RETURNS if its tile has reached RETURN_AT, then breaks if it has begun
# RETURN_LIMIT of them, then adds one to every lane. What is stored after
# the loop is reached only by a block that broke, so the two halves of a
# block's answer say which exit it took and on which iteration: a block
# that returned has its count in the first half and the sentinel in the
# second.
#
# Four blocks, four outcomes, and every one of them is the corpus's and not
# the kernel's: block 0 returns mid-loop (iteration 74), block 1 never
# reaches RETURN_AT and breaks at RETURN_LIMIT, block 2 returns on its first
# iteration, and block 3 reaches RETURN_AT on its RETURN_LIMIT-th iteration,
# where both tests hold and the return, being first, wins.
#
# Bytecode 13.3 refused the shape: ReturnOp's parents were `entry` and `if`,
# and its verifier walked through `if`s only, so an `if` inside a `loop`
# could not return. 13.4 added `loop` to both (knife T17).
fn loop_return(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let one = i_const(1)
  let (v, _n) = d_loop2(load_cell(x), broadcast(i_const(0), [LOOP_TILE]), (v, n) => {
    let begun = add_i(n, one)
    store_sub(out, [0], begun)
    d_return_if(le_i(i_const(RETURN_AT), d_reduce(v, 0.0, (acc, e) => max_i(acc, e))))
    let rounds = d_reduce(begun, 0.0, (acc, e) => max_i(acc, e))
    (le_i(i_const(RETURN_LIMIT), rounds), add_i(v, one), begun)
  })
  store_sub(out, [1], v)
}

# ---- knife T4: the rest of each attribute domain ----
#
# These eight kernels have no leetgpu problem behind them and compute
# nothing anyone wants. Each one asks ONE question about an attribute
# value the writer had never written: what does the device do with it?
# docs/tile-backend-design.md 6.8 records the answers, and
# scripts/tileir-features/attrs.txt is the ledger they fill in.
#
# The recurring shape is SEGMENTS: one input tile, the same operation
# under two or more attribute values, and each answer in its own stretch
# of the output buffer. That is deliberate. A kernel that computed one
# thing under one attribute could only be compared against a reference
# that already believed what the attribute means; a kernel that computes
# it under both puts the difference in one buffer, where a mutant that
# collapses the two is a lane count and not an argument.
#
# The f32 kernels take f64 BUFFERS and convert on the way in and out:
# `flush_to_zero` and `approx` are refused by the assembler on anything
# but an f32 tile (SharedVerifiers.h's verifyFtz and verifyApprox), and
# std/gpu's real device has no f32 buffer format at all
# (`element_bytes`). Binary64 holds every binary32 value exactly, the
# subnormals attr_ftz is about included, so the narrowing on the way in is
# exact on these corpora and the widening on the way out is exact for
# every f32.

# The shape every attr_ kernel uses: four blocks of 128 lanes.
const ATTR_TILE: Int = 128

# How many ATTR_TILE segments each of them writes per block.
const ATTR_ROUND_SEGS: Int = 6
const ATTR_NAN_SEGS: Int = 16
const ATTR_FTZ_SEGS: Int = 4
const ATTR_APPROX_SEGS: Int = 2
const ATTR_OVERFLOW_SEGS: Int = 3
const ATTR_MEMSEM_SEGS: Int = 3

# Six ways of rounding the same two operands: the sum, the product and the
# quotient, each towards negative and towards positive infinity. The
# operands are f32 values carried in an f64 buffer and the arithmetic is
# f32, so a host reference can do the sum and the product EXACTLY in
# binary64 and round the exact answer itself.
#
# The two directions differ on every lane whose exact result is off the
# f32 grid and agree on every lane whose result is on it, which is what
# makes the corpus half of the judgement: attr_diff counts the lanes where
# a pair differs and run.sh pins that count above zero.
#
# The block's six segments are one cell of `attr_segs(6, 8)`: six is not a
# power of two, so the cell has eight rows and the extent stops the last two.
fn attr_round(x: Param[F64], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[F32]) => store_sub(out, [0, j, 0], reshape(float_to_float(t, F64), [1, 1, ATTR_TILE]))
  let a = float_to_float(load_cell(x), F32)
  let c = float_to_float(load_cell(y), F32)
  seg(0, addf(a, c, rounding: Down))
  seg(1, addf(a, c, rounding: Up))
  seg(2, mul(a, c, rounding: Down))
  seg(3, mul(a, c, rounding: Up))
  seg(4, div(a, c, rounding: Down))
  seg(5, div(a, c, rounding: Up))
}

# The two comparison orderings and the two NaN policies, on a corpus with
# NaNs in it. Sixteen segments: the six predicates ordered, the same six
# unordered, then `maxf` and `minf` with and without `propagate_nan`.
#
# The comparison answers are stored as 0.0 and 1.0 rather than as a mask,
# because a device buffer of i1 is not a thing this backend allocates and
# because a reader wants to see WHICH lane disagreed. Everything here is
# f64: `propagate_nan` is not one of the f32-only modifiers, and the
# comparison attribute is a property of `cmpf` at every width.
fn attr_nan(x: Param[F64], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let a = load_cell(x)
  let c = load_cell(y)
  store_sub(out, [0], as_float(eq(a, c)))
  store_sub(out, [1], as_float(ne(a, c)))
  store_sub(out, [2], as_float(lt(a, c)))
  store_sub(out, [3], as_float(le(a, c)))
  store_sub(out, [4], as_float(gt(a, c)))
  store_sub(out, [5], as_float(ge(a, c)))
  store_sub(out, [6], as_float(eq_u(a, c)))
  store_sub(out, [7], as_float(ne_u(a, c)))
  store_sub(out, [8], as_float(lt_u(a, c)))
  store_sub(out, [9], as_float(le_u(a, c)))
  store_sub(out, [10], as_float(gt_u(a, c)))
  store_sub(out, [11], as_float(ge_u(a, c)))
  store_sub(out, [12], maxf(a, c))
  store_sub(out, [13], maxf(a, c, propagate_nan: true))
  store_sub(out, [14], minf(a, c))
  store_sub(out, [15], minf(a, c, propagate_nan: true))
}

# A mask as 1.0 and 0.0, which is how attr_nan stores a comparison.
fn as_float(m: Tile[I1]) -> Tile[F64] !Dev = int_to_float(mask_to_int(m), F64)

# `flush_to_zero` on the sum and the product, against the same two
# operations without it. The corpus is f32 subnormals and pairs whose
# exact f32 result is subnormal, so the attribute has something to flush;
# on ordinary operands the four segments would be two pairs of equals and
# the kernel would say nothing.
fn attr_ftz(x: Param[F64], y: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let a = float_to_float(load_cell(x), F32)
  let c = float_to_float(load_cell(y), F32)
  store_sub(out, [0], float_to_float(addf(a, c), F64))
  store_sub(out, [1], float_to_float(addf(a, c, ftz: true), F64))
  store_sub(out, [2], float_to_float(mul(a, c), F64))
  store_sub(out, [3], float_to_float(mul(a, c, ftz: true), F64))
}

# The approximate square root beside the correctly rounded one. Both
# segments are the root of the same lanes, so what the pair says is how
# far `rounding<approx>` is from `rounding<nearest_even>` on this device,
# and attr_diff prints that distance rather than asserting a bound on it.
# The tier is tolerance for the same reason every transcendental kernel is
# (docs 6.6): the device's approximation is not the host's.
fn attr_approx(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let a = float_to_float(load_cell(x), F32)
  store_sub(out, [0], float_to_float(sqrt(a), F64))
  store_sub(out, [1], float_to_float(sqrt_approx(a), F64))
}

# The three integer overflow assumptions, one per segment. The corpus does
# NOT overflow: a program that wraps under `no_signed_wrap` is undefined,
# so a kernel that asked what happens then would be asking a question with
# no answer. What this kernel is for is that the assumption reaches the
# assembler and the device still computes the sum, the difference and the
# product a reader expects, which is a smoke test and is recorded as one
# (attrs.txt exempts the three from layer 2 by name).
#
# Three segments a block: a cell of `attr_segs(3, 4)`, as `attr_round`'s.
fn attr_overflow(x: Param[I32], y: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[I32]) => store_sub(out, [0, j, 0], reshape(t, [1, 1, ATTR_TILE]))
  let a = load_cell(x)
  let c = load_cell(y)
  seg(0, add_i(a, c, overflow: NoSignedWrap))
  seg(1, sub_i(a, c, overflow: NoUnsignedWrap))
  seg(2, mul_i(a, c, overflow: NoWrap))
}

# The three memory orderings and the two scopes an atomic can carry beside
# `relaxed device`, one segment each: `acquire tl_blk`, `release sys` and
# `acq_rel device`. Each lane owns its own slot, so there is no race and
# the answer does not depend on the ordering at all -- which is the point.
# An ordering is a constraint on CONCURRENT accesses, and this corpus has
# none, so what a device could tell a reader here is only that the atomic
# still ran. attrs.txt records the five values at layer 1 with that reason
# written out; a judgement about the ordering itself needs two blocks
# racing and a judgement shape this repository does not have.
fn attr_memsem(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let s = [ATTR_TILE]
  let b = block_id(0)
  let base = tile_at(b, ATTR_TILE)
  let obase = tile_at(b, ATTR_MEMSEM_SEGS * ATTR_TILE)
  let v = load_cell(x)
  let slot = lanes(obase, s)
  let _a = atomic_rmw(out, "add_acquire_tl_blk", slot, v)
  let _b = atomic_rmw(out, "add_release_sys", add_i(slot, i_const(ATTR_TILE)), v)
  let _c = atomic_rmw(out, "add_acq_rel_device", add_i(slot, i_const(2 * ATTR_TILE)), v)
  ()
}

# The float read-modify-write mode. Every block adds its own chunk of the
# input into the SAME 128 slots, so four additions land on each slot and
# the lanes collide across blocks the way leetgpu 13's histogram does --
# and the values are small integers, exact in binary32 under any order, so
# the tier is exact by algebra and not by luck (the same argument knife
# 14 wrote down for the integer histogram).
fn attr_addf(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [ATTR_TILE]
  let b = block_id(0)
  let base = tile_at(b, ATTR_TILE)
  let _old = atomic_rmw(out, "addf", lanes(idx_const(0), s), load_cell(x))
  ()
}

# The loop bound comparison, signed and unsigned, over a range that
# straddles 2^31: from 0x7FFFFFF0 to 0x80000010 by one. Read as signed the
# upper bound is negative and the loop does not run; read as unsigned it
# is sixteen above the lower bound and the loop runs sixteen times. The
# kernel counts its own iterations into the two halves of the output, so
# the attribute's effect is an integer a reader can check by hand and not
# a rounding.
const ATTR_UCMP_LO: Int = 0x7FFFFFF0
const ATTR_UCMP_HI: Int = 0x80000010

fn attr_ucmp(out: Param[I32]) -> Unit !Dev = {
  let zero = i_const(0)
  let signed = d_for(idx_const(ATTR_UCMP_LO), idx_const(ATTR_UCMP_HI), idx_const(1), zero,
    (_i, acc) => add_i(acc, i_const(1)))
  let unsigned = d_for(idx_const(ATTR_UCMP_LO), idx_const(ATTR_UCMP_HI), idx_const(1), zero,
    (_i, acc) => add_i(acc, i_const(1)), unsigned_cmp: true)
  store_sub(out, [0], broadcast(signed, [ATTR_TILE]))
  store_sub(out, [1], broadcast(unsigned, [ATTR_TILE]))
}

# ---- knife T17: three attribute values bytecode 13.4 added or nobody used ----

# `ftoi`'s `saturating` modifier, beside the same conversion without it.
# Two segments per block from one f64 tile: saturating over every lane,
# then plain over the lanes whose truncation is an i32 and nowhere else.
# The corpus has lanes above and below the i32 range, both infinities and
# NaN, and in-range lanes with fractions of both signs, the two ends of the
# range among them.
#
# The plain segment is MASKED because its other lanes have no answer to
# hold: Ops.td calls an infinite, NaN or out-of-range input undefined
# behaviour without the modifier, so the store skips exactly those lanes
# (`-2^31 - 1 < x < 2^31` is "truncates into i32") and they keep the
# sentinel. What the device does there anyway is a measurement and not a
# claim (docs/tile-backend-design.md 6.20 records it), which is why the
# judgement holds only the saturating half on those lanes.
const ATTR_SAT_SEGS: Int = 2

fn attr_sat(x: Param[F64], out: Param[I32]) -> Unit !Dev = {
  let s = [ATTR_TILE]
  let b = block_id(0)
  let base = tile_at(b, ATTR_TILE)
  let obase = tile_at(b, ATTR_SAT_SEGS * ATTR_TILE)
  let a = load_cell(x)
  let fits = and_mask(gt(a, f_const(F64, 0.0 - 2147483649.0)), lt(a, f_const(F64, 2147483648.0)))
  store(out, obase, float_to_int(a, I32, saturating: true))
  store(out, idx_add(obase, idx_const(ATTR_TILE)), float_to_int(a, I32), mask: Some(fits))
}

# `ftof` under every rounding mode bytecode 13.4 newly allows on the pairs
# this backend can reach, each beside the `nearest_even` it is to differ
# from. Eleven segments per block, all widened back to f64 for the buffer:
#
#   0-3   f64 -> f32   nearest_even, zero, negative_inf, positive_inf
#   4-6   f32 -> tf32  nearest_even, zero, nearest_away
#   7-8   f32 -> f16   nearest_even, zero
#   9-10  f32 -> bf16  nearest_even, zero
#
# The f32 the last seven start from is the first segment's. Three of the
# widenings back are written in another mode as well (tf32 -> f64 under
# nearest_away, f16 -> f64 under zero, bf16 -> f64 under positive_inf): an
# exact widening takes any of the five since 13.4, and none of them can
# change an exact answer.
const ATTR_FTOF_SEGS: Int = 11

#
# The eleven segments are a cell of `attr_segs(11, 16)`, as `attr_round`'s.
fn attr_ftof(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let seg = (j: Int, t: Tile[F64]) => store_sub(out, [0, j, 0], reshape(t, [1, 1, ATTR_TILE]))
  let a = load_cell(x)
  let f = float_to_float(a, F32)
  seg(0, float_to_float(f, F64))
  seg(1, float_to_float(float_to_float(a, F32, rounding: TowardZero), F64))
  seg(2, float_to_float(float_to_float(a, F32, rounding: Down), F64))
  seg(3, float_to_float(float_to_float(a, F32, rounding: Up), F64))
  seg(4, float_to_float(float_to_float(f, TF32), F64))
  seg(5, float_to_float(float_to_float(f, TF32, rounding: TowardZero), F64))
  seg(6, float_to_float(float_to_float(f, TF32, rounding: NearestAway), F64, rounding: NearestAway))
  seg(7, float_to_float(float_to_float(f, F16), F64))
  seg(8, float_to_float(float_to_float(f, F16, rounding: TowardZero), F64, rounding: TowardZero))
  seg(9, float_to_float(float_to_float(f, BF16), F64))
  seg(10, float_to_float(float_to_float(f, BF16, rounding: TowardZero), F64, rounding: Up))
}

# The atomic EXCHANGE, the one read-modify-write mode no kernel had asked
# for. Every lane of every block swaps its input into one slot of the first
# ATTR_XCHG_SLOTS lanes of `out` -- slot `N - 1 - i` for global lane `i`, so
# no two lanes share one and the answer does not depend on the order they
# arrive in -- and stores what the slot held before into the second
# ATTR_XCHG_SLOTS lanes. The first half is then the input reversed, the
# second the output buffer's own first half reversed.
const ATTR_XCHG_SLOTS: Int = 512

fn attr_xchg(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let s = [ATTR_TILE]
  let b = block_id(0)
  let base = tile_at(b, ATTR_TILE)
  let slot = sub_i(i_const(ATTR_XCHG_SLOTS - 1), lanes(base, s))
  let old = atomic_rmw(out, "xchg", slot, load_cell(x))
  store(out, idx_add(base, idx_const(ATTR_XCHG_SLOTS)), old)
}

# ---- knife T6: assert, assume and print_tko
#
# The three debugging operations of the frozen table, and the two judgement
# shapes they need. Every kernel here is one 128-wide tile over one block:
# what is under test is the operation, not the grid.

## How wide one knife T6 tile is.
const DBG_TILE: Int = 128

## The two limits `assert_guard` is instantiated at. The corpus is 1 to 128,
## so `PASS` is above every lane and `FAIL` is below every lane -- the
## condition `v < limit` is ALL TRUE at one and ALL FALSE at the other. That
## is what makes assert-condition-inverted a two-way mutant: negated, the
## passing kernel fails and the failing one passes, and neither ends up
## half-firing.
const ASSERT_PASS_LIMIT: Int = 1000
const ASSERT_FAIL_LIMIT: Int = 0

## What `assume_divby`'s lanes are multiples of, and what the kernel then
## divides by: the predicate has to be TRUE of the corpus or the program is
## undefined rather than wrong (dev.dawn's AssumePred says why).
const ASSUME_DIVISOR: Int = 32

## The group `assume_same`'s lanes repeat in, and the two bounds
## `assume_bounded` claims. Both are true of the corpus
## scripts/tile-gpu-diff hands them.
const ASSUME_GROUP: Int = 4
const ASSUME_LOW: Int = 0
const ASSUME_HIGH: Int = 100000

# One assertion over the loaded tile, and the tile plus one stored. `limit`
# is what makes the condition all-true or all-false; nothing else differs
# between assert_pass and assert_fail, which is the point: one anchor
# inverts both.
fn assert_guard(x: Param[I32], out: Param[I32], limit: Int) -> Unit !Dev = {
  let v = load_cell(x)
  d_assert(lt_i(v, i_const(limit)), "tile-golden: a lane reached the limit")
  store_cell(out, add_i(v, i_const(1)))
}

# The assertion that holds: every lane is under the limit, so the launch is
# an ordinary one and the answer is the tile plus one.
fn assert_pass(x: Param[I32], out: Param[I32]) -> Unit !Dev = assert_guard(x, out, ASSERT_PASS_LIMIT)

# The assertion that fires: no lane is under the limit. The kernel still
# stores (the dialect lets the tile block keep running), and the HOST is
# told, which is the whole of what this kernel is for.
fn assert_fail(x: Param[I32], out: Param[I32]) -> Unit !Dev = assert_guard(x, out, ASSERT_FAIL_LIMIT)

# A print of two rank-0 tiles the kernel reduced for itself, and the same
# two numbers stored, so that the bytes on standard output and the bytes in
# the buffer are two readings of one answer.
fn print_tile(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let v = load_cell(x)
  let total = d_reduce(v, 0.0, (acc, e) => add_i(acc, e))
  let biggest = d_reduce(v, 0.0, (acc, e) => max_i(acc, e))
  d_print("print_tile sum=%d max=%d\n", [total, biggest])
  store_sub(out, [0], v)
  store_sub(out, [1], broadcast(total, [DBG_TILE]))
  store_sub(out, [2], broadcast(biggest, [DBG_TILE]))
}

# `div_by`: every lane is a multiple of the divisor, and the kernel divides
# by it. The predicate is true of the corpus, so the answer is defined and
# the device is being asked whether an assumption changes it (it must not).
fn assume_divby(x: Param[I32], out: Param[I32]) -> Unit !Dev =
  store_cell(out, div_i(assume_div_by(load_cell(x), ASSUME_DIVISOR), i_const(ASSUME_DIVISOR)))

# `same_elements`: the lanes repeat in groups, and the kernel multiplies.
fn assume_same(x: Param[I32], out: Param[I32]) -> Unit !Dev =
  store_cell(out, mul_i(assume_same_elements(load_cell(x), [ASSUME_GROUP]), i_const(3)))

# `bounded`: the lanes are inside the range, and the kernel adds a constant.
fn assume_bounded(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let lo: Option[Int] = Some(ASSUME_LOW)
  let hi: Option[Int] = Some(ASSUME_HIGH)
  store_cell(out, add_i(assume_in_range(load_cell(x), lo, hi), i_const(5)))
}
# ---- knife T7: the module's static globals ----
#
# `global` allocates a one-dimensional buffer in the module and initializes
# it at MODULE LOAD time; `get_global` answers a pointer to its first
# element. The three kernels below are the three questions a device can be
# asked about that:
#
#   global_table    does the device read back the bytes the host declared?
#                   Two globals, two output segments, so a mutant that
#                   swaps the two symbols or writes one initializer wrong
#                   has somewhere to show.
#   global_scratch  does a global keep its value from one launch to the
#                   next? It is mutable, and the sequence that answers this
#                   is two launches of the SAME module (std/gpu's real
#                   handler loads a module once per kernel name and keeps
#                   it, which is exactly the lifetime the dialect promises).
#   global_ctl      the same answer as global_table out of two buffers, so
#                   it holds neither opcode: the family's kernel-level
#                   control, and a second opinion on the tables.
#   global_flags    global_table's two segments again, out of a `private`
#                   global and a `constant` one. Knife T8: those two words
#                   are the fields the Global section's record grew at
#                   bytecode 13.3, and this is the only kernel here that
#                   writes either. It answers what global_table answers,
#                   which is the point -- neither word changes what a
#                   kernel computes, so what this kernel buys is layer 1,
#                   the assembler accepting them. It stays in this family
#                   and out of scripts/tile-gpu-diff, because the T7
#                   mutants' arithmetic is written for three kernels here.
#                   Knife TG's global_syms below carries the same two words
#                   to the device.
#
# `@tbl_b` asks for a 256-byte alignment and `@tbl_a` takes the dialect's
# default of 0, so the record's alignment varint carries two different
# values in one module rather than always the same one.

const GLOBAL_TILE: Int = 128
const GLOBAL_ALIGN: Int = 256

fn global_table(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [GLOBAL_TILE]
  d_global("tbl_a", F64, global_table_a(GLOBAL_TILE))
  d_global("tbl_b", F64, global_table_b(GLOBAL_TILE), align: GLOBAL_ALIGN)
  let blk = tile_at(block_id(0), GLOBAL_TILE)
  let off = lanes(blk, s)
  let pa = ptr_offset(global_ptrs("tbl_a", F64, s), off)
  let pb = ptr_offset(global_ptrs("tbl_b", F64, s), off)
  let tx = load_cell(x)
  store_sub(out, [0], addf(load_ptrs(pa), tx))
  store_sub(out, [1], addf(load_ptrs(pb), tx))
}

# The same two segments from two buffers. No `global`, no `get_global`, and
# the same answer.
fn global_ctl(a: Param[F64], b: Param[F64], x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let tx = load_cell(x)
  store_sub(out, [0], addf(load_cell(a), tx))
  store_sub(out, [1], addf(load_cell(b), tx))
}

# The same two segments as global_table, out of globals that carry the two
# words the record grew room for at 13.3: `@hidden` is private and `@frozen`
# is constant. It reads them and never stores through either, which the
# second one requires and the dialect does not enforce.
fn global_flags(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [GLOBAL_TILE]
  d_global("hidden", F64, global_table_a(GLOBAL_TILE), visibility: Private)
  d_global("frozen", F64, global_table_b(GLOBAL_TILE), constant: true)
  let blk = tile_at(block_id(0), GLOBAL_TILE)
  let off = lanes(blk, s)
  let pa = ptr_offset(global_ptrs("hidden", F64, s), off)
  let pb = ptr_offset(global_ptrs("frozen", F64, s), off)
  let tx = load_cell(x)
  store_sub(out, [0], addf(load_ptrs(pa), tx))
  store_sub(out, [1], addf(load_ptrs(pb), tx))
}

# ---- knife TG: the three globals as the HOST sees them ----
#
# One module, three globals, three output segments: `@shown` is public,
# `@hidden` is private and `@frozen` is constant (and public, since the two
# words are independent). The kernel reads all three and adds the input, so
# the buffer comparison says the device read three distinct tables; what the
# buffer cannot say is which of the three the HOST can look up, and that is
# what scripts/tile-gpu-diff's symbol probe asks `cuModuleGetGlobal`.
#
# `global_flags` above holds the same two words for layer 1 and is left
# alone: knife T8's measurements of the Global section's record are written
# against its bytes.
fn global_syms(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [GLOBAL_TILE]
  d_global("shown", F64, global_table_a(GLOBAL_TILE))
  d_global("hidden", F64, global_table_b(GLOBAL_TILE), visibility: Private)
  d_global("frozen", F64, global_syms_c(GLOBAL_TILE), constant: true)
  let blk = tile_at(block_id(0), GLOBAL_TILE)
  let off = lanes(blk, s)
  let ps = ptr_offset(global_ptrs("shown", F64, s), off)
  let ph = ptr_offset(global_ptrs("hidden", F64, s), off)
  let pf = ptr_offset(global_ptrs("frozen", F64, s), off)
  let tx = load_cell(x)
  store_sub(out, [0], addf(load_ptrs(ps), tx))
  store_sub(out, [1], addf(load_ptrs(ph), tx))
  store_sub(out, [2], addf(load_ptrs(pf), tx))
}

# One mutable global, read then written, and the sum written to the output
# as well. Launched twice on one module the output is twice the input,
# because the global carried the first launch's sum into the second; on a
# device that reloaded the module between launches it would be the input
# both times.
fn global_scratch(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [GLOBAL_TILE]
  d_global("scratch", F64, zeros_tile(GLOBAL_TILE))
  let blk = tile_at(block_id(0), GLOBAL_TILE)
  let g = ptr_offset(global_ptrs("scratch", F64, s), lanes(blk, s))
  let prev = load_ptrs(g)
  let next = addf(prev, load(x, blk, s))
  store_ptrs(g, next)
  store(out, blk, next)
}

fn zeros_tile(n: Int) -> List[Float] = list.map(range(0, n), _i => 0.0)

# ---- knife T15: `optimization_hints` (attribute tags 11 and 10) ----
#
# Both kernels are `vadd`'s body, and that is the point: a hint is a
# suggestion the dialect promises not to compute with, so the only corpus
# that can say anything about one is a corpus whose answer is already
# known. What changes is the BYTES -- an entry flag bit and an attribute in
# the function table for the first, two flag bits and two nested
# dictionaries in the body for the second.
#
# The values are the dialect's own legal ones for this machine
# (AttrDefs.td and `OptimizationHintsAttr`'s validators): `num_cta_in_cga`
# must be 1 on sm_80 through sm_89, `num_worker_warps_per_cta` is 4 or 8,
# `occupancy` is 1 to 32 and `latency` is 1 to 10. Nothing enforces any of
# that here: the validators live behind `-Wunsupported-hints`, which is off
# by default, so these numbers are chosen to be right rather than checked
# to be (docs/tile-backend-design.md 6.10).

# `vadd` with hints on the ENTRY: one architecture-specific entry for this
# machine's sm_86 and one `default`, the fallback the dialect reads when the
# compilation target has no entry of its own.
fn hint_entry_hints() -> Hints = [
  for_arch("default", [hint_occupancy(4)]),
  for_arch("sm_86", [hint_num_cta_in_cga(1), hint_num_worker_warps_per_cta(8), hint_occupancy(2)])]

fn hint_entry(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev =
  store_cell(out, addf(load_cell(a), load_cell(b)))

# `vadd` with hints on a LOAD and on the STORE. The second load carries
# none, so one kernel holds both states of the flag bit: `latency` is the
# one key `load_ptr_tko` and `store_ptr_tko` accept.
fn hint_memory(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let blk = tile_at(block_id(0), 128)
  let ta = load(a, blk, [128], hints: [for_arch("sm_86", [hint_latency(4)])])
  let tb = load(b, blk, [128])
  store(out, blk, addf(ta, tb), hints: [for_arch("sm_86", [hint_latency(7)])])
}

# ---- knife T10: `alloca` (0x71) ----
#
# Automatic allocation: scratch that belongs to the block the operation is
# in and to nothing else. Every other pointer in this file comes from a
# parameter the host uploaded (`ptrs`) or from a global the module declared
# (`get_global`); this is the third source and the only one no host can
# see, so the corpus has to make the memory ANSWER rather than show it.
#
# ALLOCA_ELEMS is 192 and not 128 on purpose, and the reason is written
# here because a reader would otherwise trim it. The kernels write 128
# elements, so any count at or above that is enough memory; 192 is not a
# POWER OF TWO, and `alloca`'s verifier requires the alignment to be one.
# That is what makes the mutant which writes the count where the alignment
# belongs a refusal with a name (`'alignment' must be power of two`) rather
# than a legal program that quietly allocates eight elements and runs off
# the end of them. Undefined behaviour is not a judgement (ruling 1).
const ALLOCA_TILE: Int = 128
const ALLOCA_ELEMS: Int = 192
const ALLOCA_ALIGN: Int = 8

# Write a tile into a fresh allocation and read it back in the same launch.
# The token chain is what orders the two, and the answer is `3 * x`: the
# scratch holds `2 * x` and the kernel adds the input to what it reads
# back. A scratch that answered zeros, or an address the store never
# reached, would answer `x`.
fn alloca_scratch(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [ALLOCA_TILE]
  let blk = tile_at(block_id(0), ALLOCA_TILE)
  let off = lanes(idx_const(0), s)
  let p = ptr_offset(alloca_ptrs(F64, ALLOCA_ELEMS, ALLOCA_ALIGN, s), off)
  let tx = load(x, blk, s)
  store_ptrs(p, addf(tx, tx))
  store(out, blk, addf(load_ptrs(p), tx))
}

# Two allocations in one block, written apart and read crosswise: the
# answer `x - (-x - 1)` is `2 * x + 1`, and two allocations at the SAME
# address would answer 0 for every lane, because the second store would
# have overwritten the first. The corpus keeps every lane away from -0.5,
# which is the one input where `2 * x + 1` is 0 anyway.
#
# The second allocation carries the dialect's `global` unit attribute and
# the first does not, so one kernel holds both states of the flag bit, the
# way hint_memory holds both states of a load's hint bit.
fn alloca_two(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let s = [ALLOCA_TILE]
  let blk = tile_at(block_id(0), ALLOCA_TILE)
  let off = lanes(idx_const(0), s)
  let pa = ptr_offset(alloca_ptrs(F64, ALLOCA_ELEMS, ALLOCA_ALIGN, s), off)
  let pb = ptr_offset(alloca_ptrs(F64, ALLOCA_ELEMS, ALLOCA_ALIGN, s, shared: true), off)
  let tx = load(x, blk, s)
  store_ptrs(pa, tx)
  store_ptrs(pb, sub(neg(tx), f_const(F64, 1.0)))
  store(out, blk, sub(load_ptrs(pa), load_ptrs(pb)))
}

# alloca_scratch's answer with no allocation in it: the control that tells
# "the mutant broke alloca" from "the mutant broke the tree".
fn alloca_ctl(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let tx = load_cell(x)
  store_cell(out, addf(addf(tx, tx), tx))
}

# ---- knife T10: `mmaf_scaled` (0x72) ----
#
# The block-scaled MMA. It reaches LAYER 1 AND NO FURTHER on this machine,
# and the reason is the operation's own type table rather than anything
# missing here: Ops.td confines its two matrix operands to `f8E4M3FN`,
# `f8E5M2` and `f4E2M1FN`, and `tileiras` 13.3.36 refuses all three fp8
# formats below sm_100 (measured by knife T3, and again by writing this
# kernel out for sm_86). There is NO wide-operand form to fall back on:
# unlike `mmaf`, which takes everything down to f64, this operation exists
# only for the formats that carry a separate exponent per run of K. So the
# kernel is assembled for sm_100 like the three dtype_* fp8 kernels
# (run.sh's kernel_arch) and this machine's RTX 3080 never sees it.
#
# The scale shapes are what `block` means: one f8E8M0FNU element scales a
# run of MMS_V elements along K, so the left scale is [M, K/V] and the
# right one is [K/V, N]. The accumulator and the result are f32 whatever
# the operands are, which is the whole of MmaFScaledOp_ResultTileType.
const MMS_M: Int = 32
const MMS_K: Int = 64
const MMS_N: Int = 32
const MMS_V: Int = 32

fn mmaf_scaled_e4m3(a: Param[F8E4M3FN], b: Param[F8E4M3FN], sa: Param[F8E8M0FNU],
  sb: Param[F8E8M0FNU], out: Param[F64]) -> Unit !Dev = {
  let r = mmaf_scaled(load_cell(a), load_cell(b), f_const(F32, 0.0), load_cell(sa), load_cell(sb))
  store_cell(out, float_to_float(r, F64))
}

# ---- knife T11: the view family ----
#
# A second way to address memory, and the first that is not a tile of
# pointers. `make_tensor_view` says where a tensor is and how it is laid
# out; `make_partition_view` cuts that tensor into a grid of equally sized
# tiles; `load_view_tko` and `store_view_tko` move one tile of the grid by
# its GRID index. The address ladder every kernel above builds
# (`iota`, `muli`, `addi`, `offset`) is gone: what is left is one index a
# tile dimension, which is what the block ids already are.
#
# The three below are the strided kernels of knife 9 written this way, and
# they are chosen so that the addressing is the whole of what changed:
# each shares its host reference with the pointer-ladder version
# scripts/tile-gpu-diff/stride_diff.dawn runs, and the judgement is that
# the two answer the same bits.
#
#   view_transpose  transpose_tail. One load and one store, and the
#                   transpose is the OUT view's strides `[1, rows]`: no
#                   element moves inside the tile and no shape operation
#                   is issued, exactly as in the ladder version
#   view_max_pool   max_pool. Four taps, each its own tensor view over a
#                   base one element on, all with the window's strides
#                   `[k * width, k]`. Its padding is `neg_inf`, which is
#                   the accumulator's identity, so the mask and the pad
#                   tile of the ladder version are BOTH gone
#   view_conv2d     conv2d. Nine taps the same way, padding `zero`. Its
#                   WEIGHT is still read through the ladder, and that is
#                   not laziness: a weight read is a broadcast, its stride
#                   is zero along both axes, and TensorViewType's verifier
#                   requires every stride to be strictly positive. A
#                   broadcast has no view spelling at all
#                   (docs/tile-backend-design.md 6.14)
#
# and the two below are about the `padding_value` enum rather than about a
# problem:
#
#   view_padding    the five padding values over ONE tensor view whose
#                   extent is not a multiple of the tile, so the last tile
#                   of every launch runs past the end. Five partition
#                   views, five outputs, and the store is into a view that
#                   is a whole number of tiles wide, so the padded lanes
#                   are WRITTEN OUT rather than masked away. Its element
#                   format is f32 and its BUFFERS are i32: what the host
#                   reads back is the bit pattern each padding value put on
#                   the device, which is the only way to see that `nan` is
#                   a particular NaN and `neg_zero` is not `zero`
#   view_pad_i32    the same shape over i32, padded with `zero`. Two jobs:
#                   an integer element format under a view at all, and the
#                   control for the layer-1 mutant
#                   padding-nan-on-integer-elements, which is the one
#                   verifier rule the enum carries (the four special values
#                   are floating point only)

const VT_ROWS: Int = 100
const VT_COLS: Int = 60
const VT_TILE: Int = 32

fn view_transpose(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let tile = [VT_TILE, VT_TILE]
  let dm = [0, 1]
  let zero = idx_const(0)
  let src = partition_view(tensor_view(x, zero, [VT_ROWS, VT_COLS], [VT_COLS, 1]), tile, dm, PadZero)
  # the OUT view is the same tensor with its strides permuted, which is the
  # whole of the transpose: element (i, j) of the tile lands at
  # `i * 1 + j * rows`, so the answer is read row-major and written
  # column-major.
  let dst = partition_view(tensor_view(out, zero, [VT_ROWS, VT_COLS], [1, VT_ROWS]), tile, dm, NoPadding)
  let at = [block_id(0), block_id(1)]
  store_view(dst, at, load_view(src, at))
}

const VM_H: Int = 36
const VM_W: Int = 20
const VM_K: Int = 2
const VM_TILE: Int = 16

fn vm_oh() -> Int = VM_H / VM_K

fn vm_ow() -> Int = VM_W / VM_K

fn view_max_pool(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let tile = [VM_TILE, VM_TILE]
  let dm = [0, 1]
  let shape = [vm_oh(), vm_ow()]
  let window = [VM_K * VM_W, VM_K]
  let at = [block_id(0), block_id(1)]
  var acc = f_const(F64, neg_inf())
  for p in range(0, VM_K) {
    for q in range(0, VM_K) {
      let v = partition_view(tensor_view(x, idx_const(p * VM_W + q), shape, window), tile, dm, PadNegInf)
      acc = maxf(acc, load_view(v, at))
    }
  }
  store_cell(out, acc)
}

const VC_H: Int = 40
const VC_W: Int = 36
const VC_K: Int = 3
const VC_TILE: Int = 16

fn vc_oh() -> Int = VC_H - VC_K + 1

fn vc_ow() -> Int = VC_W - VC_K + 1

fn view_conv2d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let tile = [VC_TILE, VC_TILE]
  let dm = [0, 1]
  let shape = [vc_oh(), vc_ow()]
  let at = [block_id(0), block_id(1)]
  var acc = f_const(F64, 0.0)
  for p in range(0, VC_K) {
    for q in range(0, VC_K) {
      let v = partition_view(tensor_view(x, idx_const(p * VC_W + q), shape, [VC_W, 1]), tile, dm, PadZero)
      # the tap's weight, and the one read here that is NOT a view: every
      # lane wants the same `w[p * k + q]`, which is a stride of zero along
      # both axes, and a tensor view's strides are strictly positive
      let wt = load(w, idx_const(p * VC_K + q), tile, strides: Some([0, 0]))
      acc = addf(acc, mul(load_view(v, at), wt))
    }
  }
  store_cell(out, acc)
}

# The padded extent (100) is not a multiple of the tile (32), so the last
# of the four tiles reads 28 lanes past the end of the tensor; the output
# view is 128 elements, a whole number of tiles, so nothing is masked on
# the way out and those 28 lanes are what the host reads back.
const VP_N: Int = 100
const VP_TILE: Int = 32
const VP_OUT: Int = 128

fn view_padding(x: Param[F32], o0: Param[F32], o1: Param[F32], o2: Param[F32], o3: Param[F32],
  o4: Param[F32]) -> Unit !Dev = {
  let tile = [VP_TILE]
  let dm = [0]
  let zero = idx_const(0)
  let at = [block_id(0)]
  let tv = tensor_view(x, zero, [VP_N], [1])
  let outs = [o0, o1, o2, o3, o4]
  let pads = [PadZero, PadNegZero, PadNan, PadPosInf, PadNegInf]
  for k in range(0, 5) {
    let src = partition_view(tv, tile, dm, pads[k])
    let dst = partition_view(tensor_view(outs[k], zero, [VP_OUT], [1]), tile, dm, NoPadding)
    store_view(dst, at, load_view(src, at))
  }
}

fn view_pad_i32(x: Param[I32], out: Param[I32]) -> Unit !Dev = {
  let tile = [VP_TILE]
  let dm = [0]
  let zero = idx_const(0)
  let at = [block_id(0)]
  let src = partition_view(tensor_view(x, zero, [VP_N], [1]), tile, dm, PadZero)
  store_cell(out, load_view(src, at))
}

# ---- knife T12: dynamic dimensions and the two shape queries ----
#
# The view family's other half. A `tensor_view`'s extent along a dimension
# need not be in the type: the dialect prints `?` there and
# `make_tensor_view` carries the value in an OPERAND, so one cubin serves
# every tensor of that rank rather than one shape. The two shape queries
# are the kernel's way of reading those numbers back:
# `get_tensor_shape` answers the tensor's own extents, and
# `get_index_space_shape` answers the extents of the GRID of tiles a
# partition view cuts it into, which for a dynamic tensor is a number no
# host can compute from the type.
#
# All three read their dimensions out of an i32 parameter buffer rather
# than from a constant, which is the whole point: a constant would be a
# static extent spelled the long way, and the host would not be able to
# launch the SAME cubin over two different tensors.
#
#   view_dyn_transpose  view_transpose written with every extent and every
#                       stride dynamic. Same shapes, same corpus, same host
#                       reference (`transpose_ref`), so the judgement is
#                       that the static and the dynamic spelling of one
#                       operator answer the same bits
#   view_tensor_shape   `get_tensor_shape` decides a MASK bound: the tile
#                       is read and written masked by `lane < n`, where `n`
#                       is what the device answered, and `n` is also
#                       written out so the host reads the operation's
#                       answer directly
#   view_index_space    `get_index_space_shape` decides two LOOP bounds:
#                       ONE block walks the whole grid of tiles, whatever
#                       the runtime shape is, and sums them. Its two
#                       extents are written out too
#
# The dimension buffer is [rows, cols, 1] in every one of them. The third
# entry is a one that the kernel does not spell as a constant, so the
# INNERMOST stride is dynamic as well; without it a kernel would have one
# dynamic stride and one static, the two operand groups would be different
# lengths, and the mutant that reverses a group could not be told from the
# mutant that miscounts one.

const VD_ROWS: Int = 100
const VD_COLS: Int = 60
const VD_TILE: Int = 32
const VD_N: Int = 100
const VD_LANES: Int = 32
const VD_SUM_TILE: Int = 16
const VD_SUM_H: Int = 36
const VD_SUM_W: Int = 20

fn dyn_dims(dims: Param[I32]) -> (Idx, Idx, Idx) !Dev = {
  let rows = idx_of(load(dims, idx_const(0), []))
  let cols = idx_of(load(dims, idx_const(1), []))
  let unit = idx_of(load(dims, idx_const(2), []))
  (rows, cols, unit)
}

fn view_dyn_transpose(dims: Param[I32], x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let tile = [VD_TILE, VD_TILE]
  let dm = [0, 1]
  let zero = idx_const(0)
  let (rows, cols, unit) = dyn_dims(dims)
  let src = partition_view(tensor_view_dyn(x, zero, [Dyn(rows), Dyn(cols)], [Dyn(cols), Dyn(unit)]), tile, dm, PadZero)
  # the out view is the same tensor with its two strides exchanged, which
  # is the whole of the transpose, exactly as in view_transpose. Here both
  # of them are operands.
  let dst = partition_view(tensor_view_dyn(out, zero, [Dyn(rows), Dyn(cols)], [Dyn(unit), Dyn(rows)]), tile, dm, NoPadding)
  let at = [block_id(0), block_id(1)]
  store_view(dst, at, load_view(src, at))
}

fn view_tensor_shape(dims: Param[I32], x: Param[F64], out: Param[F64],
  shape_out: Param[I32]) -> Unit !Dev = {
  let lane = [VD_LANES]
  let zero = idx_const(0)
  let one = idx_const(1)
  let (rows, cols, unit) = dyn_dims(dims)
  let tv = tensor_view_dyn(x, zero, [Dyn(rows), Dyn(cols)], [Dyn(cols), Dyn(unit)])
  # the queries, and the only place this kernel learns how far the tensor
  # goes. It is asked for BOTH extents so that a query answering the wrong
  # dimension is a different program and not the same one.
  let r = tensor_dim(tv, 0)
  let c = tensor_dim(tv, 1)
  # the bytes move through the pointer ladder, not through the view: what
  # the view is here for is to be asked. The mask bound is the SECOND
  # extent, so one row of the tensor is doubled and everything past it
  # keeps whatever the host put there.
  let base = tile_at(block_id(0), VD_LANES)
  let live = lt_i(lanes(base, lane), broadcast(idx_as_tile(c), lane))
  let v = load(x, base, lane, mask: Some(live), pad: Some(f_const(F64, 0.0)))
  store(out, base, addf(v, v), mask: Some(live))
  # and the answers themselves, so the host reads what the device said
  # rather than only what the mask did with it
  store(shape_out, zero, broadcast(idx_as_tile(r), [1]))
  store(shape_out, one, broadcast(idx_as_tile(c), [1]))
}

fn view_index_space(dims: Param[I32], x: Param[F64], out: Param[F64],
  shape_out: Param[I32]) -> Unit !Dev = {
  let tile = [VD_SUM_TILE, VD_SUM_TILE]
  let zero = idx_const(0)
  let one = idx_const(1)
  let (rows, cols, unit) = dyn_dims(dims)
  let pv = partition_view(tensor_view_dyn(x, zero, [Dyn(rows), Dyn(cols)], [Dyn(cols), Dyn(unit)]), tile, [0, 1], PadZero)
  # the grid of tiles, as the device counts it. This launch is ONE block:
  # the loop bounds are the query's answers, so the same cubin walks a
  # tensor of any shape without the host telling it how many tiles there
  # are.
  let gi = index_space_dim(pv, 0)
  let gj = index_space_dim(pv, 1)
  let acc = d_for(zero, gi, one, zeros(out), (i, outer) =>
      d_for(zero, gj, one, outer, (j, inner) => addf(inner, load_view(pv, [i, j]))))
  store_cell(out, acc)
  store_sub(shape_out, [0], broadcast(idx_as_tile(gi), [1]))
  store_sub(shape_out, [1], broadcast(idx_as_tile(gj), [1]))
}

# ---- knife T13: the rest of the view family ----
#
# Knife T11 built the grid view (a tensor cut into equal tiles, indexed by
# tile) and knife T12 the dynamic half of it. What is left of the family is
# the two views that are NOT a plain grid and the reduction that writes into
# one:
#
#   view_conv1d      a STRIDED view whose traversal is ONE: the tiles
#                    overlap, so index i is the window `x[i .. i + K)` and
#                    the convolution is a dot product per index rather than
#                    K taps at K bases. It shares `conv1d_ref` with the
#                    pointer-ladder `conv1d`, on a corpus of its own (see
#                    below)
#   view_token_embed a GATHER/SCATTER view: its index at `sparse_dim` is a
#                    1D tile of ROW NUMBERS the kernel read out of a buffer,
#                    so one load collects eight rows chosen while it runs.
#                    It shares `token_embed_ref` with the pointer-ladder
#                    `token_embed`
#   view_atomic      `atomic_red_view_tko` in all NINE of its modes: eight
#                    tile blocks reduce their own histogram into ONE tile of
#                    a grid view, and the answer does not depend on the
#                    order they arrive in. Its `add` output is exactly
#                    `histogram_ref`'s
#   view_stride_pad  a strided view whose traversal is LONGER than its tile,
#                    so the grid skips, and whose last tile runs off the end
#                    of the tensor, so its `padding_value` is visible
#   view_gather_pad  the same for a gather view, padded on the COLUMN side:
#                    its tile is wider than the tensor's rows
#
# The last two are the first evidence of the UNIFIED OPTIONAL-PARAMETER
# BITFIELD as a rule rather than as a version branch. A partition view
# writes the bitfield only because this writer targets 13.3; these two types
# entered AT 13.3 and have no other spelling, so the varint is
# unconditional. Both run f32 elements over i32 BUFFERS, as `view_padding`
# does, because what the host has to read back is the bit pattern the
# padding left and not a number a comparison could round.
#
# `view_conv1d`'s corpus is not `conv1d`'s, and that is deliberate: the
# ladder version folds its taps in the reference's own order, and this one
# issues a `reduce` whose order the dialect does not specify. Eighths make
# every partial sum exact, so the two orders answer the same bits; tenths
# would not.

const VS_N: Int = 260
const VS_K: Int = 4

fn vs_out() -> Int = VS_N - VS_K + 1

fn view_conv1d(x: Param[F64], w: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let tile = [VS_K]
  let zero = idx_const(0)
  # the sliding window: traversal ONE against a tile of four, so index i
  # covers `x[i .. i + 4)` and the windows overlap three ways. A partition
  # view cannot say this at all.
  let src = strided_view(tensor_view(x, zero, [VS_N], [1]), tile, [1], [0], NoPadding)
  # the weights, as a strided view whose traversal IS its tile: the
  # dialect's own first example says that is a partition view, and it is
  # here so that the two spellings sit side by side in one kernel
  let wv = strided_view(tensor_view(w, zero, [VS_K], [1]), tile, [VS_K], [0], NoPadding)
  store_cell(out, reduce_sum(mul(load_view(src, [block_id(0)]), load_view(wv, [zero]))))
}

const VG_ROWS: Int = 64
const VG_DIM: Int = 16
const VG_TILE: Int = 8
const VG_N: Int = 104

fn view_token_embed(ids: Param[I32], table: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let zero = idx_const(0)
  # the row numbers this block collects: an ordinary cell of i32, which
  # becomes the gather view's index at `sparse_dim`; every other index is a
  # tile index as it is on any view.
  let src = gather_scatter_view(tensor_view(table, zero, [VG_ROWS, VG_DIM], [VG_DIM, 1]), [VG_TILE, VG_DIM], 0, NoPadding)
  store_cell(out, load_gather(src, [Rows(load_cell(ids)), At(zero)]))
}

const VA_BINS: Int = 16
const VA_TILE: Int = 64
const VA_N: Int = 500
const VA_BIAS: Int = 3

fn va_blocks() -> Int = VA_N / VA_TILE + 1

# This block's own histogram, as a tile of VA_BINS counts. The values are
# read as a RECTANGLE: stride zero along the bin axis repeats one row of
# memory down every bin, `coord` names the bin each row stands for, and the
# reduction along the lane axis counts the matches. The lanes past the end
# of the input are masked and padded with a value no bin is.
fn va_local(x: Param[I32], b: Idx) -> Tile[I32] !Dev = {
  let s2 = [VA_BINS, VA_TILE]
  let blk = tile_at(b, VA_TILE)
  let live = axis_mask(blk, s2, 1, VA_N)
  let vals = load(x, blk, s2, strides: Some(axis_strides(2, 1, 1)), mask: Some(live), pad: Some(i_const(0 - 1)))
  let hit = mask_to_int(eq_i(vals, coord(idx_const(0), s2, 0, 1)))
  d_reduce(hit, 0.0, (acc, e) => add_i(acc, e), dim: 1)
}

fn va_reduce(p: Param[I32], mode: String, t: Tile[I32]) -> Unit !Dev = {
  let bins = [VA_BINS]
  let zero = idx_const(0)
  let v = partition_view(tensor_view(p, zero, bins, [1]), bins, [0], NoPadding)
  atomic_red_view(v, [zero], mode, "device", t)
}

fn view_atomic(x: Param[I32], o_add: Param[I32], o_addf: Param[F64], o_and: Param[I32],
  o_or: Param[I32], o_xor: Param[I32], o_max: Param[I32], o_min: Param[I32],
  o_umax: Param[I32], o_umin: Param[I32]) -> Unit !Dev = {
  let bins = [VA_BINS]
  let zero = idx_const(0)
  let local = va_local(x, block_id(0))
  # the biased counts, which is what the eight integer modes fold. The bias
  # is what puts NEGATIVE numbers in: without it `umax` and `umin` would
  # answer what `max` and `min` do and four of the nine modes would be four
  # spellings of two.
  let biased = sub_i(local, i_const(VA_BIAS))
  va_reduce(o_add, "add", local)
  va_reduce(o_and, "and", biased)
  va_reduce(o_or, "or", biased)
  va_reduce(o_xor, "xor", biased)
  va_reduce(o_max, "max", biased)
  va_reduce(o_min, "min", biased)
  va_reduce(o_umax, "umax", biased)
  va_reduce(o_umin, "umin", biased)
  # the float mode, and the one reduction here that writes into a STRIDED
  # view rather than a partition one: `atomic_red_view_tko` takes either,
  # and refuses only a gather/scatter view
  let fv = strided_view(tensor_view(o_addf, zero, bins, [1]), bins, [VA_BINS], [0], NoPadding)
  atomic_red_view(fv, [zero], "addf", "device", int_to_float(local, F64))
}

# `view_atomic`'s float mode over BF16 (knife TA), and the one kernel in
# this file whose reason for existing is an ARCHITECTURE and not an
# operation. It is `view_atomic`'s last reduction and nothing else: the same
# local histogram, the same strided view, the same `addf`, with the view's
# element format changed.
#
# Ops.td's prose is the whole subject: "bf16 is supported from Hopper (sm90)
# onward. On earlier architectures (e.g. Ampere/sm80), atomicRMW ADDF with
# bf16 is not supported." It is the only sentence in the view family that
# names an architecture, it lives in prose rather than in a verifier, and
# knife T13 measured it instead of quoting it -- sm_80, sm_86 and sm_87
# refuse, sm_89, sm_90 and sm_100 accept, so the prose is one generation
# out. What T13 could not do is ask a device, because this repository's card
# is sm_86. Knife TA does: this kernel goes into scripts/tile-gpu-diff's
# arch family, is assembled for sm_89 (the floor, measured) and runs on the
# cluster's two cards.
#
# THE COUNTS STAY WHOLE NUMBERS UNDER 256, which is what keeps the answer
# free of the fold order. Eight tile blocks reduce into sixteen bins with
# nothing ordering them, and bf16 carries eight significand bits: whole
# numbers up to 256 are exact in it and their sums are associative, so the
# bins can be added in any order and the answer is the same. VA_N is 500
# over VA_BINS 16, so no bin comes near it.
fn view_atomic_bf16(x: Param[I32], o_addf: Param[BF16]) -> Unit !Dev = {
  let bins = [VA_BINS]
  let zero = idx_const(0)
  let local = va_local(x, block_id(0))
  let fv = strided_view(tensor_view(o_addf, zero, bins, [1]), bins, [VA_BINS], [0], NoPadding)
  atomic_red_view(fv, [zero], "addf", "device", int_to_float(local, BF16))
}

const VE_N: Int = 90
const VE_TILE: Int = 4
const VE_TRAV: Int = 8

fn ve_grid() -> Int = (VE_N + VE_TRAV - 1) / VE_TRAV

fn ve_out() -> Int = ve_grid() * VE_TILE

fn view_stride_pad(x: Param[F32], out: Param[F32]) -> Unit !Dev = {
  # traversal EIGHT against a tile of four: the grid skips half the tensor,
  # and its last index covers elements 88 to 91 of a tensor 90 long, so two
  # lanes read the padding value. The index space rounds up, which is what
  # puts that last tile in it at all.
  let src = strided_view(tensor_view(x, idx_const(0), [VE_N], [1]), [VE_TILE], [VE_TRAV], [0], PadNan)
  store_cell(out, load_view(src, [block_id(0)]))
}

const VF_ROWS: Int = 16
const VF_COLS: Int = 6
const VF_TILE: Int = 4
const VF_GCOLS: Int = 8

fn vf_grid() -> Int = VF_ROWS / VF_TILE

fn view_gather_pad(ids: Param[I32], x: Param[F32], out: Param[F32]) -> Unit !Dev = {
  let zero = idx_const(0)
  # the tile is EIGHT columns wide over a tensor six columns wide, so two
  # columns of every gathered row are outside the tensor and read
  # `pos_inf`. The rows themselves are all inside it: a row number the
  # tensor does not have is a different question, and not one this kernel
  # asks.
  let src = gather_scatter_view(tensor_view(x, zero, [VF_ROWS, VF_COLS], [VF_COLS, 1]), [VF_TILE, VF_GCOLS], 0, PadPosInf)
  store_cell(out, load_gather(src, [Rows(load_cell(ids)), At(zero)]))
}

# ---- knife T16: `insert` (0x76) and `fpowi` (0x79), bytecode 13.4 ----

# `insert` beside the `extract` it inverts, over one block of 128 f64 read
# as a 16 by 8 tile, the shape `shape_ops` reads: the 8 by 4 quarter at
# slice [1, 0] is extracted and put back twice. Into slice [1, 0] -- the
# place it came from -- the answer is the tile itself, which is the
# round trip. Into slice [0, 1] it is a different tile: the quarter there is
# replaced and every other lane is the destination's own, which is what says
# the operation is not "answer the destination" (a round trip alone could
# not tell an `insert` that did nothing from one that did it right).
#
# Both dimensions have TWO slices, for `extract`'s reason in `shape_ops`:
# [1, 0] and [0, 1] are then two different quarters that are both in
# bounds, so the mutant that writes the indices in the opposite order is a
# wrong answer rather than an undefined one, and it moves BOTH halves.
fn insert_tile(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let t = load(x, tile_at(block_id(0), 128), [16, 8])
  let q = extract(t, [8, 4], [idx_const(1), idx_const(0)])
  store_sub(out, [0, 0], insert(q, t, [idx_const(1), idx_const(0)]))
  store_sub(out, [1, 0], insert(q, t, [idx_const(0), idx_const(1)]))
}

# `fpowi` over one block of 128 lanes: an f64 base and an i32 exponent from
# two buffers, raised twice. The first half of the block's answer takes the
# exponent as it is; the second takes its low OCTET (`trunci` to i8), which
# the dialect reads as SIGNED: every exponent in the corpus fits in an i8, so
# the two halves agree exactly when that reading holds, and a negative
# exponent read as unsigned would be 256 more than it is.
fn powi_sweep(x: Param[F64], n: Param[I32], out: Param[F64]) -> Unit !Dev = {
  let tx = load_cell(x)
  let tn = load_cell(n)
  store_sub(out, [0], powi(tx, tn))
  store_sub(out, [1], powi(tx, trunc_u8(tn)))
}

# ---- the markers ----
#
# Since the batch's PR-3 every kernel is recorded through `trace1` to
# `trace5` with a marker for each parameter: what it is cut into (`In` and
# `Out`), or that it is written in a way no cell describes (`Shared`, the
# escape hatch: atomics, scatters, two regions a block, a pointer write).
# `trace_kernel` is left for the kernels with more than five parameters.
# The helpers below name the cuts the families share, so a dispatch arm
# reads as "this kernel's cells" and not as a list of numbers.

## A tensor of `shape` that is one cell: a kernel of one block.
fn one_cell(shape: List[Int]) -> Cells = cells(shape, shape)

## A run of `tile`-wide cells as long as the grid makes it, for a kernel the
## harnesses launch over more than one length.
fn run_of(tile: Int) -> Cells = cells([DYN_DIM], [tile])

## An attribute kernel's output when its segment count `segs` is not a
## power of two: block-major, one cell of `rows` (`segs` rounded up to a
## power of two) by ATTR_TILE per block, the rows past `segs` outside the
## extent. A segment is the piece `[0, j, 0]`.
fn attr_segs(segs: Int, rows: Int) -> Cells = cells([DYN_DIM, segs, ATTR_TILE], [1, rows, ATTR_TILE])

## A segmented output: `segs` segments of `n`, read as `segs` rows of `n`.
## One cell per block holds that block's `tile` lanes of every segment, its
## first dimension `rows` (`segs` rounded up to a power of two, the rows past
## `segs` outside the extent and never written), and a segment is the piece
## `[j, 0]`. The columns follow grid axis 0, where the blocks are, and the
## rows axis 1, which has one block.
fn seg_out(segs: Int, rows: Int, n: Int, tile: Int) -> Cells = cells([segs, n], [rows, tile], along: [1, 0])

## `n` elements in `tile`-wide cells, the last one short: the boundary
## kernels' tail.
fn tail_of(n: Int, tile: Int) -> Cells = cells([n], [tile])

## The one-block reductions' input: RED_N values in one cell of RED_TILE, the
## lanes past the end reading `pad`.
fn red_in(pad: Padding) -> Cells = cells([RED_N], [RED_TILE], pad: pad)

## A single answer: one cell of one element, so the rest of the output
## buffer keeps what the host put there.
fn one_out() -> Cells = cells([1], [1])

## A vector every block reads whole (a scale, a bias): one cell that follows
## no grid axis, read with `load_at(p, [idx_const(0)])`.
fn vec(n: Int) -> Cells = cells([n], [n], along: [FREE_AXIS])

## `vec` for a tensor of any rank.
fn fixed(shape: List[Int]) -> Cells = cells(shape, shape, along: list.map(shape, _d => FREE_AXIS))

## A head-major Llama projection, one LM_S by LM_HD head a block on grid
## axis 1, as many heads as the grid has blocks there.
fn llama_heads() -> Cells = cells([DYN_DIM, LM_HD], [LM_S, LM_HD], along: [1, 0])

## The score kernels of the attention family: queries by row block along
## grid axis 0, keys by row block along axis 1, each read as its one cell
## along the head dimension, and the scores' ATT_T by ATT_T block.
fn att_qk(name: String, body: fn(Param[F64], Param[F64], Param[F64]) -> Unit !Dev) -> TileProg = {
  let (p, _e) = trace3(name, In(F64, cells([ATT_M, ATT_D], [ATT_T, ATT_D], along: [0, FREE_AXIS])),
    In(F64, cells([ATT_N, ATT_D], [ATT_T, ATT_D], along: [1, FREE_AXIS])),
    Out(F64, cells([ATT_M, ATT_N], [ATT_T, ATT_T])), body)
  p
}

## FlashAttention's keys and values: FA_BK rows a cell, picked by the loop.
fn fa_kv() -> Cells = cells([ATT_N, ATT_D], [FA_BK, ATT_D], along: [FREE_AXIS, 1])

## LoRA's activations: every row, LORA_T columns a cell picked by the loop.
fn lora_x() -> Cells = cells([LORA_M, LORA_DIN], [LORA_M, LORA_T], along: [0, FREE_AXIS])

## The SwiGLU activation's run over the whole M by DFFN block.
fn sw_act() -> Cells = cells([SW_M * SW_DFFN], [SW_ACT_TILE])

## GRPO's per-token rows, GR_S a block.
fn gr_run() -> Cells = cells([GR_B * GR_G * GR_S], [GR_S])

## The int8 KV cache: one head's KV_S by KV_D block a cell.
fn kv_cache() -> Cells = cells([KV_H * KV_S, KV_D], [KV_S, KV_D])

## The four GPT-2 products: `a[GP_S, k] w[k, n] + bias`, GP_T columns a
## block, the bias read by the pointer path (a stride of zero is no cell).
fn gpt_mm(name: String, k: Int, n: Int,
  body: fn(Param[F64], Param[F64], Param[F64], Param[F64]) -> Unit !Dev) -> TileProg = {
  let (p, _e) = trace4(name, In(F64, cells([GP_S, k], [GP_S, GP_T], along: [0, FREE_AXIS])),
    In(F64, cells([k, n], [GP_T, GP_T], along: [FREE_AXIS, 1])), In(F64, Whole),
    Out(F64, cells([GP_S, n], [GP_S, GP_T])), body)
  p
}

## Group normalisation's (sample, group) cell of the (GN_N, GN_C, GN_HW)
## tensor, and the matching [1, per, 1] cell of the (1, GN_C, 1) view of a
## per-channel scale.
fn gn_cells() -> Cells = cells([GN_N, GN_C, GN_HW], [1, gn_per_group(), GN_HW])

fn gn_scale() -> Cells = cells([1, GN_C, 1], [1, gn_per_group(), 1], along: [FREE_AXIS, 1, FREE_AXIS])

## The rotary embedding's halves: a row block's first or second ROPE_HALF
## columns, picked by `load_at`.
fn rope_half() -> Cells = cells([ROPE_M, ROPE_D], [ROPE_ROWS, ROPE_HALF], along: [0, FREE_AXIS])

## The dtype kernels' inputs, DT_TILE lanes a block.
fn dt_cells() -> Cells = cells([DT_N], [DT_TILE])

fn dt_out(segs: Int, rows: Int) -> Cells = seg_out(segs, rows, DT_N, DT_TILE)

fn trace(name: String) -> TileProg = match name {
  "vadd" -> {
    let (p, _e) = trace3("vadd", In(F64, run_of(128)), In(F64, run_of(128)), Out(F64, run_of(128)), vadd)
    p
  }
  "vadd_f32" -> {
    let (p, _e) = trace3("vadd_f32", In(F32, run_of(64)), In(F32, run_of(64)), Out(F32, run_of(64)), vadd_f32)
    p
  }
  "vadd_bf16" -> {
    let (p, _e) = trace3("vadd_bf16",
      In(BF16, run_of(128)), In(BF16, run_of(128)), Out(BF16, run_of(128)), vadd_bf16)
    p
  }
  "sum" -> {
    let (p, _e) = trace2("sum",
      In(F64, cells([1024], [128], along: [FREE_AXIS])), Out(F64, run_of(128)), (x, o) => sum(x, o, 4))
    p
  }
  "vadd_tail" -> {
    let (p, _e) = trace3("vadd_tail",
      In(F64, tail_of(TAIL_N, TAIL_TILE)), In(F64, tail_of(TAIL_N, TAIL_TILE)),
      Out(F64, tail_of(TAIL_N, TAIL_TILE)), vadd_tail)
    p
  }
  "copy" -> {
    let (p, _e) = trace2("copy",
      In(F64, tail_of(TAIL_N, TAIL_TILE)), Out(F64, tail_of(TAIL_N, TAIL_TILE)), copy)
    p
  }
  "relu" -> {
    let (p, _e) = trace2("relu",
      In(F64, tail_of(TAIL_N, TAIL_TILE)), Out(F64, tail_of(TAIL_N, TAIL_TILE)), relu)
    p
  }
  "leaky_relu" -> {
    let (p, _e) = trace2("leaky_relu",
      In(F64, tail_of(TAIL_N, TAIL_TILE)), Out(F64, tail_of(TAIL_N, TAIL_TILE)), leaky_relu)
    p
  }
  "clip" -> {
    let (p, _e) = trace2("clip",
      In(F64, tail_of(CLIP_N, CLIP_TILE)), Out(F64, tail_of(CLIP_N, CLIP_TILE)), clip)
    p
  }
  "elemops" -> {
    let (p, _e) = trace3("elemops",
      In(F64, tail_of(TAIL_N, TAIL_TILE)), In(F64, tail_of(TAIL_N, TAIL_TILE)),
      Out(F64, tail_of(TAIL_N, TAIL_TILE)), elemops)
    p
  }
  "reduce_sum" -> {
    let (p, _e) = trace2("reduce_sum", In(F64, red_in(PadZero)), Out(F64, one_out()), sum_reduction)
    p
  }
  "softmax" -> {
    let (p, _e) = trace2("softmax", In(F64, red_in(PadNegInf)), Out(F64, tail_of(RED_N, RED_TILE)), softmax)
    p
  }
  "dot" -> {
    let (p, _e) = trace3("dot", In(F64, red_in(PadZero)), In(F64, red_in(PadZero)), Out(F64, one_out()), dot)
    p
  }
  "mse" -> {
    let (p, _e) = trace3("mse", In(F64, red_in(PadZero)), In(F64, red_in(PadZero)), Out(F64, one_out()), mse)
    p
  }
  "monte_carlo" -> {
    let (p, _e) = trace2("monte_carlo", In(F64, red_in(PadZero)), Out(F64, one_out()), monte_carlo)
    p
  }
  "rms_norm" -> {
    let (p, _e) = trace2("rms_norm", In(F64, red_in(PadZero)), Out(F64, tail_of(RED_N, RED_TILE)), rms_norm)
    p
  }
  "silu" -> {
    let (p, _e) = trace2("silu", In(F64, red_in(PadZero)), Out(F64, tail_of(RED_N, RED_TILE)), silu)
    p
  }
  "sigmoid" -> {
    let (p, _e) = trace2("sigmoid", In(F64, red_in(PadZero)), Out(F64, tail_of(RED_N, RED_TILE)), sigmoid)
    p
  }
  "ppo_loss" -> {
    let (p, _e) = trace4("ppo_loss",
      In(F64, red_in(PadZero)), In(F64, red_in(PadZero)), In(F64, red_in(PadZero)), Out(F64, one_out()),
      ppo_loss)
    p
  }
  "dpo_loss" -> {
    let (p, _e) = trace5("dpo_loss",
      In(F64, red_in(PadZero)), In(F64, red_in(PadZero)), In(F64, red_in(PadZero)), In(F64, red_in(PadZero)),
      Out(F64, one_out()), dpo_loss)
    p
  }
  "mathops" -> {
    let (p, _e) = trace3("mathops",
      In(F64, tail_of(TAIL_N, TAIL_TILE)), In(F64, tail_of(TAIL_N, TAIL_TILE)),
      Out(F64, tail_of(TAIL_N, TAIL_TILE)), mathops)
    p
  }
  "foldif" -> {
    let (p, _e) = trace2("foldif",
      In(F64, cells([FOLD_CHUNKS * FOLD_BLOCKS * FOLD_TILE], [FOLD_TILE], along: [FREE_AXIS])),
      Out(F64, run_of(FOLD_TILE)), (x, o) => foldif(x, o, FOLD_CHUNKS))
    p
  }
  "argmax" -> {
    let (p, _e) = trace2("argmax", In(F64, red_in(PadNegInf)), Out(F64, tail_of(RED_N, RED_TILE)), argmax)
    p
  }
  "matmul" -> {
    let (p, _e) = trace3("matmul",
      In(F64, cells([MM_M, MM_K], [MM_TM, MM_TK], along: [0, FREE_AXIS])),
      In(F64, cells([MM_K, MM_N], [MM_TK, MM_TN], along: [FREE_AXIS, 1])),
      Out(F64, cells([MM_M, MM_N], [MM_TM, MM_TN])), matmul)
    p
  }
  "batched_matmul" -> {
    let (p, _e) = trace3("batched_matmul", In(F64, Whole), In(F64, Whole),
      Out(F64, cells([BMM_B, BMM_M, BMM_N], [1, BMM_T, BMM_T], along: [2, 0, 1])), batched_matmul)
    p
  }
  "transpose" -> {
    let (p, _e) = trace2("transpose",
      In(F64, cells([TR_ROWS, TR_COLS], [TR_TILE, TR_TILE])), Shared(F64), transpose)
    p
  }
  "layer_norm" -> {
    let (p, _e) = trace4("layer_norm",
      In(F64, run_of(LN_D)), In(F64, vec(LN_D)), In(F64, vec(LN_D)), Out(F64, run_of(LN_D)), layer_norm)
    p
  }
  "batch_norm" -> {
    let (p, _e) = trace4("batch_norm",
      In(F64, Whole), In(F64, Whole), In(F64, Whole), Shared(F64), batch_norm)
    p
  }
  "group_norm" -> {
    let (p, _e) = trace4("group_norm",
      In(F64, gn_cells()), In(F64, gn_scale()), In(F64, gn_scale()), Out(F64, gn_cells()), group_norm)
    p
  }
  "fused_rms_norm" -> {
    let (p, _e) = trace4("fused_rms_norm",
      In(F64, run_of(FR_D)), In(F64, run_of(FR_D)), In(F64, vec(FR_D)), Out(F64, run_of(FR_D)),
      fused_rms_norm)
    p
  }
  "transpose_tail" -> {
    let (p, _e) = trace2("transpose_tail", In(F64, Whole), Shared(F64), transpose_tail)
    p
  }
  "conv1d" -> {
    let (p, _e) = trace3("conv1d",
      In(F64, Whole), In(F64, Whole), Out(F64, tail_of(c1_out(), C1_TILE)), conv1d)
    p
  }
  "conv2d" -> {
    let (p, _e) = trace3("conv2d",
      In(F64, Whole), In(F64, Whole), Out(F64, cells([c2_oh(), c2_ow()], [C2_TILE, C2_TILE])), conv2d)
    p
  }
  "max_pool" -> {
    let (p, _e) = trace2("max_pool",
      In(F64, Whole), Out(F64, cells([mp_oh(), mp_ow()], [MP_TILE, MP_TILE])), max_pool)
    p
  }
  "interleave" -> {

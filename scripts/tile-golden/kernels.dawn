    trace_kernel("gpt_scores", ["f64", "f64"], () => gpt_scores(param(F64, 0), param(F64, 1)))
  "gpt_context" ->
    trace_kernel("gpt_context", ["f64", "f64", "f64"],
      () => gpt_context(param(F64, 0), param(F64, 1), param(F64, 2)))
  "gpt_dense" ->
    trace_kernel("gpt_dense", ["f64", "f64", "f64", "f64"],
      () => gpt_dense(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "gpt_fc" ->
    trace_kernel("gpt_fc", ["f64", "f64", "f64", "f64"],
      () => gpt_fc(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "gpt_gelu" ->
    trace_kernel("gpt_gelu", ["f64", "f64"], () => gpt_gelu(param(F64, 0), param(F64, 1)))
  "gpt_down" ->
    trace_kernel("gpt_down", ["f64", "f64", "f64", "f64"],
      () => gpt_down(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "llama_rms" ->
    trace_kernel("llama_rms", ["f64", "f64", "f64"],
      () => llama_rms(param(F64, 0), param(F64, 1), param(F64, 2)))
  "llama_qkv" ->
    trace_kernel("llama_qkv", ["f64", "f64", "f64"],
      () => llama_qkv(param(F64, 0), param(F64, 1), param(F64, 2)))
  "llama_rope" ->
    trace_kernel("llama_rope", ["f64", "f64", "f64", "f64"],
      () => llama_rope(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "llama_scores" ->
    trace_kernel("llama_scores", ["f64", "f64", "f64"],
      () => llama_scores(param(F64, 0), param(F64, 1), param(F64, 2)))
  "llama_out" ->
    trace_kernel("llama_out", ["f64", "f64", "f64"],
      () => llama_out(param(F64, 0), param(F64, 1), param(F64, 2)))
  "llama_ffn" ->
    trace_kernel("llama_ffn", ["f64", "f64", "f64"],
      () => llama_ffn(param(F64, 0), param(F64, 1), param(F64, 2)))
  "llama_down" ->
    trace_kernel("llama_down", ["f64", "f64", "f64"],
      () => llama_down(param(F64, 0), param(F64, 1), param(F64, 2)))
  "trig_sweep" ->
    trace_kernel("trig_sweep", ["f64", "f64", "f64", "f64"],
      () => trig_sweep(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "rope" ->
    trace_kernel("rope", ["f64", "f64", "f64", "f64"],
      () => rope(param(F64, 0), param(F64, 1), param(F64, 2), param(F64, 3)))
  "shape_ops" ->
    trace_kernel("shape_ops", ["f64", "f64"], () => shape_ops(param(F64, 0), param(F64, 1)))
  "grid_stride" ->
    trace_kernel("grid_stride", ["f64", "f64"], () => grid_stride(param(F64, 0), param(F64, 1), 4))
  "token_join" ->
    trace_kernel("token_join", ["f64", "f64", "f64"],
      () => token_join(param(F64, 0), param(F64, 1), param(F64, 2)))
  "ptr_roundtrip" ->
    trace_kernel("ptr_roundtrip", ["f64", "f64"], () => ptr_roundtrip(param(F64, 0), param(F64, 1), 3))
  "ptr_recast" ->
    trace_kernel("ptr_recast", ["i32", "f64"], () => ptr_recast(param(I32, 0), param(F64, 1)))
  "dtype_i16" ->
    trace_kernel("dtype_i16", ["i16", "i16", "i16"],
      () => dtype_i16(param(I16, 0), param(I16, 1), param(I16, 2)))
  "dtype_i64" ->
    trace_kernel("dtype_i64", ["i64", "i64", "i64"],
      () => dtype_i64(param(I64, 0), param(I64, 1), param(I64, 2)))
  "dtype_tf32" ->
    trace_kernel("dtype_tf32", ["tf32", "f64", "f64"],
      () => dtype_tf32(param(TF32, 0), param(F64, 1), param(F64, 2)))
  "dtype_e4m3" ->
    trace_kernel("dtype_e4m3", ["f8E4M3FN", "f64", "f64"],
      () => dtype_e4m3(param(F8E4M3FN, 0), param(F64, 1), param(F64, 2)))
  "dtype_e5m2" ->
    trace_kernel("dtype_e5m2", ["f8E5M2", "f64", "f64"],
      () => dtype_e5m2(param(F8E5M2, 0), param(F64, 1), param(F64, 2)))
  "dtype_e8m0" ->
    trace_kernel("dtype_e8m0", ["f8E8M0FNU", "f64", "f64"],
      () => dtype_e8m0(param(F8E8M0FNU, 0), param(F64, 1), param(F64, 2)))
  "loop_count" ->
    trace_kernel("loop_count", ["i32", "i32"], () => loop_count(param(I32, 0), param(I32, 1)))
  "loop_bound" ->
    trace_kernel("loop_bound", ["i32", "i32"], () => loop_bound(param(I32, 0), param(I32, 1)))
  "loop_until" ->
    trace_kernel("loop_until", ["f64", "f64"], () => loop_until(param(F64, 0), param(F64, 1), NEWTON_EPS))
  "loop_none" ->
    trace_kernel("loop_none", ["f64", "f64"],
      () => loop_none(param(F64, 0), param(F64, 1), LOOP_NONE_THRESHOLD, LOOP_NONE_STEP))
  "attr_round" ->
    trace_kernel("attr_round", ["f64", "f64", "f64"],
      () => attr_round(param(F64, 0), param(F64, 1), param(F64, 2)))
  "attr_nan" ->
    trace_kernel("attr_nan", ["f64", "f64", "f64"],
      () => attr_nan(param(F64, 0), param(F64, 1), param(F64, 2)))
  "attr_ftz" ->
    trace_kernel("attr_ftz", ["f64", "f64", "f64"],
      () => attr_ftz(param(F64, 0), param(F64, 1), param(F64, 2)))
  "attr_approx" ->
    trace_kernel("attr_approx", ["f64", "f64"], () => attr_approx(param(F64, 0), param(F64, 1)))
  "attr_overflow" ->
    trace_kernel("attr_overflow", ["i32", "i32", "i32"],
      () => attr_overflow(param(I32, 0), param(I32, 1), param(I32, 2)))
  "attr_memsem" ->
    trace_kernel("attr_memsem", ["i32", "i32"], () => attr_memsem(param(I32, 0), param(I32, 1)))
  "attr_addf" ->
    trace_kernel("attr_addf", ["f64", "f64"], () => attr_addf(param(F64, 0), param(F64, 1)))
  "attr_ucmp" ->
    trace_kernel("attr_ucmp", ["i32"], () => attr_ucmp(param(I32, 0)))
  "assert_pass" ->
    trace_kernel("assert_pass", ["i32", "i32"], () => assert_pass(param(I32, 0), param(I32, 1)))
  "assert_fail" ->
    trace_kernel("assert_fail", ["i32", "i32"], () => assert_fail(param(I32, 0), param(I32, 1)))
  "print_tile" ->
    trace_kernel("print_tile", ["i32", "i32"], () => print_tile(param(I32, 0), param(I32, 1)))
  "assume_divby" ->
    trace_kernel("assume_divby", ["i32", "i32"], () => assume_divby(param(I32, 0), param(I32, 1)))
  "assume_same" ->
    trace_kernel("assume_same", ["i32", "i32"], () => assume_same(param(I32, 0), param(I32, 1)))
  "assume_bounded" ->
    trace_kernel("assume_bounded", ["i32", "i32"], () => assume_bounded(param(I32, 0), param(I32, 1)))
  _ -> panic("tile-golden: no kernel named `${name}`")
}

# Trace `name` twice and answer the record, or panic if the two runs differ.
fn trace_twice(name: String) -> TileProg = {
  let first = trace(name)
  let second = trace(name)
  if first != second { panic("tile-golden: `${name}` traced twice gave two different programs") } else { () }
  first
}

pub fn main() -> Unit !io = match args() {
  ["--bytecode-version"] -> println(bytecode_version())
  [name] -> print(render(trace_twice(name)))
  [name, "--bytecode", path] -> {
    let bytes = encode(trace_twice(name))
    match with_fs_real(() => write_bytes(path, bytes)) {
      Ok(_) -> ()
      Err(_e) -> panic("tile-golden: cannot write the bytecode to `${path}`")
    }
  }
  _ -> panic("usage: kernels <vadd|vadd_f32|vadd_bf16|sum|vadd_tail|copy|relu|leaky_relu|clip|elemops"
      ++ "|reduce_sum|softmax|dot|mse|monte_carlo|rms_norm|silu|sigmoid|ppo_loss|dpo_loss|mathops|foldif|argmax"
      ++ "|matmul|batched_matmul|transpose|layer_norm|batch_norm|group_norm|fused_rms_norm"
      ++ "|transpose_tail|conv1d|conv2d|max_pool|interleave|rgb_gray|jacobi|depthwise_conv1d|gaussian_blur"
      ++ "|count_eq|subarray_sum|rainbow|int_ops"
      ++ "|sum_diff|reverse|invert|f16_ops|dot_f16|matmul_f16|batched_matmul_f16|matmul_i8"
      ++ "|token_embed|sort_rank|merge_rank|scatter_perm"
      ++ "|prefix_sum|max_subarray|seg_scan|compact|linrec|gae|ssm_scan"
      ++ "|histogram|cas_swap|erf_sweep|geglu|trig_sweep|rope"
      ++ "|dtype_i16|dtype_i64|dtype_tf32|dtype_e4m3|dtype_e5m2|dtype_e8m0"
      ++ "|kv_scores|kv_context|attn_bwd_mmt|attn_bwd_ds|lin_attn_s|lin_attn_out"
      ++ "|ols_gram|ols_elim|ols_beta"
      ++ "|gpt_ln|gpt_qkv|gpt_scores|gpt_context|gpt_dense|gpt_fc|gpt_gelu|gpt_down"
      ++ "|llama_rms|llama_qkv|llama_rope|llama_scores|llama_out|llama_ffn|llama_down"
      ++ "|trig_sweep|rope|shape_ops|grid_stride|token_join|ptr_roundtrip|ptr_recast"
      ++ "|loop_count|loop_bound|loop_until|loop_none"
      ++ "|attr_round|attr_nan|attr_ftz|attr_approx|attr_overflow|attr_memsem|attr_addf|attr_ucmp"
      ++ "|assert_pass|assert_fail|print_tile|assume_divby|assume_same|assume_bounded>"
      ++ " [--bytecode <path>] | kernels --bytecode-version")
}

# Build-time syntax highlighting for Dawn code blocks — the site ships zero JS.
# Classes (site/README.md): k keyword, t type/ctor, f definition name after fn,
# s string, i the $name / ${ } delimiters inside a string, n number/bool/char,
# c comment. The scan has the same shape as the Playground's CodeMirror grammar
# (site/play-ui/src/dawn-lang.ts): code inside ${ } is code, highlighted by the
# same loop as the block, with nested strings recursing and only code braces
# counted toward the closing }. Both are one grammar, so a reader sees the
# same colours on the home page as in the Playground.

use html/escape.{escape_html}
use md/text.{cp_at, seg}

fn is_digit(c: Char) -> Bool = c >= '0' && c <= '9'

fn is_upper(c: Char) -> Bool = c >= 'A' && c <= 'Z'

fn is_ident_start(c: Char) -> Bool =
  (c >= 'a' && c <= 'z') || is_upper(c) || c == '_'

fn is_ident_cp(c: Char) -> Bool = is_ident_start(c) || is_digit(c)

fn is_keyword(w: String) -> Bool =
  w == "fn" || w == "let" || w == "var" || w == "type" || w == "const" ||
  w == "use" || w == "java" || w == "pub" || w == "match" || w == "if" ||
  w == "else" || w == "for" || w == "in" || w == "while" || w == "with" ||
  w == "comptime" || w == "test" || w == "assert" || w == "not" || w == "derive" ||
  w == "trait" || w == "impl" || w == "effect" || w == "handle" || w == "opaque" ||
  w == "return" || w == "break" || w == "continue"

fn span(cls: String, text: String) -> String =
  "<span class=\"${cls}\">" ++ escape_html(text) ++ "</span>"

fn line_end(cs: List[Char], from: Int) -> Int = {
  var i = from
  while i < len(cs) && cp_at(cs, i) != '\n' {
    i = i + 1
  }
  i
}

fn ident_end(cs: List[Char], from: Int) -> Int = {
  var i = from
  while i < len(cs) && is_ident_cp(cp_at(cs, i)) {
    i = i + 1
  }
  i
}

fn number_end(cs: List[Char], from: Int) -> Int = {
  var i = from
  if cp_at(cs, from) == '0' && (cp_at(cs, from + 1) == 'x' || cp_at(cs, from + 1) == 'b') {
    i = from + 2
    while i < len(cs) && (is_ident_cp(cp_at(cs, i))) {
      i = i + 1
    }
  } else {
    while i < len(cs) && (is_digit(cp_at(cs, i)) || cp_at(cs, i) == '_') {
      i = i + 1
    }
    if cp_at(cs, i) == '.' && is_digit(cp_at(cs, i + 1)) {
      i = i + 1
      while i < len(cs) && is_digit(cp_at(cs, i)) {
        i = i + 1
      }
    }
    if cp_at(cs, i) == 'e' || cp_at(cs, i) == 'E' {
      let j = if cp_at(cs, i + 1) == '+' || cp_at(cs, i + 1) == '-' { i + 2 } else { i + 1 }
      if is_digit(cp_at(cs, j)) {
        i = j
        while i < len(cs) && is_digit(cp_at(cs, i)) {
          i = i + 1
        }
      }
    }
  }
  i
}

## Index just past a char literal starting at the ' in from.
fn char_end(cs: List[Char], from: Int) -> Int = {
  var i = from + 1
  var done = false
  while not done && i < len(cs) {
    let c = cp_at(cs, i)
    if c == '\\' {
      i = i + 2
    } else if c == '\'' {
      i = i + 1
      done = true
    } else if c == '\n' {
      done = true
    } else {
      i = i + 1
    }
  }
  i
}

## A string starting at the " in from ("..." or """..."""), rendered with
## $name and the ${ } delimiters as class i, and the code inside ${ } through
## highlight_from. Returns the HTML and the index just past the string. An
## ordinary string ends at a newline in its own text, but not at one inside an
## interpolation, which is code (the Playground's rule).
fn string_html(cs: List[Char], from: Int) -> (String, Int) = {
  let n = len(cs)
  let triple = cp_at(cs, from + 1) == '"' && cp_at(cs, from + 2) == '"'
  var parts: List[String] = []
  var start = from
  var i = if triple { from + 3 } else { from + 1 }
  var done = false
  while not done && i < n {
    let c = cp_at(cs, i)
    if triple && c == '"' && cp_at(cs, i + 1) == '"' && cp_at(cs, i + 2) == '"' {
      i = i + 3
      done = true
    } else if c == '"' && not triple {
      i = i + 1
      done = true
    } else if c == '\n' && not triple {
      done = true
    } else if c == '\\' {
      i = i + 2
    } else if c == '$' && is_ident_start(cp_at(cs, i + 1)) {
      let e = ident_end(cs, i + 1)
      parts = parts ++ [span("s", seg(cs, start, i)) ++ span("i", seg(cs, i, e))]
      start = e
      i = e
    } else if c == '$' && cp_at(cs, i + 1) == '{' {
      parts = parts ++ [span("s", seg(cs, start, i)) ++ span("i", "\${")]
      let (inner, e) = highlight_from(cs, i + 2, true)
      parts = parts ++ [inner]
      if e < n {
        # e is the closing brace
        parts = parts ++ [span("i", "}")]
        start = e + 1
        i = e + 1
      } else {
        # unclosed: the code ran to the end of the block
        start = e
        i = e
        done = true
      }
    } else {
      i = i + 1
    }
  }
  let to = if i > n { n } else { i }
  if start < to {
    parts = parts ++ [span("s", seg(cs, start, to))]
  }
  (join(parts, ""), to)
}

## Highlight code from index from. With interp, this is the code inside a ${:
## code braces are counted (string and comment braces are eaten by their own
## scans), and the scan stops at the } that closes the interpolation. Returns
## the HTML and where it stopped: that brace, or the end of the block.
fn highlight_from(cs: List[Char], from: Int, interp: Bool) -> (String, Int) = {
  let n = len(cs)
  var parts: List[String] = []
  var start = from
  var prev_word = ""
  var depth = 1
  var stop = false
  var i = from
  while not stop && i < n {
    let c = cp_at(cs, i)
    if interp && c == '{' {
      depth = depth + 1
      i = i + 1
    } else if interp && c == '}' {
      depth = depth - 1
      if depth == 0 {
        stop = true
      } else {
        i = i + 1
      }
    } else if c == '#' {
      let e = line_end(cs, i)
      parts = parts ++ [escape_html(seg(cs, start, i)) ++ span("c", seg(cs, i, e))]
      start = e
      i = e
    } else if c == '"' {
      let (html, e) = string_html(cs, i)
      parts = parts ++ [escape_html(seg(cs, start, i)) ++ html]
      start = e
      i = e
    } else if c == '`' {
      # raw string: literal through the closing backtick, no interpolation
      var e = i + 1
      while e < n && cp_at(cs, e) != '`' {
        e = e + 1
      }
      let e2 = if e < n { e + 1 } else { e }
      parts = parts ++ [escape_html(seg(cs, start, i)) ++ span("s", seg(cs, i, e2))]
      start = e2
      i = e2
    } else if c == '\'' {
      let e = char_end(cs, i)
      parts = parts ++ [escape_html(seg(cs, start, i)) ++ span("n", seg(cs, i, e))]
      start = e
      i = e
    } else if is_digit(c) {
      let e = number_end(cs, i)
      parts = parts ++ [escape_html(seg(cs, start, i)) ++ span("n", seg(cs, i, e))]
      start = e
      i = e
    } else if is_ident_start(c) {
      let e = ident_end(cs, i)
      let w = seg(cs, i, e)
      let after = cp_at(cs, e)
      let cls =
        if is_keyword(w) {
          "k"
        } else if w == "true" || w == "false" {
          "n"
        } else if is_upper(c) {
          "t"
        } else if prev_word == "fn" && (after == '(' || after == '[') {
          "f"
        } else {
          ""
        }
      if cls == "" {
        i = e
      } else {
        parts = parts ++ [escape_html(seg(cs, start, i)) ++ span(cls, w)]
        start = e
        i = e
      }
      prev_word = w
    } else if c == '!' && (is_ident_start(cp_at(cs, i + 1)) || cp_at(cs, i + 1) == '(') {
      let e = if cp_at(cs, i + 1) == '(' { i + 1 } else { ident_end(cs, i + 1) }
      parts = parts ++ [escape_html(seg(cs, start, i)) ++ span("k", seg(cs, i, e))]
      start = e
      i = e
    } else {
      i = i + 1
    }
  }
  let to = if i > n { n } else { i }
  if start < to {
    parts = parts ++ [escape_html(seg(cs, start, to))]
  }
  (join(parts, ""), to)
}

## Highlight one Dawn code block as HTML (no surrounding <pre><code>).
pub fn highlight_dawn(code: String) -> String = {
  let (html, _) = highlight_from(code_points(code), 0, false)
  html
}

test "keywords, types, defs, numbers" {
  assert highlight_dawn("fn add(x: Int) -> Int = x + 1") ==
    `<span class="k">fn</span> <span class="f">add</span>(x: ` ++
    `<span class="t">Int</span>) -&gt; <span class="t">Int</span> = x + <span class="n">1</span>`
}

test "strings with interpolation, comments, effects" {
  assert highlight_dawn("# note\n") == `<span class="c"># note</span>` ++ "\n"
  assert highlight_dawn(`"a $x b"`) ==
    `<span class="s">"a </span><span class="i">$x</span><span class="s"> b"</span>`
  assert highlight_dawn("!io") == `<span class="k">!io</span>`
}

test "interpolation is code, with nested strings" {
  assert highlight_dawn(`"a ${f(x, "y")} b"`) ==
    `<span class="s">"a </span><span class="i">${</span>f(x, ` ++
    `<span class="s">"y"</span>)<span class="i">}</span><span class="s"> b"</span>`
}

test "code braces inside an interpolation nest" {
  assert highlight_dawn(`"${Point { x, y }}"`) ==
    `<span class="s">"</span><span class="i">${</span><span class="t">Point</span> { x, y }` ++
    `<span class="i">}</span><span class="s">"</span>`
  assert highlight_dawn(`"${if a { 1 } else { 2 }}"`) ==
    `<span class="s">"</span><span class="i">${</span><span class="k">if</span> a { ` ++
    `<span class="n">1</span> } <span class="k">else</span> { <span class="n">2</span> }` ++
    `<span class="i">}</span><span class="s">"</span>`
}

test "triple strings interpolate too" {
  assert highlight_dawn("\"\"\"a \${n + 1}\nb\"\"\"") ==
    `<span class="s">""` ++ `"a </span><span class="i">${</span>n + <span class="n">1</span>` ++
    `<span class="i">}</span><span class="s">` ++ "\nb\"\"\"" ++ `</span>`
}

test "an unclosed interpolation runs to the end of the block" {
  assert highlight_dawn("\"a \${f(x\nlet y = 1") ==
    `<span class="s">"a </span><span class="i">${</span>f(x` ++ "\n" ++
    `<span class="k">let</span> y = <span class="n">1</span>`
}

test "raw strings highlight as one literal" {
  assert highlight_dawn("let s = `a \$x`") ==
    `<span class="k">let</span> s = <span class="s">` ++ "`a \$x`" ++ `</span>`
  assert highlight_dawn("`a \${f(\"x\")}`") ==
    `<span class="s">` ++ "`a \${f(\"x\")}`" ++ `</span>`
}

test "tail-block params are not definition names" {
  assert highlight_dawn("map(xs) { c => c }") ==
    `map(xs) { c =&gt; c }`
}

test "char literals and bools" {
  assert highlight_dawn("'a'") == `<span class="n">'a'</span>`
  assert highlight_dawn("true") == `<span class="n">true</span>`
}

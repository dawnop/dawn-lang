# The six std names that stopped being exported in v0.55.0. The checker used
# to answer them with a migration hint; there is no hint table any more
# (docs/std-moved-design.md, withdrawn). What is pinned here is the ordinary
# answer they get: the first three a plain "no exported function", and so do `fmt.atoi` and
# `fmt.atoi_radix`, which std stopped declaring at all when K19 made their body
# the public `parse_int`; `fmt.atod`, which std still declares privately, the
# private-function answer.
#
# Each result is bound with an annotation so the only diagnostic per line is
# the lookup itself: an unannotated `to_string(<error>)` adds an inference
# cascade that says nothing about this case.
use std/str
use std/cursor
use std/cursor.{Cursor}
use std/bytes
use std/fmt

pub fn main() -> Unit !io = {
  let a: String = str.substring("abcdef", 1, 4)
  let b: Cursor = cursor.at("abc", 2)
  let c: Int = bytes.get(bytes.buf(), 0)
  let d: Option[Int] = fmt.atoi("42")
  let e: Option[Int] = fmt.atoi_radix("ff", 16)
  let f: Option[Float] = fmt.atod("1.5")
  println(a ++ to_string(cursor.offset("abc", b)) ++ to_string(c))
  println(to_string(d) ++ to_string(e) ++ to_string(f))
}

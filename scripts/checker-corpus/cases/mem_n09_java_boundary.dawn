# checker.dawn: rule R4 (N9). Java may run a callback on any thread at any
# time, so a function value whose row names `Mem` does not cross, and a buffer
# is not a Java argument or result.
use java "java.lang.Thread"
use java "java.util.ArrayList"
use std/mem

pub fn thread_over_buffer() -> Thread !io = mem.with_mem([@s] () => {
  let b = mem.new(4)
  Thread.new(() => mem.set(b, 0, 1))
})

pub fn buffer_as_argument() -> Int !io = mem.with_mem([@s] () => {
  let a = ArrayList.new()
  let _ = a.add(mem.new(4))
  a.size()
})

# std/hamt — the persistent hash trie that Map and Set are both built from.
#
# A 32-way hash-array-mapped trie with path copying: `assoc` rebuilds the nodes
# along one root-to-leaf path (at most seven of them) and shares everything
# else with the version it came from. That is what makes an immutable map cheap
# enough to pass around, and it is the same shape the handwritten Java DawnMap
# had — the difference is that this one is Dawn source, so every backend gets
# it for free (docs/collections-dejava-research.md §5.1).
#
# Two things it asks of the language, and nothing else:
#
#   * `Array[T]` — the single collection primitive a backend implements
#     (docs/native-backend-plan.md §10). Node children live in one, and the
#     bounded copy `array_with` performs is the path copy.
#   * `Eq[K]` + `Hash[K]` — passed as dictionaries, so which equality decides
#     "same key" is the one the key type declares. Before this, a map compared
#     keys with the JVM's `Object.equals`, which is only *usually* the same
#     relation as Dawn's `==`.
#
# Insertion order is observable (spec §2.2: `keys`/`entries` are in insertion
# order), so every leaf carries the monotonic `seq` it was first inserted at,
# and re-binding a key keeps the old one. Iteration sorts by it.
#
# Nothing in std imports this module and nothing should: `Map` and `Set` are
# builtin type names, and the calls that reach here are the ones lowering
# writes when it turns a `map_*`/`set_*` primitive into a direct call. That is
# what keeps it a leaf of the module order.

## One node of the trie. `NColl` holds leaves whose hashes are equal, which is
## the only case a branch cannot separate.
pub type Node[K, V] =
  | NEmpty
  | NLeaf(h: Int, k: K, v: V, seq: Int)
  | NColl(h: Int, kids: Array[Node[K, V]])
  | NBranch(bitmap: Int, kids: Array[Node[K, V]])

## A whole map: the trie, how many entries are live in it, and the counter the
## next insertion takes its position from.
pub type Hamt[K, V] = { root: Node[K, V], count: Int, nseq: Int }

const BITS: Int = 5

const MASK: Int = 31

## Hashes are used 32 bits at a time. Masking to the unsigned word costs
## nothing and buys two things: the shift is unambiguous whatever `>>>` does
## with a sign bit, and the descent is bounded at seven levels rather than
## thirteen.
fn hash32[K: Hash](k: K) -> Int = hash(k) & 4294967295

fn idx_at(h: Int, shift: Int) -> Int = (h >>> shift) & MASK

# ---- small array helpers ----
#
# `array_with` replaces in place-ish (a bounded copy); insert and remove change
# the length, so they rebuild. Both run over <= 32 slots, which is what makes
# the whole structure's O(log n) a small constant.

fn arr1[T](x: T) -> Array[T] = {
  let e: Array[T] = array_new()
  array_push(e, x)
}

fn arr2[T](x: T, y: T) -> Array[T] = array_push(arr1(x), y)

fn arr_insert[T](a: Array[T], i: Int, x: T) -> Array[T] = {
  var out: Array[T] = array_new()
  var j = 0
  while j < i {
    out = array_push(out, array_get(a, j))
    j = j + 1
  }
  out = array_push(out, x)
  while j < array_len(a) {
    out = array_push(out, array_get(a, j))
    j = j + 1
  }
  out
}

fn arr_remove[T](a: Array[T], i: Int) -> Array[T] = {
  var out: Array[T] = array_new()
  var j = 0
  while j < array_len(a) {
    if j != i {
      out = array_push(out, array_get(a, j))
    }
    j = j + 1
  }
  out
}

# ---- lookup ----

## The leaf holding `k`, or `None`. Returning the leaf rather than the value
## lets `assoc` read the `seq` it must preserve without a second descent.
fn node_leaf[K: Eq, V](n: Node[K, V], shift: Int, h: Int, k: K) -> Option[Node[K, V]] =
  match n {
    NEmpty -> None
    NLeaf(lh, lk, _, _) -> if lh == h && eq(lk, k) { Some(n) } else { None }
    NColl(ch, kids) -> if ch == h { coll_leaf(kids, 0, k) } else { None }
    NBranch(bm, kids) -> {
      let bit = 1 << idx_at(h, shift)
      if bm & bit == 0 {
        None
      } else {
        node_leaf(array_get(kids, popcount(bm & (bit - 1))), shift + BITS, h, k)
      }
    }
  }

fn coll_leaf[K: Eq, V](kids: Array[Node[K, V]], i: Int, k: K) -> Option[Node[K, V]] =
  if i >= array_len(kids) {
    None
  } else {
    let kid = array_get(kids, i)
    match kid {
      NLeaf(_, lk, _, _) -> if eq(lk, k) { Some(kid) } else { coll_leaf(kids, i + 1, k) }
      _ -> coll_leaf(kids, i + 1, k)
    }
  }

# ---- insertion ----

## A one-child branch holding `n`, whose own hash prefix is `h`. Used to push a
## leaf down a level when two hashes agree above the current shift.
fn branch_of[K, V](n: Node[K, V], h: Int, shift: Int) -> Node[K, V] =
  NBranch(1 << idx_at(h, shift), arr1(n))

## Bind `k` to `v` at position `seq`. The caller has already decided whether
## this is a fresh key (and so what `seq` is), which is why nothing here has to
## report back whether the map grew — the alternative allocates a tuple per
## level, and the levels are the whole cost of the operation.
fn node_put[K: Eq, V](
  n: Node[K, V], shift: Int, h: Int, k: K, v: V, seq: Int
) -> Node[K, V] =
  match n {
    NEmpty -> NLeaf(h, k, v, seq)
    NLeaf(lh, lk, _, _) ->
      if lh == h {
        if eq(lk, k) {
          NLeaf(h, k, v, seq)
        } else {
          NColl(h, arr2(n, NLeaf(h, k, v, seq)))
        }
      } else {
        node_put(branch_of(n, lh, shift), shift, h, k, v, seq)
      }
    NColl(ch, kids) ->
      if ch == h {
        NColl(ch, coll_put(kids, 0, h, k, v, seq))
      } else {
        node_put(branch_of(n, ch, shift), shift, h, k, v, seq)
      }
    NBranch(bm, kids) -> {
      let bit = 1 << idx_at(h, shift)
      let pos = popcount(bm & (bit - 1))
      if bm & bit == 0 {
        NBranch(bm | bit, arr_insert(kids, pos, NLeaf(h, k, v, seq)))
      } else {
        let sub = node_put(array_get(kids, pos), shift + BITS, h, k, v, seq)
        NBranch(bm, array_with(kids, pos, sub))
      }
    }
  }

fn coll_put[K: Eq, V](
  kids: Array[Node[K, V]], i: Int, h: Int, k: K, v: V, seq: Int
) -> Array[Node[K, V]] =
  if i >= array_len(kids) {
    array_push(kids, NLeaf(h, k, v, seq))
  } else {
    match array_get(kids, i) {
      NLeaf(_, lk, _, _) ->
        if eq(lk, k) {
          array_with(kids, i, NLeaf(h, k, v, seq))
        } else {
          coll_put(kids, i + 1, h, k, v, seq)
        }
      _ -> coll_put(kids, i + 1, h, k, v, seq)
    }
  }

# ---- removal ----
#
# A branch that loses its last child becomes empty, and one left holding a
# single leaf collapses into that leaf. Collapsing is safe because a leaf
# carries its whole hash and `node_leaf` compares all of it, so a leaf is
# correct at any depth — and without it, deleting from a large map would leave
# a spine of one-child branches that every later lookup walks.

fn node_del[K: Eq, V](n: Node[K, V], shift: Int, h: Int, k: K) -> Node[K, V] =
  match n {
    NEmpty -> n
    NLeaf(lh, lk, _, _) -> if lh == h && eq(lk, k) { NEmpty } else { n }
    NColl(ch, kids) ->
      if ch != h {
        n
      } else {
        let left = coll_del(kids, 0, k)
        if array_len(left) == 1 { array_get(left, 0) } else { NColl(ch, left) }
      }
    NBranch(bm, kids) -> {
      let bit = 1 << idx_at(h, shift)
      if bm & bit == 0 {
        n
      } else {
        let pos = popcount(bm & (bit - 1))
        let sub = node_del(array_get(kids, pos), shift + BITS, h, k)
        match sub {
          NEmpty -> {
            let left = arr_remove(kids, pos)
            if array_len(left) == 0 {
              NEmpty
            } else if array_len(left) == 1 && is_leaf(array_get(left, 0)) {
              array_get(left, 0)
            } else {
              NBranch(bm & (-1 - bit), left)
            }
          }
          _ -> NBranch(bm, array_with(kids, pos, sub))
        }
      }
    }
  }

fn is_leaf[K, V](n: Node[K, V]) -> Bool =
  match n {
    NLeaf(_, _, _, _) -> true
    _ -> false
  }

fn coll_del[K: Eq, V](kids: Array[Node[K, V]], i: Int, k: K) -> Array[Node[K, V]] =
  if i >= array_len(kids) {
    kids
  } else {
    match array_get(kids, i) {
      NLeaf(_, lk, _, _) -> if eq(lk, k) { arr_remove(kids, i) } else { coll_del(kids, i + 1, k) }
      _ -> coll_del(kids, i + 1, k)
    }
  }

# ---- the map surface ----

## A map with no entries.
pub fn empty[K, V]() -> Hamt[K, V] = Hamt { root: NEmpty, count: 0, nseq: 0 }

## Number of live entries.
pub fn count[K, V](m: Hamt[K, V]) -> Int = m.count

## The value bound to `k`, or `None`.
pub fn get[K: Eq + Hash, V](m: Hamt[K, V], k: K) -> Option[V] =
  match node_leaf(m.root, 0, hash32(k), k) {
    Some(leaf) ->
      match leaf {
        NLeaf(_, _, v, _) -> Some(v)
        _ -> None
      }
    None -> None
  }

## The value bound to `k`, panicking when it is absent — what `m[k]` means.
## Naming the missing key is why this one asks for `Show` and nothing else
## does.
pub fn index[K: Eq + Hash + Show, V](m: Hamt[K, V], k: K) -> V =
  match get(m, k) {
    Some(v) -> v
    None -> panic("key not found: " ++ show(k))
  }

## Whether `k` is bound.
pub fn has[K: Eq + Hash, V](m: Hamt[K, V], k: K) -> Bool =
  match node_leaf(m.root, 0, hash32(k), k) {
    Some(_) -> true
    None -> false
  }

## A copy with `k` bound to `v`. A key already present keeps the position it
## was first inserted at, which is what makes iteration order stable under
## rebinding (spec §2.2).
# The fields come out into bindings before the update is built: after the
# last of these reads nothing touches `m`, so a caller that handed over its
# only reference gets the map released *before* `node_put` runs -- which is
# what lets the spine be rewritten in place instead of path-copied
# (perceus-design.md 6). Written `..m`-style, `m` survives to the end of the
# expression and pins the whole spine at rc 2.
pub fn assoc[K: Eq + Hash, V](m: Hamt[K, V], k: K, v: V) -> Hamt[K, V] = {
  let h = hash32(k)
  let root = m.root
  let count = m.count
  let nseq = m.nseq
  match node_leaf(root, 0, h, k) {
    Some(leaf) -> {
      let s = leaf_seq(leaf)
      Hamt { root: node_put(root, 0, h, k, v, s), count: count, nseq: nseq }
    }
    None ->
      Hamt {
        root: node_put(root, 0, h, k, v, nseq),
        count: count + 1,
        nseq: nseq + 1
      }
  }
}

fn leaf_seq[K, V](n: Node[K, V]) -> Int =
  match n {
    NLeaf(_, _, _, s) -> s
    _ -> -1
  }

## A copy without `k`; absent keys are fine.
# Field bindings before the rebuild, for assoc's reason.
pub fn dissoc[K: Eq + Hash, V](m: Hamt[K, V], k: K) -> Hamt[K, V] = {
  let h = hash32(k)
  let root = m.root
  let count = m.count
  let nseq = m.nseq
  match node_leaf(root, 0, h, k) {
    # `m` itself: on this path it is the arm's value, and on the other path
    # it is dead before `node_del` runs -- per-path accounting keeps both
    None -> m
    Some(_) -> Hamt { root: node_del(root, 0, h, k), count: count - 1, nseq: nseq }
  }
}

# ---- iteration ----
#
# Leaves come out of the trie in hash order, which is not insertion order, so
# the walk collects `(seq, key, value)` and sorts. The sort is why `seq` is on
# every leaf rather than kept in a side list: a side list would have to be
# rewritten on every removal, and removals are rare while lookups are not.

fn walk[K, V](n: Node[K, V], acc: List[(Int, K, V)]) -> List[(Int, K, V)] =
  match n {
    NEmpty -> acc
    NLeaf(_, k, v, s) -> acc ++ [(s, k, v)]
    NColl(_, kids) -> walk_kids(kids, 0, acc)
    NBranch(_, kids) -> walk_kids(kids, 0, acc)
  }

fn walk_kids[K, V](kids: Array[Node[K, V]], i: Int, acc: List[(Int, K, V)]) -> List[(Int, K, V)] =
  if i >= array_len(kids) {
    acc
  } else {
    walk_kids(kids, i + 1, walk(array_get(kids, i), acc))
  }

fn by_seq[K, V](a: (Int, K, V), b: (Int, K, V)) -> Int = {
  let (sa, _, _) = a
  let (sb, _, _) = b
  if sa < sb { -1 } else if sa > sb { 1 } else { 0 }
}

fn ordered[K, V](m: Hamt[K, V]) -> List[(Int, K, V)] = {
  let empty_acc: List[(Int, K, V)] = []
  sort_by(walk(m.root, empty_acc), (a, b) => by_seq(a, b))
}

## The (key, value) pairs, in insertion order.
pub fn entries[K, V](m: Hamt[K, V]) -> List[(K, V)] = {
  var out: List[(K, V)] = []
  for e in ordered(m) {
    let (_, k, v) = e
    out = out ++ [(k, v)]
  }
  out
}

## The keys, in insertion order.
pub fn keys[K, V](m: Hamt[K, V]) -> List[K] = {
  var out: List[K] = []
  for e in ordered(m) {
    let (_, k, _) = e
    out = out ++ [k]
  }
  out
}

## The values, in insertion order of their keys.
pub fn values[K, V](m: Hamt[K, V]) -> List[V] = {
  var out: List[V] = []
  for e in ordered(m) {
    let (_, _, v) = e
    out = out ++ [v]
  }
  out
}

fn node_fold[K, V, A](n: Node[K, V], acc: A, f: fn(A, K, V) -> A !e) -> A !e =
  match n {
    NEmpty -> acc
    NLeaf(_, k, v, _) -> f(acc, k, v)
    NColl(_, kids) -> kids_fold(kids, 0, acc, f)
    NBranch(_, kids) -> kids_fold(kids, 0, acc, f)
  }

fn kids_fold[K, V, A](kids: Array[Node[K, V]], i: Int, acc: A, f: fn(A, K, V) -> A !e) -> A !e =
  if i >= array_len(kids) {
    acc
  } else {
    kids_fold(kids, i + 1, node_fold(array_get(kids, i), acc, f), f)
  }

## Every entry combined into one value, on the trie itself: no `(seq, k, v)`
## list, no sort, no pair per entry -- the walk `entries` pays for is the cost
## this exists to avoid. The price is the order: leaves come up in hash order,
## so `f` sees the entries in no promised order and each exactly once. A fold
## whose answer depends on the order it met the entries in belongs on
## `entries(m)`.
pub fn fold[K, V, A](m: Hamt[K, V], init: A, f: fn(A, K, V) -> A !e) -> A !e =
  node_fold(m.root, init, f)

## A map from a list of pairs; a repeated key keeps the last value and the
## first position.
pub fn from[K: Eq + Hash, V](es: List[(K, V)]) -> Hamt[K, V] = {
  var m: Hamt[K, V] = empty()
  for e in es {
    let (k, v) = e
    m = assoc(m, k, v)
  }
  m
}

# ---- the set surface ----
#
# A set is a map to a value nobody reads, which is how DawnSet related to
# DawnMap as well. Only the two operations whose shape differs need a name of
# their own — `has`, `dissoc`, `count` and `keys` already do for a set exactly
# what a set wants.

## A copy with `x` added; an existing element keeps its position.
pub fn sadd[T: Eq + Hash](s: Hamt[T, Bool], x: T) -> Hamt[T, Bool] = assoc(s, x, true)

## A set from a list; duplicates collapse onto the first occurrence.
pub fn sfrom[T: Eq + Hash](xs: List[T]) -> Hamt[T, Bool] = {
  var s: Hamt[T, Bool] = empty()
  for x in xs {
    s = sadd(s, x)
  }
  s
}

# scripts/hamt-contract is a differential against the builtin Map: random
# assoc/dissoc traffic, compared step by step. It is the right shape for
# "these two agree" and the wrong one for everything below, which is why none
# of it is repeated here. What it never calls at all: `index`, `from`, `sadd`,
# `sfrom` -- the whole set surface -- and it never looks at a `Node`.
#
# These blocks look at the trie. `Node` and `Hamt` are ordinary types, so the
# shape after an operation is observable, and the shapes are where the
# interesting clauses live: which node a collision produces, which removals
# collapse a branch and which do not.
#
# Int keys are the lever. `hash32` is `hash(k) & 0xFFFFFFFF` and `hash(Int)` is
# `lo32(v) XOR hi32(v)`, so for `0 <= k < 2^31` the hash *is* the key and the
# trie shape is a function of the literal. It also makes collisions cheap to
# write: `k` and `-(k+1)` always collide, because `-(k+1)` is `~k`, whose low
# half is `0xFFFFFFFF - k` and whose high half is `0xFFFFFFFF`. The contract
# script's collision family is the "Aa"/"BB" String one; these are the Int
# ones, and unlike the String family they come in every arity.

test "empty is the trie's zero, and every reader agrees about it" {
  let e: Hamt[Int, String] = empty()
  assert count(e) == 0
  assert get(e, 0) == None
  assert not has(e, 0)
  assert keys(e) == []
  assert values(e) == []
  assert entries(e) == []
  match e.root {
    NEmpty -> ()
    _ -> { assert false }
  }
  assert e.nseq == 0
  # removing from nothing is not an error, and does not move the counter
  let d = dissoc(e, 7)
  assert count(d) == 0
  assert d.nseq == 0
  match d.root {
    NEmpty -> ()
    _ -> { assert false }
  }
  let none_at_all: List[(Int, String)] = []
  assert count(from(none_at_all)) == 0
  let no_elems: List[Int] = []
  assert count(sfrom(no_elems)) == 0
}

test "index panics with the key it was given; get is the question form" {
  let m: Hamt[Int, String] = from([(1, "one"), (2, "two")])
  assert index(m, 1) == "one"
  assert index(m, 2) == "two"
  assert get(m, 1) == Some("one")
  assert get(m, 99) == None
  assert has(m, 1)
  assert not has(m, 99)
  # spec 4.8: `index` is criterion 1 and `get` is criterion 2, over the same
  # question. The message renders the key with `show`, which is why `index`
  # is the one function here that asks for it.
  match catch_panic(() => index(m, 99)) {
    Ok(_) -> { assert false }
    Err(er) -> { assert er.message == "key not found: 99" }
  }
  match catch_panic(() => index(m, 0 - 1)) {
    Ok(_) -> { assert false }
    Err(er) -> { assert er.message == "key not found: -1" }
  }
  # a String key is shown quoted, because that is what `show` does to one
  let s: Hamt[String, Int] = from([("a", 1)])
  assert index(s, "a") == 1
  match catch_panic(() => index(s, "zz")) {
    Ok(_) -> { assert false }
    Err(er) -> { assert er.message == "key not found: \"zz\"" }
  }
  let e: Hamt[Int, String] = empty()
  match catch_panic(() => index(e, 0)) {
    Ok(_) -> { assert false }
    Err(er) -> { assert er.message == "key not found: 0" }
  }
}

test "keys that share a hash land in one collision node, and it shrinks back" {
  # 0 and -1 have the same hash32, so a branch cannot separate them
  let two: Hamt[Int, String] = from([(0, "a"), (-1, "b")])
  assert count(two) == 2
  assert get(two, 0) == Some("a")
  assert get(two, -1) == Some("b")
  assert keys(two) == [0, -1]
  match two.root {
    NColl(_h, kids) -> { assert array_len(kids) == 2 }
    _ -> { assert false }
  }
  # a wider family: three keys, one hash. The String family the contract
  # script uses only comes in powers of two, so an odd arity is new here.
  let three: Hamt[Int, String] = from([(0, "a"), (-1, "b"), (4294967297, "c")])
  assert count(three) == 3
  assert get(three, 0) == Some("a")
  assert get(three, -1) == Some("b")
  assert get(three, 4294967297) == Some("c")
  match three.root {
    NColl(_h, kids) -> { assert array_len(kids) == 3 }
    _ -> { assert false }
  }
  # rebinding inside a collision node neither widens it nor moves the key
  let rebound = assoc(three, -1, "B")
  assert count(rebound) == 3
  assert get(rebound, -1) == Some("B")
  assert keys(rebound) == [0, -1, 4294967297]
  match rebound.root {
    NColl(_h, kids) -> { assert array_len(kids) == 3 }
    _ -> { assert false }
  }
  # removing narrows it, and the last removal collapses it to a plain leaf
  let narrowed = dissoc(three, 0)
  assert count(narrowed) == 2
  assert get(narrowed, 0) == None
  match narrowed.root {
    NColl(_h, kids) -> { assert array_len(kids) == 2 }
    _ -> { assert false }
  }
  let collapsed = dissoc(narrowed, 4294967297)
  assert count(collapsed) == 1
  match collapsed.root {
    NLeaf(_h, k, v, _s) -> {
      assert k == -1
      assert v == "b"
    }
    _ -> { assert false }
  }
  # and the one after that empties the trie
  match dissoc(collapsed, -1).root {
    NEmpty -> ()
    _ -> { assert false }
  }
}

test "a rebound key keeps its position; one that left and came back does not" {
  let m: Hamt[Int, String] = from([(0, "a"), (1, "b"), (2, "c")])
  assert keys(m) == [0, 1, 2]
  assert entries(m) == [(0, "a"), (1, "b"), (2, "c")]
  assert values(m) == ["a", "b", "c"]
  # spec 2.2: rebinding moves the value, not the key. The counter does not
  # move either, which is the mechanism.
  let rebound = assoc(m, 0, "z")
  assert keys(rebound) == [0, 1, 2]
  assert get(rebound, 0) == Some("z")
  assert count(rebound) == 3
  assert rebound.nseq == m.nseq
  # a genuinely new key goes on the end and takes the next position
  let grown = assoc(m, 9, "d")
  assert keys(grown) == [0, 1, 2, 9]
  assert grown.nseq == m.nseq + 1
  # `dissoc` keeps the counter where it is, so a key that leaves and returns
  # is a new key and lands at the end
  let gone = dissoc(m, 0)
  assert keys(gone) == [1, 2]
  assert gone.nseq == m.nseq
  assert keys(assoc(gone, 0, "z")) == [1, 2, 0]
  # removing something absent changes nothing at all
  let same = dissoc(m, 99)
  assert count(same) == 3
  assert keys(same) == [0, 1, 2]
  assert same.nseq == m.nseq
  # `from` takes the last value and the first position
  assert entries(from([(1, "a"), (2, "b"), (1, "c")])) == [(1, "c"), (2, "b")]
  # the set surface says the same thing about elements
  assert keys(sfrom([3, 1, 3, 2])) == [3, 1, 2]
  assert count(sfrom([3, 1, 3, 2])) == 3
  let s = sadd(sadd(sfrom([3, 1]), 2), 3)
  assert keys(s) == [3, 1, 2]
  assert count(s) == 3
  assert has(s, 3)
  assert not has(s, 9)
}

test "fold reaches every node shape and pays no entry list for it" {
  # empty: the init comes straight back
  let e: Hamt[Int, Int] = empty()
  assert fold(e, 42, (acc, _k, v) => acc + v) == 42
  # one leaf
  assert fold(from([(5, 50)]), 0, (acc, k, v) => acc + k + v) == 55
  # branches, more than one level deep: 100 keys spread over the low bits
  var big: Hamt[Int, Int] = empty()
  for i in 0..100 {
    big = assoc(big, i, i * 2)
  }
  assert fold(big, 0, (acc, _k, v) => acc + v) == 9900
  assert fold(big, 0, (acc, k, _v) => acc + k) == 4950
  assert fold(big, 0, (acc, _k, _v) => acc + 1) == count(big)
  # a collision node: 0 and -1 share a hash32, 4294967297 makes it three wide
  let coll: Hamt[Int, Int] = from([(0, 100), (-1, 20), (4294967297, 3)])
  match coll.root {
    NColl(_h, kids) -> { assert array_len(kids) == 3 }
    _ -> { assert false }
  }
  assert fold(coll, 0, (acc, _k, _v) => acc + 1) == 3
  assert fold(coll, 0, (acc, _k, v) => acc + v) == 123
}

test "the trie separates by five bits, and dissoc collapses only a sibling" {
  # 0 and 1 differ in the lowest five bits, so one branch separates them
  let flat: Hamt[Int, String] = from([(0, "a"), (1, "b")])
  match flat.root {
    NBranch(bm, kids) -> {
      assert bm == 3
      assert array_len(kids) == 2
    }
    _ -> { assert false }
  }
  # removing one of two leaf children collapses the branch to the survivor
  match dissoc(flat, 1).root {
    NLeaf(_h, k, _v, _s) -> { assert k == 0 }
    _ -> { assert false }
  }
  # 0 and 32 agree in the low five and differ in the next, so the trie needs
  # a second level
  let deep: Hamt[Int, String] = from([(0, "a"), (32, "b")])
  assert get(deep, 0) == Some("a")
  assert get(deep, 32) == Some("b")
  match deep.root {
    NBranch(bm, kids) -> {
      assert bm == 1
      assert array_len(kids) == 1
    }
    _ -> { assert false }
  }
  # Recorded, not fixed. Collapsing is only checked where a *sibling* was
  # removed; a child that collapsed on its own leaves its parent a
  # one-child branch. So this answers a branch holding one leaf, where the
  # two-key case above answers the leaf itself -- the same map, two shapes.
  match dissoc(deep, 32).root {
    NBranch(bm, kids) -> {
      assert bm == 1
      assert array_len(kids) == 1
    }
    _ -> { assert false }
  }
  assert count(dissoc(deep, 32)) == 1
  assert get(dissoc(deep, 32), 0) == Some("a")
  # the deepest the trie ever goes: 0 and 2^30 agree in the low thirty bits,
  # which is the last level `idx_at` can distinguish
  let deepest: Hamt[Int, String] = from([(0, "a"), (1073741824, "b")])
  assert count(deepest) == 2
  assert get(deepest, 0) == Some("a")
  assert get(deepest, 1073741824) == Some("b")
  # a key whose hash has the sign bit set: `hash` is a 32-bit signed value, so
  # this one is negative until `hash32` masks it back. Nothing else covers it.
  let signed: Hamt[Int, String] = from([(2147483648, "a"), (0, "b")])
  assert count(signed) == 2
  assert get(signed, 2147483648) == Some("a")
  assert get(signed, 0) == Some("b")
  assert keys(signed) == [2147483648, 0]
}

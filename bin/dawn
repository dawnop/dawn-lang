#!/bin/sh
# dawn CLI launcher: the self-hosted toolchain, seeded from the previous
# release (M8 phase 5 — the Kotlin implementation is archived at the
# kotlin-final tag). In a repo checkout the standalone jar under build/ is
# rebuilt whenever any of its inputs changed (see stamp_inputs); outside one
# (the playground server rsyncs bin/ + build/) it just runs the shipped jar.
set -e

# Resolve symlinks (e.g. ~/.local/bin/dawn) so ROOT is the real repo checkout.
#
# Hop by hop rather than `readlink -f`: BSD readlink, which is what macOS ships,
# has no -f, so the one-liner failed on the exact platform the JAVA_HOME probe
# below goes out of its way to support. `readlink` with no options plus cd/pwd
# -P is portable, and handles a relative link target (the common case for a
# hand-made ~/.local/bin symlink).
SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in
    /*) SELF=$link ;;
    *) SELF=$(dirname "$SELF")/$link ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"

# if JAVA_HOME is unset, try GraalVM under ~/tools. Both layouts: macOS bundles
# the JDK under Contents/Home, Linux tarballs put bin/ at the top level.
if [ -z "$JAVA_HOME" ]; then
  for d in "$HOME"/tools/graalvm-*/Contents/Home "$HOME"/tools/graalvm-*; do
    if [ -x "$d/bin/java" ]; then
      JAVA_HOME="$d"
      export JAVA_HOME
      break
    fi
  done
fi
JAVA=java
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA="$JAVA_HOME/bin/java"
fi

SJAR="$ROOT/build/dawn-selfhost.jar"
STD="$ROOT/std"

# Heap: pinned, not left to JVM ergonomics. With no -Xmx the ceiling is
# MaxRAMPercentage=25% of the HOST's RAM, which makes "how much memory does a
# build need" a property of the machine instead of a property of the workload.
# Measured 2026-08-05: the same build got a 3.79 GiB ceiling on a 16 GiB box
# and 5.87 GiB on a 24 GiB one -- the latter is 98% of the 6 GiB cgroup builds
# run in here, leaving ~160 MiB for metaspace, code cache and the 512m stacks.
# UseContainerSupport is on but does NOT see that cgroup: MaxHeapSize measured
# identical inside and outside it, so the cgroup is not a backstop either.
#
# 2g is roughly 10x what a full selfhost build needs. Measured on 57 files /
# 54,179 lines: it completes at -Xmx192m with 577 MB peak RSS, and peak RSS
# tracks the ceiling rather than the workload (1.89 GiB at the default ceiling,
# 1.24 GiB at 2g, 829 MB at 768m) -- a smaller heap was also consistently
# faster. Deliberately not pinned near that floor: a limit set where it barely
# passes goes red on the next corpus growth, and reads as a compiler bug.
# Override for the genuinely heavy scripts, e.g. DAWN_JVM_OPTS="-Xss512m -Xmx6g".
DAWN_JVM_OPTS="${DAWN_JVM_OPTS:--Xss512m -Xmx2g}"

# deployed form: no sources, no seed resolver — run the shipped jar as-is
if [ ! -f "$ROOT/scripts/seedjar.sh" ]; then
  if [ ! -f "$SJAR" ]; then
    echo "error: $SJAR not found (deployments must ship build/dawn-selfhost.jar)" >&2
    exit 2
  fi
  exec "$JAVA" $DAWN_JVM_OPTS -jar "$SJAR" "$@"
fi

. "$ROOT/scripts/seedjar.sh"

# What the jar was built from, as a content hash rather than a timestamp.
#
# `find -newer "$SJAR"` was the old test, and mtime does not answer the question
# it was asked. A fresh clone, a tarball extract, a `git checkout` of an older
# branch, a restored backup or a copied build/ all produce sources that are
# *older* than a jar built from different code — and then every later command
# silently runs a stale compiler. That failure is invisible: the toolchain works,
# it is simply not the one the sources describe.
#
# The hash covers the inputs the build reads -- `stamp_inputs` below is the
# list, and getting that list wrong is the same failure in a different place --
# so it changes exactly when the output should. Reading ~2MB costs a few
# milliseconds against a multi-second build.
STAMP="$ROOT/build/dawn-selfhost.stamp"

if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
  sha256() { shasum -a 256 | cut -d' ' -f1; }
else
  # No hasher: fall back to the old mtime heuristic rather than refusing to run.
  sha256() { cat >/dev/null; echo "no-sha256"; }
fi

# Convert the Planner's versioned source-input protocol into typed absolute
# inputs. Only the first two tabs delimit fields, so tabs in paths survive.
# Parse into a temporary file before exposing anything to the stamp consumer:
# a malformed late record must not become a valid-looking partial manifest.
source_manifest_inputs() {
  manifest_file=$1
  tab=$(printf '\t')
  record_count=0
  last_byte=$(tail -c 1 "$manifest_file") || {
    echo "error: cannot read source input manifest" >&2
    return 1
  }
  if [ -n "$last_byte" ]; then
    echo "error: source input manifest record is not newline-terminated" >&2
    return 1
  fi
  {
    if ! IFS= read -r header; then
      echo "error: source input manifest is empty" >&2
      return 1
    fi
    if [ "$header" != "dawn-source-inputs-v1" ]; then
      echo "error: invalid source input manifest header" >&2
      return 1
    fi
    while IFS= read -r record || [ -n "$record" ]; do
      if [ -z "$record" ]; then
        echo "error: malformed source input manifest record" >&2
        return 1
      fi
      case $record in
        *"$tab"*) scope=${record%%"$tab"*}; rest=${record#*"$tab"} ;;
        *)
          echo "error: malformed source input manifest record" >&2
          return 1
          ;;
      esac
      case $rest in
        *"$tab"*) kind=${rest%%"$tab"*}; path=${rest#*"$tab"} ;;
        *)
          echo "error: malformed source input manifest record" >&2
          return 1
          ;;
      esac
      case $kind in
        F|O|T) ;;
        *)
          echo "error: unknown source input manifest kind: $kind" >&2
          return 1
          ;;
      esac
      case $scope in
        R)
          case $path in
            ".") path="$ROOT" ;;
            ""|/*|./*|../*|*/.|*/./*|..|*/..|*/../*|*//*|*/)
              echo "error: invalid repo-relative source input path" >&2
              return 1
              ;;
            *) path="$ROOT/$path" ;;
          esac
          case $ROOT in
            /) ;;
            *)
              case $path in
                "$ROOT"|"$ROOT"/*) ;;
                *)
                  echo "error: repo-relative source input escapes the repository" >&2
                  return 1
                  ;;
              esac
              ;;
          esac
          ;;
        A)
          case $path in
            "/") ;;
            /*)
              case $path in
                *//*|*/.|*/./*|*/..|*/../*|*/)
                  echo "error: non-canonical absolute source input path" >&2
                  return 1
                  ;;
              esac
              ;;
            *)
              echo "error: invalid absolute source input path" >&2
              return 1
              ;;
          esac
          ;;
        *)
          echo "error: unknown source input manifest scope: $scope" >&2
          return 1
          ;;
      esac
      printf '%s\t%s\n' "$kind" "$path" || return 1
      record_count=$((record_count + 1))
    done
  } < "$manifest_file"
  if [ "$record_count" -eq 0 ]; then
    echo "error: source input manifest has no records" >&2
    return 1
  fi
}

# The no-toolchain bootstrap fallback understands the local path-dependency
# shape used by this checkout. It is recursive, so compiler-plan and its own
# fspath/sha2/inflate dependencies cannot disappear from the first stamp. An
# unfamiliar [deps] entry or an implausibly deep graph fails closed; once a
# current jar exists, the Planner producer above is authoritative instead.
manifest_local_deps() {
  awk '
    /^[[:space:]]*\[deps\.[^][]+\][[:space:]]*$/ {
      bad = 1
      in_deps = 0
      next
    }
    /^[[:space:]]*\[deps\][[:space:]]*$/ { in_deps = 1; next }
    /^[[:space:]]*\[/ { in_deps = 0 }
    in_deps {
      line = $0
      if (line ~ /^[[:space:]]*($|#)/) next
      if (line !~ /^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=[[:space:]]*"/) {
        bad = 1
        next
      }
      sub(/^[^"]*"/, "", line)
      if (line !~ /"/) {
        bad = 1
        next
      }
      sub(/".*/, "", line)
      print line
    }
    END { if (bad) exit 1 }
  ' "$1"
}

fallback_source_inputs() (
  depth=$1
  package_dir=$2
  if [ "$depth" -gt 64 ]; then
    echo "error: local source dependency graph exceeds bootstrap fallback depth" >&2
    exit 1
  fi
  manifest="$package_dir/dawn.toml"
  printf 'F\t%s\nO\t%s\nT\t%s\n' \
    "$manifest" "$package_dir/dawn.lock" "$package_dir/src"
  deps=$(manifest_local_deps "$manifest") || exit 1
  printf '%s\n' "$deps" |
    while IFS= read -r dep; do
      [ -n "$dep" ] || continue
      case $dep in
        /*)
          echo "error: absolute local source dependency is unsupported during bootstrap: $dep" >&2
          exit 1
          ;;
        *) candidate=$package_dir/$dep ;;
      esac
      dep_dir=$(CDPATH= cd "$candidate" 2>/dev/null && pwd -P) || {
        echo "error: local source dependency does not exist: $candidate" >&2
        exit 1
      }
      case $ROOT in
        /) ;;
        *)
          case $dep_dir in
            "$ROOT"|"$ROOT"/*) ;;
            *)
              echo "error: local source dependency escapes the checkout: $candidate" >&2
              exit 1
              ;;
          esac
          ;;
      esac
      fallback_source_inputs $((depth + 1)) "$dep_dir" || exit 1
    done
)

source_inputs() (
  manifest_file=
  parsed_file=
  cleanup_source_inputs() {
    [ -z "$manifest_file" ] || rm -f "$manifest_file"
    [ -z "$parsed_file" ] || rm -f "$parsed_file"
  }
  trap cleanup_source_inputs 0
  trap 'exit 1' 1 2 15
  if [ ! -e "$SJAR" ] && [ ! -L "$SJAR" ]; then
    fallback_source_inputs 0 "$ROOT/selfhost"
    return
  fi

  manifest_file=$(mktemp "${TMPDIR:-/tmp}/dawn-source-manifest.XXXXXX") || {
    echo "error: cannot create source input manifest temporary file" >&2
    return 1
  }
  parsed_file=$(mktemp "${TMPDIR:-/tmp}/dawn-source-inputs.XXXXXX") || {
    rm -f "$manifest_file"
    echo "error: cannot create source input list temporary file" >&2
    return 1
  }
  if ! "$JAVA" $DAWN_JVM_OPTS -jar "$SJAR" \
      __source-inputs --base "$ROOT" "$ROOT/selfhost" > "$manifest_file"; then
    echo "error: current toolchain failed to produce source input manifest" >&2
    return 1
  fi
  if [ ! -s "$manifest_file" ]; then
    echo "error: current toolchain produced an empty source input manifest" >&2
    return 1
  fi
  if ! source_manifest_inputs "$manifest_file" > "$parsed_file"; then
    return 1
  fi
  if ! cat "$parsed_file"; then
    return 1
  fi
)

# Everything the built jar is a function of.
#
# dawn.lock pins the resolved [java-deps] closure, seed-checksums.txt decides
# which seed is trusted, seedjar.sh resolves it, and this script is the recipe
# -- change any of them and the jar that comes out is a different jar, or
# should have been. Withdrawing trust from a seed used not to trigger a
# rebuild at all.
stamp_inputs() {
  printf 'T\t%s\nF\t%s\nF\t%s\nF\t%s\nF\t%s\nF\t%s\n' \
    "$STD" \
    "$ROOT/scripts/seed-release.txt" \
    "$ROOT/scripts/seed-checksums.txt" \
    "$ROOT/scripts/seed-std-checksums.txt" \
    "$ROOT/scripts/seedjar.sh" \
    "$ROOT/bin/dawn"
  source_inputs
}

source_stamp() (
  # -print0/-exec sort would need GNU find; LC_ALL fixes the collation so the
  # same tree hashes the same on every machine.
  input_file=$(mktemp "${TMPDIR:-/tmp}/dawn-stamp-inputs.XXXXXX") || exit 1
  file_list=$(mktemp "${TMPDIR:-/tmp}/dawn-stamp-files.XXXXXX") || {
    rm -f "$input_file"
    exit 1
  }
  tree_list=$(mktemp "${TMPDIR:-/tmp}/dawn-stamp-tree.XXXXXX") || {
    rm -f "$input_file" "$file_list"
    exit 1
  }
  sorted_list=$(mktemp "${TMPDIR:-/tmp}/dawn-stamp-sorted.XXXXXX") || {
    rm -f "$input_file" "$file_list" "$tree_list"
    exit 1
  }
  payload=$(mktemp "${TMPDIR:-/tmp}/dawn-stamp-payload.XXXXXX") || {
    rm -f "$input_file" "$file_list" "$tree_list" "$sorted_list"
    exit 1
  }
  trap 'rm -f "$input_file" "$file_list" "$tree_list" "$sorted_list" "$payload"' 0
  trap 'exit 1' 1 2 15
  if ! stamp_inputs > "$input_file"; then
    exit 1
  fi

  tab=$(printf '\t')
  while IFS= read -r record || [ -n "$record" ]; do
    case $record in
      *"$tab"*) kind=${record%%"$tab"*}; path=${record#*"$tab"} ;;
      *)
        echo "error: malformed typed stamp input" >&2
        exit 1
        ;;
    esac
    if [ -z "$path" ]; then
      echo "error: stamp input path is empty" >&2
      exit 1
    fi
    case $kind in
      F)
        if [ -L "$path" ] || [ ! -f "$path" ]; then
          echo "error: required stamp input is not a regular non-symbolic-link file: $path" >&2
          exit 1
        fi
        printf '%s\n' "$path" >> "$file_list" || exit 1
        ;;
      O)
        if [ -L "$path" ]; then
          echo "error: optional stamp input is a symbolic link: $path" >&2
          exit 1
        fi
        if [ -e "$path" ]; then
          if [ ! -f "$path" ]; then
            echo "error: optional stamp input is not a regular file: $path" >&2
            exit 1
          fi
          printf '%s\n' "$path" >> "$file_list" || exit 1
        fi
        ;;
      T)
        if [ -L "$path" ] || [ ! -d "$path" ]; then
          echo "error: required stamp input is not a non-symbolic-link directory tree: $path" >&2
          exit 1
        fi
        if ! find "$path" -type l -print -quit > "$tree_list"; then
          echo "error: cannot traverse stamp input tree: $path" >&2
          exit 1
        fi
        if [ -s "$tree_list" ]; then
          tree_entry=$(sed -n '1p' "$tree_list")
          echo "error: stamp input tree contains a symbolic link: $tree_entry" >&2
          exit 1
        fi
        if ! find "$path" ! -type d ! -type f ! -type l -print -quit > "$tree_list"; then
          echo "error: cannot traverse stamp input tree: $path" >&2
          exit 1
        fi
        if [ -s "$tree_list" ]; then
          tree_entry=$(sed -n '1p' "$tree_list")
          echo "error: stamp input tree contains a non-regular entry: $tree_entry" >&2
          exit 1
        fi
        if ! find "$path" -type f -print > "$tree_list"; then
          echo "error: cannot traverse stamp input tree: $path" >&2
          exit 1
        fi
        while IFS= read -r tree_file || [ -n "$tree_file" ]; do
          if [ -L "$tree_file" ] || [ ! -f "$tree_file" ]; then
            echo "error: stamp input tree entry is not a regular non-symbolic-link file: $tree_file" >&2
            exit 1
          fi
          printf '%s\n' "$tree_file" >> "$file_list" || exit 1
        done < "$tree_list"
        ;;
      *)
        echo "error: unknown typed stamp input kind: $kind" >&2
        exit 1
        ;;
    esac
  done < "$input_file"

  if ! LC_ALL=C sort -u "$file_list" > "$sorted_list"; then
    echo "error: cannot sort stamp inputs" >&2
    exit 1
  fi
  while IFS= read -r file || [ -n "$file" ]; do
    if [ -L "$file" ] || [ ! -f "$file" ]; then
      echo "error: stamp input changed type before it could be read: $file" >&2
      exit 1
    fi
    if ! printf '%s\n' "$file" >> "$payload" || ! cat "$file" >> "$payload"; then
      echo "error: cannot read stamp input: $file" >&2
      exit 1
    fi
  done < "$sorted_list"
  if ! sha256 < "$payload"; then
    echo "error: cannot hash stamp inputs" >&2
    exit 1
  fi
)

stamp_inputs_are_newer() (
  input_file=$(mktemp "${TMPDIR:-/tmp}/dawn-newer-inputs.XXXXXX") || exit 2
  match_file=$(mktemp "${TMPDIR:-/tmp}/dawn-newer-match.XXXXXX") || {
    rm -f "$input_file"
    exit 2
  }
  trap 'rm -f "$input_file" "$match_file"' 0
  trap 'exit 2' 1 2 15
  if ! stamp_inputs > "$input_file"; then
    exit 2
  fi
  tab=$(printf '\t')
  while IFS= read -r record || [ -n "$record" ]; do
    case $record in
      *"$tab"*) kind=${record%%"$tab"*}; path=${record#*"$tab"} ;;
      *)
        echo "error: malformed typed stamp input" >&2
        exit 2
        ;;
    esac
    case $kind in
      O)
        if [ ! -e "$path" ] && [ ! -L "$path" ]; then
          continue
        fi
        ;;
      F|T) ;;
      *)
        echo "error: unknown typed stamp input kind: $kind" >&2
        exit 2
        ;;
    esac
    if ! find "$path" -type f -newer "$SJAR" -print -quit > "$match_file"; then
      echo "error: cannot check stamp input modification time: $path" >&2
      exit 2
    fi
    if [ -s "$match_file" ]; then
      exit 0
    fi
  done < "$input_file"
  exit 1
)

WANT="$(source_stamp)"

# The stamp is the only thing that decides whether a rebuild happens, and it is
# otherwise unobservable: a missing input looks exactly like an input that did
# not change. scripts/bootstrap-guards/run.sh reads it here and moves one file
# at a time.
if [ -n "${DAWN_PRINT_STAMP:-}" ]; then
  printf '%s\n' "$WANT"
  exit 0
fi

needs_build=0
if [ ! -f "$SJAR" ]; then
  needs_build=1
elif [ "$WANT" = "no-sha256" ]; then
  if stamp_inputs_are_newer; then
    needs_build=1
  else
    newer_status=$?
    if [ "$newer_status" -ne 1 ]; then
      exit "$newer_status"
    fi
  fi
elif [ ! -f "$STAMP" ] || [ "$WANT" != "$(cat "$STAMP")" ]; then
  needs_build=1
fi

# Two stages, not one: the seed builds A from today's sources, and then A
# builds the jar we keep.
#
# The reason is that a built jar carries the *runtime* classes (dawn/rt/Io and
# friends) emitted by whichever compiler did the building. A is today's sources
# linked against the previous release's runtime, and that pair only holds while
# the runtime contract has not moved. When it moves, A compiles fine and dies
# at run time: the error-model migration changed what dawn/rt/Io.catch_fault
# puts in an `Err`, and A -- today's call sites, last release's barrier --
# threw a ClassCastException at every failure path, including `use java` on a
# nested class, which is two in-repo targets. Nothing in the build said a word.
#
# The second stage costs one more compile (~5s here) and makes the jar
# self-consistent: sources and runtime from the same tree. It is the same B the
# fixpoint gate builds, and the property `dawn` should have had all along --
# selfhost-fixpoint.sh only ever promised B == C, and this script was shipping
# A. Stage 1 still has to succeed, which is the seed feature discipline
# selfhost-prev-diff.sh asserts separately.
if [ "$needs_build" = 1 ]; then
  SEED="$(seed_jar)"
  # the .jar suffix is load-bearing: `--vendor` copies classes off
  # java.class.path and the scan only opens entries that end in .jar
  STAGE1="$ROOT/build/dawn-selfhost.stage1.jar"
  echo "dawn: rebuilding the selfhost toolchain (sources changed)..." >&2
  mkdir -p "$ROOT/build"
  # stage 1 pairs the seed with the std it released with (seed_std_dir), not
  # today's std/: since #44 knife 2 the repo std may use prelude machinery one
  # generation ahead of the seed's checker. Stage 2 checks today's std with
  # today's compiler, so nothing in the final jar escapes the current checker.
  #
  # A plain assignment, not a substitution in argument position: there the
  # helper's failure is swallowed and the seed silently builds with --std ''.
  # As an assignment, set -e makes the failure fatal here too.
  SEED_STD=$(seed_std_dir)
  "$JAVA" $DAWN_JVM_OPTS -jar "$SEED" build "$ROOT/selfhost" -o "$STAGE1" \
    --std "$SEED_STD" \
    --vendor org/objectweb/asm --vendor coursierapi > /dev/null
  "$JAVA" $DAWN_JVM_OPTS -jar "$STAGE1" build "$ROOT/selfhost" -o "$SJAR.tmp" \
    --std "$STD" \
    --vendor org/objectweb/asm --vendor coursierapi > /dev/null
  rm -f "$STAGE1"
  mv "$SJAR.tmp" "$SJAR"
  # written only after the jar is in place, so an interrupted build reruns
  printf '%s\n' "$WANT" > "$STAMP"
fi

exec "$JAVA" $DAWN_JVM_OPTS -jar "$SJAR" "$@"

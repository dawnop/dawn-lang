# cx.dawn: an opaque type is as serializable as its target, except where the
# target is a position in the backend's own representation of a string. A
# folded Cursor would be a UTF-16 offset, a UTF-8 offset and a code-point index
# depending on who reads it, and Core is read by all three (SEM-04).
use std/cursor
use std/cursor.{Cursor}

const C: Cursor = cursor.start("")
const CS: List[Cursor] = []
const PAIR: (Int, Cursor) = (0, cursor.start(""))

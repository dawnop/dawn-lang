# Constant-serializability is a question about the representation, so an
# opaque type is exactly as const-able as its target. It was not: the match
# had no TyOpaque arm and ended `_ -> false`.
#
# Rendering goes through the target explicitly (`raw`/`text` below): since
# 2026-09-24 an opaque type inherits no `Show` from its target (spec 2.7), so
# the two spellings no longer render alike and rendering is not part of the
# twin property. What the case is about is unchanged.
use std/io

opaque type Meters = Int
opaque type Name = String

const D: Meters = 3
const LABEL: Name = "north"
# built from the constants above, not from literals: converting `3` to a
# `Meters` inside a tuple or list literal would be a conversion in the middle
# of an expression, which spec 2.7 does not do
const PAIR: (Meters, Name) = (D, LABEL)
const LEGS: List[Meters] = [D, D]

fn raw(m: Meters) -> Int = m

fn text(n: Name) -> String = n

pub fn main() -> Unit !io = {
  println(to_string(raw(D)))
  println(to_string(text(LABEL)))
  match PAIR {
    (a, b) -> println("${raw(a)} ${text(b)}")
  }
  println(to_string(len(LEGS)))
}

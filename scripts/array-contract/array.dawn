# The `Array` contract, exercised from the only place that may name it.
#
# `Array` and the `array_*` intrinsics are std-internal (docs/native-backend-plan.md
# D1), so this file is dropped into a copy of std/ rather than sitting in
# examples/. It is the one place the primitive is covered end to end until D2/D3
# make std's own collections go through it.
# No `use java` here: this file rides into a std/ copy, and std modules are
# checked against the refusing signature oracle -- std may not touch Java,
# and since seam 1 that is machine-enforced. The clock therefore lives in
# probe.dawn, which compiles as a user program under the real toolchain.
use std/bytes

fn render(a: Array[Int]) -> String = {
  var s = ""
  var i = 0
  while i < array_len(a) {
    if i > 0 { s = s ++ "," }
    s = s ++ "${array_get(a, i)}"
    i = i + 1
  }
  "[" ++ s ++ "]"
}

## The accumulation loop: each push extends the version the last one returned,
## so every one of them may claim the frontier slot in place.
fn build(n: Int) -> Array[Int] = {
  var a: Array[Int] = array_new()
  var i = 0
  while i < n {
    a = array_push(a, i)
    i = i + 1
  }
  a
}

## The opposite shape: every push forks from the same published version, so at
## most one can claim the slot and the rest copy. Returned as a checksum so the
## work cannot be optimized away.
fn fork_push(base: Array[Int], n: Int) -> Int = {
  var acc = 0
  var i = 0
  while i < n {
    acc = acc + array_len(array_push(base, i))
    i = i + 1
  }
  acc
}

## Value semantics: no operation is observably destructive, whatever the
## backend does underneath.
pub fn values() -> List[String] = {
  var a: Array[Int] = array_new()
  var i = 0
  while i < 6 {
    a = array_push(a, i * 10)
    i = i + 1
  }
  let b = array_with(a, 2, 999)
  let p = array_push(a, 1)
  let q = array_push(a, 2)
  let long = build(40)
  # `array_steal` on a shared array: the read answers the value and the
  # version it came from keeps every element -- whatever the backend's
  # unique-path transfer does, sharing must make it a plain read.
  let s = array_steal(a, 2)
  [
    "built    ${render(a)} len=${array_len(a)}",
    "with     ${render(b)}",
    "original ${render(a)}",
    "steal    got=${s} original=${render(a)}",
    "fork     ${render(p)} / ${render(q)}",
    "grow     len=${array_len(long)} last=${array_get(long, 39)}",
    "popcount ${popcount(0)} ${popcount(7)} ${popcount(255)}"
  ]
}

## One half of the workload the probe times: the accumulation shape, where
## every push may extend in place. The check runs inside so the work cannot
## be optimized away; the caller holds the clock (user code cannot name
## `Array`, so the workload cannot be handed out for timing).
pub fn linear_build(n: Int) -> Unit = {
  let big = build(n)
  if array_len(big) != n { panic("build lost elements") }
}

## The other half: every push forks the same published version, quadratic by
## construction. Building the base is n linear pushes -- noise against the
## quadratic signal, so it stays inside the timed window.
pub fn forked_sum(n: Int) -> Unit = {
  let base = build(n)
  let acc = fork_push(base, n)
  if acc != n * (n + 1) { panic("fork_push checksum") }
}

## Out of bounds panics rather than reading a neighbouring version's slot.
pub fn out_of_bounds() -> String !io = {
  let a = build(3)
  match catch_panic(() => array_get(a, 3)) {
    Ok(_) -> "no panic"
    Err(m) -> m.message
  }
}

## `bytes_pack_int` at width 1 -- the one way to make bytes that did not come from text.
## It lives here rather than in a spike corpus for the same reason the rest of
## this module does: its argument type is std-only, so no user program can
## build one to hand it.
##
## The values above 127 are the point. `Bytes` could always be *read*, and a
## byte read back as 0..255 is not evidence: what had no spelling at all was a
## byte the caller computed, and 0x80 is the one a UTF-8 round trip destroys.
pub fn from_array() -> String = {
  var a: Array[Int] = array_new()
  for v in [0, 1, 65, 127, 128, 200, 254, 255] {
    a = array_push(a, v)
  }
  let b = bytes_pack_int(a, 1, true)
  var out = "len=" ++ to_string(bytes.len(b))
  var i = 0
  while i < bytes.len(b) {
    out = out ++ " " ++ to_string(bytes.at(b, i))
    i = i + 1
  }
  let empty: Array[Int] = array_new()
  out ++ " empty=" ++ to_string(bytes.len(bytes_pack_int(empty, 1, true)))
}

## `array_extend` and `array_slice`, the bulk pair (docs/bulk-array-bytes-design.md).
## Every line is the answer value semantics has to give, written before either
## backend was asked: the inputs are never changed, two extends of one base
## each see only their own tail, and extending an array by itself doubles it.
pub fn bulk() -> List[String] = {
  let a = build(3)
  var b: Array[Int] = array_new()
  b = array_push(b, 10)
  b = array_push(b, 20)
  let none: Array[Int] = array_new()
  let ab = array_extend(a, b)
  # two extends of one published base: one may win the in-place claim, the
  # other must copy, and neither may show the other's tail
  let p = array_extend(a, b)
  let q = array_extend(a, array_extend(b, b))
  let aa = array_extend(a, a)
  # a slice is its own array: pushing onto it leaves the source alone
  let mid = array_slice(ab, 1, 4)
  let grown = array_push(mid, 99)
  [
    "extend   ${render(ab)} a=${render(a)} b=${render(b)}",
    "twotails ${render(p)} / ${render(q)}",
    "self     ${render(aa)}",
    "edges    ${render(array_extend(a, none))} ${render(array_extend(none, b))} ${render(array_extend(none, none))}",
    "slice    ${render(array_slice(ab, 1, 4))} ${render(array_slice(ab, 0, 5))} ${render(array_slice(ab, 5, 5))} ${render(array_slice(ab, 0, 0))}",
    "grown    ${render(grown)} mid=${render(mid)} ab=${render(ab)}",
    "chunks   ${chunked(1000, 7)}"
  ]
}

## 1000 elements accumulated 7 at a time through `array_extend` must come back
## as 0..999 in order: the in-place path, the copying path and the capacity
## growth all run on the way.
fn chunked(n: Int, step: Int) -> String = {
  var out: Array[Int] = array_new()
  var i = 0
  while i < n {
    var chunk: Array[Int] = array_new()
    var j = i
    while j < n && j < i + step {
      chunk = array_push(chunk, j)
      j = j + 1
    }
    out = array_extend(out, chunk)
    i = i + step
  }
  var ok = array_len(out) == n
  var k = 0
  while k < n {
    if array_get(out, k) != k { ok = false }
    k = k + 1
  }
  "ok=${ok} len=${array_len(out)}"
}

## The accumulation shape for `array_extend`, for the clock in probe.dawn:
## blocks of 32 appended to one growing array, the way `pvec.to_array` does.
pub fn extend_linear(n: Int) -> Unit = {
  var block: Array[Int] = array_new()
  var i = 0
  while i < 32 {
    block = array_push(block, i)
    i = i + 1
  }
  var out: Array[Int] = array_new()
  var done = 0
  while done < n {
    out = array_extend(out, block)
    done = done + 32
  }
  if array_len(out) != done { panic("extend lost elements") }
}

## The ranges `array_slice` refuses. Each is a panic, never a clamp, and the
## message names the range and the length -- the same words on both backends.
pub fn slice_panics() -> List[String] !io = {
  let a = build(3)
  var out: List[String] = []
  for (f, t) in [(-1, 2), (0, 4), (2, 1), (4, 5), (3, 4)] {
    match catch_panic(() => array_slice(a, f, t)) {
      Ok(_) -> { out = out ++ ["no panic for [${f}, ${t})"] }
      Err(m) -> { out = out ++ [m.message] }
    }
  }
  out
}

# checker.dawn: rule R1 reaches a buffer through a tuple and through a type
# argument (N2). Looking only at the outermost constructor would pass both.
use std/mem

pub fn in_tuple() -> (Int, I64Buf) = mem.with_mem(() => (1, mem.new(4)))

pub fn in_option() -> Option[I64Buf] = mem.with_mem(() => Some(mem.new(4)))

pub fn in_list() -> List[I64Buf] = mem.with_mem(() => [mem.new(4)])

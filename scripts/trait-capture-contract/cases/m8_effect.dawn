# Explicit contracts exercise data introduction and nominal boundaries.
use std/mem
use std/mem.{Mem}
type ReadAt[@s] = { read: fn(I64Buf@s) -> Int !Mem[s] }
fn attempted() !io = mem.with_mem([@s] () => { let x: ReadAt[s] = ReadAt { read = (b: I64Buf@s) => mem.at(b, 0) }
  x })
pub fn main() -> Unit !io = println("probe")

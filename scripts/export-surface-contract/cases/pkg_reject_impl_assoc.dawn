# An impl the world cannot observe (its trait is package-private) is still
# observable to the package, so its associated binding answers to the package
# and may not be module-private.
type Secret = Secret

pub type Open = { k: Int }

pub(pkg) trait HasItem[T] {
  type Item
  fn item(x: T) -> T.Item
}

impl HasItem[Open] {
  type Item = List[Secret]
  fn item(x: Open) -> List[Secret] = []
}

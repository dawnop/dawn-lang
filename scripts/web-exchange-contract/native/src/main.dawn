# The native side of the web exchange contract: the application of
# contract_app served through web/exchange over stdin and stdout, one request
# per process, which is the shape the native services run in.
#
# The wire is stdout and stdin through web/exchange.stdio_transport, which
# writes raw bytes and flushes them (std/io.write_stdout, flush_stdout).
use std/io.{read_stdin, stdin_ready}
use web/exchange.{ExchangeConfig, serve_exchange, stdio_transport}
use contract_app/app.{routes, middleware, errors, MAX_BODY}

# Take what has already arrived and drop it, without waiting, so that exiting
# with an unread body does not turn the close into a reset that eats the
# response the peer has not read yet.
fn drain() -> Unit !io = {
  var more = true
  while more {
    if stdin_ready(0) {
      if len(read_stdin(4096)) == 0 { more = false }
    } else {
      more = false
    }
  }
}

pub fn main() -> Unit !io = {
  serve_exchange(ExchangeConfig { max_body: MAX_BODY, errors: errors() }, routes(), middleware(), stdio_transport())
  drain()
}

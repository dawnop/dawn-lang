## Operations on the persistent `List`: mapping, folding, searching,
## sorting, and the quantifiers. `map`, `filter`, `fold` and the sort
## family are in the prelude and need no `use`.
#
# These are the "layer 2" of docs/pure-ffi-design.md section 3.3: ordinary Dawn
# recursion over the primitives that must stay in the compiler. Nothing here
# needs `unsafe_pure` — and it could not use it anyway, since these functions
# are effect-polymorphic and the stamp deliberately refuses to mask an effect
# variable. That refusal is what pushed the higher-order functions onto this
# path in the first place.
#
# The accumulator helpers are module-level rather than local functions because a
# local function may not declare an effect variable (spec section 3.1). Each is
# self-tail-recursive, which the compiler turns into a loop, and appends with
# `++`, which is O(1) amortized on the list representation (spec section 2.2) —
# without that, every one of these would be quadratic.

# ---- iteration ----
#
# Everything that walks a whole list, here and in the compiler, goes through
# the impl below. `for x in xs` desugars to the same four methods (lower.dawn's
# lower_for_iter, #44 knife 2) rather than to an index loop, and so does every
# sequential helper in this file — the unqualified `iter_*` calls resolve to
# the prelude trait's methods and devirtualise straight back here.
#
# The difference is not style: an index walk hardwires "this collection can be
# randomly indexed", which costs nothing on today's flat representation and
# O(log n) on the tree D3 replaces it with — measured 8-18x slower and widening
# with n. Behind a cursor, the representation changes and its callers do not.
#
# A cursor is an index today because the representation is flat. When it stops
# being flat, `Cur` and these four bodies change and nothing else does.

alias Cur = Int

impl[T] Iter[List[T]] {
  type Cur = Int
  type Item = T

  fn iter_start(xs: List[T]) -> Int = 0
  fn iter_done(xs: List[T], c: Int) -> Bool = c >= len(xs)
  fn iter_next(xs: List[T], c: Int) -> Int = c + 1
  fn iter_get(xs: List[T], c: Int) -> T = xs[c]
}

# ---- queries ----

## Whether `xs` has no elements. The prelude answers "how many" (`len`) for
## every container; this is the other half, spelled the same way for all of
## them (CONTRIBUTING §naming). It asks the cursor rather than comparing a
## count, so it stays O(1) on a representation whose length is not.
pub fn is_empty[T](xs: List[T]) -> Bool = iter_done(xs, iter_start(xs))

# ---- sequential walks ----

fn map_go[T, U](xs: List[T], f: fn(T) -> U !e, c: Cur, acc: List[U]) -> List[U] !e =
  if iter_done(xs, c) { acc }
  else { map_go(xs, f, iter_next(xs, c), acc ++ [f(iter_get(xs, c))]) }

## `f` applied to every element, in order.
pub fn map[T, U](xs: List[T], f: fn(T) -> U !e) -> List[U] !e = {
  let empty: List[U] = []
  map_go(xs, f, iter_start(xs), empty)
}

fn filter_go[T](xs: List[T], f: fn(T) -> Bool !e, c: Cur, acc: List[T]) -> List[T] !e =
  if iter_done(xs, c) { acc }
  else {
    let x = iter_get(xs, c)
    filter_go(xs, f, iter_next(xs, c), if f(x) { acc ++ [x] } else { acc })
  }

## The elements satisfying `f`, in order.
pub fn filter[T](xs: List[T], f: fn(T) -> Bool !e) -> List[T] !e = {
  let empty: List[T] = []
  filter_go(xs, f, iter_start(xs), empty)
}

fn fold_go[T, A](xs: List[T], f: fn(A, T) -> A !e, c: Cur, acc: A) -> A !e =
  if iter_done(xs, c) { acc }
  else { fold_go(xs, f, iter_next(xs, c), f(acc, iter_get(xs, c))) }

## Reduce from the left: `f(f(f(init, x0), x1), ...)`.
pub fn fold[T, A](xs: List[T], init: A, f: fn(A, T) -> A !e) -> A !e =
  fold_go(xs, f, iter_start(xs), init)

fn find_go[T](xs: List[T], pred: fn(T) -> Bool !e, c: Cur) -> Option[T] !e =
  if iter_done(xs, c) { None }
  else {
    let x = iter_get(xs, c)
    if pred(x) { Some(x) } else { find_go(xs, pred, iter_next(xs, c)) }
  }

## The first element satisfying `pred`, or `None`.
pub fn find[T](xs: List[T], pred: fn(T) -> Bool !e) -> Option[T] !e =
  find_go(xs, pred, iter_start(xs))

# ---- membership and quantifiers ----
#
# Each of these stops at the first element that settles the question. `fold`
# cannot: it is defined to visit every element, so an `any` written as a fold
# over `||` is a full walk wearing a short-circuit's name -- six of those were
# in the tree, next to 31 `||` chains asking whether a constant was in a set of
# three and 32 hand-written `var found = false` loops.
#
# They walk with the same four-function cursor everything else here does, so
# "stops early" survives the representation change D3 makes.

fn any_go[T](xs: List[T], f: fn(T) -> Bool !e, c: Cur) -> Bool !e =
  if iter_done(xs, c) { false }
  else if f(iter_get(xs, c)) { true }
  else { any_go(xs, f, iter_next(xs, c)) }

## Whether `f` holds for at least one element. `false` for the empty list.
## Short-circuits: `f` runs on the elements up to the first that satisfies it
## and no further, which is observable when `f` has an effect.
pub fn any[T](xs: List[T], f: fn(T) -> Bool !e) -> Bool !e = any_go(xs, f, iter_start(xs))

fn all_go[T](xs: List[T], f: fn(T) -> Bool !e, c: Cur) -> Bool !e =
  if iter_done(xs, c) { true }
  else if f(iter_get(xs, c)) { all_go(xs, f, iter_next(xs, c)) }
  else { false }

## Whether `f` holds for every element. `true` for the empty list.
## Short-circuits at the first element that fails, as `any` does.
pub fn all[T](xs: List[T], f: fn(T) -> Bool !e) -> Bool !e = all_go(xs, f, iter_start(xs))

## Whether `f` holds for no element. `true` for the empty list.
## Short-circuits at the first element that satisfies `f`, as `any` does.
##
## The third of the three quantifiers, and the one a caller otherwise spells
## `not any(xs, f)` -- which reads as a negated question rather than as the
## question it is, and puts the negation where a reader has to unwind it.
## Defined as that negation, so the short-circuit and the empty-list answer are
## `any`'s by construction rather than by a second walk agreeing with it.
pub fn none[T](xs: List[T], f: fn(T) -> Bool !e) -> Bool !e = not any(xs, f)

fn index_go[T: Eq](xs: List[T], x: T, c: Cur, i: Int) -> Option[Int] =
  if iter_done(xs, c) { None }
  else if eq(iter_get(xs, c), x) { Some(i) }
  else { index_go(xs, x, iter_next(xs, c), i + 1) }

## The index of the first element equal to `x`, or `None`.
##
## An element index in `[0, len)`, and not a position: the `index_of` that
## search for a *sub*sequence (`str`, `bytes`) can answer `len`, because an
## empty needle matches past the last element. This one compares elements, so
## every answer it gives names one.
##
## Inquiry (spec §4.8, criterion 2): a miss is a branch the caller takes. The
## currency is `str.index_of`'s -- `Option[Int]`, never a `-1`, which is the
## one sentinel this library does not hand out.
pub fn index_of[T: Eq](xs: List[T], x: T) -> Option[Int] =
  index_go(xs, x, iter_start(xs), 0)

## Whether some element equals `x`. Stops at the first match; the same answer
## as `index_of(xs, x)` being `Some`, and the same walk.
pub fn contains[T: Eq](xs: List[T], x: T) -> Bool =
  match index_of(xs, x) {
    Some(_) -> true
    None -> false
  }

## The elements with later duplicates dropped: every value survives once, at
## the position of its first occurrence.
##
## `Eq + Hash` and not `Eq` alone, which is the one place this family asks for
## more than the audit did. An `Eq`-only dedupe rescans the output for each
## element and is quadratic, and what callers deduplicate here are lists of
## module paths, file names and diagnostics -- the sizes where that starts to
## cost. A `Set` is `Eq + Hash` by construction, and it already answers the
## ordering clause: a set collapses duplicates keeping the first occurrence's
## position and gives them back in that order, so this is one line rather than
## a second implementation of the same rule.
##
## `set_from`/`set_to_list` are the same primitives `std/set` forwards to, not
## a second route to the structure; why this module calls them directly is in
## `docs/stdlib-impl-notes.md`.
pub fn unique[T: Eq + Hash](xs: List[T]) -> List[T] = set_to_list(set_from(xs))

# ---- by position ----
#
# `take`/`drop`/`slice`/`reverse` are positional by nature: one asks for a
# range, the other for the other end. They stay on `get` and stay O(1) per
# element on a flat list. D3 does not de-index them — it replaces them, since
# an ordered tree cuts a range by splitting in O(log n) rather than by copying
# elements one at a time, and reverses by walking its own structure backwards.

fn slice_go[T](xs: List[T], i: Int, stop: Int, acc: List[T]) -> List[T] =
  if i >= stop { acc }
  else { slice_go(xs, i + 1, stop, acc ++ [get(xs, i).expect("index below length")]) }

fn clamp(n: Int, hi: Int) -> Int = if n < 0 { 0 } else { if n > hi { hi } else { n } }

## The first `n` elements; `n` is clamped into range, so this never panics.
pub fn take[T](xs: List[T], n: Int) -> List[T] = {
  let empty: List[T] = []
  slice_go(xs, 0, clamp(n, len(xs)), empty)
}

## Everything after the first `n` elements; `n` is clamped into range.
pub fn drop[T](xs: List[T], n: Int) -> List[T] = {
  let empty: List[T] = []
  slice_go(xs, clamp(n, len(xs)), len(xs), empty)
}

## The elements in `[from, to)`. Both ends are clamped into range, so
## out-of-bounds indices never panic; `from >= to` yields the empty list.
pub fn slice[T](xs: List[T], from: Int, to: Int) -> List[T] = {
  let empty: List[T] = []
  slice_go(xs, clamp(from, len(xs)), clamp(to, len(xs)), empty)
}

fn reverse_go[T](xs: List[T], i: Int, acc: List[T]) -> List[T] =
  if i < 0 { acc }
  else { reverse_go(xs, i - 1, acc ++ [get(xs, i).expect("index below length")]) }

## A reversed copy; the input is not changed.
pub fn reverse[T](xs: List[T]) -> List[T] = {
  let empty: List[T] = []
  reverse_go(xs, len(xs) - 1, empty)
}

## Ascending stable sort; elements need `Ord`. Delegates to `sort_by` with the
## bound `cmp` — the dictionary crosses as an ordinary captured value, which is
## what let this leave the builtin table (docs/pure-ffi-design.md section 14).
pub fn sort[T: Ord](xs: List[T]) -> List[T] = sort_by(xs, (a, b) => cmp(a, b))

# One walk serves max_by and min_by. `key` runs exactly once per element and
# only a strictly better key replaces the champion, so the first extreme wins —
# both observable (effectful keys, ties), both inherited from the retired
# builtin. The direction is a Bool rather than a ±1 multiplier because `cmp`
# contracts sign, not magnitude: scaling its result could overflow.
fn best_by_go[T, K: Ord](
  xs: List[T], key: fn(T) -> K !e, c: Cur, bx: T, bk: K, greater: Bool
) -> T !e =
  if iter_done(xs, c) { bx }
  else {
    let x = iter_get(xs, c)
    let k = key(x)
    let cp = cmp(k, bk)
    let better = if greater { cp > 0 } else { cp < 0 }
    if better { best_by_go(xs, key, iter_next(xs, c), x, k, greater) }
    else { best_by_go(xs, key, iter_next(xs, c), bx, bk, greater) }
  }

## The first element whose key is greatest; `None` when empty. Keys need `Ord`;
## `key` runs once per element.
pub fn max_by[T, K: Ord](xs: List[T], key: fn(T) -> K !e) -> Option[T] !e = {
  let c = iter_start(xs)
  if iter_done(xs, c) { None }
  else {
    let x0 = iter_get(xs, c)
    Some(best_by_go(xs, key, iter_next(xs, c), x0, key(x0), true))
  }
}

## The first element whose key is least; `None` when empty. Keys need `Ord`;
## `key` runs once per element.
pub fn min_by[T, K: Ord](xs: List[T], key: fn(T) -> K !e) -> Option[T] !e = {
  let c = iter_start(xs)
  if iter_done(xs, c) { None }
  else {
    let x0 = iter_get(xs, c)
    Some(best_by_go(xs, key, iter_next(xs, c), x0, key(x0), false))
  }
}

## The first greatest element; `None` when empty. Elements need `Ord`.
pub fn max[T: Ord](xs: List[T]) -> Option[T] = max_by(xs, x => x)

## The first least element; `None` when empty. Elements need `Ord`.
pub fn min[T: Ord](xs: List[T]) -> Option[T] = min_by(xs, x => x)

# ---- Eq / Hash / Ord for List (trait-v2-design.md 决策 6) ----
#
# Until trait v2 these three were the compiler's business: `==` on a list fell
# through to a `struct_eq` intrinsic, which each backend answered its own way,
# and `Ord[List[T]]` did not exist at all, so `sort` refused a list of lists.
# A conditional impl is how a container says what it means, in Dawn, once.
#
# The hash matches the shape the JVM's list hash already had (seed 1, step
# `31 * acc + h`), because `hash` and the runtime's own bucketing must not
# disagree about the same value.
#
# Two lists take two cursors: a cursor belongs to the list it walks, so there
# is no single "position i" to share between them.

fn eq_go[T: Eq](a: List[T], b: List[T], ca: Cur, cb: Cur) -> Bool =
  if iter_done(a, ca) {
    true
  } else if eq(iter_get(a, ca), iter_get(b, cb)) {
    eq_go(a, b, iter_next(a, ca), iter_next(b, cb))
  } else {
    false
  }

## Same length, and equal elements in order.
impl[T: Eq] Eq[List[T]] {
  fn eq(a: List[T], b: List[T]) -> Bool =
    if len(a) != len(b) { false } else { eq_go(a, b, iter_start(a), iter_start(b)) }
}

fn hash_go[T: Hash](xs: List[T], c: Cur, acc: Int) -> Int =
  if iter_done(xs, c) {
    acc
  } else {
    hash_go(xs, iter_next(xs, c), acc * 31 + hash(iter_get(xs, c)))
  }

impl[T: Hash] Hash[List[T]] {
  fn hash(xs: List[T]) -> Int = hash_go(xs, iter_start(xs), 1)
}

fn cmp_go[T: Ord](a: List[T], b: List[T], ca: Cur, cb: Cur) -> Int =
  if iter_done(a, ca) {
    if iter_done(b, cb) { 0 } else { -1 }
  } else if iter_done(b, cb) {
    1
  } else {
    let c = cmp(iter_get(a, ca), iter_get(b, cb))
    if c != 0 { c } else { cmp_go(a, b, iter_next(a, ca), iter_next(b, cb)) }
  }

## Lexicographic: the first differing element decides, and a prefix is less
## than what extends it.
impl[T: Ord] Ord[List[T]] {
  fn cmp(a: List[T], b: List[T]) -> Int = cmp_go(a, b, iter_start(a), iter_start(b))
}

# "Am I at the first element?" was `i == 0`. A cursor cannot be asked that, so
# the separator carries its own state -- the one thing dropping the index costs.
fn show_go[T: Show](xs: List[T], c: Cur, first: Bool, acc: String) -> String =
  if iter_done(xs, c) {
    acc
  } else {
    show_go(xs, iter_next(xs, c), false,
      acc ++ (if first { "" } else { ", " }) ++ show(iter_get(xs, c)))
  }

## `[e0, e1]`, each element in its nested form -- so a String element is
## quoted where the list itself is not.
impl[T: Show] Show[List[T]] {
  fn show(xs: List[T]) -> String = "[" ++ show_go(xs, iter_start(xs), true, "") ++ "]"
}

# ---- tests ----
#
# The promises above, at the edges that a walk written the obvious way gets
# wrong: the empty list, an index outside the list, and a tie.
#
# Short-circuiting is checked by making the predicate `panic` on the elements a
# short-circuiting walk must never reach. A counter would need a `var` the
# closure could write; a panic needs nothing, and it fails loudly in the one
# direction that matters -- a full walk cannot pass.

test "is_empty asks the cursor rather than comparing a count" {
  let e: List[Int] = []
  assert is_empty(e)
  assert not is_empty([0])
  assert not is_empty([1, 2, 3])
}

test "the quantifiers are vacuous on the empty list and stop at the answer" {
  let e: List[Int] = []
  assert not any(e, x => x > 0)
  assert all(e, x => x > 0)
  assert none(e, x => x > 0)
  assert any([1, 2, 3], x => x == 2)
  assert not any([1, 2, 3], x => x == 9)
  assert all([1, 2, 3], x => x > 0)
  assert not all([1, 2, 3], x => x > 1)
  assert none([1, 2, 3], x => x == 9)
  assert none([1, 2, 3], x => x > 99)
  assert not none([1, 2, 3], x => x == 2)
  # all three agree on the same predicate, which is what makes them one family
  assert none([1, 2, 3], x => x > 9) == not any([1, 2, 3], x => x > 9)
  assert none([1, 2, 3], x => x > 1) == not any([1, 2, 3], x => x > 1)
  assert none([1, 2, 3], x => x > 0) == not all([1, 2, 3], x => x > 0)
  # `any` stops at the first element that satisfies it: reaching the second
  # would panic, so passing is the proof it stopped
  assert any([1, 2, 3], x => if x == 1 { true } else { panic("any walked past the answer") })
  # and `all` stops at the first that fails
  assert not all([1, 2, 3], x => if x == 1 { false } else { panic("all walked past the answer") })
  # `none` inherits the short circuit rather than re-implementing it
  assert not none([1, 2, 3], x => if x == 1 { true } else { panic("none walked past the answer") })
}

test "index_of and contains answer about the first match, never with a sentinel" {
  assert index_of([10, 20, 30, 20], 20).unwrap_or(0 - 1) == 1
  assert index_of([10, 20], 10).unwrap_or(0 - 1) == 0
  assert index_of([10, 20], 99) == None
  let e: List[Int] = []
  assert index_of(e, 1) == None
  assert contains([10, 20], 20)
  assert not contains([10, 20], 99)
  assert not contains(e, 1)
  assert contains(["a", "b"], "b")
}

test "take, drop and slice clamp their bounds instead of panicking" {
  let xs = [1, 2, 3, 4, 5]
  let e: List[Int] = []
  assert take(xs, 2) == [1, 2]
  assert take(xs, 0) == e
  assert take(xs, 99) == xs
  assert take(xs, 0 - 1) == e
  assert take(e, 3) == e
  assert drop(xs, 2) == [3, 4, 5]
  assert drop(xs, 0) == xs
  assert drop(xs, 99) == e
  assert drop(xs, 0 - 1) == xs
  assert drop(e, 3) == e
  assert slice(xs, 1, 3) == [2, 3]
  assert slice(xs, 0, 5) == xs
  assert slice(xs, 3, 1) == e
  assert slice(xs, 2, 2) == e
  assert slice(xs, 0 - 4, 2) == [1, 2]
  assert slice(xs, 3, 99) == [4, 5]
  assert slice(xs, 99, 200) == e
}

test "reverse copies, and leaves the input alone" {
  let xs = [1, 2, 3]
  let e: List[Int] = []
  assert reverse(xs) == [3, 2, 1]
  assert xs == [1, 2, 3]
  assert reverse(e) == e
  assert reverse([1]) == [1]
  assert reverse(reverse(xs)) == xs
}

test "max_by and min_by answer None on the empty list and keep the first extreme" {
  let e: List[Int] = []
  assert max_by(e, x => x) == None
  assert min_by(e, x => x) == None
  assert max(e) == None
  assert min(e) == None
  assert max_by([3, 1, 4, 1], x => x).unwrap_or(0) == 4
  assert min_by([3, 1, 4, 1], x => x).unwrap_or(0) == 1
  assert max([3, 1, 4]).unwrap_or(0) == 4
  assert min([3, 1, 4]).unwrap_or(0) == 1
  assert max([7]).unwrap_or(0) == 7
  # a tie goes to the first: only a strictly better key replaces the champion,
  # and both directions inherit that from the one walk underneath. The key
  # collides deliberately -- with distinct keys there is no tie to observe.
  assert max_by([1, 2, 3], x => x % 2).unwrap_or(0) == 1
  assert min_by([2, 4, 1], x => x % 2).unwrap_or(0) == 2
  # the key decides, not the element
  assert max_by([1, 2, 3], x => 0 - x).unwrap_or(0) == 1
}

test "sort is ascending, and sort_by is stable" {
  let e: List[Int] = []
  assert sort([3, 1, 2]) == [1, 2, 3]
  assert sort(e) == e
  assert sort([1]) == [1]
  assert sort([2, 2, 1]) == [1, 2, 2]
  assert sort(["b", "a", "c"]) == ["a", "b", "c"]
  # equal keys come back in the order they went in
  assert sort_by([32, 21, 2, 11], (a, b) => cmp(a % 10, b % 10)) == [21, 11, 32, 2]
}

test "unique keeps every value once, at its first occurrence" {
  let e: List[Int] = []
  assert unique([3, 1, 3, 2, 1]) == [3, 1, 2]
  assert unique(e) == e
  assert unique([1, 1, 1]) == [1]
  assert unique(["b", "a", "b"]) == ["b", "a"]
}

test "map, filter, fold and find walk in order" {
  let e: List[Int] = []
  assert map([1, 2, 3], x => x * 2) == [2, 4, 6]
  assert map(e, x => x * 2) == e
  assert map([1, 2], x => show(x)) == ["1", "2"]
  assert filter([1, 2, 3, 4], x => x % 2 == 0) == [2, 4]
  assert filter(e, x => true) == e
  assert filter([1, 2], x => false) == e
  assert fold([1, 2, 3], 0, (a, x) => a + x) == 6
  assert fold(e, 7, (a, x) => a + x) == 7
  # left to right, which only a non-commutative step can show
  assert fold(["a", "b", "c"], "", (a, x) => a ++ x) == "abc"
  assert find([1, 2, 3], x => x > 1).unwrap_or(0) == 2
  assert find([1, 2, 3], x => x > 9) == None
  assert find(e, x => true) == None
}

test "Eq, Ord, Hash and Show on List say what the container means" {
  let e: List[Int] = []
  assert [1, 2] == [1, 2]
  assert not ([1, 2] == [2, 1])
  assert not ([1, 2] == [1, 2, 3])
  assert e == e
  assert not (e == [1])
  assert [[1], [2]] == [[1], [2]]
  assert not ([[1], [2]] == [[1], [3]])
  # lexicographic, and a prefix is less than what extends it
  assert cmp([1, 2], [1, 3]) < 0
  assert cmp([1, 2], [1, 2]) == 0
  assert cmp([2], [1, 9]) > 0
  assert cmp(e, [1]) < 0
  assert cmp([1], e) > 0
  assert cmp(e, e) == 0
  assert sort([[2], [1, 9], [1]]) == [[1], [1, 9], [2]]
  # equal lists hash equal -- the runtime buckets by this
  assert hash([1, 2]) == hash([1, 2])
  assert hash(e) == hash(e)
  # a String element is shown in its nested (quoted) form, the list is not
  assert show([1, 2]) == "[1, 2]"
  assert show(e) == "[]"
  assert show(["a", "b"]) == "[\"a\", \"b\"]"
  assert show([[1], [2]]) == "[[1], [2]]"
}

test "for over a List walks every element once, in order" {
  var seen = ""
  var n = 0
  for x in [10, 20, 30] {
    seen = seen ++ show(x) ++ ";"
    n = n + 1
  }
  assert n == 3
  assert seen == "10;20;30;"
  let e: List[Int] = []
  var empty = 0
  for _x in e { empty = empty + 1 }
  assert empty == 0
}

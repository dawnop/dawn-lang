# The lambda (spec §4.5): `x => e`, `(a, b) => e`, `() => e`, each parameter
# optionally `: Type`. Parsing only -- that every spelling lands on one node is
# pinned by selfhost/src/front/parser_test.dawn. The `fn` prefix is retired: it now
# appears on a lambda in exactly one position, and that case is at the bottom.

fn arities(xs: List[Int]) -> Unit = {
  let one = x => x * 2
  let two = (a, b) => a + b
  let none = () => 0
  let paren_one = (x) => x
  let annotated = (a: Int, b: List[String]) => a
  let annotated_one = (n: Int) => n
  ()
}

# a lambda body is a full expression, so it ends where the argument does
fn as_arguments(xs: List[Int]) -> List[Int] = map(filter(xs, x => x > 0), x => x + 1)

# nesting, in both directions
fn nested(xs: List[Int]) -> List[List[Int]] = map(xs, x => map(xs, y => x + y))

fn returns_one() -> fn(Int) -> Int = x => x + 1

fn immediately_applied() -> Int = (x => x + 1)(1)

# through a pipeline, which is where the noise the sugar removes was loudest
fn piped(xs: List[Int]) -> String =
  xs |> filter(x => x > 0) |> map(x => to_string(x)) |> join(", ")

# a block body, and a lambda whose body is a match
fn blocks(xs: List[Int]) -> Unit = {
  let f = x => {
    let y = x + 1
    y * 2
  }
  let g = o => match o {
    Some(v) -> v
    None -> 0
  }
  ()
}

# the trailing-closure position, the one place `fn` is still written -- and
# still mandatory, since a bare `(x) =>` there is the curried call `f(a)(x)`
fn trailing_keeps_fn(xs: List[Int]) -> Unit = {
  map(xs) fn(x) => x
  xs.each fn(x) => x
  ()
}

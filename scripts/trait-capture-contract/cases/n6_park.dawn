# An explicit contract isolates this propagation or boundary rule.
effect Store { fn save(value: fn() -> Int) -> Unit }
trait Park[T: ^{c}, ^c] { fn park(value: T) -> Unit !Store }
impl[@s] Park[I64Buf@s, ^{s}] { fn park(value: I64Buf@s) -> Unit !Store = save(() => len(value)) }
pub fn main() -> Unit !io = { () }

# std/pvec — the persistent vector behind List.
#
# A 32-way trie with a tail buffer: Clojure's PersistentVector, which is what
# "strict RB" means in docs/collections-dejava-research.md §5.3. The last
# (partial) block of elements lives in `tail`, an `Array` of at most 32 slots;
# everything before it lives in a trie whose leaves are the same shape. An
# append copies the tail — bounded work — and every 32nd one also pushes the
# full tail into the trie, copying one root-to-leaf path.
#
# Why this and not the flat shared-array window it replaces: the window is
# O(1) to append to only while one version owns the frontier, and O(n) to copy
# the moment two versions want it. That is fine on a backend that can hand out
# a mutable array and track who owns it — the JVM one did, with a CAS
# watermark — but it is not something Dawn source can express, and a second
# backend would have to reimplement it. Here the sharing is structural, so
# both backends get it from the same source (docs/native-backend-plan.md §10).
#
# The one thing it still asks of the backend is that `array_push` extend in
# place when the array it is given ends where the shared region ends. That is
# exactly the accumulation shape — `out = out ++ [x]` — and it is what keeps
# an append a constant-size copy rather than 32 slots every time.
#
# Nothing in std imports this module: `List` is a builtin type name, and the
# calls that arrive here are the ones lowering writes for a list primitive.

const BITS: Int = 5

const WIDTH: Int = 32

const MASK: Int = 31

## A trie node. Leaves hold elements, branches hold nodes, and both are one
## `Array` of at most 32 slots — the shape that makes a path copy bounded.
pub type VNode[T] =
  | VLeaf(items: Array[T])
  | VBranch(kids: Array[VNode[T]])

## A whole vector: how many elements, how deep the trie is, the trie, and the
## unfinished last block.
pub type Vec[T] = { cnt: Int, shift: Int, root: VNode[T], tail: Array[T] }

# ---- small array helpers ----

fn arr1[T](x: T) -> Array[T] = {
  let e: Array[T] = array_new()
  array_push(e, x)
}

fn arr2[T](x: T, y: T) -> Array[T] = array_push(arr1(x), y)

fn arr_slice[T](a: Array[T], from: Int, to: Int) -> Array[T] = {
  var out: Array[T] = array_new()
  var i = from
  while i < to {
    out = array_push(out, array_get(a, i))
    i = i + 1
  }
  out
}

# ---- shape ----

## Where the tail starts: everything at or after this index is in `tail`.
fn tail_off(cnt: Int) -> Int = if cnt < WIDTH { 0 } else { ((cnt - 1) >>> BITS) << BITS }

## The block holding element `i`. For any vector of fewer than 32 elements this
## is the tail and costs nothing — which is most lists in most programs, and
## the reason an index cursor stays cheap.
fn leaf_for[T](v: Vec[T], i: Int) -> Array[T] =
  if i >= tail_off(v.cnt) {
    v.tail
  } else {
    var node = v.root
    var level = v.shift
    while level > 0 {
      node = match node {
        VBranch(kids) -> array_get(kids, (i >>> level) & MASK)
        VLeaf(_) -> node
      }
      level = level - BITS
    }
    match node {
      VLeaf(items) -> items
      VBranch(_) -> panic("pvec: branch where a leaf belongs")
    }
  }

# ---- construction ----

## A vector with no elements.
pub fn empty[T]() -> Vec[T] = {
  let e: Array[VNode[T]] = array_new()
  let t: Array[T] = array_new()
  Vec { cnt: 0, shift: BITS, root: VBranch(e), tail: t }
}

## Number of elements.
pub fn count[T](v: Vec[T]) -> Int = v.cnt

fn new_path[T](level: Int, node: VNode[T]) -> VNode[T] =
  if level == 0 { node } else { VBranch(arr1(new_path(level - BITS, node))) }

## Fold a full tail into the trie, copying the one path that changes.
fn push_tail[T](cnt: Int, level: Int, parent: VNode[T], tail: Array[T]) -> VNode[T] =
  match parent {
    VLeaf(_) -> VLeaf(tail)
    VBranch(kids) -> {
      let sub = ((cnt - 1) >>> level) & MASK
      if level == BITS {
        if sub < array_len(kids) {
          VBranch(array_with(kids, sub, VLeaf(tail)))
        } else {
          VBranch(array_push(kids, VLeaf(tail)))
        }
      } else if sub < array_len(kids) {
        VBranch(array_with(kids, sub,
          push_tail(cnt, level - BITS, array_get(kids, sub), tail)))
      } else {
        VBranch(array_push(kids, new_path(level - BITS, VLeaf(tail))))
      }
    }
  }

## A copy with `x` appended.
pub fn push[T](v: Vec[T], x: T) -> Vec[T] =
  if array_len(v.tail) < WIDTH {
    Vec { ..v, cnt: v.cnt + 1, tail: array_push(v.tail, x) }
  } else if (v.cnt >>> BITS) > (1 << v.shift) {
    # the trie is full at this depth: grow a level, with the old root beside a
    # fresh path down to the tail that just came off
    Vec {
      cnt: v.cnt + 1,
      shift: v.shift + BITS,
      root: VBranch(arr2(v.root, new_path(v.shift, VLeaf(v.tail)))),
      tail: arr1(x)
    }
  } else {
    Vec {
      cnt: v.cnt + 1,
      shift: v.shift,
      root: push_tail(v.cnt, v.shift, v.root, v.tail),
      tail: arr1(x)
    }
  }

# ---- reading ----
#
# One unchecked reader, private, and every public way in checks first. It was
# the other way round until 2026-07-30: `nth` was `pub` and did no checking,
# so `nth(v, 70)` on a 64-element vector answered `38` rather than failing --
# `i & MASK` folds an out-of-range index back onto a legal slot in whichever
# block `leaf_for` picked. That is the "illegal input, silently wrong answer"
# shape, and spec 4.8's out-of-bounds criteria say a positional read past
# the end is a panic (docs/audit/re-audit-2026-07-30.md RD-01).

## Element `i`, whose range the caller has already established. Out of range
## this answers with some other element rather than failing, which is why it
## is not `pub`.
fn at[T](v: Vec[T], i: Int) -> T = array_get(leaf_for(v, i), i & MASK)

## Element `i`, panicking out of range — what `xs[i]` means.
pub fn index[T](v: Vec[T], i: Int) -> T =
  if i < 0 || i >= v.cnt {
    panic("index " ++ to_string(i) ++ " out of bounds for length " ++ to_string(v.cnt))
  } else {
    at(v, i)
  }

## Element `i`, panicking out of range. The name Clojure gives the checked
## accessor, and the same function `index` is: the comparison it costs is
## nothing beside `leaf_for`, so there is no unchecked public reader to make
## the saving worth a wrong answer.
pub fn nth[T](v: Vec[T], i: Int) -> T = index(v, i)

## Element `i`, or `None` when it is out of range.
pub fn get[T](v: Vec[T], i: Int) -> Option[T] =
  if i < 0 || i >= v.cnt { None } else { Some(at(v, i)) }

# ---- bulk ----
#
# These walk by block rather than by index: `leaf_for` is cheap but not free,
# and asking it once per 32 elements instead of once per element is what keeps
# a copy linear with a small constant.

fn each_block[T, A](v: Vec[T], i: Int, acc: A, f: fn(A, T) -> A !e) -> A !e =
  if i >= v.cnt {
    acc
  } else {
    let blk = leaf_for(v, i)
    let base = i - (i & MASK)
    let stop = if base + array_len(blk) < v.cnt { base + array_len(blk) } else { v.cnt }
    each_block(v, stop, fold_block(blk, i - base, stop - base, acc, f), f)
  }

fn fold_block[T, A](blk: Array[T], i: Int, stop: Int, acc: A, f: fn(A, T) -> A !e) -> A !e =
  if i >= stop { acc } else { fold_block(blk, i + 1, stop, f(acc, array_get(blk, i)), f) }

## Every element in order, as one flat array.
pub fn to_array[T](v: Vec[T]) -> Array[T] = {
  let e: Array[T] = array_new()
  each_block(v, 0, e, (a, x) => array_push(a, x))
}

## A vector holding `a`'s elements in order.
pub fn from_array[T](a: Array[T]) -> Vec[T] = {
  var v: Vec[T] = empty()
  var i = 0
  while i < array_len(a) {
    v = push(v, array_get(a, i))
    i = i + 1
  }
  v
}

## `a` then `b`. Linear in `b`, which is the shape `++` is used in: the right
## side is almost always a single element being accumulated.
pub fn concat[T](a: Vec[T], b: Vec[T]) -> Vec[T] =
  if b.cnt == 0 { a } else { each_block(b, 0, a, (v, x) => push(v, x)) }

## The elements in `[from, to)`; the caller has already clamped the ends.
pub fn slice[T](v: Vec[T], from: Int, to: Int) -> Vec[T] = {
  var out: Vec[T] = empty()
  var i = from
  while i < to {
    out = push(out, at(v, i))
    i = i + 1
  }
  out
}

## `[from, to)` as a vector of Ints.
pub fn range(from: Int, to: Int) -> Vec[Int] = {
  var out: Vec[Int] = empty()
  var i = from
  while i < to {
    out = push(out, i)
    i = i + 1
  }
  out
}

# ---- sorting ----
#
# A merge sort on the flat array, because a sort is the one bulk operation
# that reads by position over and over: paying `leaf_for` per comparison would
# put the trie in the inner loop. Stable, since a tie takes from the left.

fn merge[T](a: Array[T], b: Array[T], cmp: fn(T, T) -> Int !e) -> Array[T] !e = {
  var out: Array[T] = array_new()
  var i = 0
  var j = 0
  while i < array_len(a) && j < array_len(b) {
    let x = array_get(a, i)
    let y = array_get(b, j)
    if cmp(y, x) < 0 {
      out = array_push(out, y)
      j = j + 1
    } else {
      out = array_push(out, x)
      i = i + 1
    }
  }
  while i < array_len(a) {
    out = array_push(out, array_get(a, i))
    i = i + 1
  }
  while j < array_len(b) {
    out = array_push(out, array_get(b, j))
    j = j + 1
  }
  out
}

fn msort[T](a: Array[T], cmp: fn(T, T) -> Int !e) -> Array[T] !e = {
  let n = array_len(a)
  if n <= 1 {
    a
  } else {
    let mid = n / 2
    merge(msort(arr_slice(a, 0, mid), cmp), msort(arr_slice(a, mid, n), cmp), cmp)
  }
}

## Stable ascending sort by `cmp`.
pub fn sort_by[T](v: Vec[T], cmp: fn(T, T) -> Int !e) -> Vec[T] !e =
  from_array(msort(to_array(v), cmp))

# scripts/pvec-contract drives `push`/`get`/`nth` at twelve sizes and compares
# against the builtin List. What it never touches: `range` (nothing in the tree
# calls it), `index` by name, both panic message strings, `slice` outside the
# range its caller promised, and the sizes where the trie gains a level -- its
# size list steps from 1025 straight to 32768, and the growth point is 1057.
#
# `Vec` and `VNode` are ordinary types, so the shape is observable, and the
# shape is where the tail/trie split lives. There is no `Eq[Vec[T]]` -- an
# `Array` is held by identity, so `==` on two vectors does not compile -- which
# is why everything below compares element by element.

test "empty, and the tail that holds everything until the trie starts" {
  let e: Vec[Int] = empty()
  assert count(e) == 0
  assert get(e, 0) == None
  assert get(e, 0 - 1) == None
  # not a leaf and not nothing: an empty branch, at the shallowest shift
  match e.root {
    VBranch(kids) -> { assert array_len(kids) == 0 }
    VLeaf(_items) -> { assert false }
  }
  assert e.shift == 5
  assert array_len(e.tail) == 0

  # up to and including 32 elements the trie is still empty -- the tail holds
  # the lot, and the first spill is at 33
  var v: Vec[Int] = empty()
  var i = 0
  while i < 32 {
    v = push(v, i)
    i = i + 1
  }
  let at32 = v
  assert count(at32) == 32
  assert array_len(at32.tail) == 32
  match at32.root {
    VBranch(kids) -> { assert array_len(kids) == 0 }
    VLeaf(_items) -> { assert false }
  }
  let at33 = push(at32, 32)
  assert count(at33) == 33
  assert array_len(at33.tail) == 1
  match at33.root {
    VBranch(kids) -> { assert array_len(kids) == 1 }
    VLeaf(_items) -> { assert false }
  }
  # and every element is still where it was put, on both sides of the split
  assert nth(at33, 0) == 0
  assert nth(at33, 31) == 31
  assert nth(at33, 32) == 32
  # persistent: pushing did not disturb the vector that was pushed onto
  assert count(at32) == 32
  assert get(at32, 32) == None
}

test "index and nth are one function, and it names the bounds it refused" {
  var v: Vec[Int] = empty()
  var i = 0
  while i < 100 {
    v = push(v, i * 10)
    i = i + 1
  }
  let vv = v
  assert count(vv) == 100
  assert index(vv, 0) == 0
  assert index(vv, 99) == 990
  # `nth` is `index` under another name, deliberately: there is no unchecked
  # public reader, so the two cannot disagree
  assert nth(vv, 0) == index(vv, 0)
  assert nth(vv, 63) == index(vv, 63)
  assert nth(vv, 99) == index(vv, 99)
  # the tail/trie split is at 96 here, and it is invisible from outside
  assert nth(vv, 95) == 950
  assert nth(vv, 96) == 960
  # spec 4.8 criterion 1. The message is asserted, not just the panic: it is
  # the only place either string is checked, and it carries both numbers.
  match catch_panic(() => nth(vv, 100)) {
    Ok(_) -> { assert false }
    Err(er) -> { assert er.message == "index 100 out of bounds for length 100" }
  }
  match catch_panic(() => nth(vv, 0 - 1)) {
    Ok(_) -> { assert false }
    Err(er) -> { assert er.message == "index -1 out of bounds for length 100" }
  }
  match catch_panic(() => index(vv, 1000)) {
    Ok(_) -> { assert false }
    Err(er) -> { assert er.message == "index 1000 out of bounds for length 100" }
  }
  # The RD-01 regression, from the other side: 130 masks to 2 inside the tail,
  # so an unchecked reader would answer element 98 rather than refuse.
  match catch_panic(() => nth(vv, 130)) {
    Ok(_) -> { assert false }
    Err(er) -> { assert er.message == "index 130 out of bounds for length 100" }
  }
  let e: Vec[Int] = empty()
  match catch_panic(() => nth(e, 0)) {
    Ok(_) -> { assert false }
    Err(er) -> { assert er.message == "index 0 out of bounds for length 0" }
  }
  # `get` is the same question, answered rather than asserted
  assert get(vv, 0) == Some(0)
  assert get(vv, 99) == Some(990)
  assert get(vv, 100) == None
  assert get(vv, 130) == None
  assert get(vv, 0 - 1) == None
}

test "the trie gains a level at 1057, and not at 1056" {
  # The size list in scripts/pvec-contract steps from 1025 to 32768, so the
  # boundary is between two of its entries and nothing sits on it. `push`
  # deepens when `(cnt >>> 5) > (1 << shift)`, which first holds at 1056
  # elements already stored -- so 1056 is still one level and 1057 is two.
  var v: Vec[Int] = empty()
  var i = 0
  while i < 1058 {
    v = push(v, i)
    i = i + 1
  }
  let big = v
  assert count(big) == 1058
  assert slice(big, 0, 1055).shift == 5
  assert slice(big, 0, 1056).shift == 5
  assert slice(big, 0, 1057).shift == 10
  assert slice(big, 0, 1058).shift == 10
  assert big.shift == 10
  # a full root at one level: 1025 elements is 32 leaves plus one in the tail
  assert slice(big, 0, 1025).shift == 5
  match slice(big, 0, 1025).root {
    VBranch(kids) -> { assert array_len(kids) == 32 }
    VLeaf(_items) -> { assert false }
  }
  # and reading still agrees with what was pushed, across the new level
  assert nth(big, 0) == 0
  assert nth(big, 1023) == 1023
  assert nth(big, 1024) == 1024
  assert nth(big, 1056) == 1056
  assert nth(big, 1057) == 1057
  assert get(big, 1058) == None
}

test "range is half-open, and empty whenever it is not" {
  # Nothing in the tree calls this function, so this block is all of its
  # coverage.
  let r = range(0, 5)
  assert count(r) == 5
  assert nth(r, 0) == 0
  assert nth(r, 4) == 4
  assert get(r, 5) == None
  # negative bounds are ordinary
  let neg = range(0 - 3, 3)
  assert count(neg) == 6
  assert nth(neg, 0) == -3
  assert nth(neg, 3) == 0
  assert nth(neg, 5) == 2
  # backwards and degenerate ranges are empty rather than errors
  assert count(range(5, 3)) == 0
  assert count(range(0, 0)) == 0
  assert count(range(3, 3)) == 0
  assert count(range(0 - 1, 0 - 1)) == 0
  assert count(range(0, 1)) == 1
  assert nth(range(0, 1), 0) == 0
  # and it crosses the tail boundary like anything else
  assert count(range(0, 33)) == 33
  assert nth(range(0, 33), 32) == 32
}

test "slice and concat at their edges, and slice's unchecked reader" {
  var v: Vec[Int] = empty()
  var i = 0
  while i < 100 {
    v = push(v, i)
    i = i + 1
  }
  let vv = v
  let e: Vec[Int] = empty()
  assert count(slice(vv, 0, 100)) == 100
  assert nth(slice(vv, 0, 100), 99) == 99
  assert count(slice(vv, 10, 20)) == 10
  assert nth(slice(vv, 10, 20), 0) == 10
  assert nth(slice(vv, 10, 20), 9) == 19
  # straddling the tail/trie split at 96
  assert count(slice(vv, 90, 100)) == 10
  assert nth(slice(vv, 90, 100), 0) == 90
  assert nth(slice(vv, 90, 100), 9) == 99
  # backwards and degenerate slices are empty
  assert count(slice(vv, 5, 3)) == 0
  assert count(slice(vv, 0, 0)) == 0
  assert count(slice(vv, 100, 100)) == 0
  assert count(slice(e, 0, 0)) == 0

  # Recorded, not fixed. `slice`'s doc says "the caller has already clamped the
  # ends", and nothing enforces it: it reads through the private unchecked
  # reader. Past the end the index is masked back into the tail, so this
  # answers three real elements instead of refusing -- exactly the shape audit
  # RD-01 took out of `nth`, still live behind this function. The assertion
  # exists so that a fix has to come here and change it.
  let past = slice(vv, 128, 131)
  assert count(past) == 3
  assert nth(past, 0) == 96
  assert nth(past, 1) == 97
  assert nth(past, 2) == 98
  # and one step further out it is not a wrong answer but the array layer's
  # panic, which is a third behaviour for one function.
  #
  # Only that it panics, deliberately. The two backends word this one
  # differently -- the JVM builds "array index 4 out of bounds for length 4"
  # and the C runtime says "Array index out of bounds" with no numbers in it
  # (runtime/c/dawn_rt.c, dawn_array_get) -- so the text is not a promise the
  # language keeps yet. The messages asserted above are pvec's own, written in
  # Dawn, and those do agree; this one comes from below the language.
  match catch_panic(() => slice(vv, 0, 101)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }

  # `concat(a, empty())` is `a` itself; the other way round rebuilds
  assert count(concat(vv, e)) == 100
  assert count(concat(e, vv)) == 100
  assert nth(concat(e, vv), 0) == 0
  assert nth(concat(e, vv), 99) == 99
  let pair = concat(slice(vv, 0, 30), slice(vv, 30, 40))
  assert count(pair) == 40
  assert nth(pair, 0) == 0
  assert nth(pair, 29) == 29
  assert nth(pair, 30) == 30
  assert nth(pair, 39) == 39
  # crossing the tail boundary in the middle of a concat
  let crossed = concat(slice(vv, 0, 30), slice(vv, 30, 70))
  assert count(crossed) == 70
  assert nth(crossed, 32) == 32
  assert nth(crossed, 69) == 69
  assert count(concat(e, e)) == 0
}

test "sort_by is stable, and the degenerate inputs are not special cases" {
  let e: Vec[Int] = empty()
  assert count(sort_by(e, (a, b) => a - b)) == 0
  let one = push(e, 42)
  assert count(sort_by(one, (a, b) => a - b)) == 1
  assert nth(sort_by(one, (a, b) => a - b), 0) == 42
  # two elements, both orders
  let asc = push(push(e, 1), 2)
  let desc = push(push(e, 2), 1)
  assert nth(sort_by(asc, (a, b) => a - b), 0) == 1
  assert nth(sort_by(asc, (a, b) => a - b), 1) == 2
  assert nth(sort_by(desc, (a, b) => a - b), 0) == 1
  assert nth(sort_by(desc, (a, b) => a - b), 1) == 2
  # already sorted, reversed, and all equal
  let rev = range(0, 40)
  let backwards = sort_by(rev, (a, b) => b - a)
  assert nth(backwards, 0) == 39
  assert nth(backwards, 39) == 0
  let forwards = sort_by(backwards, (a, b) => a - b)
  assert nth(forwards, 0) == 0
  assert nth(forwards, 39) == 39
  assert count(forwards) == 40
  var flat: Vec[Int] = empty()
  var i = 0
  while i < 40 {
    flat = push(flat, 7)
    i = i + 1
  }
  let same = sort_by(flat, (a, b) => a - b)
  assert count(same) == 40
  assert nth(same, 0) == 7
  assert nth(same, 39) == 7

  # Stability: the comparator sees only the first component, so equal keys must
  # come out in the order they went in. Crossing the 32-element tail boundary,
  # because a merge sort's blocks and the vector's blocks are different things.
  var pairs: Vec[(Int, Int)] = empty()
  var j = 0
  while j < 40 {
    pairs = push(pairs, (j % 3, j))
    j = j + 1
  }
  let sorted = sort_by(pairs, (a, b) => {
    let (ka, _va) = a
    let (kb, _vb) = b
    ka - kb
  })
  assert count(sorted) == 40
  var prev_key = -1
  var prev_val = -1
  var k = 0
  while k < 40 {
    let (key, val) = nth(sorted, k)
    assert key >= prev_key
    if key == prev_key {
      assert val > prev_val
    }
    prev_key = key
    prev_val = val
    k = k + 1
  }
  # the first group is every j with j % 3 == 0, in ascending j
  let (k0, v0) = nth(sorted, 0)
  assert k0 == 0
  assert v0 == 0
  let (k1, v1) = nth(sorted, 1)
  assert k1 == 0
  assert v1 == 3
}

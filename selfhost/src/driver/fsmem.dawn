# The bundled std, mounted in a `std/memfs` table.
#
# Test support. The table itself, and the `Fs` handler over it, are std's
# (`std/memfs`); this file keeps only the one thing std cannot say, which is
# what the std it ships with looks like on disk: `mem_std` reads the copy the
# compiler embeds (`embed/stdsrc`).
#
# The handler used to live here, and that is the reason it does not any more
# (#207, R2 in docs/fs-real-path-design.md). The bootstrap compiles this file
# once against the seed's std and once against HEAD's, and a handler answers
# exactly the operations its effect declares; a `with handle Fs` spelled here
# had to match two op sets at once, so `Fs` could not gain an operation in any
# release. Calling `memfs.with_fs` instead puts the arms in the same std as the
# declaration they answer, on both sides of the bootstrap. Nothing in selfhost
# may spell `with handle Fs` again for that reason.

use std/io
use std/str
use std/memfs
use embed/stdsrc
use version.{VERSION}

## Where `mem_std` mounts the bundled std in a table based at `base`.
##
## A test spells its `--std` with this rather than with the bare `std` the
## default uses: a relative directory is resolved against the process's working
## directory, which is a host call per std file and a base the table does not
## share, while this one is a path the table already holds.
pub fn mem_std_dir(base: String) -> String = "${base}/std"

## An empty tree rooted at `base` with the bundled std mounted at
## `mem_std_dir(base)`, so `load_std(mem_std_dir(base))` loads a real standard
## library out of the table.
##
## The text is the embedded copy (`embed/stdsrc`), which `driver/stdlib`'s own
## round-trip test holds equal to `std/` on disk: what a test reads here is
## what the directory would have answered with.
pub fn mem_std(base: String) -> memfs.MemFs = {
  let index = match stdsrc.source("modules.txt") {
    Some(t) -> t
    None -> panic("the embedded std carries no modules.txt")
  }
  var st = memfs.put(memfs.empty(base), "std/modules.txt", index)
  st = memfs.put(st, "std/VERSION", "${VERSION}\n")
  for line in str.split(index, "\n") {
    let cut = match str.index_of(line, "#") {
      Some(i) -> str.take(line, i)
      None -> line
    }
    let n = str.trim(cut)
    if n != "" {
      match stdsrc.source("${n}.dawn") {
        Some(t) -> { st = memfs.put(st, "std/" ++ n ++ ".dawn", t) }
        None -> panic("the embedded std is missing " ++ n ++ ".dawn")
      }
    }
  }
  st
}

# ---- tests ----

test "the mounted std is the embedded std, and nothing else is there" {
  let (_, table) = memfs.with_fs(mem_std(memfs.BASE), () => {
    assert io.is_dir("std")
    # and the mount point `mem_std_dir` names is the one the text is at
    assert io.is_dir(mem_std_dir(memfs.BASE))
    assert io.read_file("std/VERSION") == Ok("${VERSION}\n")
    assert io.read_file("${mem_std_dir(memfs.BASE)}/VERSION") == Ok("${VERSION}\n")
    assert io.read_file("std/io.dawn") == Ok(stdsrc.source("io.dawn").expect("embedded io"))
    # nothing above the mount point, and no host tree behind it
    assert not io.exists("/usr")
    assert not io.exists("std/nope.dawn")
  })
  for f in memfs.file_paths(table) {
    assert str.starts_with(f, "${mem_std_dir(memfs.BASE)}/")
  }
}

# checker.dawn: leaving a comptime block puts the enclosing lambda stack back
# (Frame.lambda_stack) -- the `return` still targets the lambda's return type
# (String), not the enclosing function's (Int)
fn apply(g: fn(Int) -> String) -> String = g(1)

pub fn in_lambda() -> Int = {
  let s = apply(x => {
    let n = comptime { 2 }
    return x
  })
  0
}

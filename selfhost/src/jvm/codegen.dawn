# Checked TAST → JVM bytecode via ASM (the Kotlin CodeGen.kt, spec §12.2):
# module → class of statics; Int → long, Float → double, Bool → boolean,
# String → java.lang.String, Unit → void; ADT → abstract base + final ctor
# subclasses (nullary = singletons); match → instanceof chains; self tail
# calls → goto. The class writer is dawn.rt.AsmWriter in COMPUTE_FRAMES, driven
# through dawn.rt.Asm's static adapters because ASM's
# visit signatures take nulls and Dawn has none — golden = byte-identical
# .class files (docs/selfhost-codegen.md).

use std/io
use std/io.{Fs, Exit, Console}
use std/str
use std/map
use check/types.{
  EPure, EIo, EffVar, prelude_adts, opt_ty, peel_opaque,
  Ty, TyInt, TyFloat, TyBool, TyString, TyBytes, TyI64Buf, TyF64Buf, TyUnit, TyNever,
  TyError, TyVar, TyAssoc, TyAdt, TyList, TyMap, TySet, TyArray, TyJava, TyTuple, TyFn,
  Adts, AdtI, CtorI, adt_of, adt_jvm_name, ctor_jvm_name, fn_arity
}
use ir/core.{subject_key}
use front/diag.{render}
use front/token.{mk_diag}
use java "dawn.rt.Asm"
use java "dawn.rt.AsmWriter"
use java "org.objectweb.asm.ClassWriter"
use java "org.objectweb.asm.MethodVisitor"
use java "org.objectweb.asm.Label"

use jvm/ops.{
  ACC_ABSTRACT, ACC_FINAL, ACC_PRIVATE, ACC_PROTECTED, ACC_PUBLIC, ACC_STATIC, COMPUTE_FRAMES,
  OP_ALOAD,
  OP_ARETURN, OP_ASTORE, OP_BIPUSH, OP_CHECKCAST, OP_DCMPL, OP_DLOAD,
  OP_DUP, OP_GETFIELD, OP_IADD, OP_ICONST_0, OP_ICONST_1, OP_IFEQ, OP_IFNE,
  OP_IF_ACMPEQ, OP_IF_ICMPNE, OP_ILOAD, OP_IMUL, OP_INSTANCEOF, OP_INVOKESPECIAL, OP_INVOKESTATIC,
  OP_INVOKEVIRTUAL, OP_IRETURN, OP_L2I, OP_LCMP, OP_LLOAD,
  OP_NEW, OP_PUTFIELD, OP_PUTSTATIC, OP_RETURN, V52
}
use jvm/rtclasses.{
  obj, fn_iface, tuple_class, erased_apply_desc, append_const, close_mv, UNIT_CLASS, SB,
  PVEC_CLASS, HAMT_CLASS, ARRAY_CLASS, invoke_rt, rt_show_show
}

# ---- type mapping ----

## The JVM descriptor of a Dawn type (the Kotlin descOf).
pub fn desc_of(adts: Adts, t: Ty) -> String =
  match t {
    # an opaque type has no representation of its own -- it IS its target
    TyOpaque(_, _, _, _, tgt) -> desc_of(adts, tgt)
    TyInt -> "J"
    TyFloat -> "D"
    TyBool -> "Z"
    TyString -> "Ljava/lang/String;"
    TyBytes -> "[B"
    # a flat long[]: the same family as Bytes' byte[] (docs/mem-buffer-design.md 6.3)
    TyI64Buf -> "[J"
    TyF64Buf -> "[D"
    TyUnit -> "L" ++ UNIT_CLASS ++ ";"
    # `V` is legal as a return descriptor and nowhere else, which is exactly
    # where the bottom types can appear: an expression that does not return
    # has no parameter, field or local to be stored in.
    TyNever -> "V"
    TyError -> "V"
    # a projection over a rigid subject is erased exactly like the TyVar it
    # projects from (assoc-types-design.md 4.1); ground types never carry one
    TyVar(_, _) | TyAssoc(_, _, _) -> "Ljava/lang/Object;"
    TyAdt(aid, _) -> "L" ++ adt_jvm_name(adt_of(adts, aid)) ++ ";"
    TyList(_) -> "L" ++ PVEC_CLASS ++ ";"
    TyMap(_, _) -> "L" ++ HAMT_CLASS ++ ";"
    TySet(_) -> "L" ++ HAMT_CLASS ++ ";"
    TyArray(_) -> "L" ++ ARRAY_CLASS ++ ";"
    TyTuple(elems) -> "L" ++ tuple_class(len(elems)) ++ ";"
    # arrays are their own descriptor ("[B"); reference classes get L…;
    TyJava(fqcn, _) -> {
      let internal = join(str.split(fqcn, "."), "/")
      if str.starts_with(internal, "[") { internal } else { "L" ++ internal ++ ";" }
    }
    # the runtime arity, from `types.fn_arity`: a function value's evidence
    # pack is a hidden parameter of the value, so it picks the interface
    TyFn(_, _, _) -> "L" ++ fn_iface(fn_arity(t)) ++ ";"
  }

pub fn method_desc(adts: Adts, params: List[Ty], ret: Ty) -> String = {
  var ps = ""
  for p in params { ps = ps ++ desc_of(adts, p) }
  "(" ++ ps ++ ")" ++ desc_of(adts, ret)
}

## How the JVM carries a value of this type.
##
## `desc_of` says which *class*; this says which *machine representation*, and
## those are the only two questions the backend asks about a type that every
## variant has to answer. Slot width, load/store opcode, boxing and hashing all
## follow from this, so they dispatch on `JvmRepr` rather than re-deciding the
## scalar/reference split each time.
##
## The line: this answers *how a value is carried*. A function whose answer
## depends on Dawn semantics -- content equality, hashing, rendering, order --
## must stay a `Ty` match, because there a new variant inheriting `RRef` would
## be a wrong answer rather than a missing one.
pub type JvmRepr =
  | RLong # 2 slots, boxes to java.lang.Long
  | RDouble # 2 slots, boxes to java.lang.Double
  | RBool # 1 slot, boxes to java.lang.Boolean
  | RRef # 1 slot, already an Object
  | RBottom # 0 slots and no value: Never and Error

## The one function that has to account for every `Ty`. Deliberately without a
## wildcard: a new variant must fail to compile *here*, where the decision is
## a one-liner, rather than silently inherit a default in a dozen callers.
pub fn jvm_repr(t: Ty) -> JvmRepr =
  match t {
    TyOpaque(_, _, _, _, tgt) -> jvm_repr(tgt)
    TyInt -> RLong
    TyFloat -> RDouble
    TyBool -> RBool
    # Unit is a value like any other -- the dawn/rt/Unit singleton -- and the
    # only reason to say otherwise would be to save a slot for a type nobody
    # writes in a hot loop. Saying otherwise cost every position where the JVM
    # demands a descriptor: there is no way to spell zero width in one.
    TyUnit -> RRef
    TyNever -> RBottom
    TyError -> RBottom
    TyString -> RRef
    TyBytes -> RRef
    TyI64Buf -> RRef
    TyF64Buf -> RRef
    TyVar(_, _) | TyAssoc(_, _, _) -> RRef
    TyAdt(_, _) -> RRef
    TyList(_) -> RRef
    TyMap(_, _) -> RRef
    TySet(_) -> RRef
    TyArray(_) -> RRef
    TyJava(_, _) -> RRef
    TyTuple(_) -> RRef
    TyFn(_, _, _) -> RRef
  }

## JVM stack/local slots of a type (J/D = 2, void = 0).
pub fn slots_of(t: Ty) -> Int =
  match jvm_repr(t) {
    RLong -> 2
    RDouble -> 2
    RBool -> 1
    RRef -> 1
    RBottom -> 0
  }

pub fn is_ref(t: Ty) -> Bool =
  match jvm_repr(t) {
    RRef -> true
    RLong | RDouble | RBool | RBottom -> false
  }

## No value exists at all: `Never` (this expression does not return) and the
## error type. Ask this, not `slots_of(t) == 0`, wherever the question is
## "is there anything on the stack" -- width and existence were the same
## question only while Unit was zero-width, and that is what this stopped being.
pub fn is_bottom(t: Ty) -> Bool =
  match jvm_repr(t) {
    RBottom -> true
    RLong | RDouble | RBool | RRef -> false
  }

# ---- tests ----

test "descriptors and slot sizes mirror the Kotlin mapping" {
  let adts = prelude_adts()
  assert desc_of(adts, TyInt) == "J"
  assert desc_of(adts, TyBool) == "Z"
  assert desc_of(adts, TyBytes) == "[B"
  assert desc_of(adts, TyList(TyInt)) == "Lstd/pvec\$Vec;"
  assert desc_of(adts, TyTuple([TyInt, TyBool])) == "Ldawn/rt/Tuple2;"
  # the interface is picked by `types.fn_arity`, not by the written parameter
  # count: every function value carries one evidence slot, so `fn(Int) -> Bool`
  # is a Fn2 and calling it as a Fn1 is a link error -- and the row does not
  # enter into it, which is why no eta adapter exists anywhere
  assert desc_of(adts, TyFn([TyInt], TyBool, EPure)) == "Ldawn/rt/Fn2;"
  assert desc_of(adts, TyFn([TyInt], TyBool, EffVar("e", 1))) == "Ldawn/rt/Fn2;"
  assert desc_of(adts, TyFn([TyInt], TyBool, EIo)) == "Ldawn/rt/Fn2;"
  assert desc_of(adts, TyFn([], TyBool, EPure)) == "Ldawn/rt/Fn1;"
  assert desc_of(adts, opt_ty(TyInt)) == "LOption;"
  assert method_desc(adts, [TyInt, TyString], TyUnit) == "(JLjava/lang/String;)Ldawn/rt/Unit;"
  assert erased_apply_desc(2) == "(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;"
  assert slots_of(TyFloat) == 2
}

test "a Unit is an ordinary reference, and only the bottom types are void" {
  let adts = prelude_adts()
  # every shape below was a ClassFormatError while `Unit` said `V`: `V` is a
  # return descriptor and the JVM rejects it in a parameter or a field
  assert desc_of(adts, TyUnit) == "Ldawn/rt/Unit;"
  assert desc_of(adts, TyOpaque(0, "Handle", "m", [], TyUnit)) == "Ldawn/rt/Unit;"
  assert method_desc(adts, [TyUnit, TyInt], TyBool) == "(Ldawn/rt/Unit;J)Z"
  assert slots_of(TyUnit) == 1
  assert is_ref(TyUnit)
  assert not is_bottom(TyUnit)
  # the pair a later reader needs to see together: `Never` did not move, and
  # `V` is still right for it because it reaches no position but a return
  assert desc_of(adts, TyNever) == "V"
  assert slots_of(TyNever) == 0
  assert is_bottom(TyNever)
  assert is_bottom(TyError)
}

test "an impl is named by its head" {
  # Coherence gives a head at most one impl, so `List[Int]` and `List[T]` are
  # the same impl and both backends have to spell it the same way. They spell
  # it differently in one respect on purpose -- a JVM method name is read by
  # people, so an ADT contributes its declared name -- but dropping the
  # arguments is the rule, and this is where the two are held to it.
  #
  # emitc used `ty_key`, which keeps a list's element. Nothing noticed while
  # every impl subject was concrete; std's `impl[T: Show] Show[List[T]]` made
  # the call site say `List_Int` and the definition `List_Var123`.
  let adts = prelude_adts()
  let it = TyList(TyInt)
  let gen = TyList(TyVar("T", 7))
  assert subject_name(adts, it) == subject_name(adts, gen)
  assert subject_key(it) == subject_key(gen)
  assert subject_name(adts, TyMap(TyInt, TyString)) == "Map"
  assert subject_key(TyMap(TyInt, TyString)) == "Map"
  # and a subject with no arguments is still itself
  assert subject_name(adts, TyString) == "String"
  assert subject_key(TyString) == "String"
}

test "an impl static is qualified by module when the module is not its class" {
  let adts = prelude_adts()
  # declared by the class that holds the impl: the short spelling, unchanged
  assert impl_symbol(adts, "main", Some("main"), "Render", TyInt, "render") ==
    "dawn\$impl\$Render\$Int\$render"
  # the prelude has no owner and stays bare from any class
  assert impl_symbol(adts, "main", None, "Eq", TyInt, "eq") == "dawn\$impl\$Eq\$Int\$eq"
  # two traits of one short name from different modules are two statics
  let a = impl_symbol(adts, "main", Some("a"), "Render", TyInt, "render")
  let b = impl_symbol(adts, "main", Some("b"), "Render", TyInt, "render")
  assert a == "dawn\$impl\$a\$Render\$Int\$render"
  assert a != b
  # a nested module is flattened with the same `$` the dictionary classes use
  assert impl_symbol(adts, "main", Some("std/x"), "Render", TyInt, "render") ==
    "dawn\$impl\$std\$x\$Render\$Int\$render"
  # and a type another module declared carries that module too
  let t = TyOpaque(9, "Tag", "c", [], TyInt)
  let u = TyOpaque(10, "Tag", "d", [], TyInt)
  assert impl_symbol(adts, "a", Some("a"), "Render", t, "render") !=
    impl_symbol(adts, "a", Some("a"), "Render", u, "render")
  assert impl_symbol(adts, "c", Some("a"), "Render", t, "render") ==
    "dawn\$impl\$a\$Render\$Tag\$render"
}

test "the ASM interop spike: a class assembles through the shared writer" {
  # the spike just proves Dawn can drive a ClassWriter through the static
  # null adapters + MethodVisitor end to end
  let cw = Asm.plain(COMPUTE_FRAMES).expect("writer")
  # ACC_PUBLIC|ACC_FINAL = 0x11
  Asm.beginOn(cw, V52, 17, "spike/Empty", "java/lang/Object")
  let m = Asm.methodOn(cw, 9, "id", "(J)J").expect("method visitor")
  m.visitCode()
  # LLOAD 0; LRETURN
  m.visitVarInsn(22, 0)
  m.visitInsn(173)
  close_mv(m)
  cw.visitEnd()
  let bs = cw.toByteArray().expect("bytes")
  assert len(bs) > 0
}

# ---- the class file's own limits ----

## Where one emitted method was declared: the source file, and the span of the
## name it was written under. `lifted` marks a body the compiler hoisted out of
## that declaration -- a lambda, which has no name of its own and borrows the
## coordinates of the function it was written inside.
pub type MethodSite = { path: String, nlo: Int, nhi: Int, lifted: Bool }

## No method of this class is traceable to a declaration.
pub fn no_sites() -> Map[String, MethodSite] = map.empty()

## Take the bytes of a finished class writer, or report why the class file
## cannot hold them.
##
## Everything ASM refuses for size comes out here: a method over 64 KiB of
## code, a constant pool past 65,535 entries, a class the format cannot
## express. None of them is a defect in the program -- the input was accepted
## by every earlier phase -- but `.expect("bytes")` turned each into a compiler
## stack trace ending inside `MethodWriter`, with nothing in it naming what had
## been compiled (audit ARC-02).
##
## This is the form for a class nothing is known about: ASM's own text names
## the offending method and its descriptor, and with no site table that is the
## finest coordinate there is. Emitters that can say where their methods came
## from call `class_bytes_from`.
pub fn class_bytes(finish: fn() -> Option[Bytes] !io, cls: String) -> Bytes !Fs !Exit !Console !io =
  class_bytes_from(finish, cls, "", no_sites())

## The same, for a class whose methods can be traced back to source: `src` is
## the file the class was compiled from and `sites` maps each emitted method
## name to the declaration it came from.
##
## Core carries no spans, so by the time a body reaches ASM its source position
## is long gone. The table closes that gap from the side that still has it: the
## emitter holds the AST as well as the Core, and ASM's own text names the
## method it refused, which is the key.
pub fn class_bytes_from(
  finish: fn() -> Option[Bytes] !io,
  cls: String,
  src: String,
  sites: Map[String, MethodSite]
) -> Bytes !Fs !Exit !Console !io =
  match catch_fault(finish) {
    Ok(bs) -> bs.expect("bytes")
    Err(e) -> {
      console_eprint(too_large_text(e.message, cls, src, sites))
      let _ = io.exit(1)
      panic("io.exit returned")
    }
  }

## The method ASM refused, when its text names one of `cls`'s own: ASM writes
## `Method too large: <class>.<method> <descriptor>`. A class that is too large
## as a whole names no method at all, and this answers None for it.
fn asm_method_name(msg: String, cls: String) -> Option[String] =
  match str.strip_prefix(msg, "Method too large: " ++ cls ++ ".") {
    Some(rest) ->
      match str.index_of(rest, " ") {
        Some(i) -> Some(str.take(rest, i))
        None -> Some(rest)
      }
    None -> None
  }

fn size_hint(lifted: Bool, m: String) -> String = {
  let limits = "a method holds at most 64 KiB of bytecode and a class at most " ++
    "65,535 constant pool entries; split the function, or split the module"
  if lifted {
    "`" ++ m ++ "` is a lambda lifted out of the declaration marked here; " ++ limits
  } else {
    limits
  }
}

## What the compiler prints when a class file cannot hold what was compiled:
## ASM's own sentence, at the declaration the method came from when that is
## known. Kept verbatim rather than reworded, because it names the method and
## its descriptor and a replacement would know less than it does.
fn too_large_text(
  msg: String,
  cls: String,
  src: String,
  sites: Map[String, MethodSite]
) -> String !Fs = {
  let head = "`" ++ cls ++ "` does not fit in a JVM class file: " ++ msg
  match located(msg, cls, sites) {
    Some(found) -> {
      let (m, st) = found
      match io.read_file(st.path) {
        Ok(text) ->
          render(st.path, text,
            mk_diag(head, st.nlo, st.nhi, size_hint(st.lifted, m)))
        # the file moved out from under the compiler between reading it and
        # emitting: the span is unprintable, the message still stands
        Err(_) -> flat_text(head, st.path, size_hint(st.lifted, m))
      }
    }
    # no method to look up (a class over the pool limit), or one the table does
    # not know: the module's own file is the whole of what is left to say
    None -> flat_text(head, src, size_hint(false, ""))
  }
}

fn located(msg: String, cls: String, sites: Map[String, MethodSite]) ->
  Option[(String, MethodSite)] =
  match asm_method_name(msg, cls) {
    Some(m) ->
      match map.get(sites, m) {
        Some(st) -> Some((m, st))
        None -> None
      }
    None -> None
  }

fn flat_text(head: String, path: String, hint: String) -> String = {
  var out = "error: " ++ head ++ "\n"
  if path != "" { out = out ++ "  --> " ++ path ++ "\n" }
  out ++ "  = hint: " ++ hint ++ "\n"
}

## The most argument slots one JVM method can take, receiver included
## (JVMS 4.3.3). A long and a double take two each, everything else one.
pub const JVM_SLOT_LIMIT: Int = 255

## How many argument slots a method descriptor's parameter list takes.
pub fn desc_arg_slots(desc: String) -> Int = {
  let params = match str.index_of(desc, ")") {
    Some(i) -> str.take(desc, i)
    None -> desc
  }
  var n = 0
  var in_class = false
  var in_array = false
  for c in str.chars(params) {
    if in_class {
      if c == ";" { in_class = false }
    } else if c == "(" {
      ()
    } else if c == "[" {
      in_array = true
    } else if c == "L" {
      in_class = true
      n = n + 1
      in_array = false
    } else if in_array {
      # an array of anything is one reference, whatever its element
      n = n + 1
      in_array = false
    } else if c == "J" || c == "D" {
      n = n + 2
    } else {
      n = n + 1
    }
  }
  n
}

## Refuse a method the class file format cannot hold: ASM writes any
## descriptor, and the JVM then rejects the whole class at load time with
## `ClassFormatError: Too many arguments in method signature`, long after
## `dawn build` printed `wrote ...jar`. The checker cannot see this limit
## because the final shape of a method is only known here: hidden dictionary
## and evidence parameters, a closure's captures and a receiver all count, and
## an Int or Float counts twice.
##
## `descriptor` is the one the method is written under, so this reads the same
## string the class will hold. `shown` is how the message names the method;
## `key` is the name the site table knows it by. Exits like `class_bytes_from`:
## the input was accepted by every earlier phase and the limit belongs to the
## target.
pub fn check_arg_slots(
  cls: String,
  shown: String,
  key: String,
  descriptor: String,
  receiver: Bool,
  src: String,
  sites: Map[String, MethodSite]
) -> Unit !Fs !Exit !Console !io = {
  let n = desc_arg_slots(descriptor) + (if receiver { 1 } else { 0 })
  if n <= JVM_SLOT_LIMIT { return () }
  let head = shown ++ " takes " ++ to_string(n) ++ " JVM argument slots, but a method can " ++
    "take at most " ++ to_string(JVM_SLOT_LIMIT)
  let (path, lo, hi, lifted) = match map.get(sites, key) {
    Some(st) -> (st.path, st.nlo, st.nhi, st.lifted)
    None -> (src, 0, 0, false)
  }
  let hint = slot_hint(lifted)
  let located = lo > 0 || hi > 0
  let text = match io.read_file(path) {
    Ok(t) -> if located { render(path, t, mk_diag(head, lo, hi, hint)) } else { flat_text(head, path, hint) }
    Err(_) -> flat_text(head, path, hint)
  }
  console_eprint(text)
  let _ = io.exit(1)
  panic("io.exit returned")
}

fn slot_hint(lifted: Bool) -> String = {
  let counting = "an Int or Float takes two slots, and a receiver, a type-class dictionary and an " ++
    "effect evidence record take one each"
  if lifted {
    "this is a closure lifted out of the declaration marked here, and the variables it captures " ++
      "are parameters of it (" ++ counting ++ "); capture fewer variables, or group them in a record"
  } else {
    counting ++ "; group parameters in a record"
  }
}

test "argument slots are counted from the descriptor" {
  assert desc_arg_slots("()V") == 0
  assert desc_arg_slots("(JD)V") == 4
  assert desc_arg_slots("(ZLjava/lang/String;J)Ljava/lang/Object;") == 4
  # an array is one reference whatever its element, and its element's width
  # does not leak out: a `long[]` is not a long
  assert desc_arg_slots("([J[[DJ[Ljava/lang/Object;)V") == 5
  assert desc_arg_slots("(Ldawn/rt/Tuple2;I)J") == 2
}

test "a size failure is placed at the declaration it came from" {
  # ASM names the class and the method; the class is this class, so what is
  # left is the method name, and that is what the table is keyed by
  assert asm_method_name("Method too large: app/util.big (J)J", "app/util") == Some("big")
  # a method of some other class is not this table's to look up
  assert asm_method_name("Method too large: app/other.big (J)J", "app/util") == None
  # and a class over the constant pool limit names no method at all
  assert asm_method_name("Class too large: app/util", "app/util") == None

  let st = MethodSite { path = "/tmp/app.dawn", nlo = 3, nhi = 6, lifted = false }
  let sites = map.insert(no_sites(), "big", st)
  match located("Method too large: app/util.big (J)J", "app/util", sites) {
    Some(found) -> {
      let (m, got) = found
      assert m == "big"
      assert got.nlo == 3
    }
    None -> panic("the declaration was not found")
  }
  # a lifted body says so, because the caret is over the function it came out
  # of and not over anything the user wrote as a method
  assert str.contains(size_hint(true, "lambda\$2"), "lifted out of")
  assert not str.contains(size_hint(false, "big"), "lifted out of")
}

# ---- ADT classes (spec §12.2) ----

## Load a value of type `t` from a local slot (nothing for Never).
pub fn load_slot(m: MethodVisitor, t: Ty, slot: Int) -> Unit !io = {
  match jvm_repr(t) {
    RLong -> { m.visitVarInsn(OP_LLOAD, slot) }
    RDouble -> { m.visitVarInsn(OP_DLOAD, slot) }
    RBool -> { m.visitVarInsn(OP_ILOAD, slot) }
    RRef -> { m.visitVarInsn(OP_ALOAD, slot) }
    RBottom -> ()
  }
  ()
}

## Consume a value of `t` on the stack, leave its int hash (values are never null).
pub fn hash_of(m: MethodVisitor, t: Ty) -> Unit !io = {
  # deliberately a `Ty` match and not `jvm_repr`: hashing is a question about
  # Dawn *values*, not about machine representation, and routing it through
  # the representation would hide the types whose answer here has to be
  # spelled out -- `TyBytes` is one, and inheriting "it is a reference, so
  # Object.hashCode" is how it was wrong before.
  match t {
    # opacity hides the representation from other modules, not from the
    # language: an opaque Int hashes, compares and renders as that Int
    TyOpaque(_, _, _, _, tgt) -> hash_of(m, tgt)
    TyInt -> { m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "hashCode", "(J)I", false) }
    TyFloat -> {
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Double", "hashCode", "(D)I", false)
    }
    TyBool -> {
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Boolean", "hashCode", "(Z)I", false)
    }
    # content hash, to stay consistent with the content equality
    # gen_equals_method now uses for a Bytes field
    TyBytes -> {
      m.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "hashCode", "([B)I", false)
    }
    TyString | TyVar(_, _) | TyAssoc(_, _, _) | TyAdt(_, _) | TyJava(_, _) -> {
      m.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "hashCode", "()I", false)
    }
    TyList(_) | TyMap(_, _) | TySet(_) | TyArray(_) | TyI64Buf | TyF64Buf | TyTuple(_) | TyFn(_, _, _) -> {
      m.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "hashCode", "()I", false)
    }
    # Still unreachable from either caller: `Hash[Unit]` is refused, and a
    # constructor field can be neither Unit nor bottom. Left as the wildcard
    # had it -- for Unit that is at least consistent with equals, there being
    # one instance to hash.
    TyUnit | TyNever | TyError -> {
      m.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "hashCode", "()I", false)
    }
  }
  ()
}

## The ADT's `toString`: Name, Name(v0, v1), or Name { f0: v0, f1: v1 }.
##
## Not what `to_string` compiles to any more -- that is a Core body now. This
## is what `String.valueOf` finds when a panic message renders an erased value,
## and what a Java caller sees. Kept in step with the Core rendering by hand,
## which is the price of the JVM having a universal `toString` at all.
fn gen_to_string_method(cw: ClassWriter, adts: Adts, sub: String, ci: CtorI) -> Unit !io = {
  let m = Asm.methodOn(cw, ACC_PUBLIC, "toString", "()Ljava/lang/String;").expect("mv")
  m.visitCode()
  m.visitTypeInsn(OP_NEW, SB)
  m.visitInsn(OP_DUP)
  m.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  append_const(m, ci.name)
  if len(ci.fields) > 0 {
    let is_record = adt_of(adts, ci.adt).is_record
    append_const(m, if is_record { " { " } else { "(" })
    var i = 0
    for f in ci.fields {
      if i > 0 { append_const(m, ", ") }
      if is_record { append_const(m, "${f.name}: ") }
      m.visitVarInsn(OP_ALOAD, 0)
      m.visitFieldInsn(OP_GETFIELD, sub, f.name, desc_of(adts, f.ty))
      # peeled to agree with `desc_of` one line up, which peels: the field was
      # loaded at the target's width, so it must be boxed at the target's width
      match peel_opaque(f.ty) {
        TyInt -> {
          m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf",
            "(J)Ljava/lang/Long;", false)
        }
        TyFloat -> {
          m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Double", "valueOf",
            "(D)Ljava/lang/Double;", false)
        }
        TyBool -> {
          m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Boolean", "valueOf",
            "(Z)Ljava/lang/Boolean;", false)
        }
        _ -> ()
      }
      invoke_rt(m, rt_show_show())
      m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append",
        "(Ljava/lang/String;)L" ++ SB ++ ";", false)
      i = i + 1
    }
    append_const(m, if is_record { " }" } else { ")" })
  }
  m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  m.visitInsn(OP_ARETURN)
  close_mv(m)
  ()
}

## Structural equality (== in Dawn, spec §4.3); a matching hashCode follows.
fn gen_equals_method(cw: ClassWriter, adts: Adts, sub: String, ci: CtorI) -> Unit !io = {
  let m = Asm.methodOn(cw, ACC_PUBLIC, "equals", "(Ljava/lang/Object;)Z").expect("mv")
  m.visitCode()
  let yes = Label.new()
  let no = Label.new()
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitJumpInsn(OP_IF_ACMPEQ, yes)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitTypeInsn(OP_INSTANCEOF, sub)
  m.visitJumpInsn(OP_IFEQ, no)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitTypeInsn(OP_CHECKCAST, sub)
  m.visitVarInsn(OP_ASTORE, 2)
  for f in ci.fields {
    m.visitVarInsn(OP_ALOAD, 0)
    m.visitFieldInsn(OP_GETFIELD, sub, f.name, desc_of(adts, f.ty))
    m.visitVarInsn(OP_ALOAD, 2)
    m.visitFieldInsn(OP_GETFIELD, sub, f.name, desc_of(adts, f.ty))
    # peeled for the same reason as gen_to_string_method, and this is where it
    # cost most: an opaque-over-Int field loaded two longs and then compared
    # them with the reference arm, which ASM rejects while computing frames --
    # the compiler died rather than the program
    match peel_opaque(f.ty) {
      TyInt -> {
        m.visitInsn(OP_LCMP)
        m.visitJumpInsn(OP_IFNE, no)
      }
      TyFloat -> {
        m.visitInsn(OP_DCMPL)
        m.visitJumpInsn(OP_IFNE, no)
      }
      TyBool -> { m.visitJumpInsn(OP_IF_ICMPNE, no) }
      # a byte[] has no content `equals` of its own, so this arm used to make
      # a Bytes field compare by identity -- while the `==` operator on the
      # same two values compared by content. Dawn equality no longer reaches
      # this method (nothing but a host value reaches `java_eq` now), but Java
      # does: it is what a Dawn value answers when a Java caller compares it.
      # Paired with hash_of's TyBytes arm; changing one alone breaks
      # equals/hashCode.
      TyBytes -> {
        m.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "equals", "([B[B)Z", false)
        m.visitJumpInsn(OP_IFEQ, no)
      }
      _ -> {
        m.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "equals", "(Ljava/lang/Object;)Z", false)
        m.visitJumpInsn(OP_IFEQ, no)
      }
    }
  }
  m.visitLabel(yes)
  m.visitInsn(OP_ICONST_1)
  m.visitInsn(OP_IRETURN)
  m.visitLabel(no)
  m.visitInsn(OP_ICONST_0)
  m.visitInsn(OP_IRETURN)
  close_mv(m)
  ()
}

## hashCode consistent with the structural equals: h = 31*h + field.hash, seeded 1.
##
## Not what Dawn's `hash` compiles to any more -- that is a Core body, and it
## folds the constructor tag in as well, which a per-class `hashCode` has no
## need of (`equals` here checks the class first). This is what a Java caller
## sees, and what a Dawn value answers inside a `java.util.HashMap`; it is
## paired with `gen_equals_method` and changing one alone breaks that pair.
fn gen_hash_code_method(cw: ClassWriter, adts: Adts, sub: String, ci: CtorI) -> Unit !io = {
  let m = Asm.methodOn(cw, ACC_PUBLIC, "hashCode", "()I").expect("mv")
  m.visitCode()
  m.visitInsn(OP_ICONST_1)
  for f in ci.fields {
    m.visitIntInsn(OP_BIPUSH, 31)
    m.visitInsn(OP_IMUL)
    m.visitVarInsn(OP_ALOAD, 0)
    m.visitFieldInsn(OP_GETFIELD, sub, f.name, desc_of(adts, f.ty))
    hash_of(m, f.ty)
    m.visitInsn(OP_IADD)
  }
  m.visitInsn(OP_IRETURN)
  close_mv(m)
  ()
}

## The static an `impl` compiles to, for a prelude trait (`Eq`, `Hash`: no
## owning module, so nothing to qualify). `here` is the module class that holds
## the impl, which is where the static lives.
fn impl_static_name(adts: Adts, here: String, trait_name: String, subject: Ty, m: String) -> String =
  impl_symbol(adts, here, None, trait_name, subject, m)

## equals(Object) delegating to `impl Eq`: a non-instance is never equal, so
## the type test still runs first and the impl only ever sees its own type.
fn gen_forwarding_equals(
  cw: ClassWriter,
  adts: Adts,
  sub: String,
  owner: String,
  subject: Ty
) -> Unit !io = {
  let m = Asm.methodOn(cw, ACC_PUBLIC, "equals", "(Ljava/lang/Object;)Z").expect("mv")
  m.visitCode()
  let no = Label.new()
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitTypeInsn(OP_INSTANCEOF, adt_jvm_name(adt_of(adts, adt_id_of(subject))))
  m.visitJumpInsn(OP_IFEQ, no)
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitTypeInsn(OP_CHECKCAST, adt_jvm_name(adt_of(adts, adt_id_of(subject))))
  let d = desc_of(adts, subject)
  m.visitMethodInsn(OP_INVOKESTATIC, owner, impl_static_name(adts, owner, "Eq", subject, "eq"),
    "(" ++ d ++ d ++ ")Z", false)
  m.visitInsn(OP_IRETURN)
  m.visitLabel(no)
  m.visitInsn(OP_ICONST_0)
  m.visitInsn(OP_IRETURN)
  close_mv(m)
  ()
}

## hashCode() delegating to `impl Hash`; Dawn's Int is a long, so narrow it.
fn gen_forwarding_hash_code(
  cw: ClassWriter,
  adts: Adts,
  sub: String,
  owner: String,
  subject: Ty
) -> Unit !io = {
  let m = Asm.methodOn(cw, ACC_PUBLIC, "hashCode", "()I").expect("mv")
  m.visitCode()
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitMethodInsn(OP_INVOKESTATIC, owner, impl_static_name(adts, owner, "Hash", subject, "hash"),
    "(" ++ desc_of(adts, subject) ++ ")J", false)
  m.visitInsn(OP_L2I)
  m.visitInsn(OP_IRETURN)
  close_mv(m)
  ()
}

fn adt_id_of(t: Ty) -> Int =
  match t {
    TyAdt(aid, _) -> aid
    _ -> panic("impl subject is not an ADT")
  }

## Every method this backend writes takes fewer JVM arguments than this,
## receiver included. JDK 21's C2 cannot pass that many on the stack
## (JDK-8325467, fixed in JDK 26 only): measured on x86_64, a constructor of
## 53 fields compiles and one of 54 does not, and the refusal spreads to every
## caller and every method that inlines one. 32 rather than 54 because the
## limit is per platform -- JDK 26's release note says "greater than 30", and
## JDK-8342156 records x86_64 at 38 for a while -- and nothing here has been
## measured off x86_64. scripts/method-size-gate.py holds the jar to it.
pub const JVM_ARG_LIMIT: Int = 32

## Whether a constructor of `nfields` fields is too wide for a full-arity
## `<init>`: its fields plus the receiver reach JVM_ARG_LIMIT. Such a class is
## built through a no-arg constructor and field stores, and updated by
## copy-and-set (docs/record-update-design.md); every other class keeps its
## constructor and its bytecode.
pub fn wide_fields(nfields: Int) -> Bool = nfields + 1 >= JVM_ARG_LIMIT

pub fn wide_ctor(ci: CtorI) -> Bool = wide_fields(len(ci.fields))

## One ctor class: final subclass of `base` (or the record class itself).
pub fn gen_ctor_class(
  supers: List[String],
  adts: Adts,
  base: String,
  ci: CtorI,
  ov: EqOverride
) -> Bytes !Fs !Exit !Console !io = {
  let sub = ctor_jvm_name(adts, ci)
  let cw = AsmWriter.of(COMPUTE_FRAMES, supers).expect("writer")
  Asm.beginOn(cw, V52, ACC_PUBLIC + ACC_FINAL, sub, base)
  let singleton = len(ci.fields) == 0
  let wide = wide_ctor(ci)
  # a field a copy is written into after construction cannot be final: only
  # the declaring class's <init> may store one (JVMS 6.5 putfield)
  let facc = if wide { ACC_PUBLIC } else { ACC_PUBLIC + ACC_FINAL }
  for f in ci.fields {
    Asm.fieldOn(cw, facc, f.name, desc_of(adts, f.ty))
  }
  if singleton {
    Asm.fieldOn(cw, ACC_PUBLIC + ACC_STATIC + ACC_FINAL, "INSTANCE", "L" ++ sub ++ ";")
    let cl = Asm.methodOn(cw, ACC_STATIC, "<clinit>", "()V").expect("mv")
    cl.visitCode()
    cl.visitTypeInsn(OP_NEW, sub)
    cl.visitInsn(OP_DUP)
    cl.visitMethodInsn(OP_INVOKESPECIAL, sub, "<init>", "()V", false)
    cl.visitFieldInsn(OP_PUTSTATIC, sub, "INSTANCE", "L" ++ sub ++ ";")
    cl.visitInsn(OP_RETURN)
    cl.visitMaxs(2, 0)
    cl.visitEnd()
  }
  if wide {
    gen_wide_ctors(cw, adts, base, sub, ci)
  } else {
    var ps = ""
    for f in ci.fields { ps = ps ++ desc_of(adts, f.ty) }
    let acc = if singleton { ACC_PRIVATE } else { ACC_PUBLIC }
    let init = Asm.methodOn(cw, acc, "<init>", "(" ++ ps ++ ")V").expect("mv")
    init.visitCode()
    init.visitVarInsn(OP_ALOAD, 0)
    init.visitMethodInsn(OP_INVOKESPECIAL, base, "<init>", "()V", false)
    var slot = 1
    for f in ci.fields {
      init.visitVarInsn(OP_ALOAD, 0)
      load_slot(init, f.ty, slot)
      init.visitFieldInsn(OP_PUTFIELD, sub, f.name, desc_of(adts, f.ty))
      slot = slot + slots_of(f.ty)
    }
    init.visitInsn(OP_RETURN)
    close_mv(init)
  }
  # `equals`/`hashCode` are the JVM's materialisation of the Eq/Hash
  # dictionary: the collections and every derived field comparison reach the
  # relation through them, so an `impl Eq` that only changed `==` would leave
  # `a == b` and `map.get(m, b)` disagreeing. Forward them to the impl.
  let subject = TyAdt(ci.adt, [])
  match ov.eq_owner {
    Some(owner) -> gen_forwarding_equals(cw, adts, sub, owner, subject)
    None -> if not singleton { gen_equals_method(cw, adts, sub, ci) }
  }
  match ov.hash_owner {
    Some(owner) -> gen_forwarding_hash_code(cw, adts, sub, owner, subject)
    None -> if not singleton { gen_hash_code_method(cw, adts, sub, ci) }
  }
  # toString is always generated so nested/generic fields render uniformly via
  # dawn/rt/Show; the type checker gates whether it may be called
  gen_to_string_method(cw, adts, sub, ci)
  cw.visitEnd()
  class_bytes(() => cw.toByteArray(), sub)
}

## A wide constructor class's three entry points, none wider than two JVM
## arguments: `<init>()V`, which leaves every field at its default for the
## caller to store (public, because the callers are other classes and a V52
## class file has no nestmates to reach a private one through); a private copy
## constructor; and `copy$`, which is what an update calls on its base before
## storing the fields it writes. `$` keeps the name out of Dawn's identifiers.
fn gen_wide_ctors(cw: ClassWriter, adts: Adts, base: String, sub: String, ci: CtorI) -> Unit !io = {
  let self_desc = "L" ++ sub ++ ";"
  let blank = Asm.methodOn(cw, ACC_PUBLIC, "<init>", "()V").expect("mv")
  blank.visitCode()
  blank.visitVarInsn(OP_ALOAD, 0)
  blank.visitMethodInsn(OP_INVOKESPECIAL, base, "<init>", "()V", false)
  blank.visitInsn(OP_RETURN)
  close_mv(blank)
  let copy_init = Asm.methodOn(cw, ACC_PRIVATE, "<init>", "(" ++ self_desc ++ ")V").expect("mv")
  copy_init.visitCode()
  copy_init.visitVarInsn(OP_ALOAD, 0)
  copy_init.visitMethodInsn(OP_INVOKESPECIAL, base, "<init>", "()V", false)
  for f in ci.fields {
    let d = desc_of(adts, f.ty)
    copy_init.visitVarInsn(OP_ALOAD, 0)
    copy_init.visitVarInsn(OP_ALOAD, 1)
    copy_init.visitFieldInsn(OP_GETFIELD, sub, f.name, d)
    copy_init.visitFieldInsn(OP_PUTFIELD, sub, f.name, d)
  }
  copy_init.visitInsn(OP_RETURN)
  close_mv(copy_init)
  let copy = Asm.methodOn(cw, ACC_PUBLIC, "copy\$", "()" ++ self_desc).expect("mv")
  copy.visitCode()
  copy.visitTypeInsn(OP_NEW, sub)
  copy.visitInsn(OP_DUP)
  copy.visitVarInsn(OP_ALOAD, 0)
  copy.visitMethodInsn(OP_INVOKESPECIAL, sub, "<init>", "(" ++ self_desc ++ ")V", false)
  copy.visitInsn(OP_ARETURN)
  close_mv(copy)
  ()
}

## The classes of one ADT: (name, bytes) for the base (sums) and each ctor.
## Where a type overrides the structural default: the module class holding
## the impl's static method, per trait. None = keep the derived body.
pub type EqOverride = { eq_owner: Option[String], hash_owner: Option[String] }

pub fn no_override() -> EqOverride = EqOverride { eq_owner = None, hash_owner = None }

pub fn gen_adt(
  supers: List[String],
  adts: Adts,
  a: AdtI,
  ov: EqOverride
) -> List[(String, Bytes)] !Fs !Exit !Console !io = {
  let base = adt_jvm_name(a)
  if a.is_record {
    let ci = match a.ctors {
      [only] -> only
      _ -> panic("record with " ++ to_string(len(a.ctors)) ++ " ctors")
    }
    return [(base, gen_ctor_class(supers, adts, obj(), ci, ov))]
  }
  let bw = AsmWriter.of(COMPUTE_FRAMES, supers).expect("writer")
  Asm.beginOn(bw, V52, ACC_PUBLIC + ACC_ABSTRACT, base, obj())
  let bc = Asm.methodOn(bw, ACC_PROTECTED, "<init>", "()V").expect("mv")
  bc.visitCode()
  bc.visitVarInsn(OP_ALOAD, 0)
  bc.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  bc.visitInsn(OP_RETURN)
  bc.visitMaxs(1, 1)
  bc.visitEnd()
  bw.visitEnd()
  var out = [(base, class_bytes(() => bw.toByteArray(), base))]
  for ci in a.ctors {
    out = out ++ [(ctor_jvm_name(adts, ci), gen_ctor_class(supers, adts, base, ci, ov))]
  }
  out
}

## INSTANCE + private <init> + <clinit> (the Kotlin singletonScaffold).
pub fn singleton_scaffold(cw: ClassWriter, cls: String, iface: String) -> Unit !io = {
  Asm.fieldOn(cw, ACC_PUBLIC + ACC_STATIC + ACC_FINAL, "INSTANCE", "L" ++ iface ++ ";")
  let init = Asm.methodOn(cw, ACC_PRIVATE, "<init>", "()V").expect("mv")
  init.visitCode()
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  init.visitInsn(OP_RETURN)
  close_mv(init)
  let cl = Asm.methodOn(cw, ACC_STATIC, "<clinit>", "()V").expect("mv")
  cl.visitCode()
  cl.visitTypeInsn(OP_NEW, cls)
  cl.visitInsn(OP_DUP)
  cl.visitMethodInsn(OP_INVOKESPECIAL, cls, "<init>", "()V", false)
  cl.visitFieldInsn(OP_PUTSTATIC, cls, "INSTANCE", "L" ++ iface ++ ";")
  cl.visitInsn(OP_RETURN)
  close_mv(cl)
  ()
}

## The same scaffold for a dictionary that takes arguments: no INSTANCE,
## because there is nothing to share -- one field per argument and a
## constructor that binds them. `CDictApply` is what calls it.
pub fn dict_arg_field(idx: Int) -> String = "a${to_string(idx)}"

pub fn dict_ctor_desc(nargs: Int) -> String = {
  var s = "("
  for _i in 0..nargs { s = s ++ "Ljava/lang/Object;" }
  "${s})V"
}

pub fn parameterised_scaffold(cw: ClassWriter, cls: String, nargs: Int) -> Unit !io = {
  for i in 0..nargs {
    Asm.fieldOn(cw, ACC_PUBLIC + ACC_FINAL, dict_arg_field(i), "Ljava/lang/Object;")
  }
  let init = Asm.methodOn(cw, ACC_PUBLIC, "<init>", dict_ctor_desc(nargs)).expect("mv")
  init.visitCode()
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  for i in 0..nargs {
    init.visitVarInsn(OP_ALOAD, 0)
    init.visitVarInsn(OP_ALOAD, i + 1)
    init.visitFieldInsn(OP_PUTFIELD, cls, dict_arg_field(i), "Ljava/lang/Object;")
  }
  init.visitInsn(OP_RETURN)
  close_mv(init)
  ()
}

## The name an impl's subject contributes to the static it compiles to. The
## one definition: `emit.impl_method_name` and `codegen.impl_static_name` both
## spell the same name, and this used to be written out twice (a third copy,
## inlined in gen_impl_class, was deleted with that function and had drifted --
## it was missing Bytes and Cursor).
pub fn subject_name(adts: Adts, t: Ty) -> String =
  match t {
    TyInt -> "Int"
    TyFloat -> "Float"
    TyBool -> "Bool"
    TyString -> "String"
    # not writable as an impl subject in source; the prelude Eq/Hash cover them
    TyBytes -> "Bytes"
    TyI64Buf -> "I64Buf"
    TyF64Buf -> "F64Buf"
    TyAdt(aid, _) -> adt_of(adts, aid).name
    # the builtin containers, once std writes conditional impls for them.
    # Arguments are dropped on purpose: the name identifies the *impl*, and
    # coherence gives a head at most one.
    TyList(_) -> "List"
    TyMap(_, _) -> "Map"
    TySet(_) -> "Set"
    TyArray(_) -> "Array"
    TyUnit -> "Unit"
    # an opaque type is its own subject -- its impl is not its target's
    TyOpaque(_, name, _, _, _) -> name
    _ -> panic("invalid impl subject")
  }

## A name as seen from the module class `here`: bare when `here` declares it,
## otherwise led by its owning module (slash flattened to `$`, a character no
## source name holds, so the two shapes cannot meet). A type or trait declared
## nowhere in particular (the prelude) has no owner and stays bare.
##
## Relative to `here` and not always qualified because the static an impl
## compiles to lives in the impl's own class: two names can only collide there,
## and within one class "declared here" plus "declared in module M" tells every
## pair apart. It also keeps every symbol of the ordinary case -- a local trait
## or type -- byte-identical to what it was.
pub fn owner_qualified(here: String, owner: Option[String], name: String) -> String =
  match owner {
    Some(o) -> if o == here { name } else { join(str.split(o, "/"), "\$") ++ "\$" ++ name }
    None -> name
  }

## `subject_name`, but a type another module declared carries that module, so
## `a.Item` and `b.Item` implementing one trait in one class stay two statics.
pub fn subject_ref(adts: Adts, here: String, t: Ty) -> String =
  match t {
    TyAdt(aid, _) -> {
      let a = adt_of(adts, aid)
      owner_qualified(here, a.owner, a.name)
    }
    TyOpaque(_, name, owner, _, _) -> owner_qualified(here, Some(owner), name)
    _ -> subject_name(adts, t)
  }

## THE name of the static an `impl` method compiles to: dawn$impl$<Trait>$<Subject>$<m>,
## with trait and subject qualified as above. Its definition, its direct calls,
## the dictionary bridges (which call through a direct call) and the
## Eq/Hash forwarders in a record's class all spell it through this one
## function, so none of them can fall behind the others. The site table
## (emit.decl_sites) reads a declaration's *written* names and so keeps the
## short form; emit registers the qualified name against it.
pub fn impl_symbol(
  adts: Adts,
  here: String,
  trait_owner: Option[String],
  trait_name: String,
  subject: Ty,
  m: String
) -> String =
  "dawn\$impl\$" ++ owner_qualified(here, trait_owner, trait_name) ++ "\$"
  ++ subject_ref(adts, here, subject) ++ "\$" ++ m

## The class of one Core dictionary, named from the key its CDictDef carries.
##
## A dictionary belongs to the module that built it, so two modules
## forwarding the same bound get a singleton each. That is the price of the
## table being the only identity, and it is the cheaper side of the trade: a
## second derivation is a second thing that can be wrong.
pub fn dict_class(owner: String, key: String) -> String =
  "dawn/dict/" ++ join(str.split(owner, "/"), "$") ++ "$" ++ key

## Recover the concrete type from an erased Object on the stack (unerase).
pub fn emit_unerase(m: MethodVisitor, adts: Adts, t: Ty) -> Unit !io = {
  match t {
    TyOpaque(_, _, _, _, tgt) -> emit_unerase(m, adts, tgt)
    TyInt -> {
      m.visitTypeInsn(OP_CHECKCAST, "java/lang/Long")
      m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J", false)
    }
    TyFloat -> {
      m.visitTypeInsn(OP_CHECKCAST, "java/lang/Double")
      m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Double", "doubleValue", "()D", false)
    }
    TyBool -> {
      m.visitTypeInsn(OP_CHECKCAST, "java/lang/Boolean")
      m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Boolean", "booleanValue", "()Z", false)
    }
    TyString -> { m.visitTypeInsn(OP_CHECKCAST, "java/lang/String") }
    TyBytes -> { m.visitTypeInsn(OP_CHECKCAST, "[B") }
    TyI64Buf -> { m.visitTypeInsn(OP_CHECKCAST, "[J") }
    TyF64Buf -> { m.visitTypeInsn(OP_CHECKCAST, "[D") }
    TyAdt(aid, _) -> { m.visitTypeInsn(OP_CHECKCAST, adt_jvm_name(adt_of(adts, aid))) }
    TyList(_) -> { m.visitTypeInsn(OP_CHECKCAST, PVEC_CLASS) }
    TyMap(_, _) -> { m.visitTypeInsn(OP_CHECKCAST, HAMT_CLASS) }
    TySet(_) -> { m.visitTypeInsn(OP_CHECKCAST, HAMT_CLASS) }
    TyArray(_) -> { m.visitTypeInsn(OP_CHECKCAST, ARRAY_CLASS) }
    TyTuple(elems) -> { m.visitTypeInsn(OP_CHECKCAST, tuple_class(len(elems))) }
    TyJava(fqcn, _) -> {
      let internal = join(str.split(fqcn, "."), "/")
      m.visitTypeInsn(OP_CHECKCAST, internal)
    }
    TyFn(_, _, _) -> { m.visitTypeInsn(OP_CHECKCAST, fn_iface(fn_arity(t))) }
    TyUnit -> { m.visitTypeInsn(OP_CHECKCAST, UNIT_CLASS) }
    # TyVar (and a projection over one) is already erased, and the two
    # bottom types carry no value
    TyVar(_, _) | TyAssoc(_, _, _) | TyNever | TyError -> ()
  }
  ()
}

# Ordinary environments and delivered type support have separate contracts.
use std/mem
type Phantom[T] = { n: Int }
fn escaped() -> (fn() -> Int) = mem.with_mem([@s] () => {
  let make: fn() -> Phantom[I64Buf@s] = () => Phantom { n = 13 }
  () => { let p = make()
    p.n }
})
pub fn main() -> Unit !io = { let f = escaped()
  println(to_string(f())) }

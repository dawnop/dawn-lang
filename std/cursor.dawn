## Positions in a `String`. A cursor is a position rather than a count, so
## stepping through a string costs the same at every offset — where a
## code-point index costs a walk from the start (spec §11).
#
# Short names, module-qualified at the call site: `use std/cursor`, then
# `cursor.next(s, c)`. The underlying operations are compiler intrinsics; these
# wrappers give them their public, qualified spelling.
#
# A position is opaque: `Cursor` is this module's own type, and only this
# module may see it as the Int it is. Arithmetic on one is a type error
# anywhere else, which is the point — only arithmetic can conjure a position
# that lands in the middle of a surrogate pair.
#
# It used to be a type the compiler minted: a `Ty` variant, a `Head`, an entry
# in the eq/hash scalar tables and an arm in seven files. Same guarantee, and
# now no mechanism of its own — `opaque type` (spec §2.7) is the mechanism.
#
# What a position is measured in is the backend's business and nobody else's:
# a UTF-16 code-unit offset on the JVM, a UTF-8 byte offset on native, and a
# code-point index in the comptime interpreter, which has no representation to
# offset into. Every function below takes its string afresh, so within one
# string the measure never escapes and all three answer alike.
#
# The number itself is not a value anyone else may hold. It cannot be read --
# that is what `opaque` buys. It cannot be folded into a constant: the checker
# refuses a `const` of this type, because a constant is folded once and written
# into the Core both backends read (spec 7.2). And it does not print: the
# `Show` below renders `<cursor>` rather than the measure, which is why the
# same program's output does not depend on who compiled it. The number that is
# shared is `offset(s, c)`, the position counted in characters.
#
# Which leaves one seam, and it is a decision rather than an omission: a cursor
# taken from one string and used on another. An out-of-range position is
# clamped by `char`/`next`/`prev` and refused by `slice`, but an in-range one
# is indistinguishable from a position of this string, so nothing here rejects
# it and the answer differs by backend. Binding a cursor to its string needs a
# tag that is itself backend-independent (otherwise the check diverges where
# the cursor did), which costs a walk to compute and a second word in the
# hottest loop any parser has. That was weighed and declined on 2026-08-16:
# the seam is named instead. A cursor belongs to the string it came from.
# Everything else the measure could leak through is held shut by
# scripts/spike-native/cursor_currency.dawn, which runs this module's public
# answers on both backends and compares them against a written expectation.
# SEM-04, docs/codebase-audit-v2/02-types-effects-and-semantics.md.

## A position in a String: an index the language will not let you compute.
pub opaque type Cursor = Int

## The position before the first character.
pub fn start(s: String) -> Cursor = cursor_start(s)

## The position after the last character.
pub fn end(s: String) -> Cursor = cursor_end(s)

## Whether `c` is at the end of `s`.
pub fn done(s: String, c: Cursor) -> Bool = cursor_done(s, c)

## The code point at `c`, or -1 at the end.
pub fn char(s: String, c: Cursor) -> Int = cursor_char(s, c)

## The position one character forward (clamped to the end).
pub fn next(s: String, c: Cursor) -> Cursor = cursor_next(s, c)

## The position one character back (clamped to the start).
pub fn prev(s: String, c: Cursor) -> Cursor = cursor_prev(s, c)

## The text between two positions.
pub fn slice(s: String, from: Cursor, to: Cursor) -> String = cursor_slice(s, from, to)

# The three below used to be intrinsics too — `cursor_skip` and
# `index_of_from`, each with a hand-written implementation in the JVM emitter
# and another in the C runtime, and a third route in the comptime interpreter
# that reflected into the emitted JVM class. Search is not a representation
# question: it is a walk, and the walk is above. Writing it here leaves seven
# intrinsics under this module, which is the whole representation boundary
# (docs/native-backend-plan.md 14.12).

## The position just past `sub`, which is known to start at `c` — the one
## sanctioned "advance past a literal" that would otherwise be cursor arithmetic.
##
## Walks both strings together rather than counting `sub` first, so it needs no
## length and no arithmetic.
pub fn skip(s: String, c: Cursor, sub: String) -> Cursor = skip_go(s, c, sub, start(sub))

fn skip_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Cursor =
  if done(t, tc) || done(s, sc) {
    sc
  } else {
    skip_go(s, next(s, sc), t, next(t, tc))
  }

## Whether `sub` occurs in `s` starting exactly at `c`. An empty `sub` is at
## every position, including the end.
pub fn starts_at(s: String, c: Cursor, sub: String) -> Bool =
  match_go(s, c, sub, start(sub))

fn match_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Bool =
  if done(t, tc) {
    true
  } else if done(s, sc) {
    false
  } else if char(s, sc) != char(t, tc) {
    false
  } else {
    match_go(s, next(s, sc), t, next(t, tc))
  }

## The position of the first occurrence of `sub` at or after `from`, or `None`.
pub fn find(s: String, sub: String, from: Cursor) -> Option[Cursor] =
  if starts_at(s, from, sub) {
    Some(from)
  } else if done(s, from) {
    None
  } else {
    find(s, sub, next(s, from))
  }

## The position `n` characters back from `c` (clamped to the start).
pub fn back(s: String, c: Cursor, n: Int) -> Cursor =
  if n <= 0 { c } else { back(s, prev(s, c), n - 1) }

# ---- the bridge to code-point indices ----
#
# There are two ways to say where you are in a string -- a code-point `Int`
# and a `Cursor` -- and until these two functions existed there was no way to
# get from either to the other. `str.index_of` answers in the first and
# `cursor.slice` demands the second, so a scanner whose state is an `Int` (the
# TOML one, for instance) had to re-derive its position from the start of the
# string on every character: O(n) per step, O(n^2) per line. Neither of these
# makes that cheap -- each is one walk -- but one walk at the boundary is not
# one walk per character.

## The position `i` characters from the start of `s`.
##
## Clamped, not asserted: a negative `i` is the start and an `i` past the end
## is the end (spec §4.8, criterion 3, the same clause `next`, `prev` and
## `back` already answer to). Every position in a string is a legal *answer*
## here -- the guarantee `Cursor` carries is that arithmetic cannot land you
## between the halves of a surrogate pair, and walking `i` characters cannot.
##
## Named `seek` and not `at` because those two words are the language's two
## out-of-range policies and one name cannot hold both: `at` is criterion 1
## (`str.at`, `bytes.at`, `xs[i]` -- the caller asserts the position exists and
## a miss panics), this is criterion 3. Spelled `cursor.at` until v0.54.0;
## rationale in `docs/stdlib-naming.md`.
##
## O(i). Use it once, at the point where an `Int` index arrives from outside;
## a loop that calls it per character is the O(n^2) it exists to remove.
pub fn seek(s: String, i: Int) -> Cursor = seek_go(s, start(s), i)

fn seek_go(s: String, c: Cursor, i: Int) -> Cursor =
  if i <= 0 || done(s, c) { c } else { seek_go(s, next(s, c), i - 1) }

## How many characters lie before `c`: the code-point index `seek` would take.
##
## One pass, counting forward from the start, rather than the two-scan version
## `packages/json` wrote for itself.
##
## `c` must be a position in `s`. Handing it one from another string is not a
## thing this function has an answer for -- see the module note above.
pub fn offset(s: String, c: Cursor) -> Int = offset_go(s, start(s), c, 0)

fn offset_go(s: String, p: Cursor, c: Cursor, n: Int) -> Int = {
  let x: Int = p
  let y: Int = c
  if x >= y || done(s, p) { n } else { offset_go(s, next(s, p), c, n + 1) }
}

## A cursor renders as `<cursor>`: a position, without saying which. The number
## is the backend's own measure, so printing it would put "2 here, 4 there" in
## a program's output, and a third answer again when the render is folded at
## compile time. Nothing above this module can act on that number anyway.
## `offset(s, c)` is the position in characters, and characters are what every
## backend agrees on -- print that.
##
## An opaque type with no impl of its own renders as its target, which for this
## one is the measure (scripts/spike-native/show_opaque.dawn pins the general
## rule, and that this impl wins over it).
impl Show[Cursor] {
  fn show(_c: Cursor) -> String = "<cursor>"
}

## Positions in one string are ordered, and that order is the Int's. One impl
## answers every question about that order -- `<` and `list.sort` alike.
impl Ord[Cursor] {
  fn cmp(a: Cursor, b: Cursor) -> Int = {
    let x: Int = a
    let y: Int = b
    if x < y { -1 } else if x > y { 1 } else { 0 }
  }
}

# ---- tests ----
#
# The bridge functions (`seek` / `offset`) and the walks around them, checked at
# the boundaries: both ends of the string, and the one character whose UTF-16
# representation is two units. `😀` is U+1F600, a surrogate pair, so every
# clause below that says "by character" is only tested by it -- a BMP character
# cannot tell a walk by character from a walk by unit.
#
# Positions are compared through `offset`, `char` and `slice` rather than
# through the Int inside them: this module is the only one that may look, and
# a test that looks would be checking the representation instead of the promise.

test "start and end bracket the string, and the end holds no character" {
  assert done("", start(""))
  assert done("abc", end("abc"))
  assert not done("abc", start("abc"))
  assert char("abc", start("abc")) == 97
  assert char("abc", end("abc")) == 0 - 1
  assert char("", start("")) == 0 - 1
  assert slice("abc", start("abc"), end("abc")) == "abc"
  assert slice("abc", start("abc"), start("abc")) == ""
  assert slice("", start(""), end("")) == ""
}

test "next and prev step one character and clamp at both ends" {
  let s = "a😀z"
  let c1 = next(s, start(s))
  let c2 = next(s, c1)
  assert char(s, start(s)) == 97
  assert char(s, c1) == 0x1F600
  assert char(s, c2) == 122
  assert done(s, next(s, c2))
  # clamped: a step past either end stays where it was
  assert offset(s, next(s, end(s))) == 3
  assert offset(s, prev(s, start(s))) == 0
  # prev crosses the pair whole -- it never lands between the two units
  assert char(s, prev(s, end(s))) == 122
  assert char(s, prev(s, prev(s, end(s)))) == 0x1F600
  assert slice(s, prev(s, prev(s, end(s))), end(s)) == "😀z"
}

test "back walks n characters and clamps at the start" {
  let s = "abcde"
  assert slice(s, back(s, end(s), 2), end(s)) == "de"
  assert slice(s, back(s, end(s), 0), end(s)) == ""
  assert slice(s, back(s, end(s), 0 - 3), end(s)) == ""
  assert slice(s, back(s, end(s), 99), end(s)) == "abcde"
  assert slice(s, back(s, end(s), 5), end(s)) == "abcde"
  # one step back over an astral character lands before both of its units
  assert slice("a😀", back("a😀", end("a😀"), 1), end("a😀")) == "😀"
}

test "at and offset are the two directions of one bridge, and at clamps" {
  let s = "a中😀z"
  assert offset(s, seek(s, 0)) == 0
  assert offset(s, seek(s, 2)) == 2
  assert offset(s, seek(s, 4)) == 4
  # spec 4.8 criterion 3: an index outside the string is clamped, not refused
  assert offset(s, seek(s, 0 - 5)) == 0
  assert offset(s, seek(s, 99)) == 4
  assert char(s, seek(s, 1)) == 0x4E2D
  assert char(s, seek(s, 2)) == 0x1F600
  assert char(s, seek(s, 4)) == 0 - 1
  # the index counts characters, so the astral one advances it by one
  assert slice(s, seek(s, 1), seek(s, 3)) == "中😀"
  assert slice(s, seek(s, 2), seek(s, 3)) == "😀"
  assert offset(s, start(s)) == 0
  assert offset(s, end(s)) == 4
  assert offset("", start("")) == 0
  assert offset("", end("")) == 0
}

test "starts_at matches at a position, and the empty string is at every one" {
  let s = "abcabc"
  assert starts_at(s, start(s), "abc")
  assert starts_at(s, seek(s, 3), "abc")
  assert not starts_at(s, seek(s, 1), "abc")
  # running off the end is a miss, not a match on what is left
  assert not starts_at(s, seek(s, 4), "abc")
  assert starts_at(s, start(s), "")
  assert starts_at(s, end(s), "")
  assert starts_at("", start(""), "")
  assert not starts_at("", start(""), "a")
  assert starts_at("a😀", seek("a😀", 1), "😀")
}

test "find answers with a position at or after where it was told to look" {
  let s = "abcabc"
  match find(s, "bc", start(s)) {
    Some(c) -> { assert offset(s, c) == 1 }
    None -> { assert false }
  }
  match find(s, "bc", seek(s, 2)) {
    Some(c) -> { assert offset(s, c) == 4 }
    None -> { assert false }
  }
  match find(s, "z", start(s)) {
    Some(_) -> { assert false }
    None -> ()
  }
  # the empty needle is found where the search began, including at the end
  match find(s, "", seek(s, 3)) {
    Some(c) -> { assert offset(s, c) == 3 }
    None -> { assert false }
  }
  match find(s, "", end(s)) {
    Some(c) -> { assert offset(s, c) == 6 }
    None -> { assert false }
  }
}

test "skip advances past an occurrence it is told is there" {
  let s = "prefix/rest"
  assert slice(s, skip(s, start(s), "prefix/"), end(s)) == "rest"
  # nothing to skip, and nothing to skip past: both stay put
  assert slice(s, skip(s, start(s), ""), end(s)) == "prefix/rest"
  assert done(s, skip(s, end(s), "anything"))
  # a `sub` longer than what is left stops at the end rather than walking off
  assert done(s, skip(s, start(s), "prefix/rest and more"))
  assert slice("a😀z", skip("a😀z", start("a😀z"), "a😀"), end("a😀z")) == "z"
}

test "a cursor renders without its number" {
  # the number under this one is 2 on the JVM, 4 on native and 1 in the
  # comptime interpreter. Rendering it would be the one way left for that
  # difference to reach a program's output.
  let s = "😀ab"
  let c = next(s, start(s))
  assert to_string(c) == "<cursor>"
  assert "${c}" == "<cursor>"
  # nested rendering is checked from a program rather than from here: the
  # conditional `Show[List[T]]` lives in std/list, which this module does not
  # import. scripts/spike-native/cursor_currency.dawn has it.
  #
  # and the number that is shared is still reachable, by walking for it
  assert offset(s, c) == 1
}

test "positions in one string are ordered, and the order is the walk's" {
  let s = "abcd"
  assert cmp(seek(s, 0), seek(s, 1)) < 0
  assert cmp(seek(s, 2), seek(s, 2)) == 0
  assert cmp(end(s), start(s)) > 0
  assert cmp(start(s), seek(s, 0)) == 0
  assert cmp(seek(s, 99), end(s)) == 0
}

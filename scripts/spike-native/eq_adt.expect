-- constructors with fields --
Point(1,2) == Point(1,2): yes
Point(1,2) == Point(1,3): no
Point(1,2) != Point(1,3): yes
-- several arms, including a nullary one --
Circle(3) == Circle(3): yes
Circle(3) == Rect(3,3): no
Rect(2,5) == Rect(2,5): yes
Origin    == Origin   : yes
Origin    == Circle(0): no
-- recursive shapes --
Node(..) == Node(..) deep: yes
Node(..) == shallower   : no
-- records --
Rec == Rec: yes
Rec != Rec (field): yes
-- nested in the shapes the compiler itself compares --
Some(P) == Some(P): yes
Some(P) == None   : no
(P,1) == (P,1)    : yes
(P,1) == (P,2)    : no

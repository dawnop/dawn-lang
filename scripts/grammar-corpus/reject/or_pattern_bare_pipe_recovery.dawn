# expect: expected a pattern
# A bar opens an alternative, so one with no pattern after it is broken:
# `| -> x`. Recovery must discard this broken arm and still find the following
# newline-separated arm. (A leading bar before a pattern is legal since the
# syntax window, spec 5.1: accept/or_patterns.dawn has it.)
fn recover(c: Choice) -> Int =
  match c {
    | -> 0
    Right(y) -> y
  }

fn after() -> Int = 3

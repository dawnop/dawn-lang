  assert project(reads, s => None, t => None, id => None, e => None) == None
}

test "semantic reads project constructor field types and both nominal identities" {
  let reads = Some([
    ConstructorHeaderAnswer(7, ConstructorHeader { id: 8, name: "Box", is_record: true, tparams: [TyVar("T", 3)] }),
    ConstructorFields(7, 2, CtorI { adt: 8, name: "Box", fields: [FieldI { name: "value", ty: TyVar("T", 3) }] })])
  let expected = Some([
    ConstructorHeaderAnswer(17, ConstructorHeader { id: 18, name: "Box", is_record: true, tparams: [TyInt] }),
    ConstructorFields(17, 2, CtorI { adt: 18, name: "Box", fields: [FieldI { name: "value", ty: TyInt }] })])

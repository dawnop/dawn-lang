# Subject value bounds and witness support are both declared for the domain use.
use std/mem
trait Measure[T: ^{c}, ^c] { fn measure(value: T) -> Int }
impl[@s] Measure[I64Buf@s, ^{s}] {
  fn measure(value: I64Buf@s) -> Int = 0
}
pub fn main() -> Unit !io = {
  let count = mem.with_mem([@s] () => measure(mem.new(3)))
  println(to_string(count))
}

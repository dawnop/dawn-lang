# The web framework's wire types. A handler is
#   fn(Request) -> Result[Response, HttpError] !io
# — the Ok branch is a rendered response, the Err branch is mapped to an HTTP
# status by the server (JSON body {"error": message}). No exceptions anywhere:
# panics are bugs, expected failures travel in Result.
use std/char
use std/str
use std/bytes
use std/map
use json/value.{Json, JStr, JObj}
use json/render.{render}
use java "java.io.InputStream"

# No handler field, so it derives Show and can travel inside a Request.
## The matched route's metadata, handed to middleware so they can dispatch on
## `tags` instead of hardcoding paths. `None` on a Request means no route
## matched (404/405) — middleware treats an absent route as "no tags".
pub type RouteMeta = {
  method: String,
  pattern: String,
  tags: List[String],
} derive Show

## One request, as the server parsed it off the wire. Read it with the
## accessors below (`param`, `query`, `header`) rather than by hand: they carry
## the lookup rules (case-insensitive names, first value of a repeated one).
pub type Request = {
  method: String,
  # the decoded path, kept for logs and display; routing does not use it
  path: String,
  # the path exactly as it came off the wire (URI.getRawPath). Routing splits
  # *this* on "/" and decodes each segment on its own, so an encoded slash
  # (%2F) stays inside its segment instead of minting a route boundary (WEB-03).
  raw_path: String,
  # path captures, each held as the *segments* it matched: one for a `{name}`
  # capture, however many remain for a trailing `{name*}`. A tail capture used
  # to arrive pre-joined with "/", which put back exactly the ambiguity WEB-03
  # removed: a decoded slash inside one segment became a separator again and
  # `/dav/a%2Fb/c` was indistinguishable from `/dav/a/b/c`. Read a `{name}`
  # capture with `param`, a `{name*}` one with `param_segs`.
  #
  # Repetition is not why this is a list: a duplicate capture name is a route
  # table error `validate_routes` refuses at startup, so no name has two values.
  params: Map[String, List[String]],
  # the query string as a multimap: every value of a repeated name survives in
  # wire order, exactly as `headers` below does. A query string is a list of
  # pairs, not a mapping, and `?tag=a&tag=b` is the ordinary way clients spell a
  # set; this used to be Map[String, String], where the last one silently won
  # and there was no way to ask whether anything had been dropped. `query`
  # returns the first value (what the single-value map effectively held for
  # readers that never repeat a name) and `query_all` returns them all.
  query: Map[String, List[String]],
  # request headers as a lowercase-keyed multimap: every value of a repeated
  # name (Cookie, Forwarded, ...) survives in wire order (WEB-04). The
  # case-insensitivity contract is one rule applied at both ends: the server
  # lowercases keys when it builds this map, and `header`/`headers_all`
  # lowercase the name they look up. The JDK's own Title-Case normalization
  # inside Headers is deliberately not relied on — a Request built by hand in
  # a test must behave exactly like one built from the wire.
  headers: Map[String, List[String]],
  body: String,
  # the request body as raw Bytes: binary handlers (multipart upload) parse
  # structure and recover exact file bytes from here, no latin-1 detour.
  # Empty on a "stream-body" route — the body went to `body_file` instead.
  raw: Bytes,
  # Where the body landed for routes tagged "stream-body" (WebDAV PUT): the server
  # streamed the socket to this temp file instead of reading it into memory, so a
  # PUT costs a fixed buffer rather than a copy of the file. A path, not a stream:
  # an opaque Java field would cost `derive Show`, and an upload needs a file on
  # disk anyway (BodyPublishers.ofFile). The server creates and deletes it; it is
  # alive exactly for the handler's call. None on every other route.
  body_file: Option[String],
  # the matched route's metadata (method/pattern/tags), filled by the server
  # after dispatch so middleware can read `route.tags`; None when nothing matched.
  route: Option[RouteMeta],
} derive Show

# What a Response carries on the wire, as a sum: exactly one of no body, a text
# body, a binary body (first-class Bytes, spec §9.5.1, for the fm proxy
# endpoints), or a live upstream stream pumped straight to the socket (constant
# memory, first byte out immediately — fm content proxy / WebDAV serve_file for
# large media). This replaces the old body/bin/stream field triple whose
# "stream wins, then bin" rule lived in a comment (WEB-06): the impossible
# combinations no longer typecheck. The kind also decides the wire framing —
# Text/Binary get an exact Content-Length, only Stream is chunked (WEB-07, see
# web/server.body_length). An opaque InputStream isn't printable, so neither
# this nor Response derives Show (docs/streaming-response-design.md §三).
## What a Response carries: nothing, text, bytes, or a live upstream stream.
## The kind also decides the framing — Text and Binary get an exact
## Content-Length, only Stream is chunked.
pub type ResponseBody =
  | Empty
  | Text(value: String)
  | Binary(value: Bytes)
  | Stream(value: InputStream)

## One response: status, content type, extra headers in emission order, and a
## body kind. Build it with the constructors below (`text`, `json_ok`, `raw`,
## `binary`, `streaming`) and add headers with `with_header`.
pub type Response = {
  status: Int,
  content_type: String,
  # extra response headers in emission order (Location, Content-Disposition, ...)
  headers: List[(String, String)],
  body: ResponseBody,
}

# `code` is a machine-readable tag for clients that dispatch on more than the
# status (None when the message is the whole story); `headers` travel onto the
# rendered error response — a 401 is not a compliant challenge without
# WWW-Authenticate (RFC 9110 §11.6.1). `http_error` fills both empty, so plain
# call sites are untouched.
## The Err branch of a handler: the status the server will render, the message
## it will carry, an optional machine-readable `code`, and headers that ride
## onto the rendered response (a 401's WWW-Authenticate challenge).
pub type HttpError = {
  status: Int,
  message: String,
  code: Option[String],
  headers: List[(String, String)],
} derive Show

## What every route's function is: a request in, a response or an HttpError
## out. Aliases are transparent — this is documentation, not a new type.
pub alias Handler = fn(Request) -> Result[Response, HttpError] !io

## A handler transformer. `serve_app` composes a list of them with the first
## element outermost.
pub alias Middleware = fn(Handler) -> Handler

## An HttpError with no `code` and no headers — the shape almost every call
## site wants.
pub fn http_error(status: Int, message: String) -> HttpError =
  HttpError { status: status, message: message, code: None, headers: [] }

# Lift a repository/infrastructure result into a handler result.
#
# The two layers carry different error types — repos report `String`, handlers
# report `HttpError` — and `?` refuses to cross that boundary (it demands the
# error types be identical, and Dawn has no automatic conversion). Without this,
# every call down a layer needs a `match` whose Ok arm does nothing but forward,
# which wraps the real work in an extra level of nesting:
#
#   match with_db(...) {                    #   let rows = as_http(with_db(...), 500)?
#     Err(m) -> Err(http_error(500, m))     #   ...body at the function's own indent...
#     Ok(rows) -> { ...body... }            #
#   }                                       #
#
# `status` is a parameter rather than one function per code because the call
# sites use four (500 x57, 422 x19, 502 x9, 401 x1) and they differ in nothing
# else.
## Lift a repository/infrastructure `Result[T, String]` into a handler's
## `Result[T, HttpError]` under one status, so `?` can cross the layer.
pub fn as_http[T](r: Result[T, String], status: Int) -> Result[T, HttpError] =
  match r {
    Ok(v) -> Ok(v)
    Err(m) -> Err(http_error(status, m))
  }

# Same lift, but the status is chosen from the message. A few repository errors
# are client errors in disguise (a bad page reference, a duplicate slug) and the
# only thing that distinguishes them is the text, so those call sites pass a
# classifier instead of a fixed code.
## The same lift with the status chosen from the message, for repository
## errors that are client errors in disguise (a duplicate slug is a 409).
pub fn as_http_with[T](r: Result[T, String], f: fn(String) -> HttpError) -> Result[T, HttpError] =
  match r {
    Ok(v) -> Ok(v)
    Err(m) -> Err(f(m))
  }

# ---- response constructors ----

## A `text/plain; charset=utf-8` response.
pub fn text(status: Int, body: String) -> Response =
  Response { status: status, content_type: "text/plain; charset=utf-8", headers: [], body: Text(body) }

## A rendered JSON response (`application/json; charset=utf-8`) at any status.
pub fn json_response(status: Int, j: Json) -> Response =
  Response { status: status, content_type: "application/json; charset=utf-8", headers: [], body: Text(render(j)) }

## `json_response` at 200 — the ordinary success shape of a JSON API.
pub fn json_ok(j: Json) -> Response = json_response(200, j)

## A raw pre-rendered text body under any content type — the escape hatch for
## a wire format this module has no constructor for (XML, HTML, WebDAV).
pub fn raw(status: Int, content_type: String, body: String) -> Response =
  Response { status: status, content_type: content_type, headers: [], body: Text(body) }

## A binary body: raw Bytes written verbatim, with an exact Content-Length.
pub fn binary(status: Int, content_type: String, raw: Bytes) -> Response =
  Response { status: status, content_type: content_type, headers: [], body: Binary(raw) }

## A streaming body: a live InputStream pumped to the socket in constant
## memory, chunked (the length is unknown up front). The server closes the
## stream after pumping, including when the client disconnects mid-download.
##
## The length being unknown is a limit, not just a framing choice: an upstream
## that ends early with a clean EOF is indistinguishable here from one that
## delivered everything, so a truncated object is served as a complete one. A
## failed *read* is caught and logged (web/server.pump_stream); a short but
## orderly one cannot be, since telling them apart needs a length to compare
## against and nothing carries one.
pub fn streaming(status: Int, content_type: String, stream: InputStream) -> Response =
  Response { status: status, content_type: content_type, headers: [], body: Stream(stream) }

# ---- header hygiene ----
#
# A header field value is one line by definition (RFC 9110 §5.5). A CR or LF
# inside one does not travel as data — it ends the field and starts another, so
# any value built from request input (a filename, a redirect target, a proxied
# name) is a response-splitting vector until something stops them. Nothing did:
# `attachment` spliced a filename straight into a quoted-string and `redirect`
# passed its Location through untouched.
#
# These used to *delete* the offending characters, which closed the injection
# and opened a quieter hole in its place. `/download?next=/a\r\nX: 1` came back
# as a Location of `/aX: 1`, a redirect to a URL nobody asked for, emitted with
# no error anywhere, and the caller had no way to find out that the value it
# handed over is not the value that went on the wire. A header is not a
# best-effort medium: either the value can travel as written or it cannot, and
# a framework that silently rewrites it has taken a decision that belongs to
# the application. So they are predicates now, and the emitters refuse.
#
# SP and HTAB are legal in a value (both are field-content); the other C0
# controls and DEL are not.
## Whether `v` can travel as an HTTP header field value: SP, HTAB and any
## character from `!` up, but no CR, LF, other C0 control or DEL.
pub fn valid_header_value(v: String) -> Bool = {
  for c in code_points(v) {
    if not (c == '\t' || (c >= ' ' && c != '\u{007F}')) { return false }
  }
  true
}

## Whether `n` is a header field name: a non-empty RFC 9110 §5.1 token. A name
## carrying its own `:`, a space or a control would inject a field of its own.
pub fn valid_header_name(n: String) -> Bool = {
  let cs = code_points(n)
  if len(cs) == 0 { return false }
  for c in cs {
    let alnum = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
    let punct = c == '!' || c == '#' || c == '$' || c == '%' || c == '&' || c == '\'' ||
      c == '*' || c == '+' || c == '-' || c == '.' || c == '^' || c == '_' || c == '`' ||
      c == '|' || c == '~'
    if not (alnum || punct) { return false }
  }
  true
}

# The refusal, worded once, used by both `with_header` (as a panic) and
# `try_with_header` (as a 400).
fn header_problem(name: String, value: String) -> Option[String] =
  if not valid_header_name(name) {
    Some("illegal header name: " ++ to_string(name))
  } else if not valid_header_value(value) {
    Some("illegal value for header " ++ name ++ ": " ++ to_string(value))
  } else {
    None
  }

## Append one response header. Records are immutable, so this returns a new
## Response.
##
## A name that is not a token, or a value carrying a character that cannot
## travel in a field value, **panics**: this is the constructor for a header the
## program builds out of its own strings, and one it cannot send is a bug in the
## caller. (Per-request panic isolation turns it into a 500, not a dropped
## connection.) For a name or value derived from request input, either check it
## first with `valid_header_name`/`valid_header_value` or use `try_with_header`,
## which answers 400 instead.
pub fn with_header(r: Response, name: String, value: String) -> Response =
  match header_problem(name, value) {
    Some(p) -> panic(p)
    None -> Response { ..r, headers: r.headers ++ [(name, value)] }
  }

## `with_header` for a name or value derived from request input: an illegal one
## is a 400 the handler can propagate with `?`, not a panic and never a silent
## edit of the value.
pub fn try_with_header(r: Response, name: String, value: String) -> Result[Response, HttpError] =
  match header_problem(name, value) {
    Some(p) -> Err(http_error(400, p))
    None -> Ok(Response { ..r, headers: r.headers ++ [(name, value)] })
  }

# A redirect carries no content, so its body is `Empty` rather than an empty
# `Text`. The wire is the same either way (body_length maps both to -1), but
# only one of them says so.
fn bodyless(status: Int) -> Response =
  Response { status: status, content_type: "text/plain; charset=utf-8", headers: [], body: Empty }

## A redirect: status (301/302/303/307) plus a Location header, empty body.
## A Location that cannot travel as a field value panics (see `with_header`);
## `try_redirect` is the form for a target built from request input.
pub fn redirect(status: Int, location: String) -> Response =
  with_header(bodyless(status), "Location", location)

## `redirect` for a target built from request input: an illegal Location is a
## 400 rather than a panic.
pub fn try_redirect(status: Int, location: String) -> Result[Response, HttpError] =
  try_with_header(bodyless(status), "Location", location)

# Percent-encode as RFC 5987 attr-char: everything but ALPHA / DIGIT and the
# fifteen listed punctuation marks, over the *UTF-8 bytes* rather than the code
# points. Hand-rolled instead of URLEncoder because that one is
# application/x-www-form-urlencoded — it writes '+' for space and leaves '*'
# alone, and neither is an attr-char.
fn pct_encode(s: String) -> String = {
  let b = bytes.utf8(s)
  var out = ""
  var i = 0
  while i < bytes.len(b) {
    # a byte, not a character: the encoding is defined over the UTF-8 bytes,
    # so the ASCII constants are compared as the code points they are
    let c = bytes.at(b, i)
    let alnum = (c >= char.code('a') && c <= char.code('z')) ||
      (c >= char.code('A') && c <= char.code('Z')) ||
      (c >= char.code('0') && c <= char.code('9'))
    let safe = c == char.code('!') || c == char.code('#') || c == char.code('$') ||
      c == char.code('&') || c == char.code('+') || c == char.code('-') ||
      c == char.code('.') || c == char.code('^') || c == char.code('_') ||
      c == char.code('`') || c == char.code('|') || c == char.code('~')
    if alnum || safe {
      out = out ++ str.from_char(char.of(c).expect("an ASCII byte"))
    } else {
      out = out ++ "%" ++ str.to_upper(str.pad_start(to_hex(c), 2, "0"))
    }
    i = i + 1
  }
  out
}

fn to_hex(n: Int) -> String = {
  let digits = "0123456789abcdef"
  str.slice(digits, n / 16, n / 16 + 1) ++ str.slice(digits, n % 16, n % 16 + 1)
}

# The quoted-string fallback: keep printable ASCII, escape the two characters
# that end or continue a quoted-string, drop everything else (a non-ASCII byte
# has no meaning in this parameter — that is what `filename*` is for).
fn ascii_filename(name: String) -> String = {
  let cs = code_points(name)
  var out = ""
  var i = 0
  while i < len(cs) {
    let c = unwrap_or(get(cs, i), ' ')
    if c == '"' || c == '\\' {
      out = out ++ "\\" ++ str.from_char(c)
    } else if c >= ' ' && c < '\u{007F}' {
      out = out ++ str.from_char(c)
    }
    i = i + 1
  }
  out
}

# Force a download with a given filename via Content-Disposition.
#
# Two parameters, per RFC 6266 §4.1 + RFC 5987: `filename=` is a quoted-string
# and so can hold neither a bare `"` nor any non-ASCII character, while
# `filename*=` carries UTF-8 and is what every current client reads. The old
# one-parameter form spliced the name in raw, so a `"` ended the parameter, a
# `;` added new ones, and a non-ASCII name arrived mangled.
## Force a download with a given filename: Content-Disposition with both
## `filename=` (quoted ASCII) and `filename*=` (RFC 5987 UTF-8), so a name with
## quotes or non-ASCII characters arrives intact and cannot inject parameters.
pub fn attachment(content_type: String, filename: String, body: String) -> Response =
  with_header(raw(200, content_type, body), "Content-Disposition",
    "attachment; filename=\"" ++ ascii_filename(filename) ++ "\"; filename*=UTF-8''" ++
      pct_encode(filename))

# The three strings below were hardcoded to what one consumer (dawnop-site,
# whose frontend was written against FastAPI) needed: the key "detail", a
# Chinese 500 message, and a fullwidth colon copied from pydantic. A framework
# does not get to word another application's error bodies, and the wording was
# invisible from the outside — the module header above has always claimed the
# key was "error". So they are configuration now, with neutral English
# defaults, and an application that wants the old bytes states them.
## How the framework words the errors it renders itself. `detail_key` is the
## JSON object key its error body uses ({"error": message}); `internal_message`
## is the body of the 500 it renders when a handler panics; `param_separator`
## goes between a parameter's name and the complaint in a 422 from
## `query_int_bounded`.
pub type ErrorFormat = {
  detail_key: String,
  internal_message: String,
  param_separator: String,
} derive Show

## The neutral defaults: {"error": ...} bodies, "internal server error" for a
## panic, and "name: Input should be ..." for a rejected query parameter.
pub fn default_errors() -> ErrorFormat =
  ErrorFormat {
    detail_key: "error",
    internal_message: "internal server error",
    param_separator: ": ",
  }

## The server's rendering of the Err branch and of its own 404/405, worded by
## `fmt`. The error's own headers ride along (through the with_header guard),
## so a 401 can carry its WWW-Authenticate challenge.
pub fn error_response_with(fmt: ErrorFormat, e: HttpError) -> Response = {
  let base = json_response(e.status, JObj(map.from([(fmt.detail_key, JStr(e.message))])))
  fold(e.headers, base, (r, h) => {
    let (k, v) = h
    with_header(r, k, v)
  })
}

## `error_response_with` under the default wording — what a handler that
## renders an HttpError itself should call unless the application configured
## something else.
pub fn error_response(e: HttpError) -> Response = error_response_with(default_errors(), e)

# ---- request accessors ----

## A path parameter captured by a `{name}` pattern segment. Missing means the
## route table and the handler disagree, which is a programming error, hence
## 500. So does a capture that matched anything but exactly one segment: that is
## a trailing `{name*}`, whose value is a path and must be read with
## `param_segs`, since joining it here is what LIB-14 was about.
pub fn param(req: Request, name: String) -> Result[String, HttpError] =
  match map.get(req.params, name) {
    Some([v]) -> Ok(v)
    Some(_) -> Err(http_error(500,
      "path parameter $name is a tail capture; read it with param_segs"))
    None -> Err(http_error(500, "missing path parameter: $name"))
  }

## A trailing `{name*}` capture, as the path segments it matched: each decoded
## on its own, none of them joined. `[]` when the capture matched nothing (the
## bare prefix) and also when the name is absent. Joining these with "/" is the
## old behavior and is the caller's decision now: a segment may legitimately
## contain a "/" (it arrived as `%2F`), and only the caller knows whether that
## distinction matters to it.
pub fn param_segs(req: Request, name: String) -> List[String] =
  match map.get(req.params, name) {
    Some(vs) -> vs
    None -> []
  }

## `param` parsed as an integer; a non-numeric capture is a 400.
pub fn param_int(req: Request, name: String) -> Result[Int, HttpError] = {
  let raw = param(req, name)?
  match parse_int(raw) {
    Some(n) -> Ok(n)
    None -> Err(http_error(400, "path parameter $name must be an integer"))
  }
}

## A path parameter as an Option rather than a Result, for handlers that word
## their own error instead of taking the one `param_int` picks.
pub fn opt_param_int(req: Request, name: String) -> Option[Int] =
  match map.get(req.params, name) {
    Some([v]) -> parse_int(v)
    Some(_) -> None
    None -> None
  }

## One query-string parameter, exactly as it was decoded; None when absent. Of
## a repeated name this is the *first* value, the same rule as `header`.
pub fn query(req: Request, name: String) -> Option[String] =
  match map.get(req.query, name) {
    Some(vs) -> get(vs, 0)
    None -> None
  }

## Every value of a repeated query parameter, in wire order; [] when the name
## is absent. `?tag=a&tag=b` is how a client spells a set, and until the query
## map became a multimap only the last one survived.
pub fn query_all(req: Request, name: String) -> List[String] =
  match map.get(req.query, name) {
    Some(vs) -> vs
    None -> []
  }

## Strict pagination reader in the shape of FastAPI's Query(ge=lo, le=hi): an
## absent param yields the default; a present one that is non-integer or out of
## [lo, hi] is a 422. hi < 0 means no upper bound (FastAPI's `page` is ge=1 with
## no le). `fmt.param_separator` joins the parameter's name to the complaint —
## FastAPI's own error handler uses a fullwidth colon there, which is why the
## separator is configurable rather than written in.
pub fn query_int_bounded_with(fmt: ErrorFormat, req: Request, name: String, default: Int, lo: Int, hi: Int) -> Result[Int, HttpError] =
  match query(req, name) {
    None -> Ok(default)
    Some(s) -> {
      let at = name ++ fmt.param_separator
      match parse_int(s) {
        None -> Err(http_error(422, "${at}Input should be a valid integer, unable to parse string as an integer"))
        Some(n) ->
          if n < lo {
            Err(http_error(422, "${at}Input should be greater than or equal to ${to_string(lo)}"))
          } else if hi >= 0 && n > hi {
            Err(http_error(422, "${at}Input should be less than or equal to ${to_string(hi)}"))
          } else {
            Ok(n)
          }
      }
    }
  }

## `query_int_bounded_with` under the default wording ("size: Input should be
## less than or equal to 100").
pub fn query_int_bounded(req: Request, name: String, default: Int, lo: Int, hi: Int) -> Result[Int, HttpError] =
  query_int_bounded_with(default_errors(), req, name, default, lo, hi)

## A request header, looked up case-insensitively (the name is lowercased
## here; the server lowercases keys when building the map). Of a repeated name
## this is the *first* value.
pub fn header(req: Request, name: String) -> Option[String] =
  match map.get(req.headers, str.to_lower(name)) {
    Some(vs) -> get(vs, 0)
    None -> None
  }

## Every value of a repeated header, in wire order; [] when the name is absent.
## Same case-insensitive lookup as `header`.
pub fn headers_all(req: Request, name: String) -> List[String] =
  match map.get(req.headers, str.to_lower(name)) {
    Some(vs) -> vs
    None -> []
  }

test "param reads captures and flags missing ones" {
  let h: Map[String, List[String]] = map.empty()
  let q: Map[String, List[String]] = map.empty()
  let req = Request {
    method: "GET", path: "/a/42", raw_path: "/a/42",
    params: map.from([("id", ["42"])]), query: q, headers: h, body: "", raw: bytes.utf8(""), body_file: None,
    route: None,
  }
  assert param(req, "id") == Ok("42")
  assert param_int(req, "id") == Ok(42)
  match param(req, "nope") {
    Err(e) -> { assert e.status == 500 }
    Ok(_) -> { assert false }
  }
}

test "query_int_bounded: absent uses default, out-of-range and non-int are 422" {
  let h: Map[String, List[String]] = map.empty()
  let mk = (q: Map[String, List[String]]) => Request {
    method: "GET", path: "/a", raw_path: "/a", params: map.empty(), query: q, headers: h, body: "", raw: bytes.utf8(""), body_file: None,
    route: None,
  }
  # absent -> default
  assert query_int_bounded(mk(map.empty()), "page", 1, 1, -1) == Ok(1)
  # in range
  assert query_int_bounded(mk(map.from([("size", ["20"])])), "size", 10, 1, 100) == Ok(20)
  # below min -> 422
  match query_int_bounded(mk(map.from([("page", ["0"])])), "page", 1, 1, -1) {
    Err(e) -> { assert e.status == 422 }
    Ok(_) -> { assert false }
  }
  # above max -> 422
  match query_int_bounded(mk(map.from([("size", ["999"])])), "size", 10, 1, 50) {
    Err(e) -> { assert e.status == 422 }
    Ok(_) -> { assert false }
  }
  # non-integer -> 422
  match query_int_bounded(mk(map.from([("page", ["abc"])])), "page", 1, 1, -1) {
    Err(e) -> { assert e.status == 422 }
    Ok(_) -> { assert false }
  }
  # no upper bound (hi < 0): a huge page is fine
  assert query_int_bounded(mk(map.from([("page", ["99999"])])), "page", 1, 1, -1) == Ok(99999)
}

test "param_int rejects non-numbers as a client error" {
  let h: Map[String, List[String]] = map.empty()
  let q: Map[String, List[String]] = map.empty()
  let req = Request {
    method: "GET", path: "/a/x", raw_path: "/a/x",
    params: map.from([("id", ["x"])]), query: q, headers: h, body: "", raw: bytes.utf8(""), body_file: None,
    route: None,
  }
  match param_int(req, "id") {
    Err(e) -> { assert e.status == 400 }
    Ok(_) -> { assert false }
  }
}

test "header lookup is case-insensitive" {
  let req = Request {
    method: "GET", path: "/", raw_path: "/", params: map.empty(), query: map.empty(),
    headers: map.from([("authorization", ["Bearer xyz"]), ("content-type", ["application/json"])]),
    body: "", raw: bytes.utf8(""), body_file: None,
    route: None,
  }
  assert header(req, "Authorization") == Some("Bearer xyz")
  assert header(req, "CONTENT-TYPE") == Some("application/json")
  assert header(req, "missing") == None
}

test "a repeated query parameter keeps every value, in wire order" {
  let req = Request {
    method: "GET", path: "/a", raw_path: "/a", params: map.empty(),
    query: map.from([("tag", ["a", "b", "c"]), ("page", ["2"])]),
    headers: map.empty(), body: "", raw: bytes.utf8(""), body_file: None, route: None,
  }
  # query() is the single-value view: the first, matching header()
  assert query(req, "tag") == Some("a")
  # ...and nothing is dropped any more. The map used to be Map[String, String],
  # so `?tag=a&tag=b&tag=c` reached the handler as just "c".
  assert query_all(req, "tag") == ["a", "b", "c"]
  assert query_all(req, "page") == ["2"]
  assert query(req, "missing") == None
  assert query_all(req, "missing") == []
}

test "repeated request headers keep every value" {
  let req = Request {
    method: "GET", path: "/", raw_path: "/", params: map.empty(), query: map.empty(),
    headers: map.from([("cookie", ["a=1", "b=2"])]),
    body: "", raw: bytes.utf8(""), body_file: None,
    route: None,
  }
  # header() is the single-value view: the first, as it always was
  assert header(req, "Cookie") == Some("a=1")
  assert headers_all(req, "Cookie") == ["a=1", "b=2"]
  # headers_all shares header()'s case-insensitivity
  assert headers_all(req, "COOKIE") == ["a=1", "b=2"]
  assert headers_all(req, "missing") == []
}

test "response header helpers" {
  let r = with_header(json_ok(JStr("hi")), "X-A", "1")
  assert r.headers == [("X-A", "1")]
  let rd = redirect(302, "/here")
  assert rd.status == 302
  assert rd.headers == [("Location", "/here")]
  # a redirect carries no content, and says so: it used to be Text("") — the
  # same bytes on the wire, but the kind is what states the intent
  assert rd.body == Empty
  match try_redirect(303, "/there") {
    Ok(r) -> { assert r.body == Empty }
    Err(_) -> { assert false }
  }
  let at = attachment("text/markdown", "post.md", "# hi")
  assert at.headers ==
    [("Content-Disposition",
      "attachment; filename=\"post.md\"; filename*=UTF-8''post.md")]
}

test "a header that cannot travel is refused, not quietly edited" {
  # CRLF injection: the classic response-splitting payload. It used to come
  # back as ("Location", "/nextSet-Cookie: admin=1"), a redirect to a URL
  # nobody asked for, emitted with no error anywhere.
  match catch_panic(() => with_header(raw(200, "text/plain", ""), "Location",
    "/next\r\nSet-Cookie: admin=1")) {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.contains(m.message, "illegal value for header Location") }
  }
  # names are tokens: a ':' or a space in one would inject a field of its own
  match catch_panic(() => with_header(raw(200, "text/plain", ""), "X-Bad: y\r\nZ", "1")) {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.contains(m.message, "illegal header name") }
  }
  # a legal header is untouched. In particular it is no longer copied
  # character by character, so it is the very string the caller handed over
  assert with_header(raw(200, "text/plain", ""), "X-A", "a b\tc").headers == [("X-A", "a b\tc")]
}

test "the header predicates say exactly what may travel" {
  # SP and HTAB are field-content; CR, LF, the other C0 controls and DEL are not
  assert valid_header_value("a b\tc") == true
  assert valid_header_value("") == true
  assert valid_header_value("a\nb") == false
  assert valid_header_value("a\rb") == false
  assert valid_header_value("a\u{0}b") == false
  assert valid_header_value("a\u{7f}b") == false
  # a token: alphanumerics and the fifteen listed marks, and never empty
  assert valid_header_name("X-Request-Id") == true
  assert valid_header_name("!#$%&'*+-.^_`|~09aZ") == true
  assert valid_header_name("") == false
  assert valid_header_name("X Bad") == false
  assert valid_header_name("X:Bad") == false
  assert valid_header_name("X\r\nBad") == false
}

test "try_with_header answers 400 where with_header would panic" {
  # the form for a value built from request input: a handler can propagate it
  match try_with_header(raw(200, "text/plain", ""), "Location", "/next\r\nX: 1") {
    Ok(_) -> { assert false }
    Err(e) -> {
      assert e.status == 400
      assert str.contains(e.message, "illegal value for header Location")
    }
  }
  match try_with_header(raw(200, "text/plain", ""), "X Bad", "1") {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.status == 400 }
  }
  # a legal one is the same Response with_header builds
  assert try_with_header(json_ok(JStr("hi")), "X-A", "1") == Ok(with_header(json_ok(JStr("hi")), "X-A", "1"))
  # try_redirect is the same refusal on the constructor that carries a target
  match try_redirect(302, "/ok\r\nX-Evil: 1") {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.status == 400 }
  }
  assert try_redirect(302, "/here") == Ok(redirect(302, "/here"))
}

test "attachment quotes and encodes the filename" {
  let plain = attachment("text/plain", "report.txt", "")
  assert plain.headers ==
    [("Content-Disposition",
      "attachment; filename=\"report.txt\"; filename*=UTF-8''report.txt")]
  # a quote used to end the parameter and let a ';' add more
  let evil = attachment("text/plain", "a\";x=\"b", "")
  assert evil.headers ==
    [("Content-Disposition",
      "attachment; filename=\"a\\\";x=\\\"b\"; filename*=UTF-8''a%22%3Bx%3D%22b")]
  # non-ASCII survives only in filename*, which is what clients read
  let cn = attachment("text/plain", "报告.txt", "")
  assert cn.headers ==
    [("Content-Disposition",
      "attachment; filename=\".txt\"; filename*=UTF-8''%E6%8A%A5%E5%91%8A.txt")]
}

test "redirect targets cannot inject headers either" {
  # it used to answer ("Location", "/okX-Evil: 1"): injection closed, but the
  # client sent somewhere the application never named
  match catch_panic(() => redirect(302, "/ok\r\nX-Evil: 1")) {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.contains(m.message, "illegal value for header Location") }
  }
  assert redirect(302, "/here").headers == [("Location", "/here")]
}

test "constructors keep their shapes: status, content type, body kind" {
  let t = text(201, "made")
  assert t.status == 201
  assert t.content_type == "text/plain; charset=utf-8"
  assert t.headers == []
  match t.body {
    Text(s) -> { assert s == "made" }
    _ -> { assert false }
  }
  let j = json_ok(JStr("hi"))
  assert j.status == 200
  assert j.content_type == "application/json; charset=utf-8"
  match j.body {
    Text(s) -> { assert s == "\"hi\"" }
    _ -> { assert false }
  }
  let r = raw(418, "text/csv", "a,b")
  assert r.content_type == "text/csv"
  match r.body {
    Text(s) -> { assert s == "a,b" }
    _ -> { assert false }
  }
  let b = binary(200, "application/octet-stream", bytes.utf8("\u{0}\u{1}"))
  assert b.status == 200
  match b.body {
    Binary(bb) -> { assert bb == bytes.utf8("\u{0}\u{1}") }
    _ -> { assert false }
  }
}

test "http_error fills the new fields empty; error_response carries error headers" {
  let e = http_error(404, "nope")
  assert e.status == 404
  assert e.message == "nope"
  assert e.code == None
  assert e.headers == []
  # a literal-built error can carry a challenge, and error_response emits it
  let ch = HttpError {
    status: 401, message: "auth", code: Some("auth_required"),
    headers: [("WWW-Authenticate", "Basic realm=\"dawn\"")],
  }
  let r = error_response(ch)
  assert r.status == 401
  assert r.headers == [("WWW-Authenticate", "Basic realm=\"dawn\"")]
  # a plain error adds no headers
  assert error_response(e).headers == []
}

test "the error body's key is the default one, and configurable" {
  let e = http_error(404, "nope")
  # default wording: the neutral {"error": ...}
  assert error_response(e).body == Text("{\"error\":\"nope\"}")
  # an application whose clients read {"detail": ...} (FastAPI's shape, which
  # this used to be hardcoded to) states it
  let fastapi = ErrorFormat { ..default_errors(), detail_key: "detail" }
  assert error_response_with(fastapi, e).body == Text("{\"detail\":\"nope\"}")
  # the configured rendering is otherwise the same response
  assert error_response_with(fastapi, e).status == 404
  assert error_response_with(fastapi, e).content_type == "application/json; charset=utf-8"
}

test "the 422 wording separates name from complaint, by configuration" {
  let h: Map[String, List[String]] = map.empty()
  let mk = (q: Map[String, List[String]]) => Request {
    method: "GET", path: "/a", raw_path: "/a", params: map.empty(), query: q, headers: h,
    body: "", raw: bytes.utf8(""), body_file: None, route: None,
  }
  let over = mk(map.from([("size", ["999"])]))
  # default: an ASCII colon and a space
  match query_int_bounded(over, "size", 10, 1, 50) {
    Err(e) -> { assert e.message == "size: Input should be less than or equal to 50" }
    Ok(_) -> { assert false }
  }
  # pydantic's own joiner is a fullwidth colon with no space; an application
  # reproducing FastAPI byte-for-byte configures that
  let pydantic = ErrorFormat { ..default_errors(), param_separator: "：" }
  match query_int_bounded_with(pydantic, over, "size", 10, 1, 50) {
    Err(e) -> { assert e.message == "size：Input should be less than or equal to 50" }
    Ok(_) -> { assert false }
  }
  match query_int_bounded_with(pydantic, mk(map.from([("page", ["abc"])])), "page", 1, 1, -1) {
    Err(e) -> {
      assert e.message == "page：Input should be a valid integer, unable to parse string as an integer"
    }
    Ok(_) -> { assert false }
  }
  match query_int_bounded_with(pydantic, mk(map.from([("page", ["0"])])), "page", 1, 1, -1) {
    Err(e) -> { assert e.message == "page：Input should be greater than or equal to 1" }
    Ok(_) -> { assert false }
  }
}

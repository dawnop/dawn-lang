## The persistent hash map. Insert and remove answer a new map and leave
## the old one intact; keys need `Eq + Hash` (spec §2.2, §11).
#
# Short names, module-qualified at the call site: `use std/map`, then
# `map.insert(m, k, v)`. Each function forwards to the compiler primitive that
# owns the representation -- since S3 a pure-Dawn hash trie (std/hamt) rather
# than a handwritten Java one; the wrappers are what give the operations their
# public, qualified spelling.
#
# Everything that has to find an entry carries `[K: Eq + Hash]`, because
# finding one means hashing the key and comparing it, and those are the key
# type's own relations. Counting and listing entries do neither, so they stay
# unbounded -- reading a map should not ask more of its keys than storing one
# already did.
#
# Key validity (no Float/Bytes anywhere inside the key type) is enforced by the
# checker at every Map type instantiation, so these wrappers need no checks.

## A map with no entries. The key/value types come from the use site.
pub fn empty[K, V]() -> Map[K, V] = map_empty()

## A map from a list of (key, value) pairs; a repeated key keeps the last value.
pub fn from[K: Eq + Hash, V](entries: List[(K, V)]) -> Map[K, V] = map_from(entries)

## A copy with `key` bound to `value`; an existing key keeps its insertion position.
pub fn insert[K: Eq + Hash, V](m: Map[K, V], key: K, value: V) -> Map[K, V] =
  map_insert(m, key, value)

## A copy without `key`; absent keys are fine.
pub fn remove[K: Eq + Hash, V](m: Map[K, V], key: K) -> Map[K, V] = map_remove(m, key)

## The value bound to `key`, or `None`.
pub fn get[K: Eq + Hash, V](m: Map[K, V], key: K) -> Option[V] = map_get(m, key)

## Whether `key` is bound.
pub fn has[K: Eq + Hash, V](m: Map[K, V], key: K) -> Bool = map_has(m, key)

## Number of entries.
pub fn len[K, V](m: Map[K, V]) -> Int = map_size(m)

## Whether there are no entries. Cheaper to read than `len(m) == 0` and, since
## the trie keeps its own count, no cheaper to compute -- the point is that one
## question has one spelling across every container (CONTRIBUTING §naming).
pub fn is_empty[K, V](m: Map[K, V]) -> Bool = map_size(m) == 0

## The keys, in insertion order.
pub fn keys[K, V](m: Map[K, V]) -> List[K] = map_keys(m)

## The values, in insertion order of their keys.
pub fn values[K, V](m: Map[K, V]) -> List[V] = map_values(m)

## The (key, value) pairs, in insertion order.
pub fn entries[K, V](m: Map[K, V]) -> List[(K, V)] = map_entries(m)

# ---- Eq / Hash for Map ----
#
# Both are defined on the entries rather than on the structure holding them.
# A hash trie has no canonical shape: the same entries inserted in a different
# order, or with a removal in between, are a different tree. Until S3 this was
# the JVM's business -- `AbstractMap` supplied an order-independent equality
# that Dawn borrowed and could not state -- and stating it is what let the
# container become Dawn source (docs/collections-dejava-research.md §3).
#
# There is deliberately no `Ord[Map[K, V]]`: entries have no order to compare.
#
# The three walks below carry the entry count as a parameter instead of asking
# `len(es)` for it. `len` in this module is the one declared above (a module's
# own declarations shadow the prelude, spec §10.6), so it answers for maps, not
# for the entry list being walked; the count is `len(m)` either way, taken once
# at the entry point.

fn eq_go[K: Eq + Hash, V: Eq](b: Map[K, V], es: List[(K, V)], i: Int, n: Int) -> Bool =
  if i == n {
    true
  } else {
    let (k, v) = es[i]
    match get(b, k) {
      Some(bv) -> if eq(v, bv) { eq_go(b, es, i + 1, n) } else { false }
      None -> false
    }
  }

## Same size, and every entry of one present with an equal value in the other.
impl[K: Eq + Hash, V: Eq] Eq[Map[K, V]] {
  fn eq(a: Map[K, V], b: Map[K, V]) -> Bool =
    if len(a) != len(b) { false } else { eq_go(b, entries(a), 0, len(a)) }
}

fn hash_go[K: Hash, V: Hash](es: List[(K, V)], i: Int, n: Int, acc: Int) -> Int =
  if i == n {
    acc
  } else {
    let (k, v) = es[i]
    hash_go(es, i + 1, n, acc + hash(k) * 31 + hash(v))
  }

## A sum over the entries, so it does not depend on the order they come out
## in — the same requirement `eq` above is written to.
impl[K: Hash, V: Hash] Hash[Map[K, V]] {
  fn hash(m: Map[K, V]) -> Int = hash_go(entries(m), 0, len(m), 0)
}

fn show_go[K: Show, V: Show](es: List[(K, V)], i: Int, n: Int, acc: String) -> String =
  if i == n {
    acc
  } else {
    let (k, v) = es[i]
    show_go(es, i + 1, n, acc ++ (if i == 0 { "" } else { ", " }) ++
        "(" ++ show(k) ++ ", " ++ show(v) ++ ")")
  }

## The call that rebuilds it: `map.from([(k, v), ...])`. A map has no literal
## syntax, so the rendering names a function the reader can paste back
## (spec §2.2), and it is the *public* spelling of that function.
impl[K: Show, V: Show] Show[Map[K, V]] {
  fn show(m: Map[K, V]) -> String =
    "map.from([" ++ show_go(entries(m), 0, len(m), "") ++ "])"
}

# ---- iteration (prelude Iter, #44 knife 2) ----

## `for e in m` yields `(K, V)` pairs in `entries`' order. The cursor
## materialises `entries(m)` once up front and walks it by index: the trie
## has no public "next entry" today, the list's random access is O(1), and
## `map_size` is a stored count -- one allocation at the start, O(1) per
## step. If std/hamt ever grows a real cursor, `Cur` changes here and no
## caller does. Doneness asks the map, not the list: `len`/`get` are this
## module's map operations, and the entry count is the same number.
impl[K: Eq + Hash, V] Iter[Map[K, V]] {
  type Cur = (List[(K, V)], Int)
  type Item = (K, V)

  fn iter_start(m: Map[K, V]) -> (List[(K, V)], Int) = (entries(m), 0)
  fn iter_done(m: Map[K, V], c: (List[(K, V)], Int)) -> Bool = {
    let (_es, i) = c
    i >= map_size(m)
  }
  fn iter_next(m: Map[K, V], c: (List[(K, V)], Int)) -> (List[(K, V)], Int) = {
    let (es, i) = c
    (es, i + 1)
  }
  fn iter_get(m: Map[K, V], c: (List[(K, V)], Int)) -> (K, V) = {
    let (es, i) = c
    es[i]
  }
}

# `len` in this module is the map's, so the blocks below never ask a list for
# its length -- they compare whole lists instead, which is the stronger
# assertion anyway: it pins the order at the same time as the contents.
#
# Insertion order is the thing most worth pinning here. Nothing in the type
# says a hash trie has one, three of the four functions below promise it in
# prose, and a rewrite that lost it would leave every gate green.

test "get and has answer about a key; a missing one is a branch, not a panic" {
  let m: Map[String, Int] = from([("a", 1), ("b", 2)])
  assert get(m, "a") == Some(1)
  assert get(m, "b") == Some(2)
  assert has(m, "a")
  # spec 4.8 criterion 2: asking about a key that is not there is what this
  # function is for, so the answer is None and never a panic
  assert get(m, "zz") == None
  assert not has(m, "zz")
  let e: Map[String, Int] = empty()
  assert get(e, "a") == None
  assert not has(e, "a")
  assert len(e) == 0
  assert is_empty(e)
  assert not is_empty(m)
  assert len(m) == 2
  # a key whose value is itself absent-looking is still a present key
  let o: Map[String, Option[Int]] = from([("a", None)])
  assert has(o, "a")
  assert get(o, "a") == Some(None)
  # a Char keys a Map: an opaque type takes its Eq and its Hash from the type
  # it is over (spec §2.7), and Int's are what the bucketing uses. std/char is
  # checked before this module and so cannot state this itself.
  let c: Map[Char, Int] = from([('a', 1), ('中', 2)])
  assert get(c, 'a') == Some(1)
  assert get(c, '中') == Some(2)
  assert get(c, 'z') == None
}

test "insert replaces in place; remove of an absent key changes nothing" {
  let m: Map[String, Int] = from([("a", 1), ("b", 2), ("c", 3)])
  # an existing key keeps its insertion position -- the value moves, not the key
  let m2 = insert(m, "a", 9)
  assert get(m2, "a") == Some(9)
  assert keys(m2) == ["a", "b", "c"]
  assert len(m2) == 3
  # a new key goes on the end
  assert keys(insert(m, "d", 4)) == ["a", "b", "c", "d"]
  # removing and re-adding is not the same as replacing: the key loses its place
  assert keys(insert(remove(m, "a"), "a", 1)) == ["b", "c", "a"]
  # absent removals are fine, and answer an equal map
  assert remove(m, "zz") == m
  assert len(remove(m, "zz")) == 3
  let e: Map[String, Int] = empty()
  assert remove(e, "a") == e
  assert len(remove(m, "a")) == 2
  assert get(remove(m, "a"), "a") == None
  # persistent: the old map is untouched by either
  assert get(m, "a") == Some(1)
  assert keys(m) == ["a", "b", "c"]
  # `from` takes the last value for a repeated key, and the first position
  let dup = from([("a", 1), ("b", 2), ("a", 3)])
  assert get(dup, "a") == Some(3)
  assert keys(dup) == ["a", "b"]
  assert len(dup) == 2
}

test "keys, values and entries are one order, and it is insertion order" {
  let m: Map[String, Int] = from([("b", 2), ("a", 1), ("c", 3)])
  # not sorted, not hash order -- the order the keys arrived in
  assert keys(m) == ["b", "a", "c"]
  assert values(m) == [2, 1, 3]
  assert entries(m) == [("b", 2), ("a", 1), ("c", 3)]
  let e: Map[String, Int] = empty()
  assert keys(e) == []
  assert values(e) == []
  assert entries(e) == []
  # the three agree with each other, not merely with a literal
  assert entries(m) == [(keys(m)[0], values(m)[0]), (keys(m)[1], values(m)[1]),
    (keys(m)[2], values(m)[2])]
  # and they survive a round trip through `from`
  assert from(entries(m)) == m
  assert keys(from(entries(m))) == keys(m)
}

test "Eq and Hash are about the entries, not the shape holding them" {
  # the same entries in a different order, and with a removal in between, are
  # a different trie and the same map
  let a: Map[String, Int] = from([("x", 1), ("y", 2)])
  let b: Map[String, Int] = from([("y", 2), ("x", 1)])
  let c: Map[String, Int] = remove(from([("x", 1), ("y", 2), ("z", 3)]), "z")
  assert a == b
  assert a == c
  assert hash(a) == hash(b)
  assert hash(a) == hash(c)
  # ... while the order they come *out* in is still each one's own
  assert keys(a) == ["x", "y"]
  assert keys(b) == ["y", "x"]
  # size is part of it, so a subset is not equal
  assert not (a == from([("x", 1)]))
  assert not (a == from([("x", 1), ("y", 2), ("z", 3)]))
  # and so is every value
  assert not (a == from([("x", 1), ("y", 99)]))
  assert not (a == from([("x", 1), ("z", 2)]))
  let e1: Map[String, Int] = empty()
  let no_entries: List[(String, Int)] = []
  let e2: Map[String, Int] = from(no_entries)
  assert e1 == e2
  assert hash(e1) == hash(e2)
  assert not (e1 == a)
}

test "Show names the call that rebuilds it" {
  let m: Map[String, Int] = from([("a", 1), ("b", 2)])
  assert show(m) == "map.from([(\"a\", 1), (\"b\", 2)])"
  let e: Map[String, Int] = empty()
  assert show(e) == "map.from([])"
  assert show(from([("a", 1)])) == "map.from([(\"a\", 1)])"
  # the rendering follows the same order everything else here does
  assert show(from([("b", 2), ("a", 1)])) == "map.from([(\"b\", 2), (\"a\", 1)])"
}

test "for over a Map yields every entry once, in entries' order" {
  let m: Map[String, Int] = from([("b", 2), ("a", 1), ("c", 3)])
  var seen: List[(String, Int)] = []
  var n = 0
  for kv in m {
    seen = seen ++ [kv]
    n = n + 1
  }
  assert n == 3
  assert seen == entries(m)
  assert seen == [("b", 2), ("a", 1), ("c", 3)]
  let e: Map[String, Int] = empty()
  var empty_steps = 0
  for _kv in e { empty_steps = empty_steps + 1 }
  assert empty_steps == 0
}

# A static Java method reached by name, in both spellings. `UpperStatic` was
# unreachable before SYN-09: the parser turned an uppercase word after `.` into
# a field access, so this line asked for a static field of that name.
use java "fixture.Syn09"

fn require(ok: Bool, message: String) -> Unit =
  if ok { () } else { panic(message) }

pub fn main() -> Unit !io = {
  require(Syn09.UpperStatic(1) == 2, "uppercase static method")
  require(Syn09.lowerStatic(1) == 3, "lowercase static method")
  println("ok")
}

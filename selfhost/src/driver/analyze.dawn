# Module-graph resolution and whole-program analysis (the Kotlin ModuleLoader
# and Analyze): directory mode roots at <dir>/src and loads every .dawn under
# it; file mode follows the entry's use-closure. Modules come back in
# dependency order; each is then checked and comptime-evaluated with the
# accumulated exports of everything before it (std pre-seeded).

use std/io
use std/str
use std/list
use std/map
use std/set
use front/token.{Diag}
use front/ast.{Module, Decl, DUseModule, module_uses, module_fns}
use compiler_plan/source
use check/cx.{ModExports, Cx, cx_new}
use check/passes.{
  seed_prelude, pass_java_uses,
  pass_imports, pass_type_shells, pass_ctor_fields, pass_resolve_aliases,
  pass_register_traits, pass_register_impls, pass_fn_signatures,
  pass_const_decls
}
use check/checker.{check_module, exports_of, check_fn, check_fn_inferred}
use ir/interp.{eval_comptime, CtOut, CtOpts, ct_default}
use check/jsig.{Jsig, jsig_refused}
use driver/stdlib.{StdCtx, load_std}
use check/tast.{TFun, TModule}
use check/types.{Sym}
use front/parser
use front/lexer
use fspath/fspath

## One loaded module: dotted path, JVM class name, display path, source text,
## parsed AST; lex/parse diagnostics ride along. `pkg` = the `[deps]` source
## package the module came from; None = the project's own tree
## (docs/package-design.md 项目 B).
pub type LoadedModule = {
  mod_path: String,
  class_name: String,
  path: String,
  text: String,
  m: Module,
  pdiags: List[Diag],
  pkg: Option[source.PkgR]
}

## A diagnostic paired with where it should be reported (a module path for
## checked modules, a raw file path for loader-level problems).
pub type LocDiag = { path: String, d: Diag }

pub type LoadResult = { modules: List[LoadedModule], diags: List[LocDiag] }

## A path in the one spelling the compiler compares module identities by:
## absolute and normalized. The language server needs the same answer, and
## used to reach it through its own copy of this line.
pub fn canon(p: String) -> String !io = fspath.absolute(p, io.cwd())

fn seg_ok(s: String) -> Bool = {
  if s == "" { return false }
  var first = true
  for cp in code_points(s) {
    let lower = cp >= 'a' && cp <= 'z'
    let digit = cp >= '0' && cp <= '9'
    if first {
      if not (lower || cp == '_') { return false }
      first = false
    } else {
      if not (lower || digit || cp == '_') { return false }
    }
  }
  true
}
use ir/core.{CValue}

## The segments of a module path that are not legal path segments, in order.
##
## A module path IS its class name -- there is no mangling step -- and that
## holds only because every segment is `[a-z_][a-z0-9_]*`. An imported module
## gets that guarantee from its `use` path, which the loader checks below. The
## entry file does not: its name comes from the command line, so it is the one
## way a path segment the grammar cannot spell reaches class-name derivation,
## and it is checked here instead.
##
## There used to be a folding step -- non-alphanumerics to `_`, an `m_` prefix
## for a leading digit -- which is why this is a rejection and not a rename:
## the folding was not injective, so `a-b.dawn` and `a_b.dawn` compiled to the
## same class, on both backends.
fn bad_segments(mod_path: String) -> List[String] = {
  var out: List[String] = []
  for s in str.split(mod_path, "/") {
    if not seg_ok(s) { out = out ++ [s] }
  }
  out
}

## module path = file path relative to root, minus extension.
fn module_path_of(root_abs: String, file_abs: String) -> String = {
  let rel = if str.starts_with(file_abs, root_abs ++ "/") {
    str.drop(file_abs, str.len(root_abs) + 1)
  } else {
    # not under the root: just the file name
    match str.last_index_of(file_abs, "/") {
      Some(i) -> str.drop(file_abs, i + 1)
      None -> file_abs
    }
  }
  str.strip_suffix(rel, ".dawn").unwrap_or(rel)
}

## Everything .dawn under `dir`, recursively, full display paths.
fn walk_dawn(dir: String) -> List[String] !io = {
  var out: List[String] = []
  let names = match io.list_dir(dir) {
    Ok(ns) -> ns
    Err(_) -> return []
  }
  for n in names {
    let p = dir ++ "/" ++ n
    if io.is_dir(p) {
      out = out ++ walk_dawn(p)
    } else if str.ends_with(n, ".dawn") {
      out = out ++ [p]
    }
  }
  sort(out)
}

fn synthetic(path: String, msg: String, hint: String) -> LocDiag =
  LocDiag { path: path, d: Diag { msg: msg, lo: 0, hi: 0, hint: hint } }

# Planner diagnostics use a package-local record to keep this frontend out of
# compiler_plan's dependency graph. Convert only where loading adopts them.
fn planner_diags(ds: List[source.LocDiag]) -> List[LocDiag] = {
  var out: List[LocDiag] = []
  for ld in ds {
    out = out ++ [LocDiag {
      path: ld.path,
      d: Diag { msg: ld.d.msg, lo: ld.d.lo, hi: ld.d.hi, hint: ld.d.hint }
    }]
  }
  out
}

## Directory mode: root = <dir>/src, entry = <dir>/src/main.dawn (spec §10.1).
pub fn load_directory(dir: String) -> LoadResult !io = {
  let root = dir ++ "/src"
  var diags: List[LocDiag] = []
  if not io.is_dir(root) {
    diags = diags ++ [synthetic(dir,
      "project directory has no `src/` folder (expected " ++ root ++ ")",
      "a Dawn project keeps its modules under src/, with entry src/main.dawn")]
    return LoadResult { modules: [], diags: diags }
  }
  let plan = source.source_plan(source.ProjectDirectory(dir))
  let main_path = root ++ "/main.dawn"
  let main_ok = match io.read_file(main_path) {
    Ok(_) -> true
    Err(_) -> false
  }
  # a directory with a manifest may be a library package (no entry module);
  # run/build report the missing `fn main` themselves when it matters
  let has_manifest = match io.read_file(dir ++ "/dawn.toml") {
    Ok(_) -> true
    Err(_) -> false
  }
  if not main_ok && not has_manifest {
    diags = diags ++ [synthetic(dir,
      "project has no entry module (expected " ++ main_path ++ ")",
      "add src/main.dawn with `pub fn main() -> Unit !io`")]
  }
  # load every module under src/ (spec §10.5: unreferenced modules still check)
  diags = diags ++ planner_diags(plan.diags)
  let no_over: Map[String, String] = map.empty()
  resolve(root, walk_dawn(root), diags, false, plan.pkgs, no_over)
}

## Canonicalize a package module's `use` paths to the name-qualified spelling
## (`use types` → `use web/types`; an aliased dep gains the dep's real name),
## so the checker, duplicate detection and the topological sort all see one
## spelling — the Kotlin loader does the same.
fn qualify_uses(m: Module, pkg: source.PkgR) -> Module = {
  var decls: List[Decl] = []
  for d in m.decls {
    match d {
      DUseModule(segs, sel, aname, lo, hi, nlo, nhi) ->
        if segs[0] == "std" {
          decls = decls ++ [d]
        } else {
          match map.get(pkg.deps, segs[0]) {
            Some(info) ->
              if info.name == segs[0] {
                decls = decls ++ [d]
              } else {
                decls = decls ++
                  [DUseModule([info.name] ++ list.drop(segs, 1), sel, aname, lo, hi, nlo, nhi)]
              }
            None -> {
              decls = decls ++ [DUseModule([pkg.name] ++ segs, sel, aname, lo, hi, nlo, nhi)]
            }
          }
        }
      _ -> { decls = decls ++ [d] }
    }
  }
  Module { decls: decls }
}

## A package's dep under its real name — what canonicalized `use` paths carry
## (the deps map itself is keyed by this package's local aliases).
fn dep_by_name(p: source.PkgR, name: String) -> Option[source.PkgR] = {
  for k in map.keys(p.deps) {
    let info = map.get(p.deps, k).expect("dep")
    if info.name == name { return Some(info) }
  }
  None
}

## Rebuild a module with the collected alias → real-name rewrites applied
## (keyed by the old use path; everything else is untouched).
fn apply_rewrites(m: Module, rw: Map[String, List[String]]) -> Module = {
  var decls: List[Decl] = []
  for d in m.decls {
    match d {
      DUseModule(segs, sel, aname, lo, hi, nlo, nhi) ->
        match map.get(rw, join(segs, "/")) {
          Some(ns) -> { decls = decls ++ [DUseModule(ns, sel, aname, lo, hi, nlo, nhi)] }
          None -> { decls = decls ++ [d] }
        }
      _ -> { decls = decls ++ [d] }
    }
  }
  Module { decls: decls }
}

## A source read that honors editor-buffer overrides (canon path → text) —
## the Kotlin ModuleLoader.loadFile(overrides) for the language server.
fn read_over(over: Map[String, String], c: String, f: String) -> Result[String, ForeignError] !io =
  match map.get(over, c) {
    Some(t) -> Ok(t)
    None -> io.read_file(f)
  }

## File mode: root = nearest `src` ancestor, else the file's own directory;
## loads the entry plus its transitive use-closure.
pub fn load_file(file: String) -> LoadResult !io = {
  let no_over: Map[String, String] = map.empty()
  load_file_over(file, no_over)
}

## `load_file` with editor-buffer overrides.
pub fn load_file_over(file: String, over: Map[String, String]) -> LoadResult !io = {
  let plan = source.source_plan(source.SourceFile(file))
  resolve(plan.source_root, [file], planner_diags(plan.diags), true, plan.pkgs, over)
}

fn resolve(
  root: String,
  seed_files: List[String],
  diags0: List[LocDiag],
  follow_only: Bool,
  pkgs: Map[String, source.PkgR],
  over: Map[String, String]
) -> LoadResult !io = {
  var diags = diags0
  let root_abs = canon(root)
  var by_canon: Map[String, String] = map.empty()
  var by_path: Map[String, LoadedModule] = map.empty()
  var order: List[String] = []
  var queue: List[String] = []
  # load seeds
  for f in seed_files {
    let c = canon(f)
    if not map.has(by_canon, c) {
      let mod_path = module_path_of(root_abs, c)
      let bad = bad_segments(mod_path)
      if len(bad) > 0 {
        diags = diags ++ [synthetic(f,
          "`" ++ bad[0] ++ "` is not a valid module path segment",
          "a source file's name is its module path: rename it so every " ++
            "segment is a lowercase identifier ([a-z_][a-z0-9_]*)")]
        continue
      }
      match read_over(over, c, f) {
        Ok(text) -> {
          let (m, pdiags) = parser.parse_module(text)
          let mf = LoadedModule {
            mod_path: mod_path,
            class_name: mod_path,
            path: f,
            text: text,
            m: m,
            pdiags: pdiags,
            pkg: None
          }
          by_canon = map.insert(by_canon, c, mod_path)
          by_path = map.insert(by_path, mod_path, mf)
          order = order ++ [mod_path]
          queue = queue ++ [mod_path]
        }
        Err(_) -> ()
      }
    }
  }
  # follow use edges, loading dependencies on demand
  var visited: Set[String] = set.empty()
  while len(queue) > 0 {
    let mp = queue[0]
    queue = list.drop(queue, 1)
    if not set.has(visited, mp) {
      visited = set.insert(visited, mp)
      let mf = map.get(by_path, mp).expect("queued module")
      # aliased app imports canonicalized while walking edges: old path → new segs
      var rewrites: Map[String, List[String]] = map.empty()
      for u in module_uses(mf.m) {
        var bad: Option[String] = None
        for s in u.segs {
          if bad == None && not seg_ok(s) { bad = Some(s) }
        }
        match bad {
          Some(b) -> {
            diags = diags ++ [LocDiag { path: mf.path, d: Diag {
              msg: "invalid module path segment `" ++ b ++ "`",
              lo: u.nlo,
              hi: u.nhi,
              hint: "path segments are lowercase identifiers: [a-z_][a-z0-9_]*"
            } }]
            continue
          }
          None -> ()
        }
        # bundled std modules come from the compiler, not the module graph
        if u.segs[0] == "std" { continue }
        # where the target file lives and which package it belongs to: a package
        # module imports its siblings and its deps under canonical (real-name)
        # spellings; an app module hitting a [deps] alias resolves inside that
        # package — unless a local path claims the same first segment, which is
        # never shadowed silently (package-design.md §4.3). An aliased app
        # import is canonicalized to the package's real name (the spelling the
        # package's own modules load under).
        var dep_file = ""
        var dep_pkg: Option[source.PkgR] = None
        var edge_ok = true
        match mf.pkg {
          Some(p) ->
            match dep_by_name(p, u.segs[0]) {
              Some(info) -> {
                # a dependency module importing one of its own deps
                dep_file = info.root ++ "/" ++ join(list.drop(u.segs, 1), "/") ++ ".dawn"
                dep_pkg = Some(info)
              }
              None -> {
                dep_file = p.root ++ "/" ++ join(list.drop(u.segs, 1), "/") ++ ".dawn"
                dep_pkg = mf.pkg
              }
            }
          None ->
            match map.get(pkgs, u.segs[0]) {
              Some(info) -> {
                let local = root ++ "/" ++ join(u.segs, "/") ++ ".dawn"
                let local_hit = match io.read_file(local) {
                  Ok(_) -> true
                  Err(_) -> false
                }
                if local_hit {
                  diags = diags ++ [LocDiag { path: mf.path, d: Diag {
                    msg: "`" ++ u.path ++ "` is ambiguous: `" ++ u.segs[0] ++
                      "` is both a [deps] package and a local module path",
                    lo: u.nlo,
                    hi: u.nhi,
                    hint: "rename the src/" ++ u.segs[0] ++ "/ directory or the dependency alias"
                  } }]
                  edge_ok = false
                } else if len(u.segs) == 1 {
                  diags = diags ++ [LocDiag { path: mf.path, d: Diag {
                    msg: "cannot import the package `" ++ u.segs[0] ++ "` itself",
                    lo: u.nlo,
                    hi: u.nhi,
                    hint: "import one of its modules: `use " ++ u.segs[0] ++ "/<module>`"
                  } }]
                  edge_ok = false
                } else {
                  if info.name != u.segs[0] {
                    rewrites = map.insert(rewrites, u.path, [info.name] ++ list.drop(u.segs, 1))
                  }
                  dep_file = info.root ++ "/" ++ join(list.drop(u.segs, 1), "/") ++ ".dawn"
                  dep_pkg = Some(info)
                }
              }
              None -> {
                dep_file = root ++ "/" ++ join(u.segs, "/") ++ ".dawn"
              }
            }
        }
        if not edge_ok { continue }
        let dep_canon = canon(dep_file)
        if map.has(by_canon, dep_canon) {
          queue = queue ++ [map.get(by_canon, dep_canon).expect("canon")]
        } else {
          match read_over(over, dep_canon, dep_file) {
            Ok(text) -> {
              let (m2p, pdiags2) = parser.parse_module(text)
              let (mod_path, cls, m2) = match dep_pkg {
                Some(p) -> {
                  let internal = module_path_of(p.root, dep_canon)
                  (p.name ++ "/" ++ internal,
                    "dawn\$pkg\$" ++ p.name ++ "/" ++ internal,
                    qualify_uses(m2p, p))
                }
                None -> {
                  let mp = module_path_of(root_abs, dep_canon)
                  (mp, mp, m2p)
                }
              }
              let mf2 = LoadedModule {
                mod_path: mod_path,
                class_name: cls,
                path: dep_file,
                text: text,
                m: m2,
                pdiags: pdiags2,
                pkg: dep_pkg
              }
              by_canon = map.insert(by_canon, dep_canon, mod_path)
              by_path = map.insert(by_path, mod_path, mf2)
              order = order ++ [mod_path]
              queue = queue ++ [mod_path]
            }
            Err(_) -> {
              diags = diags ++ [LocDiag { path: mf.path, d: Diag {
                msg: "cannot find module `" ++ u.path ++ "`",
                lo: u.nlo,
                hi: u.nhi,
                hint: "expected a file at " ++ dep_file
              } }]
            }
          }
        }
      }
      if len(map.keys(rewrites)) > 0 {
        by_path = map.insert(by_path, mp,
          LoadedModule { ..mf, m: apply_rewrites(mf.m, rewrites) })
      }
    }
  }
  # the std/ path prefix is reserved for the bundled standard library
  for mp in order {
    if mp == "std" || str.starts_with(mp, "std/") {
      let mf = map.get(by_path, mp).expect("module")
      diags = diags ++ [LocDiag { path: mf.path, d: Diag {
        msg: "the module path `" ++ mp ++ "` is reserved for the bundled standard library",
        lo: 0,
        hi: 0,
        hint: "move the file out of src/std"
      } }]
    }
  }
  # duplicate-import detection (same module, same *kind*, twice in one file).
  # `use std/cursor` and `use std/cursor.{Cursor}` are not duplicates: one
  # binds a module alias to call through, the other binds names. A module that
  # exports both functions and a type needs both, and the qualified spelling
  # is the whole point of the former.
  for mp in order {
    let mf = map.get(by_path, mp).expect("module")
    var seen: Set[(String, Bool)] = set.empty()
    for u in module_uses(mf.m) {
      var all_ok = true
      for s in u.segs {
        if not seg_ok(s) { all_ok = false }
      }
      if all_ok {
        let sel = match u.selective {
          Some(_) -> true
          None -> false
        }
        if set.has(seen, (u.path, sel)) {
          diags = diags ++ [LocDiag { path: mf.path, d: Diag {
            msg: "module `" ++ u.path ++ "` is imported more than once",
            lo: u.nlo,
            hi: u.nhi,
            hint: ""
          } }]
        }
        seen = set.insert(seen, (u.path, sel))
      }
    }
  }
  # topological order + cycle detection over the use graph
  let (ordered, diags2) = topo_sort(order, by_path, diags)
  LoadResult { modules: ordered, diags: diags2 }
}

## Depth-first topological sort; on the first back edge, report the cycle path.
fn topo_sort(
  order: List[String],
  by_path: Map[String, LoadedModule],
  diags0: List[LocDiag]
) -> (List[LoadedModule], List[LocDiag]) !io = {
  var diags = diags0
  var state: Map[String, Int] = map.empty()
  var out: List[LoadedModule] = []
  var cycle_reported = false
  # an explicit work stack: (path, next edge index); edges resolved up front
  fn edges_of(mf: LoadedModule) -> List[String] = {
    var es: List[String] = []
    for u in module_uses(mf.m) {
      if map.has(by_path, u.path) { es = es ++ [u.path] }
    }
    es
  }
  for start in order {
    var stack: List[(String, Int)] = []
    if not map.has(state, start) {
      stack = [(start, 0)]
      state = map.insert(state, start, 0)
    }
    while len(stack) > 0 {
      let (mp, ei) = stack[len(stack) - 1]
      let mf = map.get(by_path, mp).expect("module")
      let es = edges_of(mf)
      if ei >= len(es) {
        stack = list.take(stack, len(stack) - 1)
        state = map.insert(state, mp, 1)
        out = out ++ [mf]
      } else {
        stack = list.take(stack, len(stack) - 1) ++ [(mp, ei + 1)]
        let dep = es[ei]
        match map.get(state, dep) {
          Some(1) -> ()
          Some(_) -> {
            # a back edge: the cycle is the stack from dep onward
            if not cycle_reported {
              cycle_reported = true
              var names: List[String] = []
              var take = false
              for entry in stack {
                let (p, _) = entry
                if p == dep { take = true }
                if take { names = names ++ [p] }
              }
              names = names ++ [dep]
              let head = map.get(by_path, names[0]).expect("module")
              var ulo = 0
              var uhi = 0
              for u in module_uses(head.m) {
                if u.path == names[1] && ulo == 0 && uhi == 0 {
                  ulo = u.nlo
                  uhi = u.nhi
                }
              }
              diags = diags ++ [LocDiag { path: head.path, d: Diag {
                msg: "circular module dependency: " ++ join(names, " → "),
                lo: ulo,
                hi: uhi,
                hint: "modules must form a directed acyclic graph (spec §10.5)"
              } }]
            }
          }
          None -> {
            state = map.insert(state, dep, 0)
            stack = stack ++ [(dep, 0)]
          }
        }
      }
    }
  }
  (out, diags)
}

# ---- whole-program analysis ----

pub type CheckedMod = {
  mod_path: String,
  class_name: String,
  path: String,
  m: Module,
  cx: Cx,
  tm: TModule,
  ct: CtOut
}

pub type Program = { modules: List[CheckedMod], diags: List[LocDiag] }

fn empty_tmodule() -> TModule = {
  let no_syms: Map[Int, Sym] = map.empty()
  TModule { fns: [], consts: [], tests: [], syms: no_syms }
}

fn empty_ctout() -> CtOut = {
  let no_c: Map[String, CValue] = map.empty()
  let no_b: Map[(Int, Int), CValue] = map.empty()
  CtOut { diags: [], consts: no_c, blocks: no_b }
}

## Check a loaded program in dependency order: each module sees the exports of
## everything before it (std pre-seeded); comptime runs on clean modules only.
pub fn analyze_program(loaded: LoadResult, std: StdCtx, opts: CtOpts, js: Jsig) -> Program !io = {
  var diags = loaded.diags
  var exports = std.exports
  var out: List[CheckedMod] = []
  # ids continue across modules so grafted ADT/trait ids never collide
  var nid = std.next_id
  # The program's impls, accumulated the way `exports` is -- but for a
  # different reason. An export is reachable only through a `use`; an impl is
  # in force everywhere (spec §3.5), so this table is not what the importer
  # asked for, it is the whole program's.
  #
  # Dependency order is enough to have every impl that can matter: the orphan
  # rule puts an impl in the module declaring the trait or the one declaring
  # the subject, so a module able to name both has already been preceded by
  # whichever of the two wrote it.
  var impls = std.impls
  for mf in loaded.modules {
    for d in mf.pdiags { diags = diags ++ [LocDiag { path: mf.path, d: d }] }
    let parse_failed = len(mf.pdiags) > 0
    var cx = cx_new(Some(mf.class_name), Some(mf.path))
    cx = Cx {
      ..cx,
      std_fns: std.std_fns,
      moved: std.moved,
      line_starts: lexer.line_starts_of(mf.text),
      next_id: nid,
      # std's impls are part of the baseline, not something `use` turns on --
      # and neither are the ones the modules before this got to
      impl_table: impls,
      # the host's Java signature oracle: jreflect's on the JVM driver, the
      # refusing default anywhere else (a native compiler refuses `use java`)
      jsig: js
    }
    var tm = empty_tmodule()
    var ct = empty_ctout()
    if not parse_failed {
      let (cx1, tm1) = check_module(cx, mf.m, exports)
      cx = cx1
      tm = tm1
      if len(cx.diags) == 0 {
        ct = eval_comptime(tm, std.fn_decls, std.by_owner, std.impl_fns, std.std_names,
          cx.adts, cx.traits, cx.impl_table, mf.class_name, opts)
      }
      for d in cx.diags { diags = diags ++ [LocDiag { path: mf.path, d: d }] }
      for d in ct.diags { diags = diags ++ [LocDiag { path: mf.path, d: d }] }
    }
    nid = cx.next_id
    # registration already rejected anything that collided with a key already
    # in this table, so every row here is either new or the one put there
    for pr in map.entries(cx.impl_table) {
      let (k, v) = pr
      impls = map.insert(impls, k, v)
    }
    exports = map.insert(exports, mf.mod_path, exports_of(cx, mf.m, mf.mod_path, mf.class_name))
    out = out ++ [CheckedMod {
      mod_path: mf.mod_path,
      class_name: mf.class_name,
      path: mf.path,
      m: mf.m,
      cx: cx,
      tm: tm,
      ct: ct
    }]
  }
  Program { modules: out, diags: diags }
}

# ---- single-document analysis (the language server's entry) ----

## The Kotlin fast-path test `(?m)^\s*use\s+[a-z]`: any line whose first token
## is `use` followed by a lowercase letter. (`pub use` deliberately does not
## match — the quirk is part of the contract.)
fn has_module_use(text: String) -> Bool = {
  for line in str.split(text, "\n") {
    let cps = code_points(line)
    let n = len(cps)
    var i = 0
    while i < n && is_ws(cps[i]) { i = i + 1 }
    if i + 3 <= n && cps[i] == 'u' && cps[i + 1] == 's' && cps[i + 2] == 'e' {
      var j = i + 3
      if j < n && is_ws(cps[j]) {
        while j < n && is_ws(cps[j]) { j = j + 1 }
        if j < n && cps[j] >= 'a' && cps[j] <= 'z' { return true }
      }
    }
  }
  false
}

## Java's regex `\s`: space, tab, newline, vertical tab, form feed, return.
fn is_ws(cp: Char) -> Bool =
  cp == ' ' || cp == '\t' || cp == '\n' || cp == '\u{000B}' || cp == '\u{000C}' || cp == '\r'

## Every `.dawn` file under `root`, as `prefix` ++ its module path → the file.
## `std/...` is skipped wherever it comes from: the prefix is reserved for the
## bundled library, and `resolve` rejects a project module that claims it.
fn add_tree(
  out0: Map[String, String],
  root: String,
  prefix: String
) -> Map[String, String] !io = {
  var out = out0
  for f in walk_dawn(root) {
    let mp = prefix ++ module_path_of(root, f)
    if len(bad_segments(mp)) == 0 && mp != "std" && not str.starts_with(mp, "std/") {
      out = map.insert(out, mp, f)
    }
  }
  out
}

## Every module path a `use` in `file` could name, mapped to the file behind
## it: the project's own modules under the nearest `src` root, plus each
## `[deps]` package's modules under the alias the manifest spells it with.
##
## The loader runs this relation forward -- `use a/b` names `<root>/a/b.dawn`
## -- and completion needs it backward. That has to be a directory walk and
## cannot be a read of what the program already loaded: the language server
## analyses one buffer and follows only the `use` edges that buffer already
## has, so the module being completed is by construction not among them.
##
## std is deliberately absent. It is bundled rather than on disk beside the
## project, and its exports are already in the server's hand (StdCtx), which
## is a better source than a path that may not exist.
##
## Dependency resolution is the loader's own, so a cold url dep is fetched
## here the way `dawn check` would fetch it. In the editor the buffer's own
## analysis has just run the same resolution, so the cache is warm and this
## costs the walk only.
pub fn use_candidates(file: String) -> Map[String, String] !io = {
  var out: Map[String, String] = map.empty()
  # a buffer with no file behind it (`<lsp>`) has no tree to walk, and canon()
  # would resolve that placeholder against the server's own directory
  if not str.ends_with(file, ".dawn") { return out }
  let plan = source.source_plan(source.SourceFile(file))
  let root = canon(plan.source_root)
  out = add_tree(out, root, "")
  for key in map.keys(plan.pkgs) {
    let p = map.get(plan.pkgs, key).expect("resolved dep")
    out = add_tree(out, p.root, key ++ "/")
  }
  out
}

## The module path a file's *name* alone would give it: the basename minus
## `.dawn`. None for a buffer with no file behind it (`<lsp>`, an editor's
## untitled document) -- there is no name to judge.
fn entry_name_of(path: String) -> Option[String] = {
  if not str.ends_with(path, ".dawn") { return None }
  let base = match str.last_index_of(path, "/") {
    Some(i) -> str.drop(path, i + 1)
    None -> path
  }
  Some(str.strip_suffix(base, ".dawn").unwrap_or(base))
}

## Analyze one buffer without project context (the Kotlin `analyze(text)`).
##
## The entry's name is checked here for the same reason `resolve` checks its
## seeds: a module path IS a class name, and this is the other way a file name
## reaches class-name derivation. `mod_path` stays "main" rather than becoming
## the file's name -- a buffer analysed alone is not a module in any program,
## and its identity is nobody's to see -- so the check is the only thing this
## borrows from the loader. Without it the editor silently accepted a file
## `dawn check` refuses to compile.
##
## Unlike `resolve`, which skips the seed, the buffer is still analysed: the
## name is wrong, the contents are still worth checking, and an editor can
## show both at once.
pub fn analyze_standalone(
  path: String,
  text: String,
  std: StdCtx,
  opts: CtOpts,
  js: Jsig
) -> Program !io = {
  let (m, pdiags) = parser.parse_module(text)
  var diags: List[LocDiag] = []
  match entry_name_of(path) {
    Some(nm) -> {
      let bad = bad_segments(nm)
      if len(bad) > 0 {
        diags = diags ++ [synthetic(path,
          "`" ++ bad[0] ++ "` is not a valid module path segment",
          "a source file's name is its module path: rename it so every " ++
            "segment is a lowercase identifier ([a-z_][a-z0-9_]*)")]
      }
    }
    None -> ()
  }
  let mf = LoadedModule {
    mod_path: "main",
    class_name: "main",
    path: path,
    text: text,
    m: m,
    pdiags: pdiags,
    pkg: None
  }
  analyze_program(LoadResult { modules: [mf], diags: diags }, std, opts, js)
}

## Analyze the file behind an editor buffer (the Kotlin `analyzeDocument`):
## no module imports → standalone; otherwise load the project with the buffer
## text overriding the on-disk file, so unsaved edits see cross-module context.
## Returns the whole program (cross-file definition targets need the other
## modules' ASTs) plus the entry's mod_path; the entry's own diagnostics are
## the prog.diags rows whose path is the entry file.
pub fn analyze_document(
  path: String,
  text: String,
  std: StdCtx,
  opts: CtOpts,
  js: Jsig
) -> (Program, String) !io = {
  if not has_module_use(text) {
    return (analyze_standalone(path, text, std, opts, js), "main")
  }
  let abs = canon(path)
  var over: Map[String, String] = map.empty()
  over = map.insert(over, abs, text)
  let loaded = load_file_over(path, over)
  var entry = ""
  for mf in loaded.modules {
    if entry == "" && canon(mf.path) == abs { entry = mf.mod_path }
  }
  if entry == "" {
    return (analyze_standalone(path, text, std, opts, js), "main")
  }
  (analyze_program(loaded, std, opts, js), entry)
}

# ---- tests ----

fn mkdirs(p: String) -> Unit !io = {
  let _ = io.mkdirs(p)
  ()
}

fn put(p: String, text: String) -> Unit !io =
  match io.write_file(p, text) {
    Ok(_) -> ()
    Err(e) -> panic("test setup: " ++ e.message)
  }

test "a two-module project analyzes end to end" {
  let root = "/tmp/dawn-selfhost-analyze/proj1"
  mkdirs(root ++ "/src")
  put(root ++ "/src/util.dawn",
    "use std/str\npub fn greet(n: String) -> String = \"hi \" ++ str.trim(n)\n")
  put(root ++ "/src/main.dawn",
    "use util\npub fn main() -> Unit !io = println(util.greet(\" dawn \"))\n")
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ e)
  }
  let loaded = load_directory(root)
  assert len(loaded.diags) == 0
  assert len(loaded.modules) == 2
  # dependency order: util before main
  assert loaded.modules[0].mod_path == "util"
  assert loaded.modules[1].mod_path == "main"
  # jsig_refused: a project with no `use java` analyzes without any oracle
  let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
  assert len(prog.diags) == 0
}

test "the representation modules are closed to user code (audit RD-06)" {
  # The accept half is `load_std` itself: std/map is a `use std/hamt`-free
  # module only because lowering rewrites its primitives, but std/list does
  # import std/set's primitives and the bundle as a whole is checked with the
  # gate on. A std module that the gate wrongly refused would fail this load
  # with "does not check", so the two halves are one test.
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ e)
  }
  let root = "/tmp/dawn-selfhost-analyze/substrate"
  mkdirs(root ++ "/src")
  put(root ++ "/src/main.dawn",
    "use std/hamt\nuse std/pvec\npub fn main() -> Unit !io = ()\n")
  let prog = analyze_program(load_directory(root), std, ct_default(), jsig_refused())
  assert len(prog.diags) == 2
  assert prog.diags[0].d.msg == "`std/hamt` is internal to the standard library"
  assert str.contains(prog.diags[0].d.hint, "use std/map or std/set")
  assert prog.diags[1].d.msg == "`std/pvec` is internal to the standard library"
  assert str.contains(prog.diags[1].d.hint, "use std/list")
}

test "an impl is in force in every module, not just its own (spec §3.5)" {
  let root = "/tmp/dawn-selfhost-analyze/trait-cross"
  mkdirs(root ++ "/src")
  put(root ++ "/src/lib.dawn",
    "pub trait Sizey[T] { fn sizey(x: T) -> Int }\n" ++
      "pub type Box = { n: Int } derive Show\n" ++
      "impl Sizey[Box] { fn sizey(b: Box) -> Int = b.n + 2 }\n" ++
      "pub fn describe[T: Sizey](x: T) -> Int = sizey(x)\n")
  # every spelling that reaches the impl from outside its module: a generic
  # entry whose bound is solved at the call site, the method called through
  # the module alias, the method imported by name, and UFCS on the import.
  # `derive Show` on an imported type is the same question -- the derived
  # impl is an impl -- and it was equally unreachable.
  put(root ++ "/src/main.dawn",
    "use lib\nuse lib.{Box, sizey}\n" ++
      "pub fn main() -> Unit !io = println(to_string(lib.describe(Box { n: 1 }))\n" ++
      "  ++ to_string(lib.sizey(Box { n: 2 })) ++ to_string(sizey(Box { n: 3 }))\n" ++
      "  ++ to_string(Box { n: 4 }.sizey()) ++ to_string(Box { n: 5 }))\n")
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ e)
  }
  let loaded = load_directory(root)
  assert len(loaded.diags) == 0
  let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
  for d in prog.diags { panic("unexpected: " ++ d.d.msg) }
  assert len(prog.diags) == 0
}

test "a second module cannot supply a rival impl" {
  # The program-wide coherence check now sees the whole program's table, but
  # it is not what reports this: the orphan rule gets there first, and between
  # two *different* modules it always does. An impl may only live with its
  # trait or with its subject, and a module that could name both would have to
  # import the other, which the loader rejects as a cycle. So "one impl per
  # trait and type" holds across modules by construction, and the accumulated
  # table is what makes the module that *uses* the pair see the one impl.
  let root = "/tmp/dawn-selfhost-analyze/trait-rival"
  mkdirs(root ++ "/src")
  put(root ++ "/src/lib.dawn",
    "pub trait Sizey[T] { fn sizey(x: T) -> Int }\n" ++
      "pub type Box = { n: Int }\n" ++
      "impl Sizey[Box] { fn sizey(b: Box) -> Int = b.n + 2 }\n")
  put(root ++ "/src/main.dawn",
    "use lib.{Sizey, Box}\n" ++
      "impl Sizey[Box] { fn sizey(b: Box) -> Int = b.n }\n" ++
      "pub fn main() -> Unit !io = ()\n")
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ e)
  }
  let prog = analyze_program(load_directory(root), std, ct_default(), jsig_refused())
  assert len(prog.diags) == 1
  assert str.contains(prog.diags[0].d.msg, "orphan impl: `Sizey[Box]`")
}

test "closure loading skips an unreferenced module (module-access 2.2)" {
  let root = "/tmp/dawn-selfhost-analyze/closure1"
  mkdirs(root ++ "/src")
  put(root ++ "/src/main.dawn", "pub fn main() -> Unit !io = println(\"hi\")\n")
  # broken on purpose, and nothing imports it
  put(root ++ "/src/orphan.dawn", "fn bad() -> Int = \"nope\"\n")
  # the full load sees both (bit-rot protection, the default)
  let full = load_directory(root)
  assert len(full.modules) == 2
  # the closure load seeds from the entry and never reaches the orphan
  let clo = load_file(root ++ "/src/main.dawn")
  assert len(clo.modules) == 1
  assert clo.modules[0].mod_path == "main"
}

test "a module may be imported qualified and selectively at once" {
  # Two different acts: one binds a module alias to call through, the other
  # binds names. A module that exports a type AND functions needs both, and
  # the qualified spelling is the whole point of the former.
  let root = "/tmp/dawn-selfhost-analyze/proj-dual"
  mkdirs(root ++ "/src")
  put(root ++ "/src/main.dawn",
    "use std/str\nuse std/str.{trim}\n" ++
      "pub fn main() -> Unit !io = println(trim(str.repeat(\" a \", 1)))\n")
  let loaded = load_directory(root)
  for ld in loaded.diags {
    if str.contains(ld.d.msg, "imported more than once") { assert false }
  }

  # the same kind twice is still an error
  let root2 = "/tmp/dawn-selfhost-analyze/proj-dup"
  mkdirs(root2 ++ "/src")
  put(root2 ++ "/src/main.dawn",
    "use std/str\nuse std/str\npub fn main() -> Unit !io = ()\n")
  let loaded2 = load_directory(root2)
  var dup = false
  for ld in loaded2.diags {
    if str.contains(ld.d.msg, "imported more than once") { dup = true }
  }
  assert dup
}

test "a module alias collides with an imported name in either source order" {
  # bind_import catches `use a/b` before `use a/b.{b}` by reading the alias
  # table as it stands. Nothing read the name table on the way in, so the same
  # pair reversed used to pass and `b` became a binding *and* an alias (#185).
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ e)
  }

  let root = "/tmp/dawn-selfhost-analyze/alias-order"
  mkdirs(root ++ "/src/a")
  put(root ++ "/src/a/b.dawn", "pub fn b(x: Int) -> Int = x\npub fn make(x: Int) -> Int = x\n")
  put(root ++ "/src/main.dawn", "use a/b.{b}\nuse a/b\npub fn main() -> Unit !io = ()\n")
  var shadow = false
  for ld in analyze_program(load_directory(root), std, ct_default(), jsig_refused()).diags {
    if str.contains(ld.d.msg, "shadows the imported module") { shadow = true }
  }
  assert shadow

  # the name and the alias need not come from the same module
  let root2 = "/tmp/dawn-selfhost-analyze/alias-order-x"
  mkdirs(root2 ++ "/src/a")
  mkdirs(root2 ++ "/src/a2")
  put(root2 ++ "/src/a/b.dawn", "pub fn make(x: Int) -> Int = x\n")
  put(root2 ++ "/src/a2/z.dawn", "pub fn b(x: Int) -> Int = x\n")
  put(root2 ++ "/src/main.dawn", "use a2/z.{b}\nuse a/b\npub fn main() -> Unit !io = ()\n")
  var shadow2 = false
  for ld in analyze_program(load_directory(root2), std, ct_default(), jsig_refused()).diags {
    if str.contains(ld.d.msg, "shadows the imported module") { shadow2 = true }
  }
  assert shadow2

  # and names that do not collide still coexist with the selective import first
  let root3 = "/tmp/dawn-selfhost-analyze/alias-order-ok"
  mkdirs(root3 ++ "/src")
  put(root3 ++ "/src/main.dawn",
    "use std/str.{trim}\nuse std/str\n" ++
      "pub fn main() -> Unit !io = println(trim(str.repeat(\" a \", 1)))\n")
  let ok = analyze_program(load_directory(root3), std, ct_default(), jsig_refused())
  assert len(ok.diags) == 0
}

test "loader reports cycles and missing modules" {
  let root = "/tmp/dawn-selfhost-analyze/proj2"
  mkdirs(root ++ "/src")
  put(root ++ "/src/main.dawn", "use a\npub fn main() -> Unit !io = ()\n")
  put(root ++ "/src/a.dawn", "use b\npub fn fa() -> Int = 1\n")
  put(root ++ "/src/b.dawn", "use a\npub fn fb() -> Int = 2\n")
  let loaded = load_directory(root)
  var cyc = false
  for ld in loaded.diags {
    if str.contains(ld.d.msg, "circular module dependency") { cyc = true }
  }
  assert cyc
  let root2 = "/tmp/dawn-selfhost-analyze/proj3"
  mkdirs(root2 ++ "/src")
  put(root2 ++ "/src/main.dawn", "use nope\npub fn main() -> Unit !io = ()\n")
  let loaded2 = load_directory(root2)
  var missing = false
  for ld in loaded2.diags {
    if str.contains(ld.d.msg, "cannot find module `nope`") { missing = true }
  }
  assert missing
}

test "a file whose name is not a path segment is refused, not folded" {
  # The `use` grammar cannot spell these, so only the entry file -- the one
  # named on the command line -- can carry them in. The old folding turned
  # `a-b` and `a_b` into one class name, and `9x` into `m_9x`, which is the
  # class name `m_9x.dawn` already had.
  let root = "/tmp/dawn-selfhost-analyze/entryname"
  mkdirs(root)
  put(root ++ "/a-b.dawn", "pub fn main() -> Unit !io = ()\n")
  put(root ++ "/9x.dawn", "pub fn main() -> Unit !io = ()\n")
  put(root ++ "/ok_name2.dawn", "pub fn main() -> Unit !io = ()\n")

  let hyphen = load_file(root ++ "/a-b.dawn")
  assert len(hyphen.modules) == 0
  assert len(hyphen.diags) == 1
  assert hyphen.diags[0].d.msg == "`a-b` is not a valid module path segment"
  assert str.contains(hyphen.diags[0].d.hint, "[a-z_][a-z0-9_]*")
  assert hyphen.diags[0].path == root ++ "/a-b.dawn"

  let digit = load_file(root ++ "/9x.dawn")
  assert len(digit.modules) == 0
  assert len(digit.diags) == 1
  assert digit.diags[0].d.msg == "`9x` is not a valid module path segment"

  # a legal name still loads, and its class name is the module path unchanged
  let good = load_file(root ++ "/ok_name2.dawn")
  assert len(good.diags) == 0
  assert len(good.modules) == 1
  assert good.modules[0].mod_path == "ok_name2"
  assert good.modules[0].class_name == "ok_name2"
}

test "the editor's standalone path judges the buffer's name too" {
  # The asymmetry this closes (#176): `analyze_standalone` hardcodes mod_path
  # "main", so the buffer's own file name never reached the check `resolve`
  # runs on its seeds. The language server accepted, in silence, a file that
  # `dawn check` refuses to compile -- and the two paths meet in the same
  # editor, on the same file.
  let root = "/tmp/dawn-selfhost-analyze/standalone"
  mkdirs(root)
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ e)
  }
  let src = "pub fn main() -> Unit !io = ()\n"

  let bad = analyze_standalone(root ++ "/a-b.dawn", src, std, ct_default(), jsig_refused())
  assert len(bad.diags) == 1
  assert bad.diags[0].d.msg == "`a-b` is not a valid module path segment"
  assert bad.diags[0].path == root ++ "/a-b.dawn"
  # and the buffer is still analysed, unlike the loader's seed: an editor can
  # show the name complaint and the type errors at once
  assert len(bad.modules) == 1

  let good = analyze_standalone(root ++ "/ok_name2.dawn", src, std, ct_default(), jsig_refused())
  assert len(good.diags) == 0

  # an untitled buffer has no name to judge -- and `<lsp>` is not one
  let untitled = analyze_standalone("<lsp>", src, std, ct_default(), jsig_refused())
  assert len(untitled.diags) == 0
}

test "use_candidates enumerates the tree and its deps the way `use` spells them" {
  let base = "/tmp/dawn-selfhost-analyze/cands"
  mkdirs(base ++ "/app/src/deep")
  mkdirs(base ++ "/pkg/web/src")
  put(base ++ "/pkg/web/dawn.toml", "schema = 1\nname = \"web\"\n")
  put(base ++ "/pkg/web/src/types.dawn", "pub fn tag() -> String = \"w\"\n")
  put(base ++ "/app/dawn.toml", "schema = 1\nname = \"app\"\n\n[deps]\nw = \"../pkg/web\"\n")
  put(base ++ "/app/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
  put(base ++ "/app/src/deep/util.dawn", "pub fn f() -> Int = 1\n")
  # a file the `use` grammar cannot name is not a candidate to complete
  put(base ++ "/app/src/bad-name.dawn", "pub fn f() -> Int = 1\n")

  let c = use_candidates(base ++ "/app/src/main.dawn")
  assert sort(map.keys(c)) == ["deep/util", "main", "w/types"]
  # the dep appears under the alias the manifest spells, not the package's own
  # name: `use w/types` is what this app writes, `web` is what it resolves to
  assert str.ends_with(map.get(c, "w/types").expect("dep module"), "/web/src/types.dawn")

  # a buffer with no file behind it has no tree to walk
  assert len(map.keys(use_candidates("<lsp>"))) == 0
}

test "directory mode refuses one badly named module without losing the rest" {
  let root = "/tmp/dawn-selfhost-analyze/entrydir"
  mkdirs(root ++ "/src")
  put(root ++ "/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
  put(root ++ "/src/bad-name.dawn", "pub fn f() -> Int = 1\n")
  let loaded = load_directory(root)
  assert len(loaded.modules) == 1
  assert loaded.modules[0].mod_path == "main"
  assert len(loaded.diags) == 1
  assert loaded.diags[0].d.msg == "`bad-name` is not a valid module path segment"
}

test "an aliased path dep canonicalizes to the package's real name" {
  let base = "/tmp/dawn-selfhost-analyze/proj4"
  mkdirs(base ++ "/pkg/web/src")
  mkdirs(base ++ "/app/src")
  put(base ++ "/pkg/web/dawn.toml", "schema = 1\nname = \"web\"\n")
  put(base ++ "/pkg/web/src/types.dawn", "pub fn tag() -> String = \"w\"\n")
  put(base ++ "/app/dawn.toml",
    "schema = 1\nname = \"app\"\n\n[deps]\nw = \"../pkg/web\"\n")
  put(base ++ "/app/src/main.dawn",
    "use w/types\n\npub fn main() -> Unit !io = println(types.tag())\n")
  let loaded = load_directory(base ++ "/app")
  assert len(loaded.diags) == 0
  # the aliased import loads under the real name and namespace (§4.3/§4.4)
  var found = false
  for m in loaded.modules {
    if m.mod_path == "web/types" {
      found = true
      assert m.class_name == "dawn\$pkg\$web/types"
    }
  }
  assert found
}

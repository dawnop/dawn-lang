# `[java-deps]` resolution (the Kotlin manifest/Maven + cli resolveDeps): the
# union of the target's coordinates and every linked source package's, handed
# to coursier's pure-Java interface. Resolution and caching are coursier's;
# version conflicts across the transitive graph resolve highest-wins. The
# mirror override ($DAWN_MAVEN_MIRROR) is an environment fact, never a
# manifest one — the same manifest must work on both sides of a slow link.

use std/str
use std/set
use std/map
use std/io
use std/io.{Fs}
use compiler_plan/manifestv.{MCoord, mcoord_show}
use compiler_plan/pkgfetch
use sha2/sha256
use java "java.lang.System"
use java "coursierapi.Fetch"
use java "coursierapi.Dependency"
use java "coursierapi.MavenRepository"
use java "java.util.List"
use java "java.io.File"

## Resolve to absolute jar paths, newest-wins across the transitive graph.
## Empty input returns empty without touching the network.
pub fn fetch(coords: List[MCoord]) -> Result[List[String], String] !io = {
  if len(coords) == 0 {
    let empty: List[String] = []
    return Ok(empty)
  }
  let mirror: Option[String] = match System.getenv("DAWN_MAVEN_MIRROR") {
    Some(v) -> if str.trim(v) == "" { None } else { Some(str.trim(v)) }
    None -> None
  }
  let fetched = catch_fault(() => {
    let f = Fetch.create().expect("fetch")
    for c in coords {
      let d = Dependency.of(c.group, c.artifact, c.version).expect("dependency")
      let _ = f.addDependencies(d)
    }
    match mirror {
      Some(m) -> { let _ = f.withRepositories(MavenRepository.of(m).expect("repo")) }
      None -> ()
    }
    f.fetch().expect("files")
  })
  match fetched {
    Ok(files) -> {
      var out: List[String] = []
      var i = 0
      while i < files.size() {
        # coursier hands back a `List<File>`; the element type is erased, not
        # in doubt. So the `Err` `cast` now returns (LANG-02) is a broken
        # invariant rather than a fetch failure, and it must not be folded into
        # the `Err` arm below — that one is a message shown to whoever asked
        # for the dependency.
        let got: Result[File, ForeignError] = cast(files.get(i).expect("file"))
        let jar: File = match got {
          Ok(v) -> v
          Err(x) -> panic("maven.fetch: not a File: " ++ x.message)
        }
        out = out ++ [jar.getAbsolutePath().expect("path")]
        i = i + 1
      }
      Ok(out)
    }
    Err(e) -> Err(explain(e.message, coords, mirror))
  }
}

## Lead with what the user should do; keep coursier's detail (it names the
## coordinate and the urls tried).
fn explain(detail: String, coords: List[MCoord], mirror: Option[String]) -> String = {
  let what = if len(coords) == 1 {
    "dependency " ++ mcoord_show(coords[0])
  } else {
    to_string(len(coords)) ++ " dependencies"
  }
  let where_ = match mirror {
    Some(m) -> " from " ++ m ++ " (\$DAWN_MAVEN_MIRROR)"
    None -> ""
  }
  let hint = if str.contains(str.to_lower(detail), "not found") {
    "\n  check the coordinate in dawn.toml against the artifact on Maven Central"
  } else {
    match mirror {
      Some(_) -> "\n  the mirror in \$DAWN_MAVEN_MIRROR may not carry it; unset it to try Maven Central"
      None -> "\n  set \$DAWN_MAVEN_MIRROR to a closer mirror if this is a network timeout"
    }
  }
  "could not resolve " ++ what ++ where_ ++ ":\n" ++ str.trim(detail) ++ hint
}

# ---- dawn.lock: freeze the resolved artifact set (PKG-04) ----
#
# `[java-deps]` names direct coordinates; what actually lands on the class
# path is coursier's transitive closure, resolved highest-wins, from whatever
# repository answered. None of that was recorded, so "precise direct
# dependencies + immutable Central releases ⇒ reproducible" was an argument
# with holes: a transitive POM can move, a mirror can answer with different
# bytes, and the chosen version follows a graph that changes upstream.
#
# The lock records the *bytes* of the whole resolved set: one line per jar,
# `<sha256>  <basename>`, plus the direct coordinates it was resolved from.
# Every later run re-resolves and then refuses anything the lock did not
# record -- weaker than installing straight from the lock (coursier is what
# downloads, and its Fetch surface hands back files, not coordinates), and
# exactly as safe: a different transitive version, a tampered mirror or a
# corrupted cache all change a basename or a hash, and all three stop the
# build. Deriving a coordinate back out of a cache path would be a guess, so
# the lock does not pretend to know one per artifact.
#
# What a lock cannot do: make a deleted upstream artifact reappear. It tells
# you exactly what you are missing, which is not the same thing -- the very
# overclaim PKG-04 was raised about, not to be repeated here.

pub fn lock_path(dir: String) -> String = dir ++ "/dawn.lock"

pub type Lock = { coords: List[String], arts: List[(String, String)] }

fn basename(path: String) -> String =
  match str.last_index_of(path, "/") {
    Some(i) -> str.drop(path, i + 1)
    None -> path
  }

## A resolved jar, its content hash, and the name it is filed under -- in the
## lock, and in the `lib/` directory beside a built jar.
pub type Artifact = { path: String, name: String, hash: String }

## Twelve hex digits of the content hash. Long enough that a collision is not
## a thing to plan for, short enough to read in a directory listing.
fn short_hash(h: String) -> String = str.take(h, 12)

fn count_of(m: Map[String, String], k: String) -> Option[String] = map.get(m, k)

## Name and hash every resolved jar, with names unique across the set.
##
## A jar file name is not an identity. `group.a:util:1.0` and `group.b:util:1.0`
## both produce `util-1.0.jar`, and coursier's Fetch surface hands back files
## rather than coordinates, so nothing downstream could tell them apart: the
## lock recorded one name against two hashes and could not verify the set it
## had itself produced, and vendoring copied both to `lib/util-1.0.jar`, the
## second silently over the first. A deployment jar then shipped with a
## dependency that had been on the class path at compile time.
##
## So a name that collides is qualified by content, and *every* member of the
## colliding group is qualified -- not just the later ones -- so the answer
## does not depend on the order coursier returned them in. Names that do not
## collide are untouched, which is every name in practice; the same bytes
## appearing twice is one artifact, not a collision.
pub fn artifacts(jars: List[String]) -> Result[List[Artifact], String] !Fs = {
  var names: List[String] = []
  var hashes: List[String] = []
  for j in jars {
    match io.read_bytes(j) {
      Ok(bs) -> {
        names = names ++ [basename(j)]
        hashes = hashes ++ [sha256.hex(bs)]
      }
      Err(e) -> return Err("cannot read " ++ j ++ ": " ++ e.message)
    }
  }
  var first: Map[String, String] = map.empty()
  var clash: Set[String] = set.empty()
  var i = 0
  while i < len(names) {
    match count_of(first, names[i]) {
      Some(h) -> { if h != hashes[i] { clash = set.insert(clash, names[i]) } }
      None -> { first = map.insert(first, names[i], hashes[i]) }
    }
    i = i + 1
  }
  var out: List[Artifact] = []
  var seen: Set[String] = set.empty()
  i = 0
  while i < len(jars) {
    let nm = if set.has(clash, names[i]) {
      short_hash(hashes[i]) ++ "-" ++ names[i]
    } else {
      names[i]
    }
    let key = nm ++ " " ++ hashes[i]
    if not set.has(seen, key) {
      seen = set.insert(seen, key)
      out = out ++ [Artifact { path: jars[i], name: nm, hash: hashes[i] }]
    }
    i = i + 1
  }
  Ok(out)
}

## The lock's text: schema, the direct coordinates, then the artifacts, all
## sorted so the file is a function of the resolution and diffs read cleanly.
pub fn render_lock(l: Lock) -> String = {
  var out = "# generated by `dawn lock` -- the resolved [java-deps] closure, by bytes.\n"
  out = out ++ "# `dawn lock --check` fails when a re-resolution disagrees with this file.\n"
  out = out ++ "schema 1\n"
  for c in sort(l.coords) { out = out ++ "coord " ++ c ++ "\n" }
  var lines: List[String] = []
  for a in l.arts {
    let (name, hash) = a
    lines = lines ++ [hash ++ "  " ++ name]
  }
  for ln in sort(lines) { out = out ++ "artifact " ++ ln ++ "\n" }
  out
}

pub fn parse_lock(text: String) -> Result[Lock, String] = {
  var coords: List[String] = []
  var arts: List[(String, String)] = []
  var saw_schema = false
  for line in str.split(text, "\n") {
    let t = str.trim(line)
    if t == "" || str.starts_with(t, "#") {
      ()
    } else if t == "schema 1" {
      saw_schema = true
    } else if str.starts_with(t, "coord ") {
      coords = coords ++ [str.trim(str.strip_prefix(t, "coord ").unwrap_or(t))]
    } else if str.starts_with(t, "artifact ") {
      let rest = str.trim(str.strip_prefix(t, "artifact ").unwrap_or(t))
      match str.index_of(rest, " ") {
        Some(i) -> {
          let nm = str.trim(str.drop(rest, i + 1))
          # A name listed twice is a lock that cannot be checked: the
          # comparison below looks artifacts up by name, so the second entry
          # would either shadow the first or contradict it forever.
          for b in arts {
            let (n2, _) = b
            if n2 == nm {
              return Err("dawn.lock lists " ++ nm ++ " twice -- regenerate it with `dawn lock`")
            }
          }
          arts = arts ++ [(nm, str.take(rest, i))]
        }
        None -> return Err("malformed artifact line: " ++ t)
      }
    } else {
      return Err("unrecognized line in dawn.lock: " ++ t)
    }
  }
  if not saw_schema {
    return Err("dawn.lock has no `schema 1` line -- regenerate it with `dawn lock`")
  }
  Ok(Lock { coords: coords, arts: arts })
}

## Hash the jars a resolution produced into a Lock, next to the coordinates
## they came from.
pub fn lock_of(coords: List[MCoord], jars: List[String]) -> Result[Lock, String] !Fs = {
  var cs: List[String] = []
  for c in coords { cs = cs ++ [mcoord_show(c)] }
  let found = match artifacts(jars) {
    Ok(a) -> a
    Err(e) -> return Err(e)
  }
  var arts: List[(String, String)] = []
  for a in found { arts = arts ++ [(a.name, a.hash)] }
  Ok(Lock { coords: cs, arts: arts })
}

## Does what a resolution produced match the lock? The message names the first
## disagreement -- a changed hash, an artifact the lock never saw, or a
## dependency the lock expected and the resolution dropped.
pub fn check_lock(l: Lock, fresh: Lock) -> Result[Unit, String] = {
  if sort(l.coords) != sort(fresh.coords) {
    return Err("dawn.lock's direct coordinates do not match dawn.toml" ++
        "\n  locked: " ++ join(sort(l.coords), ", ") ++
        "\n  now:    " ++ join(sort(fresh.coords), ", ") ++
        "\n  run `dawn lock` after changing [java-deps]")
  }
  for a in fresh.arts {
    let (name, hash) = a
    var found = false
    for b in l.arts {
      let (n2, h2) = b
      if n2 == name {
        found = true
        if h2 != hash {
          return Err("dawn.lock disagrees about " ++ name ++
              "\n  locked: " ++ h2 ++ "\n  actual: " ++ hash ++
              "\n  the artifact's bytes changed upstream, in a mirror, or in the cache")
        }
      }
    }
    if not found {
      return Err("resolution produced " ++ name ++ ", which dawn.lock does not list" ++
          "\n  a transitive version moved; run `dawn lock` to accept it")
    }
  }
  for b in l.arts {
    let (n2, _) = b
    var still = false
    for a in fresh.arts {
      let (name, _) = a
      if name == n2 { still = true }
    }
    if not still {
      return Err("dawn.lock lists " ++ n2 ++ ", which this resolution did not produce" ++
          "\n  run `dawn lock` if the dependency was meant to go away")
    }
  }
  Ok(())
}

## A dependency setup failure plus the project file an editor should attach it
## to. CLI callers keep the historical message through `fetch_checked`; LSP
## callers retain the location instead of guessing from message text.
pub type FetchCheckedError = { path: String, message: String }

## Resolve one captured source plan's Java coordinates and, when a lock is
## present beside its manifest, verify the resolved bytes before exposing any
## jar. A present but unreadable lock is an error, not another spelling of no
## lock. The original Coursier order is retained for classloader precedence.
pub fn fetch_checked_report(
  project: String,
  coords: List[MCoord]
) -> Result[List[String], FetchCheckedError] !Fs !io = {
  let jars = match fetch(coords) {
    Ok(found) -> found
    Err(e) -> return Err(FetchCheckedError { path: project ++ "/dawn.toml", message: e })
  }
  let path = lock_path(project)
  if not io.exists(path) { return Ok(jars) }
  let text = match io.read_file(path) {
    Ok(found) -> found
    Err(e) -> return Err(FetchCheckedError {
      path: path,
      message: "cannot read " ++ path ++ ": " ++ e.message
    })
  }
  let locked = match parse_lock(text) {
    Ok(found) -> found
    Err(e) -> return Err(FetchCheckedError { path: path, message: path ++ ": " ++ e })
  }
  let fresh = match lock_of(coords, jars) {
    Ok(found) -> found
    Err(e) -> return Err(FetchCheckedError { path: path, message: e })
  }
  match check_lock(locked, fresh) {
    Ok(_) -> Ok(jars)
    Err(e) -> Err(FetchCheckedError { path: path, message: e })
  }
}

## CLI-compatible projection of the structured dependency setup result.
pub fn fetch_checked(
  project: String,
  coords: List[MCoord]
) -> Result[List[String], String] !Fs !io =
  match fetch_checked_report(project, coords) {
    Ok(jars) -> Ok(jars)
    Err(e) -> Err(e.message)
  }

## `pkgfetch.delete_tree` is not usable as a value across a module boundary,
## so the test's cleanup names it here.
fn rmtree(path: String) -> Unit !io = io.with_fs_real(() => pkgfetch.delete_tree(path))

test "one jar file name, two artifacts: both survive, distinctly named" {
  io.with_fs_real(() => {
    let root = match io.temp_dir("", "dawn-artifacts-") {
      Ok(d) -> d
      Err(e) -> panic("temp dir: " ++ e.message)
    }
    with r <- bracket(root, rmtree)
    # `group.a:util:1.0` and `group.b:util:1.0` land in different cache
    # directories under one file name -- which is the whole hazard, since what
    # comes back from coursier is a list of paths and nothing else
    let _ = io.mkdirs(r ++ "/a")
    let _ = io.mkdirs(r ++ "/b")
    let _ = io.mkdirs(r ++ "/c")
    let _ = io.write_file(r ++ "/a/util-1.0.jar", "one")
    let _ = io.write_file(r ++ "/b/util-1.0.jar", "two")
    let _ = io.write_file(r ++ "/c/asm-9.jar", "asm")
    let got = match artifacts([r ++ "/a/util-1.0.jar", r ++ "/b/util-1.0.jar", r ++ "/c/asm-9.jar"]) {
      Ok(a) -> a
      Err(e) -> panic(e)
    }
    assert len(got) == 3
    # the name that does not collide is left exactly as it was
    assert got[2].name == "asm-9.jar"
    # the one that does is qualified on both sides, so the result does not
    # depend on which order they arrived in
    assert got[0].name != got[1].name
    assert str.ends_with(got[0].name, "-util-1.0.jar")
    assert str.ends_with(got[1].name, "-util-1.0.jar")
    # ...and a lock built from that set can verify itself, which is the thing a
    # name-keyed lock could not do
    let l = match lock_of([MCoord { group: "g", artifact: "a", version: "1", aname: "a" }],
      [r ++ "/a/util-1.0.jar", r ++ "/b/util-1.0.jar", r ++ "/c/asm-9.jar"]) {
      Ok(x) -> x
      Err(e) -> panic(e)
    }
    match check_lock(l, l) {
      Ok(_) -> { assert true }
      Err(e) -> {
        println(e)
        assert false
      }
    }
    # the same bytes reached twice is one artifact, not a collision
    let same = match artifacts([r ++ "/a/util-1.0.jar", r ++ "/a/util-1.0.jar"]) {
      Ok(a) -> a
      Err(e) -> panic(e)
    }
    assert len(same) == 1
    assert same[0].name == "util-1.0.jar"
  })
}

test "a lock that lists a name twice is refused rather than half-read" {
  match parse_lock("schema 1\nartifact aa  util-1.0.jar\nartifact bb  util-1.0.jar\n") {
    Err(e) -> { assert str.contains(e, "twice") }
    Ok(_) -> { assert false }
  }
}

test "a lock round-trips through its text form" {
  let l = Lock {
    coords: ["org.ow2.asm:asm:9.7.1", "a:b:1"],
    arts: [("asm-9.7.1.jar", "beef"), ("b-1.jar", "cafe")]
  }
  let text = render_lock(l)
  assert str.contains(text, "schema 1")
  # sorted, so the file is a function of the resolution
  let i1 = str.index_of(text, "coord a:b:1").expect("a:b:1 in the lock")
  let i2 = str.index_of(text, "coord org.ow2.asm").expect("asm in the lock")
  assert i1 < i2
  match parse_lock(text) {
    Ok(l2) -> {
      assert sort(l2.coords) == sort(l.coords)
      assert len(l2.arts) == 2
    }
    Err(e) -> {
      println(e)
      assert false
    }
  }
  # a lock without the schema line is refused rather than half-read
  match parse_lock("coord a:b:1\n") {
    Err(e) -> { assert str.contains(e, "schema 1") }
    Ok(_) -> { assert false }
  }
}

test "check_lock names the first disagreement" {
  let base = Lock { coords: ["a:b:1"], arts: [("b-1.jar", "beef"), ("t-2.jar", "cafe")] }
  match check_lock(base, base) {
    Ok(_) -> { assert true }
    Err(_) -> { assert false }
  }
  # changed bytes
  let moved = Lock { coords: ["a:b:1"], arts: [("b-1.jar", "beef"), ("t-2.jar", "f00d")] }
  match check_lock(base, moved) {
    Err(e) -> { assert str.contains(e, "disagrees about t-2.jar") }
    Ok(_) -> { assert false }
  }
  # a transitive version moved: new artifact
  let added = Lock {
    coords: ["a:b:1"],
    arts: [("b-1.jar", "beef"), ("t-2.jar", "cafe"), ("t-3.jar", "1234")]
  }
  match check_lock(base, added) {
    Err(e) -> { assert str.contains(e, "which dawn.lock does not list") }
    Ok(_) -> { assert false }
  }
  # ...and one that vanished
  let dropped = Lock { coords: ["a:b:1"], arts: [("b-1.jar", "beef")] }
  match check_lock(base, dropped) {
    Err(e) -> { assert str.contains(e, "did not produce") }
    Ok(_) -> { assert false }
  }
  # direct coordinates drifting from dawn.toml
  let other = Lock { coords: ["a:b:2"], arts: [("b-1.jar", "beef"), ("t-2.jar", "cafe")] }
  match check_lock(base, other) {
    Err(e) -> { assert str.contains(e, "do not match dawn.toml") }
    Ok(_) -> { assert false }
  }
}

test "explain names the single coordinate and the mirror" {
  let c = MCoord { group: "g", artifact: "a", version: "1", aname: "a" }
  let m = explain("boom", [c], Some("https://mirror"))
  assert str.contains(m, "could not resolve dependency g:a:1 from https://mirror")
  assert str.contains(m, "the mirror in \$DAWN_MAVEN_MIRROR may not carry it")
  let m2 = explain("artifact not found: x", [c], None)
  assert str.contains(m2, "check the coordinate in dawn.toml")
}

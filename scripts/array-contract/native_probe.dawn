# The native twin of probe.dawn: the same value lines, no clock. `use java` is
# a JVM-only import and the probe's timer is one, so the native leg of run.sh
# compiles this file instead and bounds the run from the shell (the extend
# workload is milliseconds in place and tens of minutes without).
use std/array

pub fn main() -> Unit !io = {
  for line in array.values() { println(line) }
  println("bounds   ${array.out_of_bounds()}")
  println("frombuf  ${array.from_array()}")
  for line in array.bulk() { println(line) }
  for line in array.slice_panics() { println("slicepanic ${line}") }
  array.extend_linear(2000000)
}

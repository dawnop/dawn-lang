## Unsigned 64-bit integers: `U64`, an opaque type over `Int` that reads
## the same 64 bits as 0..2^64 - 1, with arithmetic that wraps.
#
# GENERATED by scripts/fixed-ints/gen.py -- edit there and rerun it; the
# tree-policy gate fails on a hand edit here.
#
# One of seven sibling modules (std/int/i8, i16, i32, u8, u16, u32, u64) that
# share one shape; docs/literal-system-design.md D13 is the design and spec
# 11 the contract. Why they are std and not the compiler's: the compiler owns
# two numbers, Int and Float (D1), and a fixed-width integer is an Int with
# an invariant, which is what an opaque type is. Measured before this was
# written: packages/sha2's compression loop over std/int/u32 runs within 1% of
# the `Int` + `& MASK` form on both backends.
#
# They live under std/int/ so that seven of them do not crowd the top of
# std; `use` binds a path's last segment, so `use std/int/u32` still
# qualifies as `u32`.
#
# Why one module per width and not one module for all seven: a module is
# Dawn's namespace, so `u32.wrap(n)`, `u32.rotr(x, 7)` and `u8.wrap(n)` are
# the same names qualified differently, as `char.code` is for `Char`. One
# module would need either a width in every name (`wrap_u32`) or a trait
# whose `to_int` member shadows the builtin `to_int` in every importer, and
# the constructors could not be trait members anyway, since their subject is
# only in the return position. A program imports the widths it uses.
#
# U64 has no invariant: every Int is the bit pattern of one U64. Addition,
# subtraction, multiplication and negation are Int's own, since two's
# complement wraps the same bits either way. What differs is everything that
# reads the top bit as a magnitude rather than a sign: `<` (an `impl Ord`
# of its own, without which a U64 above 2^63 would compare below zero),
# `/` and `%` (`udiv` below, the derivation `Long.divideUnsigned` uses) and
# rendering. `to_int` hands back the bit pattern, so a U64 above 2^63 - 1
# comes out negative; `of` refuses a negative Int for the same reason.
#
# Wrapping and not trapping, as `Int` does (spec 4.3): two overflow rules in
# one family of types would have every reader looking up which one applies.
# `checked_add`, `checked_sub` and `checked_mul` answer `None` instead. A
# literal at `U64` is `FromInt`'s, range-checked at compile time, so
# `let b: U64 = 18446744073709551616` does not compile (outside this module: inside it the
# type is seen through and a literal is the Int it always was, literal design
# D7). The bitwise operations are named functions until the operators have
# traits of their own; `complement` and not `not`, which is a keyword. A
# shift or rotation count is taken modulo 64, as the JVM and the hardware do
# for Int's own shifts.

## A unsigned 64-bit integer.
pub opaque type U64 = Int

## The least `U64`, 0.
pub const MIN: U64 = 0

## The greatest `U64`, 2^64 - 1; its bit pattern is the Int -1.
pub const MAX: U64 = -1

## `n` as a `U64`, or `None` when `n` is negative: a negative Int is not a
## number in 0..2^64 - 1. [`wrap`] reads its bits instead.
pub fn of(n: Int) -> Option[U64] = if n < 0 { None } else { Some(n) }

## The `U64` with the bit pattern of `n`: `wrap(-1)` is [`MAX`].
pub fn wrap(n: Int) -> U64 = n

## The bit pattern of `x` as an Int: a value above 2^63 - 1 is negative.
pub fn to_int(x: U64) -> Int = x

# The literal's range check, run at compile time for every literal at this
# type outside this module.
impl FromInt[U64] {
  fn from_int(n: Int) -> U64 = {
    if n < 0 { panic("out of range for U64: ${n}") }
    n
  }
}

impl Show[U64] {
  fn show(x: U64) -> String = {
    let n: Int = x
    if n >= 0 {
      to_string(n)
    } else {
      # the last digit apart, so the rest fits in an Int
      let q = udiv(n, 10)
      to_string(q) ++ to_string(n - q * 10)
    }
  }
}

impl Ord[U64] {
  fn cmp(a: U64, b: U64) -> Int = {
    let x: Int = a
    let y: Int = b
    if x == y { 0 } else if ult(x, y) { -1 } else { 1 }
  }
}

# Unsigned order on bit patterns: flipping the sign bit of both maps
# 0..2^64 - 1 onto Int's order.
fn ult(x: Int, y: Int) -> Bool = (x ^ -9223372036854775808) < (y ^ -9223372036854775808)

# The unsigned quotient. A divisor with its top bit set goes into any
# dividend at most once. Otherwise halve the dividend so that it is a
# non-negative Int, divide, double, and correct the estimate, which is at
# most one short (Hacker's Delight 9-3, as Long.divideUnsigned). A zero
# divisor reaches Int's `/` and panics with its message.
fn udiv(n: Int, d: Int) -> Int =
  if d < 0 {
    if ult(n, d) { 0 } else { 1 }
  } else if n >= 0 {
    n / d
  } else {
    let q = ((n >>> 1) / d) << 1
    if ult(n - q * d, d) { q } else { q + 1 }
  }

impl Add[U64] {
  fn add(a: U64, b: U64) -> U64 = {
    let x: Int = a
    let y: Int = b
    x + y
  }
}

impl Sub[U64] {
  fn sub(a: U64, b: U64) -> U64 = {
    let x: Int = a
    let y: Int = b
    x - y
  }
}

impl Mul[U64] {
  fn mul(a: U64, b: U64) -> U64 = {
    let x: Int = a
    let y: Int = b
    x * y
  }
}

impl Div[U64] {
  fn div(a: U64, b: U64) -> U64 = {
    let x: Int = a
    let y: Int = b
    udiv(x, y)
  }
}

impl Rem[U64] {
  fn rem(a: U64, b: U64) -> U64 = {
    let x: Int = a
    let y: Int = b
    x - udiv(x, y) * y
  }
}

impl Neg[U64] {
  fn neg(a: U64) -> U64 = {
    let x: Int = a
    0 - x
  }
}

## `a + b`, or `None` where it wraps.
pub fn checked_add(a: U64, b: U64) -> Option[U64] = {
  let x: Int = a
  let y: Int = b
  let r = x + y
  if ult(r, x) { None } else { Some(r) }
}

## `a - b`, or `None` where it wraps.
pub fn checked_sub(a: U64, b: U64) -> Option[U64] = {
  let x: Int = a
  let y: Int = b
  if ult(x, y) { None } else { Some(x - y) }
}

## `a * b`, or `None` where it wraps.
pub fn checked_mul(a: U64, b: U64) -> Option[U64] = {
  let x: Int = a
  let y: Int = b
  let r = x * y
  # the product wrapped exactly when dividing it back does not give `b`
  if x != 0 && udiv(r, x) != y { None } else { Some(r) }
}

## The bitwise and.
pub fn and(a: U64, b: U64) -> U64 = {
  let x: Int = a
  let y: Int = b
  x & y
}

## The bitwise or.
pub fn or(a: U64, b: U64) -> U64 = {
  let x: Int = a
  let y: Int = b
  x | y
}

## The bitwise exclusive or.
pub fn xor(a: U64, b: U64) -> U64 = {
  let x: Int = a
  let y: Int = b
  x ^ y
}

## Every bit flipped.
pub fn complement(a: U64) -> U64 = {
  let x: Int = a
  ~x
}

## `a` shifted left by `n` modulo 64 places, zeros in at the bottom.
pub fn shl(a: U64, n: Int) -> U64 = {
  let x: Int = a
  x << (n & 63)
}

## `a` shifted right by `n` modulo 64 places, zeros in at the top.
pub fn shr(a: U64, n: Int) -> U64 = {
  let x: Int = a
  x >>> (n & 63)
}

## `a`'s 64 bits rotated left by `n` modulo 64 places.
pub fn rotl(a: U64, n: Int) -> U64 = {
  let u: Int = a
  let k = n & 63
  (u << k) | (u >>> (64 - k))
}

## `a`'s 64 bits rotated right by `n` modulo 64 places.
pub fn rotr(a: U64, n: Int) -> U64 = {
  let u: Int = a
  let k = n & 63
  (u >>> k) | (u << (64 - k))
}

# Representative cases; scripts/spike-native/fixed_ints holds the seven types
# to an oracle computed outside Dawn, on both backends.

test "the ends wrap into each other and the conversions agree" {
  assert MAX + wrap(1) == MIN
  assert MIN - wrap(1) == MAX
  assert to_int(wrap(7) / wrap(2)) == 3
  assert to_int(wrap(7) % wrap(2)) == 1
  assert rotl(wrap(1), 64) == wrap(1)
  assert rotr(wrap(1), 1) == shl(wrap(1), 63)
  assert checked_add(MAX, wrap(1)) == None
  assert checked_sub(MIN, wrap(1)) == None
  assert of(-1) == None
  assert to_int(MAX) == -1
  assert show(MAX) == "18446744073709551615"
  # the order is unsigned: the top bit is a magnitude, not a sign
  assert wrap(0) < MAX
  assert to_int(MAX / wrap(10)) == 1844674407370955161
  assert to_int(MAX % wrap(10)) == 5
}

# Explicit contracts exercise data introduction and nominal boundaries.
use std/mem
type Reader[^c] = { read: fn() -> Int ^{c} }
fn attempted() !io = mem.with_mem([@s] () => { let b = mem.new(3)
  let r: Reader[^{s}] = Reader { read = () => len(b) }
  r })
pub fn main() -> Unit !io = println("probe")

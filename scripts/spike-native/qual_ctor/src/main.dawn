# Qualified constructors in expression position (LANG-06): built through the
# alias, generic and nullary alike, beside a local constructor of the same
# simple name, and one built with a named argument. All of it routes into the
# one check_ctor_call, so both backends see the ordinary XCtor and must print
# the same five lines.
#
# The named one is newly writable: argument names used to be parsed only in
# the unqualified constructor special case, so `v.JStr(s: "y")` was a syntax
# error until calls became one postfix (SYN-02).
use val as v

type Mine = JStr(n: Int)

pub fn main() -> Unit !io = {
  let a = v.JStr("x")
  let mine = JStr(7)
  let boxed = v.One(42)
  match a {
    v.JStr(s) -> println("qual=${s}")
    _ -> println("other")
  }
  match v.JStr(s: "y") {
    v.JStr(s) -> println("named=${s}")
    _ -> println("other")
  }
  match mine {
    JStr(n) -> println("local=${n}")
  }
  match boxed {
    v.One(x) -> println("generic=${x}")
  }
  match v.JNull {
    v.JNull -> println("nullary ok")
    _ -> println("no")
  }
}

# EBNF trait_decl / impl_decl, plus conditional impls with their own type
# parameters (trait v2, which the EBNF predates).
pub trait Area[T] {
  fn area(x: T) -> Float
  fn describe(x: T) -> String = "area"
}

type Sq = { s: Float }

impl Area[Sq] {
  fn area(x: Sq) -> Float = x.s * x.s
}

type Wrap[T] = W(v: T)

impl[T: Show] Show[Wrap[T]] {
  fn show(x: Wrap[T]) -> String =
    match x {
      W(v) -> "W(" ++ show(v) ++ ")"
    }
}

# A source file's text with code point offsets <-> line:col, and the few
# questions about it the mapping asks (which identifier starts here, what text
# lies between two offsets).
#
# Why offsets and not lines. The compilers' side tables name a call by its span
# in code points (docs/source-span-map-design.md section 12), while the page
# and the `.xmap` format speak `line:col` from 1. This module is the one place
# that converts, so that every pane agrees on what column 12 of line 4 is. A
# column counts code points, not bytes or UTF-16 units: a line with an astral
# character in it is where the other two disagree.
#
# Lines are cut at "\n" only, as the compilers cut them; a "\r" stays in the
# line it ends.

use std/str
use std/list

## A source text, cut into its lines, with the offset each line starts at.
pub type Src = { text: String, lines: List[String], starts: List[Int] }

## `text` read as a source.
pub fn src_of(text: String) -> Src = {
  let lines = str.split(text, "\n")
  var starts: List[Int] = []
  var at = 0
  for l in lines {
    starts = starts ++ [at]
    at = at + str.len(l) + 1
  }
  Src { text: text, lines: lines, starts: starts }
}

## The `(line, col)`, both from 1, of code point offset `off`.
pub fn at(src: Src, off: Int) -> (Int, Int) = {
  var lo = 0
  var hi = len(src.starts) - 1
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if src.starts[mid] <= off {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  (lo + 1, off - src.starts[lo] + 1)
}

## The offset of `line:col`, the inverse of [`at`].
pub fn off(src: Src, line: Int, col: Int) -> Int = src.starts[line - 1] + col - 1

## `line:col`.
pub fn pos(p: (Int, Int)) -> String = {
  let (l, c) = p
  "${l}:${c}"
}

## `line:col-line:col`, the shape `.xmap` writes a span in.
pub fn span_text(src: Src, lo: Int, hi: Int) -> String = "${pos(at(src, lo))}-${pos(at(src, hi))}"

fn ident_start(c: String) -> Bool = str.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)

fn ident_char(c: String) -> Bool = ident_start(c) || str.contains("0123456789", c)

## The identifier that starts at `off`, or `None` when none does.
pub fn ident_at(src: Src, off: Int) -> Option[String] = {
  let (l, c) = at(src, off)
  if off < 0 || l > len(src.lines) || c < 1 {
    return None
  }
  let rest = str.chars(str.drop(src.lines[l - 1], c - 1))
  var out = ""
  var going = len(rest) > 0 && ident_start(rest[0])
  var i = 0
  while going {
    out = out ++ rest[i]
    i = i + 1
    going = i < len(rest) && ident_char(rest[i])
  }
  if out == "" { None } else { Some(out) }
}

## The text from offset `lo` up to `hi`.
pub fn text_between(src: Src, lo: Int, hi: Int) -> String = {
  if hi <= lo {
    return ""
  }
  let (l0, c0) = at(src, lo)
  let (l1, c1) = at(src, hi)
  if l0 == l1 {
    str.slice(src.lines[l0 - 1], c0 - 1, c1 - 1)
  } else {
    let a = src.lines[l0 - 1]
    let first = str.slice(a, c0 - 1, str.len(a))
    let middle = list.slice(src.lines, l0, l1 - 1)
    let last = str.take(src.lines[l1 - 1], c1 - 1)
    join([first] ++ middle ++ [last], "\n")
  }
}

test "offsets and line:col are each other's inverse, in code points" {
  let s = src_of("ab\ncd é\n\nx")
  assert at(s, 0) == (1, 1)
  assert at(s, 2) == (1, 3)
  assert at(s, 3) == (2, 1)
  assert at(s, 7) == (2, 5)
  assert at(s, 8) == (3, 1)
  assert at(s, 9) == (4, 1)
  assert off(s, 2, 4) == 6
  assert span_text(s, 1, 8) == "1:2-3:1"
  assert list.all(range(0, 10), o => {
    let (l, c) = at(s, o)
    off(s, l, c) == o
  })
}

test "an identifier is read where one starts and nowhere else" {
  let s = src_of("  foo_1(x)\n9a")
  assert ident_at(s, 2) == Some("foo_1")
  assert ident_at(s, 4) == Some("o_1")
  assert ident_at(s, 7) == None
  assert ident_at(s, 0) == None
  assert ident_at(s, 11) == None
  assert ident_at(s, 100) == None
  assert ident_at(s, -3) == None
}

test "text between two offsets runs across lines" {
  let s = src_of("ab\ncd\nef")
  assert text_between(s, 1, 2) == "b"
  assert text_between(s, 1, 7) == "b\ncd\ne"
  assert text_between(s, 4, 4) == ""
}

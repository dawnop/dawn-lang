# The JVM backend's collection runtime, byte-copied into every built program.
#
# There is none left. `DawnList`, `DawnMap` and `DawnSet` all retired with S3:
# List is the Dawn vector in std/pvec, Map and Set are the Dawn hash trie in
# std/hamt, and the whole of what a backend implements for collections is
# `Array` (docs/collections-dejava-research.md §5).
#
# The old argument for keeping the last two was that each
# `extends java.util.Abstract*`, whose structural, order-independent
# equals/hashCode *was* Dawn's `==`/hash on maps and sets — an identity Dawn
# was said to be unable to express without inheritance. What that argument
# missed is that it only held while `==` and hash were hardwired: once they
# became traits a container could implement, the identity moved into std
# source and the container followed it. The list had no such argument, only a
# performance one, and that turned on `array_push` extending in place.
#
# The mechanism stays because it is the general one: a backend that needs to
# ship a handwritten class into every program says so here.
#
# Mechanism: compiled ahead of time, so they live in the compiler artifact and
# must be copied into a built program's class table — otherwise `java -jar` dies
# with NoClassDefFoundError while `dawn run` works. rt_class_family reads them
# from the running compiler's own class loader.

use std/str
use std/list
use std/io
use std/bytes
use sha2/sha256
use java "java.io.File"
use java "java.lang.ClassLoader"
use java "java.net.URL"
use java "java.util.jar.JarFile"
use java "java.util.jar.JarEntry"
use java "java.util.Enumeration"
use java "java.io.InputStream"
use java "java.nio.file.Files"
use java "java.nio.file.Paths"
use java "java.lang.System"

## The handwritten-Java runtime classes copied verbatim into every program.
## Each entry brings its nested/anonymous classes along by the `$` name rule in
## `matches`.
##
## Nothing, since S3. Kept as the mechanism rather than deleted: it is how a
## backend declares a class it must copy into every program, and the next one
## to need that should find the road already built.
pub fn vendored_outers() -> List[String] = []

fn matches(file: String, outer: String) -> Bool =
  file == outer ++ ".class" ||
  (str.starts_with(file, outer ++ "\$") && str.ends_with(file, ".class"))

# The releases the two jar walks below bracket with. Both walks panic on a
# broken invariant partway through, which is exactly the way out that used to
# skip the close.
fn close_jar(jf: JarFile) -> Unit !io = {
  let _ = jf.close()
  ()
}

fn close_entry_stream(ins: InputStream) -> Unit !io = {
  let _ = ins.close()
  ()
}

## One entry's bytes, with the stream released however the read ends. It takes
## the stream rather than (jar, entry) because the two walks hold different
## entry types — `getEntry` hands back a `ZipEntry`, the enumeration a
## `JarEntry` — and Java's parameter subtyping does not reach Dawn signatures.
fn entry_bytes(ins: InputStream) -> Bytes !io = {
  with s <- bracket(ins, close_entry_stream)
  s.readAllBytes().expect("entry bytes")
}

## `dawn/rt/<outer>` plus every nested `dawn/rt/<outer>$…` beside it, as
## (class name, bytes) pairs sorted by name. Requires the compiler jar on the
## class path (the same condition the checker's reflection already needs).
pub fn rt_class_family(outer: String) -> List[(String, Bytes)] !io = {
  let res = "dawn/rt/" ++ outer ++ ".class"
  let loader = ClassLoader.getSystemClassLoader().expect("system loader")
  let url = match loader.getResource(res) {
    Some(u) -> u
    None -> panic("runtime class `dawn/rt/" ++ outer ++ "` is missing from the class path")
  }
  let u = url.toString().expect("url string")
  # a classes directory on the class path (running the self-emitted compiler):
  # list the sibling .class files instead of walking a jar
  if str.starts_with(u, "file:") {
    let fpath = str.strip_prefix(u, "file:").unwrap_or(u)
    let dir = match str.last_index_of(fpath, "/") {
      Some(i) -> str.take(fpath, i)
      None -> fpath
    }
    var names2: List[String] = []
    match io.list_dir(dir) {
      Ok(files) -> {
        for f in files {
          if matches(f, outer) { names2 = names2 ++ [f] }
        }
      }
      Err(e) -> panic("cannot list " ++ dir ++ ": " ++ e.message)
    }
    var out2: List[(String, Bytes)] = []
    for f in sort(names2) {
      let bs = match catch_fault(() =>
          Files.readAllBytes(Paths.get(dir ++ "/" ++ f).expect("path")).expect("bytes")) {
        Ok(b) -> b
        Err(e) -> panic("cannot read " ++ f ++ ": " ++ e.message)
      }
      out2 = out2 ++ [("dawn/rt/" ++ str.strip_suffix(f, ".class").unwrap_or(f), bs)]
    }
    return out2
  }
  if not str.starts_with(u, "jar:file:") {
    panic("vendored runtime must come from a jar, got: " ++ u)
  }
  let bang = str.index_of(u, "!").expect("jar url separator")
  let jar_path = str.slice(u, str.len("jar:file:"), bang)
  with jf <- bracket(JarFile.new(jar_path), close_jar)
  var names: List[String] = []
  let en = jf.entries().expect("entries")
  while en.hasMoreElements() {
    # `Enumeration` is erased, but a `JarFile`'s is a `JarEntry` enumeration by
    # construction — so the `Err` `cast` now returns (LANG-02) is a broken
    # invariant, and it stops the same way the ClassCastException used to.
    let got: Result[JarEntry, ForeignError] = cast(en.nextElement().expect("entry"))
    let e: JarEntry = match got {
      Ok(v) -> v
      Err(x) -> panic("vendor.rt_class_family: not a JarEntry: " ++ x.message)
    }
    let nm = e.getName().expect("entry name")
    if str.starts_with(nm, "dawn/rt/") &&
      matches(str.strip_prefix(nm, "dawn/rt/").unwrap_or(nm), outer) {
        names = names ++ [nm]
      }
  }
  var out: List[(String, Bytes)] = []
  for nm in sort(names) {
    let e = match jf.getEntry(nm) {
      Some(je) -> je
      None -> panic("jar entry vanished: " ++ nm)
    }
    let bs = entry_bytes(jf.getInputStream(e).expect("entry stream"))
    out = out ++ [(str.strip_suffix(nm, ".class").unwrap_or(nm), bs)]
  }
  out
}

fn has_name(names: List[String], n: String) -> Bool = {
  for x in names { if x == n { return true } }
  false
}

fn lookup_bytes(pairs: List[(String, Bytes)], nm: String) -> Bytes = {
  for p in pairs {
    let (n, b) = p
    if n == nm { return b }
  }
  panic("classpath_package: name vanished: " ++ nm)
}

## Class names (internal, no ".class") under `root`/`rel`, recursive.
fn dir_classes_under(root: String, rel: String) -> List[String] !io = {
  var out: List[String] = []
  match io.list_dir(root ++ "/" ++ rel) {
    Ok(files) -> {
      for f in sort(files) {
        let r2 = rel ++ "/" ++ f
        if io.is_dir(root ++ "/" ++ r2) {
          out = out ++ dir_classes_under(root, r2)
        } else if str.ends_with(f, ".class") {
          out = out ++ [str.strip_suffix(r2, ".class").unwrap_or(r2)]
        }
      }
    }
    Err(_) -> ()
  }
  out
}

## Every .class under `prefix` in one open jar, skipping the names in `seen`.
##
## Its own function because the accumulators it would otherwise write into are
## `var`s of the caller, and a closure cannot capture those — so the walk gets
## its own, returns them, and the caller merges. That is what buys the bracket:
## the jar is released whether the walk finishes or a broken entry panics it.
fn jar_classes(jf: JarFile, prefix: String, seen: List[String]) -> List[(String, Bytes)] !io = {
  with j <- bracket(jf, close_jar)
  var taken: List[String] = []
  var out: List[(String, Bytes)] = []
  let en = j.entries().expect("entries")
  while en.hasMoreElements() {
    # same invariant as rt_class_family's walk, same treatment
    let got: Result[JarEntry, ForeignError] = cast(en.nextElement().expect("entry"))
    let je: JarEntry = match got {
      Ok(v) -> v
      Err(x) -> panic("vendor.classpath_package: not a JarEntry: " ++ x.message)
    }
    let nm = je.getName().expect("entry name")
    if str.starts_with(nm, prefix ++ "/") && str.ends_with(nm, ".class") {
      let cls = str.strip_suffix(nm, ".class").unwrap_or(nm)
      if not has_name(seen, cls) && not has_name(taken, cls) {
        taken = taken ++ [cls]
        out = out ++ [(cls, entry_bytes(j.getInputStream(je).expect("entry stream")))]
      }
    }
  }
  out
}

## How a vendored package's bytes are held to account.
##
## `Digest` is the recorded hash of the whole package; `Exempt` is a package
## deliberately left unhashed, carrying the reason. There is no third case on
## purpose: a `--vendor` prefix that appears in neither is refused, because the
## mechanism's whole job is to copy binaries that have no source in this tree,
## and one entering the trusted base without a decision written down is the
## thing being prevented.
pub type VendorTrust =
  | Digest(sha: String)
  | Exempt(why: String)

## The recorded state of every package `--vendor` may copy.
##
## These are byte-identical across every selfhost seed from v0.8.0 (the first)
## to v0.47.0 -- measured by extracting each package from every cached seed jar
## and hashing it. That is what makes a literal here the right home rather than
## a line in `scripts/seed-checksums.txt`: that file records one hash per
## release and is bumped at every release, so a constant living in it would
## look like something to re-derive, and re-deriving from the jar in hand is
## precisely the check being skipped. Here it is a constant that no seed
## advance touches, and it is compiled into the compiler, so it travels the
## seed chain and applies wherever a released jar runs -- neither of which a
## repo-relative data file can do.
##
## Note the check runs one generation behind: stage 1 is built by the seed,
## whose copy of this function is the previous release's. Tampering with the
## seed's copy of a vendored class is still caught, because stage 1 carries
## that copy forward and stage 2's build hashes it.
fn vendor_trust(prefix: String) -> Option[VendorTrust] =
  # `dawn/tool` used to be listed here: one class, AdtClassWriter, 5,148
  # bytes, the only handwritten Java in the toolchain, source only at
  # `kotlin-final:compiler/src/main/java/dawn/tool/AdtClassWriter.java` and
  # byte-propagated from seed to seed. K-A4 made it unreachable and K-A7
  # replaced it: `dawn/rt/Asm` is emitted from `rtclasses.dawn` and every call
  # site names it, so the package left `--vendor` entirely and there is
  # nothing here to hold to a digest. Recording it as a hash was a mitigation;
  # not copying it at all is the removal.
  if prefix == "org/objectweb/asm" {
    # 38 classes, 253,894 bytes: the other bytecode writer with no source here.
    # Hashing it costs ~36 ms per vendor pass (measured: this SHA-256 runs at
    # ~7 MB/s, from timing 5 KB / 254 KB / 10 MB inputs through it), which is
    # ~0.3% of a toolchain rebuild.
    Some(Digest("5d77f9cbe60b78a82a15c1ed444dd9843fc6477982542ee77daf0833745e2084"))
  } else if prefix == "coursierapi" {
    # 2,409 classes, 10,057,897 bytes -- 40x the rest put together. At ~7 MB/s
    # that is ~1.4 s per vendor pass and ~2.9 s on a two-stage toolchain
    # rebuild, against a 10.7 s baseline: +27% on every rebuild, to guard the
    # one vendored package that does not write bytecode (it resolves and
    # downloads dependencies) and the one whose upstream artifact is a
    # published Maven Central release with its own checksums. Exempt on cost,
    # not on principle -- if this hash gets cheap, record it.
    Some(Exempt("10 MB; ~1.4 s per vendor pass; resolver, not a bytecode writer"))
  } else {
    None
  }

## The canonical hash of a vendored package: the `d1` shape pkgfetch already
## uses for source trees -- name, NUL, length, NUL, content, per entry in the
## sorted order `classpath_package` returns. Names and lengths are in the
## digest, not just the bytes, so a renamed or re-split class cannot collide
## with the recorded value.
fn package_digest(pairs: List[(String, Bytes)]) -> String = {
  var d = sha256.new()
  for p in pairs {
    let (nm, bs) = p
    d = sha256.update(d, bytes.utf8(nm))
    d = sha256.update(d, zero_byte())
    d = sha256.update(d, bytes.utf8(to_string(bytes.len(bs))))
    d = sha256.update(d, zero_byte())
    d = sha256.update(d, bs)
  }
  sha256.finish(d)
}

fn zero_byte() -> Bytes = bytes.utf8(str.from_char(0))

## Hold a package's copied bytes against `vendor_trust`, or stop.
##
## A mismatch exits rather than warns: at that point the bytes about to be
## copied into every program this compiler builds are not the bytes that were
## reviewed, and there is no version of continuing that is better than not.
fn check_vendored(prefix: String, pairs: List[(String, Bytes)]) -> Unit = {
  match vendor_trust(prefix) {
    Some(Exempt(_)) -> ()
    Some(Digest(want)) -> {
      let got = package_digest(pairs)
      if got != want {
        panic("vendored package `" ++ prefix ++ "` does not match its recorded hash\n" ++
            "  expected " ++ want ++ "\n" ++
            "  actual   " ++ got ++ "\n" ++
            "  " ++ to_string(len(pairs)) ++ " class(es) off java.class.path\n" ++
            "  These bytes get copied verbatim into every program this compiler\n" ++
            "  builds, and they have no source in this tree to rebuild them from.\n" ++
            "  If you changed them on purpose, update vendor_trust in\n" ++
            "  selfhost/src/vendor.dawn; otherwise your class path is not the one\n" ++
            "  this compiler was reviewed against.")
      }
    }
    None ->
      panic("vendored package `" ++ prefix ++ "` is not declared in vendor_trust\n" ++
          "  (selfhost/src/vendor.dawn). `--vendor` copies handwritten binaries\n" ++
          "  that have no source in this tree into every built program, so each\n" ++
          "  one needs a recorded hash or a written reason for not having one.\n" ++
          "  Its current hash is " ++ package_digest(pairs))
  }
}

## Every .class under package path `prefix` (e.g. "org/objectweb/asm") found
## on java.class.path, as (class name, bytes) pairs sorted by name. The first
## class-path entry providing a class wins, like the class loader. This is how
## `selfhost build` packs the compiler-jar residents (ASM, the coursier
## interface) into a standalone jar.
##
## Every `--vendor` in the repository goes through here -- bin/dawn's two build
## stages, selfhost-fixpoint.sh, replay-bootstrap.sh, selfhost-bench.sh -- so
## this is where the bytes are checked. Putting it in the shell callers instead
## would mean four copies of the same check and a fifth caller arriving without
## one.
pub fn classpath_package(prefix: String) -> List[(String, Bytes)] !io = {
  let cp = match System.getProperty("java.class.path") {
    Some(s) -> s
    None -> panic("java.class.path is unset")
  }
  var names: List[String] = []
  var found: List[(String, Bytes)] = []
  # File.pathSeparator, not ':': on Windows java.class.path is ';'-separated and
  # splitting on ':' would cut every entry at its drive letter.
  for entry in str.split(cp, File.pathSeparator!) {
    if str.ends_with(entry, ".jar") {
      match catch_fault(() => JarFile.new(entry)) {
        Ok(jf) -> {
          for pair in jar_classes(jf, prefix, names) {
            let (cls, _) = pair
            names = names ++ [cls]
            found = found ++ [pair]
          }
        }
        Err(_) -> ()
      }
    } else if io.is_dir(entry ++ "/" ++ prefix) {
      for cls in dir_classes_under(entry, prefix) {
        if not has_name(names, cls) {
          let bs = match catch_fault(() =>
              Files.readAllBytes(Paths.get(entry ++ "/" ++ cls ++ ".class").expect("path")).expect("bytes")) {
            Ok(b) -> b
            Err(e) -> panic("cannot read " ++ cls ++ ": " ++ e.message)
          }
          names = names ++ [cls]
          found = found ++ [(cls, bs)]
        }
      }
    }
  }
  var out: List[(String, Bytes)] = []
  for nm in sort(names) { out = out ++ [(nm, lookup_bytes(found, nm))] }
  check_vendored(prefix, out)
  out
}

# ---- tests ----

test "the package digest covers names and lengths, not just bytes" {
  let a = bytes.utf8("alpha")
  let b = bytes.utf8("beta")
  # the same bytes under different names must not hash the same, or a class
  # could be renamed into another's slot without moving the recorded value
  assert package_digest([("p/A", a)]) != package_digest([("p/B", a)])
  # it is a sequential hash, so order is part of the value -- which is why
  # `classpath_package` sorts before it gets here, and why a class path that
  # yields the same set in another order must not be able to pass silently
  assert package_digest([("p/A", a), ("p/B", b)]) !=
    package_digest([("p/B", b), ("p/A", a)])
  # and concatenation must not be ambiguous: "alpha"+"beta" split two ways
  assert package_digest([("p/A", bytes.utf8("alphabeta"))]) !=
    package_digest([("p/A", a), ("p/A", b)])
}

test "an empty package is not silently the same as any other" {
  # vendoring nothing is a real failure mode (wrong class path, wrong prefix),
  # so the empty digest has to be a value the table can be held against rather
  # than a pass
  assert package_digest([]) ==
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
}

test "every declared vendor package carries a usable decision" {
  for p in ["org/objectweb/asm", "coursierapi"] {
    match vendor_trust(p) {
      None -> panic("undeclared vendor package in the repository's own build: " ++ p)
      Some(Exempt(why)) -> { assert str.len(why) > 0 }
      Some(Digest(sha)) -> {
        # 64 lowercase hex digits: a truncated or upper-cased paste would
        # otherwise only show up as a mismatch at build time
        assert str.len(sha) == 64
        assert sha == str.to_lower(sha)
      }
    }
  }
  # the prefixes bin/dawn actually passes are declared; anything else is not.
  # `dawn/tool` is in this list on purpose: K-A7 retired it, and a vendor pass
  # that starts copying it again must be refused rather than silently trusted.
  assert vendor_trust("dawn/rt") == None
  assert vendor_trust("dawn/tool") == None
}

# Bitwise equality on Float: NaN matches NaN, and a zero must carry the
# expected sign (the two zeros compare equal, their reciprocals do not).
fn same(got: Float, want: Float) -> Bool =
  if want != want {
    got != got
  } else if want == 0.0 {
    got == 0.0 && 1.0 / got == 1.0 / want
  } else {
    got == want

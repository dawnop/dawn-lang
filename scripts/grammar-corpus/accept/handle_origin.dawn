# Origin is contextual only after the operation's parameter list.
ctl effect Ask { fn origin(n: Int) -> Int }
fn origin(origin: Int) -> Int = origin
fn arm() -> Int = {
  with handle Ask { origin(n) origin origin resume resume => resume(n) }
  origin(1)
}
fn tail() -> Int = {
  with handle Ask { origin(n) origin o =>
    n
  }
  origin(1)
}

# Representation checks shared by recording, pointer layout and lowering.
# These do not change the arithmetic of ordinary integer tiles.

pub(pkg) fn fits_i32(value: Int) -> Bool = value >= -2147483648 && value <= 2147483647

# Both factors are positive static extents. Check BEFORE multiplication:
# a wrapped product may still be positive, or alias the dynamic sentinel.
pub(pkg) fn suffix_overflows(suffix: Int, extent: Int) -> Bool =
  suffix > 9223372036854775807 / extent

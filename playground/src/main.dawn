# dawn-play, the Dawn Playground runner: one HTTP request per process
# (docs/playground-native-runner-design.md). systemd accepts each connection
# on dawn-play-native.socket and starts this binary with the connection as its
# stdin and stdout; it reads the request, compiles and runs the program in a
# throwaway sandbox unit, answers and exits.
#
# There is one entry. Until K5 this file was a long-lived server on the `web`
# framework and the JVM, and the process-per-request entry lived in a project
# of its own (playground/native) because a project has one main and this one
# imported a framework that sits on `use java`. The long-lived server had no
# traffic once nginx pointed at the socket, so it went, and with it the second
# project: `dawnc build playground` makes the binary, and nothing this file
# reaches may `use java`. The JVM is still what /run compiles and runs user
# programs with and what the JVM view lists with javap; that is the
# toolchain's business inside the sandbox, not the runner process's.
#
#   dawn-play serve        answer the one HTTP request on stdin, then exit
#   dawn-play job <dir>    the child the flock gate starts (play/gate)
use std/io
use std/io.{with_exit_real}
use play/serve.{serve_one, serve_job}

pub fn main() -> Unit !io =
  match args() {
    ["serve", ..] -> serve_one()
    ["job", dir] -> serve_job(dir)
    _ -> {
      io.eprintln("usage: dawn-play serve | dawn-play job <dir>")
      with_exit_real(() => io.exit(2))
    }
  }

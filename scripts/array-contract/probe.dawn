# Driver for the Array contract. Everything interesting is in the std-side
# module: user code cannot name `Array`, which is the point.
use std/io
use std/array

## Small enough to stay instant on the fast path, large enough that losing it
## means quadratic work measured in minutes.
const LINEAR_N: Int = 200000

## The copying shape has to stay small: it is O(n^2) by construction, and the
## point is to show it *is* the other path, not to wait for it.
const FORK_N: Int = 20000

pub fn main() -> Unit !io = {
  for line in array.values() { println(line) }
  println("bounds   ${array.out_of_bounds()}")
  println("frombuf  ${array.from_array()}")
  let (linear, forked) = array.timings(LINEAR_N, FORK_N)
  println("linear   ${LINEAR_N} pushes in ${linear}ms")
  println("forked   ${FORK_N} pushes in ${forked}ms")
}

# checker.dawn: arithmetic, bitwise, concatenation, equality, comparison, logic
pub fn arith() -> Int = true + 1

pub fn mixed() -> Int = 1 + 1.5

pub fn bit_left() -> Int = true & 1

pub fn bit_right() -> Int = 1 & true

pub fn cat_lists() -> List[Int] = [1] ++ ["a"]

pub fn cat_other() -> Int = 1 ++ 2

pub fn eq() -> Bool = 1 == "a"

pub fn cmp() -> Bool = 1 < "a"

pub fn logic_left() -> Bool = 1 && true

pub fn logic_right() -> Bool = true && 1

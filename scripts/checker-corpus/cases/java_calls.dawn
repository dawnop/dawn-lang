# checker.dawn: Java construction, methods and static fields
use java "java.lang.StringBuilder"
use java "java.lang.Integer"
use java "java.lang.Math"
use java "java.lang.Object"

pub fn new_on_instance() -> Int !io = {
  let b = StringBuilder.new()
  let c = b.new()
  1
}

# java.lang.Object has exactly one public constructor in every JDK, so the
# candidate list in the hint does not move with the host's version.
pub fn no_ctor() -> Int !io = {
  let b = Object.new(true)
  1
}

pub fn no_method() -> Int !io = {
  let b = StringBuilder.new()
  let n = b.nosuchmethod()
  1
}

pub fn no_static() -> Int !io = Integer.nosuchstatic(1)

pub fn no_static_field() -> Int !io = Integer.NOSUCHFIELD

pub fn no_overload() -> Int !io = Math.abs("a")

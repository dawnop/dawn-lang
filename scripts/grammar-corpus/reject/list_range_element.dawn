# expect: expected `]`, found `..`
# `[0..3]` is not a range literal. `..` is the for-header's range operator and
# a list element's spread prefix; between two values inside a list literal it
# is neither, and the literal ends at the first token that is not a comma.
# Recorded because the spread form made this the *nearest* legal reading, and a
# reader who assumes ranges got cheaper should meet the same refusal as before.
fn f() -> List[Int] = [0..3]

# expect: `Column` is a type name, so its braces are a record literal
# expect: allowed at module top level
# An uppercase name takes its braces as a record literal (spec §2.3), so a
# tail block never lands on a bare TYPEIDENT callee -- `Column { ... }` is a
# construction, and the call inside it is sitting in a field position. The
# diagnostic names that decision; component functions are lowercase.
fn f() -> Unit = {
  let c = Column { text("a") }
  use_it(c)
}

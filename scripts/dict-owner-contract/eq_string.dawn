# One `==` on strings behind an `Eq` bound, which is the smallest program that
# materialises a dictionary. Every module that needs `Eq[String]` lowers its
# own copy of the slot bridge; the emitted dictionary names exactly one of
# them, and which one is what this fixture exists to pin.
fn same[T: Eq](a: T, b: T) -> Bool = a == b

pub fn main() -> Unit !io = println("${same("a", "b")} ${same("a", "a")}")

test "scalar replay asks one candidate revision each shared question once" {
  # What the memo is for, measured rather than assumed: a module's bodies
  # repeat each other's questions, and the loop this replaced recomputed every
  # repetition. A module of eight functions over two nominal types and one
  # constant logs four facts for every one it can tell apart.
  let text = "type Shape = { width: Int, height: Int }\n" ++
    "type Flag = { on: Bool }\n" ++
    "const LIMIT: Int = 10\n" ++
    "fn one() -> Int = 1\n" ++
    "fn two(x: Int) -> Int = x + 1\n" ++
    "fn three(x: Int) -> Int = x * 2\n" ++
    "fn four(x: Int, y: Int) -> Int = x + y\n" ++
    "fn five(b: Bool) -> Bool = not b\n" ++
    "fn six(x: Int) -> Bool = x > LIMIT\n" ++
    "fn seven(s: Shape) -> Int = s.width\n" ++
    "fn eight(f: Flag) -> Bool = f.on\n"
  let snapshot = source_snapshot.of(text).expect("repetition snapshot")
  let observing = Cx { ..cx_new(Some("sample"), Some("sample.dawn")), function_reads: Some([]) }
  let headers = checker.check_module_headers(observing, source_snapshot.syntax(snapshot), map.empty())
  assert headers.cx.diags == []
  let facts = checker.check_module_body_products(headers).cx.function_reads.expect("module log")
  assert len(facts) > 2 * set.len(set.from(facts))
  # One real computation per distinct shareable fact, and strictly fewer
  # computations than questions. The verdict the memo returns is the verdict
  # the per-body loop returned, hit or miss, fact for fact.
  var memo = new_memo()
  var distinct: Set[FunctionRead] = set.empty()
  var questions = 0
  var computed = 0
  for fact in facts {
    if shared(fact) {
      questions = questions + 1
      distinct = set.insert(distinct, fact)
      match query_runtime.read(memo, fact).answer {
        query_runtime.Available(_) -> ()
        _ -> { computed = computed + 1 }
      }
      let (next_memo, verdict) = revalidated(memo, headers.cx, headers.cx, fact)
      memo = next_memo
      assert verdict == checker.revalidate_read(headers.cx, fact)
    }
  }
  assert questions > 0 && computed == set.len(distinct) && computed < questions
}

test "scalar replay carries one memo across the bodies of a revision and no further" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n"
  let after = "type Added = { value: Int }\nfn other(x: Int) -> Int = x\n# moved\nfn answer() -> Int = 42\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let new_syntax = source_snapshot.syntax(next_snapshot)
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, new_syntax, map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  let admitted: AdmittedData = admit(scope, old, old_snapshot, saved)
  # The memo travels with the revision rather than with the body: both
  # declarations here ask the same question, and only the first one pays for
  # the answer.
  var carried = prepare(admitted, next, next_snapshot).expect("prepared candidate revision")
  var questions = 0
  var answered_already = 0
  for (declaration, name) in [(1, "other"), (2, "answer")] {
    let d = match new_syntax.decls[declaration] { DFn(syntax) -> syntax, _ -> panic("declaration") }
    let sig = map.get(next.cx.fns, name).expect("candidate header")
    let (prior, _) = relocation(carried, next.cx, d, sig).expect("relocation")
    for fact in prior.product.function_reads.expect("recorded log") {
      if shared(fact) {
        questions = questions + 1
        match query_runtime.read(carried.memo, fact).answer {
          query_runtime.Available(_) -> { answered_already = answered_already + 1 }
          _ -> ()
        }
      }
    }
    let (after_body, verdict) = candidate(carried, next.cx, d, sig)
    assert match verdict { Reused(_) -> true, _ -> false }
    carried = after_body
  }
  assert questions == 2 && answered_already == 1
  # The production pass carries the same preparation, so the memo the module
  # ends with is the one its bodies filled.
  let (outcome, _) = checker.execute_module_bodies(next,
    Pass { counts: zero_counts(),
      prepared: prepare(admitted, next, next_snapshot) }, pass_executor())
  assert outcome.counts.reused == 2 && outcome.counts.cold_unadmitted == 0
  let finished = outcome.prepared.expect("carried preparation")
  let probe = AssignableType(TyInt, TyInt, true)
  assert shared(probe)
  assert match query_runtime.read(finished.memo, probe).answer {
    query_runtime.Available(value) -> value == Some(true)
    _ -> false
  }
  # A memo belongs to the revision that prepared it. Another preparation of
  # the same recording starts with nothing answered, so no verdict crosses
  # from one candidate revision into another.
  let fresh = prepare(admitted, next, next_snapshot).expect("second preparation")
  assert match query_runtime.read(fresh.memo, probe).answer {
    query_runtime.Needs(_) -> true
    _ -> false
  }
}

test "scalar replay shares builtin hits and misses but not signature binders" {
  # Int is deliberately a signature binder in the last two functions. The
  # builtin probe succeeds, but the subsequent scoped probe resolves each
  # declaration's distinct binder. Sharing one must not share the other.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let text = "fn first[T](x: T) -> T = {\n let y: T = x\n y\n}\n" ++
    "fn second[T](x: T) -> T = {\n let y: T = x\n y\n}\n" ++
    "fn third[Int](x: Int) -> Int = {\n let y: Int = x\n y\n}\n" ++
    "fn fourth[Int](x: Int) -> Int = {\n let y: Int = x\n y\n}\n"
  let snapshot = source_snapshot.of(text).expect("builtin memo snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let headers = checker.check_module_headers(base, source_snapshot.syntax(snapshot), map.empty())
  let saved = body_execution.record(scope, headers)
  assert saved.refused == 0 && saved.bodies.cx.diags == []
  let admitted: AdmittedData = admit(scope, headers, snapshot, saved)
  assert admitted_count(admitted) == 4
  var prepared = prepare(admitted, headers, snapshot).expect("builtin candidate")
  var questions = 0
  var hits = 0
  var scoped_reads = 0
  for (index, name) in [(0, "first"), (1, "second"), (2, "third"), (3, "fourth")] {
    let d = match headers.syntax.decls[index] { DFn(fn_decl) -> fn_decl, _ -> panic("function") }
    let sig = map.get(headers.cx.fns, name).expect("signature")
    let (prior, _) = relocation(prepared, headers.cx, d, sig).expect("builtin relocation")
    for fact in prior.product.function_reads.expect("real recorded queries") {
      match fact {
        BuiltinTypeAnswer(_, _) -> {
          assert shared(fact)
          questions = questions + 1
          match query_runtime.read(prepared.memo, fact).answer {
            query_runtime.Available(value) -> {
              assert value == Some(true)
              hits = hits + 1
            }
            _ -> ()
          }
        }
        ScopedTypeParameter(_, _) -> {
          scoped_reads = scoped_reads + 1
          assert not shared(fact)
        }
        _ -> ()
      }
    }
    let (next, verdict) = candidate(prepared, headers.cx, d, sig)
    assert match verdict { Reused(_) -> true, _ -> false }
    prepared = next
  }
  assert questions == 4 && hits == 2 && scoped_reads == 4
  let (pass, bodies) = checker.execute_module_bodies(headers,
    Pass { counts: zero_counts(), prepared: prepare(admitted, headers, snapshot) }, pass_executor())
  assert pass.counts.reused == 4
  assert bodies.functions == checker.check_module_body_products(headers).functions
  let finished = pass.prepared.expect("executor memo")
  let fresh = prepare(admitted, headers, snapshot).expect("fresh revision")
  let changed = Cx { ..headers.cx, btypes: map.insert(map.remove(headers.cx.btypes, "Int"),
    "T", map.get(headers.cx.btypes, "Int").expect("builtin Int")) }
  for fact in [BuiltinTypeAnswer("Int", map.get(headers.cx.btypes, "Int")), BuiltinTypeAnswer("T", None)] {
    assert match query_runtime.read(finished.memo, fact).answer {
      query_runtime.Available(value) -> value == Some(true)
      _ -> false
    }
    assert match query_runtime.read(fresh.memo, fact).answer {
      query_runtime.Needs(_) -> true
      _ -> false
    }
    # A new revision can remove a hit or turn a miss into a hit. Neither
    # change may inherit this revision's successful validation.
    let (memo, verdict) = revalidated(fresh.memo, changed, changed, fact)
    assert verdict == Some(false)
    let (again, cached) = revalidated(memo, changed, changed, fact)
    assert cached == verdict
    assert match query_runtime.read(again, fact).answer {
      query_runtime.Available(value) -> value == Some(false)
      _ -> false
    }
  }
  let changed_headers = ModuleHeaders { ..headers, cx: changed }
  let refused = replay(admit(scope, headers, snapshot, saved), changed_headers, snapshot)
  assert refused.reused == 0 && refused.cold_rejected == 4 && refused.cold_unadmitted == 0
  let cold = checker.check_module_body_products(changed_headers)
  assert refused.bodies.functions == cold.functions
  assert refused.bodies.cx.diags == cold.cx.diags
}

test "scalar replay reuses a generic body under the candidate signature's binders" {
  # M2.3. The scoped queries a body asks belong to the declaration, not to the
  # module: the executor hands the replay path the context the scheduler
  # entered the declaration with, where no binder is bound yet, and
  # `check_fn` binds them on the way into the body. The same recorded fact is
  # false in the first context and true in the second, and that difference is
  # the whole knife: without the binders put back, no generic body is ever
  # reused.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let body = "fn hold[T](x: T) -> T = {\n let y: T = x\n y\n}\n"
  let after = "type Added = { n: Int }\n" ++ body
  let old_snapshot = source_snapshot.of(body).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let new_syntax = source_snapshot.syntax(next_snapshot)
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, new_syntax, map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  assert saved.refused == 0
  let admitted: AdmittedData = admit(scope, old, old_snapshot, saved)
  assert admitted_count(admitted) == 1
  let prepared = prepare(admitted, next, next_snapshot).expect("prepared candidate revision")
  let declaration = match new_syntax.decls[1] { DFn(d) -> d, _ -> panic("hold syntax") }
  let sig = map.get(next.cx.fns, "hold").expect("hold header")
  let (prior, _) = relocation(prepared, next.cx, declaration, sig).expect("relocation")
  # Not a vacuous judgment: this body really does ask for its own type
  # parameter by name, and that question is the one the entry context cannot
  # answer.
  var asked_binders = 0
  for fact in prior.product.function_reads.expect("recorded log") {
    match fact {
      ScopedTypeParameter(_, _) -> {
        asked_binders = asked_binders + 1
        assert not shared(fact)
        assert checker.revalidate_read(next.cx, fact) == Some(false)
        assert checker.revalidate_read(binder_context(next.cx, sig), fact) == Some(true)
      }
      _ -> ()
    }
  }
  assert asked_binders > 0
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 1 && actual.checked == 0
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.current_tparams == expected.cx.current_tparams
  assert map.len(expected.cx.current_tparam_bounds) > 0
  assert actual.bodies.cx.current_tparam_bounds == expected.cx.current_tparam_bounds
  assert actual.bodies.cx.frame == expected.cx.frame
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.cx.function_reads == expected.cx.function_reads
  assert actual.bodies.cx.body_writes == expected.cx.body_writes
}

test "scalar replay refuses a generic body whose binders changed" {
  # The other half of the same rule. Renaming the type parameter and putting a
  # bound on it are both edits to the declaration's own head: the first makes
  # every binder the body names another binder, the second puts a dictionary
  # in the entry frame that nothing in this class can rebuild. Both land cold.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let body = "fn hold[T](x: T) -> T = {\n let y: T = x\n y\n}\n"
  let old_snapshot = source_snapshot.of(body).expect("recorded snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  assert old.cx.diags == []
  let saved = body_execution.record(scope, old)
  for text in [
    "fn hold[Item](x: Item) -> Item = {\n let y: Item = x\n y\n}\n",
    "trait Held[T] { fn held(x: T) -> Int }\n" ++
      "fn hold[T: Held](x: T) -> T = {\n let y: T = x\n y\n}\n"
  ] {
    let next_snapshot = source_snapshot.of(text).expect("candidate snapshot")
    let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
    assert next.cx.diags == []
    let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
    let expected = checker.check_module_body_products(next)
    assert actual.reused == 0
    assert actual.bodies.functions == expected.functions
    assert actual.bodies.cx.diags == expected.cx.diags
    assert actual.bodies.cx.syms == expected.cx.syms
    assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  }
}

test "scalar replay counts a withdrawn claim apart from a class it never claimed" {
  # P8. The two cold columns answer different questions, and one number could
  # answer neither. `cold_unadmitted` is the width of the class: the constant,
  # the test body and the function whose parameter is not a type this producer
  # carries were never claimed for replay at all. `cold_rejected` is the
  # candidate revision withdrawing a claim that was made: `hold` is admitted
  # and paired, its bytes, its header and its identity are the recorded ones,
  # and then the revision answers one of the facts its body recorded
  # differently.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let text = "const K: Int = 7\n" ++
    "fn hold[T](x: T) -> T = {\n let y: T = x\n y\n}\n" ++
    "fn cold_one(s: String) -> String = s\n" ++
    "test \"probe\" { assert true }\n"
  let snapshot = source_snapshot.of(text).expect("snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(snapshot), map.empty())
  assert old.cx.diags == []
  let saved = body_execution.record(scope, old)
  let plain = replay(admit(scope, old, snapshot, saved), old, snapshot)
  assert plain.reused == 1 && plain.cold_unadmitted == 3 && plain.cold_rejected == 0
  assert plain.checked == plain.cold_unadmitted + plain.cold_rejected
  # The same revision with one table moved under it. Nothing about the
  # declaration changed, so admission still pairs it; what changed is the
  # answer to a question its body asked.
  let shadow = map.get(old.cx.btypes, "Int").expect("the Int builtin")
  let moved = ModuleHeaders { ..old,
    cx: Cx { ..old.cx, btypes: map.insert(old.cx.btypes, "T", shadow) } }
  let actual = replay(admit(scope, old, snapshot, saved), moved, snapshot)
  assert actual.reused == 0 && actual.cold_rejected == 1 && actual.cold_unadmitted == 3
  assert actual.checked == 4
  let expected = checker.check_module_body_products(moved)
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.constants == expected.constants
  assert actual.bodies.tests == expected.tests
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
}

# checker.dawn: `T.Assoc` projections
trait HasIt[T] {
  type It
  fn one(x: T) -> Int
}

trait AlsoIt[T] {
  type It
  fn two(x: T) -> Int
}

trait NoIt[T] {
  fn three(x: T) -> Int
}

pub fn not_a_param(x: Int.It) -> Int = 1

pub fn no_declarer[T: NoIt](x: T.It) -> Int = 1

pub fn ambiguous[T: HasIt + AlsoIt](x: T.It) -> Int = 1

type Sub = S

impl HasIt[Sub] {
  type It = Int
  fn one(x: Sub) -> Int = 1
}

type Wrap[T] = W(v: T)

impl[T: HasIt] HasIt[Wrap[T]] {
  type It = T.It
  fn one(x: Wrap[T]) -> Int = 1
}

-- scalars --
0            : 0
7            : 7
-1           : 0
2^32         : 1
true         : 1231
false        : 1237
empty string : 0
abc          : 96354
utf8 hi      : 4290
-- tuples: order is part of the value --
(1, 2)       : 994
(2, 1)       : 1024
(1, a, true) : 34990
-- one constructor: nothing to disagree about --
Point(1, 2)  : 994
Rec          : 5363
-- several constructors: the tag is part of the value --
Circle(3)    : 964
Rect(3, 3)   : 30848
Origin       : 33
-- recursive, and through the prelude's own union --
Leaf         : 31
Node(L, 1, L): 983165
Some(Point)  : 1955
None         : 32
-- equal values hash equally --
Point(1,2)   : yes
Origin       : yes
(1, a)       : yes
Node deep    : yes
-- and find each other in a Map keyed by them --
(1, a) -> 10 : yes
(2, b) -> 20 : yes
(9, z) absent: yes
Circle(3)    : yes
Rect(3, 3)   : yes
Origin       : yes
Circle(4) abs: yes
size         : 3
Leaf in set  : yes
Node in set  : yes
other absent : yes
size         : 2

# The checker state, in Dawn: the record every checking function threads, the
# types its fields are made of, and the constructor that mints a fresh one.
#
# This is the base of the checker's module DAG (docs/arch-split-design.md
# §2.1). It sits below checker.dawn and above types/ast/token/jsig, and it
# exists because nine downstream modules need `Cx` and `ModExports` while Dawn
# has no re-export: a name reachable from `checker` alone would pin the whole
# 11k-line file under all of them.

use std/str
use std/list
use std/map
use std/set
use front/token.{Diag}
use front/ast.{TypeRef, TNamed, TQual, TAssoc, TTuple, TFn, EffArg}
use check/types.{
  Adts, AdtI, Traits, TraitI, ImplI, Impls, Sig, Sym, Ty, Eff, Effects, EffectI,
  no_eparam_names,
  Audience, AWorld,
  TyInt, TyFloat, TyBool, TyString, TyUnit, TyError, TyVar, TyAssoc, TyAdt,
  TyList, TyMap, TySet, TyArray, TyJava, TyTuple, TyFn, TyOpaque,
  EPure, EIo, EffVar, ELabeled, EffAssoc, eff_union, eff_base, eff_labels,
  adt_of, trait_of, subst,
  BuiltinTypeI, builtin_type_map,
  builtin_type_visible, builtin_type_visible_at_return,
  builtin_type_hard_reserved, builtin_type_apply, builtin_type_render,
  public_builtin_type_names,
  builtins, internal_builtins,
  prelude_adts, prelude_traits, first_minted_id
}
use check/jsig.{Jsig, jsig_refused}
use front/suggest

## An alias entry: the Kotlin AliasInfo without its mutable resolution slots
## (resolution results live in Cx.alias_resolved, the in-flight set in
## Cx.alias_resolving).
pub type AliasE = {
  name: String,
  tparams: List[Ty],
  # the effect variables the declaration bound (`alias Thunk[!e]`), minted here
  # rather than while the target resolves so a use site has ids to substitute
  # into. Declaration order, which is the order a use site's effect arguments
  # are matched against (spec §6.3). `Ty`s and `Eff`s never share a list for
  # the reason `Sig.eparams` gives: the type arguments stay positionally
  # aligned with `tparams` whatever the author interleaved.
  eparams: List[Eff],
  # the unresolved target in the declaring module; None on imported aliases
  target: Option[TypeRef],
  # `opaque type` rather than `alias`: resolving the name yields a TyOpaque
  # instead of the target, and only `owner` may convert between the two.
  # `id` is minted from the same counter as ADT ids so the two never collide
  # in `ty_key`, which names dictionaries and impl methods.
  is_opaque: Bool,
  id: Int,
  owner: String,
  # who may name this alias (SEM-07). An opaque type is a nominal identity and
  # this is what SEM-07 checks at every reference; a transparent alias is a
  # spelling, and its audience only decides whether the alias is a surface
  # root — a private one that expands to public types is not a leak (design
  # §5.2), so this field never rejects a *use* of a transparent alias.
  audience: Audience,
  nlo: Int,
  nhi: Int
}

## Where one node of a resolved type came from. `resolve_type` builds this
## alongside the `Ty` it returns, so the two trees are isomorphic by
## construction rather than by a later attempt to walk the AST and the type in
## lockstep — which cannot work, because a transparent alias expands into a
## `Ty` subtree that has no `TypeRef` under it.
##
## `kids` is empty exactly where the type has no further *written* structure:
## a leaf, or an expanded alias. A consumer that runs out of kids is standing
## on the innermost token the author actually wrote, which is the span SEM-07
## wants (design §八).
pub type TySpan = { lo: Int, hi: Int, kids: List[TySpan] }

## The span node for a type's `i`th child, or this node itself where the child
## has no written form of its own.
pub fn ty_span_kid(sp: TySpan, i: Int) -> TySpan =
  match get(sp.kids, i) {
    Some(k) -> k
    None -> TySpan { lo: sp.lo, hi: sp.hi, kids: [] }
  }

## The part of the checker state that an isolated body -- a comptime block or a
## const initializer, which are `enter_isolated`'s only two callers -- saves on
## the way in and restores on the way out. `enter_isolated` hands the old frame
## back and `leave_isolated` puts it back with one field write, where both used
## to copy eight fields by hand through a twin record called EffFrame.
## (`unsafe_pure` is *not* one of them, though this comment used to say it was:
## `check_unsafe_pure` hand-saves `used_effects` and `eff_witness` and nothing
## else, and never goes through here.)
##
## These nine are exactly the ones that twin listed: the
## type is the restore set, so a tenth field added here silently widens what an
## isolated body restores, and that change is invisible to every byte-level
## gate in the tree (docs/arch-split-design.md D9 and §5.4). What does see it is
## the eight `isolated_*` cases in scripts/checker-corpus/ plus the inline test
## beside `leave_isolated`; the acceptance rule for both is the drop-restore
## matrix in §5.4 -- drop one field from the restore and at least one of them
## must go red.
## Fields that look like they belong --
## `current_tparams`, `current_tparam_bounds`, `current_eff_vars`, `loop_jumps`,
## `in_test` -- stay on `Cx` because today they are not restored, and `enter_fn`
## writes the first three from inside an isolated body whenever it holds a
## local fn.
pub type Frame = {
  # lexical scopes, innermost last; each maps name → symbol id
  scopes: List[Map[String, Int]],
  # effect bookkeeping for the body being checked
  used_effects: List[Eff],
  eff_witness: Map[Eff, (Int, Int, String)],
  current_sig: Option[Sig],
  # (tvar id, trait id) → dictionary symbol id
  dict_syms: Map[(Int, Int), Int],
  lambda_stack: List[LambdaCx],
  loop_stack: List[Int],
  # inside a comptime block or a const initializer: no effect of any kind may
  # cross, and v1 refuses declared effects there outright (design §4.5)
  isolated: Bool
}

## The checker state: every mutable member of the Kotlin Checker class.
pub type Cx = {
  diags: List[Diag],
  next_id: Int,
  adts: Adts,
  traits: Traits,
  # name-keyed views of the current module's scope
  fns: Map[String, Sig],
  # where each `fns` entry came from, maintained in step with it by bind_fn --
  # the precedence rule reads this and nothing else (design §4.1)
  fn_origin: Map[String, Origin],
  # the bundled std's implicit surface (PRELUDE names); local decls shadow it
  std_fns: Map[String, Sig],
  # the builtin signature table, and the subset of it no user module may name.
  # Constant for the life of a Cx and built once by cx_new: both used to be
  # rebuilt inside the resolver, so every name a module mentions paid for a
  # 90-entry map -- twice, because the hidden set is derived from the
  # intrinsic table, which is itself derived from the builtin one.
  bins: Map[String, Sig],
  hidden_bins: Set[String],
  # the compiler-owned type inventory, keyed by name, for the same reason: it
  # is a list literal, so resolve_named rebuilt all twelve records for every
  # named type a module mentions
  btypes: Map[String, BuiltinTypeI],
  adts_by_name: Map[String, Int],
  aliases: Map[String, AliasE],
  alias_resolved: Map[String, Ty],
  alias_resolving: Set[String],
  ctors_by_name: Map[String, (Int, Int)],
  traits_by_name: Map[String, Int],
  local_traits: List[String],
  local_impls: List[ImplI],
  # the subset of `local_impls` the public surface validator decided is
  # observable to this module's own audience (docs/public-surface-design.md
  # §7.1). `dawn doc` publishes this and not `local_impls`: an impl is a
  # surface root only when the reader can name both halves of its head, and a
  # consumer that decided that for itself would be a second copy of the rule,
  # free to drift from the one the checker enforced. Empty until
  # pass_export_surface runs.
  observable_impls: List[ImplI],
  impl_table: Impls,
  module_aliases: Map[String, String],
  # (alias, fn name) → the imported module's signature (for qualified calls)
  module_fn_sigs: Map[(String, String), Sig],
  imported_names: Map[String, String],
  # constants: declared type by name, in declaration order
  consts: Map[String, Ty],
  const_order: List[String],
  all_const_names: Set[String],
  const_cutoff: Option[Set[String]],
  # `use java` imports: simple name → fqcn
  java_classes: Map[String, String],
  # the host's Java signature oracle; jsig_refused() unless the driver wires
  # jreflect's (the native form of `use java` is a refusal, plan §14.10)
  jsig: Jsig,
  # the save/restore set of an isolated body, in one box (see Frame)
  frame: Frame,
  # symbol table: id → symbol
  syms: Map[Int, Sym],
  # declared effects visible here: name -> effect id, which is also the id of
  # the synthesised evidence record (docs/effects-design.md §5.1)
  effects: Map[String, Int],
  effect_infos: Effects,
  current_eff_vars: Map[String, Eff],
  current_tparams: Map[String, Ty],
  # bounds of the type parameters in scope, keyed by the TyVar's id (not its
  # name: fresh ids are never reused, so a stale entry can never be reached
  # through a fresh current_tparams and no save/restore is needed). Feeds
  # `T.Item` resolution (assoc-types-design.md D2).
  current_tparam_bounds: Map[Int, List[Int]],
  in_test: Bool,
  is_std_module: Bool,
  owner_class: Option[String],
  src_path: Option[String],
  # code-point offsets of line starts in the current source (set by the driver)
  line_starts: List[Int],
  # removed-name → where-it-went hints (populated by the std loader)
  moved: Map[String, String],
  # whole-module imports: alias → the exporter's surface (for call diagnostics)
  module_exports: Map[String, ModExports],
  # loop-stack indices that saw a break/continue (drives TSWhile/TSFor has_jumps)
  loop_jumps: Set[Int],
  # the source span of every `TypeRef` this module has resolved, keyed by that
  # ref's own `(lo, hi)` — which is a unique identity, since two type
  # references cannot occupy the same offsets. SEM-07 reads it to put a
  # diagnostic on the innermost token the author wrote (design §八).
  ty_spans: Map[(Int, Int), TySpan],
  # is `resolve_type` filling `ty_spans`? True for the header passes, whose
  # results the public surface validator reads, and false afterwards: a body's
  # type annotations have no public surface, so recording them would be a map
  # insert per annotation that nothing ever looks up.
  record_ty_spans: Bool,
  # the one handler state cell whose *next* read is to be a `cell_take` rather
  # than a `cell_get` (docs/handler-state-design.md). Set by
  # `checker.check_stmt`'s assignment arm for the length of one right-hand
  # side, cleared by the read that consumes it, and never set for more than
  # one read: the decision is made before the side is checked, from the
  # syntax, and `checker.cell_take_ok` is where the conditions are.
  take_cell: Option[Int]
}

## One lambda's frame. `sugar` says the parser synthesized this lambda from a
## `with` statement (ast.dawn), which changes nothing about how it is checked
## and everything about how a `return`/`break`/`?` inside it is reported.
## `arm` narrows `sugar`: the closure is a `with handle` arm rather than the
## remainder of a `with` block. Both are code the author did not spell as a
## lambda, and each has to be named as what it is when a jump tries to leave it.
##
## `boundary` is the only thing evidence still asks this record: a name found
## below it was found outside the closure, which for an evidence name means the
## closure reads its own pack instead (`checker.ev_expr`) and does **not**
## capture (`checker.resolve_local`).
pub type LambdaCx =
  {
    boundary: Int,
    expected_ret: Option[Ty],
    captures: List[Int],
    sugar: Bool,
    # `settled` / `unsettled` used to sit here: which of the labels this
    # closure raised had been answered by a `with handle` in the body it was
    # written in, so that its row could be rewritten at the point it was
    # created. Nothing rewrites a closure's row now -- the evidence is not
    # captured, so the creation point knows nothing the call site does not --
    # and both fields went with the rule.
    arm: Bool,
    # which `with handle` installation this closure belongs to, if any: the
    # arms and the remainder of one installation carry its id, everything else
    # carries `None`. It is the licence a state cell's escape ban reads
    # (docs/handler-state-design.md, `checker.resolve_local`), and it is a
    # separate field from `sugar` on purpose -- the remainder of a
    # `with x <- f()` is sugar too, and it is handed to a *user* function that
    # may store it, so sugar is not evidence of belonging to anything.
    handler_of: Option[Int]
  }

## A fresh checker state for one module.
##
## `is_std_module` -- what opens the std-only builtins, `unsafe_pure` and the
## representation modules -- is *proposed* here from the module's name, and
## every production caller overwrites it. The name is not evidence: a project
## file at `src/std/foo.dawn` is spelled exactly like a bundled module and is
## not one, and a bundled module opened in an editor is spelled `main` and is
## one. `driver/analyze.dawn` settles it from where the file came from
## (`std_module_of`) and assigns the answer in the record update below its
## `cx_new` call; `driver/stdlib.dawn` does the same, unconditionally, for the
## bundle it is itself loading.
##
## The proposal survives for the test fixtures that build a `Cx` by hand and
## have no file behind them. Nothing that decides a real program's access
## reaches it.
pub fn cx_new(owner_class: Option[String], src_path: Option[String]) -> Cx = {
  let is_std = match owner_class {
    Some(o) -> o == "std" || str.starts_with(o, "std/")
    None -> false
  }
  Cx {
    diags: [],
    # One counter feeds the prelude ADT ids (Option/Result/ForeignError) and
    # the prelude trait ids (Ord/Eq/Hash/Show/Iter) alike, so minting has to
    # open past all of them. Twice it did not: when Show arrived the literal
    # here stayed at 3, and when Iter arrived it stayed at 4 -- the same number
    # Iter itself now holds. Neither collided, and both times for the same
    # non-reason: a trait declaration mints its type variable before its trait
    # id, so the first user trait steps over the counter's opening value.
    # first_minted_id reads the tables instead, and the test below walks them.
    next_id: first_minted_id(),
    adts: prelude_adts(),
    traits: prelude_traits(),
    fns: map.empty(),
    fn_origin: map.empty(),
    std_fns: map.empty(),
    bins: builtins(),
    hidden_bins: internal_builtins(),
    btypes: builtin_type_map(),
    adts_by_name: map.empty(),
    aliases: map.empty(),
    alias_resolved: map.empty(),
    alias_resolving: set.empty(),
    ctors_by_name: map.empty(),
    traits_by_name: map.empty(),
    local_traits: [],
    local_impls: [],
    observable_impls: [],
    impl_table: map.empty(),
    module_aliases: map.empty(),
    module_fn_sigs: map.empty(),
    imported_names: map.empty(),
    effects: map.empty(),
    effect_infos: map.empty(),
    consts: map.empty(),
    const_order: [],
    all_const_names: set.empty(),
    const_cutoff: None,
    java_classes: map.empty(),
    jsig: jsig_refused(),
    frame: Frame {
      scopes: [],
      used_effects: [],
      eff_witness: map.empty(),
      current_sig: None,
      dict_syms: map.empty(),
      lambda_stack: [],
      loop_stack: [],
      isolated: false
    },
    syms: map.empty(),
    current_eff_vars: map.empty(),
    current_tparams: map.empty(),
    current_tparam_bounds: map.empty(),
    in_test: false,
    is_std_module: is_std,
    owner_class: owner_class,
    src_path: src_path,
    line_starts: [],
    moved: map.empty(),
    module_exports: map.empty(),
    loop_jumps: set.empty(),
    ty_spans: map.empty(),
    record_ty_spans: false,
    take_cell: None
  }
}

test "the shared counter starts past every prelude id" {
  # ADTs and traits draw from one counter but live in separate id spaces, so
  # a minted id equal to a prelude id of the *other* kind is fine -- equal to
  # one of its own kind is a silent map overwrite. This walks both tables
  # rather than naming the ids: the earlier version listed ForeignError and
  # Show by hand, so when Iter took trait id 4 the counter was left standing
  # on Iter's id and nothing said a word. A prelude entity added to either
  # table is covered here the moment it is added.
  let cx = test_cx()
  for aid in map.keys(prelude_adts()) {
    assert cx.next_id > aid
  }
  for tid in map.keys(prelude_traits()) {
    assert cx.next_id > tid
  }
  # and it is still derived: a literal put back here would pass the loops above
  # for exactly as long as it happened to be large enough
  assert cx.next_id == first_minted_id()
}

## Where a name in the module's function namespace came from. The pass order --
## seed_prelude, then pass_imports, then the module's own declarations -- is
## already a precedence order; this type is that order made sayable, so the
## rule for who may overwrite whom lives in one place instead of being
## re-derived at each write site (docs/prelude-namespace-design.md §4.1).
pub type Origin =
  | OPrelude
# the module path spelled in the `use` that brought the name
  | OImport(from: String)
# how the declaration is named in diagnostics: "function", "trait method"
# or "operation"
  | OLocal(kind: String)

## The pub surface of one checked module (the Kotlin ModuleExports): carried by
## value, with the ADT/trait table fragments an importer grafts into its own
## id tables. `all_names` lets an importer tell "private" apart from "unknown".
pub type ModExports = {
  mod_path: String,
  class_name: String,
  fns: Map[String, Sig],
  types_by_name: Map[String, Int],
  aliases: Map[String, AliasE],
  # pub aliases as resolved in the declaring module (imports consume this;
  # re-resolving the target against the importer's scope would fail)
  alias_resolved: Map[String, Ty],
  ctors: Map[String, (Int, Int)],
  consts: Map[String, Ty],
  all_names: List[String],
  src_path: Option[String],
  traits_by_name: Map[String, Int],
  # declared effects by name, and the whole id-keyed table (grafted like the
  # ADT table is: an effect id has to mean the same thing in every module)
  effects: Map[String, Int],
  effect_infos: Effects,
  impls: List[ImplI],
  adt_infos: Map[Int, AdtI],
  trait_infos: Map[Int, TraitI]
}

## A fresh state for the tests that live beside the checker.
pub fn test_cx() -> Cx = cx_new(None, None)

# ---- diagnostics ----

pub fn cerr(cx: Cx, msg: String, lo: Int, hi: Int) -> Cx =
  Cx { ..cx, diags: cx.diags ++ [Diag { msg: msg, lo: lo, hi: hi, hint: "" }] }

pub fn cerr_h(cx: Cx, msg: String, lo: Int, hi: Int, hint: String) -> Cx =
  Cx { ..cx, diags: cx.diags ++ [Diag { msg: msg, lo: lo, hi: hi, hint: hint }] }

## An error with an optional hint (the Kotlin `sink.error(msg, span, hint?)`).
pub fn cerr_o(cx: Cx, msg: String, lo: Int, hi: Int, hint: Option[String]) -> Cx =
  match hint {
    Some(h) -> cerr_h(cx, msg, lo, hi, h)
    None -> cerr(cx, msg, lo, hi)
  }

# ---- fresh ids ----

pub fn fresh(cx: Cx) -> (Cx, Int) = (Cx { ..cx, next_id: cx.next_id + 1 }, cx.next_id)

pub fn fresh_effvar(cx: Cx, name: String) -> (Cx, Eff) = {
  let (cx1, id) = fresh(cx)
  (cx1, EffVar(name, id))
}

# ---- module aliases ----

## A local declaration may not shadow a whole-module alias (spec §10.3).
pub fn alias_shadow(cx: Cx, name: String, lo: Int, hi: Int) -> Cx =
  match map.get(cx.module_aliases, name) {
    None -> cx
    Some(mod_path) -> alias_shadow_at(cx, name, mod_path, lo, hi)
  }

## The same report when the alias is the one arriving second: the module path is
## in hand but not yet in the table, so there is nothing to look up.
pub fn alias_shadow_at(cx: Cx, name: String, mod_path: String, lo: Int, hi: Int) -> Cx =
  cerr_h(cx, "`" ++ name ++ "` shadows the imported module `" ++ mod_path ++ "`",
    lo, hi, "an imported module's alias and your names share one namespace; rename one")

# ---- effect bookkeeping ----

## The declared effect behind an id (the table is grafted across modules the
## way the ADT table is).
pub fn effect_of(cx: Cx, id: Int) -> EffectI =
  match map.get(cx.effect_infos, id) {
    Some(e) -> e
    None -> panic("unknown effect id: ${id}")
  }

## A row carrying exactly one declared effect.
pub fn label_eff(cx: Cx, id: Int) -> Eff = ELabeled(EPure, [(id, effect_of(cx, id).name)])

pub fn resolve_eff_at(cx: Cx, atoms: List[String], lo: Int, hi: Int) -> (Cx, Eff) = {
  var cx1 = cx
  var effs: List[Eff] = []
  for a in atoms {
    if a == "io" {
      effs = effs ++ [EIo]
    } else if str.contains(a, ".") {
      # `C.E`: an associated-effect projection (docs/effect-params-design.md
      # 刀 5). The parser only builds a dotted atom out of two uppercase
      # names, so the split is exact.
      let parts = str.split(a, ".")
      let (cx2, e) = resolve_eff_assoc(cx1, parts[0], parts[1], lo, hi)
      cx1 = cx2
      effs = effs ++ [e]
    } else {
      match map.get(cx1.effects, a) {
        Some(eid) -> { effs = effs ++ [label_eff(cx1, eid)] }
        None ->
          if is_upper_name(a) {
            cx1 = cerr_h(cx1, "unknown effect `" ++ a ++ "`", lo, hi,
              "declare it with `effect " ++ a ++ " { ... }` (or import it); " ++
                "effect variables are lowercase")
          } else {
            match map.get(cx1.current_eff_vars, a) {
              Some(v) -> { effs = effs ++ [v] }
              None -> {
                # spec §6.3: an effect variable is introduced by appearing.
                # This arm is where a signature's effect parameters are
                # minted, and this table is what `eff_params_of` turns into
                # `Sig.eparams` -- so the arm is reached exactly once per
                # name, and the id `fresh_effvar` takes is the name's
                # position in that list.
                let (cx2, v) = fresh_effvar(cx1, a)
                cx1 = Cx { ..cx2, current_eff_vars: map.insert(cx2.current_eff_vars, a, v) }
                effs = effs ++ [v]
              }
            }
          }
      }
    }
  }
  (cx1, eff_union(effs))
}

## `!C.E` -- the row-atom twin of `resolve_assoc` below, same discipline
## (assoc-types-design.md D2 replayed on the effect axis): the subject must be
## a type parameter in scope, and exactly one of its bounds must declare the
## associated effect. Zero declarers and ambiguity are both errors here;
## nothing is deferred. The atom keeps only the subject's display name and
## tvar id, so `Eff` never contains a `Ty`.
fn resolve_eff_assoc(cx: Cx, subj: String, name: String, lo: Int, hi: Int) -> (Cx, Eff) =
  match map.get(cx.current_tparams, subj) {
    None ->
      (cerr_h(cx, "a projection's subject must be a type parameter in scope, and `" ++
          subj ++ "` is not one", lo, hi,
        "write `!T." ++ name ++ "` where `T` is a `[T: SomeTrait]` parameter whose trait " ++
          "declares `effect " ++ name ++ "`"), EPure)
    Some(v) -> {
      let vid = match v {
        TyVar(_, id) -> id
        _ -> -1
      }
      let bs = match map.get(cx.current_tparam_bounds, vid) {
        Some(x) -> x
        None -> []
      }
      var owners: List[Int] = []
      for tid in bs {
        for an in trait_of(cx.traits, tid).eff_assoc {
          if an == name && not list.contains(owners, tid) { owners = owners ++ [tid] }
        }
      }
      if len(owners) == 0 {
        (cerr_h(cx, "no trait bound on `" ++ subj ++ "` declares an associated effect `" ++
            name ++ "`", lo, hi,
          "the trait in the bound needs an `effect " ++ name ++ "` member"), EPure)
      } else if len(owners) > 1 {
        (cerr_h(cx, "`!" ++ subj ++ "." ++ name ++ "` is ambiguous: more than one bound declares `" ++
            name ++ "`", lo, hi, "rename the associated effect in one of the traits"), EPure)
      } else {
        (cx, EffAssoc(subj, vid, owners[0], name))
      }
    }
  }

fn is_upper_name(s: String) -> Bool = {
  for c in code_points(s) {
    return char_is_upper(c)
  }
  false
}

# ---- type resolution ----

## The `(lo, hi)` of a written type reference — its identity in `Cx.ty_spans`.
pub fn tref_span(ref: TypeRef) -> (Int, Int) =
  match ref {
    TNamed(_, _, _, lo, hi) -> (lo, hi)
    TQual(_, _, _, _, lo, hi) -> (lo, hi)
    TAssoc(_, _, lo, hi) -> (lo, hi)
    TTuple(_, lo, hi) -> (lo, hi)
    TFn(_, _, _, lo, hi) -> (lo, hi)
  }

## The span tree recorded for a written type reference. A ref that was never
## resolved (or resolved while recording was off) answers with its own span
## and no children, which is the same degradation an expanded alias gets: the
## enclosing written token.
pub fn ty_span_of(cx: Cx, ref: TypeRef) -> TySpan = {
  let (lo, hi) = tref_span(ref)
  match map.get(cx.ty_spans, (lo, hi)) {
    Some(sp) -> sp
    None -> TySpan { lo: lo, hi: hi, kids: [] }
  }
}

## Record that the type reference spanning `lo..hi` resolved to something whose
## written children are `kids`, in the resolved type's own child order.
##
## `kids` is empty wherever the resolved type has no written structure under
## it: a leaf, a Java class, a projection, and — the case this table exists for
## — a transparent alias, whose target is a type the author did not write here.
fn record_span_at(cx: Cx, lo: Int, hi: Int, kids: List[TypeRef]) -> Cx =
  if not cx.record_ty_spans {
    cx
  } else {
    var ks: List[TySpan] = []
    for k in kids { ks = ks ++ [ty_span_of(cx, k)] }
    Cx {
      ..cx,
      ty_spans: map.insert(cx.ty_spans, (lo, hi), TySpan { lo: lo, hi: hi, kids: ks })
    }
  }

## Resolve an alias target once, memoized; TyError (and an error) on a cycle.
pub fn resolve_alias_target(cx: Cx, al: AliasE, use_lo: Int, use_hi: Int) -> (Cx, Ty) !io = {
  match map.get(cx.alias_resolved, al.name) {
    Some(t) -> return (cx, t)
    None -> ()
  }
  let ref = match al.target {
    None -> {
      let cx1 = Cx { ..cx, alias_resolved: map.insert(cx.alias_resolved, al.name, TyError) }
      return (cx1, TyError)
    }
    Some(r) -> r
  }
  if set.has(cx.alias_resolving, al.name) {
    var cx1 = cerr_h(cx, "type alias `" ++ al.name ++ "` refers to itself", use_lo, use_hi,
      "aliases are transparent and cannot be recursive")
    cx1 = Cx { ..cx1, alias_resolved: map.insert(cx1.alias_resolved, al.name, TyError) }
    return (cx1, TyError)
  }
  var tp: Map[String, Ty] = map.empty()
  for v in al.tparams {
    match v {
      TyVar(n, _) -> { tp = map.insert(tp, n, v) }
      _ -> ()
    }
  }
  var cx1 = Cx { ..cx, alias_resolving: set.insert(cx.alias_resolving, al.name) }
  # The alias target resolves with its own type parameters and an effect-variable
  # table of its own, seeded with the variables the declaration bound
  # (`alias Mapper[T, U, !e] = fn(T) -> U !e`). They are minted at the
  # declaration, not on first sight here, so a use site that writes an effect
  # argument has an id to substitute into; the table is seeded rather than
  # inherited so two aliases never share a variable, and the result is
  # memoized, so the ids are minted once per alias. `refuse_decl_effvar` has
  # already refused every name the declaration did not bind, so nothing else
  # reaches here to be minted on sight.
  let saved_tp = cx1.current_tparams
  let saved_ev = cx1.current_eff_vars
  var seed_ev: Map[String, Eff] = map.empty()
  for v in al.eparams {
    match v {
      EffVar(n, _) -> { seed_ev = map.insert(seed_ev, n, v) }
      _ -> ()
    }
  }
  cx1 = Cx { ..cx1, current_tparams: tp, current_eff_vars: seed_ev }
  let (cx2, t) = resolve_type(cx1, ref)
  var cx3 = Cx { ..cx2, current_tparams: saved_tp, current_eff_vars: saved_ev }
  cx3 = Cx {
    ..cx3,
    alias_resolving: set.remove(cx3.alias_resolving, al.name),
    alias_resolved: map.insert(cx3.alias_resolved, al.name, t)
  }
  (cx3, t)
}

## `refuse_written_label` stood here: a written function type could not name a
## declared effect, on the grounds that `!Ask` on a function type reads as
## "whoever calls me supplies the handler" and Dawn's evidence never travelled
## that way -- it was captured by the closure at the point the closure was
## built. That is now exactly how evidence travels, so the spelling has the
## meaning the refusal said it lacked, and the refusal is gone along with its
## message (an `error-contract` string, hence worth naming here).
##
## What the ban was really protecting was the row rewrite below it: the labels
## were dropped from the resolved type (`eff_base(eff)`), so a written label
## could not have survived into a `TyFn` even where it was accepted. Both go
## together; keeping the drop without the diagnostic would silently launder a
## label out of every annotation.

## A written type is either a storage shape or the direct result of a function.
## Never is nameable only in the latter. Structural function types choose the
## context of each child themselves, so an outer return position cannot make
## `List[Never]` or `(Never, Int)` legal by accident.
type TypeUse =
  | TypeStorage
  | TypeReturn

pub fn resolve_type(cx: Cx, ref: TypeRef) -> (Cx, Ty) !io =
  resolve_type_for(cx, ref, TypeStorage)

pub fn resolve_return_type(cx: Cx, ref: TypeRef) -> (Cx, Ty) !io =
  resolve_type_for(cx, ref, TypeReturn)

fn resolve_type_for(cx: Cx, ref: TypeRef, type_use: TypeUse) -> (Cx, Ty) !io =
  match ref {
    TTuple(elems, lo, hi) -> {
      var cx1 = cx
      var out: List[Ty] = []
      var i = 0
      for e in elems {
        let (cx2, t) = resolve_type(cx1, e)
        cx1 = cx2
        out = out ++ [t]
        i = i + 1
      }
      (record_span_at(cx1, lo, hi, elems), TyTuple(out))
    }
    TFn(params, ret, effs, lo, hi) -> {
      let (cx1, eff) = resolve_eff_at(cx, effs, lo, hi)
      var cx2 = cx1
      var ps: List[Ty] = []
      for p in params {
        let (cx3, t) = resolve_type(cx2, p)
        cx2 = cx3
        ps = ps ++ [t]
      }
      let (cx4, rt) = resolve_type_for(cx2, ret, TypeReturn)
      # a function type's written children are its parameters then its return
      # type, which is exactly TyFn's child order
      (record_span_at(cx4, lo, hi, params ++ [ret]), TyFn(ps, rt, eff))
    }
    TNamed(name, targs, eargs, lo, hi) -> resolve_named(cx, name, targs, eargs, lo, hi, type_use)
    TQual(q, name, targs, eargs, lo, hi) -> resolve_qual(cx, q, name, targs, eargs, lo, hi)
    TAssoc(subj, name, lo, hi) -> {
      # `T.Item` has no written sub-reference: the subject is a bare name
      let (cx1, t) = resolve_assoc(cx, subj, name, lo, hi)
      (record_span_at(cx1, lo, hi, no_trefs()), t)
    }
  }

## `[]` at `List[TypeRef]`, for the record sites that have no written children.
fn no_trefs() -> List[TypeRef] = []

## `T.Item` -- the subject must be a type parameter in scope, and exactly one
## of its bounds must declare `name` (assoc-types-design.md D2). Zero declarers
## and ambiguity are both errors here; nothing is deferred.
fn resolve_assoc(cx: Cx, subj: String, name: String, lo: Int, hi: Int) -> (Cx, Ty) =
  match map.get(cx.current_tparams, subj) {
    None ->
      (cerr_h(cx, "a projection's subject must be a type parameter in scope, and `" ++
          subj ++ "` is not one", lo, hi,
        "write `T." ++ name ++ "` where `T` is a `[T: SomeTrait]` parameter whose trait " ++
          "declares `type " ++ name ++ "`"), TyError)
    Some(v) -> {
      let vid = match v {
        TyVar(_, id) -> id
        _ -> -1
      }
      let bs = match map.get(cx.current_tparam_bounds, vid) {
        Some(x) -> x
        None -> []
      }
      var owners: List[Int] = []
      for tid in bs {
        for an in trait_of(cx.traits, tid).assoc {
          if an == name && not list.contains(owners, tid) { owners = owners ++ [tid] }
        }
      }
      if len(owners) == 0 {
        (cerr_h(cx, "no trait bound on `" ++ subj ++ "` declares an associated type `" ++
            name ++ "`", lo, hi,
          "the trait in the bound needs a `type " ++ name ++ "` member"), TyError)
      } else if len(owners) > 1 {
        (cerr_h(cx, "`" ++ subj ++ "." ++ name ++ "` is ambiguous: more than one bound declares `" ++
            name ++ "`", lo, hi, "rename the associated type in one of the traits"), TyError)
      } else {
        (cx, TyAssoc(v, owners[0], name))
      }
    }
  }

## `m.T` — a type qualified by a whole-module alias (LANG-06). Resolution
## reads the exporter's surface: a pub alias means what the declaring module
## resolved it to, a pub ADT is its (grafted) id. The alias namespace is
## separate from values (spec §10.3), so a lowercase name in type position
## can only be one of these.
fn resolve_qual(
  cx: Cx,
  q: String,
  name: String,
  targs: List[TypeRef],
  eargs: List[EffArg],
  lo: Int,
  hi: Int
) -> (Cx, Ty) !io = {
  let exp = match map.get(cx.module_exports, q) {
    None ->
      return (cerr_h(cx, "unknown module alias `" ++ q ++ "` in a type position", lo, hi,
        "a qualified type needs a whole-module import in scope: `use <path> as " ++ q ++ "`"),
        TyError)
    Some(e) -> e
  }
  match map.get(exp.aliases, name) {
    Some(al) -> {
      let enames = alias_enames(al)
      let (cxe, bad_earg) = check_alias_eargs(cx, al, enames, eargs, lo, hi)
      if bad_earg { return (cxe, TyError) }
      if len(targs) != len(al.tparams) {
        return (ty_arity_err(cxe, al.name, len(al.tparams), len(targs), enames, lo, hi), TyError)
      }
      # imported aliases carry their declaring module's resolution; nothing
      # here re-resolves the target against this module's scope
      let target = match map.get(exp.alias_resolved, name) {
        Some(t) -> t
        None -> TyError
      }
      if target == TyError { return (cxe, TyError) }
      let (cxs, em0) = earg_subst(cxe, al.eparams, eargs)
      if len(al.tparams) == 0 {
        let m0: Map[Int, Ty] = map.empty()
        return (record_span_at(cxs, lo, hi, no_trefs()),
          wrap_opaque(al, [], subst(target, m0, em0)))
      }
      var cx2 = cxs
      var m2: Map[Int, Ty] = map.empty()
      var args: List[Ty] = []
      var i = 0
      for v in al.tparams {
        match v {
          TyVar(_, id) -> {
            let (cx3, at) = resolve_type(cx2, targs[i])
            cx2 = cx3
            m2 = map.insert(m2, id, at)
            args = args ++ [at]
          }
          _ -> ()
        }
        i = i + 1
      }
      let kids = if al.is_opaque { targs } else { no_trefs() }
      return (record_span_at(cx2, lo, hi, kids), wrap_opaque(al, args, subst(target, m2, em0)))
    }
    None -> ()
  }
  match map.get(exp.types_by_name, name) {
    Some(aid) -> {
      let info = adt_of(cx.adts, aid)
      let (cxe, bad_earg) = refuse_nominal_earg(cx, info.name,
        if info.is_record { "a record type" } else { "a variant type" },
        len(info.eparams) > 0, eargs, lo, hi)
      if bad_earg { return (cxe, TyError) }
      if len(targs) != len(info.tparams) {
        return (ty_arity_err(cxe, info.name, len(info.tparams), len(targs), info.eparams,
          lo, hi), TyError)
      }
      var cx1 = cxe
      var args: List[Ty] = []
      for a in targs {
        let (cx2, t) = resolve_type(cx1, a)
        cx1 = cx2
        args = args ++ [t]
      }
      (record_span_at(cx1, lo, hi, targs), TyAdt(aid, args))
    }
    None -> {
      let pool = map.keys(exp.types_by_name) ++ map.keys(exp.aliases)
      let hint = match suggest.hint(name, pool) {
        Some(h) -> h
        None ->
          if len(pool) == 0 {
            "module `" ++ exp.mod_path ++ "` exports no types"
          } else {
            "exported types: " ++ join(sort(pool), ", ")
          }
      }
      (cerr_h(cx, "module `" ++ exp.mod_path ++ "` has no exported type `" ++ name ++ "`",
        lo, hi, hint), TyError)
    }
  }
}

## ---- effect arguments at a type application (spec §6.3) ----

## The effect-argument half of a type application's arity. A declaration that
## binds none takes none. One that binds some takes either all of them, or --
## decision 7 of docs/effect-params-design.md -- none at all: the elided
## spelling, whose slot stays the declaration's own variable and is solved by
## whatever the consumer's row has to cover.
##
## Arity is the whole of what is asked here. **Which** rows may be written is
## not a question the argument position gets to answer differently from the
## inline one: a transparent alias is its expansion, so `Thunk[!Ask]` is
## `fn() -> Int !Ask` written a second way, and a row that is legal spelled out
## in the function type cannot be illegal spelled through the alias. What
## refuses a row is the same thing that refuses it inline -- `resolve_eff_at`
## for a name that is not an effect, and the consumer's own signature for
## evidence it does not hold.
##
## True in the result means the application was refused.
fn check_eargs(
  cx: Cx,
  owner: String,
  enames: List[String],
  eargs: List[EffArg],
  lo: Int,
  hi: Int
) -> (Cx, Bool) = {
  if len(eargs) == 0 { return (cx, false) }
  if len(enames) == 0 {
    return (cerr_h(cx, "`" ++ owner ++ "` binds no effect parameters", lo, hi,
      "an effect argument answers a `[!e]` in the declaration's parameter list, " ++
        "and this one has none"), true)
  }
  if len(eargs) != len(enames) {
    return (cerr(cx, "`" ++ owner ++ "` binds " ++ to_string(len(enames)) ++
        " effect parameter(s), got " ++ to_string(len(eargs)), lo, hi), true)
  }
  (cx, false)
}

## `check_eargs` for a name the alias table answers, which is two declarations:
## a transparent `alias`, which expands and takes the argument, and an `opaque
## type`, which is nominal and does not.
fn check_alias_eargs(
  cx: Cx,
  al: AliasE,
  enames: List[String],
  eargs: List[EffArg],
  lo: Int,
  hi: Int
) -> (Cx, Bool) =
  if al.is_opaque {
    refuse_nominal_earg(cx, al.name, "an opaque type", len(enames) > 0, eargs, lo, hi)
  } else {
    check_eargs(cx, al.name, enames, eargs, lo, hi)
  }

## "`X` takes N type parameter(s), got M", with the sentence that says the
## other list exists when the declaration binds effect parameters. Without it
## `Cell[Int]` on a `type Cell[!e]` reads as "this type is not generic", which
## is the wrong repair: the parameter is there, it is on the other axis.
fn ty_arity_err(
  cx: Cx,
  owner: String,
  declared: Int,
  got: Int,
  enames: List[String],
  lo: Int,
  hi: Int
) -> Cx = {
  let msg = "`" ++ owner ++ "` takes " ++ to_string(declared) ++
    " type parameter(s), got " ++ to_string(got)
  if len(enames) == 0 {
    cerr(cx, msg, lo, hi)
  } else {
    cerr_h(cx, msg, lo, hi,
      "`" ++ owner ++ "` also binds the effect parameter(s) `!" ++
        join(enames, "`, `!") ++ "`, written with the `!`: `" ++ owner ++ "[!io]`")
  }
}

## The substitution an application's effect arguments make. Empty when the
## application elided them, which is what keeps the elided spelling resolving
## to exactly the type it resolved to before the position existed.
##
## Each argument is a row, resolved by the same function that resolves the row
## after a `->`: an argument is what the author would have written inline had
## the alias not been there, so it is read in the use site's own scope, with
## the use site's effect table. `!e` therefore names the *consumer's* variable
## -- minting it if this is where it first appears, exactly as an inline `!e`
## would -- and the alias's own variable is the one that goes away, replaced by
## the row. Which is the whole of what a transparent alias means.
fn earg_subst(cx: Cx, eparams: List[Eff], eargs: List[EffArg]) -> (Cx, Map[Int, Eff]) = {
  var cx1 = cx
  var em: Map[Int, Eff] = map.empty()
  if len(eargs) != len(eparams) { return (cx1, em) }
  var i = 0
  for v in eparams {
    let ea = eargs[i]
    let (cx2, row) = resolve_eff_at(cx1, ea.atoms, ea.lo, ea.hi)
    cx1 = cx2
    match v {
      EffVar(_, id) -> { em = map.insert(em, id, row) }
      _ -> ()
    }
    i = i + 1
  }
  (cx1, em)
}

## A **nominal** type takes no effect argument: a record, a variant, or an
## opaque type.
##
## The reason is identity, not arity. A nominal type is named by its name and
## its **type** arguments -- `TyAdt(id, args)`, `TyOpaque(id, .., args, ..)` --
## and neither has a slot for an effect argument. Accepting one would leave
## `Cell[!io]` and `Cell` indistinguishable, or, on an opaque type whose target
## does carry the substitution, distinguishable but printed the same: two types
## that a diagnostic renders as one name, which is how "expected Hidden, got
## Hidden" gets written. A transparent alias has no identity to remember an
## argument in -- it expands, and the substitution lands in the expansion --
## which is why the two spellings part company here and not at the parser.
##
## True in the result means the application was refused.
fn refuse_nominal_earg(
  cx: Cx,
  name: String,
  kind: String,
  binds_any: Bool,
  eargs: List[EffArg],
  lo: Int,
  hi: Int
) -> (Cx, Bool) = {
  if len(eargs) == 0 { return (cx, false) }
  if not binds_any {
    return (cerr_h(cx, "`" ++ name ++ "` binds no effect parameters", lo, hi,
      "an effect argument answers a `[!e]` in the declaration's parameter list, " ++
        "and this one has none"), true)
  }
  (cerr_h(cx, "`" ++ name ++ "` is " ++ kind ++ " and takes no effect argument", lo, hi,
    "a named type is its name and its type arguments, so there is nowhere for the row " ++
      "to be remembered. Write `" ++ name ++ "` and let the consumer's row cover it, " ++
      "or declare a transparent `alias`, which expands"), true)
}

## The names an alias's effect parameters were written with, for a diagnostic.
fn alias_enames(al: AliasE) -> List[String] = {
  var out: List[String] = []
  for v in al.eparams {
    match v {
      EffVar(n, _) -> { out = out ++ [n] }
      _ -> ()
    }
  }
  out
}

fn resolve_named(
  cx: Cx,
  name: String,
  targs: List[TypeRef],
  eargs: List[EffArg],
  lo: Int,
  hi: Int,
  type_use: TypeUse
) -> (Cx, Ty) !io = {
  # Return-only names are hard-reserved, so they win even if a rejected
  # declaration left a same-spelled type parameter in the recovery scope.
  match map.get(cx.btypes, name) {
    Some(info) -> if builtin_type_hard_reserved(info) {
      if len(targs) > 0 || len(eargs) > 0 {
        return (cerr(cx, "`" ++ name ++ "` is not generic", lo, hi), TyError)
      }
      if type_use == TypeReturn && builtin_type_visible_at_return(info, cx.is_std_module) {
        return (record_span_at(cx, lo, hi, no_trefs()), builtin_type_apply(info, []))
      }
      return (cerr_h(cx, "`" ++ name ++ "` can only be written as a function return type",
        lo, hi, "write `fn(...) -> " ++ name ++
          "`, or use a value-bearing type in this storage position"), TyError)
    }
    None -> ()
  }
  # type parameters shadow everything
  match map.get(cx.current_tparams, name) {
    Some(v) -> {
      if len(targs) > 0 || len(eargs) > 0 {
        return (cerr(cx, "type parameter `" ++ name ++ "` cannot take type arguments", lo, hi),
          TyError)
      }
      return (record_span_at(cx, lo, hi, no_trefs()), v)
    }
    None -> ()
  }
  match map.get(cx.aliases, name) {
    Some(al) -> {
      let enames = alias_enames(al)
      # the effect axis is asked first: an argument on an axis the declaration
      # does not have is its own mistake, and reporting it as "got 0 type
      # parameters" would name the wrong list
      let (cxe, bad_earg) = check_alias_eargs(cx, al, enames, eargs, lo, hi)
      if bad_earg { return (cxe, TyError) }
      if len(targs) != len(al.tparams) {
        return (ty_arity_err(cxe, al.name, len(al.tparams), len(targs), enames, lo, hi), TyError)
      }
      let (cx1, target) = resolve_alias_target(cxe, al, lo, hi)
      if target == TyError { return (cx1, TyError) }
      # The effect arguments, applied to the variables the declaration bound.
      # A transparent alias expands into its target here, so the substitution
      # lands in the type the use site actually gets: `Thunk[!io]` is
      # `fn() -> Int !io` where `Thunk` is `fn() -> Int !e`. An opaque type
      # never reaches this with arguments -- `check_alias_eargs` refused them
      # -- so the map is empty and `wrap_opaque` sees the target it always saw.
      let (cxs, em) = earg_subst(cx1, al.eparams, eargs)
      if len(al.tparams) == 0 {
        let m0: Map[Int, Ty] = map.empty()
        return (record_span_at(cxs, lo, hi, no_trefs()),
          wrap_opaque(al, [], subst(target, m0, em)))
      }
      var cx2 = cxs
      var m: Map[Int, Ty] = map.empty()
      var args: List[Ty] = []
      var i = 0
      for v in al.tparams {
        match v {
          TyVar(_, id) -> {
            let (cx3, at) = resolve_type(cx2, targs[i])
            cx2 = cx3
            m = map.insert(m, id, at)
            args = args ++ [at]
          }
          _ -> ()
        }
        i = i + 1
      }
      # an opaque type keeps the arguments as its children; a transparent one
      # expands into a target the author did not write here, so it has none
      let kids = if al.is_opaque { targs } else { no_trefs() }
      return (record_span_at(cx2, lo, hi, kids), wrap_opaque(al, args, subst(target, m, em)))
    }
    None -> ()
  }
  match map.get(cx.btypes, name) {
    Some(info) -> if builtin_type_visible(info, cx.is_std_module) {
      let (cxe, bad_earg) = check_eargs(cx, name, no_eparam_names(), eargs, lo, hi)
      if bad_earg { return (cxe, TyError) }
      let arity = len(info.params)
      if len(targs) != arity {
        if arity == 0 {
          return (cerr(cx, "`" ++ name ++ "` is not generic", lo, hi), TyError)
        }
        let count = if arity == 1 { "one" } else { "two" }
        let plural = if arity == 1 { "" } else { "s" }
        return (cerr(cx, name ++ " takes exactly " ++ count ++ " type argument" ++ plural ++
            ": " ++ builtin_type_render(info), lo, hi), TyError)
      }
      var cx1 = cx
      var args: List[Ty] = []
      for arg in targs {
        let (cx2, ty) = resolve_type(cx1, arg)
        cx1 = cx2
        args = args ++ [ty]
      }
      return (record_span_at(cx1, lo, hi, targs), builtin_type_apply(info, args))
    }
    None -> ()
  }
  match map.get(cx.java_classes, name) {
    Some(fqcn) -> {
      if len(targs) > 0 || len(eargs) > 0 {
        return (cerr(cx, "Java types take no type arguments (generics are erased)", lo, hi),
          TyError)
      }
      # Reflecting on a class is honestly !io, and an `unsafe_pure` here used
      # to say otherwise -- vouching not for one static call but for a whole
      # recursive subsystem. Resolving a type reads the host's class path, so
      # the pass chain above says !io too; check_module already did.
      let j = cx.jsig.class_info(fqcn)
      return (record_span_at(cx, lo, hi, no_trefs()), TyJava(fqcn, j.display))
    }
    None -> ()
  }
  match map.get(cx.adts_by_name, name) {
    None -> {
      let pool = map.keys(cx.adts_by_name) ++ map.keys(cx.aliases) ++
        map.keys(cx.java_classes) ++ public_builtin_type_names()
      let hint = match suggest.hint(name, pool) {
        Some(h) -> h
        None -> "builtin types: " ++ join(public_builtin_type_names(), ", ") ++
          " — or declare `type " ++ name ++ " = ...`"
      }
      (cerr_h(cx, "unknown type: " ++ name, lo, hi, hint), TyError)
    }
    Some(aid) -> {
      let info = adt_of(cx.adts, aid)
      let (cxe, bad_earg) = refuse_nominal_earg(cx, info.name,
        if info.is_record { "a record type" } else { "a variant type" },
        len(info.eparams) > 0, eargs, lo, hi)
      if bad_earg { return (cxe, TyError) }
      if len(targs) != len(info.tparams) {
        return (ty_arity_err(cxe, info.name, len(info.tparams), len(targs), info.eparams,
          lo, hi), TyError)
      }
      var cx1 = cxe
      var args: List[Ty] = []
      for a in targs {
        let (cx2, t) = resolve_type(cx1, a)
        cx1 = cx2
        args = args ++ [t]
      }
      (record_span_at(cx1, lo, hi, targs), TyAdt(aid, args))
    }
  }
}

# ---- opacity and const-serializability ----

## An `alias` resolves to its target; an `opaque type` resolves to itself,
## carrying the target for the backends, `owner` for the check below, and the
## arguments it was applied to — which the target cannot always give back,
## since a target need not mention every parameter.
pub fn wrap_opaque(al: AliasE, args: List[Ty], target: Ty) -> Ty =
  if al.is_opaque { TyOpaque(al.id, al.name, al.owner, args, target) } else { target }

## The std types whose representation means different things on the two
## backends, and so cannot be written down in Core.
##
## A constant is folded once, at compile time, and its value is baked into Core
## -- which both backends read. That is fine for every value whose Int is the
## language's own: a `Char` is a code point on both. It is not fine for a
## `Cursor`, which is an offset into the string's *representation*: a UTF-16
## code-unit offset on the JVM, a UTF-8 byte offset on native, and a code-point
## index in the comptime interpreter, which has no representation to offset
## into. Three currencies, one Core, so a folded `Cursor` is wrong on at least
## two of them -- `const C: Cursor = cursor.next("(astral)", cursor.start(..))`
## used to compile to a lone surrogate on the JVM and to a number past
## U+10FFFF on native. Neither is a character.
##
## A list rather than the general rule "opaque types are not serializable",
## because that rule is false: `opaque type Meters = Int` is a constant like
## any other, and `scripts/opaque-twin/consts.dawn` says so on purpose. It is
## also not derivable -- nothing in a declaration marks its target as the
## backend's -- so the answer is written here, next to the reason.
##
## One entry. It comes off when SEM-04 gives cursors a single currency, at
## which point a folded one is portable and this function has nothing to say
## (docs/codebase-audit-v2/02-types-effects-and-semantics.md).
fn backend_dependent_repr(owner: String, name: String) -> Bool =
  owner == "std/cursor" && name == "Cursor"

## Why `is_const_serializable` said no, in the words the caller prints.
##
## Two refusals wear the same message otherwise, and they are opposite advice:
## `Map` can never be a constant, while `Cursor` is refused for a reason that
## has an expiry date and a workaround (hold the string, walk to the position
## at the point of use). The refusal the caller can act on is the one worth
## spelling out.
pub fn const_refusal_hint(t: Ty) -> String =
  match t {
    TyOpaque(_, nm, own, _, _) ->
      if backend_dependent_repr(own, nm) {
        "a cursor is a position in the backend's own representation of a " ++
          "string, and the two backends do not agree on it, so there is no " ++
          "one value to fold; hold the string and walk to the position where " ++
          "it is used (spec §7.2)"
      } else {
        const_hint_default()
      }
    _ -> const_hint_default()
  }

fn const_hint_default() -> String =
  "constants hold Int/Float/Bool/String/Unit and List/tuple/record/ADT values " ++
  "built from them (spec §7.2)"

## Can the compiler rebuild this value at class-init time? Int/Float/Bool/
## String/Unit and List/tuple/record/ADT built from them, plus an opaque type
## wherever its target qualifies (spec §7.2).
##
## Not a caller of `types.ty_map_children`/`ty_any_child`, and deliberately so:
## every other walk over a type asks the same question of the children and
## answers `true` where there are none, which is what makes the kernel's leaf
## arms right for all of them. This one is a whitelist. `Bytes`, `Map`, `Set`
## and `Array` are refused because no class-init literal can rebuild them, not
## because of anything in them -- a structural walk would clear `Map[Int, Int]`
## on the grounds that both children are fine. So the arms below are the answer
## rather than a recursion rule, and the `_ -> false` at the bottom is the
## safe default a wildcard is allowed to be: a new variant is not serializable
## until someone says how.
pub fn is_const_serializable(cx: Cx, t: Ty, visited: Set[Int]) -> Bool =
  match t {
    TyInt | TyFloat | TyBool | TyString -> true
    # One value, so the constant is the singleton. Refusing it was a
    # representation objection, and #51 removed the representation.
    TyUnit -> true
    # Serializability is a question about the representation, so an opaque
    # type is exactly as serializable as its target -- unless the target's
    # *meaning* is the backend's rather than the language's.
    TyOpaque(_, nm, own, _, tgt) ->
      if backend_dependent_repr(own, nm) {
        false
      } else {
        is_const_serializable(cx, tgt, visited)
      }
    TyList(e) -> is_const_serializable(cx, e, visited)
    TyTuple(elems) -> {
      for e in elems {
        if not is_const_serializable(cx, e, visited) { return false }
      }
      true
    }
    TyAdt(aid, targs) -> {
      # recursive types terminate here
      if set.has(visited, aid) { return true }
      let v2 = set.insert(visited, aid)
      let a = adt_of(cx.adts, aid)
      var m: Map[Int, Ty] = map.empty()
      var i = 0
      for tp in a.tparams {
        match tp {
          TyVar(_, id) ->
            match get(targs, i) {
              Some(arg) -> { m = map.insert(m, id, arg) }
              None -> ()
            }
          _ -> ()
        }
        i = i + 1
      }
      for a2 in targs {
        if not is_const_serializable(cx, a2, v2) { return false }
      }
      let em: Map[Int, Eff] = map.empty()
      for c in a.ctors {
        for f in c.fields {
          if not is_const_serializable(cx, subst(f.ty, m, em), v2) { return false }
        }
      }
      true
    }
    _ -> false
  }

# ---- typed absences ----

pub fn no_sig() -> Option[Sig] = None

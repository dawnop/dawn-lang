# The compile pipeline both drivers share, from an analyzed program to one C
# translation unit. `main` (the JVM driver) reaches it for `__emitc`, and
# `nmain` (the native driver) is little more than a CLI around it -- one
# definition of "how a program becomes C", per the one-definition doctrine.
#
# `program_tables` and `merged_consts` live here rather than in a driver
# because they are the same merge for every backend: the JVM codegen path
# calls them too.

use std/io
use std/map
use core.{CValue, CFun, CModule}
use types.{Adts, Traits, Impls, Sig, prelude_adts}
use cx.{Cx}
use interp.{CtOut}
use stdlib.{StdCtx}
use analyze.{CheckedMod, Program}
use lower
use rc
use reach
use reach.{TableUse}
use emitc
use emitc.{EmitMod}
use ctestrun
use rtsrc

## The program-wide tables codegen reads: every module's ADTs, traits, impls
## and function signatures, std's first, later declarations winning.
pub fn program_tables(
  std: StdCtx,
  mods: List[CheckedMod]
) -> (Adts, Traits, Impls, Map[(String, String), Sig]) = {
  var adts = prelude_adts()
  var traits: Traits = map.empty()
  var impl_table: Impls = map.empty()
  var prog_fns: Map[(String, String), Sig] = map.empty()
  for pr in map.entries(std.adts) {
    let (k, v) = pr
    adts = map.insert(adts, k, v)
  }
  for sm in std.mods {
    let (cls, cx, _tm, _ct) = sm
    for pr in map.entries(cx.traits) {
      let (k, v) = pr
      traits = map.insert(traits, k, v)
    }
    for pr in map.entries(cx.impl_table) {
      let (k, v) = pr
      impl_table = map.insert(impl_table, k, v)
    }
    for pr in map.entries(cx.fns) {
      let (k, v) = pr
      prog_fns = map.insert(prog_fns, (cls, k), v)
    }
  }
  for cm in mods {
    for pr in map.entries(cm.cx.adts) {
      let (k, v) = pr
      adts = map.insert(adts, k, v)
    }
    for pr in map.entries(cm.cx.traits) {
      let (k, v) = pr
      traits = map.insert(traits, k, v)
    }
    for pr in map.entries(cm.cx.impl_table) {
      let (k, v) = pr
      impl_table = map.insert(impl_table, k, v)
    }
    for pr in map.entries(cm.cx.fns) {
      let (k, v) = pr
      prog_fns = map.insert(prog_fns, (cm.class_name, k), v)
    }
  }
  (adts, traits, impl_table, prog_fns)
}

## This module's const-name → value view: its own comptime results, plus
## imported consts resolved in their declaring module's results.
pub fn merged_consts(
  cx: Cx,
  ct: CtOut,
  by_mod: Map[String, Map[String, CValue]]
) -> Map[String, CValue] = {
  var out = ct.consts
  for name in map.keys(cx.consts) {
    if not map.has(out, name) {
      match map.get(cx.imported_names, name) {
        Some(from) ->
          match map.get(by_mod, from) {
            Some(vals) ->
              match map.get(vals, name) {
                Some(v) -> { out = map.insert(out, name, v) }
                None -> ()
              }
            None -> ()
          }
        None -> ()
      }
    }
  }
  # qualified constants (`m.MAX`, LANG-06 step 3) are filed under
  # `<declaring module>.<NAME>` -- the key CConstRef asks for when its owner is
  # not empty. A separate key rather than merging by simple name, because the
  # referring module may declare a `MAX` of its own and both must survive.
  for al in map.keys(cx.module_exports) {
    match map.get(cx.module_exports, al) {
      None -> ()
      Some(exp) ->
        match map.get(by_mod, exp.mod_path) {
          None -> ()
          Some(vals) -> {
            for nm in map.keys(exp.consts) {
              match map.get(vals, nm) {
                Some(v) -> { out = map.insert(out, exp.mod_path ++ "." ++ nm, v) }
                None -> ()
              }
            }
          }
        }
    }
  }
  out
}

## Test bodies renamed to the symbol the generated runner will call, and
## demoted to ordinary functions.
##
## A test's Core name is its description string, so it cannot be mangled the
## way a function is -- two descriptions differing only in punctuation
## sanitize to one symbol. Renaming here rather than special-casing `is_test`
## in the emitter also means the emitter needs no case at all: it skips
## `is_test`, and after this pass there is nothing left for it to skip.
##
## The index counts tests within *this* module, which is what makes it the
## same number the JVM's `dawn$test$i` carries.
fn named_tests(m: CModule) -> CModule = {
  var fns: List[CFun] = []
  var i = 0
  for f in m.fns {
    if f.is_test {
      fns = fns ++ [CFun { ..f, name: emitc.test_name(i), is_test: false }]
      i = i + 1
    } else {
      fns = fns ++ [f]
    }
  }
  CModule { ..m, fns: fns }
}

## Every module of the program, std first, lowered and reference-counted.
## `with_tests` is `dawn test`'s: the test bodies ride along, and so do the
## dictionaries only a test asks for (`lower.emitted_core`). std's tests ride
## only under `std_tests` (`dawn test --stdlib`), which is the JVM path's
## answer too -- `collect_program` takes the same pair of flags.
fn build_units(
  std: StdCtx,
  prog: Program,
  with_tests: Bool,
  std_tests: Bool
) -> (List[EmitMod], String, Adts) !io = {
  let (adts, traits, impl_table, prog_fns) = program_tables(std, prog.modules)
  # const values by declaring module, the same view the JVM path builds: a
  # const is named by its simple name and imported by it
  var const_vals: Map[String, Map[String, CValue]] = map.empty()
  for sm in std.mods {
    let (cls, _cx, _tm, ct) = sm
    const_vals = map.insert(const_vals, cls, ct.consts)
  }
  for cm in prog.modules { const_vals = map.insert(const_vals, cm.mod_path, cm.ct.consts) }

  var units: List[EmitMod] = []
  var entry = ""
  for sm in std.mods {
    let (cls, cx, tm, ct) = sm
    let core =
      if std_tests {
        named_tests(lower.emitted_core(lower.lower_module_full(cls, tm, traits,
          impl_table, adts, prog_fns, true)))
      } else {
        lower.lower_module(cls, tm, traits, impl_table, adts, prog_fns)
      }
    units = units ++ [
      EmitMod {
        m: rc.rc_module(core),
        consts: merged_consts(cx, ct, const_vals),
        blocks: ct.blocks
      }
    ]
  }
  for cm in prog.modules {
    let core =
      if with_tests {
        named_tests(lower.emitted_core(lower.lower_module_full(cm.class_name, cm.tm, traits,
          impl_table, adts, prog_fns, true)))
      } else {
        lower.lower_module(cm.class_name, cm.tm, traits, impl_table, adts, prog_fns)
      }
    units = units ++ [
      EmitMod {
        m: rc.rc_module(core),
        consts: merged_consts(cm.cx, cm.ct, const_vals),
        blocks: cm.ct.blocks
      }
    ]
    if entry == "" {
      for tf in cm.tm.fns {
        if tf.name == "main" { entry = cm.class_name }
      }
    }
  }
  # `adts` rides back out: the emitter needs it to rebuild a structured
  # comptime constant, and recomputing `program_tables` at the call site would
  # be a second answer to a question already answered here
  (units, entry, adts)
}

## Which Unicode tables ride: the same question, and the same answer, as the
## JVM path. The units are already lowered (rc included; the walk ignores
## CDup/CSDrop), so reach reads them as they are.
##
## `dawn test --stdlib` has no user module to root the walk at, so it carries
## everything -- again the JVM path's answer, whose targetless `collect_program`
## reaches for `all_tables` for the same reason.
fn tables(units: List[EmitMod], prog: Program, std_tests: Bool) -> TableUse = {
  if std_tests { return reach.all_tables() }
  var reach_mods: List[CModule] = []
  for u2 in units { reach_mods = reach_mods ++ [u2.m] }
  var reach_roots: List[String] = []
  for cm in prog.modules { reach_roots = reach_roots ++ [cm.class_name] }
  reach.table_use(reach_mods, reach_roots)
}

## An analyzed program as one C translation unit, or Err when it has no
## `main`. std goes in first: a C translation unit needs a definition for
## everything it calls, and after S3 the collections *are* std -- `[1, 2]`
## calls `std/pvec.from_array`.
pub fn c_text(std: StdCtx, prog: Program) -> Result[String, String] !io = {
  let (units, entry, adts) = build_units(std, prog, false, false)
  if entry == "" { return Err("no pub fn main() -> Unit !io, nothing to compile") }
  Ok(emitc.emit_program(units, entry, tables(units, prog, false), adts))
}

## The same translation unit with the test blocks compiled in and a generated
## runner for its `main` -- `dawn test` on this backend. A test target needs no
## `pub fn main`, so nothing here asks for an entry.
##
## `tests` is (owning module class, index within that module, label) in run
## order: the triple `testrun.gen_test_main` takes on the JVM, built the same
## way by the driver so that the two reports carry the same labels.
##
## `std_tests` is `--stdlib`: the tests being run are std's own, and `prog`
## carries no modules at all.
pub fn c_test_text(
  std: StdCtx,
  prog: Program,
  tests: List[(String, Int, String)],
  std_tests: Bool
) -> Result[String, String] !io = {
  let (units, _entry, adts) = build_units(std, prog, true, std_tests)
  Ok(emitc.emit_headless(units, tables(units, prog, std_tests), adts) ++
      ctestrun.runner(tests))
}

## The embedded C runtime file `name`, for the native driver's `build` to
## write beside the C it emits.
pub fn runtime_source(name: String) -> Option[String] = rtsrc.source(name)

test "the embedded C runtime matches runtime/c on disk" {
  # the staleness gate for the generated rtsrc.dawn, same shape as the
  # embedded-std one in stdlib.dawn
  for f in ["dawn_rt.c", "dawn_rt.h"] {
    let disk = match io.read_file("runtime/c/" ++ f) {
      Ok(t) -> t
      Err(e) -> panic("runtime/c/" ++ f ++ ": " ++ e.message)
    }
    match rtsrc.source(f) {
      Some(t) -> {
        if t != disk {
          println("stale embedded runtime: " ++ f ++ " (run python3 scripts/gen-rtsrc.py)")
        }
        assert t == disk
      }
      None -> {
        println("missing from embedded runtime: " ++ f ++ " (run python3 scripts/gen-rtsrc.py)")
        assert false
      }
    }
  }
}

# checker.dawn: a type variable inside a type argument or a tuple is the same
# hole (N11 variant). `Option[T]` and `(Int, T)` hide the variable one level
# down, where a check on the outermost constructor would not look.
use std/mem
use std/mem.{Mem}

pub fn scope_opt[T](f: fn() -> Option[T] !Mem) -> Option[T] = mem.with_mem(f)

pub fn scope_pair[T](f: fn() -> (Int, T) !Mem) -> (Int, T) = mem.with_mem(f)

# expect: `..` is not an expression
# `..` never starts an expression: every one of its roles is a position (a list
# element, a record base, a rest pattern, a for-header range). A call argument
# is not one of them, and the diagnostic's job is to name the ones that are
# rather than say "expected an expression".
fn f(xs: List[Int]) -> Int = len(..xs)

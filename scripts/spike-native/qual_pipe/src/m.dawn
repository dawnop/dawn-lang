# The callees main.dawn reaches through the alias. Each one has the property a
# function value would lose: a default, a type parameter, an effect variable,
# or no value form at all (an effect operation).
pub fn zero(x: Int, pad: Int = 0) -> Int = x + pad

pub fn sum3(a: Int, b: Int = 10, c: Int = 100) -> Int = a + b + c

pub fn id[T](x: T) -> T = x

pub fn apply_to(f: fn(Int) -> Int !e) -> Int !e = f(1)

pub fn use_it[T](k: fn(Int) -> T !e) -> T !e = k(1)

pub effect Tell {
  fn tell(x: Int) -> Int
}

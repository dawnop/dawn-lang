# Call shapes for the C side table's checker (scripts/c-map/check.py).

fn h(n: Int) -> Int = n + 1

fn adder(n: Int) -> fn(Int) -> Int = (k: Int) => k + n

fn pair(a: Int, b: Int) -> Int = a * 10 + b

fn same_line(x: Int) -> Int = pair(h(x), h(x))

fn sum_same(x: Int) -> Int = h(x) + h(x)

fn nested_same(x: Int) -> Int = h(h(x))

fn applied(x: Int) -> Int = adder(x)(x)

fn cmp_same(x: Int) -> Bool = h(x) == h(x)

fn shown(x: Int) -> String = "${h(x)} and ${h(x)}"

pub fn main() -> Unit !io = {
  println(to_string(same_line(1) + sum_same(2) + nested_same(3) + applied(4)))
  println(to_string(cmp_same(5)))
  println(shown(6))
}

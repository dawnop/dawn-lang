# Explicit nominal arguments accommodate the buffer before the runner exit.
use std/mem
pub type Box[@s] = { b: I64Buf@s }
pub type Held[@s] = Empty | Full(buf: I64Buf@s)
pub type Wrap[T] = { inner: T }
fn in_record() = mem.with_mem([@s] () => {
  let result: Box[s] = Box { b = mem.new(4) }
  result
})
fn in_variant() = mem.with_mem([@s] () => {
  let result: Held[s] = Full(buf = mem.new(4))
  result
})
fn in_generic() = mem.with_mem([@s] () => Wrap { inner = mem.new(4) })

# The JVM side of the web exchange contract: the application of contract_app on
# web_jvm/server, on a free port. The first line of stdout is the port, which
# is how the driver finds it; the process serves until it is killed.
use web_jvm/server.{ServerConfig, start, handle_port, join}
use contract_app/app.{routes, middleware, errors, MAX_BODY}

pub fn main() -> Unit !io = {
  let h = start(ServerConfig { host: "127.0.0.1", port: 0, max_body: MAX_BODY, errors: errors() }, routes(), middleware())
  println("${handle_port(h)}")
  join(h)
}

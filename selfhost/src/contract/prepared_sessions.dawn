# Prepared loader inputs must enter the same session lifecycle as arbitrary
# loaded inputs, with identical semantic products and actual body accounting.
#
# A module of the compiler package because checker state is `pub(pkg)`; it
# moved here from scripts/incremental-semantics-contract/src. Nothing in
# main.dawn or nmain.dawn imports contract/, so `dawn test selfhost` runs it
# and neither driver links it.
use std/io
use std/map
use driver/analyze.{prepare_standalone, prepared_result, analyze_program,
  ProjectPlan, ModuleIndex, load_entries_over, load_entries_over_prepared }
use compiler_plan/source.{SourcePlan, SourceFile}
use driver/incremental
use driver/stdlib.{load_std, std_load_error_text}
use driver/checkdump
use check/jsig.{jsig_refused, refused_probe}
use ir/interp.{ct_default}

test "prepared sessions preserve legacy counts products and error recovery" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(value) -> value
      Err(error) -> panic(std_load_error_text(error))
    }
    let initial = incremental.new_with_body_cache(std, ct_default(), jsig_refused(), refused_probe, 8, 20000, 20)
    var prepared_owner = initial
    var legacy_owner = initial
    var iteration = 0
    for text in ["fn leaf() = 1\nfn caller() = leaf()\n",
      "fn leaf() = 1\nfn caller() = leaf()\n",
      "fn leaf() = 2\nfn caller() = leaf()\n",
      "# λ🌅 shifted\nfn leaf() = 2\nfn caller() = leaf()\n",
      "fn leaf() = true\nfn caller() = leaf()\n",
      "fn broken( -> Int = 1\nfn after() -> Int = 2\n",
      "fn leaf() = true\nfn caller() = leaf()\n",
      "fn leaf() = missing\nfn caller() = leaf()\n",
      "fn leaf() = 3\nfn caller() = leaf()\n",
      "fn leaf() = 3\n"] {
      let input = prepare_standalone("<lsp>", text)
      let loaded = prepared_result(input)
      let next = incremental.analyze_prepared(prepared_owner, input)
      let legacy = incremental.analyze(legacy_owner, loaded)
      let cold = analyze_program(loaded, std, ct_default(), jsig_refused())
      assert next.stats == legacy.stats
      assert next.program.diags == cold.diags && next.program.decl_spans == cold.decl_spans
      assert checkdump.render(next.program) == checkdump.render(cold)
      assert next.program.modules[0].tm == cold.modules[0].tm
      assert next.program.modules[0].ct == cold.modules[0].ct
      if iteration == 0 { assert next.stats.checked_bodies == 2 && next.stats.reused_bodies == 0 }
      if iteration == 1 { assert next.stats.reused_modules == 1 && next.stats.visited_bodies == 0 }
      if iteration == 2 { assert next.stats.checked_bodies == 1 && next.stats.reused_bodies == 1 }
      if iteration == 3 { assert next.stats.checked_bodies == 0 && next.stats.reused_bodies == 2 }
      prepared_owner = next.session
      legacy_owner = legacy.session
      iteration = iteration + 1
    }
    let input = prepare_standalone("<lsp>", "fn leaf() = 3\n")
    let evicted = incremental.analyze_prepared(incremental.evict(prepared_owner), input)
    assert evicted.stats.reused_modules == 0 && evicted.stats.reused_bodies == 0
    assert evicted.stats.checked_bodies == 1
    let disabled = incremental.analyze_prepared(incremental.disable_reuse(evicted.session), input)
    let again = incremental.analyze_prepared(disabled.session, input)
    assert again.stats.retained_total_modules == 0 && again.stats.retained_body_products == 0
    assert again.stats.unobserved_modules == 1 && again.stats.reused_modules == 0
    assert checkdump.render(again.program) == checkdump.render(evicted.program)
  }))
}

test "prepared project sessions preserve module generations and mixed entry lifecycles" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(value) -> value
      Err(error) -> panic(std_load_error_text(error))
    }
    # Only these overlays supply source bytes. Both loaders consume the same
    # captured plan rather than rediscovering a filesystem or manifest world.
    let root = "/tmp/dawn-prepared-session-lifecycle-virtual/src"
    let entry = root ++ "/main.dawn"
    let provider = root ++ "/provider.dawn"
    let spare = root ++ "/spare.dawn"
    let plan = ProjectPlan {
      source: SourcePlan { target: SourceFile(entry), project: root, source_root: root,
        pkgs: map.empty(), java_coords: [], diags: [] },
      modules: ModuleIndex { project_files: [entry, provider, spare],
        by_use: map.from([("main", entry), ("provider", provider), ("spare", spare)]) }
    }
    let fixed = "pub fn fixed() -> Int = 9\n"
    let one = "pub fn value() -> Int = 1\n" ++ fixed
    let two = "pub fn value() -> Int = 2\n" ++ fixed
    let boolean = "pub fn value() -> Bool = true\n" ++ fixed
    let moved = "# λ🌅 reordered\n" ++ fixed ++ "pub fn value() -> Bool = true\n"
    let int_main = "use provider\nfn answer() -> Int = provider.value()\n"
    let bool_main = "use provider\nfn answer() -> Bool = provider.value()\n"
    let initial = incremental.new_with_body_cache(std, ct_default(), jsig_refused(), refused_probe, 12, 30000, 20)
    var prepared_owner = initial
    var legacy_owner = initial
    var legacy_first = initial
    var prepared_first = initial
    var iteration = 0
    for (provider_text, main_text, reversed, include_spare) in [
      (one, int_main, false, true),
      (one, int_main, false, true),
      (two, int_main, false, true),
      (boolean, bool_main, false, true),
      (moved, bool_main, true, true),
      (moved, bool_main, false, false),
      (moved, bool_main, false, true),
      ("pub fn broken( -> Int = 0\n" ++ fixed, bool_main, true, true),
      (moved, bool_main, false, true),
      ("pub fn value() -> Bool = missing\n" ++ fixed, bool_main, false, true),
      (moved, bool_main, true, true)
    ] {
      let entries = if not include_spare { [entry] } else if reversed { [spare, entry] } else { [entry, spare] }
      var over = map.from([(entry, main_text), (provider, provider_text)])
      if include_spare { over = map.insert(over, spare, "fn alone() -> Int = 7\n") }
      let input = load_entries_over_prepared(plan, entries, over)
      let loaded = load_entries_over(plan, entries, over)
      assert prepared_result(input) == loaded
      let next = incremental.analyze_prepared(prepared_owner, input)
      let legacy = incremental.analyze(legacy_owner, loaded)
      let mixed_a = if iteration % 2 == 0 { incremental.analyze(legacy_first, loaded) }
      else { incremental.analyze_prepared(legacy_first, input) }
      let mixed_b = if iteration % 2 == 0 { incremental.analyze_prepared(prepared_first, input) }
      else { incremental.analyze(prepared_first, loaded) }
      let cold = analyze_program(loaded, std, ct_default(), jsig_refused())
      for result in [next, legacy, mixed_a, mixed_b] {
        assert result.stats == next.stats
        assert result.program.diags == cold.diags
        assert result.program.decl_spans == cold.decl_spans
        assert checkdump.render(result.program) == checkdump.render(cold)
        assert len(result.program.modules) == len(cold.modules)
        var index = 0
        for module in result.program.modules {
          let expected = cold.modules[index]
          assert module.mod_path == expected.mod_path && module.class_name == expected.class_name
          assert module.path == expected.path && module.m == expected.m
          assert module.tm == expected.tm && module.ct == expected.ct
          assert module.cx.syms == expected.cx.syms && module.cx.fns == expected.cx.fns
          assert module.cx.module_exports == expected.cx.module_exports
          assert module.cx.identities == expected.cx.identities && module.cx.impl_table == expected.cx.impl_table
          index = index + 1
        }
      }
      if iteration == 0 { assert next.stats.checked_bodies == 4 && next.stats.reused_bodies == 0 }
      if iteration == 1 { assert next.stats.reused_modules == 3 && next.stats.visited_bodies == 0 }
      if iteration == 2 { assert next.stats.checked_bodies == 1 && next.stats.reused_bodies == 3 }
      if iteration == 3 { assert next.stats.checked_bodies == 2 && next.stats.reused_bodies == 2 }
      if iteration == 4 {
        assert next.program.modules[0].mod_path == "spare"
        assert next.stats.checked_bodies == 0 && next.stats.reused_bodies == 4
      }
      if iteration == 5 {
        assert len(next.program.modules) == 2
        assert next.stats.retained_body_modules == 2 && next.stats.retained_body_products == 3
      }
      if iteration == 6 {
        assert next.stats.reused_modules == 2 && next.stats.checked_bodies == 1
        assert next.stats.retained_body_modules == 3 && next.stats.retained_body_products == 4
      }
      if iteration == 7 || iteration == 9 { assert cold.diags != [] }
      else { assert cold.diags == [] }
      prepared_owner = next.session
      legacy_owner = legacy.session
      legacy_first = mixed_a.session
      prepared_first = mixed_b.session
      iteration = iteration + 1
    }
  }))
}

# checker.dawn resolve_witness / passes.dawn derived_field_ok: an opaque type
# inherits every relation of its target except `Show` (2026-09-24). A handle
# is not printable -- std's `Buf` is the std-owned example -- and neither is a
# field of one under `derive Show`; an opaque type that writes its own
# `impl Show` is, and the relations (`==`, `cmp`, a Map key) still pass through
# to the target with no impl written.
use std/bytes
use std/map

opaque type Handle = Int

opaque type Named = String

impl Show[Named] {
  fn show(n: Named) -> String = "<named>"
}

type Holder = { h: Handle } derive Show

fn handle(n: Int) -> Handle = n

fn named(s: String) -> Named = s

pub fn buffer_text() -> String = to_string(bytes.buf())

pub fn handle_text() -> String = "${handle(1)}"

pub fn handles_text() -> String = to_string([handle(1)])

pub fn named_text() -> String = to_string([named("x")])

pub fn relations() -> Bool = {
  let m: Map[Handle, Int] = map.insert(map.empty(), handle(1), 1)
  handle(1) == handle(1) && cmp(handle(1), handle(2)) < 0 && map.has(m, handle(1))
}

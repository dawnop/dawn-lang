# Recursive-descent JSON parser (RFC 8259). Threads the position through Result,
# never panics, and caps nesting depth so pathological input can't blow the stack.
#
# The position is a std cursor into the source String. It used to be an index
# into `code_points(input)` — a list as long as the document, built before
# parsing could start (docs/seq6-research.md). Cursors read the string in place,
# so the shape below is unchanged apart from `i + 1` becoming `cursor.next`:
# a character is not always one unit wide, so advancing is a call, not addition.
use std/char
use std/str
use std/map
use std/cursor
use std/cursor.{Cursor}
use lexer.{peek, skip_ws, is_digit, scan_string, scan_number, err_at}
use value.{Json, JNull, JBool, JNum, JInt, JStr, JArr, JObj}

## How deeply arrays and objects may nest before `parse` gives up. Deeper input
## is a plain error, not a blown stack.
pub const MAX_DEPTH: Int = 512

# true when the number literal is an integer (no fraction, no exponent)
fn is_int_literal(lit: String) -> Bool =
  not (str.contains(lit, ".") || str.contains(lit, "e") || str.contains(lit, "E"))

# Whether a Float is neither NaN nor ±Infinity. `f - f` is 0.0 exactly when f is
# finite and NaN otherwise, and NaN compares false against everything (spec §4.3
# — `<`/`==` on Float are IEEE, not the total order `Ord.cmp` uses). No builtin
# predicate exists, and this one needs no magic constants.
fn is_finite(f: Float) -> Bool = f - f == 0.0

# Turn a number literal into a Json node without losing it on the way.
#
# An integer literal becomes an Int by parsing its *digits*, not by rounding a
# double: `to_int(parse_float("9007199254740993"))` is 9007199254740992, and
# past 2^63 the same route saturated to Long.MAX_VALUE. Ids, money in minor
# units, counters and epoch timestamps all live in exactly that range, so the
# old path could rewrite them with no error anywhere.
#
# Integer literals outside `Int` are errors. Fraction/exponent literals instead
# use the host-independent `parse_float` contract: nearest IEEE-754 binary64,
# ties to even. Finite rounded results (including signed zero after underflow)
# are accepted; only overflow to NaN or Infinity is rejected. RFC 8259 §6 lets
# implementations set these range and precision limits. A caller that needs
# exact decimal arithmetic needs a decimal model in `Json`.
fn number_of(src: String, i: Cursor, lit: String) -> Result[Json, String] =
  if is_int_literal(lit) {
    match parse_int(lit) {
      Some(n) -> Ok(JInt(n))
      None -> Err(err_at(src, i, "integer out of Int range: " ++ lit))
    }
  } else {
    match parse_float(lit) {
      # 1e400 parses to Infinity, which RFC 8259 has no syntax for. Rejecting it
      # here is what lets `render` stay total and still only emit legal JSON.
      Some(f) ->
        if is_finite(f) {
          Ok(JNum(f))
        } else {
          Err(err_at(src, i, "number out of Float range: " ++ lit))
        }
      None -> Err(err_at(src, i, "invalid number: " ++ lit))
    }
  }

# `word` starting at cursor `i`? Yields the cursor past it. Walking both strings
# with cursors also gets end-of-input for free: `cursor.char` returns -1 there,
# which no character of `word` can equal.
fn match_lit(src: String, i: Cursor, word: String, w: Cursor) -> Option[Cursor] =
  if cursor.done(word, w) {
    Some(i)
  } else if cursor.char(src, i) == cursor.char(word, w) {
    match_lit(src, cursor.next(src, i), word, cursor.next(word, w))
  } else {
    None
  }

fn parse_lit(src: String, i: Cursor, word: String, val: Json) -> Result[(Json, Cursor), String] =
  match match_lit(src, i, word, cursor.start(word)) {
    Some(j) -> Ok((val, j))
    None -> Err(err_at(src, i, "invalid literal"))
  }

fn parse_array_items(src: String, i: Cursor, depth: Int, acc: List[Json]) -> Result[(Json, Cursor), String] = {
  let (v, j) = parse_value(src, i, depth + 1)?
  let acc2 = acc ++ [v]
  let k = skip_ws(src, j)
  let c = peek(src, k)
  if c == char.code(',') {
    parse_array_items(src, cursor.next(src, k), depth, acc2)
  } else if c == char.code(']') {
    Ok((JArr(acc2), cursor.next(src, k)))
  } else {
    Err(err_at(src, k, "expected ',' or ']' in array"))
  }
}

fn parse_array(src: String, i0: Cursor, depth: Int) -> Result[(Json, Cursor), String] = {
  let i1 = skip_ws(src, cursor.next(src, i0))
  if peek(src, i1) == char.code(']') {
    Ok((JArr([]), cursor.next(src, i1)))
  } else {
    parse_array_items(src, i1, depth, [])
  }
}

fn parse_object_members(src: String, i: Cursor, depth: Int, acc: Map[String, Json]) -> Result[(Json, Cursor), String] = {
  let ks = skip_ws(src, i)
  if peek(src, ks) != char.code('"') {
    Err(err_at(src, ks, "expected a string key in object"))
  } else {
    let (key, j) = scan_string(src, ks)?
    let jc = skip_ws(src, j)
    if peek(src, jc) != char.code(':') {
      Err(err_at(src, jc, "expected ':' in object"))
    } else {
      let (v, k) = parse_value(src, cursor.next(src, jc), depth + 1)?
      let acc2 = map.insert(acc, key, v)
      let kc = skip_ws(src, k)
      let c = peek(src, kc)
      if c == char.code(',') {
        parse_object_members(src, cursor.next(src, kc), depth, acc2)
      } else if c == char.code('}') {
        Ok((JObj(acc2), cursor.next(src, kc)))
      } else {
        Err(err_at(src, kc, "expected ',' or '}' in object"))
      }
    }
  }
}

fn parse_object(src: String, i0: Cursor, depth: Int) -> Result[(Json, Cursor), String] = {
  let i1 = skip_ws(src, cursor.next(src, i0))
  if peek(src, i1) == char.code('}') {
    Ok((JObj(map.empty()), cursor.next(src, i1)))
  } else {
    parse_object_members(src, i1, depth, map.empty())
  }
}

fn parse_value(src: String, i0: Cursor, depth: Int) -> Result[(Json, Cursor), String] = {
  if depth > MAX_DEPTH {
    Err(err_at(src, i0, "maximum nesting depth exceeded"))
  } else {
    let i = skip_ws(src, i0)
    let c = peek(src, i)
    if c == char.code('"') {
      let (s, j) = scan_string(src, i)?
      Ok((JStr(s), j))
    } else if c == char.code('{') {
      parse_object(src, i, depth)
    } else if c == char.code('[') {
      parse_array(src, i, depth)
    } else if c == char.code('t') {
      parse_lit(src, i, "true", JBool(true))
    } else if c == char.code('f') {
      parse_lit(src, i, "false", JBool(false))
    } else if c == char.code('n') {
      parse_lit(src, i, "null", JNull)
    } else if c == char.code('-') || is_digit(c) {
      # preserve integer-ness: a literal with no '.'/'e'/'E' round-trips as JInt,
      # so parse→render doesn't turn 42 into 42.0 (callers that re-render parsed
      # documents must not corrupt integer-typed fields)
      let (lit, j) = scan_number(src, i)?
      let v = number_of(src, i, lit)?
      Ok((v, j))
    } else {
      Err(err_at(src, i, "unexpected character"))
    }
  }
}

## Parse one complete JSON document (RFC 8259). `Err` carries a message ending
## in the code-point offset it was noticed at; anything but whitespace after the
## value is an error. Never panics. An integer literal becomes `JInt`, any other
## number `JNum`. Integers must fit `Int`; fraction/exponent literals use
## IEEE-754 binary64 ties-to-even rounding, accept finite underflow as signed
## zero, and reject overflow when the result is non-finite.
pub fn parse(input: String) -> Result[Json, String] = {
  let (v, j) = parse_value(input, cursor.start(input), 0)?
  let k = skip_ws(input, j)
  if cursor.done(input, k) {
    Ok(v)
  } else {
    Err(err_at(input, k, "trailing content after the JSON value"))
  }
}

test "integer literals parse as JInt, decimals and exponents as JNum" {
  assert parse("42") == Ok(JInt(42))
  assert parse("-7") == Ok(JInt(-7))
  assert parse("1.5") == Ok(JNum(1.5))
  assert parse("1e3") == Ok(JNum(1000.0))
}

test "integers beyond 2^53 keep every digit" {
  # the whole point of parsing the lexeme: a double round-trip answers ...992
  assert parse("9007199254740993") == Ok(JInt(9007199254740993))
  assert parse("-9007199254740993") == Ok(JInt(-9007199254740993))
  assert parse("9223372036854775807") == Ok(JInt(9223372036854775807))
  # Int.MIN spelled the long way: Dawn has no negative literals, so
  # `-9223372036854775808` is unary minus on a literal that does not fit
  assert parse("-9223372036854775808") == Ok(JInt(-9223372036854775807 - 1))
}

test "integer and non-finite overflow are refused, finite underflow is accepted" {
  # used to saturate to Long.MAX_VALUE
  assert parse("99999999999999999999") ==
    Err("integer out of Int range: 99999999999999999999 at offset 0")
  # used to become the JSON-illegal token Infinity
  assert parse("1e400") == Err("number out of Float range: 1e400 at offset 0")
  assert parse("-1e400") == Err("number out of Float range: -1e400 at offset 0")
  # underflow is representable (as 0.0), so it stays accepted
  assert parse("1e-400") == Ok(JNum(0.0))
}

test "errors carry a code-point offset" {
  assert parse("{\"a\": }") == Err("unexpected character at offset 6")
  assert parse("[1, 2") == Err("expected ',' or ']' in array at offset 5")
  assert parse("1 2") == Err("trailing content after the JSON value at offset 2")
  # the offset counts characters, not UTF-16 units or bytes: the emoji is one
  assert parse("[\"😀\", ?]") == Err("unexpected character at offset 6")
}

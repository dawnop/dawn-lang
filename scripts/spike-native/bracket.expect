-- the normal path: use, release, and the body's own answer --
  acquire r1
  use r1
  release r1
value          7
-- use panics: release runs, and the panic carries on --
  acquire r2
  release r2
message        deliberate r2
-- use faults: release runs, and the fault carries on --
  acquire r3
  use r3
  release r3
same kind      true
same message   true
-- nested: the inner resource is released first --
  acquire outer
  acquire inner
  use outer and inner
  release inner
  release outer
value          2
-- nested, and the body panics: still inside out --
  acquire outer
  acquire inner
  release inner
  release outer
message        deliberate inner
-- which barrier stops what, with a bracket in the way --
  acquire r4
  use r4
  release r4
no failure     ok
  acquire r5
  release r5
panic          through
  acquire r6
  use r6
  release r6
read_file      caught

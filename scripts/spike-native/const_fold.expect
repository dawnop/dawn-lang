-- scalars fold --
N     = 42
NEG   = -5
FLAG  = true
TEXT  = abc
LEN   = 5
-- folded rendering vs the same expression at runtime --
const   int   = 42
runtime int   = 42
const   bool  = true
runtime bool  = true
const   point = Point(1, 2)
runtime point = Point(1, 2)
const   suit  = Hearts
runtime suit  = Hearts
const   list  = [1, 2, 3]
runtime list  = [1, 2, 3]
const   opt   = Some(9)
runtime opt   = Some(9)
const   interp= p=Point(3, 4)
runtime interp= p=Point(3, 4)

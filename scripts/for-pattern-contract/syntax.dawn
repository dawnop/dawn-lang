use sample as q

type Pair = Pair(left: Int, right: Int)
type Choice = Left(value: Int) | Right(value: Int)

fn probe(
  pairs: List[(Int, Int)],
  rows: List[List[Int]],
  records: List[Pair],
  qualified: List[q.Only],
  choices: List[Choice],
) -> Unit = {
  for (left, right) in pairs { let _ = left + right }
  for [head, ..tail] in rows { let _ = head + len(tail) }
  for Pair(left, right) in records { let _ = left + right }
  for q.Only(value) in qualified { let _ = value }
  for Left(value)
    | Right(value) in choices { let _ = value }
}

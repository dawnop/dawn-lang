# The execution pipeline: compile with `dawn build`, then run the jar with
# `java`. Two phases keep the compile diagnostics clean and separate from the
# program's own output.
#
# Each child's combined stdout+stderr goes to a file rather than a pipe, and
# where that file lives is the security boundary of this module. A request's
# directory is laid out as
#
#   dawn-play-<uuid>/          runner-owned, 0711: build.txt, run.txt
#   dawn-play-<uuid>/box/      0777 under the sandbox: prog.dawn, prog.jar
#
# and the sandbox is handed `box/` only. The output files used to sit in the
# directory the sandbox could write, and the runner read them back by name
# after the child exited, so the child could swap one for a link to a file
# only the runner could read, or for a file that never reaches end of file.
# Now the child can only write *through* the descriptor the runner opened for
# it; the names are in a directory it cannot change. The read still refuses
# anything but a regular file and never follows a link, as a second line.
#
# The read is also bounded: at most OUTPUT_LIMIT + 1 bytes ever reach memory,
# whatever the child wrote. It used to read the whole file and truncate after,
# so output that outgrew the runner's heap ended the request with an
# OutOfMemoryError and no response. The disk side is the sandbox's: the unit
# runs with LimitFSIZE (sandbox/run-sandboxed.sh).
#
# No `use java` here (K3 of docs/playground-native-runner-design.md): every
# child is a `Proc.run` of a coreutils command, so the module builds natively.
# `Proc.run` is synchronous and has no timeout and no kill, so a phase's budget
# is `timeout(1)` wrapped around a `sh -c` that writes the child's output and
# its exit status to files the runner owns (`run_timed`); a phase that was cut
# off leaves no status file, which is how it tells "ran out of time" from a
# program that happened to exit 124. File modes are `chmod`, the clock is the
# `Clock` effect, ids come from the kernel's uuid.
#
# Why a file and not a pipe: a pipe needs the runner to keep draining it, and
# once the child is gone the JDK drains whatever is left into memory with no
# bound of its own, which a writer that outlives the direct child (the sandbox
# unit behind a killed `sudo`) keeps refilling. A file has no such reader.
use std/str
use std/bytes
use std/io
use std/io.{Fs, with_fs_real, with_proc_real, with_clock_real, with_env_real, Instant, now, now_wall_ns, elapsed_ns}
use play/contract.{Outcome, Compiled, CompileError, Timeout}
use play/config.{dawn_bin, native_bin, java_bin, javap_bin, timeout_secs, compile_timeout_secs, sandbox_enabled, sandbox_script, work_root, packages_root}

## The most output, in bytes, a response carries. Bytes rather than
## characters because bytes are what the read can bound before decoding.
const OUTPUT_LIMIT: Int = 65536

## The run phase's heap ceiling. The compile phase gets its own from
## run-sandboxed.sh; the program's JVM otherwise aims at a quarter of host
## RAM and meets the unit's MemoryMax as a SIGKILL instead of an
## OutOfMemoryError it can print. Passed on the command line, not through
## JAVA_TOOL_OPTIONS, whose "Picked up" banner would land in the output.
const RUN_HEAP: String = "-Xmx256m"

# Where per-request work dirs live: PLAY_WORK_ROOT if set (the sandbox needs a
# non-/tmp path, see config.work_root), else $TMPDIR, else /tmp. Trailing slash is
# dropped (macOS's TMPDIR carries one) so paths match diagnostics.
fn temp_root() -> String !io = {
  let configured = work_root()
  let d = if configured != "" {
    configured
  } else {
    match with_env_real(() => io.getenv("TMPDIR")) {
      Some(v) -> if v == "" { "/tmp" } else { v }
      None -> "/tmp"
    }
  }
  str.strip_suffix(d, "/").unwrap_or(d)
}

# How many bytes the UTF-8 sequence led by `b` occupies, 1 for anything that
# does not lead a multi-byte sequence.
fn utf8_width(b: Int) -> Int =
  if b >= 0xF8 { 1 } else if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 1 }

# `b` without a multi-byte sequence the cut at its end left incomplete, so a
# truncation never shows up as a replacement character.
fn whole_chars(b: Bytes) -> Bytes = {
  let n = bytes.len(b)
  var i = n - 1
  # step back over at most three continuation bytes to the sequence's lead
  while i >= 0 && i > n - 4 && (bytes.at(b, i) & 0xC0) == 0x80 {
    i = i - 1
  }
  if i >= 0 && i + utf8_width(bytes.at(b, i)) > n { bytes.slice(b, 0, i) } else { b }
}

## Run `argv` to completion, its output to the two files (an empty path leaves
## that stream where the process's own is). The thin wrapper every child goes
## through; an `Err` is a command that could not be started.
fn run_cmd(argv: List[String], out_path: String, err_path: String) -> Result[Int, ForeignError] !io =
  with_proc_real(() => io.run(argv, out_path, err_path))

## A point on the monotonic clock, and the milliseconds since one.
pub fn tick() -> Instant !io = with_clock_real(() => now())

pub fn ms_since(t: Instant) -> Int !io = elapsed_ns(t, tick()) / 1000000

# A fresh random id in the uuid's dashed form. The kernel hands one out at
# /proc/sys/kernel/random/uuid (every read a new one, 122 random bits, the
# source `UUID.randomUUID` drew on); a host without it (macOS, where the
# long-lived server is run for development) asks `uuidgen`.
fn uuid() -> String !io = {
  let kernel = with_fs_real(() => io.read_file("/proc/sys/kernel/random/uuid"))
  match kernel {
    Ok(t) -> str.trim(t)
    Err(_) -> {
      let out = "${temp_root()}/dawn-play-uuid-${with_clock_real(() => now_wall_ns())}.txt"
      let _ = run_cmd(["uuidgen"], out, "/dev/null")
      let got = with_fs_real(() => io.read_file(out))
      let _ = with_fs_real(() => io.delete(out))
      match got {
        Ok(t) -> str.to_lower(str.trim(t))
        Err(_) -> panic("cannot make a random id: no /proc/sys/kernel/random/uuid and no uuidgen")
      }
    }
  }
}

# The first OUTPUT_LIMIT bytes of the file at `path`, decoded, and whether
# there was more. Anything but a regular file, links included, reads as empty:
# the runner created this file itself, so anything else means something else
# put it there. A read that fails reads as empty too; the outcome still says
# whether the program finished. `scratch` is a directory the runner owns.
fn read_capped(path: String, scratch: String) -> (String, Bool) !io = read_capped_to(path, OUTPUT_LIMIT, scratch)

# The check and the cut are one `sh`: `[ -f ]` refuses a FIFO or device before
# anything opens it (an open of a FIFO with no writer would block for good),
# `[ ! -L ]` refuses a link, and `head -c` is what bounds the bytes. They land
# in a scratch file the runner names, and only that file, never the child's
# path, is read into memory. The files read this way are written by units that
# have ended, so nothing swaps a name between the test and the open.
const CAP_SH: String = "[ -f \"$1\" ] && [ ! -L \"$1\" ] && exec head -c \"$2\" -- \"$1\""

# [`read_capped`] with the limit named: the compile view reads the compilers'
# own files, which are far larger than any diagnostic (an 870 KB C text is
# ordinary), under the limit that view states for them.
fn read_capped_to(path: String, limit: Int, scratch: String) -> (String, Bool) !io = {
  let tmp = "${scratch}/cap-${uuid()}"
  let status = run_cmd(["sh", "-c", CAP_SH, "sh", path, "${limit + 1}"], tmp, "/dev/null")
  let raw = match status {
    Ok(0) -> with_fs_real(() => io.read_bytes(tmp))
    _ -> Ok(bytes.utf8(""))
  }
  let _ = with_fs_real(() => io.delete(tmp))
  match raw {
    Ok(b) ->
      if bytes.len(b) > limit {
        (bytes.decode_utf8_lossy(whole_chars(bytes.slice(b, 0, limit))), true)
      } else {
        (bytes.decode_utf8_lossy(b), false)
      }
    Err(_) -> ("", false)
  }
}

# Strip the throwaway temp directory out of diagnostics so users see a clean
# "prog.dawn:line:col" instead of /var/folders/.../dawn-play-<uuid>/prog.dawn.
# The run phase's output goes through it too. The compiler no longer bakes
# the path it was handed into a position (dawn-lang #401: an `x!` failure
# says `at prog.dawn:4`), so this is defence in depth: a runtime error that
# names a file under the staging directory, or the directory itself, still
# does not hand the server's work root to the browser. The bare directory
# reads as `.`, which is what it is relative to the files the user sees.
fn strip_dir(text: String, dir: String) -> String =
  join(str.split(join(str.split(text, "${dir}/"), ""), dir), ".")

# A child's output as the response shows it: capped, then the request's
# directories stripped from what is left (the box first, since its path
# starts with the request directory's), then the truncation marked.
fn shown(path: String, dir: String, box: String) -> (String, Bool) !io = {
  let (raw, cut) = read_capped(path, dir)
  let clean = strip_dir(strip_dir(raw, box), dir)
  if cut { (clean ++ "\n… (output truncated)", true) } else { (clean, false) }
}

# Prepend the sudo-whitelisted sandbox wrapper: `run <unit id> <box> <argv>`
# runs argv inside a throwaway systemd unit named after the id (stage 4d), and
# `stop <unit id>` ends that unit. Only PLAY_UNSAFE_LOCAL=1 leaves argv
# unchanged; config.sandbox_enabled is fail-closed. `box` is the only
# directory the unit can write.
fn sandboxed(unit: String, box: String, argv: List[String]) -> List[String] !io =
  if sandbox_enabled() {
    ["sudo", "-n", sandbox_script(), "run", unit, box] ++ argv
  } else {
    argv
  }

# How to end the unit a timed-out phase is still running, or nothing when
# there is no unit.
fn stop_argv(unit: String) -> List[String] !io =
  if sandbox_enabled() { ["sudo", "-n", sandbox_script(), "stop", unit] } else { [] }

# A fresh unit id: 32 lowercase hex digits, the only shape the wrapper takes.
fn fresh_unit() -> String !io = str.replace(uuid(), "-", "")

## How long a `stop` may take before the runner gives up on it. The unit's
## own TimeoutStopSec is 3 s; past this the unit's RuntimeMaxSec is the
## backstop.
const STOP_SECS: Int = 10

# The `sh` of [`run_timed`]: `$1` is the status file, `$2` the output file, the
# rest the command. The output and the status are written by the runner's own
# `sh`, in files the runner named in a directory the sandbox cannot change; the
# child writes only through the descriptor `sh` opened for it.
const TIMED_SH: String = "rc=\"$1\"; out=\"$2\"; shift 2; \"$@\" >\"\$out\" 2>&1; echo $? >\"\$rc\""

# Run `argv` for at most `secs`, its combined output in the file `out`:
# Some(exit status), or None when the budget ran out, the work being gone by
# then. `status_file` is a path the runner owns.
#
# `timeout` ends the process group on the deadline (TERM, then KILL after two
# more seconds), and the `sh` inside it writes the status only when the command
# came back, so a missing status is a timeout and an exit status of 124 is
# just a program's own.
#
# Under the sandbox `argv` is `sudo`, and the work is a systemd unit that
# `systemd-run --wait` started on its behalf. A signal to `sudo` does not reach
# the unit, and an unprivileged runner may not be allowed to signal a root
# `sudo` at all. Ending the group alone therefore let the unit run on to
# RuntimeMaxSec while the gate admitted the next request. `stop` ends the unit,
# after which `systemd-run`, and `sudo` with it, exits by itself; it is empty
# when there is no unit. The caller's gate permit is held until this returns,
# which is what keeps the host from running more compilers than it has permits.
fn run_timed(argv: List[String], out: String, status_file: String, secs: Int, stop: List[String]) -> Option[Int] !io = {
  let _ = with_fs_real(() => io.delete(status_file))
  let wrapped = ["timeout", "-k", "2", "${secs}", "sh", "-c", TIMED_SH, "sh", status_file, out] ++ argv
  let _ = run_cmd(wrapped, "/dev/null", "/dev/null")
  let got = with_fs_real(() => io.read_file(status_file))
  let _ = with_fs_real(() => io.delete(status_file))
  match got {
    Ok(t) -> parse_int(str.trim(t))
    Err(_) -> {
      if len(stop) > 0 {
        let _ = run_cmd(["timeout", "-k", "2", "${STOP_SECS}"] ++ stop, "/dev/null", "/dev/null")
      }
      None
    }
  }
}

# Set a directory's mode outright, umask aside; `mode` is octal digits.
fn set_mode(dir: String, mode: String) -> Unit !io = {
  let _ = run_cmd(["chmod", mode, dir], "/dev/null", "/dev/null")
  ()
}

# Under the sandbox each phase runs as a fresh DynamicUser (a different
# transient uid), so the box must be world-writable for the compiler to write
# the jar and the JVM to read it back, and the request directory must be
# traversable but nothing more. The name is an unguessable uuid and the work
# root is 0711, so neither can be listed or found.
fn open_box(dir: String, box: String) -> Unit !io =
  if sandbox_enabled() {
    set_mode(dir, "711")
    set_mode(box, "777")
  } else {
    ()
  }

# Remove a per-request work dir. The runner owns it, and the 0777 box inside;
# the sandbox units run with UMask=0000, so what the DynamicUser wrote into the
# box is deletable by the runner too. `rm -rf` does not follow links.
#
# `rm -rf` used to be fire-and-forget: a tree the runner could not empty (the
# compiler's classes/ made by a transient uid under umask 022) stayed on disk
# with no trace, one box per successful /compile. A failure is now logged, once
# per path, with rm's own words.
fn cleanup(dir: String) -> Unit !io =
  match remove_tree(dir) {
    Some(why) -> io.eprintln("dawn-play: cannot remove ${dir}: ${why}")
    None -> ()
  }

# Delete `dir` recursively. None on success, else why not (rm's output, or the
# exit status when it said nothing).
fn remove_tree(dir: String) -> Option[String] !io = {
  # rm's words go to a file beside the tree, which is not inside what it removes
  let said_in = "${dir}.rm-${uuid()}"
  let got = run_cmd(["rm", "-rf", dir], "/dev/null", said_in)
  let said = match with_fs_real(() => io.read_file(said_in)) {
    Ok(t) -> t
    Err(_) -> ""
  }
  let _ = with_fs_real(() => io.delete(said_in))
  match got {
    Ok(0) -> None
    Ok(code) -> {
      let t = str.trim(said)
      Some(if t == "" { "rm exited ${code}" } else { str.slice(t, 0, 500) })
    }
    Err(e) -> Some("rm did not run: ${e}")
  }
}

# Remove request directories an earlier runner left behind (a crash, a kill, a
# deploy mid-request, or a tree cleanup could not empty). Called once from
# main before the server listens, so no request is in flight and nothing live
# can be taken. Only under a configured work root: the TMPDIR fallback
# is shared with other programs. Returns how many it removed.
fn sweep_stale(root: String) -> Int !Fs !io = {
  match io.list_dir(root) {
    Err(_) -> 0
    Ok(names) -> {
      var n = 0
      for name in names {
        if str.starts_with(name, "dawn-play-") {
          match remove_tree("${root}/${name}") {
            None -> { n = n + 1 }
            Some(why) -> io.eprintln("dawn-play: cannot remove stale ${root}/${name}: ${why}")
          }
        }
      }
      n
    }
  }
}

# The startup sweep over the configured work root, logging the count.
pub fn sweep_work_root() -> Unit !io = {
  if work_root() != "" {
    let n = with_fs_real(() => sweep_stale(temp_root()))
    io.eprintln("dawn-play: removed ${n} stale request directories from ${temp_root()}")
  }
}

# A fresh request directory under the work root, not yet created.
fn fresh_dir() -> String !io = {
  "${temp_root()}/dawn-play-${uuid()}"
}

# Stage the source into a fresh box and run `body` with the request directory
# and the box, removing the directory on every way out: a normal return, a
# panic, and a JVM Error (bracket catches Throwable on the JVM). Without it, a
# failure between staging and cleanup left the directory, and whatever the
# child had written into it, on disk for good.
fn with_request(code: String, body: fn(String, String) -> Outcome !io) -> Outcome !Fs !io =
  with_staged(code, msg => CompileError(msg), body)

# [`with_request`] for a body of any result type: `unstaged` says what the
# request answers when the source cannot be written into the box.
fn with_staged[T](code: String, unstaged: fn(String) -> T, body: fn(String, String) -> T !io) -> T !Fs !io =
  with_files([("prog.dawn", code)], unstaged, body)

# [`with_staged`] for a program of several files, named relative to the box
# (a project is `dawn.toml` and `src/main.dawn`).
fn with_files[T](files: List[(String, String)], unstaged: fn(String) -> T, body: fn(String, String) -> T !io) -> T !Fs !io = {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  let box = "${d}/box"
  match write_all(box, files) {
    Err(e) -> unstaged("cannot stage source: ${e}")
    Ok(_) -> {
      open_box(d, box)
      body(d, box)
    }
  }
}

# Write each file into the box. write_file creates parent directories as needed.
fn write_all(box: String, files: List[(String, String)]) -> Result[Unit, String] !Fs !io = {
  for f in files {
    let (name, text) = f
    match io.write_file("${box}/${name}", text) {
      Err(e) -> return Err("${e}")
      Ok(_) -> ()
    }
  }
  Ok(())
}

# Run `dawn build` on the staged source. Ok(ms), or Err(diagnostics) with the
# request's directories stripped. Shared by execute (/run) and check.
#
# The compiler gets its own wall-clock limit, and it needs one as much as the
# run phase does: `comptime` executes user code *inside the compiler*, and a
# long enough fold can block there for as long as it likes. This used to
# be a bare waitFor(). Production's systemd RuntimeMaxSec=15 caught it, but only
# for the deployment that had the sandbox on — locally, and anywhere the sandbox
# is off, one request could hold a compiler process forever and, with a gate
# permit in hand, keep the next request out too.
#
# The budget is `compile_timeout_secs()` — separate from the run budget, since
# a cold compiler is legitimately slower than the program it produces. The
# diagnostics are capped like the run output: comptime can print too.
fn compile_phase(dir: String, box: String) -> Result[Int, String] !io =
  compile_input(dir, box, "${box}/prog.dawn")

# [`compile_phase`] for an input of the caller's choosing: the staged file, or
# the box itself when it holds a project.
fn compile_input(dir: String, box: String, input: String) -> Result[Int, String] !io =
  compile_with(dir, box, [dawn_bin(), "build", input, "-o", "${box}/prog.jar"])

# One sandboxed compiler command whose exit status and diagnostics are the
# answer: `compile_input`'s `dawn build`, or /check's `dawnc check`.
fn compile_with(dir: String, box: String, argv: List[String]) -> Result[Int, String] !io = {
  let build_out = "${dir}/build.txt"
  let unit = fresh_unit()
  let started = tick()
  match run_timed(sandboxed(unit, box, argv), build_out, "${dir}/build.rc", compile_timeout_secs(), stop_argv(unit)) {
    None -> Err("compilation timed out after ${compile_timeout_secs()}s")
    Some(0) -> Ok(ms_since(started))
    Some(_) -> {
      let (diags, _) = shown(build_out, dir, box)
      Err(str.trim(diags))
    }
  }
}

# Compile-only entry for /check (editor diagnostics): stage and compile, never
# run. Success carries no output — the client only cares whether diagnostics
# exist. Same sandbox as /run: comptime executes user code at compile time.
## Both entry points install the file system handler themselves: main hands
## them to `with_gate` as a `fn() -> T !io` body, a closed row the label
## cannot travel through (spec §6.5), and one snippet's staging directory is
## the whole unit of file work anyway.
## `native` is whether the runner may use the native `dawnc` (see
## [`native_ready`]); the answer is the same either way, only the cost differs.
pub fn check(code: String, native: Bool) -> Outcome !io =
  with_fs_real(() => with_request(code, (dir, box) => check_staged(dir, box, native)))

pub fn execute(code: String) -> Outcome !io = with_fs_real(() => with_request(code, execute_staged))

fn check_staged(dir: String, box: String, native: Bool) -> Outcome !io =
  match check_phase(dir, box, native) {
    Err(diags) -> CompileError(diags)
    Ok(ms) -> Compiled("", 0, false, ms)
  }

# The text `dawnc` answers a `use java` program with
# (selfhost/src/check/passes.dawn, pass_java_uses): the native compiler has no
# JVM to resolve Java classes against, so it refuses the declaration. It is
# the refusal's whole contract: exit status 1 and this sentence among the
# diagnostics. The `dawnc check refuses use java` case in test/contract.sh
# pins it against the real binary, so a reworded refusal turns that red
# instead of silently making every `use java` program a compile error here.
const NATIVE_REFUSAL: String = "`use java` is not available in this compiler"

# Whether `dawnc`'s diagnostics are a refusal to compile (it cannot do this
# program) and not a verdict on the program: the refusal sentence, or no
# diagnostics at all from a failed run, which is a compiler that died and has
# nothing to show the visitor either. Either way the JVM compiler decides.
fn native_declined(diags: String) -> Bool = str.trim(diags) == "" || str.contains(diags, NATIVE_REFUSAL)

# /check's compile: `dawnc check` when the runner may use it, with the JVM
# `dawn build` as the answer for a program `dawnc` declines, so what the
# editor shows does not depend on which compiler looked first. A timeout is
# not a refusal and is not retried: the budget is spent.
fn check_phase(dir: String, box: String, native: Bool) -> Result[Int, String] !io =
  if not native {
    compile_phase(dir, box)
  } else {
    match compile_with(dir, box, [native_bin(), "check", "${box}/prog.dawn"]) {
      Ok(ms) -> Ok(ms)
      Err(diags) -> if native_declined(diags) { compile_phase(dir, box) } else { Err(diags) }
    }
  }

fn execute_staged(dir: String, box: String) -> Outcome !io =
  match compile_phase(dir, box) {
    Err(diags) -> CompileError(diags)
    Ok(_) -> run_phase(dir, box)
  }

# ---- the compile view (POST /compile) ----
#
# What the sandbox produces for the view is raw material only: the C text and
# the two side tables, which `dawn __emitc --map` and `dawn __emit --map`
# write beside the source, and the listing `javap -c -p -s` prints for the
# module's class. Nothing is run. Pairing them is packages/xmap's job, in the
# runner's own process, on text this module has bounded (play/view.dawn).
#
# Both compilers run for either target. The call table is the calls both
# side tables have a row for (that is how a call one backend lost is found
# and counted as a gap instead of silently shown), so even a request for the C
# text needs the JVM table, and the listing is the one more unit that makes the
# other target's answer cacheable under the same key.
#
# Each phase is its own `systemd-run` unit with every limit the other phases
# have (sandbox/run-sandboxed.sh), and the three share one wall-clock budget,
# the compile budget, so the request holds its gate permit no longer than a
# /check does. The compilers write into `box/` (they are given paths there) and
# the runner reads those files back after the unit has ended, with the read
# `/check`'s diagnostics get: a regular file only, no link followed, at most
# VIEW_RAW_LIMIT bytes in memory. The listing is the sandbox's stdout, so it
# goes through a file the runner opened, as every phase's output does.

## The most bytes of one raw file (the C text, either table, the listing) the
## view reads. The largest of the 11 starter programs is 871 KB, almost all of
## it the standard library's share of the C text; this is about ten times that.
## A file past it answers "too large" and is never mapped.
const VIEW_RAW_LIMIT: Int = 8388608

## What the compilers and `javap` wrote for one program, as text, and how long
## they took together.
pub type ViewParts = { ctext: String, cmap: String, jmap: String, javap: String, ms: Int }

## How a view's raw material came out: the material; a failure of the program
## (its diagnostics, like /check's); the compile budget spent; a failure that is not the
## visitor's (the listing tool failed, an output could not be read); or a file
## past the limit, named.
pub type ViewRaw =
  | RawOk(parts: ViewParts)
  | RawFail(outcome: Outcome)
  | RawTimedOut(secs: Int)
  | RawBroken(message: String)
  | RawTooLarge(what: String)

## Whether `javap` can be started: the toolchain id the view's cache key
## carries (its `-version` line), or "" when it cannot. Asked once at startup
## like [`compiler_id`]: the unit that runs it later finds the same binary by
## the same name, or the view answers that it is missing.
pub fn javap_id() -> String !io = id_of_tool(javap_bin())

# The first line `bin -version` prints, or "" when `bin` cannot be started, is
# not there, exits with a failure or does not answer in five seconds. Starting
# a program that does not exist is a fault of the start, not an absent answer,
# so it is caught here: a missing javap must leave the runner up, saying so.
fn id_of_tool(bin: String) -> String !io = first_line_of(bin, "-version")

fn first_line_of(bin: String, flag: String) -> String !io = {
  let root = temp_root()
  let base = "${root}/dawn-play-probe-${uuid()}"
  with out <- bracket("${base}.txt", cleanup_file)
  match run_timed([bin, flag], out, "${base}.rc", 5, []) {
    Some(0) -> {
      let (text, _) = read_capped(out, root)
      str.trim(text)
    }
    _ -> ""
  }
}

fn cleanup_file(path: String) -> Unit !io = {
  let _ = with_fs_real(() => io.delete(path))
  ()
}

## Whether `bin` can be found: a path that exists, or a bare name `command -v`
## finds. The serve path asks this instead of running `javap -version` (a JVM
## start) for every request.
pub fn tool_present(bin: String) -> Bool !io =
  if str.contains(bin, "/") {
    with_fs_real(() => io.exists(bin))
  } else {
    match run_cmd(["sh", "-c", "command -v \"$1\"", "sh", bin], "/dev/null", "/dev/null") {
      Ok(0) -> true
      _ -> false
    }
  }

test "a tool that is not there has no id, one that is has" {
  assert id_of_tool("/nonexistent/javap") == ""
  assert id_of_tool(java_bin()) != ""
}

# The view's commands run in a UTF-8 locale. A unit starts with an empty
# environment, which the JVM reads as the POSIX locale: its file names are then
# ASCII, and `dawn __emit -o` could not write `prog$Wéird.class` for a type
# named Wéird ("unmappable characters"), where `dawn build` puts the same class
# in a jar by a name that is not a file's and never noticed. `javap` prints
# such a name as `?` in the same locale. The locale is set on the command, not
# in the sandbox wrapper, so /run and /check keep the environment they have.
fn utf8_env(argv: List[String]) -> List[String] = ["env", "LC_ALL=C.UTF-8"] ++ argv

# One sandboxed unit of the view: `argv` in the box, its output in
# `<dir>/<name>.txt`. Some(exit status), or None on a timeout, the unit having
# been stopped by then. Either way it has ended when this returns, which is
# what lets the request release its permit.
fn await_unit(dir: String, box: String, name: String, argv: List[String], secs: Int) -> Option[Int] !io = {
  let unit = fresh_unit()
  run_timed(sandboxed(unit, box, utf8_env(argv)), "${dir}/${name}.txt", "${dir}/${name}.rc", secs, stop_argv(unit))
}

# Seconds of the shared budget not yet spent, at least one.
fn budget_left(started: Instant) -> Int !io = {
  let spent = ms_since(started) / 1000
  let left = compile_timeout_secs() - spent
  if left < 1 { 1 } else { left }
}

# One of a compiler's files from the box: the text, or the reason it is not
# usable (past the limit).
fn raw_file(path: String, what: String, scratch: String) -> Result[String, ViewRaw] !io = {
  let (text, cut) = read_capped_to(path, VIEW_RAW_LIMIT, scratch)
  if cut { Err(RawTooLarge(what)) } else { Ok(text) }
}

# The two compilers read the same source and write apart, and they run one
# after the other: the production host is small and also serves /run and
# /check, and a request that started both at once would put two compiler JVMs
# under one permit, four under two. Measured on the dev box, sequential is
# 3.6 to 4.0 s cold against 2.0 to 2.2 s side by side; the second tab of a
# program is a cache hit either way, which is where the repeat cost goes.
fn view_staged(dir: String, box: String, native: Bool) -> ViewRaw !io = {
  let started = tick()
  let prog = "${box}/prog.dawn"
  match emitc_unit(dir, box, prog, native, started) {
    Some(fail) -> fail
    None -> match emit_unit(dir, box, "emit", [dawn_bin(), "__emit", prog, "-o", "${box}/classes", "--map", "${box}/jvm.dawnmap"], started) {
      Some(fail) -> fail
      None -> list_and_gather(dir, box, started)
    }
  }
}

# The C half of the view. `dawnc emitc` writes the same C text and map as
# `dawn __emitc` (byte-compared in test/contract.sh) and costs a tenth of the
# memory; a program it declines goes to the JVM compiler, as in [`check_phase`].
fn emitc_unit(dir: String, box: String, prog: String, native: Bool, started: Instant) -> Option[ViewRaw] !io = {
  let jvm = [dawn_bin(), "__emitc", prog, "-o", "${box}/out.c", "--map", "${box}/c.dawnmap"]
  if not native {
    emit_unit(dir, box, "emitc", jvm, started)
  } else {
    match emit_unit(dir, box, "emitc", [native_bin(), "emitc", prog, "-o", "${box}/out.c", "--map", "${box}/c.dawnmap"], started) {
      Some(RawFail(CompileError(diags))) ->
        if native_declined(diags) { emit_unit(dir, box, "emitc", jvm, started) } else { Some(RawFail(CompileError(diags))) }
      other -> other
    }
  }
}

# One compiler unit: None when it succeeded, else the answer that ends the
# request, which is /check's: the diagnostics, or the timeout.
fn emit_unit(dir: String, box: String, name: String, argv: List[String], started: Instant) -> Option[ViewRaw] !io =
  match await_unit(dir, box, name, argv, budget_left(started)) {
    None -> Some(RawTimedOut(compile_timeout_secs()))
    Some(code) -> if code != 0 { Some(RawFail(CompileError(diagnostics(dir, box, name)))) } else { None }
  }

fn diagnostics(dir: String, box: String, name: String) -> String !io = {
  let (diags, _) = shown("${dir}/${name}.txt", dir, box)
  str.trim(diags)
}

# javap names the class by a path the runner chose: the module of a single
# file is its stem, and the file is always prog.dawn.
fn list_and_gather(dir: String, box: String, started: Instant) -> ViewRaw !io = {
  let argv = [javap_bin(), "-J-Xmx128m", "-J-Dstdout.encoding=UTF-8", "-c", "-p", "-s", "${box}/classes/prog.class"]
  match await_unit(dir, box, "javap", argv, budget_left(started)) {
    None -> RawBroken("the listing tool timed out")
    Some(code) ->
      if code != 0 {
        RawBroken("the listing tool failed: ${diagnostics(dir, box, "javap")}")
      } else {
        gather(dir, box, started)
      }
  }
}

fn gather(dir: String, box: String, started: Instant) -> ViewRaw !io =
  match raw_file("${box}/out.c", "the C text", dir) {
    Err(e) -> e
    Ok(ctext) -> match raw_file("${box}/c.dawnmap", "the C map", dir) {
      Err(e) -> e
      Ok(cmap) -> match raw_file("${box}/jvm.dawnmap", "the JVM map", dir) {
        Err(e) -> e
        Ok(jmap) -> match raw_file("${dir}/javap.txt", "the JVM listing", dir) {
          Err(e) -> e
          Ok(javap) -> RawOk(ViewParts {
            ctext: ctext,
            cmap: cmap,
            jmap: jmap,
            javap: javap,
            ms: ms_since(started),
          })
        }
      }
    }
  }

## The raw material of `code`'s compile view, from the sandbox. Compile-only:
## the program is never run, though `comptime` still runs inside the compiler,
## which is why the compilers are sandboxed like /check's.
pub fn view_raw(code: String, native: Bool) -> ViewRaw !io =
  with_fs_real(() => with_staged(code, msg => RawFail(CompileError(msg)), (dir, box) => view_staged(dir, box, native)))

# ---- the Tile IR view (POST /compile with target "tile") ----
#
# "Compiling to Tile IR" is running: a program that imports packages/tileir
# records a kernel with the package's `Dev` handler and prints `render` of it
# (docs/playground-compile-design.md section 4). So this view is `/run` on a
# project instead of a file, with everything /run has: the same sandbox units,
# the compile and run budgets, the output limit and the output files the runner
# opened. The program's standard output is the view.
#
# The project is the runner's. The visitor supplies the text of `src/main.dawn`
# and nothing else: `dawn.toml` is written here, with two path dependencies on
# the deployed packages and no others, so a program's `use` can reach those and
# the standard library and an import of anything else fails to resolve. A
# manifest taken from the request would let a program name any directory the
# unit can read as a package.
#
# Where `dawn build` of a project writes: nowhere but the jar it was asked for.
# It was checked in a unit with the wrapper's whole property set and, apart,
# under a read-only root with only the box writable: the box ends up holding the
# staged files and `prog.jar`, and no lock file, cache or build directory is
# made beside them (the manifest has no `[deps.java]`, so there is nothing to
# resolve). The packages are read from the same read-only bind as the compiler.

## The manifest of a Tile IR project: `packages` is the directory holding the
## `tileir` and `tileref` packages. Fixed text but for that path.
pub fn tile_manifest(packages: String) -> String =
  "schema = 1\nname = \"tile\"\nversion = \"0.0.0\"\n\n[deps]\ntileir = \"${packages}/tileir\"\ntileref = \"${packages}/tileref\"\n"

test "the manifest names exactly two dependencies, both under the packages directory" {
  let m = tile_manifest("/opt/dawn/packages")
  assert str.contains(m, "tileir = \"/opt/dawn/packages/tileir\"\n")
  assert str.contains(m, "tileref = \"/opt/dawn/packages/tileref\"\n")
  assert len(str.split(m, " = \"/")) == 3
}

## Whether this machine has the packages the view imports; asked once at start.
## Without them every request would fail inside a unit, so the view answers 503
## and says why, as it does for a missing `javap`.
pub fn tile_ready() -> Bool !io = {
  let root = packages_root()
  with_fs_real(() => io.exists("${root}/tileir/dawn.toml") && io.exists("${root}/tileref/dawn.toml"))
}

## Run `code` as the `src/main.dawn` of a Tile IR project and answer what /run
## answers: the diagnostics, the program's output and exit status, or a timeout.
pub fn tile_run(code: String) -> Outcome !io = {
  let files = [("src/main.dawn", code), ("dawn.toml", tile_manifest(packages_root()))]
  with_fs_real(() => with_files(files, msg => CompileError(msg), tile_staged))
}

fn tile_staged(dir: String, box: String) -> Outcome !io =
  match compile_input(dir, box, box) {
    Err(diags) -> CompileError(diags)
    Ok(_) -> run_phase(dir, box)
  }

# Phase 2: run the compiled jar under a wall-clock limit.
fn run_phase(dir: String, box: String) -> Outcome !io = {
  let run_out = "${dir}/run.txt"
  let unit = fresh_unit()
  let started = tick()
  match run_timed(sandboxed(unit, box, [java_bin(), RUN_HEAP, "-jar", "${box}/prog.jar"]), run_out, "${dir}/run.rc", timeout_secs(), stop_argv(unit)) {
    Some(code) -> {
      let ms = ms_since(started)
      let (out, cut) = shown(run_out, dir, box)
      Compiled(out, code, cut, ms)
    }
    None -> {
      let (out, _) = shown(run_out, dir, box)
      Timeout(out)
    }
  }
}

# The compiler release this runner compiles with, for /health and so for the
# version the editor shows: "0.81.0" out of `dawn --version`'s
# "dawn 0.81.0 (selfhost)", and the build, "b1:2bfef5fb3622", the short digest
# of the sources that compiler was built from, which `--version` appends when
# its jar carries a build manifest (docs/build-info-design.md). The version
# alone cannot tell a release from a later main build: both say 0.81.0.
# Asked once at startup, not per request, because the answer only changes
# with a redeploy, which restarts this process.
#
# The probe runs before the socket opens and redeploy.sh gives the whole
# restart 28 seconds of health checks, so it has a 5-second budget of its
# own instead of the compile budget. A probe that fails or times out answers
# "" for both, and /health still says ok: they are labels, not a liveness test.
# Unsandboxed: it runs the operator's own binary with a fixed argv.
pub type CompilerId = { version: String, build: String }

pub fn compiler_id() -> CompilerId !io = {
  # A deploy that already knows its toolchain says so (PLAY_TOOLCHAIN_ID is
  # "<version> <build>", e.g. "0.85.0 b1:2bfef5fb3622", what `dawn --version`
  # prints after its name): the process-per-request entry then answers /health
  # without a child, where `dawn --version` costs a quarter second a request.
  let told = with_env_real(() => io.getenv("PLAY_TOOLCHAIN_ID"))
  match told {
    Some(v) -> if v != "" { id_of("dawn " ++ v) } else { probe_compiler_id() }
    None -> probe_compiler_id()
  }
}

fn probe_compiler_id() -> CompilerId !io = {
  let root = temp_root()
  let base = "${root}/dawn-play-version-${uuid()}"
  with out <- bracket("${base}.txt", cleanup_file)
  match run_timed([dawn_bin(), "--version"], out, "${base}.rc", 5, []) {
    None -> CompilerId { version: "", build: "" }
    Some(_) -> {
      let (text, _) = read_capped(out, root)
      id_of(text)
    }
  }
}

# Whether /check and the C view may use the native `dawnc`: it answers
# `--version` and says the same release `dawn` does. Asked once at startup,
# with `compiler_id`, and a "no" is logged once here, not per request: the
# runner is then exactly the JVM-only runner it was. A missing `dawnc` is the
# ordinary case on a dev box and says nothing alarming; a present one of
# another release is a deploy that shipped half a toolchain, so it is named.
# Only the version is compared, not the `b1:` digest: the jar and the native
# binary are built by different toolchains from the same sources and print
# different digests for the same release.
pub fn native_ready(id: CompilerId) -> Bool !io = {
  let line = first_line_of(native_bin(), "--version")
  if line == "" {
    io.eprintln("dawn-play: no native dawnc at ${native_bin()}; /check and the C view use the JVM compiler")
    false
  } else {
    let v = native_version_of(line)
    if v != "" && v == id.version {
      true
    } else {
      io.eprintln("dawn-play: dawnc reports version '${v}' but dawn reports '${id.version}'; ignoring dawnc, /check and the C view use the JVM compiler")
      false
    }
  }
}

# The second word of `dawnc <version> (native) ...`.
fn native_version_of(line: String) -> String =
  match str.strip_prefix(line, "dawnc ") {
    Some(rest) -> match str.split(str.trim(rest), " ") {
      [v, ..] -> str.trim(v)
      [] -> ""
    }
    None -> ""
  }

test "the native version is the word after dawnc" {
  assert native_version_of("dawnc 0.85.0 (native) b1:b45ed3c031a4") == "0.85.0"
  assert native_version_of("dawn 0.85.0 (selfhost)") == ""
  assert native_version_of("") == ""
}

test "an empty diagnostic or the refusal sentence is a refusal, a verdict is not" {
  assert native_declined("")
  assert native_declined("error: `use java` is not available in this compiler\n  --> prog.dawn:1:10\n")
  assert not native_declined("error: undefined variable: nope\n")
}

# The words after "dawn " on the first line that starts with it. bin/dawn may
# print toolchain chatter ("resolving 2 java-deps ...") before it.
fn dawn_words(text: String) -> List[String] = {
  for line in str.split(text, "\n") {
    match str.strip_prefix(line, "dawn ") {
      Some(rest) -> return str.split(str.trim(rest), " ")
      None -> ()
    }
  }
  []
}

# The second word of the `dawn <version> ...` line.
fn version_of(text: String) -> String =
  match dawn_words(text) {
    [v, ..] -> str.trim(v)
    [] -> ""
  }

# The version and the `b1:` word after it, if there is one: an older compiler
# prints none, and then the build is "" like an unknown version.
fn id_of(text: String) -> CompilerId = {
  var build = ""
  for w in dawn_words(text) {
    if build == "" && str.starts_with(w, "b1:") { build = str.trim(w) }
  }
  CompilerId { version: version_of(text), build: build }
}

test "version_of skips launcher chatter" {
  assert version_of("resolving 2 java-deps from x\ndawn 0.81.0 (selfhost)\n") == "0.81.0"
  assert version_of("dawn 0.81.0") == "0.81.0"
  assert version_of("no such file\n") == ""
}

test "id_of takes the build digest when the compiler prints one" {
  assert id_of("resolving 2 java-deps from x\ndawn 0.83.0 (selfhost) b1:2bfef5fb3622\n") ==
    CompilerId { version: "0.83.0", build: "b1:2bfef5fb3622" }
  assert id_of("dawn 0.81.0 (selfhost)\n") == CompilerId { version: "0.81.0", build: "" }
  assert id_of("no such file\n") == CompilerId { version: "", build: "" }
}

# Test-only: run a fixed argv to completion.
fn sh_run(argv: List[String]) -> Unit !io = {
  let _ = run_cmd(argv, "/dev/null", "/dev/null")
  ()
}

test "whole_chars drops only a sequence the cut left incomplete" {
  let e = bytes.utf8("aé")
  assert whole_chars(bytes.slice(e, 0, 2)) == bytes.utf8("a")
  assert whole_chars(e) == e
  let wide = bytes.utf8("a😀")
  assert whole_chars(bytes.slice(wide, 0, 4)) == bytes.utf8("a")
  assert whole_chars(wide) == wide
  assert whole_chars(bytes.utf8("")) == bytes.utf8("")
}

test "read_capped holds at most the limit and says it cut" {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  with_fs_real(() => {
    let line = str.repeat("x", 1023) ++ "\n"
    # twenty times the limit, which the old read held whole
    assert match io.write_file("${d}/big.txt", str.repeat(line, 20 * 64)) { Ok(_) -> true, Err(_) -> false }
    assert match io.write_file("${d}/small.txt", "hi\n") { Ok(_) -> true, Err(_) -> false }
  })
  let (big, cut) = read_capped("${d}/big.txt", d)
  assert cut
  assert str.len(big) == OUTPUT_LIMIT
  assert read_capped("${d}/small.txt", d) == ("hi\n", false)
  assert read_capped("${d}/absent.txt", d) == ("", false)
}

test "read_capped neither follows a link nor waits on a special file" {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  with_fs_real(() => {
    assert match io.write_file("${d}/secret.txt", "secret\n") { Ok(_) -> true, Err(_) -> false }
  })
  sh_run(["ln", "-s", "${d}/secret.txt", "${d}/link.txt"])
  sh_run(["mkfifo", "${d}/fifo.txt"])
  assert read_capped("${d}/link.txt", d) == ("", false)
  # a FIFO with no writer would block an open for good; this returning at all
  # is half the assertion
  assert read_capped("${d}/fifo.txt", d) == ("", false)
  # and the link's target is still readable when asked for by its own name
  assert read_capped("${d}/secret.txt", d) == ("secret\n", false)
}

test "shown strips the box before the request directory, then marks a cut" {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  let box = "${d}/box"
  with_fs_real(() => {
    assert match io.write_file("${d}/out.txt", "${box}/prog.dawn:1:1 in ${d}\n") { Ok(_) -> true, Err(_) -> false }
  })
  assert shown("${d}/out.txt", d, box) == ("prog.dawn:1:1 in .\n", false)
}

# Test-only: a request body that fails after the box exists, naming its
# request directory so the test can look for it afterwards. The `|` ends the
# name; the panic appends its call site after it.
fn fails_in(dir: String, box: String) -> Outcome !io = panic(dir ++ "|")

test "with_request removes the request directory when the body fails" {
  let failed: Result[Outcome, ForeignError] = catch_panic(() => with_fs_real(() => with_request("x", fails_in)))
  let named = match failed {
    Ok(_) -> ""
    Err(e) -> str.split(e.message, "|").get(0).unwrap_or("")
  }
  assert str.contains(named, "/dawn-play-")
  assert not present(named)
}

# Test-only: a stand-in for the sandbox wrapper with the property that matters.
# `run` starts the work in a session of its own and waits for it, so killing the
# wrapper's group leaves the work running, as killing `sudo` leaves the unit; `stop`
# ends the work by the pid `run` recorded under the unit id.
fn fake_wrapper(d: String) -> String !io = {
  let path = "${d}/fake-sandbox.sh"
  let body =
    "#!/bin/sh\n" ++
    "d=\$(dirname \"\$0\")\n" ++
    "case \"\$1\" in\n" ++
    "  run) id=\$2; shift 2; setsid \"\$@\" & echo \$! > \"\$d/\$id.pid\"; wait \$! ;;\n" ++
    "  stop) kill \"\$(cat \"\$d/\$2.pid\")\" ;;\n" ++
    "esac\n"
  let _ = with_fs_real(() => io.write_file(path, body))
  path
}

# Test-only: whether the pid recorded for `unit` is still a live process.
fn alive(d: String, unit: String) -> Bool !io = {
  let pid = with_fs_real(() => match io.read_file("${d}/${unit}.pid") {
    Ok(t) -> t
    Err(_) -> ""
  })
  match run_cmd(["kill", "-0", str.trim(pid)], "/dev/null", "/dev/null") {
    Ok(0) -> true
    _ -> false
  }
}

test "a timed-out phase is stopped through the wrapper, not only killed" {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  let fake = fake_wrapper(d)
  let unit = fresh_unit()
  assert str.len(unit) == 32
  assert run_timed(["sh", fake, "run", unit, "sleep", "30"], "${d}/o.txt", "${d}/o.rc", 1, ["sh", fake, "stop", unit]) == None
  # the work the wrapper started is gone by the time the phase returns
  assert not alive(d, unit)
}

test "a program's own exit 124 is its status, not a timeout" {
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  sh_run(["mkdir", "-p", d])
  assert run_timed(["sh", "-c", "exit 124"], "${d}/o.txt", "${d}/o.rc", 5, []) == Some(124)
  assert run_timed(["sh", "-c", "echo hi; exit 3"], "${d}/o.txt", "${d}/o.rc", 5, []) == Some(3)
  assert read_capped("${d}/o.txt", d) == ("hi\n", false)
}

test "with no stop command a timed-out wrapper's work outlives it" {
  # the shape of the bug, kept as the control: killing the wrapper alone
  # leaves its work running
  let dir = fresh_dir()
  with d <- bracket(dir, cleanup)
  let fake = fake_wrapper(d)
  let unit = fresh_unit()
  assert run_timed(["sh", fake, "run", unit, "sleep", "30"], "${d}/o.txt", "${d}/o.rc", 1, []) == None
  assert alive(d, unit)
  sh_run(["sh", fake, "stop", unit])
}

fn present(path: String) -> Bool !io = with_fs_real(() => io.exists(path))

test "remove_tree says why a tree it cannot empty stays, and cleans one it can" {
  let dir = fresh_dir()
  sh_run(["mkdir", "-p", "${dir}/box/classes"])
  sh_run(["touch", "${dir}/box/classes/A.class"])
  assert remove_tree(dir) == None
  assert not present(dir)
  # a directory the runner may not write into: the shape the sandbox's
  # transient uid left behind under umask 022
  sh_run(["mkdir", "-p", "${dir}/box/classes"])
  sh_run(["touch", "${dir}/box/classes/A.class"])
  sh_run(["chmod", "0555", "${dir}/box/classes"])
  match remove_tree(dir) {
    Some(why) -> { assert str.contains(why, "classes") }
    None -> { assert false }
  }
  assert present(dir)
  sh_run(["chmod", "0755", "${dir}/box/classes"])
  assert remove_tree(dir) == None
}

test "sweep_stale removes dawn-play-* under the root, counts them, and leaves the rest" {
  let root = "${temp_root()}/dawn-play-sweeptest-${uuid()}"
  sh_run(["mkdir", "-p", "${root}/dawn-play-aaa/box/classes", "${root}/dawn-play-bbb", "${root}/keep"])
  sh_run(["touch", "${root}/dawn-play-aaa/box/classes/A.class", "${root}/keep/f"])
  let n = with_fs_real(() => sweep_stale(root))
  assert n == 2
  assert present("${root}/keep/f")
  assert not present("${root}/dawn-play-aaa")
  assert remove_tree(root) == None
}

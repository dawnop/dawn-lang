# The single-document pages: spec, design, playground, the demo, plus assets.
# The front page is gen/home.dawn's.
#
# Each page states its own head (html/page.PageHead): the title and the
# translation note come off the front of its document (html/render.split_head),
# the trail says where the page sits, and the chips under the title say only
# what the page already holds -- its status, the release the spec applies to,
# how many sections or entries it has, how long it takes to read.

use std/str
use std/io
use std/io.{Fs, Env, getenv}
use std/bytes
use md/ast.{Block}
use html/render.{TocEntry, render_doc, split_head, inline_run, inline_text, timeline_entries}
use html/page.{Assets, Lang, En, Zh, PageHead, Crumb, page_with_toc, shell_ext, lang_path, plain_assets,
  no_head, toc_rail, section_crumb, here, chip, release_chip, reading_chip, twin_chip, cat_path }
use html/play.{win_bar}
use hl/dawn.{highlight_dawn}
use html/escape.{escape_html, escape_attr}
use gen/common.{must_read, write_page, map_doc_url, doc_files}
use gen/fingerprint.{fingerprint}
use gen/search.{read_api, search_index}
use gen/search_body.{search_body}
use gen/corpus.{Corpus}

# Byte IO for the assets. read_file/write_file are UTF-8 string APIs and would
# corrupt PNG/ICO bytes; the text assets go through here too, because what gets
# hashed has to be the bytes that get written and nothing near them.
#
# This was a pair of `use java` streams until 2026-08-05, and those two lines
# cost more than they looked: one `use java` anywhere in a program makes the
# whole thing uncompilable on the C backend ("`use java` cannot be compiled to
# native"), so the generator quietly stopped having a second backend at all --
# and with it the JVM-vs-native comparison site/README.md calls a project
# tradition. std's byte IO is on both backends; scripts/site-dist-diff.sh is
# what now says so.
fn read_bin(src: String) -> Bytes !Fs =
  match io.read_bytes(src) {
    Ok(b) -> b
    Err(e) -> panic("cannot read ${src}: ${e}")
  }

fn write_bin(dst: String, content: Bytes) -> Unit !Fs !io =
  match io.write_bytes(dst, content) {
    Ok(_) -> println("  wrote ${dst}")
    Err(e) -> panic("cannot write ${dst}: ${e}")
  }

## Write one asset and answer the name the pages must link to.
##
## Two files, one content. The fingerprinted name is the one every page links
## to: /assets/ is served with a one-year `immutable` header, and that header
## is only honest about a URL whose bytes cannot change under it (see
## gen/fingerprint).
##
## The plain name is written as well, and this is a transition affordance
## rather than a second asset. HTML is revalidated on every visit, so within a
## visit or two nobody is asking for `/assets/style.css` any more -- but a
## visitor holding a page cached from before this change still is, and
## site/redeploy.sh rsyncs with `--delete`, which would turn that request into
## a 404 and the page into unstyled HTML. The alias carries the same bytes,
## fix included, so it is not a stale copy either. It can be dropped once no
## pre-fingerprint HTML is plausibly still in a cache.
fn emit_asset(out: String, name: String, content: Bytes) -> String !Fs !io = {
  let fp = fingerprint(name, content)
  write_bin("${out}/assets/${fp}", content)
  write_bin("${out}/assets/${name}", content)
  fp
}

## Text assets keep the trailing newline write_page used to add, so that the
## bytes on disk -- and therefore the hash -- do not depend on which helper
## wrote them.
fn emit_text(out: String, name: String, text: String) -> String !Fs !io =
  emit_asset(out, name, bytes.utf8(text ++ "\n"))

## The release and the commit this build was made from, as the footer prints
## them, each "" when the build did not say.
##
## Read from the environment, which site/build.sh sets (DAWN_SITE_VERSION from
## selfhost/src/version.dawn, DAWN_SITE_COMMIT from git), rather than from
## those files: scripts/site-dist-diff.sh runs this generator over a snapshot
## that holds neither selfhost/ nor .git, and both of its legs inherit the
## same environment, so the two backends still write the same bytes.
pub fn build_stamp() -> (String, String) !Env =
  (unwrap_or(getenv("DAWN_SITE_VERSION"), ""), unwrap_or(getenv("DAWN_SITE_COMMIT"), ""))

pub fn gen_assets(out: String, build: (String, String), en: Corpus, zh: Corpus) -> Assets !Fs !io = {
  let (version, commit) = build
  # Read once, used twice: the two search indexes are built from the same
  # `dawn doc --stdlib` document gen/stdlib later renders into the page,
  # and an index built from a second read would be an index of a document
  # nobody had checked was the same one.
  let api = read_api()
  # The site's monospace face, self-hosted so the site makes no request to
  # anybody else (docs/site-home-design.md). Written before the stylesheet
  # that names them, because that stylesheet names them by the hashed name
  # they get here. Every page's sheet names them since the tokens moved into
  # it (docs/site-pages-design.md); the front page's own sheet no longer does.
  let mono = emit_asset(out, "JetBrainsMono-Regular.woff2",
    read_bin("site/assets/fonts/JetBrainsMono-Regular.woff2"))
  let mono_medium = emit_asset(out, "JetBrainsMono-Medium.woff2",
    read_bin("site/assets/fonts/JetBrainsMono-Medium.woff2"))
  let style = emit_text(out, "style.css",
    repoint_url(repoint_url(str.trim(must_read("site/assets/style.css")),
      "JetBrainsMono-Regular.woff2", mono), "JetBrainsMono-Medium.woff2", mono_medium))
  let home_css = emit_text(out, "home.css", str.trim(must_read("site/assets/home.css")))
  # The bracket-cat mark, in the four shapes the places it appears will take.
  # The SVG is the mark; the three rasters are the same drawing rendered for
  # formats that cannot hold a vector, and scripts/render-brand.py is what
  # rendered them -- they are checked in rather than built, because this
  # generator has to be able to produce site/dist with nothing but a compiler,
  # and byte for byte the same one on both backends.
  #
  # The SVG goes through read_bin like the rasters even though it is text: what
  # gets hashed has to be what gets written, and a UTF-8 decode/encode round
  # trip is one more thing between the two.
  #
  # site/assets also holds logo-mono.svg and logo-white.svg -- the same mark in
  # one flat colour, for a dark background or a print. Neither is emitted: this
  # site has no dark chrome and no page links them, and an asset shipped for
  # nobody is one more URL to keep alive. They are in the tree so that whoever
  # needs one has it; the day a page wants one, it gets a line here.
  let logo = emit_asset(out, "logo.svg", read_bin("site/assets/logo.svg"))
  let favicon = emit_asset(out, "favicon.ico", read_bin("site/assets/favicon.ico"))
  let touch = emit_asset(out, "apple-touch-icon.png",
    read_bin("site/assets/apple-touch-icon.png"))
  let og = emit_asset(out, "logo-512.png", read_bin("site/assets/logo-512.png"))
  # Vendor the Playground editor bundle (built from site/play-ui). Copy it if
  # present; otherwise write placeholders so the link checker still passes and
  # the rest of the site builds — the Playground page just won't have an editor.
  let play_js = emit_or_stub(out, "playground.js", "site/play-ui/dist/playground.js",
    "console.warn('dawn-play: editor bundle missing; run site/play-ui build')")
  let play_css = emit_or_stub(out, "playground.css", "site/play-ui/dist/playground.css",
    "/* dawn-play: editor bundle missing */")
  Assets {
    style: style,
    logo: logo,
    # the cat out of the mark, for the one that peeks over each page's band
    cat: cat_path(must_read("site/assets/logo.svg")),
    favicon: favicon,
    touch_icon: touch,
    og_image: og,
    play_css: play_css,
    play_js: play_js,
    tea_js: emit_bridge(out),
    # Built by site/build.sh, which is also where the toolchain that can build
    # them is probed for. Never built here: scripts/site-dist-diff.sh runs this
    # generator twice and compares the two site/dist byte for byte, so what the
    # generator does has to be a function of files that were already on disk
    # when it started.
    tea_counter: emit_wasm(out, "tea-counter.wasm", "site/build/tea/counter.wasm"),
    tea_todo: emit_wasm(out, "tea-todo.wasm", "site/build/tea/todo.wasm"),
    # The search panel. Its script is checked in beside the stylesheet; its
    # reactor is built by site/build.sh like the two above, and is a
    # placeholder on a checkout with no wasm toolchain -- in which case the
    # button reports that it could not load and every page is otherwise what
    # it was. The two indexes are computed here from the site's own inputs;
    # gen/search.dawn is the whole of that.
    search_js: emit_text(out, "search.js", str.trim(must_read("site/assets/search.js"))),
    search_wasm: emit_wasm(out, "tea-search.wasm", "site/build/tea/search.wasm"),
    search_en: emit_text(out, "search-en.json", search_index(api, En, en)),
    search_zh: emit_text(out, "search-zh.json", search_index(api, Zh, zh)),
    # The second half of the search: the documents' paragraphs, inverted
    # (gen/search_body.dawn, contract in docs/site-search-design.md). Fetched
    # by the panel only once a reader has typed something, so a reader who
    # only looks up a title never pays for it.
    search_body_en: emit_body(out, "search-body-en.json", search_body(en, En)),
    search_body_zh: emit_body(out, "search-body-zh.json", search_body(zh, Zh)),
    home_css: home_css,
    home_js: emit_text(out, "home.js", str.trim(must_read("site/assets/home.js"))),
    theme_js: emit_text(out, "theme.js", str.trim(must_read("site/assets/theme.js"))),
    mono_font: mono,
    version: version,
    commit: commit,
  }
}

## The DOM bridge's four ES modules (packages/tea-dom/js), vendored under
## content-hashed names; answers the name of the one a page imports.
##
## They import each other by relative specifier, and a fingerprinted copy is
## not at the name its siblings ask for -- so each specifier is repointed at
## the name its target actually got. That makes this four calls in dependency
## order (wasi <- reactor, dom <- app) rather than a loop over a directory
## listing, and the order is the reason: a name cannot be written into an
## importer before the file it names has been hashed.
fn emit_bridge(out: String) -> String !Fs !io = {
  let wasi = emit_text(out, "tea-wasi.mjs", bridge_src("wasi.mjs"))
  let reactor = emit_text(out, "tea-reactor.mjs",
    repoint(bridge_src("reactor.mjs"), "./wasi.mjs", wasi))
  let dom = emit_text(out, "tea-dom.mjs", bridge_src("dom.mjs"))
  emit_text(out, "tea-app.mjs",
    repoint(repoint(bridge_src("app.mjs"), "./reactor.mjs", reactor), "./dom.mjs", dom))
}

## A body index, written like any text asset, with its size said in the build
## log. The budget is in gzip bytes and this generator has no compressor, so
## the raw count is all it can say; site/build.sh prints the gzip count beside
## it.
fn emit_body(out: String, name: String, text: String) -> String !Fs !io = {
  let fp = emit_text(out, name, text)
  let size = bytes.len(bytes.utf8(text)) + 1
  println("  ${name}: ${size} bytes")
  fp
}

fn bridge_src(name: String) -> String !Fs = str.trim(must_read("packages/tea-dom/js/${name}"))

## Point one vendored module at the name another really got.
##
## The specifier has to be found. A rewrite that matched nothing would leave an
## import of a file this generator never wrote, and nothing on this site could
## notice: gen/links reads `href=` and `src=`, and an import specifier is
## neither. So a change in how packages/tea-dom/js spells its imports stops the
## build here rather than shipping a demo page that fails to load.
fn repoint(text: String, spec: String, name: String) -> String !io = {
  let quoted = "'${spec}'"
  if str.contains(text, quoted) {
    str.replace(text, quoted, "'./${name}'")
  } else {
    panic("no import of `${spec}` to repoint — packages/tea-dom/js changed how it "
        ++ "spells its imports, and the vendored copies would import files that "
        ++ "are not there")
  }
}

## Point a `url("<name>")` in a stylesheet at the name the file really got.
##
## Relative, so the stylesheet resolves it next to itself in /assets/ and its
## bytes do not depend on where a page sits. A stylesheet that stopped naming
## the file would otherwise keep fetching the plain-name alias, whose URL does
## not change when its bytes do, so a miss stops the build like [repoint].
fn repoint_url(css: String, name: String, hashed: String) -> String !io = {
  let quoted = `url("` ++ name ++ `")`
  if str.contains(css, quoted) {
    str.replace(css, quoted, `url("` ++ hashed ++ `")`)
  } else {
    panic("site/assets/style.css has no `url(\"${name}\")` to point at the hashed font; "
        ++ "the face would be fetched under a name the cache cannot see change")
  }
}

## One demo reactor, or a placeholder that says so. The wasm is a build product
## (site/build.sh), not a tracked file, so a checkout that has never had a wasm
## toolchain still builds the whole site; the demo page then fails to compile
## its module and reports it, which is the same deal the Playground makes when
## its editor bundle is missing.
fn emit_wasm(out: String, name: String, src: String) -> String !Fs !io =
  match io.read_bytes(src) {
    Ok(b) -> emit_asset(out, name, b)
    Err(_) -> {
      println("  warning: ${src} missing — writing placeholder ${name}")
      emit_text(out, name, "dawn tea: reactor not built; see site/build.sh")
    }
  }

fn emit_or_stub(out: String, name: String, src: String, stub: String) -> String !Fs !io =
  match io.read_file(src) {
    Ok(text) -> emit_text(out, name, text)
    Err(_) -> {
      println("  warning: ${src} missing — writing placeholder ${name}")
      emit_text(out, name, stub)
    }
  }

## The spec, the early design notes and the history, each one document
## rendered whole and each one a pair. The spec and the design notes have
## been pairs since 2026-08-07, and their Chinese is the original: the English
## is `<base>.en.md`, registered against `<base>.md` in scripts/doc-check.py.
## The history (2026-10-02) runs the other way, as the outward-facing
## documents do: `history.md` is the English original and
## `history.zh-CN.md` its translation. So the pairing is said per document
## rather than assumed.
##
## Which file each language reads is gen/corpus's (corpus_path), which reads
## it once for the pages and the search alike; what is left here is where the
## page lands. The default layout is the English site, the Chinese twin sits
## under `/zh/` -- the same rule the front page, the tutorial and the rest
## follow.
fn doc_source(base: String, out: String, lang: Lang) -> (String, String) =
  match lang {
    En -> ("${out}/${base}.html", ".")
    Zh -> ("${out}/zh/${base}.html", "..")
  }

## Where a document sits, as the trail above its title says: the spec and
## the timeline are sections of their own; the early design notes are a page
## of the history and say so, their "History" leading to the timeline, which
## links back to them.
fn doc_crumbs(base: String, lang: Lang, root: String) -> List[Crumb] =
  if base == "design" {
    let word =
      match lang {
        En -> "Early decisions"
        Zh -> "早期决定"
      }
    [section_crumb(lang, root, "history", true), here(word)]
  } else {
    [section_crumb(lang, root, doc_section(base), false)]
  }

## What is true of a document, as the chips under its title: its status, for
## the spec the release it applies to (`version`, from the build, left out
## when the build did not say) and how many sections it has, for the
## timeline how many entries. `toc` is the document's contents and `entries`
## its timeline entries, counted by the caller from what it rendered. The
## reading time and the translation are the caller's, being every
## document's.
fn doc_facts(base: String, lang: Lang, version: String, toc: List[TocEntry], entries: Int) -> List[String] = {
  let sections = len(filter(toc, e => e.level == 2))
  match lang {
    En ->
      if base == "spec" {
        [chip("normative"), release_chip(version), chip("${sections} sections")]
      } else if base == "history" {
        [chip("timeline, first commit to today"), chip("${entries} entries")]
      } else {
        [chip("decisions of M0–M7"), chip("historical")]
      }
    Zh ->
      if base == "spec" {
        [chip("权威"), release_chip(version), chip("${sections} 节")]
      } else if base == "history" {
        [chip("时间线，从第一个提交到今天"), chip("${entries} 条")]
      } else {
        [chip("M0–M7 的决策记录"), chip("历史文档")]
      }
  }
}

## Which nav item a document's page lights up. The early design notes are
## not in the nav; they sit under History, beside the timeline.
fn doc_section(base: String) -> String = if base == "spec" { "spec" } else { "history" }

## One document as a page with a contents rail. Its title and translation
## note are set in the band above it; the rest is the article.
fn doc_page(
  a: Assets,
  lang: Lang,
  base: String,
  root: String,
  blocks: List[Block],
  docs: List[String],
) -> String = {
  let mu = (u: String) => map_doc_url(root, docs, u)
  let parts = split_head(blocks)
  let doc = render_doc(parts.body, mu)
  let facts = doc_facts(base, lang, a.version, doc.toc, timeline_entries(parts.body))
  let head = PageHead {
    crumbs: doc_crumbs(base, lang, root),
    title: inline_run(parts.title, mu),
    lede: "",
    meta: facts ++ [reading_chip(lang, doc.html), twin_chip(parts.twin, mu)],
    extra: "",
    cls: "toc-aligned",
  }
  page_with_toc(a, lang, "${base}.html", "${inline_text(parts.title)} — Dawn", root, doc_section(base), head,
    toc_rail(lang, doc.toc), doc.html)
}

fn gen_doc_page(out: String, a: Assets, lang: Lang, base: String, blocks: List[Block]) -> Unit !Fs !io = {
  let docs = doc_files()
  let (dst, root) = doc_source(base, out, lang)
  write_page(dst, doc_page(a, lang, base, root, blocks, docs))
}

pub fn gen_spec(out: String, a: Assets, lang: Lang, c: Corpus) -> Unit !Fs !io =
  gen_doc_page(out, a, lang, "spec", c.spec)

pub fn gen_design(out: String, a: Assets, lang: Lang, c: Corpus) -> Unit !Fs !io =
  gen_doc_page(out, a, lang, "design", c.design)

## The history: the timeline from the first commit to today (docs/history.md),
## what the nav's History opens. The early design notes stay at their own
## URL, which links and search engines already have, and are reached from
## here.
pub fn gen_history(out: String, a: Assets, lang: Lang, c: Corpus) -> Unit !Fs !io =
  gen_doc_page(out, a, lang, "history", c.history)

## Which file each language reads is gen/corpus's test; this is the other half.
test "each language's document lands in its own place" {
  assert doc_source("spec", "d", En) == ("d/spec.html", ".")
  assert doc_source("spec", "d", Zh) == ("d/zh/spec.html", "..")
  assert doc_source("design", "d", Zh) == ("d/zh/design.html", "..")
  assert doc_source("history", "d", En) == ("d/history.html", ".")
}

## Unset, the mount is what it was before the variable existed, to the byte;
## site/build.sh's default build ships the same playground.html.
test "with no play origin the endpoint stays relative" {
  assert play_endpoint("") == Ok("/api/run")
  assert play_mount("/api/run") == `<div id="dawn-playground" data-endpoint="/api/run"></div>`
}

## Set, the endpoint is absolute on that origin, and anything that is not a
## bare origin stops the build instead of reaching the attribute.
test "a play origin makes the endpoint absolute" {
  assert play_endpoint("https://play.example.test") == Ok("https://play.example.test/api/run")
  assert play_endpoint("http://127.0.0.1:18097") == Ok("http://127.0.0.1:18097/api/run")
  assert play_mount("https://play.example.test/api/run")
    == `<div id="dawn-playground" data-endpoint="https://play.example.test/api/run"></div>`
  for bad in ["https://play.example.test/", "https://play.example.test/api", "play.example.test",
    "https://", "ftp://play.example.test", "https://play.example.test\"><script>"] {
    match play_endpoint(bad) {
      Ok(e) -> panic("accepted ${bad} as ${e}")
      Err(e) -> { assert str.contains(e, "not an origin") }
    }
  }
}

## History lights up for both of its pages, and the early design notes say
## whose page they are.
test "the early design notes are a page of the history" {
  assert doc_section("design") == "history"
  assert doc_section("history") == "history"
  assert doc_section("spec") == "spec"
  assert doc_crumbs("design", En, ".")[0].href == "./history.html"
  assert doc_crumbs("design", Zh, "..")[0].href == "../zh/history.html"
  assert doc_crumbs("design", Zh, "..")[1] == here("早期决定")
  let toc = [TocEntry { level: 2, id: "s1", text: "1" }, TocEntry { level: 3, id: "s1-1", text: "1.1" }]
  assert str.contains(join(doc_facts("spec", En, "0.82.0", toc, 0), ""), "v0.82.0</a></li><li class=\"chip\">1 sections")
  assert not str.contains(join(doc_facts("spec", En, "", toc, 0), ""), "0.82")
  assert doc_facts("history", Zh, "", [], 42)[1] == chip("42 条")
}

## Where the Playground's API lives, as site/build.sh hands it over in
## DAWN_SITE_PLAY_ORIGIN: "" when the variable is unset or empty, which is the
## same-origin deployment this site has always had.
##
## The variable exists because the pages and the API can no longer be assumed
## to share an origin. The static site is meant to sit behind a CDN that does
## not carry WebSocket upgrades, and `/api/lsp` is one, so the four `/api/*`
## endpoints move to an origin of their own while the pages stay where they
## are (docs/site-cdn-design.md). Read from the environment for the reason
## build_stamp is, and read once, in site/src/main.dawn, before any page is
## written.
pub fn play_origin() -> String !Env = unwrap_or(getenv("DAWN_SITE_PLAY_ORIGIN"), "")

## The run endpoint the Playground's mount point hands the editor, or why the
## origin it was built from is not an origin.
##
## Empty stays the relative `/api/run`, byte for byte what the page carried
## before the variable existed, so a build that does not set it ships the same
## site. Set, it must be a bare origin: `http(s)://` and a host, an optional
## port, and nothing after. No path and no trailing slash, because the editor
## derives `/check`, `/health` and `/lsp` by replacing the final `/run`
## (site/play-ui/src/endpoints.ts) and a path in front of `/api` would be a
## second, unwritten convention. The host is held to the characters a host
## and port can have, which is also what makes the value safe to drop into an
## attribute without escaping: nothing outside that set reaches the page.
pub fn play_endpoint(origin: String) -> Result[String, String] = {
  if origin == "" {
    Ok("/api/run")
  } else {
    let rest =
      match str.strip_prefix(origin, "https://") {
        Some(r) -> r
        None -> unwrap_or(str.strip_prefix(origin, "http://"), "")
      }
    var host_only = rest != ""
    for ch in code_points(rest) {
      let ok = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9')
        || ch == '.' || ch == '-' || ch == ':'
      if not ok {
        host_only = false
      }
    }
    if host_only {
      Ok("${origin}/api/run")
    } else {
      Err("DAWN_SITE_PLAY_ORIGIN is \"${origin}\", not an origin: want http(s)://host[:port] "
          ++ "with no path and no trailing slash")
    }
  }
}

## play_endpoint for this build, stopping the build when the origin is bad.
pub fn play_run_endpoint() -> String !Env =
  match play_endpoint(play_origin()) {
    Ok(e) -> e
    Err(e) -> panic("Playground endpoint: ${e}")
  }

## The Playground's mount point: the one element the page body holds.
pub fn play_mount(endpoint: String) -> String =
  `<div id="dawn-playground" data-endpoint="` ++ endpoint ++ `"></div>`

## The Playground, in one language. The page itself has no prose at all -- the
## body is a mount point and everything a reader sees inside it is drawn by the
## editor bundle, whose own strings are English on both sides. So the twin is
## the shell around it: nav, footer and the language switch, which is the whole
## reason it is paired. Translating the editor is a job in site/play-ui and has
## nothing to do with this generator.
##
## `endpoint` is play_run_endpoint's answer, relative or absolute.
pub fn gen_playground(out: String, a: Assets, lang: Lang, endpoint: String) -> Unit !Fs !io = {
  let (dst, root) =
    match lang {
      En -> ("${out}/playground.html", ".")
      Zh -> ("${out}/zh/playground.html", "..")
    }
  # full-width IDE page: the editor frame IS the page (no heading, no reading
  # column, nothing in the band but the nav) — .dp-page/.dp-ide layout comes
  # with the editor bundle's css
  let mount = play_mount(endpoint)
  let mount_body = `<main class="dp-page">` ++ "\n" ++ mount ++ "\n</main>"
  # the editor bundle (built from site/play-ui, copied into assets by build.sh);
  # one copy, reached from wherever the page sits
  let pcss = a.play_css
  let pjs = a.play_js
  let head = """<link rel="stylesheet" href="${root}/assets/${pcss}">""" ++ "\n" ++
    """<script type="module" src="${root}/assets/${pjs}"></script>"""
  write_page(dst,
    shell_ext(a, lang, "playground.html", "Playground — Dawn", root, "playground", head,
      no_head(), mount_body))
}

## Everything the demo page says, in one language. A record rather than two
## page templates, for the reason gen/examples gives about its own: the two
## languages sit next to each other, and a missing one is a compile error
## instead of a page that renders half-translated.
##
## `sources` carries markup; every other field is escaped text.
##
## The last three are the loading story (#321). `loading` sits under each frame
## until its demo mounts; `slow` replaces it if that takes longer than the
## watchdog waits, and says only that, because a slow network is not an
## error; `failed` leads the red line written when a fetch or a mount really
## fails, and is the only one of the three that carries the technical hint.
type TeaCopy = {
  title: String,
  lede: String,
  aside: String,
  counter: String,
  counter_note: String,
  counter_src: String,
  todo: String,
  todo_note: String,
  todo_src: String,
  sources: String,
  loading: String,
  slow: String,
  failed: String,
}

fn tea_copy(lang: Lang, root: String, counter_page: String, todo_page: String) -> TeaCopy =
  match lang {
    En -> TeaCopy {
      title: "The Elm architecture, in the browser",
      lede: "Two applications written in Dawn and compiled to WebAssembly reactors. "
        ++ "The model, the update function and the view all run inside wasm; the page "
        ++ "holds a bridge of vanilla ES modules that applies the patches the guest "
        ++ "computes. One JSON object per line crosses each way, and a DOM node never "
        ++ "does: the module is never handed an element, and the page is never handed "
        ++ "a message.",
      aside: "Both are compiled by the same command a terminal program is "
        ++ "(<code>dawn build --target wasm --reactor</code>), and both run from a "
        ++ "shell too, as a session you can type JSON at.",
      counter: "Counter",
      counter_note: "Each press is one message into the guest's <code>update</code>. "
        ++ "What comes back is one patch for the one text node that changed, and the "
        ++ "bridge edits that node and nothing else.",
      counter_src: "View the source · counter.dawn",
      todo: "Todo list",
      todo_note: "Click a title to edit it. Then open a row, leave the caret in the "
        ++ "middle of the text, and delete a row above it: the editor keeps the focus "
        ++ "and the caret does not move. The rows are keyed by id, so the reconciler "
        ++ "asks the bridge to move the element the document already has rather than "
        ++ "to rewrite it.",
      todo_src: "View the source · todo.dawn",
      sources: "Source: "
        ++ """<a href="${root}/${counter_page}"><code>tea_dom_counter</code></a>"""
        ++ " and "
        ++ """<a href="${root}/${todo_page}"><code>tea_dom_todo_keyed</code></a>"""
        ++ " in the gallery. The architecture is "
        ++ """<a href="https://github.com/dawnop/dawn-lang/tree/main/packages/tea-core">"""
        ++ "<code>packages/tea-core</code></a>, the DOM vocabulary and the wire format "
        ++ """are <a href="https://github.com/dawnop/dawn-lang/tree/main/packages/tea-dom">"""
        ++ "<code>packages/tea-dom</code></a>, and the frontend direction they belong to "
        ++ """is in the <a href="https://github.com/dawnop/dawn-lang/blob/main/ROADMAP.md">"""
        ++ "roadmap</a>.",
      loading: "Loading the demo…",
      slow: "Loading the demo is taking longer than expected…",
      failed: "The demo could not be loaded. It needs the page served over http and its "
        ++ "reactor built by site/build.sh. The error was: ",
    }
    Zh -> TeaCopy {
      title: "浏览器里的 Elm 架构",
      lede: "两个用 Dawn 写、编译成 WebAssembly reactor 的应用。模型、update 与 view 全部跑在 "
        ++ "wasm 里；页面这边是一层零依赖的 ES 模块桥，负责把 guest 算出的补丁打到文档上。"
        ++ "两边往来都是每行一个 JSON 对象，DOM 节点从不过界：模块拿不到元素，页面也拿不到消息。",
      aside: "它们和终端程序用同一条命令编译"
        ++ "（<code>dawn build --target wasm --reactor</code>），"
        ++ "也都能在 shell 里跑，变成一个可以手敲 JSON 的会话。",
      counter: "计数器",
      counter_note: "每按一次，就向 guest 的 <code>update</code> 送一条消息。"
        ++ "回来的补丁只针对变了的那个文本节点，桥也只改这一个节点。",
      counter_src: "查看源码 · counter.dawn",
      todo: "待办列表",
      todo_note: "点标题即可编辑。然后打开一行、把光标留在文字中间，再删掉它上面的一行："
        ++ "编辑框仍然有焦点，光标也不动。行以 id 为键，所以协调器让桥移动文档里已有的"
        ++ "那个元素，而不是重写它。",
      todo_src: "查看源码 · todo.dawn",
      sources: "源码：示例里的 "
        ++ """<a href="${root}/${counter_page}"><code>tea_dom_counter</code></a>"""
        ++ " 与 "
        ++ """<a href="${root}/${todo_page}"><code>tea_dom_todo_keyed</code></a>"""
        ++ "。架构在 "
        ++ """<a href="https://github.com/dawnop/dawn-lang/tree/main/packages/tea-core">"""
        ++ "<code>packages/tea-core</code></a>，DOM 词汇与传输格式在 "
        ++ """<a href="https://github.com/dawnop/dawn-lang/tree/main/packages/tea-dom">"""
        ++ "<code>packages/tea-dom</code></a>，这条前端方向本身写在"
        ++ """<a href="https://github.com/dawnop/dawn-lang/blob/main/ROADMAP.md">"""
        ++ "路线图</a>里。",
      loading: "正在加载演示……",
      slow: "演示加载得比预期慢，请稍候……",
      failed: "演示加载失败。本页需要通过 http 访问，所用的 reactor 也要先由 "
        ++ "site/build.sh 构建。错误信息：",
    }
  }

## One demo, framed: the element the bridge mounts into, the placeholder line
## shown until it does, and the line an error is reported on. `data-wasm` is
## the URL the page fetches, and it is spelled as an attribute rather than in
## the script so that gen/links checks it -- an import specifier or a `fetch`
## argument is a string in a program, and nothing here reads programs.
##
## The placeholder is a sibling of the mount point and not its content: the
## bridge owns everything inside `.tea-mount`, and the watchdog reads an empty
## one as "nothing mounted yet".
##
## The frame sits in a window whose bar names the mount point, in one of the
## dawn hues (`hue`: 1 indigo, 3 magenta). The window is drawn around the
## frame and never inside it: what is inside is what the reactor draws, and
## nothing here pretends to have drawn it first.
fn tea_frame(
  id: String,
  wasm: String,
  heading: String,
  note: String,
  loading: String,
  source: String,
  hue: Int,
) -> String =
  """
<h2>${heading}</h2>
<figure class="win tea-win hue-${hue}">
${win_bar("#${id} · wasm reactor", "")}
<div class="tea-frame">
<div class="tea-mount" id="${id}" data-wasm="${escape_attr(wasm)}"></div>
<p class="tea-status">${escape_html(loading)}</p>
<p class="tea-error"></p>
</div>
</figure>
<p class="tea-note">${note}</p>
${source}
"""

## The pure half of one demo, read out of the tree and folded away under the
## application it drives.
##
## Read at build time rather than transcribed, so the code a reader sees is the
## code the reactor above it was built from: there is one copy of it and it is
## the file. `highlight_dawn` is the gallery's highlighter and the markup is
## gen/examples.file_section's, down to the class names, because `pre.dawn` in
## the stylesheet is the same styling either way.
##
## Only the pure half: `main.dawn` is host wiring -- stdin, stdout and the
## reactor's exports -- and the point of the page above is that none of that is
## where the application lives.
fn tea_source(summary: String, path: String) -> String !Fs = {
  let src = str.trim(must_read(path))
  `<details class="tea-src"><summary>` ++ escape_html(summary) ++ "</summary>\n"
    ++ `<pre class="dawn"><code>` ++ highlight_dawn(src) ++ "</code></pre>\n</details>"
}

## Where each demo's pure half is. Named, because the whole promise of reading
## them is that these two paths are the ones the reactors were built from
## (site/build.sh builds `examples/projects/tea_dom_counter` and
## `examples/projects/tea_dom_todo_keyed`). The counter is the plain one, not
## `tea_dom_counter_contract`: the page shows the application, and the gates'
## fixtures are not part of it.
fn counter_source_path() -> String = "examples/projects/tea_dom_counter/src/counter.dawn"

fn todo_source_path() -> String = "examples/projects/tea_dom_todo_keyed/src/todo.dawn"

## The demo page, in one language.
##
## The prose is translated and the two applications are not: they are Dawn
## programs, English like the rest of the code here, and what they draw is
## `dawn counter` and `dawn todo` on both sides.
pub fn gen_tea(out: String, a: Assets, lang: Lang) -> Unit !Fs !io = {
  let (dst, root) =
    match lang {
      En -> ("${out}/tea.html", ".")
      Zh -> ("${out}/zh/tea.html", "..")
    }
  write_page(dst, tea_page(a, lang, root))
}

## The whole page as markup, without writing it -- which is what the tests
## below read, so that what they check is the document a browser gets and not
## a fragment assembled a second way.
fn tea_page(a: Assets, lang: Lang, root: String) -> String !Fs = {
  let c = tea_copy(lang, root,
    lang_path(lang, "examples/tea_dom_counter.html"),
    lang_path(lang, "examples/tea_dom_todo_keyed.html"))
  let app = a.tea_js
  let head = """<link rel="modulepreload" href="${root}/assets/${app}">"""
  # The two messages the scripts write are attributes rather than string
  # literals inside the scripts, so that they are escaped by the one rule
  # every other attribute here goes through instead of by JavaScript's.
  let slow = escape_attr(c.slow)
  let failed = escape_attr(c.failed)
  let body =
    `<main class="wrap page">` ++ "\n"
    ++ """<article class="col prose tea-demo" data-slow="${slow}" data-failed="${failed}">""" ++ "\n"
    ++ "<p>${c.aside}</p>\n"
    ++ tea_frame("tea-counter", "${root}/assets/${a.tea_counter}", c.counter, c.counter_note,
      c.loading, tea_source(c.counter_src, counter_source_path()), 1)
    ++ tea_frame("tea-todo", "${root}/assets/${a.tea_todo}", c.todo, c.todo_note,
      c.loading, tea_source(c.todo_src, todo_source_path()), 3)
    ++ `<p class="tea-note">` ++ c.sources ++ "</p>\n</article>\n</main>\n"
    ++ tea_watchdog() ++ "\n" ++ tea_mount_script(root, app)
  let what =
    match lang {
      En -> "two wasm reactors"
      Zh -> "两个 wasm reactor"
    }
  let ph = PageHead {
    crumbs: [section_crumb(lang, root, "tea", false)],
    title: c.title,
    lede: c.lede,
    meta: [chip(what)],
    extra: "",
    cls: "col",
  }
  shell_ext(a, lang, "tea.html", "${c.title} — Dawn", root, "tea", head, ph, body)
}

## The search glue's data attributes are page-relative, and search.js itself
## lives under /assets/. fetch() resolves a relative URL against the document,
## but dynamic import() resolves it against the importing module, so a raw
## `import(d.searchApp)` loads /assets/assets/... -- the panel's first
## production failure (2026-08-31). Every resource must go through the
## document-based resolver. Text-level, because nothing else in the repo
## executes this file; the mutation it is against is deleting the abs() wrap.
test "the search glue resolves every resource against the document, not itself" {
  io.with_fs_real(() => {
    let js = must_read("site/assets/search.js")
    assert str.contains(js, "new URL(u, document.baseURI)")
    assert str.contains(js, "import(abs(d.searchApp))")
    assert str.contains(js, "fetch(abs(d.searchWasm))")
    assert str.contains(js, "fetch(abs(d.searchIndex))")
    assert not str.contains(js, "import(d.searchApp)")
    assert not str.contains(js, "fetch(d.searchWasm)")
    assert not str.contains(js, "fetch(d.searchIndex)")
  })
}

## The counter's section is the counter's file. The mutations this is against
## are one-word ones: `main.dawn` sits next to `counter.dawn` in the same
## project, reads as a source file, highlights fine, and would put host wiring
## under a demo whose whole claim is that the application is pure; and
## `tea_dom_counter_contract` holds a counter.dawn too, whose gate fixtures
## are what the split into two projects took off this page.
test "the counter demo shows the plain counter.dawn and not its neighbours" {
  io.with_fs_real(() => {
    let p = tea_page(plain_assets(), En, ".")
    assert str.contains(p, `<details class="tea-src">`)
    # A doc comment of the plain counter.dawn's `encode`, which no other file in
    # either project spells.
    assert str.contains(p, "The host carries it untouched between turns")
    # main.dawn's opening lines, neither of which belongs here.
    assert not str.contains(p, "The whole io surface of the demo")
    assert not str.contains(p, "The same binary answers a")
    # The contract counter's root class and deliberate panic.
    assert not str.contains(p, "counter below-zero")
    assert not str.contains(p, "boom: update failed on purpose at n=")
  })
}

## The keyed list is the reason there are two demos rather than one, so the
## line that makes it keyed is the line worth pinning.
test "the todo demo shows todo.dawn, keyed call included" {
  io.with_fs_real(() => {
    let p = tea_page(plain_assets(), En, ".")
    assert str.contains(p, "keyed(")
    assert str.contains(p, "boom: update failed on purpose with ")
    # codec.dawn's wire format is the other half of that project and not this.
    assert not str.contains(p, "enc_editing")
    # Escaping lives inside the highlighter; emitting the raw source instead
    # stays green on every assertion above and ships broken HTML. todo.dawn's
    # comments spell `<ul>`, so the page must carry it entity-escaped.
    assert str.contains(p, "&lt;ul&gt;")
  })
}

## The window goes around the frame and nothing goes in it: the mount point
## is empty in the markup, because what fills it is what the reactor draws,
## and the watchdog reads an empty one as "nothing mounted yet". The loading
## line stays under it until the demo mounts.
test "each demo's frame sits in a window and its mount point stays empty" {
  io.with_fs_real(() => {
    let p = tea_page(plain_assets(), En, ".")
    assert str.contains(p, `<figure class="win tea-win hue-1">` ++ "\n"
        ++ `<div class="win-bar"><i></i><i></i><i></i><span class="lbl">#tea-counter · wasm reactor</span></div>`)
    assert str.contains(p, `<div class="tea-mount" id="tea-counter" data-wasm="./assets/tea-counter.wasm"></div>` ++ "\n"
        ++ `<p class="tea-status">Loading the demo…</p>`)
    assert str.contains(p, `<figure class="win tea-win hue-3">`)
    # the title and the lede are in the band; the scripts still find the page
    assert str.contains(p, `<span aria-current="page">Demo</span></nav>`)
    assert str.contains(p, `<li class="chip">two wasm reactors</li>`)
    assert str.contains(p, `<article class="col prose tea-demo" data-slow=`)
  })
}

## Both languages get both sections: the Chinese page is a twin, not a page
## with the code left out of it.
test "each language folds both sources away under its own summary" {
  io.with_fs_real(() => {
    let en = tea_page(plain_assets(), En, ".")
    let zh = tea_page(plain_assets(), Zh, "..")
    assert count_sub(en, `<details class="tea-src">`) == 2
    assert count_sub(zh, `<details class="tea-src">`) == 2
    assert str.contains(en, "<summary>View the source · counter.dawn</summary>")
    assert str.contains(en, "<summary>View the source · todo.dawn</summary>")
    assert str.contains(zh, "<summary>查看源码 · counter.dawn</summary>")
    assert str.contains(zh, "<summary>查看源码 · todo.dawn</summary>")
    # Folded away: `<details>` with no `open` is closed, and the page says so by
    # not saying anything.
    assert not str.contains(en, `<details class="tea-src" open>`)
    # The gallery links stay where they were.
    assert str.contains(en, `<a href="./examples/tea_dom_counter.html">`)
    assert str.contains(zh, `<a href="../zh/examples/tea_dom_todo_keyed.html">`)
  })
}

fn count_sub(hay: String, needle: String) -> Int = len(str.split(hay, needle)) - 1

## #321, as text: the page's scripts are the one part of it nothing here runs,
## so what is pinned is the shape a regression would have to undo. The
## mutations this is against: the sequential `for ... await` loop coming back,
## the watchdog writing into the red error line again, and the developer's
## hint moving back into the slow-network notice.
test "the demos load in parallel and a slow network is not reported as an error" {
  io.with_fs_real(() => {
    for lang in [En, Zh] {
      let p = tea_page(plain_assets(), lang, ".")
      assert str.contains(p, "await Promise.all(frames.map(async (f) => {")
      assert not str.contains(p, "for (const host of")
      # a placeholder under each frame until it mounts, cleared when it does
      assert count_sub(p, `<p class="tea-status">`) == 2
      assert str.contains(p, "if (f.status) f.status.textContent = '';")
      # the watchdog only ever touches the placeholder line
      assert str.contains(p, "status.textContent = slow;")
      assert not str.contains(p, "banner.textContent = slow")
      # the technical hint is in the failure text and not in the slow one
      let c = tea_copy(lang, ".", "a", "b")
      assert not str.contains(c.slow, "site/build.sh")
      assert str.contains(c.failed, "site/build.sh")
    }
  })
}

## The slow-network notice. A classic script, so that it runs even when the
## module below has not arrived yet: after four seconds, every frame whose
## mount point is still empty and which has not reported an error trades its
## placeholder for the page's `data-slow` text. That is all it says. It used to
## write a developer's diagnosis into the red error line instead, and nothing
## ever cleared it, so a slow connection got a false error that stayed on the
## page after the demo had mounted under it (#321).
fn tea_watchdog() -> String =
  """
<script>
window.__teaWatchdog = setTimeout(function () {
  var slow = document.querySelector('.tea-demo').dataset.slow;
  document.querySelectorAll('.tea-mount').forEach(function (host) {
    var status = host.parentElement.querySelector('.tea-status');
    var banner = host.parentElement.querySelector('.tea-error');
    if (host.childNodes.length === 0 && status && banner && banner.textContent === '') {
      status.textContent = slow;
    }
  });
}, 4000);
</script>
"""

## Mount every frame on the page: fetch the reactor named on the element,
## hand it to the bridge, and report a failed turn on that frame's own line.
##
## The frames load in parallel. They used to be a `for` loop that awaited one
## fetch and mount before starting the next, about 160 KB gzipped each, so the
## second demo waited for the whole of the first. A frame that mounts clears
## its own placeholder and its own error line; a frame that fails replaces the
## placeholder with the page's `data-failed` text and the error itself, which
## is the one place the technical hint belongs.
##
## The bridge is a dynamic import inside the `try` rather than a static import
## above it: a static import that fails stops the module before any of its
## code runs, which would leave the page with nothing to say about it.
fn tea_mount_script(root: String, app: String) -> String =
  """
<script type="module">
const failed = document.querySelector('.tea-demo').dataset.failed;
const frames = [...document.querySelectorAll('.tea-mount')].map((host) => ({
  host,
  status: host.parentElement.querySelector('.tea-status'),
  banner: host.parentElement.querySelector('.tea-error'),
}));
const fail = (f, e) => {
  if (f.status) f.status.textContent = '';
  f.banner.textContent = failed + String(e);
};
try {
  const { mount } = await import('${root}/assets/${app}');
  await Promise.all(frames.map(async (f) => {
    try {
      const res = await fetch(f.host.dataset.wasm);
      if (!res.ok) throw new Error('HTTP ' + res.status + ' for ' + f.host.dataset.wasm);
      f.banner.textContent = '';
      await mount(res, f.host, {
        onError: (reply) => { f.banner.textContent = reply.kind + ': ' + reply.error; },
      });
      if (f.status) f.status.textContent = '';
    } catch (e) {
      fail(f, e);
    }
  }));
} catch (e) {
  frames.forEach((f) => fail(f, e));
}
clearTimeout(window.__teaWatchdog);
</script>
"""

# Scope-polymorphic values keep source arity and cannot identify rigid domains.
use std/mem
fn arity(f: fn[@s]() -> Int) -> Int = f(1)
fn domains[@s,@t](a: I64Buf@s, b: I64Buf@t,
  f: fn[@u](I64Buf@u, I64Buf@u) -> Int) -> Int = f(a, b)

# A callback's private Scope cannot instantiate the callee's outer Scope slot.
fn consume[@outside](f: fn[@inside]() -> I64Buf@outside !mem.Mem[inside]) -> Unit = ()
fn escape_argument() -> Unit = consume([@created] () => mem.new(1))

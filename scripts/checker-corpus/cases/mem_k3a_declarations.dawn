# Domain arguments are reserved for the actual memory effect declaration.
use std/mem
use std/mem.{Mem}
effect Wrong[@s] { fn wrong() -> Int }
effect Plain { fn plain() -> Int }
fn row[@s]() -> Unit !Plain[s] = ()
fn missing(b: I64Buf) -> Unit = ()
fn bare() -> Unit !Mem = ()
fn qualified() -> Unit !mem.Mem = ()

# General application as a postfix (SYN-02): a call result, a conditional's
# result and any parenthesized function value can be applied directly. These
# were syntax errors until 2026-07-30. Since the unification knife every call
# parses here, `f(x)` and `Circle(1.0)` included -- what this corpus pins is
# the forms that only this arm can parse, on both backends.
fn add(a: Int) -> fn(Int) -> Int = b => a + b

fn pick(c: Bool) -> fn(Int) -> Int =
  if c { x => x * 2 } else { x => x + 100 }

pub fn main() -> Unit !io = {
  println("${add(3)(4)}")
  println("${(if true { (x: Int) => x * 2 } else { (x: Int) => x + 100 })(21)}")
  println("${pick(false)(1)}")
}

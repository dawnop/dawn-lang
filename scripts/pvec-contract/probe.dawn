# The driver half of the persistent-vector contract test. The comparisons are
# in pveccheck.dawn, which the harness copies into a std/ of its own because
# `use std/pvec` is a compile error outside std (audit RD-06); this file is an
# ordinary user module and only prints what that one found.
use std/io
use std/list
use std/pveccheck

pub fn main() -> Unit !io = {
  let bad = pveccheck.run_all()
  for b in list.take(bad, 10) { println("FAIL " ++ b) }
  println("mismatches ${len(bad)}")
}

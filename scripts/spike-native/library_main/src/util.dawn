# A library module with a function named `main` that is not an entry point
# (spec §10.5, SPC-04). Loaded before the entry in dependency order, which is
# where the backends used to look for the program's `main` first.
fn main(x: Int) -> Int = x * 2

pub fn doubled(x: Int) -> Int = main(x)

pub fn main_again() -> Int = main(5)

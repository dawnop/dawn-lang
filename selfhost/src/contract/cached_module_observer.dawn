# Host-owned mutable observation stays outside the shared compiler closure.
# Fresh query probes distinguish retaining the current oracle from accidentally
# carrying the previous generation's context through a successful body hit.
#
# A module of the compiler package because checker state is `pub(pkg)`; it
# moved here from scripts/incremental-semantics-contract/src. Nothing in
# main.dawn or nmain.dawn imports contract/, so `dawn test selfhost` runs it
# and neither driver links it.

use java "java.lang.StringBuilder"
use front/parser
use driver/analyze
use driver/analyze.{LoadedModule}
use driver/fsmem
use driver/stdlib.{load_std}
use ir/interp.{ct_default}
use jvm/jreflect.{jsig_real, query_probe}
use compiler_plan/envmem

test "cached module observer order and current Java oracle survive warm hits" {
  let _ = fsmem.with_fs_mem(fsmem.mem_std(fsmem.MEM_BASE), () => {
    let _ = envmem.with_env_table(fsmem.MEM_BASE, [], () => {
      let std = match load_std(fsmem.mem_std_dir(fsmem.MEM_BASE)) {
        Ok(value) -> value
        Err(_) -> panic("fixture std failed to load")
      }
      let baseline = analyze.initial_carry_with_provenance(std, "observer-test")
      let text = "fn value() -> Int = 42\n"
      let (syntax, pd) = parser.parse_module(text)
      let input = LoadedModule { mod_path: "observer", class_name: "observer",
        path: "/observer.dawn", text: text, m: syntax, pdiags: pd, pkg: None, entry: false }
      let old = query_probe(jsig_real())
      let first = analyze.analyze_module_step_cached(input, baseline, std, ct_default(), old.jsig, None, None)
      assert first.counts.expect("first counts").reused == 0
      let current = query_probe(jsig_real())
      let events = StringBuilder.new()
      let observer: analyze.AnalysisObserver = (name, stage, entering) => {
        let code = match stage {
          analyze.AnalyzeModule -> "M"
          analyze.AnalyzeCheck -> "C"
          analyze.AnalyzeComptime -> "T"
        }
        let _ = events.append(name ++ code ++ if entering { "+;" } else { "-;" })
        ()
      }
      let warm = analyze.analyze_module_step_cached(input, baseline, std, ct_default(), current.jsig,
        Some(observer), first.cache)
      assert warm.counts.expect("warm counts").reused == 1
      let expected = "observerM+;observerC+;observerC-;observerT+;observerT-;observerM-;"
      assert events.toString() == Some(expected)
      let cold = analyze.analyze_module_step(input, baseline, std, ct_default(), current.jsig, Some(observer))
      assert events.toString() == Some(expected ++ expected)
      assert warm.step.diags == [] && warm.step.checked.tm == cold.checked.tm
      assert warm.step.checked.ct == cold.checked.ct && warm.step.after == cold.after
      assert old.queries() == 0 && current.queries() == 0
      assert warm.step.checked.cx.jsig.on
      let answer = warm.step.checked.cx.jsig.find_class("java.lang.String")
      assert answer != None
      assert current.queries() == 1 && old.queries() == 0
    })
    ()
  })
}

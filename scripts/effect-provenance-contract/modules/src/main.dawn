use std/io.{println}
use std/provenance
use model.{Counter, make}
use library.{through}
pub fn main() -> Unit !io = {
  let before = make()
  let (value, tree) = provenance.observe(scope => {
    let value = through(Counter { value = 4 }, before)
    (value, provenance.completed(scope))
  })
  println("${value}")
  println(tree)
}

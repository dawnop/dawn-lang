# EBNF const_decl / test_decl, plus comptime and a qualified type/pattern
# (LANG-06, added 2026-07-30).
use json/value as v

pub const LIMIT: Int = 10
const FOLDED: Int = comptime { 2 * 21 }

fn qualified(j: v.Json) -> String =
  match j {
    v.JStr(s) -> s
    _ -> ""
  }

test "a test block is a top-level declaration" {
  assert LIMIT == 10
  assert FOLDED == 42
}

-- length is in code points --
str.len            = 4
str.len ascii      = 3
-- search reports a code-point index --
index_of 中        = 2
index_of missing   = none
index_of empty     = 0
last_index_of l    = 3
last_index_of miss = none
last_index_of ''   = 5
-- predicates --
contains           = true
starts_with        = true
ends_with          = true
ends_with false    = false
-- trimming and case --
trim               = [hi]
trim nothing       = [hi]
trim all           = []
lower              = mixed 42
upper              = MIXED 42
-- classification --
is_letter a        = true
is_digit a         = false
is_space tab       = true
is_space ideo      = true
is_space nbsp      = false
-- parsing --
parse_int          = 42
parse_int signed   = -42
parse_int spaced   = 7
parse_int min      = -9223372036854775808
parse_int over     = none
parse_int junk     = none
parse_int empty    = none
radix 16           = 255
radix 2            = 11
radix bad digit    = none
-- code points --
code_points        = ['a', 'é', '中']
round trip         = aé中𝄞
from_code_points   = hi
join               = a-b-c
join empty sep     = ab
join one           = only
-- str.slice clamps (spec 4.8, criterion 3) --
sub in range       = é中
sub to past end    = 中𝄞
sub from past end  = []
sub from > to      = []
sub negative from  = aé
sub negative both  = []
-- affixes (spec 4.8, criterion 2) --
strip_prefix       = [中𝄞]
strip_prefix miss  = none
strip_prefix all   = []
strip_prefix ''    = [ab]
strip_suffix       = [main]
strip_suffix miss  = none
strip_suffix wide  = [aé]
strip_suffix ''    = [ab]
-- take/drop clamp, at asserts --
take               = [aé]
take past end      = [aé中𝄞]
take negative      = []
drop               = [中𝄞]
drop past end      = []
drop negative      = [aé中𝄞]
at 0               = 97
at astral          = 119070
-- one-sided trims and pad_end --
trim_start         = [hi  ]
trim_end           = [  hi]
trim_start all     = []
trim_end all       = []
pad_start          = [0007]
pad_end            = [7000]
pad_end cycles     = [7ababa]
pad_end wide       = [x中中]
pad_end no room    = [hello]
pad_end no filler  = [hi]
-- the Int <-> Cursor bridge --
offset of at 2     = 2
slice at 1..3      = [é中]
at past end        = 4
at negative        = 0
offset of end      = 4
offset of start    = 0
offset empty       = 0
char at astral     = 119070
-- bytes --
bytes_len          = 10
bytes_at 0         = 97
bytes_at oob       = -1
decode_utf8        = aé中𝄞
decode_latin1 len  = 10
-- the barrier --
try missing file   = err
try ok             = ok

-- flat, at every arity the language has --
(1, 4)
(1, 2, 3)
(1, 2, 3, 4, 5)
-- bound first, which is the issue's second reproduction --
(1, 4)
-- nested --
(1, (2, 3))
((1, 2), (3, (4, 5)))
-- a String is quoted here, as it is in any nested position --
(1, "a")
("a", "b")
-- the elements are shown by their own rule, not by the tuple's --
(Point(1, 2), 'x', 1.5, true)
(Some(1), None)
-- inside a container, and one around a container --
[(1, 2), (3, 4)]
([1, 2], "x")
-- through a generic consumer, which is the route that worked --
(1, 4)
(1, ("a", 2))
[(1, "a")]
-- and one whose subject is not ground --
(1, "a")
(1, Point(0, 0))
(1, (2, 3))

}

test "semantic reads project unification bindings in independent domains" {
  let before = InferenceBindings { types: [(1, TyAdt(1, []))], effects: [(1, EffVar("e", 1))] }
  let after = InferenceBindings { types: [(1, TyAdt(2, []))], effects: [(1, EIo)] }
  let q = UnificationRead { declared: TyAdt(1, []), actual: TyAdt(2, []), before: before, after: after, matched: false }
  let move: fn(Ty) -> Option[Ty] = t => match t { TyAdt(id, args) -> Some(TyAdt(id + 10, args)), _ -> None }
  let row: fn(Eff) -> Option[Eff] = e => match e { EffVar(n, id) -> Some(EffVar(n, id + 20)), _ -> Some(e) }
  let reads = Some([UnifiedTypes(q)])
  assert project_with_inference(reads, s => None, move, id => None, row, (owner, source) => None,
    id => None, id => Some(id + 30), id => None, id => Some(id + 40)) == Some(Some([
      UnifiedTypes(UnificationRead { declared: TyAdt(11, []), actual: TyAdt(12, []),
        before: InferenceBindings { types: [(31, TyAdt(11, []))], effects: [(41, EffVar("e", 21))] },
        after: InferenceBindings { types: [(31, TyAdt(12, []))], effects: [(41, EIo)] }, matched: false })]))
  for missing in [0, 1, 2, 3] {
    assert project_with_inference(reads, s => None, t => if missing == 0 { None } else { move(t) }, id => None,
      e => if missing == 1 { None } else { row(e) }, (owner, source) => None, id => None,
      id => if missing == 2 { None } else { Some(id) }, id => None,
      id => if missing == 3 { None } else { Some(id) }) == None
  }
}

test "semantic reads relocate type effect reduction inputs bindings and answers" {
  let reads = Some([ReducedTypeEffects(TyAdt(1, []), [(1, TyAdt(2, []))], TyAdt(3, []))])
  let move: fn(Ty) -> Option[Ty] = t => match t { TyAdt(id, args) -> Some(TyAdt(id + 10, args)), _ -> None }

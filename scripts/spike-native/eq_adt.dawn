# Structural equality. spec 4.3 defines `==` for every type except functions,
# so two independently built values of the same shape are equal -- there is no
# impl to write and nothing to opt into.
#
# This is the one relation Core does not carry. `resolve_eq_witness` returns
# no witness for a concrete type with no impl, lowering emits a bare
# `CBinary(CEq, ..)`, and each backend decides for itself what that means:
# `Object.equals` on the JVM, C's `==` on native. Nothing in Core says which
# is right, so the two backends are free to disagree -- and they do.
#
# Printing is deliberately spelled out with if/else rather than `to_string`:
# rendering is show_derive.dawn's job, and mixing the two would let one
# defect mask the other.
use std/io

pub type Point = | Point(x: Int, y: Int)

pub type Shape =
  | Circle(r: Int)
  | Rect(w: Int, h: Int)
  | Origin

pub type Tree =
  | Leaf
  | Node(left: Tree, v: Int, right: Tree)

pub type Rec = { name: String, at: Point }

fn yn(label: String, b: Bool) -> String =
  label ++ ": " ++ (if b { "yes" } else { "no" })

fn leaf(v: Int) -> Tree = Node(Leaf, v, Leaf)

pub fn main() -> Unit !io = {
  println("-- constructors with fields --")
  let a = Point(1, 2)
  let b = Point(1, 2)
  let c = Point(1, 3)
  println(yn("Point(1,2) == Point(1,2)", a == b))
  println(yn("Point(1,2) == Point(1,3)", a == c))
  println(yn("Point(1,2) != Point(1,3)", a != c))

  println("-- several arms, including a nullary one --")
  println(yn("Circle(3) == Circle(3)", Circle(3) == Circle(3)))
  println(yn("Circle(3) == Rect(3,3)", Circle(3) == Rect(3, 3)))
  println(yn("Rect(2,5) == Rect(2,5)", Rect(2, 5) == Rect(2, 5)))
  println(yn("Origin    == Origin   ", Origin == Origin))
  println(yn("Origin    == Circle(0)", Origin == Circle(0)))

  println("-- recursive shapes --")
  let t1 = Node(leaf(1), 2, leaf(3))
  let t2 = Node(leaf(1), 2, leaf(3))
  let t3 = Node(leaf(1), 2, Leaf)
  println(yn("Node(..) == Node(..) deep", t1 == t2))
  println(yn("Node(..) == shallower   ", t1 == t3))

  println("-- records --")
  println(yn("Rec == Rec", Rec { name: "o", at: Point(0, 0) } ==
    Rec { name: "o", at: Point(0, 0) }))
  println(yn("Rec != Rec (field)", Rec { name: "o", at: Point(0, 0) } !=
    Rec { name: "o", at: Point(0, 1) }))

  # Option and tuples only. Lists would pull in a collection literal, which
  # the native backend cannot emit until D1-D3, and this corpus has to reach
  # the C compiler to be worth anything.
  println("-- nested in the shapes the compiler itself compares --")
  let some_a: Option[Point] = Some(a)
  let some_b: Option[Point] = Some(b)
  let none_p: Option[Point] = None
  println(yn("Some(P) == Some(P)", some_a == some_b))
  println(yn("Some(P) == None   ", some_a == none_p))
  println(yn("(P,1) == (P,1)    ", (a, 1) == (b, 1)))
  println(yn("(P,1) == (P,2)    ", (a, 1) == (b, 2)))
}

## Observation exports frozen facts; text is an explicit rendering choice.
# Private bytes contain compact copied dynamic words, never live scope or pool
# pointers. Static tables share immutable metadata. Public getters materialize
# only the requested Dawn value and cannot consult execution state.
## Lexical capability for the creating observe callback.
pub opaque type TraceScope = Int
alias SiteFields = ((Int, Int, Int, Int, Int), (String, String, String, String, String))
alias DefinitionFields = (Int, String, String, Int, Int, String)
## Immutable shared source site and definition metadata.
pub opaque type StaticTable = (Array[SiteFields], Array[DefinitionFields])
## Frozen effect origin and its ancestor chain.
pub opaque type Origin = (Bytes, StaticTable, Int, String)
## Immutable copy of visible records and notes at completion.
pub opaque type TraceSnapshot = (Bytes, StaticTable, Array[Origin])
## Typed scalar access to the records of one frozen snapshot.
pub opaque type RecordView = TraceSnapshot
## Optional record or static table index; inspect before reading its value.
pub opaque type IndexSlot = Int
## Scope owned rollback mark, valid only in its creating scope.
pub opaque type Checkpoint = String

## Logical invocation identity, including its scope and creation epoch.
pub type InvocationKey = { scope: Int, epoch: Int, instance: Int }
## Frozen lifecycle state of a logical invocation.
pub type CallState = Active | Returned | Unwound | Suspended | Abandoned
## Whether the recorded segment has known Dawn source metadata.
pub type Boundary = Known | UnknownBoundary
## Whether capacity retained the entire visible history.
pub type Completeness = Complete | Truncated
## Frozen snapshot header and visible record and note counts.
pub type SnapshotInfo = { scope: Int, epoch: Int, records: Int, notes: Int, completeness: Completeness }
## One typed logical call record with optional metadata indices.
pub type CallRecord = {
  key: InvocationKey,
  parent: Option[Int],
  state: CallState,
  site: Option[Int],
  definition: Option[Int],
  boundary: Boundary
}
## Static source span, declaration, role and optional performed operation.
pub type Site = {
  id: Int, module: String, file: String, declaration: String,
  start: Int, end: Int, name_start: Int, name_end: Int,
  role: String, operation: Option[String]
}
## Static identity and declaration span of a logical callee.
pub type Definition = { id: Int, module: String, declaration: String, start: Int, end: Int, role: String }

## The literal body receives a lexical capability, never a first class handle.
pub fn observe[T, !e](body: fn(TraceScope) -> T !e, capacity: Int = 1048576) -> T !io !e = todo()
## Append a frozen effect origin to this scope subject to its note capacity.
pub fn note(scope: TraceScope, origin: Origin) -> Unit !io = todo()
## Freeze the visible prefix now, including active calls and immutable notes.
pub fn completed(scope: TraceScope) -> TraceSnapshot !io = todo()
## Save the visible prefix and active stack for a lexical rollback.
pub fn checkpoint(scope: TraceScope) -> Checkpoint !io = todo()
## Restore a checkpoint prefix and start a new epoch without refilling capacity.
pub fn rewind(scope: TraceScope, checkpoint: Checkpoint) -> Unit !io = todo()

fn snapshot_rep(value: TraceSnapshot) -> (Bytes, StaticTable, Array[Origin]) = value
fn origin_rep(value: Origin) -> (Bytes, StaticTable, Int, String) = value
fn table_rep(value: StaticTable) -> (Array[SiteFields], Array[DefinitionFields]) = value

fn optional_index(index: Int) -> Option[Int] = if index < 0 { None } else { Some(index) }
fn call_state(value: Int) -> CallState = match value {
  0 -> Active, 1 -> Returned, 2 -> Unwound, 3 -> Suspended, 4 -> Abandoned,
  _ -> panic("provenance: invalid frozen call state")
}
fn completeness(value: Int) -> Completeness = if value == 0 { Complete } else { Truncated }
fn boundary(value: Int) -> Boundary = if value == 0 { Known } else { UnknownBoundary }

## Read the immutable scope, epoch, counts and completeness header.
pub fn snapshot_info(snapshot: TraceSnapshot) -> SnapshotInfo = {
  let (data, _table, notes) = snapshot_rep(snapshot)
  SnapshotInfo { scope = word(data, 0), epoch = word(data, 1), records = word(data, 2),
    notes = array_len(notes), completeness = completeness(word(data, 3)) }
}
## Share the immutable site and definition tables of this snapshot.
pub fn static_table(snapshot: TraceSnapshot) -> StaticTable = {
  let (_data, table, _notes) = snapshot_rep(snapshot)
  table
}
## Materialize a record; return None for an index outside the frozen prefix.
pub fn record_at(snapshot: TraceSnapshot, index: Int) -> Option[CallRecord] = {
  let (data, _table, _notes) = snapshot_rep(snapshot)
  if index < 0 || index >= word(data, 2) { return None }
  let at = 4 + index * 7
  Some(CallRecord {
    key = InvocationKey { scope = word(data, 0), epoch = word(data, at), instance = word(data, at + 1) },
    parent = optional_index(word(data, at + 2)), state = call_state(word(data, at + 3)),
    site = optional_index(word(data, at + 4)), definition = optional_index(word(data, at + 5)),
    boundary = boundary(word(data, at + 6))
  })
}
## Materialize a static site; return None for an out of range index.
pub fn site_at(table: StaticTable, index: Int) -> Option[Site] = {
  let (sites, _definitions) = table_rep(table)
  if index < 0 || index >= array_len(sites) { return None }
  let ((id, start, end, name_start, name_end), (owner, file, declaration, role, op)) = array_get(sites, index)
  Some(Site { id = id, module = owner, file = file, declaration = declaration,
    start = start, end = end, name_start = name_start, name_end = name_end, role = role,
    operation = if op == "" { None } else { Some(op) } })
}
## Materialize a definition; return None for an out of range index.
pub fn definition_at(table: StaticTable, index: Int) -> Option[Definition] = {
  let (_sites, definitions) = table_rep(table)
  if index < 0 || index >= array_len(definitions) { return None }
  let (id, owner, declaration, start, end, role) = array_get(definitions, index)
  Some(Definition { id = id, module = owner, declaration = declaration,
    start = start, end = end, role = role })
}
## Scalar scans retain the same frozen facts without materializing rows.
pub fn records(snapshot: TraceSnapshot) -> RecordView = snapshot
## Return the number of frozen rows in a bulk view.
pub fn record_count(view: RecordView) -> Int = header(view, 2)
## Return the owning scope identity of every row in this view.
pub fn record_scope(view: RecordView) -> Int = header(view, 0)
## Check whether a row index belongs to this frozen view.
pub fn record_exists(view: RecordView, row: Int) -> Bool = row >= 0 && row < header(view, 2)
## Read the creation epoch of a valid frozen row.
pub fn record_epoch(view: RecordView, row: Int) -> Int = column(view, row, 0)
## Read the logical invocation identity of a valid frozen row.
pub fn record_instance(view: RecordView, row: Int) -> Int = column(view, row, 1)
## Read the optional parent row index, without materializing a record.
pub fn record_parent(view: RecordView, row: Int) -> IndexSlot = column(view, row, 2)
## Read the frozen lifecycle state of a valid row.
pub fn record_state(view: RecordView, row: Int) -> CallState = call_state(column(view, row, 3))
## Read the optional static site index of a valid row.
pub fn record_site(view: RecordView, row: Int) -> IndexSlot = column(view, row, 4)
## Read the optional static definition index of a valid row.
pub fn record_definition(view: RecordView, row: Int) -> IndexSlot = column(view, row, 5)
## Read whether a valid row crosses an unknown external segment.
pub fn record_boundary(view: RecordView, row: Int) -> Boundary = boundary(column(view, row, 6))
fn index_int(slot: IndexSlot) -> Int = slot
## Check whether an optional index has a value.
pub fn index_present(slot: IndexSlot) -> Bool = index_int(slot) >= 0
## Read a present index; panic with a deterministic message if it is absent.
pub fn index_value(slot: IndexSlot) -> Int = {
  let value = index_int(slot)
  if value < 0 { panic("provenance: missing index") } else { value }
}
## Return an immutable note, or None outside the note sequence.
pub fn note_at(snapshot: TraceSnapshot, index: Int) -> Option[Origin] = {
  let (_data, _table, notes) = snapshot_rep(snapshot)
  if index < 0 || index >= array_len(notes) { None } else { Some(array_get(notes, index)) }
}
## Find a row by its full scope, creation epoch and invocation key.
pub fn find_instance(snapshot: TraceSnapshot, key: InvocationKey) -> Option[Int] = {
  let (data, _table, _notes) = snapshot_rep(snapshot)
  if key.scope != word(data, 0) { return None }
  var lo = 0
  var hi = word(data, 2)
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let id = word(data, 4 + mid * 7 + 1)
    if id < key.instance { lo = mid + 1 } else { hi = mid }
  }
  if lo < word(data, 2) && word(data, 4 + lo * 7 + 1) == key.instance && word(data, 4 + lo * 7) == key.epoch {
    Some(lo)
  } else { None }
}
## Explicitly render a frozen snapshot as deterministic diagnostic text.
pub fn render_snapshot(snapshot: TraceSnapshot) -> String = todo()
## Explicitly render a frozen origin and ancestor chain as diagnostic text.
pub fn render_origin(origin: Origin) -> String = todo()

## Read the performed operation name stored with an origin.
pub fn operation(origin: Origin) -> String = { let (_data, _table, _row, op) = origin_rep(origin)
  op }
## Return the next frozen ancestor, or None at the root.
pub fn parent(origin: Origin) -> Option[Origin] = {
  let (data, table, row, op) = origin_rep(origin)
  let p = word(data, 4 + row * 7 + 2)
  if p < 0 { None } else { Some((data, table, p, op)) }
}
## Read the origin scope identity.
pub fn scope(origin: Origin) -> Int = { let (data, _table, _row, _op) = origin_rep(origin)
  word(data, 0) }
## Read the origin invocation creation epoch.
pub fn epoch(origin: Origin) -> Int = { let (data, _table, row, _op) = origin_rep(origin)
  word(data, 4 + row * 7) }
## Read the origin logical invocation identity.
pub fn instance(origin: Origin) -> Int = { let (data, _table, row, _op) = origin_rep(origin)
  word(data, 4 + row * 7 + 1) }
## Return the origin static site when the segment is known.
pub fn site(origin: Origin) -> Option[Site] = {
  let (data, table, row, _op) = origin_rep(origin)
  site_at(table, word(data, 4 + row * 7 + 4))
}
## Return the origin callee definition when it is known.
pub fn definition(origin: Origin) -> Option[Definition] = {
  let (data, table, row, _op) = origin_rep(origin)
  definition_at(table, word(data, 4 + row * 7 + 5))
}
## Read the frozen lifecycle state of the origin invocation.
pub fn state(origin: Origin) -> CallState = { let (data, _table, row, _op) = origin_rep(origin)
  call_state(word(data, 4 + row * 7 + 3)) }
## Read whether this origin crosses an unknown external segment.
pub fn origin_boundary(origin: Origin) -> Boundary = { let (data, _table, row, _op) = origin_rep(origin)
  boundary(word(data, 4 + row * 7 + 6)) }
## Read whether the origin ancestor capture exhausted capacity.
pub fn origin_completeness(origin: Origin) -> Completeness = { let (data, _table, _row, _op) = origin_rep(origin)
  completeness(word(data, 3)) }

# Named intrinsics preserve an ordinary seed-readable declaration surface.
fn word(data: Bytes, index: Int) -> Int = todo()
fn header(view: RecordView, field: Int) -> Int = todo()
fn column(view: RecordView, row: Int, field: Int) -> Int = todo()

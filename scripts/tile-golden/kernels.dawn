    let (p, _e) = trace2("global_scratch", Shared(F64), Shared(F64), global_scratch)
    p
  }
  "global_flags" -> {
    let (p, _e) = trace2("global_flags",
      In(F64, one_cell([GLOBAL_TILE])), Out(F64, one_cell([2 * GLOBAL_TILE])), global_flags)
    p
  }
  "global_syms" -> {
    let (p, _e) = trace2("global_syms",
      In(F64, one_cell([GLOBAL_TILE])), Out(F64, cells([3 * GLOBAL_TILE], [4 * GLOBAL_TILE])), global_syms)
    p
  }
  "alloca_scratch" -> {
    let (p, _e) = trace2("alloca_scratch", Shared(F64), Shared(F64), alloca_scratch)
    p
  }
  "alloca_two" -> {
    let (p, _e) = trace2("alloca_two", Shared(F64), Shared(F64), alloca_two)
    p
  }
  "alloca_ctl" -> {
    let (p, _e) = trace2("alloca_ctl",
      In(F64, run_of(ALLOCA_TILE)), Out(F64, run_of(ALLOCA_TILE)), alloca_ctl)
    p
  }
  "mmaf_scaled_e4m3" -> {
    let (p, _e) = trace5("mmaf_scaled_e4m3",
      In(F8E4M3FN, one_cell([MMS_M, MMS_K])), In(F8E4M3FN, one_cell([MMS_K, MMS_N])),
      In(F8E8M0FNU, one_cell([MMS_M, MMS_K / MMS_V])), In(F8E8M0FNU, one_cell([MMS_K / MMS_V, MMS_N])),
      Out(F64, one_cell([MMS_M, MMS_N])), mmaf_scaled_e4m3)
    p
  }
  "hint_entry" -> {
    let (p, _e) = trace3("hint_entry",
      In(F64, run_of(128)), In(F64, run_of(128)), Out(F64, run_of(128)), hint_entry,
      hints: hint_entry_hints())
    p
  }
  "view_transpose" -> {
    let (p, _e) = trace2("view_transpose", In(F64, Whole), Shared(F64), view_transpose)
    p
  }
  "view_max_pool" -> {
    let (p, _e) = trace2("view_max_pool",
      In(F64, Whole), Out(F64, cells([vm_oh(), vm_ow()], [VM_TILE, VM_TILE])), view_max_pool)
    p
  }
  "view_conv2d" -> {
    let (p, _e) = trace3("view_conv2d",
      In(F64, Whole), In(F64, Whole), Out(F64, cells([vc_oh(), vc_ow()], [VC_TILE, VC_TILE])), view_conv2d)
    p
  }
  "view_padding" ->
    trace_kernel("view_padding",
      ["f32", "f32", "f32", "f32", "f32", "f32"],
      () => view_padding(param(F32, 0), param(F32, 1), param(F32, 2), param(F32, 3), param(F32, 4), param(F32, 5)))
  "view_dyn_transpose" -> {
    let (p, _e) = trace3("view_dyn_transpose",
      In(I32, Whole), In(F64, Whole), Shared(F64), view_dyn_transpose)
    p
  }
  "view_tensor_shape" -> {
    let (p, _e) = trace4("view_tensor_shape",
      In(I32, Whole), In(F64, Whole), Shared(F64), Shared(I32), view_tensor_shape)
    p
  }
  "view_conv1d" -> {
    let (p, _e) = trace3("view_conv1d",
      In(F64, Whole), In(F64, Whole), Out(F64, cells([vs_out()], [1])), view_conv1d)
    p
  }
  "view_token_embed" -> {
    let (p, _e) = trace3("view_token_embed",
      In(I32, cells([VG_N], [VG_TILE])), In(F64, Whole), Out(F64, cells([VG_N, VG_DIM], [VG_TILE, VG_DIM])),
      view_token_embed)
    p
  }
  "view_atomic" ->
    trace_kernel("view_atomic",
      ["i32", "i32", "f64", "i32", "i32", "i32", "i32", "i32", "i32", "i32"],
      () => view_atomic(param(I32, 0), param(I32, 1), param(F64, 2), param(I32, 3),
        param(I32, 4), param(I32, 5), param(I32, 6), param(I32, 7), param(I32, 8),
        param(I32, 9)))
  "view_atomic_bf16" -> {
    let (p, _e) = trace2("view_atomic_bf16", In(I32, Whole), Shared(BF16), view_atomic_bf16)
    p
  }
  "view_stride_pad" -> {
    let (p, _e) = trace2("view_stride_pad",
      In(F32, Whole), Out(F32, cells([ve_out()], [VE_TILE])), view_stride_pad)
    p
  }
  "view_gather_pad" -> {
    let (p, _e) = trace3("view_gather_pad",
      In(I32, cells([VF_ROWS], [VF_TILE])), In(F32, Whole),
      Out(F32, cells([VF_ROWS, VF_GCOLS], [VF_TILE, VF_GCOLS])), view_gather_pad)
    p
  }
  "view_index_space" -> {
    let (p, _e) = trace4("view_index_space",
      In(I32, Whole), In(F64, Whole), Out(F64, one_cell([VD_SUM_TILE, VD_SUM_TILE])), Out(I32, one_cell([2])),
      view_index_space)
    p
  }
  "view_pad_i32" -> {
    let (p, _e) = trace2("view_pad_i32", In(I32, Whole), Out(I32, cells([VP_OUT], [VP_TILE])), view_pad_i32)
    p
  }
  "hint_memory" -> {
    let (p, _e) = trace3("hint_memory", In(F64, Whole), In(F64, Whole), Shared(F64), hint_memory)
    p
  }
  _ -> panic("tile-golden: no kernel named `${name}`")
}

# Trace `name` twice and answer the record, or panic if the two runs differ.
fn trace_twice(name: String) -> TileProg = {
  let first = trace(name)
  let second = trace(name)
  if first != second { panic("tile-golden: `${name}` traced twice gave two different programs") } else { () }
  first
}

# Not a golden, and not one of `trace`'s arms for that reason: the probe
# run.sh's out-along-twice-accepted mutant records, an Out cut along one
# grid axis twice, which the clean recording refuses by name.
fn out_along_twice() -> TileProg = {
  let (p, _e) = trace1("out_along_twice", Out(F64, cells([64, 64], [8, 8], along: [0, 0])), o => store_cell(o, zeros(o)))
  p
}

pub fn main() -> Unit !io = match args() {
  ["--bytecode-version"] -> println(bytecode_version())
  ["out_along_twice"] -> print(render(out_along_twice()))
  [name] -> print(render(trace_twice(name)))
  [name, "--bytecode", path] -> {
    let bytes = encode(trace_twice(name))
    match with_fs_real(() => write_bytes(path, bytes)) {
      Ok(_) -> ()
      Err(_e) -> panic("tile-golden: cannot write the bytecode to `${path}`")
    }
  }
  _ -> panic("usage: kernels <vadd|vadd_f32|vadd_bf16|sum|vadd_tail|copy|relu|leaky_relu|clip|elemops"
      ++ "|reduce_sum|softmax|dot|mse|monte_carlo|rms_norm|silu|sigmoid|ppo_loss|dpo_loss|mathops|foldif|argmax"
      ++ "|matmul|batched_matmul|transpose|layer_norm|batch_norm|group_norm|fused_rms_norm"
      ++ "|transpose_tail|conv1d|conv2d|max_pool|interleave|rgb_gray|jacobi|depthwise_conv1d|gaussian_blur"
      ++ "|count_eq|subarray_sum|rainbow|int_ops"
      ++ "|sum_diff|reverse|invert|f16_ops|dot_f16|matmul_f16|batched_matmul_f16|matmul_i8"
      ++ "|token_embed|sort_rank|merge_rank|scatter_perm"
      ++ "|view_conv1d|view_token_embed|view_atomic|view_atomic_bf16|view_stride_pad|view_gather_pad"
      ++ "|prefix_sum|max_subarray|seg_scan|compact|linrec|gae|ssm_scan"
      ++ "|histogram|cas_swap|erf_sweep|geglu|trig_sweep|rope"
      ++ "|dtype_i16|dtype_i64|dtype_tf32|dtype_e4m3|dtype_e5m2|dtype_e8m0"
      ++ "|dtype_i4|dtype_e2m1|pack_roundtrip"
      ++ "|kv_scores|kv_context|attn_bwd_mmt|attn_bwd_ds|lin_attn_s|lin_attn_out"
      ++ "|ols_gram|ols_elim|ols_beta"
      ++ "|gpt_ln|gpt_qkv|gpt_scores|gpt_context|gpt_dense|gpt_fc|gpt_gelu|gpt_down"
      ++ "|llama_rms|llama_qkv|llama_rope|llama_scores|llama_out|llama_ffn|llama_down"
      ++ "|trig_sweep|rope|shape_ops|grid_stride|token_join|ptr_roundtrip|ptr_recast|insert_tile|powi_sweep"
      ++ "|loop_count|loop_bound|loop_until|loop_none|loop_return"
      ++ "|attr_round|attr_nan|attr_ftz|attr_approx|attr_overflow|attr_memsem|attr_addf|attr_ucmp"
      ++ "|attr_sat|attr_ftof|attr_xchg"
      ++ "|assert_pass|assert_fail|print_tile|assume_divby|assume_same|assume_bounded"
      ++ "|global_table|global_ctl|global_scratch|global_flags|global_syms"
      ++ "|view_transpose|view_max_pool|view_conv2d|view_padding|view_pad_i32>"
      ++ " [--bytecode <path>] | kernels --bytecode-version")
}

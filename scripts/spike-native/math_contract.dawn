fn raw(x: Float) -> Int = if float.is_nan(x) { 0x7ff8000000000000 } else { narrow.f64_bits(x) }
fn direct(op: String, x: Float, y: Float, z: Float) -> Float = match op {
  "exp" -> math.exp(x)
  "exp2" -> math.exp2(x)
  "expm1" -> math.expm1(x)
  "log" -> math.log(x)
  "log2" -> math.log2(x)
  "log10" -> math.log10(x)
  "log1p" -> math.log1p(x)
  "sin" -> math.sin(x)
  "cos" -> math.cos(x)
  "tan" -> math.tan(x)
  "asin" -> math.asin(x)
  "acos" -> math.acos(x)
  "atan" -> math.atan(x)
  "sinh" -> math.sinh(x)
  "cosh" -> math.cosh(x)
  "tanh" -> math.tanh(x)
  "cbrt" -> math.cbrt(x)
  "sqrt" -> math.sqrt(x)
  "floor" -> math.floor(x)
  "ceil" -> math.ceil(x)
  "trunc" -> math.trunc(x)
  "round" -> math.round(x)
  "round_even" -> math.round_even(x)
  "pow" -> math.pow(x, y)
  "hypot" -> math.hypot(x, y)
  "atan2" -> math.atan2(x, y)
  "fma" -> math.fma(x, y, z)
  _ -> panic("unknown math operation")
}

fn unary(op: String) -> fn(Float) -> Float = match op {
  "exp" -> math.exp
  "exp2" -> math.exp2
  "expm1" -> math.expm1
  "log" -> math.log
  "log2" -> math.log2
  "log10" -> math.log10

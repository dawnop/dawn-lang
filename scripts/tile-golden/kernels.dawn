  }
  "assert_pass" -> {
    let (p, _e) = trace2("assert_pass", In(I32, run_of(DBG_TILE)), Out(I32, run_of(DBG_TILE)), assert_pass)
    p
  }
  "assert_fail" -> {
    let (p, _e) = trace2("assert_fail", In(I32, run_of(DBG_TILE)), Out(I32, run_of(DBG_TILE)), assert_fail)

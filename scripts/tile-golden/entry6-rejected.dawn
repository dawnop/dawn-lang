# A sixth argument of the wrong dtype must be a checker error, independent
# of runtime buffer-versus-scalar kind validation.
use std/gpu.{Gpu, Entry6, Launch, launch_entry6}
use std/narrow.{F32}
use std/int/i32.{I32}
pub fn sixth(e: Entry6[F32, F32, F32, F32, F32, I32], a: Launch[F32]) -> Result[Unit, ForeignError] !Gpu =
  launch_entry6(e, a, a, a, a, a, a)
pub fn main() -> Unit = ()

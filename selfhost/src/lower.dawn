# TAST -> Core IR (docs/native-backend-plan.md, Phase 0).
#
# This is where the sugar dies. Everything emit.dawn used to inline at code
# generation time -- match decision trees, `for`/`while` shape, `?`/`!`,
# string interpolation, and the boxing decision -- happens exactly once,
# here, and both backends consume the result.
#
# Two rules govern this file:
#
#   1. No target may be named. If a decision depends on "the JVM does X",
#      it belongs in a backend, not here. The one exception is CForeign,
#      which exists precisely to quarantine the unportable part.
#   2. Nothing implicit. A discarded value gets a CSDiscard; a boxed value
#      gets a CBox. If a backend has to re-derive it, it is not lowered.

use std/list
use std/map
use std/str
use types.{
  subst,
  Ty, TyInt, TyFloat, TyBool, TyString, TyUnit, TyNever, TyError, TyVar,
  TyAdt, TyList, TyTuple, TyFn, TyBytes, TyCursor, TyMap, TySet, TyArray, TyJava,
  Sym, Sig, Traits, TraitI, ImplI, MethodSig,
  Adts, AdtI, CtorI, adt_of, trait_of, OPTION_ID, RESULT_ID, ORD_ID, EQ_ID, HASH_ID,
  is_eq_scalar, is_ord_scalar, builtins, Impls, impl_at, has_impl_at,
  is_ground, expandable, type_args_of, sub_goals
}
use tast.{
  TExpr, TStmt, TPat, TArm, TStrPart, TFun, TModule, TBinOp, TUnOp, TJavaCall,
  tex_ty,
  XInt, XFloat, XBool, XUnit, XStr, XLocal, XFnValue, XCallDyn, XCallBuiltin,
  XCallFn, XApply, XJava, XLambda, XCtor, XConstRef, XCtorValue, XField,
  XListLit, XTupleLit, XPropagate, XUnwrap, XIndex, XReturn, XBreak, XContinue,
  XComptime, XUnsafePure, XBinary, XUnary, XIf, XMatch, XBlock, XError,
  TSPText, TSPInterp,
  BAdd, BSub, BMul, BDiv, BMod, BConcat, BEq, BNeq, BLt, BLe, BGt, BGe,
  BAnd, BOr, BBand, BBor, BBxor, BShl, BShr, BUshr, UNeg, UNot, UBnot,
  TPWild, TPBind, TPLit, TPTuple, TPList, TPCtor,
  TSLet, TSLetPat, TSLocalFn, TSAssign, TSExpr, TSAssert, TSWhile, TSFor,
  WitRef, WForward, WConcrete, WApply
}
use exhaustive.{LitV, LInt, LFloat, LBool, LStr}
use core.{
  CExpr, CStmt, CCallee, CFun, CModule, CParam, CMode, CBinOp, CUnOp,
  CInt, CFloat, CBool, CStr, CUnit, CLocal, CFnRef, CCall, CIntrinsic,
  CCtor, CField, CIsCtor, CClosure, CTuple, CTupleGet, CBox, CUnbox,
  CBinary, CUnary, CIf, CBlock, CListLit, CReturn, CBreak, CContinue,
  CForeign, CJava,
  CSLet, CSAssign, CSDiscard, CSLoop, CSIf, CSDup, CSDrop,
  CDirect, CDynamic, CMethod, CImpl, CDefault, CDictRef, CDictApply, CDictArg,
  CDictDef, CDictSlot, CSlotFn, CSlotDefault,
  CAdd, CSub, CMul, CDiv, CMod, CEq, CNe, CLt, CLe, CGt, CGe, CAnd, COr,
  CBand, CBor, CBxor, CShl, CShr, CUshr, CConcat, CNeg, CNot, CBnot,
  COwned, CBorrowed, cex_ty, ty_key, ty_key_inst, diverges
}

# Prelude constructor indices, fixed by types.prelude_adts.
const SOME_CI: Int = 0
const NONE_CI: Int = 1
const OK_CI: Int = 0
const ERR_CI: Int = 1

## Lowering state: a fresh-symbol counter (match scrutinees, `?` temporaries),
## a loop-id counter, and the innermost enclosing loop. Symbol ids continue
## above the checker's, so a lowered temporary can never shadow a source
## local. `cur_loop` is -1 outside any loop; the checker has already rejected
## a stray `break`, so lowering may treat that as impossible.
pub type LSt = {
  next_sym: Int,
  next_loop: Int,
  owner: String,
  cur_loop: Int,
  # the enclosing function's declared return type, so `return` can box
  # against it here rather than in each backend
  ret_ty: Ty,
  # the checker's symbol table for this module: the authority on what a
  # pattern binding's type is, so lowering never has to consult the ADT
  # table to type a field projection
  syms: Map[Int, Sym],
  # lambda lifting: bodies hoisted to top level, and the counter that names
  # them. A lifted body keeps its captures' original symbol ids, so it needs
  # no substitution -- see core.CFun.captures.
  lifted: List[CFun],
  next_lam: Int,
  # trait metadata, needed to resolve a witness into a call form. It stops
  # here: Core carries the resolved answer, so no backend consults it.
  traits: Traits,
  impls: Impls,
  adts: Adts,
  # every function's declared signature, so a call site can box its
  # arguments against the DECLARED parameter types rather than leaving each
  # backend to recompute "is this slot a type variable"
  prog_fns: Map[(String, String), Sig],
  dicts: List[CDictDef],
  # The dictionaries in scope right here, by the type each one witnesses
  # `Eq` for (`ty_key_inst`, so `Option[Int]` and `Option[T]` are distinct
  # keys). Only a non-ground type is ever looked up: a ground one's relation
  # is decided at compile time and needs no dictionary at all.
  #
  # It is scoped, not accumulated. A synthesised body reaches only the
  # dictionaries its own parameters carry -- the enclosing function's
  # symbols are not in scope inside a lifted one -- so entering one replaces
  # this map and leaving restores it.
  dict_env: Map[String, CExpr],
  # the function whose body is being lowered, as that body sees itself
  self_ctx: Option[SelfCtx],
  # whether the expression being lowered sits in tail position
  tail: Bool,
  # set once a self tail call was actually rewritten, so only the functions
  # that need the wrapper loop pay for it
  self_tail: Bool
}

## The function currently being lowered, as its own body sees it. Two things
## need this. A local named function is not in its own capture list -- the
## checker strips the binding -- so rebuilding its closure is the only way to
## name it inside its own body. And spec §12.4 guarantees a self tail call
## compiles to a loop rather than a frame, which is a rewrite, not an
## optimisation: without it deep self-recursion overflows the stack.
##
## Doing both here rather than in a backend is the point of Core. The JVM
## emitter used to carry `self_pending`/`cur_fn`/`fn_start` for exactly this,
## and the C backend would have needed its own copy.
pub type SelfCtx = {
  # Some for a local named function, reached through its binding; None for a
  # top-level one, reached by name
  sym: Option[Int],
  owner: String,
  name: String,
  # a lifted body takes its captures as leading parameters, so rebuilding the
  # closure means passing them again
  caps: List[CExpr],
  # what a tail call reassigns before jumping
  params: List[Int],
  ptys: List[Ty],
  fty: Ty,
  loop_id: Int
}

fn fresh_sym(st: LSt) -> (LSt, Int) =
  (LSt { ..st, next_sym: st.next_sym + 1 }, st.next_sym)

fn fresh_loop(st: LSt) -> (LSt, Int) =
  (LSt { ..st, next_loop: st.next_loop + 1 }, st.next_loop)

# ---- boxing ----

## The one erasure rule, materialised. A value heading into a slot whose
## declared type is a type variable gets boxed; coming back out it gets
## unboxed. emit.dawn recomputed this at every argument position; Core
## decides it once, here.
fn adapt_in(e: CExpr, actual: Ty, declared: Ty) -> CExpr =
  match declared {
    TyVar(_, _) ->
      match actual {
        TyVar(_, _) -> e
        _ -> CBox(e, actual)
      }
    _ -> e
  }

## The intrinsics whose declared signature *is* their ABI: a type variable in a
## slot means that slot is erased, exactly as it does for a Dawn function, and
## the backend emits one plain call against the declared descriptor. So the box
## and the unbox belong here, in Core, like they do at every other call.
##
## The rest of the table is excluded because its backend handlers read the
## Core node's own type rather than the declared one -- `unwrap_or` stores its
## fallback in a slot sized by the *result* type, so boxing it here would break
## it. That split has always been implicit; naming it is what makes calling one
## of these with a concrete argument work at all. Before, `map_insert(m, "k",
## 5)` written directly in std (rather than through the generic wrapper that
## had already erased 5) emitted a long where the descriptor said Object, and
## the class failed verification.
fn erased_builtin_sig(name: String) -> Option[Sig] =
  if str.starts_with(name, "array_") || is_map_builtin(name) {
    map.get(builtins(), name)
  } else {
    None
  }

## The persistent Map/Set intrinsics -- the read side takes an erased key, the
## write side an erased key and value.
fn is_map_builtin(name: String) -> Bool =
  str.starts_with(name, "map_") || str.starts_with(name, "set_")

fn adapt_out(e: CExpr, declared: Ty, actual: Ty) -> CExpr =
  match declared {
    TyVar(_, _) ->
      match actual {
        TyVar(_, _) -> e
        _ -> CUnbox(e, actual)
      }
    _ -> e
  }

# ---- operators ----

fn bin_op(op: TBinOp) -> CBinOp =
  match op {
    BAdd -> CAdd
    BSub -> CSub
    BMul -> CMul
    BDiv -> CDiv
    BMod -> CMod
    BConcat -> CConcat
    BEq -> CEq
    BNeq -> CNe
    BLt -> CLt
    BLe -> CLe
    BGt -> CGt
    BGe -> CGe
    BAnd -> CAnd
    BOr -> COr
    BBand -> CBand
    BBor -> CBor
    BBxor -> CBxor
    BShl -> CShl
    BShr -> CShr
    BUshr -> CUshr
  }

fn un_op(op: TUnOp) -> CUnOp =
  match op {
    UNeg -> CNeg
    UNot -> CNot
    UBnot -> CBnot
  }

# ---- to-string, for interpolation ----

## Interpolation is lowered here rather than left to the backends, which is
## why the vocabulary is Core's own (`str_of_int`, ...) rather than any
## backend's. Each backend maps these names to its runtime.
fn to_str(e: CExpr, t: Ty) -> CExpr =
  if t == TyString {
    e
  } else if t == TyInt {
    CIntrinsic("str_of_int", [e], TyString)
  } else if t == TyFloat {
    CIntrinsic("str_of_float", [e], TyString)
  } else if t == TyBool {
    CIntrinsic("str_of_bool", [e], TyString)
  } else if t == TyUnit {
    CStr("()")
  } else {
    # everything else goes through Show, which is a runtime dispatch on the
    # value -- so the argument crosses as an erased reference
    CIntrinsic("show", [adapt_in(e, t, TyVar("T", 0))], TyString)
  }

# ---- constructor fields ----

## A constructor field is STORED at its declared type, which for a generic
## ADT is a type variable and therefore boxed. Reading it back at the
## concrete type is an unbox, and writing a concrete value into it is a box.
##
## The JVM emitter does this inline at every field access (adapt_from /
## adapt_to on the declared type); Core has to make it explicit, or the
## second backend simply will not know the field is erased. Getting it wrong
## is invisible on a backend whose fields are a union -- which is why the C
## backend was happy before this was written.
fn declared_field_ty(st: LSt, adt: Int, ci: Int, idx: Int) -> Ty = {
  let a = adt_of(st.adts, adt)
  let c = a.ctors[ci]
  if idx < len(c.fields) { c.fields[idx].ty } else { TyError }
}

## The declared field type with the ADT's type arguments substituted in.
fn concrete_field_ty(st: LSt, scrut: Ty, adt: Int, ci: Int, idx: Int) -> Ty = {
  let a = adt_of(st.adts, adt)
  let c = a.ctors[ci]
  if idx >= len(c.fields) {
    return TyError
  }
  let targs =
    match scrut {
      TyAdt(_, args) -> args
      _ -> []
    }
  var m: Map[Int, Ty] = map.empty()
  var k = 0
  for tp in a.tparams {
    match tp {
      TyVar(_, vid) ->
        if k < len(targs) {
          m = map.insert(m, vid, targs[k])
        }
      _ -> ()
    }
    k = k + 1
  }
  subst(c.fields[idx].ty, m, map.empty())
}

## Read a constructor field, unboxing if the field is declared at a type
## variable but used at a concrete type.
fn read_field(st: LSt, target: CExpr, scrut: Ty, adt: Int, ci: Int, idx: Int) -> CExpr = {
  let declared = declared_field_ty(st, adt, ci, idx)
  let concrete = concrete_field_ty(st, scrut, adt, ci, idx)
  adapt_out(CField(target, adt, ci, idx, declared), declared, concrete)
}

# ---- patterns ----

## A pattern compiles to (test, binds): a short-circuiting condition over
## projections of `subj`, and the bindings to establish once it holds.
##
## The test must short-circuit: a nested projection is only valid after the
## enclosing discriminant test passed, so `CAnd` carries a real obligation
## on both backends, not just an optimisation.
fn pat_test(st: LSt, subj: CExpr, p: TPat, t: Ty) -> (LSt, CExpr, List[CStmt]) =
  match p {
    TPWild -> (st, CBool(true), [])
    TPBind(sym, _) -> (st, CBool(true), [CSLet(sym, sym_ty(st, sym, t), subj)])
    TPLit(v) -> (st, lit_eq(subj, v, t), [])
    TPTuple(elems) -> {
      var st1 = st
      var cond: CExpr = CBool(true)
      var binds: List[CStmt] = []
      var i = 0
      let ets =
        match t {
          TyTuple(xs) -> xs
          _ -> []
        }
      for sub in elems {
        let et = if i < len(ets) { ets[i] } else { pat_ty(st1, sub) }
        let (st2, c, bs) = pat_test(st1, CTupleGet(subj, i, et), sub, et)
        st1 = st2
        cond = and_of(cond, c)
        binds = binds ++ bs
        i = i + 1
      }
      (st1, cond, binds)
    }
    TPCtor(adt, ci, field_pats) -> {
      var st1 = st
      var cond: CExpr = CIsCtor(subj, adt, ci)
      var binds: List[CStmt] = []
      var i = 0
      for fp in field_pats {
        match fp {
          Some(sub) -> {
            let ft = concrete_field_ty(st1, t, adt, ci, i)
            let proj = read_field(st1, subj, t, adt, ci, i)
            let (st2, c, bs) = pat_test(st1, proj, sub, ft)
            st1 = st2
            cond = and_of(cond, c)
            binds = binds ++ bs
          }
          None -> ()
        }
        i = i + 1
      }
      (st1, cond, binds)
    }
    TPList(pre, has_rest, rest_sym, post) ->
      lower_list_pattern(st, subj, t, pre, has_rest, rest_sym, post)
  }

## A list pattern: a length test plus element tests at fixed offsets from
## each end. `..rest` binds the middle. Once D2/D3 make List an ordinary
## Dawn ADT this becomes a plain constructor pattern and disappears.
fn lower_list_pattern(
  st: LSt,
  subj: CExpr,
  t: Ty,
  pre: List[TPat],
  has_rest: Bool,
  rest_sym: Option[Int],
  post: List[TPat]
) -> (LSt, CExpr, List[CStmt]) = {
  let et =
    match t {
      TyList(e) -> e
      _ -> TyError
    }
  let n = len(pre) + len(post)
  let count = CIntrinsic("len", [subj], TyInt)
  var cond: CExpr =
    if has_rest {
      CBinary(CGe, count, CInt(n), TyBool)
    } else {
      CBinary(CEq, count, CInt(n), TyBool)
    }
  var binds: List[CStmt] = []
  var st1 = st
  var i = 0
  for p in pre {
    let elem = adapt_out(
      CIntrinsic("list_index", [subj, CInt(i)], TyVar("E", 0)), TyVar("E", 0), et)
    let (st2, c, bs) = pat_test(st1, elem, p, et)
    st1 = st2
    cond = and_of(cond, c)
    binds = binds ++ bs
    i = i + 1
  }
  var j = len(post)
  for p in post {
    # counted from the end, so a `..rest` of unknown width does not shift it
    let idx = CBinary(CSub, count, CInt(j), TyInt)
    let elem = adapt_out(
      CIntrinsic("list_index", [subj, idx], TyVar("E", 0)), TyVar("E", 0), et)
    let (st2, c, bs) = pat_test(st1, elem, p, et)
    st1 = st2
    cond = and_of(cond, c)
    binds = binds ++ bs
    j = j - 1
  }
  match rest_sym {
    Some(rs) -> {
      binds = binds ++ [CSLet(rs, t,
        CIntrinsic("list_slice",
          [subj, CInt(len(pre)), CBinary(CSub, count, CInt(len(post)), TyInt)], t))]
    }
    None -> ()
  }
  (st1, cond, binds)
}

## The type a projection should be read at. TPCtor does not carry field
## types, but the checker already typed every binding, so the sub-pattern
## tells us: a bind knows its symbol's type, a literal knows its own, and a
## nested pattern is by construction a reference.
##
## Reaching for the ADT table here would work too, but it would put a table
## in Core's lowering that Core itself does not need.
fn pat_ty(st: LSt, p: TPat) -> Ty =
  match p {
    TPBind(sym, _) -> sym_ty(st, sym, TyError)
    TPLit(v) ->
      match v {
        LInt(_) -> TyInt
        LFloat(_) -> TyFloat
        LBool(_) -> TyBool
        LStr(_) -> TyString
      }
    TPCtor(adt, _, _) -> TyAdt(adt, [])
    TPTuple(elems) -> TyTuple([])
    TPList(_, _, _, _) -> TyError
    TPWild -> TyError
  }

fn sym_ty(st: LSt, sym: Int, fallback: Ty) -> Ty =
  match map.get(st.syms, sym) {
    Some(s) -> s.ty
    None -> fallback
  }

## Option/Result payload types, needed to rebuild an `Err` when `?`
## propagates it.
fn field_ty(t: Ty, adt: Int, ci: Int, idx: Int) -> Ty =
  if adt == OPTION_ID && ci == SOME_CI {
    match t {
      TyAdt(_, args) -> if len(args) > 0 { args[0] } else { TyError }
      _ -> TyError
    }
  } else if adt == RESULT_ID && ci == OK_CI {
    match t {
      TyAdt(_, args) -> if len(args) > 0 { args[0] } else { TyError }
      _ -> TyError
    }
  } else if adt == RESULT_ID && ci == ERR_CI {
    match t {
      TyAdt(_, args) -> if len(args) > 1 { args[1] } else { TyError }
      _ -> TyError
    }
  } else {
    TyError
  }

fn and_of(a: CExpr, b: CExpr) -> CExpr =
  match a {
    CBool(true) -> b
    _ ->
      match b {
        CBool(true) -> a
        _ -> CBinary(CAnd, a, b, TyBool)
      }
  }

fn lit_eq(subj: CExpr, v: LitV, t: Ty) -> CExpr =
  match v {
    LInt(n) -> CBinary(CEq, subj, CInt(n), TyBool)
    LFloat(f) -> CBinary(CEq, subj, CFloat(f), TyBool)
    LBool(b) -> CBinary(CEq, subj, CBool(b), TyBool)
    LStr(s) -> CBinary(CEq, subj, CStr(s), TyBool)
  }

# ---- trait witnesses ----

## A stable name for the dictionary of (trait, subject). Backends use it as
## a symbol, so it must be spellable in both C and JVM identifiers.
## `ty_key_inst` and not `ty_key`: a structural witness names its subject
## here, and a structural subject can be an instantiated generic. `ty_key`
## drops ADT type arguments on purpose (it names v1 impl subjects, which are
## never generic), so it would give `Option[Int]` and `Option[String]` the
## same dictionary.
fn dict_key(tid: Int, subject: Ty) -> String =
  "dict$" ++ to_string(tid) ++ "$" ++ ty_key_inst(subject)

## The trait method's signature with the subject substituted in: what the
## impl's own method actually takes, so a devirtualised call boxes nothing.
fn subst_subject(tr: TraitI, sg: Sig, subject: Ty) -> Sig = {
  let vid =
    match tr.tvar {
      TyVar(_, v) -> v
      _ -> panic("lower: trait subject is not a type variable")
    }
  var m: Map[Int, Ty] = map.empty()
  m = map.insert(m, vid, subject)
  var ps: List[Ty] = []
  for p in sg.param_tys {
    ps = ps ++ [subst(p, m, map.empty())]
  }
  Sig { ..sg, param_tys: ps, ret: subst(sg.ret, m, map.empty()) }
}

fn trait_method_sig(tr: TraitI, name: String) -> Sig = {
  for entry in tr.methods {
    let (mn, ms) = entry
    if mn == name { return ms.sig }
  }
  panic("lower: trait `" ++ tr.name ++ "` has no method `" ++ name ++ "`")
}

## Lower arguments and box each against its declared parameter type. This is
## the boxing materialisation: it happens once, here, instead of at every
## argument position in every backend.
fn lower_args_to(st: LSt, args: List[TExpr], decl: List[Ty]) -> (LSt, List[CExpr]) = {
  var st1 = st
  var out: List[CExpr] = []
  var i = 0
  for a in args {
    let (st2, v) = lower_expr(st1, a)
    st1 = st2
    let d = if i < len(decl) { decl[i] } else { tex_ty(a) }
    out = out ++ [adapt_in(v, tex_ty(a), d)]
    i = i + 1
  }
  (st1, out)
}

fn sig_of(st: LSt, owner: String, name: String) -> Option[Sig] =
  map.get(st.prog_fns, (owner, name))

fn impl_for(st: LSt, tid: Int, subject: Ty) -> ImplI =
  match impl_at(st.impls, tid, subject) {
    Some(i) -> i
    None -> panic("lower: no impl for trait " ++ to_string(tid))
  }

fn provides(imp: ImplI, name: String) -> Bool = {
  for p in imp.provided {
    if p == name { return true }
  }
  false
}

fn method_index(tr: TraitI, name: String) -> Int = {
  var i = 0
  for entry in tr.methods {
    let (mn, _ms) = entry
    if mn == name { return i }
    i = i + 1
  }
  panic("lower: trait `" ++ tr.name ++ "` has no method `" ++ name ++ "`")
}

fn owner_or(o: Option[String], fallback: String) -> String =
  match o {
    Some(x) -> x
    None -> fallback
  }

## The type of a dictionary as Core sees it: erased, like every other value a
## backend chooses its own representation for.
fn dict_ty() -> Ty = TyAdt(0 - 1, [])

## Build (once) the dictionary for a ground witness and return a reference to
## it. Every slot is resolved here, so a backend only has to lay out pointers.
fn dict_ref(st: LSt, tid: Int, subject: Ty) -> (LSt, CExpr) = {
  let no_goals: List[(Int, Ty)] = []
  let (st1, key) = dict_def(st, tid, subject, no_goals)
  (st1, CDictRef(key, tid, subject, dict_ty()))
}

## Register the definition of one dictionary, keyed so it is built once.
##
## `argtys` names the types this dictionary is a function of -- empty for
## every dictionary the language had before trait v2, and otherwise the
## subject's own type arguments (§3.8). A slot body finds those arguments
## back through the dictionary it is already handed, so the argument list
## changes what the slots may *read*, not what shape they have.
fn dict_def(st: LSt, tid: Int, subject: Ty, goals: List[(Int, Ty)]) -> (LSt, String) = {
  let key = dict_key(tid, subject)
  for d in st.dicts {
    if d.key == key { return (st, key) }
  }
  let tr = trait_of(st.traits, tid)
  # reserve the key first: a slot body may itself reference this same
  # dictionary, and without the reservation that would recurse forever
  var st1 = LSt {
    ..st,
    dicts: st.dicts ++
      [CDictDef {
        key: key,
        trait_id: tid,
        subject: subject,
        nargs: len(goals),
        slots: []
      }]
  }
  var slots: List[CDictSlot] = []
  for entry in tr.methods {
    let (mn, ms) = entry
    let (st2, slot) = dict_slot(st1, tr, tid, subject, key, goals, mn, ms)
    st1 = st2
    slots = slots ++ [slot]
  }
  var out: List[CDictDef] = []
  for d in st1.dicts {
    if d.key == key {
      out = out ++ [CDictDef { ..d, slots: slots }]
    } else {
      out = out ++ [d]
    }
  }
  (LSt { ..st1, dicts: out }, key)
}

## One slot: the impl's own method, the trait's default, or -- where there is
## neither -- the relation the language itself defines.
##
## That third case is the prelude Eq/Hash/Ord over a scalar and the structural
## default over everything else. It used to have no Core representation at
## all: the JVM hand-wrote the body twice in bytecode (`gen_prelude_*_impl`,
## `gen_structural_*_impl`) and Core emitted `CSlotDefault` naming a default
## the trait does not have, which is why the C backend named symbols nothing
## defined. Synthesising an ordinary function is the move `make_bridge`
## already makes -- past this point no backend knows the slot was special.
fn dict_slot(
  st: LSt,
  tr: TraitI,
  tid: Int,
  subject: Ty,
  key: String,
  goals: List[(Int, Ty)],
  mn: String,
  ms: MethodSig
) -> (LSt, CDictSlot) = {
  if has_impl_at(st.impls, tid, subject) {
    let imp = impl_for(st, tid, subject)
    if provides(imp, mn) {
      let (st1, bridge) =
        make_bridge(st, tr, tid, subject, owner_or(imp.owner, st.owner), mn, key, goals)
      return (st1, CSlotFn(st1.owner, bridge))
    }
  }
  if ms.has_default {
    return (st, CSlotDefault(owner_or(tr.owner, st.owner), mn))
  }
  let (st1, name) = make_prim_slot(st, tr, tid, subject, key, goals, mn)
  (st1, CSlotFn(st1.owner, name))
}

## Synthesise the bridge that lets an impl method sit in a dictionary slot:
## it takes the trait's generic (erased) parameters plus the dictionary,
## unboxes them into the impl's concrete signature, and boxes the result
## back. Ordinary top-level function from here on -- no backend knows it is
## special.
fn make_bridge(
  st: LSt,
  tr: TraitI,
  tid: Int,
  subject: Ty,
  iowner: String,
  method: String,
  key: String,
  goals: List[(Int, Ty)]
) -> (LSt, String) = {
  let sg = trait_method_sig(tr, method)
  let psig = subst_subject(tr, sg, subject)
  # `ty_key_inst`, not `ty_key`: a conditional impl's bridge names the
  # dictionary class it reads its arguments out of, so `Box[Int]` and
  # `Box[Box[Int]]` need different bridges. For a non-generic subject the two
  # spellings agree, which is why nothing that existed before changed name.
  let name = "bridge$" ++ to_string(tid) ++ "$" ++ ty_key_inst(subject) ++ "$" ++ method
  var seen = false
  for f in st.lifted {
    if f.name == name { seen = true }
  }
  if seen {
    (st, name)
  } else {
    var st1 = st
    var ps: List[CParam] = []
    var args: List[CExpr] = []
    var i = 0
    for gt in sg.param_tys {
      let (st2, sym) = fresh_sym(st1)
      st1 = st2
      ps = ps ++ [CParam { sym: sym, ty: gt, mode: COwned }]
      args = args ++ [adapt_out(CLocal(sym, gt), gt, psig.param_tys[i])]
      i = i + 1
    }
    # Every slot has the same signature, so the dictionary parameter is always
    # there. For a conditional impl it is also where the impl's own
    # dictionaries come from.
    let (st3, dsym) = fresh_sym(st1)
    st1 = st3
    # A conditional impl's method is generic: it wants a dictionary per bound,
    # and the only place to get them is the dictionary this bridge was handed.
    var ds: List[CExpr] = []
    var gi = 0
    for _g in goals {
      ds = ds ++ [CDictArg(CLocal(dsym, dict_ty()), st1.owner, key, gi, dict_ty())]
      gi = gi + 1
    }
    let call = CCall(CImpl(iowner, tid, subject, method), args ++ ds, psig.ret)
    let f = CFun {
      name: name,
      owner: st1.owner,
      captures: [],
      params: ps,
      dicts: [CParam { sym: dsym, ty: TyAdt(0 - 1, []), mode: COwned }],
      ret: sg.ret,
      body: adapt_in(call, psig.ret, sg.ret),
      is_test: false,
      impl_of: None,
      default_of: None
    }
    (LSt { ..st1, lifted: st1.lifted ++ [f] }, name)
  }
}

## The body of a relation the language defines rather than a program.
##
## One definition, two callers: `lower_trait_call` uses it where the subject
## is statically known (no dictionary is built at all), and `make_prim_slot`
## uses it to fill a dictionary slot where one is. That the devirtualised
## form and the forwarded form are the same relation is now a fact about the
## code rather than a claim in a comment.
fn prim_relation(st: LSt, tid: Int, subject: Ty, args: List[CExpr]) -> (LSt, CExpr) = {
  if tid == EQ_ID { return eq_at(st, args[0], args[1], subject) }
  if tid == HASH_ID { return (st, CIntrinsic("hash", [args[0]], TyInt)) }
  if tid == ORD_ID { return cmp_at(st, args[0], args[1], subject) }
  panic("lower: no primitive relation for trait " ++ to_string(tid))
}

## Wrap `prim_relation` in a top-level function with the trait method's own
## (erased) signature, so it can sit in a dictionary slot like any other.
##
## The trailing dictionary parameter used to be dead weight -- every slot has
## one, and a primitive relation needed nothing from it. For a parameterised
## dictionary it is the whole mechanism: the arguments the dictionary was
## built from are read back out of it. That is why the slot signature did not
## have to change, and why a `CMethod` call site looks the same whether or not
## the dictionary it dispatches through happens to take arguments.
fn make_prim_slot(
  st: LSt,
  tr: TraitI,
  tid: Int,
  subject: Ty,
  key: String,
  goals: List[(Int, Ty)],
  method: String
) -> (LSt, String) = {
  let sg = trait_method_sig(tr, method)
  let name = "prim$" ++ to_string(tid) ++ "$" ++ ty_key_inst(subject) ++ "$" ++ method
  var seen = false
  for f in st.lifted {
    if f.name == name { seen = true }
  }
  if seen { return (st, name) }
  var st1 = st
  var ps: List[CParam] = []
  var args: List[CExpr] = []
  for gt in sg.param_tys {
    let (st2, sym) = fresh_sym(st1)
    st1 = st2
    ps = ps ++ [CParam { sym: sym, ty: gt, mode: COwned }]
    args = args ++ [adapt_out(CLocal(sym, gt), gt, subject)]
  }
  let (st3, dsym) = fresh_sym(st1)
  st1 = st3
  var env: Map[String, CExpr] = map.empty()
  var ai = 0
  for g in goals {
    let (gt, gty) = g
    env = map.insert(env, dict_key(gt, gty),
      CDictArg(CLocal(dsym, dict_ty()), st1.owner, key, ai, dict_ty()))
    ai = ai + 1
  }
  let (st4, body) = prim_relation(LSt { ..st1, dict_env: env }, tid, subject, args)
  let f = CFun {
    name: name,
    owner: st4.owner,
    captures: [],
    params: ps,
    dicts: [CParam { sym: dsym, ty: dict_ty(), mode: COwned }],
    ret: sg.ret,
    body: body,
    is_test: false,
    impl_of: None,
    default_of: None
  }
  (LSt { ..st4, lifted: st4.lifted ++ [f], dict_env: st.dict_env }, name)
}

# ---- structural equality (docs/semantics-closure-design.md 3) ----
#
# `a == b` used to reach the backends as a bare `CBinary(CEq, ..)` whatever
# the operand type was, and Core said nothing about what it meant. Each
# consumer therefore invented an answer: Object.equals on the JVM, C's `==`
# on native, a hand-written walk in the interpreter, another in the tuple
# class. Seven of them, and they disagreed.
#
# Now the relation is spelled out here, once, over the type's own structure.
# What a backend still gets to implement is only the two ends: the scalars it
# compares natively, and `struct_eq` on a value whose type is not ground.

## Is there a dictionary this body could use for `t`, without inventing one?
##
## Three ways there is. One is in scope, put there by the enclosing witness or
## by the enclosing synthesised body's own parameters. Or `t` is ground, so a
## static singleton settles it. Or `t` has no structure of its own -- a
## container, until S3 -- and its dictionary's slots reach the runtime
## intrinsic, which needs no arguments and so needs no dictionary for the
## parts either.
##
## The one case that fails is a bare rigid variable with nothing in scope for
## it, and that is exactly the code `==` still accepts without an `Eq` bound.
## Asking first, rather than building and discovering, is what keeps this cut
## from turning that code into an error (§3.7 -- that is cut 7's change).
fn dict_available(st: LSt, tid: Int, t: Ty) -> Bool =
  match map.get(st.dict_env, dict_key(tid, t)) {
    Some(_) -> true
    None ->
      match t {
        TyVar(_, _) -> false
        _ ->
          if is_ground(t) || not expandable(t) {
            true
          } else {
            goals_available(st, sub_goals(st.impls, tid, t))
          }
      }
  }

fn goals_available(st: LSt, goals: List[(Int, Ty)]) -> Bool = {
  for g in goals {
    let (gt, gty) = g
    if not dict_available(st, gt, gty) { return false }
  }
  true
}

fn goal_dicts(st: LSt, goals: List[(Int, Ty)]) -> (LSt, List[CExpr]) = {
  var st1 = st
  var out: List[CExpr] = []
  for g in goals {
    let (gt, gty) = g
    let (st2, d) = dict_expr(st1, gt, gty)
    st1 = st2
    out = out ++ [d]
  }
  (st1, out)
}

## The dictionary for `t`, as an expression. Only called where
## `dict_available` already said yes.
##
## A non-ground subject with structure is where trait v2 shows: its dictionary
## is not a constant but a construction, built from its arguments' -- and its
## arguments' may themselves be constructions.
fn dict_expr(st: LSt, tid: Int, t: Ty) -> (LSt, CExpr) =
  match map.get(st.dict_env, dict_key(tid, t)) {
    Some(d) -> (st, d)
    None ->
      if is_ground(t) || not expandable(t) {
        dict_ref(st, tid, t)
      } else {
        let goals = sub_goals(st.impls, tid, t)
        let (st1, ds) = goal_dicts(st, goals)
        let (st2, key) = dict_def(st1, tid, t, goals)
        (st2, CDictApply(key, ds, dict_ty()))
      }
  }

fn conj(acc: Option[CExpr], c: CExpr) -> CExpr =
  match acc {
    None -> c
    Some(e) -> CBinary(CAnd, e, c, TyBool)
  }

fn conj_or_true(acc: Option[CExpr]) -> CExpr =
  match acc {
    Some(e) -> e
    None -> CBool(true)
  }

## `a == b` at one type, as Core. **Every** producer of a Dawn equality goes
## through here: the `==` operator, a `[T: Eq]` bound instantiated at a
## concrete type, and each field inside a synthesised comparison. Before this
## the first two were separate pipelines from the language's first day -- the
## operator never consulted a witness at all -- which is the first cause of
## the relation having had several definitions.
fn eq_at(st: LSt, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) = {
  # the scalars a backend compares natively. From here on `CBinary(CEq, ..)`
  # means this and nothing else.
  if is_eq_scalar(t) { return (st, CBinary(CEq, a, b, TyBool)) }
  # an explicit `impl Eq` wins over structure, exactly as it does when the
  # same comparison arrives through a bound
  if has_impl_at(st.impls, EQ_ID, t) {
    let imp = impl_for(st, EQ_ID, t)
    if provides(imp, "eq") {
      let (st1, ds) = goal_dicts(st, sub_goals(st.impls, EQ_ID, t))
      return (st1, CCall(
        CImpl(owner_or(imp.owner, st1.owner), EQ_ID, t, "eq"), [a, b] ++ ds, TyBool))
    }
  }
  if is_ground(t) {
    if expandable(t) {
      let (st1, name) = struct_eq_fn(st, t)
      return (st1, CCall(CDirect(st1.owner, name), [a, b], TyBool))
    }
    return (st, CIntrinsic("struct_eq", [a, b], TyBool))
  }
  # Not ground: what this compares depends on a type only the caller knows.
  # If a dictionary for the whole is in scope, that dictionary *is* the
  # answer -- go through it rather than guessing at the structure behind it.
  match map.get(st.dict_env, dict_key(EQ_ID, t)) {
    Some(d) -> return eq_through_dict(st, d, a, b, t)
    None -> ()
  }
  # Otherwise spell the whole out over its parts, passing each part's
  # dictionary down. That is the same expansion the ground case gets, minus
  # the luxury of knowing what the parts are.
  if expandable(t) && goals_available(st, sub_goals(st.impls, EQ_ID, t)) {
    let (st1, ds) = goal_dicts(st, sub_goals(st.impls, EQ_ID, t))
    let (st2, name) = struct_eq_fn(st1, t)
    return (st2, CCall(CDirect(st2.owner, name), [a, b] ++ ds, TyBool))
  }
  (st, CIntrinsic("struct_eq", [a, b], TyBool))
}

## Compare through a dictionary: the only shape available where the type is a
## rigid variable, since there is no structure to walk and no impl to name.
## The slot has the trait's own erased signature, so the operands are boxed
## exactly as they are for any other dictionary call.
fn eq_through_dict(st: LSt, d: CExpr, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) = {
  let tr = trait_of(st.traits, EQ_ID)
  let sg = trait_method_sig(tr, "eq")
  let idx = method_index(tr, "eq")
  (st, adapt_out(
    CCall(CMethod(d, EQ_ID, "eq", idx),
      [adapt_in(a, t, sg.param_tys[0]), adapt_in(b, t, sg.param_tys[1])], sg.ret),
    sg.ret, TyBool))
}

## The relation the compiler writes for one composite type, as an ordinary
## top-level function -- no backend knows it is special, the same way no
## backend knows about a dictionary bridge.
##
## Keyed by the *instantiated* type, not the declaration: `Option[Int]` and
## `Option[Point]` need different comparisons, and a JVM class (one per
## declaration) could not carry both.
##
## A non-ground type takes one dictionary parameter per type argument and
## reaches its parts through them. So `Option[T]` gets one function rather
## than one per instantiation: Dawn passes dictionaries instead of
## monomorphising, and this is that decision reaching the relations the
## compiler writes for itself.
##
## Equality and ordering share this scaffold because they are the same
## construction over the same structure. They used to share nothing: equality
## was lowered here and ordering was written directly as JVM bytecode, which
## is why the C backend emitted calls to a derived `cmp` it never defined.
fn struct_rel_fn(
  st: LSt,
  t: Ty,
  prefix: String,
  tid: Int,
  ret: Ty,
  zero: CExpr,
  body_of: fn(LSt, CExpr, CExpr, Ty) -> (LSt, CExpr)
) -> (LSt, String) = {
  let name = prefix ++ ty_key_inst(t)
  for f in st.lifted {
    if f.name == name { return (st, name) }
  }
  let (st0, asym) = fresh_sym(st)
  let (st1, bsym) = fresh_sym(st0)
  let ps = [
    CParam { sym: asym, ty: t, mode: COwned },
    CParam { sym: bsym, ty: t, mode: COwned }
  ]
  let no_goals: List[(Int, Ty)] = []
  let goals = if is_ground(t) { no_goals } else { sub_goals(st.impls, tid, t) }
  var stD = st1
  var dps: List[CParam] = []
  var env: Map[String, CExpr] = map.empty()
  for g in goals {
    let (gt, gty) = g
    let (stA, dsym) = fresh_sym(stD)
    stD = stA
    dps = dps ++ [CParam { sym: dsym, ty: dict_ty(), mode: COwned }]
    env = map.insert(env, dict_key(gt, gty), CLocal(dsym, dict_ty()))
  }
  # publish the name before building the body: a recursive type reaches this
  # same function from inside itself, and without the reservation that
  # recurses until the stack ends
  let stub = CFun {
    name: name,
    owner: stD.owner,
    captures: [],
    params: ps,
    dicts: dps,
    ret: ret,
    body: zero,
    is_test: false,
    impl_of: None,
    default_of: None
  }
  let st2 = LSt { ..stD, lifted: stD.lifted ++ [stub], dict_env: env }
  let (st3, body) = body_of(st2, CLocal(asym, t), CLocal(bsym, t), t)
  var out: List[CFun] = []
  for f in st3.lifted {
    if f.name == name {
      out = out ++ [CFun { ..f, body: body }]
    } else {
      out = out ++ [f]
    }
  }
  (LSt { ..st3, lifted: out, dict_env: st.dict_env }, name)
}

fn struct_eq_fn(st: LSt, t: Ty) -> (LSt, String) =
  struct_rel_fn(st, t, "structeq\$", EQ_ID, TyBool, CBool(true), struct_eq_body)

fn struct_eq_body(st: LSt, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) =
  match t {
    TyTuple(elems) -> {
      var st1 = st
      var acc: Option[CExpr] = None
      var i = 0
      for et in elems {
        let (st2, c) = eq_at(st1, CTupleGet(a, i, et), CTupleGet(b, i, et), et)
        st1 = st2
        acc = Some(conj(acc, c))
        i = i + 1
      }
      (st1, conj_or_true(acc))
    }
    TyAdt(aid, _) -> {
      let info = adt_of(st.adts, aid)
      # one constructor: there is no discriminant to disagree about
      if len(info.ctors) == 1 {
        return ctor_fields_eq(st, a, b, t, aid, 0)
      }
      # several: `a` picks the arm and `b` has to be in the same one. Built
      # back to front so the last `else` is the honest `false`.
      var st1 = st
      var chain: CExpr = CBool(false)
      var ci = len(info.ctors) - 1
      while ci >= 0 {
        let (st2, fe) = ctor_fields_eq(st1, a, b, t, aid, ci)
        st1 = st2
        let same = if len(info.ctors[ci].fields) == 0 {
          CIsCtor(b, aid, ci)
        } else {
          CBinary(CAnd, CIsCtor(b, aid, ci), fe, TyBool)
        }
        chain = CIf(CIsCtor(a, aid, ci), same, Some(chain), TyBool)
        ci = ci - 1
      }
      (st1, chain)
    }
    _ -> panic("lower: struct_eq_body on a type with no structure to compare")
  }

fn ctor_fields_eq(st: LSt, a: CExpr, b: CExpr, sc: Ty, aid: Int, ci: Int) -> (LSt, CExpr) = {
  let c = adt_of(st.adts, aid).ctors[ci]
  var st1 = st
  var acc: Option[CExpr] = None
  var idx = 0
  while idx < len(c.fields) {
    let ft = concrete_field_ty(st1, sc, aid, ci, idx)
    let (st2, e) = eq_at(st1,
      read_field(st1, a, sc, aid, ci, idx),
      read_field(st1, b, sc, aid, ci, idx), ft)
    st1 = st2
    acc = Some(conj(acc, e))
    idx = idx + 1
  }
  (st1, conj_or_true(acc))
}

# ---- structural ordering (docs/trait-v2-design.md 3.6) ----
#
# `derive Ord`'s body used to be written straight into JVM bytecode
# (`gen_derived_ord_cmp` / `emit_field_cmp` / `cmp_fields`), so Core never
# carried it. The C backend therefore emitted a *call* to `impl$0$Adt<n>$cmp`
# and no definition -- an undefined symbol, with no diagnostic anywhere. This
# is the same move `eq_at` is: one definition, spelled over the type's own
# structure, and both backends compile it.
#
# Writing it here is also what unblocks `derive Ord` on a generic type. The
# derived comparison of `Box[T]` needs `Ord[T]`, and a dictionary parameter is
# something a lowered function can take and a hand-written bytecode body
# cannot.

## `cmp(a, b)` at one type, as Core. The Ord counterpart of `eq_at`, and every
## producer of an ordering goes through it: `cmp`, the comparison operators,
## a `[T: Ord]` bound instantiated at a concrete type, and each field inside a
## derived comparison.
##
## There is no fallback branch. Unlike equality, ordering is not defined for
## every type -- the checker refuses `Ord` where no impl and no derive supply
## it -- so reaching the end here is a compiler bug rather than a gap.
fn cmp_at(st: LSt, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) = {
  if is_ord_scalar(t) { return (st, CIntrinsic("cmp", [a, b], TyInt)) }
  if has_impl_at(st.impls, ORD_ID, t) {
    let imp = impl_for(st, ORD_ID, t)
    if provides(imp, "cmp") {
      let (st1, ds) = goal_dicts(st, sub_goals(st.impls, ORD_ID, t))
      return (st1, CCall(
        CImpl(owner_or(imp.owner, st1.owner), ORD_ID, t, "cmp"), [a, b] ++ ds, TyInt))
    }
  }
  if is_ground(t) {
    if expandable(t) {
      let (st1, name) = struct_cmp_fn(st, t)
      return (st1, CCall(CDirect(st1.owner, name), [a, b], TyInt))
    }
    panic("lower: no ordering for " ++ ty_key_inst(t))
  }
  match map.get(st.dict_env, dict_key(ORD_ID, t)) {
    Some(d) -> return cmp_through_dict(st, d, a, b, t)
    None -> ()
  }
  if expandable(t) && goals_available(st, sub_goals(st.impls, ORD_ID, t)) {
    let (st1, ds) = goal_dicts(st, sub_goals(st.impls, ORD_ID, t))
    let (st2, name) = struct_cmp_fn(st1, t)
    return (st2, CCall(CDirect(st2.owner, name), [a, b] ++ ds, TyInt))
  }
  panic("lower: no ordering for " ++ ty_key_inst(t))
}

fn cmp_through_dict(st: LSt, d: CExpr, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) = {
  let tr = trait_of(st.traits, ORD_ID)
  let sg = trait_method_sig(tr, "cmp")
  let idx = method_index(tr, "cmp")
  (st, adapt_out(
    CCall(CMethod(d, ORD_ID, "cmp", idx),
      [adapt_in(a, t, sg.param_tys[0]), adapt_in(b, t, sg.param_tys[1])], sg.ret),
    sg.ret, TyInt))
}

fn struct_cmp_fn(st: LSt, t: Ty) -> (LSt, String) =
  struct_rel_fn(st, t, "structcmp$", ORD_ID, TyInt, CInt(0), struct_cmp_body)

fn struct_cmp_body(st: LSt, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) =
  match t {
    TyTuple(elems) -> {
      var st1 = st
      var parts: List[CExpr] = []
      var i = 0
      for et in elems {
        let (st2, c) = cmp_at(st1, CTupleGet(a, i, et), CTupleGet(b, i, et), et)
        st1 = st2
        parts = parts ++ [c]
        i = i + 1
      }
      lexicographic(st1, parts, 0)
    }
    TyAdt(aid, _) -> {
      let info = adt_of(st.adts, aid)
      # one constructor: nothing to disagree about but the fields
      if len(info.ctors) == 1 {
        return ctor_fields_cmp(st, a, b, t, aid, 0)
      }
      # Constructor order first, declaration order being the order. Built back
      # to front so the last `else` is unreachable-but-honest: `a` is one of
      # them, and the tags already agreed.
      var st1 = st
      var chain: CExpr = CInt(0)
      var ci = len(info.ctors) - 1
      while ci >= 0 {
        let (st2, fe) = ctor_fields_cmp(st1, a, b, t, aid, ci)
        st1 = st2
        chain = CIf(CIsCtor(a, aid, ci), fe, Some(chain), TyInt)
        ci = ci - 1
      }
      let (st3, ta) = fresh_sym(st1)
      let (st4, tb) = fresh_sym(st3)
      (st4, CBlock(
        [CSLet(ta, TyInt, CTagOf(a, aid)), CSLet(tb, TyInt, CTagOf(b, aid))],
        Some(CIf(
          CBinary(CNe, CLocal(ta, TyInt), CLocal(tb, TyInt), TyBool),
          CBinary(CSub, CLocal(ta, TyInt), CLocal(tb, TyInt), TyInt),
          Some(chain), TyInt)),
        TyInt))
    }
    _ -> panic("lower: struct_cmp_body on a type with no structure to order")
  }

fn ctor_fields_cmp(st: LSt, a: CExpr, b: CExpr, sc: Ty, aid: Int, ci: Int) -> (LSt, CExpr) = {
  let c = adt_of(st.adts, aid).ctors[ci]
  var st1 = st
  var parts: List[CExpr] = []
  var idx = 0
  while idx < len(c.fields) {
    let ft = concrete_field_ty(st1, sc, aid, ci, idx)
    let (st2, e) = cmp_at(st1,
      read_field(st1, a, sc, aid, ci, idx),
      read_field(st1, b, sc, aid, ci, idx), ft)
    st1 = st2
    parts = parts ++ [e]
    idx = idx + 1
  }
  lexicographic(st1, parts, 0)
}

## Fold field comparisons into one: the first non-zero wins, and each is
## evaluated only if every earlier one tied. A `let` per step, because the
## result is read twice -- once to test it, once to return it.
fn lexicographic(st: LSt, parts: List[CExpr], i: Int) -> (LSt, CExpr) = {
  if i >= len(parts) { return (st, CInt(0)) }
  if i == len(parts) - 1 { return (st, parts[i]) }
  let (st1, rest) = lexicographic(st, parts, i + 1)
  let (st2, sym) = fresh_sym(st1)
  (st2, CBlock(
    [CSLet(sym, TyInt, parts[i])],
    Some(CIf(
      CBinary(CNe, CLocal(sym, TyInt), CInt(0), TyBool),
      CLocal(sym, TyInt),
      Some(rest), TyInt)),
    TyInt))
}

## Does this witness stand for a relation the language defines itself, rather
## than for an impl body to call?
##
## Three shapes qualify: the prelude Eq/Hash over a scalar, the prelude Ord
## over an ordered scalar, and the structural Eq/Hash default. None of them
## has an impl with a body, so a call has to reach `prim_relation` -- routing
## Ord's here instead is what fixes `cmp(3, 9)`, which used to compile and
## then die at run time looking for a trait default that does not exist.
fn subject_of(w: WitRef) -> Ty =
  match w {
    WConcrete(_, s) -> s
    WApply(_, s, _) -> s
    WForward(_) -> panic("lower: a forwarded witness has no subject")
  }

## Does this call have to reach `prim_relation` rather than a method body?
##
## The table says so. An impl that neither provides a method nor was derived
## has no body anywhere -- that is the prelude's scalar Eq/Hash/Ord -- and no
## impl at all means Eq/Hash's structural default. This used to be three
## hand-written conditions (a witness kind, `is_eq_scalar`, `is_ord_scalar`);
## they were three spellings of one question the table already answers.
fn primitive_witness(st: LSt, w: WitRef, tid: Int) -> Bool =
  match w {
    WConcrete(_, subject) -> primitive_subject(st, tid, subject)
    WApply(_, subject, _) -> primitive_subject(st, tid, subject)
    WForward(_) -> false
  }

fn primitive_subject(st: LSt, tid: Int, subject: Ty) -> Bool =
  match impl_at(st.impls, tid, subject) {
    # A derived impl has no body either -- the compiler is the one that
    # defines it, which is the same answer the prelude's scalar impls give.
    # It used to be the opposite, and that is how the derived comparison
    # ended up written twice: once in bytecode, never in Core.
    Some(imp) -> imp.derived || len(imp.provided) == 0
    None -> tid == EQ_ID || tid == HASH_ID
  }

fn is_eq_op(op: TBinOp) -> Bool =
  match op {
    BEq -> true
    BNeq -> true
    _ -> false
  }

## A witness as a value, for the hidden trailing arguments of a generic call.
fn witness_value(st: LSt, w: WitRef) -> (LSt, CExpr) =
  match w {
    WForward(sym) -> (st, CLocal(sym, TyAdt(0 - 1, [])))
    # The structural default is not a different kind of dictionary, only one
    # whose slots the compiler supplies -- which is why deleting WStructural
    # changed nothing here.
    WConcrete(tid, subject) -> dict_ref(st, tid, subject)
    # ...and a non-ground subject is not a different kind either, only one
    # that cannot be a constant: same slots, built per use out of the
    # arguments' dictionaries.
    WApply(tid, subject, args) -> {
      let (st1, ds) = witness_values(st, args)
      let (st2, key) = dict_def(st1, tid, subject, sub_goals(st1.impls, tid, subject))
      (st2, CDictApply(key, ds, dict_ty()))
    }
  }

fn witness_values(st: LSt, ws: List[WitRef]) -> (LSt, List[CExpr]) = {
  var st1 = st
  var out: List[CExpr] = []
  for w in ws {
    let (st2, v) = witness_value(st1, w)
    st1 = st2
    out = out ++ [v]
  }
  (st1, out)
}

## Put a witness's argument dictionaries in scope, keyed by the type each one
## witnesses for, and hand back what was there before. Extends rather than
## replaces: this runs at a call site inside a body whose own dictionaries are
## still in scope.
fn enter_wit_env(st: LSt, w: WitRef) -> (LSt, Map[String, CExpr]) =
  match w {
    WApply(tid, subject, args) -> {
      var st1 = st
      var env = st.dict_env
      var i = 0
      for g in sub_goals(st.impls, tid, subject) {
        let (gt, gty) = g
        if i < len(args) {
          let (st2, d) = witness_value(st1, args[i])
          st1 = st2
          env = map.insert(env, dict_key(gt, gty), d)
        }
        i = i + 1
      }
      (LSt { ..st1, dict_env: env }, st.dict_env)
    }
    _ -> (st, st.dict_env)
  }

## A trait method call. A concrete witness devirtualises to a direct call --
## Dawn is dictionary-passing, so this is where the dictionary disappears
## when it is statically known. A forwarded one dispatches through the slot.
fn lower_trait_call(
  st: LSt,
  tid: Int,
  name: String,
  args: List[TExpr],
  ws: List[WitRef],
  ty: Ty
) -> (LSt, CExpr) = {
  let tr = trait_of(st.traits, tid)
  let idx = method_index(tr, name)
  let sg = trait_method_sig(tr, name)
  if len(ws) == 0 {
    panic("lower: trait method call without a witness: " ++ name)
  }
  # A prelude or structural witness has no body to call. It collapses to the
  # primitive, which is not an optimisation but the definition -- the same
  # relation `==` emits, and what a bound instantiated at either has to end
  # up as. `prim_relation` is also what fills the dictionary slot when the
  # subject is not statically known, so the two forms cannot drift apart.
  if primitive_witness(st, ws[0], tid) {
    var st1 = st
    var vs: List[CExpr] = []
    for a in args {
      let (st2, v) = lower_expr(st1, a)
      st1 = st2
      vs = vs ++ [v]
    }
    # A witness with arguments brings its parts' dictionaries with it. Putting
    # them in scope here is what lets the relation be spelled out at the call
    # site -- no dictionary for the whole is ever built.
    let (st3, saved) = enter_wit_env(st1, ws[0])
    let (st4, e) = prim_relation(st3, tid, subject_of(ws[0]), vs)
    return (LSt { ..st4, dict_env: saved }, e)
  }
  match ws[0] {
    WForward(sym) -> {
      # the dictionary slot has the trait's generic signature, so the
      # subject position is erased and the argument is boxed
      let (st1, vs) = lower_args_to(st, args, sg.param_tys)
      (st1, adapt_out(
        CCall(CMethod(CLocal(sym, dict_ty()), tid, name, idx), vs, sg.ret),
        sg.ret, ty))
    }
    # An impl with a body, reached at a subject that is not ground: there is
    # nothing to devirtualise to, because which body runs depends on the
    # arguments. Build the dictionary and dispatch, exactly as a forwarded one
    # does. (No impl in the language is conditional yet, so nothing reaches
    # here today; leaving it as a panic would make the first conditional impl
    # a compiler crash rather than a call.)
    # A conditional impl at a known subject still devirtualises -- which
    # body runs is settled; only the dictionaries it needs are values.
    WApply(_, subject, wargs) -> {
      let imp = impl_for(st, tid, subject)
      if provides(imp, name) {
        let psig = subst_subject(tr, sg, subject)
        let (st1, vs) = lower_args_to(st, args, psig.param_tys)
        let (st2, ds) = witness_values(st1, wargs)
        return (st2, adapt_out(
          CCall(CImpl(owner_or(imp.owner, st2.owner), tid, subject, name), vs ++ ds,
            psig.ret),
          psig.ret, ty))
      }
      let (st1, d) = witness_value(st, ws[0])
      let (st2, vs) = lower_args_to(st1, args, sg.param_tys)
      (st2, adapt_out(
        CCall(CMethod(d, tid, name, idx), vs, sg.ret), sg.ret, ty))
    }
    WConcrete(_, subject) -> {
      let imp = impl_for(st, tid, subject)
      if provides(imp, name) {
        # devirtualised: the impl's own method takes the concrete type, so
        # nothing is boxed
        let psig = subst_subject(tr, sg, subject)
        let (st1, vs) = lower_args_to(st, args, psig.param_tys)
        (st1, adapt_out(
          CCall(CImpl(owner_or(imp.owner, st.owner), tid, subject, name), vs, psig.ret),
          psig.ret, ty))
      } else {
        # the default body is generic and takes the dictionary like any
        # other dictionary-passing function
        let (st1, vs) = lower_args_to(st, args, sg.param_tys)
        let (st2, d) = dict_ref(st1, tid, subject)
        (st2, adapt_out(
          CCall(CDefault(owner_or(tr.owner, st2.owner), tid, name), vs ++ [d], sg.ret),
          sg.ret, ty))
      }
    }
  }
}

# ---- lambda lifting ----

fn fresh_lam(st: LSt) -> (LSt, String) =
  (LSt { ..st, next_lam: st.next_lam + 1 }, "lambda$" ++ to_string(st.next_lam))

fn params_of_fn_ty(t: Ty) -> List[Ty] =
  match t {
    TyFn(ps, _, _) -> ps
    _ -> []
  }

fn ret_of_fn_ty(t: Ty) -> Ty =
  match t {
    TyFn(_, r, _) -> r
    _ -> TyError
  }

## Hoist a lambda body to top level and leave a CClosure behind.
##
## The captured variables become leading parameters of the lifted function,
## keeping their original symbol ids -- so the body, which already refers to
## them by those ids, is copied across unchanged. That is the whole reason
## lifting here costs nothing: TAST already recorded the capture set.
## The function being lowered, referred to as a value from inside its own
## body. Only a local named function can be named this way -- a top-level one
## goes through XFnValue -- and it is not in its own capture list, so the
## closure has to be rebuilt from the captures the lifted body already holds.
## A function whose self tail call was rewritten becomes a loop whose only
## exits are returns: falling off the end of a Core loop would repeat it.
fn wrap_self_loop(used: Bool, lid: Int, body: CExpr, ret: Ty) -> CExpr =
  if used {
    CBlock([CSLoop(lid, CReturn(Some(body)), None)], None, ret)
  } else {
    body
  }

fn self_value(st: LSt, sym: Int) -> Option[CExpr] =
  match st.self_ctx {
    Some(sc) ->
      match sc.sym {
        Some(s) ->
          if s == sym {
            Some(CClosure(sc.name, sc.owner, sc.caps, sc.fty))
          } else {
            None
          }
        None -> None
      }
    None -> None
  }

fn is_self_fn(st: LSt, owner: String, name: String) -> Bool =
  match st.self_ctx {
    Some(sc) ->
      match sc.sym {
        Some(_) -> false
        None -> sc.owner == owner && sc.name == name
      }
    None -> false
  }

fn is_self_sym(st: LSt, sym: Int) -> Bool =
  match st.self_ctx {
    Some(sc) ->
      match sc.sym {
        Some(s) -> s == sym
        None -> false
      }
    None -> false
  }

## The §12.4 rewrite: evaluate the arguments, write them back over the
## parameters, jump to the top. The values go through temporaries first
## because the assignment is simultaneous -- `f(b, a)` must not read `a` back
## after `a` has been overwritten.
fn self_tail_jump(st: LSt, args: List[TExpr]) -> (LSt, CExpr) = {
  let sc = st.self_ctx.expect("self ctx")
  let (st1, vs) = lower_args_to(st, args, sc.ptys)
  var st2 = st1
  var stmts: List[CStmt] = []
  var tmps: List[(Int, Ty)] = []
  var i = 0
  for v in vs {
    let (st3, t) = fresh_sym(st2)
    st2 = st3
    stmts = stmts ++ [CSLet(t, sc.ptys[i], v)]
    tmps = tmps ++ [(t, sc.ptys[i])]
    i = i + 1
  }
  i = 0
  for tm in tmps {
    let (t, ty) = tm
    stmts = stmts ++ [CSAssign(sc.params[i], CLocal(t, ty))]
    i = i + 1
  }
  (LSt { ..st2, self_tail: true },
    CBlock(stmts, Some(CContinue(sc.loop_id)), TyNever))
}

fn lift_lambda(
  st: LSt,
  params: List[Int],
  body: TExpr,
  captures: List[Int],
  ty: Ty,
  # Some for a local named function: its own body may call it, and the
  # checker leaves that binding out of the capture list
  self_sym: Option[Int]
) -> (LSt, CExpr) = {
  let (st1, name) = fresh_lam(st)
  var caps: List[CParam] = []
  # the closure-allocation site sits in the ENCLOSING frame, so a capture of
  # an enclosing local named function rebuilds that function's closure; the
  # same captures seen from INSIDE the lifted body are plain parameters
  var cap_args: List[CExpr] = []
  var cap_inner: List[CExpr] = []
  for c in captures {
    let ct = sym_ty(st1, c, TyError)
    caps = caps ++ [CParam { sym: c, ty: ct, mode: COwned }]
    cap_args = cap_args ++ [
      match self_value(st1, c) {
        Some(v) -> v
        None -> CLocal(c, ct)
      }
    ]
    cap_inner = cap_inner ++ [CLocal(c, ct)]
  }
  var ps: List[CParam] = []
  var ptys: List[Ty] = []
  let pts = params_of_fn_ty(ty)
  var i = 0
  for p in params {
    let pt = if i < len(pts) { pts[i] } else { sym_ty(st1, p, TyError) }
    ps = ps ++ [CParam { sym: p, ty: pt, mode: COwned }]
    ptys = ptys ++ [pt]
    i = i + 1
  }
  let (st1b, lid) = fresh_loop(st1)
  let sc: Option[SelfCtx] =
    match self_sym {
      Some(sy) -> Some(SelfCtx {
        sym: Some(sy),
        owner: st1b.owner,
        name: name,
        caps: cap_inner,
        params: params,
        ptys: ptys,
        fty: ty,
        loop_id: lid
      })
      None -> None
    }
  let (st2, cbody0) = lower_expr(LSt {
    ..st1b,
    ret_ty: ret_of_fn_ty(ty),
    self_ctx: sc,
    tail: true,
    self_tail: false
  }, body)
  let cbody1 = adapt_in(cbody0, tex_ty(body), ret_of_fn_ty(ty))
  let cbody = wrap_self_loop(st2.self_tail, lid, cbody1, ret_of_fn_ty(ty))
  let f = CFun {
    name: name,
    owner: st2.owner,
    captures: caps,
    params: ps,
    dicts: [],
    ret: ret_of_fn_ty(ty),
    body: cbody,
    is_test: false,
    impl_of: None,
    default_of: None
  }
  (LSt {
    ..st2,
    lifted: st2.lifted ++ [f],
    self_ctx: st.self_ctx,
    tail: st.tail,
    self_tail: st.self_tail
  }, CClosure(name, st2.owner, cap_args, ty))
}

## A constructor used as a function value (`map(xs, Some)`) becomes a
## closure over a wrapper that builds it -- same treatment as a top-level
## function, so function values have exactly one representation.
fn lift_ctor_value(st: LSt, adt: Int, ci: Int, ty: Ty) -> (LSt, CExpr) = {
  let (st1, lam) = fresh_lam(st)
  let pts = params_of_fn_ty(ty)
  let ret = ret_of_fn_ty(ty)
  var ps: List[CParam] = []
  var args: List[CExpr] = []
  var st2 = st1
  var i = 0
  for pt in pts {
    let (st3, sym) = fresh_sym(st2)
    st2 = st3
    ps = ps ++ [CParam { sym: sym, ty: pt, mode: COwned }]
    let declared = declared_field_ty(st2, adt, ci, i)
    args = args ++ [adapt_in(CLocal(sym, pt), pt, declared)]
    i = i + 1
  }
  let f = CFun {
    name: lam,
    owner: st2.owner,
    captures: [],
    params: ps,
    dicts: [],
    ret: ret,
    body: CCtor(adt, ci, args, ret),
    is_test: false,
    impl_of: None,
    default_of: None
  }
  (LSt { ..st2, lifted: st2.lifted ++ [f] }, CClosure(lam, st2.owner, [], ty))
}

## A top-level function used as a value becomes a closure over a wrapper
## with no captures, so that every function value has one representation.
fn lift_fn_value(st: LSt, owner: String, name: String, is_builtin: Bool, ty: Ty) -> (LSt, CExpr) = {
  let (st1, lam) = fresh_lam(st)
  let pts = params_of_fn_ty(ty)
  var ps: List[CParam] = []
  var args: List[CExpr] = []
  var st2 = st1
  var i = 0
  for pt in pts {
    let (st3, sym) = fresh_sym(st2)
    st2 = st3
    ps = ps ++ [CParam { sym: sym, ty: pt, mode: COwned }]
    args = args ++ [CLocal(sym, pt)]
    i = i + 1
  }
  let f = CFun {
    name: lam,
    owner: st2.owner,
    captures: [],
    params: ps,
    dicts: [],
    ret: ret_of_fn_ty(ty),
    body:
    if is_builtin {
      CIntrinsic(name, args, ret_of_fn_ty(ty))
    } else {
      CCall(CDirect(owner, name), args, ret_of_fn_ty(ty))
    },
    is_test: false,
    impl_of: None,
    default_of: None
  }
  (LSt { ..st2, lifted: st2.lifted ++ [f] }, CClosure(lam, st2.owner, [], ty))
}

# ---- expressions ----

pub fn lower_expr(st0: LSt, e: TExpr) -> (LSt, CExpr) = {
  # tail position is consumed here and re-established only by the arms that
  # propagate it, so every other descent is non-tail by construction
  let tl = st0.tail
  let st = LSt { ..st0, tail: false }
  match e {
    XInt(v, _, _) -> (st, CInt(v))
    XFloat(v, _, _) -> (st, CFloat(v))
    XBool(v, _, _) -> (st, CBool(v))
    XUnit(_, _) -> (st, CUnit)
    XLocal(sym, _, _, _, ty) ->
      match self_value(st, sym) {
        Some(c) -> (st, c)
        None -> (st, CLocal(sym, ty))
      }
    XUnsafePure(body, _, _, _) -> lower_expr(LSt { ..st, tail: tl }, body)
    XComptime(_, lo, hi, ty) -> (st, CComptime(lo, hi, ty))
    XError(_, _) -> panic("lower: XError reached lowering")
    XStr(parts, _, _) -> lower_str(st, parts)
    XUnary(op, operand, _, _, ty) -> {
      let (st1, v) = lower_expr(st, operand)
      (st1, CUnary(un_op(op), v, ty))
    }
    XBinary(op, l, r, ord, _, _, _, _, ty) ->
      match ord {
        # An operator that is really a trait method. Lowering spells the call
        # out, so neither backend needs a witness on a comparison node:
        # `<` becomes `cmp(l, r) <op> 0`, `==` becomes `eq(l, r)`.
        Some(w) ->
          if is_eq_op(op) {
            let (st1, c) = lower_trait_call(st, EQ_ID, "eq", [l, r], [w], TyBool)
            match op {
              BEq -> (st1, c)
              _ -> (st1, CUnary(CNot, c, TyBool))
            }
          } else {
            let (st1, c) = lower_trait_call(st, ORD_ID, "cmp", [l, r], [w], TyInt)
            (st1, CBinary(bin_op(op), c, CInt(0), TyBool))
          }
        # No witness. For `==`/`!=` that is not "nothing to dispatch": the
        # checker returns no witness whenever the answer is the structural
        # default, so this is the operator's own path into the same relation
        # a bound reaches through `lower_trait_call` -- both end at `eq_at`.
        None ->
          # A scalar keeps its own node -- `CNe` is a relation both backends
          # implement directly, and routing it through `not (a == b)` would
          # cost a node for nothing.
          if is_eq_op(op) && not is_eq_scalar(tex_ty(l)) {
            let (st1, lv) = lower_expr(st, l)
            let (st2, rv) = lower_expr(st1, r)
            let (st3, c) = eq_at(st2, lv, rv, tex_ty(l))
            match op {
              BEq -> (st3, c)
              _ -> (st3, CUnary(CNot, c, TyBool))
            }
          } else {
            let (st1, lv) = lower_expr(st, l)
            let (st2, rv) = lower_expr(st1, r)
            (st2, CBinary(bin_op(op), lv, rv, ty))
          }
      }
    XIf(cond, thn, els, _, _, ty) -> {
      let (st1, c) = lower_expr(st, cond)
      let (st2, t) = lower_expr(LSt { ..st1, tail: tl }, thn)
      match els {
        Some(ee) -> {
          let (st3, f) = lower_expr(LSt { ..st2, tail: tl }, ee)
          (st3, CIf(c, t, Some(f), ty))
        }
        None -> (st2, CIf(c, t, None, ty))
      }
    }
    XBlock(stmts, tail, _, _, ty) -> {
      let (st1, ss) = lower_stmts(st, stmts)
      match tail {
        Some(t) -> {
          let (st2, tv) = lower_expr(LSt { ..st1, tail: tl }, t)
          (st2, CBlock(ss, Some(tv), ty))
        }
        None -> (st1, CBlock(ss, None, ty))
      }
    }
    XReturn(v, _, _) ->
      match v {
        Some(inner) -> {
          let (st1, cv) = lower_expr(LSt { ..st, tail: true }, inner)
          if diverges(cv) { return (st1, cv) }
          (st1, CReturn(Some(adapt_in(cv, tex_ty(inner), st1.ret_ty))))
        }
        None -> (st, CReturn(None))
      }
    XBreak(_, _) -> (st, CBreak(st.cur_loop))
    XContinue(_, _) -> (st, CContinue(st.cur_loop))
    XMatch(scrut, arms, _, _, ty) -> lower_match(st, scrut, arms, ty, tl)
    XPropagate(operand, _, _, ty) -> lower_propagate(st, operand, ty)
    XUnwrap(operand, msg, _, _, ty) -> lower_unwrap(st, operand, msg, ty)
    XCtor(adt, ci, written, slots, spread, _, _, ty) ->
      lower_ctor(st, adt, ci, written, slots, spread, ty)
    XField(target, idx, _, _, ty) -> {
      let (st1, tv) = lower_expr(st, target)
      # a record-style read: the ADT has one constructor, so the
      # discriminant is statically known
      let tt = tex_ty(target)
      match tt {
        TyAdt(adt, _) -> (st1, read_field(st1, tv, tt, adt, 0, idx))
        _ -> panic("lower: field read on a non-ADT")
      }
    }
    XTupleLit(elems, _, _, ty) -> {
      let (st1, vs) = lower_all(st, elems)
      (st1, CTuple(vs, ty))
    }
    XListLit(elems, _, _, ty) -> {
      # elements cross into an erased container
      var st1 = st
      var vs: List[CExpr] = []
      for el in elems {
        let (st2, v) = lower_expr(st1, el)
        st1 = st2
        vs = vs ++ [adapt_in(v, tex_ty(el), TyVar("E", 0))]
      }
      (st1, CListLit(vs, ty))
    }
    XCallBuiltin(name, args, wits, _, _, ty) -> {
      match erased_builtin_sig(name) {
        Some(sg) -> {
          let (st1, vs) = lower_args_to(st, args, sg.param_tys)
          let (st2, ds) = witness_values(st1, wits)
          (st2, adapt_out(CIntrinsic(name, vs ++ ds, sg.ret), sg.ret, ty))
        }
        None -> {
          let (st1, vs) = lower_all(st, args)
          let (st2, ds) = witness_values(st1, wits)
          (st2, CIntrinsic(name, vs ++ ds, ty))
        }
      }
    }
    XCallFn(owner, name, args, wits, trait_id, _, _, ty) ->
      match trait_id {
        Some(tid) -> lower_trait_call(st, tid, name, args, wits, ty)
        None -> {
          let o = match owner { Some(x) -> x None -> st.owner }
          if tl && is_self_fn(st, o, name) {
            # dictionaries are not re-passed: a self call is the same
            # instantiation, so the ones already in scope still hold
            return self_tail_jump(st, args)
          }
          match sig_of(st, o, name) {
            Some(sg) -> {
              let (st1, vs) = lower_args_to(st, args, sg.param_tys)
              # a generic function takes its dictionaries as hidden trailing
              # arguments, in bound order -- the order the callee declares
              let (st2, ds) = witness_values(st1, wits)
              (st2, adapt_out(CCall(CDirect(o, name), vs ++ ds, sg.ret), sg.ret, ty))
            }
            None -> {
              let (st1, vs) = lower_all(st, args)
              let (st2, ds) = witness_values(st1, wits)
              (st2, CCall(CDirect(o, name), vs ++ ds, ty))
            }
          }
        }
      }
    XConstRef(name, _, _, ty) -> (st, CConstRef(name, ty))
    XIndex(target, index, on_map, _, _, ty) -> {
      let (st1, tv) = lower_expr(st, target)
      let (st2, iv) = lower_expr(st1, index)
      # indexing yields an erased element, so the unbox is explicit
      let erased = TyVar("E", 0)
      let call =
        if on_map {
          CIntrinsic("map_index",
            [tv, adapt_in(iv, tex_ty(index), TyVar("K", 0))], erased)
        } else {
          CIntrinsic("list_index", [tv, iv], erased)
        }
      (st2, adapt_out(call, erased, ty))
    }
    XCtorValue(adt, ci, _, _, ty) -> lift_ctor_value(st, adt, ci, ty)
    XCallDyn(sym, _, args, _, _, ty) ->
      if is_self_sym(st, sym) {
        if tl {
          self_tail_jump(st, args)
        } else {
          # not a tail call, so the closure is rebuilt and called through
          let (st1, vs) = lower_all(st, args)
          let clo = self_value(st1, sym).expect("self closure")
          (st1, CCall(CDynamic(clo), vs, ty))
        }
      } else {
        let (st1, vs) = lower_all(st, args)
        (st1, CCall(CDynamic(CLocal(sym, sym_ty(st1, sym, TyError))), vs, ty))
      }
    XApply(target, args, _, _, ty) -> {
      let (st1, tv) = lower_expr(st, target)
      let (st2, vs) = lower_all(st1, args)
      (st2, CCall(CDynamic(tv), vs, ty))
    }
    XLambda(params, _, body, captures, _, _, ty) ->
      lift_lambda(st, params, body, captures, ty, None)
    XFnValue(owner, name, is_builtin, ty, _, _) -> {
      # a builtin taken as a value gets the same wrapper as a declared
      # function; only its body differs, and both backends already know how
      # to emit an intrinsic call
      let o = match owner { Some(x) -> x None -> st.owner }
      lift_fn_value(st, o, name, is_builtin, ty)
    }
    XJava(call, _, _, ty) -> lower_java(st, call, ty)
    _ -> panic("lower: expression not lowered yet: " ++ node_name(e))
  }
}

## `use java`: the receiver and the arguments lower like any other
## expression, so no backend has to walk TAST to emit them. Everything else
## about the call is JVM-shaped metadata and rides along unchanged.
fn lower_java(st: LSt, call: TJavaCall, ty: Ty) -> (LSt, CExpr) = {
  var st1 = st
  let tgt: Option[CExpr] =
    match call.target {
      Some(t) -> {
        let (st2, v) = lower_expr(st1, t)
        st1 = st2
        Some(v)
      }
      None -> None
    }
  var args: List[CExpr] = []
  var tys: List[Ty] = []
  for a in call.args {
    let (st2, v) = lower_expr(st1, a)
    st1 = st2
    args = args ++ [v]
    tys = tys ++ [tex_ty(a)]
  }
  (st1, CForeign(CJava { call: call, target: tgt, args: args, arg_tys: tys }, ty))
}

fn lower_all(st: LSt, es: List[TExpr]) -> (LSt, List[CExpr]) = {
  var st1 = st
  var vs: List[CExpr] = []
  for e in es {
    let (st2, v) = lower_expr(st1, e)
    st1 = st2
    vs = vs ++ [v]
  }
  (st1, vs)
}

fn lower_str(st: LSt, parts: List[TStrPart]) -> (LSt, CExpr) = {
  var st1 = st
  var acc: Option[CExpr] = None
  for p in parts {
    let piece =
      match p {
        TSPText(v) -> CStr(v)
        TSPInterp(ie) -> {
          let (st2, v) = lower_expr(st1, ie)
          st1 = st2
          to_str(v, tex_ty(ie))
        }
      }
    acc =
      match acc {
        None -> Some(piece)
        Some(a) -> Some(CBinary(CConcat, a, piece, TyString))
      }
  }
  match acc {
    Some(a) -> (st1, a)
    None -> (st1, CStr(""))
  }
}

fn lower_ctor(
  st: LSt,
  adt: Int,
  ci: Int,
  written: List[TExpr],
  slots: List[Option[Int]],
  spread: Option[TExpr],
  ty: Ty
) -> (LSt, CExpr) = {
  let (st0, base) =
    match spread {
      Some(b) -> {
        let (sa, bv) = lower_expr(st, b)
        let (sb, bsym) = fresh_sym(sa)
        (sb, Some((bsym, bv, tex_ty(b))))
      }
      None -> (st, None)
    }
  let (st1, ws) = lower_all(st0, written)
  # slots maps field index -> written-arg index, so the constructor's
  # arguments arrive in field order and backends need no reordering
  var args: List[CExpr] = []
  var fi = 0
  for s in slots {
    match s {
      Some(i) -> {
        let declared = declared_field_ty(st1, adt, ci, fi)
        args = args ++ [adapt_in(ws[i], tex_ty(written[i]), declared)]
      }
      # no written argument: the field comes from the spread base, and it
      # stays at its declared type -- copying erased to erased boxes nothing
      None ->
        match base {
          Some(trip) -> {
            let (bsym, _bv, bt) = trip
            args = args ++
              [CField(CLocal(bsym, bt), adt, ci, fi,
                declared_field_ty(st1, adt, ci, fi))]
          }
          None -> panic("lower: constructor field without an argument")
        }
    }
    fi = fi + 1
  }
  let built = CCtor(adt, ci, args, ty)
  match base {
    # the base is evaluated once, before any field is read from it
    Some(trip) -> {
      let (bsym, bv, bt) = trip
      (st1, CBlock([CSLet(bsym, bt, bv)], Some(built), ty))
    }
    None -> (st1, built)
  }
}

## `match` becomes a once-loop: each arm is a guarded test that assigns the
## result and breaks. The loop exists so a failed guard falls through to the
## next arm without duplicating its test, which is exactly what the JVM
## emitter achieved with a `next_arm` label.
fn lower_match(st: LSt, scrut: TExpr, arms: List[TArm], ty: Ty, tl: Bool) -> (LSt, CExpr) = {
  let sty = tex_ty(scrut)
  let (st1, sv) = lower_expr(st, scrut)
  let (st2, ssym) = fresh_sym(st1)
  let (st3, rsym) = fresh_sym(st2)
  let (st4, lid) = fresh_loop(st3)
  let subj = CLocal(ssym, sty)
  let produces = ty != TyUnit && ty != TyNever

  var st5 = st4
  var body: List[CStmt] = []
  for arm in arms {
    # or-patterns duplicate the arm body, one branch per alternative; Dawn
    # binds nothing in them beyond what each alternative establishes
    for p in arm.pats {
      let (st6, cond, binds) = pat_test(st5, subj, p, sty)
      st5 = st6
      let (st7, armb) = lower_expr(LSt { ..st5, tail: tl }, arm.body)
      st5 = st7
      let taken =
        if produces {
          CBlock([CSAssign(rsym, armb)], Some(CBreak(lid)), TyNever)
        } else {
          CBlock([CSDiscard(armb)], Some(CBreak(lid)), TyNever)
        }
      let inner =
        match arm.guard {
          Some(g) -> {
            let (st8, gv) = lower_expr(st5, g)
            st5 = st8
            CBlock(binds ++ [CSIf(gv, taken, None)], None, TyUnit)
          }
          None -> CBlock(binds, Some(taken), TyNever)
        }
      body = body ++ [CSIf(cond, inner, None)]
    }
  }
  body = body ++ [CSDiscard(CIntrinsic("panic", [CStr("unreachable match")], TyNever))]

  var stmts: List[CStmt] = [CSLet(ssym, sty, sv)]
  if produces {
    stmts = stmts ++ [CSLet(rsym, ty, zero_of(ty))]
  }
  # Note that arm bodies are lowered WITHOUT cur_loop set to `lid`: the
  # once-loop is an implementation detail, so a user `break` inside an arm
  # must still refer to the enclosing source loop. Both breaks therefore
  # coexist, which is why CBreak names its loop instead of meaning
  # "innermost" -- a backend has to be able to leave a non-innermost loop.
  stmts = stmts ++ [CSLoop(lid, CBlock(body, None, TyUnit), None)]
  let tail: Option[CExpr] = if produces { Some(CLocal(rsym, ty)) } else { None }
  (st5, CBlock(stmts, tail, ty))
}

## A placeholder initialiser for the result slot of a match or if. Every
## path assigns it before use, but both targets want a definite
## initialisation at the declaration.
fn zero_of(t: Ty) -> CExpr =
  if t == TyInt {
    CInt(0)
  } else if t == TyFloat {
    CFloat(0.0)
  } else if t == TyBool {
    CBool(false)
  } else if t == TyString {
    CStr("")
  } else {
    CIntrinsic("null_ref", [], t)
  }

## `e?` -- return early on None/Err, otherwise take the payload.
fn lower_propagate(st: LSt, operand: TExpr, ty: Ty) -> (LSt, CExpr) = {
  let ot = tex_ty(operand)
  let (st1, ov) = lower_expr(st, operand)
  let (st2, sym) = fresh_sym(st1)
  let subj = CLocal(sym, ot)
  match ot {
    TyAdt(adt, _) ->
      if adt == OPTION_ID {
        (st2, CBlock(
          [CSLet(sym, ot, ov),
            CSIf(CIsCtor(subj, OPTION_ID, NONE_CI),
              CReturn(Some(CCtor(OPTION_ID, NONE_CI, [], ot))), None)],
          Some(read_field(st2, subj, ot, OPTION_ID, SOME_CI, 0)), ty))
      } else if adt == RESULT_ID {
        let err_ty = field_ty(ot, RESULT_ID, ERR_CI, 0)
        (st2, CBlock(
          [CSLet(sym, ot, ov),
            CSIf(CIsCtor(subj, RESULT_ID, ERR_CI),
              CReturn(Some(CCtor(RESULT_ID, ERR_CI,
                # re-wrapping, not consuming: the payload stays at its
                # declared (erased) type, so nothing is unboxed here
                [CField(subj, RESULT_ID, ERR_CI, 0,
                  declared_field_ty(st2, RESULT_ID, ERR_CI, 0))], ot))), None)],
          Some(read_field(st2, subj, ot, RESULT_ID, OK_CI, 0)), ty))
      } else {
        panic("lower: `?` on a non-Option/Result type")
      }
    _ -> panic("lower: `?` on a non-ADT")
  }
}

## `e!` -- take the payload or panic with the recorded message.
fn lower_unwrap(st: LSt, operand: TExpr, msg: String, ty: Ty) -> (LSt, CExpr) = {
  let ot = tex_ty(operand)
  let (st1, ov) = lower_expr(st, operand)
  let (st2, sym) = fresh_sym(st1)
  let subj = CLocal(sym, ot)
  match ot {
    TyAdt(adt, _) ->
      if adt == OPTION_ID {
        (st2, CBlock(
          [CSLet(sym, ot, ov),
            CSIf(CIsCtor(subj, OPTION_ID, NONE_CI),
              CIntrinsic("panic", [CStr(msg)], TyNever), None)],
          Some(read_field(st2, subj, ot, OPTION_ID, SOME_CI, 0)), ty))
      } else if adt == RESULT_ID {
        (st2, CBlock(
          [CSLet(sym, ot, ov),
            CSIf(CIsCtor(subj, RESULT_ID, ERR_CI),
              CIntrinsic("panic", [CStr(msg)], TyNever), None)],
          Some(read_field(st2, subj, ot, RESULT_ID, OK_CI, 0)), ty))
      } else {
        panic("lower: `!` on a non-Option/Result type")
      }
    _ -> panic("lower: `!` on a non-ADT")
  }
}

# ---- statements ----

fn lower_stmts(st: LSt, ss: List[TStmt]) -> (LSt, List[CStmt]) = {
  var st1 = st
  var out: List[CStmt] = []
  for s in ss {
    let (st2, cs) = lower_stmt(st1, s)
    st1 = st2
    out = out ++ cs
  }
  (st1, out)
}

fn lower_stmt(st: LSt, s: TStmt) -> (LSt, List[CStmt]) =
  match s {
    TSLet(sym, _, init, _, _) -> {
      let (st1, v) = lower_expr(st, init)
      match sym {
        # the binding's type is the checker's, not the initialiser's: a
        # `use java` constructor is typed narrower than its call node, and
        # taking the wrong one puts an Option where a ZipEntry belongs
        Some(sy) -> (st1, [CSLet(sy, sym_ty(st1, sy, tex_ty(init)), v)])
        # `let _ = e`: the value goes, the effect stays -- and Core says so
        None -> (st1, [CSDiscard(v)])
      }
    }
    TSAssign(sym, _, value, _, _) -> {
      let (st1, v) = lower_expr(st, value)
      (st1, [CSAssign(sym, v)])
    }
    TSExpr(e, _, _) -> {
      let (st1, v) = lower_expr(st, e)
      (st1, [CSDiscard(v)])
    }
    TSAssert(cond, src, _, _) -> {
      let (st1, c) = lower_expr(st, cond)
      let text = match src { Some(t) -> t None -> "assertion failed" }
      (st1, [CSIf(CUnary(CNot, c, TyBool),
        CIntrinsic("panic", [CStr("assertion failed: " ++ text)], TyNever), None)])
    }
    TSWhile(cond, body, _, _, _) -> {
      let (st1, lid) = fresh_loop(st)
      # the condition is evaluated outside the loop's own scope but inside
      # it at runtime, so it is lowered with cur_loop already set: a
      # `break` in a condition is legal and belongs to this loop
      let inner_st = LSt { ..st1, cur_loop: lid }
      let (st2, c) = lower_expr(inner_st, cond)
      let (st3, b) = lower_expr(st2, body)
      # the test becomes an explicit break, so the loop node itself is
      # unconditional and both backends emit the same shape
      let inner = CBlock(
        [CSIf(CUnary(CNot, c, TyBool), CBreak(lid), None), CSDiscard(b)],
        None, TyUnit)
      (LSt { ..st3, cur_loop: st.cur_loop }, [CSLoop(lid, inner, None)])
    }
    TSFor(sym, _, from, to, body, _, _, _) -> {
      match to {
        Some(hi) -> {
          let (st1, lid) = fresh_loop(st)
          # bounds are evaluated once, before the loop, so they are lowered
          # in the OUTER loop context
          let (st2, lo_v) = lower_expr(st1, from)
          let (st3, hi_v) = lower_expr(st2, hi)
          let (st4, bsym) = fresh_sym(st3)
          let (st5, b) = lower_expr(LSt { ..st4, cur_loop: lid }, body)
          let iv = CLocal(sym, TyInt)
          # induction is explicit: init, test, body, step. The step lives on
          # the loop node rather than at the end of the body so that
          # `continue` runs it -- see core.CSLoop.
          let inner = CBlock(
            [CSIf(CUnary(CNot, CBinary(CLt, iv, CLocal(bsym, TyInt), TyBool), TyBool),
              CBreak(lid), None),
              CSDiscard(b)],
            None, TyUnit)
          let step = CSAssign(sym, CBinary(CAdd, iv, CInt(1), TyInt))
          (LSt { ..st5, cur_loop: st.cur_loop }, [
            CSLet(bsym, TyInt, hi_v),
            CSLet(sym, TyInt, lo_v),
            CSLoop(lid, inner, Some(CBlock([step], None, TyUnit)))
          ])
        }
        None -> lower_for_list(st, sym, from, body)
      }
    }
    TSLetPat(pat, init, _, _) -> {
      let (st1, v) = lower_expr(st, init)
      let it = tex_ty(init)
      let (st2, sym) = fresh_sym(st1)
      # the checker has already proved the pattern irrefutable, so only the
      # bindings survive; the test it produces is discarded
      let (st3, _cond, binds) = pat_test(st2, CLocal(sym, it), pat, it)
      (st3, [CSLet(sym, it, v)] ++ binds)
    }
    TSLocalFn(sym, _, params, _, body, captures, _, _) -> {
      # a named local function is a lambda that also binds a name
      let fty = sym_ty(st, sym, TyError)
      let (st1, clo) = lift_lambda(st, params, body, captures, fty, Some(sym))
      (st1, [CSLet(sym, fty, clo)])
    }
  }

## `for x in xs` over a list: an index loop with the element read and
## unboxed explicitly. The JVM emitter walks java.util.List by index for the
## same reason -- the language only iterates lists, maps and sets going
## through `map.entries` first.
##
## Once D2/D3 make List an ordinary Dawn ADT this becomes a call to the
## `Iter` trait and stops being a special case here.
fn lower_for_list(st: LSt, sym: Int, from: TExpr, body: TExpr) -> (LSt, List[CStmt]) = {
  let ct = tex_ty(from)
  let et =
    match ct {
      TyList(e) -> e
      _ -> sym_ty(st, sym, TyError)
    }
  let (st1, lid) = fresh_loop(st)
  let (st2, coll) = lower_expr(st1, from)
  let (st3, csym) = fresh_sym(st2)
  let (st4, isym) = fresh_sym(st3)
  let (st5, b) = lower_expr(LSt { ..st4, cur_loop: lid }, body)
  let cv = CLocal(csym, ct)
  let iv = CLocal(isym, TyInt)
  let elem = adapt_out(
    CIntrinsic("list_index", [cv, iv], TyVar("E", 0)), TyVar("E", 0), et)
  let inner = CBlock(
    [CSIf(CUnary(CNot,
      CBinary(CLt, iv, CIntrinsic("len", [cv], TyInt), TyBool), TyBool),
      CBreak(lid), None),
      CSLet(sym, et, elem),
      CSDiscard(b)],
    None, TyUnit)
  let step = CSAssign(isym, CBinary(CAdd, iv, CInt(1), TyInt))
  (LSt { ..st5, cur_loop: st.cur_loop }, [
    CSLet(csym, ct, coll),
    CSLet(isym, TyInt, CInt(0)),
    CSLoop(lid, inner, Some(CBlock([step], None, TyUnit)))
  ])
}

# ---- functions and modules ----

## `continue` inside a lowered `for` must run the step before jumping, but
## Core's CContinue jumps to the loop head. The step is therefore emitted at
## the top of the next iteration instead of the bottom of this one for
## `for`; `while` has no step and is unaffected.
##
## Phase 0 marks every parameter COwned: the conservative choice, and the
## one Perceus starts from.
fn lower_fn(st: LSt, owner: String, f: TFun) -> (LSt, CFun) = {
  var params: List[CParam] = []
  var i = 0
  for pt in f.sig.param_tys {
    params = params ++ [CParam { sym: f.param_syms[i], ty: pt, mode: COwned }]
    i = i + 1
  }
  var dicts: List[CParam] = []
  for d in f.dict_syms {
    # the checker already typed the hidden dictionary parameters; carrying
    # that type here keeps a backend from having to reach behind Core into
    # the symbol table
    dicts = dicts ++ [CParam { sym: d, ty: sym_ty(st, d, TyError), mode: COwned }]
  }
  let (stl, lid) = fresh_loop(st)
  # spec §12.4 covers plain top-level functions and local named ones. An impl
  # method, a trait default and a test keep the shape they had, so that the
  # rewrite lands in one place at a time.
  let plain = f.impl_of == None && f.default_of == None && not f.is_test
  let sc: Option[SelfCtx] =
    if plain {
      Some(SelfCtx {
        sym: None,
        owner: owner,
        name: f.name,
        caps: [],
        params: f.param_syms,
        ptys: f.sig.param_tys,
        fty: TyUnit,
        loop_id: lid
      })
    } else {
      None
    }
  let st_in = LSt { ..stl, ret_ty: f.sig.ret, self_ctx: sc, tail: true, self_tail: false }
  let (st1, body0) = lower_expr(st_in, f.body)
  # the tail value is a return too
  let body1 = adapt_in(body0, tex_ty(f.body), f.sig.ret)
  let body = wrap_self_loop(st1.self_tail, lid, body1, f.sig.ret)
  (LSt { ..st1, ret_ty: st.ret_ty, self_ctx: st.self_ctx, tail: st.tail, self_tail: st.self_tail }, CFun {
    name: f.name,
    owner: owner,
    captures: [],
    params: params,
    dicts: dicts,
    ret: f.sig.ret,
    body: body,
    is_test: f.is_test,
    impl_of: f.impl_of,
    default_of: f.default_of
  })
}

## Lower one expression on its own: the comptime interpreter's entry, which
## folds a const initializer or a comptime block rather than a function body.
## The lifted lambdas come back with it, because the interpreter has to be
## able to call them.
pub fn lower_expr_only(
  owner: String,
  e: TExpr,
  traits: Traits,
  impls: Impls,
  adts: Adts,
  prog_fns: Map[(String, String), Sig],
  syms: Map[Int, Sym],
  lam_start: Int
) -> (CExpr, List[CFun], Int) = {
  var top = 0
  for k in map.keys(syms) {
    if k > top { top = k }
  }
  let st = LSt {
    next_sym: top + 1,
    next_loop: 0,
    owner: owner,
    cur_loop: -1,
    ret_ty: tex_ty(e),
    syms: syms,
    lifted: [],
    next_lam: lam_start,
    traits: traits,
    impls: impls,
    adts: adts,
    prog_fns: prog_fns,
    dicts: [],
    dict_env: map.empty(),
    self_ctx: None,
    tail: false,
    self_tail: false
  }
  let (st1, ce) = lower_expr(st, e)
  (ce, st1.lifted, st1.next_lam)
}

## Lower a single function, returning it plus whatever lambdas it hoisted.
## The JVM path uses this because it emits one method at a time; the native
## path lowers whole modules.
pub fn lower_fn_only(
  owner: String,
  f: TFun,
  traits: Traits,
  impls: Impls,
  adts: Adts,
  prog_fns: Map[(String, String), Sig],
  syms: Map[Int, Sym],
  # lifted names must be unique across the whole class, not just this
  # function, so the caller seeds and carries the counter
  lam_start: Int
) -> (CFun, List[CFun], List[CDictDef], Int) = {
  var top = 0
  for k in map.keys(syms) {
    if k > top { top = k }
  }
  let st = LSt {
    next_sym: top + 1,
    next_loop: 0,
    owner: owner,
    cur_loop: -1,
    ret_ty: TyUnit,
    syms: syms,
    lifted: [],
    next_lam: lam_start,
    traits: traits,
    impls: impls,
    adts: adts,
    prog_fns: prog_fns,
    dicts: [],
    dict_env: map.empty(),
    self_ctx: None,
    tail: false,
    self_tail: false
  }
  let (st1, cf) = lower_fn(st, owner, f)
  (cf, st1.lifted, st1.dicts, st1.next_lam)
}

pub fn lower_module(
  owner: String,
  tm: TModule,
  traits: Traits,
  impls: Impls,
  adts: Adts,
  prog_fns: Map[(String, String), Sig]
) -> CModule = {
  # temporaries continue above every checker-minted id in this module
  var top = 0
  for k in map.keys(tm.syms) {
    if k > top { top = k }
  }
  var st = LSt {
    next_sym: top + 1,
    next_loop: 0,
    owner: owner,
    cur_loop: -1,
    ret_ty: TyUnit,
    syms: tm.syms,
    lifted: [],
    next_lam: 0,
    traits: traits,
    impls: impls,
    adts: adts,
    prog_fns: prog_fns,
    dicts: [],
    dict_env: map.empty(),
    self_ctx: None,
    tail: false,
    self_tail: false
  }
  var fns: List[CFun] = []
  for f in tm.fns {
    let (st1, cf) = lower_fn(st, owner, f)
    st = st1
    fns = fns ++ [cf]
  }
  # lifted bodies are appended after the source functions; they are ordinary
  # top-level functions from here on and no backend can tell the difference
  CModule { owner: owner, fns: fns ++ st.lifted, dicts: st.dicts }
}

# ---- diagnostics ----

fn node_name(e: TExpr) -> String =
  match e {
    XLambda(_, _, _, _, _, _, _) -> "XLambda"
    XCtorValue(_, _, _, _, _) -> "XCtorValue"
    XConstRef(_, _, _, _) -> "XConstRef"
    XIndex(_, _, _, _, _, _) -> "XIndex"
    _ -> "an unhandled node"
  }

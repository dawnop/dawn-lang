# Known-bad acceptance baseline for #847, not a positive test.
# See docs/mem-capture-scope-design.md section 8 for the required rejection.
use std/mem
type Source = { read: fn(Int) -> Int }
fn bind[T](value: T, read: fn(T, Int) -> Int) -> (fn(Int) -> Int) =
  n => read(value, n)

fn source() -> Source !io = mem.with_mem(() => {
  let cursor = mem.new(1)
  Source { read = bind(cursor, (b: I64Buf, n: Int) => mem.with_mem(() => {
    let offset = mem.at(b, 0)
    mem.set(b, 0, offset + n)
    offset
  })) }
})

pub fn main() -> Unit !io = {
  let s = source()
  println(to_string(s.read(1)))
  println(to_string(s.read(1)))
}

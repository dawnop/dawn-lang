# A qualified constant read through a whole-module alias (LANG-06 step 3),
# beside a local constant of the same simple name -- the case the flat Core
# identity could not express. Both backends resolve the value from the
# declaring module's fold results, so both must print the same four lines.
use limits as lim

const MAX: Int = 7

pub fn main() -> Unit !io = {
  println("local=${MAX}")
  println("qualified=${lim.MAX}")
  println("name=${lim.NAME}")
  println("sum=${MAX + lim.MAX}")
}

-- one resource, and a capture from before the `with` --
  acquire r1
  use r1 for t
  release r1
value          42
-- two `with`s in one block release inside out --
  acquire outer
  acquire inner
  use outer and inner
  release inner
  release outer
value          2
-- `?` in the region: Ok --
  acquire r2
  release r2
ok             Ok(3)
-- `?` in the region: the Err leaves the function, release still runs --
  acquire r2
  release r2
err            Err("bad 2")

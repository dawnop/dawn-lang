# Pure calling rows isolate the K3 propagation rule from domain discharge.
use std/mem
type Source[^c] = { read: fn(Int) -> Int ^{c} }
fn escaped() !io = mem.with_mem([@s] () => {
  let held = [mem.new(3)]
  Source { read = n => len(held[0]) + n }
})
pub fn main() -> Unit !io = { let _ = escaped() }

    EffectCandidates(["Z", "Ask"]), DeclaredEffectInfo(17, EffectI { ..info, id: 18 })])
  assert project(reads, s => None, t => None, id => Some(id + 10), e => None) == Some(expected)
  assert project(reads, s => None, t => None, id => if id == 8 { None } else { Some(id) }, e => None) == None
  assert project(reads, s => None, t => None, id => if id == 7 { None } else { Some(id) }, e => None) == None
}

test "semantic reads preserve diagnostic candidate order and declaration answers" {

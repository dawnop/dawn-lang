# The in-process equivalent of `dawnc emitc`: it uses the native driver's own
# load/analyse/C-emission pipeline, then drops the emitted text before the
# ready barrier. Keeping the barrier in this process makes quiet RSS observable
# without measuring an outer shell or an unrelated cc child.
#
# The pipeline is reached through `cdriver.compile_to_c`, which takes paths and
# returns text. The steps inside it hand checker state to one another, and that
# state is `pub(pkg)` to selfhost; the work done per repetition is the same.
# The pipeline reads files and the environment, so `main` installs the real
# Fs/Proc/Env handlers the way the native driver's own `main` does.
use std/io
use std/io.{Env, Fs, Proc}
use std/str
use selfhost/c/cdriver.{compile_to_c}

fn positive_int(text: String) -> Int =
  match parse_int(text) {
    Some(n) -> if n > 0 { n } else { panic("repetitions must be positive") }
    None -> panic("bad repetition count")
  }

fn emit_once(std_dir: String, target: String) -> Int !Fs !Proc !Env !io =
  match compile_to_c(std_dir, target) {
    Ok(text) -> str.len(text)
    Err(e) -> panic("compiler corpus did not compile: " ++ e)
  }

fn ready(checksum: Int) -> Unit !io = {
  io.println("checksum\t" ++ to_string(checksum))
  io.println("ready")
  while not io.stdin_ready(1000) { }
  let _ = io.read_stdin(1)
  ()
}

pub fn main() -> Unit !io =
  io.with_fs_real(() => io.with_proc_real(() => io.with_env_real(() => run())))

fn run() -> Unit !Fs !Proc !Env !io = {
  match args() {
    [std_dir, target, reps_text] -> {
      let reps = positive_int(reps_text)
      var checksum = 0
      var i = 0
      while i < reps {
        checksum = checksum + emit_once(std_dir, target)
        i = i + 1
      }
      ready(checksum)
    }
    _ -> panic("usage: slab-bench-compiler <std-dir> <target> <repetitions>")
  }
}

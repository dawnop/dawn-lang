# Opaque representation visibility must not supply missing public impls.
use words
fn right_literal(a: words.Bits) -> words.Bits = a & 15
fn left_literal(a: words.Bits) -> words.Bits = 15 | a
fn shift(a: words.Bits) -> words.Bits = a << 2
fn shift_generic[T: Shl](a: T, n: T.ShlAmount) -> T !T.Shl = a << n
fn external_generic(a: words.Bits) -> words.Bits = shift_generic(a, 2)
fn hidden_and(a: words.Hidden) -> words.Hidden = a & a
fn hidden_not(a: words.Hidden) -> words.Hidden = ~a
fn hidden_shift(a: words.Hidden) -> words.Hidden = a << 2

# Declaration keys describe provenance and lexical ownership, not validity.
# A stable name can acquire a new signature or lookup environment; consumers
# must validate those inputs separately before reusing a semantic product.
# Repeated parent declarations poison their descendants as well as themselves.
use std/map
use std/list
use std/str
use front/parser
use front/token.{Diag, DiagOwner}
use front/ast.{Module, TypeRef, TNamed, TQual, TAssoc, TTuple, TFn, EffArg,
  DFn, DType, DTrait, DEffect, DConst, DImpl, DTest, DUseModule, DUseJava, e_lo, e_hi }

pub type ModuleKey = { world: String, logical_module: String, emission_owner: String, source: String }

## The loader/session supplies resolved provenance; this layer never guesses
## a package identity from a display path or a checker allocation number.
pub fn module_key(world: String, logical_module: String, emission_owner: String, source: String) -> ModuleKey =
  ModuleKey { world: world, logical_module: logical_module, emission_owner: emission_owner, source: source }
pub type Kind =
  | FunctionDecl
  | TypeDecl
  | TraitDecl
  | EffectDecl
  | ConstDecl
  | TestDecl
  | MethodDecl
  | ConstructorDecl
  | OperationDecl
  | ParameterDefault
  | AssociatedTypeDecl
  | AssociatedEffectDecl

pub type EffectShape =
  | NamedEffect(name: String)
  | ProjectedEffect(slot: Int, member: String)

pub type TypeShape =
  | BoundType(slot: Int)
  | NamedType(name: String, args: List[TypeShape], effects: List[List[EffectShape]])
  | QualifiedType(owner: String, name: String, args: List[TypeShape], effects: List[List[EffectShape]])
  | AssociatedType(subject: TypeShape, member: String)
  | TupleType(elems: List[TypeShape])
  | FunctionType(params: List[TypeShape], ret: TypeShape, effects: List[EffectShape])

pub type Part =
  | Named(kind: Kind, name: String)
  | ImplHead(trait_name: String, subject: TypeShape)

pub type DeclKey = { scope: ModuleKey, path: List[Part] }
## Indices locate the current syntax only. They do not participate in keys.
pub type Entry = { key: DeclKey, declaration: Int, member: Option[Int] }

## Where a declaration sits in the revision that was parsed, in code points.
## A span is the part of an entry that an edit anywhere in the file can move,
## which is why it is kept outside the key rather than inside it.
pub type Span = { lo: Int, hi: Int }

## An entry and the span of the syntax it was read off.
pub type Located = { entry: Entry, span: Span }

## The per-revision answer to "where does the declaration with this key start
## and end". Consumers that hold a position relative to a declaration resolve
## it against this view at render or lower time, so an edit outside the
## declaration moves the answer without invalidating the declaration's own
## semantic product.
## Addressed by the text of the declaration's path rather than by the key
## itself, for two reasons. A consumer below the checker cannot name a
## `DeclKey` at all, which is the case a diagnostic is in. And a key's scope
## names the analysis owner, so keeping it here would make one revision's
## positions differ between a cold run and a session that analyzed the same
## text. A path is unique inside a view because a view belongs to one module
## and a repeated path is dropped from it.
pub type DeclSpans = { by_path: Map[String, Span] }

fn effect_atom(name: String, binders: List[String]) -> EffectShape = {
  let parts = str.split(name, ".")
  if len(parts) == 2 {
    var i = 0
    for binder in binders {
      if parts[0] == binder { return ProjectedEffect(i, parts[1]) }
      i = i + 1
    }
  }
  NamedEffect(name)
}

fn effect_atoms(names: List[String], binders: List[String]) -> List[EffectShape] =
  map(names, name => effect_atom(name, binders))

fn effects(es: List[EffArg], binders: List[String]) -> List[List[EffectShape]] =
  map(es, e => effect_atoms(e.atoms, binders))

fn shapes(ts: List[TypeRef], binders: List[String]) -> List[TypeShape] =
  map(ts, t => type_shape(t, binders))

fn bare(name: String, binders: List[String]) -> TypeShape = {
  var i = 0
  for b in binders {
    if b == name { return BoundType(i) }
    i = i + 1
  }
  NamedType(name, [], [])
}

pub fn type_shape(t: TypeRef, binders: List[String]) -> TypeShape =
  match t {
    TNamed(name, args, es, _, _) ->
      if len(args) == 0 && len(es) == 0 { bare(name, binders) }
      else { NamedType(name, shapes(args, binders), effects(es, binders)) }
    TQual(owner, name, args, es, _, _) -> QualifiedType(owner, name, shapes(args, binders), effects(es, binders))
    TAssoc(subject, name, _, _) -> AssociatedType(bare(subject, binders), name)
    TTuple(es, _, _) -> TupleType(shapes(es, binders))
    TFn(ps, ret, es, _, _) -> FunctionType(shapes(ps, binders), type_shape(ret, binders), effect_atoms(es, binders))
  }

## A declaration path written as text, injectively: every atom carries its
## own length, so distinct paths cannot spell the same string and no escape
## table has to be kept in step with the shapes. Nothing decodes this; it
## exists so a consumer below the checker can carry a declaration's identity
## without naming a `DeclKey`.
pub fn path_text(path: List[Part]) -> String = {
  var out = ""
  for part in path { out = out ++ part_text(part) }
  out
}

fn atom(s: String) -> String = to_string(str.len(s)) ++ ":" ++ s

fn part_text(part: Part) -> String =
  match part {
    Named(kind, name) -> "N" ++ kind_text(kind) ++ atom(name)
    ImplHead(trait_name, subject) -> "I" ++ atom(trait_name) ++ shape_text(subject)
  }

fn kind_text(k: Kind) -> String =
  match k {
    FunctionDecl -> "f"
    TypeDecl -> "t"
    TraitDecl -> "r"
    EffectDecl -> "e"
    ConstDecl -> "c"
    TestDecl -> "s"
    MethodDecl -> "m"
    ConstructorDecl -> "k"
    OperationDecl -> "o"
    ParameterDefault -> "d"
    AssociatedTypeDecl -> "a"
    AssociatedEffectDecl -> "b"
  }

fn shapes_text(ts: List[TypeShape]) -> String = {
  var out = to_string(len(ts)) ++ ";"
  for t in ts { out = out ++ shape_text(t) }
  out
}

fn effect_row_text(es: List[EffectShape]) -> String = {
  var out = to_string(len(es)) ++ ";"
  for e in es { out = out ++ effect_text(e) }
  out
}

fn effect_rows_text(es: List[List[EffectShape]]) -> String = {
  var out = to_string(len(es)) ++ ";"
  for row in es { out = out ++ effect_row_text(row) }
  out
}

fn effect_text(e: EffectShape) -> String =
  match e {
    NamedEffect(name) -> "e" ++ atom(name)
    ProjectedEffect(slot, member) -> "p" ++ atom(to_string(slot)) ++ atom(member)
  }

fn shape_text(t: TypeShape) -> String =
  match t {
    BoundType(slot) -> "b" ++ atom(to_string(slot))
    NamedType(name, args, es) -> "n" ++ atom(name) ++ shapes_text(args) ++ effect_rows_text(es)
    QualifiedType(owner, name, args, es) ->
      "q" ++ atom(owner) ++ atom(name) ++ shapes_text(args) ++ effect_rows_text(es)
    AssociatedType(subject, member) -> "a" ++ shape_text(subject) ++ atom(member)
    TupleType(elems) -> "t" ++ shapes_text(elems)
    FunctionType(params, ret, es) -> "F" ++ shapes_text(params) ++ shape_text(ret) ++ effect_row_text(es)
  }

fn entry(scope: ModuleKey, path: List[Part], declaration: Int, member: Option[Int]) -> Entry =
  Entry { key: DeclKey { scope: scope, path: path }, declaration: declaration, member: member }

fn located_entry(scope: ModuleKey, path: List[Part], declaration: Int, member: Option[Int],
  lo: Int, hi: Int) -> Located =
  Located { entry: entry(scope, path, declaration, member), span: Span { lo: lo, hi: hi } }

## Imports are environment inputs rather than independently checked bodies.
## Reordering an unambiguous declaration changes only its syntax locator.
##
## Spans come off the same syntax node as the key, so they are collected here
## rather than by a second walk: a separate pass would read the tree twice and
## could disagree with this one about which declarations survive.
pub fn located(scope: ModuleKey, m: Module) -> List[Located] = {
  var all: List[Located] = []
  var i = 0
  for d in m.decls {
    match d {
      DFn(f) -> {
        let path = [Named(FunctionDecl, f.name)]
        all = all ++ [located_entry(scope, path, i, None, f.lo, f.hi)]
        var p = 0
        for param in f.params {
          var same = 0
          for other in f.params { if other.name == param.name { same = same + 1 } }
          if same == 1 {
            match param.default {
              ## A parameter's own span is its name token, so the default
              ## expression is the whole of what this entry owns.
              Some(dflt) -> {
                all = all ++ [located_entry(scope, path ++ [Named(ParameterDefault, param.name)], i, Some(p),
                  e_lo(dflt), e_hi(dflt))]
              }
              None -> ()
            }
          }
          p = p + 1
        }
      }
      DType(t) -> {
        let path = [Named(TypeDecl, t.name)]
        all = all ++ [located_entry(scope, path, i, None, t.lo, t.hi)]
        var c = 0
        for ctor in t.ctors {
          all = all ++ [located_entry(scope, path ++ [Named(ConstructorDecl, ctor.name)], i, Some(c), ctor.lo, ctor.hi)]
          c = c + 1
        }
      }
      DTrait(name, _, _, _, methods, associated, effect_members, _, lo, hi, _, _) -> {
        let path = [Named(TraitDecl, name)]
        all = all ++ [located_entry(scope, path, i, None, lo, hi)]
        var j = 0
        for method in methods {
          all = all ++ [located_entry(scope, path ++ [Named(MethodDecl, method.name)], i, Some(j), method.lo, method.hi)]
          j = j + 1
        }
        j = 0
        for member in associated {
          all = all ++ [located_entry(scope, path ++ [Named(AssociatedTypeDecl, member.name)], i, Some(j),
            member.lo, member.hi)]
          j = j + 1
        }
        j = 0
        for member in effect_members {
          all = all ++ [located_entry(scope, path ++ [Named(AssociatedEffectDecl, member.name)], i, Some(j),
            member.lo, member.hi)]
          j = j + 1
        }
      }
      DEffect(e) -> {
        let path = [Named(EffectDecl, e.name)]
        all = all ++ [located_entry(scope, path, i, None, e.lo, e.hi)]
        var j = 0
        for op in e.ops {
          all = all ++ [located_entry(scope, path ++ [Named(OperationDecl, op.name)], i, Some(j), op.lo, op.hi)]
          j = j + 1
        }
      }
      DConst(name, _, _, _, lo, hi, _, _) -> {
        all = all ++ [located_entry(scope, [Named(ConstDecl, name)], i, None, lo, hi)]
      }
      DTest(name, _, lo, hi, _, _) -> {
        all = all ++ [located_entry(scope, [Named(TestDecl, name)], i, None, lo, hi)]
      }
      DImpl(params, trait_name, _, _, subject, methods, associated, effect_members, lo, hi) -> {
        let path = [ImplHead(trait_name, type_shape(subject, map(params, p => p.name)))]
        all = all ++ [located_entry(scope, path, i, None, lo, hi)]
        var j = 0
        for method in methods {
          all = all ++ [located_entry(scope, path ++ [Named(MethodDecl, method.name)], i, Some(j), method.lo, method.hi)]
          j = j + 1
        }
        j = 0
        for member in associated {
          all = all ++ [located_entry(scope, path ++ [Named(AssociatedTypeDecl, member.name)], i, Some(j),
            member.lo, member.hi)]
          j = j + 1
        }
        j = 0
        for member in effect_members {
          all = all ++ [located_entry(scope, path ++ [Named(AssociatedEffectDecl, member.name)], i, Some(j),
            member.lo, member.hi)]
          j = j + 1
        }
      }
      DUseModule(_, _, _, _, _, _, _) -> ()
      DUseJava(_, _, _, _, _) -> ()
    }
    i = i + 1
  }
  var counts: Map[List[Part], Int] = map.empty()
  for e in all {
    counts = map.insert(counts, e.entry.key.path, map.get(counts, e.entry.key.path).unwrap_or(0) + 1)
  }
  var out: List[Located] = []
  for e in all {
    var unique = true
    var depth = 1
    while depth <= len(e.entry.key.path) {
      if map.get(counts, list.take(e.entry.key.path, depth)) != Some(1) { unique = false }
      depth = depth + 1
    }
    if unique { out = out ++ [e] }
  }
  out
}

pub fn declarations(scope: ModuleKey, m: Module) -> List[Entry] =
  map(located(scope, m), l => l.entry)

## One revision's position view. A key a duplicate parent poisons is absent
## here for the same reason it is absent from `declarations`: the view never
## picks one of two declarations that claim the same key.
pub fn spans_of(ls: List[Located]) -> DeclSpans = {
  var out: Map[String, Span] = map.empty()
  for l in ls { out = map.insert(out, path_text(l.entry.key.path), l.span) }
  DeclSpans { by_path: out }
}

## The scope a view is read under does not reach the view, so it is the one
## that says nothing. Keeping the walk scoped keeps it the same walk the key
## enumeration uses, which is what makes the two agree about which
## declarations survive.
fn unscoped() -> ModuleKey = module_key("", "", "", "")

pub fn declaration_spans(m: Module) -> DeclSpans = spans_of(located(unscoped(), m))

pub fn span_of(view: DeclSpans, key: DeclKey) -> Option[Span] = span_at(view, path_text(key.path))

pub fn span_at(view: DeclSpans, decl: String) -> Option[Span] = map.get(view.by_path, decl)

## Where each declaration of this module starts, addressed the same way. The
## checker uses it to decide whether it can name the declaration it is about
## to enter, and to measure that declaration's diagnostics from it.
pub fn declaration_starts(m: Module) -> Map[String, Int] = {
  var out: Map[String, Int] = map.empty()
  for l in located(unscoped(), m) { out = map.insert(out, path_text(l.entry.key.path), l.span.lo) }
  out
}

## The one place a diagnostic's `lo`/`hi` become positions in a revision.
## An owner names its module and its declaration; the views are this
## revision's, so a declaration that moved answers with where it moved to.
## A diagnostic with no owner is already absolute, and so is one whose owner
## this revision cannot locate, which is the same conservative answer the
## checker gave when it declined to make the diagnostic relative.
pub fn absolute(views: Map[String, DeclSpans], d: Diag) -> Diag =
  match d.owner {
    None -> d
    Some(owner) -> match map.get(views, owner.module) {
      None -> d
      Some(view) -> match span_at(view, owner.decl) {
        None -> d
        Some(sp) -> Diag { ..d, lo: sp.lo + d.lo, hi: sp.lo + d.hi, owner: None }
      }
    }
  }

test "identity removes positions and normalizes impl type binders" {
  let a = TNamed("List", [TNamed("T", [], [], 5, 6)], [], 0, 7)
  let b = TNamed("List", [TNamed("U", [], [], 50, 51)], [], 40, 60)
  assert type_shape(a, ["T"]) == type_shape(b, ["U"])
  assert type_shape(a, []) != type_shape(b, [])
  assert type_shape(TQual("a", "X", [], [], 0, 1), []) != type_shape(TQual("b", "X", [], [], 0, 1), [])
}

fn fixture_scope() -> ModuleKey =
  ModuleKey { world: "session", logical_module: "pkg/m", emission_owner: "pkg/m", source: "m.dawn" }

fn fixture_module(source: String) -> Module = {
  let (m, ds) = parser.parse_module(source)
  if len(ds) != 0 { panic("identity fixture parse failed: " ++ ds[0].msg) }
  m
}

fn fixture_entries(source: String) -> List[Entry] =
  declarations(fixture_scope(), fixture_module(source))

fn named_key(es: List[Entry], path: List[Part]) -> Option[DeclKey] = {
  for e in es { if e.key.path == path { return Some(e.key) } }
  None
}

test "identity survives body edits and declaration reorder but not rename or world changes" {
  let old = fixture_entries("fn f(x: Int = 1) -> Int = x\nfn g() -> Int = 2\n")
  let next = fixture_entries("# moved\nfn g() -> Int = 3\nfn f(x: Int = 1) -> Int = { let y = x + 1\n y }\n")
  let path = [Named(FunctionDecl, "f")]
  assert named_key(old, path) == named_key(next, path)
  assert named_key(old, path ++ [Named(ParameterDefault, "x")]) == named_key(next, path ++ [Named(ParameterDefault, "x")])
  assert old[0].declaration == 0 && next[1].declaration == 1
  assert named_key(next, [Named(FunctionDecl, "renamed")]) == None
  let key = named_key(old, path).expect("unique function")
  assert key != DeclKey { ..key, scope: ModuleKey { ..key.scope, world: "other" } }
  assert key != DeclKey { ..key, scope: ModuleKey { ..key.scope, emission_owner: "other" } }
  assert key != DeclKey { ..key, scope: ModuleKey { ..key.scope, source: "other.dawn" } }
}

test "identity rejects duplicate parents and alpha-renamed duplicate impl heads" {
  assert fixture_entries("effect Ask { fn a() -> Int }\neffect Ask { fn b() -> Int }\n") == []
  assert fixture_entries("fn f(x: Int = 1) -> Int = x\nfn f(y: Int = 2) -> Int = y\n") == []
  assert fixture_entries("impl[T] P[List[T]] { fn a(x: List[T]) -> Int = 1 }\n" ++
      "impl[U] P[List[U]] { fn b(x: List[U]) -> Int = 2 }\n") == []
  let es = fixture_entries("fn f(x: Int = 1, x: Int) -> Int = x\n")
  assert len(es) == 1
  assert es[0].key.path == [Named(FunctionDecl, "f")]
}

test "identity keeps resolved module provenance and distinct member owners" {
  let (m, ds) = parser.parse_module("effect A { fn op() -> Int }\neffect B { fn op() -> Int }\n")
  assert len(ds) == 0
  let scope = fixture_scope()
  let old = declarations(scope, m)
  assert len(old) == 4
  assert old[1].key != old[3].key
  assert old[1].key.scope == scope
  for changed in [ModuleKey { ..scope, world: "other" }, ModuleKey { ..scope, logical_module: "other" },
    ModuleKey { ..scope, emission_owner: "other" }, ModuleKey { ..scope, source: "other" }] {
    let next = declarations(changed, m)
    assert next[1].key.scope == changed
    assert old[1].key != next[1].key
  }
}

test "identity normalizes associated effect subjects without merging module spellings" {
  let ret = TNamed("Int", [], [], 0, 3)
  let a = TFn([], ret, ["T.E", "io"], 0, 10)
  let b = TFn([], ret, ["U.E", "io"], 50, 70)
  assert type_shape(a, ["T"]) == type_shape(b, ["U"])
  assert type_shape(a, ["T"]) != type_shape(TFn([], ret, ["T.F", "io"], 0, 10), ["T"])
  assert effect_atom("m.Ask", ["T"]) == NamedEffect("m.Ask")
  assert effect_atom("T.E", ["X", "T"]) == ProjectedEffect(1, "E")
  let arg = EffArg { atoms: ["T.E"], lo: 0, hi: 3 }
  let renamed = EffArg { atoms: ["U.E"], lo: 100, hi: 103 }
  assert type_shape(TNamed("Box", [], [arg], 0, 8), ["T"]) ==
    type_shape(TNamed("Box", [], [renamed], 90, 110), ["U"])
  assert type_shape(TQual("m", "Box", [], [arg], 0, 8), ["T"]) ==
    type_shape(TQual("m", "Box", [], [renamed], 90, 110), ["U"])
}

test "identity indexes associated declarations and bindings under their own parents" {
  let es = fixture_entries("trait P[T] { type Item\n effect E\n fn value(x: T) -> Int }\n" ++
      "impl P[Int] { type Item = Int\n effect E = !()\n fn value(x: Int) -> Int = x }\n")
  assert len(es) == 8
  let trait_path = [Named(TraitDecl, "P")]
  let impl_path = [ImplHead("P", NamedType("Int", [], []))]
  assert named_key(es, trait_path ++ [Named(AssociatedTypeDecl, "Item")]) != None
  assert named_key(es, trait_path ++ [Named(AssociatedEffectDecl, "E")]) != None
  assert named_key(es, impl_path ++ [Named(AssociatedTypeDecl, "Item")]) != None
  assert named_key(es, impl_path ++ [Named(AssociatedEffectDecl, "E")]) != None
  let duplicated = fixture_entries("trait P[T] { type Item\n type Item\n effect E\n fn value(x: T) -> Int }\n")
  assert named_key(duplicated, trait_path ++ [Named(AssociatedTypeDecl, "Item")]) == None
  assert named_key(duplicated, trait_path ++ [Named(AssociatedEffectDecl, "E")]) != None
}

fn fixture_spans(source: String) -> DeclSpans = declaration_spans(fixture_module(source))

fn fixture_key(path: List[Part]) -> DeclKey = DeclKey { scope: fixture_scope(), path: path }

fn span_text(source: String, view: DeclSpans, path: List[Part]) -> Option[String] =
  match span_of(view, fixture_key(path)) {
    Some(sp) -> Some(str.slice(source, sp.lo, sp.hi))
    None -> None
  }

fn encloses(outer: Span, inner: Span) -> Bool = outer.lo < inner.lo && inner.hi <= outer.hi

test "declaration spans slice the revision they were read from" {
  let source = "## doc\nfn f() -> Int = 1\ntype Choice = Item(value: Int) | Empty\nconst K: Int = 7\n"
  let view = fixture_spans(source)
  assert span_text(source, view, [Named(FunctionDecl, "f")]) == Some("fn f() -> Int = 1")
  assert span_text(source, view, [Named(TypeDecl, "Choice")]) == Some("type Choice = Item(value: Int) | Empty")
  assert span_text(source, view, [Named(ConstDecl, "K")]) == Some("const K: Int = 7")
  assert span_of(view, fixture_key([Named(FunctionDecl, "absent")])) == None
  assert span_of(view, fixture_key([Named(FunctionDecl, "f")])).expect("f is declared once").lo ==
    str.index_of(source, "fn f").expect("f is in the source")
}

test "a reorder keeps the keys and moves their spans" {
  let old = "fn f(x: Int = 1) -> Int = x\nfn g() -> Int = 2\n"
  let next = "# moved\nfn g() -> Int = 2\nfn f(x: Int = 1) -> Int = x\n"
  let f = [Named(FunctionDecl, "f")]
  let g = [Named(FunctionDecl, "g")]
  let dflt = f ++ [Named(ParameterDefault, "x")]
  let old_view = fixture_spans(old)
  let next_view = fixture_spans(next)
  let old_keys = map(located(fixture_scope(), fixture_module(old)), l => l.entry.key)
  let next_keys = map(located(fixture_scope(), fixture_module(next)), l => l.entry.key)
  assert len(old_keys) == len(next_keys)
  for k in old_keys { assert list.contains(next_keys, k) }
  assert span_of(old_view, fixture_key(f)) != span_of(next_view, fixture_key(f))
  assert span_of(old_view, fixture_key(g)) != span_of(next_view, fixture_key(g))
  assert span_text(old, old_view, f) == span_text(next, next_view, f)
  assert span_text(old, old_view, g) == span_text(next, next_view, g)
  # A parameter's span is its name token, so the default's own syntax is what
  # the entry for it points at.
  assert span_text(old, old_view, dflt) == Some("1")
  assert span_text(next, next_view, dflt) == Some("1")
  assert span_of(old_view, fixture_key(dflt)) != span_of(next_view, fixture_key(dflt))
}

test "a duplicated declaration is absent from the view rather than picking one" {
  let source = "fn f() -> Int = 1\nfn f() -> Int = 2\nfn g() -> Int = 3\n"
  let view = fixture_spans(source)
  assert span_of(view, fixture_key([Named(FunctionDecl, "f")])) == None
  assert span_text(source, view, [Named(FunctionDecl, "g")]) == Some("fn g() -> Int = 3")
  let poisoned = fixture_spans("effect Ask { fn a() -> Int }\neffect Ask { fn b() -> Int }\n")
  assert span_of(poisoned, fixture_key([Named(EffectDecl, "Ask")])) == None
  assert span_of(poisoned, fixture_key([Named(EffectDecl, "Ask"), Named(OperationDecl, "a")])) == None
}

test "a member span sits inside the span of the declaration that owns it" {
  let source = "type Choice = Item(value: Int) | Empty\n" ++
    "trait P[T] { type Item\n effect E\n fn value(x: T) -> Int }\n" ++
    "impl P[Int] { type Item = Int\n effect E = !()\n fn value(x: Int) -> Int = x }\n" ++
    "effect Ask { fn ask() -> Int }\n"
  let view = fixture_spans(source)
  let choice = [Named(TypeDecl, "Choice")]
  let trait_path = [Named(TraitDecl, "P")]
  let impl_path = [ImplHead("P", NamedType("Int", [], []))]
  let ask = [Named(EffectDecl, "Ask")]
  let pairs = [
    (choice, choice ++ [Named(ConstructorDecl, "Item")]),
    (trait_path, trait_path ++ [Named(MethodDecl, "value")]),
    (trait_path, trait_path ++ [Named(AssociatedTypeDecl, "Item")]),
    (trait_path, trait_path ++ [Named(AssociatedEffectDecl, "E")]),
    (impl_path, impl_path ++ [Named(MethodDecl, "value")]),
    (impl_path, impl_path ++ [Named(AssociatedTypeDecl, "Item")]),
    (impl_path, impl_path ++ [Named(AssociatedEffectDecl, "E")]),
    (ask, ask ++ [Named(OperationDecl, "ask")])
  ]
  for pair in pairs {
    let (parent, member) = pair
    let outer = span_of(view, fixture_key(parent)).expect("parent is declared once")
    let inner = span_of(view, fixture_key(member)).expect("member is declared once")
    assert encloses(outer, inner)
  }
  assert span_text(source, view, choice ++ [Named(ConstructorDecl, "Item")]) == Some("Item(value: Int)")
  assert span_text(source, view, ask ++ [Named(OperationDecl, "ask")]) == Some("fn ask() -> Int")
}

fn start_of(view: DeclSpans, path: List[Part]) -> Option[Int] =
  match span_of(view, fixture_key(path)) {
    Some(sp) -> Some(sp.lo)
    None -> None
  }

test "declaration path text separates paths that share a spelling" {
  assert path_text([Named(FunctionDecl, "f")]) != path_text([Named(TestDecl, "f")])
  assert path_text([Named(FunctionDecl, "ab")]) !=
    path_text([Named(FunctionDecl, "a"), Named(FunctionDecl, "b")])
  assert path_text([ImplHead("P", NamedType("Int", [], []))]) !=
    path_text([ImplHead("P", NamedType("Bool", [], []))])
  assert path_text([ImplHead("P", NamedType("List", [BoundType(0)], []))]) ==
    path_text([ImplHead("P", NamedType("List", [BoundType(0)], []))])
}

test "declaration starts answer exactly what the span view answers" {
  let source = "fn f() -> Int = 1\nfn g() -> Int = 2\nfn f() -> Int = 3\n"
  let starts = declaration_starts(fixture_module(source))
  let view = fixture_spans(source)
  let g = [Named(FunctionDecl, "g")]
  assert map.get(starts, path_text(g)) == start_of(view, g)
  assert map.get(starts, path_text(g)) != None
  # a duplicate is nameable in neither, so the checker declines to measure
  # from it and the renderer is never asked to place it
  let f = [Named(FunctionDecl, "f")]
  assert map.get(starts, path_text(f)) == None
  assert start_of(view, f) == None
}

test "a diagnostic resolves against the revision being rendered" {
  let source = "fn f() -> Int = 1\nfn g() -> Int = true\n"
  let moved = "# a comment above everything else\n" ++ source
  let owner = DiagOwner { module: "pkg/m", decl: path_text([Named(FunctionDecl, "g")]) }
  let raised = Diag { msg: "type mismatch", lo: 16, hi: 20, hint: "", owner: Some(owner) }
  let here = absolute(map.from([("pkg/m", fixture_spans(source))]), raised)
  let there = absolute(map.from([("pkg/m", fixture_spans(moved))]), raised)
  let g_here = str.index_of(source, "fn g").expect("g is in the source")
  let g_there = str.index_of(moved, "fn g").expect("g is in the moved source")
  assert g_here != g_there
  assert here == Diag { msg: "type mismatch", lo: g_here + 16, hi: g_here + 20, hint: "", owner: None }
  assert there == Diag { ..here, lo: g_there + 16, hi: g_there + 20 }
  # an owner this revision cannot place keeps the positions it came with
  # rather than inventing a base for them, and so does a diagnostic that
  # never had an owner
  let no_views: Map[String, DeclSpans] = map.empty()
  assert absolute(no_views, raised) == raised
  assert absolute(map.from([("other", fixture_spans(source))]), raised) == raised
  let already = Diag { ..raised, owner: None }
  assert absolute(map.from([("pkg/m", fixture_spans(source))]), already) == already
}

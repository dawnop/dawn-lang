# expect: unclosed `{`	this `{` is probably missing its own `}`	note	867	868	this `}` closes it but is indented differently, so it probably belongs to an outer `{`	note	886	889	expected `}` before this declaration
# The `for` block lost its `}` and takes the function's. The function body
# used to run on to the end of the file: each later `pub fn` and `test` was a
# broken statement with an error of its own, the private `fn` was swallowed
# as a local function with none, and the whole first function was dropped.
# A second pass now closes the body before `pub fn names`, the next
# declaration head at column 0, and parses again (#789): one report, at the
# `for`'s `{`, and every later declaration is back at top level.
pub fn public_types() -> List[Int] = {
  var out: List[Int] = []
  for info in inventory() {
    if info > 0 { out = out ++ [info] }

  out
}

## Their names.
pub fn names() -> List[String] = map(public_types(), info => "${info}")

fn helper(x: Int) -> Int = x + 1

test "helper adds one" {
  assert helper(1) == 2
}

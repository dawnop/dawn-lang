# `pipe_expr = or_expr { "|>" or_expr }`: the right side is one or_expr, so the
# pipe associates to the left and this is `add(add(1, 2), 3)`. Parsed at pipe
# level the right side would swallow the second stage and the call would be
# built inside out.
#
# `add` is commutative so that a mutant which reorders arguments cannot redden
# this file: the subject is which expression the right side is, not where the
# left side lands in it.
fn add(a: Int, b: Int) -> Int = a + b

pub fn main() -> Unit !io = println("${1 |> add(2) |> add(3)}")

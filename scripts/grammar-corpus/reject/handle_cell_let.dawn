# expect: a handler's state cell is declared with `var`, not `let`
# expect: a trailing closure must use a tail block
# expect: allowed at module top level
# A cell is mutable by definition -- the arms write it -- so `let` is not the
# spelling, and the arm slot is where a reader lands with it.
effect Ask {
  fn ask() -> Int
}

fn f() -> Int = {
  with handle Ask {
    let n: Int = 0
    ask() => 1
  }
  ask()
}

# A record whose only constructor name is already taken (here by an earlier
# sum type) used to lose that constructor, so the field access below indexed
# an empty constructor list and the checker panicked (#615). The duplicate
# diagnostic must be the only thing reported.
type Other = Buf(n: Int)

type Buf = { name: String }

fn name_of(b: Buf) -> String = b.name

pub fn main() -> Unit !io = {
  ()
}

# checker.dawn: a labelled closure at the three assignability doors
use std/io

effect Ask { fn get() -> Int }

alias IoFn = fn() -> Int !io

pub fn via_let() -> Int !Ask = {
  let g: IoFn = () => get()
  g()
}

pub fn via_return() -> IoFn = () => get()

pub fn via_assign() -> Int !Ask = {
  var g: IoFn = () => 1
  g = () => get()
  g()
}

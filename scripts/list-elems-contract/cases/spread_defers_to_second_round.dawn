# A spread whose operand needs an expectation is checked in the *second* round,
# after the siblings that type themselves. Written after the spread on purpose:
# the element that settles the type comes later in the source, so only the
# reordering can make this type, and no annotation is present to do it instead.
fn f() -> Int = {
  let out = [..[], Some(1)]
  len(out)
}

pub fn main() -> Unit = ()

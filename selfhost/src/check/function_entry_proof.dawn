# A saved dictionary frame is evidence to verify, never a candidate context.
# Re-enter the actual candidate signature in a temporary immutable context and
# compare entry-only products with its canonical allocations. This proves no
# body expression, call witness, source pairing, or complete dependency log;
# production replay admission remains a separate, stronger boundary.
use std/map
use check/checker
use check/cx.{Cx, Frame, slot_of}
use check/types.{Sig, Sym, Ty, TyVar, TyInt, TyFloat, TyBool, TyUnit, EPure}
use check/body_product.{Product}
use check/identity
use check/passes
use front/ast.{FnDecl, TypeRef, TNamed}
use check/semantic_reads.{FunctionRead, TraitName, StdModuleMode}

type ProofData = { cx: Cx, parameters: List[Int], dictionaries: List[Int] }
pub opaque type Proof = ProofData

pub(pkg) fn context(proof: Proof) -> Cx = { let value: ProofData = proof
  value.cx }
pub fn parameters(proof: Proof) -> List[Int] = { let value: ProofData = proof
  value.parameters }
pub fn dictionaries(proof: Proof) -> List[Int] = { let value: ProofData = proof
  value.dictionaries }

fn primitive(ty: Ty) -> Bool = match ty {
  TyInt -> true, TyFloat -> true, TyBool -> true, TyUnit -> true, _ -> false
}

fn written_type(source: TypeRef, ty: Ty, signature: Sig) -> Bool = match source {
  TNamed(name, args, effects, _, _) -> {
    if len(args) != 0 || len(effects) != 0 { return false }
    match ty {
      TyInt -> name == "Int"
      TyFloat -> name == "Float"
      TyBool -> name == "Bool"
      TyUnit -> name == "Unit"
      TyVar(binder, _) -> {
        if name != binder { return false }
        for own in signature.tparams { if own == ty { return true } }
        false
      }
      _ -> false
    }
  }
  _ -> false
}

# Only canonical entry reads belong here. If entry grows another query
# family, refuse until its meaning is reviewed; never skip an unknown fact.
fn entry_prefix(saved: List[FunctionRead], canonical: List[FunctionRead]) -> Bool = {
  if len(canonical) == 0 || len(saved) < len(canonical) { return false }
  for index in 0..len(canonical) {
    match (canonical[index], saved[index]) {
      (TraitName(id, name), TraitName(other_id, other_name)) -> {
        if id != other_id || name != other_name { return false }
      }
      _ -> return false
    }
  }
  true
}

test "bounded entry prefix requires complete ordered canonical trait names" {
  let first = TraitName(10, "Scale")
  let second = TraitName(20, "Stamp")
  assert entry_prefix([first, second], [first, second])
  assert entry_prefix([first, second, StdModuleMode(false)], [first, second])
  assert not entry_prefix([], [first])
  assert not entry_prefix([first], [first, second])
  assert not entry_prefix([second, first], [first, second])
  assert not entry_prefix([TraitName(11, "Scale")], [first])
  assert not entry_prefix([TraitName(10, "Renamed")], [first])
  assert not entry_prefix([StdModuleMode(false)], [StdModuleMode(false)])
  assert not entry_prefix([first, StdModuleMode(false)], [first, StdModuleMode(false)])
  assert not entry_prefix([first], [])
}

## Entry-only, not permission to replay. The product must already be paired
## and projected by the caller; no historical Cx is accepted or retained.
##
## `candidate.diags` is the scheduler's running list, so it holds whatever
## the bodies checked before this one reported. Those are not this entry's:
## every diagnostic question below asks whether the entry itself appended one,
## by length against the list it started from, never whether the list is empty.
pub(pkg) fn prove(candidate: Cx, declaration: FnDecl, signature: Sig, product: Product) -> Option[Proof] = {
  if candidate.in_test || candidate.frame.isolated ||
    candidate.owner_lo != declaration.lo || product.owner_decl != candidate.owner_decl ||
    signature.owner != candidate.owner_class || signature.name != declaration.name ||
    map.get(candidate.fns, declaration.name) != Some(signature) ||
    product.tree.name != declaration.name || product.tree.sig != signature { return None }
  if signature.inferring || signature.is_builtin || signature.trait_id != None || signature.op_of != None ||
    signature.eff != EPure || len(signature.eparams) != 0 || len(declaration.eparams) != 0 || len(declaration.effs) != 0 ||
    not primitive(signature.ret) || len(signature.constraints) == 0 ||
    len(signature.tparams) != len(declaration.tparams) ||
    len(signature.constraints) != len(signature.tparams) ||
    len(signature.param_tys) != len(declaration.params) ||
    len(signature.param_names) != len(declaration.params) ||
    len(signature.param_defaults) != len(declaration.params) ||
    slot_of(candidate) != len(signature.tparams) { return None }
  for present in signature.param_defaults { if present { return None } }
  let result = declaration.ret?
  if not written_type(result, signature.ret, signature) { return None }
  var index = 0
  for parameter in declaration.tparams {
    match signature.tparams[index] {
      TyVar(name, id) -> {
        if name != parameter.name || identity.pack(candidate.owner_decl, index) != Some(id) ||
          map.get(candidate.current_tparam_bounds, id) != Some(signature.constraints[index]) { return None }
      }
      _ -> return None
    }
    index = index + 1
  }
  let (resolved, bounds) = passes.resolve_bounds(candidate, declaration.tparams)
  if len(resolved.diags) != len(candidate.diags) || bounds != signature.constraints { return None }
  index = 0
  for parameter in declaration.params {
    match parameter.default { Some(_) -> return None, None -> () }
    if parameter.name != signature.param_names[index] ||
      not written_type(parameter.tref, signature.param_tys[index], signature) { return None }
    index = index + 1
  }
  if len(product.signatures) != 0 || len(product.aliases) != 0 || len(product.bounds) != 0 || len(product.diagnostics) != 0 ||
    len(product.tree.ev_syms) != 0 || product.tree.is_test ||
    product.tree.impl_of != None || product.tree.default_of != None { return None }
  if len(product.tree.defaults) != len(declaration.params) { return None }
  for value in product.tree.defaults { match value { Some(_) -> return None, None -> () } }
  let reads = product.function_reads?
  # Observe only the detached entry. Its log is compared, never appended to
  # the live candidate; its allocations are never installed by this API.
  let observed = Cx { ..candidate, function_reads: Some([]), body_writes: Some([]) }
  let entry = checker.function_entry(observed, declaration, signature)
  if len(entry.cx.diags) != len(candidate.diags) { return None }
  let entry_reads = entry.cx.function_reads?
  if not entry_prefix(reads, entry_reads) { return None }
  let dicts = checker.function_dictionaries(entry.cx, signature)
  if len(dicts) == 0 || product.tree.param_syms != entry.parameters || product.tree.dict_syms != dicts { return None }
  if product.body_writes != entry.cx.body_writes || product.owner_slots != slot_of(entry.cx) ||
    len(product.symbols) != len(dicts) + len(entry.parameters) { return None }
  var symbols: Map[Int, Sym] = map.empty()
  for change in product.symbols {
    let value = change.value?
    if map.has(symbols, change.key) { return None }
    symbols = map.insert(symbols, change.key, value)
  }
  for id in dicts ++ entry.parameters {
    if map.get(symbols, id) != map.get(entry.cx.syms, id) { return None }
  }
  # The body has popped its root scope. The candidate's independently made
  # dictionary map and every other retained frame field must still agree.
  let final_frame = Frame { ..entry.cx.frame, scopes: [] }
  if product.frame != final_frame || product.tparams != entry.cx.current_tparams ||
    product.effect_vars != entry.cx.current_eff_vars || product.loop_jumps != entry.cx.loop_jumps ||
    product.in_test != entry.cx.in_test || product.const_cutoff != entry.cx.const_cutoff ||
    product.take_cell != entry.cx.take_cell { return None }
  Some(ProofData { cx: entry.cx, parameters: entry.parameters, dictionaries: dicts })
}

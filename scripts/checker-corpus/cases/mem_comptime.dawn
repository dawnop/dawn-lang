# checker.dawn: `Mem` is refused in `const` initialisers and in comptime blocks
# (docs/mem-buffer-design.md 4.2). The interpreter has no buffer, and a named
# effect is refused at compile time anyway; the case holds both words in place
# so neither route is lost when the other is changed.
use std/mem

const SIZE: Int = mem.with_mem([@s] () => len(mem.new(3)))

pub fn at_compile_time() -> Int = comptime {
  mem.with_mem([@s] () => len(mem.new(3)))
}

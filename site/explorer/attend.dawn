# The explorer page's host-only program (site/explorer/record.py): attention
# without the exponential, on lists. Small enough to read whole, and made of
# the three shapes the page shows (a call, a call inside a call, a closure
# handed to a call), so a click on any of them has something to light in the
# C and the JVM listing. It is not a kernel: it has no Tile IR.

fn dot(xs: List[Float], ys: List[Float]) -> Float = {
  let ps = map(range(0, len(xs)), i => xs[i] * ys[i])
  fold(ps, 0.0, (a, b) => a + b)
}

fn normalize(xs: List[Float]) -> List[Float] = {
  let total = fold(xs, 0.0, (a, b) => a + b)
  map(xs, x => x / total)
}

fn attend(q: List[Float], keys: List[List[Float]], vals: List[Float]) -> Float = {
  let w = normalize(map(keys, k => dot(q, k)))
  dot(w, vals)
}

pub fn main() -> Unit !io = {
  let out = attend([1.0, 2.0], [[1.0, 0.0], [0.0, 1.0]], [10.0, 20.0])
  println("out = ${out}")
}

# The builtin table, dumped from the compiler's own source.
#
# `selfhost/builtins.dawn` is a mirror of this table that a reader can open,
# and a mirror is worth nothing unless something compares it. This is the side
# of that comparison the compiler owns: it prints the lines
# `driver/builtin_mirror.builtin_mirror_lines()` returns -- every entry of
# `intrinsics()` with its visibility, rendered signature and read-back, then
# lowering's internal names. check.py parses them; see that module for the
# record format.
#
# No new subcommand. `selfhost` is an ordinary package and this is a path
# dependency on it. What the package exports for this is data, a list of
# strings, rather than the checker context the reading needs: that context is
# `pub(pkg)`, so the reading lives inside the package.

use std/io
use selfhost/driver/builtin_mirror.{builtin_mirror_lines}

pub fn main() -> Unit !io = {
  for line in builtin_mirror_lines() {
    io.println(line)
  }
}

# Module-graph resolution and whole-program analysis (the Kotlin ModuleLoader
# and Analyze): directory mode roots at <dir>/src and loads every .dawn under
# it; file mode follows the entry's use-closure. Modules come back in
# dependency order; each is then checked and comptime-evaluated with the
# accumulated exports of everything before it (std pre-seeded).

use std/io
use std/io.{Fs, Proc, Env}
use std/str
use std/list
use std/map
use std/set
use front/token.{Diag, mk_diag}
use front/ast.{Module, Decl, DUseModule, module_uses}
use compiler_plan/pkgfetch
use compiler_plan/envmem
use compiler_plan/procmem
use compiler_plan/source
use compiler_plan/source.{canon, canon_identity}
use check/cx.{ModExports, Cx, cx_new}
use check/checker.{check_module, exports_of, exported_impl}
use check/identity
use check/identity.{Minted, EffectDecl}
use ir/interp.{eval_comptime_in, CtOut, CtOpts, ct_default, CtWorld, ConstScope, ct_world_add}
use check/jsig.{Jsig, jsig_refused}
use driver/fsmem
use std/memfs
use driver/stdlib.{
  StdCtx, load_std, std_load_error_text, std_module_of, is_std_dir, read_index
}
use check/tast.{TModule}
use check/types.{Sym, Impls, TyVar, EffVar}
use front/parser
use front/lexer

## One loaded module: dotted path, JVM class name, display path, source text,
## parsed AST; lex/parse diagnostics ride along. `pkg` = the `[deps]` source
## package the module came from; None = the project's own tree
## (docs/package-design.md 项目 B).
pub type LoadedModule = {
  mod_path: String,
  class_name: String,
  path: String,
  text: String,
  # where each line of `text` starts, for the checker's `at file:line`
  # renderings. Taken from the parse, which a workspace load reuses for text
  # that has not changed, so an editor pays for it once per revision of a
  # file rather than once per check of it (docs/lsp-module-memo-design.md).
  line_starts: List[Int],
  m: Module,
  pdiags: List[Diag],
  pkg: Option[source.PkgR],
  # The path a source position baked into the program names (`at
  # src/main.dawn:4`), as opposed to `path`, which is how this run spelled
  # the file and is what diagnostics print. Relative to the project root, to
  # the entry file's directory when there is no project, or `<package>/<path
  # in package>` for a `[deps]` module, so that it depends on the tree alone
  # and never on the working directory or the spelling on the command line
  # (docs/source-location-design.md §四).
  site_path: String,
  # The program's entry module: `src/main.dawn` of a project, or the file a
  # command named. Only this module's `main` is the entry point and carries
  # its constraints (spec §10.5); a `main` anywhere else is an ordinary
  # function. Settled by the load, which is the only place that knows which
  # file the command named.
  entry: Bool
}

## A diagnostic paired with where it should be reported (a module path for
## checked modules, a raw file path for loader-level problems).
pub type LocDiag = { path: String, d: Diag }

pub type LoadResult = { modules: List[LoadedModule], diags: List[LocDiag] }

## The source files visible from one captured source plan. `project_files`
## keeps the caller-facing spellings used by loader diagnostics, including
## files whose names are not legal module paths. `by_use` is the filtered,
## canonical reverse index used by completion.
pub type ModuleIndex = {
  project_files: List[String],
  by_use: Map[String, String]
}

## Compiler-side source planning: the Java-neutral planner result plus the
## module index captured during the same planning pass.
pub type ProjectPlan = {
  source: source.SourcePlan,
  modules: ModuleIndex
}

fn seg_ok(s: String) -> Bool = {
  if s == "" { return false }
  var first = true
  for cp in code_points(s) {
    let lower = cp >= 'a' && cp <= 'z'
    let digit = cp >= '0' && cp <= '9'
    if first {
      if not (lower || cp == '_') { return false }
      first = false
    } else {
      if not (lower || digit || cp == '_') { return false }
    }
  }
  true
}
use ir/core.{CValue, VInt}

## The segments of a module path that are not legal path segments, in order.
##
## A module path IS its class name -- there is no mangling step -- and that
## holds only because every segment is `[a-z_][a-z0-9_]*`. An imported module
## gets that guarantee from its `use` path, which the loader checks below. The
## entry file does not: its name comes from the command line, so it is the one
## way a path segment the grammar cannot spell reaches class-name derivation,
## and it is checked here instead.
##
## There used to be a folding step -- non-alphanumerics to `_`, an `m_` prefix
## for a leading digit -- which is why this is a rejection and not a rename:
## the folding was not injective, so `a-b.dawn` and `a_b.dawn` compiled to the
## same class, on both backends.
fn bad_segments(mod_path: String) -> List[String] = {
  var out: List[String] = []
  for s in str.split(mod_path, "/") {
    if not seg_ok(s) { out = out ++ [s] }
  }
  out
}

## The position path of a module of the tree under `root_abs`: the module
## path, which is already the file relative to the source root, as a file
## again, under `src/` when that root is a project's. Read from the module
## path rather than from `file`, because the module path is the one spelling
## the loader has already made independent of how the file was reached.
fn tree_site(root_abs: String, mod_path: String) -> String =
  if str.ends_with(root_abs, "/src") { "src/" ++ mod_path ++ ".dawn" } else { mod_path ++ ".dawn" }

## The last segment of a path: what a file with no tree around it is called.
fn base_name(path: String) -> String =
  match str.last_index_of(path, "/") {
    Some(i) -> str.drop(path, i + 1)
    None -> path
  }

## module path = file path relative to root, minus extension.
fn module_path_of(root_abs: String, file_abs: String) -> String = {
  let rel = if str.starts_with(file_abs, "${root_abs}/") {
    str.drop(file_abs, str.len(root_abs) + 1)
  } else {
    # not under the root: just the file name
    match str.last_index_of(file_abs, "/") {
      Some(i) -> str.drop(file_abs, i + 1)
      None -> file_abs
    }
  }
  str.strip_suffix(rel, ".dawn").unwrap_or(rel)
}

## The module path of `file` under a source root, given lexically (`canon`)
## and as an identity (`canon_identity`), with the file's identity beside it.
##
## Lexical first, because a module path is the path as written below the
## root (spec §10): `src/ali -> sub` makes `ali/x` and `sub/x` two modules,
## and resolving the link here would fold the first into the second. The
## identities answer only when the spelling is not under the root's at all,
## which is a file that arrives under another spelling of the same root: an
## editor opens one file through a link and another through the real path,
## both are members of one workspace, and the root is spelled the way its
## first member was. When neither agrees the file name is all there is, as it
## was before.
fn module_path_at(root_abs: String, root_id: String, file: String, file_id: String) -> String !Env = {
  let file_abs = canon(file)
  if str.starts_with(file_abs, "${root_abs}/") || not str.starts_with(file_id, "${root_id}/") {
    module_path_of(root_abs, file_abs)
  } else {
    module_path_of(root_id, file_id)
  }
}

## The legal module path `file` has inside one captured project plan. LSP
## workspace membership uses the same derivation and rejection as the loader,
## including unsaved files that are not present in the captured tree walk.
pub fn project_module_path(plan: ProjectPlan, file: String) -> Option[String] !Fs !Env = {
  if not str.ends_with(file, ".dawn") { return None }
  let root = plan.source.source_root
  let mod_path = module_path_at(canon(root), canon_identity(root), file, canon_identity(file))
  if len(bad_segments(mod_path)) == 0 { Some(mod_path) } else { None }
}

## Everything .dawn under `dir`, recursively, full display paths.
##
## A link to a directory is an entry of its parent and is not descended into,
## the default of Go's `filepath.WalkDir` and Rust's `walkdir` (#297). Following
## one walked `src/loop -> .` until the kernel's link limit stopped it, listing
## every module once per level, and two such links did not finish at all. A
## directory reachable only through a link is therefore not part of the
## project; a tree that wants one names it as a path dependency, which is
## resolved on purpose rather than found by walking. A link to a file is still
## a file here: nothing about it can loop.
fn walk_dawn(dir: String) -> List[String] !Fs = walk_sources(dir, false)

## The project's source files as the tree holds them now, walked the way
## `project_plan` walked them. `plan.modules.project_files` is that walk at
## planning time; a language server that outlives a file created or deleted
## since asks again rather than trust it.
pub fn project_files_now(plan: ProjectPlan) -> List[String] !Fs = walk_dawn(plan.source.source_root)

## The same walk for `dawn fmt <dir>`, in both drivers (#302). It used to be a
## copy in main.dawn and another in nmain.dawn that followed every link, so
## `src/loop -> .` sent the formatter down the same exponential tree #297
## took out of the loader. One walk keeps the link rule from drifting between
## the three. The one difference is a directory that cannot be listed: the
## loader skips it, while the formatter stops with "cannot list", because a
## `fmt --check` that silently skipped part of the tree would pass it.
pub fn dawn_files_under(dir: String) -> List[String] !Fs = walk_sources(dir, true)

fn walk_sources(dir: String, strict: Bool) -> List[String] !Fs = {
  var out: List[String] = []
  let names = match io.list_dir(dir) {
    Ok(ns) -> ns
    Err(e) -> if strict { panic("cannot list " ++ dir ++ ": " ++ e.message) } else { return [] }
  }
  for n in names {
    let p = dir ++ "/" ++ n
    if io.is_dir(p) {
      if not io.is_symlink(p) { out = out ++ walk_sources(p, strict) }
    } else if str.ends_with(n, ".dawn") {
      out = out ++ [p]
    }
  }
  sort(out)
}

fn synthetic(path: String, msg: String, hint: String) -> LocDiag =
  LocDiag { path: path, d: mk_diag(msg, 0, 0, hint) }

# Planner diagnostics use a package-local record to keep this frontend out of
# compiler_plan's dependency graph. Convert only where loading adopts them, and
# at the CLI boundary (`clifail.fail_planner`).
pub(pkg) fn planner_diags(ds: List[source.LocDiag]) -> List[LocDiag] = {
  var out: List[LocDiag] = []
  for ld in ds {
    out = out ++ [LocDiag {
      path: ld.path,
      d: mk_diag(ld.d.msg, ld.d.lo, ld.d.hi, ld.d.hint)
    }]
  }
  out
}

## The root package's sources as a load read them: `(position path, text)` for
## every loaded module that belongs to no `[deps]` package. A single-file
## product's build manifest digests these (`buildinfo.file_rows`), because a
## file has no package tree to walk and its load may have read siblings
## through `use`.
pub(pkg) fn root_sources(loaded: LoadResult) -> List[(String, String)] = {
  var out: List[(String, String)] = []
  for lm in loaded.modules {
    match lm.pkg {
      None -> { out = out ++ [(lm.site_path, lm.text)] }
      Some(_) -> ()
    }
  }
  out
}

## The module paths of the root package: every loaded module that belongs to
## no `[deps]` package. `dawn doc` publishes these and only these; a
## dependency's modules are whatever part of it the `use` closure reached,
## which is neither that package's API nor this one's, and the loader's `pkg`
## is the fact a consumer would otherwise have to guess from the file tree
## (docs/doc-comments-design.md).
pub(pkg) fn own_module_paths(loaded: LoadResult) -> Set[String] = {
  var out: Set[String] = set.empty()
  for lm in loaded.modules {
    match lm.pkg {
      None -> { out = set.insert(out, lm.mod_path) }
      Some(_) -> ()
    }
  }
  out
}

fn missing_source_root(dir: String) -> LoadResult = {
  let root = "${dir}/src"
  LoadResult {
    modules: [],
    diags: [synthetic(dir,
      "project directory has no `src/` folder (expected " ++ root ++ ")",
      "a Dawn project keeps its modules under src/, with entry src/main.dawn")]
  }
}

## Reject a directory without src/ before source planning can read its
## manifest or fetch a package. Callers that need both the plan and the load
## result use this seam rather than planning first and trying to undo it.
pub fn project_plan_for_load(
  target: source.SourceTarget
) -> Result[ProjectPlan, LoadResult] !Fs !Proc !Env =
  match target {
    source.ProjectDirectory(dir) ->
      if io.is_dir(dir ++ "/src") {
        Ok(project_plan(target))
      } else {
        Err(missing_source_root(dir))
      }
    source.SourceFile(_) -> Ok(project_plan(target))
  }

fn load_directory_planned(dir: String, plan: ProjectPlan) -> LoadResult !Fs !Env !io = {
  let root = "${dir}/src"
  if not io.is_dir(root) { return missing_source_root(dir) }
  var diags: List[LocDiag] = []
  let main_path = "${root}/main.dawn"
  let main_ok = match io.read_file(main_path) {
    Ok(_) -> true
    Err(_) -> false
  }
  # a directory with a manifest may be a library package (no entry module);
  # run/build report the missing `fn main` themselves when it matters
  let has_manifest = match io.read_file("${dir}/dawn.toml") {
    Ok(_) -> true
    Err(_) -> false
  }
  if not main_ok && not has_manifest {
    diags = diags ++ [synthetic(dir,
      "project has no entry module (expected " ++ main_path ++ ")",
      "add src/main.dawn with `pub fn main() -> Unit !io`")]
  }
  # load every module under src/ (spec §10.5: unreferenced modules still check)
  let no_over: Map[String, String] = map.empty()
  let loaded = load_entries_over(plan, plan.modules.project_files, no_over)
  LoadResult { ..loaded, diags: diags ++ loaded.diags }
}

## Load exactly the target captured by `plan`, without source replanning.
pub fn load_planned(plan: ProjectPlan) -> LoadResult !Fs !Env !io =
  match plan.source.target {
    source.ProjectDirectory(dir) -> load_directory_planned(dir, plan)
    source.SourceFile(file) -> {
      let no_over: Map[String, String] = map.empty()
      load_entries_over(plan, [file], no_over)
    }
  }

## Directory mode: root = <dir>/src, entry = <dir>/src/main.dawn (spec §10.1).
pub fn load_directory(dir: String) -> LoadResult !Fs !Proc !Env !io =
  match project_plan_for_load(source.ProjectDirectory(dir)) {
    Ok(plan) -> load_planned(plan)
    Err(rejected) -> rejected
  }

## One command-line target, loaded as whatever it is: a file, a project
## directory, or the bundled std's own source directory.
##
## The third case is why this exists. Pointed at the std it just loaded, the
## directory loader answered "project directory has no `src/` folder", which
## is true of the standard library and useless as advice: std is not a project
## and cannot be made into one -- there is no entry module to run, nothing to
## build a jar from, and `[deps]` reaches it through the compiler rather than
## through the module graph. Nor is there anything for `check` to do, because
## `load_std` has already parsed, checked and comptime-evaluated every module
## in the bundle before this function is reached; a std that did not check
## would have failed the command outright, several steps earlier.
##
## Provenance, not spelling: this is the directory `--std` actually answered
## from, whatever it is named, and a project directory called `std` still gets
## the project diagnostics.
pub(pkg) fn std_dir_target(std: StdCtx, target: String) -> Option[LoadResult] !Fs !Env = {
  let none: Option[LoadResult] = None
  if not io.is_dir(target) { return none }
  if not is_std_dir(std, target) { return none }
  Some(LoadResult { modules: [], diags: [synthetic(target,
    "`" ++ target ++ "` is the bundled standard library, not a Dawn project",
    "every dawn command checks the whole bundle before it starts, so there is " ++
      "nothing left to check here; name one module (`dawn check " ++ target ++
      "/list.dawn`) to see it on its own, or `dawn test --stdlib` to run its tests")] })
}

## One command-line target, loaded as a file or a project directory, with the
## std directory answered by `std_dir_target` instead.
pub(pkg) fn load_target(std: StdCtx, target: String) -> LoadResult !Fs !Proc !Env !io =
  match std_dir_target(std, target) {
    Some(refusal) -> refusal
    None -> if io.is_dir(target) { load_directory(target) } else { load_file(target) }
  }

## Canonicalize a package module's `use` paths to the name-qualified spelling
## (`use types` → `use web/types`; an aliased dep gains the dep's real name),
## so the checker, duplicate detection and the topological sort all see one
## spelling — the Kotlin loader does the same.
fn qualify_uses(m: Module, pkg: source.PkgR) -> Module = {
  var decls: List[Decl] = []
  for d in m.decls {
    match d {
      DUseModule(segs, sel, aname, lo, hi, nlo, nhi) ->
        if segs[0] == "std" {
          decls = decls ++ [d]
        } else {
          match map.get(pkg.deps, segs[0]) {
            Some(info) ->
              if info.name == segs[0] {
                decls = decls ++ [d]
              } else {
                decls = decls ++
                  [DUseModule([info.name] ++ list.drop(segs, 1), sel, aname, lo, hi, nlo, nhi)]
              }
            None -> {
              decls = decls ++ [DUseModule([pkg.name] ++ segs, sel, aname, lo, hi, nlo, nhi)]
            }
          }
        }
      _ -> { decls = decls ++ [d] }
    }
  }
  Module { decls: decls }
}

## A package's dep under its real name — what canonicalized `use` paths carry
## (the deps map itself is keyed by this package's local aliases).
fn dep_by_name(p: source.PkgR, name: String) -> Option[source.PkgR] = {
  for k in map.keys(p.deps) {
    let info = map.get(p.deps, k).expect("dep")
    if info.name == name { return Some(info) }
  }
  None
}

## Rebuild a module with the collected alias → real-name rewrites applied
## (keyed by the old use path; everything else is untouched).
fn apply_rewrites(m: Module, rw: Map[String, List[String]]) -> Module = {
  var decls: List[Decl] = []
  for d in m.decls {
    match d {
      DUseModule(segs, sel, aname, lo, hi, nlo, nhi) ->
        match map.get(rw, join(segs, "/")) {
          Some(ns) -> { decls = decls ++ [DUseModule(ns, sel, aname, lo, hi, nlo, nhi)] }
          None -> { decls = decls ++ [d] }
        }
      _ -> { decls = decls ++ [d] }
    }
  }
  Module { decls: decls }
}

## A source read that honors editor-buffer overrides (canon path → text) —
## the Kotlin ModuleLoader.loadFile(overrides) for the language server.
fn read_over(over: Map[String, String], c: String, f: String) -> Result[String, ForeignError] !Fs =
  match map.get(over, c) {
    Some(t) -> Ok(t)
    None -> io.read_file(f)
  }

## File mode: root = nearest `src` ancestor, else the file's own directory;
## loads the entry plus its transitive use-closure.
pub fn load_file(file: String) -> LoadResult !Fs !Proc !Env !io = {
  let no_over: Map[String, String] = map.empty()
  load_file_over(file, no_over)
}

## `load_file` with editor-buffer overrides.
pub fn load_file_over(file: String, over: Map[String, String]) -> LoadResult !Fs !Proc !Env !io = {
  let plan = project_plan(source.SourceFile(file))
  load_entries_over(plan, [file], over)
}

## Load entries against one already captured plan. This boundary deliberately
## has no target from which it could silently rediscover a newer manifest.
pub fn load_entries_over(
  plan: ProjectPlan,
  entries: List[String],
  over: Map[String, String]
) -> LoadResult !Fs !Env !io =
  load_entries_reusing(plan, entries, over, no_parses()).loaded

## The parse of one file, and the text it was parsed from. The line starts
## are the text's too: on the selfhost workspace, recomputing them for every
## re-checked module was about 0.18 s of a 1 s edit that changed a widely
## imported signature (agent-handoff/research-laziness-l1-reeval-20260930.md).
pub(pkg) type Parsed = { text: String, line_starts: List[Int], m: Module, pdiags: List[Diag] }

## The parses one load made, by canonical path, handed to the next load of
## the same workspace so that a file whose text has not changed is not parsed
## again. Parsing is a function of the text alone, so the key is the path and
## the hit test is text equality; everything the loader does after parsing
## (package qualification, alias rewrites, identity, entry) still runs on
## every load, because it depends on more than the file. Only the files the
## latest load reached are kept, so a file that left the program is dropped.
## `reused` counts the hits of the load that produced it.
pub(pkg) type ParseMemo = { by_path: Map[String, Parsed], reused: Int }

pub(pkg) fn no_parses() -> ParseMemo = {
  let none: Map[String, Parsed] = map.empty()
  ParseMemo { by_path: none, reused: 0 }
}

pub(pkg) type ReusingLoad = { loaded: LoadResult, parses: ParseMemo }

## `load_entries_over` for an editor workspace: the same result, with the
## parses of `previous` reused wherever a file's text is unchanged. On the
## selfhost workspace the parse is about 0.6 s of every edit's 0.8 to 0.9 s
## load (docs/lsp-module-memo-design.md).
pub(pkg) fn load_entries_reusing(
  plan: ProjectPlan,
  entries: List[String],
  over: Map[String, String],
  previous: ParseMemo
) -> ReusingLoad !Fs !Env !io =
  resolve(
    plan.source.source_root,
    entries,
    planner_diags(plan.source.diags),
    plan.source.pkgs,
    over,
    entry_file(plan),
    previous
  )

## Parse `text` for the file at canonical path `key`, or hand back the parse
## `previous` made of the same text.
fn parse_reusing(previous: ParseMemo, key: String, text: String) -> (Parsed, Bool) =
  match map.get(previous.by_path, key) {
    Some(p) -> if p.text == text { (p, true) } else { (fresh_parse(text), false) }
    None -> (fresh_parse(text), false)
  }

fn fresh_parse(text: String) -> Parsed = {
  let (m, pdiags) = parser.parse_module(text)
  Parsed { text: text, line_starts: lexer.line_starts_of(text), m: m, pdiags: pdiags }
}

## The file whose module is the program's entry (spec §10.1, §10.5): the one
## a command named, or a project's `src/main.dawn`. An identity, because that
## is how the loader compares the files it reads.
fn entry_file(plan: ProjectPlan) -> Option[String] !Fs !Env =
  match plan.source.target {
    source.SourceFile(file) -> Some(canon_identity(file))
    source.ProjectDirectory(dir) -> Some(canon_identity(dir ++ "/src/main.dawn"))
  }

fn resolve(
  root: String,
  seed_files: List[String],
  diags0: List[LocDiag],
  pkgs: Map[String, source.PkgR],
  over: Map[String, String],
  entry: Option[String],
  previous: ParseMemo
) -> ReusingLoad !Fs !Env !io = {
  var diags = diags0
  var parses: Map[String, Parsed] = map.empty()
  var reused = 0
  # A module is loaded once per (file identity, module path). The identity
  # (`canon_identity`) is what makes one file reached through two spellings of
  # its root one module, and it is also the key of the overlay an editor hands
  # in and of the parse memo. The module path is in the key as well because
  # it is what a module *is* (spec §10): a file reached under two module
  # paths, through a link inside src/, is two modules, as it was before
  # identities resolved links.
  let root_abs = canon(root)
  let root_id = canon_identity(root)
  var loaded_as: Set[(String, String)] = set.empty()
  var identities: Map[String, String] = map.empty()
  var by_path: Map[String, LoadedModule] = map.empty()
  var order: List[String] = []
  var queue: List[String] = []
  # load seeds
  for f in seed_files {
    let c = canon_identity(f)
    let mod_path = module_path_at(root_abs, root_id, f, c)
    if not set.has(loaded_as, (c, mod_path)) {
      let bad = bad_segments(mod_path)
      if len(bad) > 0 {
        diags = diags ++ [synthetic(f,
          "`" ++ bad[0] ++ "` is not a valid module path segment",
          "a source file's name is its module path: rename it so every " ++
            "segment is a lowercase identifier ([a-z_][a-z0-9_]*)")]
        continue
      }
      match read_over(over, c, f) {
        Ok(text) -> {
          let (parsed, hit) = parse_reusing(previous, c, text)
          parses = map.insert(parses, c, parsed)
          if hit { reused = reused + 1 }
          let mf = LoadedModule {
            mod_path: mod_path,
            class_name: mod_path,
            path: f,
            text: text,
            line_starts: parsed.line_starts,
            m: parsed.m,
            pdiags: parsed.pdiags,
            pkg: None,
            site_path: tree_site(root_abs, mod_path),
            entry: entry == Some(c)
          }
          loaded_as = set.insert(loaded_as, (c, mod_path))
          by_path = map.insert(by_path, mod_path, mf)
          order = order ++ [mod_path]
          queue = queue ++ [mod_path]
        }
        Err(_) -> ()
      }
    }
  }
  # follow use edges, loading dependencies on demand
  var visited: Set[String] = set.empty()
  while len(queue) > 0 {
    let mp = queue[0]
    queue = list.drop(queue, 1)
    if not set.has(visited, mp) {
      visited = set.insert(visited, mp)
      let mf = map.get(by_path, mp).expect("queued module")
      # aliased app imports canonicalized while walking edges: old path → new segs
      var rewrites: Map[String, List[String]] = map.empty()
      for u in module_uses(mf.m) {
        var bad: Option[String] = None
        for s in u.segs {
          if bad == None && not seg_ok(s) { bad = Some(s) }
        }
        match bad {
          Some(b) -> {
            diags = diags ++ [LocDiag { path: mf.path, d: mk_diag(
              "invalid module path segment `" ++ b ++ "`",
              u.nlo,
              u.nhi,
              "path segments are lowercase identifiers: [a-z_][a-z0-9_]*"
            ) }]
            continue
          }
          None -> ()
        }
        # bundled std modules come from the compiler, not the module graph
        if u.segs[0] == "std" { continue }
        # where the target file lives and which package it belongs to: a package
        # module imports its siblings and its deps under canonical (real-name)
        # spellings; an app module hitting a [deps] alias resolves inside that
        # package — unless a local path claims the same first segment, which is
        # never shadowed silently (package-design.md §4.3). An aliased app
        # import is canonicalized to the package's real name (the spelling the
        # package's own modules load under).
        var dep_file = ""
        var dep_pkg: Option[source.PkgR] = None
        var edge_ok = true
        match mf.pkg {
          Some(p) ->
            match dep_by_name(p, u.segs[0]) {
              Some(info) -> {
                # a dependency module importing one of its own deps
                dep_file = info.root ++ "/" ++ join(list.drop(u.segs, 1), "/") ++ ".dawn"
                dep_pkg = Some(info)
              }
              None -> {
                dep_file = p.root ++ "/" ++ join(list.drop(u.segs, 1), "/") ++ ".dawn"
                dep_pkg = mf.pkg
              }
            }
          None ->
            match map.get(pkgs, u.segs[0]) {
              Some(info) -> {
                let local = root ++ "/" ++ join(u.segs, "/") ++ ".dawn"
                let local_hit = match io.read_file(local) {
                  Ok(_) -> true
                  Err(_) -> false
                }
                if local_hit {
                  diags = diags ++ [LocDiag { path: mf.path, d: mk_diag(
                    "`" ++ u.path ++ "` is ambiguous: `" ++ u.segs[0] ++
                      "` is both a [deps] package and a local module path",
                    u.nlo,
                    u.nhi,
                    "rename the src/" ++ u.segs[0] ++ "/ directory or the dependency alias"
                  ) }]
                  edge_ok = false
                } else if len(u.segs) == 1 {
                  diags = diags ++ [LocDiag { path: mf.path, d: mk_diag(
                    "cannot import the package `" ++ u.segs[0] ++ "` itself",
                    u.nlo,
                    u.nhi,
                    "import one of its modules: `use " ++ u.segs[0] ++ "/<module>`"
                  ) }]
                  edge_ok = false
                } else {
                  if info.name != u.segs[0] {
                    rewrites = map.insert(rewrites, u.path, [info.name] ++ list.drop(u.segs, 1))
                  }
                  dep_file = info.root ++ "/" ++ join(list.drop(u.segs, 1), "/") ++ ".dawn"
                  dep_pkg = Some(info)
                }
              }
              None -> {
                dep_file = root ++ "/" ++ join(u.segs, "/") ++ ".dawn"
              }
            }
        }
        if not edge_ok { continue }
        # one host query per spelling per load, not one per `use` edge: a
        # module imported from fifty places is fifty edges with one answer
        let dep_canon = match map.get(identities, dep_file) {
          Some(known) -> known
          None -> {
            let found = canon_identity(dep_file)
            identities = map.insert(identities, dep_file, found)
            found
          }
        }
        let (mod_path, cls) = match dep_pkg {
          Some(p) -> {
            # lexical below the package root, as `module_path_at` is below
            # the project's: the root is already an identity
            let internal = module_path_of(p.root, canon(dep_file))
            (p.name ++ "/" ++ internal, "dawn\$pkg\$" ++ p.name ++ "/" ++ internal)
          }
          None -> {
            let mp = module_path_at(root_abs, root_id, dep_file, dep_canon)
            (mp, mp)
          }
        }
        if set.has(loaded_as, (dep_canon, mod_path)) {
          queue = queue ++ [mod_path]
        } else {
          match read_over(over, dep_canon, dep_file) {
            Ok(text) -> {
              let (parsed, hit) = parse_reusing(previous, dep_canon, text)
              parses = map.insert(parses, dep_canon, parsed)
              if hit { reused = reused + 1 }
              let m2p = parsed.m
              let pdiags2 = parsed.pdiags
              let m2 = match dep_pkg {
                Some(p) -> qualify_uses(m2p, p)
                None -> m2p
              }
              let mf2 = LoadedModule {
                mod_path: mod_path,
                class_name: cls,
                path: dep_file,
                text: text,
                line_starts: parsed.line_starts,
                m: m2,
                pdiags: pdiags2,
                pkg: dep_pkg,
                # a package module's path already leads with the package's
                # real name: `<package>/<path in package>`
                site_path: match dep_pkg {
                  Some(_) -> mod_path ++ ".dawn"
                  None -> tree_site(root_abs, mod_path)
                },
                entry: false
              }
              loaded_as = set.insert(loaded_as, (dep_canon, mod_path))
              by_path = map.insert(by_path, mod_path, mf2)
              order = order ++ [mod_path]
              queue = queue ++ [mod_path]
            }
            Err(_) -> {
              diags = diags ++ [LocDiag { path: mf.path, d: mk_diag(
                "cannot find module `" ++ u.path ++ "`",
                u.nlo,
                u.nhi,
                "expected a file at ${dep_file}"
              ) }]
            }
          }
        }
      }
      if len(map.keys(rewrites)) > 0 {
        by_path = map.insert(by_path, mp,
          LoadedModule { ..mf, m: apply_rewrites(mf.m, rewrites) })
      }
    }
  }
  # the std/ path prefix is reserved for the bundled standard library
  for mp in order {
    if mp == "std" || str.starts_with(mp, "std/") {
      let mf = map.get(by_path, mp).expect("module")
      diags = diags ++ [LocDiag { path: mf.path, d: mk_diag(
        "the module path `" ++ mp ++ "` is reserved for the bundled standard library",
        0,
        0,
        "move the file out of src/std"
      ) }]
    }
  }
  # duplicate-import detection (same module, same *kind*, twice in one file).
  # `use std/cursor` and `use std/cursor.{Cursor}` are not duplicates: one
  # binds a module alias to call through, the other binds names. A module that
  # exports both functions and a type needs both, and the qualified spelling
  # is the whole point of the former.
  for mp in order {
    let mf = map.get(by_path, mp).expect("module")
    var seen: Set[(String, Bool)] = set.empty()
    for u in module_uses(mf.m) {
      var all_ok = true
      for s in u.segs {
        if not seg_ok(s) { all_ok = false }
      }
      if all_ok {
        let sel = match u.selective {
          Some(_) -> true
          None -> false
        }
        if set.has(seen, (u.path, sel)) {
          diags = diags ++ [LocDiag { path: mf.path, d: mk_diag(
            "module `" ++ u.path ++ "` is imported more than once",
            u.nlo,
            u.nhi,
            ""
          ) }]
        }
        seen = set.insert(seen, (u.path, sel))
      }
    }
  }
  # topological order + cycle detection over the use graph
  let (ordered, diags2) = topo_sort(order, by_path, diags)
  ReusingLoad {
    loaded: LoadResult { modules: ordered, diags: diags2 },
    parses: ParseMemo { by_path: parses, reused: reused }
  }
}

## Depth-first topological sort; on the first back edge, report the cycle path.
fn topo_sort(
  order: List[String],
  by_path: Map[String, LoadedModule],
  diags0: List[LocDiag]
) -> (List[LoadedModule], List[LocDiag]) !io = {
  var diags = diags0
  var state: Map[String, Int] = map.empty()
  var out: List[LoadedModule] = []
  var cycle_reported = false
  # an explicit work stack: (path, next edge index); edges resolved up front
  fn edges_of(mf: LoadedModule) -> List[String] = {
    var es: List[String] = []
    for u in module_uses(mf.m) {
      if map.has(by_path, u.path) { es = es ++ [u.path] }
    }
    es
  }
  for start in order {
    var stack: List[(String, Int)] = []
    if not map.has(state, start) {
      stack = [(start, 0)]
      state = map.insert(state, start, 0)
    }
    while len(stack) > 0 {
      let (mp, ei) = stack[len(stack) - 1]
      let mf = map.get(by_path, mp).expect("module")
      let es = edges_of(mf)
      if ei >= len(es) {
        stack = list.take(stack, len(stack) - 1)
        state = map.insert(state, mp, 1)
        out = out ++ [mf]
      } else {
        stack = list.take(stack, len(stack) - 1) ++ [(mp, ei + 1)]
        let dep = es[ei]
        match map.get(state, dep) {
          Some(1) -> ()
          Some(_) -> {
            # a back edge: the cycle is the stack from dep onward
            if not cycle_reported {
              cycle_reported = true
              var names: List[String] = []
              var take = false
              for entry in stack {
                let (p, _) = entry
                if p == dep { take = true }
                if take { names = names ++ [p] }
              }
              names = names ++ [dep]
              let head = map.get(by_path, names[0]).expect("module")
              var ulo = 0
              var uhi = 0
              for u in module_uses(head.m) {
                if u.path == names[1] && ulo == 0 && uhi == 0 {
                  ulo = u.nlo
                  uhi = u.nhi
                }
              }
              diags = diags ++ [LocDiag { path: head.path, d: mk_diag(
                "circular module dependency: ${join(names, " → ")}",
                ulo,
                uhi,
                "modules must form a directed acyclic graph (spec §10.5)"
              ) }]
            }
          }
          None -> {
            state = map.insert(state, dep, 0)
            stack = stack ++ [(dep, 0)]
          }
        }
      }
    }
  }
  (out, diags)
}

# ---- whole-program analysis ----

pub(pkg) type CheckedMod = {
  mod_path: String,
  class_name: String,
  path: String,
  m: Module,
  cx: Cx,
  tm: TModule,
  ct: CtOut
}

## The program plus the position view of the revision it was analyzed from.
## A diagnostic raised inside a declaration carries an offset from that
## declaration, so nothing may render `diags` without this map; `rendered_diags`
## is the only reader that puts the two together.
##
## `ct_world` is the comptime world once every module has joined it: what an
## editor folds one expression against after the fact (`interp.eval_closed`,
## docs/lsp-hover-design.md §C5). A module's own run saw the world before it,
## and this one differs only by that module and the ones after it; a body can
## name neither of the later ones (modules form a DAG), and its own functions
## are the ones `module_icx` puts first anyway. Keeping the finished world
## costs a reference, where rebuilding the one before each module would mean
## knowing which modules' comptime ran, which the program does not record.
pub(pkg) type Program = {
  modules: List[CheckedMod],
  diags: List[LocDiag],
  decl_spans: Map[String, identity.DeclSpans],
  ct_world: CtWorld
}

## Every diagnostic of this program in absolute positions of this revision.
## Reached from each render site rather than from program assembly on purpose:
## a session hands back diagnostics that a reused step produced against an
## older layout, and only the program being rendered knows where their
## declarations sit now.
pub(pkg) fn rendered_diags(prog: Program) -> List[LocDiag] = {
  var out: List[LocDiag] = []
  for ld in prog.diags { out = out ++ [LocDiag { ..ld, d: identity.absolute(prog.decl_spans, ld.d) }] }
  out
}

## All state that advances between modules, including failed ones. An impl
## is program-wide, not activated by an import; ids must keep their original
## allocation order so metadata grafted by imports never collides.
pub type AnalysisCarry = {
  exports: Map[String, ModExports],
  impls: Impls,
  # the intern table behind every derived id, program-wide. It advances
  # between modules because a digest collision between two modules'
  # declarations is exactly as fatal as one inside a single module, and only a
  # table that spans both can see it. There is no counter beside it any more:
  # a binder key names the declaration that binds it, so two modules cannot
  # quarrel over one number and nothing has to be carried to keep them apart
  identities: Map[Int, Minted],
  # The position view lives on the carry rather than on `ModuleStep` because
  # its readers are not the step that produced it: a diagnostic or a lowering
  # resolves an offset owned by some other module, long after that module's
  # step returned. `ModuleStep.after` is what a session keeps, so a view put
  # here is reachable from every consumer a step is reachable from, and one
  # reused prefix step carries the views of the modules before it unchanged.
  decl_spans: Map[String, identity.DeclSpans],
  # What a module's comptime may call and name beyond std's function tables:
  # every clean module before it, with std's constants (spec §7.2 item 1). It
  # advances per module, like the exports, but no `use` gates it: a call two
  # modules away (a calls b.f, which calls c.g) reads c's body through b.
  # What a step actually read of it is `CtOut.reads`.
  ct_world: CtWorld
}

## The enclosing module interval includes context construction and export
## assembly. Check and comptime intervals are nested inside it, never overlap,
## and are absent when the corresponding phase is skipped after an error.
pub type AnalysisStage = AnalyzeModule | AnalyzeCheck | AnalyzeComptime
pub alias AnalysisObserver = fn(String, AnalysisStage, Bool) -> Unit !io

pub(pkg) type ModuleStep = {
  input: LoadedModule,
  checked: CheckedMod,
  diags: List[LocDiag],
  after: AnalysisCarry,
  check_runs: Int,
  comptime_runs: Int
}

pub(pkg) fn initial_carry(std: StdCtx) -> AnalysisCarry = {
  # The bundled library is already checked; its own sources are given a view
  # when one of them is analyzed again as an ordinary module.
  let no_spans: Map[String, identity.DeclSpans] = map.empty()
  AnalysisCarry { exports: std.exports, impls: std.impls,
    identities: std.identities, decl_spans: no_spans, ct_world: std.ct_world }
}

fn analysis_event(
  observer: Option[AnalysisObserver], name: String, stage: AnalysisStage, entering: Bool
) -> Unit !io =
  match observer {
    Some(note) -> note(name, stage, entering)
    None -> ()
  }

## One editor analysis plus the source plan captured for project-aware
## completion. A truly standalone buffer has no project plan.
pub(pkg) type DocumentAnalysis = {
  prog: Program,
  entry: String,
  plan: Option[ProjectPlan]
}

fn empty_tmodule() -> TModule = {
  let no_syms: Map[Int, Sym] = map.empty()
  TModule { fns: [], consts: [], tests: [], syms: no_syms }
}

fn empty_ctout() -> CtOut = {
  let no_c: Map[String, CValue] = map.empty()
  let no_b: Map[(Int, Int), CValue] = map.empty()
  CtOut { diags: [], consts: no_c, blocks: no_b, reads: set.empty(), missed: false }
}

## A loaded module under the identity it actually has, plus whether that
## identity is the bundled standard library's.
##
## A loader derives a module path from the source root it was given, and for
## std's own sources there is no source root that produces the right answer:
## `dawn check std/list.dawn` roots at `std/` and calls the module `list`, and
## the editor's standalone path calls every buffer `main`. Either way the
## checker was handed a user module, so it refused the std-only builtins the
## file exists to wrap -- on the very line that defines the replacement the
## hint recommends.
##
## The full identity is restored, not just the std flag. The module path is
## what the other std-internal rules are keyed on (`internal_std_modules`, and
## the owner string an audience records), so a half-identity -- std powers
## under the name `hamt` -- would be a std module the rest of std cannot
## recognise.
fn std_identity(std: StdCtx, mf: LoadedModule) -> (LoadedModule, Bool) !Fs !Env =
  match std_module_of(std, mf.path) {
    Some(mod_path) -> (LoadedModule { ..mf, mod_path: mod_path, class_name: mod_path }, true)
    None -> (mf, false)
  }

## Check a loaded program in dependency order: each module sees the exports of
## everything before it (std pre-seeded); comptime runs on clean modules only.
pub(pkg) fn analyze_program(loaded: LoadResult, std: StdCtx, opts: CtOpts, js: Jsig) -> Program !Fs !Env !io =
  analyze_observed(loaded, std, opts, js, None)

## The cold path remains the production entry. Observation is opt-in and
## cannot add diagnostics, change the wire protocol, or turn an error into a
## cached success. The caller owns any timing and counter state.
pub(pkg) fn analyze_observed(
  loaded: LoadResult, std: StdCtx, opts: CtOpts, js: Jsig,
  observer: Option[AnalysisObserver]
) -> Program !Fs !Env !io = {
  var diags = loaded.diags
  var carry = initial_carry(std)
  var out: List[CheckedMod] = []
  for mf in loaded.modules {
    let step = analyze_module_step(mf, carry, std, opts, js, observer)
    carry = step.after
    diags = diags ++ step.diags
    out = out ++ [step.checked]
  }
  Program { modules: out, diags: diags, decl_spans: carry.decl_spans, ct_world: carry.ct_world }
}

## The comptime world once `checked` has joined it. Only a module whose
## comptime ran joins, which is a module that checked clean: a body with an
## error in it holds `XError`, which lowering refuses by panicking. A module
## calling into one gets a comptime diagnostic instead, and has an error to
## report anyway, since the one it imports does. A std source checked as a
## program module is in the world already, as std.
pub(pkg) fn world_after(w: CtWorld, checked: CheckedMod, ran: Bool, is_std: Bool) -> CtWorld =
  if ran && not is_std {
    let scope = ConstScope { path: checked.mod_path, imported: checked.cx.imported_names,
      renames: checked.cx.import_renames }
    ct_world_add(w, checked.class_name, scope, checked.tm, checked.ct.consts, true)
  } else { w }

## One exact transition of the original loop. Even a parse failure publishes
## its recovered exports and carry. Keep the full impl-table fold: local_impls
## alone is not a proven delta for prelude registration or std rechecking.
pub(pkg) fn analyze_module_step(
  mf0: LoadedModule, before: AnalysisCarry, std: StdCtx, opts: CtOpts,
  js: Jsig, observer: Option[AnalysisObserver]
) -> ModuleStep !Fs !Env !io = {
  var diags: List[LocDiag] = []
  # The one place a module's identity is settled, and the reason it is here
  # rather than in the loaders: only this function holds the std, and the
  # std is the only thing that can say whether a file on disk *is* std.
  # The loaders answer from the source root, which makes `std/list.dawn`
  # the module `list` and an editor buffer the module `main` -- both wrong
  # for the bundled library's own sources, and wrong in the direction that
  # takes the std-only surface away from the code that defines it.
  let (mf, is_std) = std_identity(std, mf0)
  # Built on the cold path too: one code path is worth more than the fraction
  # of a percent it costs, and a renderer cannot ask for a view that only the
  # session mode builds. It names no analysis owner, so the same revision
  # answers the same way whoever analyzed it.
  let spans = identity.declaration_spans(mf.m)
  analysis_event(observer, mf.mod_path, AnalyzeModule, true)
  for d in mf.pdiags { diags = diags ++ [LocDiag { path: mf.path, d: d }] }
  let parse_failed = len(mf.pdiags) > 0
  # A std source checked here is the bundle's own copy being checked a
  # second time, so its baseline is the one `load_std` gave it -- what the
  # modules before it declared -- and not the finished library, which holds
  # the very impls this module is about to register.
  var base_impls = before.impls
  if is_std {
    match map.get(std.impls_before, mf.mod_path) {
      Some(before) -> { base_impls = before }
      None -> ()
    }
  }
  var cx = cx_new(Some(mf.class_name), Some(mf.path))
  cx = Cx {
    ..cx,
    is_entry_module: mf.entry,
    # the module's own name got a vote in `cx_new` and does not get one
    # here: `src/std/foo.dawn` is spelled like std and is not std
    is_std_module: is_std,
    # the package `pub(pkg)` opens to (docs/package-visibility-design.md
    # §4.1): the `[deps]` package this file was loaded from, by its real
    # name. A std source is std's whatever directory it sits in.
    dep_package: if is_std { None } else {
      match mf.pkg {
        Some(p) -> Some(p.name)
        None -> None
      }
    },
    std_fns: std.std_fns,
    moved: std.moved,
    line_starts: mf.line_starts,
    source: mf.text,
    # what a position baked into this module's code names; the bundled std
    # names none, as it never has
    site_path: if is_std { None } else { Some(mf.site_path) },
    # names the span view a diagnostic raised in this module resolves against
    mod_path: Some(mf.mod_path),
    identities: before.identities,
    # std's impls are part of the baseline, not something `use` turns on --
    # and neither are the ones the modules before this got to
    impl_table: base_impls,
    # the host's Java signature oracle: jreflect's on the JVM driver, the
    # refusing default anywhere else (a native compiler refuses `use java`)
    jsig: js
  }
  var tm = empty_tmodule()
  var ct = empty_ctout()
  var check_runs = 0
  var comptime_runs = 0
  if not parse_failed {
    analysis_event(observer, mf.mod_path, AnalyzeCheck, true)
    let (cx1, tm1) = check_module(cx, mf.m, before.exports)
    check_runs = 1
    analysis_event(observer, mf.mod_path, AnalyzeCheck, false)
    cx = cx1
    tm = tm1
    if len(cx.diags) == 0 {
      analysis_event(observer, mf.mod_path, AnalyzeComptime, true)
      let scope = ConstScope { path: mf.mod_path, imported: cx.imported_names,
        renames: cx.import_renames }
      ct = eval_comptime_in(tm, before.ct_world, scope, std.fn_decls, std.by_owner,
        std.impl_fns, std.std_names, cx.adts, cx.traits, cx.impl_table, mf.class_name, opts)
      comptime_runs = 1
      analysis_event(observer, mf.mod_path, AnalyzeComptime, false)
    }
    for d in cx.diags { diags = diags ++ [LocDiag { path: mf.path, d: d }] }
    for d in ct.diags { diags = diags ++ [LocDiag { path: mf.path, d: d }] }
  }
  var impls = before.impls
  # registration already rejected anything that collided with a key already
  # in this table, so every row here is either new or the one put there. The
  # carry holds each impl without its source span (`exported_impl`): only the
  # declaring module reads one, from its own `local_impls`.
  for pr in map.entries(cx.impl_table) {
    let (k, v) = pr
    impls = map.insert(impls, k, exported_impl(v))
  }
  let exports = map.insert(before.exports, mf.mod_path, exports_of(cx, mf.m, mf.mod_path, mf.class_name))
  let checked = CheckedMod {
    mod_path: mf.mod_path,
    class_name: mf.class_name,
    path: mf.path,
    m: mf.m,
    cx: cx,
    tm: tm,
    ct: ct
  }
  analysis_event(observer, mf.mod_path, AnalyzeModule, false)
  let step = ModuleStep {
    input: mf,
    checked: checked,
    diags: diags,
    after: AnalysisCarry { exports: exports, impls: impls,
      identities: cx.identities,
      decl_spans: map.insert(before.decl_spans, mf.mod_path, spans),
      ct_world: world_after(before.ct_world, checked, comptime_runs == 1, is_std) },
    check_runs: check_runs,
    comptime_runs: comptime_runs
  }
  step
}

# ---- single-document analysis (the language server's entry) ----

## The Kotlin fast-path test `(?m)^\s*use\s+[a-z]`: any line whose first token
## is `use` followed by a lowercase letter. (`pub use` deliberately does not
## match — the quirk is part of the contract.)
fn has_module_use(text: String) -> Bool = {
  for line in str.split(text, "\n") {
    let cps = code_points(line)
    let n = len(cps)
    var i = 0
    while i < n && is_ws(cps[i]) { i = i + 1 }
    if i + 3 <= n && cps[i] == 'u' && cps[i + 1] == 's' && cps[i + 2] == 'e' {
      var j = i + 3
      if j < n && is_ws(cps[j]) {
        while j < n && is_ws(cps[j]) { j = j + 1 }
        if j < n && cps[j] >= 'a' && cps[j] <= 'z' { return true }
      }
    }
  }
  false
}

## Java's regex `\s`: space, tab, newline, vertical tab, form feed, return.
fn is_ws(cp: Char) -> Bool =
  cp == ' ' || cp == '\t' || cp == '\n' || cp == '\u{000B}' || cp == '\u{000C}' || cp == '\r'

## Add one already-walked tree to the reverse module index. `std/...` is
## skipped wherever it comes from: the prefix is reserved for the bundled
## library, and `resolve` rejects a project module that claims it.
fn index_files(
  out0: Map[String, String],
  root: String,
  prefix: String,
  files: List[String]
) -> Map[String, String] !Env = {
  var out = out0
  let root_abs = canon(root)
  for f in files {
    let file_abs = canon(f)
    let mp = prefix ++ module_path_of(root_abs, file_abs)
    if len(bad_segments(mp)) == 0 && mp != "std" && not str.starts_with(mp, "std/") {
      out = map.insert(out, mp, file_abs)
    }
  }
  out
}

## Capture source resolution and derive every compiler-facing module path from
## it. The project tree is walked once. Direct dependencies sharing one source
## root reuse the same walk while still receiving each consumer alias prefix.
pub fn project_plan(target: source.SourceTarget) -> ProjectPlan !Fs !Proc !Env = {
  let source_plan = source.source_plan(target)
  let project_files = walk_dawn(source_plan.source_root)
  var by_use: Map[String, String] = map.empty()
  by_use = index_files(by_use, source_plan.source_root, "", project_files)
  var dependency_files: Map[String, List[String]] = map.empty()
  for dep_alias in map.keys(source_plan.pkgs) {
    let pkg = map.get(source_plan.pkgs, dep_alias).expect("resolved dep")
    let files = match map.get(dependency_files, pkg.root) {
      Some(cached) -> cached
      None -> {
        let walked = walk_dawn(pkg.root)
        dependency_files = map.insert(dependency_files, pkg.root, walked)
        walked
      }
    }
    by_use = index_files(by_use, pkg.root, "${dep_alias}/", files)
  }
  ProjectPlan {
    source: source_plan,
    modules: ModuleIndex { project_files: project_files, by_use: by_use }
  }
}

## Every module path a `use` in `file` could name, mapped to the file behind
## it: the project's own modules under the nearest `src` root, plus each
## `[deps]` package's modules under the alias the manifest spells it with.
##
## The loader runs this relation forward -- `use a/b` names `<root>/a/b.dawn`
## -- and completion needs it backward. That has to be a directory walk and
## cannot be a read of what the program already loaded: the language server
## analyses one buffer and follows only the `use` edges that buffer already
## has, so the module being completed is by construction not among them.
##
## std is deliberately absent. It is bundled rather than on disk beside the
## project, and its exports are already in the server's hand (StdCtx), which
## is a better source than a path that may not exist.
##
## This compatibility wrapper is for callers that did not retain a
## ProjectPlan. A cold url dep is fetched here the way `dawn check` would fetch
## it; the LSP's project-aware path instead reuses the index captured during
## analysis.
pub fn use_candidates(file: String) -> Map[String, String] !Fs !Proc !Env = {
  # a buffer with no file behind it (`<lsp>`) has no tree to walk, and canon()
  # would resolve that placeholder against the server's own directory
  if not str.ends_with(file, ".dawn") {
    let none: Map[String, String] = map.empty()
    return none
  }
  project_plan(source.SourceFile(file)).modules.by_use
}

## The module path a file's *name* alone would give it: the basename minus
## `.dawn`. None for a buffer with no file behind it (`<lsp>`, an editor's
## untitled document) -- there is no name to judge.
fn entry_name_of(path: String) -> Option[String] = {
  if not str.ends_with(path, ".dawn") { return None }
  let base = match str.last_index_of(path, "/") {
    Some(i) -> str.drop(path, i + 1)
    None -> path
  }
  Some(str.strip_suffix(base, ".dawn").unwrap_or(base))
}

## Analyze one buffer without project context (the Kotlin `analyze(text)`).
##
## The entry's name is checked here for the same reason `resolve` checks its
## seeds: a module path IS a class name, and this is the other way a file name
## reaches class-name derivation. `mod_path` is proposed as "main" rather than
## as the file's name -- a buffer analysed alone is not a module in any
## program, and its identity is nobody's to see -- so the check is the only
## thing this borrows from the loader. Without it the editor silently accepted
## a file `dawn check` refuses to compile.
##
## "Proposed", because `analyze_program` overrides it for one buffer: a source
## file of the bundled std this compiler loaded, which is a module in a program
## whatever the editor thinks. Read the answer back with `standalone_entry`.
##
## Unlike `resolve`, which skips the seed, the buffer is still analysed: the
## name is wrong, the contents are still worth checking, and an editor can
## show both at once.
pub(pkg) fn analyze_standalone(
  path: String,
  text: String,
  std: StdCtx,
  opts: CtOpts,
  js: Jsig
) -> Program !Fs !Env !io = {
  let (m, pdiags) = parser.parse_module(text)
  var diags: List[LocDiag] = []
  match entry_name_of(path) {
    Some(nm) -> {
      let bad = bad_segments(nm)
      if len(bad) > 0 {
        diags = diags ++ [synthetic(path,
          "`" ++ bad[0] ++ "` is not a valid module path segment",
          "a source file's name is its module path: rename it so every " ++
            "segment is a lowercase identifier ([a-z_][a-z0-9_]*)")]
      }
    }
    None -> ()
  }
  let mf = LoadedModule {
    mod_path: "main",
    class_name: "main",
    path: path,
    text: text,
    line_starts: lexer.line_starts_of(text),
    m: m,
    pdiags: pdiags,
    pkg: None,
    # a buffer with no tree around it is named by its file name, the
    # single-file rule with the buffer's own directory as the root
    site_path: base_name(path),
    # a single document analysed on its own is its own program's entry
    entry: true
  }
  analyze_program(LoadResult { modules: [mf], diags: diags }, std, opts, js)
}

## The identity `analyze_standalone` settled on for its one buffer. Callers
## used to write the literal "main", which is what that function proposes and
## no longer always what comes back.
pub(pkg) fn standalone_entry(prog: Program) -> String =
  if len(prog.modules) == 0 { "main" } else { prog.modules[0].mod_path }

## Analyze the file behind an editor buffer (the Kotlin `analyzeDocument`):
## no module imports → standalone; otherwise load the project with the buffer
## text overriding the on-disk file, so unsaved edits see cross-module context.
## Returns the whole program (cross-file definition targets need the other
## modules' ASTs) plus the entry's mod_path; the entry's own diagnostics are
## the prog.diags rows whose path is the entry file.
pub(pkg) fn analyze_document_planned(
  path: String,
  text: String,
  std: StdCtx,
  opts: CtOpts,
  js: Jsig
) -> DocumentAnalysis !Fs !Proc !Env !io = {
  if not has_module_use(text) {
    let prog = analyze_standalone(path, text, std, opts, js)
    return DocumentAnalysis { prog: prog, entry: standalone_entry(prog), plan: None }
  }
  let abs = canon_identity(path)
  var over: Map[String, String] = map.empty()
  over = map.insert(over, abs, text)
  let plan = project_plan(source.SourceFile(path))
  let loaded = load_entries_over(plan, [path], over)
  var loaded_entry = false
  for mf in loaded.modules {
    if canon_identity(mf.path) == abs { loaded_entry = true }
  }
  if not loaded_entry {
    let prog = analyze_standalone(path, text, std, opts, js)
    return DocumentAnalysis { prog: prog, entry: standalone_entry(prog), plan: Some(plan) }
  }
  # the entry's mod_path is read off the *analysis*, not off the load: a
  # bundled std source is checked under its std module path, and the loader
  # that produced this LoadedModule had no way to know that
  let prog = analyze_program(loaded, std, opts, js)
  var entry = ""
  for cm in prog.modules {
    if entry == "" && canon_identity(cm.path) == abs { entry = cm.mod_path }
  }
  DocumentAnalysis { prog: prog, entry: entry, plan: Some(plan) }
}

# ---- tests ----

# Every test below runs against a `std/memfs` table rather than the disk:
# the tree a test writes is the whole file system its analysis can reach, and
# the std it loads is the embedded copy `driver/fsmem` mounts where `--std`
# defaults to. The paths still read `/tmp/...` because that is what a project
# directory looks like; nothing under them is ever created.
# The table answers `Fs`; `Proc` is answered by the real handler, which the
# planning path below reaches when a project names a url dependency. Only the
# two tests that use `in_mem_proc` declare one, and those answer `Proc` from a
# table instead -- but the row has to be answered somewhere for the rest, and
# this is the boundary that owns the whole test.
#
# The environment is a table too (`compiler_plan/envmem`), so the working
# directory these run in is declared rather than inherited. It is
# `memfs.BASE`, the directory the file table already resolves relative
# paths against, which is what makes a relative target mean the same thing to
# both handlers -- and what lets a test name one at all: `canon` resolves a
# relative path against `io.cwd()`, so before this the answer was the
# directory the runner happened to be started in.
#
# The `!io` on the three rows below was the seed's when they were written, and
# the backfill a seed round later was supposed to take it off. It did not, and
# the rows say why: the production functions these tests call still declare
# `!io` for a reason of their own, which is the `use java` reflection behind
# `check.checker.check_module`, not `io.cwd` and `io.getenv`. Narrowing a row
# to `!Fs !Proc !Env` is refused with `expected fn() -> Unit !(Env|Fs|Proc),
# got fn() -> Unit !(Env|Fs|Proc|io)`. So `!io` here is not a seed artifact and
# will not come off with the next one; it comes off when the Java signature
# chain does. The rows stay pinned by `scripts/doc-check.py`'s
# `check_analyze_env_table`, which is also what says no test below installs
# `with_env_real` any more.
fn in_mem[T](body: fn() -> T !Fs !Proc !Env !io) -> T !io = {
  let (out, _) = in_mem_env(body)
  out
}

## The same, with the environment queries handed back in the order they were
## asked. For a test that says which of them the analysis made, including the
## one that says it made none.
fn in_mem_env[T](
  body: fn() -> T !Fs !Proc !Env !io
) -> (T, List[envmem.EnvCall]) !io = {
  let (pair, _) = memfs.with_fs(fsmem.mem_std(memfs.BASE),
    () => io.with_proc_real(
      () => envmem.with_env_table(memfs.BASE, mem_vars(), body)))
  pair
}

## The environment these tests declare. `DAWN_PKG_CACHE` names the package
## cache inside the table's own tree: with the host answering,
## `pkgfetch.cache_root()` read the developer's `HOME` and the url-dependency
## tests below staged their cache entry under whatever came back.
fn mem_vars() -> List[(String, String)] =
  [("DAWN_PKG_CACHE", "${memfs.BASE}/pkg-cache")]

## The same, with the child processes scripted too: `script` answers `Proc` in
## order and every invocation comes back for inspection.
##
## A project that names a url dependency fetches it while it is being planned,
## and that fetch is a `curl`. Under this handler the fetch is a table lookup:
## nothing is downloaded, nothing is spawned, and what the resolver would have
## asked the network is a value the test can read.
fn in_mem_proc[T](
  script: List[procmem.ProcReply],
  body: fn() -> T !Fs !Proc !Env !io
) -> (T, List[procmem.ProcCall]) !io = {
  let (paired, _) = memfs.with_fs(fsmem.mem_std(memfs.BASE),
    () => procmem.with_proc_table(script,
      () => envmem.with_env_table(memfs.BASE, mem_vars(), body)))
  let (env_pair, calls) = paired
  let (out, _) = env_pair
  (out, calls)
}

# The std the table mounts, spelled absolutely. The bare `std` the command line
# defaults to would be resolved against the process's working directory: one
# host call per std file, for a base the table does not share.
fn std_dir() -> String = fsmem.mem_std_dir(memfs.BASE)

fn mkdirs(p: String) -> Unit !Fs = {
  let _ = io.mkdirs(p)
  ()
}

fn put(p: String, text: String) -> Unit !Fs =
  match io.write_file(p, text) {
    Ok(_) -> ()
    Err(e) -> panic("test setup: ${e.message}")
  }

test "a two-module project analyzes end to end" {
  in_mem(() => {
    let root = "/tmp/dawn-selfhost-analyze/proj1"
    mkdirs("${root}/src")
    put("${root}/src/util.dawn",
      "use std/str\npub fn greet(n: String) -> String = \"hi \" ++ str.trim(n)\n")
    put("${root}/src/main.dawn",
      "use util\npub fn main() -> Unit !io = println(util.greet(\" dawn \"))\n")
    let std = match load_std(std_dir()) {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let loaded = load_directory(root)
    assert len(loaded.diags) == 0
    assert len(loaded.modules) == 2
    # dependency order: util before main
    assert loaded.modules[0].mod_path == "util"
    assert loaded.modules[1].mod_path == "main"
    # jsig_refused: a project with no `use java` analyzes without any oracle
    let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
    assert len(prog.diags) == 0
  })
}

## The folded value of `name` in the module at `mod_path`.
fn folded(prog: Program, mod_path: String, name: String) -> Option[CValue] = {
  for cm in prog.modules {
    if cm.mod_path == mod_path { return map.get(cm.ct.consts, name) }
  }
  None
}

test "comptime calls the functions of the modules before it" {
  in_mem(() => {
    # spec 7.2 item 1: a const may call any pure function, the dependency
    # modules' included. Each const below crosses a module boundary in a
    # different way, and the folding module declares its own `K`, `BASE` and
    # `LIMIT`, so a callee that read its constants in the caller's terms
    # would fold the wrong number rather than fail.
    let base = "/tmp/dawn-selfhost-analyze/comptime-xmod"
    mkdirs("${base}/pk/src")
    mkdirs("${base}/app/src/deep")
    mkdirs("${base}/app/src/lib")
    put("${base}/pk/dawn.toml", "schema = 1\nname = \"pk\"\n")
    put("${base}/pk/src/arith.dawn", "pub const SCALE: Int = 10\n" ++
        "pub fn scaled(x: Int) -> Int = x * SCALE\n" ++
        "pub fn sum_sq(xs: List[Int]) -> Int = fold(map(xs, (x) => x * x), 0, (a, b) => a + b)\n")
    put("${base}/app/dawn.toml", "schema = 1\nname = \"app\"\n[deps]\npk = \"../pk\"\n")
    put("${base}/app/src/deep/c.dawn",
      "pub const BASE: Int = 100\npub fn base_plus(x: Int) -> Int = x + BASE\n")
    put("${base}/app/src/deep/b.dawn",
      "use deep/c\npub const BASE: Int = 7\npub fn via(x: Int) -> Int = c.base_plus(x) + BASE\n")
    put("${base}/app/src/lib/shape.dawn", "use pk/arith.{SCALE as K}\n" ++
        "pub trait Area[T] {\n  fn area(x: T) -> Int\n  fn twice(x: T) -> Int = area(x) * 2\n}\n" ++
        "pub type Sq = { side: Int }\n" ++
        "impl Area[Sq] {\n  fn area(x: Sq) -> Int = x.side * x.side\n}\n" ++
        "pub const LIMIT: Int = 3\n" ++
        "pub fn by_k(x: Int) -> Int = x * K + LIMIT\n")
    put("${base}/app/src/main.dawn", "use deep/b\nuse lib/shape.{Sq, area, twice}\n" ++
        "use lib/shape\nuse pk/arith\n" ++
        "const K: Int = 1000\nconst BASE: Int = 2000\nconst LIMIT: Int = 3000\n" ++
        "const CHAIN: Int = b.via(1)\n" ++
        "const IMPL: Int = area(Sq { side: 4 })\n" ++
        "const DEFAULT: Int = twice(Sq { side: 3 })\n" ++
        "const QUALIFIED: Int = shape.LIMIT + 1\n" ++
        "const PKG: Int = arith.sum_sq([1, 2, 3]) + arith.scaled(4)\n" ++
        "const SCOPED: Int = shape.by_k(2)\n" ++
        "const BLOCK: Int = comptime { arith.scaled(arith.SCALE) }\n" ++
        "pub fn main() -> Unit !io = println(to_string(K + BASE + LIMIT + CHAIN + IMPL +\n" ++
        "  DEFAULT + QUALIFIED + PKG + SCOPED + BLOCK))\n")
    let std = match load_std(std_dir()) {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let prog = analyze_program(load_directory("${base}/app"), std, ct_default(), jsig_refused())
    assert len(prog.diags) == 0
    # c's BASE inside c's body, b's inside b's: two modules deep
    assert folded(prog, "main", "CHAIN") == Some(VInt(108))
    assert folded(prog, "main", "IMPL") == Some(VInt(16))
    assert folded(prog, "main", "DEFAULT") == Some(VInt(18))
    assert folded(prog, "main", "QUALIFIED") == Some(VInt(4))
    # a path dependency's functions, lambdas lifted from its bodies included
    assert folded(prog, "main", "PKG") == Some(VInt(54))
    # `K` is shape's renamed import and `LIMIT` its own, not main's
    assert folded(prog, "main", "SCOPED") == Some(VInt(23))
    assert folded(prog, "main", "BLOCK") == Some(VInt(100))
    let main_ct = prog.modules[len(prog.modules) - 1].ct
    assert set.has(main_ct.reads, "deep/c")
    assert set.has(main_ct.reads, "pk/arith")
    assert not main_ct.missed
  })
}

test "comptime still refuses another module's effectful function" {
  in_mem(() => {
    let root = "/tmp/dawn-selfhost-analyze/comptime-xmod-io"
    mkdirs("${root}/src")
    put("${root}/src/nums.dawn",
      "pub fn doubled(x: Int) -> Int = x * 2\npub fn loud() -> Int !io = {\n  println(\"x\")\n  1\n}\n")
    put("${root}/src/main.dawn", "use nums\nconst Q: Int = nums.doubled(21)\n" ++
        "const X: Int = nums.loud()\npub fn main() -> Unit !io = println(to_string(Q + X))\n")
    let std = match load_std(std_dir()) {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let prog = analyze_program(load_directory(root), std, ct_default(), jsig_refused())
    assert len(prog.diags) == 1
    assert str.contains(prog.diags[0].d.msg, "must be pure")
  })
}

test "a qualified function value from an aliased package dependency checks" {
  in_mem(() => {
    let base = "/tmp/dawn-selfhost-analyze/qualified-fn"
    mkdirs("${base}/pkg/cleaner/src")
    mkdirs("${base}/app/src")
    put("${base}/pkg/cleaner/dawn.toml", "schema = 1\nname = \"cleaner\"\n")
    put("${base}/pkg/cleaner/src/tree.dawn",
      "pub fn delete_tree(path: String) -> Unit !io = println(path)\n")
    put("${base}/app/dawn.toml",
      "schema = 1\nname = \"app\"\n[deps]\ncleanup = \"../pkg/cleaner\"\n")
    put("${base}/app/src/main.dawn", "use cleanup/tree as pkgfetch\n" ++
        "fn bracket(dir: String, close: fn(String) -> Unit !io) -> Unit !io = close(dir)\n" ++
        "pub fn main() -> Unit !io = bracket(\"work\", pkgfetch.delete_tree)\n")
    let std = match load_std(std_dir()) {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let prog = analyze_program(load_directory("${base}/app"), std, ct_default(), jsig_refused())
    assert len(prog.diags) == 0
    assert prog.modules[0].mod_path == "cleaner/tree"
    assert prog.modules[0].class_name == "dawn\$pkg\$cleaner/tree"
  })
}

test "the representation modules are closed to user code (audit RD-06)" {
  in_mem(() => {
    # The accept half is `load_std` itself: std/map is a `use std/hamt`-free
    # module only because lowering rewrites its primitives, but std/list does
    # import std/set's primitives and the bundle as a whole is checked with the
    # gate on. A std module that the gate wrongly refused would fail this load
    # with "does not check", so the two halves are one test.
    let std = match load_std(std_dir()) {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let root = "/tmp/dawn-selfhost-analyze/substrate"
    mkdirs("${root}/src")
    put("${root}/src/main.dawn",
      "use std/hamt\nuse std/pvec\npub fn main() -> Unit !io = ()\n")
    let prog = analyze_program(load_directory(root), std, ct_default(), jsig_refused())
    assert len(prog.diags) == 2
    assert prog.diags[0].d.msg == "`std/hamt` is internal to the standard library"
    assert str.contains(prog.diags[0].d.hint, "use std/map or std/set")
    assert prog.diags[1].d.msg == "`std/pvec` is internal to the standard library"
    assert str.contains(prog.diags[1].d.hint, "use std/list")
  })
}

test "an impl is in force in every module, not just its own (spec §3.5)" {
  in_mem(() => {
    let root = "/tmp/dawn-selfhost-analyze/trait-cross"
    mkdirs("${root}/src")
    put("${root}/src/lib.dawn",
      "pub trait Sizey[T] { fn sizey(x: T) -> Int }\n" ++
        "pub type Box = { n: Int } derive Show\n" ++
        "impl Sizey[Box] { fn sizey(b: Box) -> Int = b.n + 2 }\n" ++
        "pub fn describe[T: Sizey](x: T) -> Int = sizey(x)\n")
    # every spelling that reaches the impl from outside its module: a generic
    # entry whose bound is solved at the call site, the method called through
    # the module alias, the method imported by name, and UFCS on the import.
    # `derive Show` on an imported type is the same question -- the derived
    # impl is an impl -- and it was equally unreachable.
    put("${root}/src/main.dawn",
      "use lib\nuse lib.{Box, sizey}\n" ++
        "pub fn main() -> Unit !io = println(to_string(lib.describe(Box { n: 1 }))\n" ++
        "  ++ to_string(lib.sizey(Box { n: 2 })) ++ to_string(sizey(Box { n: 3 }))\n" ++
        "  ++ to_string(Box { n: 4 }.sizey()) ++ to_string(Box { n: 5 }))\n")
    let std = match load_std(std_dir()) {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let loaded = load_directory(root)
    assert len(loaded.diags) == 0
    let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
    for d in prog.diags { panic("unexpected: ${d.d.msg}") }
    assert len(prog.diags) == 0
  })
}

test "a second module cannot supply a rival impl" {
  in_mem(() => {
    # The program-wide coherence check now sees the whole program's table, but
    # it is not what reports this: the orphan rule gets there first, and between
    # two *different* modules it always does. An impl may only live with its
    # trait or with its subject, and a module that could name both would have to
    # import the other, which the loader rejects as a cycle. So "one impl per
    # trait and type" holds across modules by construction, and the accumulated
    # table is what makes the module that *uses* the pair see the one impl.
    let root = "/tmp/dawn-selfhost-analyze/trait-rival"
    mkdirs("${root}/src")
    put("${root}/src/lib.dawn",
      "pub trait Sizey[T] { fn sizey(x: T) -> Int }\n" ++
        "pub type Box = { n: Int }\n" ++
        "impl Sizey[Box] { fn sizey(b: Box) -> Int = b.n + 2 }\n")
    put("${root}/src/main.dawn",
      "use lib.{Sizey, Box}\n" ++
        "impl Sizey[Box] { fn sizey(b: Box) -> Int = b.n }\n" ++
        "pub fn main() -> Unit !io = ()\n")
    let std = match load_std(std_dir()) {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let prog = analyze_program(load_directory(root), std, ct_default(), jsig_refused())
    assert len(prog.diags) == 1
    assert str.contains(prog.diags[0].d.msg, "orphan impl: `Sizey[Box]`")
  })
}

test "closure loading skips an unreferenced module (module-access 2.2)" {
  in_mem(() => {
    let root = "/tmp/dawn-selfhost-analyze/closure1"
    mkdirs("${root}/src")
    put("${root}/src/main.dawn", "pub fn main() -> Unit !io = println(\"hi\")\n")
    # broken on purpose, and nothing imports it
    put("${root}/src/orphan.dawn", "fn bad() -> Int = \"nope\"\n")
    # the full load sees both (bit-rot protection, the default)
    let full = load_directory(root)
    assert len(full.modules) == 2
    # the closure load seeds from the entry and never reaches the orphan
    let clo = load_file("${root}/src/main.dawn")
    assert len(clo.modules) == 1
    assert clo.modules[0].mod_path == "main"
  })
}

test "a module may be imported qualified and selectively at once" {
  in_mem(() => {
    # Two different acts: one binds a module alias to call through, the other
    # binds names. A module that exports a type AND functions needs both, and
    # the qualified spelling is the whole point of the former.
    let root = "/tmp/dawn-selfhost-analyze/proj-dual"
    mkdirs("${root}/src")
    put("${root}/src/main.dawn",
      "use std/str\nuse std/str.{trim}\n" ++
        "pub fn main() -> Unit !io = println(trim(str.repeat(\" a \", 1)))\n")
    let loaded = load_directory(root)
    for ld in loaded.diags {
      if str.contains(ld.d.msg, "imported more than once") { assert false }
    }

    # the same kind twice is still an error
    let root2 = "/tmp/dawn-selfhost-analyze/proj-dup"
    mkdirs("${root2}/src")
    put("${root2}/src/main.dawn",
      "use std/str\nuse std/str\npub fn main() -> Unit !io = ()\n")
    let loaded2 = load_directory(root2)
    var dup = false
    for ld in loaded2.diags {
      if str.contains(ld.d.msg, "imported more than once") { dup = true }
    }
    assert dup
  })
}

test "a module alias collides with an imported name in either source order" {
  in_mem(() => {
    # bind_import catches `use a/b` before `use a/b.{b}` by reading the alias
    # table as it stands. Nothing read the name table on the way in, so the same
    # pair reversed used to pass and `b` became a binding *and* an alias (#185).
    let std = match load_std(std_dir()) {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }

    let root = "/tmp/dawn-selfhost-analyze/alias-order"
    mkdirs("${root}/src/a")
    put("${root}/src/a/b.dawn", "pub fn b(x: Int) -> Int = x\npub fn make(x: Int) -> Int = x\n")
    put("${root}/src/main.dawn", "use a/b.{b}\nuse a/b\npub fn main() -> Unit !io = ()\n")
    var shadow = false
    for ld in analyze_program(load_directory(root), std, ct_default(), jsig_refused()).diags {
      if str.contains(ld.d.msg, "shadows the imported module") { shadow = true }
    }
    assert shadow

    # the name and the alias need not come from the same module
    let root2 = "/tmp/dawn-selfhost-analyze/alias-order-x"
    mkdirs("${root2}/src/a")
    mkdirs("${root2}/src/a2")
    put("${root2}/src/a/b.dawn", "pub fn make(x: Int) -> Int = x\n")
    put("${root2}/src/a2/z.dawn", "pub fn b(x: Int) -> Int = x\n")
    put("${root2}/src/main.dawn", "use a2/z.{b}\nuse a/b\npub fn main() -> Unit !io = ()\n")
    var shadow2 = false
    for ld in analyze_program(load_directory(root2), std, ct_default(), jsig_refused()).diags {
      if str.contains(ld.d.msg, "shadows the imported module") { shadow2 = true }
    }
    assert shadow2

    # and names that do not collide still coexist with the selective import first
    let root3 = "/tmp/dawn-selfhost-analyze/alias-order-ok"
    mkdirs("${root3}/src")
    put("${root3}/src/main.dawn",
      "use std/str.{trim}\nuse std/str\n" ++
        "pub fn main() -> Unit !io = println(trim(str.repeat(\" a \", 1)))\n")
    let ok = analyze_program(load_directory(root3), std, ct_default(), jsig_refused())
    assert len(ok.diags) == 0
  })
}

test "loader reports cycles and missing modules" {
  in_mem(() => {
    let root = "/tmp/dawn-selfhost-analyze/proj2"
    mkdirs("${root}/src")
    put("${root}/src/main.dawn", "use a\npub fn main() -> Unit !io = ()\n")
    put("${root}/src/a.dawn", "use b\npub fn fa() -> Int = 1\n")
    put("${root}/src/b.dawn", "use a\npub fn fb() -> Int = 2\n")
    let loaded = load_directory(root)
    var cyc = false
    for ld in loaded.diags {
      if str.contains(ld.d.msg, "circular module dependency") { cyc = true }
    }
    assert cyc
    let root2 = "/tmp/dawn-selfhost-analyze/proj3"
    mkdirs("${root2}/src")
    put("${root2}/src/main.dawn", "use nope\npub fn main() -> Unit !io = ()\n")
    let loaded2 = load_directory(root2)
    var missing = false
    for ld in loaded2.diags {
      if str.contains(ld.d.msg, "cannot find module `nope`") { missing = true }
    }
    assert missing
  })
}

test "a file whose name is not a path segment is refused, not folded" {
  in_mem(() => {
    # The `use` grammar cannot spell these, so only the entry file -- the one
    # named on the command line -- can carry them in. The old folding turned
    # `a-b` and `a_b` into one class name, and `9x` into `m_9x`, which is the
    # class name `m_9x.dawn` already had.
    let root = "/tmp/dawn-selfhost-analyze/entryname"
    mkdirs(root)
    put("${root}/a-b.dawn", "pub fn main() -> Unit !io = ()\n")
    put("${root}/9x.dawn", "pub fn main() -> Unit !io = ()\n")
    put("${root}/ok_name2.dawn", "pub fn main() -> Unit !io = ()\n")

    let hyphen = load_file("${root}/a-b.dawn")
    assert len(hyphen.modules) == 0
    assert len(hyphen.diags) == 1
    assert hyphen.diags[0].d.msg == "`a-b` is not a valid module path segment"
    assert str.contains(hyphen.diags[0].d.hint, "[a-z_][a-z0-9_]*")
    assert hyphen.diags[0].path == "${root}/a-b.dawn"

    let digit = load_file("${root}/9x.dawn")
    assert len(digit.modules) == 0
    assert len(digit.diags) == 1
    assert digit.diags[0].d.msg == "`9x` is not a valid module path segment"

    # a legal name still loads, and its class name is the module path unchanged
    let good = load_file("${root}/ok_name2.dawn")
    assert len(good.diags) == 0
    assert len(good.modules) == 1
    assert good.modules[0].mod_path == "ok_name2"
    assert good.modules[0].class_name == "ok_name2"
  })
}

test "the editor's standalone path judges the buffer's name too" {
  in_mem(() => {
    # The asymmetry this closes (#176): `analyze_standalone` hardcodes mod_path
    # "main", so the buffer's own file name never reached the check `resolve`
    # runs on its seeds. The language server accepted, in silence, a file that
    # `dawn check` refuses to compile -- and the two paths meet in the same
    # editor, on the same file.
    let root = "/tmp/dawn-selfhost-analyze/standalone"
    mkdirs(root)
    let std = match load_std(std_dir()) {
      Ok(sc) -> sc
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let src = "pub fn main() -> Unit !io = ()\n"

    let bad = analyze_standalone("${root}/a-b.dawn", src, std, ct_default(), jsig_refused())
    assert len(bad.diags) == 1
    assert bad.diags[0].d.msg == "`a-b` is not a valid module path segment"
    assert bad.diags[0].path == "${root}/a-b.dawn"
    # and the buffer is still analysed, unlike the loader's seed: an editor can
    # show the name complaint and the type errors at once
    assert len(bad.modules) == 1

    let good = analyze_standalone("${root}/ok_name2.dawn", src, std, ct_default(), jsig_refused())
    assert len(good.diags) == 0

    # an untitled buffer has no name to judge -- and `<lsp>` is not one
    let untitled = analyze_standalone("<lsp>", src, std, ct_default(), jsig_refused())
    assert len(untitled.diags) == 0
  })
}

test "use_candidates enumerates the tree and its deps the way `use` spells them" {
  in_mem(() => {
    let base = "/tmp/dawn-selfhost-analyze/cands"
    mkdirs("${base}/app/src/deep")
    mkdirs("${base}/pkg/web/src")
    put("${base}/pkg/web/dawn.toml", "schema = 1\nname = \"web\"\n")
    put("${base}/pkg/web/src/types.dawn", "pub fn tag() -> String = \"w\"\n")
    put("${base}/app/dawn.toml", "schema = 1\nname = \"app\"\n\n[deps]\nw = \"../pkg/web\"\n")
    put("${base}/app/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
    put("${base}/app/src/deep/util.dawn", "pub fn f() -> Int = 1\n")
    # a file the `use` grammar cannot name is not a candidate to complete
    put("${base}/app/src/bad-name.dawn", "pub fn f() -> Int = 1\n")

    let c = use_candidates("${base}/app/src/main.dawn")
    assert sort(map.keys(c)) == ["deep/util", "main", "w/types"]
    # the dep appears under the alias the manifest spells, not the package's own
    # name: `use w/types` is what this app writes, `web` is what it resolves to
    assert str.ends_with(map.get(c, "w/types").expect("dep module"), "/web/src/types.dawn")

    # a buffer with no file behind it has no tree to walk
    assert len(map.keys(use_candidates("<lsp>"))) == 0
  })
}

test "directory mode refuses one badly named module without losing the rest" {
  in_mem(() => {
    let root = "/tmp/dawn-selfhost-analyze/entrydir"
    mkdirs("${root}/src")
    put("${root}/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
    put("${root}/src/bad-name.dawn", "pub fn f() -> Int = 1\n")
    let loaded = load_directory(root)
    assert len(loaded.modules) == 1
    assert loaded.modules[0].mod_path == "main"
    assert len(loaded.diags) == 1
    assert loaded.diags[0].d.msg == "`bad-name` is not a valid module path segment"
  })
}

test "an aliased path dep canonicalizes to the package's real name" {
  in_mem(() => {
    let base = "/tmp/dawn-selfhost-analyze/proj4"
    mkdirs("${base}/pkg/web/src")
    mkdirs("${base}/app/src")
    put("${base}/pkg/web/dawn.toml", "schema = 1\nname = \"web\"\n")
    put("${base}/pkg/web/src/types.dawn", "pub fn tag() -> String = \"w\"\n")
    put("${base}/app/dawn.toml",
      "schema = 1\nname = \"app\"\n\n[deps]\nw = \"../pkg/web\"\n")
    put("${base}/app/src/main.dawn",
      "use w/types\n\npub fn main() -> Unit !io = println(types.tag())\n")
    let loaded = load_directory("${base}/app")
    assert len(loaded.diags) == 0
    # the aliased import loads under the real name and namespace (§4.3/§4.4)
    var found = false
    for m in loaded.modules {
      if m.mod_path == "web/types" {
        found = true
        assert m.class_name == "dawn\$pkg\$web/types"
      }
    }
    assert found
  })
}

# ---- a dependency the project does not have on disk ----
#
# The one shape the tests above cannot reach with a tree alone: a `[deps.x]`
# with a url, which the planner resolves by fetching. Both tests below declare
# one and answer `Proc` from a table, so the resolver's reach for the network
# is a recorded command line rather than a download.

fn has_diag(loaded: LoadResult, msg: String) -> Bool = {
  for ld in loaded.diags {
    if ld.d.msg == msg { return true }
  }
  false
}

const URL_DEP_HASH: String = "d1:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

const URL_DEP_URL: String = "https://example.invalid/greeter/v1.0.0.tar.gz"

fn url_dep_manifest() -> String =
  "schema = 1\nname = \"app\"\n\n[deps.greeter]\nurl = \"" ++ URL_DEP_URL ++
  "\"\nversion = \"1.0.0\"\nhash = \"" ++ URL_DEP_HASH ++ "\"\n"

test "a cold url dependency is fetched while the project is planned" {
  let base = "/tmp/dawn-selfhost-analyze/proj-url-cold"
  let (loaded, log) = in_mem_proc(
    [procmem.failed(22, "curl: (22) The requested URL returned error: 404\n")],
    () => {
      mkdirs("${base}/src")
      put("${base}/dawn.toml", url_dep_manifest())
      put("${base}/src/main.dawn",
        "use greeter/hello\n\npub fn main() -> Unit !io = println(hello.greet())\n")
      load_directory(base)
    })
  # planning the project reached the network exactly once, and this is what it
  # asked: the manifest's url, behind curl's own failure flag
  assert len(log) == 1
  let argv = procmem.call_argv(log, 0)
  assert len(argv) == 12
  assert argv[0] == "curl"
  assert argv[4] == "--fail"
  assert argv[11] == URL_DEP_URL
  # and this is what the refusal becomes: the package the manifest names, at
  # the version it asked for, followed by what curl said
  assert has_diag(loaded, "package `greeter` 1.0.0: cannot fetch " ++ URL_DEP_URL ++
      ": curl: (22) The requested URL returned error: 404" ++
      "\n  check the network (https_proxy is honored) or pre-seed the cache")
  # the dependency is not on disk, so its module is missing too -- one cause,
  # two diagnostics, and the fetch failure is the one that explains it
  assert has_diag(loaded, "cannot find module `greeter/hello`")
}

test "a warm url dependency is analyzed without consulting curl" {
  let base = "/tmp/dawn-selfhost-analyze/proj-url-warm"
  let (loaded, log) = in_mem_proc([], () => {
    # the cache entry, under the name the hash gives it, with the record that
    # says this url produced these bytes
    let root = pkgfetch.cache_root()
    let entry = pkgfetch.cache_dir(root, URL_DEP_HASH)
    mkdirs("${entry}/src")
    put("${entry}/dawn.toml", "schema = 1\nname = \"greeter\"\n")
    put("${entry}/src/hello.dawn", "pub fn greet() -> String = \"hi\"\n")
    pkgfetch.record_origin(root, URL_DEP_HASH, URL_DEP_URL)
    mkdirs("${base}/src")
    put("${base}/dawn.toml", url_dep_manifest())
    put("${base}/src/main.dawn",
      "use greeter/hello\n\npub fn main() -> Unit !io = println(hello.greet())\n")
    load_directory(base)
  })
  # the empty script is the assertion: a fetch here would have panicked for
  # want of a reply
  assert len(log) == 0
  assert len(loaded.diags) == 0
  # the alias resolves to the package's own name, out of the cache entry
  var found = false
  for m in loaded.modules {
    if m.mod_path == "greeter/hello" {
      found = true
      assert m.class_name == "dawn\$pkg\$greeter/hello"
    }
  }
  assert found
}

# ---- std identity (a file's provenance, never its module path) ----

fn std_or_die() -> StdCtx !Fs !Env !io =
  match load_std(std_dir()) {
    Ok(sc) -> sc
    Err(e) -> panic("std: ${std_load_error_text(e)}")
  }

fn slurp(p: String) -> String !Fs =
  match io.read_file(p) {
    Ok(t) -> t
    Err(e) -> panic("test setup: ${e.message}")
  }

fn has_msg(prog: Program, msg: String) -> Bool = {
  for ld in prog.diags {
    if ld.d.msg == msg { return true }
  }
  false
}

test "every bundled std source checks clean on its own" {
  in_mem(() => {
    # The bug this closes: `dawn check std/cursor.dawn` reported 281 errors
    # across the bundle -- the first of them on line 50, the line that defines
    # the very `cursor.start` its hint told the reader to call instead. std was
    # checked as user code because the loader named the file after its source
    # root (`cursor`) and the checker read std-ness off that name.
    #
    # This walks modules.txt rather than listing names, so a std module added
    # later is covered the day it is added.
    let std = std_or_die()
    let names = match read_index(std_dir()) {
      Ok(ns) -> ns
      Err(e) -> panic("std index: ${e}")
    }
    assert len(names) > 0
    for n in names {
      let file = std_dir() ++ "/" ++ n ++ ".dawn"
      let prog = analyze_program(load_file(file), std, ct_default(), jsig_refused())
      if len(prog.diags) > 0 { println(file ++ ": " ++ prog.diags[0].d.msg) }
      assert len(prog.diags) == 0
      assert len(prog.modules) == 1
      # under its real identity, not the one its source root would give it
      assert prog.modules[0].mod_path == "std/${n}"
      assert prog.modules[0].cx.is_std_module
    }
  })
}

test "std identity is where the file came from, not what the module is called" {
  in_mem(() => {
    # A project file at src/std/cursor.dawn is spelled exactly like a bundled
    # module and is not one. The loader's reserved-path diagnostic already
    # refused it -- and that diagnostic used to be the *only* thing refusing it,
    # because the checker read std-ness off the name and opened the std-only
    # builtins to it. Both halves are asserted: a fix that keeps the diagnostic
    # and leaves the surface open has not closed anything.
    let std = std_or_die()
    let root = "/tmp/dawn-selfhost-analyze/stdspell"
    mkdirs("${root}/src/std")
    let impostor = "${root}/src/std/cursor.dawn"
    put(impostor, slurp("${std_dir()}/cursor.dawn"))
    let prog = analyze_program(load_file(impostor), std, ct_default(), jsig_refused())
    assert len(prog.modules) == 1
    assert prog.modules[0].mod_path == "std/cursor"
    assert not prog.modules[0].cx.is_std_module
    assert has_msg(prog, "the module path `std/cursor` is reserved for the bundled standard library")
    assert has_msg(prog, "undefined function: cursor_start")

    # the same question asked directly, on the same module path, twice
    assert std_module_of(std, "${std_dir()}/cursor.dawn") == Some("std/cursor")
    let absent: Option[String] = None
    assert std_module_of(std, impostor) == absent
  })
}

test "module identity carry keeps exporting owners across header reorder" {
  in_mem(() => {
    let std = std_or_die()
    let initial = initial_carry(std)
    # the intern table behind std's derived ids reaches a user module on the
    # carry, which is the only thing left on it that every module shares
    assert initial.identities == std.identities
    assert map.len(initial.identities) > 0
    var ids: List[Int] = []
    var binders: List[Int] = []
    # Each block carries a nominal declaration and a binder one. Reordering
    # the two blocks moves neither: `First` and `Second` derive their ids from
    # their declarations, and the two type parameters are slot zero of the
    # function that binds them. This fixture is where that is said about a
    # whole module rather than about one context.
    let first = "pub type First = { value: Int }\npub fn first_of[T](x: T) -> T = x\n"
    let second = "pub type Second = { value: Int }\npub fn second_of[T](x: T) -> T = x\n"
    for text in [first ++ second, second ++ first] {
      let (syntax, pd) = parser.parse_module(text)
      let input = LoadedModule { mod_path: "library", class_name: "library", path: "/provenance/library.dawn", site_path: "library.dawn",
        text: text, line_starts: lexer.line_starts_of(text), m: syntax, pdiags: pd, pkg: None, entry: false }
      let step = analyze_module_step(input, initial, std, ct_default(), jsig_refused(), None)
      assert len(step.diags) == 0
      let id = map.get(step.checked.cx.adts_by_name, "First").expect("provider ID")
      let binder = match map.get(step.checked.cx.fns, "first_of").expect("provider generic").tparams[0] {
        TyVar(_, v) -> v
        _ -> { assert false
          0 }
      }
      # the module's own derived ids join the carry, so the next module
      # interns against them rather than starting an empty table
      assert map.get(step.after.identities, id) != None
      assert map.len(step.after.identities) > map.len(initial.identities)
      ids = ids ++ [id]
      binders = binders ++ [binder]
      let consumer_text = "use library as dep\nfn consume(x: dep.First) -> dep.First = dep.first_of(x)\n"
      let (consumer_ast, consumer_pd) = parser.parse_module(consumer_text)
      let consumer = LoadedModule { mod_path: "consumer", class_name: "consumer", path: "/provenance/consumer.dawn", site_path: "consumer.dawn",
        text: consumer_text, line_starts: lexer.line_starts_of(consumer_text), m: consumer_ast, pdiags: consumer_pd, pkg: None, entry: false }
      let consumed = analyze_module_step(consumer, step.after, std, ct_default(), jsig_refused(), None)
      assert len(consumed.diags) == 0
      assert map.get(consumed.after.identities, id) != None
    }
    # The two revisions declare the same two blocks in the opposite order.
    # Nothing in either moved: a nominal id derives from its declaration, and
    # a binder is a slot of the declaration that binds it.
    assert ids[0] == ids[1]
    assert binders[0] == binders[1]

    # The same slot under a renamed declaration is a different identity, so
    # its key is a different integer.
    let renamed_text = "pub type First = { value: Int }\npub fn renamed_of[T](x: T) -> T = x\n" ++ second
    let (renamed_ast, renamed_pd) = parser.parse_module(renamed_text)
    let renamed_input = LoadedModule { mod_path: "library", class_name: "library", path: "/provenance/library.dawn", site_path: "library.dawn",
      text: renamed_text, line_starts: lexer.line_starts_of(renamed_text), m: renamed_ast, pdiags: renamed_pd, pkg: None, entry: false }
    let renamed_step = analyze_module_step(renamed_input, initial, std, ct_default(), jsig_refused(), None)
    assert len(renamed_step.diags) == 0
    assert match map.get(renamed_step.checked.cx.fns, "renamed_of").expect("renamed generic").tparams[0] {
      TyVar(_, v) -> v != binders[0]
      _ -> false
    }
  })
}

test "a consumer names a provider's effect without minting the provider's identity" {
  in_mem(() => {
    # The effect half of the test above, which covered the nominal and the
    # type-parameter halves. Two integers cross the module boundary here and
    # they cross it for different reasons: `Ask` is a declared effect, whose
    # id the consumer derives from the provider's spelling and could compute
    # without ever being told, and `!e` is a binder of `twice`, a packed key
    # of the provider's declaration that arrives inside the signature the
    # consumer was handed.
    #
    # Qualified and selective spellings must name the same provider identity.
    let std = std_or_die()
    let initial = initial_carry(std)
    let asks = "pub effect Ask { fn ask() -> Int }\n"
    let generic = "pub fn twice[!e](f: fn() -> Int !e) -> Int !e = f() + f()\n"
    # The provider's own declaration spelling, and nothing about the consumer.
    let declared = identity.derive(identity.minted("library", EffectDecl, "Ask"))
    var effect_ids: List[Int] = []
    var binders: List[Int] = []
    for text in [asks ++ generic, generic ++ asks] {
      let (syntax, pd) = parser.parse_module(text)
      let input = LoadedModule { mod_path: "library", class_name: "library", path: "/provenance/effects.dawn", site_path: "effects.dawn",
        text: text, line_starts: lexer.line_starts_of(text), m: syntax, pdiags: pd, pkg: None, entry: false }
      let step = analyze_module_step(input, initial, std, ct_default(), jsig_refused(), None)
      assert len(step.diags) == 0
      let effect_id = map.get(step.checked.cx.effects, "Ask").expect("provider effect")
      assert effect_id == declared
      let binder = match map.get(step.checked.cx.fns, "twice").expect("provider generic").eparams[0] {
        EffVar(_, v) -> v
        _ -> { assert false
          0 }
      }
      effect_ids = effect_ids ++ [effect_id]
      binders = binders ++ [binder]
      # `relay` is the consumer's own effect-parameter binding, and it is
      # here so that the claim about the provider's binder below is a claim
      # about that binder rather than about an empty table.
      let consumer_text = "use library as dep\nuse library.{Ask}\n" ++
        "fn consume() -> Int !dep.Ask = dep.twice(() => dep.ask())\n" ++
        "fn selective() -> Int !Ask = consume()\n" ++
        "alias Callback = fn() -> Int !dep.Ask\n" ++
        "fn handled() -> Int = { with handle dep.Ask { ask() => 21 }\n consume() }\n" ++
        "fn relay[!f](g: fn() -> Int !f) -> Int !f = dep.twice(g)\n"
      let (consumer_ast, consumer_pd) = parser.parse_module(consumer_text)
      let consumer = LoadedModule { mod_path: "consumer", class_name: "consumer", path: "/provenance/consumer.dawn", site_path: "consumer.dawn",
        text: consumer_text, line_starts: lexer.line_starts_of(consumer_text), m: consumer_ast, pdiags: consumer_pd, pkg: None, entry: false }
      let consumed = analyze_module_step(consumer, step.after, std, ct_default(), jsig_refused(), None)
      # The effect the consumer resolved is the provider's declaration, by
      # value and by derivation: a second mint in the consumer's owner would
      # have produced `identity.derive(minted("consumer", EffectDecl, "Ask"))`,
      # which is a different integer. Asked before the diagnostic count on
      # purpose, so that a consumer which minted its own `Ask` is caught by
      # the integer it minted and not by the mismatch that follows from it.
      assert map.get(consumed.checked.cx.effects, "Ask") == Some(declared)
      assert declared != identity.derive(identity.minted("consumer", EffectDecl, "Ask"))
      assert len(consumed.diags) == 0
      # The consumer binds its own effect parameter, and neither of the
      # provider's integers is it. The effect id is nobody's binding, and the
      # provider's effect parameter belongs to the provider's declaration.
      let own = match map.get(consumed.checked.cx.fns, "relay").expect("consumer generic").eparams[0] {
        EffVar(_, v) -> v
        _ -> { assert false
          0 }
      }
      assert own != binder && own != declared
    }
    # Reordering the provider's two declarations moves neither integer.
    assert effect_ids[0] == effect_ids[1]
    assert binders[0] == binders[1]
  })
}

test "the program a render reads from carries this revision's declaration spans" {
  in_mem(() => {
    # `identity.absolute` keeps a diagnostic's own offsets when the revision
    # has no view of its owner (`check/identity.dawn`), which is the right
    # answer for a diagnostic nothing can locate and the wrong one for a
    # program that simply never collected the views. Nothing asserted which
    # of the two a rendering path gets, and the difference is invisible in a
    # module whose declarations start at the top of the file.
    let std = std_or_die()
    let root = "/tmp/dawn-selfhost-analyze/renderview"
    mkdirs("${root}/src")
    let text = "pub fn other(x: Int) -> Int = x\n\npub fn broken() -> Int = \"not an Int\"\n"
    put("${root}/src/main.dawn", text)
    let prog = analyze_program(load_directory(root), std, ct_default(), jsig_refused())
    # Every module a render may reach has a view of the revision it was
    # checked from, which is the whole of what `rendered_diags` needs.
    assert len(prog.modules) == 1
    for cm in prog.modules { assert map.has(prog.decl_spans, cm.mod_path) }
    var owned = 0
    for ld in prog.diags {
      if ld.d.owner != None { owned = owned + 1 }
    }
    assert owned == len(prog.diags) && owned > 0
    let literal = match str.index_of(text, "\"not an Int\"") {
      Some(i) -> i
      None -> panic("the fixture has no literal")
    }
    let rendered = rendered_diags(prog)
    assert len(rendered) == len(prog.diags)
    var located = false
    for ld in rendered {
      assert ld.d.owner == None
      if ld.d.lo == literal && ld.d.hi == literal + 12 { located = true }
    }
    assert located
    # The same program with the views dropped is the silent fallback, and it
    # is silent: the offsets come back declaration-relative, still owned, and
    # point into the file's first declaration. That is why the assertion
    # above is about the program the render reads and not about `absolute`.
    let viewless = Program { ..prog, decl_spans: map.empty() }
    let unresolved = rendered_diags(viewless)
    assert unresolved != rendered
    for ld in unresolved {
      assert ld.d.owner != None && ld.d.lo < literal
    }
  })
}

test "user code still cannot reach a std-only builtin" {
  in_mem(() => {
    # The negative control for all of the above. Opening std to its own sources
    # is worth nothing if it also opened the intrinsic table to everyone, and
    # the same hint the bug report quoted is what user code is supposed to get.
    let std = std_or_die()
    let root = "/tmp/dawn-selfhost-analyze/useronly"
    mkdirs("${root}/src")
    put("${root}/src/main.dawn",
      "pub fn main() -> Unit !io = println(cursor_done(\"a\", cursor_start(\"a\")))\n")
    let prog = analyze_program(load_directory(root), std, ct_default(), jsig_refused())
    assert not prog.modules[0].cx.is_std_module
    # The hint that used to follow ("use std/cursor, then cursor.start(...)")
    # was a std/moved.txt-style entry from v0.6.0 and expired with the rest
    # of that table (docs/std-moved-design.md §2); the refusal is the point.
    assert has_msg(prog, "undefined function: cursor_start")
  })
}

test "the editor's standalone path gives a bundled std buffer its std identity" {
  in_mem(() => {
    # The journey the bug was reported from: an editor opens std/list.dawn and
    # every line that touches a std-only builtin is underlined. Both language
    # server entries (didOpen and didChange) land in `analyze_standalone`, which
    # names every buffer `main` -- so the buffer's name can never be the
    # evidence, and this is the case a name-shaped fix cannot reach.
    let std = std_or_die()
    let text = slurp("${std_dir()}/cursor.dawn")
    let prog =
      analyze_standalone("${std_dir()}/cursor.dawn", text, std, ct_default(), jsig_refused())
    assert len(prog.diags) == 0
    assert standalone_entry(prog) == "std/cursor"

    # the same bytes at a path that is not the bundle's are user code
    let root = "/tmp/dawn-selfhost-analyze/stdbuffer"
    mkdirs(root)
    let copy = "${root}/cursor.dawn"
    put(copy, text)
    let other = analyze_standalone(copy, text, std, ct_default(), jsig_refused())
    assert standalone_entry(other) == "main"
    assert has_msg(other, "undefined function: cursor_start")

    # and the project-aware branch, for a std module with `use` edges of its own
    let doc = analyze_document_planned(
      "${std_dir()}/list.dawn", slurp("${std_dir()}/list.dawn"), std, ct_default(),
      jsig_refused())
    assert len(doc.prog.diags) == 0
    assert doc.entry == "std/list"
  })
}

test "the bundled std directory is not a project target" {
  in_mem(() => {
    # `dawn check std` used to answer "project directory has no `src/` folder",
    # which is true and useless: std is not a project and cannot be made into
    # one. Recognised by provenance, so a project that happens to be called
    # `std` still gets the project diagnostics.
    let std = std_or_die()
    let refusal = match std_dir_target(std, std_dir()) {
      Some(lr) -> lr
      None -> panic("the loaded std directory was not recognised")
    }
    assert len(refusal.modules) == 0
    assert len(refusal.diags) == 1
    assert refusal.diags[0].d.msg ==
      "`" ++ std_dir() ++ "` is the bundled standard library, not a Dawn project"

    let root = "/tmp/dawn-selfhost-analyze/notthebundle/std"
    mkdirs("${root}/src")
    put("${root}/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
    match std_dir_target(std, root) {
      Some(_) -> panic("a project directory named std was mistaken for the bundle")
      None -> ()
    }
    assert len(load_target(std, root).diags) == 0
  })
}

test "the analysis reads the declared tree, and no host behind it" {
  # What `Fs` bought. The setup below used to run on the real disk, so neither
  # half of this could be asserted: not "the loader read exactly these bytes"
  # (the answer came from /tmp, where an earlier run's leftovers answer too),
  # and not "the run reached no file outside the tree" (there was no boundary
  # to ask). Both are questions about the table now.
  #
  # And what `Env` bought is the rest of the sentence. This used to say "no
  # file system behind it", because the file system was the only half a
  # handler stood in front of: the environment was still the machine's, and a
  # relative path in here would have been resolved against whatever directory
  # the runner was started in. All three effects are tables now -- the file
  # system, an empty process script, and an environment whose queries come
  # back for inspection -- so nothing at all is behind this run, and the three
  # logs below are how that is said rather than remembered.
  let root = "/tmp/dawn-selfhost-analyze/never-on-disk"
  let main_src = "use util\npub fn main() -> Unit !io = println(util.tag())\n"
  let (((_, envlog), proclog), table) = memfs.with_fs(
    fsmem.mem_std(memfs.BASE),
    () => procmem.with_proc_table([],
      () => envmem.with_env_table(memfs.BASE, mem_vars(), () => {
        mkdirs("${root}/src")
        put("${root}/src/main.dawn", main_src)
        put("${root}/src/util.dawn", "pub fn tag() -> String = \"t\"\n")
        let loaded = load_directory(root)
        assert len(loaded.diags) == 0
        assert len(loaded.modules) == 2
        # the loader's text is the text this test wrote, not a file's contents
        assert loaded.modules[1].text == main_src
        let std = match load_std(std_dir()) {
          Ok(sc) -> sc
          Err(e) -> panic("std: ${std_load_error_text(e)}")
        }
        assert len(analyze_program(loaded, std, ct_default(), jsig_refused()).diags) == 0
      })))
  # the target is absolute and so is the std, so the analysis had no reason to
  # ask where it was standing -- and it did not. An empty environment log is
  # the assertion `Env` exists for: before it, "this run consulted the host
  # zero times" had no observer at all, only a reading of `canon`.
  assert envlog == []
  # the empty process script says the same about children: a spawn here would
  # have panicked for want of a reply, and none was attempted
  assert proclog == []
  # the table is the only source of truth, so what was written can be read back
  assert memfs.text(table, "${root}/src/main.dawn") == Some(main_src)
  # and every file the run touched came from the declared tree or the mounted
  # std: a load that reached out would have left a path here that is neither
  for f in memfs.file_paths(table) {
    assert str.starts_with(f, "${root}/") || str.contains(f, "/std/")
  }
  # the strongest half, and the one no assertion could reach before: ask the
  # host. A run of the same setup on the real disk leaves this directory
  # behind; this one has not been there at all.
  io.with_fs_real(() => {
    assert not io.exists(root)
  })
}

test "a reusing load parses only the files whose text changed" {
  in_mem(() => {
    let root = "/tmp/dawn-selfhost-analyze/reparse"
    mkdirs("${root}/src")
    let main = "${root}/src/main.dawn"
    let util = "${root}/src/util.dawn"
    put(main, "use util\npub fn main() -> Unit !io = println(util.tag())\n")
    put(util, "pub fn tag() -> String = \"t\"\n")
    let plan = project_plan(source.SourceFile(main))
    let none: Map[String, String] = map.empty()
    let first = load_entries_reusing(plan, [main], none, no_parses())
    assert first.parses.reused == 0
    assert first.loaded == load_entries_over(plan, [main], none)
    let again = load_entries_reusing(plan, [main], none, first.parses)
    assert again.parses.reused == 2
    assert again.loaded == first.loaded
    # an overlay is text like any other: the edited file is parsed again, and
    # what comes back is what a load without the memo would have produced
    let edited = map.insert(none, canon_identity(util), "pub fn tag() -> String = \"u\"\n\npub fn more() -> Int = 1\n")
    let changed = load_entries_reusing(plan, [main], edited, again.parses)
    assert changed.parses.reused == 1
    assert changed.loaded == load_entries_over(plan, [main], edited)
    assert changed.loaded != first.loaded
    # only this load's files are kept for the next one
    assert len(map.keys(changed.parses.by_path)) == 2
  })
}

test "a relative target resolves against the declared working directory" {
  # The other thing `Env` bought, and the one this file had no way to write
  # before it. Every test above spells its project as an absolute `/tmp/...`
  # path, and that is not a preference: `canon` resolves a relative path
  # against `io.cwd()`, so a relative target's meaning was whatever directory
  # the runner happened to be started in. There is no `chdir` in this
  # language, so it could not be chosen either.
  #
  # Here it is chosen. The declared directory is the file table's base, so
  # `proj` names the same tree to both handlers, and the module index below
  # holds the absolute path the analysis derived -- which is the declaration,
  # not the process.
  let (plan, log) = in_mem_env(() => {
    mkdirs("proj/src")
    put("proj/src/main.dawn", "use util\npub fn main() -> Unit !io = ()\n")
    put("proj/src/util.dawn", "pub fn tag() -> String = \"t\"\n")
    let loaded = load_directory("proj")
    assert len(loaded.diags) == 0
    assert len(loaded.modules) == 2
    let plan = project_plan(source.ProjectDirectory("proj"))
    # the derivation runs the other way too, off the same base
    assert project_module_path(plan, "proj/src/util.dawn") == Some("util")
    plan
  })
  # the module index is keyed by `use` path and holds canonical file paths, so
  # this is `canon("proj/src/util.dawn")` written out: the declared directory,
  # and nothing of the host's
  assert map.get(plan.modules.by_use, "util") ==
    Some("${memfs.BASE}/proj/src/util.dawn")
  assert map.get(plan.modules.by_use, "main") ==
    Some("${memfs.BASE}/proj/src/main.dawn")
  # the resolution asked, and asked for the working directory rather than for
  # a variable: an implementation that resolved against something it already
  # held would leave this log empty and still pass the paths above
  assert len(log) > 0
  assert log[0] == envmem.AskedCwd
  assert envmem.asked_names(log) == []
  # the declared directory is not the one this test runs in, which is what
  # makes the paths above an assertion about the declaration
  io.with_fs_real(() => io.with_env_real(() => {
    assert io.cwd() != memfs.BASE
  }))
}

## A scratch tree on the real disk holding the links #297 is about, and the
## project directory inside it. A `std/memfs` link is seen only by
## `fs_is_symlink` and `fs_real_path`, and a walk needs it listed as an entry
## of its directory, so this test is on the host: the links are made by `ln`,
## which is also the one way a user makes them.
fn linked_tree() -> (String, String) !Fs !Proc = {
  let root = match io.temp_dir("", "dawn-walk-links-") {
    Ok(d) -> d
    Err(e) -> panic("temp dir: ${e.message}")
  }
  let proj = "${root}/proj"
  for (path, text) in [
    ("${proj}/src/main.dawn", "use sub/util\npub fn main() -> Unit !io = println(util.tag())\n"),
    ("${proj}/src/sub/util.dawn", "pub fn tag() -> String = \"t\"\n"),
    ("${root}/outside/extra.dawn", "pub fn more() -> Int = 1\n")
  ] {
    let _ = io.mkdirs(match str.last_index_of(path, "/") {
      Some(i) -> str.take(path, i)
      None -> path
    })
    match io.write_file(path, text) {
      Ok(_) -> ()
      Err(e) -> panic("cannot write " ++ path ++ ": " ++ e.message)
    }
  }
  # a link back to its own directory, a link out of the tree, and a link to a
  # file inside it
  for (target, at) in [(".", "loop"), ("../../outside", "ext"), ("sub/util.dawn", "alias.dawn")] {
    match io.run(["ln", "-s", target, "${proj}/src/${at}"], "", "") {
      Ok(0) -> ()
      _ -> panic("ln -s " ++ target ++ " " ++ at ++ " failed")
    }
  }
  (root, proj)
}

test "the source walk visits a link to a directory but does not descend (#297, #302)" {
  io.with_fs_real(() => io.with_proc_real(() => {
    let (root, proj) = linked_tree()
    let src = "${proj}/src"
    # the self-loop is not walked, so every module is listed once; the tree
    # behind `ext` is not the project's; the link to a file is a file
    assert walk_dawn(src) == ["${src}/alias.dawn", "${src}/main.dawn", "${src}/sub/util.dawn"]
    # `dawn fmt <dir>` walks with the same rule in both drivers (#302)
    assert dawn_files_under(src) == walk_dawn(src)
    let (plan, _) = envmem.with_env_table(root, [], () =>
        project_plan(source.ProjectDirectory(proj)))
    assert list.sort(map.keys(plan.modules.by_use)) == ["alias", "main", "sub/util"]
    pkgfetch.delete_tree(root)
    assert not io.exists(root)
  }))
}

test "a file under two module paths stays two modules when identities resolve links" {
  # Identity resolves links, and a module path must not: `alias.dawn ->
  # sub/util.dawn` is one file and two modules (spec §10), which is why the
  # loader keys a module by file identity *and* module path.
  io.with_fs_real(() => io.with_proc_real(() => {
    let (root, proj) = linked_tree()
    match io.write_file("${proj}/src/main.dawn",
      "use sub/util\nuse alias\n\npub fn main() -> Unit !io = println(util.tag() ++ alias.tag())\n") {
      Ok(_) -> ()
      Err(e) -> panic("cannot write main: ${e.message}")
    }
    let (loaded, _) = envmem.with_env_table(root, [], () => load_directory(proj))
    assert len(loaded.diags) == 0
    var paths: List[String] = []
    for m in loaded.modules { paths = paths ++ [m.mod_path] }
    assert list.sort(paths) == ["alias", "main", "sub/util"]
    pkgfetch.delete_tree(root)
  }))
}

# ---- a project entered through a link (#207) ----
#
# A `std/memfs` link is seen by `fs_real_path` and nothing else, so a reader
# does not follow it. These trees write the files a kernel would show through
# the link at the link's spelling too, with the same text: both spellings then
# read the way they read on a host, and only identity can tell them apart.

const LINKED: String = "/tmp/dawn-selfhost-analyze/linked"

## The embedded std, plus `home/app -> ../work/app` under `LINKED`.
fn linked_seed() -> memfs.MemFs =
  memfs.link(fsmem.mem_std(memfs.BASE), "${LINKED}/home/app", "../work/app")

fn in_linked[T](body: fn() -> T !Fs !Proc !Env !io) -> T !io = {
  let (pair, _) = memfs.with_fs(linked_seed(),
    () => io.with_proc_real(
      () => envmem.with_env_table(memfs.BASE, mem_vars(), body)))
  let (out, _) = pair
  out
}

## `work/app` depending on `lib = "../lib"`, which is `work/lib`, readable
## through `home/app` as well.
fn put_linked_app(main_src: String) -> Unit !Fs = {
  let app_toml = "schema = 1\nname = \"app\"\n\n[deps]\nlib = \"../lib\"\n"
  for dir in ["${LINKED}/work/app", "${LINKED}/home/app"] {
    put("${dir}/dawn.toml", app_toml)
    put("${dir}/src/main.dawn", main_src)
  }
  put("${LINKED}/work/lib/dawn.toml", "schema = 1\nname = \"lib\"\n")
  put("${LINKED}/work/lib/src/util.dawn", "pub fn answer() -> Int = 42\n")
}

test "a project entered through a link finds its `../` dependency" {
  in_linked(() => {
    let main_src = "use lib/util\n\npub fn main() -> Unit !io = println(to_string(util.answer()))\n"
    put_linked_app(main_src)
    let std = std_or_die()
    for dir in ["${LINKED}/work/app", "${LINKED}/home/app"] {
      let loaded = load_directory(dir)
      assert len(loaded.diags) == 0
      var paths: List[String] = []
      for m in loaded.modules { paths = paths ++ [m.mod_path] }
      assert list.sort(paths) == ["lib/util", "main"]
      assert len(analyze_program(loaded, std, ct_default(), jsig_refused()).diags) == 0
    }
    # the editor's path: a buffer opened through the link is the entry of a
    # project whose dependency resolved, not a file with a missing import
    let doc = analyze_document_planned("${LINKED}/home/app/src/main.dawn", main_src, std,
      ct_default(), jsig_refused())
    assert doc.entry == "main"
    assert len(doc.prog.diags) == 0
  })
}

test "std read through a link is std through either spelling" {
  # `--std` names the directory one way and the file is reached the other:
  # std's files are recognised by identity, so a std source opened through a
  # linked directory keeps the std-only builtins it exists to wrap
  let linked = "${LINKED}/stdlink"
  let seed = memfs.link(fsmem.mem_std(memfs.BASE), linked, fsmem.mem_std_dir(memfs.BASE))
  let (pair, _) = memfs.with_fs(seed,
    () => io.with_proc_real(() => envmem.with_env_table(memfs.BASE, mem_vars(), () => {
      let std = std_or_die()
      assert std_module_of(std, "${linked}/cursor.dawn") == Some("std/cursor")
      assert std_module_of(std, "${linked}/./cursor.dawn") == Some("std/cursor")
      assert is_std_dir(std, linked)
      let text = slurp("${std_dir()}/cursor.dawn")
      let prog = analyze_standalone("${linked}/cursor.dawn", text, std, ct_default(),
        jsig_refused())
      assert standalone_entry(prog) == "std/cursor"
      assert len(prog.diags) == 0
    })))
  let (_, _) = pair
}

# The other half of the property: a wrapper must not *unlock* anything either.
# `Float` has no hash, so a Float key is refused -- and it stayed refused
# through a tuple only after `structural_gap` learned to peel. Before that the
# checker accepted this and lowering panicked.
#
# The diagnostic names the type the user wrote, which is the one thing the two
# spellings are supposed to differ on.
# twin-normalise: Celsius=Float
# twin-rejected: a Float key, refused through the wrapper as it is without one
use std/io
use std/map

opaque type Celsius = Float

pub fn main() -> Unit !io = {
  let c: Celsius = 1.5
  let m: Map[(Celsius, Int), Int] = map.from([((c, 1), 7)])
  println(to_string(map.len(m)))
}

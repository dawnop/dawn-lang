# The string face of the runtime-intrinsic contract, checked against a written
# expectation rather than against whichever backend answered first.
#
# The JVM implements these over `java.lang.String`, which is UTF-16, and the C
# runtime over UTF-8. That difference is supposed to be invisible, and the two
# places it could leak are here: `str.len` and `str.index_of` report *code
# point* counts, so neither backend may report its own storage units.
#
# Length, trimming and the four searches are std/str functions rather than
# intrinsics now -- one definition over the cursor walk, compiled by both
# backends (docs/native-backend-plan.md 14.12) -- so this exercises the walk
# underneath as well. `Cursor` itself stays out of reach: those intrinsics are
# `internal`, and only std may name them.
#
# `parse_float` and float printing live in float_edges.dawn: they joined the
# differential when the rendering became std/fmt.dtoa (audit RP-01).
#
# `use std/raw` is where the primitives std does something to come from:
# `bytes_at`'s -1 and `io_read_file`'s raise are what the two backends have to
# agree on, and std turns each into something else.
use std/char
use std/io
use std/bytes
use std/cursor
use std/raw
use std/str

fn opt_str(o: Option[String]) -> String =
  match o {
    Some(s) -> "[" ++ s ++ "]"
    None -> "none"
  }

fn opt_int(o: Option[Int]) -> String =
  match o {
    Some(i) -> to_string(i)
    None -> "none"
  }

fn ok_or_err(r: Result[String, ForeignError]) -> String =
  match r {
    Ok(_) -> "ok"
    # deliberately not the payload: the JVM's is an exception's toString and
    # native's is the panic message, and that divergence is documented
    Err(_) -> "err"
  }

pub fn main() -> Unit !io = {
  io.println("-- length is in code points --")
  # "aé中𝄞": one byte, two, three, four. Four code points, five UTF-16 units,
  # ten UTF-8 bytes -- so a backend reporting its own units is visible here.
  let mixed = "aé中𝄞"
  io.println("str.len            = " ++ to_string(str.len(mixed)))
  io.println("str.len ascii      = " ++ to_string(str.len("abc")))

  io.println("-- search reports a code-point index --")
  io.println("index_of 中        = " ++ opt_int(str.index_of(mixed, "中")))
  io.println("index_of missing   = " ++ opt_int(str.index_of(mixed, "z")))
  io.println("index_of empty     = " ++ opt_int(str.index_of(mixed, "")))
  io.println("last_index_of l    = " ++ opt_int(str.last_index_of("hello", "l")))
  io.println("last_index_of miss = " ++ opt_int(str.last_index_of("hello", "z")))
  io.println("last_index_of ''   = " ++ opt_int(str.last_index_of("hello", "")))

  io.println("-- predicates --")
  io.println("contains           = " ++ to_string(str.contains(mixed, "é中")))
  io.println("starts_with        = " ++ to_string(str.starts_with(mixed, "aé")))
  io.println("ends_with          = " ++ to_string(str.ends_with(mixed, "𝄞")))
  io.println("ends_with false    = " ++ to_string(str.ends_with(mixed, "中")))

  io.println("-- trimming and case --")
  io.println("trim               = [" ++ str.trim("  \t hi \n ") ++ "]")
  io.println("trim nothing       = [" ++ str.trim("hi") ++ "]")
  io.println("trim all           = [" ++ str.trim("   ") ++ "]")
  io.println("lower              = " ++ str.to_lower("MiXeD 42"))
  io.println("upper              = " ++ str.to_upper("MiXeD 42"))

  io.println("-- classification --")
  io.println("is_letter a        = " ++ to_string(char_is_letter('a')))
  io.println("is_digit a         = " ++ to_string(char_is_digit('a')))
  io.println("is_space tab       = " ++ to_string(char_is_space('\t')))
  io.println("is_space ideo      = " ++ to_string(char_is_space('\u{3000}')))
  io.println("is_space nbsp      = " ++ to_string(char_is_space('\u{00A0}')))

  io.println("-- parsing --")
  io.println("parse_int          = " ++ opt_int(parse_int("42")))
  io.println("parse_int signed   = " ++ opt_int(parse_int("-42")))
  io.println("parse_int spaced   = " ++ opt_int(parse_int("  7 ")))
  io.println("parse_int min      = " ++ opt_int(parse_int("-9223372036854775808")))
  io.println("parse_int over     = " ++ opt_int(parse_int("9223372036854775808")))
  io.println("parse_int junk     = " ++ opt_int(parse_int("4x")))
  io.println("parse_int empty    = " ++ opt_int(parse_int("")))
  io.println("radix 16           = " ++ opt_int(parse_int_radix("ff", 16)))
  io.println("radix 2            = " ++ opt_int(parse_int_radix("1011", 2)))
  io.println("radix bad digit    = " ++ opt_int(parse_int_radix("12", 2)))

  io.println("-- code points --")
  io.println("code_points        = " ++ to_string(code_points("aé中")))
  io.println("round trip         = " ++ from_code_points(code_points(mixed)))
  io.println("from_code_points   = " ++ from_code_points(['h', 'i']))
  io.println("join               = " ++ join(["a", "b", "c"], "-"))
  io.println("join empty sep     = " ++ join(["a", "b"], ""))
  io.println("join one           = " ++ join(["only"], "-"))

  io.println("-- str.slice clamps (spec 4.8, criterion 3) --")
  # A range parameter selects, it does not assert: both ends clamp into
  # [0, len] and from > to is empty. This was a panic until audit RD-07.
  io.println("sub in range       = " ++ str.slice(mixed, 1, 3))
  io.println("sub to past end    = " ++ str.slice(mixed, 2, 99))
  io.println("sub from past end  = [" ++ str.slice(mixed, 9, 99) ++ "]")
  io.println("sub from > to      = [" ++ str.slice(mixed, 3, 1) ++ "]")
  io.println("sub negative from  = " ++ str.slice(mixed, -5, 2))
  io.println("sub negative both  = [" ++ str.slice(mixed, -5, -1) ++ "]")

  io.println("-- affixes (spec 4.8, criterion 2) --")
  # Test and peel in one call: a miss is None, not a panic and not a -1.
  io.println("strip_prefix       = " ++ opt_str(str.strip_prefix(mixed, "aé")))
  io.println("strip_prefix miss  = " ++ opt_str(str.strip_prefix(mixed, "é")))
  io.println("strip_prefix all   = " ++ opt_str(str.strip_prefix(mixed, mixed)))
  io.println("strip_prefix ''    = " ++ opt_str(str.strip_prefix("ab", "")))
  io.println("strip_suffix       = " ++ opt_str(str.strip_suffix("main.dawn", ".dawn")))
  io.println("strip_suffix miss  = " ++ opt_str(str.strip_suffix("main.dawn", ".c")))
  io.println("strip_suffix wide  = " ++ opt_str(str.strip_suffix(mixed, "中𝄞")))
  io.println("strip_suffix ''    = " ++ opt_str(str.strip_suffix("ab", "")))

  io.println("-- take/drop clamp, at asserts --")
  # take/drop are substring's two one-ended spellings, so they clamp (criterion
  # 3); `at` names a position the caller says exists, so it panics (criterion
  # 1) -- catch_kinds.dawn is where that panic is exercised.
  io.println("take               = [" ++ str.take(mixed, 2) ++ "]")
  io.println("take past end      = [" ++ str.take(mixed, 99) ++ "]")
  io.println("take negative      = [" ++ str.take(mixed, -1) ++ "]")
  io.println("drop               = [" ++ str.drop(mixed, 2) ++ "]")
  io.println("drop past end      = [" ++ str.drop(mixed, 99) ++ "]")
  io.println("drop negative      = [" ++ str.drop(mixed, -1) ++ "]")
  io.println("at 0               = " ++ to_string(char.code(str.at(mixed, 0))))
  io.println("at astral          = " ++ to_string(char.code(str.at(mixed, 3))))

  io.println("-- one-sided trims and pad_end --")
  io.println("trim_start         = [" ++ str.trim_start("  hi  ") ++ "]")
  io.println("trim_end           = [" ++ str.trim_end("  hi  ") ++ "]")
  io.println("trim_start all     = [" ++ str.trim_start("   ") ++ "]")
  io.println("trim_end all       = [" ++ str.trim_end("   ") ++ "]")
  io.println("pad_start          = [" ++ str.pad_start("7", 4, "0") ++ "]")
  io.println("pad_end            = [" ++ str.pad_end("7", 4, "0") ++ "]")
  io.println("pad_end cycles     = [" ++ str.pad_end("7", 6, "ab") ++ "]")
  io.println("pad_end wide       = [" ++ str.pad_end("x", 3, "中") ++ "]")
  io.println("pad_end no room    = [" ++ str.pad_end("hello", 3, "0") ++ "]")
  io.println("pad_end no filler  = [" ++ str.pad_end("hi", 9, "") ++ "]")

  io.println("-- the Int <-> Cursor bridge --")
  # cursor.seek clamps (criterion 3) and cursor.offset counts; the two are
  # inverses on every in-range index, which is the property that lets a
  # scanner holding an Int stop re-deriving its position per character.
  io.println("offset of at 2     = " ++ to_string(cursor.offset(mixed, cursor.seek(mixed, 2))))
  io.println("slice at 1..3      = [" ++
      cursor.slice(mixed, cursor.seek(mixed, 1), cursor.seek(mixed, 3)) ++ "]")
  io.println("at past end        = " ++ to_string(cursor.offset(mixed, cursor.seek(mixed, 99))))
  io.println("at negative        = " ++ to_string(cursor.offset(mixed, cursor.seek(mixed, -3))))
  io.println("offset of end      = " ++ to_string(cursor.offset(mixed, cursor.end(mixed))))
  io.println("offset of start    = " ++ to_string(cursor.offset(mixed, cursor.start(mixed))))
  io.println("offset empty       = " ++ to_string(cursor.offset("", cursor.end(""))))
  io.println("char at astral     = " ++ to_string(cursor.char(mixed, cursor.seek(mixed, 3))))

  io.println("-- bytes --")
  let b = bytes.utf8(mixed)
  io.println("bytes_len          = " ++ to_string(bytes.len(b)))
  io.println("bytes_at 0         = " ++ to_string(raw.byte_at(b, 0)))
  io.println("bytes_at oob       = " ++ to_string(raw.byte_at(b, 99)))
  # The two named decoders (audit RP-04): the charset is in the function name,
  # so there is no unknown-charset failure mode left to exercise -- the
  # charset-taking decoder that had one is gone.
  io.println("decode_utf8        = " ++ bytes.decode_utf8_lossy(b))
  io.println("decode_latin1 len  = " ++ to_string(str.len(bytes.decode_latin1(b))))

  io.println("-- the barrier --")
  # catch_fault catches an exception on the JVM and a panic natively; both make
  # this an Err, which is the part that has to agree.
  io.println("try missing file   = " ++ ok_or_err(catch_fault(() => raw.read_file("no-such-file"))))
  io.println("try ok             = " ++ ok_or_err(catch_fault(() => str.to_upper("fine"))))
}

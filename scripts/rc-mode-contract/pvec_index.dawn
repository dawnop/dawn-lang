# Indexed reads over a vector big enough to have a real trie (the tail alone
# holds 32), so an over-release frees interior nodes a later read descends
# into. Elements are Ints on purpose: the value under test is the vector
# itself.
pub fn main() -> Unit !io = {
  var xs: List[Int] = []
  var i = 0
  while i < 100 {
    xs = xs ++ [i * i]
    i = i + 1
  }
  var sum = 0
  var j = 0
  while j < 100 {
    sum = sum + xs[j]
    j = j + 1
  }
  println(to_string(sum))
}

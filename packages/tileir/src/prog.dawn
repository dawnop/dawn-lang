      t_load_ptrs(dtype, shape, ptrs, mask0, pad0) => {
        let (g0, mask) = widen_opt(name, frames, grown(next, ops, held, spreads, pending), mask0, "i1", shape)
        let (g, pad) = widen_opt(name, frames, g0, pad0, dtype, shape)
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        let open = frames

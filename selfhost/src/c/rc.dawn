# Perceus: deciding where a reference is taken and where it is released.
#
# docs/perceus-design.md 5. This is the pass that gives `CDup` and `CSDrop`
# their first values; before it, both nodes existed with zero construction
# sites. It runs on the way into the C backend and nowhere else -- the JVM has
# a collector, so counting there is pure overhead, and keeping the pass off
# that path is also what makes "knife 2 changes no JVM byte" true by
# construction rather than by inspection.
#
# Being C-only buys one more thing, and it is what makes the pass possible at
# all: it may introduce bindings. A block's drops have to run *after* its tail
# is evaluated, and Core has no slot there -- the value has to be named first.
# The same move is what keeps an owned temporary in a borrow position from
# leaking: `list_len(f(x))` hands a fresh list to a primitive that will not
# release it, so the list gets a name and a drop of its own.
#
# The base rule is docs/perceus-design.md 5.2, the conservative form: dup at
# every consuming use, drop every binding on every path out of its scope. On
# top of it sits last-use analysis (5.8): the *last* consuming use of a
# binding takes the value instead of copying it, and the scope-end drop
# disappears with it. What makes "last" decidable is the after-set threaded
# through the rewrite -- the bindings anything later still reads -- plus two
# refusals: a binding that lives across loop iterations is used once per trip
# round, so inside a loop "last" only means last *this* iteration; and the
# right side of && / || only sometimes runs, so nothing in it may transfer.
#
# `rc_check` at the bottom is this pass's local oracle. It walks the result
# and insists every binding is released exactly once on every path -- where a
# release is a drop or a transfer, so the walk mirrors the rewrite's
# classification of consuming positions. What it cannot see is whether the
# dups match the consuming uses; that needs the type of every receiver, and
# the corpus for it is the spike-native asan check.

use ir/core.{
  CModule, CFun, CParam, CExpr, CStmt, CCallee, CJava,
  CLocal, CFnRef, CCall, CIntrinsic, CCtor, CField, CIsCtor, CTagOf, CClosure,
  CDictRef, CDictApply, CDictArg, CTuple, CTupleGet, CBox, CUnbox, CBinary,
  CUnary, CIf, CBlock, CListLit, CConstRef, CComptime, CReturn, CBreak,
  CContinue, CForeign, CDup,
  CSLet, CSAssign, CSDiscard, CSLoop, CSIf, CSDrop,
  CDynamic, CDirect, CBinOp, CAnd, COr, CInt, CFloat, CBool, CStr, CUnit, COwned,
  cex_ty, diverges
}
use check/types.{Ty, TyInt, TyBool, TyList, TyTuple, TyUnit, TyNever, TyArray,
  is_ref_ty, intr_owned_args }
use std/list
use std/set

# ---- state ----

## One lexical scope and the bindings it owns. `loop_id` is the loop whose
## body this scope is, or -1: a `break` has to release every scope down to and
## including the one it is leaving, and that is how it recognises the floor.
##
## A loop scope normally refuses releases of bindings that live outside it,
## for two reasons at once: the back edge (next iteration reads them again)
## and the joins (every `break` path and the fall-through meet after the
## loop, and they must agree on what was released). `open` is true when both
## reasons provably vanish -- the body cannot complete normally, so the only
## back edges are its `continue`s, which the after-set pins one path at a
## time (`pin_of`); and it contains no `break` of its own id, so nothing
## rejoins carrying a one-sided release. Tail-call loops (body = return)
## qualify; source `while`/`for` loops do not, and the match once-loop is
## taken apart by `unloop` before the question comes up.
type Sc = { syms: List[Int], loop_id: Int, open: Bool }

type RSt = {
  # outermost first
  scopes: List[Sc],
  # dictionary parameters of the function being rewritten; see `immortal`
  dict_syms: Set[Int],
  next_sym: Int,
  # inside the right side of && / ||, where evaluation is conditional and
  # transfers are refused -- see `rw_scircuit`
  pinned: Bool
}

fn fresh(st: RSt) -> (RSt, Int) = (RSt { ..st, next_sym: st.next_sym + 1 }, st.next_sym)

fn no_syms() -> Set[Int] = set.empty()

fn push(st: RSt, loop_id: Int, open: Bool) -> RSt =
  RSt { ..st, scopes: st.scopes ++ [Sc { syms: [], loop_id: loop_id, open: open }] }

## Pop the innermost scope, handing back the bindings it still owns.
fn pop(st: RSt) -> (RSt, List[Int]) = {
  let n = len(st.scopes)
  let top = st.scopes[n - 1]
  (RSt { ..st, scopes: list.take(st.scopes, n - 1) }, top.syms)
}

fn bind(st: RSt, sym: Int) -> RSt = {
  let n = len(st.scopes)
  let top = st.scopes[n - 1]
  let top2 = Sc { ..top, syms: top.syms ++ [sym] }
  RSt { ..st, scopes: list.take(st.scopes, n - 1) ++ [top2] }
}

## Everything a non-local exit has to release, innermost scope first. `to_loop`
## is -1 for `return` (every scope in the function) and otherwise the loop the
## jump leaves, whose body scope is the floor.
fn unwind(st: RSt, to_loop: Int) -> List[Int] = {
  var out: List[Int] = []
  var i = len(st.scopes) - 1
  while i >= 0 {
    let sc = st.scopes[i]
    out = out ++ list.reverse(sc.syms)
    if to_loop >= 0 && sc.loop_id == to_loop { return out }
    i = i - 1
  }
  out
}

fn drops(syms: List[Int]) -> List[CStmt] = list.map(syms, (s: Int) => CSDrop(s))

## Every binding the scopes still own, for comparing what an if's two arms
## did to them.
fn scope_syms(st: RSt) -> List[Int] = {
  var out: List[Int] = []
  for sc in st.scopes { out = out ++ sc.syms }
  out
}

fn diff(a: List[Int], b: List[Int]) -> List[Int] =
  list.filter(a, (x: Int) => not list.contains(b, x))

fn strip_syms(st: RSt, syms: List[Int]) -> RSt = {
  if len(syms) == 0 { return st }
  var out: List[Sc] = []
  for sc in st.scopes {
    out = out ++ [Sc { ..sc, syms: list.filter(sc.syms, (y: Int) => not list.contains(syms, y)) }]
  }
  RSt { ..st, scopes: out }
}

## Whether a release of `sym` here may be trusted -- a transfer at its last
## use, or a sweep once nothing later touches it. The binding has to be found
## before any closed loop boundary on the way out: a binding that lives
## across iterations is used once per trip round, and "last use" inside the
## body only means last use *this* iteration. An `open` loop scope (see `Sc`)
## is crossed instead, unless a `continue` of that loop is still ahead on
## this path -- the pin in the after-set -- in which case this path *is* a
## next iteration's prefix and the refusal is back.
fn transferable(st: RSt, sym: Int, after: Set[Int]) -> Bool = {
  var i = len(st.scopes) - 1
  while i >= 0 {
    let sc = st.scopes[i]
    if list.contains(sc.syms, sym) { return true }
    if sc.loop_id >= 0 {
      if not sc.open { return false }
      if set.has(after, pin_of(sc.loop_id)) { return false }
    }
    i = i - 1
  }
  false
}

fn release(st: RSt, sym: Int) -> RSt = strip_syms(st, [sym])

## Which scope holds `sym`, outermost first; -1 when none does.
fn scope_index_of(st: RSt, sym: Int) -> Int = {
  var i = len(st.scopes) - 1
  while i >= 0 {
    if list.contains(st.scopes[i].syms, sym) { return i }
    i = i - 1
  }
  -1
}

## Put `sym` back into the scope at index `at` -- the reassignment path,
## where a binding briefly left its scope and returns holding a new value.
fn bind_at(st: RSt, at: Int, sym: Int) -> RSt = {
  let sc = st.scopes[at]
  let sc2 = Sc { ..sc, syms: sc.syms ++ [sym] }
  RSt { ..st, scopes: list.take(st.scopes, at) ++ [sc2] ++ list.drop(st.scopes, at + 1) }
}

## The pin of a loop: a pseudo-binding meaning "a `continue` of this loop is
## still ahead on this path". Symbols and loop ids are both non-negative, so
## the negative range is free to carry them inside the same after-sets.
fn pin_of(lid: Int) -> Int = 0 - (lid + 1)

## Only the pins of an after-set: what a loop body's base set inherits, since
## a `continue` of an enclosing loop after this one still closes it.
fn pins_only(after: Set[Int]) -> Set[Int] = {
  var out: Set[Int] = set.empty()
  for x in set.to_list(after) {
    if x < 0 { out = set.insert(out, x) }
  }
  out
}

# ---- liveness ----
#
# The after-set is the bindings anything later still touches, and "touches"
# deliberately includes two non-reads: the target of an assignment, because
# the assignment's expansion releases the old value and an earlier transfer
# would make that the second release; and the symbol of a drop, for the same
# reason. Everything here is an over-approximation in one direction only --
# a symbol wrongly present costs a dup, a symbol wrongly absent costs a
# use-after-free.

fn fv_expr(e: CExpr, acc: Set[Int]) -> Set[Int] =
  match e {
    CLocal(sym, _) -> set.insert(acc, sym)
    CCall(callee, args, _) -> {
      let a1 = match callee {
        CDynamic(t) -> fv_expr(t, acc)
        _ -> acc
      }
      fv_list(args, a1)
    }
    CIntrinsic(_, args, _) -> fv_list(args, acc)
    CCtor(_, _, args, _) -> fv_list(args, acc)
    CField(t, _, _, _, _) -> fv_expr(t, acc)
    CIsCtor(t, _, _) -> fv_expr(t, acc)
    CTagOf(t, _) -> fv_expr(t, acc)
    CClosure(_, _, caps, _) -> fv_list(caps, acc)
    CDictApply(_, args, _) -> fv_list(args, acc)
    CDictArg(d, _, _, _, _) -> fv_expr(d, acc)
    CTuple(elems, _) -> fv_list(elems, acc)
    CTupleGet(t, _, _) -> fv_expr(t, acc)
    CBox(inner, _) -> fv_expr(inner, acc)
    CUnbox(inner, _) -> fv_expr(inner, acc)
    CBinary(_, l, r, _) -> fv_expr(r, fv_expr(l, acc))
    CUnary(_, x, _) -> fv_expr(x, acc)
    CIf(cond, thn, els, _) -> {
      let a1 = fv_expr(thn, fv_expr(cond, acc))
      match els {
        None -> a1
        Some(x) -> fv_expr(x, a1)
      }
    }
    CBlock(stmts, tail, _) -> {
      let a1 = fv_stmts(stmts, acc)
      match tail {
        None -> a1
        Some(t) -> fv_expr(t, a1)
      }
    }
    CListLit(elems, _) -> fv_list(elems, acc)
    CReturn(v) ->
      match v {
        None -> acc
        Some(x) -> fv_expr(x, acc)
      },
    CDup(inner, _) -> fv_expr(inner, acc)
    # a continue is a read of every binding its next iteration touches; the
    # pin stands in for all of them at once
    CContinue(lid) -> set.insert(acc, pin_of(lid))
    # inert on the path this pass runs for, but a symbol read only in here
    # must still count as read -- see the header of this section
    CForeign(j, _) -> {
      let a1 = match j.target {
        None -> acc
        Some(t) -> fv_expr(t, acc)
      }
      fv_list(j.args, a1)
    }
    # The leaves, enumerated rather than swept up by a wildcard: a symbol
    # wrongly absent costs a use-after-free, so a Core node added later has
    # to come back here as a compile error and not as `acc`.
    CInt(_) -> acc
    CFloat(_) -> acc
    CBool(_) -> acc
    CStr(_) -> acc
    CUnit -> acc
    # names a top-level function, a statically built dictionary, a folded
    # constant or a comptime block -- none of them a binding of this body
    CFnRef(_, _, _) -> acc
    CDictRef(_, _, _, _) -> acc
    CConstRef(_, _, _) -> acc
    CComptime(_, _, _) -> acc
    # a break leaves the loop for good, so nothing its next iteration would
    # have touched is still ahead of this path: it pins nothing, which is the
    # one place it differs from CContinue
    CBreak(_) -> acc
  }

fn fv_list(es: List[CExpr], acc: Set[Int]) -> Set[Int] = {
  var a = acc
  for e in es { a = fv_expr(e, a) }
  a
}

fn fv_stmt(s: CStmt, acc: Set[Int]) -> Set[Int] =
  match s {
    CSLet(_, _, init) -> fv_expr(init, acc)
    CSAssign(sym, v) -> set.insert(fv_expr(v, acc), sym)
    CSDiscard(x) -> fv_expr(x, acc)
    CSLoop(_, body, step) -> {
      let a1 = fv_expr(body, acc)
      match step {
        None -> a1
        Some(x) -> fv_expr(x, a1)
      }
    }
    CSIf(cond, thn, els) -> {
      let a1 = fv_expr(thn, fv_expr(cond, acc))
      match els {
        None -> a1
        Some(x) -> fv_expr(x, a1)
      }
    }
    CSDrop(sym) -> set.insert(acc, sym)
  }

fn fv_stmts(stmts: List[CStmt], acc: Set[Int]) -> Set[Int] = {
  var a = acc
  for s in stmts { a = fv_stmt(s, a) }
  a
}

# ---- loop shape ----

## Whether evaluation can run off the end of `e` with control intact. This
## digs one level deeper than `core.diverges`, which reads only tails: a
## block whose *statement* binds or discards a Never value is over at that
## statement, whatever its tail says. The depth is not optional -- the
## checker's `gone` walks statements, and `reconcile` decides by this
## judgement which arms still run; disagree and reconcile seals compensating
## drops onto a path that is very much alive (found the hard way: `unloop`
## flattens an arm's `break` tail away, leaving exactly the
## statements-diverge-tail-None shape).
fn completes(e: CExpr) -> Bool =
  match e {
    CBlock(stmts, tail, _) -> {
      for s in stmts {
        let ends = match s {
          CSDiscard(x) -> not completes(x)
          CSLet(_, _, v) -> not completes(v)
          CSAssign(_, v) -> not completes(v)
          _ -> false
        }
        if ends { return false }
      }
      match tail {
        None -> true
        Some(t) -> completes(t)
      }
    }
    CIf(_, thn, els, _) ->
      match els {
        None -> true
        Some(x) -> completes(thn) || completes(x)
      },
    _ -> not diverges(e) && cex_ty(e) != TyNever
  }

## Whether a jump to `lid` occurs anywhere inside -- `brk` and `cont` select
## which kinds count. `open` needs the breaks (a break of this loop rejoins
## code after it); `unloop` refuses on either kind left inside an arm.
fn jumps(e: CExpr, lid: Int, brk: Bool, cont: Bool) -> Bool =
  match e {
    CBreak(l) -> brk && l == lid
    CContinue(l) -> cont && l == lid
    CCall(callee, args, _) -> {
      let hit = match callee {
        CDynamic(t) -> jumps(t, lid, brk, cont)
        _ -> false
      }
      hit || jumps_list(args, lid, brk, cont)
    }
    CIntrinsic(_, args, _) -> jumps_list(args, lid, brk, cont)
    CCtor(_, _, args, _) -> jumps_list(args, lid, brk, cont)
    CField(t, _, _, _, _) -> jumps(t, lid, brk, cont)
    CIsCtor(t, _, _) -> jumps(t, lid, brk, cont)
    CTagOf(t, _) -> jumps(t, lid, brk, cont)
    CClosure(_, _, caps, _) -> jumps_list(caps, lid, brk, cont)
    CDictApply(_, args, _) -> jumps_list(args, lid, brk, cont)
    CDictArg(d, _, _, _, _) -> jumps(d, lid, brk, cont)
    CTuple(es, _) -> jumps_list(es, lid, brk, cont)
    CTupleGet(t, _, _) -> jumps(t, lid, brk, cont)
    CBox(x, _) -> jumps(x, lid, brk, cont)
    CUnbox(x, _) -> jumps(x, lid, brk, cont)
    CBinary(_, l, r, _) -> jumps(l, lid, brk, cont) || jumps(r, lid, brk, cont)
    CUnary(_, x, _) -> jumps(x, lid, brk, cont)
    CIf(c, t, e2, _) -> {
      let hit = jumps(c, lid, brk, cont) || jumps(t, lid, brk, cont)
      match e2 {
        None -> hit
        Some(x) -> hit || jumps(x, lid, brk, cont)
      }
    }
    CBlock(stmts, tail, _) -> {
      let hit = jumps_stmts(stmts, lid, brk, cont)
      match tail {
        None -> hit
        Some(t) -> hit || jumps(t, lid, brk, cont)
      }
    }
    CListLit(es, _) -> jumps_list(es, lid, brk, cont)
    CReturn(v) ->
      match v {
        None -> false
        Some(x) -> jumps(x, lid, brk, cont)
      },
    CDup(x, _) -> jumps(x, lid, brk, cont)
    # The rest, enumerated for fv_expr's reason: a node added later must come
    # back here as a compile error. A jump wrongly reported absent is an
    # `unloop` that flattens an arm still holding a break.
    CInt(_) -> false
    CFloat(_) -> false
    CBool(_) -> false
    CStr(_) -> false
    CUnit -> false
    CLocal(_, _) -> false
    CFnRef(_, _, _) -> false
    CDictRef(_, _, _, _) -> false
    CConstRef(_, _, _) -> false
    CComptime(_, _, _) -> false
    # not walked into, and the omission is deliberate rather than inherited
    # from the wildcard: a `use java` argument can hold a jump, but this pass
    # runs for the native backend, which refuses CForeign outright (emitc's
    # CForeign arm). Walking it would be dead code with no way to test it.
    CForeign(_, _) -> false
  }

fn jumps_list(es: List[CExpr], lid: Int, brk: Bool, cont: Bool) -> Bool = {
  for e in es {
    if jumps(e, lid, brk, cont) { return true }
  }
  false
}

fn jumps_stmt(s: CStmt, lid: Int, brk: Bool, cont: Bool) -> Bool =
  match s {
    CSLet(_, _, v) -> jumps(v, lid, brk, cont)
    CSAssign(_, v) -> jumps(v, lid, brk, cont)
    CSDiscard(x) -> jumps(x, lid, brk, cont)
    CSLoop(_, body, step) -> {
      let hit = jumps(body, lid, brk, cont)
      match step {
        None -> hit
        Some(x) -> hit || jumps(x, lid, brk, cont)
      }
    }
    CSIf(c, t, e2) -> {
      let hit = jumps(c, lid, brk, cont) || jumps(t, lid, brk, cont)
      match e2 {
        None -> hit
        Some(x) -> hit || jumps(x, lid, brk, cont)
      }
    }
    CSDrop(_) -> false
  }

fn jumps_stmts(stmts: List[CStmt], lid: Int, brk: Bool, cont: Bool) -> Bool = {
  for s in stmts {
    if jumps_stmt(s, lid, brk, cont) { return true }
  }
  false
}

## The arm's statements with its final `break lid` peeled off: lower_match
## ends every taken arm with one, sometimes behind a nest of blocks. Merging
## the nest into one statement list is fine -- symbols are globally unique,
## so the flattened scope releases the same bindings at the same end.
fn strip_break(e: CExpr, lid: Int) -> Option[List[CStmt]] =
  match e {
    CBreak(l) -> if l == lid { Some([]) } else { None }
    CBlock(stmts, Some(t), _) ->
      match strip_break(t, lid) {
        Some(rest) -> Some(stmts ++ rest)
        None -> None
      },
    _ -> None
  }

## lower_match encodes `match` as a once-loop: each arm a guarded test that
## assigns the result and breaks, an unreachable panic at the bottom, a loop
## head no path re-enters. The JVM emitter reads that shape as cheap labels;
## for this pass it is poison -- the loop guard cannot see that the loop
## never loops, so every binding outside the match is pinned for the whole of
## it, and the matched value itself survives to scope end. That is exactly
## the reference that keeps `array_with` from ever finding its array unique
## (docs/perceus-design.md 6). So the C path takes the costume off: a loop of
## `if (test) { arm; break }` statements over an unreachable tail is the
## branch tree the match was, and as a branch tree its arms reconcile like
## any other -- released early where dead, sealed where arms disagree.
## Anything that does not match the shape exactly (a guarded arm falls
## through its own test, so its break is conditional) keeps the loop and the
## conservative account.
fn unloop(lid: Int, body: CExpr) -> Option[CStmt] = {
  match body {
    CBlock(stmts, None, _) -> {
      let n = len(stmts)
      if n < 2 { return None }
      let ok_last = match stmts[n - 1] {
        CSDiscard(x) -> not yields(x) && not jumps(x, lid, true, true)
        _ -> false
      }
      if not ok_last { return None }
      var conds: List[CExpr] = []
      var armbs: List[CExpr] = []
      var i = 0
      while i < n - 1 {
        match stmts[i] {
          CSIf(cond, thn, None) ->
            match strip_break(thn, lid) {
              Some(astmts) -> {
                if jumps(cond, lid, true, true) || jumps_stmts(astmts, lid, true, true) {
                  return None
                }
                conds = conds ++ [cond]
                armbs = armbs ++ [CBlock(astmts, None, TyUnit)]
              }
              None -> return None
            },
          _ -> return None
        }
        i = i + 1
      }
      var els = CBlock([stmts[n - 1]], None, TyUnit)
      var k = len(conds) - 1
      while k > 0 {
        els = CBlock([CSIf(conds[k], armbs[k], Some(els))], None, TyUnit)
        k = k - 1
      }
      Some(CSIf(conds[0], armbs[0], Some(els)))
    }
    _ -> None
  }
}

# ---- classification ----

## A dictionary: outside the ledger entirely. It has no header at all -- a
## drop on one would read garbage as a count -- so no binding of one is ever
## tracked and no release is ever emitted (docs/perceus-design.md 3).
fn dictish(st: RSt, e: CExpr) -> Bool =
  match e {
    CLocal(s, _) -> set.has(st.dict_syms, s)
    CDictRef(_, _, _, _) -> true
    CDictApply(_, _, _) -> true
    CDictArg(_, _, _, _, _) -> true
    _ -> false
  }

## An immortal-headed literal: a static the emitter writes, with a real
## header whose count is DAWN_IMMORTAL. Free to dup or drop (both return
## immediately), so a *binding* that holds one is an ordinary ledger entry;
## only as an operand is it exempt from counting, because hoisting one into
## a temporary would be pure noise.
##
## A folded constant is immortal at *every* type, not only String. A scalar
## one is not counted anyway (`counted` asks `is_ref_ty` first); a structured
## one is built once by a generated builder and handed to `dawn_immortal`,
## which takes the whole graph out of the ledger (emitc's `const_builder`).
## These two have to agree: if this said "counted" the pass would emit dup and
## drop on an immortal header, which is merely wasted instructions -- but if
## the emitter stopped marking while this still said "immortal", the first
## consuming use would free a constant the static pointer still names.
fn lit_immortal(e: CExpr) -> Bool =
  match e {
    CStr(_) -> true
    CConstRef(_, _, _) -> true
    CComptime(_, _, _) -> true
    _ -> false
  }

## Values never counted as operands: dictionaries and immortal literals.
fn immortal(st: RSt, e: CExpr) -> Bool = dictish(st, e) || lit_immortal(e)

## Does this expression hand back a reference someone else owns?
##
## The root has to be a local. `p.x` borrows from `p`, which the enclosing
## scope keeps alive; `g(y).x` borrows from a temporary that nothing keeps, so
## the projection is only safe once the temporary has a name and a lifetime --
## which is what `borrow` arranges by routing it through the owning path
## instead.
fn borrows(st: RSt, e: CExpr) -> Bool =
  match e {
    CLocal(_, _) -> not immortal(st, e)
    CField(t, _, _, _, _) -> borrows(st, t)
    CTupleGet(t, _, _) -> borrows(st, t)
    CBox(inner, from) -> is_ref_ty(from) && borrows(st, inner)
    CUnbox(inner, to) -> is_ref_ty(to) && borrows(st, inner)
    _ -> false
  }

## Whether a value of this expression's type participates in counting at all.
fn counted(st: RSt, e: CExpr) -> Bool = is_ref_ty(cex_ty(e)) && not immortal(st, e)

# ---- assembling ----

## `e`, with `lets` run before it and `temps` released after its value exists.
##
## The value has to be named to release anything after it: Core's block puts
## its tail last by construction, so "after the tail" is a slot that only
## exists once the tail is a binding. A block already open is extended rather
## than nested, which keeps the emitted C readable.
fn wrap(st: RSt, lets: List[CStmt], e: CExpr, ty: Ty, temps: List[Int]) -> (RSt, CExpr) = {
  if len(lets) == 0 && len(temps) == 0 { return (st, e) }
  let tail_drops = drops(list.reverse(temps))
  # Nothing that never delivers a value gets named. A jump released its own
  # scopes on the way out and a panic ends the process, so the drops here are
  # dead code either way -- and naming the value would cost more than the dead
  # statements: `yields` is what the C emitter reads (as `no_value`) to decide
  # whether a branch has anything to assign, and a block that answered "yes"
  # while emitting a `goto` produced `dawn_str t = DAWN_UNIT;`.
  if not yields(e) {
    if len(lets) == 0 { return (st, e) }
    return (st, CBlock(lets, Some(e), ty))
  }
  if ty == TyUnit || ty == TyNever {
    return (st, CBlock(lets ++ [CSDiscard(e)] ++ tail_drops, None, ty))
  }
  match e {
    # The tail is already a name, so the drops can simply follow it. Binding it
    # again would produce `let t2 = t1`, which nothing downstream can tell from
    # a binding that took a value over -- and a wrap around a wrap (a function
    # body sealing a block that already sealed itself) hits this every time.
    CBlock(stmts, Some(CLocal(sym, lty)), bty) ->
      if not list.contains(temps, sym) {
        (st, CBlock(lets ++ stmts ++ tail_drops, Some(CLocal(sym, lty)), bty))
      } else {
        let (st1, t) = fresh(st)
        (st1, CBlock(
          lets ++ stmts ++ [CSLet(t, bty, CLocal(sym, lty))] ++ tail_drops,
          Some(CLocal(t, bty)),
          bty
        ))
      },
    CBlock(stmts, Some(tail), bty) ->
      if not yields(tail) {
        # the block's own tail is a jump or a panic, so the scope is never
        # left the ordinary way and these drops would be unreachable
        (st, CBlock(lets ++ stmts, Some(tail), bty))
      } else {
        let (st1, t) = fresh(st)
        (st1, CBlock(
          lets ++ stmts ++ [CSLet(t, bty, tail)] ++ tail_drops,
          Some(CLocal(t, bty)),
          bty
        ))
      },
    _ -> {
      let (st1, t) = fresh(st)
      (st1, CBlock(lets ++ [CSLet(t, ty, e)] ++ tail_drops, Some(CLocal(t, ty)), ty))
    }
  }
}

## Whether this expression delivers a value that can be given a name. A jump
## does not, and neither does a `panic`: its type is `Never`. Statement-level
## divergence counts too -- see `completes` for why the depth matters.
fn yields(e: CExpr) -> Bool = completes(e)

## Release `syms` after `e` has produced its value.
fn seal(st: RSt, e: CExpr, ty: Ty, syms: List[Int]) -> (RSt, CExpr) = wrap(st, [], e, ty, syms)

# ---- the rewrite ----

## Rewrite `e` in a borrow position: the enclosing operation reads the value
## and does not keep it.
##
## A projection rooted in a local is already borrowed and needs nothing. Any
## other reference-typed expression produces a value nobody else holds, so it
## is named and released once the enclosing operation is done with it --
## without that, every `list_len(f(x))` would leak the list, because the
## runtime primitives borrow (docs/perceus-design.md 5.1).
fn borrow(st: RSt, e: CExpr, after: Set[Int]) -> (RSt, List[CStmt], CExpr, List[Int]) = {
  if borrows(st, e) || not counted(st, e) {
    let (st1, e1) = rw(st, e, false, after)
    (st1, [], e1, [])
  } else {
    let ty = cex_ty(e)
    let (st1, e1) = rw(st, e, true, after)
    let (st2, t) = fresh(st1)
    (st2, [CSLet(t, ty, e1)], CLocal(t, ty), [t])
  }
}

## The same, for a whole operand list.
##
## Hoisting one operand moves it ahead of the operands written before it, so
## once any of them needs a name they all get one: evaluation order is
## observable and reordering it is not this pass's business. A hoisted operand
## goes through the consuming rewrite -- which transfers when this is the
## binding's last use, and dups otherwise -- so the temporary is owned either
## way and the balance stays provable.
##
## Each operand's after-set includes every *other* operand: a borrowed operand
## is a pointer someone else owns, and the operation reads it only after all
## of them have run, so nothing evaluated for a later operand may take an
## earlier one's backing binding away.
fn borrow_all(st: RSt, es: List[CExpr], after: Set[Int]) -> (RSt, List[CStmt], List[CExpr], List[Int]) =
  intr_args(st, es, [], after)

## The general operand-list rewrite: borrowed positions as `borrow_all` says,
## and the positions in `owned` handed over -- the reuse-analysis exceptions
## (docs/perceus-design.md 6), where the callee consumes the argument so that
## `rc == 1` inside it means the caller gave its reference up. An owned
## operand hoisted for order's sake is passed on bare and not released here;
## the callee does that.
fn intr_args(st: RSt, es: List[CExpr], owned: List[Int], after: Set[Int]) -> (RSt, List[CStmt], List[CExpr], List[Int]) = {
  var any = false
  var h = 0
  for e in es {
    if not list.contains(owned, h) && counted(st, e) && not borrows(st, e) { any = true }
    h = h + 1
  }
  let n = len(es)
  var st2 = st
  var lets: List[CStmt] = []
  var outs: List[CExpr] = []
  var temps: List[Int] = []
  var i = 0
  for e in es {
    var a = after
    var j = 0
    while j < n {
      if j != i { a = fv_expr(es[j], a) }
      j = j + 1
    }
    let own = list.contains(owned, i)
    if not any {
      let (s2, e1) = rw(st2, e, own, a)
      st2 = s2
      outs = outs ++ [e1]
    } else {
      let ty = cex_ty(e)
      let (s2, e1) = rw(st2, e, true, a)
      let (s3, t) = fresh(s2)
      st2 = s3
      lets = lets ++ [CSLet(t, ty, e1)]
      outs = outs ++ [CLocal(t, ty)]
      # a hoisted literal's temporary is a binding like any other (its drop
      # is free); only what was never counted at all stays out
      if (counted(s3, e) || lit_immortal(e)) && not own { temps = temps ++ [t] }
    }
    i = i + 1
  }
  (st2, lets, outs, temps)
}

## Rewrite each operand in a consuming position: the value is handed over and
## the receiver keeps it.
##
## An operand's after-set covers every *other* operand, earlier ones
## included, not just what is written after it. Core is evaluated left to
## right, but the C emitter spells an operand list as C argument expressions,
## and C leaves their order unspecified -- gcc runs them right to left. Two
## dups commute, so knife 2's output never noticed; a transfer does not:
## `show_go(dup(x), iter_start(x))` is correct left to right and a
## use-after-free right to left. Keeping every operand's transfers away from
## every other operand's reads makes the list order-independent again, at the
## cost of a dup/drop pair only when one call mentions the same binding
## twice.
fn consume_all(st: RSt, es: List[CExpr], after: Set[Int]) -> (RSt, List[CExpr]) = {
  let n = len(es)
  var st1 = st
  var out: List[CExpr] = []
  var i = 0
  for e in es {
    var a = after
    var j = 0
    while j < n {
      if j != i { a = fv_expr(es[j], a) }
      j = j + 1
    }
    let (s2, e1) = rw(st1, e, true, a)
    st1 = s2
    out = out ++ [e1]
    i = i + 1
  }
  (st1, out)
}

## Rewrite an if's two arms, started from the same scope state, back into
## agreement: a binding one arm transferred away is dropped by the other, so
## every path out of the if has released the same things. An arm that never
## delivers a value released its own path at its jump and stays untouched.
## `entry` is the state the arms started from; `st_els` carries the threading
## (next_sym) forward.
fn reconcile(entry: RSt, st_thn: RSt, st_els: RSt, t1: CExpr, e1: CExpr, ty: Ty) -> (RSt, CExpr, CExpr) = {
  if not yields(t1) && not yields(e1) {
    return (RSt { ..st_els, scopes: entry.scopes }, t1, e1)
  }
  if not yields(t1) { return (st_els, t1, e1) }
  if not yields(e1) { return (RSt { ..st_els, scopes: st_thn.scopes }, t1, e1) }
  let thn_gone = diff(scope_syms(entry), scope_syms(st_thn))
  let els_gone = diff(scope_syms(entry), scope_syms(st_els))
  let need_t = diff(els_gone, thn_gone)
  let need_e = diff(thn_gone, els_gone)
  let (st4, t2) = if len(need_t) == 0 { (st_els, t1) } else { seal(st_els, t1, ty, need_t) }
  let (st5, e2) = if len(need_e) == 0 { (st4, e1) } else { seal(st4, e1, ty, need_e) }
  let st6 = strip_syms(RSt { ..st5, scopes: entry.scopes }, thn_gone ++ els_gone)
  (st6, t2, e2)
}

## The right side of && / || only sometimes runs. A transfer that happens on
## one evaluation and not another cannot be balanced by any placement of
## drops, so while the right side is rewritten the pass refuses to transfer
## at all. Both sides are Bool, so nothing is hoisted and order is untouched;
## dups nested inside the right side pair with consumes nested beside them --
## conditional, but conditional together.
fn rw_scircuit(st: RSt, op: CBinOp, l: CExpr, r: CExpr, bty: Ty, after: Set[Int]) -> (RSt, CExpr) = {
  let (st1, l1) = rw(st, l, false, fv_expr(r, after))
  let was = st1.pinned
  let (st2, r1) = rw(RSt { ..st1, pinned: true }, r, false, after)
  (RSt { ..st2, pinned: was }, CBinary(op, l1, r1, bty))
}

## `consume` says whether the value is handed over; `after` is the bindings
## anything later still touches. Both only ever decide something at a
## borrow-producing node of counted type: everything else either produces its
## own reference already or is not counted at all.
fn rw(st: RSt, e: CExpr, consume: Bool, after: Set[Int]) -> (RSt, CExpr) = {
  let ty = cex_ty(e)
  match e {
    CLocal(sym, _) ->
      if consume && counted(st, e) {
        # the last consuming use takes the value; every earlier one copies
        if not st.pinned && not set.has(after, sym) && transferable(st, sym, after) {
          (release(st, sym), e)
        } else {
          (st, CDup(e, ty))
        }
      } else {
        (st, e)
      },

    CField(target, adt, ci, idx, fty) -> {
      let (st1, lets, t1, temps) = borrow(st, target, after)
      let node = CField(t1, adt, ci, idx, fty)
      let node2 = if consume && is_ref_ty(fty) { CDup(node, fty) } else { node }
      wrap(st1, lets, node2, fty, temps)
    }

    CTupleGet(target, idx, ety) -> {
      let (st1, lets, t1, temps) = borrow(st, target, after)
      let node = CTupleGet(t1, idx, ety)
      let node2 = if consume && is_ref_ty(ety) { CDup(node, ety) } else { node }
      wrap(st1, lets, node2, ety, temps)
    }

    CIsCtor(target, adt, ci) -> {
      let (st1, lets, t1, temps) = borrow(st, target, after)
      wrap(st1, lets, CIsCtor(t1, adt, ci), cex_ty(e), temps)
    }

    CTagOf(target, adt) -> {
      let (st1, lets, t1, temps) = borrow(st, target, after)
      wrap(st1, lets, CTagOf(t1, adt), cex_ty(e), temps)
    }

    # A boxed reference is the reference; a boxed scalar is a fresh allocation
    # that owns itself. Either way the wrapper is transparent to counting.
    CBox(inner, from) ->
      if is_ref_ty(from) {
        let (st1, i1) = rw(st, inner, consume, after)
        (st1, CBox(i1, from))
      } else {
        let (st1, lets, i1, temps) = borrow(st, inner, after)
        wrap(st1, lets, CBox(i1, from), ty, temps)
      },

    CUnbox(inner, to) ->
      if is_ref_ty(to) {
        let (st1, i1) = rw(st, inner, consume, after)
        (st1, CUnbox(i1, to))
      } else {
        let (st1, lets, i1, temps) = borrow(st, inner, after)
        wrap(st1, lets, CUnbox(i1, to), to, temps)
      },

    # Dawn functions take their arguments owned (docs/perceus-design.md 5.1);
    # the dictionaries a call forwards are not counted and pass through. A
    # callee that is a value is read at the moment of the call, after every
    # argument has run: each side's after-set covers the other.
    CCall(callee, args, cty) -> {
      let (st1, lets, c1, temps) = rw_callee(st, callee, fv_list(args, after))
      let cbase = match callee {
        CDynamic(t) -> fv_expr(t, after)
        _ -> after
      }
      let (st2, args1) = consume_all(st1, args, cbase)
      wrap(st2, lets, CCall(c1, args1, cty), cty, temps)
    }

    # Runtime primitives borrow, and dup whatever they decide to keep --
    # except the argument positions the reuse analysis flipped to owned.
    CIntrinsic(name, args, ity) -> {
      let (st1, lets, args1, temps) = intr_args(st, args, intr_owned_args(name), after)
      wrap(st1, lets, CIntrinsic(name, args1, ity), ity, temps)
    }

    CCtor(adt, ci, args, cty) -> {
      let (st1, args1) = consume_all(st, args, after)
      (st1, CCtor(adt, ci, args1, cty))
    }

    CTuple(elems, tty) -> {
      let (st1, es1) = consume_all(st, elems, after)
      (st1, CTuple(es1, tty))
    }

    CListLit(elems, lty) -> {
      let (st1, es1) = consume_all(st, elems, after)
      (st1, CListLit(es1, lty))
    }

    CClosure(fn_name, owner, caps, cty) -> {
      let (st1, caps1) = consume_all(st, caps, after)
      (st1, CClosure(fn_name, owner, caps1, cty))
    }

    CBinary(op, l, r, bty) ->
      match op {
        CAnd -> rw_scircuit(st, op, l, r, bty, after)
        COr -> rw_scircuit(st, op, l, r, bty, after)
        _ -> {
          let (st1, lets, ops, temps) = borrow_all(st, [l, r], after)
          wrap(st1, lets, CBinary(op, ops[0], ops[1], bty), bty, temps)
        }
      },

    CUnary(op, x, uty) -> {
      let (st1, lets, ops, temps) = borrow_all(st, [x], after)
      wrap(st1, lets, CUnary(op, ops[0], uty), uty, temps)
    }

    CIf(cond, thn, els, ity) -> {
      let cond_after = {
        let a1 = fv_expr(thn, after)
        match els {
          None -> a1
          Some(x) -> fv_expr(x, a1)
        }
      }
      let (st1, lets, c1, temps) = borrow(st, cond, cond_after)
      let (st2, t1) = rw(st1, thn, consume, after)
      match els {
        None -> {
          # one-armed ifs are Unit; a transfer on the taken path would leave
          # the untaken path holding more, so the arm's removals materialise
          # an else that releases the same bindings
          if not yields(t1) {
            let (st4, cond2) = wrap(RSt { ..st2, scopes: st1.scopes }, lets, c1, cex_ty(cond), temps)
            return (st4, CIf(cond2, t1, None, ity))
          }
          let escaped = diff(scope_syms(st1), scope_syms(st2))
          let (st4, cond2) = wrap(st2, lets, c1, cex_ty(cond), temps)
          if len(escaped) == 0 {
            (st4, CIf(cond2, t1, None, ity))
          } else {
            (st4, CIf(cond2, t1, Some(CBlock(drops(escaped), None, TyUnit)), ity))
          }
        }
        Some(x) -> {
          let (st3, e1) = rw(RSt { ..st2, scopes: st1.scopes }, x, consume, after)
          let (st4, t2, e2) = reconcile(st1, st2, st3, t1, e1, ity)
          # the condition's temporary dies before the arms run, not after
          let (st5, cond2) = wrap(st4, lets, c1, cex_ty(cond), temps)
          (st5, CIf(cond2, t2, Some(e2), ity))
        }
      }
    }

    CBlock(stmts, tail, bty) -> {
      let st1 = push(st, -1, true)
      let base = match tail {
        None -> after
        Some(t) -> fv_expr(t, after)
      }
      let (st2, stmts1) = rw_stmts(st1, stmts, base)
      let (st3, tail1) = match tail {
        None -> (st2, None)
        Some(t) -> {
          let (s, t1) = rw(st2, t, consume, after)
          (s, Some(t1))
        }
      }
      let (st4, owned) = pop(st3)
      seal(st4, CBlock(stmts1, tail1, bty), bty, list.reverse(owned))
    }

    CReturn(v) -> {
      # nothing runs after a return, so the value's after-set is empty and
      # `return x` is a bare hand-over whenever x is this function's to give
      let (st1, v1) = match v {
        None -> (st, None)
        Some(x) -> {
          let (s, x1) = rw(st, x, true, no_syms())
          (s, Some(x1))
        }
      }
      let out = unwind(st1, -1)
      if len(out) == 0 { return (st1, CReturn(v1)) }
      # `return panic(...)` never returns, so neither the name nor the drops
      # after it are reachable
      match v1 {
        Some(x1) ->
          if not yields(x1) { return (st1, x1) }
        None -> ()
      }
      match v1 {
        None -> (st1, CBlock(drops(out), Some(CReturn(None)), TyNever))
        Some(x1) ->
          # the value is computed, then named, and only then does the frame go
          # away -- the drops must not run before the value exists
          if cex_ty(x1) == TyUnit {
            (st1, CBlock([CSDiscard(x1)] ++ drops(out), Some(CReturn(None)), TyNever))
          } else {
            let (st2, t) = fresh(st1)
            let rty = cex_ty(x1)
            (st2, CBlock(
              [CSLet(t, rty, x1)] ++ drops(out),
              Some(CReturn(Some(CLocal(t, rty)))),
              TyNever
            ))
          }
      }
    }

    CBreak(loop_id) -> {
      let out = unwind(st, loop_id)
      if len(out) == 0 { (st, e) } else { (st, CBlock(drops(out), Some(CBreak(loop_id)), TyNever)) }
    }

    CContinue(loop_id) -> {
      let out = unwind(st, loop_id)
      if len(out) == 0 {
        (st, e)
      } else {
        (st, CBlock(drops(out), Some(CContinue(loop_id)), TyNever))
      }
    }

    # The JVM escape hatch, which the native backend refuses outright
    # (emitc's CForeign arm). Rewriting it would mean counting values that
    # only ever exist on the path this pass does not run on.
    CForeign(_, _) -> (st, e)

    # Everything left produces its own reference or is not counted at all, so
    # the rewrite is the identity. Enumerated rather than swept up: the
    # wildcard's answer for a node added later would be "no counting needed",
    # which is the direction that costs a use-after-free.
    CInt(_) -> (st, e)
    CFloat(_) -> (st, e)
    CBool(_) -> (st, e)
    CStr(_) -> (st, e)
    CUnit -> (st, e)
    # a literal, a lifted function, a folded constant and a comptime value are
    # all immortal: the emitter builds each once behind a static
    CFnRef(_, _, _) -> (st, e)
    CConstRef(_, _, _) -> (st, e)
    CComptime(_, _, _) -> (st, e)
    # dictionaries are not counted (`dictish`), and neither are the
    # dictionaries a parameterised one is built from or read out of
    CDictRef(_, _, _, _) -> (st, e)
    CDictApply(_, _, _) -> (st, e)
    CDictArg(_, _, _, _, _) -> (st, e)
    # this pass is what puts CDup in; nothing it is handed holds one yet
    CDup(_, _) -> (st, e)
  }
}

fn rw_callee(st: RSt, c: CCallee, after: Set[Int]) -> (RSt, List[CStmt], CCallee, List[Int]) =
  match c {
    # calling a function value reads it; it is not consumed by the call
    CDynamic(target) -> {
      let (st1, lets, t1, temps) = borrow(st, target, after)
      (st1, lets, CDynamic(t1), temps)
    }
    # a dictionary is not counted, so the method's receiver passes through
    _ -> (st, [], c, [])
  }

## Bindings nothing later touches, released here rather than at scope end.
## This is the drop half of Perceus placement (docs/perceus-design.md 6): the
## sooner a reference goes away, the sooner `rc == 1` holds for whatever it
## kept alive -- a matched node released before the arm rebuilds is exactly
## what lets `array_with` find its array unique. The refusals mirror the
## transfer's, and for the transfer's reasons: a binding outside the current
## loop is touched again next iteration even when this one is done with it,
## and inside a short-circuit right side a drop would only sometimes run.
fn sweep(st: RSt, after: Set[Int]) -> (RSt, List[CStmt]) = {
  if st.pinned { return (st, []) }
  var dead: List[Int] = []
  for sym in scope_syms(st) {
    if not set.has(after, sym) && transferable(st, sym, after) { dead = dead ++ [sym] }
  }
  if len(dead) == 0 { (st, []) } else { (strip_syms(st, dead), drops(dead)) }
}

## Statements, each rewritten with the union of everything after it still
## alive. The after-sets are built back to front so the whole list costs one
## walk, then spent front to back with the rewrite; a sweep between each pair
## of statements releases whatever the suffix no longer touches.
fn rw_stmts(st: RSt, stmts: List[CStmt], base: Set[Int]) -> (RSt, List[CStmt]) = {
  let n = len(stmts)
  var afters: List[Set[Int]] = []
  var acc = base
  var i = n - 1
  while i >= 0 {
    afters = afters ++ [acc]
    acc = fv_stmt(stmts[i], acc)
    i = i - 1
  }
  var st1 = st
  var out: List[CStmt] = []
  var j = 0
  for s in stmts {
    let (s2, ss) = rw_stmt(st1, s, afters[n - 1 - j])
    let (s3, ds) = sweep(s2, afters[n - 1 - j])
    st1 = s3
    out = out ++ ss ++ ds
    j = j + 1
  }
  (st1, out)
}

fn rw_stmt(st: RSt, s: CStmt, after: Set[Int]) -> (RSt, List[CStmt]) =
  match s {
    CSLet(sym, ty, init) -> {
      let (st1, i1) = rw(st, init, true, after)
      # a literal-initialised binding is tracked like any other -- its scope
      # drop is a no-op on the static header, and one rule beats two; only a
      # dictionary stays out (no header to speak to)
      let st2 = if is_ref_ty(ty) && not dictish(st, init) { bind(st1, sym) } else { st1 }
      (st2, [CSLet(sym, ty, i1)])
    }

    # The new value is computed first: `s = s ++ "x"` reads the old one, and
    # the old one is released only once the new value holds its own
    # reference. But when the value's own evaluation consumes the binding --
    # `m = map.insert(m, k, v)` hands `m` to an owned parameter -- that
    # transfer IS the old value's release: the expansion's drop disappears
    # and the callee sees `rc == 1`, which is the whole linear-update case of
    # the reuse analysis (docs/perceus-design.md 6). The binding is re-homed
    # into the innermost scope while the value is rewritten so the transfer
    # is not refused across a loop boundary -- sound because the assignment
    # re-establishes it in the same statement; a value that could jump into
    # an enclosing loop's next iteration between those two points keeps the
    # conservative form.
    CSAssign(sym, value) -> {
      let ty = cex_ty(value)
      # the shortcut is for scalars and dictionaries only: an immortal
      # literal on the right still overwrites an old value that may be the
      # last counted reference, so it takes the dropping path below
      if not is_ref_ty(ty) || dictish(st, value) {
        let (st1, v1) = rw(st, value, true, set.insert(after, sym))
        return (st1, [CSAssign(sym, v1)])
      }
      let at = scope_index_of(st, sym)
      var jumps_out = false
      var i = len(st.scopes) - 1
      while i >= 0 {
        let lid = st.scopes[i].loop_id
        if lid >= 0 && jumps(value, lid, true, true) { jumps_out = true }
        i = i - 1
      }
      if at < 0 || jumps_out {
        let (st1, v1) = rw(st, value, true, set.insert(after, sym))
        let (st2, t) = fresh(st1)
        return (st2, [CSLet(t, ty, v1), CSDrop(sym), CSAssign(sym, CLocal(t, ty))])
      }
      let st0 = bind(strip_syms(st, [sym]), sym)
      let (st1, v1) = rw(st0, value, true, after)
      let (st2, t) = fresh(st1)
      if scope_index_of(st1, sym) < 0 {
        # taken: the old value's single release already happened inside `v1`
        (bind_at(st2, at, sym), [CSLet(t, ty, v1), CSAssign(sym, CLocal(t, ty))])
      } else {
        # not taken: move the binding home and release the old value here
        let st3 = bind_at(strip_syms(st2, [sym]), at, sym)
        (st3, [CSLet(t, ty, v1), CSDrop(sym), CSAssign(sym, CLocal(t, ty))])
      }
    }

    CSDiscard(x) -> {
      let (st1, lets, x1, temps) = borrow(st, x, after)
      if len(lets) == 0 {
        (st1, [CSDiscard(x1)])
      } else {
        # the work happened in the let; what is left is a name to release
        (st1, lets ++ drops(list.reverse(temps)))
      }
    }

    CSLoop(loop_id, body, step) -> {
      # the match once-loop is a branch tree in a loop costume; taken apart,
      # its arms reconcile like any branch and its scrutinee can die early
      match unloop(loop_id, body) {
        Some(s1) -> return rw_stmt(st, s1, after)
        None -> ()
      }
      let open = not completes(body) && not jumps(body, loop_id, true, false)
      let st1 = push(st, loop_id, open)
      # the body's base set: bindings outside the loop are guarded by the
      # scope itself (`transferable`), and everything bound inside it lives
      # only to the end of the iteration -- but a `continue` of an enclosing
      # loop after this one still closes that loop, so its pin flows in
      let (st2, lets, b1, temps) = borrow(st1, body, pins_only(after))
      let body1 = if len(lets) == 0 {
        b1
      } else {
        CBlock(lets ++ drops(list.reverse(temps)), None, TyUnit)
      }
      # The step also runs once per iteration and reads what outlives the
      # iteration, so the loop scope stays pushed while it is rewritten --
      # and the step precedes a re-entry by construction, so its own pin is
      # in the base: even an open loop refuses releases here.
      let (st3, step1) = match step {
        None -> (st2, None)
        Some(x) -> {
          let (s, l2, x1, t2) = borrow(st2, x, set.insert(pins_only(after), pin_of(loop_id)))
          if len(l2) == 0 {
            (s, Some(x1))
          } else {
            (s, Some(CBlock(l2 ++ drops(list.reverse(t2)), None, TyUnit)))
          }
        }
      }
      let (st4, owned) = pop(st3)
      # the scope's own bindings go at the end of the iteration, which is
      # where a `continue` also releases them
      let body2 = if len(owned) == 0 {
        body1
      } else {
        CBlock([CSDiscard(body1)] ++ drops(list.reverse(owned)), None, TyUnit)
      }
      (st4, [CSLoop(loop_id, body2, step1)])
    }

    CSIf(cond, thn, els) -> {
      let cond_after = {
        let a1 = fv_expr(thn, after)
        match els {
          None -> a1
          Some(x) -> fv_expr(x, a1)
        }
      }
      let (st1, lets, c1, temps) = borrow(st, cond, cond_after)
      let (st2, t1) = rw_effect(st1, thn, after)
      match els {
        None -> {
          if not yields(t1) {
            let (st4, cond2) = wrap(RSt { ..st2, scopes: st1.scopes }, lets, c1, cex_ty(cond), temps)
            return (st4, [CSIf(cond2, t1, None)])
          }
          let escaped = diff(scope_syms(st1), scope_syms(st2))
          let (st4, cond2) = wrap(st2, lets, c1, cex_ty(cond), temps)
          if len(escaped) == 0 {
            (st4, [CSIf(cond2, t1, None)])
          } else {
            # see the one-armed CIf: the untaken path releases the same things
            (st4, [CSIf(cond2, t1, Some(CBlock(drops(escaped), None, TyUnit)))])
          }
        }
        Some(x) -> {
          let (st3, e1) = rw_effect(RSt { ..st2, scopes: st1.scopes }, x, after)
          let (st4, t2, e2) = reconcile(st1, st2, st3, t1, e1, TyUnit)
          let (st5, cond2) = wrap(st4, lets, c1, cex_ty(cond), temps)
          (st5, [CSIf(cond2, t2, Some(e2))])
        }
      }
    }

    CSDrop(_) -> (st, [s])
  }

## An expression evaluated for its effect: whatever it produces is released
## right here, because nothing downstream will.
fn rw_effect(st: RSt, e: CExpr, after: Set[Int]) -> (RSt, CExpr) = {
  let (st1, lets, e1, temps) = borrow(st, e, after)
  if len(lets) == 0 {
    (st1, e1)
  } else {
    (st1, CBlock(lets ++ drops(list.reverse(temps)), None, TyUnit))
  }
}

# ---- entry ----

fn rc_fn(base_dicts: Set[Int], next_sym: Int, f: CFun) -> (Int, CFun) = {
  var dicts = base_dicts
  for d in f.dicts { dicts = set.insert(dicts, d.sym) }
  var st = RSt { scopes: [], dict_syms: dicts, next_sym: next_sym, pinned: false }
  st = push(st, -1, true)
  # captures and parameters arrive owned; the body is responsible for them.
  # A dictionary capture is neither: it is a static, outside the ledger.
  # Evidence is an ordinary counted record and rides with the parameters,
  # which is the entire reason it is not carried in `dicts`.
  for p in f.captures ++ f.params ++ f.evs {
    if is_ref_ty(p.ty) && not set.has(dicts, p.sym) { st = bind(st, p.sym) }
  }
  let (st1, body1) = rw(st, f.body, true, no_syms())
  let (st2, owned) = pop(st1)
  let (st3, body2) = seal(st2, body1, f.ret, list.reverse(owned))
  (st3.next_sym, CFun { ..f, body: body2 })
}

## Insert dup and drop across a module. Idempotent it is not: run it once.
##
## The dictionary symbols are unioned module-wide before any function is
## rewritten: a lifted lambda that captured an enclosing function's
## dictionary keeps the original symbol id, but carries it as a *capture*,
## not in its own `dicts` -- and a dictionary is outside the ledger wherever
## it appears (see `dictish`).
pub fn rc_module(m: CModule) -> CModule = {
  var base: Set[Int] = set.empty()
  for f in m.fns {
    for d in f.dicts { base = set.insert(base, d.sym) }
  }
  var next = m.next_sym
  var fns: List[CFun] = []
  for f in m.fns {
    let (n, f1) = rc_fn(base, next, f)
    next = n
    fns = fns ++ [f1]
  }
  let out = CModule { ..m, fns: fns, next_sym: next }
  let bad = rc_check(out)
  if len(bad) > 0 {
    panic("rc: unbalanced in " ++ m.owner ++ ": " ++ join(list.take(bad, 3), "; "))
  }
  out
}

# ---- the local oracle ----
#
# This walk settles the half of correctness that is structural: every binding
# released exactly once on every path -- where a release is a scope drop *or*
# a transfer, so the walk mirrors the rewrite's classification of consuming
# positions -- the two arms of a branch agreeing on what they released, a
# loop body ending where it started, and a `return` leaving nothing behind.
# What it cannot see is whether the dups match the consuming uses; that needs
# the type of every receiver, and the corpus for it is spike-native's asan
# check.

type Chk = { live: Set[Int], gone: Bool, errs: List[String] }

fn chk_err(c: Chk, msg: String) -> Chk = Chk { ..c, errs: c.errs ++ [msg] }

## The half of `immortal` a walk with no state can recognise.
## The checker's mirror of `dictish` (minus the local dictionary syms, which
## are CDict* nodes by the time this walk runs). Deliberately NOT a mirror of
## `immortal`: a literal-initialised binding is live like any other -- its
## release is a free no-op -- and keeping the two sides on one definition of
## "tracked" is lesson 3 of the reuse analysis.
fn chk_dictish(e: CExpr) -> Bool =
  match e {
    CDictRef(_, _, _, _) -> true
    CDictApply(_, _, _) -> true
    CDictArg(_, _, _, _, _) -> true
    _ -> false
  }

## A `Never` is a path that ends: `panic` and `todo` reach it, and so does
## every jump. Nothing after one is reachable, and nothing it still holds is
## worth releasing -- the process is over or the frame is gone.
##
## `k` marks a consuming position, where a bare binding is a transfer: the
## reference moves out and no drop will follow.
fn chk_expr(c: Chk, e: CExpr, k: Bool) -> Chk = {
  let c1 = chk_walk(c, e, k)
  if cex_ty(e) == TyNever { Chk { ..c1, gone: true } } else { c1 }
}

fn chk_walk(c: Chk, e: CExpr, k: Bool) -> Chk =
  match e {
    CLocal(sym, _) ->
      if k && set.has(c.live, sym) {
        Chk { ..c, live: set.remove(c.live, sym) }
      } else {
        c
      },

    CBlock(stmts, tail, _) -> {
      var c1 = c
      # A statement that always jumps ends the block: what lowering wrote after
      # it is unreachable, and so are the drops this pass put there. Walking on
      # would read those as a second release of something already gone.
      for s in stmts {
        if not c1.gone { c1 = chk_stmt(c1, s) }
      }
      if c1.gone { return c1 }
      match tail {
        None -> c1
        # a block's tail hands its value out, transfers included
        Some(t) -> chk_expr(c1, t, k)
      }
    }

    CIf(cond, thn, els, _) -> {
      let c1 = chk_expr(c, cond, false)
      let ct = chk_expr(Chk { ..c1, gone: false }, thn, k)
      match els {
        None ->
          if ct.gone {
            Chk { ..c1, errs: ct.errs }
          } else if set.len(ct.live) != set.len(c1.live) {
            chk_err(Chk { ..c1, errs: ct.errs }, "a one-armed if released a binding")
          } else {
            Chk { ..c1, errs: ct.errs }
          }
        Some(x) -> {
          let ce = chk_expr(Chk { ..c1, live: c1.live, gone: false, errs: ct.errs }, x, k)
          if ct.gone && ce.gone {
            Chk { ..ce, gone: true }
          } else if ct.gone {
            ce
          } else if ce.gone {
            Chk { ..ce, live: ct.live, gone: false }
          } else if set.len(ct.live) != set.len(ce.live) {
            chk_err(ce, "the arms of an if disagree on what they released")
          } else {
            Chk { ..ce, live: ct.live, gone: false }
          }
        }
      }
    }

    CReturn(v) -> {
      let c1 = match v {
        None -> c
        # the value on its way out is a consuming position like any other
        Some(x) -> chk_expr(c, x, true)
      }
      # a value that diverged never comes back to this return -- the TCO
      # shape wraps the whole body in `return <Never block>`, and what was
      # still held at the panic inside it is the panic's dead code, already
      # forgiven where it diverged
      if c1.gone { return Chk { ..c1, gone: true } }
      let c2 = if set.len(c1.live) > 0 {
        chk_err(c1, "a return left a binding behind: " ++
            join(list.map(set.to_list(c1.live), x => to_string(x)), ","))
      } else {
        c1
      }
      Chk { ..c2, gone: true }
    }

    CBreak(_) -> Chk { ..c, gone: true }
    CContinue(_) -> Chk { ..c, gone: true }
    CDup(inner, _) -> chk_expr(c, inner, false)
    CField(t, _, _, _, _) -> chk_expr(c, t, false)
    CTupleGet(t, _, _) -> chk_expr(c, t, false)
    CIsCtor(t, _, _) -> chk_expr(c, t, false)
    CTagOf(t, _) -> chk_expr(c, t, false)
    CBox(inner, from) -> chk_expr(c, inner, k && is_ref_ty(from))
    CUnbox(inner, to) -> chk_expr(c, inner, k && is_ref_ty(to))
    CUnary(_, x, _) -> chk_expr(c, x, false)
    CBinary(_, l, r, _) -> chk_expr(chk_expr(c, l, false), r, false)
    CCall(callee, args, _) -> {
      var c1 = match callee {
        CDynamic(t) -> chk_expr(c, t, false)
        _ -> c
      }
      for a in args { c1 = chk_expr(c1, a, true) }
      c1
    }
    CIntrinsic(name, args, _) -> {
      let owned = intr_owned_args(name)
      var c1 = c
      var i = 0
      for a in args {
        c1 = chk_expr(c1, a, list.contains(owned, i))
        i = i + 1
      }
      c1
    }
    CCtor(_, _, args, _) -> chk_list(c, args, true)
    CTuple(elems, _) -> chk_list(c, elems, true)
    CListLit(elems, _) -> chk_list(c, elems, true)
    CClosure(_, _, caps, _) -> chk_list(c, caps, true)
    # The leaves and the uncounted, enumerated for the reason fv_expr is: this
    # walk is the pass's own oracle, so a node it silently skips is a hole in
    # the check rather than a wrong answer anyone would see.
    CInt(_) -> c
    CFloat(_) -> c
    CBool(_) -> c
    CStr(_) -> c
    CUnit -> c
    CFnRef(_, _, _) -> c
    CConstRef(_, _, _) -> c
    CComptime(_, _, _) -> c
    CDictRef(_, _, _, _) -> c
    CDictApply(_, _, _) -> c
    CDictArg(_, _, _, _, _) -> c
    # inert here for the same reason `rw` leaves it alone
    CForeign(_, _) -> c
  }

fn chk_list(c: Chk, es: List[CExpr], k: Bool) -> Chk = {
  var c1 = c
  for e in es { c1 = chk_expr(c1, e, k) }
  c1
}

fn chk_stmt(c: Chk, s: CStmt) -> Chk =
  match s {
    CSLet(sym, ty, init) -> {
      let c1 = chk_expr(c, init, true)
      if is_ref_ty(ty) && not chk_dictish(init) && not set.has(c1.live, sym) {
        Chk { ..c1, live: set.insert(c1.live, sym) }
      } else {
        c1
      }
    }
    CSAssign(sym, value) -> {
      let c1 = chk_expr(c, value, true)
      if is_ref_ty(cex_ty(value)) && not chk_dictish(value) {
        Chk { ..c1, live: set.insert(c1.live, sym) }
      } else {
        c1
      }
    }
    CSDiscard(x) -> chk_expr(c, x, false)
    CSDrop(sym) ->
      if set.has(c.live, sym) {
        Chk { ..c, live: set.remove(c.live, sym) }
      } else {
        chk_err(c, "released a binding that was not held: " ++ to_string(sym))
      }
    CSIf(cond, thn, els) -> {
      let c1 = chk_expr(c, cond, false)
      let ct = chk_expr(Chk { ..c1, gone: false }, thn, false)
      match els {
        None ->
          if ct.gone {
            Chk { ..c1, errs: ct.errs }
          } else if set.len(ct.live) != set.len(c1.live) {
            chk_err(Chk { ..c1, errs: ct.errs }, "a one-armed if released a binding")
          } else {
            Chk { ..c1, errs: ct.errs }
          }
        Some(x) -> {
          let ce = chk_expr(Chk { ..c1, gone: false, errs: ct.errs }, x, false)
          if ct.gone { ce } else if ce.gone { Chk { ..ce, live: ct.live, gone: false } } else {
            if set.len(ct.live) != set.len(ce.live) {
              chk_err(ce, "the arms of an if disagree on what they released")
            } else {
              Chk { ..ce, live: ct.live, gone: false }
            }
          }
        }
      }
    }
    CSLoop(lid, body, step) -> {
      let cb = chk_expr(Chk { ..c, gone: false }, body, false)
      let c1 = if cb.gone {
        Chk { ..cb, live: c.live, gone: false }
      } else if set.len(cb.live) != set.len(c.live) {
        chk_err(cb, "a loop body did not end where it started")
      } else {
        Chk { ..cb, live: c.live, gone: false }
      }
      let c2 = match step {
        None -> c1
        Some(x) -> chk_expr(c1, x, false)
      }
      # a loop nothing breaks out of is never left: what follows it is
      # unreachable, and an open loop's paths released their own accounts at
      # their returns -- the restored live set must not be charged again
      if jumps(body, lid, true, false) { c2 } else { Chk { ..c2, gone: true } }
    }
  }

## Every way this module's Core is unbalanced, as sentences. Empty is the
## answer the pass is supposed to produce.
pub fn rc_check(m: CModule) -> List[String] = {
  # the same module-wide dictionary union the pass makes: a lifted lambda's
  # dictionary capture is not a counted binding, so the oracle must not
  # expect a release for it (pass and oracle share one definition)
  var base: Set[Int] = set.empty()
  for f in m.fns {
    for d in f.dicts { base = set.insert(base, d.sym) }
  }
  var errs: List[String] = []
  for f in m.fns {
    var live: Set[Int] = set.empty()
    for p in f.captures ++ f.params ++ f.evs {
      if is_ref_ty(p.ty) && not set.has(base, p.sym) { live = set.insert(live, p.sym) }
    }
    let c = chk_expr(Chk { live: live, gone: false, errs: [] }, f.body, true)
    var here = c.errs
    if not c.gone && set.len(c.live) > 0 {
      here = here ++ ["a body left " ++ to_string(set.len(c.live)) ++ " binding(s) held"]
    }
    for e2 in here { errs = errs ++ [f.name ++ ": " ++ e2] }
  }
  errs
}

fn one_fn(params: List[CParam], ret: Ty, body: CExpr) -> CModule =
  CModule {
    owner: "m",
    fns: [CFun {
      name: "f", owner: "m", captures: [], params: params, dicts: [], evs: [],
      ret: ret, body: body, is_test: false, impl_of: None, default_of: None
    }],
    dicts: [],
    next_sym: 100
  }

test "a scalar body needs no counting at all" {
  let m = rc_module(one_fn([], TyInt, CInt(1)))
  assert len(rc_check(m)) == 0
}

test "a reference parameter the body never touches is still released" {
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  # the oracle sees the gap before the pass fills it...
  assert len(rc_check(one_fn([p], TyInt, CInt(1)))) == 1
  # ...and does not see one after
  assert len(rc_check(rc_module(one_fn([p], TyInt, CInt(1))))) == 0
}

test "handing a parameter back is a move, not a copy" {
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  let m = rc_module(one_fn([p], lst, CLocal(1, lst)))
  assert len(rc_check(m)) == 0
  # the last (only) use takes the value: no dup, no drop, nothing to balance
  match m.fns[0].body {
    CLocal(s, _) -> { assert s == 1 }
    _ -> panic("expected the body to stay a bare hand-over")
  }
}

test "an earlier use copies, the last one takes" {
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  let g = CDirect("m", "g")
  let body = CBlock(
    [CSDiscard(CCall(g, [CLocal(1, lst)], TyInt))],
    Some(CCall(g, [CLocal(1, lst)], TyInt)),
    TyInt
  )
  let m = rc_module(one_fn([p], TyInt, body))
  assert len(rc_check(m)) == 0
  match m.fns[0].body {
    CBlock(ss, tail, _) -> {
      match ss[0] {
        CSDiscard(CCall(_, a1, _)) ->
          match a1[0] {
            CDup(_, _) -> ()
            _ -> panic("expected the earlier use to copy")
          }
        _ -> panic("expected the discarded call")
      }
      match tail {
        Some(CCall(_, a2, _)) ->
          match a2[0] {
            CLocal(s, _) -> { assert s == 1 }
            _ -> panic("expected the last use to take the value")
          }
        _ -> panic("expected the tail call")
      }
    }
    _ -> panic("expected the block to survive")
  }
}

test "two uses in one operand list both copy" {
  # C leaves argument order unspecified, so "earlier" and "last" only exist
  # between sequenced positions -- inside one operand list the transfer is
  # refused on both sides and the binding is released at the end
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  let pair = TyTuple([lst, lst])
  let m = rc_module(one_fn([p], pair, CTuple([CLocal(1, lst), CLocal(1, lst)], pair)))
  assert len(rc_check(m)) == 0
  match m.fns[0].body {
    CBlock(ss, _, _) -> {
      match ss[0] {
        CSLet(_, _, CTuple(elems, _)) -> {
          match elems[0] {
            CDup(_, _) -> ()
            _ -> panic("expected the first use to copy")
          }
          match elems[1] {
            CDup(_, _) -> ()
            _ -> panic("expected the second use to copy too")
          }
        }
        _ -> panic("expected the tuple to be named")
      }
      match ss[1] {
        CSDrop(d) -> { assert d == 1 }
        _ -> panic("expected the parameter released at the end")
      }
    }
    _ -> panic("expected a block")
  }
}

test "a use inside a loop copies every trip round" {
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  let call = CCall(CDirect("m", "g"), [CLocal(1, lst)], TyInt)
  let body = CBlock(
    [CSLoop(7, CBlock([CSDiscard(call)], None, TyUnit), None)],
    Some(CInt(0)),
    TyInt
  )
  let m = rc_module(one_fn([p], TyInt, body))
  assert len(rc_check(m)) == 0
  # the textual last use runs once per iteration; it must copy, and the
  # binding is released after the loop instead
  match m.fns[0].body {
    CBlock(stmts, _, _) ->
      match stmts[0] {
        CSLoop(_, lb, _) ->
          match lb {
            CBlock(ls, _, _) ->
              match ls[0] {
                CSDiscard(CCall(_, args2, _)) ->
                  match args2[0] {
                    CDup(_, _) -> ()
                    _ -> panic("expected the loop use to copy")
                  }
                _ -> panic("expected the discarded call")
              }
            _ -> panic("expected the loop body block")
          }
        _ -> panic("expected the loop")
      }
    _ -> panic("expected a block")
  }
}

test "the arm that keeps a binding drops what the other arm took" {
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  let body = CIf(
    CBool(true),
    CCall(CDirect("m", "g"), [CLocal(1, lst)], TyInt),
    Some(CInt(0)),
    TyInt
  )
  let m = rc_module(one_fn([p], TyInt, body))
  assert len(rc_check(m)) == 0
  match m.fns[0].body {
    CIf(_, thn, els, _) -> {
      match thn {
        CCall(_, args2, _) ->
          match args2[0] {
            CLocal(s, _) -> { assert s == 1 }
            _ -> panic("expected the then arm to take the value")
          }
        _ -> panic("expected the call to survive")
      }
      match els {
        Some(CBlock(ss, _, _)) -> {
          var seen = false
          for s2 in ss {
            match s2 {
              CSDrop(d) -> { if d == 1 { seen = true } }
              _ -> ()
            }
          }
          assert seen
        }
        _ -> panic("expected the else arm to grow a release")
      }
    }
    _ -> panic("expected the if to survive")
  }
}

test "the right side of a short circuit refuses to take" {
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  let body = CBinary(
    CAnd,
    CBool(true),
    CCall(CDirect("m", "p"), [CLocal(1, lst)], TyBool),
    TyBool
  )
  let m = rc_module(one_fn([p], TyBool, body))
  assert len(rc_check(m)) == 0
  # the call only sometimes runs, so its use must copy, and the release
  # stays at the end of the function where it is unconditional
  match m.fns[0].body {
    CBlock(ss, _, _) -> {
      match ss[0] {
        CSLet(_, _, CBinary(_, _, r, _)) ->
          match r {
            CCall(_, args2, _) ->
              match args2[0] {
                CDup(_, _) -> ()
                _ -> panic("expected the conditional use to copy")
              }
            _ -> panic("expected the call")
          }
        _ -> panic("expected the binary to be named")
      }
      match ss[1] {
        CSDrop(d) -> { assert d == 1 }
        _ -> panic("expected the parameter released at the end")
      }
    }
    _ -> panic("expected a block")
  }
}

test "array_with takes its owned operands bare at their last use" {
  let arr = TyArray(TyInt)
  let lst = TyList(TyInt)
  let p1 = CParam { sym: 1, ty: arr, mode: COwned }
  let p2 = CParam { sym: 2, ty: lst, mode: COwned }
  let body = CIntrinsic("array_with", [CLocal(1, arr), CInt(0), CLocal(2, lst)], arr)
  let m = rc_module(one_fn([p1, p2], arr, body))
  assert len(rc_check(m)) == 0
  # both owned positions hand their reference over: no dup, no scope drop
  match m.fns[0].body {
    CIntrinsic(_, args, _) -> {
      match args[0] {
        CLocal(s, _) -> { assert s == 1 }
        _ -> panic("expected the array handed over bare")
      }
      match args[2] {
        CLocal(s, _) -> { assert s == 2 }
        _ -> panic("expected the element handed over bare")
      }
    }
    _ -> panic("expected the intrinsic to survive")
  }
}

test "a binding is released at the statement that stops touching it" {
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  # the parameter is only ever borrowed, so no transfer can release it; the
  # sweep must, and right after its last touch rather than at scope end
  let body = CBlock(
    [
      CSDiscard(CIntrinsic("len", [CLocal(1, lst)], TyInt)),
      CSDiscard(CCall(CDirect("m", "g"), [], TyInt))
    ],
    Some(CInt(0)),
    TyInt
  )
  let m = rc_module(one_fn([p], TyInt, body))
  assert len(rc_check(m)) == 0
  match m.fns[0].body {
    CBlock(ss, _, _) -> {
      match ss[1] {
        CSDrop(d) -> { assert d == 1 }
        _ -> panic("expected the release between the statements")
      }
    }
    _ -> panic("expected a block")
  }
}

test "the match once-loop is unlooped and its arm takes the binding" {
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  # lower_match's shape: `if (test) { arm; break }` rows over an unreachable
  # tail; inside the loop the transfer would be refused, unlooped it happens
  let arm = CBlock(
    [CSDiscard(CCall(CDirect("m", "g"), [CLocal(1, lst)], TyInt))],
    Some(CBreak(7)),
    TyNever
  )
  let body = CBlock(
    [CSLoop(7, CBlock(
      [CSIf(CBool(true), arm, None), CSDiscard(CIntrinsic("todo", [], TyNever))],
      None, TyUnit), None)],
    Some(CInt(0)),
    TyInt
  )
  let m = rc_module(one_fn([p], TyInt, body))
  assert len(rc_check(m)) == 0
  match m.fns[0].body {
    CBlock(ss, _, _) ->
      match ss[0] {
        CSLoop(_, _, _) -> panic("expected the once-loop to be taken apart")
        CSIf(_, thn, _) ->
          match thn {
            CBlock(as2, _, _) ->
              match as2[0] {
                CSDiscard(CCall(_, args2, _)) ->
                  match args2[0] {
                    CLocal(s, _) -> { assert s == 1 }
                    _ -> panic("expected the arm to take the value")
                  }
                _ -> panic("expected the arm's call")
              }
            _ -> panic("expected the arm block")
          }
        _ -> panic("expected the branch tree")
      },
    _ -> panic("expected a block")
  }
}

test "a source loop ending in break keeps its jump target" {
  # while and range loops start with their exit test and end with the source
  # body. A terminal break makes that look like lower_match unless unloop also
  # inspects the last statement for jumps to this loop.
  let loop_body = CBlock([
    CSIf(CBool(false), CBreak(7), None),
    CSDiscard(CBreak(7))
  ], None, TyUnit)
  let body = CBlock([CSLoop(7, loop_body, None)], Some(CInt(0)), TyInt)
  let m = rc_module(one_fn([], TyInt, body))
  assert len(rc_check(m)) == 0
  match m.fns[0].body {
    CBlock([CSLoop(7, _, _)], _, _) -> ()
    _ -> panic("expected the source loop to retain its break target")
  }
}

test "a source loop ending in continue keeps its jump target" {
  let loop_body = CBlock([
    CSIf(CBool(false), CBreak(7), None),
    CSDiscard(CContinue(7))
  ], None, TyUnit)
  let body = CBlock([CSLoop(7, loop_body, None)], Some(CInt(0)), TyInt)
  let m = rc_module(one_fn([], TyInt, body))
  assert len(rc_check(m)) == 0
  match m.fns[0].body {
    CBlock([CSLoop(7, _, _)], _, _) -> ()
    _ -> panic("expected the source loop to retain its continue target")
  }
}

test "reassignment from the old value is a hand-over, not copy and drop" {
  let lst = TyList(TyInt)
  let p = CParam { sym: 1, ty: lst, mode: COwned }
  # `m = g(m)`: the call consumes the old value, so the expansion has no
  # drop of its own -- this is what lets the callee see rc == 1
  let body = CBlock(
    [CSAssign(1, CCall(CDirect("m", "g"), [CLocal(1, lst)], lst))],
    Some(CInt(0)),
    TyInt
  )
  let m = rc_module(one_fn([p], TyInt, body))
  assert len(rc_check(m)) == 0
  match m.fns[0].body {
    CBlock(ss, _, _) -> {
      match ss[0] {
        CSLet(_, _, CCall(_, args2, _)) ->
          match args2[0] {
            CLocal(s, _) -> { assert s == 1 }
            _ -> panic("expected the old value handed into the call")
          }
        _ -> panic("expected the value named first")
      }
      match ss[1] {
        CSAssign(_, _) -> ()
        _ -> panic("expected the assignment right after, with no drop between")
      }
    }
    _ -> panic("expected a block")
  }
}

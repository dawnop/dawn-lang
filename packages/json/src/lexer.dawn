# Low-level scanning: whitespace, string literals, and number literals.
#
# Positions are std cursors into the source String, not indices into a
# `List[Int]` of its code points. The shape of the code is unchanged — every
# function still takes a position and returns the next one, so the parser stays
# purely functional — but nothing materializes the document first. That
# materialization was the JSON example's dominant cost: see
# docs/seq6-research.md.
#
# `cursor.char` reports -1 past the end, which is exactly the sentinel `peek`
# already used, so end-of-input handling did not have to change at all.
# No panics — malformed input becomes an Err.

use std/char
use std/cursor
use std/str
use std/cursor.{Cursor}
use value.{JsonError, JsonErrorKind, Syntax, Truncated}

## The code point at `i`, or -1 at the end of the document.
##
## An `Int` and not a `Char`: the end-of-input answer is a sentinel, and a
## sentinel that is not a character cannot live in a type whose every value is
## one (spec §4.8). So this scanner compares code points, and spells the
## constants it compares against as `char.code('x')` -- the character is what
## is readable, the Int is what is being compared.
pub fn peek(src: String, i: Cursor) -> Int = cursor.char(src, i)

## A code point the scanner has already validated, as the character it names.
## Outside std the Int -> Char bridge is the checked one, so every call site
## here has to have excluded the surrogate range first -- which each has, since
## that is what JSON's `\uD800` handling is about.
fn char_of_code(n: Int) -> Char = char.of(n).expect("a Unicode scalar value")

# ---- error positions ----

# Code-point offset of `i` in `src`. Cursors are opaque on purpose (std/cursor),
# so there is no arithmetic to read a position out of one; slicing from the
# start and measuring is the sanctioned way. It is O(n), which is why it is only
# ever called on the failure path — a parse produces at most one error.
pub fn offset(src: String, i: Cursor) -> Int =
  str.len(cursor.slice(src, cursor.start(src), i))

# Every error carries where it happened. Callers validating config, signatures
# or API payloads need to point at the offending character; a bare message means
# they have to re-scan the document themselves to say anything useful.
#
# `Syntax` and `Truncated` are told apart mechanically rather than site by site:
# an error noticed with the cursor at the end of the document *is* the document
# running out, whichever scanner noticed it. The kinds a position cannot decide
# (Trailing, Depth, NumberRange) are passed in by their one call site each,
# through `err_kind`.
pub fn err_at(src: String, i: Cursor, msg: String) -> JsonError =
  err_kind(src, i, if cursor.done(src, i) { Truncated } else { Syntax }, msg)

## An error of a stated kind at `i`.
pub fn err_kind(src: String, i: Cursor, kind: JsonErrorKind, msg: String) -> JsonError =
  JsonError { kind: kind, offset: offset(src, i), message: msg }

pub fn is_digit(c: Int) -> Bool = c >= char.code('0') && c <= char.code('9')

pub fn skip_ws(src: String, i: Cursor) -> Cursor = {
  # `cursor.char` and not `peek`: the parser asks this at every value, every
  # array element and every object member, so the wrapper's frame is a frame
  # per token of the document.
  let c = cursor.char(src, i)
  if c == char.code(' ') || c == char.code('\t') || c == char.code('\n') ||
    c == char.code('\r') {
      skip_ws(src, cursor.next(src, i))
    } else {
      i
    }
}

# ---- strings ----

fn hex_digit(c: Int) -> Int =
  if c >= char.code('0') && c <= char.code('9') {
    c - char.code('0')
  } else if c >= char.code('a') && c <= char.code('f') {
    c - char.code('a') + 10
  } else if c >= char.code('A') && c <= char.code('F') {
    c - char.code('A') + 10
  } else {
    -1
  }

# four hex digits at `i`; returns (value, cursor past them). Stepping with
# `cursor.next` rather than `i + 1` matters even though hex digits are ASCII:
# on malformed input the character sitting there may not be, and arithmetic
# would land inside a surrogate pair instead of on the next character.
fn read_hex4(src: String, i: Cursor) -> Option[(Int, Cursor)] = {
  let i1 = cursor.next(src, i)
  let i2 = cursor.next(src, i1)
  let i3 = cursor.next(src, i2)
  let a = hex_digit(peek(src, i))
  let b = hex_digit(peek(src, i1))
  let c = hex_digit(peek(src, i2))
  let d = hex_digit(peek(src, i3))
  if a < 0 || b < 0 || c < 0 || d < 0 {
    None
  } else {
    Some((a * 4096 + b * 256 + c * 16 + d, cursor.next(src, i3)))
  }
}

# What one of JSON's short escapes decodes to, as text rather than as a `Char`.
#
# A `Char` would have to be turned into a one-character String to be appended
# to anything, and `from_code_points` on a one-element list is an allocation
# per escape of every escaped string. These are the eight answers there are, so
# they are written as the strings they are and the conversion never runs.
fn simple_escape(e: Int) -> Option[String] =
  if e == char.code('"') {
    Some("\"")
  } else if e == char.code('\\') {
    Some("\\")
  } else if e == char.code('/') {
    Some("/")
  } else if e == char.code('b') {
    Some("\u{0008}")
  } else if e == char.code('f') {
    Some("\u{000C}")
  } else if e == char.code('n') {
    Some("\n")
  } else if e == char.code('r') {
    Some("\r")
  } else if e == char.code('t') {
    Some("\t")
  } else {
    None
  }

# `start` is the opening quote; returns (decoded string, cursor past the closing
# quote).
#
# The accumulator holds *spans*, not characters. A run of characters that no
# escape touches is already a substring of the source, so it comes out with one
# `cursor.slice` however long it is; only an escape, which decodes to something
# no span of the source contains, ends a run. The overwhelmingly common string
# -- one with no escape in it at all -- never touches the accumulator: the whole
# scan is a walk to the closing quote and one slice.
#
# The list-per-character version this replaces was the parser's dominant cost.
# Appending a one-element list is a bounded copy, but the bound is a pvec push
# plus a concat plus the allocation of the singleton, and paying it per
# character of every key and every string value dwarfed the scan itself.
pub fn scan_string(src: String, start: Cursor) -> Result[(String, Cursor), JsonError] = {
  var i = cursor.next(src, start)
  # where the run of unescaped characters in progress began
  var run = i
  var parts: List[String] = []
  var chunk = ""
  var pending = 0
  var out = ""
  var status = 0
  var errmsg = JsonError { kind: Syntax, offset: 0, message: "" }
  while status == 0 {
    # `cursor.char` and not `peek`: they answer the same thing, and this is the
    # one loop in the package that runs per character of the document, so the
    # frame the wrapper costs is a frame per character.
    let c = cursor.char(src, i)
    if c == -1 {
      status = 2
      errmsg = err_at(src, i, "unterminated string")
    } else if c == char.code('"') {
      let last = chunk ++ cursor.slice(src, run, i)
      out = if len(parts) == 0 { last } else { join(parts ++ [last], "") }
      i = cursor.next(src, i)
      status = 1
    } else if c == char.code('\\') {
      let ie = cursor.next(src, i)
      let e = peek(src, ie)
      # what this escape decodes to, and where the character after it is. The
      # branches below only compute those two; the one append is after them, so
      # the accumulator is touched once per escape however the escape was spelt.
      var dec = ""
      var after = ie
      var ok = true
      if e == char.code('u') {
        match read_hex4(src, cursor.next(src, ie)) {
          None -> {
            ok = false
            status = 2
            errmsg = err_at(src, i, "invalid \\u escape")
          }
          Some((code, a1)) -> {
            after = a1
            if code >= 55296 && code <= 56319 {
              let iu = cursor.next(src, a1)
              if peek(src, a1) == char.code('\\') && peek(src, iu) == char.code('u') {
                match read_hex4(src, cursor.next(src, iu)) {
                  None -> {
                    ok = false
                    status = 2
                    errmsg = err_at(src, i, "invalid \\u escape")
                  }
                  Some((low, a2)) -> {
                    if low >= 56320 && low <= 57343 {
                      dec = str.from_char(
                        char_of_code(65536 + (code - 55296) * 1024 + (low - 56320)))
                      after = a2
                    } else {
                      dec = replacement()
                    }
                  }
                }
              } else {
                dec = replacement()
              }
            } else if code >= 56320 && code <= 57343 {
              dec = replacement()
            } else {
              dec = str.from_char(char_of_code(code))
            }
          }
        }
      } else {
        # `simple_escape` answers None for the end of input too, where `peek`
        # is -1 and no escape character can be
        match simple_escape(e) {
          Some(cp) -> {
            dec = cp
            after = cursor.next(src, ie)
          }
          None -> {
            ok = false
            status = 2
            errmsg = err_at(src, i, "invalid escape")
          }
        }
      }
      if ok {
        chunk = chunk ++ cursor.slice(src, run, i) ++ dec
        pending = pending + 1
        if pending == BATCH {
          parts = parts ++ [chunk]
          chunk = ""
          pending = 0
        }
        i = after
        run = after
      }
    } else if c < 32 {
      status = 2
      errmsg = err_at(src, i, "control character in string")
    } else {
      i = cursor.next(src, i)
    }
  }
  if status == 1 {
    Ok((out, i))
  } else {
    Err(errmsg)
  }
}

# U+FFFD, what an unpaired surrogate escape decodes to.
fn replacement() -> String = str.from_char(char_of_code(65533))

# How many decoded pieces gather in one string before that string joins the
# list.
#
# An escape ends a run, so an escape-dense string would otherwise append to the
# list once per escape -- and a list append is a whole singleton vector where a
# string concat is one allocation. Batching trades a bounded amount of recopying
# for that: a piece is copied at most `BATCH` times before its chunk is flushed,
# so the extra copying stays linear in the output with this constant, while the
# appends drop by the same factor. 32 is where the measurement stops improving
# (a 58 KB escape-dense document: 3.5 ms to 1.5 ms, and 64 buys nothing more).
const BATCH: Int = 32

# ---- numbers ----

fn skip_digits(src: String, i: Cursor) -> Cursor =
  if is_digit(cursor.char(src, i)) { skip_digits(src, cursor.next(src, i)) } else { i }

# One `peek` and three tests, not three `peek`s: each one is a call that hands
# the whole document across a frame boundary, and the scanner is asking the same
# question of the same position every time.
fn scan_int_part(src: String, i: Cursor) -> Result[Cursor, JsonError] = {
  let c = peek(src, i)
  if c == char.code('0') {
    Ok(cursor.next(src, i))
  } else if c >= char.code('1') && c <= char.code('9') {
    Ok(skip_digits(src, cursor.next(src, i)))
  } else {
    Err(err_at(src, i, "invalid number: expected a digit"))
  }
}

fn scan_frac(src: String, i: Cursor) -> Result[Cursor, JsonError] =
  if peek(src, i) == char.code('.') {
    let i1 = cursor.next(src, i)
    let j = skip_digits(src, i1)
    if j == i1 {
      Err(err_at(src, i1, "invalid number: digits expected after '.'"))
    } else {
      Ok(j)
    }
  } else {
    Ok(i)
  }

fn scan_exp(src: String, i: Cursor) -> Result[Cursor, JsonError] = {
  let c = peek(src, i)
  if c == char.code('e') || c == char.code('E') {
    let i1 = cursor.next(src, i)
    let sign = peek(src, i1)
    let i2 =
      if sign == char.code('+') || sign == char.code('-') {
        cursor.next(src, i1)
      } else {
        i1
      }
    let j = skip_digits(src, i2)
    if j == i2 {
      Err(err_at(src, i2, "invalid number: digits expected in exponent"))
    } else {
      Ok(j)
    }
  } else {
    Ok(i)
  }
}

# `start` begins a number; returns (the literal's *text*, cursor past it). The
# text comes out with one `cursor_slice`, where the List[Int] version had to copy
# the span element by element and rebuild a string from it.
#
# Handing back the lexeme rather than a Float is the whole point: routing every
# integer through a double is what silently turned 9007199254740993 into
# ...992. Only the caller knows whether this literal is an Int or a Float, so
# only the caller can pick a lossless conversion — see `number_of` in parser.
pub fn scan_number(src: String, start: Cursor) -> Result[(String, Cursor), JsonError] = {
  let i0 = if peek(src, start) == char.code('-') { cursor.next(src, start) } else { start }
  let i1 = scan_int_part(src, i0)?
  let i2 = scan_frac(src, i1)?
  let i3 = scan_exp(src, i2)?
  Ok((cursor.slice(src, start, i3), i3))
}

# expect: an impl cannot declare effect parameters
# expect: only declarations (use, fn, type, alias, const, trait, impl, effect, test) are allowed at module top level
# An impl's own parameters instantiate the trait's subject, and a subject is a
# type: nothing on an impl head reads an effect. Only fn / alias / type take the
# table (docs/effect-params-design.md decision 4). The second diagnostic is the
# recovery: the body's method reparses as a top-level fn, leaving its `}` loose.
impl[!e] Show[Int] {
  fn show(x: Int) -> String = "x"
}

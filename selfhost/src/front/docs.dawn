# `##` doc comments: which comment documents which declaration, and the one
# that documents the module. It lives in the front end, not beside `dawn doc`,
# because it reads nothing but the lexer's comment tokens and the parse tree's
# spans, and two layers need the same answer: the entry layer (`doc.dawn`,
# which prints the JSON) and the language server (`lsp/`, which puts the text
# under a hover). `lsp/` may not import the entry layer, and a second copy of
# the attachment rule would be free to drift from the one `dawn doc` publishes.
#
# The rule (Doc.kt docOf / commentsByLine): the `##` lines immediately above a
# declaration's first line, contiguous. A blank line detaches; plain `#` is
# never a doc. A comment is filed under the line its last character sits on,
# and only if it is the first thing on that line: a `##` after code is a
# remark on that code, and filing it would let the next line's declaration
# claim it (docs/spec.md §1.2).
#
# The rule is a line rule and knows no declaration kinds: a member (a
# constructor, a record or constructor field, a trait method) is read from its
# own `lo` exactly as a top-level declaration is. Which declarations take a doc
# is the callers' choice of which spans to ask about; `dawn doc` and hover ask
# about the same ones. The one member rule is `member_doc_of`: a constructor
# or field written on its owner's line has no doc of its own, because the block
# above that line documents the owner (spec §1.2).
#
# Which spans of a doc are `[`name`]` links (`doc_links`, `rewrite_links`) is
# here too: it is a scan of the comment's text, the same for `dawn doc` (which
# fails on a link that resolves to nothing) and hover (which makes them
# clickable). What a link resolves to needs a checked module's import tables
# and is `driver/doclinks`.
#
# A declaration's examples are here for the same two consumers: a test named
# by the declaration (`test f { ... }`, spec §3.4) is one, and what a reader
# is shown is its body's source text, cut out of the file and dedented
# (`example_source`). Whether the name lands on a declaration is the
# checker's (`check/decltests`); this only files each body under the name.

use std/str
use std/list
use std/map
use front/lexer
use front/token.{Token}
use front/parser
use front/ast.{
  Module,
  module_fns,
  module_types,
  module_consts,
  module_traits,
  module_effects,
  module_impls,
  module_tests,
  example_spelling,
  e_lo,
  e_hi
}

## 1-based line number of code-point offset `off` (count of line starts <= off).
fn line_of(starts: List[Int], off: Int) -> Int = {
  var n = 0
  var i = 0
  while i < len(starts) && starts[i] <= off {
    n = n + 1
    i = i + 1
  }
  n
}

pub type DocSrc = { starts: List[Int], by_line: Map[Int, Token] }

## Every comment of `text` that opens its line, filed under the 1-based line
## its last character is on. A comment after code on the same line is left
## out, so the line reads as code, which ends a `##` block like any code line.
## The lexer hands comments over in source order, so one sweep over the
## line starts finds every line: `line_of` per comment rescans the starts from
## the top and costs comments x lines, which hover pays on every request
## (docs/lsp-hover-design.md §A3.4).
pub fn doc_src_of(text: String) -> DocSrc = {
  let (cps, _, comments, _) = lexer.lex_with_comments_cps(text)
  let starts = lexer.line_starts_of(text)
  var by_line: Map[Int, Token] = map.empty()
  # the count of line starts <= the current comment's end: `line_of`, kept
  var line = 0
  for c in comments {
    while line < len(starts) && starts[line] <= c.hi { line = line + 1 }
    if opens_line(cps, starts[line - 1], c.lo) { by_line = map.insert(by_line, line, c) }
  }
  DocSrc { starts: starts, by_line: by_line }
}

## Whether only blanks (the lexer's: space, tab, CR) lie between the line
## start `from` and the comment start `lo`. A comment never spans lines, so
## the line its last character is on is the line it starts on.
fn opens_line(cps: List[Char], from: Int, lo: Int) -> Bool = {
  var i = from
  while i < lo && (cps[i] == ' ' || cps[i] == '\t' || cps[i] == '\r') { i = i + 1 }
  i >= lo
}

fn strip_doc_prefix(s: String) -> String = {
  let t = str.drop(s, 2)
  str.strip_prefix(t, " ").unwrap_or(t)
}

## The `##` lines immediately above the declaration starting at `lo`,
## contiguous, joined by \n. A blank line detaches; plain `#` is never a doc.
pub fn doc_of(ds: DocSrc, lo: Int) -> Option[String] = {
  var line = line_of(ds.starts, lo) - 1
  var acc: List[String] = []
  var go = true
  while go {
    match map.get(ds.by_line, line) {
      Some(t) ->
        if str.starts_with(t.text, "##") {
          acc = acc ++ [strip_doc_prefix(t.text)]
          line = line - 1
        } else {
          go = false
        }
      None -> { go = false }
    }
  }
  if len(acc) == 0 { None } else { Some(join(list.reverse(acc), "\n")) }
}

## The 1-based line of the first line of a doc `doc_of` read for the
## declaration starting at `lo`: the block ends on the line above that
## declaration, one source line per doc line.
pub fn doc_first_line(ds: DocSrc, lo: Int, doc: String) -> Int =
  line_of(ds.starts, lo) - len(str.split(doc, "\n"))

## One `` [`name`] `` link in a doc's text (spec §1.2): what is between the
## backticks, and the 0-based line of the doc it sits on.
pub type DocLink = { text: String, line: Int }

## The links of a doc, in the order they are written. A link is `[`, one
## backtick, text with no backtick, one backtick, `]`, on one line; a plain
## code span is never one, and neither is the same spelling followed by `(` or
## `[` (an ordinary Markdown link or reference whose label happens to be code)
## nor, at the start of a line, by `:` (a reference definition). Fenced code
## blocks and code spans are skipped the way a Markdown reader skips them, so
## `[`x`]` inside an example is example text.
pub fn doc_links(doc: String) -> List[DocLink] = {
  var out: List[DocLink] = []
  let lines = str.split(doc, "\n")
  let prose = prose_lines(lines)
  for ln in range(0, len(lines)) {
    if prose[ln] {
      for sp in line_links(code_points(lines[ln])) {
        let (_, _, text) = sp
        out = out ++ [DocLink { text: text, line: ln }]
      }
    }
  }
  out
}

## `doc` with every link rewritten by `f`, which is handed the link's text and
## answers the replacement for the whole `[`text`]`, or None to keep it. The
## same scan as `doc_links`, so what is rewritten is exactly what is a link.
pub fn rewrite_links(doc: String, f: fn(String) -> Option[String]) -> String = {
  let lines = str.split(doc, "\n")
  let prose = prose_lines(lines)
  var out: List[String] = []
  for ln in range(0, len(lines)) {
    let line = lines[ln]
    if not prose[ln] {
      out = out ++ [line]
      continue
    }
    let cs = code_points(line)
    var parts: List[String] = []
    var at = 0
    for sp in line_links(cs) {
      let (lo, hi, text) = sp
      match f(text) {
        Some(to) -> {
          parts = parts ++ [from_code_points(map(range(at, lo), k => cs[k])), to]
          at = hi
        }
        None -> ()
      }
    }
    parts = parts ++ [from_code_points(map(range(at, len(cs)), k => cs[k]))]
    out = out ++ [join(parts, "")]
  }
  join(out, "\n")
}

## Every link in the `##` comments of the module text `text` (spec §1.2):
## the span, in code points of `text`, of the link's text between its
## backticks, and that text. `##` lines on consecutive lines are one doc, so a
## fence opened on one line ends on a later one as `doc_links` reads it. A
## rename rewrites the links that name what it renames
## (docs/lsp-references-design.md §R3).
pub fn doc_link_spans(text: String) -> List[(Int, Int, String)] = {
  let ds = doc_src_of(text)
  var out: List[(Int, Int, String)] = []
  # the doc being read: where each of its lines starts in `text`, past the
  # `##` and the one space after it, and the line
  var block: List[(Int, String)] = []
  var last = -2
  for ln in sort(map.keys(ds.by_line)) {
    let t = map.get(ds.by_line, ln).expect("a comment of the table")
    if ln != last + 1 || not str.starts_with(t.text, "##") {
      out = out ++ block_link_spans(block)
      block = []
    }
    if str.starts_with(t.text, "##") {
      let skip = if str.starts_with(t.text, "## ") { 3 } else { 2 }
      block = block ++ [(t.lo + skip, str.drop(t.text, skip))]
      last = ln
    } else {
      last = -2
    }
  }
  out ++ block_link_spans(block)
}

fn block_link_spans(block: List[(Int, String)]) -> List[(Int, Int, String)] = {
  let prose = prose_lines(map(block, b => {
    let (_, line) = b
    line
  }))
  var out: List[(Int, Int, String)] = []
  for i in range(0, len(block)) {
    if prose[i] {
      let (base, line) = block[i]
      for sp in line_links(code_points(line)) {
        let (lo, hi, text) = sp
        out = out ++ [(base + lo + 2, base + hi - 2, text)]
      }
    }
  }
  out
}

## Which lines of a doc are prose rather than inside a fenced code block (a
## fence line itself is not prose).
##
## A fence is CommonMark's: a run of three or more of one character, `` ` ``
## or `~`, and only a run of the same character at least as long, with
## nothing after it, closes it. A four-backtick fence exists to show a
## three-backtick one inside it; closing it at the inner one turned the rest
## of the example into prose, and its links into names rename rewrote.
fn prose_lines(lines: List[String]) -> List[Bool] = {
  var out: List[Bool] = []
  var fence: Option[(Char, Int)] = None
  for line in lines {
    let t = str.trim_start(line)
    let (c, n) = fence_run(t)
    match fence {
      Some(open) -> {
        let (oc, on) = open
        if n > 0 && c == oc && n >= on && str.trim(str.drop(t, n)) == "" { fence = None }
        out = out ++ [false]
      }
      None ->
        if n > 0 {
          fence = Some((c, n))
          out = out ++ [false]
        } else {
          out = out ++ [true]
        }
    }
  }
  out
}

## The fence `t` starts with: its character and the length of the run, or a
## length of 0 when it starts with none.
fn fence_run(t: String) -> (Char, Int) = {
  let cs = code_points(t)
  if len(cs) == 0 || (cs[0] != '`' && cs[0] != '~') { return (' ', 0) }
  var n = 0
  while n < len(cs) && cs[n] == cs[0] { n = n + 1 }
  if n < 3 { (' ', 0) } else { (cs[0], n) }
}

test "a fence closes only at a run of its own character at least as long" {
  assert prose_lines(["a", "````dawn", "```", "[`x`]", "````", "b"]) == [true, false, false, false, false, true]
  assert prose_lines(["```", "~~~", "x", "```"]) == [false, false, false, false]
  assert prose_lines(["```", "```` trailing", "x", "``` ", "y"]) == [false, false, false, false, true]
}

## The length of the run of backticks at `i`.
fn tick_run(cs: List[Char], i: Int) -> Int = {
  var j = i
  while j < len(cs) && cs[j] == '`' { j = j + 1 }
  j - i
}

## Where a run of exactly `n` backticks starts at or after `from`, or -1.
fn tick_close(cs: List[Char], from: Int, n: Int) -> Int = {
  var i = from
  while i < len(cs) {
    if cs[i] == '`' {
      let r = tick_run(cs, i)
      if r == n { return i }
      i = i + r
    } else {
      i = i + 1
    }
  }
  -1
}

## The links on one line: where each `[` starts, where the span ends (one past
## its `]`), and the text between the backticks.
fn line_links(cs: List[Char]) -> List[(Int, Int, String)] = {
  var out: List[(Int, Int, String)] = []
  var first = 0
  while first < len(cs) && (cs[first] == ' ' || cs[first] == '\t') { first = first + 1 }
  var i = 0
  while i < len(cs) {
    let c = cs[i]
    if c == '\\' {
      i = i + 2
    } else if c == '[' && i + 1 < len(cs) && cs[i + 1] == '`' && tick_run(cs, i + 1) == 1 {
      let close = tick_close(cs, i + 2, 1)
      let shut = close > i + 2 && close + 1 < len(cs) && cs[close + 1] == ']'
      let after: Option[Char] = if shut && close + 2 < len(cs) { Some(cs[close + 2]) } else { None }
      let labelled = after == Some('(') || after == Some('[') || (after == Some(':') && i == first)
      if shut && not labelled {
        out = out ++ [(i, close + 2, from_code_points(map(range(i + 2, close), k => cs[k])))]
        i = close + 2
      } else {
        i = i + 1
      }
    } else if c == '`' {
      let r = tick_run(cs, i)
      let close = tick_close(cs, i + r, r)
      i = if close < 0 { i + r } else { close + r }
    } else {
      i = i + 1
    }
  }
  out
}

## The doc of a member starting at `lo` whose owner starts at `owner_lo`: a
## constructor under its `type`, a field under its constructor. On the owner's
## line it has none, since the block above that line was written about the
## owner; `type Rounding = NearestEven | Up` documents the type, not `Up`, and
## reading it as `Up`'s would publish one block once per constructor. Off the
## owner's line it is `doc_of`, the rule every declaration follows.
pub fn member_doc_of(ds: DocSrc, owner_lo: Int, lo: Int) -> Option[String] =
  if line_of(ds.starts, lo) == line_of(ds.starts, owner_lo) { None } else { doc_of(ds, lo) }

## The 1-based line every top-level declaration starts on, `impl` included:
## an `impl` publishes no doc of its own, but a `##` block right above one is
## written about that impl, not about the module.
fn decl_lines(m: Module, starts: List[Int]) -> List[Int] = {
  var out: List[Int] = []
  for fd in module_fns(m) { out = out ++ [line_of(starts, fd.lo)] }
  for td in module_types(m) { out = out ++ [line_of(starts, td.lo)] }
  for cd in module_consts(m) { out = out ++ [line_of(starts, cd.lo)] }
  for td in module_traits(m) { out = out ++ [line_of(starts, td.lo)] }
  for ed in module_effects(m) { out = out ++ [line_of(starts, ed.lo)] }
  for iv in module_impls(m) { out = out ++ [line_of(starts, iv.lo)] }
  out
}

## The module's own doc: the `##` block that opens the file. It is the one doc
## comment `doc_of` cannot reach — that one reads upward from a declaration,
## and a module has no `lo` to read up from.
##
## The block belongs to the module only if nothing is declared on the line
## right after it. A file that opens with a documented declaration
## (`## Answer questions.` then `pub effect Ask`) has a first-declaration doc,
## not a module doc, and the two must not be the same comment read twice.
pub fn module_doc_of(ds: DocSrc, m: Module) -> Option[String] = {
  var line = 1
  var acc: List[String] = []
  var go = true
  while go {
    match map.get(ds.by_line, line) {
      Some(t) ->
        if str.starts_with(t.text, "##") {
          acc = acc ++ [strip_doc_prefix(t.text)]
          line = line + 1
        } else {
          go = false
        }
      None -> { go = false }
    }
  }
  if len(acc) == 0 || list.contains(decl_lines(m, ds.starts), line) {
    None
  } else {
    Some(join(acc, "\n"))
  }
}

# ---- examples (spec §3.4) ----

## What an example shows: the source of a test body spanning `lo`..`hi` (the
## braces included), as it reads inside the braces. A body on one line is
## that line, trimmed. Otherwise the line the `{` ends and the line the `}`
## starts are dropped when nothing else is on them, every line loses the
## indentation all of its non-blank lines share, blank lines become empty, and
## trailing spaces go. Comments in the body stay: they are part of the example.
pub fn example_source(text: String, lo: Int, hi: Int) -> String = {
  let inner = str.slice(text, lo + 1, hi - 1)
  if not str.contains(inner, "\n") { return str.trim(inner) }
  var lines = map(str.split(inner, "\n"), l => str.trim_end(l))
  if len(lines) > 0 && lines[0] == "" { lines = list.drop(lines, 1) }
  if len(lines) > 0 && lines[len(lines) - 1] == "" { lines = list.take(lines, len(lines) - 1) }
  var common = -1
  for l in lines {
    if l != "" {
      let lead = str.len(l) - str.len(str.trim_start(l))
      if common < 0 || lead < common { common = lead }
    }
  }
  let cut = if common < 0 { 0 } else { common }
  join(map(lines, l => if l == "" { "" } else { str.drop(l, cut) }), "\n")
}

## Every example in `m` (parsed from `text`), filed under the spelling of the
## declaration its test names (`f`, `T`, `T.Ctor`), in the order written.
pub fn module_examples(text: String, m: Module) -> Map[String, List[String]] = {
  var out: Map[String, List[String]] = map.empty()
  for t in module_tests(m) {
    match t.example_of {
      Some(of) -> {
        let key = example_spelling(of)
        let src = example_source(text, e_lo(t.body), e_hi(t.body))
        out = map.insert(out, key, unwrap_or(map.get(out, key), []) ++ [src])
      }
      None -> ()
    }
  }
  out
}

test "an example is its test body's source, inside the braces and dedented" {
  let text = join([
    "pub fn inc(x: Int) -> Int = x + 1",
    "pub type Shape = Circle(r: Int) | Dot",
    "",
    "test inc {",
    "  # one more",
    "  let y = inc(1)",
    "",
    "    assert y == 2   ",
    "}",
    "",
    "test \"not an example\" { assert true }",
    "test inc { assert inc(2) == 3 }",
    "test Shape.Circle {",
    "  assert Circle(1) != Dot }",
    ""
  ], "\n")
  let (m, ds) = parser.parse_module(text)
  assert ds == []
  let ex = module_examples(text, m)
  assert map.get(ex, "inc") == Some(["# one more\nlet y = inc(1)\n\n  assert y == 2", "assert inc(2) == 3"])
  # the `}` shares its line with code, so that line stays
  assert map.get(ex, "Shape.Circle") == Some(["assert Circle(1) != Dot"])
  assert map.get(ex, "Shape") == None
  assert len(map.keys(ex)) == 2
}

test "a documented first declaration is not also the module's doc" {
  # the two readings collide on line 1: `doc_of` reads upward from the
  # declaration and `module_doc_of` reads downward from the top of the file,
  # and without the declaration check they would both claim this comment.
  let attached = "## Answer questions from ambient context.\n" ++
    "pub effect Ask {\n  fn ask(prompt: String) -> Int\n}\n"
  let (m1, d1) = parser.parse_module(attached)
  assert len(d1) == 0
  assert module_doc_of(doc_src_of(attached), m1) == None

  # detached by a blank line, the same comment is the module's
  let detached = "## What this module is for.\n\n" ++
    "pub effect Ask {\n  fn ask(prompt: String) -> Int\n}\n"
  let (m2, d2) = parser.parse_module(detached)
  assert len(d2) == 0
  assert module_doc_of(doc_src_of(detached), m2) == Some("What this module is for.")
}

test "a declaration's doc is the contiguous ## block right above it" {
  let text = join([
    "# a plain comment documents nothing",
    "## First line.",
    "##",
    "##   indented stays indented",
    "fn a() -> Int = 1",
    "",
    "## Detached by the blank line below.",
    "",
    "fn b() -> Int = 2",
    "# plain",
    "fn c() -> Int = 3",
    "##no space after the marker",
    "fn d() -> Int = 4",
    ""
  ], "\n")
  let ds = doc_src_of(text)
  let at = (needle: String) => match str.index_of(text, needle) {
    Some(i) -> i
    None -> panic("no ${needle}")
  }
  assert doc_of(ds, at("fn a")) == Some("First line.\n\n  indented stays indented")
  assert doc_of(ds, at("fn b")) == None
  assert doc_of(ds, at("fn c")) == None
  assert doc_of(ds, at("fn d")) == Some("no space after the marker")
  # any offset on the declaration's first line reads the same block
  assert doc_of(ds, at("a() -> Int")) == doc_of(ds, at("fn a"))
}

test "the sweep files each line-opening comment under the line line_of gives it" {
  let text = "# one\nfn a() -> Int = 1 # two\n\n## three\n  ## four\nfn b() -> Int = 2\n# five"
  let (_, comments, _) = lexer.lex_with_comments(text)
  let ds = doc_src_of(text)
  assert len(comments) == 5
  for c in comments {
    let filed = map.get(ds.by_line, line_of(ds.starts, c.hi))
    if c.text == "# two" { assert filed == None } else { assert filed == Some(c) }
  }
}

test "a ## after code on its line is no doc, of that line or the next" {
  # the two cases the attachment survey reproduced: a one-line declaration,
  # and the last line of a signature split over several lines
  let text = join([
    "pub fn f() -> Int = 1 ## trailing on f",
    "pub fn g() -> Int = 2",
    "## two-line",
    "pub fn h(",
    "  a: Int",
    ") -> Int = a ## end of multiline sig",
    "pub fn k() -> Int = 3",
    "  ## indented, still the first thing on its line",
    "pub fn n() -> Int = 4",
    ""
  ], "\n")
  let ds = doc_src_of(text)
  let at = (needle: String) => match str.index_of(text, needle) {
    Some(i) -> i
    None -> panic("no ${needle}")
  }
  assert doc_of(ds, at("pub fn f")) == None
  assert doc_of(ds, at("pub fn g")) == None
  assert doc_of(ds, at("pub fn h")) == Some("two-line")
  assert doc_of(ds, at("pub fn k")) == None
  assert doc_of(ds, at("pub fn n")) == Some("indented, still the first thing on its line")

  # nor does a trailing ## on line 1 open a module doc
  let first = "pub fn f() -> Int = 1 ## trailing\n\npub fn g() -> Int = 2\n"
  let (m, d) = parser.parse_module(first)
  assert len(d) == 0
  assert module_doc_of(doc_src_of(first), m) == None
}

test "a ## block right above an impl is the impl's, not the module's" {
  let attached = "## How a Box shows.\n" ++
    "impl Show[Box] {\n  fn show(b: Box) -> String = \"box\"\n}\n"
  let (m1, d1) = parser.parse_module(attached)
  assert len(d1) == 0
  assert module_doc_of(doc_src_of(attached), m1) == None

  let detached = "## Boxes.\n\n" ++
    "impl Show[Box] {\n  fn show(b: Box) -> String = \"box\"\n}\n"
  let (m2, d2) = parser.parse_module(detached)
  assert len(d2) == 0
  assert module_doc_of(doc_src_of(detached), m2) == Some("Boxes.")
}

test "a member's doc is the block above its own line, fields included" {
  # constructors, record fields, named constructor fields and trait methods
  # read the same rule a top-level declaration does, from their own `lo`
  let text = join([
    "## A shape.",
    "pub type Shape =",
    "  ## A round one.",
    "  | Circle(",
    "    ## The radius.",
    "    r: Float",
    "  )",
    "  | Dot",
    "",
    "## A point.",
    "pub type Point = {",
    "  ## Across.",
    "  x: Int,",
    "  y: Int",
    "}",
    "",
    "## Things that can be measured.",
    "pub trait Size[T] {",
    "  ## How big.",
    "  fn size(t: T) -> Int",
    "  fn none(t: T) -> Int",
    "}",
    ""
  ], "\n")
  let (m, d) = parser.parse_module(text)
  assert len(d) == 0
  let ds = doc_src_of(text)
  let shape = module_types(m)[0]
  assert doc_of(ds, shape.ctors[0].lo) == Some("A round one.")
  assert doc_of(ds, shape.ctors[0].fields[0].lo) == Some("The radius.")
  # `| Dot` sits under `)`, a code line
  assert doc_of(ds, shape.ctors[1].lo) == None
  let point = module_types(m)[1]
  assert doc_of(ds, point.ctors[0].fields[0].lo) == Some("Across.")
  # the line above `y` is `x`'s, which is code
  assert doc_of(ds, point.ctors[0].fields[1].lo) == None
  let size = module_traits(m)[0]
  assert doc_of(ds, size.methods[0].lo) == Some("How big.")
  assert doc_of(ds, size.methods[1].lo) == None
}

test "a member on its owner's line has no doc of its own" {
  # the block above the `type` line documents the type (spec §1.2): a
  # constructor or field written on that line, or on its constructor's line,
  # has no doc, while `doc_of` alone would read the type's block for it
  let text = join([
    "## Two ways.",
    "pub type T = A | B(n: Int)",
    "",
    "## A pair.",
    "pub type P = { a: Int, b: Int }",
    ""
  ], "\n")
  let (m, d) = parser.parse_module(text)
  assert len(d) == 0
  let ds = doc_src_of(text)
  let t = module_types(m)[0]
  assert doc_of(ds, t.ctors[0].lo) == Some("Two ways.")
  assert member_doc_of(ds, t.lo, t.ctors[0].lo) == None
  assert member_doc_of(ds, t.lo, t.ctors[1].lo) == None
  assert member_doc_of(ds, t.ctors[1].lo, t.ctors[1].fields[0].lo) == None
  let p = module_types(m)[1]
  assert member_doc_of(ds, p.lo, p.ctors[0].lo) == None
  assert member_doc_of(ds, p.ctors[0].lo, p.ctors[0].fields[1].lo) == None
}

test "a link is [`name`] and nothing that merely looks like one" {
  let texts = (d: String) => map(doc_links(d), l => l.text)
  assert texts("See [`list.map`] and [`Option.Some`].") == ["list.map", "Option.Some"]
  # a plain code span, a bracketed word and an ordinary link are not links
  assert texts("`xs[i]` and [i] and [`x`](https://example.org) and [`y`][ref]") == []
  # a code span that holds the spelling is code
  assert texts("write `` [`x`] `` to link") == []
  # a reference definition at the start of a line is not a use, a colon in
  # prose is
  assert texts("[`x`]: #anchor\nsee [`y`]: it") == ["y"]
  # two backticks are a code span inside brackets, not a link
  assert texts("[``a``]") == []
  # fenced code is example text
  assert texts("Before [`a`].\n```dawn\nlet v = xs[`b`]\n```\nAfter [`c`].") == ["a", "c"]
  # the line within the doc is kept, for the error that names it
  assert map(doc_links("one\ntwo [`b`]\n[`c`]"), l => l.line) == [1, 2]
  # an empty pair of backticks is not a link
  assert texts("[``]") == []
}

test "rewriting touches the links and nothing else" {
  let f = (t: String) => {
    let kept: Option[String] = None
    if t == "keep" { kept } else { Some("<" ++ t ++ ">") }
  }
  assert rewrite_links("a [`x`] b [`keep`] c [`y.z`]", f) == "a <x> b [`keep`] c <y.z>"
  # a fenced example and an ordinary link stay as written
  assert rewrite_links("[`x`](u)\n```\n[`x`]\n```\n[`x`]", f) == "[`x`](u)\n```\n[`x`]\n```\n<x>"
}

test "link spans are where each link's text sits in the module" {
  let text = "## See [`scale`] and\n##[`geo.Shape`].\n## ```\n## [`no`]\n## ```\nfn f() = 1 # [`not_doc`]\n  ## [`late`]\n"
  let cs = code_points(text)
  let spans = doc_link_spans(text)
  assert map(spans, sp => {
    let (_, _, t) = sp
    t
  }) == ["scale", "geo.Shape", "late"]
  for sp in spans {
    let (lo, hi, t) = sp
    assert from_code_points(map(range(lo, hi), k => cs[k])) == t
  }
}

test "a doc's first line counts back from its declaration" {
  let text = "## One.\n## Two.\nfn f() -> Int = 1\n"
  let ds = doc_src_of(text)
  let lo = match str.index_of(text, "fn f") {
    Some(i) -> i
    None -> panic("no fn f")
  }
  let d = doc_of(ds, lo).expect("doc")
  assert doc_first_line(ds, lo, d) == 1
}

test "a member off its owner's line reads the block above its own line" {
  let text = join([
    "## A shape.",
    "pub type Shape =",
    "  ## A round one.",
    "  | Circle(r: Float,",
    "    ## The second.",
    "    s: Float)",
    "  | Dot",
    ""
  ], "\n")
  let (m, d) = parser.parse_module(text)
  assert len(d) == 0
  let ds = doc_src_of(text)
  let t = module_types(m)[0]
  let circle = t.ctors[0]
  assert member_doc_of(ds, t.lo, circle.lo) == Some("A round one.")
  # `r` sits on its constructor's line, `s` on its own
  assert member_doc_of(ds, circle.lo, circle.fields[0].lo) == None
  assert member_doc_of(ds, circle.lo, circle.fields[1].lo) == Some("The second.")
  assert member_doc_of(ds, t.lo, t.ctors[1].lo) == None
}

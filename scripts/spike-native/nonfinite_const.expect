-- the three spellings, folded --
Infinity -Infinity NaN
-- folded arithmetic reaching them --
Infinity NaN Infinity
-- signed zero: == cannot see the sign, to_string and / can --
-0.0 0.0 true
-Infinity Infinity
-- a folded const equals the same expression computed at runtime --
true true NaN
-- NaN is unequal to everything, itself included --
false false true false false
-- ordering across the infinities --
true true true true
-- runtime arithmetic on folded non-finite operands --
Infinity NaN NaN Infinity
NaN 0.0 -0.0
-- the spellings round trip through parse_float --
true true

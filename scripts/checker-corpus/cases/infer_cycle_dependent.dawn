# `a` and `b` call each other, so neither return type can be inferred and
# both are reported. `c` only calls `a`: it is checked once the cycle is
# sealed as an error, which keeps it quiet, and it is not reported as
# recursive. The error in `a`'s own body never surfaces, because no attempt
# at checking `a` survives.
fn a(n: Int) = {
  let x: Int = "one"
  if n > 0 { b(n - 1) } else { 0 }
}
fn b(n: Int) = a(n) + 1
fn c() = a(3) + 1

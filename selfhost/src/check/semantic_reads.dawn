  assert project(reads, s => Some(s), t => None, id => Some(id + 10), e => Some(e)) == None
  assert project(reads, s => Some(s), t => Some(t), id => if id == 8 { None } else { Some(id) }, e => Some(e)) == None
  assert project(reads, s => Some(s), t => Some(t), id => if id == 7 { None } else { Some(id) }, e => Some(e)) == None
}


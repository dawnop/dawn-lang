# The search's second asset: the documents' paragraphs, inverted, one JSON
# file per language.
#
# The title index (gen/search.dawn) lets a reader find a section by its
# heading. Everything under the headings -- the spec's rules, the tutorial's
# explanations, the timeline's entries -- was unsearchable: a word that is in
# a paragraph and not in a title found nothing. This file is the generator's
# half of fixing that. The panel's half, which fetches the index the first
# time a reader types and queries it, lives in examples/projects/
# tea_dom_search and is a separate program; the assets between them are
# specified in docs/site-search-design.md, sections 2 and 13, and this file
# writes exactly that.
#
# Three kinds of asset since format 3 (section 13): the manifest, which says
# WHAT EXISTS (the sections, how many paragraphs each has, and the postings
# chunks), the postings chunks, which say WHERE (a run of words in code-point
# order, each with the paragraphs it is in), and one text fragment per section,
# which says WHAT IT SAYS (the section's paragraphs, whole). They grow
# differently and are read differently: a query needs the manifest, the chunks
# of the words it names and the text of only the few rows it shows, so the
# words and the text are fetched as they are needed instead of riding in one
# file. A chunk's and a fragment's names carry a hash of their bytes and the
# manifest names every one, so a change to one section's text changes that
# fragment's URL, the chunks it touches and the manifest's, and nothing else.
#
# The choices that are not obvious from the code, each argued in that
# document:
#
# - A hit lands on a SECTION and shows a PARAGRAPH. Only headings have ids, so
#   only sections can be jumped to; a section is too long to show, so the
#   excerpt is the paragraph the word is in. The postings are therefore
#   (section, paragraph) pairs.
# - The sections are cut at the headings `render_doc` anchors, and the ids are
#   read off the `Doc` that call returns (`heads`) rather than recomputed --
#   the same call over the same blocks (gen/corpus) the page is written from,
#   so a heading counter that changed would change both. gen/links then holds
#   every href in the written asset to the written pages anyway.
# - Chinese is indexed one Han character at a time (gen/search.body_terms).
#   Bigrams would make the Chinese asset bigger than the text it indexes.
# - Positional arrays, never objects, for the reason gen/search.dawn gives:
#   scripts/site-dist-diff.sh compares this file across two backends byte for
#   byte, and an object's key order here is a fact about a hash table.

use std/str
use std/list
use std/char
use std/map
use json/value.{Json, JStr, JArr, JInt}
use json/render.{render}
use json/parser.{parse}
use md/ast.{Inline, Block, Heading, Para, CodeBlock, Fragment, Program, UList, OList, Table, Quote, Rule}
use html/render.{render_doc, inline_text, split_head}
use html/page.{Lang, En, Zh, lang_path}
use gen/common.{pad2}
use gen/corpus.{Corpus, read_corpus}
use gen/tutorial.{split_chapters}
use gen/search.{body_terms, is_han}
use gen/fingerprint.{fingerprint}
use std/bytes
use md/parser
use std/io

## The manifest's format version, its first field. The panel loads no body
## index whose version it does not know, so a change to the format is a change
## here. 2 when the text left the index, 3 when the words and postings left it
## too and became chunks (docs/site-search-design.md section 13).
pub fn body_version() -> Int = 3

## About how many bytes of words and postings, written, one chunk holds: a
## chunk is closed when the next word would take it past this, so a word with
## a longer posting list than this is a chunk of its own. Chosen from the
## sweep in docs/site-search-design.md 13.11: small enough that a query's
## worst case is a few kilobytes of chunks next to the text it fetches, large
## enough that the manifest stays a few kilobytes and a prefix spans few files.
pub fn chunk_target() -> Int = 4000

## The fragment's format version, written nowhere: the fragment is
## `[section, [paragraph, ...]]`, and the index that names it is the one that
## carries the version.

## The columns `c` takes on the panel: 2 for the East Asian Wide and Fullwidth
## characters the documents use (Unicode UAX #11) -- Han, CJK punctuation,
## kana, Hangul syllables and the fullwidth forms -- and 1 for everything else.
## Kept here although the generator no longer cuts excerpts: the panel does, at
## draw time, with the same table (examples/projects/tea_dom_search), and this
## copy is what its test is pinned to.
pub fn columns(c: Char) -> Int = {
  let n = char.code(c)
  if is_han(c) || (n >= 0x3000 && n <= 0x30FF) || (n >= 0xAC00 && n <= 0xD7A3)
    || (n >= 0xFF01 && n <= 0xFF60) || (n >= 0xFFE0 && n <= 0xFFE6) {
    2
  } else {
    1
  }
}

## One section: which document it is in, where it is (site-root relative,
## with its fragment), its title, and the plain text of its paragraphs in
## order. A paragraph's number is its index here.
pub type Section = { doc: String, href: String, title: String, paras: List[String] }

## The whole index, before it is written.
##
## A paragraph that yields at least one word gets an id, counted in (section,
## paragraph) order; `postings[i]` is the ids of the paragraphs `terms[i]`
## occurs in, ascending. `indexed[id]` is the (section, paragraph) pair the id
## stands for, for the tests and for the fragments; the asset writes only how
## many ids each section has (`counts`), the id being a running position.
pub type BodyIndex = {
  sections: List[Section],
  terms: List[String],
  postings: List[List[Int]],
  indexed: List[(Int, Int)],
}

# ---- sections and paragraphs -----------------------------------------------

## `s` with every run of white space one blank and none at either end.
## Paragraphs keep their source line breaks (md/parser joins lines with "\n"),
## and an excerpt is one line of text.
fn squash(s: String) -> String = {
  var out: List[Char] = []
  var gap = false
  for c in code_points(s) {
    if char.is_space(c) {
      gap = len(out) > 0
    } else {
      if gap {
        out = out ++ [' ']
        gap = false
      }
      out = out ++ [c]
    }
  }
  from_code_points(out)
}

fn text_of(items: List[Inline]) -> List[String] = {
  let t = squash(inline_text(items))
  if t == "" { [] } else { [t] }
}

## A table row as one paragraph: its cells, joined the way a reader would
## read them across.
fn row_text(cells: List[List[Inline]]) -> List[String] = {
  let t = squash(join(list.map(cells, c => squash(inline_text(c))), " | "))
  if t == "" { [] } else { [t] }
}

## The paragraphs one block contributes, in order. A list contributes the
## paragraphs inside each of its items, a table one per row, a quote what is
## inside it. Code contributes nothing and takes no number: it is not prose,
## and a row showing it would be a line of a program.
fn paras_of(b: Block) -> List[String] =
  match b {
    Heading(_, items) -> text_of(items)
    Para(items) -> text_of(items)
    CodeBlock(_, _) -> []
    Fragment(_, _) -> []
    Program(_, _, _) -> []
    UList(items) -> items_paras(items)
    OList(items) -> items_paras(items)
    Table(header, rows) -> {
      var out = row_text(header)
      for r in rows {
        out = out ++ row_text(r)
      }
      out
    }
    Quote(bs) -> blocks_paras(bs)
    Rule -> []
  }

fn items_paras(items: List[List[Block]]) -> List[String] = {
  var out: List[String] = []
  for bs in items {
    out = out ++ blocks_paras(bs)
  }
  out
}

fn blocks_paras(bs: List[Block]) -> List[String] = {
  var out: List[String] = []
  for b in bs {
    out = out ++ paras_of(b)
  }
  out
}

## The level of a heading block, 0 for any other block.
fn level_of(b: Block) -> Int =
  match b {
    Heading(lvl, _) -> lvl
    _ -> 0
  }

## One page, cut into sections: the page's lead (everything before its first
## anchored heading; href is the page itself, title the page's), then one per
## heading `render_doc` gave an id.
##
## `body` must be the very blocks the page renders, and they are rendered here
## once more only to read their ids: `render_doc` anchors every top-level
## heading of level 2 and deeper, in order, and `heads` lists them in that
## order, so the k-th such heading met below is `heads[k]`. A mismatch is a
## renderer that changed which headings it anchors, and stops the build
## rather than writing fragments that name the wrong sections.
pub fn page_sections(doc: String, page: String, title: String, body: List[Block]) -> List[Section] = {
  let heads = render_doc(body, u => u).heads
  var out: List[Section] = []
  var href = page
  var name = title
  var paras: List[String] = []
  var k = 0
  for b in body {
    if level_of(b) >= 2 {
      out = out ++ [Section { doc: doc, href: href, title: name, paras: paras }]
      if k >= len(heads) {
        panic("${page}: heading ${k + 1} has no id from render_doc")
      }
      href = "${page}#${heads[k].id}"
      name = heads[k].text
      paras = []
      k = k + 1
    } else {
      paras = paras ++ paras_of(b)
    }
  }
  if k != len(heads) {
    panic("${page}: render_doc anchored ${len(heads)} headings, the body index found ${k}")
  }
  out ++ [Section { doc: doc, href: href, title: name, paras: paras }]
}

## A spec-like document: its `#` title and translation note come off the
## front exactly as gen/pages.doc_page takes them, and the rest is the page.
fn doc_sections(doc: String, page: String, blocks: List[Block]) -> List[Section] = {
  let parts = split_head(blocks)
  page_sections(doc, page, squash(inline_text(parts.title)), parts.body)
}

## The tutorial: one page per `##` chapter, split by the function
## gen/tutorial splits the pages with. The contents page has no prose of its
## own beyond the list of chapters, and is not indexed.
fn tutorial_sections(blocks: List[Block], lang: Lang) -> List[Section] = {
  let (_, chapters) = split_chapters(blocks)
  var out: List[Section] = []
  for i in range(0, len(chapters)) {
    let page = lang_path(lang, "tutorial/${pad2(i + 1)}.html")
    out = out ++ page_sections("tutorial", page, squash(inline_text(chapters[i].title)), chapters[i].body)
  }
  out
}

## Every section of one language's four documents, in the order the asset
## numbers them: the spec, the timeline, the early design notes, the tutorial.
pub fn body_sections(c: Corpus, lang: Lang) -> List[Section] =
  doc_sections("spec", lang_path(lang, "spec.html"), c.spec)
  ++ doc_sections("history", lang_path(lang, "history.html"), c.history)
  ++ doc_sections("design", lang_path(lang, "design.html"), c.design)
  ++ tutorial_sections(c.tutorial, lang)

# ---- the index -------------------------------------------------------------

## Invert the sections' paragraphs. Each paragraph's words are taken once;
## walking the paragraphs in (section, paragraph) order makes every posting
## list ascending without a sort. The terms are sorted by code point, which is
## the order the panel binary-searches in.
pub fn build_index(sections: List[Section]) -> BodyIndex = {
  let none: List[Int] = []
  var post: Map[String, List[Int]] = map.empty()
  var indexed: List[(Int, Int)] = []
  for si in range(0, len(sections)) {
    let ps = sections[si].paras
    for pi in range(0, len(ps)) {
      let words = list.unique(body_terms(ps[pi]))
      if len(words) > 0 {
        let id = len(indexed)
        indexed = indexed ++ [(si, pi)]
        for w in words {
          post = map.insert(post, w, unwrap_or(map.get(post, w), none) ++ [id])
        }
      }
    }
  }
  let table = post
  let terms = list.map(list.sort(list.map(map.keys(table), t => code_points(t))), cs => from_code_points(cs))
  BodyIndex {
    sections: sections,
    terms: terms,
    postings: list.map(terms, t => unwrap_or(map.get(table, t), none)),
    indexed: indexed,
  }
}

fn quoted(s: String) -> String = render(JStr(value: s))

## Ascending ids as gaps: the first id, then each one's distance from the one
## before. Common words occur in paragraph after paragraph, so most gaps are
## one or two digits; written whole, the English postings were 54 KB gzipped,
## as gaps 41 (docs/site-search-design.md 6).
pub fn gaps(ids: List[Int]) -> List[Int] = {
  var out: List[Int] = []
  var prev = 0
  for id in ids {
    out = out ++ [id - prev]
    prev = id
  }
  out
}

## How many ids section `si` has: its indexed paragraphs, which are a run in
## `indexed` because the ids are counted in section order.
fn counts_of(ix: BodyIndex) -> List[Int] = {
  var out: List[Int] = []
  for si in range(0, len(ix.sections)) {
    var n = 0
    for e in ix.indexed {
      let (s, _) = e
      if s == si {
        n = n + 1
      }
    }
    out = out ++ [n]
  }
  out
}

## The text of section `si`: the paragraphs that have an id, whole and in id
## order, so that the n-th of them is the section's n-th id. Empty for a
## section with no indexed paragraph, which has no fragment.
fn texts_of(ix: BodyIndex, si: Int) -> List[String] = {
  var out: List[String] = []
  for e in ix.indexed {
    let (s, pi) = e
    if s == si {
      out = out ++ [ix.sections[si].paras[pi]]
    }
  }
  out
}

## One fragment as it is written: `[section, [paragraph, ...]]`. The section
## number is there so that the panel can refuse a file that is not the one it
## asked for (a stale cache, a bad rewrite) instead of showing another
## section's text under this section's title.
pub fn fragment_json(si: Int, texts: List[String]) -> String =
  "[${si},[" ++ join(list.map(texts, t => quoted(t)), ",") ++ "]]"

## The name of language `lang`'s fragment directory under /assets/.
pub fn text_dir(lang: Lang) -> String =
  match lang {
    En -> "search-text/en"
    Zh -> "search-text/zh"
  }

## One written fragment: the section it holds and the file's bytes (with the
## newline every text asset ends in; the hash is of these bytes, so the name
## follows the file exactly as gen/fingerprint promises). `hash` is the middle
## of the fingerprinted name; the file is `<section>.<hash>.json` in the
## language's fragment directory.
pub type TextFragment = { sec: Int, hash: String, text: String }

fn fragments_of(ix: BodyIndex) -> List[TextFragment] = {
  var out: List[TextFragment] = []
  for si in range(0, len(ix.sections)) {
    let texts = texts_of(ix, si)
    if len(texts) > 0 {
      let text = fragment_json(si, texts) ++ "\n"
      let named = fingerprint("${si}.json", bytes.utf8(text))
      # `<section>.<hash>.json`: the hash is the middle part
      out = out ++ [TextFragment { sec: si, hash: str.split(named, ".")[1], text: text }]
    }
  }
  out
}

## The file name of a fragment, relative to /assets/.
pub fn fragment_path(lang: Lang, f: TextFragment) -> String = "${text_dir(lang)}/${f.sec}.${f.hash}.json"

## The name of language `lang`'s postings chunk directory under /assets/.
pub fn chunk_dir(lang: Lang) -> String =
  match lang {
    En -> "search-index/en"
    Zh -> "search-index/zh"
  }

## One written chunk: its position, the first word it holds, and the file's
## bytes. Chunk `n` holds the words from its `first` up to, and not including,
## the next chunk's `first` (the last chunk holds the rest), so a word is found
## by the manifest alone and a chunk does not say where it ends. The file is
## `[n, [word, ...], [[gap, ...], ...]]` -- the position repeated for the same
## reason a fragment repeats its section -- in the language's chunk directory
## as `<n>.<hash>.json`, the hash being the fingerprint of these bytes.
pub type PostingChunk = { n: Int, first: String, hash: String, text: String }

## How many bytes a word and its postings take written, the measure the chunks
## are cut by. It leaves out one separator per word, so a written chunk is a
## little over the target (never by more than a byte a word): the target is a
## way of choosing a size, and 13.11 reports the sizes that came out.
fn entry_size(term: String, gs: List[Int]) -> Int =
  str.len(quoted(term)) + str.len(join(list.map(gs, g => "${g}"), ",")) + 3

fn chunk_text(n: Int, terms: List[String], gaps_of_terms: List[List[Int]]) -> String =
  "[${n},[" ++ join(list.map(terms, t => quoted(t)), ",") ++ "],["
  ++ join(list.map(gaps_of_terms, gs => "[" ++ join(list.map(gs, g => "${g}"), ",") ++ "]"), ",") ++ "]]\n"

fn chunks_of(ix: BodyIndex) -> List[PostingChunk] = {
  var out: List[PostingChunk] = []
  var terms: List[String] = []
  var gs: List[List[Int]] = []
  var size = 0
  for i in range(0, len(ix.terms)) {
    let g = gaps(ix.postings[i])
    let e = entry_size(ix.terms[i], g)
    if len(terms) > 0 && size + e > chunk_target() {
      out = out ++ [close_chunk(len(out), terms, gs)]
      terms = []
      gs = []
      size = 0
    }
    terms = terms ++ [ix.terms[i]]
    gs = gs ++ [g]
    size = size + e
  }
  if len(terms) > 0 {
    out = out ++ [close_chunk(len(out), terms, gs)]
  }
  out
}

fn close_chunk(n: Int, terms: List[String], gs: List[List[Int]]) -> PostingChunk = {
  let text = chunk_text(n, terms, gs)
  let named = fingerprint("${n}.json", bytes.utf8(text))
  PostingChunk { n: n, first: terms[0], hash: str.split(named, ".")[1], text: text }
}

## The file name of a chunk, relative to /assets/.
pub fn chunk_path(lang: Lang, c: PostingChunk) -> String = "${chunk_dir(lang)}/${c.n}.${c.hash}.json"

## The manifest's bytes, docs/site-search-design.md 13.4:
## `[version, fragment_dir, sections, counts, chunk_dir, chunks]`, a section
## being `[doc, href, title, fragment_hash]` with `""` for a section that has
## no fragment, `counts[s]` the number of ids section `s` holds, and a chunk
## `[first_word, hash]`, in order.
pub fn index_json(ix: BodyIndex, lang: Lang, frags: List[TextFragment], chunks: List[PostingChunk]) -> String = {
  var sections: List[String] = []
  for si in range(0, len(ix.sections)) {
    let s = ix.sections[si]
    var hash = ""
    for f in frags {
      if f.sec == si {
        hash = f.hash
      }
    }
    sections = sections
      ++ ["[" ++ quoted(s.doc) ++ "," ++ quoted(s.href) ++ "," ++ quoted(s.title) ++ "," ++ quoted(hash) ++ "]"]
  }
  let counts = list.map(counts_of(ix), c => "${c}")
  let rows = list.map(chunks, c => "[" ++ quoted(c.first) ++ "," ++ quoted(c.hash) ++ "]")
  "[${body_version()}," ++ quoted(text_dir(lang)) ++ ",[" ++ join(sections, ",") ++ "],[" ++ join(counts, ",") ++ "],"
    ++ quoted(chunk_dir(lang)) ++ ",[" ++ join(rows, ",") ++ "]]"
}

## One language's body search, as the bytes that go into /assets/: the
## manifest, the chunks of words and postings it names, and the text fragments
## it names.
pub type BodyAssets = { index: String, chunks: List[PostingChunk], fragments: List[TextFragment] }

pub fn search_body(c: Corpus, lang: Lang) -> BodyAssets = {
  let ix = build_index(body_sections(c, lang))
  let frags = fragments_of(ix)
  let chunks = chunks_of(ix)
  BodyAssets { index: index_json(ix, lang, frags, chunks), chunks: chunks, fragments: frags }
}

# ---- tests -----------------------------------------------------------------

fn md(src: String) -> List[Block] =
  match parser.parse(src) {
    Ok(bs) -> bs
    Err(e) -> panic("the test document must parse: ${e}")
  }

## The fragment of an href, or "".
fn frag(href: String) -> String =
  match str.split(href, "#") {
    [_, f] -> f
    _ -> ""
  }

## The index's first field, and the shape around it.
test "the manifest is version 3, positional, and holds neither text nor words" {
  let secs = page_sections("spec", "spec.html", "Spec", md("## One\n\nA word.\n"))
  let ix = build_index(secs)
  let frags = fragments_of(ix)
  let chunks = chunks_of(ix)
  let text = index_json(ix, En, frags, chunks)
  assert body_version() == 3
  assert ix.terms == ["a", "word"]
  assert ix.postings == [[0], [0]]
  assert ix.indexed == [(1, 0)]
  assert len(frags) == 1
  assert frags[0].sec == 1
  # two words and their postings fit one chunk, which the manifest names by
  # its first word and hash; the words themselves are in the chunk only
  assert len(chunks) == 1
  assert chunks[0].first == "a"
  assert chunks[0].text == "[0,[\"a\",\"word\"],[[0],[0]]]\n"
  assert str.starts_with(text, "[3,\"search-text/en\",[[\"spec\",\"spec.html\",\"Spec\",\"\"],[\"spec\",\"spec.html#s1\",\"One\",\"${frags[0].hash}\"]],")
  assert str.ends_with(text, ",[0,1],\"search-index/en\",[[\"a\",\"${chunks[0].hash}\"]]]")
  assert chunk_path(Zh, chunks[0]) == "search-index/zh/0.${chunks[0].hash}.json"
  # the paragraph is in the fragment and nowhere in the manifest or a chunk
  assert frags[0].text == "[1,[\"A word.\"]]\n"
  assert not str.contains(text, "A word.")
  assert not str.contains(text, "\"word\"")
  assert fragment_path(En, frags[0]) == "search-text/en/1.${frags[0].hash}.json"
  assert fragment_path(Zh, frags[0]) == "search-text/zh/1.${frags[0].hash}.json"
  # postings are written as gaps
  assert gaps([3, 4, 9, 10]) == [3, 1, 5, 1]
  let two = build_index(page_sections("spec", "spec.html", "Spec", md("A b.\n\nC.\n\nA.\n")))
  assert two.postings[0] == [0, 2]
  assert str.contains(chunks_of(two)[0].text, "[[0,2],")
}

## The fragment's name follows its bytes: the same text is the same name, a
## changed paragraph is another, and a section with nothing indexed has none.
test "a fragment is named by its content and a section without text has none" {
  let a = build_index(page_sections("spec", "spec.html", "Spec", md("Lead.\n\n## One\n\nA word.\n\n## Two\n\n```dawn\nlet x = 1\n```\n")))
  let b = build_index(page_sections("spec", "spec.html", "Spec", md("Lead.\n\n## One\n\nA word!\n\n## Two\n\n```dawn\nlet x = 1\n```\n")))
  let fa = fragments_of(a)
  let fb = fragments_of(b)
  # the lead and `One` have text, `Two` is only code
  assert list.map(fa, f => f.sec) == [0, 1]
  assert fa[0].hash == fb[0].hash
  assert fa[1].hash != fb[1].hash
  assert str.len(fa[0].hash) == 8
  assert counts_of(a) == [1, 1, 0]
  assert str.contains(index_json(a, En, fa, chunks_of(a)), ",\"Two\",\"\"]")
}

## A section is a page's lead plus one per anchored heading, h4 included, and
## each fragment is an id the rendered page carries.
test "a section's href is an anchor render_doc wrote on the page" {
  let body = md("Lead.\n\n## Two\n\nx\n\n### Two one\n\ny\n\n#### Deep\n\nz\n\n## Three\n")
  let secs = page_sections("spec", "spec.html", "Spec", body)
  assert list.map(secs, s => s.href)
    == ["spec.html", "spec.html#s1", "spec.html#s1-1", "spec.html#s1-1-1", "spec.html#s2"]
  assert list.map(secs, s => s.title) == ["Spec", "Two", "Two one", "Deep", "Three"]
  assert list.map(secs, s => s.paras) == [["Lead."], ["x"], ["y"], ["z"], []]
  let html = render_doc(body, u => u).html
  for s in secs {
    if frag(s.href) != "" {
      assert str.contains(html, " id=\"${frag(s.href)}\"")
    }
  }
}

## The same, on the documents that ship: every fragment the body index writes
## for a page is an id that page's own render of the same blocks carries.
test "every body section on the real documents names an id its page renders" {
  io.with_fs_real(() => {
    for lang in [En, Zh] {
      let c = read_corpus(lang)
      let secs = body_sections(c, lang)
      let pages = [
        (lang_path(lang, "spec.html"), render_doc(split_head(c.spec).body, u => u).html),
        (lang_path(lang, "history.html"), render_doc(split_head(c.history).body, u => u).html),
        (lang_path(lang, "design.html"), render_doc(split_head(c.design).body, u => u).html),
      ]
      var checked = 0
      for s in secs {
        for p in pages {
          let (page, html) = p
          if str.starts_with(s.href, page ++ "#") {
            assert str.contains(html, " id=\"${frag(s.href)}\"")
            checked = checked + 1
          }
        }
      }
      assert checked > 50
    }
  })
}

## Code is neither indexed nor written to a fragment, and takes no paragraph number: the
## paragraph after a code block is the next number, not the one after next.
test "code blocks stay out of the index" {
  let body = md("## S\n\nBefore.\n\n```dawn\nlet zzcode = 1\n```\n\n```output\nzzout\n```\n\n- item zzitem\n\n| h | k |\n|---|---|\n| zzcell | v |\n")
  let secs = page_sections("tutorial", "tutorial/01.html", "T", body)
  assert secs[1].paras == ["Before.", "item zzitem", "h | k", "zzcell | v"]
  let ix = build_index(secs)
  assert not list.contains(ix.terms, "zzcode")
  assert not list.contains(ix.terms, "zzout")
  assert list.contains(ix.terms, "zzitem")
  assert list.contains(ix.terms, "zzcell")
  for f in fragments_of(ix) {
    assert not str.contains(f.text, "zzcode")
  }
}

## The width table the panel draws excerpts with: Han, CJK and fullwidth
## punctuation are two columns, ASCII one (docs/site-search-design.md 6.5). The
## panel keeps its own copy of the cut itself; this pins the table.
test "the column widths are East Asian wide for Han and fullwidth forms" {
  assert columns('a') == 1
  assert columns(' ') == 1
  assert columns('é') == 1
  assert columns('效') == 2
  assert columns('，') == 2
  assert columns('。') == 2
  assert columns('「') == 2
}

## A tiny deterministic generator, so that "twenty terms at random" is the
## same twenty terms on every run and on both backends.
fn next_seed(x: Int) -> Int = (x * 1103515245 + 12345) % 2147483648

## The inversion, checked from the far end: pick terms, follow every posting,
## and the paragraph it names must yield that term. Also that the terms are
## sorted and unique, that the postings ascend, and that every id's text is in
## its section's fragment at its position.
test "every posting of a sampled term points at a paragraph that has the term" {
  io.with_fs_real(() => {
    for lang in [En, Zh] {
      let ix = build_index(body_sections(read_corpus(lang), lang))
      assert len(ix.terms) == len(ix.postings)
      assert len(ix.terms) > 1000
      var seed = 20261002
      for _ in range(0, 20) {
        seed = next_seed(seed)
        let i = seed % len(ix.terms)
        let t = ix.terms[i]
        assert len(ix.postings[i]) > 0
        for id in ix.postings[i] {
          let (s, q) = ix.indexed[id]
          assert list.contains(body_terms(ix.sections[s].paras[q]), t)
        }
      }
      # the ids count paragraphs in (section, paragraph) order
      for id in range(1, len(ix.indexed)) {
        let (a, b) = ix.indexed[id - 1]
        let (c, d) = ix.indexed[id]
        assert a < c || (a == c && b < d)
      }
      for i in range(1, len(ix.terms)) {
        assert cmp(code_points(ix.terms[i - 1]), code_points(ix.terms[i])) < 0
      }
      for ps in ix.postings {
        for j in range(1, len(ps)) {
          assert ps[j - 1] < ps[j]
        }
      }
      # the counts add up to the ids, and a fragment is as long as its count
      let counts = counts_of(ix)
      assert list.fold(counts, 0, (acc, n) => acc + n) == len(ix.indexed)
      for f in fragments_of(ix) {
        assert len(texts_of(ix, f.sec)) == counts[f.sec]
        assert counts[f.sec] > 0
      }
      # Chinese is there one character at a time, and so is the ASCII in it
      if lang == Zh {
        assert list.contains(ix.terms, "效")
        assert list.contains(ix.terms, "handler")
      }
    }
  })
}

## Chunking is a re-cut of the same words and postings and nothing else: read
## back, the chunks are the whole word list in order with every posting list
## intact, each starts at the first word the manifest says, none is larger than
## the target unless it is a single word, and the manifest names them all.
test "the chunks of the real documents are the word list, cut in order" {
  io.with_fs_real(() => {
    for lang in [En, Zh] {
      let ix = build_index(body_sections(read_corpus(lang), lang))
      let chunks = chunks_of(ix)
      var at = 0
      var n = 0
      for c in chunks {
        assert c.n == n
        assert str.len(c.hash) == 8
        match parse(c.text) {
          Ok(JArr(fs)) -> {
            assert fs[0] == JInt(value: n)
            let terms = jarr_strs(fs[1])
            let posts = jarr_gaps(fs[2])
            assert len(terms) > 0 && len(terms) == len(posts)
            assert terms[0] == c.first
            if len(terms) > 1 {
              assert str.len(c.text) <= chunk_target() + len(terms) + 40
            }
            for i in range(0, len(terms)) {
              assert terms[i] == ix.terms[at + i]
              assert posts[i] == gaps(ix.postings[at + i])
            }
            at = at + len(terms)
          }
          _ -> panic("a chunk is an array")
        }
        n = n + 1
      }
      assert at == len(ix.terms)
      assert len(chunks) > 10
      let manifest = index_json(ix, lang, fragments_of(ix), chunks)
      for c in chunks {
        assert str.contains(manifest, "[${quoted(c.first)},${quoted(c.hash)}]")
      }
    }
  })
}

fn jarr_strs(j: Json) -> List[String] =
  match j {
    JArr(items) -> list.map(items, x => match x {
      JStr(value) -> value
      _ -> panic("a word is a string")
    })
    _ -> panic("words are an array")
  }

fn jarr_gaps(j: Json) -> List[List[Int]] =
  match j {
    JArr(rows) -> list.map(rows, r => match r {
      JArr(items) -> list.map(items, x => match x {
        JInt(value) -> value
        _ -> panic("a gap is an integer")
      })
      _ -> panic("a posting is an array")
    })
    _ -> panic("postings are an array")
  }

## The two languages' section tables line up one for one, which is what lets
## a reader switch languages and land on the same section: the same number of
## sections, from the same documents, at the same addresses under `zh/`.
test "the two languages have the same sections" {
  io.with_fs_real(() => {
    let en = body_sections(read_corpus(En), En)
    let zh = body_sections(read_corpus(Zh), Zh)
    assert len(en) == len(zh)
    for i in range(0, len(en)) {
      assert en[i].doc == zh[i].doc
      assert "zh/" ++ en[i].href == zh[i].href
    }
  })
}

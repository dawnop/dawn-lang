# The checker's type representation (P3b step 1; port of check/Types.kt per
# docs/selfhost-checker.md §二). Kotlin's identity-equality objects become
# id-carrying records: TyVar/EffVar compare by id, TyAdt points into an ADT
# table (Map[Int, AdtI]) instead of holding a cyclic object reference, and
# display strings are rendered on demand (ty_show needs the table for names).
#
# Fixed prelude ids (never minted by the checker's counter, which opens past
# all of them -- see first_minted_id):
#   ADTs:   Option = 0, Result = 1, ForeignError = 2
#   traits: Ord = 0, Eq = 1, Hash = 2, Show = 3, Iter = 4
#   type vars: builtin-signature T/U/A/K/V/B = -1..-6, Ord's T = -10,
#              Option's T = -11, Result's T/E = -12/-13, Eq's T = -14,
#              Hash's T = -15, Show's T = -16, Iter's T = -17
#   effect vars: the builtin signatures' `e` = -1
#
# ADT ids and trait ids are separate namespaces (Option and Ord are both 0) that
# happen to share one counter, so reserving two more trait ids costs two ADT ids.

use std/map
use std/list
use std/set
use std/str

# ---- effects (spec §6) ----

pub type Eff =
  | EPure
  | EIo
  | EffVar(name: String, id: Int)
# A normalized union of base-axis atoms: effect variables (sorted by id) and
# associated-effect projections (sorted by (tvar, trait_id, name)), plus an io
# flag. io absorbs neither: a variable and a projection each stand for evidence
# the way a label does, and an absorbed one would have no parameter to arrive
# through, so `EUnion([(3, "e")], [], true)` is a normal form rather than a
# shape to reduce (see `base_union`, which used to absorb the variables and
# lost a pack entry doing it). Invariant: a union that could be a smaller shape
# is that shape (one atom and no io is the atom itself, io alone is EIo), so
# every row that existed before projections still has the representation it had.
  | EUnion(vars: List[(Int, String)], assocs: List[(String, Int, Int, String)], io: Bool)
# An associated-effect projection `C.E` (docs/effect-params-design.md 刀 5):
# the effect an impl binds for the trait member `name`, read off the impl
# chosen for the subject. The subject is *only ever* a rigid type variable
# with a bound on `trait_id` -- it is stored as (display name, tvar id) so Eff
# never contains a Ty, which is what keeps type/effect substitution from
# becoming mutually recursive. Canonical-form invariant (the TyAssoc twin): a
# ground row never contains one -- reduction is eager (D3), so a projection
# only survives while its subject is still rigid. `eff_is_ground` is the
# question; the walls downstream of reduction are new with this constructor,
# because the effect axis had none (every accessor ended in a wildcard).
  | EffAssoc(subject: String, tvar: Int, trait_id: Int, name: String)
# The second axis (docs/effects-design.md §4.1): a base row -- one of the five
# constructors above, never this one -- plus a non-empty, id-sorted set of
# declared effects. Labels are a component of the normal form, not a member of
# the base lattice, and io absorbs one no more than it absorbs a variable:
# evidence is synthesised per label and an absorbed one has no parameter to
# arrive through. `labels` empty is not representable: the normal
# form is then the base alone, which is what keeps every label-free program's
# behaviour byte-identical to what it was before labels existed.
  | ELabeled(base: Eff, labels: List[(Int, String)])

fn union_has(vs: List[(Int, String)], id: Int) -> Bool = {
  for v in vs {
    let (vid, _) = v
    if vid == id { return true }
  }
  false
}

fn by_id(vs: List[(Int, String)]) -> List[(Int, String)] =
  sort_by(vs, (a, b) => {
    let (ia, _) = a
    let (ib, _) = b
    ia - ib
  })

## The projection atoms' one ordering: subject tvar id, then trait id, then
## member name. It is the normal form's sort *and* the evidence layout's order
## (the label axis's id-sort, replayed on the projection axis), so the checker,
## lowering and both backends read the same list without consulting a table.
fn by_assoc(atoms: List[(String, Int, Int, String)]) -> List[(String, Int, Int, String)] =
  sort_by(atoms, (a, b) => {
    let (_, va, ta, na) = a
    let (_, vb, tb, nb) = b
    if va != vb {
      va - vb
    } else if ta != tb {
      ta - tb
    } else if na < nb {
      0 - 1
    } else if na == nb {
      0
    } else {
      1
    }
  })

fn assoc_has(atoms: List[(String, Int, Int, String)], v: Int, t: Int, n: String) -> Bool = {
  for a in atoms {
    let (_, av, at2, an) = a
    if av == v && at2 == t && an == n { return true }
  }
  false
}

## The base row: the effect with its labels taken off.
pub fn eff_base(e: Eff) -> Eff =
  match e {
    ELabeled(b, _) -> b
    _ -> e
  }

## The declared effects in this row, id-sorted (empty for a bare base).
pub fn eff_labels(e: Eff) -> List[(Int, String)] =
  match e {
    ELabeled(_, ls) -> ls
    _ -> []
  }

## `Sig.eparams` out of the table a signature's resolution filled: the effect
## variables it introduced, id-sorted.
##
## The order is the contract, because a renderer will read this list back. The
## table is `Cx.current_eff_vars`, keyed by name, so it carries no order of its
## own -- iterating a Map would hand back HAMT order, which is a hash of the
## spelling. The ids do carry one. `resolve_eff_at` mints an id through `fresh`
## at the moment it first meets a name and never again, and `fresh` hands ids
## out in ascending order, so sorting by id replays the order the resolver met
## the names, once each. That order is the declared row, then the parameter
## types left to right, then the return type -- first encounter, which is not
## quite first *appearance*, since the row is written last.
##
## Every caller hands in a table that started empty at the signature it is
## resolving; a table carried in from an enclosing scope would put ids from
## elsewhere in front, and there is no such caller.
##
## An explicit binder list (`fn map[T, U, !e]`) mints before the row does, in
## the order it is written, so it takes the front of the same ordering rather
## than a second rule. A signature that lists its binders in the order the
## resolver would have met them gets exactly the list it would have got with no
## binders at all -- that equivalence is decision 2, and it is what makes the
## binders optional (docs/effect-params-design.md).
##
## Sorting by id is also how the label axis is kept in order (`eff_labels`,
## which `bind_evidence` and `ev_sym_list` walk to lay out evidence). This is
## the same discipline on the variable axis.
pub fn eff_params_of(evs: Map[String, Eff]) -> List[Eff] = {
  var ids: List[(Int, String)] = []
  for e in map.values(evs) {
    match e {
      EffVar(n, id) -> { ids = ids ++ [(id, n)] }
      _ -> ()
    }
  }
  var out: List[Eff] = []
  for p in by_id(ids) {
    let (id, n) = p
    out = out ++ [EffVar(n, id)]
  }
  out
}

## The effect variables of this row, id-sorted — `eff_labels`' opposite number
## on the base axis. A row mentions a variable in exactly two shapes, `EffVar`
## and `EUnion`, and anything that walks one and forgets the other is the
## SEM-02 defect: forgetting `EUnion` is silent, because a union of variables
## renders and compares like a plausible effect.
pub fn eff_vars(e: Eff) -> List[(Int, String)] =
  match eff_base(e) {
    EffVar(n, id) -> [(id, n)]
    EUnion(vs, _, _) -> vs
    _ -> []
  }

## The associated-effect projections of this row, in `by_assoc` order -- the
## third accessor beside `eff_vars` and `eff_labels`, and like them the walk
## that decides what a consumer sees. Evidence slots for projections follow
## exactly this list (after the written labels' slots), so this order is a
## contract the same way `eff_params_of`'s is.
pub fn eff_assocs(e: Eff) -> List[(String, Int, Int, String)] =
  match eff_base(e) {
    EffAssoc(s, v, t, n) -> [(s, v, t, n)]
    EUnion(_, atoms, _) -> atoms
    _ -> []
  }

## How many hidden evidence arguments a **named** callee's row is worth: one
## per written label (rule 甲), one per effect variable (rule 丁), one per
## associated-effect projection (rule 丙), in that order. The base -- pure or
## io -- is an answer rather than a question, so it takes no slot.
##
## This is the named half of the convention only. A function *value* is not
## sized by its row at all (`fn_arity`): its evidence rides in one pack, and
## the two halves meet at `lower.lift_fn_value`'s wrapper.
##
## **One definition, three readers** on the named side: the parameters
## `checker.bind_evidence` declares, the arguments `checker.check_call`
## appends, and the descriptors `jvm/emit` spells for a direct call and for a
## trait interface. Every one of them decides how many words cross a boundary,
## so two of them counting separately is an arity drift that no type error
## catches: the JVM answers NoSuchMethodError and native reads the slot next
## door. Hence a second derivation anywhere is a defect, not an optimisation.
pub fn nev(e: Eff) -> Int =
  len(eff_labels(e)) + len(eff_vars(e)) + len(eff_assocs(e))

## The key an atom is addressed by inside an evidence pack.
##
## A pack is a chain keyed by atom, not a vector ordered by position, which is
## the whole reason a row may hold two labels behind one variable without the
## runtime having to merge and reorder anything (design 裁决背景 1). The three
## axes mint their ids from different counters -- an effect id is program-wide,
## an effect variable's id is its position in its own signature's binder list
## (`eff_params_of`), a projection's identity is a triple -- so a key is banded
## by axis rather than taken raw, or a variable in position 3 would answer to
## the third effect ever declared.
##
## Nothing reads a key yet: under the representation knife a pack is built and
## never queried. It is built with the real keys all the same, because a pack
## whose nodes were interchangeable would not be the thing being measured.
pub fn atom_keys(e: Eff) -> List[Int] = {
  var out: List[Int] = []
  for l in eff_labels(e) {
    let (eid, _) = l
    out = out ++ [label_key(eid)]
  }
  for v in eff_vars(e) {
    let (vid, _) = v
    out = out ++ [var_key(vid)]
  }
  for a in eff_assocs(e) {
    let (_, _, tid, _) = a
    out = out ++ [assoc_key(tid)]
  }
  out
}

## One atom's key on its own, per axis. `atom_keys` walks a row; a caller that
## already has a single atom in hand -- `checker.evidence_pack` consing a node
## per ground label, `checker.bind_evidence` stamping the key onto the slot it
## declares -- asks here instead of re-deriving the band, for the same reason
## `nev` is the only place the slot count is computed. The bands were spelled
## inline in `atom_keys` and nowhere else while nothing but `atom_keys` needed
## them; three readers is where a second spelling starts to drift.
pub fn label_key(eid: Int) -> Int = 3 * eid

pub fn var_key(vid: Int) -> Int = 3 * vid + 1

pub fn assoc_key(tid: Int) -> Int = 3 * tid + 2

## Reading a key back. A pack node's key is always a label's -- a ground atom
## is the only thing a pack conses a node for -- but a *slot* is addressed by
## any of the three, and `lower.ev_slot` has to tell "walk the chain for this
## effect's record" from "the chain itself is the answer". The band is the
## whole of that question, and this is the same band `label_key` mints.
pub fn key_is_label(k: Int) -> Bool = k % 3 == 0

pub fn key_effect_id(k: Int) -> Int = k / 3

## The runtime arity of a **function value**: the parameters it was written
## with, plus exactly one evidence slot.
##
## One shape for every function value, whatever its row says -- the same
## discipline `lift_ctor_value` and `lift_fn_value` already answer to, and the
## reason this knife needs no eta adapter anywhere. A row widening on the way
## into a slot (`checker.assignable` lets a pure closure stand where an
## effectful one is declared) changes nothing a caller can observe about the
## arity, so there is no crossing to make physical.
##
## The slot carries a pack, not an atom, so a pure function value carries an
## empty one. That is the price this knife exists to measure.
pub fn fn_arity(t: Ty) -> Int =
  match peel_opaque(t) {
    TyFn(ps, _, _) -> len(ps) + 1
    _ -> 0
  }

test "the named side counts atoms and a function value counts one" {
  let ask = ELabeled(EPure, [(7, "Ask")])
  assert nev(EPure) == 0
  assert nev(EIo) == 0
  assert nev(ask) == 1
  assert nev(ELabeled(EIo, [(7, "Ask"), (9, "Tell")])) == 2
  # rule 丁: a variable is one slot, and so is a union of two of them
  assert nev(EffVar("e", 1)) == 1
  assert nev(EUnion([(1, "e1"), (2, "e2")], [], false)) == 2
  # rule 丙: a projection is one slot, counted once however often it is used
  assert nev(EffAssoc("T", 4, 3, "E")) == 1
  # all three axes at once, and io still free
  assert nev(ELabeled(EUnion([(1, "e")], [("T", 4, 3, "E")], true), [(7, "Ask")])) == 3
  # a key per atom, banded so the three axes cannot answer for each other
  assert atom_keys(EPure) == []
  assert atom_keys(ask) == [21]
  assert atom_keys(EffVar("e", 7)) == [22]
  assert atom_keys(EffAssoc("T", 4, 7, "E")) == [23]
  assert len(atom_keys(ELabeled(EUnion([(1, "e")], [("T", 4, 3, "E")], true), [(7, "Ask")]))) == 3
  # the function-value arity is the written parameters plus the pack, and the
  # row is not consulted: these four are one shape
  assert fn_arity(TyFn([TyInt], TyInt, EPure)) == 2
  assert fn_arity(TyFn([TyInt], TyInt, ask)) == 2
  assert fn_arity(TyFn([TyInt], TyInt, EIo)) == 2
  assert fn_arity(TyFn([TyInt], TyInt, EffVar("e", 1))) == 2
  assert fn_arity(TyFn([], TyInt, EffVar("e", 1))) == 1
  assert fn_arity(TyInt) == 0
}

## The normal form of (base, labels): no labels means the base itself.
pub fn eff_with_labels(base: Eff, labels: List[(Int, String)]) -> Eff =
  if len(labels) == 0 { base } else { ELabeled(base, by_id(labels)) }

fn merge_labels(a: List[(Int, String)], b: List[(Int, String)]) -> List[(Int, String)] = {
  var out = a
  for l in b {
    let (id, _) = l
    if not union_has(out, id) { out = out ++ [l] }
  }
  out
}

## A base row taken apart into its atoms: (io?, variables, projections).
## The one walk `base_union` and `base_subsumes` share, and the effect axis's
## first exhaustive wall: a base is one of the five base shapes, and a label
## carrier reaching here is a normalization bug, not a case to handle.
fn base_parts(e: Eff) -> (Bool, List[(Int, String)], List[(String, Int, Int, String)]) =
  match e {
    EPure -> (false, [], [])
    EIo -> (true, [], [])
    EffVar(n, id) -> (false, [(id, n)], [])
    EffAssoc(s, v, t, n) -> (false, [], [(s, v, t, n)])
    EUnion(vs, atoms, io) -> (io, vs, atoms)
    ELabeled(_, _) -> panic("base_parts: a base row cannot carry labels")
  }

## The base-axis union: **io absorbs nothing**. A variable and a projection are
## both pending evidence, and they survive beside io the way a label survives
## beside it on the label axis. The result is re-normalized to the smallest
## shape.
##
## io used to absorb the variables, on the strength of `base_subsumes`, where
## it does cover them -- but subsumption is a statement about what a signature
## is allowed to promise and a union is a statement about what a row is made
## of, and a row's atoms are its evidence slots. Absorbing one is losing a slot.
## The union runs over inferred rows too, so this was not a spelling question:
## a closure that did io and called an `!e` parameter had its own row collapse
## to `!io`, and then the call that ran it built a pack from that row -- one
## with no node for the variable, and a lookup on it is `ev_get`'s
## compiler-invariant panic on a body that checks clean. Nothing is lost by
## keeping the atom: `base_subsumes` still lets `!io` stand over it, so what a
## signature may declare is exactly what it was.
##
## `eff_subsumes` (not this) is where "io covers any row" lives, and it is
## still there.
fn base_union(effs: List[Eff]) -> Eff = {
  var io = false
  var vars: List[(Int, String)] = []
  var atoms: List[(String, Int, Int, String)] = []
  for e in effs {
    let (i2, vs, as2) = base_parts(e)
    if i2 { io = true }
    for v in vs {
      let (id, _) = v
      if not union_has(vars, id) { vars = vars ++ [v] }
    }
    for a in as2 {
      let (_, av, at2, an) = a
      if not assoc_has(atoms, av, at2, an) { atoms = atoms ++ [a] }
    }
  }
  if len(atoms) == 0 && len(vars) == 0 {
    if io { return EIo }
    return EPure
  }
  if len(atoms) == 0 && not io {
    if len(vars) == 1 {
      let (id, n) = vars[0]
      return EffVar(n, id)
    }
    return EUnion(by_id(vars), [], false)
  }
  if not io && len(vars) == 0 && len(atoms) == 1 {
    let (s, v, t, n) = atoms[0]
    return EffAssoc(s, v, t, n)
  }
  EUnion(by_id(vars), by_assoc(atoms), io)
}

## Combine effects into their normalized least upper bound.
pub fn eff_union(effs: List[Eff]) -> Eff = {
  var bases: List[Eff] = []
  var labels: List[(Int, String)] = []
  var any_label = false
  for e in effs {
    match e {
      ELabeled(b, ls) -> {
        any_label = true
        bases = bases ++ [b]
        labels = merge_labels(labels, ls)
      }
      _ -> { bases = bases ++ [e] }
    }
  }
  let base = base_union(bases)
  if not any_label { return base }
  eff_with_labels(base, labels)
}

## Least upper bound in the effect lattice.
pub fn lub_eff(a: Eff, b: Eff) -> Eff = eff_union([a, b])

## Base-axis subsumption over the parts: io covers io and every variable,
## never a projection -- a projection's evidence has to arrive through a slot
## the outer row wrote down, so containment on the projection axis is exact,
## like the label axis's. Spelled over `base_parts` rather than a shape match
## so an unreduced projection cannot fall through a wildcard and read as
## "covered" (the silent read-through the effect axis used to be made of).
fn base_subsumes(outer: Eff, inner: Eff) -> Bool = {
  let (oio, ovs, oas) = base_parts(outer)
  let (iio, ivs, ias) = base_parts(inner)
  for a in ias {
    let (_, av, at2, an) = a
    if not assoc_has(oas, av, at2, an) { return false }
  }
  if oio { return true }
  if iio { return false }
  for v in ivs {
    let (id, _) = v
    if not union_has(ovs, id) { return false }
  }
  true
}

## Does `outer` permit every effect in `inner`? io covers all of the base axis;
## pure is its bottom. The label axis is plain set containment: `!io` does not
## cover a declared effect, which is what makes a label something a signature
## has to admit to rather than something io quietly swallows.
pub fn eff_subsumes(outer: Eff, inner: Eff) -> Bool = {
  let ols = eff_labels(outer)
  for l in eff_labels(inner) {
    let (id, _) = l
    if not union_has(ols, id) { return false }
  }
  base_subsumes(eff_base(outer), eff_base(inner))
}

## Row containment for a function **value**: `eff_subsumes`, plus exactness on
## the atoms that stand for pending evidence.
##
## The two questions are not the same question, and only one of them is about
## io covering things. A *signature* may promise `!io` over a row it does not
## name -- `fn run(t: fn() -> Int !e) -> Int !io` is what the checker's own
## advice tells an author to write -- and the evidence still arrives, because
## the variable is in the signature's binder list and rule 丁 gives it a slot
## there whatever the row says. A *value* has no binder list. Its row is the
## whole of what a call site reads to size and fill the pack it hands over
## (`evidence_pack`), so an atom dropped on the way into a slot is a key nobody
## puts in, and the read on the other side falls off the end of the chain.
##
## Widening in the other direction stays legal and is what this is not about: a
## pure closure into an `!e` slot gets a pack it never reads, and a superset is
## always safe. What is refused is a row with an atom the slot does not have.
##
## The label axis and the projection axis were exact already (`eff_subsumes`
## and `base_subsumes`); this is the variable axis catching up to them.
pub fn eff_carries(declared: Eff, actual: Eff) -> Bool = {
  if not eff_subsumes(declared, actual) { return false }
  let dvs = eff_vars(declared)
  for v in eff_vars(actual) {
    let (id, _) = v
    if not union_has(dvs, id) { return false }
  }
  true
}

test "a value's row may be widened, but not by dropping an atom" {
  let e1 = EffVar("e1", 1)
  let e2 = EffVar("e2", 2)
  let ask = ELabeled(EPure, [(7, "Ask")])
  # widening upward: nothing to carry, so any slot takes it
  assert eff_carries(EIo, EPure)
  assert eff_carries(e1, EPure)
  assert eff_carries(ask, EPure)
  # the variable axis is exact now, which is the whole point
  assert not eff_carries(EIo, e1)
  assert not eff_carries(e2, e1)
  assert eff_carries(e1, e1)
  assert eff_carries(eff_union([e1, EIo]), e1)
  assert eff_carries(eff_union([e1, e2]), e1)
  # the other two axes answered this way before and still do
  assert not eff_carries(EIo, ask)
  assert eff_carries(ELabeled(EIo, [(7, "Ask")]), ask)
  # a signature is judged by the other relation, and it still lets io stand
  assert eff_subsumes(EIo, e1)
}

## The atoms of a row, unsorted: "io" / variable names / effect names.
fn eff_atoms(e: Eff) -> List[String] = {
  var names: List[String] = []
  match eff_base(e) {
    EPure -> ()
    EIo -> { names = names ++ ["io"] }
    EffVar(n, _) -> { names = names ++ [n] }
    EffAssoc(s, _, _, n) -> { names = names ++ [s ++ "." ++ n] }
    EUnion(vs, atoms, io) -> {
      if io { names = names ++ ["io"] }
      for v in vs {
        let (_, n) = v
        names = names ++ [n]
      }
      for a in atoms {
        let (s, _, _, n) = a
        names = names ++ [s ++ "." ++ n]
      }
    }
    ELabeled(_, _) -> ()
  }
  for l in eff_labels(e) {
    let (_, n) = l
    names = names ++ [n]
  }
  names
}

## Render an effect: "", "io", "e", "Ask", "(e1|e2)" (names sorted, like Kotlin).
pub fn eff_show(e: Eff) -> String = {
  let names = eff_atoms(e)
  if len(names) == 0 {
    ""
  } else if len(names) == 1 {
    names[0]
  } else {
    "(" ++ join(sort(names), "|") ++ ")"
  }
}

## Render as a signature suffix: "", " !io", " !e", " !(e1|e2)".
pub fn eff_suffix(e: Eff) -> String = if e == EPure { "" } else { " !" ++ eff_show(e) }

# ---- types ----

pub type Ty =
  | TyInt
  | TyFloat
  | TyBool
  | TyString
  | TyBytes
  | TyUnit
# bottom type: the "return type" of panic/todo; usable as any type
  | TyNever
# error type: produced where checking failed; compatible with everything
  | TyError
# a type variable, introduced by [T, U] on a declaration; compares by id
  | TyVar(name: String, id: Int)
# a user-defined (or prelude) sum type, possibly instantiated: Option[Int]
  | TyAdt(adt: Int, args: List[Ty])
  | TyList(elem: Ty)
  | TyMap(key: Ty, value: Ty)
  | TySet(elem: Ty)
# the one collection primitive a backend has to implement (D1): a growable
# immutable vector std builds List/Map/Set out of. Not part of the language's
# surface -- only std modules may name it, only std may call `array_*`.
  | TyArray(elem: Ty)
# an opaque imported Java class; the display is precomputed at creation
# (arrays need Class reflection for their readable name)
  | TyJava(fqcn: String, display: String)
# `opaque type N[..] = T`: a type only its declaring module may see through.
# The target rides along the way TyJava's display does, so every mapping from
# a type to a *representation* answers without consulting a table -- at run
# time an opaque type simply IS its target, and so is its equality, hash,
# order and rendering. The only thing `id` buys is that outside the declaring
# module the checker refuses to confuse the two.
#
# `args` carries what the name was applied to, separately from the target it
# was substituted into. The target is not enough to recover them: an argument
# the target does not mention (`opaque type Phantom[T] = Unit`) leaves no
# trace there, so a `Phantom[Int]` and a `Phantom[String]` that compared
# targets would be one type. It also makes an opaque type answer
# `type_args_of` and render as `N[A, B]` like every other constructor.
  | TyOpaque(id: Int, name: String, owner: String, args: List[Ty], target: Ty)
# a projection `T.Item` (docs/assoc-types-design.md): an associated type read
# off the impl chosen for `subject`. Canonical-form invariant: a ground type
# never contains one -- reduction is eager (D3), so a projection only survives
# over a rigid type variable. Downstream of reduction the walls are thinner
# than they look: only `ty_key` (core.dawn) panics on this variant; the
# descriptor and C-repr paths (codegen/emit/emitc) erase it like the TyVar it
# stands over, which is correct for a rigid survivor and silent for an
# invariant break. The effect twin (`EffAssoc`) documents the same split.
  | TyAssoc(subject: Ty, trait_id: Int, name: String)
  | TyTuple(elems: List[Ty])
  | TyFn(params: List[Ty], ret: Ty, eff: Eff)

## An opaque type as the language sees the *value* behind it.
##
## Opacity is a rule about who may name a representation, never about what the
## value is: at run time an opaque type IS its target, so every question about
## the value -- which machine operation, which equality, which order, which
## rendering -- asks the target. Only the checker, and only outside the
## declaring module, keeps the two apart.
pub fn peel_opaque(t: Ty) -> Ty =
  match t {
    TyOpaque(_, _, _, _, tgt) -> peel_opaque(tgt)
    _ -> t
  }

## Does a value of this type live on the heap, and therefore get counted?
##
## The C backend answers the same question through `c_repr` -- a reference
## type is exactly one whose slot is `p` -- and emitc's test "the reference
## types are the pointer slots" is the joint that holds the two together. The
## predicate lives here rather than there because the RC pass runs on Core,
## which cannot see a backend, and a second copy of this rule is the kind that
## drifts apart unnoticed (docs/perceus-design.md 9 R2).
##
## `String` was a value type (a pointer and a length passed by value, buffer
## leaked by contract) until strings joined the ledger: the compiler
## concatenates by the hundred megabyte, and the by-contract leak was what
## kept LeakSanitizer off the corpus. A counted `dawn_str*` also halves the
## erased slot -- the inline two-word string was what held every ADT field at
## sixteen bytes. Literals are immortal statics, so they still cost nothing.
pub fn is_ref_ty(t: Ty) -> Bool =
  match t {
    TyOpaque(_, _, _, _, tgt) -> is_ref_ty(tgt)
    TyInt -> false
    TyFloat -> false
    TyBool -> false
    TyString -> true
    TyUnit -> false
    TyNever -> false
    # DICT_ADT_ID is the dictionary pseudo-type: a static table with no
    # header, outside the ledger entirely (rc's `dictish` is the same rule
    # seen from the expression side). Before this arm, a closure capturing a
    # dictionary counted it in its capture mask, and dropping the closure
    # walked `dawn_drop` into a static -- the unheaded-pointer guard.
    TyAdt(id, _) -> id != DICT_ADT_ID
    TyTuple(_) -> true
    TyFn(_, _, _) -> true
    TyVar(_, _) -> true
    TyError -> true
    TyBytes -> true
    TyList(_) -> true
    TyMap(_, _) -> true
    TySet(_) -> true
    TyArray(_) -> true
    TyJava(_, _) -> true
    # only alive over a rigid subject (canonical-form invariant), where it is
    # an erased reference slot exactly like the TyVar it projects from
    TyAssoc(_, _, _) -> true
  }

## The ADT id lowering's `dict_ty()` stamps on dictionary values: no real ADT
## can have it (minting starts at 0). One name, so "is this a dictionary"
## has one definition wherever a type is all there is to ask.
pub const DICT_ADT_ID: Int = -1

pub fn is_numeric(t: Ty) -> Bool = t == TyInt || t == TyFloat

pub fn is_errorish(t: Ty) -> Bool = t == TyError || t == TyNever

## `Char`'s opaque id. Reserved and negative, like `DICT_ADT_ID`, because this
## is the one opaque type with no declaration site to mint an id for it.
##
## Why the compiler mints the type rather than `std/char` declaring it: `'a'`
## is syntax, so the checker needs this type while typing a literal -- before,
## and regardless of, any module being in scope. A name `ty_named` answers to
## also cannot be declared in std, because `is_builtin_name` reads `ty_named`
## and would call the declaration a redefinition. The mechanism is still
## `opaque type` (spec §2.7): no `Ty` variant, no `Head`, no row in the four
## scalar tables -- `peel_opaque` carries it to `Int`'s implementations, which
## is what 2026-07-30 decided when it deleted `Cursor`'s variant. The owner is
## `std/char`, so that module (and only it) sees through, and `char.of` /
## `char.code` are two ordinary functions needing no intrinsic.
pub const CHAR_OPAQUE_ID: Int = -2

## The type of a character literal: `Char`, an opaque `Int`.
pub fn ty_char() -> Ty = TyOpaque(CHAR_OPAQUE_ID, "Char", "std/char", [], TyInt)

## Who may write a compiler-owned type name. This is surface policy, including
## the distinct return-only access used by Never.
pub type BuiltinTypeAccess =
  | BtPublic
  | BtStdOnly
  | BtReturnOnly
  | BtCompilerOnly

pub type BuiltinTypeBuild =
  | BtLeaf(ty: Ty)
  | BtList
  | BtMap
  | BtSet
  | BtArray

## One compiler-owned type name. `params` is both its arity and its rendered
## generic spelling; consumers filter the current `access` policy.
pub type BuiltinTypeI = {
  name: String,
  params: List[String],
  access: BuiltinTypeAccess,
  build: BuiltinTypeBuild
}

## The compiler-owned type inventory, in user-facing display order.
## Prelude ADTs are deliberately absent: Option/Result/ForeignError are
## nominal declarations in `prelude_adts()`, not builtin constructors.
pub fn builtin_type_inventory() -> List[BuiltinTypeI] = [
  BuiltinTypeI { name: "Int", params: [], access: BtPublic, build: BtLeaf(TyInt) },
  BuiltinTypeI { name: "Char", params: [], access: BtPublic, build: BtLeaf(ty_char()) },
  BuiltinTypeI { name: "Float", params: [], access: BtPublic, build: BtLeaf(TyFloat) },
  BuiltinTypeI { name: "Bool", params: [], access: BtPublic, build: BtLeaf(TyBool) },
  BuiltinTypeI { name: "String", params: [], access: BtPublic, build: BtLeaf(TyString) },
  BuiltinTypeI { name: "Bytes", params: [], access: BtPublic, build: BtLeaf(TyBytes) },
  BuiltinTypeI { name: "Unit", params: [], access: BtPublic, build: BtLeaf(TyUnit) },
  BuiltinTypeI { name: "List", params: ["T"], access: BtPublic, build: BtList },
  BuiltinTypeI { name: "Map", params: ["K", "V"], access: BtPublic, build: BtMap },
  BuiltinTypeI { name: "Set", params: ["T"], access: BtPublic, build: BtSet },
  BuiltinTypeI { name: "Array", params: ["T"], access: BtStdOnly, build: BtArray },
  BuiltinTypeI { name: "Never", params: [], access: BtReturnOnly, build: BtLeaf(TyNever) }
]

pub fn builtin_type_at(name: String) -> Option[BuiltinTypeI] = {
  for info in builtin_type_inventory() {
    if info.name == name { return Some(info) }
  }
  None
}

## The same inventory, keyed by name. `builtin_type_inventory` is a list
## literal, so every `builtin_type_at` call allocated the twelve records afresh;
## a resolver that asks about each name a module mentions pays for the table
## twice per name. Cx.btypes holds one of these for the life of a Cx, the way
## Cx.bins already holds the signature table.
pub fn builtin_type_map() -> Map[String, BuiltinTypeI] = {
  var m: Map[String, BuiltinTypeI] = map.empty()
  for info in builtin_type_inventory() { m = map.insert(m, info.name, info) }
  m
}

pub fn builtin_type_visible(info: BuiltinTypeI, is_std: Bool) -> Bool =
  match info.access {
    BtPublic -> true
    BtStdOnly -> is_std
    BtReturnOnly -> false
    BtCompilerOnly -> false
  }

## Return-position access is additive: ordinary public and std-only names keep
## their existing visibility, while Never becomes nameable only at this use.
pub fn builtin_type_visible_at_return(info: BuiltinTypeI, is_std: Bool) -> Bool =
  builtin_type_visible(info, is_std) || info.access == BtReturnOnly

## A return-only compiler name is reserved even where it is not nameable.
## Public names retain their existing reservation policy, and Array remains a
## std-only primitive that user modules may reuse as an ordinary nominal name.
pub fn builtin_type_name_reserved(info: BuiltinTypeI, is_std: Bool) -> Bool =
  builtin_type_visible(info, is_std) || info.access == BtReturnOnly

pub fn builtin_type_hard_reserved(info: BuiltinTypeI) -> Bool =
  info.access == BtReturnOnly

pub fn hard_reserved_builtin_type_name(name: String) -> Bool =
  match builtin_type_at(name) {
    Some(info) -> builtin_type_hard_reserved(info)
    None -> false
  }

pub fn public_builtin_types() -> List[BuiltinTypeI] = {
  var out: List[BuiltinTypeI] = []
  for info in builtin_type_inventory() {
    if info.access == BtPublic { out = out ++ [info] }
  }
  out
}

pub fn public_builtin_type_names() -> List[String] =
  map(public_builtin_types(), info => info.name)

pub fn return_only_builtin_types() -> List[BuiltinTypeI] = {
  var out: List[BuiltinTypeI] = []
  for info in builtin_type_inventory() {
    if info.access == BtReturnOnly { out = out ++ [info] }
  }
  out
}

pub fn return_only_builtin_type_names() -> List[String] =
  map(return_only_builtin_types(), info => info.name)

## The reference includes every user-spellable compiler-owned type, but each
## entry keeps its access policy instead of presenting Never as globally public.
pub fn documented_builtin_types() -> List[BuiltinTypeI] =
  public_builtin_types() ++ return_only_builtin_types()

pub fn builtin_type_use(info: BuiltinTypeI) -> String =
  if info.access == BtReturnOnly { "return" } else { "any" }

pub fn builtin_type_render(info: BuiltinTypeI) -> String =
  if len(info.params) == 0 {
    info.name
  } else {
    info.name ++ "[" ++ join(info.params, ", ") ++ "]"
  }

## Build a type after the resolver has checked arity and resolved every arg.
pub fn builtin_type_apply(info: BuiltinTypeI, args: List[Ty]) -> Ty =
  match info.build {
    BtLeaf(ty) -> ty
    BtList -> TyList(args[0])
    BtMap -> TyMap(args[0], args[1])
    BtSet -> TySet(args[0])
    BtArray -> TyArray(args[0])
  }

## The public nongeneric compiler-owned type for a name, or None.
## SYN-11 intentionally reads this narrow view: generic, std-only and
## compiler-only entries must not turn a bare constructor into an alias hint.
pub fn ty_named(name: String) -> Option[Ty] =
  match builtin_type_at(name) {
    Some(info) ->
      if info.access == BtPublic && len(info.params) == 0 {
        Some(builtin_type_apply(info, []))
      } else {
        None
      }
    None -> None
  }

# ---- audience (SEM-07; docs/public-surface-design.md §二) ----

## The bundled modules that exist to hold a representation, not to be called:
## `Map`/`Set` are `std/hamt` and `List` is `std/pvec`. They are `pub` because
## std/map, std/set and the lowering of a list primitive call into them, and
## bundled std has no visibility level below `pub` — so the boundary is here
## instead, next to `builtin_type_inventory`, which draws the same line for
## `Array` (audit RD-06).
##
## The point is that the representation can be replaced whole. Nothing outside
## std may name it, so replacing it cannot break a program.
pub fn internal_std_modules() -> List[String] = ["std/hamt", "std/pvec"]

## Who may write a name. The whole of SEM-07's visibility vocabulary: every
## source of an identity — builtin, prelude, imported module, local
## declaration — is normalised to one of these three before the validator
## compares anything, so no read point gets to rebuild "public enough" out of
## a boolean and a guess.
##
##   World          any module that can `use` the declarer may name it
##   StdOnly        only the bundled standard library may name it
##   Module(owner)  only `owner` itself may name it
pub type Audience =
  | AWorld
  | AStdOnly
  | AModule(owner: String)

## Is `path` part of the bundled standard library? The same test `cx_new` runs
## to set `is_std_module`, kept here so an owner string read off an `AdtI` can
## be asked the question without a `Cx` in hand.
pub fn is_std_path(path: String) -> Bool =
  path == "std" || str.starts_with(path, "std/")

## The audience a `pub` declaration in `owner` actually reaches. Bundled std
## has no visibility level below `pub`, so an internal-std module's exports
## stop at `StdOnly` however they are spelled; everything else reaches the
## world.
pub fn declared_audience(owner: String) -> Audience =
  if list.contains(internal_std_modules(), owner) { AStdOnly } else { AWorld }

## Does an identity with audience `identity` cover a root published to
## `audience`? This is the design's table, and it is deliberately not an
## ordering comparison: `StdOnly` covers a `Module(m)` root when `m` is a std
## module, which no enum ordinal can express.
pub fn audience_covers(identity: Audience, root: Audience) -> Bool =
  match identity {
    AWorld -> true
    AStdOnly ->
      match root {
        AWorld -> false
        AStdOnly -> true
        AModule(m) -> is_std_path(m)
      }
    AModule(owner) ->
      match root {
        AWorld -> false
        AStdOnly -> false
        AModule(m) -> m == owner
      }
  }

## The audience of a declaration in `owner` that is `pub` or not. `owner` is
## `None` only where there is no module identity at all (a bare `cx_new(None,
## None)`, which the driver never builds): nothing can be private to a module
## that does not exist, so those declarations are World.
pub fn decl_audience(owner: Option[String], is_pub: Bool) -> Audience =
  match owner {
    None -> AWorld
    Some(ow) -> if is_pub { declared_audience(ow) } else { AModule(ow) }
  }

## A compiler-owned type name's audience, read off the inventory rather than
## restated: `builtin_type_visible` already refuses `Array` outside std, and a
## second copy of that policy here would be free to drift from it.
pub fn builtin_type_audience(name: String) -> Audience =
  match builtin_type_at(name) {
    Some(info) ->
      match info.access {
        BtPublic -> AWorld
        BtStdOnly -> AStdOnly
        BtReturnOnly -> AWorld
        # Compiler-only names cannot reach a written header. The walker passes
        # compiler-created scalar identities without asking (design §5.1).
        BtCompilerOnly -> AWorld
      }
    None -> AWorld
  }

# ---- ADT / ctor / field info (id + table; docs/selfhost-checker.md §二) ----

pub type FieldI = { name: String, ty: Ty }

pub type CtorI = { adt: Int, name: String, fields: List[FieldI] }

pub type AdtI = {
  id: Int,
  name: String,
  is_record: Bool,
  tparams: List[Ty],
  # the effect parameters the declaration bound, in the order it wrote them
  # (`type Cell[!e]` gives `["e"]`). Names and not `Eff`s: a record's identity
  # is `TyAdt(id, args)`, which carries type arguments only, so nothing here
  # is ever substituted. What the list is for is the diagnostic -- an arity
  # that counts only type parameters cannot say why `Cell[Int]` is wrong, and
  # a use site that writes an effect argument has to be told that a record has
  # no position for one (spec §6.3).
  eparams: List[String],
  ctors: List[CtorI],
  derives_show: Bool,
  derives_ord: Bool,
  owner: Option[String],
  # who may name this type (SEM-07). Stored rather than derived from a
  # `is_pub` flag because the answer belongs to the *declaring* module: an
  # imported `AdtI` is grafted whole, so its audience arrives already decided
  # and the importer never has to guess what `pub` meant over there.
  audience: Audience
}

## `[]` at `List[String]`, for the declarations that bind no effect parameter.
pub fn no_eparam_names() -> List[String] = []

pub alias Adts = Map[Int, AdtI]

pub fn adt_of(adts: Adts, id: Int) -> AdtI =
  match map.get(adts, id) {
    Some(a) -> a
    None -> panic("unknown adt id: ${id}")
  }

## The declared "self type": Tree[T] inside its own declaration.
pub fn adt_self_ty(a: AdtI) -> Ty = TyAdt(a.id, a.tparams)

## JVM internal name (erased): abstract base (sum) or the single class (record).
pub fn adt_jvm_name(a: AdtI) -> String =
  match a.owner {
    Some(o) -> o ++ "$" ++ a.name
    None -> a.name
  }

pub fn ctor_jvm_name(adts: Adts, c: CtorI) -> String = {
  let a = adt_of(adts, c.adt)
  if a.is_record { adt_jvm_name(a) } else { adt_jvm_name(a) ++ "$" ++ c.name }
}

# ---- rendering ----

## Render a type in a context that may need a function type grouped. The only
## ambiguous edge is a function return followed by the outer function's effect:
## without grouping, that suffix belongs to the inner function. Other type
## contexts have their own closing delimiter and need no defensive parentheses.
##
## `java_fqn` picks which of a `TyJava`'s two names comes out. Every reader
## surface takes the short one -- a diagnostic, a hover, the reference -- and
## that is what `ty_show` passes. The long one has exactly one caller, the
## builtin-declaration mirror, which needs a rendering that *parses*: `Object`
## is a short name no `use java` line brought into scope, so `cast`'s
## signature is only Dawn source when it is spelled `java.lang.Object`.
fn ty_show_at(adts: Adts, t: Ty, group_fn: Bool, java_fqn: Bool) -> String =
  match t {
    TyInt -> "Int"
    TyFloat -> "Float"
    TyBool -> "Bool"
    TyString -> "String"
    TyBytes -> "Bytes"
    TyUnit -> "Unit"
    TyNever -> "Never"
    TyError -> "?"
    TyVar(n, _) -> n
    TyAdt(aid, targs) -> {
      let name = adt_of(adts, aid).name
      if len(targs) == 0 {
        name
      } else {
        name ++ "[" ++ join(map(targs, x => ty_show_at(adts, x, false, java_fqn)), ", ") ++ "]"
      }
    }
    TyList(e) -> "List[" ++ ty_show_at(adts, e, false, java_fqn) ++ "]"
    TyMap(k, v) -> "Map[" ++ ty_show_at(adts, k, false, java_fqn) ++ ", " ++
      ty_show_at(adts, v, false, java_fqn) ++ "]"
    TySet(e) -> "Set[" ++ ty_show_at(adts, e, false, java_fqn) ++ "]"
    TyArray(e) -> "Array[" ++ ty_show_at(adts, e, false, java_fqn) ++ "]"
    TyJava(fqcn, display) -> if java_fqn { fqcn } else { display }
    # the name, never the target: a diagnostic outside the declaring module
    # must not leak what the module is hiding
    TyOpaque(_, name, _, args, _) ->
      if len(args) == 0 {
        name
      } else {
        name ++ "[" ++ join(map(args, x => ty_show_at(adts, x, false, java_fqn)), ", ") ++ "]"
      }
    TyTuple(elems) ->
      "(" ++ join(map(elems, x => ty_show_at(adts, x, false, java_fqn)), ", ") ++ ")"
    TyFn(params, ret, eff) -> {
      let shown = "fn(" ++
        join(map(params, x => ty_show_at(adts, x, false, java_fqn)), ", ") ++
        ") -> " ++ ty_show_at(adts, ret, eff != EPure, java_fqn) ++ eff_suffix(eff)
      if group_fn { "(" ++ shown ++ ")" } else { shown }
    }
    TyAssoc(s, _, n) -> ty_show_at(adts, s, false, java_fqn) ++ "." ++ n
  }

pub fn ty_show(adts: Adts, t: Ty) -> String = ty_show_at(adts, t, false, false)

## Render the return type of a function before appending that function's
## effect suffix. A non-pure outer function must group a returned function type
## so parse(show(t)) assigns each effect to the same layer.
pub fn fn_return_show(adts: Adts, ret: Ty, outer_eff: Eff) -> String =
  ty_show_at(adts, ret, outer_eff != EPure, false)

## Render a constructor like Kotlin CtorInfo.render (used in diagnostics).
pub fn ctor_render(adts: Adts, c: CtorI) -> String = {
  let a = adt_of(adts, c.adt)
  let ret = ty_show(adts, adt_self_ty(a))
  let fields = join(map(c.fields, f => f.name ++ ": " ++ ty_show(adts, f.ty)), ", ")
  if a.is_record {
    c.name ++ " { " ++ fields ++ " }"
  } else if len(c.fields) == 0 {
    c.name ++ ": " ++ ret
  } else {
    c.name ++ "(" ++ fields ++ "): " ++ ret
  }
}

# ---- argument-to-field decision ----

## Which field one argument fills, or why it fills none.
pub type SlotPick =
  # fills the field at this index
  | SlotAt(idx: Int)
# named, and the constructor has no field of that name
  | SlotNoField(name: String)
# positional, and a named argument came before it
  | SlotAfterNamed
# positional, and past the last field
  | SlotOverflow
# the field at this index was already filled
  | SlotTaken(idx: Int)

## Which slot each of `given` fills, in order: the positional prefix takes
## slots left to right, a name takes the slot it names, and the four ways an
## argument can fail to land on one are answered rather than reported.
##
## One rule, three spellings. `C(x, y)` in a pattern, `C(x, y)` in an
## expression and `f(x, y)` on a function pick their slots the same way, and
## until this existed the first two did so through two copies of the loop --
## which had already drifted: one took the first slot of a given name and the
## other the last. (Unobservable, as it happens: a constructor with two fields
## of one name keeps only the first, and the duplicate is a declaration error.
## Which is the point -- the copies were free to differ and nothing said so.)
##
## What stays at the call sites is what they do with the answer: one binds a
## sub-pattern and two check an expression, and their diagnostics say
## "pattern"/"matched twice" against "argument"/"given twice", against
## "parameter"/"given twice", at different spans.
##
## `trailing` says the last of `given` is a trailing closure -- a tail block or
## a `with` rest (spec §4.3/§4.10). It fills the
## last declared slot, whatever named arguments came before it, so it skips
## both the positional counter and the after-named refusal; if that slot is
## already filled the answer is `SlotTaken`, which the call sites report with
## trailing wording. The pattern side always passes `false` -- a pattern has
## no tail block -- and the parameter exists here so the expression sides and
## the pattern side keep sharing the one slot rule.
pub fn arg_slots(
  params: List[String],
  given: List[Option[String]],
  trailing: Bool
) -> List[SlotPick] = {
  var out: List[SlotPick] = []
  var filled: Set[Int] = set.empty()
  var saw_named = false
  var i = 0
  for nm in given {
    var pick = SlotOverflow
    if trailing && i == len(given) - 1 {
      let last = len(params) - 1
      if last >= 0 {
        pick = if set.has(filled, last) { SlotTaken(last) } else { SlotAt(last) }
      }
    } else {
      match nm {
        Some(an) -> {
          saw_named = true
          match name_index(params, an) {
            None -> { pick = SlotNoField(an) }
            Some(idx) -> { pick = if set.has(filled, idx) { SlotTaken(idx) } else { SlotAt(idx) } }
          }
        }
        None ->
          if saw_named {
            pick = SlotAfterNamed
          } else if i < len(params) {
            pick = if set.has(filled, i) { SlotTaken(i) } else { SlotAt(i) }
          }
      }
    }
    match pick {
      SlotAt(idx) -> { filled = set.insert(filled, idx) }
      _ -> ()
    }
    out = out ++ [pick]
    i = i + 1
  }
  out
}

## The constructor spelling of `arg_slots`: slots are the constructor's fields.
pub fn ctor_slots(fields: List[FieldI], names: List[Option[String]], trailing: Bool) -> List[SlotPick] =
  arg_slots(map(fields, f => f.name), names, trailing)

## The first slot of a given name wins -- the rule the two pre-`ctor_slots`
## copies disagreed on (one scanned forward, one backward).
fn name_index(params: List[String], name: String) -> Option[Int] = {
  var i = 0
  for p in params {
    if p == name { return Some(i) }
    i = i + 1
  }
  None
}

# ---- structural traversal ----
#
# Every walk over a type's structure is one of the two functions below with a
# different rule at the leaves. They used to be written out six times --
# subst, ty_mentions_var, reduce_via_bindings, reduce_assoc, is_concrete and
# the checker's own mentions_tvar -- each ending in the same pair of arms and
# the same comment saying why they were not a wildcard.
#
# That comment is now true of exactly one place. The `match` in each kernel
# lists every Ty variant and has no `_` arm, and that is the wall: a new
# parameterised variant fails to compile here, once, instead of silently
# landing on a wildcard in five walks at the same time. Do not add a wildcard
# arm to either function.

## `f` applied to each of `t`'s immediate type children, with the node rebuilt
## around the results; a type with no children comes back as itself.
##
## Effects ride through untouched -- an effect is not a type and this walk has
## nothing to say about it. `subst` is the one caller that also rewrites a
## function type's effect, so it keeps a `TyFn` arm of its own and reaches
## here for everything else.
pub fn ty_map_children(t: Ty, f: fn(Ty) -> Ty) -> Ty =
  match t {
    # a nullary head has nothing to map, and answering with `t` keeps the walk
    # off the allocator for the commonest node in the table
    TyAdt(aid, targs) -> if len(targs) == 0 { t } else { TyAdt(aid, map(targs, f)) }
    TyList(e) -> TyList(f(e))
    TyMap(k, v) -> TyMap(f(k), f(v))
    TySet(e) -> TySet(f(e))
    TyArray(e) -> TyArray(f(e))
    TyTuple(elems) -> TyTuple(map(elems, f))
    TyOpaque(id, n, ow, args, tgt) -> TyOpaque(id, n, ow, map(args, f), f(tgt))
    # a projection's subject is a type, so it is a child like any other; what
    # the projection itself becomes is the caller's rule, not this walk's
    TyAssoc(s, tid, n) -> TyAssoc(f(s), tid, n)
    TyFn(params, ret, eff) -> TyFn(map(params, f), f(ret), eff)
    TyVar(_, _) -> t
    TyInt | TyFloat | TyBool | TyString | TyBytes -> t
    TyUnit | TyNever | TyError | TyJava(_, _) -> t
  }

## Does any of `t`'s immediate type children satisfy `f`? The existential
## reading of the walk above, over exactly the same children.
pub fn ty_any_child(t: Ty, f: fn(Ty) -> Bool) -> Bool =
  match t {
    TyAdt(_, targs) -> list.any(targs, f)
    TyList(e) -> f(e)
    TyMap(k, v) -> f(k) || f(v)
    TySet(e) -> f(e)
    TyArray(e) -> f(e)
    TyTuple(elems) -> list.any(elems, f)
    TyOpaque(_, _, _, args, tgt) -> list.any(args, f) || f(tgt)
    TyAssoc(s, _, _) -> f(s)
    TyFn(params, ret, _) -> list.any(params, f) || f(ret)
    TyVar(_, _) -> false
    TyInt | TyFloat | TyBool | TyString | TyBytes -> false
    TyUnit | TyNever | TyError | TyJava(_, _) -> false
  }

# ---- substitution ----

## Replace type variables (and effect variables) by id.
## Substitution is structural only: a projection whose subject just became
## concrete is reduced by the checker's reduce_assoc at the instantiation choke
## point, because reduction needs the impl table this module does not have.
pub fn subst(t: Ty, m: Map[Int, Ty], em: Map[Int, Eff]) -> Ty =
  match t {
    TyVar(_, id) ->
      match map.get(m, id) {
        Some(r) -> r
        None -> t
      }
    # the one arm ty_map_children cannot serve: a function type also carries an
    # effect, and an effect is not a child of a type
    TyFn(params, ret, eff) ->
      TyFn(map(params, x => subst(x, m, em)), subst(ret, m, em), subst_eff(eff, em))
    _ -> ty_map_children(t, x => subst(x, m, em))
  }

## Does `t` mention the type variable `id`? The question `subst` answers by
## doing; asking it separately is what lets a caller tell "this parameter could
## have been learned from here" from "it could not".
##
## Searches exactly the children `subst` rewrites, because it is the same walk
## read existentially -- the two are `ty_map_children` and `ty_any_child` over
## one set of children, and that is what keeps the answer honest.
pub fn ty_mentions_var(t: Ty, id: Int) -> Bool =
  match t {
    TyVar(_, vid) -> vid == id
    _ -> ty_any_child(t, x => ty_mentions_var(x, id))
  }

## Rewrite `subject.name` projections to an impl's own bindings -- everything
## else walks structurally. Two callers, one shape: the checker uses it while
## an impl's methods are being checked (before the impl has entered the
## table), and lowering/codegen use it to spell a devirtualised call's
## signature. The binding RHS goes in *verbatim* -- its own type variables are
## the impl's parameters, exactly as they appear in the impl method's declared
## signature -- because that declared signature is the callee's ABI: `Cur =
## Int` must become an unboxed slot and `Item = T` must stay an erased one,
## and instantiating the RHS would get the second wrong.
pub fn reduce_via_bindings(t: Ty, tid: Int, subject: Ty, bindings: List[(String, Ty)]) -> Ty =
  match t {
    TyAssoc(s0, t0, n) -> {
      let s2 = reduce_via_bindings(s0, tid, subject, bindings)
      if t0 == tid && s2 == subject {
        var out = TyAssoc(s2, t0, n)
        for pr in bindings {
          let (bn, bt) = pr
          if bn == n { out = bt }
        }
        out
      } else {
        TyAssoc(s2, t0, n)
      }
    }
    _ -> ty_map_children(t, x => reduce_via_bindings(x, tid, subject, bindings))
  }

## Substitution walks the normal form component by component: the base axis
## substitutes as it always did, and labels ride through untouched -- a label
## is not a variable and has nothing to be replaced by. A base that
## substitutes *into* a labelled row merges through `eff_union`.
pub fn subst_eff(e: Eff, em: Map[Int, Eff]) -> Eff =
  match e {
    EffVar(n, id) ->
      match map.get(em, id) {
        Some(r) -> r
        None -> e
      }
    EUnion(vs, atoms, io) -> {
      var effs: List[Eff] = if io { [EIo] } else { [] }
      for v in vs {
        let (id, n) = v
        effs = effs ++ [match map.get(em, id) {
          Some(r) -> r
          None -> EffVar(n, id)
        }]
      }
      for a in atoms {
        let (s, av, at2, an) = a
        effs = effs ++ [EffAssoc(s, av, at2, an)]
      }
      eff_union(effs)
    }
    ELabeled(b, ls) -> eff_union([subst_eff(b, em), ELabeled(EPure, ls)])
    # A projection is keyed by a *type* variable, and this map holds effects;
    # rewriting it is the checker's reduction (it needs the type bindings and
    # the impl table), the same split `subst`'s header documents for TyAssoc.
    EffAssoc(_, _, _, _) -> e
    _ -> e
  }

## Rewrite the projections whose subject is the type variable `vid` (the trait
## subject, at trait/impl boundaries) to the impl's own bound rows -- the
## effect twin of `reduce_via_bindings`, used by the impl-conformance check
## and by both backends' `subst_subject`. Bindings are ground rows by
## construction (registration refuses anything else), so unlike the type twin
## there is nothing to instantiate.
pub fn reduce_eff_via_bindings(
  e: Eff,
  vid: Int,
  tid: Int,
  bindings: List[(String, Eff)]
) -> Eff =
  eff_map_assocs(e, a => {
    let (s, av, at2, an) = a
    var kept: Eff = EffAssoc(s, av, at2, an)
    if av == vid && at2 == tid {
      for pr in bindings {
        let (bn, be) = pr
        if bn == an { kept = be }
      }
    }
    kept
  })

## Rewrite each projection atom of `e` through `f`, leaving the rest of the
## row in place -- the shared chassis of every effect-side reduction (the
## binding-side one above, and the checker's call-site one, which closes over
## the impl table). A row with no atoms comes back as itself.
pub fn eff_map_assocs(e: Eff, f: fn((String, Int, Int, String)) -> Eff) -> Eff = {
  let atoms = eff_assocs(e)
  if len(atoms) == 0 { return e }
  var parts: List[Eff] = []
  let (io, vs, _) = base_parts(eff_base(e))
  if io { parts = parts ++ [EIo] }
  for v in vs {
    let (id, n) = v
    parts = parts ++ [EffVar(n, id)]
  }
  for a in atoms { parts = parts ++ [f(a)] }
  eff_union(parts ++ [ELabeled(EPure, eff_labels(e))])
}

## The type of an erased evidence slot -- a projection's hidden parameter, in
## a generic consumer and on the dictionary-slot boundary. A `TyVar` on
## purpose: both backends already treat one as the erased pointer shape
## (JVM `Object`, C `void*` with ordinary ownership), which is exactly what a
## slot that is only ever forwarded needs. Id 0 is never minted for a real
## type parameter (prelude ids are negative, the counter opens past the
## prelude), the same convention `TyVar("D", 0)` uses for dictionary slots.
pub fn erased_ev_ty() -> Ty = TyVar("ev", 0)

## `reduce_eff_via_bindings` pushed through a type: every function type's row
## in `t` is rewritten, because a projection is licensed in parameter and
## return positions too (D6) and `ty_map_children` deliberately lets effects
## ride through. The type-axis walk stays `reduce_via_bindings`'s; this one
## only touches rows.
pub fn reduce_ty_effs_via_bindings(
  t: Ty,
  vid: Int,
  tid: Int,
  bindings: List[(String, Eff)]
) -> Ty =
  match t {
    TyFn(ps, r, e) -> TyFn(
      map(ps, x => reduce_ty_effs_via_bindings(x, vid, tid, bindings)),
      reduce_ty_effs_via_bindings(r, vid, tid, bindings),
      reduce_eff_via_bindings(e, vid, tid, bindings))
    _ -> ty_map_children(t, x => reduce_ty_effs_via_bindings(x, vid, tid, bindings))
  }

## Is this row ground -- free of effect variables and projections? The
## `is_ground` twin on the effect axis: labels and io are ground (they are
## answers), a variable or an unreduced projection is a question still open.
pub fn eff_is_ground(e: Eff) -> Bool =
  len(eff_vars(e)) == 0 && len(eff_assocs(e)) == 0

# ---- symbols and signatures ----

## Resolved local variable/parameter. `dict_of` is (trait id, tvar id) for a
## hidden trait-dictionary binding.
##
## `ev_of` is the atom key (`atom_keys`) of an evidence binding -- a signature's
## hidden slot or a `with handle`'s record -- and `None` for every ordinary
## name. Two readers, and they are the two halves of the same rule:
## `checker.resolve_local` refuses to put such a symbol in a capture list, and
## `checker.ev_expr` turns a resolution that crossed a lambda boundary into a
## read off the crossing closure's own pack. Carried on the symbol rather than
## sniffed off the name because there are three spellings (`ev_local_name`,
## `ev_var_local_name`, `ev_assoc_local_name`) and a fourth would be silent.
pub type Sym = {
  name: String,
  ty: Ty,
  mutable: Bool,
  dlo: Int,
  dhi: Int,
  dict_of: Option[(Int, Int)],
  ev_of: Option[Int]
}

## Function signature (user functions and builtins alike).
pub type Sig = {
  name: String,
  param_tys: List[Ty],
  param_names: List[String],
  # which parameters carry a default value (#207) -- per parameter, aligned
  # with param_tys. Empty means none do, which is every signature that is not
  # a top-level fn; a call site treats a missing entry as required.
  param_defaults: List[Bool],
  ret: Ty,
  eff: Eff,
  is_builtin: Bool,
  tparams: List[Ty],
  # trait ids per type parameter, aligned with tparams; missing tail = unbounded
  constraints: List[List[Int]],
  # The effect variables this signature binds, each an `EffVar`, in the order
  # `eff_params_of` defines. A separate component and not a member of
  # `tparams` on purpose: `constraints` is aligned with `tparams` by position,
  # and `bind_dicts` skips a non-`TyVar` entry while still advancing that
  # position, so a mixed list would bind dictionaries to the wrong variable
  # and say nothing (docs/effect-params-design.md decision 1).
  #
  # Empty on a builtin signature, whose row may still name the shared `e`
  # (`bsig`): a builtin has no body to check, so nothing enters it and
  # nothing reads the list back.
  eparams: List[Eff],
  owner: Option[String],
  trait_id: Option[Int],
  # (effect id, field index) when this signature is an effect *operation*
  # rather than a function: calling it is a field read off the evidence in
  # scope plus a closure call, never a call of a symbol that exists
  op_of: Option[(Int, Int)],
  # the return type (and effect) is still being inferred; ret is a placeholder
  inferring: Bool
}

## The bounds of tparams[i], or none.
pub fn bounds_of(s: Sig, i: Int) -> List[Int] =
  match get(s.constraints, i) {
    Some(bs) -> bs
    None -> []
  }

# ---- effects ----

## One declared effect. Its `id` is also the id of the synthesised evidence
## record: the label and the record it is served by are one identity, so
## nothing has to carry a second table from a label to its representation
## (docs/effects-design.md §5.1).
pub type EffectI = {
  id: Int,
  name: String,
  owner: Option[String],
  # who may name this effect label (SEM-07), decided by the declaring module
  # for the same reason `AdtI.audience` is
  audience: Audience,
  # operation names in declaration order = the evidence record's field order
  ops: List[String]
}

pub alias Effects = Map[Int, EffectI]

## The name of the evidence record an effect declaration synthesises. It is
## unspellable on purpose -- `$` is not an identifier character -- so it shares
## the ADT namespace with user types without ever colliding with one.
pub fn ev_record_name(effect_name: String) -> String = "ev\$" ++ effect_name

## Every effect variable written in the rows inside a type, in occurrence
## order and with its name kept.
##
## A substitution keeps ids and throws names away, so a reader that has only
## `Map[Int, Eff]` cannot say which variable an entry is about. This walk is
## where the name comes back, and it is also the only way to ask "which
## variables does this *type* carry", which `sig_abi_eff` below cannot answer:
## it folds in the ones the signature **binds**, and a variable that arrived
## through a `type Box[!e]` or `alias Mapper[T, U, !e]` binder is bound
## somewhere else entirely.
##
## `TyAdt` contributes only through its arguments, and that is not an omission:
## a declaration's effect binder is not a member of `TyAdt.args` (there is no
## effect-argument position on a type reference at all), so a reference to
## `Box` carries the variable nowhere a walk could find it. The field types do
## carry it, which is why `check_ctor_call` asks about those rather than about
## the type being built.
pub fn ty_eff_vars(t: Ty) -> List[(Int, String)] =
  match t {
    TyAdt(_, args) -> ty_eff_vars_all(args)
    TyList(e) -> ty_eff_vars(e)
    TyMap(k, v) -> ty_eff_vars(k) ++ ty_eff_vars(v)
    TySet(e) -> ty_eff_vars(e)
    TyArray(e) -> ty_eff_vars(e)
    TyOpaque(_, _, _, args, tgt) -> ty_eff_vars_all(args) ++ ty_eff_vars(tgt)
    TyAssoc(s, _, _) -> ty_eff_vars(s)
    TyTuple(es) -> ty_eff_vars_all(es)
    TyFn(ps, r, ef) -> ty_eff_vars_all(ps) ++ ty_eff_vars(r) ++ eff_vars(ef)
    _ -> []
  }

pub fn ty_eff_vars_all(ts: List[Ty]) -> List[(Int, String)] = {
  var out: List[(Int, String)] = []
  for t in ts {
    for v in ty_eff_vars(t) {
      let (id, _) = v
      if not union_has(out, id) { out = out ++ [v] }
    }
  }
  out
}

test "ty_eff_vars finds the rows a type carries, and only those" {
  let e1 = EffVar("e", 11)
  let e2 = EffVar("f", 12)
  assert ty_eff_vars(TyInt) == []
  assert ty_eff_vars(TyFn([TyInt], TyInt, e1)) == [(11, "e")]
  # nested: a list of functions, and a function returning a function
  assert ty_eff_vars(TyList(TyFn([], TyUnit, e1))) == [(11, "e")]
  # parameters, then the return, then the row -- the row is written last and
  # walked last, the same order `eff_params_of` mints in
  assert ty_eff_vars(TyFn([], TyFn([], TyInt, e2), e1)) == [(12, "f"), (11, "e")]
  # io and a written label are answers, not variables: neither is a slot here
  assert ty_eff_vars(TyFn([], TyInt, EIo)) == []
  assert ty_eff_vars(TyFn([], TyInt, ELabeled(EPure, [(7, "Ask")]))) == []
  # a type reference hides its declaration's binder -- see the header
  assert ty_eff_vars(TyAdt(3, [])) == []
  assert ty_eff_vars(TyAdt(3, [TyFn([], TyInt, e1)])) == [(11, "e")]
  # the list form dedupes by id, so two fields writing one binder are one entry
  assert ty_eff_vars_all([TyFn([], TyInt, e1), TyFn([], TyUnit, e1)]) == [(11, "e")]
}

## A signature's **ABI row**: its declared row, with the effect variables it
## binds folded in.
##
## The declared row is not the whole answer, because a signature can bind a
## variable it does not itself raise. `impl Container[Quiet] { fn wrap(c: Quiet,
## body: fn() -> Int !e) -> Int }` binds `e` in a parameter and is pure -- an
## impl may be purer than the row the trait admits -- and it still has to take
## the slot the trait method's callers pass, or the dictionary has two shapes.
## `Sig.eparams` is exactly "the variables this signature introduced, in
## introduction order" (`eff_params_of`), so folding it in is what makes the
## count a property of the signature rather than of what its body happened to
## do.
##
## The row's own variables are kept as well as `eparams`, not instead of it: a
## variable can reach a row from a type declaration's effect parameter, which
## this signature never bound (see `checker.verify_effects`' advice arm).
##
## Every Sig-side reader of `nev` goes through here, so there is still one
## count. Nothing stores the result: it is a layout question, and the
## non-normal `EUnion` it may build is only ever asked for its three axes.
pub fn sig_abi_eff(s: Sig) -> Eff = {
  let (io, vs0, atoms) = base_parts(eff_base(s.eff))
  var vs = vs0
  for p in s.eparams {
    match p {
      EffVar(n, id) -> if not union_has(vs, id) { vs = vs ++ [(id, n)] }
      _ -> ()
    }
  }
  eff_with_labels(EUnion(by_id(vs), atoms, io), eff_labels(s.eff))
}

## The evidence pack's ADT id. Reserved and negative, like `DICT_ADT_ID` and
## `CHAR_OPAQUE_ID`, because this record has no declaration site to mint an id
## for it and `first_minted_id` must not move when it is added.
pub const EV_PACK_ID: Int = -3

## The evidence pack: an immutable chain of `(key, evidence, outer)` nodes,
## addressed by atom key rather than by position.
##
## This is what a function value's one evidence slot carries. Keying it means a
## merge is a cons and a lookup is a walk, so two rows meeting at a call site
## never have to be reordered against one another -- the failure mode that
## judged a positional evidence *vector* unsafe on native (design 裁决背景 1).
##
## An ordinary record, so it costs no new Core node and no new backend shape:
## it is built with `CCtor` and would be read with `CField`, exactly like the
## `ev$E` record an effect declaration synthesises. Its name is unspellable for
## the same reason that one's is.
##
## **The empty pack is the erased placeholder, not a nil constructor.** A slot
## that carries no evidence carries what every other erased evidence slot
## carries when nothing answers it. A second constructor would have bought a
## tag test instead of a shape test and one more emitted class per program.
##
## **The walk lives in the runtime intrinsic `ev_get(pack, key)`, and the
## terminator test is the runtime's own knowledge of shape.** That sentence
## used to read "a walk ends when it meets something that is not a node", which
## named a test Core cannot spell: `CIsCtor` is the only discriminant node
## there is, and on native it compiles to `((dawn_adt*)p)->tag == ci` -- a read
## off a `dawn_box` when the value is the placeholder, which is undefined and
## silently plausible. The JVM's `INSTANCEOF` answers the question exactly; the
## native runtime answers it from the `kind` byte in every heap object's
## header. Neither is expressible as Core, so neither is written as Core: the
## walk is one intrinsic, each backend writes it, and the shape test never
## leaves the layer that owns the representation.
##
## Three things terminate a walk, and `ev_get` tolerates all three: the boxed
## unit that is the placeholder, a NULL pack, and any other erased value that
## is not a pack node. NULL is not hypothetical: hand-written shims apply Dawn
## closures, and a shim passes whatever it has.
##
## This paragraph used to say that seven such sites passed a raw null "because
## nothing reads one", that the justification would expire when reads appeared,
## and that `ev_get`'s null tolerance replaced it -- so the sites could stay as
## they were. The prediction was right and the conclusion was wrong, and the
## way it was wrong is the part worth keeping. Null tolerance stops a *crash*.
## A shim that passes null where the caller had a pack is not crashing; it is
## answering the wrong question, and the reader that walks off the end gets the
## compiler-invariant panic below on a program that checks clean. That is what
## `bracket` did: `bracket(1, x => (), x => quota() + x)` under a
## `with handle` printed `EV_MISS_MSG` instead of a number.
##
## So the sites are enumerated, and each one says which of the two it is.
##
##   `gen_bracket` ×3, `dawn_bracket` ×3 (and its wasi twin)
##       **the pack**, out of the primitive's own evidence parameter.
##       `bracket` is effect-polymorphic, so its row is worth one slot
##       (`nev`) and the call site fills it like any other callee's.
##
##   `gen_try_closure` ×1, `dawn_run_caught` ×1 (and its wasi twin)
##       **the pack**, for the same reason and since 2026-08-25. The barriers
##       used to declare `f: fn() -> T !io` and push null here, on the ground
##       that a closure owing evidence was refused at the argument before any
##       of this. It was refused, and that was the defect rather than the
##       guarantee: a labelled closure could not be protected at all. The
##       barriers now bind `!e` (`catch_fault[T, !e]`), so their ABI row is
##       `!(e|io)`, worth one slot, and the call site fills it.
##
##   the SAM bridge (`jvm/emit.gen_sam_bridge`)
##       **null, and it is the answer, because nothing that owes evidence gets
##       this far.** A `use java` callback is entered from Java with no Dawn
##       frame under it, so there is no call site to take a pack from. Spec
##       §9.4 answers that by narrowing what may cross rather than by widening
##       what the bridge carries: `checker.sam_row_ok` accepts a pure or `!io`
##       row at the conversion and refuses a label, an effect variable and a
##       projection, naming the handler-inside-the-lambda rewrite as the out.
##       So `Thread.new(() => println(to_string(quota())))` under a
##       `with handle`, which used to check clean and panic, is now a checker
##       error, and every row that reaches the bridge asks for nothing.
##
##       The alternative was to capture the pack into the adapter *object* at
##       conversion time. That is evidence living in a value, and whether a
##       callback Java runs after the handler frame returned should see that
##       handler at all is a language question rather than a codegen one; V1'
##       answers effects at call sites, so the narrowing is the one that fits.
##       Kotlin refuses `suspend` at a SAM conversion for the same reason.
##
##   `gen_fn_comparator`
##       **null, and nothing can observe it**: no emitted program constructs a
##       `dawn/rt/FnComparator`. The class is written into every program and
##       instantiated by none, left over from when sorting went through
##       `java.util.Arrays`. Delete the class and the site goes with it.
##
## A miss is not a terminator. Falling off the end means lowering built a pack
## that does not answer a key its own reader asks for, which is a compiler
## invariant break, so `ev_get` panics rather than handing back the
## placeholder -- the same choice `lower.impl_ev_sources` makes, and for the
## same reason: a placeholder used as an evidence record is a crash at a
## distance from the bug.
##
## **The second walker is `ev_append(front, back)`, and it exists because one
## slot can be handed two rows.** `!e := !e1 !e2` has two environments to put
## in one `outer` field, and consing is only enough when there is one: the
## other would have to be wrapped as a node's payload, which answers no key its
## own reader asks for. So `front`'s chain is walked and rebuilt -- fresh
## nodes, the same `key` and `ev` in each, front's order kept -- onto `back`,
## and `front`'s own terminator is dropped rather than copied. It recognises a
## node exactly as `ev_get` does, so all four terminators end the rebuild the
## same way; appending onto an empty `front` is `back` itself.
##
## Two properties are worth naming because a reader could reasonably assume
## either could go the other way. **The chain stays flat**, so `ev_get` is
## untouched by any of this: still one walk, still no nesting, and the cost of
## a merge is paid once where the merge is written rather than on every read.
## And **front wins**: a key in both halves is answered by front's node,
## because the walk meets it first. Distinct atoms cannot collide -- the bands
## in `atom_keys` see to that -- so nothing in a checked program depends on the
## rule; it is defined anyway, since "whichever the rebuild happened to put
## first" is not something a later reader should have to work out.
pub fn ev_pack_adt() -> AdtI =
  AdtI {
    id: EV_PACK_ID,
    name: "ev\$Pack",
    is_record: true,
    tparams: [],
    eparams: no_eparam_names(),
    ctors: [
      CtorI {
        adt: EV_PACK_ID,
        name: "ev\$Pack",
        fields: [
          FieldI { name: "key", ty: TyInt },
          FieldI { name: "ev", ty: erased_ev_ty() },
          FieldI { name: "outer", ty: erased_ev_ty() }
        ]
      }
    ],
    derives_show: false,
    derives_ord: false,
    owner: None,
    audience: AWorld
  }

pub fn ev_pack_ty() -> Ty = TyAdt(EV_PACK_ID, [])

## What a failed `ev_get` says, in one place because three implementations say
## it: the JVM emitter writes it into a `Panic`, the comptime interpreter
## raises it, and `dawn_ev_get` in runtime/c/dawn_rt.c carries the same text as
## a C literal (the joint is the test in c/emitc.dawn). A user should never see
## it -- reaching it means the compiler handed a reader a pack without the key
## the reader's own row named.
pub const EV_MISS_MSG: String =
  "effect evidence missing: no pack entry for the atom this call site asked for"

# ---- traits ----

pub type MethodSig = { sig: Sig, has_default: Bool }

pub type TraitI = {
  id: Int,
  name: String,
  # the subject type parameter (a TyVar)
  tvar: Ty,
  is_pub: Bool,
  owner: Option[String],
  src_path: Option[String],
  # methods by name, in declaration order
  methods: List[(String, MethodSig)],
  # associated type members, in declaration order (bare names: no bounds, no
  # defaults -- docs/assoc-types-design.md D1). The name has no module-level
  # identity; `T.Item` is the only way to reach it.
  assoc: List[String],
  # associated *effect* members (`effect E`), same discipline as `assoc`:
  # bare names, declaration order, reachable only as the row atom `!T.E`
  # (docs/effect-params-design.md 刀 5 -- no bounds)
  eff_assoc: List[String],
  # associated-effect defaults (#369): (member name, ground row) for each
  # `effect E = !Row` the trait body wrote. A member absent here has no
  # default and keeps the missing-binding error; a member present here is
  # materialized into an impl's `eff_bindings` when the impl writes no
  # binding of its own, so everything downstream of registration sees a
  # defaulted impl exactly as it sees an explicitly bound one.
  eff_defaults: List[(String, Eff)],
  # Do this trait's method names occupy the module function namespace? True for
  # every trait a user can declare; false is reserved for compiler-built traits
  # whose sole consumer is an operator (docs/prelude-namespace-design.md D1).
  # Three injection paths read this field -- prelude seeding, local `trait`
  # registration, and `pub trait` export -- so they cannot drift apart.
  injects: Bool
}

## What an impl is indexed by: the outermost type constructor of its subject,
## with the arguments dropped (trait-v2-design §3.3).
##
## Restricting subjects to a head applied to distinct variables (§3.2) is what
## lets one equality answer three questions at once -- which impl matches,
## whether two impls overlap, and whether recursive solving terminates. A type
## with no head (a variable, a function, an error) can never be an impl
## subject, which is why `head_of` is partial.
##
## Tuples are deliberately absent: they have no head name and are n-ary, so
## they stay with the compiler-synthesised equality (§3.2, 决策 2/7).
pub type Head =
  | HInt
  | HFloat
  | HBool
  | HString
  | HBytes
  | HUnit
  | HAdt(adt: Int)
  | HList
  | HMap
  | HSet
  | HArray
  | HJava(fqcn: String)
  | HOpaque(id: Int)

pub fn head_of(t: Ty) -> Option[Head] =
  match t {
    TyInt -> Some(HInt)
    TyFloat -> Some(HFloat)
    TyBool -> Some(HBool)
    TyString -> Some(HString)
    TyBytes -> Some(HBytes)
    TyUnit -> Some(HUnit)
    TyAdt(aid, _) -> Some(HAdt(aid))
    TyList(_) -> Some(HList)
    TyMap(_, _) -> Some(HMap)
    TySet(_) -> Some(HSet)
    TyArray(_) -> Some(HArray)
    TyJava(fqcn, _) -> Some(HJava(fqcn))
    # an opaque type may carry its own impl, distinct from its target's
    TyOpaque(id, _, _, _, _) -> Some(HOpaque(id))
    _ -> None
  }

## The arguments the head is applied to: the sub-goals an impl's constraints
## land on (§3.3), and the parts a synthesised structural relation compares
## through (§3.6). Anything without a head has none.
pub fn type_args_of(t: Ty) -> List[Ty] =
  match t {
    TyAdt(_, args) -> args
    TyTuple(elems) -> elems
    TyList(e) -> [e]
    TySet(e) -> [e]
    TyArray(e) -> [e]
    TyMap(k, v) -> [k, v]
    TyOpaque(_, _, _, args, _) -> args
    _ -> []
  }

## Does this type still mention a rigid type parameter?
##
## This is the split trait v2 turns on (§3.8): a ground subject's dictionary is
## known at compile time and stays a static singleton, a non-ground one's has
## to be built at run time out of its arguments'. Lowering has always asked the
## question; the checker asks it too now, so the two agree on which shape a
## witness takes rather than each deciding for itself.
pub fn is_ground(t: Ty) -> Bool =
  match t {
    TyVar(_, _) -> false
    TyFn(ps, r, _) -> all_ground(ps) && is_ground(r)
    TyInt | TyFloat | TyBool | TyString | TyBytes -> true
    TyUnit | TyNever | TyError | TyJava(_, _) -> true
    # A projection that survived reduction stands over a rigid subject (D3),
    # so it mentions a type parameter by construction and the canonical-form
    # invariant at TyAssoc's declaration says a ground type never contains
    # one. Spelled out because the `_` below answered the opposite: it asks
    # `type_args_of`, which has no arm for TyAssoc either, and an empty list
    # is vacuously all-ground -- so `C.Item` came back ground and every
    # caller that treats ground as "the relation is decided here" believed
    # it.
    TyAssoc(_, _, _) -> false
    _ -> all_ground(type_args_of(t))
  }

pub fn all_ground(ts: List[Ty]) -> Bool = {
  for t in ts {
    if not is_ground(t) { return false }
  }
  true
}

## Can the compiler spell a relation out over this type's own structure?
##
## Records and tagged unions can: their parts are types, and the relation on
## the whole is the relation on the parts. Containers cannot -- their element
## walk lives in the runtime until S3 makes them Dawn -- and neither can a
## function or a scalar. This is what decides whether a synthesised structural
## impl has anything to do with the arguments it is given.
pub fn expandable(t: Ty) -> Bool =
  match t {
    TyAdt(_, _) -> true
    TyTuple(_) -> true
    _ -> false
  }

pub alias Impls = Map[(Int, Head), ImplI]

## Look an impl up by subject type. A subject with no head cannot have one,
## which reads the same as the lookup missing.
pub fn impl_at(tbl: Impls, tid: Int, t: Ty) -> Option[ImplI] =
  match head_of(t) {
    Some(h) -> map.get(tbl, (tid, h))
    None -> None
  }

pub fn has_impl_at(tbl: Impls, tid: Int, t: Ty) -> Bool =
  match impl_at(tbl, tid, t) {
    Some(_) -> true
    None -> false
  }

## Register an impl under its subject's head. Whoever gets here has already
## established the subject may be one (`impl_subject_ok`, or the prelude's own
## scalar list), so a headless subject is a compiler bug, not a user error.
pub fn insert_impl(tbl: Impls, i: ImplI) -> Impls =
  match head_of(i.subject) {
    Some(h) -> map.insert(tbl, (i.trait_id, h), i)
    None -> panic("impl subject has no head")
  }

## The sub-goals solving `Tr[t]` breaks into: one per bound the matching impl
## puts on one of its own type parameters, in (parameter, bound) order -- the
## same order every dictionary parameter list uses.
##
## With no conditional impl in the table the rule degrades to "one goal per
## type argument, same trait", which is the compiler-synthesised structural
## relation (trait-v2-design §3.6). Both sides of the pipeline ask this, so
## the checker's witness arguments and lowering's dictionary parameters cannot
## drift into different orders.
pub fn sub_goals(tbl: Impls, tid: Int, subject: Ty) -> List[(Int, Ty)] = {
  let args = type_args_of(subject)
  match impl_at(tbl, tid, subject) {
    Some(imp) ->
      if len(imp.tparams) > 0 {
        var out: List[(Int, Ty)] = []
        var i = 0
        for cons in imp.constraints {
          for b in cons {
            if i < len(args) { out = out ++ [(b, args[i])] }
          }
          i = i + 1
        }
        return out
      }
    None -> ()
  }
  var out: List[(Int, Ty)] = []
  for a in args { out = out ++ [(tid, a)] }
  out
}

pub type ImplI = {
  trait_id: Int,
  subject: Ty,
  # A conditional impl's own parameters, and the bounds each one carries.
  # `constraints` is indexed by tparam, like `Sig`'s is -- and since a subject
  # may only apply these very parameters (trait-v2-design §3.2), every bound is
  # a constraint on a direct argument of the head. That is what makes recursive
  # solving terminate on term size rather than on a depth limit.
  tparams: List[Ty],
  constraints: List[List[Int]],
  lo: Int,
  hi: Int,
  derived: Bool,
  owner: Option[String],
  src_path: Option[String],
  provided: List[String],
  # `type Item = X` bindings, one per associated type the trait declares
  # (checked for exactly-once coverage at registration). The RHS is resolved
  # in the scope of `tparams`; reduction instantiates it with the same
  # substitution the witness gets (docs/assoc-types-design.md D4/D5).
  assoc_bindings: List[(String, Ty)],
  # `effect E = !X` bindings, one per associated effect the trait declares,
  # same exactly-once check. The RHS is a ground row (pure, `!io`, or one
  # declared label -- registration refuses variables and projections), so
  # reduction substitutes it verbatim (docs/effect-params-design.md 刀 5).
  eff_bindings: List[(String, Eff)]
}

pub alias Traits = Map[Int, TraitI]

pub fn trait_of(traits: Traits, id: Int) -> TraitI =
  match map.get(traits, id) {
    Some(t) -> t
    None -> panic("unknown trait id: ${id}")
  }

## Who may name this trait (SEM-07). Derived rather than stored, because
## `TraitI` — alone among the four identity records — already carries both
## halves of the answer, and a stored copy could disagree with the `is_pub`
## the exporter reads.
pub fn trait_audience(t: TraitI) -> Audience = decl_audience(t.owner, t.is_pub)

pub fn impl_display(adts: Adts, traits: Traits, i: ImplI) -> String =
  trait_of(traits, i.trait_id).name ++ "[" ++ ty_show(adts, i.subject) ++ "]"

## The repair for a method row that has to differ from impl to impl.
##
## Two diagnostics refuse that shape, one at the impl's signature and one in
## its body, and both used to offer only the edits that keep a single row for
## everybody: widen the trait's declaration, or drop the effect. Widening is
## the one a reader reaches for, and it makes every impl pay for the dirtiest
## one -- a consumer that was pure, and testable with `==` because of it, is
## neither once the trait's row carries `!io`. An impl-decided row has its own
## spelling and it is not the method's own effect variable, which is the
## caller's (docs/effect-params-design.md 刀 5): declare the effect as a member
## of the trait, bind it once per impl, and write the method's row as the
## projection.
##
## One sentence, two callers, for `nev`'s reason rather than for brevity: the
## two diagnostics are reached from opposite ends of the same wrong turn, and
## advice that disagreed with itself between them would be worse than advice
## given once.
pub fn assoc_effect_advice(adts: Adts, t: TraitI) -> String =
  "if impls of `" ++ t.name ++ "` need different rows, declare `effect E` in the trait, " ++
  "bind it in each impl (`effect E = !io`, or `effect E = !()` where the impl is pure), " ++
  "and write the method's row as `!" ++ ty_show(adts, t.tvar) ++ ".E`"

## Render a signature like Kotlin FnSig.render (used in golden dumps and docs).
pub fn sig_render(adts: Adts, traits: Traits, s: Sig) -> String =
  sig_render_at(adts, traits, s, false)

## The same rendering with every `TyJava` spelled by its fully qualified name,
## which is what a mirror of the builtin table needs: `cast`'s parameter is
## `java.lang.Object`, and the short `Object` the reader surfaces print is not
## a type any Dawn file has in scope. One caller (the builtin-declaration
## mirror, scripts/builtin-decl-contract) and one difference; `sig_render`
## above is what everything else keeps getting.
pub fn sig_render_fqn(adts: Adts, traits: Traits, s: Sig) -> String =
  sig_render_at(adts, traits, s, true)

fn sig_render_at(adts: Adts, traits: Traits, s: Sig, java_fqn: Bool) -> String = {
  var parts: List[String] = []
  var i = 0
  for v in s.tparams {
    let bs = bounds_of(s, i)
    let vname = ty_show(adts, v)
    if len(bs) == 0 {
      parts = parts ++ [vname]
    } else {
      let bnames = map(bs, b => trait_of(traits, b).name)
      parts = parts ++ [vname ++ ": " ++ join(bnames, " + ")]
    }
    i = i + 1
  }
  # The effect parameters after the type parameters, spelled the way the
  # parameter list spells them and in `eparams` order, which is the order the
  # signature bound them (types.eff_params_of). Since V1' this rendering is a
  # courtesy to the reader, not a semantic obligation: evidence travels in a
  # pack addressed by atom key (docs/spec.md §6.5, the informative
  # implementation note), so nothing downstream reads an arity off the binder
  # list the way decision 9 of docs/effect-params-design.md had it. It stays
  # for the reader alone: a row that mentions `!e` is unreadable without
  # seeing where `e` was bound. A signature that binds none renders exactly as
  # it did.
  for ev in s.eparams {
    parts = parts ++ ["!" ++ eff_show(ev)]
  }
  var tp = ""
  if len(parts) > 0 {
    tp = "[" ++ join(parts, ", ") ++ "]"
  }
  var ps: List[String] = []
  var j = 0
  for pt in s.param_tys {
    let pn = match get(s.param_names, j) {
      Some(n) -> n
      None -> "_"
    }
    # a defaulted parameter renders `= ...`: the signature does not carry the
    # expression (it lives in the synthesized f$default$k's body), and what a
    # caller needs from the rendering is that the argument may be omitted
    let dm = match get(s.param_defaults, j) {
      Some(true) -> " = ..."
      _ -> ""
    }
    ps = ps ++ [pn ++ ": " ++ ty_show_at(adts, pt, false, java_fqn) ++ dm]
    j = j + 1
  }
  "fn " ++ s.name ++ tp ++ "(" ++ join(ps, ", ") ++ ") -> " ++
    ty_show_at(adts, s.ret, s.eff != EPure, java_fqn) ++ eff_suffix(s.eff)
}

# ---- prelude: Option / Result, Ord, builtins ----

pub const OPTION_ID: Int = 0

pub const RESULT_ID: Int = 1

## What a foreign failure looks like once it has crossed into Dawn: the
## payload of `catch_fault`/`catch_panic` (docs/audit/error-model-design.md
## A). A prelude type rather than a std one, for the reason `Option` is: an
## intrinsic returns it, so every program can name it without importing
## anything, and std cannot declare a type the compiler already had to know.
pub const FOREIGN_ERROR_ID: Int = 2

pub const ORD_ID: Int = 0

## `==` and `!=`. Unlike Ord it is not reached by a method call in source --
## the operator is the spelling -- but it rides the same dictionary rail, which
## is what a backend without a universal `equals` needs (docs/native-backend-plan.md §1).
pub const EQ_ID: Int = 1

## The hash half of the same identity. Nothing in the language calls it yet;
## the pure-Dawn Map/Set of D2 will, through a `[K: Eq + Hash]` bound.
pub const HASH_ID: Int = 2

## Rendering. `to_string` and every `${...}` interpolation ask for this
## witness, which is what makes `derive Show` an impl rather than a flag on
## the ADT plus an instanceof chain only the JVM has.
pub const SHOW_ID: Int = 3

## Iteration: what `for x in xs` desugars to (#44 knife 2). Four methods
## mirroring std/list's retired cursor quartet -- start/done/next/get over an
## associated `Cur`, yielding an associated `Item` -- so a step allocates
## nothing a given impl's cursor doesn't. The impls live in std (List, String,
## Bytes, Map, Set); the trait is prelude because the *language* consumes it:
## `for` needs the witness the way `==` needs Eq's, without an import.
pub const ITER_ID: Int = 4

## Subscripting: what `c[i]` resolves to (#44 knife 3). Two associated types --
## `Idx` for what goes in the brackets, `Item` for what comes out -- and one
## method. `[]` used to enumerate its own legal subjects in the checker, two
## arms wide, which is a list a user type can never be added to; now the
## question is the impl table's.
##
## The `List` and `Map` impls are minted by the prelude and their bodies are
## `prim_relation`'s, the same division of labour Eq/Ord/Hash/Show already
## have: the language keeps `list_index` a Core intrinsic (comptime folds it)
## and keeps `m[k]` off a std module that itself indexes. A user type takes
## the ordinary route -- write `impl Index[Grid]`, and nothing about it is
## special-cased.
pub const INDEX_ID: Int = 5

## User-facing rendering: what `to_string` and `${...}` produce when the type
## has an opinion about it. `Show` is the *nested* rendering, quoting a String
## because inside a structure the quotes say "a value ends here"; `to_string`
## is the top-level one and does not (spec 4.3). That split predates this
## trait and is what it is named after: the layer already existed, spelled as
## two arms in `to_str`, with no way for a type to join it.
##
## Only `to_string` and `${...}` consume `display`, so `injects: false` keeps
## the name out of every module's function namespace, exactly as `Index` does
## for `index`. A type with no impl renders as it always did, and an opaque
## type is asked at every peel layer rather than once at the top -- one layer
## at a time is what SEM-03 cost to learn.
##
## Deliberately not derivable: `derive Show` says "render my structure", and a
## `Display` is a decision about presentation, which is one per type and hand
## written. `Show[T]` stays the bound `to_string` requires, so this is a
## refinement of an answer that already exists, never a new way to be
## renderable.
pub const DISPLAY_ID: Int = 6

pub fn opt_ty(t: Ty) -> Ty = TyAdt(OPTION_ID, [t])

pub fn result_ty(t: Ty, e: Ty) -> Ty = TyAdt(RESULT_ID, [t, e])

pub fn foreign_error_ty() -> Ty = TyAdt(FOREIGN_ERROR_ID, [])

## The `T` in a `cast` call's `Result[T, ForeignError]`.
##
## Both emitters need it -- it is the type the reclaim is checked against --
## and neither can read it off the argument, which is an erased `Object`. It
## lives here rather than in one of them because a backend that peeled the
## type differently would be checking against a different class.
pub fn cast_target(ty: Ty) -> Ty =
  match peel_opaque(ty) {
    TyAdt(aid, args) ->
      if aid == RESULT_ID && len(args) == 2 {
        args[0]
      } else {
        panic("cast: not typed Result[T, ForeignError]")
      }
    _ -> panic("cast: not typed Result[T, ForeignError]")
  }

## The three prelude ADTs, keyed by their fixed ids.
pub fn prelude_adts() -> Adts = {
  let ot = TyVar("T", -11)
  let option = AdtI {
    id: OPTION_ID,
    name: "Option",
    is_record: false,
    tparams: [ot],
    eparams: no_eparam_names(),
    ctors: [
      CtorI { adt: OPTION_ID, name: "Some", fields: [FieldI { name: "value", ty: ot }] },
      CtorI { adt: OPTION_ID, name: "None", fields: [] }
    ],
    derives_show: true,
    derives_ord: false,
    owner: None,
    audience: AWorld
  }
  let rt = TyVar("T", -12)
  let re = TyVar("E", -13)
  let result = AdtI {
    id: RESULT_ID,
    name: "Result",
    is_record: false,
    tparams: [rt, re],
    eparams: no_eparam_names(),
    ctors: [
      CtorI { adt: RESULT_ID, name: "Ok", fields: [FieldI { name: "value", ty: rt }] },
      CtorI { adt: RESULT_ID, name: "Err", fields: [FieldI { name: "error", ty: re }] }
    ],
    derives_show: true,
    derives_ord: false,
    owner: None,
    audience: AWorld
  }
  # A record, so a caller reads `e.kind` with no `match` in the way, and with
  # three fields chosen for what every backend can answer:
  #
  #   kind     the backend's own name for the failure class -- a JVM binary
  #            name (`getClass().getName()`), the native runtime's failure
  #            kind. A *name*, never a rendered message: matching on a name is
  #            a decision a compiler could one day check for typos, matching
  #            on a message prefix (what spec 9.8 used to advise) is a
  #            decision the JDK or libc can silently invalidate. Which names a
  #            backend uses is backend-specific and documented as such --
  #            portable matching is `Ok`/`Err` and nothing finer.
  #   message  what the failure said, and nothing about its class.
  #   cause    the failure underneath, rendered, where the backend has one.
  #
  # No stack: rendering `StackTraceElement[]` would be paid on every barrier,
  # including the ones that never fail.
  let ferr = AdtI {
    id: FOREIGN_ERROR_ID,
    name: "ForeignError",
    is_record: true,
    tparams: [],
    eparams: no_eparam_names(),
    ctors: [
      CtorI {
        adt: FOREIGN_ERROR_ID,
        name: "ForeignError",
        fields: [
          FieldI { name: "kind", ty: TyString },
          FieldI { name: "message", ty: TyString },
          FieldI { name: "cause", ty: opt_ty(TyString) }
        ]
      }
    ],
    derives_show: true,
    derives_ord: false,
    owner: None,
    audience: AWorld
  }
  # the evidence pack rides here rather than being minted per module: it is
  # one shape for the whole program, and its id is negative so that adding it
  # leaves `first_minted_id` -- and therefore every minted id in every program
  # -- exactly where it was
  map.from([
    (OPTION_ID, option),
    (RESULT_ID, result),
    (FOREIGN_ERROR_ID, ferr),
    (EV_PACK_ID, ev_pack_adt())
  ])
}

fn prelude_method(tid: Int, tv: Ty, name: String, ptys: List[Ty], pnames: List[String],
  ret: Ty) -> Sig =
  Sig {
    name: name,
    param_tys: ptys,
    param_names: pnames,
    param_defaults: [],
    ret: ret,
    eff: EPure,
    is_builtin: false,
    tparams: [tv],
    constraints: [[tid]],
    eparams: [],
    owner: None,
    trait_id: Some(tid),
    op_of: None,
    inferring: false
  }

fn prelude_trait(tid: Int, name: String, tv: Ty, m: String, sig: Sig) -> TraitI =
  TraitI {
    id: tid,
    name: name,
    tvar: tv,
    is_pub: true,
    owner: None,
    src_path: None,
    methods: [(m, MethodSig { sig: sig, has_default: false })],
    assoc: [],
    eff_assoc: [],
    eff_defaults: [],
    injects: true
  }

## The prelude traits: Ord (id 0) whose `cmp` backs `< <= > >=` beyond scalars,
## Eq (id 1) behind `==`/`!=`, and Hash (id 2), which nothing calls yet.
pub fn prelude_traits() -> Traits = {
  let tv = TyVar("T", -10)
  let cmp_sig = Sig {
    name: "cmp",
    param_tys: [tv, tv],
    param_names: ["a", "b"],
    param_defaults: [],
    ret: TyInt,
    eff: EPure,
    is_builtin: false,
    tparams: [tv],
    constraints: [[ORD_ID]],
    eparams: [],
    owner: None,
    trait_id: Some(ORD_ID),
    op_of: None,
    inferring: false
  }
  let ord = TraitI {
    id: ORD_ID,
    name: "Ord",
    tvar: tv,
    is_pub: true,
    owner: None,
    src_path: None,
    methods: [("cmp", MethodSig { sig: cmp_sig, has_default: false })],
    assoc: [],
    eff_assoc: [],
    eff_defaults: [],
    injects: true
  }
  let ev = TyVar("T", -14)
  let eq = prelude_trait(EQ_ID, "Eq", ev, "eq",
    prelude_method(EQ_ID, ev, "eq", [ev, ev], ["a", "b"], TyBool))
  let hv = TyVar("T", -15)
  let hash = prelude_trait(HASH_ID, "Hash", hv, "hash",
    prelude_method(HASH_ID, hv, "hash", [hv], ["x"], TyInt))
  let sv = TyVar("T", -16)
  let show = prelude_trait(SHOW_ID, "Show", sv, "show",
    prelude_method(SHOW_ID, sv, "show", [sv], ["x"], TyString))
  # Iter: four methods over two associated types. The projections are built
  # directly -- TyAssoc over the trait's own tvar is exactly what resolving
  # `C.Cur` in a declared trait would produce.
  let iv = TyVar("T", -17)
  let icur = TyAssoc(iv, ITER_ID, "Cur")
  let iitem = TyAssoc(iv, ITER_ID, "Item")
  let iter = TraitI {
    id: ITER_ID,
    name: "Iter",
    tvar: iv,
    is_pub: true,
    owner: None,
    src_path: None,
    methods: [
      ("iter_start", MethodSig {
        sig: prelude_method(ITER_ID, iv, "iter_start", [iv], ["c"], icur),
        has_default: false
      }),
      ("iter_done", MethodSig {
        sig: prelude_method(ITER_ID, iv, "iter_done", [iv, icur], ["c", "k"], TyBool),
        has_default: false
      }),
      ("iter_next", MethodSig {
        sig: prelude_method(ITER_ID, iv, "iter_next", [iv, icur], ["c", "k"], icur),
        has_default: false
      }),
      ("iter_get", MethodSig {
        sig: prelude_method(ITER_ID, iv, "iter_get", [iv, icur], ["c", "k"], iitem),
        has_default: false
      })
    ],
    assoc: ["Cur", "Item"],
    eff_assoc: [],
    eff_defaults: [],
    injects: true
  }
  # Index: the subject in parameter 0 so it is a non-projection position and
  # inference has something to work from, exactly as Iter's four methods do.
  # `injects: false` keeps `index` out of every module's function namespace --
  # the name is consumed by an operator, so it is only ever written in an impl
  # body, in `dawn doc`, and in an error message.
  let xv = TyVar("T", -18)
  let xidx = TyAssoc(xv, INDEX_ID, "Idx")
  let xitem = TyAssoc(xv, INDEX_ID, "Item")
  let index = TraitI {
    id: INDEX_ID,
    name: "Index",
    tvar: xv,
    is_pub: true,
    owner: None,
    src_path: None,
    methods: [
      ("index", MethodSig {
        sig: prelude_method(INDEX_ID, xv, "index", [xv, xidx], ["c", "i"], xitem),
        has_default: false
      })
    ],
    assoc: ["Idx", "Item"],
    eff_assoc: [],
    eff_defaults: [],
    injects: false
  }
  # Display: one method, no associated types, and `injects: false` for the same
  # reason Index has it -- `to_string` and `${...}` are the only consumers, so
  # `display` is written in an impl body and read in `dawn doc`, nowhere else.
  let dv = TyVar("T", -22)
  let display = TraitI {
    id: DISPLAY_ID,
    name: "Display",
    tvar: dv,
    is_pub: true,
    owner: None,
    src_path: None,
    methods: [
      ("display", MethodSig {
        sig: prelude_method(DISPLAY_ID, dv, "display", [dv], ["x"], TyString),
        has_default: false
      })
    ],
    assoc: [],
    eff_assoc: [],
    eff_defaults: [],
    injects: false
  }
  map.from([(ORD_ID, ord), (EQ_ID, eq), (HASH_ID, hash), (SHOW_ID, show), (ITER_ID, iter),
    (INDEX_ID, index), (DISPLAY_ID, display)])
}

## The prelude trait ids, in id order. Everything that needs to know "which
## traits does the prelude bring" reads this -- the seeding loop, the
## redefinition guard, LSP completion -- so the set lives in one place instead
## of being transcribed per call site (docs/prelude-namespace-design.md §4.3).
pub fn prelude_trait_ids() -> List[Int] =
  [ORD_ID, EQ_ID, HASH_ID, SHOW_ID, ITER_ID, INDEX_ID, DISPLAY_ID]

## The prelude trait names, derived from the table rather than transcribed.
pub fn prelude_trait_names() -> List[String] = {
  let ts = prelude_traits()
  map(prelude_trait_ids(), tid => trait_of(ts, tid).name)
}

## Is `n` the name of a prelude trait? A local `trait` of that name is a
## redefinition, not a shadowing: trait names live in the type namespace and
## the prelude traits have no module to qualify them with.
pub fn is_prelude_trait_name(n: String) -> Bool = list.contains(prelude_trait_names(), n)

## The first id the checker's counter may hand out: one past the largest id any
## prelude entity already holds.
##
## Read off the two tables rather than written down beside them. The checker
## used to open its counter at a literal, and the literal is exactly the kind
## of thing that does not get revisited: it stayed at 3 when Show took trait
## id 3, and stayed at 4 when Iter took trait id 4. Neither collided, but only
## because a trait declaration mints its type variable before its trait id --
## an accident of ordering, not a rule. Adding a prelude trait now moves this
## on its own.
pub fn first_minted_id() -> Int = {
  let held = map.keys(prelude_adts()) ++ map.keys(prelude_traits())
  match list.max(held) {
    Some(top) -> top + 1
    None -> 0
  }
}

fn prelude_impl(tid: Int, t: Ty) -> ImplI =
  ImplI {
    trait_id: tid,
    subject: t,
    tparams: [],
    constraints: [],
    lo: 0,
    hi: 1,
    derived: false,
    owner: None,
    src_path: None,
    provided: [],
    assoc_bindings: [],
    eff_bindings: []
  }

## A conditional prelude impl: `impl[T: tid] tid[Head[T]]`, one bound per
## parameter. `Option` and `Result` carry `derive Show` in their declaration
## but have no module for the derive pass to walk, so their impls are minted
## here instead.
fn prelude_cond_impl(tid: Int, subject: Ty, tps: List[Ty]) -> ImplI = {
  var cs: List[List[Int]] = []
  for _tp in tps { cs = cs ++ [[tid]] }
  ImplI {
    trait_id: tid,
    subject: subject,
    tparams: tps,
    constraints: cs,
    lo: 0,
    hi: 1,
    derived: true,
    owner: None,
    src_path: None,
    provided: [],
    assoc_bindings: [],
    eff_bindings: []
  }
}

## A prelude impl that binds associated types, with the bounds spelled out per
## parameter rather than derived from the trait.
##
## `prelude_cond_impl` above puts the *same* trait on every parameter, which is
## what `Show[Option[T]]` needs and what `Index` needs on neither of its two
## subjects: `Index[List[T]]` bounds nothing, and `Index[Map[K, V]]` bounds
## three traits on `K` and none on `V`. `constraints` is indexed by parameter,
## so those two lists line up with `type_args_of(subject)` and `sub_goals`
## reads the pairing straight off.
fn prelude_assoc_impl(
  tid: Int,
  subject: Ty,
  tps: List[Ty],
  cs: List[List[Int]],
  bindings: List[(String, Ty)]
) -> ImplI =
  ImplI {
    trait_id: tid,
    subject: subject,
    tparams: tps,
    constraints: cs,
    lo: 0,
    hi: 1,
    # No body anywhere: this row is derived, so `primitive_subject` sends the
    # call to `prim_relation`, the same route compiler-owned ownerless/bodyless
    # prelude rows take. `provided` is empty because there are no source
    # methods, but emptiness alone does not make a user impl primitive.
    derived: true,
    owner: None,
    src_path: None,
    provided: [],
    assoc_bindings: bindings,
    eff_bindings: []
  }

## The scalars the backends compare for equality natively.
pub fn eq_scalars() -> List[Ty] = [TyInt, TyFloat, TyBool, TyString, TyBytes]

## The scalars that *hash*, which is not the same list, and the difference is
## `Float`.
##
## `Eq[Float]` is IEEE: `-0.0 == 0.0` is true and they have different bit
## patterns, so no hash can agree with that equality and also with itself.
## Rust reaches the same place by not implementing `Hash` for `f64`. One table
## answered both questions until 2026-07-26, which is why `Float` could be a
## Map key and two equal keys could land in different buckets.
pub fn hash_scalars() -> List[Ty] = [TyInt, TyBool, TyString, TyBytes]

## Is this one of the scalars whose equality the backend implements natively?
pub fn is_eq_scalar(t: Ty) -> Bool = {
  for s in eq_scalars() {
    if s == t { return true }
  }
  false
}

pub fn is_hash_scalar(t: Ty) -> Bool = {
  for s in hash_scalars() {
    if s == t { return true }
  }
  false
}

## The subset the prelude also *orders*, and `Float` is not in it.
##
## `Ord` is a total order -- that is what `sort` and `derive Ord` need, and
## what a `[T: Ord]` bound promises. Float has none: NaN is unordered against
## everything including itself. Java's `Double.compare` and Rust's `total_cmp`
## invent one by fiat, and Dawn used to copy that; the cost is a `cmp` whose
## answer contradicts the `<` right next to it. So Float drops to a partial
## order (2026-07-26), which in Dawn means *one impl fewer* rather than one
## trait more: `<`/`<=`/`>`/`>=` on scalars never consulted a witness in the
## first place, so they still work and still mean IEEE. What changes is that
## `[T: Ord]` no longer accepts Float.
pub fn ord_scalars() -> List[Ty] = [TyInt, TyString]

pub fn is_ord_scalar(t: Ty) -> Bool = {
  for s in ord_scalars() {
    if s == t { return true }
  }
  false
}

## The scalars the language renders itself. `Cursor` is absent because it is
## an opaque handle with nothing to print, and `Unit` because `()` is not a
## value anyone asks to see -- the two ways this list differs from `eq_scalars`.
pub fn show_scalars() -> List[Ty] = [TyInt, TyFloat, TyBool, TyString, TyBytes]

pub fn is_show_scalar(t: Ty) -> Bool = {
  for s in show_scalars() {
    if s == t { return true }
  }
  false
}

## Ord over the natively ordered scalars, Eq/Hash over every scalar, Show over
## the printable ones: the impls that ship with the language.
pub fn prelude_impls() -> List[ImplI] = {
  var out = map(ord_scalars(), t => prelude_impl(ORD_ID, t))
  for t in eq_scalars() {
    out = out ++ [prelude_impl(EQ_ID, t)]
  }
  for t in hash_scalars() {
    out = out ++ [prelude_impl(HASH_ID, t)]
  }
  for t in show_scalars() {
    out = out ++ [prelude_impl(SHOW_ID, t)]
  }
  let ot = TyVar("T", -11)
  let rt = TyVar("T", -12)
  let re = TyVar("E", -13)
  let lt = TyVar("T", -19)
  let mk = TyVar("K", -20)
  let mv = TyVar("V", -21)
  out ++ [
    prelude_cond_impl(SHOW_ID, TyAdt(OPTION_ID, [ot]), [ot]),
    prelude_cond_impl(SHOW_ID, TyAdt(RESULT_ID, [rt, re]), [rt, re]),
    # `ForeignError` takes no parameters, so its `derive Show` is the same
    # mint with nothing to constrain -- the fields are String/String/
    # Option[String] and each already shows.
    prelude_cond_impl(SHOW_ID, foreign_error_ty(), []),
    # `xs[i]`: an Int in, the element out, and nothing asked of the element.
    prelude_assoc_impl(INDEX_ID, TyList(lt), [lt], [[]],
      [("Idx", TyInt), ("Item", lt)]),
    # `m[k]`: Eq and Hash to find the entry, and Show only to name the key in
    # the panic when there is none -- the one bound of the three that is not
    # about finding it (std/hamt.dawn:262-266 says the same thing at the other
    # end). They sit on `K` because `constraints` is indexed by parameter, and
    # they used to be resolved by hand at the `[]`; a conditional impl's
    # sub-goals carry the same span and the same requirer, so the three
    # diagnostics still land on the subscript.
    prelude_assoc_impl(INDEX_ID, TyMap(mk, mv), [mk, mv],
      [[EQ_ID, HASH_ID, SHOW_ID], []], [("Idx", mk), ("Item", mv)])
  ]
}

fn bsig(name: String, ptys: List[Ty], pnames: List[String], ret: Ty) -> Sig =
  Sig {
    name: name,
    param_tys: ptys,
    param_names: pnames,
    param_defaults: [],
    ret: ret,
    eff: EPure,
    is_builtin: true,
    tparams: [],
    constraints: [],
    eparams: [],
    owner: None,
    trait_id: None,
    op_of: None,
    inferring: false
  }

fn tp1(s: Sig, v: Ty) -> Sig = Sig { ..s, tparams: [v] }

## One type parameter carrying one bound: the shape `to_string` has now that
## rendering is a trait rather than a predicate the checker applies itself.
fn tp1b(s: Sig, v: Ty, tid: Int) -> Sig =
  Sig { ..s, tparams: [v], constraints: [[tid]] }

fn eff1(s: Sig, e: Eff) -> Sig = Sig { ..s, eff: e }

## One declared effect parameter. A signature that binds a variable it does not
## itself raise has to say so here, because `sig_abi_eff` reads the binder list
## and not the parameter types: the row of `f: fn() -> T !e` is the closure's,
## and the slot that carries its evidence is the signature's. The catch pair is
## the only entry of the table in that shape (`bracket` raises the variable it
## binds, so its own row already carries it).
fn ep1(s: Sig, e: Eff) -> Sig = Sig { ..s, eparams: [e] }

## A Map/Set primitive that hashes: its key parameter carries `Eq` and `Hash`,
## so the dictionaries reach the trie in std/hamt. Which relation decides "same
## key" is then the key type's own, rather than whatever the host's identity
## happened to be. The primitives that only count or list entries are
## deliberately not in this shape -- reading a map should not need the bound.
fn keyed2(s: Sig, kk: Ty, vv: Ty) -> Sig =
  Sig { ..s, tparams: [kk, vv], constraints: [[EQ_ID, HASH_ID]] }

fn keyed1(s: Sig, tt: Ty) -> Sig =
  Sig { ..s, tparams: [tt], constraints: [[EQ_ID, HASH_ID]] }

## The builtin function table (port of Types.kt BUILTINS, same order).
pub fn builtins() -> Map[String, Sig] = {
  let t = TyVar("T", -1)
  let u = TyVar("U", -2)
  let a = TyVar("A", -3)
  let k = TyVar("K", -4)
  let v = TyVar("V", -5)
  # `bracket`'s two: the resource it holds and the answer it hands back
  let b = TyVar("B", -6)
  let e = EffVar("e", -1)
  var out: Map[String, Sig] = map.empty()
  var sigs = [
    bsig("panic", [TyString], ["msg"], TyNever),
    bsig("todo", [], [], TyNever),
    bsig("to_float", [TyInt], ["n"], TyFloat),
    bsig("to_int", [TyFloat], ["x"], TyInt),
    tp1(bsig("len", [TyList(t)], ["xs"], TyInt), t),
    tp1(bsig("get", [TyList(t), TyInt], ["xs", "i"], opt_ty(t)), t),
    bsig("range", [TyInt, TyInt], ["from", "to"], TyList(TyInt)),
    eff1(tp1(bsig("sort_by", [TyList(t), TyFn([t, t], TyInt, e)], ["xs", "cmp"], TyList(t)), t), e),
    tp1(bsig("expect", [opt_ty(t), TyString], ["o", "msg"], t), t),
    tp1(bsig("unwrap_or", [opt_ty(t), t], ["o", "fallback"], t), t),
    tp1b(bsig("to_string", [t], ["x"], TyString), t, SHOW_ID),
    bsig("join", [TyList(TyString), TyString], ["xs", "sep"], TyString),
    bsig("code_points", [TyString], ["s"], TyList(ty_char())),
    bsig("from_code_points", [TyList(ty_char())], ["cs"], TyString),
    bsig("parse_int", [TyString], ["s"], opt_ty(TyInt)),
    bsig("parse_float", [TyString], ["s"], opt_ty(TyFloat)),
    bsig("cursor_start", [TyString], ["s"], TyInt),
    bsig("cursor_end", [TyString], ["s"], TyInt),
    bsig("cursor_done", [TyString, TyInt], ["s", "c"], TyBool),
    bsig("cursor_char", [TyString, TyInt], ["s", "c"], TyInt),
    bsig("cursor_next", [TyString, TyInt], ["s", "c"], TyInt),
    bsig("cursor_prev", [TyString, TyInt], ["s", "c"], TyInt),
    bsig("cursor_slice", [TyString, TyInt, TyInt], ["s", "from", "to"], TyString),
    # str_* intrinsics: what is left once everything expressible as a walk is
    # written as one. Case folding is a Unicode table, not a walk, so it stays
    # here; length, trimming and the four searches used to and no longer do
    # (std/str, docs/native-backend-plan.md 14.12).
    bsig("str_lower", [TyString], ["s"], TyString),
    bsig("str_upper", [TyString], ["s"], TyString),
    # char_* intrinsics: Unicode classification of one character. Same reason
    # the str_* ones exist -- the answer is a property of the Unicode tables,
    # not something Dawn source can compute -- and every backend needs them
    # regardless, so they belong in the contract rather than in each program's
    # `use java`. They take `Char`, so a caller holding an `Int` has to say
    # which integers it believes are characters (std/char.of), which is the
    # whole point of the type.
    bsig("char_is_letter", [ty_char()], ["c"], TyBool),
    bsig("char_is_digit", [ty_char()], ["c"], TyBool),
    bsig("char_is_alnum", [ty_char()], ["c"], TyBool),
    bsig("char_is_upper", [ty_char()], ["c"], TyBool),
    bsig("char_is_lower", [ty_char()], ["c"], TyBool),
    bsig("char_is_space", [ty_char()], ["c"], TyBool),
    # The Int -> Char bridge for std's hot paths, where the caller has already
    # established that the integer is a code point and an `Option` would be an
    # allocation per step. Internal, because an unchecked constructor should
    # not be public (audit RD-01); `std/char.of` is the checked one everyone
    # else uses. `std/str.trim` is why it exists: it walks with `cursor.char`,
    # which answers `Int` and `-1` at the end (spec §4.8), and feeds
    # `char_is_space`. Identity at every level below the checker -- lower.dawn
    # rewrites the call to its argument, so neither backend learns the name.
    bsig("char_unchecked", [TyInt], ["n"], ty_char()),
    # parse_int in a base other than 10; None when the text is not a numeral in
    # that base, so a caller needs no exception bridge to read one.
    bsig("parse_int_radix", [TyString, TyInt], ["s", "radix"], opt_ty(TyInt)),
    # bytes_* intrinsics: the byte primitives std/bytes writes over. Bytes is a
    # JVM byte[] (crosses FFI both ways), so the JVM backend emits these into
    # dawn/rt/Bytes; an out-of-range read comes back as the sentinel -1, which
    # std turns into a panic. bytes_index_of stays pure Dawn over
    # bytes_len/bytes_at.
    bsig("bytes_utf8", [TyString], ["s"], TyBytes),
    # Two decoders rather than one taking a charset name (audit RP-04,
    # decision C: the two charsets the language promises are two functions,
    # and the function name is the domain). Neither returns an Option, because
    # with no charset to get wrong there is no failure left to report -- both
    # charsets decode every byte string, UTF-8 by replacing what it cannot
    # read with U+FFFD.
    bsig("bytes_decode_utf8", [TyBytes], ["b"], TyString),
    bsig("bytes_decode_latin1", [TyBytes], ["b"], TyString),
    bsig("bytes_len", [TyBytes], ["b"], TyInt),
    bsig("bytes_at", [TyBytes, TyInt], ["b", "i"], TyInt),
    bsig("bytes_slice", [TyBytes, TyInt, TyInt], ["b", "start", "end"], TyBytes),
    # The one way to *make* bytes that did not come from text. Without it
    # `Bytes` is a read-only type: you can take the UTF-8 of a string, slice
    # it and read it, but you cannot produce an arbitrary byte -- `0x80` would
    # need a string whose UTF-8 encoding is that one byte, and there is none.
    # Anything that decompresses has to write bytes it computed, so this is
    # what std/bytes builds its `Buf` on. Elements outside 0..255 are the
    # caller's error and are truncated, like a byte store anywhere else.
    bsig("bytes_from_array", [TyArray(TyInt)], ["a"], TyBytes)
  ]
  sigs = sigs ++ [
    eff1(bsig("args", [], [], TyList(TyString)), EIo),
    # The io barrier. It catches a *fault* -- the outside world said no -- and
    # lets a panic through, which is the split spec 9.8 is about and the one
    # `catch_panic` is the other half of. It was called `java_try` through
    # v0.30.0, back when the JVM's class hierarchy was the only place the split
    # came from; native has had failure kinds since 2026-07-27
    # (native-backend-plan.md 14.9), and the name outlived the reason.
    #
    # The payload is a `ForeignError` (docs/audit/error-model-design.md 六). It
    # used to be the failure rendered as a String, which left a caller nothing
    # to act on but the text -- the thing spec 9.8 used to advise matching on
    # and ERR-02 was raised about.
    #
    # Changing it took three releases, because a builtin's *signature* is under
    # the seed discipline the same way its name is, and more tightly: the
    # compiler's own sources have to type-check under the previous release's
    # table and today's at once, and no call site satisfies
    # `Result[T, String]` and `Result[T, ForeignError]` together unless it
    # throws the payload away. So the new shape landed under a pair of names
    # nothing called (`catch_fault_e`/`catch_panic_e`, v0.32.0), a release
    # taught the previous compiler both spellings, the call sites moved and
    # these two entries were flipped at zero callers (v0.33.0), and the call
    # sites came back here. The transitional pair is gone.
    #
    # The protected closure's row is a variable and the barrier's own row is
    # not. Those are two different questions, and SEM-11 separates them
    # (docs/audit/error-model-design.md §7.4): "whoever observes a failure is
    # impure" constrains the row this primitive *raises*, which stays `!io`
    # because it hands a caught failure back as a value. What `f` may raise is
    # not observed by anyone here -- an effect is answered by its handler,
    # which sits outside and is untouched by a barrier crossing it -- so
    # pinning `f` to `!io` only meant that a labelled closure could not be
    # protected at all. `!e` is declared rather than merely mentioned, because
    # `sig_abi_eff` counts binders: without the binder the row would be `!io`
    # alone, the call site would pass no pack, and the closure would walk a
    # null one.
    eff1(
      ep1(tp1(bsig("catch_fault", [TyFn([], t, e)], ["f"],
        result_ty(t, foreign_error_ty())), t), e),
      EIo
    ),
    # The reclaim's failure is a value, not an exception thrown through a
    # signature that says `pure` (docs/audit/error-model-design.md 二.B,
    # LANG-02). Still pure: a `ForeignError` handed back is not an effect, and
    # that was the whole difference -- a `cast` that missed used to leave the
    # function by a route its type did not mention.
    #
    # The arithmetic step B inherited from step A (design doc 六.2): a
    # builtin's *signature* is under the seed discipline the way its name is,
    # and no call site satisfies `T` and `Result[T, ForeignError]` at once, so
    # the compiler's own `cast` sites could not type-check against the seed's
    # table and today's together. So the new shape landed under a name nothing
    # called (`cast_e`, v0.34.0), a release taught the previous compiler, the
    # call sites moved and this entry was flipped at zero callers -- with both
    # emitters repointed in the same commit, because a table entry and a
    # runtime that disagree is what step A's stage 2 left for its stage 3 to
    # find (六.8) -- and the call sites came back here (v0.35.0). The
    # transitional spelling is gone; see 六.10.
    tp1(bsig("cast", [TyJava("java.lang.Object", "Object")], ["x"],
      result_ty(t, foreign_error_ty())), t),
    # The other half of the split, and the same shape as `catch_fault` above
    # for the same reason: `!e` is what `f` may raise, `!io` is what this
    # primitive raises.
    eff1(
      ep1(tp1(bsig("catch_panic", [TyFn([], t, e)], ["f"],
        result_ty(t, foreign_error_ty())), t), e),
      EIo
    ),
    # The third member of the family, and the one that catches nothing. It runs
    # `release` on every way out of `use` -- the value, a panic, a fault -- and
    # then gets out of the way: the failure carries on to whatever was going to
    # stop it, with its kind and message untouched. `finally`, not `catch`.
    #
    # The resource arrives as a *value*, not as an acquire thunk. Haskell's
    # `bracket` takes the thunk because Haskell has asynchronous exceptions: a
    # timer or another thread can interrupt between acquiring and installing
    # the handler, so the acquisition has to happen where the handler already
    # is. Dawn has no such thing -- a failure only ever originates in code the
    # program itself called -- and nothing of the caller's runs between the
    # argument evaluation and the handler this primitive installs. So the
    # thunk would buy no window; Koka's `finally` takes the resource eagerly
    # for the same reason. Acquisition is ordinary code before the call, where
    # a failure needs no release because nothing was acquired.
    #
    # `use` is last, which is a decision about what can be built on top: a
    # `with`-style sugar attaches the remaining block as the *last* argument,
    # so a primitive whose use-closure sits in the middle would have to be
    # re-spelled the day that sugar exists (docs/core-move2-design.md 6,
    # ruling 1). With eager acquisition and that sugar a resource site carries
    # no lambdas at all: `with f <- bracket(open(path), close)`.
    #
    # It returns `B` rather than a `Result` because protecting and catching are
    # orthogonal, and every language that has both says so -- Haskell's
    # `bracket`, Kotlin's `use`, Koka's `finally`, Go's `defer` hand back the
    # body's own answer. A caller who wants the failure as a value writes
    # `catch_fault(() => bracket(...))`, which is two primitives each doing
    # one thing (ruling 2).
    #
    # No `CSProtect` node stands behind it. The protected region is exactly one
    # closure call, so no `return`/`?`/`break` can leave it -- the language
    # stops them at the closure boundary -- and a protect whose region is always
    # a call is a runtime primitive taking a closure, which is what
    # `catch_fault` already is. That is the intrinsic contract, not a second
    # implementation (docs/core-move2-design.md 2.6).
    # Effect-polymorphic in its *own* row, which is where it differs from the
    # two neighbours above: `release` and `use` share one row `e` and the call
    # carries exactly that row. Nothing here observes a failure -- the release
    # runs and the failure carries on -- so the primitive adds no effect of its
    # own, and pinning it to `!io` would only mean that protecting a pure
    # resource makes its user impure.
    #
    # The catch pair binds `!e` too, and still raises `!io`: what they hand
    # back depends on the failure they caught, so they observe one and an
    # observer is impure (docs/audit/error-model-design.md §7.3). That
    # criterion is about the row the primitive raises, not about the row its
    # argument may raise (§7.4), which is why the binder and the `!io` sit in
    # one signature without contradiction.
    #
    # The third parameter is `body` and not `use`, which is what it was called
    # until the builtin table grew a mirror a reader can paste (selfhost/
    # builtins.dawn). `use` is a keyword, so `bracket(r, close, use: f)` is
    # not writable and never was: the name was a rendering with no caller,
    # and every place it surfaced -- hover, completion, `doc --builtins`, the
    # spec -- printed a signature that does not parse. Renaming it costs
    # nothing a caller can observe.
    eff1(
      Sig {
        ..bsig("bracket",
          [a, TyFn([a], TyUnit, e), TyFn([a], b, e)],
          ["resource", "release", "body"], b),
        tparams: [a, b]
      },
      e
    ),
    # io_* intrinsics: the console/file primitives std/io writes over. All !io.
    # The JVM backend emits them into dawn/rt/Io. read_file/write_file/list_names
    # throw on failure; std wraps them in a barrier. read_line returns Option
    # directly (the intrinsic maps Java's null-or-line onto it). list_names
    # answers the OS's order; std sorts, so no backend carries a sort.
    eff1(bsig("io_print", [TyString], ["s"], TyUnit), EIo),
    eff1(bsig("io_println", [TyString], ["s"], TyUnit), EIo),
    eff1(bsig("io_read_line", [], [], opt_ty(TyString)), EIo),
    eff1(bsig("io_is_dir", [TyString], ["path"], TyBool), EIo),
    eff1(bsig("io_read_file", [TyString], ["path"], TyString), EIo),
    eff1(bsig("io_write_file", [TyString, TyString], ["path", "content"], TyUnit), EIo),
    eff1(bsig("io_list_names", [TyString], ["path"], TyList(TyString)), EIo),
    # stderr, and the process/filesystem primitives a CLI needs on any
    # backend. The compiler reached all five through `use java`, and stderr
    # had a module of its own for it -- `System.err` is a static field, which
    # the interop cannot name, so `errio.dawn` went through a method handle.
    # That module is deleted; std/io spells all five now.
    eff1(bsig("io_eprint", [TyString], ["s"], TyUnit), EIo),
    eff1(bsig("io_eprintln", [TyString], ["s"], TyUnit), EIo),
    # `Unit`, not `Never`: it maps to `System.exit`, which the JVM types as
    # void, and a Never-returning intrinsic would need the emitters to stop
    # treating a call as falling through -- machinery `panic` has and nothing
    # else needs.
    eff1(bsig("io_exit", [TyInt], ["code"], TyUnit), EIo),
    eff1(bsig("io_exists", [TyString], ["path"], TyBool), EIo),
    # throws on failure, like read_file/write_file; std wraps it in a barrier
    eff1(bsig("io_mkdirs", [TyString], ["path"], TyUnit), EIo),
    # The rest of what a package manager and a language server need. Measured,
    # not guessed: each one has a call site in the compiler that reaches it
    # through `use java` today. Deliberately absent are the ones only the JVM
    # side wants -- class-path properties, process spawning, `canExecute` --
    # because a native `dawn run` will not spawn a JVM at all.
    eff1(bsig("io_cwd", [], [], TyString), EIo),
    eff1(bsig("io_getenv", [TyString], ["name"], opt_ty(TyString)), EIo),
    # the binary halves of read_file/write_file; same throw-on-failure contract,
    # and write_bytes likewise creates the parent directories
    eff1(bsig("io_read_bytes", [TyString], ["path"], TyBytes), EIo),
    eff1(bsig("io_write_bytes", [TyString, TyBytes], ["path", "content"], TyUnit), EIo),
    # The ABI stays Bool: true means deleted, false means missing, and every
    # other host failure raises a fault. std/io gives that split public names.
    eff1(bsig("io_delete", [TyString], ["path"], TyBool), EIo),
    # Atomic when src and dst share a filesystem, which is why `io_temp_dir`
    # takes the parent: staging inside the destination's directory is what makes
    # "download, verify, then publish under the content hash" indivisible.
    eff1(bsig("io_rename", [TyString, TyString], ["src", "dst"], TyUnit), EIo),
    # `parent == ""` means the system temp directory.
    eff1(bsig("io_temp_dir", [TyString, TyString], ["parent", "prefix"], TyString), EIo),
    # The file half of `io_temp_dir`, and the half an atomic replace needs: a
    # freshly *created* sibling whose name nothing else can be holding. Both
    # backends create it exclusively -- `Files.createTempFile`, `mkstemp(3)` --
    # so the name is claimed by the same call that picks it, and a caller that
    # instead spelled a name and opened it would have a window between the two.
    # The name is unpredictable for the same reason those two calls make it so:
    # a guessable staging name in a directory another user can write is a
    # symlink attack, and the destination directory of a project manifest is
    # not always private.
    eff1(bsig("io_temp_file", [TyString, TyString], ["parent", "prefix"], TyString), EIo),
    # Carry `src`'s permissions onto `dst`. It exists because publishing a file
    # by writing a *new* one and renaming it over the old one loses whatever
    # mode the old one had -- the new file's mode comes from the creating call
    # and the umask, and nothing else remembers what the caller is replacing.
    #
    # `src` is inspected without following a link, so the mode copied is the
    # one on the object named and never one a link points at. POSIX hosts copy
    # the permission bits; a host with no POSIX permission model copies the
    # read-only flag and nothing else, which is all such a host has to copy.
    # ACLs and extended attributes are out of scope on both -- the primitive
    # promises the mode bits it can name, not everything a filesystem may
    # attach to a file.
    eff1(bsig("io_copy_permissions", [TyString, TyString], ["src", "dst"], TyUnit), EIo),
    eff1(bsig("io_is_symlink", [TyString], ["path"], TyBool), EIo),
    # Exactly `n` bytes, short only at end of input -- so a short read *is* the
    # EOF signal. stdin is a channel like stderr, and for the same reason it
    # cannot be reached through the interop: `System.in` is a static field.
    eff1(bsig("io_read_stdin", [TyInt], ["n"], TyBytes), EIo),
    # `true` iff at least one byte of standard input can be read right now.
    #
    # End of input is **not** readiness: it is reported by the blocking read
    # above, which stays the only reader. That is the one shape both backends
    # can implement without a thread -- a "the read will not block" reading
    # would have to answer `true` at end of input, and the JVM cannot tell
    # that state from a silent-but-open one (`available()` is 0 for both).
    # Measured both ways in docs/audit/lsp-robustness-design.md 2.2.1.
    #
    # `timeout_ms` is an upper bound and not a lower one: an early `false` is
    # always allowed, because the only thing a caller may do with `false` is
    # stop waiting and block. A loop driven by readiness *alone* therefore
    # spins at end of input; the loop is expected to block when it has nothing
    # else to do, which is what selfhost/src/lsp/server.dawn does.
    eff1(bsig("io_stdin_ready", [TyInt], ["timeout_ms"], TyBool), EIo),
    # Spawn `argv[0]` (found on PATH), wait, and answer its exit status.
    #
    # Both streams go to files rather than back through a pipe, and that is
    # the whole design: a pipe has a finite buffer, so a caller that waits for
    # the child before reading it deadlocks as soon as the child writes more
    # than the buffer holds. Reading concurrently means threads on the JVM and
    # `poll` here -- a concurrency requirement inside a primitive, to hand back
    # bytes the caller usually wants on disk anyway. An empty path inherits
    # this process's stream.
    #
    # Spawn failure (no such program) throws, like read_file; the exit status
    # is the child's own and is not an error.
    eff1(
      bsig("io_run", [TyList(TyString), TyString, TyString], ["argv", "out_path", "err_path"],
        TyInt),
      EIo
    ),
    Sig { ..bsig("map_empty", [], [], TyMap(k, v)), tparams: [k, v] },
    tp1(bsig("set_empty", [], [], TySet(t)), t),
    keyed2(bsig("map_from", [TyList(TyTuple([k, v]))], ["entries"], TyMap(k, v)), k, v),
    keyed1(bsig("set_from", [TyList(t)], ["xs"], TySet(t)), t),
    keyed2(bsig("map_insert", [TyMap(k, v), k, v], ["m", "key", "value"], TyMap(k, v)), k, v),
    keyed1(bsig("set_insert", [TySet(t), t], ["s", "x"], TySet(t)), t),
    keyed2(bsig("map_remove", [TyMap(k, v), k], ["m", "key"], TyMap(k, v)), k, v),
    keyed1(bsig("set_remove", [TySet(t), t], ["s", "x"], TySet(t)), t),
    keyed2(bsig("map_get", [TyMap(k, v), k], ["m", "key"], opt_ty(v)), k, v),
    keyed2(bsig("map_has", [TyMap(k, v), k], ["m", "key"], TyBool), k, v),
    keyed1(bsig("set_has", [TySet(t), t], ["s", "x"], TyBool), t),
    Sig { ..bsig("map_size", [TyMap(k, v)], ["m"], TyInt), tparams: [k, v] },
    tp1(bsig("set_size", [TySet(t)], ["s"], TyInt), t),
    Sig { ..bsig("map_keys", [TyMap(k, v)], ["m"], TyList(k)), tparams: [k, v] },
    Sig { ..bsig("map_values", [TyMap(k, v)], ["m"], TyList(v)), tparams: [k, v] },
    Sig {
      ..bsig("map_entries", [TyMap(k, v)], ["m"], TyList(TyTuple([k, v]))),
      tparams: [k, v]
    },
    # a fold over the trie itself, so reading every entry does not build the
    # entry list `map_entries` answers with. Unbounded like the other readers:
    # visiting entries hashes and compares no keys. The row rides through the
    # step the way `sort_by`'s rides through its comparator.
    eff1(
      Sig {
      ..bsig("map_fold", [TyMap(k, v), a, TyFn([a, k, v], a, e)], ["m", "init", "f"], a),
      tparams: [k, v, a]
    },
      e
    ),
    tp1(bsig("set_to_list", [TySet(t)], ["s"], TyList(t)), t),
    # array_* intrinsics: the one collection primitive a backend implements, and
    # the whole of what std needs to build List/Map/Set on top (D1). Values, not
    # storage: every operation returns a new array and none of them is observably
    # destructive. `array_push` is the one that must extend in place when it can
    # -- see the note on the fast path below.
    tp1(bsig("array_new", [], [], TyArray(t)), t),
    tp1(bsig("array_len", [TyArray(t)], ["a"], TyInt), t),
    tp1(bsig("array_get", [TyArray(t), TyInt], ["a", "i"], t), t),
    tp1(bsig("array_push", [TyArray(t), t], ["a", "x"], TyArray(t)), t),
    tp1(bsig("array_with", [TyArray(t), TyInt, t], ["a", "i", "x"], TyArray(t)), t),
    # `array_get` for a caller about to overwrite the slot: on native, a
    # unique array hands the slot's own reference out instead of pinning an
    # extra count on the child for the duration of the rebuild. Value
    # semantics are `array_get`'s -- the difference is a count, and only the
    # native runtime has counts (dawn_rt.h spells the caller's obligation).
    tp1(bsig("array_steal", [TyArray(t), TyInt], ["a", "i"], t), t),
    # HAMT bitmaps; a pure-Dawn loop would do, so this is only here because
    # every target has the instruction (docs/runtime-intrinsics-design.md §5).
    bsig("popcount", [TyInt], ["n"], TyInt)
  ]
  for s in sigs { out = map.insert(out, s.name, s) }
  out
}

# ---- what an intrinsic is beyond its signature ----
#
# Three properties, and until 2026-07-26 each was re-derived from the *name*,
# by prefix matching, in a different file: `array_` meant "arguments cross
# erased" in lower.dawn, "dawn/rt/Array" in emit.dawn, and "std may name it"
# in a hand-written list in checker.dawn. Nothing checked that the three
# agreed, and the lists had to be edited in step by hand.
#
# They are declared here now, once, and the three consumers ask. The families
# are still families -- `map_*` really is one group with one owner -- but the
# grouping is stated in one place rather than guessed in three.

## Which runtime module implements a primitive. The language names the module;
## each backend maps it to whatever it emits -- a JVM class, a C translation
## unit -- which is the point of having a contract at all
## (runtime-intrinsics-design.md 4).
pub type Rt =
  | RtStrings
  | RtBytes
  | RtArray
  | RtIo

pub type Intr = {
  sig: Sig,
  ## which runtime module implements it. None = the backend writes instructions
  ## for it inline (arithmetic, and the type-directed ones).
  ##
  ## The *name* is deliberately not recorded: a primitive is called by its own
  ## name in whichever module owns it. This field used to carry one, and every
  ## entry it held was the intrinsic's name re-spelled in Java's casing --
  ## which made it one backend's convention living in the shared table, and
  ## meant a second backend could not read the table at all.
  rt: Option[Rt],
  ## arguments and result cross at the erased type, so the declared signature
  ## *is* the ABI and lowering puts the box and the unbox in. The container
  ## primitives are why it exists; `bracket` is here too, for the same reason
  ## read the other way -- it hands back a bare type variable.
  erased: Bool,
  ## only std may name it -- the backend contract, not language surface
  internal: Bool
}

fn intr_of(s: Sig, o: Option[Rt], erased: Bool, internal: Bool) -> Intr =
  Intr { sig: s, rt: o, erased: erased, internal: internal }

## Every intrinsic, with the three properties declared.
pub fn intrinsics() -> Map[String, Intr] = {
  let bs = builtins()
  var rt_of: Map[String, Rt] = map.empty()
  var erased: Set[String] = set.empty()
  var internal: Set[String] = set.empty()

  # No runtime module owns a list primitive any more. Each one is a call on
  # the Dawn vector in std/pvec, written by whichever backend is emitting --
  # which is a backend's choice of representation, not a contract the
  # language states. `join`/`code_points`/`from_code_points`/`io_list_names`/
  # `io_run` are absent below for a related reason: each does reach a runtime
  # function, but only through a List↔Array conversion the emitter wraps around
  # it, and a plain entry here would promise a call the emitter cannot make.
  # strings: the Unicode tables, plus the cursor walk they and std/str rest on.
  # `cursor_slice` is absent on purpose -- the emitter writes it inline so it
  # can check the range and panic.
  # Of the three numeric parsers only `parse_float` still owns a runtime
  # method: the decimal-to-binary conversion std/fmt.atod delegates after its
  # EBNF validation (audit RP-05). `parse_int`/`parse_int_radix` lower to
  # std/fmt source and never reach a backend.
  rt_of = map.insert(rt_of, "parse_float", RtStrings)
  for op in ["letter", "digit", "alnum", "upper", "lower", "space"] {
    rt_of = map.insert(rt_of, "char_is_" ++ op, RtStrings)
  }
  for op in ["start", "end", "done", "char", "next", "prev"] {
    rt_of = map.insert(rt_of, "cursor_" ++ op, RtStrings)
  }
  # Case folding is the table, `str.to_lower`/`str.to_upper` is the spelling.
  # Both existed until 2026-07-30 and the intrinsic one was reachable from user
  # code, which is two names for one operation and a second thing to keep
  # documented (docs/audit/re-audit-2026-07-30.md RD-02).
  for op in ["lower", "upper"] {
    rt_of = map.insert(rt_of, "str_" ++ op, RtStrings)
    internal = set.insert(internal, "str_" ++ op)
  }
  # The byte primitives are std-only for the reason std/bytes exists: their
  # result shapes are sentinels. `bytes_at` answers -1 out of range, and
  # turning that into a panic is the whole of what `bytes.at` does.
  # `bytes_decode_utf8`/`bytes_decode_latin1` have no sentinel left to unwrap
  # and are std-only for the plainer reason: std/bytes owns the byte surface,
  # and two spellings of one operation is one too many.
  # `bytes_from_array` also names Array, which is std-only on its own.
  for op in ["utf8", "decode_utf8", "decode_latin1", "len", "at", "slice",
    "from_array"] {
    rt_of = map.insert(rt_of, "bytes_" ++ op, RtBytes)
    internal = set.insert(internal, "bytes_" ++ op)
  }
  let io_in_rt = ["print", "println", "eprint", "eprintln", "read_line", "is_dir", "read_file",
    "write_file", "exit", "exists", "mkdirs", "cwd", "getenv", "read_bytes", "write_bytes",
    "delete", "rename", "temp_dir", "temp_file", "copy_permissions", "is_symlink", "read_stdin",
    "stdin_ready"]
  for op in io_in_rt {
    rt_of = map.insert(rt_of, "io_" ++ op, RtIo)
  }
  # Every io primitive is std-only, `list_names`/`run` included -- one list plus
  # the two, rather than a second copy of twenty names, so an io primitive
  # cannot be added to one of these loops and not the other.
  #
  # This is the error model's boundary and not a style preference:
  # `io_read_file` raises a *fault* on failure, and std/io is where that becomes
  # `Result[String, String]`. Called directly, the fault reaches the user as a
  # JVM stack trace on one backend and a `longjmp` on the other -- the whole of
  # spec 8 routed around by spelling a name (RD-02).
  for op in io_in_rt ++ ["list_names", "run"] {
    internal = set.insert(internal, "io_" ++ op)
  }
  rt_of = map.insert(rt_of, "catch_fault", RtIo)
  rt_of = map.insert(rt_of, "catch_panic", RtIo)
  # `bracket` joins them in the io runtime, and is `erased` for the reason the
  # flag names rather than the container family it was introduced for: its
  # declared signature *is* its ABI. The resource goes in at `A` and the answer
  # comes back at `B`, both bare type variables, so lowering owes a box on the
  # argument and an unbox on the result -- an intrinsic answering a bare type
  # variable is the first one outside the collections, and without this the
  # call site would read a box as whatever `B` turned out to be.
  rt_of = map.insert(rt_of, "bracket", RtIo)
  erased = set.insert(erased, "bracket")

  # The persistent Map/Set: erased on both sides, and std-only. No runtime
  # module owns them any more -- lowering turns each into a call on the Dawn
  # trie in std/hamt, so a backend implements `Array` and nothing else
  # (docs/collections-dejava-research.md §5.1).
  for op in ["empty", "from", "insert", "remove", "get", "has", "size", "keys", "values",
    "entries", "fold"] {
    let n = "map_" ++ op
    erased = set.insert(erased, n)
    internal = set.insert(internal, n)
  }
  for op in ["empty", "from", "insert", "remove", "has", "size", "to_list"] {
    let n = "set_" ++ op
    erased = set.insert(erased, n)
    internal = set.insert(internal, n)
  }
  # Array is the one collection primitive a backend must implement (D1)
  for op in ["new", "len", "get", "push", "with", "steal"] {
    let n = "array_" ++ op
    rt_of = map.insert(rt_of, n, RtArray)
    erased = set.insert(erased, n)
    internal = set.insert(internal, n)
  }
  rt_of = map.insert(rt_of, "popcount", RtArray)
  internal = set.insert(internal, "popcount")
  # the cursor walk and the search it rests on are the representation, not
  # surface: std/str spells the public API over them
  for op in ["start", "end", "done", "char", "next", "prev", "slice"] {
    internal = set.insert(internal, "cursor_" ++ op)
  }
  # The unchecked Int -> Char bridge: internal for the reason RD-01 removed
  # pvec's public unchecked reader, and with no `rt` because it never reaches
  # a backend -- lowering replaces the call with its argument.
  internal = set.insert(internal, "char_unchecked")

  var out: Map[String, Intr] = map.empty()
  for n in map.keys(bs) {
    let s = map.get(bs, n).expect("builtin listed")
    out = map.insert(out, n,
      intr_of(s, map.get(rt_of, n), set.has(erased, n), set.has(internal, n)))
  }
  out
}

## One intrinsic, for a caller that asks once. It rebuilds the whole table to
## answer, so a caller that asks per call site must hold `intrinsics()` instead
## and read it with `map.get` -- lowering keeps it in `LSt.intrs`, the JVM
## emitter in `GenCtx.intrs`, the native one in `CSt.intrs`, and the checker in
## `Cx.bins`/`Cx.hidden_bins`. Every remaining caller here is a test.
pub fn intr_at(name: String) -> Option[Intr] = map.get(intrinsics(), name)

## Builtins with no public spelling (docs/stdlib-naming.md): the container and
## cursor families are implementation detail behind std/map, std/set and
## std/cursor — visible when checking std itself, hidden from user code.
## `intr_at` rebuilds the whole intrinsic table for one lookup, so asking it
## per key rebuilt it once per intrinsic -- quadratic, on a path name
## resolution walks for every builtin name it resolves. One table, then read
## it; and the checker reads this one once per module, into `Cx.hidden_bins`.
pub fn internal_builtins() -> Set[String] = {
  let it = intrinsics()
  var out: Set[String] = set.empty()
  for n in map.keys(it) {
    match map.get(it, n) {
      Some(i) -> if i.internal { out = set.insert(out, n) }
      None -> ()
    }
  }
  out
}

## The reuse-analysis exceptions (docs/perceus-design.md 6): argument
## positions the native runtime consumes rather than borrows. `array_with`
## takes its array owned because uniqueness is only decidable after the caller
## hands its reference over -- a borrowed argument keeps the caller's count on
## it and `rc == 1` can never hold -- and takes the element owned because
## every call site passes a freshly built value that would otherwise cross
## through a dup/drop pair. `list_push` takes its list owned for the same
## uniqueness reason: it compiles to `std/pvec.push`, an ordinary Dawn
## function that releases what it is handed, and a compensating dup at the
## call site would pin the accumulator's count at >= 2 -- which forecloses
## in-place reuse down the whole trie descent. A function rather than an
## `Intr` field: the rc pass asks at every intrinsic node, and this answer
## must not cost a table.
pub fn intr_owned_args(name: String) -> List[Int] =
  if name == "array_with" {
    [0, 2]
  } else if name == "list_push" {
    [0]
  } else {
    []
  }

# ---- tests ----

test "every intrinsic property is declared against a real intrinsic" {
  let bs = builtins()
  let it = intrinsics()
  # the two tables cover the same names: a property declared for a name that
  # is not an intrinsic used to be invisible, because each consumer only ever
  # asked about names it happened to reach
  assert len(map.keys(it)) == len(map.keys(bs))
  for n in map.keys(it) {
    assert map.has(bs, n)
  }
  # the three properties, spot-checked at the boundaries the old prefix chains
  # got wrong: `cursor_slice` is internal but has no runtime target (the
  # emitter writes it inline to check the range), `popcount` is owned by Array
  # without being an `array_` name, and `len` is neither.
  let slice = intr_at("cursor_slice").expect("cursor_slice")
  assert slice.internal
  assert slice.rt == None
  let pc = intr_at("popcount").expect("popcount")
  assert pc.internal
  assert pc.rt == Some(RtArray)
  assert not pc.erased
  let ln = intr_at("len").expect("len")
  assert not ln.internal
  assert not ln.erased
  assert ln.rt == None
  # erased is the container primitives, and only those
  assert intr_at("map_get").expect("map_get").erased
  assert intr_at("array_push").expect("array_push").erased
  assert not intr_at("str_upper").expect("str_upper").erased
}

test "the narrowed decoders drop the charset, and the Option with it" {
  # audit RP-04 decision C, all three phases done: the primitives landed,
  # std/bytes moved onto them, and the charset-taking `bytes_decode` is gone.
  #
  # What made this a narrowing rather than two more primitives is the shape.
  # The retired decoder answered an Option for exactly one reason -- the
  # charset may be a name it cannot decode -- so with the parameter gone the
  # failure has no case left to report, and a `.expect` at every call site
  # would be unwrapping something that cannot be `None`.
  assert intr_at("bytes_decode") == None
  for n in ["bytes_decode_utf8", "bytes_decode_latin1"] {
    let i = intr_at(n).expect(n)
    assert i.sig.param_tys == [TyBytes]
    assert i.sig.ret == TyString
    # std-only, like every byte primitive: std/bytes owns the surface
    assert i.internal
    assert i.rt == Some(RtBytes)
    assert not i.erased
  }
}

test "effect union normalizes" {
  let e1 = EffVar("e1", 1)
  let e2 = EffVar("e2", 2)
  assert eff_union([EPure, EPure]) == EPure
  assert eff_union([e1, EPure]) == e1
  # io does not swallow the variable: an atom is an evidence slot, and the
  # union is where a row's slots are counted (see `base_union`)
  assert eff_union([e1, EIo]) == EUnion([(1, "e1")], [], true)
  assert eff_union([e2, e1]) == EUnion([(1, "e1"), (2, "e2")], [], false)
  assert eff_union([e1, e1]) == e1
  assert lub_eff(EPure, EIo) == EIo
}

test "effect subsumption" {
  let e1 = EffVar("e1", 1)
  let e2 = EffVar("e2", 2)
  let un = eff_union([e1, e2])
  assert eff_subsumes(EIo, un)
  assert eff_subsumes(un, e1)
  assert eff_subsumes(un, EPure)
  assert not eff_subsumes(e1, EIo)
  assert not eff_subsumes(e1, e2)
  assert eff_subsumes(un, un)
}

test "effect rendering" {
  assert eff_suffix(EPure) == ""
  assert eff_suffix(EIo) == " !io"
  assert eff_suffix(EffVar("e", 7)) == " !e"
  assert eff_show(EUnion([(2, "b"), (1, "a")], [], false)) == "(a|b)"
  assert eff_show(EffAssoc("C", 9, 4, "E")) == "C.E"
  assert eff_suffix(EffAssoc("C", 9, 4, "E")) == " !C.E"
}

test "projection atoms normalize beside variables and io" {
  let e1 = EffVar("e1", 1)
  let a = EffAssoc("C", 9, 4, "E")
  let b = EffAssoc("D", 12, 4, "E")
  # a single atom is itself, not a one-entry union
  assert eff_union([a, EPure]) == a
  assert eff_union([a, a]) == a
  # atoms sort by (tvar, trait, name); variables keep the id sort
  assert eff_union([b, a, e1]) == EUnion([(1, "e1")], [("C", 9, 4, "E"), ("D", 12, 4, "E")], false)
  # io absorbs neither: both are pending evidence, and a swallowed one would
  # have no parameter to arrive through
  assert eff_union([a, e1, EIo]) == EUnion([(1, "e1")], [("C", 9, 4, "E")], true)
  assert eff_union([a, EIo]) == EUnion([], [("C", 9, 4, "E")], true)
  # labels ride on the second axis over an atom base, unchanged
  assert eff_union([a, ELabeled(EPure, [(7, "Ask")])]) == ELabeled(a, [(7, "Ask")])
}

test "projection subsumption is exact containment" {
  let e1 = EffVar("e1", 1)
  let a = EffAssoc("C", 9, 4, "E")
  let b = EffAssoc("D", 12, 4, "E")
  assert eff_subsumes(a, a)
  assert eff_subsumes(a, EPure)
  assert not eff_subsumes(a, b)
  assert not eff_subsumes(a, e1)
  # io never covers an atom, in either position
  assert not eff_subsumes(EIo, a)
  assert not eff_subsumes(a, EIo)
  assert eff_subsumes(eff_union([a, EIo]), a)
  assert eff_subsumes(eff_union([a, EIo]), EIo)
  assert eff_subsumes(eff_union([a, e1]), a)
  assert not eff_subsumes(eff_union([a, e1]), b)
  # accessors agree with the normal form
  assert eff_assocs(eff_union([b, a])) == [("C", 9, 4, "E"), ("D", 12, 4, "E")]
  assert eff_vars(eff_union([a, e1])) == [(1, "e1")]
  assert eff_labels(eff_union([a, ELabeled(EPure, [(7, "Ask")])])) == [(7, "Ask")]
}

test "projections reduce through an impl's effect bindings" {
  let a = EffAssoc("C", 9, 4, "E")
  let other = EffAssoc("C", 9, 5, "E")
  let ask = ELabeled(EPure, [(7, "Ask")])
  # bound to a label: the atom becomes that label's row
  assert reduce_eff_via_bindings(a, 9, 4, [("E", ask)]) == ask
  # bound to io / pure
  assert reduce_eff_via_bindings(a, 9, 4, [("E", EIo)]) == EIo
  assert reduce_eff_via_bindings(a, 9, 4, [("E", EPure)]) == EPure
  # a different trait's atom on the same subject stays put
  assert reduce_eff_via_bindings(other, 9, 4, [("E", ask)]) == other
  # the rest of the row rides along
  let row = eff_union([a, EffVar("e1", 1), ELabeled(EPure, [(2, "Log")])])
  assert reduce_eff_via_bindings(row, 9, 4, [("E", ask)]) ==
    ELabeled(EffVar("e1", 1), [(2, "Log"), (7, "Ask")])
}

test "effect groundness excludes variables and projections" {
  assert eff_is_ground(EPure)
  assert eff_is_ground(EIo)
  assert eff_is_ground(ELabeled(EIo, [(7, "Ask")]))
  assert not eff_is_ground(EffVar("e", 1))
  assert not eff_is_ground(EffAssoc("C", 9, 4, "E"))
  assert not eff_is_ground(eff_union([EffAssoc("C", 9, 4, "E"), EIo]))
}

## The rule the pattern side and the call side now share, stated once. Both
## used to hold a copy of this loop, and a copy is only as good as the case
## that reaches it: the five answers below are each an error message on one
## side and a different one on the other, so an outcome this test does not name
## is one the two spellings are free to drift apart on again.
test "an argument lands on the field its position or its name says" {
  let fs = [FieldI { name: "a", ty: TyInt }, FieldI { name: "b", ty: TyBool }]
  let some: fn(String) -> Option[String] = n => Some(n)
  let pos: Option[String] = None

  # the positional prefix takes fields left to right
  assert ctor_slots(fs, [pos, pos], false) == [SlotAt(0), SlotAt(1)]
  assert ctor_slots(fs, [], false) == []
  # a name takes the field it names, in any order, and may follow a position
  assert ctor_slots(fs, [some("b"), some("a")], false) == [SlotAt(1), SlotAt(0)]
  assert ctor_slots(fs, [pos, some("b")], false) == [SlotAt(0), SlotAt(1)]
  # but a position may not follow a name -- and the refusal does not fill the
  # field it would have taken, so the "missing field" count stays honest
  assert ctor_slots(fs, [some("a"), pos], false) == [SlotAt(0), SlotAfterNamed]
  # a name with no field, a position past the last field, and a field filled
  # twice by either spelling
  assert ctor_slots(fs, [some("zz")], false) == [SlotNoField("zz")]
  assert ctor_slots(fs, [pos, pos, pos], false) == [SlotAt(0), SlotAt(1), SlotOverflow]
  assert ctor_slots(fs, [some("a"), some("a")], false) == [SlotAt(0), SlotTaken(0)]
  assert ctor_slots(fs, [pos, some("a")], false) == [SlotAt(0), SlotTaken(0)]
  # a constructor with no fields has nothing for a positional argument to take
  let none_fs: List[FieldI] = []
  assert ctor_slots(none_fs, [pos], false) == [SlotOverflow]
  assert ctor_slots(none_fs, [some("a")], false) == [SlotNoField("a")]
}

test "arg_slots is the same rule over bare names" {
  let some: fn(String) -> Option[String] = n => Some(n)
  let pos: Option[String] = None
  assert arg_slots(["a", "b"], [pos, some("b")], false) == [SlotAt(0), SlotAt(1)]
  assert arg_slots(["a", "b"], [some("b"), some("a")], false) == [SlotAt(1), SlotAt(0)]
  assert arg_slots(["a", "b"], [some("a"), pos], false) == [SlotAt(0), SlotAfterNamed]
  # the first slot of a given name wins -- the point the two pre-ctor_slots
  # copies drifted on (one scanned forward, one backward), pinned here because
  # a duplicate is a declaration error only for constructors, and nothing else
  # says which copy of the rule a future caller gets
  assert arg_slots(["x", "x"], [some("x")], false) == [SlotAt(0)]
  assert arg_slots(["x", "x"], [some("x"), some("x")], false) == [SlotAt(0), SlotTaken(0)]
}

test "a trailing closure fills the last declared slot" {
  let some: fn(String) -> Option[String] = n => Some(n)
  let pos: Option[String] = None
  # the last of `given` lands on the last slot, past any named arguments --
  # the after-named refusal does not apply to it (spec §4.3)
  assert arg_slots(["gap", "body"], [some("gap"), pos], true) == [SlotAt(0), SlotAt(1)]
  # positional prefix plus a trailing closure is the identity mapping
  assert arg_slots(["a", "body"], [pos, pos], true) == [SlotAt(0), SlotAt(1)]
  # the last slot already filled -- by name or by position -- answers
  # SlotTaken, which the call sites report with trailing wording
  assert arg_slots(["a", "body"], [some("body"), pos], true) == [SlotAt(1), SlotTaken(1)]
  assert arg_slots(["body"], [pos, pos], true) == [SlotAt(0), SlotTaken(0)]
  # no slots at all: overflow, counted by the arity report
  let no_params: List[String] = []
  assert arg_slots(no_params, [pos], true) == [SlotOverflow]
}

test "type rendering" {
  let adts = prelude_adts()
  let traits = prelude_traits()
  assert ty_show(adts, TyMap(TyInt, TyList(TyString))) == "Map[Int, List[String]]"
  assert ty_show(adts, opt_ty(TyInt)) == "Option[Int]"
  assert ty_show(adts, TyAdt(RESULT_ID, [])) == "Result"
  assert ty_show(adts, TyTuple([TyInt, TyBool])) == "(Int, Bool)"
  assert ty_show(adts, TyFn([TyInt], TyUnit, EIo)) == "fn(Int) -> Unit !io"
  let pure_inner = TyFn([], TyInt, EPure)
  let io_inner = TyFn([], TyInt, EIo)
  assert ty_show(adts, TyFn([], pure_inner, EIo)) == "fn() -> (fn() -> Int) !io"
  assert ty_show(adts, TyFn([], io_inner, EPure)) == "fn() -> fn() -> Int !io"
  assert ty_show(adts, TyFn([], io_inner, EIo)) == "fn() -> (fn() -> Int !io) !io"
  assert ty_show(adts, TyList(pure_inner)) == "List[fn() -> Int]"
  let outer = eff1(bsig("outer", [], [], pure_inner), EIo)
  assert sig_render(adts, traits, outer) == "fn outer() -> (fn() -> Int) !io"
  assert ty_show(adts, TyError) == "?"
  assert ty_show(adts, TyJava("java.sql.Connection", "Connection")) == "Connection"
  let phantom_int = TyOpaque(40, "Phantom", "m", [TyInt], TyUnit)
  let phantom_string = TyOpaque(40, "Phantom", "m", [TyString], TyUnit)
  assert phantom_int != phantom_string
  assert ty_show(adts, phantom_int) == "Phantom[Int]"
  assert ty_show(adts, phantom_string) == "Phantom[String]"
  assert type_args_of(phantom_int) == [TyInt]
}

test "substitution reaches every position" {
  let t = TyVar("T", 5)
  let m: Map[Int, Ty] = map.from([(5, TyInt)])
  let em: Map[Int, Eff] = map.empty()
  assert subst(TyList(t), m, em) == TyList(TyInt)
  assert subst(TyMap(t, TySet(t)), m, em) == TyMap(TyInt, TySet(TyInt))
  assert subst(opt_ty(t), m, em) == opt_ty(TyInt)
  assert subst(TyFn([t], t, EPure), m, em) == TyFn([TyInt], TyInt, EPure)
  assert subst(TyTuple([t, TyBool]), m, em) == TyTuple([TyInt, TyBool])
}

test "mentioning a type variable reaches every position substitution does" {
  let t = TyVar("T", 5)
  let u = TyVar("U", 6)
  assert ty_mentions_var(t, 5)
  assert not ty_mentions_var(t, 6)
  assert ty_mentions_var(TyList(t), 5)
  assert ty_mentions_var(TyMap(TyInt, TySet(t)), 5)
  assert ty_mentions_var(TyArray(t), 5)
  assert ty_mentions_var(opt_ty(t), 5)
  assert ty_mentions_var(TyFn([TyInt], t, EPure), 5)
  assert ty_mentions_var(TyFn([t], TyInt, EPure), 5)
  assert ty_mentions_var(TyTuple([TyBool, t]), 5)
  assert ty_mentions_var(TyOpaque(0, "N", "m", [], TyList(t)), 5)
  assert ty_mentions_var(TyAssoc(t, ITER_ID, "Item"), 5)
  # the same shapes with the other variable: a walk that answered `true`
  # everywhere would pass the block above and fail here
  assert not ty_mentions_var(TyList(u), 5)
  assert not ty_mentions_var(TyMap(TyInt, TySet(u)), 5)
  assert not ty_mentions_var(TyFn([u], u, EPure), 5)
  assert not ty_mentions_var(TyTuple([TyBool, u]), 5)
  assert not ty_mentions_var(TyString, 5)
}

## The wall's own test. Six walks used to spell the variant list out apiece, so
## six `match` arms had to be added for a new parameterised variant and the
## compiler said so six times; now it says so once, and this is what says the
## one place is complete. Every parameterised variant appears below with each
## of its type children in turn -- adding a variant without an arm fails to
## compile, adding an arm that drops a child fails here.
test "the traversal kernels reach every child of every parameterised variant" {
  let t = TyVar("T", 5)
  let to_int: fn(Ty) -> Ty = x => if x == t { TyInt } else { x }
  let is_t: fn(Ty) -> Bool = x => x == t

  assert ty_map_children(TyList(t), to_int) == TyList(TyInt)
  assert ty_map_children(TyMap(t, TyBool), to_int) == TyMap(TyInt, TyBool)
  assert ty_map_children(TyMap(TyBool, t), to_int) == TyMap(TyBool, TyInt)
  assert ty_map_children(TySet(t), to_int) == TySet(TyInt)
  assert ty_map_children(TyArray(t), to_int) == TyArray(TyInt)
  assert ty_map_children(TyTuple([TyBool, t]), to_int) == TyTuple([TyBool, TyInt])
  assert ty_map_children(opt_ty(t), to_int) == opt_ty(TyInt)
  assert ty_map_children(TyOpaque(0, "N", "m", [t], t), to_int) ==
    TyOpaque(0, "N", "m", [TyInt], TyInt)
  assert ty_map_children(TyAssoc(t, ITER_ID, "Item"), to_int) ==
    TyAssoc(TyInt, ITER_ID, "Item")
  # both a function type's parameters and its result, and the effect rides
  # through -- it is not a type and this walk has nothing to say about it
  assert ty_map_children(TyFn([t], TyBool, EIo), to_int) == TyFn([TyInt], TyBool, EIo)
  assert ty_map_children(TyFn([TyBool], t, EIo), to_int) == TyFn([TyBool], TyInt, EIo)
  # a variant with no type children is itself, and a variable is a leaf here:
  # what a type variable becomes is the caller's rule, not the walk's
  assert ty_map_children(TyString, to_int) == TyString
  assert ty_map_children(TyAdt(OPTION_ID, []), to_int) == TyAdt(OPTION_ID, [])
  assert ty_map_children(t, to_int) == t
  # immediate children only: the recursion belongs to the caller, and a kernel
  # that recursed on its own would apply the caller's leaf rule twice
  assert ty_map_children(TyList(TyList(t)), to_int) == TyList(TyList(t))

  assert ty_any_child(TyList(t), is_t)
  assert ty_any_child(TyMap(t, TyBool), is_t)
  assert ty_any_child(TyMap(TyBool, t), is_t)
  assert ty_any_child(TySet(t), is_t)
  assert ty_any_child(TyArray(t), is_t)
  assert ty_any_child(TyTuple([TyBool, t]), is_t)
  assert ty_any_child(opt_ty(t), is_t)
  assert ty_any_child(TyOpaque(0, "N", "m", [], t), is_t)
  assert ty_any_child(TyAssoc(t, ITER_ID, "Item"), is_t)
  assert ty_any_child(TyFn([t], TyBool, EIo), is_t)
  assert ty_any_child(TyFn([TyBool], t, EIo), is_t)
  # a walk that answered `true` everywhere would pass the block above
  assert not ty_any_child(TyList(TyBool), is_t)
  assert not ty_any_child(TyString, is_t)
  assert not ty_any_child(TyAdt(OPTION_ID, []), is_t)
  assert not ty_any_child(t, is_t)
  assert not ty_any_child(TyList(TyList(t)), is_t)
}

test "effect substitution collapses unions" {
  let e1 = EffVar("e1", 1)
  let e2 = EffVar("e2", 2)
  let un = eff_union([e1, e2])
  let em1: Map[Int, Eff] = map.from([(1, EIo)])
  assert subst_eff(un, em1) == EUnion([(2, "e2")], [], true)
  let em2: Map[Int, Eff] = map.from([(1, EPure)])
  assert subst_eff(un, em2) == e2
  let em3: Map[Int, Eff] = map.from([(1, e2)])
  assert subst_eff(un, em3) == e2
}

test "prelude shapes" {
  let adts = prelude_adts()
  let opt = adt_of(adts, OPTION_ID)
  assert opt.name == "Option"
  assert len(opt.ctors) == 2
  assert opt.ctors[1].name == "None"
  assert ctor_render(adts, opt.ctors[0]) == "Some(value: T): Option[T]"
  let traits = prelude_traits()
  assert trait_of(traits, ORD_ID).name == "Ord"
  assert trait_of(traits, EQ_ID).name == "Eq"
  assert trait_of(traits, HASH_ID).name == "Hash"
  assert trait_of(traits, SHOW_ID).name == "Show"
  assert trait_of(traits, ITER_ID).name == "Iter"
  assert trait_of(traits, INDEX_ID).name == "Index"
  assert trait_of(traits, DISPLAY_ID).name == "Display"
  # the two traits whose method name the language consumes on the user's
  # behalf, so neither injects it: `[]` calls `index`, `${...}` calls `display`
  assert not trait_of(traits, INDEX_ID).injects
  assert not trait_of(traits, DISPLAY_ID).injects
  # and Display carries no associated types, unlike the other non-injecting one
  assert len(trait_of(traits, DISPLAY_ID).assoc) == 0
  # each trait over its own list -- one table per question, which is the point
  assert len(prelude_impls()) == len(ord_scalars()) + len(eq_scalars()) +
    len(hash_scalars()) + len(show_scalars()) + 5
  # the three lists differ, and each difference is a decision (spec 4.3)
  assert not is_ord_scalar(TyFloat)
  assert is_eq_scalar(TyFloat)
  assert not is_hash_scalar(TyFloat)
}

test "builtin type inventory keeps its surface boundaries" {
  assert public_builtin_type_names() ==
    ["Int", "Char", "Float", "Bool", "String", "Bytes", "Unit", "List", "Map", "Set"]
  var std_only: List[String] = []
  var return_only: List[String] = []
  var compiler_only: List[String] = []
  for info in builtin_type_inventory() {
    match info.access {
      BtPublic -> { assert builtin_type_visible(info, false) }
      BtStdOnly -> {
        std_only = std_only ++ [info.name]
        assert not builtin_type_visible(info, false)
        assert builtin_type_visible(info, true)
      }
      BtReturnOnly -> {
        return_only = return_only ++ [info.name]
        assert not builtin_type_visible(info, false)
        assert not builtin_type_visible(info, true)
      }
      BtCompilerOnly -> {
        compiler_only = compiler_only ++ [info.name]
        assert not builtin_type_visible(info, false)
        assert not builtin_type_visible(info, true)
      }
    }
  }
  assert std_only == ["Array"]
  assert return_only == ["Never"]
  assert compiler_only == []
  assert ty_named("Char") == Some(ty_char())
  assert ty_named("Bytes") == Some(TyBytes)
  assert ty_named("List") == None
  assert ty_named("Array") == None
  assert ty_named("Never") == None
  let li = builtin_type_at("List").expect("List")
  let ma = builtin_type_at("Map").expect("Map")
  assert builtin_type_render(li) == "List[T]"
  assert builtin_type_render(ma) == "Map[K, V]"
  assert builtin_type_apply(li, [TyInt]) == TyList(TyInt)
  assert builtin_type_apply(ma, [TyString, TyInt]) == TyMap(TyString, TyInt)

  # Prelude ADTs are a separate nominal layer, not compiler-owned type names.
  # `ev$Pack` is in the table but not of that layer: `$` is not an identifier
  # character, so like the `ev$E` record an effect declaration synthesises it
  # shares the ADT namespace without ever being spellable in a header. The
  # surface list is therefore the three that are, and the split is asserted
  # here rather than left to the reader.
  let prelude = prelude_adts()
  let prelude_names = sort(map(map.keys(prelude), id => adt_of(prelude, id).name))
  assert prelude_names == ["ForeignError", "Option", "Result", "ev\$Pack"]
  var spellable: List[String] = []
  for n in prelude_names {
    if not str.contains(n, "\$") { spellable = spellable ++ [n] }
  }
  assert spellable == ["ForeignError", "Option", "Result"]
}

test "builtin table renders signatures" {
  let adts = prelude_adts()
  let traits = prelude_traits()
  let bs = builtins()
  match map.get(bs, "sort_by") {
    Some(s) -> {
      assert sig_render(adts, traits, s) ==
        "fn sort_by[T](xs: List[T], cmp: fn(T, T) -> Int !e) -> List[T] !e"
    }
    None -> { assert false }
  }
  match map.get(bs, "catch_fault") {
    Some(s) -> {
      # the binder renders and `sort_by`'s does not, which is the difference
      # between a variable a signature *declares* and one it merely raises:
      # `sort_by`'s `!e` reaches its row from the row itself, and the catch
      # pair's reaches nothing but the closure parameter, so only an eparams
      # entry can say where it was bound (types.sig_abi_eff).
      assert sig_render(adts, traits, s) ==
        "fn catch_fault[T, !e](f: fn() -> T !e) -> Result[T, ForeignError] !io"
    }
    None -> { assert false }
  }
  match map.get(bs, "map_entries") {
    Some(s) -> {
      assert sig_render(adts, traits, s) ==
        "fn map_entries[K, V](m: Map[K, V]) -> List[(K, V)]"
    }
    None -> { assert false }
  }
  match map.get(bs, "map_fold") {
    Some(s) -> {
      assert sig_render(adts, traits, s) ==
        "fn map_fold[K, V, A](m: Map[K, V], init: A, f: fn(A, K, V) -> A !e) -> A !e"
    }
    None -> { assert false }
  }
  match map.get(bs, "array_with") {
    Some(s) -> {
      assert sig_render(adts, traits, s) ==
        "fn array_with[T](a: Array[T], i: Int, x: T) -> Array[T]"
    }
    None -> { assert false }
  }
  match map.get(bs, "array_steal") {
    Some(s) -> {
      assert sig_render(adts, traits, s) ==
        "fn array_steal[T](a: Array[T], i: Int) -> T"
    }
    None -> { assert false }
  }
  # The one entry that renders two ways. `Object` is what a reader wants and
  # what every consumer of `sig_render` gets; `java.lang.Object` is what a
  # mirror of this table needs, because the short name is in no file's scope
  # and a signature carrying it is not Dawn source. The two are asserted
  # together so neither can be changed alone.
  match map.get(bs, "cast") {
    Some(s) -> {
      assert sig_render(adts, traits, s) ==
        "fn cast[T](x: Object) -> Result[T, ForeignError]"
      assert sig_render_fqn(adts, traits, s) ==
        "fn cast[T](x: java.lang.Object) -> Result[T, ForeignError]"
    }
    None -> { assert false }
  }
  # and an entry with no Java type in it renders the same under both, which is
  # what "one difference" means
  match map.get(bs, "map_entries") {
    Some(s) -> {
      assert sig_render_fqn(adts, traits, s) == sig_render(adts, traits, s)
    }
    None -> { assert false }
  }
  assert map_size2(bs) == 95
}

test "the reclaim's failure is a value, under the one name left" {
  # Step B of the error model (design doc 二.B): `cast` was declared pure and
  # left by throwing a ClassCastException, which is the one thing a pure
  # signature is supposed to rule out. It now hands the failure back.
  #
  # The transitional spelling is gone and its absence is asserted below:
  # leaving it behind would leave a second way to spell one reclaim in
  # `dawn doc --builtins` forever, and a second entry is a second thing that
  # can drift.
  let adts = prelude_adts()
  let traits = prelude_traits()
  let bs = builtins()
  match map.get(bs, "cast") {
    Some(s) -> {
      assert sig_render(adts, traits, s) ==
        "fn cast[T](x: Object) -> Result[T, ForeignError]"
    }
    None -> { assert false }
  }
  # Pure, and deliberately: the failure became a value, so there is no effect
  # to declare. The barriers are `!io` because the thunk they run is; this one
  # runs nothing.
  assert intr_at("cast").expect("cast").sig.eff == EPure
  # and the `rt` table does not carry it, although `dawn/rt/Io.cast` exists:
  # that route emits the descriptor the *signature* names, and this call needs
  # a second operand (the target class, which only the call site knows). Both
  # emitters therefore write the call themselves.
  assert intr_at("cast").expect("cast").rt == None
  match map.get(bs, "cast_e") {
    Some(_) -> { assert false }
    None -> { }
  }
  match intr_at("cast_e") {
    Some(_) -> { assert false }
    None -> { }
  }
}

test "no barrier renders its failure into a String any more" {
  # The end of the error model's migration (design doc 六): there is one pair
  # of barriers and its payload is structured. A String payload surviving
  # anywhere is the regression this asserts against -- it is what a caller has
  # to parse, and parsing it is ERR-02. The transitional `_e` spelling is gone,
  # and its absence is asserted here too: leaving it behind would leave a
  # second way to spell the same thing in `dawn doc --builtins` forever.
  let adts = prelude_adts()
  let traits = prelude_traits()
  let bs = builtins()
  for n in ["catch_fault", "catch_panic"] {
    match map.get(bs, n) {
      Some(s) -> {
        assert sig_render(adts, traits, s) ==
          "fn " ++ n ++ "[T, !e](f: fn() -> T !e) -> Result[T, ForeignError] !io"
        # and the barrier's own row is still `!io`, while the binder beside it
        # buys exactly one evidence slot: SEM-11's criterion is about what the
        # primitive raises, and opening the closure's row did not touch it
        assert eff_base(s.eff) == EIo
        assert nev(sig_abi_eff(s)) == 1
      }
      None -> { assert false }
    }
    # and each reaches the io runtime, which is where a backend implements it
    assert intr_at(n).expect(n).rt == Some(RtIo)
  }
  for n in ["catch_fault_e", "catch_panic_e"] {
    match map.get(bs, n) {
      Some(_) -> { assert false }
      None -> { }
    }
    match intr_at(n) {
      Some(_) -> { assert false }
      None -> { }
    }
  }
}

test "bracket protects a resource and hands the body's own answer back" {
  # The third barrier-family primitive (docs/core-move2-design.md 4, knife 1).
  # Four things about the signature are decisions, and all four are asserted
  # here because each has an alternative that also compiles:
  #
  #   the resource is a VALUE, not an acquire thunk. The thunk is what Haskell
  #   needs to close the window an asynchronous exception could arrive in;
  #   Dawn has no asynchronous failures and nothing of the caller's runs
  #   between the arguments and the handler, so acquisition is ordinary code
  #   before the call;
  #   the use-closure is LAST (Haskell's order), so a future `with`-style
  #   sugar that attaches the remaining block as the last argument has a
  #   primitive to attach it to -- and with the resource eager, such a site
  #   spells no lambda at all;
  #   the result is `B` and not a `Result`, because bracket does not catch --
  #   the failure carries on and a caller who wants it as a value wraps the
  #   whole thing in `catch_fault`;
  #   `release` answers `Unit`, so nothing a caller might read can be dropped
  #   on the floor by the unwind path;
  #   the row is a VARIABLE shared by release, use and the call, so protecting
  #   a pure resource leaves its user pure (SEM-11).
  let adts = prelude_adts()
  let traits = prelude_traits()
  let bs = builtins()
  match map.get(bs, "bracket") {
    Some(s) -> {
      # `body`, not `use`: the parameter is nameable in a call only if its
      # name is an identifier, and `use` is a keyword (see the table)
      assert sig_render(adts, traits, s) ==
        "fn bracket[A, B](resource: A, release: fn(A) -> Unit !e, " ++
        "body: fn(A) -> B !e) -> B !e"
    }
    None -> { assert false }
  }
  let i = intr_at("bracket").expect("bracket")
  # the io runtime implements it, as it implements the two barriers
  assert i.rt == Some(RtIo)
  # its declared signature is its ABI: the result comes back erased and
  # lowering is what unboxes it
  assert i.erased
  # and it is language surface, not a std-only backend contract
  assert not i.internal
  # the row is erased before either backend sees it, so the same runtime method
  # serves every instantiation -- effect polymorphism costs the emitters nothing
  assert i.sig.eff == EffVar("e", -1)
}

test "ForeignError is a prelude record whose fields every backend can answer" {
  let adts = prelude_adts()
  let fe = adt_of(adts, FOREIGN_ERROR_ID)
  assert fe.name == "ForeignError"
  assert fe.is_record
  assert fe.tparams == []
  assert fe.derives_show
  let ci = fe.ctors[0]
  # a record's one constructor wears the type's name, as every other record does
  assert ci.name == "ForeignError"
  assert len(ci.fields) == 3
  assert ci.fields[0].name == "kind"
  assert ci.fields[0].ty == TyString
  assert ci.fields[1].name == "message"
  assert ci.fields[1].ty == TyString
  # the cause is optional because only some backends have one, and rendered
  # because a `ForeignError` inside a `ForeignError` would be a cycle in a
  # record the emitters build by hand
  assert ci.fields[2].name == "cause"
  assert ci.fields[2].ty == opt_ty(TyString)
  assert ty_show(adts, foreign_error_ty()) == "ForeignError"
}

fn map_size2(m: Map[String, Sig]) -> Int = map.len(m)

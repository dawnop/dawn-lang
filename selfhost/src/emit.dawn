  OP_LRETURN, OP_LSHL, OP_LSHR, OP_LSTORE, OP_LSUB, OP_LUSHR, OP_LXOR, OP_NEW, OP_NEWARRAY,
  OP_POP, OP_POP2, OP_PUTFIELD, OP_PUTSTATIC, OP_RETURN, OP_SASTORE, V17

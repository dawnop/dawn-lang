# The lever. `nameless`'s type parameter appears only in its return type, so
# the call cannot be typed alone (`[nameless("x")]` is "cannot infer type
# parameter(s) T"). It types here because `anchor` settled the element type and
# the expectation reached into the conditional element's body.
#
# Deliberately unannotated: an annotation on the binding would supply the same
# expectation by another road, and then the assertion would not be about the
# element form at all.
pub type Tagged[T] = Tagged(label: String)

fn nameless[T](s: String) -> Tagged[T] = Tagged(label: s)

fn f(anchor: Tagged[Int], c: Bool) -> Int = {
  let out = [anchor, if c { nameless("x") }]
  len(out)
}

pub fn main() -> Unit = ()

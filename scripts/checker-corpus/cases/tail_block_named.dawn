# the tail block against named arguments and defaults (#206 K4): the block
# fills the last declared parameter or field, whatever named arguments came
# before it -- the "positional cannot follow named" refusal does not apply to
# it. The ok* half must produce no diagnostic at all.
use std/io

fn column(gap: Int = 0, align: Int = 1, body: fn() -> Unit !io) -> Unit !io = body()

fn run(body: fn() -> Unit !io) -> Unit !io = body()

# a constructor with fields (not a record: records are built with braces, so
# a tail block never reaches one -- their `{` is the literal itself)
pub type Widget = Panel(title: String, draw: fn() -> Unit !io)

# accepted: a named argument before the block, a default left to fill itself,
# the constructor spelling, and an explicit empty parameter head syntax
pub fn ok_named() -> Unit !io = column(gap: 12) { io.println("a") }
pub fn ok_default() -> Unit !io = column() { io.println("b") }
pub fn ok_ctor() -> Widget = Panel(title: "t") { io.println("c") }
pub fn ok_explicit_head() -> Unit !io = column(gap: 12) { () => io.println("d") }

# refused: the last parameter (or field) is given twice -- once by name, once
# by the block -- and the diagnostic says the block is what fills it
pub fn bad_param() -> Unit !io = run(body: noop) { io.println("x") }
pub fn bad_field() -> Widget = Panel(title: "t", draw: noop) { io.println("y") }

fn noop() -> Unit !io = ()

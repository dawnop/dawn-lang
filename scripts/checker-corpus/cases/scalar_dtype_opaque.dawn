# std/gpu: a scalar_arg launch argument is bounded by ScalarDtype, which only
# Int, Float, I32 and F32 implement. An opaque type over Float or Int does
# not inherit it from its target (it inherits Eq, Hash and Ord), so F16, BF16
# and I8 are refused where the value is made, not when a kernel records.
use std/gpu.{scalar_arg, Launch}
use std/narrow.{F16, BF16, f16, bf16}
use std/int/i8.{I8}

pub fn half() -> Launch[F16] = scalar_arg(f16(1.5))

pub fn brain() -> Launch[BF16] = scalar_arg(bf16(1.5))

pub fn small(x: I8) -> Launch[I8] = scalar_arg(x)

pub fn fine(x: Float, n: Int) -> (Launch[Float], Launch[Int]) = (scalar_arg(x), scalar_arg(n))

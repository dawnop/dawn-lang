# expect: `with` already passes the rest of the block to this call
# expect: allowed at module top level
# `with x <- f(a)` already attaches the rest of the block as `f`'s last
# argument (spec §4.10), so a tail block on the same call would be a second
# closure the author only sees as a `{`. Refused at the decision, not left to
# want_sep's "expected a newline" -- that message points at the consequence.
fn f() -> Unit !io = {
  with x <- use_it(1) { io.println("x") }
  io.println(to_string(x))
}

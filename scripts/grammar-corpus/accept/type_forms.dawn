# EBNF type_decl / sum_type / record_type / alias_decl / type_params, plus
# `opaque type` (spec 2.7) and a leading `|` on a sum.
pub type Shape =
  | Circle(r: Float)
  | Rect(w: Float, h: Float)

type Pt = { x: Int, y: Int }

pub type Box[T] = One(v: T)

pub alias Handler = fn(Int) -> Int

pub opaque type UserId = Int

type WithDerive = { a: Int } derive Show, Ord

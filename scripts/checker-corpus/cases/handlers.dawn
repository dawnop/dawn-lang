# checker.dawn: `with handle`
effect Ask {
  fn get() -> Int
  fn put(n: Int) -> Unit
}

fn asks() -> Int !Ask = get()

pub fn unknown_effect() -> Int = {
  with handle Nope { get() => 1 }
  2
}

pub fn not_an_op() -> Int = {
  with handle Ask {
    nope() => 1
    get() => 2
    put(n) => ()
  }
  asks()
}

pub fn twice() -> Int = {
  with handle Ask {
    get() => 1
    get() => 2
    put(n) => ()
  }
  asks()
}

pub fn missing() -> Int = {
  with handle Ask { get() => 1 }
  asks()
}

pub fn arity() -> Int = {
  with handle Ask {
    get(a, b) => 1
    put(n) => ()
  }
  asks()
}

pub fn arm_ret() -> Int = {
  with handle Ask {
    get() => "s"
    put(n) => ()
  }
  asks()
}

# Observation privileges follow the resolved declaration, never an import
# spelling. Keeping this list below checking and lowering gives both consumers
# one identity test without making metadata part of lexical effect evidence.
use check/types.{ty_opaque, Sig, Ty, TyOpaque, TyInt, ty_origin, provenance_static_type}
use check/capture
use check/identity

pub fn action(s: Sig) -> Bool =
  s.owner == Some("std/provenance") && s.trait_id == None &&
  (s.name == "note" || s.name == "completed" || s.name == "checkpoint" || s.name == "rewind")

pub fn entry(s: Sig) -> Bool =
  s.owner == Some("std/provenance") && s.trait_id == None && s.name == "observe"

pub fn trace(t: Ty) -> Bool =
  match t { TyOpaque(id, _, _, _, _, _, _, _) -> id == 5026688370391, _ -> false }

pub fn primitive(owner: String, name: String) -> Option[String] =
  if owner == "std/provenance" &&
    (name == "observe" || name == "note" || name == "completed" || name == "checkpoint" || name == "rewind" ||
        name == "word" || name == "header" || name == "column" || name == "field" || name == "number" || name == "render_snapshot" || name == "render_origin") {
    Some("provenance_" ++ name)
  } else { None }

test "observation nominal identities come from their standard declarations" {
  let origin = identity.derive(identity.minted("std/provenance", identity.TypeDecl, "Origin"))
  match ty_origin() { TyOpaque(id, _, _, _, _, _, _, _) -> { assert id == origin }, _ -> { assert false } }
  let table = identity.derive(identity.minted("std/provenance", identity.TypeDecl, "StaticTable"))
  match provenance_static_type() { TyOpaque(id, _, _, _, _, _, _, _) -> { assert id == table }, _ -> { assert false } }
  let scope = identity.derive(identity.minted("std/provenance", identity.TypeDecl, "TraceScope"))
  assert trace(ty_opaque(scope, "TraceScope", "std/provenance", [], TyInt, capture.empty_arguments(), capture.opaque_head(0, 0, 0)))
}

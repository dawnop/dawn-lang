# checker.dawn: trait bounds on type parameters
pub trait Mine[T] {
  fn m(x: T) -> Int
}

pub fn dup[T: Mine + Mine](x: T) -> Int = m(x)

pub fn unknown[T: Nope](x: T) -> Int = 1

pub fn tparams[T, T](x: T) -> Int = 1

type Free = F

pub fn needs_impl() -> Int = m(F)

pub fn forwards[T](x: T) -> Int = m(x)

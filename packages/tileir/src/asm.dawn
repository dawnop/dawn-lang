## How to call `tileiras` on the bytes `bytecode.encode` writes, for one
## assembler version and one `--gpu-name`: [`tileiras_args`] answers the
## arguments, and [`assembler_defect`] says why they are not the plain ones.
## [`assemble`] is the whole step in one call: a recorded program in, a cubin
## out, with the right arguments and the failures told apart.
##
## `std/gpu` never runs `tileiras`: a program hands `with_gpu_real` cubins
## somebody else assembled. [`assemble`] is that somebody for a program that
## has a `tileiras` binary at a path it can name, and the two functions
## beside it are for a build script that wants to run the assembler itself
## (scripts/tile-gpu-diff does).
#
# Why a table keyed on the EXACT assembler version and the exact target, and
# not a flag of the package. tileiras 13.4.92 writes wrong PTX for a loop that
# exits by `break` with two carried values when the target is in the
# sm_90/sm_100 family and the optimization level is 1 or above (issue #558,
# upstream NVIDIA/cuda-tile#25; tile-backend-design 6.28). The defect is a
# property of one binary on some targets, so the workaround is keyed on both:
# a fixed tileiras is another version string and gets the plain arguments
# without anybody remembering to take the workaround out, and sm_86 under the
# same 13.4.92 keeps its optimizer, since its PTX is correct.
#
# Why the program is a third key. The first form of this table lowered every
# program on the affected targets to `--opt-level 0`, which cost a flash_attn
# kernel 35x (bf16, sm_90) to 57x (sm_100) of its device time and a vadd 3x,
# and none of those programs has a `loop` that `break`s. The defect needs one,
# so [`has_break_loop`] asks the recorded program for that structure and only
# a program that has it pays. The test is wider than the four conditions the
# issue minimised (it counts any `break` loop, not just a two-carry one with a
# `reduce` exit), because which of those loops the optimizer breaks is its
# business and can change with a release; a `for` is a different operation
# that never reaches the defective pass. 6.28 has the measurements.
#
# Why `--opt-level 0` and not the previous assembler. 13.3.36 assembles the
# same kernels correctly, but it refuses bytecode 13.4, which is the only
# version bytecode.dawn writes, and four goldens (attr_ftof, insert_tile,
# powi_sweep, loop_return) use operations 13.3 does not have. 13.4.92 at
# `--opt-level 0` is correct on the minimised program and on every golden of
# the sm_90 and sm_100 ledgers. It costs device time (on sm_86, where it can
# be measured as a pure cost, up to 4.5x for kernels that compute and 8x for
# loop_until; 6.28), and only on the affected targets.
use std/bytes
use std/io.{Fs, Proc, temp_dir, write_bytes, read_bytes, read_file, write_file, copy_permissions, list_dir, delete, run, with_fs_real, with_proc_real}
use std/list
use std/str
use bytecode.{encode}
use std/dtype.{F64}
use prog.{TileProg, TileOp, For, Loop, Break, Reduce, Scan, If, trace_kernel, trace1, cells, Out}
use dev.{d_loop, d_range, carry, get, set, f_const, broadcast, reduce_max, abs, gt, store_cell}

# One known assembler defect: the `tileiras` version it was measured on, the
# `--gpu-name` values whose code is wrong, the extra arguments that avoid it,
# and where it is written down.
type Defect = {
  tileiras: String,
  targets: List[String],
  args: List[String],
  issue: String,
}

# The measured defects. sm_80 to sm_89 and sm_120/sm_121 assemble the
# minimised program correctly under 13.4.92 at every level; the five below do
# not (6.28 lists the PTX check behind each).
fn defects() -> List[Defect] = [
  Defect {
    tileiras = "13.4.92",
    targets = ["sm_90", "sm_100", "sm_103", "sm_107", "sm_110"],
    args = ["--opt-level", "0"],
    issue = "dawnop/dawn-lang#558, NVIDIA/cuda-tile#25",
  }
]

fn defect_for(tileiras: String, gpu_name: String, prog: TileProg) -> Option[Defect] =
  if has_break_loop(prog) {
    list.find(defects(), d => d.tileiras == tileiras && list.contains(d.targets, gpu_name))
  } else {
    None
  }

## True when `prog` has a `loop` that can `break`: a `Loop` operation with a
## `Break` anywhere inside its body, however deeply nested in `if`, `for`,
## `reduce` or `scan` regions. This is the structural form of the shape that
## trips #558, and it is deliberately wider than that issue's four conditions
## (see 6.28): the optimizer's current behaviour decides which of these loops
## miscompile, so every one of them is treated as suspect. A `for` loop never
## counts, and neither does a program with no loop.
pub fn has_break_loop(prog: TileProg) -> Bool = any_break_loop(prog.ops)

fn any_break_loop(ops: List[TileOp]) -> Bool =
  list.any(ops, op => match op {
    Loop(_inits, _carried, _results, body) -> any_break(body) || any_break_loop(body)
    For(_iv, _lower, _upper, _step, _unsigned, _inits, _carried, _results, body) -> any_break_loop(body)
    Reduce(_results, _dim, _shape, _identities, _operands, _args, body) -> any_break_loop(body)
    Scan(_results, _dim, _reverse, _shape, _identities, _operands, _args, body) -> any_break_loop(body)
    If(_results, _cond, on_true, on_false) -> any_break_loop(on_true) || any_break_loop(on_false)
    _ -> false
  })

# Whether `ops` hold a `Break` at any depth.
fn any_break(ops: List[TileOp]) -> Bool =
  list.any(ops, op => match op {
    Break(_values) -> true
    Loop(_inits, _carried, _results, body) -> any_break(body)
    For(_iv, _lower, _upper, _step, _unsigned, _inits, _carried, _results, body) -> any_break(body)
    Reduce(_results, _dim, _shape, _identities, _operands, _args, body) -> any_break(body)
    Scan(_results, _dim, _reverse, _shape, _identities, _operands, _args, body) -> any_break(body)
    If(_results, _cond, on_true, on_false) -> any_break(on_true) || any_break(on_false)
    _ -> false
  })

## The arguments to put before `-o <cubin> <bytecode>` when `tileiras`
## version `tileiras` (as `tileiras --version` prints it after `V`, e.g.
## `"13.4.92"`) assembles `prog` for `gpu_name` (e.g. `"sm_90"`): `--gpu-name`
## and, when the version and target are one [`assembler_defect`] knows AND
## [`has_break_loop`] says `prog` has the shape that defect needs, the
## arguments that avoid it. For tileiras 13.4.92 on sm_90, sm_100, sm_103,
## sm_107 and sm_110 that is `--opt-level 0`, and only for a program with a
## `loop` that `break`s: every other program keeps the default `-O3`.
pub fn tileiras_args(tileiras: String, gpu_name: String, prog: TileProg) -> List[String] = {
  let extra = match defect_for(tileiras, gpu_name, prog) {
    Some(d) -> d.args
    None -> []
  }
  ["--gpu-name", gpu_name] ++ extra
}

## Why [`tileiras_args`] adds arguments for this combination, or `None` when
## it does not: one English sentence naming the assembler, the target, the
## defect and the issues that track it.
pub fn assembler_defect(tileiras: String, gpu_name: String, prog: TileProg) -> Option[String] =
  match defect_for(tileiras, gpu_name, prog) {
    Some(d) -> Some(
      "tileiras ${d.tileiras} miscompiles the exit value of a loop that breaks for ${gpu_name} at --opt-level 1 and above"
        ++ " (${d.issue}); assemble this program with --opt-level 0 or with a tileiras that fixes it")
    None -> None
  }

## Why [`assemble`] gave no cubin. `AssemblerNotFound` is a `tileiras` path
## nothing could start (missing, not executable), `AssemblerFailed` a run that
## exited non-zero (`args` is what it was given, `stderr` what it printed),
## `NoCubin` a run that exited zero and left no output file, and
## `UnknownVersion` a `--version` whose text has no unique, complete standard
## version record to key [`tileiras_args`] on (see [`assemble`]). `Scratch` is
## the host refusing the temporary directory or a file in it.
pub type AssembleError =
  | AssemblerNotFound(path: String, detail: String)
  | AssemblerFailed(args: List[String], status: Int, stderr: String)
  | NoCubin(path: String)
  | UnknownVersion(output: String)
  | Scratch(detail: String)
derive Show

## One English sentence for an [`AssembleError`], for a build script's log.
pub fn explain(e: AssembleError) -> String = match e {
  AssemblerNotFound(path, detail) -> "could not run tileiras at `${path}`: ${detail}"
  AssemblerFailed(args, status, stderr) ->
    "tileiras ${join(args, " ")} exited with status ${status}: ${str.trim(stderr)}"
  NoCubin(path) -> "tileiras exited with status 0 but wrote no cubin at `${path}`"
  UnknownVersion(output) -> "`tileiras --version` did not print one valid version record: ${str.trim(output)}"
  Scratch(detail) -> "scratch files for tileiras: ${detail}"
}

# Canonical components keep numeric aliases from bypassing exact defect keys.
fn version_component(s: String) -> Bool =
  not str.is_empty(s) && (s == "0" || not str.starts_with(s, "0"))
  && list.all(str.chars(s), c => str.contains("0123456789", c))

fn version_record(line: String) -> Option[String] =
  match str.split_once(line, ", V") {
    Some((release, v)) -> {
      let parts = str.split(v, ".")
      if len(parts) == 3 && list.all(parts, version_component)
        && release == "Cuda compilation tools, release ${parts[0]}.${parts[1]}" {
        Some(v)
      } else {
        None
      }
    }
    None -> None
  }

# Count all candidate records, including malformed ones; a second record must
# not override the identity used for a correctness workaround.
fn version_of(output: String) -> Option[String] = {
  var version: Option[String] = None
  var records = 0
  for raw in str.split(output, "\n") {
    let line = str.trim(raw)
    if str.starts_with(line, "Cuda compilation tools") || str.contains(line, ", V") {
      records = records + 1
      version = version_record(line)
    }
  }
  if records == 1 { version } else { None }
}

# Run `tileiras argv`, stdout and stderr each into a file under `dir`: the
# status and both texts, or the reason it could not start.
fn run_in(dir: String, tag: String, tileiras: String, argv: List[String]) -> Result[(Int, String, String), AssembleError] !Fs !Proc = {
  let out = "${dir}/${tag}.out"
  let err = "${dir}/${tag}.err"
  match run([tileiras] ++ argv, out, err) {
    Err(e) -> Err(AssemblerNotFound(tileiras, e.message))
    Ok(status) -> {
      let text = match read_file(out) {
        Ok(t) -> t
        Err(_e) -> ""
      }
      let errs = match read_file(err) {
        Ok(t) -> t
        Err(_e) -> ""
      }
      Ok((status, text, errs))
    }
  }
}

fn assemble_in(dir: String, prog: TileProg, bc: Bytes, gpu_name: String, tileiras: String) -> Result[Bytes, AssembleError] !Fs !Proc =
  match run_in(dir, "version", tileiras, ["--version"]) {
    Err(e) -> Err(e)
    Ok((vstatus, vout, verr)) ->
      if vstatus != 0 {
        Err(AssemblerFailed(["--version"], vstatus, verr))
      } else {
        match version_of(vout) {
          None -> Err(UnknownVersion(vout))
          Some(version) -> {
            let input = "${dir}/in.tilebc"
            let output = "${dir}/out.cubin"
            match write_bytes(input, bc) {
              Err(e) -> Err(Scratch(e.message))
              Ok(_u) -> {
                let args = tileiras_args(version, gpu_name, prog) ++ ["-o", output, input]
                match run_in(dir, "asm", tileiras, args) {
                  Err(e) -> Err(e)
                  Ok((status, _o, errs)) ->
                    if status != 0 {
                      Err(AssemblerFailed(args, status, errs))
                    } else {
                      match read_bytes(output) {
                        Ok(cubin) -> Ok(cubin)
                        Err(_e) -> Err(NoCubin(output))
                      }
                    }
                }
              }
            }
          }
        }
      }
  }

# Best effort: the scratch directory is ours, and a failed delete must not
# replace the answer the caller is waiting for.
fn clean(dir: String) -> Unit !Fs = {
  for f in ["version.out", "version.err", "asm.out", "asm.err", "in.tilebc", "out.cubin"] {
    let _r = delete("${dir}/${f}")
  }
  let _d = delete(dir)
  ()
}

## Assemble `prog` for `gpu_name` (e.g. `"sm_86"`) with the `tileiras`
## executable at `tileiras` (a path, or a name found on PATH) and answer the
## cubin. This is the step `encode` and the assembler make by hand: the
## program is encoded, written to a temporary `.tilebc`, `tileiras --version`
## says which assembler this is, [`tileiras_args`] picks the arguments for that
## version and target, and the cubin is read back. The temporary directory is
## removed whatever the outcome.
##
## Version output must contain exactly one `Cuda compilation tools, release
## M.m, VM.m.p` record. Components are ASCII decimal without leading zeros
## except `0`; the release must agree with the version. Surrounding whitespace,
## LF and CRLF are accepted. Incomplete, suffixed or duplicate records are
## `UnknownVersion`, with the original stdout, before assembly starts. Other
## complete versions retain the ordinary argument policy.
##
## An assembler that cannot be started, one that exits non-zero, one that
## leaves no file and one whose version text cannot be read are four
## different [`AssembleError`]s. A program the encoder refuses panics with its
## message, before any file exists.
##
## It takes the file system and process effects rather than reaching for the
## host, so a test answers both without an assembler; `with_fs_real` and
## `with_proc_real` are the production handlers. Nothing is cached: an
## assembly takes well under a second, and a cache keyed on the bytes would
## also have to be keyed on the assembler's version, the target and the
## arguments, which is a table this module already keeps once.
pub fn assemble(prog: TileProg, gpu_name: String, tileiras: String) -> Result[Bytes, AssembleError] !Fs !Proc = {
  let bc = encode(prog)
  match temp_dir("", "tileir-asm-") {
    Err(e) -> Err(Scratch(e.message))
    Ok(dir) -> {
      let r = assemble_in(dir, prog, bc, gpu_name, tileiras)
      clean(dir)
      r
    }
  }
}

# ---- the programs the criterion is held against
#
# `repro_558` is the shape of the minimised reproducer (dawnop/dawn-lang#558):
# an f64 carried through a `loop` that `break`s once `0.2 > max|x - 0.25|`.
# `for_only` and `flash_like` are what the 35x to 57x of 6.28 was paid on: a
# `for` loop (a flash_attn kernel's shape) and a straight line (vadd's).

fn repro_558() -> TileProg = {
  let (p, _e) = trace1("repro_558", Out(F64, cells([1], [1])), o => {
    let c = broadcast(f_const(F64, 0.25), [1])
    let half = f_const(F64, 0.5)
    let x = carry(broadcast(f_const(F64, 1.0), [1]))
    d_loop {
      let v = x.get()
      let worst = reduce_max(abs(v - c))
      x.set(half * (v + c))
      gt(f_const(F64, 0.2), worst)
    }
    store_cell(o, x.get())
  })
  p
}

fn for_only() -> TileProg = {
  let (p, _e) = trace1("for_only", Out(F64, cells([1], [1])), o => {
    var acc = broadcast(f_const(F64, 0.0), [1])
    for _j in d_range(0, 8) {
      acc = acc + broadcast(f_const(F64, 1.0), [1])
    }
    store_cell(o, acc)
  })
  p
}

fn straight_line() -> TileProg = {
  let (p, _e) = trace1("straight", Out(F64, cells([1], [1])), o => store_cell(o, broadcast(f_const(F64, 1.0), [1])))
  p
}

# A `break` loop nested inside a `for`: found, since the scan looks at every depth.
fn nested_break_loop() -> TileProg = {
  let (p, _e) = trace1("nested", Out(F64, cells([1], [1])), o => {
    var acc = broadcast(f_const(F64, 0.0), [1])
    for _j in d_range(0, 2) {
      let x = carry(broadcast(f_const(F64, 1.0), [1]))
      d_loop {
        let v = x.get()
        x.set(v * f_const(F64, 0.5))
        gt(f_const(F64, 0.2), reduce_max(v))
      }
      acc = acc + x.get()
    }
    store_cell(o, acc)
  })
  p
}

test "has_break_loop looks at the structure: a loop that breaks counts, a for or a straight line does not" {
  assert has_break_loop(repro_558())
  assert has_break_loop(nested_break_loop())
  assert has_break_loop(for_only()) == false
  assert has_break_loop(straight_line()) == false
}

test "13.4.92 on the sm_90 and sm_100 family assembles a loop that breaks at --opt-level 0" {
  for g in ["sm_90", "sm_100", "sm_103", "sm_107", "sm_110"] {
    assert tileiras_args("13.4.92", g, repro_558()) == ["--gpu-name", g, "--opt-level", "0"]
    assert tileiras_args("13.4.92", g, nested_break_loop()) == ["--gpu-name", g, "--opt-level", "0"]
    assert assembler_defect("13.4.92", g, repro_558()) != None
  }
}

test "13.4.92 on the sm_90 and sm_100 family keeps the default level for a program with no loop that breaks" {
  for g in ["sm_90", "sm_100", "sm_103", "sm_107", "sm_110"] {
    for prog in [for_only(), straight_line()] {
      assert tileiras_args("13.4.92", g, prog) == ["--gpu-name", g]
      assert assembler_defect("13.4.92", g, prog) == None
    }
  }
}

test "13.4.92 on the targets it compiles correctly keeps the default level" {
  # sm_86 is this repository's ledger: the same 13.4.92 bytes give the right
  # answer there at the default level, so its cubins keep the optimizer.
  for g in ["sm_80", "sm_86", "sm_87", "sm_88", "sm_89", "sm_120", "sm_121"] {
    assert tileiras_args("13.4.92", g, repro_558()) == ["--gpu-name", g]
    assert assembler_defect("13.4.92", g, repro_558()) == None
  }
}

test "the workaround is keyed on the assembler version, so another tileiras gets the plain arguments" {
  # 13.3.36 is correct at every level on sm_90 and sm_100; a later fixed
  # release is a different string and lifts the workaround with no edit here.
  assert tileiras_args("13.3.36", "sm_90", repro_558()) == ["--gpu-name", "sm_90"]
  assert tileiras_args("13.4.93", "sm_100", repro_558()) == ["--gpu-name", "sm_100"]
  assert assembler_defect("13.3.36", "sm_90", repro_558()) == None
}

test "the diagnostic names the assembler, the target and both issues" {
  assert assembler_defect("13.4.92", "sm_90", repro_558()) == Some(
    "tileiras 13.4.92 miscompiles the exit value of a loop that breaks for sm_90 at --opt-level 1 and above"
      ++ " (dawnop/dawn-lang#558, NVIDIA/cuda-tile#25); assemble this program with --opt-level 0 or with a tileiras that fixes it")
}

# ---- assemble, against a stand-in for tileiras
#
# The stand-in is a shell script that answers `--version` the way the real
# one does and otherwise does what the case under test says. It is made
# executable by copying `sh`'s mode onto it (`copy_permissions`), because
# nothing in std can chmod. Nothing here needs a GPU or the real assembler;
# the real one is run by scripts/tile-gpu-diff and by the PR's own hardware
# check.

fn fake_program() -> TileProg = trace_kernel("fake", [], () => ())

fn made(r: Result[String, ForeignError]) -> String = match r {
  Ok(p) -> p
  Err(_e) -> ""
}

fn version_lines() -> String =
  "echo \"tileiras: fake\"\necho \"Cuda compilation tools, release 13.4, V13.4.92\"\n"

# The pinned assembler's version banner is a positive identity fixture.
fn pinned_version_output() -> String =
  "tileiras: NVIDIA (R) Cuda Tile IR optimizing assembler\n"
  ++ "Copyright (c) 2005-2026 NVIDIA Corporation\n"
  ++ "Built on Tue_Sep__1_09:35:26_PDT_2026\n"
  ++ "Cuda compilation tools, release 13.4, V13.4.92\n"
  ++ "Build local.local.38855100_\n"

fn bad_version_outputs() -> List[String] = [
  "",
  "garbage\n",
  "Cuda compilation tools, release 13.4, Vgarbage\n",
  "Cuda compilation tools, release 13.4, V13.4\n",
  "Cuda compilation tools, release 13.4, V13.4.\n",
  "Cuda compilation tools, release 13.4, V13..92\n",
  "Cuda compilation tools, release 13.4, V13.4.92-extra\n",
  "Cuda compilation tools, release 13.4, V13.4.92 extra\n",
  "Cuda compilation tools, release 13.4, V13.4.92.1\n",
  "Cuda compilation tools, release 13.4, V\n",
  "Cuda compilation tools, release 13.4, V13.4.-1\n",
  "Cuda compilation tools, release 13.4, V13.4.９２\n",
  "Cuda compilation tools, release 013.4, V013.4.92\n",
  "Cuda compilation tools, release 13.04, V13.04.92\n",
  "Cuda compilation tools, release 13.4, V13.4.092\n",
  "Cuda compilation tools, release 13.3, V13.4.92\n",
  "other program, V13.4.92\n",
  "Cuda compilation tools, release 13.4, V13.4.92\nCuda compilation tools, release 13.4, V13.4.93\n",
  "Cuda compilation tools, release 13.4, V13.4.92\nCuda compilation tools, release 13.4, V13.4.92\n",
  "Cuda compilation tools, release 13.4, Vgarbage\nCuda compilation tools, release 13.4, V13.4.92\n",
  "Cuda compilation tools, release 13.4, V13.4.92\nCuda compilation tools, release 13.4\n",
]

test "version identity requires one complete canonical record" {
  assert version_of(pinned_version_output()) == Some("13.4.92")
  assert version_of("\r\n\t Cuda compilation tools, release 13.4, V13.4.92 \t\r\nBuild x\r\n") == Some("13.4.92")
  assert version_of("Cuda compilation tools, release 13.4, V13.4.93") == Some("13.4.93")
  assert version_of("Cuda compilation tools, release 14.0, V14.0.0\n") == Some("14.0.0")
  for output in bad_version_outputs() {
    assert version_of(output) == None
  }
}

# A successful assembly records its invocation outside assemble's scratch
# directory, so cleanup cannot hide an incorrectly started subprocess.
fn sentinel_assembler(output: String) -> String =
  "if [ \"\$1\" = \"--version\" ]; then printf '%s' '" ++ str.replace(output, "'", "'\\''") ++ "'; exit 0; fi\n"
  ++ "printf '%s' invoked > \"\$0.assembled\"\n"
  ++ "for a in \"\$@\"; do if [ \"\$prev\" = \"-o\" ]; then out=\"\$a\"; fi; prev=\"\$a\"; done\n"
  ++ "printf '%s' \"\$*\" > \"\$out\"\n"

# A stand-in whose body (after the shebang) is `body`, in a fresh directory;
# `f` gets its path, and the directory is removed afterwards.
fn with_fake[T](body: String, f: fn(String) -> T !Fs !Proc) -> T !Fs !Proc = {
  let d = made(temp_dir("", "tileir-fake-"))
  let path = "${d}/tileiras"
  let _w = write_file(path, "#!/bin/sh\n${body}")
  let _p = copy_permissions("/bin/sh", path)
  let r = f(path)
  let _a = delete(path)
  let _b = delete(d)
  r
}

# The scratch directories assemble leaves behind in the temporary directory.
fn leftovers() -> List[String] !Fs = {
  let probe = made(temp_dir("", "tileir-probe-"))
  let parent = match str.rsplit_once(probe, "/") {
    Some((p, _name)) -> p
    None -> "."
  }
  let _d = delete(probe)
  match list_dir(parent) {
    Ok(names) -> list.filter(names, n => str.starts_with(n, "tileir-asm-"))
    Err(_e) -> []
  }
}

test "assemble rejects bad version identities before the assembly sentinel and preserves stdout" {
  with_fs_real(() => with_proc_real(() => {
    for output in bad_version_outputs() {
      let before = leftovers()
      let (answer, invoked) = with_fake(sentinel_assembler(output), path => {
        let r = assemble(repro_558(), "sm_100", path)
        let marker = "${path}.assembled"
        let seen = match read_file(marker) {
          Ok(_text) -> true
          Err(_e) -> false
        }
        let _d = delete(marker)
        (r, seen)
      })
      assert invoked == false
      match answer {
        Err(UnknownVersion(raw)) -> { assert raw == output }
        _ -> { assert false }
      }
      assert leftovers() == before
    }
  }))
}

test "assemble preserves the version target and program argument policy through a real subprocess" {
  with_fs_real(() => with_proc_real(() => {
    for (output, gpu_name, prog, expected) in [
      (pinned_version_output(), "sm_100", repro_558(), "--gpu-name sm_100 --opt-level 0 -o "),
      (pinned_version_output(), "sm_90", repro_558(), "--gpu-name sm_90 --opt-level 0 -o "),
      (pinned_version_output(), "sm_100", straight_line(), "--gpu-name sm_100 -o "),
      (pinned_version_output(), "sm_86", repro_558(), "--gpu-name sm_86 -o "),
      ("Cuda compilation tools, release 13.4, V13.4.93\n", "sm_100", repro_558(), "--gpu-name sm_100 -o "),
      ("\tCuda compilation tools, release 13.4, V13.4.92 \r\n", "sm_90", repro_558(), "--gpu-name sm_90 --opt-level 0 -o "),
    ] {
      let before = leftovers()
      let (answer, invoked) = with_fake(sentinel_assembler(output), path => {
        let r = assemble(prog, gpu_name, path)
        let marker = "${path}.assembled"
        let seen = match read_file(marker) {
          Ok(text) -> text == "invoked"
          Err(_e) -> false
        }
        let _d = delete(marker)
        (r, seen)
      })
      assert invoked
      match answer {
        Ok(cubin) -> { assert bytes.slice(cubin, 0, len(bytes.utf8(expected))) == bytes.utf8(expected) }
        _ -> { assert false }
      }
      assert leftovers() == before
    }
  }))
}

test "assemble hands tileiras the program's bytes and the arguments tileiras_args picks, and answers the cubin" {
  with_fs_real(() => with_proc_real(() => {
    let script = version_lines() ++ "if [ \"\$1\" = \"--version\" ]; then exit 0; fi\n"
      ++ "for a in \"\$@\"; do if [ \"\$prev\" = \"-o\" ]; then out=\"\$a\"; fi; prev=\"\$a\"; in=\"\$a\"; done\n"
      ++ "{ echo \"args: \$*\"; cat \"\$in\"; } > \"\$out\"\n"
    let before = leftovers()
    let plain = fake_program()
    # 13.4.92 on sm_90 gets --opt-level 0 for a program with a loop that breaks, the plain arguments for one without; sm_86 never
    for (prog, gpu, want) in [
      (repro_558(), "sm_90", "args: --gpu-name sm_90 --opt-level 0 -o "),
      (repro_558(), "sm_86", "args: --gpu-name sm_86 -o "),
      (plain, "sm_90", "args: --gpu-name sm_90 -o ")] {
      let bc = encode(prog)
      match with_fake(script, path => assemble(prog, gpu, path)) {
        Ok(cubin) -> {
          assert str.starts_with(bytes.decode_utf8_lossy(cubin), want)
          # the program's own bytes follow the one line the stand-in wrote
          assert bytes.slice(cubin, len(cubin) - len(bc), len(cubin)) == bc
        }
        Err(e) -> { assert explain(e) == "" }
      }
    }
    # and the scratch directory is gone
    assert leftovers() == before
  }))
}

test "assemble: a tileiras that cannot be started is AssemblerNotFound" {
  with_fs_real(() => with_proc_real(() => {
    let before = leftovers()
    match assemble(fake_program(), "sm_86", "/nonexistent/dir/tileiras") {
      Err(AssemblerNotFound(path, _detail)) -> { assert path == "/nonexistent/dir/tileiras" }
      _ -> { assert false }
    }
    assert leftovers() == before
  }))
}

test "assemble: a non-zero exit is AssemblerFailed with the arguments and stderr" {
  with_fs_real(() => with_proc_real(() => {
    let script = version_lines() ++ "if [ \"\$1\" = \"--version\" ]; then exit 0; fi\necho \"error: nope\" >&2\nexit 3\n"
    let before = leftovers()
    match with_fake(script, path => assemble(repro_558(), "sm_100", path)) {
      Err(AssemblerFailed(args, status, stderr)) -> {
        assert status == 3
        assert str.trim(stderr) == "error: nope"
        assert list.take(args, 4) == ["--gpu-name", "sm_100", "--opt-level", "0"]
        assert args[4] == "-o"
      }
      _ -> { assert false }
    }
    assert leftovers() == before
  }))
}

test "assemble: a zero exit that wrote no file is NoCubin" {
  with_fs_real(() => with_proc_real(() => {
    let script = version_lines() ++ "exit 0\n"
    match with_fake(script, path => assemble(fake_program(), "sm_86", path)) {
      Err(NoCubin(path)) -> { assert str.ends_with(path, "/out.cubin") }
      _ -> { assert false }
    }
  }))
}

test "assemble: an unreadable version is UnknownVersion, and a failing --version is AssemblerFailed" {
  with_fs_real(() => with_proc_real(() => {
    match with_fake("echo garbage\n", path => assemble(fake_program(), "sm_86", path)) {
      Err(UnknownVersion(out)) -> { assert str.trim(out) == "garbage" }
      _ -> { assert false }
    }
    match with_fake("echo oops >&2\nexit 2\n", path => assemble(fake_program(), "sm_86", path)) {
      Err(AssemblerFailed(args, status, _stderr)) -> {
        assert args == ["--version"]
        assert status == 2
      }
      _ -> { assert false }
    }
  }))
}

test "explain says which assembler step failed" {
  assert explain(AssemblerNotFound("/x/tileiras", "no such file")) == "could not run tileiras at `/x/tileiras`: no such file"
  assert explain(AssemblerFailed(["--gpu-name", "sm_90"], 1, "bad\n")) == "tileiras --gpu-name sm_90 exited with status 1: bad"
  assert explain(UnknownVersion("bad\n")) == "`tileiras --version` did not print one valid version record: bad"
  assert version_of("a\nCuda compilation tools, release 13.4, V13.4.92\nBuild x\n") == Some("13.4.92")
  assert version_of("nothing") == None
}

# checker.dawn: `with_mem` named as a value (N13). A later `w(...)` is a
# dynamic call, so the rule has to fire where the name is used. The annotation
# makes the instantiation concrete, so the buffer itself is what is refused.
use std/mem
use std/mem.{Mem}

pub fn escaped() -> Int = {
  let w: fn(fn() -> I64Buf !Mem) -> I64Buf = mem.with_mem
  len(w(() => mem.new(4)))
}

# The Elm architecture's contract, and nothing else: a model type `M` names
# its message type and provides the two pure functions the loop needs. The
# driver loop itself lives in the application's `main` on purpose. This v1 has
# no `Cmd`: `update` is pure by signature, effects happen only in the driver,
# and when a real app needs commands the associated-effect work (#307) is the
# place to grow them, with this trait as the consumer that justifies it.

use widget.{Widget, Text}
use render.{render}

## An application: `update` folds one message into the model, `view` describes
## the whole screen for a model. Both pure, so both are testable with `==`.
pub trait App[M] {
  type Msg
  fn update(m: M, msg: M.Msg) -> M
  fn view(m: M) -> Widget[M.Msg]
}

## One turn of the loop, minus the io: apply the message, render the new view.
## A driver prints the frame and reads the next message; a test asserts on it.
pub fn step[A: App](m: A, msg: A.Msg) -> (A, String) = {
  let next = update(m, msg)
  (next, render(view(next)))
}

# A minimal app for the test blocks below; real apps bring their own.
type Counter = { n: Int }

type CounterMsg =
  | Inc
  | Dec
derive Show

impl App[Counter] {
  type Msg = CounterMsg
  fn update(m: Counter, msg: CounterMsg) -> Counter =
    match msg {
      Inc -> Counter { n: m.n + 1 }
      Dec -> Counter { n: m.n - 1 }
    }
  fn view(m: Counter) -> Widget[CounterMsg] = Text(s: "n=" ++ to_string(m.n))
}

test "update folds messages, view snapshots as a value" {
  let m = update(update(Counter { n: 0 }, Inc), Inc)
  assert m == Counter { n: 2 }
  assert view(update(m, Dec)) == Text(s: "n=1")
}

test "step returns the new model and the rendered frame" {
  let (m, frame) = step(Counter { n: 41 }, Inc)
  assert m == Counter { n: 42 }
  assert frame == "n=42"
}

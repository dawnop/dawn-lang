# Ordinary environments and delivered type support have separate contracts.
# The same token can name a buffer while the correct Mem evidence is active.
use std/mem
use std/mem.{Mem}
type PhantomAt[@s] = { n: Int }
fn allocate[@s](p: PhantomAt[s]) -> I64Buf@s !Mem[s] = mem.new(p.n)
pub fn main() -> Unit !io = {
  let n = mem.with_mem([@s] () => {
    let p: PhantomAt[s] = PhantomAt { n = 29 }
    len(allocate(p))
  })
  println(to_string(n))
}

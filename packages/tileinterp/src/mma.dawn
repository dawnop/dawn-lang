## The fused operations on plain lists: `fma` and the three matrix products,
## each with the accumulation order and the rounding the interpreter
## models, and the reason for it written beside it.
#
# What is pinned and what is a model (docs/tileinterp-design.md 7.1). `fma`
# is pinned: one rounding of the exact `a * b + c`, which is what the
# dialect's `fma` says and what the device measures as. A matrix product is
# NOT: `mmaf` promises a product and says nothing about how the sum over `k`
# is grouped or rounded, and on tensor cores the sum is not an IEEE
# sequence at all (a block of products is aligned to the largest exponent
# and the dropped bits are truncated, Fasi et al., "Numerical behavior of
# NVIDIA tensor cores", PeerJ CS 2021). So the product below is one
# reading among the legal ones, chosen to be the most accurate that is still
# sequential, and every comparison against it (tileref's left fold, the
# device) is a tolerance-tier comparison, permanently.
#
#   * binary64 accumulator: one fused step per `k`, ascending, from the
#     accumulator operand. sm_86 has no f64 tensor-core path for this and
#     `tileiras --remarks=tensorcore` says `Instruction = FMA`.
#   * any narrower accumulator: the products are exact in binary64 (operands
#     of at most 24 significand bits), the sum runs in binary64, and the
#     result is rounded into the accumulator's format ONCE at the end. A
#     per-step rounding into f32 would add `k` roundings no hardware path
#     is documented to make; the tensor core's own error is of the same
#     order as binary64's, far below the format's.
use std/list
use std/math as host_math
use std/float.{is_finite}
use math.{add_odd}
use formats.{nearest}

## `a * b + c` in format `fmt`, rounded once.
##
## Binary64: std/math.fma, including extreme exponents. A narrower
## format: the product of two operands of at most 24 significand bits is
## exact in binary64, `c` is added by rounding to odd, and that value is
## rounded into `fmt`; rounding to odd first loses nothing for a format with
## at most 51 significand bits, so the second step is the only rounding.
pub fn fma_in(fmt: String, a: Float, b: Float, c: Float) -> Float =
  if fmt == "f64" {
    host_math.fma(a, b, c)
  } else {
    let p = a * b
    if is_finite(p) && is_finite(c) { nearest(fmt, add_odd(p, c)) } else { nearest(fmt, p + c) }
  }

# Row `i` of an `m` by `k` matrix, and column `j` of a `k` by `n` one.
fn row_of(x: List[Float], k: Int, i: Int) -> List[Float] = list.map(range(0, k), p => x[i * k + p])

fn col_of(x: List[Float], k: Int, n: Int, j: Int) -> List[Float] = list.map(range(0, k), p => x[p * n + j])

## `acc + a * b` for an `m` by `k` matrix `a`, a `k` by `n` matrix `b` and
## an `m` by `n` accumulator, all row major, accumulating into format
## `out`. See the header for the order and the roundings.
pub fn mma_float(out: String, m: Int, k: Int, n: Int, a: List[Float], b: List[Float], acc: List[Float]) -> List[Float] = {
  let rows = list.map(range(0, m), i => row_of(a, k, i))
  let cols = list.map(range(0, n), j => col_of(b, k, n, j))
  list.map(range(0, m * n), idx => {
    let r = rows[idx / n]
    let c = cols[idx % n]
    if out == "f64" {
      list.fold(range(0, k), acc[idx], (s, p) => host_math.fma(r[p], c[p], s))
    } else {
      nearest(out, list.fold(range(0, k), acc[idx], (s, p) => s + r[p] * c[p]))
    }
  })
}

## The block-scaled product of Ops.td's `MmaFScaledOp`: `acc` plus the sum
## over `p` of `(a[i][p] * sa[i][p / v]) * (b[p][j] * sb[p / v][j])`, where
## `sa` is `m` by `k / v` and `sb` is `k / v` by `n`. The scales are powers
## of two (`f8E8M0FNU`), so every factor and product is exact in binary64,
## and the sum is accumulated wide and rounded into f32 once, like the
## unscaled product into a narrower accumulator.
pub fn mma_scaled(m: Int, k: Int, n: Int, v: Int, a: List[Float], b: List[Float], acc: List[Float], sa: List[Float],
  sb: List[Float]) -> List[Float] = {
  let sk = k / v
  let rows = list.map(range(0, m), i => row_of(a, k, i))
  let cols = list.map(range(0, n), j => col_of(b, k, n, j))
  let srows = list.map(range(0, m), i => row_of(sa, sk, i))
  let scols = list.map(range(0, n), j => col_of(sb, sk, n, j))
  list.map(range(0, m * n), idx => {
    let i = idx / n
    let j = idx % n
    let r = rows[i]
    let c = cols[j]
    let sr = srows[i]
    let sc = scols[j]
    nearest("f32", list.fold(range(0, k), acc[idx], (s, p) => s + (r[p] * sr[p / v]) * (c[p] * sc[p / v])))
  })
}

## The integer product of `mmai`: `acc` plus the sum of the products of
## signed i8 operands, wrapped to the i32 accumulator. Integer addition is
## associative modulo 2^32, so the order is not a model, it is exact.
pub fn mma_int(m: Int, k: Int, n: Int, a: List[Int], b: List[Int], acc: List[Int]) -> List[Int] =
  list.map(range(0, m * n), idx => {
    let i = idx / n
    let j = idx % n
    wrap32(list.fold(range(0, k), acc[idx], (s, p) => s + a[i * k + p] * b[p * n + j]))
  })

fn wrap32(v: Int) -> Int = ((v + 2147483648) & 4294967295) - 2147483648

test "binary64 fusion handles intermediate overflow and subnormal ties" {
  let largest = 1.7976931348623157e308
  assert fma_in("f64", largest, 2.0, 0.0 - largest) == largest
  # Half a minimum subnormal plus one minimum subnormal is a tie whose
  # even result is two units; rounding the product first gives one unit.
  let tiny = 4.9406564584124654e-324
  assert fma_in("f64", tiny, 0.5, tiny) == 2.0 * tiny
}

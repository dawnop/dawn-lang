# An explicit contract isolates this propagation or boundary rule.
use std/mem
trait Relay[T: ^{c}, ^c] { fn relay(value: T) -> T = value }
impl[@s] Relay[I64Buf@s, ^{s}] { }
fn same[@s](b: I64Buf@s) -> Int = mem.with_mem([@t] () => {
  let original: I64Buf@s = relay(b)
  len(original)
})
pub fn main() -> Unit !io = { println(to_string(mem.with_mem([@s] () => same(mem.new(3))))) }

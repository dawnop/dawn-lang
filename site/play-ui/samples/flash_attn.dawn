# Flash attention in tileir: the kernel of the GPU page, recorded, then run
# on the host by packages/tileinterp and checked against plain attention.
# Run it for the numbers; open the Tile IR tab to click a call and see the
# lines it wrote, or the C and JVM tabs for the program that records.
#
# The kernel is scripts/tile-golden's `flash_attn` verbatim; doc-check holds
# its text, so a kernel that moves takes this sample red with it. The
# interpreter executes the lowered Tile IR block by block with no GPU: the
# grid is two blocks of 32 query rows, and each block walks the keys in four
# tiles, carrying the running maximum and sum of an online softmax.
use std/dtype.{F64, Dtype}
use std/io
use std/gpu.{ScalarDtype}
use std/float.{INFINITY}
use std/list
use tileir/dev.{Dev, Param, Tile, FloatDtype, idx_const, tile_shape, blocks_of, t_call_enter, t_call_exit, t_body_enter, t_body_exit, load_cell, store_cell, load_at, full, zeros, mma, transpose, scalar, max, exp, exp2, div, to, reduce_max, reduce_sum, d_range}
use tileir/prog.{trace5, cells, In, Out, Scalar, FREE_AXIS}
use tileinterp/interp.{interp_ref}
use tileinterp/math.{exp_f}

const ATT_M: Int = 64
const ATT_N: Int = 64
const ATT_D: Int = 32
const FA_BQ: Int = 32
const FA_BK: Int = 16
const ATT_INV_SQRT_D: Float = 0.17677669529663687

type FaNumerics[A] = { zero: A, neg_inf: A, base2: Bool, exp_ftz: Bool, approx_div: Bool, div_ftz: Bool }
fn fa64_math() -> FaNumerics[Float] = FaNumerics { zero = 0.0, neg_inf = -INFINITY, base2 = false, exp_ftz = false, approx_div = false, div_ftz = false }

fn fa_exp[A: FloatDtype](math: FaNumerics[A], x: Tile[A], at: Loc = caller()) -> Tile[A] !Dev = {
  t_call_enter("fa_exp", Some(at))
  t_body_enter()
  let result = if math.base2 { exp2(x, ftz = math.exp_ftz) } else { exp(x) }
  t_body_exit()
  t_call_exit()
  result
}

fn fa_divide[A: FloatDtype](math: FaNumerics[A], x: Tile[A], y: Tile[A], at: Loc = caller()) -> Tile[A] !Dev = {
  t_call_enter("fa_divide", Some(at))
  t_body_enter()
  let result = if math.approx_div { div(x, y, approx = true, ftz = math.div_ftz) } else { x / y }
  t_body_exit()
  t_call_exit()
  result
}

fn flash_attn[D: FloatDtype, A: FloatDtype + ScalarDtype](q: Param[D], k: Param[D], v: Param[D], o: Param[A], scale: Param[A], dt: Dtype[D], math: FaNumerics[A]) -> Unit !Dev = {
  let tq = load_cell(q)
  let rows = tile_shape(tq)[0]
  var m: Tile[A] = full([rows, 1], math.neg_inf)
  var l: Tile[A] = full([rows, 1], math.zero)
  var acc = zeros(o)
  for j in d_range(idx_const(0), blocks_of(k, 1)) {
    let s: Tile[A] = mma(tq, load_at(k, [j]).transpose(), 0.0) * scalar(scale)
    let m_new = max(m, reduce_max(s, keepdims = true))
    let p = fa_exp(math, s - m_new)
    let alpha = fa_exp(math, m - m_new)
    l = l * alpha + reduce_sum(p, keepdims = true)
    acc = mma(p.to(dt), load_at(v, [j]), acc * alpha)
    m = m_new
  }
  store_cell(o, fa_divide(math, acc, l))
}

fn fa_kernel[D: FloatDtype, A: FloatDtype + ScalarDtype](dt: Dtype[D], math: FaNumerics[A]) -> fn(Param[D], Param[D], Param[D], Param[A], Param[A]) -> Unit !Dev =
  (q, k, v, o, scale) => flash_attn(q, k, v, o, scale, dt, math)

# Small deterministic inputs: integers over eight, so every score is a short
# binary fraction.
fn wave(n: Int, salt: Int) -> List[Float] = list.map(range(0, n), i => to_float((i * 7 + salt * 13) % 11 - 5) / 8.0)

# Attention the plain way, one query row at a time: all scores, then the
# softmax over the whole row, then the weighted sum of the values.
fn plain_row(q: List[Float], k: List[Float], v: List[Float], i: Int) -> List[Float] = {
  let scores = list.map(range(0, ATT_N), j =>
      list.fold(range(0, ATT_D), 0.0, (a, d) => a + q[i * ATT_D + d] * k[j * ATT_D + d]) * ATT_INV_SQRT_D)
  let top = list.fold(scores, -INFINITY, (a, s) => if s > a { s } else { a })
  let w = list.map(scores, s => exp_f(s - top))
  let total = list.fold(w, 0.0, (a, x) => a + x)
  list.map(range(0, ATT_D), d => list.fold(range(0, ATT_N), 0.0, (a, j) => a + w[j] * v[j * ATT_D + d]) / total)
}

pub fn main() -> Unit !io = {
  let kv = cells([1, ATT_N, ATT_D], [1, FA_BK, ATT_D], along = [2, FREE_AXIS, 1], squeeze = [0])
  let (prog, _e) = trace5("flash_attn",
    In(F64, cells([1, ATT_M, ATT_D], [1, FA_BQ, ATT_D], along = [2, 0, 1], squeeze = [0])), In(F64, kv), In(F64, kv),
    Out(F64, cells([1, ATT_M, ATT_D], [1, FA_BQ, ATT_D], along = [2, 0, 1], squeeze = [0])), Scalar(F64), fa_kernel(F64, fa64_math()))
  let q = wave(ATT_M * ATT_D, 1)
  let k = wave(ATT_N * ATT_D, 2)
  let v = wave(ATT_N * ATT_D, 3)
  let blank = list.map(range(0, ATT_M * ATT_D), _i => 0.0)
  # grid [2, 1, 1]: query blocks on axis 0, one head on axis 2
  let run = interp_ref(prog, [ATT_M / FA_BQ, 1, 1])
  let answers = run(["f64", "f64", "f64", "f64"], [q, k, v, blank], [ATT_INV_SQRT_D])
  let (_buf, o) = answers[0]
  io.println("flash_attn on the host: ${ATT_M} queries, ${ATT_N} keys, head size ${ATT_D}, ${ATT_M / FA_BQ} blocks")
  var worst = 0.0
  for i in range(0, ATT_M) {
    let want = plain_row(q, k, v, i)
    for d in range(0, ATT_D) {
      let gap = o[i * ATT_D + d] - want[d]
      if gap != gap { panic("plain attention check: non-finite result") }
      worst = max_float(worst, if gap < 0.0 { 0.0 - gap } else { gap })
    }
  }
  if not (worst < 1e-12) { panic("plain attention check exceeds 1e-12") }
  io.println("query 0, first four of ${ATT_D}: ${list.slice(o, 0, 4)}")
  io.println("query ${ATT_M - 1}, first four of ${ATT_D}: ${list.slice(o, (ATT_M - 1) * ATT_D, (ATT_M - 1) * ATT_D + 4)}")
  io.println("agrees with plain attention to 1e-12: ${worst < 1e-12}")
}

fn max_float(a: Float, b: Float) -> Float = if b > a { b } else { a }

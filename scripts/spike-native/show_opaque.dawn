# `to_string(x)` and `${x}` are the *unquoted* rendering; `show` is the nested
# one, which quotes a String. An opaque type renders only through an impl
# written on its own name -- it inherits no rendering from its target since
# 2026-09-24 -- and that impl wins in every position, the two unquoted ones
# included.
#
# It used to lose there: `to_string` peeled the whole opaque stack before it
# asked, saw String, and returned the value verbatim. A redacting `Show` was
# honoured one field deep and ignored at the top level -- the one place a log
# line actually calls it (audit SEM-03).

opaque type Secret = String
opaque type Name = String
opaque type Meters = Int

impl Show[Secret] {
  fn show(x: Secret) -> String = "***"
}

# A name renders the way its String would: quoted nested, bare at the top level.
# Both layers have to be written, because nothing is inherited.
impl Show[Name] {
  fn show(x: Name) -> String = {
    let s: String = x
    show(s)
  }
}

impl Display[Name] {
  fn display(x: Name) -> String = x
}

impl Show[Meters] {
  fn show(x: Meters) -> String = {
    let n: Int = x
    show(n)
  }
}

fn secret_of(s: String) -> Secret = s

fn name_of(s: String) -> Name = s

fn meters_of(n: Int) -> Meters = n

type Card = { who: Name, pin: Secret } derive Show

pub fn main() -> Unit !io = {
  let s = secret_of("hunter2")
  # the impl wins at the top level ...
  println(to_string(s))
  println("${s}")
  # ... and one field or one element deep, as it always did
  println(to_string(Card { who: name_of("ada"), pin: s }))
  println(to_string([s]))
  # the two layers a name wrote: unquoted at the top level, quoted nested
  println(to_string(name_of("ada")))
  println("${name_of("ada")}")
  println(to_string(meters_of(7)))
}

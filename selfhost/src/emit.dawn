# ---- opcodes codegen.dawn does not carry yet ----

pub const OP_ICONST_M1: Int = 2

pub const OP_ACONST_NULL: Int = 1

pub const OP_IF_ACMPNE: Int = 166

pub const OP_LSUB: Int = 101

pub const OP_LMUL: Int = 105

pub const OP_LDIV: Int = 109

pub const OP_LREM: Int = 113

pub const OP_DADD: Int = 99

pub const OP_DSUB: Int = 103

pub const OP_DMUL: Int = 107

pub const OP_DDIV: Int = 111

pub const OP_DREM: Int = 115

pub const OP_LAND: Int = 127

pub const OP_LOR: Int = 129

pub const OP_LSHL: Int = 121

pub const OP_LSHR: Int = 123

pub const OP_LUSHR: Int = 125

pub const OP_DCMPG: Int = 152

pub const OP_IF_ICMPLT: Int = 161

pub const OP_IFNONNULL: Int = 199

pub const OP_L2D: Int = 138

pub const OP_D2L: Int = 143

pub const OP_D2F: Int = 144

pub const OP_F2D: Int = 141

pub const OP_FLOAD: Int = 23

pub const OP_FRETURN: Int = 174

pub const OP_ACC_SYNTHETIC: Int = 4096

pub const OP_H_INVOKESTATIC: Int = 6

pub const OP_NEWARRAY: Int = 188

pub const OP_ANEWARRAY: Int = 189

pub const OP_LASTORE: Int = 80

pub const OP_IASTORE: Int = 79

pub const OP_DASTORE: Int = 82

pub const OP_FASTORE: Int = 81

pub const OP_BASTORE: Int = 84

pub const OP_SASTORE: Int = 86

pub const OP_CASTORE: Int = 85

pub const OP_AASTORE: Int = 83

pub const ARGS_FIELD: String = "dawn\$args"

# ---- Gen: the threaded generation state ----

## A SAM bridge to emit: (arg idx, iface fqcn, sam name, sam params, sam ret).
pub type SamB = { name: String, iface: String, sam_name: String, sam_params: List[String], sam_ret: String }

pub type ConstF = { fname: String, v: CValue, ty: Ty }

pub type Gen = {
  mv: MethodVisitor,
  class_name: String,
  adts: Adts,
  traits: Traits,
  impl_table: Impls,
  # current module's fn signatures (calls with owner = None)
  own_fns: Map[String, Sig],
  # program-wide (class name, fn name) → declared signature
  prog_fns: Map[(String, String), Sig],
  # descriptors of the bodies lowering hoisted into this class, which have no
  # declared signature to look up. Membership doubles as "already written":
  # a synthesised structural comparison is named after its type, so every
  # function comparing that type asks for the same method and it must be
  # emitted once.
  lifted_descs: Map[(String, String), String],
  # the dictionaries lowering built for this class, deduplicated by key and
  # kept in the order they were asked for. This is Core's own table: naming a
  # dictionary from anything else is how the JVM backend spent a release not
  # noticing the table was wrong.
  dicts: List[CDictDef],
  syms: Map[Int, Sym],
  slots: Map[Int, Int],
  next_slot: Int,
  method_ret: Ty,
  rets_null: Bool,
  # Core names its loops, so leaving a non-innermost one is ordinary rather
  # than impossible
  cloops: List[(Int, Label, Label)],
  lambda_ctr: Int,
  sam_ctr: Int,
  pending_sam: List[SamB],
  consts: Map[String, CValue],
  blocks: Map[(Int, Int), CValue],
  const_fields: List[ConstF],
  const_by_key: Map[String, String]
}

fn sym_of(g: Gen, id: Int) -> Sym =
  match map.get(g.syms, id) {
    Some(s) -> s
    None -> panic("codegen: unknown symbol id ${id}")
  }

fn slot_of(g: Gen, id: Int) -> Int =
  match map.get(g.slots, id) {
    Some(s) -> s
    None -> panic("codegen: symbol ${id} has no slot")
  }

fn bind_slot(g: Gen, id: Int, slot: Int) -> Gen !io =
  Gen { ..g, slots: map.insert(g.slots, id, slot) }

fn alloc(g: Gen, n: Int) -> (Gen, Int) =
  (Gen { ..g, next_slot: g.next_slot + n }, g.next_slot)

# ---- small emission helpers (all mirror Kotlin byte for byte) ----

fn ldc_str(m: MethodVisitor, s: String) -> Unit !io = {
  m.visitLdcInsn(Objects.requireNonNull(s).expect("non-null"))
  ()
}

fn ldc_long(m: MethodVisitor, v: Int) -> Unit !io = {
  m.visitLdcInsn(Long.valueOf(v).expect("boxed"))
  ()
}

fn ldc_double(m: MethodVisitor, v: Float) -> Unit !io = {
  m.visitLdcInsn(Double.valueOf(v).expect("boxed"))
  ()
}

fn ldc_jint(m: MethodVisitor, v: Int) -> Unit !io = {
  m.visitLdcInsn(Integer.valueOf(v).expect("boxed"))
  ()
}

## Kotlin pushInt: ICONST for -1..5, BIPUSH for a byte, else an int LDC.
fn push_int(m: MethodVisitor, v: Int) -> Unit !io = {
  if v >= 0 - 1 && v <= 5 {
    m.visitInsn(3 + v)
  } else if v >= 0 - 128 && v <= 127 {
    m.visitIntInsn(OP_BIPUSH, v)
  } else {
    ldc_jint(m, v)
  }
  ()
}

fn store_slot(m: MethodVisitor, t: Ty, slot: Int) -> Unit !io = {
  match jvm_repr(t) {
    RLong -> { m.visitVarInsn(OP_LSTORE, slot) }
    RDouble -> { m.visitVarInsn(OP_DSTORE, slot) }
    RBool -> { m.visitVarInsn(OP_ISTORE, slot) }
    RRef -> { m.visitVarInsn(OP_ASTORE, slot) }
    RUnit | RBottom -> ()
  }
  ()
}

fn load_var(g: Gen, id: Int) -> Unit !io =
  load_slot(g.mv, sym_of(g, id).ty, slot_of(g, id))

fn store_var(g: Gen, id: Int) -> Unit !io =
  store_slot(g.mv, sym_of(g, id).ty, slot_of(g, id))

## Push the Unit singleton (an erased Object slot needs a value).
fn push_unit(m: MethodVisitor) -> Unit !io = {
  m.visitFieldInsn(OP_GETSTATIC, UNIT_CLASS, "INSTANCE", "L" ++ UNIT_CLASS ++ ";")
  ()
}

## Box a primitive about to sit in an erased Object position.
fn box_ty(m: MethodVisitor, t: Ty) -> Unit !io = {
  match jvm_repr(t) {
    RLong -> {
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;", false)
    }
    RDouble -> {
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Double", "valueOf",
        "(D)Ljava/lang/Double;", false)
    }
    RBool -> {
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Boolean", "valueOf",
        "(Z)Ljava/lang/Boolean;", false)
    }
    RUnit -> { push_unit(m) }
    # a reference is already an Object; the bottom types have nothing on the
    # stack to box
    RRef | RBottom -> ()
  }
  ()
}

## The stack holds an erased Object; recover the concrete type.
fn unerase(g: Gen, t: Ty) -> Unit !io = {
  let m = g.mv
  match t {
    TyOpaque(_, _, _, tgt) -> unerase(g, tgt)
    TyInt -> {
      m.visitTypeInsn(OP_CHECKCAST, "java/lang/Long")
      m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J", false)
    }
    TyFloat -> {
      m.visitTypeInsn(OP_CHECKCAST, "java/lang/Double")
      m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Double", "doubleValue", "()D", false)
    }
    TyBool -> {
      m.visitTypeInsn(OP_CHECKCAST, "java/lang/Boolean")
      m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Boolean", "booleanValue", "()Z", false)
    }
    TyString -> { m.visitTypeInsn(OP_CHECKCAST, "java/lang/String") }
    TyBytes -> { m.visitTypeInsn(OP_CHECKCAST, "[B") }
    TyAdt(aid, _) -> { m.visitTypeInsn(OP_CHECKCAST, adt_jvm_name(adt_of(g.adts, aid))) }
    TyList(_) -> { m.visitTypeInsn(OP_CHECKCAST, "java/util/List") }
    TyMap(_, _) -> { m.visitTypeInsn(OP_CHECKCAST, "java/util/Map") }
    TySet(_) -> { m.visitTypeInsn(OP_CHECKCAST, "java/util/Set") }
    TyArray(_) -> { m.visitTypeInsn(OP_CHECKCAST, ARRAY_CLASS) }
    TyTuple(elems) -> { m.visitTypeInsn(OP_CHECKCAST, tuple_class(len(elems))) }
    TyJava(fqcn, _) -> { m.visitTypeInsn(OP_CHECKCAST, internal_of(fqcn)) }
    TyFn(params, _, _) -> { m.visitTypeInsn(OP_CHECKCAST, fn_iface(len(params))) }
    TyUnit -> { m.visitInsn(OP_POP) }
    # TyVar is already erased, and the two bottom types carry no value
    TyVar(_, _) | TyNever | TyError -> ()
  }
  ()
}

fn pop_value(g: Gen, t: Ty) -> Unit !io = {
  let n = slots_of(t)
  if n == 2 {
    g.mv.visitInsn(OP_POP2)
  } else if n == 1 {
    g.mv.visitInsn(OP_POP)
  }
  ()
}

# ---- descriptor plumbing over Java class NAMES (Class.getName forms) ----

## Class name → JVM descriptor: primitives map, arrays are already close
## ("[Ljava.lang.String;" wants '/'), references get L…; .
pub fn jdesc(cls: String) -> String =
  if cls == "int" { "I" } else if cls == "long" { "J" } else if cls == "short" { "S" }
  else if cls == "byte" { "B" } else if cls == "char" { "C" } else if cls == "boolean" { "Z" }
  else if cls == "float" { "F" } else if cls == "double" { "D" } else if cls == "void" { "V" }
  else if str.starts_with(cls, "[") { join(str.split(cls, "."), "/") }
  else { "L" ++ join(str.split(cls, "."), "/") ++ ";" }

## Class name → internal name (arrays keep their descriptor form, like ASM).
pub fn internal_of(cls: String) -> String =
  if str.starts_with(cls, "[") { join(str.split(cls, "."), "/") }
  else { join(str.split(cls, "."), "/") }

fn is_prim_name(cls: String) -> Bool =
  cls == "int" || cls == "long" || cls == "short" || cls == "byte" || cls == "char" ||
  cls == "boolean" || cls == "float" || cls == "double" || cls == "void"

fn jmethod_desc(param_cls: List[String], ret_cls: String) -> String = {
  var ps = ""
  for p in param_cls { ps = ps ++ jdesc(p) }
  "(" ++ ps ++ ")" ++ jdesc(ret_cls)
}

# ---- signature-derived descriptors ----

## fn descriptor with the hidden dictionary params appended (dicts = Object).
fn sig_desc_with_dicts(adts: Adts, s: Sig) -> String = {
  var ps = ""
  for p in s.param_tys { ps = ps ++ desc_of(adts, p) }
  var dicts = 0
  for c in s.constraints { dicts = dicts + len(c) }
  for _i in 0 ..dicts { ps = ps ++ "Ljava/lang/Object;" }
  "(" ++ ps ++ ")" ++ desc_of(adts, s.ret)
}

fn fn_desc_with_dicts(g: Gen, s: Sig) -> String = sig_desc_with_dicts(g.adts, s)

fn trait_method_desc(g: Gen, s: Sig) -> String = method_desc(g.adts, s.param_tys, s.ret)

## impl method static name: dawn$impl$<Trait>$<Subject>$<m>.
fn impl_method_name(g: Gen, trait_name: String, subject: Ty, m: String) -> String =
  "dawn\$impl\$" ++ trait_name ++ "\$" ++ subject_name(g.adts, subject) ++ "\$" ++ m

fn default_method_name(trait_name: String, m: String) -> String =
  "dawn\$default\$" ++ trait_name ++ "\$" ++ m

## The boxed JVM type of a concrete Dawn type (LMF instantiatedMethodType).
fn boxed_desc_of(g: Gen, t: Ty) -> String =
  match jvm_repr(t) {
    RLong -> "Ljava/lang/Long;"
    RDouble -> "Ljava/lang/Double;"
    RBool -> "Ljava/lang/Boolean;"
    RUnit -> "Ljava/lang/Object;"
    RBottom -> "Ljava/lang/Object;"
    RRef -> desc_of(g.adts, t)
  }

fn instantiated_type(g: Gen, params: List[Ty], ret: Ty) -> Type !io = {
  var ps = ""
  for p in params { ps = ps ++ boxed_desc_of(g, p) }
  Type.getMethodType(ps2desc(ps, boxed_desc_of(g, ret))).expect("method type")
}

fn ps2desc(ps: String, ret: String) -> String = "(" ++ ps ++ ")" ++ ret

## impl-method descriptor for lambdas/bridges: concrete types, but a 0-slot
## return (Unit/Never) becomes Object so LMF can adapt it.
fn impl_desc_of(g: Gen, params: List[Ty], ret: Ty) -> String = {
  var ps = ""
  for p in params { ps = ps ++ desc_of(g.adts, p) }
  let r = if slots_of(ret) == 0 { "Ljava/lang/Object;" } else { desc_of(g.adts, ret) }
  "(" ++ ps ++ ")" ++ r
}

## The LambdaMetafactory bootstrap handle.
fn lmf_bsm() -> Handle !io =
  Handle.new(OP_H_INVOKESTATIC, "java/lang/invoke/LambdaMetafactory", "metafactory",
    "(Ljava/lang/invoke/MethodHandles\$Lookup;Ljava/lang/String;Ljava/lang/invoke/MethodType;" ++
      "Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodHandle;Ljava/lang/invoke/MethodType;)" ++
      "Ljava/lang/invoke/CallSite;",
    false)

# ---- witness / signature lookup ----

fn impl_of(g: Gen, tid: Int, subject: Ty) -> ImplI =
  match impl_at(g.impl_table, tid, subject) {
    Some(i) -> i
    None -> panic("codegen: no impl for trait ${tid}")
  }

fn trait_method_sig(tr: TraitI, name: String) -> Sig = {
  for entry in tr.methods {
    let (mn, ms) = entry
    if mn == name { return ms.sig }
  }
  panic("codegen: trait `" ++ tr.name ++ "` has no method `" ++ name ++ "`")
}

## The trait method's signature with the subject substituted for the tvar —
## the concrete shape of the impl's provided static (checker verified match).
fn subst_subject(tr: TraitI, s: Sig, subject: Ty) -> Sig = {
  let vid = match tr.tvar {
    TyVar(_, v) -> v
    _ -> panic("trait tvar")
  }
  var ps: List[Ty] = []
  for p in s.param_tys { ps = ps ++ [subst_tvar(p, vid, subject)] }
  Sig { ..s, param_tys: ps, ret: subst_tvar(s.ret, vid, subject) }
}

fn subst_tvar(t: Ty, vid: Int, to: Ty) -> Ty =
  match t {
    TyVar(_, v) -> if v == vid { to } else { t }
    TyOpaque(id, n, ow, tgt) -> TyOpaque(id, n, ow, subst_tvar(tgt, vid, to))
    TyList(e) -> TyList(subst_tvar(e, vid, to))
    TyMap(k, v2) -> TyMap(subst_tvar(k, vid, to), subst_tvar(v2, vid, to))
    TySet(e) -> TySet(subst_tvar(e, vid, to))
    TyArray(e) -> TyArray(subst_tvar(e, vid, to))
    TyTuple(es) -> {
      var out: List[Ty] = []
      for e in es { out = out ++ [subst_tvar(e, vid, to)] }
      TyTuple(out)
    }
    TyAdt(aid, args) -> {
      var out: List[Ty] = []
      for a in args { out = out ++ [subst_tvar(a, vid, to)] }
      TyAdt(aid, out)
    }
    TyFn(ps, r, e) -> {
      var out: List[Ty] = []
      for p in ps { out = out ++ [subst_tvar(p, vid, to)] }
      TyFn(out, subst_tvar(r, vid, to), e)
    }
    # the variants with no type arguments to walk into. Spelled out rather than
    # left to a wildcard: a new *parameterised* variant landing here would
    # silently stop substituting, which shows up as a wrong descriptor much
    # later
    TyInt | TyFloat | TyBool | TyString | TyBytes -> t
    TyUnit | TyNever | TyError | TyJava(_, _) -> t
  }

fn gen_load_const(g: Gen, v: CValue, t: Ty, key: String) -> Gen !io = {
  match v {
    VInt(x) -> {
      ldc_long(g.mv, x)
      g
    }
    VFloat(x) -> {
      ldc_double(g.mv, x)
      g
    }
    VBool(x) -> {
      g.mv.visitInsn(if x { OP_ICONST_1 } else { OP_ICONST_0 })
      g
    }
    VStr(x) -> {
      ldc_str(g.mv, x)
      g
    }
    VUnit -> g
    _ -> {
      let (g1, fname) = match map.get(g.const_by_key, key) {
        Some(f) -> (g, f)
        None -> {
          let f = "dawn\$const\$" ++ to_string(len(g.const_fields))
          (Gen {
            ..g,
            const_fields: g.const_fields ++ [ConstF { fname: f, v: v, ty: t }],
            const_by_key: map.insert(g.const_by_key, key, f)
          }, f)
        }
      }
      g1.mv.visitFieldInsn(OP_GETSTATIC, g1.class_name, fname, desc_of(g1.adts, t))
      g1
    }
  }
}

## Emit bytecode that rebuilds a comptime value (boxed = erased position).
fn construct_value(g: Gen, m: MethodVisitor, v: CValue, boxed: Bool) -> Unit !io = {
  match v {
    VInt(x) -> {
      ldc_long(m, x)
      if boxed {
        m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf",
          "(J)Ljava/lang/Long;", false)
      }
    }
    VFloat(x) -> {
      ldc_double(m, x)
      if boxed {
        m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Double", "valueOf",
          "(D)Ljava/lang/Double;", false)
      }
    }
    VBool(x) -> {
      m.visitInsn(if x { OP_ICONST_1 } else { OP_ICONST_0 })
      if boxed {
        m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Boolean", "valueOf",
          "(Z)Ljava/lang/Boolean;", false)
      }
    }
    VStr(x) -> { ldc_str(m, x) }
    VUnit -> if boxed { push_unit(m) }
    VList(elems) -> {
      m.visitTypeInsn(OP_NEW, ARRAYLIST)
      m.visitInsn(OP_DUP)
      m.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "()V", false)
      for el in elems {
        m.visitInsn(OP_DUP)
        construct_value(g, m, el, true)
        m.visitMethodInsn(OP_INVOKEVIRTUAL, ARRAYLIST, "add", "(Ljava/lang/Object;)Z", false)
        m.visitInsn(OP_POP)
      }
    }
    VTuple(elems) -> {
      let cls = tuple_class(len(elems))
      m.visitTypeInsn(OP_NEW, cls)
      m.visitInsn(OP_DUP)
      for el in elems { construct_value(g, m, el, true) }
      var ps = ""
      for _i in 0 ..len(elems) { ps = ps ++ "Ljava/lang/Object;" }
      m.visitMethodInsn(OP_INVOKESPECIAL, cls, "<init>", "(" ++ ps ++ ")V", false)
    }
    VAdt(aid, cidx, fields) -> {
      let a = adt_of(g.adts, aid)
      let ci = a.ctors[cidx]
      let sub = ctor_jvm_name(g.adts, ci)
      if len(ci.fields) == 0 {
        m.visitFieldInsn(OP_GETSTATIC, sub, "INSTANCE", "L" ++ sub ++ ";")
      } else {
        m.visitTypeInsn(OP_NEW, sub)
        m.visitInsn(OP_DUP)
        var i = 0
        for f in fields {
          let boxed2 = match ci.fields[i].ty {
            TyVar(_, _) -> true
            _ -> false
          }
          construct_value(g, m, f, boxed2)
          i = i + 1
        }
        var ps = ""
        for fd in ci.fields { ps = ps ++ desc_of(g.adts, fd.ty) }
        m.visitMethodInsn(OP_INVOKESPECIAL, sub, "<init>", "(" ++ ps ++ ")V", false)
      }
    }
    _ -> panic("a function value cannot be a constant (checker bug)")
  }
  ()
}

fn gen_const_fields(g: Gen, cw: AdtClassWriter) -> Unit !io = {
  if len(g.const_fields) == 0 { return () }
  for f in g.const_fields {
    cw.field(ACC_PUBLIC + ACC_STATIC + ACC_FINAL, f.fname, desc_of(g.adts, f.ty))
  }
  let cl = cw.method(ACC_STATIC, "<clinit>", "()V").expect("mv")
  cl.visitCode()
  for f in g.const_fields {
    construct_value(g, cl, f.v, false)
    cl.visitFieldInsn(OP_PUTSTATIC, g.class_name, f.fname, desc_of(g.adts, f.ty))
  }
  cl.visitInsn(OP_RETURN)
  cl.visitMaxs(0, 0)
  cl.visitEnd()
  ()
}

## The return instruction follows the *representation*, so this asks the one
## total function rather than testing types by hand: a chain of `t == Ty...`
## here is unreachable by the exhaustiveness checker, and its else-branch
## returns void -- a new variant would silently emit a method that drops its
## own result (S0.3, and an opaque type is how that was found).
fn emit_method_return(g: Gen) -> Unit !io = {
  match jvm_repr(g.method_ret) {
    RLong -> { g.mv.visitInsn(OP_LRETURN) }
    RDouble -> { g.mv.visitInsn(OP_DRETURN) }
    RBool -> { g.mv.visitInsn(OP_IRETURN) }
    RRef -> { g.mv.visitInsn(OP_ARETURN) }
    RUnit | RBottom ->
      if g.rets_null {
        push_unit(g.mv)
        g.mv.visitInsn(OP_ARETURN)
      } else {
        g.mv.visitInsn(OP_RETURN)
      }
  }
  ()
}

fn tyfn_parts(t: Ty) -> (List[Ty], Ty) =
  match t {
    TyFn(ps, r, _) -> (ps, r)
    _ -> panic("expected a fn type")
  }

## Two same-typed orderable scalars on the stack -> their cmp, widened to a
## long because Dawn's Int is one.
##
## Spelled out per type rather than defaulted to String, for the reason
## hash_of gives: this is the JVM's implementation of the `cmp` contract, and
## a type with no order here has to say so instead of being handed the
## nearest available answer.
fn emit_scalar_cmp(g: Gen, t: Ty) -> Unit !io = {
  emit_scalar_cmp_at(g, t)
  g.mv.visitInsn(OP_I2L)
  ()
}

## The comparison itself, leaving an int: recursion through an opaque type
## must not widen once per layer.
fn emit_scalar_cmp_at(g: Gen, t: Ty) -> Unit !io = {
  match t {
    TyInt -> { g.mv.visitInsn(OP_LCMP) }
    TyFloat -> {
      # the total order, which disagrees with `<` on NaN and -0.0 on purpose
      g.mv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Double", "compare", "(DD)I", false)
    }
    TyString -> {
      g.mv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/String", "compareTo",
        "(Ljava/lang/String;)I", false)
    }
    # opacity hides a representation from other modules, not from the language:
    # the value on the stack is the target, so its order is the target's
    TyOpaque(_, _, _, tgt) -> emit_scalar_cmp_at(g, tgt)
    _ -> panic("codegen: no scalar order for " ++ ty_key(t))
  }
  ()
}

## The string/list/map/io half of the intrinsic contract, as one table.
## Every entry lowers to a single INVOKESTATIC into a backend runtime class;
## the descriptor is `method_desc` of the builtin signature and each arg is
## adapted to its declared slot, so only the (class, method) pair varies here.
## `None` means the builtin is not a plain runtime call — it has bespoke
## bytecode in gen_builtin_call (panic, len, expect, cursor_slice, …). A second
## backend re-implements these same names against its own runtime.
## The JVM class each runtime module is. The *which module* half is declared
## with the intrinsic (types.intrinsics); this is the only part that is the
## JVM's business, which is what makes the same table usable by emitc.
fn rt_class(o: Rt) -> String =
  match o {
    RtLists -> LISTS_CLASS
    RtStrings -> STRINGS_CLASS
    RtMaps -> MAPS_CLASS
    RtBytes -> BYTES_CLASS
    RtArray -> ARRAY_CLASS
    RtIo -> IO_CLASS
  }

fn rt_intrinsic_target(name: String) -> Option[(String, String)] =
  match intr_at(name) {
    Some(i) ->
      match i.rt {
        Some(t) -> {
          let (o, m) = t
          Some((rt_class(o), m))
        }
        None -> None
      }
    None -> None
  }

fn push_cmp_result(g: Gen, jump_if_true: Int) -> Unit !io = {
  let true_l = Label.new()
  let end = Label.new()
  g.mv.visitJumpInsn(jump_if_true, true_l)
  g.mv.visitInsn(OP_ICONST_0)
  g.mv.visitJumpInsn(OP_GOTO, end)
  g.mv.visitLabel(true_l)
  g.mv.visitInsn(OP_ICONST_1)
  g.mv.visitLabel(end)
  ()
}

## Stack: a b (both long). Panic when b == 0 (spec §8.2 — must pass java_try).
fn emit_div_zero_check(g: Gen, op: String) -> Unit !io = {
  let ok = Label.new()
  g.mv.visitInsn(OP_DUP2)
  g.mv.visitInsn(OP_LCONST_0)
  g.mv.visitInsn(OP_LCMP)
  g.mv.visitJumpInsn(OP_IFNE, ok)
  g.mv.visitTypeInsn(OP_NEW, PANIC_CLASS)
  g.mv.visitInsn(OP_DUP)
  ldc_str(g.mv, "Int " ++ op ++ " by zero")
  g.mv.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>", "(Ljava/lang/String;)V", false)
  g.mv.visitInsn(OP_ATHROW)
  g.mv.visitLabel(ok)
  ()
}

fn gen_equality(g: Gen, t: Ty, op: TBinOp) -> Unit !io = {
  if t == TyBytes {
    g.mv.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "equals", "([B[B)Z", false)
    match op {
      BNeq -> {
        g.mv.visitInsn(OP_ICONST_1)
        g.mv.visitInsn(OP_IXOR)
      }
      _ -> ()
    }
  } else if is_ref(t) {
    g.mv.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "equals", "(Ljava/lang/Object;)Z", false)
    match op {
      BNeq -> {
        g.mv.visitInsn(OP_ICONST_1)
        g.mv.visitInsn(OP_IXOR)
      }
      _ -> ()
    }
  } else if t == TyBool {
    g.mv.visitInsn(OP_IXOR)
    match op {
      BEq -> {
        g.mv.visitInsn(OP_ICONST_1)
        g.mv.visitInsn(OP_IXOR)
      }
      _ -> ()
    }
  } else {
    g.mv.visitInsn(if t == TyFloat { OP_DCMPL } else { OP_LCMP })
    push_cmp_result(g, match op {
      BEq -> OP_IFEQ
      _ -> OP_IFNE
    })
  }
  ()
}

fn gen_ordering(g: Gen, t: Ty, op: TBinOp) -> Unit !io = {
  if t == TyInt {
    g.mv.visitInsn(OP_LCMP)
  } else if t == TyString {
    g.mv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/String", "compareTo",
      "(Ljava/lang/String;)I", false)
  } else {
    let use_g = match op {
      BLt -> true
      BLe -> true
      _ -> false
    }
    g.mv.visitInsn(if use_g { OP_DCMPG } else { OP_DCMPL })
  }
  push_cmp_result(g, ord_jump(op))
  ()
}

fn ord_jump(op: TBinOp) -> Int =
  match op {
    BLt -> OP_IFLT
    BLe -> OP_IFLE
    BGt -> OP_IFGT
    _ -> OP_IFGE
  }

fn adapt_java_arg(g: Gen, dawn_ty: Ty, param_cls: String) -> Unit !io = {
  if dawn_ty == TyInt && param_cls == "int" {
    g.mv.visitInsn(OP_L2I)
  } else if dawn_ty == TyFloat && param_cls == "float" {
    g.mv.visitInsn(OP_D2F)
  } else {
    match dawn_ty {
      TyJava(fqcn, _) ->
        if not is_prim_name(param_cls) && not jreflect.is_assignable(param_cls, fqcn) {
          g.mv.visitTypeInsn(OP_CHECKCAST, internal_of(param_cls))
        }
      _ -> ()
    }
  }
  ()
}

## `new C[n]` for a component class — n is already on the stack.
fn new_array(g: Gen, component: String) -> Unit !io = {
  if is_prim_name(component) {
    let t = if component == "long" { 11 } else if component == "int" { 10 }
    else if component == "double" { 7 } else if component == "float" { 6 }
    else if component == "boolean" { 4 } else if component == "short" { 9 }
    else if component == "byte" { 8 } else { 5 }
    g.mv.visitIntInsn(OP_NEWARRAY, t)
  } else {
    g.mv.visitTypeInsn(OP_ANEWARRAY, internal_of(component))
  }
  ()
}

fn array_store_op(component: String) -> Int =
  if component == "long" { OP_LASTORE } else if component == "int" { OP_IASTORE }
  else if component == "double" { OP_DASTORE } else if component == "float" { OP_FASTORE }
  else if component == "boolean" || component == "byte" { OP_BASTORE }
  else if component == "short" { OP_SASTORE } else if component == "char" { OP_CASTORE }
  else { OP_AASTORE }

fn sam_conv_at(call: TJavaCall, i: Int) -> Option[(Int, String, String, List[String], String)] = {
  for c in call.sam_convs {
    let (idx, _, _, _, _) = c
    if idx == i { return Some(c) }
  }
  None
}

fn is_list_bridge(call: TJavaCall, i: Int) -> Bool = {
  for b in call.list_bridges {
    if b == i { return true }
  }
  false
}

## Zero-copy unmodifiable view for a Dawn List handed to Java (spec §9.6).
fn emit_list_bridge(g: Gen) -> Unit !io = {
  g.mv.visitMethodInsn(OP_INVOKESTATIC, "java/util/Collections", "unmodifiableList",
    "(Ljava/util/List;)Ljava/util/List;", false)
  ()
}

## A Dawn fn value → an instance of the target functional interface (§9.4).
fn emit_sam_conversion(
  g: Gen,
  conv: (Int, String, String, List[String], String),
  ft: Ty
) -> Gen !io = {
  let (_, iface, sam_name, sam_params, sam_ret) = conv
  let (fps, _) = tyfn_parts(ft)
  let n = len(fps)
  let bridge = "dawn\$sam\$" ++ to_string(g.sam_ctr)
  let g1 = Gen {
    ..g,
    sam_ctr: g.sam_ctr + 1,
    pending_sam: g.pending_sam ++ [SamB {
      name: bridge,
      iface: iface,
      sam_name: sam_name,
      sam_params: sam_params,
      sam_ret: sam_ret
    }]
  }
  let sam_type = Type.getMethodType(jmethod_desc(sam_params, sam_ret)).expect("mt")
  var pdescs = ""
  for p in sam_params { pdescs = pdescs ++ jdesc(p) }
  let bridge_desc = "(L" ++ fn_iface(n) ++ ";" ++ pdescs ++ ")" ++ jdesc(sam_ret)
  g1.mv.visitInvokeDynamicInsn(sam_name, "(L" ++ fn_iface(n) ++ ";)" ++ jdesc(iface),
    lmf_bsm(), sam_type,
    Handle.new(OP_H_INVOKESTATIC, g1.class_name, bridge, bridge_desc, false),
    sam_type)
  g1
}

fn adapt_one_java_arg(g: Gen, call: TJavaCall, i: Int, aty: Ty, param: String) -> Gen !io = {
  match sam_conv_at(call, i) {
    Some(conv) -> emit_sam_conversion(g, conv, aty)
    None -> {
      if is_list_bridge(call, i) {
        emit_list_bridge(g)
      } else {
        adapt_java_arg(g, aty, param)
      }
      g
    }
  }
}

## The arguments of one Java call (§9.3): fixed part, then the variadic pack.
fn gen_java_args(g: Gen, jc: CJava) -> (Gen, Bool) !io = {
  let call = jc.call
  let fixed = match call.varargs_pack {
    Some(p) -> p
    None -> len(jc.args)
  }
  var g1 = g
  var i = 0
  while i < fixed {
    let (g2, falls) = gen_cexpr(g1, jc.args[i], false)
    g1 = g2
    if not falls { return (g1, false) }
    g1 = adapt_one_java_arg(g1, call, i, jc.arg_tys[i], call.param_cls[i])
    i = i + 1
  }
  match call.varargs_pack {
    None -> (g1, true)
    Some(pack) -> {
      let last = call.param_cls[len(call.param_cls) - 1]
      let component = match jreflect.component_of(last) {
        Some(c) -> c
        None -> panic("variadic parameter is not an array")
      }
      push_int(g1.mv, len(jc.args) - pack)
      new_array(g1, component)
      let store = array_store_op(component)
      var k = pack
      while k < len(jc.args) {
        g1.mv.visitInsn(OP_DUP)
        push_int(g1.mv, k - pack)
        let (g2, falls) = gen_cexpr(g1, jc.args[k], false)
        g1 = g2
        if not falls { return (g1, false) }
        g1 = adapt_one_java_arg(g1, call, k, jc.arg_tys[k], component)
        g1.mv.visitInsn(store)
        k = k + 1
      }
      (g1, true)
    }
  }
}

## Type.new(args): direct construction — never null, no Option wrap.
fn gen_java_new(g: Gen, jc: CJava) -> (Gen, Bool) !io = {
  let call = jc.call
  let owner = internal_of(call.fqcn)
  g.mv.visitTypeInsn(OP_NEW, owner)
  g.mv.visitInsn(OP_DUP)
  let (g1, falls) = gen_java_args(g, jc)
  if not falls { return (g1, false) }
  g1.mv.visitMethodInsn(OP_INVOKESPECIAL, owner, "<init>",
    jmethod_desc(call.param_cls, "void"), false)
  (g1, true)
}

## Reference on the stack → Some(ref) / None (§9.2).
fn wrap_nullable_in_option(g: Gen) -> Gen !io = {
  let (ga, tmp) = alloc(g, 1)
  let g1 = ga
  g1.mv.visitVarInsn(OP_ASTORE, tmp)
  let non_null = Label.new()
  let end = Label.new()
  g1.mv.visitVarInsn(OP_ALOAD, tmp)
  g1.mv.visitJumpInsn(OP_IFNONNULL, non_null)
  g1.mv.visitFieldInsn(OP_GETSTATIC, "Option\$None", "INSTANCE", "LOption\$None;")
  g1.mv.visitTypeInsn(OP_CHECKCAST, "Option")
  g1.mv.visitJumpInsn(OP_GOTO, end)
  g1.mv.visitLabel(non_null)
  g1.mv.visitTypeInsn(OP_NEW, "Option\$Some")
  g1.mv.visitInsn(OP_DUP)
  g1.mv.visitVarInsn(OP_ALOAD, tmp)
  g1.mv.visitMethodInsn(OP_INVOKESPECIAL, "Option\$Some", "<init>", "(Ljava/lang/Object;)V", false)
  g1.mv.visitTypeInsn(OP_CHECKCAST, "Option")
  g1.mv.visitLabel(end)
  g1
}

## Class.FIELD — GETSTATIC then the same value adaptation as a method return
## (§9.2): small ints/floats widen, references wrap in Option (spec §9.1).
fn gen_java_field(g: Gen, call: TJavaCall) -> (Gen, Bool) !io = {
  let owner = internal_of(call.decl_cls)
  g.mv.visitFieldInsn(OP_GETSTATIC, owner, call.method, jdesc(call.ret_cls))
  var g1 = g
  let rc = call.ret_cls
  if rc == "int" || rc == "short" || rc == "byte" {
    g1.mv.visitInsn(OP_I2L)
  } else if rc == "float" {
    g1.mv.visitInsn(OP_F2D)
  } else if rc == "long" || rc == "double" || rc == "boolean" {
    ()
  } else {
    g1 = wrap_nullable_in_option(g1)
  }
  (g1, true)
}

fn gen_java_call(g: Gen, jc: CJava, ty: Ty) -> (Gen, Bool) !io = {
  let call = jc.call
  let owner = internal_of(call.decl_cls)
  let itf = match jreflect.find_class(call.decl_cls) {
    Some(j) -> j.is_interface
    None -> false
  }
  var g1 = g
  if not call.is_static {
    match jc.target {
      Some(t) -> {
        let (g2, falls) = gen_cexpr(g1, t, false)
        g1 = g2
        if not falls { return (g1, false) }
      }
      None -> ()
    }
  }
  let (g3, falls2) = gen_java_args(g1, jc)
  g1 = g3
  if not falls2 { return (g1, false) }
  let opcode = if call.is_static { OP_INVOKESTATIC }
  else if itf { OP_INVOKEINTERFACE } else { OP_INVOKEVIRTUAL }
  g1.mv.visitMethodInsn(opcode, owner, call.method,
    jmethod_desc(call.param_cls, call.ret_cls), itf)
  # returns (§9.2): small ints widen, floats widen, references wrap in Option
  let rc = call.ret_cls
  if rc == "int" || rc == "short" || rc == "byte" {
    g1.mv.visitInsn(OP_I2L)
  } else if rc == "float" {
    g1.mv.visitInsn(OP_F2D)
  } else if rc == "void" || rc == "long" || rc == "double" || rc == "boolean" {
  } else {
    g1 = wrap_nullable_in_option(g1)
  }
  (g1, true)
}

## static <samRet> dawn$sam$N(FnN f, <sam params>): null-check references,
## box to the erased Fn convention, invoke, adapt the result (§9.4).
fn gen_sam_bridge(g: Gen, cw: AdtClassWriter, b: SamB) -> Gen !io = {
  let n = len(b.sam_params)
  var pdescs = ""
  for p in b.sam_params { pdescs = pdescs ++ jdesc(p) }
  let desc = "(L" ++ fn_iface(n) ++ ";" ++ pdescs ++ ")" ++ jdesc(b.sam_ret)
  let m = cw.method(ACC_PRIVATE + ACC_STATIC + OP_ACC_SYNTHETIC, b.name, desc).expect("mv")
  m.visitCode()
  m.visitVarInsn(OP_ALOAD, 0)
  var slot = 1
  var i = 0
  for p in b.sam_params {
    if p == "long" {
      m.visitVarInsn(OP_LLOAD, slot)
      slot = slot + 2
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;", false)
    } else if p == "int" || p == "short" || p == "byte" {
      m.visitVarInsn(OP_ILOAD, slot)
      slot = slot + 1
      m.visitInsn(OP_I2L)
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;", false)
    } else if p == "double" {
      m.visitVarInsn(OP_DLOAD, slot)
      slot = slot + 2
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Double", "valueOf",
        "(D)Ljava/lang/Double;", false)
    } else if p == "float" {
      m.visitVarInsn(OP_FLOAD, slot)
      slot = slot + 1
      m.visitInsn(OP_F2D)
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Double", "valueOf",
        "(D)Ljava/lang/Double;", false)
    } else if p == "boolean" {
      m.visitVarInsn(OP_ILOAD, slot)
      slot = slot + 1
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Boolean", "valueOf",
        "(Z)Ljava/lang/Boolean;", false)
    } else {
      m.visitVarInsn(OP_ALOAD, slot)
      slot = slot + 1
      let ok = Label.new()
      m.visitInsn(OP_DUP)
      m.visitJumpInsn(OP_IFNONNULL, ok)
      m.visitTypeInsn(OP_NEW, PANIC_CLASS)
      m.visitInsn(OP_DUP)
      ldc_str(m, "Java passed null to parameter " ++ to_string(i + 1) ++
          " of a Dawn callback (" ++ b.iface ++ ")")
      m.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>", "(Ljava/lang/String;)V", false)
      m.visitInsn(OP_ATHROW)
      m.visitLabel(ok)
    }
    i = i + 1
  }
  m.visitMethodInsn(OP_INVOKEINTERFACE, fn_iface(n), "apply", erased_apply_desc(n), true)
  let rc = b.sam_ret
  if rc == "void" {
    m.visitInsn(OP_POP)
    m.visitInsn(OP_RETURN)
  } else if rc == "long" {
    m.visitTypeInsn(OP_CHECKCAST, "java/lang/Long")
    m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J", false)
    m.visitInsn(OP_LRETURN)
  } else if rc == "int" || rc == "short" || rc == "byte" {
    m.visitTypeInsn(OP_CHECKCAST, "java/lang/Long")
    m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J", false)
    let tmp = slot
    m.visitVarInsn(OP_LSTORE, tmp)
    let ok = Label.new()
    m.visitVarInsn(OP_LLOAD, tmp)
    m.visitInsn(OP_L2I)
    m.visitInsn(OP_I2L)
    m.visitVarInsn(OP_LLOAD, tmp)
    m.visitInsn(OP_LCMP)
    m.visitJumpInsn(OP_IFEQ, ok)
    m.visitTypeInsn(OP_NEW, PANIC_CLASS)
    m.visitInsn(OP_DUP)
    ldc_str(m, "Dawn callback returned an Int outside Java int range")
    m.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>", "(Ljava/lang/String;)V", false)
    m.visitInsn(OP_ATHROW)
    m.visitLabel(ok)
    m.visitVarInsn(OP_LLOAD, tmp)
    m.visitInsn(OP_L2I)
    m.visitInsn(OP_IRETURN)
  } else if rc == "boolean" {
    m.visitTypeInsn(OP_CHECKCAST, "java/lang/Boolean")
    m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Boolean", "booleanValue", "()Z", false)
    m.visitInsn(OP_IRETURN)
  } else if rc == "double" {
    m.visitTypeInsn(OP_CHECKCAST, "java/lang/Double")
    m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Double", "doubleValue", "()D", false)
    m.visitInsn(OP_DRETURN)
  } else if rc == "float" {
    m.visitTypeInsn(OP_CHECKCAST, "java/lang/Double")
    m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Double", "doubleValue", "()D", false)
    m.visitInsn(OP_D2F)
    m.visitInsn(OP_FRETURN)
  } else {
    m.visitTypeInsn(OP_CHECKCAST, internal_of(rc))
    m.visitInsn(OP_ARETURN)
  }
  m.visitMaxs(0, 0)
  m.visitEnd()
  g
}

# ---- functions and the module class ----

## Generate one static method for `f`. Everything about the method except
## its body -- class, name, descriptor, parameter slots -- is set up here;
## the body comes from Core, and `lower_fn_only` hands back any lambdas it
## hoisted, which are emitted as ordinary static methods beside it.
fn gen_fn(g: Gen, cw: AdtClassWriter, f: TFun, name: String, desc: String) -> Gen !io = {
  let (cf, lifted, dicts, next_lam) =
    lower.lower_fn_only(g.class_name, f, g.traits, g.impl_table, g.adts,
      g.prog_fns, g.syms, g.lambda_ctr)
  # Register the hoisted bodies before generating anything: the main body may
  # call one by name, and the descriptor has to be known at that call site.
  var g1 = Gen { ..g, lambda_ctr: next_lam }
  for d in dicts {
    var have = false
    for e in g1.dicts {
      if e.key == d.key { have = true }
    }
    if not have { g1 = Gen { ..g1, dicts: g1.dicts ++ [d] } }
  }
  var fresh: List[CFun] = []
  for lf in lifted {
    var ptys: List[Ty] = []
    for p in lf.captures { ptys = ptys ++ [p.ty] }
    for p in lf.params { ptys = ptys ++ [p.ty] }
    # a dictionary parameter is erased and hidden, but it is still a
    # parameter: a bridge whose descriptor omitted it verified only because
    # nothing on the JVM ever called one
    for _d in lf.dicts { ptys = ptys ++ [TyVar("D", 0)] }
    if not map.has(g1.lifted_descs, (g1.class_name, lf.name)) {
      # A dictionary slot body is called from the dictionary class against
      # the trait method's own descriptor. Every other hoisted body sits
      # behind an erased `apply`, where a zero-slot return still has to hand
      # back a reference -- which is the difference impl_desc_of encodes.
      let d =
        if is_slot_target(g1, lf.name) {
          method_desc(g1.adts, ptys, lf.ret)
        } else {
          impl_desc_of(g1, ptys, lf.ret)
        }
      g1 = Gen { ..g1, lifted_descs: map.insert(g1.lifted_descs, (g1.class_name, lf.name), d) }
      fresh = fresh ++ [lf]
    }
  }
  var g0 = gen_cbody(g1, cw, cf, name, desc, false)
  for lf in fresh {
    g0 = gen_cbody(g0, cw, lf, lf.name, lifted_desc(g0, lf.name), true)
  }
  g0
}

## Is this hoisted body the target of one of this class's dictionary slots?
## Those are reached from the dictionary class, which lives in its own
## package, so they can be neither private nor shaped like a lambda.
fn is_slot_target(g: Gen, name: String) -> Bool = {
  for dd in g.dicts {
    for s in dd.slots {
      match s {
        CSlotFn(owner, n) -> if owner == g.class_name && n == name { return true }
        CSlotDefault(_, _) -> ()
      }
    }
  }
  false
}

fn lifted_desc(g: Gen, name: String) -> String =
  match map.get(g.lifted_descs, (g.class_name, name)) {
    Some(d) -> d
    None -> panic("codegen: no descriptor for hoisted body `" ++ name ++ "`")
  }

fn gen_cbody(
  g: Gen,
  cw: AdtClassWriter,
  cf: CFun,
  name: String,
  desc: String,
  lifted: Bool
) -> Gen !io = {
  let slot_body = lifted && is_slot_target(g, name)
  let acc =
    if not lifted {
      ACC_PUBLIC + ACC_STATIC
    } else if slot_body {
      ACC_PUBLIC + ACC_STATIC + OP_ACC_SYNTHETIC
    } else {
      ACC_PRIVATE + ACC_STATIC + OP_ACC_SYNTHETIC
    }
  let m = cw.method(acc, name, desc).expect("mv")
  m.visitCode()
  var g1 = Gen {
    ..g,
    mv: m,
    next_slot: 0,
    method_ret: cf.ret,
    # a lifted body sits behind the erased `apply`, so a zero-slot return
    # type still has to hand back a reference. A dictionary slot body does
    # not: it is called against the trait's own descriptor.
    rets_null: lifted && not slot_body,
    cloops: []
  }
  for p in cf.captures {
    let (g2, slot) = alloc(g1, slots_of(p.ty))
    g1 = cbind(g2, p.sym, p.ty, slot)
  }
  for p in cf.params {
    let (g2, slot) = alloc(g1, slots_of(p.ty))
    g1 = cbind(g2, p.sym, p.ty, slot)
  }
  for d in cf.dicts {
    let (g2, slot) = alloc(g1, slots_of(d.ty))
    g1 = cbind(g2, d.sym, d.ty, slot)
  }
  let (g3, falls) = gen_cexpr(g1, cf.body, false)
  if falls { emit_method_return(g3) }
  m.visitMaxs(0, 0)
  m.visitEnd()
  g3
}

## Emit the bridges a `use java` argument queued. Lambdas no longer queue:
## lowering lifts them, so they are emitted with the function they came from.
fn drain_lambdas(g: Gen, cw: AdtClassWriter) -> Gen !io = {
  var g1 = g
  while len(g1.pending_sam) > 0 {
    let b = g1.pending_sam[0]
    g1 = Gen { ..g1, pending_sam: list.drop(g1.pending_sam, 1) }
    g1 = gen_sam_bridge(g1, cw, b)
  }
  g1
}

## JVM entry wrapper: catch PanicError → stderr + exit 1 (spec §8.2).
fn gen_jvm_main(g: Gen, cw: AdtClassWriter) -> Unit !io = {
  let m = cw.method(ACC_PUBLIC + ACC_STATIC, "main", "([Ljava/lang/String;)V").expect("mv")
  m.visitCode()
  let try_start = Label.new()
  let try_end = Label.new()
  let handler = Label.new()
  m.visitTryCatchBlock(try_start, try_end, handler, PANIC_CLASS)
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitFieldInsn(OP_PUTSTATIC, g.class_name, ARGS_FIELD, "[Ljava/lang/String;")
  m.visitLabel(try_start)
  m.visitMethodInsn(OP_INVOKESTATIC, g.class_name, "main", "()V", false)
  m.visitLabel(try_end)
  m.visitInsn(OP_RETURN)
  m.visitLabel(handler)
  m.visitVarInsn(OP_ASTORE, 1)
  m.visitFieldInsn(OP_GETSTATIC, "java/lang/System", "err", "Ljava/io/PrintStream;")
  m.visitTypeInsn(OP_NEW, SB)
  m.visitInsn(OP_DUP)
  m.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  ldc_str(m, "panic: ")
  m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitMethodInsn(OP_INVOKEVIRTUAL, PANIC_CLASS, "getMessage", "()Ljava/lang/String;", false)
  m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/PrintStream", "println",
    "(Ljava/lang/String;)V", false)
  m.visitInsn(OP_ICONST_1)
  m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/System", "exit", "(I)V", false)
  m.visitInsn(OP_RETURN)
  m.visitMaxs(0, 0)
  m.visitEnd()
  ()
}

## The per-trait dictionary interface: one erased method per trait method.
pub fn gen_trait_interface(supers: List[String], adts: Adts, tr: TraitI) -> Bytes !io = {
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_ABSTRACT + ACC_INTERFACE, tr_iface(tr.owner, tr.name), obj())
  for entry in tr.methods {
    let (mn, ms) = entry
    let m = cw.method(ACC_PUBLIC + ACC_ABSTRACT, mn,
      method_desc(adts, ms.sig.param_tys, ms.sig.ret)).expect("mv")
    m.visitEnd()
  }
  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

## The return instruction for a value of declared type `t` on the stack.
##
## Asks `jvm_repr` for the same reason `emit_method_return` does: a chain of
## `t == Ty...` here drops through to void for anything it does not name, and
## an opaque type over Int is exactly such a thing.
fn emit_return_of(m: MethodVisitor, t: Ty) -> Unit !io = {
  match jvm_repr(t) {
    RLong -> { m.visitInsn(OP_LRETURN) }
    RDouble -> { m.visitInsn(OP_DRETURN) }
    RBool -> { m.visitInsn(OP_IRETURN) }
    RRef -> { m.visitInsn(OP_ARETURN) }
    RUnit | RBottom -> { m.visitInsn(OP_RETURN) }
  }
  ()
}

## One test block → one public static method dawn$test$i()V.
## A test block is a nullary Unit function, so it goes through the same Core
## path as any other body.
fn gen_test(g: Gen, cw: AdtClassWriter, t: TFun, idx: Int) -> Gen !io =
  gen_fn(g, cw, t, "dawn\$test\$" ++ to_string(idx), "()V")

## A throwaway MethodVisitor so Gen can be constructed before the first real
## method opens (the record field is non-optional by design).
fn scratch_mv() -> MethodVisitor !io = {
  let cw = AdtClassWriter.plain(0).expect("writer")
  AdtClassWriter.beginOn(cw, V17, ACC_PUBLIC, "dawn/tool/Scratch", obj())
  AdtClassWriter.methodOn(cw, ACC_PUBLIC + ACC_STATIC, "scratch", "()V").expect("mv")
}

## One checked module → its classes: ADTs, trait interfaces, impl
## Which of this ADT's equals/hashCode an `impl Eq`/`impl Hash` takes over.
## Only an explicit impl counts: without one the derived structural bodies are
## already the relation, so nothing changes and nothing is re-emitted.
fn eq_override(
  impl_table: Impls,
  class_name: String,
  subject: Ty
) -> EqOverride = {
  let owner_of = fn(tid: Int) => {
    let none: Option[String] = None
    match impl_at(impl_table, tid, subject) {
      Some(imp) ->
        if imp.derived { none } else { Some(owner_or_default(imp.owner, class_name)) }
      None -> none
    }
  }
  EqOverride { eq_owner: owner_of(EQ_ID), hash_owner: owner_of(HASH_ID) }
}

fn owner_or_default(o: Option[String], fallback: String) -> String =
  match o {
    Some(x) -> x
    None -> fallback
  }

## dictionaries and the class of statics.
##
## `impl_table` is still a parameter, but it no longer says anything about
## dictionaries: what survives is ADT class synthesis -- which of an ADT's
## equals/hashCode an explicit impl takes over, and whether its Ord was
## derived. Those are questions about a *class*, not about a witness, and
## Core does not carry them.
pub fn emit_module(
  supers: List[String],
  adts: Adts,
  traits: Traits,
  impl_table: Impls,
  prog_fns: Map[(String, String), Sig],
  own_fns: Map[String, Sig],
  class_name: String,
  own_trait_ids: List[Int],
  own_adt_ids: List[Int],
  tm: TModule,
  ct: CtOut,
  # this module's const-name → comptime value view, imported consts included
  # (their values live in the declaring module's CtOut)
  all_consts: Map[String, CValue],
  include_tests: Bool
) -> List[(String, Bytes)] !io = {
  var out: List[(String, Bytes)] = []
  for aid in own_adt_ids {
    out = out ++ gen_adt(supers, adts, adt_of(adts, aid),
      eq_override(impl_table, class_name, TyAdt(aid, adt_of(adts, aid).tparams)))
  }
  for tid in own_trait_ids {
    let tr = trait_of(traits, tid)
    out = out ++ [(tr_iface(tr.owner, tr.name), gen_trait_interface(supers, adts, tr))]
  }
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, class_name, obj())
  cw.field(ACC_PUBLIC + ACC_STATIC, ARGS_FIELD, "[Ljava/lang/String;")
  let no_slots: Map[Int, Int] = map.empty()
  let no_ckey: Map[String, String] = map.empty()
  var g = Gen {
    mv: scratch_mv(),
    class_name: class_name,
    adts: adts,
    traits: traits,
    impl_table: impl_table,
    own_fns: own_fns,
    prog_fns: prog_fns,
    lifted_descs: map.empty(),
    dicts: [],
    syms: tm.syms,
    slots: no_slots,
    next_slot: 0,
    method_ret: TyUnit,
    rets_null: false,
    cloops: [],
    lambda_ctr: 0,
    sam_ctr: 0,
    pending_sam: [],
    consts: all_consts,
    blocks: ct.blocks,
    const_fields: [],
    const_by_key: no_ckey
  }
  var has_main = false
  for f in tm.fns {
    match f.impl_of {
      Some(pair) -> {
        let (tid, subject) = pair
        let tr = trait_of(traits, tid)
        g = gen_fn(g, cw, f, impl_method_name(g, tr.name, subject, f.name),
          fn_desc_with_dicts(g, f.sig))
      }
      None ->
        match f.default_of {
          Some(tid) -> {
            let tr = trait_of(traits, tid)
            g = gen_fn(g, cw, f, default_method_name(tr.name, f.name),
              fn_desc_with_dicts(g, f.sig))
          }
          None -> {
            if f.name == "main" { has_main = true }
            g = gen_fn(g, cw, f, f.name, fn_desc_with_dicts(g, f.sig))
          }
        }
    }
    g = drain_lambdas(g, cw)
  }
  if include_tests {
    var ti = 0
    for t in tm.tests {
      g = gen_test(g, cw, t, ti)
      g = drain_lambdas(g, cw)
      ti = ti + 1
    }
  }
  if has_main { gen_jvm_main(g, cw) }
  gen_const_fields(g, cw)
  cw.visitEnd()
  # exactly the dictionaries this module's Core asked for. A bound that is
  # never forwarded builds none, which is why a program with no `[T: Eq]`
  # carries no Eq machinery -- the same property the old whole-program scan
  # in main.dawn was there to preserve, now a consequence rather than a rule.
  for dd in g.dicts {
    out = out ++ [gen_dict_class(g, supers, dd)]
  }
  out ++ [(class_name, cw.toByteArray().expect("bytes"))]
}

## One Core dictionary as a JVM singleton.
##
## Every slot has the same shape -- the trait method's own erased signature
## plus the dictionary -- whether lowering filled it with a bridge to an
## impl, a trait default, or a synthesised primitive. So this forwards, and
## knows nothing about which of the three it is.
fn gen_dict_class(g: Gen, supers: List[String], dd: CDictDef) -> (String, Bytes) !io = {
  let tr = trait_of(g.traits, dd.trait_id)
  let cls = dict_class(g.class_name, dd.key)
  let iface = tr_iface(tr.owner, tr.name)
  let cw = AdtClassWriter.new(supers)
  cw.beginWithInterface(V17, ACC_PUBLIC + ACC_FINAL, cls, obj(), iface)
  # A dictionary the compiler can build once is a singleton; one that is a
  # function of its arguments is an ordinary object with those arguments in
  # fields. Only the scaffold differs -- the forwarding below is the same
  # either way, because a slot reaches the arguments through the dictionary
  # it is already passed.
  if dd.nargs > 0 {
    parameterised_scaffold(cw, cls, dd.nargs)
  } else {
    singleton_scaffold(cw, cls, iface)
  }
  var i = 0
  for entry in tr.methods {
    let (mname, ms) = entry
    let m = cw.method(ACC_PUBLIC, mname,
      method_desc(g.adts, ms.sig.param_tys, ms.sig.ret)).expect("mv")
    m.visitCode()
    var slot = 1
    for declared in ms.sig.param_tys {
      load_slot(m, declared, slot)
      slot = slot + slots_of(declared)
    }
    # the dictionary itself is the trailing argument: a default body reaches
    # its siblings through it
    m.visitVarInsn(OP_ALOAD, 0)
    let (owner, target) = slot_target(tr, dd.slots[i])
    m.visitMethodInsn(OP_INVOKESTATIC, owner, target,
      sig_desc_with_dicts(g.adts, ms.sig), false)
    emit_return_of(m, ms.sig.ret)
    m.visitMaxs(0, 0)
    m.visitEnd()
    i = i + 1
  }
  cw.visitEnd()
  (cls, cw.toByteArray().expect("bytes"))
}

fn slot_target(tr: TraitI, s: CDictSlot) -> (String, String) =
  match s {
    CSlotFn(owner, name) -> (owner, name)
    CSlotDefault(owner, method) -> (owner, default_method_name(tr.name, method))
  }

fn sig_of_call(g: Gen, owner: String, name: String) -> Sig =
  match map.get(g.prog_fns, (owner, name)) {
    Some(s) -> s
    None -> panic("codegen: unknown fn `" ++ owner ++ "." ++ name ++ "`")
  }

## Bind a slot AND record its type. Lowering mints symbols of its own (match
## scrutinees, `?` temporaries, lifted parameters) which the checker never
## saw, so the Core path cannot look types up in the checker's table the way
## the TAST path does -- Core carries the type on the binder instead.
fn cbind(g: Gen, sym: Int, ty: Ty, slot: Int) -> Gen !io = {
  let g1 = Gen {
    ..g,
    syms: map.insert(g.syms, sym,
      Sym { name: "", ty: ty, mutable: true, dlo: 0, dhi: 0, dict_of: None })
  }
  bind_slot(g1, sym, slot)
}

fn cloop_of(g: Gen, id: Int) -> (Label, Label) = {
  var i = len(g.cloops) - 1
  while i >= 0 {
    let (lid, cont, brk) = g.cloops[i]
    if lid == id { return (cont, brk) }
    i = i - 1
  }
  panic("codegen: no enclosing loop " ++ to_string(id))
}

fn gen_cargs(g: Gen, args: List[CExpr]) -> Gen !io = {
  var g1 = g
  for a in args {
    let (g2, _) = gen_cexpr(g1, a, false)
    g1 = g2
  }
  g1
}

## Core has already boxed and unboxed everything, so an argument is emitted
## exactly as it stands -- no adapt_to at the call site.
fn gen_ccall(g: Gen, callee: CCallee, args: List[CExpr], ty: Ty) -> (Gen, Bool) !io =
  match callee {
    CDirect(owner, name) -> {
      let g1 = gen_cargs(g, args)
      # a body lowering hoisted has no declared signature; its descriptor was
      # recorded when the hoisted body was registered
      let d = match map.get(g1.lifted_descs, (owner, name)) {
        Some(x) -> x
        None -> fn_desc_with_dicts(g1, sig_of_call(g1, owner, name))
      }
      g1.mv.visitMethodInsn(OP_INVOKESTATIC, owner, name, d, false)
      (g1, true)
    }
    CImpl(owner, tid, subject, method) -> {
      let g1 = gen_cargs(g, args)
      let tr = trait_of(g1.traits, tid)
      let psig = subst_subject(tr, trait_method_sig(tr, method), subject)
      # A conditional impl's method takes a dictionary per bound. How many is
      # readable from Core alone -- the arguments beyond the trait method's
      # own are those dictionaries -- so this does not consult the impl table.
      var ptys = psig.param_tys
      for _d in 0 ..(len(args) - len(psig.param_tys)) {
        ptys = ptys ++ [TyVar("D", 0)]
      }
      g1.mv.visitMethodInsn(OP_INVOKESTATIC, owner,
        impl_method_name(g1, tr.name, subject, method),
        method_desc(g1.adts, ptys, psig.ret), false)
      (g1, true)
    }
    CDefault(owner, tid, method) -> {
      let g1 = gen_cargs(g, args)
      let tr = trait_of(g1.traits, tid)
      g1.mv.visitMethodInsn(OP_INVOKESTATIC, owner,
        default_method_name(tr.name, method),
        fn_desc_with_dicts(g1, trait_method_sig(tr, method)), false)
      (g1, true)
    }
    CMethod(dict, tid, method, _idx) -> {
      # the JVM's dictionaries are interfaces, so it dispatches by name and
      # ignores the slot index the table-based backend uses
      let tr = trait_of(g.traits, tid)
      let (g0, _) = gen_cexpr(g, dict, false)
      g0.mv.visitTypeInsn(OP_CHECKCAST, tr_iface(tr.owner, tr.name))
      let g1 = gen_cargs(g0, args)
      g1.mv.visitMethodInsn(OP_INVOKEINTERFACE, tr_iface(tr.owner, tr.name), method,
        trait_method_desc(g1, trait_method_sig(tr, method)), true)
      (g1, true)
    }
    CDynamic(target) -> {
      let (g1, falls) = gen_cexpr(g, target, false)
      if not falls { return (g1, false) }
      gen_cdynamic(g1, args, cex_ty(target), ty)
    }
  }

## Invoke a function value: erased apply, then unerase to the static type.
fn gen_cdynamic(g: Gen, args: List[CExpr], ft: Ty, ret_static: Ty) -> (Gen, Bool) !io = {
  let (fps, fret) = tyfn_parts(ft)
  var g1 = g
  var i = 0
  for a in args {
    let (g2, _) = gen_cexpr(g1, a, false)
    g1 = g2
    box_ty(g1.mv, if i < len(fps) { fps[i] } else { cex_ty(a) })
    i = i + 1
  }
  g1.mv.visitMethodInsn(OP_INVOKEINTERFACE, fn_iface(len(fps)), "apply",
    erased_apply_desc(len(fps)), true)
  if slots_of(fret) == 0 {
    g1.mv.visitInsn(OP_POP)
  } else {
    unerase(g1, fret)
  }
  (g1, true)
}

fn gen_cclosure(g: Gen, name: String, owner: String, caps: List[CExpr], ty: Ty) -> Gen !io = {
  var g1 = g
  var cap_tys: List[Ty] = []
  for c in caps {
    let (g2, _) = gen_cexpr(g1, c, false)
    g1 = g2
    cap_tys = cap_tys ++ [cex_ty(c)]
  }
  let (fps, fret) = tyfn_parts(ty)
  let impl_desc = impl_desc_of(g1, cap_tys ++ fps, fret)
  var caps_desc = ""
  for ct in cap_tys { caps_desc = caps_desc ++ desc_of(g1.adts, ct) }
  # lowering already hoisted the body to a top-level function, so this is
  # just an indy site over an existing static method -- there is no pending
  # lambda queue on this path
  g1.mv.visitInvokeDynamicInsn("apply",
    "(" ++ caps_desc ++ ")L" ++ fn_iface(len(fps)) ++ ";", lmf_bsm(),
    Type.getMethodType(erased_apply_desc(len(fps))).expect("mt"),
    Handle.new(OP_H_INVOKESTATIC, owner, name, impl_desc, false),
    instantiated_type(g1, fps, fret))
  g1
}

fn gen_cif(g: Gen, cond: CExpr, thn: CExpr, els: Option[CExpr], tail: Bool) -> (Gen, Bool) !io = {
  let else_l = Label.new()
  let end = Label.new()
  let (g1, _) = gen_cexpr(g, cond, false)
  g1.mv.visitJumpInsn(OP_IFEQ, else_l)
  let (g2, then_falls) = gen_cexpr(g1, thn, tail)
  match els {
    None -> {
      g2.mv.visitLabel(else_l)
      (g2, true)
    }
    Some(eb) -> {
      if then_falls { g2.mv.visitJumpInsn(OP_GOTO, end) }
      g2.mv.visitLabel(else_l)
      let (g3, else_falls) = gen_cexpr(g2, eb, tail)
      g3.mv.visitLabel(end)
      (g3, then_falls || else_falls)
    }
  }
}

pub fn gen_cexpr(g: Gen, e: CExpr, tail: Bool) -> (Gen, Bool) !io =
  match e {
    CInt(v) -> {
      ldc_long(g.mv, v)
      (g, true)
    }
    CFloat(v) -> {
      ldc_double(g.mv, v)
      (g, true)
    }
    CBool(v) -> {
      g.mv.visitInsn(if v { OP_ICONST_1 } else { OP_ICONST_0 })
      (g, true)
    }
    CStr(v) -> {
      ldc_str(g.mv, v)
      (g, true)
    }
    # Unit occupies no stack slot on the JVM; the C backend gives it a byte.
    # Each backend picks, which is why Core says nothing about width.
    CUnit -> (g, true)
    CLocal(sym, _) -> {
      load_var(g, sym)
      (g, true)
    }
    CBox(inner, from) -> {
      let (g1, falls) = gen_cexpr(g, inner, false)
      if falls { box_ty(g1.mv, from) }
      (g1, falls)
    }
    CUnbox(inner, to) -> {
      let (g1, falls) = gen_cexpr(g, inner, false)
      if falls {
        if slots_of(to) == 0 { g1.mv.visitInsn(OP_POP) } else { unerase(g1, to) }
      }
      (g1, falls)
    }
    CIf(cond, thn, els, _) -> gen_cif(g, cond, thn, els, tail)
    CBlock(stmts, tl, _) -> {
      var g1 = g
      for s in stmts {
        g1 = gen_cstmt(g1, s)
      }
      match tl {
        Some(t) -> gen_cexpr(g1, t, tail)
        None -> (g1, true)
      }
    }
    CReturn(vo) ->
      match vo {
        None -> {
          emit_method_return(g)
          (g, false)
        }
        Some(v) -> {
          let (g1, falls) = gen_cexpr(g, v, false)
          if falls { emit_method_return(g1) }
          (g1, false)
        }
      }
    CBreak(id) -> {
      let (_, brk) = cloop_of(g, id)
      g.mv.visitJumpInsn(OP_GOTO, brk)
      (g, false)
    }
    CContinue(id) -> {
      let (cont, _) = cloop_of(g, id)
      g.mv.visitJumpInsn(OP_GOTO, cont)
      (g, false)
    }
    CCall(callee, args, ty) -> gen_ccall(g, callee, args, ty)
    CClosure(name, owner, caps, ty) -> (gen_cclosure(g, name, owner, caps, ty), true)
    CDictRef(key, tid, _subject, _) -> {
      # The JVM's dictionary is a singleton implementing the trait interface
      # rather than a table of pointers, but *which* dictionary comes from
      # Core's key either way. Deriving it from the checker's impl_table
      # instead is what left CModule.dicts with one reader.
      let tr = trait_of(g.traits, tid)
      g.mv.visitFieldInsn(OP_GETSTATIC, dict_class(g.class_name, key),
        "INSTANCE", "L" ++ tr_iface(tr.owner, tr.name) ++ ";")
      (g, true)
    }
    CDictApply(key, args, _) -> {
      let cls = dict_class(g.class_name, key)
      g.mv.visitTypeInsn(OP_NEW, cls)
      g.mv.visitInsn(OP_DUP)
      var g1 = g
      for a in args {
        let (g2, _) = gen_cexpr(g1, a, false)
        g1 = g2
      }
      g1.mv.visitMethodInsn(OP_INVOKESPECIAL, cls, "<init>",
        dict_ctor_desc(len(args)), false)
      (g1, true)
    }
    CDictArg(dict, owner, key, idx, _) -> {
      let cls = dict_class(owner, key)
      let (g1, _) = gen_cexpr(g, dict, false)
      g1.mv.visitTypeInsn(OP_CHECKCAST, cls)
      g1.mv.visitFieldInsn(OP_GETFIELD, cls, dict_arg_field(idx), "Ljava/lang/Object;")
      (g1, true)
    }
    CConstRef(name, ty) -> {
      let v = match map.get(g.consts, name) {
        Some(cv) -> cv
        None -> panic("codegen: no comptime value for const `" ++ name ++ "`")
      }
      (gen_load_const(g, v, ty, "c:" ++ name), true)
    }
    CComptime(lo, hi, ty) -> {
      let v = match map.get(g.blocks, (lo, hi)) {
        Some(cv) -> cv
        None -> panic("codegen: no comptime value for block")
      }
      (gen_load_const(g, v, ty, "b:" ++ to_string(lo) ++ ":" ++ to_string(hi)), true)
    }
    CFnRef(_, name, _) -> panic("codegen: bare CFnRef survived lowering (" ++ name ++ ")")
    _ -> gen_cexpr2(g, e, tail)
  }

## The rest of the Core dispatch, split only to keep either half readable.
fn gen_cexpr2(g: Gen, e: CExpr, tail: Bool) -> (Gen, Bool) !io =
  match e {
    CBinary(op, l, r, ty) -> gen_cbinary(g, op, l, r, ty)
    CUnary(op, operand, ty) -> {
      let (g1, falls) = gen_cexpr(g, operand, false)
      if not falls { return (g1, false) }
      match op {
        CNeg -> if ty == TyFloat { g1.mv.visitInsn(OP_DNEG) } else { g1.mv.visitInsn(OP_LNEG) }
        CNot -> {
          g1.mv.visitInsn(OP_ICONST_1)
          g1.mv.visitInsn(OP_IXOR)
        }
        CBnot -> {
          ldc_long(g1.mv, 0 - 1)
          g1.mv.visitInsn(OP_LXOR)
        }
      }
      (g1, true)
    }
    CCtor(adt, ci, args, _) -> {
      let a = adt_of(g.adts, adt)
      let c = a.ctors[ci]
      let cls = ctor_jvm_name(g.adts, c)
      if len(c.fields) == 0 {
        g.mv.visitFieldInsn(OP_GETSTATIC, cls, "INSTANCE", "L" ++ cls ++ ";")
        return (g, true)
      }
      g.mv.visitTypeInsn(OP_NEW, cls)
      g.mv.visitInsn(OP_DUP)
      let g1 = gen_cargs(g, args)
      var desc = "("
      for f in c.fields { desc = desc ++ desc_of(g1.adts, f.ty) }
      g1.mv.visitMethodInsn(OP_INVOKESPECIAL, cls, "<init>", desc ++ ")V", false)
      (g1, true)
    }
    CField(target, adt, ci, idx, _) -> {
      let (g1, falls) = gen_cexpr(g, target, false)
      if not falls { return (g1, false) }
      let a = adt_of(g1.adts, adt)
      let c = a.ctors[ci]
      let cls = ctor_jvm_name(g1.adts, c)
      g1.mv.visitTypeInsn(OP_CHECKCAST, cls)
      g1.mv.visitFieldInsn(OP_GETFIELD, cls, c.fields[idx].name,
        desc_of(g1.adts, c.fields[idx].ty))
      (g1, true)
    }
    CIsCtor(target, adt, ci) -> {
      let (g1, falls) = gen_cexpr(g, target, false)
      if not falls { return (g1, false) }
      let a = adt_of(g1.adts, adt)
      let c = a.ctors[ci]
      let cls = ctor_jvm_name(g1.adts, c)
      if len(c.fields) == 0 {
        # no-payload constructors are interned singletons, so identity is
        # the discriminant -- the C backend compares a tag instead
        let t_l = Label.new()
        let end = Label.new()
        g1.mv.visitFieldInsn(OP_GETSTATIC, cls, "INSTANCE", "L" ++ cls ++ ";")
        g1.mv.visitJumpInsn(OP_IF_ACMPEQ, t_l)
        g1.mv.visitInsn(OP_ICONST_0)
        g1.mv.visitJumpInsn(OP_GOTO, end)
        g1.mv.visitLabel(t_l)
        g1.mv.visitInsn(OP_ICONST_1)
        g1.mv.visitLabel(end)
      } else {
        g1.mv.visitTypeInsn(OP_INSTANCEOF, cls)
      }
      (g1, true)
    }
    # No tag field to read: an ADT's constructors are separate classes, so
    # "which one" is a chain of instanceof tests -- the same chain the derived
    # comparison used to build for itself before Core carried the node.
    CTagOf(target, adt) -> {
      let (g1, falls) = gen_cexpr(g, target, false)
      if not falls { return (g1, false) }
      let a = adt_of(g1.adts, adt)
      let done = Label.new()
      var idx = 0
      for c in a.ctors {
        let next = Label.new()
        g1.mv.visitInsn(OP_DUP)
        g1.mv.visitTypeInsn(OP_INSTANCEOF, ctor_jvm_name(g1.adts, c))
        g1.mv.visitJumpInsn(OP_IFEQ, next)
        g1.mv.visitInsn(OP_POP)
        ldc_long(g1.mv, idx)
        g1.mv.visitJumpInsn(OP_GOTO, done)
        g1.mv.visitLabel(next)
        idx = idx + 1
      }
      g1.mv.visitInsn(OP_POP)
      ldc_long(g1.mv, 0 - 1)
      g1.mv.visitLabel(done)
      (g1, true)
    }
    CTuple(elems, _) -> {
      let cls = tuple_class(len(elems))
      g.mv.visitTypeInsn(OP_NEW, cls)
      g.mv.visitInsn(OP_DUP)
      var g1 = g
      for el in elems {
        let (g2, _) = gen_cexpr(g1, el, false)
        g1 = g2
        box_ty(g1.mv, cex_ty(el))
      }
      var desc = "("
      var i = 0
      while i < len(elems) {
        desc = desc ++ obj_desc()
        i = i + 1
      }
      g1.mv.visitMethodInsn(OP_INVOKESPECIAL, cls, "<init>", desc ++ ")V", false)
      (g1, true)
    }
    CTupleGet(target, idx, ty) -> {
      let (g1, falls) = gen_cexpr(g, target, false)
      if not falls { return (g1, false) }
      let cls = tuple_class(tuple_arity(cex_ty(target)))
      g1.mv.visitTypeInsn(OP_CHECKCAST, cls)
      g1.mv.visitFieldInsn(OP_GETFIELD, cls, "_" ++ to_string(idx), obj_desc())
      if slots_of(ty) == 0 { g1.mv.visitInsn(OP_POP) } else { unerase(g1, ty) }
      (g1, true)
    }
    CListLit(elems, _) -> {
      g.mv.visitTypeInsn(OP_NEW, ARRAYLIST)
      g.mv.visitInsn(OP_DUP)
      g.mv.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "()V", false)
      var g1 = g
      for el in elems {
        g1.mv.visitInsn(OP_DUP)
        let (g2, falls) = gen_cexpr(g1, el, false)
        g1 = g2
        if not falls { return (g1, false) }
        g1.mv.visitMethodInsn(OP_INVOKEVIRTUAL, ARRAYLIST, "add",
          "(Ljava/lang/Object;)Z", false)
        g1.mv.visitInsn(OP_POP)
      }
      (g1, true)
    }
    CIntrinsic(name, args, ty) -> gen_cintrinsic(g, name, args, ty)
    CForeign(call, ty) -> gen_cforeign(g, call, ty)
    _ -> panic("codegen: Core node not handled on the JVM path")
  }

fn obj_desc() -> String = "Ljava/lang/Object;"

fn tuple_arity(t: Ty) -> Int =
  match t {
    TyTuple(es) -> len(es)
    _ -> panic("codegen: tuple projection on a non-tuple")
  }

fn gen_cbinary(g: Gen, op: CBinOp, l: CExpr, r: CExpr, ty: Ty) -> (Gen, Bool) !io = {
  # short-circuit first: the right side must not be evaluated eagerly.
  # `<` on a non-scalar never reaches here -- lowering turned it into an
  # explicit Ord.cmp call, so there is no witness on a comparison node.
  if op == CAnd {
    let short = Label.new()
    let end = Label.new()
    let (g1, _) = gen_cexpr(g, l, false)
    g1.mv.visitJumpInsn(OP_IFEQ, short)
    let (g2, _) = gen_cexpr(g1, r, false)
    g2.mv.visitJumpInsn(OP_GOTO, end)
    g2.mv.visitLabel(short)
    g2.mv.visitInsn(OP_ICONST_0)
    g2.mv.visitLabel(end)
    return (g2, true)
  }
  if op == COr {
    let short = Label.new()
    let end = Label.new()
    let (g1, _) = gen_cexpr(g, l, false)
    g1.mv.visitJumpInsn(OP_IFNE, short)
    let (g2, _) = gen_cexpr(g1, r, false)
    g2.mv.visitJumpInsn(OP_GOTO, end)
    g2.mv.visitLabel(short)
    g2.mv.visitInsn(OP_ICONST_1)
    g2.mv.visitLabel(end)
    return (g2, true)
  }
  let (ga, _) = gen_cexpr(g, l, false)
  let (gb, _) = gen_cexpr(ga, r, false)
  var g1 = gb
  let t = cex_ty(l)
  match op {
    CAdd -> { g1.mv.visitInsn(if t == TyInt { OP_LADD } else { OP_DADD }) }
    CSub -> { g1.mv.visitInsn(if t == TyInt { OP_LSUB } else { OP_DSUB }) }
    CMul -> { g1.mv.visitInsn(if t == TyInt { OP_LMUL } else { OP_DMUL }) }
    CDiv ->
      if t == TyInt {
        emit_div_zero_check(g1, "division")
        g1.mv.visitInsn(OP_LDIV)
      } else {
        g1.mv.visitInsn(OP_DDIV)
      }
    CMod ->
      if t == TyInt {
        emit_div_zero_check(g1, "modulo")
        g1.mv.visitInsn(OP_LREM)
      } else {
        g1.mv.visitInsn(OP_DREM)
      }
    CConcat ->
      match t {
        TyList(_) -> {
          g1.mv.visitMethodInsn(OP_INVOKESTATIC, LISTS_CLASS, "concat",
            "(Ljava/util/List;Ljava/util/List;)Ljava/util/List;", false)
        }
        TyBytes -> {
          g1.mv.visitMethodInsn(OP_INVOKESTATIC, BYTES_CLASS, "concat", "([B[B)[B", false)
        }
        # String is the only other thing `++` joins. Spelled as a wildcard
        # rather than `TyString ->` since S0.3, and worth naming when the
        # TyList arm goes away in S3: whatever replaces it must not fall
        # through to here
        _ -> {
          g1.mv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/String", "concat",
            "(Ljava/lang/String;)Ljava/lang/String;", false)
        }
      }
    CEq -> { gen_equality(g1, t, BEq) }
    CNe -> { gen_equality(g1, t, BNeq) }
    CLt -> { gen_ordering(g1, t, BLt) }
    CLe -> { gen_ordering(g1, t, BLe) }
    CGt -> { gen_ordering(g1, t, BGt) }
    CGe -> { gen_ordering(g1, t, BGe) }
    CBand -> { g1.mv.visitInsn(OP_LAND) }
    CBor -> { g1.mv.visitInsn(OP_LOR) }
    CBxor -> { g1.mv.visitInsn(OP_LXOR) }
    CShl -> {
      g1.mv.visitInsn(OP_L2I)
      g1.mv.visitInsn(OP_LSHL)
    }
    CShr -> {
      g1.mv.visitInsn(OP_L2I)
      g1.mv.visitInsn(OP_LSHR)
    }
    CUshr -> {
      g1.mv.visitInsn(OP_L2I)
      g1.mv.visitInsn(OP_LUSHR)
    }
    _ -> ()
  }
  (g1, true)
}

fn gen_cstmt(g: Gen, s: CStmt) -> Gen !io =
  match s {
    CSLet(sym, ty, init) -> {
      let (g1, falls) = gen_cexpr(g, init, false)
      if not falls { return g1 }
      let (g2, slot) = alloc(g1, slots_of(ty))
      store_slot(g2.mv, ty, slot)
      cbind(g2, sym, ty, slot)
    }
    CSAssign(sym, value) -> {
      let (g1, falls) = gen_cexpr(g, value, false)
      if falls { store_var(g1, sym) }
      g1
    }
    # the node that exists because a dropped value is not a dropped effect
    CSDiscard(e) -> {
      let (g1, falls) = gen_cexpr(g, e, false)
      if falls { pop_value(g1, cex_ty(e)) }
      g1
    }
    CSIf(cond, thn, els) -> {
      let (g1, _) = gen_cif(g, cond, thn, els, false)
      g1
    }
    CSLoop(id, body, step) -> {
      let top = Label.new()
      let cont = Label.new()
      let brk = Label.new()
      g.mv.visitLabel(top)
      var g1 = Gen { ..g, cloops: g.cloops ++ [(id, cont, brk)] }
      let (g2, _) = gen_cexpr(g1, body, false)
      g1 = g2
      # the continue target is the step, so `continue` runs it -- the whole
      # reason CSLoop carries one
      g1.mv.visitLabel(cont)
      match step {
        Some(sv) -> {
          let (g3, falls) = gen_cexpr(g1, sv, false)
          g1 = g3
          if falls { pop_value(g1, cex_ty(sv)) }
        }
        None -> ()
      }
      g1.mv.visitJumpInsn(OP_GOTO, top)
      g1.mv.visitLabel(brk)
      Gen { ..g1, cloops: list.take(g1.cloops, len(g1.cloops) - 1) }
    }
    # reference counting: Perceus emits these, the JVM has a collector
    CSDup(_) -> g
    CSDrop(_) -> g
  }

## Core intrinsics. The names are Core's own vocabulary, which is why some
## do not match any TAST builtin: lowering invented `str_of_int`,
## `list_index` and friends when it destroyed interpolation and indexing.
fn gen_cintrinsic(g: Gen, name: String, args: List[CExpr], ty: Ty) -> (Gen, Bool) !io = {
  if name == "panic" {
    g.mv.visitTypeInsn(OP_NEW, PANIC_CLASS)
    g.mv.visitInsn(OP_DUP)
    let (g1, _) = gen_cexpr(g, args[0], false)
    g1.mv.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>",
      "(Ljava/lang/String;)V", false)
    g1.mv.visitInsn(OP_ATHROW)
    return (g1, false)
  }
  if name == "todo" {
    g.mv.visitTypeInsn(OP_NEW, PANIC_CLASS)
    g.mv.visitInsn(OP_DUP)
    ldc_str(g.mv, "not yet implemented")
    g.mv.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>",
      "(Ljava/lang/String;)V", false)
    g.mv.visitInsn(OP_ATHROW)
    return (g, false)
  }
  if name == "null_ref" {
    g.mv.visitInsn(OP_ACONST_NULL)
    return (g, true)
  }
  if name == "struct_eq" {
    # Structural equality of two values whose type is not ground, so lowering
    # could not spell the comparison out (semantics-closure-design.md 3).
    # This is a *contract*, not a free choice: it has to answer exactly what
    # the synthesised comparison answers for the same values, or `x == y` and
    # `map.get(m, x)` stop agreeing. On the JVM the implementation is the
    # generated `equals`, reached virtually -- the same walk, dispatched at
    # runtime because the static type does not say which one.
    let g1 = gen_cargs(g, args)
    g1.mv.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "equals", "(Ljava/lang/Object;)Z", false)
    return (g1, true)
  }
  if name == "hash" {
    # the prelude Hash over a scalar; the JVM's own hash for that type, widened
    # because Dawn's Int is a long
    let at = cex_ty(args[0])
    let g1 = gen_cargs(g, args)
    hash_of(g1.mv, at)
    g1.mv.visitInsn(OP_I2L)
    return (g1, true)
  }
  if name == "cmp" {
    # the prelude Ord over a scalar, the other half of the same contract
    let at = cex_ty(args[0])
    let g1 = gen_cargs(g, args)
    emit_scalar_cmp(g1, at)
    return (g1, true)
  }
  if name == "args" {
    g.mv.visitFieldInsn(OP_GETSTATIC, g.class_name, ARGS_FIELD, "[Ljava/lang/String;")
    g.mv.visitMethodInsn(OP_INVOKESTATIC, LISTS_CLASS, "fromArray",
      "([Ljava/lang/String;)Ljava/util/List;", false)
    return (g, true)
  }
  if name == "expect" {
    var g1 = gen_cargs(g, args)
    let (ga, msg_slot) = alloc(g1, 1)
    g1 = ga
    g1.mv.visitVarInsn(OP_ASTORE, msg_slot)
    g1.mv.visitInsn(OP_DUP)
    g1.mv.visitTypeInsn(OP_INSTANCEOF, "Option\$Some")
    let ok = Label.new()
    g1.mv.visitJumpInsn(OP_IFNE, ok)
    g1.mv.visitTypeInsn(OP_NEW, PANIC_CLASS)
    g1.mv.visitInsn(OP_DUP)
    g1.mv.visitVarInsn(OP_ALOAD, msg_slot)
    g1.mv.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>",
      "(Ljava/lang/String;)V", false)
    g1.mv.visitInsn(OP_ATHROW)
    g1.mv.visitLabel(ok)
    g1.mv.visitTypeInsn(OP_CHECKCAST, "Option\$Some")
    g1.mv.visitFieldInsn(OP_GETFIELD, "Option\$Some", "value", "Ljava/lang/Object;")
    if slots_of(ty) == 0 { g1.mv.visitInsn(OP_POP) } else { unerase(g1, ty) }
    return (g1, true)
  }
  if name == "unwrap_or" {
    var g1 = gen_cargs(g, args)
    let (ga, fb_slot) = alloc(g1, slots_of(ty))
    g1 = ga
    store_slot(g1.mv, ty, fb_slot)
    g1.mv.visitInsn(OP_DUP)
    g1.mv.visitTypeInsn(OP_INSTANCEOF, "Option\$Some")
    let some_l = Label.new()
    let end = Label.new()
    g1.mv.visitJumpInsn(OP_IFNE, some_l)
    g1.mv.visitInsn(OP_POP)
    load_slot(g1.mv, ty, fb_slot)
    g1.mv.visitJumpInsn(OP_GOTO, end)
    g1.mv.visitLabel(some_l)
    g1.mv.visitTypeInsn(OP_CHECKCAST, "Option\$Some")
    g1.mv.visitFieldInsn(OP_GETFIELD, "Option\$Some", "value", "Ljava/lang/Object;")
    unerase(g1, ty)
    g1.mv.visitLabel(end)
    return (g1, true)
  }
  if name == "cursor_slice" {
    let g1 = gen_cargs(g, args)
    g1.mv.visitMethodInsn(OP_INVOKESTATIC, STRINGS_CLASS, "cursorSlice",
      "(Ljava/lang/String;JJ)Ljava/lang/String;", false)
    let ok = Label.new()
    g1.mv.visitInsn(OP_DUP)
    g1.mv.visitJumpInsn(OP_IFNONNULL, ok)
    g1.mv.visitTypeInsn(OP_NEW, PANIC_CLASS)
    g1.mv.visitInsn(OP_DUP)
    ldc_str(g1.mv, "cursor_slice: invalid cursor range")
    g1.mv.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>",
      "(Ljava/lang/String;)V", false)
    g1.mv.visitInsn(OP_ATHROW)
    g1.mv.visitLabel(ok)
    return (g1, true)
  }
  if name == "to_string" {
    let g1 = gen_cargs(g, args)
    let at = cex_ty(args[0])
    if at == TyInt {
      g1.mv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/String", "valueOf",
        "(J)Ljava/lang/String;", false)
    } else if at == TyFloat {
      g1.mv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/String", "valueOf",
        "(D)Ljava/lang/String;", false)
    } else if at == TyBool {
      g1.mv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/String", "valueOf",
        "(Z)Ljava/lang/String;", false)
    } else if at == TyString {
      ()
    } else {
      box_ty(g1.mv, at)
      g1.mv.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "show",
        "(Ljava/lang/Object;)Ljava/lang/String;", false)
    }
    return (g1, true)
  }
  let g1 = gen_cargs(g, args)
  if name == "to_float" {
    g1.mv.visitInsn(OP_L2D)
  } else if name == "to_int" {
    g1.mv.visitInsn(OP_D2L)
  } else if name == "len" {
    g1.mv.visitMethodInsn(OP_INVOKEINTERFACE, "java/util/List", "size", "()I", true)
    g1.mv.visitInsn(OP_I2L)
  } else if name == "str_of_int" {
    g1.mv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/String", "valueOf",
      "(J)Ljava/lang/String;", false)
  } else if name == "str_of_float" {
    g1.mv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/String", "valueOf",
      "(D)Ljava/lang/String;", false)
  } else if name == "str_of_bool" {
    g1.mv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/String", "valueOf",
      "(Z)Ljava/lang/String;", false)
  } else if name == "show" {
    g1.mv.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "show",
      "(Ljava/lang/Object;)Ljava/lang/String;", false)
  } else if name == "quote" {
    g1.mv.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "quote",
      "(Ljava/lang/String;)Ljava/lang/String;", false)
  } else if name == "list_index" {
    g1.mv.visitMethodInsn(OP_INVOKESTATIC, LISTS_CLASS, "index",
      "(Ljava/util/List;J)Ljava/lang/Object;", false)
  } else if name == "map_index" {
    g1.mv.visitMethodInsn(OP_INVOKESTATIC, MAPS_CLASS, "index",
      "(Ljava/util/Map;Ljava/lang/Object;)Ljava/lang/Object;", false)
  } else if name == "list_slice" {
    g1.mv.visitInsn(OP_L2I)
    let (ga, hi_slot) = alloc(g1, 1)
    ga.mv.visitVarInsn(OP_ISTORE, hi_slot)
    ga.mv.visitInsn(OP_L2I)
    ga.mv.visitVarInsn(OP_ILOAD, hi_slot)
    ga.mv.visitMethodInsn(OP_INVOKESTATIC, LISTS_CLASS, "slice",
      "(Ljava/util/List;II)Ljava/util/List;", false)
    return (ga, true)
  } else if name == "starts_with" || name == "ends_with" {
    g1.mv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/String",
      if name == "starts_with" { "startsWith" } else { "endsWith" },
      "(Ljava/lang/String;)Z", false)
  } else if name == "cast" {
    unerase(g1, ty)
  } else {
    match rt_intrinsic_target(name) {
      Some(pair) -> {
        let (cls, m) = pair
        let sig = builtin_sig(name)
        g1.mv.visitMethodInsn(OP_INVOKESTATIC, cls, m,
          method_desc(g1.adts, sig.param_tys, sig.ret), false)
      }
      None -> panic("codegen: Core intrinsic without a JVM mapping: " ++ name)
    }
  }
  (g1, true)
}

fn builtin_sig(name: String) -> Sig =
  match map.get(builtins(), name) {
    Some(s) -> s
    None -> panic("codegen: no signature for intrinsic " ++ name)
  }

## The JVM-only node (core.CJava). A `use java` site dispatches three ways --
## a static field read, a constructor, or a method invoke. The native backend
## refuses this node instead.
fn gen_cforeign(g: Gen, jc: CJava, ty: Ty) -> (Gen, Bool) !io =
  if jc.call.is_field {
    gen_java_field(g, jc.call)
  } else if jc.call.is_ctor {
    gen_java_new(g, jc)
  } else {
    gen_java_call(g, jc, ty)
  }

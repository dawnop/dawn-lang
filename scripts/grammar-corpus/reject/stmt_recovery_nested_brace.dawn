# expect: expected `,` or `)`, found `2`
# Statement recovery counts brackets from the start of the broken statement
# (#190), the way match-arm recovery does. The first failure sits inside a
# record literal's braces and the second inside a call inside a multi-line
# list; resuming at the first `}` or newline after either would end the block
# early or re-enter the list. Each is skipped whole, the third statement's own
# error is still reported, and nothing lands at module top level.
fn f() -> Unit = {
  let p = P { x: 1, y: = }
  let q = [
    g(=),
  ]
  h(1 2)
}

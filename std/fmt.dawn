    606 -> (5357543035931336604, 6844897235344094635)
    607 -> (8572068857490138567, 5417812354437685931)
    608 -> (6857655085992110854, 644901068808238421)
    609 -> (5486124068793688683, 2360595262417545899)
    610 -> (8777798510069901893, 1932278012497118276)
    611 -> (7022238808055921514, 5235171224739604944)
    612 -> (5617791046444737211, 6032811387162639117)
    613 -> (8988465674311579538, 5963149404718312264)
    614 -> (7190772539449263630, 8459868338516560134)
    615 -> (5752618031559410904, 6767894670813248108)
    616 -> (9204188850495057447, 5294608251188331487)
    _ -> panic("fmt: 10^k out of range")
  }
# ---- Schubfach ----

## Round-odd product: floor(g * cp / 2^127) with the low bit forced on when
## any discarded bit was. `g = g1 * 2^63 + g0` is the 126-bit significand from
## g_pair; `cp` stays under 2^61.
fn rop(g1: Int, g0: Int, cp: Int) -> Int = {
  let x1 = umulh(g0, cp)
  let y0 = g1 * cp
  let y1 = umulh(g1, cp)
  let z = (y0 >>> 1) + x1
  let vbp = y1 + (z >>> 63)
  # the mask is 2^63 - 1: adding it pushes any nonzero low bits past bit 63
  vbp | (((z & 9223372036854775807) + 9223372036854775807) >>> 63)
}

fn digits_len(f: Int) -> Int = {
  var n = 1
  while n < 18 && f >= pow10(n) {
    n = n + 1
  }
  n
}

## Format the shortest digits `f` with `0.f * 10^e` as the value: plain
## decimal inside 10^-3 <= |v| < 10^7, computerized scientific notation
## outside (spec §4.3). Trailing zeros go, but a fraction keeps one digit.
fn to_chars(f0: Int, e0: Int) -> String = {
  let n0 = digits_len(f0)
  let f = f0 * pow10(17 - n0)
  let e = e0 + n0
  var ds = str.pad_start(to_string(f), 17, "0")
  var n = 17
  while n > 1 && str.slice(ds, n - 1, n) == "0" {
    n = n - 1
  }
  ds = str.take(ds, n)
  if e > 0 && e <= 7 {
    if n <= e {
      ds ++ str.repeat("0", e - n) ++ ".0"
    } else {
      str.take(ds, e) ++ "." ++ str.slice(ds, e, n)
    }
  } else if e > -3 && e <= 0 {
    "0." ++ str.repeat("0", -e) ++ ds
  } else {
    let head = str.take(ds, 1)
    let frac = if n > 1 { str.slice(ds, 1, n) } else { "0" }
    head ++ "." ++ frac ++ "E" ++ to_string(e - 1)
  }
}

## The Schubfach core over `v = c * 2^q`: pick the shortest decimal in the
## rounding interval, then the closest one (ties to even digits). A straight
## port of the algorithm's figure-7 skeleton; `dk` is the decimal-exponent
## debt the tiny-subnormal caller (`c` premultiplied by 10) hands in.
fn to_decimal(q: Int, c: Int, dk: Int) -> String = {
  let out = c & 1
  let cb = c << 2
  let cbr = cb + 2
  var cbl = 0
  var k = 0
  if c != 4503599627370496 || q == -1074 {
    # regular spacing: both neighbors half an ulp away
    cbl = cb - 2
    k = flog10pow2(q)
  } else {
    # the power of two just above a binade edge: the lower neighbor is closer
    cbl = cb - 1
    k = flog10_three_quarters_pow2(q)
  }
  let h = q + flog2pow10(-k) + 2
  let (g1, g0) = g_pair(k + 324)
  let vb = rop(g1, g0, cb << h)
  let vbl = rop(g1, g0, cbl << h)
  let vbr = rop(g1, g0, cbr << h)
  let s = vb >> 2
  if s >= 100 {
    # is a 10-multiple (one digit shorter) already inside the interval?
    let sp10 = 10 * (s / 10)
    let tp10 = sp10 + 10
    let upin = (vbl + out) <= (sp10 << 2)
    let wpin = ((tp10 << 2) + out) <= vbr
    if upin != wpin {
      return to_chars(if upin { sp10 } else { tp10 }, k)
    }
  }
  let t = s + 1
  let uin = (vbl + out) <= (s << 2)
  let win = ((t << 2) + out) <= vbr
  if uin != win {
    return to_chars(if uin { s } else { t }, k + dk)
  }
  let cmp = vb - ((s + t) << 1)
  to_chars(if cmp < 0 || (cmp == 0 && (s & 1) == 0) { s } else { t }, k + dk)
}

## `to_string(Float)`: the shortest decimal string that reads back as exactly
## `v`, in the two forms and three special spellings spec §4.3 fixes. This is
## what both backends and comptime folding call; user code goes through
## `to_string` and interpolation rather than calling it directly.
pub fn dtoa(v: Float) -> String = {
  if v != v {
    return "NaN"
  }
  let neg = v < 0.0 || (v == 0.0 && 1.0 / v < 0.0)
  let sign = if neg { "-" } else { "" }
  if v == 0.0 {
    return sign ++ "0.0"
  }
  let a = if neg { -v } else { v }
  # only an infinity survives `a - a != 0` with the NaN case gone
  if a - a != 0.0 {
    return sign ++ "Infinity"
  }
  # Decompose a = c * 2^q with c integral, q >= -1074, and c in [2^52, 2^53)
  # unless q is pinned at -1074 (subnormals, and the smallest normals). Done
  # by exact scaling instead of a bit cast: Dawn has no Float bit intrinsic,
  # and none is needed — multiplying or dividing by a power of two is exact
  # whenever the result is representable, and every intermediate here is
  # (scaling up from below 2^52 cannot overflow; scaling down stops at 2^52).
  let p52 = to_float(4503599627370496)
  let p53 = p52 + p52
  var p512 = 2.0
  var j = 0
  while j < 9 {
    p512 = p512 * p512
    j = j + 1
  }
  let tiny = p52 / p512
  var m = a
  var q = 0
  while m >= p512 {
    m = m / p512
    q = q + 512
  }
  while m >= p53 {
    m = m / 2.0
    q = q + 1
  }
  while m < tiny && q >= -562 {
    m = m * p512
    q = q - 512
  }
  while m < p52 && q > -1074 {
    m = m * 2.0
    q = q - 1
  }
  let c = to_int(m)
  if c >= 4503599627370496 {
    # normal: integers with an exact short form skip the interval machinery
    let mq = -q
    if mq > 0 && mq < 53 {
      let f = c >> mq
      if (f << mq) == c {
        return sign ++ to_chars(f, 0)
      }
    }
    return sign ++ to_decimal(q, c, 0)
  }
  # subnormal: c < 3 has too few bits for the interval arithmetic, so run it
  # on 10c and repay the borrowed decimal digit through dk
  if c < 3 {
    return sign ++ to_decimal(q, 10 * c, -1)
  }
  sign ++ to_decimal(q, c, 0)
}

# ---- parsing (spec §11's EBNF, scanned here, never by a host grammar) ----

fn is_ascii_digit(c: Int) -> Bool = c >= '0' && c <= '9'

## Digit value for radix parsing: ASCII `0-9a-zA-Z` and nothing else — no
## Unicode digits, no full-width forms (spec §11). -1 for a non-digit.
fn digit_val(c: Int) -> Int =
  if c >= '0' && c <= '9' {
    c - '0'
  } else if c >= 'a' && c <= 'z' {
    c - 'a' + 10
  } else if c >= 'A' && c <= 'Z' {
    c - 'A' + 10
  } else {
    -1
  }

## `parse_int(s)`: optional sign, then ASCII decimal digits, nothing else
## (spec §11) — trimmed by Dawn's own space table first. Out-of-range is
## `None`, not a wrap.
##
## Not `pub`, since v0.55.0: the builtin is the spelling, this is where it
## lands. `fmt.atoi` was a second name for one concept (CONTRIBUTING §naming),
## and the one nobody should have been writing — the module exists because the
## implementation is ordinary Dawn source, not because it is an API (spec
## §10.6). `lower.parser_impl` is the only thing that names these three now.
fn atoi(s: String) -> Option[Int] = atoi_radix(s, 10)

## `parse_int_radix(s, radix)`: the same EBNF with the digit set widened to
## `0-9a-zA-Z` cut off at `radix` (2..36; anything else is `None`).
## Accumulates negated so that Int's minimum, whose magnitude has no positive
## Int, still parses.
fn atoi_radix(s: String, radix: Int) -> Option[Int] = {
  if radix < 2 || radix > 36 {
    return None
  }
  let t = str.trim(s)
  var cur = cursor.start(t)
  if cursor.done(t, cur) {
    return None
  }
  var neg = false
  let c0 = cursor.char(t, cur)
  if c0 == '+' || c0 == '-' {
    neg = c0 == '-'
    cur = cursor.next(t, cur)
  }
  if cursor.done(t, cur) {
    return None
  }
  let limit = if neg { -9223372036854775807 - 1 } else { -9223372036854775807 }
  let multmin = limit / radix
  var acc = 0
  while not cursor.done(t, cur) {
    let d = digit_val(cursor.char(t, cur))
    if d < 0 || d >= radix {
      return None
    }
    if acc < multmin {
      return None
    }
    acc = acc * radix
    if acc < limit + d {
      return None
    }
    acc = acc - d
    cur = cursor.next(t, cur)
  }
  Some(if neg { acc } else { -acc })
}

## Does trimmed text match spec §11's float shape? sign? (digits ["." digits?]
## | "." digits) ([eE] sign? digits)? — no suffixes, no hex floats, no
## underscores. The special spellings are handled before this is asked.
fn float_shape(t: String) -> Bool = {
  var cur = cursor.start(t)
  if cursor.done(t, cur) {
    return false
  }
  let c0 = cursor.char(t, cur)
  if c0 == '+' || c0 == '-' {
    cur = cursor.next(t, cur)
  }
  var ipart = 0
  while not cursor.done(t, cur) && is_ascii_digit(cursor.char(t, cur)) {
    ipart = ipart + 1
    cur = cursor.next(t, cur)
  }
  var fpart = 0
  if not cursor.done(t, cur) && cursor.char(t, cur) == '.' {
    cur = cursor.next(t, cur)
    while not cursor.done(t, cur) && is_ascii_digit(cursor.char(t, cur)) {
      fpart = fpart + 1
      cur = cursor.next(t, cur)
    }
  }
  # a mantissa needs at least one digit somewhere; "1." has one, "." has none
  if ipart == 0 && fpart == 0 {
    return false
  }
  if not cursor.done(t, cur) {
    let ce = cursor.char(t, cur)
    if ce != 'e' && ce != 'E' {
      return false
    }
    cur = cursor.next(t, cur)
    if not cursor.done(t, cur) {
      let cs = cursor.char(t, cur)
      if cs == '+' || cs == '-' {
        cur = cursor.next(t, cur)
      }
    }
    var epart = 0
    while not cursor.done(t, cur) && is_ascii_digit(cursor.char(t, cur)) {
      epart = epart + 1
      cur = cursor.next(t, cur)
    }
    if epart == 0 {
      return false
    }
  }
  cursor.done(t, cur)
}

## `parse_float(s)`: the EBNF above, or exactly the three spellings `dtoa`
## can emit — `Infinity`, `-Infinity`, `NaN` (no `+Infinity`, no signed NaN,
## no lowercase variants), so parse(to_string(x)) always closes.
##
## A validated string is handed to the backend's `parse_float` primitive for
## the decimal-to-binary conversion only. That delegation cannot reintroduce
## host grammar skew: on this subset both hosts implement the same function —
## IEEE 754 round-to-nearest-even of a decimal literal, which the Java spec
## requires of `Double.parseDouble` and C's `strtod` implements on every
## hosted platform this backend targets. Every input the two hosts ever
## disagreed on (hex floats, `1.5f`, `inf`, Unicode digits) is refused here
## before either host can see it.
fn atod(s: String) -> Option[Float] = {
  let t = str.trim(s)
  if t == "Infinity" {
    return Some(1.0 / 0.0)
  }
  if t == "-Infinity" {
    return Some(-1.0 / 0.0)
  }
  if t == "NaN" {
    return Some(0.0 / 0.0)
  }
  if not float_shape(t) {
    return None
  }
  parse_float(t)
}

# The three parsers below had no test of their own. `dtoa` is pinned byte for
# byte by scripts/dtoa-contract, which is why nothing here re-renders floats;
# the direction that reads text was checked only by whatever happened to call
# it, and what it *refuses* was checked by nothing at all. Refusal is most of
# the promise: spec §11 fixes an accepted language precisely so a host parser's
# extensions -- hex floats, `1.5f`, `inf`, Unicode digits -- cannot leak in
# through whichever runtime is underneath.

test "atoi takes a sign and ASCII decimal digits, and nothing around them" {
  assert atoi("0") == Some(0)
  assert atoi("42") == Some(42)
  assert atoi("+42") == Some(42)
  assert atoi("-42") == Some(-42)
  assert atoi("007") == Some(7)
  assert atoi("-0") == Some(0)
  # trimmed first, by Dawn's own space table -- so the pad is outside the number
  assert atoi("  -5  ") == Some(-5)
  assert atoi("\t\n 7 \r\n") == Some(7)
  # ... and only outside it: a space the trim cannot reach is a non-digit
  assert atoi("4 2") == None
  assert atoi("- 5") == None
  # nothing left after the sign is not a number
  assert atoi("") == None
  assert atoi("   ") == None
  assert atoi("+") == None
  assert atoi("-") == None
  assert atoi("--5") == None
  # the whole string or nothing: no prefix parse, and no host spellings
  assert atoi("12abc") == None
  assert atoi("0x10") == None
  assert atoi("1.0") == None
  assert atoi("1e3") == None
  # ASCII digits, not "characters with a digit property"
  assert atoi("４") == None
  # and Dawn's space table, not Unicode's: U+00A0 is not whitespace to `trim`
  assert atoi("\u{00A0}42") == None
}

test "atoi answers None at the edge of Int instead of wrapping" {
  # the magnitude of the minimum has no positive Int, which is why the
  # accumulator runs negated -- the case that shape exists for
  assert atoi("-9223372036854775808") == Some(-9223372036854775807 - 1)
  assert atoi("9223372036854775807") == Some(9223372036854775807)
  # one past each end, and far past
  assert atoi("9223372036854775808") == None
  assert atoi("-9223372036854775809") == None
  assert atoi("99999999999999999999999") == None
  # There are two overflow guards and they catch different inputs. The three
  # above are all stopped by the second one (`acc * radix` still fits, the
  # digit is what does not), so a broken first guard survives them. These
  # reach `multmin` itself: the running value is exactly one step from
  # overflowing on the multiply, and nothing later would notice the wrap.
  assert atoi("922337203685477581") == Some(922337203685477581)
  assert atoi("9223372036854775810") == None
  assert atoi("9223372036854775819") == None
  assert atoi("9223372036854775900") == None
  assert atoi("-9223372036854775810") == None
  assert atoi("-9223372036854775900") == None
  assert atoi("9999999999999999999") == None
  # the asymmetry is real: the positive limit is one short of the negative one
  assert atoi("-9223372036854775807") == Some(-9223372036854775807)
}

test "atoi_radix refuses a radix outside 2..36 and cuts the digits at it" {
  # a radix is a value the caller must get right, and 0 and 1 name no
  # positional system -- so this is inquiry (spec 4.8 criterion 2), not a clamp
  assert atoi_radix("1", 0) == None
  assert atoi_radix("1", 1) == None
  assert atoi_radix("1", 37) == None
  assert atoi_radix("1", 0 - 2) == None
  # both ends of the accepted range work
  assert atoi_radix("1011", 2) == Some(11)
  assert atoi_radix("z", 36) == Some(35)
  assert atoi_radix("10", 36) == Some(36)
  # the digit set is cut at the radix, not at the alphabet
  assert atoi_radix("102", 2) == None
  assert atoi_radix("z", 35) == None
  assert atoi_radix("y", 35) == Some(34)
  # case is not significant above 9, over the whole alphabet and not just the
  # hex letters -- 'G'..'Z' is the stretch a hex-shaped digit table stops at
  assert atoi_radix("ff", 16) == Some(255)
  assert atoi_radix("FF", 16) == Some(255)
  assert atoi_radix("fF", 16) == Some(255)
  assert atoi_radix("Z", 36) == Some(35)
  assert atoi_radix("G", 36) == Some(16)
  assert atoi_radix("Y", 35) == Some(34)
  assert atoi_radix("HELLO", 36) == Some(29234652)
  assert atoi_radix("HELLO", 36) == atoi_radix("hello", 36)
  # the gap between '9' and 'A' in ASCII is not a digit
  assert atoi_radix(":", 16) == None
  assert atoi_radix("@", 16) == None
  # sign and trim work the same at every radix
  assert atoi_radix("-ff", 16) == Some(-255)
  assert atoi_radix("  +11  ", 2) == Some(3)
  # the range is the radix's, so it moves with it
  assert atoi_radix("111111111111111111111111111111111111111111111111111111111111111", 2)
    == Some(9223372036854775807)
  assert atoi_radix("1111111111111111111111111111111111111111111111111111111111111111", 2)
    == None
  assert atoi_radix("1y2p0ij32e8e7", 36) == Some(9223372036854775807)
  assert atoi_radix("1y2p0ij32e8e8", 36) == None
  # atoi is this function at ten
  assert atoi_radix("42", 10) == atoi("42")
  assert atoi_radix("0x10", 10) == atoi("0x10")
}

test "atod accepts the shape spec 11 writes down, and refuses the near misses" {
  assert atod("0") == Some(0.0)
  assert atod("1") == Some(1.0)
  assert atod("-1") == Some(-1.0)
  assert atod("+1") == Some(1.0)
  assert atod("1.5") == Some(1.5)
  assert atod("+1.5") == Some(1.5)
  assert atod("00.50") == Some(0.5)
  # a mantissa needs a digit somewhere, but not on both sides of the point
  assert atod(".5") == Some(0.5)
  assert atod("-.5") == Some(-0.5)
  assert atod("1.") == Some(1.0)
  assert atod("1.e2") == Some(100.0)
  assert atod(".") == None
  assert atod("-.") == None
  # the exponent, both cases and all three sign spellings
  assert atod("1e5") == Some(100000.0)
  assert atod("1E5") == Some(100000.0)
  assert atod("1e+5") == Some(100000.0)
  assert atod("1e-5") == Some(0.00001)
  assert atod(".5e1") == Some(5.0)
  assert atod("0e0") == Some(0.0)
  # an `e` with no digits after it is not an exponent
  assert atod("1e") == None
  assert atod("1e+") == None
  assert atod("1e-") == None
  assert atod("e5") == None
  # trimmed at the ends, refused in the middle
  assert atod("  1.5  ") == Some(1.5)
  assert atod("1 5") == None
  assert atod("1 . 5") == None
  # nothing at all
  assert atod("") == None
  assert atod("   ") == None
  assert atod("-") == None
  assert atod("+") == None
  assert atod("--1") == None
  assert atod("1.2.3") == None
  # the host spellings this refusal exists to keep out
  assert atod("0x10") == None
  assert atod("1.5f") == None
  assert atod("1d5") == None
  assert atod("1_000") == None
  assert atod("٤") == None
}

test "atod knows exactly the three spellings dtoa emits, and no synonyms" {
  # the pair that closes: these are the only non-numeric strings dtoa produces
  assert dtoa(1.0 / 0.0) == "Infinity"
  assert dtoa(-1.0 / 0.0) == "-Infinity"
  assert dtoa(0.0 / 0.0) == "NaN"
  assert atod("Infinity") == Some(1.0 / 0.0)
  assert atod("-Infinity") == Some(-1.0 / 0.0)
  assert atod("  Infinity  ") == Some(1.0 / 0.0)
  # NaN is not equal to itself, so it is asked about rather than compared
  let nan_is_nan = match atod("NaN") {
    Some(v) -> v != v
    None -> false
  }
  assert nan_is_nan
  # every neighbouring spelling a host parser would have taken
  assert atod("inf") == None
  assert atod("Inf") == None
  assert atod("INF") == None
  assert atod("infinity") == None
  assert atod("INFINITY") == None
  assert atod("nan") == None
  assert atod("NAN") == None
  # dtoa never writes these two, so atod does not read them
  assert atod("+Infinity") == None
  assert atod("-NaN") == None
}

test "atod saturates at the ends of Float rather than answering None" {
  # out of range is not a shape error: the conversion is IEEE, and IEEE says
  # overflow is an infinity and underflow is a zero
  assert atod("1e400") == Some(1.0 / 0.0)
  assert atod("-1e400") == Some(-1.0 / 0.0)
  assert atod("1e309") == Some(1.0 / 0.0)
  assert atod("1e-400") == Some(0.0)
  # ... and the last representable value on each side is not saturated
  assert atod("1e308") == Some(1.0e308)
  assert atod("4.9e-324") == Some(4.9e-324)
  # more digits than a Float holds is a rounding, not a refusal
  assert atod("123456789012345678901234567890") == Some(1.2345678901234568e29)
  assert atod("0.1") == Some(0.1)

  # dtoa's output is always readable by atod, which is the promise that makes
  # the two a pair rather than two independent functions. Written out rather
  # than looped: `for` needs `Iter[List[T]]`, and that impl lives in std/list,
  # which this module does not import.
  assert atod(dtoa(0.0)) == Some(0.0)
  assert atod(dtoa(1.5)) == Some(1.5)
  assert atod(dtoa(-1.5)) == Some(-1.5)
  assert atod(dtoa(3.141592653589793)) == Some(3.141592653589793)
  assert atod(dtoa(1.0e300)) == Some(1.0e300)
  assert atod(dtoa(1.0e-300)) == Some(1.0e-300)
  assert atod(dtoa(42.0)) == Some(42.0)
  assert atod(dtoa(0.1)) == Some(0.1)
  # negative zero survives the trip, and `==` cannot see it -- 1/x can
  assert dtoa(-0.0) == "-0.0"
  let keeps_the_sign = match atod("-0.0") {
    Some(v) -> 1.0 / v == -1.0 / 0.0
    None -> false
  }
  assert keeps_the_sign
}

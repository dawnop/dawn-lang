-- record: fields left to right --
cmp(p11, p12): lt
cmp(p21, p12): gt
cmp(p11, p11): eq
-- union: constructor order first --
cmp(Dot, Line)  : lt
cmp(Line, Named): lt
cmp(Line, Line) : lt
cmp(Named,Named): gt
-- nested: a derived field --
cmp(n1, n2): lt
cmp(n1, n3): lt
-- through a bound --
through(p11, p12): lt
through(n1, n2)  : lt
through(Dot, Dot): eq
-- derived on a generic type --
cmp(Box 1, Box 2)  : lt
cmp(Box p12, Box p11): gt
cmp(Two, Two)      : lt
cmp(Just, Nothing) : gt
cmp(Box Box, Box Box): eq
-- generic, and through a bound: the dictionary travels --
through(Box 1, Box 2): lt
through(Just Box, Just Box): gt

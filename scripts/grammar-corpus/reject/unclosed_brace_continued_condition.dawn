# expect: unclosed `{`	this `{` is probably missing its own `}`
# expect: expected a newline after this statement
# expect: expected a newline after this statement
# expect: expected an expression, found `pub`
# The `if` block lost its `}`, and a later block opens on a line that continues
# a condition: `&&` ends the line above, so that line is indented as part of
# an expression and its `{` is closed by a `}` at the statement's indent. That
# pair looks misindented but is in order, and it was taken for the lost one
# because it opens last (#670). A pair opened on a continuation line is no suspect.
pub fn main() -> Unit !io = run(() => {
  let a = 1
  if a > 0 { io.println("pos") else { () }
  if a > 1 &&
      a > 2 {
    io.println("big")
  } else {
    ()
  }
})

pub fn later() -> Int = 1

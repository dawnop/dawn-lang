# The JVM server: jdk.httpserver underneath (spec §9 interop), one virtual
# thread per request, a single root context that parses the exchange into a
# Request, routes it, and writes the Response back. nginx terminates TLS and
# everything hard in front — this only speaks HTTP/1.1.
#
# This is the package's whole reason to exist apart from `web`: the one place
# in the web framework that names a Java type. `web` (types, router,
# middleware, wire) is pure Dawn, so the native compiler checks, documents and
# tests it as a package; a package with a `use java` in it cannot be loaded
# that way, because a directory target loads every module under src/. Keeping
# the JDK server in its own package is what needs no loader mechanism for it
# (docs/web-core-split-design.md). A JVM program imports this for `serve_app`,
# `start` and `input_source`; a program that never serves (a router under
# test, a handler library) depends on `web` alone. Its tests live here too,
# since nearly every one of them starts a real server.
use std/str
use std/bytes
use std/list
use std/map
use std/io.{delete, Deleted, NotFound, with_fs_real, list_dir}
use java "com.sun.net.httpserver.HttpServer"
use java "com.sun.net.httpserver.HttpExchange"
use java "com.sun.net.httpserver.Headers"
use java "java.net.InetSocketAddress"
use java "java.util.concurrent.Executors"
use java "java.util.concurrent.ExecutorService"
use java "java.util.concurrent.CountDownLatch"
use java "java.io.OutputStreamWriter"
use java "java.lang.String"
use java "java.util.Iterator"
use java "java.io.File"
use java "java.io.FileOutputStream"
use web/types.{safe_rel, Request, Response, response_status, response_content_type, response_headers, response_body, ResponseBody, BodySource, DEFAULT_MAX_BODY, Empty, Text, Binary, Stream, HttpError, ErrorFormat, Handler, Guard, Middleware, RouteMeta, http_error, default_errors, error_response, streaming, text, binary, header, headers_all, query, query_all, param, param_segs, body_text, with_header, try_redirect, raw, log_request, escape_field}
use web/wire.{raw_segs, decode_path_seg, has_dot_segment, parse_query, multimap, join_with}
use web/exchange.{meta_has_tag, meta_of, guard_of, run_guard, body_ceiling, run_dispatch, serve_through, Withheld, Sized, Chunked, framing, drop_body, Pumped, Truncated, TransferFailed, PumpPanicked, pump_with, pump_report}
use web/router.{Route, dispatch_segs, validate_routes, route_get, route_post, route_put, tagged, body_limit, guarded}
use java "java.net.Socket"
use java "java.net.ServerSocket"
use java "java.io.InputStream"
use java "java.io.OutputStream"
use java "java.net.URI"
use java "java.net.http.HttpClient"
use java "java.net.http.HttpRequest"
use java "java.net.http.HttpRequest.BodyPublisher"
use java "java.net.http.HttpRequest.BodyPublishers"
use java "java.net.http.HttpResponse.BodyHandlers"
use java "java.net.URL"
use java "java.net.HttpURLConnection"
use java "java.io.ByteArrayInputStream"
use java "java.io.ByteArrayOutputStream"
use java "java.io.FileInputStream"
use java "java.util.ArrayList"
use java "java.lang.System"
use java "java.lang.Long"
use java "java.lang.Thread"
use java "java.lang.Throwable"

# The pump's read size: the chunk `transferTo` moved, which is also the
# `SPILL_CHUNK` of the request side.
const PUMP_CHUNK: Int = 8192

## A BodySource over a Java InputStream: what a JVM program passes to
## `streaming` when its upstream is a stream (an `HttpClient` response body, a
## file). The stream already owns its sequential cursor, so `pos` is ignored.
## A `read(pos, n)` returns what the stream has ready, not `n` bytes: it
## waits for one byte, then takes whatever else is already buffered up to `n`,
## which is `read(byte[])`'s behaviour. `readNBytes(n)` alone would wait to
## fill the whole chunk, and a download proxied from a slow upstream would
## stall until 8 KiB had arrived instead of passing each piece on, which is the
## first-byte-out-immediately property the streaming body exists for.
pub fn input_source(s: InputStream) -> BodySource =
  BodySource { read = (_pos, n) => read_ready(s, n), close = () => s.close() }

fn read_ready(s: InputStream, n: Int) -> Bytes !io = {
  let first = s.readNBytes(1)!
  if len(first) == 0 || n <= 1 {
    first
  } else {
    let ready = s.available()
    let more = if ready < n - 1 { ready } else { n - 1 }
    if more <= 0 {
      first
    } else {
      bytes.freeze(bytes.put_bytes(bytes.put_bytes(bytes.buf(), first), s.readNBytes(more)!))
    }
  }
}

# Move a source to `out` a chunk at a time and say how many bytes moved. It
# stops at the first empty read; a read or a write that fails raises, and
# `pump_with` is what classifies that.
fn copy_source(src: BodySource, out: OutputStream) -> Int !io = {
  var total = 0
  var more = true
  while more {
    let chunk = src.read(total, PUMP_CHUNK)
    if len(chunk) == 0 {
      more = false
    } else {
      out.write(chunk)
      total = total + len(chunk)
    }
  }
  total
}

## The rest of the releases `write_response` brackets with, innermost first.
## These do *not* swallow: a failure to flush the response body is the client's
## problem to hear about, and the exchange is the connection.
fn close_writer(w: OutputStreamWriter) -> Unit !io = w.close()

fn close_body(o: OutputStream) -> Unit !io = o.close()

fn close_exchange(ex: HttpExchange) -> Unit !io = ex.close()

fn close_exchange_quietly(ex: HttpExchange) -> Unit !io = {
  let _ = catch_fault(() => ex.close())
  ()
}

# What `handle` brackets the whole exchange with, so that it runs on every way
# out, including the one no barrier stops: a JVM Error such as an
# OutOfMemoryError, which `catch_panic` and `catch_fault` let through by design
# (spec §9.8.2: only `bracket` sees it, and only to release). That path used to
# skip `write_response` entirely, so the exchange was never closed and the
# client waited until its own timeout.
#
# On the ordinary path `write_response` has answered and closed the exchange,
# and closing it again does nothing. On the other, nothing has been sent if the
# status is still -1 (the JDK sets it in sendResponseHeaders), and then this
# tries the neutral 500. Trying may itself fail, the heap being what it is when
# this runs, so the close is bracketed around the attempt rather than after it.
fn finish_exchange(ex: HttpExchange, errors: ErrorFormat) -> Unit !io = {
  with x <- bracket(ex, close_exchange_quietly)
  if x.getResponseCode() == -1 {
    let _ = catch_fault(() => write_response(x, error_response(http_error(500, errors.internal_message), fmt = errors)))
    ()
  }
}

# One line for a request that ended in a JVM Error, in place of the stack trace
# the thread would otherwise print. The request's own virtual thread is the one
# this is installed on, so it covers that request and nothing else; the line
# is shaped like the "request panicked" one a panic leaves.
fn log_fatal(_t: Thread, e: Throwable) -> Unit !io = println("request failed: ${e.toString()!}")

# The Content-Length the client claims, or 0 when it does not say. A claim, not
# a fact — it only ever produces a fast rejection, never permission to read.
fn declared_length(ex: HttpExchange) -> Int !io =
  match ex.getRequestHeaders()!.getFirst("Content-Length") {
    Some(v) -> unwrap_or(parse_int(str.trim(v)), 0)
    None -> 0
  }

# Read the whole request body once, as the raw Bytes it is on the wire (spec
# §9.5.1). No decode happens here: text handlers take the UTF-8 view through
# `types.body_text`, which refuses a malformed body with a 400, and binary
# handlers (multipart upload, WebDAV PUT) parse the bytes directly. The
# unconditional lossy decode every request used to pay for — upload routes
# included, into a String nothing read — is gone with the old (String, Bytes)
# pair.
#
# `limit` is a hard ceiling on bytes read, and it is enforced *here* rather than
# by a middleware afterwards. The old arrangement called readAllBytes() and let
# with_body_limit compare the result against a budget, which cannot stop
# anything: by the time the 413 is decided, the whole body is already resident,
# and a handful of concurrent large POSTs is the entire attack. readNBytes stops
# one byte past the ceiling — enough to know the body is oversized, and the most
# that can ever be allocated for one.
#
# `None` is unbounded, and only the "raw-body" routes get it (see
# `build_request`): nginx bounds those in front. This used to be `limit <= 0`,
# a number doubling as a switch, and the same number was the public ceiling, so
# a config of 0 silently meant no ceiling at all. The public ceiling is a
# positive number now (`start` refuses anything else) and the switch is a type.
#
# The 413 is worded by `fmt.body_too_large`, as are the other two 413 sites
# (`spill_body`, `copy_bounded`): the refusal is the framework's, the words are
# the application's, and one route must not answer in two languages.
fn read_body(fmt: ErrorFormat, ex: HttpExchange, limit: Option[Int]) -> Result[Bytes, HttpError] !io = {
  let stream = ex.getRequestBody()!
  match limit {
    None -> read_chunk(() => stream.readAllBytes()!)
    Some(n) ->
      if declared_length(ex) > n {
        Err(http_error(413, fmt.body_too_large(n)))
      } else {
        let raw = read_chunk(() => stream.readNBytes(n + 1)!)?
        if len(raw) > n {
          Err(http_error(413, fmt.body_too_large(n)))
        } else {
          Ok(raw)
        }
      }
  }
}

# A read of the request body that the JDK's stream refuses: a chunk size that is
# not hex, a chunk cut short, a body that ends before its Content-Length. That
# is the client's malformed request and is answered as one, the 400
# web/exchange gives the same failures in the same words, not the 500 it was
# while the exception went up as a panic. (A client that hangs up mid-body
# lands here too; the answer goes nowhere, which is harmless.)
fn read_chunk(read: fn() -> Bytes !io) -> Result[Bytes, HttpError] !io =
  match catch_fault(read) {
    Ok(b) -> Ok(b)
    Err(_) -> Err(http_error(400, "malformed request body"))
  }

# The length write_response hands to sendResponseHeaders, in jdk.httpserver's
# convention: n > 0 is an exact Content-Length, 0 selects chunked transfer
# encoding, -1 means no body at all. What the framing *is* is web/exchange's
# `framing` (the same decision the single-exchange adapter writes from): Text is
# its UTF-8 byte count, Binary its byte length, a Stream its stated length, only
# a Stream whose length is unknown up front is chunked, and 1xx, 204, 205 and
# 304 carry no body whatever the handler built. This is only the translation to
# the JDK's numbers. An empty body maps to -1, because 0 would mean chunked
# here; the JDK then emits Content-Length: 0 itself. 205 is the one of the four
# status classes `sendResponseHeaders` does not cover on its own (it forces 1xx,
# 204 and 304 to no body and treats 205 as ordinary), so for 205 the framing is
# what keeps the response compliant.
fn body_length(status: Int, body: ResponseBody) -> Int =
  match framing(status, body) {
    Withheld -> -1
    Sized(n) -> exact_length(n)
    Chunked -> 0
  }

fn exact_length(n: Int) -> Int = if n == 0 { -1 } else { n }

# Pump the upstream stream to the socket and log anything but a clean EOF.
#
# The wording is deliberately not "client disconnected". A client hanging up and
# an upstream read failing are the same java.io.IOException out of the same
# copy_source call, and this layer cannot tell them apart; naming one of them
# would be a guess printed as a fact. What it can say honestly is that the
# transfer stopped after the response was already committed.
#
# Nothing is sent to the client either way: the headers went out before the
# first byte (docs/streaming-response-design.md §4.3), so the status is spent
# and the only remaining signal is the connection ending short. For a stream of
# stated length that signal is a real one: the Content-Length promised more
# than arrived, and closing the JDK's fixed-length stream short of it throws
# ("insufficient bytes written"), which ends the connection instead of letting
# the exchange look complete.
#
# Log ordering, so nobody reads it as interleaving: `with_logging`
# (web/middleware.dawn) writes its access line when the handler returns, and
# write_response runs after that, at the end of `handle`. A failed stream
# therefore logs *after* its own `GET /x -> 200` line. That is the shape of the
# pipeline, not a lost message.
fn pump_stream(s: BodySource, expected: Option[Int], out: OutputStream) -> Unit !io =
  match pump_report(pump_with(s, expected, up => copy_source(up, out))) {
    Some(line) -> println(line)
    None -> ()
  }

# Write a response. The body kind decides the framing (see body_length). A
# HEAD request gets the status and headers its GET produced — including the
# exact Content-Length when the length is known — but no body bytes (RFC 9110
# §9.3.2). jdk.httpserver's documented way to answer HEAD is to set
# Content-Length manually and pass -1, which is what the HEAD branch does.
#
# Nothing here re-checks the response. web3 3.1.0 put a second copy of the
# header predicates at this boundary (`response_problem`, withholding a
# response that failed them as a neutral 500), because a record literal could
# skip every constructor. Response is opaque since web5: the constructors and
# `with_header` are the only way one comes to exist, and they refuse there, so
# a second copy of the rule here could only drift from the first.
fn write_response(ex: HttpExchange, response: Response) -> Unit !io = {
  with x <- bracket(ex, close_exchange)
  let status = response_status(response)
  let content_type = response_content_type(response)
  let extra = response_headers(response)
  let body = response_body(response)
  let headers = x.getResponseHeaders()!
  headers.set("Content-Type", content_type)
  set_extra_headers(headers, extra)
  let length = body_length(status, body)
  if x.getRequestMethod()! == "HEAD" {
    if length > 0 {
      headers.set("Content-Length", to_string(length))
    }
    x.sendResponseHeaders(status, -1)
    drop_body(body)
  } else if length == -1 {
    x.sendResponseHeaders(status, -1)
    drop_body(body)
  } else {
    x.sendResponseHeaders(status, length)
    with out <- bracket(x.getResponseBody()!, close_body)
    match body {
      # unreachable: an empty body maps to length -1 above
      Empty -> ()
      Text(s) -> {
        with writer <- bracket(OutputStreamWriter.new(out, "UTF-8"), close_writer)
        writer.write(s)
        writer.flush()
      }
      Binary(b) -> {
        # binary body: write the raw Bytes verbatim (Bytes -> Java byte[] param)
        out.write(b)
        out.flush()
      }
      # streaming body: pump the upstream InputStream straight to the socket, 8KB
      # at a time — constant memory, first byte out immediately. Whatever
      # happens, the upstream stream closes and the HttpClient connection frees;
      # a failure cannot escape into `handle`'s caller, because write_response
      # runs outside that function's own isolation barrier. See pump_stream for
      # what is logged and why the failure is not sent to the client.
      Stream(s, expected) -> pump_stream(s, expected, out)
    }
  }
}

fn set_extra_headers(headers: Headers, hs: List[(String, String)]) -> Unit !io = {
  for i in range(0, len(hs)) {
    let (k, v) = hs[i]
    headers.add(k, v)
  }
}

# Collect request headers into a lowercase-keyed multimap: every value of a
# repeated name (Cookie, Forwarded, ...) survives, in wire order (WEB-04).
# Normalization contract: keys are lowercased exactly once, here, and
# `header`/`headers_all` lowercase the name they are given — one rule at both
# ends. The JDK's Headers has its own Title-Case normalization inside the
# exchange, which is deliberately not leaned on: a Request built by hand in a
# test must behave like one built from the wire. The key set is a Java
# collection, so it is walked with an iterator.
fn read_headers(ex: HttpExchange) -> Map[String, List[String]] !io = {
  let headers = ex.getRequestHeaders()!
  let it = headers.keySet()!.iterator()!
  collect_headers(headers, it, map.empty())
}

fn collect_headers(headers: Headers, it: Iterator, acc: Map[String, List[String]]) -> Map[String, List[String]] !io =
  if it.hasNext() {
    let name = String.valueOf(it.next()!)!
    let vs = string_values(headers.get(name)!.iterator()!, [])
    collect_headers(headers, it, map.insert(acc, str.to_lower(name), vs))
  } else {
    acc
  }

# Drain a Java Iterator of strings into a Dawn list (Headers.get hands back a
# java.util.List of every value the name arrived with).
fn string_values(it: Iterator, acc: List[String]) -> List[String] !io =
  if it.hasNext() {
    string_values(it, acc ++ [String.valueOf(it.next()!)!])
  } else {
    acc
  }

# Everything a Request holds that comes off the request line and the headers,
# which is everything except the body. Reading it cannot fail and cannot leave
# anything on disk, which is what makes it usable on the paths where the body is
# deliberately never read (`handle`'s two early refusals).
fn bodyless_request(ex: HttpExchange, meta: Option[RouteMeta]) -> Request !io = {
  let uri = ex.getRequestURI()!
  let no_params: Map[String, List[String]] = map.empty()
  let no_query: Map[String, List[String]] = map.empty()
  # getRawQuery, not getQuery: the split into parameters must see the encoded
  # form, or a client can put an encoded '&' in a value and forge a parameter.
  # Each component is decoded afterwards with form-urlencoded semantics ('+' is
  # a space), matching Starlette/FastAPI. A repeated name keeps every value, in
  # wire order, exactly as a repeated header does.
  let q = match uri.getRawQuery() {
    Some(s) -> multimap(parse_query(s))
    None -> no_query
  }
  Request {
    method = ex.getRequestMethod()!,
    path = uri.getPath()!,
    raw_path = uri.getRawPath()!,
    params = no_params,
    query = q,
    headers = read_headers(ex),
    body = bytes.utf8(""),
    body_file = None,
    route = meta,
  }
}

# The line sink the shared decisions of web/exchange write to: stdout, as every
# other line this server logs. The single-exchange adapter passes stderr, since
# stdout is its wire.
fn log_line(line: String) -> Unit !io = println(line)

fn build_request(
  ex: HttpExchange,
  meta: Option[RouteMeta],
  guard: Option[Guard],
  max_body: Int,
  errors: ErrorFormat,
) -> Result[Request, HttpError] !io = {
  # A "stream-body" route never sees the body in memory: it goes to a temp file
  # and the handler gets the path, bounded by the route's own `body_limit` when
  # it has one and unbounded when it does not. Everything else reads into
  # memory under a ceiling: the route's `body_limit` when it has one, else the
  # server's `max_body`, except that a route tagged "raw-body" (uploads bounded
  # by nginx's client_max_body_size instead) has no ceiling unless it sets one.
  let streaming = meta_has_tag(meta, "stream-body")
  let own: Option[Int] = match meta {
    Some(m) -> m.body_limit
    None -> None
  }
  let limit: Option[Int] = body_ceiling(meta, max_body)
  # Every other field is read off the exchange *before* the spill, on purpose:
  # the spill is the only step that leaves something on disk, so once it has
  # succeeded nothing between it and the returned Request may fail. All that is
  # left below is record construction, which cannot. (These reads used to sit
  # inside the record literal, after the spill — a malformed request line
  # faulting there left the temp file with no owner.)
  let base = bodyless_request(ex, meta)
  # The guard goes first, before anything reads the body or makes a file. A
  # check that lives in the handler runs after both, which on a "stream-body"
  # route meant an anonymous PUT was written to disk in full before its 401.
  run_guard(guard, base, errors, log_line)?
  let body = if streaming { bytes.utf8("") } else { read_body(errors, ex, limit)? }
  let bf: Option[String] = if streaming { Some(spill_body(errors, ex, own)?) } else { None }
  Ok(Request { ..base, body = body, body_file = bf })
}

# The ownership rule for a spilled body, with its two moving parts passed in so
# a test can drive them: `make` produces the temp file, `fill` writes the body
# into it.
#
# The file exists from `make` onward, so from that instant every way out of here
# has to name an owner. `fill` returning normally is the one that hands the path
# to the caller; every other outcome deletes the file here, before the failure
# goes on propagating. The bracket underneath only ever owned the *output
# stream*, so a client hanging up mid-PUT (transferTo throws) closed the stream
# and left the file on disk forever — interrupted uploads accumulated until the
# temp directory filled.
#
# `fill` has two ways to fail and they are different answers. An `Err` is a
# refusal it decided on (the body ran past the route's ceiling), and goes out as
# that error, a 413 and not a 500. A panic or a Java exception is a spill that
# broke (the client hung up, the disk filled), and for that the client is told
# the application's own 500 wording (ErrorFormat.internal_message), not a fourth
# string this framework renders on its own; what actually went wrong goes to
# the log, where it belongs. The file is deleted on both.
fn spill_with(
  fmt: ErrorFormat,
  make: fn() -> File !io,
  fill: fn(FileOutputStream) -> Result[Unit, HttpError] !io,
) -> Result[String, HttpError] !io = {
  let tmp = make()
  let path = String.valueOf(tmp.getPath()!)!
  let filled = catch_panic(() => {
    with out <- bracket(FileOutputStream.new(tmp), close_spill)
    fill(out)
  })
  match filled {
    Ok(Ok(_)) -> Ok(path)
    Ok(Err(e)) -> {
      delete_quietly(path)
      Err(e)
    }
    Err(m) -> {
      println("request body spill failed: ${m.message}")
      delete_quietly(path)
      Err(http_error(500, fmt.internal_message))
    }
  }
}

# Stream the request body to a temp file, 8KB at a time, and return its path.
# Constant memory whatever the file's size, the point of the whole exercise.
# The Request owns the path from here on; `drop_body_file` deletes it once the
# handler is done.
#
# `limit` is the route's own ceiling. A Content-Length over it is refused
# before the temp file exists; a body that runs over it anyway (no length, or a
# length that lied) is stopped one chunk past the ceiling at most, never
# written past it, and the partial file is deleted by `spill_with`. This used
# to be a single `transferTo`, which cannot be stopped partway and does not
# count until it is done, so a stream-body route had no ceiling at all and
# only a reverse proxy in front stood between a client and the disk.
fn spill_body(fmt: ErrorFormat, ex: HttpExchange, limit: Option[Int]) -> Result[String, HttpError] !io = {
  match limit {
    Some(n) ->
      if declared_length(ex) > n {
        return Err(http_error(413, fmt.body_too_large(n)))
      }
    None -> ()
  }
  spill_with(fmt, () => File.createTempFile("dawn-put-", ".tmp")!, out => copy_bounded(fmt, ex.getRequestBody()!, out, limit))
}

# The spill's read size: the buffer transferTo used, kept so a large PUT costs
# what it did before.
const SPILL_CHUNK: Int = 8192

# Copy `stream` to `out` a chunk at a time, counting. Past `limit` it stops
# before writing the chunk that crossed it and answers 413.
fn copy_bounded(fmt: ErrorFormat, stream: InputStream, out: FileOutputStream, limit: Option[Int]) -> Result[Unit, HttpError] !io = {
  var total = 0
  var more = true
  while more {
    let chunk = read_chunk(() => stream.readNBytes(SPILL_CHUNK)!)?
    let k = len(chunk)
    if k == 0 {
      more = false
    } else {
      total = total + k
      match limit {
        Some(n) ->
          if total > n {
            return Err(http_error(413, fmt.body_too_large(n)))
          }
        None -> ()
      }
      out.write(chunk)
    }
  }
  Ok(())
}

fn close_spill(o: FileOutputStream) -> Unit !io = o.close()

# A delete that does not abort the request, but does say so. An already-absent
# file and a failed delete are different log lines because they are different
# facts: the first is a double release (worth knowing, harmless), the second
# is a temp file that will outlive the request.
#
# The file system handler is installed here rather than threaded up to the
# route: every caller sits inside a `Handler`, whose row is the closed `!io`
# (types.dawn), so the label could not travel through it (spec §6.5, the
# handler is the call site's). The innermost boundary that owns the whole
# unit of file work is this one delete.
fn delete_quietly(path: String) -> Unit !io =
  with_fs_real(() => match delete(path) {
    Ok(Deleted) -> ()
    Ok(NotFound) -> println("temp body file was already absent: ${path}")
    Err(m) -> println("temp body file not deleted: ${path} (${m.message})")
  })

## The release for the spilled request body: a Request owns its temp file for
## exactly the length of the handler call, and there is nothing to delete when
## the body never went to disk.
fn drop_body_file(req: Request) -> Unit !io =
  match req.body_file {
    Some(p) -> delete_quietly(p)
    None -> ()
  }

fn handle(routes: List[Route], middleware: List[Middleware], max_body: Int, errors: ErrorFormat, ex: HttpExchange) -> Unit !io = {
  # The outermost layer, so it holds on every way out: `finish_exchange`
  # closes the exchange, and answers 500 first if a JVM Error got past the
  # barrier below before anything was sent.
  Thread.currentThread()!.setUncaughtExceptionHandler(log_fatal)
  with ex <- bracket(ex, x => finish_exchange(x, errors))
  # a handler panic is isolated to this request: catch_panic turns it into a 500
  # instead of resetting the connection or leaking the virtual thread (spec §9.8).
  let outcome = catch_panic(() => {
    let raw_path = ex.getRequestURI()!.getRawPath()!
    # Dispatch BEFORE touching the body: method and path come from the request
    # line, and the matched route's tags decide how the body is read at all
    # ("stream-body" spills it to disk instead of into memory). The same decision
    # is executed by run_dispatch below — no second table walk.
    #
    # WEB-03: routing runs on the *raw* path, split on "/" first, each segment
    # percent-decoded on its own — an encoded slash (%2F) stays inside its
    # segment instead of minting a route boundary.
    let d = dispatch_segs(routes, ex.getRequestMethod()!, map(raw_segs(raw_path), s => decode_path_seg(s)))
    let meta = meta_of(d)
    # The refusals below (a dot segment, the route's guard, a body over its
    # ceiling) happen before the body is read. The first and the last used to
    # happen before the middleware chain as well, on the grounds that there was no
    # Request to hand it. There is: everything a Request holds apart from the
    # body comes off the request line and the headers, and `bodyless_request`
    # reads exactly that. So they go through the chain like every other answer,
    # and a cross-origin 400 or 413 now carries the Access-Control-* headers
    # without which a browser refuses to let the page read the error body, the
    # one case where reading it matters most (LIB-10).
    #
    # What the middleware sees on these paths is honest but partial: `raw`
    # and `body` are empty, because not reading the body is the entire point of
    # refusing this early. A middleware that inspects the body sees an empty one
    # here; one that inspects the method, path, headers or route tags sees the
    # truth. `with_body_limit` is in the second group, and passes.
    #
    # The dot-segment check runs after dispatch rather than before so that the
    # 400 carries the matched route's tags: a WebDAV path is "no-cors" whether
    # or not it contains a dot segment, and the refusal should not be the one
    # answer on that route that gets stamped.
    let attempt: Result[Request, HttpError] =
      # WEB-03: a dot segment ("." / "..", raw or percent-encoded) is refused on
      # every route, including paths nothing would match. Dispatch has already
      # run, but no handler has: the decision is only read for its tags.
      if has_dot_segment(raw_path) {
        println("${log_request(ex.getRequestMethod()!, raw_path)} -> 400 (dot segment)")
        Err(http_error(400, errors.dot_segment))
      } else {
        # a guard's refusal and an oversized body are both answered before the
        # body is read, which is the whole value of refusing; a spill that went
        # over the route's ceiling is a 413 and one that failed is a 500, the
        # same way
        match build_request(ex, meta, guard_of(d), max_body, errors) {
          Err(e) -> {
            println("${log_request(ex.getRequestMethod()!, raw_path)} -> ${e.status} (${escape_field(e.message)})")
            Err(e)
          }
          Ok(req) -> Ok(req)
        }
      }
    match attempt {
      Err(e) -> serve_through(middleware, errors, bodyless_request(ex, meta), _rq => Err(e), log_line)
      Ok(req) -> {
        # the temp body file lives exactly as long as this branch, and the
        # bracket is what makes that true on every way out — including the ones
        # the catch_panic inside serve_through does not see, such as a panic
        # while rendering the 500 for a panic. It is the *first* thing here so
        # that nothing at all sits between build_request handing ownership over
        # and this taking it; build_request itself deletes the file on every
        # path where it fails.
        with held <- bracket(req, drop_body_file)
        serve_through(middleware, errors, held, (rq: Request) => run_dispatch(errors, d, rq), log_line)
      }
    }
  })
  let response = match outcome {
    Ok(r) -> r
    Err(m) -> {
      println("request panicked: ${m.message}")
      error_response(http_error(500, errors.internal_message), fmt = errors)
    }
  }
  write_response(ex, response)
}

# ---- server lifecycle (WEB-10) ----

## Where the server listens, the in-memory body ceiling its requests get (a
## positive byte count; `start` panics on anything else, since there is no
## "unbounded" — routes that need more opt out with the "raw-body" or
## "stream-body" tag), and the wording of the errors it renders itself. port 0
## asks the OS for a free port; `handle_port` reports the one actually bound. `default_errors()` is
## the neutral wording — an application whose clients expect another error
## shape states it here (web/types.ErrorFormat).
pub type ServerConfig = { host: String, port: Int, max_body: Int, errors: ErrorFormat }

# A running server. `port` is the real bound port — the point of port 0.
# `executor` is the request pool `start` created, owned by the handle so that
# `stop` can shut it down: jdk.httpserver's own `stop` does not touch an
# executor it was handed. `done` is what lets join/stop compose over
# jdk.httpserver, which has a stop but no join: join awaits the latch, stop
# opens it after stopping the JDK server.
#
# (The design sketched the handle as server + port only. Without the latch
# there is nothing for join to block on; without the executor there is nothing
# to shut down, and a start/stop cycle left one behind every time, so a test
# suite or a reloading server accumulates them for the life of the process.)
type ServerHandleRep = { server: HttpServer, port: Int, executor: ExecutorService, done: CountDownLatch }

# Opaque since web5. As a public record a handle could be written by hand,
# pairing a server with an executor and a latch it never owned, and `stop` would
# shut down whatever it was handed; its four fields were also the one part of
# the lifecycle a caller had no business reading. `start` is the only way to
# get one, and the port is the one thing worth reading off it.
## A running server, as `start` returns it: `join` blocks on it, `stop` ends
## it, and `handle_port` reads the port it actually bound (the point of port 0).
pub opaque type ServerHandle = ServerHandleRep

## The port the server actually bound — with port 0 in the config, the one the
## OS picked.
pub fn handle_port(h: ServerHandle) -> Int = {
  let rep: ServerHandleRep = h
  rep.port
}

# Bind cfg.host:cfg.port, serve requests on virtual threads, and return
# immediately with the handle. The caller decides what the rest of the
# program does — join() for the classic block-forever server, stop() from
# wherever shutdown is decided.
## Bind cfg.host:cfg.port, serve requests on virtual threads, and return at
## once with the handle — the caller decides what the program does next
## (`join` to block, `stop` from wherever shutdown is decided). A broken route
## table panics here, before the socket is bound.
pub fn start(cfg: ServerConfig, routes: List[Route], middleware: List[Middleware]) -> ServerHandle !io = {
  # WEB-09: a broken table fails here, at startup, with the two routes named —
  # not at runtime as a silent 404 on the route its author believes exists
  match validate_routes(routes) {
    Err(e) -> panic("route table: " ++ e)
    Ok(_) -> ()
  }
  # A ceiling of 0 used to mean "no ceiling", so the one config value most
  # likely to be a mistake was also the one that turned the guard off. There
  # is no unbounded setting any more; a route that needs one says so by tag.
  if cfg.max_body <= 0 {
    panic("server config: max_body must be a positive byte count, got ${cfg.max_body}")
  }
  let addr = InetSocketAddress.new(cfg.host, cfg.port)
  let server = HttpServer.create(addr, 0)!
  server.createContext("/", ex => handle(routes, middleware, cfg.max_body, cfg.errors, ex))
  # the pool goes into the handle, not just into the server: `stop` is the only
  # place that can shut it down, and it needs a reference to do so
  let pool = Executors.newVirtualThreadPerTaskExecutor()!
  server.setExecutor(pool)
  server.start()
  # No println here: start is a library call and the handle reports the port.
  # (A port-0 test transcript with a random port in it broke run-diff, which
  # rightly treats test stdout as a deterministic artifact.) The classic
  # entry points below keep the message.
  ServerHandleRep {
    server = server,
    port = server.getAddress()!.getPort(),
    executor = pool,
    done = CountDownLatch.new(1),
  }
}

## Block until stop() releases this handle. A server's main() usually ends
## here — returning would let the JVM exit out from under the request threads.
pub fn join(h: ServerHandle) -> Unit !io = {
  let rep: ServerHandleRep = h
  rep.done.await()
}

# What stop releases, on every way out of it. Bracketed rather than written
# after `server.stop`, because `server.stop` can throw: a stop that failed
# halfway used to leave the executor running *and* every join() blocked
# forever, so the one call whose job is to end things was the one that could
# not be relied on to end them. The executor goes first (it is the resource
# the handle owns); the latch last, since releasing it is what lets another
# thread observe the shutdown as finished.
fn release_handle(h: ServerHandleRep) -> Unit !io = {
  let _ = catch_fault(() => h.executor.shutdown())
  h.done.countDown()
}

## Stop the server: the listening socket closes at once, in-flight exchanges
## get up to grace_secs to finish (the JDK's stop blocks for that), the request
## executor is shut down, and then every join() blocked on this handle returns.
## Every one of those happens even if the JDK's own stop throws.
pub fn stop(h: ServerHandle, grace_secs: Int) -> Unit !io = {
  let rep: ServerHandleRep = h
  with held <- bracket(rep, release_handle)
  held.server.stop(grace_secs)
}

# `serve_app_bounded(port, max_body, ...)` sat between these two until web5.
# It was `serve_app_with` with one field of the config spelled as a parameter,
# and the only place the `0 = unbounded` reading of a body ceiling was written
# down as API; a program that wants a ceiling other than the default states it
# in the config, like everything else it configures.
## The old shape, kept: start + join on 127.0.0.1, default body ceiling,
## default error wording. Most programs want exactly this.
pub fn serve_app(port: Int, routes: List[Route], middleware: List[Middleware]) -> Unit !io =
  serve_app_with(
    ServerConfig { host = "127.0.0.1", port = port, max_body = DEFAULT_MAX_BODY, errors = default_errors() },
    routes, middleware)

## start + announce + join under a config the caller owns — the entry point for
## a program that configures anything (host, error wording) and still wants
## main() to end by blocking.
pub fn serve_app_with(cfg: ServerConfig, routes: List[Route], middleware: List[Middleware]) -> Unit !io = {
  let h = start(cfg, routes, middleware)
  println("listening on http://${cfg.host}:${handle_port(h)}")
  join(h)
}

# ---- test-only HTTP client: the streaming test needs a real client to pump
# bytes through a socket; the app-side fetch helpers live with the app ----

fn test_get(url: String) -> HttpRequest !io = {
  let nobody: BodyPublisher = BodyPublishers.noBody()!
  HttpRequest.newBuilder()!.uri(URI.create(url)!)!.method("GET", nobody)!.build()!
}

# `body()` is an erased generic, and what it holds is decided by the handler
# passed one line up -- `ofInputStream` gives an `InputStream`, `ofByteArray`
# a `byte[]`. So the `Err` that `cast` now returns (LANG-02) means the pair
# was mismatched here, in test scaffolding, and stopping is what the uncaught
# ClassCastException already did: nothing upstream catches it, and a test that
# silently fetched nothing would be worse than one that stops.
fn test_fetch_stream(url: String) -> (Int, InputStream) !io = {
  let resp = HttpClient.newHttpClient()!.send(test_get(url), BodyHandlers.ofInputStream()!)!
  let got: Result[InputStream, ForeignError] = cast(resp.body()!)
  match got {
    Ok(s) -> (resp.statusCode(), s)
    Err(e) -> panic("test_fetch_stream: body is not an InputStream: " ++ e.message)
  }
}

fn test_fetch_bytes(url: String) -> (Int, Bytes) !io = {
  let resp = HttpClient.newHttpClient()!.send(test_get(url), BodyHandlers.ofByteArray()!)!
  let got: Result[Bytes, ForeignError] = cast(resp.body()!)
  match got {
    Ok(b) -> (resp.statusCode(), b)
    Err(e) -> panic("test_fetch_bytes: body is not a byte[]: " ++ e.message)
  }
}

# Test-only: an HttpURLConnection with `method` to `url`. openConnection
# returns the base URLConnection, and Java subtyping does not enter Dawn
# signatures, so the value goes through an ArrayList round-trip — the widening
# `add(Object)` accepts, the erased `get` returns the Object `cast` takes (the
# scripts/error-contract idiom). Stopping on a mismatch is the same policy as
# test_fetch_stream above.
fn test_connect(method: String, url: String) -> HttpURLConnection !io = {
  let xs = ArrayList.new()
  xs.add(URL.new(url).openConnection()!)
  let got: Result[HttpURLConnection, ForeignError] = cast(xs.get(0).expect("connection"))
  match got {
    Ok(c) -> {
      c.setRequestMethod(method)
      c
    }
    Err(e) -> panic("test_connect: not an HttpURLConnection: " ++ e.message)
  }
}

# Test-only: Bytes as an InputStream (same round-trip as above).
fn test_stream_of(b: Bytes) -> InputStream !io = {
  let xs = ArrayList.new()
  xs.add(ByteArrayInputStream.new(b))
  let got: Result[InputStream, ForeignError] = cast(xs.get(0).expect("stream"))
  match got {
    Ok(s) -> s
    Err(e) -> panic("test_stream_of: not an InputStream: " ++ e.message)
  }
}

# Test-only: Bytes as a BodySource, through the real adapter.
fn test_source_of(b: Bytes) -> BodySource !io = input_source(test_stream_of(b))

# Test-only: a BodySource whose first read fails (see test_broken_stream).
fn test_broken_source() -> BodySource !io = input_source(test_broken_stream())

# Test-only: a ByteArrayOutputStream seen as an OutputStream (same round-trip).
# The caller keeps the ByteArrayOutputStream itself to read the bytes back —
# both names refer to the one object.
fn test_sink_of(b: ByteArrayOutputStream) -> OutputStream !io = {
  let xs = ArrayList.new()
  xs.add(b)
  let got: Result[OutputStream, ForeignError] = cast(xs.get(0).expect("stream"))
  match got {
    Ok(s) -> s
    Err(e) -> panic("test_sink_of: not an OutputStream: " ++ e.message)
  }
}

# Test-only: an InputStream whose first read fails, standing in for an upstream
# connection that broke mid-download. It is a closed FileInputStream because
# Dawn can neither subclass a Java type nor implement one of its interfaces
# under a name, so the only stream that throws is a JDK one made to.
fn test_broken_stream() -> InputStream !io = {
  let tmp = File.createTempFile("dawn-broken-", ".tmp")!
  let xs = ArrayList.new()
  xs.add(FileInputStream.new(tmp))
  let got: Result[InputStream, ForeignError] = cast(xs.get(0).expect("stream"))
  delete_quietly(String.valueOf(tmp.getPath()!)!)
  match got {
    Ok(s) -> {
      s.close()
      s
    }
    Err(e) -> panic("test_broken_stream: not an InputStream: " ++ e.message)
  }
}

# Test-only: one raw HTTP exchange over a plain socket, returned as text.
# The only client that will send `/a/../b` or a repeated header verbatim —
# HttpClient and HttpURLConnection normalize dot segments away before the
# bytes leave, which is exactly the behavior these tests must not inherit.
# Bounded like `raw_http_within`: a server that accepts and never answers is a
# red assertion naming the port, not a hung suite.
fn raw_http(port: Int, request: String) -> String !io = raw_http_within(port, request, RAW_HTTP_MS)

# Silence, in milliseconds, after which `raw_http` stops waiting.
const RAW_HTTP_MS: Int = 20000

# Test-only: the status-line check for raw responses. The test runner prints
# the asserted expression and never its operands, so a bare
# `assert str.starts_with(resp, ...)` that fails loses the response, and a
# one-off failure cannot be told apart from a real one. On a mismatch this
# panics with the port, the wanted prefix and the response as the client read
# it: line breaks escaped, capped at RAW_SHOW_CAP characters, and an empty
# response named as empty.
fn expect_status(port: Int, resp: String, want: String) -> Unit =
  if str.starts_with(resp, want) {
    ()
  } else {
    panic("port ${to_string(port)}: wanted a response starting with `${want}`, got ${show_raw(resp)}")
  }

const RAW_SHOW_CAP: Int = 2000

fn show_raw(resp: String) -> String =
  if str.is_empty(resp) {
    "<empty response>"
  } else {
    let esc = str.replace(str.replace(str.replace(resp, "\\", "\\\\"), "\r", "\\r"), "\n", "\\n")
    if len(str.chars(esc)) > RAW_SHOW_CAP {
      "`${str.take(esc, RAW_SHOW_CAP)}` (cut at ${to_string(RAW_SHOW_CAP)} characters)"
    } else {
      "`${esc}`"
    }
  }

# Test-only: the feature release of the running JVM (21, 26, ...), for the one
# test whose wire bytes depend on jdk.httpserver's version. The property is
# always set on a JVM; 0 stands for a value this cannot read.
fn jdk_feature() -> Int !io =
  match System.getProperty("java.specification.version") {
    Some(v) -> unwrap_or(parse_int(v), 0)
    None -> 0
  }

fn get_line(path: String) -> String =
  "GET " ++ path ++ " HTTP/1.1\r\nHost: t\r\nConnection: close\r\n\r\n"

fn hello_handler(_req: Request) -> Result[Response, HttpError] !io = Ok(text(200, "hello"))

fn no_content_handler(_req: Request) -> Result[Response, HttpError] !io = Ok(text(204, ""))

# Test-only: a handler that is a bug — the 500 path below is what the server
# renders for it.
fn boom_handler(_req: Request) -> Result[Response, HttpError] !io = panic("boom")

fn echo_name(req: Request) -> Result[Response, HttpError] !io =
  match param(req, "name") {
    Ok(v) -> Ok(text(200, v))
    Err(_) -> Ok(text(500, "missing capture"))
  }

# A tail-capture handler that shows the segment boundaries, so a test can tell
# a decoded slash inside a segment from a real one.
fn echo_rest(req: Request) -> Result[Response, HttpError] !io =
  Ok(text(200, join_with(param_segs(req, "rest"), "|")))

# A stand-in for with_cors, shaped the same way: it stamps both branches and
# skips a route tagged "no-cors". Written here rather than imported so that
# server.dawn does not take a dependency on middleware.dawn for a test; that
# with_cors turns "the chain ran" into Access-Control-* headers is middleware's
# own contract, tested there.
fn stamping(next: Handler) -> Handler =
  req =>
  if meta_has_tag(req.route, "no-cors") {
    next(req)
  } else {
    match next(req) {
      Ok(r) -> Ok(with_header(r, "X-Stamped", "1"))
      Err(e) -> Err(HttpError { ..e, headers = e.headers ++ [("X-Stamped", "1")] })
    }
  }

fn echo_cookies(req: Request) -> Result[Response, HttpError] !io =
  Ok(text(200, unwrap_or(header(req, "Cookie"), "-") ++ "|" ++ join_with(headers_all(req, "cookie"), ";")))

fn echo_tags(req: Request) -> Result[Response, HttpError] !io =
  Ok(text(200, unwrap_or(query(req, "tag"), "-") ++ "|" ++ join_with(query_all(req, "tag"), ";")))

test "body_length: -1 for no body, exact bytes for text/binary, 0 (chunked) for streams" {
  assert body_length(200, Empty) == -1
  assert body_length(200, Text("hello")) == 5
  # one byte is a length, not a rounding of "empty"
  assert body_length(200, Text("x")) == 1
  # UTF-8 bytes, not code points
  assert body_length(200, Text("中文")) == 6
  # an exact 0 cannot pass through sendResponseHeaders (0 = chunked there)
  assert body_length(200, Text("")) == -1
  assert body_length(200, Binary(bytes.utf8("abcd"))) == 4
  assert body_length(200, Binary(bytes.utf8(""))) == -1
  assert body_length(200, Stream(test_source_of(bytes.utf8("x")), None)) == 0
}

test "the four no-content status classes carry no body, whatever the handler built" {
  # 1xx (RFC 9110 §15.2), 204 (§15.3.5), 205 (§15.3.6), 304 (§15.4.5). Only
  # 204 and 304 used to be named here; 1xx and 205 were left to the JDK, which
  # forces the first and not the second.
  assert body_length(100, Text("hello")) == -1
  assert body_length(101, Binary(bytes.utf8("x"))) == -1
  assert body_length(199, Text("hello")) == -1
  assert body_length(204, Text("hello")) == -1
  assert body_length(205, Text("hello")) == -1
  assert body_length(304, Binary(bytes.utf8("x"))) == -1
  # a stream on one of these is dropped rather than pumped (see drop_body)
  assert body_length(100, Stream(test_source_of(bytes.utf8("x")), None)) == -1
  assert body_length(205, Stream(test_source_of(bytes.utf8("x")), None)) == -1
  # the neighbours are ordinary statuses and keep their bodies
  assert body_length(200, Text("hello")) == 5
  assert body_length(203, Text("hello")) == 5
  assert body_length(206, Text("hello")) == 5
  assert body_length(303, Text("hello")) == 5
  assert body_length(305, Text("hello")) == 5
}

# Test-only: handlers that build a response the constructors refuse.
fn interim_handler(_req: Request) -> Result[Response, HttpError] !io = Ok(text(100, "x"))

fn chunked_claim_handler(_req: Request) -> Result[Response, HttpError] !io =
  Ok(with_header(text(200, "hello"), "Transfer-Encoding", "chunked"))

test "a response the constructors refuse is a 500 inside the handler's isolation" {
  # web3 3.1.0 caught an illegal header at the write boundary and withheld the
  # response there. There is nothing left to catch: Response is opaque, the
  # refusal is a panic where it is built, and that is inside the handler, so
  # the ordinary per-request isolation renders it
  let routes = [route_get("/interim", interim_handler), route_get("/te", chunked_claim_handler)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  # a final 100 used to reach the wire, and the client waited for ever
  let interim = raw_http(port, get_line("/interim"))
  expect_status(port, interim, "HTTP/1.1 500")
  assert str.contains(interim, "{\"error\":\"internal server error\"}")
  # a Transfer-Encoding next to the JDK's Content-length never goes out
  let te = raw_http(port, get_line("/te"))
  expect_status(port, te, "HTTP/1.1 500")
  assert not str.contains(str.to_lower(te), "transfer-encoding")
  srv.stop(0)
}

test "Content-Length is exact per body kind on the wire; only streams are chunked" {
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/text", ex => write_response(ex, text(200, "hello")))
  srv.createContext("/cjk", ex => write_response(ex, text(200, "中文")))
  srv.createContext("/empty", ex => write_response(ex, text(200, "")))
  srv.createContext("/bin", ex => write_response(ex, binary(200, "application/octet-stream", bytes.utf8("abcd"))))
  srv.createContext("/stream", ex =>
      write_response(ex, streaming(200, "application/octet-stream", test_source_of(bytes.utf8("streamed")))))
  srv.start()
  let base = "http://127.0.0.1:${srv.getAddress()!.getPort()}"
  let t = test_connect("GET", base ++ "/text")
  assert t.getResponseCode() == 200
  assert t.getHeaderField("Content-Length") == Some("5")
  assert t.getInputStream()!.readAllBytes()! == bytes.utf8("hello")
  # the length counts UTF-8 bytes, not code points
  let c = test_connect("GET", base ++ "/cjk")
  assert c.getHeaderField("Content-Length") == Some("6")
  assert c.getInputStream()!.readAllBytes()! == bytes.utf8("中文")
  # an empty text body has an exact zero length, not chunked framing
  let e = test_connect("GET", base ++ "/empty")
  assert e.getResponseCode() == 200
  assert e.getHeaderField("Content-Length") == Some("0")
  assert e.getHeaderField("Transfer-encoding") == None
  let b = test_connect("GET", base ++ "/bin")
  assert b.getHeaderField("Content-Length") == Some("4")
  assert b.getInputStream()!.readAllBytes()! == bytes.utf8("abcd")
  # a stream's length is unknown: chunked, no Content-Length
  let s = test_connect("GET", base ++ "/stream")
  assert s.getHeaderField("Content-Length") == None
  assert s.getHeaderField("Transfer-encoding") == Some("chunked")
  assert s.getInputStream()!.readAllBytes()! == bytes.utf8("streamed")
  srv.stop(0)
}

test "204 sends no body, no Content-Length, no chunked framing" {
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => write_response(ex, text(204, "")))
  srv.start()
  let r = test_connect("GET", "http://127.0.0.1:${srv.getAddress()!.getPort()}/")
  assert r.getResponseCode() == 204
  assert r.getHeaderField("Content-Length") == None
  assert r.getHeaderField("Transfer-encoding") == None
  assert len(r.getInputStream()!.readAllBytes()!) == 0
  srv.stop(0)
}

test "205 sends no body either: the one no-content status the JDK does not force" {
  # jdk.httpserver's sendResponseHeaders forces 1xx, 204 and 304 to no body on
  # its own (WARNING: "forcing contentLen = -1"), but treats 205 as an ordinary
  # status. Until body_length named it, a 205 with a body really put the entity
  # on the wire, which RFC 9110 §15.3.6 says it MUST NOT.
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => write_response(ex, text(205, "must not travel")))
  srv.start()
  let port = srv.getAddress()!.getPort()
  let resp = raw_http(port, get_line("/"))
  expect_status(port, resp, "HTTP/1.1 205")
  assert not str.contains(resp, "must not travel")
  assert not str.contains(str.to_lower(resp), "transfer-encoding")
  srv.stop(0)
}

test "HEAD is served by the GET route: status and length, but no body bytes" {
  # full server path — dispatch (HEAD falls through to GET) + write_response
  let routes = [route_get("/hello", hello_handler), route_get("/gone", no_content_handler)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let base = "http://127.0.0.1:${srv.getAddress()!.getPort()}"
  let h = test_connect("HEAD", base ++ "/hello")
  assert h.getResponseCode() == 200
  # the length the GET would have had...
  assert h.getHeaderField("Content-Length") == Some("5")
  # ...but none of its body
  assert len(h.getInputStream()!.readAllBytes()!) == 0
  # the GET itself is unaffected
  let g = test_connect("GET", base ++ "/hello")
  assert g.getInputStream()!.readAllBytes()! == bytes.utf8("hello")
  # a HEAD of a 204 route is still a bare 204
  let n = test_connect("HEAD", base ++ "/gone")
  assert n.getResponseCode() == 204
  assert n.getHeaderField("Content-Length") == None
  # unrouted HEAD is a 404 like the GET would be (body suppressed by the HEAD branch)
  let m = test_connect("HEAD", base ++ "/nope")
  assert m.getResponseCode() == 404
  srv.stop(0)
}

test "write_response pumps an upstream stream to the client byte-exact (>8KB, multi-chunk)" {
  # The full realistic path: upstream HTTP -> ofInputStream + cast -> streaming() ->
  # write_response's stream branch -> copy_source pumps the source to the socket
  # -> close. 12000 bytes forces the 8KB chunk across more than one read.
  let payload = bytes.utf8(join_with(map(range(0, 1200), i => "0123456789"), ""))
  # upstream: serves the payload
  let up = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  up.createContext("/", ex => {
    ex.sendResponseHeaders(200, len(payload))
    let os = ex.getResponseBody()!
    os.write(payload)
    os.close()
  })
  up.start()
  let upurl = "http://127.0.0.1:${up.getAddress()!.getPort()}/"
  # download: proxies upstream as a live stream through write_response's stream branch
  let dn = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  dn.createContext("/", ex => {
    let (st, stream) = test_fetch_stream(upurl)
    write_response(ex, streaming(st, "application/octet-stream", input_source(stream)))
  })
  dn.start()
  let (st, got) = test_fetch_bytes("http://127.0.0.1:${dn.getAddress()!.getPort()}/")
  assert st == 200
  assert len(got) == 12000
  assert got == payload
  up.stop(0)
  dn.stop(0)
}

test "an InputStream source reads what is ready, in chunks no larger than asked, and ends with an empty read" {
  let big = bytes.utf8(join_with(map(range(0, 2000), i => "0123456789"), ""))
  let src = test_source_of(big)
  # 20000 bytes are ready, so a read of 8192 is 8192, not one byte
  assert len(src.read(0, 8192)) == 8192
  assert len(src.read(8192, 8192)) == 8192
  assert len(src.read(16384, 8192)) == 3616
  assert len(src.read(20000, 8192)) == 0
  # fewer ready than asked for: what there is, not a wait for more
  let small = test_source_of(bytes.utf8("abc"))
  assert small.read(0, 8192) == bytes.utf8("abc")
  assert len(small.read(3, 8192)) == 0
  # a read of one is one, and a read of zero or less is not a loop
  let one = test_source_of(bytes.utf8("xyz"))
  assert one.read(0, 1) == bytes.utf8("x")
  small.close()
  one.close()
  src.close()
}

test "pumping a streaming body tells EOF, a failed transfer and a panic apart" {
  # LIB-18: all three used to be one discarded Result, so a broken download and
  # a bug in this program both looked exactly like a request that ended well.
  # No socket is needed for any of them.
  let sink = ByteArrayOutputStream.new()
  assert pump_with(test_source_of(bytes.utf8("streamed")), None, up => copy_source(up, test_sink_of(sink))) ==
    Pumped
  assert sink.toByteArray().expect("bytes") == bytes.utf8("streamed")

  # an upstream that fails on read — the shape a client hanging up mid-download
  # also takes, which is why the log wording does not claim to know which
  let sink2 = ByteArrayOutputStream.new()
  match pump_with(test_broken_source(), None, up => copy_source(up, test_sink_of(sink2))) {
    TransferFailed(m) -> { assert m != "" }
    _ -> { assert false }
  }
  assert len(sink2.toByteArray().expect("bytes")) == 0

  # a bug in this program: not a java.lang.Exception, so it goes straight past
  # the inner catch_fault to the outer catch_panic (spec §9.8) with its message,
  # which ends with where the panic is written (spec 8.2)
  match pump_with(test_source_of(bytes.utf8("x")), None, _up => panic("pump bug")) {
    PumpPanicked(m) -> { assert str.starts_with(m, "pump bug at ") }
    _ -> { assert false }
  }
}

test "a stream of stated length that ends early is a truncation, not a success" {
  # the LIB-18 candidate: a clean EOF before the end used to be
  # indistinguishable from a complete transfer, because nothing said how long
  # the stream was meant to be
  let sink = ByteArrayOutputStream.new()
  assert pump_with(test_source_of(bytes.utf8("abc")), Some(10), up => copy_source(up, test_sink_of(sink))) ==
    Truncated(3, 10)
  # exactly the stated length is a clean finish
  let sink2 = ByteArrayOutputStream.new()
  assert pump_with(test_source_of(bytes.utf8("abc")), Some(3), up => copy_source(up, test_sink_of(sink2))) ==
    Pumped
  # an unsized stream has nothing to compare against, as before
  let sink3 = ByteArrayOutputStream.new()
  assert pump_with(test_source_of(bytes.utf8("abc")), None, up => copy_source(up, test_sink_of(sink3))) ==
    Pumped
  # the length also decides the framing: exact when stated, chunked when not
  assert body_length(200, Stream(test_source_of(bytes.utf8("x")), Some(5))) == 5
  assert body_length(200, Stream(test_source_of(bytes.utf8("x")), Some(0))) == -1
  assert body_length(204, Stream(test_source_of(bytes.utf8("x")), Some(5))) == -1
}

test "a stream's Content-Length is its stated length, and an unsized stream has none" {
  let sized = () => streaming(200, "video/mp4", test_source_of(bytes.utf8("abcd")), length = Some(4))
  let unsized = () => streaming(200, "video/mp4", test_source_of(bytes.utf8("abcd")))
  # the stated length is the one a handler may repeat
  match catch_panic(() => with_header(sized(), "Content-Length", "4")) {
    Ok(_) -> { assert true }
    Err(_) -> { assert false }
  }
  match catch_panic(() => with_header(sized(), "Content-Length", "5")) {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.starts_with(m.message, "header Content-Length says 5 but the body is 4 bytes at ") }
  }
  # next to chunked framing a Content-Length is the RFC 9112 §6.1 violation
  match catch_panic(() => with_header(unsized(), "Content-Length", "4")) {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.contains(m.message, "unknown length") }
  }
  # a byte count is not negative
  match catch_panic(() => streaming(200, "video/mp4", test_source_of(bytes.utf8("")), length = Some(-1))) {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.contains(m.message, "illegal stream length -1") }
  }
}

test "a sized stream goes out with its exact Content-Length, and a short one ends short" {
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/whole", ex =>
      write_response(ex, streaming(200, "application/octet-stream", test_source_of(bytes.utf8("streamed")), length = Some(8))))
  srv.createContext("/short", ex =>
      write_response(ex, streaming(200, "application/octet-stream", test_source_of(bytes.utf8("abc")), length = Some(10))))
  srv.start()
  let port = srv.getAddress()!.getPort()
  let whole = test_connect("GET", "http://127.0.0.1:${port}/whole")
  assert whole.getHeaderField("Content-Length") == Some("8")
  assert whole.getHeaderField("Transfer-encoding") == None
  assert whole.getInputStream()!.readAllBytes()! == bytes.utf8("streamed")
  # The short stream promises ten bytes and has three. Either way the client
  # can see it was cut short, which a chunked stream ending the same way would
  # have hidden behind its last chunk; what it sees depends on the JDK.
  #
  # Through JDK 22, sendResponseHeaders flushed the headers and the body went
  # to the socket unbuffered, so the promise is on the wire before the upstream
  # runs dry and the connection ends three bytes into ten. JDK 23 (JDK-6968351,
  # "HttpServer No Longer Immediately Sends Response Headers") buffers headers
  # and a small body together, and the JDK's fixed-length stream, closed short,
  # closes the connection without flushing that buffer: the client gets no
  # bytes at all, a connection that ends before any response. Both are the
  # truncation made visible; neither is a complete response, which is what
  # this test forbids. The branch is on the running JDK so that each side still
  # pins one exact outcome rather than accepting either.
  let short = raw_http(port, get_line("/short"))
  if jdk_feature() >= 23 {
    assert short == ""
  } else {
    expect_status(port, short, "HTTP/1.1 200")
    assert str.contains(str.to_lower(short), "content-length: 10")
    assert str.ends_with(short, "\r\n\r\nabc")
  }
  srv.stop(0)
}

test "%2F stays inside its segment: /files/a%2Fb reaches /files/{name} as a/b" {
  let routes = [route_get("/files/{name}", echo_name), route_get("/a/b", hello_handler)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let base = "http://127.0.0.1:${srv.getAddress()!.getPort()}"
  # the old decoded-path dispatch saw /files/a/b here: three segments, a 404
  let (st, body) = test_fetch_bytes(base ++ "/files/a%2Fb")
  assert st == 200
  assert body == bytes.utf8("a/b")
  # an ordinary encoded segment still decodes into its capture
  let (st2, b2) = test_fetch_bytes(base ++ "/files/%E4%B8%AD%E6%96%87")
  assert st2 == 200
  assert b2 == bytes.utf8("中文")
  # a duplicate slash is a real (empty) segment: /a//b is not /a/b
  let (st3, _) = test_fetch_bytes(base ++ "/a//b")
  assert st3 == 404
  srv.stop(0)
}

test "a tail capture reaches the handler as segments, so %2F survives it" {
  # the WebDAV route shape. Under the joined tail capture both requests below
  # arrived as the one string "a/b/c" and the handler served the same file for
  # two different URLs; now it gets ["a/b", "c"] and ["a", "b", "c"].
  let routes = [route_get("/dav/{rest*}", echo_rest)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let base = "http://127.0.0.1:${srv.getAddress()!.getPort()}"
  let (st, body) = test_fetch_bytes(base ++ "/dav/a%2Fb/c")
  assert st == 200
  assert body == bytes.utf8("a/b|c")
  let (st2, body2) = test_fetch_bytes(base ++ "/dav/a/b/c")
  assert st2 == 200
  assert body2 == bytes.utf8("a|b|c")
  # the bare prefix captures nothing at all, and is still a match
  let (st3, body3) = test_fetch_bytes(base ++ "/dav")
  assert st3 == 200
  assert body3 == bytes.utf8("")
  srv.stop(0)
}

test "param refuses to read a tail capture as one string" {
  let req = Request {
    method = "GET", path = "/dav/a/b", raw_path = "/dav/a/b",
    params = map.from([("rest", ["a/b", "c"]), ("id", ["7"])]),
    query = map.empty(), headers = map.empty(), body = bytes.utf8(""),
    body_file = None, route = None,
  }
  # a single-segment capture reads exactly as before
  assert param(req, "id") == Ok("7")
  assert param_segs(req, "rest") == ["a/b", "c"]
  # ...and the reader that would have to join is the one that says so, rather
  # than quietly picking one of the segments
  match param(req, "rest") {
    Err(e) -> {
      assert e.status == 500
      assert str.contains(e.message, "param_segs")
    }
    Ok(_) -> { assert false }
  }
}

test "dot segments are 400 before routing, on routed and unrouted paths alike" {
  let routes = [route_get("/b", hello_handler)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  # would normalize to the routed /b — refused instead, which proves the check
  # sits before routing (a normalizer would 200, plain routing would 404)
  expect_status(port, raw_http(port, get_line("/a/../b")), "HTTP/1.1 400")
  # the encoded spelling is the classic normalization bypass
  expect_status(port, raw_http(port, get_line("/%2e%2e/b")), "HTTP/1.1 400")
  expect_status(port, raw_http(port, get_line("/a/./b")), "HTTP/1.1 400")
  # a path no route matches is still refused with 400, not 404
  expect_status(port, raw_http(port, get_line("/zzz/../q")), "HTTP/1.1 400")
  # sanity: the clean path still routes
  expect_status(port, raw_http(port, get_line("/b")), "HTTP/1.1 200")
  srv.stop(0)
}

test "the early 400 and 413 go through the middleware chain, so they carry CORS" {
  # LIB-10: both refusals happen before the body is read and used to happen
  # before the middleware too, so a cross-origin 400/413 arrived with no
  # Access-Control-* at all and the browser would not let the page read it.
  let routes = [route_post("/p", hello_handler), route_get("/b", hello_handler)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  # max_body 4, so a five-byte body is refused before it is read
  srv.createContext("/", ex => handle(routes, [stamping], 4, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()

  # the response text is lowercased before the header check: jdk.httpserver
  # title-cases the names it writes, so `X-Stamped` goes out as `X-stamped`
  let dot = raw_http(port, get_line("/a/../b"))
  expect_status(port, dot, "HTTP/1.1 400")
  assert str.contains(str.to_lower(dot), "x-stamped: 1")

  let big = raw_http(port,
    "POST /p HTTP/1.1\r\nHost: t\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello")
  expect_status(port, big, "HTTP/1.1 413")
  assert str.contains(str.to_lower(big), "x-stamped: 1")

  # and an ordinary answer is unchanged
  let ok = raw_http(port, get_line("/b"))
  expect_status(port, ok, "HTTP/1.1 200")
  assert str.contains(str.to_lower(ok), "x-stamped: 1")
  srv.stop(0)
}

test "an early refusal on a no-cors route is not stamped" {
  # the dot-segment check runs after dispatch precisely so this holds: a WebDAV
  # path is no-cors whether or not it contains a dot segment, and the refusal
  # must not be the one answer on that route that carries CORS headers
  let routes = [tagged(route_get("/dav/{rest*}", hello_handler), ["no-cors"])]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [stamping], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  let resp = raw_http(port, get_line("/dav/../secret"))
  expect_status(port, resp, "HTTP/1.1 400")
  assert not str.contains(str.to_lower(resp), "x-stamped")
  srv.stop(0)
}

test "two Cookie headers both arrive: header() the first, headers_all both" {
  let routes = [route_get("/c", echo_cookies)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  let resp = raw_http(port,
    "GET /c HTTP/1.1\r\nHost: t\r\nCookie: a=1\r\nCookie: b=2\r\nConnection: close\r\n\r\n")
  expect_status(port, resp, "HTTP/1.1 200")
  assert str.contains(resp, "a=1|a=1;b=2")
  srv.stop(0)
}

test "a query parameter repeated on the wire arrives whole" {
  let routes = [route_get("/q", echo_tags)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  # `?tag=a&tag=b` used to reach the handler as just "b"
  let resp = raw_http(port, get_line("/q?tag=a&tag=b"))
  expect_status(port, resp, "HTTP/1.1 200")
  assert str.contains(resp, "a|a;b")
  # a single value is unchanged, and query() still answers it
  assert str.contains(raw_http(port, get_line("/q?tag=only")), "only|only")
  # absent: neither view invents anything
  assert str.contains(raw_http(port, get_line("/q")), "-|")
  srv.stop(0)
}

test "lifecycle: port 0 binds a real port, serves, and join returns after stop" {
  let cfg = ServerConfig { host = "127.0.0.1", port = 0, max_body = DEFAULT_MAX_BODY, errors = default_errors() }
  let h = start(cfg, [route_get("/hello", hello_handler)], [])
  # the OS picked the port; the handle reports the real one, and it works
  assert handle_port(h) > 0
  let (st, body) = test_fetch_bytes("http://127.0.0.1:${handle_port(h)}/hello")
  assert st == 200
  assert body == bytes.utf8("hello")
  stop(h, 0)
  # stop released the latch: join returns instead of blocking forever
  join(h)
  # and the listener really closed — a fresh connection is refused
  match catch_fault(() => Socket.new("127.0.0.1", handle_port(h))) {
    Ok(s) -> {
      s.close()
      assert false
    }
    Err(_) -> ()
  }
}

test "stop shuts the request executor down, and does so even if the JDK's stop throws" {
  let cfg = ServerConfig { host = "127.0.0.1", port = 0, max_body = DEFAULT_MAX_BODY, errors = default_errors() }
  let h = start(cfg, [route_get("/hello", hello_handler)], [])
  let rep: ServerHandleRep = h
  # the pool is live while the server is: it answers a request on it
  assert rep.executor.isShutdown() == false
  let (st, _b) = test_fetch_bytes("http://127.0.0.1:${handle_port(h)}/hello")
  assert st == 200
  stop(h, 0)
  # ...and the handle owns it, so stopping the server shut it down. Before it
  # was in the handle nothing ever did, and each start/stop cycle left one.
  assert rep.executor.isShutdown() == true

  # the release is bracketed, so a failing server.stop still shuts the pool
  # down and still opens the latch. `stop(grace)` with a negative grace is the
  # JDK's own documented IllegalArgumentException, so no fake is needed.
  let h2 = start(cfg, [route_get("/hello", hello_handler)], [])
  let rep2: ServerHandleRep = h2
  match catch_fault(() => stop(h2, -1)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  assert rep2.executor.isShutdown() == true
  # the latch opened too: join returns rather than blocking forever
  join(h2)
  # shutting the executor down leaves the JDK server unstopped, so close the
  # listener before the test ends
  rep2.server.stop(0)
}

test "start refuses a body ceiling that is not positive" {
  # 0 used to switch the ceiling off; now it is a config error at startup
  for bad in [0, -1] {
    let cfg = ServerConfig { host = "127.0.0.1", port = 0, max_body = bad, errors = default_errors() }
    match catch_panic(() => start(cfg, [route_get("/hello", hello_handler)], [])) {
      Ok(_) -> { assert false }
      Err(m) -> { assert str.contains(m.message, "max_body must be a positive byte count") }
    }
  }
}

test "start refuses a broken route table before binding a socket" {
  let cfg = ServerConfig { host = "127.0.0.1", port = 0, max_body = DEFAULT_MAX_BODY, errors = default_errors() }
  let r = catch_panic(() => start(cfg, [route_get("/a/{unclosed", hello_handler)], []))
  match r {
    Ok(_) -> {
      assert false
    }
    Err(m) -> {
      assert str.contains(m.message, "route table")
    }
  }
}

test "a panic is a 500 the application words: default, then configured" {
  let routes = [route_get("/boom", boom_handler)]
  # default: neutral English under the neutral key
  let a = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  a.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  a.start()
  let pa = a.getAddress()!.getPort()
  let ra = raw_http(pa, get_line("/boom"))
  expect_status(pa, ra, "HTTP/1.1 500")
  assert str.contains(ra, "{\"error\":\"internal server error\"}")
  a.stop(0)
  # configured: the bytes this framework used to emit unconditionally, which
  # one application's frontend reads (FastAPI's key, its own 500 text)
  let fastapi = ErrorFormat {
    ..default_errors(), detail_key = "detail", internal_message = "服务器内部错误", param_separator = "：",
  }
  let b = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  b.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, fastapi, ex))
  b.start()
  let pb = b.getAddress()!.getPort()
  let rb = raw_http(pb, get_line("/boom"))
  expect_status(pb, rb, "HTTP/1.1 500")
  assert str.contains(rb, "{\"detail\":\"服务器内部错误\"}")
  # a 404 the server renders itself takes the same key
  let r404 = raw_http(pb, get_line("/nope"))
  expect_status(pb, r404, "HTTP/1.1 404")
  assert str.contains(r404, "\"detail\"")
  b.stop(0)
}

# A temp file this test owns, so it can look at the path afterwards and say
# whether the spill left anything behind.
fn a_temp_file() -> File !io = File.createTempFile("dawn-spill-test-", ".tmp")!

fn file_exists(path: String) -> Bool !io = File.new(path).exists()

# Test-only: a raw POST whose body bytes the caller controls exactly — the one
# client here that will put invalid UTF-8 on the wire (HttpClient publishers
# all start from Strings or files this test would have to write).
fn post_bytes(port: Int, path: String, body: Bytes) -> String !io = {
  let s = Socket.new("127.0.0.1", port)
  let out = s.getOutputStream()!
  out.write(bytes.utf8("POST " ++ path ++ " HTTP/1.1\r\nHost: t\r\nContent-Length: ${to_string(len(body))}\r\nConnection: close\r\n\r\n"))
  out.write(body)
  out.flush()
  let resp = bytes.decode_utf8_lossy(s.getInputStream()!.readAllBytes()!)
  s.close()
  resp
}

# The shape every JSON/form route has now: take the UTF-8 view, let `?`
# propagate the 400 for a body that has none.
fn echo_body_text(req: Request) -> Result[Response, HttpError] !io = {
  let s = body_text(req)?
  Ok(text(200, s))
}

test "an invalid UTF-8 body on a text route is a 400 naming the offset" {
  # Under the old lossy `body: String` this request was silently accepted: the
  # handler saw "a\u{FFFD}b" and answered 200, and nothing anywhere could tell
  # the substitution from a U+FFFD the client really sent.
  let routes = [route_post("/t", echo_body_text)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  # 61 FF 62: 'a', an invalid byte, 'b' — one clean byte, so the offset is 1
  let bad = bytes.freeze(bytes.put(bytes.put(bytes.put(bytes.buf(), 0x61), 0xFF), 0x62))
  let refused = post_bytes(port, "/t", bad)
  expect_status(port, refused, "HTTP/1.1 400")
  assert str.contains(refused, "request body is not valid UTF-8 (offset 1)")
  # the same route under a valid body is untouched, byte-exact CJK included
  let ok = post_bytes(port, "/t", bytes.utf8("中文ok"))
  expect_status(port, ok, "HTTP/1.1 200")
  assert str.contains(ok, "中文ok")
  srv.stop(0)
}

test "an interrupted spill deletes its temp file instead of leaking it" {
  let tmp = a_temp_file()
  let path = String.valueOf(tmp.getPath()!)!
  # transferTo throws when a client hangs up mid-PUT; the bracket underneath
  # owns only the output stream, so the file used to survive every such upload
  match spill_with(default_errors(), () => tmp, _out => panic("client hung up mid-upload")) {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.status == 500 }
  }
  assert file_exists(path) == false
}

test "a completed spill hands its path over, and the Request is what drops it" {
  let tmp = a_temp_file()
  let path = String.valueOf(tmp.getPath()!)!
  match spill_with(default_errors(), () => tmp, out => {
    out.write(bytes.utf8("hello"))
    Ok(())
  }) {
    Err(_) -> { assert false }
    Ok(p) -> {
      # ownership transferred: the file is still there, and it is the caller's
      assert p == path
      assert file_exists(p)
      # ... and the Request holding it is what releases it (`drop_body_file` is
      # the bracket release `handle` installs around the handler call)
      drop_body_file(Request {
        method = "PUT", path = "/x", raw_path = "/x", params = map.empty(), query = map.empty(),
        headers = map.empty(), body = bytes.utf8(""), body_file = Some(p), route = None,
      })
      assert file_exists(p) == false
    }
  }
}

# ---- per-route body ceiling and pre-body guard (5.1) ----

# Test-only: the names of the spill files in the JVM's temp directory right
# now. A spill that left something behind shows up as a name in the second
# snapshot that the first one lacks.
fn spill_files() -> List[String] !io = {
  let dir = unwrap_or(System.getProperty("java.io.tmpdir"), "/tmp")
  match with_fs_real(() => list_dir(dir)) {
    Ok(names) -> filter(names, n => str.starts_with(n, "dawn-put-"))
    Err(e) -> panic("spill_files: " ++ e.message)
  }
}

fn new_since(before: List[String], after: List[String]) -> List[String] =
  filter(after, n => list.find(before, b => b == n) == None)

# Test-only: a request whose body goes out chunked, with no Content-Length, so
# the server cannot refuse it on the declared length and has to count.
fn send_chunked(port: Int, method: String, path: String, extra: String, body: String) -> String !io = {
  let n = len(bytes.utf8(body))
  raw_http(port,
    method ++ " " ++ path ++ " HTTP/1.1\r\nHost: t\r\n" ++ extra ++
      "Transfer-Encoding: chunked\r\nConnection: close\r\n\r\n" ++
      String.valueOf(Long.toHexString(n)!)! ++ "\r\n" ++ body ++ "\r\n0\r\n\r\n")
}

# Test-only: a request with an exact Content-Length.
fn send_sized(port: Int, method: String, path: String, extra: String, body: String) -> String !io =
  raw_http(port,
    method ++ " " ++ path ++ " HTTP/1.1\r\nHost: t\r\n" ++ extra ++
      "Content-Length: ${to_string(len(bytes.utf8(body)))}\r\nConnection: close\r\n\r\n" ++ body)

# A stream-body handler that reports how much landed on disk.
fn spilled_size(req: Request) -> Result[Response, HttpError] !io =
  match req.body_file {
    Some(p) -> Ok(text(200, "size=${to_string(File.new(p).length())}"))
    None -> Ok(text(500, "no body file"))
  }

# The guard shape a WebDAV PUT wants: credentials first, and the path is read
# off the captures the server filled in.
fn need_token(req: Request) -> Result[Unit, HttpError] !io =
  if header(req, "Authorization") != Some("Bearer ok") {
    Err(HttpError { ..http_error(401, "unauthorized"), headers = [("WWW-Authenticate", "Bearer")] })
  } else if param_segs(req, "rest") == ["locked"] {
    Err(http_error(403, "locked"))
  } else {
    Ok(())
  }

fn panicking_guard(_req: Request) -> Result[Unit, HttpError] !io = panic("guard bug")

test "a counted spill stops past the ceiling with a 413 and deletes its file" {
  let tmp = a_temp_file()
  let path = String.valueOf(tmp.getPath()!)!
  # more than one chunk, so the count crosses the ceiling mid-stream
  let over = bytes.utf8(str.repeat("x", 20000))
  match spill_with(default_errors(), () => tmp, out => copy_bounded(default_errors(), test_stream_of(over), out, Some(10000))) {
    Ok(_) -> { assert false }
    Err(e) -> {
      assert e.status == 413
      assert e.message == "request body exceeds 10000 bytes"
    }
  }
  assert file_exists(path) == false
  # exactly the ceiling is accepted, byte for byte
  let tmp2 = a_temp_file()
  let exact = bytes.utf8(str.repeat("y", 10000))
  match spill_with(default_errors(), () => tmp2, out => copy_bounded(default_errors(), test_stream_of(exact), out, Some(10000))) {
    Err(_) -> { assert false }
    Ok(p) -> {
      assert File.new(p).length() == 10000
      delete_quietly(p)
    }
  }
}

test "a stream-body route's body_limit is a 413 that leaves no temp file" {
  let routes = [
    body_limit(tagged(route_put("/up", spilled_size), ["raw-body", "stream-body"]), 10),
    tagged(route_put("/free", spilled_size), ["raw-body", "stream-body"]),
  ]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [stamping], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  let before = spill_files()
  # exactly the ceiling reaches the handler, all of it on disk
  let ok = send_chunked(port, "PUT", "/up", "", "0123456789")
  expect_status(port, ok, "HTTP/1.1 200")
  assert str.contains(ok, "size=10")
  # one byte over with no Content-Length: counted during the spill
  let counted = send_chunked(port, "PUT", "/up", "", "0123456789A")
  expect_status(port, counted, "HTTP/1.1 413")
  assert str.contains(counted, "request body exceeds 10 bytes")
  assert str.contains(str.to_lower(counted), "x-stamped: 1")
  # far over, across several spill chunks
  expect_status(port, send_chunked(port, "PUT", "/up", "", str.repeat("z", 20000)), "HTTP/1.1 413")
  # one byte over by Content-Length: refused before the temp file exists
  expect_status(port, send_sized(port, "PUT", "/up", "", "0123456789A"), "HTTP/1.1 413")
  # a stream-body route with no ceiling of its own is unbounded, as before
  assert str.contains(send_chunked(port, "PUT", "/free", "", "0123456789A"), "size=11")
  srv.stop(0)
  assert new_since(before, spill_files()) == []
}

test "a guard's refusal is answered before the body is read, through the middleware" {
  let routes = [
    guarded(body_limit(tagged(route_put("/dav/{rest*}", spilled_size), ["raw-body", "stream-body"]), 10), need_token),
    guarded(route_post("/p", hello_handler), need_token),
    guarded(route_post("/bug", hello_handler), panicking_guard),
  ]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  # max_body 4, so the five-byte POST below is over the server's ceiling too
  srv.createContext("/", ex => handle(routes, [stamping], 4, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  let before = spill_files()
  # anonymous and over the route's ceiling: the guard's 401 wins over the 413,
  # which is only possible if the guard ran before anything counted the body
  let anon = send_sized(port, "PUT", "/dav/a.txt", "", "0123456789A")
  expect_status(port, anon, "HTTP/1.1 401")
  assert str.contains(str.to_lower(anon), "www-authenticate: bearer")
  assert str.contains(str.to_lower(anon), "x-stamped: 1")
  let anon_chunked = send_chunked(port, "PUT", "/dav/a.txt", "", str.repeat("z", 20000))
  expect_status(port, anon_chunked, "HTTP/1.1 401")
  # the guard sees the captures
  let locked = send_sized(port, "PUT", "/dav/locked", "Authorization: Bearer ok\r\n", "abc")
  expect_status(port, locked, "HTTP/1.1 403")
  # with credentials the body is spilled and the handler runs
  let ok = send_sized(port, "PUT", "/dav/a.txt", "Authorization: Bearer ok\r\n", "hello")
  expect_status(port, ok, "HTTP/1.1 200")
  assert str.contains(ok, "size=5")
  # an in-memory route: 401 rather than the 413 its five bytes would earn
  let mem = send_sized(port, "POST", "/p", "", "hello")
  expect_status(port, mem, "HTTP/1.1 401")
  assert str.contains(str.to_lower(mem), "x-stamped: 1")
  # a guard that panics is the application's 500, still through the chain
  let bug = send_sized(port, "POST", "/bug", "", "")
  expect_status(port, bug, "HTTP/1.1 500")
  assert str.contains(str.to_lower(bug), "x-stamped: 1")
  srv.stop(0)
  assert new_since(before, spill_files()) == []
}

test "an in-memory route's body_limit replaces max_body, in both directions" {
  let routes = [
    body_limit(route_post("/raised", echo_body_text), 16),
    body_limit(route_post("/lowered", echo_body_text), 4),
    body_limit(tagged(route_post("/raw-capped", echo_body_text), ["raw-body"]), 4),
    tagged(route_post("/raw", echo_body_text), ["raw-body"]),
    route_post("/plain", echo_body_text),
  ]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], 8, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  # raised: twelve bytes are over the server's 8 and under the route's 16
  expect_status(port, send_sized(port, "POST", "/raised", "", "twelve bytes"), "HTTP/1.1 200")
  expect_status(port, send_sized(port, "POST", "/raised", "", str.repeat("r", 17)), "HTTP/1.1 413")
  # lowered: five bytes are under the server's 8 and over the route's 4
  let low = send_sized(port, "POST", "/lowered", "", "hello")
  expect_status(port, low, "HTTP/1.1 413")
  assert str.contains(low, "request body exceeds 4 bytes")
  expect_status(port, send_chunked(port, "POST", "/lowered", "", "hello"), "HTTP/1.1 413")
  expect_status(port, send_sized(port, "POST", "/lowered", "", "four"), "HTTP/1.1 200")
  # a raw-body route is unbounded unless it sets a ceiling
  expect_status(port, send_sized(port, "POST", "/raw-capped", "", "hello"), "HTTP/1.1 413")
  expect_status(port, send_sized(port, "POST", "/raw", "", "twelve bytes"), "HTTP/1.1 200")
  # and a route with neither keeps the server's ceiling
  expect_status(port, send_sized(port, "POST", "/plain", "", "twelve bytes"), "HTTP/1.1 413")
  srv.stop(0)
}

# One wording for every refusal the framework decides itself, all of them
# visibly not the defaults, so a test can tell which source a body came from.
fn custom_errors() -> ErrorFormat =
  ErrorFormat {
    ..default_errors(),
    body_too_large = n => "too big, limit ${n}",
    not_found = "no such page",
    method_not_allowed = "wrong verb",
    dot_segment = "no dots",
  }

test "a custom ErrorFormat words all three 413 sites" {
  let routes = [
    body_limit(route_post("/mem", echo_body_text), 4),
    body_limit(tagged(route_put("/up", spilled_size), ["raw-body", "stream-body"]), 10),
  ]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, custom_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  let before = spill_files()
  # in memory, refused on the declared length before anything is read
  let early = send_sized(port, "POST", "/mem", "", "hello")
  expect_status(port, early, "HTTP/1.1 413")
  assert str.contains(early, "too big, limit 4")
  assert not str.contains(early, "request body exceeds")
  # in memory, no length declared, so the read itself finds the overrun
  let read = send_chunked(port, "POST", "/mem", "", "hello")
  expect_status(port, read, "HTTP/1.1 413")
  assert str.contains(read, "too big, limit 4")
  # stream body, refused on Content-Length before the temp file exists
  let pre = send_sized(port, "PUT", "/up", "", "0123456789A")
  expect_status(port, pre, "HTTP/1.1 413")
  assert str.contains(pre, "too big, limit 10")
  assert not str.contains(pre, "request body exceeds")
  # stream body, no length declared, counted during the spill
  let counted = send_chunked(port, "PUT", "/up", "", "0123456789A")
  expect_status(port, counted, "HTTP/1.1 413")
  assert str.contains(counted, "too big, limit 10")
  assert not str.contains(counted, "request body exceeds")
  srv.stop(0)
  assert new_since(before, spill_files()) == []
}

test "a request body the JDK cannot read is a 400, in memory and spilled, and a spill leaves no file" {
  # It used to be a 500: the stream's exception went up as a panic. A chunk size
  # that is not hex and a body that ends before its Content-Length are the
  # client's malformed request, answered as web/exchange answers them, in the
  # same words (scripts/web-exchange-contract holds the two to that).
  let routes = [route_post("/mem", echo_body_text), tagged(route_put("/up", spilled_size), ["stream-body"])]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  let before = spill_files()
  let bad_chunk = "Transfer-Encoding: chunked\r\nConnection: close\r\n\r\nzz\r\nhello\r\n0\r\n\r\n"
  let mem = raw_http(port, "POST /mem HTTP/1.1\r\nHost: t\r\n" ++ bad_chunk)
  expect_status(port, mem, "HTTP/1.1 400")
  assert str.contains(mem, "{\"error\":\"malformed request body\"}")
  let up = raw_http(port, "PUT /up HTTP/1.1\r\nHost: t\r\n" ++ bad_chunk)
  expect_status(port, up, "HTTP/1.1 400")
  assert str.contains(up, "{\"error\":\"malformed request body\"}")
  srv.stop(0)
  assert new_since(before, spill_files()) == []
}

test "a custom ErrorFormat words the 404, the 405 and the dot-segment 400" {
  let routes = [route_get("/b", hello_handler)]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, custom_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  let r404 = raw_http(port, get_line("/nope"))
  expect_status(port, r404, "HTTP/1.1 404")
  assert str.contains(r404, "{\"error\":\"no such page\"}")
  let r405 = send_sized(port, "POST", "/b", "", "")
  expect_status(port, r405, "HTTP/1.1 405")
  assert str.contains(r405, "{\"error\":\"wrong verb\"}")
  let r400 = raw_http(port, get_line("/a/../b"))
  expect_status(port, r400, "HTTP/1.1 400")
  assert str.contains(r400, "{\"error\":\"no dots\"}")
  srv.stop(0)
}

# Test-only: `raw_http` that gives up after `ms` milliseconds of silence, so a
# server that never answers is a red assertion and not a hung suite.
fn raw_http_within(port: Int, request: String, ms: Int) -> String !io = {
  let s = Socket.new("127.0.0.1", port)
  s.setSoTimeout(ms)
  let out = s.getOutputStream()!
  out.write(bytes.utf8(request))
  out.flush()
  let got = catch_fault(() => bytes.decode_utf8_lossy(s.getInputStream()!.readAllBytes()!))
  s.close()
  match got {
    Ok(r) -> r
    Err(_) -> "<no response>"
  }
}

test "a status mismatch names the port and shows the response, silence included" {
  # the negative control for expect_status: a listener that is never accepted
  # from takes the request into its backlog and answers nothing
  let silent = ServerSocket.new(0)
  let port = silent.getLocalPort()
  let resp = raw_http_within(port, get_line("/x"), 300)
  match catch_panic(() => expect_status(port, resp, "HTTP/1.1 200")) {
    Ok(_) -> { assert false }
    Err(m) -> {
      assert str.contains(m.message, "port ${to_string(port)}")
      assert str.contains(m.message, "HTTP/1.1 200")
      assert str.contains(m.message, "<no response>")
    }
  }
  # empty and long responses, escaped and capped
  match catch_panic(() => expect_status(7, "", "HTTP/1.1 200")) {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.contains(m.message, "port 7: ") && str.contains(m.message, "<empty response>") }
  }
  match catch_panic(() => expect_status(7, "HTTP/1.1 404\r\n" ++ str.repeat("z", 5000), "HTTP/1.1 200")) {
    Ok(_) -> { assert false }
    Err(m) -> {
      assert str.contains(m.message, "HTTP/1.1 404\\r\\nzzz")
      assert str.contains(m.message, "cut at 2000")
      assert len(m.message) < 2300
    }
  }
  silent.close()
}

# Test-only: a handler that ends in a JVM Error rather than a panic. An array
# of Int.MAX elements is past the VM's limit whatever the heap, so this throws
# OutOfMemoryError at once without using any memory.
fn fatal_handler(_req: Request) -> Result[Response, HttpError] !io = {
  let xs = ArrayList.new(2147483647)
  Ok(text(200, "unreachable ${xs.size()}"))
}

test "a JVM Error in a handler still answers 500 and closes the exchange" {
  let cfg = ServerConfig { host = "127.0.0.1", port = 0, max_body = DEFAULT_MAX_BODY, errors = default_errors() }
  let h = start(cfg, [route_get("/fatal", fatal_handler), route_get("/hello", hello_handler)], [])
  let port = handle_port(h)
  # catch_panic does not see an Error, so this request used to get nothing:
  # no response, and an exchange nobody closed
  let fatal = raw_http_within(port, get_line("/fatal"), 10000)
  expect_status(port, fatal, "HTTP/1.1 500")
  assert str.contains(fatal, "{\"error\":\"internal server error\"}")
  # and the server goes on answering
  expect_status(port, raw_http_within(port, get_line("/hello"), 10000), "HTTP/1.1 200")
  stop(h, 0)
}

# Test-only: a handler that puts characters above U+00FF into a header. The
# JDK writes the low byte of each, and those two lows are CR and LF.
fn split_header_handler(_req: Request) -> Result[Response, HttpError] !io =
  Ok(with_header(text(200, "ok"), "X-Name", "a\u{010d}\u{010a}X-Injected: 1"))

fn split_redirect_handler(_req: Request) -> Result[Response, HttpError] !io =
  Ok(try_redirect(302, "/a\u{010d}\u{010a}X-Injected: 1")?)

fn split_type_handler(_req: Request) -> Result[Response, HttpError] !io =
  Ok(raw(200, "text/plain\u{010d}\u{010a}X-Injected: 1", "ok"))

test "no header line reaches the wire that the handler did not write" {
  let routes = [
    route_get("/h", split_header_handler),
    route_get("/r", split_redirect_handler),
    route_get("/t", split_type_handler),
  ]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let port = srv.getAddress()!.getPort()
  for (path, status) in [("/h", "500"), ("/r", "400"), ("/t", "500")] {
    let resp = raw_http_within(port, get_line(path), 10000)
    assert not str.contains(resp, "\r\nX-Injected")
    expect_status(port, resp, "HTTP/1.1 " ++ status)
  }
  srv.stop(0)
}

fn status_of(url: String) -> Int !io = {
  let (st, _) = test_fetch_bytes(url)
  st
}

test "an encoded slash cannot smuggle `..` into a file path through safe_rel" {
  # the whole-segment check passes `..%2F..%2Fetc`, which decodes to one
  # segment, and the handler sees it whole; safe_rel is what refuses it
  let routes = [route_get("/files/{rest*}", (req: Request) => {
    let p = safe_rel(param_segs(req, "rest"))?
    Ok(text(200, "file " ++ p))
  })]
  let srv = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  srv.createContext("/", ex => handle(routes, [], DEFAULT_MAX_BODY, default_errors(), ex))
  srv.start()
  let base = "http://127.0.0.1:${srv.getAddress()!.getPort()}/files/"
  let (st, body) = test_fetch_bytes(base ++ "a/b.txt")
  assert st == 200
  assert body == bytes.utf8("file a/b.txt")
  assert status_of(base ++ "..%2F..%2Fetc") == 400
  assert status_of(base ++ "a/..%2Fb") == 400
  assert status_of(base ++ "a%5Cb") == 400
  assert status_of(base ++ "a%00") == 400
  srv.stop(0)
}

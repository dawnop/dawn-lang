# fspath — text operations on POSIX paths.
#
# A package and not a std module (audit RD-09): nothing in the language is
# defined in terms of a path, no lowering reaches here, and a std module is
# carried by every program whether it wants one or not. It was in std because
# the compiler needed two of these functions the day the module was written --
# a reason to write it, not a reason to bundle it.
#
# > **Two copies exist, deliberately.** `selfhost/src/fspath.dawn` holds the
# > four functions the compiler itself uses, because the compiler cannot take a
# > package dependency -- it is what resolves them. That copy is a subset and
# > not a fork: this file is the user-facing one, and a change here belongs in
# > both. See RD-09 in docs/audit/re-audit-2026-07-30.md.
#
# Named `fspath` and not `path` because Dawn puts an imported module's alias in
# the same namespace as local names, and `path` is one of the most common local
# names there is -- the compiler alone has it as a parameter in a dozen
# functions. `fs` overstates it: nothing here touches a filesystem.
#
# Nothing here touches the filesystem: these are string functions, and that is
# the point. The compiler carried this logic twice, letter for letter, as
# `analyze.canon` and `lsp.canon` -- both spelled
# `Paths.get(p).toAbsolutePath().normalize().toString()`, one behaviour with
# two definitions and a `use java` each.
#
# The separator is `/`. That is not an oversight: the C runtime already spells
# `/` in its mkdirs and temp-directory primitives, so the language's own
# filesystem contract is POSIX-shaped, and a library that pretended otherwise
# would be pretending on one backend only.

use std/str
use std/list

## Whether `p` starts at the root.
pub fn is_absolute(p: String) -> Bool = str.starts_with(p, "/")

## `p` with empty segments, `.` segments and `name/..` pairs removed.
##
## A `..` that would climb past the root is dropped (`/../a` is `/a`), because
## the kernel resolves the root's parent to the root. A leading `..` on a
## *relative* path is kept -- there it still means something. Both match
## java.nio.file.Path.normalize, which scripts/path-contract checks; the
## root-climbing case was written down here as a divergence first and measured
## as agreement second.
pub fn normalize(p: String) -> String = {
  let abs = is_absolute(p)
  var out: List[String] = []
  for seg in str.split(p, "/") {
    if seg == "" || seg == "." {
      ()
    } else if seg == ".." {
      let n = len(out)
      if n > 0 && out[n - 1] != ".." {
        out = list.take(out, n - 1)
      } else if not abs {
        out = out ++ [seg]
      }
    } else {
      out = out ++ [seg]
    }
  }
  let body = segments(out)
  if abs { "/" ++ body } else { body }
}

# The prelude's `join` is not reachable from this module any more: `pub fn
# join` below shadows it, the way a top-level declaration shadows any builtin
# (spec §10.6). Three lines here, rather than a worse name for the path join
# that 41 call sites were waiting for.
fn segments(xs: List[String]) -> String = {
  var out = ""
  for seg in xs {
    out = if out == "" { seg } else { out ++ "/" ++ seg }
  }
  out
}

## `p` resolved against `base` when it is relative, then normalized. `base` is
## the working directory at the call site -- passed in rather than read here,
## because reading it is an effect and normalizing is not.
##
## Subject first, like every other function in this module. It used to read
## `absolute(base, p)`, which put the one path it does not always look at in
## front of the one it always does, and was the module's only disagreement with
## itself (audit RD-09).
pub fn absolute(p: String, base: String) -> String =
  if is_absolute(p) { normalize(p) } else { normalize(base ++ "/" ++ p) }

## Everything above `p`, or `None` when `p` is a bare name or the root itself.
## `p` is normalized first, so `a/b/../c` has parent `a`.
pub fn parent(p: String) -> Option[String] = {
  let n = normalize(p)
  if n == "" || n == "/" { return None }
  match str.last_index_of(n, "/") {
    Some(0) -> Some("/")
    Some(i) -> Some(str.take(n, i))
    None -> None
  }
}

# ---- the four the compiler happened not to need ----
#
# This module started as exactly what `analyze.canon` and `lsp.canon` spelled
# in Java and nothing else, which left 41 call sites writing `dir ++ "/" ++ n`
# by hand, three hand-written basenames, and two places subtracting a literal
# 5 because that is `str.len(".dawn")` (audit RD-09).

## `p` resolved against directory `base`, normalized.
##
## An absolute `p` ignores `base` entirely -- the same rule `absolute` and the
## shell's `cd` follow -- and an empty `base` or `p` leaves the other one
## normalized rather than growing a stray separator. This is the function the
## 41 `++ "/" ++` sites wanted: `io.list_dir` answers with bare names, and a
## bare name joined onto a directory is the shape every one of them had.
pub fn join(base: String, p: String) -> String =
  if base == "" || is_absolute(p) {
    normalize(p)
  } else if p == "" {
    normalize(base)
  } else {
    normalize(base ++ "/" ++ p)
  }

## The last segment of `p`: its name, with every directory above it removed.
## `p` is normalized first, so `a/b/` and `a/b/.` both name `b`.
##
## `""` for the root and for the empty path, which are the two paths that have
## no name. Not `Option`: every call site here holds a path it just built or
## just listed, and a branch none of them can take is a branch all of them
## would have to write.
pub fn basename(p: String) -> String = {
  let n = normalize(p)
  match str.last_index_of(n, "/") {
    Some(i) -> str.drop(n, i + 1)
    None -> n
  }
}

## The extension of `basename(p)`, written without its dot, or `None`.
##
## A dot only starts an extension when there is a name before it and something
## after it: `.gitignore` is a dotfile and not an extension, and `x.` has none
## either. Inquiry (spec §4.8, criterion 2) -- "this file has no extension" is
## a case every caller distinguishes, which is precisely what the two `- 5`
## sites could not.
pub fn extension(p: String) -> Option[String] = {
  let name = basename(p)
  match str.last_index_of(name, ".") {
    Some(i) ->
      if i <= 0 || i == str.len(name) - 1 {
        None
      } else {
        Some(str.drop(name, i + 1))
      }
    None -> None
  }
}

## `p` (normalized) with its extension replaced by `ext`, itself written
## without a dot. A path with no extension gains one, and an empty `ext`
## removes it -- so `with_extension(p, "")` is how you drop a suffix without
## counting its characters.
pub fn with_extension(p: String, ext: String) -> String = {
  let n = normalize(p)
  let stem = match extension(n) {
    Some(e) -> str.take(n, str.len(n) - str.len(e) - 1)
    None -> n
  }
  if ext == "" { stem } else { stem ++ "." ++ ext }
}

test "absolute takes the subject first" {
  # The order flipped in the batch that moved this module out of std (audit
  # RD-09), and it is the one change here a caller cannot see the compiler
  # catch: both parameters are `String`.
  assert absolute("a/b", "/work") == "/work/a/b"
  assert absolute("/etc/x", "/work") == "/etc/x"
  assert absolute("../a", "/work/sub") == "/work/a"
}

test "the four convenience functions" {
  assert join("a/b", "c.dawn") == "a/b/c.dawn"
  assert join("a/b", "/etc/x") == "/etc/x"
  assert join("", "c.dawn") == "c.dawn"
  assert basename("/a/b/c.dawn") == "c.dawn"
  assert basename("a/b/") == "b"
  assert basename("/") == ""
  assert extension("/a/b/c.dawn") == Some("dawn")
  assert extension("/a/b/.gitignore") == None
  assert extension("/a.b/c") == None
  assert with_extension("src/main.dawn", "class") == "src/main.class"
  assert with_extension("src/main.dawn", "") == "src/main"
}

test "normalize and parent" {
  assert normalize("a/./b//c/") == "a/b/c"
  assert normalize("/a/../../b") == "/b"
  assert normalize("../a") == "../a"
  assert parent("/a/b/c") == Some("/a/b")
  assert parent("/a") == Some("/")
  assert parent("a") == None
  assert parent("/") == None
}

# checker.dawn: an opaque type does not inherit its target's arithmetic (D4)
use money.{Money, Tile, F64, cents, sum}

pub fn add_money(a: Money, b: Money) -> Money = a + b

pub fn sum_money(ms: List[Money]) -> Money = sum(ms, cents(0))

pub fn sub_tiles(a: Tile[F64], b: Tile[F64]) -> Tile[F64] = a - b

pub fn neg_tile(a: Tile[F64]) -> Tile[F64] = -a

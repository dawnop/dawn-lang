# A row that had to supply evidence must say so, and `!io` used to be where
# rows went to stop saying it.
#
# `base_union` let io absorb the effect variables written beside it, so `-> Int
# !io !e` normalized to `!io` and the row kept no trace of `!e`; and a callee
# could write `!io` alone and leave the variable in a parameter type, where the
# declared row never mentioned it at all. Either way the caller charged a row
# with no label in it, the `with handle` remainder was built from that row, the
# pack that remainder received had no node for the label, and the call read
# `ev_get` off it and panicked with "effect evidence missing" on a program that
# checks clean. Every function here is one the compiler's own diagnostic
# recommends: the advice on an unbindable variable is "declare !io, which
# covers any row".
#
# The same absorption bit **inferred** rows too, which is the half no rule
# about signatures can reach: a closure that did io and called an `!e`
# parameter had its own row collapse to `!io`, and then the call that ran it
# built a pack out of that row. `lambda_absorbs` is that one, and nothing in it
# is declared.
#
# **Every line below installs its own handler.** That is not tidiness. With one
# `main`-level `with handle` per effect, any line that charges the label
# correctly puts the node in the shared remainder's pack and every other line
# reads it for free -- so a fix that repaired four cases out of five printed the
# right answer five times. Two of these lines were measured green that way
# before the arrangement changed.
#
# `plain` is the control that was always right: its row has no io, so nothing
# was absorbed and the charge came out correct by the shape rather than by
# rule.
use std/io

effect AskE {
  fn ask() -> Int
}

effect TellE {
  fn tell() -> Int
}

## The variable is written in the row and absorbed by the io beside it.
fn under_io(f: fn() -> Int !e) -> Int !io !e = {
  println("under_io ran")
  f()
}

## The variable is not written in the row at all: `!io` alone, which is the
## spelling the diagnostic asks for. Only the parameter type names `!e`, so no
## amount of normalizing the declared row can recover it -- the call site has
## to charge what it packed.
fn only_io(f: fn() -> Int !e) -> Int !io = f()

## The control: no io in the row, so nothing was ever absorbed.
fn plain(f: fn() -> Int !e) -> Int !e = f()

## Two absorbed variables in one signature, so the charge is a union and not
## whichever row was seen last.
fn two_under_io(g: fn() -> Int !e1, h: fn() -> Int !e2) -> Int !io = g() + h()

## An absorbed variable forwarded through a second absorbing signature: what is
## instantiated here is a variable rather than a label, and the label is
## charged one level up.
fn nested(f: fn() -> Int !e) -> Int !io = only_io(f)

## The absorption inside an inferred row: this lambda does io and calls an `!e`
## parameter, so its own row was the union of the two, and the union used to
## hand back `!io` alone.
fn lambda_absorbs(f: fn() -> Int !r) -> Int !io !r =
  plain(() => {
    println("inside the lambda")
    f()
  })

## The same with two variables, so the lambda's row is io over a union rather
## than io over one atom.
fn lambda_absorbs_two(g: fn() -> Int !e1, h: fn() -> Int !e2) -> Int !io !e1 !e2 =
  plain(() => {
    println("inside the second lambda")
    g() + h()
  })

fn line_under_io() -> Unit !io = {
  with handle AskE { ask() => 300 }
  println(to_string(under_io(() => ask())))
}

fn line_only_io() -> Unit !io = {
  with handle AskE { ask() => 300 }
  println(to_string(only_io(() => ask())))
}

fn line_plain() -> Unit !io = {
  with handle AskE { ask() => 300 }
  println(to_string(plain(() => ask())))
}

fn line_two_under_io() -> Unit !io = {
  with handle AskE { ask() => 300 }
  with handle TellE { tell() => 7 }
  println(to_string(two_under_io(() => ask(), () => tell())))
}

fn line_nested() -> Unit !io = {
  with handle TellE { tell() => 7 }
  println(to_string(nested(() => tell())))
}

fn line_lambda_absorbs() -> Unit !io = {
  with handle AskE { ask() => 300 }
  println(to_string(lambda_absorbs(() => ask())))
}

fn line_lambda_absorbs_two() -> Unit !io = {
  with handle AskE { ask() => 300 }
  with handle TellE { tell() => 7 }
  println(to_string(lambda_absorbs_two(() => ask(), () => tell())))
}

pub fn main() -> Unit !io = {
  println("-- a variable absorbed by the io written beside it --")
  line_under_io()
  println("-- the row that says only !io, with the variable in a parameter --")
  line_only_io()
  println("-- the control: a row with no io to absorb anything --")
  line_plain()
  println("-- two absorbed variables, two labels, one charge --")
  line_two_under_io()
  println("-- forwarded through a second absorbing signature --")
  line_nested()
  println("-- a lambda whose own inferred row mixed io with a variable --")
  line_lambda_absorbs()
  println("-- and the same with two variables under the io --")
  line_lambda_absorbs_two()
  println("-- and a pure closure through the same signatures --")
  println(to_string(only_io(() => 1)))
}

# Repeated declarations file their headers under one path each
# (docs/symbol-id-design.md §四). The path names the first declaration; every
# repeat is still checked against the header written above it, so each body
# here is well typed against its own header and only the repeats themselves
# are reported -- except the first `size`, whose body is wrong on purpose so
# that reading it against no header (or its twin's) shows.
fn twin(x: Int) -> Int = x
fn twin(x: String) -> Int = 1
fn wider(n: Int) -> Int = n
fn wider(n: Int, m: Int) -> Int = n + m
const LIMIT: Int = 1
const LIMIT: String = "one"

trait Size[T] {
  fn size(x: T) -> Int
}

type Box = B(n: Int)

impl Size[Box] {
  fn size(x: Box) -> Int = "first"
  fn size(x: Box) -> Int = x.n
}

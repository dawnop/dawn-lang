# expect: `ctl` introduces `ctl effect Name { ... }`
# One effect is suspendable or it is not, so the prefix appears at most once.
# The second `ctl` stands where `effect` belongs, and one token of lookahead is
# enough to say so at the second word rather than further along.
ctl ctl effect Async {
  fn wait(ms: Int) -> Unit
}

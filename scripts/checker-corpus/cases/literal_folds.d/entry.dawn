# ir/interp.dawn: a literal folded through a pure impl that panics is a compile error at the literal (literal-system-design D6, D9)
use u8.{U8}

fn take(u: U8) -> U8 = u

pub fn too_big() -> U8 = 300

pub fn negative() -> U8 = -1

pub fn argument() -> U8 = take(256)

pub fn fine() -> U8 = take(255)

# std/gpu: copy_from_host and copy_to_host take a T with both a format
# (HasDtype) and a bit pattern (DeviceBits). Bool has a format and no buffer;
# U32 has neither. Both are refused where the call is written, and the message
# names the missing impl, so a mutant that loosens the bound (or drops
# DeviceBits from it) shows up here and nowhere else.
use std/gpu.{DeviceBuffer, Gpu, copy_from_host, copy_to_host}
use std/int/u32.{U32}

pub fn up_bool(t: DeviceBuffer[Bool]) -> Result[Unit, ForeignError] !Gpu = copy_from_host(t, [true])

pub fn down_bool(t: DeviceBuffer[Bool]) -> Result[List[Bool], ForeignError] !Gpu = copy_to_host(t)

pub fn down_u32(t: DeviceBuffer[U32]) -> Result[List[U32], ForeignError] !Gpu = copy_to_host(t)

pub fn fine(t: DeviceBuffer[Int]) -> Result[Unit, ForeignError] !Gpu = copy_from_host(t, [1, 2])

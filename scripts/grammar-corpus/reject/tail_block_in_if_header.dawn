# expect: a tail block cannot follow `}`
# expect: allowed at module top level
# An `if` header never opens a tail block (spec §4.3): the header parses with
# the brace-suffix switch set, so `check(x)` keeps its hands off the `{` and
# the first braces stay the `if`'s own body. The second braces then have `}`
# as their previous token, which is the refusal they hit. Parenthesise the
# call -- `if (check(x) { probe() }) { ... }` -- to attach a block there.
fn f(x: Int) -> Unit !io = {
  if check(x) { io.println("a") } { io.println("b") }
}

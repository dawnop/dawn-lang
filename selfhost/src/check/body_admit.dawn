# Whether a typed body recorded in one revision is a product the candidate
# revision can install unchanged.
#
# This walk used to rebuild the tree node by node, because a reference in it
# could mean something else in the candidate revision. Nothing in a body moves
# any more: a nominal or trait id derives from its declaration
# (`check/identity.derive`), a type variable, an effect variable and a local
# symbol are `identity.pack` of their declaration and their slot, and a span
# is an offset from the declaration that recorded it
# (`check/tast_positions`). The rebuild was therefore the identity on every
# arm, and what it was really doing was refusing the trees it could not
# rebuild. That is all that is left: one pass, the same arms, answering yes or
# no and constructing nothing.
#
# The refusals are not decoration. A recorded local has to name a symbol this
# revision has and be spelled the way that symbol is; an evidence read has to
# carry a key and an origin that are two records of one slot; a call's
# operands have to be one per slot of the callee's ABI row; an evidence pack
# has to take apart and put back together with one value per role. The class
# of bodies admitted by `check/scalar_shape` now includes ordinary pure calls.
# Their namespace and exact header signature are separately revalidated by
# `check/scalar_replay`; this walk validates the retained call product.
use std/map
use check/evidence_spelling
use check/types.{Sig, Sym, EV_PACK_ID, evidence_role_key, EvidenceRole,
  LabelSlot, VariableSlot, AssociatedSlot, Eff, EPure, ELabeled, EffVar, EffAssoc,
  eff_union, eff_labels, eff_vars, eff_assocs, nev, sig_abi_eff, ev_pack_ty, erased_ev_ty,
  key_is_label, key_effect_id, TyInt, TyUnit, TyVar }
use check/tast.{
  TExpr, TStmt, TPat, TFun, TDefault, TJavaCall, TModule, TConst,
  TSPText, TSPInterp, TLEExpr, TLESpread, TLEIf,
  XInt, XChar, XFloat, XBool, XUnit, XStr, XLocal, XEvRead, XFnValue,
  XCallDyn, XCallBuiltin, XCallFn, XApply, XJava, XLambda, XCtor, XConstRef,
  XCtorValue, XField, XListLit, XTupleLit, XPropagate, XUnwrap, XIndex,
  XReturn, XBreak, XContinue, XComptime, XBinary, XUnary,
  XIf, XMatch, XBlock, XError,
  TPWild, TPBind, TPLit, TPOr, TPTuple, TPList, TPCtor,
  TSLet, TSLetPat, TSLocalFn, TSAssign, TSExpr, TSAssert, TSWhile, TSFor, BAdd }

## The candidate revision, as much of it as this walk reads: the symbol table
## the recorded tree's locals have to be found in, and the way to resolve a
## call's callee so its ABI row can be counted.
pub type View = {
  symbols: Map[Int, Sym],
  callee: fn(Option[String], String, Bool, Option[Int]) -> Option[Sig]
}

## A recorded local names a symbol this revision has, spells it the way the
## symbol table does, and, if the compiler owns the name, spells the key the
## symbol carries.
fn local_name(v: View, id: Int, old: String) -> Bool =
  match map.get(v.symbols, id) {
    None -> false
    Some(saved) -> saved.name == old && evidence_spelling.checked_symbol(saved) != None
  }

fn expressions(v: View, xs: List[TExpr]) -> Bool = {
  for x in xs {
    if not expression(v, x) { return false }
  }
  true
}

fn opt_expr(v: View, x: Option[TExpr]) -> Bool =
  match x {
    None -> true
    Some(e) -> expression(v, e)
  }

## A call's evidence operands, against the order the callee's ABI row lays
## out. That order is a pure function of the effect ids in the row, and an id
## derives from its declaration, so the recorded order is already the
## candidate revision's order. What is left to ask is whether the recorded
## call carries one operand per ABI slot: a recorded call that does not is a
## product of some other signature.
fn evidence(v: View, s: Sig, xs: List[TExpr]) -> Bool =
  nev(sig_abi_eff(s)) == len(xs) && expressions(v, xs)

pub fn pattern(v: View, p: TPat) -> Bool =
  match p {
    TPWild -> true
    TPLit(_) -> true
    TPBind(id, name) -> local_name(v, id, name)
    TPOr(xs) -> patterns(v, xs)
    TPTuple(xs) -> patterns(v, xs)
    TPList(pre, rest, id, post) -> patterns(v, pre) && patterns(v, post)
    TPCtor(adt, slot, fields) -> {
      for field in fields {
        let ok = match field {
          None -> true
          Some(pat) -> pattern(v, pat)
        }
        if not ok { return false }
      }
      true
    }
  }

fn patterns(v: View, ps: List[TPat]) -> Bool = {
  for p in ps {
    if not pattern(v, p) { return false }
  }
  true
}

fn java_call(v: View, c: TJavaCall) -> Bool = {
  for (slot, e) in c.sam_evs {
    if not expression(v, e) { return false }
  }
  opt_expr(v, c.target) && expressions(v, c.args)
}

type PackPart = { role: EvidenceRole, value: TExpr }

fn pack_origin(v: View, x: TExpr) -> Option[EvidenceRole] =
  match x {
    XEvRead(key, origin, _, _, _) -> {
      if key != evidence_role_key(origin) { return None }
      Some(origin)
    }
    XLocal(id, _, _, _, _) -> evidence_spelling.symbol_evidence_role(map.get(v.symbols, id)?)
    _ -> None
  }

fn pack_parts(v: View, x: TExpr) -> Option[List[PackPart]] =
  match x {
    XUnit(_, _) -> Some([])
    XCtor(adt, slot, args, slots, spread, _, _, _) -> {
      if adt != EV_PACK_ID || slot != 0 || len(args) != 3 ||
        slots != [Some(0), Some(1), Some(2)] || spread != None { return None }
      let key = match args[0] { XInt(k, _, _) -> k
        _ -> { return None }
      }
      if not key_is_label(key) { return None }
      let label = key_effect_id(key)
      let rest = pack_parts(v, args[2])?
      if not expression(v, args[1]) { return None }
      Some(rest ++ [PackPart { role: LabelSlot(label), value: args[1] }])
    }
    XCallBuiltin(name, args, ws, evs, _, _, _) -> {
      if name != "ev_append" || len(args) != 2 || len(ws) != 0 || len(evs) != 0 { return None }
      Some(pack_parts(v, args[0])? ++ pack_parts(v, args[1])?)
    }
    _ -> {
      let role = pack_origin(v, x)?
      match role { LabelSlot(_) -> { return None }
        _ -> ()
      }
      if not expression(v, x) { return None }
      Some([PackPart { role: role, value: x }])
    }
  }

# Reuse effect normalization as the authoritative ordering of the three axes.
# A pack has one value per full atom, even when erased associated keys collide.
#
# The label atoms below are built with an empty name on purpose, and that is
# sound only while the label axis is ordered by id alone: `types.by_id`
# compares the integer and never the spelling, so a name the role does not
# carry cannot change where the atom lands. An ordering that consulted the
# spelling would read "" for every label here and silently sort them into
# whatever order the list happened to arrive in, which is why the premise is
# written down rather than left to be rediscovered.
fn ordered_parts(parts: List[PackPart]) -> Option[List[PackPart]] = {
  var rows: List[Eff] = []
  for p in parts {
    rows = rows ++ [match p.role {
      LabelSlot(id) -> ELabeled(EPure, [(id, "")])
      VariableSlot(id) -> EffVar("", id)
      AssociatedSlot(tv, tr, name) -> EffAssoc("", tv, tr, name)
    }]
  }
  let row = eff_union(rows)
  var roles: List[EvidenceRole] = []
  for (id, _) in eff_labels(row) { roles = roles ++ [LabelSlot(id)] }
  for (id, _) in eff_vars(row) { roles = roles ++ [VariableSlot(id)] }
  for (_, tv, tr, name) in eff_assocs(row) { roles = roles ++ [AssociatedSlot(tv, tr, name)] }
  if len(roles) != len(parts) { return None }
  var out: List[PackPart] = []
  for role in roles {
    var found: Option[PackPart] = None
    for p in parts {
      if p.role == role {
        if found != None { return None }
        found = Some(p)
      }
    }
    out = out ++ [found?]
  }
  Some(out)
}

## An evidence pack is admitted by taking it apart and laying it out again:
## one value per role of the row its atoms make. A chain that repeats a role,
## or carries an atom the row does not, does not lay out.
fn evidence_pack(v: View, x: TExpr) -> Bool =
  match pack_parts(v, x) {
    None -> false
    Some(parts) -> ordered_parts(parts) != None
  }

pub fn expression(v: View, x: TExpr) -> Bool =
  match x {
    XInt(_, _, _) -> true
    XChar(_, _, _) -> true
    XFloat(_, _, _) -> true
    XBool(_, _, _) -> true
    XUnit(_, _) -> true
    XBreak(_, _) -> true
    XContinue(_, _) -> true
    XError(_, _) -> true
    XStr(parts, _, _) -> {
      for part in parts {
        let ok = match part {
          TSPText(_) -> true
          TSPInterp(e, w) -> expression(v, e)
        }
        if not ok { return false }
      }
      true
    }
    XLocal(id, name, _, _, _) -> local_name(v, id, name)
    XEvRead(key, origin, _, _, _) -> key == evidence_role_key(origin)
    XFnValue(_, _, _, _, _, _) -> true
    XCallDyn(id, name, args, evs, _, _, _) ->
      local_name(v, id, name) && expressions(v, args) && expressions(v, evs)
    XCallFn(owner, name, args, ws, evs, tr, _, _, _) ->
      match v.callee(owner, name, false, tr) {
        None -> false
        Some(sig) -> expressions(v, args) && evidence(v, sig, evs)
      }
    XCallBuiltin(name, args, ws, evs, _, _, _) -> {
      if name == "ev_append" { return evidence_pack(v, x) }
      let sig = match v.callee(None, name, true, None) { Some(s) -> s
        None -> { return false }
      }
      if name == "ctl_run" || name == "ctl_yield" {
        if len(args) == 0 { return false }
        match args[0] { XInt(_, _, _) -> ()
          _ -> { return false }
        }
      }
      expressions(v, args) && evidence(v, sig, evs)
    }
    XApply(target, args, evs, _, _, _) ->
      expression(v, target) && expressions(v, args) && expressions(v, evs)
    XJava(c, _, _, _) -> java_call(v, c)
    XLambda(params, names, body, captures, _, _, _) -> expression(v, body)
    XCtor(adt, slot, written, slots, spread, _, _, _) -> {
      if adt == EV_PACK_ID { return evidence_pack(v, x) }
      expressions(v, written) && opt_expr(v, spread)
    }
    XConstRef(_, _, _, _, _) -> true
    XCtorValue(_, _, _, _, _) -> true
    XField(target, _, _, _, _) -> expression(v, target)
    XListLit(elems, _, _, _) -> {
      for elem in elems {
        let ok = match elem {
          TLEExpr(e) -> expression(v, e)
          TLESpread(e) -> expression(v, e)
          TLEIf(arms) -> {
            var every = true
            for a in arms {
              if not expression(v, a.cond) || not expression(v, a.body) { every = false }
            }
            every
          }
        }
        if not ok { return false }
      }
      true
    }
    XTupleLit(es, _, _, _) -> expressions(v, es)
    XPropagate(e, _, _, _) -> expression(v, e)
    XUnwrap(e, _, _, _, _) -> expression(v, e)
    XIndex(a, b, w, _, _, _) -> expression(v, a) && expression(v, b)
    XReturn(e, _, _) -> opt_expr(v, e)
    XComptime(e, _, _, _) -> expression(v, e)
    XBinary(op, a, b, w, _, _, _, _, _) -> expression(v, a) && expression(v, b)
    XUnary(op, e, _, _, _) -> expression(v, e)
    XIf(c, t, e, _, _, _) -> expression(v, c) && expression(v, t) && opt_expr(v, e)
    XMatch(e, arms, _, _, _) -> {
      for a in arms {
        if not pattern(v, a.pat) || not opt_expr(v, a.guard) || not expression(v, a.body) { return false }
      }
      expression(v, e)
    }
    XBlock(stmts, tail, _, _, _) -> {
      for s in stmts {
        if not statement(v, s) { return false }
      }
      opt_expr(v, tail)
    }
  }

pub fn statement(v: View, s: TStmt) -> Bool =
  match s {
    TSLet(id, name, init, _, _) -> {
      let named = match id { None -> true
        Some(i) -> local_name(v, i, name)
      }
      named && expression(v, init)
    }
    TSLetPat(p, init, _, _) -> pattern(v, p) && expression(v, init)
    TSLocalFn(id, name, params, names, body, captures, _, _) ->
      local_name(v, id, name) && expression(v, body)
    TSAssign(id, name, value, _, _) -> local_name(v, id, name) && expression(v, value)
    TSExpr(e, _, _) -> expression(v, e)
    TSAssert(e, _, _, _) -> expression(v, e)
    TSWhile(c, body, _, _, _) -> expression(v, c) && expression(v, body)
    TSFor(p, ty, from, to, w, body, _, _, _) ->
      pattern(v, p) && expression(v, from) && opt_expr(v, to) && expression(v, body)
  }

pub fn function(v: View, f: TFun) -> Bool = {
  for d in f.defaults {
    let ok = match d {
      None -> true
      Some(value) -> expression(v, value.body)
    }
    if not ok { return false }
  }
  # same question as a call site's operands, asked of the entry symbols: one
  # per ABI slot, in the order the row already fixes
  if nev(sig_abi_eff(f.sig)) != len(f.ev_syms) { return false }
  expression(v, f.body)
}

pub fn constant(v: View, c: TConst) -> Bool = expression(v, c.init)

## This admits an already checked module, not its checker state or the
## declaration scheduler. Callers still own validity.
pub fn module(v: View, m: TModule) -> Bool = {
  for f in m.fns {
    if not function(v, f) { return false }
  }
  for f in m.tests {
    if not function(v, f) { return false }
  }
  for c in m.consts {
    if not constant(v, c) { return false }
  }
  for (id, s) in map.entries(m.syms) {
    if evidence_spelling.checked_symbol(s) == None { return false }
  }
  true
}

fn fixture_signature() -> Sig =
  Sig { name: "f", param_tys: [], param_names: [], param_defaults: [], ret: TyUnit,
    eff: EPure, is_builtin: false, tparams: [], constraints: [], eparams: [],
    owner: None, trait_id: None, op_of: None, inferring: false }

fn fixture_view() -> View = {
  let symbol = Sym { name: "x", ty: TyInt, mutable: false, dlo: 10, dhi: 11,
    dict_of: None, ev_of: None, cell_of: None }
  View { symbols: map.insert(map.empty(), 1, symbol),
    callee: (owner, name, builtin, tr) => Some(fixture_signature()) }
}

test "body admission separates literals from prompts and preserves field slots" {
  let v = fixture_view()
  assert expression(v, XInt(1, 10, 11))
  # A prompt operand is a handler installation, which is a slot of the
  # declaration that opened it and the same integer here. It is still told
  # apart from an ordinary literal, which is what this arm is for: the
  # literal above is admitted because it is a literal, and the operand is
  # admitted because it is one too. An operand that is anything else is a
  # product this compiler did not write.
  assert expression(v, XCallBuiltin("ctl_run", [XInt(1, 10, 11)], [], [], 10, 11, TyUnit))
  assert not expression(v, XCallBuiltin("ctl_run", [XLocal(1, "x", 10, 11, TyInt)], [], [], 10, 11, TyUnit))
  assert not expression(v, XCallBuiltin("ctl_run", [], [], [], 10, 11, TyUnit))
  assert pattern(v, TPCtor(1, 1, [Some(TPBind(1, "x")), None]))
  assert not pattern(v, TPCtor(1, 1, [Some(TPBind(2, "absent")), None]))
  let local = XLocal(1, "x", 10, 11, TyInt)
  assert expression(v, XBinary(BAdd, local, XInt(1, 10, 11), None, 10, 11, 10, 11, TyInt))
  assert not expression(v, XLocal(1, "wrong", 10, 11, TyInt))
  assert not expression(v, XLocal(2, "absent", 10, 11, TyInt))
}

test "body admission lays out ground packs and associated environment order" {
  let v = fixture_view()
  let a = XEvRead(11, AssociatedSlot(1, 3, "E"), 10, 11, erased_ev_ty())
  let b = XEvRead(11, AssociatedSlot(2, 3, "E"), 10, 11, erased_ev_ty())
  let env = XCallBuiltin("ev_append", [a, b], [], [], 10, 11, erased_ev_ty())
  let inner = XCtor(EV_PACK_ID, 0, [XInt(3, 10, 11), XInt(101, 10, 11), env],
    [Some(0), Some(1), Some(2)], None, 10, 11, ev_pack_ty())
  let old = XCtor(EV_PACK_ID, 0, [XInt(6, 10, 11), XInt(102, 10, 11), inner],
    [Some(0), Some(1), Some(2)], None, 10, 11, ev_pack_ty())
  # Nothing in the chain moves: the two ground labels and the trait behind
  # the associated key derive from their declarations, and the two type
  # variables are slots of theirs. The pack is still taken apart and laid out
  # again, which is what refuses the two malformed chains below.
  assert expression(v, old)
  assert not expression(v, XCallBuiltin("ev_append", [a, a], [], [], 10, 11, erased_ev_ty()))
  assert not expression(v, XEvRead(12, AssociatedSlot(1, 3, "E"), 10, 11, erased_ev_ty()))
}

test "body admission checks defaults symbols and entry call evidence" {
  let base = fixture_view()
  let sig = Sig { ..fixture_signature(), eparams: [EffVar("a", 1), EffVar("b", 2)] }
  let v = View { ..base, callee: (owner, name, builtin, tr) => Some(sig) }
  let body = XCallFn(None, "f", [], [], [XInt(101, 10, 11), XInt(102, 10, 11)], None, 10, 11, TyUnit)
  let f = TFun { name: "f", sig: sig, param_syms: [], dict_syms: [1],
    defaults: [Some(TDefault { body: XInt(5, 10, 11), dict_syms: [1] })], ev_syms: [1, 2],
    body: body, is_test: false, impl_of: Some((3, TyInt)), default_of: Some(3) }
  let m = TModule { fns: [f], tests: [TFun { ..f, is_test: true }],
    consts: [TConst { name: "C", ty: TyVar("T", 1), init: XInt(6, 10, 11), lo: 10, hi: 11 }], syms: v.symbols }
  # The entry pack keeps the order the ABI gives it, which is the order it
  # was recorded in: nothing renumbers the effect variables it is ordered by.
  # The count is still checked, and still refuses a recorded function whose
  # evidence does not correspond to its signature's ABI row.
  assert module(v, m)
  assert not function(v, TFun { ..f, ev_syms: [1, 2, 3] })
  # A default's body is checked before entry, so it is walked too.
  assert not function(v, TFun { ..f,
    defaults: [Some(TDefault { body: XLocal(2, "absent", 10, 11, TyInt), dict_syms: [1] })] })
  # A constant's initializer is the same walk, and a module carries both.
  assert not module(v, TModule { ..m,
    consts: [TConst { name: "C", ty: TyVar("T", 1), init: XLocal(2, "absent", 10, 11, TyInt), lo: 10, hi: 11 }] })
  let unknown = View { ..v, callee: (owner, name, builtin, tr) => None }
  assert not function(unknown, f)
}

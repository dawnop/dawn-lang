# The bundled standard library: std sources are read from a directory
# (`--std <dir>`, default std), falling back to the embedded copy in
# `stdsrc.dawn` when the directory is absent — generated string constants
# compiled into the toolchain like any other module, so a standalone build
# works outside the repo on every backend with no host resource API.
# Each module is parsed and checked once in modules.txt order, its pub
# surface handed to every user module. std is checked with no std of its
# own in scope — only the prelude, the builtins and explicit `use` edges —
# keeping the bootstrap acyclic. A broken bundled std is a compiler bug:
# fail loudly.

use std/io
use std/str
use std/map
use std/set
use token.{Diag}
use ast.{Module}
use types.{
  Sig, Adts, Impls, first_minted_id, adt_of,
  OPTION_ID, RESULT_ID, FOREIGN_ERROR_ID
}
use tast.{TFun, TModule}
use cx.{ModExports, cx_new, Cx}
use checker.{check_module, exports_of}
use interp.{eval_comptime, note_trait_fn, CtOut, ct_default}
use core.{VStr, VBool}
use parser
use lexer
use stdsrc

## Everything user-module analysis needs from std.
pub type StdCtx = {
  # modPath → exports, seeded into every program's import environment
  exports: Map[String, ModExports],
  # the implicitly-visible surface: the PRELUDE names only
  std_fns: Map[String, Sig],
  # removed flat spelling → how to write it now
  moved: Map[String, String],
  # flat name → typed fn (last wins), for the comptime interpreter
  fn_decls: Map[String, TFun],
  # className → (name → typed fn): module-qualified comptime calls
  by_owner: Map[String, Map[String, TFun]],
  # std's impl methods and trait defaults, by the identity Core names them
  # with. Separate from by_owner because two impls in one module can define
  # the same method name and that table is keyed by name alone.
  impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  # the ADT table after all of std (grafted ids for user comptime)
  adts: Adts,
  # Every impl std declares, seeded into every module the program checks.
  #
  # `impl[T: Eq] Eq[List[T]]` is not something a program opts into by writing
  # `use std/list` -- coherence is program-wide, so `a == b` on two lists has
  # to mean the same thing in a module that imports std/list and one that does
  # not. That makes std's impls part of the baseline, next to the prelude's.
  impls: Impls,
  # the id counter after all of std: user modules continue from here, so
  # grafted ADT/trait ids never collide across modules
  next_id: Int,
  # per-module (modPath, checker state, typed module, comptime results), in
  # load order — codegen emits each std module's static class from these
  mods: List[(String, Cx, TModule, CtOut)],
  # per-module (modPath, source text, AST), in load order — `selfhost doc
  # --builtins` reads std doc comments and pub decls from these
  srcs: List[(String, String, Module)]
}

pub fn prelude_names() -> List[String] =
  ["println", "print", "map", "filter", "fold", "sort", "max", "min", "max_by", "min_by"]

fn is_prelude(n: String) -> Bool = {
  for p in prelude_names() {
    if p == n { return true }
  }
  false
}

fn moved_renames(out0: Map[String, String]) -> Map[String, String] = {
  var out = out0
  out = map.insert(out, "str_len", "use std/str, then str.len(...)")
  out = map.insert(out, "char_to_string", "use std/str, then str.from_char(...)")
  out = map.insert(out, "reverse_str", "use std/str, then str.reverse(...)")
  out = map.insert(out, "byte_len", "use std/bytes, then bytes.len(...)")
  out = map.insert(out, "byte_at", "use std/bytes, then bytes.at(...)")
  out = map.insert(out, "byte_slice", "use std/bytes, then bytes.slice(...)")
  out = map.insert(out, "byte_index_of", "use std/bytes, then bytes.index_of(...)")
  for op in ["empty", "from", "insert", "remove", "get", "has", "keys", "values", "entries"] {
    out = map.insert(out, "map_" ++ op, "use std/map, then map." ++ op ++ "(...)")
  }
  for op in ["empty", "from", "insert", "remove", "has", "to_list"] {
    out = map.insert(out, "set_" ++ op, "use std/set, then set." ++ op ++ "(...)")
  }
  # the two whose public name is not the primitive's: length is `len` on every
  # container now, so the flat spelling's hint has to say `len` (audit RD-06)
  out = map.insert(out, "map_size", "use std/map, then map.len(...)")
  out = map.insert(out, "set_size", "use std/set, then set.len(...)")
  for op in ["start", "end", "done", "char", "next", "prev", "slice", "skip"] {
    out = map.insert(out, "cursor_" ++ op, "use std/cursor, then cursor." ++ op ++ "(...)")
  }
  out = map.insert(out, "index_of_from", "use std/cursor, then cursor.find(...)")
  # the searches std/str took over from the intrinsic table: they were walks,
  # not representation, so there is one definition of each now (std/str)
  for op in ["trim", "contains", "starts_with", "ends_with", "index_of", "last_index_of"] {
    out = map.insert(out, "str_" ++ op, "use std/str, then str." ++ op ++ "(...)")
  }
  # The intrinsics that became std-only on 2026-07-30 (RD-02). They were
  # always meant to be the backend contract rather than language surface, and
  # nothing said so, so `io_read_file` was a spelling that skipped the whole
  # error model. Same shape as the entries above: the name still exists, it is
  # just not one user code may write, and the hint gives the one it may.
  for op in ["print", "println", "eprint", "eprintln", "exit", "read_line", "is_dir",
    "exists", "mkdirs", "read_file", "write_file", "cwd", "getenv", "read_bytes",
    "write_bytes", "delete", "rename", "temp_dir", "is_symlink", "read_stdin", "stdin_ready",
    "run"] {
    out = map.insert(out, "io_" ++ op, "use std/io, then io." ++ op ++ "(...)")
  }
  # the one io primitive std renamed: it answers entry names, and `list_dir`
  # is what the module calls that
  out = map.insert(out, "io_list_names", "use std/io, then io.list_dir(...)")
  for op in ["utf8", "len", "at", "slice", "decode_utf8", "decode_latin1"] {
    out = map.insert(out, "bytes_" ++ op, "use std/bytes, then bytes." ++ op ++ "(...)")
  }
  # retired outright rather than moved: the charset argument has no std
  # spelling, because the two charsets the language promises are two functions
  # (audit RP-04, decision C)
  out = map.insert(out, "bytes_decode",
    "use std/bytes, then bytes.decode_utf8(...) / bytes.decode_latin1(...)")
  out = map.insert(out, "bytes_from_array",
    "use std/bytes, then bytes.buf()/bytes.put(...)/bytes.freeze(...)")
  for op in ["lower", "upper"] {
    out = map.insert(out, "str_" ++ op, "use std/str, then str.to_" ++ op ++ "(...)")
  }
  # the only entry here that did not move anywhere: it was renamed in v0.31.0,
  # because the barrier catches a *fault* and stopped having anything to do
  # with Java once native got failure kinds
  out = map.insert(out, "java_try", "renamed to `catch_fault`")
  out
}

## A std source file: the directory first (repo development edits win), then
## the embedded copy `stdsrc.dawn` carries.
fn std_read(dir: String, name: String) -> Result[String, String] !io =
  match io.read_file(dir ++ "/" ++ name) {
    Ok(t) -> Ok(t)
    Err(e) ->
      match stdsrc.source(name) {
        Some(t) -> Ok(t)
        None -> Err(e.message)
      }
  }

## Read modules.txt: one name per line, `#` comments, blanks skipped.
pub fn read_index(dir: String) -> Result[List[String], String] !io = {
  let text = std_read(dir, "modules.txt")?
  var names: List[String] = []
  for line in str.split(text, "\n") {
    let cut = match str.index_of(line, "#") {
      Some(i) -> str.take(line, i)
      None -> line
    }
    let t = str.trim(cut)
    if t != "" { names = names ++ [t] }
  }
  Ok(names)
}

## Load, check and comptime-evaluate the bundled std from a directory.
pub fn load_std(dir: String) -> Result[StdCtx, String] !io = {
  let names = read_index(dir)?
  var exports: Map[String, ModExports] = map.empty()
  var std_fns: Map[String, Sig] = map.empty()
  var moved: Map[String, String] = map.empty()
  var fn_decls: Map[String, TFun] = map.empty()
  var by_owner: Map[String, Map[String, TFun]] = map.empty()
  var impl_fns: Map[(Int, String, String), (String, TFun)] = map.empty()
  var adts: Adts = map.empty()
  var impls: Impls = map.empty()
  var last_cx: Option[Cx] = None
  # The id counter carried across std's modules. It opens where `cx_new` opens
  # it -- one past every prelude id -- rather than at a literal: this one said
  # 2 from before `ForeignError` took ADT id 2, and it is the copy the
  # production path actually reads, so the first id-claiming declaration in the
  # first std module would have been handed `ForeignError`'s slot and silently
  # replaced it.
  var nid = first_minted_id()
  var mods: List[(String, Cx, TModule, CtOut)] = []
  var srcs: List[(String, String, Module)] = []
  for n in names {
    let mod_path = "std/" ++ n
    let text = std_read(dir, n ++ ".dawn")?
    let (m, pdiags) = parser.parse_module(text)
    if len(pdiags) > 0 {
      return Err("bundled std module `" ++ mod_path ++ "` does not parse: " ++ pdiags[0].msg)
    }
    var cx = cx_new(Some(mod_path), None)
    cx = Cx { ..cx, line_starts: lexer.line_starts_of(text), next_id: nid, impl_table: impls }
    # no std_fns here: std cannot implicitly import itself
    let (cx1, tm) = check_module(cx, m, exports)
    if len(cx1.diags) > 0 {
      return Err("bundled std module `" ++ mod_path ++ "` does not check: " ++ cx1.diags[0].msg)
    }
    # std folds with no host FFI: it has no `use java` at all, and ct_default()
    # is where that stops being a convention
    let ct = eval_comptime(tm, fn_decls, by_owner, impl_fns, set.empty(), cx1.adts,
      cx1.traits, cx1.impl_table, mod_path, ct_default())
    if len(ct.diags) > 0 {
      return Err("bundled std module `" ++ mod_path ++ "` does not evaluate: " ++ ct.diags[0].msg)
    }
    let exp = exports_of(cx1, m, mod_path, mod_path)
    exports = map.insert(exports, mod_path, exp)
    var own: Map[String, TFun] = map.empty()
    for f in tm.fns {
      fn_decls = map.insert(fn_decls, f.name, f)
      own = map.insert(own, f.name, f)
      impl_fns = note_trait_fn(impl_fns, mod_path, f)
    }
    by_owner = map.insert(by_owner, mod_path, own)
    for fname in map.keys(exp.fns) {
      if is_prelude(fname) {
        std_fns = map.insert(std_fns, fname,
          map.get(exp.fns, fname).expect("prelude fn"))
      } else {
        moved = map.insert(moved, fname, "use " ++ mod_path ++ ", then " ++ n ++ "." ++
            fname ++ "(...)")
      }
    }
    # union, like the impl table below it: std modules are checked with only
    # the prelude and their own `use` edges in scope, so a module that does
    # not import another does not carry that other's ADTs. Taking the last
    # module's table alone loses every ADT declared before it -- invisible
    # while no std module declared one, and a missing-adt-id panic the moment
    # one does.
    for pr in map.entries(cx1.adts) {
      let (k, v) = pr
      adts = map.insert(adts, k, v)
    }
    for pr in map.entries(cx1.impl_table) {
      let (k, v) = pr
      impls = map.insert(impls, k, v)
    }
    last_cx = Some(cx1)
    nid = cx1.next_id
    mods = mods ++ [(mod_path, cx1, tm, ct)]
    srcs = srcs ++ [(mod_path, text, m)]
  }
  moved = moved_renames(moved)
  var std_names: Set[String] = set.empty()
  for k in map.keys(fn_decls) { std_names = set.insert(std_names, k) }
  Ok(StdCtx {
    exports: exports,
    std_fns: std_fns,
    moved: moved,
    fn_decls: fn_decls,
    by_owner: by_owner,
    impl_fns: impl_fns,
    std_names: std_names,
    adts: adts,
    impls: impls,
    next_id: nid,
    mods: mods,
    srcs: srcs
  })
}

# ---- tests ----

fn put(p: String, text: String) -> Unit !io =
  match io.write_file(p, text) {
    Ok(_) -> ()
    Err(e) -> panic("test setup: " ++ e.message)
  }

test "the embedded std matches std/ on disk" {
  # the staleness gate for the generated stdsrc.dawn: an edit under std/
  # that forgot to regenerate fails here, in every `dawn test selfhost`
  let names = match read_index("std") {
    Ok(ns) -> ns
    Err(e) -> panic("std index: " ++ e)
  }
  var files = ["modules.txt"]
  for n in names { files = files ++ [n ++ ".dawn"] }
  for f in files {
    let disk = match io.read_file("std/" ++ f) {
      Ok(t) -> t
      Err(e) -> panic("std/" ++ f ++ ": " ++ e.message)
    }
    match stdsrc.source(f) {
      Some(t) -> {
        if t != disk {
          println("stale embedded std: " ++ f ++ " (run python3 scripts/gen-stdsrc.py)")
        }
        assert t == disk
      }
      None -> {
        println("missing from embedded std: " ++ f ++ " (run python3 scripts/gen-stdsrc.py)")
        assert false
      }
    }
  }
}

test "the loader's id counter opens past every prelude id" {
  # `load_std` used to open its counter at the literal 2, which is
  # `ForeignError`'s ADT id, and it is the counter the production path
  # actually reads. Nothing ever fired, for a reason that is not a
  # guarantee: std/cursor is first in modules.txt and its first declaration
  # is an `opaque type`, which claims no ADT id, so the opening value went to
  # a type variable instead -- a separate id space where a collision is
  # harmless. Reorder std, or give cursor a sum type, and the first minted ADT
  # id would land on `ForeignError`'s entry and replace it. A map insert has no
  # opinion about what was there, so the first symptom was several files away:
  # `e.message` on a `catch_fault` result, reported as a field access on
  # whatever the new ADT 2 happened to be.
  #
  # So this does not read the real std, whose declaration order is the very
  # thing not to depend on. It supplies a one-module std whose first
  # declaration is a plain sum type -- the case that does claim an id -- and
  # asks what the loader did with the prelude's ADT table.
  let root = "/tmp/dawn-selfhost-stdlib/idprobe"
  let _ = io.mkdirs(root)
  put(root ++ "/modules.txt", "idprobe\n")
  put(root ++ "/idprobe.dawn", "pub type IdProbe = | IpA | IpB\n")
  let probe = match load_std(root) {
    Ok(sc) -> sc
    Err(e) -> panic("probe std: " ++ e)
  }
  # the prelude ADTs came through unreplaced
  assert adt_of(probe.adts, OPTION_ID).name == "Option"
  assert adt_of(probe.adts, RESULT_ID).name == "Result"
  assert adt_of(probe.adts, FOREIGN_ERROR_ID).name == "ForeignError"
  # and the probe was minted an id of its own, past every prelude id
  var probe_id = -1
  for pr in map.entries(probe.adts) {
    let (i, a) = pr
    if a.name == "IdProbe" { probe_id = i }
  }
  assert probe_id >= first_minted_id()
}

test "float rendering and parsing fold through std/fmt, not the host" {
  # The RP-12 gate's float line, after audits RP-01/RP-05 moved the answers
  # into std: `to_string(Float)` lowers to std/fmt.dtoa and the parsers to
  # fmt.atoi/atod, so a comptime fold interprets the program's own std Core.
  # The expected strings below are spec §4.3's, written literally -- if the
  # fold ever rode a host renderer or host grammar again, a JDK could change
  # them out from under the spec and this test is what would say so.
  let std = match load_std("std") {
    Ok(s) -> s
    Err(e) -> panic("std: " ++ e)
  }
  let src = "const A: String = comptime { to_string(0.1) }\n" ++
    "const B: String = comptime { to_string(3.0e-7) }\n" ++
    "const C: String = comptime { to_string(1.0e300) }\n" ++
    "const D: String = comptime { to_string(-0.0) }\n" ++
    "const E: String = comptime { to_string(0.0 / 0.0) }\n" ++
    "const F: String = comptime { to_string(1.0 / 0.0) }\n" ++
    "const G: String = comptime { to_string(9999999.0) }\n" ++
    "const H: String = comptime { to_string(10000000.0) }\n" ++
    "const P: Bool = comptime { parse_float(\"1.5f\") == None }\n" ++
    "const Q: Bool = comptime { parse_float(\"Infinity\") == Some(1.0 / 0.0) }\n" ++
    "const R: Bool = comptime { parse_int(\" 42 \") == Some(42) }\n" ++
    "const S: Bool = comptime { parse_int(\"9223372036854775808\") == None }\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  var cx = cx_new(None, None)
  cx = Cx { ..cx, next_id: std.next_id, impl_table: std.impls }
  let (cx1, tm) = check_module(cx, m, std.exports)
  assert len(cx1.diags) == 0
  let ct = eval_comptime(tm, std.fn_decls, std.by_owner, std.impl_fns,
    std.std_names, cx1.adts, cx1.traits, cx1.impl_table, "m", ct_default())
  if len(ct.diags) > 0 { println("FOLD DIAG: " ++ ct.diags[0].msg) }
  assert len(ct.diags) == 0
  assert map.get(ct.consts, "A") == Some(VStr("0.1"))
  assert map.get(ct.consts, "B") == Some(VStr("3.0E-7"))
  assert map.get(ct.consts, "C") == Some(VStr("1.0E300"))
  assert map.get(ct.consts, "D") == Some(VStr("-0.0"))
  assert map.get(ct.consts, "E") == Some(VStr("NaN"))
  assert map.get(ct.consts, "F") == Some(VStr("Infinity"))
  assert map.get(ct.consts, "G") == Some(VStr("9999999.0"))
  assert map.get(ct.consts, "H") == Some(VStr("1.0E7"))
  assert map.get(ct.consts, "P") == Some(VBool(true))
  assert map.get(ct.consts, "Q") == Some(VBool(true))
  assert map.get(ct.consts, "R") == Some(VBool(true))
  assert map.get(ct.consts, "S") == Some(VBool(true))
}

test "the bundled std loads, checks and evaluates" {
  match load_std("std") {
    Ok(std) -> {
      assert map.has(std.exports, "std/str")
      assert map.has(std.exports, "std/cursor")
      # the implicit surface is exactly the prelude names
      assert map.has(std.std_fns, "println")
      assert map.has(std.std_fns, "map")
      assert not map.has(std.std_fns, "trim")
      # everything else moved behind its module
      assert map.get(std.moved, "map_insert") == Some("use std/map, then map.insert(...)")
      # the hint names the *public* spelling, which for length is not the
      # primitive's own name any more (audit RD-06)
      assert map.get(std.moved, "map_size") == Some("use std/map, then map.len(...)")
      assert map.get(std.moved, "set_size") == Some("use std/set, then set.len(...)")
      assert map.get(std.moved, "trim") == Some("use std/str, then str.trim(...)")
      assert set.has(std.std_names, "trim")
    }
    Err(e) -> {
      println("STD LOAD FAILED: " ++ e)
      assert false
    }
  }
}

# Ordinary environments and delivered type support have separate contracts.
use std/mem
type PhantomAt[@s] = { n: Int }
trait Empty[T: ^{c}, ^c] { fn empty_value() -> T }
impl[@s] Empty[PhantomAt[s], ^{s}] {
  fn empty_value() -> PhantomAt[s] = PhantomAt { n = 7 }
}
fn factory[T: Empty[c] + ^{c}, ^c](tag: T) -> (fn() -> Int ^{c}) = {
  let make: fn() -> T ^{c} = empty_value
  () => { let _value = make()
    0 }
}
fn escaped() !io = mem.with_mem([@s] () => {
  let p: PhantomAt[s] = PhantomAt { n = 7 }
  factory(p)
})
pub fn main() -> Unit !io = { let f = escaped()
  println(to_string(f())) }

# Java reflection for the checker (docs/selfhost-checker.md §四): every query
# the Kotlin checker makes against Class<*> objects, wrapped into the plain-data
# records `jsig` declares, so the checker proper never touches a Java object —
# or this module: it consumes the queries through the `Jsig` hook record, and
# `jsig_real()` is how the JVM main wires the system-loader implementations in;
# `jsig_for()` instead captures one target-local loader behind the same hooks.
# Arrays from getMethods()/getParameterTypes() are walked with
# java.lang.reflect.Array — the sanctioned detour around Dawn's no-array-
# indexing rule (spec §9.5).
#
# Each oracle keeps a `JCache` of what it has already asked the host (see the
# type below): the checker asks `methods_of` once per call site, and answering
# it from reflection every time was the most expensive thing a body could do.
#
# Everything here is honestly !io (reflection reads the world's class path),
# which makes the checker itself !io — that is the true story.

use std/str
use std/list
use std/set
use check/jsig.{JClass, JMethod, JCtor, JField, Jsig, JsigLease, JsigProbe, observe_queries, jsig_refused, refused_probe}
use java "java.io.File"
use java "java.lang.Object"
use java "java.lang.Class"
use java "java.lang.ClassLoader"
use java "java.net.URLClassLoader"
use java "java.lang.reflect.Array"
use java "java.lang.reflect.Method"
use java "java.lang.reflect.Constructor"
use java "java.lang.reflect.Field"
use java "java.lang.reflect.Modifier"
use java "java.util.HashMap"
use java "java.util.IdentityHashMap"
use java "java.util.Objects"
use java "java.lang.invoke.MethodHandles"
use java "java.lang.invoke.MethodHandle"
use java "java.util.concurrent.atomic.AtomicLong"

type TargetLoader = { base: ClassLoader, closeable: URLClassLoader }

## What one oracle has already paid the host for.
##
## The lifetime is the oracle's: the cache is built where the `Jsig` is built
## (`jsig_with`, `jsig_real`) and nothing but that record's own closures can
## reach it, so it dies with the lease that holds the `Jsig` and a new lease
## starts empty. That is the boundary the design asks for: a Java answer is
## only trusted inside its lease, and this keeps none of them outside one.
## It also sits *below* `observe_queries`, so a cache hit is still a counted
## query and the replay admission story is unchanged.
##
## The key is the fully qualified name. Within one cache that is the loaded
## class's identity and not merely its name, because a `Jsig` is bound to one
## ClassLoader for its whole life: two loaders are two oracles and therefore
## two caches. Per-member rows are keyed by the reflective object's identity,
## which is well defined precisely because the member arrays are cached too,
## so every query walks the same `Method`/`Constructor` instances.
##
## What it holds is decided by what can cross: a Dawn value cannot be stored
## in a host container (spec §9.6 bridges scalar-element Lists only, one way),
## so this keeps the arrays reflection returns plus the two derived strings
## whose computation dominates the walk (`toString()` is over half of a
## `methods_of` on `java.lang.Math`). The plain-data records are rebuilt from
## them on every query, which is what makes a hit answer exactly what a fresh
## reflection would: same order, same duplicates, same misses.
##
## Caching is sound here rather than merely cheap: the loader is fixed, the
## public members of a loaded class cannot change, and a name that failed to
## resolve against a fixed search path cannot start resolving.
type JCache = {
  # fqcn -> Class
  found: HashMap,
  # fqcn -> "", membership only: the names that did not resolve
  missing: HashMap,
  # fqcn -> the Method[] / Constructor[] / Field[] reflection handed back
  methods: HashMap,
  ctors: HashMap,
  fields: HashMap,
  # Method|Constructor -> toString(), and -> parameter class names joined by ","
  desc: IdentityHashMap,
  params: IdentityHashMap
}

fn cache_new() -> JCache !io =
  JCache {
    found: HashMap.new(),
    missing: HashMap.new(),
    methods: HashMap.new(),
    ctors: HashMap.new(),
    fields: HashMap.new(),
    desc: IdentityHashMap.new(),
    params: IdentityHashMap.new()
  }

## A cache for one question by a caller that keeps nothing: the module-level
## entry points below answer against the system loader and hold no oracle, so
## every one of their calls reflects afresh.
fn no_cache() -> JCache !io = cache_new()

## Reclaiming a cached row. Unlike the five walks further down this takes its
## target from a written type and not from a type parameter, so one helper per
## stored shape is enough.
fn cached_string(o: Object, at: String) -> String = {
  let got: Result[String, ForeignError] = cast(o)
  match got {
    Ok(s) -> s
    Err(e) -> panic("jreflect." ++ at ++ ": not a String: ${e.message}")
  }
}

fn cached_class(o: Object) -> Class = {
  let got: Result[Class, ForeignError] = cast(o)
  match got {
    Ok(c) -> c
    Err(e) -> panic("jreflect.resolve_class: not a Class: ${e.message}")
  }
}

## `find_class_raw_with` with both answers kept, the miss included: a miss
## costs a `forName` failure per step of the `$` walk, and the checker asks
## about the same names over and over.
fn resolve_class(jc: JCache, loader: ClassLoader, fqcn: String) -> Option[Class] !io = {
  match jc.found.get(fqcn) {
    Some(o) -> return Some(cached_class(o))
    None -> ()
  }
  if jc.missing.containsKey(fqcn) { return None }
  match find_class_raw_with(loader, fqcn) {
    Some(c) -> {
      jc.found.put(fqcn, c)
      Some(c)
    }
    None -> {
      jc.missing.put(fqcn, "")
      None
    }
  }
}

## The member arrays. `getMethods()` and friends hand back a fresh defensive
## copy on every call; we keep the first one and read it without ever writing
## to it, so the copy stays the JDK's guarantee and becomes ours as well.
fn methods_array(jc: JCache, loader: ClassLoader, fqcn: String) -> Object !io =
  match jc.methods.get(fqcn) {
    Some(a) -> a
    None -> {
      let c = resolve_class(jc, loader, fqcn).expect("methods_of on unresolved class")
      jc.methods.put(fqcn, c.getMethods().expect("methods"))
      jc.methods.get(fqcn).expect("methods just cached")
    }
  }

fn ctors_array(jc: JCache, loader: ClassLoader, fqcn: String) -> Object !io =
  match jc.ctors.get(fqcn) {
    Some(a) -> a
    None -> {
      let c = resolve_class(jc, loader, fqcn).expect("ctors_of on unresolved class")
      jc.ctors.put(fqcn, c.getConstructors().expect("constructors"))
      jc.ctors.get(fqcn).expect("constructors just cached")
    }
  }

fn fields_array(jc: JCache, loader: ClassLoader, fqcn: String) -> Object !io =
  match jc.fields.get(fqcn) {
    Some(a) -> a
    None -> {
      let c = resolve_class(jc, loader, fqcn).expect("static_fields_of on unresolved class")
      jc.fields.put(fqcn, c.getFields().expect("fields"))
      jc.fields.get(fqcn).expect("fields just cached")
    }
  }

## The parameter list, kept as one comma-joined string. A class name cannot
## contain a comma (the fact `sig_key` already rests on), so splitting is the
## join's exact inverse. Keeping the `Class[]` instead would still pay
## `getParameterTypes()`'s defensive clone and a reflective walk per query;
## measured on `java.lang.Math`, the string is the cheaper of the two.
##
## The list is only kept when the join reproduces it. That refuses nothing a
## Java class path actually holds; it is there so the cache cannot answer
## something reflection would not, on the evidence of this file alone.
fn split_params(joined: String) -> List[String] =
  if joined == "" { [] } else { str.split(joined, ",") }

fn method_params(jc: JCache, m: Method) -> List[String] !io =
  match jc.params.get(m) {
    Some(o) -> split_params(cached_string(o, "method_params"))
    None -> {
      let ps = class_names(
        Objects.requireNonNull(m.getParameterTypes().expect("param types")).expect("non-null"))
      let joined = join(ps, ",")
      if split_params(joined) == ps { let _ = jc.params.put(m, joined) }
      ps
    }
  }

fn ctor_params(jc: JCache, k: Constructor) -> List[String] !io =
  match jc.params.get(k) {
    Some(o) -> split_params(cached_string(o, "ctor_params"))
    None -> {
      let ps = class_names(
        Objects.requireNonNull(k.getParameterTypes().expect("param types")).expect("non-null"))
      let joined = join(ps, ",")
      if split_params(joined) == ps { let _ = jc.params.put(k, joined) }
      ps
    }
  }

## `desc` is `Method.toString()`, printed verbatim in overload-resolution error
## candidates. It is also the single most expensive field on the walk: the JDK
## renders modifiers, type names and the throws clause from scratch every call.
fn method_desc(jc: JCache, m: Method) -> String !io =
  match jc.desc.get(m) {
    Some(o) -> cached_string(o, "method_desc")
    None -> {
      let d = m.toString().expect("method toString")
      jc.desc.put(m, d)
      d
    }
  }

fn ctor_desc(jc: JCache, k: Constructor) -> String !io =
  match jc.desc.get(k) {
    Some(o) -> cached_string(o, "ctor_desc")
    None -> {
      let d = k.toString().expect("ctor toString")
      jc.desc.put(k, d)
      d
    }
  }

const ASM_BRIDGE_CLASS: String = "dawn.rt.Asm"
const ASM_WRITER_BRIDGE_CLASS: String = "dawn.rt.AsmWriter"
const ASM_CLASS_WRITER: String = "org.objectweb.asm.ClassWriter"

fn bridge_jclass(fqcn: String, simple: String) -> JClass =
  JClass {
    fqcn: fqcn,
    simple: simple,
    display: simple,
    is_interface: false,
    is_primitive: false,
    is_array: false
  }

fn bridge_class(fqcn: String) -> Option[JClass] =
  if fqcn == ASM_BRIDGE_CLASS {
    Some(bridge_jclass(fqcn, "Asm"))
  } else if fqcn == ASM_WRITER_BRIDGE_CLASS {
    Some(bridge_jclass(fqcn, "AsmWriter"))
  } else {
    None
  }

fn bridge_static(owner: String, name: String, params: List[String], ret: String) -> JMethod =
  JMethod {
    name: name,
    param_cls: params,
    ret_cls: ret,
    is_static: true,
    is_varargs: false,
    is_abstract: false,
    desc: "public static " ++ ret ++ " " ++ owner ++ "." ++ name ++
      "(" ++ join(params, ",") ++ ")",
    decl_cls: owner
  }

fn asm_bridge_methods() -> List[JMethod] =
  [bridge_static(ASM_BRIDGE_CLASS, "plain", ["int"], ASM_CLASS_WRITER),
    bridge_static(ASM_BRIDGE_CLASS, "beginOn",
      [ASM_CLASS_WRITER, "int", "int", "java.lang.String", "java.lang.String"], "void"),
    bridge_static(ASM_BRIDGE_CLASS, "beginOnWithInterface",
      [ASM_CLASS_WRITER, "int", "int", "java.lang.String", "java.lang.String",
        "java.lang.String"], "void"),
    bridge_static(ASM_BRIDGE_CLASS, "fieldOn",
      [ASM_CLASS_WRITER, "int", "java.lang.String", "java.lang.String"], "void"),
    bridge_static(ASM_BRIDGE_CLASS, "methodOn",
      [ASM_CLASS_WRITER, "int", "java.lang.String", "java.lang.String"],
      "org.objectweb.asm.MethodVisitor")]

fn asm_writer_bridge_methods() -> List[JMethod] =
  [bridge_static(ASM_WRITER_BRIDGE_CLASS, "of", ["int", "java.util.List"], ASM_CLASS_WRITER)]

fn target_has_asm(loader: ClassLoader) -> Bool !io =
  match find_class_raw_with(loader, ASM_CLASS_WRITER) {
    Some(_) -> true
    None -> false
  }

fn target_find_class_with(
  jc: JCache,
  loader: ClassLoader,
  asm_bridge: Bool,
  fqcn: String
) -> Option[JClass] !io =
  match bridge_class(fqcn) {
    Some(j) -> if asm_bridge { Some(j) } else { None }
    None -> find_class_with(jc, loader, fqcn)
  }

fn target_class_info_with(
  jc: JCache,
  loader: ClassLoader,
  asm_bridge: Bool,
  fqcn: String
) -> JClass !io =
  match target_find_class_with(jc, loader, asm_bridge, fqcn) {
    Some(j) -> j
    None -> panic("class vanished between target queries: ${fqcn}")
  }

fn target_methods_of_with(
  jc: JCache,
  loader: ClassLoader,
  asm_bridge: Bool,
  fqcn: String
) -> List[JMethod] !io =
  if asm_bridge && fqcn == ASM_BRIDGE_CLASS {
    asm_bridge_methods() ++ methods_of_with(jc, loader, "java.lang.Object")
  } else if asm_bridge && fqcn == ASM_WRITER_BRIDGE_CLASS {
    asm_writer_bridge_methods() ++ methods_of_with(jc, loader, ASM_CLASS_WRITER)
  } else {
    methods_of_with(jc, loader, fqcn)
  }

fn target_ctors_of_with(
  jc: JCache,
  loader: ClassLoader,
  asm_bridge: Bool,
  fqcn: String
) -> List[JCtor] !io =
  if asm_bridge && (fqcn == ASM_BRIDGE_CLASS || fqcn == ASM_WRITER_BRIDGE_CLASS) {
    []
  } else {
    ctors_of_with(jc, loader, fqcn)
  }

fn target_static_fields_of_with(
  jc: JCache,
  loader: ClassLoader,
  asm_bridge: Bool,
  fqcn: String
) -> List[JField] !io =
  if asm_bridge && fqcn == ASM_BRIDGE_CLASS {
    static_fields_of_with(jc, loader, "java.lang.Object")
  } else if asm_bridge && fqcn == ASM_WRITER_BRIDGE_CLASS {
    static_fields_of_with(jc, loader, ASM_CLASS_WRITER)
  } else {
    static_fields_of_with(jc, loader, fqcn)
  }

fn target_is_assignable_with(
  jc: JCache,
  loader: ClassLoader,
  asm_bridge: Bool,
  sup: String,
  sub: String
) -> Bool !io =
  if asm_bridge && sup == sub &&
  (sub == ASM_BRIDGE_CLASS || sub == ASM_WRITER_BRIDGE_CLASS) {
    true
  } else if asm_bridge && sub == ASM_BRIDGE_CLASS {
    is_assignable_with(jc, loader, sup, "java.lang.Object")
  } else if asm_bridge && sub == ASM_WRITER_BRIDGE_CLASS {
    is_assignable_with(jc, loader, sup, ASM_CLASS_WRITER)
  } else if asm_bridge && (sup == ASM_BRIDGE_CLASS || sup == ASM_WRITER_BRIDGE_CLASS) {
    false
  } else {
    is_assignable_with(jc, loader, sup, sub)
  }

fn target_sam_of_with(
  jc: JCache,
  loader: ClassLoader,
  asm_bridge: Bool,
  fqcn: String
) -> Option[JMethod] !io =
  if asm_bridge && (fqcn == ASM_BRIDGE_CLASS || fqcn == ASM_WRITER_BRIDGE_CLASS) {
    None
  } else {
    sam_of_with(jc, loader, fqcn)
  }

fn target_component_of_with(
  jc: JCache,
  loader: ClassLoader,
  asm_bridge: Bool,
  fqcn: String
) -> Option[String] !io =
  if asm_bridge && (fqcn == ASM_BRIDGE_CLASS || fqcn == ASM_WRITER_BRIDGE_CLASS) {
    None
  } else {
    component_of_with(jc, loader, fqcn)
  }

## The oracle these implementations add up to — what the JVM main hands the
## checker in place of the refusal `cx_new` starts with.
##
## It allocates: the oracle owns one `JCache`, so it is built here and not
## anywhere a caller could share it between two of them.
pub fn jsig_real() -> Jsig !io = {
  let jc = cache_new()
  let loader = sys_loader()
  Jsig {
    on: true,
    find_class: fqcn => find_class_with(jc, loader, fqcn),
    class_info: fqcn => class_info_with(jc, loader, fqcn),
    methods_of: fqcn => methods_of_with(jc, loader, fqcn),
    ctors_of: fqcn => ctors_of_with(jc, loader, fqcn),
    static_fields_of: fqcn => static_fields_of_with(jc, loader, fqcn),
    is_assignable: (sup, sub) => is_assignable_with(jc, loader, sup, sub),
    sam_of: fqcn => sam_of_with(jc, loader, fqcn),
    component_of: fqcn => component_of_with(jc, loader, fqcn)
  }
}

fn sys_loader() -> ClassLoader !io = ClassLoader.getSystemClassLoader().expect("system loader")

fn try_forname_with(loader: ClassLoader, name: String) -> Option[Class] !io =
  match catch_fault(() => Class.forName(name, false, loader).expect("forName")) {
    Ok(c) -> Some(c)
    Err(e) -> None
  }

fn loader_for(jars: List[String]) -> TargetLoader !io = {
  let url_class = Class.forName("java.net.URL").expect("URL class")
  let url_array_class = Class.forName("[Ljava.net.URL;").expect("URL array class")
  let loader_class = Class.forName("java.net.URLClassLoader").expect("URLClassLoader class")
  let parent_class = Class.forName("java.lang.ClassLoader").expect("ClassLoader class")
  let urls = Array.newInstance(url_class, len(jars)).expect("URL array")
  var index = 0
  for jar in jars {
    let url = File.new(jar).toURI().expect("jar URI").toURL().expect("jar URL")
    Array.set(urls, index, url)
    index = index + 1
  }
  let ctor = loader_class.getConstructor(url_array_class, parent_class).expect("URLClassLoader constructor")
  let parent = ClassLoader.getPlatformClassLoader().expect("platform loader")
  let raw = ctor.newInstance(urls, parent).expect("URLClassLoader instance")
  let closeable_claim: Result[URLClassLoader, ForeignError] = cast(raw)
  let closeable = match closeable_claim {
    Ok(loader) -> loader
    Err(e) -> panic("jreflect.loader_for: not a URLClassLoader: ${e.message}")
  }
  let base_claim: Result[ClassLoader, ForeignError] = cast(raw)
  let base = match base_claim {
    Ok(loader) -> loader
    Err(e) -> panic("jreflect.loader_for: not a ClassLoader: ${e.message}")
  }
  TargetLoader { base: base, closeable: closeable }
}

fn jsig_with(loader: ClassLoader, asm_bridge: Bool) -> Jsig !io = {
  let jc = cache_new()
  Jsig {
    on: true,
    find_class: fqcn => target_find_class_with(jc, loader, asm_bridge, fqcn),
    class_info: fqcn => target_class_info_with(jc, loader, asm_bridge, fqcn),
    methods_of: fqcn => target_methods_of_with(jc, loader, asm_bridge, fqcn),
    ctors_of: fqcn => target_ctors_of_with(jc, loader, asm_bridge, fqcn),
    static_fields_of: fqcn => target_static_fields_of_with(jc, loader, asm_bridge, fqcn),
    is_assignable: (sup, sub) => target_is_assignable_with(jc, loader, asm_bridge, sup, sub),
    sam_of: fqcn => target_sam_of_with(jc, loader, asm_bridge, fqcn),
    component_of: fqcn => target_component_of_with(jc, loader, asm_bridge, fqcn)
  }
}

fn lease_with(loader: TargetLoader, asm_bridge: Bool) -> JsigLease !io =
  JsigLease { jsig: jsig_with(loader.base, asm_bridge), close: () => loader.closeable.close() }

## A target-local oracle. Its platform parent exposes the JDK but not the
## compiler process's application class path. The two generated ASM bridges
## are plain-data overlays enabled only by ClassWriter in this same loader;
## their inherited answers never fall back to the system loader.
pub fn jsig_for(jars: List[String]) -> JsigLease !io = {
  let loader = loader_for(jars)
  lease_with(loader, target_has_asm(loader.base))
}

## Keep observation state at the JVM boundary, not in the shared checker.
## Each probe starts afresh and does not own or extend the underlying lease.
pub fn query_probe(js: Jsig) -> JsigProbe !io = {
  let count = AtomicLong.new(0)
  let observed = observe_queries(js, () => { let _ = count.incrementAndGet() })
  JsigProbe { jsig: observed, queries: () => count.get() }
}

## Resolve a `use java` name (spec §9.1): the fqcn as written, then trailing
## dots walked into `$` so nested classes read naturally.
fn find_class_raw_with(loader: ClassLoader, fqcn: String) -> Option[Class] !io = {
  match try_forname_with(loader, fqcn) {
    Some(c) -> return Some(c)
    None -> ()
  }
  var name = fqcn
  while str.contains(name, ".") {
    let i = str.last_index_of(name, ".").expect("contains dot")
    name = str.take(name, i) ++ "$" ++ str.drop(name, i + 1)
    match try_forname_with(loader, name) {
      Some(c) -> return Some(c)
      None -> ()
    }
  }
  None
}

pub fn find_class_raw(fqcn: String) -> Option[Class] !io = find_class_raw_with(sys_loader(), fqcn)

## The display name for a TyJava: readable array names ("byte[]"), else the
## fqcn's simple tail (Kotlin: canonicalName ?: fqcn, substringAfterLast('.')).
fn display_of(c: Class) -> String !io = {
  let fqcn = c.getName().expect("class name")
  if c.isArray() {
    let canon = match c.getCanonicalName() {
      Some(cn) -> cn
      None -> fqcn
    }
    tail_after_dot(canon)
  } else {
    tail_after_dot(fqcn)
  }
}

fn tail_after_dot(s: String) -> String =
  match str.rsplit_once(s, ".") {
    Some((_, tail)) -> tail
    None -> s
  }

fn jclass_of(c: Class) -> JClass !io =
  JClass {
    fqcn: c.getName().expect("class name"),
    simple: c.getSimpleName().expect("simple name"),
    display: display_of(c),
    is_interface: c.isInterface(),
    is_primitive: c.isPrimitive(),
    is_array: c.isArray()
  }

## Resolve a class name to plain data; None when nothing on the class path matches.
fn find_class_with(jc: JCache, loader: ClassLoader, fqcn: String) -> Option[JClass] !io =
  match resolve_class(jc, loader, fqcn) {
    Some(c) -> Some(jclass_of(c))
    None -> None
  }

pub fn find_class(fqcn: String) -> Option[JClass] !io =
  find_class_with(no_cache(), sys_loader(), fqcn)

## Class data for a name that is known to resolve (e.g. came from a Method).
fn class_info_with(jc: JCache, loader: ClassLoader, fqcn: String) -> JClass !io =
  match find_class_with(jc, loader, fqcn) {
    Some(j) -> j
    None -> panic("class vanished between queries: ${fqcn}")
  }

pub fn class_info(fqcn: String) -> JClass !io =
  class_info_with(no_cache(), sys_loader(), fqcn)

# The five reflective walks below all reclaim an erased `Array.get` element as
# the class the JDK declared the array to hold — `getMethods()` is `Method[]`,
# and nothing on this class path can make it otherwise. So a miss is a bug in
# this file rather than a condition, and the `cast` that hands the failure
# back as a value (LANG-02) is unwrapped by stopping the compiler with the walk
# named: the uncaught ClassCastException this replaces, minus the guessing
# about which of the five it came out of.
#
# Written out at each walk rather than behind one helper: `cast[T]` takes T
# from the expected type at the call site, so a `fn reclaim[T](o: Object) -> T`
# would check against T's erasure — `Object` — and pass everything.

fn class_names(arr: Object) -> List[String] !io = {
  var out: List[String] = []
  let n = Array.getLength(arr)
  var i = 0
  while i < n {
    let got: Result[Class, ForeignError] = cast(Array.get(arr, i).expect("class array element"))
    let c: Class = match got {
      Ok(v) -> v
      Err(e) -> panic("jreflect.class_names: not a Class: ${e.message}")
    }
    out = out ++ [c.getName().expect("class name")]
    i = i + 1
  }
  out
}

fn method_of(jc: JCache, m: Method) -> JMethod !io = {
  let mods = m.getModifiers()
  JMethod {
    name: m.getName().expect("method name"),
    param_cls: method_params(jc, m),
    ret_cls: m.getReturnType().expect("return type").getName().expect("class name"),
    is_static: Modifier.isStatic(mods),
    is_varargs: m.isVarArgs(),
    is_abstract: Modifier.isAbstract(mods),
    desc: method_desc(jc, m),
    decl_cls: m.getDeclaringClass().expect("declaring class").getName().expect("class name")
  }
}

## Every public method of `fqcn`, bridges and synthetics already dropped
## (the Kotlin checker filters them at every use site).
fn methods_of_with(jc: JCache, loader: ClassLoader, fqcn: String) -> List[JMethod] !io = {
  let arr = methods_array(jc, loader, fqcn)
  var out: List[JMethod] = []
  let n = Array.getLength(arr)
  var i = 0
  while i < n {
    let got: Result[Method, ForeignError] = cast(Array.get(arr, i).expect("method array element"))
    let m: Method = match got {
      Ok(v) -> v
      Err(e) -> panic("jreflect.methods_of: not a Method: ${e.message}")
    }
    if not m.isBridge() && not m.isSynthetic() { out = out ++ [method_of(jc, m)] }
    i = i + 1
  }
  out
}

pub fn methods_of(fqcn: String) -> List[JMethod] !io =
  methods_of_with(no_cache(), sys_loader(), fqcn)

## Every public constructor of `fqcn`, synthetics dropped.
fn ctors_of_with(jc: JCache, loader: ClassLoader, fqcn: String) -> List[JCtor] !io = {
  let arr = ctors_array(jc, loader, fqcn)
  var out: List[JCtor] = []
  let n = Array.getLength(arr)
  var i = 0
  while i < n {
    let got: Result[Constructor, ForeignError] = cast(Array.get(arr, i).expect("ctor array element"))
    let k: Constructor = match got {
      Ok(v) -> v
      Err(e) -> panic("jreflect.ctors_of: not a Constructor: ${e.message}")
    }
    if not k.isSynthetic() {
      out = out ++ [JCtor {
        param_cls: ctor_params(jc, k),
        is_varargs: k.isVarArgs(),
        desc: ctor_desc(jc, k)
      }]
    }
    i = i + 1
  }
  out
}

pub fn ctors_of(fqcn: String) -> List[JCtor] !io =
  ctors_of_with(no_cache(), sys_loader(), fqcn)

## Every public static field of `fqcn` (Class.getFields() returns only public
## members, including inherited ones; we keep the static ones). Spec §9.1.
fn static_fields_of_with(jc: JCache, loader: ClassLoader, fqcn: String) -> List[JField] !io = {
  let arr = fields_array(jc, loader, fqcn)
  var out: List[JField] = []
  let n = Array.getLength(arr)
  var i = 0
  while i < n {
    let got: Result[Field, ForeignError] = cast(Array.get(arr, i).expect("field array element"))
    let f: Field = match got {
      Ok(v) -> v
      Err(e) -> panic("jreflect.static_fields_of: not a Field: ${e.message}")
    }
    if Modifier.isStatic(f.getModifiers()) {
      out = out ++ [JField {
        name: f.getName().expect("field name"),
        type_cls: f.getType().expect("field type").getName().expect("class name"),
        decl_cls: f.getDeclaringClass().expect("declaring class").getName().expect("class name")
      }]
    }
    i = i + 1
  }
  out
}

pub fn static_fields_of(fqcn: String) -> List[JField] !io =
  static_fields_of_with(no_cache(), sys_loader(), fqcn)

## Class.isAssignableFrom over names: may `sub` stand where `sup` is expected?
fn is_assignable_with(jc: JCache, loader: ClassLoader, sup: String, sub: String) -> Bool !io =
  match resolve_class(jc, loader, sup) {
    None -> false
    Some(s) ->
      match resolve_class(jc, loader, sub) {
        None -> false
        Some(b) -> s.isAssignableFrom(b)
      }
  }

pub fn is_assignable(sup: String, sub: String) -> Bool !io =
  is_assignable_with(no_cache(), sys_loader(), sup, sub)

## What makes two methods the same overload: the name and the parameter list.
## A class name cannot contain a comma, so joining them is a faithful key.
fn sig_key(m: JMethod) -> String = m.name ++ "(" ++ join(m.param_cls, ",") ++ ")"

## The single abstract method of a functional interface, or None (spec §9.4).
##
## equals/hashCode/toString redeclared abstract on an interface do not count as
## the SAM, and a method declared on both an interface and its parent is one
## method. Both are set membership. They used to be linear scans inside the
## loop -- and the first of them re-enumerated `java.lang.Object`'s methods
## reflectively on every candidate, so a wide interface paid for Object once
## per method it declares.
fn sam_of_with(jc: JCache, loader: ClassLoader, fqcn: String) -> Option[JMethod] !io = {
  let j = class_info_with(jc, loader, fqcn)
  if not j.is_interface { return None }
  var from_object: Set[String] = set.empty()
  for om in methods_of_with(jc, loader, "java.lang.Object") {
    from_object = set.insert(from_object, sig_key(om))
  }
  var found: List[JMethod] = []
  var seen: Set[String] = set.empty()
  for m in methods_of_with(jc, loader, fqcn) {
    let key = sig_key(m)
    if m.is_abstract && not set.has(from_object, key) && not set.has(seen, key) {
      seen = set.insert(seen, key)
      found = found ++ [m]
    }
  }
  if len(found) == 1 { Some(found[0]) } else { None }
}

pub fn sam_of(fqcn: String) -> Option[JMethod] !io =
  sam_of_with(no_cache(), sys_loader(), fqcn)

## The component type name of an array class, or None.
fn component_of_with(jc: JCache, loader: ClassLoader, fqcn: String) -> Option[String] !io =
  match resolve_class(jc, loader, fqcn) {
    None -> None
    Some(c) ->
      match c.getComponentType() {
        Some(comp) -> Some(comp.getName().expect("class name"))
        None -> None
      }
  }

pub fn component_of(fqcn: String) -> Option[String] !io =
  component_of_with(no_cache(), sys_loader(), fqcn)

# ---- tests ----

test "query probes preserve the gate and keep independent counters" {
  let a = query_probe(jsig_real())
  let b = query_probe(jsig_real())
  assert a.jsig.on
  assert a.queries() == 0
  assert b.queries() == 0
  let find = a.jsig.find_class
  assert find("no.such.IncrementalProbeClass") == None
  assert a.queries() == 1
  assert b.queries() == 0
  let refused = refused_probe(jsig_refused())
  assert not refused.jsig.on
  assert refused.queries() == 0
  let off = query_probe(jsig_refused())
  assert not off.jsig.on
  assert off.queries() == 0
}

test "query probes count all eight hooks without changing their answers" {
  let base = jsig_real()
  let p = query_probe(base)
  let js = p.jsig
  let find = js.find_class
  let info = js.class_info
  let methods = js.methods_of
  let ctors = js.ctors_of
  let fields = js.static_fields_of
  let assignable = js.is_assignable
  let sam = js.sam_of
  let component = js.component_of
  let base_methods = base.methods_of
  let base_ctors = base.ctors_of
  let base_fields = base.static_fields_of
  match find("java.lang.String") {
    Some(c) -> { assert c.fqcn == "java.lang.String" }
    None -> { assert false }
  }
  assert p.queries() == 1
  assert info("java.lang.String").simple == "String"
  assert p.queries() == 2
  assert len(methods("java.lang.String")) == len(base_methods("java.lang.String"))
  assert p.queries() == 3
  assert len(ctors("java.lang.String")) == len(base_ctors("java.lang.String"))
  assert p.queries() == 4
  assert len(fields("java.lang.Integer")) == len(base_fields("java.lang.Integer"))
  assert p.queries() == 5
  assert assignable("java.lang.Object", "java.lang.String")
  assert not assignable("java.lang.String", "java.lang.Object")
  assert p.queries() == 7
  match sam("java.lang.Runnable") {
    Some(m) -> { assert m.name == "run" }
    None -> { assert false }
  }
  assert p.queries() == 8
  assert component("[I") == Some("int")
  assert p.queries() == 9
  let saved = p.queries()
  assert find("no.such.IncrementalProbeClass") == None
  assert saved == 9
  assert p.queries() == 10
}

test "classes resolve, including nested ones via the dollar walk" {
  assert class_info("java.lang.StringBuilder").simple == "StringBuilder"
  match find_class("java.util.Map.Entry") {
    Some(j) -> { assert j.fqcn == "java.util.Map\$Entry" }
    None -> { assert false }
  }
  assert find_class("no.such.Klass") == None
}

test "target-local leases retain the platform classes" {
  let lease = jsig_for([])
  let found: Option[JClass] = bracket(lease, held => held.close(), held => {
    let find = held.jsig.find_class
    find("java.lang.String")
  })
  match found {
    Some(j) -> { assert j.simple == "String" }
    None -> { assert false }
  }
}

test "a repeated query answers exactly what fresh reflection answers" {
  let js = jsig_real()
  let find = js.find_class
  let info = js.class_info
  let methods = js.methods_of
  let ctors = js.ctors_of
  let fields = js.static_fields_of
  let assignable = js.is_assignable
  let sam = js.sam_of
  let component = js.component_of
  let cls = "java.lang.Integer"
  # the module-level entries hold no oracle, so each of them reflects afresh:
  # they are the uncached control the kept answers are compared against.
  assert methods(cls) == methods_of(cls)
  assert methods(cls) == methods(cls)
  assert ctors(cls) == ctors_of(cls)
  assert ctors(cls) == ctors(cls)
  assert fields(cls) == static_fields_of(cls)
  assert fields(cls) == fields(cls)
  assert find(cls) == find_class(cls)
  assert info(cls) == class_info(cls)
  assert sam("java.util.Comparator") == sam_of("java.util.Comparator")
  assert component("[I") == component_of("[I")
  assert assignable("java.lang.Object", cls) == is_assignable("java.lang.Object", cls)
  # varargs and zero-argument parameter lists survive the round trip that
  # keeping a parameter list as one joined string puts it through
  assert methods("java.lang.String") == methods_of("java.lang.String")
  assert ctors("java.lang.String") == ctors_of("java.lang.String")
  # a name that does not resolve is kept as a miss, and stays one
  assert find("no.such.CachedClass") == None
  assert find("no.such.CachedClass") == None
  assert not assignable("no.such.CachedClass", cls)
  # the nested-class walk is answered from the same row on the second ask
  assert find("java.util.Map.Entry") == find_class("java.util.Map.Entry")
  assert find("java.util.Map.Entry") == find_class("java.util.Map.Entry")
}

test "each oracle keeps its own answers and inherits none" {
  # a class the compiler's own class path has and a bare target lease, whose
  # platform parent has not. A cache shared between oracles would answer the
  # second query out of the first one's row.
  let app = ASM_CLASS_WRITER
  let system = jsig_real()
  let system_find = system.find_class
  assert system_find(app) != None
  let lease = jsig_for([])
  let seen: (Option[JClass], Option[JClass]) = bracket(lease, held => held.close(), held => {
    let find = held.jsig.find_class
    (find(app), find("java.lang.String"))
  })
  let (target_app, target_string) = seen
  assert target_app == None
  assert target_string != None
  # and the closed lease left nothing behind for the next oracle to read
  let again = jsig_real()
  let again_find = again.find_class
  assert again_find(app) != None
}

test "methods carry their shapes" {
  let ms = methods_of("java.lang.Long")
  var found = false
  for m in ms {
    if m.name == "parseLong" && m.param_cls == ["java.lang.String", "int"] {
      found = true
      assert m.is_static
      assert m.ret_cls == "long"
    }
  }
  assert found
}

test "static fields carry their shapes" {
  let fs = static_fields_of("java.lang.Integer")
  var found = false
  for f in fs {
    if f.name == "MAX_VALUE" {
      found = true
      assert f.type_cls == "int"
    }
  }
  assert found
}

test "sam detection accepts runnable and comparator, rejects plain classes" {
  match sam_of("java.lang.Runnable") {
    Some(m) -> { assert m.name == "run" }
    None -> { assert false }
  }
  # Comparator has default methods and Object-shaped abstracts; the SAM is compare
  match sam_of("java.util.Comparator") {
    Some(m) -> { assert m.name == "compare" }
    None -> { assert false }
  }
  assert sam_of("java.lang.StringBuilder") == None
}

test "assignability over names" {
  assert is_assignable("java.lang.CharSequence", "java.lang.String")
  assert not is_assignable("java.lang.String", "java.lang.CharSequence")
}

test "array classes display readably" {
  let ms = methods_of("java.lang.String")
  var found = false
  for m in ms {
    if m.name == "getBytes" && m.param_cls == [] {
      found = true
      assert m.ret_cls == "[B"
    }
  }
  assert found
  assert class_info("[B").display == "byte[]"
}

## A caught throwable as the JVM renders it: `Throwable.toString()`, which is
## `<class>: <message>` and bare `<class>` when there was no message.
##
## Everywhere else a `ForeignError` reaches a message, the call site takes
## `.message` alone and leaves `.kind` out — a binary class name is the JVM's
## own vocabulary and printing it makes the text backend-specific. Here it is
## the answer: this module *is* the JVM reflection route, and "threw
## `java.lang.ArithmeticException`" is what the user needs to read. The class
## is also the half that says whether the `unsafe_pure` promise was broken by
## the arguments or by the method.
fn rendered(e: ForeignError) -> String =
  if e.message == "" { e.kind } else { e.kind ++ ": " ++ e.message }

## Invoke a public static method reflectively (comptime route C): the Method is
## found by exact parameter-class names, unreflected into a MethodHandle, and
## called with pre-boxed arguments. Err carries the thrown exception's rendering.
pub fn invoke_static(
  fqcn: String,
  name: String,
  param_cls: List[String],
  args: List[Object]
) -> Result[Option[Object], String] !io = {
  let c = match find_class_raw(fqcn) {
    Some(cc) -> cc
    None -> return Err("class not found: ${fqcn}")
  }
  let arr = c.getMethods().expect("methods")
  let n = Array.getLength(arr)
  var i = 0
  var found: List[Method] = []
  while i < n {
    let got: Result[Method, ForeignError] = cast(Array.get(arr, i).expect("method array element"))
    let m: Method = match got {
      Ok(v) -> v
      Err(e) -> panic("jreflect.invoke_static: not a Method: ${e.message}")
    }
    if len(found) == 0 && m.getName().expect("name") == name {
      let ps = class_names(Objects.requireNonNull(m.getParameterTypes().expect("param types")).expect("non-null"))
      if ps == param_cls { found = [m] }
    }
    i = i + 1
  }
  let m2 = match get(found, 0) {
    Some(mm) -> mm
    None -> return Err("no such method: " ++ fqcn ++ "." ++ name)
  }
  let lookup = MethodHandles.publicLookup().expect("lookup")
  let mh = match catch_fault(() => lookup.unreflect(m2).expect("unreflect")) {
    Ok(h) -> h
    Err(t) -> return Err(rendered(t))
  }
  match catch_fault(() => mh.invokeWithArguments(args)) {
    Ok(v) -> Ok(v)
    Err(t) -> Err(rendered(t))
  }
}

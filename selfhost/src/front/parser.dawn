# The Dawn parser, in Dawn (P3 first half; it began as a port of parse/Parser.kt,
# archived at kotlin-final). Same tree, same spans, same diagnostics — verified
# byte for byte against the *previous release* by scripts/selfhost-prev-diff.sh.
# (scripts/selfhost-parse-diff.sh went away with the Kotlin oracle it drove.)
#
# The Kotlin original holds a mutable token position plus a diagnostic sink and
# throws for parse failures; here both travel in an explicit state record `St`,
# every parse function returns `PR[T] = Result[(St, T), (St, Diag)]`, and `?`
# plays the role of the exception. The Err side carries the state at the point
# of failure (with all diagnostics accumulated so far) — recovery points
# (declaration and statement boundaries) append the fatal diagnostic and
# resynchronize from that position, exactly like the Kotlin catch blocks.
# The Kotlin `noStructLit` member becomes the threaded `nb` flag (no brace
# suffix): true inside if/while/for/match headers, reset by any bracket.

use std/str
use std/list
use front/token.{
  Token, TokKind, Seg, SText, SCode, Diag,
  INT, CHAR, FLOAT, STRING, IDENT, TYPEIDENT, UNDERSCORE, NEWLINE, EOF,
  FN, LET, VAR, TYPE, ALIAS, CONST, USE, JAVA, PUB, TRAIT, IMPL, EFFECT,
  MATCH, IF, ELSE, FOR, IN, WHILE, RETURN, BREAK, CONTINUE,
  COMPTIME, UNSAFE_PURE, TEST, ASSERT, WITH, TRUE, FALSE, NOT,
  LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
  COMMA, COLON, DOT, DOTDOT, QUESTION, ARROW, LARROW, FATARROW,
  EQ, EQEQ, NEQ, LT, LE, GT, GE,
  PLUS, MINUS, STAR, SLASH, PERCENT, PLUSPLUS, PIPEGT, PIPE,
  AMPAMP, PIPEPIPE, AMP, CARET, TILDE, SHL, SHR, USHR, BANG, AT,
  keyword
}
use front/ast.{
  TypeRef, TNamed, TQual, TAssoc, TTuple, TFn, Bound, TypeParamDecl, Param, LambdaParam,
  AssocDecl, AssocBind,
  FieldDecl, CtorDecl, ImportName, StrPart, SPText, SPInterp,
  BinOp, OpAdd, OpSub, OpMul, OpDiv, OpMod, OpConcat, OpEq, OpNeq, OpLt, OpLe,
  OpGt, OpGe, OpAnd, OpOr, OpBand, OpBor, OpBxor, OpShl, OpShr, OpUshr,
  UnOp, OpNeg, OpNot, OpBnot,
  Arg, pos_arg, trail_arg, MatchArm, Expr, EInt, EChar, EFloat, EBool, EUnit, EStr, EVar,
  EApply, EMethod, ELambda, ECtor, EFieldAcc, EListLit, ETupleLit, EPropagate,
  EUnwrap, EIndex, EReturn, EBreak, EContinue, EComptime, EUnsafePure,
  EBinary, EUnary, EIf, EMatch, EBlock, EHandle, HandlerArm,
  PatArg, Pattern, PLit, PBind, PWild, PCtor, PQual, PTuple, PList,
  Stmt, SLet, SLetPat, SLocalFn, SAssign, SExpr, SAssert, SWhile, SFor,
  TraitMethod, FnDecl, TypeDeclR, Decl, DFn, DType, DConst, DTrait, DImpl,
  DUseJava, DUseModule, DTest, DEffect, EffectDeclR, EffectOp, Module,
  e_lo, e_hi, t_lo, t_hi, pat_lo, pat_hi
}
use front/lexer.{lex, lex_at, view_of, slice_cp, SourceView}

# ---- parser state ----

## `view` is the decoded module source, present only when the module has an
## `assert` (which records its own source text — see `assert_stmt`). It is built
## once per module rather than per assert: `view_of` walks the whole file, so
## rebuilding it per assert makes parse allocation O(asserts x file size).
type P = { toks: List[Token], view: Option[SourceView] }

## Scan position plus the diagnostics accumulated so far (the Kotlin sink).
type St = { pos: Int, diags: List[Diag] }

alias PR[T] = Result[(St, T), (St, Diag)]

type TopDeclKind =
  | HFn
  | HType
  | HAlias
  | HConst
  | HTrait
  | HImpl
  | HEffect
  | HUse
  | HTest
  | HOpaqueType
  | HBadOpaque
  | HBadPub

type TopDeclHead = { kind: TopDeclKind, st: St, is_pub: Bool }

fn cur(p: P, st: St) -> Token = tok_at(p, st.pos, 0)

fn tok_at(p: P, pos: Int, ahead: Int) -> Token = {
  let i = pos + ahead
  let last = len(p.toks) - 1
  p.toks[if i > last { last } else { i }]
}

fn kind_of(p: P, st: St) -> TokKind = cur(p, st).kind

fn kind_ahead(p: P, st: St, ahead: Int) -> TokKind = tok_at(p, st.pos, ahead).kind

fn at_kind(p: P, st: St, k: TokKind) -> Bool = kind_of(p, st) == k

fn adv(p: P, st: St) -> (St, Token) = {
  let t = p.toks[st.pos]
  if st.pos < len(p.toks) - 1 {
    (St { ..st, pos: st.pos + 1 }, t)
  } else {
    (st, t)
  }
}

fn adv1(p: P, st: St) -> St = {
  let (st2, t) = adv(p, st)
  st2
}

fn skip_nl(p: P, st: St) -> St = {
  var s = st
  while at_kind(p, s, NEWLINE) { s = adv1(p, s) }
  s
}

fn pd(msg: String, lo: Int, hi: Int) -> Diag = Diag { msg: msg, lo: lo, hi: hi, hint: "" }

fn pd_h(msg: String, lo: Int, hi: Int, hint: String) -> Diag =
  Diag { msg: msg, lo: lo, hi: hi, hint: hint }

## A diagnostic at the current token (the Kotlin `err(msg)`).
fn perr(p: P, st: St, msg: String) -> Diag = {
  let t = cur(p, st)
  pd(msg, t.lo, t.hi)
}

fn perr_h(p: P, st: St, msg: String, hint: String) -> Diag = {
  let t = cur(p, st)
  pd_h(msg, t.lo, t.hi, hint)
}

fn want(p: P, st: St, k: TokKind, what: String) -> PR[Token] =
  if at_kind(p, st, k) {
    Ok(adv(p, st))
  } else {
    Err((st, perr(p, st, "expected " ++ what ++ ", found `" ++ cur(p, st).text ++ "`")))
  }

## Separator between statements/declarations: at least one NEWLINE (or block end / EOF).
fn want_sep(p: P, st: St) -> Result[St, (St, Diag)] =
  if at_kind(p, st, NEWLINE) {
    Ok(skip_nl(p, st))
  } else if at_kind(p, st, RBRACE) || at_kind(p, st, EOF) {
    Ok(st)
  } else {
    Err((st, perr_h(p, st, "expected a newline after this statement",
      "one statement per line; check whether the previous statement is complete")))
  }

fn is_blank_str(v: String) -> Bool = {
  for c in code_points(v) {
    if not char_is_space(c) { return false }
  }
  true
}

## Does this module need the source view at all? A module without `assert` never
## slices its own text, and decoding it would be pure waste.
fn has_assert(toks: List[Token]) -> Bool = {
  for t in toks {
    if t.kind == ASSERT { return true }
  }
  false
}

# ---- module ----

## Parse a whole file: lex, then descend. Never fails — broken declarations are
## reported and skipped, like the Kotlin recovery points.
pub fn parse_module(text: String) -> (Module, List[Diag]) = {
  let (toks, lexds) = lex(text)
  let p = P { toks: toks, view: if has_assert(toks) { Some(view_of(text)) } else { None } }
  var st = St { pos: 0, diags: lexds }
  var decls: List[Decl] = []
  st = skip_nl(p, st)
  while not at_kind(p, st, EOF) {
    match top_decl(p, st) {
      Ok(r) -> {
        let (st2, d) = r
        decls = decls ++ [d]
        st = st2
      }
      Err(fe) -> {
        let (st2, d) = fe
        st = sync_decl(p, St { ..st2, diags: st2.diags ++ [d] })
      }
    }
    st = skip_nl(p, st)
  }
  (Module { decls: decls }, st.diags)
}

fn classify_top_decl(p: P, st: St) -> Option[TopDeclHead] = {
  var st0 = st
  var is_pub = false
  if at_kind(p, st0, PUB) {
    st0 = adv1(p, st0)
    is_pub = true
  }
  let k = kind_of(p, st0)
  let kind: Option[TopDeclKind] =
    if k == FN { Some(HFn) }
    else if k == TYPE { Some(HType) }
    else if k == ALIAS { Some(HAlias) }
    else if k == CONST { Some(HConst) }
    else if k == TRAIT { Some(HTrait) }
    else if k == IMPL { Some(HImpl) }
    else if k == EFFECT { Some(HEffect) }
    else if k == USE { Some(HUse) }
    else if k == TEST { Some(HTest) }
    else if k == IDENT && cur(p, st0).text == "opaque" {
      if kind_ahead(p, st0, 1) == TYPE { Some(HOpaqueType) } else { Some(HBadOpaque) }
    }
    else if is_pub { Some(HBadPub) }
    else { None }
  match kind {
    Some(head) -> Some(TopDeclHead { kind: head, st: st0, is_pub: is_pub })
    None -> None
  }
}

fn starts_top_decl(p: P, st: St) -> Bool =
  match classify_top_decl(p, st) {
    Some(head) -> match head.kind {
      HBadOpaque -> false
      _ -> true
    }
    None -> false
  }

## After a broken declaration: skip forward to the next plausible declaration start.
fn sync_decl(p: P, st: St) -> St = {
  var s = st
  if not at_kind(p, s, EOF) { s = adv1(p, s) }
  while not at_kind(p, s, EOF) && not starts_top_decl(p, s) { s = adv1(p, s) }
  s
}

fn top_decl_error(p: P, st: St) -> PR[Decl] =
  Err((st, perr(p, st,
    "only declarations (use, fn, type, alias, const, trait, impl, effect, test) " ++
      "are allowed at module top level")))

fn top_decl(p: P, st: St) -> PR[Decl] =
  match classify_top_decl(p, st) {
    None -> top_decl_error(p, st)
    Some(head) -> match head.kind {
      HFn -> {
        let (st1, f) = fn_decl(p, head.st, head.is_pub, false)?
        Ok((st1, DFn(f)))
      }
      HType -> type_decl(p, head.st, head.is_pub)
      HAlias -> alias_decl(p, head.st, head.is_pub, false)
      HConst -> const_decl(p, head.st, head.is_pub)
      HTrait -> trait_decl(p, head.st, head.is_pub)
      HEffect -> effect_decl(p, head.st, head.is_pub)
      HImpl ->
        if head.is_pub {
          Err((head.st, perr(p, head.st,
            "an impl cannot be pub (its visibility follows the trait)")))
        } else {
          impl_decl(p, head.st)
        }
      HTest ->
        if head.is_pub {
          Err((head.st, perr(p, head.st, "test blocks cannot be pub")))
        } else {
          test_decl(p, head.st)
        }
      HUse ->
        if head.is_pub {
          Err((head.st, perr(p, head.st, "use declarations cannot be pub")))
        } else {
          use_decl(p, head.st)
        }
      HOpaqueType -> alias_decl(p, adv1(p, head.st), head.is_pub, true)
      HBadOpaque -> Err((head.st,
        perr(p, head.st, "`opaque` introduces `opaque type Name = ...`")))
      HBadPub -> top_decl_error(p, head.st)
    }
  }

# ---- use declarations ----

fn use_decl(p: P, st: St) -> PR[Decl] = {
  let (st1, kw) = adv(p, st)
  if at_kind(p, st1, JAVA) { java_use(p, st1, kw) } else { module_use(p, st1, kw) }
}

fn java_use(p: P, st: St, kw: Token) -> PR[Decl] = {
  let st1 = adv1(p, st)
  let (st2, s) = want(p, st1, STRING, "a quoted fully-qualified class name")?
  if has_code_seg(s.segs) {
    return Err((st2, pd("a class name cannot contain interpolation", s.lo, s.hi)))
  }
  let fqcn = seg_text(s.segs)
  let tail = match str.last_index_of(fqcn, ".") {
    Some(i) -> str.drop(fqcn, i + 1)
    None -> fqcn
  }
  let ok = not is_blank_str(fqcn) && str.len(tail) > 0 && char_is_upper(code_points(tail)[0])
  if not ok {
    return Err((st2, pd("expected a fully-qualified class name like \"java.lang.StringBuilder\"",
      s.lo, s.hi)))
  }
  Ok((st2, DUseJava(fqcn, kw.lo, s.hi, s.lo, s.hi)))
}

fn has_code_seg(segs: List[Seg]) -> Bool = {
  for sg in segs {
    match sg {
      SCode(c, o) -> return true
      SText(v) -> ()
    }
  }
  false
}

fn seg_text(segs: List[Seg]) -> String = {
  var out = ""
  for sg in segs {
    match sg {
      SText(v) -> { out = out ++ v }
      SCode(c, o) -> ()
    }
  }
  out
}

fn module_use(p: P, st: St, kw: Token) -> PR[Decl] = {
  let (st1, first) = want(p, st, IDENT, "a module path (like json/lexer) or `java`")?
  var segs = [first.text]
  var end_lo = first.lo
  var end_hi = first.hi
  var st2 = st1
  while at_kind(p, st2, SLASH) {
    let st3 = adv1(p, st2)
    let (st4, seg) = want(p, st3, IDENT, "a module path segment (lowercase)")?
    segs = segs ++ [seg.text]
    end_lo = seg.lo
    end_hi = seg.hi
    st2 = st4
  }
  let nlo = first.lo
  let nhi = end_hi
  if not at_kind(p, st2, DOT) {
    # optional `use a/b/c as name` rename (`as` is a contextual keyword — it is
    # only special right after a whole-module path, never reserved)
    let t = cur(p, st2)
    if t.kind == IDENT && t.text == "as" {
      let (st_al, an) = want(p, adv1(p, st2), IDENT, "an alias name after `as`")?
      let als = ImportName { name: an.text, lo: an.lo, hi: an.hi }
      return Ok((st_al, DUseModule(segs, None, Some(als), kw.lo, an.hi, nlo, nhi)))
    }
    return Ok((st2, DUseModule(segs, None, None, kw.lo, nhi, nlo, nhi)))
  }
  let st5 = adv1(p, st2)
  let (st6, o) = want(p, st5, LBRACE, "`{` to open a selective import list")?
  var names: List[ImportName] = []
  var st7 = skip_nl(p, st6)
  while not at_kind(p, st7, RBRACE) {
    let k = kind_of(p, st7)
    if k != IDENT && k != TYPEIDENT {
      return Err((st7, perr(p, st7, "expected an imported name (a function, type, or constant)")))
    }
    let (st8, n) = adv(p, st7)
    names = names ++ [ImportName { name: n.text, lo: n.lo, hi: n.hi }]
    st7 = skip_nl(p, st8)
    if at_kind(p, st7, COMMA) { st7 = skip_nl(p, adv1(p, st7)) } else { break }
  }
  let (st9, close) = want(p, st7, RBRACE, "`}`")?
  if len(names) == 0 {
    return Err((st9, pd_h("a selective import needs at least one name", nlo, close.hi,
      "use `use " ++ join(segs, "/") ++ "` to import the whole module")))
  }
  Ok((st9, DUseModule(segs, Some(names), None, kw.lo, close.hi, nlo, nhi)))
}

# ---- const and test declarations ----

fn const_decl(p: P, st: St, is_pub: Bool) -> PR[Decl] = {
  let (st1, kw) = want(p, st, CONST, "`const`")?
  let (st2, name) = want(p, st1, TYPEIDENT, "a constant name (SCREAMING_SNAKE_CASE)")?
  if has_lower(name.text) {
    return Err((st2, pd_h("constant names are SCREAMING_SNAKE_CASE", name.lo, name.hi,
      "lowercase names are values, UpperCamelCase names are types/constructors (spec §1.3)")))
  }
  let (st3, _) = want(p, st2, COLON, "`:` (constants must declare their type)")?
  let (st4, t) = type_ref(p, st3)?
  let (st5, _) = want(p, st4, EQ, "`=`")?
  let st6 = skip_nl(p, st5)
  let (st7, init) = expression(p, st6, false)?
  Ok((st7, DConst(name.text, is_pub, t, init, kw.lo, e_hi(init), name.lo, name.hi)))
}

fn has_lower(v: String) -> Bool = {
  for c in code_points(v) {
    if char_is_lower(c) { return true }
  }
  false
}

fn test_decl(p: P, st: St) -> PR[Decl] = {
  let (st1, kw) = adv(p, st)
  let (st2, name_tok) = want(p, st1, STRING, "a test name string")?
  if has_code_seg(name_tok.segs) {
    return Err((st2, pd("test names cannot contain interpolation", name_tok.lo, name_tok.hi)))
  }
  let name = seg_text(name_tok.segs)
  let (st3, body) = block_expr(p, st2)?
  Ok((st3, DTest(name, body, kw.lo, e_hi(body), name_tok.lo, name_tok.hi)))
}

# ---- type declarations ----

## [T, U] on fn/type declarations, with optional bounds on fns: [T: Ord + Show]
fn type_params(p: P, st: St) -> PR[List[TypeParamDecl]] = {
  if not at_kind(p, st, LBRACKET) {
    let none: List[TypeParamDecl] = []
    return Ok((st, none))
  }
  var st1 = adv1(p, st)
  var out: List[TypeParamDecl] = []
  while not at_kind(p, st1, RBRACKET) {
    let (st2, n) = want(p, st1, TYPEIDENT, "a type parameter name (uppercase)")?
    var bounds: List[Bound] = []
    var st3 = st2
    if at_kind(p, st3, COLON) {
      let st4 = adv1(p, st3)
      let (st5, first) = want(p, st4, TYPEIDENT, "a trait name after `:`")?
      bounds = [Bound { name: first.text, lo: first.lo, hi: first.hi }]
      st3 = st5
      while at_kind(p, st3, PLUS) {
        let st6 = adv1(p, st3)
        let (st7, b) = want(p, st6, TYPEIDENT, "a trait name after `+`")?
        bounds = bounds ++ [Bound { name: b.text, lo: b.lo, hi: b.hi }]
        st3 = st7
      }
    }
    let end = if len(bounds) > 0 { bounds[len(bounds) - 1].hi } else { n.hi }
    out = out ++ [TypeParamDecl { name: n.text, bounds: bounds, lo: n.lo, hi: end }]
    if at_kind(p, st3, COMMA) { st1 = adv1(p, st3) } else {
      st1 = st3
      break
    }
  }
  let (st8, _) = want(p, st1, RBRACKET, "`]`")?
  if len(out) == 0 {
    return Err((st8, perr(p, st8, "type parameter list cannot be empty")))
  }
  Ok((st8, out))
}

## `alias Name[T] = TypeRef` — a transparent type alias (spec §2.6) — and
## `opaque type Name[T] = TypeRef`, which parses identically and differs only
## in who may see through it. One parser, because the shapes are the same
## shape: a name, type parameters, and a target.
fn alias_decl(p: P, st: St, is_pub: Bool, is_opaque: Bool) -> PR[Decl] = {
  let (st1, kw) =
    if is_opaque { want(p, st, TYPE, "`type`")? } else { want(p, st, ALIAS, "`alias`")? }
  let (st2, name) = want(p, st1, TYPEIDENT, "a type name (uppercase)")?
  let (st3, tparam_decls) = type_params(p, st2)?
  for tp in tparam_decls {
    if len(tp.bounds) > 0 {
      let what = if is_opaque { "opaque type" } else { "alias" }
      return Err((st3, pd_h(what ++ " declarations cannot constrain their type parameters",
        tp.lo, tp.hi, "trait bounds go on the functions that use the type: fn f[T: Ord](...)")))
    }
  }
  let (st4, _) = want(p, st3, EQ, "`=`")?
  let (st5, target) = type_ref(p, st4)?
  let names = map(tparam_decls, t => t.name)
  Ok((st5, DType(TypeDeclR {
    is_pub: is_pub,
    is_opaque: is_opaque,
    name: name.text,
    tparams: names,
    ctors: [],
    is_record: false,
    derives: [],
    alias_target: Some(target),
    lo: kw.lo,
    hi: t_hi(target),
    nlo: name.lo,
    nhi: name.hi
  })))
}

fn is_builtin_scalar(name: String) -> Bool =
  match name {
    "Int" | "Float" | "Bool" | "String" | "Unit" -> true
    _ -> false
  }

fn type_decl(p: P, st: St, is_pub: Bool) -> PR[Decl] = {
  let (st1, kw) = want(p, st, TYPE, "`type`")?
  let (st2, name) = want(p, st1, TYPEIDENT, "a type name (uppercase)")?
  let (st3, tparam_decls) = type_params(p, st2)?
  for tp in tparam_decls {
    if len(tp.bounds) > 0 {
      return Err((st3, pd_h("type declarations cannot constrain their type parameters",
        tp.lo, tp.hi, "trait bounds go on the functions that use the type: fn f[T: Ord](...)")))
    }
  }
  let tparams = map(tparam_decls, t => t.name)
  let (st4, _) = want(p, st3, EQ, "`=`")?
  if at_kind(p, st4, LBRACE) {
    return record_decl(p, st4, is_pub, kw, name, tparams)
  }
  # `type` declares a nominal type only; an RHS that cannot begin a constructor
  # list is an alias, and aliases have their own keyword (spec §2.6)
  let builtin_scalar = at_kind(p, st4, TYPEIDENT) && is_builtin_scalar(cur(p, st4).text) &&
    kind_ahead(p, st4, 1) != LPAREN
  let aliasish = at_kind(p, st4, FN) || at_kind(p, st4, LPAREN) ||
    (at_kind(p, st4, TYPEIDENT) && kind_ahead(p, st4, 1) == LBRACKET) || builtin_scalar
  if aliasish {
    let (st5, target) = type_ref(p, st4)?
    let brackets = if len(tparams) == 0 { "" } else { "[" ++ join(tparams, ", ") ++ "]" }
    return Err((st5, pd_h(
      "`type` declares a nominal type (constructors or a record); this is an alias",
      kw.lo, t_hi(target),
      "write `alias " ++ name.text ++ brackets ++ " = ...` instead")))
  }
  var st6 = st4
  if at_kind(p, st6, PIPE) { st6 = adv1(p, st6) }
  st6 = skip_nl(p, st6)
  let (st7, first_ctor) = ctor_decl(p, st6)?
  var ctors = [first_ctor]
  var st8 = st7
  while true {
    # constructors usually sit one per line, | first (like vertical pipes)
    var look = st8.pos
    while p.toks[look].kind == NEWLINE { look = look + 1 }
    if p.toks[look].kind != PIPE { break }
    var st9 = St { ..st8, pos: look + 1 }
    st9 = skip_nl(p, st9)
    let (st10, c) = ctor_decl(p, st9)?
    ctors = ctors ++ [c]
    st8 = st10
  }
  let (st11, derives) = parse_derives(p, st8)?
  let end = if len(derives) > 0 { derives[len(derives) - 1].hi } else {
    ctors[len(ctors) - 1].hi
  }
  Ok((st11, DType(TypeDeclR {
    is_pub: is_pub,
    is_opaque: false,
    name: name.text,
    tparams: tparams,
    ctors: ctors,
    is_record: false,
    derives: derives,
    alias_target: None,
    lo: kw.lo,
    hi: end,
    nlo: name.lo,
    nhi: name.hi
  })))
}

## Optional trailing `derive Name (, Name)*`. `derive` is a soft keyword, so
## this peeks without consuming when absent.
fn parse_derives(p: P, st: St) -> PR[List[Bound]] = {
  var look = st.pos
  while p.toks[look].kind == NEWLINE { look = look + 1 }
  let lt = p.toks[look]
  if not (lt.kind == IDENT && lt.text == "derive") {
    let none: List[Bound] = []
    return Ok((st, none))
  }
  var st1 = St { ..st, pos: look + 1 }
  let (st2, first) = want(p, st1, TYPEIDENT, "a trait name to derive (Show or Ord)")?
  var out = [Bound { name: first.text, lo: first.lo, hi: first.hi }]
  var st3 = st2
  while at_kind(p, st3, COMMA) {
    let st4 = adv1(p, st3)
    let (st5, n) = want(p, st4, TYPEIDENT, "a trait name to derive")?
    out = out ++ [Bound { name: n.text, lo: n.lo, hi: n.hi }]
    st3 = st5
  }
  Ok((st3, out))
}

## type Point = { x: Float, y: Float } — a single-constructor product type
fn record_decl(
  p: P,
  st: St,
  is_pub: Bool,
  kw: Token,
  name: Token,
  tparams: List[String]
) -> PR[Decl] = {
  var st1 = skip_nl(p, adv1(p, st))
  var fields: List[FieldDecl] = []
  while not at_kind(p, st1, RBRACE) {
    let (st2, f) = want(p, st1, IDENT, "a field name")?
    let (st3, _) = want(p, st2, COLON, "`:` (record fields must be typed)")?
    let (st4, t) = type_ref(p, st3)?
    fields = fields ++ [FieldDecl { name: f.text, tref: t, lo: f.lo, hi: t_hi(t) }]
    st1 = skip_nl(p, st4)
    if at_kind(p, st1, COMMA) { st1 = skip_nl(p, adv1(p, st1)) } else { break }
  }
  let (st5, close) = want(p, st1, RBRACE, "`}`")?
  if len(fields) == 0 {
    return Err((st5, pd("a record must declare at least one field", kw.lo, close.hi)))
  }
  let ctor = CtorDecl {
    name: name.text,
    fields: fields,
    lo: name.lo,
    hi: close.hi,
    nlo: name.lo,
    nhi: name.hi
  }
  let (st6, derives) = parse_derives(p, st5)?
  let end = if len(derives) > 0 { derives[len(derives) - 1].hi } else { close.hi }
  Ok((st6, DType(TypeDeclR {
    is_pub: is_pub,
    is_opaque: false,
    name: name.text,
    tparams: tparams,
    ctors: [ctor],
    is_record: true,
    derives: derives,
    alias_target: None,
    lo: kw.lo,
    hi: end,
    nlo: name.lo,
    nhi: name.hi
  })))
}

fn ctor_decl(p: P, st: St) -> PR[CtorDecl] = {
  let (st1, name) = want(p, st, TYPEIDENT, "a constructor name (uppercase)")?
  if not at_kind(p, st1, LPAREN) {
    return Ok((st1, CtorDecl {
      name: name.text,
      fields: [],
      lo: name.lo,
      hi: name.hi,
      nlo: name.lo,
      nhi: name.hi
    }))
  }
  var st2 = skip_nl(p, adv1(p, st1))
  var fields: List[FieldDecl] = []
  while not at_kind(p, st2, RPAREN) {
    let (st3, f) = want(p, st2, IDENT, "a field name (constructor fields must be named)")?
    let (st4, _) = want(p, st3, COLON, "`:` (constructor fields must be typed)")?
    let (st5, t) = type_ref(p, st4)?
    fields = fields ++ [FieldDecl { name: f.text, tref: t, lo: f.lo, hi: t_hi(t) }]
    st2 = skip_nl(p, st5)
    if at_kind(p, st2, COMMA) { st2 = skip_nl(p, adv1(p, st2)) } else { break }
  }
  let (st6, close) = want(p, st2, RPAREN, "`)`")?
  if len(fields) == 0 {
    return Err((st6, pd_h("a constructor with `()` must declare at least one field",
      name.lo, close.hi,
      "drop the parentheses for a no-payload constructor: " ++ name.text)))
  }
  Ok((st6, CtorDecl {
    name: name.text,
    fields: fields,
    lo: name.lo,
    hi: close.hi,
    nlo: name.lo,
    nhi: name.hi
  }))
}

# ---- fn declarations ----

fn fn_decl(p: P, st: St, is_pub: Bool, in_impl: Bool) -> PR[FnDecl] = {
  let (st1, fn_tok) = want(p, st, FN, "`fn`")?
  let (st2, name_tok) = want(p, st1, IDENT, "a function name (lowercase)")?
  let (st3, tparams) = type_params(p, st2)?
  if in_impl && len(tparams) > 0 {
    let tp = tparams[0]
    return Err((st3, pd("impl methods cannot declare their own type parameters", tp.lo, tp.hi)))
  }
  let (st4, _) = want(p, st3, LPAREN, "`(`")?
  let (st5, params) = typed_params(p, st4, "top-level function")?
  let (st6, _) = want(p, st5, RPAREN, "`)`")?
  # pub functions are API: their full signature is the contract; private
  # functions may leave the return type (and effect) to inference
  var st7 = st6
  var ret: Option[TypeRef] = None
  if at_kind(p, st7, ARROW) {
    let st8 = adv1(p, st7)
    let (st9, t) = type_ref(p, st8)?
    ret = Some(t)
    st7 = st9
  } else if in_impl {
    let (st8, _) = want(p, st7, ARROW, "`->` (impl methods must declare their full signature)")?
    st7 = st8
  } else if is_pub {
    let (st8, _) = want(p, st7, ARROW, "`->` (pub functions must declare a return type)")?
    st7 = st8
  }
  let (st10, effs) = parse_effect(p, st7)?
  let (st11, _) = want(p, st10, EQ, "`=` (function body)")?
  let st12 = skip_nl(p, st11)
  let (st13, body) = expression(p, st12, false)?
  Ok((st13, FnDecl {
    is_pub: is_pub,
    name: name_tok.text,
    tparams: tparams,
    params: params,
    ret: ret,
    effs: effs,
    body: body,
    lo: fn_tok.lo,
    hi: e_hi(body),
    nlo: name_tok.lo,
    nhi: name_tok.hi
  }))
}

## name: Type, ... — the shared typed parameter list of fn/trait declarations
fn typed_params(p: P, st: St, what: String) -> PR[List[Param]] = {
  var params: List[Param] = []
  var st1 = skip_nl(p, st)
  while not at_kind(p, st1, RPAREN) {
    let (st2, n) = want(p, st1, IDENT, "a parameter name")?
    let (st3, _) = want(p, st2, COLON, "`:` (" ++ what ++ " parameters must be typed)")?
    let (st4a, t) = type_ref(p, st3)?
    var st4 = st4a
    # `= expr` is a default value (#207); which declarations consume one is
    # the registration passes' decision, not a parse-time special case
    var dflt: Option[Expr] = None
    if at_kind(p, st4, EQ) {
      let st5 = skip_nl(p, adv1(p, st4))
      let (st6, de) = expression(p, st5, false)?
      dflt = Some(de)
      st4 = st6
    }
    params = params ++ [Param { name: n.text, tref: t, default: dflt, lo: n.lo, hi: n.hi }]
    st1 = skip_nl(p, st4)
    if at_kind(p, st1, COMMA) { st1 = skip_nl(p, adv1(p, st1)) } else { break }
  }
  Ok((st1, params))
}

# ---- trait and impl declarations ----

fn trait_decl(p: P, st: St, is_pub: Bool) -> PR[Decl] = {
  let (st1, kw) = want(p, st, TRAIT, "`trait`")?
  let (st2, name) = want(p, st1, TYPEIDENT, "a trait name (uppercase)")?
  let (st3, _) = want(p, st2, LBRACKET,
    "`[` (a trait declares its subject type parameter: trait " ++ name.text ++ "[T])")?
  let (st4, tp) = want(p, st3, TYPEIDENT, "a type parameter name (uppercase)")?
  if at_kind(p, st4, COMMA) {
    return Err((st4, perr(p, st4, "a trait has exactly one type parameter")))
  }
  if at_kind(p, st4, COLON) {
    return Err((st4, perr_h(p, st4, "the trait's own type parameter cannot have bounds",
      "supertraits are not supported")))
  }
  let (st5, _) = want(p, st4, RBRACKET, "`]`")?
  let st6 = skip_nl(p, st5)
  let (st7, _) = want(p, st6, LBRACE, "`{` (the trait body)")?
  var st8 = skip_nl(p, st7)
  var methods: List[TraitMethod] = []
  var assoc: List[AssocDecl] = []
  while not at_kind(p, st8, RBRACE) && not at_kind(p, st8, EOF) {
    if at_kind(p, st8, TYPE) {
      let (st9, a) = trait_assoc(p, st8)?
      assoc = assoc ++ [a]
      st8 = want_sep(p, st9)?
    } else {
      let (st9, m) = trait_method(p, st8)?
      methods = methods ++ [m]
      st8 = want_sep(p, st9)?
    }
  }
  let (st10, close) = want(p, st8, RBRACE, "`}`")?
  if len(methods) == 0 {
    return Err((st10, pd("a trait must declare at least one method", kw.lo, close.hi)))
  }
  Ok((st10, DTrait(name.text, tp.text, tp.lo, tp.hi, methods, assoc, is_pub,
    kw.lo, close.hi, name.lo, name.hi)))
}

## `type Item` -- an associated type member, bare on purpose: no bounds, no
## default (assoc-types-design.md D1).
fn trait_assoc(p: P, st: St) -> PR[AssocDecl] = {
  let (st1, kw) = want(p, st, TYPE, "`type`")?
  let (st2, name_tok) = want(p, st1, TYPEIDENT, "an associated type name (uppercase)")?
  if at_kind(p, st2, COLON) {
    return Err((st2, perr_h(p, st2, "an associated type cannot declare bounds",
      "`type " ++ name_tok.text ++ "` is the whole declaration; the impl chooses the type")))
  }
  if at_kind(p, st2, EQ) {
    return Err((st2, perr_h(p, st2, "an associated type has no default",
      "the `= Type` binding belongs in each impl, not in the trait")))
  }
  Ok((st2, AssocDecl {
    name: name_tok.text,
    lo: kw.lo,
    hi: name_tok.hi,
    nlo: name_tok.lo,
    nhi: name_tok.hi
  }))
}

## fn cmp(a: T, b: T) -> Int [!io] [= default-body]
fn trait_method(p: P, st: St) -> PR[TraitMethod] = {
  let (st1, fn_tok) = want(p, st, FN, "`fn` (a trait body only contains method declarations)")?
  let (st2, name_tok) = want(p, st1, IDENT, "a method name (lowercase)")?
  if at_kind(p, st2, LBRACKET) {
    return Err((st2, perr_h(p, st2, "trait methods cannot declare their own type parameters",
      "the trait's subject type parameter is already in scope")))
  }
  let (st3, _) = want(p, st2, LPAREN, "`(`")?
  let (st4, params) = typed_params(p, st3, "trait method")?
  let (st5, _) = want(p, st4, RPAREN, "`)`")?
  let (st6, _) = want(p, st5, ARROW, "`->` (trait methods must declare a return type)")?
  let (st7, ret) = type_ref(p, st6)?
  let (st8, effs) = parse_effect(p, st7)?
  var body: Option[Expr] = None
  var st9 = st8
  if at_kind(p, st9, EQ) {
    let st10 = skip_nl(p, adv1(p, st9))
    let (st11, b) = expression(p, st10, false)?
    body = Some(b)
    st9 = st11
  }
  let end = match body {
    Some(b) -> e_hi(b)
    None -> tok_at(p, st9.pos, -1).hi
  }
  Ok((st9, TraitMethod {
    name: name_tok.text,
    params: params,
    ret: ret,
    effs: effs,
    body: body,
    lo: fn_tok.lo,
    hi: end,
    nlo: name_tok.lo,
    nhi: name_tok.hi
  }))
}

## effect Ask { fn ask() -> Int }
##
## The shape is a trait body without a subject: operation signatures, no
## bodies, no type parameters (docs/effects-design.md §3.1, D2). An operation
## carries no effect annotation of its own -- the effect it belongs to *is*
## its effect -- so `!io` on one is refused where it is written rather than
## silently ignored.
fn effect_decl(p: P, st: St, is_pub: Bool) -> PR[Decl] = {
  let (st1, kw) = want(p, st, EFFECT, "`effect`")?
  let (st2, name) = want(p, st1, TYPEIDENT, "an effect name (uppercase)")?
  if at_kind(p, st2, LBRACKET) {
    return Err((st2, perr_h(p, st2, "an effect cannot declare type parameters",
      "v1 effects are bare labels; specialize at the declaration instead")))
  }
  let st3 = skip_nl(p, st2)
  let (st4, _) = want(p, st3, LBRACE, "`{` (the effect body)")?
  var st5 = skip_nl(p, st4)
  var ops: List[EffectOp] = []
  while not at_kind(p, st5, RBRACE) && not at_kind(p, st5, EOF) {
    let (st6, op) = effect_op(p, st5)?
    ops = ops ++ [op]
    st5 = want_sep(p, st6)?
  }
  let (st7, close) = want(p, st5, RBRACE, "`}`")?
  if len(ops) == 0 {
    return Err((st7, pd("an effect must declare at least one operation", kw.lo, close.hi)))
  }
  Ok((st7, DEffect(EffectDeclR {
    is_pub: is_pub,
    name: name.text,
    ops: ops,
    lo: kw.lo,
    hi: close.hi,
    nlo: name.lo,
    nhi: name.hi
  })))
}

## fn ask() -> Int — one operation signature inside an `effect` body.
fn effect_op(p: P, st: St) -> PR[EffectOp] = {
  let (st1, fn_tok) = want(p, st, FN, "`fn` (an effect body only contains operations)")?
  let (st2, name_tok) = want(p, st1, IDENT, "an operation name (lowercase)")?
  if at_kind(p, st2, LBRACKET) {
    return Err((st2, perr_h(p, st2, "an effect operation cannot declare type parameters",
      "v1 effects are bare labels")))
  }
  let (st3, _) = want(p, st2, LPAREN, "`(`")?
  let (st4, params) = typed_params(p, st3, "effect operation")?
  let (st5, _) = want(p, st4, RPAREN, "`)`")?
  let (st6, _) = want(p, st5, ARROW, "`->` (an operation must declare a return type)")?
  let (st7, ret) = type_ref(p, st6)?
  if at_kind(p, st7, BANG) {
    return Err((st7, perr_h(p, st7, "an effect operation cannot declare effects of its own",
      "the operation's effect is the effect that declares it; what an arm does is " ++
        "recorded where the handler is installed")))
  }
  if at_kind(p, st7, EQ) {
    return Err((st7, perr_h(p, st7, "an effect operation cannot have a body",
      "the body is the handler arm: with handle E { " ++ name_tok.text ++ "(...) => ... }")))
  }
  let end = tok_at(p, st7.pos, -1).hi
  Ok((st7, EffectOp {
    name: name_tok.text,
    params: params,
    ret: ret,
    lo: fn_tok.lo,
    hi: end,
    nlo: name_tok.lo,
    nhi: name_tok.hi
  }))
}

## impl Ord[Point] { fn cmp(a: Point, b: Point) -> Int = ... }
##
## A conditional impl puts its own parameters first, like a fn does:
##   impl[T: Eq] Eq[List[T]] { ... }
## No ambiguity to resolve -- an unconditional impl has a trait name where a
## conditional one has `[`, so type_params' own "not at `[`" test decides.
fn impl_decl(p: P, st: St) -> PR[Decl] = {
  let (st0, kw) = want(p, st, IMPL, "`impl`")?
  let (st1, tparams) = type_params(p, st0)?
  let (st2, trait_tok) = want(p, st1, TYPEIDENT, "a trait name (uppercase)")?
  let (st3, _) = want(p, st2, LBRACKET,
    "`[` (an impl names its subject type: impl " ++ trait_tok.text ++ "[Point])")?
  let (st4, subject) = type_ref(p, st3)?
  let (st5, _) = want(p, st4, RBRACKET, "`]`")?
  let st6 = skip_nl(p, st5)
  let (st7, _) = want(p, st6, LBRACE, "`{` (the impl body)")?
  var st8 = skip_nl(p, st7)
  var methods: List[FnDecl] = []
  var assoc: List[AssocBind] = []
  while not at_kind(p, st8, RBRACE) && not at_kind(p, st8, EOF) {
    if at_kind(p, st8, PUB) {
      return Err((st8, perr(p, st8, "impl methods cannot be pub (their visibility follows the trait)")))
    }
    if at_kind(p, st8, TYPE) {
      let (st9, a) = impl_assoc(p, st8)?
      assoc = assoc ++ [a]
      st8 = want_sep(p, st9)?
    } else {
      let (st9, m) = fn_decl(p, st8, false, true)?
      methods = methods ++ [m]
      st8 = want_sep(p, st9)?
    }
  }
  let (st10, close) = want(p, st8, RBRACE, "`}`")?
  Ok((st10, DImpl(tparams, trait_tok.text, trait_tok.lo, trait_tok.hi, subject, methods,
    assoc, kw.lo, close.hi)))
}

## `type Item = X` -- the binding an impl owes for each associated type its
## trait declares. The RHS is resolved in the scope of the impl's own tparams.
fn impl_assoc(p: P, st: St) -> PR[AssocBind] = {
  let (st1, kw) = want(p, st, TYPE, "`type`")?
  let (st2, name_tok) = want(p, st1, TYPEIDENT, "an associated type name (uppercase)")?
  let (st3, _) = want(p, st2, EQ,
    "`=` (an impl binds each associated type: type " ++ name_tok.text ++ " = Int)")?
  let (st4, tref) = type_ref(p, st3)?
  Ok((st4, AssocBind {
    name: name_tok.text,
    tref: tref,
    lo: kw.lo,
    hi: t_hi(tref),
    nlo: name_tok.lo,
    nhi: name_tok.hi
  }))
}

# ---- type references ----

fn type_ref(p: P, st: St) -> PR[TypeRef] = {
  if at_kind(p, st, FN) { return fn_type_ref(p, st) }
  if at_kind(p, st, LPAREN) { return tuple_type_ref(p, st) }
  # `m.T` — a module-qualified type (LANG-06). A lowercase name in type
  # position can only be a module alias, so the shape is unambiguous.
  if at_kind(p, st, IDENT) {
    let (stq, q) = adv(p, st)
    let (stq1, _) = want(p, stq, DOT, "`.` (a lowercase name in type position is a module alias)")?
    let (stq2, t) = want(p, stq1, TYPEIDENT, "a type name (uppercase)")?
    let (stq3, pr) = type_args(p, stq2, t.hi)?
    let (args, hi) = pr
    return Ok((stq3, TQual(q.text, t.text, args, q.lo, hi)))
  }
  let (st1, t) = want(p, st, TYPEIDENT, "a type name (uppercase)")?
  # `T.Item` -- a projection (assoc-types-design.md D2). Only a bare uppercase
  # name may be the subject; after `Foo[..]` a `.` is refused here rather than
  # parsed, so the restriction is visible at the spelling and not two passes
  # later.
  if at_kind(p, st1, DOT) {
    let st2 = adv1(p, st1)
    let (st3, mem) = want(p, st2, TYPEIDENT, "an associated type name (uppercase)")?
    return Ok((st3, TAssoc(t.text, mem.text, t.lo, mem.hi)))
  }
  let (st2, pr) = type_args(p, st1, t.hi)?
  let (args, hi) = pr
  if at_kind(p, st2, DOT) && len(args) > 0 {
    return Err((st2, perr_h(p, st2, "a projection's subject must be a bare type parameter",
      "write `T.Item` where `T` carries the trait bound; `" ++ t.text ++
        "[..].Item` is not supported")))
  }
  if len(args) == 0 {
    Ok((st2, TNamed(t.text, [], t.lo, t.hi)))
  } else {
    Ok((st2, TNamed(t.text, args, t.lo, hi)))
  }
}

## The optional `[T, ...]` argument list after a type name; hi is the closing
## bracket's, or the given fallback when there is no list.
fn type_args(p: P, st: St, hi0: Int) -> PR[(List[TypeRef], Int)] = {
  if not at_kind(p, st, LBRACKET) {
    let none: List[TypeRef] = []
    return Ok((st, (none, hi0)))
  }
  var st2 = adv1(p, st)
  var args: List[TypeRef] = []
  while not at_kind(p, st2, RBRACKET) {
    let (st3, a) = type_ref(p, st2)?
    args = args ++ [a]
    if at_kind(p, st3, COMMA) { st2 = adv1(p, st3) } else {
      st2 = st3
      break
    }
  }
  let (st4, close) = want(p, st2, RBRACKET, "`]`")?
  if len(args) == 0 {
    return Err((st4, perr(p, st4, "type argument list cannot be empty")))
  }
  Ok((st4, (args, close.hi)))
}

## `(T)` — an AST-erased grouping, or `(A, B)` — a tuple type of 2 to 8 elements.
## A comma commits to the tuple reading, so `(T,)` remains an invalid
## one-element tuple rather than silently becoming a group.
fn tuple_type_ref(p: P, st: St) -> PR[TypeRef] = {
  let (st1, open) = adv(p, st)
  var st2 = st1
  var elems: List[TypeRef] = []
  var saw_comma = false
  while not at_kind(p, st2, RPAREN) {
    let (st3, t) = type_ref(p, st2)?
    elems = elems ++ [t]
    if at_kind(p, st3, COMMA) {
      saw_comma = true
      st2 = adv1(p, st3)
    } else {
      st2 = st3
      break
    }
  }
  let (st4, close) = want(p, st2, RPAREN, "`)`")?
  if len(elems) == 1 && not saw_comma {
    return Ok((st4, elems[0]))
  }
  if len(elems) == 0 {
    return Err((st4, pd_h("a tuple type needs at least 2 elements", open.lo, close.hi,
      "write a type inside the parentheses to group it, or provide at least 2 tuple elements")))
  }
  if len(elems) == 1 {
    return Err((st4, pd_h("a tuple type needs at least 2 elements", open.lo, close.hi,
      "`(T,)` is not a tuple; drop the comma to group the type as `(T)`")))
  }
  if len(elems) > 8 {
    return Err((st4, pd("tuples have at most 8 elements", open.lo, close.hi)))
  }
  Ok((st4, TTuple(elems, open.lo, close.hi)))
}

## fn(A, B) -> C !e
fn fn_type_ref(p: P, st: St) -> PR[TypeRef] = {
  let (st1, kw) = adv(p, st)
  let (st2, _) = want(p, st1, LPAREN, "`(`")?
  var st3 = st2
  var params: List[TypeRef] = []
  while not at_kind(p, st3, RPAREN) {
    let (st4, t) = type_ref(p, st3)?
    params = params ++ [t]
    if at_kind(p, st4, COMMA) { st3 = adv1(p, st4) } else {
      st3 = st4
      break
    }
  }
  let (st5, _) = want(p, st3, RPAREN, "`)`")?
  let (st6, _) = want(p, st5, ARROW, "`->`")?
  let (st7, ret) = type_ref(p, st6)?
  let (st8, effs) = parse_effect(p, st7)?
  # the last token consumed (the ret type or the effect) ends the span
  let end = tok_at(p, st8.pos, -1).hi
  Ok((st8, TFn(params, ret, effs, kw.lo, end)))
}

## One atom of an effect annotation. `io` and effect variables are lowercase
## idents; a declared effect is spelled with its own (uppercase) name, and
## which of the three an atom is stays a checker question -- the parser only
## says that a name is there.
fn effect_atom(p: P, st: St) -> PR[Token] = {
  if at_kind(p, st, TYPEIDENT) {
    return Ok(adv(p, st))
  }
  want(p, st, IDENT, "an effect name (io, an effect variable, or a declared effect)")
}

## Optional effect annotation after a return type: nothing (pure), `!io`, `!e`,
## `!Ask`, or a union `!(e1 | Ask | ...)`. Returns the atom names.
fn parse_effect(p: P, st: St) -> PR[List[String]] = {
  var atoms: List[String] = []
  var st0 = st
  # `!io !Ask` stacks: each `!` contributes its atoms to one row. A single
  # group is the whole of what existed before, and parses identically.
  while at_kind(p, st0, BANG) {
    let (st1, group) = effect_group(p, st0)?
    atoms = atoms ++ group
    st0 = st1
  }
  Ok((st0, atoms))
}

fn effect_group(p: P, st: St) -> PR[List[String]] = {
  if not at_kind(p, st, BANG) {
    let none: List[String] = []
    return Ok((st, none))
  }
  let st1 = adv1(p, st)
  if not at_kind(p, st1, LPAREN) {
    let (st2, n) = effect_atom(p, st1)?
    return Ok((st2, [n.text]))
  }
  let st2 = adv1(p, st1)
  let (st3, first) = effect_atom(p, st2)?
  var atoms = [first.text]
  var st4 = st3
  while at_kind(p, st4, PIPE) {
    let st5 = adv1(p, st4)
    let (st6, n) = effect_atom(p, st5)?
    atoms = atoms ++ [n.text]
    st4 = st6
  }
  let (st7, _) = want(p, st4, RPAREN, "`)` to close the effect union")?
  Ok((st7, atoms))
}

# ---- statements ----

fn statement(p: P, st: St) -> PR[Stmt] = {
  let k = kind_of(p, st)
  if k == LET {
    let_stmt(p, st, false)
  } else if k == VAR {
    let_stmt(p, st, true)
  } else if k == WHILE {
    while_stmt(p, st)
  } else if k == FOR {
    for_stmt(p, st)
  } else if k == ASSERT {
    assert_stmt(p, st)
  } else if k == IDENT {
    # assignment: IDENT = ... (as opposed to == comparison)
    if kind_ahead(p, st, 1) == EQ { assign_stmt(p, st) } else { expr_stmt(p, st) }
  } else if k == FN {
    # `fn name(...)` is a local function; a bare `fn(...)` is the retired
    # lambda prefix, and `primary_expr` has the diagnostic for it
    if kind_ahead(p, st, 1) == IDENT { local_fn_stmt(p, st) } else { expr_stmt(p, st) }
  } else {
    expr_stmt(p, st)
  }
}

fn local_fn_stmt(p: P, st: St) -> PR[Stmt] = {
  let (st1, fn_tok) = adv(p, st)
  let (st2, name_tok) = want(p, st1, IDENT, "a function name (lowercase)")?
  if at_kind(p, st2, LBRACKET) {
    return Err((st2, perr_h(p, st2, "local functions cannot declare type parameters",
      "the enclosing function's type parameters are in scope; or lift it to the top level")))
  }
  let (st3, _) = want(p, st2, LPAREN, "`(`")?
  var st4 = skip_nl(p, st3)
  var params: List[LambdaParam] = []
  while not at_kind(p, st4, RPAREN) {
    let (st5, n) = want(p, st4, IDENT, "a parameter name")?
    let (st6, _) = want(p, st5, COLON, "`:` (local function parameters must be typed)")?
    let (st7, t) = type_ref(p, st6)?
    # a local function is a function value to its callers (no Sig to carry a
    # default), so the parse refuses what the checker could never honour
    if at_kind(p, st7, EQ) {
      return Err((st7, perr_h(p, st7, "local function parameters cannot take default values",
        "lift the function to the top level")))
    }
    params = params ++ [LambdaParam { name: n.text, ann: Some(t), lo: n.lo, hi: n.hi }]
    st4 = skip_nl(p, st7)
    if at_kind(p, st4, COMMA) { st4 = skip_nl(p, adv1(p, st4)) } else { break }
  }
  let (st8, _) = want(p, st4, RPAREN, "`)`")?
  let (st9, _) = want(p, st8, ARROW, "`->` (local functions must declare a return type)")?
  let (st10, ret) = type_ref(p, st9)?
  let (st11, effs) = parse_effect(p, st10)?
  let (st12, _) = want(p, st11, EQ, "`=` (function body)")?
  let st13 = skip_nl(p, st12)
  let (st14, body) = expression(p, st13, false)?
  Ok((st14, SLocalFn(name_tok.text, params, ret, effs, body,
    name_tok.lo, name_tok.hi, fn_tok.lo, e_hi(body))))
}

fn let_stmt(p: P, st: St, mutable: Bool) -> PR[Stmt] = {
  let (st1, kw) = adv(p, st)
  # destructuring: let (a, b) = pair / let Point { x, y } = p / let [..all] = xs
  let k = kind_of(p, st1)
  if k == LPAREN || k == TYPEIDENT || k == LBRACKET {
    let (st2, pat) = pattern_p(p, st1)?
    if at_kind(p, st2, COLON) {
      return Err((st2, perr_h(p, st2, "destructuring lets cannot take a type annotation",
        "annotate inside the pattern's source instead")))
    }
    let (st3, _) = want(p, st2, EQ, "`=`")?
    let st4 = skip_nl(p, st3)
    let (st5, init) = expression(p, st4, false)?
    return Ok((st5, SLetPat(pat, mutable, init, kw.lo, e_hi(init))))
  }
  var st6 = st1
  var name = ""
  if at_kind(p, st6, IDENT) {
    let (st7, n) = adv(p, st6)
    name = n.text
    st6 = st7
  } else if at_kind(p, st6, UNDERSCORE) {
    if mutable {
      return Err((st6, perr(p, st6, "`var _` is meaningless")))
    }
    let (st7, n) = adv(p, st6)
    name = n.text
    st6 = st7
  } else {
    return Err((st6, perr(p, st6, "expected a variable name")))
  }
  var ann: Option[TypeRef] = None
  if at_kind(p, st6, COLON) {
    let st8 = adv1(p, st6)
    let (st9, t) = type_ref(p, st8)?
    ann = Some(t)
    st6 = st9
  }
  let (st10, _) = want(p, st6, EQ, "`=`")?
  let st11 = skip_nl(p, st10)
  let (st12, init) = expression(p, st11, false)?
  Ok((st12, SLet(name, mutable, ann, init, kw.lo, e_hi(init))))
}

fn assign_stmt(p: P, st: St) -> PR[Stmt] = {
  let (st1, name) = adv(p, st)
  let st2 = skip_nl(p, adv1(p, st1))
  let (st3, value) = expression(p, st2, false)?
  Ok((st3, SAssign(name.text, value, name.lo, name.hi, name.lo, e_hi(value))))
}

fn while_stmt(p: P, st: St) -> PR[Stmt] = {
  let (st1, kw) = adv(p, st)
  let (st2, cond) = expression(p, st1, true)?
  no_lambda_header(p, st2, cond, "while")?
  let (st3, body) = block_expr(p, st2)?
  Ok((st3, SWhile(cond, body, kw.lo, e_hi(body))))
}

## A header expression that came out a lambda swallowed the block that was
## meant to be the body: `while xs => { ... }` parses the braces as the lambda's
## body and then finds no `while` body at all, and `if x => y { ... }` reads the
## braces as the body of an `if` whose condition is a function. Both used to
## surface as an "expected `{`" or a type error about `fn(...)` and `Bool`,
## which point at the consequence rather than the decision (spec §4.5).
fn no_lambda_header(p: P, st: St, cond: Expr, kw: String) -> Result[Unit, (St, Diag)] =
  match cond {
    ELambda(_, _, _, lo, hi) ->
      Err((st, pd_h("this `" ++ kw ++ "` condition parsed as a lambda", lo, hi,
        "a lambda is not a `Bool`; parenthesise it if the call was meant to " ++
          "take one, as in `" ++ kw ++ " list.any(xs, x => x > 0) { ... }`")))
    _ -> Ok(())
  }

fn for_stmt(p: P, st: St) -> PR[Stmt] = {
  let (st1, kw) = adv(p, st)
  let (st2, name) = want(p, st1, IDENT, "a loop variable name")?
  let (st3, _) = want(p, st2, IN, "`in`")?
  let (st4, from) = expression(p, st3, true)?
  var to: Option[Expr] = None
  var st5 = st4
  if at_kind(p, st5, DOTDOT) {
    let st6 = adv1(p, st5)
    let (st7, t) = expression(p, st6, true)?
    to = Some(t)
    st5 = st7
  }
  let (st8, body) = block_expr(p, st5)?
  Ok((st8, SFor(name.text, from, to, body, kw.lo, e_hi(body))))
}

fn expr_stmt(p: P, st: St) -> PR[Stmt] = {
  let (st1, e) = expression(p, st, false)?
  Ok((st1, SExpr(e, e_lo(e), e_hi(e))))
}

fn assert_stmt(p: P, st: St) -> PR[Stmt] = {
  let (st1, kw) = adv(p, st)
  let (st2, cond) = expression(p, st1, false)?
  let src: Option[String] = match p.view {
    None -> None
    Some(v) -> Some(slice_cp(v, e_lo(cond), e_hi(cond)))
  }
  Ok((st2, SAssert(cond, src, kw.lo, e_hi(cond))))
}

# ---- expressions (by precedence) ----

fn expression(p: P, st: St, nb: Bool) -> PR[Expr] = pipe_expr(p, st, nb)

fn pipe_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  var (st1, left) = or_expr(p, st, nb)?
  while true {
    # vertical pipes: |> may start the next line
    var look = st1.pos
    while p.toks[look].kind == NEWLINE { look = look + 1 }
    if p.toks[look].kind != PIPEGT { break }
    let st2 = skip_nl(p, St { ..st1, pos: look + 1 })
    let (st3, rhs) = or_expr(p, st2, nb)?
    # `x |> f(a)` is `f(x, a)`: the pipe inserts `left` as the first argument of
    # a *named* call, or applies a bare name / lambda to it. Deliberately not
    # every application node -- `x |> make()(1)` and `x |> Some(1)` stay the
    # errors they were before calls became a general postfix (SYN-02).
    left = match rhs {
      EApply(EVar(name, vlo, vhi), args, _, rhi) ->
        EApply(EVar(name, vlo, vhi), [pos_arg(left)] ++ args, e_lo(left), rhi)
      EVar(name, vlo, vhi) -> EApply(EVar(name, vlo, vhi), [pos_arg(left)], e_lo(left), vhi)
      ELambda(ps, b, sg, llo, lhi) ->
        EApply(ELambda(ps, b, sg, llo, lhi), [pos_arg(left)], e_lo(left), lhi)
      other -> return Err((st3, pd_h(
        "the right side of `|>` must be a call, a function name, or a lambda",
        e_lo(other), e_hi(other), "x |> f(a) is equivalent to f(x, a)")))
    }
    st1 = st3
  }
  Ok((st1, left))
}

## A binary operator may lead its continuation line (spec §1.7), like `|>` and
## `.`. These helpers peek past newlines to such an operator; if the next real
## token isn't one, they return the state unchanged so a newline still ends the
## statement — hence existing code (where an operator never legally led a line)
## parses identically. `+`/`-` are excluded: leading `-` is ambiguous with unary
## minus, and the arithmetic pair stays together.
fn lead1(p: P, st: St, op: TokKind) -> St =
  if at_kind(p, st, op) {
    st
  } else {
    var look = st.pos
    while p.toks[look].kind == NEWLINE { look = look + 1 }
    if p.toks[look].kind == op { St { ..st, pos: look } } else { st }
  }

fn lead_op(p: P, st: St, classify: fn(TokKind) -> Option[BinOp]) -> St =
  match classify(kind_of(p, st)) {
    Some(_) -> st
    None -> {
      var look = st.pos
      while p.toks[look].kind == NEWLINE { look = look + 1 }
      match classify(p.toks[look].kind) {
        Some(_) -> St { ..st, pos: look }
        None -> st
      }
    }
  }

fn or_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  var (st1, left) = and_expr(p, st, nb)?
  while true {
    let sta = lead1(p, st1, PIPEPIPE)
    if not at_kind(p, sta, PIPEPIPE) { break }
    let (st2, op) = adv(p, sta)
    let st3 = skip_nl(p, st2)
    let (st4, right) = and_expr(p, st3, nb)?
    left = EBinary(OpOr, left, right, op.lo, op.hi, e_lo(left), e_hi(right))
    st1 = st4
  }
  Ok((st1, left))
}

fn and_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  var (st1, left) = cmp_expr(p, st, nb)?
  while true {
    let sta = lead1(p, st1, AMPAMP)
    if not at_kind(p, sta, AMPAMP) { break }
    let (st2, op) = adv(p, sta)
    let st3 = skip_nl(p, st2)
    let (st4, right) = cmp_expr(p, st3, nb)?
    left = EBinary(OpAnd, left, right, op.lo, op.hi, e_lo(left), e_hi(right))
    st1 = st4
  }
  Ok((st1, left))
}

fn cmp_op(k: TokKind) -> Option[BinOp] =
  if k == EQEQ { Some(OpEq) }
  else if k == NEQ { Some(OpNeq) }
  else if k == LT { Some(OpLt) }
  else if k == LE { Some(OpLe) }
  else if k == GT { Some(OpGt) }
  else if k == GE { Some(OpGe) }
  else { None }

fn cmp_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  let (st0, left) = bor_expr(p, st, nb)?
  let st1 = lead_op(p, st0, cmp_op)
  match cmp_op(kind_of(p, st1)) {
    None -> Ok((st1, left))
    Some(o) -> {
      let (st2, op) = adv(p, st1)
      let st3 = skip_nl(p, st2)
      let (st4b, right) = bor_expr(p, st3, nb)?
      let result = EBinary(o, left, right, op.lo, op.hi, e_lo(left), e_hi(right))
      # comparisons are non-associative: a < b < c is an error
      let st4 = lead_op(p, st4b, cmp_op)
      match cmp_op(kind_of(p, st4)) {
        Some(o2) -> Err((st4, perr_h(p, st4, "comparison operators cannot be chained",
          "write a < b && b < c")))
        None -> Ok((st4, result))
      }
    }
  }
}

# Bitwise sits between comparison and concat (Rust order, spec §4.3).
fn bor_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  var (st1, left) = bxor_expr(p, st, nb)?
  while true {
    let sta = lead1(p, st1, PIPE)
    if not at_kind(p, sta, PIPE) { break }
    let (st2, op) = adv(p, sta)
    let st3 = skip_nl(p, st2)
    let (st4, right) = bxor_expr(p, st3, nb)?
    left = EBinary(OpBor, left, right, op.lo, op.hi, e_lo(left), e_hi(right))
    st1 = st4
  }
  Ok((st1, left))
}

fn bxor_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  var (st1, left) = band_expr(p, st, nb)?
  while true {
    let sta = lead1(p, st1, CARET)
    if not at_kind(p, sta, CARET) { break }
    let (st2, op) = adv(p, sta)
    let st3 = skip_nl(p, st2)
    let (st4, right) = band_expr(p, st3, nb)?
    left = EBinary(OpBxor, left, right, op.lo, op.hi, e_lo(left), e_hi(right))
    st1 = st4
  }
  Ok((st1, left))
}

fn band_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  var (st1, left) = shift_expr(p, st, nb)?
  while true {
    let sta = lead1(p, st1, AMP)
    if not at_kind(p, sta, AMP) { break }
    let (st2, op) = adv(p, sta)
    let st3 = skip_nl(p, st2)
    let (st4, right) = shift_expr(p, st3, nb)?
    left = EBinary(OpBand, left, right, op.lo, op.hi, e_lo(left), e_hi(right))
    st1 = st4
  }
  Ok((st1, left))
}

fn shift_op(k: TokKind) -> Option[BinOp] =
  if k == SHL { Some(OpShl) }
  else if k == SHR { Some(OpShr) }
  else if k == USHR { Some(OpUshr) }
  else { None }

fn shift_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  var (st1, left) = concat_expr(p, st, nb)?
  while true {
    let sta = lead_op(p, st1, shift_op)
    match shift_op(kind_of(p, sta)) {
      None -> break
      Some(o) -> {
        let (st2, op) = adv(p, sta)
        let st3 = skip_nl(p, st2)
        let (st4, right) = concat_expr(p, st3, nb)?
        left = EBinary(o, left, right, op.lo, op.hi, e_lo(left), e_hi(right))
        st1 = st4
      }
    }
  }
  Ok((st1, left))
}

fn concat_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  # right-associative
  let (st1, left) = add_expr(p, st, nb)?
  let st1b = lead1(p, st1, PLUSPLUS)
  if not at_kind(p, st1b, PLUSPLUS) { return Ok((st1b, left)) }
  let (st2, op) = adv(p, st1b)
  let st3 = skip_nl(p, st2)
  let (st4, right) = concat_expr(p, st3, nb)?
  Ok((st4, EBinary(OpConcat, left, right, op.lo, op.hi, e_lo(left), e_hi(right))))
}

fn add_op(k: TokKind) -> Option[BinOp] =
  if k == PLUS { Some(OpAdd) }
  else if k == MINUS { Some(OpSub) }
  else { None }

fn add_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  var (st1, left) = mul_expr(p, st, nb)?
  while true {
    match add_op(kind_of(p, st1)) {
      None -> break
      Some(o) -> {
        let (st2, op) = adv(p, st1)
        let st3 = skip_nl(p, st2)
        let (st4, right) = mul_expr(p, st3, nb)?
        left = EBinary(o, left, right, op.lo, op.hi, e_lo(left), e_hi(right))
        st1 = st4
      }
    }
  }
  Ok((st1, left))
}

fn mul_op(k: TokKind) -> Option[BinOp] =
  if k == STAR { Some(OpMul) }
  else if k == SLASH { Some(OpDiv) }
  else if k == PERCENT { Some(OpMod) }
  else { None }

fn mul_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  var (st1, left) = unary_expr(p, st, nb)?
  while true {
    let sta = lead_op(p, st1, mul_op)
    match mul_op(kind_of(p, sta)) {
      None -> break
      Some(o) -> {
        let (st2, op) = adv(p, sta)
        let st3 = skip_nl(p, st2)
        let (st4, right) = unary_expr(p, st3, nb)?
        left = EBinary(o, left, right, op.lo, op.hi, e_lo(left), e_hi(right))
        st1 = st4
      }
    }
  }
  Ok((st1, left))
}

fn unary_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  let k = kind_of(p, st)
  if k == NOT {
    let (st1, t) = adv(p, st)
    let (st2, operand) = unary_expr(p, st1, nb)?
    Ok((st2, EUnary(OpNot, operand, t.lo, e_hi(operand))))
  } else if k == MINUS {
    let (st1, t) = adv(p, st)
    let next = cur(p, st1)
    if next.kind == INT && next.is_min_magnitude {
      let value = -9223372036854775807 - 1
      return postfix_tail(p, adv1(p, st1), EInt(value, t.lo, next.hi), nb)
    }
    let (st2, operand) = unary_expr(p, st1, nb)?
    Ok((st2, EUnary(OpNeg, operand, t.lo, e_hi(operand))))
  } else if k == TILDE {
    let (st1, t) = adv(p, st)
    let (st2, operand) = unary_expr(p, st1, nb)?
    Ok((st2, EUnary(OpBnot, operand, t.lo, e_hi(operand))))
  } else {
    postfix_expr(p, st, nb)
  }
}

fn postfix_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  let (st1, e) = primary_expr(p, st, nb)?
  postfix_tail(p, st1, e, nb)
}

fn postfix_tail(p: P, st: St, initial: Expr, nb: Bool) -> PR[Expr] = {
  var st1 = st
  var e = initial
  while true {
    let k = kind_of(p, st1)
    if k == QUESTION {
      let (st2, q) = adv(p, st1)
      e = EPropagate(e, e_lo(e), q.hi)
      st1 = st2
    } else if k == BANG {
      # postfix `!` unwraps an Option (spec §8.2); `!=` never gets here — the
      # lexer's two-char munch wins first
      let (st2, b) = adv(p, st1)
      e = EUnwrap(e, e_lo(e), b.hi)
      st1 = st2
    } else if k == LBRACKET {
      var st2 = skip_nl(p, adv1(p, st1))
      let (st3, idx) = expression(p, st2, false)?
      let st4 = skip_nl(p, st3)
      let (st5, close) = want(p, st4, RBRACKET, "`]`")?
      e = EIndex(e, idx, e_lo(e), close.hi)
      st1 = st5
    } else if k == DOT {
      let st2 = adv1(p, st1)
      let nt = cur(p, st2)
      if nt.kind == TYPEIDENT {
        # `Class.FIELD` static field access (spec §9.1) — field names are
        # UPPERCASE, so an uppercase name after `.` is always a field, not a call
        let st3 = adv1(p, st2)
        e = EFieldAcc(e, nt.text, nt.lo, nt.hi, e_lo(e), nt.hi)
        st1 = st3
      } else {
        # A member name after `.` may be any word — an identifier or a keyword
        # like `in`/`type` (Java members can be named that, e.g. `System.in`;
        # after `.` a keyword is unambiguously a member name, so accept it).
        let nt2 = cur(p, st2)
        let (st3, f) = if nt2.kind == IDENT || keyword(nt2.text) != None {
          adv(p, st2)
        } else {
          return Err((st2, perr(p, st2,
            "expected a field or function name after `.`, found `" ++ nt2.text ++ "`")))
        }
        if at_kind(p, st3, LPAREN) {
          let (st6, args, close) = call_args(p, st3)?
          e = EMethod(e, f.text, args, f.lo, f.hi, e_lo(e), close.hi)
          st1 = st6
        } else if at_kind(p, st3, LBRACE) && not nb {
          # paren-less tail block on a dot call: `xs.each { ... }` is the
          # method call `xs.each(() => ...)`. Decided here rather than in the
          # generic brace arm below so it calls the method instead of applying
          # the field's value.
          let (st6, lam) = tail_block_lambda(p, st3)?
          e = EMethod(e, f.text, [trail_arg(lam)], f.lo, f.hi, e_lo(e), e_hi(lam))
          st1 = st6
        } else {
          e = EFieldAcc(e, f.text, f.lo, f.hi, e_lo(e), f.hi)
          st1 = st3
        }
      }
    } else if k == LPAREN {
      # Application is a general postfix (SYN-02): every `(` after an
      # expression parses here -- `f(x)` and `Circle(1.0)` no longer have
      # special cases of their own, and `make()(1)`,
      # `(if c { f } else { g })(1)`, `get_handler()(req)` fall out for free.
      # Which kind of call it is (static, construction, function value, Java)
      # is the checker's decision, from what `e` resolves to.
      #
      # Same-line only, for free: a newline surfaces as a NEWLINE token first,
      # and that arm only continues a chain for `.` -- so `let x = f` followed
      # by a line `(1 + 2)` stays two statements (spec §4.3).
      let (st4, args, close) = call_args(p, st1)?
      # `f(a)(x) => e`: the arguments were already consumed as a call, which is
      # what a `(` after an expression always is. A bare arrow lambda cannot be
      # a trailing closure for exactly this reason -- `f(a)(x)` is a curried
      # call, and the two readings are indistinguishable until the `=>`
      # (spec §4.5). Say so rather than leaving `=>` to fail as a statement.
      if at_kind(p, st4, FATARROW) {
        return Err((st4, perr_h(p, st4,
          "a trailing closure must use a tail block",
          "write `f(a) { x => e }`; `(x)` already makes `f(a)(x)` a curried call")))
      }
      e = EApply(e, args, e_lo(e), close.hi)
      st1 = st4
    } else if k == FN {
      # The old trailing-closure spelling is recognized only to teach its
      # replacement. A newline reaches the NEWLINE arm first, so a local
      # function declaration on the next line remains a separate statement.
      return Err((st1, perr_h(p, st1,
        "the `fn` trailing-closure spelling has retired",
        "write `f(a) { x => e }`; tail-block parameters go inside the braces")))
    } else if k == LBRACE && not nb {
      # Tail block (spec §4.3): a bare `{ ... }` right after an expression is
      # a closure attached as that call's last argument -- `f(a) { e }` is
      # `f(a, () => e)`, and `items(xs) { x => e }` is `items(xs, x => e)`.
      # "It cannot be told apart from a paren-less `if` header's body" was the
      # old veto, and `nb` is the distinction it said could not exist: headers
      # set it, so their `{` never reaches this arm -- the same switch that
      # keeps `if p == P { x: 1 }` from reading the braces as a record.
      #
      # Same-line only, for free: a line break surfaces as a NEWLINE token
      # first, and that arm only continues a chain for `.` -- so a `{ ... }`
      # opening the next line stays the statement block it always was.
      #
      # A `{` whose previous token is `}` is refused rather than attached:
      # `if c { 1 } else { 2 } { 3 }`, `match x { ... } { ... }`,
      # `P { x: 1 } { ... }` and `f(a) { ... } { ... }` would each silently
      # apply a block to a value nobody reads as a callee, and the last one is
      # how "one call takes at most one tail block" holds without its own rule.
      if p.toks[st1.pos - 1].kind == RBRACE {
        return Err((st1, perr_h(p, st1,
          "a tail block cannot follow `}`; it attaches to the call before it",
          "to apply a block to this value anyway, parenthesise the value first: `(...) { ... }`")))
      }
      let (st7, lam) = tail_block_lambda(p, st1)?
      e = attach_trailing(e, lam)
      st1 = st7
    } else if k == NEWLINE {
      # vertical method chains: `.` may start the next line (spec §1.7)
      var look = st1.pos
      while p.toks[look].kind == NEWLINE { look = look + 1 }
      if p.toks[look].kind != DOT { return Ok((st1, e)) }
      st1 = St { ..st1, pos: look }
    } else {
      return Ok((st1, e))
    }
  }
  Ok((st1, e))
}

fn is_bare_return_boundary(k: TokKind) -> Bool =
  k == NEWLINE || k == RBRACE || k == RPAREN || k == RBRACKET || k == COMMA || k == EOF

fn primary_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  let t = cur(p, st)
  let k = t.kind
  if k == INT {
    if t.is_min_magnitude {
      return Err((st, pd_h("integer literal out of 64-bit range: " ++ t.text, t.lo, t.hi,
        "this magnitude is valid only directly after unary `-`, as in `-9223372036854775808`")))
    }
    Ok((adv1(p, st), EInt(t.ival, t.lo, t.hi)))
  } else if k == CHAR {
    Ok((adv1(p, st), EChar(t.ival, t.lo, t.hi)))
  } else if k == FLOAT {
    Ok((adv1(p, st), EFloat(t.fval, t.lo, t.hi)))
  } else if k == TRUE {
    Ok((adv1(p, st), EBool(true, t.lo, t.hi)))
  } else if k == FALSE {
    Ok((adv1(p, st), EBool(false, t.lo, t.hi)))
  } else if k == STRING {
    str_lit(p, adv1(p, st), t)
  } else if k == IDENT {
    # `x => e`: one token of lookahead past a name. Nothing else in the grammar
    # puts `=>` after a bare identifier, so no backtracking is needed.
    if kind_ahead(p, st, 1) == FATARROW {
      bare_lambda1(p, st, nb)
    } else {
      let (st1, name) = adv(p, st)
      Ok((st1, EVar(name.text, name.lo, name.hi)))
    }
  } else if k == IF {
    if_expr(p, st)
  } else if k == MATCH {
    match_expr(p, st)
  } else if k == RETURN {
    let st1 = adv1(p, st)
    if is_bare_return_boundary(kind_of(p, st1)) {
      Ok((st1, EReturn(None, t.lo, t.hi)))
    } else {
      let (st2, v) = expression(p, st1, nb)?
      Ok((st2, EReturn(Some(v), t.lo, e_hi(v))))
    }
  } else if k == BREAK {
    Ok((adv1(p, st), EBreak(t.lo, t.hi)))
  } else if k == CONTINUE {
    Ok((adv1(p, st), EContinue(t.lo, t.hi)))
  } else if k == LBRACE {
    block_expr(p, st)
  } else if k == LPAREN {
    paren_expr(p, st, nb)
  } else if k == LBRACKET {
    list_lit(p, st)
  } else if k == FN {
    # `fn` introduces declarations only (spec §4.5). A lambda is `x => e` /
    # `(a, b) => e` / `() => e`, so `fn` in primary position is always the
    # retired prefix form.
    Err((st, perr_h(p, st, "`fn` marks declarations only; a lambda has no `fn` prefix",
      "write `(x) => e`, or `x => e` for a single unannotated parameter")))
  } else if k == COMPTIME {
    let st1 = adv1(p, st)
    let (st2, b) = block_expr(p, st1)?
    Ok((st2, EComptime(b, t.lo, e_hi(b))))
  } else if k == UNSAFE_PURE {
    let st1 = adv1(p, st)
    let (st2, b) = block_expr(p, st1)?
    Ok((st2, EUnsafePure(b, t.lo, e_hi(b))))
  } else if k == TYPEIDENT {
    ctor_expr(p, st, nb)
  } else if k == WITH {
    # `with` is a statement, not an expression: it needs a rest-of-block to turn
    # into a closure, and only a block has one (spec §4.10).
    Err((st, perr_h(p, st, "`with` is a statement and needs an enclosing block",
      "wrap the body in braces: fn f() = { with x <- g(...) ... }")))
  } else {
    Err((st, perr(p, st, "expected an expression, found `" ++ t.text ++ "`")))
  }
}

## The head of a constructor spelling: bare `None` / `Point`, or the record
## literal `Point { x: 1.0 }` / `Point { ..p, x: 3.0 }`. `Circle(1.0)` is *not*
## parsed here -- the parenthesised form is the general application postfix
## over this bare head (SYN-02), and `check_apply` turns it back into a
## construction because that is what the head resolves to.
fn ctor_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  let (st1, name) = adv(p, st)
  if at_kind(p, st1, LBRACE) && not nb { return record_lit(p, st1, name) }
  let none: List[Arg] = []
  Ok((st1, ECtor(name.text, none, None, false, name.lo, name.hi, name.lo, name.hi)))
}

## `( arg, ... )` — the EBNF `call_args`, shared by the application postfix and
## by the dot call. `st` is at the `(`. An argument may be written `name: expr`
## anywhere (SYN-03); only constructors accept that, and saying so is the
## checker's job (docs/audit/application-syntax-design.md §3.2).
fn call_args(p: P, st: St) -> Result[(St, List[Arg], Token), (St, Diag)] = {
  var st1 = skip_nl(p, adv1(p, st))
  var args: List[Arg] = []
  while not at_kind(p, st1, RPAREN) {
    if at_kind(p, st1, IDENT) && kind_ahead(p, st1, 1) == COLON {
      let (st2, arg_name) = adv(p, st1)
      let st3 = skip_nl(p, adv1(p, st2))
      let (st4, value) = expression(p, st3, false)?
      args = args ++ [Arg { name: Some(arg_name.text), e: value, trailing: false, lo: arg_name.lo, hi: e_hi(value) }]
      st1 = st4
    } else {
      let (st2, value) = expression(p, st1, false)?
      args = args ++ [pos_arg(value)]
      st1 = st2
    }
    st1 = skip_nl(p, st1)
    if at_kind(p, st1, COMMA) { st1 = skip_nl(p, adv1(p, st1)) } else { break }
  }
  let (st5, close) = want(p, st1, RPAREN, "`)`")?
  Ok((st5, args, close))
}

fn record_lit(p: P, st: St, name: Token) -> PR[Expr] = {
  var st1 = skip_nl(p, adv1(p, st))
  var spread: Option[Expr] = None
  if at_kind(p, st1, DOTDOT) {
    let st2 = adv1(p, st1)
    let (st3, s) = expression(p, st2, false)?
    spread = Some(s)
    st1 = skip_nl(p, st3)
    if at_kind(p, st1, COMMA) {
      st1 = skip_nl(p, adv1(p, st1))
    } else if not at_kind(p, st1, RBRACE) {
      return Err((st1, perr(p, st1, "expected `,` or `}` after the `..base` spread")))
    }
  }
  var args: List[Arg] = []
  while not at_kind(p, st1, RBRACE) {
    if at_kind(p, st1, DOTDOT) {
      return Err((st1, perr(p, st1, "`..base` must come first in a record literal")))
    }
    let (st2, f) = want(p, st1, IDENT, "a field name")?
    if at_kind(p, st2, COLON) {
      let st3 = skip_nl(p, adv1(p, st2))
      let (st4, value) = expression(p, st3, false)?
      args = args ++ [Arg { name: Some(f.text), e: value, trailing: false, lo: f.lo, hi: e_hi(value) }]
      st1 = st4
    } else if at_kind(p, st2, LPAREN) {
      # `Column { text("a") }`: an uppercase name takes its braces as a record
      # literal (spec §2.3), so this call sits in a field position and the
      # plain "expected `}`" would point at the consequence, not the decision.
      return Err((st2, perr_h(p, st2,
        "`" ++ name.text ++ "` is a type name, so its braces are a record literal, " ++
          "not a tail block",
        "a tail block only attaches to a call; component functions use lowercase names")))
    } else {
      # shorthand { x } means { x: x }
      let value = EVar(f.text, f.lo, f.hi)
      args = args ++ [Arg { name: Some(f.text), e: value, trailing: false, lo: f.lo, hi: f.hi }]
      st1 = st2
    }
    st1 = skip_nl(p, st1)
    if at_kind(p, st1, COMMA) { st1 = skip_nl(p, adv1(p, st1)) } else { break }
  }
  let (st5, close) = want(p, st1, RBRACE, "`}`")?
  Ok((st5, ECtor(name.text, args, spread, true, name.lo, name.hi, name.lo, close.hi)))
}

## Parse the segments of a STRING token: text stays text, each interpolation is
## re-lexed at its own offset and parsed as one expression (the Kotlin
## sub-Parser). `st` is the state just past the STRING token.
fn str_lit(p: P, st: St, t: Token) -> PR[Expr] = {
  var parts: List[StrPart] = []
  var diags = st.diags
  for sg in t.segs {
    match sg {
      SText(v) -> { parts = parts ++ [SPText(v)] }
      SCode(src, o) -> {
        let (subtoks, lexds) = lex_at(src, o)
        diags = diags ++ lexds
        let subp = P { toks: subtoks, view: None }
        let sst = St { pos: 0, diags: diags }
        match expression(subp, sst, false) {
          Err(fe) -> {
            let (fst, d) = fe
            return Err((St { ..st, diags: fst.diags }, d))
          }
          Ok(r) -> {
            let (sst2, e) = r
            let sst3 = skip_nl(subp, sst2)
            if not at_kind(subp, sst3, EOF) {
              return Err((St { ..st, diags: sst3.diags },
                perr(subp, sst3, "trailing content in interpolation")))
            }
            diags = sst3.diags
            parts = parts ++ [SPInterp(e)]
          }
        }
      }
    }
  }
  Ok((St { ..st, diags: diags }, EStr(parts, t.lo, t.hi)))
}

## `( name [: type] , ... )`, the parameter list both lambda spellings share.
## `st` is at the `(`; the result is positioned just past the `)`.
##
## `bare` picks the diagnostic. After `fn` the `(` has already committed to a
## parameter list, so "expected a parameter name" is the whole story. In the
## bare form the same tokens could have been a parenthesised expression until
## the `=>` arrived, so a wrong element gets a message that says which decision
## was made and what broke it.
fn lambda_params(p: P, st: St, bare: Bool) -> Result[(St, List[LambdaParam]), (St, Diag)] = {
  let (st1, _) = want(p, st, LPAREN, "`(`")?
  var st2 = skip_nl(p, st1)
  var params: List[LambdaParam] = []
  while not at_kind(p, st2, RPAREN) {
    if not at_kind(p, st2, IDENT) {
      return Err((st2, param_err(p, st2, bare, "a parameter name")))
    }
    let (st3, name) = adv(p, st2)
    var ann: Option[TypeRef] = None
    var st4 = st3
    if at_kind(p, st4, COLON) {
      let st5 = adv1(p, st4)
      let (st6, t) = type_ref(p, st5)?
      ann = Some(t)
      st4 = st6
    }
    params = params ++ [LambdaParam { name: name.text, ann: ann, lo: name.lo, hi: name.hi }]
    st2 = skip_nl(p, st4)
    if at_kind(p, st2, COMMA) {
      st2 = skip_nl(p, adv1(p, st2))
    } else if bare && not at_kind(p, st2, RPAREN) {
      # `(a + 1) => e`: the `(` was reinterpreted as a parameter list the
      # moment `=>` was seen, and `+` is where that reading fails. Naming the
      # token is the difference between this and a bare "expected `)`".
      return Err((st2, param_err(p, st2, bare, "`,` or `)`")))
    } else {
      break
    }
  }
  let (st7, _) = want(p, st2, RPAREN, "`)`")?
  Ok((st7, params))
}

fn param_err(p: P, st: St, bare: Bool, what: String) -> Diag = {
  let found = "expected " ++ what ++ ", found `" ++ cur(p, st).text ++ "`"
  if bare {
    perr_h(p, st, "invalid parameter list before `=>`: " ++ found,
      "an arrow lambda's parameters are plain names, each optionally `: Type`")
  } else {
    perr(p, st, found)
  }
}

## Does the parenthesised group starting at `st` close with `=>` right after
## it? The one token of lookahead the bare arrow forms need, done by scanning
## to the matching `)` rather than by parsing and backtracking.
##
## A cover grammar cannot decide this here: `(a: Int) => e` is a legal
## parameter list and not a legal expression, so the reinterpretation has to
## happen before the group is parsed, not after (spec §4.5).
fn paren_is_lambda(p: P, st: St) -> Bool = {
  var i = st.pos
  var depth = 0
  let last = len(p.toks) - 1
  while i <= last {
    let k = p.toks[i].kind
    if k == EOF {
      return false
    } else if k == LPAREN || k == LBRACKET || k == LBRACE {
      depth = depth + 1
    } else if k == RPAREN || k == RBRACKET || k == RBRACE {
      depth = depth - 1
      # a newline between `)` and `=>` does not join them; arrow lambdas are a
      # same-line production at this boundary
      if depth == 0 { return tok_at(p, i, 1).kind == FATARROW }
    }
    i = i + 1
  }
  false
}

## The closure a tail block desugars to: `{ body }`, `{ x => body }` or
## `{ (a, b) => body }` written right after a call (spec §4.3). `st` is at the
## `{`; the caller decides where the closure lands (`attach_trailing`, or the
## dot-call arm building the method call directly).
##
## The parameter head is its own production, not a block being reinterpreted:
## in tail position `{ x => ... }` binds `x`, the way `Point { x }` uses braces
## without being a block. The block spelled `{ (x => e) }` still means "a block
## whose value is a lambda" -- the parenthesised group no longer closes with
## `=>`, so `paren_is_lambda` answers no and no parameter head is read.
fn tail_block_lambda(p: P, st: St) -> PR[Expr] = {
  let (st1, open) = adv(p, st)
  var params: List[LambdaParam] = []
  var st2 = st1
  if at_kind(p, st1, IDENT) && kind_ahead(p, st1, 1) == FATARROW {
    # `{ x => ... }`: the same one-token lookahead the bare arrow lambda uses
    let (st3, name) = adv(p, st1)
    st2 = adv1(p, st3)
    params = [LambdaParam { name: name.text, ann: None, lo: name.lo, hi: name.hi }]
  } else if at_kind(p, st1, LPAREN) && paren_is_lambda(p, st1) {
    # `{ (a, b) => ... }` / `{ (x: Int) => ... }` / `{ () => ... }`
    let (st3, ps) = lambda_params(p, st1, true)?
    let (st4, _) = want(p, st3, FATARROW, "`=>` (block parameters)")?
    params = ps
    st2 = st4
  }
  let st5 = skip_nl(p, st2)
  let (st6, stmts, tail) = block_body(p, st5)?
  let (st7, close) = want(p, st6, RBRACE, "`}`")?
  let body = EBlock(stmts, tail, open.lo, close.hi)
  Ok((st7, ELambda(params, body, false, open.lo, close.hi)))
}

## `(a, b) => e` / `(a: Int) => e` / `() => e`. `st` is at the `(`, and
## `paren_is_lambda` has already said this is one.
fn bare_lambda(p: P, st: St, nb: Bool) -> PR[Expr] = {
  let open = cur(p, st)
  let (st1, params) = lambda_params(p, st, true)?
  let (st2, _) = want(p, st1, FATARROW, "`=>` (lambda body)")?
  let st3 = skip_nl(p, st2)
  let (st4, body) = expression(p, st3, nb)?
  Ok((st4, ELambda(params, body, false, open.lo, e_hi(body))))
}

## `x => e`. `st` is at the parameter name, and the caller has checked that
## `=>` follows it.
fn bare_lambda1(p: P, st: St, nb: Bool) -> PR[Expr] = {
  let (st1, name) = adv(p, st)
  let st2 = skip_nl(p, adv1(p, st1))
  let (st3, body) = expression(p, st2, nb)?
  let param = LambdaParam { name: name.text, ann: None, lo: name.lo, hi: name.hi }
  Ok((st3, ELambda([param], body, false, name.lo, e_hi(body))))
}

fn list_lit(p: P, st: St) -> PR[Expr] = {
  let (st1, open) = adv(p, st)
  var st2 = skip_nl(p, st1)
  var elems: List[Expr] = []
  while not at_kind(p, st2, RBRACKET) {
    let (st3, e) = expression(p, st2, false)?
    elems = elems ++ [e]
    st2 = skip_nl(p, st3)
    if at_kind(p, st2, COMMA) { st2 = skip_nl(p, adv1(p, st2)) } else { break }
  }
  let (st4, close) = want(p, st2, RBRACKET, "`]`")?
  Ok((st4, EListLit(elems, open.lo, close.hi)))
}

fn paren_expr(p: P, st: St, nb: Bool) -> PR[Expr] = {
  # `(a, b) => e` / `(a: Int) => e` / `() => e`: decided before the group is
  # parsed, because a parameter list is not an expression (see
  # `paren_is_lambda`). Only in primary position -- a `(` *after* an expression
  # is an application, which is what keeps `f(a)(x)` from becoming a trailing
  # closure.
  if paren_is_lambda(p, st) { return bare_lambda(p, st, nb) }
  let (st1, open) = adv(p, st)
  if at_kind(p, st1, RPAREN) {
    let (st2, close) = adv(p, st1)
    return Ok((st2, EUnit(open.lo, close.hi)))
  }
  let st3 = skip_nl(p, st1)
  let (st4, first) = expression(p, st3, false)?
  let st5 = skip_nl(p, st4)
  if not at_kind(p, st5, COMMA) {
    let (st6, _) = want(p, st5, RPAREN, "`)`")?
    return Ok((st6, first))
  }
  var elems = [first]
  var st7 = st5
  while at_kind(p, st7, COMMA) {
    let st8 = skip_nl(p, adv1(p, st7))
    if at_kind(p, st8, RPAREN) {
      # allow a trailing comma
      st7 = st8
      break
    }
    let (st9, e) = expression(p, st8, false)?
    elems = elems ++ [e]
    st7 = skip_nl(p, st9)
  }
  let (st10, close) = want(p, st7, RPAREN, "`)`")?
  if len(elems) < 2 {
    return Err((st10, pd_h("a tuple needs at least 2 elements", open.lo, close.hi,
      "(x,) is not a tuple; write x")))
  }
  if len(elems) > 8 {
    return Err((st10, pd("tuples have at most 8 elements", open.lo, close.hi)))
  }
  Ok((st10, ETupleLit(elems, open.lo, close.hi)))
}

fn if_expr(p: P, st: St) -> PR[Expr] = {
  let (st1, kw) = adv(p, st)
  let (st2, cond) = expression(p, st1, true)?
  no_lambda_header(p, st2, cond, "if")?
  let (st3, thn) = block_expr(p, st2)?
  # else may sit on the line after }
  let st4 = skip_nl(p, st3)
  if at_kind(p, st4, ELSE) {
    let st5 = adv1(p, st4)
    let (st6, els) = if at_kind(p, st5, IF) { if_expr(p, st5)? } else { block_expr(p, st5)? }
    Ok((st6, EIf(cond, thn, Some(els), kw.lo, e_hi(els))))
  } else {
    Ok((st3, EIf(cond, thn, None, kw.lo, e_hi(thn))))
  }
}

fn block_expr(p: P, st: St) -> PR[Expr] = {
  let (st0, open) = want(p, st, LBRACE, "`{`")?
  let st1 = skip_nl(p, st0)
  let (st2, stmts, tail) = block_body(p, st1)?
  let (st3, close) = want(p, st2, RBRACE, "`}`")?
  Ok((st3, EBlock(stmts, tail, open.lo, close.hi)))
}

## The statements of a block, up to but not including its `}` (or EOF). Split
## out of `block_expr` because `with` needs to call it on the *rest* of a block
## it is standing in the middle of.
##
## Two things end the list: the closing brace, and a `with` statement — which
## swallows everything after it into a closure and hands back the desugared call
## as the block's value (spec §4.10).
fn block_body(
  p: P,
  st: St
) -> Result[(St, List[Stmt], Option[Expr]), (St, Diag)] = {
  var st1 = st
  var stmts: List[Stmt] = []
  var with_tail: Option[Expr] = None
  var done = false
  while not done && not at_kind(p, st1, RBRACE) && not at_kind(p, st1, EOF) {
    if at_kind(p, st1, WITH) {
      match with_stmt(p, st1) {
        Ok(r) -> {
          let (st2, e) = r
          with_tail = Some(e)
          st1 = st2
          done = true
        }
        Err(fe) -> {
          let (st2, d) = fe
          st1 = sync_stmt(p, St { ..st2, diags: st2.diags ++ [d] })
        }
      }
    } else {
      match stmt_and_sep(p, st1) {
        Ok(r) -> {
          let (st2, s) = r
          stmts = stmts ++ [s]
          st1 = st2
        }
        Err(fe) -> {
          let (st2, d) = fe
          st1 = sync_stmt(p, St { ..st2, diags: st2.diags ++ [d] })
        }
      }
    }
  }
  match with_tail {
    Some(e) -> return Ok((st1, stmts, Some(e)))
    None -> ()
  }
  # trailing expression rule: a final plain expression statement is the block's value
  var tail: Option[Expr] = None
  if len(stmts) > 0 {
    match stmts[len(stmts) - 1] {
      SExpr(e, slo, shi) -> {
        tail = Some(e)
        stmts = list.take(stmts, len(stmts) - 1)
      }
      other -> ()
    }
  }
  Ok((st1, stmts, tail))
}

## `with x <- f(a)` plus the rest of the enclosing block, which becomes a
## closure attached as f's **last** argument (spec §4.10):
##
##     with x <- f(a)      f(a, (x) => {
##     g(x)          ==>     g(x)
##     h(x)                  h(x)
##                         })
##
## `st` is at the `with`; the returned state sits on the block's `}`, because
## everything up to it belongs to the closure now. Nesting is free: the inner
## `block_body` meets the next `with` and does this again, so releases run in
## reverse order when the calls are `bracket`.
fn with_stmt(p: P, st: St) -> PR[Expr] = {
  let (st1, kw) = adv(p, st)
  # `handle` is contextual, never reserved: it is the handler clause only when
  # what follows is not the binder arrow. `with handle <- f()` stays a binding
  # named `handle`, which is what keeps every existing `fn handle` compiling.
  if at_kind(p, st1, IDENT) && cur(p, st1).text == "handle" && kind_ahead(p, st1, 1) != LARROW {
    return handle_stmt(p, adv1(p, st1), kw)
  }
  # a plain name, like a lambda parameter -- which is what it becomes. `_` is
  # not accepted for the same reason `(_) => ...` is not: there is one
  # spelling for a binding here, and it is a name.
  let (st2, name) = want(p, st1, IDENT, "a name to bind (`with x <- f(...)`)")?
  let (st3, _) = want(p, st2, LARROW, "`<-`")?
  let st4 = skip_nl(p, st3)
  # the callee parses with `nb` set: `with` is about to attach the rest of the
  # block as this call's last argument, so a tail block here would be a second
  # closure on the same call, one the author only sees as a `{`. Refused with
  # its own diagnostic rather than left to want_sep, which would point at the
  # consequence ("expected a newline") instead of the decision.
  let (st5, callee) = expression(p, st4, true)?
  if at_kind(p, st5, LBRACE) {
    return Err((st5, perr_h(p, st5,
      "`with` already passes the rest of the block to this call as its last argument",
      "a `{ ... }` here would be a second closure on the same call; " ++
        "parenthesise the call to attach the block instead, or drop the `with`")))
  }
  let st6 = want_sep(p, st5)?
  let rest_lo = cur(p, st6).lo
  let (st7, stmts, tail) = block_body(p, st6)?
  let rest_hi = cur(p, st7).lo
  let param = LambdaParam { name: name.text, ann: None, lo: name.lo, hi: name.hi }
  let body = EBlock(stmts, tail, rest_lo, rest_hi)
  let lam = ELambda([param], body, true, kw.lo, rest_hi)
  Ok((st7, attach_trailing(callee, lam)))
}

## `with handle E { op(a) => body ... }` plus the rest of the enclosing block,
## which becomes a parameterless closure exactly as the binder form's does
## (docs/effects-design.md §3.3):
##
##     with handle Ask {      EHandle(Ask, [ask() => 42], () => {
##       ask() => 42            g()
##     }                        h()
##     g()               ==>  })
##     h()
##
## `st` is just past `handle`; the returned state sits on the block's `}`.
fn handle_stmt(p: P, st: St, kw: Token) -> PR[Expr] = {
  let (st1, name) = want(p, st, TYPEIDENT, "the effect to handle (`with handle Ask { ... }`)")?
  let st2 = skip_nl(p, st1)
  let (st3, _) = want(p, st2, LBRACE, "`{` (the handler arms)")?
  var st4 = skip_nl(p, st3)
  var arms: List[HandlerArm] = []
  while not at_kind(p, st4, RBRACE) && not at_kind(p, st4, EOF) {
    let (st5, a) = handler_arm(p, st4)?
    arms = arms ++ [a]
    st4 = want_sep(p, st5)?
  }
  let (st6, close) = want(p, st4, RBRACE, "`}`")?
  if len(arms) == 0 {
    return Err((st6, pd_h("a handler must answer at least one operation", kw.lo, close.hi,
      "write one arm per operation the effect declares")))
  }
  let st7 = want_sep(p, st6)?
  let rest_lo = cur(p, st7).lo
  let (st8, stmts, tail) = block_body(p, st7)?
  let rest_hi = cur(p, st8).lo
  let no_params: List[LambdaParam] = []
  let body = EBlock(stmts, tail, rest_lo, rest_hi)
  let rest = ELambda(no_params, body, true, kw.lo, rest_hi)
  Ok((st8, EHandle(name.text, arms, rest, name.lo, name.hi, kw.lo, rest_hi)))
}

## `op(a, b) => expr` — one handler arm. The parameter list is a lambda's, and
## so is the body: an arm *is* the closure the operation call reaches.
fn handler_arm(p: P, st: St) -> PR[HandlerArm] = {
  let (st1, name) = want(p, st, IDENT, "an operation name (`op(...) => ...`)")?
  let (st2, params) = lambda_params(p, st1, false)?
  let (st3, _) = want(p, st2, FATARROW, "`=>` (an arm is a closure)")?
  let st4 = skip_nl(p, st3)
  let (st5, body) = expression(p, st4, false)?
  Ok((st5, HandlerArm {
    name: name.text,
    params: params,
    body: body,
    lo: name.lo,
    hi: e_hi(body),
    nlo: name.lo,
    nhi: name.hi
  }))
}

## Attach `lam` as the last argument of `callee`. A call grows one argument; a
## `recv.name` becomes the method call it looks like; anything else is applied
## to the closure, which is what `with x <- f` on a bare function value means.
## This is the one place the `with` sugar and non-method tail blocks land: both
## attach a synthesized closure as the call's last argument.
fn attach_trailing(callee: Expr, lam: Expr) -> Expr =
  match callee {
    EApply(t, args, clo, chi) -> EApply(t, args ++ [trail_arg(lam)], clo, e_hi(lam))
    EMethod(t, n, args, nlo, nhi, clo, chi) ->
      EMethod(t, n, args ++ [trail_arg(lam)], nlo, nhi, clo, e_hi(lam))
    other -> EApply(other, [trail_arg(lam)], e_lo(other), e_hi(lam))
  }

fn stmt_and_sep(p: P, st: St) -> PR[Stmt] = {
  let (st1, s) = statement(p, st)?
  let st2 = want_sep(p, st1)?
  Ok((st2, s))
}

## After a broken statement: skip to the next line (or block end) and continue.
fn sync_stmt(p: P, st: St) -> St = {
  var s = st
  while not at_kind(p, s, NEWLINE) && not at_kind(p, s, RBRACE) && not at_kind(p, s, EOF) {
    s = adv1(p, s)
  }
  skip_nl(p, s)
}

## Resync from the broken arm's start, not from the token that finally failed:
## an opener may already have been consumed by then. Newlines and commas only
## separate arms outside every nested delimiter; an unmatched top-level `}` is
## the current match's close and must stop recovery before a later declaration.
fn sync_arm(p: P, start: St, failed: St) -> St = {
  var s = St { pos: start.pos, diags: failed.diags }
  var parens = 0
  var brackets = 0
  var braces = 0
  while not at_kind(p, s, EOF) {
    let k = cur(p, s).kind
    let top = parens == 0 && brackets == 0 && braces == 0
    if top && (k == NEWLINE || k == COMMA) { break }
    if k == RBRACE && braces == 0 { break }
    if k == LPAREN {
      parens = parens + 1
    } else if k == RPAREN && parens > 0 {
      parens = parens - 1
    } else if k == LBRACKET {
      brackets = brackets + 1
    } else if k == RBRACKET && brackets > 0 {
      brackets = brackets - 1
    } else if k == LBRACE {
      braces = braces + 1
    } else if k == RBRACE {
      braces = braces - 1
    }
    s = adv1(p, s)
  }
  if at_kind(p, s, COMMA) {
    skip_nl(p, adv1(p, s))
  } else {
    skip_nl(p, s)
  }
}

fn match_expr(p: P, st: St) -> PR[Expr] = {
  let (st1, kw) = adv(p, st)
  let (st2, scrut) = expression(p, st1, true)?
  let (st3, _) = want(p, st2, LBRACE, "`{`")?
  var st4 = skip_nl(p, st3)
  var arms: List[MatchArm] = []
  while not at_kind(p, st4, RBRACE) && not at_kind(p, st4, EOF) {
    match match_arm(p, st4) {
      Err(ed) -> {
        # a broken arm is reported and skipped; the remaining arms still parse
        let (ste, d) = ed
        st4 = sync_arm(p, st4, St { ..ste, diags: ste.diags ++ [d] })
      }
      Ok(sa) -> {
        let (st5, arm) = sa
        arms = arms ++ [arm]
        # Arms are separated by physical newlines or commas. A pattern-looking
        # token has no special status here: adjacency is not a delimiter.
        if at_kind(p, st5, COMMA) {
          st4 = skip_nl(p, adv1(p, st5))
        } else if at_kind(p, st5, NEWLINE) || at_kind(p, st5, RBRACE) ||
          at_kind(p, st5, EOF) {
            st4 = skip_nl(p, st5)
          } else {
            let d = perr_h(p, st5, "expected a newline, `,` or `}` after this match arm",
              "put the next arm on a new line or after `,`; wrap statement bodies in braces: `-> { ... }`")
            st4 = sync_arm(p, st5, St { ..st5, diags: st5.diags ++ [d] })
          }
      }
    }
  }
  let (st6, close) = want(p, st4, RBRACE, "`}`")?
  if len(arms) == 0 {
    return Err((st6, pd("match needs at least one arm", kw.lo, close.hi)))
  }
  Ok((st6, EMatch(scrut, arms, kw.lo, close.hi)))
}

fn match_arm(p: P, st: St) -> PR[MatchArm] = {
  let (st1, first) = pattern_p(p, st)?
  var pats = [first]
  var st2 = st1
  while at_kind(p, st2, PIPE) {
    let st3 = skip_nl(p, adv1(p, st2))
    let (st4, pt) = pattern_p(p, st3)?
    pats = pats ++ [pt]
    st2 = st4
  }
  var guard: Option[Expr] = None
  if at_kind(p, st2, IF) {
    let st5 = adv1(p, st2)
    let (st6, g) = expression(p, st5, false)?
    guard = Some(g)
    st2 = st6
  }
  let (st7, _) = want(p, st2, ARROW, "`->`")?
  let st8 = skip_nl(p, st7)
  let (st9, body) = expression(p, st8, false)?
  Ok((st9, MatchArm { pats: pats, guard: guard, body: body, lo: pat_lo(first), hi: e_hi(body) }))
}

# ---- patterns ----

fn pattern_p(p: P, st: St) -> PR[Pattern] = {
  let t = cur(p, st)
  let k = t.kind
  if k == UNDERSCORE {
    Ok((adv1(p, st), PWild(t.lo, t.hi)))
  } else if k == INT {
    if t.is_min_magnitude {
      return Err((st, pd_h("integer literal out of 64-bit range: " ++ t.text, t.lo, t.hi,
        "this magnitude is valid only directly after unary `-`, as in `-9223372036854775808`")))
    }
    Ok((adv1(p, st), PLit(EInt(t.ival, t.lo, t.hi), t.lo, t.hi)))
  } else if k == CHAR {
    Ok((adv1(p, st), PLit(EChar(t.ival, t.lo, t.hi), t.lo, t.hi)))
  } else if k == FLOAT {
    Ok((adv1(p, st), PLit(EFloat(t.fval, t.lo, t.hi), t.lo, t.hi)))
  } else if k == MINUS {
    let st1 = adv1(p, st)
    let nt = cur(p, st1)
    let plo = t.lo
    let phi = nt.hi
    if nt.kind == INT {
      let value = if nt.is_min_magnitude { -9223372036854775807 - 1 } else { -nt.ival }
      Ok((adv1(p, st1), PLit(EInt(value, plo, phi), plo, phi)))
    } else if nt.kind == FLOAT {
      Ok((adv1(p, st1), PLit(EFloat(-nt.fval, plo, phi), plo, phi)))
    } else {
      Err((st1, perr(p, st1, "expected a number after `-` in a pattern")))
    }
  } else if k == TRUE {
    Ok((adv1(p, st), PLit(EBool(true, t.lo, t.hi), t.lo, t.hi)))
  } else if k == FALSE {
    Ok((adv1(p, st), PLit(EBool(false, t.lo, t.hi), t.lo, t.hi)))
  } else if k == STRING {
    let st1 = adv1(p, st)
    let (st2, lit) = str_lit(p, st1, t)?
    if str_has_interp(lit) {
      return Err((st2, pd("string patterns cannot contain interpolation", t.lo, t.hi)))
    }
    Ok((st2, PLit(lit, t.lo, t.hi)))
  } else if k == IDENT {
    # `m.C(...)` — a qualified constructor pattern (LANG-06): an IDENT that a
    # dot and an uppercase name follow can only be a module alias
    if kind_ahead(p, st, 1) == DOT && kind_ahead(p, st, 2) == TYPEIDENT {
      let (st1, q) = adv(p, st)
      let st2 = adv1(p, st1)
      let (st3, pc) = ctor_pat(p, st2)?
      return match pc {
        PCtor(name, args, rest, parens, nlo, nhi, _, hi) ->
          Ok((st3, PQual(q.text, name, args, rest, parens, nlo, nhi, q.lo, hi)))
        _ -> Err((st3, perr(p, st3, "expected a constructor pattern after the module alias")))
      }
    }
    Ok((adv1(p, st), PBind(t.text, t.lo, t.hi)))
  } else if k == TYPEIDENT {
    ctor_pat(p, st)
  } else if k == LPAREN {
    tuple_pat(p, st)
  } else if k == LBRACKET {
    list_pat(p, st)
  } else {
    Err((st, perr(p, st, "expected a pattern")))
  }
}

fn str_has_interp(e: Expr) -> Bool =
  match e {
    EStr(parts, _, _) -> {
      for pt in parts {
        match pt {
          SPInterp(x) -> return true
          SPText(v) -> ()
        }
      }
      false
    }
    _ -> false
  }

## [], [x, ..rest], [..init, last] — at most one `..`/`..name` rest
fn list_pat(p: P, st: St) -> PR[Pattern] = {
  let (st1, open) = adv(p, st)
  var st2 = skip_nl(p, st1)
  var pre: List[Pattern] = []
  var post: List[Pattern] = []
  var has_rest = false
  var rest_name: Option[String] = None
  var rest_span: Option[(Int, Int)] = None
  while not at_kind(p, st2, RBRACKET) {
    if at_kind(p, st2, DOTDOT) {
      let (st3, d) = adv(p, st2)
      if has_rest {
        return Err((st3, pd("a list pattern can have at most one `..` rest", d.lo, d.hi)))
      }
      has_rest = true
      if at_kind(p, st3, IDENT) {
        let (st4, n) = adv(p, st3)
        rest_name = Some(n.text)
        rest_span = Some((d.lo, n.hi))
        st2 = st4
      } else {
        rest_span = Some((d.lo, d.hi))
        st2 = st3
      }
    } else {
      let (st5, pt) = pattern_p(p, st2)?
      if has_rest { post = post ++ [pt] } else { pre = pre ++ [pt] }
      st2 = st5
    }
    st2 = skip_nl(p, st2)
    if at_kind(p, st2, COMMA) { st2 = skip_nl(p, adv1(p, st2)) } else { break }
  }
  let (st6, close) = want(p, st2, RBRACKET, "`]`")?
  Ok((st6, PList(pre, has_rest, rest_name, rest_span, post, open.lo, close.hi)))
}

## (a, b) — tuple pattern, 2 to 8 elements
fn tuple_pat(p: P, st: St) -> PR[Pattern] = {
  let (st1, open) = adv(p, st)
  var st2 = skip_nl(p, st1)
  var elems: List[Pattern] = []
  while not at_kind(p, st2, RPAREN) {
    let (st3, pt) = pattern_p(p, st2)?
    elems = elems ++ [pt]
    st2 = skip_nl(p, st3)
    if at_kind(p, st2, COMMA) { st2 = skip_nl(p, adv1(p, st2)) } else { break }
  }
  let (st4, close) = want(p, st2, RPAREN, "`)`")?
  if len(elems) < 2 {
    return Err((st4, pd("a tuple pattern needs at least 2 elements", open.lo, close.hi)))
  }
  if len(elems) > 8 {
    return Err((st4, pd("tuples have at most 8 elements", open.lo, close.hi)))
  }
  Ok((st4, PTuple(elems, open.lo, close.hi)))
}

## Circle(r) / Rect(w: w, ..) / bare nullary Point / record Point { x, y: 0, .. }
fn ctor_pat(p: P, st: St) -> PR[Pattern] = {
  let (st1, name) = adv(p, st)
  if at_kind(p, st1, LBRACE) { return record_pat(p, st1, name) }
  if not at_kind(p, st1, LPAREN) {
    let none: List[PatArg] = []
    return Ok((st1, PCtor(name.text, none, false, false, name.lo, name.hi, name.lo, name.hi)))
  }
  var st2 = skip_nl(p, adv1(p, st1))
  var args: List[PatArg] = []
  var rest = false
  while not at_kind(p, st2, RPAREN) {
    if at_kind(p, st2, DOTDOT) {
      let st3 = skip_nl(p, adv1(p, st2))
      rest = true
      if not at_kind(p, st3, RPAREN) {
        return Err((st3, perr(p, st3, "`..` must be the last thing in a constructor pattern")))
      }
      st2 = st3
      break
    }
    if at_kind(p, st2, IDENT) && kind_ahead(p, st2, 1) == COLON {
      let (st4, arg_name) = adv(p, st2)
      let st5 = skip_nl(p, adv1(p, st4))
      let (st6, pt) = pattern_p(p, st5)?
      args = args ++ [PatArg { name: Some(arg_name.text), nlo: arg_name.lo, nhi: arg_name.hi,
        pat: pt }]
      st2 = st6
    } else {
      let (st7, pt) = pattern_p(p, st2)?
      args = args ++ [PatArg { name: None, nlo: pat_lo(pt), nhi: pat_hi(pt), pat: pt }]
      st2 = st7
    }
    st2 = skip_nl(p, st2)
    if at_kind(p, st2, COMMA) { st2 = skip_nl(p, adv1(p, st2)) } else { break }
  }
  let (st8, close) = want(p, st2, RPAREN, "`)`")?
  Ok((st8, PCtor(name.text, args, rest, true, name.lo, name.hi, name.lo, close.hi)))
}

## Point { x, y: 0, .. } — field shorthand `x` binds the field to `x`
fn record_pat(p: P, st: St, name: Token) -> PR[Pattern] = {
  var st1 = skip_nl(p, adv1(p, st))
  var args: List[PatArg] = []
  var rest = false
  while not at_kind(p, st1, RBRACE) {
    if at_kind(p, st1, DOTDOT) {
      let st2 = skip_nl(p, adv1(p, st1))
      rest = true
      if not at_kind(p, st2, RBRACE) {
        return Err((st2, perr(p, st2, "`..` must be the last thing in a record pattern")))
      }
      st1 = st2
      break
    }
    let (st3, f) = want(p, st1, IDENT, "a field name")?
    if at_kind(p, st3, COLON) {
      let st4 = skip_nl(p, adv1(p, st3))
      let (st5, sub) = pattern_p(p, st4)?
      args = args ++ [PatArg { name: Some(f.text), nlo: f.lo, nhi: f.hi, pat: sub }]
      st1 = st5
    } else {
      # shorthand { x } binds field x to x
      args = args ++ [PatArg { name: Some(f.text), nlo: f.lo, nhi: f.hi,
        pat: PBind(f.text, f.lo, f.hi) }]
      st1 = st3
    }
    st1 = skip_nl(p, st1)
    if at_kind(p, st1, COMMA) { st1 = skip_nl(p, adv1(p, st1)) } else { break }
  }
  let (st6, close) = want(p, st1, RBRACE, "`}`")?
  Ok((st6, PCtor(name.text, args, rest, true, name.lo, name.hi, name.lo, close.hi)))
}

# a byte whose range lives in its own FromInt impl, and a tile that takes
# Float literals only
pub opaque type U8 = Int

impl FromInt[U8] {
  fn from_int(n: Int) -> U8 = {
    if n < 0 || n > 255 { panic("out of range for U8: ${n}") }
    n
  }
}

pub opaque type Tile[D] = Float

pub type F64 = F64

impl[D] FromFloat[Tile[D]] {
  fn from_float(x: Float) -> Tile[D] = x
}

impl[D] Mul[Tile[D]] {
  fn mul(a: Tile[D], b: Tile[D]) -> Tile[D] = {
    let x: Float = a
    let y: Float = b
    x * y
  }
}

pub fn lit[D](x: Float) -> Tile[D] = x

# a stand-in for an accumulating matrix product: C comes from the third operand
pub fn mma[D, C](a: Tile[D], b: Tile[D], c: Tile[C]) -> Tile[C] = c

# a library type that has an operator but takes no literals
pub opaque type Plain[D] = Float

impl[D] Mul[Plain[D]] {
  fn mul(a: Plain[D], b: Plain[D]) -> Plain[D] = {
    let x: Float = a
    let y: Float = b
    x * y
  }
}

pub fn id_of[T](x: T) -> T = x

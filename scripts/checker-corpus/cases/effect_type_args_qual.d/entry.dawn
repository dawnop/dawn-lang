# cx.dawn: an effect argument through `resolve_qual`. An imported alias carries
# its declaring module's resolution, so the substitution has to happen on this
# side of the import for `m.Thunk[!io]` to mean what `Thunk[!io]` means at
# home. The refusals are the same ones effect_type_args.dawn records, reached
# from the other table.
#
# The argument is read in *this* module's scope, not the exporter's: the label
# and the variable below are named here, and the exporter has never heard of
# either.
use lib as lib

effect Ask { fn get() -> Int }

fn force(t: lib.Thunk[!io]) -> Int !io = t()

fn apply_io(m: lib.Mapper[Int, String, !io]) -> String !io = m(1)

fn elided(t: lib.Thunk) -> Int !io = t()

fn labelled(t: lib.Thunk[!Ask]) -> Int !Ask = t()

fn forwarded(t: lib.Thunk[!e]) -> Int !e = t()

# the substitution is real here too: a pure consumer owes io, not a variable
fn io_slot(t: lib.Thunk[!io]) -> Int = t()

# and the elided spelling still lands on the exporter's own variable, which
# this signature cannot bind -- the repair is to write the argument
fn elided_pure(t: lib.Thunk) -> Int = t()

fn nominal(x: lib.Cell[!io]) -> Int !io = (x.f)()

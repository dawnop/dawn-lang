# expect: a tail block cannot follow `}`
# expect: allowed at module top level
# A `{` whose previous token is `}` never attaches (spec §4.3): here it would
# be a second tail block on the same call, and one call takes at most one.
# The same refusal keeps `if c { 1 } else { 2 } { 3 }`, `match x { ... } { ... }`
# and `P { x: 1 } { ... }` from silently applying a block to a value nobody
# reads as a callee.
fn f(xs: List[Int]) -> Unit !io = {
  each(xs) { io.println("a") } { io.println("b") }
}

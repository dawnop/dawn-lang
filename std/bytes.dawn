## Byte strings: UTF-8 and Latin-1 decoding, slicing, search, and the hex
## and base64 text encodings (spec §9.5.1).
#
# Short names, module-qualified at the call site: `use std/bytes`, then
# `bytes.len(b)` / `bytes.at(b, i)`.
#
# These write over the bytes_* intrinsics the JVM backend emits into
# dawn/rt/Bytes (utf8/decode/len/at/slice); the handwritten dawn.rt.StdBytes is
# retired. No `unsafe_pure` and no `use java` any more — a bytes_* call is a
# language primitive, not a Java call the checker has to be told is really pure.
#
# `Bytes` crosses the FFI boundary in both directions already (it is a JVM
# `byte[]`), so nothing here needs a workaround for the argument or return type.
# What needs one is the *result* shapes: out-of-range comes back as a -1
# sentinel and a bad charset as `None`, turned into panic/`Option` on this side.
#
# `Bytes ++ Bytes` is an operator, not a function, and stays in the compiler.

use std/char

# ---- building bytes ----

## A byte buffer under construction.
##
## `Bytes` is finished and immutable, and until this existed it was also
## *unproduceable*: you could take a string's UTF-8, slice it and read it, but
## a byte you computed had no spelling at all -- `0x80` would need a string
## whose UTF-8 encoding is that single byte, and there is none. Anything that
## decompresses writes bytes it computed, so this is the missing half.
##
## It is a value like everything else -- `put` returns the buffer rather than
## mutating it -- and it inherits `array_push`'s clause: the backend extends in
## place exactly when the version it is handed is the only one that could be
## reading the frontier, so building a megabyte is linear and not quadratic.
## `buf_at` is here because the callers that need this are decompressors, and an
## LZ77 back-reference reads output that was written a moment ago.
pub opaque type Buf = Array[Int]

## An empty buffer.
pub fn buf() -> Buf = array_new()

## Append one byte. A value outside 0..255 is truncated, as a byte store is.
pub fn put(b: Buf, byte: Int) -> Buf = array_push(b, byte & 0xFF)

## Append all of `src`.
pub fn put_bytes(b: Buf, src: Bytes) -> Buf = {
  var out = b
  var i = 0
  let n = bytes_len(src)
  while i < n {
    out = array_push(out, bytes_at(src, i))
    i = i + 1
  }
  out
}

## How many bytes have been written.
##
## `size` and not `len`: a named exception to one-concept-one-name, because
## `len(b: Bytes)` above already holds that name and Dawn has no overloading
## (CONTRIBUTING §naming; history in `docs/stdlib-naming.md`).
pub fn size(b: Buf) -> Int = array_len(b)

## The byte at `i`, as 0..255. Out of range panics, exactly as `at(b: Bytes, i)`
## does — it is the same question asked of the half-built buffer.
##
## `buf_at` and not `at` for the reason `size` is not `len`, and not `get`
## because `get` is criterion 2's word and this asserts (spec §4.8). The second
## named exception to one-concept-one-name (CONTRIBUTING §naming; history and
## the rejected alternative in `docs/stdlib-naming.md`).
pub fn buf_at(b: Buf, i: Int) -> Int = array_get(b, i)

## The finished bytes.
pub fn freeze(b: Buf) -> Bytes = bytes_from_array(b)

## The UTF-8 bytes of `s`.
pub fn utf8(s: String) -> Bytes = bytes_utf8(s)

## `b` decoded as UTF-8, with each malformed sequence replaced by U+FFFD.
##
## Total, and lossy in the literal sense: the caller cannot tell a replacement
## from a U+FFFD that was really in the input, and the bytes it stood for are
## gone. That is the right answer for text on its way to a human and the wrong
## one for input something is about to trust, which is how the overlong `c0 af`
## turns into `/` on any path that decodes before it checks.
## `decode_utf8_checked` is the other half.
pub fn decode_utf8_lossy(b: Bytes) -> String = bytes_decode_utf8(b)

## Why `decode_utf8_checked` refused. `offset` is the byte position where the
## first malformed sequence begins, which is also how many leading bytes of the
## input were valid UTF-8.
##
## No kind field. The distinctions a UTF-8 decoder could report (a tail cut
## short, an overlong form, a surrogate half, a lead byte that leads nothing)
## are not ones a caller acts on differently, and the standing test for that is
## `packages/json`'s `JsonErrorKind`: kinds are the branches a caller takes,
## not one per message. A struct is the shape that can gain such a field later
## without breaking a caller that only reads `offset`.
pub type Utf8Error = { offset: Int } derive Show

## `b` decoded as UTF-8, or `Err` at the first sequence that is not.
##
## The exact complement of `decode_utf8_lossy`: this answers `Ok` for precisely
## the inputs that one returns unchanged, and the `Ok` string is the one it
## would have produced. Nothing is rewritten on the way to the caller, so an
## application that must not act on bytes it was not sent asks this one.
pub fn decode_utf8_checked(b: Bytes) -> Result[String, Utf8Error] =
  match first_malformed(b) {
    Some(i) -> Err(Utf8Error { offset: i })
    None -> Ok(bytes_decode_utf8(b))
  }

# Where the first sequence that is not well-formed UTF-8 starts, or `None`.
#
# Walks whole sequences, so the answer is a sequence boundary and everything
# before it decodes to itself.
fn first_malformed(b: Bytes) -> Option[Int] = {
  let n = bytes_len(b)
  var i = 0
  while i < n {
    let w = utf8_width(b, i, n)
    if w == 0 { return Some(i) }
    i = i + w
  }
  None
}

# How many bytes the well-formed sequence at `i` occupies, or 0 when there is
# no well-formed sequence there.
#
# This is Unicode table 3-7, spelled as its rows. It has to accept exactly what
# `bytes_decode_utf8` leaves alone, or the checked decoder would refuse input
# the lossy one hands through untouched. The JVM's `new String(b, UTF_8)` and
# the C walker of `runtime/c/dawn_rt.c` (#112) were made to agree on that set,
# and this is a third copy of the rules. A comment cannot hold three copies
# together, so the test below re-derives the answer from the lossy decoder
# itself rather than restating the table.
fn utf8_width(b: Bytes, i: Int, n: Int) -> Int = {
  let b1 = bytes_at(b, i)
  if b1 < 0x80 {
    1
  } else if b1 < 0xC2 {
    # 80..BF continue a sequence that never started; C0 and C1 lead only
    # overlong spellings of ASCII
    0
  } else if b1 <= 0xDF {
    utf8_seq(b, i, n, 2, 0x80, 0xBF)
  } else if b1 == 0xE0 {
    utf8_seq(b, i, n, 3, 0xA0, 0xBF)
  } else if b1 <= 0xEC {
    utf8_seq(b, i, n, 3, 0x80, 0xBF)
  } else if b1 == 0xED {
    # a surrogate half is not a code point a string may hold
    utf8_seq(b, i, n, 3, 0x80, 0x9F)
  } else if b1 <= 0xEF {
    utf8_seq(b, i, n, 3, 0x80, 0xBF)
  } else if b1 == 0xF0 {
    utf8_seq(b, i, n, 4, 0x90, 0xBF)
  } else if b1 <= 0xF3 {
    utf8_seq(b, i, n, 4, 0x80, 0xBF)
  } else if b1 == 0xF4 {
    # nothing above U+10FFFF
    utf8_seq(b, i, n, 4, 0x80, 0x8F)
  } else {
    0
  }
}

# `width` bytes at `i`, whose second byte is in `lo..hi` and whose remaining
# bytes are continuations, or 0. The lead byte decides `lo` and `hi`, which is
# where the overlong forms and the two range edges are refused.
fn utf8_seq(b: Bytes, i: Int, n: Int, width: Int, lo: Int, hi: Int) -> Int = {
  if i + width > n { return 0 }
  let b2 = bytes_at(b, i + 1)
  if b2 < lo || b2 > hi { return 0 }
  var k = 2
  while k < width {
    let x = bytes_at(b, i + k)
    if x < 0x80 || x > 0xBF { return 0 }
    k = k + 1
  }
  width
}

## `b` decoded as ISO-8859-1: one code point per byte, 0..255.
pub fn decode_latin1(b: Bytes) -> String = bytes_decode_latin1(b)

## Number of bytes in `b`.
pub fn len(b: Bytes) -> Int = bytes_len(b)

## Whether `b` has no bytes. The same question `str.is_empty` answers, in the
## same words (CONTRIBUTING §naming).
pub fn is_empty(b: Bytes) -> Bool = bytes_len(b) == 0

## The byte at `i` as 0..255. Panics when `i` is out of range — a programming
## error, like indexing a list past its end. The -1 the intrinsic returns is
## that signal, and cannot collide with a real (unsigned) byte value.
pub fn at(b: Bytes, i: Int) -> Int = {
  let v = bytes_at(b, i)
  if v < 0 { panic("bytes.at: index out of range") } else { v }
}

## The bytes in `[start, end)`. Both ends are clamped into range and
## `start > end` yields empty, so this never panics.
pub fn slice(b: Bytes, start: Int, end: Int) -> Bytes = bytes_slice(b, start, end)

## Where the first occurrence of `needle` at or after `from` begins, or `None`.
##
## A *position* in `[0, len]` counted in bytes, not the index of an element: an
## empty needle matches at the start when that position exists, and `len(b)` is
## a legal answer though no byte lives there. A negative `from` is clamped to
## zero; a `from` past `len(b)` is a miss, including for an empty needle. Pure
## Dawn over bytes_len/bytes_at — the search loop is not an intrinsic.
pub fn index_of(b: Bytes, needle: Bytes, from: Int) -> Option[Int] = {
  let hlen = bytes_len(b)
  let nlen = bytes_len(needle)
  let start = if from < 0 { 0 } else { from }
  let last_start: Int = if nlen == 0 {
    hlen
  } else if start >= hlen {
    0 - 1
  } else {
    let remaining: Int = hlen - start
    if nlen > remaining { 0 - 1 } else { hlen - nlen }
  }
  index_scan(b, needle, nlen, start, last_start)
}

fn index_scan(b: Bytes, needle: Bytes, nlen: Int, start: Int, last_start: Int) -> Option[Int] = {
  if start > last_start { return None }
  var i: Int = start
  while true {
    if matches_at(b, needle, nlen, i) { return Some(i) }
    if i >= last_start { return None }
    i = i + 1
  }
  None
}

fn matches_at(b: Bytes, needle: Bytes, nlen: Int, start: Int) -> Bool = {
  var hay_index: Int = start
  var needle_index: Int = 0
  while needle_index < nlen {
    if bytes_at(b, hay_index) != bytes_at(needle, needle_index) { return false }
    needle_index = needle_index + 1
    if needle_index < nlen { hay_index = hay_index + 1 }
  }
  true
}

# ---- text encodings ----
#
# Hex and Base64 are byte arithmetic and a lookup table, which makes them the
# kind of thing that has no business being a host call -- and yet the same
# "four bits to a hex digit" was written eight times across this tree (two of
# them disagreeing about case), and Base64 had no pure spelling at all, so
# crypto and WebDAV each reached for `use java java.util.Base64` and stained
# an otherwise pure call chain with `!io` all the way up
# (audit RD-03/RD-10). Written here once, both backends get them for free.
#
# The alphabets are arithmetic rather than a string to index into: indexing a
# constant string costs a code-point walk per digit, and the ranges are
# contiguous in ASCII anyway.

# The digits are characters, and arithmetic on them is not: `Char` is opaque
# over `Int` outside std/char (spec §2.7), so a table walked by adding an
# offset says `char.code` on the way in and `char_unchecked` on the way out.
# Both directions are safe here by construction -- the offsets are bounded by
# the radix, so every result is an ASCII digit or letter.
fn hex_char(v: Int) -> Char =
  char_unchecked(if v < 10 { char.code('0') + v } else { char.code('a') + (v - 10) })

fn hex_val(c: Char) -> Int =
  if c >= '0' && c <= '9' {
    char.code(c) - char.code('0')
  } else if c >= 'a' && c <= 'f' {
    char.code(c) - char.code('a') + 10
  } else if c >= 'A' && c <= 'F' {
    char.code(c) - char.code('A') + 10
  } else {
    -1
  }

## `b` as hexadecimal: two digits per byte, most significant first, nothing
## between them. Lower case, which is the canonical spelling this library
## produces -- `from_hex` reads either case, `to_hex` writes one.
pub fn to_hex(b: Bytes) -> String = {
  var out: List[Char] = []
  var i = 0
  let n = bytes_len(b)
  while i < n {
    let v = bytes_at(b, i)
    out = out ++ [hex_char(v / 16), hex_char(v % 16)]
    i = i + 1
  }
  from_code_points(out)
}

## `s` read as hexadecimal, or `None` when it is not an even-length run of hex
## digits. Either case is accepted; nothing else is, not even whitespace.
##
## Inquiry (spec §4.8, criterion 2): text arriving from a file or a header is
## checked, not asserted, so a malformed input is a branch and not a panic.
pub fn from_hex(s: String) -> Option[Bytes] = {
  var out = buf()
  var hi = -1
  for c in code_points(s) {
    let v = hex_val(c)
    if v < 0 {
      return None
    }
    if hi < 0 {
      hi = v
    } else {
      out = put(out, hi * 16 + v)
      hi = -1
    }
  }
  if hi >= 0 {
    None
  } else {
    Some(freeze(out))
  }
}

# Base64 has two alphabets that differ only in the last two symbols, and two
# padding conventions. Rather than four encoders they are two parameters:
# `url` picks `-_` over `+/` (RFC 4648 §5) and `pad` decides whether the
# output is rounded up to a multiple of four with `=`.

fn b64_char(v: Int, url: Bool) -> Char =
  if v < 26 {
    char_unchecked(char.code('A') + v)
  } else if v < 52 {
    char_unchecked(char.code('a') + (v - 26))
  } else if v < 62 {
    char_unchecked(char.code('0') + (v - 52))
  } else if v == 62 {
    if url { '-' } else { '+' }
  } else {
    if url { '_' } else { '/' }
  }

fn b64_val(c: Char, url: Bool) -> Int =
  if c >= 'A' && c <= 'Z' {
    char.code(c) - char.code('A')
  } else if c >= 'a' && c <= 'z' {
    char.code(c) - char.code('a') + 26
  } else if c >= '0' && c <= '9' {
    char.code(c) - char.code('0') + 52
  } else if c == (if url { '-' } else { '+' }) {
    62
  } else if c == (if url { '_' } else { '/' }) {
    63
  } else {
    -1
  }

fn b64_encode(b: Bytes, url: Bool, pad: Bool) -> String = {
  var out: List[Char] = []
  let n = bytes_len(b)
  var i = 0
  while i + 3 <= n {
    let x = bytes_at(b, i) * 65536 + bytes_at(b, i + 1) * 256 + bytes_at(b, i + 2)
    out = out ++ [
      b64_char(x / 262144, url), b64_char((x / 4096) % 64, url),
      b64_char((x / 64) % 64, url), b64_char(x % 64, url)
    ]
    i = i + 3
  }
  let rest = n - i
  if rest == 1 {
    let x = bytes_at(b, i) * 16
    out = out ++ [b64_char(x / 64, url), b64_char(x % 64, url)]
    if pad {
      out = out ++ ['=', '=']
    }
  } else if rest == 2 {
    let x = bytes_at(b, i) * 1024 + bytes_at(b, i + 1) * 4
    out = out ++ [b64_char(x / 4096, url), b64_char((x / 64) % 64, url), b64_char(x % 64, url)]
    if pad {
      out = out ++ ['=']
    }
  }
  from_code_points(out)
}

# One decoder for both alphabets. It accepts a trailing `=` run or no padding
# at all -- the padded and unpadded spellings of the same bytes have to read
# back the same, since the url-safe encoder here omits padding -- but it
# rejects everything else: a wrong number of `=`, a symbol after them, a
# leftover group of one character (which encodes no byte), and a final group
# whose unused low bits are not zero. That last check is what makes decoding
# injective: without it `AB==` and `AC==` would both be one byte.
fn b64_decode(s: String, url: Bool) -> Option[Bytes] = {
  var out = buf()
  var acc = 0
  var have = 0
  var pad = 0
  for c in code_points(s) {
    if c == '=' {
      pad = pad + 1
    } else if pad > 0 {
      return None
    } else {
      let v = b64_val(c, url)
      if v < 0 {
        return None
      }
      acc = acc * 64 + v
      have = have + 1
      if have == 4 {
        out = put(out, acc / 65536)
        out = put(out, (acc / 256) % 256)
        out = put(out, acc % 256)
        acc = 0
        have = 0
      }
    }
  }
  if have == 2 {
    if acc % 16 != 0 || (pad != 0 && pad != 2) {
      return None
    }
    out = put(out, acc / 16)
  } else if have == 3 {
    if acc % 4 != 0 || (pad != 0 && pad != 1) {
      return None
    }
    out = put(out, acc / 1024)
    out = put(out, (acc / 4) % 256)
  } else if have != 0 || pad != 0 {
    # `have == 1` encodes no byte at all, and padding with nothing to pad is
    # not a spelling of anything either
    return None
  }
  Some(freeze(out))
}

## `b` as Base64 with the standard alphabet (`A-Za-z0-9+/`, RFC 4648 §4) and
## `=` padding to a multiple of four characters.
pub fn to_base64(b: Bytes) -> String = b64_encode(b, false, true)

## `s` read as standard-alphabet Base64, or `None` when it is not.
##
## Inquiry (spec §4.8, criterion 2). Padding is optional on the way in even
## though `to_base64` always writes it; the url-safe alphabet is not accepted
## here -- `from_base64_url` is the function that reads it.
pub fn from_base64(s: String) -> Option[Bytes] = b64_decode(s, false)

## `b` as Base64 with the url- and filename-safe alphabet (`A-Za-z0-9-_`,
## RFC 4648 §5) and **no** padding, which is the shape a JWT segment, a
## signature parameter and a path component all want -- `=` has to be
## percent-encoded in a query and means nothing in a file name.
pub fn to_base64_url(b: Bytes) -> String = b64_encode(b, true, false)

## `s` read as url-safe Base64, with or without padding, or `None` when it is
## not. The standard alphabet's `+` and `/` are rejected here, as `-` and `_`
## are by `from_base64`: which alphabet a string is in is the caller's claim,
## and a decoder that guesses turns a mismatch into wrong bytes.
pub fn from_base64_url(s: String) -> Option[Bytes] = b64_decode(s, true)

# ---- iteration (prelude Iter, #44 knife 2) ----

## `for b in bs` yields each byte as an Int in `0..=255`, the same currency
## `at` deals in. The cursor is a plain index: bytes are the one container
## whose representation is contractually flat.
impl Iter[Bytes] {
  type Cur = Int
  type Item = Int

  fn iter_start(b: Bytes) -> Int = 0
  fn iter_done(b: Bytes, c: Int) -> Bool = c >= len(b)
  fn iter_next(b: Bytes, c: Int) -> Int = c + 1
  fn iter_get(b: Bytes, c: Int) -> Int = at(b, c)
}

# Nothing in this module had a test of its own. What that left uncovered is
# mostly the refusals: `from_hex` and the two `from_base64` are inquiry
# functions (spec §4.8 criterion 2) whose whole job is to answer None for text
# that is not what it claims to be, and every caller of them is parsing
# something that arrived from outside.
#
# The Base64 vectors below are RFC 4648 §10's, not a round trip through this
# encoder. A round trip proves the two directions are inverses and says nothing
# about whether either is Base64; these say it is.

test "a Buf appends, reads back, and truncates what will not fit in a byte" {
  assert size(buf()) == 0
  assert to_hex(freeze(buf())) == ""
  assert is_empty(freeze(buf()))
  let b = put(put(put(buf(), 0x00), 0x41), 0xFF)
  assert size(b) == 3
  assert buf_at(b, 0) == 0x00
  assert buf_at(b, 1) == 0x41
  assert buf_at(b, 2) == 0xFF
  assert to_hex(freeze(b)) == "0041ff"
  assert len(freeze(b)) == 3
  # a byte store keeps the low eight bits, and says so rather than panicking.
  # Asserted through `get` and not only through `freeze`: freezing narrows to
  # bytes as well, so a `put` that stopped masking would still hex the same and
  # only an unfrozen read can tell -- which is also where `get`'s own promise
  # ("as 0..255") would be broken.
  assert buf_at(put(buf(), 0x141), 0) == 0x41
  assert buf_at(put(buf(), 256), 0) == 0x00
  assert buf_at(put(buf(), -1), 0) == 0xFF
  assert buf_at(put(buf(), -256), 0) == 0x00
  assert to_hex(freeze(put(buf(), 0x141))) == "41"
  assert to_hex(freeze(put(buf(), 256))) == "00"
  assert to_hex(freeze(put(buf(), -1))) == "ff"
  assert to_hex(freeze(put(buf(), -256))) == "00"
  # put_bytes is the same append, in bulk
  assert to_hex(freeze(put_bytes(buf(), utf8("AB")))) == "4142"
  assert to_hex(freeze(put_bytes(put(buf(), 0x41), utf8("B")))) == "4142"
  assert to_hex(freeze(put_bytes(buf(), utf8("")))) == ""
  # `get` is `at`'s clause, on the builder: a read past the frontier is a bug
  match catch_panic(() => buf_at(b, 3)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  match catch_panic(() => buf_at(buf(), 0)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
}

test "at asserts the index exists; slice names a stretch and clamps" {
  let b = utf8("abcdef")
  assert len(b) == 6
  assert at(b, 0) == 0x61
  assert at(b, 5) == 0x66
  assert is_empty(utf8(""))
  assert not is_empty(b)
  assert len(utf8("")) == 0
  # spec 4.8 criterion 1 -- the same split str.at and str.substring have
  match catch_panic(() => at(b, 6)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  match catch_panic(() => at(b, -1)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  match catch_panic(() => at(utf8(""), 0)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  # criterion 3: both ends clamp, and a reversed range is empty, never a panic
  assert to_hex(slice(b, 0, 3)) == "616263"
  assert to_hex(slice(b, 3, 6)) == "646566"
  assert to_hex(slice(b, -5, 3)) == "616263"
  assert to_hex(slice(b, 3, 99)) == "646566"
  assert to_hex(slice(b, 0, 99)) == to_hex(b)
  assert to_hex(slice(b, 4, 2)) == ""
  assert to_hex(slice(b, 99, 99)) == ""
  assert to_hex(slice(b, -9, -3)) == ""
  assert to_hex(slice(b, 2, 2)) == ""
  assert to_hex(slice(utf8(""), 0, 5)) == ""
  # a byte is a byte, not a code point: one astral character is four of them
  assert len(utf8("😀")) == 4
  assert to_hex(utf8("😀")) == "f09f9880"
}

test "index_of answers a byte offset, and an empty needle is at every one" {
  var b: Bytes = utf8("abcabc")
  assert index_of(b, utf8("abc"), 0) == Some(0)
  assert index_of(b, utf8("abc"), 1) == Some(3)
  assert index_of(b, utf8("c"), 0) == Some(2)
  assert index_of(b, utf8("c"), 3) == Some(5)
  assert index_of(b, utf8("c"), 6) == None
  assert index_of(b, utf8("zz"), 0) == None
  # a needle longer than what is left is a miss, not a partial match
  assert index_of(utf8("ab"), utf8("abc"), 0) == None
  assert index_of(b, utf8("abc"), 4) == None
  # `from` is clamped up to 0, so a negative one reads as "from the start"
  assert index_of(b, utf8("abc"), -5) == Some(0)
  assert index_of(b, utf8(""), -3) == Some(0)
  # the empty needle is at every position including the end -- but not past it,
  # which is the one place this differs from "always Some"
  assert index_of(b, utf8(""), 0) == Some(0)
  assert index_of(b, utf8(""), 3) == Some(3)
  assert index_of(b, utf8(""), 6) == Some(6)
  assert index_of(b, utf8(""), 7) == None
  assert index_of(utf8(""), utf8(""), 0) == Some(0)
  assert index_of(utf8(""), utf8("a"), 0) == None
  # Every negative start, including Int.MIN, is the beginning.
  assert index_of(b, utf8("abc"), -9223372036854775807 - 1).unwrap_or(0 - 1) == 0
  assert index_of(b, utf8(""), -9223372036854775807 - 1).unwrap_or(0 - 1) == 0
  assert index_of(utf8(""), utf8(""), -9223372036854775807 - 1).unwrap_or(0 - 1) == 0
  # The end is a position only for an empty needle; anything past it is a miss.
  assert index_of(b, utf8(""), len(b)).unwrap_or(0 - 1) == len(b)
  assert index_of(b, utf8("a"), len(b)).unwrap_or(0 - 1) == 0 - 1
  assert index_of(b, utf8(""), 9223372036854775807).unwrap_or(0 - 1) == 0 - 1
  assert index_of(b, utf8("a"), 9223372036854775807).unwrap_or(0 - 1) == 0 - 1
  assert index_of(utf8(""), utf8(""), 9223372036854775807).unwrap_or(0 - 1) == 0 - 1
  assert index_of(utf8(""), utf8("a"), 9223372036854775807).unwrap_or(0 - 1) == 0 - 1
  # The only legal start is also the last one. It must be tested before the
  # loop decides whether another increment is possible.
  assert index_of(utf8("xxabc"), utf8("abc"), 2).unwrap_or(0 - 1) == 2
  assert index_of(utf8("xxabd"), utf8("abc"), 2).unwrap_or(0 - 1) == 0 - 1
  assert index_of(utf8("ab"), utf8("abc"), -9223372036854775807 - 1).unwrap_or(0 - 1) == 0 - 1
  # Doubling constructs a 131072-byte needle in 17 steps, without making this
  # production module depend on std/str merely for a test helper.
  b = utf8("a")
  while len(b) < 100000 { b = b ++ b }
  assert index_of(utf8("x") ++ b, b, 0).unwrap_or(0 - 1) == 1
  assert index_of(utf8("x") ++ slice(b, 0, len(b) - 1) ++ utf8("b"), b, 1).unwrap_or(0 - 1) == 0 - 1
}

test "to_hex writes one case and from_hex reads both, or refuses" {
  assert to_hex(utf8("")) == ""
  assert to_hex(utf8("AB")) == "4142"
  assert to_hex(freeze(put(put(buf(), 0x0F), 0xF0))) == "0ff0"
  # lower case is what this library produces -- the pin is on the case, since
  # both spellings read back the same and only one is written
  assert to_hex(freeze(put(buf(), 0xAB))) == "ab"
  assert from_hex("") == Some(utf8(""))
  assert from_hex("41") == Some(utf8("A"))
  assert from_hex("4142") == Some(utf8("AB"))
  assert from_hex("AbCd") == from_hex("abcd")
  assert to_hex(unwrap_or(from_hex("AbCd"), utf8(""))) == "abcd"
  # an odd digit count leaves half a byte, which is not a byte string
  assert from_hex("4") == None
  assert from_hex("414") == None
  # and nothing else is a hex digit, not even the separators that usually are
  assert from_hex("4G") == None
  assert from_hex("41 42") == None
  assert from_hex("41\n") == None
  assert from_hex("0x41") == None
  assert from_hex("-1") == None
  # the round trip, in the direction that has a canonical answer
  assert from_hex(to_hex(utf8("hello"))) == Some(utf8("hello"))
}

test "base64 answers RFC 4648's vectors, in both of its alphabets" {
  # §10's test vectors. These are the assertions that say this is Base64 and
  # not merely a self-consistent pair of functions.
  assert to_base64(utf8("")) == ""
  assert to_base64(utf8("f")) == "Zg=="
  assert to_base64(utf8("fo")) == "Zm8="
  assert to_base64(utf8("foo")) == "Zm9v"
  assert to_base64(utf8("foob")) == "Zm9vYg=="
  assert to_base64(utf8("fooba")) == "Zm9vYmE="
  assert to_base64(utf8("foobar")) == "Zm9vYmFy"
  assert from_base64("Zg==") == Some(utf8("f"))
  assert from_base64("Zm8=") == Some(utf8("fo"))
  assert from_base64("Zm9v") == Some(utf8("foo"))
  assert from_base64("Zm9vYg==") == Some(utf8("foob"))
  assert from_base64("Zm9vYmE=") == Some(utf8("fooba"))
  assert from_base64("Zm9vYmFy") == Some(utf8("foobar"))
  # the url-safe encoder writes the same characters and omits the padding
  assert to_base64_url(utf8("")) == ""
  assert to_base64_url(utf8("f")) == "Zg"
  assert to_base64_url(utf8("fo")) == "Zm8"
  assert to_base64_url(utf8("foo")) == "Zm9v"
  assert to_base64_url(utf8("foobar")) == "Zm9vYmFy"
  # the two alphabets differ in exactly the last two symbols, which 0xFB 0xFF
  # is chosen to reach: it encodes to values 62 and 63
  let high = freeze(put(put(buf(), 0xFB), 0xFF))
  assert to_base64(high) == "+/8="
  assert to_base64_url(high) == "-_8"
  assert from_base64("+/8=") == Some(high)
  assert from_base64_url("-_8") == Some(high)
  assert from_base64_url("-_8=") == Some(high)
  # which alphabet a string is in is the caller's claim, so neither decoder
  # guesses -- a mismatch is None rather than different bytes
  assert from_base64("-_8=") == None
  assert from_base64_url("+/8=") == None
}

test "from_base64 refuses everything that is not one spelling of some bytes" {
  # padding is optional on the way in, because the url-safe encoder omits it
  assert from_base64("AQ==") == from_base64("AQ")
  assert from_base64("Zm9vYg") == Some(utf8("foob"))
  assert from_base64("") == Some(utf8(""))
  # ... but the amount of it is not free: a group of two takes two `=`
  assert from_base64("AQ=") == None
  assert from_base64("AQ===") == None
  assert from_base64("Zm9vYg=") == None
  assert from_base64("Zm9vYg===") == None
  assert from_base64("=") == None
  assert from_base64("====") == None
  assert from_base64("AAAA=") == None
  # a leftover group of one character encodes no byte at all
  assert from_base64("A") == None
  assert from_base64("ZZZZA") == None
  # nothing may follow the padding
  assert from_base64("A=B") == None
  assert from_base64("AQ==A") == None
  # This is the clause that makes decoding injective. `AB` and `AQ` both have
  # two characters and would both be one byte, but only one of them has zero
  # in the bits the byte does not reach -- without the check they would decode
  # to the same 0x01 and no encoder could ever produce `AB`.
  assert from_base64("AQ") == Some(freeze(put(buf(), 0x01)))
  assert from_base64("AA") == Some(freeze(put(buf(), 0x00)))
  assert from_base64("AB") == None
  assert from_base64("AC==") == None
  assert from_base64("AAB") == None
  assert from_base64("AAA") == Some(freeze(put(put(buf(), 0x00), 0x00)))
  # whitespace is not ignored the way some decoders ignore it
  assert from_base64("Zm 9v") == None
  assert from_base64("Zm9v\n") == None
  assert from_base64(" Zm9v") == None
  # and neither is anything else outside the alphabet
  assert from_base64("Zm9*") == None
  assert from_base64("Zm9v.") == None
}

test "decode_latin1 is one code point per byte; decode_utf8_lossy substitutes" {
  let high = freeze(put(put(buf(), 0x80), 0xFF))
  # Latin-1 cannot fail: every byte names a code point, including the 0x80..0xFF
  # half that is not valid UTF-8
  assert decode_latin1(high) == "\u{0080}\u{00FF}"
  assert decode_latin1(utf8("")) == ""
  assert decode_latin1(utf8("abc")) == "abc"
  # so the two decoders disagree on exactly those bytes, which is the point of
  # having both
  assert decode_utf8_lossy(high) == "\u{FFFD}\u{FFFD}"
  assert decode_utf8_lossy(utf8("")) == ""
  assert decode_utf8_lossy(utf8("a中😀")) == "a中😀"
  assert utf8(decode_utf8_lossy(utf8("a中😀"))) == utf8("a中😀")
  # a byte the Latin-1 round trip does not lose
  assert utf8(decode_latin1(high)) == freeze(put_bytes(put_bytes(buf(),
    utf8("\u{0080}")), utf8("\u{00FF}")))
}

test "decode_utf8_checked refuses at the byte the sequence went wrong" {
  let of = (hex: String) => from_hex(hex).expect("hex")
  assert decode_utf8_checked(utf8("")) == Ok("")
  assert decode_utf8_checked(utf8("a中😀")) == Ok("a中😀")
  # U+FFFD is a character an input may legitimately carry, and its own
  # encoding is well formed, so it is accepted rather than mistaken for the
  # mark the lossy decoder leaves
  assert decode_utf8_checked(of("efbfbd")) == Ok("\u{FFFD}")
  # a byte that continues nothing, and one that leads nothing
  assert decode_utf8_checked(of("80")) == Err(Utf8Error { offset: 0 })
  assert decode_utf8_checked(of("ff")) == Err(Utf8Error { offset: 0 })
  # the offset is a position in the input, not in the decoded text
  assert decode_utf8_checked(of("61ff62")) == Err(Utf8Error { offset: 1 })
  assert decode_utf8_checked(of("e4b8ad61ff")) == Err(Utf8Error { offset: 4 })
  # an overlong form is not the character it encodes: `c0 af` is not `/`
  assert decode_utf8_checked(of("c0af")) == Err(Utf8Error { offset: 0 })
  assert decode_utf8_checked(of("e080af")) == Err(Utf8Error { offset: 0 })
  assert decode_utf8_checked(of("f08fbfbf")) == Err(Utf8Error { offset: 0 })
  # a surrogate half is not a code point a string may hold, and the code point
  # just below the block is
  assert decode_utf8_checked(of("eda080")) == Err(Utf8Error { offset: 0 })
  assert decode_utf8_checked(of("edbfbf")) == Err(Utf8Error { offset: 0 })
  assert decode_utf8_checked(of("ed9fbf")) == Ok("\u{D7FF}")
  # nothing above U+10FFFF, and the last code point below it
  assert decode_utf8_checked(of("f4908080")) == Err(Utf8Error { offset: 0 })
  assert decode_utf8_checked(of("f5808080")) == Err(Utf8Error { offset: 0 })
  assert decode_utf8_checked(of("f48fbfbf")) == Ok("\u{10FFFF}")
  # a sequence the input ends in the middle of is refused where it began
  assert decode_utf8_checked(of("61c3")) == Err(Utf8Error { offset: 1 })
  assert decode_utf8_checked(of("e282")) == Err(Utf8Error { offset: 0 })
  assert decode_utf8_checked(of("f09f92")) == Err(Utf8Error { offset: 0 })
}

test "decode_utf8_checked refuses exactly what decode_utf8_lossy rewrites" {
  # Three copies of the UTF-8 table are in play: the JVM's, the C walker's, and
  # `utf8_width` above. Restating the table here would only add a fourth, so
  # the oracle is the lossy decoder itself.
  #
  # A byte string is valid UTF-8 exactly when decoding and re-encoding it gives
  # the same bytes back: every sequence the decoder leaves alone re-encodes to
  # itself, and a replacement never re-encodes to the bytes it replaced, since
  # U+FFFD's own encoding EF BF BD is well formed and so is never replaced.
  # The offset comes out of the same oracle: prefixes past the first malformed
  # sequence all fail the round trip, so the longest one that survives it ends
  # where that sequence begins.
  #
  # "" when the two agree about `b`, otherwise a sentence naming the input.
  let disagreement = (b: Bytes) => {
    var valid = 0
    var k = 0
    while k <= len(b) {
      let p = slice(b, 0, k)
      if utf8(decode_utf8_lossy(p)) == p { valid = k }
      k = k + 1
    }
    match decode_utf8_checked(b) {
      Ok(s) -> {
        if valid != len(b) {
          to_hex(b) ++ " accepted, but the lossy decoder rewrote it at "
            ++ to_string(valid)
        } else if s != decode_utf8_lossy(b) {
          to_hex(b) ++ " accepted as a different string than the lossy decoder built"
        } else {
          ""
        }
      }
      Err(e) -> {
        if valid == len(b) {
          to_hex(b) ++ " refused at " ++ to_string(e.offset)
            ++ ", but the lossy decoder left it alone"
        } else if e.offset != valid {
          to_hex(b) ++ " refused at " ++ to_string(e.offset)
            ++ ", but the lossy decoder rewrote it at " ++ to_string(valid)
        } else {
          ""
        }
      }
    }
  }

  var bad = ""
  var seen = 0
  # every one- and two-byte input there is
  var i = 0
  while i < 256 {
    let one = freeze(put(buf(), i))
    if bad == "" { bad = disagreement(one) }
    seen = seen + 1
    var j = 0
    while j < 256 {
      let two = freeze(put(put(buf(), i), j))
      if bad == "" { bad = disagreement(two) }
      seen = seen + 1
      j = j + 1
    }
    i = i + 1
  }
  # three and four bytes over the boundaries of every row of the table: the
  # ends of the continuation range, the second-byte limits that refuse the
  # overlong forms and the surrogates, and the lead bytes on each side of every
  # width change
  let alpha = from_hex("00417f808f909fa0bfc1c2dfe0e1ecedeeeff0f3f4f5ff").expect("alphabet")
  let short = from_hex("41808f90bfc2e0edeff0f3f4f5").expect("alphabet")
  var a = 0
  while a < len(alpha) {
    var b = 0
    while b < len(alpha) {
      var c = 0
      while c < len(alpha) {
        let three = freeze(put(put(put(buf(), at(alpha, a)), at(alpha, b)), at(alpha, c)))
        if bad == "" { bad = disagreement(three) }
        seen = seen + 1
        c = c + 1
      }
      b = b + 1
    }
    a = a + 1
  }
  var p = 0
  while p < len(short) {
    var q = 0
    while q < len(short) {
      var r = 0
      while r < len(short) {
        var s = 0
        while s < len(short) {
          let four = freeze(put(put(put(put(buf(), at(short, p)), at(short, q)),
            at(short, r)), at(short, s)))
          if bad == "" { bad = disagreement(four) }
          seen = seen + 1
          s = s + 1
        }
        r = r + 1
      }
      q = q + 1
    }
    p = p + 1
  }
  # `bad` carries the case, which an `assert` on it could not print
  if bad != "" {
    panic("decode_utf8_checked disagrees with decode_utf8_lossy: " ++ bad)
  }
  # and the count says the sweep ran, so a green above is not an empty one
  assert seen == 256 + 65536 + 12167 + 28561
}

test "for over Bytes yields each byte once, as 0..255" {
  var seen: List[Int] = []
  var n = 0
  for x in utf8("AB") {
    seen = seen ++ [x]
    n = n + 1
  }
  assert n == 2
  assert seen == [0x41, 0x42]
  # the currency is `at`'s, so the high half arrives unsigned rather than as
  # the negative byte a host `byte[]` would hand over
  var high: List[Int] = []
  for x in freeze(put(put(buf(), 0x80), 0xFF)) {
    high = high ++ [x]
  }
  assert high == [128, 255]
  var empty = 0
  for _x in utf8("") { empty = empty + 1 }
  assert empty == 0
}

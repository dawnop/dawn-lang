# Failed name resolution is an answer too. Retain what was read at the
# checking boundary, not an AST guess or a later lookup after inference.
# This portable, optional log records function-body namespace queries;
# it is deliberately not a proof that all semantic dependencies were read.
use std/list
use front/ast.{TypeRef, TNamed}
use check/jsig.{JClass, JMethod, JCtor, JField}
use check/types.{Sig, Ty, Eff, TyVar, TyInt, TyAdt, EPure, EIo, EffVar, ELabeled, BuiltinTypeI, BtLeaf, BtList, BtStdOnly, BtPublic}

pub type NamedFunctionRead = { name: String, answer: Option[Sig] }
pub type ExportDiagnostic = { message: String, hint: Option[String] }
pub type AliasTypeHeader = { name: String, tparams: List[Ty], eparams: List[Eff], opaque_id: Option[Int], owner: String }
pub type ExportDiagnosticKind = ValueDiagnostic | FunctionDiagnostic | ConstructorDiagnostic | TypeDiagnostic
pub type AssociatedKind = AssociatedType | AssociatedEffect
pub type FunctionRead = FunctionAnswer(read: NamedFunctionRead) | FunctionCandidates(names: List[String]) |
QualifiedFunction(qualifier: String, read: NamedFunctionRead) | ModuleAlias(qualifier: String, path: Option[String]) |
QualifiedConstant(qualifier: String, name: String, answer: Option[(String, Ty)]) |
QualifiedConstructor(qualifier: String, name: String, answer: Option[(Int, Int)]) |
ExportPresence(qualifier: String, present: Bool) |
ExportDiagnosticAnswer(kind: ExportDiagnosticKind, qualifier: String, name: String, answer: Option[ExportDiagnostic]) |
QualifiedAliasHeader(qualifier: String, name: String, answer: Option[AliasTypeHeader]) |
QualifiedAliasTarget(qualifier: String, name: String, answer: Option[Ty]) |
NominalTypeName(qualifier: Option[String], name: String, answer: Option[Int]) |
NominalTypeShape(id: Int, name: String, arity: Int, eparams: List[String], is_record: Bool) |
LocalTypeDiagnostic(name: String, answer: ExportDiagnostic) |
LocalAliasTarget(name: String, answer: Option[Ty]) |
LocalAliasResolving(name: String, active: Bool) |
LocalAliasSource(name: String, owner: String, target: Option[TypeRef])
  | LocalAliasHeader(name: String, answer: Option[AliasTypeHeader])
  | LocalAliasBinders(name: String, tparams: List[Ty], eparams: List[Eff])
  | ScopedTypeParameter(name: String, answer: Option[Ty])
  | ParameterBounds(subject: Ty, answer: Option[List[Int]])
  | TraitAssociatedMembers(id: Int, kind: AssociatedKind, names: List[String])
  | DeclaredEffect(name: String, answer: Option[Eff])
  | ScopedEffectVariable(name: String, answer: Option[Eff])
  | BuiltinTypeAnswer(name: String, answer: Option[BuiltinTypeI])
  | StdModuleMode(is_std: Bool)
  | JavaClassName(name: String, answer: Option[String])
  | JavaClassInfo(fqcn: String, answer: JClass)
  | JavaMethods(fqcn: String, answer: List[JMethod])
  | JavaConstructors(fqcn: String, answer: List[JCtor])
  | JavaStaticFields(fqcn: String, answer: List[JField])
  | JavaEnabled(enabled: Bool)
  | JavaFindClass(name: String, answer: Option[JClass])
  | JavaClassNames(names: List[String])

pub fn observe(reads: Option[List[FunctionRead]], fact: FunctionRead) -> Option[List[FunctionRead]] =
  match reads { None -> None, Some(entries) -> Some(entries ++ [fact]) }

pub fn record(reads: Option[List[FunctionRead]], name: String, answer: Option[Sig]) -> Option[List[FunctionRead]] =
  match reads {
    None -> None
    Some(entries) -> Some(entries ++ [FunctionAnswer(NamedFunctionRead { name: name, answer: answer })])
  }

pub fn candidates(reads: Option[List[FunctionRead]], names: List[String]) -> Option[List[FunctionRead]] =
  match reads {
    None -> None
    Some(entries) -> Some(entries ++ [FunctionCandidates(names)])
  }

pub fn qualified(reads: Option[List[FunctionRead]], qualifier: String, name: String, answer: Option[Sig]) -> Option[List[FunctionRead]] =
  match reads {
    None -> None
    Some(entries) -> Some(entries ++ [QualifiedFunction(qualifier, NamedFunctionRead { name: name, answer: answer })])
  }

pub fn module_alias(reads: Option[List[FunctionRead]], qualifier: String, path: Option[String]) -> Option[List[FunctionRead]] =
  match reads {
    None -> None
    Some(entries) -> Some(entries ++ [ModuleAlias(qualifier, path)])
  }

pub fn capture(before: Option[List[FunctionRead]], after: Option[List[FunctionRead]]) -> Option[Option[List[FunctionRead]]] = {
  match (before, after) {
    (None, None) -> Some(None)
    (Some(prefix), Some(entries)) -> {
      if len(entries) < len(prefix) || list.take(entries, len(prefix)) != prefix { return None }
      Some(Some(list.drop(entries, len(prefix))))
    }
    _ -> None
  }
}

pub fn append(current: Option[List[FunctionRead]], writes: Option[List[FunctionRead]]) -> Option[Option[List[FunctionRead]]] =
  match (current, writes) {
    (None, None) -> Some(None)
    (Some(prefix), Some(entries)) -> Some(Some(prefix ++ entries))
    _ -> None
  }

## The enclosing owner fixes the source module's namespace. References in
## successful answers must move even if their spelling did not change.
fn project_alias_binders(tparams: List[Ty], eparams: List[Eff], type_value: fn(Ty) -> Option[Ty],
  effect_value: fn(Eff) -> Option[Eff]) -> Option[(List[Ty], List[Eff])] = {
  var types: List[Ty] = []
  for ty in tparams { types = types ++ [type_value(ty)?] }
  var effects: List[Eff] = []
  for eff in eparams { effects = effects ++ [effect_value(eff)?] }
  Some((types, effects))
}

fn project_alias_header(answer: Option[AliasTypeHeader], type_value: fn(Ty) -> Option[Ty],
  nominal: fn(Int) -> Option[Int], effect_value: fn(Eff) -> Option[Eff]) -> Option[Option[AliasTypeHeader]] = {
  let moved = match answer {
    None -> None
    Some(header) -> {
      let (types, effects) = project_alias_binders(header.tparams, header.eparams, type_value, effect_value)?
      let opaque = match header.opaque_id { None -> None, Some(id) -> Some(nominal(id)?) }
      Some(AliasTypeHeader { ..header, tparams: types, eparams: effects, opaque_id: opaque })
    }
  }
  Some(moved)
}

pub fn project(reads: Option[List[FunctionRead]], signature: fn(Sig) -> Option[Sig],
  type_value: fn(Ty) -> Option[Ty], nominal: fn(Int) -> Option[Int],
  effect_value: fn(Eff) -> Option[Eff]) -> Option[Option[List[FunctionRead]]] =
  project_with_source(reads, signature, type_value, nominal, effect_value, (owner, source) => None)

## Declaration spans belong to their owner, not the body consuming the alias.
## A caller without source provenance must reject, never keep stale positions.
pub fn project_with_source(reads: Option[List[FunctionRead]], signature: fn(Sig) -> Option[Sig],
  type_value: fn(Ty) -> Option[Ty], nominal: fn(Int) -> Option[Int],
  effect_value: fn(Eff) -> Option[Eff], source_value: fn(String, TypeRef) -> Option[TypeRef]) -> Option[Option[List[FunctionRead]]] =
  project_with_traits(reads, signature, type_value, nominal, effect_value, source_value, id => None)

## Trait references in scope bounds cannot borrow the nominal ID mapping.
pub fn project_with_traits(reads: Option[List[FunctionRead]], signature: fn(Sig) -> Option[Sig],
  type_value: fn(Ty) -> Option[Ty], nominal: fn(Int) -> Option[Int],
  effect_value: fn(Eff) -> Option[Eff], source_value: fn(String, TypeRef) -> Option[TypeRef],
  trait_value: fn(Int) -> Option[Int]) -> Option[Option[List[FunctionRead]]] = {
  match reads {
    None -> Some(None)
    Some(entries) -> {
      var out: List[FunctionRead] = []
      for entry in entries {
        let moved = match entry {
          FunctionAnswer(read) -> {
            let answer = match read.answer {
              Some(s) -> Some(signature(s)?)
              None -> None
            }
            FunctionAnswer(NamedFunctionRead { name: read.name, answer: answer })
          }
          FunctionCandidates(names) -> FunctionCandidates(names)
          QualifiedFunction(qualifier, read) -> {
            let answer = match read.answer {
              Some(sig) -> Some(signature(sig)?)
              None -> None
            }
            QualifiedFunction(qualifier, NamedFunctionRead { name: read.name, answer: answer })
          }
          ModuleAlias(qualifier, path) -> ModuleAlias(qualifier, path)
          QualifiedConstant(qualifier, name, answer) -> {
            let moved_answer = match answer {
              None -> None
              Some(pair) -> { let (owner, ty) = pair
                Some((owner, type_value(ty)?))
              }
            }
            QualifiedConstant(qualifier, name, moved_answer)
          }
          QualifiedConstructor(qualifier, name, answer) -> {
            let moved_answer = match answer {
              None -> None
              Some(pair) -> { let (adt, slot) = pair
                Some((nominal(adt)?, slot))
              }
            }
            QualifiedConstructor(qualifier, name, moved_answer)
          }
          ExportPresence(qualifier, present) -> ExportPresence(qualifier, present)
          ExportDiagnosticAnswer(kind, qualifier, name, answer) -> ExportDiagnosticAnswer(kind, qualifier, name, answer)
          QualifiedAliasHeader(qualifier, name, answer) -> {
            let moved_answer = project_alias_header(answer, type_value, nominal, effect_value)?
            QualifiedAliasHeader(qualifier, name, moved_answer)
          }
          LocalAliasHeader(name, answer) -> LocalAliasHeader(name, project_alias_header(answer, type_value, nominal, effect_value)?)
          LocalAliasBinders(name, tparams, eparams) -> {
            let (types, effects) = project_alias_binders(tparams, eparams, type_value, effect_value)?
            LocalAliasBinders(name, types, effects)
          }
          QualifiedAliasTarget(qualifier, name, answer) -> {
            let moved_answer = match answer { None -> None, Some(ty) -> Some(type_value(ty)?) }
            QualifiedAliasTarget(qualifier, name, moved_answer)
          }
          NominalTypeName(qualifier, name, answer) -> {
            let moved_answer = match answer { None -> None, Some(id) -> Some(nominal(id)?) }
            NominalTypeName(qualifier, name, moved_answer)
          }
          NominalTypeShape(id, name, arity, eparams, is_record) -> NominalTypeShape(nominal(id)?, name, arity, eparams, is_record)
          LocalTypeDiagnostic(name, answer) -> LocalTypeDiagnostic(name, answer)
          LocalAliasTarget(name, answer) -> {
            let moved_target = match answer { None -> None, Some(ty) -> Some(type_value(ty)?) }
            LocalAliasTarget(name, moved_target)
          }
          LocalAliasResolving(name, active) -> LocalAliasResolving(name, active)
          LocalAliasSource(name, owner, target) -> {
            let moved_source = match target { None -> None, Some(source) -> Some(source_value(owner, source)?) }
            LocalAliasSource(name, owner, moved_source)
          }
          ScopedTypeParameter(name, answer) -> {
            let moved_parameter = match answer { None -> None, Some(ty) -> Some(type_value(ty)?) }
            ScopedTypeParameter(name, moved_parameter)
          }
          ParameterBounds(subject, answer) -> {
            let moved_bounds = match answer {
              None -> None
              Some(bounds) -> {
                var ids: List[Int] = []
                for id in bounds { ids = ids ++ [trait_value(id)?] }
                Some(ids)
              }
            }
            ParameterBounds(type_value(subject)?, moved_bounds)
          }
          TraitAssociatedMembers(id, kind, names) -> TraitAssociatedMembers(trait_value(id)?, kind, names)
          DeclaredEffect(name, answer) -> {
            let moved_effect = match answer { None -> None, Some(row) -> Some(effect_value(row)?) }
            DeclaredEffect(name, moved_effect)
          }
          ScopedEffectVariable(name, answer) -> {
            let moved_variable = match answer { None -> None, Some(row) -> Some(effect_value(row)?) }
            ScopedEffectVariable(name, moved_variable)
          }
          BuiltinTypeAnswer(name, answer) -> {
            let moved_builtin = match answer {
              None -> None
              Some(info) -> {
                let build = match info.build { BtLeaf(ty) -> BtLeaf(type_value(ty)?), other -> other }
                Some(BuiltinTypeI { ..info, build: build })
              }
            }
            BuiltinTypeAnswer(name, moved_builtin)
          }
          StdModuleMode(is_std) -> StdModuleMode(is_std)
          JavaClassName(name, answer) -> JavaClassName(name, answer)
          JavaClassInfo(fqcn, answer) -> JavaClassInfo(fqcn, answer)
          JavaMethods(fqcn, answer) -> JavaMethods(fqcn, answer)
          JavaConstructors(fqcn, answer) -> JavaConstructors(fqcn, answer)
          JavaStaticFields(fqcn, answer) -> JavaStaticFields(fqcn, answer)
          JavaEnabled(enabled) -> JavaEnabled(enabled)
          JavaFindClass(name, answer) -> JavaFindClass(name, answer)
          JavaClassNames(names) -> JavaClassNames(names)
        }
        out = out ++ [moved]
      }
      Some(Some(out))
    }
  }
}

test "semantic reads retain misses and capture only the current suffix" {
  let empty: Option[List[FunctionRead]] = Some([])
  let prefix = record(empty, "old", None)
  let after = record(prefix, "missing", None)
  let writes = capture(prefix, after).expect("read suffix")
  assert writes == Some([FunctionAnswer(NamedFunctionRead { name: "missing", answer: None })])
  assert append(empty, writes) == Some(writes)
  assert capture(after, prefix) == None && capture(None, after) == None
  assert append(None, writes) == None && record(None, "ignored", None) == None
}

test "semantic reads project successful answers without dropping missing answers" {
  let sig = Sig { name: "value", param_tys: [], param_names: [], param_defaults: [],
    ret: TyVar("T", 1), eff: EPure, is_builtin: false, tparams: [], constraints: [],
    eparams: [], owner: Some("module"), trait_id: None, op_of: None, inferring: false }
  let reads = candidates(record(record(Some([]), "value", Some(sig)), "missing", None), ["value", "other"])
  let moved = project(reads, s => Some(Sig { ..s, ret: TyInt }), t => None, id => None, e => None).expect("read projection").expect("enabled reads")
  assert moved == [FunctionAnswer(NamedFunctionRead { name: "value", answer: Some(Sig { ..sig, ret: TyInt }) }),
    FunctionAnswer(NamedFunctionRead { name: "missing", answer: None }), FunctionCandidates(["value", "other"])]
  assert project(reads, s => None, t => None, id => None, e => None) == None
}

test "semantic reads retain candidate order and empty answers" {
  let prefix = record(Some([]), "missing", None)
  let reads = candidates(candidates(prefix, ["beta", "alpha", "beta"]), [])
  let writes = capture(prefix, reads).expect("candidate suffix")
  assert writes == Some([FunctionCandidates(["beta", "alpha", "beta"]), FunctionCandidates([])])
  assert append(prefix, writes) == Some(reads)
  assert project(writes, s => None, t => None, id => None, e => None) == Some(writes)
  assert candidates(None, ["ignored"]) == None
}

test "semantic reads preserve qualified identities paths and projected answers" {
  let sig = Sig { name: "value", param_tys: [], param_names: [], param_defaults: [],
    ret: TyVar("T", 1), eff: EPure, is_builtin: false, tparams: [], constraints: [],
    eparams: [], owner: Some("provider"), trait_id: None, op_of: None, inferring: false }
  let prefix = module_alias(Some([]), "h", Some("provider"))
  let reads = module_alias(qualified(qualified(prefix, "h", "value", Some(sig)), "other", "missing", None), "absent", None)
  let writes = capture(prefix, reads).expect("qualified suffix")
  let moved = project(writes, s => Some(Sig { ..s, ret: TyInt }), t => None, id => None, e => None).expect("qualified projection")
  assert moved == Some([QualifiedFunction("h", NamedFunctionRead { name: "value", answer: Some(Sig { ..sig, ret: TyInt }) }),
    QualifiedFunction("other", NamedFunctionRead { name: "missing", answer: None }), ModuleAlias("absent", None)])
  assert append(prefix, writes) == Some(reads)
  assert project(prefix, s => None, t => None, id => None, e => None) == Some(prefix) && project(reads, s => None, t => None, id => None, e => None) == None
  assert qualified(None, "h", "value", Some(sig)) == None && module_alias(None, "h", Some("provider")) == None
}

test "semantic reads project export references in distinct domains" {
  let diagnostic = ExportDiagnostic { message: "not exported", hint: Some("try another name") }
  let reads = Some([QualifiedConstant("h", "VALUE", Some(("provider", TyAdt(1, [])))),
    QualifiedConstructor("h", "Item", Some((1, 1))), QualifiedConstructor("h", "Missing", None),
    ExportPresence("h", true), ExportDiagnosticAnswer(ValueDiagnostic, "h", "Wrong", Some(diagnostic)),
    ExportDiagnosticAnswer(FunctionDiagnostic, "absent", "missing", None)])
  let moved = project(reads, s => None, t => Some(TyInt), id => Some(id + 10), e => None).expect("export projection")
  assert moved == Some([QualifiedConstant("h", "VALUE", Some(("provider", TyInt))),
    QualifiedConstructor("h", "Item", Some((11, 1))), QualifiedConstructor("h", "Missing", None),
    ExportPresence("h", true), ExportDiagnosticAnswer(ValueDiagnostic, "h", "Wrong", Some(diagnostic)),
    ExportDiagnosticAnswer(FunctionDiagnostic, "absent", "missing", None)])
  assert project(reads, s => None, t => None, id => Some(id), e => None) == None
  assert project(reads, s => None, t => Some(t), id => None, e => None) == None
  let prefix = record(Some([]), "earlier", None)
  let combined = append(prefix, reads).expect("append exports")
  assert capture(prefix, combined) == Some(reads)
  assert observe(None, ExportPresence("h", true)) == None
  assert observe(Some([]), ExportPresence("absent", false)) == Some([ExportPresence("absent", false)])
}

test "semantic reads preserve plain Java metadata without compiler ID mapping" {
  let info = JClass { fqcn: "pkg.Box", simple: "Box", display: "ReadableBox",
    is_interface: true, is_primitive: false, is_array: true }
  let reads = Some([JavaClassName("Foreign", Some("pkg.Box")), JavaClassName("Missing", None),
    JavaClassInfo("lookup.Box", info), JavaEnabled(true), JavaEnabled(false),
    JavaFindClass("lookup.Found", Some(info)), JavaFindClass("lookup.Missing", None),
    JavaClassNames(["Z", "A"]), JavaClassNames([])])
  assert project(reads, s => None, t => None, id => None, e => None) == Some(reads)
  let prefix = Some([JavaClassName("Earlier", None)])
  assert capture(prefix, append(prefix, reads).expect("append Java reads")) == Some(reads)
}

test "semantic reads preserve ordered Java candidates and empty answers" {
  let method = JMethod { name: "z", param_cls: ["long", "java.lang.String"], ret_cls: "pkg.Result",
    is_static: true, is_varargs: true, is_abstract: true, desc: "method descriptor", decl_cls: "pkg.Parent" }
  let other_method = JMethod { ..method, name: "a", is_static: false, is_varargs: false, is_abstract: false }
  let ctor = JCtor { param_cls: ["long", "java.lang.String"], is_varargs: true, desc: "z constructor" }
  let other_ctor = JCtor { param_cls: [], is_varargs: false, desc: "a constructor" }
  let field = JField { name: "z", type_cls: "long", decl_cls: "pkg.Parent" }
  let other_field = JField { name: "a", type_cls: "pkg.Result", decl_cls: "pkg.Other" }
  let reads = Some([JavaMethods("lookup.Methods", [method, other_method, method, method]),
    JavaConstructors("lookup.Constructors", [ctor, other_ctor, ctor, ctor]),
    JavaStaticFields("lookup.Fields", [field, other_field, field, field]),
    JavaMethods("empty.Methods", []), JavaConstructors("empty.Constructors", []), JavaStaticFields("empty.Fields", [])])
  assert project(reads, s => None, t => None, id => None, e => None) == Some(reads)
  assert capture(Some([]), reads) == Some(reads)
}

test "semantic reads project builtin leaf types and preserve access metadata" {
  let leaf = BuiltinTypeI { name: "Display", params: ["Z", "A"], access: BtStdOnly, build: BtLeaf(TyVar("T", 1)) }
  let list_info = BuiltinTypeI { name: "List", params: ["T"], access: BtPublic, build: BtList }
  let reads = Some([BuiltinTypeAnswer("Lookup", Some(leaf)), BuiltinTypeAnswer("List", Some(list_info)),
    BuiltinTypeAnswer("Missing", None), StdModuleMode(false), StdModuleMode(true)])
  let type_map: fn(Ty) -> Option[Ty] = ty => match ty { TyVar(name, id) -> Some(TyVar(name, id + 10)), _ -> None }
  assert project(reads, s => None, type_map, id => None, e => None) == Some(Some([
    BuiltinTypeAnswer("Lookup", Some(BuiltinTypeI { ..leaf, build: BtLeaf(TyVar("T", 11)) })),
    BuiltinTypeAnswer("List", Some(list_info)), BuiltinTypeAnswer("Missing", None), StdModuleMode(false), StdModuleMode(true)]))
  assert project(reads, s => None, t => None, id => Some(id), e => None) == None
  let fixed = Some([BuiltinTypeAnswer("List", Some(list_info)), BuiltinTypeAnswer("Missing", None), StdModuleMode(false)])
  assert project(fixed, s => None, t => None, id => None, e => None) == Some(fixed)
}

test "semantic reads project declared and scoped effect answers" {
  let reads = Some([DeclaredEffect("Ask", Some(ELabeled(EPure, [(1, "ProviderAsk")]))),
    DeclaredEffect("Missing", None), ScopedEffectVariable("e", Some(EffVar("e", 2))),
    ScopedEffectVariable("new", None), ScopedEffectVariable("pure", Some(EPure))])
  let effect_map: fn(Eff) -> Option[Eff] = row => match row {
    ELabeled(base, labels) -> {
      let (id, name) = labels[0]
      Some(ELabeled(base, [(id + 100, name)]))
    }
    EffVar(name, id) -> Some(EffVar(name, id + 100))
    EPure -> Some(EPure)
    _ -> None
  }
  assert project(reads, s => None, t => None, id => None, effect_map) == Some(Some([
    DeclaredEffect("Ask", Some(ELabeled(EPure, [(101, "ProviderAsk")]))), DeclaredEffect("Missing", None),
    ScopedEffectVariable("e", Some(EffVar("e", 102))), ScopedEffectVariable("new", None), ScopedEffectVariable("pure", Some(EPure))]))
  assert project(reads, s => None, t => None, id => Some(id + 1000), e => None) == None
  let scoped = Some([ScopedEffectVariable("e", Some(EffVar("e", 2)))])
  assert project(scoped, s => None, t => None, id => Some(id), e => None) == None
  let absent = Some([DeclaredEffect("Missing", None), ScopedEffectVariable("new", None)])
  assert project(absent, s => None, t => None, id => None, e => None) == Some(absent)
}

test "semantic reads project associated bounds in the trait domain" {
  let reads = Some([ScopedTypeParameter("T", Some(TyVar("T", 1))), ScopedTypeParameter("Missing", None),
    ParameterBounds(TyVar("T", 1), Some([1, 2, 1])), ParameterBounds(TyVar("U", 2), None),
    TraitAssociatedMembers(1, AssociatedType, ["Item", "Item", "Other"]), TraitAssociatedMembers(2, AssociatedEffect, [])])
  let type_map: fn(Ty) -> Option[Ty] = t => match t { TyVar(n, id) -> Some(TyVar(n, id + 10)), _ -> None }
  let moved = project_with_traits(reads, s => None, type_map, id => Some(id + 1000), e => None,
    (owner, source) => None, id => Some(id + 100))
  assert moved == Some(Some([ScopedTypeParameter("T", Some(TyVar("T", 11))), ScopedTypeParameter("Missing", None),
    ParameterBounds(TyVar("T", 11), Some([101, 102, 101])), ParameterBounds(TyVar("U", 12), None),
    TraitAssociatedMembers(101, AssociatedType, ["Item", "Item", "Other"]), TraitAssociatedMembers(102, AssociatedEffect, [])]))
  assert project(reads, s => None, type_map, id => Some(id), e => None) == None
  assert project_with_traits(reads, s => None, type_map, id => Some(id), e => None,
    (owner, source) => None, id => None) == None
  assert project_with_traits(reads, s => None, t => None, id => Some(id), e => None,
    (owner, source) => None, id => Some(id)) == None
  let empty = Some([ParameterBounds(TyVar("T", 1), Some([])), ScopedTypeParameter("Missing", None)])
  assert project_with_traits(empty, s => None, type_map, id => None, e => None,
    (owner, source) => None, id => None) == Some(Some([ParameterBounds(TyVar("T", 11), Some([])), ScopedTypeParameter("Missing", None)]))
}

test "semantic reads require owner scoped alias source projection" {
  let old = TNamed("Int", [], [], 0, 3)
  let next = TNamed("Int", [], [], 100, 104)
  let reads = Some([LocalAliasSource("Alias", "provider", Some(old)), LocalAliasSource("Imported", "other", None)])
  assert project(reads, s => Some(s), t => Some(t), id => Some(id), e => Some(e)) == None
  let moved = project_with_source(reads, s => Some(s), t => Some(t), id => Some(id), e => Some(e),
    (owner, source) => if owner == "provider" && source == old { Some(next) } else { None })
  assert moved == Some(Some([LocalAliasSource("Alias", "provider", Some(next)), LocalAliasSource("Imported", "other", None)]))
  assert project_with_source(reads, s => Some(s), t => Some(t), id => Some(id), e => Some(e),
    (owner, source) => if owner == "consumer" { Some(next) } else { None }) == None
  let absent = Some([LocalAliasSource("Imported", "provider", None)])
  assert project(absent, s => None, t => None, id => None, e => None) == Some(absent)
}

test "semantic reads project type and effect binders independently" {
  let diagnostic = ExportDiagnostic { message: "unknown type `Missing`", hint: Some("did you mean `Record`?") }
  let header = AliasTypeHeader { name: "Alias", tparams: [TyVar("T", 1)], eparams: [EffVar("e", 1)],
    opaque_id: Some(1), owner: "provider" }
  let reads = Some([QualifiedAliasHeader("h", "Alias", Some(header)), QualifiedAliasHeader("h", "Missing", None),
    QualifiedAliasTarget("h", "Alias", Some(TyVar("T", 1))), QualifiedAliasTarget("h", "Missing", None),
    NominalTypeName(Some("h"), "Record", Some(1)), NominalTypeName(None, "Missing", None),
    NominalTypeShape(1, "Record", 1, ["e"], true), LocalTypeDiagnostic("Missing", diagnostic),
    LocalAliasTarget("Alias", Some(TyVar("T", 1))), LocalAliasTarget("Missing", None),
    LocalAliasResolving("Alias", true), LocalAliasResolving("Other", false),
    LocalAliasHeader("Alias", Some(header)), LocalAliasHeader("Missing", None),
    LocalAliasBinders("Alias", [TyVar("T", 1)], [EffVar("e", 1)])])
  let moved = project(reads, s => None, t => Some(TyInt), id => Some(id + 10), e => Some(EIo)).expect("type reads projection")
  assert moved == Some([QualifiedAliasHeader("h", "Alias", Some(AliasTypeHeader { ..header,
    tparams: [TyInt], eparams: [EIo], opaque_id: Some(11) })), QualifiedAliasHeader("h", "Missing", None),
    QualifiedAliasTarget("h", "Alias", Some(TyInt)), QualifiedAliasTarget("h", "Missing", None),
    NominalTypeName(Some("h"), "Record", Some(11)), NominalTypeName(None, "Missing", None),
    NominalTypeShape(11, "Record", 1, ["e"], true), LocalTypeDiagnostic("Missing", diagnostic),
    LocalAliasTarget("Alias", Some(TyInt)), LocalAliasTarget("Missing", None),
    LocalAliasResolving("Alias", true), LocalAliasResolving("Other", false),
    LocalAliasHeader("Alias", Some(AliasTypeHeader { ..header, tparams: [TyInt], eparams: [EIo], opaque_id: Some(11) })),
    LocalAliasHeader("Missing", None), LocalAliasBinders("Alias", [TyInt], [EIo])])
  assert project(reads, s => None, t => None, id => Some(id), e => Some(e)) == None
  assert project(reads, s => None, t => Some(t), id => None, e => Some(e)) == None
  assert project(reads, s => None, t => Some(t), id => Some(id), e => None) == None
  let transparent = Some([QualifiedAliasHeader("h", "Alias", Some(AliasTypeHeader { ..header, opaque_id: None }))])
  assert project(transparent, s => None, t => Some(t), id => None, e => Some(e)) == Some(transparent)
  let prefix = record(Some([]), "earlier", None)
  assert capture(prefix, append(prefix, reads).expect("append type reads")) == Some(reads)
}

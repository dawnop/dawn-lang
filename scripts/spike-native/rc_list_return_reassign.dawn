# The #505 shape with the outer binding reassigned after the if: the
# reassignment releases the old value, so a copied drop on the untaken arm
# was a second release, and the RC checker refused the function.
fn f(c: Bool) -> String = {
  var trace: List[String] = []
  if c {
    let _: List[Int] = [return "${[0 - 4]}"]
  }
  trace = trace ++ ["a"]
  join(trace, "|")
}

pub fn main() -> Unit !io = {
  println(f(false))
  println(f(true))
}

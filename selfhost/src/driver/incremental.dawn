# One immutable owner fixes the analysis world and retains a safe prefix plus
# optional current-generation body products. No cache crosses an owner boundary.
# The caller commits its returned session together with the query Program.
# No global cache or resource lease lives here; abandoning a session releases
# its replay state, while the caller remains responsible for closing its lease.

use std/io.{Env}
use std/str
use std/map
use std/set
use driver/analyze.{
  LoadedModule, LoadResult, Program, CheckedMod, ModuleStep, AnalysisCarry,
  initial_carry_with_provenance, analyze_module_step, analyze_module_step_cached,
  ModuleBodyCache, CachedModuleStep, module_body_cache_size, canon,
  PreparedLoad, PreparedModule, prepared_result, prepared_modules, analyze_module_step_prepared
}
use driver/stdlib.{StdCtx, std_module_of}
use check/cx.{Cx}
use check/jsig.{Jsig, JsigProbe}
use ir/interp.{CtOpts}

type Entry = { raw: LoadedModule, std_identity: Option[String], canonical_path: String, step: ModuleStep }
type BodyKey = { module_name: String, class_name: String, path: String,
  canonical_path: String, std_identity: Option[String] }
type State = {
  std: StdCtx,
  opts: CtOpts,
  js: Jsig,
  probe: fn(Jsig) -> JsigProbe !io,
  prefix: List[Entry],
  bodies: Map[BodyKey, ModuleBodyCache],
  body_enabled: Bool,
  max_products: Int,
  max_modules: Int,
  max_text_units: Int,
  baseline: AnalysisCarry
}

## Construct a new owner when std, options, captured plan or lease changes.
## Keeping the representation private prevents grafting an old prefix into
## a new world; the host must drop this owner before releasing its Java lease.
pub opaque type Session = State

pub type Stats = {
  reused_modules: Int,
  checked_modules: Int,
  comptime_modules: Int,
  retained_modules: Int,
  retained_text_units: Int,
  checked_bodies: Int, reused_bodies: Int, cold_unadmitted_bodies: Int,
  cold_rejected_bodies: Int, visited_bodies: Int, capture_refused: Int,
  unobserved_modules: Int, retained_body_modules: Int, retained_body_products: Int,
  retained_total_modules: Int, retained_total_text_units: Int
}

pub(pkg) type Update = { session: Session, program: Program, stats: Stats }

pub(pkg) fn new(
  std: StdCtx, opts: CtOpts, js: Jsig, probe: fn(Jsig) -> JsigProbe !io,
  max_modules: Int, max_text_units: Int
) -> Session = {
  if max_modules < 0 || max_text_units < 0 { panic("negative analysis cache limit") }
  State {
    std: std, opts: opts, js: js, probe: probe, prefix: [],
    bodies: map.empty(), body_enabled: false, max_products: 0,
    max_modules: max_modules, max_text_units: max_text_units,
    baseline: initial_carry_with_provenance(std, "session")
  }
}

## Opt in only when the caller owns the entire analysis lifetime. Limits are
## shared by prefix entries and body-cache entries, conservatively charging
## each retained representation even when they describe the same module/text.
pub(pkg) fn new_with_body_cache(
  std: StdCtx, opts: CtOpts, js: Jsig, probe: fn(Jsig) -> JsigProbe !io,
  max_modules: Int, max_text_units: Int, max_products: Int
) -> Session = {
  if max_products < 0 { panic("negative analysis body cache limit") }
  let session: State = new(std, opts, js, probe, max_modules, max_text_units)
  State { ..session, body_enabled: true, max_products: max_products }
}

## Eviction drops replay state, not the caller's current query Program.
pub fn evict(owner: Session) -> Session = {
  let session: State = owner
  State { ..session, prefix: [], bodies: map.empty() }
}

## A permanent cold switch for this owner; reconstruct an owner to re-enable.
## Existing query Programs remain valid independently of retained replay state.
pub fn disable_reuse(owner: Session) -> Session = {
  let session: State = owner
  State { ..session, prefix: [], bodies: map.empty(), body_enabled: false,
    max_modules: 0, max_text_units: 0, max_products: 0 }
}

fn same_input(a: LoadedModule, b: LoadedModule) -> Bool = a == b

# The loader normally rejects ambiguous identities. Public LoadResult values
# need the same cache safety: no last-write-wins map may make two modules share
# products. A collision in any owner coordinate disables reuse for this run.
fn unambiguous(std: StdCtx, loaded: LoadResult) -> Bool !Env = {
  var names: Set[String] = set.empty()
  var classes: Set[String] = set.empty()
  var paths: Set[String] = set.empty()
  for raw in loaded.modules {
    let std_name = std_module_of(std, raw.path)
    let name = std_name.unwrap_or(raw.mod_path)
    let class_name = std_name.unwrap_or(raw.class_name)
    let path = canon(raw.path)
    if set.has(names, name) || set.has(classes, class_name) || set.has(paths, path) { return false }
    names = set.insert(names, name)
    classes = set.insert(classes, class_name)
    paths = set.insert(paths, path)
  }
  true
}

pub(pkg) fn analyze(owner: Session, loaded: LoadResult) -> Update !Env !io =
  analyze_inputs(owner, loaded, None)

## Both input views come from one immutable loader value. There is no public
## API accepting an arbitrary loaded tree beside another revision's proof.
pub(pkg) fn analyze_prepared(owner: Session, prepared: PreparedLoad) -> Update !Env !io =
  analyze_inputs(owner, prepared_result(prepared), Some(prepared_modules(prepared)))

fn analyze_inputs(owner: Session, loaded: LoadResult, prepared: Option[List[PreparedModule]]) -> Update !Env !io = {
  let session: State = owner
  let probe = session.probe(session.js)
  # This label is interpreted only inside this opaque session. No provenance
  # table escapes Update, and a different session cannot import its prefix.
  var carry = session.baseline
  var diags = loaded.diags
  var modules: List[CheckedMod] = []
  var prefix: List[Entry] = []
  var bodies: Map[BodyKey, ModuleBodyCache] = map.empty()
  var matching = len(loaded.diags) == 0
  if session.body_enabled && not unambiguous(session.std, loaded) { matching = false }
  var retaining = matching
  var body_allowed = matching && session.body_enabled && session.max_products > 0 &&
    session.max_modules > 0 && session.max_text_units > 0
  var text_units = 0
  var body_text_units = 0
  var products = 0
  var checked_bodies = 0
  var reused_bodies = 0
  var cold_unadmitted = 0
  var cold_rejected = 0
  var visited = 0
  var capture_refused = 0
  var unobserved = 0
  var reused = 0
  var checked = 0
  var ct_runs = 0
  var index = 0
  for raw in loaded.modules {
    # std identity depends on canonical paths, including the current Env.
    # Recompute it even for a hit; raw text alone is never a cache key.
    let identity = std_module_of(session.std, raw.path)
    let key = BodyKey { module_name: raw.mod_path, class_name: raw.class_name,
      path: raw.path, canonical_path: if session.body_enabled { canon(raw.path) } else { raw.path },
      std_identity: identity }
    var next_body: Option[ModuleBodyCache] = None
    let hit = matching && index < len(session.prefix) &&
      same_input(raw, session.prefix[index].raw) &&
      identity == session.prefix[index].std_identity &&
      (not session.body_enabled || key.canonical_path == session.prefix[index].canonical_path)
    let step = if hit {
      reused = reused + 1
      if body_allowed { next_body = map.get(session.bodies, key) }
      session.prefix[index].step
    } else {
      # Once the prefix differs, never reconnect to an old suffix.
      matching = false
      let queries_before = probe.queries()
      let result = if body_allowed {
        match prepared {
          Some(entries) -> analyze_module_step_prepared(entries[index], carry, session.std, session.opts, probe.jsig,
            None, map.get(session.bodies, key))
          None -> analyze_module_step_cached(raw, carry, session.std, session.opts, probe.jsig, None,
            map.get(session.bodies, key))
        }
      } else {
        CachedModuleStep { step: analyze_module_step(raw, carry, session.std, session.opts, probe.jsig, None),
          cache: None, counts: None }
      }
      let computed = result.step
      next_body = result.cache
      match result.counts {
        Some(counts) -> {
          checked_bodies = checked_bodies + counts.checked
          reused_bodies = reused_bodies + counts.reused
          cold_unadmitted = cold_unadmitted + counts.cold_unadmitted
          cold_rejected = cold_rejected + counts.cold_rejected
          visited = visited + counts.visited
          capture_refused = capture_refused + counts.capture_refused
        }
        None -> { unobserved = unobserved + computed.check_runs }
      }
      checked = checked + computed.check_runs
      ct_runs = ct_runs + computed.comptime_runs
      if len(computed.diags) != 0 || probe.queries() != queries_before {
        retaining = false
        body_allowed = false
        next_body = None
      }
      # Tooling must use the original oracle, not keep or mutate this run's
      # observation counter through a stored checker context.
      let cx = Cx { ..computed.checked.cx, jsig: session.js }
      ModuleStep { ..computed, checked: CheckedMod { ..computed.checked, cx: cx } }
    }
    carry = step.after
    diags = diags ++ step.diags
    modules = modules ++ [step.checked]
    let units = str.len(raw.text)
    # Prefer body products when both representations compete for capacity.
    # This table contains only this run's returned products (or exact prefix
    # hits), never a union with removed modules from the previous revision.
    match next_body {
      Some(cache) -> {
        let count = module_body_cache_size(cache)
        if body_allowed && count > 0 && count <= session.max_products - products &&
          len(prefix) + map.len(bodies) < session.max_modules &&
          units <= session.max_text_units - text_units - body_text_units {
            bodies = map.insert(bodies, key, cache)
            products = products + count
            body_text_units = body_text_units + units
          }
      }
      None -> ()
    }
    if retaining && len(prefix) + map.len(bodies) < session.max_modules &&
      units <= session.max_text_units - text_units - body_text_units {
        prefix = prefix ++ [Entry { raw: raw, std_identity: identity,
          canonical_path: key.canonical_path, step: step }]
        text_units = text_units + units
      } else {
        retaining = false
      }
    index = index + 1
  }
  Update {
    session: State { ..session, prefix: prefix, bodies: bodies },
    # the view of the revision this Update is about, which is the last carry
    # the loop produced: a reused step contributes the view it was analyzed
    # with, and a reused step is one whose input text is identical
    program: Program { modules: modules, diags: diags, decl_spans: carry.decl_spans },
    stats: Stats {
      reused_modules: reused, checked_modules: checked, comptime_modules: ct_runs,
      retained_modules: len(prefix), retained_text_units: text_units,
      checked_bodies: checked_bodies, reused_bodies: reused_bodies,
      cold_unadmitted_bodies: cold_unadmitted, cold_rejected_bodies: cold_rejected,
      visited_bodies: visited, capture_refused: capture_refused,
      unobserved_modules: unobserved, retained_body_modules: map.len(bodies),
      retained_body_products: products, retained_total_modules: len(prefix) + map.len(bodies),
      retained_total_text_units: text_units + body_text_units
    }
  }
}

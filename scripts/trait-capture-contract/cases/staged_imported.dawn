# The public protocol and generic forwarding body retain the caller's domain.
use std/mem
use staged_imports/protocol.{Cond, invoke}
pub fn main() -> Unit !io = {
  let answer = mem.with_mem([@s] () => {
    let buffer = mem.new(5)
    let condition = Cond { n = 1 }
    invoke(condition, () => {
      if len(buffer) != 5 { panic("imported callback lost its resource") }
    }, () => ())
    17
  })
  println(to_string(answer))
}

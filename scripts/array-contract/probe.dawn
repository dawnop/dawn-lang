# Driver for the Array contract. Everything interesting is in the std-side
# module: user code cannot name `Array`, which is the point. The clock is
# here rather than there because std modules may not `use java` (the checker
# refuses it -- std loads against the refusing oracle), while this file
# compiles as a user program under the real JVM toolchain.
use std/io
use std/array
use java "java.lang.System"

fn now_ms() -> Int !io = System.currentTimeMillis()

## Small enough to stay instant on the fast path, large enough that losing it
## means quadratic work measured in minutes.
const LINEAR_N: Int = 200000

## The copying shape has to stay small: it is O(n^2) by construction, and the
## point is to show it *is* the other path, not to wait for it.
const FORK_N: Int = 20000

pub fn main() -> Unit !io = {
  for line in array.values() { println(line) }
  println("bounds   ${array.out_of_bounds()}")
  println("frombuf  ${array.from_array()}")
  # `array_push` extending in place is deliberately unobservable from Dawn,
  # so it is checked by the clock: the two shapes differ by a factor of n.
  let t0 = now_ms()
  array.linear_build(LINEAR_N)
  let t1 = now_ms()
  array.forked_sum(FORK_N)
  let t2 = now_ms()
  println("linear   ${LINEAR_N} pushes in ${t1 - t0}ms")
  println("forked   ${FORK_N} pushes in ${t2 - t1}ms")
}

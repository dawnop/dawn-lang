# Or-patterns use the same recursive grammar in match arms and structural lets.

type Choice = Left(value: Int) | Right(value: Int)

fn choose(c: Choice) -> Int =
  match c {
    Left(x) | Right(x) if x >= 0 -> x
    _ -> 0
  }

fn nested(v: Option[(Int, List[Int])]) -> Int =
  match v {
    Some((0 | 1 | (2), [0 | 1, ..])) -> 1
    _ -> 0
  }

fn structural(flag: Bool) -> Bool = {
  let (true | false) = flag
  flag
}

# expect: only a variable can be assigned
# expect: only a variable can be assigned
# expect: only a variable can be assigned
# Only `name = e` is an assignment. Lists and maps are read-only (spec §4.8)
# and record fields immutable (§2.4), so an index, a field or a call on the
# left of `=` is refused as a target, each with the spelling of the update it
# was reaching for (#193), not with the generic "one statement per line".
type R = { f: Int }
fn f(xs: List[Int], r: R) -> Unit = {
  xs[0] = 9
  r.f = 2
  g(r) = 3
}

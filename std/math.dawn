# With |z| <= 1/2, the alternating tail after z^121/121 is
# at most |z|^123/123 < 2^-129. A pi/4 transform reduces larger ratios.
fn dd_atan_unit(ratio: (Float, Float)) -> (Float, Float) = {
  let transform = dd_hi(ratio) > 0.5
  let z = if transform {
    dd_div(dd_add(ratio, (-1.0, 0.0)), dd_add(ratio, (1.0, 0.0)))
  } else { ratio }
  let zz = dd_mul(z, z)
  var p = DD_ATAN_COEFF[60]
  var i = 59
  while i >= 0 {
    p = dd_add(DD_ATAN_COEFF[i], dd_mul(zz, p))
    i = i - 1
  }
  let a = dd_mul(z, p)
  if transform { dd_add(dd_mul(DD_PI, (0.25, 0.0)), a) } else { a }
}

## Angle of (x,y) in radians, with compensated quotient and quadrant evaluation.
## Signed zeros and infinity quadrants follow fdlibm, including atan2(+0,-0)=PI
## and atan2(-0,-0)=-PI. Either NaN gives NaN. True error is at most 1 ulp.
## The oracle registry records why this differs from StrictMath.atan2.
pub fn atan2(y: Float, x: Float) -> Float = {
  if not float.is_finite(x) || not float.is_finite(y) || x == 0.0 || y == 0.0 { return fd_atan2(y, x) }
  let ay = abs(y)
  let ax = abs(x)
  let (my, ey) = frexp(ay)
  let (mx, ex) = frexp(ax)
  let delta = ey - ex
  # At this scale the neglected angle is < 2^-59. The ordinary division
  # supplies correctly rounded gradual underflow when the angle tends to zero.
  if delta > 60 { return copysign(PI * 0.5, y) }
  if delta < -60 { return if x > 0.0 { y / x } else { copysign(PI, y) } }
  let invert = ay > ax
  let r = if invert { dd_div((ldexp(mx, ex - ey), 0.0), (my, 0.0)) }
  else { dd_div((ldexp(my, ey - ex), 0.0), (mx, 0.0)) }
  var a = dd_atan_unit(r)
  if invert { a = dd_add(dd_mul(DD_PI, (0.5, 0.0)), dd_neg(a)) }
  if x < 0.0 { a = dd_add(DD_PI, dd_neg(a)) }
  copysign(dd_hi(a) + dd_lo(a), y)
}

# Half exp(a) scales only after the compensated evaluation, so inputs just
# above log(MAX) never overflow a temporary. The omitted exp(-a)/2 is < 2^-64
# relative for a >= 22, comfortably below the final rounding allowance.
fn dd_half_exp(a: Float) -> Float = {
  if a >= 711.0 { return float.INFINITY }
  let (p, k) = dd_exp_reduction(a)
  ldexp(dd_hi(p) + dd_lo(p), k - 1)
}

## Hyperbolic sine. Preserve signed zero and infinities; NaN propagates.
## Finite overflow gives signed infinity. Compensated exp and subtraction
## replace StrictMath's rounded expm1 composition; true error is at most 1 ulp.
pub fn sinh(x: Float) -> Float = {
  if not float.is_finite(x) { return x }
  let a = abs(x)
  if a < float_of_bits(0x3e30000000000000) { return x }
  if a >= 22.0 { return copysign(dd_half_exp(a), x) }
  let e = dd_exp(a)
  let inv = dd_div((1.0, 0.0), e)
  let result = dd_mul((0.5, 0.0), dd_add(e, dd_neg(inv)))
  copysign(dd_hi(result) + dd_lo(result), x)
}

## Hyperbolic cosine. Both zeros give 1; either infinity gives +infinity;
## NaN propagates. Finite overflow gives +infinity. Compensated exp and addition
## replace StrictMath's rounded composition; true error is at most 1 ulp.
pub fn cosh(x: Float) -> Float = {
  if float.is_nan(x) { return x }
  let a = abs(x)
  if a < float_of_bits(0x3e30000000000000) { return 1.0 }
  if a >= 22.0 { return dd_half_exp(a) }
  let e = dd_exp(a)
  let result = dd_mul((0.5, 0.0), dd_add(e, dd_div((1.0, 0.0), e)))
  dd_hi(result) + dd_lo(result)
}

test "transcendentals preserve special values and domain boundaries" {
  for op in [sin, tan, asin, atan, sinh, tanh, cbrt, expm1, log1p] {
    assert float_to_bits(op(-0.0)) == 1 << 63
    assert float.is_nan(op(float.NAN))
  }
  for op in [sin, cos, tan, asin, acos] { assert float.is_nan(op(float.INFINITY)) }
  for op in [log, log2, log10] {
    assert op(0.0) == -float.INFINITY
    assert op(-0.0) == -float.INFINITY
    assert float.is_nan(op(-1.0))
    assert op(float.INFINITY) == float.INFINITY
    assert op(1.0) == 0.0
  }
  assert exp(-float.INFINITY) == 0.0
  assert exp(float.INFINITY) == float.INFINITY
  assert exp(0.0) == 1.0
  assert expm1(-float.INFINITY) == -1.0
  assert log1p(-1.0) == -float.INFINITY
  assert float.is_nan(log1p(-2.0))
  assert cosh(-float.INFINITY) == float.INFINITY
  assert tanh(-float.INFINITY) == -1.0
  assert acos(1.0) == 0.0
  assert acos(-1.0) == PI
}

test "base two functions are exact on every representable power" {
  for power_index in range(-1074, 1024) {
    let power_value = ldexp(1.0, power_index)
    assert exp2(to_float(power_index)) == power_value
    assert log2(power_value) == to_float(power_index)
  }
  assert exp2(-1075.0) == 0.0
  assert exp2(1024.0) == float.INFINITY
}

test "binary transcendental special rules retain quadrant and parity" {
  assert float_to_bits(atan2(-0.0, 0.0)) == 1 << 63
  assert atan2(0.0, -0.0) == PI
  assert atan2(-0.0, -0.0) == -PI
  assert atan2(float.INFINITY, float.INFINITY) == PI * 0.25
  assert atan2(float.INFINITY, -float.INFINITY) == PI * 0.75
  assert hypot(float.INFINITY, float.NAN) == float.INFINITY
  assert hypot(float.NAN, -float.INFINITY) == float.INFINITY
  assert pow(float.NAN, 0.0) == 1.0
  assert float.is_nan(pow(-1.0, float.INFINITY))
  assert float.is_nan(pow(-2.0, 0.5))
  assert float_to_bits(pow(-0.0, 3.0)) == 1 << 63
  assert pow(-0.0, -3.0) == -float.INFINITY
}

test "compensated algorithms keep the MPFR hard cases" {
  assert float_to_bits(tanh(float_of_bits(-4625859314199082240))) == -4626005395199644420
  assert float_to_bits(sinh(float_of_bits(-4626150516536001627))) == -4626083282661128340
  assert float_to_bits(cosh(float_of_bits(4649458370416596732))) == 9216829842976134031
  assert float_to_bits(atan2(float_of_bits(-3088086972424488266), float_of_bits(-3095437049298422897))) == -4612222631650719084
}

# The fourth verdict (see run.sh): an opaque type inherits only `Eq`, `Hash`
# and `Ord` from its target (spec 2.7), so a user trait with an impl for `Int`
# only is answered for the alias twin, where `Id` IS `Int`, and refused for the
# opaque type, which has no impl of its own.
# twin-refused-alias-ok: has no such impl
opaque type Id = Int

trait Describe[T] {
  fn describe(x: T) -> String
}

impl Describe[Int] {
  fn describe(x: Int) -> String = "int"
}

fn describe_it[T: Describe](x: T) -> String = describe(x)

fn mk(n: Int) -> Id = n

pub fn main() -> Unit !io = println(describe_it(mk(1)))

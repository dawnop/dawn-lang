use std/float
use std/list

## Pi, rounded to binary64 with MPFR.
pub const PI: Float = float_of_bits(0x400921fb54442d18)
## Euler's number, rounded to binary64 with MPFR.
pub const E: Float = float_of_bits(0x4005bf0a8b145769)
## Two pi, rounded to binary64 with MPFR.
pub const TAU: Float = float_of_bits(0x401921fb54442d18)
## Natural logarithm of two, rounded to binary64 with MPFR.
pub const LN_2: Float = float_of_bits(0x3fe62e42fefa39ef)
## Natural logarithm of ten, rounded to binary64 with MPFR.
pub const LN_10: Float = float_of_bits(0x40026bb1bbb55516)
## Base-two logarithm of e, rounded to binary64 with MPFR.
pub const LOG2_E: Float = float_of_bits(0x3ff71547652b82fe)
## Base-ten logarithm of e, rounded to binary64 with MPFR.
pub const LOG10_E: Float = float_of_bits(0x3fdbcb7b1526e50e)
## Square root of two, rounded to binary64 with MPFR.
pub const SQRT_2: Float = float_of_bits(0x3ff6a09e667f3bcd)

## Correctly rounded square root. Preserves both zeros and +infinity;
## negative nonzero inputs and NaN return NaN.
pub fn sqrt(x: Float) -> Float = float_sqrt(x)

## The exact x*y+z rounded once, including intermediate overflow and underflow.
## Zero times infinity and opposite infinities return NaN. Exact cancellation
## returns +0; a negative zero product plus negative zero returns -0. NaN propagates.
pub fn fma(x: Float, y: Float, z: Float) -> Float = float_fma(x, y, z)

## Round toward negative infinity. Preserve infinities, NaN and both zeros.
pub fn floor(x: Float) -> Float = float_floor(x)

## Round toward positive infinity. Preserve infinities, NaN and both zeros.
pub fn ceil(x: Float) -> Float = float_ceil(x)

## Round toward zero. Preserve infinities, NaN and both zeros.
pub fn trunc(x: Float) -> Float = float_trunc(x)

## Round to the nearest integer, ties to even. Preserve infinities, NaN and
## both zeros; a negative input that rounds to zero returns -0.
pub fn round_even(x: Float) -> Float = float_round_even(x)

## Round to the nearest integer, ties away from zero. Preserve infinities,
## NaN and both zeros; a negative input that rounds to zero returns -0.
pub fn round(x: Float) -> Float = {
  let t = trunc(x)
  let d = x - t
  if d >= 0.5 { t + 1.0 } else if d <= -0.5 { t - 1.0 } else { t }
}

## Clear the sign bit, including -0 and -infinity. NaN remains NaN.
pub fn abs(x: Float) -> Float = float_of_bits(float_to_bits(x) & 0x7fffffffffffffff)

## Copy y's sign bit onto x's magnitude, including zero, infinity and NaN.
pub fn copysign(x: Float, y: Float) -> Float =
  float_of_bits((float_to_bits(x) & 0x7fffffffffffffff) | (float_to_bits(y) & (1 << 63)))

## The smaller argument, propagating NaN and choosing -0 over +0.
pub fn min(x: Float, y: Float) -> Float =
  if float.is_nan(x) { x } else if float.is_nan(y) { y }
  else if x < y || (x == y && float.sign_bit(x)) { x } else { y }

## The larger argument, propagating NaN and choosing +0 over -0.
pub fn max(x: Float, y: Float) -> Float =
  if float.is_nan(x) { x } else if float.is_nan(y) { y }
  else if x > y || (x == y && not float.sign_bit(x)) { x } else { y }

## Step from x toward y by one representable value. Equal inputs return y,
## including opposite zeros. Either NaN returns NaN; infinity can step inward.
pub fn next_after(x: Float, y: Float) -> Float =
  if float.is_nan(x) || float.is_nan(y) { float.NAN }
  else if x == y { y }
  else if x < y { float.next_up(x) } else { float.next_down(x) }

# A nonzero finite magnitude normalized to 53 significand bits and its binade.
fn normalized(x: Float) -> (Int, Int) = {
  let b = float_to_bits(x)
  var m = b & 0x000fffffffffffff
  var e = ((b >>> 52) & 2047) - 1023
  if e == -1023 {
    e = -1022
    while m < 1 << 52 {
      m = m << 1
      e = e - 1
    }
  } else { m = m | (1 << 52) }
  (m, e)
}

## Decompose finite nonzero x as m*2^e, with 0.5 <= abs(m) < 1, exactly.
## For either zero, infinity or NaN return (x, 0), preserving the zero's sign.
pub fn frexp(x: Float) -> (Float, Int) = {
  if x == 0.0 || not float.is_finite(x) { (x, 0) }
  else {
    let (m, e) = normalized(x)
    (float_of_bits((float_to_bits(x) & (1 << 63)) | (1022 << 52) | (m & 0x000fffffffffffff)), e + 1)
  }
}

## Scale x by 2^n with one nearest-even rounding, gradual underflow and signed
## zero. Overflow returns signed infinity. Zero, infinity and NaN return x.
## Every Int exponent is accepted without overflowing intermediate arithmetic.
pub fn ldexp(x: Float, n: Int) -> Float = {
  if x == 0.0 || not float.is_finite(x) { return x }
  let sign = float_to_bits(x) & (1 << 63)
  if n > 4096 { return float_of_bits(sign | 0x7ff0000000000000) }
  if n < -4096 { return float_of_bits(sign) }
  let (m, e) = normalized(x)
  let target = e + n
  if target > 1023 { return float_of_bits(sign | 0x7ff0000000000000) }
  if target >= -1022 { return float_of_bits(sign | ((target + 1023) << 52) | (m & 0x000fffffffffffff)) }
  if target < -1075 { return float_of_bits(sign) }
  let shift = -1022 - target
  var q = m >>> shift
  let rem = m & ((1 << shift) - 1)
  let half = 1 << (shift - 1)
  if rem > half || (rem == half && (q & 1) != 0) { q = q + 1 }
  float_of_bits(sign | q)
}

## The binade exponent floor(log2(abs(x))) for finite nonzero x, including
## subnormals. Zero, infinity and NaN return None.
pub fn ilogb(x: Float) -> Option[Int] = {
  if x == 0.0 || not float.is_finite(x) { None }
  else {
    let (_, e) = normalized(x)
    Some(e)
  }
}

test "constant patterns are the frozen MPFR results" {
  assert float_to_bits(PI) == 0x400921fb54442d18
  assert float_to_bits(E) == 0x4005bf0a8b145769
  assert float_to_bits(TAU) == 0x401921fb54442d18
  assert float_to_bits(LN_2) == 0x3fe62e42fefa39ef
  assert float_to_bits(LN_10) == 0x40026bb1bbb55516
  assert float_to_bits(LOG2_E) == 0x3ff71547652b82fe
  assert float_to_bits(LOG10_E) == 0x3fdbcb7b1526e50e
  assert float_to_bits(SQRT_2) == 0x3ff6a09e667f3bcd
}

test "integer rounding handles both ties adjacent halves and signed zero" {
  assert round(0.49999999999999994) == 0.0
  assert round(0.5) == 1.0
  assert round(-0.5) == -1.0
  assert round_even(0.5) == 0.0
  assert round_even(1.5) == 2.0
  assert round_even(2.5) == 2.0
  assert round_even(-1.5) == -2.0
  for f in [round, round_even, trunc, ceil] { assert float_to_bits(f(-0.25)) == 1 << 63 }
  for f in [round, round_even, trunc, ceil, floor] {
    assert float_to_bits(f(-0.0)) == 1 << 63
    assert f(float.INFINITY) == float.INFINITY
    assert f(-float.INFINITY) == -float.INFINITY
    assert float.is_nan(f(float.NAN))
  }
  assert floor(-0.25) == -1.0
  assert ceil(0.25) == 1.0
  assert trunc(-1.75) == -1.0
}

test "exact primitives retain cancellation and gradual underflow" {
  assert sqrt(4.0) == 2.0
  assert float_to_bits(sqrt(-0.0)) == 1 << 63
  assert sqrt(2.0) == SQRT_2
  assert float.is_nan(sqrt(-1.0))
  assert float.is_nan(fma(0.0, float.INFINITY, 1.0))
  assert float.is_nan(fma(float.INFINITY, 1.0, -float.INFINITY))
  assert float_to_bits(fma(float_of_bits(1), 0.5, float_of_bits(1))) == 2
  assert fma(float.MAX, 2.0, -float.MAX) == float.MAX
  assert float_to_bits(fma(1.0 + 1.0 / 134217728.0, 1.0 - 1.0 / 134217728.0, -1.0)) == ((1 << 63) | 0x3c90000000000000)
}

fn negative_half(op: fn(Float) -> Float) -> Int = float_to_bits(op(-0.5))

test "intrinsics taken as values use the same lowering as direct calls" {
  let s: fn(Float) -> Float = float_sqrt
  let f: fn(Float, Float, Float) -> Float = float_fma
  let lo: fn(Float) -> Float = float_floor
  let hi: fn(Float) -> Float = float_ceil
  let t: fn(Float) -> Float = float_trunc
  let r: fn(Float) -> Float = float_round_even
  assert s(2.0) == sqrt(2.0)
  assert float_to_bits(f(float_of_bits(1), 0.5, float_of_bits(1))) == 2
  assert lo(-1.25) == floor(-1.25)
  assert hi(-1.25) == ceil(-1.25)
  assert t(-1.25) == trunc(-1.25)
  assert r(2.5) == round_even(2.5)
  let cs = comptime {
    let op: fn(Float) -> Float = float_sqrt
    float_to_bits(op(2.0))
  }
  let cf = comptime {
    let op: fn(Float, Float, Float) -> Float = float_fma
    float_to_bits(op(float_of_bits(1), 0.5, float_of_bits(1)))
  }
  let cr = comptime {
    let ops: List[fn(Float) -> Float] = [float_floor, float_ceil, float_trunc, float_round_even]
    list.map(ops, negative_half)
  }
  assert cs == float_to_bits(s(2.0))
  assert cf == 2
  assert cr == list.map([lo, hi, t, r], negative_half)
}

test "bit functions respect nan propagation and zero ordering" {
  assert float_to_bits(abs(-0.0)) == 0
  assert abs(-float.INFINITY) == float.INFINITY
  assert float_to_bits(copysign(0.0, -1.0)) == 1 << 63
  assert copysign(-2.0, 0.0) == 2.0
  for pair in [(0.0, -0.0), (-0.0, 0.0)] {
    let (a, b) = pair
    assert float_to_bits(min(a, b)) == 1 << 63
    assert float_to_bits(max(a, b)) == 0
    assert float.is_nan(min(a, float.NAN))
    assert float.is_nan(max(float.NAN, b))
  }
  assert float_to_bits(next_after(0.0, -0.0)) == 1 << 63
  assert float_to_bits(next_after(-0.0, 0.0)) == 0
  assert next_after(float.INFINITY, 0.0) == float.MAX
  assert float.is_nan(next_after(1.0, float.NAN))
}

test "exponent operations cover every binade and extreme Int scaling" {
  for e in range(-1074, 1024) {
    let x = ldexp(1.0, e)
    assert ilogb(x) == Some(e)
    let (m, n) = frexp(x)
    assert m == 0.5
    assert n == e + 1
    assert ldexp(m, n) == x
  }
  let (max_fraction, max_exponent) = frexp(float.MAX)
  assert ldexp(max_fraction, max_exponent) == float.MAX
  assert float_to_bits(ldexp(-1.0, -1075)) == 1 << 63
  assert float_to_bits(ldexp(1.5, -1074)) == 2
  assert float_to_bits(ldexp(float_of_bits(0x001fffffffffffff), -1)) == 0x0010000000000000
  assert ldexp(1.0, 9223372036854775807) == float.INFINITY
  assert float_to_bits(ldexp(-1.0, 1 << 63)) == 1 << 63
  for x in [0.0, -0.0, float.INFINITY, -float.INFINITY] {
    assert float_to_bits(ldexp(x, 1 << 63)) == float_to_bits(x)
    let (a, n) = frexp(x)
    assert float_to_bits(a) == float_to_bits(x)
    assert n == 0
    assert ilogb(x) == None
  }
  assert ilogb(float.NAN) == None
  let (nan, n) = frexp(float.NAN)
  assert float.is_nan(nan) && n == 0
}

# fdlibm's words are explicitly 32 bits. A signed read sign-extends; an
# unsigned read/mixed expression masks. Word writes preserve the other half.
fn fd_i32(x: Int) -> Int = (x << 32) >> 32
fn fd_u32(x: Int) -> Int = x & 0xffffffff
fn fd_hi(x: Float) -> Int = float_to_bits(x) >> 32
fn fd_lo(x: Float) -> Int = fd_i32(float_to_bits(x))
fn fd_with_hi(x: Float, hi: Int) -> Float = float_of_bits((hi << 32) | (float_to_bits(x) & 0xffffffff))
fn fd_with_lo(x: Float, lo: Int) -> Float = float_of_bits((float_to_bits(x) & (0xffffffff << 32)) | (lo & 0xffffffff))

# Translated from e_exp.c, Netlib fdlibm 5.3.
const FD_E_EXP_ONE: Float = float_of_bits(0x3ff0000000000000)
const FD_E_EXP_HALF: List[Float] = [float_of_bits(0x3fe0000000000000), (-float_of_bits(0x3fe0000000000000))]
const FD_E_EXP_HUGE: Float = float_of_bits(0x7e37e43c8800759c)
const FD_E_EXP_TWOM1000: Float = float_of_bits(0x0170000000000000)
const FD_E_EXP_O_THRESHOLD: Float = float_of_bits(0x40862e42fefa39ef)
const FD_E_EXP_U_THRESHOLD: Float = (-float_of_bits(0x40874910d52d3051))
const FD_E_EXP_LN2HI: List[Float] = [float_of_bits(0x3fe62e42fee00000), (-float_of_bits(0x3fe62e42fee00000))]
const FD_E_EXP_LN2LO: List[Float] = [float_of_bits(0x3dea39ef35793c76), (-float_of_bits(0x3dea39ef35793c76))]
const FD_E_EXP_INVLN2: Float = float_of_bits(0x3ff71547652b82fe)
const FD_E_EXP_P1: Float = float_of_bits(0x3fc555555555553e)
const FD_E_EXP_P2: Float = (-float_of_bits(0x3f66c16c16bebd93))
const FD_E_EXP_P3: Float = float_of_bits(0x3f11566aaf25de2c)
const FD_E_EXP_P4: Float = (-float_of_bits(0x3ebbbd41c5d26bf1))
const FD_E_EXP_P5: Float = float_of_bits(0x3e66376972bea4d0)

## Exponential. Both zeros give 1; -infinity gives +0; +infinity and NaN propagate.
## Finite results have true error at most 1 ulp; see docs/std-math-design.md.
pub fn exp(x: Float) -> Float = {
  var x_work = x
  var y: Float = 0.0
  var hi: Float = 0.0
  var lo: Float = 0.0
  var c: Float = 0.0
  var t: Float = 0.0
  var k: Int = 0
  var xsb: Int = 0
  var hx: Int = 0
  hx = fd_u32(fd_hi(x_work))
  xsb = fd_i32(((hx >>> 31) & fd_u32(1)))
  hx = fd_u32((hx & fd_u32(0x7fffffff)))
  if (hx >= fd_u32(0x40862E42)) {
    if (hx >= fd_u32(0x7ff00000)) {
      if (((hx & fd_u32(0xfffff)) | fd_u32(fd_lo(x_work))) != fd_u32(0)) {
        return (x_work + x_work)
      } else {
        return (if (xsb == 0) { x_work } else { float_of_bits(0x0000000000000000) })
      }
    }
    if (x_work > FD_E_EXP_O_THRESHOLD) {
      return (FD_E_EXP_HUGE * FD_E_EXP_HUGE)
    }
    if (x_work < FD_E_EXP_U_THRESHOLD) {
      return (FD_E_EXP_TWOM1000 * FD_E_EXP_TWOM1000)
    }
  }
  if (hx > fd_u32(0x3fd62e42)) {
    if (hx < fd_u32(0x3FF0A2B2)) {
      hi = (x_work - FD_E_EXP_LN2HI[xsb])
      lo = FD_E_EXP_LN2LO[xsb]
      k = fd_i32((fd_i32((1 - xsb)) - xsb))
    } else {
      k = fd_i32(to_int(((FD_E_EXP_INVLN2 * x_work) + FD_E_EXP_HALF[xsb])))
      t = to_float(k)
      hi = (x_work - (t * FD_E_EXP_LN2HI[0]))
      lo = (t * FD_E_EXP_LN2LO[0])
    }
    x_work = (hi - lo)
  } else {
    if (hx < fd_u32(0x3e300000)) {
      if ((FD_E_EXP_HUGE + x_work) > FD_E_EXP_ONE) {
        return (FD_E_EXP_ONE + x_work)
      }
    } else {
      k = 0
    }
  }
  t = (x_work * x_work)
  c = (x_work - (t * (FD_E_EXP_P1 + (t * (FD_E_EXP_P2 + (t * (FD_E_EXP_P3 + (t * (FD_E_EXP_P4 + (t * FD_E_EXP_P5))))))))))
  if (k == 0) {
    return (FD_E_EXP_ONE - (((x_work * c) / (c - float_of_bits(0x4000000000000000))) - x_work))
  } else {
    y = (FD_E_EXP_ONE - ((lo - ((x_work * c) / (float_of_bits(0x4000000000000000) - c))) - hi))
  }
  if (k >= fd_i32((-1021))) {
    y = fd_with_hi(y, (fd_hi(y) + fd_i32((k << 20))))
    return y
  } else {
    y = fd_with_hi(y, (fd_hi(y) + fd_i32((fd_i32((k + 1000)) << 20))))
    return (y * FD_E_EXP_TWOM1000)
  }
  0.0
}

# Translated from s_expm1.c, Netlib fdlibm 5.3.
const FD_S_EXPM1_ONE: Float = float_of_bits(0x3ff0000000000000)
const FD_S_EXPM1_HUGE: Float = float_of_bits(0x7e37e43c8800759c)
const FD_S_EXPM1_TINY: Float = float_of_bits(0x01a56e1fc2f8f359)
const FD_S_EXPM1_O_THRESHOLD: Float = float_of_bits(0x40862e42fefa39ef)
const FD_S_EXPM1_LN2_HI: Float = float_of_bits(0x3fe62e42fee00000)
const FD_S_EXPM1_LN2_LO: Float = float_of_bits(0x3dea39ef35793c76)
const FD_S_EXPM1_INVLN2: Float = float_of_bits(0x3ff71547652b82fe)
const FD_S_EXPM1_Q1: Float = (-float_of_bits(0x3fa11111111110f4))
const FD_S_EXPM1_Q2: Float = float_of_bits(0x3f5a01a019fe5585)
const FD_S_EXPM1_Q3: Float = (-float_of_bits(0x3f14ce199eaadbb7))
const FD_S_EXPM1_Q4: Float = float_of_bits(0x3ed0cfca86e65239)
const FD_S_EXPM1_Q5: Float = (-float_of_bits(0x3e8afdb76e09c32d))

## Exponential minus one without cancellation. Preserve signed zero; -infinity gives -1, +infinity gives infinity, NaN propagates.
## Finite results have true error at most 1 ulp; see docs/std-math-design.md.
pub fn expm1(x: Float) -> Float = {
  var x_work = x
  var y: Float = 0.0
  var hi: Float = 0.0
  var lo: Float = 0.0
  var c: Float = 0.0
  var t: Float = 0.0
  var e: Float = 0.0
  var hxs: Float = 0.0
  var hfx: Float = 0.0
  var r1: Float = 0.0
  var k: Int = 0
  var xsb: Int = 0
  var hx: Int = 0
  hx = fd_u32(fd_hi(x_work))
  xsb = fd_i32((hx & 0x80000000))
  if (xsb == 0) {
    y = x_work
  } else {
    y = (-x_work)
  }
  hx = fd_u32((hx & fd_u32(0x7fffffff)))
  if (hx >= fd_u32(0x4043687A)) {
    if (hx >= fd_u32(0x40862E42)) {
      if (hx >= fd_u32(0x7ff00000)) {
        if (((hx & fd_u32(0xfffff)) | fd_u32(fd_lo(x_work))) != fd_u32(0)) {
          return (x_work + x_work)
        } else {
          return (if (xsb == 0) { x_work } else { (-float_of_bits(0x3ff0000000000000)) })
        }
      }
      if (x_work > FD_S_EXPM1_O_THRESHOLD) {
        return (FD_S_EXPM1_HUGE * FD_S_EXPM1_HUGE)
      }
    }
    if (xsb != 0) {
      if ((x_work + FD_S_EXPM1_TINY) < float_of_bits(0x0000000000000000)) {
        return (FD_S_EXPM1_TINY - FD_S_EXPM1_ONE)
      }
    }
  }
  if (hx > fd_u32(0x3fd62e42)) {
    if (hx < fd_u32(0x3FF0A2B2)) {
      if (xsb == 0) {
        hi = (x_work - FD_S_EXPM1_LN2_HI)
        lo = FD_S_EXPM1_LN2_LO
        k = 1
      } else {
        hi = (x_work + FD_S_EXPM1_LN2_HI)
        lo = (-FD_S_EXPM1_LN2_LO)
        k = fd_i32((-1))
      }
    } else {
      k = fd_i32(to_int(((FD_S_EXPM1_INVLN2 * x_work) + (if (xsb == 0) { float_of_bits(0x3fe0000000000000) } else { (-float_of_bits(0x3fe0000000000000)) }))))
      t = to_float(k)
      hi = (x_work - (t * FD_S_EXPM1_LN2_HI))
      lo = (t * FD_S_EXPM1_LN2_LO)
    }
    x_work = (hi - lo)
    c = ((hi - x_work) - lo)
  } else {
    if (hx < fd_u32(0x3c900000)) {
      t = (FD_S_EXPM1_HUGE + x_work)
      return (x_work - (t - (FD_S_EXPM1_HUGE + x_work)))
    } else {
      k = 0
    }
  }
  hfx = (float_of_bits(0x3fe0000000000000) * x_work)
  hxs = (x_work * hfx)
  r1 = (FD_S_EXPM1_ONE + (hxs * (FD_S_EXPM1_Q1 + (hxs * (FD_S_EXPM1_Q2 + (hxs * (FD_S_EXPM1_Q3 + (hxs * (FD_S_EXPM1_Q4 + (hxs * FD_S_EXPM1_Q5))))))))))
  t = (float_of_bits(0x4008000000000000) - (r1 * hfx))

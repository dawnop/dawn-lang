# Execution counts prove actual reuse; same-version cold comparison separately
# guards output assembly. Full structural comparison lives in the private oracle.
#
# A module of the compiler package because checker state is `pub(pkg)`; it
# moved here from scripts/incremental-semantics-contract/src. Nothing in
# main.dawn or nmain.dawn imports contract/, so `dawn test selfhost` runs it
# and neither driver links it.
#
# The rule under test (docs/lsp-module-memo-design.md): a step is reused when
# its input and the carry it enters with are unchanged. Until 2026-09-28 this
# file was contract/prefix and held the prefix rule that one replaced. Every test compares the session's
# Program with a cold analysis of the same input, positions included, so a
# reuse the rule does not license shows up as a difference, and asserts the
# counts, so a reuse the rule does license and the session skipped shows up
# too.

use std/io
use std/io.{Fs, Env}
use std/map
use driver/incremental
use driver/analyze.{
  LoadedModule, LoadResult, LocDiag, Program, analyze_program, rendered_diags,
  load_entries_reusing, no_parses, project_plan
}
use driver/fsmem
use std/memfs
use compiler_plan/source.{SourceFile}
use std/str
use driver/stdlib.{StdCtx, load_std, std_load_error_text}
use driver/checkdump
use check/jsig.{jsig_refused}
use ir/interp.{ct_default}
use front/parser
use check/identity
use front/lexer
use jvm/jreflect.{jsig_real}
use compiler_plan/envmem

fn source(name: String, text: String) -> LoadedModule = {
  let (m, pdiags) = parser.parse_module(text)
  LoadedModule {
    mod_path: name, class_name: name, path: name ++ ".dawn", site_path: name ++ ".dawn",
    text: text, line_starts: lexer.line_starts_of(text), m: m, pdiags: pdiags, pkg: None, entry: false
  }
}

fn std_ctx() -> StdCtx !Fs !Env !io =
  match load_std("std") {
    Ok(s) -> s
    Err(e) -> panic(std_load_error_text(e))
  }

## The session's Program is the cold one: the same modules, diagnostics,
## declaration views and rendered positions.
fn agrees_with_cold(prog: Program, input: LoadResult, std: StdCtx) -> Bool !Fs !Env !io = {
  let cold = analyze_program(input, std, ct_default(), jsig_refused())
  checkdump.render(prog) == checkdump.render(cold) && prog.diags == cold.diags &&
    prog.decl_spans == cold.decl_spans && map.keys(prog.decl_spans) == map.keys(cold.decl_spans) &&
    rendered_diags(prog) == rendered_diags(cold)
}

test "module memo reuses a step whose input and what it read are unchanged" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let a = source("a", "pub type Box = { n: Int }\npub fn make() -> Box = Box { n: 1 }\n")
    let b = source("b", "pub type Other = { n: Int }\n")
    let c = source("c", "use a.{Box}\npub fn value() -> Box = Box { n: 1 }\n")
    let d = source("d", "pub fn extra() -> Int = 4\n")
    let loaded = LoadResult { modules: [a, b, c], diags: [] }
    let fresh = incremental.new(std, ct_default(), jsig_refused(), 10)
    let first = incremental.analyze(fresh, loaded)
    assert first.stats.reused_modules == 0
    assert first.stats.checked_modules == 3
    assert first.stats.retained_modules == 3
    let warm = incremental.analyze(first.session, loaded)
    assert warm.stats.reused_modules == 3
    assert warm.stats.checked_modules == 0
    assert warm.stats.comptime_modules == 0
    let edited_c = source("c", "use a.{Box}\npub fn value() -> Box = Box { n: 2 }\n")
    let body = source("a", "pub type Box = { n: Int }\npub fn make() -> Box = Box { n: 2 }\n")
    let signature = source("a", "pub type Box = { n: Int }\npub fn make() -> Int = 2\n")
    let moved = source("a", "# moved\n\n" ++ a.text)
    let edits = [
      # the edited module alone
      LoadResult { modules: [a, b, edited_c], diags: [] },
      # c enters with a carry that no longer holds b, which it never read
      LoadResult { modules: [a, c], diags: [] },
      # every module enters with a carry it has not entered with before. c
      # finds what it reads where it found it; b and a each enter with an
      # impl table whose rows are not the ones they entered with, because
      # the baseline's rows keep the spans a carry's rows drop
      LoadResult { modules: [b, a, c], diags: [] },
      LoadResult { modules: [a, b, c, d], diags: [] },
      LoadResult { modules: [], diags: [] },
      # a body edit leaves a's exports as they were: b and c keep their steps
      LoadResult { modules: [body, b, c], diags: [] },
      # a signature edit does not, and only c imports a
      LoadResult { modules: [signature, b, c], diags: [] },
      # nor does moving every declaration of a, as far as its exports go; the
      # positions it moved are the session's to put right
      LoadResult { modules: [moved, b, c], diags: [] }
    ]
    let expected_hits = [2, 2, 1, 3, 0, 2, 1, 2]
    var i = 0
    for input in edits {
      let result = incremental.analyze(warm.session, input)
      assert result.stats.reused_modules == expected_hits[i]
      assert result.stats.checked_modules == len(input.modules) - expected_hits[i]
      assert agrees_with_cold(result.program, input, std)
      i = i + 1
    }
    # Same raw text but a different loader-rewritten AST must invalidate.
    let rewritten = LoadedModule { ..c, m: edited_c.m }
    let rewrite = incremental.analyze(warm.session, LoadResult { modules: [a, b, rewritten], diags: [] })
    assert rewrite.stats.reused_modules == 2
    assert rewrite.stats.checked_modules == 1
  }))
}

test "module memo places a reused module's diagnostics and its predecessors' where they are now" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    # both modules carry a diagnostic inside a declaration, so both are
    # rendered through the Program's view of where their declarations sit
    let lib_text = "pub fn ok() -> Int = 1\n\npub fn bad() -> Int = false\n"
    let lib = source("lib", lib_text)
    let app = source("app", "use lib\npub fn use_it() -> Int = lib.ok()\n\npub fn worse() -> Bool = 1\n")
    let loaded = LoadResult { modules: [lib, app], diags: [] }
    let warm = incremental.analyze(incremental.new(std, ct_default(), jsig_refused(), 10), loaded)
    assert len(warm.program.diags) == 2
    # lines above lib's declarations, and no change to its signatures: lib is
    # checked again, app is not, and both diagnostics land where the text now
    # puts them
    let moved = source("lib", "# three\n# more\n# lines\n" ++ lib_text)
    let input = LoadResult { modules: [moved, app], diags: [] }
    let result = incremental.analyze(warm.session, input)
    assert result.stats.reused_modules == 1
    assert result.stats.checked_modules == 1
    assert agrees_with_cold(result.program, input, std)
    let cold = analyze_program(loaded, std, ct_default(), jsig_refused())
    assert rendered_diags(result.program) != rendered_diags(cold)
  }))
}

## The one message of `prog` that comptime raised in `module`'s file.
fn comptime_message(prog: Program, file: String) -> String = {
  var found = ""
  for ld in rendered_diags(prog) {
    if ld.path == file && str.contains(ld.d.msg, "unwrapped None") { found = ld.d.msg }
  }
  found
}

test "module memo checks an unchanged file again with the line starts its reused parse holds" {
  # The line starts are the parse's: a workspace load that reuses a file's
  # parse reuses them, and a module checked again because what it imports
  # changed still says `at file:line:col` against its own, unchanged text. An
  # `expr!` in a constant is where a checker product renders a line.
  let root = memfs.BASE ++ "/line-starts"
  let main = root ++ "/src/main.dawn"
  let app = root ++ "/src/app.dawn"
  let lib = root ++ "/src/lib.dawn"
  let app_text = "use lib\n\nfn pick() -> Option[Int] = None\n\npub const C: Int = pick()!\n" ++
    "pub fn answer() -> Int = lib.value()\n"
  var files = fsmem.mem_std(memfs.BASE)
  files = memfs.put(files, main, "use app\npub fn main() -> Unit !io = println(to_string(app.answer()))\n")
  files = memfs.put(files, app, app_text)
  files = memfs.put(files, lib, "pub fn value() -> Int = 41\n")
  let _ = memfs.with_fs(files, () => io.with_proc_real(() =>
      envmem.with_env_table(memfs.BASE, [], () => {
        let std = match load_std(fsmem.mem_std_dir(memfs.BASE)) {
          Ok(s) -> s
          Err(e) -> panic(std_load_error_text(e))
        }
        let plan = project_plan(SourceFile(main))
        let none: Map[String, String] = map.empty()
        let first = load_entries_reusing(plan, [main], none, no_parses())
        let warm = incremental.analyze(incremental.new(std, ct_default(), jsig_refused(), 10), first.loaded)
        # named from the project root, not as the load spelled the file (#401)
        assert str.ends_with(comptime_message(warm.program, app), " at src/app.dawn:5:20")
        # lib's signature changes and moves down two lines; app's text does not,
        # so its parse and line starts are the first load's, and it is checked
        # again because what it imports changed. main imports app, whose
        # surface did not change, and keeps its step.
        let signature = map.insert(none, lib, "# two\n# lines\npub fn value(k: Int = 0) -> Int = 41 + k\n")
        let second = load_entries_reusing(plan, [main], signature, first.parses)
        assert second.parses.reused == 2
        let result = incremental.analyze(warm.session, second.loaded)
        assert result.stats.checked_modules == 2
        assert str.ends_with(comptime_message(result.program, app), " at src/app.dawn:5:20")
        assert agrees_with_cold(result.program, second.loaded, std)
        # and app's own text moving is a new parse with new line starts
        let moved = map.insert(signature, app, "# three\n# lines\n# down\n" ++ app_text)
        let third = load_entries_reusing(plan, [main], moved, second.parses)
        assert third.parses.reused == 2
        let again = incremental.analyze(result.session, third.loaded)
        assert str.ends_with(comptime_message(again.program, app), " at src/app.dawn:8:20")
        assert agrees_with_cold(again.program, third.loaded, std)
      })))
}

test "module memo compares what a module exports in order, not only as a set" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let lib = source("lib", "pub fn first() -> Int = 1\npub fn second() -> Int = 2\n")
    let app = source("app", "use lib\npub fn total() -> Int = lib.first() + lib.second()\n")
    let owner = incremental.new(std, ct_default(), jsig_refused(), 10)
    let warm = incremental.analyze(owner, LoadResult { modules: [lib, app], diags: [] })
    # the same two functions the other way round: equal as a set, and still a
    # different input to an importer that walks them
    let swapped = source("lib", "pub fn second() -> Int = 2\npub fn first() -> Int = 1\n")
    let input = LoadResult { modules: [swapped, app], diags: [] }
    let result = incremental.analyze(warm.session, input)
    assert result.stats.reused_modules == 0
    assert result.stats.checked_modules == 2
    assert agrees_with_cold(result.program, input, std)
    # two imports the other way round: lib declares the same things in the
    # same order, and the type tables it passes on hold them in another
    let p = source("p", "pub type P = { n: Int }\n")
    let q = source("q", "pub type Q = { n: Int }\n")
    let body = "pub fn make() -> Int = 1\n"
    let user = source("user", "use lib\npub fn made() -> Int = lib.make()\n")
    let forward = LoadResult { modules: [p, q, source("lib", "use p.{P}\nuse q.{Q}\n" ++ body), user], diags: [] }
    let backward = LoadResult { modules: [p, q, source("lib", "use q.{Q}\nuse p.{P}\n" ++ body), user], diags: [] }
    let before = incremental.analyze(owner, forward)
    let after = incremental.analyze(before.session, backward)
    assert after.stats.reused_modules == 2
    assert after.stats.checked_modules == 2
    assert agrees_with_cold(after.program, backward, std)
  }))
}

test "module memo keeps a module that does not import an edited surface and checks its importers" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let lib = source("lib", "pub fn value() -> Int = 1\n")
    let other = source("other", "pub fn alone() -> Int = 2\n")
    let user = source("user", "use lib\npub fn total() -> Int = lib.value()\n")
    let far = source("far", "use user\npub fn more() -> Int = user.total() + 1\n")
    let warm = incremental.analyze(incremental.new(std, ct_default(), jsig_refused(), 10),
      LoadResult { modules: [lib, other, user, far], diags: [] })
    assert len(warm.program.diags) == 0
    # A defaulted parameter changes lib's surface and adds a row to the intern
    # table. other never reads lib; far reads user, whose surface comes out
    # the same.
    let signature = LoadResult { modules: [source("lib", "pub fn value(k: Int = 0) -> Int = 1 + k\n"), other, user, far], diags: [] }
    let changed = incremental.analyze(warm.session, signature)
    assert changed.stats.reused_modules == 2
    assert changed.stats.checked_modules == 2
    assert agrees_with_cold(changed.program, signature, std)
    # and an edit that breaks the importer breaks only the importer
    let broken = LoadResult { modules: [source("lib", "pub fn renamed() -> Int = 1\n"), other, user, far], diags: [] }
    let result = incremental.analyze(changed.session, broken)
    assert result.stats.reused_modules == 2
    assert result.stats.checked_modules == 2
    assert len(result.program.diags) > 0
    assert agrees_with_cold(result.program, broken, std)
  }))
}

test "module memo checks an importer again when a surface changes only in what it imported" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    # d names nothing of b, yet reads b's type through a's surface, which
    # carries the tables a grafted from b
    let b = source("b", "pub type Shape = { n: Int }\npub fn shape() -> Shape = Shape { n: 1 }\n")
    let a = source("a", "use b.{Shape, shape}\npub fn make() -> Shape = shape()\n")
    let d = source("d", "use a\npub fn size() -> Int = a.make().n\n")
    let warm = incremental.analyze(incremental.new(std, ct_default(), jsig_refused(), 10),
      LoadResult { modules: [b, a, d], diags: [] })
    assert len(warm.program.diags) == 0
    let renamed = source("b", "pub type Shape = { m: Int }\npub fn shape() -> Shape = Shape { m: 1 }\n")
    let input = LoadResult { modules: [renamed, a, d], diags: [] }
    let result = incremental.analyze(warm.session, input)
    assert result.stats.reused_modules == 0
    assert result.stats.checked_modules == 3
    assert len(result.program.diags) > 0
    assert agrees_with_cold(result.program, input, std)
  }))
}

test "module memo checks a module again when the impl table changes, whatever it imports" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    # an impl is in force everywhere: q uses p's Show without importing p,
    # and r's surface, which carries p's type but not p's impls, does not
    # change when the impl goes
    let p = source("p", "pub type Tag = { n: Int }\nimpl Show[Tag] { fn show(t: Tag) -> String = \"tag\" }\n")
    let r = source("r", "use p.{Tag}\npub fn tag() -> Tag = Tag { n: 1 }\n")
    let q = source("q", "use r\npub fn shown() -> String = show(r.tag())\n")
    let warm = incremental.analyze(incremental.new(std, ct_default(), jsig_refused(), 10),
      LoadResult { modules: [p, r, q], diags: [] })
    assert len(warm.program.diags) == 0
    let input = LoadResult { modules: [source("p", "pub type Tag = { n: Int }\n"), r, q], diags: [] }
    let result = incremental.analyze(warm.session, input)
    assert result.stats.reused_modules == 0
    assert result.stats.checked_modules == 3
    assert len(result.program.diags) > 0
    assert agrees_with_cold(result.program, input, std)
  }))
}

## Whether `prog` reports a digest collision.
fn collides(prog: Program) -> Bool = {
  var found = false
  for ld in prog.diags {
    if str.contains(ld.d.msg, "collides with") { found = true }
  }
  found
}

test "module memo reports a digest collision with a module it does not import as the cold path does" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    # Two declarations whose 47-bit derived ids are equal, found by a search
    # over 2^25 x 2^26 names (docs/lsp-module-memo-design.md). The intern
    # table is read only to report this, so it is the one way to observe it.
    let left = identity.derive(identity.minted_path("p", [identity.Named(identity.FunctionDecl, "a20228599")]))
    let right = identity.derive(identity.minted_path("q", [identity.Named(identity.FunctionDecl, "b9013596")]))
    assert left == right
    let owner = incremental.new(std, ct_default(), jsig_refused(), 10)
    # A reused step's rows join the table the modules after it check against:
    # e's edit changes the table, p keeps its step, and q, checked again
    # because it imports e, still meets p's row.
    let e = source("e", "pub fn one() -> Int = 1\n")
    let p = source("p", "pub fn a20228599() -> Int = 0\n")
    let q = source("q", "use e\npub fn b9013596() -> Int = e.one()\n")
    let first = incremental.analyze(owner, LoadResult { modules: [e, p, q], diags: [] })
    assert collides(first.program)
    let grown = LoadResult { modules: [source("e", "pub fn one() -> Int = 1\npub fn two() -> Int = 2\n"), p, q], diags: [] }
    let kept = incremental.analyze(first.session, grown)
    assert kept.stats.reused_modules == 1
    assert kept.stats.checked_modules == 2
    assert collides(kept.program)
    assert agrees_with_cold(kept.program, grown, std)
    # A collision that appears upstream reaches a module that imports nothing:
    # q's step would be reused by what it reads, and its rows are taken.
    let lone = source("q", "pub fn b9013596() -> Int = 1\n")
    let clean = LoadResult { modules: [source("p", "pub fn one() -> Int = 1\n"), lone], diags: [] }
    let before = incremental.analyze(owner, clean)
    assert len(before.program.diags) == 0
    let clash = LoadResult { modules: [source("p", "pub fn one() -> Int = 1\npub fn a20228599() -> Int = 0\n"), lone], diags: [] }
    let appeared = incremental.analyze(before.session, clash)
    assert appeared.stats.checked_modules == 2
    assert collides(appeared.program)
    assert agrees_with_cold(appeared.program, clash, std)
    # and one that goes away upstream leaves it: q reported it, so q is
    # checked again rather than trusted
    let gone = incremental.analyze(appeared.session, clean)
    assert gone.stats.checked_modules == 2
    assert len(gone.program.diags) == 0
    assert agrees_with_cold(gone.program, clean, std)
  }))
}

test "module memo keeps an importer's step across an edit above a pub alias" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let text = "pub alias Pair = (Int, Int)\npub opaque type Meters = Int\n" ++
      "pub fn two() -> Pair = (1, 2)\npub fn meters(n: Int) -> Meters = n\n"
    let lib = source("lib", text)
    let app = source("app", "use lib.{Pair, Meters, two, meters}\npub fn get() -> Pair = two()\n" ++
        "pub fn far() -> Meters = meters(3)\n")
    let warm = incremental.analyze(incremental.new(std, ct_default(), jsig_refused(), 10),
      LoadResult { modules: [lib, app], diags: [] })
    assert len(warm.program.diags) == 0
    let input = LoadResult { modules: [source("lib", "# moved\n" ++ text), app], diags: [] }
    let result = incremental.analyze(warm.session, input)
    assert result.stats.reused_modules == 1
    assert result.stats.checked_modules == 1
    assert agrees_with_cold(result.program, input, std)
  }))
}

test "module memo keeps an importer's step across an edit above an impl or a derive" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let text = "pub trait Sizey[T] { fn sizey(x: T) -> Int }\n" ++
      "pub type Box = { n: Int } derive Show\n" ++
      "impl Sizey[Box] { fn sizey(b: Box) -> Int = b.n + 2 }\n"
    let lib = source("lib", text)
    let app = source("app", "use lib.{Box, sizey}\npub fn size() -> Int = sizey(Box { n: 1 })\n" ++
        "pub fn same() -> Bool = Box { n: 1 } == Box { n: 2 }\n")
    let warm = incremental.analyze(incremental.new(std, ct_default(), jsig_refused(), 10),
      LoadResult { modules: [lib, app], diags: [] })
    assert len(warm.program.diags) == 0
    for moved in ["# moved\n" ++ text,
      "pub trait Sizey[T] { fn sizey(x: T) -> Int }\n# between\n" ++
        "pub type Box = { n: Int } derive Show\n# and again\n" ++
        "impl Sizey[Box] { fn sizey(b: Box) -> Int = b.n + 2 }\n"] {
      let input = LoadResult { modules: [source("lib", moved), app], diags: [] }
      let result = incremental.analyze(warm.session, input)
      assert result.stats.reused_modules == 1
      assert result.stats.checked_modules == 1
      assert agrees_with_cold(result.program, input, std)
    }
  }))
}

test "module memo reuses modules with diagnostics and bounds what it keeps" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let a = source("a", "pub fn answer() -> Int = 42\n")
    let b = source("b", "pub fn other() -> Int = 1\n")
    let loaded = LoadResult { modules: [a, b], diags: [] }
    let fresh = incremental.new(std, ct_default(), jsig_refused(), 10)
    let warm = incremental.analyze(fresh, loaded)
    # a loader diagnostic is not an input of any step
    let broken = source("broken", "pub fn (\n")
    let loader = LocDiag { path: "loader", d: broken.pdiags[0] }
    let failed_input = LoadResult { modules: [a, b], diags: [loader] }
    let failed = incremental.analyze(warm.session, failed_input)
    assert failed.stats.reused_modules == 2
    assert failed.program.diags[0] == loader
    assert agrees_with_cold(failed.program, failed_input, std)
    # nor is a module's own diagnostic a reason to check it again
    let bad = source("bad", "pub fn bad() -> Int = false\n")
    let input = LoadResult { modules: [a, bad, b, broken], diags: [] }
    let recovered = incremental.analyze(warm.session, input)
    # a and b: b now follows a module it does not import
    assert recovered.stats.reused_modules == 2
    assert recovered.stats.retained_modules == 4
    let again = incremental.analyze(recovered.session, input)
    assert again.stats.reused_modules == 4
    assert again.stats.checked_modules == 0
    assert agrees_with_cold(again.program, input, std)
    let evicted = incremental.analyze(incremental.evict(warm.session), loaded)
    assert evicted.stats.reused_modules == 0
    assert evicted.stats.checked_modules == 2
    let disabled = incremental.disable_reuse(warm.session)
    let cold_owner = incremental.analyze(disabled, loaded)
    assert cold_owner.stats.reused_modules == 0
    assert cold_owner.stats.retained_modules == 0
    assert incremental.analyze(cold_owner.session, loaded).stats.reused_modules == 0
    let bounded = incremental.new(std, ct_default(), jsig_refused(), 1)
    let one = incremental.analyze(bounded, loaded)
    assert one.stats.retained_modules == 1
    assert incremental.analyze(one.session, loaded).stats.reused_modules == 1
    let none = incremental.new(std, ct_default(), jsig_refused(), 0)
    assert incremental.analyze(none, loaded).stats.retained_modules == 0
  }))
}

test "module memo reuses modules that asked the Java oracle" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let pure = source("pure", "pub fn answer() -> Int = 42\n")
    let producer = source("producer",
      "use java \"java.util.ArrayList\"\npub fn items() -> ArrayList !io = ArrayList.new()\n")
    let consumer = source("consumer",
      "use producer\npub fn count() -> Int !io = producer.items().size()\n")
    let loaded = LoadResult { modules: [pure, producer, consumer], diags: [] }
    # the oracle is the owner's for its whole life: a host rebuilds the owner
    # whenever it replaces the lease the oracle answers from
    let js = jsig_real()
    let first = incremental.analyze(incremental.new(std, ct_default(), js, 10), loaded)
    assert len(first.program.diags) == 0
    assert first.stats.retained_modules == 3
    let warm = incremental.analyze(first.session, loaded)
    assert len(warm.program.diags) == 0
    assert warm.stats.reused_modules == 3
    assert warm.stats.checked_modules == 0
    assert checkdump.render(warm.program) == checkdump.render(analyze_program(loaded, std, ct_default(), js))
  }))
}

test "module memo rechecks std identity and refuses a negative bound" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let raw = source("pretend", "pub fn answer() -> Int = 42\n")
    let input = LoadResult { modules: [LoadedModule { ..raw, path: "std/list.dawn" }], diags: [] }
    let owner = incremental.new(std, ct_default(), jsig_refused(), 10)
    let first = incremental.analyze(owner, input)
    assert len(first.program.diags) == 0
    assert first.stats.retained_modules == 1
    assert first.program.modules[0].class_name == "std/list"
    let (changed, _) = envmem.with_env_table("/different-cwd", [],
      () => incremental.analyze(first.session, input))
    assert changed.stats.reused_modules == 0
    assert changed.stats.checked_modules == 1
    assert changed.program.modules[0].class_name == "pretend"
    let result = catch_panic(() => {
      let _ = incremental.new(std, ct_default(), jsig_refused(), -1)
      ()
    })
    match result {
      Err(_) -> ()
      Ok(_) -> { assert false }
    }
  }))
}

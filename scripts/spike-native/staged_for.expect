  carry m
  carry l
  carry acc
  carry bias
for %i < 4 {
  yield %acc <- (%acc+(%i+scale))
  note shadow
  yield %l <- (%l+%m)
  yield %m <- (%m+%bias)
}
after %m %l %acc %bias
  carry s
for %i < 2 {
  carry t
for %i < 3 {
  yield %s <- (%s+%i)
  yield %t <- (%t+%i)
}
  host a
  host b
  yield %s <- (%s+%t)
}
  carry u0
for %i < 1 {
  yield %u0 <- (%u0+%i)
}
round 0: %u0
  carry u1
for %i < 1 {
  yield %u1 <- (%u1+%i)
}
round 1: %u1
after %s
fib 55 after 10 steps
for %i < 2 {
  each %i
}
both 75

# Trait applications carry finite static support independently of calling rows.
# This walk is also used while checking default bodies, where a rigid subject
# and an unreduced Item must retain their declared upper bounds.
use std/map
use std/list
use check/capture
use check/data_capture
use check/scope_infer
use check/capture.{TraitApplication}
use check/types.{MethodSig, ImplI, Ty, TyVar, TyAdt, TyOpaque, Adts, TraitI, Eff,
  subst, subst_scopes, subst_capture_eff, type_args_of, ty_equal }

pub fn support(adts: Adts, params: capture.Params, value: Ty) -> Option[capture.Capture] =
  data_capture.support_bound(adts, params, value)

pub fn substitutions(tr: TraitI, app: TraitApplication) -> Map[Int, capture.Capture] = {
  var cm: Map[Int, capture.Capture] = map.empty()
  for i in 0..len(tr.scope_params.captures) {
    if i < len(app.args) { cm = map.insert(cm, tr.scope_params.captures[i].id, app.args[i]) }
  }
  cm
}

pub fn member_upper(tr: TraitI, app: TraitApplication, name: String) -> capture.Capture = {
  for entry in tr.assoc_bounds { let (member, upper) = entry
    if member == name { return capture.subst(upper, map.empty(), substitutions(tr, app)) } }
  []
}

pub fn subject_upper(tr: TraitI, app: TraitApplication) -> Option[capture.Capture] = {
  let id = match tr.tvar { TyVar(_, vid) -> vid, _ -> -1 }
  for entry in tr.scope_params.bounds { let (vid, upper) = entry
    if vid == id { return Some(capture.subst(upper, map.empty(), substitutions(tr, app))) } }
  None
}

pub fn type_in(tr: TraitI, app: TraitApplication, value: Ty) -> Ty =
  subst_scopes(value, map.empty(), substitutions(tr, app))

pub fn row_in(tr: TraitI, app: TraitApplication, row: Eff) -> Eff =
  # Trait parameters are Capture-kind, so their substitution updates the
  # application on a projected row without inventing a Scope from a set.
  subst_capture_eff(row, map.empty(), substitutions(tr, app))

pub fn application(tr: TraitI) -> TraitApplication = TraitApplication {
  id = tr.id, args = map(tr.scope_params.captures, c => [capture.CaptureVar(c.name, c.id)]) }

pub fn applied(tr: TraitI, app: TraitApplication) -> TraitI = {
  let cm = substitutions(tr, app)
  if len(cm) == 0 { return tr }
  TraitI { ..tr,
    assoc_bounds = map(tr.assoc_bounds, b => { let (name, upper) = b
      (name, capture.subst(upper, map.empty(), cm)) }),
    methods = map(tr.methods, entry => { let (name, method) = entry
      (name, MethodSig { ..method, sig = scope_infer.contract(method.sig, map.empty(), cm) }) }) }
}

## Validate the static application before constructing a witness. Capture
## arguments are equations here, not covariant upper bounds. Only a singleton
## Scope equation identifies a runtime key; a set never chooses one member.
fn invariant_arguments(expected: TraitApplication, app: TraitApplication) -> Bool =
  capture.trait_equal(expected, app)

pub fn witness_equations(imp: ImplI, app: TraitApplication, subject: Ty) -> (Map[Int, capture.Scope], Map[Int, capture.Capture], Bool) = {
  if len(imp.scope_params.scopes) == 0 && len(imp.scope_params.captures) == 0 {
    return (map.empty(), map.empty(), invariant_arguments(TraitApplication { id = imp.trait_id,
      args = imp.trait_args }, app))
  }
  let (initial, fits) = scope_infer.infer(imp.subject, subject, imp.scope_params.scopes, map.empty())
  var sm = initial
  var cm = subject_captures(imp.subject, subject, imp.scope_params.captures, map.empty())
  var ok = fits && len(imp.trait_args) == len(app.args)
  for i in 0..len(imp.trait_args) {
    if i >= len(app.args) { continue }
    let formal = capture.normalize(imp.trait_args[i])
    let actual = capture.normalize(app.args[i])
    if len(formal) != 1 { continue }
    match formal[0] {
      capture.CaptureVar(_, id) -> if list.any(imp.scope_params.captures, c => c.id == id) {
        match map.get(cm, id) {
          Some(prior) -> { ok = ok && capture.equal(prior, actual) }
          None -> { cm = map.insert(cm, id, actual) }
        }
      }
      capture.Region(region) -> if list.any(imp.scope_params.scopes, s => s.id == region.id) {
        if len(actual) == 1 { match actual[0] {
          capture.Region(value) -> match map.get(sm, region.id) {
            Some(prior) -> { ok = ok && capture.same_scope(scope_infer.resolve(prior, sm), value) }
            None -> { sm = map.insert(sm, region.id, value) }
          }
          _ -> { ok = false }
        } } else { ok = false }
      }
    }
  }
  sm = scope_infer.normalized(sm)
  let expected = capture.trait_subst(TraitApplication { id = app.id, args = imp.trait_args }, sm, cm)
  ok = ok && invariant_arguments(expected, app)
  (sm, cm, ok)
}

# Only equations determined by the subject can select a fixed application.
# An unresolved impl binder remains unresolved; a capture set never supplies
# an arbitrary Scope identity or a partition across independent parameters.
pub fn subject_application(imp: ImplI, subject: Ty) -> Option[TraitApplication] = {
  let (sm, fits) = scope_infer.infer(imp.subject, subject, imp.scope_params.scopes, map.empty())
  if not fits { return None }
  let cm = subject_captures(imp.subject, subject, imp.scope_params.captures, map.empty())
  for region in imp.scope_params.scopes {
    if scope_infer.resolve(region, sm).id == region.id { return None }
  }
  for param in imp.scope_params.captures { if not map.has(cm, param.id) { return None } }
  Some(capture.trait_subst(TraitApplication { id = imp.trait_id, args = imp.trait_args }, sm, cm))
}

pub fn witness_arguments(imp: ImplI, app: TraitApplication, subject: Ty,
  adts: Adts, params: capture.Params) -> (Map[Int, capture.Scope], Map[Int, capture.Capture], Bool) = {
  let (sm, cm, equations_ok) = witness_equations(imp, app, subject)
  var ok = equations_ok
  var tm: Map[Int, Ty] = map.empty()
  let args = type_args_of(subject)
  for i in 0..len(imp.tparams) {
    if i < len(args) { match imp.tparams[i] {
      TyVar(_, id) -> { tm = map.insert(tm, id, args[i]) }
      _ -> ()
    } }
  }
  let em: Map[Int, Eff] = map.empty()
  ok = ok && ty_equal(subst_scopes(subst(imp.subject, tm, em), sm, cm), subject)
  for entry in imp.scope_params.bounds { let (id, upper) = entry
    match map.get(tm, id) {
      Some(value) -> { ok = ok && data_capture.permits(adts, params, value, capture.subst(upper, sm, cm)) }
      None -> ()
    }
  }
  for param in imp.scope_params.captures { match param.bound {
    Some(upper) -> match map.get(cm, param.id) {
      Some(value) -> { ok = ok && capture.subset_in(value, capture.subst(upper, sm, cm), params.captures) }
      None -> ()
    }
    None -> ()
  } }
  (sm, cm, ok)
}

fn argument_captures(formals: List[capture.Capture], actuals: List[capture.Capture],
  flex: List[capture.CaptureParam], initial: Map[Int, capture.Capture]) -> Map[Int, capture.Capture] = {
  var cm = initial
  for i in 0..len(formals) { if i < len(actuals) && len(formals[i]) == 1 {
    cm = scope_infer.infer_upper(formals[i], actuals[i], flex, cm)
  } }
  cm
}

fn subject_captures(formal: Ty, actual: Ty, flex: List[capture.CaptureParam],
  initial: Map[Int, capture.Capture]) -> Map[Int, capture.Capture] = {
  var cm = initial
  match (formal, actual) {
    (TyAdt(_, _, declared), TyAdt(_, _, provided)) |
      (TyOpaque(_, _, _, _, _, declared, _), TyOpaque(_, _, _, _, _, provided, _)) -> {
      cm = argument_captures(declared.captures, provided.captures, flex, cm)
    }
    _ -> ()
  }
  let declared = type_args_of(formal)
  let provided = type_args_of(actual)
  for i in 0..len(declared) { if i < len(provided) {
    cm = subject_captures(declared[i], provided[i], flex, cm)
  } }
  cm
}

## Member types and rows must use the exact equations which selected the
## witness. In particular, an impl's bound Scope is not the caller's Scope.
pub fn instantiate(imp: ImplI, app: TraitApplication, subject: Ty) -> ImplI = {
  let scoped = instantiate_scopes(imp, app, subject)
  var tm: Map[Int, Ty] = map.empty()
  let args = type_args_of(subject)
  for i in 0..len(imp.tparams) { if i < len(args) { match imp.tparams[i] {
    TyVar(_, id) -> { tm = map.insert(tm, id, args[i]) }
    _ -> ()
  } } }
  let em: Map[Int, Eff] = map.empty()
  let types = tm
  ImplI { ..scoped, subject = subject,
    assoc_bindings = map(scoped.assoc_bindings, entry => { let (name, value) = entry
      (name, subst(value, types, em)) }) }
}

## The erased callee ABI keeps ordinary Type variables. Scope and Capture
## identities still have to agree with the caller's checked application.
pub fn instantiate_scopes(imp: ImplI, app: TraitApplication, subject: Ty) -> ImplI = {
  if len(imp.scope_params.scopes) == 0 && len(imp.scope_params.captures) == 0 { return imp }
  let (sm, cm, _) = witness_equations(imp, app, subject)
  ImplI { ..imp, trait_args = app.args,
    assoc_bindings = map(imp.assoc_bindings, entry => { let (name, value) = entry
      (name, subst_scopes(value, sm, cm)) }),
    eff_bindings = map(imp.eff_bindings, entry => { let (name, row) = entry
      (name, subst_capture_eff(row, sm, cm)) }),
    constraints = map(imp.constraints, bs => map(bs, b => capture.trait_subst(b, sm, cm))) }
}

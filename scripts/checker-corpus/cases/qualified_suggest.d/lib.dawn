# helper module for the qualified-suggestion case
pub type Shade = Light | Dark

pub fn zero(x: Int, pad: Int = 0) -> Int = x * pad

pub const LIMIT: Int = 3

pub fn apply_to(f: fn(Int) -> Int !e) -> Int !e = f(1)

pub fn pick[T](x: T, y: T) -> T = x

pub fn each_of[T](xs: List[T], f: fn(T) -> Unit !e) -> Unit !e = {
  for x in xs { f(x) }
}

pub fn use_it[T](k: fn(Int) -> T !e) -> T !e = k(1)

pub fn made[T](n: Int) -> List[T] = []

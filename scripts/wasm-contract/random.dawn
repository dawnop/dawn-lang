# The Random effect on both targets: the bytes differ run to run, so the
# program prints only what must agree (lengths and that two draws differ).
# On wasm this goes through getentropy and the host's random_get.
use std/io.{with_random_real, random_bytes}

pub fn main() -> Unit !io = {
  with_random_real(() => {
    let a = random_bytes(16)
    let b = random_bytes(16)
    println("len16 ${to_string(len(a))}")
    println("distinct ${to_string(a != b)}")
    println("len0 ${to_string(len(random_bytes(0)))}")
    println("len1000 ${to_string(len(random_bytes(1000)))}")
  })
}

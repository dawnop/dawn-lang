# expect: expected an effect name (io, an effect variable, or a declared effect), found `)`
# The companion of the `!()` acceptance: `!(` immediately followed by `)` is
# the empty row, and nothing else about the group moved. A union that got as
# far as `|` still owes an atom, and says so where the atom should have been.
fn f() -> Int !(io | ) = 1

# A cyclic upper bound is not evidence that a private dictionary is empty.
trait Other[T: ^{d}, ^d] { fn other_capture(value: T) -> Int }
trait Parent[T: ^{c}, ^c] { fn parent_capture(value: T) -> Int }
type Box[T] = { value: T }
impl[T: Other[d] + ^{c}, ^c, ^d: ^{d}] Parent[Box[T], c] {
  fn parent_capture(value: Box[T]) -> Int = 0
}
pub fn main() -> Unit = ()

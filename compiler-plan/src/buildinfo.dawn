# The build manifest: which packages, at which versions and with which source,
# a project's build is made of (docs/build-info-design.md).
#
# Since #401 the positions baked into a product name a package by its real
# name only, so the product no longer says which checkout or which archive a
# package came from. One name is one copy program-wide (MVS plus the linker's
# names table), so the name is unambiguous inside one product; what was
# missing is a side table from the name to a version and a content digest.
# This module computes that table from a `SourcePlan`.
#
# The digest is computed here, on demand, and not in `source_plan`: planning
# runs on every compile and every LSP project rebuild, and the digest reads the
# whole tree. Nothing written here may depend on where a tree sits: entries are
# named `<real name>/<package path>`, rows are sorted, and no path, cache root
# or url appears, so the table is a function of sources and manifests alone.
# That is what lets the next cut write it into a jar without breaking B==C.

use std/io
use std/io.{Fs, Proc, Env}
use std/str
use std/map
use std/bytes
use std/memfs
use sha2/sha256
use sha2/sha256.{Digest}
use fspath/fspath
use manifestv.{SemV, semv_show, mcoord_show, validate}
use source
use source.{SourcePlan, PkgR, FromPath, FromUrl, ProjectDirectory, SourceFile}
use pkgfetch

## The version a package without a declared one reports (Go's word for it).
pub const DEVEL: String = "(devel)"

## The name the root reports when it has no dawn.toml to take one from. The
## parentheses keep it apart from every real package name.
pub const UNNAMED: String = "(unnamed)"

## One line of the manifest. `version` is already shown: a semver or `DEVEL`.
pub type BuildRow =
  | MainRow(name: String, version: String, digest: String)
  | PathDepRow(name: String, version: String, digest: String)
  | UrlDepRow(name: String, version: String, digest: String, hash: String, subdir: String)
  | JavaRow(coord: String)

fn show_version(v: Option[SemV]) -> String =
  match v {
    Some(s) -> semv_show(s)
    None -> DEVEL
  }

fn zero_byte() -> Bytes = bytes.utf8(str.from_char('\u{0000}'))

## One entry of a source digest, framed as `d1` frames a file.
fn frame(digest: Digest, entry: String, content: Bytes) -> Digest = {
  var d = sha256.update(digest, bytes.utf8(entry))
  d = sha256.update(d, zero_byte())
  d = sha256.update(d, bytes.utf8(to_string(bytes.len(content))))
  d = sha256.update(d, zero_byte())
  sha256.update(d, content)
}

## The `s1:` source digest of one package: its `manifest` (when present) and
## every regular file under `src_root`, each named `<name>/dawn.toml` or
## `<name>/src/<relative path>`, sorted by that name and framed as `d1` frames
## a file (`name \0 size \0 bytes`). The directory the package sits in appears
## in no name, so one tree in two places has one digest.
pub fn source_digest(name: String, manifest: String, src_root: String) -> Result[String, String] !Fs = {
  var entries: List[(String, String)] = []
  if io.is_symlink(manifest) {
    return Err("symbolic link in package tree: dawn.toml\n" ++
        "  the source digest refuses symlinks, as the d1 hash does")
  }
  if io.exists(manifest) { entries = entries ++ [(name ++ "/dawn.toml", manifest)] }
  let files = match pkgfetch.collect_files(src_root, "") {
    Ok(fs) -> sort(fs)
    Err(e) -> return Err(e)
  }
  # `dawn.toml` sorts before every `src/...`, and one prefix keeps the order
  # of the sorted relative paths, so the list is already in name order.
  for rel in files { entries = entries ++ [(name ++ "/src/" ++ rel, src_root ++ "/" ++ rel)] }
  var digest = sha256.new()
  for (entry, path) in entries {
    let content = match io.read_bytes(path) {
      Ok(b) -> b
      Err(e) -> return Err("cannot read " ++ path ++ ": " ++ e.message)
    }
    digest = frame(digest, entry, content)
  }
  Ok("s1:" ++ sha256.finish(digest))
}

## The `s1:` digest of sources already in hand rather than on disk: each
## `(entry name, text)` framed as `source_digest` frames a file, in name order.
## A single-file build has no package tree to walk, only the files its load
## read, and this is how its main row names them (see `file_rows`).
pub fn texts_digest(entries: List[(String, String)]) -> String = {
  var digest = sha256.new()
  for (entry, text) in sort(entries) { digest = frame(digest, entry, bytes.utf8(text)) }
  "s1:" ++ sha256.finish(digest)
}

## Every package in the plan's graph, transitively, keyed by real name. The
## linker already refused a name owned by two directories, so the first copy
## met is the only one.
fn collect_pkgs(pkg: PkgR, acc0: Map[String, PkgR]) -> Map[String, PkgR] = {
  if map.has(acc0, pkg.name) { return acc0 }
  var acc = map.insert(acc0, pkg.name, pkg)
  for key in map.keys(pkg.deps) {
    acc = collect_pkgs(map.get(pkg.deps, key).expect("resolved package"), acc)
  }
  acc
}

fn dep_row(pkg: PkgR) -> Result[BuildRow, String] !Fs = {
  let dir = fspath.parent(pkg.root).unwrap_or(pkg.root)
  let digest = match source_digest(pkg.name, dir ++ "/dawn.toml", pkg.root) {
    Ok(d) -> d
    Err(e) -> return Err("package `" ++ pkg.name ++ "`: " ++ e)
  }
  let version = show_version(pkg.version)
  Ok(match pkg.origin {
    FromPath -> PathDepRow(pkg.name, version, digest)
    FromUrl(hash, subdir) -> UrlDepRow(pkg.name, version, digest, hash, subdir)
  })
}

## The manifest of a project plan: the root, then every source package by
## real name, then every Java coordinate. Only a clean project plan has one;
## a plan with diagnostics did not decide which packages it is made of.
pub fn build_rows(plan: SourcePlan) -> Result[List[BuildRow], String] !Fs = {
  match plan.target {
    SourceFile(_) -> return Err("a build manifest needs a project directory, not a source file")
    ProjectDirectory(_) -> ()
  }
  if len(plan.diags) > 0 { return Err("cannot list a build manifest for a plan with diagnostics") }
  if not io.is_dir(plan.source_root) {
    return Err("project " ++ plan.project ++ " has no src/ folder (expected " ++
        plan.source_root ++ ")")
  }
  let manifest = plan.project ++ "/dawn.toml"
  let (name, version) = match io.read_file(manifest) {
    Err(_) -> (UNNAMED, DEVEL)
    Ok(text) ->
      match validate(plan.project, text) {
        Ok(m) -> (m.name, show_version(m.version))
        Err(_) -> return Err("cannot read the manifest " ++ manifest)
      }
  }
  let main_digest = match source_digest(name, manifest, plan.source_root) {
    Ok(d) -> d
    Err(e) -> return Err(e)
  }
  match dep_rows(plan) {
    Ok(rest) -> Ok([MainRow(name, version, main_digest)] ++ rest)
    Err(e) -> Err(e)
  }
}

## Every row after `main`: the source packages of the plan by real name, then
## the Java coordinates.
fn dep_rows(plan: SourcePlan) -> Result[List[BuildRow], String] !Fs = {
  var rows: List[BuildRow] = []
  var all: Map[String, PkgR] = map.empty()
  for key in map.keys(plan.pkgs) {
    all = collect_pkgs(map.get(plan.pkgs, key).expect("resolved package"), all)
  }
  for dep_name in sort(map.keys(all)) {
    match dep_row(map.get(all, dep_name).expect("collected package")) {
      Ok(r) -> { rows = rows ++ [r] }
      Err(e) -> return Err(e)
    }
  }
  var coords: List[String] = []
  for c in plan.java_coords { coords = coords ++ [mcoord_show(c)] }
  for c in sort(coords) { rows = rows ++ [JavaRow(c)] }
  Ok(rows)
}

## The manifest of a single-file build. A file is not a package: it has no
## dawn.toml to take a name or a version from, and its sources are not a
## `src/` tree but the files its load actually read, which `loaded` lists as
## `(position path, text)` pairs (the `site_path` of each module of the root,
## so already free of the working directory). The main row is `(unnamed)`,
## `(devel)` and the digest of exactly those texts, each named
## `(unnamed)/<position path>`; the packages and Java coordinates are the
## plan's, since a file inside a project links that project's `[deps]`.
pub fn file_rows(plan: SourcePlan, loaded: List[(String, String)]) -> Result[List[BuildRow], String] !Fs = {
  if len(plan.diags) > 0 { return Err("cannot list a build manifest for a plan with diagnostics") }
  var entries: List[(String, String)] = []
  for (site, text) in loaded { entries = entries ++ [(UNNAMED ++ "/" ++ site, text)] }
  match dep_rows(plan) {
    Ok(rest) -> Ok([MainRow(UNNAMED, DEVEL, texts_digest(entries))] ++ rest)
    Err(e) -> Err(e)
  }
}

## One row as `go version -m` lays one out: a tab, then tab-separated fields.
pub fn render_row(r: BuildRow) -> String =
  "\t" ++ join(
    match r {
      MainRow(n, v, d) -> ["main", n, v, d]
      PathDepRow(n, v, d) -> ["dep", n, v, d]
      UrlDepRow(n, v, d, h, sub) ->
        if sub == "" { ["dep", n, v, d, h] } else { ["dep", n, v, d, h, "subdir=" ++ sub] }
      JavaRow(c) -> ["java", c]
    },
    "\t"
  )

## The rows, one line each, each ending in a newline: the part of a build
## manifest that says what was built, and the bytes `manifest_digest` covers.
pub fn rows_text(rows: List[BuildRow]) -> String = {
  var out = ""
  for r in rows { out = out ++ render_row(r) ++ "\n" }
  out
}

## The `b1:` digest of a manifest: SHA-256 over its rows text. Every row is a
## function of sources and manifests (no path, no time, no builder), so this
## is too, and one value names "a build of exactly these sources". It is what
## `dawn --version` prints for the toolchain itself, cut to `short_digest`.
pub fn manifest_digest(rows: String) -> String = "b1:" ++ sha256.hex(bytes.utf8(rows))

## The length `--version` and the Playground show: twelve hex digits, git's
## habit for a short commit name, after the `b1:` tag.
pub fn short_digest(digest: String) -> String = str.take(digest, 3 + 12)

## What `dawn version -m` prints for one target: a header line, the rows, and
## a closing `build` row with the manifest digest, so a toolchain's
## `--version` can be matched against the listing of its jar or its sources.
pub fn render_listing(header: String, rows: String) -> String =
  header ++ "\n" ++ rows ++ "\tbuild\t" ++ manifest_digest(rows) ++ "\n"

## `render_listing` over rows not yet rendered.
pub fn render(header: String, rows: List[BuildRow]) -> String = render_listing(header, rows_text(rows))

## The first line of every build-info file a product carries. A reader that
## does not know the number refuses the file rather than guess at its rows
## (package-design: every file states its schema on its first line).
pub const SCHEMA: String = "dawn-build-info 1"

## The file a `dawn build` product carries (docs/build-info-design.md): the
## schema line, the toolchain line, then the rows. The toolchain line holds the
## builder's VERSION and nothing else; why not the builder's own digest is
## the design document's 4.4.
pub fn render_file(version: String, rows: List[BuildRow]) -> String =
  SCHEMA ++ "\n" ++ "toolchain\tdawn " ++ version ++ "\n" ++ rows_text(rows)

## What a product links, as far as its manifest goes. A jar runs on a
## classpath that holds the `[java-deps]` jars, so its manifest lists their
## coordinates. A product of the C backend, a native binary or a wasm module,
## links no Java at all: that backend refuses `use java` outright, so the
## coordinates name nothing the product contains and its manifest leaves the
## `java` rows out (#431). The source rows are the same for both, so one
## program built both ways still lists the same packages.
pub type Product =
  | JarProduct
  | CProduct

## The rows a product of kind `product` carries, out of a plan's rows.
pub fn product_rows(product: Product, rows: List[BuildRow]) -> List[BuildRow] =
  match product {
    JarProduct -> rows
    CProduct -> {
      var kept: List[BuildRow] = []
      for r in rows {
        match r {
          JavaRow(_) -> ()
          _ -> { kept = kept ++ [r] }
        }
      }
      kept
    }
  }

## The build-info file a product of `target` carries: a project directory's
## rows are `build_rows` of its plan, the same rows `dawn version -m <dir>`
## prints; a single file's are `file_rows` over `root_files`, the texts its
## load read; either way cut to what a `product` links (`product_rows`).
## Re-planned rather than threaded out of the load, because planning is cheap
## and the plan is a function of the same files the load just read. One
## function for every product (a jar, a native binary, a wasm module) and both
## drivers, so that one program built two ways says the same thing about the
## sources it is made of.
pub fn product_file(
  version: String,
  product: Product,
  target: String,
  root_files: List[(String, String)]
) -> Result[String, String] !Fs !Proc !Env = {
  let rows = if io.is_dir(target) {
    build_rows(source.source_plan(ProjectDirectory(target)))
  } else {
    file_rows(source.source_plan(SourceFile(target)), root_files)
  }
  match rows {
    Ok(rs) -> Ok(render_file(version, product_rows(product, rs)))
    Err(e) -> Err("cannot write the build manifest: " ++ e)
  }
}

## A build-info file read back: the VERSION of the toolchain that wrote it and
## its rows text, byte for byte as written.
pub type BuildFile = { version: String, rows: String }

## Read a build-info file. The rows are checked for shape (a tab first, a
## newline last) and otherwise kept as written, so a listing of a product
## shows what the product says even when this toolchain would compute it
## differently.
pub fn parse_file(text: String) -> Result[BuildFile, String] = {
  let lines = str.split(text, "\n")
  if len(lines) < 2 || lines[0] != SCHEMA {
    return Err("not a dawn build manifest (expected a first line `" ++ SCHEMA ++ "`, got `" ++
        str.take(lines[0], 40) ++ "`)")
  }
  let version = match str.strip_prefix(lines[1], "toolchain\tdawn ") {
    Some(v) -> v
    None -> return Err("malformed build manifest: the second line is not `toolchain<TAB>dawn <version>`")
  }
  if version == "" || not str.ends_with(text, "\n") {
    return Err("malformed build manifest: it does not end in a newline")
  }
  # `text` ends in a newline, so the last piece of the split is the empty one
  # after it; every piece between the toolchain line and that is a row
  var rows = ""
  var i = 2
  while i < len(lines) - 1 {
    let line = lines[i]
    if not str.starts_with(line, "\t") {
      return Err("malformed build manifest: a row does not start with a tab: `" ++
          str.take(line, 40) ++ "`")
    }
    rows = rows ++ line ++ "\n"
    i = i + 1
  }
  Ok(BuildFile { version: version, rows: rows })
}

# ---- tests ----

use envmem
use procmem

## `source_plan` then `build_rows` over a table, rendered one row per line:
## the tree is `seed`, the environment holds only `vars`, and a child process
## would panic for want of a reply.
fn rows_in_table(
  seed: memfs.MemFs,
  vars: List[(String, String)],
  dir: String
) -> Result[List[String], String] !io = {
  let (got, _) = memfs.with_fs(seed, () => procmem.with_proc_table([], () => {
    let (rows, _) = envmem.with_env_table(envmem.TABLE_CWD, vars, () =>
        build_rows(source.source_plan(ProjectDirectory(dir))))
    rows
  }))
  let (rows, calls) = got
  if calls != [] { panic("a path-only plan spawned a process") }
  match rows {
    Ok(rs) -> {
      var lines: List[String] = []
      for r in rs { lines = lines ++ [render_row(r)] }
      Ok(lines)
    }
    Err(e) -> Err(e)
  }
}

fn lines_or_panic(r: Result[List[String], String]) -> List[String] =
  match r {
    Ok(ls) -> ls
    Err(e) -> panic("rows: " ++ e)
  }

fn digest_in(seed: memfs.MemFs, name: String, dir: String) -> String !io = {
  let (got, _) = memfs.with_fs(seed, () =>
      source_digest(name, dir ++ "/dawn.toml", dir ++ "/src"))
  match got {
    Ok(d) -> d
    Err(e) -> panic("digest: " ++ e)
  }
}

## A small package tree under `dir`: a manifest and two source files, one of
## them in a subdirectory, so the walk and the sort both have work to do.
fn lib_tree(st0: memfs.MemFs, dir: String, body: String) -> memfs.MemFs = {
  var st = memfs.put(st0, dir ++ "/dawn.toml", "schema = 1\nname = \"lib\"\n")
  st = memfs.put(st, dir ++ "/src/util.dawn", body)
  memfs.put(st, dir ++ "/src/deep/x.dawn", "pub fn x() -> Int = 2\n")
}

test "a source digest does not depend on where the tree sits" {
  var st = memfs.empty(memfs.BASE)
  st = lib_tree(st, "/a/checkout/lib", "pub fn tag() -> Int = 1\n")
  st = lib_tree(st, "/elsewhere/cache/d1-0000/packages/lib", "pub fn tag() -> Int = 1\n")
  let here = digest_in(st, "lib", "/a/checkout/lib")
  let there = digest_in(st, "lib", "/elsewhere/cache/d1-0000/packages/lib")
  assert str.starts_with(here, "s1:")
  assert str.len(here) == 3 + 64
  assert here == there
}

test "a source digest changes with one byte, a file name, or the package name" {
  var st = memfs.empty(memfs.BASE)
  st = lib_tree(st, "/p/one", "pub fn tag() -> Int = 1\n")
  st = lib_tree(st, "/p/two", "pub fn tag() -> Int = 2\n")
  st = lib_tree(st, "/p/three", "pub fn tag() -> Int = 1\n")
  st = memfs.put(st, "/p/three/src/extra.dawn", "")
  let base = digest_in(st, "lib", "/p/one")
  assert digest_in(st, "lib", "/p/two") != base
  # an empty file still names an entry
  assert digest_in(st, "lib", "/p/three") != base
  # the name is part of every entry
  assert digest_in(st, "lib2", "/p/one") != base
}

test "the manifest names path packages by real name and an undeclared version as (devel)" {
  var st = memfs.empty(memfs.BASE)
  st = memfs.put(st, "/w/app/dawn.toml",
    "schema = 1\nname = \"app\"\n\n[deps]\nlocal = \"../lib\"\nmid = \"../mid\"\n")
  st = memfs.put(st, "/w/app/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
  st = lib_tree(st, "/w/lib", "pub fn tag() -> Int = 1\n")
  # `mid` declares a version and reaches `lib` again under another alias
  st = memfs.put(st, "/w/mid/dawn.toml",
    "schema = 1\nname = \"mid\"\nversion = \"0.3.0\"\n\n[deps]\nl = \"../lib\"\n")
  st = memfs.put(st, "/w/mid/src/m.dawn", "pub fn m() -> Int = 3\n")
  let lines = lines_or_panic(rows_in_table(st, [], "/w/app"))
  let lib = digest_in(st, "lib", "/w/lib")
  let mid = digest_in(st, "mid", "/w/mid")
  let app = digest_in(st, "app", "/w/app")
  assert lines == [
    "\tmain\tapp\t(devel)\t" ++ app,
    "\tdep\tlib\t(devel)\t" ++ lib,
    "\tdep\tmid\t0.3.0\t" ++ mid
  ]
}

test "the manifest is the same for one project planned from two places" {
  # the whole project, dependencies included, copied under a second root
  var st = memfs.empty(memfs.BASE)
  for root in ["/first", "/second/deeper"] {
    st = memfs.put(st, root ++ "/app/dawn.toml",
      "schema = 1\nname = \"app\"\nversion = \"1.2.3\"\n\n[deps]\nlib = \"../lib\"\n")
    st = memfs.put(st, root ++ "/app/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
    st = lib_tree(st, root ++ "/lib", "pub fn tag() -> Int = 1\n")
  }
  let first = lines_or_panic(rows_in_table(st, [], "/first/app"))
  assert len(first) == 2
  assert first == lines_or_panic(rows_in_table(st, [], "/second/deeper/app"))
}

test "a root without dawn.toml is unnamed and in development" {
  var st = memfs.empty(memfs.BASE)
  st = memfs.put(st, "/q/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
  assert lines_or_panic(rows_in_table(st, [], "/q")) ==
    ["\tmain\t(unnamed)\t(devel)\t" ++ digest_in(st, "(unnamed)", "/q")]
}

test "a url package reports the version MVS selected, not the one its consumer asked for" {
  # `app` asks for lib 1.0.0, `mid` (a path package) for lib 1.1.0. The
  # archives' own manifests name no version, so the row's version can only
  # have come from the selection, and the hash with it. Both entries are warm
  # in a cache of the test's own, with their urls recorded, so nothing fetches.
  let old_hash = "d1:" ++ str.repeat("a", 64)
  let new_hash = "d1:" ++ str.repeat("b", 64)
  var st = memfs.empty(memfs.BASE)
  let archives = [
    (old_hash, "old", "pub fn tag() -> Int = 0\n"),
    (new_hash, "new", "pub fn tag() -> Int = 1\n")
  ]
  for (hash, tag, body) in archives {
    let entry = pkgfetch.cache_dir("/cache", hash)
    st = memfs.put(st, entry ++ "/pkg/dawn.toml", "schema = 1\nname = \"lib\"\n")
    st = memfs.put(st, entry ++ "/pkg/src/util.dawn", body)
    st = memfs.put(st, "/cache/.origins/" ++ str.replace(hash, ":", "-"),
      "file:///lib-" ++ tag ++ ".zip\n")
  }
  st = memfs.put(st, "/w/app/dawn.toml",
    "schema = 1\nname = \"app\"\n\n[deps]\nmid = \"../mid\"\n\n[deps.lib]\n" ++
      "url = \"file:///lib-old.zip\"\nversion = \"1.0.0\"\nhash = \"" ++ old_hash ++
      "\"\nsubdir = \"pkg\"\n")
  st = memfs.put(st, "/w/app/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
  st = memfs.put(st, "/w/mid/dawn.toml",
    "schema = 1\nname = \"mid\"\n\n[deps.lib]\n" ++
      "url = \"file:///lib-new.zip\"\nversion = \"1.1.0\"\nhash = \"" ++ new_hash ++
      "\"\nsubdir = \"pkg\"\n")
  st = memfs.put(st, "/w/mid/src/m.dawn", "pub fn m() -> Int = 3\n")
  let lines = lines_or_panic(rows_in_table(st, [("DAWN_PKG_CACHE", "/cache")], "/w/app"))
  let lib = digest_in(st, "lib", pkgfetch.cache_dir("/cache", new_hash) ++ "/pkg")
  assert lines[1] == "\tdep\tlib\t1.1.0\t" ++ lib ++ "\t" ++ new_hash ++ "\tsubdir=pkg"
  assert lines[2] == "\tdep\tmid\t(devel)\t" ++ digest_in(st, "mid", "/w/mid")
  assert len(lines) == 3
}

test "a url row carries its manifest hash and subdir after the digest" {
  let row = UrlDepRow("web6", "6.0.0", "s1:aa", "d1:bb", "packages/web")
  assert render_row(row) == "\tdep\tweb6\t6.0.0\ts1:aa\td1:bb\tsubdir=packages/web"
  assert render_row(UrlDepRow("lib", "1.1.0", "s1:aa", "d1:bb", "")) ==
    "\tdep\tlib\t1.1.0\ts1:aa\td1:bb"
  let rows = "\tjava\tg:a:1\n"
  assert render("x: dawn 0.0.0", [JavaRow("g:a:1")]) ==
    "x: dawn 0.0.0\n" ++ rows ++ "\tbuild\t" ++ manifest_digest(rows) ++ "\n"
}

test "the manifest digest covers the rows and is cut to twelve digits for display" {
  # the SHA-256 of the one-row text, spelled out: a test that recomputes it
  # with the producer would only say the producer agrees with itself
  let rows = "\tjava\tg:a:1\n"
  let d = manifest_digest(rows)
  assert d == "b1:" ++ sha256.hex(bytes.utf8(rows))
  assert str.len(d) == 3 + 64
  assert short_digest(d) == str.take(d, 15)
  assert manifest_digest("") == "b1:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  assert manifest_digest(rows ++ "\tjava\tg:b:1\n") != d
}

test "a build-info file reads back to the version and the rows it was written with" {
  let rows = [MainRow("app", "1.0.0", "s1:aa"), PathDepRow("lib", DEVEL, "s1:bb"), JavaRow("g:a:1")]
  let text = render_file("9.8.7", rows)
  assert text == "dawn-build-info 1\ntoolchain\tdawn 9.8.7\n" ++
    "\tmain\tapp\t1.0.0\ts1:aa\n\tdep\tlib\t(devel)\ts1:bb\n\tjava\tg:a:1\n"
  assert parse_file(text) == Ok(BuildFile { version: "9.8.7", rows: rows_text(rows) })
  # a file with no rows is still a file
  assert parse_file("dawn-build-info 1\ntoolchain\tdawn 1.0.0\n") ==
    Ok(BuildFile { version: "1.0.0", rows: "" })
}

test "a build-info file of another schema or shape is refused, not guessed at" {
  let refused = (t: String) => match parse_file(t) {
    Ok(_) -> false
    Err(_) -> true
  }
  assert refused("")
  assert refused("dawn-build-info 2\ntoolchain\tdawn 1.0.0\n")
  assert refused("dawn-build-info 1\n")
  assert refused("dawn-build-info 1\ntoolchain dawn 1.0.0\n")
  assert refused("dawn-build-info 1\ntoolchain\tdawn 1.0.0")
  assert refused("dawn-build-info 1\ntoolchain\tdawn 1.0.0\nmain\tapp\n")
  assert refused("dawn-build-info 1\ntoolchain\tdawn 1.0.0\n\tmain\tapp\n\n")
}

test "a single file's main row digests the texts its load read, named by position" {
  var st = memfs.empty(memfs.BASE)
  st = memfs.put(st, "/f/p.dawn", "pub fn main() -> Unit !io = ()\n")
  let (got, _) = memfs.with_fs(st, () => procmem.with_proc_table([], () => {
    let (rows, _) = envmem.with_env_table(envmem.TABLE_CWD, [], () =>
        file_rows(source.source_plan(SourceFile("/f/p.dawn")),
          [("p.dawn", "pub fn main() -> Unit !io = ()\n"), ("q.dawn", "pub fn q() -> Int = 1\n")]))
    rows
  }))
  let (rows, _) = got
  let main = texts_digest([
    ("(unnamed)/q.dawn", "pub fn q() -> Int = 1\n"),
    ("(unnamed)/p.dawn", "pub fn main() -> Unit !io = ()\n")
  ])
  assert rows == Ok([MainRow(UNNAMED, DEVEL, main)])
  # the same framing as a package on disk: one file named alike digests alike
  var one = memfs.empty(memfs.BASE)
  one = memfs.put(one, "/g/src/main.dawn", "x\n")
  assert digest_in(one, "(unnamed)", "/g") == texts_digest([("(unnamed)/src/main.dawn", "x\n")])
}

test "a project with no src/ folder has no manifest" {
  var st = memfs.empty(memfs.BASE)
  st = memfs.put(st, "/r/dawn.toml", "schema = 1\nname = \"r\"\n")
  assert rows_in_table(st, [], "/r") == Err("project /r has no src/ folder (expected /r/src)")
}

## `product_file` over a table, with no child process and no environment.
fn product_file_in_table(
  seed: memfs.MemFs,
  product: Product,
  target: String,
  root_files: List[(String, String)]
) -> String !io = {
  let (got, _) = memfs.with_fs(seed, () => procmem.with_proc_table([], () => {
    let (file, _) = envmem.with_env_table(envmem.TABLE_CWD, [], () =>
        product_file("9.8.7", product, target, root_files))
    file
  }))
  let (file, calls) = got
  if calls != [] { panic("a path-only plan spawned a process") }
  match file {
    Ok(f) -> f
    Err(e) -> panic("product file: " ++ e)
  }
}

test "a jar lists the Java coordinates it runs with, a native or wasm product none" {
  var st = memfs.empty(memfs.BASE)
  st = memfs.put(st, "/j/app/dawn.toml",
    "schema = 1\nname = \"app\"\n\n[deps]\nlib = \"../lib\"\n\n[java-deps]\n" ++
      "asm = \"org.ow2.asm:asm:9.7.1\"\n")
  st = memfs.put(st, "/j/app/src/main.dawn", "pub fn main() -> Unit !io = ()\n")
  st = lib_tree(st, "/j/lib", "pub fn tag() -> Int = 1\n")
  let main = "\tmain\tapp\t(devel)\t" ++ digest_in(st, "app", "/j/app") ++ "\n"
  let lib = "\tdep\tlib\t(devel)\t" ++ digest_in(st, "lib", "/j/lib") ++ "\n"
  let head = "dawn-build-info 1\ntoolchain\tdawn 9.8.7\n"
  assert product_file_in_table(st, JarProduct, "/j/app", []) ==
    head ++ main ++ lib ++ "\tjava\torg.ow2.asm:asm:9.7.1\n"
  assert product_file_in_table(st, CProduct, "/j/app", []) == head ++ main ++ lib
  # a single file inside the project links the project's [java-deps] on the
  # JVM and still nothing of them natively
  let files = [("src/main.dawn", "pub fn main() -> Unit !io = ()\n")]
  let file_main = "\tmain\t(unnamed)\t(devel)\t" ++
    texts_digest([("(unnamed)/src/main.dawn", "pub fn main() -> Unit !io = ()\n")]) ++ "\n"
  assert product_file_in_table(st, JarProduct, "/j/app/src/main.dawn", files) ==
    head ++ file_main ++ lib ++ "\tjava\torg.ow2.asm:asm:9.7.1\n"
  assert product_file_in_table(st, CProduct, "/j/app/src/main.dawn", files) ==
    head ++ file_main ++ lib
}

test "a product's rows drop only the java rows, in order" {
  let rows = [
    MainRow("app", DEVEL, "s1:aa"),
    JavaRow("g:a:1"),
    PathDepRow("lib", DEVEL, "s1:bb"),
    UrlDepRow("u", "1.0.0", "s1:cc", "d1:dd", ""),
    JavaRow("g:b:2")
  ]
  assert product_rows(JarProduct, rows) == rows
  assert product_rows(CProduct, rows) == [
    MainRow("app", DEVEL, "s1:aa"),
    PathDepRow("lib", DEVEL, "s1:bb"),
    UrlDepRow("u", "1.0.0", "s1:cc", "d1:dd", "")
  ]
}

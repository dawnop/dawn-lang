# expect: an effect name (uppercase), found `ctl`
# expect: expected `=` (function body)
# The prefix is a prefix: `effect ctl Async` reads `ctl` as the effect's name,
# which is lowercase, so it is refused there. Recorded because the order is the
# whole of the choice -- `pub ctl effect` and not `ctl pub effect`, and nothing
# after `effect` at all.
#
# Two diagnostics rather than one: recovery resumes at the next plausible
# declaration start, which is the `fn` inside the braces, and that operation
# signature has no body. Both are declared, because the sequence is the claim.
effect ctl Async {
  fn wait(ms: Int) -> Unit
}

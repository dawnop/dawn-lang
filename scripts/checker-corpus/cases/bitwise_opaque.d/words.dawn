# Outside the declaring module, literals use the explicit FromInt impl and
# the opaque identity must still choose its own bitwise witness and Amount.
pub opaque type Bits = Int
pub opaque type Hidden = Int
pub fn bits(x: Int) -> Bits = x
pub fn hidden(x: Int) -> Hidden = x
impl FromInt[Bits] { fn from_int(n: Int) -> Bits = n }
impl BitAnd[Bits] {
  fn bit_and(a: Bits, b: Bits) -> Bits = {
    let x: Int = a
    let y: Int = b
    x & y
  }
}
impl BitOr[Bits] {
  fn bit_or(a: Bits, b: Bits) -> Bits = {
    let x: Int = a
    let y: Int = b
    x | y
  }
}
impl Shl[Bits] {
  type ShlAmount = Int
  fn shl(a: Bits, n: Int) -> Bits = {
    let x: Int = a
    x << n
  }
}

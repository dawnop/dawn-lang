# std/bytes — byte-string operations (spec §9.5.1).
#
# Short names, module-qualified at the call site: `use std/bytes`, then
# `bytes.len(b)` / `bytes.at(b, i)`.
#
# These write over the bytes_* intrinsics the JVM backend emits into
# dawn/rt/Bytes (utf8/decode/len/at/slice); the handwritten dawn.rt.StdBytes is
# retired. No `unsafe_pure` and no `use java` any more — a bytes_* call is a
# language primitive, not a Java call the checker has to be told is really pure.
#
# `Bytes` crosses the FFI boundary in both directions already (it is a JVM
# `byte[]`), so nothing here needs a workaround for the argument or return type.
# What needs one is the *result* shapes: out-of-range comes back as a -1
# sentinel and a bad charset as `None`, turned into panic/`Option` on this side.
#
# `Bytes ++ Bytes` is an operator, not a function, and stays in the compiler.

# ---- building bytes ----

## A byte buffer under construction.
##
## `Bytes` is finished and immutable, and until this existed it was also
## *unproduceable*: you could take a string's UTF-8, slice it and read it, but
## a byte you computed had no spelling at all -- `0x80` would need a string
## whose UTF-8 encoding is that single byte, and there is none. Anything that
## decompresses writes bytes it computed, so this is the missing half.
##
## It is a value like everything else -- `put` returns the buffer rather than
## mutating it -- and it inherits `array_push`'s clause: the backend extends in
## place exactly when the version it is handed is the only one that could be
## reading the frontier, so building a megabyte is linear and not quadratic.
## `get` is here because the callers that need this are decompressors, and an
## LZ77 back-reference reads output that was written a moment ago.
pub opaque type Buf = Array[Int]

## An empty buffer.
pub fn buf() -> Buf = array_new()

## Append one byte. A value outside 0..255 is truncated, as a byte store is.
pub fn put(b: Buf, byte: Int) -> Buf = array_push(b, byte & 0xFF)

## Append all of `src`.
pub fn put_bytes(b: Buf, src: Bytes) -> Buf = {
  var out = b
  var i = 0
  let n = bytes_len(src)
  while i < n {
    out = array_push(out, bytes_at(src, i))
    i = i + 1
  }
  out
}

## How many bytes have been written.
##
## `size` and not `len`, which is the one place this library spells the length
## question a second way. Dawn has no overloading and `len(b: Bytes)` above is
## the finished-bytes length, so the builder cannot have the name; the survey
## behind the naming rule (CONTRIBUTING §naming) put the exception here rather
## than on the container, because a `Buf` is not one -- it is a write cursor
## with a contract that ends at `freeze`, and its callers are decompressors
## reading back what they just wrote (audit RD-06).
pub fn size(b: Buf) -> Int = array_len(b)

## The byte at `i`, as 0..255. Out of range panics, as `at` does.
pub fn get(b: Buf, i: Int) -> Int = array_get(b, i)

## The finished bytes.
pub fn freeze(b: Buf) -> Bytes = bytes_from_array(b)

## The UTF-8 bytes of `s`.
pub fn utf8(s: String) -> Bytes = bytes_utf8(s)

## `b` decoded as UTF-8; what it cannot read becomes U+FFFD.
pub fn decode_utf8(b: Bytes) -> String = bytes_decode_utf8(b)

## `b` decoded as ISO-8859-1: one code point per byte, 0..255.
pub fn decode_latin1(b: Bytes) -> String = bytes_decode_latin1(b)

## Number of bytes in `b`.
pub fn len(b: Bytes) -> Int = bytes_len(b)

## Whether `b` has no bytes. The same question `str.is_empty` answers, in the
## same words (CONTRIBUTING §naming).
pub fn is_empty(b: Bytes) -> Bool = bytes_len(b) == 0

## The byte at `i` as 0..255. Panics when `i` is out of range — a programming
## error, like indexing a list past its end. The -1 the intrinsic returns is
## that signal, and cannot collide with a real (unsigned) byte value.
pub fn at(b: Bytes, i: Int) -> Int = {
  let v = bytes_at(b, i)
  if v < 0 { panic("bytes.at: index out of range") } else { v }
}

## The bytes in `[start, end)`. Both ends are clamped into range and
## `start > end` yields empty, so this never panics.
pub fn slice(b: Bytes, start: Int, end: Int) -> Bytes = bytes_slice(b, start, end)

## Byte index of the first occurrence of `needle` at or after `from`, or `None`.
## An empty needle matches at the (non-negative) start. Pure Dawn over
## bytes_len/bytes_at — the search loop is not an intrinsic.
pub fn index_of(b: Bytes, needle: Bytes, from: Int) -> Option[Int] = {
  let hlen = bytes_len(b)
  let nlen = bytes_len(needle)
  let start = if from < 0 { 0 } else { from }
  index_scan(b, needle, hlen, nlen, start)
}

fn index_scan(b: Bytes, needle: Bytes, hlen: Int, nlen: Int, i: Int) -> Option[Int] =
  if i + nlen > hlen {
    None
  } else if matches_at(b, needle, nlen, i, 0) {
    Some(i)
  } else {
    index_scan(b, needle, hlen, nlen, i + 1)
  }

fn matches_at(b: Bytes, needle: Bytes, nlen: Int, i: Int, k: Int) -> Bool =
  if k >= nlen {
    true
  } else if bytes_at(b, i + k) == bytes_at(needle, k) {
    matches_at(b, needle, nlen, i, k + 1)
  } else {
    false
  }

# ---- text encodings ----
#
# Hex and Base64 are byte arithmetic and a lookup table, which makes them the
# kind of thing that has no business being a host call -- and yet the same
# "four bits to a hex digit" was written eight times across this tree (two of
# them disagreeing about case), and Base64 had no pure spelling at all, so
# crypto and WebDAV each reached for `use java java.util.Base64` and stained
# an otherwise pure call chain with `!io` all the way up
# (audit RD-03/RD-10). Written here once, both backends get them for free.
#
# The alphabets are arithmetic rather than a string to index into: indexing a
# constant string costs a code-point walk per digit, and the ranges are
# contiguous in ASCII anyway.

fn hex_char(v: Int) -> Int = if v < 10 { '0' + v } else { 'a' + (v - 10) }

fn hex_val(c: Int) -> Int =
  if c >= '0' && c <= '9' {
    c - '0'
  } else if c >= 'a' && c <= 'f' {
    c - 'a' + 10
  } else if c >= 'A' && c <= 'F' {
    c - 'A' + 10
  } else {
    -1
  }

## `b` as hexadecimal: two digits per byte, most significant first, nothing
## between them. Lower case, which is the canonical spelling this library
## produces -- `from_hex` reads either case, `to_hex` writes one.
pub fn to_hex(b: Bytes) -> String = {
  var out: List[Int] = []
  var i = 0
  let n = bytes_len(b)
  while i < n {
    let v = bytes_at(b, i)
    out = out ++ [hex_char(v / 16), hex_char(v % 16)]
    i = i + 1
  }
  from_code_points(out)
}

## `s` read as hexadecimal, or `None` when it is not an even-length run of hex
## digits. Either case is accepted; nothing else is, not even whitespace.
##
## Inquiry (spec §4.8, criterion 2): text arriving from a file or a header is
## checked, not asserted, so a malformed input is a branch and not a panic.
pub fn from_hex(s: String) -> Option[Bytes] = {
  var out = buf()
  var hi = -1
  for c in code_points(s) {
    let v = hex_val(c)
    if v < 0 {
      return None
    }
    if hi < 0 {
      hi = v
    } else {
      out = put(out, hi * 16 + v)
      hi = -1
    }
  }
  if hi >= 0 {
    None
  } else {
    Some(freeze(out))
  }
}

# Base64 has two alphabets that differ only in the last two symbols, and two
# padding conventions. Rather than four encoders they are two parameters:
# `url` picks `-_` over `+/` (RFC 4648 §5) and `pad` decides whether the
# output is rounded up to a multiple of four with `=`.

fn b64_char(v: Int, url: Bool) -> Int =
  if v < 26 {
    'A' + v
  } else if v < 52 {
    'a' + (v - 26)
  } else if v < 62 {
    '0' + (v - 52)
  } else if v == 62 {
    if url { '-' } else { '+' }
  } else {
    if url { '_' } else { '/' }
  }

fn b64_val(c: Int, url: Bool) -> Int =
  if c >= 'A' && c <= 'Z' {
    c - 'A'
  } else if c >= 'a' && c <= 'z' {
    c - 'a' + 26
  } else if c >= '0' && c <= '9' {
    c - '0' + 52
  } else if c == (if url { '-' } else { '+' }) {
    62
  } else if c == (if url { '_' } else { '/' }) {
    63
  } else {
    -1
  }

fn b64_encode(b: Bytes, url: Bool, pad: Bool) -> String = {
  var out: List[Int] = []
  let n = bytes_len(b)
  var i = 0
  while i + 3 <= n {
    let x = bytes_at(b, i) * 65536 + bytes_at(b, i + 1) * 256 + bytes_at(b, i + 2)
    out = out ++ [
      b64_char(x / 262144, url), b64_char((x / 4096) % 64, url),
      b64_char((x / 64) % 64, url), b64_char(x % 64, url)
    ]
    i = i + 3
  }
  let rest = n - i
  if rest == 1 {
    let x = bytes_at(b, i) * 16
    out = out ++ [b64_char(x / 64, url), b64_char(x % 64, url)]
    if pad {
      out = out ++ ['=', '=']
    }
  } else if rest == 2 {
    let x = bytes_at(b, i) * 1024 + bytes_at(b, i + 1) * 4
    out = out ++ [b64_char(x / 4096, url), b64_char((x / 64) % 64, url), b64_char(x % 64, url)]
    if pad {
      out = out ++ ['=']
    }
  }
  from_code_points(out)
}

# One decoder for both alphabets. It accepts a trailing `=` run or no padding
# at all -- the padded and unpadded spellings of the same bytes have to read
# back the same, since the url-safe encoder here omits padding -- but it
# rejects everything else: a wrong number of `=`, a symbol after them, a
# leftover group of one character (which encodes no byte), and a final group
# whose unused low bits are not zero. That last check is what makes decoding
# injective: without it `AB==` and `AC==` would both be one byte.
fn b64_decode(s: String, url: Bool) -> Option[Bytes] = {
  var out = buf()
  var acc = 0
  var have = 0
  var pad = 0
  for c in code_points(s) {
    if c == '=' {
      pad = pad + 1
    } else if pad > 0 {
      return None
    } else {
      let v = b64_val(c, url)
      if v < 0 {
        return None
      }
      acc = acc * 64 + v
      have = have + 1
      if have == 4 {
        out = put(out, acc / 65536)
        out = put(out, (acc / 256) % 256)
        out = put(out, acc % 256)
        acc = 0
        have = 0
      }
    }
  }
  if have == 2 {
    if acc % 16 != 0 || (pad != 0 && pad != 2) {
      return None
    }
    out = put(out, acc / 16)
  } else if have == 3 {
    if acc % 4 != 0 || (pad != 0 && pad != 1) {
      return None
    }
    out = put(out, acc / 1024)
    out = put(out, (acc / 4) % 256)
  } else if have != 0 || pad != 0 {
    # `have == 1` encodes no byte at all, and padding with nothing to pad is
    # not a spelling of anything either
    return None
  }
  Some(freeze(out))
}

## `b` as Base64 with the standard alphabet (`A-Za-z0-9+/`, RFC 4648 §4) and
## `=` padding to a multiple of four characters.
pub fn to_base64(b: Bytes) -> String = b64_encode(b, false, true)

## `s` read as standard-alphabet Base64, or `None` when it is not.
##
## Inquiry (spec §4.8, criterion 2). Padding is optional on the way in even
## though `to_base64` always writes it; the url-safe alphabet is not accepted
## here -- `from_base64_url` is the function that reads it.
pub fn from_base64(s: String) -> Option[Bytes] = b64_decode(s, false)

## `b` as Base64 with the url- and filename-safe alphabet (`A-Za-z0-9-_`,
## RFC 4648 §5) and **no** padding, which is the shape a JWT segment, a
## signature parameter and a path component all want -- `=` has to be
## percent-encoded in a query and means nothing in a file name.
pub fn to_base64_url(b: Bytes) -> String = b64_encode(b, true, false)

## `s` read as url-safe Base64, with or without padding, or `None` when it is
## not. The standard alphabet's `+` and `/` are rejected here, as `-` and `_`
## are by `from_base64`: which alphabet a string is in is the caller's claim,
## and a decoder that guesses turns a mismatch into wrong bytes.
pub fn from_base64_url(s: String) -> Option[Bytes] = b64_decode(s, true)

# ---- iteration (prelude Iter, #44 knife 2) ----

## `for b in bs` yields each byte as an Int in `0..=255`, the same currency
## `at` deals in. The cursor is a plain index: bytes are the one container
## whose representation is contractually flat.
impl Iter[Bytes] {
  type Cur = Int
  type Item = Int

  fn iter_start(b: Bytes) -> Int = 0
  fn iter_done(b: Bytes, c: Int) -> Bool = c >= len(b)
  fn iter_next(b: Bytes, c: Int) -> Int = c + 1
  fn iter_get(b: Bytes, c: Int) -> Int = at(b, c)
}

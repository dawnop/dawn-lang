# The provider side of import_rename: one of every kind of member a selective
# import can rename.
use std/str

pub const LIMIT: Int = 40

pub fn parse(s: String, base: Int = 10) -> Int = str.len(s) * base

pub fn twice(x: Int) -> Int = x * 2

pub type Level = Quiet | Loud(volume: Int)

pub trait Describe[T] {
  fn describe(x: T) -> String
}

impl Describe[Int] {
  fn describe(x: Int) -> String = "int ${x}"
}

pub effect Log {
  fn log_line(s: String) -> Unit
}

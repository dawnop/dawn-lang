# The parsed AST (P3 of self-hosting; architecture per docs/selfhost-ast.md,
# 选甲): this tree carries exactly what the parser saw — no `var` slots for the
# checker to fill in later. Spans are inline offset pairs (`lo`/`hi`); secondary
# spans keep short prefixes (`nlo`/`nhi` for names, `clo`/`chi` for callees, and
# so on).
#
# Offsets are **code-point indices**, the front end's single span currency
# (lexer.slice_cp). UTF-16 is reconstructed only at the LSP boundary, where the
# protocol demands it. These comments used to say UTF-16 throughout, which was
# the Kotlin front end's convention; a wrong statement about the span currency
# is worse than no statement, because every consumer of a span depends on it.

use std/str

# ---- type references ----

pub type TypeRef =
  | TNamed(name: String, args: List[TypeRef], lo: Int, hi: Int)
# a module-qualified type: `m.T[...]` where `m` is a `use ... as m` alias
# (LANG-06; the alias namespace is separate from values, spec §10.3)
  | TQual(qual: String, name: String, args: List[TypeRef], lo: Int, hi: Int)
# a projection `T.Item` (docs/assoc-types-design.md D2): both names uppercase,
# which no other type form starts with, so the shape is unambiguous. The
# subject is a bare name -- the checker requires it to resolve to a type
# parameter whose bounds declare `name`.
  | TAssoc(subject: String, name: String, lo: Int, hi: Int)
  | TTuple(elems: List[TypeRef], lo: Int, hi: Int)
  | TFn(params: List[TypeRef], ret: TypeRef, effs: List[String], lo: Int, hi: Int)

## One trait bound (or derive) with its span: the Ord in `[T: Ord]`.
pub type Bound = { name: String, lo: Int, hi: Int }

pub type TypeParamDecl = { name: String, bounds: List[Bound], lo: Int, hi: Int }

## `!e` in a declaration's parameter table: an explicit binder for an effect
## variable, spelled with the `!` the row uses (docs/effect-params-design.md
## decision 3). It travels beside `TypeParamDecl` rather than inside it because
## an effect is not a `Ty` and never enters the type axis: `Sig.constraints` is
## positionally aligned with `Sig.tparams`, and a member of another kind in
## that list would silently slide the dictionary symbols one slot (decision 1).
##
## The binder carries no bounds. A trait bound constrains a type, and the
## effect axis has nothing to constrain: `[!e: X]` is refused at the parser.
## The span runs from the `!` to the end of the name, so a diagnostic underlines
## what the author wrote.
pub type EffParamDecl = { name: String, lo: Int, hi: Int }

## `default`: the parameter's default value (#207) -- checked once in the
## declaring module and synthesized as `f$default$k`, so a call may omit the
## argument. Only top-level functions consume it; trait methods, effect
## operations and impl methods refuse it during registration.
pub type Param = { name: String, tref: TypeRef, default: Option[Expr], lo: Int, hi: Int }

pub type LambdaParam = { name: String, ann: Option[TypeRef], lo: Int, hi: Int }

pub type FieldDecl = { name: String, tref: TypeRef, lo: Int, hi: Int }

pub type CtorDecl = {
  name: String,
  fields: List[FieldDecl],
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

pub type ImportName = { name: String, lo: Int, hi: Int }

# ---- expressions ----

pub type StrPart =
  | SPText(v: String)
  | SPInterp(e: Expr)

pub type BinOp =
  | OpAdd
  | OpSub
  | OpMul
  | OpDiv
  | OpMod
  | OpConcat
  | OpEq
  | OpNeq
  | OpLt
  | OpLe
  | OpGt
  | OpGe
  | OpAnd
  | OpOr
  | OpBand
  | OpBor
  | OpBxor
  | OpShl
  | OpShr
  | OpUshr

pub type UnOp =
  | OpNeg
  | OpNot
  | OpBnot

## The Kotlin BinOp enum spelling, the vocabulary of the golden AST dump.
pub fn bin_op_name(op: BinOp) -> String =
  match op {
    OpAdd -> "ADD"
    OpSub -> "SUB"
    OpMul -> "MUL"
    OpDiv -> "DIV"
    OpMod -> "MOD"
    OpConcat -> "CONCAT"
    OpEq -> "EQ"
    OpNeq -> "NEQ"
    OpLt -> "LT"
    OpLe -> "LE"
    OpGt -> "GT"
    OpGe -> "GE"
    OpAnd -> "AND"
    OpOr -> "OR"
    OpBand -> "BAND"
    OpBor -> "BOR"
    OpBxor -> "BXOR"
    OpShl -> "SHL"
    OpShr -> "SHR"
    OpUshr -> "USHR"
  }

pub fn un_op_name(op: UnOp) -> String =
  match op {
    OpNeg -> "NEG"
    OpNot -> "NOT"
    OpBnot -> "BNOT"
  }

## One argument of a call, a construction or a record literal — the EBNF `arg`
## production. `name` is `Some` for the `IDENT: expr` spelling, which is legal
## *syntactically* at every call position (SYN-02/SYN-03): whether names are
## accepted is decided by what the callee is, in the checker
## (docs/audit/application-syntax-design.md §3.2). `lo` starts at the name when
## there is one, so the span covers what a diagnostic must underline.
##
## `trailing` marks the closure attached by a tail block or a `with` statement
## (spec §4.3/§4.10): it fills the *last declared* parameter or field, whatever
## named arguments came before it, and the checker's "positional cannot follow
## named" rule does not apply to it.
pub type Arg = { name: Option[String], e: Expr, trailing: Bool, lo: Int, hi: Int }

## A positional argument around an expression (the common case).
pub fn pos_arg(e: Expr) -> Arg = Arg { name: None, e: e, trailing: false, lo: e_lo(e), hi: e_hi(e) }

## The marked tail argument `attach_trailing` and the dot-call sugar arms build;
## see `Arg.trailing`.
pub fn trail_arg(e: Expr) -> Arg = Arg { name: None, e: e, trailing: true, lo: e_lo(e), hi: e_hi(e) }

## Drop the names: for the callees that reject them, everything downstream
## works on plain expressions.
pub fn arg_exprs(args: List[Arg]) -> List[Expr] = {
  var out: List[Expr] = []
  for a in args { out = out ++ [a.e] }
  out
}

## The first argument written with a name, if any.
pub fn first_named(args: List[Arg]) -> Option[Arg] = {
  for a in args {
    match a.name {
      Some(_) -> return Some(a)
      None -> ()
    }
  }
  None
}

pub type MatchArm = { pat: Pattern, guard: Option[Expr], body: Expr, lo: Int, hi: Int }

## One arm of a `with handle E { ... }` clause: `op(a, b) => body`. The arm is
## a closure over the operation's parameters, so it carries what a lambda
## carries; `nlo`/`nhi` span the operation name, which is what a diagnostic
## about an unknown or duplicated operation underlines.
pub type HandlerArm = {
  name: String,
  params: List[LambdaParam],
  body: Expr,
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

pub type Expr =
  | EInt(v: Int, lo: Int, hi: Int)
# a character literal `'a'`: `v` is its code point, its type is `Char`
  | EChar(v: Int, lo: Int, hi: Int)
  | EFloat(v: Float, lo: Int, hi: Int)
  | EBool(v: Bool, lo: Int, hi: Int)
  | EUnit(lo: Int, hi: Int)
  | EStr(parts: List[StrPart], lo: Int, hi: Int)
  | EVar(name: String, lo: Int, hi: Int)
# the one application node (SYN-02): `f(x)`, `Circle(1.0)`, `make()(1)` and
# `(if c { f } else { g })(1)` all parse to this. What kind of call it is
# follows from what `target` resolves to, and is decided in check_apply.
  | EApply(target: Expr, args: List[Arg], lo: Int, hi: Int)
  | EMethod(target: Expr, name: String, args: List[Arg], nlo: Int, nhi: Int, lo: Int, hi: Int)
# `sugar` marks a lambda the parser synthesized rather than one the author
# wrote: the `with` statement turns the rest of its block into this node
# (spec §4.10). The checker reads the flag only to phrase diagnostics -- a
# `return` crossing this boundary must talk about `with`, not accuse the
# author of a lambda they never typed.
  | ELambda(params: List[LambdaParam], body: Expr, sugar: Bool, lo: Int, hi: Int)
  | ECtor(
    name: String,
    args: List[Arg],
    spread: Option[Expr],
    has_parens: Bool,
    clo: Int,
    chi: Int,
    lo: Int,
    hi: Int
  )
  | EFieldAcc(target: Expr, field: String, flo: Int, fhi: Int, lo: Int, hi: Int)
  | EListLit(elems: List[Expr], lo: Int, hi: Int)
  | ETupleLit(elems: List[Expr], lo: Int, hi: Int)
  | EPropagate(operand: Expr, lo: Int, hi: Int)
  | EUnwrap(operand: Expr, lo: Int, hi: Int)
  | EIndex(target: Expr, index: Expr, lo: Int, hi: Int)
  | EReturn(v: Option[Expr], lo: Int, hi: Int)
  | EBreak(lo: Int, hi: Int)
  | EContinue(lo: Int, hi: Int)
  | EComptime(body: Expr, lo: Int, hi: Int)
  | EUnsafePure(body: Expr, lo: Int, hi: Int)
  | EBinary(op: BinOp, left: Expr, right: Expr, olo: Int, ohi: Int, lo: Int, hi: Int)
  | EUnary(op: UnOp, operand: Expr, lo: Int, hi: Int)
  | EIf(cond: Expr, thn: Expr, els: Option[Expr], lo: Int, hi: Int)
  | EMatch(scrut: Expr, arms: List[MatchArm], lo: Int, hi: Int)
  | EBlock(stmts: List[Stmt], tail: Option[Expr], lo: Int, hi: Int)
# `with handle E { op(..) => ... }` plus the rest of its block, which the
# parser turned into `rest`: a parameterless sugar lambda, exactly as the
# `with x <- f(..)` form does (spec §4.10). The handler is not a call, so the
# closure has nowhere to be attached and rides here instead; the checker is
# what discharges E from the remainder's effect row.
  | EHandle(
    name: String,
    arms: List[HandlerArm],
    rest: Expr,
    nlo: Int,
    nhi: Int,
    lo: Int,
    hi: Int
  )

# ---- patterns ----

# `nlo`/`nhi` span the field name, so a diagnostic about the *name* can point
# at it; for a positional argument there is no name and they span the pattern.
pub type PatArg = { name: Option[String], nlo: Int, nhi: Int, pat: Pattern }

pub type Pattern =
  | PLit(lit: Expr, lo: Int, hi: Int)
  | PBind(name: String, lo: Int, hi: Int)
  | PWild(lo: Int, hi: Int)
  | POr(alts: List[Pattern])
  | PCtor(
    name: String,
    args: List[PatArg],
    has_rest: Bool,
    has_parens: Bool,
    nlo: Int,
    nhi: Int,
    lo: Int,
    hi: Int
  )
# a module-qualified constructor pattern: `m.C(..)` / `m.C { .. }` (LANG-06)
  | PQual(
    qual: String,
    name: String,
    args: List[PatArg],
    has_rest: Bool,
    has_parens: Bool,
    nlo: Int,
    nhi: Int,
    lo: Int,
    hi: Int
  )
  | PTuple(elems: List[Pattern], lo: Int, hi: Int)
  | PList(
    pre: List[Pattern],
    has_rest: Bool,
    rest_name: Option[String],
    rest_span: Option[(Int, Int)],
    post: List[Pattern],
    lo: Int,
    hi: Int
  )

# ---- statements ----

pub type Stmt =
  | SLet(name: String, mutable: Bool, ann: Option[TypeRef], init: Expr, lo: Int, hi: Int)
  | SLetPat(pat: Pattern, mutable: Bool, init: Expr, lo: Int, hi: Int)
  | SLocalFn(
    name: String,
    params: List[LambdaParam],
    ret: TypeRef,
    effs: List[String],
    body: Expr,
    nlo: Int,
    nhi: Int,
    lo: Int,
    hi: Int
  )
  | SAssign(name: String, value: Expr, nlo: Int, nhi: Int, lo: Int, hi: Int)
  | SExpr(e: Expr, lo: Int, hi: Int)
  | SAssert(cond: Expr, src: Option[String], lo: Int, hi: Int)
  | SWhile(cond: Expr, body: Expr, lo: Int, hi: Int)
  | SFor(pat: Pattern, from: Expr, to: Option[Expr], body: Expr, lo: Int, hi: Int)

# ---- declarations ----

## `type Item` in a trait body: a bare associated type declaration
## (docs/assoc-types-design.md D1 -- no bounds, no default).
pub type AssocDecl = { name: String, lo: Int, hi: Int, nlo: Int, nhi: Int }

## `type Item = X` in an impl body: the binding an impl owes for each
## associated type its trait declares.
pub type AssocBind = { name: String, tref: TypeRef, lo: Int, hi: Int, nlo: Int, nhi: Int }

pub type TraitMethod = {
  name: String,
  params: List[Param],
  ret: TypeRef,
  effs: List[String],
  body: Option[Expr],
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

pub type FnDecl = {
  is_pub: Bool,
  name: String,
  tparams: List[TypeParamDecl],
  # The `!e` items of the same bracketed list, kept apart from `tparams` for the
  # reason `EffParamDecl` gives. Empty for every signature that leaves its
  # effect variables to the implicit introduction of spec §6.3, which stays
  # legal and produces the same `Sig.eparams` (decision 2).
  eparams: List[EffParamDecl],
  params: List[Param],
  ret: Option[TypeRef],
  effs: List[String],
  body: Expr,
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

pub type TypeDeclR = {
  is_pub: Bool,
  # `opaque type N[..] = T`: nominal to every other module, its target to this
  # one. Carries alias_target like an alias does -- the difference is only who
  # is allowed to see through it.
  is_opaque: Bool,
  name: String,
  tparams: List[String],
  # `!e` items of the same bracketed list. Names only, like `tparams`: nothing
  # downstream reads a span off one, and the diagnostic that mentions a binder
  # points at the function type that used it, not at the binder.
  eparams: List[String],
  ctors: List[CtorDecl],
  is_record: Bool,
  derives: List[Bound],
  alias_target: Option[TypeRef],
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

## One operation of an `effect` declaration: an ordinary function signature
## with no body and no effect annotation of its own -- an operation's effect
## is the effect that declares it (docs/effects-design.md §3.1).
pub type EffectOp = {
  name: String,
  params: List[Param],
  ret: TypeRef,
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

pub type EffectDeclR = {
  is_pub: Bool,
  name: String,
  ops: List[EffectOp],
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

pub type Decl =
  | DFn(f: FnDecl)
  | DEffect(e: EffectDeclR)
  | DType(t: TypeDeclR)
  | DConst(
    name: String,
    is_pub: Bool,
    ann: TypeRef,
    init: Expr,
    lo: Int,
    hi: Int,
    nlo: Int,
    nhi: Int
  )
  | DTrait(
    name: String,
    tp: String,
    tplo: Int,
    tphi: Int,
    methods: List[TraitMethod],
    assoc: List[AssocDecl],
    is_pub: Bool,
    lo: Int,
    hi: Int,
    nlo: Int,
    nhi: Int
  )
  | DImpl(
    # `impl[T: Eq] Eq[List[T]]` -- empty for the unconditional `impl Eq[Int]`.
    tparams: List[TypeParamDecl],
    trait_name: String,
    tlo: Int,
    thi: Int,
    subject: TypeRef,
    methods: List[FnDecl],
    assoc: List[AssocBind],
    lo: Int,
    hi: Int
  )
  | DUseJava(fqcn: String, lo: Int, hi: Int, nlo: Int, nhi: Int)
  | DUseModule(
    segs: List[String],
    selective: Option[List[ImportName]],
    aname: Option[ImportName],
    lo: Int,
    hi: Int,
    nlo: Int,
    nhi: Int
  )
  | DTest(name: String, body: Expr, lo: Int, hi: Int, nlo: Int, nhi: Int)

pub type Module = { decls: List[Decl] }

# ---- span accessors ----

pub fn e_lo(e: Expr) -> Int =
  match e {
    EInt(_, lo, _) -> lo
    EChar(_, lo, _) -> lo
    EFloat(_, lo, _) -> lo
    EBool(_, lo, _) -> lo
    EUnit(lo, _) -> lo
    EStr(_, lo, _) -> lo
    EVar(_, lo, _) -> lo
    EApply(_, _, lo, _) -> lo
    EMethod(_, _, _, _, _, lo, _) -> lo
    ELambda(_, _, _, lo, _) -> lo
    ECtor(_, _, _, _, _, _, lo, _) -> lo
    EFieldAcc(_, _, _, _, lo, _) -> lo
    EListLit(_, lo, _) -> lo
    ETupleLit(_, lo, _) -> lo
    EPropagate(_, lo, _) -> lo
    EUnwrap(_, lo, _) -> lo
    EIndex(_, _, lo, _) -> lo
    EReturn(_, lo, _) -> lo
    EBreak(lo, _) -> lo
    EContinue(lo, _) -> lo
    EComptime(_, lo, _) -> lo
    EUnsafePure(_, lo, _) -> lo
    EBinary(_, _, _, _, _, lo, _) -> lo
    EUnary(_, _, lo, _) -> lo
    EIf(_, _, _, lo, _) -> lo
    EMatch(_, _, lo, _) -> lo
    EBlock(_, _, lo, _) -> lo
    EHandle(_, _, _, _, _, lo, _) -> lo
  }

pub fn e_hi(e: Expr) -> Int =
  match e {
    EInt(_, _, hi) -> hi
    EChar(_, _, hi) -> hi
    EFloat(_, _, hi) -> hi
    EBool(_, _, hi) -> hi
    EUnit(_, hi) -> hi
    EStr(_, _, hi) -> hi
    EVar(_, _, hi) -> hi
    EApply(_, _, _, hi) -> hi
    EMethod(_, _, _, _, _, _, hi) -> hi
    ELambda(_, _, _, _, hi) -> hi
    ECtor(_, _, _, _, _, _, _, hi) -> hi
    EFieldAcc(_, _, _, _, _, hi) -> hi
    EListLit(_, _, hi) -> hi
    ETupleLit(_, _, hi) -> hi
    EPropagate(_, _, hi) -> hi
    EUnwrap(_, _, hi) -> hi
    EIndex(_, _, _, hi) -> hi
    EReturn(_, _, hi) -> hi
    EBreak(_, hi) -> hi
    EContinue(_, hi) -> hi
    EComptime(_, _, hi) -> hi
    EUnsafePure(_, _, hi) -> hi
    EBinary(_, _, _, _, _, _, hi) -> hi
    EUnary(_, _, _, hi) -> hi
    EIf(_, _, _, _, hi) -> hi
    EMatch(_, _, _, hi) -> hi
    EBlock(_, _, _, hi) -> hi
    EHandle(_, _, _, _, _, _, hi) -> hi
  }

pub fn t_lo(t: TypeRef) -> Int =
  match t {
    TNamed(_, _, lo, _) -> lo
    TQual(_, _, _, lo, _) -> lo
    TAssoc(_, _, lo, _) -> lo
    TTuple(_, lo, _) -> lo
    TFn(_, _, _, lo, _) -> lo
  }

pub fn t_hi(t: TypeRef) -> Int =
  match t {
    TNamed(_, _, _, hi) -> hi
    TQual(_, _, _, _, hi) -> hi
    TAssoc(_, _, _, hi) -> hi
    TTuple(_, _, hi) -> hi
    TFn(_, _, _, _, hi) -> hi
  }

pub fn pat_lo(p: Pattern) -> Int =
  match p {
    PLit(_, lo, _) -> lo
    PBind(_, lo, _) -> lo
    PWild(lo, _) -> lo
    POr(alts) -> pat_lo(alts[0])
    PCtor(_, _, _, _, _, _, lo, _) -> lo
    PQual(_, _, _, _, _, _, _, lo, _) -> lo
    PTuple(_, lo, _) -> lo
    PList(_, _, _, _, _, lo, _) -> lo
  }

pub fn pat_hi(p: Pattern) -> Int =
  match p {
    PLit(_, _, hi) -> hi
    PBind(_, _, hi) -> hi
    PWild(_, hi) -> hi
    POr(alts) -> pat_hi(alts[len(alts) - 1])
    PCtor(_, _, _, _, _, _, _, hi) -> hi
    PQual(_, _, _, _, _, _, _, _, hi) -> hi
    PTuple(_, _, hi) -> hi
    PList(_, _, _, _, _, _, hi) -> hi
  }

# ---- module views (the Kotlin Module's filtered lazy lists) ----

pub fn module_fns(m: Module) -> List[FnDecl] = {
  var out: List[FnDecl] = []
  for d in m.decls {
    match d {
      DFn(f) -> { out = out ++ [f] }
      _ -> ()
    }
  }
  out
}

pub fn module_effects(m: Module) -> List[EffectDeclR] = {
  var out: List[EffectDeclR] = []
  for d in m.decls {
    match d {
      DEffect(e) -> { out = out ++ [e] }
      _ -> ()
    }
  }
  out
}

pub fn module_types(m: Module) -> List[TypeDeclR] = {
  var out: List[TypeDeclR] = []
  for d in m.decls {
    match d {
      DType(t) -> { out = out ++ [t] }
      _ -> ()
    }
  }
  out
}

pub type ConstView = {
  name: String,
  is_pub: Bool,
  ann: TypeRef,
  init: Expr,
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

pub fn module_consts(m: Module) -> List[ConstView] = {
  var out: List[ConstView] = []
  for d in m.decls {
    match d {
      DConst(name, is_pub, ann, init, lo, hi, nlo, nhi) -> {
        out = out ++ [ConstView {
          name: name,
          is_pub: is_pub,
          ann: ann,
          init: init,
          lo: lo,
          hi: hi,
          nlo: nlo,
          nhi: nhi
        }]
      }
      _ -> ()
    }
  }
  out
}

pub type TraitView = {
  name: String,
  tp: String,
  tplo: Int,
  tphi: Int,
  methods: List[TraitMethod],
  assoc: List[AssocDecl],
  is_pub: Bool,
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

pub fn module_traits(m: Module) -> List[TraitView] = {
  var out: List[TraitView] = []
  for d in m.decls {
    match d {
      DTrait(name, tp, tplo, tphi, methods, assoc, is_pub, lo, hi, nlo, nhi) -> {
        out = out ++ [TraitView {
          name: name,
          tp: tp,
          tplo: tplo,
          tphi: tphi,
          methods: methods,
          assoc: assoc,
          is_pub: is_pub,
          lo: lo,
          hi: hi,
          nlo: nlo,
          nhi: nhi
        }]
      }
      _ -> ()
    }
  }
  out
}

pub type ImplView = {
  tparams: List[TypeParamDecl],
  trait_name: String,
  tlo: Int,
  thi: Int,
  subject: TypeRef,
  methods: List[FnDecl],
  assoc: List[AssocBind],
  lo: Int,
  hi: Int
}

pub fn module_impls(m: Module) -> List[ImplView] = {
  var out: List[ImplView] = []
  for d in m.decls {
    match d {
      DImpl(tparams, trait_name, tlo, thi, subject, methods, assoc, lo, hi) -> {
        out = out ++ [ImplView {
          tparams: tparams,
          trait_name: trait_name,
          tlo: tlo,
          thi: thi,
          subject: subject,
          methods: methods,
          assoc: assoc,
          lo: lo,
          hi: hi
        }]
      }
      _ -> ()
    }
  }
  out
}

pub type TestView = { name: String, body: Expr, lo: Int, hi: Int, nlo: Int, nhi: Int }

pub fn module_tests(m: Module) -> List[TestView] = {
  var out: List[TestView] = []
  for d in m.decls {
    match d {
      DTest(name, body, lo, hi, nlo, nhi) -> {
        out = out ++ [TestView { name: name, body: body, lo: lo, hi: hi, nlo: nlo, nhi: nhi }]
      }
      _ -> ()
    }
  }
  out
}

pub type JavaUseView = { fqcn: String, simple: String, lo: Int, hi: Int, nlo: Int, nhi: Int }

## The last dot-separated segment, or the whole name when there is no dot.
fn simple_of(fqcn: String) -> String =
  match str.last_index_of(fqcn, ".") {
    Some(i) -> str.slice(fqcn, i + 1, str.len(fqcn))
    None -> fqcn
  }

pub fn module_java_uses(m: Module) -> List[JavaUseView] = {
  var out: List[JavaUseView] = []
  for d in m.decls {
    match d {
      DUseJava(fqcn, lo, hi, nlo, nhi) -> {
        out = out ++ [JavaUseView {
          fqcn: fqcn,
          simple: simple_of(fqcn),
          lo: lo,
          hi: hi,
          nlo: nlo,
          nhi: nhi
        }]
      }
      _ -> ()
    }
  }
  out
}

pub type UseView = {
  segs: List[String],
  path: String,
  alias_name: String,
  selective: Option[List[ImportName]],
  lo: Int,
  hi: Int,
  nlo: Int,
  nhi: Int
}

pub fn module_uses(m: Module) -> List[UseView] = {
  var out: List[UseView] = []
  for d in m.decls {
    match d {
      DUseModule(segs, selective, aname, lo, hi, nlo, nhi) -> {
        let als = match aname {
          Some(n) -> n.name
          None -> segs[len(segs) - 1]
        }
        out = out ++ [UseView {
          segs: segs,
          path: join(segs, "/"),
          alias_name: als,
          selective: selective,
          lo: lo,
          hi: hi,
          nlo: nlo,
          nhi: nhi
        }]
      }
      _ -> ()
    }
  }
  out
}

## Signed 32-bit integers: `I32`, an opaque type over `Int` holding
## -2147483648..2147483647, with arithmetic that wraps the way `Int`'s does.
#
# GENERATED by scripts/fixed-ints/gen.py -- edit there and rerun it; the
# tree-policy gate fails on a hand edit here.
#
# One of seven sibling modules (std/int/i8, i16, i32, u8, u16, u32, u64) that
# share one shape; docs/literal-system-design.md D13 is the design and spec
# 11 the contract. Why they are std and not the compiler's: the compiler owns
# two numbers, Int and Float (D1), and a fixed-width integer is an Int with
# an invariant, which is what an opaque type is. Measured before this was
# written: packages/sha2's compression loop over std/int/u32 runs within 1% of
# the `Int` + `& MASK` form on both backends.
#
# They live under std/int/ so that seven of them do not crowd the top of
# std; `use` binds a path's last segment, so `use std/int/u32` still
# qualifies as `u32`.
#
# Why one module per width and not one module for all seven: a module is
# Dawn's namespace, so `u32.wrap(n)`, `u32.rotr(x, 7)` and `u8.wrap(n)` are
# the same names qualified differently, as `char.code` is for `Char`. One
# module would need either a width in every name (`wrap_u32`) or a trait
# whose `to_int` member shadows the builtin `to_int` in every importer, and
# the constructors could not be trait members anyway, since their subject is
# only in the return position. A program imports the widths it uses.
#
# The Int inside is always in -2147483648..2147483647, so equality, hashing and order
# are the Int's, inherited (spec 2.7), and correct as they stand: an impl
# of `Ord` of its own would say the same thing and turn every `<` from a
# native comparison into a call. Arithmetic is not inherited (an opaque
# type never inherits it, docs/arith-operator-traits-design.md D4) and is
# written below: each result is computed in Int and wrapped back by
# sign-extending its low 32 bits, so `I32.MAX + 1` is `I32.MIN`, as `Int`'s
# overflow is. `/` and `%` are Int's (truncating, and a zero divisor panics
# with Int's message); the one quotient out of range, MIN / -1, wraps to MIN.
#
# Wrapping and not trapping, as `Int` does (spec 4.3): two overflow rules in
# one family of types would have every reader looking up which one applies.
# `checked_add`, `checked_sub` and `checked_mul` answer `None` instead. A
# literal at `I32` is `FromInt`'s, range-checked at compile time, so
# `let b: I32 = 2147483648` does not compile (outside this module: inside it the
# type is seen through and a literal is the Int it always was, literal design
# D7). The bitwise operations are named functions until the operators have
# traits of their own; `complement` and not `not`, which is a keyword. A
# shift or rotation count is taken modulo 32, as the JVM and the hardware do
# for Int's own shifts.
#
# `I32` is also a device format (std/dtype): the constant `I32` below is its
# witness, spelled like the type so that `use std/int/i32.{I32}` brings in both,
# and `impl HasDtype[I32]` lets generic code ask for it by type.

use std/dtype.{Dtype, HasDtype, dtype_name, dtype_named, dtype_of}

## A signed 32-bit integer.
pub opaque type I32 = Int

## The least `I32`, -2147483648.
pub const MIN: I32 = -2147483648

## The greatest `I32`, 2147483647.
pub const MAX: I32 = 2147483647

## The device format of `I32`: `i32`.
pub const I32: Dtype[I32] = dtype_named("i32")

impl HasDtype[I32] {
  fn dtype_of() -> Dtype[I32] = I32
}

## `n` as a `I32`, or `None` when it is outside -2147483648..2147483647.
pub fn of(n: Int) -> Option[I32] = if n < -2147483648 || n > 2147483647 { None } else { Some(n) }

## The `I32` with the low 32 bits of `n`, read as two's complement:
## `wrap(2147483648)` is -2147483648.
pub fn wrap(n: Int) -> I32 = ((n & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000

## The value of `x` as an Int.
pub fn to_int(x: I32) -> Int = x

# The literal's range check, run at compile time for every literal at this
# type outside this module.
impl FromInt[I32] {
  fn from_int(n: Int) -> I32 = {
    if n < -2147483648 || n > 2147483647 { panic("out of range for I32: ${n}") }
    n
  }
}

impl Show[I32] {
  fn show(x: I32) -> String = {
    let n: Int = x
    to_string(n)
  }
}

impl Add[I32] {
  fn add(a: I32, b: I32) -> I32 = {
    let x: Int = a
    let y: Int = b
    wrap(x + y)
  }
}

impl Sub[I32] {
  fn sub(a: I32, b: I32) -> I32 = {
    let x: Int = a
    let y: Int = b
    wrap(x - y)
  }
}

impl Mul[I32] {
  fn mul(a: I32, b: I32) -> I32 = {
    let x: Int = a
    let y: Int = b
    wrap(x * y)
  }
}

impl Div[I32] {
  fn div(a: I32, b: I32) -> I32 = {
    let x: Int = a
    let y: Int = b
    wrap(x / y)
  }
}

impl Rem[I32] {
  fn rem(a: I32, b: I32) -> I32 = {
    let x: Int = a
    let y: Int = b
    wrap(x % y)
  }
}

impl Neg[I32] {
  fn neg(a: I32) -> I32 = {
    let x: Int = a
    wrap(0 - x)
  }
}

## `a + b`, or `None` where it wraps.
pub fn checked_add(a: I32, b: I32) -> Option[I32] = {
  let x: Int = a
  let y: Int = b
  let r = x + y
  if r < -2147483648 || r > 2147483647 { None } else { Some(r) }
}

## `a - b`, or `None` where it wraps.
pub fn checked_sub(a: I32, b: I32) -> Option[I32] = {
  let x: Int = a
  let y: Int = b
  let r = x - y
  if r < -2147483648 || r > 2147483647 { None } else { Some(r) }
}

## `a * b`, or `None` where it wraps.
pub fn checked_mul(a: I32, b: I32) -> Option[I32] = {
  let x: Int = a
  let y: Int = b
  let r = x * y
  if r < -2147483648 || r > 2147483647 { None } else { Some(r) }
}

## The bitwise and.
pub fn and(a: I32, b: I32) -> I32 = {
  let x: Int = a
  let y: Int = b
  x & y
}

## The bitwise or.
pub fn or(a: I32, b: I32) -> I32 = {
  let x: Int = a
  let y: Int = b
  x | y
}

## The bitwise exclusive or.
pub fn xor(a: I32, b: I32) -> I32 = {
  let x: Int = a
  let y: Int = b
  x ^ y
}

## Every bit flipped.
pub fn complement(a: I32) -> I32 = {
  let x: Int = a
  wrap(~x)
}

## `a` shifted left by `n` modulo 32 places, zeros in at the bottom.
pub fn shl(a: I32, n: Int) -> I32 = {
  let x: Int = a
  wrap(x << (n & 31))
}

## `a` shifted right by `n` modulo 32 places, copies of the sign bit in at
## the top (arithmetic, as Int's `>>`).
pub fn shr(a: I32, n: Int) -> I32 = {
  let x: Int = a
  x >> (n & 31)
}

## `a`'s 32 bits rotated left by `n` modulo 32 places.
pub fn rotl(a: I32, n: Int) -> I32 = {
  let x: Int = a
  let u = x & 0xFFFFFFFF
  let k = n & 31
  wrap((u << k) | (u >>> (32 - k)))
}

## `a`'s 32 bits rotated right by `n` modulo 32 places.
pub fn rotr(a: I32, n: Int) -> I32 = {
  let x: Int = a
  let u = x & 0xFFFFFFFF
  let k = n & 31
  wrap((u >>> k) | (u << (32 - k)))
}

test "the witness is the format the dialect names, found by value or by type" {
  let by_type: Dtype[I32] = dtype_of()
  assert dtype_name(I32) == "i32"
  assert dtype_name(by_type) == "i32"
}

# Representative cases; scripts/spike-native/fixed_ints holds the seven types
# to an oracle computed outside Dawn, on both backends.

test "the ends wrap into each other and the conversions agree" {
  assert MAX + wrap(1) == MIN
  assert MIN - wrap(1) == MAX
  assert to_int(wrap(7) / wrap(2)) == 3
  assert to_int(wrap(7) % wrap(2)) == 1
  assert rotl(wrap(1), 32) == wrap(1)
  assert rotr(wrap(1), 1) == shl(wrap(1), 31)
  assert checked_add(MAX, wrap(1)) == None
  assert checked_sub(MIN, wrap(1)) == None
  assert of(2147483648) == None
  assert of(-2147483648) == Some(MIN)
  assert to_int(wrap(2147483648)) == -2147483648
  assert show(MIN) == "-2147483648"
  # the one quotient out of range wraps, as Int's MIN / -1 does
  assert MIN / wrap(-1) == MIN
  assert to_int(shr(MIN, 1)) == -1073741824
}

# What `dawn doc` may publish in `impls` (design §7.2): an impl is an entry in
# a module's API only when a reader of that API can name both halves of its
# head. All three impls below are registered, solved and callable inside this
# module; exactly one of them is a fact about its public surface.
pub type Card = { rank: Int }

type Draft = { rank: Int }

pub trait Rank[T] {
  fn rank_of(x: T) -> Int
}

trait Sketch[T] {
  fn sketch(x: T) -> Int
}

# published: a public trait for a public type
impl Rank[Card] {
  fn rank_of(x: Card) -> Int = x.rank
}

# private subject
impl Rank[Draft] {
  fn rank_of(x: Draft) -> Int = x.rank
}

# private trait
impl Sketch[Card] {
  fn sketch(x: Card) -> Int = x.rank
}

# std/str — string operations (spec §11).
#
# Short names, module-qualified at the call site: `use std/str`, then
# `str.len(s)` / `str.trim(s)`; hot names can be pulled in selectively
# (`use std/str.{trim}`).
#
# Ordinary Dawn source, bundled into the compiler jar as a resource, checked
# before user code, and with its `pub` surface implicitly visible in every
# module — no `use` needed (spec §10.6). This is the landing place for functions
# moving out of the compiler's builtin table (docs/builtins-to-stdlib.md).
#
# Two implementation styles live here, on purpose (docs/pure-ffi-design.md §九):
#   - plain Dawn over the cursor walk, which is nearly everything;
#   - a str_* intrinsic, only where the answer is a Unicode table rather than a
#     walk: case folding, and `char_is_*` underneath `trim`.
#
# Length, trimming, and all four searches used to be intrinsics too. Each had a
# hand-written implementation in the JVM emitter and another in the C runtime,
# and they disagreed with nothing to say so; the comptime interpreter had no
# copy at all and reflected into the emitted JVM class, which is a route a
# native compiler does not have (docs/native-backend-plan.md 14.12). They are
# walks, not representation, so they are written here once and every consumer
# reads that one definition.
#
# Nothing here names a JVM class; the backend owns the seven cursor primitives
# and the two case foldings in dawn/rt/Strings (docs/runtime-intrinsics-design.md).

use std/cursor
use std/cursor.{Cursor}

## Number of Unicode code points in `s` (not UTF-16 units, and not `chars`' list length).
pub fn len(s: String) -> Int = count(s, cursor.start(s), 0)

fn count(s: String, c: Cursor, n: Int) -> Int =
  if cursor.done(s, c) { n } else { count(s, cursor.next(s, c), n + 1) }

## True when the string has no characters.
pub fn is_empty(s: String) -> Bool = cursor.done(s, cursor.start(s))

## `s` without leading or trailing whitespace.
pub fn trim(s: String) -> String = {
  let a = skip_space(s, cursor.start(s))
  cursor.slice(s, a, last_kept(s, a, a))
}

fn skip_space(s: String, c: Cursor) -> Cursor =
  if cursor.done(s, c) || not char_is_space(cursor.char(s, c)) {
    c
  } else {
    skip_space(s, cursor.next(s, c))
  }

## The position just past the last non-space at or after `c`. Walking forward
## and remembering, rather than walking back from the end, so no two positions
## ever have to be compared.
fn last_kept(s: String, c: Cursor, best: Cursor) -> Cursor =
  if cursor.done(s, c) {
    best
  } else {
    let n = cursor.next(s, c)
    last_kept(s, n, if char_is_space(cursor.char(s, c)) { best } else { n })
  }

## `s` lowercased by simple (1:1) Unicode mapping: one code point in, one out,
## no locale and no context, so the code-point count is unchanged.
pub fn to_lower(s: String) -> String = str_lower(s)

## `s` uppercased by simple (1:1) Unicode mapping. Not the length-changing full
## mapping -- `ß` stays `ß` rather than becoming `SS`, because full mapping is
## locale- and context-sensitive and so is not a function a second backend can
## implement from a table (spec 11). That belongs in a library taking a locale.
pub fn to_upper(s: String) -> String = str_upper(s)

## Whether `sub` occurs anywhere in `s`.
pub fn contains(s: String, sub: String) -> Bool =
  match cursor.find(s, sub, cursor.start(s)) {
    Some(_) -> true
    None -> false
  }

## Whether `s` begins with `prefix`.
pub fn starts_with(s: String, prefix: String) -> Bool =
  cursor.starts_at(s, cursor.start(s), prefix)

## Whether `s` ends with `suffix`.
pub fn ends_with(s: String, suffix: String) -> Bool = {
  let n = len(suffix)
  if n > len(s) {
    false
  } else {
    cursor.starts_at(s, cursor.back(s, cursor.end(s), n), suffix)
  }
}

## The code-point index of the first occurrence of `sub`, or `None`.
##
## A code-point index, not a position: `cursor.find` is the one that answers
## with something you can slice at.
pub fn index_of(s: String, sub: String) -> Option[Int] = idx(s, sub, cursor.start(s), 0)

fn idx(s: String, sub: String, c: Cursor, i: Int) -> Option[Int] =
  if cursor.starts_at(s, c, sub) {
    Some(i)
  } else if cursor.done(s, c) {
    None
  } else {
    idx(s, sub, cursor.next(s, c), i + 1)
  }

## The code-point index of the last occurrence of `sub`, or `None`. An empty
## `sub` is found at the end, which is `len(s)`.
pub fn last_index_of(s: String, sub: String) -> Option[Int] =
  last_idx(s, sub, cursor.start(s), 0, None)

fn last_idx(s: String, sub: String, c: Cursor, i: Int, best: Option[Int]) -> Option[Int] = {
  let seen = if cursor.starts_at(s, c, sub) { Some(i) } else { best }
  if cursor.done(s, c) { seen } else { last_idx(s, sub, cursor.next(s, c), i + 1, seen) }
}

## The single-code-point string for `c`. Panics when `c` is not a valid code point.
pub fn from_char(c: Int) -> String = from_code_points([c])

## `s` repeated `n` times; n <= 0 yields the empty string.
pub fn repeat(s: String, n: Int) -> String = if n <= 0 { "" } else { s ++ repeat(s, n - 1) }

# The code-point helpers below recurse over `code_points(s)` with an explicit
# index because `len` here is str.len (String → code points) and so shadows the
# builtin list length; `str.len(s)` doubles as the code-point count of that list.

## The code points of `s` in `[from, to)`. Both ends are clamped into range
## (a negative index reads as 0, one past the end as `len`) and `from > to`
## yields the empty string, so this never panics — a range parameter selects
## a stretch, it does not assert its endpoints exist (spec §4.8).
pub fn substring(s: String, from: Int, to: Int) -> String = {
  let n = len(s)
  let f = clamp_cp(from, n)
  let t = clamp_cp(to, n)
  if f >= t {
    ""
  } else {
    let acc: List[Int] = []
    from_code_points(slice_cps(code_points(s), f, t, acc))
  }
}

fn clamp_cp(i: Int, n: Int) -> Int = if i < 0 { 0 } else if i > n { n } else { i }

fn slice_cps(cps: List[Int], i: Int, to: Int, acc: List[Int]) -> List[Int] =
  if i >= to { acc } else { slice_cps(cps, i + 1, to, acc ++ [get(cps, i).expect("in range")]) }

## `s` left-padded with `pad` until it is `width` code points wide. Returns `s`
## unchanged when it is already wide enough or `pad` is empty; the filler is
## truncated to land exactly on width.
pub fn pad_start(s: String, width: Int, pad: String) -> String = {
  let have = len(s)
  if have >= width || pad == "" {
    s
  } else {
    let acc: List[Int] = []
    from_code_points(pad_fill(code_points(pad), len(pad), width - have, 0, acc)) ++ s
  }
}

fn pad_fill(pad: List[Int], plen: Int, need: Int, i: Int, acc: List[Int]) -> List[Int] =
  if i >= need { acc }
  else { pad_fill(pad, plen, need, i + 1, acc ++ [get(pad, i % plen).expect("cycle in range")]) }

## `s` with its code points in reverse order (surrogate pairs stay intact).
pub fn reverse(s: String) -> String = {
  let acc: List[Int] = []
  from_code_points(rev_cps(code_points(s), len(s) - 1, acc))
}

fn rev_cps(cps: List[Int], i: Int, acc: List[Int]) -> List[Int] =
  if i < 0 { acc } else { rev_cps(cps, i - 1, acc ++ [get(cps, i).expect("in range")]) }

# ---- cursors ----
#
# Positions come from std/cursor, whose `Cursor` is opaque: only that module
# may see one as the Int it is, so the raw `cursor_*` builtins have exactly
# one caller in the whole ecosystem. chars/split below thread positions
# without ever computing one, which is the guarantee the type carries.

## The characters of `s`, each as a one-character string.
## A surrogate pair stays one element — this splits by character, not by unit.
pub fn chars(s: String) -> List[String] = {
  let empty: List[String] = []
  chars_go(s, cursor.start(s), empty)
}

fn chars_go(s: String, c: Cursor, acc: List[String]) -> List[String] =
  if cursor.done(s, c) {
    acc
  } else {
    let n = cursor.next(s, c)
    chars_go(s, n, acc ++ [cursor.slice(s, c, n)])
  }

## `s` cut at each occurrence of `sep`, left to right. Adjacent separators yield
## empty pieces, and the result always has one more piece than there were
## separators. An empty `sep` yields the characters, as `chars` does.
pub fn split(s: String, sep: String) -> List[String] =
  if sep == "" {
    chars(s)
  } else {
    let empty: List[String] = []
    split_go(s, sep, cursor.start(s), empty)
  }

fn split_go(s: String, sep: String, at: Cursor, acc: List[String]) -> List[String] =
  match cursor.find(s, sep, at) {
    None -> acc ++ [cursor.slice(s, at, cursor.end(s))]
    # cursor.skip is the one sanctioned "advance past a known occurrence"
    Some(i) -> split_go(s, sep, cursor.skip(s, i, sep), acc ++ [cursor.slice(s, at, i)])
  }

## `s` with every occurrence of `from` replaced by `to`, left to right and
## non-overlapping. An empty `from` splices `to` between the characters, the
## same way `split` with an empty separator yields them.
pub fn replace(s: String, from: String, to: String) -> String =
  join(split(s, from), to)

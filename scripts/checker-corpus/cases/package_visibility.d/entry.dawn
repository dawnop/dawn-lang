# The negative half: the project that depends on `lib` sees its `pub`
# names only. Every spelling of a `pub(pkg)` name is refused with the
# same package-private diagnostic.
use lib/core.{api, seam, Trace}
use lib/core
use lib/user

fn go() -> Int = {
  let x = core.seam(1)
  let t: core.Seam = x
  api(1) + user.twice(2) + core.LIMIT
}

fn raise() -> Unit !core.Trace = ()

fn m(s: core.Seam) -> Int =
  match s {
    core.Seam { n } -> n
  }

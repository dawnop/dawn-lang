# An imported identity is public in its own module, so it is nameable here --
# and the importer's own public surface is checked against that, not against a
# rebuilt guess about what `pub` meant over there.
use api.{Id, Wrapper, issue}

type LocalSecret = | LocalSecret

pub fn pass_through() -> Id[Int] = issue()
pub fn wrap() -> Wrapper = Wrapper { id: issue() }
pub fn leak_local() -> LocalSecret = LocalSecret

pub fn main() -> Unit !io = ()

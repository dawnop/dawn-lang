# `a` owns the trait, so it may implement it for the two same-named types
# from `c` and `d`: both statics land in this one class.
use c
use d

pub trait Render[T] {
  fn render(x: T) -> String
}

impl Render[c.Tag] {
  fn render(x: c.Tag) -> String = "c.Tag ${x.n}"
}

impl Render[d.Tag] {
  fn render(x: d.Tag) -> String = "d.Tag ${x.n}"
}

-- length is in code points --
str.len            = 4
str.len ascii      = 3
-- search reports a code-point index --
index_of 中        = 2
index_of missing   = none
index_of empty     = 0
last_index_of l    = 3
last_index_of miss = none
last_index_of ''   = 5
-- predicates --
contains           = true
starts_with        = true
ends_with          = true
ends_with false    = false
-- trimming and case --
trim               = [hi]
trim nothing       = [hi]
trim all           = []
lower              = mixed 42
upper              = MIXED 42
-- classification --
is_letter a        = true
is_digit a         = false
is_space tab       = true
is_space ideo      = true
is_space nbsp      = false
-- parsing --
parse_int          = 42
parse_int signed   = -42
parse_int spaced   = 7
parse_int min      = -9223372036854775808
parse_int over     = none
parse_int junk     = none
parse_int empty    = none
radix 16           = 255
radix 2            = 11
radix bad digit    = none
-- code points --
code_points        = [97, 233, 20013]
round trip         = aé中𝄞
from_code_points   = hi
join               = a-b-c
join empty sep     = ab
join one           = only
-- substring clamps (spec 4.8, criterion 3) --
sub in range       = é中
sub to past end    = 中𝄞
sub from past end  = []
sub from > to      = []
sub negative from  = aé
sub negative both  = []
-- bytes --
bytes_len          = 10
bytes_at 0         = 97
bytes_at oob       = -1
decode round trip  = aé中𝄞
decode bad charset = none
decode_utf8        = aé中𝄞
decode_latin1 len  = 10
-- the barrier --
try missing file   = err
try ok             = ok

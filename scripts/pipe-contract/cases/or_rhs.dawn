# `pipe_expr = or_expr { "|>" or_expr }`. The right side is a whole or_expr, so
# `b |> id() || true` pipes into `id() || true` (a Bool, not a function) and
# is refused. A pipe that parsed its right side one level tighter would take
# `id()` alone and quietly accept this.
fn id(b: Bool) -> Bool = b

pub fn wide(b: Bool) -> Bool = b |> id() || true

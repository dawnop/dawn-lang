## GENERATED FILE -- do not edit. Regenerate with `python3 scripts/gen-stdsrc.py`
## after any edit under std/; the round-trip test in stdlib.dawn fails when stale.
##
## The embedded standard library: std/modules.txt and every module it lists,
## verbatim, as string constants. stdlib.std_read falls back to this when the
## --std directory is absent, which is what makes a standalone toolchain
## self-contained on every backend without a host resource API
## (docs/std-audit.md §2, native-backend-plan §14.20).

## The file's text, or None for a name that is not part of the embedded std.
pub fn source(name: String) -> Option[String] =
  if name == "modules.txt" {
    Some("# Bundled std modules, in dependency order (spec §10.6). Each name is a\n# resource std/<name>.dawn, importable as `use std/<name>`; the file's name is\n# the qualification alias (map.insert, str.trim, ...).\ncursor\nstr\nbytes\nio\nlist\nfspath\nmap\nset\nhamt\npvec\n")
  } else if name == "cursor.dawn" {
    Some("# std/cursor — positions in a String (spec §11).\n#\n# Short names, module-qualified at the call site: `use std/cursor`, then\n# `cursor.next(s, c)`. The underlying operations are compiler intrinsics; these\n# wrappers give them their public, qualified spelling.\n#\n# A position is opaque: `Cursor` is this module's own type, and only this\n# module may see it as the Int it is. Arithmetic on one is a type error\n# anywhere else, which is the point — only arithmetic can conjure a position\n# that lands in the middle of a surrogate pair.\n#\n# It used to be a type the compiler minted: a `Ty` variant, a `Head`, an entry\n# in the eq/hash scalar tables and an arm in seven files. Same guarantee, and\n# now no mechanism of its own — `opaque type` (spec §2.7) is the mechanism.\n\n## A position in a String: an index the language will not let you compute.\npub opaque type Cursor = Int\n\n## The position before the first character.\npub fn start(s: String) -> Cursor = cursor_start(s)\n\n## The position after the last character.\npub fn end(s: String) -> Cursor = cursor_end(s)\n\n## Whether `c` is at the end of `s`.\npub fn done(s: String, c: Cursor) -> Bool = cursor_done(s, c)\n\n## The code point at `c`, or -1 at the end.\npub fn char(s: String, c: Cursor) -> Int = cursor_char(s, c)\n\n## The position one character forward (clamped to the end).\npub fn next(s: String, c: Cursor) -> Cursor = cursor_next(s, c)\n\n## The position one character back (clamped to the start).\npub fn prev(s: String, c: Cursor) -> Cursor = cursor_prev(s, c)\n\n## The text between two positions.\npub fn slice(s: String, from: Cursor, to: Cursor) -> String = cursor_slice(s, from, to)\n\n# The three below used to be intrinsics too — `cursor_skip` and\n# `index_of_from`, each with a hand-written implementation in the JVM emitter\n# and another in the C runtime, and a third route in the comptime interpreter\n# that reflected into the emitted JVM class. Search is not a representation\n# question: it is a walk, and the walk is above. Writing it here leaves seven\n# intrinsics under this module, which is the whole representation boundary\n# (docs/native-backend-plan.md 14.12).\n\n## The position just past `sub`, which is known to start at `c` — the one\n## sanctioned \"advance past a literal\" that would otherwise be cursor arithmetic.\n##\n## Walks both strings together rather than counting `sub` first, so it needs no\n## length and no arithmetic.\npub fn skip(s: String, c: Cursor, sub: String) -> Cursor = skip_go(s, c, sub, start(sub))\n\nfn skip_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Cursor =\n  if done(t, tc) || done(s, sc) {\n    sc\n  } else {\n    skip_go(s, next(s, sc), t, next(t, tc))\n  }\n\n## Whether `sub` occurs in `s` starting exactly at `c`. An empty `sub` is at\n## every position, including the end.\npub fn starts_at(s: String, c: Cursor, sub: String) -> Bool =\n  match_go(s, c, sub, start(sub))\n\nfn match_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Bool =\n  if done(t, tc) {\n    true\n  } else if done(s, sc) {\n    false\n  } else if char(s, sc) != char(t, tc) {\n    false\n  } else {\n    match_go(s, next(s, sc), t, next(t, tc))\n  }\n\n## The position of the first occurrence of `sub` at or after `from`, or `None`.\npub fn find(s: String, sub: String, from: Cursor) -> Option[Cursor] =\n  if starts_at(s, from, sub) {\n    Some(from)\n  } else if done(s, from) {\n    None\n  } else {\n    find(s, sub, next(s, from))\n  }\n\n## The position `n` characters back from `c` (clamped to the start).\npub fn back(s: String, c: Cursor, n: Int) -> Cursor =\n  if n <= 0 { c } else { back(s, prev(s, c), n - 1) }\n\n## Positions in one string are ordered, and that order is the Int's.\n##\n## It used to come from a row in the compiler's scalar tables, and only half\n## of one: `a < b` was allowed while `list.sort` reported Cursor unordered,\n## because two different tables answered the two questions. One impl answers\n## both.\nimpl Ord[Cursor] {\n  fn cmp(a: Cursor, b: Cursor) -> Int = {\n    let x: Int = a\n    let y: Int = b\n    if x < y { -1 } else if x > y { 1 } else { 0 }\n  }\n}\n")
  } else if name == "str.dawn" {
    Some("# std/str — string operations (spec §11).\n#\n# Short names, module-qualified at the call site: `use std/str`, then\n# `str.len(s)` / `str.trim(s)`; hot names can be pulled in selectively\n# (`use std/str.{trim}`).\n#\n# Ordinary Dawn source, bundled into the compiler jar as a resource, checked\n# before user code, and with its `pub` surface implicitly visible in every\n# module — no `use` needed (spec §10.6). This is the landing place for functions\n# moving out of the compiler's builtin table (docs/builtins-to-stdlib.md).\n#\n# Two implementation styles live here, on purpose (docs/pure-ffi-design.md §九):\n#   - plain Dawn over the cursor walk, which is nearly everything;\n#   - a str_* intrinsic, only where the answer is a Unicode table rather than a\n#     walk: case folding, and `char_is_*` underneath `trim`.\n#\n# Length, trimming, and all four searches used to be intrinsics too. Each had a\n# hand-written implementation in the JVM emitter and another in the C runtime,\n# and they disagreed with nothing to say so; the comptime interpreter had no\n# copy at all and reflected into the emitted JVM class, which is a route a\n# native compiler does not have (docs/native-backend-plan.md 14.12). They are\n# walks, not representation, so they are written here once and every consumer\n# reads that one definition.\n#\n# Nothing here names a JVM class; the backend owns the seven cursor primitives\n# and the two case foldings in dawn/rt/Strings (docs/runtime-intrinsics-design.md).\n\nuse std/cursor\nuse std/cursor.{Cursor}\n\n## Number of Unicode code points in `s` (not UTF-16 units, and not `chars`' list length).\npub fn len(s: String) -> Int = count(s, cursor.start(s), 0)\n\nfn count(s: String, c: Cursor, n: Int) -> Int =\n  if cursor.done(s, c) { n } else { count(s, cursor.next(s, c), n + 1) }\n\n## True when the string has no characters.\npub fn is_empty(s: String) -> Bool = cursor.done(s, cursor.start(s))\n\n## `s` without leading or trailing whitespace.\npub fn trim(s: String) -> String = {\n  let a = skip_space(s, cursor.start(s))\n  cursor.slice(s, a, last_kept(s, a, a))\n}\n\nfn skip_space(s: String, c: Cursor) -> Cursor =\n  if cursor.done(s, c) || not char_is_space(cursor.char(s, c)) {\n    c\n  } else {\n    skip_space(s, cursor.next(s, c))\n  }\n\n## The position just past the last non-space at or after `c`. Walking forward\n## and remembering, rather than walking back from the end, so no two positions\n## ever have to be compared.\nfn last_kept(s: String, c: Cursor, best: Cursor) -> Cursor =\n  if cursor.done(s, c) {\n    best\n  } else {\n    let n = cursor.next(s, c)\n    last_kept(s, n, if char_is_space(cursor.char(s, c)) { best } else { n })\n  }\n\n## `s` lowercased by simple (1:1) Unicode mapping: one code point in, one out,\n## no locale and no context, so the code-point count is unchanged.\npub fn to_lower(s: String) -> String = str_lower(s)\n\n## `s` uppercased by simple (1:1) Unicode mapping. Not the length-changing full\n## mapping -- `ß` stays `ß` rather than becoming `SS`, because full mapping is\n## locale- and context-sensitive and so is not a function a second backend can\n## implement from a table (spec 11). That belongs in a library taking a locale.\npub fn to_upper(s: String) -> String = str_upper(s)\n\n## Whether `sub` occurs anywhere in `s`.\npub fn contains(s: String, sub: String) -> Bool =\n  match cursor.find(s, sub, cursor.start(s)) {\n    Some(_) -> true\n    None -> false\n  }\n\n## Whether `s` begins with `prefix`.\npub fn starts_with(s: String, prefix: String) -> Bool =\n  cursor.starts_at(s, cursor.start(s), prefix)\n\n## Whether `s` ends with `suffix`.\npub fn ends_with(s: String, suffix: String) -> Bool = {\n  let n = len(suffix)\n  if n > len(s) {\n    false\n  } else {\n    cursor.starts_at(s, cursor.back(s, cursor.end(s), n), suffix)\n  }\n}\n\n## The code-point index of the first occurrence of `sub`, or `None`.\n##\n## A code-point index, not a position: `cursor.find` is the one that answers\n## with something you can slice at.\npub fn index_of(s: String, sub: String) -> Option[Int] = idx(s, sub, cursor.start(s), 0)\n\nfn idx(s: String, sub: String, c: Cursor, i: Int) -> Option[Int] =\n  if cursor.starts_at(s, c, sub) {\n    Some(i)\n  } else if cursor.done(s, c) {\n    None\n  } else {\n    idx(s, sub, cursor.next(s, c), i + 1)\n  }\n\n## The code-point index of the last occurrence of `sub`, or `None`. An empty\n## `sub` is found at the end, which is `len(s)`.\npub fn last_index_of(s: String, sub: String) -> Option[Int] =\n  last_idx(s, sub, cursor.start(s), 0, None)\n\nfn last_idx(s: String, sub: String, c: Cursor, i: Int, best: Option[Int]) -> Option[Int] = {\n  let seen = if cursor.starts_at(s, c, sub) { Some(i) } else { best }\n  if cursor.done(s, c) { seen } else { last_idx(s, sub, cursor.next(s, c), i + 1, seen) }\n}\n\n## The single-code-point string for `c`. Panics when `c` is not a valid code point.\npub fn from_char(c: Int) -> String = from_code_points([c])\n\n## `s` repeated `n` times; n <= 0 yields the empty string.\npub fn repeat(s: String, n: Int) -> String = if n <= 0 { \"\" } else { s ++ repeat(s, n - 1) }\n\n# The code-point helpers below recurse over `code_points(s)` with an explicit\n# index because `len` here is str.len (String → code points) and so shadows the\n# builtin list length; `str.len(s)` doubles as the code-point count of that list.\n\n## The code points of `s` in `[from, to)`. Panics when the range is out of bounds.\npub fn substring(s: String, from: Int, to: Int) -> String =\n  if from < 0 || from > to || to > len(s) {\n    panic(\"substring: index out of range\")\n  } else {\n    let acc: List[Int] = []\n    from_code_points(slice_cps(code_points(s), from, to, acc))\n  }\n\nfn slice_cps(cps: List[Int], i: Int, to: Int, acc: List[Int]) -> List[Int] =\n  if i >= to { acc } else { slice_cps(cps, i + 1, to, acc ++ [get(cps, i).expect(\"in range\")]) }\n\n## `s` left-padded with `pad` until it is `width` code points wide. Returns `s`\n## unchanged when it is already wide enough or `pad` is empty; the filler is\n## truncated to land exactly on width.\npub fn pad_start(s: String, width: Int, pad: String) -> String = {\n  let have = len(s)\n  if have >= width || pad == \"\" {\n    s\n  } else {\n    let acc: List[Int] = []\n    from_code_points(pad_fill(code_points(pad), len(pad), width - have, 0, acc)) ++ s\n  }\n}\n\nfn pad_fill(pad: List[Int], plen: Int, need: Int, i: Int, acc: List[Int]) -> List[Int] =\n  if i >= need { acc }\n  else { pad_fill(pad, plen, need, i + 1, acc ++ [get(pad, i % plen).expect(\"cycle in range\")]) }\n\n## `s` with its code points in reverse order (surrogate pairs stay intact).\npub fn reverse(s: String) -> String = {\n  let acc: List[Int] = []\n  from_code_points(rev_cps(code_points(s), len(s) - 1, acc))\n}\n\nfn rev_cps(cps: List[Int], i: Int, acc: List[Int]) -> List[Int] =\n  if i < 0 { acc } else { rev_cps(cps, i - 1, acc ++ [get(cps, i).expect(\"in range\")]) }\n\n# ---- cursors ----\n#\n# Positions come from std/cursor, whose `Cursor` is opaque: only that module\n# may see one as the Int it is, so the raw `cursor_*` builtins have exactly\n# one caller in the whole ecosystem. chars/split below thread positions\n# without ever computing one, which is the guarantee the type carries.\n\n## The characters of `s`, each as a one-character string.\n## A surrogate pair stays one element — this splits by character, not by unit.\npub fn chars(s: String) -> List[String] = {\n  let empty: List[String] = []\n  chars_go(s, cursor.start(s), empty)\n}\n\nfn chars_go(s: String, c: Cursor, acc: List[String]) -> List[String] =\n  if cursor.done(s, c) {\n    acc\n  } else {\n    let n = cursor.next(s, c)\n    chars_go(s, n, acc ++ [cursor.slice(s, c, n)])\n  }\n\n## `s` cut at each occurrence of `sep`, left to right. Adjacent separators yield\n## empty pieces, and the result always has one more piece than there were\n## separators. An empty `sep` yields the characters, as `chars` does.\npub fn split(s: String, sep: String) -> List[String] =\n  if sep == \"\" {\n    chars(s)\n  } else {\n    let empty: List[String] = []\n    split_go(s, sep, cursor.start(s), empty)\n  }\n\nfn split_go(s: String, sep: String, at: Cursor, acc: List[String]) -> List[String] =\n  match cursor.find(s, sep, at) {\n    None -> acc ++ [cursor.slice(s, at, cursor.end(s))]\n    # cursor.skip is the one sanctioned \"advance past a known occurrence\"\n    Some(i) -> split_go(s, sep, cursor.skip(s, i, sep), acc ++ [cursor.slice(s, at, i)])\n  }\n\n## `s` with every occurrence of `from` replaced by `to`, left to right and\n## non-overlapping. An empty `from` splices `to` between the characters, the\n## same way `split` with an empty separator yields them.\npub fn replace(s: String, from: String, to: String) -> String =\n  join(split(s, from), to)\n")
  } else if name == "bytes.dawn" {
    Some("# std/bytes — byte-string operations (spec §9.5.1).\n#\n# Short names, module-qualified at the call site: `use std/bytes`, then\n# `bytes.len(b)` / `bytes.at(b, i)`.\n#\n# These write over the bytes_* intrinsics the JVM backend emits into\n# dawn/rt/Bytes (utf8/decode/len/at/slice); the handwritten dawn.rt.StdBytes is\n# retired. No `unsafe_pure` and no `use java` any more — a bytes_* call is a\n# language primitive, not a Java call the checker has to be told is really pure.\n#\n# `Bytes` crosses the FFI boundary in both directions already (it is a JVM\n# `byte[]`), so nothing here needs a workaround for the argument or return type.\n# What needs one is the *result* shapes: out-of-range comes back as a -1\n# sentinel and a bad charset as `None`, turned into panic/`Option` on this side.\n#\n# `Bytes ++ Bytes` is an operator, not a function, and stays in the compiler.\n\n# ---- building bytes ----\n\n## A byte buffer under construction.\n##\n## `Bytes` is finished and immutable, and until this existed it was also\n## *unproduceable*: you could take a string's UTF-8, slice it and read it, but\n## a byte you computed had no spelling at all -- `0x80` would need a string\n## whose UTF-8 encoding is that single byte, and there is none. Anything that\n## decompresses writes bytes it computed, so this is the missing half.\n##\n## It is a value like everything else -- `put` returns the buffer rather than\n## mutating it -- and it inherits `array_push`'s clause: the backend extends in\n## place exactly when the version it is handed is the only one that could be\n## reading the frontier, so building a megabyte is linear and not quadratic.\n## `get` is here because the callers that need this are decompressors, and an\n## LZ77 back-reference reads output that was written a moment ago.\npub opaque type Buf = Array[Int]\n\n## An empty buffer.\npub fn buf() -> Buf = array_new()\n\n## Append one byte. A value outside 0..255 is truncated, as a byte store is.\npub fn put(b: Buf, byte: Int) -> Buf = array_push(b, byte & 0xFF)\n\n## Append all of `src`.\npub fn put_bytes(b: Buf, src: Bytes) -> Buf = {\n  var out = b\n  var i = 0\n  let n = bytes_len(src)\n  while i < n {\n    out = array_push(out, bytes_at(src, i))\n    i = i + 1\n  }\n  out\n}\n\n## How many bytes have been written.\npub fn size(b: Buf) -> Int = array_len(b)\n\n## The byte at `i`, as 0..255. Out of range panics, as `at` does.\npub fn get(b: Buf, i: Int) -> Int = array_get(b, i)\n\n## The finished bytes.\npub fn freeze(b: Buf) -> Bytes = bytes_from_array(b)\n\n## The UTF-8 bytes of `s`.\npub fn utf8(s: String) -> Bytes = bytes_utf8(s)\n\n## `b` decoded with the named charset. Panics when no such charset exists.\npub fn decode(b: Bytes, charset: String) -> String =\n  bytes_decode(b, charset).expect(\"decode: unsupported charset\")\n\n## Number of bytes in `b`.\npub fn len(b: Bytes) -> Int = bytes_len(b)\n\n## The byte at `i` as 0..255. Panics when `i` is out of range — a programming\n## error, like indexing a list past its end. The -1 the intrinsic returns is\n## that signal, and cannot collide with a real (unsigned) byte value.\npub fn at(b: Bytes, i: Int) -> Int = {\n  let v = bytes_at(b, i)\n  if v < 0 { panic(\"bytes.at: index out of range\") } else { v }\n}\n\n## The bytes in `[start, end)`. Both ends are clamped into range and\n## `start > end` yields empty, so this never panics.\npub fn slice(b: Bytes, start: Int, end: Int) -> Bytes = bytes_slice(b, start, end)\n\n## Byte index of the first occurrence of `needle` at or after `from`, or `None`.\n## An empty needle matches at the (non-negative) start. Pure Dawn over\n## bytes_len/bytes_at — the search loop is not an intrinsic.\npub fn index_of(b: Bytes, needle: Bytes, from: Int) -> Option[Int] = {\n  let hlen = bytes_len(b)\n  let nlen = bytes_len(needle)\n  let start = if from < 0 { 0 } else { from }\n  index_scan(b, needle, hlen, nlen, start)\n}\n\nfn index_scan(b: Bytes, needle: Bytes, hlen: Int, nlen: Int, i: Int) -> Option[Int] =\n  if i + nlen > hlen {\n    None\n  } else if matches_at(b, needle, nlen, i, 0) {\n    Some(i)\n  } else {\n    index_scan(b, needle, hlen, nlen, i + 1)\n  }\n\nfn matches_at(b: Bytes, needle: Bytes, nlen: Int, i: Int, k: Int) -> Bool =\n  if k >= nlen {\n    true\n  } else if bytes_at(b, i + k) == bytes_at(needle, k) {\n    matches_at(b, needle, nlen, i, k + 1)\n  } else {\n    false\n  }\n")
  } else if name == "io.dawn" {
    Some("# Dawn's standard library: console, files, and process arguments.\n#\n# These write over the io_* intrinsics, which every backend implements; the\n# handwritten dawn.rt.StdIo is retired. They need no `unsafe_pure`: they are\n# honestly effectful, so their signatures just say `!io`.\n#\n# stderr was missing until 2026-07-28, and its absence was not free: the\n# compiler's own `errio.dawn` existed to reach `System.err`, a static field\n# the `use java` interop cannot name, through a method handle.\n#\n# `args` is deliberately NOT here: argv arrives on a static field of the program's\n# own entry class, and a std function compiles to a different class, so it cannot\n# name that field. Parking argv on a runtime class instead would make it shared\n# by every program in one JVM — see pure-ffi-design.md §十七.\n#\n# The failing ones compose with `catch_fault`, which is an intrinsic and stays\n# in the compiler. That is not a workaround: `Result` is a Dawn ADT and cannot be\n# a Java return type, and the barrier is precisely the built-in bridge from \"the\n# outside world said no\" to an `Err`.\n#\n# That `Err` carries a `ForeignError`, not a String (docs/audit/error-model-design.md\n# 六). A rendered message is a dead end for a caller: the only thing it can do\n# with one is match on its text, which is what spec §9.8 used to advise and what\n# the error model exists to stop. The record hands over `kind` (the backend's own\n# name for the failure class), `message` and `cause` separately, so a caller that\n# wants to *decide* reads `kind` and a caller that wants to *report* reads\n# `message` — neither has to parse. Rendering one back into a line of text is\n# still a `to_string(e)` away for whoever actually wants the line.\n\n## Print a string followed by a newline.\npub fn println(s: String) -> Unit !io = io_println(s)\n\n## Print a string without a newline.\npub fn print(s: String) -> Unit !io = io_print(s)\n\n## Print a string to stderr, followed by a newline.\npub fn eprintln(s: String) -> Unit !io = io_eprintln(s)\n\n## Print a string to stderr without a newline.\npub fn eprint(s: String) -> Unit !io = io_eprint(s)\n\n## End the process with an exit status. Nothing after the call runs.\n##\n## The result is `Unit` rather than `Never` because the intrinsic maps to\n## `System.exit`, which the JVM types as void; a `Never` here would need both\n## emitters to stop treating the call as falling through.\npub fn exit(code: Int) -> Unit !io = io_exit(code)\n\n## Read one line from stdin; `None` at end of input.\n## The intrinsic maps Java's `null`-or-line straight onto `Option`.\npub fn read_line() -> Option[String] !io = io_read_line()\n\n## Whether `path` names a directory.\npub fn is_dir(path: String) -> Bool !io = io_is_dir(path)\n\n## Whether anything exists at `path` -- a file, a directory, anything.\npub fn exists(path: String) -> Bool !io = io_exists(path)\n\n## Create `path` and every missing directory above it.\n## An existing directory is not a failure; an existing *file* is.\npub fn mkdirs(path: String) -> Result[Unit, ForeignError] !io =\n  catch_fault(fn() => io_mkdirs(path))\n\n## Read a whole file as a UTF-8 string.\npub fn read_file(path: String) -> Result[String, ForeignError] !io =\n  catch_fault(fn() => io_read_file(path))\n\n## Write a string to a file, creating missing parent directories.\n## `Ok` carries nothing: the only count worth returning would be bytes on disk,\n## and what this used to return was UTF-16 units. Nobody read it.\npub fn write_file(path: String, content: String) -> Result[Unit, ForeignError] !io =\n  catch_fault(fn() => io_write_file(path, content))\n\n## The process's working directory, as an absolute path.\npub fn cwd() -> String !io = io_cwd()\n\n## The value of the environment variable `name`, or `None` when it is unset.\npub fn getenv(name: String) -> Option[String] !io = io_getenv(name)\n\n## Read a whole file as bytes. The text half is `read_file`.\npub fn read_bytes(path: String) -> Result[Bytes, ForeignError] !io =\n  catch_fault(fn() => io_read_bytes(path))\n\n## Write bytes to a file, creating missing parent directories.\npub fn write_bytes(path: String, content: Bytes) -> Result[Unit, ForeignError] !io =\n  catch_fault(fn() => io_write_bytes(path, content))\n\n## Delete a file, or an empty directory. `true` when there was something to\n## delete: a missing path is not an error, and a non-empty directory is not\n## deleted.\npub fn delete(path: String) -> Bool !io = io_delete(path)\n\n## Move `src` onto `dst`, replacing it. Atomic when the two are on one\n## filesystem and an error when they are not -- which is the whole point: the\n## caller is publishing something it has already verified, and a move that can\n## be observed half-done would defeat that. Stage with `temp_dir` under the\n## destination's own directory to stay on one filesystem.\npub fn rename(src: String, dst: String) -> Result[Unit, ForeignError] !io =\n  catch_fault(fn() => io_rename(src, dst))\n\n## A fresh directory under `parent`, named after `prefix`. An empty `parent`\n## means the system temporary directory.\npub fn temp_dir(parent: String, prefix: String) -> Result[String, ForeignError] !io =\n  catch_fault(fn() => io_temp_dir(parent, prefix))\n\n## Whether `path` is a symbolic link. The link itself is examined, not its\n## target, so a link to a directory is a link and not a directory.\npub fn is_symlink(path: String) -> Bool !io = io_is_symlink(path)\n\n## Exactly `n` bytes of standard input, shorter only at end of input -- so a\n## short read is how end of input is reported.\n##\n## This reads the stream directly while `read_line` reads a buffered reader\n## over it. A program that used both would lose whatever the reader had already\n## buffered; pick one.\npub fn read_stdin(n: Int) -> Bytes !io = io_read_stdin(n)\n\n## The entry names directly under `path`.\n## A non-directory is reported as an `Err`, not a panic, and — matching the old\n## behaviour — is checked before anything is read, so a missing path and a plain\n## file give the same message.\n##\n## Its `kind` is `\"io.not_a_directory\"`, the one failure kind std mints itself:\n## every other one in this module is whatever the backend called it, and this\n## failure never reaches a backend, because the check happens first. It is\n## spelled as a name rather than a sentence for the same reason every other\n## `kind` is — a caller may match on it.\npub fn list_dir(path: String) -> Result[List[String], ForeignError] !io =\n  if is_dir(path) {\n    catch_fault(fn() => io_list_names(path))\n  } else {\n    Err(ForeignError {\n      kind: \"io.not_a_directory\",\n      message: \"not a directory: \" ++ path,\n      cause: None\n    })\n  }\n\n## Run `argv[0]` (found on PATH) with `argv` as its arguments, wait for it, and\n## answer its exit status. A non-zero status is not an error -- it is the\n## answer; an `Err` means the program could not be started at all.\n##\n## Each stream goes to the file named by its path, truncating it, and an empty\n## path leaves that stream pointing wherever this process's already points.\n## Files rather than pipes: see the note on the `io_run` intrinsic.\npub fn run(argv: List[String], out_path: String, err_path: String) -> Result[Int, ForeignError] !io =\n  catch_fault(fn() => io_run(argv, out_path, err_path))\n")
  } else if name == "list.dawn" {
    Some("# Dawn's standard library: list operations.\n#\n# These are the \"layer 2\" of docs/pure-ffi-design.md section 3.3: ordinary Dawn\n# recursion over the primitives that must stay in the compiler. Nothing here\n# needs `unsafe_pure` — and it could not use it anyway, since these functions\n# are effect-polymorphic and the stamp deliberately refuses to mask an effect\n# variable. That refusal is what pushed the higher-order functions onto this\n# path in the first place.\n#\n# The accumulator helpers are module-level rather than local functions because a\n# local function may not declare an effect variable (spec section 3.1). Each is\n# self-tail-recursive, which the compiler turns into a loop, and appends with\n# `++`, which is O(1) amortized on the list representation (spec section 2.2) —\n# without that, every one of these would be quadratic.\n\n# ---- iteration ----\n#\n# Everything that walks a whole list, here and in the compiler, goes through\n# these four. `for x in xs` lowers to them (lower.dawn's `lower_for_list`)\n# rather than to an index loop, and so does every sequential helper below.\n#\n# The difference is not style: an index walk hardwires \"this collection can be\n# randomly indexed\", which costs nothing on today's flat representation and\n# O(log n) on the tree D3 replaces it with — measured 8-18x slower and widening\n# with n. Behind a cursor, the representation changes and its callers do not.\n#\n# A cursor is an index today because the representation is flat. When it stops\n# being flat, `Cur` and these four bodies change and nothing else does.\n#\n# Not `pub`: user code has no business holding one, and the compiler does not\n# need it exported — an ordinary function is emitted public static either way.\n\nalias Cur = Int\n\nfn iter_start[T](xs: List[T]) -> Cur = 0\n\nfn iter_done[T](xs: List[T], c: Cur) -> Bool = c >= len(xs)\n\nfn iter_next[T](xs: List[T], c: Cur) -> Cur = c + 1\n\nfn iter_get[T](xs: List[T], c: Cur) -> T = xs[c]\n\n# ---- sequential walks ----\n\nfn map_go[T, U](xs: List[T], f: fn(T) -> U !e, c: Cur, acc: List[U]) -> List[U] !e =\n  if iter_done(xs, c) { acc }\n  else { map_go(xs, f, iter_next(xs, c), acc ++ [f(iter_get(xs, c))]) }\n\n## `f` applied to every element, in order.\npub fn map[T, U](xs: List[T], f: fn(T) -> U !e) -> List[U] !e = {\n  let empty: List[U] = []\n  map_go(xs, f, iter_start(xs), empty)\n}\n\nfn filter_go[T](xs: List[T], f: fn(T) -> Bool !e, c: Cur, acc: List[T]) -> List[T] !e =\n  if iter_done(xs, c) { acc }\n  else {\n    let x = iter_get(xs, c)\n    filter_go(xs, f, iter_next(xs, c), if f(x) { acc ++ [x] } else { acc })\n  }\n\n## The elements satisfying `f`, in order.\npub fn filter[T](xs: List[T], f: fn(T) -> Bool !e) -> List[T] !e = {\n  let empty: List[T] = []\n  filter_go(xs, f, iter_start(xs), empty)\n}\n\nfn fold_go[T, A](xs: List[T], f: fn(A, T) -> A !e, c: Cur, acc: A) -> A !e =\n  if iter_done(xs, c) { acc }\n  else { fold_go(xs, f, iter_next(xs, c), f(acc, iter_get(xs, c))) }\n\n## Reduce from the left: `f(f(f(init, x0), x1), ...)`.\npub fn fold[T, A](xs: List[T], init: A, f: fn(A, T) -> A !e) -> A !e =\n  fold_go(xs, f, iter_start(xs), init)\n\nfn find_go[T](xs: List[T], pred: fn(T) -> Bool !e, c: Cur) -> Option[T] !e =\n  if iter_done(xs, c) { None }\n  else {\n    let x = iter_get(xs, c)\n    if pred(x) { Some(x) } else { find_go(xs, pred, iter_next(xs, c)) }\n  }\n\n## The first element satisfying `pred`, or `None`.\npub fn find[T](xs: List[T], pred: fn(T) -> Bool !e) -> Option[T] !e =\n  find_go(xs, pred, iter_start(xs))\n\n# ---- by position ----\n#\n# `take`/`drop`/`slice`/`reverse` are positional by nature: one asks for a\n# range, the other for the other end. They stay on `get` and stay O(1) per\n# element on a flat list. D3 does not de-index them — it replaces them, since\n# an ordered tree cuts a range by splitting in O(log n) rather than by copying\n# elements one at a time, and reverses by walking its own structure backwards.\n\nfn slice_go[T](xs: List[T], i: Int, stop: Int, acc: List[T]) -> List[T] =\n  if i >= stop { acc }\n  else { slice_go(xs, i + 1, stop, acc ++ [get(xs, i).expect(\"index below length\")]) }\n\nfn clamp(n: Int, hi: Int) -> Int = if n < 0 { 0 } else { if n > hi { hi } else { n } }\n\n## The first `n` elements; `n` is clamped into range, so this never panics.\npub fn take[T](xs: List[T], n: Int) -> List[T] = {\n  let empty: List[T] = []\n  slice_go(xs, 0, clamp(n, len(xs)), empty)\n}\n\n## Everything after the first `n` elements; `n` is clamped into range.\npub fn drop[T](xs: List[T], n: Int) -> List[T] = {\n  let empty: List[T] = []\n  slice_go(xs, clamp(n, len(xs)), len(xs), empty)\n}\n\n## The elements in `[from, to)`. Both ends are clamped into range, so\n## out-of-bounds indices never panic; `from >= to` yields the empty list.\npub fn slice[T](xs: List[T], from: Int, to: Int) -> List[T] = {\n  let empty: List[T] = []\n  slice_go(xs, clamp(from, len(xs)), clamp(to, len(xs)), empty)\n}\n\nfn reverse_go[T](xs: List[T], i: Int, acc: List[T]) -> List[T] =\n  if i < 0 { acc }\n  else { reverse_go(xs, i - 1, acc ++ [get(xs, i).expect(\"index below length\")]) }\n\n## A reversed copy; the input is not changed.\npub fn reverse[T](xs: List[T]) -> List[T] = {\n  let empty: List[T] = []\n  reverse_go(xs, len(xs) - 1, empty)\n}\n\n## Ascending stable sort; elements need `Ord`. Delegates to `sort_by` with the\n## bound `cmp` — the dictionary crosses as an ordinary captured value, which is\n## what let this leave the builtin table (docs/pure-ffi-design.md section 14).\npub fn sort[T: Ord](xs: List[T]) -> List[T] = sort_by(xs, fn(a, b) => cmp(a, b))\n\n# One walk serves max_by and min_by. `key` runs exactly once per element and\n# only a strictly better key replaces the champion, so the first extreme wins —\n# both observable (effectful keys, ties), both inherited from the retired\n# builtin. The direction is a Bool rather than a ±1 multiplier because `cmp`\n# contracts sign, not magnitude: scaling its result could overflow.\nfn best_by_go[T, K: Ord](\n  xs: List[T], key: fn(T) -> K !e, c: Cur, bx: T, bk: K, greater: Bool\n) -> T !e =\n  if iter_done(xs, c) { bx }\n  else {\n    let x = iter_get(xs, c)\n    let k = key(x)\n    let cp = cmp(k, bk)\n    let better = if greater { cp > 0 } else { cp < 0 }\n    if better { best_by_go(xs, key, iter_next(xs, c), x, k, greater) }\n    else { best_by_go(xs, key, iter_next(xs, c), bx, bk, greater) }\n  }\n\n## The first element whose key is greatest; `None` when empty. Keys need `Ord`;\n## `key` runs once per element.\npub fn max_by[T, K: Ord](xs: List[T], key: fn(T) -> K !e) -> Option[T] !e = {\n  let c = iter_start(xs)\n  if iter_done(xs, c) { None }\n  else {\n    let x0 = iter_get(xs, c)\n    Some(best_by_go(xs, key, iter_next(xs, c), x0, key(x0), true))\n  }\n}\n\n## The first element whose key is least; `None` when empty. Keys need `Ord`;\n## `key` runs once per element.\npub fn min_by[T, K: Ord](xs: List[T], key: fn(T) -> K !e) -> Option[T] !e = {\n  let c = iter_start(xs)\n  if iter_done(xs, c) { None }\n  else {\n    let x0 = iter_get(xs, c)\n    Some(best_by_go(xs, key, iter_next(xs, c), x0, key(x0), false))\n  }\n}\n\n## The first greatest element; `None` when empty. Elements need `Ord`.\npub fn max[T: Ord](xs: List[T]) -> Option[T] = max_by(xs, fn(x) => x)\n\n## The first least element; `None` when empty. Elements need `Ord`.\npub fn min[T: Ord](xs: List[T]) -> Option[T] = min_by(xs, fn(x) => x)\n\n# ---- Eq / Hash / Ord for List (trait-v2-design.md 决策 6) ----\n#\n# Until trait v2 these three were the compiler's business: `==` on a list fell\n# through to a `struct_eq` intrinsic, which each backend answered its own way,\n# and `Ord[List[T]]` did not exist at all, so `sort` refused a list of lists.\n# A conditional impl is how a container says what it means, in Dawn, once.\n#\n# The hash matches the shape the JVM's list hash already had (seed 1, step\n# `31 * acc + h`), because `hash` and the runtime's own bucketing must not\n# disagree about the same value.\n#\n# Two lists take two cursors: a cursor belongs to the list it walks, so there\n# is no single \"position i\" to share between them.\n\nfn eq_go[T: Eq](a: List[T], b: List[T], ca: Cur, cb: Cur) -> Bool =\n  if iter_done(a, ca) {\n    true\n  } else if eq(iter_get(a, ca), iter_get(b, cb)) {\n    eq_go(a, b, iter_next(a, ca), iter_next(b, cb))\n  } else {\n    false\n  }\n\n## Same length, and equal elements in order.\nimpl[T: Eq] Eq[List[T]] {\n  fn eq(a: List[T], b: List[T]) -> Bool =\n    if len(a) != len(b) { false } else { eq_go(a, b, iter_start(a), iter_start(b)) }\n}\n\nfn hash_go[T: Hash](xs: List[T], c: Cur, acc: Int) -> Int =\n  if iter_done(xs, c) {\n    acc\n  } else {\n    hash_go(xs, iter_next(xs, c), acc * 31 + hash(iter_get(xs, c)))\n  }\n\nimpl[T: Hash] Hash[List[T]] {\n  fn hash(xs: List[T]) -> Int = hash_go(xs, iter_start(xs), 1)\n}\n\nfn cmp_go[T: Ord](a: List[T], b: List[T], ca: Cur, cb: Cur) -> Int =\n  if iter_done(a, ca) {\n    if iter_done(b, cb) { 0 } else { 0 - 1 }\n  } else if iter_done(b, cb) {\n    1\n  } else {\n    let c = cmp(iter_get(a, ca), iter_get(b, cb))\n    if c != 0 { c } else { cmp_go(a, b, iter_next(a, ca), iter_next(b, cb)) }\n  }\n\n## Lexicographic: the first differing element decides, and a prefix is less\n## than what extends it.\nimpl[T: Ord] Ord[List[T]] {\n  fn cmp(a: List[T], b: List[T]) -> Int = cmp_go(a, b, iter_start(a), iter_start(b))\n}\n\n# \"Am I at the first element?\" was `i == 0`. A cursor cannot be asked that, so\n# the separator carries its own state -- the one thing dropping the index costs.\nfn show_go[T: Show](xs: List[T], c: Cur, first: Bool, acc: String) -> String =\n  if iter_done(xs, c) {\n    acc\n  } else {\n    show_go(xs, iter_next(xs, c), false,\n      acc ++ (if first { \"\" } else { \", \" }) ++ show(iter_get(xs, c)))\n  }\n\n## `[e0, e1]`, each element in its nested form -- so a String element is\n## quoted where the list itself is not.\nimpl[T: Show] Show[List[T]] {\n  fn show(xs: List[T]) -> String = \"[\" ++ show_go(xs, iter_start(xs), true, \"\") ++ \"]\"\n}\n")
  } else if name == "fspath.dawn" {
    Some("# std/fspath — text operations on POSIX paths.\n#\n# Named `fspath` and not `path` because Dawn puts an imported module's alias in\n# the same namespace as local names, and `path` is one of the most common local\n# names there is -- the compiler alone has it as a parameter in a dozen\n# functions. `fs` overstates it: nothing here touches a filesystem.\n#\n# Nothing here touches the filesystem: these are string functions, and that is\n# the point. The compiler carried this logic twice, letter for letter, as\n# `analyze.canon` and `lsp.canon` -- both spelled\n# `Paths.get(p).toAbsolutePath().normalize().toString()`, one behaviour with\n# two definitions and a `use java` each.\n#\n# The separator is `/`. That is not an oversight: the C runtime already spells\n# `/` in its mkdirs and temp-directory primitives, so the language's own\n# filesystem contract is POSIX-shaped, and a std that pretended otherwise would\n# be pretending on one backend only.\n\nuse std/str\nuse std/list\n\n## Whether `p` starts at the root.\npub fn is_absolute(p: String) -> Bool = str.starts_with(p, \"/\")\n\n## `p` with empty segments, `.` segments and `name/..` pairs removed.\n##\n## A `..` that would climb past the root is dropped (`/../a` is `/a`), because\n## the kernel resolves the root's parent to the root. A leading `..` on a\n## *relative* path is kept -- there it still means something. Both match\n## java.nio.file.Path.normalize, which scripts/path-contract checks; the\n## root-climbing case was written down here as a divergence first and measured\n## as agreement second.\npub fn normalize(p: String) -> String = {\n  let abs = is_absolute(p)\n  var out: List[String] = []\n  for seg in str.split(p, \"/\") {\n    if seg == \"\" || seg == \".\" {\n      ()\n    } else if seg == \"..\" {\n      let n = len(out)\n      if n > 0 && out[n - 1] != \"..\" {\n        out = list.take(out, n - 1)\n      } else if not abs {\n        out = out ++ [seg]\n      }\n    } else {\n      out = out ++ [seg]\n    }\n  }\n  let body = join(out, \"/\")\n  if abs { \"/\" ++ body } else { body }\n}\n\n## `p` resolved against `base` when it is relative, then normalized. `base` is\n## the working directory at the call site -- passed in rather than read here,\n## because reading it is an effect and normalizing is not.\npub fn absolute(base: String, p: String) -> String =\n  if is_absolute(p) { normalize(p) } else { normalize(base ++ \"/\" ++ p) }\n\n## Everything above `p`, or `None` when `p` is a bare name or the root itself.\n## `p` is normalized first, so `a/b/../c` has parent `a`.\npub fn parent(p: String) -> Option[String] = {\n  let n = normalize(p)\n  if n == \"\" || n == \"/\" { return None }\n  match str.last_index_of(n, \"/\") {\n    Some(0) -> Some(\"/\")\n    Some(i) -> Some(str.substring(n, 0, i))\n    None -> None\n  }\n}\n")
  } else if name == "map.dawn" {
    Some("# std/map — the persistent hash map (spec §2.2, §11).\n#\n# Short names, module-qualified at the call site: `use std/map`, then\n# `map.insert(m, k, v)`. Each function forwards to the compiler primitive that\n# owns the representation -- since S3 a pure-Dawn hash trie (std/hamt) rather\n# than a handwritten Java one; the wrappers are what give the operations their\n# public, qualified spelling.\n#\n# Everything that has to find an entry carries `[K: Eq + Hash]`, because\n# finding one means hashing the key and comparing it, and those are the key\n# type's own relations. Counting and listing entries do neither, so they stay\n# unbounded -- reading a map should not ask more of its keys than storing one\n# already did.\n#\n# Key validity (no Float/Bytes anywhere inside the key type) is enforced by the\n# checker at every Map type instantiation, so these wrappers need no checks.\n\n## A map with no entries. The key/value types come from the use site.\npub fn empty[K, V]() -> Map[K, V] = map_empty()\n\n## A map from a list of (key, value) pairs; a repeated key keeps the last value.\npub fn from[K: Eq + Hash, V](entries: List[(K, V)]) -> Map[K, V] = map_from(entries)\n\n## A copy with `key` bound to `value`; an existing key keeps its insertion position.\npub fn insert[K: Eq + Hash, V](m: Map[K, V], key: K, value: V) -> Map[K, V] =\n  map_insert(m, key, value)\n\n## A copy without `key`; absent keys are fine.\npub fn remove[K: Eq + Hash, V](m: Map[K, V], key: K) -> Map[K, V] = map_remove(m, key)\n\n## The value bound to `key`, or `None`.\npub fn get[K: Eq + Hash, V](m: Map[K, V], key: K) -> Option[V] = map_get(m, key)\n\n## Whether `key` is bound.\npub fn has[K: Eq + Hash, V](m: Map[K, V], key: K) -> Bool = map_has(m, key)\n\n## Number of entries.\npub fn size[K, V](m: Map[K, V]) -> Int = map_size(m)\n\n## The keys, in insertion order.\npub fn keys[K, V](m: Map[K, V]) -> List[K] = map_keys(m)\n\n## The values, in insertion order of their keys.\npub fn values[K, V](m: Map[K, V]) -> List[V] = map_values(m)\n\n## The (key, value) pairs, in insertion order.\npub fn entries[K, V](m: Map[K, V]) -> List[(K, V)] = map_entries(m)\n\n# ---- Eq / Hash for Map ----\n#\n# Both are defined on the entries rather than on the structure holding them.\n# A hash trie has no canonical shape: the same entries inserted in a different\n# order, or with a removal in between, are a different tree. Until S3 this was\n# the JVM's business -- `AbstractMap` supplied an order-independent equality\n# that Dawn borrowed and could not state -- and stating it is what let the\n# container become Dawn source (docs/collections-dejava-research.md §3).\n#\n# There is deliberately no `Ord[Map[K, V]]`: entries have no order to compare.\n\nfn eq_go[K: Eq + Hash, V: Eq](b: Map[K, V], es: List[(K, V)], i: Int) -> Bool =\n  if i == len(es) {\n    true\n  } else {\n    let (k, v) = es[i]\n    match get(b, k) {\n      Some(bv) -> if eq(v, bv) { eq_go(b, es, i + 1) } else { false }\n      None -> false\n    }\n  }\n\n## Same size, and every entry of one present with an equal value in the other.\nimpl[K: Eq + Hash, V: Eq] Eq[Map[K, V]] {\n  fn eq(a: Map[K, V], b: Map[K, V]) -> Bool =\n    if size(a) != size(b) { false } else { eq_go(b, entries(a), 0) }\n}\n\nfn hash_go[K: Hash, V: Hash](es: List[(K, V)], i: Int, acc: Int) -> Int =\n  if i == len(es) {\n    acc\n  } else {\n    let (k, v) = es[i]\n    hash_go(es, i + 1, acc + hash(k) * 31 + hash(v))\n  }\n\n## A sum over the entries, so it does not depend on the order they come out\n## in — the same requirement `eq` above is written to.\nimpl[K: Hash, V: Hash] Hash[Map[K, V]] {\n  fn hash(m: Map[K, V]) -> Int = hash_go(entries(m), 0, 0)\n}\n\nfn show_go[K: Show, V: Show](es: List[(K, V)], i: Int, acc: String) -> String =\n  if i == len(es) {\n    acc\n  } else {\n    let (k, v) = es[i]\n    show_go(es, i + 1, acc ++ (if i == 0 { \"\" } else { \", \" }) ++\n        \"(\" ++ show(k) ++ \", \" ++ show(v) ++ \")\")\n  }\n\n## The call that rebuilds it: `map_from([(k, v), ...])`. A map has no literal\n## syntax, so the rendering names the function that does (spec §2.2).\nimpl[K: Show, V: Show] Show[Map[K, V]] {\n  fn show(m: Map[K, V]) -> String = \"map_from([\" ++ show_go(entries(m), 0, \"\") ++ \"])\"\n}\n")
  } else if name == "set.dawn" {
    Some("# std/set — the persistent hash set (spec §2.2, §11).\n#\n# Short names, module-qualified at the call site: `use std/set`, then\n# `set.insert(s, x)`. Forwards to the compiler primitives over the same Dawn\n# hash trie a Map is (std/hamt), exactly like std/map does -- a set is a map to\n# a value nobody reads. Bounds follow the same line: finding an element needs\n# `[T: Eq + Hash]`, counting and listing them do not.\n\n## A set with no elements. The element type comes from the use site.\npub fn empty[T]() -> Set[T] = set_empty()\n\n## A set from a list; duplicates collapse, first occurrence keeps its position.\npub fn from[T: Eq + Hash](xs: List[T]) -> Set[T] = set_from(xs)\n\n## A copy with `x` added; an existing element keeps its insertion position.\npub fn insert[T: Eq + Hash](s: Set[T], x: T) -> Set[T] = set_insert(s, x)\n\n## A copy without `x`; absent elements are fine.\npub fn remove[T: Eq + Hash](s: Set[T], x: T) -> Set[T] = set_remove(s, x)\n\n## Whether `x` is an element.\npub fn has[T: Eq + Hash](s: Set[T], x: T) -> Bool = set_has(s, x)\n\n## Number of elements.\npub fn size[T](s: Set[T]) -> Int = set_size(s)\n\n## The elements, in insertion order.\npub fn to_list[T](s: Set[T]) -> List[T] = set_to_list(s)\n\n# ---- Eq / Hash for Set ----\n#\n# Same reasoning as Map's, which these are: element order is an artifact of\n# insertion, not of the value, so both relations are defined on membership.\n# No `Ord[Set[T]]` for the same reason there is none for Map.\n\nfn eq_go[T: Eq + Hash](b: Set[T], xs: List[T], i: Int) -> Bool =\n  if i == len(xs) {\n    true\n  } else if has(b, xs[i]) {\n    eq_go(b, xs, i + 1)\n  } else {\n    false\n  }\n\n## Same size, and every element of one an element of the other.\nimpl[T: Eq + Hash] Eq[Set[T]] {\n  fn eq(a: Set[T], b: Set[T]) -> Bool =\n    if size(a) != size(b) { false } else { eq_go(b, to_list(a), 0) }\n}\n\nfn hash_go[T: Hash](xs: List[T], i: Int, acc: Int) -> Int =\n  if i == len(xs) { acc } else { hash_go(xs, i + 1, acc + hash(xs[i])) }\n\n## A sum over the elements, order-independent like `eq` above.\nimpl[T: Hash] Hash[Set[T]] {\n  fn hash(s: Set[T]) -> Int = hash_go(to_list(s), 0, 0)\n}\n\nfn show_go[T: Show](xs: List[T], i: Int, acc: String) -> String =\n  if i == len(xs) {\n    acc\n  } else {\n    show_go(xs, i + 1, acc ++ (if i == 0 { \"\" } else { \", \" }) ++ show(xs[i]))\n  }\n\n## `set_from([e0, e1])`, for the same reason a map renders as `map_from`.\nimpl[T: Show] Show[Set[T]] {\n  fn show(s: Set[T]) -> String = \"set_from([\" ++ show_go(to_list(s), 0, \"\") ++ \"])\"\n}\n")
  } else if name == "hamt.dawn" {
    Some("# std/hamt — the persistent hash trie that Map and Set are both built from.\n#\n# A 32-way hash-array-mapped trie with path copying: `assoc` rebuilds the nodes\n# along one root-to-leaf path (at most seven of them) and shares everything\n# else with the version it came from. That is what makes an immutable map cheap\n# enough to pass around, and it is the same shape the handwritten Java DawnMap\n# had — the difference is that this one is Dawn source, so every backend gets\n# it for free (docs/collections-dejava-research.md §5.1).\n#\n# Two things it asks of the language, and nothing else:\n#\n#   * `Array[T]` — the single collection primitive a backend implements\n#     (docs/native-backend-plan.md §10). Node children live in one, and the\n#     bounded copy `array_with` performs is the path copy.\n#   * `Eq[K]` + `Hash[K]` — passed as dictionaries, so which equality decides\n#     \"same key\" is the one the key type declares. Before this, a map compared\n#     keys with the JVM's `Object.equals`, which is only *usually* the same\n#     relation as Dawn's `==`.\n#\n# Insertion order is observable (spec §2.2: `keys`/`entries` are in insertion\n# order), so every leaf carries the monotonic `seq` it was first inserted at,\n# and re-binding a key keeps the old one. Iteration sorts by it.\n#\n# Nothing in std imports this module and nothing should: `Map` and `Set` are\n# builtin type names, and the calls that reach here are the ones lowering\n# writes when it turns a `map_*`/`set_*` primitive into a direct call. That is\n# what keeps it a leaf of the module order.\n\n## One node of the trie. `NColl` holds leaves whose hashes are equal, which is\n## the only case a branch cannot separate.\npub type Node[K, V] =\n  | NEmpty\n  | NLeaf(h: Int, k: K, v: V, seq: Int)\n  | NColl(h: Int, kids: Array[Node[K, V]])\n  | NBranch(bitmap: Int, kids: Array[Node[K, V]])\n\n## A whole map: the trie, how many entries are live in it, and the counter the\n## next insertion takes its position from.\npub type Hamt[K, V] = { root: Node[K, V], count: Int, nseq: Int }\n\nconst BITS: Int = 5\n\nconst MASK: Int = 31\n\n## Hashes are used 32 bits at a time. Masking to the unsigned word costs\n## nothing and buys two things: the shift is unambiguous whatever `>>>` does\n## with a sign bit, and the descent is bounded at seven levels rather than\n## thirteen.\nfn hash32[K: Hash](k: K) -> Int = hash(k) & 4294967295\n\nfn idx_at(h: Int, shift: Int) -> Int = (h >>> shift) & MASK\n\n# ---- small array helpers ----\n#\n# `array_with` replaces in place-ish (a bounded copy); insert and remove change\n# the length, so they rebuild. Both run over <= 32 slots, which is what makes\n# the whole structure's O(log n) a small constant.\n\nfn arr1[T](x: T) -> Array[T] = {\n  let e: Array[T] = array_new()\n  array_push(e, x)\n}\n\nfn arr2[T](x: T, y: T) -> Array[T] = array_push(arr1(x), y)\n\nfn arr_insert[T](a: Array[T], i: Int, x: T) -> Array[T] = {\n  var out: Array[T] = array_new()\n  var j = 0\n  while j < i {\n    out = array_push(out, array_get(a, j))\n    j = j + 1\n  }\n  out = array_push(out, x)\n  while j < array_len(a) {\n    out = array_push(out, array_get(a, j))\n    j = j + 1\n  }\n  out\n}\n\nfn arr_remove[T](a: Array[T], i: Int) -> Array[T] = {\n  var out: Array[T] = array_new()\n  var j = 0\n  while j < array_len(a) {\n    if j != i {\n      out = array_push(out, array_get(a, j))\n    }\n    j = j + 1\n  }\n  out\n}\n\n# ---- lookup ----\n\n## The leaf holding `k`, or `None`. Returning the leaf rather than the value\n## lets `assoc` read the `seq` it must preserve without a second descent.\nfn node_leaf[K: Eq, V](n: Node[K, V], shift: Int, h: Int, k: K) -> Option[Node[K, V]] =\n  match n {\n    NEmpty -> None\n    NLeaf(lh, lk, _, _) -> if lh == h && eq(lk, k) { Some(n) } else { None }\n    NColl(ch, kids) -> if ch == h { coll_leaf(kids, 0, k) } else { None }\n    NBranch(bm, kids) -> {\n      let bit = 1 << idx_at(h, shift)\n      if bm & bit == 0 {\n        None\n      } else {\n        node_leaf(array_get(kids, popcount(bm & (bit - 1))), shift + BITS, h, k)\n      }\n    }\n  }\n\nfn coll_leaf[K: Eq, V](kids: Array[Node[K, V]], i: Int, k: K) -> Option[Node[K, V]] =\n  if i >= array_len(kids) {\n    None\n  } else {\n    let kid = array_get(kids, i)\n    match kid {\n      NLeaf(_, lk, _, _) -> if eq(lk, k) { Some(kid) } else { coll_leaf(kids, i + 1, k) }\n      _ -> coll_leaf(kids, i + 1, k)\n    }\n  }\n\n# ---- insertion ----\n\n## A one-child branch holding `n`, whose own hash prefix is `h`. Used to push a\n## leaf down a level when two hashes agree above the current shift.\nfn branch_of[K, V](n: Node[K, V], h: Int, shift: Int) -> Node[K, V] =\n  NBranch(1 << idx_at(h, shift), arr1(n))\n\n## Bind `k` to `v` at position `seq`. The caller has already decided whether\n## this is a fresh key (and so what `seq` is), which is why nothing here has to\n## report back whether the map grew — the alternative allocates a tuple per\n## level, and the levels are the whole cost of the operation.\nfn node_put[K: Eq, V](\n  n: Node[K, V], shift: Int, h: Int, k: K, v: V, seq: Int\n) -> Node[K, V] =\n  match n {\n    NEmpty -> NLeaf(h, k, v, seq)\n    NLeaf(lh, lk, _, _) ->\n      if lh == h {\n        if eq(lk, k) {\n          NLeaf(h, k, v, seq)\n        } else {\n          NColl(h, arr2(n, NLeaf(h, k, v, seq)))\n        }\n      } else {\n        node_put(branch_of(n, lh, shift), shift, h, k, v, seq)\n      }\n    NColl(ch, kids) ->\n      if ch == h {\n        NColl(ch, coll_put(kids, 0, h, k, v, seq))\n      } else {\n        node_put(branch_of(n, ch, shift), shift, h, k, v, seq)\n      }\n    NBranch(bm, kids) -> {\n      let bit = 1 << idx_at(h, shift)\n      let pos = popcount(bm & (bit - 1))\n      if bm & bit == 0 {\n        NBranch(bm | bit, arr_insert(kids, pos, NLeaf(h, k, v, seq)))\n      } else {\n        let sub = node_put(array_get(kids, pos), shift + BITS, h, k, v, seq)\n        NBranch(bm, array_with(kids, pos, sub))\n      }\n    }\n  }\n\nfn coll_put[K: Eq, V](\n  kids: Array[Node[K, V]], i: Int, h: Int, k: K, v: V, seq: Int\n) -> Array[Node[K, V]] =\n  if i >= array_len(kids) {\n    array_push(kids, NLeaf(h, k, v, seq))\n  } else {\n    match array_get(kids, i) {\n      NLeaf(_, lk, _, _) ->\n        if eq(lk, k) {\n          array_with(kids, i, NLeaf(h, k, v, seq))\n        } else {\n          coll_put(kids, i + 1, h, k, v, seq)\n        }\n      _ -> coll_put(kids, i + 1, h, k, v, seq)\n    }\n  }\n\n# ---- removal ----\n#\n# A branch that loses its last child becomes empty, and one left holding a\n# single leaf collapses into that leaf. Collapsing is safe because a leaf\n# carries its whole hash and `node_leaf` compares all of it, so a leaf is\n# correct at any depth — and without it, deleting from a large map would leave\n# a spine of one-child branches that every later lookup walks.\n\nfn node_del[K: Eq, V](n: Node[K, V], shift: Int, h: Int, k: K) -> Node[K, V] =\n  match n {\n    NEmpty -> n\n    NLeaf(lh, lk, _, _) -> if lh == h && eq(lk, k) { NEmpty } else { n }\n    NColl(ch, kids) ->\n      if ch != h {\n        n\n      } else {\n        let left = coll_del(kids, 0, k)\n        if array_len(left) == 1 { array_get(left, 0) } else { NColl(ch, left) }\n      }\n    NBranch(bm, kids) -> {\n      let bit = 1 << idx_at(h, shift)\n      if bm & bit == 0 {\n        n\n      } else {\n        let pos = popcount(bm & (bit - 1))\n        let sub = node_del(array_get(kids, pos), shift + BITS, h, k)\n        match sub {\n          NEmpty -> {\n            let left = arr_remove(kids, pos)\n            if array_len(left) == 0 {\n              NEmpty\n            } else if array_len(left) == 1 && is_leaf(array_get(left, 0)) {\n              array_get(left, 0)\n            } else {\n              NBranch(bm & (0 - 1 - bit), left)\n            }\n          }\n          _ -> NBranch(bm, array_with(kids, pos, sub))\n        }\n      }\n    }\n  }\n\nfn is_leaf[K, V](n: Node[K, V]) -> Bool =\n  match n {\n    NLeaf(_, _, _, _) -> true\n    _ -> false\n  }\n\nfn coll_del[K: Eq, V](kids: Array[Node[K, V]], i: Int, k: K) -> Array[Node[K, V]] =\n  if i >= array_len(kids) {\n    kids\n  } else {\n    match array_get(kids, i) {\n      NLeaf(_, lk, _, _) -> if eq(lk, k) { arr_remove(kids, i) } else { coll_del(kids, i + 1, k) }\n      _ -> coll_del(kids, i + 1, k)\n    }\n  }\n\n# ---- the map surface ----\n\n## A map with no entries.\npub fn empty[K, V]() -> Hamt[K, V] = Hamt { root: NEmpty, count: 0, nseq: 0 }\n\n## Number of live entries.\npub fn count[K, V](m: Hamt[K, V]) -> Int = m.count\n\n## The value bound to `k`, or `None`.\npub fn get[K: Eq + Hash, V](m: Hamt[K, V], k: K) -> Option[V] =\n  match node_leaf(m.root, 0, hash32(k), k) {\n    Some(leaf) ->\n      match leaf {\n        NLeaf(_, _, v, _) -> Some(v)\n        _ -> None\n      }\n    None -> None\n  }\n\n## The value bound to `k`, panicking when it is absent — what `m[k]` means.\n## Naming the missing key is why this one asks for `Show` and nothing else\n## does.\npub fn index[K: Eq + Hash + Show, V](m: Hamt[K, V], k: K) -> V =\n  match get(m, k) {\n    Some(v) -> v\n    None -> panic(\"key not found: \" ++ show(k))\n  }\n\n## Whether `k` is bound.\npub fn has[K: Eq + Hash, V](m: Hamt[K, V], k: K) -> Bool =\n  match node_leaf(m.root, 0, hash32(k), k) {\n    Some(_) -> true\n    None -> false\n  }\n\n## A copy with `k` bound to `v`. A key already present keeps the position it\n## was first inserted at, which is what makes iteration order stable under\n## rebinding (spec §2.2).\n# The fields come out into bindings before the update is built: after the\n# last of these reads nothing touches `m`, so a caller that handed over its\n# only reference gets the map released *before* `node_put` runs -- which is\n# what lets the spine be rewritten in place instead of path-copied\n# (perceus-design.md 6). Written `..m`-style, `m` survives to the end of the\n# expression and pins the whole spine at rc 2.\npub fn assoc[K: Eq + Hash, V](m: Hamt[K, V], k: K, v: V) -> Hamt[K, V] = {\n  let h = hash32(k)\n  let root = m.root\n  let count = m.count\n  let nseq = m.nseq\n  match node_leaf(root, 0, h, k) {\n    Some(leaf) -> {\n      let s = leaf_seq(leaf)\n      Hamt { root: node_put(root, 0, h, k, v, s), count: count, nseq: nseq }\n    }\n    None ->\n      Hamt {\n        root: node_put(root, 0, h, k, v, nseq),\n        count: count + 1,\n        nseq: nseq + 1\n      }\n  }\n}\n\nfn leaf_seq[K, V](n: Node[K, V]) -> Int =\n  match n {\n    NLeaf(_, _, _, s) -> s\n    _ -> 0 - 1\n  }\n\n## A copy without `k`; absent keys are fine.\n# Field bindings before the rebuild, for assoc's reason.\npub fn dissoc[K: Eq + Hash, V](m: Hamt[K, V], k: K) -> Hamt[K, V] = {\n  let h = hash32(k)\n  let root = m.root\n  let count = m.count\n  let nseq = m.nseq\n  match node_leaf(root, 0, h, k) {\n    # `m` itself: on this path it is the arm's value, and on the other path\n    # it is dead before `node_del` runs -- per-path accounting keeps both\n    None -> m\n    Some(_) -> Hamt { root: node_del(root, 0, h, k), count: count - 1, nseq: nseq }\n  }\n}\n\n# ---- iteration ----\n#\n# Leaves come out of the trie in hash order, which is not insertion order, so\n# the walk collects `(seq, key, value)` and sorts. The sort is why `seq` is on\n# every leaf rather than kept in a side list: a side list would have to be\n# rewritten on every removal, and removals are rare while lookups are not.\n\nfn walk[K, V](n: Node[K, V], acc: List[(Int, K, V)]) -> List[(Int, K, V)] =\n  match n {\n    NEmpty -> acc\n    NLeaf(_, k, v, s) -> acc ++ [(s, k, v)]\n    NColl(_, kids) -> walk_kids(kids, 0, acc)\n    NBranch(_, kids) -> walk_kids(kids, 0, acc)\n  }\n\nfn walk_kids[K, V](kids: Array[Node[K, V]], i: Int, acc: List[(Int, K, V)]) -> List[(Int, K, V)] =\n  if i >= array_len(kids) {\n    acc\n  } else {\n    walk_kids(kids, i + 1, walk(array_get(kids, i), acc))\n  }\n\nfn by_seq[K, V](a: (Int, K, V), b: (Int, K, V)) -> Int = {\n  let (sa, _, _) = a\n  let (sb, _, _) = b\n  if sa < sb { 0 - 1 } else if sa > sb { 1 } else { 0 }\n}\n\nfn ordered[K, V](m: Hamt[K, V]) -> List[(Int, K, V)] = {\n  let empty_acc: List[(Int, K, V)] = []\n  sort_by(walk(m.root, empty_acc), fn(a, b) => by_seq(a, b))\n}\n\n## The (key, value) pairs, in insertion order.\npub fn entries[K, V](m: Hamt[K, V]) -> List[(K, V)] = {\n  var out: List[(K, V)] = []\n  for e in ordered(m) {\n    let (_, k, v) = e\n    out = out ++ [(k, v)]\n  }\n  out\n}\n\n## The keys, in insertion order.\npub fn keys[K, V](m: Hamt[K, V]) -> List[K] = {\n  var out: List[K] = []\n  for e in ordered(m) {\n    let (_, k, _) = e\n    out = out ++ [k]\n  }\n  out\n}\n\n## The values, in insertion order of their keys.\npub fn values[K, V](m: Hamt[K, V]) -> List[V] = {\n  var out: List[V] = []\n  for e in ordered(m) {\n    let (_, _, v) = e\n    out = out ++ [v]\n  }\n  out\n}\n\n## A map from a list of pairs; a repeated key keeps the last value and the\n## first position.\npub fn from[K: Eq + Hash, V](es: List[(K, V)]) -> Hamt[K, V] = {\n  var m: Hamt[K, V] = empty()\n  for e in es {\n    let (k, v) = e\n    m = assoc(m, k, v)\n  }\n  m\n}\n\n# ---- the set surface ----\n#\n# A set is a map to a value nobody reads, which is how DawnSet related to\n# DawnMap as well. Only the two operations whose shape differs need a name of\n# their own — `has`, `dissoc`, `count` and `keys` already do for a set exactly\n# what a set wants.\n\n## A copy with `x` added; an existing element keeps its position.\npub fn sadd[T: Eq + Hash](s: Hamt[T, Bool], x: T) -> Hamt[T, Bool] = assoc(s, x, true)\n\n## A set from a list; duplicates collapse onto the first occurrence.\npub fn sfrom[T: Eq + Hash](xs: List[T]) -> Hamt[T, Bool] = {\n  var s: Hamt[T, Bool] = empty()\n  for x in xs {\n    s = sadd(s, x)\n  }\n  s\n}\n")
  } else if name == "pvec.dawn" {
    Some("# std/pvec — the persistent vector behind List.\n#\n# A 32-way trie with a tail buffer: Clojure's PersistentVector, which is what\n# \"strict RB\" means in docs/collections-dejava-research.md §5.3. The last\n# (partial) block of elements lives in `tail`, an `Array` of at most 32 slots;\n# everything before it lives in a trie whose leaves are the same shape. An\n# append copies the tail — bounded work — and every 32nd one also pushes the\n# full tail into the trie, copying one root-to-leaf path.\n#\n# Why this and not the flat shared-array window it replaces: the window is\n# O(1) to append to only while one version owns the frontier, and O(n) to copy\n# the moment two versions want it. That is fine on a backend that can hand out\n# a mutable array and track who owns it — the JVM one did, with a CAS\n# watermark — but it is not something Dawn source can express, and a second\n# backend would have to reimplement it. Here the sharing is structural, so\n# both backends get it from the same source (docs/native-backend-plan.md §10).\n#\n# The one thing it still asks of the backend is that `array_push` extend in\n# place when the array it is given ends where the shared region ends. That is\n# exactly the accumulation shape — `out = out ++ [x]` — and it is what keeps\n# an append a constant-size copy rather than 32 slots every time.\n#\n# Nothing in std imports this module: `List` is a builtin type name, and the\n# calls that arrive here are the ones lowering writes for a list primitive.\n\nconst BITS: Int = 5\n\nconst WIDTH: Int = 32\n\nconst MASK: Int = 31\n\n## A trie node. Leaves hold elements, branches hold nodes, and both are one\n## `Array` of at most 32 slots — the shape that makes a path copy bounded.\npub type VNode[T] =\n  | VLeaf(items: Array[T])\n  | VBranch(kids: Array[VNode[T]])\n\n## A whole vector: how many elements, how deep the trie is, the trie, and the\n## unfinished last block.\npub type Vec[T] = { cnt: Int, shift: Int, root: VNode[T], tail: Array[T] }\n\n# ---- small array helpers ----\n\nfn arr1[T](x: T) -> Array[T] = {\n  let e: Array[T] = array_new()\n  array_push(e, x)\n}\n\nfn arr2[T](x: T, y: T) -> Array[T] = array_push(arr1(x), y)\n\nfn arr_slice[T](a: Array[T], from: Int, to: Int) -> Array[T] = {\n  var out: Array[T] = array_new()\n  var i = from\n  while i < to {\n    out = array_push(out, array_get(a, i))\n    i = i + 1\n  }\n  out\n}\n\n# ---- shape ----\n\n## Where the tail starts: everything at or after this index is in `tail`.\nfn tail_off(cnt: Int) -> Int = if cnt < WIDTH { 0 } else { ((cnt - 1) >>> BITS) << BITS }\n\n## The block holding element `i`. For any vector of fewer than 32 elements this\n## is the tail and costs nothing — which is most lists in most programs, and\n## the reason an index cursor stays cheap.\nfn leaf_for[T](v: Vec[T], i: Int) -> Array[T] =\n  if i >= tail_off(v.cnt) {\n    v.tail\n  } else {\n    var node = v.root\n    var level = v.shift\n    while level > 0 {\n      node = match node {\n        VBranch(kids) -> array_get(kids, (i >>> level) & MASK)\n        VLeaf(_) -> node\n      }\n      level = level - BITS\n    }\n    match node {\n      VLeaf(items) -> items\n      VBranch(_) -> panic(\"pvec: branch where a leaf belongs\")\n    }\n  }\n\n# ---- construction ----\n\n## A vector with no elements.\npub fn empty[T]() -> Vec[T] = {\n  let e: Array[VNode[T]] = array_new()\n  let t: Array[T] = array_new()\n  Vec { cnt: 0, shift: BITS, root: VBranch(e), tail: t }\n}\n\n## Number of elements.\npub fn count[T](v: Vec[T]) -> Int = v.cnt\n\nfn new_path[T](level: Int, node: VNode[T]) -> VNode[T] =\n  if level == 0 { node } else { VBranch(arr1(new_path(level - BITS, node))) }\n\n## Fold a full tail into the trie, copying the one path that changes.\nfn push_tail[T](cnt: Int, level: Int, parent: VNode[T], tail: Array[T]) -> VNode[T] =\n  match parent {\n    VLeaf(_) -> VLeaf(tail)\n    VBranch(kids) -> {\n      let sub = ((cnt - 1) >>> level) & MASK\n      if level == BITS {\n        if sub < array_len(kids) {\n          VBranch(array_with(kids, sub, VLeaf(tail)))\n        } else {\n          VBranch(array_push(kids, VLeaf(tail)))\n        }\n      } else if sub < array_len(kids) {\n        VBranch(array_with(kids, sub,\n          push_tail(cnt, level - BITS, array_get(kids, sub), tail)))\n      } else {\n        VBranch(array_push(kids, new_path(level - BITS, VLeaf(tail))))\n      }\n    }\n  }\n\n## A copy with `x` appended.\npub fn push[T](v: Vec[T], x: T) -> Vec[T] =\n  if array_len(v.tail) < WIDTH {\n    Vec { ..v, cnt: v.cnt + 1, tail: array_push(v.tail, x) }\n  } else if (v.cnt >>> BITS) > (1 << v.shift) {\n    # the trie is full at this depth: grow a level, with the old root beside a\n    # fresh path down to the tail that just came off\n    Vec {\n      cnt: v.cnt + 1,\n      shift: v.shift + BITS,\n      root: VBranch(arr2(v.root, new_path(v.shift, VLeaf(v.tail)))),\n      tail: arr1(x)\n    }\n  } else {\n    Vec {\n      cnt: v.cnt + 1,\n      shift: v.shift,\n      root: push_tail(v.cnt, v.shift, v.root, v.tail),\n      tail: arr1(x)\n    }\n  }\n\n# ---- reading ----\n#\n# One unchecked reader, private, and every public way in checks first. It was\n# the other way round until 2026-07-30: `nth` was `pub` and did no checking,\n# so `nth(v, 70)` on a 64-element vector answered `38` rather than failing --\n# `i & MASK` folds an out-of-range index back onto a legal slot in whichever\n# block `leaf_for` picked. That is the \"illegal input, silently wrong answer\"\n# shape, and spec 9.8 says an out-of-range index is a panic\n# (docs/audit/re-audit-2026-07-30.md RD-01).\n\n## Element `i`, whose range the caller has already established. Out of range\n## this answers with some other element rather than failing, which is why it\n## is not `pub`.\nfn at[T](v: Vec[T], i: Int) -> T = array_get(leaf_for(v, i), i & MASK)\n\n## Element `i`, panicking out of range — what `xs[i]` means.\npub fn index[T](v: Vec[T], i: Int) -> T =\n  if i < 0 || i >= v.cnt {\n    panic(\"index \" ++ to_string(i) ++ \" out of bounds for length \" ++ to_string(v.cnt))\n  } else {\n    at(v, i)\n  }\n\n## Element `i`, panicking out of range. The name Clojure gives the checked\n## accessor, and the same function `index` is: the comparison it costs is\n## nothing beside `leaf_for`, so there is no unchecked public reader to make\n## the saving worth a wrong answer.\npub fn nth[T](v: Vec[T], i: Int) -> T = index(v, i)\n\n## Element `i`, or `None` when it is out of range.\npub fn get[T](v: Vec[T], i: Int) -> Option[T] =\n  if i < 0 || i >= v.cnt { None } else { Some(at(v, i)) }\n\n# ---- bulk ----\n#\n# These walk by block rather than by index: `leaf_for` is cheap but not free,\n# and asking it once per 32 elements instead of once per element is what keeps\n# a copy linear with a small constant.\n\nfn each_block[T, A](v: Vec[T], i: Int, acc: A, f: fn(A, T) -> A !e) -> A !e =\n  if i >= v.cnt {\n    acc\n  } else {\n    let blk = leaf_for(v, i)\n    let base = i - (i & MASK)\n    let stop = if base + array_len(blk) < v.cnt { base + array_len(blk) } else { v.cnt }\n    each_block(v, stop, fold_block(blk, i - base, stop - base, acc, f), f)\n  }\n\nfn fold_block[T, A](blk: Array[T], i: Int, stop: Int, acc: A, f: fn(A, T) -> A !e) -> A !e =\n  if i >= stop { acc } else { fold_block(blk, i + 1, stop, f(acc, array_get(blk, i)), f) }\n\n## Every element in order, as one flat array.\npub fn to_array[T](v: Vec[T]) -> Array[T] = {\n  let e: Array[T] = array_new()\n  each_block(v, 0, e, fn(a, x) => array_push(a, x))\n}\n\n## A vector holding `a`'s elements in order.\npub fn of_array[T](a: Array[T]) -> Vec[T] = {\n  var v: Vec[T] = empty()\n  var i = 0\n  while i < array_len(a) {\n    v = push(v, array_get(a, i))\n    i = i + 1\n  }\n  v\n}\n\n## `a` then `b`. Linear in `b`, which is the shape `++` is used in: the right\n## side is almost always a single element being accumulated.\npub fn concat[T](a: Vec[T], b: Vec[T]) -> Vec[T] =\n  if b.cnt == 0 { a } else { each_block(b, 0, a, fn(v, x) => push(v, x)) }\n\n## The elements in `[from, to)`; the caller has already clamped the ends.\npub fn slice[T](v: Vec[T], from: Int, to: Int) -> Vec[T] = {\n  var out: Vec[T] = empty()\n  var i = from\n  while i < to {\n    out = push(out, at(v, i))\n    i = i + 1\n  }\n  out\n}\n\n## `[from, to)` as a vector of Ints.\npub fn range(from: Int, to: Int) -> Vec[Int] = {\n  var out: Vec[Int] = empty()\n  var i = from\n  while i < to {\n    out = push(out, i)\n    i = i + 1\n  }\n  out\n}\n\n# ---- sorting ----\n#\n# A merge sort on the flat array, because a sort is the one bulk operation\n# that reads by position over and over: paying `leaf_for` per comparison would\n# put the trie in the inner loop. Stable, since a tie takes from the left.\n\nfn merge[T](a: Array[T], b: Array[T], cmp: fn(T, T) -> Int !e) -> Array[T] !e = {\n  var out: Array[T] = array_new()\n  var i = 0\n  var j = 0\n  while i < array_len(a) && j < array_len(b) {\n    let x = array_get(a, i)\n    let y = array_get(b, j)\n    if cmp(y, x) < 0 {\n      out = array_push(out, y)\n      j = j + 1\n    } else {\n      out = array_push(out, x)\n      i = i + 1\n    }\n  }\n  while i < array_len(a) {\n    out = array_push(out, array_get(a, i))\n    i = i + 1\n  }\n  while j < array_len(b) {\n    out = array_push(out, array_get(b, j))\n    j = j + 1\n  }\n  out\n}\n\nfn msort[T](a: Array[T], cmp: fn(T, T) -> Int !e) -> Array[T] !e = {\n  let n = array_len(a)\n  if n <= 1 {\n    a\n  } else {\n    let mid = n / 2\n    merge(msort(arr_slice(a, 0, mid), cmp), msort(arr_slice(a, mid, n), cmp), cmp)\n  }\n}\n\n## Stable ascending sort by `cmp`.\npub fn sort_by[T](v: Vec[T], cmp: fn(T, T) -> Int !e) -> Vec[T] !e =\n  of_array(msort(to_array(v), cmp))\n")
  } else {
    None
  }

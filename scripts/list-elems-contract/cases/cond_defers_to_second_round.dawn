# A conditional element whose bodies all need an expectation is checked in the
# second round, and takes the element type from a sibling written *after* it.
# Unannotated for the reason spread_defers_to_second_round is.
fn f(c: Bool) -> Int = {
  let out = [if c { None }, Some(1)]
  len(out)
}

pub fn main() -> Unit = ()

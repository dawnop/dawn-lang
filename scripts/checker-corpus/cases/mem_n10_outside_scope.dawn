# checker.dawn: N10. A buffer made outside `with_mem` has nobody to answer the
# allocation, and the existing unhandled-effect diagnostic says so. No new rule
# is involved; the case is here so the boundary of the built-in rules is on
# record next to the others.
use std/mem

pub fn outside() -> Int = len(mem.new(4))

pub fn outside_read(b: I64Buf) -> Int = mem.at(b, 0)

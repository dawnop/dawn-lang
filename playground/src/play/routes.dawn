# The runner's four routes as functions of the request body. A handler
# returns a `Reply`, status and body text, and play/serve.dawn puts it on the
# wire. They were written as a module of their own when the runner had two
# entries (the long-lived `web` server and one request per process) so that
# the two could not drift apart in what they answered; the long-lived one is
# gone (K5 of docs/playground-native-runner-design.md) and the split stays,
# because it keeps the routes pure functions of the body and a `Host`.
#
# Why this module imports nothing from `web`: the runner is built natively and
# the package's server is not (play/http1 says why, and what changes that).
# Nor does anything below it:
# the heavy part of a request is a `Job` handed to a `Host` (play/host), whose
# flock gate is play/gate. Timing is the `Clock` effect through play/exec.
use std/bytes
use std/str
use std/io
use std/io.{Instant}
use play/contract.{Compiled, parse_request, parse_compile_request, wants_tileir, render_outcome, render_check, render_error, render_health}
use play/exec.{CompilerId, tile_ready, native_ready, tool_present, tick, ms_since, TileRaw, TileMapped, TilePlain}
use play/config.{javap_bin}
use play/view.{build_view, build_c_view, respond, cache_key, compile_key, Viewed, CShown, Mapped, Done, tile_view, tile_mapped, Tiled, TileShown, TileFailed}
use play/host.{Host, JobResult, JRun, JCheck, JCView, JView, JTile, JOutcome, JCViewRaw, JViewRaw, JTileRaw, JBroken}

pub type Reply = { status: Int, body: String }

# Every reply is JSON; the content type is the entry point's to state, so the
# argument stays only to keep the call sites reading like the web framework's `raw`.
fn raw(status: Int, _content_type: String, body: String) -> Reply = Reply { status = status, body = body }

const MAX_BODY: Int = 65536
pub const JSON_CT: String = "application/json; charset=utf-8"
const QUEUE_WAIT_SECS: Int = 15
# Editor diagnostics are advisory: don't queue behind runs, fail fast so the
# client just keeps its previous squiggles and retries on the next pause.
const CHECK_WAIT_SECS: Int = 2
# The compile view is advisory in the same way, and shares the same two
# permits (play/gate's slots): a second pool for it would double the compilers
# the host runs at once, and nobody would be counting them.
const COMPILE_WAIT_SECS: Int = CHECK_WAIT_SECS

# JSON since the editor started showing the compiler version; deploy checks
# only look at the status (curl -f).
pub fn health(id: CompilerId) -> Reply =
  raw(200, JSON_CT, render_health(id.version, id.build))

# Shared core of /run and /check: same body parsing and gate, different
# executor and queue patience. The wire format predates the framework, so
# errors are rendered into the contract's own JSON shapes (via raw), not the
# framework's Err branch.
pub fn rpc(body: Bytes, host: Host, check_only: Bool, native: Bool, toolchain: String) -> Reply !io =
  # bytes, not code points: str.len counts characters, so a program written in
  # CJK got up to three times the stated budget
  if len(body) > MAX_BODY {
    raw(413, JSON_CT, render_error("source exceeds ${MAX_BODY} bytes"))
  } else {
    # body_text refuses a malformed body; render the refusal in the contract's
    # own error shape like every other refusal here, not the framework's
    match bytes.decode_utf8_checked(body) {
      Err(e) -> raw(400, JSON_CT, render_error("request body is not valid UTF-8 (offset ${e.offset})"))
      Ok(source) -> match parse_request(source) {
        Err(msg) -> raw(400, JSON_CT, render_error(msg))
        Ok(code) ->
          if check_only {
            run_job(host, code, true, native, "")
          } else {
            # A sample answer the deploy computed (play/answers), or the job.
            let key = "${cache_key(toolchain, code)}/run"
            match host.keep_get(key) {
              Some(line) -> serve_kept("", "run", tick(), line)
              None -> run_job(host, code, false, native, key)
            }
          }
      }
    }
  }

# The host holds a permit across the job only and releases it however the job
# ends, then we render outside the permit. None = saturated. A /run answer is
# offered to the host's answer store (`key`, empty for /check) only when the
# program ran: a compile error or a timeout is not an answer worth keeping.
fn run_job(host: Host, code: String, check_only: Bool, native: Bool, key: String) -> Reply !io = {
  let wait = if check_only { CHECK_WAIT_SECS } else { QUEUE_WAIT_SECS }
  match host.call(wait, if check_only { JCheck(code, native) } else { JRun(code) }) {
    Some(JOutcome(outcome)) -> {
      let body = if check_only { render_check(outcome) } else { render_outcome(outcome) }
      match outcome {
        Compiled(_, _, _, _) -> if key != "" { host.keep_put(key, kept_line(200, "R", body)) }
        _ -> ()
      }
      raw(200, JSON_CT, body)
    }
    Some(other) -> failed(other)
    None -> raw(429, JSON_CT, render_error("server busy, try again shortly"))
  }
}

# A job that came back as something its route did not ask for, or did not come
# back: the runner's own fault, so a 500.
fn failed(r: JobResult) -> Reply =
  match r {
    JBroken(m) -> raw(500, JSON_CT, render_error("internal error: ${m}"))
    _ -> raw(500, JSON_CT, render_error("internal error: the job answered another kind of result"))
  }

# What /compile needs to know of the machine it runs on, asked once at start.
pub type View = { toolchain: String, build: String, javap: Bool, tile: Bool, native: Bool }

# The answer store's lines: "<status>:<kind>:" and then the text. A kind is `S`,
# the program's part of a success answer (the head is written per request),
# `F`, an answer that is complete as kept, or `R`, a /run answer that is
# complete as kept and goes out with `"cached":true` added as its last member
# (a live /run answer has no such member, so a hit and a live answer differ in
# that member, and in `ms` as any two runs do, and in nothing else).
fn kept_line(status: Int, kind: String, text: String) -> String = "${status}:${kind}:${text}"

fn serve_kept(build: String, target: String, started: Instant, line: String) -> Reply !io =
  match str.split_once(line, ":") {
    None -> raw(500, JSON_CT, render_error("the compile view's cache holds a line it cannot read"))
    Some((status, rest)) -> match str.split_once(rest, ":") {
      None -> raw(500, JSON_CT, render_error("the compile view's cache holds a line it cannot read"))
      Some((kind, text)) ->
        if kind == "S" {
          raw(200, JSON_CT, respond(target, build, true, ms_since(started), text))
        } else if kind == "R" {
          raw(200, JSON_CT, mark_cached(text))
        } else {
          raw(parse_int(status).unwrap_or(500), JSON_CT, text)
        }
    }
  }

# A rendered JSON object with `"cached":true` as its last member.
fn mark_cached(body: String) -> String = str.take(body, len(body) - 1) ++ ",\"cached\":true}"

test "a kept /run answer gains cached as its last member and nothing else" {
  let live = "{\"ok\":true,\"phase\":\"run\",\"exit\":0,\"output\":\"hi\\n\",\"truncated\":false,\"ms\":7}"
  assert mark_cached(live) == "{\"ok\":true,\"phase\":\"run\",\"exit\":0,\"output\":\"hi\\n\",\"truncated\":false,\"ms\":7,\"cached\":true}"
}

# Refuse unavailable capabilities before looking up an answer: an old answer
# cannot pretend the machine still has the target's toolchain.
pub fn unavailable(view: View, target: String) -> Option[Reply] =
  if target == "c" && view.build == "" {
    Some(raw(503, JSON_CT, render_error("the C view is unavailable: native toolchain metadata unavailable")))
  } else if target == "c" && not view.native {
    Some(raw(503, JSON_CT, render_error("the C view is unavailable: matching native dawnc unavailable")))
  } else if target == "jvm" && not view.javap {
    Some(raw(503, JSON_CT, render_error("the JVM view is unavailable: this server has no javap (it needs a JDK, not only a JRE)")))
  } else { None }

# POST /compile: the program's C text or JVM listing, paired with the source
# (packages/xmap). Same body limit, same JSON refusals and same gate as /check;
# the work is play/exec.view_raw's and the answer is play/view.dawn's.
pub fn compile_rpc(body: Bytes, host: Host, id: CompilerId) -> Reply !io =
  if len(body) > MAX_BODY {
    raw(413, JSON_CT, render_error("source exceeds ${MAX_BODY} bytes"))
  } else {
    match bytes.decode_utf8_checked(body) {
      Err(e) -> raw(400, JSON_CT, render_error("request body is not valid UTF-8 (offset ${e.offset})"))
      Ok(source) -> match parse_compile_request(source) {
        Err(msg) -> raw(400, JSON_CT, render_error(msg))
        Ok((code, target)) -> {
          let view = view_here(id, target)
          if target == "tile" {
            tile_ir(host, view, code)
          } else {
            match unavailable(view, target) {
              Some(refusal) -> refusal
              None -> compile_view(host, view, code, target)
            }
          }
        }
      }
    }
  }

# target "tile": the program's output, which is its Tile IR (play/exec.dawn,
# the Tile IR view). The program must import tileir, which the page also
# checks and the server checks again; it runs under /run's limits and one of
# the same two permits, with /check's patience, because the pane is advisory.
fn tile_ir(host: Host, view: View, code: String) -> Reply !io =
  if not wants_tileir(code) {
    raw(400, JSON_CT, render_error("the Tile IR view needs a program that imports tileir (add a line such as `use tileir/dev.{Dev}`)"))
  } else if not view.tile {
    raw(503, JSON_CT, render_error("the Tile IR view is unavailable: this server has no packages/tileir"))
  } else {
    let started = tick()
    let key = "${cache_key(view.toolchain, code)}/tile"
    match host.keep_get(key) {
      Some(line) -> serve_kept(view.build, "tile", started, line)
      None ->
        match host.call(COMPILE_WAIT_SECS, JTile(code, view.native)) {
          None -> raw(429, JSON_CT, render_error("server busy, try again shortly"))
          Some(JTileRaw(made)) -> match tiled(code, made) {
            TileFailed(status, body) -> raw(status, JSON_CT, body)
            TileShown(rest) -> {
              host.keep_put(key, kept_line(200, "S", rest))
              raw(200, JSON_CT, respond("tile", view.build, false, ms_since(started), rest))
            }
          }
          Some(other) -> failed(other)
        }
    }
  }

# The Tile IR view's answer from what the job came to: the kernel's pairing as
# a view of its own, or the program's output as the pane.
fn tiled(code: String, raw: TileRaw) -> Tiled =
  match raw {
    TileMapped(map, golden, _ms) -> tile_mapped(code, map, golden)
    TilePlain(outcome, why) -> tile_view(outcome, why)
  }

fn compile_view(host: Host, view: View, code: String, target: String) -> Reply !io = {
  let started = tick()
  let key = compile_key(target, view.toolchain, code)
  match host.keep_get(key) {
    Some(line) -> serve_kept(view.build, target, started, line)
    None -> {
      let built = match host.call(COMPILE_WAIT_SECS, if target == "c" { JCView(code) } else { JView(code, view.native) }) {
        None -> return raw(429, JSON_CT, render_error("server busy, try again shortly"))
        Some(JCViewRaw(parts)) -> if target == "c" { build_c_view(code, parts) } else { return failed(JBroken("wrong target result")) }
        Some(JViewRaw(parts)) -> if target == "jvm" { build_view(code, parts) } else { return failed(JBroken("wrong target result")) }
        Some(other) -> return failed(other)
      }
      mapped(host, view, target, key, started, built)
    }
  }
}

# Rendering happens outside the permit. Only the requested target's schema
# receives an answer, even when the paired oracle built both panes.
fn mapped(host: Host, view: View, target: String, key: String, started: Instant, built: Viewed) -> Reply !io =
  match built {
    CShown(rest, gaps) -> shown(host, view, target, key, started, rest, gaps)
    Mapped(_c, jvm, gaps) -> shown(host, view, target, key, started, jvm, gaps)
    Done(status, body, keep) -> {
      if keep { host.keep_put(key, kept_line(status, "F", body)) }
      raw(status, JSON_CT, body)
    }
  }

fn shown(host: Host, view: View, target: String, key: String, started: Instant, rest: String, gaps: Int) -> Reply !io = {
  if gaps > 0 { io.eprintln("compile view: ${gaps} gap(s) in program ${str.take(key, 12)}") }
  host.keep_put(key, kept_line(200, "S", rest))
  raw(200, JSON_CT, respond(target, view.build, false, ms_since(started), rest))
}

## Target-specific capability context. C neither looks for javap nor probes
## the JVM toolchain; its id must come from validated deployment metadata.
pub fn view_here(id: CompilerId, target: String) -> View !io = {
  let canonical = "${id.version} ${id.build}"
  let javap = target != "c" && tool_present(javap_bin())
  View {
    toolchain = if target == "c" { canonical } else { "${canonical} ${if javap { "present" } else { "" }}" },
    build = id.build,
    javap = javap,
    tile = target == "tile" && tile_ready(),
    native = (target != "c" || id.build != "") && native_ready(id),
  }
}

test "without javap the view is refused with a 503 that says why" {
  let view = View { toolchain = "", build = "", javap = false, tile = false, native = false }
  match unavailable(view, "jvm") {
    Some(r) -> {
      assert r.status == 503
      assert str.contains(r.body, "javap")
    }
    None -> { assert false }
  }
  let with_javap = View { toolchain = "", build = "", javap = true, tile = false, native = false }
  assert match unavailable(with_javap, "jvm") { Some(_) -> false, None -> true }
}

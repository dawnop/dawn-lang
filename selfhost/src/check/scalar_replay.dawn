# Exercise cross-revision admission at the real scheduler boundary before
# general queries have reconstructible local contexts. This deliberately
# producer has primitive scalar bodies and a separate integer-valued bounded
# trait-call class with fresh entry, substitution and dictionary proofs.
# Unsupported bodies stay cold. Body-cache-enabled sessions opt into this executor.
use std/map
use std/set
use check/checker
use check/checker.{ModuleHeaders, ModuleBodies, BodyExecutor}
use check/cx.{Cx, Frame, cx_new}
use check/types.{Ty, TyInt, TyFloat, TyBool, TyUnit, TyError, TyVar, Sig, Sym, Eff, EffVar, EPure, EIo}
use check/tast.{TFun, tex_ty}
use check/body_execution
use check/body_execution.{Recorded, Saved, SavedFunction, FunctionInput, FunctionDecision, ReplayDecisions, Checked, Install}
use check/body_product
use check/body_product.{Product, BodyProduct, Change}
use check/identity
use check/identity.{ModuleKey, DeclKey}
use check/allocation
use check/scalar_shape
use check/bounded_replay
use check/function_entry_proof
use check/write_journal.{SymbolKey, BoundsKey, SignatureKey}
use check/source_projection
use check/source_snapshot
use check/source_snapshot.{Snapshot}
use check/callee_index
use check/body_admit.{View}
use check/semantic_reads
use check/semantic_reads.{AssignableType, FunctionRead, BuiltinTypeAnswer,
  ScopedTypeParameter, ScopedEffectVariable }
use check/query_runtime
use front/ast.{FnDecl, DFn}

## What one replay pass did with the candidate revision's declarations.
## `checked` is the two cold columns added up and is kept because it is what
## a caller that only wants "how much was not reused" asks for.
pub(pkg) type Replayed = { bodies: ModuleBodies, checked: Int, reused: Int,
  cold_unadmitted: Int, cold_rejected: Int }

## The next cache contains only products captured in this execution. Visits
## count both hits and cold callbacks; capture refusal only affects the next
## revision, never the correctness of the current result.
pub(pkg) type Renewed = { replayed: Replayed, admitted: Admitted,
  visited: Int, capture_refused: Int }

## The three ways a declaration leaves this pass, counted apart because they
## answer different questions. `reused` came back from the recording.
## `cold_unadmitted` is a declaration this producer never claimed: one of the
## four categories it does not implement, or a function whose header, identity
## or bytes put it outside the class. `cold_rejected` is a claim the candidate
## revision withdrew: the body was admitted and paired, and then one of the
## facts it recorded stopped holding. The first cold column measures how
## narrow the class is, the second how far the environment moved, and only the
## second is what better validation can shrink. One `checked` could not be
## read for either.
type Counts = { reused: Int, cold_unadmitted: Int, cold_rejected: Int }

## Why one declaration was not reused. The product travels with the verdict so
## that the caller does not have to ask a second time what `candidate` already
## decided.
type Verdict = Reused(product: Product) | Unadmitted | Rejected

## One candidate revision's verdicts on the facts its recorded bodies logged.
## The key is the recorded fact itself, because a fact is a query and the
## answer that query returned in one value: two bodies that recorded the same
## fact are asking the same question, and a fact whose answer moved is a
## different key rather than a stale entry under an old one. A key pair of
## declaration and log position would share nothing, which is the whole point
## of holding this per revision instead of per body.
alias Memo = query_runtime.Engine[FunctionRead, Option[Bool]]

fn new_memo() -> Memo = query_runtime.new((a, b) => a == b)

## One saved body, with every admission question the recorded revision can
## answer on its own already answered. The candidate revision cannot change
## any of these, so they are settled once beside the recording rather than
## once per replay per body.
type Prior = { syntax: FnDecl, signature: Sig, product: Product, declaration: Int,
  binders: List[String], symbols: Map[Int, Sym], bounded: Bool }

type Ready = { headers: allocation.Table, source: Snapshot, entries: Map[DeclKey, Prior] }
type AdmittedData = { scope: ModuleKey, ready: Option[Ready] }

## A recorded revision prepared for replay. The representation stays private
## because the pairing is the guarantee: the snapshot inside is the one whose
## headers produced these products, and no caller can substitute another.
pub opaque type Admitted = AdmittedData

type Prepared = { scope: ModuleKey, ready: Ready,
  candidates: Map[Int, (DeclKey, Int)], callees: callee_index.CalleeIndex,
  old_tokens: source_projection.Tokens, tokens: source_projection.Tokens,
  memo: Memo }

## What the replay pass carries from one declaration to the next: the tally
## the caller gets back, and the preparation of the candidate revision. The
## preparation is threaded rather than captured beside the executor because
## the memo inside it grows as bodies are revalidated, and a body that is
## refused still leaves its work there for the next one.
type Pass = { counts: Counts, prepared: Option[Prepared] }

fn zero_counts() -> Counts = Counts { reused: 0, cold_unadmitted: 0, cold_rejected: 0 }

fn reused(state: Pass) -> Pass =
  Pass { ..state, counts: Counts { ..state.counts, reused: state.counts.reused + 1 } }

fn unadmitted(state: Pass) -> Pass =
  Pass { ..state, counts: Counts { ..state.counts, cold_unadmitted: state.counts.cold_unadmitted + 1 } }

fn rejected(state: Pass) -> Pass =
  Pass { ..state, counts: Counts { ..state.counts, cold_rejected: state.counts.cold_rejected + 1 } }

fn primitive(t: Ty) -> Bool = match t {
  TyInt -> true, TyFloat -> true, TyBool -> true, TyUnit -> true, _ -> false
}

# This first call class carries neither dictionaries nor evidence, and never
# invokes synthesized defaults or a signature whose inference is still pending.
fn ordinary_callee(s: Sig) -> Bool = {
  if s.inferring || s.is_builtin || s.trait_id != None || s.op_of != None ||
    s.tparams != [] || s.constraints != [] || s.eparams != [] || s.eff != EPure ||
    not primitive(s.ret) { return false }
  for t in s.param_tys { if not primitive(t) { return false } }
  for present in s.param_defaults { if present { return false } }
  true
}

# The index follows actual signature publication, never speculative cached
# outputs. A call may only use the canonical answer currently indexed.
fn header_callee(ix: callee_index.CalleeIndex, cx: Cx, s: Sig) -> Bool =
  ordinary_callee(s) && callee_index.signature(ix, cx, s.owner, s.name, false, None) == Some(s)

fn call_header_fact(ix: callee_index.CalleeIndex, cx: Cx, read: FunctionRead) -> Bool = match read {
  semantic_reads.FunctionAnswer(q) -> match q.answer {
    Some(s) -> header_callee(ix, cx, s), None -> false
  }
  semantic_reads.QualifiedFunction(_, q) -> match q.answer {
    Some(s) -> header_callee(ix, cx, s), None -> false
  }
  _ -> true
}

fn qualified_call(reads: List[FunctionRead], qualifier: String, name: String) -> Bool = {
  var module = false
  var function = false
  for read in reads {
    match read {
      semantic_reads.ModuleAlias(q, Some(_)) -> if q == qualifier { module = true }
      semantic_reads.QualifiedFunction(q, answer) ->
        if q == qualifier && answer.name == name && answer.answer != None { function = true }
      _ -> ()
    }
  }
  module && function
}

## The types a body of this class carries from the revision that recorded it
## into the one replaying it: the primitives, and the type parameters its own
## signature binds. A type parameter is a name and an id minted for this
## declaration's own parameter slot, so it names the same binder in every
## revision that still declares it, and `allocation.body_relocation` refuses
## the body unless the recorded and candidate signatures are that same value
## field for field.
fn carried(s: Sig, t: Ty) -> Bool = {
  if primitive(t) { return true }
  for parameter in s.tparams { if parameter == t { return true } }
  false
}

## The type and effect binders `checker.enter_fn` installs for a signature
## (`checker.dawn:13527`). It reads the signature and nothing else, which is
## what lets the replay path put the same binders back without entering the
## body.
fn signature_tparams(s: Sig) -> Map[String, Ty] = {
  var out: Map[String, Ty] = map.empty()
  for parameter in s.tparams {
    match parameter {
      TyVar(name, _) -> { out = map.insert(out, name, parameter) }
      _ -> ()
    }
  }
  out
}

## The effect axis of the same binding. `parameters` refuses a signature with
## effect parameters, so on an admitted body this is always empty; it is here
## because the context a body-local query is asked under is the whole binder
## frame, and leaving half of it to whatever the executor happened to hand in
## is what this knife is about.
fn signature_eff_vars(s: Sig) -> Map[String, Eff] = {
  var out: Map[String, Eff] = map.empty()
  for parameter in s.eparams {
    match parameter {
      EffVar(name, _) -> { out = map.insert(out, name, parameter) }
      _ -> ()
    }
  }
  out
}

## The context a body-local query is revalidated under. What the executor
## hands in is the context the scheduler entered the declaration with, where
## the signature binders are not bound yet: `check_fn` binds them on the way
## into the body, so a scoped query asked before that binding answers `None`
## for every type parameter and refuses every generic body. The binders are a
## function of the candidate signature, so they go back here without running
## anything.
fn binder_context(cx: Cx, s: Sig) -> Cx =
  Cx { ..cx, current_tparams: signature_tparams(s), current_eff_vars: signature_eff_vars(s) }

## The half of class membership decidable from the declaration header, and the
## parameter names the body may refer to. Walking the body is the other half,
## and admission runs that walk once, pairing the two revisions, rather than
## once per revision.
fn parameters(d: FnDecl, s: Sig) -> Option[Set[String]] = {
  let inferred = d.ret == None
  let result_ok = if inferred { s.ret == TyError && s.tparams == [] } else { carried(s, s.ret) }
  let effect_ok = s.eff == EPure || (inferred && s.eff == EIo)
  if d.eparams != [] || d.effs != [] || inferred != s.inferring ||
    s.eparams != [] || len(s.constraints) != 0 || not effect_ok ||
    s.is_builtin || s.trait_id != None || not result_ok ||
    len(d.tparams) != len(s.tparams) ||
    len(d.params) != len(s.param_tys) || len(d.params) != len(s.param_names) { return None }
  for present in s.param_defaults { if present { return None } }
  # The signature's type parameters are this declaration's own, spelled the
  # way the declaration spells them and bounded by nothing. Refusing a bound
  # is what keeps the entry context rebuildable: `enter_fn` turns a bound into
  # a dictionary in the frame, and nothing in this class can name one.
  let tparams = signature_tparams(s)
  if map.len(tparams) != len(s.tparams) { return None }
  var ti = 0
  for parameter in d.tparams {
    if parameter.bounds != [] || map.get(tparams, parameter.name) != Some(s.tparams[ti]) { return None }
    ti = ti + 1
  }
  var bound: Set[String] = set.empty()
  var i = 0
  for param in d.params {
    if param.default != None || param.name != s.param_names[i] ||
      not carried(s, s.param_tys[i]) || set.has(bound, param.name) { return None }
    bound = set.insert(bound, param.name)
    i = i + 1
  }
  Some(bound)
}

fn table(scope: ModuleKey, h: ModuleHeaders) -> Option[allocation.Table] =
  allocation.combine([allocation.compiler_headers(scope.world)?,
    allocation.table(allocation.local_headers(scope, h.syntax, h.cx)?)?])

## A snapshot parsed its own text, so comparing its tree with the headers is
## the whole provenance check: equal trees mean the retained coordinates
## address this revision. Nothing is lexed or parsed here.
fn snapshot_matches(h: ModuleHeaders, s: Snapshot) -> Bool = source_snapshot.syntax(s) == h.syntax

## Settle one saved body against its own revision. Class membership, the
## product's own field guards, the local symbols it installs and the binder
## names it declares all read the recorded revision only; a candidate that
## fails the pairing below never reaches a product, and one that passes it has
## the same shape and the same binder names, so these answers carry over.
## Refusing here is refusing to record an admission verdict, not refusing a
## body: an unadmitted body is checked cold like any other.
fn recorded(prior: FnDecl, prior_sig: Sig, p: Product, declaration: Int,
  headers: Cx, callees: callee_index.CalleeIndex) -> Option[Prior] = {
  if len(prior_sig.constraints) != 0 {
    let symbols = bounded_replay.recorded(prior, prior_sig, p)?
    return Some(Prior { syntax: prior, signature: prior_sig, product: p, declaration: declaration,
      binders: prior_sig.param_names, symbols: symbols, bounded: true })
  }
  let _ = parameters(prior, prior_sig)?
  # Class membership of the recorded declaration is settled by
  # `scalar_shape.binders` below, which fails closed on every node this class
  # does not support. The replay path settles the candidate's: `parameters`
  # accepts its header, `allocation.body_relocation` requires the recorded header to be
  # it field for field, and `source_projection.same_text` requires the
  # declaration's own bytes, so the candidate body is the recorded body.
  # The binder frame the recorded body was entered under is the one its own
  # signature names. `enter_fn` rewrites each binder's bound on the way in,
  # and for a signature this class admits that write is the value the header
  # pass already put there, so the product carries no net bound change and
  # `assemble` puts none back. A product that says otherwise was not entered
  # the way the candidate revision will enter this declaration; the guards
  # below are closed rather than diagnostic.
  let tparams = signature_tparams(prior_sig)
  let eff_vars = signature_eff_vars(prior_sig)
  var bound_ids: Set[Int] = set.empty()
  for parameter in prior_sig.tparams {
    match parameter {
      TyVar(_, id) -> { bound_ids = set.insert(bound_ids, id) }
      _ -> return None
    }
  }
  let inferred = prior_sig.inferring
  if inferred {
    let sealed = Sig { ..prior_sig, ret: p.tree.sig.ret, eff: EPure, inferring: false }
    if not primitive(p.tree.sig.ret) || p.tree.sig != sealed ||
      len(p.signatures) != 1 { return None }
    let publication = p.signatures[0]
    if publication.key != prior.name || publication.value != Some(p.tree.sig) { return None }
  } else if p.tree.sig != prior_sig || p.signatures != [] { return None }
  if p.tree.name != prior.name || p.aliases != [] || len(p.bounds) != 0 ||
    p.tparams != tparams || p.effect_vars != eff_vars || p.diagnostics != [] { return None }
  let reads = p.function_reads?
  if reads == [] && not inferred { return None }
  for read in reads {
    if not call_header_fact(callees, headers, read) { return None }
    match read {
      semantic_reads.FunctionAnswer(_) -> ()
      semantic_reads.QualifiedFunction(_, _) -> ()
      semantic_reads.ModuleAlias(_, Some(_)) -> ()
      semantic_reads.ReducedAssociatedType(a, b) -> if not primitive(a) || a != b { return None }
      semantic_reads.ReducedTypeEffects(a, bindings, b) ->
        if not primitive(a) || a != b || bindings != [] { return None }
      semantic_reads.ReducedEffect(EPure, bindings, EPure) -> if bindings != [] { return None }
      semantic_reads.ConcreteType(a, true) -> if not primitive(a) { return None }
      semantic_reads.UnifiedTypes(q) ->
        if not primitive(q.declared) || not primitive(q.actual) || not q.matched ||
        q.before.types != [] || q.before.effects != [] ||
        q.after.types != [] || q.after.effects != [] { return None }
      AssignableType(a, b, true) -> if not carried(prior_sig, a) || not carried(prior_sig, b) { return None }
      # A binder asked for by name from inside the body. This is the one
      # family here whose answer belongs to the declaration rather than to the
      # module, so it is revalidated under the candidate signature's binders
      # and never shared between bodies. The recorded answer is not compared
      # here: the revalidation compares it, against the binders of the
      # declaration the candidate revision is actually checking.
      ScopedTypeParameter(_, _) -> ()
      ScopedEffectVariable(_, _) -> ()
      # A type named in the body resolves through the builtin table before it
      # reaches the binders, so admitting the binders means admitting this.
      BuiltinTypeAnswer(_, _) -> ()
      _ -> return None
    }
  }
  var symbols: Map[Int, Sym] = map.empty()
  for change in p.symbols {
    let symbol = change.value?
    if map.has(symbols, change.key) || not carried(prior_sig, symbol.ty) || symbol.mutable ||
      symbol.dict_of != None || symbol.ev_of != None || symbol.cell_of != None { return None }
    symbols = map.insert(symbols, change.key, symbol)
  }
  var written: Set[Int] = set.empty()
  var bounds_written: Set[Int] = set.empty()
  var published = false
  for write in p.body_writes? {
    match write {
      SymbolKey(id) -> {
        if not map.has(symbols, id) { return None }
        written = set.insert(written, id)
      }
      # The bound `enter_fn` rewrites for each of this signature's own
      # binders. It is journaled because the entry context writes it, and it
      # carries no change because what it writes is what the header pass
      # already recorded for that binder.
      BoundsKey(id) -> {
        if not set.has(bound_ids, id) { return None }
        bounds_written = set.insert(bounds_written, id)
      }
      SignatureKey(name) -> {
        if not inferred || name != prior.name { return None }
        published = true
      }
      _ -> return None
    }
  }
  if set.len(written) != map.len(symbols) ||
    set.len(bounds_written) != set.len(bound_ids) || published != inferred { return None }
  # checker.declare reports a binder that shadows an imported module alias,
  # and that table read leaves no journal entry to revalidate. Name every
  # binder the recorded body declares so the candidate revision can be asked
  # the same question without walking its body a second time.
  let names = scalar_shape.binders(prior.body, prior_sig.param_names)?
  if not scalar_shape.module_calls(prior.body, (qualifier, name) => qualified_call(reads, qualifier, name)) { return None }
  Some(Prior { syntax: prior, signature: prior_sig, product: p, declaration: declaration,
    binders: names, symbols: symbols, bounded: false })
}

fn ready(scope: ModuleKey, old: ModuleHeaders, old_source: Snapshot, entries_saved: List[Saved],
  completed: Cx) -> Option[Ready] = {
  if old.cx.diags != [] || not snapshot_matches(old, old_source) { return None }
  let headers = table(scope, old)?
  let callees = callee_index.of(completed)
  var originals: Map[DeclKey, (FnDecl, Int)] = map.empty()
  for entry in identity.declarations(scope, old.syntax) {
    match old.syntax.decls[entry.declaration] {
      DFn(d) -> { originals = map.insert(originals, entry.key, (d, entry.declaration)) }
      _ -> ()
    }
  }
  var entries: Map[DeclKey, Prior] = map.empty()
  var seen: Set[DeclKey] = set.empty()
  for entry in entries_saved {
    match entry {
      SavedFunction(k, FunctionInput(prior, prior_sig, inferred), product) -> {
        if set.has(seen, k) {
          entries = map.remove(entries, k)
        } else {
          seen = set.insert(seen, k)
          match map.get(originals, k) {
            Some((declared, declaration)) -> {
              if declared == prior && inferred == prior_sig.inferring &&
                map.get(old.cx.fns, prior.name) == Some(prior_sig) {
                  match recorded(prior, prior_sig, product, declaration, completed, callees) {
                    Some(entry_value) -> { entries = map.insert(entries, k, entry_value) }
                    None -> ()
                  }
                }
            }
            None -> ()
          }
        }
      }
      _ -> ()
    }
  }
  Some(Ready { headers: headers, source: old_source, entries: entries })
}

## Bind one recording to the revision that produced it, and answer every
## admission question that revision can answer alone. This is the record-time
## half of admission: it runs once per recorded revision, not once per replay,
## and never per candidate body.
pub(pkg) fn admit(scope: ModuleKey, old: ModuleHeaders, old_source: Snapshot, saved: Recorded) -> Admitted =
  AdmittedData { scope: scope, ready: ready(scope, old, old_source, saved.entries, saved.bodies.cx) }

## How many recorded bodies this admission settled. Observable so a caller
## can tell "nothing was admitted" from "nothing was offered"; it grants no
## access to the products themselves.
pub fn admitted_count(admitted: Admitted) -> Int = {
  let data: AdmittedData = admitted
  match data.ready { None -> 0, Some(settled) -> map.len(settled.entries) }
}

fn prepare(admitted: AdmittedData, next: ModuleHeaders, source: Snapshot) -> Option[Prepared] = {
  let scope = admitted.scope
  let settled = admitted.ready?
  let next_headers = table(scope, next)?
  if not allocation.between(settled.headers, next_headers) { return None }
  # The candidate revision's own declaration keys, addressed by where each
  # declaration starts. A body reaches the executor as syntax, and this is
  # what turns that syntax back into the identity the enumeration gave it,
  # rather than spelling a key out of the declaration's name a second time.
  # A name that two declarations in this revision claim has no key here at
  # all: `identity.located` drops it, and a product keyed by it is therefore
  # unreachable.
  var candidates: Map[Int, (DeclKey, Int)] = map.empty()
  for located in identity.located(scope, next.syntax) {
    match next.syntax.decls[located.entry.declaration] {
      DFn(_) -> if located.entry.member == None {
        candidates = map.insert(candidates, located.span.lo, (located.entry.key, located.entry.declaration))
      }
      _ -> ()
    }
  }
  # The candidate revision's function tables, keyed once by the pair a call
  # site names. It belongs here for the same reason the header relocation does:
  # `prepare` runs once per candidate revision, `relocation` runs once per
  # body, and a table built per body would cost a module-sized pass per body.
  # It starts from the header revision and follows each actual inferred
  # signature publication before downstream consumers are considered.
  Some(Prepared { scope: scope, ready: settled, candidates: candidates,
    callees: callee_index.of(next.cx),
    old_tokens: source_snapshot.tokens(settled.source), tokens: source_snapshot.tokens(source),
    memo: new_memo() })
}

## Which recorded facts one revision may answer once for all of its bodies.
## Sharing a verdict is sound exactly when recomputing it reads only what the
## revision settled before any body ran. `AssignableType` is such a family:
## `assignable` answers from the two types the fact carries and the owner this
## module is checked under, and nothing a body does moves either.
## `BuiltinTypeAnswer` reads only `btypes`, also preserved by the scheduler;
## a missing builtin is just as revision-local as a present one. This does
## not include the separate scoped lookup that may follow a builtin miss.
## The families
## that read what the scheduler rebinds per declaration are not, and the
## signature binders below are revalidated per body for that reason. The
## allowlist is closed so that widening the admitted class has to make this
## decision rather than inherit it.
fn shared(read: FunctionRead) -> Bool = match read {
  AssignableType(_, _, _) -> true
  BuiltinTypeAnswer(_, _) -> true
  _ -> false
}

## Revalidate one recorded fact, at most once per candidate revision for the
## facts a revision may answer for all of its bodies. `checker.revalidate_read`
## has no effect row and writes nothing this pass reads, so what the memo holds
## is a value and not a cached observation.
fn revalidated(memo: Memo, cx: Cx, scoped: Cx, read: FunctionRead) -> (Memo, Option[Bool]) = {
  if not shared(read) { return (memo, checker.revalidate_read(scoped, read)) }
  let asked = query_runtime.read(memo, read)
  match asked.answer {
    query_runtime.Available(value) -> (asked.engine, value)
    _ -> {
      let value = checker.revalidate_read(cx, read)
      let opened = match query_runtime.begin(asked.engine, read) {
        Some(engine) -> engine
        None -> return (asked.engine, value)
      }
      match query_runtime.finish(opened, read, value) {
        Some(engine) -> (engine, value)
        None -> (asked.engine, value)
      }
    }
  }
}

## The recorded body paired with the relocation onto this candidate: every
## admission question that needs both revisions, and nothing that needs the
## product. Separate from `candidate` so the equivalence of the two
## revalidation paths can be asserted on the same relocation the production
## path builds.
fn relocation(prepared: Prepared, cx: Cx, d: FnDecl, sig: Sig) -> Option[(Prior, View)] = {
  if cx.diags != [] { return None }
  if len(sig.constraints) != 0 {
    if not bounded_replay.header(d, sig) { return None }
  } else { let _ = parameters(d, sig)? }
  # The product is retained under the key of the declaration that produced it,
  # so this is the whole of finding it: ask the candidate revision which
  # declaration this is, and look the product up under that. A declaration
  # this revision spells the same way but reads as another identity, and a
  # reorder that moves a name onto another declaration, both land on a
  # different key and find nothing.
  let (key, declaration) = map.get(prepared.candidates, d.lo)?
  let saved = map.get(prepared.ready.entries, key)?
  let prior = saved.syntax
  let prior_sig = saved.signature
  let p = saved.product
  # `parameters` proved the candidate declaration binds exactly `sig`'s
  # parameter names, so equal names make the recorded binder list describe
  # this body too. The rest of the header is compared field for field below,
  # which refuses unless the recorded signature carries onto this one, and the
  # declaration's own bytes are required further down.
  if prior_sig.param_names != sig.param_names { return None }
  for name in saved.binders {
    if map.has(cx.module_aliases, name) { return None }
  }
  let no_evidence: List[Int] = []
  if not allocation.body_relocation(prior_sig, sig, no_evidence) { return None }
  # Both revisions lexed their own declarations once, and pairing them is two
  # list comparisons over kinds and spellings. That is the snapshot's own
  # equality, and it says the recorded coordinates address this declaration in
  # each revision.
  if not source_projection.pair(prepared.old_tokens, prepared.tokens,
    saved.declaration, declaration, prior.lo, prior.hi, d.lo, d.hi) { return None }
  # This is the admission point for the positions. The product's spans are
  # offsets into the declaration's own text, so they mean the same thing in
  # this revision exactly when that text is the same bytes. The pairing above
  # is deliberately blind to whitespace between tokens, and whitespace between
  # two tokens of this declaration moves everything after it: the declaration
  # itself did not move, but every offset into it did. Such an edit is not
  # admitted, and its declaration is checked cold, which is the whole of the
  # rule.
  if not source_projection.same_text(prepared.old_tokens, prepared.tokens,
    prior.lo, prior.hi, d.lo, d.hi) { return None }
  let view = View { symbols: saved.symbols,
    callee: (owner, name, builtin, trait_id) => {
      if saved.bounded { return bounded_replay.callee(cx, owner, name, builtin, trait_id) }
      if builtin || trait_id != None { return None }
      let found = callee_index.signature(prepared.callees, cx, owner, name, false, None)?
      if not ordinary_callee(found) { return None }
      Some(found)
    } }
  Some((saved, view))
}

## The candidate's verdict on one saved body, and the preparation to carry to
## the next one. The preparation comes back on every path, refusals included:
## the facts this body asked about are the facts the next body is about to
## ask about, and an answer is no less true for having refused the body that
## paid for it.
fn candidate(prepared: Prepared, cx: Cx, d: FnDecl, sig: Sig) -> (Prepared, Verdict) = {
  if sig.inferring && map.get(cx.fns, d.name) != Some(sig) { return (prepared, Rejected) }
  let (saved, view) = match relocation(prepared, cx, d, sig) {
    Some(pair) -> pair
    None -> return (prepared, Unadmitted)
  }
  let p = saved.product
  let reads = match p.function_reads {
    Some(recorded_reads) -> recorded_reads
    None -> return (prepared, Unadmitted)
  }
  # The recorded log is revalidated where it lies: each fact is walked beside
  # the answer the candidate revision observes, and nothing is rebuilt in
  # candidate coordinates to be compared and thrown away. The rebuilt log is
  # only what an observing caller installs, so it is built only when the
  # caller is observing.
  let scoped = if saved.bounded {
    match function_entry_proof.prove(cx, d, sig, p) {
      Some(proof) -> function_entry_proof.context(proof)
      None -> return (prepared, Rejected)
    }
  } else { binder_context(cx, sig) }
  if saved.bounded && tex_ty(p.tree.body) != sig.ret { return (prepared, Rejected) }
  if saved.bounded && not bounded_replay.expression(scoped, sig, p.tree.body) { return (prepared, Rejected) }
  let candidate_view = if saved.bounded { View { ..view, symbols: scoped.syms } } else { view }
  var memo = prepared.memo
  for read in reads {
    if saved.bounded {
      if not bounded_replay.read_allowed(read) || checker.revalidate_read(scoped, read) != Some(true) {
        return (Prepared { ..prepared, memo: memo }, Rejected)
      }
      continue
    }
    if not call_header_fact(prepared.callees, cx, read) { return (Prepared { ..prepared, memo: memo }, Rejected) }
    let (next_memo, verdict) = revalidated(memo, cx, scoped, read)
    memo = next_memo
    if verdict != Some(true) { return (Prepared { ..prepared, memo: memo }, Rejected) }
  }
  let carried = Prepared { ..prepared, memo: memo }
  let projected = match cx.function_reads {
    None -> body_product.project_without_reads(candidate_view, p)
    Some(_) -> body_product.project(candidate_view, p)
  }
  let moved = match projected {
    Some(product) -> product
    None -> return (carried, Rejected)
  }
  # These fields pass through this closed producer unchanged. The old final
  # value is not a write: preserve the corresponding current scheduler state.
  (carried, Reused(BodyProduct { ..moved, in_test: cx.in_test, const_cutoff: cx.const_cutoff,
    loop_jumps: cx.loop_jumps, take_cell: cx.take_cell,
    function_reads: match cx.function_reads { None -> None, Some(_) -> moved.function_reads },
    body_writes: match cx.body_writes { None -> None, Some(_) -> moved.body_writes },
    frame: Frame { ..moved.frame, isolated: cx.frame.isolated } }))
}

## Inputs must come from the canonical header/recording producers in one
## owner world. Both source snapshots carry the tree of their own text, and
## each must equal the headers it accompanies, so unrelated text cannot lend
## positions to those products. Every failed admission executes the cold body.
pub(pkg) fn replay(admitted: Admitted, next: ModuleHeaders, source: Snapshot) -> Replayed !io = {
  let data: AdmittedData = admitted
  let valid = next.cx.diags == [] && snapshot_matches(next, source)
  let prepared: Option[Prepared] = if valid { prepare(data, next, source) } else { None }
  let (outcome, bodies) = checker.execute_module_bodies(next,
    Pass { counts: zero_counts(), prepared: prepared }, pass_executor())
  replay_result(outcome, bodies)
}

fn replay_result(outcome: Pass, bodies: ModuleBodies) -> Replayed =
  Replayed { bodies: bodies,
    checked: outcome.counts.cold_unadmitted + outcome.counts.cold_rejected,
    reused: outcome.counts.reused, cold_unadmitted: outcome.counts.cold_unadmitted,
    cold_rejected: outcome.counts.cold_rejected }

## Renew from the actual scheduler transitions, including cold replacements
## and newly added declarations. Recording observes replay installation before
## absolute positions are materialized, retaining its dependency/write journals.
## Only current pre-body headers and current source may bind the next cache.
pub(pkg) fn replay_and_record(admitted: Admitted, next: ModuleHeaders, source: Snapshot) -> Renewed !io = {
  let data: AdmittedData = admitted
  let valid = next.cx.diags == [] && snapshot_matches(next, source)
  let prepared: Option[Prepared] = if valid { prepare(data, next, source) } else { None }
  let (outcome, captured) = body_execution.record_replaying(data.scope, next,
    Pass { counts: zero_counts(), prepared: prepared }, renewal_decisions(), pass_executor())
  let renewed = AdmittedData { scope: data.scope,
    ready: ready(data.scope, next, source, captured.entries, captured.bodies.cx) }
  Renewed { replayed: replay_result(outcome, captured.bodies), admitted: renewed,
    visited: captured.visited, capture_refused: captured.capture_refused }
}

# A renewal hit requests installation but cannot supply the context against
# which it will be captured. The recorder owns that actual scheduler input.
fn renewal_decision(state: Pass, cx: Cx, d: FnDecl, sig: Sig,
  cold: fn(Pass, Cx, FnDecl, Sig) -> (Pass, Cx, TFun) !io) -> FunctionDecision[Pass] !io = {
  let (stepped, verdict) = match state.prepared {
    Some(p) -> {
      let (after, hit) = candidate(p, cx, d, sig)
      (Pass { ..state, prepared: Some(after) }, hit)
    }
    None -> (state, Unadmitted)
  }
  match verdict {
    Reused(product) -> Install(reused(stepped), rejected(stepped), product)
    Rejected -> {
      let (after, next, tree) = cold(rejected(stepped), cx, d, sig)
      Checked(after, next, tree)
    }
    Unadmitted -> {
      let (after, next, tree) = cold(unadmitted(stepped), cx, d, sig)
      Checked(after, next, tree)
    }
  }
}

fn renewal_decisions() -> ReplayDecisions[Pass] = {
  let cold: BodyExecutor[Pass] = checker.cold_body_executor()
  ReplayDecisions {
    function: (state, cx, d, sig) => renewal_decision(state, cx, d, sig, cold.function),
    inferred_body: (state, cx, d, sig) => renewal_decision(state, cx, d, sig, cold.inferred_body),
    after_inferred: (state, before, after, d, sig) => refresh_inferred(state, before, after, d)
  }
}

fn refresh_inferred(outcome: Pass, cx: Cx, next: Cx, d: FnDecl) -> Pass = {
  let refreshed = match outcome.prepared {
    None -> None
    Some(p) -> match callee_index.replace_local(p.callees, d.name,
      map.get(cx.fns, d.name), map.get(next.fns, d.name)) {
      Some(ix) -> Some(Prepared { ..p, callees: ix })
      None -> None
    }
  }
  Pass { ..outcome, prepared: refreshed }
}

fn inferred_pass(state: Pass, cx: Cx, d: FnDecl, sig: Sig) -> (Pass, Cx, TFun) !io = {
  let cold: BodyExecutor[Pass] = checker.cold_body_executor()
  let (stepped, verdict) = match state.prepared {
    Some(p) -> {
      let (after, hit) = candidate(p, cx, d, sig)
      (Pass { ..state, prepared: Some(after) }, hit)
    }
    None -> (state, Unadmitted)
  }
  let (outcome, next, tree) = match verdict {
    Reused(product) -> match body_product.assemble(cx, product) {
      Some(after) -> (reused(stepped), after, product.tree)
      None -> cold.inferred_body(rejected(stepped), cx, d, sig)
    }
    Rejected -> cold.inferred_body(rejected(stepped), cx, d, sig)
    Unadmitted -> cold.inferred_body(unadmitted(stepped), cx, d, sig)
  }
  # Include cold publications as well as hits: downstream inferred and explicit
  # consumers must see exactly the table the canonical callback produced.
  (refresh_inferred(outcome, cx, next, d), next, tree)
}

## The executor the pass runs. It is named rather than built inside `replay`
## so that a judgment can run the production one and read the state it leaves
## behind, which is where the shared memo ends up.
fn pass_executor() -> BodyExecutor[Pass] = {
  let cold: BodyExecutor[Pass] = checker.cold_body_executor()
  BodyExecutor {
    function: (state, cx, d, sig) => {
      let stepped_hit: (Pass, Verdict) = match state.prepared {
        Some(p) -> {
          let (after, verdict) = candidate(p, cx, d, sig)
          (Pass { ..state, prepared: Some(after) }, verdict)
        }
        None -> (state, Unadmitted)
      }
      let (stepped, hit) = stepped_hit
      match hit {
        # A product that will not install is a claim withdrawn as much as a
        # fact that stopped holding: the body was this producer's and the
        # candidate revision would not take it.
        Reused(product) -> match body_product.assemble(cx, product) {
          Some(after) -> (reused(stepped), after, product.tree)
          None -> cold.function(rejected(stepped), cx, d, sig)
        }
        Rejected -> cold.function(rejected(stepped), cx, d, sig)
        Unadmitted -> cold.function(unadmitted(stepped), cx, d, sig)
      }
    },
    inferred_body: (n, cx, d, sig) => inferred_pass(n, cx, d, sig),
    # The four categories this producer does not implement. Every one of them
    # is unadmitted rather than rejected: nothing was claimed for them, so
    # there is nothing for the candidate revision to withdraw.
    constant: (n, cx, d, ty, visible) => cold.constant(unadmitted(n), cx, d, ty, visible),
    method: (n, cx, tr, subject, d, sig) => cold.method(unadmitted(n), cx, tr, subject, d, sig),
    default_body: (n, cx, tr, d, sig, body) => cold.default_body(unadmitted(n), cx, tr, d, sig, body),
    test_body: (n, cx, name, body) => cold.test_body(unadmitted(n), cx, name, body)
  }
}

fn call_result_equal(actual: Replayed, expected: ModuleBodies) -> Bool =
  actual.bodies.functions == expected.functions && actual.bodies.constants == expected.constants &&
  actual.bodies.impl_methods == expected.impl_methods && actual.bodies.trait_defaults == expected.trait_defaults &&
  actual.bodies.tests == expected.tests && actual.bodies.cx.diags == expected.cx.diags &&
  actual.bodies.cx.syms == expected.cx.syms && actual.bodies.cx.decl_slots == expected.cx.decl_slots &&
  actual.bodies.cx.frame == expected.cx.frame && actual.bodies.cx.fns == expected.cx.fns &&
  actual.bodies.cx.alias_resolved == expected.cx.alias_resolved &&
  actual.bodies.cx.current_tparams == expected.cx.current_tparams &&
  actual.bodies.cx.current_eff_vars == expected.cx.current_eff_vars &&
  actual.bodies.cx.current_tparam_bounds == expected.cx.current_tparam_bounds &&
  actual.bodies.cx.function_reads == expected.cx.function_reads && actual.bodies.cx.body_writes == expected.cx.body_writes &&
  actual.bodies.cx.owner == expected.cx.owner && actual.bodies.cx.owner_lo == expected.cx.owner_lo &&
  actual.bodies.cx.owner_decl == expected.cx.owner_decl && actual.bodies.cx.in_test == expected.cx.in_test &&
  actual.bodies.cx.const_cutoff == expected.cx.const_cutoff && actual.bodies.cx.loop_jumps == expected.cx.loop_jumps &&
  actual.bodies.cx.take_cell == expected.cx.take_cell

test "assembly certified renewal matches strict products at actual scheduler entries" {
  let scope = identity.module_key("certified", "sample", "sample", "sample.dawn")
  let text = "trait Scale[T] { fn scale(x: T, k: Int) -> Int }\n" ++
    "type Coin = { value: Int }\nimpl Scale[Coin] { fn scale(x: Coin, k: Int) -> Int = x.value * k }\n" ++
    "fn generic[T: Scale](x: T) -> Int = scale(x, 2)\n" ++
    "fn leaf() = 1\nfn inferred() = leaf()\nfn direct() -> Int = leaf()\nfn scalar(x: Int) -> Int = x + 1\n"
  let source = source_snapshot.of(text).expect("certified renewal source")
  for observing in [false, true] {
    let base = Cx { ..cx_new(Some("sample"), Some("sample.dawn")),
      function_reads: if observing { Some([semantic_reads.StdModuleMode(false)]) } else { None },
      body_writes: if observing { Some([SignatureKey("outer")]) } else { None } }
    let headers = checker.check_module_headers(base, source_snapshot.syntax(source), map.empty())
    assert headers.cx.diags == []
    let recorded = body_execution.record(scope, headers)
    var strict_admitted = admit(scope, headers, source, recorded)
    var certified_admitted = strict_admitted
    for prefix in ["", "# shifted\n", "# shifted again\n\n"] {
      let next_source = source_snapshot.of(prefix ++ text).expect("certified renewal generation")
      let next = checker.check_module_headers(base, source_snapshot.syntax(next_source), map.empty())
      let strict_data: AdmittedData = strict_admitted
      let certified_data: AdmittedData = certified_admitted
      let initial = Pass { counts: zero_counts(), prepared: prepare(strict_data, next, next_source) }
      let certified_initial = Pass { counts: zero_counts(), prepared: prepare(certified_data, next, next_source) }
      let (strict_state, strict) = body_execution.record_using(scope, next, initial, pass_executor())
      let (certified_state, certified) = body_execution.record_replaying(scope, next, certified_initial, renewal_decisions(), pass_executor())
      assert strict.entries == certified.entries && strict.visited == certified.visited
      assert strict.capture_refused == certified.capture_refused && certified.capture_refused == 0
      assert strict_state.counts == certified_state.counts && certified_state.counts.reused == 5
      assert call_result_equal(replay_result(certified_state, certified.bodies), strict.bodies)
      assert call_result_equal(replay_result(certified_state, certified.bodies), checker.check_module_body_products(next))
      strict_admitted = AdmittedData { scope: scope, ready: ready(scope, next, next_source, strict.entries, strict.bodies.cx) }
      certified_admitted = AdmittedData { scope: scope, ready: ready(scope, next, next_source, certified.entries, certified.bodies.cx) }
    }
  }
}

test "scalar replay inferred chains publish signatures in current dependency order" {
  let scope = identity.module_key("inferred", "sample", "sample", "sample.dawn")
  let callers = "fn top() -> Int = middle()\nfn middle() = leaf()\n"
  let leaf = "fn leaf() = { let value = 1\n value }\n"
  let before = source_snapshot.of(callers ++ leaf).expect("inferred chain")
  for observing in [false, true] {
    let base = Cx { ..cx_new(Some("sample"), Some("sample.dawn")),
      function_reads: if observing { Some([]) } else { None },
      body_writes: if observing { Some([]) } else { None } }
    let old = checker.check_module_headers(base, source_snapshot.syntax(before), map.empty())
    let saved = body_execution.record(scope, old)
    assert saved.bodies.cx.diags == []
    let admitted = admit(scope, old, before, saved)
    assert admitted_count(admitted) == 3
    for (text, hits) in [
      (callers ++ leaf, 3),
      (callers ++ "fn leaf() = { let value = 2\n value }\n", 2),
      ("# moved\n" ++ leaf ++ callers, 3),
      (callers ++ "fn leaf() = true\n", 0),
      (callers ++ "fn leaf() = middle()\n", 0),
      (callers ++ "fn leaf() -> Int = 1\n", 2)
    ] {
      let source = source_snapshot.of(text).expect("inferred edit")
      let next = checker.check_module_headers(base, source_snapshot.syntax(source), map.empty())
      let actual = replay_and_record(admitted, next, source)
      assert actual.replayed.reused == hits
      assert call_result_equal(actual.replayed, checker.check_module_body_products(next))
      let again = replay_and_record(actual.admitted, next, source)
      assert call_result_equal(again.replayed, checker.check_module_body_products(next))
      if actual.replayed.bodies.cx.diags == [] {
        assert again.replayed.reused == 3 && again.replayed.checked == 0
        let third = replay(again.admitted, next, source)
        assert third.reused == 3 && third.checked == 0
        assert call_result_equal(third, checker.check_module_body_products(next))
      }
      let recovered = replay_and_record(actual.admitted, old, before)
      assert call_result_equal(recovered.replayed, checker.check_module_body_products(old))
      let recovered_hit = replay(recovered.admitted, old, before)
      assert recovered_hit.reused == 3 && recovered_hit.checked == 0
      assert call_result_equal(recovered_hit, checker.check_module_body_products(old))
    }
  }
}

test "scalar replay inferred consumers observe cold parameterized publications" {
  let scope = identity.module_key("inferred", "sample", "sample", "sample.dawn")
  let callers = "fn top() -> Int = middle()\nfn middle() = leaf(1)\n"
  let cold_leaf = "fn leaf(x: Int) = { var value = x\n value }\n"
  let before = source_snapshot.of(callers ++ cold_leaf).expect("cold parameterized callee")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(before), map.empty())
  let saved = body_execution.record(scope, old)
  assert saved.bodies.cx.diags == []
  let admitted = admit(scope, old, before, saved)
  assert admitted_count(admitted) == 2
  for (leaf, hits, next_hits) in [
    (cold_leaf, 2, 2),
    ("fn leaf(x: Int) = { var value = x + 1\n value }\n", 2, 2),
    ("fn leaf(x: Int) = x + 1\n", 2, 3),
    ("fn leaf(y: Int) = y\n", 1, 3)
  ] {
    let source = source_snapshot.of(leaf ++ callers).expect("parameterized publication edit")
    let headers = checker.check_module_headers(base, source_snapshot.syntax(source), map.empty())
    let result = replay_and_record(admitted, headers, source)
    assert result.replayed.reused == hits
    assert call_result_equal(result.replayed, checker.check_module_body_products(headers))
    let renewed = replay_and_record(result.admitted, headers, source)
    assert renewed.replayed.reused == next_hits
    assert call_result_equal(renewed.replayed, checker.check_module_body_products(headers))
  }
}

test "scalar replay inferred products guard exact signature publication" {
  let scope = identity.module_key("inferred", "sample", "sample", "sample.dawn")
  let source = source_snapshot.of("fn leaf() = 1\n").expect("empty read producer")
  let old = checker.check_module_headers(cx_new(Some("sample"), Some("sample.dawn")),
    source_snapshot.syntax(source), map.empty())
  let saved = body_execution.record(scope, old)
  let admitted = admit(scope, old, source, saved)
  assert admitted_count(admitted) == 1
  let prepared = prepare(admitted, old, source).expect("prepared inferred body")
  let d = match old.syntax.decls[0] { DFn(decl) -> decl, _ -> panic("leaf syntax") }
  let sig = map.get(old.cx.fns, "leaf").expect("entry signature")
  for functions in [map.remove(old.cx.fns, "leaf"),
    map.insert(old.cx.fns, "leaf", Sig { ..sig, owner: Some("other") })] {
    let changed = Cx { ..old.cx, fns: functions }
    let (_, verdict) = candidate(prepared, changed, d, sig)
    assert match verdict { Rejected -> true, _ -> false }
    assert changed.fns == functions
  }
  let wrong = Cx { ..old.cx, fns: map.remove(old.cx.fns, "leaf") }
  let stale = Prepared { ..prepared, callees: callee_index.of(wrong) }
  let initial = Pass { counts: zero_counts(), prepared: Some(stale) }
  let (outcome, after, tree) = inferred_pass(initial, old.cx, d, sig)
  assert match outcome.prepared { None -> true, _ -> false }
  let cold: BodyExecutor[Pass] = checker.cold_body_executor()
  let (_, expected, expected_tree) = cold.inferred_body(initial, old.cx, d, sig)
  assert tree == expected_tree && after.fns == expected.fns && after.diags == expected.diags
  match saved.entries[0] {
    SavedFunction(key, input, product) -> {
      assert product.function_reads == Some([])
      let changed_sig = Sig { ..product.tree.sig, param_names: ["unexpected"] }
      let changed_tree = TFun { ..product.tree, sig: changed_sig }
      let changed_publication = Change { key: product.signatures[0].key, value: Some(changed_sig) }
      let bad: List[Product] = [
        BodyProduct { ..product, signatures: [] },
        BodyProduct { ..product, signatures: product.signatures ++ product.signatures },
        BodyProduct { ..product, body_writes: Some([]) },
        BodyProduct { ..product, function_reads: None },
        BodyProduct { ..product, tree: changed_tree },
        BodyProduct { ..product, tree: changed_tree, signatures: [changed_publication] }
      ]
      for p in bad {
        let malformed = Recorded { ..saved, entries: [SavedFunction(key, input, p)] }
        assert admitted_count(admit(scope, old, source, malformed)) == 0
      }
    }
    _ -> panic("inferred function product")
  }
}

test "scalar replay renews hits replacements and additions across three revisions" {
  let scope = identity.module_key("renewal", "sample", "sample", "sample.dawn")
  let caller = "fn caller() -> Int = leaf()\n"
  let fresh = "fn fresh() -> Int = caller()\n"
  let replacement = "fn leaf() -> Int = { let value = 2\n value }\n"
  let first = source_snapshot.of("fn leaf() -> Int = 1\n" ++ caller).expect("first revision")
  let second = source_snapshot.of("# shifted\n" ++ replacement ++ caller ++ fresh).expect("second revision")
  for observing in [false, true] {
    let base = Cx { ..cx_new(Some("sample"), Some("sample.dawn")),
      function_reads: if observing { Some([semantic_reads.ScopedEffectVariable("outer", None)]) } else { None },
      body_writes: if observing { Some([SignatureKey("outer")]) } else { None } }
    let old = checker.check_module_headers(base, source_snapshot.syntax(first), map.empty())
    let admitted = admit(scope, old, first, body_execution.record(scope, old))
    let next = checker.check_module_headers(base, source_snapshot.syntax(second), map.empty())
    let renewed = replay_and_record(admitted, next, second)
    assert renewed.replayed.reused == 1 && renewed.replayed.checked == 2
    assert renewed.visited == 3 && renewed.capture_refused == 0
    assert admitted_count(renewed.admitted) == 3
    assert call_result_equal(renewed.replayed, checker.check_module_body_products(next))
    for (text, hits, count) in [
      (fresh ++ "# moved again\n" ++ caller ++ replacement, 3, 3),
      (fresh ++ caller ++ "fn leaf() -> Bool = true\n", 1, 3),
      (replacement, 1, 1)
    ] {
      let third = source_snapshot.of(text).expect("third revision")
      let current = checker.check_module_headers(base, source_snapshot.syntax(third), map.empty())
      let actual = replay_and_record(renewed.admitted, current, third)
      assert actual.replayed.reused == hits && actual.visited == count
      assert actual.visited == actual.replayed.reused + actual.replayed.checked
      assert call_result_equal(actual.replayed, checker.check_module_body_products(current))
      if count == 1 { assert admitted_count(actual.admitted) == 1 }
      if hits == 3 {
        assert actual.replayed.checked == 0 && admitted_count(actual.admitted) == 3
        let stable = replay(actual.admitted, current, third)
        assert stable.reused == 3 && stable.checked == 0
        assert call_result_equal(stable, checker.check_module_body_products(current))
      }
    }
    # A snapshot from another revision cannot authorize replay or seed a cache.
    let mismatched = replay_and_record(admitted, next, first)
    assert mismatched.replayed.reused == 0 && mismatched.replayed.checked == 3
    assert admitted_count(mismatched.admitted) == 0
    assert call_result_equal(mismatched.replayed, checker.check_module_body_products(next))
  }
}

test "scalar replay renews valid cold replacements after dependency rejection" {
  let scope = identity.module_key("renewal", "sample", "sample", "sample.dawn")
  let caller = "fn caller() -> Int = { let argument = 1\n leaf(argument) }\n"
  let before = source_snapshot.of("fn leaf(x: Int) -> Int = x\n" ++ caller).expect("original callee")
  let changed = source_snapshot.of(caller ++ "fn leaf(y: Int) -> Int = y\n").expect("renamed parameter")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(before), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(changed), map.empty())
  let first = admit(scope, old, before, body_execution.record(scope, old))
  let second = replay_and_record(first, next, changed)
  assert second.replayed.reused == 0 && second.replayed.checked == 2
  assert second.replayed.cold_rejected == 1 && second.replayed.cold_unadmitted == 1
  assert second.replayed.bodies.cx.diags == [] && second.capture_refused == 0
  assert admitted_count(second.admitted) == 2
  assert call_result_equal(second.replayed, checker.check_module_body_products(next))
  let third = replay_and_record(second.admitted, next, changed)
  assert third.replayed.reused == 2 && third.replayed.checked == 0
  assert third.visited == 2 && third.capture_refused == 0
  assert call_result_equal(third.replayed, checker.check_module_body_products(next))
  let fourth = replay(third.admitted, next, changed)
  assert fourth.reused == 2 && fourth.checked == 0
  assert call_result_equal(fourth, checker.check_module_body_products(next))
}

test "scalar replay recovers renewal after header capture refusal" {
  let scope = identity.module_key("renewal", "sample", "sample", "sample.dawn")
  let valid = source_snapshot.of("fn answer() -> Int = 42\n").expect("valid revision")
  let broken = source_snapshot.of("fn answer() -> Missing = 42\n").expect("broken header")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let good = checker.check_module_headers(base, source_snapshot.syntax(valid), map.empty())
  let bad = checker.check_module_headers(base, source_snapshot.syntax(broken), map.empty())
  assert bad.cx.diags != []
  let first = admit(scope, good, valid, body_execution.record(scope, good))
  let refused = replay_and_record(first, bad, broken)
  assert refused.visited > 0 && refused.capture_refused == refused.visited
  assert refused.replayed.reused == 0 && refused.replayed.checked == refused.visited
  assert admitted_count(refused.admitted) == 0
  assert call_result_equal(refused.replayed, checker.check_module_body_products(bad))
  let recovered = replay_and_record(refused.admitted, good, valid)
  assert recovered.replayed.reused == 0 && recovered.replayed.checked == 1
  assert recovered.capture_refused == 0 && admitted_count(recovered.admitted) == 1
  assert call_result_equal(recovered.replayed, checker.check_module_body_products(good))
  let hit = replay(recovered.admitted, good, valid)
  assert hit.reused == 1 && hit.checked == 0
  assert call_result_equal(hit, checker.check_module_body_products(good))
}

test "scalar replay direct calls keep implementations separate from signatures" {
  let scope = identity.module_key("calls", "sample", "sample", "sample.dawn")
  let caller = "fn caller() -> Int = sum(leaf(), { let x = 2\n x })\n"
  let leaf = "fn leaf() -> Int = 1\n"
  let sum = "fn sum(a: Int, b: Int) -> Int = a + b\n"
  let before = leaf ++ sum ++ caller
  for observing in [false, true] {
    let base = Cx { ..cx_new(Some("sample"), Some("sample.dawn")),
      function_reads: if observing { Some([]) } else { None },
      body_writes: if observing { Some([]) } else { None } }
    let snapshot = source_snapshot.of(before).expect("call snapshot")
    let old = checker.check_module_headers(base, source_snapshot.syntax(snapshot), map.empty())
    let saved = body_execution.record(scope, old)
    let admitted = admit(scope, old, snapshot, saved)
    assert admitted_count(admitted) == 3
    for pair in [(before, 3),
      ("fn leaf() -> Int = 9\n" ++ sum ++ caller, 2),
      (caller ++ "# moved\n" ++ sum ++ leaf, 3),
      ("fn leaf() -> Bool = true\n" ++ sum ++ caller, 1),
      ("fn leaf(x: Int) -> Int = x\n" ++ sum ++ caller, 1),
      ("fn leaf() -> Int !io = 1\n" ++ sum ++ caller, 1),
      ("fn leaf() = 1\n" ++ sum ++ caller, 2),
      (sum ++ caller, 1)] {
      let (source, hits) = pair
      let next_snapshot = source_snapshot.of(source).expect("call edit")
      let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
      let actual = replay(admitted, next, next_snapshot)
      assert actual.reused == hits
      assert call_result_equal(actual, checker.check_module_body_products(next))
    }
  }
}

test "scalar replay qualified calls retain canonical owners and reject provider edits" {
  let scope = identity.module_key("calls", "sample", "sample", "sample.dawn")
  let source = "use helper as dep\nfn value() -> Int = 4\nfn caller() -> Int = dep.value()\n"
  let snapshot = source_snapshot.of(source).expect("consumer")
  let text = "pub fn value() -> Int = 1\n"
  let syntax = source_snapshot.syntax(source_snapshot.of(text).expect("provider"))
  let (provider, _) = checker.check_module(cx_new(Some("helper"), None), syntax, map.empty())
  let exp = checker.exports_of(provider, syntax, "helper", "helper")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(snapshot), map.from([("helper", exp)]))
  let saved = body_execution.record(scope, old)
  let admitted = admit(scope, old, snapshot, saved)
  assert admitted_count(admitted) == 2
  for entry in [("helper", text, 2), ("helper", "pub fn value() -> Int = 9\n", 2),
    ("helper", "pub fn value() -> Bool = true\n", 1),
    ("helper", "pub fn value(x: Int) -> Int = x\n", 1),
    ("helper", "pub fn value() -> Int !io = 1\n", 1),
    ("helper", "fn value() -> Int = 1\n", 1), ("replacement", text, 1)] {
    let (owner, changed, hits) = entry
    let ast = source_snapshot.syntax(source_snapshot.of(changed).expect("provider edit"))
    let (checked, _) = checker.check_module(cx_new(Some(owner), None), ast, map.empty())
    let exports = checker.exports_of(checked, ast, owner, owner)
    let next = checker.check_module_headers(base, source_snapshot.syntax(snapshot), map.from([("helper", exports)]))
    let actual = replay(admitted, next, snapshot)
    assert actual.reused == hits
    assert call_result_equal(actual, checker.check_module_body_products(next))
  }
  # A path answer is independently observed: leave the signature tables
  # untouched so only canonical alias revalidation can see this edit.
  let redirected = ModuleHeaders { ..old, cx: Cx { ..old.cx,
    module_aliases: map.insert(old.cx.module_aliases, "dep", "replacement") } }
  let actual = replay(admitted, redirected, snapshot)
  assert actual.reused == 1 && actual.cold_rejected == 1
  assert call_result_equal(actual, checker.check_module_body_products(redirected))
}

test "scalar replay call admission excludes unsupported callees" {
  let scope = identity.module_key("calls", "sample", "sample", "sample.dawn")
  for source in [
    "fn leaf(x: Int = 1) -> Int = x\nfn caller() -> Int = leaf()\n",
    "fn leaf[T](x: T) -> T = x\nfn caller() -> Int = leaf(1)\n",
    "fn caller() -> Int = to_int(1.0)\n",
    "fn leaf(x: Int) -> Int = x\nfn caller() -> Int = 1.leaf()\n",
    "fn leaf(x: Int) -> Int = x\nfn caller(x: Int) -> Int = x.leaf()\n",
    "fn caller(f: fn() -> Int) -> Int = f()\n",
    "fn leaf() -> Int !io = 1\nfn caller() -> Int !io = leaf()\n",
    "trait Value[T] { fn value(x: T) -> Int }\nimpl Value[Int] { fn value(x: Int) -> Int = x }\nfn caller() -> Int = value(1)\n",
    "fn leaf(x: Int) -> Int = x\nfn caller() -> Int = leaf(x: 1)\n"
  ] {
    let snapshot = source_snapshot.of(source).expect("unsupported call")
    let old = checker.check_module_headers(cx_new(Some("sample"), Some("sample.dawn")),
      source_snapshot.syntax(snapshot), map.empty())
    let saved = body_execution.record(scope, old)
    assert checker.check_module_body_products(old).cx.diags == []
    let admitted: AdmittedData = admit(scope, old, snapshot, saved)
    let ready = admitted.ready.expect("ready headers")
    for (_, prior) in map.entries(ready.entries) { assert prior.syntax.name != "caller" }
    let actual = replay(admitted, old, snapshot)
    assert call_result_equal(actual, checker.check_module_body_products(old))
  }
}

test "scalar replay call argument binders retain alias collision diagnostics" {
  let scope = identity.module_key("calls", "sample", "sample", "sample.dawn")
  let source = "fn leaf(v: Int) -> Int = v\nfn caller() -> Int = leaf({ let x = 1\n x })\n"
  let before = source_snapshot.of(source).expect("call binders")
  let after = source_snapshot.of("use helper as x\n" ++ source).expect("alias edit")
  let ps = source_snapshot.syntax(source_snapshot.of("pub fn value() -> Int = 1\n").expect("provider"))
  let (pc, _) = checker.check_module(cx_new(Some("helper"), None), ps, map.empty())
  let env = map.from([("helper", checker.exports_of(pc, ps, "helper", "helper"))])
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(before), env)
  let next = checker.check_module_headers(base, source_snapshot.syntax(after), env)
  let admitted = admit(scope, old, before, body_execution.record(scope, old))
  assert admitted_count(admitted) == 2
  let actual = replay(admitted, next, after)
  assert actual.reused == 1 && actual.cold_unadmitted == 1
  let cold = checker.check_module_body_products(next)
  assert cold.cx.diags != [] && call_result_equal(actual, cold)
}

test "scalar replay call namespaces and conflicting owners fail closed independently" {
  let scope = identity.module_key("calls", "sample", "sample", "sample.dawn")
  let source = "fn leaf() -> Int = 1\nfn caller() -> Int = leaf()\n"
  let snapshot = source_snapshot.of(source).expect("calls")
  let old = checker.check_module_headers(cx_new(Some("sample"), Some("sample.dawn")),
    source_snapshot.syntax(snapshot), map.empty())
  let saved = body_execution.record(scope, old)
  let admitted = admit(scope, old, snapshot, saved)
  let leaf = map.get(old.cx.fns, "leaf").expect("leaf signature")
  let replacement = Sig { ..leaf, owner: Some("replacement") }
  # Keep the old canonical callee reachable, but change the selected spelling.
  # Header availability alone must not be mistaken for namespace equality.
  let changed = ModuleHeaders { ..old, cx: Cx { ..old.cx,
    fns: map.insert(old.cx.fns, "leaf", replacement),
    module_fn_sigs: map.insert(old.cx.module_fn_sigs, ("retained", "leaf"), leaf) } }
  let prepared = prepare(admitted, old, snapshot).expect("prepared calls")
  let caller = match old.syntax.decls[1] { DFn(d) -> d, _ -> panic("caller") }
  let caller_sig = map.get(old.cx.fns, "caller").expect("caller signature")
  let (_, verdict) = candidate(prepared, changed.cx, caller, caller_sig)
  assert match verdict { Rejected -> true, _ -> false }
  let conflict = ModuleHeaders { ..old, cx: Cx { ..old.cx,
    module_fn_sigs: map.insert(old.cx.module_fn_sigs, ("conflict", "leaf"), Sig { ..leaf, ret: TyBool }) } }
  assert not header_callee(callee_index.of(conflict.cx), conflict.cx, leaf)
  let refused = replay(admitted, conflict, snapshot)
  assert refused.reused == 1 && refused.cold_rejected == 1
  assert call_result_equal(refused, checker.check_module_body_products(conflict))
  # Import aliases are not declaring owners; changing one lookup must be
  # detected even when the previous canonical signature remains in the index.
  let qualified_source = "use helper as dep\nfn caller() -> Int = dep.leaf()\n"
  let provider_syntax = source_snapshot.syntax(source_snapshot.of("pub fn leaf() -> Int = 1\n").expect("provider"))
  let (provider, _) = checker.check_module(cx_new(Some("helper"), None), provider_syntax, map.empty())
  let exp = checker.exports_of(provider, provider_syntax, "helper", "helper")
  let qs = source_snapshot.of(qualified_source).expect("qualified caller")
  let qh = checker.check_module_headers(cx_new(Some("sample"), Some("sample.dawn")),
    source_snapshot.syntax(qs), map.from([("helper", exp)]))
  let qsig = map.get(qh.cx.module_fn_sigs, ("dep", "leaf")).expect("qualified signature")
  let swapped = ModuleHeaders { ..qh, cx: Cx { ..qh.cx,
    module_fn_sigs: map.insert(map.insert(qh.cx.module_fn_sigs, ("retained", "leaf"), qsig),
      ("dep", "leaf"), Sig { ..qsig, owner: Some("replacement") }) } }
  let result = replay(admit(scope, qh, qs, body_execution.record(scope, qh)), swapped, qs)
  assert result.reused == 0 && result.cold_rejected == 1
  assert call_result_equal(result, checker.check_module_body_products(swapped))
}

test "provider effect edits keep mixed replay identical to cold checking" {
  let scope = identity.module_key("qualified-effects", "sample", "sample", "sample.dawn")
  let source = "use helper as dep\nfn stable() -> Int = 42\n" ++
    "fn handled() -> Int = { with handle dep.Ask { ask() => 42 }\n dep.ask() }\n"
  let snapshot = source_snapshot.of(source).expect("consumer snapshot")
  let original = "pub effect Ask { fn ask() -> Int }\n"
  let syntax = source_snapshot.syntax(source_snapshot.of(original).expect("provider snapshot"))
  let (provider, _) = checker.check_module(cx_new(Some("helper"), None), syntax, map.empty())
  let exp = checker.exports_of(provider, syntax, "helper", "helper")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(snapshot), map.from([("helper", exp)]))
  let saved = body_execution.record(scope, old)
  for pair in [
    ("helper", original),
    ("helper", "pub type Unrelated = { value: Int }\n" ++ original),
    ("helper", "effect Ask { fn ask() -> Int }\n"),
    ("helper", "pub effect Other { fn ask() -> Int }\n"),
    ("helper", "pub effect Ask { fn ask() -> String }\n"),
    ("helper", "pub effect Ask { fn ask() -> Int\n fn extra() -> Int }\n"),
    ("replacement", original)
  ] {
    let (owner, text) = pair
    let provider_syntax = source_snapshot.syntax(source_snapshot.of(text).expect("provider edit"))
    let (candidate, _) = checker.check_module(cx_new(Some(owner), None), provider_syntax, map.empty())
    let candidate_exports = checker.exports_of(candidate, provider_syntax, owner, owner)
    let next = checker.check_module_headers(base, source_snapshot.syntax(snapshot), map.from([("helper", candidate_exports)]))
    let actual = replay(admit(scope, old, snapshot, saved), next, snapshot)
    let expected = checker.check_module_body_products(next)
    assert actual.bodies.functions == expected.functions
    assert actual.bodies.cx.diags == expected.cx.diags
    assert actual.bodies.cx.syms == expected.cx.syms
    assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
    # Handler bodies stay outside scalar admission; unrelated pure bodies
    # remain reusable even when the provider's effect declaration changes.
    assert actual.reused == 1 && actual.checked == 1
  }
}

test "scalar replay moves unchanged bodies through the current scheduler" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n"
  let after = "type Added = { value: Int }\nfn other(x: Int) -> Int = x\n# moved\nfn answer() -> Int = 42\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let new_syntax = source_snapshot.syntax(next_snapshot)
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, new_syntax, map.empty())
  let saved = body_execution.record(scope, old)
  assert saved.refused == 0
  assert snapshot_matches(old, old_snapshot) && snapshot_matches(next, next_snapshot)
  let sig = map.get(next.cx.fns, "answer").expect("answer header")
  let declaration = match new_syntax.decls[2] { DFn(d) -> d, _ -> panic("answer syntax") }
  assert parameters(declaration, sig) != None
  assert match table(scope, old) { Some(_) -> true, None -> false }
  assert match table(scope, next) { Some(_) -> true, None -> false }
  let admitted: AdmittedData = admit(scope, old, old_snapshot, saved)
  assert match prepare(admitted, next, next_snapshot) {
    Some(p) -> match candidate(p, next.cx, declaration, sig) { (_, Reused(_)) -> true, _ -> false }
    None -> false
  }
  # The index the preparation carries is the revision's own: on a real
  # candidate revision it answers every declared callee the way the scan it
  # replaced does.
  let prepared = prepare(admitted, next, next_snapshot).expect("prepared candidate")
  let no_trait: Option[Int] = None
  for (_, declared) in map.entries(next.cx.fns) {
    assert callee_index.signature(prepared.callees, next.cx, declared.owner, declared.name, false, no_trait) ==
      callee_index.scanned_signature(next.cx, declared.owner, declared.name, false, no_trait)
  }
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 2 && actual.checked == 0
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.constants == expected.constants
  assert actual.bodies.cx.frame == expected.cx.frame
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.cx.function_reads == expected.cx.function_reads
  assert actual.bodies.cx.body_writes == expected.cx.body_writes
}

test "scalar replay refuses a header that changed outside the declaration's own text" {
  # The two revisions spell `answer` with the same bytes, so the text half of
  # admission says yes. What changed is the alias its return type names, and
  # the signature is the only record of that: the recorded header has to
  # carry onto the candidate one field for field, or a body checked at `Int`
  # is reused for a declaration whose header says `Bool`.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "alias Answer = Int\nfn answer() -> Answer = 42\n"
  let after = "alias Answer = Bool\nfn answer() -> Answer = 42\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  let saved = body_execution.record(scope, old)
  assert saved.refused == 0
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 0 && actual.checked == 1
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.diags == expected.cx.diags
}

test "scalar replay finds a product by the candidate declaration's identity" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let saved = body_execution.record(scope, old)
  # A recorded product is reachable only under the key the enumeration gives
  # the candidate declaration in this revision. Reordering the declarations
  # keeps the keys and reuses both; renaming one leaves its product with no
  # key to be found under, and the other product is still found under its own.
  for (after, reused) in [
    ("fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n", 2),
    ("fn other(x: Int) -> Int = x\nfn answer() -> Int = 42\n", 2),
    ("fn renamed() -> Int = 42\nfn other(x: Int) -> Int = x\n", 1)
  ] {
    let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
    let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
    assert next.cx.diags == []
    let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
    let expected = checker.check_module_body_products(next)
    assert actual.reused == reused
    assert actual.bodies.functions == expected.functions
    assert actual.bodies.cx.syms == expected.cx.syms && actual.bodies.cx.decl_slots == expected.cx.decl_slots
  }
}

test "scalar replay revalidates recorded reads in place and through the projection" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let body = "fn compute(x: Int) -> Int = {\n let y = x + 1\n if y > 0 { y * 2 } else { -x }\n}\n"
  var compared = 0
  # The second pair shifts the candidate's allocation interval and every byte
  # offset, so agreement is asserted with the relocation carrying something.
  for (before, after) in [
    ("fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n",
      "type Added = { value: Int }\nfn other(x: Int) -> Int = x\n# moved\nfn answer() -> Int = 42\n"),
    ("fn prefix() -> Int = 0\n" ++ body,
      "type Added = { n: Int }\nfn prefix(a: Int, b: Int) -> Int = a + b\n# shifted\n" ++ body)
  ] {
    let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
    let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
    let new_syntax = source_snapshot.syntax(next_snapshot)
    let base = cx_new(Some("sample"), Some("sample.dawn"))
    let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
    let next = checker.check_module_headers(base, new_syntax, map.empty())
    let saved = body_execution.record(scope, old)
    let admitted: AdmittedData = admit(scope, old, old_snapshot, saved)
    let prepared = prepare(admitted, next, next_snapshot).expect("prepared candidate revision")
    for entry in identity.declarations(scope, new_syntax) {
      match new_syntax.decls[entry.declaration] {
        DFn(d) -> {
          let sig = map.get(next.cx.fns, d.name).expect("candidate header")
          match relocation(prepared, next.cx, d, sig) {
            Some((prior, view)) -> {
              let reads = prior.product.function_reads.expect("recorded log")
              let moved = body_product.projected_reads(view, prior.product, (owner, source) => None)
                .expect("projected log").expect("enabled log")
              assert len(moved) == len(reads) && len(reads) > 0
              var i = 0
              for read in reads {
                let in_place = checker.revalidate_read(next.cx, read)
                assert in_place == checker.revalidate_read(next.cx, moved[i])
                assert in_place == Some(true)
                compared = compared + 1
                i = i + 1
              }
            }
            None -> ()
          }
        }
        _ -> ()
      }
    }
  }
  assert compared == 3
}

test "scalar replay relocates lexical locals after changed allocation prefixes" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let body = "fn compute(x: Int) -> Int = {\n let y = x + 1\n if y > 0 { y * 2 } else { -x }\n}\n"
  let before = "fn prefix() -> Int = 0\n" ++ body
  let after = "type Added = { n: Int }\nfn prefix(a: Int, b: Int) -> Int = a + b\n# shifted\n" ++ body
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 1 && actual.checked == 1
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.frame == expected.cx.frame
  assert actual.bodies.cx.diags == expected.cx.diags
}

test "scalar replay refuses changed inputs and preserves current observation modes" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let saved = body_execution.record(scope, old)
  for (text, hits) in [
    ("# moved\nfn answer() -> Int = 42\n", 1),
    ("fn answer() -> Int = 43\n", 0),
    ("fn answer() -> Bool = true\n", 0),
    ("fn answer(x: Int) -> Int = x\n", 0),
    ("fn answer() = 42\n", 0),
    ("fn renamed() -> Int = 42\n", 0),
    ("fn answer() -> Int = { 42 }\n", 0)
  ] {
    let next_snapshot = source_snapshot.of(text).expect("candidate snapshot")
    let headers = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
    for logging in [false, true] {
      let next = ModuleHeaders { ..headers, cx: Cx { ..headers.cx,
        in_test: true, const_cutoff: Some(set.empty()), take_cell: Some(999),
        loop_jumps: set.from([999]), frame: Frame { ..headers.cx.frame, isolated: true },
        function_reads: if logging { Some([AssignableType(TyUnit, TyUnit, true)]) } else { None },
        body_writes: if logging { Some([]) } else { None } } }
      let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
      let expected = checker.check_module_body_products(next)
      assert actual.reused == hits && actual.checked == 1 - hits
      assert actual.bodies.functions == expected.functions
      assert actual.bodies.cx.frame == expected.cx.frame
      assert actual.bodies.cx.in_test == expected.cx.in_test
      assert actual.bodies.cx.const_cutoff == expected.cx.const_cutoff
      assert actual.bodies.cx.take_cell == expected.cx.take_cell
      assert actual.bodies.cx.loop_jumps == expected.cx.loop_jumps
      assert actual.bodies.cx.function_reads == expected.cx.function_reads
      assert actual.bodies.cx.body_writes == expected.cx.body_writes
      assert actual.bodies.cx.diags == expected.cx.diags
      let trailing = source_snapshot.of(before ++ "# wrong snapshot\n").expect("trailing comment")
      let mismatch = replay(admit(scope, old, trailing, saved), next, next_snapshot)
      # A different comment-only snapshot parses to the same tree and is safe:
      # its body coordinates are unchanged. Changed parsed input is not.
      assert mismatch.reused == hits
      let wrong = source_snapshot.of("fn wrong() -> Int = 42\n").expect("unrelated module")
      let unrelated = replay(admit(scope, old, wrong, saved), next, next_snapshot)
      assert unrelated.reused == 0 && unrelated.checked == 1
      let added = source_snapshot.of(before ++ "fn extra() -> Int = 0\n").expect("added declaration")
      let extra = replay(admit(scope, old, added, saved), next, next_snapshot)
      assert extra.reused == 0 && extra.checked == 1
    }
  }
}

test "scalar replay refuses binders that shadow candidate module aliases" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let dep_syntax = source_snapshot.syntax(
    source_snapshot.of("pub fn one() -> Int = 1\n").expect("dependency snapshot"))
  let (dep_cx, _) = checker.check_module(cx_new(Some("dep"), Some("dep.dawn")), dep_syntax, map.empty())
  assert dep_cx.diags == []
  let env = map.from([("dep", checker.exports_of(dep_cx, dep_syntax, "dep", "dep"))])
  let before = "fn compute(x: Int) -> Int = {\n let y = x + 1\n y\n}\n"
  let after = "use dep as y\n" ++ before
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), env)
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), env)
  assert old.cx.diags == [] && next.cx.diags == []
  assert map.has(next.cx.module_aliases, "y")
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  let cold_diags: Int = len(expected.cx.diags)
  assert cold_diags == 1
  assert actual.reused == 0 && actual.checked == 1
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.syms == expected.cx.syms
}

test "scalar replay refuses a declaration whose own text changed" {
  # `answer` only moved, so its saved body is admitted: its spans are offsets
  # into text that did not change. `other` lexes to the same tokens but gained
  # a space inside it, which moved every offset into its interior. It is
  # checked cold, and the two functions together are what the cold check would
  # have produced. Drop the byte comparison at the admission point and the
  # second one comes back with the offsets of the revision it was recorded
  # from, which this comparison reads.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n"
  let after = "# moved\nfn answer() -> Int = 42\nfn other(x: Int) -> Int =  x\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  assert saved.refused == 0
  # the token pairing alone cannot tell these two declarations apart
  let old_tokens = source_snapshot.tokens(old_snapshot)
  let next_tokens = source_snapshot.tokens(next_snapshot)
  let old_other = match source_snapshot.syntax(old_snapshot).decls[1] { DFn(d) -> d, _ -> panic("other") }
  let new_other = match source_snapshot.syntax(next_snapshot).decls[1] { DFn(d) -> d, _ -> panic("other") }
  assert source_projection.pair(old_tokens, next_tokens, 1, 1,
    old_other.lo, old_other.hi, new_other.lo, new_other.hi)
  assert not source_projection.same_text(old_tokens, next_tokens,
    old_other.lo, old_other.hi, new_other.lo, new_other.hi)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 1 && actual.checked == 1
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
}

test "scalar replay refuses re-parsed statement boundaries with equal tokens" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn compute(x: Int) -> Int = {\n let a = 1\n let b = a\n - x\n}\n"
  let after = "fn compute(x: Int) -> Int = {\n let a = 1\n let b = a - x\n}\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  assert snapshot_matches(old, old_snapshot) && snapshot_matches(next, next_snapshot)
  let saved = body_execution.record(scope, old)
  assert saved.refused == 0
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  let cold_diags: Int = len(expected.cx.diags)
  assert cold_diags == 1
  assert actual.reused == 0 && actual.checked == 1
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
}

test "scalar replay assembles the candidate revision's declarations in its own order" {
  # The assembly boundary, stated as one sentence: what comes out is the
  # candidate revision's declarations, in the order that revision writes them,
  # whichever of them were reused and whichever were checked cold. Reuse does
  # not move a declaration, does not drop one, and does not append one at the
  # end. The order is the scheduler's rather than this module's: `replay`
  # hands its executor to `checker.execute_module_bodies`, the same one the
  # cold path runs. So what is pinned here is the literal order and not only
  # its agreement with cold, which would survive the scheduler reversing both
  # paths at once.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn one() -> Int = 1\nfn two(s: String) -> String = s\n" ++
    "fn three() -> Int = 3\nfn four(s: String) -> String = s\n"
  let after = "type Added = { n: Int }\n" ++ before
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  # `one` and `three` are admitted, `two` and `four` are not (a String is not
  # a primitive), so the two verdicts alternate down the declaration list.
  assert actual.reused == 2 && actual.checked == 2
  assert map(actual.bodies.functions, f => f.name) == ["one", "two", "three", "four"]
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.diags == expected.cx.diags
}

test "scalar replay raises the diagnostics of a mixed assembly in cold order" {
  # The other half of the boundary. A diagnostic is appended to `cx.diags` as
  # it is raised, so the diagnostic order is the order the scheduler visited
  # the declarations in, and a replay that interleaved a reused body with a
  # cold one has to produce the cold list item for item.
  #
  # Reuse stops at the first diagnostic: `relocation` refuses a candidate
  # context that already carries one, so `three` is checked cold here although
  # its own bytes did not change and the diagnostic-free revision above reuses
  # the same body. That is the shape of a mixed assembly today, and it is
  # asserted rather than assumed.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn one() -> Int = 1\nfn two() -> Int = missing_a\n" ++
    "fn three() -> Int = 3\nfn four() -> Int = missing_b\n"
  let after = "type Added = { n: Int }\n" ++ before
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 1 && actual.checked == 3
  assert map(actual.bodies.functions, f => f.name) == ["one", "two", "three", "four"]
  assert map(actual.bodies.cx.diags, d => d.msg) ==
    ["undefined variable: missing_a", "undefined variable: missing_b"]
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
}

test "scalar replay counts unsupported bodies across every cold executor role" {
  # The cold remainder, counted by declaration category rather than in total.
  # Four executor roles are always cold; explicit and inferred functions are
  # also cold when their products are outside the admitted class. This fixture
  # keeps its inferred list body unsupported. A census of this very
  # revision says how many of each there are, and the count `replay` reports
  # has to be exactly that sum. A category that stopped being counted, or one
  # that started being reused without a product, breaks the identity.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "const K: Int = 7\n" ++
    "fn reused() -> Int = 1\n" ++
    "fn cold_one(s: String) -> String = s\n" ++
    "fn inferred() = [2]\n" ++
    "trait Greet[T] {\n fn greet(x: T) -> Int = 5\n}\n" ++
    "trait Named[T] { fn describe(x: T) -> Int }\n" ++
    "type Box[T] = { item: T }\n" ++
    "impl[T] Named[Box[T]] { fn describe(x: Box[T]) -> Int = 1 }\n" ++
    "test \"probe\" { assert true }\n"
  let after = "type Added = { n: Int }\n" ++ before
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  # One cold pass over the candidate revision that answers only "which role
  # was this declaration dispatched under". It is the cold executor with a
  # tally beside it, so the census cannot disagree with what cold checking
  # does; `replay`'s own counter is the thing being measured against it.
  let cold: BodyExecutor[Map[String, Int]] = checker.cold_body_executor()
  let bump = (seen: Map[String, Int], role: String) => map.insert(seen, role,
    match map.get(seen, role) { Some(n) -> n + 1, None -> 1 })
  let census: BodyExecutor[Map[String, Int]] = BodyExecutor {
    function: (s, cx, d, sig) => {
      let (_, c, t) = cold.function(s, cx, d, sig)
      (bump(s, "function"), c, t)
    },
    inferred_body: (s, cx, d, sig) => {
      let (_, c, t) = cold.inferred_body(s, cx, d, sig)
      (bump(s, "inferred_body"), c, t)
    },
    constant: (s, cx, d, ty, visible) => {
      let (_, c, t) = cold.constant(s, cx, d, ty, visible)
      (bump(s, "constant"), c, t)
    },
    method: (s, cx, tr, subject, d, sig) => {
      let (_, c, t) = cold.method(s, cx, tr, subject, d, sig)
      (bump(s, "method"), c, t)
    },
    default_body: (s, cx, tr, d, sig, b) => {
      let (_, c, t) = cold.default_body(s, cx, tr, d, sig, b)
      (bump(s, "default_body"), c, t)
    },
    test_body: (s, cx, name, b) => {
      let (_, c, t) = cold.test_body(s, cx, name, b)
      (bump(s, "test_body"), c, t)
    }
  }
  let (roles, _) = checker.execute_module_bodies(next, map.empty(), census)
  # Every category the executor has is present, so no row of the identity
  # below is vacuous.
  assert roles == map.from([("function", 2), ("inferred_body", 1), ("constant", 1),
    ("method", 1), ("default_body", 1), ("test_body", 1)])
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  let function_census = map.get(roles, "function").expect("function census")
  # Every declaration the scheduler dispatched leaves the pass through exactly
  # one of the three columns, and the cold remainder is the two cold ones
  # added up. The census says how many of each category there were; the
  # columns say what this pass did with them.
  assert actual.reused + actual.cold_unadmitted + actual.cold_rejected ==
    function_census +
    map.get(roles, "inferred_body").expect("inferred body census") +
    map.get(roles, "constant").expect("constant census") +
    map.get(roles, "method").expect("method census") +
    map.get(roles, "default_body").expect("default body census") +
    map.get(roles, "test_body").expect("test body census")
  assert actual.checked == actual.cold_unadmitted + actual.cold_rejected
  # Nothing here is rejected: the one function outside the class is outside it
  # by its parameter type, which is an admission question and not a fact that
  # stopped holding.
  assert actual.reused == 1 && actual.cold_unadmitted == 6 && actual.cold_rejected == 0
  assert actual.checked == 6
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.constants == expected.constants
  assert actual.bodies.impl_methods == expected.impl_methods
  assert actual.bodies.trait_defaults == expected.trait_defaults
  assert actual.bodies.tests == expected.tests
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.diags == expected.cx.diags
}

test "scalar replay reuses an admitted body when a trait declaration is added" {
  # One cell of the edit table: a trait declaration appears beside a body that
  # is admitted, and neither what that body checks to nor the module the
  # replay assembles may change. What makes the edit safe is not that traits
  # are unrelated to bodies: it is that this admitted class cannot name one.
  # `parameters` refuses a signature with a bound on a type parameter, with
  # effect parameters or with a trait id, and `scalar_shape.binders` refuses
  # every call node, so an admitted body has no trait to be wrong about. What the
  # edit does move is the declaration index of everything after it and every
  # byte offset into it, which is the half admission has to survive.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let body = "fn compute(x: Int) -> Int = {\n let y = x + 1\n if y > 0 { y * 2 } else { -x }\n}\n"
  let declared = "trait Named[T] { fn describe(x: T) -> Int }\n"
  let before = body
  let after = declared ++ body
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 1 && actual.checked == 0
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.constants == expected.constants
  assert actual.bodies.impl_methods == expected.impl_methods
  assert actual.bodies.trait_defaults == expected.trait_defaults
  assert actual.bodies.tests == expected.tests
  assert actual.bodies.cx.frame == expected.cx.frame
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.owner_decl == expected.cx.owner_decl
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.cx.function_reads == expected.cx.function_reads
  assert actual.bodies.cx.body_writes == expected.cx.body_writes
}

test "scalar replay reuses an admitted body when a trait declaration is removed" {

# expect: expected `,` or `]`, found `2`
# expect: expected `,` or `)`, found `2`
# expect: expected `,` or `}`, found `y`
# The list and tuple forms of the missing-comma recovery (#190), and the record
# form across lines: a newline separates list elements but not record fields, so
# a field name at the start of the next line is still a missing comma. Only a
# token that can begin the next item counts; each literal still ends at its own
# closer, which is why the declarations after them parse cleanly.
fn h() -> List[Int] = [1 2, 3]
fn t() -> (Int, Int) = (1 2)
fn r() -> P = P {
  x: 1
  y: 2
}
fn k() -> Int = 3

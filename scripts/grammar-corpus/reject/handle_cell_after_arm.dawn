# expect: a handler's state cells must all come before its arms
# expect: allowed at module top level
# Cells all stand ahead of the arms, so a reader never has to wonder whether
# the declaration order inside the braces means something
# (docs/handler-state-design.md §4.1).
effect Ask {
  fn ask() -> Int
}

fn f() -> Int = {
  with handle Ask {
    ask() => 1
    var n: Int = 0
  }
  ask()
}

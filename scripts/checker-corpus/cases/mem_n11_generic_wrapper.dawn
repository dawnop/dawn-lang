# checker.dawn: R1 on a generic wrapper around `with_mem` (N11). Inside `scope`
# the result is the type variable `T`, which the walk cannot see through, and
# the call that picks `T := I64Buf` is a call to `scope`, not to `with_mem`.
# The rule refuses the variable itself.
use std/mem
use std/mem.{Mem}

pub fn scope[T](f: fn() -> T !Mem) -> T = mem.with_mem(f)

# the instantiation that would have let a buffer out
pub fn escaped() -> Int = len(scope(() => mem.new(4)))

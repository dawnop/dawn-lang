# Byte literals must preserve binary content through independent compiler
# hosts and through both reconstruction paths. Fixed vectors below include
# nested data, a large payload and Float bits that ordinary text cannot carry.
# generate.py adds boundary families and independent expected values.

use std/bytes
use std/cursor
use sha2/sha256
use inflate/crc32
use data
fn filled(n: Int) -> Bytes = {
  var b = bytes.utf8("x")
  while len(b) < n { b = b ++ b }
  bytes.slice(b, 0, n)
}
const EMPTY: Bytes = bytes.utf8("")
const RAW: Bytes = data.RAW
const ALL: Bytes = bytes.pack_ints(range(0, 256), 1)
const BIG: Bytes = filled(1048576)
const DUP: Bytes = BIG
const EDGE: Bytes = filled(16385)
const EDGE_LO: Bytes = filled(16383)
const EDGE_AT: Bytes = filled(16384)
const CLASS_EDGE: Bytes = filled(65536)
const CURSOR_SUMMARY: String = comptime {
  let c = cursor.start("a😀")
  to_string(c)
}
const HASH: String = sha256.hex(bytes.utf8("abc"))
const CRC: Int = crc32.sum(bytes.utf8("123456789"))
const BASE64: Bytes = bytes.from_base64("AH+A/w==").expect("valid")
const FN_VALUE: Bytes = comptime {
  let f: fn(String) -> Bytes = bytes.utf8
  f("abc")
}
const NAN: Float = bytes.unpack_floats(bytes.from_hex("341200000000f87f").expect("valid"), 8)[0]
const NAN_BYTES: Bytes = bytes.pack_floats([NAN], 8)
type Packet = { data: Bytes }
opaque type Token = Bytes
const TOK: Token = RAW
const NEST: (Packet, List[Bytes], Option[Bytes]) = (Packet { data = RAW }, [RAW, EMPTY], Some(RAW))
fn token(x: Token) -> Bytes = x
fn require(ok: Bool) -> Unit = if ok { () } else { panic("literal mismatch") }
fn generated_checks() -> Unit = ()

pub fn main() -> Unit !io = {
  require(len(EMPTY) == 0)
  require(bytes.to_hex(RAW) == "007f80ff")
  require(bytes.to_hex(token(TOK)) == "007f80ff")
  require(len(ALL) == 256)
  for i in 0..256 { require(bytes.at(ALL, i) == i) }
  require(len(BIG) == 1048576 && BIG == DUP)
  require(len(EDGE) == 16385)
  for b in BIG { require(b == 120) }
  match NEST {
    (p, xs, Some(b)) -> {
      require(p.data == RAW && xs == [RAW, EMPTY] && b == RAW)
    }
    _ -> { require(false) }
  }
  require(bytes.to_hex(bytes.pack_floats([NAN], 8)) == "341200000000f87f")
  require(bytes.to_hex(NAN_BYTES) == "341200000000f87f")
  require(len(EDGE_LO) == 16383 && len(EDGE_AT) == 16384 && len(CLASS_EDGE) == 65536)
  require(BASE64 == RAW && FN_VALUE == bytes.utf8("abc"))
  require(HASH == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  require(HASH == sha256.hex(bytes.utf8("abc")))
  require(CRC == 0xCBF43926 && CRC == crc32.sum(bytes.utf8("123456789")))
  require(CURSOR_SUMMARY == "<cursor>")
  generated_checks()
  println("byte literals ok")
}

# The parenthesised spelling of the same construction, which is an ordinary
# application over a constructor head (SYN-02) and reaches the pipe as an
# EApply rather than as an ECtor.
type Sum = Zero | One(x: Int)

fn unbox(s: Sum) -> Int =
  match s {
    Zero -> 0
    One(x) -> x
  }

pub fn main() -> Unit !io = println("${unbox(7 |> One())}")

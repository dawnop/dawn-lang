# Page shells: <head>, the sky band with the navigation and the page's head,
# the footer. Triple-quoted templates keep the attribute quotes unescaped;
# $-interpolation fills the holes.
#
# Every page but the front one is laid out the same way (docs/site-pages-
# design.md): a short sky that holds the nav and the page's title and ends on
# the site's gradient line, then the page. The nav is one piece of markup the
# front page uses too, set into its own, taller sky (gen/home.dawn).
#
# Every shell takes its language explicitly. There is no defaulted overload on
# purpose: every page exists in both languages, so a wrapper that quietly
# picked one would be wrong on half of the pages whichever one it picked.

use std/str
use md/ast.{Inline, Em, Link, Text}
use html/render.{TocEntry, split_number, twin_link, inline_text}
use html/escape.{escape_html, escape_attr}

## Which language a page is written in. English is the site's default and
## lives at `/`; its Chinese twin lives at the same path under `/zh/`. Every
## page of this site is paired that way: the front page, the tutorial, the
## specification, the design notes, the standard library reference, the example
## gallery, the Playground and the Demo page. (The 404 page is the one page
## with no twin: it is served at whatever URL was missed.) The spec and the design notes were the last two
## to join (2026-08-07) and are the one pair whose *original* is the Chinese
## one -- which the layout does not care about, and neither does anything here.
pub type Lang =
  | En
  | Zh
derive Show

## The file names, inside /assets/, of the shared files a page links to.
##
## Not constants, because they are not constant: gen/fingerprint puts a hash of
## each file's content into its name, so that the one-year `immutable` cache
## header the server sends is a promise the URL can keep. gen_assets writes the
## files and hands back the names it wrote; a shell links to what it is given
## and knows nothing about how the names were chosen.
##
## A record rather than a name->name map: a typo in a field is a compile error,
## where a typo in a lookup key is a link to nothing that only the link check
## would catch, and only after the whole site had been written.
pub type Assets = {
  style: String,
  logo: String,
  favicon: String,
  touch_icon: String,
  og_image: String,
  play_css: String,
  play_js: String,
  tea_js: String,
  tea_counter: String,
  tea_todo: String,
  # The search panel: the page's own script, the reactor it mounts, and one
  # index per language. Two indexes and not one because they carry different
  # titles and different hrefs -- see gen/search.dawn -- and the shell picks
  # the one that belongs to the page it is writing.
  search_js: String,
  # The bridge the panel loads, one file per thread: the page's half, which
  # applies patches, and the worker the reactor runs in (gen/pages
  # .emit_search_bridge).
  search_app: String,
  search_worker: String,
  search_wasm: String,
  search_en: String,
  search_zh: String,
  # The body index, one per language for the same reason (gen/search_body,
  # docs/site-search-design.md). Named on the panel's mount point rather than
  # on the button, because it is the panel's second fetch, not the first.
  search_body_en: String,
  search_body_zh: String,
  # The front page's own stylesheet and script, and the monospace face. Only
  # the front page links the first two (gen/home.dawn): its sky, its sections
  # and its orbit are that page's alone. The face is every page's -- the
  # shared stylesheet names it, by its hashed name (gen/pages.gen_assets) --
  # and is named here only so that the front page can preload it, its hero's
  # code window being above the fold.
  home_css: String,
  home_js: String,
  mono_font: String,
  # Every page's theme script: the saved theme put on <html> before the first
  # paint, the toggle, and the contents fold (docs/site-pages-design.md).
  theme_js: String,
  # Not files: the release and the commit this site was built from, as the
  # footer prints them ("version 0.81.0 (1a2b3c4d)"), each "" when the build
  # was not told. They ride here because this is the one record every shell
  # is handed by the one function that reads the build's inputs
  # (gen/pages.gen_assets). The release is also what the spec's eyebrow
  # names as the version it applies to.
  version: String,
  commit: String,
  # Not a file either: the cat out of the mark (site/assets/logo.svg), as the
  # path [cat_path] reads, for the one that peeks over each page's band.
  # "" draws no cat, which is what the tests' plain assets do.
  cat: String,
}

## The names the files have in site/assets, before any hashing. What the tests
## in this repository link to, so that they read as the markup a browser gets.
pub fn plain_assets() -> Assets =
  Assets {
    style: "style.css",
    logo: "logo.svg",
    favicon: "favicon.ico",
    touch_icon: "apple-touch-icon.png",
    og_image: "logo-512.png",
    play_css: "playground.css",
    play_js: "playground.js",
    tea_js: "tea-app.mjs",
    tea_counter: "tea-counter.wasm",
    tea_todo: "tea-todo.wasm",
    search_js: "search.js",
    search_app: "tea-remote.mjs",
    search_worker: "tea-worker.mjs",
    search_wasm: "tea-search.wasm",
    search_en: "search-en.json",
    search_zh: "search-zh.json",
    search_body_en: "search-body-en.json",
    search_body_zh: "search-body-zh.json",
    home_css: "home.css",
    home_js: "home.js",
    mono_font: "JetBrainsMono-Regular.woff2",
    theme_js: "theme.js",
    version: "",
    commit: "",
    cat: "",
  }

## The `lang` attribute for <html>.
pub fn lang_code(lang: Lang) -> String =
  match lang {
    En -> "en"
    Zh -> "zh-CN"
  }

fn other(lang: Lang) -> Lang =
  match lang {
    En -> Zh
    Zh -> En
  }

## What the link to the other language says -- written in the language it
## leads to, which is the only way it is readable to the person who needs it.
fn lang_switch_label(lang: Lang) -> String =
  match lang {
    En -> "中文"
    Zh -> "English"
  }

## "Contents": the heading over the sticky TOC, and the label on the link a
## tutorial chapter carries back to the table of contents. One definition
## because they are one word -- two would be two things to keep level.
pub fn contents_label(lang: Lang) -> String =
  match lang {
    En -> "Contents"
    Zh -> "目录"
  }

## What a tutorial code block's prefilled link to the Playground says. In the
## markup rather than in the stylesheet: `content:` reaches a reader without
## passing through `Lang`, which is the bug gen/assets.dawn exists to catch.
pub fn playground_label(lang: Lang) -> String =
  match lang {
    En -> "Open in playground"
    Zh -> "在 Playground 打开"
  }

## What the header's search button says, in the language of the page it is on.
pub fn search_label(lang: Lang) -> String =
  match lang {
    En -> "Search"
    Zh -> "搜索"
  }

## Which index a page of this language fetches. One field per language on
## [Assets] rather than a lookup, for the reason the record itself is a record:
## a missing language is then a compile error, and a wrong one is a page of
## results in the other language whose links all resolve.
pub fn search_index_name(a: Assets, lang: Lang) -> String =
  match lang {
    En -> a.search_en
    Zh -> a.search_zh
  }

## Which body index a page of this language names, by the rule
## [search_index_name] gives.
pub fn search_body_name(a: Assets, lang: Lang) -> String =
  match lang {
    En -> a.search_body_en
    Zh -> a.search_body_zh
  }

## The search panel's mount point. It carries the body index's URL, relative
## to the page like the button's three, so that gen/links checks it as a
## fetched URL; the panel fetches it only once a reader has typed something.
## The front page lays out its own body (gen/home) and calls this too.
pub fn search_host(a: Assets, lang: Lang, root: String) -> String =
  """<div id="dawn-search" class="search-host" data-search-body="${root}/assets/${search_body_name(a, lang)}" hidden></div>"""

## Where a page lives in `lang`'s layout, given its path in the default one.
## The default layout is the English site; the Chinese twin of any paired page
## is that same path under `/zh/`. One rule, stated once, so that a caller
## naming a page names it once instead of writing two paths and letting one rot.
pub fn lang_path(lang: Lang, pair: String) -> String =
  match lang {
    En -> pair
    Zh -> "zh/${pair}"
  }

## site navigation: (key, label, path-from-root)
##
## Each language's nav points at that language's pages -- which is not the same
## list of paths, because all nine are paired and the Chinese half of each
## lives under `/zh/`. Two of them used to be the exception, named the same file from
## both navs and labelled `Spec (中文)` on the English side; the spec and the
## design notes were translated on 2026-08-07 and the exception is gone with
## them.
##
## History opens the timeline (docs/history.md, 2026-10-02), from the first
## commit to today. It used to open the design notes, labelled History /
## 设计史 because a nav item called Design beside Spec read as the current
## design; those notes are frozen at M7 and now sit under History as its early
## chapter, at their own URL and outside the nav. The Chinese label is 历史,
## the timeline's own title, now that the page is not a design history.
##
## GPU opens the cuTile backend's page (gpu.html, 2026-10-03). It sits after
## Stdlib and before History because it is reference, what the backend covers
## today, not a record of how it got there. Its Chinese label is GPU too: the
## word is the one Chinese writing about GPUs uses, the way Playground is kept,
## where Demo had a plain Chinese word to become.
##
## Packages opens the table of packages/* (packages.html, 2026-10-04), after
## Stdlib because it is the same kind of page: what you can `use`, read from
## the tree. Its Chinese label is 包, the word the docs use for a package.
pub fn nav_items(lang: Lang) -> List[(String, String, String)] =
  match lang {
    En -> [
      ("tutorial", "Tutorial", "tutorial/index.html"),
      ("spec", "Spec", "spec.html"),
      ("examples", "Examples", "examples/index.html"),
      ("stdlib", "Stdlib", "stdlib.html"),
      ("packages", "Packages", "packages.html"),
      ("gpu", "GPU", "gpu.html"),
      ("history", "History", "history.html"),
      ("playground", "Playground", "playground.html"),
      ("tea", "Demo", "tea.html"),
    ]
    Zh -> [
      ("tutorial", "教程", "zh/tutorial/index.html"),
      ("spec", "规范", "zh/spec.html"),
      ("examples", "示例", "zh/examples/index.html"),
      ("stdlib", "标准库", "zh/stdlib.html"),
      ("packages", "包", "zh/packages.html"),
      ("gpu", "GPU", "zh/gpu.html"),
      ("history", "历史", "zh/history.html"),
      ("playground", "Playground", "zh/playground.html"),
      ("tea", "演示", "zh/tea.html"),
    ]
  }

fn nav_link(root: String, active: String, item: (String, String, String)) -> String = {
  let (key, label, path) = item
  let cls = if key == active { ` class="active" aria-current="page"` } else { "" }
  """<a${cls} href="${root}/${path}">${label}</a>"""
}

fn nav_html(lang: Lang, root: String, active: String) -> String =
  join(map(nav_items(lang), it => nav_link(root, active, it)), "\n")

## Where a paired page lives, given `pair` -- its path in the DEFAULT layout,
## e.g. "index.html" or "tutorial/01.html". The Chinese twin is that same path
## under `/zh/`, which is the site's one layout rule, and stating it once here
## is what lets a caller name the pair with a single string instead of writing
## two hrefs and letting one of them rot. A trailing "index.html" comes off, so
## the front page keeps advertising itself as `/` and `/zh/`.
fn site_url(prefix: String, pair: String) -> String = {
  let clean = str.strip_suffix(pair, "index.html").unwrap_or(pair)
  site_origin() ++ prefix ++ clean
}

## Where the site is served from, with the trailing slash. The one absolute
## URL every other one is built on: hreflang, canonical, og:url, og:image, the
## sitemap. The generator's copy of DAWN_SITE_ORIGIN in scripts/repo.env, which
## the scripts read; scripts/check-no-server-identity.py holds the two equal.
pub fn site_origin() -> String = "https://dawn-lang.dawnop.com/"

## The repository's page on GitHub, no trailing slash: the header and footer
## links, release notes, and the docs and packages the site links to rather
## than renders. The generator's copy of DAWN_GITHUB_REPO in scripts/repo.env,
## held equal to it the same way.
pub fn repo_url() -> String = "https://github.com/dawnop/dawn-lang"

## A page's own absolute URL, as `site_url` spells it for `lang`'s half of
## the pair: what `rel=canonical` and `og:url` say. "" for a page with no
## pair, which has no URL this shell can name.
fn own_url(lang: Lang, pair: String) -> String =
  if pair == "" {
    ""
  } else {
    match lang {
      En -> site_url("", pair)
      Zh -> site_url("zh/", pair)
    }
  }

## What a search engine or a link preview shows under the title. One sentence
## per language for the whole site rather than one per page: every page is
## either the language or a document about it, and a per-page summary would be
## one more piece of prose per page to keep true.
pub fn site_description(lang: Lang) -> String =
  match lang {
    En -> "Dawn is a small, elegant functional language: immutable data, algebraic data "
      ++ "types with exhaustive matching, and effects in the type signature, compiled to "
      ++ "JVM bytecode and C."
    Zh -> "Dawn 是一门小而优雅的函数式语言：不可变数据、代数数据类型与穷尽匹配、写进类型签名的效果，"
      ++ "编译到 JVM 字节码与 C。"
  }

## The <head> lines that say what the page is to something other than a
## browser: the description, the page's own URL as canonical and as og:url,
## and og:type. The URL lines are left out for a page with no pair.
fn meta_html(lang: Lang, pair: String) -> String = {
  let desc = escape_attr(site_description(lang))
  let url = own_url(lang, pair)
  let urls =
    if url == "" {
      ""
    } else {
      "\n" ++ """<link rel="canonical" href="${escape_attr(url)}">""" ++ "\n"
        ++ """<meta property="og:url" content="${escape_attr(url)}">"""
    }
  """<meta name="description" content="${desc}">""" ++ "\n"
    ++ """<meta property="og:description" content="${desc}">""" ++ "\n"
    ++ """<meta property="og:type" content="website">""" ++ urls
}

## The alternate-language <link>s, emitted only on the pages that really have
## a twin. Absolute, because that is what hreflang wants; the pair is the same
## on both members of it, with x-default pointing at the English original.
##
## These used to be three constants naming the front page, which was right
## while the front page was the only paired document and became a lie the
## moment a second one appeared -- every tutorial chapter would have declared
## its twin to be the home page. Derived from `pair` now, so the pair is
## whatever page is being written.
fn alternates(pair: String) -> String =
  if pair == "" {
    ""
  } else {
    let en = site_url("", pair)
    let zh = site_url("zh/", pair)
    """<link rel="alternate" hreflang="en" href="${en}">""" ++ "\n" ++
      """<link rel="alternate" hreflang="zh-CN" href="${zh}">""" ++ "\n" ++
      """<link rel="alternate" hreflang="x-default" href="${en}">"""
  }

## The switch link in the header, relative because it is a link the reader
## clicks rather than a URL a crawler indexes.
fn lang_switch(lang: Lang, root: String, pair: String) -> String =
  if pair == "" {
    ""
  } else {
    let href =
      match lang {
        En -> "${root}/zh/${pair}"
        Zh -> "${root}/${pair}"
      }
    """<a class="lang" href="${href}" hreflang="${lang_code(other(lang))}">${lang_switch_label(lang)}</a>"""
  }

## The footer, in the page's language: the mark, a line about the site, and
## the build it was made from.
##
## It printed the same English line on both trees until 2026-10-01, the one
## piece of chrome that never went through `Lang`. The build line is new at
## the same time: the live site once sat three weeks behind main, teaching a
## syntax the current compiler rejects, and nothing on the page said which
## compiler it had been built from. An empty version prints no build at all
## rather than a blank one; an empty commit prints the version alone.
pub fn footer_html(a: Assets, lang: Lang, root: String) -> String = {
  let gh = """<a href="${repo_url()}">GitHub</a>"""
  let (about, made, word) =
    match lang {
      En -> ("Dawn, a small, elegant functional language", "Built by a generator written in Dawn", "version")
      Zh -> ("Dawn：一门小而优雅的函数式语言", "由 Dawn 写的生成器构建", "版本")
    }
  let commit = if a.commit == "" { "" } else { " (${escape_html(a.commit)})" }
  let ver =
    if a.version == "" {
      ""
    } else {
      "\n" ++ """<span class="ver">${word} <b>${escape_html(a.version)}</b>${commit}</span>"""
    }
  let logo = a.logo
  """<footer class="site-footer">
<div class="wrap">
<div class="row">
<span class="mark"><img class="mark-logo" src="${root}/assets/${logo}" alt=""><span>${about} · ${gh} · ${made}</span></span>${ver}
</div>
</div>
</footer>"""
}

## One step of the trail over a page's title: what it says (markup the caller
## has already escaped) and where it goes, `href` "" for the page itself,
## which is the last step and the one that is not a link.
pub type Crumb = { label: String, href: String }

## What a page says in the sky band, above its body: the trail of where it
## sits (`crumbs`), the title, a lede, a row of small facts (`meta`, each one
## a chip from [chip], [link_chip] and the rest below), and `extra`, markup
## set after them (the 404 page's second line and its sun). Text fields are
## markup the caller has already escaped, any of them "" to leave it out;
## `cls` places the block (`col` over a single column, `toc-aligned` over the
## column beside the contents rail, `nf` centred for the 404 page).
##
## Two lines where there was one (the eyebrow) because they answer two
## questions: the trail says where the page is, and can be walked back up;
## the chips say what is true of it -- its release, how long it is, which
## chapter, its translation. Which facts a page states is the page
## generator's to say; this shell guesses none, and a page with nothing to
## state has no row.
pub type PageHead = {
  crumbs: List[Crumb],
  title: String,
  lede: String,
  meta: List[String],
  extra: String,
  cls: String,
}

## A page with no head in the band: the Playground, whose editor is the page.
pub fn no_head() -> PageHead =
  PageHead { crumbs: [], title: "", lede: "", meta: [], extra: "", cls: "" }

## A step that links up the trail, and the step that is the page itself.
pub fn crumb(label: String, href: String) -> Crumb = Crumb { label: label, href: href }

pub fn here(label: String) -> Crumb = Crumb { label: label, href: "" }

## The first step of a page's trail: its section, named as the nav names it
## and linked to the section's own page, or unlinked when that is this page.
## From [nav_items], so the trail and the nav cannot call one place by two
## names.
pub fn section_crumb(lang: Lang, root: String, key: String, linked: Bool) -> Crumb = {
  let hits = filter(nav_items(lang), it => {
    let (k, _, _) = it
    k == key
  })
  match get(hits, 0) {
    Some((_, label, path)) -> if linked { crumb(escape_html(label), "${root}/${path}") } else { here(escape_html(label)) }
    None -> panic("no section `${key}` in the nav")
  }
}

## What the trail is called to a screen reader, in the page's language.
fn crumbs_label(lang: Lang) -> String =
  match lang {
    En -> "Breadcrumb"
    Zh -> "当前位置"
  }

## The trail as markup. A step with no href is plain text; only the last
## one, the page itself, is marked as the current page.
fn crumbs_html(lang: Lang, cs: List[Crumb]) -> String = {
  let n = len(cs)
  let steps = map(range(0, n), i => {
    let c = cs[i]
    if c.href != "" {
      """<a href="${c.href}">${c.label}</a>"""
    } else if i == n - 1 {
      """<span aria-current="page">${c.label}</span>"""
    } else {
      "<span>${c.label}</span>"
    }
  })
  let sep = `<span class="sep" aria-hidden="true">/</span>`
  """<nav class="crumbs" aria-label="${crumbs_label(lang)}">""" ++ join(steps, sep) ++ "</nav>"
}

## One fact in the row under the title, as plain markup.
pub fn chip(inner: String) -> String = """<li class="chip">${inner}</li>"""

## A fact that is also a place to go.
pub fn link_chip(href: String, inner: String) -> String = """<li class="chip"><a href="${href}">${inner}</a></li>"""

## The release a page describes, linked to its notes. "" when the build was
## not told the version, so the row simply has one chip fewer.
pub fn release_chip(version: String) -> String =
  if version == "" {
    ""
  } else {
    let v = escape_html(version)
    """<li class="chip rel"><a href="${release_url(version)}">v${v}</a></li>"""
  }

## Where a release's notes are. The tag is the version with a `v`, which is
## how scripts/build-release-jar.sh and release.yml name it.
pub fn release_url(version: String) -> String =
  repo_url() ++ "/releases/tag/v" ++ escape_attr(version)

## How long a page takes to read, as a chip with a small clock. Counted from
## the page's rendered body by [reading_minutes]; past an hour it is said to
## the nearest hour only, since a minute count on a three-hour document is
## precision nobody reads by.
pub fn reading_chip(lang: Lang, body_html: String) -> String = {
  let m = reading_minutes(body_html)
  let h = (m + 30) / 60
  let text =
    match lang {
      En -> if m > 60 { "about ${h} h" } else { "${m} min read" }
      Zh -> if m > 60 { "阅读约 ${h} 小时" } else { "阅读约 ${m} 分钟" }
    }
  """<li class="chip"><svg class="ci" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.2"/><path d="M8 4.6V8l2.3 1.5"/></svg>${text}</li>"""
}

## The translation note as a chip: the note's own link (the document in the
## other language) with the whole sentence as its title, so nothing it said
## is lost and the band loses a paragraph. "" when there is no note, or the
## note has no link. `map_url` is the page's own doc-link mapping, the one
## the note would have been rendered through.
pub fn twin_chip(twin: List[Inline], map_url: fn(String) -> String) -> String = {
  let (label, url) = twin_link(twin)
  if url == "" {
    ""
  } else {
    let note = twin_note(label, inline_text(twin))
    """<li class="chip twin"><a href="${escape_attr(map_url(url))}" title="${escape_attr(note)}" hreflang="${twin_lang(label)}">"""
      ++ """<svg class="ci" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 3.5h6M5.5 2v1.5M4 3.5c.4 2.6 2 4.6 4 5.6M7.2 3.5C6.8 6 5.2 8.2 2.8 9.4M8.6 14l2.6-6.5 2.6 6.5M9.4 12h3.6"/></svg>"""
      ++ escape_html(label) ++ "</a></li>"
  }
}

## The note's sentence without the link it opens with and the dash or dot
## after it: the chip already shows the link, and its title is the rest.
fn twin_note(label: String, text: String) -> String = {
  let rest = unwrap_or(str.strip_prefix(text, label), text)
  let cs = code_points(rest)
  var i = 0
  while i < len(cs) && (cs[i] == ' ' || cs[i] == '—' || cs[i] == '·' || cs[i] == '-') {
    i = i + 1
  }
  from_code_points(map(range(i, len(cs)), j => cs[j]))
}

fn twin_lang(label: String) -> String = if label == "English" { "en" } else { "zh-CN" }

## Minutes to read a body of rendered markup: 400 Chinese characters or 250
## English words to the minute, both counted in one pass so that a Chinese
## page full of English identifiers is charged for both, and rounded up,
## never under one. 400 is the middle of the usual 300-500 for reading
## Chinese for understanding; at it the two translations of the spec come out
## at the same three hours, where 1000 (the first proposal) had the Chinese
## one read in half the time of the English. Tags and entities are skipped;
## code counts like prose, which, read carefully, it is not, but it is not
## skimmed either.
pub fn reading_minutes(html: String) -> Int = {
  var cjk = 0
  var words = 0
  var in_tag = false
  var in_ent = false
  var in_word = false
  for c in code_points(html) {
    if in_tag {
      if c == '>' {
        in_tag = false
      }
    } else if in_ent {
      if c == ';' {
        in_ent = false
      }
    } else if c == '<' {
      in_tag = true
    } else if c == '&' {
      in_ent = true
      in_word = false
    } else if is_cjk(c) {
      cjk = cjk + 1
      in_word = false
    } else if is_word_char(c) {
      if not in_word {
        words = words + 1
        in_word = true
      }
    } else {
      in_word = false
    }
  }
  # in 2000ths of a minute: a character is 5 (400 a minute), a word 8 (250)
  let units = 5 * cjk + 8 * words
  if units <= 2000 { 1 } else { (units + 1999) / 2000 }
}

fn is_cjk(c: Char) -> Bool =
  (c >= '\u{3040}' && c <= '\u{30FF}') || (c >= '\u{3400}' && c <= '\u{4DBF}')
  || (c >= '\u{4E00}' && c <= '\u{9FFF}') || (c >= '\u{F900}' && c <= '\u{FAFF}')

fn is_word_char(c: Char) -> Bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')

fn page_head_html(lang: Lang, h: PageHead) -> String =
  if h.title == "" && len(h.crumbs) == 0 {
    ""
  } else {
    let trail = if len(h.crumbs) == 0 { "" } else { crumbs_html(lang, h.crumbs) ++ "\n" }
    let title = if h.title == "" { "" } else { "<h1>${h.title}</h1>\n" }
    let lede = if h.lede == "" { "" } else { """<p class="lede">${h.lede}</p>""" ++ "\n" }
    let chips = filter(h.meta, m => m != "")
    let meta = if len(chips) == 0 { "" } else { `<ul class="meta">` ++ join(chips, "") ++ "</ul>\n" }
    let extra = if h.extra == "" { "" } else { h.extra ++ "\n" }
    """<div class="page-head ${h.cls}">""" ++ "\n" ++ trail ++ title ++ lede ++ meta ++ extra ++ "</div>"
  }

## The full page around an already-rendered <main>/<div> body. `pair` is this
## page's path in the default layout when the page has a twin in the other
## language -- "index.html", "tutorial/01.html" -- and "" when it has none.
## One string rather than two hrefs: see [site_url].
pub fn shell(
  a: Assets,
  lang: Lang,
  pair: String,
  title: String,
  root: String,
  active: String,
  head: PageHead,
  body: String,
) -> String =
  shell_ext(a, lang, pair, title, root, active, "", head, body)

## The header's search button, and the four URLs the panel needs.
##
## A round glass, the same size as the theme toggle beside it, named by its
## label (and Ctrl-K or Cmd-K, which search.js binds). It opens the floating
## panel; there is no field in the nav, because the panel is where searching
## happens and a field that only opens it would be a second thing that looks
## like one.
##
## They are attributes rather than strings inside the script for the reason
## the demo page's `data-wasm` is one: gen/links reads markup and nothing here
## reads programs, so a URL spelled in a `fetch` argument would be the one URL
## on this site that nothing checks. All four are content-hashed names, and
## the asset rule in gen/links holds them to that.
##
## `data-search-root` is this page's own distance from the site root. The
## index's hrefs are site-root relative, so the panel joins the two; without
## it the same index would be wrong on every page but the front one.
##
## Nothing is fetched until the button is used, or a pointer or keyboard focus
## arrives on it (site/assets/search.js). The
## reactor is 150KB gzipped and the index is tens of kilobytes, and neither
## belongs in a first paint that a reader who never searches still pays for.
fn search_button(a: Assets, lang: Lang, root: String) -> String = {
  let app = a.search_app
  let worker = a.search_worker
  let wasm = a.search_wasm
  let index = search_index_name(a, lang)
  let label = escape_html(search_label(lang))
  """<button class="search-open" type="button" aria-label="${label}" title="${label}" aria-controls="dawn-search" aria-expanded="false" data-search-app="${root}/assets/${app}" data-search-worker="${root}/assets/${worker}" data-search-wasm="${root}/assets/${wasm}" data-search-index="${root}/assets/${index}" data-search-root="${root}">"""
    ++ """<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6"/><path d="m10.4 10.4 3.4 3.4"/></svg></button>"""
}

## Like [shell], but with extra markup injected into <head> (e.g. the Playground
## page's stylesheet + module script).
##
## The body: the reading-progress line, the sky band (stars that only the
## night shows, a low glow, the nav and the page's head), the search panel's
## mount point, the page, the footer.
pub fn shell_ext(
  a: Assets,
  lang: Lang,
  pair: String,
  title: String,
  root: String,
  active: String,
  head_extra: String,
  head: PageHead,
  body: String,
) -> String = {
  let ph = page_head_html(lang, head)
  let ph_line = if ph == "" { "" } else { ph ++ "\n" }
  # the cat looks over a page's head; not over the Playground's band, which
  # has none, nor the 404 page's, whose horizon holds a sun that has not come up
  let cat = if ph == "" || head.cls == "nf" { "" } else { band_cat(a.cat) }
  let cat_line = if cat == "" { "" } else { cat ++ "\n" }
  head_html(a, lang, pair, title, root, head_extra) ++ "\n<body>\n"
    ++ `<div class="progress" aria-hidden="true"></div>` ++ "\n"
    ++ `<header class="sky">` ++ "\n" ++ band_stars() ++ "\n"
    ++ `<div class="glow" aria-hidden="true"></div>` ++ "\n"
    ++ `<div class="wrap">` ++ "\n" ++ nav_bar(a, lang, pair, root, active) ++ "\n" ++ ph_line
    ++ "</div>\n" ++ cat_line ++ "</header>\n"
    ++ search_host(a, lang, root) ++ "\n" ++ body ++ "\n"
    ++ footer_html(a, lang, root) ++ "\n</body>\n</html>"
}

## The cat that looks over the band's lower edge, at its right, on every page
## with a head: ears and eyes above the horizon line, the rest behind it (the
## band clips it). Eyes open by day, the mark's own cut-out eyes; shut by
## night, the front page's sleeping moon cat. The brand in the nav is the
## mark; this is the same cat in a pose of its own, looking at the page.
## Both drawings are in the markup and the theme's `--night-op` picks one,
## so a theme switch changes the eyes inside the view transition's circle
## like everything else, with no tween of its own. `aria-hidden`: it says
## nothing. "" when there is no cat to draw.
pub fn band_cat(cat: String) -> String =
  if cat == "" {
    ""
  } else {
    let asleep = cat_outline(cat)
    `<div class="peek" aria-hidden="true"><span>`
      ++ `<svg class="awake" viewBox="61 86 38 31"><defs><linearGradient id="peek-ink" x1="0" y1="0" x2="1" y2="1">`
      ++ `<stop offset="0" stop-color="#4f46e5"/><stop offset=".5" stop-color="#7c3aed"/><stop offset="1" stop-color="#db2777"/>`
      ++ `</linearGradient></defs><path fill="url(#peek-ink)" fill-rule="evenodd" d="` ++ cat ++ `"/></svg>`
      ++ `<svg class="asleep" viewBox="61 86 38 31"><path fill="#c7c9ee" d="` ++ asleep ++ `"/>`
      ++ `<g fill="none" stroke="#1d2040" stroke-width="1.3" stroke-linecap="round"><path d="M86.4 102.2 q2.4 2.2 4.9 0.2"/><path d="M71.4 105.2 q2.4 2.2 4.9 0.2"/></g></svg>`
      ++ "</span></div>"
  }

## The sun's cat and the moon's on the front page, and the one that peeks
## over every other page's band: the mark's own cat, read out of
## site/assets/logo.svg rather than copied, so there is one drawing of it.
## Awake, it is the whole path, eyes cut out by the even-odd rule; asleep, it
## is the first subpath alone, the outline with no eyes in it.
pub fn cat_path(logo: String) -> String = {
  let marker = `fill-rule="evenodd"`
  match str.index_of(logo, marker) {
    None -> panic("site/assets/logo.svg: no even-odd path, so no cat to put in the sun")
    Some(i) -> {
      let rest = str.drop(logo, i)
      match str.index_of(rest, ` d="`) {
        None -> panic("site/assets/logo.svg: the cat path has no d attribute")
        Some(j) -> {
          let from = str.drop(rest, j + 4)
          match str.index_of(from, `"`) {
            Some(k) -> str.take(from, k)
            None -> panic("site/assets/logo.svg: the cat path's d attribute never closes")
          }
        }
      }
    }
  }
}

pub fn cat_outline(path: String) -> String =
  match str.index_of(path, " Z") {
    Some(i) -> str.take(path, i + 2)
    None -> panic("site/assets/logo.svg: the cat path has no closed first subpath")
  }

## Twelve faint stars for the band, still (the front page's twinkle is the
## front page's). White on the day sky, so they are drawn at the night's
## opacity (`--star-op`, 0 by day).
fn band_stars() -> String =
  `<svg class="stars" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="#fff">
<circle cx="130" cy="70" r=".9" opacity=".35"/><circle cx="410" cy="34" r=".8" opacity=".3"/><circle cx="660" cy="96" r="1" opacity=".3"/>
<circle cx="880" cy="44" r=".9" opacity=".35"/><circle cx="1090" cy="110" r=".8" opacity=".25"/><circle cx="300" cy="170" r=".7" opacity=".2"/>
<circle cx="980" cy="200" r=".7" opacity=".18"/><circle cx="540" cy="150" r=".7" opacity=".22"/><circle cx="760" cy="186" r=".6" opacity=".16"/>
<circle cx="230" cy="48" r=".6" opacity=".25"/><circle cx="1160" cy="58" r=".7" opacity=".22"/><circle cx="40" cy="140" r=".6" opacity=".18"/></g></svg>`

## Everything up to and including `</head>`, shared by [shell_ext] and the
## front page's own shell (gen/home.dawn), which differ only in what comes
## after it: the front page puts the header inside its sky.
pub fn head_html(
  a: Assets,
  lang: Lang,
  pair: String,
  title: String,
  root: String,
  head_extra: String,
) -> String = {
  # one title, two contexts: the <title> element is text, og:title's
  # `content` is an attribute value and must not be closed by a `"` (#316)
  let esc_title = escape_html(title)
  let attr_title = escape_attr(title)
  let code = lang_code(lang)
  let alts = alternates(pair)
  let css = a.style
  let ico = a.favicon
  let touch = a.touch_icon
  let og = a.og_image
  let sjs = a.search_js
  let tjs = a.theme_js
  """
<!DOCTYPE html>
<html lang="${code}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${esc_title}</title>
<link rel="icon" href="${root}/assets/${ico}" sizes="32x32">
<link rel="apple-touch-icon" href="${root}/assets/${touch}">
<meta property="og:title" content="${attr_title}">
${meta_html(lang, pair)}
<meta property="og:image" content="${site_origin()}assets/${og}">
<link rel="stylesheet" href="${root}/assets/${css}">
<script src="${root}/assets/${tjs}"></script>
<script src="${root}/assets/${sjs}" defer></script>
${alts}
${head_extra}
</head>
"""
}

## The theme toggle: a sun and a moon, one shown at a time. `hidden` in the
## markup: without theme.js it could do nothing, and a button that does
## nothing is worse than none. The two labels are attributes, in the page's
## language, so that theme.js, which both language trees load, carries no
## words of either (gen/assets.dawn holds shared bundles to that); written
## here once, for the front page as for every other.
pub fn theme_toggle(lang: Lang) -> String = {
  let (dark, light) =
    match lang {
      En -> ("Switch to dark theme", "Switch to light theme")
      Zh -> ("切换到深色主题", "切换到浅色主题")
    }
  """<button class="theme-toggle" type="button" id="theme-toggle" hidden aria-pressed="false" aria-label="${dark}" data-label-dark="${dark}" data-label-light="${light}"><svg viewBox="0 0 20 20" aria-hidden="true"><g class="ico-sun" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="10" cy="10" r="3.4"/><path d="M10 2.2v1.9M10 15.9v1.9M2.2 10h1.9M15.9 10h1.9M4.5 4.5l1.3 1.3M14.2 14.2l1.3 1.3M4.5 15.5l1.3-1.3M14.2 5.8l1.3-1.3"/></g><path class="ico-moon" fill="currentColor" d="M15.6 12.6A6.4 6.4 0 0 1 7.4 4.4a6.4 6.4 0 1 0 8.2 8.2z"/></svg></button>"""
}

## The site's navigation, the same markup on every page, the front page's
## included: the mark and the release it was built from, the sections, then
## the tools (the language switch, search, GitHub), then the theme toggle.
## The sections are a group of their own so that the line under the current
## one has only them to slide between (site/assets/theme.js), and so that on a
## phone they can take the second row and scroll sideways while the mark, the
## tools and the toggle keep the first (site/assets/style.css).
##
## The release pill sits beside the mark rather than inside it: the mark is a
## link home, and a link cannot hold another. No pill when the build was not
## told the version.
pub fn nav_bar(a: Assets, lang: Lang, pair: String, root: String, active: String) -> String = {
  let nav = nav_html(lang, root, active)
  # the brand mark goes to this language's front page, not to the English one:
  # a reader on /zh/ who clicks the logo is not asking to change language
  let home = lang_path(lang, "index.html")
  let switch = lang_switch(lang, root, pair)
  let switch_line = if switch == "" { "" } else { switch ++ "\n" }
  let logo = a.logo
  let label =
    match lang {
      En -> "Site"
      Zh -> "站点"
    }
  let pill =
    if a.version == "" {
      ""
    } else {
      """<a class="release" href="${release_url(a.version)}">v${escape_html(a.version)}</a>"""
    }
  """<nav class="site-nav" aria-label="${label}">
<div class="id"><a class="brand" href="${root}/${home}"><img class="brand-logo" src="${root}/assets/${logo}" alt=""><span class="word">Dawn</span></a>${pill}</div>
<div class="links">
${nav}
</div>
<div class="tools">
${switch_line}${search_button(a, lang, root)}
<a class="gh" href="${repo_url()}" aria-label="GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
</div>
${theme_toggle(lang)}
</nav>"""
}

## A plain content page: one reading column. `pair` as in [shell]: a paired
## page passes its own path in the default layout, and a page with no twin
## passes "". The parameter is here rather than hard-coded, which is what made
## translating the spec and the design notes an edit at their own call site
## instead of a change to this shell.
pub fn page(
  a: Assets,
  lang: Lang,
  pair: String,
  title: String,
  root: String,
  active: String,
  head: PageHead,
  inner: String,
) -> String =
  shell(a, lang, pair, title, root, active, head,
    `<main class="wrap page">` ++ "\n" ++ `<article class="col prose">` ++ "\n" ++ inner
      ++ "\n</article>\n</main>")

## A page with a contents rail beside its article: the spec, the history
## pages, the standard library, a tutorial chapter. `rail` is the rail's
## markup ([toc_rail], or a chapter list); `pair` as in [shell].
pub fn page_with_toc(
  a: Assets,
  lang: Lang,
  pair: String,
  title: String,
  root: String,
  active: String,
  head: PageHead,
  rail: String,
  article: String,
) -> String =
  shell(a, lang, pair, title, root, active, head,
    `<main class="wrap page with-toc">` ++ "\n" ++ rail ++ "\n" ++ `<article class="prose">` ++ "\n"
      ++ article ++ "\n</article>\n</main>")

## The rail: a `<details>` that is a sidebar on a wide screen and a fold at
## the top of the page on a narrow one. Open in the markup, so that a reader
## without scripts loses nothing; theme.js closes it below the stylesheet's
## breakpoint, and the stylesheet holds it shut until then so it does not show
## open for a frame. Below that width the sidebar stacks above the article,
## and the spec's 75 entries were a whole screen of links a phone reader had
## to scroll past before the first heading. On a wide screen the summary is
## only a heading and cannot be clicked (site/assets/style.css).
pub fn rail_html(heading: String, list: String) -> String =
  "<aside class=\"toc\">\n<nav>\n" ++ `<details class="toc-fold" open>` ++ "\n"
  ++ `<summary class="toc-title">` ++ escape_html(heading) ++ "</summary>\n" ++ list
  ++ "\n</details>\n</nav>\n</aside>"

## A document's contents rail, titled "Contents" in the page's language.
pub fn toc_rail(lang: Lang, toc: List[TocEntry]) -> String = rail_html(contents_label(lang), toc_list(toc))

## One rail link, with the entry's printed section number (if any) set apart
## so the numbers line up in a column of their own.
fn toc_link(e: TocEntry) -> String = {
  let (num, rest) = split_number(e.text)
  if num == "" {
    """<a href="#${e.id}">""" ++ escape_html(e.text) ++ "</a>"
  } else {
    """<a class="has-n" href="#${e.id}"><span class="tn">""" ++ escape_html(num) ++ "</span><span>"
      ++ escape_html(rest) ++ "</span></a>"
  }
}

## Nested <ul> for h2/h3 toc entries.
pub fn toc_list(entries: List[TocEntry]) -> String = {
  var out = "<ul>"
  var open3 = false
  for e in entries {
    if e.level == 2 {
      if open3 {
        out = out ++ "</ul></li>"
        open3 = false
      }
      out = out ++ "\n<li>" ++ toc_link(e)
    } else {
      if not open3 {
        out = out ++ "\n<ul>"
        open3 = true
      }
      out = out ++ "\n<li>" ++ toc_link(e) ++ "</li>"
    }
  }
  if open3 {
    out = out ++ "</ul></li>"
  } else if len(entries) > 0 {
    out = out ++ "</li>"
  }
  out ++ "\n</ul>"
}

test "nav marks the active page and roots the links" {
  let n = nav_html(Zh, "..", "spec")
  assert str.contains(n, `<a class="active" aria-current="page" href="../zh/spec.html">规范</a>`)
  assert str.contains(n, `<a href="../zh/tutorial/index.html">教程</a>`)
}

test "the nav is labelled in the page's own language" {
  assert str.contains(nav_html(En, ".", ""), `<a href="./tutorial/index.html">Tutorial</a>`)
  assert str.contains(nav_html(Zh, ".", ""), `<a href="./zh/tutorial/index.html">教程</a>`)
}

## The half a labels-only nav could not do. Both languages used to name the
## same six paths, which was right while five of the six existed once; now a
## Chinese reader clicking 标准库 has to land on the Chinese one, and the
## label alone cannot say that.
test "each language's nav points at that language's pages" {
  let en = nav_html(En, ".", "")
  let zh = nav_html(Zh, ".", "")
  assert str.contains(en, `href="./stdlib.html"`)
  assert str.contains(zh, `href="./zh/stdlib.html"`)
  assert str.contains(en, `href="./examples/index.html"`)
  assert str.contains(zh, `href="./zh/examples/index.html"`)
  # the last two to be paired: no `(中文)` on the English label any more, and
  # the Chinese nav names the Chinese page rather than the shared one
  assert str.contains(en, `<a href="./spec.html">Spec</a>`)
  assert str.contains(zh, `<a href="./zh/history.html">历史</a>`)
  assert str.contains(en, `<a href="./history.html">History</a>`)
  # the early design notes are reached from the history, not from the nav
  assert not str.contains(en, "design.html")
}

## Clicking the logo is not a request to change language.
test "the brand mark leads to this page's own front page" {
  assert str.contains(shell(plain_assets(), En, "", "t", ".", "", no_head(), ""), `class="brand" href="./index.html"`)
  assert str.contains(shell(plain_assets(), Zh, "", "t", "..", "", no_head(), ""), `class="brand" href="../zh/index.html"`)
}

## The header draws the mark itself, not the icon iOS was sent. Those were one
## file until 2026-08-08 -- the brand <img> pointed at apple-touch-icon.png, so
## every page shipped a 180px raster to fill a 20px box, and the two could not
## be given different croppings even though one of them wants padding for a
## home screen and the other does not.
test "the header brand is the vector mark" {
  let h = shell(plain_assets(), En, "", "t", ".", "", no_head(), "")
  assert str.contains(h, `<img class="brand-logo" src="./assets/logo.svg" alt="">`)
  assert str.contains(h, `<link rel="apple-touch-icon" href="./assets/apple-touch-icon.png">`)
}

## Every page carries the button, the mount point and the script -- there is
## no page-level opt-in, because a reader who wants to search wants to from
## wherever they are. The four URLs are attributes so that gen/links checks
## them; this is the assertion that says they are there to be checked.
test "every page carries the search button, its mount point and its script" {
  let p = shell(plain_assets(), En, "", "t", "..", "", no_head(), "<p>x</p>")
  assert str.contains(p, `<button class="search-open" type="button"`)
  assert str.contains(p, `data-search-app="../assets/tea-remote.mjs"`)
  assert str.contains(p, `data-search-worker="../assets/tea-worker.mjs"`)
  assert str.contains(p, `data-search-wasm="../assets/tea-search.wasm"`)
  assert str.contains(p, `data-search-index="../assets/search-en.json"`)
  assert str.contains(p, `data-search-root=".."`)
  assert str.contains(p, `<div id="dawn-search" class="search-host" data-search-body="../assets/search-body-en.json" hidden></div>`)
  assert str.contains(p, `<script src="../assets/search.js" defer></script>`)
  # and the theme script, blocking, before it: it has to run before the first paint
  assert str.contains(p, `<script src="../assets/theme.js"></script>` ++ "\n" ++ `<script src="../assets/search.js" defer>`)
}

## The panel is a piece of chrome, so it follows the page's language in both
## of the ways chrome can: the label a reader clicks, and the index it loads.
## An English page loading the Chinese index would show Chinese titles under
## hrefs that all resolve, which is the failure a shared index would have made
## unnoticeable.
test "the search button is labelled and indexed in the page's own language" {
  let en = shell(plain_assets(), En, "", "t", ".", "", no_head(), "")
  let zh = shell(plain_assets(), Zh, "", "t", "..", "", no_head(), "")
  assert str.contains(en, `data-search-index="./assets/search-en.json"`)
  assert str.contains(en, `aria-label="Search" title="Search"`)
  assert str.contains(zh, `data-search-index="../assets/search-zh.json"`)
  assert str.contains(zh, `aria-label="搜索" title="搜索"`)
  assert search_index_name(plain_assets(), En) == "search-en.json"
  assert search_index_name(plain_assets(), Zh) == "search-zh.json"
  assert str.contains(en, `data-search-body="./assets/search-body-en.json"`)
  assert str.contains(zh, `data-search-body="../assets/search-body-zh.json"`)
}

test "shell carries title, css root, body" {
  let p = page(plain_assets(), Zh, "", "测试页 — Dawn", ".", "stdlib", no_head(), "<p>x</p>")
  assert str.contains(p, "<title>测试页 — Dawn</title>")
  assert str.contains(p, `href="./assets/style.css"`)
  assert str.contains(p, `<main class="wrap page">`)
  assert str.contains(p, "由 Dawn 写的生成器构建")
}

test "a quote in a title stays inside og:title's attribute" {
  let p = page(plain_assets(), En, "", `Say "hi" & go`, ".", "", no_head(), "")
  assert str.contains(p, `<title>Say "hi" &amp; go</title>`)
  assert str.contains(p, `<meta property="og:title" content="Say &quot;hi&quot; &amp; go">`)
}

test "the footer follows the page's language and prints the build it was given" {
  let built = Assets { ..plain_assets(), version: "0.81.0", commit: "1a2b3c4d" }
  let en = shell(built, En, "", "t", ".", "", no_head(), "")
  let zh = shell(built, Zh, "", "t", "..", "", no_head(), "")
  assert str.contains(en, "Built by a generator written in Dawn</span></span>\n"
      ++ `<span class="ver">version <b>0.81.0</b> (1a2b3c4d)</span>`)
  assert str.contains(zh, `由 Dawn 写的生成器构建</span></span>` ++ "\n"
      ++ `<span class="ver">版本 <b>0.81.0</b> (1a2b3c4d)</span>`)
  assert not str.contains(zh, "Built by a generator")
  # the mark is the same file the header shows, from wherever the page sits
  assert str.contains(zh, `<img class="mark-logo" src="../assets/logo.svg" alt="">`)
  # a build that was not told prints no version at all
  let bare = shell(plain_assets(), En, "", "t", ".", "", no_head(), "")
  assert str.contains(bare, "Built by a generator written in Dawn</span></span>\n</div>")
  assert not str.contains(bare, "version")
  # and a version with no commit prints the version alone
  let tagged = shell(Assets { ..plain_assets(), version: "0.81.0" }, En, "", "t", ".", "", no_head(), "")
  assert str.contains(tagged, `<span class="ver">version <b>0.81.0</b></span>`)
}

test "a page says what it is and where it lives, in its own language" {
  let en = page(plain_assets(), En, "tutorial/03.html", "t", "..", "tutorial", no_head(), "")
  assert str.contains(en, `<meta name="description" content="Dawn is a small, elegant`)
  assert str.contains(en, `<meta property="og:description" content="Dawn is a small, elegant`)
  assert str.contains(en, `<meta property="og:type" content="website">`)
  assert str.contains(en, """<link rel="canonical" href="${site_origin()}tutorial/03.html">""")
  assert str.contains(en, """<meta property="og:url" content="${site_origin()}tutorial/03.html">""")
  let zh = page(plain_assets(), Zh, "index.html", "t", "..", "", no_head(), "")
  assert str.contains(zh, `<meta name="description" content="Dawn 是一门`)
  assert str.contains(zh, """<link rel="canonical" href="${site_origin()}zh/">""")
  # no pair, no URL to name
  assert not str.contains(page(plain_assets(), En, "", "t", ".", "", no_head(), ""), "canonical")
}

test "only a page with a twin advertises one" {
  # the English front page: lang=en, a switch to the Chinese one, hreflang pair
  let home = shell(plain_assets(), En, "index.html", "Dawn", ".", "", no_head(), "<p>x</p>")
  assert str.contains(home, `<html lang="en">`)
  assert str.contains(home, `<a class="lang" href="./zh/index.html" hreflang="zh-CN">中文</a>`)
  assert str.contains(home, "hreflang=\"x-default\" href=\"${site_origin()}\"")
  # the Chinese one points back, and says so in the language it leads to
  let zh = shell(plain_assets(), Zh, "index.html", "Dawn", "..", "", no_head(), "<p>x</p>")
  assert str.contains(zh, `<html lang="zh-CN">`)
  assert str.contains(zh, `<a class="lang" href="../index.html" hreflang="en">English</a>`)
  # a document page has no twin: no switch, no alternates
  let doc = page(plain_assets(), Zh, "", "规范 — Dawn", ".", "spec", no_head(), "<p>x</p>")
  assert not str.contains(doc, `class="lang"`)
  assert not str.contains(doc, "hreflang")
}

## The half a single-pair site could not distinguish: with the front page the
## only paired document, "the twin of this page" and "the home page" were the
## same three URLs, and the constants that used to stand here passed either
## reading. A tutorial chapter tells them apart.
test "a paired page names its own twin, not the home page" {
  let en = page(plain_assets(), En, "tutorial/03.html", "x — Dawn Tutorial", "..", "tutorial", no_head(), "<p>x</p>")
  assert str.contains(en, `<a class="lang" href="../zh/tutorial/03.html" hreflang="zh-CN">中文</a>`)
  assert str.contains(en,
    "hreflang=\"en\" href=\"${site_origin()}tutorial/03.html\"")
  assert str.contains(en,
    "hreflang=\"zh-CN\" href=\"${site_origin()}zh/tutorial/03.html\"")
  # the twin, two directories deeper, points back at the same pair
  let zh = page(plain_assets(), Zh, "tutorial/03.html", "x — Dawn 教程", "../..", "tutorial", no_head(), "<p>x</p>")
  assert str.contains(zh, `<a class="lang" href="../../tutorial/03.html" hreflang="en">English</a>`)
  assert str.contains(zh,
    "hreflang=\"en\" href=\"${site_origin()}tutorial/03.html\"")
  # an index is advertised as its directory, so the front page stays / and /zh/
  assert str.contains(page(plain_assets(), En, "tutorial/index.html", "t", "..", "tutorial", no_head(), ""),
    "hreflang=\"zh-CN\" href=\"${site_origin()}zh/tutorial/\"")
}

test "the toc is a fold, open in the markup, with no script of its own" {
  let p = page_with_toc(plain_assets(), Zh, "", "t", "..", "spec", no_head(),
    toc_rail(Zh, [TocEntry { level: 2, id: "s1", text: "一" }]), "<p>x</p>")
  assert str.contains(p, `<details class="toc-fold" open>` ++ "\n" ++ `<summary class="toc-title">目录</summary>`)
  # theme.js folds it; there is no inline script on the page
  assert not str.contains(p, "<script>")
  assert str.contains(p, `<main class="wrap page with-toc">` ++ "\n" ++ `<aside class="toc">`)
}

test "toc nests h3 under its h2, with printed numbers set apart" {
  let t = toc_list([
    TocEntry { level: 2, id: "s1", text: "一" },
    TocEntry { level: 3, id: "s1-1", text: "一点一" },
    TocEntry { level: 2, id: "s2", text: "二" },
  ])
  assert str.contains(t, `<li><a href="#s1">一</a>` ++ "\n<ul>\n" ++ `<li><a href="#s1-1">一点一</a></li>` ++ "</ul></li>")
  assert str.contains(t, `<li><a href="#s2">二</a></li>`)
  let n = toc_list([TocEntry { level: 2, id: "s3", text: "3. Types" }])
  assert str.contains(n, `<a class="has-n" href="#s3"><span class="tn">3.</span><span>Types</span></a>`)
}

## The band: the nav and the page's head in one header, the head only when
## the page has one, and the toggle hidden until theme.js shows it.
test "a page's head is set in the sky band above its body" {
  let h = PageHead {
    crumbs: [section_crumb(En, ".", "spec", false)],
    title: "Dawn <code>x</code>",
    lede: "",
    meta: [chip("normative"), release_chip(""), link_chip("zh/spec.html", "中文")],
    extra: "",
    cls: "toc-aligned",
  }
  let p = page(plain_assets(), En, "spec.html", "t", ".", "spec", h, "<p>body</p>")
  assert str.contains(p, `<header class="sky">`)
  assert str.contains(p, `<div class="page-head toc-aligned">` ++ "\n"
      ++ `<nav class="crumbs" aria-label="Breadcrumb"><span aria-current="page">Spec</span></nav>` ++ "\n"
      ++ "<h1>Dawn <code>x</code></h1>\n"
      ++ `<ul class="meta"><li class="chip">normative</li><li class="chip"><a href="zh/spec.html">中文</a></li></ul>`
      ++ "\n</div>\n</div>\n</header>")
  assert str.contains(p, `<article class="col prose">` ++ "\n<p>body</p>")
  # no lede given, none written; an empty chip is no chip
  assert not str.contains(p, `class="lede"`)
  assert not str.contains(p, "chip rel")
  # a page with no head has the nav alone in its band
  let bare = page(plain_assets(), En, "", "t", ".", "", no_head(), "")
  assert not str.contains(bare, "page-head")
  assert str.contains(p, `id="theme-toggle" hidden`)
}

## The trail's steps link up, the last one is the page and links nowhere, and
## a section is named by the nav's own label in the page's language.
test "the trail links every step but the page itself" {
  let t = crumbs_html(Zh, [section_crumb(Zh, "../..", "tutorial", true), here("第三章")])
  assert t == `<nav class="crumbs" aria-label="当前位置"><a href="../../zh/tutorial/index.html">教程</a>`
    ++ `<span class="sep" aria-hidden="true">/</span><span aria-current="page">第三章</span></nav>`
  assert section_crumb(En, "..", "history", false) == here("History")
}

## Both navs carry the packages page after Stdlib and the cuTile page
## before History, each pointing into its own language's tree.
test "the nav lists Packages and GPU between Stdlib and History in both languages" {
  for lang in [En, Zh] {
    let keys = map(nav_items(lang), it => {
      let (k, _, _) = it
      k
    })
    assert keys == ["tutorial", "spec", "examples", "stdlib", "packages", "gpu", "history", "playground", "tea"]
  }
  assert section_crumb(Zh, "..", "packages", true) == crumb("包", "../zh/packages.html")
  assert section_crumb(En, ".", "gpu", false) == here("GPU")
  assert section_crumb(Zh, "..", "gpu", true) == crumb("GPU", "../zh/gpu.html")
}

## 250 words or 400 Chinese characters to the minute, markup not counted,
## rounded up and never under one; past an hour, hours only.
test "reading time counts words and characters, not markup" {
  assert reading_minutes("") == 1
  var en = ""
  for i in range(0, 260) {
    en = en ++ `<span class="k">word</span> `
  }
  assert reading_minutes(en) == 2
  assert reading_minutes(str.repeat("字", 400)) == 1
  assert reading_minutes(str.repeat("字", 401)) == 2
  # entities and attributes are not words
  assert reading_minutes(`<a href="` ++ str.repeat("x ", 2000) ++ `">&amp;</a>`) == 1
  assert str.contains(reading_chip(Zh, "x"), "阅读约 1 分钟")
  assert str.contains(reading_chip(En, "x"), "1 min read")
  # 250 * 189 words is 189 minutes: three hours, said as hours
  assert str.contains(reading_chip(En, str.repeat("w ", 250 * 189)), ">about 3 h</li>")
  assert str.contains(reading_chip(Zh, str.repeat("字", 400 * 61)), ">阅读约 1 小时</li>")
  assert str.contains(reading_chip(Zh, str.repeat("字", 400 * 60)), ">阅读约 60 分钟</li>")
}

## The translation note becomes a chip: its link, and the rest of its
## sentence as the title.
test "the translation note is a chip titled with the rest of its sentence" {
  let note = [Em([Link("中文", "spec.md"), Text(" — the Chinese text is the original")])]
  assert twin_chip(note, u => "./zh/spec.html") == `<li class="chip twin"><a href="./zh/spec.html" title="the Chinese text is the original" hreflang="zh-CN">`
    ++ `<svg class="ci" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 3.5h6M5.5 2v1.5M4 3.5c.4 2.6 2 4.6 4 5.6M7.2 3.5C6.8 6 5.2 8.2 2.8 9.4M8.6 14l2.6-6.5 2.6 6.5M9.4 12h3.6"/></svg>`
    ++ "中文</a></li>"
  assert twin_note("English", "English —— 本文是正本") == "本文是正本"
  assert twin_chip([], u => u) == ""
}

## The cat peeks over every band with a head, hidden from assistive
## technology, awake and asleep both in the markup; not over the 404 page's
## band, nor a band with no head, nor when there is no cat to draw.
test "the cat looks over the band of a page with a head" {
  let a = Assets { ..plain_assets(), cat: "M80 90 L90 90 L85 100 Z M84 95 L86 95 L85 97 Z" }
  let h = PageHead { crumbs: [here("x")], title: "T", lede: "", meta: [], extra: "", cls: "col" }
  let p = page(a, En, "", "t", ".", "", h, "")
  assert str.contains(p, `</div>` ++ "\n" ++ `<div class="peek" aria-hidden="true"><span><svg class="awake"`)
  assert str.contains(p, `fill-rule="evenodd" d="M80 90 L90 90 L85 100 Z M84 95 L86 95 L85 97 Z"`)
  assert str.contains(p, `<path fill="#c7c9ee" d="M80 90 L90 90 L85 100 Z"/>`)
  assert str.contains(p, "</span></div>\n</header>")
  assert not str.contains(page(a, En, "", "t", ".", "", PageHead { ..h, cls: "nf" }, ""), "peek")
  assert not str.contains(page(a, En, "", "t", ".", "", no_head(), ""), "peek")
  assert not str.contains(page(plain_assets(), En, "", "t", ".", "", h, ""), "peek")
}

## The release pill beside the mark, linked to the release's notes, and none
## when the build was not told the version.
test "the nav names the release it was built from" {
  let built = Assets { ..plain_assets(), version: "0.82.0" }
  let n = nav_bar(built, En, "", ".", "")
  assert str.contains(n, """<span class="word">Dawn</span></a><a class="release" href="${repo_url()}/releases/tag/v0.82.0">v0.82.0</a></div>""")
  assert not str.contains(nav_bar(plain_assets(), En, "", ".", ""), `class="release"`)
  # the sections are a group of their own, apart from the tools
  assert str.contains(n, `<div class="links">` ++ "\n" ++ `<a href="./tutorial/index.html">Tutorial</a>`)
  assert str.contains(n, `<div class="tools">`)
}

test "the toggle is labelled in the page's language, for theme.js to read" {
  assert str.contains(theme_toggle(En), `aria-label="Switch to dark theme" data-label-dark="Switch to dark theme" data-label-light="Switch to light theme"`)
  assert str.contains(theme_toggle(Zh), `data-label-dark="切换到深色主题" data-label-light="切换到浅色主题"`)
  # after .links, so a phone can put it on the brand's row
  let n = nav_bar(plain_assets(), En, "", ".", "")
  assert str.contains(n, "</div>\n" ++ `<button class="theme-toggle"`)
  assert str.contains(n, `<nav class="site-nav" aria-label="Site">`)
}

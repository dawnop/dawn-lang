# Capture products at the scheduler's real entry contexts, not by replaying
# a second copy of its ordering rules. Saved entries contain syntax and keyed
# writes, never a complete historical Cx or a Java capability. Capture is not
# admission: callers must validate dependencies and admit before replay.
use std/map
use std/set
use check/checker
use check/checker.{ModuleHeaders, ModuleBodies, BodyExecutor}
use check/cx.{Cx, Frame, cx_new}
use check/body_product
use check/body_product.{Product, ConstantProduct, BodyProduct}
use check/identity
use check/identity.{ModuleKey, DeclKey, Named, FunctionDecl, ConstDecl, TestDecl, MethodDecl, TraitDecl, ImplHead}
use check/types.{Sig, Sym, Ty, TyVar}
use check/tast.{TFun}
use front/ast.{FnDecl, ConstView, TraitMethod, Expr, TypeRef}
use front/parser
use check/semantic_reads
use check/write_journal

pub type Input =
  | FunctionInput(syntax: FnDecl, signature: Sig, inferred: Bool)
  | MethodInput(trait_name: String, subject: TypeRef, syntax: FnDecl, signature: Sig)
  | DefaultInput(trait_name: String, syntax: TraitMethod, signature: Sig)
  | TestInput(name: String, body: Expr)

pub(pkg) type Saved =
  | SavedFunction(key: DeclKey, input: Input, product: Product)
  | SavedConstant(key: DeclKey, syntax: ConstView, declared: Ty, visible: Set[String], product: ConstantProduct)

type State = { entries: List[Saved], checked: Int, refused: Int }
pub(pkg) type Recorded = { bodies: ModuleBodies, entries: List[Saved], checked: Int, refused: Int }

## Visits include replayed bodies; they are not a count of cold checks.
## Refusals describe capture, independently of the executor's reuse verdicts.
pub(pkg) type Captured = { bodies: ModuleBodies, entries: List[Saved], visited: Int, capture_refused: Int }

## An installation request carries no context or historical certificate. Only
## the recording wrapper may assemble it against the actual scheduler input.
pub(pkg) type FunctionDecision[S] =
  | Checked(state: S, cx: Cx, tree: TFun)
  | Install(hit_state: S, fallback_state: S, product: Product)

pub(pkg) type ReplayDecisions[S] = {
  function: fn(S, Cx, FnDecl, Sig) -> FunctionDecision[S] !io,
  inferred_body: fn(S, Cx, FnDecl, Sig) -> FunctionDecision[S] !io,
  after_inferred: fn(S, Cx, Cx, FnDecl, Sig) -> S
}

fn decided[S](decision: FunctionDecision[S], start: Cx, d: FnDecl, sig: Sig,
  cold: fn(S, Cx, FnDecl, Sig) -> (S, Cx, TFun) !io) -> (S, Cx, TFun, Option[Product]) !io = {
  match decision {
    Checked(state, next, tree) -> (state, next, tree, body_product.capture_journaled(start, next, tree))
    Install(hit, fallback, product) -> match body_product.assemble_captured(start, product) {
      Some(value) -> {
        let (next, tree, captured) = body_product.installation_output(value)
        (hit, next, tree, captured)
      }
      None -> {
        let (state, next, tree) = cold(fallback, start, d, sig)
        (state, next, tree, body_product.capture_journaled(start, next, tree))
      }
    }
  }
}

fn named(scope: ModuleKey, name: String, kind: identity.Kind) -> DeclKey =
  DeclKey { scope: scope, path: [Named(kind, name)] }

fn observed(cx: Cx) -> Cx = Cx { ..cx, function_reads: Some([]), body_writes: Some([]) }

## Preserve an enclosing observer's prefix, but do not enable it for a caller
## that requested no log. The private per-body trace is stored in the product.
fn restore_log(before: Cx, after: Cx) -> Cx = {
  let reads = match before.function_reads {
    None -> None
    Some(prefix) -> match after.function_reads {
      Some(entries) -> Some(prefix ++ entries)
      None -> None
    }
  }
  let writes = match before.body_writes {
    None -> None
    Some(prefix) -> match after.body_writes { Some(keys) -> Some(prefix ++ keys), None -> None }
  }
  Cx { ..after, function_reads: reads, body_writes: writes }
}

fn save_function(state: State, allowed: Set[DeclKey], key: Option[DeclKey], input: Input,
  product: Option[Product]) -> State = {
  let next = State { ..state, checked: state.checked + 1 }
  match (key, product) {
    (Some(k), Some(p)) -> {
      if set.has(allowed, k) {
        return State { ..next, entries: next.entries ++ [SavedFunction(k, input, p)] }
      }
    }
    _ -> ()
  }
  State { ..next, refused: next.refused + 1 }
}

fn method_key(scope: ModuleKey, trait_name: String, subject: TypeRef, d: FnDecl, sig: Sig) -> Option[DeclKey] = {
  var binders: List[String] = []
  for ty in sig.tparams {
    match ty { TyVar(name, _) -> { binders = binders ++ [name] }, _ -> return None }
  }
  Some(DeclKey { scope: scope, path: [ImplHead(trait_name, identity.type_shape(subject, binders)), Named(MethodDecl, d.name)] })
}

pub(pkg) fn record(scope: ModuleKey, headers: ModuleHeaders) -> Recorded !io = {
  let cold: BodyExecutor[Unit] = checker.cold_body_executor()
  let (_, captured) = record_using(scope, headers, (), cold)
  Recorded { bodies: captured.bodies, entries: captured.entries,
    checked: captured.visited, refused: captured.capture_refused }
}

## Wrap a trusted canonical or dependency-validated executor in one recording
## pass. Touched-key capture assumes complete instrumentation; this is not a
## validator for arbitrary callbacks. Capture happens before the scheduler
## resolves declaration-relative positions. Failed capture never executes a
## callback again or discards its current result.
pub(pkg) fn record_using[S](scope: ModuleKey, headers: ModuleHeaders, initial: S,
  supplied: BodyExecutor[S]) -> (S, Captured) !io = {
  record_with_decisions(scope, headers, initial, supplied, None)
}

## Only renewal candidates use this request seam. Other body categories and
## arbitrary executed callbacks retain the independent strict capture path.
pub(pkg) fn record_replaying[S](scope: ModuleKey, headers: ModuleHeaders, initial: S,
  decisions: ReplayDecisions[S], other: BodyExecutor[S]) -> (S, Captured) !io = {
  record_with_decisions(scope, headers, initial, other, Some(decisions))
}

fn record_with_decisions[S](scope: ModuleKey, headers: ModuleHeaders, initial: S,
  supplied: BodyExecutor[S], decisions: Option[ReplayDecisions[S]]) -> (S, Captured) !io = {
  var allowed: Set[DeclKey] = set.empty()
  let path_matches = match headers.cx.src_path { Some(path) -> scope.source == path && path != "", None -> scope.source == "" }
  if headers.cx.diags == [] && headers.cx.owner_class == Some(scope.emission_owner) && path_matches {
    allowed = set.from(map(identity.declarations(scope, headers.syntax), e => e.key))
  }
  let admitted = allowed
  let executor: BodyExecutor[(S, State)] = BodyExecutor {
    function: (pair, cx, d, sig) => {
      let (inner, state) = pair
      let start = observed(cx)
      let (after, next, tree, product) = match decisions {
        None -> {
          let (after, next, tree) = supplied.function(inner, start, d, sig)
          (after, next, tree, body_product.capture_journaled(start, next, tree))
        }
        Some(callbacks) -> {
          let cold: BodyExecutor[S] = checker.cold_body_executor()
          decided(callbacks.function(inner, start, d, sig), start, d, sig, cold.function)
        }
      }
      let saved = save_function(state, admitted, Some(named(scope, d.name, FunctionDecl)),
        FunctionInput(d, sig, false), product)
      ((after, saved), restore_log(cx, next), tree)
    },
    inferred_body: (pair, cx, d, sig) => {
      let (inner, state) = pair
      let start = observed(cx)
      let (after, next, tree, product) = match decisions {
        None -> {
          let (after, next, tree) = supplied.inferred_body(inner, start, d, sig)
          (after, next, tree, body_product.capture_journaled(start, next, tree))
        }
        Some(callbacks) -> {
          let cold: BodyExecutor[S] = checker.cold_body_executor()
          let (after, next, tree, product) = decided(callbacks.inferred_body(inner, start, d, sig), start, d, sig, cold.inferred_body)
          (callbacks.after_inferred(after, start, next, d, sig), next, tree, product)
        }
      }
      let saved = save_function(state, admitted, Some(named(scope, d.name, FunctionDecl)),
        FunctionInput(d, sig, true), product)
      ((after, saved), restore_log(cx, next), tree)
    },
    constant: (pair, cx, d, ty, visible) => {
      let (inner, state) = pair
      let start = observed(cx)
      let (after, next, tree) = supplied.constant(inner, start, d, ty, visible)
      let key = named(scope, d.name, ConstDecl)
      var saved = State { ..state, checked: state.checked + 1 }
      let product = body_product.capture_constant_journaled(start, next, tree)
      match product {
        Some(p) -> {
          if set.has(admitted, key) {
            saved = State { ..saved, entries: saved.entries ++ [SavedConstant(key, d, ty, visible, p)] }
          } else { saved = State { ..saved, refused: saved.refused + 1 } }
        }
        None -> { saved = State { ..saved, refused: saved.refused + 1 } }
      }
      ((after, saved), restore_log(cx, next), tree)
    },
    method: (pair, cx, trait_name, subject, d, sig) => {
      let (inner, state) = pair
      let start = observed(cx)
      let (after, next, tree) = supplied.method(inner, start, trait_name, subject, d, sig)
      let saved = save_function(state, admitted, method_key(scope, trait_name, subject, d, sig),
        MethodInput(trait_name, subject, d, sig), body_product.capture_journaled(start, next, tree))
      ((after, saved), restore_log(cx, next), tree)
    },
    default_body: (pair, cx, tid, d, sig, body) => {
      let (inner, state) = pair
      let start = observed(cx)
      let (after, next, tree) = supplied.default_body(inner, start, tid, d, sig, body)
      let trait_name = match map.get(cx.traits, tid) { Some(info) -> info.name, None -> "" }
      let key = DeclKey { scope: scope, path: [Named(TraitDecl, trait_name), Named(MethodDecl, d.name)] }
      let saved = save_function(state, admitted, Some(key), DefaultInput(trait_name, d, sig),
        body_product.capture_journaled(start, next, tree))
      ((after, saved), restore_log(cx, next), tree)
    },
    test_body: (pair, cx, name, body) => {
      let (inner, state) = pair
      let start = observed(cx)
      let (after, next, tree) = supplied.test_body(inner, start, name, body)
      let saved = save_function(state, admitted, Some(named(scope, name, TestDecl)), TestInput(name, body),
        body_product.capture_journaled(start, next, tree))
      ((after, saved), restore_log(cx, next), tree)
    }
  }
  let empty = State { entries: [], checked: 0, refused: 0 }
  let ((after, state), bodies) = checker.execute_module_bodies(headers, (initial, empty), executor)
  (after, Captured { bodies: bodies, entries: state.entries,
    visited: state.checked, capture_refused: state.refused })
}

fn spanless(syms: Map[Int, Sym]) -> Map[Int, Sym] = {
  var out: Map[Int, Sym] = map.empty()
  for (id, s) in map.entries(syms) { out = map.insert(out, id, Sym { ..s, dlo: 0, dhi: 0 }) }
  out
}

fn traced_executor() -> BodyExecutor[List[String]] = {
  let cold: BodyExecutor[List[String]] = checker.cold_body_executor()
  BodyExecutor {
    function: (state, cx, d, sig) => cold.function(state ++ ["function:" ++ d.name], cx, d, sig),
    inferred_body: (state, cx, d, sig) => cold.inferred_body(state ++ ["inferred:" ++ d.name], cx, d, sig),
    constant: (state, cx, d, ty, visible) => cold.constant(state ++ ["constant:" ++ d.name], cx, d, ty, visible),
    method: (state, cx, tr, subject, d, sig) => cold.method(state ++ ["method:" ++ d.name], cx, tr, subject, d, sig),
    default_body: (state, cx, tr, d, sig, body) => cold.default_body(state ++ ["default:" ++ d.name], cx, tr, d, sig, body),
    test_body: (state, cx, name, body) => cold.test_body(state ++ ["test:" ++ name], cx, name, body)
  }
}

test "record using preserves six role order state and cold products" {
  let src = "type Coin = { v: Int }\n" ++
    "trait Waxy[T] { fn wax(x: T) -> Int\n fn buff(x: T) -> Int = wax(x) + 1 }\n" ++
    "impl Waxy[Coin] { fn wax(x: Coin) -> Int = x.v }\n" ++
    "fn caller() = leaf()\nfn leaf() = 2\nconst A: Int = 1\nconst B: Int = A\n" ++
    "fn add(x: Int = 7) -> Int = x + B\ntest \"result\" { assert add() == 8 }\n"
  let (syntax, ds) = parser.parse_module(src)
  assert ds == []
  let scope = identity.module_key("recording", "sample", "sample", "sample.dawn")
  let headers = checker.check_module_headers(cx_new(Some("sample"), Some("sample.dawn")), syntax, map.empty())
  let initial = ["initial"]
  let (trace, actual) = record_using(scope, headers, initial, traced_executor())
  assert trace == ["initial", "inferred:leaf", "inferred:caller", "constant:A", "constant:B",
    "function:add", "method:wax", "default:buff", "test:result"]
  assert actual.visited == 8 && actual.capture_refused == 0
  let cold: BodyExecutor[Unit] = checker.cold_body_executor()
  let (_, canonical) = record_using(scope, headers, (), cold)
  assert actual.entries == canonical.entries
  let (_, plain) = checker.execute_module_bodies(headers, initial, traced_executor())
  let (actual_cx, actual_tm) = checker.assemble_module_bodies(actual.bodies)
  let (plain_cx, plain_tm) = checker.assemble_module_bodies(plain)
  assert actual_tm == plain_tm && actual_cx.diags == plain_cx.diags
  assert actual_cx.function_reads == None && actual_cx.body_writes == None
  let observed_headers = ModuleHeaders { ..headers, cx: Cx { ..headers.cx,
    function_reads: Some([semantic_reads.ScopedEffectVariable("outer", None)]),
    body_writes: Some([write_journal.SignatureKey("outer")]) } }
  let (_, observed_result) = record_using(scope, observed_headers, initial, traced_executor())
  assert observed_result.entries == actual.entries
  let reads = observed_result.bodies.cx.function_reads.expect("outer reads")
  let writes = observed_result.bodies.cx.body_writes.expect("outer writes")
  assert reads[0] == semantic_reads.ScopedEffectVariable("outer", None)
  assert writes[0] == write_journal.SignatureKey("outer")
  assert len(reads) > 1 && len(writes) > 1
}

test "renewal decisions preserve strict callbacks and single assembly output" {
  let (syntax, ds) = parser.parse_module("fn scalar(x: Int) -> Int = x + 1\n")
  assert ds == []
  let scope = identity.module_key("decisions", "sample", "sample", "sample.dawn")
  let headers = checker.check_module_headers(cx_new(Some("sample"), Some("sample.dawn")), syntax, map.empty())
  let recorded = record(scope, headers)
  let (d, sig, product) = match recorded.entries[0] {
    SavedFunction(_, FunctionInput(d, sig, _), p) -> (d, sig, p)
    _ -> panic("renewal decision fixture")
  }
  let start = observed(headers.cx)
  let cold: BodyExecutor[List[String]] = checker.cold_body_executor()
  let (_, checked, tree) = cold.function([], start, d, sig)
  let (_, changed, _, refused) = decided(Checked(["checked"], Cx { ..checked, owner_class: Some("foreign") }, tree), start, d, sig, cold.function)
  assert changed.owner_class == Some("foreign") && refused == None
  let invalid_frame = BodyProduct { ..product, frame: Frame { ..product.frame, loop_stack: [1] } }
  let (kept, installed, _, capture_refused) = decided(Install(["hit"], ["fallback"], invalid_frame), start, d, sig,
    (state, cx, declaration, signature) => panic("renewal decision repeated successful assembly"))
  assert kept == ["hit"] && installed.frame.loop_stack == [1] && capture_refused == None
  # Assembly can fail before capture: the fallback is called exactly once and
  # its chosen context, tree and strict product are retained.
  let occupied = Cx { ..start, decl_slots: map.insert(start.decl_slots, product.owner_decl, product.owner_slots + 1) }
  let (fallback, actual, fallback_tree, saved) = decided(Install(["hit"], ["fallback"], product), occupied, d, sig,
    (state, cx, declaration, signature) => {
      let (_, next, function) = cold.function(state, cx, declaration, signature)
      (state ++ ["cold"], next, function)
    })
  assert fallback == ["fallback", "cold"]
  assert saved == body_product.capture_journaled(occupied, actual, fallback_tree)
}

test "record using refuses capture without retrying or losing callback output" {
  let (syntax, ds) = parser.parse_module("fn answer() -> Int = 42\n")
  assert ds == []
  let scope = identity.module_key("recording", "sample", "sample", "sample.dawn")
  let headers = checker.check_module_headers(cx_new(Some("sample"), Some("sample.dawn")), syntax, map.empty())
  let cold: BodyExecutor[List[String]] = checker.cold_body_executor()
  # Fault injection: this output deliberately loses its journal. It remains
  # the current result, but cannot establish a reusable saved transition.
  let broken = BodyExecutor { ..cold, function: (count, cx, d, sig) => {
    let (_, next, tree) = cold.function(count, cx, d, sig)
    (count ++ ["visited"], Cx { ..next, body_writes: None }, tree)
  } }
  let (count, actual) = record_using(scope, headers, ["initial"], broken)
  assert count == ["initial", "visited"] && actual.visited == 1 && actual.capture_refused == 1
  assert actual.entries == []
  let (_, expected) = checker.check_module_bodies(headers)
  let (cx, tree) = checker.assemble_module_bodies(actual.bodies)
  assert tree == expected && cx.diags == []
}

test "body recording captures all roles at actual scheduler entries" {
  let src = "type Coin = { v: Int }\n" ++
    "trait Waxy[T] { fn wax(x: T) -> Int\n fn buff(x: T) -> Int = wax(x) + 1 }\n" ++
    "impl Waxy[Coin] { fn wax(x: Coin) -> Int = x.v }\n" ++
    "fn caller() = leaf()\nfn leaf() = 2\nconst A: Int = 1\nconst B: Int = A\n" ++
    "fn add(x: Int = 7) -> Int = x + B\ntest \"result\" { assert add() == 8 }\n"
  let (syntax, ds) = parser.parse_module(src)
  assert ds == []
  let scope = identity.module_key("recording", "sample", "sample", "sample.dawn")
  let start = cx_new(Some("sample"), Some("sample.dawn"))
  let headers = checker.check_module_headers(start, syntax, map.empty())
  let cold = checker.check_module_body_products(headers)
  let actual = record(scope, headers)
  assert actual.checked == 8 && actual.refused == 0 && len(actual.entries) == 8
  var names: List[String] = []
  var total_reads = 0
  for entry in actual.entries {
    match entry {
      SavedFunction(key, input, product) -> {
        assert key.scope == scope
        assert match product.function_reads { Some(_) -> true, None -> false }
        total_reads = total_reads + len(product.function_reads.expect("body-local observations"))
        match input {
          FunctionInput(d, _, inferring) -> {
            names = names ++ [d.name]
            assert key == named(scope, d.name, FunctionDecl)
            if inferring { assert len(product.signatures) > 0 }
          }
          MethodInput(_, _, d, _) -> { names = names ++ [d.name]
            assert len(key.path) == 2 && product.tree.impl_of == None }
          DefaultInput(_, d, _) -> { names = names ++ [d.name]
            assert len(key.path) == 2 }
          TestInput(name, _) -> { names = names ++ [name]
            assert key == named(scope, name, TestDecl) }
        }
      }
      SavedConstant(key, d, _, visible, product) -> {
        names = names ++ [d.name]
        assert key == named(scope, d.name, ConstDecl)
        if d.name == "A" { assert visible == set.empty() } else { assert visible == set.from(["A"]) }
        assert match product.function_reads { Some(_) -> true, None -> false }
        total_reads = total_reads + len(product.function_reads.expect("constant observations"))
      }
    }
  }
  assert names == ["leaf", "caller", "A", "B", "add", "wax", "buff", "result"]
  assert total_reads > 0 && actual.bodies.cx.function_reads == None
  var replayed = headers.cx
  for entry in actual.entries {
    let initial = observed(replayed)
    let replay = match entry {
      SavedFunction(_, _, product) -> body_product.assemble(initial, product)
      SavedConstant(_, _, _, _, product) -> body_product.assemble(initial, product)
    }
    assert match replay { Some(_) -> true, None -> false }
    replayed = restore_log(replayed, replay.expect("recorded state replay"))
  }
  # Declaring spans are left out of the comparison on purpose. A symbol's
  # span is measured from the declaration that minted it and becomes a
  # position at that declaration's exit, which is a step of the scheduler's
  # that this loop does not take: it installs products and stops there.
  assert spanless(replayed.syms) == spanless(actual.bodies.cx.syms)
  assert replayed.fns == actual.bodies.cx.fns
  assert replayed.alias_resolved == actual.bodies.cx.alias_resolved && replayed.frame == actual.bodies.cx.frame
  assert replayed.diags == actual.bodies.cx.diags && replayed.decl_slots == actual.bodies.cx.decl_slots
  assert match replayed.body_writes { None -> true, Some(_) -> false }
  let (next, tm) = checker.assemble_module_bodies(actual.bodies)
  let (old, cold_tm) = checker.assemble_module_bodies(cold)
  assert tm == cold_tm && next.decl_slots == old.decl_slots && next.diags == old.diags
  assert next.fns == old.fns && next.alias_resolved == old.alias_resolved && next.frame == old.frame
  let prefix = Some([semantic_reads.StdModuleMode(true)])
  let observed_headers = ModuleHeaders { ..headers, cx: Cx { ..headers.cx, function_reads: prefix } }
  let observed_cold = checker.check_module_body_products(observed_headers)
  let observed_actual = record(scope, observed_headers)
  assert observed_actual.bodies.cx.function_reads == observed_cold.cx.function_reads
  let journal_headers = ModuleHeaders { ..headers, cx: Cx { ..headers.cx, body_writes: Some([write_journal.AliasKey("prefix")]) } }
  let journal_cold = checker.check_module_body_products(journal_headers)
  assert record(scope, journal_headers).bodies.cx.body_writes == journal_cold.cx.body_writes
  assert record(ModuleKey { ..scope, source: "foreign.dawn" }, headers).refused == 8
}

test "body recording refuses ambiguous declarations without changing recovery" {
  let (syntax, ds) = parser.parse_module("fn duplicate() -> Int = 1\nfn duplicate() -> Int = 2\n")
  assert ds == []
  let scope = identity.module_key("recording", "sample", "sample", "sample.dawn")
  let start = cx_new(Some("sample"), Some("sample.dawn"))
  let headers = checker.check_module_headers(start, syntax, map.empty())
  let actual = record(scope, headers)
  let cold = checker.check_module_body_products(headers)
  assert actual.checked == 2 && actual.refused == 2 && len(actual.entries) == 0
  assert actual.bodies.functions == cold.functions && actual.bodies.cx.diags == cold.cx.diags
  let hidden = ModuleHeaders { ..headers, cx: Cx { ..headers.cx, diags: [] } }
  assert len(record(scope, hidden).entries) == 0
}

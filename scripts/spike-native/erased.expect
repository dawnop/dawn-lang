-- erased projection --
label_of(b)   = deep
tag_of(b)     = 7
b.inner.label = deep
-- String order --
apple < banana = true
banana < apple = false
apple <= apple = true
banana > apple = true
-- Float remainder --
7.5 % 2.0     = 1.5
-7.5 % 2.0    = -1.5
-- diverging store --
pick(true)    = start
-- shared dictionary --
is_ab here    = true
is_ab there   = true

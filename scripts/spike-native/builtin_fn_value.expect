-- parse_int --
Some(42) Some(42)
Some(-7) Some(-7)
Some(12) Some(12)
None None
None None
None None
None None
-- parse_int with a radix --
Some(255) Some(255)
Some(-5) Some(-5)
None None
-- parse_float --
Some(1.5) Some(1.5)
Some(-25.0) Some(-25.0)
None None
None None
None None
None None
Some(Infinity) Some(Infinity)
Some(NaN) Some(NaN)
None None
-- in a const --
Some(42) Some(42)
Some(255) Some(255)
None None
Some(25.0) Some(25.0)
-- through a higher-order call --
[Some(3.0), Some(4.5), None]
[1, 2, 3]

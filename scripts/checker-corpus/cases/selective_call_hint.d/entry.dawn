# checker.dawn: an undefined call whose name a selectively imported module
# exports but the selection list leaves out (#528). The hint names the list.
use lib.{keep}
use bare.{other}

# `lib` has `sub`, the list does not: add it, and no std module is named
pub fn dot_missing(x: Int) -> Int = x.sub(1)

pub fn plain_missing(x: Int) -> Int = sub(x, 1)

# `bare` is imported selectively but has no `mul`: the std hint is unchanged
pub fn dot_std(x: Int) -> Int = x.mul(2)

pub fn used(x: Int) -> Int = keep(x) + other(x)

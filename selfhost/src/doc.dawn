# `selfhost doc` — a faithful port of dawn.cli.Doc: emit a project's pub API
# (with `##` doc comments) or the builtin reference as JSON on stdout, byte
# for byte what `dawn doc` prints. The JSON writer mirrors JsonWriter (pretty,
# 2-space indent, key and value on one line, deterministic).
#
# Every doc it publishes is also checked for `[`name`]` links (spec §1.2): each
# one is resolved in the doc's own module (`driver/doclinks`) and written as a
# `links` array beside the doc, and one that resolves to nothing fails the
# command instead of printing JSON. This is the only place links are checked:
# the compiler does not read comments, and the site build, which runs
# `dawn doc --stdlib`, is how std's links are held to it.
#
# A pub declaration's examples -- the bodies of the tests named by it (spec
# §3.4) -- are written as `examples` after its doc and links, and only when it
# has one, so every declaration without an example is the bytes it was before
# examples existed. The checker has already refused a test whose name lands on
# nothing; what is left here is filing each body under its declaration.

use std/char
use std/str
use std/list
use std/map
use std/set
use std/io
use std/io.{Fs, Env}
use front/docs.{
  DocSrc, doc_src_of, doc_of, member_doc_of, module_doc_of, doc_first_line, doc_links,
  module_examples
}
use front/ast.{
  Module, module_fns, module_types, module_consts, module_traits, module_effects, VisPub
}
use driver/analyze.{
  Program, CheckedMod, analyze_standalone, load_directory, analyze_program, own_module_paths
}
use driver/fsmem
use std/memfs
use compiler_plan/envmem
use driver/doclinks.{LinkScope, LinkTarget, resolve_link}
use check/cx.{Cx}
use driver/stdlib.{StdCtx, load_std, std_load_error_text}
use check/tast.{TModule}
use ir/interp.{CtOut, comptime_refuses, ct_default}
use check/jsig.{jsig_refused}
use check/types.{
  Adts, Traits, AdtI, adt_of, trait_of, ty_show, sig_render,
  prelude_traits, prelude_trait_ids, builtins, internal_builtins,
  documented_builtin_types, builtin_type_use, internal_std_modules
}

# ---- the JSON writer (JsonWriter, as a threaded record) ----
#
# `errs` rides along with the writer rather than beside it: every doc the
# output carries passes through here, and a link in one that resolves to
# nothing is recorded where the doc is written (`w_links`), which is the one
# place that knows both the module and the line. A non-empty `errs` makes the
# whole command fail (`DocOut`), so the JSON built alongside is never printed.

type W = {
  parts: List[String],
  indent: Int,
  need_comma: Bool,
  trailing_key: Bool,
  errs: List[String]
}

fn w_new() -> W = W { parts: [], indent: 0, need_comma: false, trailing_key: false, errs: [] }

## What `dawn doc` prints: the JSON, or one line per doc link that resolves
## to nothing (`<module>:<line>: doc link [`name`] <why>`), in which case the
## command prints no JSON and fails.
pub(pkg) alias DocOut = Result[String, List[String]]

fn w_out(w: W) -> DocOut = if len(w.errs) > 0 { Err(w.errs) } else { Ok(w_done(w)) }

fn pad(w: W) -> W = W { ..w, parts: w.parts ++ [str.repeat("  ", w.indent)] }

fn pre_value(w: W) -> W =
  if w.trailing_key {
    W { ..w, parts: w.parts ++ [" "], trailing_key: false, need_comma: false }
  } else {
    let w1 = W { ..w, parts: w.parts ++ [if w.need_comma { ",\n" } else { "\n" }] }
    let w2 = pad(w1)
    W { ..w2, need_comma: false }
  }

fn open_obj(w: W) -> W = {
  let w1 = pre_value(w)
  W { ..w1, parts: w1.parts ++ ["{"], indent: w1.indent + 1, need_comma: false }
}

fn close_obj(w: W) -> W = {
  let w1 = pad(W { ..w, indent: w.indent - 1, parts: w.parts ++ ["\n"] })
  W { ..w1, parts: w1.parts ++ ["}"], need_comma: true }
}

fn open_arr(w: W) -> W = {
  let w1 = pre_value(w)
  W { ..w1, parts: w1.parts ++ ["["], indent: w1.indent + 1, need_comma: false }
}

## `any` = whether the array got at least one element (decides the closing
## bracket's own line, as JsonWriter does).
fn close_arr(w: W, any: Bool) -> W = {
  let w1 = W { ..w, indent: w.indent - 1 }
  let w2 = if any { pad(W { ..w1, parts: w1.parts ++ ["\n"] }) } else { w1 }
  W { ..w2, parts: w2.parts ++ ["]"], need_comma: true }
}

fn w_key(w: W, k: String) -> W = {
  let w1 = pad(W { ..w, parts: w.parts ++ [if w.need_comma { ",\n" } else { "\n" }] })
  W { ..w1, parts: w1.parts ++ ["${quote(k)}:"], need_comma: false, trailing_key: true }
}

fn w_str(w: W, s: String) -> W = {
  let w1 = pre_value(w)
  W { ..w1, parts: w1.parts ++ [quote(s)], need_comma: true }
}

fn w_bool(w: W, b: Bool) -> W = {
  let w1 = pre_value(w)
  W { ..w1, parts: w1.parts ++ [if b { "true" } else { "false" }], need_comma: true }
}

fn w_field(w: W, k: String, v: String) -> W = w_str(w_key(w, k), v)

fn w_field_bool(w: W, k: String, v: Bool) -> W = w_bool(w_key(w, k), v)

fn w_field_opt(w: W, k: String, v: Option[String]) -> W = {
  let w1 = w_key(w, k)
  match v {
    Some(s) -> w_str(w1, s)
    None -> {
      let w2 = pre_value(w1)
      W { ..w2, parts: w2.parts ++ ["null"], need_comma: true }
    }
  }
}

# ---- doc links (spec §1.2) ----

## What resolving a doc's links needs: the module the doc is written in (its
## scope), the parse tree of every module a link may land in, by module path,
## and the module's comment table, which places a doc's lines in the file.
type Lk = { sc: LinkScope, mods: Map[String, Module], ds: DocSrc }

fn lk_of(cm: CheckedMod, mods: Map[String, Module], ds: DocSrc) -> Lk =
  Lk { sc: LinkScope { path: cm.mod_path, m: cm.m, cx: cm.cx }, mods: mods, ds: ds }

## The links of `doc`, whose first line is line `first` of its module, as a
## `links` array right after the doc, one entry per distinct link text in the
## order first written. A doc with no links writes no key, so every object
## whose doc links nothing is the bytes it was before links existed. A link
## that resolves to nothing goes to `w.errs` instead.
fn w_links(w: W, lk: Lk, doc: Option[String], first: Int) -> W = {
  let d = match doc {
    Some(t) -> t
    None -> return w
  }
  var w1 = w
  var found: List[(String, LinkTarget)] = []
  var texts: List[String] = []
  for l in doc_links(d) {
    match resolve_link(lk.sc, lk.mods, l.text) {
      Ok(t) ->
        if not list.contains(texts, l.text) {
          texts = texts ++ [l.text]
          found = found ++ [(l.text, t)]
        }
      Err(why) -> {
        let at = "${lk.sc.path}:${first + l.line}"
        w1 = W { ..w1, errs: w1.errs ++ ["${at}: doc link [`${l.text}`] does not resolve: ${why}"] }
      }
    }
  }
  if len(found) == 0 { return w1 }
  w1 = w_key(w1, "links")
  w1 = open_arr(w1)
  for pr in found {
    let (text, t) = pr
    w1 = open_obj(w1)
    w1 = w_field(w1, "text", text)
    w1 = w_key(w1, "target")
    w1 = open_obj(w1)
    w1 = w_field(w1, "module", t.module)
    w1 = w_field(w1, "name", t.name)
    w1 = w_field(w1, "kind", t.kind)
    w1 = close_obj(w1)
    w1 = close_obj(w1)
  }
  close_arr(w1, true)
}

## The examples of the declaration spelled `key` (`f`, `T`, `T.Ctor`) as an
## `examples` array of their source texts, in the order written. None writes
## no key.
fn w_examples(w: W, ex: Map[String, List[String]], key: String) -> W =
  match map.get(ex, key) {
    Some(srcs) -> {
      var w1 = open_arr(w_key(w, "examples"))
      for src in srcs { w1 = w_str(w1, src) }
      close_arr(w1, true)
    }
    None -> w
  }

## A declaration's doc, read from the declaration starting at `lo`, written
## as `doc` (null when there is none) and then its `links`.
fn w_doc(w: W, lk: Lk, d: Option[String], lo: Int) -> W = {
  let first = match d {
    Some(t) -> doc_first_line(lk.ds, lo, t)
    None -> 0
  }
  w_links(w_field_opt(w, "doc", d), lk, d, first)
}

## `w_doc` for a member found by name: `los` holds its declaration's `lo`, or
## nothing when the parse tree has no such member.
fn w_member_doc(w: W, lk: Lk, d: Option[String], los: List[Int]) -> W =
  w_doc(w, lk, d, unwrap_or(get(los, 0), 0))

fn w_done(w: W) -> String = {
  var s = join(w.parts, "")
  while str.starts_with(s, "\n") { s = str.drop(s, 1) }
  "${s}\n"
}

fn hex_digit(n: Int) -> String = str.slice("0123456789abcdef", n, n + 1)

fn quote(s: String) -> String = {
  var out: List[String] = ["\""]
  for c in code_points(s) {
    if c == '"' {
      out = out ++ ["\\\""]
    } else if c == '\\' {
      out = out ++ ["\\\\"]
    } else if c == '\n' {
      out = out ++ ["\\n"]
    } else if c == '\r' {
      out = out ++ ["\\r"]
    } else if c == '\t' {
      out = out ++ ["\\t"]
    } else if c < ' ' {
      let n = char.code(c)
      out = out ++ ["\\u00" ++ hex_digit(n / 16) ++ hex_digit(n % 16)]
    } else {
      out = out ++ [from_code_points([c])]
    }
  }
  "${join(out, "")}\""
}

# ---- project JSON ----

fn adt_by_name(adts: Adts, owner: String, name: String) -> Option[AdtI] = {
  for aid in sort(map.keys(adts)) {
    let a = adt_of(adts, aid)
    let own = match a.owner {
      Some(o) -> o == owner
      None -> false
    }
    if own && a.name == name { return Some(a) }
  }
  None
}

## The trait's methods as the checker registered them, each with the `##`
## block above its declaration: `decls` is the parse tree's `(name, lo)` per
## method, matched by name because the checker's record carries no span.
fn trait_methods_json(w: W, cx: Cx, owner: String, name: String, decls: List[(String, Int)], lk: Lk) -> W = {
  var w1 = w_key(w, "methods")
  w1 = open_arr(w1)
  var any = false
  for tid in sort(map.keys(cx.traits)) {
    let t = trait_of(cx.traits, tid)
    let own = match t.owner {
      Some(o) -> o == owner
      None -> false
    }
    if own && t.name == name {
      for pr in t.methods {
        let (mname, ms) = pr
        any = true
        w1 = open_obj(w1)
        w1 = w_field(w1, "name", mname)
        w1 = w_field(w1, "sig", sig_render(cx.adts, cx.traits, ms.sig))
        w1 = w_field_bool(w1, "hasDefault", ms.has_default)
        let los = los_named(decls, mname)
        w1 = w_member_doc(w1, lk, member_doc(lk.ds, los), los)
        w1 = close_obj(w1)
      }
    }
  }
  close_arr(w1, any)
}

## The `lo` of every declaration in `decls` named `name`.
fn los_named(decls: List[(String, Int)], name: String) -> List[Int] = {
  var out: List[Int] = []
  for pr in decls {
    let (n, lo) = pr
    if n == name { out = out ++ [lo] }
  }
  out
}

## The doc of the member declared at the first of `los`, or None when the
## parse tree has no such member (a name the checker synthesized). Members are
## matched by name because the checker's records carry no spans.
fn member_doc(ds: DocSrc, los: List[Int]) -> Option[String] =
  match get(los, 0) {
    Some(lo) -> doc_of(ds, lo)
    None -> None
  }

## `member_doc` for a constructor or a field, whose owner (the type, or the
## constructor) starts at `owner_lo`: on its owner's line it has no doc of its
## own (`front/docs.member_doc_of`).
fn owned_doc(ds: DocSrc, owner_lo: Int, los: List[Int]) -> Option[String] =
  match get(los, 0) {
    Some(lo) -> member_doc_of(ds, owner_lo, lo)
    None -> None
  }

## One module's pub API. `ex` is its examples by declaration spelling
## (`front/docs.module_examples`).
fn module_json(w: W, cm: CheckedMod, lk: Lk, ex: Map[String, List[String]]) -> W = {
  let ds = lk.ds
  var w1 = open_obj(w)
  w1 = w_field(w1, "path", cm.mod_path)
  # written only when the module has one, so a project of files that open with
  # a plain `#` header emits exactly the bytes it did before module docs existed
  match module_doc_of(ds, cm.m) {
    Some(d) -> { w1 = w_links(w_field(w1, "doc", d), lk, Some(d), 1) }
    None -> ()
  }
  w1 = w_key(w1, "fns")
  w1 = open_arr(w1)
  var any = false
  for fd in module_fns(cm.m) {
    if fd.vis == VisPub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", fd.name)
      let sig = match map.get(cm.cx.fns, fd.name) {
        Some(s) -> sig_render(cm.cx.adts, cm.cx.traits, s)
        None -> fd.name
      }
      w1 = w_field(w1, "sig", sig)
      w1 = w_doc(w1, lk, doc_of(ds, fd.lo), fd.lo)
      w1 = w_examples(w1, ex, fd.name)
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "types")
  w1 = open_arr(w1)
  any = false
  for td in module_types(cm.m) {
    if td.vis == VisPub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", td.name)
      w1 = w_field_bool(w1, "record", td.is_record)
      w1 = w_key(w1, "typeParams")
      w1 = open_arr(w1)
      for tp in td.tparams { w1 = w_str(w1, tp) }
      w1 = close_arr(w1, len(td.tparams) > 0)
      w1 = w_key(w1, "ctors")
      w1 = open_arr(w1)
      var cany = false
      match adt_by_name(cm.cx.adts, cm.class_name, td.name) {
        Some(a) -> {
          for c in a.ctors {
            cany = true
            let cdecl = get(filter(td.ctors, d => d.name == c.name), 0)
            w1 = open_obj(w1)
            w1 = w_field(w1, "name", c.name)
            w1 = w_key(w1, "fields")
            w1 = open_arr(w1)
            for f in c.fields {
              let (flo, flos) = match cdecl {
                Some(d) -> (d.lo, map(filter(d.fields, fd => fd.name == f.name), fd => fd.lo))
                None -> (td.lo, [])
              }
              w1 = open_obj(w1)
              w1 = w_field(w1, "name", f.name)
              w1 = w_field(w1, "type", ty_show(cm.cx.adts, f.ty))
              w1 = w_member_doc(w1, lk, owned_doc(ds, flo, flos), flos)
              w1 = close_obj(w1)
            }
            w1 = close_arr(w1, len(c.fields) > 0)
            let clos = match cdecl {
              Some(d) -> [d.lo]
              None -> []
            }
            w1 = w_member_doc(w1, lk, owned_doc(ds, td.lo, clos), clos)
            w1 = w_examples(w1, ex, "${td.name}.${c.name}")
            w1 = close_obj(w1)
          }
        }
        None -> ()
      }
      w1 = close_arr(w1, cany)
      w1 = w_doc(w1, lk, doc_of(ds, td.lo), td.lo)
      w1 = w_examples(w1, ex, td.name)
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "consts")
  w1 = open_arr(w1)
  any = false
  for cd in module_consts(cm.m) {
    if cd.vis == VisPub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", cd.name)
      let ty = match map.get(cm.cx.consts, cd.name) {
        Some(t) -> ty_show(cm.cx.adts, t)
        None -> ""
      }
      w1 = w_field(w1, "type", ty)
      w1 = w_doc(w1, lk, doc_of(ds, cd.lo), cd.lo)
      w1 = w_examples(w1, ex, cd.name)
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "traits")
  w1 = open_arr(w1)
  any = false
  for td in module_traits(cm.m) {
    if td.vis == VisPub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", td.name)
      w1 = w_field(w1, "typeParam", td.tp)
      w1 = w_key(w1, "assoc")
      w1 = open_arr(w1)
      for ad in td.assoc {
        w1 = open_obj(w1)
        w1 = w_field(w1, "name", ad.name)
        w1 = w_doc(w1, lk, doc_of(ds, ad.lo), ad.lo)
        w1 = close_obj(w1)
      }
      w1 = close_arr(w1, len(td.assoc) > 0)
      # associated effects, beside the associated types (决策 9). The key is
      # written only when the trait declares one, so every effect-free
      # trait's doc output is byte-identical to what it was.
      if len(td.eff_assoc) > 0 {
        w1 = w_key(w1, "effectAssoc")
        w1 = open_arr(w1)
        for ad in td.eff_assoc {
          w1 = open_obj(w1)
          w1 = w_field(w1, "name", ad.name)
          # the default row (#369), written only when the member has one, so
          # a defaultless member's doc output is byte-identical to before
          match ad.default {
            Some(atoms) -> {
              w1 = w_field(w1, "default",
                if len(atoms) == 0 { "!()" } else { "!${atoms[0]}" })
            }
            None -> ()
          }
          w1 = w_doc(w1, lk, doc_of(ds, ad.lo), ad.lo)
          w1 = close_obj(w1)
        }
        w1 = close_arr(w1, true)
      }
      w1 = trait_methods_json(w1, cm.cx, cm.class_name, td.name, map(td.methods, m => (m.name, m.lo)), lk)
      w1 = w_doc(w1, lk, doc_of(ds, td.lo), td.lo)
      w1 = w_examples(w1, ex, td.name)
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "effects")
  w1 = open_arr(w1)
  any = false
  for ed in module_effects(cm.m) {
    if ed.vis == VisPub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", ed.name)
      w1 = w_key(w1, "ops")
      w1 = open_arr(w1)
      for op in ed.ops {
        w1 = open_obj(w1)
        w1 = w_field(w1, "name", op.name)
        # an operation's sig lands in cx.fns under its own name (pass_effects),
        # rendered with its `!Effect` row; the bare name is the same graceful
        # fallback the fns loop uses for a signature the checker refused
        let sig = match map.get(cm.cx.fns, op.name) {
          Some(s) -> sig_render(cm.cx.adts, cm.cx.traits, s)
          None -> op.name
        }
        w1 = w_field(w1, "sig", sig)
        w1 = w_doc(w1, lk, doc_of(ds, op.lo), op.lo)
        w1 = close_obj(w1)
      }
      w1 = close_arr(w1, len(ed.ops) > 0)
      w1 = w_doc(w1, lk, doc_of(ds, ed.lo), ed.lo)
      w1 = w_examples(w1, ex, ed.name)
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "impls")
  w1 = open_arr(w1)
  # the impls the checker decided this module publishes, not the ones it has
  # (docs/public-surface-design.md §7.1): an impl of a private trait, or for a
  # private type, is not part of any API a reader of this page can use, and
  # deciding that here would be a second copy of a rule the checker already
  # applied.
  let impls = cm.cx.observable_impls
  for ii in impls {
    let t = trait_of(cm.cx.traits, ii.trait_id)
    w1 = w_str(w1, t.name ++ "[" ++ ty_show(cm.cx.adts, ii.subject) ++ "]")
  }
  w1 = close_arr(w1, len(impls) > 0)
  close_obj(w1)
}

## Every std module's parse tree by module path: where a link into std lands.
fn std_modules(std: StdCtx) -> Map[String, Module] = {
  var mods: Map[String, Module] = map.empty()
  for tr in std.srcs {
    let (mp, _, m) = tr
    mods = map.insert(mods, mp, m)
  }
  mods
}

## A project's pub API. `std` is the library the project was checked against,
## which a link in the project's docs may land in. `own` is the project's own
## module paths (`analyze.own_module_paths`): only those are written. A
## `[deps]` module stays in the link scope, so a link into a dependency still
## lands and still carries its `target`, but its docs are that package's to
## publish and to check, once, under its own `dawn doc`.
pub(pkg) fn project_json(prog: Program, std: StdCtx, own: Set[String]) -> DocOut !Fs = {
  var mods = std_modules(std)
  for cm in prog.modules { mods = map.insert(mods, cm.mod_path, cm.m) }
  var w = w_new()
  w = open_obj(w)
  w = w_key(w, "modules")
  w = open_arr(w)
  var any = false
  for cm in prog.modules {
    if set.has(own, cm.mod_path) {
      let text = match io.read_file(cm.path) {
        Ok(t) -> t
        Err(e) -> panic("cannot re-read " ++ cm.path ++ ": " ++ e.message)
      }
      w = module_json(w, cm, lk_of(cm, mods, doc_src_of(text)), module_examples(text, cm.m))
      any = true
    }
  }
  w = close_arr(w, any)
  w = close_obj(w)
  w_out(w)
}

# ---- builtin reference (Doc.kt BUILTIN_GROUPS, verbatim) ----
#
# The group names are a table of contents for a reader, not a claim about
# effect rows. Three of the four names under "io" below raise no `io` at all --
# `bracket` never did, `catch_fault` stopped on 2026-09-01
# (docs/audit/error-model-design.md §7.5) -- and they belong here because that
# is where somebody looking for "the failure primitives" looks. The rows are in
# the rendered signatures right beside these lines.

fn builtin_groups() -> List[(String, List[(String, String)])] = [
  ("io", [
    ("println", "print a string followed by a newline"),
    ("print", "print a string without a newline"),
    ("args", "command line arguments"),
    ("catch_fault", "run a closure, turning an external failure into Err (panics pass through)"),
    ("catch_panic", "run a closure at an isolation boundary, catching a panic or an exception into Err"),
    ("bracket",
      "use an acquired resource and release it on every way out -- the value, a panic or a fault; the failure carries on unchanged (this catches nothing)")
  ]),
  ("list", [
    ("map", "a new list with a function applied to every element"),
    ("filter", "the elements satisfying a predicate, in order"),
    ("fold", "reduce from the left with an accumulator"),
    ("len", "number of elements"),
    ("get", "element at an index; None when out of bounds"),
    ("range", "the integers from..to (exclusive)"),
    ("sort", "ascending stable sort (elements need Ord)"),
    ("sort_by", "stable sort with a two-argument cmp function"),
    ("max", "the first greatest element; None when empty (elements need Ord)"),
    ("min", "the first least element; None when empty (elements need Ord)"),
    ("max_by", "the first element whose key is greatest; None when empty (keys need Ord)"),
    ("min_by", "the first element whose key is least; None when empty (keys need Ord)")
  ]),
  ("string", [
    ("to_string", "render any printable value (numbers, strings, derive Show data)"),
    ("join", "concatenate with a separator"),
    ("parse_int", "parse an integer, decimal unless a radix 2 through 36 is given; None on malformed input"),
    ("parse_float", "parse a floating point number; None on malformed input")
  ]),
  ("interop", [
    ("cast",
      "reclaim an erased Java Object as a concrete reference type T, taken from the expected type at the call site (interop escape; a runtime CHECKCAST guards it, and a miss is an Err rather than a throw)")
  ]),
  ("char", [
    ("code_points", "split a string into Unicode scalar-value characters"),
    ("from_code_points", "assemble a string from characters"),
    ("char_is_letter", "whether a character is a Unicode letter"),
    ("char_is_digit", "whether a character is a decimal digit"),
    ("char_is_alnum", "whether a character is a letter or decimal digit"),
    ("char_is_upper", "whether a character is upper-case"),
    ("char_is_lower", "whether a character is lower-case"),
    ("char_is_space", "whether a character is whitespace")
  ]),
  ("option", [
    ("expect", "unwrap a Some or panic with a message"),
    ("unwrap_or", "the Some value, or a fallback for None")
  ]),
  ("conversion", [
    ("to_float", "Int to Float"),
    ("to_int", "Float to Int (truncates)")
  ]),
  ("control", [
    ("panic", "abort with a message (diverges, so usable at any type)"),
    ("todo", "placeholder that panics when reached"),
    ("dbg",
      "debug print: write `[path:line:col] <argument text> = <show>` to stderr and return the argument unchanged; pure by type, a no-op in a const, and an error in std and in [deps] packages"),
    ("discard",
      "abandon the computation a continuation would have resumed, running every bracket release inside it; the ticket is spent, so resuming afterwards panics")
  ])
]

## The hand-written reference is intentionally prose, but its membership is a
## contract: every public compiler builtin appears exactly once, and every
## documented name resolves either there or in the prelude migrated to std.
fn validate_builtin_groups(std: StdCtx) -> Unit = {
  let bi = builtins()
  let hidden = internal_builtins()
  var seen: Set[String] = set.empty()
  for grp in builtin_groups() {
    let (_, fns) = grp
    for pr in fns {
      let (name, _) = pr
      if set.has(seen, name) {
        panic("the builtin reference names a function twice: ${name}")
      }
      seen = set.insert(seen, name)
      if not map.has(bi, name) && not map.has(std.std_fns, name) {
        panic("the builtin reference names an unknown function: ${name}")
      }
    }
  }
  for name in map.keys(bi) {
    if not set.has(hidden, name) && not set.has(seen, name) {
      panic("the builtin reference omits a public function: ${name}")
    }
  }
  for name in map.keys(std.std_fns) {
    if not set.has(seen, name) {
      panic("the builtin reference omits a public function: ${name}")
    }
  }
}

fn builtin_types_json(w0: W) -> W = {
  var w = w0
  for info in documented_builtin_types() {
    w = open_obj(w)
    w = w_field(w, "name", info.name)
    w = w_key(w, "params")
    w = open_arr(w)
    for param in info.params { w = w_str(w, param) }
    w = close_arr(w, len(info.params) > 0)
    w = w_field(w, "use", builtin_type_use(info))
    w = close_obj(w)
  }
  w
}

## The std-only builtins: `types.internal_builtins()`, which is every entry of
## the table the checker hides from a module outside `std`.
##
## They are a key of their own rather than a group, and carry no prose. A group
## is a section of a hand-written reference for people writing Dawn, and none of
## these is something to write -- `std/map`, `std/bytes` and `std/io` are the
## spellings, and `validate_builtin_groups` next door exists to keep the
## reference free of names nobody may call. What a consumer of this JSON wants
## them for is the opposite question: the playground's completion table and the
## editor tooling read `groups`, while a reader auditing the language surface
## wants to see the whole table, and until this key existed the only way to see
## it was the compiler's source.
##
## Sorted by name, because `map.keys` answers in the trie's order and a
## reference whose order moves when a name is added is a reference nothing can
## diff.
fn internal_builtins_json(w0: W, adts: Adts, traits: Traits) -> W = {
  let bi = builtins()
  let hidden = internal_builtins()
  var names: List[String] = []
  for name in list.sort(map.keys(bi)) {
    if set.has(hidden, name) { names = names ++ [name] }
  }
  var w = w0
  for name in names {
    let sig = match map.get(bi, name) {
      Some(s) -> s
      None -> panic("internal builtin without a signature: ${name}")
    }
    w = open_obj(w)
    w = w_field(w, "name", name)
    w = w_field(w, "sig", sig_render(adts, traits, sig))
    w = w_field(w, "comptime", comptime_field(name))
    w = close_obj(w)
  }
  w
}

## The `comptime` field a builtin's entry carries: whether a `const` may call
## it, which spec §7.2 sends a reader here for rather than listing the names.
## Read from the interpreter's own lists (`interp.comptime_refuses`), the ones
## its gate test measures, not from a copy kept here.
##
## Only a builtin gets the field. The hand-written groups also resolve names
## the prelude implements in std, and a std function folds or not according to
## which builtins its body reaches -- a property of the body, not of the table
## -- so for those an "ok" would be a guess and a "refused" a second analysis.
## scripts/builtin-decl-contract holds the field, on every builtin and on
## nothing else, to the mirror's `# comptime: rejected` markers.
fn comptime_field(name: String) -> String =
  if comptime_refuses(name) { "refused" } else { "ok" }

## The hand-written groups, resolved against the builtin table (falling back to
## the std prelude, where functions migrate). Shared by both output modes so
## the two references cannot drift into two answers.
fn builtin_groups_json(w0: W, std: StdCtx, traits: Traits) -> W = {
  validate_builtin_groups(std)
  let bi = builtins()
  var w = w0
  for grp in builtin_groups() {
    let (gname, fns) = grp
    w = open_obj(w)
    w = w_field(w, "name", gname)
    w = w_key(w, "fns")
    w = open_arr(w)
    for pr in fns {
      let (fname, fdoc) = pr
      let (sig, is_builtin) = match map.get(bi, fname) {
        Some(s) -> (s, true)
        None ->
          match map.get(std.std_fns, fname) {
            Some(s) -> (s, false)
            None -> panic("the builtin reference names an unknown function: ${fname}")
          }
      }
      w = open_obj(w)
      w = w_field(w, "name", fname)
      w = w_field(w, "sig", sig_render(std.adts, traits, sig))
      if is_builtin { w = w_field(w, "comptime", comptime_field(fname)) }
      w = w_field(w, "doc", fdoc)
      w = close_obj(w)
    }
    w = close_arr(w, len(fns) > 0)
    w = close_obj(w)
  }
  w
}

pub(pkg) fn builtins_json(std: StdCtx) -> DocOut = {
  let traits = prelude_traits()
  let mods = std_modules(std)
  var w = w_new()
  w = open_obj(w)
  w = w_key(w, "types")
  w = open_arr(w)
  w = builtin_types_json(w)
  w = close_arr(w, true)
  w = w_key(w, "groups")
  w = open_arr(w)
  w = builtin_groups_json(w, std, traits)
  for i in range(0, len(std.srcs)) {
    let (mod_path, text, m) = std.srcs[i]
    let (mp, cx, tm, ct) = std.mods[i]
    # the two lists are filled in the same loop, in the same order (see
    # stdlib_json); if that ever stops being true the reference would render
    # one module's signatures against another's tables
    if mp != mod_path { panic("std module lists out of step: " ++ mp ++ " vs " ++ mod_path) }
    # a signature may name a trait std itself declares (std/gpu's `Dtype`),
    # which the prelude table cannot resolve; the module's own table carries
    # both, and resolves the prelude's ids identically
    let mtraits = cx.traits
    # std/hamt and std/pvec are Map/Set/List's representation, and `use` on
    # either is a compile error outside std (spec §10.6). A reference that
    # lists them teaches an API nobody may write, so they stay out of it.
    if list.contains(internal_std_modules(), mod_path) { continue }
    let ds = doc_src_of(text)
    let lk = lk_of(std_checked_mod(mp, cx, tm, ct, m), mods, ds)
    let exp = match map.get(std.exports, mod_path) {
      Some(e) -> e
      None -> panic("std module without exports: ${mod_path}")
    }
    w = open_obj(w)
    w = w_field(w, "name", mod_path)
    w = w_key(w, "fns")
    w = open_arr(w)
    var any = false
    for fd in module_fns(m) {
      if fd.vis == VisPub {
        any = true
        let sig = match map.get(exp.fns, fd.name) {
          Some(s) -> s
          None -> panic("std export without a signature: ${fd.name}")
        }
        w = open_obj(w)
        w = w_field(w, "name", fd.name)
        w = w_field(w, "sig", sig_render(std.adts, mtraits, sig))
        w = w_str_doc(w, lk, doc_of(ds, fd.lo), fd.lo)
        w = close_obj(w)
      }
    }
    w = close_arr(w, any)
    # empty for every std module today; here so the first pub effect std
    # mints appears in the reference instead of silently missing (#115)
    w = w_key(w, "effects")
    w = open_arr(w)
    any = false
    for ed in module_effects(m) {
      if ed.vis == VisPub {
        any = true
        w = open_obj(w)
        w = w_field(w, "name", ed.name)
        w = w_key(w, "ops")
        w = open_arr(w)
        for op in ed.ops {
          let sig = match map.get(exp.fns, op.name) {
            Some(s) -> s
            None -> panic("std effect operation without a signature: ${op.name}")
          }
          w = open_obj(w)
          w = w_field(w, "name", op.name)
          w = w_field(w, "sig", sig_render(std.adts, mtraits, sig))
          w = w_str_doc(w, lk, doc_of(ds, op.lo), op.lo)
          w = close_obj(w)
        }
        w = close_arr(w, len(ed.ops) > 0)
        w = w_str_doc(w, lk, doc_of(ds, ed.lo), ed.lo)
        w = close_obj(w)
      }
    }
    w = close_arr(w, any)
    w = close_obj(w)
  }
  w = close_arr(w, true)
  w = w_key(w, "internal")
  w = open_arr(w)
  w = internal_builtins_json(w, std.adts, traits)
  w = close_arr(w, true)
  w = close_obj(w)
  w_out(w)
}

## `w_doc` in `--builtins`' shape, where a missing doc is "" rather than null.
fn w_str_doc(w: W, lk: Lk, d: Option[String], lo: Int) -> W = {
  let first = match d {
    Some(t) -> doc_first_line(lk.ds, lo, t)
    None -> 0
  }
  w_links(w_field(w, "doc", unwrap_or(d, "")), lk, d, first)
}

# ---- the standard library reference (`--stdlib`) ----

## The prelude traits carry no doc comments: they are a Dawn literal in
## types.dawn, not a declaration in any module, so there is nowhere to write
## one. The prose lives here, next to the hand-written builtin groups, for the
## same reason theirs does.
fn prelude_trait_docs() -> List[(String, String)] = [
  ("Ord",
    "total order. `cmp(a, b)` answers negative / zero / positive, and is what `<` `<=` `>` `>=` mean past the scalars; `sort` and the extremes ask for it"),
  ("Eq", "equality, behind `==` and `!=`"),
  ("Hash",
    "a value's hash, asked for alongside `Eq` by `Map` keys and `Set` elements (`[K: Eq + Hash]`)"),
  ("Show", "how `to_string` and string interpolation render a value"),
  ("Iter",
    "what `for x in c` walks: a cursor type, an item type, and the four moves over them"),
  ("Index",
    "what `c[i]` resolves to: an index type, an item type, and one method. `List` and `Map` come with an impl; a type that writes one gets `[]`"),
  ("Display",
    "the top-level rendering: an impl decides what `to_string` and string interpolation produce for the type, in place of the `Show` they would otherwise fall back on. Not derivable, and `Show` is still the bound `to_string` asks for")
]

fn prelude_trait_doc(name: String) -> String = {
  for pr in prelude_trait_docs() {
    let (n, d) = pr
    if n == name { return d }
  }
  panic("a prelude trait has no prose here: ${name}")
}

fn prelude_traits_json(w0: W, adts: Adts, traits: Traits) -> W = {
  var w = w0
  for tid in prelude_trait_ids() {
    let t = trait_of(traits, tid)
    w = open_obj(w)
    w = w_field(w, "name", t.name)
    w = w_field(w, "typeParam", ty_show(adts, t.tvar))
    w = w_key(w, "assoc")
    w = open_arr(w)
    for a in t.assoc { w = w_str(w, a) }
    w = close_arr(w, len(t.assoc) > 0)
    w = w_key(w, "methods")
    w = open_arr(w)
    for pr in t.methods {
      let (mname, ms) = pr
      w = open_obj(w)
      w = w_field(w, "name", mname)
      w = w_field(w, "sig", sig_render(adts, traits, ms.sig))
      w = w_field_bool(w, "hasDefault", ms.has_default)
      # the same shape a std trait's method has; a prelude trait has no source
      # its methods could carry a `##` block in, so the doc is always null
      w = w_field_opt(w, "doc", None)
      w = close_obj(w)
    }
    w = close_arr(w, len(t.methods) > 0)
    w = w_field(w, "doc", prelude_trait_doc(t.name))
    w = close_obj(w)
  }
  w
}

## std is checked by `load_std` with `cx_new(Some(mod_path), None)`, so a std
## ADT or trait carries its module path as its owner — which is exactly what
## `module_json` matches `class_name` against. `path` is unused here: the
## source text is already in hand, so nothing re-reads the file.
fn std_checked_mod(mp: String, cx: Cx, tm: TModule, ct: CtOut, m: Module) -> CheckedMod =
  CheckedMod { mod_path: mp, class_name: mp, path: "", m: m, cx: cx, tm: tm, ct: ct }

## The full standard library reference: the prelude's own names, the prelude
## traits, and every user-visible std module with its types, traits, consts and
## impls — not just its functions, which is all `--builtins` could ever show.
##
## The split into `groups` and `modules` is where a name is *implemented*, and
## the published page deliberately does not organise itself that way: a reader
## wants `sort` under lists, not under "builtin". What the split does carry is
## how a name is *written* — `groups` are visible with no `use`, `modules` are
## qualified — and that is a difference the reader has to know.
pub(pkg) fn stdlib_json(std: StdCtx) -> DocOut = {
  let traits = prelude_traits()
  let mods = std_modules(std)
  var w = w_new()
  w = open_obj(w)
  w = w_key(w, "groups")
  w = open_arr(w)
  w = builtin_groups_json(w, std, traits)
  w = close_arr(w, true)
  w = w_key(w, "traits")
  w = open_arr(w)
  w = prelude_traits_json(w, std.adts, traits)
  w = close_arr(w, true)
  w = w_key(w, "modules")
  w = open_arr(w)
  var any = false
  for i in range(0, len(std.mods)) {
    let (mp, cx, tm, ct) = std.mods[i]
    let (sp, text, m) = std.srcs[i]
    # the two lists are filled in the same loop, in the same order; if that
    # ever stops being true the reference would silently describe one module
    # with another's source
    if mp != sp { panic("std module lists out of step: " ++ mp ++ " vs " ++ sp) }
    if list.contains(internal_std_modules(), mp) { continue }
    any = true
    let cm = std_checked_mod(mp, cx, tm, ct, m)
    w = module_json(w, cm, lk_of(cm, mods, doc_src_of(text)), module_examples(text, m))
  }
  w = close_arr(w, any)
  w = close_obj(w)
  w_out(w)
}

fn ok_json(out: DocOut) -> String =
  match out {
    Ok(j) -> j
    Err(es) -> panic("doc links that resolve to nothing:\n" ++ join(es, "\n"))
  }

test "the reference leaves out the representation modules" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    # std/hamt and std/pvec used to get a section each, and a reader who
    # followed one got `use std/hamt` -- a compile error outside std. The
    # published reference is the API a program may write, so the filter is
    # the same list the checker refuses `use` against.
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let j = ok_json(builtins_json(std))
    for internal in internal_std_modules() {
      assert not str.contains(j, quote(internal))
    }
    # the modules that stayed are still there
    assert str.contains(j, quote("std/map"))
    assert str.contains(j, quote("std/str"))
  }))
}

test "the standard library reference carries what --builtins cannot" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let j = ok_json(stdlib_json(std))
    # the prelude's own names, unqualified
    assert str.contains(j, quote("catch_fault"))
    # the prelude traits and their methods, which live in no module at all
    assert str.contains(j, quote("Iter"))
    assert str.contains(j, quote("iter_start"))
    # a std module's types and impls -- the two `--builtins` has no room for
    assert str.contains(j, quote("Cursor"))
    assert str.contains(j, quote("Ord[Cursor]"))
    # every user-visible module documents itself
    for sm in std.srcs {
      let (mp, text, m) = sm
      if list.contains(internal_std_modules(), mp) { continue }
      assert str.contains(j, quote(mp))
      if module_doc_of(doc_src_of(text), m) == None {
        println("std module without a doc comment: ${mp}")
        assert false
      }
    }
    # and the representation modules stay out of this one too
    for internal in internal_std_modules() {
      assert not str.contains(j, quote(internal))
    }
  }))
}

test "a pub type's constructors and fields, and a pub trait's methods, carry their docs" {
  # the real handler stays: `load_std("std")` names a relative directory
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let text = join([
      "## A shape.",
      "pub type Shape =",
      "  ## A round one.",
      "  | Circle(",
      "    ## The radius.",
      "    r: Float",
      "  )",
      "  | Dot",
      "",
      "## Two ways.",
      "pub type T = A | B",
      "",
      "pub type Point = {",
      "  ## Across.",
      "  x: Int,",
      "  y: Int",
      "}",
      "",
      "pub trait Size[T] {",
      "  ## How big.",
      "  fn size(t: T) -> Int",
      "  fn none(t: T) -> Int",
      "}",
      "",
      "impl Size[Point] {",
      "  ## Not published: an impl method is the impl's business.",
      "  fn size(t: Point) -> Int = t.x",
      "  fn none(t: Point) -> Int = 0",
      "}",
      ""
    ], "\n")
    let prog = analyze_standalone("<doc-test>", text, std, ct_default(), jsig_refused())
    assert len(prog.diags) == 0
    let j = w_done(module_json(w_new(), prog.modules[0], lk_of(prog.modules[0], std_modules(std), doc_src_of(text)),
      module_examples(text, prog.modules[0].m)))
    let want = join([
      "{",
      "  \"path\": \"main\",",
      "  \"fns\": [],",
      "  \"types\": [",
      "    {",
      "      \"name\": \"Shape\",",
      "      \"record\": false,",
      "      \"typeParams\": [],",
      "      \"ctors\": [",
      "        {",
      "          \"name\": \"Circle\",",
      "          \"fields\": [",
      "            {",
      "              \"name\": \"r\",",
      "              \"type\": \"Float\",",
      "              \"doc\": \"The radius.\"",
      "            }",
      "          ],",
      "          \"doc\": \"A round one.\"",
      "        },",
      "        {",
      "          \"name\": \"Dot\",",
      "          \"fields\": [],",
      "          \"doc\": null",
      "        }",
      "      ],",
      "      \"doc\": \"A shape.\"",
      "    },",
      "    {",
      "      \"name\": \"T\",",
      "      \"record\": false,",
      "      \"typeParams\": [],",
      "      \"ctors\": [",
      "        {",
      "          \"name\": \"A\",",
      "          \"fields\": [],",
      "          \"doc\": null",
      "        },",
      "        {",
      "          \"name\": \"B\",",
      "          \"fields\": [],",
      "          \"doc\": null",
      "        }",
      "      ],",
      "      \"doc\": \"Two ways.\"",
      "    },",
      "    {",
      "      \"name\": \"Point\",",
      "      \"record\": true,",
      "      \"typeParams\": [],",
      "      \"ctors\": [",
      "        {",
      "          \"name\": \"Point\",",
      "          \"fields\": [",
      "            {",
      "              \"name\": \"x\",",
      "              \"type\": \"Int\",",
      "              \"doc\": \"Across.\"",
      "            },",
      "            {",
      "              \"name\": \"y\",",
      "              \"type\": \"Int\",",
      "              \"doc\": null",
      "            }",
      "          ],",
      "          \"doc\": null",
      "        }",
      "      ],",
      "      \"doc\": null",
      "    }",
      "  ],",
      "  \"consts\": [],",
      "  \"traits\": [",
      "    {",
      "      \"name\": \"Size\",",
      "      \"typeParam\": \"T\",",
      "      \"assoc\": [],",
      "      \"methods\": [",
      "        {",
      "          \"name\": \"size\",",
      "          \"sig\": \"fn size[T: Size](t: T) -> Int\",",
      "          \"hasDefault\": false,",
      "          \"doc\": \"How big.\"",
      "        },",
      "        {",
      "          \"name\": \"none\",",
      "          \"sig\": \"fn none[T: Size](t: T) -> Int\",",
      "          \"hasDefault\": false,",
      "          \"doc\": null",
      "        }",
      "      ],",
      "      \"doc\": null",
      "    }",
      "  ],",
      "  \"effects\": [],",
      "  \"impls\": [",
      "    \"Size[Point]\"",
      "  ]",
      "}",
      ""
    ], "\n")
    if j != want { println(j) }
    assert j == want
  }))
}

## The links of one standalone module's docs, `text -> module|name|kind`, or
## its broken-link lines.
fn probe_links(std: StdCtx, text: String) -> Result[List[String], List[String]] !Fs !Env !io = {
  let prog = analyze_standalone("<doc-test>", text, std, ct_default(), jsig_refused())
  if len(prog.diags) > 0 { panic("the probe does not check: ${prog.diags[0].d.msg}") }
  let cm = prog.modules[0]
  var mods = std_modules(std)
  mods = map.insert(mods, cm.mod_path, cm.m)
  let ds = doc_src_of(text)
  let lk = lk_of(cm, mods, ds)
  var w = w_new()
  var out: List[String] = []
  for fd in module_fns(cm.m) {
    match doc_of(ds, fd.lo) {
      Some(d) -> {
        w = w_doc(w, lk, Some(d), fd.lo)
        for l in doc_links(d) {
          match resolve_link(lk.sc, mods, l.text) {
            Ok(t) -> { out = out ++ ["${l.text} -> ${t.module}|${t.name}|${t.kind}"] }
            Err(_) -> ()
          }
        }
      }
      None -> ()
    }
  }
  if len(w.errs) > 0 { Err(w.errs) } else { Ok(out) }
}

test "a doc link resolves in its module's scope, to a declaration and its kind" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let text = join([
      "use std/list",
      "use std/str.{trim}",
      "use std/bytes.{Utf8Error as Bad}",
      "",
      "## [`list`] [`list.map`] [`trim`] [`Bad`] [`Bad.offset`] [`main.helper`] [`helper`]",
      "## [`Shape`] [`Circle`] [`Shape.Circle`] [`Shape.r`] [`LIMIT`]",
      "## [`Size`] [`Size.size`] [`size`] [`Ask`] [`ask`] [`Ask.ask`]",
      "## [`sort`] [`println`] [`Option`] [`Some`] [`Option.Some`] [`Ord`] [`Ord.cmp`] [`cmp`] [`Int`]",
      "pub fn helper(xs: List[Int]) -> List[Int] = if trim(\" \") == \"\" { list.take(xs, 1) } else { xs }",
      "",
      "pub type Shape = Circle(r: Float) | Dot",
      "",
      "pub const LIMIT: Int = 3",
      "",
      "pub trait Size[T] {",
      "  fn size(t: T) -> Int",
      "}",
      "",
      "pub effect Ask {",
      "  fn ask() -> Int",
      "}",
      "",
      "fn cut(c: Bad) -> Bad = c",
      ""
    ], "\n")
    let got = match probe_links(std, text) {
      Ok(ls) -> ls
      Err(es) -> panic(join(es, "\n"))
    }
    assert got == [
      "list -> std/list||module",
      "list.map -> std/list|map|fn",
      "trim -> std/str|trim|fn",
      "Bad -> std/bytes|Utf8Error|type",
      "Bad.offset -> std/bytes|Utf8Error.offset|field",
      "main.helper -> main|helper|fn",
      "helper -> main|helper|fn",
      "Shape -> main|Shape|type",
      "Circle -> main|Shape.Circle|ctor",
      "Shape.Circle -> main|Shape.Circle|ctor",
      "Shape.r -> main|Shape.r|field",
      "LIMIT -> main|LIMIT|const",
      "Size -> main|Size|trait",
      "Size.size -> main|Size.size|method",
      "size -> main|Size.size|method",
      "Ask -> main|Ask|effect",
      "ask -> main|Ask.ask|op",
      "Ask.ask -> main|Ask.ask|op",
      "sort -> |sort|fn",
      "println -> |println|fn",
      "Option -> |Option|type",
      "Some -> |Option.Some|ctor",
      "Option.Some -> |Option.Some|ctor",
      "Ord -> |Ord|trait",
      "Ord.cmp -> |Ord.cmp|method",
      "cmp -> |Ord.cmp|method",
      "Int -> |Int|type"
    ]
  }))
}

test "a doc link that resolves to nothing names its module, line and reason" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let text = join([
      "use std/list",
      "use std/str.{trim}",
      "",
      "## Fine: [`list.map`].",
      "## [`str.trim`] [`list.nope`] [`nope`]",
      "## [`a == b`] [`Shape.nope`] [`list.Cursor.at`] `[not a link]` [`x`](https://example.org)",
      "pub fn helper(xs: List[Int]) -> List[Int] = if trim(\" \") == \"\" { list.take(xs, 1) } else { xs }",
      "",
      "pub type Shape = Dot",
      ""
    ], "\n")
    assert probe_links(std, text) == Err([
      "main:5: doc link [`str.trim`] does not resolve: `str` is not a module this module imports",
      "main:5: doc link [`list.nope`] does not resolve: module `std/list` declares no `nope`",
      "main:5: doc link [`nope`] does not resolve: nothing in this module's scope is called `nope`",
      "main:6: doc link [`a == b`] does not resolve: it is not a name or a dotted path of names",
      "main:6: doc link [`Shape.nope`] does not resolve: type `Shape` has no constructor or field `nope` this module can see",
      "main:6: doc link [`list.Cursor.at`] does not resolve: module `std/list` declares no `Cursor`"
    ])
  }))
}

test "a link through a module alias sees only what that module exports" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    # std/str has private helpers; a caller cannot name them, so neither can a link
    let private = match get(filter(module_fns(std_module(std, "std/str")), f => f.vis != VisPub), 0) {
      Some(f) -> f.name
      None -> panic("std/str has no private function to probe with")
    }
    let text = "use std/str\n\n## [`str.${private}`]\npub fn f() -> Int = str.len(\"\")\n"
    assert probe_links(std, text) == Err([
      "main:3: doc link [`str.${private}`] does not resolve: module `std/str` does not export `${private}` to this module"
    ])
  }))
}

fn std_module(std: StdCtx, mp: String) -> Module = {
  for tr in std.srcs {
    let (p, _, m) = tr
    if p == mp { return m }
  }
  panic("no std module ${mp}")
}

test "a doc without links writes the bytes it wrote before links existed" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let text = "## Plain `code`, [brackets] and [a link](https://example.org).\npub fn f() -> Int = 1\n"
    let prog = analyze_standalone("<doc-test>", text, std, ct_default(), jsig_refused())
    let j = w_done(module_json(w_new(), prog.modules[0], lk_of(prog.modules[0], std_modules(std), doc_src_of(text)),
      module_examples(text, prog.modules[0].m)))
    assert not str.contains(j, "\"links\"")
  }))
}

test "a pub declaration's examples follow its doc, and nothing else gains a key" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let text = join([
      "## Adds one.",
      "pub fn inc(x: Int) -> Int = x + 1",
      "",
      "pub fn dec(x: Int) -> Int = x - 1",
      "",
      "fn helper() -> Int = 0",
      "",
      "pub type Shape = Circle(r: Int) | Dot",
      "",
      "test inc {",
      "  assert inc(1) == 2",
      "}",
      "",
      "test helper { assert helper() == 0 }",
      "test \"plain\" { assert dec(1) == 0 }",
      "test inc { assert inc(-1) == 0 }",
      "test Shape.Circle {",
      "  let c = Circle(2)",
      "  assert c != Dot",
      "}",
      ""
    ], "\n")
    let prog = analyze_standalone("<doc-test>", text, std, ct_default(), jsig_refused())
    assert len(prog.diags) == 0
    let j = w_done(module_json(w_new(), prog.modules[0], lk_of(prog.modules[0], std_modules(std), doc_src_of(text)),
      module_examples(text, prog.modules[0].m)))
    let inc = join([
      "      \"name\": \"inc\",",
      "      \"sig\": \"fn inc(x: Int) -> Int\",",
      "      \"doc\": \"Adds one.\",",
      "      \"examples\": [",
      "        \"assert inc(1) == 2\",",
      "        \"assert inc(-1) == 0\"",
      "      ]",
      "    },"
    ], "\n")
    assert str.contains(j, inc)
    # a declaration without an example is the bytes it always was
    assert str.contains(j, "      \"name\": \"dec\",\n      \"sig\": \"fn dec(x: Int) -> Int\",\n      \"doc\": null\n    }")
    # a constructor's example is on the constructor
    assert str.contains(j, "          \"doc\": null,\n          \"examples\": [\n            \"let c = Circle(2)\\nassert c != Dot\"\n          ]")
    # a private declaration's example is not published, and neither is a string test
    assert not str.contains(j, "helper")
    assert not str.contains(j, "dec(1)")
    assert len(str.split(j, "\"examples\"")) == 3
  }))
}

test "a project's doc carries its own modules, and a link into a dependency keeps its target" {
  # A table, not the disk: the project and its [deps] package are written
  # here and nowhere else (the analyze tests' `in_mem`, which is private to
  # that module).
  let (pair, _) = memfs.with_fs(fsmem.mem_std(memfs.BASE),
    () => io.with_proc_real(
      () => envmem.with_env_table(memfs.BASE, [("DAWN_PKG_CACHE", "${memfs.BASE}/pkg-cache")], () => {
        let base = "/tmp/dawn-selfhost-doc/own"
        let _ = io.mkdirs("${base}/lib/src")
        let _ = io.mkdirs("${base}/app/src/deep")
        let _ = io.write_file("${base}/lib/dawn.toml", "schema = 1\nname = \"lib\"\n")
        let _ = io.write_file("${base}/lib/src/text.dawn", "## A tag.\npub fn tag() -> String = \"w\"\n")
        let _ = io.write_file("${base}/app/dawn.toml", "schema = 1\nname = \"app\"\n\n[deps]\nl = \"../lib\"\n")
        let _ = io.write_file("${base}/app/src/deep/util.dawn", "## One.\npub fn one() -> Int = 1\n")
        let _ = io.write_file("${base}/app/src/main.dawn",
          "use l/text\nuse deep/util\n\n## Calls [`text.tag`].\npub fn f() -> String = text.tag()\n" ++
            "pub fn main() -> Unit !io = println(f() ++ to_string(util.one()))\n")
        let std = match load_std(fsmem.mem_std_dir(memfs.BASE)) {
          Ok(sc) -> sc
          Err(e) -> panic("std: ${std_load_error_text(e)}")
        }
        let loaded = load_directory("${base}/app")
        let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
        assert len(prog.diags) == 0
        # the dependency was loaded and checked: what is left out below is left
        # out by the doc, not by the load
        assert len(filter(prog.modules, cm => cm.mod_path == "lib/text")) == 1
        ok_json(project_json(prog, std, own_module_paths(loaded)))
      })))
  let (j, _) = pair
  assert str.contains(j, "\"path\": \"deep/util\"")
  assert str.contains(j, "\"path\": \"main\"")
  # the dependency's module is not published here: its docs are its own package's
  assert not str.contains(j, "\"path\": \"lib/text\"")
  assert not str.contains(j, "A tag.")
  # but a link into it still lands, and says where
  assert str.contains(j, "\"text\": \"text.tag\"")
  assert str.contains(j, "\"module\": \"lib/text\"")
  assert str.contains(j, "\"name\": \"tag\"")
}

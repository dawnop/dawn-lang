# checker.dawn: a call whose callee is an expression, not a name
#
# `(r.f)(...)` stopped being one of those in SYN-09. Parentheses do not change
# what a member reference is, so a call suffix on one is checked exactly like
# `r.f(...)` -- the two spellings are kept here side by side because the only
# way to see that they agree is to record both.
pub type Rec = { f: fn(Int) -> Int }

pub fn pick(r: Rec) -> fn(Int) -> Int = r.f

pub fn arity(r: Rec) -> Int = pick(r)(1, 2)

pub fn named(r: Rec) -> Int = pick(r)(a: 1)

pub fn member_arity(r: Rec) -> Int = (r.f)(1, 2)

pub fn member_named(r: Rec) -> Int = (r.f)(a: 1)

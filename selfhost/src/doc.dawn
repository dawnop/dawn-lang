# `selfhost doc` — a faithful port of dawn.cli.Doc: emit a project's pub API
# (with `##` doc comments) or the builtin reference as JSON on stdout, byte
# for byte what `dawn doc` prints. The JSON writer mirrors JsonWriter (pretty,
# 2-space indent, key and value on one line, deterministic).

use std/char
use std/str
use std/list
use std/map
use std/set
use std/io
use std/io.{Fs}
use front/lexer
use front/parser
use front/token.{Token}
use front/ast.{
  Module, module_fns, module_types, module_consts, module_traits, module_effects
}
use driver/analyze.{Program, CheckedMod}
use check/cx.{Cx, ModExports}
use driver/stdlib.{StdCtx, load_std, std_load_error_text}
use check/tast.{TModule}
use ir/interp.{CtOut}
use check/types.{
  Adts, Traits, AdtI, CtorI, ImplI, Sig, adt_of, trait_of, ty_show, sig_render,
  prelude_traits, prelude_trait_ids, builtins, internal_builtins,
  documented_builtin_types, builtin_type_use, internal_std_modules
}

# ---- the JSON writer (JsonWriter, as a threaded record) ----

type W = { parts: List[String], indent: Int, need_comma: Bool, trailing_key: Bool }

fn w_new() -> W = W { parts: [], indent: 0, need_comma: false, trailing_key: false }

fn pad(w: W) -> W = W { ..w, parts: w.parts ++ [str.repeat("  ", w.indent)] }

fn pre_value(w: W) -> W =
  if w.trailing_key {
    W { ..w, parts: w.parts ++ [" "], trailing_key: false, need_comma: false }
  } else {
    let w1 = W { ..w, parts: w.parts ++ [if w.need_comma { ",\n" } else { "\n" }] }
    let w2 = pad(w1)
    W { ..w2, need_comma: false }
  }

fn open_obj(w: W) -> W = {
  let w1 = pre_value(w)
  W { ..w1, parts: w1.parts ++ ["{"], indent: w1.indent + 1, need_comma: false }
}

fn close_obj(w: W) -> W = {
  let w1 = pad(W { ..w, indent: w.indent - 1, parts: w.parts ++ ["\n"] })
  W { ..w1, parts: w1.parts ++ ["}"], need_comma: true }
}

fn open_arr(w: W) -> W = {
  let w1 = pre_value(w)
  W { ..w1, parts: w1.parts ++ ["["], indent: w1.indent + 1, need_comma: false }
}

## `any` = whether the array got at least one element (decides the closing
## bracket's own line, as JsonWriter does).
fn close_arr(w: W, any: Bool) -> W = {
  let w1 = W { ..w, indent: w.indent - 1 }
  let w2 = if any { pad(W { ..w1, parts: w1.parts ++ ["\n"] }) } else { w1 }
  W { ..w2, parts: w2.parts ++ ["]"], need_comma: true }
}

fn w_key(w: W, k: String) -> W = {
  let w1 = pad(W { ..w, parts: w.parts ++ [if w.need_comma { ",\n" } else { "\n" }] })
  W { ..w1, parts: w1.parts ++ [quote(k) ++ ":"], need_comma: false, trailing_key: true }
}

fn w_str(w: W, s: String) -> W = {
  let w1 = pre_value(w)
  W { ..w1, parts: w1.parts ++ [quote(s)], need_comma: true }
}

fn w_bool(w: W, b: Bool) -> W = {
  let w1 = pre_value(w)
  W { ..w1, parts: w1.parts ++ [if b { "true" } else { "false" }], need_comma: true }
}

fn w_field(w: W, k: String, v: String) -> W = w_str(w_key(w, k), v)

fn w_field_bool(w: W, k: String, v: Bool) -> W = w_bool(w_key(w, k), v)

fn w_field_opt(w: W, k: String, v: Option[String]) -> W = {
  let w1 = w_key(w, k)
  match v {
    Some(s) -> w_str(w1, s)
    None -> {
      let w2 = pre_value(w1)
      W { ..w2, parts: w2.parts ++ ["null"], need_comma: true }
    }
  }
}

fn w_done(w: W) -> String = {
  var s = join(w.parts, "")
  while str.starts_with(s, "\n") { s = str.drop(s, 1) }
  s ++ "\n"
}

fn hex_digit(n: Int) -> String = str.slice("0123456789abcdef", n, n + 1)

fn quote(s: String) -> String = {
  var out: List[String] = ["\""]
  for c in code_points(s) {
    if c == '"' {
      out = out ++ ["\\\""]
    } else if c == '\\' {
      out = out ++ ["\\\\"]
    } else if c == '\n' {
      out = out ++ ["\\n"]
    } else if c == '\r' {
      out = out ++ ["\\r"]
    } else if c == '\t' {
      out = out ++ ["\\t"]
    } else if c < ' ' {
      let n = char.code(c)
      out = out ++ ["\\u00" ++ hex_digit(n / 16) ++ hex_digit(n % 16)]
    } else {
      out = out ++ [from_code_points([c])]
    }
  }
  join(out, "") ++ "\""
}

# ---- doc comment extraction (Doc.kt docOf / commentsByLine) ----

## 1-based line number of code-point offset `off` (count of line starts <= off).
fn line_of(starts: List[Int], off: Int) -> Int = {
  var n = 0
  var i = 0
  while i < len(starts) && starts[i] <= off {
    n = n + 1
    i = i + 1
  }
  n
}

type DocSrc = { starts: List[Int], by_line: Map[Int, Token] }

fn doc_src_of(text: String) -> DocSrc = {
  let (_, comments, _) = lexer.lex_with_comments(text)
  let starts = lexer.line_starts_of(text)
  var by_line: Map[Int, Token] = map.empty()
  for c in comments { by_line = map.insert(by_line, line_of(starts, c.hi), c) }
  DocSrc { starts: starts, by_line: by_line }
}

fn strip_doc_prefix(s: String) -> String = {
  let t = str.drop(s, 2)
  str.strip_prefix(t, " ").unwrap_or(t)
}

## The `##` lines immediately above the declaration starting at `lo`,
## contiguous, joined by \n. A blank line detaches; plain `#` is never a doc.
fn doc_of(ds: DocSrc, lo: Int) -> Option[String] = {
  var line = line_of(ds.starts, lo) - 1
  var acc: List[String] = []
  var go = true
  while go {
    match map.get(ds.by_line, line) {
      Some(t) ->
        if str.starts_with(t.text, "##") {
          acc = acc ++ [strip_doc_prefix(t.text)]
          line = line - 1
        } else {
          go = false
        }
      None -> { go = false }
    }
  }
  if len(acc) == 0 { None } else { Some(join(list.reverse(acc), "\n")) }
}

## The 1-based line every declaration starts on.
fn decl_lines(m: Module, starts: List[Int]) -> List[Int] = {
  var out: List[Int] = []
  for fd in module_fns(m) { out = out ++ [line_of(starts, fd.lo)] }
  for td in module_types(m) { out = out ++ [line_of(starts, td.lo)] }
  for cd in module_consts(m) { out = out ++ [line_of(starts, cd.lo)] }
  for td in module_traits(m) { out = out ++ [line_of(starts, td.lo)] }
  for ed in module_effects(m) { out = out ++ [line_of(starts, ed.lo)] }
  out
}

## The module's own doc: the `##` block that opens the file. It is the one doc
## comment `doc_of` cannot reach — that one reads upward from a declaration,
## and a module has no `lo` to read up from.
##
## The block belongs to the module only if nothing is declared on the line
## right after it. A file that opens with a documented declaration
## (`## Answer questions.` then `pub effect Ask`) has a first-declaration doc,
## not a module doc, and the two must not be the same comment read twice.
fn module_doc_of(ds: DocSrc, m: Module) -> Option[String] = {
  var line = 1
  var acc: List[String] = []
  var go = true
  while go {
    match map.get(ds.by_line, line) {
      Some(t) ->
        if str.starts_with(t.text, "##") {
          acc = acc ++ [strip_doc_prefix(t.text)]
          line = line + 1
        } else {
          go = false
        }
      None -> { go = false }
    }
  }
  if len(acc) == 0 || list.contains(decl_lines(m, ds.starts), line) {
    None
  } else {
    Some(join(acc, "\n"))
  }
}

# ---- project JSON ----

fn adt_by_name(adts: Adts, owner: String, name: String) -> Option[AdtI] = {
  for aid in sort(map.keys(adts)) {
    let a = adt_of(adts, aid)
    let own = match a.owner {
      Some(o) -> o == owner
      None -> false
    }
    if own && a.name == name { return Some(a) }
  }
  None
}

fn trait_methods_json(w: W, cx: Cx, owner: String, name: String) -> W = {
  var w1 = w_key(w, "methods")
  w1 = open_arr(w1)
  var any = false
  for tid in sort(map.keys(cx.traits)) {
    let t = trait_of(cx.traits, tid)
    let own = match t.owner {
      Some(o) -> o == owner
      None -> false
    }
    if own && t.name == name {
      for pr in t.methods {
        let (mname, ms) = pr
        any = true
        w1 = open_obj(w1)
        w1 = w_field(w1, "name", mname)
        w1 = w_field(w1, "sig", sig_render(cx.adts, cx.traits, ms.sig))
        w1 = w_field_bool(w1, "hasDefault", ms.has_default)
        w1 = close_obj(w1)
      }
    }
  }
  close_arr(w1, any)
}

fn module_json(w: W, cm: CheckedMod, ds: DocSrc) -> W = {
  var w1 = open_obj(w)
  w1 = w_field(w1, "path", cm.mod_path)
  # written only when the module has one, so a project of files that open with
  # a plain `#` header emits exactly the bytes it did before module docs existed
  match module_doc_of(ds, cm.m) {
    Some(d) -> { w1 = w_field(w1, "doc", d) }
    None -> ()
  }
  w1 = w_key(w1, "fns")
  w1 = open_arr(w1)
  var any = false
  for fd in module_fns(cm.m) {
    if fd.is_pub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", fd.name)
      let sig = match map.get(cm.cx.fns, fd.name) {
        Some(s) -> sig_render(cm.cx.adts, cm.cx.traits, s)
        None -> fd.name
      }
      w1 = w_field(w1, "sig", sig)
      w1 = w_field_opt(w1, "doc", doc_of(ds, fd.lo))
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "types")
  w1 = open_arr(w1)
  any = false
  for td in module_types(cm.m) {
    if td.is_pub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", td.name)
      w1 = w_field_bool(w1, "record", td.is_record)
      w1 = w_key(w1, "typeParams")
      w1 = open_arr(w1)
      for tp in td.tparams { w1 = w_str(w1, tp) }
      w1 = close_arr(w1, len(td.tparams) > 0)
      w1 = w_key(w1, "ctors")
      w1 = open_arr(w1)
      var cany = false
      match adt_by_name(cm.cx.adts, cm.class_name, td.name) {
        Some(a) -> {
          for c in a.ctors {
            cany = true
            w1 = open_obj(w1)
            w1 = w_field(w1, "name", c.name)
            w1 = w_key(w1, "fields")
            w1 = open_arr(w1)
            for f in c.fields {
              w1 = open_obj(w1)
              w1 = w_field(w1, "name", f.name)
              w1 = w_field(w1, "type", ty_show(cm.cx.adts, f.ty))
              w1 = close_obj(w1)
            }
            w1 = close_arr(w1, len(c.fields) > 0)
            w1 = close_obj(w1)
          }
        }
        None -> ()
      }
      w1 = close_arr(w1, cany)
      w1 = w_field_opt(w1, "doc", doc_of(ds, td.lo))
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "consts")
  w1 = open_arr(w1)
  any = false
  for cd in module_consts(cm.m) {
    if cd.is_pub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", cd.name)
      let ty = match map.get(cm.cx.consts, cd.name) {
        Some(t) -> ty_show(cm.cx.adts, t)
        None -> ""
      }
      w1 = w_field(w1, "type", ty)
      w1 = w_field_opt(w1, "doc", doc_of(ds, cd.lo))
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "traits")
  w1 = open_arr(w1)
  any = false
  for td in module_traits(cm.m) {
    if td.is_pub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", td.name)
      w1 = w_field(w1, "typeParam", td.tp)
      w1 = w_key(w1, "assoc")
      w1 = open_arr(w1)
      for ad in td.assoc {
        w1 = open_obj(w1)
        w1 = w_field(w1, "name", ad.name)
        w1 = w_field_opt(w1, "doc", doc_of(ds, ad.lo))
        w1 = close_obj(w1)
      }
      w1 = close_arr(w1, len(td.assoc) > 0)
      # associated effects, beside the associated types (决策 9). The key is
      # written only when the trait declares one, so every effect-free
      # trait's doc output is byte-identical to what it was.
      if len(td.eff_assoc) > 0 {
        w1 = w_key(w1, "effectAssoc")
        w1 = open_arr(w1)
        for ad in td.eff_assoc {
          w1 = open_obj(w1)
          w1 = w_field(w1, "name", ad.name)
          # the default row (#369), written only when the member has one, so
          # a defaultless member's doc output is byte-identical to before
          match ad.default {
            Some(atoms) -> {
              w1 = w_field(w1, "default",
                if len(atoms) == 0 { "!()" } else { "!" ++ atoms[0] })
            }
            None -> ()
          }
          w1 = w_field_opt(w1, "doc", doc_of(ds, ad.lo))
          w1 = close_obj(w1)
        }
        w1 = close_arr(w1, true)
      }
      w1 = trait_methods_json(w1, cm.cx, cm.class_name, td.name)
      w1 = w_field_opt(w1, "doc", doc_of(ds, td.lo))
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "effects")
  w1 = open_arr(w1)
  any = false
  for ed in module_effects(cm.m) {
    if ed.is_pub {
      any = true
      w1 = open_obj(w1)
      w1 = w_field(w1, "name", ed.name)
      w1 = w_key(w1, "ops")
      w1 = open_arr(w1)
      for op in ed.ops {
        w1 = open_obj(w1)
        w1 = w_field(w1, "name", op.name)
        # an operation's sig lands in cx.fns under its own name (pass_effects),
        # rendered with its `!Effect` row; the bare name is the same graceful
        # fallback the fns loop uses for a signature the checker refused
        let sig = match map.get(cm.cx.fns, op.name) {
          Some(s) -> sig_render(cm.cx.adts, cm.cx.traits, s)
          None -> op.name
        }
        w1 = w_field(w1, "sig", sig)
        w1 = w_field_opt(w1, "doc", doc_of(ds, op.lo))
        w1 = close_obj(w1)
      }
      w1 = close_arr(w1, len(ed.ops) > 0)
      w1 = w_field_opt(w1, "doc", doc_of(ds, ed.lo))
      w1 = close_obj(w1)
    }
  }
  w1 = close_arr(w1, any)
  w1 = w_key(w1, "impls")
  w1 = open_arr(w1)
  # the impls the checker decided this module publishes, not the ones it has
  # (docs/public-surface-design.md §7.1): an impl of a private trait, or for a
  # private type, is not part of any API a reader of this page can use, and
  # deciding that here would be a second copy of a rule the checker already
  # applied.
  let impls = cm.cx.observable_impls
  for ii in impls {
    let t = trait_of(cm.cx.traits, ii.trait_id)
    w1 = w_str(w1, t.name ++ "[" ++ ty_show(cm.cx.adts, ii.subject) ++ "]")
  }
  w1 = close_arr(w1, len(impls) > 0)
  close_obj(w1)
}

pub fn project_json(prog: Program) -> String !Fs = {
  var w = w_new()
  w = open_obj(w)
  w = w_key(w, "modules")
  w = open_arr(w)
  for cm in prog.modules {
    let text = match io.read_file(cm.path) {
      Ok(t) -> t
      Err(e) -> panic("cannot re-read " ++ cm.path ++ ": " ++ e.message)
    }
    w = module_json(w, cm, doc_src_of(text))
  }
  w = close_arr(w, len(prog.modules) > 0)
  w = close_obj(w)
  w_done(w)
}

# ---- builtin reference (Doc.kt BUILTIN_GROUPS, verbatim) ----
#
# The group names are a table of contents for a reader, not a claim about
# effect rows. Three of the four names under "io" below raise no `io` at all --
# `bracket` never did, `catch_fault` stopped on 2026-09-01
# (docs/audit/error-model-design.md §7.5) -- and they belong here because that
# is where somebody looking for "the failure primitives" looks. The rows are in
# the rendered signatures right beside these lines.

fn builtin_groups() -> List[(String, List[(String, String)])] = [
  ("io", [
    ("println", "print a string followed by a newline"),
    ("print", "print a string without a newline"),
    ("args", "command line arguments"),
    ("catch_fault", "run a closure, turning an external failure into Err (panics pass through)"),
    ("catch_panic", "run a closure at an isolation boundary, catching a panic or an exception into Err"),
    ("bracket",
      "use an acquired resource and release it on every way out -- the value, a panic or a fault; the failure carries on unchanged (this catches nothing)")
  ]),
  ("list", [
    ("map", "a new list with a function applied to every element"),
    ("filter", "the elements satisfying a predicate, in order"),
    ("fold", "reduce from the left with an accumulator"),
    ("len", "number of elements"),
    ("get", "element at an index; None when out of bounds"),
    ("range", "the integers from..to (exclusive)"),
    ("sort", "ascending stable sort (elements need Ord)"),
    ("sort_by", "stable sort with a two-argument cmp function"),
    ("max", "the first greatest element; None when empty (elements need Ord)"),
    ("min", "the first least element; None when empty (elements need Ord)"),
    ("max_by", "the first element whose key is greatest; None when empty (keys need Ord)"),
    ("min_by", "the first element whose key is least; None when empty (keys need Ord)")
  ]),
  ("string", [
    ("to_string", "render any printable value (numbers, strings, derive Show data)"),
    ("join", "concatenate with a separator"),
    ("parse_int", "parse a decimal integer; None on malformed input"),
    ("parse_float", "parse a floating point number; None on malformed input"),
    ("parse_int_radix", "parse an integer in base 2 through 36; None on malformed input")
  ]),
  ("interop", [
    ("cast",
      "reclaim an erased Java Object as a concrete reference type T, taken from the expected type at the call site (interop escape; a runtime CHECKCAST guards it, and a miss is an Err rather than a throw)")
  ]),
  ("char", [
    ("code_points", "split a string into Unicode scalar-value characters"),
    ("from_code_points", "assemble a string from characters"),
    ("char_is_letter", "whether a character is a Unicode letter"),
    ("char_is_digit", "whether a character is a decimal digit"),
    ("char_is_alnum", "whether a character is a letter or decimal digit"),
    ("char_is_upper", "whether a character is upper-case"),
    ("char_is_lower", "whether a character is lower-case"),
    ("char_is_space", "whether a character is whitespace")
  ]),
  ("option", [
    ("expect", "unwrap a Some or panic with a message"),
    ("unwrap_or", "the Some value, or a fallback for None")
  ]),
  ("conversion", [
    ("to_float", "Int to Float"),
    ("to_int", "Float to Int (truncates)")
  ]),
  ("control", [
    ("panic", "abort with a message (diverges, so usable at any type)"),
    ("todo", "placeholder that panics when reached"),
    ("discard",
      "abandon the computation a continuation would have resumed, running every bracket release inside it; the ticket is spent, so resuming afterwards panics")
  ])
]

## The hand-written reference is intentionally prose, but its membership is a
## contract: every public compiler builtin appears exactly once, and every
## documented name resolves either there or in the prelude migrated to std.
fn validate_builtin_groups(std: StdCtx) -> Unit = {
  let bi = builtins()
  let hidden = internal_builtins()
  var seen: Set[String] = set.empty()
  for grp in builtin_groups() {
    let (_, fns) = grp
    for pr in fns {
      let (name, _) = pr
      if set.has(seen, name) {
        panic("the builtin reference names a function twice: " ++ name)
      }
      seen = set.insert(seen, name)
      if not map.has(bi, name) && not map.has(std.std_fns, name) {
        panic("the builtin reference names an unknown function: " ++ name)
      }
    }
  }
  for name in map.keys(bi) {
    if not set.has(hidden, name) && not set.has(seen, name) {
      panic("the builtin reference omits a public function: " ++ name)
    }
  }
  for name in map.keys(std.std_fns) {
    if not set.has(seen, name) {
      panic("the builtin reference omits a public function: " ++ name)
    }
  }
}

fn builtin_types_json(w0: W) -> W = {
  var w = w0
  for info in documented_builtin_types() {
    w = open_obj(w)
    w = w_field(w, "name", info.name)
    w = w_key(w, "params")
    w = open_arr(w)
    for param in info.params { w = w_str(w, param) }
    w = close_arr(w, len(info.params) > 0)
    w = w_field(w, "use", builtin_type_use(info))
    w = close_obj(w)
  }
  w
}

## The std-only builtins: `types.internal_builtins()`, which is every entry of
## the table the checker hides from a module outside `std`.
##
## They are a key of their own rather than a group, and carry no prose. A group
## is a section of a hand-written reference for people writing Dawn, and none of
## these is something to write -- `std/map`, `std/bytes` and `std/io` are the
## spellings, and `validate_builtin_groups` next door exists to keep the
## reference free of names nobody may call. What a consumer of this JSON wants
## them for is the opposite question: the playground's completion table and the
## editor tooling read `groups`, while a reader auditing the language surface
## wants to see the whole table, and until this key existed the only way to see
## it was the compiler's source.
##
## Sorted by name, because `map.keys` answers in the trie's order and a
## reference whose order moves when a name is added is a reference nothing can
## diff.
fn internal_builtins_json(w0: W, adts: Adts, traits: Traits) -> W = {
  let bi = builtins()
  let hidden = internal_builtins()
  var names: List[String] = []
  for name in list.sort(map.keys(bi)) {
    if set.has(hidden, name) { names = names ++ [name] }
  }
  var w = w0
  for name in names {
    let sig = match map.get(bi, name) {
      Some(s) -> s
      None -> panic("internal builtin without a signature: " ++ name)
    }
    w = open_obj(w)
    w = w_field(w, "name", name)
    w = w_field(w, "sig", sig_render(adts, traits, sig))
    w = close_obj(w)
  }
  w
}

## The hand-written groups, resolved against the builtin table (falling back to
## the std prelude, where functions migrate). Shared by both output modes so
## the two references cannot drift into two answers.
fn builtin_groups_json(w0: W, std: StdCtx, traits: Traits) -> W = {
  validate_builtin_groups(std)
  let bi = builtins()
  var w = w0
  for grp in builtin_groups() {
    let (gname, fns) = grp
    w = open_obj(w)
    w = w_field(w, "name", gname)
    w = w_key(w, "fns")
    w = open_arr(w)
    for pr in fns {
      let (fname, fdoc) = pr
      let sig = match map.get(bi, fname) {
        Some(s) -> s
        None ->
          match map.get(std.std_fns, fname) {
            Some(s) -> s
            None -> panic("the builtin reference names an unknown function: " ++ fname)
          }
      }
      w = open_obj(w)
      w = w_field(w, "name", fname)
      w = w_field(w, "sig", sig_render(std.adts, traits, sig))
      w = w_field(w, "doc", fdoc)
      w = close_obj(w)
    }
    w = close_arr(w, len(fns) > 0)
    w = close_obj(w)
  }
  w
}

pub fn builtins_json(std: StdCtx) -> String = {
  let traits = prelude_traits()
  var w = w_new()
  w = open_obj(w)
  w = w_key(w, "types")
  w = open_arr(w)
  w = builtin_types_json(w)
  w = close_arr(w, true)
  w = w_key(w, "groups")
  w = open_arr(w)
  w = builtin_groups_json(w, std, traits)
  for i in range(0, len(std.srcs)) {
    let (mod_path, text, m) = std.srcs[i]
    let (mp, cx, _tm, _ct) = std.mods[i]
    # the two lists are filled in the same loop, in the same order (see
    # stdlib_json); if that ever stops being true the reference would render
    # one module's signatures against another's tables
    if mp != mod_path { panic("std module lists out of step: " ++ mp ++ " vs " ++ mod_path) }
    # a signature may name a trait std itself declares (std/gpu's `Dtype`),
    # which the prelude table cannot resolve; the module's own table carries
    # both, and resolves the prelude's ids identically
    let mtraits = cx.traits
    # std/hamt and std/pvec are Map/Set/List's representation, and `use` on
    # either is a compile error outside std (spec §10.6). A reference that
    # lists them teaches an API nobody may write, so they stay out of it.
    if list.contains(internal_std_modules(), mod_path) { continue }
    let ds = doc_src_of(text)
    let exp = match map.get(std.exports, mod_path) {
      Some(e) -> e
      None -> panic("std module without exports: " ++ mod_path)
    }
    w = open_obj(w)
    w = w_field(w, "name", mod_path)
    w = w_key(w, "fns")
    w = open_arr(w)
    var any = false
    for fd in module_fns(m) {
      if fd.is_pub {
        any = true
        let sig = match map.get(exp.fns, fd.name) {
          Some(s) -> s
          None -> panic("std export without a signature: " ++ fd.name)
        }
        w = open_obj(w)
        w = w_field(w, "name", fd.name)
        w = w_field(w, "sig", sig_render(std.adts, mtraits, sig))
        w = w_field(w, "doc", unwrap_or(doc_of(ds, fd.lo), ""))
        w = close_obj(w)
      }
    }
    w = close_arr(w, any)
    # empty for every std module today; here so the first pub effect std
    # mints appears in the reference instead of silently missing (#115)
    w = w_key(w, "effects")
    w = open_arr(w)
    any = false
    for ed in module_effects(m) {
      if ed.is_pub {
        any = true
        w = open_obj(w)
        w = w_field(w, "name", ed.name)
        w = w_key(w, "ops")
        w = open_arr(w)
        for op in ed.ops {
          let sig = match map.get(exp.fns, op.name) {
            Some(s) -> s
            None -> panic("std effect operation without a signature: " ++ op.name)
          }
          w = open_obj(w)
          w = w_field(w, "name", op.name)
          w = w_field(w, "sig", sig_render(std.adts, mtraits, sig))
          w = w_field(w, "doc", unwrap_or(doc_of(ds, op.lo), ""))
          w = close_obj(w)
        }
        w = close_arr(w, len(ed.ops) > 0)
        w = w_field(w, "doc", unwrap_or(doc_of(ds, ed.lo), ""))
        w = close_obj(w)
      }
    }
    w = close_arr(w, any)
    w = close_obj(w)
  }
  w = close_arr(w, true)
  w = w_key(w, "internal")
  w = open_arr(w)
  w = internal_builtins_json(w, std.adts, traits)
  w = close_arr(w, true)
  w = close_obj(w)
  w_done(w)
}

# ---- the standard library reference (`--stdlib`) ----

## The prelude traits carry no doc comments: they are a Dawn literal in
## types.dawn, not a declaration in any module, so there is nowhere to write
## one. The prose lives here, next to the hand-written builtin groups, for the
## same reason theirs does.
fn prelude_trait_docs() -> List[(String, String)] = [
  ("Ord",
    "total order. `cmp(a, b)` answers negative / zero / positive, and is what `<` `<=` `>` `>=` mean past the scalars; `sort` and the extremes ask for it"),
  ("Eq", "equality, behind `==` and `!=`"),
  ("Hash",
    "a value's hash, asked for alongside `Eq` by `Map` keys and `Set` elements (`[K: Eq + Hash]`)"),
  ("Show", "how `to_string` and string interpolation render a value"),
  ("Iter",
    "what `for x in c` walks: a cursor type, an item type, and the four moves over them"),
  ("Index",
    "what `c[i]` resolves to: an index type, an item type, and one method. `List` and `Map` come with an impl; a type that writes one gets `[]`"),
  ("Display",
    "the top-level rendering: an impl decides what `to_string` and string interpolation produce for the type, in place of the `Show` they would otherwise fall back on. Not derivable, and `Show` is still the bound `to_string` asks for")
]

fn prelude_trait_doc(name: String) -> String = {
  for pr in prelude_trait_docs() {
    let (n, d) = pr
    if n == name { return d }
  }
  panic("a prelude trait has no prose here: " ++ name)
}

fn prelude_traits_json(w0: W, adts: Adts, traits: Traits) -> W = {
  var w = w0
  for tid in prelude_trait_ids() {
    let t = trait_of(traits, tid)
    w = open_obj(w)
    w = w_field(w, "name", t.name)
    w = w_field(w, "typeParam", ty_show(adts, t.tvar))
    w = w_key(w, "assoc")
    w = open_arr(w)
    for a in t.assoc { w = w_str(w, a) }
    w = close_arr(w, len(t.assoc) > 0)
    w = w_key(w, "methods")
    w = open_arr(w)
    for pr in t.methods {
      let (mname, ms) = pr
      w = open_obj(w)
      w = w_field(w, "name", mname)
      w = w_field(w, "sig", sig_render(adts, traits, ms.sig))
      w = w_field_bool(w, "hasDefault", ms.has_default)
      w = close_obj(w)
    }
    w = close_arr(w, len(t.methods) > 0)
    w = w_field(w, "doc", prelude_trait_doc(t.name))
    w = close_obj(w)
  }
  w
}

## std is checked by `load_std` with `cx_new(Some(mod_path), None)`, so a std
## ADT or trait carries its module path as its owner — which is exactly what
## `module_json` matches `class_name` against. `path` is unused here: the
## source text is already in hand, so nothing re-reads the file.
fn std_checked_mod(mp: String, cx: Cx, tm: TModule, ct: CtOut, m: Module) -> CheckedMod =
  CheckedMod { mod_path: mp, class_name: mp, path: "", m: m, cx: cx, tm: tm, ct: ct }

## The full standard library reference: the prelude's own names, the prelude
## traits, and every user-visible std module with its types, traits, consts and
## impls — not just its functions, which is all `--builtins` could ever show.
##
## The split into `groups` and `modules` is where a name is *implemented*, and
## the published page deliberately does not organise itself that way: a reader
## wants `sort` under lists, not under "builtin". What the split does carry is
## how a name is *written* — `groups` are visible with no `use`, `modules` are
## qualified — and that is a difference the reader has to know.
pub fn stdlib_json(std: StdCtx) -> String = {
  let traits = prelude_traits()
  var w = w_new()
  w = open_obj(w)
  w = w_key(w, "groups")
  w = open_arr(w)
  w = builtin_groups_json(w, std, traits)
  w = close_arr(w, true)
  w = w_key(w, "traits")
  w = open_arr(w)
  w = prelude_traits_json(w, std.adts, traits)
  w = close_arr(w, true)
  w = w_key(w, "modules")
  w = open_arr(w)
  var any = false
  for i in range(0, len(std.mods)) {
    let (mp, cx, tm, ct) = std.mods[i]
    let (sp, text, m) = std.srcs[i]
    # the two lists are filled in the same loop, in the same order; if that
    # ever stops being true the reference would silently describe one module
    # with another's source
    if mp != sp { panic("std module lists out of step: " ++ mp ++ " vs " ++ sp) }
    if list.contains(internal_std_modules(), mp) { continue }
    any = true
    w = module_json(w, std_checked_mod(mp, cx, tm, ct, m), doc_src_of(text))
  }
  w = close_arr(w, any)
  w = close_obj(w)
  w_done(w)
}

test "the reference leaves out the representation modules" {
  io.with_fs_real(() => io.with_env_real(() => {
    # std/hamt and std/pvec used to get a section each, and a reader who
    # followed one got `use std/hamt` -- a compile error outside std. The
    # published reference is the API a program may write, so the filter is
    # the same list the checker refuses `use` against.
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: " ++ std_load_error_text(e))
    }
    let j = builtins_json(std)
    for internal in internal_std_modules() {
      assert not str.contains(j, quote(internal))
    }
    # the modules that stayed are still there
    assert str.contains(j, quote("std/map"))
    assert str.contains(j, quote("std/str"))
  }))
}

test "the standard library reference carries what --builtins cannot" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: " ++ std_load_error_text(e))
    }
    let j = stdlib_json(std)
    # the prelude's own names, unqualified
    assert str.contains(j, quote("catch_fault"))
    # the prelude traits and their methods, which live in no module at all
    assert str.contains(j, quote("Iter"))
    assert str.contains(j, quote("iter_start"))
    # a std module's types and impls -- the two `--builtins` has no room for
    assert str.contains(j, quote("Cursor"))
    assert str.contains(j, quote("Ord[Cursor]"))
    # every user-visible module documents itself
    for sm in std.srcs {
      let (mp, text, m) = sm
      if list.contains(internal_std_modules(), mp) { continue }
      assert str.contains(j, quote(mp))
      if module_doc_of(doc_src_of(text), m) == None {
        println("std module without a doc comment: " ++ mp)
        assert false
      }
    }
    # and the representation modules stay out of this one too
    for internal in internal_std_modules() {
      assert not str.contains(j, quote(internal))
    }
  }))
}

test "a documented first declaration is not also the module's doc" {
  # the two readings collide on line 1: `doc_of` reads upward from the
  # declaration and `module_doc_of` reads downward from the top of the file,
  # and without the declaration check they would both claim this comment.
  let attached = "## Answer questions from ambient context.\n" ++
    "pub effect Ask {\n  fn ask(prompt: String) -> Int\n}\n"
  let (m1, d1) = parser.parse_module(attached)
  assert len(d1) == 0
  assert module_doc_of(doc_src_of(attached), m1) == None

  # detached by a blank line, the same comment is the module's
  let detached = "## What this module is for.\n\n" ++
    "pub effect Ask {\n  fn ask(prompt: String) -> Int\n}\n"
  let (m2, d2) = parser.parse_module(detached)
  assert len(d2) == 0
  assert module_doc_of(doc_src_of(detached), m2) == Some("What this module is for.")
}

# expect: a handler's state cell must declare its type
# expect: a trailing closure must use a tail block
# expect: allowed at module top level
# The annotation is mandatory: nothing inside a handler's braces supplies an
# expected type for inference to start from, unlike the `let` in a block whose
# initializer is checked against the binding's use.
effect Ask {
  fn ask() -> Int
}

fn f() -> Int = {
  with handle Ask {
    var n = 0
    ask() => 1
  }
  ask()
}

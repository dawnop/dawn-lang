pub fn main() -> Unit !io = {
  var bad = 0
  bad = bad + check1("bf16 round ties", x => narrow.round_bf16(x), bf16_ties())
  bad = bad + check1("bf16 round subnormal", x => narrow.round_bf16(x), bf16_subnormal())
  bad = bad + check1("bf16 round overflow", x => narrow.round_bf16(x), bf16_overflow())
  bad = bad + check1("bf16 round random", x => narrow.round_bf16(x), bf16_random())
  bad = bad + check2("bf16 add", (a, b) => narrow.to_f64(narrow.add(narrow.bf16(a), narrow.bf16(b))), bf16_add())
  bad = bad + check2("bf16 sub", (a, b) => narrow.to_f64(narrow.sub(narrow.bf16(a), narrow.bf16(b))), bf16_sub())
  bad = bad + check2("bf16 mul", (a, b) => narrow.to_f64(narrow.mul(narrow.bf16(a), narrow.bf16(b))), bf16_mul())
  bad = bad + check2("bf16 div", (a, b) => narrow.to_f64(narrow.div(narrow.bf16(a), narrow.bf16(b))), bf16_div())
  bad = bad + check1("bf16 sqrt", a => narrow.to_f64(narrow.sqrt(narrow.bf16(a))), bf16_sqrt())
  bad = bad + check1("fp16 round ties", x => narrow.round_fp16(x), fp16_ties())
  bad = bad + check1("fp16 round subnormal", x => narrow.round_fp16(x), fp16_subnormal())
  bad = bad + check1("fp16 round overflow", x => narrow.round_fp16(x), fp16_overflow())
  bad = bad + check1("fp16 round random", x => narrow.round_fp16(x), fp16_random())
  bad = bad + check2("fp16 add", (a, b) => narrow.to_f64(narrow.add(narrow.fp16(a), narrow.fp16(b))), fp16_add())
  bad = bad + check2("fp16 sub", (a, b) => narrow.to_f64(narrow.sub(narrow.fp16(a), narrow.fp16(b))), fp16_sub())
  bad = bad + check2("fp16 mul", (a, b) => narrow.to_f64(narrow.mul(narrow.fp16(a), narrow.fp16(b))), fp16_mul())
  bad = bad + check2("fp16 div", (a, b) => narrow.to_f64(narrow.div(narrow.fp16(a), narrow.fp16(b))), fp16_div())
  bad = bad + check1("fp16 sqrt", a => narrow.to_f64(narrow.sqrt(narrow.fp16(a))), fp16_sqrt())
  bad = bad + check1("f32 round ties", x => narrow.round_f32(x), f32_ties())
  bad = bad + check1("f32 round subnormal", x => narrow.round_f32(x), f32_subnormal())
  bad = bad + check1("f32 round overflow", x => narrow.round_f32(x), f32_overflow())
  bad = bad + check1("f32 round random", x => narrow.round_f32(x), f32_random())
  bad = bad + check2("f32 add", (a, b) => narrow.to_f64(narrow.add(narrow.f32(a), narrow.f32(b))), f32_add())
  bad = bad + check2("f32 sub", (a, b) => narrow.to_f64(narrow.sub(narrow.f32(a), narrow.f32(b))), f32_sub())
  bad = bad + check2("f32 mul", (a, b) => narrow.to_f64(narrow.mul(narrow.f32(a), narrow.f32(b))), f32_mul())
  bad = bad + check2("f32 div", (a, b) => narrow.to_f64(narrow.div(narrow.f32(a), narrow.f32(b))), f32_div())
  bad = bad + check1("f32 sqrt", a => narrow.to_f64(narrow.sqrt(narrow.f32(a))), f32_sqrt())
  println("total: ${bad} bad")
}

# The native side of the web exchange contract: the application of
# contract_app served through web/exchange over stdin and stdout, one request
# per process, which is the shape the native services run in.
#
# stdout bytes are not a std primitive yet (the byte-stdout and append batch of
# docs/web-core-split-design.md section 9 adds one), so the wire writes go
# through `write_bytes` on /dev/stdout. That reopens the descriptor for every
# write, which is right for the pipe the driver gives this process and wrong
# for a regular file or a socket; the contract only ever runs it on a pipe, and
# the primitive replaces this function.
use std/io.{read_stdin, stdin_ready, with_fs_real, write_bytes}
use web/exchange.{Transport, ExchangeConfig, serve_exchange}
use contract_app/app.{routes, middleware, errors, MAX_BODY}

fn write_wire(b: Bytes) -> Unit !io =
  with_fs_real(() => {
    let _ = write_bytes("/dev/stdout", b)
    ()
  })

# Take what has already arrived and drop it, without waiting, so that exiting
# with an unread body does not turn the close into a reset that eats the
# response the peer has not read yet.
fn drain() -> Unit !io = {
  var more = true
  while more {
    if stdin_ready(0) {
      if len(read_stdin(4096)) == 0 { more = false }
    } else {
      more = false
    }
  }
}

pub fn main() -> Unit !io = {
  let t = Transport { read: (_pos, n) => read_stdin(n), write: write_wire }
  serve_exchange(ExchangeConfig { max_body: MAX_BODY, errors: errors() }, routes(), middleware(), t)
  drain()
}

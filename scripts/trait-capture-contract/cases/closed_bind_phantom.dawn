# Ordinary environments and delivered type support have separate contracts.
use std/mem
type Phantom[T] = { n: Int }
fn closed_bind[T: ^{}](value: T, read: fn(T, Int) -> Int) -> (fn(Int) -> Int) = n => read(value, n)
fn escaped() -> (fn(Int) -> Int) = mem.with_mem([@s] () => {
  let value: Phantom[I64Buf@s] = Phantom { n = 7 }
  let read: fn(Phantom[I64Buf@s], Int) -> Int = (p: Phantom[I64Buf@s], n: Int) => p.n + n
  closed_bind(value, read)
})
pub fn main() -> Unit !io = { let f = escaped()
  println(to_string(f(4))) }

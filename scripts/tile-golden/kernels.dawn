  }
  "attr_memsem" -> {
    let (p, _e) = trace2("attr_memsem", In(I32, run_of(ATTR_TILE)), Shared(I32), attr_memsem)
    p
  }
  "attr_addf" -> {
    let (p, _e) = trace2("attr_addf", In(F64, run_of(ATTR_TILE)), Shared(F64), attr_addf)

# The interface family ends at eight written parameters. Keep each source
# boundary visible in the diagnostic golden, including an unused lambda.
alias Wide = fn(Int, Int, Int, Int, Int, Int, Int, Int, Int) -> Int

fn nine(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int) -> Int =
  a + b + c + d + e + f + g + h + i

fn named_value() -> Unit = { let value = nine }

fn inferred_lambda() -> Unit = {
  let value = (a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int) =>
    a + b + c + d + e + f + g + h + i
}

effect WideEffect {
  fn op(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int) -> Int
}

ctl effect WideControl {
  fn suspend(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int) -> Int
}

type Nine = | Nine(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int)
fn ctor_value() -> Unit = {
  let value: fn(Int, Int, Int, Int, Int, Int, Int, Int, Int) -> Nine = Nine
}

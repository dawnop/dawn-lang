-- pairs --
first tie, second differs: lt
first differs:             gt
equal:                     eq
operator:                  true
-- triples --
middle decides: lt
last decides:   gt
equal:          eq
-- nested --
left nested:  lt
right nested: gt
nested equal: eq
-- short circuit --
Bomb stays cold: lt
-- generic dictionaries --
whole tuple forwarded: lt
tuple built from T:    lt

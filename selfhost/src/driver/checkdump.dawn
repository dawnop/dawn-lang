# The `__check` golden format (P3b): one dump per target, byte-identical
# between `dawn __check` and `selfhost check`. Lines:
#   D <path> <lo> <hi> <esc msg> <esc hint>   every diagnostic, program order
#   M <modPath>                               then per module, dependency order
#   F <esc sig-render>                        each pub fn's checked signature
#   C <name> <esc value | !failed>            each const's comptime value

use std/map
use std/str
use check/types.{Adts, adt_of, sig_render}
use check/identity
use check/identity.{Named, FunctionDecl}
use driver/analyze.{Program, LocDiag, rendered_diags}
use front/parser
use front/token.{Diag, DiagOwner}
use front/ast.{module_fns, module_consts}
use front/lexdump

## Render one comptime value for the golden (both sides must agree).
pub fn cv_show(adts: Adts, v: CValue) -> String =
  match v {
    VInt(n) -> to_string(n)
    VFloat(f) -> to_string(f)
    VBool(b) -> to_string(b)
    VStr(s) -> "\"" ++ lexdump.esc(s) ++ "\""
    VUnit -> "()"
    VList(elems) -> {
      var parts: List[String] = []
      for x in elems { parts = parts ++ [cv_show(adts, x)] }
      "[" ++ join(parts, ", ") ++ "]"
    }
    VTuple(elems) -> {
      var parts: List[String] = []
      for x in elems { parts = parts ++ [cv_show(adts, x)] }
      "(" ++ join(parts, ", ") ++ ")"
    }
    VAdt(aid, ci, fields) -> {
      let name = adt_of(adts, aid).ctors[ci].name
      if len(fields) == 0 {
        name
      } else {
        var parts: List[String] = []
        for x in fields { parts = parts ++ [cv_show(adts, x)] }
        name ++ "(" ++ join(parts, ", ") ++ ")"
      }
    }
    _ -> "<fn>"
  }

pub fn render(prog: Program) -> String = {
  var out = ""
  # The golden prints positions in the file, so the owner-relative ones the
  # checker recorded are resolved against this program's own view first.
  for ld in rendered_diags(prog) {
    out = out ++ "D\t" ++ ld.path ++ "\t" ++ to_string(ld.d.lo) ++ "\t" ++
      to_string(ld.d.hi) ++ "\t" ++ lexdump.esc(ld.d.msg) ++ "\t" ++ lexdump.esc(ld.d.hint) ++ "\n"
  }
  for cm in prog.modules {
    out = out ++ "M\t" ++ cm.mod_path ++ "\n"
    for fd in module_fns(cm.m) {
      if fd.is_pub {
        match map.get(cm.cx.fns, fd.name) {
          Some(s) -> {
            out = out ++ "F\t" ++ lexdump.esc(sig_render(cm.cx.adts, cm.cx.traits, s)) ++ "\n"
          }
          None -> ()
        }
      }
    }
    for cd in module_consts(cm.m) {
      let val = match map.get(cm.ct.consts, cd.name) {
        Some(v) -> lexdump.esc(cv_show(cm.cx.adts, v))
        None -> "!failed"
      }
      out = out ++ "C\t" ++ cd.name ++ "\t" ++ val ++ "\n"
    }
  }
  out
}
use ir/core.{CValue, VInt, VFloat, VBool, VStr, VUnit, VList, VTuple, VAdt}

test "the dump prints where a diagnostic sits in the revision it dumps" {
  # A diagnostic raised inside `g` is recorded as an offset from `g`, so a
  # dump that read `prog.diags` instead of resolving it would print the
  # offset and claim it was a position in the file.
  let source = "fn f() -> Int = 1\nfn g() -> Int = true\n"
  let (m, pd) = parser.parse_module(source)
  assert len(pd) == 0
  let owner = DiagOwner { module: "g", decl: identity.path_text([Named(FunctionDecl, "g")]) }
  let raised = Diag { msg: "m", lo: 16, hi: 20, hint: "", owner: Some(owner) }
  let prog = Program { modules: [], diags: [LocDiag { path: "g.dawn", d: raised }],
    decl_spans: map.from([("g", identity.declaration_spans(m))]) }
  let start = str.index_of(source, "fn g").expect("g is in the source")
  assert render(prog) ==
    "D\tg.dawn\t" ++ to_string(start + 16) ++ "\t" ++ to_string(start + 20) ++ "\tm\t\n"
}

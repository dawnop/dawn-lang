# #144: `Eq[List[Int]]` asked for both ways in one module. A record's
# synthesised equality reaches it as a constant (its field is ground), and a
# direct comparison of nested lists builds it from `Eq[Int]`. With the
# dictionary key blind to its arity, one def answers both requests -- the
# shape check/cx and check/passes produced in the compiler itself.
use std/io

type Rows = { rows: List[List[Int]] }

pub fn main() -> Unit !io = {
  let r = Rows { rows: [[1, 2]] }
  io.println("${r == Rows { rows: [[1, 2]] }}")
  let a: List[List[Int]] = [[1, 2]]
  io.println("${a == [[1, 2]]}")
}

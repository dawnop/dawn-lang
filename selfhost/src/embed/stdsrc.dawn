n    65 -> (5998787255582523819, 2495639257869859918)\n    66 -> (4799029804466019055, 3841185813666843096)\n    67 -> (7678447687145630488, 6145897301866948954)\n    68 -> (6142758149716504390, 8606066656235469486)\n    69 -> (4914206519773203512, 6884853324988375589)\n    70 -> (7862730431637125620, 3637067690497580296)\n    71 -> (6290184345309700496, 2909654152398064237)\n    72 -> (5032147476247760397, 483048914547496228)\n    73 -> (8051435961996416635, 2617552670646949126)\n    74 -> (6441148769597133308, 2094042136517559301)\n    75 -> (5152919015677706646, 5364582523955957764)\n    76 -> (8244670425084330634, 4893983223587622099)\n    77 -> (6595736340067464507, 5759860986241052841)\n    78 -> (5276589072053971606, 918539974250931950)\n    79 -> (8442542515286354569, 7003687180914356604)\n    80 -> (6754034012229083655, 7447624152102440445)\n    81 -> (5403227209783266924, 5958099321681952356)\n    82 -> (8645163535653227079, 3998935692578258285)\n    83 -> (6916130828522581663, 5043822961433561789)\n    84 -> (5532904662818065330, 7724407183888759755)\n    85 -> (8852647460508904529, 3135679457367239799)\n    86 -> (7082117968407123623, 4353217973264747001)\n    87 -> (5665694374725698898, 7171923193353707924)\n    88 -> (9065110999561118238, 407030665140201709)\n    89 -> (7252088799648894590, 4014973346854071690)\n    90 -> (5801671039719115672, 3211978677483257352)\n    91 -> (4641336831775292537, 8103606164099471367)\n    92 -> (7426138930840468060, 5587072233075333540)\n    93 -> (5940911144672374448, 4469657786460266832)\n    94 -> (4752728915737899558, 7265075043910123789)\n    95 -> (7604366265180639294, 556073626030467093)\n    96 -> (6083493012144511435, 2289533308195328836)\n    97 -> (4866794409715609148, 1831626646556263069)\n    98 -> (7786871055544974637, 1085928227119065748)\n    99 -> (6229496844435979709, 6402765803808118083)\n    _ -> panic(\"fmt: 10^k out of range\")\n  }\n\nfn g_chunk1(i: Int) -> (Int, Int) =\n  match i {\n    100 -> (
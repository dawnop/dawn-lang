# docs/tutorial.md -> tutorial/index.html + one page per ## chapter.

use std/str
use md/ast.{Inline, Text, Block, Heading, Para, CodeBlock}
use html/render.{render_doc, render_doc_play, inline_text, inline_run, split_head, split_number, TocEntry}
use html/play.{Play, play_decode}
use html/escape.{escape_html, escape_attr}
use html/page.{Assets, Lang, En, Zh, PageHead, Crumb, page, page_with_toc, rail_html, contents_label,
  lang_path, playground_label, section_crumb, here, chip, reading_chip, twin_chip }
use gen/common.{write_page, map_doc_url, doc_files, pad2, drop_trailing_rule}
use std/io.{Fs}

## One `##` chapter: its title and the blocks under it, as its page renders
## them. Public because the body index (gen/search_body) cuts the same
## chapters into sections, and a second split could disagree with this one.
pub type Chapter = { title: List[Inline], body: List[Block] }

## What the tutorial is called on its own pages: the index's <title>, and the
## suffix each chapter's <title> carries. One entry, because they are one name.
fn tutorial_name(lang: Lang) -> String =
  match lang {
    En -> "Dawn Tutorial"
    Zh -> "Dawn 教程"
  }

pub fn split_chapters(blocks: List[Block]) -> (List[Block], List[Chapter]) = {
  var intro: List[Block] = []
  var chapters: List[Chapter] = []
  var cur: List[Block] = []
  var cur_title: List[Inline] = []
  var started = false
  for b in blocks {
    var is_h2 = false
    match b {
      Heading(lvl, items) -> {
        if lvl == 2 {
          is_h2 = true
          if started {
            chapters = chapters ++ [Chapter { title: cur_title, body: drop_trailing_rule(cur) }]
          }
          started = true
          cur_title = items
          cur = []
        }
      }
      _ -> {
        is_h2 = false
      }
    }
    if not is_h2 {
      if started {
        cur = cur ++ [b]
      } else {
        intro = intro ++ [b]
      }
    }
  }
  if started {
    chapters = chapters ++ [Chapter { title: cur_title, body: drop_trailing_rule(cur) }]
  }
  (intro, chapters)
}

fn chapter_title(chapters: List[Chapter], i: Int) -> String =
  match get(chapters, i) {
    Some(c) -> inline_text(c.title)
    None -> ""
  }

## The two cards under a chapter: the one before it and the one after, each
## with a small label saying which way it goes. The first chapter's "before"
## is the table of contents.
fn chapter_nav(chapters: List[Chapter], i: Int, lang: Lang) -> String = {
  let n = len(chapters)
  let (back, prev_word, next_word) =
    match lang {
      En -> ("← tutorial", "← previous", "next →")
      Zh -> ("← 教程", "← 上一章", "下一章 →")
    }
  let card = (cls: String, href: String, dir: String, title: String) =>
    """<a class="${cls}" href="${href}"><span class="dir">${dir}</span><span class="ttl">""" ++ escape_html(title)
    ++ "</span></a>"
  let prev =
    if i > 0 {
      card("prev", "${pad2(i)}.html", prev_word, chapter_title(chapters, i - 1))
    } else {
      card("prev", "index.html", back, contents_label(lang))
    }
  let next =
    if i + 1 < n {
      "\n" ++ card("next", "${pad2(i + 2)}.html", next_word, chapter_title(chapters, i + 1))
    } else {
      ""
    }
  """<nav class="chapter-nav" aria-label="${rail_label(lang)}">""" ++ "\n" ++ prev ++ next ++ "\n</nav>"
}

## What the chapter rail and the chapter cards are called: the tutorial, as
## the nav calls it.
fn rail_label(lang: Lang) -> String =
  match lang {
    En -> "Tutorial"
    Zh -> "教程"
  }

## A count in Chinese numerals, as the band writes them (第八章，共十七章).
## Up to 99, which is more chapters than a tutorial should have.
pub fn zh_count(n: Int) -> String = {
  let digits = ["零", "一", "二", "三", "四", "五", "六", "七", "八", "九"]
  if n < 10 {
    digits[n]
  } else {
    let tens = if n / 10 == 1 { "十" } else { digits[n / 10] ++ "十" }
    if n % 10 == 0 { tens } else { tens ++ digits[n % 10] }
  }
}

## The trail over the tutorial's pages: the tutorial, and over a chapter,
## which one, the tutorial then leading back to the index.
fn tutorial_crumbs(lang: Lang, root: String, chapter: Int) -> List[Crumb] =
  if chapter == 0 {
    [section_crumb(lang, root, "tutorial", false)]
  } else {
    let word =
      match lang {
        En -> "Chapter ${chapter}"
        Zh -> "第${zh_count(chapter)}章"
      }
    [section_crumb(lang, root, "tutorial", true), here(word)]
  }

## How long the tutorial is, over its index.
fn chapters_chip(lang: Lang, n: Int) -> String =
  match lang {
    En -> chip("${n} chapters")
    Zh -> chip("共${zh_count(n)}章")
  }

## Where a chapter sits, with a step back and a step on beside it: the
## chapter before it and after it, each a small arrow whose name is the
## chapter it leads to. The first chapter has no step back here (its card
## under the text leads to the contents) and the last none on.
fn chapter_chip(lang: Lang, chapters: List[Chapter], i: Int) -> String = {
  let n = len(chapters)
  let at =
    match lang {
      En -> "chapter ${i + 1} of ${n}"
      Zh -> "第${zh_count(i + 1)}章，共${zh_count(n)}章"
    }
  let step = (cls: String, href: String, title: String, d: String) =>
    """<a class="${cls}" href="${href}" title="${escape_attr(title)}" aria-label="${escape_attr(title)}">"""
    ++ """<svg viewBox="0 0 16 16" aria-hidden="true"><path d="${d}"/></svg></a>"""
  let prev = if i > 0 { step("prev", "${pad2(i)}.html", chapter_title(chapters, i - 1), "M10 3.5 5.5 8l4.5 4.5") } else { "" }
  let next = if i + 1 < n { step("next", "${pad2(i + 2)}.html", chapter_title(chapters, i + 1), "M6 3.5 10.5 8 6 12.5") } else { "" }
  """<li class="chip step">${prev}<span>${at}</span>${next}</li>"""
}

## A chapter's title as the band sets it: its printed number apart, in the
## label face and the accent colour, the way the spec's section numbers are
## set in the body, and the words after it. A title that prints no number is
## rendered as it is.
fn chapter_heading(items: List[Inline], mu: fn(String) -> String) -> String =
  match get(items, 0) {
    Some(Text(s)) -> {
      let (num, rest) = split_number(s)
      if num == "" {
        inline_run(items, mu)
      } else {
        `<span class="n">` ++ escape_html(num) ++ "</span> " ++ escape_html(rest)
          ++ inline_run(map(range(1, len(items)), i => items[i]), mu)
      }
    }
    _ -> inline_run(items, mu)
  }

## The chapter's printed number and its title: `8. Lambdas` -> ("8", "Lambdas").
## A title that prints none keeps its whole text and an empty number.
fn numbered(title: String) -> (String, String) = {
  let (num, rest) = split_number(title)
  (unwrap_or(str.strip_suffix(num, "."), num), rest)
}

## The chapters as a rail beside a chapter, the one being read marked.
fn chapter_rail(chapters: List[Chapter], current: Int, lang: Lang) -> String = {
  var items: List[String] = []
  for i in range(0, len(chapters)) {
    let (num, rest) = numbered(chapter_title(chapters, i))
    let cls = if i == current { ` class="has-n cur" aria-current="page"` } else { ` class="has-n"` }
    items = items
      ++ ["""<li><a${cls} href="${pad2(i + 1)}.html"><span class="tn">${escape_html(num)}</span><span>"""
          ++ escape_html(rest) ++ "</span></a></li>"]
  }
  rail_html(rail_label(lang), "<ul>\n" ++ join(items, "\n") ++ "\n</ul>")
}

## The index's chapter list as a road: each chapter's number, zero-padded, in
## a disc whose colour is mixed from indigo to magenta by `--p`, the chapter's
## place along the road from 0 to 1 (three decimals, written as integers so
## that both backends print the same bytes).
fn chapter_road(chapters: List[Chapter]) -> String = {
  let n = len(chapters)
  var items: List[String] = []
  for i in range(0, n) {
    let (num, rest) = numbered(chapter_title(chapters, i))
    let shown = if num == "" { pad2(i + 1) } else { str.pad_start(num, 2, "0") }
    let milli = if n < 2 { 0 } else { i * 1000 / (n - 1) }
    let p = "${milli / 1000}." ++ str.pad_start("${milli % 1000}", 3, "0")
    items = items
      ++ ["""<li style="--p:${p}"><a href="${pad2(i + 1)}.html"><span class="cn">${escape_html(shown)}</span>"""
          ++ """<span class="ct">${escape_html(rest)}</span><span class="ca" aria-hidden="true">→</span></a></li>"""]
  }
  `<ol class="chapters">` ++ "\n" ++ join(items, "\n") ++ "\n</ol>"
}

## The chapter titles, in the order the tutorial has them.
##
## What the search index needs, and all it needs: a chapter is a page of its
## own (`tutorial/01.html` and up), so its title is a page title and the index
## has nowhere to put a fragment. Numbering is the caller's -- the page names
## are `pad2(i + 1)`, exactly as [gen_tutorial] writes them.
pub fn chapter_titles(blocks: List[Block]) -> List[String] = {
  let (_, chapters) = split_chapters(blocks)
  map(chapters, c => inline_text(c.title))
}

## Each chapter's `###` sections, as the chapter page anchors them.
##
## The ids come out of `render_doc` over the same blocks [gen_tutorial] renders
## the page from, chapter title as the `#` heading first, so they are the ids
## the page carries (`s0-1`, `s0-2`, ...: a chapter page has no `##` of its
## own). The search index reads this; gen/links holds every fragment in it to
## the written page.
pub fn chapter_sections(blocks: List[Block]) -> List[List[TocEntry]] = {
  let (_, chapters) = split_chapters(blocks)
  map(chapters, c => render_doc([Heading(1, c.title)] ++ c.body, u => u).toc)
}

## Where this language's tutorial pages go, and how far they are from the
## site root. English is the original and takes the default layout; the
## translation sits under `/zh/`, the same place the Chinese front page does.
## Which file each is written in is gen/corpus's.
pub fn tutorial_source(out: String, lang: Lang) -> (String, String) =
  match lang {
    En -> ("${out}/tutorial", "..")
    Zh -> ("${out}/zh/tutorial", "../..")
  }

## Where this language's tutorial sends its prefilled Playground links, from a
## page `root` deep. `lang_path` is the site's one layout rule -- the Chinese
## twin of any paired page is that same path under `/zh/` -- so the language
## picks the page and nothing here writes a second href to keep level with the
## first. An English chapter linking the Chinese Playground would still
## resolve, still decode and still run the program: the only thing wrong with
## it is the chrome around the editor, which is why the test below names the
## href rather than merely checking that the link works.
fn tutorial_play(root: String, lang: Lang) -> Play =
  Play {
    href: "${root}/" ++ lang_path(lang, "playground.html"),
    label: playground_label(lang),
  }

## The tutorial: an index page plus one page per `##` chapter. Called once per
## language, and `lang` picks all three of the source document, the output
## directory and the depth every relative link is written from -- so the two
## runs land beside each other instead of on top of each other.
##
## `blocks` is the parsed document, from gen/corpus.
##
## Every page here is paired, and the pair is named by its path in the default
## layout (`tutorial/03.html`) rather than by a pair of hrefs; html/page.dawn's
## [site_url] turns that into the switch link and the hreflang URLs, which
## differ between the two runs only in `root`.
pub fn gen_tutorial(out: String, a: Assets, lang: Lang, blocks: List[Block]) -> Unit !Fs !io = {
  let (dir, root) = tutorial_source(out, lang)
  let (intro, chapters) = split_chapters(blocks)
  let n = len(chapters)
  let docs = doc_files()
  # every dawn block on these pages carries its own source to the editor
  let play = Some(tutorial_play(root, lang))

  let mu = (u: String) => map_doc_url(root, docs, u)

  # chapter pages: the chapter's title in the band, the chapters in the rail
  for i in range(0, n) {
    match get(chapters, i) {
      Some(c) -> {
        let doc = render_doc_play(c.body, mu, play)
        let head = PageHead {
          crumbs: tutorial_crumbs(lang, root, i + 1),
          title: chapter_heading(c.title, mu),
          lede: "",
          meta: [chapter_chip(lang, chapters, i), reading_chip(lang, doc.html)],
          extra: "",
          cls: "toc-aligned",
        }
        let title = inline_text(c.title)
        write_page("${dir}/${pad2(i + 1)}.html",
          page_with_toc(a, lang, "tutorial/${pad2(i + 1)}.html",
            "${title} — ${tutorial_name(lang)}", root, "tutorial", head,
            chapter_rail(chapters, i, lang), doc.html ++ "\n" ++ chapter_nav(chapters, i, lang)))
      }
      None -> {
        panic("unreachable chapter index")
      }
    }
  }

  # index: the title, the translation note and the opening paragraph in the
  # band; below it, the chapters. The rule that ends the intro in the source
  # separates it from chapter one there and has nothing to separate here.
  let parts = split_head(intro)
  let (lede, rest) =
    match parts.body {
      [Para(items), ..] -> (inline_run(items, mu), drop_trailing_rule(drop_one(parts.body)))
      _ -> ("", drop_trailing_rule(parts.body))
    }
  let rest_html = render_doc_play(rest, mu, play).html
  let head = PageHead {
    crumbs: tutorial_crumbs(lang, root, 0),
    title: inline_run(parts.title, mu),
    lede: lede,
    meta: [chapters_chip(lang, n), twin_chip(parts.twin, mu)],
    extra: "",
    cls: "col",
  }
  write_page("${dir}/index.html",
    page(a, lang, "tutorial/index.html", tutorial_name(lang), root, "tutorial", head,
      rest_html ++ chapter_road(chapters)))
}

fn drop_one(bs: List[Block]) -> List[Block] = map(range(1, len(bs)), i => bs[i])

test "a chapter's number is set apart in its title" {
  assert chapter_heading([Text("3. match and exhaustiveness")], u => u) == `<span class="n">3.</span> match and exhaustiveness`
  assert chapter_heading([Text("Intro")], u => u) == "Intro"
}

test "chapter counts read in Chinese numerals" {
  assert zh_count(8) == "八"
  assert zh_count(10) == "十"
  assert zh_count(17) == "十七"
  assert zh_count(20) == "二十"
  assert zh_count(42) == "四十二"
}

test "the road numbers its chapters with zero-padded discs, placed from 0 to 1" {
  let cs = [
    Chapter { title: [md_text("1. First")], body: [] },
    Chapter { title: [md_text("2. Second")], body: [] },
    Chapter { title: [md_text("3. Third")], body: [] },
  ]
  let road = chapter_road(cs)
  assert str.contains(road, `<li style="--p:0.000"><a href="01.html"><span class="cn">01</span><span class="ct">First</span>`)
  assert str.contains(road, `<li style="--p:0.500"><a href="02.html">`)
  assert str.contains(road, `<li style="--p:1.000"><a href="03.html"><span class="cn">03</span>`)
  # the rail beside chapter two marks it, unpadded
  let rail = chapter_rail(cs, 1, En)
  assert str.contains(rail, `<a class="has-n cur" aria-current="page" href="02.html"><span class="tn">2</span><span>Second</span></a>`)
  # the cards: back to the contents from the first, both ways from the middle
  assert str.contains(chapter_nav(cs, 0, En),
    `<a class="prev" href="index.html"><span class="dir">← tutorial</span><span class="ttl">Contents</span></a>`)
  let mid = chapter_nav(cs, 1, Zh)
  assert str.contains(mid, `<span class="dir">← 上一章</span><span class="ttl">1. First</span>`)
  assert str.contains(mid, `<a class="next" href="03.html"><span class="dir">下一章 →</span>`)
  assert not str.contains(chapter_nav(cs, 2, En), `class="next"`)
}

fn md_text(s: String) -> Inline = Text(s)

test "each language's tutorial lands in its own place" {
  assert tutorial_source("d", En) == ("d/tutorial", "..")
  assert tutorial_source("d", Zh) == ("d/zh/tutorial", "../..")
}

## The href a chapter's `#`-carrying link is written from. `..` and `../..` are
## the two depths tutorial_source hands out, so these are the two hrefs the
## site really ships; both are the reader's own language.
test "a chapter's playground links point at its own language's editor" {
  assert tutorial_play("..", En).href == "../playground.html"
  assert tutorial_play("..", En).label == "Open in playground"
  assert tutorial_play("../..", Zh).href == "../../zh/playground.html"
  assert tutorial_play("../..", Zh).label == "在 Playground 打开"
}

## The fragment of the first `playground.html#...` href in `html`, or "". The
## opener is `.html#` rather than `#`, because a Dawn comment starts with `#`
## and the highlighted program is sitting right there in the same string.
fn first_play_hash(html: String) -> String =
  match str.split(html, ".html#") {
    [_, rest, ..] ->
      match str.split(rest, "\"") {
        [h, ..] -> h
        _ -> ""
      }
    _ -> ""
  }

## The end-to-end claim, on the two shapes that ship: a dawn block on a
## tutorial page comes out with a link, the link goes to this language's
## Playground, and what the reader lands in is the program they were reading --
## byte for byte, comments and all.
##
## The Chinese half is not a translation of the English half for its own sake.
## It is the case a generator that encoded code points as bytes would fail and
## the English one would pass, and it is two thirds of the tutorial's blocks.
test "a tutorial dawn block links to the editor with itself prefilled" {
  let en_code = "fn main() -> Unit !io = println(\"hello\")"
  let en = render_doc_play([CodeBlock("dawn", en_code)], u => u,
    Some(tutorial_play("..", En)))
  assert str.contains(en.html, `<figure class="win playable">`)
  assert str.contains(en.html, `href="../playground.html#`)
  assert str.contains(en.html, ">Open in playground</a>")
  assert play_decode(first_play_hash(en.html)) == Some(en_code)

  let zh_code = "# 打印一行\nfn main() -> Unit !io = println(\"你好, Dawn\")"
  let zh = render_doc_play([CodeBlock("dawn", zh_code)], u => u,
    Some(tutorial_play("../..", Zh)))
  assert str.contains(zh.html, `href="../../zh/playground.html#`)
  assert str.contains(zh.html, ">在 Playground 打开</a>")
  assert play_decode(first_play_hash(zh.html)) == Some(zh_code)
}

## The other half of the offer: pages that do not make it are unchanged. An
## `output` fence is not a program, and the spec's fragments are not either --
## `render_doc` is the call that says so.
test "only a dawn block on a page that offers links gets one" {
  let offered = render_doc_play([CodeBlock("output", "42")], u => u,
    Some(tutorial_play("..", En)))
  assert not str.contains(offered.html, "play-open")
  let plain = render_doc([CodeBlock("dawn", "let x = 1")], u => u)
  assert not str.contains(plain.html, "play-open")
  assert not str.contains(plain.html, "playable")
}

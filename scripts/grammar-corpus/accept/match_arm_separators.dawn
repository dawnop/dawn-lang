# Match arms use either a physical newline or a comma; a comma may be followed
# by newlines, and the final arm may carry a trailing comma (spec section 5).

fn comma_same_line(x: Int) -> Int = match x { 0 -> 1, _ -> 2 }

fn comma_then_newline(x: Int) -> Int = match x { 0 -> 1,
  _ -> 2 }

fn trailing_comma(x: Int) -> Int = match x {
  0 -> 1,
  _ -> 2,
}

# The prefilled Playground link a code block carries: an href whose
# `#fragment` IS the program, so that "try this" is a click instead of a
# select-copy-switch-tab-paste.
#
# The protocol belongs to the editor, not to this generator.
# site/play-ui/src/main.ts writes the fragment as
# `btoa(unescape(encodeURIComponent(code)))` and reads it back as
# `decodeURIComponent(escape(atob(hash)))`. That sandwich is not an encoding of
# its own: `encodeURIComponent` percent-escapes the UTF-8 bytes and `unescape`
# turns each `%XX` straight back into the character of that code, so what
# `btoa` is handed is the UTF-8 byte string and nothing else. The sandwich
# exists only because `atob`/`btoa` deal in latin-1. So
# `bytes.to_base64(bytes.utf8(code))` is the same string byte for byte --
# standard alphabet, `=` padding, both of which `atob` wants and neither of
# which `to_base64_url` writes.
#
# That equality is the whole reason the Chinese tutorial can have links at all:
# a generator that reached for `btoa`'s own habit and encoded code points as
# bytes would lose every comment in it. The round trip is asserted below on a
# Chinese program, and the wire format is pinned to a literal separately --
# a round trip alone passes just as happily when both halves are wrong
# together, and the half that has to match is the one this file cannot run.
#
# Not this module's business, said here so the next reader does not look for
# it: which blocks get a link. The tutorial's two `dawn skip-check` fragments
# (halves of a multi-file project) used to get one like every other dawn
# fence, on the theory that the Playground is an editor and a fragment is a
# reasonable thing to open in one. In practice each link opened a program
# that could only fail ("has no pub fn main()", "cannot find module
# util/math"), and a link that always fails is a trap rather than a
# convenience. The parser now gives those blocks their own variant
# (md/ast.Fragment) and html/render.dawn never offers one.

use std/bytes
use std/str
use html/escape.{escape_html, escape_attr}

## Where a page's prefilled links go, and what they say there. Both halves are
## the caller's because both depend on the page's language, which this module
## deliberately does not know: `Lang` lives in html/page.dawn, html/page.dawn
## imports html/render.dawn, and html/render.dawn is what calls this. A `Lang`
## here would close that ring into a `use` cycle.
pub type Play = { href: String, label: String } derive Show

## `code` as the editor's URL fragment: Base64 (standard alphabet, padded)
## over the UTF-8 bytes.
pub fn play_hash(code: String) -> String = bytes.to_base64(bytes.utf8(code))

## The program a fragment carries, or `None` when it is not one -- the inverse
## of `play_hash`, and the editor's `decodeShare`. It exists as production code
## rather than as a test helper because gen/links.dawn reads every fragment
## this generator wrote back through it: a `#` on a link to the Playground is a
## payload, not an element id, and this is the only sense in which it can be
## checked.
pub fn play_decode(hash: String) -> Option[String] =
  match bytes.from_base64(hash) {
    Some(b) ->
      match bytes.decode_utf8_checked(b) {
        Ok(s) -> Some(s)
        Err(_) -> None
      }
    None -> None
  }

## The link itself, labelled in the page's language. No escaping is needed for
## the fragment -- the standard Base64 alphabet holds nothing HTML reserves --
## but it goes through `escape_attr` anyway, because "this string happens to
## contain no `&` or `"`" is not a property a reader of the markup can check,
## and the page half of the href is the caller's.
pub fn play_link(p: Play, code: String) -> String = {
  let href = escape_attr(p.href ++ "#" ++ play_hash(code))
  """<a class="play-open" href="${href}">${escape_html(p.label)}</a>"""
}

## The bar along the top of a code window: three dots, a label (`dawn`, a
## file name, a mount point), and whatever the caller puts at its right end.
pub fn win_bar(label: String, tail: String) -> String =
  `<div class="win-bar"><i></i><i></i><i></i><span class="lbl">` ++ escape_html(label) ++ "</span>"
  ++ tail ++ "</div>"

## A program in a window: the bar with its Playground link, the `<pre>`, and
## the output it prints (`out`, already rendered, or "") under it in the same
## frame. One element, so that what reads as one thing is one thing; the
## program and its output are siblings in the source, and html/render.dawn
## pairs them before they get here.
pub fn play_block(p: Play, label: String, pre: String, code: String, out: String) -> String = {
  let tail = if out == "" { "" } else { "\n" ++ out }
  `<figure class="win playable">` ++ "\n" ++ win_bar(label, play_link(p, code)) ++ "\n" ++ pre ++ tail
    ++ "\n</figure>"
}

## A file in a window with no link: a module of a project, which the
## Playground could not run on its own.
pub fn code_window(label: String, pre: String) -> String =
  `<figure class="win">` ++ "\n" ++ win_bar(label, "") ++ "\n" ++ pre ++ "\n</figure>"

## The wire format, pinned to a literal rather than to itself. This is the
## assertion a round trip cannot make: `play_hash` and `play_decode` agreeing
## proves only that they agree, and the implementation they have to agree WITH
## is a line of TypeScript that no test here can run. These two strings came
## out of `btoa(unescape(encodeURIComponent(s)))`.
test "the fragment is exactly what the editor's btoa sandwich writes" {
  assert play_hash("fn main() -> Unit !io = println(\"hi\")\n")
    == "Zm4gbWFpbigpIC0+IFVuaXQgIWlvID0gcHJpbnRsbigiaGkiKQo="
  # Chinese, an emoji outside the BMP, and a length that forces `=` padding.
  assert play_hash("# 中文 🌅\n") == "IyDkuK3mlocg8J+MhQo="
}

test "a program survives the round trip, multi-byte comments included" {
  let en = "fn main() -> Unit !io = println(\"hello\")\n"
  assert play_decode(play_hash(en)) == Some(en)
  let zh = "# 打印一行\nfn main() -> Unit !io = println(\"你好, Dawn\")\n"
  assert play_decode(play_hash(zh)) == Some(zh)
}

## What gen/links.dawn leans on: a fragment that is not a program says so.
test "a fragment that is not a program does not decode" {
  # Not the standard alphabet -- `atob` refuses `-` and `_`.
  assert play_decode("Zm4-bWFpbg==") == None
  # Valid Base64 either way; the second one holds two thirds of a character.
  assert play_decode("5Lit") == Some("中")
  assert play_decode("5Lg=") == None
}

test "the link carries the program in its fragment and its label in the markup" {
  let p = Play { href: "../playground.html", label: "Open in playground" }
  assert play_link(p, "let x = 1")
    == `<a class="play-open" href="../playground.html#bGV0IHggPSAx">Open in playground</a>`
  assert play_block(p, "dawn", "<pre>P</pre>", "let x = 1", "")
    == `<figure class="win playable">` ++ "\n"
    ++ `<div class="win-bar"><i></i><i></i><i></i><span class="lbl">dawn</span>`
    ++ `<a class="play-open" href="../playground.html#bGV0IHggPSAx">Open in playground</a></div>`
    ++ "\n<pre>P</pre>\n</figure>"
  assert str.ends_with(play_block(p, "a.dawn", "<pre>P</pre>", "x", "<pre>O</pre>"),
    "<pre>P</pre>\n<pre>O</pre>\n</figure>")
  # the page half of the href is an attribute value like any other
  let q = Play { href: "a\"b&c.html", label: "x" }
  assert str.contains(play_link(q, ""), `href="a&quot;b&amp;c.html#"`)
}

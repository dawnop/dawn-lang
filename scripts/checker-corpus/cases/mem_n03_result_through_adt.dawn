# checker.dawn: rule R1 reaches a buffer through the field of a user record
# and of a user variant (N3), with substitution for a generic wrapper.
use std/mem

pub type Box = { b: I64Buf }

pub type Held = Empty | Full(buf: I64Buf)

pub type Wrap[T] = { inner: T }

pub fn in_record() -> Box = mem.with_mem(() => Box { b= mem.new(4) })

pub fn in_variant() -> Held = mem.with_mem(() => Full(buf= mem.new(4)))

pub fn in_generic() -> Wrap[I64Buf] = mem.with_mem(() => Wrap { inner= mem.new(4) })

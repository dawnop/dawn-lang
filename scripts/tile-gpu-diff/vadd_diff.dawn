# The layer-2 oracle of docs/tile-backend-design.md 6.2: one `!Gpu` program
# runs vadd under `with_gpu_real` against the machine's GPU and under
# `with_gpu_fake` against the host reference, and prints what each device
# answered at every stage, so run.sh can say whether the two agree bit for
# bit, and if not, where the real one stopped. Three formats: f64 through the
# `vadd` kernel, bf16 through `vadd_bf16`, whose device-side `addf` is
# held to `narrow.round_bf16` of the exact sum (docs 3.2, through the fake
# device, which std/gpu's tests hold to narrow), and f32 through `vadd_f32`,
# whose `addf` is held to `narrow.round_f32` of the exact sum (the sum of
# two binary32 values is exact in binary64, so that is one rounding).
#
#   vadd_diff <vadd.cubin> <vadd_bf16.cubin> <vadd_f32.cubin>
#
# One block per input set, then one verdict line:
#
#   set <i> <dtype> n=<n> grid=<n/width>
#     fake  launch=ok result=<digest>
#     real  alloc=<kind> upload=<kind> roundtrip=<same|differ|kind> launch=<kind> sync=<kind>
#           download=<kind> result=<digest>
#     note  <the device's message, when it refused>
#     verdict identical | blocked:<kind>@<stage> | differ:<stage>
#   tile-gpu-diff: pass | blocked:<kind>@<stage> | fail
#
# `roundtrip` is upload-then-download of both inputs, each compared with the
# input as the format holds it (`gpu.round_to`: the Float itself for f64,
# its nearest bf16 for bf16), as rendered text: the stage a driver can pass
# before it can run a kernel at all, and the one that says the memory path,
# packing included, is honest. The comparison of results is on the rendered
# text too (`to_string` of the whole vector), which tells -0.0 from 0.0 and
# NaN from anything, so "identical" means bit for bit for every finite value
# and sign of zero.
#
# Every set's length is a multiple of 128, the widest kernel's tile width:
# the kernels have no mask (packages/tileir), so grid = n / width exactly,
# the width being 128 for `vadd` and `vadd_bf16` and 64 for `vadd_f32`
# (scripts/tile-golden records that one over 64-wide cells). The bf16
# sets carry Floats off the bf16 grid on purpose, in every set: the packing
# has to round them, and a packing that truncated would show in the round
# trip of every bf16 set (run.sh's pack-truncates mutant).
use std/io
use std/io.{Exit, with_fs_real}
use std/gpu
use std/gpu.{Gpu, DeviceBuffer, with_gpu_fake, with_gpu_real, reference_kernels, alloc, free,
  launch, buffer_arg, erase, sync }
use std/dtype.{Dtype, F64, dtype_name}
use std/narrow.{BF16, F32}
use std/list
use std/map
use std/narrow

type Trace = {
  alloc: String,
  upload: String,
  roundtrip: String,
  launch: String,
  sync: String,
  download: String,
  result: Option[List[Float]],
  note: String
}

fn kind[T](r: Result[T, ForeignError]) -> String =
  match r {
    Ok(_) -> "ok"
    Err(e) -> e.kind
  }

fn message[T](r: Result[T, ForeignError]) -> String =
  match r {
    Ok(_) -> ""
    Err(e) -> e.message
  }

fn blank() -> Trace =
  Trace {
    alloc= "-",
    upload= "-",
    roundtrip= "-",
    launch= "-",
    sync= "-",
    download= "-",
    result= None,
    note= ""
  }

fn release[D](ts: List[DeviceBuffer[D]]) -> Unit !Gpu = {
  for t in ts {
    let _ = free(t)
  }
}

# `xs` as a buffer of format `d` holds it.
fn held[D](d: Dtype[D], xs: List[Float]) -> List[Float] = {
  let dt = dtype_name(d)
  list.map(xs, x => gpu.round_to(dt, x))
}

## The whole vadd of format `d` through `kernel`, one stage at a time,
## stopping at the first refusal and saying which stage it was.
# The Float view of a buffer by its format's name: the corpus holds Floats
# off the format's grid on purpose (bf16 rounds them on the way in), which
# a typed `copy_from_host` of a `BF16` cannot say.
fn put[D](d: Dtype[D], t: DeviceBuffer[D], xs: List[Float]) -> Result[Unit, ForeignError] !Gpu =
  gpu.gpu_copy_from_host(gpu.handle_of(t), gpu.encode_floats(dtype_name(d), xs))

fn get[D](d: Dtype[D], t: DeviceBuffer[D]) -> Result[List[Float], ForeignError] !Gpu =
  match gpu.gpu_copy_to_host(gpu.handle_of(t)) {
    Ok(raw) -> Ok(gpu.decode_floats(dtype_name(d), raw))
    Err(e) -> Err(e)
  }

fn stages[D](d: Dtype[D], kernel: String, width: Int, xs: List[Float], ys: List[Float]) -> Trace !Gpu = {
  let n = len(xs)
  let ra = alloc(d, n)
  let rb = alloc(d, n)
  let ro = alloc(d, n)
  match (ra, rb, ro) {
    (Ok(a), Ok(b), Ok(out)) -> {
      let t0 = Trace { ..blank(), alloc= "ok" }
      let up = put(d, a, xs)
      let up2 = put(d, b, ys)
      match (up, up2) {
        (Ok(_), Ok(_)) -> {
          let t1 = Trace { ..t0, upload= "ok" }
          let back = get(d, a)
          let back2 = get(d, b)
          let rt = match (back, back2) {
            (Ok(v), Ok(w)) ->
              if to_string(v) == to_string(held(d, xs)) && to_string(w) == to_string(held(d, ys)) {
                "same"
              } else {
                "differ"
              }
            (Err(e), _) -> e.kind
            (_, Err(e)) -> e.kind
          }
          let t2 = Trace { ..t1, roundtrip= rt, note= message(back) ++ message(back2) }
          let l = launch(kernel, n / width, [erase(buffer_arg(a)), erase(buffer_arg(b)), erase(buffer_arg(out))])
          match l {
            Ok(_) -> {
              let s = sync()
              let r = get(d, out)
              release([a, b, out])
              let value = match r {
                Ok(v) -> Some(v)
                Err(_) -> None
              }
              Trace {
                ..t2,
                launch= "ok",
                sync= kind(s),
                download= kind(r),
                result= value,
                note= message(s) ++ message(r)
              }
            }
            Err(e) -> {
              release([a, b, out])
              Trace { ..t2, launch= e.kind, note= e.message }
            }
          }
        }
        _ -> {
          let bad = if kind(up) != "ok" { up } else { up2 }
          release([a, b, out])
          Trace { ..t0, upload= kind(bad), note= message(bad) }
        }
      }
    }
    _ -> {
      let bad = if kind(ra) != "ok" { ra } else if kind(rb) != "ok" { rb } else { ro }
      Trace { ..blank(), alloc= kind(bad), note= message(bad) }
    }
  }
}

## A vector as a line: whole when short, otherwise its length, its ends and
## its sum. The verdict is computed on the whole rendering either way.
fn digest(v: List[Float]) -> String = {
  let n = len(v)
  if n <= 16 {
    to_string(v)
  } else {
    let sum = list.fold(v, 0.0, (acc: Float, x: Float) => acc + x)
    "len=${n} head=${to_string(list.take(v, 4))} tail=${to_string(list.drop(v, n - 4))} sum=${sum}"
  }
}

fn rendered(o: Option[List[Float]]) -> String =
  match o {
    Some(v) -> to_string(v)
    None -> "-"
  }

fn shown(o: Option[List[Float]]) -> String =
  match o {
    Some(v) -> digest(v)
    None -> "-"
  }

## Where the real device stopped, as `<kind>@<stage>`, or "" if it did not.
fn stopped(t: Trace) -> String =
  if t.alloc != "ok" { t.alloc ++ "@alloc" }
  else if t.upload != "ok" { t.upload ++ "@upload" }
  else if t.roundtrip != "same" && t.roundtrip != "differ" { t.roundtrip ++ "@download" }
  else if t.launch != "ok" { t.launch ++ "@launch" }
  else if t.sync != "ok" { t.sync ++ "@sync" }
  else if t.download != "ok" { t.download ++ "@download" }
  else { "" }

fn verdict(fake: Trace, real: Trace) -> String = {
  let stop = stopped(real)
  if real.roundtrip == "differ" {
    "differ:roundtrip"
  } else if stop != "" {
    "blocked:" ++ stop
  } else if rendered(real.result) == rendered(fake.result) {
    "identical"
  } else {
    "differ:result"
  }
}

# `0.0 - 0.0` is +0.0; the sign comes from a product
fn neg_zero() -> Float = 0.0 * (0.0 - 1.0)

# A fixed-seed 31-bit LCG, so the random sets are the same on every run.
fn lcg(seed: Int) -> Int = (seed * 1103515245 + 12345) & 0x7FFFFFFF

# `n` pseudo-random Floats from `seed`, off the bf16 grid almost always:
# thousandths in [-100, 100).
fn random_floats(seed: Int, n: Int) -> List[Float] = {
  var out: List[Float] = []
  var r = seed
  var i = 0
  while i < n {
    r = lcg(r)
    out = out ++ [to_float(r % 200000) / 1000.0 - 100.0]
    i = i + 1
  }
  out
}

# `n` bf16 values with pseudo-random bit patterns from `seed`: every
# exponent, both signs, the infinities and NaNs included.
fn random_patterns(seed: Int, n: Int) -> List[Float] = {
  var out: List[Float] = []
  var r = seed
  var i = 0
  while i < n {
    r = lcg(r)
    out = out ++ [narrow.bf16_of_bits((r >>> 8) & 0xFFFF)]
    i = i + 1
  }
  out
}

# The four f64 sets are the first four; the three bf16 sets follow, then the
# three f32 sets.
fn dtype_of_set(i: Int) -> String = if i < 4 { "f64" } else if i < 7 { "bf16" } else { "f32" }

# The tile width of the kernel each format's sets run through.
fn width_of(dt: String) -> Int = if dt == "f32" { 64 } else { 128 }

fn input_set(i: Int) -> (List[Float], List[Float]) =
  if i == 0 {
    # small, negative and around a million
    (
      list.map(range(0, 128), k => to_float(k) * 0.5 - 32.0),
      list.map(range(0, 128), k => 1000000.0 + to_float(k))
    )
  } else if i == 1 {
    # sums that do not land on short decimals, and a negative million-scale leg
    (
      list.map(range(0, 1024), k => to_float(k * k % 977) * 0.125 - 60.0),
      list.map(range(0, 1024), k => 0.0 - to_float(k) * 1000003.0 / 7.0)
    )
  } else if i == 2 {
    # signed zeros, extremes and inexact decimals
    (
      list.map(range(0, 128), k =>
          if k == 0 { 0.0 } else if k == 1 { neg_zero() } else if k == 2 { 1.0e300 }
          else if k == 3 { 1.0e-300 } else { 0.1 * to_float(k) }),
      list.map(range(0, 128), k =>
          if k == 0 { neg_zero() } else if k == 1 { neg_zero() } else if k == 2 { 1.0e300 }
          else if k == 3 { 0.0 - 1.0e-300 } else { 0.2 * to_float(k) })
    )
  } else if i == 3 {
    # many blocks: 32 tiles of 128
    (
      list.map(range(0, 4096), k => to_float(k % 251) * 1000.0 - 125000.0),
      list.map(range(0, 4096), k => to_float(4096 - k) / 3.0)
    )
  } else if i == 4 {
    # bf16: tenths (off the grid) against halves (on it), one block
    (
      list.map(range(0, 128), k => 0.1 * to_float(k) - 6.4),
      list.map(range(0, 128), k => to_float(k) * 0.5 - 32.0)
    )
  } else if i == 5 {
    # bf16: random Floats against random bit patterns, eight blocks
    (random_floats(11, 1024), random_patterns(12, 1024))
  } else if i == 6 {
    # bf16: every one of the 65536 bit patterns, in order, against a random
    # Float, 512 blocks
    (list.map(range(0, 65536), k => narrow.bf16_of_bits(k)), random_floats(13, 65536))
  } else if i == 7 {
    # f32: the edges of binary32 in the first lanes (two sums halfway
    # between neighbours, the largest finite value doubled, the smallest
    # normal less the smallest subnormal, opposite infinities, a NaN, signed
    # zeros, two smallest subnormals), tenths off the grid in the rest, two
    # blocks of 64
    (list.map(range(0, 128), k => f32_edge_a(k)), list.map(range(0, 128), k => f32_edge_b(k)))
  } else if i == 8 {
    # f32: random Floats on both sides, sixteen blocks
    (random_floats(21, 1024), random_floats(22, 1024))
  } else {
    # f32: random binary32 bit patterns (every exponent, both signs, the
    # subnormals, infinities and NaNs included) against a random Float,
    # 1024 blocks
    (random_f32_patterns(23, 65536), random_floats(24, 65536))
  }

fn pow_two(k: Int) -> Float = {
  var q = 1.0
  var i = k
  while i > 0 {
    q = q * 2.0
    i = i - 1
  }
  while i < 0 {
    q = q * 0.5
    i = i + 1
  }
  q
}

# The largest finite binary32 value.
fn f32_max() -> Float = (2.0 - pow_two(-23)) * pow_two(127)

fn f32_edge_a(k: Int) -> Float =
  if k == 0 { 1.0 } else if k == 1 { 1.0 } else if k == 2 { f32_max() } else if k == 3 { pow_two(-126) }
  else if k == 4 { 1.0 / 0.0 } else if k == 5 { 0.0 / 0.0 } else if k == 6 { neg_zero() }
  else if k == 7 { pow_two(-149) } else { 0.1 * to_float(k) - 6.4 }

fn f32_edge_b(k: Int) -> Float =
  if k == 0 { pow_two(-24) } else if k == 1 { 3.0 * pow_two(-24) } else if k == 2 { f32_max() }
  else if k == 3 { 0.0 - pow_two(-149) } else if k == 4 { 0.0 - 1.0 / 0.0 } else if k == 5 { 1.0 }
  else if k == 6 { neg_zero() } else if k == 7 { pow_two(-149) } else { 0.3 * to_float(k) }

# `n` binary32 values with pseudo-random bit patterns from `seed`, all 32
# bits of each drawn.
fn random_f32_patterns(seed: Int, n: Int) -> List[Float] = {
  var out: List[Float] = []
  var r = seed
  var i = 0
  while i < n {
    r = lcg(r)
    let hi = r & 0xFFFF
    r = lcg(r)
    out = out ++ [narrow.f32_of_bits((hi << 16) | (r & 0xFFFF))]
    i = i + 1
  }
  out
}

fn read_cubin(path: String) -> Bytes !Exit !io = match with_fs_real(() => io.read_bytes(path)) {
  Ok(b) -> b
  Err(e) -> {
    io.eprintln("vadd_diff: cannot read ${path}: ${e.message}")
    io.exit(2)
    bytes_of_nothing()
  }
}

# `io.exit` needs a handler above it now, and this program is the only
# frame with nothing above it. `Fs` stays where it was, installed per read.
pub fn main() -> Unit !io = io.with_exit_real(() => {
  let argv = args()
  if len(argv) != 3 {
    io.eprintln("usage: vadd_diff <vadd.cubin> <vadd_bf16.cubin> <vadd_f32.cubin>")
    io.exit(2)
  }
  let kernels = map.from([("vadd", read_cubin(argv[0])), ("vadd_bf16", read_cubin(argv[1])),
    ("vadd_f32", read_cubin(argv[2]))])
  var all_identical = true
  var blocked = ""
  var any_differ = false
  for i in range(0, 10) {
    let (xs, ys) = input_set(i)
    let n = len(xs)
    let dt = dtype_of_set(i)
    let w = width_of(dt)
    let fake = if dt == "f64" {
      with_gpu_fake(reference_kernels(), () => stages(F64, "vadd", w, xs, ys))
    } else if dt == "bf16" {
      with_gpu_fake(reference_kernels(), () => stages(BF16, "vadd_bf16", w, xs, ys))
    } else {
      with_gpu_fake(reference_kernels(), () => stages(F32, "vadd_f32", w, xs, ys))
    }
    let real = if dt == "f64" {
      with_gpu_real(kernels, () => stages(F64, "vadd", w, xs, ys))
    } else if dt == "bf16" {
      with_gpu_real(kernels, () => stages(BF16, "vadd_bf16", w, xs, ys))
    } else {
      with_gpu_real(kernels, () => stages(F32, "vadd_f32", w, xs, ys))
    }
    let v = verdict(fake, real)
    io.println("set ${i} ${dt} n=${n} grid=${n / w}")
    io.println("  fake  launch=${fake.launch} result=${shown(fake.result)}")
    io.println("  real  alloc=${real.alloc} upload=${real.upload} roundtrip=${real.roundtrip}"
        ++ " launch=${real.launch} sync=${real.sync} download=${real.download}"
        ++ " result=${shown(real.result)}")
    if real.note != "" { io.println("  note  ${real.note}") }
    io.println("  verdict ${v}")
    if v != "identical" { all_identical = false }
    if v == "differ:roundtrip" || v == "differ:result" { any_differ = true }
    if blocked == "" && v != "identical" && not any_differ { blocked = v }
  }
  if all_identical {
    io.println("tile-gpu-diff: pass")
  } else if any_differ {
    io.println("tile-gpu-diff: fail")
    io.exit(1)
  } else {
    io.println("tile-gpu-diff: ${blocked}")
  }
})

# `io.exit` is typed Unit, so the branch that cannot continue still owes a
# Bytes; this is never reached.
fn bytes_of_nothing() -> Bytes = panic("unreachable: exit did not exit")

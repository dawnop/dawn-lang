-- outer panic, release swallows a panic --
  release r1
  release handled: INNER-FROM-RELEASE
outer message  OUTER-r1
-- outer panic, release swallows a fault --
  release r2
  release handled a fault
outer message  OUTER-r2
-- outer fault, release swallows a panic --
  release r3
  release handled: INNER-FROM-RELEASE
mentions path  true
-- outer fault, release swallows a fault --
  release r4
  release handled a fault
mentions path  true
-- a panic across a bracket whose release swallowed a fault --
  release r5
  release handled a fault
verdict        through

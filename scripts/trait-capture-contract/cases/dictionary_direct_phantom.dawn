# Generated callbacks retain resources and invariant cell support.
use std/mem
type PhantomAt[@s] = { n: Int }
trait Empty[T: ^{c}, ^c] { fn empty_value() -> T }
impl[@s] Empty[PhantomAt[s], ^{s}] { fn empty_value() -> PhantomAt[s] = PhantomAt { n = 0 } }
fn escaped() -> (fn() -> Int) = mem.with_mem([@s] () => {
  () => { let value: PhantomAt[s] = empty_value()
    value.n }
})
pub fn main() -> Unit !io = { let body = escaped()
  println(to_string(body())) }

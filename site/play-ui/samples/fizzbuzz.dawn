# FizzBuzz: a `for` over a range, `match` with guards, and string interpolation.

fn shout(n: Int) -> String =
  match n {
    x if x % 15 == 0 -> "FizzBuzz"
    x if x % 3 == 0 -> "Fizz"
    x if x % 5 == 0 -> "Buzz"
    x -> "${x}"
  }

pub fn main() -> Unit !io = {
  # the divisible-by-fifteen arm has to come first
  for i in 1..21 {
    println(shout(i))
  }
}

## Run a synchronous newline protocol whose state survives calls to `main`.
##
## On native and JVM targets, a session lasts for the process. On wasm, it
## lasts for one module instance, across separate calls to `dawn_turn`.
## [serve] calls `step` with `None` until an invocation returns a replacement
## state. Afterwards it supplies `Some(current_state)`. Returning `Some(next)`
## replaces the retained state only after that invocation succeeds; returning
## `None`, refusing an input, or panicking preserves the previous state.
## Optional replies are printed one per line, and `on_panic` supplies the reply
## for a caught panic.
##
## A session must use exactly one state type. Calling `serve[S]` and later
## `serve[T]` in the same process or wasm module instance is a program error:
## the installed root continues dispatching lines to the `S` step. Start a new
## process or instantiate a new wasm module to change state type.

# The three internal primitives below address one runtime root. The erased root
# never holds `S` directly: it holds the private [Root], whose closure captures
# `S` behind a fixed signature. This keeps the internal ABI type-safe even for
# the cross-instantiation program error documented above. The callbacks are
# pure as a second boundary, so application code cannot re-enter an io pump
# from inside a turn. That holds for a continuation kept in `S` and resumed
# on a later turn too: a continuation carries its remainder's io bit (spec
# §6.5 "control arms"), so a pure step can only resume one whose remainder is
# pure, and a remainder that pumps io hands out an `!io` continuation the
# step's signature does not admit.

use std/io

type Root = Root(
  advance: fn(String) -> (Option[Root], Option[String])
)

fn rooted[S](
  state: S,
  step: fn(Option[S], String) -> (Option[S], Option[String]),
) -> Root =
  Root(advance: line => {
    let (replacement, reply) = step(Some(state), line)
    let next: Option[Root] =
      match replacement {
        Some(value) -> Some(rooted(value, step))
        None -> None
      }
    (next, reply)
  })

fn first[S](
  step: fn(Option[S], String) -> (Option[S], Option[String]),
  line: String,
) -> (Option[Root], Option[String]) = {
  let (replacement, reply) = step(None, line)
  let next: Option[Root] =
    match replacement {
      Some(value) -> Some(rooted(value, step))
      None -> None
    }
  (next, reply)
}

fn advance(root: Root, line: String) -> (Option[Root], Option[String]) =
  match root { Root(run) -> run(line) }

## Read one input line, run one typed step, optionally print one reply, and
## continue to EOF.
##
## `step` sees `None` before the first successful init. Its optional first
## result is a replacement, not the current state: a failure or ordinary event
## returns `None`, preserving the root already installed by an earlier init.
## `on_panic` renders a caught application panic without receiving any state;
## the root therefore remains installed on that path too.
pub fn serve[S](
  step: fn(Option[S], String) -> (Option[S], Option[String]),
  on_panic: fn(ForeignError) -> String,
) -> Unit !io =
  match io.read_line() {
    None -> ()
    Some(line) -> {
      let current: Option[Root] =
        if reactor_state_has() { Some(reactor_state_get()) } else { None }
      let attempted = catch_panic(() =>
          match current {
            Some(root) -> advance(root, line)
            None -> first(step, line)
          }
      )
      let (replacement, reply) =
        match attempted {
          Ok(answer) -> answer
          Err(e) -> (None, Some(on_panic(e)))
        }
      match replacement {
        Some(next) -> reactor_state_set(next)
        None -> ()
      }
      match reply {
        Some(text) -> io.println(text)
        None -> ()
      }
      serve(step, on_panic)
    }
  }

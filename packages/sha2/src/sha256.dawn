# SHA-256 (FIPS 180-4), in Dawn.
#
# It is here because the package manager's content addressing -- the `d1:` tree
# hash that makes the cache trustworthy -- was reaching java.security. A hash
# is arithmetic over bytes and nothing else, so there was never a reason for it
# to be a host service; it only was because a host happened to offer one.
#
# A package rather than std: std stays the small set of things the language
# itself leans on, and nothing in the language leans on SHA-256.
#
# It is not fast: about 25 MB/s on the JVM and 30 MB/s native (2.0.1, 64 MiB
# in 2.6 s and 2.0 s), and verifying a project's dawn.lock hashes the whole
# resolved jar closure. Two ways of making it faster are closed, deliberately:
#
#   * `java.security.MessageDigest` in pkg/maven -- 150x faster, and it puts the
#     package manager's trust root back on a host service. That is the thing
#     this file exists to undo.
#   * a `sha256` runtime intrinsic -- the same objection one layer down, plus a
#     wider contract for every backend to implement.
#
# What is left is not doing the work twice, and not allocating or indexing
# a `List` while doing it. Both are fair game and both have been taken: see
# `vendored_names` in selfhost/src/main.dawn for the first, and `compress`
# and `k` below for the second. Until 2.0.1 the block, the message schedule
# and the round constants were all `List`s, about ten trie lookups per input
# byte: 1.9 MB/s native, and most of the 94 s the native `dawn add` spent
# unpacking a 234 MB zip, which it tree-hashes afterwards.
#
# The API is incremental because its caller is: a tree hash feeds one file
# after another, and a one-shot digest would make it concatenate the whole tree
# first -- quadratic in bytes copied, on the path that decides whether a
# downloaded package is the one that was asked for.
#
# Dawn's `Int` is 64-bit and signed, so every 32-bit operation ends in `& MASK`.
# The shifts are `>>>` (logical) throughout: the values are masked to 32 bits
# before they are shifted, so there is no sign bit in them to propagate.

use std/bytes
use std/char
use std/str

const MASK: Int = 0xFFFFFFFF

# The three fields are one interlocking state: `h` is always eight words, `buf`
# is always shorter than a block, and `total` counts every byte that has been
# folded in or is still sitting in `buf`. `update` and `finish` index into `h`
# and pad from `total` without rechecking any of that, so a caller who could
# assemble the record could hand them a state that is type-correct and still
# indexes out of bounds. Hence the record is private and `Digest` is opaque
# over it: the only states that exist are the ones `new` and `update` build.
type DigestState = { h: List[Int], buf: Bytes, total: Int }

## A digest in progress: the eight chaining words, the bytes of the block that
## is not full yet, and how many bytes have been fed in (the padding needs the
## total, and it is a bit count that must survive past 2^32).
pub opaque type Digest = DigestState

## Round constant `t`: the first 32 bits of the fractional part of the cube
## root of the `t`-th prime, for `t` in 0..63.
##
## A match rather than a `List` constant. A `List` read is a trie lookup plus
## reference counting, and `compress` makes 64 of them per block; on the
## native backend that alone was half of what is left of the digest's time
## once the rest stopped allocating, and cc turns this chain of integer
## comparisons into a table. On the JVM the two are the same speed.
fn k(t: Int) -> Int = match t {
  0 -> 0x428A2F98
  1 -> 0x71374491
  2 -> 0xB5C0FBCF
  3 -> 0xE9B5DBA5
  4 -> 0x3956C25B
  5 -> 0x59F111F1
  6 -> 0x923F82A4
  7 -> 0xAB1C5ED5
  8 -> 0xD807AA98
  9 -> 0x12835B01
  10 -> 0x243185BE
  11 -> 0x550C7DC3
  12 -> 0x72BE5D74
  13 -> 0x80DEB1FE
  14 -> 0x9BDC06A7
  15 -> 0xC19BF174
  16 -> 0xE49B69C1
  17 -> 0xEFBE4786
  18 -> 0x0FC19DC6
  19 -> 0x240CA1CC
  20 -> 0x2DE92C6F
  21 -> 0x4A7484AA
  22 -> 0x5CB0A9DC
  23 -> 0x76F988DA
  24 -> 0x983E5152
  25 -> 0xA831C66D
  26 -> 0xB00327C8
  27 -> 0xBF597FC7
  28 -> 0xC6E00BF3
  29 -> 0xD5A79147
  30 -> 0x06CA6351
  31 -> 0x14292967
  32 -> 0x27B70A85
  33 -> 0x2E1B2138
  34 -> 0x4D2C6DFC
  35 -> 0x53380D13
  36 -> 0x650A7354
  37 -> 0x766A0ABB
  38 -> 0x81C2C92E
  39 -> 0x92722C85
  40 -> 0xA2BFE8A1
  41 -> 0xA81A664B
  42 -> 0xC24B8B70
  43 -> 0xC76C51A3
  44 -> 0xD192E819
  45 -> 0xD6990624
  46 -> 0xF40E3585
  47 -> 0x106AA070
  48 -> 0x19A4C116
  49 -> 0x1E376C08
  50 -> 0x2748774C
  51 -> 0x34B0BCB5
  52 -> 0x391C0CB3
  53 -> 0x4ED8AA4A
  54 -> 0x5B9CCA4F
  55 -> 0x682E6FF3
  56 -> 0x748F82EE
  57 -> 0x78A5636F
  58 -> 0x84C87814
  59 -> 0x8CC70208
  60 -> 0x90BEFFFA
  61 -> 0xA4506CEB
  62 -> 0xBEF9A3F7
  _ -> 0xC67178F2
}

fn rotr(x: Int, n: Int) -> Int = ((x >>> n) | (x << (32 - n))) & MASK

## The big-endian 32-bit word at `o`.
fn word(src: Bytes, o: Int) -> Int =
  (bytes.at(src, o) << 24) | (bytes.at(src, o + 1) << 16) |
  (bytes.at(src, o + 2) << 8) | bytes.at(src, o + 3)

## A fresh digest, chained from the fractional parts of the square roots of the
## first eight primes.
pub fn new() -> Digest =
  DigestState {
    h: [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
      0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19],
    buf: bytes.utf8(""),
    total: 0
  }

## The 64-byte block at `src[o..o+64]` folded into the chaining words.
##
## The message schedule is sixteen locals, not a list. Round `t` only ever
## reads W[t] and the fifteen words after it, so a window that slides by one
## word per round holds everything the schedule needs: `w0` is W[t] and
## the next word is computed into `w15` from `w0`, `w1`, `w9` and `w14`. The
## block is read straight out of the input for the same reason: a `List` read
## is a trie lookup plus reference counting, which the file header prices.
fn compress(hs: List[Int], src: Bytes, o: Int) -> List[Int] = {
  var w0 = word(src, o)
  var w1 = word(src, o + 4)
  var w2 = word(src, o + 8)
  var w3 = word(src, o + 12)
  var w4 = word(src, o + 16)
  var w5 = word(src, o + 20)
  var w6 = word(src, o + 24)
  var w7 = word(src, o + 28)
  var w8 = word(src, o + 32)
  var w9 = word(src, o + 36)
  var w10 = word(src, o + 40)
  var w11 = word(src, o + 44)
  var w12 = word(src, o + 48)
  var w13 = word(src, o + 52)
  var w14 = word(src, o + 56)
  var w15 = word(src, o + 60)

  var a = hs[0]
  var b = hs[1]
  var c = hs[2]
  var d = hs[3]
  var e = hs[4]
  var f = hs[5]
  var g = hs[6]
  var h = hs[7]
  var t = 0
  while t < 64 {
    let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
    let ch = (e & f) ^ (~e & MASK & g)
    let t1 = (h + s1 + ch + k(t) + w0) & MASK
    let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
    let maj = (a & b) ^ (a & c) ^ (b & c)
    let t2 = (s0 + maj) & MASK
    h = g
    g = f
    f = e
    e = (d + t1) & MASK
    d = c
    c = b
    b = a
    a = (t1 + t2) & MASK
    # W[t + 16]; the last sixteen of these are computed and never read
    let m0 = rotr(w1, 7) ^ rotr(w1, 18) ^ (w1 >>> 3)
    let m1 = rotr(w14, 17) ^ rotr(w14, 19) ^ (w14 >>> 10)
    let next = (w0 + m0 + w9 + m1) & MASK
    w0 = w1
    w1 = w2
    w2 = w3
    w3 = w4
    w4 = w5
    w5 = w6
    w6 = w7
    w7 = w8
    w8 = w9
    w9 = w10
    w10 = w11
    w11 = w12
    w12 = w13
    w13 = w14
    w14 = w15
    w15 = next
    t = t + 1
  }
  [(hs[0] + a) & MASK, (hs[1] + b) & MASK, (hs[2] + c) & MASK, (hs[3] + d) & MASK,
    (hs[4] + e) & MASK, (hs[5] + f) & MASK, (hs[6] + g) & MASK, (hs[7] + h) & MASK]
}

## Feed bytes in. Any number, any number of times.
##
## Whole blocks are compressed where they lie in `b`; only a block that
## straddles two calls is copied, once, to join its halves.
pub fn update(d: Digest, b: Bytes) -> Digest = {
  # opacity is seen through by assignment, not by `.` (spec 2.7), so the state
  # is named once here and the fields are read off that
  let state: DigestState = d
  var hs = state.h
  let n = bytes.len(b)
  var i = 0
  let held = bytes.len(state.buf)
  if held > 0 {
    let need = 64 - held
    if n < need {
      return DigestState { h: hs, buf: state.buf ++ b, total: state.total + n }
    }
    hs = compress(hs, state.buf ++ bytes.slice(b, 0, need), 0)
    i = need
  }
  while n - i >= 64 {
    hs = compress(hs, b, i)
    i = i + 64
  }
  DigestState { h: hs, buf: bytes.slice(b, i, n), total: state.total + n }
}

## The digest as 64 lower-case hex digits. The state is not consumed -- it is a
## value, so `finish` can be called on a prefix and feeding can go on.
pub fn finish(d: Digest) -> String = {
  # see `update`: the fields come off an explicitly typed binding, not off `d`
  let state: DigestState = d
  # the 0x80 byte, zeros up to 56 bytes into a block, then the bit count
  var block = bytes.put(bytes.put_bytes(bytes.buf(), state.buf), 0x80)
  while bytes.size(block) % 64 != 56 { block = bytes.put(block, 0) }
  let bits = state.total * 8
  var s = 56
  while s >= 0 {
    block = bytes.put(block, (bits >>> s) & 0xFF)
    s = s - 8
  }
  let tail = bytes.freeze(block)
  var hs = state.h
  var off = 0
  while off < bytes.len(tail) {
    hs = compress(hs, tail, off)
    off = off + 64
  }
  var out = ""
  for hw in hs {
    out = out ++ word_hex(hw)
  }
  out
}

## The digest of `b` alone.
pub fn hex(b: Bytes) -> String = finish(update(new(), b))

fn word_hex(w: Int) -> String = {
  var out = ""
  var shift = 28
  while shift >= 0 {
    out = out ++ digit((w >>> shift) & 0xF)
    shift = shift - 4
  }
  out
}

# `char.code` in, `char.of` out: `Char` is opaque over `Int` outside std/char,
# so a digit table walked by adding an offset converts at both ends. `v` is a
# nibble, so the answer is always one of `0-9a-f`.
fn digit(v: Int) -> String = {
  let n = if v < 10 { char.code('0') + v } else { char.code('a') + v - 10 }
  str.from_char(char.of(n).expect("a hex digit"))
}

# The known answers are FIPS 180-2's own examples, not another implementation's
# output: an oracle that is a second implementation can only certify agreement.
# They are exhaustive on nothing, though: the padding arithmetic is where the
# length matters, and sweeping every length across a block boundary against a
# second implementation is the missing half. `scripts/sha2-contract` never was.
test "the FIPS 180-2 vectors" {
  assert hex(bytes.utf8("")) ==
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  assert hex(bytes.utf8("abc")) ==
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
  assert hex(bytes.utf8("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")) ==
    "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
}

test "feeding in pieces is feeding the same bytes" {
  # the split lands inside a block and the total crosses one, so this exercises
  # both the buffer and the carry
  let whole = bytes.utf8("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
  var d = new()
  d = update(d, bytes.slice(whole, 0, 5))
  d = update(d, bytes.slice(whole, 5, 6))
  d = update(d, bytes.slice(whole, 6, 40))
  d = update(d, bytes.slice(whole, 40, bytes.len(whole)))
  assert finish(d) == hex(whole)
}

test "a block may straddle any number of updates" {
  # `update` compresses whole blocks where they lie and copies only a block
  # split across calls; every split point of 130 bytes, fed as two or as three
  # pieces, has to land on the one-shot digest
  var raw = bytes.buf()
  var i = 0
  while i < 130 {
    raw = bytes.put(raw, (i * 7 + 3) & 0xFF)
    i = i + 1
  }
  let all = bytes.freeze(raw)
  let want = hex(all)
  # Python's hashlib (OpenSSL) on the same 130 bytes
  assert want == "4d5e47a2e8510a314576c238f6ff19d389d3ef3aaaca8b2e530263a5d15741da"
  var cut = 0
  while cut <= 130 {
    let two = update(update(new(), bytes.slice(all, 0, cut)), bytes.slice(all, cut, 130))
    assert finish(two) == want
    let mid = (cut + 130) / 2
    let three = update(update(update(new(), bytes.slice(all, 0, cut)),
      bytes.slice(all, cut, mid)), bytes.slice(all, mid, 130))
    assert finish(three) == want
    cut = cut + 1
  }
}

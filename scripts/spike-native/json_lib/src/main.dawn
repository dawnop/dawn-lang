# A real library through both backends.
#
# Every other corpus entry is a single file written for this harness, which
# means the harness has only ever seen code written by someone who knew what
# it was testing. This one is `packages/json` -- written for its own sake,
# before the C backend existed -- driven from the outside.
#
# It is also the only way to reach the cursor family, which the single-file
# corpus cannot: those intrinsics are `internal`, so only std may name them,
# and std reaches them through `std/cursor`. A JSON lexer is nothing but a
# cursor walk, and it is where UTF-8 (native) and UTF-16 (JVM) positions
# would disagree if the opaque `Cursor` were leaking its representation --
# the surrogate pair below is there to say so.
#
# Number cases below pin the package policy through both backends. The `bits`
# labels came from an independent Python oracle:
# `struct.pack(">d", float(decimal_text)).hex()`. Dawn cannot bit-cast a Float,
# so each line also exposes the rounded value (and, for zero, its reciprocal)
# to make the labelled bit pattern observable rather than decorative.
#
# One line of the expectation pins something the language does not promise:
# the key order of a two-key object is std/hamt's iteration order. That is
# fair to hold the *backends* to -- they compile one HAMT -- but it is not a
# spec guarantee, so change the trie and this line changes with it.
use std/io
use json/parser
use json/render
use json/value.{JInt, JNum, error_text}

fn round(label: String, src: String) -> Unit !io =
  match parser.parse(src) {
    Ok(j) -> io.println(label ++ " = " ++ render.render(j))
    Err(e) -> io.println(label ++ " ! " ++ error_text(e))
  }

fn exact_int(label: String, src: String, expected: Int) -> Unit !io =
  match parser.parse(src) {
    Ok(JInt(v)) ->
      io.println(label ++ " = JInt " ++ to_string(v) ++ " exact=" ++ to_string(v == expected))
    Ok(j) -> io.println(label ++ " = wrong-kind " ++ render.render(j))
    Err(e) -> io.println(label ++ " ! " ++ error_text(e))
  }

fn rounded_float(label: String, bits: String, src: String, expected: Float) -> Unit !io =
  match parser.parse(src) {
    Ok(JNum(v)) ->
      io.println(label ++ " = bits=" ++ bits ++ " value=" ++ to_string(v) ++
          " exact=" ++ to_string(v == expected))
    Ok(j) -> io.println(label ++ " = wrong-kind " ++ render.render(j))
    Err(e) -> io.println(label ++ " ! " ++ error_text(e))
  }

fn underflow_zero(label: String, bits: String, src: String, negative: Bool) -> Unit !io =
  match parser.parse(src) {
    Ok(JNum(v)) -> {
      let reciprocal = 1.0 / v
      let sign_ok = if negative { reciprocal < 0.0 } else { reciprocal > 0.0 }
      io.println(label ++ " = bits=" ++ bits ++ " value=" ++ to_string(v) ++
          " reciprocal=" ++ to_string(reciprocal) ++
          " exact=" ++ to_string(v == 0.0 && sign_ok))
    }
    Ok(j) -> io.println(label ++ " = wrong-kind " ++ render.render(j))
    Err(e) -> io.println(label ++ " ! " ++ error_text(e))
  }

pub fn main() -> Unit !io = {
  round("scalars", "[null, true, false]")
  round("strings", "[\"a\", \"\", \"quote\\\"in\", \"tab\\tsep\"]")
  round("unicode", "[\"中文\", \"e\\u00e9\", \"\\ud834\\udd1e\"]")
  round("nested", "{\"k\": {\"inner\": [\"x\"]}, \"z\": []}")
  round("spaces", "  {  \"a\" :  [ true ]  }  ")
  round("bad", "{\"a\": }")
  round("truncated", "[\"unterminated")

  exact_int("integer-2^53+1", "9007199254740993", 9007199254740993)
  rounded_float("fraction-2^53+1", "4340000000000000", "9007199254740993.0",
    9007199254740992.0)
  rounded_float("tie-even-down", "3ff0000000000000",
    "1.00000000000000011102230246251565404236316680908203125", 1.0)
  rounded_float("tie-even-up", "3ff0000000000002",
    "1.00000000000000033306690738754696212708950042724609375", 1.0000000000000004)
  underflow_zero("underflow-positive", "0000000000000000", "1e-400", false)
  underflow_zero("underflow-negative", "8000000000000000", "-1e-400", true)
  rounded_float("maximum-finite", "7fefffffffffffff", "1.7976931348623157e308",
    1.7976931348623157e308)
  round("overflow", "1e400")
}

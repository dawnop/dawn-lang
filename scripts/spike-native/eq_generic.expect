-- Option[T] over a scalar --
same_opt(Some(3), Some(3)): yes
same_opt(Some(3), Some(4)): no
same_opt(None, Some(3))   : no
same_opt(None, None)      : yes
-- Option[T] must honour T's impl --
same_opt(Some(m1), Some(m2)): yes
same_opt(Some(m1), Some(m3)): no
-- two parameters --
same_pair(Pair(1, m1), Pair(1, m2)): yes
same_pair(Pair(1, m1), Pair(2, m1)): no
-- nested --
same_opt_opt(Some(Some(m1)), Some(Some(m2))): yes
same_opt_opt(Some(Some(m1)), Some(None))    : no

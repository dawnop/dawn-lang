## ADT ids declared by `cls` (and not yet emitted), in id order.
fn own_adts_of(adts: Adts, cls: String, seen: Set[String]) -> List[Int] = {
  var out: List[Int] = []
  for aid in sort(map.keys(adts)) {
    let a = adt_of(adts, aid)
    let is_own = match a.owner {
      Some(o) -> o == cls
      None -> false
    }
    if is_own && not set.has(seen, adt_jvm_name(a)) { out = out ++ [aid] }
  }
  out
}

## Trait ids declared by `cls`, in id order.
fn own_trait_ids(traits: Traits, cls: String) -> List[Int] = {
  var out: List[Int] = []
  for tid in sort(map.keys(traits)) {
    let is_own = match trait_of(traits, tid).owner {
      Some(o) -> o == cls
      None -> false
    }
    if is_own { out = out ++ [tid] }
  }
  out
}

## Add a prelude trait to the set whose interface the program needs. Ord is
## unconditional and its methods are reached by name, so it is never wanted
## here; a user trait's interface comes from the module that declares it.
##
## Read off `prelude_trait_ids()` rather than transcribed. The transcription
## was the sixth copy of the prelude set and the one #119 missed when it
## collapsed the other five, which is a worse miss than it looks: forgetting a
## trait here is not a compile error but a `NoClassDefFoundError` at run time,
## because the dictionary class implements an interface nobody emitted.
fn want_iface(wants: List[Int], tid: Int) -> List[Int] = {
  if tid == ORD_ID { return wants }
  var prelude = false
  for p in prelude_trait_ids() {
    if p == tid { prelude = true }
  }
  if not prelude { return wants }
  for w in wants {
    if w == tid { return wants }
  }
  wants ++ [tid]
}

## Whether any module of the program imports the named Java class.
fn imports_java(cx0: Cx, fqcn: String) -> Bool = {
  for pr in map.entries(cx0.java_classes) {
    let (_simple, name) = pr
    if name == fqcn { return true }
  }
  false
}

## Whether ASM will be on the built program's class path.
##
## `dawn/rt/Asm` names `org/objectweb/asm/ClassWriter`, which no ordinary
## program has -- and emitting a class that references an absent type into
## every program is a cost paid by everyone for a class only the compiler
## itself can use. A module that imports `ClassWriter` is exactly a program
## whose class path carries ASM, because `use java` does not resolve
## otherwise. The compiler is such a program (emit/codegen/rtclasses/testrun
## all import it), and since phase 2 it is also the only program that calls
## the adapters -- so the trigger stays exactly as wide as it needs to be.
fn program_has_asm(std_mods: List[(String, Cx, TModule, CtOut)], mods: List[CheckedMod]) -> Bool = {
  for sm in std_mods {
    let (_cls, cx0, _tm, _ct) = sm
    if imports_java(cx0, "org.objectweb.asm.ClassWriter") { return true }
  }
  for cm in mods {
    if imports_java(cm.cx, "org.objectweb.asm.ClassWriter") { return true }
  }
  false
}

## The platform's class-path separator — ':' on Unix, ';' on Windows.
##
## `dawn --help` has said "platform path separator" since the beginning while
## every split and join in this file hardcoded ':'. On Windows that tears
## `C:\lib\a.jar` in half at the drive letter, and the halves are then two
## nonexistent class-path entries. java.io.File already knows the answer, so
## nothing here has any business guessing it.
fn path_sep() -> String !io = File.pathSeparator!

## Write one class file, reporting the first I/O failure instead of hiding it.
##
## Both java_try results used to be discarded. A full disk, a read-only output
## directory or a path the filesystem rejects then produced no message at all:
## the build "succeeded" with classes missing, and the failure resurfaced much
## later as a NoClassDefFoundError naming something the user never wrote — or
## did not resurface, and shipped a jar with a hole in it. The path and the real
## exception are both worth having at the moment they are known.
fn write_class(dir: String, name: String, bs: Bytes) -> Result[Unit, String] !io = {
  let path = dir ++ "/" ++ name ++ ".class"
  let parent = match str.last_index_of(path, "/") {
    Some(i) -> str.take(path, i)
    None -> dir
  }
  match io.mkdirs(parent) {
    Err(m) -> Err("cannot create " ++ parent ++ ": " ++ m.message)
    Ok(_) ->
      match io.write_bytes(path, bs) {
        Err(m) -> Err("cannot write " ++ path ++ ": " ++ m.message)
        Ok(_) -> Ok(())
      }
  }
}

## Full program emission — shared runtime, prelude ADTs, every std and user
## module class, vendored rt — in a stable order, plus the entry class name
## ("" when no user module declares `fn main`) and, per module with test
## blocks, (class name, module path, test names) in run order. Without a
## target: the runtime subset only.
##
## `std_tests` is `dawn test --stdlib`: the bundled std's own test blocks are
## lowered and emitted, and they are what gets reported. It is off everywhere
## else, so a `dawn build` of a user program carries no std test body — the
## std modules are lowered without them, exactly as before.
fn collect_program(
  target: String,
  std_dir: String,
  opts: CtOpts,
  closure: Bool,
  std_tests: Bool
) -> (List[(String, Bytes)], String, List[(String, String, List[String])]) !io = {
  var classes: List[(String, Bytes)] = []
  var adts = prelude_adts()
  var mods: List[CheckedMod] = []
  var std_mods: List[(String, Cx, TModule, CtOut)] = []
  if target != "" || std_tests {
    if target != "" {
      if not io.exists(target) {
        cli_error("no such file or directory: " ++ target)
      }
      if io.exists(target) && not io.is_dir(target) && not str.ends_with(target, ".dawn") {
        cli_error("source files must end in .dawn: " ++ target)
      }
    }
    let std = match load_std(std_dir) {
      Ok(sc) -> sc
      Err(e) -> panic("cannot load std from " ++ std_dir ++ ": " ++ e)
    }
    std_mods = std.mods
    for pr in map.entries(std.adts) {
      let (k, v) = pr
      adts = map.insert(adts, k, v)
    }
    # --closure: seed from the entry and follow its use edges only, instead of
    # loading everything under src/ (module-access-design 2.2). The full-load
    # default stays: unreferenced modules still check, which is bit-rot
    # protection worth keeping as the default.
    if target != "" {
      let loaded =
        if closure && io.is_dir(target) {
          let entry_file = target ++ "/src/main.dawn"
          if not io.exists(entry_file) {
            cli_error("--closure needs an entry module (expected " ++ entry_file ++ ")")
          }
          load_file(entry_file)
        } else if io.is_dir(target) {
          load_directory(target)
        } else {
          load_file(target)
        }
      let prog = analyze_program(loaded, std, opts, jsig_real())
      if len(prog.diags) > 0 { fail_compile(prog.diags) }
      mods = prog.modules
    }
    for cm in mods {
      for pr in map.entries(cm.cx.adts) {
        let (k, v) = pr
        adts = map.insert(adts, k, v)
      }
    }
  }
  # The hierarchy every frame-computing writer answers from. Built once, here,
  # because it is a fact about the whole program: `adts` is complete at this
  # point and every class below is emitted against the same table.
  let sup = supers_of(adts, sort(map.keys(adts)))
  var n = 0
  while n <= 8 {
    classes = classes ++ [(fn_iface(n), gen_fn_interface(n))]
    n = n + 1
  }
  n = 2
  while n <= 8 {
    classes = classes ++ [(tuple_class(n), gen_tuple_class(sup, n))]
    n = n + 1
  }
  classes = classes ++ [(PANIC_CLASS, gen_panic_class())]
  classes = classes ++ [(UNIT_CLASS, gen_unit_class())]
  classes = classes ++ [(SHOW_CLASS, gen_show_class(sup))]
  # dawn/rt/Strings is emitted further down: which Unicode tables it carries
  # depends on what the user's modules can reach, and answering that needs
  # the program tables built below
  classes = classes ++ [(BYTES_CLASS, gen_bytes_class(sup))]
  classes = classes ++ [(ARRAY_CLASS, gen_array_class(sup))]
  classes = classes ++ [(IO_CLASS, gen_io_class(sup))]
  # The five ASM null adapters, from tree source: every emitter drives its
  # ClassWriter through them (jvm-base-plan §5.7). Conditional because the
  # class names ASM types -- see program_has_asm.
  if program_has_asm(std_mods, mods) {
    classes = classes ++ [(ASM_CLASS, gen_asm_class())]
    # The frame half of the same story: a ClassWriter subclass answering the
    # common-superclass question from the compiler's own hierarchy, which is
    # what COMPUTE_FRAMES needs and what Dawn source cannot express. Since
    # K-A8.2 every writer below is one of these and every `match` on an ADT
    # reaches the callback -- see gen_asm_writer_class, and
    # scripts/asm-adapter-contract for the differential against the reference.
    classes = classes ++ [(ASM_WRITER_CLASS, gen_asm_writer_class())]
  }
  classes = classes ++ [(tr_iface(None, "Ord"), gen_ord_interface(sup))]
  classes = classes ++ [(FN_CMP_CLASS, gen_fn_comparator(sup))]
  for aid in [OPTION_ID, RESULT_ID, FOREIGN_ERROR_ID] {
    classes = classes ++ gen_adt(sup, adts, adt_of(adts, aid), no_override())
  }
  # program-wide tables for module emission: traits/impls/fn sigs unioned
  # over std and user modules (ids are unique program-wide)
  var traits: Traits = map.empty()
  var impl_table: Impls = map.empty()
  var prog_fns: Map[(String, String), Sig] = map.empty()
  for sm in std_mods {
    let (cls, cx, _, _) = sm
    for pr in map.entries(cx.traits) {
      let (k, v) = pr
      traits = map.insert(traits, k, v)
    }
    for pr in map.entries(cx.impl_table) {
      let (k, v) = pr
      impl_table = map.insert(impl_table, k, v)
    }
    for pr in map.entries(cx.fns) {
      let (k, v) = pr
      prog_fns = map.insert(prog_fns, (cls, k), v)
    }
  }
  for cm in mods {
    for pr in map.entries(cm.cx.traits) {
      let (k, v) = pr
      traits = map.insert(traits, k, v)
    }
    for pr in map.entries(cm.cx.impl_table) {
      let (k, v) = pr
      impl_table = map.insert(impl_table, k, v)
    }
    for pr in map.entries(cm.cx.fns) {
      let (k, v) = pr
      prog_fns = map.insert(prog_fns, (cm.class_name, k), v)
    }
  }
  # The prelude Eq/Hash/Show trait *interfaces*, and only where a dictionary of
  # that trait can exist -- a program with no `[T: Eq]` carries no Eq
  # machinery. The dictionaries themselves are no longer built here: lowering
  # registers exactly the ones it referenced and emit_module writes those, so
  # this scan survives only for the interfaces, which have no Core
  # representation of their own. (Ord's is unconditional, above.)
  var wants: List[Int] = []
  for pr in map.entries(prog_fns) {
    let (_k, sg) = pr
    # a trait method's own bound on its subject is the declaration, not a use:
    # `eq` is declared `[T: Eq]` and is in every module's fn namespace
    if sg.trait_id != None { continue }
    var i = 0
    for _tp in sg.tparams {
      for b in bounds_of(sg, i) {
        wants = want_iface(wants, b)
      }
      i = i + 1
    }
  }
  # A conditional impl is the other way a dictionary appears: its own
  # dictionary class implements the trait's interface, and the arguments it
  # is built from implement the interfaces its bounds name. A program can
  # reach both without any function ever carrying a bound.
  for pr in map.entries(impl_table) {
    let (_k, imp) = pr
    if len(imp.tparams) == 0 { continue }
    wants = want_iface(wants, imp.trait_id)
    for cs in imp.constraints {
      for b in cs {
        wants = want_iface(wants, b)
      }
    }
  }
  for tid in wants {
    let tr = trait_of(traits, tid)
    classes = classes ++ [(tr_iface(None, tr.name), gen_trait_interface(sup, adts, tr))]
  }

  # Every module's Core, lowered once. `reach` reads it below and emit_module
  # reads it further down -- the same value, not two lowerings that are
  # asserted to agree (docs/audit/re-audit-2026-07-30.md RC-04). Test blocks
  # ride along for the user's modules only, because only those are emitted --
  # unless `dawn test --stdlib` asked for std's, in which case there is no
  # user module and std's are the whole program.
  var std_lm: List[lower.LMod] = []
  for sm in std_mods {
    let (cls, _cx2, tm2, _ct2) = sm
    std_lm = std_lm ++
      [lower.lower_module_full(cls, tm2, traits, impl_table, adts, prog_fns, std_tests)]
  }
  var user_lm: List[lower.LMod] = []
  for cm in mods {
    user_lm = user_lm ++
      [lower.lower_module_full(cm.class_name, cm.tm, traits, impl_table, adts, prog_fns, true)]
  }

  # Which Unicode tables dawn/rt/Strings carries: what the user's modules can
  # reach decides (reach.dawn). Without a target there is no program to reason
  # from, so the runtime-only jar carries everything.
  #
  # `emitted_core`, not `.m`: this path emits the test blocks too, and a table
  # a test alone reaches has to ride or that test dies on a missing method.
  var tuse = reach.all_tables()
  if target != "" {
    var cmods: List[CModule] = []
    var reach_roots: List[String] = []
    for l in std_lm { cmods = cmods ++ [lower.emitted_core(l)] }
    for l in user_lm {
      cmods = cmods ++ [lower.emitted_core(l)]
      reach_roots = reach_roots ++ [l.m.owner]
    }
    tuse = reach.table_use(cmods, reach_roots)
  }
  classes = classes ++ [(STRINGS_CLASS, gen_strings_class(sup, tuse))]

  # const values by declaring module, so importers can materialize them
  var const_vals: Map[String, Map[String, CValue]] = map.empty()
  for sm in std_mods {
    let (cls, _, _, ct) = sm
    const_vals = map.insert(const_vals, cls, ct.consts)
  }
  for cm in mods { const_vals = map.insert(const_vals, cm.mod_path, cm.ct.consts) }
  var seen: Set[String] = set.empty()
  var si = 0
  for sm in std_mods {
    let (cls, cx, tm, ct) = sm
    classes = classes ++ emit_module(sup, adts, traits, impl_table, prog_fns, cls,
      own_trait_ids(cx.traits, cls), own_adts_of(cx.adts, cls, seen),
      tm, std_lm[si], ct, cdriver.merged_consts(cx, ct, const_vals))
    si = si + 1
    for aid in own_adts_of(cx.adts, cls, seen) {
      seen = set.insert(seen, adt_jvm_name(adt_of(cx.adts, aid)))
    }
  }
  var entry = ""
  var tests_info: List[(String, String, List[String])] = []
  if std_tests {
    for sm in std_mods {
      let (cls, _cx3, tm3, _ct3) = sm
      if len(tm3.tests) > 0 {
        var names: List[String] = []
        for tf in tm3.tests { names = names ++ [tf.name] }
        tests_info = tests_info ++ [(cls, cls, names)]
      }
    }
  }
  var ui = 0
  for cm in mods {
    classes = classes ++ emit_module(sup, adts, traits, impl_table, prog_fns,
      cm.class_name, own_trait_ids(cm.cx.traits, cm.class_name),
      own_adts_of(cm.cx.adts, cm.class_name, seen), cm.tm, user_lm[ui], cm.ct,
      cdriver.merged_consts(cm.cx, cm.ct, const_vals))
    ui = ui + 1
    for aid in own_adts_of(cm.cx.adts, cm.class_name, seen) {
      seen = set.insert(seen, adt_jvm_name(adt_of(cm.cx.adts, aid)))
    }
    if entry == "" {
      for tf in cm.tm.fns {
        let plain = match tf.impl_of { Some(_) -> false None -> match tf.default_of { Some(_) -> false None -> true } }
        if plain && tf.name == "main" { entry = cm.class_name }
      }
    }
    if len(cm.tm.tests) > 0 {
      var names: List[String] = []
      for tf in cm.tm.tests { names = names ++ [tf.name] }
      tests_info = tests_info ++ [(cm.class_name, cm.mod_path, names)]
    }
  }
  for outer in vendor.vendored_outers() {
    classes = classes ++ vendor.rt_class_family(outer)
  }
  (classes, entry, tests_info)
}

## The JVM this process is running on, not whatever `java` PATH resolves to.
##
## Both spawns below continue this run -- one re-execs the same invocation with
## more class path, the other runs the classes this process just emitted -- so
## the JVM that answers should be the one the build chose. It was not: it was
## whatever came first on PATH, which on a machine with a newer JDK installed
## beside the one JAVA_HOME names is a different runtime, silently. That gap is
## measurable rather than theoretical -- a JDK 21 and a JDK 26 disagree about
## 18 code points, which is why the case tables were moved into the compiler in
## the first place (dawn_rt.h's note on dawn_case_range).
##
## `java.home` is the running JVM's own home and is always set, so there is no
## fallback worth arguing about: with it missing the process is not on a JVM.
fn host_java() -> String !io =
  match System.getProperty("java.home") {
    Some(h) -> h ++ "/bin/java"
    None -> "java"
  }

fn host_classpath() -> String !io =
  match System.getProperty("java.class.path") {
    Some(s) -> s
    None -> ""
  }

## The toolchain's own help text. It began as the Kotlin cli/Main.kt USAGE
## copied verbatim, and inherited that file's habit of appending each new
## subcommand at the bottom of the list -- which left two entries stranded
## from their descriptions. Continuation lines are the ones starting with 39
## spaces: keep every one of them directly under the entry it describes.
fn usage() -> String = join([
  "dawn — the Dawn language toolchain",
  "",
  "A <target> is a single .dawn file or a project directory (src/main.dawn entry).",
  "A project directory may carry a dawn.toml declaring [java-deps]; run/test/build fetch",
  "those from Maven and put them on the class path automatically.",
  "",
  "usage:",
  "  dawn run <target>                    compile and run (in-process JVM)",
  "  dawn test <target>                   compile with test blocks and run them",
  "  dawn test --stdlib                   run the bundled standard library's own test blocks",
  "  dawn build <target> [-o out.jar]     produce an executable jar (tests stripped)",
  "  dawn build <target> --native [-o out]",
  "                                       produce a standalone native binary (needs native-image)",
  "  dawn run/test/build ... --closure    load only the entry's use closure (default: all of src/)",
  "  dawn fmt <file.dawn | dir>...        format files in place (a dir formats all .dawn under it)",
  "  dawn fmt --check <target>...         report files that are not formatted (exit 1 if any)",
  "  dawn doc <target>                    emit the pub API (## doc comments) as JSON on stdout",
  "  dawn doc --stdlib                    emit the standard library reference (the prelude, its",
  "                                       traits, and every std module) as JSON",
  "  dawn doc --builtins                  emit the builtin function reference as JSON",
  "  dawn add <spec> [--subdir <p>] [--as <alias>] [--dir <project>]",
  "                                       add a dependency to dawn.toml, preserving the file's",
  "                                       formatting: a Maven coordinate (group:artifact:version",
  "                                       → [java-deps]), an archive url (fetched and hashed",
  "                                       → [deps.<name>]), or a local package path (→ [deps])",
  "  dawn cache verify                    re-hash every cached package against its name",
  "  dawn lock [--check] [<dir>]          freeze (or verify) the resolved [java-deps] closure",
  "  dawn --version                       print the toolchain version and commit",
  "",
  "options (run/test/build):",
  "  --cp <jars>                          third-party jars for `use java`, separated by the",
  "                                       platform path separator; repeatable. `build` records",
  "                                       them in the jar manifest's Class-Path. Merged with",
  "                                       anything dawn.toml's [java-deps] resolves to.",
  "  --comptime-ffi                       let a const or comptime block fold a `use java` call by",
  "                                       invoking it inside the compiler. Off by default: that is",
  "                                       running the compiled source's code on this machine, so it",
  "                                       is yours to grant, not the source's to take.",
  "",
  "environment:",
  "  DAWN_MAVEN_MIRROR                    Maven repository to fetch [java-deps] from",
  "                                       (default: Maven Central)"
], "\n") ++ "\n"

## `--comptime-fuel N` / `--comptime-fuel=N` and `--comptime-ffi`;
## (options, args without the flags).
fn extract_ct_opts(rest: List[String]) -> (CtOpts, List[String]) !io = {
  var fuel = DEFAULT_FUEL
  var ffi = false
  var out: List[String] = []
  var i = 0
  while i < len(rest) {
    let a = rest[i]
    if a == "--comptime-fuel" && i + 1 < len(rest) {
      match parse_int(rest[i + 1]) {
        Some(n) -> { fuel = n }
        None -> { cli_error("--comptime-fuel needs a number") }
      }
      i = i + 2
    } else if str.starts_with(a, "--comptime-fuel=") {
      match parse_int(str.strip_prefix(a, "--comptime-fuel=").unwrap_or(a)) {
        Some(n) -> { fuel = n }
        None -> { cli_error("--comptime-fuel needs a number") }
      }
      i = i + 1
    } else if a == "--comptime-ffi" {
      ffi = true
      i = i + 1
    } else {
      out = out ++ [a]
      i = i + 1
    }
  }
  # this main runs on a JVM, so a granted `--comptime-ffi` gets the real
  # reflective hook; a main without a host would leave the refusing default
  (CtOpts { fuel: fuel, ffi: ffi, jcall: fold_call }, out)
}

## `--cp <jars>` / `--cp=jars`; repeatable, `:`-separated, every entry must
## exist; (jars, args without the flag).
fn extract_cp(rest: List[String]) -> (List[String], List[String]) !io = {
  var jars: List[String] = []
  var out: List[String] = []
  var i = 0
  while i < len(rest) {
    let a = rest[i]
    var spec = ""
    if a == "--cp" && i + 1 < len(rest) {
      spec = rest[i + 1]
      i = i + 2
    } else if a == "--cp" {
      cli_error("--cp needs a path")
      i = i + 1
    } else if str.starts_with(a, "--cp=") {
      spec = str.strip_prefix(a, "--cp=").unwrap_or(a)
      i = i + 1
    } else {
      out = out ++ [a]
      i = i + 1
    }
    if spec != "" {
      for pth in str.split(spec, path_sep()) {
        if pth != "" {
          if not io.exists(pth) { cli_error("--cp entry not found: " ++ pth) }
          jars = jars ++ [pth]
        }
      }
    }
  }
  (jars, out)
}

## Render compile diagnostics, the count line, and exit 1 (the Kotlin
## compileProject failure shape).
fn fail_compile(diags: List[LocDiag]) -> Unit !io = {
  var pairs: List[(String, Diag)] = []
  for ld in diags { pairs = pairs ++ [(ld.path, ld.d)] }
  io.eprint(diag.render_all(pairs))
  io.eprintln(diag.count_line(len(diags)))
  let _ = io.exit(1)
  ()
}

## Render diagnostics without the count line and exit 1 (the Kotlin cmdDoc
## failure shape).
fn fail_doc(diags: List[LocDiag]) -> Unit !io = {
  var pairs: List[(String, Diag)] = []
  for ld in diags { pairs = pairs ++ [(ld.path, ld.d)] }
  io.eprint(diag.render_all(pairs))
  let _ = io.exit(1)
  ()
}

## Print the Kotlin CLI's error shape and exit 2.
## Refuse a second bare positional.
##
## `target = rest[i]` in a bare `else` made every one of these subcommands take
## the *last* target on the line and say nothing about the others, so a typo'd
## flag (`dawn build proj -0 out`) built `out` -- a real directory name to the
## loop -- and reported success. run takes a second positional on purpose (it
## forwards the rest to the program), which is why it is not here.
fn refuse_second_target(cmd: String, have: String, got: String) -> Unit !io =
  if have != "" {
    cli_error(cmd ++ " takes one target, got `" ++ have ++ "` and `" ++ got ++
        "`; a bare word after the target is not a flag this subcommand knows")
  }

fn cli_error(msg: String) -> Unit !io = {
  io.eprintln("error: " ++ msg)
  let _ = io.exit(2)
  ()
}

## `dawn cache verify` — re-hash every entry in the package cache and compare
## it with the hash its directory name claims (PKG-02's companion command:
## the per-use check catches the entry a build touches, this sweeps them all).
fn run_cache(rest: List[String]) -> Unit !io = {
  if len(rest) != 1 || rest[0] != "verify" {
    return cli_error("usage: dawn cache verify")
  }
  let root = pkgfetch.cache_root()
  let names = match io.list_dir(root) {
    Ok(ns) -> ns
    Err(_) -> {
      println("cache is empty (" ++ root ++ ")")
      return ()
    }
  }
  var checked = 0
  var bad = 0
  for n in sort(names) {
    if str.starts_with(n, "d1-") {
      let hash = str.replace(n, "d1-", "d1:")
      checked = checked + 1
      match pkgfetch.verify_cached(root ++ "/" ++ n, hash) {
        Ok(_) -> println("ok   " ++ n)
        Err(e) -> {
          println("BAD  " ++ n)
          io.eprintln(e)
          bad = bad + 1
        }
      }
    }
  }
  println(to_string(checked) ++ " entr" ++ (if checked == 1 { "y" } else { "ies" }) ++
      " checked, " ++ to_string(bad) ++ " bad")
  if bad > 0 { let _ = io.exit(1) }
}

## `selfhost __pkghash <dir>` — the d1 canonical tree hash (dawn __pkghash).
fn run_pkghash(rest: List[String]) -> Unit !io = {
  let dir = if len(rest) > 0 { rest[0] } else { "." }
  if not io.is_dir(dir) { return cli_error("not a directory: " ++ dir) }
  match pkgfetch.tree_hash(dir) {
    Ok(h) -> println(h)
    Err(e) -> cli_error(e)
  }
}

# ---- [java-deps]: resolve once, then re-exec with the jars on the class path
# (the checker's `use java` reflection reads the system class path; the Kotlin
# CLI swaps in a URLClassLoader instead, which reflection here cannot do) ----

## Pull a boolean `--flag` out of an argument list.
fn extract_flag(rest: List[String], flag: String) -> (Bool, List[String]) = {
  var found = false
  var out: List[String] = []
  for a in rest {
    if a == flag { found = true } else { out = out ++ [a] }
  }
  (found, out)
}

## The positional target: the first token no known `--flag value` pair claims.
fn peek_target(rest: List[String]) -> String = {
  var i = 0
  while i < len(rest) {
    let a = rest[i]
    if a == "--std" || a == "-o" || a == "--vendor" || a == "--comptime-fuel" || a == "--cp" {
      i = i + 2
    } else if a == "--native" || a == "--check" || a == "--comptime-ffi" ||
      a == "--closure" {
        i = i + 1
      } else {
        return a
      }
  }
  ""
}

## The target's resolved java-deps jars, with the Kotlin CLI's progress line.
fn resolve_java_deps(target: String) -> List[String] !io = {
  let none: List[String] = []
  if not io.is_dir(target) { return none }
  let mftext = match io.read_file(target ++ "/dawn.toml") {
    Ok(t) -> t
    Err(_) -> return none
  }
  match manifestv.validate(target, mftext) {
    Ok(_) -> ()
    Err(ds) -> {
      io.eprint(diag.render_manifest(target ++ "/dawn.toml", mftext, ds))
      let _ = io.exit(1)
    }
  }
  let coords = maven.collect_java_deps(target)
  if len(coords) == 0 { return none }
  io.eprintln("resolving " ++ to_string(len(coords)) ++ " java-deps from " ++
      target ++ "/dawn.toml...")
  let jars = match maven.fetch(coords) {
    Ok(js) -> js
    Err(e) -> {
      cli_error(e)
      return none
    }
  }
  # PKG-04: with a dawn.lock beside the manifest, the resolution has to agree
  # with it by bytes -- a moved transitive version, a mirror answering
  # differently or a damaged cache all stop here instead of building
  match io.read_file(maven.lock_path(target)) {
    Err(_) -> ()
    Ok(text) ->
      match maven.parse_lock(text) {
        Err(e) -> cli_error(maven.lock_path(target) ++ ": " ++ e)
        Ok(locked) ->
          match maven.lock_of(coords, jars) {
            Err(e) -> cli_error(e)
            Ok(fresh) ->
              match maven.check_lock(locked, fresh) {
                Err(e) -> cli_error(e)
                Ok(_) -> ()
              }
          }
      }
  }
  jars
}

## `dawn lock [--check] [<dir>]` — write (or verify) the resolved [java-deps]
## closure. This is the only command that rewrites dawn.lock; every other one
## only refuses to disagree with it.
fn run_lock(rest: List[String]) -> Unit !io = {
  var check_only = false
  var target = "."
  var seen_target = false
  for a in rest {
    if a == "--check" {
      check_only = true
    } else if not seen_target {
      target = a
      seen_target = true
    } else {
      return cli_error("usage: dawn lock [--check] [<project-dir>]")
    }
  }
  if not io.is_dir(target) { return cli_error("not a directory: " ++ target) }
  let path = maven.lock_path(target)
  let coords = maven.collect_java_deps(target)
  if len(coords) == 0 {
    if io.exists(path) {
      return cli_error(path ++ " exists but " ++ target ++
          "/dawn.toml declares no [java-deps]\n  delete the lock, or add the dependency back")
    }
    println("no [java-deps] to lock")
    return ()
  }
  io.eprintln("resolving " ++ to_string(len(coords)) ++ " java-deps...")
  let jars = match maven.fetch(coords) {
    Ok(js) -> js
    Err(e) -> {
      cli_error(e)
      return ()
    }
  }
  let fresh = match maven.lock_of(coords, jars) {
    Ok(l) -> l
    Err(e) -> {
      cli_error(e)
      return ()
    }
  }
  if check_only {
    match io.read_file(path) {
      Err(_) -> cli_error(path ++ " does not exist -- run `dawn lock`")
      Ok(text) ->
        match maven.parse_lock(text) {
          Err(e) -> cli_error(path ++ ": " ++ e)
          Ok(locked) ->
            match maven.check_lock(locked, fresh) {
              Err(e) -> cli_error(e)
              Ok(_) -> println(path ++ " is up to date (" ++
                  to_string(len(fresh.arts)) ++ " artifacts)")
            }
        }
    }
  } else {
    match io.write_file(path, maven.render_lock(fresh)) {
      Ok(_) -> println("wrote " ++ path ++ " (" ++ to_string(len(fresh.arts)) ++
          " artifacts from " ++ to_string(len(coords)) ++ " direct)")
      Err(e) -> cli_error("cannot write " ++ path ++ ": " ++ e.message)
    }
  }
}

## Jar paths the parent invocation resolved, carried across the re-exec.
fn deps_from_env() -> List[String] !io = {
  let none: List[String] = []
  match io.getenv("DAWN_SELFHOST_CP") {
    Some(s) -> if s == "" { none } else { str.split(s, path_sep()) }
    None -> none
  }
}

## run/test/build with a [java-deps] target: resolve, then re-exec this same
## invocation with the jars appended to the class path and never return. In
## the child (env set) this is a no-op.
fn maybe_with_deps(mode: String, rest: List[String]) -> Unit !io = {
  match io.getenv("DAWN_SELFHOST_CP") {
    Some(_) -> return
    None -> ()
  }
  let (cpjars, rest1) = extract_cp(rest)
  let (_, rest2) = extract_ct_opts(rest1)
  let target = peek_target(rest2)
  if target == "" && len(cpjars) == 0 { return }
  let no_jars: List[String] = []
  let jars = if target == "" { no_jars } else { resolve_java_deps(target) }
  if len(jars) == 0 && len(cpjars) == 0 { return }
  var cp = host_classpath()
  for j in jars { cp = cp ++ path_sep() ++ j }
  for j in cpjars { cp = cp ++ path_sep() ++ j }
  var cmd: List[String] = [host_java(), "-Xss512m", "-cp", cp, "main", mode]
  cmd = cmd ++ rest
  let pb = ProcessBuilder.new(cmd)
  let env = pb.environment().expect("env")
  let _ = env.put("DAWN_SELFHOST_CP", join(jars, path_sep()))
  let _ = pb.inheritIO()
  let code = wait_reaped(pb.start().expect("java process"), "")
  let _ = io.exit(code)
  ()
}

## Arrange for `child` to be destroyed -- and for `scratch` (empty for none) to
## be removed -- if this driver is terminated before it has finished with them.
##
## This driver never runs a program itself: `run`, `test`, the re-exec above and
## `--native` each hand the work to a child process and do nothing but wait. So
## a SIGTERM to the driver -- what `timeout` sends, and what any gate that
## bounds a hang sends -- used to kill the waiter and leave the child running:
## measured at 101% CPU, reparented to init, long after the driver was gone. A
## shutdown hook is where the JVM lets a program answer that signal (it runs for
## SIGTERM/SIGINT/SIGHUP and for every ordinary exit), so the destroy rides the
## path that already unwinds the driver. SIGKILL has no handler anywhere, on
## purpose; killing the process *group* is the only answer to it, and that is
## the caller's half of this (scripts/native-cli-diff.sh, scripts/doc-check.py).
##
## The hook is never removed. It does not need to be: each caller spawns exactly
## one child and the command is over when that child is, so there is nothing to
## accumulate, and both of its actions are idempotent -- `destroy` on an exited
## process and a delete of an already-deleted tree are no-ops, which is what
## makes running it again on the ordinary exit path harmless. Removing it would
## also have to cope with `removeShutdownHook` throwing once shutdown has begun,
## which is precisely the case this exists for.
fn reap_on_exit(child: Process, scratch: String) -> Unit !io = {
  let rt = Runtime.getRuntime().expect("runtime")
  let _ = rt.addShutdownHook(Thread.new(() => {
    let _ = child.destroy()
    if scratch != "" { pkgfetch.delete_tree(scratch) }
    ()
  }))
  ()
}

## `reap_on_exit` and then wait; the child's exit code.
fn wait_reaped(child: Process, scratch: String) -> Int !io = {
  reap_on_exit(child, scratch)
  child.waitFor()
}

## Emit `classes` under a fresh temp directory and return its path. The caller
## owns it: it removes the tree once the child it hands it to has finished, and
## `wait_reaped` removes it if the driver is terminated before that. Nothing
## else ever would -- the directories used to survive every ordinary run, and
## 3384 of them holding 2.9G had piled up in /tmp by the time anyone looked.
fn write_temp_classes(classes: List[(String, Bytes)]) -> String !io = {
  let dir =
    match io.temp_dir("", "selfhost-run") {
      Ok(d) -> d
      Err(e) -> panic("cannot create a temporary directory: " ++ e.message)
    }
  for pair in classes {
    let (nm, bs) = pair
    # nothing sensible to continue with: the classes about to be executed would
    # be missing one, so stop at the first failure and say which file it was
    # (cli_error exits the process)
    match write_class(dir, nm, bs) {
      Ok(_) -> ()
      Err(m) -> cli_error(m)
    }
  }
  dir
}

## Spawn `java -Xss512m -cp <cp> <cls> <args...>` inheriting stdio; the exit
## code. `scratch` is the directory the classes were written to, which the
## reaping wait removes if this driver is terminated mid-run.
fn spawn_java(cp: String, cls: String, args: List[String], scratch: String) -> Int !io = {
  var cmd: List[String] = [host_java(), "-Xss512m", "-cp", cp, cls]
  cmd = cmd ++ args
  let pb = ProcessBuilder.new(cmd)
  let _ = pb.inheritIO()
  wait_reaped(pb.start().expect("java process"), scratch)
}

## `selfhost run [--std <dir>] <target> [args...]` — mirror of `dawn run`,
## via a subprocess over freshly emitted classes (the host class path rides
## along so `use java` third-party classes stay visible).
fn run_run(rest0: List[String]) -> Unit !io = {
  let (_, rest1) = extract_cp(rest0)
  let (opts, restb) = extract_ct_opts(rest1)
  let (closure, rest) = extract_flag(restb, "--closure")
  var target = ""
  var std_dir = "std"
  var args2: List[String] = []
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) && target == "" {
      std_dir = rest[i + 1]
      i = i + 2
    } else if target == "" {
      target = rest[i]
      i = i + 1
    } else {
      args2 = args2 ++ [rest[i]]
      i = i + 1
    }
  }
  if target == "" {
    return cli_error("usage: dawn run [--cp jars] <file.dawn | project-dir>")
  }
  let (classes, entry, _) = collect_program(target, std_dir, opts, closure, false)
  if entry == "" {
    return cli_error(target ++ " has no pub fn main() -> Unit !io, nothing to run")
  }
  let dir = write_temp_classes(classes)
  let code = spawn_java(dir ++ path_sep() ++ host_classpath(), entry, args2, dir)
  pkgfetch.delete_tree(dir)
  if code != 0 { let _ = io.exit(code) }
}

## `selfhost test [--std <dir>] <target>` — mirror of `dawn test`: emit with
## test blocks plus a synthesized dawn$TestMain runner, and run it.
##
## `--stdlib` runs the bundled std's own test blocks instead of a target's,
## the way `dawn doc --stdlib` documents it instead of a target. std is not a
## project — its modules see the intrinsics no user module may name, and its
## `impl Iter[String]` is an orphan anywhere else — so `dawn test std/str.dawn`
## cannot be made to work, and a flag is the whole mechanism.
fn run_test(rest0: List[String]) -> Unit !io = {
  let (_, rest1) = extract_cp(rest0)
  let (opts, restb) = extract_ct_opts(rest1)
  let (closure2, restc) = extract_flag(restb, "--closure")
  let (std_tests, rest) = extract_flag(restc, "--stdlib")
  var target = ""
  var std_dir = "std"
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else {
      refuse_second_target("dawn test", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  if std_tests && target != "" {
    return cli_error("dawn test --stdlib takes no target: " ++ target)
  }
  if target == "" && not std_tests {
    return cli_error(
      "usage: dawn test [--cp jars] <file.dawn | project-dir> | dawn test --stdlib")
  }
  let (classes, _, tests_info) = collect_program(target, std_dir, opts, closure2, std_tests)
  if len(tests_info) == 0 {
    return cli_error(if std_tests { std_dir ++ " has no test blocks" }
    else { target ++ " has no test blocks" })
  }
  var runner_tests: List[(String, Int, String)] = []
  for mi in tests_info {
    let (cls, mod_path, names) = mi
    var idx = 0
    for nm in names {
      let label = if len(tests_info) > 1 { mod_path ++ " :: " ++ nm } else { nm }
      runner_tests = runner_tests ++ [(cls, idx, label)]
      idx = idx + 1
    }
  }
  let all = classes ++ [(TESTMAIN_CLASS, gen_test_main(runner_tests))]
  let dir = write_temp_classes(all)
  let code = spawn_java(dir ++ path_sep() ++ host_classpath(), TESTMAIN_CLASS, [], dir)
  pkgfetch.delete_tree(dir)
  if code != 0 { let _ = io.exit(code) }
}

## `selfhost emit [<target>] [--std <dir>] -o <dir>`: write every class of the
## compiled program under <dir> (`emitrt` is the historical alias).
fn run_emitrt(rest: List[String]) -> Unit !io = {
  var out = ""
  var target = ""
  var std_dir = "std"
  var i = 0
  while i < len(rest) {
    if rest[i] == "-o" && i + 1 < len(rest) {
      out = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else {
      refuse_second_target("dawn __emit", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  if out == "" {
    return cli_error("usage: dawn __emit <file.dawn | project-dir> -o <dir>")
  }
  let (classes, _, _) = collect_program(target, std_dir, ct_default(), false, false)
  var seen: Set[String] = set.empty()
  var n = 0
  for pair in classes {
    let (nm, bs) = pair
    match write_class(out, nm, bs) {
      Ok(_) -> ()
      Err(m) -> return cli_error(m)
    }
    if not set.has(seen, nm) {
      seen = set.insert(seen, nm)
      n = n + 1
    }
  }
  println(to_string(n) ++ " classes -> " ++ out)
}

## The target's basename, `.dawn` stripped — what `-o` defaults derive from.
fn target_stem(target: String) -> String = {
  var t = target
  while str.ends_with(t, "/") { t = str.take(t, str.len(t) - 1) }
  let base = match str.last_index_of(t, "/") {
    Some(i) -> str.drop(t, i + 1)
    None -> t
  }
  str.strip_suffix(base, ".dawn").unwrap_or(base)
}

## The absolute directory a jar path lands in.
fn abs_parent(path: String) -> String !io =
  match fspath.parent(fspath.absolute(path, io.cwd())) {
    Some(p) -> p
    None -> "."
  }

## Copy resolved jars next to the output jar, under lib/ — coursier's cache is
## a content-addressed path in the user's home, fine to compile against and
## useless to a deployed jar. Returns the manifest Class-Path entries.
fn vendor_jars(jars: List[String], jar_path: String) -> List[String] !io = {
  var entries: List[String] = []
  if len(jars) == 0 { return entries }
  let lib_dir = abs_parent(jar_path) ++ "/lib"
  let _ = io.mkdirs(lib_dir)
  for src in jars {
    let name = match str.last_index_of(src, "/") {
      Some(i) -> str.drop(src, i + 1)
      None -> src
    }
    let dst = lib_dir ++ "/" ++ name
    let bs =
      match io.read_bytes(src) {
        Ok(b) -> b
        Err(e) -> panic("cannot read " ++ src ++ ": " ++ e.message)
      }
    # Content, where this used to compare name and size and argue that the
    # cache is immutable. The bytes are in hand either way -- there is no
    # `size` primitive to be cheaper with, and the answer is now the real one.
    let same =
      match io.read_bytes(dst) {
        Ok(d) -> d == bs
        Err(_) -> false
      }
    if not same {
      match io.write_bytes(dst, bs) {
        Ok(_) -> ()
        Err(e) -> panic("cannot copy " ++ src ++ " to " ++ dst ++ ": " ++ e.message)
      }
    }
    entries = entries ++ ["lib/" ++ name]
  }
  entries
}

## Manifest Class-Path entries for --cp jars: relative when the jar sits
## under the output jar's directory, else an absolute file: URL (the Kotlin
## URI.relativize behavior).
fn rel_entries(jars: List[String], jar_path: String) -> List[String] !io = {
  var out: List[String] = []
  let base = abs_parent(jar_path) ++ "/"
  for j in jars {
    let abs = fspath.absolute(j, io.cwd())
    if str.starts_with(abs, base) {
      out = out ++ [str.drop(abs, str.len(base))]
    } else {
      out = out ++ ["file:" ++ abs]
    }
  }
  out
}

fn find_native_image() -> Option[String] !io = {
  var candidates: List[String] = []
  match io.getenv("GRAALVM_HOME") {
    Some(h) -> { candidates = candidates ++ [h ++ "/bin/native-image"] }
    None -> ()
  }
  match io.getenv("JAVA_HOME") {
    Some(h) -> { candidates = candidates ++ [h ++ "/bin/native-image"] }
    None -> ()
  }
  match io.getenv("PATH") {
    Some(p) -> {
      for dir in str.split(p, path_sep()) { candidates = candidates ++ [dir ++ "/native-image"] }
    }
    None -> ()
  }
  for c in candidates {
    let ok = match catch_fault(() => File.new(c).canExecute()) {
      Ok(b) -> b
      Err(_) -> false
    }
    if ok { return Some(c) }
  }
  None
}

## Hand the finished jar to native-image (the Kotlin cmdBuild native branch):
## stream its output indented, delete the temp jar, report.
fn run_native_image(
  jar_path: String,
  bin_out: String,
  user_cp: List[String],
  entry: String
) -> Unit !io = {
  let ni = match find_native_image() {
    Some(p) -> p
    None ->
      return cli_error(
        "native-image not found. Install GraalVM and add it to PATH, or set GRAALVM_HOME")
  }
  println("invoking native-image (takes a minute or two the first time)...")
  # with --cp jars the -jar form would ignore them: explicit class path + main
  var cmd: List[String] = [ni, "-jar", jar_path, "-o", bin_out, "--no-fallback"]
  if len(user_cp) > 0 {
    var cp = jar_path
    for j in user_cp { cp = cp ++ path_sep() ++ j }
    var dotted = ""
    for part in str.split(entry, "/") {
      if dotted == "" { dotted = part } else { dotted = dotted ++ "." ++ part }
    }
    cmd = [ni, "-cp", cp, dotted, "-o", bin_out, "--no-fallback"]
  }
  let pb = ProcessBuilder.new(cmd)
  let _ = pb.redirectErrorStream(true)
  let proc = pb.start().expect("native-image process")
  # before the read, not just before the wait: the read is where this blocks
  # for the minute or two native-image takes, so it is where a terminated
  # driver would otherwise abandon it
  reap_on_exit(proc, "")
  let outs = proc.getInputStream().expect("stream")
  let all = outs.readAllBytes().expect("output")
  for line in str.split(bytes.decode_utf8(all), "\n") {
    if line != "" { println("  " ++ line) }
  }
  let code = proc.waitFor()
  # the jar and the temp directory `run_build` staged it in -- there is no
  # `temp_file` primitive, so the directory is the unit that gets cleaned up
  let _ = io.delete(jar_path)
  match fspath.parent(jar_path) {
    Some(d) -> { let _ = io.delete(d) }
    None -> ()
  }
  if code != 0 {
    return cli_error("native-image failed (exit code " ++ to_string(code) ++ ")")
  }
  println("wrote " ++ bin_out ++ " (standalone binary, run it directly: ./" ++ bin_out ++ ")")
}

## `selfhost build <target> [-o out] [--native] [--std <dir>] [--vendor <pkg>]...`:
## pack the compiled program as an executable jar (java-deps vendored into
## lib/ beside it), or hand it to native-image. Each `--vendor` names an
## internal package path (e.g. org/objectweb/asm) whose classes are copied in
## from java.class.path — building selfhost itself vendors ASM and the
## coursier interface, which is what makes the jar standalone.
fn run_build(rest0: List[String]) -> Unit !io = {
  let (user_cp, rest1) = extract_cp(rest0)
  let (opts, restb) = extract_ct_opts(rest1)
  let (closure, rest) = extract_flag(restb, "--closure")
  var out = ""
  var target = ""
  var std_dir = "std"
  var vendor_pkgs: List[String] = []
  var native = false
  var i = 0
  while i < len(rest) {
    if rest[i] == "-o" && i + 1 < len(rest) {
      out = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--vendor" && i + 1 < len(rest) {
      vendor_pkgs = vendor_pkgs ++ [rest[i + 1]]
      i = i + 2
    } else if rest[i] == "--native" {
      native = true
      i = i + 1
    } else {
      refuse_second_target("dawn build", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  if target == "" {
    return cli_error("usage: dawn build [--cp jars] <file.dawn | project-dir> [-o out] [--native]")
  }
  let stem = target_stem(target)
  let jar_path = if native {
    match io.temp_dir("", "dawn-build-") {
      Ok(d) -> d ++ "/" ++ stem ++ ".jar"
      Err(e) -> panic("cannot create a temp jar: " ++ e.message)
    }
  } else if out != "" {
    out
  } else {
    stem ++ ".jar"
  }
  let (classes, entry, _) = collect_program(target, std_dir, opts, closure, false)
  if entry == "" {
    return cli_error(target ++ " has no pub fn main() -> Unit !io to use as an entry point")
  }
  # dedupe defensively: ZipOutputStream throws on a repeated entry name
  var seen: Set[String] = set.empty()
  var all: List[(String, Bytes)] = []
  for pair in classes {
    let (nm, _) = pair
    if not set.has(seen, nm) {
      seen = set.insert(seen, nm)
      all = all ++ [pair]
    }
  }
  for pkg in vendor_pkgs {
    for pair in vendor.classpath_package(pkg) {
      let (nm, _) = pair
      if not set.has(seen, nm) {
        seen = set.insert(seen, nm)
        all = all ++ [pair]
      }
    }
  }
  let deps = deps_from_env()
  # native-image inlines everything, so it reads the jars where they already
  # live; a plain jar needs them at a stable path next to itself, and --cp
  # jars stay where the user put them (relative when under the jar's dir)
  let cp_entries = if native {
    deps ++ user_cp
  } else {
    vendor_jars(deps, jar_path) ++ rel_entries(user_cp, jar_path)
  }
  # no std resources any more: the toolchain's own jar carries std as the
  # compiled stdsrc module, so embedding happens by being a source file
  jarw.write_jar_cp(jar_path, entry, all, cp_entries)
  if native {
    let bin_out = if out != "" { out } else { stem }
    return run_native_image(jar_path, bin_out, user_cp, entry)
  }
  if len(cp_entries) == 0 {
    println("wrote " ++ jar_path ++ " (run it with: java -jar " ++ jar_path ++ ")")
  } else if len(deps) == 0 {
    println("wrote " ++ jar_path ++ " (run it with: java -jar " ++ jar_path ++
        "; manifest Class-Path points at the --cp jars, keep them in place)")
  } else {
    println("wrote " ++ jar_path ++ " and " ++ to_string(len(deps)) ++ " jar(s) into " ++
        abs_parent(jar_path) ++ "/lib (run it with: java -jar " ++ jar_path ++
        "; keep lib/ next to the jar)")
  }
}

## Every .dawn file under `dir`, recursively; paths are `dir`-prefixed.
fn dawn_files_under(dir: String) -> List[String] !io = {
  var out: List[String] = []
  match io.list_dir(dir) {
    Ok(files) -> {
      for f in files {
        let p = dir ++ "/" ++ f
        if io.is_dir(p) {
          out = out ++ dawn_files_under(p)
        } else if str.ends_with(f, ".dawn") {
          out = out ++ [p]
        }
      }
    }
    Err(e) -> panic("cannot list " ++ dir ++ ": " ++ e.message)
  }
  out
}

## `selfhost fmt [--check] <file.dawn | dir>...` — mirror of `dawn fmt`:
## reformat in place, or report unformatted files and exit 1.
fn run_fmt(rest: List[String]) -> Unit !io = {
  var check = false
  var paths: List[String] = []
  for a in rest {
    if a == "--check" { check = true } else { paths = paths ++ [a] }
  }
  if len(paths) == 0 { return cli_error("usage: dawn fmt [--check] <file.dawn | dir>...") }
  var files: List[String] = []
  for p in paths {
    if not io.exists(p) { return cli_error("no such file or directory: " ++ p) }
    if io.is_dir(p) {
      files = files ++ sort(dawn_files_under(p))
    } else {
      files = files ++ [p]
    }
  }
  var unformatted = 0
  for f in files {
    match io.read_file(f) {
      Ok(original) -> {
        let formatted = fmt.format(original)
        if formatted != original {
          if check {
            println(f)
            unformatted = unformatted + 1
          } else {
            match io.write_file(f, formatted) {
              Ok(_) -> println("formatted " ++ f)
              Err(e) -> panic("cannot write " ++ f ++ ": " ++ e.message)
            }
          }
        }
      }
      Err(e) -> panic("cannot read " ++ f ++ ": " ++ e.message)
    }
  }
  if check && unformatted > 0 { let _ = io.exit(1) }
}

## `selfhost doc <target>` / `selfhost doc --builtins` — mirror of `dawn doc`.
fn run_doc(rest: List[String]) -> Unit !io = {
  var std_dir = "std"
  var builtins_mode = false
  var stdlib_mode = false
  var target = ""
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--builtins" {
      builtins_mode = true
      i = i + 1
    } else if rest[i] == "--stdlib" {
      # not `--std`: that spelling is taken, and by five bootstrap scripts at
      # that (it names the std *source directory*)
      stdlib_mode = true
      i = i + 1
    } else {
      refuse_second_target("dawn doc", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> panic("cannot load std from " ++ std_dir ++ ": " ++ e)
  }
  if stdlib_mode {
    print(doc.stdlib_json(std))
    return
  }
  if builtins_mode {
    print(doc.builtins_json(std))
    return
  }
  if target == "" {
    return cli_error(
      "usage: dawn doc <file.dawn | project-dir> | dawn doc --stdlib | dawn doc --builtins")
  }
  if not io.exists(target) {
    return cli_error("no such file or directory: " ++ target)
  }
  let loaded = if io.is_dir(target) { load_directory(target) } else { load_file(target) }
  let prog = analyze_program(loaded, std, ct_default(), jsig_real())
  if len(prog.diags) > 0 { fail_doc(prog.diags) }
  print(doc.project_json(prog))
}

## Lowering coverage gate (docs/native-backend-plan.md Phase 0): lower every
## module of a program to Core IR and report which ones survive. Retargeting
## emit.dawn is gated on this reaching the whole language -- the compiler
## cannot compile itself through an IR that cannot represent it.
##
## Each module is lowered inside catch_panic so one gap does not hide the
## rest: a single run lists everything still missing.
fn run_lower(rest: List[String]) -> Unit !io = {
  var std_dir = "std"
  var dump_dir = ""
  var targets: List[String] = []
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--dump" && i + 1 < len(rest) {
      dump_dir = rest[i + 1]
      i = i + 2
    } else {
      targets = targets ++ [rest[i]]
      i = i + 1
    }
  }
  if len(targets) != 1 {
    cli_error("__lower takes exactly one target")
  }
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> panic("cannot load std from " ++ std_dir ++ ": " ++ e)
  }
  let t = targets[0]
  let loaded = if io.is_dir(t) { load_directory(t) } else { load_file(t) }
  let prog = analyze_program(loaded, std, ct_default(), jsig_real())
  if len(prog.diags) > 0 { fail_compile(prog.diags) }
  let (adts, traits, impl_table, prog_fns) = cdriver.program_tables(std, prog.modules)

  # `--dump` writes one .core per module next to the coverage count. The
  # golden it feeds is the only detector for the parts of Core no shipping
  # backend reads -- see coredump.dawn.
  let dump_to = dump_dir
  let dumping = dump_to != ""

  ## Lower one module; on success optionally write its golden. Returns the
  ## node count so the coverage gate keeps working unchanged.
  fn one(cls: String, tm: TModule) -> Int !io = {
    let m = rc.rc_module(lower.lower_module(cls, tm, traits, impl_table, adts, prog_fns))
    if dumping {
      let path = dump_to ++ "/" ++ join(str.split(cls, "/"), ".") ++ ".core"
      match io.write_file(path, coredump.render(adts, m)) {
        Ok(_u) -> ()
        Err(e) -> panic("cannot write " ++ path ++ ": " ++ e.message)
      }
    }
    lower_size(m)
  }

  var ok = 0
  var bad = 0
  var seen: Set[String] = set.empty()
  # std first: the compiler is compiled against it, so a gap there matters
  # just as much
  for sm in std.mods {
    let (cls, _cx, tm, _ct) = sm
    match catch_panic(() => one(cls, tm)) {
      Ok(_n) -> { ok = ok + 1 }
      Err(e) -> {
        bad = bad + 1
        if not set.has(seen, e.message) {
          seen = set.insert(seen, e.message)
          println("GAP  " ++ cls ++ ": " ++ e.message)
        }
      }
    }
  }
  for cm in prog.modules {
    match catch_panic(() => one(cm.class_name, cm.tm)) {
      Ok(_n) -> { ok = ok + 1 }
      Err(e) -> {
        bad = bad + 1
        if not set.has(seen, e.message) {
          seen = set.insert(seen, e.message)
          println("GAP  " ++ cm.class_name ++ ": " ++ e.message)
        }
      }
    }
  }
  println("")
  println("lowered " ++ to_string(ok) ++ " module(s), " ++ to_string(bad) ++ " failed")
  if bad > 0 {
    let _ = io.exit(1)
    ()
  }
}

## Force the lowered module so a panic happens inside catch_panic rather
## than lazily afterwards.
fn lower_size(m: CModule) -> Int = {
  var n = 0
  for f in m.fns {
    n = n + len(f.params) + len(f.dicts) + 1
  }
  n + len(m.dicts)
}

## Trait/impl/ADT/signature tables unioned over std and user modules, as
## collect_program builds them for the JVM path: ids are unique program-wide.
## The Phase -1 native seam spike (docs/native-backend-plan.md): emit C for
## the trivial subset instead of class files. Hidden and unsupported --
## `emitc.dawn` panics on anything outside that subset, and both are
## superseded once Core IR lands.
fn run_emitc(rest: List[String]) -> Unit !io = {
  var std_dir = "std"
  var out = ""
  var targets: List[String] = []
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "-o" && i + 1 < len(rest) {
      out = rest[i + 1]
      i = i + 2
    } else {
      targets = targets ++ [rest[i]]
      i = i + 1
    }
  }
  if len(targets) != 1 {
    cli_error("__emitc takes exactly one target")
  }
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> panic("cannot load std from " ++ std_dir ++ ": " ++ e)
  }
  let t = targets[0]
  let loaded = if io.is_dir(t) { load_directory(t) } else { load_file(t) }
  let prog = analyze_program(loaded, std, ct_default(), jsig_real())
  if len(prog.diags) > 0 { fail_compile(prog.diags) }
  let text = match cdriver.c_text(std, prog) {
    Ok(s) -> s
    Err(e) -> return cli_error(e ++ " in " ++ t)
  }
  if out == "" {
    print(text)
  } else {
    match io.write_file(out, text) {
      Ok(_) -> ()
      Err(e) -> cli_error("cannot write " ++ out ++ ": " ++ e.message)
    }
  }
}

fn run_check(rest: List[String]) -> Unit !io = {
  var std_dir = "std"
  var targets: List[String] = []
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else {
      targets = targets ++ [rest[i]]
      i = i + 1
    }
  }
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> panic("cannot load std from " ++ std_dir ++ ": " ++ e)
  }
  for t in targets {
    println("== " ++ t ++ " ==")
    let loaded = if io.is_dir(t) { load_directory(t) } else { load_file(t) }
    let prog = analyze_program(loaded, std, ct_default(), jsig_real())
    print(checkdump.render(prog))
  }
}

pub fn main() -> Unit !io = {
  match args() {
    [] -> {
      print(usage())
      let _ = io.exit(2)
      ()
    }
    [mode, ..rest] ->
      if mode == "check" || mode == "__check" {
        run_check(rest)
      } else if mode == "emit" || mode == "emitrt" || mode == "__emit" {
        run_emitrt(rest)
      } else if mode == "__emitc" {
        run_emitc(rest)
      } else if mode == "__lower" {
        run_lower(rest)
      } else if mode == "build" {
        maybe_with_deps(mode, rest)
        run_build(rest)
      } else if mode == "fmt" {
        run_fmt(rest)
      } else if mode == "run" {
        maybe_with_deps(mode, rest)
        run_run(rest)
      } else if mode == "test" {
        maybe_with_deps(mode, rest)
        run_test(rest)
      } else if mode == "doc" {
        run_doc(rest)
      } else if mode == "add" {
        match add.run_add(rest) {
          Ok(s) -> println(s)
          Err(e) -> cli_error(e)
        }
      } else if mode == "lsp" {
        server.run_lsp("std", jsig_real())
      } else if mode == "lock" {
        run_lock(rest)
      } else if mode == "cache" {
        run_cache(rest)
      } else if mode == "__pkghash" {
        run_pkghash(rest)
      } else if mode == "lex" || mode == "__lex" || mode == "parse" || mode == "__parse" {
        for pth in rest {
          println("== " ++ pth ++ " ==")
          match io.read_file(pth) {
            Ok(text) ->
              if mode == "lex" || mode == "__lex" {
                let (toks, diags) = lexer.lex(text)
                println(lexdump.render(toks, diags))
              } else {
                let (m, diags) = parser.parse_module(text)
                println(astdump.render_module(m, diags))
              }
            Err(e) -> panic("cannot read " ++ pth ++ ": " ++ e.message)
          }
        }
      } else if mode == "--version" || mode == "-V" || mode == "version" {
        println("dawn " ++ VERSION ++ " (selfhost)")
      } else if mode == "--help" || mode == "-h" || mode == "help" {
        print(usage())
      } else {
        io.eprintln("unknown command: " ++ mode ++ "\n")
        print(usage())
        let _ = io.exit(2)
        ()
      }
  }
}

# The compile pipeline both drivers share, from an analyzed program to one C
# translation unit. `main` (the JVM driver) reaches it for `__emitc`, and
# `nmain` (the native driver) is little more than a CLI around it -- one
# definition of "how a program becomes C", per the one-definition doctrine.
#
# `program_tables` and `merged_consts` live here rather than in a driver
# because they are the same merge for every backend: the JVM codegen path
# calls them too.

use std/io
use std/map
use std/str
use ir/core.{CValue, CFun, CModule, CParam, CMode, COwned, CBorrowed, mode_owned}
use check/types.{Adts, Traits, Impls, Sig, prelude_adts}
use check/cx.{Cx}
use ir/interp.{CtOut}
use driver/stdlib.{StdCtx}
use driver/analyze.{CheckedMod, Program}
use ir/lower
use c/rc
use ir/reach
use ir/reach.{TableUse}
use c/emitc
use c/emitc.{EmitMod}
use c/ctestrun
use embed/rtsrc

## The program-wide tables codegen reads: every module's ADTs, traits, impls
## and function signatures, std's first, later declarations winning.
pub fn program_tables(
  std: StdCtx,
  mods: List[CheckedMod]
) -> (Adts, Traits, Impls, Map[(String, String), Sig]) = {
  var adts = prelude_adts()
  var traits: Traits = map.empty()
  var impl_table: Impls = map.empty()
  var prog_fns: Map[(String, String), Sig] = map.empty()
  for pr in map.entries(std.adts) {
    let (k, v) = pr
    adts = map.insert(adts, k, v)
  }
  for sm in std.mods {
    let (cls, cx, _tm, _ct) = sm
    for pr in map.entries(cx.traits) {
      let (k, v) = pr
      traits = map.insert(traits, k, v)
    }
    for pr in map.entries(cx.impl_table) {
      let (k, v) = pr
      impl_table = map.insert(impl_table, k, v)
    }
    for pr in map.entries(cx.fns) {
      let (k, v) = pr
      prog_fns = map.insert(prog_fns, (cls, k), v)
    }
  }
  for cm in mods {
    for pr in map.entries(cm.cx.adts) {
      let (k, v) = pr
      adts = map.insert(adts, k, v)
    }
    for pr in map.entries(cm.cx.traits) {
      let (k, v) = pr
      traits = map.insert(traits, k, v)
    }
    for pr in map.entries(cm.cx.impl_table) {
      let (k, v) = pr
      impl_table = map.insert(impl_table, k, v)
    }
    for pr in map.entries(cm.cx.fns) {
      let (k, v) = pr
      prog_fns = map.insert(prog_fns, (cm.class_name, k), v)
    }
  }
  (adts, traits, impl_table, prog_fns)
}

## This module's const-name → value view: its own comptime results, plus
## imported consts resolved in their declaring module's results.
pub fn merged_consts(
  cx: Cx,
  ct: CtOut,
  by_mod: Map[String, Map[String, CValue]]
) -> Map[String, CValue] = {
  var out = ct.consts
  for name in map.keys(cx.consts) {
    if not map.has(out, name) {
      match map.get(cx.imported_names, name) {
        Some(from) ->
          match map.get(by_mod, from) {
            Some(vals) ->
              match map.get(vals, name) {
                Some(v) -> { out = map.insert(out, name, v) }
                None -> ()
              }
            None -> ()
          }
        None -> ()
      }
    }
  }
  # qualified constants (`m.MAX`, LANG-06 step 3) are filed under
  # `<declaring module>.<NAME>` -- the key CConstRef asks for when its owner is
  # not empty. A separate key rather than merging by simple name, because the
  # referring module may declare a `MAX` of its own and both must survive.
  for al in map.keys(cx.module_exports) {
    match map.get(cx.module_exports, al) {
      None -> ()
      Some(exp) ->
        match map.get(by_mod, exp.mod_path) {
          None -> ()
          Some(vals) -> {
            for nm in map.keys(exp.consts) {
              match map.get(vals, nm) {
                Some(v) -> { out = map.insert(out, exp.mod_path ++ "." ++ nm, v) }
                None -> ()
              }
            }
          }
        }
    }
  }
  out
}

## Test bodies renamed to the symbol the generated runner will call, and
## demoted to ordinary functions.
##
## A test's Core name is its description string, so it cannot be named the way
## a function is -- the generated runner has to write the symbol down knowing
## only the index. Renaming here rather than special-casing `is_test`
## in the emitter also means the emitter needs no case at all: it skips
## `is_test`, and after this pass there is nothing left for it to skip.
##
## The index counts tests within *this* module, which is what makes it the
## same number the JVM's `dawn$test$i` carries.
fn named_tests(m: CModule) -> CModule = {
  var fns: List[CFun] = []
  var i = 0
  for f in m.fns {
    if f.is_test {
      fns = fns ++ [CFun { ..f, name: emitc.test_name(i), is_test: false }]
      i = i + 1
    } else {
      fns = fns ++ [f]
    }
  }
  CModule { ..m, fns: fns }
}

## One requested parameter-mode flip, from `DAWN_RC_MODE_FLIPS`. The mode
## contract (core.CMode) has two readers -- the callee's `CParam.mode` and
## the program-wide call-site table -- and a flip names which of them to turn
## `CBorrowed` for one parameter of one function. Flipping only one is the
## whole point: scripts/rc-mode-contract exists to prove a disagreement
## between the two readers is caught by the sanitizers, and `both` is the
## coherent flip the borrowed-inference pass (docs/perceus-design.md 6) will
## one day produce, so it must stay green.
type ModeFlip = {
  owner: String,
  name: String,
  arity: Int,
  idx: Int,
  callee_side: Bool,
  callsite_side: Bool
}

## Parse `owner:name:arity:index=callee|callsite|both`, comma-separated.
## `:` separates the fields because `owner` itself carries `/` (module paths
## are slash-spelled, core.CFun.owner). Any malformed entry is a panic, not a
## skip: the only writer is the mutant harness, and a flip that silently did
## not happen would turn a red mutant into a green lie.
fn parse_mode_flips(spec: String) -> List[ModeFlip] = {
  var out: List[ModeFlip] = []
  for ent in str.split(spec, ",") {
    let e = str.trim(ent)
    if e != "" {
      let (lhs, side) = str.split_once(e, "=")
        .expect("DAWN_RC_MODE_FLIPS: missing `=` in `" ++ e ++ "`")
      let parts = str.split(lhs, ":")
      if len(parts) != 4 {
        panic("DAWN_RC_MODE_FLIPS: want owner:name:arity:index=side, got `" ++ e ++ "`")
      }
      let arity = parse_int(parts[2])
        .expect("DAWN_RC_MODE_FLIPS: arity is not a number in `" ++ e ++ "`")
      let idx = parse_int(parts[3])
        .expect("DAWN_RC_MODE_FLIPS: index is not a number in `" ++ e ++ "`")
      if idx < 0 || idx >= arity {
        panic("DAWN_RC_MODE_FLIPS: index " ++ to_string(idx) ++
            " out of range for arity " ++ to_string(arity) ++ " in `" ++ e ++ "`")
      }
      let sides =
        if side == "callee" {
          (true, false)
        } else if side == "callsite" {
          (false, true)
        } else if side == "both" {
          (true, true)
        } else {
          panic("DAWN_RC_MODE_FLIPS: unknown side `" ++ side ++ "` in `" ++ e ++ "`")
        }
      let (ce, cs) = sides
      out = out ++ [ModeFlip {
        owner: parts[0], name: parts[1], arity: arity, idx: idx,
        callee_side: ce, callsite_side: cs
      }]
    }
  }
  out
}

## The flips this compile was asked for -- an empty list on every real
## compile. The variable is a test-only injection channel for the mutant
## harness; with it unset this returns `[]`, `flip_table` and `flip_callee`
## return their inputs unchanged, and the produced C is byte-for-byte what it
## was before the channel existed (the harness pins that as its clean
## control).
fn mode_flips_from_env() -> List[ModeFlip] !io =
  match io.getenv("DAWN_RC_MODE_FLIPS") {
    None -> [],
    Some(s) -> parse_mode_flips(s)
  }

## The call-site half of a flip: a table row with `CBorrowed` at the flipped
## position. A row already inserted by an earlier flip is edited in place, so
## two flips of one function compose.
fn flip_table(
  base: Map[(String, String), List[CMode]],
  flips: List[ModeFlip]
) -> Map[(String, String), List[CMode]] = {
  var out = base
  for fl in flips {
    if fl.callsite_side {
      var row0: List[CMode] = []
      match map.get(out, (fl.owner, fl.name)) {
        Some(r) -> { row0 = r }
        None -> {
          var i = 0
          while i < fl.arity {
            row0 = row0 ++ [COwned]
            i = i + 1
          }
        }
      }
      var row: List[CMode] = []
      var i = 0
      for m in row0 {
        if i == fl.idx { row = row ++ [CBorrowed] } else { row = row ++ [m] }
        i = i + 1
      }
      out = map.insert(out, (fl.owner, fl.name), row)
    }
  }
  out
}

## The callee half of a flip: the matching `CParam.mode` stamped `CBorrowed`
## on the lowered Core, before `rc_module` reads it. With no flips the module
## passes through untouched.
fn flip_callee(m: CModule, flips: List[ModeFlip]) -> CModule = {
  if len(flips) == 0 { return m }
  var fns: List[CFun] = []
  for f in m.fns {
    var params = f.params
    for fl in flips {
      if fl.callee_side && fl.owner == f.owner && fl.name == f.name {
        var out: List[CParam] = []
        var i = 0
        for p in params {
          if i == fl.idx {
            out = out ++ [CParam { ..p, mode: CBorrowed }]
          } else {
            out = out ++ [p]
          }
          i = i + 1
        }
        params = out
      }
    }
    fns = fns ++ [CFun { ..f, params: params }]
  }
  CModule { ..m, fns: fns }
}

test "mode flips parse and stamp both halves" {
  let fls = parse_mode_flips("std/cursor:done:2:0=both, std/str:len:1:0=callsite")
  assert len(fls) == 2
  assert fls[0].owner == "std/cursor" && fls[0].name == "done"
  assert fls[0].callee_side && fls[0].callsite_side
  assert not fls[1].callee_side && fls[1].callsite_side
  let t = flip_table(map.empty(), fls)
  match map.get(t, ("std/cursor", "done")) {
    Some(row) -> {
      assert len(row) == 2
      assert not mode_owned(row[0]) && mode_owned(row[1])
    }
    None -> { assert false }
  }
  match map.get(t, ("std/str", "len")) {
    Some(row2) -> { assert len(row2) == 1 && not mode_owned(row2[0]) }
    None -> { assert false }
  }
}

test "an empty flip list is the identity on the table" {
  let t = flip_table(rc.owned_modes(), [])
  assert len(map.entries(t)) == 0
}

## Every module of the program, std first, lowered and reference-counted.
## `with_tests` is `dawn test`'s: the test bodies ride along, and so do the
## dictionaries only a test asks for (`lower.emitted_core`). std's tests ride
## only under `std_tests` (`dawn test --stdlib`), which is the JVM path's
## answer too -- `collect_program` takes the same pair of flags.
fn build_units(
  std: StdCtx,
  prog: Program,
  with_tests: Bool,
  std_tests: Bool
) -> (List[EmitMod], String, Adts, Map[(String, String), List[CMode]]) !io = {
  let (adts, traits, impl_table, prog_fns) = program_tables(std, prog.modules)
  # The parameter-mode table, one for the whole unit: `__emitc` is
  # whole-program compilation, so the borrowed-inference fixpoint
  # (docs/perceus-design.md 6) has its natural home here, over every
  # module's Core, before any is rewritten. Until that pass exists the
  # table is empty and every parameter is owned. It rides back out because
  # the emitter reads call sites with the same table the rewrite used.
  # `flips` is the mutant harness's injection channel (see ModeFlip above)
  # and is empty on every compile that did not set DAWN_RC_MODE_FLIPS.
  let flips = mode_flips_from_env()
  let modes = flip_table(rc.owned_modes(), flips)
  # const values by declaring module, the same view the JVM path builds: a
  # const is named by its simple name and imported by it
  var const_vals: Map[String, Map[String, CValue]] = map.empty()
  for sm in std.mods {
    let (cls, _cx, _tm, ct) = sm
    const_vals = map.insert(const_vals, cls, ct.consts)
  }
  for cm in prog.modules { const_vals = map.insert(const_vals, cm.mod_path, cm.ct.consts) }

  var units: List[EmitMod] = []
  var entry = ""
  for sm in std.mods {
    let (cls, cx, tm, ct) = sm
    let core =
      if std_tests {
        named_tests(lower.emitted_core(lower.lower_module_full(cls, tm, traits,
          impl_table, adts, prog_fns, true)))
      } else {
        lower.lower_module(cls, tm, traits, impl_table, adts, prog_fns)
      }
    units = units ++ [
      EmitMod {
        m: rc.rc_module(flip_callee(core, flips), modes),
        consts: merged_consts(cx, ct, const_vals),
        blocks: ct.blocks
      }
    ]
  }
  for cm in prog.modules {
    let core =
      if with_tests {
        named_tests(lower.emitted_core(lower.lower_module_full(cm.class_name, cm.tm, traits,
          impl_table, adts, prog_fns, true)))
      } else {
        lower.lower_module(cm.class_name, cm.tm, traits, impl_table, adts, prog_fns)
      }
    units = units ++ [
      EmitMod {
        m: rc.rc_module(flip_callee(core, flips), modes),
        consts: merged_consts(cm.cx, cm.ct, const_vals),
        blocks: cm.ct.blocks
      }
    ]
    if entry == "" {
      for tf in cm.tm.fns {
        if tf.name == "main" { entry = cm.class_name }
      }
    }
  }
  # `adts` rides back out: the emitter needs it to rebuild a structured
  # comptime constant, and recomputing `program_tables` at the call site would
  # be a second answer to a question already answered here
  (units, entry, adts, modes)
}

## Which Unicode tables ride: the same question, and the same answer, as the
## JVM path. The units are already lowered (rc included; the walk ignores
## CDup/CSDrop), so reach reads them as they are.
##
## `dawn test --stdlib` has no user module to root the walk at, so it carries
## everything -- again the JVM path's answer, whose targetless `collect_program`
## reaches for `all_tables` for the same reason.
fn tables(units: List[EmitMod], prog: Program, std_tests: Bool) -> TableUse = {
  if std_tests { return reach.all_tables() }
  var reach_mods: List[CModule] = []
  for u2 in units { reach_mods = reach_mods ++ [u2.m] }
  var reach_roots: List[String] = []
  for cm in prog.modules { reach_roots = reach_roots ++ [cm.class_name] }
  reach.table_use(reach_mods, reach_roots)
}

## An analyzed program as one C translation unit, or Err when it has no
## `main`. std goes in first: a C translation unit needs a definition for
## everything it calls, and after S3 the collections *are* std -- `[1, 2]`
## calls `std/pvec.from_array`.
pub fn c_text(std: StdCtx, prog: Program) -> Result[String, String] !io = {
  let (units, entry, adts, modes) = build_units(std, prog, false, false)
  if entry == "" { return Err("no pub fn main() -> Unit !io, nothing to compile") }
  Ok(emitc.emit_program(units, entry, tables(units, prog, false), adts, modes))
}

## The same translation unit with the test blocks compiled in and a generated
## runner for its `main` -- `dawn test` on this backend. A test target needs no
## `pub fn main`, so nothing here asks for an entry.
##
## `tests` is (owning module class, index within that module, label) in run
## order: the triple `testrun.gen_test_main` takes on the JVM, built the same
## way by the driver so that the two reports carry the same labels.
##
## `std_tests` is `--stdlib`: the tests being run are std's own, and `prog`
## carries no modules at all.
pub fn c_test_text(
  std: StdCtx,
  prog: Program,
  tests: List[(String, Int, String)],
  std_tests: Bool
) -> Result[String, String] !io = {
  let (units, _entry, adts, modes) = build_units(std, prog, true, std_tests)
  Ok(emitc.emit_headless(units, tables(units, prog, std_tests), adts, modes) ++
      ctestrun.runner(tests))
}

## The embedded C runtime file `name`, for the native driver's `build` to
## write beside the C it emits.
pub fn runtime_source(name: String) -> Option[String] = rtsrc.source(name)

test "the embedded C runtime matches runtime/c on disk" {
  # the staleness gate for the generated rtsrc.dawn, same shape as the
  # embedded-std one in stdlib.dawn
  for f in ["dawn_rt.c", "dawn_rt.h", "dawn_rt_wasi_eh.cc", "dawn_rt_wasi_tag.c"] {
    let disk = match io.read_file("runtime/c/" ++ f) {
      Ok(t) -> t
      Err(e) -> panic("runtime/c/" ++ f ++ ": " ++ e.message)
    }
    match rtsrc.source(f) {
      Some(t) -> {
        if t != disk {
          println("stale embedded runtime: " ++ f ++ " (run python3 scripts/gen-rtsrc.py)")
        }
        assert t == disk
      }
      None -> {
        println("missing from embedded runtime: " ++ f ++ " (run python3 scripts/gen-rtsrc.py)")
        assert false
      }
    }
  }
}

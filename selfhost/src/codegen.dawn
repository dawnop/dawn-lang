# Checked TAST → JVM bytecode via ASM (the Kotlin CodeGen.kt, spec §12.2):
# module → class of statics; Int → long, Float → double, Bool → boolean,
# String → java.lang.String, Unit → void; ADT → abstract base + final ctor
# subclasses (nullary = singletons); match → instanceof chains; self tail
# calls → goto. The class writer is the shared dawn.tool.AdtClassWriter, so
# COMPUTE_FRAMES resolves generated-class hierarchies identically on both
# compilers — golden = byte-identical .class files (docs/selfhost-codegen.md).

use std/str
use std/bytes
use std/list
use std/map
use std/set
use types.{
  EPure, prelude_adts, opt_ty,
  Ty, TyInt, TyFloat, TyBool, TyString, TyBytes, TyUnit, TyNever,
  TyError, TyVar, TyAdt, TyList, TyMap, TySet, TyArray, TyJava, TyTuple, TyFn,
  Adts, AdtI, CtorI, adt_of, adt_jvm_name, ctor_jvm_name, Sym, Sig, Eff
}
use jreflect
use java "dawn.tool.AdtClassWriter"
use java "org.objectweb.asm.MethodVisitor"
use java "org.objectweb.asm.Label"
use java "org.objectweb.asm.Opcodes"
use java "java.util.Objects"

# ---- naming (must match the Kotlin side byte for byte) ----

pub fn obj() -> String = "java/lang/Object"

pub fn fn_iface(arity: Int) -> String = "dawn/rt/Fn" ++ to_string(arity)

pub fn tuple_class(arity: Int) -> String = "dawn/rt/Tuple" ++ to_string(arity)

pub fn erased_apply_desc(arity: Int) -> String = {
  var ps = ""
  for _i in 0 ..arity { ps = ps ++ "Ljava/lang/Object;" }
  "(" ++ ps ++ ")Ljava/lang/Object;"
}

# ---- type mapping ----

## The JVM descriptor of a Dawn type (the Kotlin descOf).
pub fn desc_of(adts: Adts, t: Ty) -> String =
  match t {
    # an opaque type has no representation of its own -- it IS its target
    TyOpaque(_, _, _, tgt) -> desc_of(adts, tgt)
    TyInt -> "J"
    TyFloat -> "D"
    TyBool -> "Z"
    TyString -> "Ljava/lang/String;"
    TyBytes -> "[B"
    TyUnit -> "V"
    TyNever -> "V"
    TyError -> "V"
    TyVar(_, _) -> "Ljava/lang/Object;"
    TyAdt(aid, _) -> "L" ++ adt_jvm_name(adt_of(adts, aid)) ++ ";"
    TyList(_) -> "Ljava/util/List;"
    TyMap(_, _) -> "Ljava/util/Map;"
    TySet(_) -> "Ljava/util/Set;"
    TyArray(_) -> "L" ++ ARRAY_CLASS ++ ";"
    TyTuple(elems) -> "L" ++ tuple_class(len(elems)) ++ ";"
    # arrays are their own descriptor ("[B"); reference classes get L…;
    TyJava(fqcn, _) -> {
      let internal = join(str.split(fqcn, "."), "/")
      if str.starts_with(internal, "[") { internal } else { "L" ++ internal ++ ";" }
    }
    TyFn(params, _, _) -> "L" ++ fn_iface(len(params)) ++ ";"
  }

pub fn method_desc(adts: Adts, params: List[Ty], ret: Ty) -> String = {
  var ps = ""
  for p in params { ps = ps ++ desc_of(adts, p) }
  "(" ++ ps ++ ")" ++ desc_of(adts, ret)
}

## How the JVM carries a value of this type.
##
## `desc_of` says which *class*; this says which *machine representation*, and
## those are the only two questions the backend asks about a type that every
## variant has to answer. Slot width, load/store opcode, boxing and hashing all
## follow from this, so they dispatch on `JvmRepr` rather than re-deciding the
## scalar/reference split each time.
##
## The line: this answers *how a value is carried*. A function whose answer
## depends on Dawn semantics -- content equality, hashing, rendering, order --
## must stay a `Ty` match, because there a new variant inheriting `RRef` would
## be a wrong answer rather than a missing one.
pub type JvmRepr =
  | RLong # 2 slots, boxes to java.lang.Long
  | RDouble # 2 slots, boxes to java.lang.Double
  | RBool # 1 slot, boxes to java.lang.Boolean
  | RRef # 1 slot, already an Object
  | RUnit # 0 slots; a value exists but carries nothing
  | RBottom # 0 slots and no value: Never and Error

## The one function that has to account for every `Ty`. Deliberately without a
## wildcard: a new variant must fail to compile *here*, where the decision is
## a one-liner, rather than silently inherit a default in a dozen callers.
pub fn jvm_repr(t: Ty) -> JvmRepr =
  match t {
    TyOpaque(_, _, _, tgt) -> jvm_repr(tgt)
    TyInt -> RLong
    TyFloat -> RDouble
    TyBool -> RBool
    TyUnit -> RUnit
    TyNever -> RBottom
    TyError -> RBottom
    TyString -> RRef
    TyBytes -> RRef
    TyVar(_, _) -> RRef
    TyAdt(_, _) -> RRef
    TyList(_) -> RRef
    TyMap(_, _) -> RRef
    TySet(_) -> RRef
    TyArray(_) -> RRef
    TyJava(_, _) -> RRef
    TyTuple(_) -> RRef
    TyFn(_, _, _) -> RRef
  }

## JVM stack/local slots of a type (J/D = 2, void = 0).
pub fn slots_of(t: Ty) -> Int =
  match jvm_repr(t) {
    RLong -> 2
    RDouble -> 2
    RBool -> 1
    RRef -> 1
    RUnit -> 0
    RBottom -> 0
  }

pub fn is_ref(t: Ty) -> Bool =
  match jvm_repr(t) {
    RRef -> true
    RLong | RDouble | RBool | RUnit | RBottom -> false
  }

# ---- tests ----

test "descriptors and slot sizes mirror the Kotlin mapping" {
  let adts = prelude_adts()
  assert desc_of(adts, TyInt) == "J"
  assert desc_of(adts, TyBool) == "Z"
  assert desc_of(adts, TyBytes) == "[B"
  assert desc_of(adts, TyList(TyInt)) == "Ljava/util/List;"
  assert desc_of(adts, TyTuple([TyInt, TyBool])) == "Ldawn/rt/Tuple2;"
  assert desc_of(adts, TyFn([TyInt], TyBool, EPure)) == "Ldawn/rt/Fn1;"
  assert desc_of(adts, opt_ty(TyInt)) == "LOption;"
  assert method_desc(adts, [TyInt, TyString], TyUnit) == "(JLjava/lang/String;)V"
  assert erased_apply_desc(2) == "(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;"
  assert slots_of(TyFloat) == 2
  assert slots_of(TyUnit) == 0
}

test "the ASM interop spike: a class assembles through the shared writer" {
  # dawn/rt/Fn interfaces use a plain ClassWriter(0) in Kotlin; the spike just
  # proves Dawn can drive AdtClassWriter + MethodVisitor end to end
  let sup: List[String] = []
  let cw = AdtClassWriter.new(sup)
  # V17 = 61, ACC_PUBLIC|ACC_FINAL = 0x11
  cw.begin(61, 17, "spike/Empty", "java/lang/Object")
  let m = cw.method(9, "id", "(J)J").expect("method visitor")
  m.visitCode()
  # LLOAD 0; LRETURN
  m.visitVarInsn(22, 0)
  m.visitInsn(173)
  m.visitMaxs(0, 0)
  m.visitEnd()
  cw.visitEnd()
  let bs = cw.toByteArray().expect("bytes")
  assert bytes.len(bs) > 0
}

# ---- JVM opcode constants (org.objectweb.asm.Opcodes; static fields do not
# cross the interop boundary, so the stable values are spelled here) ----

pub const V17: Int = 61

pub const ACC_PUBLIC: Int = 1

pub const ACC_PRIVATE: Int = 2

pub const ACC_PROTECTED: Int = 4

pub const ACC_STATIC: Int = 8

pub const ACC_FINAL: Int = 16

pub const ACC_ABSTRACT: Int = 1024

pub const ACC_INTERFACE: Int = 512

pub const OP_ALOAD: Int = 25

pub const OP_ILOAD: Int = 21

pub const OP_LLOAD: Int = 22

pub const OP_DLOAD: Int = 24

pub const OP_ASTORE: Int = 58

pub const OP_ISTORE: Int = 54

pub const OP_LSTORE: Int = 55

pub const OP_DSTORE: Int = 57

pub const OP_RETURN: Int = 177

pub const OP_ARETURN: Int = 176

pub const OP_IRETURN: Int = 172

pub const OP_LRETURN: Int = 173

pub const OP_DRETURN: Int = 175

pub const OP_DUP: Int = 89

pub const OP_DUP2: Int = 92

pub const OP_POP: Int = 87

pub const OP_POP2: Int = 88

pub const OP_NEW: Int = 187

pub const OP_CHECKCAST: Int = 192

pub const OP_INSTANCEOF: Int = 193

pub const OP_INVOKESPECIAL: Int = 183

pub const OP_INVOKESTATIC: Int = 184

pub const OP_INVOKEVIRTUAL: Int = 182

pub const OP_INVOKEINTERFACE: Int = 185

pub const OP_GETFIELD: Int = 180

pub const OP_PUTFIELD: Int = 181

pub const OP_GETSTATIC: Int = 178

pub const OP_PUTSTATIC: Int = 179

pub const OP_ATHROW: Int = 191

pub const OP_GOTO: Int = 167

pub const OP_IFEQ: Int = 153

pub const OP_IFNE: Int = 154

pub const OP_IFLT: Int = 155

pub const OP_IFGE: Int = 156

pub const OP_IFGT: Int = 157

pub const OP_IFLE: Int = 158

pub const OP_IF_ICMPEQ: Int = 159

pub const OP_IF_ICMPNE: Int = 160

pub const OP_IF_ICMPGE: Int = 162

pub const OP_IF_ACMPEQ: Int = 165

pub const OP_IFNULL: Int = 198

pub const OP_ACONST_NULL: Int = 1

pub const OP_ICONST_M1: Int = 2

pub const OP_ICONST_0: Int = 3

pub const OP_ICONST_1: Int = 4

pub const OP_LCONST_0: Int = 9

pub const OP_LCONST_1: Int = 10

pub const OP_LCMP: Int = 148

pub const OP_DCMPL: Int = 151

pub const OP_I2L: Int = 133

pub const OP_L2I: Int = 136

pub const OP_BALOAD: Int = 51

pub const OP_ANEWARRAY: Int = 189

pub const OP_IFNONNULL: Int = 199

pub const OP_IADD: Int = 96

pub const OP_LADD: Int = 97

pub const OP_ISUB: Int = 100

pub const OP_IMUL: Int = 104

pub const OP_IXOR: Int = 130

pub const OP_LXOR: Int = 131

pub const OP_LNEG: Int = 117

pub const OP_DNEG: Int = 119

pub const OP_BIPUSH: Int = 16

# ---- shared runtime classes (each must byte-match the Kotlin emission) ----

pub const PANIC_CLASS: String = "dawn/rt/PanicError"

pub const UNIT_CLASS: String = "dawn/rt/Unit"

pub const SB: String = "java/lang/StringBuilder"

pub const SHOW_CLASS: String = "dawn/rt/Show"

## dawn/rt/FnN: the erased function interface (ClassWriter(0), like Kotlin).
pub fn gen_fn_interface(arity: Int) -> Bytes !io = {
  let cw = AdtClassWriter.plain(0).expect("writer")
  AdtClassWriter.beginOn(cw, V17, ACC_PUBLIC + ACC_ABSTRACT + ACC_INTERFACE, fn_iface(arity), obj())
  let m = AdtClassWriter.methodOn(cw, ACC_PUBLIC + ACC_ABSTRACT, "apply", erased_apply_desc(arity))
    .expect("mv")
  m.visitEnd()
  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

## dawn/rt/PanicError: an Error subclass carrying the panic message.
pub fn gen_panic_class() -> Bytes !io = {
  let cw = AdtClassWriter.plain(0).expect("writer")
  AdtClassWriter.beginOn(cw, V17, ACC_PUBLIC + ACC_FINAL, PANIC_CLASS, "java/lang/Error")
  let ctor = AdtClassWriter.methodOn(cw, ACC_PUBLIC, "<init>", "(Ljava/lang/String;)V").expect("mv")
  ctor.visitCode()
  ctor.visitVarInsn(OP_ALOAD, 0)
  ctor.visitVarInsn(OP_ALOAD, 1)
  ctor.visitMethodInsn(OP_INVOKESPECIAL, "java/lang/Error", "<init>", "(Ljava/lang/String;)V", false)
  ctor.visitInsn(OP_RETURN)
  ctor.visitMaxs(2, 2)
  ctor.visitEnd()
  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

## dawn/rt/Unit: the Unit singleton (materialized only in erased Object slots).
pub fn gen_unit_class() -> Bytes !io = {
  let cw = AdtClassWriter.plain(0).expect("writer")
  AdtClassWriter.beginOn(cw, V17, ACC_PUBLIC + ACC_FINAL, UNIT_CLASS, obj())
  AdtClassWriter.fieldOn(cw, ACC_PUBLIC + ACC_STATIC + ACC_FINAL, "INSTANCE", "L" ++ UNIT_CLASS ++ ";")
  let ctor = AdtClassWriter.methodOn(cw, ACC_PRIVATE, "<init>", "()V").expect("mv")
  ctor.visitCode()
  ctor.visitVarInsn(OP_ALOAD, 0)
  ctor.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  ctor.visitInsn(OP_RETURN)
  ctor.visitMaxs(1, 1)
  ctor.visitEnd()
  let cl = AdtClassWriter.methodOn(cw, ACC_STATIC, "<clinit>", "()V").expect("mv")
  cl.visitCode()
  cl.visitTypeInsn(OP_NEW, UNIT_CLASS)
  cl.visitInsn(OP_DUP)
  cl.visitMethodInsn(OP_INVOKESPECIAL, UNIT_CLASS, "<init>", "()V", false)
  cl.visitFieldInsn(OP_PUTSTATIC, UNIT_CLASS, "INSTANCE", "L" ++ UNIT_CLASS ++ ";")
  cl.visitInsn(OP_RETURN)
  cl.visitMaxs(2, 0)
  cl.visitEnd()
  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

pub fn append_const(m: MethodVisitor, s: String) -> Unit !io = {
  m.visitLdcInsn(Objects.requireNonNull(s).expect("non-null"))
  m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  ()
}

## dawn/rt/Show: rendering an *erased* value, which is a different job from the
## `Show` trait and all that is left to this class.
##
## The trait is what a Dawn program reaches: `to_string` and `${...}` resolve a
## witness and lowering spells the rendering out in Core, so both backends
## compile one definition (semantics-closure-design.md 6). Two callers have no
## static type to resolve from and so cannot: `Maps.index`, whose panic text
## names the key it did not find, and `quote`, which lowering emits by name
## because a String field has to come out quoted.
##
## show(Object) is therefore a best effort over what the JVM can see -- Strings
## quoted, Lists/Maps/Sets recursed, byte[] summarised, everything else through
## String.valueOf, which finds the ADT `toString` below. It is not the
## language's answer to "how does this render"; it is what a panic message can
## say about a value whose type was thrown away.
pub fn gen_show_class(supers: List[String]) -> Bytes !io = {
  let jstr = "java/lang/String"
  let jlist = "java/util/List"
  let jmap = "java/util/Map"
  let jset = "java/util/Set"
  let iter = "java/util/Iterator"
  let entry = "java/util/Map\$Entry"
  let obj_to_str = "(Ljava/lang/Object;)Ljava/lang/String;"
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, SHOW_CLASS, obj())

  # static String show(Object o): the instanceof chain
  let sh = cw.method(ACC_PUBLIC + ACC_STATIC, "show", obj_to_str).expect("mv")
  sh.visitCode()
  let not_string = Label.new()
  let not_list = Label.new()
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_INSTANCEOF, jstr)
  sh.visitJumpInsn(OP_IFEQ, not_string)
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_CHECKCAST, jstr)
  sh.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "quote",
    "(Ljava/lang/String;)Ljava/lang/String;", false)
  sh.visitInsn(OP_ARETURN)
  sh.visitLabel(not_string)
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_INSTANCEOF, jlist)
  sh.visitJumpInsn(OP_IFEQ, not_list)
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_CHECKCAST, jlist)
  sh.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "showList",
    "(Ljava/util/List;)Ljava/lang/String;", false)
  sh.visitInsn(OP_ARETURN)
  sh.visitLabel(not_list)
  let not_map = Label.new()
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_INSTANCEOF, jmap)
  sh.visitJumpInsn(OP_IFEQ, not_map)
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_CHECKCAST, jmap)
  sh.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "showMap",
    "(Ljava/util/Map;)Ljava/lang/String;", false)
  sh.visitInsn(OP_ARETURN)
  sh.visitLabel(not_map)
  let not_set = Label.new()
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_INSTANCEOF, jset)
  sh.visitJumpInsn(OP_IFEQ, not_set)
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_CHECKCAST, jset)
  sh.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "showSet",
    "(Ljava/util/Set;)Ljava/lang/String;", false)
  sh.visitInsn(OP_ARETURN)
  sh.visitLabel(not_set)
  let not_bytes = Label.new()
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_INSTANCEOF, "[B")
  sh.visitJumpInsn(OP_IFEQ, not_bytes)
  sh.visitTypeInsn(OP_NEW, SB)
  sh.visitInsn(OP_DUP)
  sh.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  append_const(sh, "<")
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitTypeInsn(OP_CHECKCAST, "[B")
  sh.visitInsn(OP_ARRAYLENGTH)
  sh.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(I)L" ++ SB ++ ";", false)
  append_const(sh, " bytes>")
  sh.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  sh.visitInsn(OP_ARETURN)
  sh.visitLabel(not_bytes)
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitMethodInsn(OP_INVOKESTATIC, jstr, "valueOf", obj_to_str, false)
  sh.visitInsn(OP_ARETURN)
  sh.visitMaxs(0, 0)
  sh.visitEnd()

  # static String quote(String s): source-literal escaping, backslash first
  let q = cw.method(ACC_PUBLIC + ACC_STATIC, "quote",
    "(Ljava/lang/String;)Ljava/lang/String;").expect("mv")
  q.visitCode()
  q.visitTypeInsn(OP_NEW, SB)
  q.visitInsn(OP_DUP)
  q.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  append_const(q, "\"")
  q.visitVarInsn(OP_ALOAD, 0)
  # no \r escape in Dawn literals; build the CR character from its code point
  let esc = [("\\", "\\\\"), ("\"", "\\\""), ("\n", "\\n"), ("\t", "\\t"), (str.from_char(13), "\\r")]
  for pair in esc {
    let (f, r) = pair
    q.visitLdcInsn(Objects.requireNonNull(f).expect("non-null"))
    q.visitLdcInsn(Objects.requireNonNull(r).expect("non-null"))
    q.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "replace",
      "(Ljava/lang/CharSequence;Ljava/lang/CharSequence;)Ljava/lang/String;", false)
  }
  q.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  append_const(q, "\"")
  q.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  q.visitInsn(OP_ARETURN)
  q.visitMaxs(0, 0)
  q.visitEnd()

  # static String showList(List xs): "[e0, e1, ...]" with elements shown
  let sl = cw.method(ACC_PUBLIC + ACC_STATIC, "showList",
    "(Ljava/util/List;)Ljava/lang/String;").expect("mv")
  sl.visitCode()
  sl.visitTypeInsn(OP_NEW, SB)
  sl.visitInsn(OP_DUP)
  sl.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  sl.visitVarInsn(OP_ASTORE, 1)
  sl.visitVarInsn(OP_ALOAD, 1)
  append_const(sl, "[")
  sl.visitInsn(OP_POP)
  sl.visitInsn(OP_ICONST_0)
  sl.visitVarInsn(OP_ISTORE, 2)
  sl.visitVarInsn(OP_ALOAD, 0)
  sl.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "size", "()I", true)
  sl.visitVarInsn(OP_ISTORE, 3)
  let l_loop = Label.new()
  let l_done = Label.new()
  sl.visitLabel(l_loop)
  sl.visitVarInsn(OP_ILOAD, 2)
  sl.visitVarInsn(OP_ILOAD, 3)
  sl.visitJumpInsn(OP_IF_ICMPGE, l_done)
  let l_no_comma = Label.new()
  sl.visitVarInsn(OP_ILOAD, 2)
  sl.visitJumpInsn(OP_IFEQ, l_no_comma)
  sl.visitVarInsn(OP_ALOAD, 1)
  append_const(sl, ", ")
  sl.visitInsn(OP_POP)
  sl.visitLabel(l_no_comma)
  sl.visitVarInsn(OP_ALOAD, 1)
  sl.visitVarInsn(OP_ALOAD, 0)
  sl.visitVarInsn(OP_ILOAD, 2)
  sl.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "get", "(I)Ljava/lang/Object;", true)
  sl.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "show", obj_to_str, false)
  sl.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  sl.visitInsn(OP_POP)
  sl.visitIincInsn(2, 1)
  sl.visitJumpInsn(OP_GOTO, l_loop)
  sl.visitLabel(l_done)
  sl.visitVarInsn(OP_ALOAD, 1)
  append_const(sl, "]")
  sl.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  sl.visitInsn(OP_ARETURN)
  sl.visitMaxs(0, 0)
  sl.visitEnd()

  # static String showMap(Map m): "map_from([(k, v), ...])" (spec §2.2 shape)
  let sm = cw.method(ACC_PUBLIC + ACC_STATIC, "showMap",
    "(Ljava/util/Map;)Ljava/lang/String;").expect("mv")
  sm.visitCode()
  sm.visitTypeInsn(OP_NEW, SB)
  sm.visitInsn(OP_DUP)
  sm.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  sm.visitVarInsn(OP_ASTORE, 1)
  sm.visitVarInsn(OP_ALOAD, 1)
  append_const(sm, "map_from([")
  sm.visitInsn(OP_POP)
  sm.visitVarInsn(OP_ALOAD, 0)
  sm.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "entrySet", "()Ljava/util/Set;", true)
  sm.visitMethodInsn(OP_INVOKEINTERFACE, jset, "iterator", "()Ljava/util/Iterator;", true)
  sm.visitVarInsn(OP_ASTORE, 2)
  sm.visitInsn(OP_ICONST_0)
  sm.visitVarInsn(OP_ISTORE, 3)
  let m_loop = Label.new()
  let m_done = Label.new()
  let m_no_comma = Label.new()
  sm.visitLabel(m_loop)
  sm.visitVarInsn(OP_ALOAD, 2)
  sm.visitMethodInsn(OP_INVOKEINTERFACE, iter, "hasNext", "()Z", true)
  sm.visitJumpInsn(OP_IFEQ, m_done)
  sm.visitVarInsn(OP_ALOAD, 2)
  sm.visitMethodInsn(OP_INVOKEINTERFACE, iter, "next", "()Ljava/lang/Object;", true)
  sm.visitTypeInsn(OP_CHECKCAST, entry)
  sm.visitVarInsn(OP_ASTORE, 4)
  sm.visitVarInsn(OP_ILOAD, 3)
  sm.visitJumpInsn(OP_IFEQ, m_no_comma)
  sm.visitVarInsn(OP_ALOAD, 1)
  append_const(sm, ", ")
  sm.visitInsn(OP_POP)
  sm.visitLabel(m_no_comma)
  sm.visitVarInsn(OP_ALOAD, 1)
  append_const(sm, "(")
  sm.visitInsn(OP_POP)
  sm.visitVarInsn(OP_ALOAD, 1)
  sm.visitVarInsn(OP_ALOAD, 4)
  sm.visitMethodInsn(OP_INVOKEINTERFACE, entry, "getKey", "()Ljava/lang/Object;", true)
  sm.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "show", obj_to_str, false)
  sm.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  sm.visitInsn(OP_POP)
  sm.visitVarInsn(OP_ALOAD, 1)
  append_const(sm, ", ")
  sm.visitInsn(OP_POP)
  sm.visitVarInsn(OP_ALOAD, 1)
  sm.visitVarInsn(OP_ALOAD, 4)
  sm.visitMethodInsn(OP_INVOKEINTERFACE, entry, "getValue", "()Ljava/lang/Object;", true)
  sm.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "show", obj_to_str, false)
  sm.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  sm.visitInsn(OP_POP)
  sm.visitVarInsn(OP_ALOAD, 1)
  append_const(sm, ")")
  sm.visitInsn(OP_POP)
  sm.visitIincInsn(3, 1)
  sm.visitJumpInsn(OP_GOTO, m_loop)
  sm.visitLabel(m_done)
  sm.visitVarInsn(OP_ALOAD, 1)
  append_const(sm, "])")
  sm.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  sm.visitInsn(OP_ARETURN)
  sm.visitMaxs(0, 0)
  sm.visitEnd()

  # static String showSet(Set s): "set_from([e0, e1, ...])"
  let ss = cw.method(ACC_PUBLIC + ACC_STATIC, "showSet",
    "(Ljava/util/Set;)Ljava/lang/String;").expect("mv")
  ss.visitCode()
  ss.visitTypeInsn(OP_NEW, SB)
  ss.visitInsn(OP_DUP)
  ss.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  ss.visitVarInsn(OP_ASTORE, 1)
  ss.visitVarInsn(OP_ALOAD, 1)
  append_const(ss, "set_from([")
  ss.visitInsn(OP_POP)
  ss.visitVarInsn(OP_ALOAD, 0)
  ss.visitMethodInsn(OP_INVOKEINTERFACE, jset, "iterator", "()Ljava/util/Iterator;", true)
  ss.visitVarInsn(OP_ASTORE, 2)
  ss.visitInsn(OP_ICONST_0)
  ss.visitVarInsn(OP_ISTORE, 3)
  let s_loop = Label.new()
  let s_done = Label.new()
  let s_no_comma = Label.new()
  ss.visitLabel(s_loop)
  ss.visitVarInsn(OP_ALOAD, 2)
  ss.visitMethodInsn(OP_INVOKEINTERFACE, iter, "hasNext", "()Z", true)
  ss.visitJumpInsn(OP_IFEQ, s_done)
  ss.visitVarInsn(OP_ALOAD, 2)
  ss.visitMethodInsn(OP_INVOKEINTERFACE, iter, "next", "()Ljava/lang/Object;", true)
  ss.visitVarInsn(OP_ASTORE, 4)
  ss.visitVarInsn(OP_ILOAD, 3)
  ss.visitJumpInsn(OP_IFEQ, s_no_comma)
  ss.visitVarInsn(OP_ALOAD, 1)
  append_const(ss, ", ")
  ss.visitInsn(OP_POP)
  ss.visitLabel(s_no_comma)
  ss.visitVarInsn(OP_ALOAD, 1)
  ss.visitVarInsn(OP_ALOAD, 4)
  ss.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "show", obj_to_str, false)
  ss.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  ss.visitInsn(OP_POP)
  ss.visitIincInsn(3, 1)
  ss.visitJumpInsn(OP_GOTO, s_loop)
  ss.visitLabel(s_done)
  ss.visitVarInsn(OP_ALOAD, 1)
  append_const(ss, "])")
  ss.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  ss.visitInsn(OP_ARETURN)
  ss.visitMaxs(0, 0)
  ss.visitEnd()

  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

## dawn/rt/TupleN: N public final Object fields + structural equals/hashCode +
## Show-rendering toString (the Kotlin genTupleClass; frame-computing writer).
pub fn gen_tuple_class(supers: List[String], n: Int) -> Bytes !io = {
  let cls = tuple_class(n)
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, cls, obj())
  var i = 0
  while i < n {
    cw.field(ACC_PUBLIC + ACC_FINAL, "_" ++ to_string(i), "Ljava/lang/Object;")
    i = i + 1
  }
  var ps = ""
  for _k in 0 ..n { ps = ps ++ "Ljava/lang/Object;" }
  let ctor_desc = "(" ++ ps ++ ")V"
  let init = cw.method(ACC_PUBLIC, "<init>", ctor_desc).expect("mv")
  init.visitCode()
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  i = 0
  while i < n {
    init.visitVarInsn(OP_ALOAD, 0)
    init.visitVarInsn(OP_ALOAD, i + 1)
    init.visitFieldInsn(OP_PUTFIELD, cls, "_" ++ to_string(i), "Ljava/lang/Object;")
    i = i + 1
  }
  init.visitInsn(OP_RETURN)
  init.visitMaxs(0, 0)
  init.visitEnd()
  let eq = cw.method(ACC_PUBLIC, "equals", "(Ljava/lang/Object;)Z").expect("mv")
  eq.visitCode()
  let yes = Label.new()
  let no = Label.new()
  eq.visitVarInsn(OP_ALOAD, 0)
  eq.visitVarInsn(OP_ALOAD, 1)
  eq.visitJumpInsn(OP_IF_ACMPEQ, yes)
  eq.visitVarInsn(OP_ALOAD, 1)
  eq.visitTypeInsn(OP_INSTANCEOF, cls)
  eq.visitJumpInsn(OP_IFEQ, no)
  eq.visitVarInsn(OP_ALOAD, 1)
  eq.visitTypeInsn(OP_CHECKCAST, cls)
  eq.visitVarInsn(OP_ASTORE, 2)
  i = 0
  while i < n {
    eq.visitVarInsn(OP_ALOAD, 0)
    eq.visitFieldInsn(OP_GETFIELD, cls, "_" ++ to_string(i), "Ljava/lang/Object;")
    eq.visitVarInsn(OP_ALOAD, 2)
    eq.visitFieldInsn(OP_GETFIELD, cls, "_" ++ to_string(i), "Ljava/lang/Object;")
    eq.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "equals", "(Ljava/lang/Object;)Z", false)
    eq.visitJumpInsn(OP_IFEQ, no)
    i = i + 1
  }
  eq.visitLabel(yes)
  eq.visitInsn(OP_ICONST_1)
  eq.visitInsn(OP_IRETURN)
  eq.visitLabel(no)
  eq.visitInsn(OP_ICONST_0)
  eq.visitInsn(OP_IRETURN)
  eq.visitMaxs(0, 0)
  eq.visitEnd()
  let hc = cw.method(ACC_PUBLIC, "hashCode", "()I").expect("mv")
  hc.visitCode()
  hc.visitInsn(OP_ICONST_1)
  i = 0
  while i < n {
    hc.visitIntInsn(OP_BIPUSH, 31)
    hc.visitInsn(OP_IMUL)
    hc.visitVarInsn(OP_ALOAD, 0)
    hc.visitFieldInsn(OP_GETFIELD, cls, "_" ++ to_string(i), "Ljava/lang/Object;")
    hc.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "hashCode", "()I", false)
    hc.visitInsn(OP_IADD)
    i = i + 1
  }
  hc.visitInsn(OP_IRETURN)
  hc.visitMaxs(0, 0)
  hc.visitEnd()
  let ts = cw.method(ACC_PUBLIC, "toString", "()Ljava/lang/String;").expect("mv")
  ts.visitCode()
  ts.visitTypeInsn(OP_NEW, SB)
  ts.visitInsn(OP_DUP)
  ts.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  append_const(ts, "(")
  i = 0
  while i < n {
    if i > 0 { append_const(ts, ", ") }
    ts.visitVarInsn(OP_ALOAD, 0)
    ts.visitFieldInsn(OP_GETFIELD, cls, "_" ++ to_string(i), "Ljava/lang/Object;")
    ts.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "show",
      "(Ljava/lang/Object;)Ljava/lang/String;", false)
    ts.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
    i = i + 1
  }
  append_const(ts, ")")
  ts.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  ts.visitInsn(OP_ARETURN)
  ts.visitMaxs(0, 0)
  ts.visitEnd()
  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

## The synthetic superclass table for COMPUTE_FRAMES (the Kotlin adtSupers),
## as "child super" pairs for the shared writer.
pub fn supers_of(adts: Adts, all_ids: List[Int]) -> List[String] = {
  var out: List[String] = []
  for aid in all_ids {
    let a = adt_of(adts, aid)
    let base = adt_jvm_name(a)
    out = out ++ [base ++ " " ++ obj()]
    if not a.is_record {
      for c in a.ctors { out = out ++ [ctor_jvm_name(adts, c) ++ " " ++ base] }
    }
  }
  var n = 2
  while n <= 8 {
    out = out ++ [tuple_class(n) ++ " " ++ obj()]
    n = n + 1
  }
  out
}

pub const BYTES_CLASS: String = "dawn/rt/Bytes"

pub const IO_CLASS: String = "dawn/rt/Io"

pub const LISTS_CLASS: String = "dawn/rt/Lists"

pub const STRINGS_CLASS: String = "dawn/rt/Strings"

pub const MAPS_CLASS: String = "dawn/rt/Maps"

pub const FN_CMP_CLASS: String = "dawn/rt/FnComparator"

pub const OP_ARRAYLENGTH: Int = 190

pub const OP_IINC_UNUSED: Int = 132

## dawn/rt/Bytes: the byte-string runtime — concat (backs `Bytes ++ Bytes`) plus
## the bytes_* primitives std/bytes writes over (utf8/decode/len/at/slice). These
## retire the handwritten dawn.rt.StdBytes; index_of stays pure Dawn over len/at.
## Byte values are unsigned 0..255 on the Dawn side, so -1 is a free out-of-range
## sentinel for bytes_at (std turns it into a panic).
pub fn gen_bytes_class(supers: List[String]) -> Bytes !io = {
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, BYTES_CLASS, obj())
  let m = cw.method(ACC_PUBLIC + ACC_STATIC, "concat", "([B[B)[B").expect("mv")
  m.visitCode()
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitInsn(OP_ARRAYLENGTH)
  m.visitVarInsn(OP_ISTORE, 2)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitInsn(OP_ARRAYLENGTH)
  m.visitVarInsn(OP_ISTORE, 3)
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitVarInsn(OP_ILOAD, 2)
  m.visitVarInsn(OP_ILOAD, 3)
  m.visitInsn(OP_IADD)
  m.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "copyOf", "([BI)[B", false)
  m.visitVarInsn(OP_ASTORE, 4)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitInsn(OP_ICONST_0)
  m.visitVarInsn(OP_ALOAD, 4)
  m.visitVarInsn(OP_ILOAD, 2)
  m.visitVarInsn(OP_ILOAD, 3)
  m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/System", "arraycopy",
    "(Ljava/lang/Object;ILjava/lang/Object;II)V", false)
  m.visitVarInsn(OP_ALOAD, 4)
  m.visitInsn(OP_ARETURN)
  m.visitMaxs(0, 0)
  m.visitEnd()

  # bytes_utf8(s) = s.getBytes(UTF_8)
  let uv = open_static(cw, "bytes_utf8", "(Ljava/lang/String;)[B")
  uv.visitVarInsn(OP_ALOAD, 0)
  uv.visitFieldInsn(OP_GETSTATIC, "java/nio/charset/StandardCharsets", "UTF_8",
    "Ljava/nio/charset/Charset;")
  uv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/String", "getBytes",
    "(Ljava/nio/charset/Charset;)[B", false)
  uv.visitInsn(OP_ARETURN)
  close_mv(uv)

  # bytes_len(b) = b.length
  let lv = open_static(cw, "bytes_len", "([B)J")
  lv.visitVarInsn(OP_ALOAD, 0)
  lv.visitInsn(OP_ARRAYLENGTH)
  lv.visitInsn(OP_I2L)
  lv.visitInsn(OP_LRETURN)
  close_mv(lv)

  # bytes_at(b, i): (i < 0 || i >= len) ? -1 : (b[i] & 0xFF)
  let av = open_static(cw, "bytes_at", "([BJ)J")
  let at_neg = Label.new()
  av.visitVarInsn(OP_LLOAD, 1)
  av.visitInsn(OP_LCONST_0)
  av.visitInsn(OP_LCMP)
  av.visitJumpInsn(OP_IFLT, at_neg)
  av.visitVarInsn(OP_LLOAD, 1)
  av.visitVarInsn(OP_ALOAD, 0)
  av.visitInsn(OP_ARRAYLENGTH)
  av.visitInsn(OP_I2L)
  av.visitInsn(OP_LCMP)
  av.visitJumpInsn(OP_IFGE, at_neg)
  av.visitVarInsn(OP_ALOAD, 0)
  av.visitVarInsn(OP_LLOAD, 1)
  av.visitInsn(OP_L2I)
  av.visitInsn(OP_BALOAD)
  av.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Byte", "toUnsignedInt", "(B)I", false)
  av.visitInsn(OP_I2L)
  av.visitInsn(OP_LRETURN)
  av.visitLabel(at_neg)
  av.visitInsn(OP_ICONST_M1)
  av.visitInsn(OP_I2L)
  av.visitInsn(OP_LRETURN)
  close_mv(av)

  # bytes_slice(b, start, end) = Arrays.copyOfRange over clamped [s, max(s, e))
  let sv = open_static(cw, "bytes_slice", "([BJJ)[B")
  let sl_fix = Label.new()
  let sl_copy = Label.new()
  sv.visitVarInsn(OP_ALOAD, 0)
  sv.visitInsn(OP_ARRAYLENGTH)
  sv.visitVarInsn(OP_ISTORE, 5)
  sv.visitVarInsn(OP_LLOAD, 1)
  sv.visitVarInsn(OP_ILOAD, 5)
  sv.visitMethodInsn(OP_INVOKESTATIC, BYTES_CLASS, "bytesClamp", "(JI)I", false)
  sv.visitVarInsn(OP_ISTORE, 6)
  sv.visitVarInsn(OP_LLOAD, 3)
  sv.visitVarInsn(OP_ILOAD, 5)
  sv.visitMethodInsn(OP_INVOKESTATIC, BYTES_CLASS, "bytesClamp", "(JI)I", false)
  sv.visitVarInsn(OP_ISTORE, 7)
  sv.visitVarInsn(OP_ILOAD, 6)
  sv.visitVarInsn(OP_ILOAD, 7)
  sv.visitJumpInsn(OP_IF_ICMPGE, sl_fix)
  sv.visitJumpInsn(OP_GOTO, sl_copy)
  sv.visitLabel(sl_fix)
  sv.visitVarInsn(OP_ILOAD, 6)
  sv.visitVarInsn(OP_ISTORE, 7)
  sv.visitLabel(sl_copy)
  sv.visitVarInsn(OP_ALOAD, 0)
  sv.visitVarInsn(OP_ILOAD, 6)
  sv.visitVarInsn(OP_ILOAD, 7)
  sv.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "copyOfRange", "([BII)[B", false)
  sv.visitInsn(OP_ARETURN)
  close_mv(sv)

  # bytesClamp(v, hi) = v < 0 ? 0 : (v > hi ? hi : (int) v)
  let cv = open_static(cw, "bytesClamp", "(JI)I")
  let cl_pos = Label.new()
  let cl_ok = Label.new()
  cv.visitVarInsn(OP_LLOAD, 0)
  cv.visitInsn(OP_LCONST_0)
  cv.visitInsn(OP_LCMP)
  cv.visitJumpInsn(OP_IFGE, cl_pos)
  cv.visitInsn(OP_ICONST_0)
  cv.visitInsn(OP_IRETURN)
  cv.visitLabel(cl_pos)
  cv.visitVarInsn(OP_LLOAD, 0)
  cv.visitVarInsn(OP_ILOAD, 2)
  cv.visitInsn(OP_I2L)
  cv.visitInsn(OP_LCMP)
  cv.visitJumpInsn(OP_IFLE, cl_ok)
  cv.visitVarInsn(OP_ILOAD, 2)
  cv.visitInsn(OP_IRETURN)
  cv.visitLabel(cl_ok)
  cv.visitVarInsn(OP_LLOAD, 0)
  cv.visitInsn(OP_L2I)
  cv.visitInsn(OP_IRETURN)
  close_mv(cv)

  # bytes_decode(b, charset): Some(new String(b, charset)) / None on bad charset
  let dv = open_static(cw, "bytes_decode", "([BLjava/lang/String;)LOption;")
  let d_start = Label.new()
  let d_end = Label.new()
  let d_handler = Label.new()
  dv.visitTryCatchBlock(d_start, d_end, d_handler, "java/io/UnsupportedEncodingException")
  dv.visitLabel(d_start)
  dv.visitTypeInsn(OP_NEW, "Option\$Some")
  dv.visitInsn(OP_DUP)
  dv.visitTypeInsn(OP_NEW, "java/lang/String")
  dv.visitInsn(OP_DUP)
  dv.visitVarInsn(OP_ALOAD, 0)
  dv.visitVarInsn(OP_ALOAD, 1)
  dv.visitMethodInsn(OP_INVOKESPECIAL, "java/lang/String", "<init>",
    "([BLjava/lang/String;)V", false)
  dv.visitMethodInsn(OP_INVOKESPECIAL, "Option\$Some", "<init>", "(Ljava/lang/Object;)V", false)
  dv.visitLabel(d_end)
  dv.visitInsn(OP_ARETURN)
  dv.visitLabel(d_handler)
  dv.visitInsn(OP_POP)
  dv.visitFieldInsn(OP_GETSTATIC, "Option\$None", "INSTANCE", "LOption\$None;")
  dv.visitInsn(OP_ARETURN)
  close_mv(dv)

  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

fn gen_try_closure(cw: AdtClassWriter, name: String, caught: String) -> Unit !io = {
  let m = cw.method(ACC_PUBLIC + ACC_STATIC, name, "(L" ++ fn_iface(0) ++ ";)LResult;")
    .expect("mv")
  m.visitCode()
  let try_start = Label.new()
  let try_end = Label.new()
  let handler = Label.new()
  m.visitTryCatchBlock(try_start, try_end, handler, caught)
  m.visitLabel(try_start)
  m.visitTypeInsn(OP_NEW, "Result\$Ok")
  m.visitInsn(OP_DUP)
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitMethodInsn(OP_INVOKEINTERFACE, fn_iface(0), "apply", erased_apply_desc(0), true)
  m.visitMethodInsn(OP_INVOKESPECIAL, "Result\$Ok", "<init>", "(Ljava/lang/Object;)V", false)
  m.visitLabel(try_end)
  m.visitInsn(OP_ARETURN)
  m.visitLabel(handler)
  m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Throwable", "toString",
    "()Ljava/lang/String;", false)
  m.visitVarInsn(OP_ASTORE, 1)
  m.visitTypeInsn(OP_NEW, "Result\$Err")
  m.visitInsn(OP_DUP)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitMethodInsn(OP_INVOKESPECIAL, "Result\$Err", "<init>", "(Ljava/lang/Object;)V", false)
  m.visitInsn(OP_ARETURN)
  m.visitMaxs(0, 0)
  m.visitEnd()
  ()
}

## dawn/rt/Io: the io runtime — javaTry/catchPanic (the Throwable barriers) plus
## the io_* primitives std/io writes over (print/println/read_line/is_dir/
## read_file/write_file/list_names). These retire the handwritten dawn.rt.StdIo.
## The failing ones (read_file/write_file/list_names) simply throw; std wraps
## them in java_try, exactly as it wrapped StdIo. read_line maps Java's
## null-or-line onto Option here rather than relying on use-java null-wrapping.
pub fn gen_io_class(supers: List[String]) -> Bytes !io = {
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, IO_CLASS, obj())
  gen_try_closure(cw, "javaTry", "java/lang/Exception")
  gen_try_closure(cw, "catchPanic", "java/lang/Throwable")

  # a single shared reader: a fresh BufferedReader per call would let one call's
  # buffer swallow input the next call should see. Lazily initialised in io_read_line.
  cw.field(ACC_PRIVATE + ACC_STATIC, "stdin", "Ljava/io/BufferedReader;")

  # io_print(s) = System.out.print(s)
  let pv = open_static(cw, "io_print", "(Ljava/lang/String;)V")
  pv.visitFieldInsn(OP_GETSTATIC, "java/lang/System", "out", "Ljava/io/PrintStream;")
  pv.visitVarInsn(OP_ALOAD, 0)
  pv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/PrintStream", "print",
    "(Ljava/lang/String;)V", false)
  pv.visitInsn(OP_RETURN)
  close_mv(pv)

  # io_println(s) = System.out.println(s)
  let plv = open_static(cw, "io_println", "(Ljava/lang/String;)V")
  plv.visitFieldInsn(OP_GETSTATIC, "java/lang/System", "out", "Ljava/io/PrintStream;")
  plv.visitVarInsn(OP_ALOAD, 0)
  plv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/PrintStream", "println",
    "(Ljava/lang/String;)V", false)
  plv.visitInsn(OP_RETURN)
  close_mv(plv)

  # io_read_line(): lazily open stdin (UTF-8), one line or None at EOF
  let rlv = open_static(cw, "io_read_line", "()LOption;")
  let rl_have = Label.new()
  let rl_none = Label.new()
  rlv.visitFieldInsn(OP_GETSTATIC, IO_CLASS, "stdin", "Ljava/io/BufferedReader;")
  rlv.visitJumpInsn(OP_IFNONNULL, rl_have)
  rlv.visitTypeInsn(OP_NEW, "java/io/BufferedReader")
  rlv.visitInsn(OP_DUP)
  rlv.visitTypeInsn(OP_NEW, "java/io/InputStreamReader")
  rlv.visitInsn(OP_DUP)
  rlv.visitFieldInsn(OP_GETSTATIC, "java/lang/System", "in", "Ljava/io/InputStream;")
  rlv.visitFieldInsn(OP_GETSTATIC, "java/nio/charset/StandardCharsets", "UTF_8",
    "Ljava/nio/charset/Charset;")
  rlv.visitMethodInsn(OP_INVOKESPECIAL, "java/io/InputStreamReader", "<init>",
    "(Ljava/io/InputStream;Ljava/nio/charset/Charset;)V", false)
  rlv.visitMethodInsn(OP_INVOKESPECIAL, "java/io/BufferedReader", "<init>",
    "(Ljava/io/Reader;)V", false)
  rlv.visitFieldInsn(OP_PUTSTATIC, IO_CLASS, "stdin", "Ljava/io/BufferedReader;")
  rlv.visitLabel(rl_have)
  rlv.visitFieldInsn(OP_GETSTATIC, IO_CLASS, "stdin", "Ljava/io/BufferedReader;")
  rlv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/BufferedReader", "readLine",
    "()Ljava/lang/String;", false)
  rlv.visitVarInsn(OP_ASTORE, 0)
  rlv.visitVarInsn(OP_ALOAD, 0)
  rlv.visitJumpInsn(OP_IFNULL, rl_none)
  rlv.visitTypeInsn(OP_NEW, "Option\$Some")
  rlv.visitInsn(OP_DUP)
  rlv.visitVarInsn(OP_ALOAD, 0)
  rlv.visitMethodInsn(OP_INVOKESPECIAL, "Option\$Some", "<init>", "(Ljava/lang/Object;)V", false)
  rlv.visitInsn(OP_ARETURN)
  rlv.visitLabel(rl_none)
  rlv.visitFieldInsn(OP_GETSTATIC, "Option\$None", "INSTANCE", "LOption\$None;")
  rlv.visitInsn(OP_ARETURN)
  close_mv(rlv)

  # io_is_dir(path) = new File(path).isDirectory()
  let idv = open_static(cw, "io_is_dir", "(Ljava/lang/String;)Z")
  idv.visitTypeInsn(OP_NEW, "java/io/File")
  idv.visitInsn(OP_DUP)
  idv.visitVarInsn(OP_ALOAD, 0)
  idv.visitMethodInsn(OP_INVOKESPECIAL, "java/io/File", "<init>", "(Ljava/lang/String;)V", false)
  idv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/File", "isDirectory", "()Z", false)
  idv.visitInsn(OP_IRETURN)
  close_mv(idv)

  # io_read_file(path) = Files.readString(new File(path).toPath()) — throws on failure
  let rfv = open_static(cw, "io_read_file", "(Ljava/lang/String;)Ljava/lang/String;")
  rfv.visitTypeInsn(OP_NEW, "java/io/File")
  rfv.visitInsn(OP_DUP)
  rfv.visitVarInsn(OP_ALOAD, 0)
  rfv.visitMethodInsn(OP_INVOKESPECIAL, "java/io/File", "<init>", "(Ljava/lang/String;)V", false)
  rfv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/File", "toPath", "()Ljava/nio/file/Path;", false)
  rfv.visitMethodInsn(OP_INVOKESTATIC, "java/nio/file/Files", "readString",
    "(Ljava/nio/file/Path;)Ljava/lang/String;", false)
  rfv.visitInsn(OP_ARETURN)
  close_mv(rfv)

  # io_write_file(path, content): mkdirs parents, then Files.writeString — throws on failure
  let wfv = open_static(cw, "io_write_file", "(Ljava/lang/String;Ljava/lang/String;)V")
  let wf_skip = Label.new()
  wfv.visitTypeInsn(OP_NEW, "java/io/File")
  wfv.visitInsn(OP_DUP)
  wfv.visitVarInsn(OP_ALOAD, 0)
  wfv.visitMethodInsn(OP_INVOKESPECIAL, "java/io/File", "<init>", "(Ljava/lang/String;)V", false)
  wfv.visitVarInsn(OP_ASTORE, 2)
  wfv.visitVarInsn(OP_ALOAD, 2)
  wfv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/File", "getParentFile", "()Ljava/io/File;", false)
  wfv.visitVarInsn(OP_ASTORE, 3)
  wfv.visitVarInsn(OP_ALOAD, 3)
  wfv.visitJumpInsn(OP_IFNULL, wf_skip)
  wfv.visitVarInsn(OP_ALOAD, 3)
  wfv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/File", "mkdirs", "()Z", false)
  wfv.visitInsn(OP_POP)
  wfv.visitLabel(wf_skip)
  wfv.visitVarInsn(OP_ALOAD, 2)
  wfv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/File", "toPath", "()Ljava/nio/file/Path;", false)
  wfv.visitVarInsn(OP_ALOAD, 1)
  wfv.visitInsn(OP_ICONST_0)
  wfv.visitTypeInsn(OP_ANEWARRAY, "java/nio/file/OpenOption")
  wfv.visitMethodInsn(OP_INVOKESTATIC, "java/nio/file/Files", "writeString",
    "(Ljava/nio/file/Path;Ljava/lang/CharSequence;[Ljava/nio/file/OpenOption;)Ljava/nio/file/Path;",
    false)
  wfv.visitInsn(OP_POP)
  wfv.visitInsn(OP_RETURN)
  close_mv(wfv)

  # io_list_names(path): sorted entry names, or throw if the dir cannot be listed
  let lnv = open_static(cw, "io_list_names", "(Ljava/lang/String;)Ljava/util/List;")
  let ln_ok = Label.new()
  lnv.visitTypeInsn(OP_NEW, "java/io/File")
  lnv.visitInsn(OP_DUP)
  lnv.visitVarInsn(OP_ALOAD, 0)
  lnv.visitMethodInsn(OP_INVOKESPECIAL, "java/io/File", "<init>", "(Ljava/lang/String;)V", false)
  lnv.visitMethodInsn(OP_INVOKEVIRTUAL, "java/io/File", "list", "()[Ljava/lang/String;", false)
  lnv.visitVarInsn(OP_ASTORE, 1)
  lnv.visitVarInsn(OP_ALOAD, 1)
  lnv.visitJumpInsn(OP_IFNONNULL, ln_ok)
  lnv.visitTypeInsn(OP_NEW, "java/io/IOException")
  lnv.visitInsn(OP_DUP)
  lnv.visitVarInsn(OP_ALOAD, 0)
  lnv.visitMethodInsn(OP_INVOKESPECIAL, "java/io/IOException", "<init>",
    "(Ljava/lang/String;)V", false)
  lnv.visitInsn(OP_ATHROW)
  lnv.visitLabel(ln_ok)
  lnv.visitVarInsn(OP_ALOAD, 1)
  lnv.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "sort", "([Ljava/lang/Object;)V", false)
  lnv.visitVarInsn(OP_ALOAD, 1)
  lnv.visitMethodInsn(OP_INVOKESTATIC, LISTS_CLASS, "fromArray",
    "([Ljava/lang/String;)Ljava/util/List;", false)
  lnv.visitInsn(OP_ARETURN)
  close_mv(lnv)

  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

pub const ARRAYLIST: String = "java/util/ArrayList"

pub const DAWNLIST_CLASS: String = "dawn/rt/DawnList"

pub const ARRAY_CLASS: String = "dawn/rt/Array"

pub const ATOMIC_INT: String = "java/util/concurrent/atomic/AtomicInteger"

pub const OP_AALOAD: Int = 50

pub const OP_AASTORE: Int = 83

pub const OP_IF_ICMPLE: Int = 164

pub const OP_ICONST_2: Int = 5

## The smallest backing store a copy hands out, so the first few pushes onto a
## fresh array do not each reallocate.
const ARRAY_MIN_CAP: Int = 8

fn array_ctor_desc() -> String = "([Ljava/lang/Object;L" ++ ATOMIC_INT ++ ";I)V"

## `new dawn/rt/Array(a, used, len)` from three values already on the stack in
## that order -- factored out because push builds one on each of its two paths.
fn array_wrap_desc() -> String = "L" ++ ARRAY_CLASS ++ ";"

## Throw a PanicError whose message is `prefix ++ i ++ " out of bounds for
## length " ++ v.len`, with the array in local 0 and the index in local `ivar`.
fn array_bounds_panic(m: MethodVisitor, prefix: String, ivar: Int) -> Unit !io = {
  m.visitTypeInsn(OP_NEW, PANIC_CLASS)
  m.visitInsn(OP_DUP)
  m.visitTypeInsn(OP_NEW, SB)
  m.visitInsn(OP_DUP)
  m.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  append_const(m, prefix)
  m.visitVarInsn(OP_LLOAD, ivar)
  m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(J)L" ++ SB ++ ";", false)
  append_const(m, " out of bounds for length ")
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "len", "I")
  m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(I)L" ++ SB ++ ";", false)
  m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  m.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>", "(Ljava/lang/String;)V", false)
  m.visitInsn(OP_ATHROW)
  ()
}

## dawn/rt/Array: the whole collection contract a backend owes the language
## (docs/native-backend-plan.md D1). std builds List/Map/Set on top of this, so
## a second backend implements one immutable vector rather than ~20 collection
## intrinsics.
##
## A value is a window `a[0, len)` over a backing store that neighbouring
## versions share; `used` counts the slots claimed across every version sharing
## `a`. That is DawnList's representation, and it is here for DawnList's reason:
## `array_push` may extend in place exactly when this version ends where the
## shared region ends, which is the one-owner-at-a-time case an accumulation
## loop produces (measured 99.1% of the compiler's appends,
## docs/collections-dejava-research.md §9.5). Losing the CAS costs a copy, not
## correctness -- a published array never changes, whatever its successors do.
##
## `array_with` always copies, and that asymmetry is the point: slot `i < len`
## has already been handed to this version and possibly others, so no
## watermark can tell whether anyone still reads it. Only a backend that knows
## the value is uniquely owned may write it in place -- which on native is
## Perceus' rc==1, and on the JVM is nothing. The append path is where the 12x
## lives, so this is a cost the measurements say we can pay.
pub fn gen_array_class(supers: List[String]) -> Bytes !io = {
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, ARRAY_CLASS, obj())
  cw.field(ACC_PRIVATE + ACC_FINAL, "a", "[Ljava/lang/Object;")
  cw.field(ACC_PRIVATE + ACC_FINAL, "used", "L" ++ ATOMIC_INT ++ ";")
  cw.field(ACC_PRIVATE + ACC_FINAL, "len", "I")

  let init = cw.method(ACC_PRIVATE, "<init>", array_ctor_desc()).expect("mv")
  init.visitCode()
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitVarInsn(OP_ALOAD, 1)
  init.visitFieldInsn(OP_PUTFIELD, ARRAY_CLASS, "a", "[Ljava/lang/Object;")
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitVarInsn(OP_ALOAD, 2)
  init.visitFieldInsn(OP_PUTFIELD, ARRAY_CLASS, "used", "L" ++ ATOMIC_INT ++ ";")
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitVarInsn(OP_ILOAD, 3)
  init.visitFieldInsn(OP_PUTFIELD, ARRAY_CLASS, "len", "I")
  init.visitInsn(OP_RETURN)
  close_mv(init)

  # array_new() -> the empty array
  let nv = open_static(cw, "array_new", "()" ++ array_wrap_desc())
  nv.visitTypeInsn(OP_NEW, ARRAY_CLASS)
  nv.visitInsn(OP_DUP)
  nv.visitInsn(OP_ICONST_0)
  nv.visitTypeInsn(OP_ANEWARRAY, obj())
  gen_new_watermark(nv, OP_ICONST_0)
  nv.visitInsn(OP_ICONST_0)
  nv.visitMethodInsn(OP_INVOKESPECIAL, ARRAY_CLASS, "<init>", array_ctor_desc(), false)
  nv.visitInsn(OP_ARETURN)
  close_mv(nv)

  # array_len(v) = v.len
  let lv = open_static(cw, "array_len", "(" ++ array_wrap_desc() ++ ")J")
  lv.visitVarInsn(OP_ALOAD, 0)
  lv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "len", "I")
  lv.visitInsn(OP_I2L)
  lv.visitInsn(OP_LRETURN)
  close_mv(lv)

  gen_array_get(cw)
  gen_array_push(cw)
  gen_array_with(cw)

  # popcount(n) = Long.bitCount(n)
  let pc = open_static(cw, "popcount", "(J)J")
  pc.visitVarInsn(OP_LLOAD, 0)
  pc.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "bitCount", "(J)I", false)
  pc.visitInsn(OP_I2L)
  pc.visitInsn(OP_LRETURN)
  close_mv(pc)

  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

## `new AtomicInteger(<the int the given opcode pushes>)`, left on the stack.
fn gen_new_watermark(m: MethodVisitor, push_op: Int) -> Unit !io = {
  m.visitTypeInsn(OP_NEW, ATOMIC_INT)
  m.visitInsn(OP_DUP)
  m.visitInsn(push_op)
  m.visitMethodInsn(OP_INVOKESPECIAL, ATOMIC_INT, "<init>", "(I)V", false)
  ()
}

## array_get(v, i) -> v.a[i], panicking out of bounds like `xs[i]` does.
fn gen_array_get(cw: AdtClassWriter) -> Unit !io = {
  let gv = open_static(cw, "array_get", "(" ++ array_wrap_desc() ++ "J)Ljava/lang/Object;")
  let bad = Label.new()
  gv.visitVarInsn(OP_LLOAD, 1)
  gv.visitInsn(OP_LCONST_0)
  gv.visitInsn(OP_LCMP)
  gv.visitJumpInsn(OP_IFLT, bad)
  gv.visitVarInsn(OP_LLOAD, 1)
  gv.visitVarInsn(OP_ALOAD, 0)
  gv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "len", "I")
  gv.visitInsn(OP_I2L)
  gv.visitInsn(OP_LCMP)
  gv.visitJumpInsn(OP_IFGE, bad)
  gv.visitVarInsn(OP_ALOAD, 0)
  gv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "a", "[Ljava/lang/Object;")
  gv.visitVarInsn(OP_LLOAD, 1)
  gv.visitInsn(OP_L2I)
  gv.visitInsn(OP_AALOAD)
  gv.visitInsn(OP_ARETURN)
  gv.visitLabel(bad)
  array_bounds_panic(gv, "array index ", 1)
  close_mv(gv)
}

## array_push(v, x) -> v with x appended. Extends in place when this version
## ends at the shared watermark and the store has room; otherwise copies into a
## store with slack, so the *next* push is cheap either way.
fn gen_array_push(cw: AdtClassWriter) -> Unit !io = {
  let pv = open_static(cw, "array_push",
    "(" ++ array_wrap_desc() ++ "Ljava/lang/Object;)" ++ array_wrap_desc())
  let slow = Label.new()
  pv.visitVarInsn(OP_ALOAD, 0)
  pv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "len", "I")
  pv.visitVarInsn(OP_ISTORE, 2)

  # room in the store?
  pv.visitVarInsn(OP_ALOAD, 0)
  pv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "a", "[Ljava/lang/Object;")
  pv.visitInsn(OP_ARRAYLENGTH)
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitJumpInsn(OP_IF_ICMPLE, slow)
  # claim slot len for this thread alone
  pv.visitVarInsn(OP_ALOAD, 0)
  pv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "used", "L" ++ ATOMIC_INT ++ ";")
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitInsn(OP_ICONST_1)
  pv.visitInsn(OP_IADD)
  pv.visitMethodInsn(OP_INVOKEVIRTUAL, ATOMIC_INT, "compareAndSet", "(II)Z", false)
  pv.visitJumpInsn(OP_IFEQ, slow)
  pv.visitVarInsn(OP_ALOAD, 0)
  pv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "a", "[Ljava/lang/Object;")
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitVarInsn(OP_ALOAD, 1)
  pv.visitInsn(OP_AASTORE)
  pv.visitTypeInsn(OP_NEW, ARRAY_CLASS)
  pv.visitInsn(OP_DUP)
  pv.visitVarInsn(OP_ALOAD, 0)
  pv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "a", "[Ljava/lang/Object;")
  pv.visitVarInsn(OP_ALOAD, 0)
  pv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "used", "L" ++ ATOMIC_INT ++ ";")
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitInsn(OP_ICONST_1)
  pv.visitInsn(OP_IADD)
  pv.visitMethodInsn(OP_INVOKESPECIAL, ARRAY_CLASS, "<init>", array_ctor_desc(), false)
  pv.visitInsn(OP_ARETURN)

  pv.visitLabel(slow)
  pv.visitIntInsn(OP_BIPUSH, ARRAY_MIN_CAP)
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitInsn(OP_ICONST_1)
  pv.visitInsn(OP_IADD)
  pv.visitInsn(OP_ICONST_2)
  pv.visitInsn(OP_IMUL)
  pv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Math", "max", "(II)I", false)
  pv.visitTypeInsn(OP_ANEWARRAY, obj())
  pv.visitVarInsn(OP_ASTORE, 3)
  pv.visitVarInsn(OP_ALOAD, 0)
  pv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "a", "[Ljava/lang/Object;")
  pv.visitInsn(OP_ICONST_0)
  pv.visitVarInsn(OP_ALOAD, 3)
  pv.visitInsn(OP_ICONST_0)
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/System", "arraycopy",
    "(Ljava/lang/Object;ILjava/lang/Object;II)V", false)
  pv.visitVarInsn(OP_ALOAD, 3)
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitVarInsn(OP_ALOAD, 1)
  pv.visitInsn(OP_AASTORE)
  pv.visitTypeInsn(OP_NEW, ARRAY_CLASS)
  pv.visitInsn(OP_DUP)
  pv.visitVarInsn(OP_ALOAD, 3)
  pv.visitTypeInsn(OP_NEW, ATOMIC_INT)
  pv.visitInsn(OP_DUP)
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitInsn(OP_ICONST_1)
  pv.visitInsn(OP_IADD)
  pv.visitMethodInsn(OP_INVOKESPECIAL, ATOMIC_INT, "<init>", "(I)V", false)
  pv.visitVarInsn(OP_ILOAD, 2)
  pv.visitInsn(OP_ICONST_1)
  pv.visitInsn(OP_IADD)
  pv.visitMethodInsn(OP_INVOKESPECIAL, ARRAY_CLASS, "<init>", array_ctor_desc(), false)
  pv.visitInsn(OP_ARETURN)
  close_mv(pv)
}

## array_with(v, i, x) -> v with slot i replaced. Always copies on this
## backend; see the class comment for why the watermark cannot help here.
fn gen_array_with(cw: AdtClassWriter) -> Unit !io = {
  let wv = open_static(cw, "array_with",
    "(" ++ array_wrap_desc() ++ "JLjava/lang/Object;)" ++ array_wrap_desc())
  let bad = Label.new()
  wv.visitVarInsn(OP_ALOAD, 0)
  wv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "len", "I")
  wv.visitVarInsn(OP_ISTORE, 4)
  wv.visitVarInsn(OP_LLOAD, 1)
  wv.visitInsn(OP_LCONST_0)
  wv.visitInsn(OP_LCMP)
  wv.visitJumpInsn(OP_IFLT, bad)
  wv.visitVarInsn(OP_LLOAD, 1)
  wv.visitVarInsn(OP_ILOAD, 4)
  wv.visitInsn(OP_I2L)
  wv.visitInsn(OP_LCMP)
  wv.visitJumpInsn(OP_IFGE, bad)
  wv.visitVarInsn(OP_ALOAD, 0)
  wv.visitFieldInsn(OP_GETFIELD, ARRAY_CLASS, "a", "[Ljava/lang/Object;")
  wv.visitVarInsn(OP_ILOAD, 4)
  wv.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "copyOf",
    "([Ljava/lang/Object;I)[Ljava/lang/Object;", false)
  wv.visitVarInsn(OP_ASTORE, 5)
  wv.visitVarInsn(OP_ALOAD, 5)
  wv.visitVarInsn(OP_LLOAD, 1)
  wv.visitInsn(OP_L2I)
  wv.visitVarInsn(OP_ALOAD, 3)
  wv.visitInsn(OP_AASTORE)
  wv.visitTypeInsn(OP_NEW, ARRAY_CLASS)
  wv.visitInsn(OP_DUP)
  wv.visitVarInsn(OP_ALOAD, 5)
  wv.visitTypeInsn(OP_NEW, ATOMIC_INT)
  wv.visitInsn(OP_DUP)
  wv.visitVarInsn(OP_ILOAD, 4)
  wv.visitMethodInsn(OP_INVOKESPECIAL, ATOMIC_INT, "<init>", "(I)V", false)
  wv.visitVarInsn(OP_ILOAD, 4)
  wv.visitMethodInsn(OP_INVOKESPECIAL, ARRAY_CLASS, "<init>", array_ctor_desc(), false)
  wv.visitInsn(OP_ARETURN)
  wv.visitLabel(bad)
  array_bounds_panic(wv, "array index ", 1)
  close_mv(wv)
}

## sortBy for dawn/rt/Lists — the ordering substrate std/list's sort delegates to.
fn gen_list_ordering(cw: AdtClassWriter) -> Unit !io = {
  # sortBy(List xs, Fn2 cmp) -> List — stable (TimSort under the hood)
  let sb2 = cw.method(ACC_PUBLIC + ACC_STATIC, "sortBy",
    "(Ljava/util/List;L" ++ fn_iface(2) ++ ";)Ljava/util/List;").expect("mv")
  sb2.visitCode()
  sb2.visitTypeInsn(OP_NEW, ARRAYLIST)
  sb2.visitInsn(OP_DUP)
  sb2.visitVarInsn(OP_ALOAD, 0)
  sb2.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "(Ljava/util/Collection;)V", false)
  sb2.visitVarInsn(OP_ASTORE, 2)
  sb2.visitVarInsn(OP_ALOAD, 2)
  sb2.visitTypeInsn(OP_NEW, FN_CMP_CLASS)
  sb2.visitInsn(OP_DUP)
  sb2.visitVarInsn(OP_ALOAD, 1)
  sb2.visitMethodInsn(OP_INVOKESPECIAL, FN_CMP_CLASS, "<init>",
    "(L" ++ fn_iface(2) ++ ";)V", false)
  sb2.visitMethodInsn(OP_INVOKEVIRTUAL, ARRAYLIST, "sort", "(Ljava/util/Comparator;)V", false)
  sb2.visitVarInsn(OP_ALOAD, 2)
  sb2.visitInsn(OP_ARETURN)
  sb2.visitMaxs(0, 0)
  sb2.visitEnd()
  ()
}

## dawn/rt/Lists: get (bounds-checked Option), index (panicking `xs[i]`),
## range, fromArray (CLI args), slice (list-pattern rest), the ordering
## family, and concat (delegates to DawnList's owned-tail append).
pub fn gen_lists_class(supers: List[String]) -> Bytes !io = {
  let jlist = "java/util/List"
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, LISTS_CLASS, obj())

  let g = cw.method(ACC_PUBLIC + ACC_STATIC, "get", "(Ljava/util/List;J)LOption;").expect("mv")
  g.visitCode()
  let g_none = Label.new()
  g.visitVarInsn(OP_LLOAD, 1)
  g.visitInsn(OP_LCONST_0)
  g.visitInsn(OP_LCMP)
  g.visitJumpInsn(OP_IFLT, g_none)
  g.visitVarInsn(OP_LLOAD, 1)
  g.visitVarInsn(OP_ALOAD, 0)
  g.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "size", "()I", true)
  g.visitInsn(OP_I2L)
  g.visitInsn(OP_LCMP)
  g.visitJumpInsn(OP_IFGE, g_none)
  g.visitTypeInsn(OP_NEW, "Option\$Some")
  g.visitInsn(OP_DUP)
  g.visitVarInsn(OP_ALOAD, 0)
  g.visitVarInsn(OP_LLOAD, 1)
  g.visitInsn(OP_L2I)
  g.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "get", "(I)Ljava/lang/Object;", true)
  g.visitMethodInsn(OP_INVOKESPECIAL, "Option\$Some", "<init>", "(Ljava/lang/Object;)V", false)
  g.visitInsn(OP_ARETURN)
  g.visitLabel(g_none)
  g.visitFieldInsn(OP_GETSTATIC, "Option\$None", "INSTANCE", "LOption\$None;")
  g.visitInsn(OP_ARETURN)
  g.visitMaxs(0, 0)
  g.visitEnd()

  # index(List, long) -> Object: the `xs[i]` operator — panics when out of bounds
  let ix = cw.method(ACC_PUBLIC + ACC_STATIC, "index",
    "(Ljava/util/List;J)Ljava/lang/Object;").expect("mv")
  ix.visitCode()
  let i_bad = Label.new()
  ix.visitVarInsn(OP_LLOAD, 1)
  ix.visitInsn(OP_LCONST_0)
  ix.visitInsn(OP_LCMP)
  ix.visitJumpInsn(OP_IFLT, i_bad)
  ix.visitVarInsn(OP_LLOAD, 1)
  ix.visitVarInsn(OP_ALOAD, 0)
  ix.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "size", "()I", true)
  ix.visitInsn(OP_I2L)
  ix.visitInsn(OP_LCMP)
  ix.visitJumpInsn(OP_IFGE, i_bad)
  ix.visitVarInsn(OP_ALOAD, 0)
  ix.visitVarInsn(OP_LLOAD, 1)
  ix.visitInsn(OP_L2I)
  ix.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "get", "(I)Ljava/lang/Object;", true)
  ix.visitInsn(OP_ARETURN)
  ix.visitLabel(i_bad)
  ix.visitTypeInsn(OP_NEW, PANIC_CLASS)
  ix.visitInsn(OP_DUP)
  ix.visitTypeInsn(OP_NEW, SB)
  ix.visitInsn(OP_DUP)
  ix.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  append_const(ix, "index ")
  ix.visitVarInsn(OP_LLOAD, 1)
  ix.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(J)L" ++ SB ++ ";", false)
  append_const(ix, " out of bounds for length ")
  ix.visitVarInsn(OP_ALOAD, 0)
  ix.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "size", "()I", true)
  ix.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(I)L" ++ SB ++ ";", false)
  ix.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  ix.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>", "(Ljava/lang/String;)V", false)
  ix.visitInsn(OP_ATHROW)
  ix.visitMaxs(0, 0)
  ix.visitEnd()

  let rg = cw.method(ACC_PUBLIC + ACC_STATIC, "range", "(JJ)Ljava/util/List;").expect("mv")
  rg.visitCode()
  rg.visitTypeInsn(OP_NEW, ARRAYLIST)
  rg.visitInsn(OP_DUP)
  rg.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "()V", false)
  rg.visitVarInsn(OP_ASTORE, 4)
  rg.visitVarInsn(OP_LLOAD, 0)
  rg.visitVarInsn(OP_LSTORE, 5)
  let r_loop = Label.new()
  let r_done = Label.new()
  rg.visitLabel(r_loop)
  rg.visitVarInsn(OP_LLOAD, 5)
  rg.visitVarInsn(OP_LLOAD, 2)
  rg.visitInsn(OP_LCMP)
  rg.visitJumpInsn(OP_IFGE, r_done)
  rg.visitVarInsn(OP_ALOAD, 4)
  rg.visitVarInsn(OP_LLOAD, 5)
  rg.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;", false)
  rg.visitMethodInsn(OP_INVOKEVIRTUAL, ARRAYLIST, "add", "(Ljava/lang/Object;)Z", false)
  rg.visitInsn(OP_POP)
  rg.visitVarInsn(OP_LLOAD, 5)
  rg.visitInsn(OP_LCONST_1)
  rg.visitInsn(OP_LADD)
  rg.visitVarInsn(OP_LSTORE, 5)
  rg.visitJumpInsn(OP_GOTO, r_loop)
  rg.visitLabel(r_done)
  rg.visitVarInsn(OP_ALOAD, 4)
  rg.visitInsn(OP_ARETURN)
  rg.visitMaxs(0, 0)
  rg.visitEnd()

  # fromArray(String[]) -> List — CLI args; null (no JVM wrapper ran) → []
  let fa = cw.method(ACC_PUBLIC + ACC_STATIC, "fromArray",
    "([Ljava/lang/String;)Ljava/util/List;").expect("mv")
  fa.visitCode()
  let fa_null = Label.new()
  fa.visitVarInsn(OP_ALOAD, 0)
  fa.visitJumpInsn(OP_IFNULL, fa_null)
  fa.visitTypeInsn(OP_NEW, ARRAYLIST)
  fa.visitInsn(OP_DUP)
  fa.visitVarInsn(OP_ALOAD, 0)
  fa.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "asList",
    "([Ljava/lang/Object;)Ljava/util/List;", false)
  fa.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "(Ljava/util/Collection;)V", false)
  fa.visitInsn(OP_ARETURN)
  fa.visitLabel(fa_null)
  fa.visitTypeInsn(OP_NEW, ARRAYLIST)
  fa.visitInsn(OP_DUP)
  fa.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "()V", false)
  fa.visitInsn(OP_ARETURN)
  fa.visitMaxs(0, 0)
  fa.visitEnd()

  # slice(List, int from, int to) -> List — the `..rest` middle of a list pattern
  let sc = cw.method(ACC_PUBLIC + ACC_STATIC, "slice",
    "(Ljava/util/List;II)Ljava/util/List;").expect("mv")
  sc.visitCode()
  sc.visitTypeInsn(OP_NEW, ARRAYLIST)
  sc.visitInsn(OP_DUP)
  sc.visitVarInsn(OP_ALOAD, 0)
  sc.visitVarInsn(OP_ILOAD, 1)
  sc.visitVarInsn(OP_ILOAD, 2)
  sc.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "subList", "(II)Ljava/util/List;", true)
  sc.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "(Ljava/util/Collection;)V", false)
  sc.visitInsn(OP_ARETURN)
  sc.visitMaxs(0, 0)
  sc.visitEnd()

  gen_list_ordering(cw)

  # concat delegates to DawnList: appends in place when the left side is the
  # sole owner of its tail, keeping `acc = acc ++ [x]` linear
  let ct = cw.method(ACC_PUBLIC + ACC_STATIC, "concat",
    "(Ljava/util/List;Ljava/util/List;)Ljava/util/List;").expect("mv")
  ct.visitCode()
  ct.visitVarInsn(OP_ALOAD, 0)
  ct.visitVarInsn(OP_ALOAD, 1)
  ct.visitMethodInsn(OP_INVOKESTATIC, DAWNLIST_CLASS, "concat",
    "(Ljava/util/List;Ljava/util/List;)Ljava/util/List;", false)
  ct.visitInsn(OP_ARETURN)
  ct.visitMaxs(0, 0)
  ct.visitEnd()

  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

## parseInt / parseFloat: try/strip/parse/box, NumberFormatException → None.
fn gen_parse_method(
  cw: AdtClassWriter,
  name: String,
  box: String,
  parse: String,
  parse_desc: String,
  value_of_desc: String
) -> Unit !io = {
  let m = cw.method(ACC_PUBLIC + ACC_STATIC, name, "(Ljava/lang/String;)LOption;").expect("mv")
  m.visitCode()
  let try_start = Label.new()
  let try_end = Label.new()
  let handler = Label.new()
  m.visitTryCatchBlock(try_start, try_end, handler, "java/lang/NumberFormatException")
  m.visitLabel(try_start)
  m.visitTypeInsn(OP_NEW, "Option\$Some")
  m.visitInsn(OP_DUP)
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/String", "strip", "()Ljava/lang/String;", false)
  m.visitMethodInsn(OP_INVOKESTATIC, box, parse, parse_desc, false)
  m.visitMethodInsn(OP_INVOKESTATIC, box, "valueOf", value_of_desc, false)
  m.visitMethodInsn(OP_INVOKESPECIAL, "Option\$Some", "<init>", "(Ljava/lang/Object;)V", false)
  m.visitLabel(try_end)
  m.visitInsn(OP_ARETURN)
  m.visitLabel(handler)
  m.visitInsn(OP_POP)
  m.visitFieldInsn(OP_GETSTATIC, "Option\$None", "INSTANCE", "LOption\$None;")
  m.visitInsn(OP_ARETURN)
  m.visitMaxs(0, 0)
  m.visitEnd()
  ()
}

## parseIntRadix(s, radix): Long.parseLong(s.strip(), (int) radix), with the
## same NumberFormatException → None shape as gen_parse_method. Separate because
## the radix argument makes the descriptor and the loads differ throughout.
fn gen_parse_radix_method(cw: AdtClassWriter) -> Unit !io = {
  let m = cw.method(ACC_PUBLIC + ACC_STATIC, "parseIntRadix",
    "(Ljava/lang/String;J)LOption;").expect("mv")
  m.visitCode()
  let try_start = Label.new()
  let try_end = Label.new()
  let handler = Label.new()
  m.visitTryCatchBlock(try_start, try_end, handler, "java/lang/NumberFormatException")
  m.visitLabel(try_start)
  m.visitTypeInsn(OP_NEW, "Option\$Some")
  m.visitInsn(OP_DUP)
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/String", "strip", "()Ljava/lang/String;", false)
  m.visitVarInsn(OP_LLOAD, 1)
  m.visitInsn(OP_L2I)
  m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "parseLong",
    "(Ljava/lang/String;I)J", false)
  m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;", false)
  m.visitMethodInsn(OP_INVOKESPECIAL, "Option\$Some", "<init>", "(Ljava/lang/Object;)V", false)
  m.visitLabel(try_end)
  m.visitInsn(OP_ARETURN)
  m.visitLabel(handler)
  m.visitInsn(OP_POP)
  m.visitFieldInsn(OP_GETSTATIC, "Option\$None", "INSTANCE", "LOption\$None;")
  m.visitInsn(OP_ARETURN)
  m.visitMaxs(0, 0)
  m.visitEnd()
  ()
}

## dawn/rt/Strings: the string runtime — join, indexOfFrom (sentinel → Option),
## parseInt/parseFloat, code_points/from_code_points, the cursor family, and the
## str_* primitives. Owns every string operation the language names (spec §1.5,
## §11); nothing is vendored in handwritten Java any more.
pub fn gen_strings_class(supers: List[String]) -> Bytes !io = {
  let jstr = "java/lang/String"
  let jlist = "java/util/List"
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, STRINGS_CLASS, obj())

  let jn = cw.method(ACC_PUBLIC + ACC_STATIC, "join",
    "(Ljava/util/List;Ljava/lang/String;)Ljava/lang/String;").expect("mv")
  jn.visitCode()
  jn.visitTypeInsn(OP_NEW, SB)
  jn.visitInsn(OP_DUP)
  jn.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  jn.visitVarInsn(OP_ASTORE, 2)
  jn.visitInsn(OP_ICONST_0)
  jn.visitVarInsn(OP_ISTORE, 3)
  let j_loop = Label.new()
  let j_done = Label.new()
  let j_no_sep = Label.new()
  jn.visitLabel(j_loop)
  jn.visitVarInsn(OP_ILOAD, 3)
  jn.visitVarInsn(OP_ALOAD, 0)
  jn.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "size", "()I", true)
  jn.visitJumpInsn(OP_IF_ICMPGE, j_done)
  jn.visitVarInsn(OP_ILOAD, 3)
  jn.visitJumpInsn(OP_IFEQ, j_no_sep)
  jn.visitVarInsn(OP_ALOAD, 2)
  jn.visitVarInsn(OP_ALOAD, 1)
  jn.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  jn.visitInsn(OP_POP)
  jn.visitLabel(j_no_sep)
  jn.visitVarInsn(OP_ALOAD, 2)
  jn.visitVarInsn(OP_ALOAD, 0)
  jn.visitVarInsn(OP_ILOAD, 3)
  jn.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "get", "(I)Ljava/lang/Object;", true)
  jn.visitTypeInsn(OP_CHECKCAST, jstr)
  jn.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  jn.visitInsn(OP_POP)
  jn.visitIincInsn(3, 1)
  jn.visitJumpInsn(OP_GOTO, j_loop)
  jn.visitLabel(j_done)
  jn.visitVarInsn(OP_ALOAD, 2)
  jn.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  jn.visitInsn(OP_ARETURN)
  jn.visitMaxs(0, 0)
  jn.visitEnd()

  # indexOfFrom: negative sentinel from indexOfFromRaw becomes None
  let io2 = cw.method(ACC_PUBLIC + ACC_STATIC, "indexOfFrom",
    "(Ljava/lang/String;Ljava/lang/String;J)LOption;").expect("mv")
  io2.visitCode()
  io2.visitVarInsn(OP_ALOAD, 0)
  io2.visitVarInsn(OP_ALOAD, 1)
  io2.visitVarInsn(OP_LLOAD, 2)
  io2.visitMethodInsn(OP_INVOKESTATIC, STRINGS_CLASS, "indexOfFromRaw",
    "(Ljava/lang/String;Ljava/lang/String;J)J", false)
  io2.visitVarInsn(OP_LSTORE, 4)
  let n_none = Label.new()
  io2.visitVarInsn(OP_LLOAD, 4)
  io2.visitInsn(OP_LCONST_0)
  io2.visitInsn(OP_LCMP)
  io2.visitJumpInsn(OP_IFLT, n_none)
  io2.visitTypeInsn(OP_NEW, "Option\$Some")
  io2.visitInsn(OP_DUP)
  io2.visitVarInsn(OP_LLOAD, 4)
  io2.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;", false)
  io2.visitMethodInsn(OP_INVOKESPECIAL, "Option\$Some", "<init>", "(Ljava/lang/Object;)V", false)
  io2.visitInsn(OP_ARETURN)
  io2.visitLabel(n_none)
  io2.visitFieldInsn(OP_GETSTATIC, "Option\$None", "INSTANCE", "LOption\$None;")
  io2.visitInsn(OP_ARETURN)
  io2.visitMaxs(0, 0)
  io2.visitEnd()

  gen_parse_method(cw, "parseInt", "java/lang/Long", "parseLong",
    "(Ljava/lang/String;)J", "(J)Ljava/lang/Long;")
  gen_parse_method(cw, "parseFloat", "java/lang/Double", "parseDouble",
    "(Ljava/lang/String;)D", "(D)Ljava/lang/Double;")
  gen_parse_radix_method(cw)

  # code_points(String) -> List[Int]: one Long-boxed code point per element
  let cp = cw.method(ACC_PUBLIC + ACC_STATIC, "code_points",
    "(Ljava/lang/String;)Ljava/util/List;").expect("mv")
  cp.visitCode()
  cp.visitTypeInsn(OP_NEW, ARRAYLIST)
  cp.visitInsn(OP_DUP)
  cp.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "()V", false)
  cp.visitVarInsn(OP_ASTORE, 1)
  cp.visitInsn(OP_ICONST_0)
  cp.visitVarInsn(OP_ISTORE, 2)
  let c_loop = Label.new()
  let c_done = Label.new()
  cp.visitLabel(c_loop)
  cp.visitVarInsn(OP_ILOAD, 2)
  cp.visitVarInsn(OP_ALOAD, 0)
  cp.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cp.visitJumpInsn(OP_IF_ICMPGE, c_done)
  cp.visitVarInsn(OP_ALOAD, 0)
  cp.visitVarInsn(OP_ILOAD, 2)
  cp.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "codePointAt", "(I)I", false)
  cp.visitVarInsn(OP_ISTORE, 3)
  cp.visitVarInsn(OP_ALOAD, 1)
  cp.visitVarInsn(OP_ILOAD, 3)
  cp.visitInsn(OP_I2L)
  cp.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;", false)
  cp.visitMethodInsn(OP_INVOKEVIRTUAL, ARRAYLIST, "add", "(Ljava/lang/Object;)Z", false)
  cp.visitInsn(OP_POP)
  cp.visitVarInsn(OP_ILOAD, 2)
  cp.visitVarInsn(OP_ILOAD, 3)
  cp.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Character", "charCount", "(I)I", false)
  cp.visitInsn(OP_IADD)
  cp.visitVarInsn(OP_ISTORE, 2)
  cp.visitJumpInsn(OP_GOTO, c_loop)
  cp.visitLabel(c_done)
  cp.visitVarInsn(OP_ALOAD, 1)
  cp.visitInsn(OP_ARETURN)
  cp.visitMaxs(0, 0)
  cp.visitEnd()

  # from_code_points(List[Int]) -> String
  let fc = cw.method(ACC_PUBLIC + ACC_STATIC, "from_code_points",
    "(Ljava/util/List;)Ljava/lang/String;").expect("mv")
  fc.visitCode()
  fc.visitTypeInsn(OP_NEW, SB)
  fc.visitInsn(OP_DUP)
  fc.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  fc.visitVarInsn(OP_ASTORE, 1)
  fc.visitInsn(OP_ICONST_0)
  fc.visitVarInsn(OP_ISTORE, 2)
  let f_loop = Label.new()
  let f_done = Label.new()
  fc.visitLabel(f_loop)
  fc.visitVarInsn(OP_ILOAD, 2)
  fc.visitVarInsn(OP_ALOAD, 0)
  fc.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "size", "()I", true)
  fc.visitJumpInsn(OP_IF_ICMPGE, f_done)
  fc.visitVarInsn(OP_ALOAD, 1)
  fc.visitVarInsn(OP_ALOAD, 0)
  fc.visitVarInsn(OP_ILOAD, 2)
  fc.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "get", "(I)Ljava/lang/Object;", true)
  fc.visitTypeInsn(OP_CHECKCAST, "java/lang/Long")
  fc.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Long", "intValue", "()I", false)
  fc.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "appendCodePoint", "(I)L" ++ SB ++ ";", false)
  fc.visitInsn(OP_POP)
  fc.visitIincInsn(2, 1)
  fc.visitJumpInsn(OP_GOTO, f_loop)
  fc.visitLabel(f_done)
  fc.visitVarInsn(OP_ALOAD, 1)
  fc.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  fc.visitInsn(OP_ARETURN)
  fc.visitMaxs(0, 0)
  fc.visitEnd()

  # ---- cursors ----
  # A cursor is a UTF-16 offset into `s`, handed to Dawn as an opaque Int (a JVM
  # long). These were vendored on `dawn.rt.StdStrings`; emitting them here keeps
  # every string primitive backend-local (no handwritten Java in the chain), so
  # the cursor_* builtins and code_points now share one owner. The semantics are
  # StdStrings' verbatim, character-boundary and surrogate handling included.
  let jchar = "java/lang/Character"

  # cursorStart(s) = 0
  let csv = open_static(cw, "cursorStart", "(Ljava/lang/String;)J")
  csv.visitInsn(OP_LCONST_0)
  csv.visitInsn(OP_LRETURN)
  close_mv(csv)

  # cursorEnd(s) = (long) s.length()
  let cev = open_static(cw, "cursorEnd", "(Ljava/lang/String;)J")
  cev.visitVarInsn(OP_ALOAD, 0)
  cev.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cev.visitInsn(OP_I2L)
  cev.visitInsn(OP_LRETURN)
  close_mv(cev)

  # cursorDone(s, c) = c < 0 || c >= s.length()
  let cdv = open_static(cw, "cursorDone", "(Ljava/lang/String;J)Z")
  let cd_true = Label.new()
  cdv.visitVarInsn(OP_LLOAD, 1)
  cdv.visitInsn(OP_LCONST_0)
  cdv.visitInsn(OP_LCMP)
  cdv.visitJumpInsn(OP_IFLT, cd_true)
  cdv.visitVarInsn(OP_LLOAD, 1)
  cdv.visitVarInsn(OP_ALOAD, 0)
  cdv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cdv.visitInsn(OP_I2L)
  cdv.visitInsn(OP_LCMP)
  cdv.visitJumpInsn(OP_IFGE, cd_true)
  cdv.visitInsn(OP_ICONST_0)
  cdv.visitInsn(OP_IRETURN)
  cdv.visitLabel(cd_true)
  cdv.visitInsn(OP_ICONST_1)
  cdv.visitInsn(OP_IRETURN)
  close_mv(cdv)

  # cursorChar(s, c) = (c < 0 || c >= len) ? -1 : s.codePointAt((int) c)
  let ccv = open_static(cw, "cursorChar", "(Ljava/lang/String;J)J")
  let cc_neg = Label.new()
  ccv.visitVarInsn(OP_LLOAD, 1)
  ccv.visitInsn(OP_LCONST_0)
  ccv.visitInsn(OP_LCMP)
  ccv.visitJumpInsn(OP_IFLT, cc_neg)
  ccv.visitVarInsn(OP_LLOAD, 1)
  ccv.visitVarInsn(OP_ALOAD, 0)
  ccv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  ccv.visitInsn(OP_I2L)
  ccv.visitInsn(OP_LCMP)
  ccv.visitJumpInsn(OP_IFGE, cc_neg)
  ccv.visitVarInsn(OP_ALOAD, 0)
  ccv.visitVarInsn(OP_LLOAD, 1)
  ccv.visitInsn(OP_L2I)
  ccv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "codePointAt", "(I)I", false)
  ccv.visitInsn(OP_I2L)
  ccv.visitInsn(OP_LRETURN)
  ccv.visitLabel(cc_neg)
  ccv.visitInsn(OP_ICONST_M1)
  ccv.visitInsn(OP_I2L)
  ccv.visitInsn(OP_LRETURN)
  close_mv(ccv)

  # cursorNext(s, c): c<0 -> 0; c>=len -> len; else c + charCount(codePointAt(c))
  let cnv = open_static(cw, "cursorNext", "(Ljava/lang/String;J)J")
  let cn_zero = Label.new()
  let cn_len = Label.new()
  cnv.visitVarInsn(OP_LLOAD, 1)
  cnv.visitInsn(OP_LCONST_0)
  cnv.visitInsn(OP_LCMP)
  cnv.visitJumpInsn(OP_IFLT, cn_zero)
  cnv.visitVarInsn(OP_LLOAD, 1)
  cnv.visitVarInsn(OP_ALOAD, 0)
  cnv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cnv.visitInsn(OP_I2L)
  cnv.visitInsn(OP_LCMP)
  cnv.visitJumpInsn(OP_IFGE, cn_len)
  cnv.visitVarInsn(OP_LLOAD, 1)
  cnv.visitVarInsn(OP_ALOAD, 0)
  cnv.visitVarInsn(OP_LLOAD, 1)
  cnv.visitInsn(OP_L2I)
  cnv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "codePointAt", "(I)I", false)
  cnv.visitMethodInsn(OP_INVOKESTATIC, jchar, "charCount", "(I)I", false)
  cnv.visitInsn(OP_I2L)
  cnv.visitInsn(OP_LADD)
  cnv.visitInsn(OP_LRETURN)
  cnv.visitLabel(cn_zero)
  cnv.visitInsn(OP_LCONST_0)
  cnv.visitInsn(OP_LRETURN)
  cnv.visitLabel(cn_len)
  cnv.visitVarInsn(OP_ALOAD, 0)
  cnv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cnv.visitInsn(OP_I2L)
  cnv.visitInsn(OP_LRETURN)
  close_mv(cnv)

  # cursorPrev(s, c): c<=0 -> 0; at = c>len ? len : (int)c; s.offsetByCodePoints(at, -1)
  let cpv = open_static(cw, "cursorPrev", "(Ljava/lang/String;J)J")
  let cp_zero = Label.new()
  let cp_uselen = Label.new()
  let cp_haveat = Label.new()
  cpv.visitVarInsn(OP_LLOAD, 1)
  cpv.visitInsn(OP_LCONST_0)
  cpv.visitInsn(OP_LCMP)
  cpv.visitJumpInsn(OP_IFLE, cp_zero)
  cpv.visitVarInsn(OP_ALOAD, 0)
  cpv.visitVarInsn(OP_LLOAD, 1)
  cpv.visitVarInsn(OP_ALOAD, 0)
  cpv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cpv.visitInsn(OP_I2L)
  cpv.visitInsn(OP_LCMP)
  cpv.visitJumpInsn(OP_IFGT, cp_uselen)
  cpv.visitVarInsn(OP_LLOAD, 1)
  cpv.visitInsn(OP_L2I)
  cpv.visitJumpInsn(OP_GOTO, cp_haveat)
  cpv.visitLabel(cp_uselen)
  cpv.visitVarInsn(OP_ALOAD, 0)
  cpv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cpv.visitLabel(cp_haveat)
  cpv.visitInsn(OP_ICONST_M1)
  cpv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "offsetByCodePoints", "(II)I", false)
  cpv.visitInsn(OP_I2L)
  cpv.visitInsn(OP_LRETURN)
  cpv.visitLabel(cp_zero)
  cpv.visitInsn(OP_LCONST_0)
  cpv.visitInsn(OP_LRETURN)
  close_mv(cpv)

  # splitsPair(s, at) = at>0 && at<len && isLowSurrogate(s.charAt((int)at))
  let spv = open_static(cw, "splitsPair", "(Ljava/lang/String;J)Z")
  let sp_false = Label.new()
  spv.visitVarInsn(OP_LLOAD, 1)
  spv.visitInsn(OP_LCONST_0)
  spv.visitInsn(OP_LCMP)
  spv.visitJumpInsn(OP_IFLE, sp_false)
  spv.visitVarInsn(OP_LLOAD, 1)
  spv.visitVarInsn(OP_ALOAD, 0)
  spv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  spv.visitInsn(OP_I2L)
  spv.visitInsn(OP_LCMP)
  spv.visitJumpInsn(OP_IFGE, sp_false)
  spv.visitVarInsn(OP_ALOAD, 0)
  spv.visitVarInsn(OP_LLOAD, 1)
  spv.visitInsn(OP_L2I)
  spv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "charAt", "(I)C", false)
  spv.visitMethodInsn(OP_INVOKESTATIC, jchar, "isLowSurrogate", "(C)Z", false)
  spv.visitInsn(OP_IRETURN)
  spv.visitLabel(sp_false)
  spv.visitInsn(OP_ICONST_0)
  spv.visitInsn(OP_IRETURN)
  close_mv(spv)

  # cursorSlice(s, from, to): null when out of range or a cursor splits a pair,
  # else s.substring((int)from, (int)to). from=slot1, to=slot3 (each a long).
  let cslv = open_static(cw, "cursorSlice", "(Ljava/lang/String;JJ)Ljava/lang/String;")
  let csl_null = Label.new()
  cslv.visitVarInsn(OP_LLOAD, 1)
  cslv.visitInsn(OP_LCONST_0)
  cslv.visitInsn(OP_LCMP)
  cslv.visitJumpInsn(OP_IFLT, csl_null)
  cslv.visitVarInsn(OP_LLOAD, 1)
  cslv.visitVarInsn(OP_LLOAD, 3)
  cslv.visitInsn(OP_LCMP)
  cslv.visitJumpInsn(OP_IFGT, csl_null)
  cslv.visitVarInsn(OP_LLOAD, 3)
  cslv.visitVarInsn(OP_ALOAD, 0)
  cslv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cslv.visitInsn(OP_I2L)
  cslv.visitInsn(OP_LCMP)
  cslv.visitJumpInsn(OP_IFGT, csl_null)
  cslv.visitVarInsn(OP_ALOAD, 0)
  cslv.visitVarInsn(OP_LLOAD, 1)
  cslv.visitMethodInsn(OP_INVOKESTATIC, STRINGS_CLASS, "splitsPair", "(Ljava/lang/String;J)Z", false)
  cslv.visitJumpInsn(OP_IFNE, csl_null)
  cslv.visitVarInsn(OP_ALOAD, 0)
  cslv.visitVarInsn(OP_LLOAD, 3)
  cslv.visitMethodInsn(OP_INVOKESTATIC, STRINGS_CLASS, "splitsPair", "(Ljava/lang/String;J)Z", false)
  cslv.visitJumpInsn(OP_IFNE, csl_null)
  cslv.visitVarInsn(OP_ALOAD, 0)
  cslv.visitVarInsn(OP_LLOAD, 1)
  cslv.visitInsn(OP_L2I)
  cslv.visitVarInsn(OP_LLOAD, 3)
  cslv.visitInsn(OP_L2I)
  cslv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "substring", "(II)Ljava/lang/String;", false)
  cslv.visitInsn(OP_ARETURN)
  cslv.visitLabel(csl_null)
  cslv.visitInsn(OP_ACONST_NULL)
  cslv.visitInsn(OP_ARETURN)
  close_mv(cslv)

  # cursorSkip(s, c, sub): past = (c<0?0:c) + sub.length(); min(past, len).
  # c=slot1 (long), sub=slot3.
  let cskv = open_static(cw, "cursorSkip", "(Ljava/lang/String;JLjava/lang/String;)J")
  let csk_havebase = Label.new()
  let csk_max = Label.new()
  cskv.visitVarInsn(OP_LLOAD, 1)
  cskv.visitInsn(OP_LCONST_0)
  cskv.visitInsn(OP_LCMP)
  cskv.visitJumpInsn(OP_IFLT, csk_havebase)
  cskv.visitVarInsn(OP_LLOAD, 1)
  cskv.visitJumpInsn(OP_GOTO, csk_max)
  cskv.visitLabel(csk_havebase)
  cskv.visitInsn(OP_LCONST_0)
  cskv.visitLabel(csk_max)
  cskv.visitVarInsn(OP_ALOAD, 3)
  cskv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cskv.visitInsn(OP_I2L)
  cskv.visitInsn(OP_LADD)
  cskv.visitVarInsn(OP_LSTORE, 4)
  let csk_uselen = Label.new()
  cskv.visitVarInsn(OP_LLOAD, 4)
  cskv.visitVarInsn(OP_ALOAD, 0)
  cskv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cskv.visitInsn(OP_I2L)
  cskv.visitInsn(OP_LCMP)
  cskv.visitJumpInsn(OP_IFGT, csk_uselen)
  cskv.visitVarInsn(OP_LLOAD, 4)
  cskv.visitInsn(OP_LRETURN)
  cskv.visitLabel(csk_uselen)
  cskv.visitVarInsn(OP_ALOAD, 0)
  cskv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  cskv.visitInsn(OP_I2L)
  cskv.visitInsn(OP_LRETURN)
  close_mv(cskv)

  # indexOfFromRaw(s, sub, from): from>len -> -1; else s.indexOf(sub, max(0,from)).
  # The sentinel the Option-returning indexOfFrom (above) unwraps. from=slot2.
  let iofv = open_static(cw, "indexOfFromRaw", "(Ljava/lang/String;Ljava/lang/String;J)J")
  let iof_neg = Label.new()
  let iof_zero = Label.new()
  let iof_have = Label.new()
  iofv.visitVarInsn(OP_LLOAD, 2)
  iofv.visitVarInsn(OP_ALOAD, 0)
  iofv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  iofv.visitInsn(OP_I2L)
  iofv.visitInsn(OP_LCMP)
  iofv.visitJumpInsn(OP_IFGT, iof_neg)
  iofv.visitVarInsn(OP_ALOAD, 0)
  iofv.visitVarInsn(OP_ALOAD, 1)
  iofv.visitVarInsn(OP_LLOAD, 2)
  iofv.visitInsn(OP_LCONST_0)
  iofv.visitInsn(OP_LCMP)
  iofv.visitJumpInsn(OP_IFLT, iof_zero)
  iofv.visitVarInsn(OP_LLOAD, 2)
  iofv.visitInsn(OP_L2I)
  iofv.visitJumpInsn(OP_GOTO, iof_have)
  iofv.visitLabel(iof_zero)
  iofv.visitInsn(OP_ICONST_0)
  iofv.visitLabel(iof_have)
  iofv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "indexOf", "(Ljava/lang/String;I)I", false)
  iofv.visitInsn(OP_I2L)
  iofv.visitInsn(OP_LRETURN)
  iofv.visitLabel(iof_neg)
  iofv.visitInsn(OP_ICONST_M1)
  iofv.visitInsn(OP_I2L)
  iofv.visitInsn(OP_LRETURN)
  close_mv(iofv)

  # ---- str_* intrinsics (the string primitives std cannot write in pure Dawn) ----
  # These were vendored on dawn.rt.StdStrings; emitting them here retires that
  # handwritten class. Bodies are StdStrings' verbatim: code points for lengths
  # and indices, Locale.ROOT for case, a -1 sentinel for a missing search.
  let jlocale = "java/util/Locale"

  # str_len(s) = s.codePointCount(0, s.length())
  let slv = open_static(cw, "str_len", "(Ljava/lang/String;)J")
  slv.visitVarInsn(OP_ALOAD, 0)
  slv.visitInsn(OP_ICONST_0)
  slv.visitVarInsn(OP_ALOAD, 0)
  slv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "length", "()I", false)
  slv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "codePointCount", "(II)I", false)
  slv.visitInsn(OP_I2L)
  slv.visitInsn(OP_LRETURN)
  close_mv(slv)

  # str_trim(s) = s.strip()
  let stv = open_static(cw, "str_trim", "(Ljava/lang/String;)Ljava/lang/String;")
  stv.visitVarInsn(OP_ALOAD, 0)
  stv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "strip", "()Ljava/lang/String;", false)
  stv.visitInsn(OP_ARETURN)
  close_mv(stv)

  # str_lower(s) = s.toLowerCase(Locale.ROOT)
  let slov = open_static(cw, "str_lower", "(Ljava/lang/String;)Ljava/lang/String;")
  slov.visitVarInsn(OP_ALOAD, 0)
  slov.visitFieldInsn(OP_GETSTATIC, jlocale, "ROOT", "Ljava/util/Locale;")
  slov.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "toLowerCase",
    "(Ljava/util/Locale;)Ljava/lang/String;", false)
  slov.visitInsn(OP_ARETURN)
  close_mv(slov)

  # str_upper(s) = s.toUpperCase(Locale.ROOT)
  let supv = open_static(cw, "str_upper", "(Ljava/lang/String;)Ljava/lang/String;")
  supv.visitVarInsn(OP_ALOAD, 0)
  supv.visitFieldInsn(OP_GETSTATIC, jlocale, "ROOT", "Ljava/util/Locale;")
  supv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "toUpperCase",
    "(Ljava/util/Locale;)Ljava/lang/String;", false)
  supv.visitInsn(OP_ARETURN)
  close_mv(supv)

  # str_contains(s, sub) = s.contains(sub)
  let scv = open_static(cw, "str_contains", "(Ljava/lang/String;Ljava/lang/String;)Z")
  scv.visitVarInsn(OP_ALOAD, 0)
  scv.visitVarInsn(OP_ALOAD, 1)
  scv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "contains", "(Ljava/lang/CharSequence;)Z", false)
  scv.visitInsn(OP_IRETURN)
  close_mv(scv)

  # str_starts_with(s, prefix) = s.startsWith(prefix)
  let sswv = open_static(cw, "str_starts_with", "(Ljava/lang/String;Ljava/lang/String;)Z")
  sswv.visitVarInsn(OP_ALOAD, 0)
  sswv.visitVarInsn(OP_ALOAD, 1)
  sswv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "startsWith", "(Ljava/lang/String;)Z", false)
  sswv.visitInsn(OP_IRETURN)
  close_mv(sswv)

  # str_ends_with(s, suffix) = s.endsWith(suffix)
  let sewv = open_static(cw, "str_ends_with", "(Ljava/lang/String;Ljava/lang/String;)Z")
  sewv.visitVarInsn(OP_ALOAD, 0)
  sewv.visitVarInsn(OP_ALOAD, 1)
  sewv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "endsWith", "(Ljava/lang/String;)Z", false)
  sewv.visitInsn(OP_IRETURN)
  close_mv(sewv)

  # str_index_of(s, sub): u = s.indexOf(sub); u<0 ? -1 : s.codePointCount(0, u)
  let siv = open_static(cw, "str_index_of", "(Ljava/lang/String;Ljava/lang/String;)J")
  let si_neg = Label.new()
  siv.visitVarInsn(OP_ALOAD, 0)
  siv.visitVarInsn(OP_ALOAD, 1)
  siv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "indexOf", "(Ljava/lang/String;)I", false)
  siv.visitVarInsn(OP_ISTORE, 2)
  siv.visitVarInsn(OP_ILOAD, 2)
  siv.visitJumpInsn(OP_IFLT, si_neg)
  siv.visitVarInsn(OP_ALOAD, 0)
  siv.visitInsn(OP_ICONST_0)
  siv.visitVarInsn(OP_ILOAD, 2)
  siv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "codePointCount", "(II)I", false)
  siv.visitInsn(OP_I2L)
  siv.visitInsn(OP_LRETURN)
  siv.visitLabel(si_neg)
  siv.visitInsn(OP_ICONST_M1)
  siv.visitInsn(OP_I2L)
  siv.visitInsn(OP_LRETURN)
  close_mv(siv)

  # str_last_index_of(s, sub): u = s.lastIndexOf(sub); u<0 ? -1 : s.codePointCount(0, u)
  let sliv = open_static(cw, "str_last_index_of", "(Ljava/lang/String;Ljava/lang/String;)J")
  let sli_neg = Label.new()
  sliv.visitVarInsn(OP_ALOAD, 0)
  sliv.visitVarInsn(OP_ALOAD, 1)
  sliv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "lastIndexOf", "(Ljava/lang/String;)I", false)
  sliv.visitVarInsn(OP_ISTORE, 2)
  sliv.visitVarInsn(OP_ILOAD, 2)
  sliv.visitJumpInsn(OP_IFLT, sli_neg)
  sliv.visitVarInsn(OP_ALOAD, 0)
  sliv.visitInsn(OP_ICONST_0)
  sliv.visitVarInsn(OP_ILOAD, 2)
  sliv.visitMethodInsn(OP_INVOKEVIRTUAL, jstr, "codePointCount", "(II)I", false)
  sliv.visitInsn(OP_I2L)
  sliv.visitInsn(OP_LRETURN)
  sliv.visitLabel(sli_neg)
  sliv.visitInsn(OP_ICONST_M1)
  sliv.visitInsn(OP_I2L)
  sliv.visitInsn(OP_LRETURN)
  close_mv(sliv)

  # char_is_*(c): Character.isX((int) c). One code point in, a Unicode table
  # lookup out; the JVM's tables are this backend's answer to the contract.
  for e in [("char_is_letter", "isLetter"), ("char_is_digit", "isDigit"),
    ("char_is_alnum", "isLetterOrDigit"), ("char_is_upper", "isUpperCase"),
    ("char_is_lower", "isLowerCase"), ("char_is_space", "isWhitespace")] {
      let (dawn_name, java_name) = e
      let cv = open_static(cw, dawn_name, "(J)Z")
      cv.visitVarInsn(OP_LLOAD, 0)
      cv.visitInsn(OP_L2I)
      cv.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Character", java_name, "(I)Z", false)
      cv.visitInsn(OP_IRETURN)
      close_mv(cv)
    }

  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

fn open_static(cw: AdtClassWriter, name: String, desc: String) -> MethodVisitor !io = {
  let m = cw.method(ACC_PUBLIC + ACC_STATIC, name, desc).expect("mv")
  m.visitCode()
  m
}

fn close_mv(m: MethodVisitor) -> Unit !io = {
  m.visitMaxs(0, 0)
  m.visitEnd()
  ()
}

## dawn/rt/Maps: the runtime for the builtin persistent Map/Set (spec §2.2),
## backed by the DawnMap/DawnSet HAMTs; read builtins speak java.util.Map/Set.
pub fn gen_maps_class(supers: List[String]) -> Bytes !io = {
  let dmap = "dawn/rt/DawnMap"
  let dset = "dawn/rt/DawnSet"
  let coll = "java/util/Collection"
  let iter = "java/util/Iterator"
  let entry = "java/util/Map\$Entry"
  let jmap = "java/util/Map"
  let jset = "java/util/Set"
  let jlist = "java/util/List"
  let t2 = tuple_class(2)
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, MAPS_CLASS, obj())

  let me = open_static(cw, "map_empty", "()Ljava/util/Map;")
  me.visitFieldInsn(OP_GETSTATIC, dmap, "EMPTY", "L" ++ dmap ++ ";")
  me.visitInsn(OP_ARETURN)
  close_mv(me)

  let se = open_static(cw, "set_empty", "()Ljava/util/Set;")
  se.visitFieldInsn(OP_GETSTATIC, dset, "EMPTY", "L" ++ dset ++ ";")
  se.visitInsn(OP_ARETURN)
  close_mv(se)

  let mi = open_static(cw, "map_insert",
    "(Ljava/util/Map;Ljava/lang/Object;Ljava/lang/Object;)Ljava/util/Map;")
  mi.visitVarInsn(OP_ALOAD, 0)
  mi.visitTypeInsn(OP_CHECKCAST, dmap)
  mi.visitVarInsn(OP_ALOAD, 1)
  mi.visitVarInsn(OP_ALOAD, 2)
  mi.visitMethodInsn(OP_INVOKEVIRTUAL, dmap, "assoc",
    "(Ljava/lang/Object;Ljava/lang/Object;)L" ++ dmap ++ ";", false)
  mi.visitInsn(OP_ARETURN)
  close_mv(mi)

  let si = open_static(cw, "set_insert", "(Ljava/util/Set;Ljava/lang/Object;)Ljava/util/Set;")
  si.visitVarInsn(OP_ALOAD, 0)
  si.visitTypeInsn(OP_CHECKCAST, dset)
  si.visitVarInsn(OP_ALOAD, 1)
  si.visitMethodInsn(OP_INVOKEVIRTUAL, dset, "conj",
    "(Ljava/lang/Object;)L" ++ dset ++ ";", false)
  si.visitInsn(OP_ARETURN)
  close_mv(si)

  let mr = open_static(cw, "map_remove", "(Ljava/util/Map;Ljava/lang/Object;)Ljava/util/Map;")
  mr.visitVarInsn(OP_ALOAD, 0)
  mr.visitTypeInsn(OP_CHECKCAST, dmap)
  mr.visitVarInsn(OP_ALOAD, 1)
  mr.visitMethodInsn(OP_INVOKEVIRTUAL, dmap, "without",
    "(Ljava/lang/Object;)L" ++ dmap ++ ";", false)
  mr.visitInsn(OP_ARETURN)
  close_mv(mr)

  let sr = open_static(cw, "set_remove", "(Ljava/util/Set;Ljava/lang/Object;)Ljava/util/Set;")
  sr.visitVarInsn(OP_ALOAD, 0)
  sr.visitTypeInsn(OP_CHECKCAST, dset)
  sr.visitVarInsn(OP_ALOAD, 1)
  sr.visitMethodInsn(OP_INVOKEVIRTUAL, dset, "disj",
    "(Ljava/lang/Object;)L" ++ dset ++ ";", false)
  sr.visitInsn(OP_ARETURN)
  close_mv(sr)

  let mg = open_static(cw, "map_get", "(Ljava/util/Map;Ljava/lang/Object;)LOption;")
  let g_none = Label.new()
  mg.visitVarInsn(OP_ALOAD, 0)
  mg.visitVarInsn(OP_ALOAD, 1)
  mg.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "containsKey", "(Ljava/lang/Object;)Z", true)
  mg.visitJumpInsn(OP_IFEQ, g_none)
  mg.visitTypeInsn(OP_NEW, "Option\$Some")
  mg.visitInsn(OP_DUP)
  mg.visitVarInsn(OP_ALOAD, 0)
  mg.visitVarInsn(OP_ALOAD, 1)
  mg.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "get",
    "(Ljava/lang/Object;)Ljava/lang/Object;", true)
  mg.visitMethodInsn(OP_INVOKESPECIAL, "Option\$Some", "<init>", "(Ljava/lang/Object;)V", false)
  mg.visitInsn(OP_ARETURN)
  mg.visitLabel(g_none)
  mg.visitFieldInsn(OP_GETSTATIC, "Option\$None", "INSTANCE", "LOption\$None;")
  mg.visitInsn(OP_ARETURN)
  close_mv(mg)

  # index(Map, Object) -> Object: the `m[k]` operator — panics when the key is absent
  let ix = open_static(cw, "index", "(Ljava/util/Map;Ljava/lang/Object;)Ljava/lang/Object;")
  let absent = Label.new()
  ix.visitVarInsn(OP_ALOAD, 0)
  ix.visitVarInsn(OP_ALOAD, 1)
  ix.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "containsKey", "(Ljava/lang/Object;)Z", true)
  ix.visitJumpInsn(OP_IFEQ, absent)
  ix.visitVarInsn(OP_ALOAD, 0)
  ix.visitVarInsn(OP_ALOAD, 1)
  ix.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "get",
    "(Ljava/lang/Object;)Ljava/lang/Object;", true)
  ix.visitInsn(OP_ARETURN)
  ix.visitLabel(absent)
  ix.visitTypeInsn(OP_NEW, PANIC_CLASS)
  ix.visitInsn(OP_DUP)
  ix.visitTypeInsn(OP_NEW, SB)
  ix.visitInsn(OP_DUP)
  ix.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  append_const(ix, "key not found: ")
  ix.visitVarInsn(OP_ALOAD, 1)
  ix.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "show",
    "(Ljava/lang/Object;)Ljava/lang/String;", false)
  ix.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append", "(Ljava/lang/String;)L" ++ SB ++ ";", false)
  ix.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  ix.visitMethodInsn(OP_INVOKESPECIAL, PANIC_CLASS, "<init>", "(Ljava/lang/String;)V", false)
  ix.visitInsn(OP_ATHROW)
  close_mv(ix)

  let mh = open_static(cw, "map_has", "(Ljava/util/Map;Ljava/lang/Object;)Z")
  mh.visitVarInsn(OP_ALOAD, 0)
  mh.visitVarInsn(OP_ALOAD, 1)
  mh.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "containsKey", "(Ljava/lang/Object;)Z", true)
  mh.visitInsn(OP_IRETURN)
  close_mv(mh)

  let sh = open_static(cw, "set_has", "(Ljava/util/Set;Ljava/lang/Object;)Z")
  sh.visitVarInsn(OP_ALOAD, 0)
  sh.visitVarInsn(OP_ALOAD, 1)
  sh.visitMethodInsn(OP_INVOKEINTERFACE, jset, "contains", "(Ljava/lang/Object;)Z", true)
  sh.visitInsn(OP_IRETURN)
  close_mv(sh)

  let ms = open_static(cw, "map_size", "(Ljava/util/Map;)J")
  ms.visitVarInsn(OP_ALOAD, 0)
  ms.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "size", "()I", true)
  ms.visitInsn(OP_I2L)
  ms.visitInsn(OP_LRETURN)
  close_mv(ms)

  let sz = open_static(cw, "set_size", "(Ljava/util/Set;)J")
  sz.visitVarInsn(OP_ALOAD, 0)
  sz.visitMethodInsn(OP_INVOKEINTERFACE, jset, "size", "()I", true)
  sz.visitInsn(OP_I2L)
  sz.visitInsn(OP_LRETURN)
  close_mv(sz)

  let mk = open_static(cw, "map_keys", "(Ljava/util/Map;)Ljava/util/List;")
  mk.visitTypeInsn(OP_NEW, ARRAYLIST)
  mk.visitInsn(OP_DUP)
  mk.visitVarInsn(OP_ALOAD, 0)
  mk.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "keySet", "()Ljava/util/Set;", true)
  mk.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "(L" ++ coll ++ ";)V", false)
  mk.visitInsn(OP_ARETURN)
  close_mv(mk)

  let mv2 = open_static(cw, "map_values", "(Ljava/util/Map;)Ljava/util/List;")
  mv2.visitTypeInsn(OP_NEW, ARRAYLIST)
  mv2.visitInsn(OP_DUP)
  mv2.visitVarInsn(OP_ALOAD, 0)
  mv2.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "values", "()L" ++ coll ++ ";", true)
  mv2.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "(L" ++ coll ++ ";)V", false)
  mv2.visitInsn(OP_ARETURN)
  close_mv(mv2)

  let sl = open_static(cw, "set_to_list", "(Ljava/util/Set;)Ljava/util/List;")
  sl.visitTypeInsn(OP_NEW, ARRAYLIST)
  sl.visitInsn(OP_DUP)
  sl.visitVarInsn(OP_ALOAD, 0)
  sl.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "(L" ++ coll ++ ";)V", false)
  sl.visitInsn(OP_ARETURN)
  close_mv(sl)

  let sf = open_static(cw, "set_from", "(Ljava/util/List;)Ljava/util/Set;")
  sf.visitFieldInsn(OP_GETSTATIC, dset, "EMPTY", "L" ++ dset ++ ";")
  sf.visitVarInsn(OP_ASTORE, 1)
  sf.visitVarInsn(OP_ALOAD, 0)
  sf.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "iterator", "()Ljava/util/Iterator;", true)
  sf.visitVarInsn(OP_ASTORE, 2)
  let sf_loop = Label.new()
  let sf_done = Label.new()
  sf.visitLabel(sf_loop)
  sf.visitVarInsn(OP_ALOAD, 2)
  sf.visitMethodInsn(OP_INVOKEINTERFACE, iter, "hasNext", "()Z", true)
  sf.visitJumpInsn(OP_IFEQ, sf_done)
  sf.visitVarInsn(OP_ALOAD, 1)
  sf.visitVarInsn(OP_ALOAD, 2)
  sf.visitMethodInsn(OP_INVOKEINTERFACE, iter, "next", "()Ljava/lang/Object;", true)
  sf.visitMethodInsn(OP_INVOKEVIRTUAL, dset, "conj",
    "(Ljava/lang/Object;)L" ++ dset ++ ";", false)
  sf.visitVarInsn(OP_ASTORE, 1)
  sf.visitJumpInsn(OP_GOTO, sf_loop)
  sf.visitLabel(sf_done)
  sf.visitVarInsn(OP_ALOAD, 1)
  sf.visitInsn(OP_ARETURN)
  close_mv(sf)

  let mf = open_static(cw, "map_from", "(Ljava/util/List;)Ljava/util/Map;")
  mf.visitFieldInsn(OP_GETSTATIC, dmap, "EMPTY", "L" ++ dmap ++ ";")
  mf.visitVarInsn(OP_ASTORE, 1)
  mf.visitVarInsn(OP_ALOAD, 0)
  mf.visitMethodInsn(OP_INVOKEINTERFACE, jlist, "iterator", "()Ljava/util/Iterator;", true)
  mf.visitVarInsn(OP_ASTORE, 2)
  let mf_loop = Label.new()
  let mf_done = Label.new()
  mf.visitLabel(mf_loop)
  mf.visitVarInsn(OP_ALOAD, 2)
  mf.visitMethodInsn(OP_INVOKEINTERFACE, iter, "hasNext", "()Z", true)
  mf.visitJumpInsn(OP_IFEQ, mf_done)
  mf.visitVarInsn(OP_ALOAD, 2)
  mf.visitMethodInsn(OP_INVOKEINTERFACE, iter, "next", "()Ljava/lang/Object;", true)
  mf.visitTypeInsn(OP_CHECKCAST, t2)
  mf.visitVarInsn(OP_ASTORE, 3)
  mf.visitVarInsn(OP_ALOAD, 1)
  mf.visitVarInsn(OP_ALOAD, 3)
  mf.visitFieldInsn(OP_GETFIELD, t2, "_0", "Ljava/lang/Object;")
  mf.visitVarInsn(OP_ALOAD, 3)
  mf.visitFieldInsn(OP_GETFIELD, t2, "_1", "Ljava/lang/Object;")
  mf.visitMethodInsn(OP_INVOKEVIRTUAL, dmap, "assoc",
    "(Ljava/lang/Object;Ljava/lang/Object;)L" ++ dmap ++ ";", false)
  mf.visitVarInsn(OP_ASTORE, 1)
  mf.visitJumpInsn(OP_GOTO, mf_loop)
  mf.visitLabel(mf_done)
  mf.visitVarInsn(OP_ALOAD, 1)
  mf.visitInsn(OP_ARETURN)
  close_mv(mf)

  let en = open_static(cw, "map_entries", "(Ljava/util/Map;)Ljava/util/List;")
  en.visitTypeInsn(OP_NEW, ARRAYLIST)
  en.visitInsn(OP_DUP)
  en.visitMethodInsn(OP_INVOKESPECIAL, ARRAYLIST, "<init>", "()V", false)
  en.visitVarInsn(OP_ASTORE, 1)
  en.visitVarInsn(OP_ALOAD, 0)
  en.visitMethodInsn(OP_INVOKEINTERFACE, jmap, "entrySet", "()Ljava/util/Set;", true)
  en.visitMethodInsn(OP_INVOKEINTERFACE, jset, "iterator", "()Ljava/util/Iterator;", true)
  en.visitVarInsn(OP_ASTORE, 2)
  let en_loop = Label.new()
  let en_done = Label.new()
  en.visitLabel(en_loop)
  en.visitVarInsn(OP_ALOAD, 2)
  en.visitMethodInsn(OP_INVOKEINTERFACE, iter, "hasNext", "()Z", true)
  en.visitJumpInsn(OP_IFEQ, en_done)
  en.visitVarInsn(OP_ALOAD, 2)
  en.visitMethodInsn(OP_INVOKEINTERFACE, iter, "next", "()Ljava/lang/Object;", true)
  en.visitTypeInsn(OP_CHECKCAST, entry)
  en.visitVarInsn(OP_ASTORE, 3)
  en.visitVarInsn(OP_ALOAD, 1)
  en.visitTypeInsn(OP_NEW, t2)
  en.visitInsn(OP_DUP)
  en.visitVarInsn(OP_ALOAD, 3)
  en.visitMethodInsn(OP_INVOKEINTERFACE, entry, "getKey", "()Ljava/lang/Object;", true)
  en.visitVarInsn(OP_ALOAD, 3)
  en.visitMethodInsn(OP_INVOKEINTERFACE, entry, "getValue", "()Ljava/lang/Object;", true)
  en.visitMethodInsn(OP_INVOKESPECIAL, t2, "<init>",
    "(Ljava/lang/Object;Ljava/lang/Object;)V", false)
  en.visitMethodInsn(OP_INVOKEVIRTUAL, ARRAYLIST, "add", "(Ljava/lang/Object;)Z", false)
  en.visitInsn(OP_POP)
  en.visitJumpInsn(OP_GOTO, en_loop)
  en.visitLabel(en_done)
  en.visitVarInsn(OP_ALOAD, 1)
  en.visitInsn(OP_ARETURN)
  close_mv(en)

  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

## The per-trait dictionary interface name: dawn/tr/<owner$…$>Name.
pub fn owner_prefix(owner: Option[String]) -> String =
  match owner {
    Some(o) -> join(str.split(o, "/"), "$") ++ "$"
    None -> ""
  }

pub fn tr_iface(owner: Option[String], name: String) -> String =
  "dawn/tr/" ++ owner_prefix(owner) ++ name

## A java.util.Comparator over a Dawn two-argument cmp function; emit_cmp
## receives (source, a, b) on the stack and leaves the long comparison result.
fn gen_comparator_class(
  supers: List[String],
  cls: String,
  src_desc: String,
  emit_cmp: fn(MethodVisitor) -> Unit !io
) -> Bytes !io = {
  let cw = AdtClassWriter.new(supers)
  cw.beginWithInterface(V17, ACC_PUBLIC + ACC_FINAL, cls, obj(), "java/util/Comparator")
  cw.field(ACC_PRIVATE + ACC_FINAL, "src", src_desc)
  let init = cw.method(ACC_PUBLIC, "<init>", "(" ++ src_desc ++ ")V").expect("mv")
  init.visitCode()
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitVarInsn(OP_ALOAD, 1)
  init.visitFieldInsn(OP_PUTFIELD, cls, "src", src_desc)
  init.visitInsn(OP_RETURN)
  init.visitMaxs(0, 0)
  init.visitEnd()
  let m = cw.method(ACC_PUBLIC, "compare", "(Ljava/lang/Object;Ljava/lang/Object;)I").expect("mv")
  m.visitCode()
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitFieldInsn(OP_GETFIELD, cls, "src", src_desc)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitVarInsn(OP_ALOAD, 2)
  emit_cmp(m)
  m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "signum", "(J)I", false)
  m.visitInsn(OP_IRETURN)
  m.visitMaxs(0, 0)
  m.visitEnd()
  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

pub fn gen_fn_comparator(supers: List[String]) -> Bytes !io =
  gen_comparator_class(supers, FN_CMP_CLASS, "L" ++ fn_iface(2) ++ ";", fn(m: MethodVisitor) => {
    m.visitMethodInsn(OP_INVOKEINTERFACE, fn_iface(2), "apply", erased_apply_desc(2), true)
    m.visitTypeInsn(OP_CHECKCAST, "java/lang/Long")
    m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J", false)
    ()
  })

## The prelude Ord trait interface (one erased cmp method).
pub fn gen_ord_interface(supers: List[String]) -> Bytes !io = {
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_ABSTRACT + ACC_INTERFACE, tr_iface(None, "Ord"), obj())
  let m = cw.method(ACC_PUBLIC + ACC_ABSTRACT, "cmp",
    "(Ljava/lang/Object;Ljava/lang/Object;)J").expect("mv")
  m.visitEnd()
  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

# ---- ADT classes (spec §12.2) ----

## Load a value of type `t` from a local slot (nothing for Unit/Never).
pub fn load_slot(m: MethodVisitor, t: Ty, slot: Int) -> Unit !io = {
  match jvm_repr(t) {
    RLong -> { m.visitVarInsn(OP_LLOAD, slot) }
    RDouble -> { m.visitVarInsn(OP_DLOAD, slot) }
    RBool -> { m.visitVarInsn(OP_ILOAD, slot) }
    RRef -> { m.visitVarInsn(OP_ALOAD, slot) }
    RUnit | RBottom -> ()
  }
  ()
}

## Consume a value of `t` on the stack, leave its int hash (values are never null).
pub fn hash_of(m: MethodVisitor, t: Ty) -> Unit !io = {
  # deliberately a `Ty` match and not `jvm_repr`: hashing is a question about
  # Dawn *values*, not about machine representation, and routing it through
  # the representation would hide the types whose answer here has to be
  # spelled out -- `TyBytes` is one, and inheriting "it is a reference, so
  # Object.hashCode" is how it was wrong before.
  match t {
    # opacity hides the representation from other modules, not from the
    # language: an opaque Int hashes, compares and renders as that Int
    TyOpaque(_, _, _, tgt) -> hash_of(m, tgt)
    TyInt -> { m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "hashCode", "(J)I", false) }
    TyFloat -> {
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Double", "hashCode", "(D)I", false)
    }
    TyBool -> {
      m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Boolean", "hashCode", "(Z)I", false)
    }
    # content hash, to stay consistent with the content equality
    # gen_equals_method now uses for a Bytes field
    TyBytes -> {
      m.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "hashCode", "([B)I", false)
    }
    TyString | TyVar(_, _) | TyAdt(_, _) | TyJava(_, _) -> {
      m.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "hashCode", "()I", false)
    }
    TyList(_) | TyMap(_, _) | TySet(_) | TyArray(_) | TyTuple(_) | TyFn(_, _, _) -> {
      m.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "hashCode", "()I", false)
    }
    # no value to hash; unreachable, and left as the wildcard had it
    TyUnit | TyNever | TyError -> {
      m.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "hashCode", "()I", false)
    }
  }
  ()
}

## The ADT's `toString`: Name, Name(v0, v1), or Name { f0: v0, f1: v1 }.
##
## Not what `to_string` compiles to any more -- that is a Core body now. This
## is what `String.valueOf` finds when a panic message renders an erased value,
## and what a Java caller sees. Kept in step with the Core rendering by hand,
## which is the price of the JVM having a universal `toString` at all.
fn gen_to_string_method(cw: AdtClassWriter, adts: Adts, sub: String, ci: CtorI) -> Unit !io = {
  let m = cw.method(ACC_PUBLIC, "toString", "()Ljava/lang/String;").expect("mv")
  m.visitCode()
  m.visitTypeInsn(OP_NEW, SB)
  m.visitInsn(OP_DUP)
  m.visitMethodInsn(OP_INVOKESPECIAL, SB, "<init>", "()V", false)
  append_const(m, ci.name)
  if len(ci.fields) > 0 {
    let is_record = adt_of(adts, ci.adt).is_record
    append_const(m, if is_record { " { " } else { "(" })
    var i = 0
    for f in ci.fields {
      if i > 0 { append_const(m, ", ") }
      if is_record { append_const(m, f.name ++ ": ") }
      m.visitVarInsn(OP_ALOAD, 0)
      m.visitFieldInsn(OP_GETFIELD, sub, f.name, desc_of(adts, f.ty))
      match f.ty {
        TyInt -> {
          m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Long", "valueOf",
            "(J)Ljava/lang/Long;", false)
        }
        TyFloat -> {
          m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Double", "valueOf",
            "(D)Ljava/lang/Double;", false)
        }
        TyBool -> {
          m.visitMethodInsn(OP_INVOKESTATIC, "java/lang/Boolean", "valueOf",
            "(Z)Ljava/lang/Boolean;", false)
        }
        _ -> ()
      }
      m.visitMethodInsn(OP_INVOKESTATIC, SHOW_CLASS, "show",
        "(Ljava/lang/Object;)Ljava/lang/String;", false)
      m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "append",
        "(Ljava/lang/String;)L" ++ SB ++ ";", false)
      i = i + 1
    }
    append_const(m, if is_record { " }" } else { ")" })
  }
  m.visitMethodInsn(OP_INVOKEVIRTUAL, SB, "toString", "()Ljava/lang/String;", false)
  m.visitInsn(OP_ARETURN)
  close_mv(m)
  ()
}

## Structural equality (== in Dawn, spec §4.3); a matching hashCode follows.
fn gen_equals_method(cw: AdtClassWriter, adts: Adts, sub: String, ci: CtorI) -> Unit !io = {
  let m = cw.method(ACC_PUBLIC, "equals", "(Ljava/lang/Object;)Z").expect("mv")
  m.visitCode()
  let yes = Label.new()
  let no = Label.new()
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitJumpInsn(OP_IF_ACMPEQ, yes)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitTypeInsn(OP_INSTANCEOF, sub)
  m.visitJumpInsn(OP_IFEQ, no)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitTypeInsn(OP_CHECKCAST, sub)
  m.visitVarInsn(OP_ASTORE, 2)
  for f in ci.fields {
    m.visitVarInsn(OP_ALOAD, 0)
    m.visitFieldInsn(OP_GETFIELD, sub, f.name, desc_of(adts, f.ty))
    m.visitVarInsn(OP_ALOAD, 2)
    m.visitFieldInsn(OP_GETFIELD, sub, f.name, desc_of(adts, f.ty))
    match f.ty {
      TyInt -> {
        m.visitInsn(OP_LCMP)
        m.visitJumpInsn(OP_IFNE, no)
      }
      TyFloat -> {
        m.visitInsn(OP_DCMPL)
        m.visitJumpInsn(OP_IFNE, no)
      }
      TyBool -> { m.visitJumpInsn(OP_IF_ICMPNE, no) }
      # a byte[] has no content `equals` of its own, so this arm used to make
      # a Bytes field compare by identity -- while the `==` operator on the
      # same two values compared by content. This method is the JVM's
      # implementation of the `struct_eq` contract, so it has to answer what
      # the synthesised comparison answers. Paired with hash_of's TyBytes arm:
      # changing one alone breaks equals/hashCode.
      TyBytes -> {
        m.visitMethodInsn(OP_INVOKESTATIC, "java/util/Arrays", "equals", "([B[B)Z", false)
        m.visitJumpInsn(OP_IFEQ, no)
      }
      _ -> {
        m.visitMethodInsn(OP_INVOKEVIRTUAL, obj(), "equals", "(Ljava/lang/Object;)Z", false)
        m.visitJumpInsn(OP_IFEQ, no)
      }
    }
  }
  m.visitLabel(yes)
  m.visitInsn(OP_ICONST_1)
  m.visitInsn(OP_IRETURN)
  m.visitLabel(no)
  m.visitInsn(OP_ICONST_0)
  m.visitInsn(OP_IRETURN)
  close_mv(m)
  ()
}

## hashCode consistent with the structural equals: h = 31*h + field.hash, seeded 1.
fn gen_hash_code_method(cw: AdtClassWriter, adts: Adts, sub: String, ci: CtorI) -> Unit !io = {
  let m = cw.method(ACC_PUBLIC, "hashCode", "()I").expect("mv")
  m.visitCode()
  m.visitInsn(OP_ICONST_1)
  for f in ci.fields {
    m.visitIntInsn(OP_BIPUSH, 31)
    m.visitInsn(OP_IMUL)
    m.visitVarInsn(OP_ALOAD, 0)
    m.visitFieldInsn(OP_GETFIELD, sub, f.name, desc_of(adts, f.ty))
    hash_of(m, f.ty)
    m.visitInsn(OP_IADD)
  }
  m.visitInsn(OP_IRETURN)
  close_mv(m)
  ()
}

## The static an `impl` compiles to (mirrors emit.impl_method_name).
fn impl_static_name(adts: Adts, trait_name: String, subject: Ty, m: String) -> String =
  "dawn\$impl\$" ++ trait_name ++ "\$" ++ subject_name(adts, subject) ++ "\$" ++ m

## equals(Object) delegating to `impl Eq`: a non-instance is never equal, so
## the type test still runs first and the impl only ever sees its own type.
fn gen_forwarding_equals(
  cw: AdtClassWriter,
  adts: Adts,
  sub: String,
  owner: String,
  subject: Ty
) -> Unit !io = {
  let m = cw.method(ACC_PUBLIC, "equals", "(Ljava/lang/Object;)Z").expect("mv")
  m.visitCode()
  let no = Label.new()
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitTypeInsn(OP_INSTANCEOF, adt_jvm_name(adt_of(adts, adt_id_of(subject))))
  m.visitJumpInsn(OP_IFEQ, no)
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitVarInsn(OP_ALOAD, 1)
  m.visitTypeInsn(OP_CHECKCAST, adt_jvm_name(adt_of(adts, adt_id_of(subject))))
  let d = desc_of(adts, subject)
  m.visitMethodInsn(OP_INVOKESTATIC, owner, impl_static_name(adts, "Eq", subject, "eq"),
    "(" ++ d ++ d ++ ")Z", false)
  m.visitInsn(OP_IRETURN)
  m.visitLabel(no)
  m.visitInsn(OP_ICONST_0)
  m.visitInsn(OP_IRETURN)
  close_mv(m)
  ()
}

## hashCode() delegating to `impl Hash`; Dawn's Int is a long, so narrow it.
fn gen_forwarding_hash_code(
  cw: AdtClassWriter,
  adts: Adts,
  sub: String,
  owner: String,
  subject: Ty
) -> Unit !io = {
  let m = cw.method(ACC_PUBLIC, "hashCode", "()I").expect("mv")
  m.visitCode()
  m.visitVarInsn(OP_ALOAD, 0)
  m.visitMethodInsn(OP_INVOKESTATIC, owner, impl_static_name(adts, "Hash", subject, "hash"),
    "(" ++ desc_of(adts, subject) ++ ")J", false)
  m.visitInsn(OP_L2I)
  m.visitInsn(OP_IRETURN)
  close_mv(m)
  ()
}

fn adt_id_of(t: Ty) -> Int =
  match t {
    TyAdt(aid, _) -> aid
    _ -> panic("impl subject is not an ADT")
  }

## One ctor class: final subclass of `base` (or the record class itself).
pub fn gen_ctor_class(
  supers: List[String],
  adts: Adts,
  base: String,
  ci: CtorI,
  ov: EqOverride
) -> Bytes !io = {
  let sub = ctor_jvm_name(adts, ci)
  let cw = AdtClassWriter.new(supers)
  cw.begin(V17, ACC_PUBLIC + ACC_FINAL, sub, base)
  let singleton = len(ci.fields) == 0
  for f in ci.fields {
    cw.field(ACC_PUBLIC + ACC_FINAL, f.name, desc_of(adts, f.ty))
  }
  if singleton {
    cw.field(ACC_PUBLIC + ACC_STATIC + ACC_FINAL, "INSTANCE", "L" ++ sub ++ ";")
    let cl = cw.method(ACC_STATIC, "<clinit>", "()V").expect("mv")
    cl.visitCode()
    cl.visitTypeInsn(OP_NEW, sub)
    cl.visitInsn(OP_DUP)
    cl.visitMethodInsn(OP_INVOKESPECIAL, sub, "<init>", "()V", false)
    cl.visitFieldInsn(OP_PUTSTATIC, sub, "INSTANCE", "L" ++ sub ++ ";")
    cl.visitInsn(OP_RETURN)
    cl.visitMaxs(2, 0)
    cl.visitEnd()
  }
  var ps = ""
  for f in ci.fields { ps = ps ++ desc_of(adts, f.ty) }
  let acc = if singleton { ACC_PRIVATE } else { ACC_PUBLIC }
  let init = cw.method(acc, "<init>", "(" ++ ps ++ ")V").expect("mv")
  init.visitCode()
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitMethodInsn(OP_INVOKESPECIAL, base, "<init>", "()V", false)
  var slot = 1
  for f in ci.fields {
    init.visitVarInsn(OP_ALOAD, 0)
    load_slot(init, f.ty, slot)
    init.visitFieldInsn(OP_PUTFIELD, sub, f.name, desc_of(adts, f.ty))
    slot = slot + slots_of(f.ty)
  }
  init.visitInsn(OP_RETURN)
  close_mv(init)
  # `equals`/`hashCode` are the JVM's materialisation of the Eq/Hash
  # dictionary: the collections and every derived field comparison reach the
  # relation through them, so an `impl Eq` that only changed `==` would leave
  # `a == b` and `map.get(m, b)` disagreeing. Forward them to the impl.
  let subject = TyAdt(ci.adt, [])
  match ov.eq_owner {
    Some(owner) -> gen_forwarding_equals(cw, adts, sub, owner, subject)
    None -> if not singleton { gen_equals_method(cw, adts, sub, ci) }
  }
  match ov.hash_owner {
    Some(owner) -> gen_forwarding_hash_code(cw, adts, sub, owner, subject)
    None -> if not singleton { gen_hash_code_method(cw, adts, sub, ci) }
  }
  # toString is always generated so nested/generic fields render uniformly via
  # dawn/rt/Show; the type checker gates whether it may be called
  gen_to_string_method(cw, adts, sub, ci)
  cw.visitEnd()
  cw.toByteArray().expect("bytes")
}

## The classes of one ADT: (name, bytes) for the base (sums) and each ctor.
## Where a type overrides the structural default: the module class holding
## the impl's static method, per trait. None = keep the derived body.
pub type EqOverride = { eq_owner: Option[String], hash_owner: Option[String] }

pub fn no_override() -> EqOverride = EqOverride { eq_owner: None, hash_owner: None }

pub fn gen_adt(
  supers: List[String],
  adts: Adts,
  a: AdtI,
  ov: EqOverride
) -> List[(String, Bytes)] !io = {
  let base = adt_jvm_name(a)
  if a.is_record {
    let ci = match a.ctors {
      [only] -> only
      _ -> panic("record with " ++ to_string(len(a.ctors)) ++ " ctors")
    }
    return [(base, gen_ctor_class(supers, adts, obj(), ci, ov))]
  }
  let bw = AdtClassWriter.new(supers)
  bw.begin(V17, ACC_PUBLIC + ACC_ABSTRACT, base, obj())
  let bc = bw.method(ACC_PROTECTED, "<init>", "()V").expect("mv")
  bc.visitCode()
  bc.visitVarInsn(OP_ALOAD, 0)
  bc.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  bc.visitInsn(OP_RETURN)
  bc.visitMaxs(1, 1)
  bc.visitEnd()
  bw.visitEnd()
  var out = [(base, bw.toByteArray().expect("bytes"))]
  for ci in a.ctors {
    out = out ++ [(ctor_jvm_name(adts, ci), gen_ctor_class(supers, adts, base, ci, ov))]
  }
  out
}

## INSTANCE + private <init> + <clinit> (the Kotlin singletonScaffold).
pub fn singleton_scaffold(cw: AdtClassWriter, cls: String, iface: String) -> Unit !io = {
  cw.field(ACC_PUBLIC + ACC_STATIC + ACC_FINAL, "INSTANCE", "L" ++ iface ++ ";")
  let init = cw.method(ACC_PRIVATE, "<init>", "()V").expect("mv")
  init.visitCode()
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  init.visitInsn(OP_RETURN)
  init.visitMaxs(0, 0)
  init.visitEnd()
  let cl = cw.method(ACC_STATIC, "<clinit>", "()V").expect("mv")
  cl.visitCode()
  cl.visitTypeInsn(OP_NEW, cls)
  cl.visitInsn(OP_DUP)
  cl.visitMethodInsn(OP_INVOKESPECIAL, cls, "<init>", "()V", false)
  cl.visitFieldInsn(OP_PUTSTATIC, cls, "INSTANCE", "L" ++ iface ++ ";")
  cl.visitInsn(OP_RETURN)
  cl.visitMaxs(0, 0)
  cl.visitEnd()
  ()
}

## The same scaffold for a dictionary that takes arguments: no INSTANCE,
## because there is nothing to share -- one field per argument and a
## constructor that binds them. `CDictApply` is what calls it.
pub fn dict_arg_field(idx: Int) -> String = "a" ++ to_string(idx)

pub fn dict_ctor_desc(nargs: Int) -> String = {
  var s = "("
  for _i in 0 ..nargs { s = s ++ "Ljava/lang/Object;" }
  s ++ ")V"
}

pub fn parameterised_scaffold(cw: AdtClassWriter, cls: String, nargs: Int) -> Unit !io = {
  for i in 0 ..nargs {
    cw.field(ACC_PUBLIC + ACC_FINAL, dict_arg_field(i), "Ljava/lang/Object;")
  }
  let init = cw.method(ACC_PUBLIC, "<init>", dict_ctor_desc(nargs)).expect("mv")
  init.visitCode()
  init.visitVarInsn(OP_ALOAD, 0)
  init.visitMethodInsn(OP_INVOKESPECIAL, obj(), "<init>", "()V", false)
  for i in 0 ..nargs {
    init.visitVarInsn(OP_ALOAD, 0)
    init.visitVarInsn(OP_ALOAD, i + 1)
    init.visitFieldInsn(OP_PUTFIELD, cls, dict_arg_field(i), "Ljava/lang/Object;")
  }
  init.visitInsn(OP_RETURN)
  init.visitMaxs(0, 0)
  init.visitEnd()
  ()
}

## The name an impl's subject contributes to the static it compiles to. The
## one definition: `emit.impl_method_name` and `codegen.impl_static_name` both
## spell the same name, and this used to be written out twice (a third copy,
## inlined in gen_impl_class, was deleted with that function and had drifted --
## it was missing Bytes and Cursor).
pub fn subject_name(adts: Adts, t: Ty) -> String =
  match t {
    TyInt -> "Int"
    TyFloat -> "Float"
    TyBool -> "Bool"
    TyString -> "String"
    # not writable as an impl subject in source; the prelude Eq/Hash cover them
    TyBytes -> "Bytes"
    TyAdt(aid, _) -> adt_of(adts, aid).name
    # the builtin containers, once std writes conditional impls for them.
    # Arguments are dropped on purpose: the name identifies the *impl*, and
    # coherence gives a head at most one.
    TyList(_) -> "List"
    TyMap(_, _) -> "Map"
    TySet(_) -> "Set"
    TyArray(_) -> "Array"
    TyUnit -> "Unit"
    # an opaque type is its own subject -- its impl is not its target's
    TyOpaque(_, name, _, _) -> name
    _ -> panic("invalid impl subject")
  }

## The class of one Core dictionary, named from the key its CDictDef carries.
##
## A dictionary belongs to the module that built it, so two modules
## forwarding the same bound get a singleton each. That is the price of the
## table being the only identity, and it is the cheaper side of the trade: a
## second derivation is a second thing that can be wrong.
pub fn dict_class(owner: String, key: String) -> String =
  "dawn/dict/" ++ join(str.split(owner, "/"), "$") ++ "$" ++ key

## Recover the concrete type from an erased Object on the stack (unerase).
pub fn emit_unerase(m: MethodVisitor, adts: Adts, t: Ty) -> Unit !io = {
  match t {
    TyOpaque(_, _, _, tgt) -> emit_unerase(m, adts, tgt)
    TyInt -> {
      m.visitTypeInsn(OP_CHECKCAST, "java/lang/Long")
      m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J", false)
    }
    TyFloat -> {
      m.visitTypeInsn(OP_CHECKCAST, "java/lang/Double")
      m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Double", "doubleValue", "()D", false)
    }
    TyBool -> {
      m.visitTypeInsn(OP_CHECKCAST, "java/lang/Boolean")
      m.visitMethodInsn(OP_INVOKEVIRTUAL, "java/lang/Boolean", "booleanValue", "()Z", false)
    }
    TyString -> { m.visitTypeInsn(OP_CHECKCAST, "java/lang/String") }
    TyBytes -> { m.visitTypeInsn(OP_CHECKCAST, "[B") }
    TyAdt(aid, _) -> { m.visitTypeInsn(OP_CHECKCAST, adt_jvm_name(adt_of(adts, aid))) }
    TyList(_) -> { m.visitTypeInsn(OP_CHECKCAST, "java/util/List") }
    TyMap(_, _) -> { m.visitTypeInsn(OP_CHECKCAST, "java/util/Map") }
    TySet(_) -> { m.visitTypeInsn(OP_CHECKCAST, "java/util/Set") }
    TyArray(_) -> { m.visitTypeInsn(OP_CHECKCAST, ARRAY_CLASS) }
    TyTuple(elems) -> { m.visitTypeInsn(OP_CHECKCAST, tuple_class(len(elems))) }
    TyJava(fqcn, _) -> {
      let internal = join(str.split(fqcn, "."), "/")
      m.visitTypeInsn(OP_CHECKCAST, internal)
    }
    TyFn(params, _, _) -> { m.visitTypeInsn(OP_CHECKCAST, fn_iface(len(params))) }
    TyUnit -> { m.visitInsn(OP_POP) }
    # TyVar is already erased, and the two bottom types carry no value
    TyVar(_, _) | TyNever | TyError -> ()
  }
  ()
}

# General application as a postfix (SYN-02): a call result, a conditional's
# result and any parenthesized function value can be applied directly. These
# were syntax errors until 2026-07-30; the named heads (f(x), x.m(y), ctors)
# still parse in their own paths, so this corpus pins only the new forms --
# on both backends.
fn add(a: Int) -> fn(Int) -> Int = fn(b) => a + b

fn pick(c: Bool) -> fn(Int) -> Int =
  if c { fn(x) => x * 2 } else { fn(x) => x + 100 }

pub fn main() -> Unit !io = {
  println("${add(3)(4)}")
  println("${(if true { fn(x: Int) => x * 2 } else { fn(x: Int) => x + 100 })(21)}")
  println("${pick(false)(1)}")
}

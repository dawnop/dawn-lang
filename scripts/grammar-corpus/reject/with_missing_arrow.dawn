# expect: `<-`
# The binding arrow is `<-`, not `=`. Worth pinning because the lexer's
# maximal munch is what makes `<-` a single token (spec §1.4), and a
# regression there would surface here as a confusing cascade.
fn f(path: String) -> Unit !io = {
  with h = bracket(open(path), close)
  write(h)
}

# expect: `..` is not an expression operator
# expect: `..` is not an expression operator
# `..` makes a range only in a `for` header (spec §4.7, §4.11); a range is not a
# value. Stopping at it after a complete statement names that rule (#193)
# instead of asking for a newline. The start of an expression is refused
# earlier, in `primary`, with its own list of positions.
fn f(n: Int) -> Unit = {
  let r = 0..3
  g(n)..n
}

# Generated callbacks retain resources and invariant cell support.
use std/mem
effect Read { fn read() -> Int }
pub fn main() -> Unit !io = {
  let n = mem.with_mem([@s] () => {
    let b = mem.new(3)
    with handle Read {
      var saved: I64Buf@s = b
      read() => len(saved)
    }
    read()
  })
  println(to_string(n))
}

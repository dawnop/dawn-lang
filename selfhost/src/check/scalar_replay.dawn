test "scalar replay reuses an admitted body when a trait declaration is changed" {
  # The rewritten revision renames the trait's own type parameter, so the
  # edit is to the generic head and not only to what is written inside it.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let body = "fn compute(x: Int) -> Int = {\n let y = x + 1\n if y > 0 { y * 2 } else { -x }\n}\n"
  let declared = "trait Named[T] { fn describe(x: T) -> Int }\n"
  let rewritten = "trait Named[Item] { fn describe(x: Item) -> Int }\n"
  let before = declared ++ body
  let after = rewritten ++ body
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 1 && actual.checked == 0
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.constants == expected.constants
  assert actual.bodies.impl_methods == expected.impl_methods
  assert actual.bodies.trait_defaults == expected.trait_defaults
  assert actual.bodies.tests == expected.tests
  assert actual.bodies.cx.frame == expected.cx.frame
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.owner_decl == expected.cx.owner_decl
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.cx.function_reads == expected.cx.function_reads
  assert actual.bodies.cx.body_writes == expected.cx.body_writes
}

test "scalar replay reuses an admitted body when a generic impl is added" {
  # The generic impl row of the same table, and the same reason it is safe: an
  # admitted body makes no call, so no method of this impl can be the one it
  # resolved. What the edit reaches is the scheduler, which dispatches the
  # impl's method under its own role, so the cold remainder grows by one and
  # the reused body still has to land beside it in the assembled module.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let body = "fn compute(x: Int) -> Int = {\n let y = x + 1\n if y > 0 { y * 2 } else { -x }\n}\n"
  let prelude = "trait Named[T] { fn describe(x: T) -> Int }\ntype Box[T] = { item: T }\n"
  let declared = prelude ++ "impl[T] Named[Box[T]] { fn describe(x: Box[T]) -> Int = 1 }\n"
  let before = body
  let after = declared ++ body
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 1 && actual.checked == 1
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.constants == expected.constants
  assert actual.bodies.impl_methods == expected.impl_methods
  assert actual.bodies.trait_defaults == expected.trait_defaults
  assert actual.bodies.tests == expected.tests
  assert actual.bodies.cx.frame == expected.cx.frame
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.owner_decl == expected.cx.owner_decl
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.cx.function_reads == expected.cx.function_reads
  assert actual.bodies.cx.body_writes == expected.cx.body_writes
}


# Generated callbacks retain resources and invariant cell support.
effect Store {
  fn record(body: fn() -> Unit !io) -> Unit
  fn emit(value: Int) -> Unit
  fn fetch() -> (fn() -> Unit !io)
}
use std/mem
type Marker[@s] = { n: Int }
type Slot[@s] = { value: Marker[s] }
impl[@s] StagedResult[Marker[s]] {
  type Slot = Slot[s]
  fn result_open() -> Slot[s] !Store = Slot { value = Marker { n = 0 } }
  fn result_get(cell: Slot[s]) -> Marker[s] !Store = cell.value
  effect StagedResult = !Store
  fn result_set(cell: Slot[s], value: Marker[s]) -> Unit !Store = emit(value.n)
}

type Cond = { n: Int }
impl StagedCond[Cond] {
  effect StagedCond = !Store
  fn staged_if(c: Cond, yes: fn() -> Unit !Store, no: fn() -> Unit !Store) -> Unit !Store = record(() => {
    with handle Store {
      record(body) => ()
      fetch() => () => ()
      emit(value) => println(to_string(value))
    }
    yes()
  })
}
pub fn main() -> Unit !io = {
  with handle Store {
    var saved: fn() -> Unit !io = () => ()
    record(body) => { saved = body }
    fetch() => saved
    emit(value) => println(to_string(value))
  }
  mem.with_mem([@s] () => {
    let condition = Cond { n = 1 }
    let marker: Marker[s] = if condition { Marker { n = 3 } } else { Marker { n = 4 } }
    let _ = marker.n
  })
  let body = fetch()
  body()
}

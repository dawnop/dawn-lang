# passes.dawn: derive reads one closed table (derivable_traits). The first two
# declarations are the positive control -- every row of the table derives, and
# a field of each derived type is checked against it -- so dropping a row
# turns this golden red. The rest are the names the table refuses, one hint
# each: Eq/Hash are structural and not requested, Display is written by hand,
# and a user trait is outside the closed list.
pub type Pair = { a: Int, b: String } derive Ord, Show

pub type Tree =
  | Leaf
  | Node(left: Tree, value: Pair, right: Tree)
derive Ord, Show

trait Mine[T] {
  fn m(x: T) -> Int
}

type WantsEq = { a: Int } derive Eq

type WantsHash = { a: Int } derive Hash

type WantsDisplay = { a: Int } derive Display

type WantsMine = { a: Int } derive Mine

pub fn least(xs: List[Tree]) -> Int = cmp(xs[0], xs[1])

# The driver half of the HAMT contract test. The comparisons are in
# hamtcheck.dawn, which the harness copies into a std/ of its own because
# `use std/hamt` is a compile error outside std (audit RD-06); this file is an
# ordinary user module and only prints what that one found.
use std/io
use std/list
use std/hamtcheck

pub fn main() -> Unit !io = {
  let bad = hamtcheck.run_all()
  for b in list.take(bad, 10) { println("FAIL " ++ b) }
  println("mismatches ${len(bad)}")
}

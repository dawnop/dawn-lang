{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dawn",
  "scopeName": "source.dawn",
  "x-dawn-contextual-keywords": [
    "opaque",
    "as",
    "derive",
    "handle"
  ],
  "x-dawn-hard-keywords": {
    "keyword.control.dawn": [
      "match",
      "if",
      "else",
      "for",
      "in",
      "while",
      "return",
      "break",
      "continue",
      "with"
    ],
    "keyword.declaration.dawn": [
      "fn",
      "let",
      "var",
      "type",
      "alias",
      "const",
      "use",
      "java",
      "trait",
      "impl",
      "effect",
      "test"
    ],
    "storage.modifier.dawn": [
      "pub",
      "comptime",
      "unsafe_pure"
    ],
    "keyword.other.assertion.dawn": [
      "assert"
    ],
    "keyword.operator.logical.dawn": [
      "not"
    ],
    "constant.language.boolean.dawn": [
      "true",
      "false"
    ]
  },
  "x-dawn-operators": [
    ">>>",
    "<<",
    ">>",
    "->",
    "<-",
    "=>",
    "==",
    "!=",
    "<=",
    ">=",
    "++",
    "|>",
    "&&",
    "||",
    "..",
    "?",
    "=",
    "<",
    ">",
    "+",
    "-",
    "*",
    "/",
    "%",
    "|",
    "&",
    "^",
    "~",
    "!",
    "@"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#rawStrings" },
    { "include": "#tripleStrings" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#contextualKeywords" },
    { "include": "#effects" },
    { "include": "#functionDeclarations" },
    { "include": "#hardKeywords" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#functionCalls" },
    { "include": "#identifiers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.dawn",
          "match": "#.*$"
        }
      ]
    },
    "rawStrings": {
      "name": "string.quoted.raw.dawn",
      "begin": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.dawn" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dawn" }
      }
    },
    "tripleStrings": {
      "name": "string.quoted.triple.dawn",
      "begin": "\"\"\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.dawn" }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dawn" }
      },
      "patterns": [
        { "include": "#escapes" },
        { "include": "#interpolations" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.dawn",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.dawn" }
      },
      "end": "\"|(?=$)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dawn" }
      },
      "patterns": [
        { "include": "#escapes" },
        { "include": "#interpolations" }
      ]
    },
    "characters": {
      "name": "string.quoted.single.dawn",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.dawn" }
      },
      "end": "'|(?=$)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dawn" }
      },
      "patterns": [
        { "include": "#escapes" }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.dawn",
          "match": "\\\\(?:[ntr\\\\\"'${]|u\\{[0-9A-Fa-f]+\\})"
        }
      ]
    },
    "interpolations": {
      "patterns": [
        {
          "name": "meta.embedded.interpolation.simple.dawn",
          "match": "(\\$)([_\\p{L}][_\\p{L}\\p{Nd}]*)",
          "captures": {
            "1": { "name": "punctuation.section.interpolation.begin.dawn" },
            "2": { "name": "variable.other.interpolation.dawn" }
          }
        },
        { "include": "#bracedInterpolation" }
      ]
    },
    "bracedInterpolation": {
      "name": "meta.embedded.interpolation.dawn",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.dawn" }
      },
      "end": "\\}|(?=$)",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.dawn" }
      },
      "patterns": [
        { "include": "#interpolationBraces" },
        { "include": "#interpolationCode" }
      ]
    },
    "interpolationBraces": {
      "name": "meta.braces.interpolation.dawn",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#interpolationBraces" },
        { "include": "#interpolationCode" }
      ]
    },
    "interpolationCode": {
      "patterns": [
        { "include": "#rawStrings" },
        { "include": "#tripleStrings" },
        { "include": "#strings" },
        { "include": "#characters" },
        { "include": "#contextualKeywords" },
        { "include": "#effects" },
        { "include": "#functionDeclarations" },
        { "include": "#hardKeywords" },
        { "include": "#numbers" },
        { "include": "#types" },
        { "include": "#functionCalls" },
        { "include": "#identifiers" },
        { "include": "#operators" }
      ]
    },
    "contextualKeywords": {
      "patterns": [
        {
          "x-dawn-word": "as",
          "match": "(?<![_\\p{L}\\p{Nd}])(use)(\\s+)([_\\p{L}][_\\p{L}\\p{Nd}]*(?:/[_\\p{L}][_\\p{L}\\p{Nd}]*)*)(\\s+)(as)(?=\\s+[_\\p{L}][_\\p{L}\\p{Nd}]*(?:\\s*(?:#.*)?)?$)",
          "captures": {
            "1": { "name": "keyword.declaration.dawn" },
            "5": { "name": "keyword.contextual.dawn" }
          }
        },
        {
          "x-dawn-word": "opaque",
          "name": "keyword.contextual.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])opaque(?=\\s+type(?![_\\p{L}\\p{Nd}]))"
        },
        {
          "x-dawn-word": "derive",
          "name": "keyword.contextual.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])derive(?=\\s+\\p{Lu}[_\\p{L}\\p{Nd}]*)"
        },
        {
          "x-dawn-word": "handle",
          "match": "(?<![_\\p{L}\\p{Nd}])(with)(\\s+)(handle)(?!\\s*<-)(?=\\s+)",
          "captures": {
            "1": { "name": "keyword.control.dawn" },
            "3": { "name": "keyword.contextual.dawn" }
          }
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "meta.effect.annotation.dawn",
          "begin": "(!)(\\s*)(\\()(?=\\s*[_\\p{L}][_\\p{L}\\p{Nd}]*(?:\\s*\\|\\s*[_\\p{L}][_\\p{L}\\p{Nd}]*)*\\s*\\))",
          "beginCaptures": {
            "1": { "name": "storage.modifier.effect.dawn" },
            "3": { "name": "punctuation.definition.effect.begin.dawn" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.effect.end.dawn" }
          },
          "patterns": [
            {
              "name": "entity.name.type.effect.dawn",
              "match": "(?<![_\\p{L}\\p{Nd}])[_\\p{L}][_\\p{L}\\p{Nd}]*(?![_\\p{L}\\p{Nd}])"
            },
            {
              "name": "keyword.operator.effect.union.dawn",
              "match": "\\|"
            }
          ]
        },
        {
          "match": "(!)(\\s*)([_\\p{L}][_\\p{L}\\p{Nd}]*)",
          "captures": {
            "1": { "name": "storage.modifier.effect.dawn" },
            "3": { "name": "entity.name.type.effect.dawn" }
          }
        }
      ]
    },
    "functionDeclarations": {
      "patterns": [
        {
          "match": "(?<![_\\p{L}\\p{Nd}])(fn)(\\s+)((?!\\p{Lu})[_\\p{L}][_\\p{L}\\p{Nd}]*)",
          "captures": {
            "1": { "name": "keyword.declaration.dawn" },
            "3": { "name": "entity.name.function.dawn" }
          }
        }
      ]
    },
    "hardKeywords": {
      "patterns": [
        {
          "name": "keyword.control.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])(?:match|if|else|for|in|while|return|break|continue|with)(?![_\\p{L}\\p{Nd}])"
        },
        {
          "name": "keyword.declaration.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])(?:fn|let|var|type|alias|const|use|java|trait|impl|effect|test)(?![_\\p{L}\\p{Nd}])"
        },
        {
          "name": "storage.modifier.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])(?:pub|comptime|unsafe_pure)(?![_\\p{L}\\p{Nd}])"
        },
        {
          "name": "keyword.other.assertion.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])(?:assert)(?![_\\p{L}\\p{Nd}])"
        },
        {
          "name": "keyword.operator.logical.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])(?:not)(?![_\\p{L}\\p{Nd}])"
        },
        {
          "name": "constant.language.boolean.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])(?:true|false)(?![_\\p{L}\\p{Nd}])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])0x[0-9A-Fa-f_]+(?![_\\p{L}\\p{Nd}])"
        },
        {
          "name": "constant.numeric.binary.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])0b[01_]+(?![_\\p{L}\\p{Nd}])"
        },
        {
          "name": "constant.numeric.float.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])(?:[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?|[0-9][0-9_]*[eE][+-]?[0-9]+)(?![_\\p{L}\\p{Nd}])"
        },
        {
          "name": "constant.numeric.integer.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])[0-9][0-9_]*(?![_\\p{L}\\p{Nd}])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])\\p{Lu}[_\\p{L}\\p{Nd}]*(?![_\\p{L}\\p{Nd}])"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "entity.name.function.call.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])(?:(?!\\p{Lu})[_\\p{L}])[_\\p{L}\\p{Nd}]*(?=\\s*\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.dawn",
          "match": "(?<![_\\p{L}\\p{Nd}])(?:(?!\\p{Lu})[_\\p{L}])[_\\p{L}\\p{Nd}]*(?![_\\p{L}\\p{Nd}])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.dawn",
          "match": ">>>|<<|>>|->|<-|=>|==|!=|<=|>=|\\+\\+|\\|>|&&|\\|\\||\\.\\.|\\?|=|<|>|\\+|-|\\*|/|%|\\||&|\\^|~|!|@"
        }
      ]
    }
  }
}

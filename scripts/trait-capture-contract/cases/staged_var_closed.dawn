# Generated callbacks retain resources and invariant cell support.
effect Store {
  fn record(body: fn() -> Unit !io) -> Unit
  fn emit(value: Int) -> Unit
  fn fetch() -> (fn() -> Unit !io)
}
use std/mem
type Marker = { n: Int }
type Slot = { value: Marker }
impl StagedVar[Marker] {
  type Cell = Slot
  fn var_open(value: Marker) -> Slot !Store = Slot { value = value }
  fn var_get(cell: Slot) -> Marker !Store = cell.value
  effect StagedVar = !Store
  fn var_set(cell: Slot, value: Marker) -> Unit !Store = emit(value.n)
}

type Cond = { n: Int }
impl StagedCond[Cond] {
  effect StagedCond = !Store
  fn staged_if(c: Cond, yes: fn() -> Unit !Store, no: fn() -> Unit !Store) -> Unit !Store = record(() => {
    with handle Store {
      record(body) => ()
      fetch() => () => ()
      emit(value) => println(to_string(value))
    }
    yes()
  })
}
pub fn main() -> Unit !io = {
  with handle Store {
    var saved: fn() -> Unit !io = () => ()
    record(body) => { saved = body }
    fetch() => saved
    emit(value) => println(to_string(value))
  }
  mem.with_mem([@s] () => {
    let condition = Cond { n = 1 }
    var marker: Marker = Marker { n = 3 }
    if condition { marker = marker }
  })
  let body = fetch()
  body()
}

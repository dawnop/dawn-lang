-- which barrier stops what --
no failure     ok
panic          through
read_file      caught
-- the payload of a taken fault --
fault  kind is a name        true
fault  message is not empty  true
fault  message is not kind   true
fault  kind is not rendered  true
fault  cause                 None
-- the same fault, taken by the other barrier --
panic  kind is a name        true
panic  message is not empty  true
panic  message is not kind   true
panic  kind is not rendered  true
panic  cause                 None
same kind             true
same message          true
-- a panic's payload, which only the panic barrier sees --
raised kind is a name        true
raised message is not empty  true
raised message is not kind   true
raised kind is not rendered  true
raised cause                 None
message is the argument true
-- and Ok still carries the value --
ok            7

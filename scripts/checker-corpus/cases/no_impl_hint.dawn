# checker.dawn: the four hints on `no impl of X for T`
pub type Box[T] = { v: T }

pub type Point = P(x: Int)

trait Mine[T] {
  fn m(x: T) -> Int
}

fn least[T: Ord](xs: List[T]) -> T = xs[0]

fn needs[T: Mine](x: T) -> Int = m(x)

# the generic-subject arm: trait v2 makes this the ordinary shape, so the hint
# must not send the reader looking for the v1 restriction
pub fn generic(xs: List[Box[Int]]) -> Box[Int] = least(xs)

# a named non-generic type
pub fn named(xs: List[Point]) -> Point = least(xs)

# a scalar, whose impl can only live with the trait
pub fn scalar_subject() -> Int = needs(1)

# Ord over the scalar the prelude deliberately does not order
pub fn unordered(xs: List[Float]) -> Float = least(xs)

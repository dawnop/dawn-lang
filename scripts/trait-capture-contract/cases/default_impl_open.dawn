# The implementation explicitly admits the value bound selected by its witness.
use std/mem
trait Measure[T: ^{c}, ^c] { fn measure(value: T) -> Int }
type Box[T] = { value: T }
impl[T: ^{c}, ^c] Measure[Box[T], c] {
  fn measure(value: Box[T]) -> Int = 0
}
pub fn main() -> Unit !io = {
  let count = mem.with_mem([@s] () => measure(Box { value = mem.new(3) }))
  println(to_string(count))
}

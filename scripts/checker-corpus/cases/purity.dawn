# checker.dawn: purity and effect-carrying values
use std/io

effect Ask { fn get() -> Int }

const K: Int = pure_io()

fn pure_io() -> Int !io = {
  io.println("x")
  1
}

pub fn as_value() -> fn() -> Int = get

pub fn bounded[T: Ord](x: T) -> Int = 1

pub fn bounded_value() -> Int = {
  let f = bounded
  1
}

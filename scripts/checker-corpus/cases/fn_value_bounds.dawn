# checker.dawn: a bounded function or trait method used as a function value
use std/list

pub type Box = { v: Int }

trait Greet[T] {
  fn greet(x: T) -> String
}

impl Greet[Int] {
  fn greet(x: Int) -> String = "i${x}"
}

# accepted: the expected function type settles the subject, so the bound has
# somewhere to be discharged and the wrapper is written for you
pub fn shown(xs: List[Int]) -> List[String] = list.map(xs, to_string)

pub fn greeted(xs: List[Int]) -> List[String] = list.map(xs, greet)

pub fn annotated() -> fn(Int) -> String = to_string

# accepted: the bound is the enclosing function's, and the wrapper captures
# that function's dictionary
pub fn forwarded[T: Show](xs: List[T]) -> List[String] = list.map(xs, to_string)

# rejected: nothing says what the subject is
pub fn unsettled() -> Int = {
  let f = to_string
  1
}

# rejected: the subject is settled and cannot answer the bound
pub fn no_impl(xs: List[Box]) -> List[String] = list.map(xs, to_string)

# still rejected, and for a reason that has nothing to do with the row: `get`
# names no function. An operation call is a field read off a handler's record
# plus a closure call, so there is no callee for a wrapper to call. (It used to
# be refused for its label, on the grounds that evidence was captured where a
# lambda was written; that ground is gone.)
# `pub`, so that the two accepted shapes below are about effects rather than
# about SEM-07's audience rule
pub effect Ask {
  fn get() -> Int
}

pub fn as_value() -> fn() -> Int = get

# accepted: an ordinary function with a written label, used as a value. Its row
# rides in the value's type and the call site supplies the evidence, so there
# is nothing here for a wrapper to capture and nothing to refuse.
fn raises() -> Int !Ask = get()

pub fn labelled_value() -> fn() -> Int !Ask = raises

# ... and through an expected type, which is the path that instantiates. `!e`
# takes the label the same way a type parameter takes a type.
fn thru(f: fn() -> Int !e) -> Int !e = f()

pub fn labelled_through() -> Int !Ask = thru(raises)

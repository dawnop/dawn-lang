# Differential probe for packages/inflate against java.util.zip.
#
# The oracle is the thing it replaces, and it is used in the direction that
# matters: Java *compresses*, Dawn decompresses. A round trip through one
# implementation would only prove it agrees with itself.
#
# Deflater's level picks the block type, so the four levels below are not
# redundancy -- 0 forces stored blocks, 1 tends to fixed Huffman and 6/9 to
# dynamic, which is all three of RFC 1951's kinds.
use std/bytes
use std/io
use std/str
use inflate/gzip
use inflate/deflate
use inflate/zip
use inflate/crc32
use gzip_cases
use java "java.util.zip.GZIPOutputStream"
use java "java.io.ByteArrayOutputStream"
use java "java.util.zip.Deflater"
use java "java.util.zip.ZipOutputStream"
use java "java.util.zip.ZipEntry"
use java "java.util.zip.CRC32"

## A real file, passed in so the harness picks it rather than this file
## hardcoding a path into someone's checkout.
fn big_file() -> String !io =
  match args() {
    [p] -> p
    _ -> ""
  }

## MB of the same byte, deflated by Java: a compression bomb, built by the
## oracle rather than hand-rolled, so what it is is not in question.
##
## Fed a megabyte at a time and drained as it goes, because the point is a
## small compressed member with a large expansion -- neither side of this
## process may hold the expansion in memory, including the side making it.
fn java_bomb(mb: Int) -> Bytes !io = {
  var chunk = bytes.buf()
  var i = 0
  while i < 1048576 {
    chunk = bytes.put(chunk, 97)
    i = i + 1
  }
  let block = bytes.freeze(chunk)
  let scratch = bytes.utf8(rep(" ", 8192))
  let d = Deflater.new(9, true)
  let bos = ByteArrayOutputStream.new()
  var n = 0
  while n < mb {
    let _ = d.setInput(block)
    while not d.needsInput() {
      let k = d.deflate(scratch)
      let _ = bos.write(bytes.slice(scratch, 0, k))
    }
    n = n + 1
  }
  let _ = d.finish()
  while not d.finished() {
    let k = d.deflate(scratch)
    let _ = bos.write(bytes.slice(scratch, 0, k))
  }
  let _ = d.end()
  bos.toByteArray().expect("bytes")
}

## The bomb leg, run by the harness in a JVM whose heap is far smaller than the
## expansion. A ceiling enforced while the output grows never allocates past
## it; one applied to the finished output has to build the whole thing first,
## and in this heap that is an OutOfMemoryError rather than a refusal. The two
## are indistinguishable at any larger heap -- both "refuse" -- which is why
## this leg exists and why it is run where it is run.
fn bomb_case(mb: Int) -> Unit !io = {
  let bomb = java_bomb(mb)
  io.println("bomb: " ++ to_string(bytes.len(bomb)) ++ " compressed bytes, " ++
      to_string(mb) ++ "MB expanded")
  match deflate.inflate_bounded(bomb, Some(1024)) {
    Ok(o) -> {
      io.println("the bomb was decompressed to " ++ to_string(bytes.len(o)) ++ " bytes")
      io.println("mismatches 1")
    }
    Err(e) -> {
      if str.index_of(e, "exceeds the 1024 byte limit") == None {
        io.println("the bomb was refused, but not by the ceiling: " ++ e)
        io.println("mismatches 1")
      } else {
        io.println("mismatches 0")
      }
    }
  }
}

fn rep(c: String, n: Int) -> String = {
  var s = ""
  var i = 0
  while i < n {
    s = s ++ c
    i = i + 1
  }
  s
}

## gzip with Java, so the input is one this side did not produce.
fn java_gzip(src: Bytes) -> Bytes !io = {
  let bos = ByteArrayOutputStream.new()
  let gz = GZIPOutputStream.new(bos)
  let _ = gz.write(src)
  let _ = gz.close()
  bos.toByteArray().expect("bytes")
}

## Raw deflate at a chosen level. 0 forces stored blocks, 1 tends to fixed
## Huffman, 6 and 9 to dynamic -- all three block types get exercised.
fn java_deflate(src: Bytes, level: Int) -> Bytes !io = {
  let d = Deflater.new(level, true)
  let _ = d.setInput(src)
  let _ = d.finish()
  let bos = ByteArrayOutputStream.new()
  while not d.finished() {
    let scratch = bytes.utf8(rep(" ", 8192))
    let n = d.deflate(scratch)
    let _ = bos.write(bytes.slice(scratch, 0, n))
  }
  let _ = d.end()
  bos.toByteArray().expect("bytes")
}

## A zip built by java.util.zip, with the method it is told to use. Method 0
## (stored) has to be told the sizes and the checksum up front, because a
## stored entry carries no end marker -- which is the same fact that makes the
## reader go through the central directory.
fn java_zip(names: List[String], datas: List[String], method: Int) -> Bytes !io = {
  let bos = ByteArrayOutputStream.new()
  let zos = ZipOutputStream.new(bos)
  var i = 0
  while i < len(names) {
    let e = ZipEntry.new(names[i])
    let body = bytes.utf8(datas[i])
    let _ = e.setMethod(method)
    if method == 0 {
      let c = CRC32.new()
      let _ = c.update(body)
      let _ = e.setSize(bytes.len(body))
      let _ = e.setCompressedSize(bytes.len(body))
      let _ = e.setCrc(c.getValue())
    }
    let _ = zos.putNextEntry(e)
    let _ = zos.write(body)
    let _ = zos.closeEntry()
    i = i + 1
  }
  let _ = zos.close()
  bos.toByteArray().expect("bytes")
}

fn check_zip(label: String, names: List[String], datas: List[String], method: Int) -> Int !io = {
  match zip.entries(java_zip(names, datas, method)) {
    Ok(es) -> {
      if len(es) != len(names) {
        io.println(label ++ ": read " ++ to_string(len(es)) ++ " entries, wrote " ++
            to_string(len(names)))
        return 1
      }
      var bad = 0
      var i = 0
      while i < len(es) {
        let e = es[i]
        if e.name != names[i] {
          io.println(label ++ ": entry " ++ to_string(i) ++ " came back as `" ++ e.name ++
              "`, wrote `" ++ names[i] ++ "`")
          bad = bad + 1
        } else if e.is_dir != str.ends_with(names[i], "/") {
          io.println(label ++ ": " ++ e.name ++ " disagrees about being a directory")
          bad = bad + 1
        } else if not e.is_dir && bytes.decode_utf8(e.data) != datas[i] {
          io.println(label ++ ": contents differ for " ++ e.name)
          bad = bad + 1
        }
        i = i + 1
      }
      bad
    }
    Err(er) -> {
      io.println(label ++ ": " ++ er)
      1
    }
  }
}

## Damage one byte. Built through `bytes.Buf`, which is the only way to make a
## Bytes that is not some string's UTF-8.
fn flip(b: Bytes, at: Int) -> Bytes = {
  var buf = bytes.buf()
  var k = 0
  while k < bytes.len(b) {
    buf = bytes.put(buf, if k == at { bytes.at(b, k) ^ 0xFF } else { bytes.at(b, k) })
    k = k + 1
  }
  bytes.freeze(buf)
}

## A checksum nobody checks is not a checksum, so the refusal is tested too --
## and tested for the reason, not just for failing.
fn check_corruption() -> Int !io = {
  let name = "a.txt"
  let good = java_zip([name], [rep("x", 200)], 0)
  # the first local header is at 0, so the first entry's data starts just past
  # its 30-byte header and its name
  let broken = flip(good, 30 + str.len(name) + 100)
  match zip.entries(broken) {
    Ok(_) -> {
      io.println("a corrupted stored entry was accepted")
      1
    }
    Err(e) ->
      if str.index_of(e, "checksum") == None {
        io.println("a corrupted stored entry was refused, but not by the checksum: " ++ e)
        1
      } else {
        0
      }
  }
}

## Every central-directory signature in the archive, in order. The probe needs
## to reach the *second* record, and finding it by scanning is the only way
## that does not re-implement the reader being tested.
fn cd_offsets(b: Bytes) -> List[Int] = {
  var out: List[Int] = []
  var i = 0
  while i + 4 <= bytes.len(b) {
    let sig = bytes.at(b, i) == 0x50 && bytes.at(b, i + 1) == 0x4B &&
      bytes.at(b, i + 2) == 1 && bytes.at(b, i + 3) == 2
    if sig { out = out ++ [i] }
    i = i + 1
  }
  out
}

## LIB-02: a central directory that stops early is a damaged archive, not a
## shorter one. Breaking the second record's signature used to yield `Ok` with
## the first entry and nothing to say the second had gone.
fn check_short_central_dir() -> Int !io = {
  let good = java_zip(["a.txt", "b.txt"], ["aaa", "bbb"], 0)
  let offs = cd_offsets(good)
  if len(offs) != 2 {
    io.println("the fixture archive does not have two central directory records")
    return 1
  }
  let broken = flip(good, offs[1] + 3)
  match zip.entries(broken) {
    Ok(es) -> {
      io.println("a truncated central directory was accepted, as " ++
          to_string(len(es)) ++ " entries")
      1
    }
    Err(e) ->
      if str.index_of(e, "central directory") == None {
        io.println("a truncated central directory was refused, but not as one: " ++ e)
        1
      } else {
        0
      }
  }
}

## LIB-03: a deflate stream with its last byte removed must be refused. The
## fixed table's end-of-block is seven zero bits, so a reader that reads past
## the end as zeros can decode one out of nothing and call the stream complete.
fn check_truncated_deflate() -> Int !io = {
  var bad = 0
  for lvl in [1, 6, 9] {
    let raw = java_deflate(bytes.utf8(rep("abcabcabc", 200)), lvl)
    let cut = bytes.slice(raw, 0, bytes.len(raw) - 1)
    match deflate.inflate(cut) {
      Ok(o) -> {
        io.println("a truncated level " ++ to_string(lvl) ++ " stream was accepted (" ++
            to_string(bytes.len(o)) ++ " bytes)")
        bad = bad + 1
      }
      Err(_) -> ()
    }
  }
  bad
}

## LIB-01: the ceiling is enforced while the output is being built, so it is
## exact -- one byte under the true size is refused, the true size is not.
fn check_bounded(src: Bytes) -> Int !io = {
  let raw = java_deflate(src, 9)
  let n = bytes.len(src)
  var bad = 0
  match deflate.inflate_bounded(raw, Some(n)) {
    Ok(o) ->
      if o != src {
        io.println("a bounded inflate at exactly the output size gave the wrong bytes")
        bad = bad + 1
      }
    Err(e) -> {
      io.println("a bounded inflate at exactly the output size was refused: " ++ e)
      bad = bad + 1
    }
  }
  if n > 0 {
    match deflate.inflate_bounded(raw, Some(n - 1)) {
      Ok(_) -> {
        io.println("a bounded inflate one byte under the output size succeeded")
        bad = bad + 1
      }
      Err(_) -> ()
    }
  }
  bad
}

pub fn main() -> Unit !io =
  match args() {
    ["--bomb", n] -> bomb_case(parse_int(n).unwrap_or(512))
    _ -> differential()
  }

fn differential() -> Unit !io = {
  var bad = 0
  var cases: List[String] = ["", "a", "hello world", rep("a", 1000)]
  # highly repetitive: long back-references, and runs where the copy overlaps
  # the write position -- the case a block move would get wrong
  cases = cases ++ [rep("abcabcabc", 500)]
  # the compiler's own source: real text, dynamic Huffman, hundreds of KB
  match io.read_file(big_file()) {
    Ok(t) -> { cases = cases ++ [t] }
    Err(e) -> io.println("skipping the big case: " ++ e.message)
  }
  for c in cases {
    let src = bytes.utf8(c)
    let gz = java_gzip(src)
    match gzip.gunzip(gz) {
      Ok(out) ->
        if out != src {
          io.println("gunzip mismatch at len " ++ to_string(bytes.len(src)))
          bad = bad + 1
        }
      Err(e) -> {
        io.println("gunzip failed at len " ++ to_string(bytes.len(src)) ++ ": " ++ e)
        bad = bad + 1
      }
    }
    for lvl in [0, 1, 6, 9] {
      let raw = java_deflate(src, lvl)
      match deflate.inflate(raw) {
        Ok(out) ->
          if out != src {
            io.println("inflate mismatch len " ++ to_string(bytes.len(src)) ++
                " level " ++ to_string(lvl))
            bad = bad + 1
          }
        Err(e) -> {
          io.println("inflate failed len " ++ to_string(bytes.len(src)) ++ " level " ++
              to_string(lvl) ++ ": " ++ e)
          bad = bad + 1
        }
      }
    }
  }

  # CRC-32 against the one java.util.zip verifies entries with
  for c in cases {
    let b = bytes.utf8(c)
    let want = CRC32.new()
    let _ = want.update(b)
    if crc32.sum(b) != want.getValue() {
      io.println("crc32 differs at len " ++ to_string(bytes.len(b)))
      bad = bad + 1
    }
  }

  # the container. Both methods over the same entries, so a difference is the
  # container's and not the entry's
  let names = ["a.txt", "dir/", "dir/b.txt", "dir/deep/c.txt", "empty.txt", "名字.txt"]
  let datas = ["hello", "", rep("abcabcabc", 500), rep("q", 3), "", "内容"]
  for method in [0, 8] {
    bad = bad + check_zip("zip method " ++ to_string(method), names, datas, method)
  }
  # one entry big enough to be dynamic Huffman inside the container
  match io.read_file(big_file()) {
    Ok(t) -> { bad = bad + check_zip("zip big", ["src/types.dawn"], [t], 8) }
    Err(_) -> ()
  }
  bad = bad + check_corruption()
  bad = bad + check_short_central_dir()
  bad = bad + check_truncated_deflate()
  bad = bad + gzip_cases.check()
  # the big case if there is one, so the ceiling is checked against a stream
  # that is dynamic Huffman and full of back-references
  match io.read_file(big_file()) {
    Ok(t) -> { bad = bad + check_bounded(bytes.utf8(t)) }
    Err(_) -> { bad = bad + check_bounded(bytes.utf8(rep("abcabcabc", 500))) }
  }

  io.println("mismatches " ++ to_string(bad))
}

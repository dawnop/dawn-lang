# A closure that reads a scoped label (`Mem[s]`) out of its own pack, created at
# the row `!Mem[s]`. Valid as written: the lint has to take the scoped atom as
# the row's answer to the read (#852). run.py puts back two defects on it: the
# row losing the atom, and the read losing its scope argument.
use std/mem

fn f() -> Int = mem.with_mem([@s] () => {
  let b = mem.new(1)
  mem.set(b, 0, 5)
  mem.at(b, 0)
})

pub fn main() -> Unit !io = println(to_string(f()))

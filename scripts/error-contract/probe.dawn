# What the JVM backend puts in `ForeignError.kind`, in exact text.
#
# The differential corpus (scripts/spike-native/foreign_error.dawn) can only
# ask portable questions, because both backends are checked against one
# expectation and `kind` is deliberately not portable. This is the other half:
# one backend, and therefore the actual names.
#
# The claim under test is the design doc's (docs/audit/error-model-design.md
# A): `kind` is a *binary name*. Three renderings of a Java class are within
# one method call of each other and only one of them is a name --
#
#   getClass().getName()        java.lang.NumberFormatException   <- this one
#   getClass().getSimpleName()  NumberFormatException
#   toString()                  java.lang.NumberFormatException: For input ...
#
# -- and the third is what `catch_fault` hands back today, which is why
# spec 9.8 used to advise matching on a message prefix. Asserting the
# fully-qualified spelling rules out the second; asserting there is no colon
# in it rules out the third.
#
# `dawn.rt.PanicError` is here as well as a JDK exception because it is *our*
# class: its name cannot drift with the host JDK, and a Dawn panic is the one
# foreign failure every program can raise without `use java`.
use std/io
use std/str

use java "java.lang.Long"
use java "java.util.ArrayList"
use java "java.lang.Object"

## An expectation and its outcome, so the count and the report come from one
## place -- 1 is a mismatch, which is what the last line adds up.
fn check(what: String, got: String, want: String) -> Int !io =
  if got == want {
    println("ok   " ++ what)
    0
  } else {
    println("BAD  " ++ what ++ ": got `" ++ got ++ "`, want `" ++ want ++ "`")
    1
  }

fn check_true(what: String, got: Bool) -> Int !io =
  check(what, to_string(got), "true")

fn taken(f: fn() -> Int !io) -> ForeignError !io =
  match catch_panic(f) {
    Ok(_) -> panic("the thunk was supposed to fail")
    Err(e) -> e
  }

fn boom() -> Int !io = panic("boom")

fn not_a_number() -> Int !io = Long.parseLong("nope")

## An erased `Object` that really holds a String. `ArrayList.get` is the
## shortest honest source of one: its element type is erased, so the reclaim
## is the situation `cast` exists for rather than a contrived cast of a value
## whose type was never in doubt.
fn a_string_as_object() -> Object !io = {
  let xs = ArrayList.new()
  xs.add("hello")
  xs.get(0).expect("element")
}

## The same reclaim through the old spelling, which leaves by throwing. Here
## to show the two name the same failure -- step B's analogue of the barriers
## agreeing (`foreign_error.dawn`) -- and it is the reason `cast_e` exists:
## `cast` is declared pure and exits this way anyway.
fn thrown_by_cast() -> ForeignError !io =
  match catch_fault(fn() => {
    let b: Bytes = cast(a_string_as_object())
    b
  }) {
    Ok(_) -> panic("cast accepted a String as Bytes")
    Err(e) -> e
  }

pub fn main() -> Unit !io = {
  let p = taken(boom)
  let n = taken(not_a_number)
  let f = match catch_fault(not_a_number) {
    Ok(_) -> panic("parseLong accepted `nope`")
    Err(e) -> e
  }
  var bad = 0
  bad = bad + check("a Dawn panic's kind is the runtime class's binary name",
    p.kind, "dawn.rt.PanicError")
  bad = bad + check("a Dawn panic's message is what panic was given", p.message, "boom")
  bad = bad + check("a Dawn panic has no cause", to_string(p.cause), "None")
  bad = bad + check("a JDK exception's kind is its binary name",
    n.kind, "java.lang.NumberFormatException")
  # the distinction the whole field exists for: `toString()` would have put
  # the message here behind a colon
  bad = bad + check_true("the kind is a name and not a rendering",
    not str.contains(n.kind, ":"))
  bad = bad + check_true("the message is the exception's own",
    str.contains(n.message, "nope"))
  # the fault barrier fills the same fields the same way -- the two differ in
  # what they catch, not in what they report
  bad = bad + check("both barriers report the same kind", f.kind, n.kind)
  bad = bad + check("both barriers report the same message", f.message, n.message)

  # ---- step B: `cast_e`, the reclaim whose failure is a value -------------
  #
  # `cast` is declared pure and leaves by throwing (design doc 一.3, LANG-02).
  # `cast_e` is the transitional spelling that hands the failure back instead,
  # and the two questions worth asking on this backend are the two below: a
  # hit is `Ok` with the value intact, and a miss is `Err` under the JVM's own
  # name for it.
  let o = a_string_as_object()
  let hit: Result[String, ForeignError] = cast_e(o)
  bad = bad + check("a cast that hits carries the value through",
    match hit {
      Ok(s) -> s
      Err(e) -> "Err(" ++ e.kind ++ ")"
    }, "hello")
  let miss: Result[Bytes, ForeignError] = cast_e(o)
  let m = match miss {
    Ok(_) -> panic("cast_e accepted a String as Bytes")
    Err(e) -> e
  }
  bad = bad + check("a cast that misses names the JVM's own failure class",
    m.kind, "java.lang.ClassCastException")
  # the same distinction the barriers are checked for: a name, not a rendering
  bad = bad + check_true("the kind is a name and not a rendering",
    not str.contains(m.kind, ":"))
  bad = bad + check("nothing sits under a failed cast", to_string(m.cause), "None")
  # and the two spellings are the same reclaim: what `cast` throws is what
  # `cast_e` hands back, which is what makes stage 3 a substitution
  bad = bad + check("cast_e reports what cast throws", m.kind, thrown_by_cast().kind)

  println("mismatches " ++ to_string(bad))
}

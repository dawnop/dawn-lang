# checker.dawn: an undefined call whose name a whole-module import exports
# (#450). The hint names the alias before any std module.
use other as o
use lib as m

# only `m` exports it, and std's hint for `sub` is not the answer
pub fn dot_alias(x: Int) -> Int = x.sub(1)

# the same name as a plain call
pub fn plain_alias(x: Int) -> Int = sub(x, 1)

# two aliases export it: both, in import order
pub fn dot_both(x: Int) -> Int = x.pick(1)

pub fn plain_both(x: Int) -> Int = pick(x, 1)

# no alias exports it: the std hint is unchanged
pub fn dot_std(x: Int) -> Int = x.mul(2)

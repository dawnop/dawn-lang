# The probe for scripts/display-layering-contract/run.sh.
#
# Every line is `<label>\t<rendering>`, and probe_check.py partitions the labels
# into three named assertions. Labels rather than one whole-file comparison,
# because the point of this harness is that two mutants redden *different*
# assertions: a single `cmp` against one expectation cannot tell them apart, and
# a mutant whose red set is indistinguishable from another's is not evidence
# about which rule it broke.
#
# The corpus program that says the same things without labels, and that also
# runs on the native backend, is scripts/spike-native/display_layers.dawn.

use std/list
use std/str

opaque type Inner = String
opaque type Outer = Inner
opaque type Deep = Outer
opaque type Tag = String

# Every opaque type here writes its own `Show`: none inherits one from its
# target (2026-09-24). Inner's renders the String inside, quoted, the way a
# String renders nested; Outer's and Deep's are markers, so a rendering that
# came from a layer below would show.
impl Show[Inner] {
  fn show(x: Inner) -> String = {
    let s: String = x
    show(s)
  }
}

impl Show[Outer] {
  fn show(x: Outer) -> String = "<outer>"
}

impl Show[Deep] {
  fn show(x: Deep) -> String = "<deep>"
}

impl Show[Tag] {
  fn show(t: Tag) -> String = "***"
}

impl Display[Tag] {
  fn display(t: Tag) -> String = "[redacted]"
}

impl Display[Inner] {
  fn display(x: Inner) -> String = "<inner>"
}

fn inner_of(s: String) -> Inner = s

fn outer_of(i: Inner) -> Outer = i

fn deep_of(o: Outer) -> Deep = o

fn tag_of(s: String) -> Tag = s

fn render[T: Show](x: T) -> String = "${x}"

pub fn main() -> Unit !io = {
  # display_wins_over_show: over a Show the type wrote itself (`Char`, `Tag`
  # and `Inner` all write one, and it is not this answer)
  println("top-char\t${'a'}")
  println("top-tag\t${tag_of("x")}")
  println("layer1\t${inner_of("x")}")

  # display_is_not_inherited: Inner's Display is one and two opaque layers
  # below these, and neither layer has a Display of its own, so each renders
  # through its own Show
  println("layer2\t${outer_of(inner_of("x"))}")
  println("layer3\t${deep_of(outer_of(inner_of("x")))}")

  # show_stays_the_nested_rendering: the control. Neither mutant may move any
  # of these -- Display is the top-level rendering and nothing else.
  println("nested-list\t${to_string(['a', 'b'])}")
  println("nested-tag\t${to_string([tag_of("x")])}")
  println("nested-inner\t${to_string([inner_of("x")])}")
  println("nested-tuple\t${to_string(('a', tag_of("x")))}")
  # and a type variable renders through its Show witness, which is the same
  # static-type rule that makes `render("hi")` quote where `to_string` does not
  println("bound-char\t${render('a')}")
  println("bound-inner\t${render(inner_of("x"))}")
  println("list-map\t${to_string(list.map(['a', 'b'], c => str.from_char(c)))}")
}

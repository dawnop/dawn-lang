# Differential probe for the `fspath` package against java.nio.file.Paths.
#
# The oracle is the thing being replaced: `analyze.canon` and `lsp.canon` both
# spelled `Paths.get(p).toAbsolutePath().normalize().toString()`, and the
# switch to fspath is only safe if the two agree on the paths a workspace
# actually contains. That is the first table below.
#
# A project rather than a single file, because fspath is a package now
# (audit RD-09) and only a project can declare a dependency. The functions
# under test are the three the compiler's own copy in selfhost/src/pkg/fspath.dawn
# duplicates, which is why this oracle covers both.
#
# `..` above the root went in expecting a divergence -- the kernel resolves the
# root's parent to the root, and Java looked like it would keep the spelling.
# It does not. The cases stayed in the table as ordinary agreement.
use fspath/fspath
use std/io
use java "java.nio.file.Paths"
use java "java.lang.System"

fn java_norm(p: String) -> String !io =
  Paths.get(p).expect("path").normalize().expect("norm").toString().expect("string")

fn cwd() -> String !io =
  match System.getProperty("user.dir") {
    Some(d) -> d
    None -> "/"
  }

fn java_abs(p: String) -> String !io =
  Paths.get(p).expect("path").toAbsolutePath().expect("abs").normalize().expect("norm")
  .toString().expect("string")

pub fn main() -> Unit !io = {
  var bad = 0

  # normalize: everything a real path can look like
  let cases = [
    "", "/", ".", "..", "a", "/a",
    "a/b", "a/./b", "a//b", "a/b/", "./a", "a/..",
    "/a/..", "/a/b/../../c", "/a/./b//c/", "../a", "a/../..",
    "src/../packages/fspath/src/fspath.dawn", "/usr/local/../bin", "a/b/c/../../d",
    "/a/b/../c/./d/", "....", "a/.../b", "/.hidden/x",
    "/..", "/../a", "/a/../../b"
  ]
  for c in cases {
    let mine = fspath.normalize(c)
    let theirs = java_norm(c)
    if mine != theirs {
      io.println("normalize mismatch: " ++ c ++ " -> mine " ++ mine ++ ", java " ++ theirs)
      bad = bad + 1
    }
  }

  # absolute: the operation the two canon functions actually perform
  let rels = ["a", "a/b", "./a", "../a", "a/../b", "/already/absolute", "."]
  for r in rels {
    let mine = fspath.absolute(r, cwd())
    let theirs = java_abs(r)
    if mine != theirs {
      io.println("absolute mismatch: " ++ r ++ " -> mine " ++ mine ++ ", java " ++ theirs)
      bad = bad + 1
    }
  }

  # parent, against the same oracle
  for p in ["/a/b/c", "a/b", "/a", "a", "/", "", "a/b/.."] {
    let mine = fspath.parent(p)
    let theirs = match Paths.get(fspath.normalize(p)).expect("path").getParent() {
      Some(x) -> Some(x.toString().expect("string"))
      None -> None
    }
    if mine != theirs {
      io.println("parent mismatch: " ++ p)
      bad = bad + 1
    }
  }

  io.println("mismatches " ++ to_string(bad))
}

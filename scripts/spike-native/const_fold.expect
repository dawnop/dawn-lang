-- scalars fold --
N     = 42
NEG   = -5
FLAG  = true
TEXT  = abc
LEN   = 5
-- folded rendering vs the same expression at runtime --
const   int   = 42
runtime int   = 42
const   bool  = true
runtime bool  = true
const   point = Point(1, 2)
runtime point = Point(1, 2)
const   suit  = Hearts
runtime suit  = Hearts
const   list  = [1, 2, 3]
runtime list  = [1, 2, 3]
const   opt   = Some(9)
runtime opt   = Some(9)
const   interp= p=Point(3, 4)
runtime interp= p=Point(3, 4)
-- a String is bare at the top and quoted inside a value --
const   str   = [a
b]
runtime str   = [a
b]
const   named = Named { tag: "a\nb", n: 1 }
runtime named = Named { tag: "a\nb", n: 1 }
const   strs  = ["x", "y"]
runtime strs  = ["x", "y"]
-- the cursor walk, folded vs live --
const   len   = 5
runtime len   = 5
const   idx   = Some(2)
runtime idx   = Some(2)
const   last  = Some(4)
runtime last  = Some(4)
const   sub   = 𝄞中b
runtime sub   = 𝄞中b
const   split = a|中b|
runtime split = a|中b|
const   trim  = [a𝄞中b𝄞]
runtime trim  = [a𝄞中b𝄞]
const   ends  = true
runtime ends  = true
-- structured constants, folded vs the same literal at run time --
const   list  = [1, 2, 3]
runtime list  = [1, 2, 3]
const   lstrs = ["x", "y"]
runtime lstrs = ["x", "y"]
const   empty = []
runtime empty = []
const   tup   = (1, "one")
runtime tup   = (1, "one")
const   tup3  = (1, 2.5, true)
runtime tup3  = (1, 2.5, true)
const   rec   = Item { sku: "a\nb", qty: 2 }
runtime rec   = Item { sku: "a\nb", qty: 2 }
const   dot   = Dot
runtime dot   = Dot
const   seg   = Seg(2, 5)
runtime seg   = Seg(2, 5)
const   wrapi = Wrap(7)
runtime wrapi = Wrap(7)
const   wraps = Wrap("g")
runtime wraps = Wrap("g")
const   opt   = Some(9)
runtime opt   = Some(9)
const   none  = None
runtime none  = None
const   res   = Ok(3)
runtime res   = Ok(3)
const   nest  = [(1, ["x"]), (2, [])]
runtime nest  = [(1, ["x"]), (2, [])]
const   ll    = [[1], [2, 3]]
runtime ll    = [[1], [2, 3]]
const   opaq  = ["p", "q"]
runtime opaq  = ["p", "q"]
const   block = (2, ["u", "v"])
runtime block = (2, ["u", "v"])
const   list  = [1, 2, 3]
const   nest  = [(1, ["x"]), (2, [])]

# An explicit contract isolates this propagation or boundary rule.
use std/mem
type PureSource[^c] = { read: fn(Int) -> Int ^{c} }
fn keep[^c](f: fn(Int) -> Int ^{c}) -> PureSource[c] = PureSource { read = f }
fn attempt() !io = mem.with_mem([@s] () => {
  let b = mem.new(3)
  keep(_n => len(b))
})
pub fn main() -> Unit !io = { let _ = attempt() }

-- the process's own view --
cwd is absolute  = true
PATH is set      = true
no such var      = false
-- a scratch directory of our own --
fresh and a dir  = true
not a symlink    = false
-- bytes round-trip, through parents that did not exist --
parents created  = true
bytes agree      = true
multi-byte kept  = true
-- rename is a move, not a copy --
source is gone   = true
target is there  = true
-- delete separates deletion, absence and failure --
first delete     = Deleted
second delete    = NotFound
-- stdin at end of input --
nothing to read  = true
-- and it cleans up after itself --
scratch removed  = Deleted

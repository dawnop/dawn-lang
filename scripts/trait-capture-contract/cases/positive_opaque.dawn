# Explicit contracts exercise data introduction and nominal boundaries.
use std/mem
opaque type Hidden[T] = T
fn hide[T: ^{c}, ^c](value: T) -> Hidden[T] = value
fn probe() -> Int = mem.with_mem([@s] () => { let x: Hidden[I64Buf@s] = hide(mem.new(3))
  let b: I64Buf@s = x
  len(b) })
pub fn main() -> Unit !io = println(to_string(probe()))

# The third corpus: closures. Lambda lifting, captured environments, calls
# through a function value, named local functions, and functions taken as
# values -- the piece llvm-backend-research.md called the largest single
# chunk of native codegen, because the JVM gets it free from
# invokedynamic and native does not.
#
# No collections yet, so the higher-order functions here are hand-rolled
# rather than list.map.
use std/io

fn apply1(f: fn(Int) -> Int, x: Int) -> Int = f(x)

fn apply2(f: fn(Int, Int) -> Int, a: Int, b: Int) -> Int = f(a, b)

fn twice(f: fn(Int) -> Int, x: Int) -> Int = f(f(x))

## Returns a closure capturing its argument: the environment must outlive
## the call that built it.
fn adder(n: Int) -> fn(Int) -> Int = x => x + n

## Two captures of different widths, so the environment cannot be a single
## uniform word by accident.
fn scaler(mul: Int, label: String) -> fn(Int) -> String =
  x => "${label}${x * mul}"

fn compose(f: fn(Int) -> Int, g: fn(Int) -> Int) -> fn(Int) -> Int =
  x => f(g(x))

fn double(x: Int) -> Int = x * 2

fn negate(x: Int) -> Int = 0 - x

trait BottomCall[T] {
  fn required_bottom(x: T) -> Never
  fn default_bottom(x: T) -> Never = panic("default bottom")
}

type BottomToken = BottomToken

impl BottomCall[BottomToken] {
  fn required_bottom(x: BottomToken) -> Never = panic("impl bottom")
}

effect BottomEffect {
  fn effect_bottom() -> Never
}

fn direct_bottom() -> Never = panic("direct bottom")

fn bottom_direct(take: Bool) -> Int = if take { direct_bottom() } else { 71 }

fn bottom_dynamic(take: Bool) -> Int = {
  let halt: fn() -> Never = direct_bottom
  if take { halt() } else { 72 }
}

fn bottom_closure(take: Bool) -> Int = {
  let halt: fn() -> Never = () => panic("closure bottom")
  if take { halt() } else { 73 }
}

fn bottom_impl(take: Bool) -> Int =
  if take { required_bottom(BottomToken) } else { 74 }

fn bottom_default(take: Bool) -> Int =
  if take { default_bottom(BottomToken) } else { 75 }

fn bottom_trait[T: BottomCall](take: Bool, value: T) -> Int =
  if take { required_bottom(value) } else { 76 }

fn bottom_effect(take: Bool) -> Int !BottomEffect =
  if take { effect_bottom() } else { 77 }

## A fold written by hand, driving a function value in a loop.
fn fold_range(lo: Int, hi: Int, init: Int, f: fn(Int, Int) -> Int) -> Int = {
  var acc = init
  for i in lo..hi {
    acc = f(acc, i)
  }
  acc
}

pub fn main() -> Unit !io = {
  println("-- lambdas --")
  println("apply1(+1, 41)    = ${apply1(x => x + 1, 41)}")
  println("apply2(*, 6, 7)   = ${apply2((a, b) => a * b, 6, 7)}")
  println("twice(+3, 10)     = ${twice(x => x + 3, 10)}")

  println("-- captures --")
  let add10 = adder(10)
  let add100 = adder(100)
  println("add10(5)          = ${add10(5)}")
  println("add100(5)         = ${add100(5)}")
  println("add10 still       = ${add10(1)}")

  let s = scaler(3, "x3 = ")
  println(s(7))
  println(s(0 - 7))

  println("-- top-level fns as values --")
  println("apply1(double,21) = ${apply1(double, 21)}")
  println("twice(negate, 5)  = ${twice(negate, 5)}")

  println("-- composition --")
  let dn = compose(double, negate)
  let nd = compose(negate, double)
  println("double(negate(4)) = ${dn(4)}")
  println("negate(double(4)) = ${nd(4)}")

  println("-- closures in a loop --")
  println("sum 1..10         = ${fold_range(1, 11, 0, (a, b) => a + b)}")
  println("prod 1..6         = ${fold_range(1, 7, 1, (a, b) => a * b)}")
  println("max 1..10 mod 7   = ${fold_range(1, 11, 0, (a, b) => if b % 7 > a { b % 7 } else { a })}")

  println("-- a closure capturing a loop variable --")
  var total = 0
  for k in 1..5 {
    let f = adder(k * 10)
    total = total + f(k)
  }
  println("total             = ${total}")

  println("-- named local function --")
  let base = 1000
  fn local_bump(x: Int) -> Int = x + base
  println("local_bump(23)    = ${local_bump(23)}")
  println("via apply1        = ${apply1(local_bump, 23)}")

  println("-- Never calls --")
  println("direct             = ${bottom_direct(false)}")
  println("dynamic            = ${bottom_dynamic(false)}")
  println("closure            = ${bottom_closure(false)}")
  println("impl               = ${bottom_impl(false)}")
  println("default            = ${bottom_default(false)}")
  println("trait              = ${bottom_trait(false, BottomToken)}")
  with handle BottomEffect { effect_bottom() => panic("effect bottom") }
  println("effect             = ${bottom_effect(false)}")
}

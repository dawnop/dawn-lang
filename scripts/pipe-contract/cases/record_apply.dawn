# A record is built with braces and with nothing else (spec §2.4), however the
# application was spelled. Until CtorUse split `Point { x: 1 }` from
# `Point(1)`, both reached the checker as one `has_parens: Bool` and the
# parenthesised spelling compiled, which the pipe would then have been able
# to write for you.
pub type Rec = { a: Int, b: Int }

pub fn written() -> Rec = Rec(1, 2)

pub fn piped(n: Int) -> Rec = n |> Rec(2)

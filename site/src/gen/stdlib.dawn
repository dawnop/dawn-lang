# site/build/stdlib.json (from `dawn doc --stdlib`) -> stdlib.html.
#
# The standard library as a caller meets it: the names visible with no `use`,
# the traits the prelude brings, then one section per std module with its
# functions, its types and the impls it registers. Where a name is implemented
# — the compiler's builtin table or bundled Dawn source — is not a heading
# here, because it is not something a caller can observe (spec §11). What is a
# heading is how the name is *written*, which is the difference that matters.
#
# Two parsers are in scope and they are not the same one: `parse` reads the
# JSON the compiler emitted, and `parser.parse` (md/parser) reads Markdown —
# the intro page, and every doc comment, which are Markdown prose and were
# rendered as flat escaped text for as long as this page was a table.

use std/str
use std/map
use std/io
use json/parser.{parse}
use json/value.{Json, JNull, JBool, JStr, JArr, JObj, error_text}
use md/parser
use html/escape.{escape_html}
use html/page.{Assets, Lang, En, Zh, page_with_toc}
use html/render.{render_doc, TocEntry}
use hl/dawn.{highlight_dawn}
use gen/common.{must_read, write_page, map_doc_url, doc_files}

# ---- the page's own words ----
#
# Everything on this page except these eight strings and site/pages/stdlib.md
# is generated from `dawn doc --stdlib`, so the two of them together are the
# whole of what a translator has to touch. The strings live in one record
# rather than as literals down in the code that emits them: a table has the
# property the literals did not, which is that the two languages sit on
# adjacent lines and a missing one is a compile error instead of a page that
# renders half in each.
#
# The entries themselves are NOT translated and are not meant to be: a doc
# comment on a std function is English on both pages, because it is the
# compiler's own text and this repository's code is English throughout.

type Chrome = {
  impls_lead: String,
  impls_sep: String,
  prelude_title: String,
  prelude_intro: String,
  traits_title: String,
  traits_intro: String,
  modules_title: String,
  modules_intro: String,
}

fn chrome(lang: Lang, root: String) -> Chrome =
  match lang {
    En -> Chrome {
      impls_lead: "impls registered by this module (visible program-wide, no use needed): ",
      impls_sep: ", ",
      prelude_title: "prelude: the names that need no use",
      prelude_intro: "<p>These names are in scope implicitly — just write them. " ++
        "The groups are there to make things findable and say nothing about where " ++
        "a name is implemented; the ones that also live in a std module " ++
        "(<code>sort</code>, <code>println</code> and so on) appear once more under " ++
        "Modules below in their qualified spelling — the same function, two ways of " ++
        "writing it.</p>\n",
      traits_title: "Prelude traits",
      traits_intro: "<p>The five traits the prelude brings. Their method names " ++
        "enter the function namespace as well, and a top-level declaration in the " ++
        """calling module shadows them (<a href="$root/spec.html#s10-6">spec §10.6</a>).""" ++
        "</p>\n",
      modules_title: "Modules",
      modules_intro: "<p>Brought in with <code>use std/x</code> and then called " ++
        "qualified; single names can be imported on their own " ++
        "(<code>use std/str.{trim}</code>).</p>\n",
    }
    Zh -> Chrome {
      impls_lead: "本模块登记的 impl（全程序可见，不必 use）：",
      impls_sep: "、",
      prelude_title: "prelude：不必 use 的名字",
      prelude_intro: "<p>下面这些名字隐式可见，直接写就是了。分组只为好找，不代表实现位置；" ++
        "其中在 std 模块里也有一份的（<code>sort</code>、<code>println</code> 等）" ++
        "会在下面「模块」一节里以限定拼写再出现一次——同一个函数，两种写法。</p>\n",
      traits_title: "预置 trait",
      traits_intro: "<p>随 prelude 而来的五个 trait。它们的方法名同样进入函数命名空间，" ++
        """可被本模块的顶层声明遮蔽（<a href="$root/zh/spec.html#s10-6">规范 §10.6</a>）。</p>""" ++
        "\n",
      modules_title: "模块",
      modules_intro: "<p>以 <code>use std/x</code> 引入，再限定调用；" ++
        "也可以选择性引入单个名字（<code>use std/str.{trim}</code>）。</p>\n",
    }
  }

# ---- reading the compiler's JSON ----

fn jget(j: Json, key: String) -> Json =
  match j {
    JObj(entries) -> unwrap_or(map.get(entries, key), JNull)
    _ -> JNull
  }

fn jstr(j: Json) -> String =
  match j {
    JStr(s) -> s
    _ -> ""
  }

fn jbool(j: Json) -> Bool =
  match j {
    JBool(b) -> b
    _ -> false
  }

fn jarr(j: Json) -> List[Json] =
  match j {
    JArr(items) -> items
    _ -> []
  }

fn field(j: Json, key: String) -> String = jstr(jget(j, key))

# ---- pieces of the page ----

## A module path as an HTML id fragment: `std/str` -> `std-str`.
fn slug(path: String) -> String = str.replace(path, "/", "-")

## A doc comment, rendered as the Markdown it is. Multi-line prose used to be
## escaped whole and flattened into one table cell; paragraphs, bullets and
## `code` spans all survive this way.
##
## An unparsable doc comment is a hard error, like every other Markdown this
## generator reads: the site build is the lint.
fn prose(docs: List[String], text: String) -> String =
  if str.trim(text) == "" {
    ""
  } else {
    match parser.parse(text) {
      Ok(bs) -> render_doc(bs, u => map_doc_url(".", docs, u)).html
      Err(e) -> panic("a doc comment is not Markdown: $e\n---\n$text")
    }
  }

## One documented entry: its qualified spelling as the anchor, the declaration
## exactly as the compiler renders it, then the prose.
fn entry(docs: List[String], title: String, id: String, sig: String, doc: String) -> String =
  """<div class="api-item" id="$id">""" ++ "\n" ++
  """<h3 class="api-name"><a href="#$id">""" ++ escape_html(title) ++ "</a></h3>\n" ++
  """<pre class="dawn api-sig"><code>""" ++ highlight_dawn(sig) ++ "</code></pre>\n" ++
  """<div class="api-doc">""" ++ "\n" ++ prose(docs, doc) ++ "</div>\n</div>"

fn qualify(qual: String, name: String) -> String = if qual == "" { name } else { "$qual.$name" }

fn fn_entry(docs: List[String], qual: String, id_base: String, f: Json) -> String =
  entry(docs, qualify(qual, field(f, "name")), id_base ++ "-" ++ field(f, "name"),
    field(f, "sig"), field(f, "doc"))

fn ctor_decl(c: Json) -> String = {
  let fs = map(jarr(jget(c, "fields")), f => field(f, "name") ++ ": " ++ field(f, "type"))
  if len(fs) == 0 { field(c, "name") } else { field(c, "name") ++ "(" ++ join(fs, ", ") ++ ")" }
}

fn record_decl(head: String, c: Json) -> String = {
  let fs = map(jarr(jget(c, "fields")), f => field(f, "name") ++ ": " ++ field(f, "type"))
  "type $head = { " ++ join(fs, ", ") ++ " }"
}

## The declaration, reassembled from what the compiler reported. A type with no
## constructors keeps its representation to itself — `pub opaque type Cursor`
## is the whole point of `Cursor` — and that absence is the documentation.
fn type_decl(t: Json) -> String = {
  let ps = map(jarr(jget(t, "typeParams")), p => jstr(p))
  let name = field(t, "name")
  let head = if len(ps) == 0 { name } else { name ++ "[" ++ join(ps, ", ") ++ "]" }
  let ctors = jarr(jget(t, "ctors"))
  match get(ctors, 0) {
    None -> "type $head"
    Some(first) ->
      if jbool(jget(t, "record")) {
        record_decl(head, first)
      } else {
        "type $head = " ++ join(map(ctors, c => ctor_decl(c)), " | ")
      }
  }
}

## `-type-` in the anchor, not just the name: `std/bytes` has both a `Buf`
## type and a `buf()` function, and ids that differ only in case are one
## careless lowercase away from colliding.
fn type_entry(docs: List[String], id_base: String, t: Json) -> String =
  entry(docs, field(t, "name"), id_base ++ "-type-" ++ field(t, "name"), type_decl(t),
    field(t, "doc"))

fn const_entry(docs: List[String], qual: String, id_base: String, c: Json) -> String = {
  let name = field(c, "name")
  entry(docs, qualify(qual, name), "$id_base-$name", "const $name: " ++ field(c, "type"),
    field(c, "doc"))
}

fn trait_entry(docs: List[String], id_base: String, t: Json) -> String = {
  let name = field(t, "name")
  let tp = field(t, "typeParam")
  var body = ""
  for a in jarr(jget(t, "assoc")) {
    body = body ++ "\n  type " ++ jstr(a)
  }
  for m in jarr(jget(t, "methods")) {
    body = body ++ "\n  " ++ field(m, "sig")
  }
  entry(docs, name, "$id_base-trait-$name", "trait $name[$tp] {$body\n}", field(t, "doc"))
}

## Dead for every std module today — nothing there declares a `pub effect` yet
## — and here so that the day one appears it lands on the page instead of
## silently missing, which is the same reason `doc` emits the empty array.
fn effect_entry(docs: List[String], id_base: String, e: Json) -> String = {
  let name = field(e, "name")
  var body = ""
  for op in jarr(jget(e, "ops")) {
    body = body ++ "\n  " ++ field(op, "sig")
  }
  entry(docs, name, "$id_base-effect-$name", "effect $name {$body\n}", field(e, "doc"))
}

## The impls a module registers. Coherence is program-wide — it does not ask
## who wrote the `use` — so a reader needs to see that `==` on a `Map` is
## answered here even though no function in the list says so.
fn impls_html(c: Chrome, m: Json) -> String = {
  let names = map(jarr(jget(m, "impls")), i => "<code>" ++ escape_html(jstr(i)) ++ "</code>")
  if len(names) == 0 {
    ""
  } else {
    """<p class="api-impls">""" ++ c.impls_lead ++ join(names, c.impls_sep) ++ "</p>\n"
  }
}

fn section(id: String, title: String, intro: String, body: String) -> String =
  """<h2 id="$id">""" ++ escape_html(title) ++ "</h2>\n" ++ intro ++ body

fn sub(id: String, title: String) -> String =
  """<h3 class="api-group" id="$id">""" ++ escape_html(title) ++ "</h3>\n"

# ---- the three generated sections ----

fn prelude_html(docs: List[String], root: Json) -> (String, List[TocEntry]) = {
  var html = ""
  var toc: List[TocEntry] = []
  for g in jarr(jget(root, "groups")) {
    let name = field(g, "name")
    let gid = "g-$name"
    toc = toc ++ [TocEntry { level: 3, id: gid, text: name }]
    html = html ++ sub(gid, name)
    for f in jarr(jget(g, "fns")) {
      html = html ++ fn_entry(docs, "", "p", f) ++ "\n"
    }
  }
  (html, toc)
}

fn traits_html(docs: List[String], root: Json) -> String = {
  var html = ""
  for t in jarr(jget(root, "traits")) {
    html = html ++ trait_entry(docs, "prelude", t) ++ "\n"
  }
  html
}

fn modules_html(c: Chrome, docs: List[String], root: Json) -> (String, List[TocEntry]) = {
  var html = ""
  var toc: List[TocEntry] = []
  for m in jarr(jget(root, "modules")) {
    let path = field(m, "path")
    let id = "m-" ++ slug(path)
    # the call-site alias is the file's own name: `use std/str` binds `str`
    let qual = unwrap_or(str.strip_prefix(path, "std/"), path)
    toc = toc ++ [TocEntry { level: 3, id: id, text: path }]
    html = html ++ sub(id, path) ++ prose(docs, field(m, "doc")) ++ impls_html(c, m)
    for t in jarr(jget(m, "types")) {
      html = html ++ type_entry(docs, slug(path), t) ++ "\n"
    }
    for t in jarr(jget(m, "traits")) {
      html = html ++ trait_entry(docs, slug(path), t) ++ "\n"
    }
    for c in jarr(jget(m, "consts")) {
      html = html ++ const_entry(docs, qual, slug(path), c) ++ "\n"
    }
    for e in jarr(jget(m, "effects")) {
      html = html ++ effect_entry(docs, slug(path), e) ++ "\n"
    }
    for f in jarr(jget(m, "fns")) {
      html = html ++ fn_entry(docs, qual, slug(path), f) ++ "\n"
    }
  }
  (html, toc)
}

# ---- the same entries, as an index ----
#
# The search index (gen/search.dawn) needs the name, the declaration, the
# first line of the documentation and the ANCHOR of every entry on this page.
# The anchor is the part that cannot live anywhere else: an id here is built
# out of a module slug, a kind word and a name, in five spellings that differ
# from each other by one segment, and a second copy of those rules in another
# file would be a copy that goes wrong silently -- the link would resolve to
# nothing and only a reader would find out.
#
# So the enumeration is here, next to the functions that emit the ids, and the
# test at the bottom of this file holds the two to each other: every anchor
# this hands out has to be an id the page really carries, and the counts have
# to agree so that an entry kind added to the page and not to this is a
# failure rather than a silent omission.

## One entry of the standard library page, as an index needs it.
pub type ApiRow = { title: String, decl: String, doc: String, anchor: String }

fn api_row(title: String, decl: String, doc: String, anchor: String) -> ApiRow =
  ApiRow { title: title, decl: decl, doc: doc, anchor: anchor }

## Every entry on the standard library page, in the order the page shows them.
##
## The module and group HEADINGS are here too, as rows whose declaration is
## the heading's own kind: `std/str` is a thing a reader searches for, and the
## page anchors it at `m-std-str`.
pub fn api_rows(api: Json) -> List[ApiRow] = {
  var rows: List[ApiRow] = []
  for g in jarr(jget(api, "groups")) {
    let name = field(g, "name")
    rows = rows ++ [api_row(name, "prelude group", "", "g-$name")]
    for f in jarr(jget(g, "fns")) {
      rows = rows ++ [api_row(field(f, "name"), field(f, "sig"), field(f, "doc"),
        "p-" ++ field(f, "name"))]
    }
  }
  for t in jarr(jget(api, "traits")) {
    rows = rows ++ [trait_row("prelude", t)]
  }
  for m in jarr(jget(api, "modules")) {
    let path = field(m, "path")
    let base = slug(path)
    let qual = unwrap_or(str.strip_prefix(path, "std/"), path)
    rows = rows ++ [api_row(path, "module", field(m, "doc"), "m-$base")]
    for t in jarr(jget(m, "types")) {
      rows = rows
        ++ [api_row(field(t, "name"), type_decl(t), field(t, "doc"),
          "$base-type-" ++ field(t, "name"))]
    }
    for t in jarr(jget(m, "traits")) {
      rows = rows ++ [trait_row(base, t)]
    }
    for c in jarr(jget(m, "consts")) {
      let name = field(c, "name")
      rows = rows
        ++ [api_row(qualify(qual, name), "const $name: " ++ field(c, "type"), field(c, "doc"),
          "$base-$name")]
    }
    for e in jarr(jget(m, "effects")) {
      rows = rows
        ++ [api_row(field(e, "name"), "effect " ++ field(e, "name"), field(e, "doc"),
          "$base-effect-" ++ field(e, "name"))]
    }
    for f in jarr(jget(m, "fns")) {
      let name = field(f, "name")
      rows = rows
        ++ [api_row(qualify(qual, name), field(f, "sig"), field(f, "doc"), "$base-$name")]
    }
  }
  rows
}

fn trait_row(base: String, t: Json) -> ApiRow = {
  let name = field(t, "name")
  api_row(name, "trait $name[" ++ field(t, "typeParam") ++ "]", field(t, "doc"),
    "$base-trait-$name")
}

# ---- the page ----

## Which file this language's intro is written in, where the page goes, and how
## far it is from the site root. English is the original and takes the default
## layout; the translation sits under `/zh/`, like every other paired page.
fn stdlib_source(out: String, lang: Lang) -> (String, String, String) =
  match lang {
    En -> ("site/pages/stdlib.md", "$out/stdlib.html", ".")
    Zh -> ("site/pages/stdlib.zh.md", "$out/zh/stdlib.html", "..")
  }

## The standard library reference. `lang` picks the intro document, the chrome
## and the output path; the entries between them are the same in both runs,
## because they come from the compiler and its doc comments are English.
pub fn gen_stdlib(out: String, a: Assets, lang: Lang) -> Unit !io = {
  let (src, dst, root) = stdlib_source(out, lang)
  let c = chrome(lang, root)
  let text =
    match io.read_file("site/build/stdlib.json") {
      Ok(t) -> t
      Err(_) ->
        panic("site/build/stdlib.json missing — run site/build.sh (it runs dawn doc --stdlib)")
    }
  # `api`, not `root`: `root` is this page's distance from the site root, which
  # the two runs disagree about and every relative link on the page needs.
  let api =
    match parse(text) {
      Ok(v) -> v
      Err(e) -> panic("stdlib.json: " ++ error_text(e))
    }
  let docs = doc_files()
  let intro =
    match parser.parse(must_read(src)) {
      Ok(bs) -> render_doc(bs, u => map_doc_url(root, docs, u))
      Err(e) -> panic("$src: $e")
    }
  let (pre, pre_toc) = prelude_html(docs, api)
  let (mods, mod_toc) = modules_html(c, docs, api)
  let body = intro.html ++
    section("prelude", c.prelude_title, c.prelude_intro, pre) ++
    section("prelude-traits", c.traits_title, c.traits_intro, traits_html(docs, api)) ++
    section("modules", c.modules_title, c.modules_intro, mods)
  let toc = intro.toc ++
    [TocEntry { level: 2, id: "prelude", text: c.prelude_title }] ++ pre_toc ++
    [TocEntry { level: 2, id: "prelude-traits", text: c.traits_title }] ++
    [TocEntry { level: 2, id: "modules", text: c.modules_title }] ++ mod_toc
  write_page(dst,
    page_with_toc(a, lang, "stdlib.html", "${intro.title} — Dawn", root, "stdlib", toc, body))
}

fn jobj(entries: List[(String, Json)]) -> Json = JObj(map.from(entries))

test "each language's intro reads its own file and lands in its own place" {
  assert stdlib_source("d", En) == ("site/pages/stdlib.md", "d/stdlib.html", ".")
  assert stdlib_source("d", Zh) == ("site/pages/stdlib.zh.md", "d/zh/stdlib.html", "..")
}

## The chrome's one link is written from the page, so it moves with the page --
## and, since the spec was translated, it also points at the spec in the
## page's own language. A constant `spec.html` was right for as long as this
## page only ever sat at the site root, and would 404 from `/zh/` the day the
## twin appeared.
test "the chrome's spec link is relative to the page that carries it" {
  assert str.contains(chrome(En, ".").traits_intro, `href="./spec.html#s10-6"`)
  assert str.contains(chrome(Zh, "..").traits_intro, `href="../zh/spec.html#s10-6"`)
}

test "module paths become id fragments and call-site aliases" {
  assert slug("std/str") == "std-str"
  assert qualify("str", "trim") == "str.trim"
  # the prelude's names have no module to qualify them with
  assert qualify("", "println") == "println"
}

test "a type with no constructors keeps its representation to itself" {
  let opaque = jobj([("name", JStr("Cursor")), ("record", JBool(false)),
    ("typeParams", JArr([])), ("ctors", JArr([]))])
  assert type_decl(opaque) == "type Cursor"
}

test "records and sums reassemble into their declarations" {
  let field_of = (n: String, t: String) =>
    jobj([("name", JStr(n)), ("type", JStr(t))])
  let rec = jobj([("name", JStr("Pair")), ("record", JBool(true)),
    ("typeParams", JArr([JStr("A"), JStr("B")])),
    ("ctors", JArr([jobj([("name", JStr("Pair")),
      ("fields", JArr([field_of("a", "A"), field_of("b", "B")]))])]))])
  assert type_decl(rec) == "type Pair[A, B] = { a: A, b: B }"

  let sum = jobj([("name", JStr("Shape")), ("record", JBool(false)),
    ("typeParams", JArr([])),
    ("ctors", JArr([
      jobj([("name", JStr("Circle")), ("fields", JArr([field_of("r", "Float")]))]),
      jobj([("name", JStr("Dot")), ("fields", JArr([]))])
    ]))])
  assert type_decl(sum) == "type Shape = Circle(r: Float) | Dot"
}

test "a doc comment is rendered as Markdown, not escaped whole" {
  let html = prose([], "First line, `code` and *em*.\n\nA second paragraph.")
  assert str.contains(html, "<code>code</code>")
  assert str.contains(html, "<em>em</em>")
  assert str.contains(html, "<p>A second paragraph.</p>")
  # an empty doc contributes nothing at all
  assert prose([], "") == ""
}

## The anchors [api_rows] hands the search index have to be ids this page
## really carries, and there have to be exactly as many of them as the page
## has anchored things. Both halves matter and they fail differently: a
## misspelled anchor is a search result that lands on the top of stdlib.html
## instead of on the entry, and an entry kind the page grew and this did not
## is a name the search can never find.
##
## Built from a synthetic `dawn doc --stdlib` document rather than from the
## real one, because `dawn test site` runs before site/build.sh writes it.
test "every index anchor is an id the page carries, and there are as many of each" {
  let api = probe_api()
  let rows = api_rows(api)
  let (pre, _) = prelude_html([], api)
  let (mods, _) = modules_html(chrome(En, "."), [], api)
  let html = pre ++ traits_html([], api) ++ mods
  for r in rows {
    assert str.contains(html, "id=\"" ++ r.anchor ++ "\"")
  }
  # Every id on the page is one of these rows: same count, no leftovers on
  # either side. `sub` and `entry` are the only two things here that emit an
  # id, so counting them counts the anchored things.
  assert len(str.split(html, ` id="`)) - 1 == len(rows)
  # and the five spellings really are five, so a slug that stopped
  # distinguishing them would move one of these lines
  assert map(rows, r => r.anchor) == [
    "g-io", "p-println", "prelude-trait-Show", "m-std-str", "std-str-type-Case",
    "std-str-trait-Split", "std-str-WIDTH", "std-str-effect-Ask", "std-str-trim",
  ]
  assert map(rows, r => r.title) == [
    "io", "println", "Show", "std/str", "Case", "Split", "str.WIDTH", "Ask", "str.trim",
  ]
}

fn probe_api() -> Json =
  jobj([
    ("groups", JArr([
      jobj([("name", JStr("io")),
        ("fns", JArr([
          jobj([("name", JStr("println")), ("sig", JStr("fn println(s: String) -> Unit !io")),
            ("doc", JStr("Print a line."))]),
        ]))]),
    ])),
    ("traits", JArr([
      jobj([("name", JStr("Show")), ("typeParam", JStr("T")), ("assoc", JArr([])),
        ("methods", JArr([])), ("doc", JStr("Text for a value."))]),
    ])),
    ("modules", JArr([
      jobj([
        ("path", JStr("std/str")),
        ("doc", JStr("Strings.")),
        ("impls", JArr([])),
        ("types", JArr([
          jobj([("name", JStr("Case")), ("record", JBool(false)), ("typeParams", JArr([])),
            ("ctors", JArr([])), ("doc", JStr("A case."))]),
        ])),
        ("traits", JArr([
          jobj([("name", JStr("Split")), ("typeParam", JStr("T")), ("assoc", JArr([])),
            ("methods", JArr([])), ("doc", JStr("Splitting."))]),
        ])),
        ("consts", JArr([
          jobj([("name", JStr("WIDTH")), ("type", JStr("Int")), ("doc", JStr("A width."))]),
        ])),
        ("effects", JArr([
          jobj([("name", JStr("Ask")), ("ops", JArr([])), ("doc", JStr("Asking."))]),
        ])),
        ("fns", JArr([
          jobj([("name", JStr("trim")), ("sig", JStr("fn trim(s: String) -> String")),
            ("doc", JStr("Trim it."))]),
        ])),
      ]),
    ])),
  ])

test "a marker comment never reaches the html, a stray < still escapes" {
  # end to end (parse then render): the two halves of the same rule
  assert prose([], "状态：权威。<!-- doc-check: version -->") == "<p>状态：权威。</p>\n"
  assert prose([], "a < b") == "<p>a &lt; b</p>\n"
}

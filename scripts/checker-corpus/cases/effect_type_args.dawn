# cx.dawn: the refusals around an explicit effect argument at a type
# application (spec §6.3). The accept half lives in effect_type_args_ok.dawn;
# here the golden records what each refusal says and why, in emission order.
#
# What is *not* here is a refusal of any particular row. A transparent alias
# expands, so its argument position takes whatever the inline row position
# takes; what refuses a row is what refuses it inline, and the last three cases
# below are those refusals arriving through the argument.
effect Ask { fn get() -> Int }

alias Thunk[!e] = fn() -> Int !e

alias Mapper[T, U, !e] = fn(T) -> U !e

type Cell[!e] = { f: fn() -> Int !e }

type Pair[T] = { a: T, b: T }

type Chain[!e] =
  | Ready
  | Later(mk: fn() -> Int !e)

opaque type Hidden[!e] = fn(Int) -> Int !e

# --- the kind mismatch, both directions ---

# an effect argument at a declaration that binds none: the wrong axis, and the
# type-parameter arity would name the wrong list
fn no_binder(p: Pair[!io]) -> Int = p.a

# a builtin is the same answer from a different table
fn builtin_binder(xs: List[!io]) -> Int = 1

# and a type argument at a declaration whose only parameter is an effect one.
# The arity message is the old one; the hint is what says the parameter exists
# and is spelled with a `!`
fn wrong_axis(c: Cell[Int]) -> Int !io = (c.f)()

# too many, on the axis that does have parameters
fn too_many(t: Thunk[!io, !io]) -> Int !io = t()

# --- a nominal type has no argument position at all ---

# a record: named by its name and its type arguments, with nowhere to keep a row
fn record_io(c: Cell[!io]) -> Int !io = (c.f)()

# a variant says the same thing about itself
fn variant_io(c: Chain[!io]) -> Int !io =
  match c {
    Ready -> 0
    Later(mk) -> mk()
  }

# and an opaque type, whose target *would* carry the substitution -- which is
# worse, not better: the two types print as one name
fn opaque_io(h: Hidden[!io]) -> Int !io = 1

# --- the argument is a row, and a row is resolved ---

# a name that is not an effect is reported by the resolver that reports it
# inside a function type, in the same words
fn unknown_atom(t: Thunk[!Nope]) -> Int !io = t()

# --- the substitution is real, and this is where it shows ---

# with the argument written, the row in the expansion is io, so a pure
# consumer is refused for owing io
fn io_slot(t: Thunk[!io]) -> Int = t()

# a label substitutes the same way, and then the consumer owes the label
fn label_slot(t: Thunk[!Ask]) -> Int = t()

# a variable the *argument* introduced is bound on this signature, so the
# ordinary repair applies: write it on the row too
fn var_slot(t: Thunk[!e]) -> Int = t()

# with the argument elided, the row is the alias's own variable, and the
# refusal is the other one -- the variable is bound on `Mapper`, not here, so
# the repair is to stop eliding. Two spellings, two sentences: that is the
# argument doing something.
fn own_var(m: Mapper[Int, String]) -> String = m(1)

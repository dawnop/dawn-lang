# A module alias is not a value (spec §10.3), so a bare `m.f` on the right of
# a pipe names a function exactly as a bare `f` does: `n |> str.starts_with` is
# the call `str.starts_with(n)`, and its arity error names the declaration.
# Applied as a function value instead (#66) it would report an anonymous arity.
use std/str

pub fn module_member(n: String) -> Bool = n |> str.starts_with

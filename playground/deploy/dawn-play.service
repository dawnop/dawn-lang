# systemd unit for the dawn-play runner. Install to /etc/systemd/system/,
# then: systemctl daemon-reload && systemctl enable --now dawn-play
#
# Runs as the unprivileged dawn-play user. The runner itself does NOT need the
# hardening the sandbox has — it only shells out to `sudo run-sandboxed.sh`,
# which is where untrusted code actually executes. Keep this user minimal and
# distinct from the blog backend's user.
[Unit]
Description=dawn-play — Dawn Playground runner
After=network.target

[Service]
Type=simple
User=dawn-play
Group=dawn-play
WorkingDirectory=/opt/dawn

# One pinned GraalVM CE 21.0.2 for everything the runner launches, unpacked for
# it alone (DEPLOY.md step 2, install-jdk.sh): the server runs the toolchain CI
# and the dev box test on, and no system package (a JDK from apt would move the
# patch level of the JRE other JVM services on this host share) is involved.
# /opt/dawn/bin/dawn is the launcher; it uses JAVA_HOME for the runner itself.
# PLAY_JDK is where the runner takes `java` (/run) and `javap` (/compile) from,
# as absolute paths on the sandbox units' argv, since a unit starts with an
# empty environment. The units' own `dawn` finds this JDK through JAVA_HOME,
# which run-sandboxed.sh sets to the same path.
Environment=JAVA_HOME=/opt/dawn/graalvm-21
Environment=PLAY_JDK=/opt/dawn/graalvm-21
# Heap ceiling for the broker, kept under MemoryMax below. `dawn run` compiles
# the runner in-process at startup, and bin/dawn's default -Xmx2g is twice that
# cap on a box with 3.4G total and no swap -- the JVM would aim past the cgroup
# and be SIGKILLed mid-startup. Measured 2026-08-05: that startup compile peaks
# at 606 MB RSS, and the runner boots and serves fine at 512m.
#
# Quoted because the value contains a space: systemd splits `Environment=` on
# whitespace, so the unquoted form assigns DAWN_JVM_OPTS=-Xss512m and discards
# the rest with "Invalid environment assignment, ignoring: -Xmx512m" in the
# journal. The service starts either way and looks healthy -- the cap is simply
# absent. (Shipped that way for one restart on 2026-08-05; caught by reading
# -Xmx off the running process rather than trusting the unit file.)
Environment="DAWN_JVM_OPTS=-Xss512m -Xmx512m"
Environment=DAWN_BIN=/opt/dawn/bin/dawn
Environment=PLAY_PORT=8087
Environment=PLAY_TIMEOUT=10
# The sandbox is fail-closed in config.sandbox_enabled, so there is nothing to
# switch on here any more — only PLAY_UNSAFE_LOCAL=1 would switch it off, and
# production must never set it.
Environment=PLAY_SANDBOX_SCRIPT=/opt/dawn/playground/sandbox/run-sandboxed.sh
# per-request work dirs — must NOT be under /tmp (DynamicUser implies PrivateTmp)
Environment=PLAY_WORK_ROOT=/var/lib/dawn-play/work
ExecStart=/opt/dawn/bin/dawn run /opt/dawn/playground

Restart=on-failure
RestartSec=2
# the runner brokers requests but the real isolation is the per-request sandbox;
# still, give the broker itself a sane ceiling
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target

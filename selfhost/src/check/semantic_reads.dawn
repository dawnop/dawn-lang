    id => if id == 7 { Some(17) } else { None }, e => None) == Some(Some([
      RenderedConstructor(CtorI { ..ctor, adt: 17, fields: [FieldI { name: "value", ty: TyInt }] }, "Box(value: T): Box[T]")]))
  assert project(reads, s => None, t => Some(t), id => None, e => Some(e)) == None
  assert project(reads, s => None, t => None, id => Some(id), e => Some(e)) == None
}


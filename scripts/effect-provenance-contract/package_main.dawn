# The dependency alias differs from its declared package identity.
use std/io.{println}
use std/provenance
use g/calls.{dispatch}
fn user(n: Int) -> Int = n + 1
pub fn main() -> Unit !io = {
  let before: fn(Int) -> Int = n => user(n)
  let (answer, tree) = provenance.observe(scope => {
    let answer = dispatch(before, 6)
    (answer, provenance.completed(scope))
  })
  println("${answer}")
  println(tree)
}

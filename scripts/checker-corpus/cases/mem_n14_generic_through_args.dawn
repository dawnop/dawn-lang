# Generic wrappers are legal; their callers cannot hide a region in a result.
use std/mem
use std/mem.{Mem}
pub fn scope_opt[T: ^{c}, ^c](f: fn[@s]() -> Option[T] !Mem[s] ^{c}) -> Option[T] = mem.with_mem(f)
pub fn scope_pair[T: ^{c}, ^c](f: fn[@s]() -> (Int, T) !Mem[s] ^{c}) -> (Int, T) = mem.with_mem(f)
fn escaped_opt() = scope_opt([@s] () => Some(mem.new(4)))
fn escaped_pair() = scope_pair([@s] () => (1, mem.new(4)))

# #43: a local fn whose body raises a label its own row does not name. The
# checker refuses it now; with that refusal mutated away, the lifted fn asks
# its pack for `Fs` and no caller put it there.
use std/io
use std/io.{Fs, with_fs_real}

fn outer(p: String) -> Bool !Fs !io = {
  fn probe(q: String) -> Bool !io = io.exists(q)
  probe(p)
}

pub fn main() -> Unit !io = io.println("${with_fs_real(() => outer("/definitely/not/here"))}")

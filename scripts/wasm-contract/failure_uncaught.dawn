# An uncaught panic, wasm against native: same stdout, same exit code, and
# the message reaches stderr whole on both targets (the raise-with-no-handler
# path reports and exits without any landing machinery on either).
use std/io
use std/str

fn holder() -> Int !io = {
  let big = str.repeat("Y", 4096)
  panic("UNCAUGHT-" ++ str.repeat("x", 600))
  str.len(big)
}

pub fn main() -> Unit !io = {
  println("before the uncaught panic")
  println("NOT REACHED " ++ to_string(holder()))
}

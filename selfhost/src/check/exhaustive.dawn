# Pattern exhaustiveness via the usefulness algorithm (Maranget 2007; port of
# check/Exhaustive.kt). A match is exhaustive iff a wildcard row is NOT useful
# after all its unguarded rows. The checker lowers its (resolved) AST patterns
# to SPat rows — Kotlin's `SLit(value: Any)` becomes the LitV sum here, and a
# constructor is identified by (adt id, ctor index) against the ADT table.

use std/list
use std/map
use check/types.{
  Ty, TyVar, TyAdt, TyTuple, TyList, TyBool, TyInt, TyString, TyError,
  Adts, AdtI, CtorI, adt_of, subst, Eff, prelude_adts, OPTION_ID, opt_ty
}

pub type LitV =
  | LInt(v: Int)
  | LFloat(v: Float)
  | LBool(v: Bool)
  | LStr(v: String)

pub type SPat =
  | SWild
  | SOr(alts: List[SPat])
  | SCtor(adt: Int, ci: Int, subs: List[SPat])
  | SLit(v: LitV)
  | STuple(subs: List[SPat])
  | SList(pre: List[SPat], has_rest: Bool, post: List[SPat])

const USEFUL_STEP_LIMIT: Int = 8192
const USEFUL_ROW_LIMIT: Int = 4096

fn slist_arity(pre: List[SPat], post: List[SPat]) -> Int = len(pre) + len(post)

fn wilds(n: Int) -> List[SPat] = {
  var out: List[SPat] = []
  for i in 0..n { out = out ++ [SWild] }
  out
}

fn ctor_at(adts: Adts, adt: Int, ci: Int) -> CtorI = adt_of(adts, adt).ctors[ci]

fn expand_head_row(row: List[SPat], out0: List[List[SPat]]) -> Option[List[List[SPat]]] = {
  var out = out0
  if len(row) == 0 {
    if len(out) >= USEFUL_ROW_LIMIT { return None }
    return Some(out ++ [row])
  }
  match row[0] {
    SOr(alts) -> {
      let tail = list.drop(row, 1)
      for alt in alts {
        match expand_head_row([alt] ++ tail, out) {
          Some(next) -> { out = next }
          None -> return None
        }
      }
      Some(out)
    }
    _ -> {
      if len(out) >= USEFUL_ROW_LIMIT { return None }
      Some(out ++ [row])
    }
  }
}

fn expand_head_ors(matrix: List[List[SPat]]) -> Option[List[List[SPat]]] = {
  var out: List[List[SPat]] = []
  for row in matrix {
    match expand_head_row(row, out) {
      Some(next) -> { out = next }
      None -> return None
    }
  }
  Some(out)
}

## Constructor field types with the column's type arguments substituted in.
fn inst_fields(adts: Adts, adt: Int, ci: Int, column: Ty) -> List[Ty] = {
  let a = adt_of(adts, adt)
  let c = a.ctors[ci]
  let field_tys = map(c.fields, f => f.ty)
  match column {
    TyAdt(_, targs) ->
      if len(a.tparams) == 0 {
        field_tys
      } else {
        var m: Map[Int, Ty] = map.empty()
        var i = 0
        for tp in a.tparams {
          match tp {
            TyVar(_, id) ->
              match get(targs, i) {
                Some(arg) -> { m = map.insert(m, id, arg) }
                None -> ()
              }
            _ -> ()
          }
          i = i + 1
        }
        let m2 = m
        let em: Map[Int, Eff] = map.empty()
        map(field_tys, ft => subst(ft, m2, em))
      }
    _ -> field_tys
  }
}

fn err_tys(n: Int) -> List[Ty] = {
  var out: List[Ty] = []
  for _i in 0..n { out = out ++ [TyError] }
  out
}

fn elem_tys_of(elem: Ty, n: Int) -> List[Ty] = {
  var out: List[Ty] = []
  for _i in 0..n { out = out ++ [elem] }
  out
}

fn all_wild(patterns: List[SPat]) -> Bool = {
  for pattern in patterns {
    match pattern {
      SWild -> ()
      _ -> return false
    }
  }
  true
}

fn complete_ctor_alts(adts: Adts, patterns: List[SPat], adt: Int) -> Bool = {
  let info = adt_of(adts, adt)
  var ci = 0
  for _ctor in info.ctors {
    var found = false
    for pattern in patterns {
      match pattern {
        SCtor(found_adt, found_ci, subs) ->
          if found_adt == adt && found_ci == ci && all_wild(subs) { found = true }
        _ -> ()
      }
    }
    if not found { return false }
    ci = ci + 1
  }
  len(info.ctors) > 0
}

fn simplify_pat(adts: Adts, pattern: SPat, column: Ty) -> SPat =
  match pattern {
    SWild -> SWild
    SLit(_) -> pattern
    SOr(alts) -> {
      var flat: List[SPat] = []
      for alt in alts {
        let simplified = simplify_pat(adts, alt, column)
        match simplified {
          SWild -> return SWild
          SOr(inner) -> { flat = flat ++ inner }
          _ -> { flat = flat ++ [simplified] }
        }
      }
      if column == TyBool {
        var has_true = false
        var has_false = false
        for alt in flat {
          match alt {
            SLit(LBool(true)) -> { has_true = true }
            SLit(LBool(false)) -> { has_false = true }
            _ -> ()
          }
        }
        if has_true && has_false { return SWild }
      }
      match column {
        TyAdt(adt, _) -> if complete_ctor_alts(adts, flat, adt) { return SWild }
        _ -> ()
      }
      if len(flat) == 1 { flat[0] } else { SOr(flat) }
    }
    SCtor(adt, ci, subs) -> {
      let field_tys = inst_fields(adts, adt, ci, column)
      var simplified: List[SPat] = []
      var index = 0
      for sub in subs {
        let field_ty = match get(field_tys, index) {
          Some(found) -> found
          None -> TyError
        }
        simplified = simplified ++ [simplify_pat(adts, sub, field_ty)]
        index = index + 1
      }
      match column {
        TyAdt(found_adt, _) ->
          if found_adt == adt && len(adt_of(adts, adt).ctors) == 1 && all_wild(simplified) {
            SWild
          } else {
            SCtor(adt, ci, simplified)
          }
        _ -> SCtor(adt, ci, simplified)
      }
    }
    STuple(subs) -> {
      let elem_tys = match column {
        TyTuple(found) -> found
        _ -> err_tys(len(subs))
      }
      var simplified: List[SPat] = []
      var index = 0
      for sub in subs {
        let elem_ty = match get(elem_tys, index) {
          Some(found) -> found
          None -> TyError
        }
        simplified = simplified ++ [simplify_pat(adts, sub, elem_ty)]
        index = index + 1
      }
      match column {
        TyTuple(_) -> if all_wild(simplified) { SWild } else { STuple(simplified) }
        _ -> STuple(simplified)
      }
    }
    SList(pre, has_rest, post) -> {
      let elem_ty = match column {
        TyList(found) -> found
        _ -> TyError
      }
      let simplified_pre = map(pre, sub => simplify_pat(adts, sub, elem_ty))
      let simplified_post = map(post, sub => simplify_pat(adts, sub, elem_ty))
      if has_rest && len(simplified_pre) == 0 && len(simplified_post) == 0 {
        SWild
      } else {
        SList(simplified_pre, has_rest, simplified_post)
      }
    }
  }

fn simplify_row(adts: Adts, row: List[SPat], types_: List[Ty]) -> List[SPat] = {
  var out: List[SPat] = []
  var index = 0
  for pattern in row {
    let column = match get(types_, index) {
      Some(found) -> found
      None -> TyError
    }
    out = out ++ [simplify_pat(adts, pattern, column)]
    index = index + 1
  }
  out
}

fn simplify_matrix(
  adts: Adts,
  matrix: List[List[SPat]],
  types_: List[Ty]
) -> List[List[SPat]] =
  map(matrix, row => simplify_row(adts, row, types_))

## Would a value matching `q` slip through every row of `matrix`? `None`
## means the deterministic work budget was exhausted before the answer was
## known; callers must diagnose that state rather than guess either answer.
pub fn useful_result(
  adts: Adts,
  matrix: List[List[SPat]],
  q: List[SPat],
  types_: List[Ty]
) -> Option[Bool] = {
  let normalized_matrix = simplify_matrix(adts, matrix, types_)
  let normalized_q = simplify_row(adts, q, types_)
  let (_, result) = useful_go(
    adts, normalized_matrix, normalized_q, types_, USEFUL_STEP_LIMIT)
  result
}

pub fn useful(adts: Adts, matrix: List[List[SPat]], q: List[SPat], types_: List[Ty]) -> Bool =
  match useful_result(adts, matrix, q, types_) {
    Some(result) -> result
    None -> panic("usefulness exceeded its deterministic work budget")
  }

fn useful_go(
  adts: Adts,
  matrix: List[List[SPat]],
  q: List[SPat],
  types_: List[Ty],
  fuel: Int
) -> (Int, Option[Bool]) = {
  if fuel <= 0 || len(matrix) > USEFUL_ROW_LIMIT { return (0, None) }
  let expanded = match expand_head_ors(matrix) {
    Some(rows) -> rows
    None -> return (0, None)
  }
  let cost = len(expanded) + 1
  if fuel < cost { return (0, None) }
  let left0 = fuel - cost
  if len(q) == 0 { return (left0, Some(len(expanded) == 0)) }
  let column = types_[0]
  let rest_q = list.drop(q, 1)
  let rest_t = list.drop(types_, 1)
  match q[0] {
    SOr(alts) -> {
      var left = left0
      for alt in alts {
        let (next, result) = useful_go(adts, expanded, [alt] ++ rest_q, types_, left)
        left = next
        match result {
          Some(true) -> return (left, Some(true))
          Some(false) -> ()
          None -> return (left, None)
        }
      }
      (left, Some(false))
    }
    SCtor(adt, ci, subs) ->
      useful_go(adts, spec_ctor(adts, expanded, adt, ci), subs ++ rest_q,
        inst_fields(adts, adt, ci, column) ++ rest_t, left0)
    SLit(value) -> useful_go(adts, spec_lit(expanded, value), rest_q, rest_t, left0)
    STuple(subs) -> {
      let elem_tys = match column {
        TyTuple(elems) -> if len(elems) == 0 { err_tys(len(subs)) } else { elems }
        _ -> err_tys(len(subs))
      }
      useful_go(adts, spec_tuple(expanded, len(subs)), subs ++ rest_q,
        elem_tys ++ rest_t, left0)
    }
    SList(pre, has_rest, post) -> {
      let elem = match column {
        TyList(found) -> found
        _ -> TyError
      }
      if not has_rest {
        let arity = len(pre)
        useful_go(adts, spec_list(expanded, arity), pre ++ rest_q,
          elem_tys_of(elem, arity) ++ rest_t, left0)
      } else {
        let arity = slist_arity(pre, post)
        let bound = list_len_bound(expanded, Some(q[0]))
        var left = left0
        var length = arity
        while length <= bound {
          let (next, result) = useful_go(adts, spec_list(expanded, length),
            pre ++ wilds(length - arity) ++ post ++ rest_q,
            elem_tys_of(elem, length) ++ rest_t, left)
          left = next
          match result {
            Some(true) -> return (left, Some(true))
            Some(false) -> ()
            None -> return (left, None)
          }
          length = length + 1
        }
        (left, Some(false))
      }
    }
    SWild -> {
      match column {
        TyList(elem) -> {
          let bound = list_len_bound(expanded, None)
          var left = left0
          var length = 0
          while length <= bound {
            let (next, result) = useful_go(adts, spec_list(expanded, length),
              wilds(length) ++ rest_q, elem_tys_of(elem, length) ++ rest_t, left)
            left = next
            match result {
              Some(true) -> return (left, Some(true))
              Some(false) -> ()
              None -> return (left, None)
            }
            length = length + 1
          }
          return (left, Some(false))
        }
        TyTuple(elems) ->
          return useful_go(adts, spec_tuple(expanded, len(elems)),
            wilds(len(elems)) ++ rest_q, elems ++ rest_t, left0)
        TyAdt(aid, _) -> {
          let adt = adt_of(adts, aid)
          if heads_complete(expanded, aid, len(adt.ctors)) {
            var left = left0
            var ci = 0
            for ctor in adt.ctors {
              let (next, result) = useful_go(adts, spec_ctor(adts, expanded, aid, ci),
                wilds(len(ctor.fields)) ++ rest_q,
                inst_fields(adts, aid, ci, column) ++ rest_t, left)
              left = next
              match result {
                Some(true) -> return (left, Some(true))
                Some(false) -> ()
                None -> return (left, None)
              }
              ci = ci + 1
            }
            return (left, Some(false))
          }
        }
        _ ->
          if column == TyBool && lit_has(expanded, LBool(true)) &&
          lit_has(expanded, LBool(false)) {
            let (after_true, true_result) = useful_go(
              adts, spec_lit(expanded, LBool(true)), rest_q, rest_t, left0)
            match true_result {
              Some(true) -> return (after_true, Some(true))
              None -> return (after_true, None)
              Some(false) -> ()
            }
            return useful_go(
              adts, spec_lit(expanded, LBool(false)), rest_q, rest_t, after_true)
          }
      }
      var defaulted: List[List[SPat]] = []
      for row in expanded {
        match row[0] {
          SWild -> { defaulted = defaulted ++ [list.drop(row, 1)] }
          _ -> ()
        }
      }
      useful_go(adts, defaulted, rest_q, rest_t, left0)
    }
  }
}

fn heads_complete(matrix: List[List[SPat]], adt: Int, nctors: Int) -> Bool = {
  var seen: List[Int] = []
  for row in matrix {
    match row[0] {
      SCtor(a, ci, _) ->
        if a == adt && not has_int(seen, ci) { seen = seen ++ [ci] }
      _ -> ()
    }
  }
  len(seen) == nctors
}

fn has_int(xs: List[Int], x: Int) -> Bool = {
  for y in xs {
    if y == x { return true }
  }
  false
}

fn lit_has(matrix: List[List[SPat]], v: LitV) -> Bool = {
  for row in matrix {
    match row[0] {
      SLit(w) -> if w == v { return true }
      _ -> ()
    }
  }
  false
}

fn spec_ctor(adts: Adts, matrix: List[List[SPat]], adt: Int, ci: Int) -> List[List[SPat]] = {
  let nfields = len(ctor_at(adts, adt, ci).fields)
  var out: List[List[SPat]] = []
  for row in matrix {
    match row[0] {
      SWild -> { out = out ++ [wilds(nfields) ++ list.drop(row, 1)] }
      SCtor(a, c, subs) ->
        if a == adt && c == ci { out = out ++ [subs ++ list.drop(row, 1)] }
      _ -> ()
    }
  }
  out
}

fn spec_lit(matrix: List[List[SPat]], v: LitV) -> List[List[SPat]] = {
  var out: List[List[SPat]] = []
  for row in matrix {
    match row[0] {
      SWild -> { out = out ++ [list.drop(row, 1)] }
      SLit(w) -> if w == v { out = out ++ [list.drop(row, 1)] }
      _ -> ()
    }
  }
  out
}

fn spec_tuple(matrix: List[List[SPat]], n: Int) -> List[List[SPat]] = {
  var out: List[List[SPat]] = []
  for row in matrix {
    match row[0] {
      SWild -> { out = out ++ [wilds(n) ++ list.drop(row, 1)] }
      STuple(subs) -> { out = out ++ [subs ++ list.drop(row, 1)] }
      _ -> ()
    }
  }
  out
}

## Specialize a list column to exactly `n` elements (a rest expands to wildcards).
fn spec_list(matrix: List[List[SPat]], n: Int) -> List[List[SPat]] = {
  var out: List[List[SPat]] = []
  for row in matrix {
    match row[0] {
      SWild -> { out = out ++ [wilds(n) ++ list.drop(row, 1)] }
      SList(pre, has_rest, post) ->
        if not has_rest {
          if len(pre) == n { out = out ++ [pre ++ list.drop(row, 1)] }
        } else if slist_arity(pre, post) <= n {
          out = out ++ [pre ++ wilds(n - slist_arity(pre, post)) ++ post ++ list.drop(row, 1)]
        }
      _ -> ()
    }
  }
  out
}

## One past the longest list pattern in play: lengths beyond behave uniformly.
fn list_len_bound(matrix: List[List[SPat]], q: Option[SPat]) -> Int = {
  var m = 0
  for row in matrix {
    if len(row) > 0 {
      match row[0] {
        SList(pre, has_rest, post) -> {
          let x = if has_rest { slist_arity(pre, post) } else { len(pre) }
          if x > m { m = x }
        }
        _ -> ()
      }
    }
  }
  match q {
    Some(SList(pre, has_rest, post)) -> {
      let x = if has_rest { slist_arity(pre, post) } else { len(pre) }
      if x > m { m = x }
    }
    _ -> ()
  }
  m + 1
}

## Witnesses for a non-exhaustive match over a list: [], [_], [_, _, ..] ...
pub fn missing_list_patterns_result(
  adts: Adts,
  rows: List[List[SPat]],
  t: Ty
) -> Option[List[String]] = {
  let bound = list_len_bound(rows, None)
  var missing: List[String] = []
  var l = 0
  while l <= bound {
    let q = SList(wilds(l), false, [])
    match useful_result(adts, rows, [q], [t]) {
      Some(true) -> {
        var elems: List[String] = []
        for _i in 0..l { elems = elems ++ ["_"] }
        if l == bound { elems = elems ++ [".."] }
        missing = missing ++ ["[" ++ join(elems, ", ") ++ "]"]
      }
      Some(false) -> ()
      None -> return None
    }
    l = l + 1
  }
  Some(missing)
}

pub fn missing_list_patterns(adts: Adts, rows: List[List[SPat]], t: Ty) -> List[String] =
  match missing_list_patterns_result(adts, rows, t) {
    Some(patterns) -> patterns
    None -> panic("missing-list analysis exceeded its deterministic work budget")
  }

# ---- tests ----

test "an option match missing None is caught" {
  let adts = prelude_adts()
  # match on Option[Int] with only Some(_) covered
  let rows = [[SCtor(OPTION_ID, 0, [SWild])]]
  assert useful(adts, rows, [SWild], [opt_ty(TyInt)])
  # adding None makes it exhaustive
  let rows2 = rows ++ [[SCtor(OPTION_ID, 1, [])]]
  assert not useful(adts, rows2, [SWild], [opt_ty(TyInt)])
}

test "bool literals complete a match" {
  let adts = prelude_adts()
  let rows = [[SLit(LBool(true))], [SLit(LBool(false))]]
  assert not useful(adts, rows, [SWild], [TyBool])
  assert useful(adts, [[SLit(LBool(true))]], [SWild], [TyBool])
}

test "or-patterns stay structured through constructors, tuples, and lists" {
  let adts = prelude_adts()
  let bools = SOr([SLit(LBool(true)), SLit(LBool(false))])
  assert not useful(adts, [[bools]], [SWild], [TyBool])

  let option_row = [SOr([
    SCtor(OPTION_ID, 0, [bools]),
    SCtor(OPTION_ID, 1, [])
  ])]
  assert not useful(adts, [option_row], [SWild], [opt_ty(TyBool)])

  let tuple_row = [STuple([bools, SWild])]
  assert not useful(adts, [tuple_row], [SWild], [TyTuple([TyBool, TyString])])

  let list_row = [SOr([
    SList([], false, []),
    SList([SWild], true, [])
  ])]
  assert not useful(adts, [list_row], [SWild], [TyList(TyInt)])
}

test "complete boolean alternatives normalize before recursive expansion" {
  let adts = prelude_adts()
  let bools = SOr([SLit(LBool(true)), SLit(LBool(false))])
  var elems: List[SPat] = []
  for _i in 0..24 { elems = elems ++ [bools] }
  let rows = [[SList(elems, false, [])], [SWild]]
  assert useful_result(adts, rows, [SWild], [TyList(TyBool)]) == Some(false)
}

test "pathological alternatives exhaust the deterministic work budget" {
  let adts = prelude_adts()
  let branch = SOr([
    SCtor(OPTION_ID, 0, [SLit(LBool(true))]),
    SCtor(OPTION_ID, 0, [SLit(LBool(false))]),
    SCtor(OPTION_ID, 1, [])
  ])
  var elems: List[SPat] = []
  var types_: List[Ty] = []
  for _i in 0..8 {
    elems = elems ++ [branch]
    types_ = types_ ++ [opt_ty(TyBool)]
  }
  assert useful_result(adts, [[STuple(elems)]], [SWild], [TyTuple(types_)]) == None
}

test "int literals are never complete" {
  let adts = prelude_adts()
  let rows = [[SLit(LInt(1))], [SLit(LInt(2))]]
  assert useful(adts, rows, [SWild], [TyInt])
}

test "list patterns probe lengths" {
  let adts = prelude_adts()
  # [] and [x, ..rest] together are exhaustive
  let rows = [[SList([], false, [])], [SList([SWild], true, [])]]
  assert not useful(adts, rows, [SWild], [TyList(TyInt)])
  # [] and [x] leave two-element lists uncovered
  let rows2 = [[SList([], false, [])], [SList([SWild], false, [])]]
  assert useful(adts, rows2, [SWild], [TyList(TyInt)])
  assert missing_list_patterns(adts, rows2, TyList(TyInt)) == ["[_, _, ..]"]
}

test "tuples decompose into their elements" {
  let adts = prelude_adts()
  let rows = [[STuple([SLit(LBool(true)), SWild])], [STuple([SLit(LBool(false)), SWild])]]
  assert not useful(adts, rows, [SWild], [TyTuple([TyBool, TyString])])
}

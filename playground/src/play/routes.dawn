# The runner's four routes as functions of the request body, shared by the two
# entry points: main.dawn (the long-lived `web` server) and play/serve.dawn (one
# request per process, K2 of docs/playground-native-runner-design.md). A handler
# returns a `Reply`, status and body text, and each entry point puts it on the
# wire its own way, so the two cannot drift apart in what they answer.
#
# Why this module imports nothing from `web`: `web/types` sits on `use java`
# (InputStream), and serve is built natively. Nor does anything below it:
# the heavy part of a request is a `Job` handed to a `Host` (play/host), so the
# in-process Semaphore and the answer cache the long-lived server uses stay in
# play/jvmhost, and the flock gate serve uses is play/gate. Timing is the
# `Clock` effect through play/exec.
use std/bytes
use std/str
use std/io
use std/io.{Instant}
use play/contract.{parse_request, parse_compile_request, wants_tileir, render_outcome, render_check, render_error, render_health}
use play/exec.{CompilerId, tile_ready, tick, ms_since, TileRaw, TileMapped, TilePlain}
use play/view.{build_view, respond, cache_key, Viewed, Mapped, Done, tile_view, tile_mapped, Tiled, TileShown, TileFailed}
use play/host.{Host, JobResult, JRun, JCheck, JView, JTile, JOutcome, JViewRaw, JTileRaw, JBroken}

pub type Reply = { status: Int, body: String }

# Every reply is JSON; the content type is the entry point's to state, so the
# argument stays only to keep the call sites reading like the web framework's `raw`.
fn raw(status: Int, _content_type: String, body: String) -> Reply = Reply { status: status, body: body }

const MAX_BODY: Int = 65536
pub const JSON_CT: String = "application/json; charset=utf-8"
pub const MAX_CONCURRENT: Int = 2
const QUEUE_WAIT_SECS: Int = 15
# Editor diagnostics are advisory: don't queue behind runs, fail fast so the
# client just keeps its previous squiggles and retries on the next pause.
const CHECK_WAIT_SECS: Int = 2
# The compile view is advisory in the same way, and shares the same two
# permits: a second pool for it would double the compilers the host runs at
# once, and nobody would be counting them.
const COMPILE_WAIT_SECS: Int = CHECK_WAIT_SECS
# At most this many answers, and this many characters of them, are kept
# (play/cache.dawn). An answer is kept under one key a target, so a program the
# visitor has looked at in both tabs is two entries.
pub const CACHE_ENTRIES: Int = 128
pub const CACHE_CHARS: Int = 33554432

# JSON since the editor started showing the compiler version; deploy checks
# only look at the status (curl -f).
pub fn health(id: CompilerId) -> Reply =
  raw(200, JSON_CT, render_health(id.version, id.build))

# Shared core of /run and /check: same body parsing and gate, different
# executor and queue patience. The wire format predates the framework, so
# errors are rendered into the contract's own JSON shapes (via raw), not the
# framework's Err branch.
pub fn rpc(body: Bytes, host: Host, check_only: Bool, native: Bool) -> Reply !io =
  # bytes, not code points: str.len counts characters, so a program written in
  # CJK got up to three times the stated budget
  if bytes.len(body) > MAX_BODY {
    raw(413, JSON_CT, render_error("source exceeds ${MAX_BODY} bytes"))
  } else {
    # body_text refuses a malformed body; render the refusal in the contract's
    # own error shape like every other refusal here, not the framework's
    match bytes.decode_utf8_checked(body) {
      Err(e) -> raw(400, JSON_CT, render_error("request body is not valid UTF-8 (offset ${e.offset})"))
      Ok(source) -> match parse_request(source) {
        Err(msg) -> raw(400, JSON_CT, render_error(msg))
        Ok(code) -> {
          let wait = if check_only { CHECK_WAIT_SECS } else { QUEUE_WAIT_SECS }
          # The host holds a permit across the job only and releases it however
          # the job ends, then we render outside the permit. None = saturated.
          match host.call(wait, if check_only { JCheck(code, native) } else { JRun(code) }) {
            Some(JOutcome(outcome)) ->
              raw(200, JSON_CT, if check_only { render_check(outcome) } else { render_outcome(outcome) })
            Some(other) -> failed(other)
            None -> raw(429, JSON_CT, render_error("server busy, try again shortly"))
          }
        }
      }
    }
  }

# A job that came back as something its route did not ask for, or did not come
# back: the runner's own fault, so a 500.
fn failed(r: JobResult) -> Reply =
  match r {
    JBroken(m) -> raw(500, JSON_CT, render_error("internal error: ${m}"))
    _ -> raw(500, JSON_CT, render_error("internal error: the job answered another kind of result"))
  }

# What /compile needs to know of the machine it runs on, asked once at start.
pub type View = { toolchain: String, build: String, javap: Bool, tile: Bool, native: Bool }

# The view's cache lines: "<status>:<kind>:" and then the text. A kind is `S`,
# the program's part of a success answer (the head is written per request), or
# `F`, an answer that is complete as kept.
fn kept_line(status: Int, kind: String, text: String) -> String = "${status}:${kind}:${text}"

fn serve_kept(view: View, target: String, started: Instant, line: String) -> Reply !io =
  match str.split_once(line, ":") {
    None -> raw(500, JSON_CT, render_error("the compile view's cache holds a line it cannot read"))
    Some((status, rest)) -> match str.split_once(rest, ":") {
      None -> raw(500, JSON_CT, render_error("the compile view's cache holds a line it cannot read"))
      Some((kind, text)) ->
        if kind == "S" {
          raw(200, JSON_CT, respond(target, view.build, true, ms_since(started), text))
        } else {
          raw(parse_int(status).unwrap_or(500), JSON_CT, text)
        }
    }
  }

# The refusal when the machine cannot make the view at all: the JVM listing is
# `javap`'s, which only a JDK has, and the call table needs that listing for
# either target. A clear 503 rather than a request that fails inside a
# sandbox unit; deploys refuse to ship without it (deploy/redeploy.sh), so
# seeing this means a machine that was set up by hand.
pub fn unavailable(view: View) -> Option[Reply] =
  if view.javap {
    None
  } else {
    Some(raw(503, JSON_CT, render_error("the compile view is unavailable: this server has no javap (it needs a JDK, not only a JRE)")))
  }

# POST /compile: the program's C text or JVM listing, paired with the source
# (packages/xmap). Same body limit, same JSON refusals and same gate as /check;
# the work is play/exec.view_raw's and the answer is play/view.dawn's.
pub fn compile_rpc(body: Bytes, host: Host, view: View) -> Reply !io =
  if bytes.len(body) > MAX_BODY {
    raw(413, JSON_CT, render_error("source exceeds ${MAX_BODY} bytes"))
  } else {
    match bytes.decode_utf8_checked(body) {
      Err(e) -> raw(400, JSON_CT, render_error("request body is not valid UTF-8 (offset ${e.offset})"))
      Ok(source) -> match parse_compile_request(source) {
        Err(msg) -> raw(400, JSON_CT, render_error(msg))
        Ok((code, target)) ->
          if target == "tile" {
            tile_ir(host, view, code)
          } else {
            match unavailable(view) {
              Some(refusal) -> refusal
              None -> compile_view(host, view, code, target)
            }
          }
      }
    }
  }

# target "tile": the program's output, which is its Tile IR (play/exec.dawn,
# the Tile IR view). The program must import tileir, which the page also
# checks and the server checks again; it runs under /run's limits and one of
# the same two permits, with /check's patience, because the pane is advisory.
fn tile_ir(host: Host, view: View, code: String) -> Reply !io =
  if not wants_tileir(code) {
    raw(400, JSON_CT, render_error("the Tile IR view needs a program that imports tileir (add a line such as `use tileir/dev.{Dev}`)"))
  } else if not view.tile {
    raw(503, JSON_CT, render_error("the Tile IR view is unavailable: this server has no packages/tileir"))
  } else {
    let started = tick()
    let key = "${cache_key(view.toolchain, code)}/tile"
    match host.keep_get(key) {
      Some(line) -> serve_kept(view, "tile", started, line)
      None ->
        match host.call(COMPILE_WAIT_SECS, JTile(code)) {
          None -> raw(429, JSON_CT, render_error("server busy, try again shortly"))
          Some(JTileRaw(made)) -> match tiled(code, made) {
            TileFailed(status, body) -> raw(status, JSON_CT, body)
            TileShown(rest) -> {
              host.keep_put(key, kept_line(200, "S", rest))
              raw(200, JSON_CT, respond("tile", view.build, false, ms_since(started), rest))
            }
          }
          Some(other) -> failed(other)
        }
    }
  }

# The Tile IR view's answer from what the job came to: the kernel's pairing as
# a view of its own, or the program's output as the pane.
fn tiled(code: String, raw: TileRaw) -> Tiled =
  match raw {
    TileMapped(map, golden, _ms) -> tile_mapped(code, map, golden)
    TilePlain(outcome, why) -> tile_view(outcome, why)
  }

fn compile_view(host: Host, view: View, code: String, target: String) -> Reply !io = {
  let started = tick()
  let base = cache_key(view.toolchain, code)
  match host.keep_get("${base}/${target}") {
    Some(line) -> serve_kept(view, target, started, line)
    None ->
      match host.call(COMPILE_WAIT_SECS, JView(code, view.native)) {
        None -> raw(429, JSON_CT, render_error("server busy, try again shortly"))
        Some(JViewRaw(parts)) -> mapped(host, view, code, target, base, started, build_view(code, parts))
        Some(other) -> failed(other)
      }
  }
}

# The view's answer once the raw material is paired (packages/xmap) and cut:
# here, outside the permit, which the job has already given back.
fn mapped(host: Host, view: View, code: String, target: String, base: String, started: Instant, built: Viewed) -> Reply !io =
  match built {
    Mapped(c, jvm, gaps) -> {
      if gaps > 0 {
        io.eprintln("compile view: ${gaps} gap(s) in program ${str.take(base, 12)}")
      }
      host.keep_put("${base}/c", kept_line(200, "S", c))
      host.keep_put("${base}/jvm", kept_line(200, "S", jvm))
      raw(200, JSON_CT, respond(target, view.build, false, ms_since(started), if target == "c" { c } else { jvm }))
    }
    Done(status, body, keep) -> {
      if keep {
        host.keep_put("${base}/c", kept_line(status, "F", body))
        host.keep_put("${base}/jvm", kept_line(status, "F", body))
      }
      raw(status, JSON_CT, body)
    }
  }

## What /compile needs to know of the machine, asked of the toolchain. The
## long-lived server asks once at start; serve asks per request, since its
## process is the request (K3 bakes these in or keeps them in a file).
pub fn view_of(id: CompilerId, native: Bool, javap: String) -> View !io =
  View {
    toolchain: "${id.version} ${id.build} ${javap}",
    build: id.build,
    javap: javap != "",
    tile: tile_ready(),
    native: native,
  }

test "without javap the view is refused with a 503 that says why" {
  let view = View { toolchain: "", build: "", javap: false, tile: false, native: false }
  match unavailable(view) {
    Some(r) -> {
      assert r.status == 503
      assert str.contains(r.body, "javap")
    }
    None -> { assert false }
  }
  let with_javap = View { toolchain: "", build: "", javap: true, tile: false, native: false }
  assert match unavailable(with_javap) { Some(_) -> false, None -> true }
}

# site/build/stdlib.json (from `dawn doc --stdlib`) -> stdlib.html.
#
# The standard library as a caller meets it: the names visible with no `use`,
# the traits the prelude brings, then one section per std module with its
# functions, its types and the impls it registers. Where a name is implemented
# — the compiler's builtin table or bundled Dawn source — is not a heading
# here, because it is not something a caller can observe (spec §11). What is a
# heading is how the name is *written*, which is the difference that matters.
#
# Two parsers are in scope and they are not the same one: `parse` reads the
# JSON the compiler emitted, and `parser.parse` (md/parser) reads Markdown —
# the intro page, and every doc comment, which are Markdown prose and were
# rendered as flat escaped text for as long as this page was a table.

use std/str
use std/map
use std/set
use std/io
use std/io.{Fs}
use json/parser.{parse}
use json/value.{Json, JNull, JBool, JStr, JArr, JObj, error_text}
use md/parser
use html/escape.{escape_html}
use html/page.{Assets, Lang, En, Zh, PageHead, page_with_toc, toc_rail, section_crumb, chip, twin_chip}
use html/render.{render_doc, split_head, inline_run, inline_text, TocEntry}
use md/ast.{Para}
use hl/dawn.{highlight_dawn}
use gen/common.{must_read, write_page, map_doc_url, doc_files}

# ---- the page's own words ----
#
# Everything on this page except these ten strings and site/pages/stdlib.md
# is generated from `dawn doc --stdlib`, so the two of them together are the
# whole of what a translator has to touch. The strings live in one record
# rather than as literals down in the code that emits them: a table has the
# property the literals did not, which is that the two languages sit on
# adjacent lines and a missing one is a compile error instead of a page that
# renders half in each.
#
# The entries themselves are NOT translated and are not meant to be: a doc
# comment on a std function is English on both pages, because it is the
# compiler's own text and this repository's code is English throughout.

type Chrome = {
  impls_lead: String,
  impls_sep: String,
  prelude_title: String,
  prelude_intro: String,
  traits_title: String,
  traits_intro: String,
  modules_title: String,
  modules_intro: String,
  refs_pre: String,
  refs_post: String,
}

fn chrome(lang: Lang, root: String) -> Chrome =
  match lang {
    En -> Chrome {
      impls_lead: "impls registered by this module (visible program-wide, no use needed): ",
      impls_sep: ", ",
      prelude_title: "prelude: the names that need no use",
      prelude_intro: "<p>These names are in scope implicitly — just write them. " ++
        "The groups are there to make things findable and say nothing about where " ++
        "a name is implemented; the ones that also live in a std module " ++
        "(<code>sort</code>, <code>println</code> and so on) appear once more under " ++
        "Modules below in their qualified spelling — the same function, two ways of " ++
        "writing it.</p>\n",
      traits_title: "Prelude traits",
      traits_intro: "<p>The five traits the prelude brings. Their method names " ++
        "enter the function namespace as well, and a top-level declaration in the " ++
        """calling module shadows them (<a href="${root}/spec.html#s10-6">spec §10.6</a>).""" ++
        "</p>\n",
      modules_title: "Modules",
      modules_intro: "<p>Brought in with <code>use std/x</code> and then called " ++
        "qualified; single names can be imported on their own " ++
        "(<code>use std/str.{trim}</code>).</p>\n",
      refs_pre: "Reference kernels: ",
      refs_post: " host-side answers the GPU backend's tests compare against",
    }
    Zh -> Chrome {
      impls_lead: "本模块登记的 impl（全程序可见，不必 use）：",
      impls_sep: "、",
      prelude_title: "prelude：不必 use 的名字",
      prelude_intro: "<p>下面这些名字隐式可见，直接写就是了。分组只为好找，不代表实现位置；" ++
        "其中在 std 模块里也有一份的（<code>sort</code>、<code>println</code> 等）" ++
        "会在下面「模块」一节里以限定拼写再出现一次。同一个函数，两种写法。</p>\n",
      traits_title: "预置 trait",
      traits_intro: "<p>随 prelude 而来的五个 trait。它们的方法名同样进入函数命名空间，" ++
        """可被本模块的顶层声明遮蔽（<a href="${root}/zh/spec.html#s10-6">规范 §10.6</a>）。</p>""" ++
        "\n",
      modules_title: "模块",
      modules_intro: "<p>以 <code>use std/x</code> 引入，再限定调用；" ++
        "也可以选择性引入单个名字（<code>use std/str.{trim}</code>）。</p>\n",
      refs_pre: "参考 kernel：",
      refs_post: " 个宿主端参考答案，供 GPU 后端的测试对照",
    }
  }

# ---- reading the compiler's JSON ----

fn jget(j: Json, key: String) -> Json =
  match j {
    JObj(entries) -> unwrap_or(map.get(entries, key), JNull)
    _ -> JNull
  }

fn jstr(j: Json) -> String =
  match j {
    JStr(s) -> s
    _ -> ""
  }

fn jbool(j: Json) -> Bool =
  match j {
    JBool(b) -> b
    _ -> false
  }

fn jarr(j: Json) -> List[Json] =
  match j {
    JArr(items) -> items
    _ -> []
  }

fn field(j: Json, key: String) -> String = jstr(jget(j, key))

# ---- pieces of the page ----

## A module path as an HTML id fragment: `std/str` -> `std-str`.
fn slug(path: String) -> String = str.replace(path, "/", "-")

## A doc comment, rendered as the Markdown it is. Multi-line prose used to be
## escaped whole and flattened into one table cell; paragraphs, bullets and
## `code` spans all survive this way.
##
## An unparsable doc comment is a hard error, like every other Markdown this
## generator reads: the site build is the lint.
fn prose(pg: Pg, text: String, links: List[Json]) -> String =
  if str.trim(text) == "" {
    ""
  } else {
    match parser.parse(text) {
      Ok(bs) -> linked(pg, render_doc(bs, u => map_doc_url(".", pg.docs, u)).html, links)
      Err(e) -> panic("a doc comment is not Markdown: ${e}\n---\n${text}")
    }
  }

## The prose of an object `dawn doc` wrote: its `doc` and its `links`.
fn doc_prose(pg: Pg, j: Json) -> String = prose(pg, field(j, "doc"), jarr(jget(j, "links")))

## What rendering any doc on the page needs: the `docs/` files a doc may link
## to, and every anchor the page carries, which a `[`name`]` link lands on.
type Pg = { docs: List[String], anchors: Set[String] }

fn pg_of(docs: List[String], api: Json) -> Pg =
  Pg { docs: docs, anchors: set.from(map(api_rows(api), r => r.anchor)) }

# ---- doc links (spec §1.2) ----
#
# `dawn doc` has already resolved every `[`name`]` in a doc, and refused to
# answer over one that resolves to nothing; what is left here is where on this
# page each target is. The Markdown renderer does not know the spelling -- to
# it `[`x`]` is a bracket, a code span and a bracket -- so the rendered
# `[<code>x</code>]` is rewritten afterwards. A link-shaped text inside a
# fenced example renders inside `<pre>` with its backticks and is left alone.

## The id on this page a link's target is anchored at, by the same rules
## [api_rows] uses: a member (constructor, field, method, operation, associated
## member) lands on its owner's entry. None for a prelude name the page has no
## entry for: a builtin type, or `Option` and its constructors.
fn link_anchor(t: Json) -> Option[String] = {
  let module = field(t, "module")
  let name = field(t, "name")
  let kind = field(t, "kind")
  let owner = str.split(name, ".")[0]
  if module == "" {
    return match kind {
      "fn" -> Some("p-${name}")
      "trait" -> Some("prelude-trait-${name}")
      "method" -> Some("prelude-trait-${owner}")
      "assoc" -> Some("prelude-trait-${owner}")
      _ -> None
    }
  }
  let base = slug(module)
  match kind {
    "module" -> Some("m-${base}")
    "type" -> Some("${base}-type-${name}")
    "ctor" -> Some("${base}-type-${owner}")
    "field" -> Some("${base}-type-${owner}")
    "trait" -> Some("${base}-trait-${name}")
    "method" -> Some("${base}-trait-${owner}")
    "assoc" -> Some("${base}-trait-${owner}")
    "effect" -> Some("${base}-effect-${name}")
    "op" -> Some("${base}-effect-${owner}")
    _ -> Some("${base}-${name}")
  }
}

## `html` with each of `links` turned into a link to its entry. A target whose
## anchor this page does not carry is a std doc pointing at something the
## reference leaves out (a private helper, an internal module), which is a
## broken link on the page as surely as a misspelled one, so the build stops.
## A prelude name with no entry at all keeps its code span and loses the
## brackets.
fn linked(pg: Pg, html: String, links: List[Json]) -> String = {
  var out = html
  for l in links {
    let text = field(l, "text")
    let code = "<code>" ++ escape_html(text) ++ "</code>"
    let to = match link_anchor(jget(l, "target")) {
      Some(a) ->
        if set.has(pg.anchors, a) {
          """<a href="#${a}">""" ++ code ++ "</a>"
        } else {
          panic("a doc links [`${text}`] to #${a}, which the standard library page does not carry")
        }
      None -> code
    }
    out = str.replace(out, "[" ++ code ++ "]", to)
  }
  out
}

## A doc's text with its links' brackets taken off, for a reader that does
## not render Markdown links (the search index's one-line note).
fn unlinked(j: Json) -> String = {
  var text = field(j, "doc")
  for l in jarr(jget(j, "links")) {
    let t = field(l, "text")
    text = str.replace(text, "[`${t}`]", "`${t}`")
  }
  text
}

## One documented entry: its qualified spelling as the anchor, the declaration
## exactly as the compiler renders it, then the prose, then its members' docs.
fn entry(
  pg: Pg,
  title: String,
  id: String,
  sig: String,
  doc: Json,
  members: List[(String, Json)]
) -> String =
  """<div class="api-item" id="${id}">""" ++ "\n" ++
  """<h3 class="api-name"><a href="#${id}">""" ++ escape_html(title) ++ "</a></h3>\n" ++
  """<pre class="dawn api-sig"><code>""" ++ highlight_dawn(sig) ++ "</code></pre>\n" ++
  """<div class="api-doc">""" ++ "\n" ++ doc_prose(pg, doc) ++ "</div>\n" ++
  members_html(pg, members) ++ "</div>"

## The members of an entry that have a doc of their own, each under its
## declaration as the entry's signature spells it: `(label, member)` pairs
## from [member_docs], the member being the object `dawn doc` wrote for it. A
## member without one is already in the signature above and gets no row, so
## an entry with no member docs renders what it always did.
fn members_html(pg: Pg, members: List[(String, Json)]) -> String =
  if len(members) == 0 {
    ""
  } else {
    var rows: List[String] = []
    for pr in members {
      let (label, m) = pr
      rows = rows ++ ["<dt><code>" ++ highlight_dawn(label) ++ "</code></dt>\n<dd>\n"
          ++ doc_prose(pg, m) ++ "</dd>\n"]
    }
    """<dl class="api-members">""" ++ "\n" ++ join(rows, "") ++ "</dl>\n"
  }

## The member rows worth a line: those with a doc of their own. A member on
## its owner's line has none (spec §1.2), so `dawn doc` writes null for it and
## nothing here has to tell a member's doc from its type's.
fn member_docs(members: List[(String, Json)]) -> List[(String, Json)] =
  filter(members, pr => {
    let (_, m) = pr
    str.trim(field(m, "doc")) != ""
  })

fn qualify(qual: String, name: String) -> String = if qual == "" { name } else { "${qual}.${name}" }

fn fn_entry(pg: Pg, qual: String, id_base: String, f: Json) -> String =
  entry(pg, qualify(qual, field(f, "name")), id_base ++ "-" ++ field(f, "name"),
    field(f, "sig"), f, [])

fn ctor_decl(c: Json) -> String = {
  let fs = map(jarr(jget(c, "fields")), f => field(f, "name") ++ ": " ++ field(f, "type"))
  if len(fs) == 0 { field(c, "name") } else { field(c, "name") ++ "(" ++ join(fs, ", ") ++ ")" }
}

fn record_decl(head: String, c: Json) -> String = {
  let fs = map(jarr(jget(c, "fields")), f => field(f, "name") ++ ": " ++ field(f, "type"))
  "type ${head} = { " ++ join(fs, ", ") ++ " }"
}

## The declaration, reassembled from what the compiler reported. A type with no
## constructors keeps its representation to itself — `pub opaque type Cursor`
## is the whole point of `Cursor` — and that absence is the documentation.
fn type_decl(t: Json) -> String = {
  let ps = map(jarr(jget(t, "typeParams")), p => jstr(p))
  let name = field(t, "name")
  let head = if len(ps) == 0 { name } else { name ++ "[" ++ join(ps, ", ") ++ "]" }
  let ctors = jarr(jget(t, "ctors"))
  match get(ctors, 0) {
    None -> "type ${head}"
    Some(first) ->
      if jbool(jget(t, "record")) {
        record_decl(head, first)
      } else {
        "type ${head} = " ++ join(map(ctors, c => ctor_decl(c)), " | ")
      }
  }
}

## `-type-` in the anchor, not just the name: `std/bytes` has both a `Buf`
## type and a `buf()` function, and ids that differ only in case are one
## careless lowercase away from colliding.
fn type_entry(pg: Pg, id_base: String, t: Json) -> String =
  entry(pg, field(t, "name"), id_base ++ "-type-" ++ field(t, "name"), type_decl(t), t,
    type_members(t))

## A type's constructor and field docs, in declaration order. A record's
## fields are spelled as the record spells them, a variant's as `Ctor.field`.
## A record's one constructor never has a doc: it starts on the `type` line.
fn type_members(t: Json) -> List[(String, Json)] = {
  let record = jbool(jget(t, "record"))
  var out: List[(String, Json)] = []
  for c in jarr(jget(t, "ctors")) {
    out = out ++ member_docs([(ctor_decl(c), c)])
    for f in jarr(jget(c, "fields")) {
      let fname = if record { field(f, "name") } else { field(c, "name") ++ "." ++ field(f, "name") }
      out = out ++ member_docs([(fname ++ ": " ++ field(f, "type"), f)])
    }
  }
  out
}

fn const_entry(pg: Pg, qual: String, id_base: String, c: Json) -> String = {
  let name = field(c, "name")
  entry(pg, qualify(qual, name), "${id_base}-${name}", "const ${name}: " ++ field(c, "type"), c, [])
}

fn trait_entry(pg: Pg, id_base: String, t: Json) -> String = {
  let name = field(t, "name")
  let tp = field(t, "typeParam")
  var body = ""
  for a in jarr(jget(t, "assoc")) {
    body = body ++ "\n  type " ++ jstr(a)
  }
  for m in jarr(jget(t, "methods")) {
    body = body ++ "\n  " ++ field(m, "sig")
  }
  let methods = map(jarr(jget(t, "methods")), m => (field(m, "sig"), m))
  entry(pg, name, "${id_base}-trait-${name}", "trait ${name}[${tp}] {${body}\n}", t,
    member_docs(methods))
}

## Dead for every std module today — nothing there declares a `pub effect` yet
## — and here so that the day one appears it lands on the page instead of
## silently missing, which is the same reason `doc` emits the empty array.
fn effect_entry(pg: Pg, id_base: String, e: Json) -> String = {
  let name = field(e, "name")
  var body = ""
  for op in jarr(jget(e, "ops")) {
    body = body ++ "\n  " ++ field(op, "sig")
  }
  let ops = map(jarr(jget(e, "ops")), op => (field(op, "sig"), op))
  entry(pg, name, "${id_base}-effect-${name}", "effect ${name} {${body}\n}", e, member_docs(ops))
}

## The impls a module registers. Coherence is program-wide — it does not ask
## who wrote the `use` — so a reader needs to see that `==` on a `Map` is
## answered here even though no function in the list says so.
fn impls_html(c: Chrome, m: Json) -> String = {
  let names = map(jarr(jget(m, "impls")), i => "<code>" ++ escape_html(jstr(i)) ++ "</code>")
  if len(names) == 0 {
    ""
  } else {
    """<p class="api-impls">""" ++ c.impls_lead ++ join(names, c.impls_sep) ++ "</p>\n"
  }
}

fn section(id: String, title: String, intro: String, body: String) -> String =
  """<h2 id="${id}">""" ++ escape_html(title)
  ++ """<a class="anchor" href="#${id}" aria-hidden="true" tabindex="-1">#</a></h2>""" ++ "\n" ++ intro
  ++ body

fn sub(id: String, title: String) -> String =
  """<h3 class="api-group" id="${id}">""" ++ escape_html(title) ++ "</h3>\n"

# ---- the three generated sections ----

fn prelude_html(pg: Pg, root: Json) -> (String, List[TocEntry]) = {
  var html: List[String] = []
  var toc: List[TocEntry] = []
  for g in jarr(jget(root, "groups")) {
    let name = field(g, "name")
    let gid = "g-${name}"
    toc = toc ++ [TocEntry { level: 3, id: gid, text: name }]
    html = html ++ [sub(gid, name)]
    for f in jarr(jget(g, "fns")) {
      html = html ++ [fn_entry(pg, "", "p", f) ++ "\n"]
    }
  }
  (join(html, ""), toc)
}

fn traits_html(pg: Pg, root: Json) -> String = {
  var html: List[String] = []
  for t in jarr(jget(root, "traits")) {
    html = html ++ [trait_entry(pg, "prelude", t) ++ "\n"]
  }
  join(html, "")
}

## The modules in the order the page shows them: alphabetical by path, with
## `std/prelude` first should there ever be one.
##
## `dawn doc --stdlib` lists them in std/modules.txt's order, which is the
## order they have to be compiled in (cursor, str, char, fmt, ...). That is a
## fact about the compiler and means nothing to a reader looking for `std/io`.
## One function for the page and for [api_rows], so the search index walks the
## entries in the order the page shows them.
fn modules_in_order(api: Json) -> List[Json] =
  sort_by(jarr(jget(api, "modules")), (a, b) => cmp(module_key(a), module_key(b)))

fn module_key(m: Json) -> String = {
  let path = field(m, "path")
  if path == "std/prelude" { "" } else { path }
}

## Whether a function is one of a module's reference kernels: the host-side
## answer a GPU kernel's test compares against, named `<kernel>_ref`.
##
## std/gpu has 149 of them beside 72 functions a caller uses, and listed
## inline they were more than half of this page. Whether they belong to the
## module's public surface at all is a question about std, not about this
## page, and is open; until it is answered the page keeps every one of them,
## anchored and searchable, inside a group that starts closed. Only std/gpu is
## read this way: `_ref` is that module's naming convention, not a rule a
## suffix can be trusted with anywhere else.
fn is_reference_kernel(path: String, name: String) -> Bool =
  path == "std/gpu" && str.ends_with(name, "_ref")

## The functions a caller uses, then the reference kernels, as [modules_html]
## lays them out.
fn fns_in_order(path: String, m: Json) -> (List[Json], List[Json]) = {
  let fns = jarr(jget(m, "fns"))
  (filter(fns, f => not is_reference_kernel(path, field(f, "name"))),
    filter(fns, f => is_reference_kernel(path, field(f, "name"))))
}

fn modules_html(c: Chrome, pg: Pg, root: Json) -> (String, List[TocEntry]) = {
  var html: List[String] = []
  var toc: List[TocEntry] = []
  for m in modules_in_order(root) {
    let path = field(m, "path")
    let id = "m-" ++ slug(path)
    # the call-site alias is the file's own name: `use std/str` binds `str`
    let qual = unwrap_or(str.strip_prefix(path, "std/"), path)
    toc = toc ++ [TocEntry { level: 3, id: id, text: path }]
    html = html ++ [sub(id, path) ++ doc_prose(pg, m) ++ impls_html(c, m)]
    for t in jarr(jget(m, "types")) {
      html = html ++ [type_entry(pg, slug(path), t) ++ "\n"]
    }
    for t in jarr(jget(m, "traits")) {
      html = html ++ [trait_entry(pg, slug(path), t) ++ "\n"]
    }
    for c in jarr(jget(m, "consts")) {
      html = html ++ [const_entry(pg, qual, slug(path), c) ++ "\n"]
    }
    for e in jarr(jget(m, "effects")) {
      html = html ++ [effect_entry(pg, slug(path), e) ++ "\n"]
    }
    let (used, refs) = fns_in_order(path, m)
    for f in used {
      html = html ++ [fn_entry(pg, qual, slug(path), f) ++ "\n"]
    }
    if len(refs) > 0 {
      # Closed, and opened by site/assets/search.js when a search result or
      # a link lands on an entry inside it.
      html = html ++ [`<details class="api-refs">` ++ "\n<summary>" ++ c.refs_pre
          ++ "${len(refs)}" ++ c.refs_post ++ "</summary>\n"]
      for f in refs {
        html = html ++ [fn_entry(pg, qual, slug(path), f) ++ "\n"]
      }
      html = html ++ ["</details>\n"]
    }
  }
  (join(html, ""), toc)
}

# ---- the same entries, as an index ----
#
# The search index (gen/search.dawn) needs the name, the declaration, the
# first line of the documentation and the ANCHOR of every entry on this page.
# The anchor is the part that cannot live anywhere else: an id here is built
# out of a module slug, a kind word and a name, in five spellings that differ
# from each other by one segment, and a second copy of those rules in another
# file would be a copy that goes wrong silently -- the link would resolve to
# nothing and only a reader would find out.
#
# So the enumeration is here, next to the functions that emit the ids, and the
# test at the bottom of this file holds the two to each other: every anchor
# this hands out has to be an id the page really carries, and the counts have
# to agree so that an entry kind added to the page and not to this is a
# failure rather than a silent omission.

## One entry of the standard library page, as an index needs it.
pub type ApiRow = { title: String, decl: String, doc: String, anchor: String }

fn api_row(title: String, decl: String, doc: String, anchor: String) -> ApiRow =
  ApiRow { title: title, decl: decl, doc: doc, anchor: anchor }

## Every entry on the standard library page, in the order the page shows them.
##
## The module and group HEADINGS are here too, as rows whose declaration is
## the heading's own kind: `std/str` is a thing a reader searches for, and the
## page anchors it at `m-std-str`.
pub fn api_rows(api: Json) -> List[ApiRow] = {
  var rows: List[ApiRow] = []
  for g in jarr(jget(api, "groups")) {
    let name = field(g, "name")
    rows = rows ++ [api_row(name, "prelude group", "", "g-${name}")]
    for f in jarr(jget(g, "fns")) {
      rows = rows ++ [api_row(field(f, "name"), field(f, "sig"), unlinked(f),
        "p-" ++ field(f, "name"))]
    }
  }
  for t in jarr(jget(api, "traits")) {
    rows = rows ++ [trait_row("prelude", t)]
  }
  for m in modules_in_order(api) {
    let path = field(m, "path")
    let base = slug(path)
    let qual = unwrap_or(str.strip_prefix(path, "std/"), path)
    rows = rows ++ [api_row(path, "module", unlinked(m), "m-${base}")]
    for t in jarr(jget(m, "types")) {
      rows = rows
        ++ [api_row(field(t, "name"), type_decl(t), unlinked(t),
          "${base}-type-" ++ field(t, "name"))]
    }
    for t in jarr(jget(m, "traits")) {
      rows = rows ++ [trait_row(base, t)]
    }
    for c in jarr(jget(m, "consts")) {
      let name = field(c, "name")
      rows = rows
        ++ [api_row(qualify(qual, name), "const ${name}: " ++ field(c, "type"), unlinked(c),
          "${base}-${name}")]
    }
    for e in jarr(jget(m, "effects")) {
      rows = rows
        ++ [api_row(field(e, "name"), "effect " ++ field(e, "name"), unlinked(e),
          "${base}-effect-" ++ field(e, "name"))]
    }
    let (used, refs) = fns_in_order(path, m)
    for f in used ++ refs {
      let name = field(f, "name")
      rows = rows
        ++ [api_row(qualify(qual, name), field(f, "sig"), unlinked(f), "${base}-${name}")]
    }
  }
  rows
}

fn trait_row(base: String, t: Json) -> ApiRow = {
  let name = field(t, "name")
  api_row(name, "trait ${name}[" ++ field(t, "typeParam") ++ "]", unlinked(t),
    "${base}-trait-${name}")
}

# ---- the page ----

## Which file this language's intro is written in, where the page goes, and how
## far it is from the site root. English is the original and takes the default
## layout; the translation sits under `/zh/`, like every other paired page.
fn stdlib_source(out: String, lang: Lang) -> (String, String, String) =
  match lang {
    En -> ("site/pages/stdlib.md", "${out}/stdlib.html", ".")
    Zh -> ("site/pages/stdlib.zh.md", "${out}/zh/stdlib.html", "..")
  }

## The standard library reference. `lang` picks the intro document, the chrome
## and the output path; the entries between them are the same in both runs,
## because they come from the compiler and its doc comments are English.
pub fn gen_stdlib(out: String, a: Assets, lang: Lang) -> Unit !Fs !io = {
  let (src, dst, root) = stdlib_source(out, lang)
  let c = chrome(lang, root)
  let text =
    match io.read_file("site/build/stdlib.json") {
      Ok(t) -> t
      Err(_) ->
        panic("site/build/stdlib.json missing — run site/build.sh (it runs dawn doc --stdlib)")
    }
  # `api`, not `root`: `root` is this page's distance from the site root, which
  # the two runs disagree about and every relative link on the page needs.
  let api =
    match parse(text) {
      Ok(v) -> v
      Err(e) -> panic("stdlib.json: " ++ error_text(e))
    }
  let docs = doc_files()
  let pg = pg_of(docs, api)
  let mu = (u: String) => map_doc_url(root, docs, u)
  # The title and the opening paragraph go into the band above the page; the
  # rest of the intro opens the article.
  let parts =
    match parser.parse(must_read(src)) {
      Ok(bs) -> split_head(bs)
      Err(e) -> panic("${src}: ${e}")
    }
  let (lede, rest) =
    match parts.body {
      [Para(items), ..] -> (inline_run(items, mu), map(range(1, len(parts.body)), i => parts.body[i]))
      _ -> ("", parts.body)
    }
  let intro = render_doc(rest, mu)
  let (pre, pre_toc) = prelude_html(pg, api)
  let (mods, mod_toc) = modules_html(c, pg, api)
  let body = intro.html ++
    section("prelude", c.prelude_title, c.prelude_intro, pre) ++
    section("prelude-traits", c.traits_title, c.traits_intro, traits_html(pg, api)) ++
    section("modules", c.modules_title, c.modules_intro, mods)
  let toc = intro.toc ++
    [TocEntry { level: 2, id: "prelude", text: c.prelude_title }] ++ pre_toc ++
    [TocEntry { level: 2, id: "prelude-traits", text: c.traits_title }] ++
    [TocEntry { level: 2, id: "modules", text: c.modules_title }] ++ mod_toc
  let mods_n = len(modules_in_order(api))
  let facts =
    match lang {
      En -> [chip("generated by <code>dawn doc --stdlib</code>"), chip("${mods_n} modules")]
      Zh -> [chip("由 <code>dawn doc --stdlib</code> 生成"), chip("${mods_n} 个模块")]
    }
  let head = PageHead {
    crumbs: [section_crumb(lang, root, "stdlib", false)],
    title: inline_run(parts.title, mu),
    lede: lede,
    meta: facts ++ [twin_chip(parts.twin, mu)],
    extra: "",
    cls: "toc-aligned",
  }
  write_page(dst,
    page_with_toc(a, lang, "stdlib.html", "${inline_text(parts.title)} — Dawn", root, "stdlib", head,
      toc_rail(lang, toc), body))
}

fn jobj(entries: List[(String, Json)]) -> Json = JObj(map.from(entries))

fn no_pg() -> Pg = Pg { docs: [], anchors: set.empty() }

fn plain_prose(text: String) -> String = prose(no_pg(), text, [])

fn member_labels(ms: List[(String, Json)]) -> List[(String, String)] =
  map(ms, pr => {
    let (label, m) = pr
    (label, field(m, "doc"))
  })

test "each language's intro reads its own file and lands in its own place" {
  assert stdlib_source("d", En) == ("site/pages/stdlib.md", "d/stdlib.html", ".")
  assert stdlib_source("d", Zh) == ("site/pages/stdlib.zh.md", "d/zh/stdlib.html", "..")
}

## The chrome's one link is written from the page, so it moves with the page --
## and, since the spec was translated, it also points at the spec in the
## page's own language. A constant `spec.html` was right for as long as this
## page only ever sat at the site root, and would 404 from `/zh/` the day the
## twin appeared.
test "the chrome's spec link is relative to the page that carries it" {
  assert str.contains(chrome(En, ".").traits_intro, `href="./spec.html#s10-6"`)
  assert str.contains(chrome(Zh, "..").traits_intro, `href="../zh/spec.html#s10-6"`)
}

test "module paths become id fragments and call-site aliases" {
  assert slug("std/str") == "std-str"
  assert qualify("str", "trim") == "str.trim"
  # the prelude's names have no module to qualify them with
  assert qualify("", "println") == "println"
}

test "a type with no constructors keeps its representation to itself" {
  let opaque = jobj([("name", JStr("Cursor")), ("record", JBool(false)),
    ("typeParams", JArr([])), ("ctors", JArr([]))])
  assert type_decl(opaque) == "type Cursor"
}

test "records and sums reassemble into their declarations" {
  let field_of = (n: String, t: String) =>
    jobj([("name", JStr(n)), ("type", JStr(t))])
  let rec = jobj([("name", JStr("Pair")), ("record", JBool(true)),
    ("typeParams", JArr([JStr("A"), JStr("B")])),
    ("ctors", JArr([jobj([("name", JStr("Pair")),
      ("fields", JArr([field_of("a", "A"), field_of("b", "B")]))])]))])
  assert type_decl(rec) == "type Pair[A, B] = { a: A, b: B }"

  let sum = jobj([("name", JStr("Shape")), ("record", JBool(false)),
    ("typeParams", JArr([])),
    ("ctors", JArr([
      jobj([("name", JStr("Circle")), ("fields", JArr([field_of("r", "Float")]))]),
      jobj([("name", JStr("Dot")), ("fields", JArr([]))])
    ]))])
  assert type_decl(sum) == "type Shape = Circle(r: Float) | Dot"
}

test "member docs render under their declarations, and a member without one gets no row" {
  let fld = (n: String, t: String, d: Json) =>
    jobj([("name", JStr(n)), ("type", JStr(t)), ("doc", d)])
  let sum = jobj([("name", JStr("Shape")), ("record", JBool(false)),
    ("typeParams", JArr([])), ("doc", JStr("A shape.")),
    ("ctors", JArr([
      jobj([("name", JStr("Circle")), ("doc", JStr("A *round* one.")),
        ("fields", JArr([fld("r", "Float", JStr("The radius."))]))]),
      jobj([("name", JStr("Dot")), ("doc", JNull), ("fields", JArr([]))])
    ]))])
  assert member_labels(type_members(sum)) == [("Circle(r: Float)", "A *round* one."), ("Circle.r: Float", "The radius.")]
  let html = type_entry(no_pg(), "std-x", sum)
  assert str.contains(html, `<dl class="api-members">`)
  assert str.contains(html, "<dd>\n<p>A <em>round</em> one.</p>\n</dd>")
  assert len(str.split(html, "<dt>")) == 3

  # a record: fields spelled bare, an undocumented one left out
  let rec = jobj([("name", JStr("P")), ("record", JBool(true)),
    ("typeParams", JArr([])), ("doc", JStr("A pair.")),
    ("ctors", JArr([jobj([("name", JStr("P")), ("doc", JNull),
      ("fields", JArr([fld("a", "Int", JNull), fld("b", "Int", JStr("The second."))]))])]))])
  assert member_labels(type_members(rec)) == [("b: Int", "The second.")]
  # none documented: the entry it always was
  let bare = jobj([("name", JStr("Q")), ("record", JBool(true)),
    ("typeParams", JArr([])), ("doc", JStr("A one.")),
    ("ctors", JArr([jobj([("name", JStr("Q")), ("doc", JNull),
      ("fields", JArr([fld("a", "Int", JNull)]))])]))])
  assert not str.contains(type_entry(no_pg(), "std-x", bare), "api-members")

  # a trait's methods; none documented is the entry it always was
  let meth = (sig: String, d: Json) => jobj([("name", JStr("m")), ("sig", JStr(sig)), ("doc", d)])
  let tr = (ms: List[Json]) => jobj([("name", JStr("Tr")), ("typeParam", JStr("T")),
    ("assoc", JArr([])), ("methods", JArr(ms)), ("doc", JStr("A trait."))])
  let with_doc = trait_entry(no_pg(), "std-x", tr([meth("fn m(t: T) -> Int", JStr("Measures `t`.")),
    meth("fn n(t: T) -> Int", JNull)]))
  assert str.contains(with_doc, "<dd>\n<p>Measures <code>t</code>.</p>\n</dd>")
  assert len(str.split(with_doc, "<dt>")) == 2
  let without = trait_entry(no_pg(), "std-x", tr([meth("fn n(t: T) -> Int", JNull)]))
  assert not str.contains(without, "api-members")
  assert str.ends_with(without, "</div>\n</div>")
}

test "a doc comment is rendered as Markdown, not escaped whole" {
  let html = plain_prose("First line, `code` and *em*.\n\nA second paragraph.")
  assert str.contains(html, "<code>code</code>")
  assert str.contains(html, "<em>em</em>")
  assert str.contains(html, "<p>A second paragraph.</p>")
  # an empty doc contributes nothing at all
  assert plain_prose("") == ""
}

## The anchors [api_rows] hands the search index have to be ids this page
## really carries, and there have to be exactly as many of them as the page
## has anchored things. Both halves matter and they fail differently: a
## misspelled anchor is a search result that lands on the top of stdlib.html
## instead of on the entry, and an entry kind the page grew and this did not
## is a name the search can never find.
##
## Built from a synthetic `dawn doc --stdlib` document rather than from the
## real one, because `dawn test site` runs before site/build.sh writes it.
test "every index anchor is an id the page carries, and there are as many of each" {
  let api = probe_api()
  let rows = api_rows(api)
  let (pre, _) = prelude_html(no_pg(), api)
  let (mods, _) = modules_html(chrome(En, "."), no_pg(), api)
  let html = pre ++ traits_html(no_pg(), api) ++ mods
  for r in rows {
    assert str.contains(html, "id=\"" ++ r.anchor ++ "\"")
  }
  # Every id on the page is one of these rows: same count, no leftovers on
  # either side. `sub` and `entry` are the only two things here that emit an
  # id, so counting them counts the anchored things.
  assert len(str.split(html, ` id="`)) - 1 == len(rows)
  # and the five spellings really are five, so a slug that stopped
  # distinguishing them would move one of these lines
  assert map(rows, r => r.anchor) == [
    "g-io", "p-println", "prelude-trait-Show", "m-std-str", "std-str-type-Case",
    "std-str-trait-Split", "std-str-WIDTH", "std-str-effect-Ask", "std-str-trim",
  ]
  assert map(rows, r => r.title) == [
    "io", "println", "Show", "std/str", "Case", "Split", "str.WIDTH", "Ask", "str.trim",
  ]
}

fn fn_json(name: String) -> Json =
  jobj([("name", JStr(name)), ("sig", JStr("fn ${name}() -> Unit")), ("doc", JStr("D."))])

fn module_json(path: String, fns: List[String]) -> Json =
  jobj([("path", JStr(path)), ("doc", JStr("")), ("impls", JArr([])), ("types", JArr([])),
    ("traits", JArr([])), ("consts", JArr([])), ("effects", JArr([])),
    ("fns", JArr(map(fns, n => fn_json(n))))])

test "modules are listed alphabetically, not in compile order" {
  let api = jobj([("groups", JArr([])), ("traits", JArr([])),
    ("modules", JArr([module_json("std/str", []), module_json("std/char", []),
      module_json("std/prelude", []), module_json("std/bytes", [])]))])
  assert map(modules_in_order(api), m => field(m, "path"))
    == ["std/prelude", "std/bytes", "std/char", "std/str"]
  # the index walks them in the same order as the page
  assert map(api_rows(api), r => r.anchor)
    == ["m-std-prelude", "m-std-bytes", "m-std-char", "m-std-str"]
}

test "std/gpu's reference kernels sit in a closed group, still anchored and indexed" {
  let api = jobj([("groups", JArr([])), ("traits", JArr([])),
    ("modules", JArr([module_json("std/gpu", ["vadd_ref", "alloc", "sum_ref"]),
      module_json("std/str", ["trim_ref"])]))])
  let (html, _) = modules_html(chrome(En, "."), no_pg(), api)
  # the function a caller uses comes first, outside the group
  let parts = str.split(html, `<details class="api-refs">`)
  assert len(parts) == 2
  assert str.contains(parts[0], `id="std-gpu-alloc"`)
  assert str.contains(parts[1], "<summary>Reference kernels: 2 host-side answers")
  assert str.contains(parts[1], `id="std-gpu-vadd_ref"`)
  assert str.contains(parts[1], `id="std-gpu-sum_ref"`)
  # closed, and only std/gpu reads the suffix this way
  assert not str.contains(html, "<details class=\"api-refs\" open")
  let inside = str.split(parts[1], "</details>")[0]
  assert not str.contains(inside, `id="std-str-trim_ref"`)
  assert str.contains(html, `id="std-str-trim_ref"`)
  # the index still reaches every entry, in the page's order
  assert map(api_rows(api), r => r.anchor) == [
    "m-std-gpu", "std-gpu-alloc", "std-gpu-vadd_ref", "std-gpu-sum_ref", "m-std-str",
    "std-str-trim_ref",
  ]
}

fn probe_api() -> Json =
  jobj([
    ("groups", JArr([
      jobj([("name", JStr("io")),
        ("fns", JArr([
          jobj([("name", JStr("println")), ("sig", JStr("fn println(s: String) -> Unit !io")),
            ("doc", JStr("Print a line."))]),
        ]))]),
    ])),
    ("traits", JArr([
      jobj([("name", JStr("Show")), ("typeParam", JStr("T")), ("assoc", JArr([])),
        ("methods", JArr([])), ("doc", JStr("Text for a value."))]),
    ])),
    ("modules", JArr([
      jobj([
        ("path", JStr("std/str")),
        ("doc", JStr("Strings.")),
        ("impls", JArr([])),
        ("types", JArr([
          jobj([("name", JStr("Case")), ("record", JBool(false)), ("typeParams", JArr([])),
            ("ctors", JArr([])), ("doc", JStr("A case."))]),
        ])),
        ("traits", JArr([
          jobj([("name", JStr("Split")), ("typeParam", JStr("T")), ("assoc", JArr([])),
            ("methods", JArr([])), ("doc", JStr("Splitting."))]),
        ])),
        ("consts", JArr([
          jobj([("name", JStr("WIDTH")), ("type", JStr("Int")), ("doc", JStr("A width."))]),
        ])),
        ("effects", JArr([
          jobj([("name", JStr("Ask")), ("ops", JArr([])), ("doc", JStr("Asking."))]),
        ])),
        ("fns", JArr([
          jobj([("name", JStr("trim")), ("sig", JStr("fn trim(s: String) -> String")),
            ("doc", JStr("Trim it."))]),
        ])),
      ]),
    ])),
  ])

test "a marker comment never reaches the html, a stray < still escapes" {
  # end to end (parse then render): the two halves of the same rule
  assert plain_prose("状态：权威。<!-- doc-check: version -->") == "<p>状态：权威。</p>\n"
  assert plain_prose("a < b") == "<p>a &lt; b</p>\n"
}

fn link_json(text: String, module: String, name: String, kind: String) -> Json =
  jobj([("text", JStr(text)),
    ("target", jobj([("module", JStr(module)), ("name", JStr(name)), ("kind", JStr(kind))]))])

## Every kind of target lands on an id the page carries: the anchor rules
## here and in [api_rows] are one set of rules, and a member lands on its
## owner. Built from the same synthetic document as the anchor test above.
test "a doc link lands on the entry that holds its target" {
  let pg = pg_of([], probe_api())
  let lands = (module: String, name: String, kind: String) =>
    match link_anchor(jget(link_json(name, module, name, kind), "target")) {
      Some(a) -> if set.has(pg.anchors, a) { a } else { "missing #" ++ a }
      None -> "none"
    }
  assert lands("std/str", "", "module") == "m-std-str"
  assert lands("std/str", "trim", "fn") == "std-str-trim"
  assert lands("std/str", "WIDTH", "const") == "std-str-WIDTH"
  assert lands("std/str", "Case", "type") == "std-str-type-Case"
  assert lands("std/str", "Case.Upper", "ctor") == "std-str-type-Case"
  assert lands("std/str", "Case.width", "field") == "std-str-type-Case"
  assert lands("std/str", "Split", "trait") == "std-str-trait-Split"
  assert lands("std/str", "Split.split", "method") == "std-str-trait-Split"
  assert lands("std/str", "Ask", "effect") == "std-str-effect-Ask"
  assert lands("std/str", "Ask.ask", "op") == "std-str-effect-Ask"
  assert lands("", "println", "fn") == "p-println"
  assert lands("", "Show", "trait") == "prelude-trait-Show"
  assert lands("", "Show.show", "method") == "prelude-trait-Show"
  # a prelude type has no entry on this page
  assert lands("", "Int", "type") == "none"
  assert lands("", "Option.Some", "ctor") == "none"
}

test "a doc's links render as links to their entries, and nothing else moves" {
  let pg = pg_of([], probe_api())
  let doc = jobj([("doc", JStr("Like [`str.trim`], not [`Int`]; `[x]` and\n\n```\n[`str.trim`]\n```")),
    ("links", JArr([link_json("str.trim", "std/str", "trim", "fn"), link_json("Int", "", "Int", "type")]))])
  let html = doc_prose(pg, doc)
  assert str.contains(html, `Like <a href="#std-str-trim"><code>str.trim</code></a>, not <code>Int</code>;`)
  # a code span is still a code span, and the fenced example keeps its text
  assert str.contains(html, "<code>[x]</code>")
  assert str.contains(html, "[`str.trim`]")
  # the search index's note reads the names without the brackets
  assert unlinked(doc) == "Like `str.trim`, not `Int`; `[x]` and\n\n```\n`str.trim`\n```"
}

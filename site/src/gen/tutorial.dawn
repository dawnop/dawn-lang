# docs/tutorial.md -> tutorial/index.html + one page per ## chapter.

use md/ast.{Inline, Block, Heading}
use md/parser.{parse}
use html/render.{render_doc, inline_text}
use html/page.{Assets, Lang, En, Zh, page, contents_label}
use gen/common.{must_read, write_page, map_doc_url, doc_files, pad2, drop_trailing_rule}

type Chapter = { title: List[Inline], body: List[Block] }

## What the tutorial is called on its own pages: the index's <title>, and the
## suffix each chapter's <title> carries. One entry, because they are one name.
fn tutorial_name(lang: Lang) -> String =
  match lang {
    En -> "Dawn Tutorial"
    Zh -> "Dawn 教程"
  }

fn split_chapters(blocks: List[Block]) -> (List[Block], List[Chapter]) = {
  var intro: List[Block] = []
  var chapters: List[Chapter] = []
  var cur: List[Block] = []
  var cur_title: List[Inline] = []
  var started = false
  for b in blocks {
    var is_h2 = false
    match b {
      Heading(lvl, items) -> {
        if lvl == 2 {
          is_h2 = true
          if started {
            chapters = chapters ++ [Chapter { title: cur_title, body: drop_trailing_rule(cur) }]
          }
          started = true
          cur_title = items
          cur = []
        }
      }
      _ -> {
        is_h2 = false
      }
    }
    if not is_h2 {
      if started {
        cur = cur ++ [b]
      } else {
        intro = intro ++ [b]
      }
    }
  }
  if started {
    chapters = chapters ++ [Chapter { title: cur_title, body: drop_trailing_rule(cur) }]
  }
  (intro, chapters)
}

fn chapter_title(chapters: List[Chapter], i: Int) -> String =
  match get(chapters, i) {
    Some(c) -> inline_text(c.title)
    None -> ""
  }

fn chapter_nav(chapters: List[Chapter], i: Int, lang: Lang) -> String = {
  let n = len(chapters)
  let prev =
    if i > 0 {
      """<a class="prev" href="${pad2(i)}.html">← ${chapter_title(chapters, i - 1)}</a>"""
    } else {
      """<a class="prev" href="index.html">← ${contents_label(lang)}</a>"""
    }
  let next =
    if i + 1 < n {
      """<a class="next" href="${pad2(i + 2)}.html">${chapter_title(chapters, i + 1)} →</a>"""
    } else {
      ""
    }
  `<nav class="chapter-nav">` ++ "\n" ++ prev ++ "\n" ++ next ++ "\n</nav>"
}

## Which file this language's tutorial is written in, where its pages go, and
## how far it is from the site root. English is the original and takes the
## default layout; the translation sits under `/zh/`, the same place the
## Chinese front page does.
fn tutorial_source(out: String, lang: Lang) -> (String, String, String) =
  match lang {
    En -> ("docs/tutorial.md", "$out/tutorial", "..")
    Zh -> ("docs/tutorial.zh-CN.md", "$out/zh/tutorial", "../..")
  }

## The tutorial: an index page plus one page per `##` chapter. Called once per
## language, and `lang` picks all three of the source document, the output
## directory and the depth every relative link is written from -- so the two
## runs land beside each other instead of on top of each other.
##
## Every page here is paired, and the pair is named by its path in the default
## layout (`tutorial/03.html`) rather than by a pair of hrefs; html/page.dawn's
## [site_url] turns that into the switch link and the hreflang URLs, which
## differ between the two runs only in `root`.
pub fn gen_tutorial(out: String, a: Assets, lang: Lang) -> Unit !io = {
  let (src, dir, root) = tutorial_source(out, lang)
  let blocks =
    match parse(must_read(src)) {
      Ok(bs) -> bs
      Err(e) -> panic("$src: $e")
    }
  let (intro, chapters) = split_chapters(blocks)
  let n = len(chapters)
  let docs = doc_files()

  # chapter pages
  for i in range(0, n) {
    match get(chapters, i) {
      Some(c) -> {
        let doc = render_doc([Heading(1, c.title)] ++ c.body, u => map_doc_url(root, docs, u))
        let html = doc.html ++ chapter_nav(chapters, i, lang)
        let title = inline_text(c.title)
        write_page("$dir/${pad2(i + 1)}.html",
          page(a, lang, "tutorial/${pad2(i + 1)}.html",
            "$title — ${tutorial_name(lang)}", root, "tutorial", html))
      }
      None -> {
        panic("unreachable chapter index")
      }
    }
  }

  # index: the intro plus a chapter list
  let intro_doc = render_doc(intro, u => map_doc_url(root, docs, u))
  var items = ""
  for i in range(0, n) {
    items = items ++ "\n" ++
      """<li><a href="${pad2(i + 1)}.html">${chapter_title(chapters, i)}</a></li>"""
  }
  let listing = "<ul class=\"chapter-list\">" ++ items ++ "\n</ul>"
  write_page("$dir/index.html",
    page(a, lang, "tutorial/index.html", tutorial_name(lang), root, "tutorial",
      intro_doc.html ++ listing))
}

test "each language's tutorial reads its own file and lands in its own place" {
  assert tutorial_source("d", En) == ("docs/tutorial.md", "d/tutorial", "..")
  assert tutorial_source("d", Zh) == ("docs/tutorial.zh-CN.md", "d/zh/tutorial", "../..")
}

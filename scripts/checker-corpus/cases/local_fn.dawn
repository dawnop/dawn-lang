# checker.dawn: local functions
use std/io

# a local function declares no type parameters and no effect parameters: its
# row may name the enclosing signature's variables but cannot bind one
pub fn eff_var() -> Int = {
  fn inner(f: fn() -> Int !e) -> Int !e = f()
  1
}

pub fn body_type() -> Int = {
  fn inner() -> Int = "a"
  1
}

pub fn does_io() -> Int = {
  fn inner() -> Unit = io.println("x")
  1
}

pub fn returns_fn() -> Unit = {
  fn local() -> (fn() -> Int) = {
    io.println("x")
    () => 1
  }
  ()
}

pub effect Ask {
  fn get() -> Int
}

# #43: a label the body raises and the local function's row does not declare
# has nowhere to arrive from, even though the name resolves through the
# enclosing signature. Refused at the raise, which is the only place that can
# name the call; the repair is to write it into the row (SPC-19).
pub fn label_from_signature() -> Int !Ask = {
  fn inner() -> Int = get()
  inner()
}

# the same hole one step over: the handler is in the enclosing *body* rather
# than the enclosing signature, and an undeclared label cannot reach the local
# function from there either.
pub fn label_from_enclosing_handler() -> Int = {
  with handle Ask { get() => 1 }
  fn inner() -> Int = get()
  inner()
}

# Accepted: the local function answers the label inside its own body, which
# needs no signature. Nothing is recorded for this one or the next; that they
# add no line to the golden is the statement that the rule does not
# over-refuse.
pub fn label_handled_in_body() -> Int = {
  fn inner() -> Int = {
    with handle Ask { get() => 2 }
    get()
  }
  inner()
}

# Accepted: the label is raised by a *lambda* the local function returns, so it
# rides out in that closure's row and the call that runs it supplies the
# evidence. Only a raise in the local function's own frame is refused.
pub fn label_rides_out_on_a_closure() -> Int !Ask = {
  fn inner() -> (fn() -> Int !Ask) = () => get()
  inner()()
}

# #54: a call through an effect variable needs the enclosing function's erased
# evidence slot. A local function is lifted without that slot, so resolving the
# outer name here would only postpone the failure to `ev_slot` at run time.
fn twice(f: fn() -> Int !e) -> Int !e = f() + f()

pub fn variable_from_signature(f: fn() -> Int !e) -> Int !e !io = {
  fn probe() -> Int !io = twice(f)
  probe()
}

pub trait Runner[T] {
  effect E
  fn run(x: T) -> Int !T.E
}

# A rigid associated-effect projection has the same erased evidence ABI as an
# effect variable. It must be refused at the same boundary rather than reading
# the outer generic function's projection slot from the lifted body.
pub fn projection_from_signature[T: Runner](x: T) -> Int !T.E = {
  fn probe() -> Int = run(x)
  probe()
}

# Accepted since the syntax window (SPC-19): the row declares the label, the
# variable or the projection, so the call that runs the local function
# supplies it in the pack, exactly as for a lambda. No line in the golden.
pub fn label_declared() -> Int !Ask = {
  fn inner() -> Int !Ask = get()
  inner()
}

pub fn variable_declared(f: fn() -> Int !e) -> Int !e = {
  fn probe() -> Int !e = twice(f)
  probe()
}

pub fn projection_declared[T: Runner](x: T) -> Int !T.E = {
  fn probe() -> Int !T.E = run(x)
  probe()
}

# the row is a fixed promise: io the body performs has to be in it
pub fn declared_row_without_io() -> Int !Ask = {
  fn inner() -> Int !Ask = {
    io.println("x")
    get()
  }
  inner()
}

# Own-axis controls: ordinary pure and !io function values need no hidden
# evidence slot, so local functions keep forwarding both through captures.
pub fn pure_parameter(f: fn() -> Int) -> Int = {
  fn probe() -> Int = f()
  probe()
}

pub fn io_parameter(f: fn() -> Int !io) -> Int !io = {
  fn probe() -> Int !io = f()
  probe()
}

  (float_of_bits(0x3f9bacf914c1bad0), float_of_bits(-4883119185158096176)),
  (float_of_bits(0x3f9a41a41a41a41a), float_of_bits(0x3c30690690690690)),
  (float_of_bits(0x3f98f9c18f9c18fa), float_of_bits(-4886625283483689160)),
  (float_of_bits(0x3f97d05f417d05f4), float_of_bits(0x3c17d05f417d05f4)),
  (float_of_bits(0x3f96c16c16c16c17), float_of_bits(-4886605755680426849)),
  (float_of_bits(0x3f95c9882b931057), float_of_bits(0x3c2310572620ae4c)),
  (float_of_bits(0x3f94e5e0a72f0539), float_of_bits(0x3c3e0a72f0539783))
]

# |r| <= ln(2)/2. The degree-26 Taylor tail is < 2^-132;
# rounded coefficient pairs and compensated Horner errors are bounded separately.
fn dd_exp_reduced(r: (Float, Float)) -> (Float, Float) = {
  var p = DD_EXP_COEFF[26]
  var i = 25
  while i >= 0 {
    p = dd_add(DD_EXP_COEFF[i], dd_mul(r, p))
    i = i - 1
  }
  p
}
fn dd_exp_reduction(x: Float) -> ((Float, Float), Int) = {
  let k = to_int(round_even(x * LOG2_E))
  let r = dd_add((x, 0.0), dd_neg(dd_mul((to_float(k), 0.0), DD_LN2)))
  let p = dd_exp_reduced(r)
  (p, k)
}
fn dd_exp(x: Float) -> (Float, Float) = {
  let (p, k) = dd_exp_reduction(x)
  (ldexp(dd_hi(p), k), ldexp(dd_lo(p), k))
}

## Hyperbolic tangent with compensated reduction and division. Preserve signed
## zero; infinities give signed 1; NaN propagates. True error is at most 1 ulp.
## This deliberately differs from StrictMath.tanh, whose rounded expm1 quotient
## can exceed 1 ulp. The oracle registry records the correction and witnesses.
pub fn tanh(x: Float) -> Float = {
  if float.is_nan(x) { return x }
  let a = abs(x)
  # x - tanh(x) < x^3/3 here, below 1/12 ulp even at a binade boundary.
  if a < float_of_bits(0x3e30000000000000) { return x }
  # 1 - tanh(22) < 2*exp(-44) < half the spacing below 1.
  if a >= 22.0 { return copysign(1.0, x) }
  let e = dd_exp(-2.0 * a)
  let n = dd_add((1.0, 0.0), dd_neg(e))
  let d = dd_add((1.0, 0.0), e)
  let q = dd_div(n, d)
  copysign(dd_hi(q) + dd_lo(q), x)
}

## Base-two exponential. Integer powers in [-1074,1023] are exact, including
## subnormals. Both zeros give 1; -infinity gives +0; +infinity gives +infinity;
## NaN propagates. Finite results have true error at most 1 ulp.
pub fn exp2(x: Float) -> Float = {
  if float.is_nan(x) { return x }
  if x >= 1024.0 { return float.INFINITY }
  if x <= -1075.0 { return 0.0 }
  let k = to_int(round_even(x))
  let r = dd_mul((x - to_float(k), 0.0), DD_LN2)
  let p = dd_exp_reduced(r)
  ldexp(dd_hi(p) + dd_lo(p), k)
}

## Base-two logarithm. Every power of two, including subnormal powers, is exact.
## Both zeros give -infinity; negative inputs give NaN; +infinity and NaN
## propagate. Finite results have true error at most 1 ulp.
pub fn log2(x: Float) -> Float = {
  if x == 0.0 { return -float.INFINITY }
  if x < 0.0 { return float.NAN }
  if not float.is_finite(x) { return x }
  let (sig, binade) = normalized(x)
  var m = float_of_bits((1023 << 52) | (sig & 0x000fffffffffffff))
  var e = binade
  if m > SQRT_2 { m = m * 0.5
    e = e + 1 }
  if m == 1.0 { return to_float(e) }
  # m-1 is exact; dd_add retains the rounding residual of m+1.
  let z = dd_div((m - 1.0, 0.0), dd_add((m, 0.0), (1.0, 0.0)))
  let zz = dd_mul(z, z)
  var p = DD_LOG_COEFF[24]
  var i = 23
  while i >= 0 {
    p = dd_add(DD_LOG_COEFF[i], dd_mul(zz, p))
    i = i - 1
  }
  let l = dd_mul(dd_mul((2.0, 0.0), z), p)
  let result = dd_add((to_float(e), 0.0), dd_mul(l, DD_LOG2_E))
  dd_hi(result) + dd_lo(result)
}

fn dd_hi(p: (Float, Float)) -> Float = { let (h, _) = p
  h }
fn dd_lo(p: (Float, Float)) -> Float = { let (_, l) = p
  l }

# Small value lists keep the reduction workspace available at comptime.
fn fd_set[T](xs: List[T], i: Int, x: T) -> List[T] = list.take(xs, i) ++ [x] ++ list.drop(xs, i + 1)


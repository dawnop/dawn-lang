# The zip container (APPNOTE.TXT), enough of it to unpack a source archive.
#
# Read from the **central directory**, never by walking local headers from the
# front. A zip written as a stream may leave the sizes in its local headers at
# zero and put the real ones in a data descriptor *after* the data (general
# purpose flag bit 3). A deflate entry survives that -- its stream ends at
# BFINAL, so the reader can find the end without being told -- but a stored
# entry has no end marker at all, and a front-to-back reader would have no way
# to know where the next header begins. The central directory always carries
# the true sizes, so reading it first costs one backwards scan and removes the
# whole class of problem.
#
# Only reading, and only the two methods that occur in practice: 0 (stored,
# the bytes as they are) and 8 (deflate). Anything else is refused by number
# rather than guessed at.

use std/bytes
use std/str
use deflate
use crc32

## One entry, fully decompressed. Directories carry no data.
pub type Entry = { name: String, is_dir: Bool, data: Bytes }

## One central directory record, before any data is read. `size` is what the
## directory *claims* the entry expands to -- a claim, not a measurement, and
## the only one available to a caller deciding whether to unpack at all.
pub type Meta = {
  name: String,
  is_dir: Bool,
  flags: Int,
  method: Int,
  crc: Int,
  csize: Int,
  size: Int,
  local: Int,
}

const EOCD_SIG: Int = 0x06054B50
const CD_SIG: Int = 0x02014B50
const LOCAL_SIG: Int = 0x04034B50
const Z64_EOCD_SIG: Int = 0x06064B50
const Z64_LOC_SIG: Int = 0x07064B50

const METHOD_STORED: Int = 0
const METHOD_DEFLATE: Int = 8

const FLAG_ENCRYPTED: Int = 1

## The value a 32-bit field holds when the real one is off in a zip64 record.
const ZIP64_MARK: Int = 0xFFFFFFFF

## The same, for the 16-bit counts.
const ZIP64_MARK16: Int = 0xFFFF

const MAX_COMMENT: Int = 65535

fn in_range(b: Bytes, off: Int, n: Int) -> Bool = {
  let total = bytes.len(b)
  off >= 0 && off <= total && n >= 0 && n <= total - off
}

fn u16(b: Bytes, i: Int) -> Int = bytes.at(b, i) | (bytes.at(b, i + 1) << 8)

fn u32(b: Bytes, i: Int) -> Int = u16(b, i) | (u16(b, i + 2) << 16)

fn u64(b: Bytes, i: Int) -> Int = u32(b, i) | (u32(b, i + 4) << 32)

## The end-of-central-directory record is last, but a comment of up to 64KB may
## follow it, so it has to be searched for. Backwards, and taking the last
## match: those four bytes can occur inside entry data, and a forward scan
## would stop at the first accident. The comment length has to account for
## exactly the rest of the file, which rejects the accidents that remain.
fn find_eocd(b: Bytes) -> Result[Int, String] = {
  let n = bytes.len(b)
  if n < 22 { return Err("zip: too short to be an archive") }
  let floor = if n - 22 - MAX_COMMENT > 0 { n - 22 - MAX_COMMENT } else { 0 }
  var i = n - 22
  while i >= floor {
    if u32(b, i) == EOCD_SIG && i + 22 + u16(b, i + 20) == n { return Ok(i) }
    i = i - 1
  }
  Err("zip: no end-of-central-directory record (not a zip archive?)")
}

## Where the central directory is, how long it is, and how many records it
## holds. All three, not just the first: the count and the byte size are what
## make "the directory ended" a checkable claim instead of whatever the scan
## happened to stop at. A truncated or overwritten directory otherwise reads as
## a shorter archive, which is a silently missing file rather than an error.
type End = { start: Int, size: Int, count: Int }

## The end record's contents. The 32- and 16-bit fields in the EOCD give way to
## the zip64 end record once an archive outgrows 4GB or 65535 entries.
fn end_record(b: Bytes, eocd: Int) -> Result[End, String] = {
  let disk = u16(b, eocd + 4)
  let cd_disk = u16(b, eocd + 6)
  let here = u16(b, eocd + 8)
  let total = u16(b, eocd + 10)
  let size = u32(b, eocd + 12)
  let off = u32(b, eocd + 16)
  let needs64 = off == ZIP64_MARK || size == ZIP64_MARK ||
    total == ZIP64_MARK16 || here == ZIP64_MARK16 ||
    disk == ZIP64_MARK16 || cd_disk == ZIP64_MARK16
  if not needs64 {
    return checked_end(b, disk, cd_disk, here, total, size, off)
  }
  # the locator sits immediately before the EOCD and points at the zip64 end
  # record, which repeats the same fields at full width
  let loc = eocd - 20
  if not in_range(b, loc, 20) || u32(b, loc) != Z64_LOC_SIG {
    return Err("zip: archive needs zip64 but carries no zip64 locator")
  }
  let z = u64(b, loc + 8)
  if not in_range(b, z, 56) || u32(b, z) != Z64_EOCD_SIG {
    return Err("zip: zip64 locator does not point at a zip64 end record")
  }
  checked_end(b, u32(b, z + 16), u32(b, z + 20), u64(b, z + 24), u64(b, z + 32),
    u64(b, z + 40), u64(b, z + 48))
}

fn checked_end(
  b: Bytes,
  disk: Int,
  cd_disk: Int,
  here: Int,
  total: Int,
  size: Int,
  off: Int
) -> Result[End, String] = {
  # A split archive's directory describes entries whose data is in files this
  # reader was never handed, so the honest answer is that it cannot read it.
  if disk != 0 || cd_disk != 0 {
    return Err("zip: a multi-disk archive is not supported")
  }
  if here != total {
    return Err("zip: the end record says " ++ to_string(here) ++ " entries on this disk and " ++
        to_string(total) ++ " in total")
  }
  if size < 0 || not in_range(b, off, size) {
    return Err("zip: the central directory runs past the end")
  }
  Ok(End { start: off, size: size, count: total })
}

## The three fields a zip64 archive moves out of the fixed record.
type Sizes = { csize: Int, size: Int, local: Int }

## The zip64 extended information field (header id 1) carries only those of
## {uncompressed size, compressed size, local header offset} that were
## 0xFFFFFFFF in the fixed record, in that order, with nothing in the field to
## say which. So which ones to take is decided by what the fixed record said --
## the field cannot be parsed on its own.
fn zip64(b: Bytes, off: Int, elen: Int, s0: Sizes) -> Result[Sizes, String] = {
  var csize = s0.csize
  var size = s0.size
  var local = s0.local
  if csize != ZIP64_MARK && size != ZIP64_MARK && local != ZIP64_MARK {
    return Ok(s0)
  }
  let end = off + elen
  var p = off
  while p + 4 <= end {
    let id = u16(b, p)
    let flen = u16(b, p + 2)
    if p + 4 + flen > end { return Err("zip: malformed extra field") }
    if id == 1 {
      var q = p + 4
      let stop = p + 4 + flen
      if size == ZIP64_MARK {
        if q + 8 > stop { return Err("zip: zip64 extra field is short") }
        size = u64(b, q)
        q = q + 8
      }
      if csize == ZIP64_MARK {
        if q + 8 > stop { return Err("zip: zip64 extra field is short") }
        csize = u64(b, q)
        q = q + 8
      }
      if local == ZIP64_MARK {
        if q + 8 > stop { return Err("zip: zip64 extra field is short") }
        local = u64(b, q)
      }
      return Ok(Sizes { csize: csize, size: size, local: local })
    }
    p = p + 4 + flen
  }
  Err("zip: entry needs zip64 but carries no zip64 extra field")
}

## One central directory entry, and where the next one starts.
fn read_head(b: Bytes, p: Int) -> Result[(Meta, Int), String] = {
  if not in_range(b, p, 46) { return Err("zip: central directory runs past the end") }
  let nlen = u16(b, p + 28)
  let elen = u16(b, p + 30)
  let clen = u16(b, p + 32)
  if not in_range(b, p + 46, nlen + elen + clen) {
    return Err("zip: central directory runs past the end")
  }
  # Names are decoded as UTF-8 whether or not the entry says so (flag bit 11).
  # That is what java.util.zip does by default, and matching it keeps the same
  # archives readable; the alternative, CP437, needs a table for names that in
  # practice are ASCII.
  let name = bytes.decode_utf8_lossy(bytes.slice(b, p + 46, p + 46 + nlen))
  let fixed = Sizes { csize: u32(b, p + 20), size: u32(b, p + 24), local: u32(b, p + 42) }
  let s = match zip64(b, p + 46 + nlen, elen, fixed) {
    Ok(t) -> t
    Err(e) -> return Err(e ++ " (" ++ name ++ ")")
  }
  # A directory is an entry whose name ends in a slash. That is the whole
  # rule -- ZipEntry.isDirectory() is the same test -- and the external
  # attributes, which look more authoritative, are written by whatever
  # operating system made the archive and are not portable.
  let h = Meta {
    name: name,
    is_dir: str.ends_with(name, "/"),
    flags: u16(b, p + 8),
    method: u16(b, p + 10),
    crc: u32(b, p + 16),
    csize: s.csize,
    size: s.size,
    local: s.local,
  }
  Ok((h, p + 46 + nlen + elen + clen))
}

## Every entry's metadata, in central directory order, without unpacking
## anything. This is what a caller with a budget needs first: how many entries
## there are and how big each says it will be, decided before the first byte of
## the first one is materialised.
pub fn headers(src: Bytes) -> Result[List[Meta], String] = {
  let eocd = match find_eocd(src) {
    Ok(i) -> i
    Err(e) -> return Err(e)
  }
  let e = match end_record(src, eocd) {
    Ok(t) -> t
    Err(er) -> return Err(er)
  }
  var out: List[Meta] = []
  var p = e.start
  var i = 0
  while i < e.count {
    # Reading exactly as many records as the end record declares, and requiring
    # each one to be there. Stopping at the first byte that is not a signature
    # would turn a damaged directory into a shorter archive.
    if not in_range(src, p, 4) || u32(src, p) != CD_SIG {
      return Err("zip: the central directory ends after " ++ to_string(i) ++ " of " ++
          to_string(e.count) ++ " entries")
    }
    let (h, next) = match read_head(src, p) {
      Ok(t) -> t
      Err(er) -> return Err(er)
    }
    out = out ++ [h]
    p = next
    i = i + 1
  }
  if p != e.start + e.size {
    return Err("zip: the central directory is " ++ to_string(p - e.start) ++
        " bytes, the end record says " ++ to_string(e.size))
  }
  Ok(out)
}

## One entry's bytes, with a ceiling on how big they may get. `None` is no
## ceiling; a directory entry is empty.
##
## The ceiling matters even though `m.size` is right there: that number is the
## archive's claim about itself, checked afterwards, and a bomb is a small
## compressed member with a large true expansion and whatever `size` its writer
## felt like putting in the directory.
pub fn read_bounded(src: Bytes, m: Meta, cap: Option[Int]) -> Result[Bytes, String] = {
  if m.is_dir { return Ok(bytes.utf8("")) }
  if m.flags & FLAG_ENCRYPTED != 0 { return Err("zip: encrypted entry: " ++ m.name) }
  if not in_range(src, m.local, 30) || u32(src, m.local) != LOCAL_SIG {
    return Err("zip: no local header for " ++ m.name)
  }
  # The local header's name and extra lengths need not match the central
  # directory's -- writers routinely put zip64 padding in one and not the other
  # -- so where the data starts is a question only the local header answers.
  let start = m.local + 30 + u16(src, m.local + 26) + u16(src, m.local + 28)
  if not in_range(src, start, m.csize) {
    return Err("zip: entry data runs past the end: " ++ m.name)
  }
  # A stored member's compressed bytes are its output. Check both metadata
  # claims, and the caller's ceiling, before slicing those bytes out of the
  # archive; doing either afterwards has already paid the allocation the
  # ceiling exists to prevent.
  if m.method == METHOD_STORED {
    if m.csize != m.size {
      return Err("zip: " ++ m.name ++ " unpacked to " ++ to_string(m.csize) ++
          " bytes, the directory says " ++ to_string(m.size))
    }
    match cap {
      None -> { }
      Some(lim) -> {
        if lim < 0 {
          return Err("zip: " ++ m.name ++ ": a negative output limit (" ++
              to_string(lim) ++ ")")
        }
        if m.size > lim {
          return Err("zip: " ++ m.name ++ ": the output exceeds the " ++
              to_string(lim) ++ " byte limit (stopped at 0 bytes)")
        }
      }
    }
  }
  let raw = bytes.slice(src, start, start + m.csize)
  var out = raw
  if m.method == METHOD_DEFLATE {
    match deflate.inflate_end(raw, cap) {
      Ok(pr) -> {
        let (o, used) = pr
        # The directory says how long the compressed member is, so a member
        # that ends early has bytes in it nobody read -- the reader must not
        # decide on its own that the rest was padding.
        if used != m.csize {
          return Err("zip: " ++ m.name ++ " read " ++ to_string(used) ++
              " of its " ++ to_string(m.csize) ++ " compressed bytes")
        }
        out = o
      }
      Err(e) -> return Err("zip: " ++ m.name ++ ": " ++ e)
    }
  } else if m.method != METHOD_STORED {
    return Err("zip: compression method " ++ to_string(m.method) ++
        " is not supported (" ++ m.name ++ ")")
  }
  if bytes.len(out) != m.size {
    return Err("zip: " ++ m.name ++ " unpacked to " ++ to_string(bytes.len(out)) ++
        " bytes, the directory says " ++ to_string(m.size))
  }
  if crc32.sum(out) != m.crc { return Err("zip: checksum mismatch for " ++ m.name) }
  Ok(out)
}

## One entry's bytes, however many there turn out to be.
pub fn read(src: Bytes, m: Meta) -> Result[Bytes, String] = read_bounded(src, m, None)

## Every entry in the archive, fully unpacked, in central directory order. An
## archive with no entries reads as the empty list: that is a legal zip, and
## whether it is an acceptable one is the caller's question.
pub fn entries(src: Bytes) -> Result[List[Entry], String] = {
  let ms = match headers(src) {
    Ok(hs) -> hs
    Err(e) -> return Err(e)
  }
  var out: List[Entry] = []
  for m in ms {
    let data = match read(src, m) {
      Ok(d) -> d
      Err(e) -> return Err(e)
    }
    out = out ++ [Entry { name: m.name, is_dir: m.is_dir, data: data }]
  }
  Ok(out)
}

test "overflowing zip64 metadata is refused instead of wrapping into range" {
  # A minimal local header for a stored entry: signature, then zero-valued
  # fixed fields (including zero-length name and extra fields).
  var raw = bytes.buf()
  for x in [0x50, 0x4B, 0x03, 0x04] { raw = bytes.put(raw, x) }
  while bytes.size(raw) < 30 { raw = bytes.put(raw, 0) }
  let src = bytes.freeze(raw)
  let max = 9223372036854775807

  # `start + csize` used to wrap negative and pass the range check. Slicing
  # that reversed range then produced empty bytes, so this malformed entry was
  # accepted as a valid empty file (size 0 and CRC-32 0).
  let huge_data = Meta {
    name: "huge-data",
    is_dir: false,
    flags: 0,
    method: METHOD_STORED,
    crc: 0,
    csize: max,
    size: 0,
    local: 0,
  }
  assert read(src, huge_data) == Err("zip: entry data runs past the end: huge-data")

  # The same overflow on the local-header offset let the signature read run
  # at Int.MAX, where a malformed archive became a bounds panic instead of an
  # ordinary parser error.
  let huge_local = Meta {
    name: "huge-local",
    is_dir: false,
    flags: 0,
    method: METHOD_STORED,
    crc: 0,
    csize: 0,
    size: 0,
    local: max,
  }
  match catch_panic(() => read(src, huge_local)) {
    Ok(Err(e)) -> { assert e == "zip: no local header for huge-local" }
    Ok(Ok(_)) -> { assert false }
    Err(_) -> { assert false }
  }
}

test "stored entries honor the output ceiling before their bytes are copied" {
  # A minimal local header followed by one stored byte.
  var raw = bytes.buf()
  for x in [0x50, 0x4B, 0x03, 0x04] { raw = bytes.put(raw, x) }
  while bytes.size(raw) < 30 { raw = bytes.put(raw, 0) }
  raw = bytes.put(raw, 120)
  let src = bytes.freeze(raw)
  let payload = bytes.utf8("x")
  let stored = Meta {
    name: "stored",
    is_dir: false,
    flags: 0,
    method: METHOD_STORED,
    crc: crc32.sum(payload),
    csize: 1,
    size: 1,
    local: 0,
  }

  assert read_bounded(src, stored, Some(1)) == Ok(payload)
  assert read_bounded(src, stored, Some(0)) ==
    Err("zip: stored: the output exceeds the 0 byte limit (stopped at 0 bytes)")
  assert read_bounded(src, stored, Some(-1)) ==
    Err("zip: stored: a negative output limit (-1)")

  # This claim used to be checked only after the compressed byte had
  # already been sliced out. A stored member cannot legitimately have
  # different compressed and uncompressed sizes.
  let inconsistent = Meta {
    name: "inconsistent",
    is_dir: false,
    flags: 0,
    method: METHOD_STORED,
    crc: 0,
    csize: 1,
    size: 0,
    local: 0,
  }
  assert read_bounded(src, inconsistent, Some(0)) ==
    Err("zip: inconsistent unpacked to 1 bytes, the directory says 0")
}

## `TileProg` as CUDA Tile IR bytecode: the file `tileiras` assembles into a
## cubin. Layer 1 of tile-backend-design 6.2: scripts/tile-golden pins the
## bytes and then hands them to `tileiras --gpu-name sm_86`, whose exit code
## is the one machine verdict on whether what we emit is a Tile IR program.
#
# The format is the one NVIDIA/cuda-tile's BytecodeWriter.cpp writes and its
# BytecodeReader.cpp reads (commit be0889cd, 2026-09); the opcode, type-tag and
# attribute-tag tables are the frozen ones in BytecodeOpcodes.td,
# BytecodeTypeOpcodes.td and BytecodeAttrOpcodes.td, and the per-operation
# layout is what the tablegen backend (tools/cuda-tile-tblgen/BytecodeGen.cpp)
# generates from Ops.td. cuTile.jl's src/bytecode (writer.jl, encodings.jl,
# types.jl) is an independent writer of the same format and was read
# alongside; where the two disagree in what they emit (it always writes a
# debug section, we never do; it pre-registers i1 and i32 at type indices 0
# and 1, we register types in first-use order) both forms are accepted by the
# reader and the C++ writer's is the one followed here.
#
#   file      =: magic[8: 7F 'T' 'i' 'l' 'e' 'I' 'R' 00] major[u8] minor[u8]
#                tag[u16 LE] section* end[00]
#   section   =: id[u8, bit 7 = aligned] length[varint] (alignment[varint]
#                padding[CB* to the alignment, counted from the start of the
#                file])? data
#   Func (2, aligned 8) =: numFunctions[varint] function*
#   function  =: nameIndex[varint] signatureIndex[varint] flags[u8: bit 1 =
#                kernel] locIndex[varint, 0 = unknown] bodyLength[varint] body
#   body      =: instruction*, values numbered from 0: the entry parameters
#                first, then each result in order
#   instruction =: opcode[varint] (numResults[varint])? resultTypeIndex[varint]*
#                (flags[varint])? attributes (numOperands[varint])?
#                operands[varint]* (numRegions[varint] region*)?
#   region    =: numBlocks[varint] block*
#   block     =: numArgs[varint] argTypeIndex[varint]* numOps[varint]
#                instruction*
#
# The counts are present on an operation with a variadic operand or result
# list (`return`, `continue`, `for`), and the flags on one with an optional
# field the targeted version knows (`for`'s `unsigned`, 13.2 and later).
# Value indices inside a block continue from the enclosing count: the block
# arguments take the next indices, the block's results follow, and when the
# block ends the count rolls back to where it stood before the arguments, so
# the region-holding operation's own results take the indices the body just
# used (BytecodeWriter.cpp writeBlock). The table's numbers are the text's,
# so `index` maps each table value to its index here.
#   Constant (4, aligned 8), Type (5, aligned 4), String (1, aligned 4) =:
#                count[varint] padding[to the index width] offset[u64 or u32
#                LE]* data*, where a constant is length[varint] + raw bytes,
#                a type is tag[u8] + tag-specific data, a string is its bytes
#
# Only what the instruction table can hold is encoded: the memory operations
# are `weak`, unmasked, with the token operand present (flags bit 4 on a load,
# bit 3 on a store); `addf` is `rounding<nearest_even>` (0) with no
# flush-to-zero (flags 0); the integer operations carry `overflow` none (0).
# Nothing here is versioned by anything but the header:
# the bytecode this writes is the same at 13.1, 13.2 and 13.3, and only
# the number in the header says which; `tileiras` 13.3.36 accepted all three.
use std/bytes
use std/list
use std/map
use std/narrow
use std/str
use dev.{RedId, IdF, IdI}
use prog.{TileProg, MakeToken, BlockId, Load, Store, ConstF, ConstI, Iota, Lanes, UnaryF, BinaryF, BinaryI, Fma, MmaF, MmaI, CmpF, CmpI, Select, IdxConst, IdxAdd, IdxMul, For, Continue, Spread, Reduce, Scan, If, Yield, Extract, Cat, Permute, NumBlocks, JoinToks, MakePtrs, PtrAdd, PtrInt, IntPtr, PtrCast, LoadAt}
use lower.{Kernel, Instr, Ty, Elem, Ref, lower, defines, rank0_of, Token, Tile, Num, PtrTo, Arg, Val, MakeTok, BlockIds, ConstInt, ConstFloat, MulInt, AddInt, Reshape, Broadcast, IotaTile, Offset, LoadPtr, StorePtr, AtomicRMWPtr, AtomicCASPtr, FloatUn, FloatBin, FloatFma, FloatMma, IntMma, CmpFloat, CmpInt, IntUn, IntBin, Cast, SelectTile, ForLoop, WhileLoop, BreakVals, Cont, ReduceTile, ScanTile, IfElse, YieldVals, ExtractTile, CatTile, PermuteTile, BlockCounts, JoinTokens, PtrToIntTile, IntToPtrTile, PtrToPtrTile, Ret}

## The bytecode version written into the header (tile-backend-design 6.3).
## 13.2 is the lowest version Tile IR is supported on Ampere and Ada at; the
## three numbers that must move together are this one, the `tileiras` pin in
## scripts/tile-golden/toolchain.txt, and the driver in the ledger.
pub const BYTECODE_MAJOR: Int = 13
pub const BYTECODE_MINOR: Int = 2

## The version as `tileiras --list-versions` spells it.
pub fn bytecode_version() -> String = "${BYTECODE_MAJOR}.${BYTECODE_MINOR}"

# Opcodes (BytecodeOpcodes.td, frozen).
const OP_ABSF: Int = 0x00
const OP_ATOMIC_CAS_TKO: Int = 0x07
const OP_ATOMIC_RMW_TKO: Int = 0x08
const OP_ABSI: Int = 0x01
const OP_ADDF: Int = 0x02
const OP_ADDI: Int = 0x03
const OP_ANDI: Int = 0x04
const OP_BITCAST: Int = 0x09
const OP_BREAK: Int = 0x0A
const OP_BROADCAST: Int = 0x0B
const OP_CAT: Int = 0x0C
const OP_CEIL: Int = 0x0D
const OP_CMPF: Int = 0x0E
const OP_CMPI: Int = 0x0F
const OP_CONSTANT: Int = 0x10
const OP_CONTINUE: Int = 0x11
const OP_COS: Int = 0x12
const OP_COSH: Int = 0x13
const OP_DIVF: Int = 0x14
const OP_DIVI: Int = 0x15
const OP_EXP: Int = 0x17
const OP_EXP2: Int = 0x18
const OP_EXTI: Int = 0x25
const OP_EXTRACT: Int = 0x26
const OP_FLOOR: Int = 0x27
const OP_FTOF: Int = 0x2A
const OP_FTOI: Int = 0x2B
const OP_FMA: Int = 0x28
const OP_FOR: Int = 0x29
const OP_GET_NUM_TILE_BLOCKS: Int = 0x2E
const OP_GET_TILE_BLOCK_ID: Int = 0x30
const OP_IF: Int = 0x32
const OP_INT_TO_PTR: Int = 0x33
const OP_IOTA: Int = 0x3A
const OP_ITOF: Int = 0x3B
const OP_JOIN_TOKENS: Int = 0x3C
const OP_LOAD_PTR_TKO: Int = 0x3D
const OP_LOG: Int = 0x3F
const OP_LOG2: Int = 0x40
const OP_LOOP: Int = 0x41
const OP_MAKE_TOKEN: Int = 0x44
const OP_MAXF: Int = 0x45
const OP_MAXI: Int = 0x46
const OP_MINF: Int = 0x47
const OP_MINI: Int = 0x48
const OP_MMAF: Int = 0x49
const OP_MMAI: Int = 0x4A
const OP_MULF: Int = 0x4C
const OP_MULHII: Int = 0x4D
const OP_MULI: Int = 0x4E
const OP_NEGF: Int = 0x4F
const OP_NEGI: Int = 0x50
const OP_OFFSET: Int = 0x51
const OP_ORI: Int = 0x52
const OP_PERMUTE: Int = 0x53
const OP_POW: Int = 0x54
const OP_PTR_TO_INT: Int = 0x56
const OP_PTR_TO_PTR: Int = 0x57
const OP_REDUCE: Int = 0x58
const OP_REMF: Int = 0x59
const OP_REMI: Int = 0x5A
const OP_RESHAPE: Int = 0x5B
const OP_RETURN: Int = 0x5C
const OP_RSQRT: Int = 0x5D
const OP_SCAN: Int = 0x5E
const OP_SELECT: Int = 0x5F
const OP_SHLI: Int = 0x60
const OP_SHRI: Int = 0x61
const OP_SIN: Int = 0x62
const OP_SINH: Int = 0x63
const OP_SQRT: Int = 0x64
const OP_STORE_PTR_TKO: Int = 0x65
const OP_SUBF: Int = 0x67
const OP_SUBI: Int = 0x68
const OP_TAN: Int = 0x69
const OP_TANH: Int = 0x6A
const OP_TRUNCI: Int = 0x6B
const OP_XORI: Int = 0x6C
const OP_YIELD: Int = 0x6D
const OP_ATAN2: Int = 0x6E

# The flag bits of a memory operation, in the order the reader assigns them:
# the optional attributes of the operation in declaration order first
# (`memory_scope`, `optimization_hints`), then its optional operands
# (`mask`, `paddingValue`, `token` on a load; `mask`, `token` on a store).
const LOAD_FLAG_MASK: Int = 4
const LOAD_FLAG_PAD: Int = 8
const LOAD_FLAG_TOKEN: Int = 16
const STORE_FLAG_MASK: Int = 4
const STORE_FLAG_TOKEN: Int = 8

# The atomics have NO optional attribute at all: their `memory_scope` is a
# required argument where a load's is an `OptionalAttr` (Ops.td). So their
# flag bits start at the first optional OPERAND, and both operations carry
# the same two in the same order.
const ATOMIC_FLAG_MASK: Int = 1
const ATOMIC_FLAG_TOKEN: Int = 2

# `memory_ordering_semantics`: weak. `comparison_ordering`: ordered, so every
# predicate answers 0 on a NaN operand. `signedness`: signed. `rounding_mode`:
# nearest_even, the one mode tile-backend-design 3.2's theorem covers.
const ORDER_WEAK: Int = 0

# `memory_ordering_semantics` on an ATOMIC: relaxed. `weak` (0) is the one
# variant the two atomic operations do not accept -- Ops.td gives them
# `OnlyVariants<["RELAXED", "ACQUIRE", "RELEASE", "ACQ_REL"]>`, and it is
# refused rather than ignored, which is what makes it a layer-1 mutant.
# `weak` means "assume nobody else touches this location", which is the
# opposite of what every atomic here is for.
const ORDER_RELAXED: Int = 1

# `memory_scope`: device. The lanes that collide on one histogram bin are
# in different tile BLOCKS, so `tl_blk` (0) would be too narrow; `sys` (2)
# would be wider than one GPU needs.
const SCOPE_DEVICE: Int = 1
const CMP_ORDERED: Int = 1
const SIGNED: Int = 1
const UNSIGNED: Int = 0
const ROUND_NEAREST_EVEN: Int = 0

# `rounding`: zero, integer division truncating toward zero. The dialect's
# own default for `divi`, and `to_int`'s rounding on the host.
const ROUND_ZERO: Int = 1

# `rounding_mode`: nearest_int_to_zero, the ONE mode `ftoi` accepts
# (Ops.td's FToIOp says so and `custom<IntegerRoundingMode>` is its printer).
# Not `zero` (1), which is the integer DIVISION rounding.
const ROUND_INT_TO_ZERO: Int = 6

# `overflow`: none. The compiler assumes nothing about wrap-around, which is
# what a kernel that wraps on purpose needs.
const OVERFLOW_NONE: Int = 0

# `rounding_mode`: full, the CUDA Math API's own precision. The only mode an
# f64 `tanh` accepts (`nearest_even` is refused and `approx` is f32-only,
# both measured), and its default, which is why the text prints nothing.
const ROUND_FULL: Int = 5

# Attribute tags (BytecodeAttrOpcodes.td, frozen). A reduction's identities
# are an ArrayAttr, whose elements are written SELF-CONTAINED: each carries
# its tag and the index of its element type before its payload.
const ATTR_INTEGER: Int = 1
const ATTR_FLOAT: Int = 2

# `permute`'s `permutation` is a DENSE array and is NOT written the way that
# `identities` array is. The two shapes were measured against the writer
# rather than guessed from each other (knife T2), because "a list of small
# integers" reads the same in both:
#
#   ArrayAttr        count[varint] then one SELF-CONTAINED element each
#                    (tag, element type index, payload) -- what
#                    `identity_attr` writes
#   DenseI32ArrayAttr  count[varint] then each element as FOUR raw
#                    little-endian bytes, no tag and no type index
#
# The path is BytecodeWriter.cpp's `writeOpAttribute`: a `DenseI32ArrayAttr`
# getter answers `ArrayRef<int32_t>`, which lands in the `writeLEVarSize`
# branch (size as a varint, then `writeLE` per element), while an
# `mlir::ArrayAttr` lands in `writeSingleAttribute`'s ArrayAttr case. The
# reader agrees: `readLEVarSize` into a `SmallVector<int32_t>`.
fn emit_i32_array(w: W, xs: List[Int]) -> W =
  W { ..w, body: list.fold(xs, put_varint(w.body, len(xs)), (b, x) => put_le(b, x, 4)) }

# The `rmw_mode` values (AttrDefs.td's AtomicRMWMode, an i32 enum). The
# order is the enum's own and not alphabetical: `add` is 3 and `addf` 4,
# with the three bitwise modes before them.
fn rmw_mode_value(mode: String) -> Int = match mode {
  "and" -> 0
  "or" -> 1
  "xor" -> 2
  "add" -> 3
  "addf" -> 4
  "max" -> 5
  "min" -> 6
  "umax" -> 7
  "umin" -> 8
  "xchg" -> 9
  _ -> panic("tileir: `${mode}` is not an atomic read-modify-write mode")
}

# The `comparison_predicate` values (AttrDefs.td, an i32 enum).
fn predicate_value(pred: String) -> Int = match pred {
  "eq" -> 0
  "ne" -> 1
  "lt" -> 2
  "le" -> 3
  "gt" -> 4
  "ge" -> 5
  _ -> panic("tileir: `${pred}` is not a comparison predicate")
}

# ---- the integer family (knife 10) ----
#
# The layout of each operation is BytecodeGen.cpp's: result types, then a
# flags varint IF the operation has an OPTIONAL field the targeted version
# knows, then the attributes in DECLARATION order, then the operands.
#
# `DefaultValuedAttr` is NOT an optional field. tblgen's `isOptional()` is
# `OptionalAttr`'s alone, and `generateAttributeSerialization` sends an
# attribute with a default value down the REQUIRED path (it is the branch
# that reads `extractDefaultValue`): the value is written inline, guarded
# only by the version the field arrived in. So every integer operation here
# writes its attributes inline and NONE of them writes a flags varint; the
# only fields that ever reach the flags word are `OptionalAttr`s, unit
# attributes and optional operands, which is what the memory operations and
# `maxf` have and no operation below does.
#
# This cost a wrong answer on the device and is the reason it is written
# out here. Writing a flags 0 in front of a one-attribute operation is
# INVISIBLE at layers 0 and 1: the byte is the same one the attribute would
# have used when the attribute's value is 0, so `addi`'s "flags 0" and its
# "overflow none" are the same stream and tileiras cannot tell the two
# readings apart. `divi` has TWO attributes (`signedness`, then `rounding`),
# so the spurious flags byte shifted both: the reader took 0 for the
# signedness and answered UNSIGNED division. tileiras accepted it -- an
# unsigned divide is a legal program -- and scripts/tile-gpu-diff's
# int_ops caught it on a corpus with negative dividends.

# The opcode of an integer operation. `shri` and `shru` are one opcode; the
# signedness attribute below is what separates them.
fn int_op(op: String) -> Int = match op {
  "addi" -> OP_ADDI
  "subi" -> OP_SUBI
  "muli" -> OP_MULI
  "divi" -> OP_DIVI
  "remi" -> OP_REMI
  "maxi" -> OP_MAXI
  "mini" -> OP_MINI
  "mulhii" -> OP_MULHII
  "andi" -> OP_ANDI
  "ori" -> OP_ORI
  "xori" -> OP_XORI
  "shli" -> OP_SHLI
  "shri" -> OP_SHRI
  "shru" -> OP_SHRI
  "negi" -> OP_NEGI
  "absi" -> OP_ABSI
  _ -> panic("tileir: `${op}` is not an integer operation")
}

# The attributes an integer operation writes inline, in declaration order.
#
#   `overflow` none    the four wrapping operations and `negi`: the device
#                      wraps and the compiler is told to assume nothing
#   `signedness`       `divi` / `remi` / `maxi` / `mini` are signed, as
#                      `cmpi` is; `shri` is the ARITHMETIC right shift and
#                      `shru` the logical one, the same opcode under the
#                      other signedness. That one attribute is the whole
#                      difference between them, which is what
#                      scripts/tile-gpu-diff's shri-always-logical measures
#   `rounding` zero    `divi` alone: integer division truncating toward
#                      zero, which is the dialect's default and C's
#
# `mulhii` takes nothing at all -- the dialect defines it for unsigned
# operands and gives it no signedness -- and neither do the three bitwise
# operations or `absi`.
fn int_attrs(op: String) -> List[Int] = match op {
  "addi" -> [OVERFLOW_NONE]
  "subi" -> [OVERFLOW_NONE]
  "muli" -> [OVERFLOW_NONE]
  "shli" -> [OVERFLOW_NONE]
  "negi" -> [OVERFLOW_NONE]
  "divi" -> [SIGNED, ROUND_ZERO]
  "remi" -> [SIGNED]
  "maxi" -> [SIGNED]
  "mini" -> [SIGNED]
  "shri" -> [SIGNED]
  "shru" -> [UNSIGNED]
  _ -> []
}

# The opcode of a conversion.
fn cast_op(op: String) -> Int = match op {
  "itof" -> OP_ITOF
  "ftoi" -> OP_FTOI
  "ftof" -> OP_FTOF
  "exti" -> OP_EXTI
  "trunci" -> OP_TRUNCI
  "bitcast" -> OP_BITCAST
  _ -> panic("tileir: `${op}` is not a conversion")
}

# The attributes a conversion writes inline, in declaration order. `exti`
# widens a mask and is UNSIGNED, so a one-bit 1 becomes 1 and not -1;
# `ftoi` takes the only integer rounding mode the dialect accepts
# (`nearest_int_to_zero`, Ops.td's FToIOp), which is not the integer
# division's `zero`; `trunci` carries an `overflow` and `bitcast` nothing.
#
# `ftof` carries a rounding mode ALONE, and it is a `DefaultValuedAttr`
# (Ops.td's FToFOp: `DefaultValuedAttr<CudaTile_RoundingModeAttr,
# NEAREST_EVEN>`, arrived in 13.1). By the rule at the head of this section
# that is still the required path: written inline, no flags varint. Its
# value happens to equal the default, so the byte would be 0 either way and
# tileiras cannot tell a spurious flags word from it -- exactly the shape
# that cost a wrong answer on `divi`, and the reason the device is the judge
# here as well.
fn cast_attrs(op: String, to: String) -> List[Int] = match op {
  "itof" -> [SIGNED, ROUND_NEAREST_EVEN]
  "ftoi" -> [SIGNED, ROUND_INT_TO_ZERO]
  "ftof" -> [ftof_rounding(to)]
  "exti" -> [UNSIGNED]
  "trunci" -> [OVERFLOW_NONE]
  _ -> []
}

# `ftof`'s rounding mode, which is the ONE place in this writer where the
# TARGET FORMAT decides an attribute byte rather than a type tag.
#
# Ops.td's FToFOp: "For conversion to f8E8M0FNU, only ZERO and POSITIVE_INF
# rounding modes are supported. Otherwise, only NEAREST_EVEN rounding mode
# is supported." So the default value of the attribute is illegal for that
# one target and legal for every other, and a writer that ignores the
# sentence is refused at layer 1 in both directions (the mutants
# e8m0-rounding-as-nearest-even and e8m0-tag-as-f8e5m2 in
# scripts/tile-golden/run.sh are those two directions). `zero` is the mode
# written here, and std/gpu's `round_f8e8m0` is the host reading of it: the
# largest power of two at or below the value.
fn ftof_rounding(to: String) -> Int =
  if to == "f8E8M0FNU" { ROUND_ZERO } else { ROUND_NEAREST_EVEN }

# The opcode of an element-wise float operation, and whether it carries a
# rounding mode. `maxf` and `minf` take `propagate_nan` and `flush_to_zero`
# instead, both of which are unit attributes and so are flag bits with no
# payload; `negf` and `absf` take nothing at all.
fn float_op(op: String) -> Int = match op {
  "addf" -> OP_ADDF
  "subf" -> OP_SUBF
  "mulf" -> OP_MULF
  "divf" -> OP_DIVF
  "maxf" -> OP_MAXF
  "minf" -> OP_MINF
  "pow" -> OP_POW
  "negf" -> OP_NEGF
  "absf" -> OP_ABSF
  "exp" -> OP_EXP
  "exp2" -> OP_EXP2
  "log" -> OP_LOG
  "log2" -> OP_LOG2
  "sqrt" -> OP_SQRT
  "rsqrt" -> OP_RSQRT
  "tanh" -> OP_TANH
  "floor" -> OP_FLOOR
  "ceil" -> OP_CEIL
  "sin" -> OP_SIN
  "cos" -> OP_COS
  "tan" -> OP_TAN
  "sinh" -> OP_SINH
  "cosh" -> OP_COSH
  "atan2" -> OP_ATAN2
  "remf" -> OP_REMF
  _ -> panic("tileir: `${op}` is not a float operation")
}

fn float_op_rounds(op: String) -> Bool = op == "addf" || op == "subf" || op == "mulf" || op == "divf"

# Whether an operation writes a flags varint: it does exactly when it has an
# optional field the targeted bytecode version knows (BytecodeGen.cpp
# generateFlagsFieldSerialization), and every optional field here is a
# `UnitAttr` that is never set, so the varint is always 0. `pow` has none;
# `exp` has none at 13.2 (its `rounding_mode` is 13.3 and a reader that met
# one here would take the next byte for the operand); `tanh` has a
# `rounding_mode` that is REQUIRED at 13.2 and so is not a flag either.
# Every measurement behind this table is scripts/tile-golden's layer 1: each
# wrong shape was handed to `tileiras` and refused.
#
# Knife T1's seven are all on this list and for one reason: their Ops.td
# records declare a `source` (or an `lhs` and an `rhs`) and NOTHING else,
# no `OptionalAttr` and no optional operand, so
# getVersionOrderedBitAssignments returns an empty map and
# generateFlagsFieldSerialization writes nothing at all. A flags 0 written
# anyway is invisible at layer 0 and layer 1 reads it as the next operand
# index, which is the layer-1 mutant trig-extra-flags.
fn float_op_has_flags(op: String) -> Bool =
  not (op == "pow" || one_of_op(op, ["exp", "log", "log2", "floor", "ceil", "tanh", "negf", "absf",
    "sin", "cos", "tan", "sinh", "cosh", "atan2", "remf"]))

# The rounding mode a unary operation writes after its flags, or `None`.
fn unary_rounding(op: String) -> Option[Int] =
  if op == "sqrt" {
    Some(ROUND_NEAREST_EVEN)
  } else if op == "tanh" {
    Some(ROUND_FULL)
  } else {
    None
  }

fn one_of_op(op: String, names: List[String]) -> Bool = list.any(names, n => n == op)

# Type tags (BytecodeTypeOpcodes.td, frozen).
const TAG_PTR: Int = 12
const TAG_TILE: Int = 13
const TAG_FUNC: Int = 16
const TAG_TOKEN: Int = 17

# Section ids (BytecodeEnums.h).
const SEC_STRING: Int = 1
const SEC_FUNC: Int = 2
const SEC_CONSTANT: Int = 4
const SEC_TYPE: Int = 5

const PAD_BYTE: Int = 0xCB
const FLAG_KERNEL: Int = 0x02

# The tag of a scalar number type by its Tile IR name.
fn num_tag(name: String) -> Int = match name {
  "i1" -> 0
  "i8" -> 1
  "i16" -> 2
  "i32" -> 3
  "i64" -> 4
  "f16" -> 5
  "bf16" -> 6
  "f32" -> 7
  "tf32" -> 8
  "f64" -> 9
  "f8E4M3FN" -> 10
  "f8E5M2" -> 11
  "f8E8M0FNU" -> 18
  _ -> panic("tileir: `${name}` has no Tile IR type tag")
}

# ---- constant payloads
#
# A `constant` names an index into the constant section, and the blob there is
# the raw memory of a DenseElementsAttr of the result's tile type. MLIR's
# raw-buffer contract accepts a SPLAT: one element's bytes stand for every
# lane, which is the only form written here (every constant this package
# emits repeats one host value), except for `i1`, which is bit-packed
# (`int_payload` says why).
#
# There is no float-to-bits primitive in Dawn, so the pattern is assembled
# from exact arithmetic the way std/narrow's `bf16_bits` is: the exponent by
# doublings and halvings, the significand by an exact power-of-two scaling.

# 2^k by exact doublings or halvings, for k within Float's exponent range.
fn pow2(k: Int) -> Float = {
  var q = 1.0
  var i = k
  while i > 0 {
    q = q * 2.0
    i = i - 1
  }
  while i < 0 {
    q = q * 0.5
    i = i + 1
  }
  q
}

# The e with 2^e <= x < 2^(e+1), for a finite positive x.
fn exponent(x: Float) -> Int = {
  var pw = 1.0
  var e = 0
  while x >= pw * 2.0 {
    pw = pw * 2.0
    e = e + 1
  }
  while x < pw {
    pw = pw * 0.5
    e = e - 1
  }
  e
}

## The IEEE pattern of `x` in the binary format with `p` significand bits
## (the hidden bit included) and minimum normal exponent `emin`, as an Int of
## `p + 1 + the exponent width` bits: the sign, the biased exponent, the
## significand. `x` must already be a value of the format (the callers round
## it first); a value above the format's range answers the infinity of its
## sign and NaN answers the canonical quiet NaN.
pub fn ieee_bits(x: Float, p: Int, emin: Int, emax: Int) -> Int = {
  let mant = p - 1
  let bias = 1 - emin
  let all_ones = emax + bias + 1
  if x != x {
    (all_ones << mant) | (1 << (mant - 1))
  } else {
    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)
    let sign_bit = if neg { 1 << (mant + exp_width(all_ones)) } else { 0 }
    let a = if neg { 0.0 - x } else { x }
    let body = if a == 0.0 {
      0
    } else if a == 1.0 / 0.0 {
      all_ones << mant
    } else {
      let e = exponent(a)
      if e > emax {
        all_ones << mant
      } else if e < emin {
        to_int(a / pow2(emin - mant))
      } else {
        ((e + bias) << mant) | to_int((a / pow2(e) - 1.0) * pow2(mant))
      }
    }
    sign_bit | body
  }
}

# The width of the exponent field, from its all-ones value.
fn exp_width(all_ones: Int) -> Int = {
  var w = 0
  var v = all_ones
  while v > 0 {
    v = v >>> 1
    w = w + 1
  }
  w
}

# The raw bytes one lane of `dtype` holds for the float value `value`, and
# how many bytes that is.
fn float_payload(dtype: String, value: Float) -> Bytes = match dtype {
  "f64" -> bytes.freeze(put_le(bytes.buf(), ieee_bits(value, 53, -1022, 1023), 8))
  "f32" -> bytes.freeze(put_le(bytes.buf(), ieee_bits(narrow.round_f32(value), 24, -126, 127), 4))
  "bf16" -> bytes.freeze(put_le(bytes.buf(), narrow.bf16_bits(narrow.round_bf16(value)), 2))
  "f16" -> bytes.freeze(put_le(bytes.buf(), narrow.fp16_bits(narrow.round_fp16(value)), 2))
  _ -> panic("tileir: a float constant of format `${dtype}` has no encoding")
}

# The raw bytes of an integer constant tile of `n` lanes of `dtype`.
fn int_payload(dtype: String, n: Int, value: Int) -> Bytes = match dtype {
  "i32" -> bytes.freeze(put_le(bytes.buf(), value, 4))
  "i16" -> bytes.freeze(put_le(bytes.buf(), value, 2))
  "i8" -> bytes.freeze(put_le(bytes.buf(), value, 1))
  "i64" -> bytes.freeze(put_le(bytes.buf(), value, 8))
  "i1" -> {
    # bit-packed, ceil(n / 8) bytes, every lane the same: the bits past the
    # last lane of the final byte are ignored. The reader of a later Tile IR
    # also takes a ONE-byte splat for a tile of more than eight lanes; the
    # pinned 13.3.36 does not (measured: `failed to validate buffer size and
    # format`), and the packed form is what both accept.
    let byte = if (value & 1) == 1 { 0xFF } else { 0x00 }
    bytes.freeze(list.fold(range(0, (n + 7) / 8), bytes.buf(), (b, _k) => bytes.put(b, byte)))
  }
  _ -> panic("tileir: an integer constant of format `${dtype}` has no encoding")
}

# The lanes of a tile type, for the i1 splat rule; a scalar tile is one lane.
fn lanes_of(t: Ty) -> Int = match t {
  Token -> panic("tileir: a token is not a tile")
  Tile(shape, _elem) -> list.fold(shape, 1, (acc, d) => acc * d)
}

fn elem_name(t: Ty) -> String = match t {
  Token -> panic("tileir: a token has no element format")
  Tile(_shape, e) -> match e {
    Num(nm) -> nm
    PtrTo(nm) -> panic("tileir: a constant of pointers to ${nm} has no encoding")
  }
}

# ---- primitives

## `x`, a 64-bit PATTERN whose top bit may be set, as an LEB128 varint.
## `put_varint` refuses a negative Int because a length, an index and a
## value number never are; a zigzagged float pattern can be.
pub fn put_varint_u64(b: bytes.Buf, x: Int) -> bytes.Buf =
  if x >= 0 && x < 128 {
    bytes.put(b, x)
  } else {
    put_varint_u64(bytes.put(b, (x & 0x7F) | 0x80), x >>> 7)
  }

## The reader's `writeSignedVarInt` encoding: zigzag, so a pattern with its
## sign bit set (every negative float, `-inf` among them) is a short varint
## and not a ten-byte one. The shift is arithmetic, which is what makes the
## mask all ones for a negative value.
pub fn zigzag(x: Int) -> Int = (x << 1) ^ (x >> 63)

# The IEEE pattern of `value` in the named format, and how wide it is.
fn float_bits(dtype: String, value: Float) -> Int = match dtype {
  "f64" -> ieee_bits(value, 53, -1022, 1023)
  "f32" -> ieee_bits(narrow.round_f32(value), 24, -126, 127)
  "bf16" -> narrow.bf16_bits(narrow.round_bf16(value))
  "f16" -> narrow.fp16_bits(narrow.round_fp16(value))
  _ -> panic("tileir: a float identity of format `${dtype}` has no encoding")
}

# An integer identity is written as the reader reads an IntegerAttr: the
# ZERO-EXTENDED value of the format's width, as a plain varint (not zigzag,
# unlike a float's pattern).
fn int_zext(dtype: String, value: Int) -> Int = match dtype {
  "i32" -> value & 0xFFFFFFFF
  "i16" -> value & 0xFFFF
  "i64" -> value
  _ -> panic("tileir: an integer identity of format `${dtype}` has no encoding")
}

## `x` as an unsigned LEB128 varint appended to `b`.
pub fn put_varint(b: bytes.Buf, x: Int) -> bytes.Buf =
  if x < 0 {
    panic("tileir: a varint is unsigned, got ${x}")
  } else if x < 128 {
    bytes.put(b, x)
  } else {
    put_varint(bytes.put(b, (x & 0x7F) | 0x80), x >>> 7)
  }

fn put_le(b: bytes.Buf, x: Int, width: Int) -> bytes.Buf =
  if width == 0 { b } else { put_le(bytes.put(b, x & 0xFF), x >>> 8, width - 1) }

fn pad_to(b: bytes.Buf, align: Int) -> bytes.Buf =
  if bytes.size(b) % align == 0 { b } else { pad_to(bytes.put(b, PAD_BYTE), align) }

fn varint(x: Int) -> Bytes = bytes.freeze(put_varint(bytes.buf(), x))

# ---- interning tables

# An interning table: each distinct encoding once, in first-use order; its
# index is its position.
type Table = {
  items: List[Bytes],
  index: Map[String, Int],
}

fn table() -> Table = Table { items: [], index: map.empty() }

fn intern(t: Table, enc: Bytes) -> (Table, Int) = {
  let key = bytes.to_hex(enc)
  match map.get(t.index, key) {
    Some(i) -> (t, i)
    None -> {
      let i = len(t.items)
      (Table { items: t.items ++ [enc], index: map.insert(t.index, key, i) }, i)
    }
  }
}

# The writer's state: the three tables, the body under construction, the
# index each table value has in the body's index space (the entry
# parameters take 0 to nargs-1 before any of them), and the next free index.
type W = {
  strs: Table,
  types: Table,
  consts: Table,
  body: bytes.Buf,
  index: Map[Int, Int],
  nvals: Int,
}

fn ty_of(w: W, enc: Bytes) -> (W, Int) = {
  let (t, i) = intern(w.types, enc)
  (W { ..w, types: t }, i)
}

fn num_ty(w: W, name: String) -> (W, Int) = ty_of(w, bytes.freeze(bytes.put(bytes.buf(), num_tag(name))))

# Dependent types are registered before the type that names them, as the C++
# writer does; the reader is lazy and would accept either order.
fn elem_ty(w: W, e: Elem) -> (W, Int) = match e {
  Num(name) -> num_ty(w, name)
  PtrTo(name) -> {
    let (w1, pointee) = num_ty(w, name)
    ty_of(w1, bytes.freeze(put_varint(bytes.put(bytes.buf(), TAG_PTR), pointee)))
  }
}

fn ty(w: W, t: Ty) -> (W, Int) = match t {
  Token -> ty_of(w, bytes.freeze(bytes.put(bytes.buf(), TAG_TOKEN)))
  Tile(shape, e) -> {
    let (w1, ei) = elem_ty(w, e)
    let b0 = put_varint(put_varint(bytes.put(bytes.buf(), TAG_TILE), ei), len(shape))
    let b1 = list.fold(shape, b0, (b, d) => put_le(b, d, 8))
    ty_of(w1, bytes.freeze(b1))
  }
}

fn func_ty(w: W, ins: List[Int], outs: List[Int]) -> (W, Int) = {
  let b0 = put_varint(bytes.put(bytes.buf(), TAG_FUNC), len(ins))
  let b1 = list.fold(ins, b0, (b, i) => put_varint(b, i))
  let b2 = put_varint(b1, len(outs))
  let b3 = list.fold(outs, b2, (b, i) => put_varint(b, i))
  ty_of(w, bytes.freeze(b3))
}

fn const_of(w: W, raw: Bytes) -> (W, Int) = {
  let (t, i) = intern(w.consts, bytes.freeze(bytes.put_bytes(put_varint(bytes.buf(), bytes.len(raw)), raw)))
  (W { ..w, consts: t }, i)
}

fn str_of(w: W, s: String) -> (W, Int) = {
  let (t, i) = intern(w.strs, bytes.utf8(s))
  (W { ..w, strs: t }, i)
}

# ---- the body

fn ref_index(w: W, r: Ref) -> Int = match r {
  Arg(pos) -> pos
  Val(id) -> match map.get(w.index, id) {
    Some(i) -> i
    None -> panic("tileir: value ${id} has no bytecode index here; it is not in scope")
  }
}

fn emit(w: W, x: Int) -> W = W { ..w, body: put_varint(w.body, x) }

fn emit_ref(w: W, r: Ref) -> W = emit(w, ref_index(w, r))

# An optional operand: its index when it is there, nothing when it is not.
# The flag bit says which, and the two must agree or the reader takes the
# next byte of the stream for the operand's index.
fn emit_opt_ref(w: W, r: Option[Ref]) -> W = match r {
  Some(x) -> emit_ref(w, x)
  None -> w
}

fn opt_flag(r: Option[Ref], bit: Int) -> Int = match r {
  Some(_x) -> bit
  None -> 0
}

# The next index, given to table value `id`.
fn number(w: W, id: Int) -> W = W { ..w, index: map.insert(w.index, id, w.nvals), nvals: w.nvals + 1 }

fn number_all(w: W, ids: List[Int]) -> W = list.fold(ids, w, number)

# opcode, then one result type index.
# One element of a reduction's `identities` array, self-contained: its tag,
# the index of its ELEMENT type (`f64`, not `tile<128xf64>`) and its
# payload. `tileiras` checks the format against the operand's and refuses a
# mismatch; it does not look at the value (measured), which is why the
# value is a layer-2 claim.
fn identity_attr(w0: W, id: RedId) -> W = match id {
  IdF(dtype, value) -> {
    let (w1, ti) = num_ty(w0, dtype)
    let w2 = emit(emit(w1, ATTR_FLOAT), ti)
    W { ..w2, body: put_varint_u64(w2.body, zigzag(float_bits(dtype, value))) }
  }
  IdI(dtype, value) -> {
    let (w1, ti) = num_ty(w0, dtype)
    emit(emit(emit(w1, ATTR_INTEGER), ti), int_zext(dtype, value))
  }
}

# The reader numbers a block's values from the enclosing count and rolls
# that count BACK when the block ends, so the region-holding operation's own
# results take the indices the body just used (BytecodeWriter.cpp's
# `writeBlock`). This is that roll-back, and `for`, `reduce` and `if` all go
# through it: three copies of one rule would be three places to get it
# wrong, and the mutant that removes it would only reach one of them.
fn roll_back(before: W, after: W) -> W = W { ..after, index: before.index, nvals: before.nvals }

fn emit_op(w: W, opcode: Int, result: Ty) -> W = {
  let (w1, ti) = ty(w, result)
  emit(emit(w1, opcode), ti)
}

# opcode, a RESULT COUNT of one, then the result type index. tblgen's
# `Operator::isVariadic()` is true when any argument OR result is variadic,
# and `generateSimpleResultSerialization` writes the count under it, so an
# operation with one fixed result and a variadic OPERAND list writes the 1
# all the same. `extract` and `join_tokens` are the two of those here.
fn emit_op_counted(w: W, opcode: Int, result: Ty) -> W = {
  let (w1, ti) = ty(w, result)
  emit(emit(emit(w1, opcode), 1), ti)
}

fn encode_instr(w0: W, i: Instr) -> W = match i {
  MakeTok(_dst) -> emit_op(w0, OP_MAKE_TOKEN, Token)
  BlockIds(_x, _y, _z) -> {
    let (w1, ti) = ty(w0, Tile([], Num("i32")))
    emit(emit(emit(emit(w1, OP_GET_TILE_BLOCK_ID), ti), ti), ti)
  }
  ConstInt(_dst, t, value) -> {
    let w1 = emit_op(w0, OP_CONSTANT, t)
    let (w2, ci) = const_of(w1, int_payload(elem_name(t), lanes_of(t), value))
    emit(w2, ci)
  }
  ConstFloat(_dst, t, value) -> {
    let w1 = emit_op(w0, OP_CONSTANT, t)
    let (w2, ci) = const_of(w1, float_payload(elem_name(t), value))
    emit(w2, ci)
  }
  MulInt(_dst, t, lhs, rhs) -> emit_ref(emit_ref(emit(emit_op(w0, OP_MULI, t), 0), lhs), rhs)
  AddInt(_dst, t, lhs, rhs) -> emit_ref(emit_ref(emit(emit_op(w0, OP_ADDI, t), 0), lhs), rhs)
  Reshape(_dst, src, _from, to) -> emit_ref(emit_op(w0, OP_RESHAPE, to), src)
  Broadcast(_dst, src, _from, to) -> emit_ref(emit_op(w0, OP_BROADCAST, to), src)
  IotaTile(_dst, t) -> emit_op(w0, OP_IOTA, t)
  Offset(_dst, ptrs, offs, ptr_ty, _off_ty) -> emit_ref(emit_ref(emit_op(w0, OP_OFFSET, ptr_ty), ptrs), offs)
  LoadPtr(_dst, _tok_out, ptrs, mask, pad, tok_in, _ptr_ty, _mask_ty, val_ty) -> {
    # results: the tile, the token; flags: which of the optional operands
    # follow; memory_ordering_semantics weak; operands: source, then the
    # mask, the padding value and the token, each present exactly when its
    # flag bit is set.
    let w1 = emit_op(w0, OP_LOAD_PTR_TKO, val_ty)
    let (w2, tok) = ty(w1, Token)
    let flags = LOAD_FLAG_TOKEN | opt_flag(mask, LOAD_FLAG_MASK) | opt_flag(pad, LOAD_FLAG_PAD)
    let w3 = emit(emit(emit(w2, tok), flags), ORDER_WEAK)
    emit_ref(emit_opt_ref(emit_opt_ref(emit_ref(w3, ptrs), mask), pad), tok_in)
  }
  StorePtr(_tok_out, ptrs, value, mask, tok_in, _ptr_ty, _mask_ty, _val_ty) -> {
    # result: the token; flags: the mask when there is one, the token;
    # weak; operands: destination, value, mask, token.
    let flags = STORE_FLAG_TOKEN | opt_flag(mask, STORE_FLAG_MASK)
    let w1 = emit(emit(emit_op(w0, OP_STORE_PTR_TKO, Token), flags), ORDER_WEAK)
    emit_ref(emit_opt_ref(emit_ref(emit_ref(w1, ptrs), value), mask), tok_in)
  }
  AtomicRMWPtr(_dst, _tok_out, ptrs, mode, arg, mask, tok_in, _ptr_ty, _mask_ty, val_ty) -> {
    # results: the old value, the token; flags: which optional operands
    # follow; then the three REQUIRED attributes in declaration order
    # (`memory_ordering_semantics`, `memory_scope`, `mode`) -- none of them
    # is an `OptionalAttr`, so each is written inline (knife 10's rule);
    # then the operands: the pointers, the argument, the mask and the
    # token, each present exactly when its flag bit is set.
    let w1 = emit_op(w0, OP_ATOMIC_RMW_TKO, val_ty)
    let (w2, tok) = ty(w1, Token)
    let flags = ATOMIC_FLAG_TOKEN | opt_flag(mask, ATOMIC_FLAG_MASK)
    let w3 = emit(emit(emit(emit(emit(w2, tok), flags), ORDER_RELAXED), SCOPE_DEVICE), rmw_mode_value(mode))
    emit_ref(emit_opt_ref(emit_ref(emit_ref(w3, ptrs), arg), mask), tok_in)
  }
  AtomicCASPtr(_dst, _tok_out, ptrs, cmp, val, mask, tok_in, _ptr_ty, _mask_ty, val_ty) -> {
    # the same shape with two attributes rather than three -- a
    # compare-and-swap has no mode -- and three tile operands rather than
    # two. A `mode` byte written here as well would be the copy of the
    # block above that the reader cannot survive, which is the layer-1
    # mutant atomic-cas-writes-an-rmw-mode.
    let w1 = emit_op(w0, OP_ATOMIC_CAS_TKO, val_ty)
    let (w2, tok) = ty(w1, Token)
    let flags = ATOMIC_FLAG_TOKEN | opt_flag(mask, ATOMIC_FLAG_MASK)
    let w3 = emit(emit(emit(emit(w2, tok), flags), ORDER_RELAXED), SCOPE_DEVICE)
    emit_ref(emit_opt_ref(emit_ref(emit_ref(emit_ref(w3, ptrs), cmp), val), mask), tok_in)
  }
  FloatUn(_dst, op, t, src) -> {
    # flags where the operation has an optional field (never set here), then
    # the rounding mode where it has a required one
    let w1 = emit_op(w0, float_op(op), t)
    let w2 = if float_op_has_flags(op) { emit(w1, 0) } else { w1 }
    let w3 = match unary_rounding(op) {
      Some(mode) -> emit(w2, mode)
      None -> w2
    }
    emit_ref(w3, src)
  }
  FloatBin(_dst, op, t, lhs, rhs) -> {
    # flags: neither flush_to_zero nor propagate_nan, both unit attributes
    # and so bits with no payload; then the rounding mode, on the four
    # operations that take one. `pow` has neither.
    let w1 = if float_op_has_flags(op) { emit(emit_op(w0, float_op(op), t), 0) } else { emit_op(w0, float_op(op), t) }
    let w2 = if float_op_rounds(op) { emit(w1, ROUND_NEAREST_EVEN) } else { w1 }
    emit_ref(emit_ref(w2, lhs), rhs)
  }
  FloatFma(_dst, t, lhs, rhs, acc) -> {
    let w1 = emit(emit(emit_op(w0, OP_FMA, t), 0), ROUND_NEAREST_EVEN)
    emit_ref(emit_ref(emit_ref(w1, lhs), rhs), acc)
  }
  IntMma(_dst, t, _lhs_ty, _rhs_ty, lhs, rhs, acc) -> {
    # the result type (which is the accumulator's i32 tile), then the two
    # REQUIRED signedness attributes in declaration order (`signedness_lhs`,
    # `signedness_rhs`, both 13.1 and neither optional), then the three
    # operands. `mmai` has no optional field at any version, so there is no
    # flags varint here at all -- and unlike `ftof` above, a spurious one
    # would be VISIBLE, because the two attributes would shift.
    let w1 = emit(emit(emit_op(w0, OP_MMAI, t), SIGNED), SIGNED)
    emit_ref(emit_ref(emit_ref(w1, lhs), rhs), acc)
  }
  FloatMma(_dst, t, _lhs_ty, _rhs_ty, lhs, rhs, acc) -> {
    # the result type (which is the accumulator's), then the three
    # operands. `fast_acc` is `mmaf`'s one optional field and it arrived in
    # 13.3, so at 13.2 there is NO flags varint: a reader of this version
    # would take the next byte for the first operand.
    emit_ref(emit_ref(emit_ref(emit_op(w0, OP_MMAF, t), lhs), rhs), acc)
  }
  CmpFloat(_dst, pred, _t, res_ty, lhs, rhs) -> {
    # the result is the i1 tile; the predicate and the ordering are required
    # enum attributes, so they are read inline and there is no flags field.
    let w1 = emit(emit(emit_op(w0, OP_CMPF, res_ty), predicate_value(pred)), CMP_ORDERED)
    emit_ref(emit_ref(w1, lhs), rhs)
  }
  CmpInt(_dst, pred, _t, res_ty, lhs, rhs) -> {
    let w1 = emit(emit(emit_op(w0, OP_CMPI, res_ty), predicate_value(pred)), SIGNED)
    emit_ref(emit_ref(w1, lhs), rhs)
  }
  IntUn(_dst, op, t, src) -> {
    # no operation here has an optional field, so no flags varint: the
    # attributes follow the result type directly.
    emit_ref(list.fold(int_attrs(op), emit_op(w0, int_op(op), t), emit), src)
  }
  IntBin(_dst, op, t, lhs, rhs) -> {
    let w1 = list.fold(int_attrs(op), emit_op(w0, int_op(op), t), emit)
    emit_ref(emit_ref(w1, lhs), rhs)
  }
  Cast(_dst, op, _from, to, src) -> {
    # the result is the TARGET type, then the attributes, then the operand.
    emit_ref(list.fold(cast_attrs(op, elem_name(to)), emit_op(w0, cast_op(op), to), emit), src)
  }
  SelectTile(_dst, _cond_ty, t, cond, lhs, rhs) ->
    emit_ref(emit_ref(emit_ref(emit_op(w0, OP_SELECT, t), cond), lhs), rhs)
  ForLoop(_results, tys, iv, lower, upper, step, inits, carried, body) -> {
    # results: their count, then a type each; flags: `unsigned` absent
    # (13.2 and later know the field); operands: their count, then the
    # bounds, the step and the initial values; one region of one block
    # whose arguments are the induction variable (i32) and the carried
    # values, then the body's instructions.
    let w1 = emit(emit(w0, OP_FOR), len(tys))
    let w2 = list.fold(tys, w1, (w, t) => {
      let (wt, ti) = ty(w, t)
      emit(wt, ti)
    })
    let w3 = if for_has_flags() { emit(w2, 0) } else { w2 }
    let w4 = list.fold([lower, upper, step] ++ inits, emit(w3, 3 + len(inits)), emit_ref)
    let w5 = emit(emit(emit(w4, 1), 1), 1 + len(carried))
    let (w6, i32i) = ty(w5, Tile([], Num("i32")))
    let w7 = list.fold(tys, emit(w6, i32i), (w, t) => {
      let (wt, ti) = ty(w, t)
      emit(wt, ti)
    })
    let w8 = number_all(number(w7, iv), carried)
    let w9 = list.fold(body, emit(w8, len(body)), instr)
    # the block is over: its indices roll back, the loop's results take them
    roll_back(w7, w9)
  }
  ReduceTile(_results, tys, dim, identities, operands, operand_tys, args, body) -> {
    # results: their count, then a type each; no flags (a reduction has no
    # optional field); attributes in declaration order: `dim` inline, then
    # the `identities` array as its length and one self-contained attribute
    # each; operands: their count, then the tiles; one region of one block
    # whose arguments are the accumulator and the element of each operand,
    # in operand order.
    let w1 = emit(emit(w0, OP_REDUCE), len(tys))
    let w2 = list.fold(tys, w1, (w, t) => {
      let (wt, ti) = ty(w, t)
      emit(wt, ti)
    })
    let w3 = emit(emit(w2, dim), len(identities))
    let w4 = list.fold(identities, w3, identity_attr)
    let w5 = list.fold(operands, emit(w4, len(operands)), emit_ref)
    let w6 = emit(emit(emit(w5, 1), 1), len(args))
    let w7 = list.fold(range(0, len(args)), w6, (w, k) => {
      # the block arguments are RANK-0 whatever the operands' rank is; only
      # the results lose the reduced dimension
      let (wt, ti) = ty(w, rank0_of(operand_tys[k / 2]))
      emit(wt, ti)
    })
    let w8 = number_all(w7, args)
    let w9 = list.fold(body, emit(w8, len(body)), instr)
    # the block is over: its indices roll back, the results take them
    roll_back(w7, w9)
  }
  ScanTile(_results, tys, dim, reverse, identities, operands, operand_tys, args, body) -> {
    # `reduce`'s layout with one attribute more. The arguments are declared
    # `operands`, `dim`, `reverse`, `identities`, so the attributes go out
    # in that order: `dim` inline, then `reverse` as ONE BYTE (0 or 1: the
    # writer's bool path is writeByte, not an enum's varint), then the
    # identities array. `reverse` is a plain BoolAttr, not an
    # `OptionalAttr`, so it takes no flags bit and the operation writes no
    # flags varint, by knife 10's judgement.
    let w1 = emit(emit(w0, OP_SCAN), len(tys))
    let w2 = list.fold(tys, w1, (w, t) => {
      let (wt, ti) = ty(w, t)
      emit(wt, ti)
    })
    let w3 = emit(emit(emit(w2, dim), if reverse { 1 } else { 0 }), len(identities))
    let w4 = list.fold(identities, w3, identity_attr)
    let w5 = list.fold(operands, emit(w4, len(operands)), emit_ref)
    let w6 = emit(emit(emit(w5, 1), 1), len(args))
    let w7 = list.fold(range(0, len(args)), w6, (w, k) => {
      # rank-0 block arguments, as a reduction's are
      let (wt, ti) = ty(w, rank0_of(operand_tys[k / 2]))
      emit(wt, ti)
    })
    let w8 = number_all(w7, args)
    let w9 = list.fold(body, emit(w8, len(body)), instr)
    roll_back(w7, w9)
  }
  IfElse(_results, tys, cond, _cond_ty, on_true, on_false) -> {
    # results, then the condition, then TWO regions: the reader counts them
    # and refuses one or three (measured). Neither takes block arguments.
    let w1 = emit(emit(w0, OP_IF), len(tys))
    let w2 = list.fold(tys, w1, (w, t) => {
      let (wt, ti) = ty(w, t)
      emit(wt, ti)
    })
    let w3 = emit(emit_ref(w2, cond), 2)
    region(region(w3, on_true), on_false)
  }
  WhileLoop(_results, tys, inits, carried, body) -> {
    # `loop` has no induction variable, no bounds and NO FLAGS: it carries
    # no optional attribute and no optional operand, so tblgen writes no
    # flags varint for it (`getVersionOrderedBitAssignments` is empty and
    # `generateFlagsFieldSerialization` returns before writing one). That is
    # the one place its layout differs from `for`'s beyond the missing
    # operands: results, their types, the operand count and the initial
    # values, one region of one block whose arguments are the carried
    # values, then the body.
    let wl0 = emit(emit(w0, OP_LOOP), len(tys))
    let wl1 = list.fold(tys, wl0, (w, t) => {
      let (wt, ti) = ty(w, t)
      emit(wt, ti)
    })
    let wl2 = list.fold(inits, emit(wl1, len(inits)), emit_ref)
    let wl3 = emit(emit(emit(wl2, 1), 1), len(carried))
    let w_block = list.fold(tys, wl3, (w, t) => {
      let (wt, ti) = ty(w, t)
      emit(wt, ti)
    })
    let w_args = number_all(w_block, carried)
    let w_body = list.fold(body, emit(w_args, len(body)), instr)
    # the block is over: its indices roll back, the loop's results take them
    roll_back(w_block, w_body)
  }
  BreakVals(values, _tys) -> list.fold(values, emit(emit(emit(w0, OP_BREAK), 0), len(values)), emit_ref)
  YieldVals(values, _tys) -> list.fold(values, emit(emit(emit(w0, OP_YIELD), 0), len(values)), emit_ref)
  Cont(values, _tys) -> list.fold(values, emit(emit(emit(w0, OP_CONTINUE), 0), len(values)), emit_ref)
  ExtractTile(_dst, src, _from, to, indices) -> {
    # A RESULT COUNT first. tblgen's `Operator::isVariadic()` is true when
    # ANY argument or result is variadic, and `generateSimpleResultSerialization`
    # writes the result count under it -- so an operation with one fixed
    # result and a variadic OPERAND list still writes the 1. Measured:
    # without it `tileiras` answers `error at offset 98: failed to get
    # result type 10 for ExtractOp`, having taken the type index for the
    # count. `join_tokens` is the same shape and was the same measurement.
    #
    # Then NO attributes -- the slice numbers are OPERANDS (rank-0 i32
    # tiles) -- and the operand count, which counts the source as well, so
    # it is one more than there are indices.
    let w1 = emit(emit_op_counted(w0, OP_EXTRACT, to), 1 + len(indices))
    list.fold(indices, emit_ref(w1, src), emit_ref)
  }
  CatTile(_dst, dim, lhs, rhs, _lhs_ty, _rhs_ty, to) -> {
    # `dim` is an `I64Attr`, so it is a plain inline varint: the generated
    # reader is given the width by tablegen and does not read a type index,
    # and the value is unsigned (`parseScalarAttributeInline`). Two required
    # operands and no variadic one, so no operand count either.
    emit_ref(emit_ref(emit(emit_op(w0, OP_CAT, to), dim), lhs), rhs)
  }
  PermuteTile(_dst, src, perm, _from, to) -> {
    let w1 = emit_i32_array(emit_op(w0, OP_PERMUTE, to), perm)
    emit_ref(w1, src)
  }
  JoinTokens(_dst, toks) -> {
    # the result count (1: see `extract` above -- the variadic operands are
    # what make this operation write one), the token result type, then the
    # operand count and the tokens. The verifier wants two or more.
    let w1 = emit(emit_op_counted(w0, OP_JOIN_TOKENS, Token), len(toks))
    list.fold(toks, w1, emit_ref)
  }
  BlockCounts(_x, _y, _z) -> {
    # `get_num_tile_blocks` has exactly `get_tile_block_id`'s shape: three
    # rank-0 i32 results, no operands, no attributes and no flags. The
    # OPCODE is the whole difference, which is what the mutant
    # num-tile-blocks-as-block-id measures on the device.
    let (w1, ti) = ty(w0, Tile([], Num("i32")))
    emit(emit(emit(emit(w1, OP_GET_NUM_TILE_BLOCKS), ti), ti), ti)
  }
  PtrToIntTile(_dst, src, _from, to) -> emit_ref(emit_op(w0, OP_PTR_TO_INT, to), src)
  IntToPtrTile(_dst, src, _from, to) -> emit_ref(emit_op(w0, OP_INT_TO_PTR, to), src)
  PtrToPtrTile(_dst, src, _from, to) -> emit_ref(emit_op(w0, OP_PTR_TO_PTR, to), src)
  Ret -> emit(emit(emit(w0, OP_RETURN), 0), 0)
}

# One region of one block with no arguments: the block's values take the
# next indices and roll back when it ends, as the reader numbers them.
fn region(w0: W, body: List[Instr]) -> W = {
  let w1 = emit(emit(w0, 1), 0)
  let w2 = list.fold(body, emit(w1, len(body)), instr)
  roll_back(w0, w2)
}

# `for` gained its optional `unsigned` field in 13.2, so from that version on
# the writer emits its flags varint and a 13.1 reader would not expect one.
fn for_has_flags() -> Bool = BYTECODE_MAJOR > 13 || (BYTECODE_MAJOR == 13 && BYTECODE_MINOR >= 2)

# Write one instruction, then give its results the next indices. A `ForLoop`
# numbers its block arguments and body inside `encode_instr` and rolls them
# back; its results are numbered here, after, as the reader will number them.
fn instr(w: W, i: Instr) -> W = number_all(encode_instr(w, i), defines(i))

# ---- the file

fn section(out: bytes.Buf, id: Int, content: Bytes, align: Int) -> bytes.Buf = {
  let o1 = put_varint(bytes.put(out, if align > 1 { id | 0x80 } else { id }), bytes.len(content))
  let o2 = if align > 1 { pad_to(put_varint(o1, align), align) } else { o1 }
  bytes.put_bytes(o2, content)
}

# count, padding to the index width, one offset per item, the items.
fn table_section(items: List[Bytes], width: Int) -> Bytes = {
  let b0 = pad_to(put_varint(bytes.buf(), len(items)), width)
  let (b1, _end) = list.fold(items, (b0, 0), (acc, it) => {
    let (b, off) = acc
    (put_le(b, off, width), off + bytes.len(it))
  })
  bytes.freeze(list.fold(items, b1, (b, it) => bytes.put_bytes(b, it)))
}

fn magic() -> bytes.Buf = bytes.put(bytes.put(bytes.put(bytes.put(bytes.put(bytes.put(bytes.put(bytes.put(bytes.buf(), 0x7F), 0x54), 0x69), 0x6C), 0x65), 0x49), 0x52), 0x00)

## `k` as a bytecode file holding one kernel entry.
pub fn encode_kernel(k: Kernel) -> Bytes = {
  var w = W { strs: table(), types: table(), consts: table(), body: bytes.buf(), index: map.empty(), nvals: len(k.params) }
  var params: List[Int] = []
  for dt in k.params {
    let (w1, pi) = ty(w, Tile([], PtrTo(dt)))
    w = w1
    params = params ++ [pi]
  }
  let (w2, sig) = func_ty(w, params, [])
  let (w3, name) = str_of(w2, k.name)
  w = w3
  for i in k.body {
    w = instr(w, i)
  }
  let body = bytes.freeze(w.body)
  let func = bytes.freeze(bytes.put_bytes(
    put_varint(put_varint(bytes.put(put_varint(put_varint(put_varint(bytes.buf(), 1), name), sig), FLAG_KERNEL), 0), bytes.len(body)),
    body))

  let h = put_le(bytes.put(bytes.put(magic(), BYTECODE_MAJOR), BYTECODE_MINOR), 0, 2)
  let s1 = section(h, SEC_FUNC, func, 8)
  let s2 = if len(w.consts.items) == 0 { s1 } else { section(s1, SEC_CONSTANT, table_section(w.consts.items, 8), 8) }
  let s3 = section(s2, SEC_TYPE, table_section(w.types.items, 4), 4)
  let s4 = section(s3, SEC_STRING, table_section(w.strs.items, 4), 4)
  bytes.freeze(bytes.put(s4, 0))
}

## `prog` lowered and encoded.
pub fn encode(prog: TileProg) -> Bytes = encode_kernel(lower(prog))

# ---- tests ----
#
# The pin on the whole file is scripts/tile-golden (both backends against the
# recorded .tilebc, then `tileiras`). These blocks pin the pieces a rejected
# file would not name: the varint, the section framing, the interning, and
# that the header carries the version constant.

fn hex(b: Bytes) -> String = bytes.to_hex(b)

test "varints are LEB128: seven bits a byte, low bits first, high bit continues" {
  assert hex(varint(0)) == "00"
  assert hex(varint(127)) == "7f"
  assert hex(varint(128)) == "8001"
  assert hex(varint(300)) == "ac02"
  assert hex(varint(16384)) == "808001"
}

test "an unaligned section is id, length, data; an aligned one sets bit 7 and pads from the file start" {
  let one = bytes.freeze(bytes.put(bytes.buf(), 0x2A))
  assert hex(bytes.freeze(section(bytes.buf(), 7, one, 1))) == "07012a"
  # header is 3 bytes (id, length, alignment) so one pad byte reaches 4.
  assert hex(bytes.freeze(section(bytes.buf(), 5, one, 4))) == "850104cb2a"
}

test "a table section counts, pads to its index width, then offsets, then data" {
  let items = [bytes.freeze(bytes.put(bytes.buf(), 0xAA)), bytes.freeze(bytes.put(bytes.put(bytes.buf(), 0xBB), 0xCC))]
  # count 2, pad to 4, offsets 0 and 1 as u32, data.
  assert hex(table_section(items, 4)) == "02cbcbcb" ++ "00000000" ++ "01000000" ++ "aa" ++ "bbcc"
}

test "interning answers one index per distinct encoding, in first-use order" {
  let t0 = table()
  let (t1, a) = intern(t0, bytes.freeze(bytes.put(bytes.buf(), 1)))
  let (t2, b) = intern(t1, bytes.freeze(bytes.put(bytes.buf(), 2)))
  let (t3, c) = intern(t2, bytes.freeze(bytes.put(bytes.buf(), 1)))
  assert [a, b, c] == [0, 1, 0]
  assert len(t3.items) == 2
}

test "a float constant's blob is the IEEE pattern of one lane, low byte first" {
  # 1.0 = 0x3FF0000000000000, -2.0 = 0xC000000000000000, the smallest
  # subnormal = 0x0000000000000001, and -0.0 is the sign bit alone.
  assert hex(float_payload("f64", 1.0)) == "000000000000f03f"
  assert hex(float_payload("f64", 0.0 - 2.0)) == "00000000000000c0"
  assert hex(float_payload("f64", 0.0)) == "0000000000000000"
  assert hex(float_payload("f64", 0.0 * (0.0 - 1.0))) == "0000000000000080"
  assert hex(float_payload("f64", 1.0 / 0.0)) == "000000000000f07f"
  assert hex(float_payload("f32", 1.0)) == "0000803f"
  assert hex(float_payload("bf16", 1.0)) == "803f"
}

test "ieee_bits is the pattern of the value in the named format" {
  assert ieee_bits(1.0, 53, -1022, 1023) == 0x3FF0000000000000
  assert ieee_bits(0.5, 53, -1022, 1023) == 0x3FE0000000000000
  assert ieee_bits(0.0, 53, -1022, 1023) == 0
  # the smallest subnormal double, 2^-1074, and the largest finite one
  assert ieee_bits(4.9e-324, 53, -1022, 1023) == 1
  assert ieee_bits(1.7976931348623157e308, 53, -1022, 1023) == 0x7FEFFFFFFFFFFFFF
  # a NaN is the canonical quiet one; an out-of-range value the infinity
  assert ieee_bits(0.0 / 0.0, 53, -1022, 1023) == 0x7FF8000000000000
  assert ieee_bits(1.0e300, 24, -126, 127) == 0x7F800000
  assert ieee_bits(1.0, 8, -126, 127) == 0x3F80
}

test "an i1 constant is bit-packed, one bit a lane, and an i32 one is four bytes" {
  # 128 lanes of true is sixteen 0xFF bytes; the pinned tileiras refuses the
  # one-byte splat a later reader accepts (measured), so the packed form is
  # the one written.
  assert hex(int_payload("i1", 128, 1)) == str.repeat("ff", 16)
  assert hex(int_payload("i1", 128, 0)) == str.repeat("00", 16)
  assert hex(int_payload("i1", 8, 1)) == "ff"
  assert hex(int_payload("i32", 128, 1000)) == "e8030000"
  assert hex(int_payload("i32", 1, 0 - 1)) == "ffffffff"
}

test "a tile type names its element type first, so the element's index is lower" {
  let w0 = W { strs: table(), types: table(), consts: table(), body: bytes.buf(), index: map.empty(), nvals: 0 }
  let (w1, ti) = ty(w0, Tile([128], PtrTo("f64")))
  # f64 (tag 9), ptr<f64>, tile<128xptr<f64>>: three types, the tile last.
  assert ti == 2
  assert list.map(w1.types.items, hex) == ["09", "0c00", "0d01018000000000000000"]
}

fn vadd() -> TileProg = TileProg {
  name: "vadd",
  params: ["f64", "f64", "f64"],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 128),
    IdxMul(3, 1, 2),
    Load(4, 5, 0, "f64", 3, [128], [1], None, None, 0),
    Load(6, 7, 1, "f64", 3, [128], [1], None, None, 5),
    BinaryF(8, "addf", "f64", [128], 4, 6),
    Store(9, 2, "f64", 3, [128], [1], 8, None, 7)
  ]
}

test "the file opens with the magic and the version constants, and closes with the end section" {
  let b = encode(vadd())
  assert hex(bytes.slice(b, 0, 12)) == "7f54696c65495200" ++ "0d02" ++ "0000"
  assert bytes.at(b, bytes.len(b) - 1) == 0
  assert bytecode_version() == "13.2"
}

test "the function entry is a kernel with an unknown location and the entry name is the one string" {
  let b = encode(vadd())
  # After the 12-byte header: Func section id with the aligned bit, length,
  # alignment 8, three pad bytes to offset 16, then count 1, name 0, sig, flags 2, loc 0.
  assert hex(bytes.slice(b, 12, 16)) == "82" ++ hex(bytes.slice(b, 13, 14)) ++ "08cb"
  assert hex(bytes.slice(b, 16, 20)) == "0100" ++ hex(bytes.slice(b, 18, 19)) ++ "02"
  assert bytes.at(b, 20) == 0
  assert str.ends_with(hex(b), hex(bytes.utf8("vadd")) ++ "00")
}

test "encoding the same program twice gives the same bytes" {
  assert encode(vadd()) == encode(vadd())
}

fn sum_prog() -> TileProg = TileProg {
  name: "sum",
  params: ["f64", "f64"],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 4),
    IdxMul(3, 1, 2),
    IdxConst(4, 128),
    IdxMul(5, 3, 4),
    Load(6, 7, 0, "f64", 5, [128], [1], None, None, 0),
    IdxConst(8, 1),
    IdxAdd(9, 3, 8),
    IdxAdd(10, 3, 2),
    For(11, 9, 10, 8, [6, 7], [12, 13], [19, 20], [
      IdxConst(14, 128),
      IdxMul(15, 11, 14),
      Load(16, 17, 0, "f64", 15, [128], [1], None, None, 13),
      BinaryF(18, "addf", "f64", [128], 12, 16),
      Continue([18, 17])
    ]),
    IdxConst(21, 128),
    IdxMul(22, 1, 21),
    Store(23, 1, "f64", 22, [128], [1], 19, None, 20)
  ]
}

# The bytecode of `k.body` alone, and the writer after it.
fn body_of(k: Kernel) -> (W, String) = {
  var w = W { strs: table(), types: table(), consts: table(), body: bytes.buf(), index: map.empty(), nvals: len(k.params) }
  for i in k.body {
    w = instr(w, i)
  }
  (w, hex(bytes.freeze(w.body)))
}

test "a loop's block arguments take the indices after the values before it, and its results take those same indices once the block ends" {
  let k = lower(sum_prog())
  let (w, _b) = body_of(k)
  # 2 parameters, then table values 0..19 at indices 2..21; the results
  # %20 and %21 are numbered after the body rolled back: 22 and 23, the
  # indices the induction variable %22 and the carried %23 took inside.
  # The body's values are out of scope afterwards and have no index; the
  # continue inside named %36 and %35 by the indices they had there, 36 and
  # 35, which is what the bytes say.
  assert map.get(w.index, 19) == Some(21)
  assert map.get(w.index, 20) == Some(22)
  assert map.get(w.index, 21) == Some(23)
  assert map.get(w.index, 37) == Some(24)
  assert not map.has(w.index, 22)
  assert not map.has(w.index, 36)
  let (w2, whole) = body_of(k)
  assert w2.nvals == w.nvals
  assert str.contains(whole, hex(bytes.freeze(put_varint(put_varint(put_varint(put_varint(put_varint(bytes.buf(), OP_CONTINUE), 0), 2), 36), 35))))
}

test "a for is its opcode, result count and types, the flags, the operand count and operands, then one region of one block" {
  let k = lower(sum_prog())
  let (_w, whole) = body_of(k)
  # opcode 0x29, 2 results, types (t0 = tile<128xf64>, t1 = token: whatever
  # indices they got), flags 0, 5 operands: %18 %19 %17 %15 %16 at indices
  # 20 21 19 17 18, then 1 region, 1 block, 3 args.
  let head = bytes.freeze(put_varint(bytes.buf(), OP_FOR))
  assert str.contains(whole, hex(head))
  let tail = bytes.freeze(put_varint(put_varint(put_varint(put_varint(put_varint(put_varint(put_varint(put_varint(put_varint(bytes.buf(), 0), 5), 20), 21), 19), 17), 18), 1), 1))
  assert str.contains(whole, hex(tail) ++ "03")
  assert bytecode_version() == "13.2"
  assert for_has_flags()
}

test "zigzag is the reader's signed varint, and a pattern with its top bit set still encodes" {
  # the encoding the reader's writeSignedVarInt performs:
  # (v << 1) ^ (int64(v) >> 63)
  assert zigzag(0) == 0
  assert zigzag(1) == 2
  assert zigzag(0 - 1) == 1
  assert zigzag(0 - 2) == 3
  # 1.0 is 0x3FF0000000000000, a positive pattern: a plain doubling
  assert zigzag(0x3FF0000000000000) == 0x7FE0000000000000
  # -inf is 0xFFF0000000000000, which as an Int is negative
  assert zigzag(ieee_bits(0.0 - 1.0 / 0.0, 53, 0 - 1022, 1023)) == 0x001FFFFFFFFFFFFF
  # -0.0's pattern is the smallest Int, and its zigzag has the top bit set:
  # this is the case put_varint refuses and put_varint_u64 exists for
  assert zigzag(ieee_bits(0.0 * (0.0 - 1.0), 53, 0 - 1022, 1023)) < 0
  assert hex(bytes.freeze(put_varint_u64(bytes.buf(), 0 - 1))) == str.repeat("ff", 9) ++ "01"
  assert hex(bytes.freeze(put_varint_u64(bytes.buf(), 300))) == "ac02"
}

test "a reduction identity is a self-contained attribute: its tag, the index of its ELEMENT type, its payload" {
  let w0 = W { strs: table(), types: table(), consts: table(), body: bytes.buf(), index: map.empty(), nvals: 0 }
  # a float identity: tag 2, the f64 type index, the zigzagged pattern
  let w1 = identity_attr(w0, IdF("f64", 0.0))
  assert hex(bytes.freeze(w1.body)) == "0200" ++ "00"
  assert list.map(w1.types.items, hex) == ["09"]
  # -inf, the identity of a maximum: the same tag and type, a longer payload
  let w2 = identity_attr(w0, IdF("f64", 0.0 - 1.0 / 0.0))
  assert hex(bytes.freeze(w2.body)) == "0200" ++ hex(bytes.freeze(put_varint_u64(bytes.buf(), 0x001FFFFFFFFFFFFF)))
  # an integer identity: tag 1, the i32 type index, the ZERO-EXTENDED value
  # as a plain varint, not a zigzagged one
  let w3 = identity_attr(w0, IdI("i32", 0 - 1))
  assert hex(bytes.freeze(w3.body)) == "0100" ++ hex(bytes.freeze(put_varint(bytes.buf(), 0xFFFFFFFF)))
  assert list.map(w3.types.items, hex) == ["03"]
}

fn total_prog() -> TileProg = TileProg {
  name: "total",
  params: ["f64", "f64"],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 8),
    IdxMul(3, 1, 2),
    Load(4, 5, 0, "f64", 3, [8], [1], None, None, 0),
    Reduce([9], 0, [8], [IdF("f64", 0.0)], [4], [6, 7], [
      BinaryF(8, "addf", "f64", [], 6, 7),
      Yield([8])
    ]),
    Spread(10, "f64", [1], 9),
    Store(11, 1, "f64", 3, [1], [1], 10, None, 5)
  ]
}

test "a reduce is its opcode, result count and types, dim, the identities array, the operands and one region" {
  let k = lower(total_prog())
  let (w, whole) = body_of(k)
  # opcode 0x58, 1 result, the rank-0 f64 type index, dim 0, 1 identity
  # (tag 2, the f64 element type index, payload 0), 1 operand at index 15
  # (2 parameters and 13 values before it), then 1 region, 1 block, 2 args.
  # There is NO flags field: a reduction has no optional attribute or
  # operand, and the reader would take the next byte for `dim` if one were
  # written (measured through tileiras).
  # the type indices are the writer's own; interning is idempotent, so
  # asking the finished table for them answers what the encoder used
  let (w1, rank0) = ty(w, Tile([], Num("f64")))
  let (_w2, elem) = num_ty(w1, "f64")
  let expect = list.fold(
    [OP_REDUCE, 1, rank0, 0, 1, ATTR_FLOAT, elem, 0, 1, 15, 1, 1, 2, rank0, rank0, 2],
    bytes.buf(), put_varint)
  assert str.contains(whole, hex(bytes.freeze(expect)))
  # the region's two block arguments take the next indices and roll back,
  # so the reduction's own result takes the first of them
  assert map.get(w.index, 15) == Some(17)
  assert not map.has(w.index, 16)
  assert not map.has(w.index, 17)
}

fn branch_prog() -> TileProg = TileProg {
  name: "branch",
  params: ["f64", "f64"],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 8),
    IdxMul(3, 1, 2),
    Load(4, 5, 0, "f64", 3, [8], [1], None, None, 0),
    IdxConst(6, 0),
    CmpI(7, "eq", [], 1, 6),
    If([10], 7, [BinaryF(8, "addf", "f64", [8], 4, 4), Yield([8])],
      [BinaryF(9, "mulf", "f64", [8], 4, 4), Yield([9])]),
    Store(11, 1, "f64", 3, [8], [1], 10, None, 5)
  ]
}

test "an if is its opcode, result count and types, the condition, then TWO regions whose blocks take the same indices" {
  let k = lower(branch_prog())
  let (w, whole) = body_of(k)
  # opcode 0x32, 1 result, the tile<8xf64> type index, the condition's
  # index (18: 2 parameters and 16 values), then 2 regions, each one block
  # of no arguments and two operations
  let (_w1, f64v) = ty(w, Tile([8], Num("f64")))
  let expect = list.fold([OP_IF, 1, f64v, 18, 2, 1, 0, 2], bytes.buf(), put_varint)
  assert str.contains(whole, hex(bytes.freeze(expect)))
  # both branches numbered their addf and mulf at the same index and rolled
  # back, so the if's own result takes it
  assert map.get(w.index, 17) == Some(19)
  assert not map.has(w.index, 18)
  assert not map.has(w.index, 19)
  assert encode(branch_prog()) == encode(branch_prog())
}

test "a unary float operation writes flags only where it has an optional field, and a rounding mode only where it has one" {
  # measured against tileiras, one wrong shape at a time: exp with a
  # rounding varint loses the stream, exp2 without its flags reads an
  # operand index out of bounds, sqrt without its flags reads 15 for an
  # enum, tanh without its rounding mode does the same
  assert not float_op_has_flags("exp")
  assert float_op_has_flags("exp2")
  assert float_op_has_flags("rsqrt")
  assert float_op_has_flags("sqrt")
  assert not float_op_has_flags("tanh")
  assert not float_op_has_flags("log")
  assert not float_op_has_flags("log2")
  assert not float_op_has_flags("floor")
  assert not float_op_has_flags("ceil")
  assert not float_op_has_flags("pow")
  assert float_op_has_flags("addf")
  assert float_op_has_flags("maxf")
  assert unary_rounding("sqrt") == Some(ROUND_NEAREST_EVEN)
  assert unary_rounding("tanh") == Some(ROUND_FULL)
  assert unary_rounding("exp") == None
  assert unary_rounding("rsqrt") == None
  # the opcodes, from the frozen table
  assert (float_op("exp"), float_op("exp2"), float_op("log"), float_op("log2")) == (0x17, 0x18, 0x3F, 0x40)
  assert (float_op("sqrt"), float_op("rsqrt"), float_op("tanh"), float_op("pow")) == (0x64, 0x5D, 0x6A, 0x54)
  assert (float_op("floor"), float_op("ceil")) == (0x27, 0x0D)
  # knife T1's seven, read off BytecodeOpcodes.td at the same commit. None
  # of them has an optional field, so none writes a flags varint and none
  # writes a rounding mode.
  assert (float_op("sin"), float_op("cos"), float_op("tan")) == (0x62, 0x12, 0x69)
  assert (float_op("sinh"), float_op("cosh")) == (0x63, 0x13)
  assert (float_op("atan2"), float_op("remf")) == (0x6E, 0x59)
  assert not float_op_has_flags("sin")
  assert not float_op_has_flags("cos")
  assert not float_op_has_flags("tan")
  assert not float_op_has_flags("sinh")
  assert not float_op_has_flags("cosh")
  assert not float_op_has_flags("atan2")
  assert not float_op_has_flags("remf")
  assert unary_rounding("sin") == None
  assert unary_rounding("cos") == None
  assert not float_op_rounds("atan2")
  assert not float_op_rounds("remf")
}

test "the integer and conversion opcodes are the frozen table's, and each writes its attributes inline" {
  # BytecodeOpcodes.td at NVIDIA/cuda-tile be0889cd, read off the file and
  # not from the coverage memo: a table copied twice is a table that can be
  # copied wrong twice.
  assert (int_op("addi"), int_op("subi"), int_op("muli"), int_op("divi")) == (0x03, 0x68, 0x4E, 0x15)
  assert (int_op("remi"), int_op("maxi"), int_op("mini"), int_op("mulhii")) == (0x5A, 0x46, 0x48, 0x4D)
  assert (int_op("andi"), int_op("ori"), int_op("xori"), int_op("shli")) == (0x04, 0x52, 0x6C, 0x60)
  assert (int_op("negi"), int_op("absi")) == (0x50, 0x01)
  assert (cast_op("itof"), cast_op("ftoi"), cast_op("exti")) == (0x3B, 0x2B, 0x25)
  assert (cast_op("trunci"), cast_op("bitcast")) == (0x6B, 0x09)
  # `shri` and `shru` are one opcode under two signedness attributes
  assert int_op("shri") == int_op("shru")
  assert int_op("shri") == 0x61
  assert int_attrs("shri") == [SIGNED]
  assert int_attrs("shru") == [UNSIGNED]
  # `divi` carries TWO attributes, signedness before rounding, and getting
  # that wrong is what the device caught: a spurious leading 0 shifted both
  # and the reader answered UNSIGNED division. One-attribute operations
  # hide the same mistake, because a flags 0 and an `overflow` none are the
  # same byte.
  assert int_attrs("divi") == [SIGNED, ROUND_ZERO]
  assert int_attrs("remi") == [SIGNED]
  assert int_attrs("maxi") == [SIGNED]
  assert int_attrs("mini") == [SIGNED]
  assert int_attrs("addi") == [OVERFLOW_NONE]
  assert int_attrs("subi") == [OVERFLOW_NONE]
  assert int_attrs("muli") == [OVERFLOW_NONE]
  assert int_attrs("shli") == [OVERFLOW_NONE]
  assert int_attrs("negi") == [OVERFLOW_NONE]
  # nothing at all: `mulhii` (defined for unsigned operands, no attribute),
  # the three bitwise operations and `absi`
  assert int_attrs("mulhii") == []
  assert int_attrs("andi") == []
  assert int_attrs("ori") == []
  assert int_attrs("xori") == []
  assert int_attrs("absi") == []
  # `ftoi` takes nearest_int_to_zero (6), not the integer division's zero (1)
  assert cast_attrs("itof", "f64") == [SIGNED, ROUND_NEAREST_EVEN]
  assert cast_attrs("ftoi", "i32") == [SIGNED, ROUND_INT_TO_ZERO]
  assert cast_attrs("exti", "i32") == [UNSIGNED]
  assert cast_attrs("trunci", "i8") == [OVERFLOW_NONE]
  assert cast_attrs("bitcast", "f32") == []
  assert ROUND_ZERO != ROUND_INT_TO_ZERO
}

test "ftof and mmai are the frozen table's opcodes, with the attribute lists their Ops.td definitions declare" {
  # Both read off NVIDIA/cuda-tile at be0889cd, in the files named beside
  # them, and not from the coverage memo. `include/cuda_tile/Dialect/
  # CudaTile/IR/BytecodeOpcodes.td` has the two `PublicOpcode` lines; `Ops.td`
  # has the argument lists the attributes come from.
  assert cast_op("ftof") == 0x2A
  assert OP_MMAI == 0x4A
  # FToFOp: one operand and one attribute, `rounding_mode`, a
  # DefaultValuedAttr whose default is NEAREST_EVEN (0) -- written inline
  # on the required path, with no flags varint in front of it. Only
  # `nearest_even` is supported for a target that is not f8E8M0FNU.
  assert cast_attrs("ftof", "f64") == [ROUND_NEAREST_EVEN]
  assert len(cast_attrs("ftof", "f64")) == 1
  # MmaIOp: lhs and rhs are i8, acc and result are i32, and the two
  # signedness attributes are REQUIRED (CudaTileArg<CudaTile_SignednessAttr,
  # .., "13.1">), so they are inline too and in declaration order. Both are
  # `signed` here; `Signedness` is 0 for unsigned and 1 for signed
  # (AttrDefs.td).
  assert SIGNED == 1
  assert UNSIGNED == 0
  # the element formats those tiles are spelled with
  assert num_tag("i8") == 1
  assert num_tag("f16") == 5
  assert num_tag("i32") == 3
}

test "the atomics are the frozen table's opcodes, with the attribute values their Ops.td definitions declare" {
  # `include/cuda_tile/Dialect/CudaTile/IR/BytecodeOpcodes.td` at
  # NVIDIA/cuda-tile be0889cd: atomic_cas_tko is 0x7 and atomic_rmw_tko
  # 0x8, so the compare-and-swap comes FIRST. Read off the file.
  assert OP_ATOMIC_CAS_TKO == 0x07
  assert OP_ATOMIC_RMW_TKO == 0x08
  # AtomicRMWMode (AttrDefs.td): the three bitwise modes lead and the two
  # additions are 3 and 4, so an alphabetical table would be wrong in
  # eight places and a table that put `add` first in seven.
  assert (rmw_mode_value("and"), rmw_mode_value("or"), rmw_mode_value("xor")) == (0, 1, 2)
  assert (rmw_mode_value("add"), rmw_mode_value("addf")) == (3, 4)
  assert (rmw_mode_value("max"), rmw_mode_value("min")) == (5, 6)
  assert (rmw_mode_value("umax"), rmw_mode_value("umin"), rmw_mode_value("xchg")) == (7, 8, 9)
  # MemoryOrderingSemantics: `weak` is 0 and `relaxed` 1, and the atomics
  # accept every variant BUT `weak` (Ops.td's OnlyVariants). MemoryScope:
  # tl_blk 0, device 1, sys 2.
  assert ORDER_WEAK == 0
  assert ORDER_RELAXED == 1
  assert SCOPE_DEVICE == 1
  # Both operations' only optional fields are the two operands `mask` and
  # `token`, in that order, so their flag bits start at 1 where a load's
  # start at 4: a load has `memory_scope` and `optimization_hints` as
  # optional ATTRIBUTES ahead of them and these have neither.
  assert (ATOMIC_FLAG_MASK, ATOMIC_FLAG_TOKEN) == (1, 2)
  assert (LOAD_FLAG_MASK, LOAD_FLAG_TOKEN) == (4, 16)
}

test "an f16 constant lays down the binary16 pattern, low byte first, and an i8 one a single octet" {
  assert hex(float_payload("f16", 1.0)) == "003c"
  assert hex(float_payload("f16", -2.0)) == "00c0"
  # off the grid, the constant ROUNDS: 1 + 3 * 2^-12 is above the midpoint
  # between 1 and 1 + 2^-10
  assert hex(float_payload("f16", 1.0 + 3.0 / 4096.0)) == "013c"
  # 65504 is the largest finite binary16; 70000 is the infinity
  assert hex(float_payload("f16", 65504.0)) == "ff7b"
  assert hex(float_payload("f16", 70000.0)) == "007c"
  # one octet, the low one, whatever the host Int was
  assert hex(int_payload("i8", 4, 0)) == "00"
  assert hex(int_payload("i8", 4, 255)) == "ff"
  assert hex(int_payload("i8", 4, 0 - 1)) == "ff"
  assert hex(int_payload("i8", 4, 0 - 128)) == "80"
}

test "encoding a loop twice gives the same bytes, and the file still opens and closes as before" {
  let b = encode(sum_prog())
  assert b == encode(sum_prog())
  assert hex(bytes.slice(b, 0, 12)) == "7f54696c65495200" ++ "0d02" ++ "0000"
  assert bytes.at(b, bytes.len(b) - 1) == 0
  assert str.ends_with(hex(b), hex(bytes.utf8("sum")) ++ "00")
}

# Knife T2's two programs: the shape operations over a rank-3 tile whose
# first two dimensions are equal (so that a wrong permutation is a wrong
# ANSWER and not a type error), and the pointer surface.

fn shapes_prog() -> TileProg = TileProg {
  name: "shapes",
  params: ["f64", "f64"],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    NumBlocks(2, 0),
    Load(3, 4, 0, "f64", 1, [4, 4, 8], [32, 8, 1], None, None, 0),
    Permute(5, "f64", [4, 4, 8], [1, 0, 2], 3),
    IdxConst(6, 1),
    IdxConst(7, 0),
    Extract(8, "f64", [4, 4, 8], [2, 4, 8], 3, [6, 7, 7]),
    Extract(9, "f64", [4, 4, 8], [2, 4, 8], 3, [7, 7, 7]),
    Cat(10, "f64", 0, [2, 4, 8], [2, 4, 8], 8, 9),
    Store(11, 1, "f64", 1, [4, 4, 8], [32, 8, 1], 5, None, 4),
    Store(12, 1, "f64", 2, [4, 4, 8], [32, 8, 1], 10, None, 11)
  ]
}

fn ptrs_prog() -> TileProg = TileProg {
  name: "ptrs",
  params: ["f64", "i32"],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    MakePtrs(2, 0, "f64", [8]),
    Lanes(3, 1, [8], [1]),
    PtrAdd(4, "f64", [8], 2, 3),
    PtrInt(5, "f64", [8], 4),
    ConstI(6, "i64", [8], 24),
    BinaryI(7, "addi", "i64", [8], 5, 6),
    IntPtr(8, "f64", [8], 7),
    LoadAt(9, 10, "f64", [8], 8, None, None, 0),
    PtrCast(11, "f64", "i32", [8], 4),
    LoadAt(12, 13, "i32", [8], 11, None, None, 10),
    Store(14, 1, "i32", 1, [8], [1], 12, None, 13)
  ]
}

fn fork_prog() -> TileProg = TileProg {
  name: "fork",
  params: ["f64", "f64"],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    ConstF(2, "f64", [8], 1.0),
    Store(3, 1, "f64", 1, [8], [1], 2, None, 0),
    Store(4, 1, "f64", 1, [8], [1], 2, None, 0),
    JoinToks(5, [3, 4]),
    Load(6, 7, 1, "f64", 1, [8], [1], None, None, 5)
  ]
}

test "a dense i32 array is a count and four raw bytes an element, where an ArrayAttr is a count and self-contained elements" {
  let w0 = W { strs: table(), types: table(), consts: table(), body: bytes.buf(), index: map.empty(), nvals: 0 }
  # BytecodeWriter.cpp writeLEVarSize: the size as a varint, then writeLE
  # per element. No tag, no element type index, and NOT a varint per
  # element -- which is the whole difference from `identity_attr` above.
  assert hex(bytes.freeze(emit_i32_array(w0, [1, 0, 2]).body)) == "03" ++ "01000000" ++ "00000000" ++ "02000000"
  assert hex(bytes.freeze(emit_i32_array(w0, []).body)) == "00"
  assert hex(bytes.freeze(emit_i32_array(w0, [300]).body)) == "01" ++ "2c010000"
}

test "the shape operations are the frozen table's opcodes, with the permutation dense and extract's slice indices as operands" {
  let k = lower(shapes_prog())
  let (_w, whole) = body_of(k)
  # permute: opcode 0x53, the result type index, then the dense array, then
  # the source. The source is the load's value; the result type is a fresh
  # index, so only the opcode and the array are pinned by position here.
  assert str.contains(whole, hex(varint(OP_PERMUTE)))
  assert str.contains(whole, "03" ++ "01000000" ++ "00000000" ++ "02000000")
  # extract: opcode 0x26 and an operand COUNT of four (the source and three
  # slice indices), because `indices` is variadic.
  assert str.contains(whole, hex(varint(OP_EXTRACT)))
  # cat: opcode 0x0C then `dim` as a bare varint, no count in front of it
  assert str.contains(whole, hex(varint(OP_CAT)))
  # get_num_tile_blocks: the opcode and its three i32 result type indices,
  # which is get_tile_block_id's shape under another number. The token is
  # this program's first type, then i32 and tile<i32>, so the index is 2.
  assert str.contains(whole, hex(bytes.freeze(put_varint(put_varint(put_varint(put_varint(bytes.buf(), OP_GET_NUM_TILE_BLOCKS), 2), 2), 2))))
  assert OP_EXTRACT == 0x26 && OP_CAT == 0x0C && OP_PERMUTE == 0x53 && OP_GET_NUM_TILE_BLOCKS == 0x2E
}

test "extract writes its operand count, cat its dim inline, and neither writes a flags word" {
  let w0 = W { strs: table(), types: table(), consts: table(), body: bytes.buf(), index: map.from([(0, 0), (1, 1), (2, 2), (3, 3)]), nvals: 4 }
  let ex = encode_instr(w0, ExtractTile(9, Val(0), Tile([4, 4, 8], Num("f64")), Tile([2, 4, 8], Num("f64")), [Val(1), Val(2), Val(3)]))
  # opcode, result COUNT 1, result type index (f64 is registered first,
  # the tile second), operand count 4, then %0 %1 %2 %3
  assert hex(bytes.freeze(ex.body)) == "26" ++ "01" ++ "01" ++ "04" ++ "00" ++ "01" ++ "02" ++ "03"
  let ct = encode_instr(w0, CatTile(9, 1, Val(0), Val(1), Tile([2, 4], Num("f64")), Tile([2, 4], Num("f64")), Tile([2, 8], Num("f64"))))
  # opcode, result type index, dim 1, then the two operands: no operand
  # count (neither operand is variadic or optional) and no flags word
  assert hex(bytes.freeze(ct.body)) == "0c" ++ "01" ++ "01" ++ "00" ++ "01"
  let pm = encode_instr(w0, PermuteTile(9, Val(0), [1, 0, 2], Tile([4, 4, 8], Num("f64")), Tile([4, 4, 8], Num("f64"))))
  assert hex(bytes.freeze(pm.body)) == "53" ++ "01" ++ "03" ++ "01000000" ++ "00000000" ++ "02000000" ++ "00"
  let jt = encode_instr(w0, JoinTokens(9, [Val(0), Val(1), Val(2)]))
  assert hex(bytes.freeze(jt.body)) == "3c" ++ "01" ++ "00" ++ "03" ++ "00" ++ "01" ++ "02"
  # get_num_tile_blocks is get_tile_block_id's shape: three rank-0 i32
  # results, no operands, no attributes, no flags
  let nb = encode_instr(w0, BlockCounts(9, 10, 11))
  assert hex(bytes.freeze(nb.body)) == "2e" ++ "01" ++ "01" ++ "01"
}

test "the three pointer conversions are the frozen table's opcodes, each a result type and one operand" {
  let k = lower(ptrs_prog())
  let (_w, whole) = body_of(k)
  assert str.contains(whole, hex(varint(OP_PTR_TO_INT)))
  assert str.contains(whole, hex(varint(OP_INT_TO_PTR)))
  assert str.contains(whole, hex(varint(OP_PTR_TO_PTR)))
  assert OP_PTR_TO_INT == 0x56 && OP_INT_TO_PTR == 0x33 && OP_PTR_TO_PTR == 0x57
  let w0 = W { strs: table(), types: table(), consts: table(), body: bytes.buf(), index: map.from([(0, 0), (1, 1)]), nvals: 2 }
  let pi = encode_instr(w0, PtrToIntTile(9, Val(0), Tile([8], PtrTo("f64")), Tile([8], Num("i64"))))
  assert hex(bytes.freeze(pi.body)) == "56" ++ "01" ++ "00"
  # i64 is registered before the tile that names it: tag 4, then the tile
  # tag 13, that element index, the rank and the one dimension
  assert list.map(pi.types.items, hex) == ["04", "0d" ++ "00" ++ "01" ++ "0800000000000000"]
  let ip = encode_instr(w0, IntToPtrTile(9, Val(0), Tile([8], Num("i64")), Tile([8], PtrTo("f64"))))
  assert hex(bytes.freeze(ip.body)) == "33" ++ "02" ++ "00"
  let pp = encode_instr(w0, PtrToPtrTile(9, Val(0), Tile([8], PtrTo("f64")), Tile([8], PtrTo("i32"))))
  assert hex(bytes.freeze(pp.body)) == "57" ++ "02" ++ "00"
}

test "an i64 constant lays down eight bytes, low byte first" {
  assert hex(int_payload("i64", 8, 24)) == "1800000000000000"
  assert hex(int_payload("i64", 1, 0 - 1)) == str.repeat("ff", 8)
  assert num_tag("i64") == 4
}

test "join_tokens takes the tokens of two stores and the load after it takes the join" {
  let k = lower(fork_prog())
  let (_w, whole) = body_of(k)
  assert str.contains(whole, hex(varint(OP_JOIN_TOKENS)))
  assert OP_JOIN_TOKENS == 0x3C
}

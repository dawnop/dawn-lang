# A consumer must keep the complete application when forwarding this witness.
pub type Cond = { n: Int }
impl[^c] StagedCond[Cond, c] {
  fn staged_if(condition: Cond, yes: fn() -> Unit ^{c}, no: fn() -> Unit ^{c}) -> Unit =
    if condition.n > 0 { yes() } else { no() }
}
pub fn invoke[C: StagedCond[c] + ^{c}, ^c](condition: C,
  yes: fn() -> Unit ^{c}, no: fn() -> Unit ^{c}) -> Unit !C.StagedCond = {
  if condition { yes() } else { no() }
}

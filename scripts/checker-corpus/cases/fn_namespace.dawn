# checker.dawn: redeclared -- functions, trait methods and effect operations
# share one module-wide namespace. Registration order is effects, then traits,
# then functions, so which of the four wordings applies depends on it.
effect First {
  fn shared() -> Int
}

effect Second {
  fn shared() -> Int
}

effect Third {
  fn as_method() -> Int
}

trait Collide[T] {
  fn as_method(x: T) -> Int
}

trait Owner[T] {
  fn owned(x: T) -> Int
}

pub fn owned() -> Int = 1

pub fn twice() -> Int = 1

pub fn twice() -> Int = 2

# The control: a program of the same shape -- one function, one test block --
# that asks for no Unicode table at all. Its dawn/rt/Strings must stay small,
# or the gate above is only passing because pruning stopped happening.
pub fn add(a: Int, b: Int) -> Int = a + b

test "no Unicode table is needed here" {
  assert add(2, 2) == 4
}

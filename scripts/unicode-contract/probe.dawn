# Contract for the Unicode data the language answers from, and the generator
# for the compiler's tables.
#
# Two operations cannot be derived from anything -- their answer is a table:
#
#   `str.lower`/`str.upper`   simple (1:1) case mapping: one code point in, one
#                             out, no locale and no context (spec 11)
#   the six `char_is_*`       classification: letter, digit, alnum, upper,
#                             lower, space
#
# Each backend used to go and get that table for itself: the JVM emitter called
# `Character.toUpperCase` and `Character.isLetter`, the C runtime read a
# generated header (case) or gave up above U+007F (classification). Two
# implementations of "one" mapping stay one only while the JDK the header came
# from is the JDK the program runs on -- Unicode 15 and 16 differ by 18 cased
# code points, and nothing said so.
#
# So the tables are the compiler's now -- selfhost/src/embed/unicode_case.dawn and
# selfhost/src/embed/unicode_class.dawn -- and each backend receives them: codegen
# writes them into dawn/rt/Strings, `__emitc` writes them into the generated C.
# This checks them two ways:
#
#   (default)               the compiled `str.upper`/`str.lower`/`char_is_*`
#                           against the committed tables, over every code point
#                           they say anything about plus a spread of ones they
#                           do not -- and the tables against `Character`, the
#                           oracle they were generated from, when the running
#                           JDK carries the Unicode release they came from.
#   DAWN_UNICODE_EMIT=case  print the case table, for regenerating the module.
#   DAWN_UNICODE_EMIT=class print the classification table.
#
# Only the oracle half needs a JDK to agree with us, and that is the point: a
# program's answer is the table's, and the oracle is consulted when the table
# is made rather than every time a string is folded.
use std/char
use std/io
use std/io.{Fs, Env}
use std/list
use std/str
use java "java.lang.Character"
use java "java.lang.System"

const LAST: Int = 0x10FFFF

## Surrogates are not characters; `Character.toUpperCase` maps them to
## themselves and no string can hold one, so they are left out everywhere.
fn is_surrogate(cp: Int) -> Bool = cp >= 0xD800 && cp <= 0xDFFF

fn oracle(cp: Int, up: Bool) -> Int !io =
  if up { Character.toUpperCase(cp) } else { Character.toLowerCase(cp) }

## The five generated classifications. `alnum` is not among them: Java defines
## `isLetterOrDigit` as `isLetter || isDigit`, so it is derived rather than
## stored, on both backends.
fn classify(cp: Int, which: String) -> Bool !io =
  if which == "letters" {
    Character.isLetter(cp)
  } else if which == "digits" {
    Character.isDigit(cp)
  } else if which == "uppers" {
    Character.isUpperCase(cp)
  } else if which == "lowers" {
    Character.isLowerCase(cp)
  } else {
    Character.isWhitespace(cp)
  }

fn class_names() -> List[String] = ["letters", "digits", "uppers", "lowers", "spaces"]

fn one(cp: Int) -> String =
  from_code_points([char.of(cp).expect("the sweep skips the surrogates")])

fn only_cp(s: String) -> Int = char.code(get(code_points(s), 0).expect("one code point"))

fn jdk_version() -> String !io =
  match System.getProperty("java.version") {
    Some(v) -> v
    None -> "?"
  }

## The feature release: 21 out of "21.0.2". Unicode data moves with that number
## and not with the patch, so that is the part that has to match.
fn jdk_feature(v: String) -> String = str.split(v, ".")[0]

# ---- generating the tables ----

## Runs of consecutive code points whose mapping is the same offset from the
## code point itself, which is how a table this sparse stays small: 1.1M code
## points come out as a few hundred ranges.
fn case_ranges(up: Bool) -> List[(Int, Int, Int)] !io = {
  var out: List[(Int, Int, Int)] = []
  var lo = -1
  var hi = -1
  var delta = 0
  var cp = 0
  while cp <= LAST {
    if is_surrogate(cp) {
      cp = cp + 1
    } else {
      let d = oracle(cp, up) - cp
      if d == 0 {
        if lo >= 0 {
          out = out ++ [(lo, hi, delta)]
          lo = -1
        }
      } else if lo >= 0 && d == delta && cp == hi + 1 {
        hi = cp
      } else {
        if lo >= 0 { out = out ++ [(lo, hi, delta)] }
        lo = cp
        hi = cp
        delta = d
      }
      cp = cp + 1
    }
  }
  if lo >= 0 { out = out ++ [(lo, hi, delta)] }
  out
}

## Runs of consecutive code points the predicate holds at. Surrogates are not
## skipped here: a run may span them, and no string can hold one anyway, so
## letting a range close over the block keeps the table smaller and answers the
## same at every code point that can occur.
fn class_ranges(which: String) -> List[(Int, Int)] !io = {
  var out: List[(Int, Int)] = []
  var lo = -1
  var hi = -1
  var cp = 0
  while cp <= LAST {
    if classify(cp, which) {
      if lo >= 0 && cp == hi + 1 {
        hi = cp
      } else {
        if lo >= 0 { out = out ++ [(lo, hi)] }
        lo = cp
        hi = cp
      }
    }
    cp = cp + 1
  }
  if lo >= 0 { out = out ++ [(lo, hi)] }
  out
}

const HEX: String = "0123456789ABCDEF"

fn hex4(n: Int) -> String =
  if n >= 16 { hex4(n / 16) ++ hex_digit(n % 16) } else { hex_digit(n) }

fn hex_digit(n: Int) -> String = str.slice(HEX, n, n + 1)

fn pad4(s: String) -> String = if str.len(s) >= 4 { s } else { pad4("0" ++ s) }

fn cp_lit(n: Int) -> String = "0x" ++ pad4(hex4(n))

fn tail(last: Bool) -> String = if last { "" } else { "," }

fn emit_case_table(name: String, rs: List[(Int, Int, Int)]) -> Unit !io = {
  io.println("pub fn " ++ name ++ "() -> List[(Int, Int, Int)] = [")
  var i = 0
  for r in rs {
    let (lo, hi, delta) = r
    io.println("  (" ++ cp_lit(lo) ++ ", " ++ cp_lit(hi) ++ ", " ++ to_string(delta) ++ ")" ++
        tail(i == len(rs) - 1))
    i = i + 1
  }
  io.println("]")
}

fn emit_class_table(name: String, rs: List[(Int, Int)]) -> Unit !io = {
  io.println("pub fn " ++ name ++ "() -> List[(Int, Int)] = [")
  var i = 0
  for r in rs {
    let (lo, hi) = r
    io.println("  (" ++ cp_lit(lo) ++ ", " ++ cp_lit(hi) ++ ")" ++ tail(i == len(rs) - 1))
    i = i + 1
  }
  io.println("]")
}

fn emit_jdk_const(what: String) -> Unit !io = {
  io.println("## The JDK the oracle came from. A JDK carries one Unicode release, so which")
  io.println("## one answered is part of the data: scripts/unicode-contract/run.sh checks")
  io.println("## this table against `Character." ++ what ++ "` only when the running JDK's")
  io.println("## feature version matches.")
  io.println("pub const JDK: String = \"" ++ jdk_version() ++ "\"")
  io.println("")
}

fn emit_case() -> Unit !io = {
  io.println("# Simple (1:1) Unicode case mapping, as ranges of code points that share one")
  io.println("# offset: a code point in `lo..hi` maps to itself plus `delta`, and one in no")
  io.println("# range maps to itself.")
  io.println("#")
  io.println("# GENERATED by scripts/unicode-contract/probe.dawn -- do not edit. To")
  io.println("# regenerate:")
  io.println("#")
  io.println("#   DAWN_UNICODE_EMIT=case bin/dawn run scripts/unicode-contract/probe.dawn \\")
  io.println("#     > selfhost/src/embed/unicode_case.dawn")
  io.println("#")
  io.println("# This is the language's answer and not one backend's: codegen writes it into")
  io.println("# dawn/rt/Strings and emitc writes it into the generated C, so `str.upper`")
  io.println("# folds the same way on both backends and on whichever JDK happens to be")
  io.println("# running. It used to be `Character.toUpperCase` on the JVM against a")
  io.println("# generated C header on the native side, which agreed only while the two")
  io.println("# Unicode releases did.")
  io.println("#")
  io.println("# Simple mapping is one code point in, one out. Full mapping -- the one where")
  io.println("# a sharp s uppercases to two letters -- is locale- and context-sensitive and")
  io.println("# belongs in a library that takes a locale (spec 11).")
  io.println("")
  emit_jdk_const("toUpperCase")
  emit_case_table("upper", case_ranges(true))
  io.println("")
  emit_case_table("lower", case_ranges(false))
}

fn emit_class() -> Unit !io = {
  io.println("# Unicode classification, as ranges of code points the predicate holds at:")
  io.println("# `char_is_letter`, `char_is_digit`, `char_is_upper`, `char_is_lower`,")
  io.println("# `char_is_space`. `char_is_alnum` is not here -- it is letter or digit, which")
  io.println("# is how Java defines `isLetterOrDigit` and how both backends derive it.")
  io.println("#")
  io.println("# GENERATED by scripts/unicode-contract/probe.dawn -- do not edit. To")
  io.println("# regenerate:")
  io.println("#")
  io.println("#   DAWN_UNICODE_EMIT=class bin/dawn run scripts/unicode-contract/probe.dawn \\")
  io.println("#     > selfhost/src/embed/unicode_class.dawn")
  io.println("#")
  io.println("# Same story as the case table (see there): the JVM backend used to call")
  io.println("# `Character.isLetter`, so its answer was the running JDK's Unicode release,")
  io.println("# while the C runtime had no table at all and panicked above U+007F. Now both")
  io.println("# receive this one.")
  io.println("")
  emit_jdk_const("isLetter")
  var first = true
  for name in class_names() {
    if not first { io.println("") }
    first = false
    emit_class_table(name, class_ranges(name))
  }
}

# ---- reading the committed tables ----

fn table_dir() -> String !Env =
  match io.getenv("DAWN_UNICODE_DIR") {
    Some(p) -> p
    None -> "selfhost/src/embed"
  }

fn read(path: String) -> String !Fs =
  match io.read_file(path) {
    Ok(t) -> t
    Err(e) -> panic("cannot read " ++ path ++ ": " ++ e.message)
  }

fn hex_val(s: String) -> Int =
  if str.starts_with(s, "0x") {
    parse_int_radix(str.slice(s, 2, str.len(s)), 16).expect("hex literal")
  } else {
    parse_int(s).expect("decimal literal")
  }

## `  (0x0061, 0x007A, -32),` -> [0x61, 0x7A, -32]; `  (0x0041, 0x005A),` -> two.
fn parse_row(line: String) -> List[Int] = {
  let open = str.index_of(line, "(").expect("row opens")
  let close = str.last_index_of(line, ")").expect("row closes")
  var out: List[Int] = []
  for part in str.split(str.slice(line, open + 1, close), ",") {
    out = out ++ [hex_val(str.trim(part))]
  }
  out
}

## The `pub const JDK: String = "..."` line the generator writes.
fn table_jdk(text: String) -> String = {
  for line in str.split(text, "\n") {
    if str.starts_with(str.trim(line), "pub const JDK") {
      let q = str.index_of(line, "\"").expect("quoted")
      let rest = str.slice(line, q + 1, str.len(line))
      return str.slice(rest, 0, str.index_of(rest, "\"").expect("closing quote"))
    }
  }
  "?"
}

## The rows under `pub fn <name>() ...` in a generated module.
fn rows_of(text: String, name: String) -> List[List[Int]] = {
  var out: List[List[Int]] = []
  var inside = false
  for line in str.split(text, "\n") {
    let t = str.trim(line)
    if str.starts_with(t, "pub fn ") {
      inside = str.starts_with(t, "pub fn " ++ name ++ "()")
    } else if inside && str.starts_with(t, "(0x") {
      out = out ++ [parse_row(t)]
    } else if t == "]" {
      inside = false
    }
  }
  out
}

fn triples(text: String, name: String) -> List[(Int, Int, Int)] = {
  var out: List[(Int, Int, Int)] = []
  for r in rows_of(text, name) { out = out ++ [(r[0], r[1], r[2])] }
  out
}

fn pairs(text: String, name: String) -> List[(Int, Int)] = {
  var out: List[(Int, Int)] = []
  for r in rows_of(text, name) { out = out ++ [(r[0], r[1])] }
  out
}

# ---- the checks ----
#
# The ranges are sorted and disjoint, so a scan over the code points carries an
# index into them rather than searching per code point.

fn seek3(rs: List[(Int, Int, Int)], i: Int, cp: Int) -> Int =
  if i < len(rs) && {
    let (_, hi, _) = rs[i]
    hi < cp
  } {
    seek3(rs, i + 1, cp)
  } else {
    i
  }

fn map_at(rs: List[(Int, Int, Int)], i: Int, cp: Int) -> Int =
  if i >= len(rs) {
    cp
  } else {
    let (lo, hi, delta) = rs[i]
    if lo <= cp && cp <= hi { cp + delta } else { cp }
  }

fn seek2(rs: List[(Int, Int)], i: Int, cp: Int) -> Int =
  if i < len(rs) && {
    let (_, hi) = rs[i]
    hi < cp
  } {
    seek2(rs, i + 1, cp)
  } else {
    i
  }

fn holds_at(rs: List[(Int, Int)], i: Int, cp: Int) -> Bool =
  if i >= len(rs) {
    false
  } else {
    let (lo, hi) = rs[i]
    lo <= cp && cp <= hi
  }

## Every classification the compiled `char_is_*` gives, against the tables.
## Unlike case folding there is no walk to get wrong, so this is the whole
## check: it says the backend answers from this data and not from somewhere
## else.
fn check_class(text: String) -> (Int, Int) !io = {
  let letters = pairs(text, "letters")
  let digits = pairs(text, "digits")
  let uppers = pairs(text, "uppers")
  let lowers = pairs(text, "lowers")
  let spaces = pairs(text, "spaces")
  var bad = 0
  var seen = 0
  var il = 0
  var idg = 0
  var iu = 0
  var ilo = 0
  var isp = 0
  var cp = 0
  while cp <= LAST {
    # The surrogate halves drop out of this sweep, and not because they are
    # awkward: since v0.57.0 `char_is_*` takes a `Char`, which by construction
    # is a Unicode scalar value, so "is U+D800 a letter" stopped being a
    # question the language can be asked. The case sweep above skips them too,
    # for the older reason that they have no case mapping.
    if is_surrogate(cp) {
      cp = cp + 1
      continue
    }
    il = seek2(letters, il, cp)
    idg = seek2(digits, idg, cp)
    iu = seek2(uppers, iu, cp)
    ilo = seek2(lowers, ilo, cp)
    isp = seek2(spaces, isp, cp)
    let l = holds_at(letters, il, cp)
    let d = holds_at(digits, idg, cp)
    let u = holds_at(uppers, iu, cp)
    let w = holds_at(lowers, ilo, cp)
    let s = holds_at(spaces, isp, cp)
    if l || d || u || w || s || cp % 1009 == 0 {
      seen = seen + 1
      let c = char.of(cp).expect("not a surrogate, skipped above")
      if char_is_letter(c) != l || char_is_digit(c) != d || char_is_upper(c) != u ||
        char_is_lower(c) != w || char_is_space(c) != s ||
        char_is_alnum(c) != (l || d) {
          bad = bad + 1
          if bad < 12 {
            io.println("class " ++ cp_lit(cp) ++ " table " ++ to_string(l) ++ to_string(d) ++
                to_string(l || d) ++ to_string(u) ++ to_string(w) ++ to_string(s) ++
                " backend " ++ to_string(char_is_letter(c)) ++ to_string(char_is_digit(c)) ++
                to_string(char_is_alnum(c)) ++ to_string(char_is_upper(c)) ++
                to_string(char_is_lower(c)) ++ to_string(char_is_space(c)))
          }
        }
    }
    cp = cp + 1
  }
  (seen, bad)
}

## The classification tables against the JDK they were generated from.
fn check_class_oracle(text: String) -> Int !io = {
  var bad = 0
  for name in class_names() {
    let rs = pairs(text, name)
    var i = 0
    var cp = 0
    while cp <= LAST {
      i = seek2(rs, i, cp)
      let got = holds_at(rs, i, cp)
      let want = classify(cp, name)
      if got != want {
        if bad < 12 {
          io.println("table " ++ name ++ " " ++ cp_lit(cp) ++ " has " ++ to_string(got) ++
              " want " ++ to_string(want))
        }
        bad = bad + 1
      }
      cp = cp + 1
    }
  }
  bad
}

## The compiled `str.upper`/`str.lower` against the table, at every code point
## it moves plus one in every 1009 that it leaves alone. What this catches is
## the *walk* -- surrogate pairs rebuilt wrong, a code-point count that did not
## survive, a mapping applied to the wrong unit -- and, since the table became
## the compiler's, a backend that answers from somewhere else.
fn check_case(upper: List[(Int, Int, Int)], lower: List[(Int, Int, Int)]) -> (Int, Int) !io = {
  var bad = 0
  var seen = 0
  var iu = 0
  var il = 0
  var cp = 0
  while cp <= LAST {
    if is_surrogate(cp) {
      cp = cp + 1
    } else {
      iu = seek3(upper, iu, cp)
      il = seek3(lower, il, cp)
      let want_u = map_at(upper, iu, cp)
      let want_l = map_at(lower, il, cp)
      if want_u != cp || want_l != cp || cp % 1009 == 0 {
        seen = seen + 1
        let s = one(cp)
        let u = str.to_upper(s)
        let l = str.to_lower(s)
        if str.len(u) != 1 || str.len(l) != 1 {
          bad = bad + 1
          io.println("count " ++ cp_lit(cp) ++ " upper=" ++ to_string(str.len(u)) ++
              " lower=" ++ to_string(str.len(l)))
        } else if only_cp(u) != want_u {
          bad = bad + 1
          io.println("upper " ++ cp_lit(cp) ++ " got " ++ cp_lit(only_cp(u)) ++
              " want " ++ cp_lit(want_u))
        } else if only_cp(l) != want_l {
          bad = bad + 1
          io.println("lower " ++ cp_lit(cp) ++ " got " ++ cp_lit(only_cp(l)) ++
              " want " ++ cp_lit(want_l))
        }
      }
      cp = cp + 1
    }
  }
  (seen, bad)
}

## The case table against the JDK it was generated from -- the one half that
## needs a JDK to agree with us, and what says the data is still Unicode's
## rather than something that drifted.
fn check_case_oracle(rs: List[(Int, Int, Int)], up: Bool) -> Int !io = {
  var bad = 0
  var i = 0
  var cp = 0
  while cp <= LAST {
    if is_surrogate(cp) {
      cp = cp + 1
    } else {
      i = seek3(rs, i, cp)
      let got = map_at(rs, i, cp)
      let want = oracle(cp, up)
      if got != want {
        if bad < 12 {
          io.println("table " ++ (if up { "upper " } else { "lower " }) ++ cp_lit(cp) ++
              " has " ++ cp_lit(got) ++ " want " ++ cp_lit(want))
        }
        bad = bad + 1
      }
      cp = cp + 1
    }
  }
  bad
}

fn check() -> Unit !Fs !Env !io = {
  let case_text = read(table_dir() ++ "/unicode_case.dawn")
  let class_text = read(table_dir() ++ "/unicode_class.dawn")
  let upper = triples(case_text, "upper")
  let lower = triples(case_text, "lower")
  if len(upper) == 0 || len(lower) == 0 || len(pairs(class_text, "letters")) == 0 {
    panic("no ranges parsed out of " ++ table_dir())
  }
  let running = jdk_version()
  let built = table_jdk(case_text)
  if built != table_jdk(class_text) {
    panic("the two tables were generated by different JDKs: " ++ built ++ " vs " ++
        table_jdk(class_text))
  }
  io.println("jdk " ++ running ++ ", tables from " ++ built)
  io.println("ranges " ++ to_string(len(upper)) ++ " upper, " ++ to_string(len(lower)) ++
      " lower, " ++ to_string(len(pairs(class_text, "letters"))) ++ " letter")
  let (case_seen, case_bad) = check_case(upper, lower)
  let (class_seen, class_bad) = check_class(class_text)
  # A JDK carries one Unicode release, so asking one about a table generated
  # from another reports every code point that release added. That is a real
  # difference -- and it is about the two JDKs, not about the tables -- so it is
  # printed and not counted. CI pins the JDK, so there this half always runs.
  var oracle_bad = 0
  if jdk_feature(running) == jdk_feature(built) {
    oracle_bad = check_case_oracle(upper, true) + check_case_oracle(lower, false) +
      check_class_oracle(class_text)
  } else {
    io.println("note: tables generated with JDK " ++ built ++ ", running JDK " ++ running ++
        " -- different Unicode releases, oracle half not judged")
  }
  io.println("checked " ++ to_string(case_seen) ++ " case, " ++ to_string(class_seen) ++ " class")
  io.println("mismatches " ++ to_string(case_bad + class_bad + oracle_bad))
}

pub fn main() -> Unit !io = io.with_fs_real(() =>
    io.with_env_real(() =>
        match io.getenv("DAWN_UNICODE_EMIT") {
          Some(what) -> if what == "class" { emit_class() } else { emit_case() }
          None -> check()
        }))

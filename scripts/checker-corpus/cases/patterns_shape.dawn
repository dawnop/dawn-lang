# checker.dawn: literal, list, tuple and or-patterns
pub fn lit(x: Int) -> Int =
  match x {
    "a" -> 1
    _ -> 2
  }

pub fn lst(x: Int) -> Int =
  match x {
    [a, b] -> a
    _ -> 2
  }

pub fn tup(x: Int) -> Int =
  match x {
    (a, b) -> a
    _ -> 2
  }

pub fn tup_len(x: (Int, Int)) -> Int =
  match x {
    (a, b, c) -> a
  }

pub fn or_binds(x: Option[Int]) -> Int =
  match x {
    Some(a) | None -> 1
  }

pub fn guard(x: Int) -> Int =
  match x {
    a if a -> 1
    _ -> 2
  }

pub fn scrutinee(f: fn() -> Int) -> Int =
  match f {
    _ -> 1
  }

# expect: a record literal here needs parentheses
# A `match` scrutinee is a header: braces after an expression open the arms
# (spec §4.3). Braces holding `name:` fields can only be a record literal, so
# that is reported once, with the parenthesised spelling, and the literal is
# parsed as one (#192). Before, the fields were read as arms: two missing
# arrows, "match needs at least one arm" and a false top-level error.
type P = { x: Int, y: Int }
pub fn main() -> Unit !io = {
  match P { x: 1, y: 2 } {
    P { x: a, y: _ } -> println("${a}")
  }
}

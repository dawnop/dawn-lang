# EBNF fn_decl / param_list / type_expr / effect, plus the inferred return type
# a private function may omit (the EBNF demands `-> type` everywhere: SYN-04).
use std/io

fn inferred(a: Int) = a + 1

pub fn annotated(a: Int, b: Float) -> Float = b + to_float(a)

fn effectful(s: String) -> Unit !io = io.println(s)

fn polymorphic[T: Show](x: T) -> String = show(x)

fn takes_fn(f: fn(Int) -> Int, n: Int) -> Int = f(n)

fn tuples(p: (Int, String)) -> Int = {
  let (n, _) = p
  n
}

fn trailing_comma(
  a: Int,
  b: Int,
) -> Int = a + b

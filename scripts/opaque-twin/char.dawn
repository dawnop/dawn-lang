# `Char`, the one opaque type in the repository with no declaration site: the
# compiler mints it (types.ty_char) because `'a'` is syntax and the checker
# needs the type before any module is in scope. So `sed 's/^opaque type /alias /'`
# has nothing to flip here, and this case would otherwise be the only opaque
# type the twin gate never looks at.
#
# It earns its place two ways:
#
#   * `Twin` is declared, so the substitution still runs and this file still
#     participates in the property the gate is named for;
#   * every claim about `Char` below is checked *against the Int it is over*,
#     inside one run. A claim that came out the other way would `panic`, which
#     the gate reads as "does not compile and run" rather than as agreement.
#     Printing the answers alone would not: a wrong answer on both sides is an
#     empty diff, which is exactly the hole the header of run.sh describes.
#
# Rendering is the part that runs the other way now, at *both* layers, and it
# is not an exemption. spec §2.7 has always let an opaque type's own impl beat
# its target's, and names `impl Show[UserId]` as the example; `std/char` writes
# `impl Display[Char]` and `impl Show[Char]`, so both layers are the type's
# own. What that costs is exactly what this file exists to state out loud:
# `Char` is no longer an example of "an opaque type is its target", so each
# rendering answer is pinned twice, once against the string the impl is
# defined to produce and once against the Int's, which it must not equal.
#
# Identity is untouched and is still the whole point: `==`, `<`, `cmp`, `sort`
# and hashing are the Int's, and those are the claims `same` still makes.
use std/char
use std/io
use std/map
use std/set
use std/str

opaque type Twin = Int

fn same(what: String, a: String, b: String) -> Unit =
  if a != b { panic("Char disagrees with Int about " ++ what ++ ": " ++ a ++ " vs " ++ b) } else { () }

fn differs(what: String, a: String, b: String) -> Unit =
  if a == b {
    panic("Char has stopped rendering as itself for " ++ what ++ ": " ++ a)
  } else {
    ()
  }

pub fn main() -> Unit !io = {
  let a = 'a'
  let b = 'b'
  let t: Twin = 97

  println("-- the nested rendering is the type's own Show: a source literal --")
  same("show", show(a), "'" ++ str.from_char(a) ++ "'")
  differs("show", show(a), show(char.code(a)))
  differs("in a list", to_string([a]), to_string([char.code(a)]))
  differs("in a tuple", to_string((a, a)), to_string((char.code(a), char.code(a))))
  println(to_string([a, b]))

  println("-- the top-level rendering is the type's own Display: the character --")
  same("to_string", to_string(a), str.from_char(a))
  same("interpolation", "${a}", str.from_char(a))
  differs("to_string", to_string(a), to_string(char.code(a)))
  differs("interpolation", "${a}", "${char.code(a)}")
  println(to_string(a))
  println("${t}")

  println("-- and the two layers are not each other --")
  differs("layers", show(a), to_string(a))

  println("-- equality and order are the target's --")
  same("eq", to_string(a == a), to_string(char.code(a) == char.code(a)))
  same("neq", to_string(a == b), to_string(char.code(a) == char.code(b)))
  same("lt", to_string(a < b), to_string(char.code(a) < char.code(b)))
  same("cmp", to_string(cmp(b, a)), to_string(cmp(char.code(b), char.code(a))))
  # Compared through `code`, not through rendering: the two now render
  # differently on purpose, and this claim is about the order, not the text.
  let sorted = sort([b, a])
  same(
    "sort",
    to_string([char.code(sorted[0]), char.code(sorted[1])]),
    to_string(sort([char.code(b), char.code(a)])))
  println(to_string(sorted))

  println("-- hash, through a key --")
  let ka: Map[Char, Int] = map.from([(a, 1)])
  same("map key", to_string(map.get(ka, a)), to_string(map.get(map.from([(char.code(a), 1)]), 97)))
  println(to_string(map.get(ka, a)))
  let sa: Set[Char] = set.from([a, b, a])
  println(to_string(set.has(sa, b)))
  println(to_string(set.len(sa)))

  println("-- the declared twin beside it --")
  let kt: Map[Twin, Int] = map.from([(t, 1)])
  println(to_string(map.get(kt, t)))
  println(to_string(t == t))
}

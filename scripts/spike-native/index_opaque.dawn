# An opaque type over a List or a Map: what it gets for free.
#
# `==`, `${...}`, `for..in` and -- since knife 2 of
# docs/operator-traits-design.md -- `[]` all resolve their witness through the
# opaque and land on the target's impl. That fall-through is one branch in
# `resolve_witness` (checker.dawn:5738-5745), mirrored by `assoc_impl_of` for
# projections (checker.dawn:1266-1277), and `[]` joined the list by being
# routed through the resolver rather than by anything being added for it.
#
# Knife 1 pinned the state before, where `v[0]` was
#
#   error: `[]` indexes a List or Map, got Vec
#
# and could not appear in this file at all. Design D2 is the decision to
# accept the widening; the two subscripts in `main` are what it bought, and
# they are here rather than in a note because an accepted set is a thing a
# corpus can hold.
#
# The direction matters, and the two halves of `main` show both. An opaque as
# the *subject* of `[]` falls through to its target. An opaque as the *index*
# does not: with `opaque type Key = String` and `m: Map[Key, Int]`, `m["b"]`
# is refused --
#
#   error: this index must be `Key`, got `String`
#
# -- even inside the declaring module, exactly as `v == [1, 2, 4]` is refused
# below. Nothing is inconsistent about that. The subject position asks "which
# impl", and impl lookup falls through; the index position asks "do these two
# types match", and an opaque binds rather than converts wherever a type has
# to match. `Env`'s `Idx` reduces through the opaque to `String`, so `e["a"]`
# works -- the opacity there is on the container, not on the key.
#
# opaque.dawn next door covers opaque *scalars* -- that an opaque has no
# representation of its own at run time. This one is about witness
# resolution through one, which is a different mechanism and the one `[]` is
# moving onto.
#
# Single-module on purpose: the conversions between `Vec` and `List[Int]` are
# only legal inside the declaring module, and none of the lines below relies
# on one -- `v` is used as a `Vec` throughout. A line like `get(v, 0)` would
# compile today too, but through the opaque *conversion* rather than through a
# witness, and pinning that here would say nothing about `[]`.
use std/io
use std/map

opaque type Vec = List[Int]

opaque type Env = Map[String, Int]

fn mkv() -> Vec = [1, 2, 3]

fn mke() -> Env = map.from([("a", 1)])

## The other side of an inequality has to be a `Vec` too: `v == [1, 2, 4]` is
## rejected even inside the declaring module (`== requires both sides to have
## the same type: Vec vs List[Int]`). The opaque converts on the way into a
## parameter or a return, and *binds* everywhere a type has to match -- so
## `==` sees two `Vec`s and resolves one witness, which is the whole subject
## here.
fn other_v() -> Vec = [1, 2, 4]

fn other_e() -> Env = map.from([("a", 2)])

pub fn main() -> Unit !io = {
  let v = mkv()
  println("-- opaque over List --")
  println(to_string(v == mkv()))
  println(to_string(v == other_v()))
  println("${v}")
  for x in v {
    println(to_string(x))
  }

  let e = mke()
  println("-- opaque over Map --")
  println(to_string(e == mke()))
  println(to_string(e == other_e()))
  println("${e}")

  println("-- and the subscript, which knife 2 added --")
  println(to_string(v[0]))
  println(to_string(v[2]))
  println(to_string(e["a"]))
  for x in v {
    println(to_string(v[x - 1]))
  }
}

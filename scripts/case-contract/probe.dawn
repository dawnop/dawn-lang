# Contract for simple (1:1) Unicode case mapping, and the generator for the
# compiler's table.
#
# `str.lower`/`str.upper` are *simple* mapping: one code point in, one out, no
# locale and no context (docs/native-backend-plan.md 14.12). The answer is a
# Unicode table, so it is the one string operation neither backend can derive
# -- and for a while each backend went and got its own: the JVM emitter called
# `Character.toUpperCase`, the C runtime read a generated header. Those are
# "the same mapping" only while the JDK that generated the header and the JDK
# running the program carry the same Unicode release, which is not a property
# anyone can hold on to.
#
# So the table is the compiler's now (selfhost/src/case_table.dawn) and each
# backend receives it: codegen puts it in dawn/rt/Strings, `__emitc` puts it in
# the generated C. This checks that one table two ways:
#
#   (default)          the compiled `str.upper`/`str.lower` against the
#                      committed table, over every code point the table maps
#                      plus a spread of ones it does not -- and the table
#                      against `Character.toUpperCase`, which is where the data
#                      came from, when the running JDK carries the Unicode
#                      release it was generated from.
#   DAWN_CASE_EMIT=1   print the table, for regenerating the module.
#
# Only the second of those needs a JDK to agree with us, and that is the point:
# a program's answer is the table's, and the oracle is consulted when the table
# is made rather than every time a string is folded.
use std/io
use std/list
use std/str
use java "java.lang.Character"
use java "java.lang.System"

const LAST: Int = 0x10FFFF

## Surrogates are not characters; `Character.toUpperCase` maps them to
## themselves and no string can hold one, so they are left out of both halves.
fn is_surrogate(cp: Int) -> Bool = cp >= 0xD800 && cp <= 0xDFFF

fn oracle(cp: Int, up: Bool) -> Int !io =
  if up { Character.toUpperCase(cp) } else { Character.toLowerCase(cp) }

fn one(cp: Int) -> String = from_code_points([cp])

fn only_cp(s: String) -> Int = get(code_points(s), 0).expect("one code point")

fn jdk_version() -> String !io =
  match System.getProperty("java.version") {
    Some(v) -> v
    None -> "?"
  }

## The feature release: 21 out of "21.0.2". Unicode data moves with that number
## and not with the patch, so that is the part that has to match.
fn jdk_feature(v: String) -> String = str.split(v, ".")[0]

# ---- generating the table ----

## Runs of consecutive code points whose mapping is the same offset from the
## code point itself, which is how a table this sparse stays small: 1.1M code
## points come out as a few hundred ranges.
fn ranges(up: Bool) -> List[(Int, Int, Int)] !io = {
  var out: List[(Int, Int, Int)] = []
  var lo = -1
  var hi = -1
  var delta = 0
  var cp = 0
  while cp <= LAST {
    if is_surrogate(cp) {
      cp = cp + 1
    } else {
      let d = oracle(cp, up) - cp
      if d == 0 {
        if lo >= 0 {
          out = out ++ [(lo, hi, delta)]
          lo = -1
        }
      } else if lo >= 0 && d == delta && cp == hi + 1 {
        hi = cp
      } else {
        if lo >= 0 { out = out ++ [(lo, hi, delta)] }
        lo = cp
        hi = cp
        delta = d
      }
      cp = cp + 1
    }
  }
  if lo >= 0 { out = out ++ [(lo, hi, delta)] }
  out
}

const HEX: String = "0123456789ABCDEF"

fn hex4(n: Int) -> String =
  if n >= 16 { hex4(n / 16) ++ hex_digit(n % 16) } else { hex_digit(n) }

fn hex_digit(n: Int) -> String = str.substring(HEX, n, n + 1)

fn pad4(s: String) -> String = if str.len(s) >= 4 { s } else { pad4("0" ++ s) }

fn cp_lit(n: Int) -> String = "0x" ++ pad4(hex4(n))

fn row(r: (Int, Int, Int), last: Bool) -> String = {
  let (lo, hi, delta) = r
  "  (" ++ cp_lit(lo) ++ ", " ++ cp_lit(hi) ++ ", " ++ to_string(delta) ++ ")" ++
    (if last { "" } else { "," })
}

fn emit_table(name: String, rs: List[(Int, Int, Int)]) -> Unit !io = {
  io.println("pub fn " ++ name ++ "() -> List[(Int, Int, Int)] = [")
  var i = 0
  for r in rs {
    io.println(row(r, i == len(rs) - 1))
    i = i + 1
  }
  io.println("]")
}

fn emit() -> Unit !io = {
  io.println("# Simple (1:1) Unicode case mapping, as ranges of code points that share one")
  io.println("# offset: a code point in `lo..hi` maps to itself plus `delta`, and one in no")
  io.println("# range maps to itself.")
  io.println("#")
  io.println("# GENERATED by scripts/case-contract/probe.dawn -- do not edit. To regenerate:")
  io.println("#")
  io.println("#   DAWN_CASE_EMIT=1 bin/dawn run scripts/case-contract/probe.dawn \\")
  io.println("#     > selfhost/src/case_table.dawn")
  io.println("#")
  io.println("# This is the language's answer and not one backend's: codegen writes it into")
  io.println("# dawn/rt/Strings and emitc writes it into the generated C, so `str.upper`")
  io.println("# folds the same way on both backends and on whichever JDK happens to be")
  io.println("# running. It used to be `Character.toUpperCase` on the JVM against a")
  io.println("# generated C header on the native side, which agreed only while the two")
  io.println("# Unicode releases did.")
  io.println("#")
  io.println("# Simple mapping is one code point in, one out. Full mapping -- the one where")
  io.println("# a sharp s uppercases to two letters -- is locale- and context-sensitive and")
  io.println("# belongs in a library that takes a locale (spec 11).")
  io.println("")
  io.println("## The JDK the oracle came from. A JDK carries one Unicode release, so which")
  io.println("## one answered is part of the data: scripts/case-contract/run.sh checks this")
  io.println("## table against `Character.toUpperCase` only when the running JDK's feature")
  io.println("## version matches.")
  io.println("pub const JDK: String = \"" ++ jdk_version() ++ "\"")
  io.println("")
  emit_table("upper", ranges(true))
  io.println("")
  emit_table("lower", ranges(false))
}

# ---- reading the committed table ----

fn table_path() -> String !io =
  match io.getenv("DAWN_CASE_TABLE") {
    Some(p) -> p
    None -> "selfhost/src/case_table.dawn"
  }

fn hex_val(s: String) -> Int =
  if str.starts_with(s, "0x") {
    parse_int_radix(str.substring(s, 2, str.len(s)), 16).expect("hex literal")
  } else {
    parse_int(s).expect("decimal literal")
  }

## `  (0x0061, 0x007A, -32),` -> (0x61, 0x7A, -32).
fn parse_row(line: String) -> (Int, Int, Int) = {
  let open = str.index_of(line, "(").expect("row opens")
  let close = str.last_index_of(line, ")").expect("row closes")
  let parts = str.split(str.substring(line, open + 1, close), ",")
  (hex_val(str.trim(parts[0])), hex_val(str.trim(parts[1])), hex_val(str.trim(parts[2])))
}

## The `pub const JDK: String = "..."` line the generator writes.
fn table_jdk(text: String) -> String = {
  for line in str.split(text, "\n") {
    if str.starts_with(str.trim(line), "pub const JDK") {
      let q = str.index_of(line, "\"").expect("quoted")
      let rest = str.substring(line, q + 1, str.len(line))
      return str.substring(rest, 0, str.index_of(rest, "\"").expect("closing quote"))
    }
  }
  "?"
}

## The two range lists out of the module, in the order they are declared.
fn read_table(text: String) -> (List[(Int, Int, Int)], List[(Int, Int, Int)]) = {
  var upper: List[(Int, Int, Int)] = []
  var lower: List[(Int, Int, Int)] = []
  var in_upper = false
  var in_lower = false
  for line in str.split(text, "\n") {
    let t = str.trim(line)
    if str.starts_with(t, "pub fn upper()") {
      in_upper = true
      in_lower = false
    } else if str.starts_with(t, "pub fn lower()") {
      in_lower = true
      in_upper = false
    } else if str.starts_with(t, "(0x") {
      let r = parse_row(t)
      if in_upper { upper = upper ++ [r] } else if in_lower { lower = lower ++ [r] }
    } else if t == "]" {
      in_upper = false
      in_lower = false
    }
  }
  (upper, lower)
}

# ---- the checks ----
#
# The ranges are sorted and disjoint, so a scan over the code points carries an
# index into them rather than searching per code point.

## Advance past every range that ends before `cp`.
fn seek(rs: List[(Int, Int, Int)], i: Int, cp: Int) -> Int =
  if i < len(rs) && {
    let (_, hi, _) = rs[i]
    hi < cp
  } {
    seek(rs, i + 1, cp)
  } else {
    i
  }

fn map_at(rs: List[(Int, Int, Int)], i: Int, cp: Int) -> Int =
  if i >= len(rs) {
    cp
  } else {
    let (lo, hi, delta) = rs[i]
    if lo <= cp && cp <= hi { cp + delta } else { cp }
  }

## The compiled `str.upper`/`str.lower` against the table, at every code point
## the table moves plus one in every 1009 that it leaves alone. What this
## catches is the *walk* -- surrogate pairs rebuilt wrong, a code-point count
## that did not survive, a mapping applied to the wrong unit -- and, since the
## table became the compiler's, a backend that answers from somewhere else.
fn check_walk(upper: List[(Int, Int, Int)], lower: List[(Int, Int, Int)]) -> (Int, Int) !io = {
  var bad = 0
  var seen = 0
  var iu = 0
  var il = 0
  var cp = 0
  while cp <= LAST {
    if is_surrogate(cp) {
      cp = cp + 1
    } else {
      iu = seek(upper, iu, cp)
      il = seek(lower, il, cp)
      let want_u = map_at(upper, iu, cp)
      let want_l = map_at(lower, il, cp)
      if want_u != cp || want_l != cp || cp % 1009 == 0 {
        seen = seen + 1
        let s = one(cp)
        let u = str.to_upper(s)
        let l = str.to_lower(s)
        if str.len(u) != 1 || str.len(l) != 1 {
          bad = bad + 1
          io.println("count " ++ cp_lit(cp) ++ " upper=" ++ to_string(str.len(u)) ++
            " lower=" ++ to_string(str.len(l)))
        } else if only_cp(u) != want_u {
          bad = bad + 1
          io.println("upper " ++ cp_lit(cp) ++ " got " ++ cp_lit(only_cp(u)) ++
            " want " ++ cp_lit(want_u))
        } else if only_cp(l) != want_l {
          bad = bad + 1
          io.println("lower " ++ cp_lit(cp) ++ " got " ++ cp_lit(only_cp(l)) ++
            " want " ++ cp_lit(want_l))
        }
      }
      cp = cp + 1
    }
  }
  (seen, bad)
}

## The table against the JDK it was generated from -- the one half that needs a
## JDK to agree with us, and what says the data is still Unicode's rather than
## something that drifted.
fn check_oracle(rs: List[(Int, Int, Int)], up: Bool) -> Int !io = {
  var bad = 0
  var i = 0
  var cp = 0
  while cp <= LAST {
    if is_surrogate(cp) {
      cp = cp + 1
    } else {
      i = seek(rs, i, cp)
      let got = map_at(rs, i, cp)
      let want = oracle(cp, up)
      if got != want {
        if bad < 12 {
          io.println("table " ++ (if up { "upper " } else { "lower " }) ++ cp_lit(cp) ++
            " has " ++ cp_lit(got) ++ " want " ++ cp_lit(want))
        }
        bad = bad + 1
      }
      cp = cp + 1
    }
  }
  bad
}

fn check() -> Unit !io = {
  let text =
    match io.read_file(table_path()) {
      Ok(t) -> t
      Err(e) -> panic("cannot read " ++ table_path() ++ ": " ++ e)
    }
  let (upper, lower) = read_table(text)
  if len(upper) == 0 || len(lower) == 0 {
    panic("no ranges parsed out of " ++ table_path())
  }
  let running = jdk_version()
  let built = table_jdk(text)
  io.println("jdk " ++ running ++ ", table from " ++ built)
  io.println("ranges " ++ to_string(len(upper)) ++ " upper, " ++ to_string(len(lower)) ++ " lower")
  let (seen, walk_bad) = check_walk(upper, lower)
  # A JDK carries one Unicode release, so asking one about a table generated
  # from another reports every code point that release added. That is a real
  # difference -- and it is about the two JDKs, not about the table -- so it is
  # printed and not counted. CI pins the JDK, so there this half always runs.
  var oracle_bad = 0
  if jdk_feature(running) == jdk_feature(built) {
    oracle_bad = check_oracle(upper, true) + check_oracle(lower, false)
  } else {
    io.println("note: table generated with JDK " ++ built ++ ", running JDK " ++ running ++
      " -- different Unicode releases, oracle half not judged")
  }
  io.println("checked " ++ to_string(seen))
  io.println("mismatches " ++ to_string(walk_bad + oracle_bad))
}

pub fn main() -> Unit !io =
  match io.getenv("DAWN_CASE_EMIT") {
    Some(_) -> emit()
    None -> check()
  }

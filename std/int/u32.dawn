## Unsigned 32-bit integers: `U32`, an opaque type over `Int` holding
## 0..4294967295, with arithmetic that wraps the way `Int`'s does.
#
# GENERATED by scripts/fixed-ints/gen.py -- edit there and rerun it; the
# tree-policy gate fails on a hand edit here.
#
# One of seven sibling modules (std/int/i8, i16, i32, u8, u16, u32, u64) that
# share one shape; docs/literal-system-design.md D13 is the design and spec
# 11 the contract. Why they are std and not the compiler's: the compiler owns
# two numbers, Int and Float (D1), and a fixed-width integer is an Int with
# an invariant, which is what an opaque type is. Measured before this was
# written: packages/sha2's compression loop over std/int/u32 runs within 1% of
# the `Int` + `& MASK` form on both backends.
#
# They live under std/int/ so that seven of them do not crowd the top of
# std; `use` binds a path's last segment, so `use std/int/u32` still
# qualifies as `u32`.
#
# Why one module per width and not one module for all seven: a module is
# Dawn's namespace, so `u32.wrap(n)`, `u32.rotr(x, 7)` and `u8.wrap(n)` are
# the same names qualified differently, as `char.code` is for `Char`. One
# module would need either a width in every name (`wrap_u32`) or a trait
# whose `to_int` member shadows the builtin `to_int` in every importer, and
# the constructors could not be trait members anyway, since their subject is
# only in the return position. A program imports the widths it uses.
#
# The Int inside is always in 0..4294967295, so equality, hashing and order
# are the Int's, inherited (spec 2.7), and correct as they stand: an impl
# of `Ord` of its own would say the same thing and turn every `<` from a
# native comparison into a call. Arithmetic is not inherited (an opaque
# type never inherits it, docs/arith-operator-traits-design.md D4) and is
# written below: each result is computed in Int and wrapped back to its
# low 32 bits, so `0 - 1` is 4294967295. `/` and `%` are Int's on non-negative
# operands, and a zero divisor panics with Int's message.
#
# Wrapping and not trapping, as `Int` does (spec 4.3): two overflow rules in
# one family of types would have every reader looking up which one applies.
# `checked_add`, `checked_sub` and `checked_mul` answer `None` instead. A
# literal at `U32` is `FromInt`'s, range-checked at compile time, so
# `let b: U32 = 4294967296` does not compile (outside this module: inside it the
# type is seen through and a literal is the Int it always was, literal design
# D7). All seven bitwise traits are explicit pure impls, with Int shift
# amounts masked by 31, including negative counts. Left shifts wrap;
# `>>` follows signedness and `>>>` shifts the width's bits with zeros.
# Logical right shift first removes any host sign extension, then rebuilds
# the invariant, so shifting by zero preserves the original bit pattern.
# Rotations remain named because neither shift alone expresses a rotation.

## A unsigned 32-bit integer.
pub opaque type U32 = Int

## The least `U32`, 0.
pub const MIN: U32 = 0

## The greatest `U32`, 4294967295.
pub const MAX: U32 = 4294967295

## `n` as a `U32`, or `None` when it is outside 0..4294967295.
pub fn of(n: Int) -> Option[U32] = if n < 0 || n > 4294967295 { None } else { Some(n) }

## The `U32` with the low 32 bits of `n`: `wrap(-1)` is 4294967295.
pub fn wrap(n: Int) -> U32 = n & 0xFFFFFFFF

## The value of `x` as an Int.
pub fn to_int(x: U32) -> Int = x

# The literal's range check, run at compile time for every literal at this
# type outside this module.
impl FromInt[U32] {
  fn from_int(n: Int) -> U32 = {
    if n < 0 || n > 4294967295 { panic("out of range for U32: ${n}") }
    n
  }
}

impl Show[U32] {
  fn show(x: U32) -> String = {
    let n: Int = x
    to_string(n)
  }
}

impl Add[U32] {
  fn add(a: U32, b: U32) -> U32 = {
    let x: Int = a
    let y: Int = b
    wrap(x + y)
  }
}

impl Sub[U32] {
  fn sub(a: U32, b: U32) -> U32 = {
    let x: Int = a
    let y: Int = b
    wrap(x - y)
  }
}

impl Mul[U32] {
  fn mul(a: U32, b: U32) -> U32 = {
    let x: Int = a
    let y: Int = b
    wrap(x * y)
  }
}

impl Div[U32] {
  fn div(a: U32, b: U32) -> U32 = {
    let x: Int = a
    let y: Int = b
    x / y
  }
}

impl Rem[U32] {
  fn rem(a: U32, b: U32) -> U32 = {
    let x: Int = a
    let y: Int = b
    x % y
  }
}

impl Neg[U32] {
  fn neg(a: U32) -> U32 = {
    let x: Int = a
    wrap(0 - x)
  }
}

## `a + b`, or `None` where it wraps.
pub fn checked_add(a: U32, b: U32) -> Option[U32] = {
  let x: Int = a
  let y: Int = b
  let r = x + y
  if r < 0 || r > 4294967295 { None } else { Some(r) }
}

## `a - b`, or `None` where it wraps.
pub fn checked_sub(a: U32, b: U32) -> Option[U32] = {
  let x: Int = a
  let y: Int = b
  let r = x - y
  if r < 0 || r > 4294967295 { None } else { Some(r) }
}

## `a * b`, or `None` where it wraps.
pub fn checked_mul(a: U32, b: U32) -> Option[U32] = {
  let x: Int = a
  let y: Int = b
  let r = x * y
  # a product of two U32s can pass 2^63, where the Int wraps negative,
  # which the range test below refuses like any other overflow
  if r < 0 || r > 4294967295 { None } else { Some(r) }
}

impl BitAnd[U32] {
  fn bit_and(a: U32, b: U32) -> U32 = {
    let x: Int = a
    let y: Int = b
    wrap(x & y)
  }
}

impl BitOr[U32] {
  fn bit_or(a: U32, b: U32) -> U32 = {
    let x: Int = a
    let y: Int = b
    wrap(x | y)
  }
}

impl BitXor[U32] {
  fn bit_xor(a: U32, b: U32) -> U32 = {
    let x: Int = a
    let y: Int = b
    wrap(x ^ y)
  }
}

impl BitNot[U32] {
  fn bit_not(a: U32) -> U32 = {
    let x: Int = a
    wrap(~x)
  }
}

impl Shl[U32] {
  type ShlAmount = Int
  fn shl(a: U32, n: Int) -> U32 = {
    let x: Int = a
    let u = x & 0xFFFFFFFF
    wrap(u << (n & 31))
  }
}

impl Shr[U32] {
  type ShrAmount = Int
  fn shr(a: U32, n: Int) -> U32 = {
    let x: Int = a
    let u = x & 0xFFFFFFFF
    wrap(u >>> (n & 31))
  }
}

impl Ushr[U32] {
  type UshrAmount = Int
  fn ushr(a: U32, n: Int) -> U32 = {
    let x: Int = a
    let u = x & 0xFFFFFFFF
    wrap(u >>> (n & 31))
  }
}

## `a`'s 32 bits rotated left by `n` modulo 32 places.
pub fn rotl(a: U32, n: Int) -> U32 = {
  let x: Int = a
  let u = x & 0xFFFFFFFF
  let k = n & 31
  wrap((u << k) | (u >>> (32 - k)))
}

## `a`'s 32 bits rotated right by `n` modulo 32 places.
pub fn rotr(a: U32, n: Int) -> U32 = {
  let x: Int = a
  let u = x & 0xFFFFFFFF
  let k = n & 31
  wrap((u >>> k) | (u << (32 - k)))
}

# Representative cases; scripts/spike-native/fixed_ints holds the seven types
# to an oracle computed outside Dawn, on both backends.

test "the ends wrap into each other and the conversions agree" {
  assert MAX + wrap(1) == MIN
  assert MIN - wrap(1) == MAX
  assert to_int(wrap(7) / wrap(2)) == 3
  assert to_int(wrap(7) % wrap(2)) == 1
  assert rotl(wrap(1), 32) == wrap(1)
  assert rotr(wrap(1), 1) == wrap(1) << 31
  assert checked_add(MAX, wrap(1)) == None
  assert checked_sub(MIN, wrap(1)) == None
  assert of(4294967296) == None
  assert of(0) == Some(MIN)
  assert to_int(wrap(4294967296)) == 0
  assert show(MIN) == "0"
  assert to_int(-wrap(1)) == 4294967295
  assert to_int(~MIN) == 4294967295
}

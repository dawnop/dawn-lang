## The language's own number rendering and parsing: `to_string(Float)` and
## the `parse_*` family are answered here, by Dawn source rather than by
## whichever host is running (spec §4.3 and §11's grammar).
#
# `to_string(Float)` is answered here, by a Dawn port of the Schubfach
# algorithm (Giulietti, "The Schubfach way to render doubles"; the same
# algorithm OpenJDK's `Double.toString` has used since JDK 19). Both backends
# and the comptime interpreter call this one definition, so the answer no
# longer depends on which host happens to be running — it is pinned by spec
# §4.3, byte for byte. The C runtime's `%.17g` approximation and the JVM's
# `String.valueOf(double)` used to be two different answers to the same
# question (audit RP-01); this module is the one answer.
#
# `parse_int` / `parse_float` / `parse_int_radix` are answered here too
# (audit RP-05): the accepted language is the EBNF in spec §11, checked by
# this module's own scanner, never by a host parser's grammar. The one thing
# still delegated is the final decimal-to-binary conversion of a *validated*
# float string (`parse_float` below), because correct rounding of decimal
# strings is a large algorithm both hosts already implement identically on
# the validated subset.
#
# Rendering discipline: nothing in this module may render a Float with
# `to_string` or `${...}` — lowering rewrites those to `fmt.dtoa`, so a use
# here would be a self-call. Ints are fine (`str_of_int` is a backend
# intrinsic, not this module).

use std/str
use std/cursor
use std/cursor.{Cursor}

# ---- shared integer helpers ----
#
# No module-level consts in here: a comptime fold interprets these bodies as
# the program's own std Core, and the interpreter resolves const references
# in the *folding module's* view only -- a std-module const would not be
# found there. Literals are spelled inline instead (2^63 - 1 in rop()).

fn pow10(e: Int) -> Int =
  match e {
    0 -> 1
    1 -> 10
    2 -> 100
    3 -> 1000
    4 -> 10000
    5 -> 100000
    6 -> 1000000
    7 -> 10000000
    8 -> 100000000
    9 -> 1000000000
    10 -> 10000000000
    11 -> 100000000000
    12 -> 1000000000000
    13 -> 10000000000000
    14 -> 100000000000000
    15 -> 1000000000000000
    16 -> 10000000000000000
    17 -> 100000000000000000
    _ -> panic("fmt: pow10 out of range")
  }

## floor(a * b / 2^64) for 0 <= a, b < 2^63: the high word of the unsigned
## product, from 32-bit halves. Both call sites keep the operands under 2^63,
## so the signed/unsigned distinction never bites.
fn umulh(a: Int, b: Int) -> Int = {
  let a0 = a & 4294967295
  let a1 = a >>> 32
  let b0 = b & 4294967295
  let b1 = b >>> 32
  let lo = a0 * b0
  let m1 = a1 * b0
  let m2 = a0 * b1
  let w = (lo >>> 32) + (m1 & 4294967295) + (m2 & 4294967295)
  (a1 * b1) + (m1 >>> 32) + (m2 >>> 32) + (w >>> 32)
}

# ---- floor logarithms (multiplier-and-shift, exact over the needed ranges) --
#
# floor(e * log10(2)), floor(log10(3/4 * 2^e)) and floor(e * log2(10)) as one
# multiply and an arithmetic shift. The constants are floor(log10(2) * 2^41),
# floor(log10(3/4) * 2^41) and floor(log2(10) * 2^38); each identity was
# checked exhaustively against exact rational arithmetic over |e| <= 1100
# (flog10*) and |e| <= 350 (flog2pow10), which covers every exponent a double
# can put through them.

fn flog10pow2(e: Int) -> Int = (e * 661971961083) >> 41

fn flog10_three_quarters_pow2(e: Int) -> Int = (e * 661971961083 - 274743187321) >> 41

fn flog2pow10(e: Int) -> Int = (e * 913124641741) >> 38

# ---- the powers-of-10 table ----
#
# g_pair(i) is the 126-bit significand of 10^(-k) for k = i - 324, split as
# (high 63 bits, low 63 bits): write 10^(-k) = b * 2^r with 2^125 <= b < 2^126,
# then the pair encodes g = floor(b) + 1. One entry per k in [-324, 292] —
# every power a finite double's decimal exponent can ask for. GENERATED from
# exact rational arithmetic (the table equals OpenJDK MathUtils.g, verified
# entry for entry); the chunks keep any one function's match small.

fn g_pair(i: Int) -> (Int, Int) =
  if i < 300 {
    if i < 100 { g_chunk0(i) } else if i < 200 { g_chunk1(i) } else { g_chunk2(i) }
  } else {
    if i < 400 { g_chunk3(i) } else if i < 500 { g_chunk4(i) } else if i < 600 {
      g_chunk5(i)
    } else {
      g_chunk6(i)
    }
  }


# The typed tree records every span as an offset from the declaration the
# checker was inside (`cx.owner_off`), because an offset is what survives a
# declaration moving. This is the one place those offsets become positions in
# a revision again, and it runs at the end of each declaration, where the base
# is known without asking: the scheduler has just entered that declaration.
#
# Resolving here rather than further down is not a shortcut. A typed function
# outlives its module -- the comptime interpreter and lowering both read the
# bundled library's functions beside the ones just checked -- and no single
# base answers for a tree assembled from several modules. The declaration's
# own exit is the last moment one base is the right one for the whole tree.
#
# The same exit is where a failure learns where it was written. `e!`,
# `panic`, `todo`, `expect` and `assert` all report `at <path>:<line>:<col>`
# (docs/source-location-design.md section 5), and that suffix is a fact about
# a revision exactly the way an absolute span is. The message itself stays a
# plain string to everything below: lowering folds the suffix in and no
# backend or interpreter learns what a position is.
#
# Since L4 the site of `panic`, `todo` and `expect` arrives as their `at`
# argument, and an omitted one is the checker's `caller` placeholder: what
# this exit appends to it is the `Loc` itself, `<path>:<line>:<col>`, the site
# of the call the placeholder stands in for (docs/caller-location-design.md
# 4.3). Any function's `at: Loc = caller()` is filled the same way.
#
# `dbg` rides the same seam with a different shape: its trailing argument is
# the `[<path>:<line>:<col>] <argument text> = ` its line starts with (section
# 6 of the same document). The argument text is the source between the
# argument's own first and last position, sliced here for the reason the
# position is resolved here: it is read off the revision being resolved, so
# no parser table has to carry it and a shadowing `fn dbg` never sees one.
#
# The panic below is the guard on the other half of the seam. A span the
# checker forgot to measure stays absolute, which reads as an offset past the
# end of its own declaration; that is a compiler bug and not a program's, so
# it stops here rather than reaching a backend as a position in the wrong
# coordinate system.
use std/list
use std/map
use std/str
use check/types.{Sym, TyInt, TyNever, ty_loc}
use check/tast.{
  TExpr, TStmt, TFun, TDefault, TJavaCall, TStrPart, TArm, TListElem, TListIfArm, TConst,
  TSPText, TSPInterp, TLEExpr, TLESpread, TLEIf,
  XInt, XChar, XFloat, XBool, XUnit, XStr, XLocal, XEvRead, XFnValue,
  XCallDyn, XCallBuiltin, XCallFn, XApply, XJava, XLambda, XCtor, XConstRef,
  XCtorValue, XField, XListLit, XTupleLit, XPropagate, XUnwrap, XIndex,
  XReturn, XBreak, XContinue, XComptime, XBinary, XUnary,
  XIf, XMatch, XBlock, XError,
  TSLet, TSLetPat, TSLocalFn, TSAssign, TSExpr, TSAssert, TSWhile, TSFor, BAdd,
  x_lo, x_hi
}

## What one declaration's offsets are measured from.
##
## `span` is the declaration's own length, and None says the module's span
## view could not name the declaration. The checker measured nothing from a
## declaration it could not name, so nothing is added back to one either, and
## the two sides stay in step by asking the same question.
pub type Resolver = {
  base: Int,
  span: Option[Int],
  # the module's position path (`Cx.site_path`): baked into the program, so
  # it is the tree's name for the file and never the command line's (#401)
  path: Option[String],
  line_starts: List[Int],
  # the revision's text, which a `dbg` call's argument is sliced from
  source: String
}

## The resolver for a declaration the span view names.
pub fn owned(lo: Int, hi: Int, path: Option[String], line_starts: List[Int], source: String) -> Resolver =
  Resolver { base: lo, span: Some(hi - lo), path: path, line_starts: line_starts, source: source }

## The resolver for a declaration it does not: a duplicate, or one under a
## duplicated parent. Its tree is already in file coordinates.
pub fn unowned(path: Option[String], line_starts: List[Int], source: String) -> Resolver =
  Resolver { base: 0, span: None, path: path, line_starts: line_starts, source: source }

fn at(r: Resolver, off: Int) -> Int =
  match r.span {
    None -> off
    Some(width) ->
      if off < 0 || off > width {
        panic("typed span " ++ to_string(off) ++ " is not inside the declaration " ++
            "it was measured from (width " ++ to_string(width) ++ ")")
      } else {
        r.base + off
      }
  }

## 1-based line and column of a position, on the checker's line table. The
## column counts code points from the line's start, the currency positions
## and line starts are both in, so it is the column the diagnostic arrow
## (`--> path:line:col`) prints for the same position.
fn line_col(line_starts: List[Int], pos: Int) -> (Int, Int) = {
  var line = 1
  var start = 0
  for s in line_starts {
    if s <= pos && s > 0 {
      line = line + 1
      if s > start { start = s }
    }
  }
  (line, pos - start + 1)
}

## The ` at <path>:<line>:<col>` suffix of a failure message. The checker
## knows the failure and says so; where it sits is a fact about a revision,
## so it is derived here, against the revision being resolved. A declaration
## that only moved therefore reports the line it moved to, which is what a
## message baked at check time could not do. A module with no position path
## (std) names no site.
fn site(r: Resolver, pos: Int) -> String =
  match loc_text(r, pos) {
    Some(l) -> " at " ++ l
    None -> ""
  }

## `<path>:<line>:<col>` of a position, the value of a `Loc` and the text
## after ` at ` in a failure (docs/caller-location-design.md 3.1); None in a
## module with no position path (std).
fn loc_text(r: Resolver, pos: Int) -> Option[String] =
  match r.path {
    Some(p) -> {
      let (line, col) = line_col(r.line_starts, pos)
      Some(p ++ ":" ++ to_string(line) ++ ":" ++ to_string(col))
    }
    None -> None
  }

## The `[<path>:<line>:<col>] <argument text> = ` a `dbg` line starts with,
## or None in a module with no position path. The checker refuses `dbg` in
## std, so a call that gets None here is one in a context built by hand.
fn dbg_head(r: Resolver, pos: Int, arg: TExpr) -> Option[String] =
  match r.path {
    Some(p) -> {
      let (line, col) = line_col(r.line_starts, pos)
      Some("[" ++ p ++ ":" ++ to_string(line) ++ ":" ++ to_string(col) ++ "] " ++
          arg_text(r.source, x_lo(arg), x_hi(arg)) ++ " = ")
    }
    None -> None
  }

## The source of an argument as one line of a `dbg`: the text as written,
## except that a run of white space that crosses a line break is one space,
## or nothing just inside a bracket. A `dbg` line is then one line however
## the argument was laid out (a vertical pipe, a call wrapped after its `(`),
## and the text is still the author's own tokens rather than a printer's
## guess at them (section 6.2).
fn arg_text(source: String, lo: Int, hi: Int) -> String = {
  var out: List[Char] = []
  var gap: List[Char] = []
  var broke = false
  var prev = ' '
  for c in code_points(str.slice(source, lo, hi)) {
    if char_is_space(c) {
      gap = gap ++ [c]
      if c == '\n' { broke = true }
    } else {
      let joined: List[Char] = if not broke {
        gap
      } else if prev == '(' || prev == '[' || c == ')' || c == ']' {
        []
      } else {
        [' ']
      }
      out = out ++ joined ++ [c]
      gap = []
      broke = false
      prev = c
    }
  }
  from_code_points(out)
}

## The builtins whose call carries a fact about where it was written, and how
## many arguments it has without it. The arity is what tells a call that
## carries one from one that does not (a call in std carries none).
##
## `caller` is the site an omitted `at: Loc = caller()` stands for: the checker
## puts a placeholder call in the argument's place, and its trailing string is
## the `Loc` (docs/caller-location-design.md 4.3). `dbg` carries its line's
## head. `panic`, `todo` and `expect` were here until L4, with a site appended
## to the message; their site is now their `at` argument, which is a
## `caller` like any other.
fn sited_arity(name: String) -> Option[Int] =
  if name == "caller" {
    Some(0)
  } else if name == "dbg" {
    Some(1)
  } else {
    None
  }

## A sited builtin's call with its site, as one trailing `XStr` after the
## written arguments.
##
## Why an extra argument rather than the message rewritten here: the typed
## tree is also what the language server walks, pairing written arguments
## with typed ones, and a message turned into `msg ++ site` would no longer
## be the node the author wrote. A trailing argument leaves every written one
## as it was; `split_site` is how both readers take it back off, and lowering
## is the only one that keeps it.
fn sited_call(r: Resolver, name: String, args: List[TExpr], start: Int) -> List[TExpr] =
  match sited_arity(name) {
    Some(n) ->
      if len(args) == n && r.path != None {
        let tag = if name == "dbg" {
          dbg_head(r, start, args[0]).expect("a module with a position path")
        } else {
          loc_text(r, start).expect("a module with a position path")
        }
        args ++ [XStr([TSPText(tag)], start, start)]
      } else {
        args
      }
    None -> args
  }

## The written arguments of a builtin call, and the site it carries if any:
## `(args, None)` for every call but a sited one from a module with a path.
pub fn split_site(name: String, args: List[TExpr]) -> (List[TExpr], Option[String]) =
  match sited_arity(name) {
    Some(n) ->
      if len(args) == n + 1 {
        match args[n] {
          XStr([TSPText(s)], _, _) -> (list.take(args, n), Some(s))
          _ -> (args, None)
        }
      } else {
        (args, None)
      }
    None -> (args, None)
  }

fn exprs(r: Resolver, xs: List[TExpr]) -> List[TExpr] = map(xs, x => expr(r, x))

fn opt_expr(r: Resolver, x: Option[TExpr]) -> Option[TExpr] =
  match x {
    None -> None
    Some(e) -> Some(expr(r, e))
  }

fn str_part(r: Resolver, p: TStrPart) -> TStrPart =
  match p {
    TSPText(v) -> TSPText(v)
    TSPInterp(e, wit) -> TSPInterp(expr(r, e), wit)
  }

fn list_elem(r: Resolver, e: TListElem) -> TListElem =
  match e {
    TLEExpr(x) -> TLEExpr(expr(r, x))
    TLESpread(x) -> TLESpread(expr(r, x))
    TLEIf(arms) -> TLEIf(map(arms, a =>
        TListIfArm { cond: expr(r, a.cond), body: expr(r, a.body) }))
  }

fn arm(r: Resolver, a: TArm) -> TArm =
  TArm { pat: a.pat, guard: opt_expr(r, a.guard), body: expr(r, a.body) }

fn java_call(r: Resolver, c: TJavaCall) -> TJavaCall =
  TJavaCall { ..c,
    target: opt_expr(r, c.target),
    args: exprs(r, c.args),
    sam_evs: map(c.sam_evs, pair => {
      let (idx, e) = pair
      (idx, expr(r, e))
    }),
    nlo: at(r, c.nlo),
    nhi: at(r, c.nhi) }

pub fn expr(r: Resolver, e: TExpr) -> TExpr =
  match e {
    XInt(v, lo, hi) -> XInt(v, at(r, lo), at(r, hi))
    XChar(v, lo, hi) -> XChar(v, at(r, lo), at(r, hi))
    XFloat(v, lo, hi) -> XFloat(v, at(r, lo), at(r, hi))
    XBool(v, lo, hi) -> XBool(v, at(r, lo), at(r, hi))
    XUnit(lo, hi) -> XUnit(at(r, lo), at(r, hi))
    XStr(parts, lo, hi) -> XStr(map(parts, p => str_part(r, p)), at(r, lo), at(r, hi))
    XLocal(sym, name, lo, hi, ty) -> XLocal(sym, name, at(r, lo), at(r, hi), ty)
    XEvRead(key, origin, lo, hi, ty) -> XEvRead(key, origin, at(r, lo), at(r, hi), ty)
    XFnValue(owner, name, builtin, ty, lo, hi) ->
      XFnValue(owner, name, builtin, ty, at(r, lo), at(r, hi))
    XCallDyn(sym, name, args, evs, lo, hi, ty) ->
      XCallDyn(sym, name, exprs(r, args), exprs(r, evs), at(r, lo), at(r, hi), ty)
    XCallBuiltin(name, args, wits, evs, lo, hi, ty) -> {
      let start = at(r, lo)
      XCallBuiltin(name, sited_call(r, name, exprs(r, args), start), wits, exprs(r, evs),
        start, at(r, hi), ty)
    }
    XCallFn(owner, name, args, wits, evs, trait_id, lo, hi, ty) ->
      XCallFn(owner, name, exprs(r, args), wits, exprs(r, evs), trait_id, at(r, lo), at(r, hi), ty)
    XApply(target, args, evs, lo, hi, ty) ->
      XApply(expr(r, target), exprs(r, args), exprs(r, evs), at(r, lo), at(r, hi), ty)
    XJava(c, lo, hi, ty) -> XJava(java_call(r, c), at(r, lo), at(r, hi), ty)
    XLambda(params, pnames, body, captures, lo, hi, ty) ->
      XLambda(params, pnames, expr(r, body), captures, at(r, lo), at(r, hi), ty)
    XCtor(adt, ci, written, slots, spread, lo, hi, ty) ->
      XCtor(adt, ci, exprs(r, written), slots, opt_expr(r, spread), at(r, lo), at(r, hi), ty)
    XConstRef(owner, name, lo, hi, ty) -> XConstRef(owner, name, at(r, lo), at(r, hi), ty)
    XCtorValue(adt, ci, lo, hi, ty) -> XCtorValue(adt, ci, at(r, lo), at(r, hi), ty)
    XField(target, idx, lo, hi, ty) -> XField(expr(r, target), idx, at(r, lo), at(r, hi), ty)
    XListLit(elems, lo, hi, ty) ->
      XListLit(map(elems, x => list_elem(r, x)), at(r, lo), at(r, hi), ty)
    XTupleLit(elems, lo, hi, ty) -> XTupleLit(exprs(r, elems), at(r, lo), at(r, hi), ty)
    XPropagate(operand, lo, hi, ty) -> XPropagate(expr(r, operand), at(r, lo), at(r, hi), ty)
    XUnwrap(operand, msg, lo, hi, ty) -> {
      let start = at(r, lo)
      XUnwrap(expr(r, operand), msg ++ site(r, start), start, at(r, hi), ty)
    }
    XIndex(target, index, wit, lo, hi, ty) ->
      XIndex(expr(r, target), expr(r, index), wit, at(r, lo), at(r, hi), ty)
    XReturn(v, lo, hi) -> XReturn(opt_expr(r, v), at(r, lo), at(r, hi))
    XBreak(lo, hi) -> XBreak(at(r, lo), at(r, hi))
    XContinue(lo, hi) -> XContinue(at(r, lo), at(r, hi))
    XComptime(body, lo, hi, ty) -> XComptime(expr(r, body), at(r, lo), at(r, hi), ty)
    XBinary(op, left, right, wit, olo, ohi, lo, hi, ty) ->
      XBinary(op, expr(r, left), expr(r, right), wit,
        at(r, olo), at(r, ohi), at(r, lo), at(r, hi), ty)
    XUnary(op, operand, lo, hi, ty) -> XUnary(op, expr(r, operand), at(r, lo), at(r, hi), ty)
    XIf(cond, thn, els, lo, hi, ty) ->
      XIf(expr(r, cond), expr(r, thn), opt_expr(r, els), at(r, lo), at(r, hi), ty)
    XMatch(scrut, arms, lo, hi, ty) ->
      XMatch(expr(r, scrut), map(arms, a => arm(r, a)), at(r, lo), at(r, hi), ty)
    XBlock(stmts, tail, lo, hi, ty) ->
      XBlock(map(stmts, s => stmt(r, s)), opt_expr(r, tail), at(r, lo), at(r, hi), ty)
    XError(lo, hi) -> XError(at(r, lo), at(r, hi))
  }

## Patterns carry no spans, so they travel whole.
pub fn stmt(r: Resolver, s: TStmt) -> TStmt =
  match s {
    TSLet(sym, name, init, lo, hi) -> TSLet(sym, name, expr(r, init), at(r, lo), at(r, hi))
    TSLetPat(pat, init, lo, hi) -> TSLetPat(pat, expr(r, init), at(r, lo), at(r, hi))
    TSLocalFn(sym, name, params, pnames, body, captures, lo, hi) ->
      TSLocalFn(sym, name, params, pnames, expr(r, body), captures, at(r, lo), at(r, hi))
    TSAssign(sym, name, value, lo, hi) -> TSAssign(sym, name, expr(r, value), at(r, lo), at(r, hi))
    TSExpr(e, lo, hi) -> TSExpr(expr(r, e), at(r, lo), at(r, hi))
    TSAssert(cond, src, lo, hi) -> {
      # the site rides on the condition's text, which is the message lowering
      # writes; `assertion failed` is lowering's own text for a missing one
      let start = at(r, lo)
      let suffix = site(r, start)
      let sited = match src {
        Some(t) -> Some(t ++ suffix)
        None -> if suffix == "" { None } else { Some("assertion failed" ++ suffix) }
      }
      TSAssert(expr(r, cond), sited, start, at(r, hi))
    }
    TSWhile(cond, body, jumps, lo, hi) ->
      TSWhile(expr(r, cond), expr(r, body), jumps, at(r, lo), at(r, hi))
    TSFor(pat, item_ty, from, to, wit, body, jumps, lo, hi) ->
      TSFor(pat, item_ty, expr(r, from), opt_expr(r, to), wit, expr(r, body), jumps,
        at(r, lo), at(r, hi))
  }

pub fn function(r: Resolver, f: TFun) -> TFun =
  TFun { ..f,
    defaults: map(f.defaults, d => match d {
      None -> None
      Some(dd) -> Some(TDefault { ..dd, body: expr(r, dd.body) })
    }),
    body: expr(r, f.body) }

pub fn constant(r: Resolver, c: TConst) -> TConst =
  TConst { ..c, init: expr(r, c.init), lo: at(r, c.lo), hi: at(r, c.hi) }

## The declaration's own symbols, named by the identifier interval the
## scheduler minted them in. A symbol's declaring span is measured from the
## same declaration as the tree that reads it, so the two are resolved
## together or not at all.
pub fn symbols(r: Resolver, syms: Map[Int, Sym], first: Int, limit: Int) -> Map[Int, Sym] = {
  var out = syms
  var id = first
  while id < limit {
    match map.get(out, id) {
      Some(s) -> { out = map.insert(out, id, Sym { ..s, dlo: at(r, s.dlo), dhi: at(r, s.dhi) }) }
      None -> ()
    }
    id = id + 1
  }
  out
}

test "an owned tree comes back at the declaration it was measured from" {
  let r = owned(100, 130, Some("m.dawn"), [0, 40, 90], "")
  let inner = XBinary(BAdd, XInt(1, 4, 5), XInt(2, 8, 9), None, 6, 7, 4, 9, TyInt)
  assert expr(r, inner) ==
    XBinary(BAdd, XInt(1, 104, 105), XInt(2, 108, 109), None, 106, 107, 104, 109, TyInt)
  # the declaration's own start and end are both inside it
  assert expr(r, XUnit(0, 30)) == XUnit(100, 130)
}

test "an unowned tree is already in file coordinates" {
  let r = unowned(Some("m.dawn"), [0, 40], "")
  assert expr(r, XUnit(41, 44)) == XUnit(41, 44)
}

test "an unwrap message names the line the declaration sits on now" {
  let starts = [0, 40, 90]
  let here = owned(100, 130, Some("src/m.dawn"), starts, "")
  let moved = owned(45, 75, Some("src/m.dawn"), starts, "")
  let raw = XUnwrap(XUnit(0, 1), "unwrapped None from f()", 0, 4, TyInt)
  assert expr(here, raw) ==
    XUnwrap(XUnit(100, 101), "unwrapped None from f() at src/m.dawn:3:11", 100, 104, TyInt)
  assert expr(moved, raw) ==
    XUnwrap(XUnit(45, 46), "unwrapped None from f() at src/m.dawn:2:6", 45, 49, TyInt)
  # a context with no source names no site, the way the checker named none
  let anonymous = owned(100, 130, None, starts, "")
  assert expr(anonymous, raw) == XUnwrap(XUnit(100, 101), "unwrapped None from f()", 100, 104, TyInt)
}

test "a column counts from its own line, and the first line starts at one" {
  let starts = [0, 40, 90]
  assert line_col(starts, 0) == (1, 1)
  assert line_col(starts, 39) == (1, 40)
  assert line_col(starts, 40) == (2, 1)
  assert line_col(starts, 104) == (3, 15)
}

test "an omitted caller() becomes its call's site, carried as one trailing argument" {
  let starts = [0, 40, 90]
  let r = owned(100, 130, Some("src/m.dawn"), starts, "")
  # the checker's placeholder spans the call it is the site of
  let call = XCallBuiltin("caller", [], [], [], 0, 13, ty_loc())
  let loc = XStr([TSPText("src/m.dawn:3:11")], 100, 100)
  let resolved = expr(r, call)
  assert resolved == XCallBuiltin("caller", [loc], [], [], 100, 113, ty_loc())
  assert split_site("caller", [loc]) == ([], Some("src/m.dawn:3:11"))
  # resolving twice does not site a call twice
  assert expr(unowned(Some("src/m.dawn"), starts, ""), resolved) == resolved
  # std has no position path: the placeholder stays bare, the no-site Loc
  let in_std = owned(100, 130, None, starts, "")
  assert expr(in_std, call) == XCallBuiltin("caller", [], [], [], 100, 113, ty_loc())
  assert split_site("caller", []) == ([], None)
  # a failing builtin's site is its `at` argument now, never a string of its own
  let msg = XStr([TSPText("boom")], 6, 12)
  let panic_call = XCallBuiltin("panic", [msg, call], [], [], 0, 13, TyNever)
  assert expr(r, panic_call) ==
    XCallBuiltin("panic", [XStr([TSPText("boom")], 106, 112), resolved], [], [], 100, 113, TyNever)
  let other = XCallBuiltin("len", [msg], [], [], 0, 13, TyInt)
  assert expr(r, other) == XCallBuiltin("len", [XStr([TSPText("boom")], 106, 112)], [], [], 100, 113, TyInt)
}

test "a dbg call carries its line's head: site, then the argument as written" {
  # `dbg(n * 2)` at offset 40 of a two-line file, inside a declaration at 30
  let src = "fn twice(n: Int) -> Int =\n  let y = 1\n  dbg(n * 2)\n"
  let starts = [0, 26, 38]
  let r = owned(30, 52, Some("src/m.dawn"), starts, src)
  let arg = XBinary(BAdd, XLocal(1, "n", 14, 15, TyInt), XInt(2, 18, 19), None, 16, 17, 14, 19, TyInt)
  let call = XCallBuiltin("dbg", [arg], [], [], 10, 20, TyInt)
  let head = "[src/m.dawn:3:3] n * 2 = "
  match expr(r, call) {
    XCallBuiltin(_, args, _, _, lo, _, _) -> {
      assert lo == 40
      assert len(args) == 2
      assert split_site("dbg", args) == ([args[0]], Some(head))
    }
    _ -> panic("not a builtin call")
  }
  # a module with no position path (std, which refuses `dbg` anyway) adds none
  let in_std = owned(30, 52, None, starts, src)
  match expr(in_std, call) {
    XCallBuiltin(_, args, _, _, _, _, _) -> { assert len(args) == 1 }
    _ -> panic("not a builtin call")
  }
}

test "an argument written over several lines is one line of text" {
  let src = "twice(\n    a +\n      1)"
  assert arg_text(src, 0, 25) == "twice(a + 1)"
  # a break between two tokens is a space, and spacing within a line is kept
  assert arg_text("xs\n  |>  len", 0, 13) == "xs |>  len"
  assert arg_text("[1,\n 2\n]", 0, 9) == "[1, 2]"
  assert arg_text("\"ä🎈\" ++ s", 0, 9) == "\"ä🎈\" ++ s"
}

test "an assertion's text carries its site" {
  let r = owned(100, 130, Some("src/m.dawn"), [0, 40, 90], "")
  let raw = TSAssert(XBool(true, 7, 11), Some("true"), 0, 11)
  assert stmt(r, raw) == TSAssert(XBool(true, 107, 111), Some("true at src/m.dawn:3:11"), 100, 111)
  let unnamed = TSAssert(XBool(true, 7, 11), None, 0, 11)
  assert stmt(r, unnamed) ==
    TSAssert(XBool(true, 107, 111), Some("assertion failed at src/m.dawn:3:11"), 100, 111)
  assert stmt(owned(100, 130, None, [0, 40, 90], ""), unnamed) == TSAssert(XBool(true, 107, 111), None, 100, 111)
}

test "symbols move with the tree that reads them" {
  let sym = (dlo: Int, dhi: Int) =>
    Sym { name: "x", ty: TyInt, mutable: false, dlo: dlo, dhi: dhi,
      dict_of: None, ev_of: None, cell_of: None }
  let before = map.from([(7, sym(0, 1)), (9, sym(4, 5)), (11, sym(60, 61))])
  let after = symbols(owned(100, 130, None, [], ""), before, 7, 11)
  assert map.get(after, 7) == Some(sym(100, 101))
  assert map.get(after, 9) == Some(sym(104, 105))
  # outside the interval the declaration minted, nothing is touched
  assert map.get(after, 11) == Some(sym(60, 61))
}

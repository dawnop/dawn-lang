-- against the host, through with_fs_real --
scratch is a dir = true
read a      = alpha
read b      = beta
read absent = <err>
names       = ["a.txt", "b.txt", "sub"]
a exists    = true
sub is dir  = true
a is dir    = false
delete a    = Ok(true)
delete a    = Ok(false)
io sees b        = true
bytes agree      = true
temp file made   = true
perms copied     = true
bytes written    = true
cleaned up       = true
-- against a table, no host --
read a      = alpha
read b      = beta
read absent = <err>
names       = ["/t/a.txt", "/t/b.txt"]
a exists    = true
sub is dir  = true
a is dir    = false
delete a    = Ok(true)
delete a    = Ok(false)
table holds   = ["/t/b.txt:beta"]
host untouched   = true

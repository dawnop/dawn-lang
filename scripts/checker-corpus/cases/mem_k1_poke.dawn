# Known-bad: a new runner must not discharge the caller's buffer effect.
use std/mem
fn poke(b: I64Buf, n: Int) -> Unit = mem.with_mem(() => mem.set(b, 0, n))

pub fn main() -> Unit !io = {
  let result = mem.with_mem(() => {
    let b = mem.new(1)
    poke(b, 5)
    mem.at(b, 0)
  })
  println(to_string(result))
}

pub type Shape =
  | Circle(r: Int)
  | Square(s: Int)

pub type Pt = { x: Int, y: Int }

pub effect Ask {
  fn ask() -> Int
}

pub fn twice(x: Int) -> Int = x * 2

pub fn thrice(x: Int) -> Int = x * 3

pub fn only_in_tests(x: Int) -> Int = x

pub const LIMIT: Int = 10

pub fn quad(x: Int) -> Int = x * 4

pub fn half(x: Int) -> Int = x / 2

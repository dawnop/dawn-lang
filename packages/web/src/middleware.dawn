# Middleware are plain handler transformers:
#   fn(handler) -> handler
# composed by serve_app with the first element outermost. No registry, no
# annotations — wrapping a function is the whole mechanism.
use std/str
use std/bytes
use std/list
use std/map
use java "java.lang.System"
use types.{Request, Response, HttpError, Handler, RouteMeta, Text, with_header, text, header, http_error}

## One access-log line per request: method, path, status, wall time.
pub fn with_logging(next: Handler) -> Handler =
  req => {
    let started = System.nanoTime()
    let out = next(req)
    let ms = (System.nanoTime() - started) / 1000000
    let status = match out {
      Ok(r) -> r.status
      Err(e) -> e.status
    }
    println("${req.method} ${req.path} -> $status (${ms}ms)")
    out
  }

# True if the matched route carries `tag`. Middleware read the route's tags
# (filled in by the server after dispatch) instead of hardcoding paths, so
# exemptions live next to the route declaration. Unmatched requests (404/405)
# carry no route, hence no tags — false.
fn route_has_tag(req: Request, tag: String) -> Bool =
  match req.route {
    Some(m) -> list.find(m.tags, t => t == tag) != None
    None -> false
  }

# Reject bodies over a byte budget before the handler sees them. Upload routes
# (WebDAV PUT, /api/fm/upload) carry file bytes and are bounded by nginx
# (client_max_body_size) instead — they opt out with the "raw-body" tag.
#
# This is a per-application budget layered under the server's own ceiling
# (server.DEFAULT_MAX_BODY), which is what actually bounds the allocation; by
# the time a middleware runs, the body has been read. Keeping it is still worth
# it — an app may want a limit far below the server's — but it is a policy
# check, not a memory guard, and the comment used to imply otherwise.
#
# It also measures `raw`, the bytes, rather than `str.len(body)`, which counts
# code points. The message always said "bytes" while the check counted
# characters, so a body of CJK or emoji got up to 3-4x the stated budget.
#
# `limit <= 0` is unbounded, which is the meaning the server has always given
# the same number (server.read_body reads without a ceiling below 1, and
# serve_app_bounded documents 0 as unbounded). This used to compare `> limit`
# with no floor, so the two layers disagreed on exactly the values a caller is
# likeliest to reach for: `0` meant "reject every non-empty body" here and "read
# anything" there, and a negative limit rejected the empty body too. One
# meaning, stated once, obeyed in both places.
## Reject bodies over a byte budget (the bytes, not the code points) before
## the handler sees them. `limit <= 0` is unbounded, the same reading the
## server gives its own ceiling. Routes tagged "raw-body" opt out — an upload is
## bounded in front, by nginx. A policy check, not a memory guard: the server's
## own ceiling (`server.DEFAULT_MAX_BODY`) is what bounds the allocation.
pub fn with_body_limit(limit: Int, next: Handler) -> Handler =
  req =>
  if limit > 0 && route_has_tag(req, "raw-body") == false && bytes.len(req.raw) > limit {
    Err(http_error(413, "request body exceeds $limit bytes"))
  } else {
    next(req)
  }

# `origins` is a comma-separated allow-list; the request's Origin is
# echoed when it is in the list (browsers require an exact echo, not "*", with
# credentials), matching FastAPI's CORSMiddleware — so both http://localhost:5173
# and http://127.0.0.1:5173 work in dev. Allow-Credentials is sent (FastAPI has
# allow_credentials=True). Routes tagged "no-cors" (WebDAV) are not browser
# traffic: nothing is stamped and every method, OPTIONS included, reaches the
# route.
# The stamp goes on the Err branch too. It used to be written `next(req)?`,
# which is exactly the shape that skips it: `?` hands the Err straight to the
# server, which renders it outside the middleware chain, so every 4xx/5xx left
# without a single Access-Control-* header. A browser then refuses to let the
# page read the response it just got — the request succeeded at the network
# level and the error body is unreachable, which is the one case where reading
# it matters most. An `HttpError` carries its own headers (they ride onto the
# rendered response, web/types.error_response_with), so the stamp is the same
# list on both branches.
## CORS: answer a browser preflight directly, and stamp Access-Control-* on
## every other answer — the error ones included, or the browser will not let
## the page read them. Only a real preflight is answered here; any other
## OPTIONS is an ordinary request and reaches the application's routes.
pub fn with_cors(origins: String, next: Handler) -> Handler =
  req => {
    let origin = pick_origin(req, cors_list(origins))
    if route_has_tag(req, "no-cors") {
      next(req)
    } else if is_preflight(req) {
      Ok(cors_headers(origin, text(204, "")))
    } else {
      match next(req) {
        Ok(r) -> Ok(cors_headers(origin, r))
        Err(e) -> Err(cors_error_headers(origin, e))
      }
    }
  }

# A CORS preflight is an OPTIONS carrying *both* Origin and
# Access-Control-Request-Method — the two headers the Fetch standard says a
# browser sends before a non-simple cross-origin request. Both are required
# because either alone names something else: a bare OPTIONS is a client asking
# the server what it supports (a WebDAV client reading DAV/Allow, `curl -X
# OPTIONS`), and an OPTIONS with Origin but no request-method header is an
# ordinary cross-origin OPTIONS, not the preflight of one.
#
# This middleware used to answer *every* untagged OPTIONS with a 204 and never
# call the handler, so an application's own OPTIONS route was unreachable
# unless it opted out of CORS entirely.
fn is_preflight(req: Request) -> Bool =
  req.method == "OPTIONS" && header(req, "origin") != None &&
  header(req, "access-control-request-method") != None

fn cors_list(csv: String) -> List[String] = filter(map(str.split(csv, ","), s => str.trim(s)), s => s != "")

# The allow-listed Origin to echo, or None.
#
# This used to fall back to the *first configured* origin when the request's
# Origin was not allow-listed, and stamp Access-Control-Allow-Origin
# unconditionally. The browser does block that response — but a shared cache
# does not: it sees one URL answered with `Allow-Origin: https://a.example` and
# is free to serve that same stored response to a request from
# https://b.example, which then passes the check. Sending no header at all is
# both the correct denial and what FastAPI's CORSMiddleware does.
fn pick_origin(req: Request, allowed: List[String]) -> Option[String] =
  match header(req, "origin") {
    Some(o) -> if list.find(allowed, x => x == o) != None { Some(o) } else { None }
    None -> None
  }

# `Vary: Origin` is not optional once the response body or headers depend on the
# request's Origin — without it a cache keyed on the URL alone will reuse one
# origin's response for another. It is sent even on the denial path, because
# "no CORS headers" is itself an Origin-dependent answer.
#
# One list, so the success and error branches cannot drift apart.
fn cors_pairs(origin: Option[String]) -> List[(String, String)] = {
  let varied = [("Vary", "Origin")]
  match origin {
    None -> varied
    Some(o) -> varied ++ [
      ("Access-Control-Allow-Origin", o),
      ("Access-Control-Allow-Credentials", "true"),
      ("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS"),
      ("Access-Control-Allow-Headers", "Authorization, Content-Type"),
    ]
  }
}

fn cors_headers(origin: Option[String], r: Response) -> Response =
  fold(cors_pairs(origin), r, (acc, h) => {
    let (k, v) = h
    with_header(acc, k, v)
  })

# The same stamp on the error branch. `HttpError.headers` is rendered onto the
# response by web/types.error_response_with, through the same sanitizing
# with_header the Ok branch goes through.
fn cors_error_headers(origin: Option[String], e: HttpError) -> HttpError =
  HttpError { ..e, headers: e.headers ++ cors_pairs(origin) }

# A bare request with the given method and headers; the fields these middleware
# never read stay empty.
fn req_of(method: String, headers: Map[String, List[String]]) -> Request =
  Request {
    method: method, path: "/x", raw_path: "/x", params: map.empty(), query: map.empty(),
    headers: headers, body: "", raw: bytes.utf8(""), body_file: None, route: None,
  }

fn ok_handler(_req: Request) -> Result[Response, HttpError] !io = Ok(text(200, "ok"))

test "CORS sends no Allow-Origin to an origin that is not allow-listed" {
  let app = with_cors("https://a.example, https://b.example", ok_handler)
  let denied = app(req_of("GET", map.from([("origin", ["https://evil.example"])])))
  match denied {
    Ok(r) -> {
      # it used to answer with the *first configured* origin, which a shared
      # cache can then hand to a different origin's request
      assert list.find(r.headers, h => h == ("Access-Control-Allow-Origin", "https://a.example")) == None
      assert list.find(r.headers, h => {
        let (k, _) = h
        k == "Access-Control-Allow-Origin"
      }) == None
      # the denial is still Origin-dependent, so it still has to vary on it
      assert list.find(r.headers, h => h == ("Vary", "Origin")) != None
    }
    Err(_) -> { assert false }
  }
}

test "CORS echoes an allow-listed origin, and always varies on Origin" {
  let app = with_cors("https://a.example, https://b.example", ok_handler)
  match app(req_of("GET", map.from([("origin", ["https://b.example"])]))) {
    Ok(r) -> {
      assert list.find(r.headers, h => h == ("Access-Control-Allow-Origin", "https://b.example")) != None
      assert list.find(r.headers, h => h == ("Access-Control-Allow-Credentials", "true")) != None
      assert list.find(r.headers, h => h == ("Vary", "Origin")) != None
    }
    Err(_) -> { assert false }
  }
  # no Origin header at all: nothing to echo
  match app(req_of("GET", map.empty())) {
    Ok(r) -> {
      assert list.find(r.headers, h => {
        let (k, _) = h
        k == "Access-Control-Allow-Origin"
      }) == None
      assert list.find(r.headers, h => h == ("Vary", "Origin")) != None
    }
    Err(_) -> { assert false }
  }
}

test "CORS answers a real preflight and lets every other OPTIONS through" {
  let app = with_cors("https://a.example", ok_handler)
  # both headers present: a browser preflight, answered here with 204 and the
  # Access-Control-* set — the handler is never reached (it answers 200 "ok")
  let pre = app(req_of("OPTIONS", map.from([
    ("origin", ["https://a.example"]),
    ("access-control-request-method", ["PUT"]),
  ])))
  match pre {
    Ok(r) -> {
      assert r.status == 204
      assert list.find(r.headers, h => h == ("Access-Control-Allow-Origin", "https://a.example")) != None
      assert list.find(r.headers, h => h == ("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")) != None
    }
    Err(_) -> { assert false }
  }
  # a bare OPTIONS is a client asking what the server supports (WebDAV clients
  # read DAV/Allow off one); it used to be swallowed by the 204 above
  match app(req_of("OPTIONS", map.empty())) {
    Ok(r) -> {
      assert r.status == 200
      assert r.body == Text("ok")
    }
    Err(_) -> { assert false }
  }
  # Origin without Access-Control-Request-Method is an ordinary cross-origin
  # OPTIONS, not a preflight: it reaches the route and is stamped like any
  # other response
  match app(req_of("OPTIONS", map.from([("origin", ["https://a.example"])]))) {
    Ok(r) -> {
      assert r.status == 200
      assert r.body == Text("ok")
      assert list.find(r.headers, h => h == ("Access-Control-Allow-Origin", "https://a.example")) != None
    }
    Err(_) -> { assert false }
  }
}

fn failing_handler(_req: Request) -> Result[Response, HttpError] !io =
  Err(HttpError { ..http_error(404, "no such thing"), headers: [("X-Own", "kept")] })

test "CORS stamps the error branch too, not just the successful one" {
  let app = with_cors("https://a.example", failing_handler)
  match app(req_of("GET", map.from([("origin", ["https://a.example"])]))) {
    Ok(_) -> { assert false }
    Err(e) -> {
      # it used to be `next(req)?`, which hands the Err past the stamp: the
      # server renders it outside the chain, so a cross-origin 404 arrived with
      # no Access-Control-* at all and the browser would not let the page read
      # the error body
      assert e.status == 404
      assert list.find(e.headers, h => h == ("Access-Control-Allow-Origin", "https://a.example")) != None
      assert list.find(e.headers, h => h == ("Access-Control-Allow-Credentials", "true")) != None
      assert list.find(e.headers, h => h == ("Vary", "Origin")) != None
      # the error's own headers (a 401's challenge) are not displaced
      assert list.find(e.headers, h => h == ("X-Own", "kept")) != None
    }
  }
  # a disallowed origin gets the same denial on the error branch as on the ok
  # one: no echo, but still Vary, because the answer depends on Origin
  match app(req_of("GET", map.from([("origin", ["https://evil.example"])]))) {
    Ok(_) -> { assert false }
    Err(e) -> {
      assert list.find(e.headers, h => {
        let (k, _) = h
        k == "Access-Control-Allow-Origin"
      }) == None
      assert list.find(e.headers, h => h == ("Vary", "Origin")) != None
    }
  }
  # "no-cors" routes are not browser traffic: the error passes through untouched
  let dav = with_cors("https://a.example", (rq: Request) =>
      Err(http_error(401, "unauthorized")))
  let tagged = Request {
    ..req_of("GET", map.from([("origin", ["https://a.example"])])),
    route: Some(RouteMeta { method: "GET", pattern: "/x", tags: ["no-cors"] }),
  }
  match dav(tagged) {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.headers == [] }
  }
}

test "with_body_limit counts bytes, not code points" {
  let app = with_body_limit(8, ok_handler)
  let mk = (body: String) => Request { ..req_of("POST", map.empty()), body: body, raw: bytes.utf8(body) }
  # 9 ASCII bytes: over
  match app(mk("123456789")) {
    Err(e) -> { assert e.status == 413 }
    Ok(_) -> { assert false }
  }
  # 3 CJK characters is 9 UTF-8 bytes — also over, but str.len said 3 and let it through
  match app(mk("中文字")) {
    Err(e) -> { assert e.status == 413 }
    Ok(_) -> { assert false }
  }
  # 8 bytes exactly: allowed
  match app(mk("12345678")) {
    Ok(r) -> { assert r.status == 200 }
    Err(_) -> { assert false }
  }
}

test "a limit of zero or less is unbounded, the same reading the server gives it" {
  let mk = (body: String) => Request { ..req_of("POST", map.empty()), body: body, raw: bytes.utf8(body) }
  # 0 used to mean "reject every non-empty body" here while server.read_body
  # read the same request without any ceiling at all
  match with_body_limit(0, ok_handler)(mk("123456789")) {
    Ok(r) -> { assert r.status == 200 }
    Err(_) -> { assert false }
  }
  # a negative limit used to reject even the empty body
  match with_body_limit(-1, ok_handler)(mk("")) {
    Ok(r) -> { assert r.status == 200 }
    Err(_) -> { assert false }
  }
  match with_body_limit(-1, ok_handler)(mk("123456789")) {
    Ok(r) -> { assert r.status == 200 }
    Err(_) -> { assert false }
  }
  # and a positive one still bounds
  match with_body_limit(4, ok_handler)(mk("12345")) {
    Err(e) -> { assert e.status == 413 }
    Ok(_) -> { assert false }
  }
}

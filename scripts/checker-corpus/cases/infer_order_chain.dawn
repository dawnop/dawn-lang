# Return inference checks callees first. Every body here has an error of its
# own, so the diagnostics come out in the order the bodies were checked:
# bottom and leaf in the first round, middle in the second, top and
# after_leaf in the third. Declaration order alone would put top first.
fn top() = {
  let a: Int = "one"
  middle() + 1
}
fn middle() = {
  let b: Int = "two"
  bottom() + 1
}
fn bottom() = {
  let c: Int = "three"
  1
}
fn leaf() = {
  let d: Int = "four"
  2
}
fn after_leaf() = {
  let e: Int = "five"
  leaf() + top()
}

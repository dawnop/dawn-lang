# Pattern exhaustiveness via the usefulness algorithm (Maranget 2007; port of
# check/Exhaustive.kt). A match is exhaustive iff a wildcard row is NOT useful
# after all its unguarded rows. The checker lowers its (resolved) AST patterns
# to SPat rows — Kotlin's `SLit(value: Any)` becomes the LitV sum here, and a
# constructor is identified by (adt id, ctor index) against the ADT table.

use std/list
use std/map
use check/semantic_reads
use check/semantic_reads.{FunctionRead, ConstructorHeader}
use check/types.{
  Ty, TyVar, TyAdt, TyTuple, TyList, TyBool, TyInt, TyString, TyError,
  Adts, AdtI, CtorI, adt_of, subst, Eff, prelude_adts, OPTION_ID, opt_ty
}

pub type LitV =
  | LInt(v: Int)
  | LFloat(v: Float)
  | LBool(v: Bool)
  | LStr(v: String)

pub type SPat =
  | SWild
  | SOr(alts: List[SPat])
  | SCtor(adt: Int, ci: Int, subs: List[SPat])
  | SLit(v: LitV)
  | STuple(subs: List[SPat])
  | SList(pre: List[SPat], has_rest: Bool, post: List[SPat])

const USEFUL_STEP_LIMIT: Int = 8192
const USEFUL_ROW_LIMIT: Int = 4096

## Keep recursive query state immutable without coupling this pure algorithm
## to the checker's scopes, diagnostics or allocation state.
pub type ReadState = { adts: Adts, reads: Option[List[FunctionRead]] }

fn constructor_read(state: ReadState, adt: Int, ci: Int) -> (ReadState, (ConstructorHeader, CtorI)) = {
  let info = adt_of(state.adts, adt)
  let header = ConstructorHeader { id: info.id, name: info.name,
    is_record: info.is_record, tparams: info.tparams }
  let ctor = info.ctors[ci]
  let headers = semantic_reads.observe(state.reads, semantic_reads.ConstructorHeaderAnswer(adt, header))
  let fields = semantic_reads.observe(headers, semantic_reads.ConstructorFields(adt, ci, ctor))
  (ReadState { ..state, reads: fields }, (header, ctor))
}

fn slist_arity(pre: List[SPat], post: List[SPat]) -> Int = len(pre) + len(post)

fn wilds(n: Int) -> List[SPat] = {
  var out: List[SPat] = []
  for i in 0..n { out = out ++ [SWild] }
  out
}

fn ctor_at(adts: Adts, adt: Int, ci: Int) -> CtorI = adt_of(adts, adt).ctors[ci]

fn expand_head_row(row: List[SPat], out0: List[List[SPat]]) -> Option[List[List[SPat]]] = {
  var out = out0
  if len(row) == 0 {
    if len(out) >= USEFUL_ROW_LIMIT { return None }
    return Some(out ++ [row])
  }
  match row[0] {
    SOr(alts) -> {
      let tail = list.drop(row, 1)
      for alt in alts {
        match expand_head_row([alt] ++ tail, out) {
          Some(next) -> { out = next }
          None -> return None
        }
      }
      Some(out)
    }
    _ -> {
      if len(out) >= USEFUL_ROW_LIMIT { return None }
      Some(out ++ [row])
    }
  }
}

fn expand_head_ors(matrix: List[List[SPat]]) -> Option[List[List[SPat]]] = {
  var out: List[List[SPat]] = []
  for row in matrix {
    match expand_head_row(row, out) {
      Some(next) -> { out = next }
      None -> return None
    }
  }
  Some(out)
}

## Constructor field types with the column's type arguments substituted in.
fn inst_fields(adts: Adts, adt: Int, ci: Int, column: Ty) -> List[Ty] = {
  let (_, fields) = inst_fields_read(ReadState { adts: adts, reads: None }, adt, ci, column)
  fields
}

fn inst_fields_read(state: ReadState, adt: Int, ci: Int, column: Ty) -> (ReadState, List[Ty]) = {
  let (next, metadata) = constructor_read(state, adt, ci)
  let (a, c) = metadata
  let field_tys = map(c.fields, f => f.ty)
  let answer = match column {
    TyAdt(_, targs) ->
      if len(a.tparams) == 0 {
        field_tys
      } else {
        var m: Map[Int, Ty] = map.empty()
        var i = 0
        for tp in a.tparams {
          match tp {
            TyVar(_, id) ->
              match get(targs, i) {
                Some(arg) -> { m = map.insert(m, id, arg) }
                None -> ()
              }
            _ -> ()
          }
          i = i + 1
        }
        let m2 = m
        let em: Map[Int, Eff] = map.empty()
        map(field_tys, ft => subst(ft, m2, em))
      }
    _ -> field_tys
  }
  (next, answer)
}

test "exhaustive reads retain generic fields and repeated query order" {
  let adts = prelude_adts()
  let initial = ReadState { adts: adts, reads: Some([]) }
  let info = adt_of(adts, OPTION_ID)
  let header = semantic_reads.ConstructorHeaderAnswer(OPTION_ID, ConstructorHeader { id: info.id,
    name: info.name, is_record: info.is_record, tparams: info.tparams })
  let fields = semantic_reads.ConstructorFields(OPTION_ID, 0, info.ctors[0])
  let (next, answer) = inst_fields_read(initial, OPTION_ID, 0, opt_ty(TyInt))
  assert answer == [TyInt] && answer == inst_fields(adts, OPTION_ID, 0, opt_ty(TyInt))
  assert next.reads == Some([header, fields])
  let (again, repeated) = inst_fields_read(next, OPTION_ID, 0, opt_ty(TyBool))
  assert repeated == [TyBool] && again.reads == Some([header, fields, header, fields])
  let (cold, _) = inst_fields_read(ReadState { adts: adts, reads: None }, OPTION_ID, 0, opt_ty(TyInt))
  assert cold.reads == None
}

fn err_tys(n: Int) -> List[Ty] = {
  var out: List[Ty] = []
  for _i in 0..n { out = out ++ [TyError] }
  out
}

fn elem_tys_of(elem: Ty, n: Int) -> List[Ty] = {
  var out: List[Ty] = []
  for _i in 0..n { out = out ++ [elem] }
  out
}

fn all_wild(patterns: List[SPat]) -> Bool = {
  for pattern in patterns {
    match pattern {
      SWild -> ()
      _ -> return false
    }
  }
  true
}

fn complete_ctor_alts(adts: Adts, patterns: List[SPat], adt: Int) -> Bool = {
  let (_, answer) = complete_ctor_alts_read(ReadState { adts: adts, reads: None }, patterns, adt)
  answer
}

fn complete_ctor_alts_read(state: ReadState, patterns: List[SPat], adt: Int) -> (ReadState, Bool) = {
  let count = len(adt_of(state.adts, adt).ctors)
  let next = ReadState { ..state, reads: semantic_reads.observe(state.reads, semantic_reads.ConstructorCount(adt, count)) }
  var ci = 0
  while ci < count {
    var found = false
    for pattern in patterns {
      match pattern {
        SCtor(found_adt, found_ci, subs) ->
          if found_adt == adt && found_ci == ci && all_wild(subs) { found = true }
        _ -> ()
      }
    }
    if not found { return (next, false) }
    ci = ci + 1
  }
  (next, count > 0)
}

test "exhaustive reads retain constructor counts before incomplete alternatives" {
  let adts = prelude_adts()
  let initial = ReadState { adts: adts, reads: Some([]) }
  for complete in [false, true] {
    let first = SCtor(OPTION_ID, 0, [SWild])
    let patterns = if complete { [first, SCtor(OPTION_ID, 1, [])] } else { [first] }
    let (next, answer) = complete_ctor_alts_read(initial, patterns, OPTION_ID)
    assert answer == complete && answer == complete_ctor_alts(adts, patterns, OPTION_ID)
    assert next.reads == Some([semantic_reads.ConstructorCount(OPTION_ID, 2)])
  }
}

fn simplify_pat(adts: Adts, pattern: SPat, column: Ty) -> SPat = {
  let (_, answer) = simplify_pat_read(ReadState { adts: adts, reads: None }, pattern, column)
  answer
}

fn simplify_pat_read(state: ReadState, pattern: SPat, column: Ty) -> (ReadState, SPat) = {
  var next = state
  let answer = match pattern {
    SWild -> SWild
    SLit(_) -> pattern
    SOr(alts) -> {
      var flat: List[SPat] = []
      for alt in alts {
        let (observed, simplified) = simplify_pat_read(next, alt, column)
        next = observed
        match simplified {
          SWild -> return (next, SWild)
          SOr(inner) -> { flat = flat ++ inner }
          _ -> { flat = flat ++ [simplified] }
        }
      }
      if column == TyBool {
        var has_true = false
        var has_false = false
        for alt in flat {
          match alt {
            SLit(LBool(true)) -> { has_true = true }
            SLit(LBool(false)) -> { has_false = true }
            _ -> ()
          }
        }
        if has_true && has_false { return (next, SWild) }
      }
      match column {
        TyAdt(adt, _) -> {
          let (observed, complete) = complete_ctor_alts_read(next, flat, adt)
          next = observed
          if complete { return (next, SWild) }
        }
        _ -> ()
      }
      if len(flat) == 1 { flat[0] } else { SOr(flat) }
    }
    SCtor(adt, ci, subs) -> {
      let (fields_state, field_tys) = inst_fields_read(next, adt, ci, column)
      next = fields_state
      var simplified: List[SPat] = []
      var index = 0
      for sub in subs {
        let field_ty = match get(field_tys, index) {
          Some(found) -> found
          None -> TyError
        }
        let (observed, value) = simplify_pat_read(next, sub, field_ty)
        next = observed
        simplified = simplified ++ [value]
        index = index + 1
      }
      match column {
        TyAdt(found_adt, _) -> {
          var single = false
          if found_adt == adt {
            let count = len(adt_of(next.adts, adt).ctors)
            next = ReadState { ..next, reads: semantic_reads.observe(next.reads, semantic_reads.ConstructorCount(adt, count)) }
            single = count == 1
          }
          if single && all_wild(simplified) {
            SWild
          } else {
            SCtor(adt, ci, simplified)
          }
        }
        _ -> SCtor(adt, ci, simplified)
      }
    }
    STuple(subs) -> {
      let elem_tys = match column {
        TyTuple(found) -> found
        _ -> err_tys(len(subs))
      }
      var simplified: List[SPat] = []
      var index = 0
      for sub in subs {
        let elem_ty = match get(elem_tys, index) {
          Some(found) -> found
          None -> TyError
        }
        let (observed, value) = simplify_pat_read(next, sub, elem_ty)
        next = observed
        simplified = simplified ++ [value]
        index = index + 1
      }
      match column {
        TyTuple(_) -> if all_wild(simplified) { SWild } else { STuple(simplified) }
        _ -> STuple(simplified)
      }
    }
    SList(pre, has_rest, post) -> {
      let elem_ty = match column {
        TyList(found) -> found
        _ -> TyError
      }
      var simplified_pre: List[SPat] = []
      for sub in pre {
        let (observed, value) = simplify_pat_read(next, sub, elem_ty)
        next = observed
        simplified_pre = simplified_pre ++ [value]
      }
      var simplified_post: List[SPat] = []
      for sub in post {
        let (observed, value) = simplify_pat_read(next, sub, elem_ty)
        next = observed
        simplified_post = simplified_post ++ [value]
      }
      if has_rest && len(simplified_pre) == 0 && len(simplified_post) == 0 {
        SWild
      } else {
        SList(simplified_pre, has_rest, simplified_post)
      }
    }
  }
  (next, answer)
}

test "exhaustive reads preserve recursive simplification and wildcard short circuits" {
  let adts = prelude_adts()
  let initial = ReadState { adts: adts, reads: Some([]) }
  let column = opt_ty(TyInt)
  let ctor = SCtor(OPTION_ID, 0, [SWild])
  let info = adt_of(adts, OPTION_ID)
  let reads = [semantic_reads.ConstructorHeaderAnswer(OPTION_ID, ConstructorHeader { id: info.id,
    name: info.name, is_record: info.is_record, tparams: info.tparams }),
    semantic_reads.ConstructorFields(OPTION_ID, 0, info.ctors[0]), semantic_reads.ConstructorCount(OPTION_ID, 2)]
  let pattern = SOr([ctor, SWild, SCtor(999999, 0, [])])
  let (next, answer) = simplify_pat_read(initial, pattern, column)
  assert answer == SWild && next.reads == Some(reads)
  assert answer == simplify_pat(adts, pattern, column)
  let (matrix_state, rows) = simplify_matrix_read(initial, [[ctor], [ctor]], [column])
  assert rows == [[ctor], [ctor]] && matrix_state.reads == Some(reads ++ reads)
  let (list_state, list_pattern) = simplify_pat_read(initial, SList([ctor], true, [ctor]), TyList(column))
  assert list_pattern == SList([ctor], true, [ctor]) && list_state.reads == Some(reads ++ reads)
}

fn simplify_row(adts: Adts, row: List[SPat], types_: List[Ty]) -> List[SPat] = {
  let (_, answer) = simplify_row_read(ReadState { adts: adts, reads: None }, row, types_)
  answer
}

fn simplify_row_read(state: ReadState, row: List[SPat], types_: List[Ty]) -> (ReadState, List[SPat]) = {
  var next = state
  var out: List[SPat] = []
  var index = 0
  for pattern in row {
    let column = match get(types_, index) {
      Some(found) -> found
      None -> TyError
    }
    let (observed, value) = simplify_pat_read(next, pattern, column)
    next = observed
    out = out ++ [value]
    index = index + 1
  }
  (next, out)
}

fn simplify_matrix(
  adts: Adts,
  matrix: List[List[SPat]],
  types_: List[Ty]
) -> List[List[SPat]] = {
  let (_, answer) = simplify_matrix_read(ReadState { adts: adts, reads: None }, matrix, types_)
  answer
}

fn simplify_matrix_read(state: ReadState, matrix: List[List[SPat]], types_: List[Ty]) -> (ReadState, List[List[SPat]]) = {
  var next = state
  var out: List[List[SPat]] = []
  for row in matrix {
    let (observed, value) = simplify_row_read(next, row, types_)
    next = observed
    out = out ++ [value]
  }
  (next, out)
}

## Would a value matching `q` slip through every row of `matrix`? `None`
## means the deterministic work budget was exhausted before the answer was
## known; callers must diagnose that state rather than guess either answer.
pub fn useful_result(
  adts: Adts,
  matrix: List[List[SPat]],
  q: List[SPat],
  types_: List[Ty]
) -> Option[Bool] = {
  let (_, result) = useful_result_read(ReadState { adts: adts, reads: None }, matrix, q, types_)
  result
}

pub fn useful_result_read(state: ReadState, matrix: List[List[SPat]], q: List[SPat], types_: List[Ty]) -> (ReadState, Option[Bool]) = {
  let (matrix_state, normalized_matrix) = simplify_matrix_read(state, matrix, types_)
  let (query_state, normalized_q) = simplify_row_read(matrix_state, q, types_)
  let (next, remaining, result) = useful_go(query_state, normalized_matrix, normalized_q, types_, USEFUL_STEP_LIMIT)
  (next, result)
}

test "exhaustive reads retain both normalization contexts at the public boundary" {
  let adts = prelude_adts()
  let info = adt_of(adts, OPTION_ID)
  let header = semantic_reads.ConstructorHeaderAnswer(OPTION_ID, ConstructorHeader { id: info.id,
    name: info.name, is_record: info.is_record, tparams: info.tparams })
  let fields = semantic_reads.ConstructorFields(OPTION_ID, 0, info.ctors[0])
  let count = semantic_reads.ConstructorCount(OPTION_ID, 2)
  let arity = semantic_reads.ConstructorArity(OPTION_ID, 0, 1)
  let ctor = SCtor(OPTION_ID, 0, [SWild])
  let initial = ReadState { adts: adts, reads: Some([]) }
  let (empty, empty_answer) = useful_result_read(initial, [], [ctor], [opt_ty(TyInt)])
  assert empty_answer == Some(true)
  assert empty.reads == Some([header, fields, count, arity, header, fields])
  let (covered, covered_answer) = useful_result_read(initial, [[ctor]], [ctor], [opt_ty(TyInt)])
  assert covered_answer == Some(false)
  assert covered.reads == Some([header, fields, count, header, fields, count, arity, header, fields])
}

pub fn useful(adts: Adts, matrix: List[List[SPat]], q: List[SPat], types_: List[Ty]) -> Bool =
  match useful_result(adts, matrix, q, types_) {
    Some(result) -> result
    None -> panic("usefulness exceeded its deterministic work budget")
  }

fn useful_go(
  state: ReadState,
  matrix: List[List[SPat]],
  q: List[SPat],
  types_: List[Ty],
  fuel: Int
) -> (ReadState, Int, Option[Bool]) = {
  var observed = state
  if fuel <= 0 || len(matrix) > USEFUL_ROW_LIMIT { return (observed, 0, None) }
  let expanded = match expand_head_ors(matrix) {
    Some(rows) -> rows
    None -> return (observed, 0, None)
  }
  let cost = len(expanded) + 1
  if fuel < cost { return (observed, 0, None) }
  let left0 = fuel - cost
  if len(q) == 0 { return (observed, left0, Some(len(expanded) == 0)) }
  let column = types_[0]
  let rest_q = list.drop(q, 1)
  let rest_t = list.drop(types_, 1)
  match q[0] {
    SOr(alts) -> {
      var left = left0
      for alt in alts {
        let (next_state, next, result) = useful_go(observed, expanded, [alt] ++ rest_q, types_, left)
        observed = next_state
        left = next
        match result {
          Some(true) -> return (observed, left, Some(true))
          Some(false) -> ()
          None -> return (observed, left, None)
        }
      }
      (observed, left, Some(false))
    }
    SCtor(adt, ci, subs) -> {
      let (specialized_state, specialized) = spec_ctor_read(observed, expanded, adt, ci)
      let (field_state, fields) = inst_fields_read(specialized_state, adt, ci, column)
      useful_go(field_state, specialized, subs ++ rest_q, fields ++ rest_t, left0)
    }
    SLit(value) -> useful_go(observed, spec_lit(expanded, value), rest_q, rest_t, left0)
    STuple(subs) -> {
      let elem_tys = match column {
        TyTuple(elems) -> if len(elems) == 0 { err_tys(len(subs)) } else { elems }
        _ -> err_tys(len(subs))
      }
      useful_go(observed, spec_tuple(expanded, len(subs)), subs ++ rest_q,
        elem_tys ++ rest_t, left0)
    }
    SList(pre, has_rest, post) -> {
      let elem = match column {
        TyList(found) -> found
        _ -> TyError
      }
      if not has_rest {
        let arity = len(pre)
        useful_go(observed, spec_list(expanded, arity), pre ++ rest_q,
          elem_tys_of(elem, arity) ++ rest_t, left0)
      } else {
        let arity = slist_arity(pre, post)
        let bound = list_len_bound(expanded, Some(q[0]))
        var left = left0
        var length = arity
        while length <= bound {
          let (next_state, next, result) = useful_go(observed, spec_list(expanded, length),
            pre ++ wilds(length - arity) ++ post ++ rest_q,
            elem_tys_of(elem, length) ++ rest_t, left)
          observed = next_state
          left = next
          match result {
            Some(true) -> return (observed, left, Some(true))
            Some(false) -> ()
            None -> return (observed, left, None)
          }
          length = length + 1
        }
        (observed, left, Some(false))
      }
    }
    SWild -> {
      match column {
        TyList(elem) -> {
          let bound = list_len_bound(expanded, None)
          var left = left0
          var length = 0
          while length <= bound {
            let (next_state, next, result) = useful_go(observed, spec_list(expanded, length),
              wilds(length) ++ rest_q, elem_tys_of(elem, length) ++ rest_t, left)
            observed = next_state
            left = next
            match result {
              Some(true) -> return (observed, left, Some(true))
              Some(false) -> ()
              None -> return (observed, left, None)
            }
            length = length + 1
          }
          return (observed, left, Some(false))
        }
        TyTuple(elems) ->
          return useful_go(observed, spec_tuple(expanded, len(elems)),
            wilds(len(elems)) ++ rest_q, elems ++ rest_t, left0)
        TyAdt(aid, _) -> {
          let adt = adt_of(observed.adts, aid)
          observed = ReadState { ..observed, reads: semantic_reads.observe(observed.reads, semantic_reads.ConstructorCount(aid, len(adt.ctors))) }
          if heads_complete(expanded, aid, len(adt.ctors)) {
            var left = left0
            var ci = 0
            for ctor in adt.ctors {
              let (specialized_state, specialized) = spec_ctor_read(observed, expanded, aid, ci)
              let arity_state = ReadState { ..specialized_state, reads: semantic_reads.observe(specialized_state.reads, semantic_reads.ConstructorArity(aid, ci, len(ctor.fields))) }
              let (field_state, fields) = inst_fields_read(arity_state, aid, ci, column)
              let (next_state, next, result) = useful_go(field_state, specialized,
                wilds(len(ctor.fields)) ++ rest_q, fields ++ rest_t, left)
              observed = next_state
              left = next
              match result {
                Some(true) -> return (observed, left, Some(true))
                Some(false) -> ()
                None -> return (observed, left, None)
              }
              ci = ci + 1
            }
            return (observed, left, Some(false))
          }
        }
        _ ->
          if column == TyBool && lit_has(expanded, LBool(true)) &&
          lit_has(expanded, LBool(false)) {
            let (true_state, after_true, true_result) = useful_go(
              observed, spec_lit(expanded, LBool(true)), rest_q, rest_t, left0)
            match true_result {
              Some(true) -> return (true_state, after_true, Some(true))
              None -> return (true_state, after_true, None)
              Some(false) -> ()
            }
            return useful_go(
              true_state, spec_lit(expanded, LBool(false)), rest_q, rest_t, after_true)
          }
      }
      var defaulted: List[List[SPat]] = []
      for row in expanded {
        match row[0] {
          SWild -> { defaulted = defaulted ++ [list.drop(row, 1)] }
          _ -> ()
        }
      }
      useful_go(observed, defaulted, rest_q, rest_t, left0)
    }
  }
}

test "exhaustive reads retain usefulness state across answers and exhausted fuel" {
  let adts = prelude_adts()
  let initial = ReadState { adts: adts, reads: Some([]) }
  let info = adt_of(adts, OPTION_ID)
  let header = semantic_reads.ConstructorHeaderAnswer(OPTION_ID, ConstructorHeader { id: info.id,
    name: info.name, is_record: info.is_record, tparams: info.tparams })
  let fields = semantic_reads.ConstructorFields(OPTION_ID, 0, info.ctors[0])
  let arity = semantic_reads.ConstructorArity(OPTION_ID, 0, 1)
  let ctor = SCtor(OPTION_ID, 0, [SWild])
  let (hit, hit_left, hit_answer) = useful_go(initial, [], [ctor], [opt_ty(TyInt)], 100)
  assert hit_answer == Some(true) && hit_left == 97
  assert hit.reads == Some([arity, header, fields])
  let (covered, covered_left, covered_answer) = useful_go(initial, [[ctor]], [ctor], [opt_ty(TyInt)], 100)
  assert covered_answer == Some(false) && covered_left == 94
  assert covered.reads == hit.reads
  let (unknown, unknown_left, unknown_answer) = useful_go(initial, [], [ctor], [opt_ty(TyInt)], 1)
  assert unknown_answer == None && unknown_left == 0
  assert unknown.reads == hit.reads
  let (stopped, stopped_left, stopped_answer) = useful_go(hit, [], [SCtor(999999, 0, [])], [TyError], 0)
  assert stopped_answer == None && stopped_left == 0 && stopped.reads == hit.reads
  let (short, short_left, short_answer) = useful_go(initial, [], [SOr([ctor, SCtor(999999, 0, [])])], [opt_ty(TyInt)], 100)
  assert short_answer == Some(true) && short_left == 96 && short.reads == hit.reads
  var oversized: List[List[SPat]] = []
  for i in 0..(USEFUL_ROW_LIMIT + 1) { oversized = oversized ++ [[SWild]] }
  let (row_stop, row_left, row_answer) = useful_go(hit, oversized, [SCtor(999999, 0, [])], [TyError], 100)
  assert row_answer == None && row_left == 0 && row_stop.reads == hit.reads
}

test "exhaustive reads retain complete constructor traversal order" {
  let adts = prelude_adts()
  let initial = ReadState { adts: adts, reads: Some([]) }
  let info = adt_of(adts, OPTION_ID)
  let header = semantic_reads.ConstructorHeaderAnswer(OPTION_ID, ConstructorHeader { id: info.id,
    name: info.name, is_record: info.is_record, tparams: info.tparams })
  let some_arity = semantic_reads.ConstructorArity(OPTION_ID, 0, 1)
  let none_arity = semantic_reads.ConstructorArity(OPTION_ID, 1, 0)
  let rows = [[SCtor(OPTION_ID, 0, [SWild])], [SCtor(OPTION_ID, 1, [])]]
  let (next, remaining, answer) = useful_go(initial, rows, [SWild], [opt_ty(TyInt)], 100)
  assert answer == Some(false) && remaining == 91
  assert next.reads == Some([semantic_reads.ConstructorCount(OPTION_ID, 2),
    some_arity, some_arity, header, semantic_reads.ConstructorFields(OPTION_ID, 0, info.ctors[0]),
    none_arity, none_arity, header, semantic_reads.ConstructorFields(OPTION_ID, 1, info.ctors[1])])
}

fn heads_complete(matrix: List[List[SPat]], adt: Int, nctors: Int) -> Bool = {
  var seen: List[Int] = []
  for row in matrix {
    match row[0] {
      SCtor(a, ci, _) ->
        if a == adt && not has_int(seen, ci) { seen = seen ++ [ci] }
      _ -> ()
    }
  }
  len(seen) == nctors
}

fn has_int(xs: List[Int], x: Int) -> Bool = {
  for y in xs {
    if y == x { return true }
  }
  false
}

fn lit_has(matrix: List[List[SPat]], v: LitV) -> Bool = {
  for row in matrix {
    match row[0] {
      SLit(w) -> if w == v { return true }
      _ -> ()
    }
  }
  false
}

fn spec_ctor(adts: Adts, matrix: List[List[SPat]], adt: Int, ci: Int) -> List[List[SPat]] = {
  let (_, rows) = spec_ctor_read(ReadState { adts: adts, reads: None }, matrix, adt, ci)
  rows
}

fn spec_ctor_read(state: ReadState, matrix: List[List[SPat]], adt: Int, ci: Int) -> (ReadState, List[List[SPat]]) = {
  let nfields = len(ctor_at(state.adts, adt, ci).fields)
  let next = ReadState { ..state, reads: semantic_reads.observe(state.reads, semantic_reads.ConstructorArity(adt, ci, nfields)) }
  var out: List[List[SPat]] = []
  for row in matrix {
    match row[0] {
      SWild -> { out = out ++ [wilds(nfields) ++ list.drop(row, 1)] }
      SCtor(a, c, subs) ->
        if a == adt && c == ci { out = out ++ [subs ++ list.drop(row, 1)] }
      _ -> ()
    }
  }
  (next, out)
}

test "exhaustive reads preserve constructor specialization and wildcard expansion" {
  let adts = prelude_adts()
  let matrix = [[SWild, SLit(LInt(1))], [SCtor(OPTION_ID, 0, [SLit(LInt(2))]), SWild],
    [SCtor(OPTION_ID, 1, []), SWild]]
  let (next, rows) = spec_ctor_read(ReadState { adts: adts, reads: Some([]) }, matrix, OPTION_ID, 0)
  assert rows == [[SWild, SLit(LInt(1))], [SLit(LInt(2)), SWild]]
  assert rows == spec_ctor(adts, matrix, OPTION_ID, 0)
  assert next.reads == Some([semantic_reads.ConstructorArity(OPTION_ID, 0, 1)])
}

fn spec_lit(matrix: List[List[SPat]], v: LitV) -> List[List[SPat]] = {
  var out: List[List[SPat]] = []
  for row in matrix {
    match row[0] {
      SWild -> { out = out ++ [list.drop(row, 1)] }
      SLit(w) -> if w == v { out = out ++ [list.drop(row, 1)] }
      _ -> ()
    }
  }
  out
}

fn spec_tuple(matrix: List[List[SPat]], n: Int) -> List[List[SPat]] = {
  var out: List[List[SPat]] = []
  for row in matrix {
    match row[0] {
      SWild -> { out = out ++ [wilds(n) ++ list.drop(row, 1)] }
      STuple(subs) -> { out = out ++ [subs ++ list.drop(row, 1)] }
      _ -> ()
    }
  }
  out
}

## Specialize a list column to exactly `n` elements (a rest expands to wildcards).
fn spec_list(matrix: List[List[SPat]], n: Int) -> List[List[SPat]] = {
  var out: List[List[SPat]] = []
  for row in matrix {
    match row[0] {
      SWild -> { out = out ++ [wilds(n) ++ list.drop(row, 1)] }
      SList(pre, has_rest, post) ->
        if not has_rest {
          if len(pre) == n { out = out ++ [pre ++ list.drop(row, 1)] }
        } else if slist_arity(pre, post) <= n {
          out = out ++ [pre ++ wilds(n - slist_arity(pre, post)) ++ post ++ list.drop(row, 1)]
        }
      _ -> ()
    }
  }
  out
}

## One past the longest list pattern in play: lengths beyond behave uniformly.
fn list_len_bound(matrix: List[List[SPat]], q: Option[SPat]) -> Int = {
  var m = 0
  for row in matrix {
    if len(row) > 0 {
      match row[0] {
        SList(pre, has_rest, post) -> {
          let x = if has_rest { slist_arity(pre, post) } else { len(pre) }
          if x > m { m = x }
        }
        _ -> ()
      }
    }
  }
  match q {
    Some(SList(pre, has_rest, post)) -> {
      let x = if has_rest { slist_arity(pre, post) } else { len(pre) }
      if x > m { m = x }
    }
    _ -> ()
  }
  m + 1
}

## Witnesses for a non-exhaustive match over a list: [], [_], [_, _, ..] ...
pub fn missing_list_patterns_result(
  adts: Adts,
  rows: List[List[SPat]],
  t: Ty
) -> Option[List[String]] = {
  let (_, answer) = missing_list_patterns_result_read(ReadState { adts: adts, reads: None }, rows, t)
  answer
}

pub fn missing_list_patterns_result_read(state: ReadState, rows: List[List[SPat]], t: Ty) -> (ReadState, Option[List[String]]) = {
  var observed = state
  let bound = list_len_bound(rows, None)
  var missing: List[String] = []
  var l = 0
  while l <= bound {
    let q = SList(wilds(l), false, [])
    let (next, answer) = useful_result_read(observed, rows, [q], [t])
    observed = next
    match answer {
      Some(true) -> {
        var elems: List[String] = []
        for _i in 0..l { elems = elems ++ ["_"] }
        if l == bound { elems = elems ++ [".."] }
        missing = missing ++ ["[" ++ join(elems, ", ") ++ "]"]
      }
      Some(false) -> ()
      None -> return (observed, None)
    }
    l = l + 1
  }
  (observed, Some(missing))
}

test "exhaustive reads retain repeated missing-list probes" {
  let adts = prelude_adts()
  let info = adt_of(adts, OPTION_ID)
  let header = semantic_reads.ConstructorHeaderAnswer(OPTION_ID, ConstructorHeader { id: info.id,
    name: info.name, is_record: info.is_record, tparams: info.tparams })
  let fields = semantic_reads.ConstructorFields(OPTION_ID, 0, info.ctors[0])
  let count = semantic_reads.ConstructorCount(OPTION_ID, 2)
  let normalized = [header, fields, count]
  let rows = [[SList([SCtor(OPTION_ID, 0, [SWild])], false, [])]]
  let t = TyList(opt_ty(TyInt))
  let (next, answer) = missing_list_patterns_result_read(ReadState { adts: adts, reads: Some([]) }, rows, t)
  assert answer == Some(["[]", "[_]", "[_, _, ..]"])
  assert next.reads == Some(normalized ++ normalized ++ [count] ++ normalized ++ [count, count])
  let (cold, cold_answer) = missing_list_patterns_result_read(ReadState { adts: adts, reads: None }, rows, t)
  assert cold.reads == None && cold_answer == answer
  assert missing_list_patterns_result(adts, rows, t) == answer
}

pub fn missing_list_patterns(adts: Adts, rows: List[List[SPat]], t: Ty) -> List[String] =
  match missing_list_patterns_result(adts, rows, t) {
    Some(patterns) -> patterns
    None -> panic("missing-list analysis exceeded its deterministic work budget")
  }

# ---- tests ----

test "an option match missing None is caught" {
  let adts = prelude_adts()
  # match on Option[Int] with only Some(_) covered
  let rows = [[SCtor(OPTION_ID, 0, [SWild])]]
  assert useful(adts, rows, [SWild], [opt_ty(TyInt)])
  # adding None makes it exhaustive
  let rows2 = rows ++ [[SCtor(OPTION_ID, 1, [])]]
  assert not useful(adts, rows2, [SWild], [opt_ty(TyInt)])
}

test "bool literals complete a match" {
  let adts = prelude_adts()
  let rows = [[SLit(LBool(true))], [SLit(LBool(false))]]
  assert not useful(adts, rows, [SWild], [TyBool])
  assert useful(adts, [[SLit(LBool(true))]], [SWild], [TyBool])
}

test "or-patterns stay structured through constructors, tuples, and lists" {
  let adts = prelude_adts()
  let bools = SOr([SLit(LBool(true)), SLit(LBool(false))])
  assert not useful(adts, [[bools]], [SWild], [TyBool])

  let option_row = [SOr([
    SCtor(OPTION_ID, 0, [bools]),
    SCtor(OPTION_ID, 1, [])
  ])]
  assert not useful(adts, [option_row], [SWild], [opt_ty(TyBool)])

  let tuple_row = [STuple([bools, SWild])]
  assert not useful(adts, [tuple_row], [SWild], [TyTuple([TyBool, TyString])])

  let list_row = [SOr([
    SList([], false, []),
    SList([SWild], true, [])
  ])]
  assert not useful(adts, [list_row], [SWild], [TyList(TyInt)])
}

test "complete boolean alternatives normalize before recursive expansion" {
  let adts = prelude_adts()
  let bools = SOr([SLit(LBool(true)), SLit(LBool(false))])
  var elems: List[SPat] = []
  for _i in 0..24 { elems = elems ++ [bools] }
  let rows = [[SList(elems, false, [])], [SWild]]
  assert useful_result(adts, rows, [SWild], [TyList(TyBool)]) == Some(false)
}

test "pathological alternatives exhaust the deterministic work budget" {
  let adts = prelude_adts()
  let branch = SOr([
    SCtor(OPTION_ID, 0, [SLit(LBool(true))]),
    SCtor(OPTION_ID, 0, [SLit(LBool(false))]),
    SCtor(OPTION_ID, 1, [])
  ])
  var elems: List[SPat] = []
  var types_: List[Ty] = []
  for _i in 0..8 {
    elems = elems ++ [branch]
    types_ = types_ ++ [opt_ty(TyBool)]
  }
  assert useful_result(adts, [[STuple(elems)]], [SWild], [TyTuple(types_)]) == None
}

test "int literals are never complete" {
  let adts = prelude_adts()
  let rows = [[SLit(LInt(1))], [SLit(LInt(2))]]
  assert useful(adts, rows, [SWild], [TyInt])
}

test "list patterns probe lengths" {
  let adts = prelude_adts()
  # [] and [x, ..rest] together are exhaustive
  let rows = [[SList([], false, [])], [SList([SWild], true, [])]]
  assert not useful(adts, rows, [SWild], [TyList(TyInt)])
  # [] and [x] leave two-element lists uncovered
  let rows2 = [[SList([], false, [])], [SList([SWild], false, [])]]
  assert useful(adts, rows2, [SWild], [TyList(TyInt)])
  assert missing_list_patterns(adts, rows2, TyList(TyInt)) == ["[_, _, ..]"]
}

test "tuples decompose into their elements" {
  let adts = prelude_adts()
  let rows = [[STuple([SLit(LBool(true)), SWild])], [STuple([SLit(LBool(false)), SWild])]]
  assert not useful(adts, rows, [SWild], [TyTuple([TyBool, TyString])])
}

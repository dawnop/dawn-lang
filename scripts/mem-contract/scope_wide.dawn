# Scope arguments extend the physical ABI without reducing the eight value slots.
fn invoke(f: fn[@s](Int, Int, Int, Int, Int, Int, Int, Int) -> Int) -> Int =
  f(1, 2, 3, 4, 5, 6, 7, 8)
pub fn main() -> Unit !io = println(to_string(invoke(
  [@t] (a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int) => a + b + c + d + e + f + g + h)))

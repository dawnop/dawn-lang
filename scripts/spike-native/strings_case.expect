-- ascii is the part that already agreed --
abcXYZ   upper=ABCXYZ lower=abcxyz len=6 ulen=6 llen=6
digits   upper=42!? lower=42!? len=4 ulen=4 llen=4
-- latin-1: the JVM folded these, native did not --
e-acute  upper=É lower=é len=1 ulen=1 llen=1
o-slash  upper=Ø lower=ø len=1 ulen=1 llen=1
-- length-changing full mappings, which simple mapping refuses --
sharp-s  upper=ß lower=ß len=1 ulen=1 llen=1
I-dot    upper=İ lower=i len=1 ulen=1 llen=1
dotless  upper=I lower=ı len=1 ulen=1 llen=1
-- greek and cyrillic --
sigma    upper=Σ lower=σ len=1 ulen=1 llen=1
Sigma    upper=Σ lower=σ len=1 ulen=1 llen=1
cyr-ya   upper=Я lower=я len=1 ulen=1 llen=1
-- above the BMP: a case pair that is not one UTF-16 unit --
deseret  upper=𐐀 lower=𐐨 len=1 ulen=1 llen=1
deser-l  upper=𐐀 lower=𐐨 len=1 ulen=1 llen=1
math-A   upper=𝐀 lower=𝐀 len=1 ulen=1 llen=1
-- uncased scripts are left alone --
han      upper=中文 lower=中文 len=2 ulen=2 llen=2
-- a mixed sentence --
mixed    upper=AÉ中𝐀ß lower=aé中𝐀ß len=5 ulen=5 llen=5
-- the invariant: simple mapping preserves the code-point count --
sample len         = 11
upper preserves    = true
lower preserves    = true
upper idempotent   = true
lower idempotent   = true
-- the same expression, folded and live --
folded upper       = AÉ中𝐀ßIİΣЯ𐐀𐐀
live   upper       = AÉ中𝐀ßIİΣЯ𐐀𐐀
upper agrees       = true
lower agrees       = true

# The native driver (docs/native-backend-plan.md §14.1): the shared frontend
# behind a `main` that wires no JVM hook. Everything host-specific is a
# default -- `use java` checking is refused (cx_new's jsig), compile-time
# Java folding is refused (ct_default's jcall), std comes embedded (stdsrc),
# and the C runtime comes embedded too (rtsrc, via cdriver) -- so the binary
# this module compiles to is a complete toolchain with no files of its own.
#
# `build` shells out to the system C compiler: emitting C *is* this
# backend's codegen, and cc is its assembler. Subcommands are a subset of
# the JVM driver's on purpose; what is missing is what needs a JVM
# (`build`-to-jar, `lock`, `cache`, `--vendor`).
#
# `fmt`, `doc` and `add` are wired here as second implementations of the JVM
# driver's argument handling rather than as calls into a shared one, and that
# is deliberate: `scripts/native-cli-diff.sh` holds the two byte for byte, and
# a differential over one shared function proves nothing. The *work* is shared
# (fmt.format, doc.*_json, add.run_add are the same modules); only the driver
# plumbing is doubled.
#
# `server` is one call either way -- there is no argument handling to double --
# and the only thing this driver decides is the `Jsig` the server analyses
# with. The JVM main passes jreflect's, so an editor there resolves `use java`
# imports; this one passes the refusal, which is the same answer this backend
# gives that program under `check`. `scripts/selfhost-lsp-diff.sh` takes
# DAWN_SELF and runs the whole scripted session against this binary.

use std/io
use std/io.{Fs, Proc, Env}
use std/str
use std/bytes
use front/token.{Diag}
use front/diag
use driver/stdlib.{StdCtx, StdLoadError, load_std, std_load_error_text, std_load_is_bug}
use ir/interp.{ct_default}
use check/jsig.{JsigLease, jsig_refused, jsig_refused_lease}
use driver/analyze.{Program, LocDiag, load_file, load_target, analyze_program}
use check/tast.{TModule}
use c/cdriver
use version.{VERSION}
use front/fmt
use doc
use pkg/add
use lsp/server.{LspLeaseHost, run_lsp, lsp_std_flag}
use compiler_plan/pkgfetch
use compiler_plan/procmem
use compiler_plan/envmem
use compiler_plan/envmem.{AskedGet}
use compiler_plan/source

fn native_lsp_standalone_lease() -> JsigLease !io = jsig_refused_lease()

fn native_lsp_target_lease(
  _plan: source.SourcePlan
) -> Result[JsigLease, LocDiag] !io = Ok(jsig_refused_lease())

fn usage() -> String =
  join([
    "dawnc " ++ VERSION ++ ", the Dawn compiler's C backend: Dawn to C to cc.",
    "No JVM is involved at any point, in this binary or in what it produces.",
    "(`dawn build --native` is a different thing with a similar name: it is the",
    "JVM backend's jar packaged ahead of time by GraalVM native-image.)",
    "",
    "usage:",
    "  dawnc check [--std <dir>] <target>...       type-check, report diagnostics",
    "  dawnc build [--std <dir>] <target> [-o out] compile to a native binary via cc",
    "  dawnc build --target wasm <target> [-o out] compile to wasm32-wasip1 via clang",
    "  dawnc build --target wasm --reactor <target> [-o out]",
    "                                              ... as a reactor: no _start, one",
    "                                              exported `dawn_turn` the host calls",
    "  dawnc emitc [--std <dir>] <target> [-o out] emit the C translation unit",
    "  dawnc run   [--std <dir>] <target> [-- <args>...]",
    "                                              compile and run",
    "  dawnc test  [--std <dir>] <target>          compile the test blocks and run them",
    "  dawnc test  [--std <dir>] --stdlib          run the bundled std's own test blocks",
    "  dawnc fmt [--check] <file.dawn | dir>...    format files in place",
    "  dawnc doc <target> | --stdlib | --builtins  emit the API reference as JSON",
    "  dawnc add <spec> [--subdir <p>] [--as <alias>] [--dir <project>]",
    "                                              add a dependency to dawn.toml",
    "  dawnc lsp   [--std <dir>]                   speak LSP over stdin/stdout",
    "  dawnc version                               print the version",
    "",
    "A <target> is a single .dawn file or a project directory (src/main.dawn entry).",
    "`use java` programs are rejected: Java interop needs the JVM toolchain, so",
    "compile those with `dawn` (adding --native if you want one file out of it).",
    "Packaging a jar, `lock` and `cache` need a JVM too and are not subcommands here."
  ], "\n") ++ "\n"

fn fail_usage() -> Unit !io = {
  io.eprint(usage())
  let _ = io.exit(2)
  ()
}

## `--help` in a subcommand's tail. Off the argv surface
## `scripts/native-cli-diff.sh` holds the two drivers to, deliberately and for
## the reason `--target` is: the JVM driver has no per-subcommand help, so this
## is a flag one backend has and the other does not, and the differential
## compares the commands both of them answer.
fn wants_help(rest: List[String]) -> Bool = {
  var found = false
  for a in rest {
    if a == "--help" { found = true }
  }
  found
}

## The usage block's lines for one subcommand, continuation lines included.
##
## Filtered out of `usage()` rather than written a second time. The parsers
## below already spell each command's contract once in the `usage: dawn ...`
## string they fail with, and a third copy is a third thing to forget. An entry
## is a line beginning `  dawnc <cmd> `; the lines under it that belong to it
## are the ones indented past the description column and not starting another
## entry.
fn subcommand_help(cmd: String) -> String = {
  let head = "  dawnc " ++ cmd ++ " "
  var out: List[String] = []
  var keeping = false
  for line in str.split(usage(), "\n") {
    if str.starts_with(line, "  dawnc ") {
      keeping = str.starts_with(line, head)
      if keeping { out = out ++ [line] }
    } else if keeping && str.starts_with(line, "    ") {
      out = out ++ [line]
    } else {
      keeping = false
    }
  }
  join(out, "\n") ++ "\n"
}

fn fail_compile(diags: List[LocDiag]) -> Unit !Fs !io = {
  var pairs: List[(String, Diag)] = []
  for ld in diags { pairs = pairs ++ [(ld.path, ld.d)] }
  io.eprint(diag.render_all(pairs))
  io.eprintln(diag.count_line(len(diags)))
  let _ = io.exit(1)
  ()
}

## The JVM driver's CLI error shape, exit code included: this used to exit 1
## while `main.dawn` exited 2 for the same class of mistake (a missing target,
## a file with the wrong suffix). Nothing compared the two drivers, so the
## divergence sat there; `scripts/native-cli-diff.sh` compares them now.
fn cli_error(msg: String) -> Unit !io = {
  io.eprintln("error: " ++ msg)
  let _ = io.exit(2)
  ()
}

## A std that will not load, said out loud. Only the copy compiled into this
## binary is the compiler's own fault; a directory is the user's environment,
## so it gets `error:` and the CLI exit code rather than a panic reading as
## "reinstall the toolchain". `cli_error` exits, so the panic under it is the
## unreachable value this function's type needs.
fn fail_std(e: StdLoadError) -> StdCtx !Env !io = {
  let text = std_load_error_text(e)
  if std_load_is_bug(e) { panic(text) }
  cli_error(text)
  panic(text)
}

## Refuse a second positional for commands whose contract has one target.
## The wording matches main.dawn: the native driver is a second parser for the
## same command contract, not a second place to invent diagnostics.
fn refuse_second_target(cmd: String, have: String, got: String) -> Unit !io =
  if have != "" {
    cli_error(cmd ++ " takes one target, got `" ++ have ++ "` and `" ++ got ++
        "`; a bare word after the target is not a flag this subcommand knows")
  }

## Require exactly one input mode after parsing. This is duplicated at the
## driver boundary on purpose; native-cli-diff is the executable shared fact.
fn require_one_input(
  cmd: String,
  choices: String,
  usage_text: String,
  selected: Int
) -> Unit !io = {
  if selected == 0 { return cli_error(usage_text) }
  if selected > 1 { return cli_error(cmd ++ " accepts exactly one of " ++ choices) }
}

## `fmt`'s refusal shape: the lexer diagnostics, the count line, and the fact
## that nothing was written. Same words as `main.dawn`'s `fail_fmt`.
fn fail_fmt(pairs: List[(String, Diag)]) -> Unit !Fs !io = {
  io.eprint(diag.render_all(pairs))
  io.eprintln(diag.count_line(len(pairs)))
  io.eprintln("these files do not lex and were left unchanged")
  let _ = io.exit(1)
  ()
}

## Diagnostics without the count line, exit 1 -- `doc`'s failure shape.
fn fail_doc(diags: List[LocDiag]) -> Unit !Fs !io = {
  var pairs: List[(String, Diag)] = []
  for ld in diags { pairs = pairs ++ [(ld.path, ld.d)] }
  io.eprint(diag.render_all(pairs))
  let _ = io.exit(1)
  ()
}

type RunArgs = { std_dir: String, target: String, program_args: List[String] }

fn run_usage() -> String =
  "usage: dawn run [compiler-options] <target> [-- <program-args>...]"

## Independent native parser: compiler options end at the target.
fn parse_run_tail(rest: List[String]) -> RunArgs !io = {
  var std_dir = "std"
  var target = ""
  var seen_target = false
  var program_args: List[String] = []
  var i = 0
  while i < len(rest) && not seen_target {
    if rest[i] == "--std" {
      if i + 1 >= len(rest) { cli_error(run_usage()) }
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--" {
      cli_error(run_usage())
      i = i + 1
    } else {
      target = rest[i]
      seen_target = true
      i = i + 1
    }
  }
  if not seen_target { cli_error(run_usage()) }
  if i < len(rest) {
    if rest[i] != "--" { cli_error(run_usage()) }
    i = i + 1
    while i < len(rest) {
      program_args = program_args ++ [rest[i]]
      i = i + 1
    }
  }
  RunArgs { std_dir: std_dir, target: target, program_args: program_args }
}

## `--std <dir>` and `-o <out>` plus exactly one target, kept out of run.
fn parse_compile_tail(
  cmd: String,
  usage_text: String,
  rest: List[String]
) -> (String, String, String) !io = {
  var std_dir = "std"
  var out = ""
  var target = ""
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "-o" && i + 1 < len(rest) {
      out = rest[i + 1]
      i = i + 2
    } else {
      refuse_second_target(cmd, target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  if target == "" { cli_error(usage_text) }
  (std_dir, out, target)
}

## `build`'s tail: `parse_compile_tail` plus `--target <t>` and `--reactor`. A
## separate parser rather than a flag on the shared one because `emitc` has no
## targets to choose between -- the C text is the same whatever compiles it.
## The only spelling is `wasm` (WASI preview 1 via clang, see `cc_build_for`,
## which picks the triple the compiler in hand actually has a sysroot for);
## native is the default and has no spelling, and the JVM driver has no such
## flag at all, so this stays off the argvs `native-cli-diff.sh` holds the two
## drivers to.
##
## `--reactor` is wasm-only and refused elsewhere, because it is a property of
## the wasm execution model and has no meaning for a process that has a
## `main`.
fn parse_build_tail(
  usage_text: String,
  rest: List[String],
) -> (String, String, String, Bool, Bool) !io = {
  var std_dir = "std"
  var out = ""
  var target = ""
  var wasm = false
  var reactor = false
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "-o" && i + 1 < len(rest) {
      out = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--target" && i + 1 < len(rest) {
      if rest[i + 1] != "wasm" {
        cli_error("unknown --target `" ++ rest[i + 1] ++ "`; this backend knows: wasm")
      }
      wasm = true
      i = i + 2
    } else if rest[i] == "--reactor" {
      reactor = true
      i = i + 1
    } else {
      refuse_second_target("dawn build", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  if target == "" { cli_error(usage_text) }
  if reactor && not wasm {
    cli_error("--reactor needs --target wasm; a native build always has a main")
  }
  (std_dir, out, target, wasm, reactor)
}

## `[--std <dir>] <target>...`, matching main.dawn's public check parser.
fn check_args(rest: List[String]) -> (String, List[String]) = {
  var std_dir = "std"
  var targets: List[String] = []
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else {
      targets = targets ++ [rest[i]]
      i = i + 1
    }
  }
  (std_dir, targets)
}

fn load_or_die(std_dir: String) -> StdCtx !Fs !Env !io =
  match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> fail_std(e)
  }

fn analyzed(std: StdCtx, target: String) -> Program !Fs !Proc !Env !io = {
  if not io.exists(target) {
    cli_error("no such file or directory: " ++ target)
  }
  if not io.is_dir(target) && not str.ends_with(target, ".dawn") {
    cli_error("source files must end in .dawn: " ++ target)
  }
  let loaded = load_target(std, target)
  let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
  if len(prog.diags) > 0 { fail_compile(prog.diags) }
  prog
}

fn emitted(std_dir: String, target: String) -> String !Fs !Proc !Env !io = {
  let std = load_or_die(std_dir)
  let prog = analyzed(std, target)
  match cdriver.c_text(std, prog) {
    Ok(s) -> s
    Err(e) -> {
      cli_error(e ++ " in " ++ target)
      ""
    }
  }
}

## The output name `build` defaults to: the target's basename, extension off.
fn default_out(target: String) -> String = {
  let base = match str.last_index_of(target, "/") {
    Some(i) -> str.drop(target, i + 1)
    None -> target
  }
  let stem = str.strip_suffix(base, ".dawn").unwrap_or(base)
  if stem == "" { "a.out" } else { stem }
}

## Write the C and the embedded runtime into a scratch directory, run cc, and
## leave the binary at `out`. The cc diagnostics stream to this process's
## stderr -- an empty err_path means "inherit", and cc failing is the user's
## compile error to read.
fn cc_build(ctext: String, out: String) -> Unit !Fs !Proc !Env !io = cc_build_for(ctext, out, false, false)

## The reactor's only export, appended to the emitted C.
##
## A wasm reactor is a module the host instantiates once and then calls into,
## and this is the function it calls. Everything about the boundary above it
## -- what a turn means, what crosses -- is in Dawn (packages/tea-dom); all
## that is needed here is a name wasm-ld will export and a call into the
## program's own `main`, which C permits and which is what runs
## `dawn_rt_init` and the Dawn entry point.
##
## Two lines that are not decoration:
##
##   `export_name` rather than a `-Wl,--export` flag, so the exported spelling
##   lives next to the function instead of in an argv the reader has to find.
##
##   `fflush(NULL)` because `dawn_rt_init` puts stdout in full buffering (the
##   native differential compares piped stdout byte for byte and a
##   line-buffered stream reorders against stderr). A process flushes that at
##   exit; a reactor never exits, so a turn's reply would sit in the buffer
##   until the buffer filled. Flushing per turn is the reactor's version of
##   the exit that is not coming.
fn reactor_shim() -> String =
  join([
    "",
    "/* --- reactor entry, appended by `dawnc build --target wasm --reactor` --- */",
    "#include <stdio.h>",
    "__attribute__((export_name(\"dawn_turn\")))",
    "int32_t dawn_turn(void) {",
    "  int rc = main(0, (char **)0);",
    "  fflush(NULL);",
    "  return (int32_t)rc;",
    "}"
  ], "\n") ++ "\n"

## The emitted C, plus the reactor export when one was asked for.
fn reactor_wrapped(ctext: String, reactor: Bool) -> String =
  if reactor { ctext ++ reactor_shim() } else { ctext }

## What a missing wasm toolchain needs, said next to the failure it
## causes: the compile errors clang prints for it (a missing driver, a missing
## sysroot header, a missing compiler-rt) all presume the reader already knows
## the target is cross-compiled, and the first person to hit one will not.
fn wasm_toolchain_hint() -> String =
  "note: `--target wasm` cross-compiles with clang and needs lld, wasi-libc " ++
  "and the wasm32 compiler-rt next to it. On Debian/Ubuntu: apt install " ++
  "clang-20 lld wasi-libc libclang-rt-20-dev-wasm32 (or point DAWN_WASM_CC " ++
  "at a wasi-sdk clang). clang 18 is too old: its assembler crashes on the " ++
  "exception tag in dawn_rt_wasi_tag.c."

## Which wasm triple this compiler has a sysroot for.
##
## `wasm32-wasi` was the only spelling until wasi-sdk 31 deprecated it, and 34
## removed the target outright; apt's wasi-libc, in the other direction, still
## lays out only `wasm32-wasi` and has no `wasm32-wasip1` at all. No single
## hardcoded spelling reaches both ends of that range, so the driver asks
## instead of assuming: `-print-file-name` answers with an absolute path when
## the sysroot has the file and echoes the bare name back when it does not,
## which costs one process and no compile. wasip1 is tried first so a modern
## sdk never has to print the deprecation warning, and an unusable compiler
## falls through to the old spelling and fails in the compile below, where the
## install hint is.
fn wasm_triple(cc: String, work: String) -> String !Fs !Proc = {
  let probe = work ++ "/crt1.path"
  let ask = [cc, "--target=wasm32-wasip1", "-print-file-name=crt1.o"]
  let modern = match io.run(ask, probe, work ++ "/crt1.err") {
    Ok(0) -> {
      match io.read_file(probe) {
        Ok(t) -> io.exists(str.trim(t))
        Err(_) -> false
      }
    }
    _ -> false
  }
  if modern { "wasm32-wasip1" } else { "wasm32-wasi" }
}

## The compiler a target is built with, and the variable that overrides it.
##
## The wasm spelling is clang's and only clang's (cc cross-compiles no wasm),
## so its override is a separate variable rather than CC: one environment can
## hold a native CC and a wasi-sdk clang at the same time.
fn cc_command(wasm: Bool) -> String !Env !io =
  if wasm {
    match io.getenv("DAWN_WASM_CC") {
      Some(c) -> c
      None -> "clang"
    }
  } else {
    match io.getenv("CC") {
      Some(c) -> c
      None -> "cc"
    }
  }

fn cc_build_for(ctext: String, out: String, wasm: Bool, reactor: Bool) -> Unit !Fs !Proc !Env !io =
  cc_build_with(cc_command(wasm), ctext, out, wasm, reactor)

## Stage the C sources and drive `cc` over them.
##
## The compiler is a parameter rather than a second reading of the environment:
## the command lines below are the whole of what this backend hands the
## assembler, and a test can only hold them element by element if the name at
## the front of each is one the test chose (the tests at the bottom of this
## file do exactly that, with `Proc` answered from a table).
fn cc_build_with(
  cc: String,
  ctext: String,
  out: String,
  wasm: Bool,
  reactor: Bool
) -> Unit !Fs !Proc !io = {
  let work = match io.temp_dir("", "dawnc") {
    Ok(d) -> d
    Err(e) -> {
      cli_error("cannot make a scratch directory: " ++ e.message)
      return ()
    }
  }
  var wrote = io.write_file(work ++ "/main.c", ctext)
  for f in ["dawn_rt.c", "dawn_rt.h", "dawn_rt_wasi_eh.cc", "dawn_rt_wasi_tag.c"] {
    match cdriver.runtime_source(f) {
      Some(t) -> { wrote = io.write_file(work ++ "/" ++ f, t) }
      None -> panic("embedded runtime is missing " ++ f)
    }
  }
  match wrote {
    Ok(_) -> ()
    Err(e) -> {
      cli_error("cannot stage the C sources: " ++ e.message)
      return ()
    }
  }
  # The flag differences against the native row are the target's, not choices:
  # no -pthread (wasi-libc has none), and -fwasm-exceptions in place of
  # -fexceptions -- it defines the exception tag dawn_rt.c's raise throws
  # and adds no landing pads to C, so the emitted C compiles unchanged
  # (the failure landing is the A1 shadow stack; see dawn_rt.c).
  let triple = if wasm { wasm_triple(cc, work) } else { "" }
  # The wasm catch site is C++ (runtime/c/dawn_rt_wasi_eh.cc says why) and
  # wants spellings the C row must not carry (-x c++, -fno-rtti), while
  # clang applies one -std to every input of an invocation -- so the shim is
  # its own compile, and the main invocation links its object.
  #
  # The exception tag both sides throw through is a third compile, for the
  # reason dawn_rt_wasi_tag.c gives: a unit that neither throws nor catches
  # is the only place the definition can sit and still link on LLVM 21 and
  # LLVM 22 alike. Its errors carry the same hint as the shim's; it runs
  # second so that a toolchain missing altogether is still diagnosed by the
  # compile that names C++, which is the harder one to have.
  if wasm {
    let shim = [
      cc, "--target=" ++ triple, "-x", "c++", "-std=c++14", "-O2",
      "-fno-rtti", "-fwasm-exceptions",
      "-c", work ++ "/dawn_rt_wasi_eh.cc", "-o", work ++ "/dawn_rt_wasi_eh.o"
    ]
    match io.run(shim, "", "") {
      Ok(0) -> ()
      Ok(code) -> {
        io.eprintln(wasm_toolchain_hint())
        cli_error(cc ++ " failed (exit code " ++ "${code}" ++ ")")
        return ()
      }
      Err(e) -> {
        io.eprintln(wasm_toolchain_hint())
        cli_error("cannot run " ++ cc ++ ": " ++ e.message)
        return ()
      }
    }
    let tag = [
      cc, "--target=" ++ triple, "-std=c11", "-O2",
      "-c", work ++ "/dawn_rt_wasi_tag.c", "-o", work ++ "/dawn_rt_wasi_tag.o"
    ]
    match io.run(tag, "", "") {
      Ok(0) -> ()
      Ok(code) -> {
        io.eprintln(wasm_toolchain_hint())
        cli_error(cc ++ " failed (exit code " ++ "${code}" ++ ")")
        return ()
      }
      Err(e) -> {
        io.eprintln(wasm_toolchain_hint())
        cli_error("cannot run " ++ cc ++ ": " ++ e.message)
        return ()
      }
    }
  }
  # -Wno-parentheses-equality: a clang-only warning the emitted C trips a
  # few hundred times per program (`if ((x == 0))` is the emitter's honest
  # parenthesization). The native row never sees it because gcc has no such
  # warning; real errors still print.
  # A reactor has no `_start`: wasi-libc's reactor crt exports `_initialize`
  # instead, the emitted `main` becomes an ordinary function nothing calls,
  # and the only way in is the export `reactor_shim` declares. That is the
  # whole difference in the link, and it is one flag.
  let model: List[String] = if reactor { ["-mexec-model=reactor"] } else { [] }
  let argv = if wasm {
    [
      cc, "--target=" ++ triple, "-std=c11", "-O2", "-fwrapv", "-fwasm-exceptions",
      "-fno-strict-aliasing", "-Wno-parentheses-equality"
    ] ++ model ++ [
      "-I", work,
      "-o", out, work ++ "/main.c", work ++ "/dawn_rt.c",
      work ++ "/dawn_rt_wasi_eh.o", work ++ "/dawn_rt_wasi_tag.o", "-lm"
    ]
  } else {
    [
      cc, "-std=c11", "-O2", "-fwrapv", "-fexceptions", "-fno-strict-aliasing", "-pthread",
      "-I", work,
      "-o", out, work ++ "/main.c", work ++ "/dawn_rt.c", "-lm"
    ]
  }
  # cc is done with the staging directory the moment it succeeds, and nothing
  # else ever removed it: 125 of them, a megabyte each (the emitted C plus the
  # embedded runtime), had accumulated in /tmp here. A cc that *failed* keeps
  # its directory on purpose -- the C it choked on is the only thing left to
  # look at, and the error names an exit code, not a file.
  match io.run(argv, "", "") {
    Ok(0) -> pkgfetch.delete_tree(work)
    Ok(code) -> {
      if wasm { io.eprintln(wasm_toolchain_hint()) }
      cli_error(cc ++ " failed (exit code " ++ "${code}" ++ ")")
    }
    Err(e) -> {
      if wasm { io.eprintln(wasm_toolchain_hint()) }
      cli_error("cannot run " ++ cc ++ ": " ++ e.message)
    }
  }
}

fn cmd_check(rest: List[String]) -> Unit !Fs !Proc !Env !io = {
  if wants_help(rest) { return print(subcommand_help("check")) }
  let (std_dir, targets) = check_args(rest)
  if len(targets) == 0 {
    return cli_error("usage: dawn check [--std <dir>] <target>...")
  }
  for target in targets {
    if not io.exists(target) {
      return cli_error("no such file or directory: " ++ target)
    }
    if not io.is_dir(target) && not str.ends_with(target, ".dawn") {
      return cli_error("source files must end in .dawn: " ++ target)
    }
  }
  let std = load_or_die(std_dir)
  var all: List[LocDiag] = []
  for target in targets {
    let loaded = load_target(std, target)
    let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
    all = all ++ prog.diags
  }
  if len(all) > 0 { return fail_compile(all) }
  println("ok")
}

fn cmd_emitc(rest: List[String]) -> Unit !Fs !Proc !Env !io = {
  let (std_dir, out, target) = parse_compile_tail(
    "dawn emitc",
    "usage: dawn emitc [--std <dir>] <file.dawn | project-dir> [-o out]",
    rest
  )
  let text = emitted(std_dir, target)
  if out == "" {
    print(text)
  } else {
    match io.write_file(out, text) {
      Ok(_) -> ()
      Err(e) -> cli_error("cannot write " ++ out ++ ": " ++ e.message)
    }
  }
}

fn cmd_build(rest: List[String]) -> Unit !Fs !Proc !Env !io = {
  # Ahead of the parser, not inside it: `--help` is a request for the contract,
  # so it must not be able to fail on the argv it is asking about. The parser
  # would take it for the target and report a missing file (which is what it
  # did until 2026-08-26).
  if wants_help(rest) { return print(subcommand_help("build")) }
  let (std_dir, out0, target, wasm, reactor) = parse_build_tail(
    "usage: dawn build [--cp jars] <file.dawn | project-dir> [-o out] [--native]",
    rest
  )
  # `.wasm` by default: the artifact is not executable here, and every host
  # that runs one (node, wasmtime, a browser loader) keys on the suffix.
  let out = if out0 == "" {
    if wasm { default_out(target) ++ ".wasm" } else { default_out(target) }
  } else {
    out0
  }
  cc_build_for(reactor_wrapped(emitted(std_dir, target), reactor), out, wasm, reactor)
}

## Build `ctext` into a scratch directory and become it: the process ends with
## the built program's own exit status, so nothing after the call runs.
##
## `dir_prefix`, `bin_name` and `what` are parameters rather than a shared
## spelling because the two callers' messages are compared byte for byte
## against the JVM driver's (scripts/native-cli-diff.sh); what is shared is the
## staging, not the wording.
fn build_and_exec(
  ctext: String,
  dir_prefix: String,
  bin_name: String,
  what: String,
  program_args: List[String]
) -> Unit !Fs !Proc !Env !io = {
  let work = match io.temp_dir("", dir_prefix) {
    Ok(d) -> d
    Err(e) -> {
      cli_error("cannot make a scratch directory: " ++ e.message)
      return ()
    }
  }
  let bin = work ++ "/" ++ bin_name
  cc_build(ctext, bin)
  # The scratch tree goes before the exit, not after it: `io.exit` has no stack
  # to unwind, so a release placed on the way out is a release that never runs.
  # A build that failed keeps its directory -- `cc_build` reports and exits from
  # inside, and the emitted C is the only thing left to look at.
  match io.run([bin] ++ program_args, "", "") {
    Ok(code) -> {
      pkgfetch.delete_tree(work)
      let _ = io.exit(code)
      ()
    }
    Err(e) -> {
      pkgfetch.delete_tree(work)
      cli_error("cannot run the built " ++ what ++ ": " ++ e.message)
    }
  }
}

fn cmd_run(rest: List[String]) -> Unit !Fs !Proc !Env !io = {
  let run = parse_run_tail(rest)
  build_and_exec(
    emitted(run.std_dir, run.target),
    "dawnc-run",
    "program",
    "program",
    run.program_args
  )
}

## Every .dawn file under `dir`, recursively; paths are `dir`-prefixed.
##
## The order `io.list_dir` returns is not the same on both backends (#114: the
## C reader does not sort), so the caller sorts the flat result -- which is
## also what the JVM driver does, for the same reason one layer down.
fn dawn_files_under(dir: String) -> List[String] !Fs = {
  var out: List[String] = []
  match io.list_dir(dir) {
    Ok(files) -> {
      for f in files {
        let p = dir ++ "/" ++ f
        if io.is_dir(p) {
          out = out ++ dawn_files_under(p)
        } else if str.ends_with(f, ".dawn") {
          out = out ++ [p]
        }
      }
    }
    Err(e) -> panic("cannot list " ++ dir ++ ": " ++ e.message)
  }
  out
}

## `dawnc fmt [--check] <file.dawn | dir>...` -- reformat in place, or report
## unformatted files and exit 1. Both refusals (a named non-`.dawn` file, a
## file the lexer cannot read whole) are documented at `main.dawn`'s `run_fmt`;
## the two drivers' output is compared byte for byte by
## `scripts/native-cli-diff.sh`, so they refuse in the same words.
fn cmd_fmt(rest: List[String]) -> Unit !Fs !io = {
  var check = false
  var paths: List[String] = []
  for a in rest {
    if a == "--check" { check = true } else { paths = paths ++ [a] }
  }
  if len(paths) == 0 { return cli_error("usage: dawn fmt [--check] <file.dawn | dir>...") }
  var files: List[String] = []
  for p in paths {
    if not io.exists(p) { return cli_error("no such file or directory: " ++ p) }
    if io.is_dir(p) {
      files = files ++ sort(dawn_files_under(p))
    } else {
      if not str.ends_with(p, ".dawn") {
        return cli_error("source files must end in .dawn: " ++ p)
      }
      files = files ++ [p]
    }
  }
  var unformatted = 0
  var refused: List[(String, Diag)] = []
  for f in files {
    match io.read_file(f) {
      Ok(original) -> {
        match fmt.format(original) {
          Err(ds) -> {
            for d in ds { refused = refused ++ [(f, d)] }
          }
          Ok(formatted) ->
            if formatted != original {
              if check {
                println(f)
                unformatted = unformatted + 1
              } else {
                match io.write_file(f, formatted) {
                  Ok(_) -> println("formatted " ++ f)
                  Err(e) -> panic("cannot write " ++ f ++ ": " ++ e.message)
                }
              }
            }
        }
      }
      Err(e) -> panic("cannot read " ++ f ++ ": " ++ e.message)
    }
  }
  if len(refused) > 0 { return fail_fmt(refused) }
  if check && unformatted > 0 { let _ = io.exit(1) }
}

## `dawnc doc <target>` / `--stdlib` / `--builtins`.
##
## The JVM driver hands `analyze_program` the reflecting `use java` hook; this
## one hands it the refusing hook, as every other native subcommand does. For a
## target without `use java` the two produce the same JSON, and a target with
## it is not a program this backend compiles at all.
fn cmd_doc(rest: List[String]) -> Unit !Fs !Proc !Env !io = {
  var std_dir = "std"
  var builtins_mode = false
  var stdlib_mode = false
  var target = ""
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--builtins" {
      builtins_mode = true
      i = i + 1
    } else if rest[i] == "--stdlib" {
      stdlib_mode = true
      i = i + 1
    } else {
      refuse_second_target("dawn doc", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  require_one_input(
    "dawn doc",
    "a target, --stdlib, or --builtins",
    "usage: dawn doc <file.dawn | project-dir> | dawn doc --stdlib | dawn doc --builtins",
    (if target != "" { 1 } else { 0 }) +
      (if stdlib_mode { 1 } else { 0 }) +
      (if builtins_mode { 1 } else { 0 })
  )
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> fail_std(e)
  }
  if stdlib_mode {
    print(doc.stdlib_json(std))
    return
  }
  if builtins_mode {
    print(doc.builtins_json(std))
    return
  }
  if not io.exists(target) {
    return cli_error("no such file or directory: " ++ target)
  }
  let loaded = load_target(std, target)
  let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
  if len(prog.diags) > 0 { fail_doc(prog.diags) }
  print(doc.project_json(prog))
}

## `dawnc test [--std <dir>] <target> | --stdlib` -- the native mirror of
## `dawn test`.
##
## The JVM driver emits every test block as a `dawn$test$i` method and then
## generates one more class, `dawn$TestMain`, to call them (testrun.dawn).
## There is no "generate one more class" on this backend, so the test bodies
## are compiled into the same translation unit as everything else and a
## generated C runner becomes its `main` (ctestrun.dawn). The report, the
## labels and the exit code are the JVM runner's.
##
## `--cp` is validated exactly as `main.extract_cp` validates it, and then the
## jars are dropped. They can only ever matter to a `use java` program, which
## this backend refuses at `check` -- so ignoring their contents is observable
## nowhere, while rejecting the flag outright would make `dawn test`'s argv
## toolchain-specific for no gain.
##
## The one thing that cannot be mirrored is where the separator comes from:
## `main.path_sep()` is `File.pathSeparator`, a java call, and a backend with
## no classpath has nothing to ask. `:` is the same POSIX assumption
## `default_out` above already makes by splitting paths on `/`.
##
## The comptime flags (`--comptime-fuel`, `--comptime-ffi`, `--closure`) are
## not taken here because no subcommand of this driver takes them; that gap is
## the driver's, not this subcommand's.
fn cmd_test(rest: List[String]) -> Unit !Fs !Proc !Env !io = {
  var std_dir = "std"
  var target = ""
  var std_tests = false
  var i = 0
  while i < len(rest) {
    var spec = ""
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--stdlib" {
      std_tests = true
      i = i + 1
    } else if rest[i] == "--cp" && i + 1 < len(rest) {
      spec = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--cp" {
      cli_error("--cp needs a path")
      i = i + 1
    } else if str.starts_with(rest[i], "--cp=") {
      spec = str.strip_prefix(rest[i], "--cp=").unwrap_or(rest[i])
      i = i + 1
    } else {
      refuse_second_target("dawn test", target, rest[i])
      target = rest[i]
      i = i + 1
    }
    if spec != "" {
      for pth in str.split(spec, ":") {
        if pth != "" && not io.exists(pth) { cli_error("--cp entry not found: " ++ pth) }
      }
    }
  }
  require_one_input(
    "dawn test",
    "a target or --stdlib",
    "usage: dawn test [--cp jars] <file.dawn | project-dir> | dawn test --stdlib",
    (if target != "" { 1 } else { 0 }) + (if std_tests { 1 } else { 0 })
  )
  let std = load_or_die(std_dir)
  let prog = if std_tests { Program { modules: [], diags: [] } } else { analyzed(std, target) }
  # the modules whose test blocks are being run: the target's, or std's own
  # under --stdlib
  var suite: List[(String, String, TModule)] = []
  if std_tests {
    for sm in std.mods {
      let (cls, _cx, tm, _ct) = sm
      suite = suite ++ [(cls, cls, tm)]
    }
  } else {
    for cm in prog.modules { suite = suite ++ [(cm.class_name, cm.mod_path, cm.tm)] }
  }
  # the module path prefixes a label only when more than one module has tests
  # -- run_test's rule, so that the two reports read the same
  var bearing = 0
  for s in suite {
    let (_c, _p, tm) = s
    if len(tm.tests) > 0 { bearing = bearing + 1 }
  }
  if bearing == 0 {
    return cli_error(if std_tests { std_dir ++ " has no test blocks" }
    else { target ++ " has no test blocks" })
  }
  var runner_tests: List[(String, Int, String)] = []
  for s in suite {
    let (cls, mod_path, tm) = s
    var idx = 0
    for tf in tm.tests {
      let label = if bearing > 1 { mod_path ++ " :: " ++ tf.name } else { tf.name }
      runner_tests = runner_tests ++ [(cls, idx, label)]
      idx = idx + 1
    }
  }
  let ctext = match cdriver.c_test_text(std, prog, runner_tests, std_tests) {
    Ok(s) -> s
    Err(e) -> {
      cli_error(e ++ " in " ++ target)
      ""
    }
  }
  build_and_exec(ctext, "dawnc-test", "tests", "tests", [])
}

## The native driver's outermost frame installs the file system, process and
## environment handlers once, as main.dawn's does; every subcommand runs under
## all three. The process one matters most here: the C driver's toolchain
## probe and every compile it runs reach the host through `io.run`, and the
## environment one is what `cc_command` asks which compiler to use.
pub fn main() -> Unit !io =
  io.with_fs_real(() => io.with_proc_real(() => io.with_env_real(() => dispatch())))

fn dispatch() -> Unit !Fs !Proc !Env !io = {
  match args() {
    [] -> fail_usage()
    [mode, ..rest] ->
      if mode == "check" {
        cmd_check(rest)
      } else if mode == "build" {
        cmd_build(rest)
      } else if mode == "emitc" {
        cmd_emitc(rest)
      } else if mode == "run" {
        cmd_run(rest)
      } else if mode == "test" {
        cmd_test(rest)
      } else if mode == "fmt" {
        cmd_fmt(rest)
      } else if mode == "doc" {
        cmd_doc(rest)
      } else if mode == "add" {
        match add.run_add(rest) {
          Ok(s) -> println(s)
          Err(e) -> cli_error(e)
        }
      } else if mode == "lsp" {
        run_lsp(lsp_std_flag(rest), LspLeaseHost {
          standalone: native_lsp_standalone_lease,
          project: native_lsp_target_lease
        })
      } else if mode == "version" || mode == "--version" {
        println("dawnc " ++ VERSION ++ " (native)")
      } else {
        fail_usage()
      }
  }
}

test "a subcommand's help is that subcommand's lines out of the usage block" {
  # The filter is what keeps one contract from being written twice, so what it
  # would get wrong is picking up a neighbour's entry or dropping a
  # continuation line. Both are asserted rather than assumed.
  let b = subcommand_help("build")
  assert str.contains(b, "compile to a native binary via cc")
  assert str.contains(b, "compile to wasm32-wasip1 via clang")
  assert str.contains(b, "exported `dawn_turn` the host calls")
  assert not str.contains(b, "type-check, report diagnostics")
  assert not str.contains(b, "speak LSP over stdin/stdout")

  let c = subcommand_help("check")
  assert str.contains(c, "type-check, report diagnostics")
  assert not str.contains(c, "compile to a native binary via cc")

  # a command with no entry gets nothing, rather than the whole block
  assert subcommand_help("nosuch") == "\n"
}

test "--help is recognised anywhere in a subcommand's tail" {
  assert wants_help(["--help"])
  assert wants_help(["-o", "out", "--help"])
  assert not wants_help([])
  assert not wants_help(["--target", "wasm", "prog.dawn"])
}

# ---- the toolchain this backend drives ----
#
# `cc` is this backend's assembler, so the command lines below are as much a
# part of its codegen as the C above them, and until now nothing held them:
# they were checked by running a real compiler, which means they were checked
# only where a wasi-sdk was installed. `procmem.with_proc_table` answers `Proc`
# from a script and hands back every invocation, so each flag can be named
# where the comment that justifies it is. No test here starts a process.
#
# The staging directory is real (`io.with_fs_real`): `cc_build_with` writes the
# emitted C and the embedded runtime into it and deletes it again on success,
# and a table that cannot hold bytes could not carry that (issue #65). It is
# read back out of the invocations rather than guessed -- a temp directory's
# name is the host's to pick -- which also pins that all four command lines
# name one directory.

# `bracket` takes the release as a value, and a module-qualified name is not
# one, so the delete is named here.
fn scrub(path: String) -> Unit !Fs = pkgfetch.delete_tree(path)

fn scratch(prefix: String) -> String !Fs =
  match io.temp_dir("", prefix) {
    Ok(d) -> d
    Err(e) -> panic("temp dir: " ++ e.message)
  }

# The environment both variables are set in, so that every assertion below
# about which one was read is also an assertion that the other was there to
# be read and was not. The values are not spellings of any real compiler:
# what is under test is which name the answer came from.
const BOTH_CCS: List[(String, String)] = [
  ("DAWN_WASM_CC", "wasi-sdk-clang"),
  ("CC", "native-gcc")
]

test "a wasm build takes its compiler from DAWN_WASM_CC" {
  let (cc, log) = envmem.with_env_table(envmem.TABLE_CWD, BOTH_CCS, () => cc_command(true))
  assert cc == "wasi-sdk-clang"
  # CC is set here and is not what a wasm build reads: the two targets can be
  # served by two compilers in one environment, which is why the override is a
  # variable of its own
  assert envmem.asked_names(log) == ["DAWN_WASM_CC"]
}

test "a wasm build with no override is clang, and only clang" {
  let (cc, log) = envmem.with_env_table(
    envmem.TABLE_CWD,
    [("CC", "native-gcc")],
    () => cc_command(true)
  )
  # the wasm spelling is clang's and only clang's, so the default names it
  # rather than falling back to the native compiler CC already names
  assert cc == "clang"
  assert cc != "cc"
  assert envmem.asked_names(log) == ["DAWN_WASM_CC"]
}

test "a native build takes its compiler from CC" {
  let (cc, log) = envmem.with_env_table(envmem.TABLE_CWD, BOTH_CCS, () => cc_command(false))
  assert cc == "native-gcc"
  assert envmem.asked_names(log) == ["CC"]
}

test "a native build with no override is cc" {
  let (cc, log) = envmem.with_env_table(
    envmem.TABLE_CWD,
    [("DAWN_WASM_CC", "wasi-sdk-clang")],
    () => cc_command(false)
  )
  assert cc == "cc"
  assert envmem.asked_names(log) == ["CC"]
  # neither branch asks where it is: the compiler is a name for PATH to
  # resolve, not a path this driver builds
  assert log == [AskedGet("CC")]
}

test "the wasm triple is the modern spelling when the sysroot has the file" {
  io.with_fs_real(() => {
    let dir = scratch("dawn-triple-modern-")
    with d <- bracket(dir, scrub)
    # what a sysroot that has crt1.o answers with: an absolute path, and one
    # that is really there, because existence is what the driver reads
    let crt = d ++ "/crt1.o"
    let _ = io.write_file(crt, "")
    let (triple, log) = procmem.with_proc_table(
      [procmem.wrote(bytes.utf8(crt ++ "\n"))],
      () => wasm_triple("fake-clang", d)
    )
    assert triple == "wasm32-wasip1"
    # one process, and the whole of its command line
    assert len(log) == 1
    let argv = procmem.call_argv(log, 0)
    assert len(argv) == 3
    assert argv[0] == "fake-clang"
    assert argv[1] == "--target=wasm32-wasip1"
    assert argv[2] == "-print-file-name=crt1.o"
    # the answer is collected in the work directory, not read off a pipe
    assert log[0].out_path == d ++ "/crt1.path"
    assert log[0].err_path == d ++ "/crt1.err"
  })
}

test "the wasm triple falls back to the legacy spelling when the probe finds nothing" {
  # The branch CI has never taken: the wasm-target job installs a pinned
  # wasi-sdk, and wasi-sdk 34 removed `wasm32-wasi` outright, so the probe
  # there always succeeds. Every way of not succeeding is one answer.
  io.with_fs_real(() => {
    let dir = scratch("dawn-triple-legacy-")
    with d <- bracket(dir, scrub)
    # clang exits 0 and echoes the bare name back when the sysroot lacks it,
    # which is why exit status alone is not the question asked
    let (echoed, log) = procmem.with_proc_table(
      [procmem.wrote(bytes.utf8("crt1.o\n"))],
      () => wasm_triple("fake-clang", d)
    )
    assert echoed == "wasm32-wasi"
    assert len(log) == 1
    let argv = procmem.call_argv(log, 0)
    assert len(argv) == 3
    assert argv[0] == "fake-clang"
    # the probe is asked in the modern spelling either way: it is the question,
    # not the answer
    assert argv[1] == "--target=wasm32-wasip1"
    assert argv[2] == "-print-file-name=crt1.o"

    # a clang that ran and failed, and a clang that would not start at all,
    # reach the same spelling -- the compile below diagnoses both, with the
    # install hint
    let (failed, flog) = procmem.with_proc_table(
      [procmem.exited(1)],
      () => wasm_triple("fake-clang", d)
    )
    assert failed == "wasm32-wasi"
    assert len(flog) == 1
    let (gone, glog) = procmem.with_proc_table(
      [procmem.unstartable("no clang on PATH")],
      () => wasm_triple("fake-clang", d)
    )
    assert gone == "wasm32-wasi"
    assert len(glog) == 1
  })
}

test "the native build is one command line, and this is every flag in it" {
  io.with_fs_real(() => {
    let dir = scratch("dawn-cc-native-")
    with d <- bracket(dir, scrub)
    let out = d ++ "/prog"
    let (_, log) = procmem.with_proc_table(
      [procmem.exited(0)],
      () => cc_build_with("fake-cc", "int main(void) { return 0; }\n", out, false, false)
    )
    # no probe: nothing here is cross-compiled, so nothing is asked
    assert len(log) == 1
    let argv = procmem.call_argv(log, 0)
    assert len(argv) == 14
    assert argv[0] == "fake-cc"
    assert argv[1] == "-std=c11"
    assert argv[2] == "-O2"
    assert argv[3] == "-fwrapv"
    assert argv[4] == "-fexceptions"
    assert argv[5] == "-fno-strict-aliasing"
    assert argv[6] == "-pthread"
    assert argv[7] == "-I"
    let work = argv[8]
    assert argv[9] == "-o"
    assert argv[10] == out
    assert argv[11] == work ++ "/main.c"
    assert argv[12] == work ++ "/dawn_rt.c"
    assert argv[13] == "-lm"
    # the include path is the staging directory itself: dawn_rt.h is beside
    # the C that includes it
    assert work != ""
    # nothing of the wasm row leaks into this one
    let line = join(argv, " ")
    assert not str.contains(line, "--target")
    assert not str.contains(line, "-fwasm-exceptions")
    assert not str.contains(line, "-Wno-parentheses-equality")
    assert not str.contains(line, "-mexec-model")
    assert not str.contains(line, "dawn_rt_wasi")
    # both streams stay where this process's point: cc's diagnostics are the
    # user's to read, and the driver never quotes them
    assert log[0].out_path == ""
    assert log[0].err_path == ""
    # a cc that succeeded is done with the staging directory
    assert not io.exists(work)
  })
}

test "the wasm build is four command lines, and these are every flag in them" {
  io.with_fs_real(() => {
    let dir = scratch("dawn-cc-wasm-")
    with d <- bracket(dir, scrub)
    let crt = d ++ "/crt1.o"
    let _ = io.write_file(crt, "")
    let out = d ++ "/prog.wasm"
    let (_, log) = procmem.with_proc_table(
      [
        procmem.wrote(bytes.utf8(crt ++ "\n")),
        procmem.exited(0),
        procmem.exited(0),
        procmem.exited(0)
      ],
      () => cc_build_with("fake-clang", "int main(void) { return 0; }\n", out, true, false)
    )
    # the probe, the C++ shim, the exception tag, the compile-and-link
    assert len(log) == 4
    # every path below is inside the one staging directory the probe named
    let work = str.strip_suffix(log[0].out_path, "/crt1.path").expect("probe path")

    assert procmem.call_argv(log, 0) ==
      ["fake-clang", "--target=wasm32-wasip1", "-print-file-name=crt1.o"]

    # the shim is its own compile because it is C++ and carries spellings the
    # C rows must not have; it produces the object the link picks up
    let shim = procmem.call_argv(log, 1)
    assert len(shim) == 12
    assert shim[0] == "fake-clang"
    assert shim[1] == "--target=wasm32-wasip1"
    assert shim[2] == "-x"
    assert shim[3] == "c++"
    assert shim[4] == "-std=c++14"
    assert shim[5] == "-O2"
    assert shim[6] == "-fno-rtti"
    assert shim[7] == "-fwasm-exceptions"
    assert shim[8] == "-c"
    assert shim[9] == work ++ "/dawn_rt_wasi_eh.cc"
    assert shim[10] == "-o"
    assert shim[11] == work ++ "/dawn_rt_wasi_eh.o"

    # the tag is a third compile, in C and with no exception flag at all: a
    # unit that neither throws nor catches is where the definition can sit
    let tag = procmem.call_argv(log, 2)
    assert len(tag) == 8
    assert tag[0] == "fake-clang"
    assert tag[1] == "--target=wasm32-wasip1"
    assert tag[2] == "-std=c11"
    assert tag[3] == "-O2"
    assert tag[4] == "-c"
    assert tag[5] == work ++ "/dawn_rt_wasi_tag.c"
    assert tag[6] == "-o"
    assert tag[7] == work ++ "/dawn_rt_wasi_tag.o"
    assert not str.contains(join(tag, " "), "-fwasm-exceptions")
    assert not str.contains(join(tag, " "), "-x")

    # and the link, which is the native row with the target's differences:
    # -fwasm-exceptions for -fexceptions, no -pthread, and the clang-only
    # warning the emitted C trips silenced
    let main = procmem.call_argv(log, 3)
    assert len(main) == 17
    assert main[0] == "fake-clang"
    assert main[1] == "--target=wasm32-wasip1"
    assert main[2] == "-std=c11"
    assert main[3] == "-O2"
    assert main[4] == "-fwrapv"
    assert main[5] == "-fwasm-exceptions"
    assert main[6] == "-fno-strict-aliasing"
    assert main[7] == "-Wno-parentheses-equality"
    assert main[8] == "-I"
    assert main[9] == work
    assert main[10] == "-o"
    assert main[11] == out
    assert main[12] == work ++ "/main.c"
    assert main[13] == work ++ "/dawn_rt.c"
    assert main[14] == work ++ "/dawn_rt_wasi_eh.o"
    assert main[15] == work ++ "/dawn_rt_wasi_tag.o"
    assert main[16] == "-lm"
    assert not str.contains(join(main, " "), "-pthread")
    assert not str.contains(join(main, " "), "-fexceptions")
    # a command build has no reactor flag anywhere
    assert not str.contains(join(main, " "), "-mexec-model")
    # the two objects the link consumes are the two the compiles above wrote
    assert main[14] == shim[11]
    assert main[15] == tag[7]
    # every invocation staged out of one directory, and it is gone afterwards
    assert log[3].out_path == ""
    assert log[3].err_path == ""
    assert not io.exists(work)
  })
}

test "a reactor build is the same link plus one flag" {
  io.with_fs_real(() => {
    let dir = scratch("dawn-cc-reactor-")
    with d <- bracket(dir, scrub)
    let crt = d ++ "/crt1.o"
    let _ = io.write_file(crt, "")
    let out = d ++ "/prog.wasm"
    let (_, log) = procmem.with_proc_table(
      [
        procmem.wrote(bytes.utf8(crt ++ "\n")),
        procmem.exited(0),
        procmem.exited(0),
        procmem.exited(0)
      ],
      () => cc_build_with("fake-clang", "int main(void) { return 0; }\n", out, true, true)
    )
    assert len(log) == 4
    let work = str.strip_suffix(log[0].out_path, "/crt1.path").expect("probe path")
    # the shim and the tag do not know about the exec model: it is a link-time
    # choice, and the difference is exactly one flag in exactly one place
    assert not str.contains(join(procmem.call_argv(log, 1), " "), "-mexec-model")
    assert not str.contains(join(procmem.call_argv(log, 2), " "), "-mexec-model")
    let main = procmem.call_argv(log, 3)
    assert len(main) == 18
    assert main[7] == "-Wno-parentheses-equality"
    assert main[8] == "-mexec-model=reactor"
    assert main[9] == "-I"
    assert main[10] == work
    assert main[11] == "-o"
    assert main[12] == out
  })
}

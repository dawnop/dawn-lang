# The positive half: a sibling module of the same package names every
# `pub(pkg)` declaration of `core` exactly as it would a `pub` one.
use core.{Seam, seam, LIMIT, Trace}
use core

pub fn twice(n: Int) -> Int = {
  let s: Seam = seam(n)
  let t: core.Seam = core.seam(n)
  s.n + t.n + LIMIT + core.LIMIT
}

fn noisy() -> Unit !Trace = trace("x")

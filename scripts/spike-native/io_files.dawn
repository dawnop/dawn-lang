# The nine primitives left between the compiler and a `use java`-free package
# manager, exercised on both backends before either is allowed to depend on them.
#
# Each one was measured, not guessed: it has a call site in the compiler today
# that reaches it through `use java`. What is deliberately *not* here is the
# other half of that survey -- class-path properties, process spawning,
# `canExecute` -- because those exist to launch a JVM, and a native `dawn run`
# will not launch one.
#
# `io_read_stdin` is the same story `io_eprintln` was: `System.in` is a static
# field, so the interop cannot name it and the language server reaches it
# through a method handle. A channel is not a method handle.
#
# The four operations exercised at the primitive boundary -- `temp_dir`,
# `write_bytes`, `read_bytes`, `rename` -- come from `use std/raw` rather than
# std/io. Delete deliberately goes through std/io because its public
# Deleted/NotFound/Err split is the contract under test. See stdext/raw.dawn.
use std/io
use std/io.{DeleteOutcome, Deleted, NotFound, Fs, Env}
use std/raw
use std/str
use std/bytes

fn line(label: String, v: Bool) -> Unit !io = io.println(label ++ " = " ++ to_string(v))

fn delete_line(label: String, r: Result[DeleteOutcome, ForeignError]) -> Unit !io =
  io.println(label ++ " = " ++ match r {
    Ok(Deleted) -> "Deleted"
    Ok(NotFound) -> "NotFound"
    Err(_) -> "Err"
  })

fn is_set(o: Option[String]) -> Bool =
  match o {
    Some(_) -> true
    None -> false
  }

pub fn main() -> Unit !io = {
  io.with_fs_real(() => io.with_env_real(() => {
    io.println("-- the process's own view --")
    line("cwd is absolute ", str.starts_with(io.cwd(), "/"))
    line("PATH is set     ", is_set(io.getenv("PATH")))
    line("no such var     ", is_set(io.getenv("DAWN_SPIKE_NO_SUCH_VAR")))

    # a fresh directory rather than a fixed path: two of these primitives are
    # about publishing something indivisibly, and a shared scratch path would let
    # one run see another's leftovers
    io.println("-- a scratch directory of our own --")
    let dir = raw.temp_dir("", "dawn-spike-files-")
    line("fresh and a dir ", io.is_dir(dir))
    line("not a symlink   ", io.is_symlink(dir))

    # the parent directories do not exist: the JVM side has always created them
    # and the C side had not, which no corpus had ever asked
    io.println("-- bytes round-trip, through parents that did not exist --")
    let nested = dir ++ "/one/two/three.bin"
    let payload = bytes.utf8("héllo — 字节")
    raw.write_bytes(nested, payload)
    let back = raw.read_bytes(nested)
    line("parents created ", io.exists(nested))
    line("bytes agree     ", back == payload)
    line("multi-byte kept ", bytes.len(back) == bytes.len(payload))

    io.println("-- rename is a move, not a copy --")
    let moved = dir ++ "/one/two/moved.bin"
    raw.rename(nested, moved)
    line("source is gone  ", not io.exists(nested))
    line("target is there ", io.exists(moved))

    io.println("-- delete separates deletion, absence and failure --")
    delete_line("first delete    ", io.delete(moved))
    delete_line("second delete   ", io.delete(moved))

    # the harness runs both backends with stdin at /dev/null, so a short read is
    # the end-of-input signal and both must agree on it
    io.println("-- stdin at end of input --")
    line("nothing to read ", bytes.len(io.read_stdin(16)) == 0)

    io.println("-- and it cleans up after itself --")
    let _ = io.delete(dir ++ "/one/two")
    let _ = io.delete(dir ++ "/one")
    delete_line("scratch removed ", io.delete(dir))
  }))
}

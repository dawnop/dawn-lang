# checker.dawn: a stray trailing operator continues the `let` onto the next
# statement (spec §1.7, #198): the use is in its own initializer, and the
# operator's right operand is Unit
pub fn stray_plus() -> Unit !io = {
  let a = 1 +
  println("${a}")
}

pub fn stray_concat() -> Unit !io = {
  let s = "x" ++
  println(s)
}

pub fn stray_and(b: Bool) -> Unit !io = {
  let c = b &&
  println("${c}")
}

pub fn own_call() -> Int = {
  let f = (n: Int) => if n == 0 { 1 } else { n * f(n - 1) }
  f(3)
}

# controls: a real continuation, and shadowing an outer binding of the name
pub fn joined() -> Int = {
  let a = 1 +
    2
  let b = 10
  let c = {
    let b = b + 1
    b
  }
  a + c
}

# A byte whose range is its own FromInt impl (docs/literal-system-design.md):
# literals at it fold to constants, and in this module, which sees through it,
# a literal is still the Int it was (D7).
pub opaque type U8 = Int

impl FromInt[U8] {
  fn from_int(n: Int) -> U8 = {
    if n < 0 || n > 255 { panic("out of range for U8: ${n}") }
    n
  }
}

impl Add[U8] {
  fn add(a: U8, b: U8) -> U8 = {
    let x: Int = a
    let y: Int = b
    (x + y) & 255
  }
}

pub fn to_int(u: U8) -> Int = u

pub fn inside() -> U8 = {
  let z: U8 = 300
  z
}

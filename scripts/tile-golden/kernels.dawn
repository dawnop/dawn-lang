    let (p, _e) = trace4("llama_rope",
      In(F64, cells([DYN_DIM, LM_HD], [LM_S, LM_HALF], along: [1, FREE_AXIS])),
      In(F64, fixed([LM_S, LM_HALF])), In(F64, fixed([LM_S, LM_HALF])), Out(F64, llama_heads()), llama_rope)
    p
  }
  "llama_scores" -> {
    let (p, _e) = trace3("llama_scores",
      In(F64, Whole), In(F64, cells([LM_HKV * LM_S, LM_HD], [LM_S, LM_HD], along: [2, 1])),
      Out(F64, cells([LM_HKV, LM_HQ / LM_HKV * LM_S, LM_S], [1, LM_S, LM_S], along: [2, 0, 1])), llama_scores)
    p
  }
  "llama_out" -> {
    let (p, _e) = trace3("llama_out",
      In(F64, cells([LM_HQ * LM_S, LM_HD], [LM_S, LM_HD], along: [FREE_AXIS, 0])),
      In(F64, cells([LM_D, LM_D], [LM_T, LM_HD], along: [1, FREE_AXIS])),
      Out(F64, cells([LM_S, LM_D], [LM_S, LM_T])), llama_out)
    p
  }
  "llama_ffn" -> {
    let (p, _e) = trace3("llama_ffn",
      In(F64, cells([LM_S, LM_D], [LM_S, LM_T], along: [0, FREE_AXIS])),
      In(F64, cells([LM_F, LM_D], [LM_T, LM_T], along: [1, FREE_AXIS])),
      Out(F64, cells([LM_S, LM_F], [LM_S, LM_T])), llama_ffn)
    p
  }
  "llama_down" -> {
    let (p, _e) = trace3("llama_down",
      In(F64, cells([LM_S, LM_F], [LM_S, LM_T], along: [0, FREE_AXIS])),
      In(F64, cells([LM_D, LM_F], [LM_T, LM_T], along: [1, FREE_AXIS])),
      Out(F64, cells([LM_S, LM_D], [LM_S, LM_T])), llama_down)
    p
  }
  "trig_sweep" -> {
    let (p, _e) = trace4("trig_sweep",
      In(F64, Whole), In(F64, Whole), In(F64, Whole), Out(F64, seg_out(7, 8, TRIG_N, TRIG_TILE)), trig_sweep)
    p
  }
  "rope" -> {
    let (p, _e) = trace4("rope",
      In(F64, rope_half()), In(F64, rope_half()), In(F64, rope_half()),
      Out(F64, cells([ROPE_M, ROPE_D], [ROPE_ROWS, ROPE_D])), rope)

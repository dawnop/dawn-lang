# The JVM backend's collection runtime, byte-copied into every built program.
#
# There is none left. `DawnList`, `DawnMap` and `DawnSet` all retired with S3:
# List is the Dawn vector in std/pvec, Map and Set are the Dawn hash trie in
# std/hamt, and the whole of what a backend implements for collections is
# `Array` (docs/collections-dejava-research.md §5).
#
# The old argument for keeping the last two was that each
# `extends java.util.Abstract*`, whose structural, order-independent
# equals/hashCode *was* Dawn's `==`/hash on maps and sets — an identity Dawn
# was said to be unable to express without inheritance. What that argument
# missed is that it only held while `==` and hash were hardwired: once they
# became traits a container could implement, the identity moved into std
# source and the container followed it. The list had no such argument, only a
# performance one, and that turned on `array_push` extending in place.
#
# The mechanism stays because it is the general one: a backend that needs to
# ship a handwritten class into every program says so here.
#
# Mechanism: compiled ahead of time, so they live in the compiler artifact and
# must be copied into a built program's class table — otherwise `java -jar` dies
# with NoClassDefFoundError while `dawn run` works. rt_class_family reads them
# from the running compiler's own class loader.

use std/str
use std/list
use std/io
use java "java.io.File"
use java "java.lang.ClassLoader"
use java "java.net.URL"
use java "java.util.jar.JarFile"
use java "java.util.jar.JarEntry"
use java "java.util.Enumeration"
use java "java.io.InputStream"
use java "java.nio.file.Files"
use java "java.nio.file.Paths"
use java "java.lang.System"

## The handwritten-Java runtime classes copied verbatim into every program.
## Each entry brings its nested/anonymous classes along by the `$` name rule in
## `matches`.
##
## Nothing, since S3. Kept as the mechanism rather than deleted: it is how a
## backend declares a class it must copy into every program, and the next one
## to need that should find the road already built.
pub fn vendored_outers() -> List[String] = []

fn matches(file: String, outer: String) -> Bool =
  file == outer ++ ".class" ||
  (str.starts_with(file, outer ++ "\$") && str.ends_with(file, ".class"))

# The releases the two jar walks below bracket with. Both walks panic on a
# broken invariant partway through, which is exactly the way out that used to
# skip the close.
fn close_jar(jf: JarFile) -> Unit !io = {
  let _ = jf.close()
  ()
}

fn close_entry_stream(ins: InputStream) -> Unit !io = {
  let _ = ins.close()
  ()
}

## One entry's bytes, with the stream released however the read ends. It takes
## the stream rather than (jar, entry) because the two walks hold different
## entry types — `getEntry` hands back a `ZipEntry`, the enumeration a
## `JarEntry` — and Java's parameter subtyping does not reach Dawn signatures.
fn entry_bytes(ins: InputStream) -> Bytes !io = {
  with s <- bracket(ins, close_entry_stream)
  s.readAllBytes().expect("entry bytes")
}

## `dawn/rt/<outer>` plus every nested `dawn/rt/<outer>$…` beside it, as
## (class name, bytes) pairs sorted by name. Requires the compiler jar on the
## class path (the same condition the checker's reflection already needs).
pub fn rt_class_family(outer: String) -> List[(String, Bytes)] !io = {
  let res = "dawn/rt/" ++ outer ++ ".class"
  let loader = ClassLoader.getSystemClassLoader().expect("system loader")
  let url = match loader.getResource(res) {
    Some(u) -> u
    None -> panic("runtime class `dawn/rt/" ++ outer ++ "` is missing from the class path")
  }
  let u = url.toString().expect("url string")
  # a classes directory on the class path (running the self-emitted compiler):
  # list the sibling .class files instead of walking a jar
  if str.starts_with(u, "file:") {
    let fpath = str.strip_prefix(u, "file:").unwrap_or(u)
    let dir = match str.last_index_of(fpath, "/") {
      Some(i) -> str.take(fpath, i)
      None -> fpath
    }
    var names2: List[String] = []
    match io.list_dir(dir) {
      Ok(files) -> {
        for f in files {
          if matches(f, outer) { names2 = names2 ++ [f] }
        }
      }
      Err(e) -> panic("cannot list " ++ dir ++ ": " ++ e.message)
    }
    var out2: List[(String, Bytes)] = []
    for f in sort(names2) {
      let bs = match catch_fault(fn() =>
          Files.readAllBytes(Paths.get(dir ++ "/" ++ f).expect("path")).expect("bytes")) {
        Ok(b) -> b
        Err(e) -> panic("cannot read " ++ f ++ ": " ++ e.message)
      }
      out2 = out2 ++ [("dawn/rt/" ++ str.strip_suffix(f, ".class").unwrap_or(f), bs)]
    }
    return out2
  }
  if not str.starts_with(u, "jar:file:") {
    panic("vendored runtime must come from a jar, got: " ++ u)
  }
  let bang = str.index_of(u, "!").expect("jar url separator")
  let jar_path = str.substring(u, str.len("jar:file:"), bang)
  with jf <- bracket(JarFile.new(jar_path), close_jar)
  var names: List[String] = []
  let en = jf.entries().expect("entries")
  while en.hasMoreElements() {
    # `Enumeration` is erased, but a `JarFile`'s is a `JarEntry` enumeration by
    # construction — so the `Err` `cast` now returns (LANG-02) is a broken
    # invariant, and it stops the same way the ClassCastException used to.
    let got: Result[JarEntry, ForeignError] = cast(en.nextElement().expect("entry"))
    let e: JarEntry = match got {
      Ok(v) -> v
      Err(x) -> panic("vendor.rt_class_family: not a JarEntry: " ++ x.message)
    }
    let nm = e.getName().expect("entry name")
    if str.starts_with(nm, "dawn/rt/") &&
      matches(str.strip_prefix(nm, "dawn/rt/").unwrap_or(nm), outer) {
        names = names ++ [nm]
      }
  }
  var out: List[(String, Bytes)] = []
  for nm in sort(names) {
    let e = match jf.getEntry(nm) {
      Some(je) -> je
      None -> panic("jar entry vanished: " ++ nm)
    }
    let bs = entry_bytes(jf.getInputStream(e).expect("entry stream"))
    out = out ++ [(str.strip_suffix(nm, ".class").unwrap_or(nm), bs)]
  }
  out
}

fn has_name(names: List[String], n: String) -> Bool = {
  for x in names { if x == n { return true } }
  false
}

fn lookup_bytes(pairs: List[(String, Bytes)], nm: String) -> Bytes = {
  for p in pairs {
    let (n, b) = p
    if n == nm { return b }
  }
  panic("classpath_package: name vanished: " ++ nm)
}

## Class names (internal, no ".class") under `root`/`rel`, recursive.
fn dir_classes_under(root: String, rel: String) -> List[String] !io = {
  var out: List[String] = []
  match io.list_dir(root ++ "/" ++ rel) {
    Ok(files) -> {
      for f in sort(files) {
        let r2 = rel ++ "/" ++ f
        if io.is_dir(root ++ "/" ++ r2) {
          out = out ++ dir_classes_under(root, r2)
        } else if str.ends_with(f, ".class") {
          out = out ++ [str.strip_suffix(r2, ".class").unwrap_or(r2)]
        }
      }
    }
    Err(_) -> ()
  }
  out
}

## Every .class under `prefix` in one open jar, skipping the names in `seen`.
##
## Its own function because the accumulators it would otherwise write into are
## `var`s of the caller, and a closure cannot capture those — so the walk gets
## its own, returns them, and the caller merges. That is what buys the bracket:
## the jar is released whether the walk finishes or a broken entry panics it.
fn jar_classes(jf: JarFile, prefix: String, seen: List[String]) -> List[(String, Bytes)] !io = {
  with j <- bracket(jf, close_jar)
  var taken: List[String] = []
  var out: List[(String, Bytes)] = []
  let en = j.entries().expect("entries")
  while en.hasMoreElements() {
    # same invariant as rt_class_family's walk, same treatment
    let got: Result[JarEntry, ForeignError] = cast(en.nextElement().expect("entry"))
    let je: JarEntry = match got {
      Ok(v) -> v
      Err(x) -> panic("vendor.classpath_package: not a JarEntry: " ++ x.message)
    }
    let nm = je.getName().expect("entry name")
    if str.starts_with(nm, prefix ++ "/") && str.ends_with(nm, ".class") {
      let cls = str.strip_suffix(nm, ".class").unwrap_or(nm)
      if not has_name(seen, cls) && not has_name(taken, cls) {
        taken = taken ++ [cls]
        out = out ++ [(cls, entry_bytes(j.getInputStream(je).expect("entry stream")))]
      }
    }
  }
  out
}

## Every .class under package path `prefix` (e.g. "org/objectweb/asm") found
## on java.class.path, as (class name, bytes) pairs sorted by name. The first
## class-path entry providing a class wins, like the class loader. This is how
## `selfhost build` packs the compiler-jar residents (the dawn.tool shim, ASM)
## into a standalone jar.
pub fn classpath_package(prefix: String) -> List[(String, Bytes)] !io = {
  let cp = match System.getProperty("java.class.path") {
    Some(s) -> s
    None -> panic("java.class.path is unset")
  }
  var names: List[String] = []
  var found: List[(String, Bytes)] = []
  # File.pathSeparator, not ':': on Windows java.class.path is ';'-separated and
  # splitting on ':' would cut every entry at its drive letter.
  for entry in str.split(cp, File.pathSeparator!) {
    if str.ends_with(entry, ".jar") {
      match catch_fault(fn() => JarFile.new(entry)) {
        Ok(jf) -> {
          for pair in jar_classes(jf, prefix, names) {
            let (cls, _) = pair
            names = names ++ [cls]
            found = found ++ [pair]
          }
        }
        Err(_) -> ()
      }
    } else if io.is_dir(entry ++ "/" ++ prefix) {
      for cls in dir_classes_under(entry, prefix) {
        if not has_name(names, cls) {
          let bs = match catch_fault(fn() =>
              Files.readAllBytes(Paths.get(entry ++ "/" ++ cls ++ ".class").expect("path")).expect("bytes")) {
            Ok(b) -> b
            Err(e) -> panic("cannot read " ++ cls ++ ": " ++ e.message)
          }
          names = names ++ [cls]
          found = found ++ [(cls, bs)]
        }
      }
    }
  }
  var out: List[(String, Bytes)] = []
  for nm in sort(names) { out = out ++ [(nm, lookup_bytes(found, nm))] }
  out
}

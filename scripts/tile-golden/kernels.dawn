  "global_ctl" -> {
    let (p, _e) = trace4("global_ctl",
      In(F64, one_cell([GLOBAL_TILE])), In(F64, one_cell([GLOBAL_TILE])), In(F64, one_cell([GLOBAL_TILE])),
      Out(F64, one_cell([2 * GLOBAL_TILE])), global_ctl)

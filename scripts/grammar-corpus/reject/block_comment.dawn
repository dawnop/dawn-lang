# expect: Dawn has no block comments; use `#` on each line
# Dawn has no block comments (spec §1.2, #196). `/*` is one lexical error
# at the `/*`, and the text up to `*/` is skipped, so the comment's words do
# not cascade into "expected an expression, found `/`" and friends.

pub fn main() -> Unit !io = {
  /* block comment */
  println("x")
}

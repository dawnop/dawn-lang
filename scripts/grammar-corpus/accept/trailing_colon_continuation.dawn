# A line ending in `:` continues onto the next one (spec §1.7): the lexer's
# continuation set (lexer.continues_line) holds COLON, so a `let` annotation
# outside any bracket may put its type on the following line. It is one
# statement, not a `let a:` with nothing after it and an expression `Int = 6`.
# `dawn fmt` derives its continuation indent from the same set (#188), which
# is why the type line below sits one level in.

fn annotated() -> Int = {
  let a:
    Int = 6
  var b:
    List[Int] = [a]
  a + len(b)
}

# inside a bracket the same line break after a field name is continued too
type P = { reason: String, code: Int }

fn named() -> P =
  P(
    reason:
      "wrapped after its name",
    code: 1
  )

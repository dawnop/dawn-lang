-- base64 url-safe, unpadded --
f            = Zg
fo           = Zm8
foo          = Zm9v
62 and 63    = +/w=
62 and 63 url= -_w
-- from_base64 (spec 4.8, criterion 2) --
padded       = [66]
unpadded     = [66]
one pad      = [666f]
no pad       = [666f6f]

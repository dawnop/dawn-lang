# Known-bad: a new runner must not discharge the caller's buffer effect.
use std/mem
fn poke[@s](b: I64Buf@s, n: Int) -> Unit = mem.with_mem([@inner] () => mem.set(b, 0, n))

pub fn main() -> Unit !io = {
  let result = mem.with_mem([@s] () => {
    let b = mem.new(1)
    poke(b, 5)
    mem.at(b, 0)
  })
  println(to_string(result))
}

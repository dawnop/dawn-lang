# expect: expected a name for the continuation (`op(a) resume k => ...`), found `=>`
# expect: allowed at module top level
# The binder clause is `resume` *and a name*: the name is what the arm body
# calls, so there is no reading in which it may be left out. One token of
# lookahead is what commits the parser here -- nothing but `=>` may stand after
# an arm's `)` -- which is what lets this point at the missing name rather than
# report a missing arrow further along.
effect Ask {
  fn ask(n: Int) -> Int
}

fn f() -> Int = {
  with handle Ask { ask(n) resume => n + 1 }
  ask(1)
}

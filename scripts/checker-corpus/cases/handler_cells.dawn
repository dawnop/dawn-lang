# checker.dawn: a handler's state cells (docs/handler-state-design.md). Every
# shape below is legal and this case's golden is empty on purpose -- the
# refusals live in handler_cells_escape.dawn, and what this file is here to
# pin is that none of them fires on the programs the feature exists for.
effect Emit {
  fn emit(n: Int) -> Unit
}

effect Ask {
  fn get() -> Int
}

fn body() -> Unit !Emit = {
  emit(1)
  emit(2)
}

# the collector: an arm writes the cell, the block remainder reads it, and
# neither the `var` capture ban nor the assign-across ban may reach either
pub fn collect() -> List[Int] = {
  with handle Emit {
    var acc: List[Int] = []
    emit(n) => { acc = acc ++ [n] }
  }
  body()
  acc
}

fn twice(a: List[Int], b: List[Int]) -> List[Int] = a ++ b

# two reads of the same cell in one right-hand side. Legal, and the second read
# must not find a slot the first one emptied: `cell_take_ok` counts the
# occurrences before deciding
pub fn double_read() -> List[Int] = {
  with handle Emit {
    var acc: List[Int] = []
    emit(n) => { acc = twice(acc, acc) ++ [n] }
  }
  body()
  acc
}

# more than one cell on one handler, and an initializer that is not a literal
pub fn two_cells() -> Int = {
  with handle Emit {
    var count: Int = 0
    var total: Int = 1 - 1
    emit(n) => {
      count = count + 1
      total = total + n
    }
  }
  body()
  count + total
}

# a read under a loop inside an arm: legal, and the take that would empty the
# slot on the first turn is what `cell_take_ok` refuses here
pub fn looped() -> List[Int] = {
  with handle Emit {
    var acc: List[Int] = []
    emit(n) => {
      var r: List[Int] = []
      for _i in 0..2 {
        r = r ++ acc
      }
      acc = r ++ [n]
    }
  }
  body()
  acc
}

# **the P-E4-A anchor.** An ordinary `let` bound inside a handler's region may
# be captured by a closure that leaves the region -- that is legal today and
# the state-cell escape ban must be narrow enough to leave it alone. Its
# cell-shaped twin is refused in handler_cells_escape.dawn, and the pair is the
# only thing that says the ban tightened cells and nothing else.
pub fn escaping_let() -> fn() -> Int = {
  with handle Ask {
    get() => 41
  }
  let captured = get() * 10
  () => captured
}

# **the nested-remainder anchor.** A second `with handle` in the same block
# packs every statement after it into a remainder closure of its own, so the
# read below crosses a frame carrying the *inner* installation's id. It is
# still legal: that closure is synthesized, called once and in place by the
# `with handle` node above it, and handed to nobody, so lexically it is the
# outer block's remainder and the outer cell is reachable from it
# (docs/handler-state-design.md §8 problem two). Its refused twin is
# `other_arm` in handler_cells_escape.dawn -- an *arm* of the inner
# installation, which can run inside the window a `cell_take` opens.
pub fn nested_rest_read() -> Int = {
  with handle Ask {
    var outer: Int = 0
    get() => outer
  }
  with handle Ask {
    get() => 1
  }
  outer
}

# the same crossing for a **write**, and with a cell of the inner installation
# alongside it. This is the P6 shape of docs/handler-state-design.md §7.3
# written inline -- the outer accumulator reaches 1, swallows the inner's 78,
# then takes a 2 -- instead of calling out to a function that installs the
# second handler, which is the phrasing the shape needed before this widening.
pub fn nested_rest_assign() -> Int = {
  with handle Emit {
    var outer: Int = 0
    emit(n) => { outer = outer * 10 + n }
  }
  emit(1)
  with handle Ask {
    var inner: Int = 0
    get() => inner
  }
  # a write to the inner installation's cell from its own remainder, then a
  # write to the *outer* one from that same remainder, then a read of it
  inner = 78
  outer = outer * 10 + get()
  emit(2)
  outer
}

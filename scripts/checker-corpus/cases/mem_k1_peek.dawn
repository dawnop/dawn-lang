# Known-bad: a new runner must not discharge the caller's buffer effect.
use std/mem
fn peek(b: I64Buf) -> Int = mem.with_mem(() => mem.at(b, 0))

pub fn main() -> Unit !io = {
  let result = mem.with_mem(() => {
    let b = mem.new(1)
    let first = peek(b)
    mem.set(b, 0, 5)
    first + peek(b)
  })
  println(to_string(result))
}

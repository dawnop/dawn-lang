# Layer 2 for matmul tails (G14-2, second knife): the factories that used to
# refuse a shape that is not a multiple of the tiles, run on the shape that is
# a multiple of nothing, with each architecture's own plan.
#
#   mmtail_diff <arch> then, for f64 f16 i8 bf16 bias scale in that order,
#               <cubin> <tm> <tn> <tk>
#
# The first knife (tail_diff) asked a card what it does with a partial tile at
# 32 by 32 by 32. This one asks it of the tiles the plans really use: 128x128x64
# on sm_90, 256x128x128 with a pair of CTAs on sm_100, the small ones elsewhere.
# The tail shape is M=301, N=203, K=299, so the last row of blocks, the last
# column of blocks and the last K block each have a different live part in every
# plan, and no row of a 16-bit or 8-bit operand is a multiple of 16 bytes.
#
# Every kernel is held to the whole of its output buffer, not just C: C is
# followed by sentinel lanes far longer than a tile of rows, so a store that is
# not masked past the last row lands on them, and the operands are followed by
# poison (+inf, 127 for i8), so a read past the end of the operand shows as a
# lane that is not finite. The expectations are computed on the host from small
# integers (f64, f16, i8) or from sixteenths (the bf16 GEMM and its bias, relu
# and scale epilogues), so every sum is exact in any order of accumulation.
#
# The epilogues are held to the tail too (G14-2, third knife). A bias is a row
# of N read by the same view machinery as an operand, and the bias buffer is
# followed by +inf, so a block that runs off N reads past the live bias; the
# output lanes that read it are the ones the C view masks, which is why the
# whole-buffer comparison is the oracle for them. The scale is a value passed
# at launch and has no tail of its own, but it runs on the blocks that do.
use std/io
use std/gpu
use std/gpu.{Gpu, with_gpu_real}
use std/float.{INFINITY}
use std/list
use std/map
use std/narrow
use std/math
use std/fmt

const M: Int = 301
const N: Int = 203
const K: Int = 299
const SENT_ROWS: Int = 320
const POISON: Int = 4096

fn case_name(i: Int) -> String = ["mmtail_f64", "mmtail_f16", "mmtail_i8", "mmtail_bf16", "mmtail_bias", "mmtail_scale"][i]

# The scale passed at launch: 3/8, so the product of an exact sum is exact.
# It is an f32 parameter, passed as the bits of the f32.
const SCALE_BITS: Int = 1052770304

fn blocks(n: Int, tile: Int) -> Int = (n + tile - 1) / tile

# ---- the corpora ----

fn a_small(i: Int, k: Int) -> Int = (i * 3 + k * 5 + (i * k) % 5) % 3 - 1
fn b_small(k: Int, j: Int) -> Int = (k * 7 + j * 5 + (k * j) % 7) % 3 - 1

fn a_sixteenth(i: Int, k: Int) -> Int = (i * 31 + k * 17 + (i * k) % 7 * 5) % 96 - 48
fn b_sixteenth(k: Int, j: Int) -> Int = ((j + 5) * 31 + (k * 3 + 1) * 17 + ((j + 5) * (k * 3 + 1)) % 7 * 5) % 96 - 48
fn bias_of(j: Int) -> Float = to_float((j * 37) % 255 - 127) / 512.0

fn flat(rows: Int, cols: Int, f: fn(Int, Int) -> Int) -> List[Int] = list.map(range(0, rows * cols), x => f(x / cols, x % cols))

fn product(a: List[Int], b: List[Int]) -> List[Int] =
  list.map(range(0, M * N), x => {
    let i = x / N
    let j = x % N
    list.fold(range(0, K), 0, (s, k) => s + a[i * K + k] * b[k * N + j])
  })

fn floats(xs: List[Int], scale: Float) -> List[Float] = list.map(xs, x => to_float(x) * scale)

fn fill(n: Int, v: Float) -> List[Float] = list.map(range(0, n), _i => v)

fn count_diff(a: List[Float], b: List[Float]) -> Int =
  if len(a) != len(b) {
    0 - 1
  } else {
    list.fold(range(0, len(a)), 0, (n, i) => if to_string(a[i]) != to_string(b[i]) { n + 1 } else { n })
  }

fn first_diff(a: List[Float], b: List[Float]) -> String = {
  let bad = list.filter(range(0, len(a)), i => to_string(a[i]) != to_string(b[i]))
  if len(bad) == 0 { "none" } else { "lane ${bad[0]} (row ${bad[0] / N} col ${bad[0] % N}) got ${a[bad[0]]} want ${b[bad[0]]}" }
}

fn nonfinite(v: List[Float]) -> Int = list.fold(v, 0, (n, x) => if x != x || x == INFINITY || x == 0.0 - INFINITY { n + 1 } else { n })

# ---- one launch ----

fn launch_read(kernel: String, g: (Int, Int, Int), bufs: List[(String, List[Float])], read: Int, word: Option[Int]) -> Result[List[Float], ForeignError] !Gpu = {
  var hs: List[Int] = []
  for (dt, data) in bufs {
    let h = gpu.gpu_alloc(dt, len(data))?
    gpu.gpu_copy_from_host(h, gpu.encode_floats(dt, data))?
    hs = hs ++ [h]
  }
  let (gx, gy, gz) = g
  let args = list.map(hs, h => gpu.Buffer(h))
  let launched = match word {
    Some(bits) -> [args[0], args[1], gpu.Word("f32", bits)] ++ list.map(range(2, len(args)), i => args[i])
    None -> args
  }
  gpu.gpu_launch(kernel, gx, gy, gz, launched)?
  gpu.gpu_sync()?
  let (dt, _d) = bufs[read]
  let out = gpu.decode_floats(dt, gpu.gpu_copy_to_host(hs[read])?)
  for h in hs {
    let _ = gpu.gpu_free(h)
  }
  Ok(out)
}

fn judge(name: String, got: List[Float], want: List[Float], sentinel: Float) -> (Bool, String) = {
  let n = count_diff(got, want)
  if n < 0 {
    (false, "${name}: read back ${len(got)} lanes, want ${len(want)}")
  } else if n == 0 {
    (true, "${name}: exact lanes=${len(want)} (C ${M * N}, sentinel ${len(want) - M * N})")
  } else {
    let over = list.fold(range(M * N, len(want)), 0, (c, x) => if got[x] != sentinel { c + 1 } else { c })
    (false, "${name}: ${n} of ${len(want)} lanes differ, ${over} sentinel lanes past C overwritten, ${nonfinite(got)} not finite, ${first_diff(got, want)}")
  }
}

fn run_case(i: Int, tm: Int, tn: Int, a: (String, List[Float]), b: (String, List[Float]), c_dt: String, c_sent: Float, want_c: List[Float], extra: List[(String, List[Float])], word: Option[Int], poison: Float) -> (Bool, String) !Gpu = {
  let name = case_name(i)
  let (a_dt, a_data) = a
  let (b_dt, b_data) = b
  let bufs = [(a_dt, a_data ++ fill(POISON, poison)), (b_dt, b_data ++ fill(POISON, poison))] ++ extra ++ [(c_dt, fill(M * N + SENT_ROWS * N, c_sent))]
  let want = want_c ++ fill(SENT_ROWS * N, c_sent)
  match launch_read(name, (blocks(M, tm), blocks(N, tn), 1), bufs, len(bufs) - 1, word) {
    Err(e) -> (false, "${name}: the device refused: ${e.kind} ${e.message}")
    Ok(got) -> judge(name, got, want, c_sent)
  }
}

fn run_all(tiles: List[(Int, Int, Int)]) -> List[(Bool, String)] !Gpu = {
  let a_int = flat(M, K, a_small)
  let b_int = flat(K, N, b_small)
  let c_int = product(a_int, b_int)
  let a_sx = flat(M, K, a_sixteenth)
  let b_sx = flat(K, N, b_sixteenth)
  let c_sx = list.map(product(a_sx, b_sx), x => to_float(x) / 256.0)
  let biases = list.map(range(0, N), bias_of)
  let scaled = list.map(c_sx, x => x * 0.375)
  let relu_bf16 = list.map(range(0, M * N), x => narrow.round_bf16(math.max(c_sx[x] + biases[x % N], 0.0)))
  let (tm0, tn0, _tk0) = tiles[0]
  let (tm1, tn1, _tk1) = tiles[1]
  let (tm2, tn2, _tk2) = tiles[2]
  let (tm3, tn3, _tk3) = tiles[3]
  let (tm4, tn4, _tk4) = tiles[4]
  let (tm5, tn5, _tk5) = tiles[5]
  [run_case(0, tm0, tn0, ("f64", floats(a_int, 1.0)), ("f64", floats(b_int, 1.0)), "f64", 0.0 - 12345.0, floats(c_int, 1.0), [], None, INFINITY),
    run_case(1, tm1, tn1, ("f16", floats(a_int, 1.0)), ("f16", floats(b_int, 1.0)), "f16", 0.0 - 1000.0, floats(c_int, 1.0), [], None, INFINITY),
    run_case(2, tm2, tn2, ("i8", floats(a_int, 1.0)), ("i8", floats(b_int, 1.0)), "i32", 0.0 - 12345.0, floats(c_int, 1.0), [], None, 127.0),
    run_case(3, tm3, tn3, ("bf16", floats(a_sx, 0.0625)), ("bf16", floats(b_sx, 0.0625)), "f32", 0.0 - 12345.0, c_sx, [], None, INFINITY),
    run_case(4, tm4, tn4, ("bf16", floats(a_sx, 0.0625)), ("bf16", floats(b_sx, 0.0625)), "bf16", 0.0 - 1024.0, relu_bf16, [("f32", biases ++ fill(POISON, INFINITY))], None, INFINITY),
    run_case(5, tm5, tn5, ("bf16", floats(a_sx, 0.0625)), ("bf16", floats(b_sx, 0.0625)), "f32", 0.0 - 12345.0, scaled, [], Some(SCALE_BITS), INFINITY)]
}

fn read_cubin(path: String) -> Bytes !io =
  match io.with_fs_real(() => io.read_bytes(path)) {
    Ok(b) -> b
    Err(e) -> panic("mmtail_diff: cannot read ${path}: ${e.message}")
  }

fn int_arg(s: String) -> Int = match fmt.parse_int(s) {
  Some(n) -> n
  None -> panic("mmtail_diff: not a number: ${s}")
}

pub fn main() -> Unit !io = io.with_exit_real(() => {
  let ps = args()
  if len(ps) != 25 {
    io.eprintln("usage: mmtail_diff <arch> then six of <cubin> <tm> <tn> <tk>")
    io.exit(2)
  }
  var kernels: Map[String, Bytes] = map.empty()
  var tiles: List[(Int, Int, Int)] = []
  for i in range(0, 6) {
    kernels = map.insert(kernels, case_name(i), read_cubin(ps[1 + i * 4]))
    tiles = tiles ++ [(int_arg(ps[2 + i * 4]), int_arg(ps[3 + i * 4]), int_arg(ps[4 + i * 4]))]
  }
  let ts = tiles
  let lines = with_gpu_real(kernels, () => run_all(ts))
  io.println("  arch ${ps[0]} shape ${M}x${N}x${K} poison=+inf (127 for i8)")
  var failed = 0
  for i in range(0, len(lines)) {
    let (ok, text) = lines[i]
    let (tm, tn, tk) = ts[i]
    io.println("  ${if ok { "PASS " } else { "FAIL " }}${text} tiles=${tm}x${tn}x${tk}")
    if not ok { failed = failed + 1 }
  }
  io.println("tiers exact=${len(lines) - failed}")
  if failed == 0 {
    io.println("tile-gpu-diff: pass")
  } else {
    io.println("tile-gpu-diff: fail")
    io.exit(1)
  }
})

# checker.dawn: a Float expectation does not reach integer literals inside an operator (literal-system-design D5.2)
pub fn half() -> Float = 1 / 2

pub fn bound() -> Float = {
  let f: Float = 1 / 2
  f
}

pub fn mixed(r: Float) -> Float = {
  let x: Float = 2 * r
  let y: Float = 3.14159 * 2 * r
  x + y
}

pub fn bare() -> Float = 1

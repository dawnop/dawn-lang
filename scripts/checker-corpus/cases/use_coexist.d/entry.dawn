# checker.dawn: a whole-module import and a selective import of one module
# coexist (spec §10.2) -- one binds the alias, the other binds names. Both
# orders, because the two registrations sit in different branches. The golden
# is empty on purpose: there is nothing here to report.
use lib
use lib.{Shown, shown}
use other.{OPEN}
use other

pub fn f() -> Shown = Vis

pub fn g() -> Int = shown() + lib.shown() + OPEN + other.two()

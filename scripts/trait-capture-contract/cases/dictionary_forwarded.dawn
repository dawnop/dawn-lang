# An explicit contract isolates this propagation or boundary rule.
type PhantomAt[@s] = { n: Int }
trait Empty[T: ^{c}, ^c] { fn empty_value() -> T }
impl[@s] Empty[PhantomAt[s], ^{s}] { fn empty_value() -> PhantomAt[s] = PhantomAt { n = 0 } }
fn bad[T: Empty[c] + ^{c}, ^c](tag: T) -> (fn() -> Int) = () => {
  let value: T = empty_value()
  0
}
pub fn main() -> Unit !io = { () }

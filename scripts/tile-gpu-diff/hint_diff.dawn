# Layer 2 for the two `optimization_hints` kernels (knife T15), the
# eighteenth of these programs: one `!Gpu` program runs each kernel
# scripts/tile-golden pins under `with_gpu_real` against the machine's GPU
# and under `with_gpu_fake` against a host reference, and prints what each
# device answered.
#
#   hint_diff <hint_entry.cubin> <hint_memory.cubin> <vadd.cubin>
#
# WHAT THIS FAMILY CAN ASK, AND WHAT IT CANNOT. `optimization_hints` is a
# SUGGESTION: the dialect promises that a hint does not change what a
# kernel computes, so there is no corpus anywhere that could tell one
# value of a hint from another by looking at a buffer. That is why
# scripts/tileir-features/attrs.txt caps this family at layer 1 with a
# named exemption, and it is also why this program exists: the promise
# itself is a device claim, and nothing before this asked the device to
# keep it.
#
# So the judgement here is an EQUALITY BETWEEN KERNELS, not between a
# kernel and a reference. All three cases are the same program:
#
#   hint_entry    vadd with hints on the ENTRY (two architecture entries,
#                 four hints; the attribute is written in the function
#                 table with tag 11)
#   hint_memory   vadd with hints on ONE load and on the store, and none
#                 on the other load, so the flag bit is set and clear in
#                 one kernel (the attribute is written in the body, with
#                 no tag at all)
#   vadd          the KERNEL-LEVEL CONTROL: the same body carrying no
#                 hints anywhere. It is what tells "the hints changed the
#                 answer" from "the tree changed the answer"
#
# Each is compared with the host reference the usual way, and then the
# three device results are compared WITH EACH OTHER: the `agree` line says
# how many of the three answered, and how many of them answered the same
# bytes as the control. run.sh holds that line at 3 of 3.
#
# THE CUBIN IS NOT A VERDICT HERE, and knife T15 measured why it must not
# be. Entry hints DO move the cubin on this machine: `num_worker_warps_per_cta
# = 8` and `occupancy = 4` each give a different 8320-byte cubin from the
# same kernel with no hints, and `default = {occupancy = 4}` gives exactly
# the cubin `sm_86 = {occupancy = 4}` gives, which is the fallback rule
# working. Memory hints do NOT move it: `latency` on a load and a store
# leaves the cubin byte for byte identical. Neither fact is a pass or a
# fail -- an assembler is free to ignore every hint and free to act on all
# of them -- so both live in docs/tile-backend-design.md 6.10 and neither
# is asserted anywhere.
use std/io
use std/io.{Exit, with_fs_real}
use std/gpu
use std/gpu.{Gpu, with_gpu_fake, with_gpu_real, WideRefFn, last_out, vadd_ref}
use std/list
use std/map

## leetgpu's own agreement criterion, and the tolerance tier's, the same
## two numbers every family here uses. Nothing in this family needs them:
## all three cases are the exact tier.
pub const ATOL: Float = 1.0e-5
pub const RTOL: Float = 1.0e-5

## The shape the three kernels were recorded with. These must agree with
## scripts/tile-golden/kernels.dawn: 128-wide tiles, no mask, so the grid
## is `HINT_N / HINT_TILE` exactly.
pub const HINT_N: Int = 512
pub const HINT_TILE: Int = 128

## What each kernel carries, counted, so that the transcript says what the
## corpus is rather than leaving it to be read out of kernels.dawn. The
## entry's hints are two architecture entries holding four hints between
## them; the memory kernel's are two operations holding one each, and one
## load holding none.
pub const ENTRY_ARCHS: Int = 2
pub const ENTRY_KEYS: Int = 4
pub const MEMORY_OPS_HINTED: Int = 2
pub const MEMORY_OPS_PLAIN: Int = 1

type Trace = {
  alloc: String,
  upload: String,
  launch: String,
  sync: String,
  download: String,
  result: Option[List[Float]],
  note: String
}

fn kind[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> "ok"
  Err(e) -> e.kind
}

fn message[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> ""
  Err(e) -> e.message
}

fn blank() -> Trace =
  Trace { alloc: "-", upload: "-", launch: "-", sync: "-", download: "-", result: None, note: "" }

# Allocate and fill one buffer per (format, contents) pair, in order.
# Written as recursion rather than a `for` with `?` in it, for the reason
# gath_diff gives (dawn-lang issue #68).
fn alloc_all(bufs: List[(String, List[Float])], i: Int, acc: List[Int]) -> Result[List[Int], ForeignError] !Gpu =
  if i >= len(bufs) {
    Ok(acc)
  } else {
    let (dt, data) = bufs[i]
    match gpu.gpu_alloc(dt, len(data)) {
      Ok(h) -> alloc_all(bufs, i + 1, acc ++ [h])
      Err(e) -> Err(e)
    }
  }

fn upload_all(hs: List[Int], bufs: List[(String, List[Float])], i: Int) -> Result[Unit, ForeignError] !Gpu =
  if i >= len(hs) {
    Ok(())
  } else {
    let (_dt, data) = bufs[i]
    match gpu.gpu_upload(hs[i], data) {
      Ok(_) -> upload_all(hs, bufs, i + 1)
      Err(e) -> Err(e)
    }
  }

fn release(hs: List[Int]) -> Unit !Gpu = {
  for h in hs {
    let _ = gpu.gpu_free(h)
  }
}

## One kernel over `bufs` (each a format and its initial contents) on a
## `gx` by 1 by 1 grid, one stage at a time, stopping at the first refusal
## and saying which stage it was. The LAST buffer is the output, and the
## one this reads back.
fn stages(kernel: String, gx: Int, bufs: List[(String, List[Float])]) -> Trace !Gpu =
  match alloc_all(bufs, 0, []) {
    Err(e) -> Trace { ..blank(), alloc: e.kind, note: e.message }
    Ok(hs) -> {
      let t0 = Trace { ..blank(), alloc: "ok" }
      match upload_all(hs, bufs, 0) {
        Err(e) -> {
          release(hs)
          Trace { ..t0, upload: e.kind, note: e.message }
        }
        Ok(_) -> {
          let t1 = Trace { ..t0, upload: "ok" }
          match gpu.gpu_launch(kernel, gx, 1, 1, hs) {
            Err(e) -> {
              release(hs)
              Trace { ..t1, launch: e.kind, note: e.message }
            }
            Ok(_) -> {
              let s = gpu.gpu_sync()
              let r = gpu.gpu_download(hs[len(hs) - 1])
              release(hs)
              let value = match r {
                Ok(v) -> Some(v)
                Err(_) -> None
              }
              Trace {
                ..t1,
                launch: "ok",
                sync: kind(s),
                download: kind(r),
                result: value,
                note: message(s) ++ message(r)
              }
            }
          }
        }
      }
    }
  }

## Where the real device stopped, as `<kind>@<stage>`, or "" if it did not.
fn stopped(t: Trace) -> String =
  if t.alloc != "ok" {
    t.alloc ++ "@alloc"
  } else if t.upload != "ok" {
    t.upload ++ "@upload"
  } else if t.launch != "ok" {
    t.launch ++ "@launch"
  } else if t.sync != "ok" {
    t.sync ++ "@sync"
  } else if t.download != "ok" {
    t.download ++ "@download"
  } else {
    ""
  }

fn pair(real: Trace, fake: Trace) -> Option[(List[Float], List[Float])] =
  match (real.result, fake.result) {
    (Some(a), Some(b)) -> if len(a) == len(b) { Some((a, b)) } else { None }
    _ -> None
  }

## The largest miss as the tolerance criterion measures it: 1.0 is exactly
## the tolerance, 0.0 is bit-identical. Every case here is the exact tier,
## so this line should read 0.0 three times.
fn scaled_miss(got: List[Float], want: List[Float]) -> Float =
  list.fold(range(0, len(want)), 0.0, (acc, i) => {
    let a = got[i]
    let b = want[i]
    let d = if a > b { a - b } else { b - a }
    let m = if b > 0.0 { b } else { 0.0 - b }
    let s = d / (ATOL + RTOL * m)
    if s > acc { s } else { acc }
  })

fn miss_line(real: Trace, fake: Trace) -> String = match pair(real, fake) {
  Some((a, b)) -> "${scaled_miss(a, b)} (1.0 is exactly the tolerance atol=${ATOL} rtol=${RTOL})"
  None -> "-"
}

fn rendered(o: Option[List[Float]]) -> String = match o {
  Some(v) -> to_string(v)
  None -> "-"
}

## The verdict for one kernel: `identical:exact` (bit for bit),
## `differ:result`, or `blocked:..`. There is no tolerance arm: a sum of
## two f64 tiles is correctly rounded on both sides.
fn verdict(fake: Trace, real: Trace) -> String = {
  let stop = stopped(real)
  if stop != "" {
    "blocked:" ++ stop
  } else if rendered(real.result) == rendered(fake.result) {
    "identical:exact"
  } else {
    "differ:result"
  }
}

# ---- the corpus ----

## The two addends. Nothing here is trying to be hard: the point of this
## family is that the answer is ALREADY known, so the corpus only has to
## be one every lane of which is exact in binary64 and different from its
## neighbours, so that a kernel that wrote the wrong lane would show.
fn lhs_values() -> List[Float] = list.map(range(0, HINT_N), i => to_float(i * 3 - 700) * 0.25)

fn rhs_values() -> List[Float] = list.map(range(0, HINT_N), i => to_float(i % 13 * 7 - 40) * 0.125)

fn zeros(n: Int) -> List[Float] = list.map(range(0, n), _i => 0.0)

# ---- the cases ----

## The kernels this program runs, in the order their cubins are given. The
## control is LAST for no deeper reason than that it reads better under the
## two it is a control for.
fn case_name(i: Int) -> String = ["hint_entry", "hint_memory", "vadd"][i]

fn case_bufs() -> List[(String, List[Float])] =
  [("f64", lhs_values()), ("f64", rhs_values()), ("f64", zeros(HINT_N))]

fn case_kernels(i: Int) -> Map[String, (Int, WideRefFn)] =
  map.from([(case_name(i), (3, last_out(vadd_ref)))])

## What the three kernels carry, so the transcript says it. run.sh holds
## every one of these above zero: a corpus in which no operation carried a
## hint would let a writer that dropped the attribute agree with the
## control, and that is exactly the shape this family is about.
fn shape_of() -> String =
  "lanes=${HINT_N} entry_archs=${ENTRY_ARCHS} entry_keys=${ENTRY_KEYS}"
  ++ " memory_hinted=${MEMORY_OPS_HINTED} memory_plain=${MEMORY_OPS_PLAIN}"

## A vector as a line: its length, its first lanes and its last ones.
fn digest(v: List[Float]) -> String =
  if len(v) <= 8 {
    to_string(v)
  } else {
    "len=${len(v)} head=${to_string(list.take(v, 3))} tail=${to_string(list.drop(v, len(v) - 3))}"
  }

fn shown(o: Option[List[Float]]) -> String = match o {
  Some(v) -> digest(v)
  None -> "-"
}

fn buffers_of() -> String =
  list.fold(case_bufs(), "", (acc, b) => {
    let (dt, data) = b
    let sep = if acc == "" { "" } else { "," }
    acc ++ sep ++ dt ++ "[" ++ to_string(len(data)) ++ "]"
  })

fn read_cubin(path: String) -> Bytes !Exit !io = match with_fs_real(() => io.read_bytes(path)) {
  Ok(b) -> b
  Err(e) -> {
    io.eprintln("hint_diff: cannot read ${path}: ${e.message}")
    io.exit(2)
    bytes_of_nothing()
  }
}

fn usage() -> Unit !Exit !io = {
  io.eprintln("usage: hint_diff <hint_entry.cubin> <hint_memory.cubin> <vadd.cubin>")
  io.exit(2)
}

# `io.exit` needs a handler above it now, and this program is the only
# frame with nothing above it. `Fs` stays where it was, installed per read.
pub fn main() -> Unit !io = io.with_exit_real(() => {
  let paths = args()
  let count = 3
  if len(paths) != count { usage() } else { () }
  var cubins: Map[String, Bytes] = map.empty()
  for i in range(0, count) {
    cubins = map.insert(cubins, case_name(i), read_cubin(paths[i]))
  }
  let bufs = case_bufs()
  let gx = HINT_N / HINT_TILE
  var all_agreed = true
  var blocked = ""
  var any_differ = false
  var exact_count = 0
  # The three device answers, rendered, so that the last line can compare
  # them with each other rather than each with the reference.
  var answers: List[String] = []
  for i in range(0, count) {
    let name = case_name(i)
    let refs = case_kernels(i)
    let fake = with_gpu_fake(refs, () => stages(name, gx, bufs))
    let real = with_gpu_real(cubins, () => stages(name, gx, bufs))
    let v = verdict(fake, real)
    answers = answers ++ [rendered(real.result)]
    io.println("kernel ${name} tier=exact bufs=${buffers_of()} grid=(${gx}, 1, 1)")
    if i == 0 { io.println("  index ${shape_of()}") } else { () }
    io.println("  fake  launch=${fake.launch} result=${shown(fake.result)}")
    io.println("  real  alloc=${real.alloc} upload=${real.upload} launch=${real.launch}"
        ++ " sync=${real.sync} download=${real.download} result=${shown(real.result)}")
    io.println("  miss  ${miss_line(real, fake)}")
    if real.note != "" { io.println("  note  ${real.note}") } else { () }
    io.println("  verdict ${v}")
    if v == "identical:exact" { exact_count = exact_count + 1 } else { () }
    if v != "identical:exact" { all_agreed = false } else { () }
    if v == "differ:result" { any_differ = true } else { () }
    if blocked == "" && not any_differ && v != "identical:exact" { blocked = v } else { () }
  }
  # The measurement this family exists for: the two hinted kernels and the
  # control answered the same bytes. The control is `answers[count - 1]`,
  # and a device that did not answer at all leaves "-" there, which no
  # other answer equals, so a blocked run reads 0 of 3 rather than 3 of 3.
  let seen = answers
  let control = seen[count - 1]
  let same = len(list.filter(range(0, count), i => seen[i] == control && control != "-"))
  io.println("  agree ${same} of ${count} kernels answered the control's bytes")
  # The measurement this family exists for, recorded here and pinned by
  # run.sh: `agree` is 3 of 3 or the dialect's promise about hints did not
  # hold on this device.
  io.println("probe hints agree=${same}/${count} entry_archs=${ENTRY_ARCHS} entry_keys=${ENTRY_KEYS}"
      ++ " memory_hinted=${MEMORY_OPS_HINTED} memory_plain=${MEMORY_OPS_PLAIN}")
  io.println("tiers exact=${exact_count} tolerance=0")
  if all_agreed {
    io.println("tile-gpu-diff: pass")
  } else if any_differ {
    io.println("tile-gpu-diff: fail")
    io.exit(1)
  } else {
    io.println("tile-gpu-diff: ${blocked}")
  }
})

# `io.exit` is typed Unit, so the branch that cannot continue still owes a
# Bytes; this is never reached.
fn bytes_of_nothing() -> Bytes = panic("unreachable: exit did not exit")

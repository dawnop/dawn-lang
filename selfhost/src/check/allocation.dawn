# Checker integers are allocations, not identities. Join explicit declaration
# provenance and binder slots across revisions before deciding that a
# reference means the same thing in both. An equal integer alone never grants
# that.
#
# Nominal and trait ids left this ledger when they stopped being allocations:
# they derive from the declaration (`check/identity.derive`), so a consumer
# needs no table to know what a provider's id is, and two declarations cannot
# quarrel over one number. What remains here is the binder domains. Those are
# packed keys as well (`check/identity.pack` of a declaration and its slot),
# so what the join still buys is the refusal below: a binding both revisions
# claim and number differently is a compiler that broke its own rule.
use std/map
use check/identity
use check/identity.{DeclKey, ModuleKey, Named, ImplHead, EffectDecl, FunctionDecl, TypeDecl, TraitDecl, MethodDecl, module_key}
use check/cx.{Cx, cx_new}
use front/parser
use check/types as builtin_types
use check/types.{Sig, ImplI, Ty, Eff, TyVar, EffVar, TyUnit, EPure, nev, sig_abi_eff}
use front/ast.{Module, DType, DImpl, module_impls}

## A body's own allocations are not bindings. They are slots of the
## declaration the checker is inside, minted while it checks one body, so they
## are not recorded here; this table describes only what a declaration's
## header allocates.
pub type Domain = TypeParameter | EffectParameter
pub type Slot = HeaderSlot(index: Int)
pub type Binding = { declaration: DeclKey, domain: Domain, slot: Slot }
pub type Entry = { binding: Binding, id: Int }
type Data = { bindings: Map[Binding, Int] }
pub opaque type Table = Data

## Repeated observations of the same binding are harmless. Conflicting owners
## are not: accepting one of them would silently map a reference to its rival.
pub fn table(entries: List[Entry]) -> Option[Table] = {
  var bindings: Map[Binding, Int] = map.empty()
  var owners: Map[(Domain, Int), Binding] = map.empty()
  for e in entries {
    match e.binding.slot {
      HeaderSlot(index) -> if index < 0 { return None }
    }
    match map.get(bindings, e.binding) {
      Some(id) -> if id != e.id { return None }
      None -> ()
    }
    match map.get(owners, (e.binding.domain, e.id)) {
      Some(binding) -> if binding != e.binding { return None }
      None -> ()
    }
    bindings = map.insert(bindings, e.binding, e.id)
    owners = map.insert(owners, (e.binding.domain, e.id), e.binding)
  }
  Some(Data { bindings: bindings })
}

## Whether this table names a binding with this key, in this domain. The
## table is opaque and its whole content is which bindings it has observed,
## so this is how anything outside asks; `between` above is the only question
## about two of them that is left.
pub fn published(origin: Table, domain: Domain, id: Int) -> Bool = {
  let data: Data = origin
  for (binding, held) in map.entries(data.bindings) {
    if held == id && binding.domain == domain { return true }
  }
  false
}

pub fn entry(declaration: DeclKey, domain: Domain, slot: Int, id: Int) -> Entry =
  Entry { binding: Binding { declaration: declaration, domain: domain, slot: HeaderSlot(slot) }, id: id }

## Imports retain their declaring module's provenance. Combine those tables
## rather than manufacturing owners from names in the importing scope.
pub fn combine(tables: List[Table]) -> Option[Table] = {
  var entries: List[Entry] = []
  for t in tables {
    let data: Data = t
    for (binding, id) in map.entries(data.bindings) { entries = entries ++ [Entry { binding: binding, id: id }] }
  }
  table(entries)
}

## Rebind a baseline into its enclosing owner, never merge unrelated worlds.
## This does not validate revisions or authorize sharing a memo between owners.
pub fn in_world(origin: Table, from: String, world: String) -> Option[Table] = {
  let data: Data = origin
  var entries: List[Entry] = []
  for (binding, id) in map.entries(data.bindings) {
    let declaration = binding.declaration
    if declaration.scope.world != from { return None }
    let moved = DeclKey { ..declaration, scope: ModuleKey { ..declaration.scope, world: world } }
    entries = entries ++ [Entry { binding: Binding { ..binding, declaration: moved }, id: id }]
  }
  table(entries)
}

## What the two revisions agree about, which since binder keys were packed is
## everything or nothing.
##
## A binding's key is `identity.pack` of the declaration that binds it and its
## lexical slot in that declaration, so a binding both revisions have is a
## binding both revisions numbered the same. There is nothing left to record,
## and what remains is the assertion that this is so: a shared binding whose
## two revisions disagree about its key is a compiler that broke its own
## rule, and no product is admitted over it.
pub fn between(old: Table, next: Table) -> Bool = {
  let a: Data = old
  let b: Data = next
  for (binding, id) in map.entries(a.bindings) {
    match map.get(b.bindings, binding) {
      None -> ()
      Some(target) -> if target != id { return false }
    }
  }
  true
}

## These are declaration binders, never instantiations of a signature. Their
## lexical order is stable under binder renaming; semantic changes still need
## signature/dependency validation before a cache entry can be admitted.
pub fn signature_binders(owner: DeclKey, sig: Sig) -> Option[List[Entry]] = {
  binders(owner, sig.tparams, sig.eparams)
}

fn compiler_key(world: String, kind: identity.Kind, name: String) -> DeclKey =
  DeclKey { scope: module_key(world, "@compiler", "@compiler", ""), path: [Named(kind, name)] }

## The compiler's actual declaration tables own these reserved references.
## Repeated builtin templates deliberately share one binding; no numeric range
## or unchanged-integer fallback grants provenance to an unobserved reference.
pub fn compiler_headers(world: String) -> Option[Table] = {
  var entries: List[Entry] = []
  var known: Map[Int, Bool] = map.empty()
  for (_, adt) in map.entries(builtin_types.prelude_adts()) {
    let key = compiler_key(world, TypeDecl, adt.name)
    entries = entries ++ binders(key, adt.tparams, adt.bound_eparams)?
    for t in adt.tparams {
      match t { TyVar(_, id) -> { known = map.insert(known, id, true) }, _ -> return None }
    }
  }
  for (_, tr) in map.entries(builtin_types.prelude_traits()) {
    let key = compiler_key(world, TraitDecl, tr.name)
    entries = entries ++ binders(key, [tr.tvar], [])?
    match tr.tvar { TyVar(_, id) -> { known = map.insert(known, id, true) }, _ -> return None }
  }
  for info in builtin_types.prelude_impls() {
    for t in info.tparams {
      match t {
        TyVar(name, id) -> if not map.has(known, id) {
          entries = entries ++ [entry(compiler_key(world, TypeDecl, "impl_template_" ++ name), TypeParameter, 0, id)]
          known = map.insert(known, id, true)
        }
        _ -> return None
      }
    }
  }
  for (_, sig) in map.entries(builtin_types.builtins()) {
    for t in sig.tparams {
      match t {
        TyVar(name, id) -> { entries = entries ++ [entry(compiler_key(world, TypeDecl, "builtin_template_" ++ name), TypeParameter, 0, id)] }
        _ -> return None
      }
    }
    for e in sig.eparams {
      match e {
        EffVar(name, id) -> { entries = entries ++ [entry(compiler_key(world, EffectDecl, "builtin_template_" ++ name), EffectParameter, 0, id)] }
        _ -> return None
      }
    }
  }
  match builtin_types.erased_ev_ty() {
    TyVar(_, id) -> { entries = entries ++ [entry(compiler_key(world, TypeDecl, "erased_runtime"), TypeParameter, 0, id)] }
    _ -> return None
  }
  table(entries)
}

## Relocate one checker boundary's own allocations onto a candidate
## revision. Header/dependency admission is a caller obligation, and defaults
## need their own products because their allocations precede function entry;
## do not pretend that one entry permutation describes those independent
## checks as well.
pub fn body_relocation(old_sig: Sig, next_sig: Sig, evidence: List[Int]) -> Bool = {
  for present in old_sig.param_defaults { if present { return false } }
  for present in next_sig.param_defaults { if present { return false } }
  body_segment_relocation(old_sig, next_sig, evidence)
}

## One already-separated boundary. Any preceding defaults must have been
## checked or replayed. The signature may still describe defaults; this
## boundary does not execute them. Both signatures describe entry headers,
## not a body's inferred output: the sealed output is projected only after
## the boundary is admitted.
##
## What this asks used to be three things -- does the recorded header carry
## onto this one, is the entry evidence pack the interval it claims to be,
## and what permutation does the ABI order impose on it. The pack's slots are
## packed keys now and consecutive because they are slots of one declaration,
## and the ABI order is a function of the effect ids in the row, which derive
## from declarations the first question already required to be identical.
## What is left is the first question, the width of the row, and the shape of
## the pack.
pub fn body_segment_relocation(old_sig: Sig, next_sig: Sig, evidence: List[Int]) -> Bool = {
  if old_sig != next_sig { return false }
  if len(evidence) != nev(sig_abi_eff(next_sig)) { return false }
  var index = 0
  for id in evidence {
    if id != evidence[0] + index { return false }
    index = index + 1
  }
  true
}

## Initializers have a declared type, not a function signature or entry
## evidence pack.
pub fn constant_relocation(old_ty: Ty, next_ty: Ty) -> Bool = {
  if old_ty != next_ty { return false }
  true
}

fn binders(owner: DeclKey, type_params: List[Ty], effect_params: List[Eff]) -> Option[List[Entry]] = {
  var out: List[Entry] = []
  var slot = 0
  for t in type_params {
    match t {
      TyVar(_, id) -> { out = out ++ [entry(owner, TypeParameter, slot, id)] }
      _ -> return None
    }
    slot = slot + 1
  }
  slot = 0
  for e in effect_params {
    match e {
      EffVar(_, id) -> { out = out ++ [entry(owner, EffectParameter, slot, id)] }
      _ -> return None
    }
    slot = slot + 1
  }
  Some(out)
}

## Read completed local headers, not imported names or partially resolved
## shells. Opaque aliases own nominal IDs; transparent aliases only own their
## binders. Trait subjects belong to their trait, not separately to each method.
fn header_source(scope: ModuleKey, cx: Cx) -> Bool =
  match cx.src_path {
    None -> scope.source == ""
    Some(path) -> path != "" && path == scope.source
  }

pub(pkg) fn local_headers(scope: ModuleKey, syntax: Module, cx: Cx) -> Option[List[Entry]] = {
  if cx.owner_class != Some(scope.emission_owner) || not header_source(scope, cx) { return None }
  var out: List[Entry] = []
  for declaration in identity.declarations(scope, syntax) {
    let key = declaration.key
    match key.path {
      [Named(TypeDecl, name)] -> {
        let d = match syntax.decls[declaration.declaration] { DType(t) -> t, _ -> return None }
        match d.alias_target {
          Some(_) -> {
            let alias_info = map.get(cx.aliases, name)?
            if alias_info.owner != scope.emission_owner || alias_info.is_opaque != d.is_opaque { return None }
            if len(alias_info.tparams) != len(d.tparams) || len(alias_info.eparams) != len(d.eparams) { return None }
            out = out ++ binders(key, alias_info.tparams, alias_info.eparams)?
          }
          None -> {
            let id = map.get(cx.adts_by_name, name)?
            let adt = map.get(cx.adts, id)?
            if adt.owner != cx.owner_class || adt.name != name || adt.id != id { return None }
            if len(adt.tparams) != len(d.tparams) || len(adt.bound_eparams) != len(d.eparams) { return None }
            out = out ++ binders(key, adt.tparams, adt.bound_eparams)?
          }
        }
      }
      [Named(TraitDecl, name)] -> {
        let id = map.get(cx.traits_by_name, name)?
        let tr = map.get(cx.traits, id)?
        if tr.owner != cx.owner_class || tr.name != name || tr.id != id { return None }
        out = out ++ binders(key, [tr.tvar], [])?
      }
      [Named(TraitDecl, name), Named(MethodDecl, method)] -> {
        let tr = map.get(cx.traits, map.get(cx.traits_by_name, name)?)?
        if tr.owner != cx.owner_class { return None }
        var signature: Option[Sig] = None
        for (method_name, info) in tr.methods {
          if method_name == method { signature = Some(info.sig) }
        }
        let sig = signature?
        if sig.tparams != [tr.tvar] { return None }
        out = out ++ binders(key, [], sig.eparams)?
      }
      [Named(FunctionDecl, name)] -> {
        let sig = map.get(cx.fns, name)?
        if sig.owner != cx.owner_class || sig.name != name || sig.is_builtin || sig.trait_id != None || sig.op_of != None { return None }
        out = out ++ signature_binders(key, sig)?
      }
      [Named(EffectDecl, name)] -> {
        let id = map.get(cx.effects, name)?
        let info = map.get(cx.effect_infos, id)?
        if info.owner != cx.owner_class || info.name != name || info.id != id { return None }
      }
      _ -> ()
    }
  }
  Some(out)
}

## Method signatures are the actual pass_register_impls result, not signatures
## reconstructed from trait declarations. Source ranges locate records only
## inside this revision; the emitted entries join revisions by declaration key.
pub(pkg) fn local_impl_headers(scope: ModuleKey, syntax: Module, cx: Cx,
  signatures: List[List[Option[Sig]]]) -> Option[List[Entry]] = {
  if cx.owner_class != Some(scope.emission_owner) || not header_source(scope, cx) { return None }
  let impls = module_impls(syntax)
  if len(signatures) != len(impls) { return None }
  let declarations = identity.declarations(scope, syntax)
  var out: List[Entry] = []
  for declaration in declarations {
    match declaration.key.path {
      [ImplHead(_, _)] -> {
        let (trait_name, lo, hi) = match syntax.decls[declaration.declaration] {
          DImpl(_, name, _, _, _, _, _, _, start, end) -> (name, start, end)
          _ -> return None
        }
        var found: Option[ImplI] = None
        for info in cx.local_impls {
          if not info.derived && info.owner == cx.owner_class && info.src_path == cx.src_path && info.lo == lo && info.hi == hi {
            if found != None { return None }
            found = Some(info)
          }
        }
        let info = found?
        if map.get(cx.traits_by_name, trait_name) != Some(info.trait_id) { return None }
        var index = 0
        for d in impls {
          if d.lo == lo && d.hi == hi {
            if len(d.tparams) != len(info.tparams) || len(d.methods) != len(signatures[index]) { return None }
            out = out ++ binders(declaration.key, info.tparams, [])?
            var member = 0
            for method in d.methods {
              let key = DeclKey { ..declaration.key, path: declaration.key.path ++ [Named(MethodDecl, method.name)] }
              var unique = false
              for candidate in declarations {
                if candidate.key == key { unique = true }
              }
              if unique {
                let sig = signatures[index][member]?
                if sig.name != method.name || sig.owner != cx.owner_class || sig.tparams != info.tparams || sig.is_builtin ||
                  sig.trait_id != None || sig.op_of != None {
                    return None
                  }
                out = out ++ binders(key, [], sig.eparams)?
              }
              member = member + 1
            }
          }
          index = index + 1
        }
      }
      _ -> ()
    }
  }
  Some(out)
}

fn fixture_key(name: String) -> DeclKey =
  DeclKey { scope: module_key("world", "pkg/m", "pkg/m", "m.dawn"), path: [Named(FunctionDecl, name)] }

test "allocation compiler declarations own only observed reserved references" {
  let origin = compiler_headers("compiler-test")
  assert origin != None
  let saved = origin.expect("compiler provenance")
  # The compiler's own reserved binders are the same integers in every
  # revision, because they are written into the tables rather than minted.
  # What the table is for is the refusal below it: a second table that gives
  # one of them a different id is not a revision of this one.
  assert between(saved, saved)
  var reserved: List[Int] = []
  for (_, adt) in map.entries(builtin_types.prelude_adts()) {
    for t in adt.tparams {
      match t { TyVar(_, id) -> { reserved = reserved ++ [id] }, _ -> { assert false } }
    }
  }
  for (_, tr) in map.entries(builtin_types.prelude_traits()) {
    match tr.tvar { TyVar(_, id) -> { reserved = reserved ++ [id] }, _ -> { assert false } }
  }
  for info in builtin_types.prelude_impls() {
    for t in info.tparams {
      match t { TyVar(_, id) -> { reserved = reserved ++ [id] }, _ -> { assert false } }
    }
  }
  match builtin_types.erased_ev_ty() {
    TyVar(_, id) -> { reserved = reserved ++ [id] }
    _ -> { assert false }
  }
  assert len(reserved) > 0
  for id in reserved { assert published(saved, TypeParameter, id) }
  assert not published(saved, TypeParameter, 1000000)
  let elsewhere = compiler_headers("another-test").expect("another world")
  assert between(saved, elsewhere)
}

test "allocation world rebinding moves every declaration or none" {
  let declaration = fixture_key("body")
  let effect_key = fixture_key("effect")
  let origin = table([entry(effect_key, EffectParameter, 0, 1), entry(declaration, TypeParameter, 0, 2)]).expect("origin")
  let moved = in_world(origin, "world", "session").expect("rebound")
  assert in_world(moved, "session", "world") == Some(origin)
  assert in_world(origin, "wrong", "session") == None
  let header_only = table([entry(effect_key, EffectParameter, 0, 1)]).expect("header only")
  assert in_world(header_only, "wrong", "session") == None
  # a rebound table names no binding the original names, so the two agree
  # about nothing and disagree about nothing
  assert not published(moved, EffectParameter, 1) == false
  assert between(origin, moved)
  let foreign = DeclKey { ..effect_key, scope: ModuleKey { ..effect_key.scope, world: "foreign" } }
  let mixed = table([entry(effect_key, EffectParameter, 0, 1), entry(foreign, EffectParameter, 0, 2)]).expect("mixed worlds")
  assert in_world(mixed, "world", "session") == None
}

test "allocation absent source is explicit rather than a wildcard" {
  let scope = module_key("std", "std/example", "std/example", "")
  # The source guard is independent of the declaration metadata lookup.
  let (empty_syntax, diags) = parser.parse_module("")
  assert len(diags) == 0
  let cx = cx_new(Some("std/example"), None)
  assert local_headers(scope, empty_syntax, cx) == Some([])
  assert local_headers(ModuleKey { ..scope, source: "example.dawn" }, empty_syntax, cx) == None
  assert local_headers(scope, empty_syntax, Cx { ..cx, src_path: Some("example.dawn") }) == None
  assert local_impl_headers(scope, empty_syntax, cx, []) == Some([])
}

test "allocation matches provenance and domains rather than equal integers" {
  let a = fixture_key("a")
  let b = fixture_key("b")
  let old = table([entry(a, TypeParameter, 0, 1), entry(b, TypeParameter, 0, 2), entry(a, EffectParameter, 0, 1)]).expect("old")
  # A binding both revisions name has to be the same integer in both: that is
  # what a packed key promises, and a pair of tables that says otherwise is a
  # compiler that broke it.
  assert between(old, old)
  let swapped = table([entry(a, TypeParameter, 0, 2), entry(b, TypeParameter, 0, 1), entry(a, EffectParameter, 0, 3)]).expect("swapped")
  assert not between(old, swapped)
  # the domains are separate: the same integer under the other domain is a
  # different binding and says nothing about this one
  let other_domain = table([entry(a, EffectParameter, 0, 9)]).expect("other domain")
  assert between(table([entry(a, TypeParameter, 0, 9)]).expect("one domain"), other_domain)
  # a declaration this revision does not have, and one it renamed, are both
  # simply absent
  let changed = DeclKey { ..a, scope: ModuleKey { ..a.scope, world: "other" } }
  let foreign = table([entry(changed, TypeParameter, 0, 7)]).expect("foreign")
  assert between(old, foreign) && not published(foreign, TypeParameter, 1)
  let renamed = table([entry(fixture_key("renamed"), TypeParameter, 0, 7)]).expect("rename")
  assert between(old, renamed) && not published(renamed, TypeParameter, 1)
}

test "allocation constant boundaries validate the declared type without function metadata" {
  let owner = fixture_key("VALUE")
  assert between(table([entry(owner, TypeParameter, 0, 10)]).expect("constant table"),
    table([entry(owner, TypeParameter, 0, 10)]).expect("same table"))
  let old_ty = builtin_types.TyAdt(7, [builtin_types.TyVar("T", 10)])
  assert constant_relocation(old_ty, old_ty)
  assert not constant_relocation(old_ty, TyUnit)
}

test "allocation rejects competing owners and inconsistent binding observations" {
  let a = entry(fixture_key("a"), TypeParameter, 0, 5)
  let b = entry(fixture_key("b"), TypeParameter, 0, 5)
  assert table([a, b]) == None
  assert table([a, Entry { ..a, id: 6 }]) == None
  assert table([Entry { ..a, binding: Binding { ..a.binding, slot: HeaderSlot(-1) } }]) == None
  assert table([a, a]) != None
}

test "allocation combines original module owners without alias identities" {
  let a = fixture_key("provider")
  let b = DeclKey { ..a, scope: ModuleKey { ..a.scope, logical_module: "consumer", emission_owner: "consumer", source: "consumer.dawn" } }
  let provider = table([entry(a, TypeParameter, 0, 1)]).expect("provider")
  let consumer = table([entry(b, TypeParameter, 0, 2)]).expect("consumer")
  let merged = combine([provider, consumer]).expect("combined")
  assert published(merged, TypeParameter, 1) && published(merged, TypeParameter, 2)
  assert not published(provider, TypeParameter, 2)
  assert combine([provider, provider]) == Some(provider)
  let collision = table([entry(b, TypeParameter, 0, 1)]).expect("separate table")
  assert combine([provider, collision]) == None
}

test "allocation signature binders keep lexical slots across renamed variables" {
  let key = fixture_key("generic")
  let sig = Sig { name: "generic", param_tys: [], param_names: [], param_defaults: [], ret: TyUnit,
    eff: EPure, is_builtin: false, tparams: [TyVar("T", 10), TyVar("U", 11)], constraints: [],
    eparams: [EffVar("e", 20)], owner: None, trait_id: None, op_of: None, inferring: false }
  # renaming a binder does not renumber it: the slot is lexical, and the key
  # is the declaration and the slot
  let renamed = Sig { ..sig, tparams: [TyVar("X", 10), TyVar("Y", 11)], eparams: [EffVar("f", 20)] }
  let old = table(signature_binders(key, sig).expect("old signature binders")).expect("old table")
  let next = table(signature_binders(key, renamed).expect("new signature binders")).expect("next table")
  assert between(old, next)
  assert published(next, TypeParameter, 10) && published(next, EffectParameter, 20)
  # the two domains are separate tables as far as a question about a key is
  # concerned: the same integer under the other domain is a different binding
  assert not published(next, EffectParameter, 10) && not published(next, TypeParameter, 20)
  # a revision that renumbered one of them is refused
  let renumbered = table(signature_binders(key, Sig { ..sig, tparams: [TyVar("T", 12), TyVar("U", 11)] })
      .expect("renumbered binders")).expect("renumbered table")
  assert not between(old, renumbered)
  assert signature_binders(key, Sig { ..sig, tparams: [TyUnit] }) == None
  assert signature_binders(key, Sig { ..sig, eparams: [EPure] }) == None
}

test "allocation body boundaries admit an entry pack that is one run of slots" {
  let a = fixture_key("A")
  let key = table([entry(a, EffectParameter, 0, 1)]).expect("headers")
  assert between(key, key)
  let sig = Sig { name: "body", param_tys: [], param_names: [], param_defaults: [], ret: TyUnit,
    eff: builtin_types.eff_union([EffVar("a", 1), EffVar("b", 2)]), is_builtin: false, tparams: [], constraints: [],
    eparams: [], owner: None, trait_id: None, op_of: None, inferring: false }
  # the pack is the declaration's own consecutive slots, in ABI order
  assert body_relocation(sig, sig, [21, 22])
  assert not body_relocation(sig, sig, [21, 23])
  assert not body_relocation(sig, sig, [])
  # a header that does not carry onto this one is refused, defaults included
  assert not body_relocation(sig, Sig { ..sig, eff: EPure }, [21, 22])
  # including one that agrees about its ABI row and disagrees about anything
  # else: what the boundary asks is whether the recorded header carries onto
  # this one field for field, not whether the two pass the same evidence
  assert not body_relocation(sig, Sig { ..sig, name: "renamed" }, [21, 22])
  assert not body_relocation(Sig { ..sig, param_defaults: [true] }, sig, [21, 22])
  assert not body_relocation(sig, Sig { ..sig, param_defaults: [true] }, [21, 22])
  # `body_segment_relocation` is the same boundary for one whose signature
  # still describes defaults it does not execute.
  let with_defaults = Sig { ..sig, param_defaults: [true] }
  assert body_segment_relocation(with_defaults, with_defaults, [21, 22])
}

## The device side of a kernel: a `Dev` effect whose operations are the tile
## instructions a kernel body issues, and the typed surface over them. A kernel
## body is an ordinary Dawn function of type `fn(...) -> Unit !Dev`; nothing
## here runs it. `prog.trace_kernel` runs it once under a recording handler and
## keeps what it issued as a `TileProg`; `render.render` turns that into Tile IR
## text. The host side (buffers, launch) is std/gpu, which never sees a
## `TileProg`: docs/tile-backend-design.md 5.
#
# The shape is std/gpu's. Effect operations cannot be generic (spec 6.5), so
# the operations traffic in SSA handles (`Int`), dtype names (`String`) and
# operation names (`String`), and the functions below add the phantom-typed
# `Tile[D]` / `Param[D]` and are the only surface a kernel body uses. The
# dtype markers for buffer formats are std/gpu's `F64` / `F32` / `BF16` /
# `I32`, so a `Param[F64]` and a `Tensor[F64]` agree on what "f64" means
# without a second declaration. `I32` moved there with knife 10, when i32
# became a buffer format as well as a tile one; `I1` is still declared here,
# because it is a tile element format alone: std/gpu's `element_bytes` does
# not know it and a `Tensor[I1]` cannot be allocated.
#
# One effect operation per shape rather than per operation: `t_binaryf` takes
# the operation's name, so adding `subf` is a name in a list rather than a
# tenth operation. The cost is that a misspelled name is a refusal when the
# kernel is recorded (prog.dawn checks the names against a whitelist) instead
# of a type error; the public functions below are the typed surface that
# spells the names, so a kernel body never writes one.
#
# Handles are minted by the handler; a body never invents one. The three
# opaque types below are three kinds of handle a body can hold, and mixing
# them is a type error rather than a malformed program: a `Tile[F32]` in a
# `Tile[F64]` slot, or a host `Int` where an index tile is wanted, are both
# refused by the checker.
use std/list
use std/str
use std/gpu.{Dtype, dtype_name, dtype_bytes, F64, F32, F16, BF16, TF32, F8E4M3FN, F8E5M2, I32, I8, I64, I4}
use std/narrow.{Rounding}

## A tile value inside a kernel: the SSA handle the handler issued for it,
## of any rank, rank 0 (`tile<f64>`) included. `D` is a phantom (spec 2.7):
## `Tile[F64]` and `Tile[F32]` are two types over one representation, so
## `add` of an f64 tile and an f32 one is a type error.
##
## The SHAPE is not in the type. It belongs to the value: the recording
## handler holds every handle's format and shape, a public function reads
## them off its operands (`t_shape_of`) rather than taking them as
## arguments, and a place that needs a particular rank (an `if`'s
## condition, a loop bound, a reduction's yield) is held to it when the
## kernel records. Until the batch's PR-3 a rank-0 tile had a type of its
## own, `Scalar[D]`; it was folded in here because every reason it existed
## (an `if` wants a rank-0 `i1`, a store wants a tile as wide as its
## pointers) is a fact the recording sees, and the rank is one dimension of
## the shape like any other (docs/tile-backend-design.md 6.26).
pub opaque type Tile[D] = Int

## A scalar index tile inside a kernel: a block id, or later what is computed
## from one. Distinct from `Tile[D]` (it is `i32` and has no format marker)
## and from a host `Int` (a host number is not an SSA name; `load` wants the
## latter and the checker enforces it). `idx_of` and `idx_as_tile` cross
## between this and a rank-0 `Tile[I32]` explicitly.
pub opaque type Idx = Int

## A kernel parameter: its position in the entry signature and its dtype
## name. The phantom `D` is fixed at `param()` and read back as the string,
## so `load` can tell the handler which format it is reading without a
## dictionary the effect could not carry.
pub opaque type Param[D] = (Int, String)

## The identity of one operand of a reduction: what a fold that has seen
## nothing starts from, in that operand's tile format. `reduce` carries one
## per operand.
##
## Its FORMAT is checked outside this repository (`tileiras` refuses an f32
## identity for an f64 operand, measured) and its VALUE is not: a sum whose
## identity is 1.0 assembles into a cubin. So the value is a layer-2 claim
## and nothing else, which is what scripts/tile-gpu-diff's
## reduce-identity-wrong mutant is for.
pub type RedId =
  | IdF(dtype: String, value: Float)
  | IdI(dtype: String, value: Int)
derive Show

## What an `assume` attaches to a value: one of the dialect's three
## predicate attributes (knife T6). Each is a separate bytecode attribute
## tag, and the payloads are three different shapes, which is why this is a
## sum type rather than three fields.
##
##   `DivBy`         every element of the tile is a multiple of `divisor`,
##                   which must be a positive power of two. With `every` and
##                   `along` given, only the FIRST element of each group of
##                   `every` along dimension `along` is claimed to be a
##                   multiple, and the rest of the group is claimed to
##                   increase by one from it (by the pointee's width, for a
##                   tile of pointers). The two are used together or not at
##                   all, and neither may be given for a rank-0 tile.
##   `SameElements`  one value per dimension: dividing dimension `k` into
##                   groups of `groups[k]`, every group holds one repeated
##                   value. `1` everywhere is true of any tile.
##   `Bounded`       every element, read as a SIGNED integer, is at least
##                   `lb` and at most `ub`; either bound may be absent, and
##                   both are inclusive.
##
## NOTHING CHECKS THESE. The dialect says so in as many words (Ops.td's
## AssumeOp: "assume does not check the correctness of the predicate.
## Incorrect predicates may inject incorrect static information and cause
## miscompilation"), so a false predicate is undefined behaviour and not a
## wrong answer. That is why the coverage ledger carries a named layer-3
## exemption for `assume` and this comment is where the reason lives:
## a mutant that made a predicate false would be measuring nothing.
pub type AssumePred =
  | DivBy(divisor: Int, every: Option[Int], along: Option[Int])
  | SameElements(groups: List[Int])
  | Bounded(lb: Option[Int], ub: Option[Int])
derive Show

## One optimization hint: the dialect's own spelling of the key, and the
## integer under it. `OptimizationHintsAttr` (AttrDefs.td) names five keys
## and every one this backend can carry takes an integer, so a hint is a
## pair and not a sum type: `allow_tma` is the one boolean, and it belongs
## to the two view operations that ruling 2 defers.
##
## Which key is legal is decided by the OPERATION, not by this type
## (`OptimizationHintsAttr::verifyWithOp`): an entry takes
## `num_cta_in_cga`, `num_worker_warps_per_cta` and `occupancy`, a load or
## a store takes `latency`. Knife T15's four constructors below are the
## legal ones, and nothing here refuses the others -- see `Hints`.
pub alias Hint = (String, Int)

## The `optimization_hints` of one entry or one memory operation: the
## dialect's NESTED dictionary, one entry per architecture. The outer key
## is an `sm_xx` name (or `default`, the fallback the dialect reads when
## the compilation target has no entry of its own) and the value is that
## architecture's hints.
##
## NOTHING CHECKS THESE, and that is the point of them. The dialect says a
## hint is a suggestion: `tileiras` computes the same answer with them and
## without them, and its verifier for the keys and the ranges is behind
## `-Wunsupported-hints`, off by default, so an unknown architecture, an
## unknown key and an out-of-range value are all accepted in silence
## (measured, knife T15; docs/tile-backend-design.md 6.10). What is NOT
## silent is the SHAPE: every value of the outer dictionary must be a
## dictionary, keys may not repeat, and the counts on the wire must match
## what follows them. That is the whole of what layer 1 can say here, and
## the ledger's exemption for this family says so.
pub alias Hints = List[(String, List[Hint])]

## The hints of one architecture, for the list `Hints` is. `arch` is an
## `sm_xx` name or `default`.
pub fn for_arch(arch: String, hints: List[Hint]) -> (String, List[Hint]) = (arch, hints)

## `num_cta_in_cga`: how many CTAs to put in a CGA. An ENTRY hint. The
## dialect wants a power of two no greater than 16, and 1 on sm_80 to
## sm_89, which is every architecture this machine has.
pub fn hint_num_cta_in_cga(n: Int) -> Hint = ("num_cta_in_cga", n)

## `num_worker_warps_per_cta`: how many worker warps to give a CTA. An
## ENTRY hint. The dialect wants a power of two no greater than 32 and
## clamps anything but 4 or 8 into that range.
pub fn hint_num_worker_warps_per_cta(n: Int) -> Hint = ("num_worker_warps_per_cta", n)

## `occupancy`: how many blocks to aim to keep resident. An ENTRY hint,
## and the one key AttrDefs.td's table leaves out while
## `verifyWithOp` accepts it. The dialect wants 1 to 32.
pub fn hint_occupancy(n: Int) -> Hint = ("occupancy", n)

## `latency`: the latency to assume for a memory operation. A LOAD or
## STORE hint, and the only key either of them takes (`allow_tma` is the
## view operations'). The dialect wants 1 to 10.
pub fn hint_latency(n: Int) -> Hint = ("latency", n)

## The one-bit tile format: what a comparison answers and what a mask is. A
## tile element format, not a buffer format. Its i32 neighbour is std/gpu's
## `I32`, which is both (knife 10).
pub type I1 = I1

impl Dtype[I1] {
  fn dtype_name(d: I1) -> String = "i1"
  fn dtype_bytes(d: I1) -> Int = 1
}

## The float formats a constant can be made in when nothing but the TYPE
## names the format (tileir 0.10.0): `full` and `mma`'s accumulator read
## theirs off this rather than off a marker argument, so
## `let m: Tile[F32] = full([32, 1], 0.0)` is an f32 tile and
## `full([32, 1], 0.0)` with no expected type does not check.
##
## `float_dtype` answers the marker of `D` from the type alone. std/gpu's
## `Dtype` cannot: its methods take the marker as their first argument
## (a type parameter that appears in no argument position cannot be
## inferred there), and a `Tile[D]` is erased at run time, so a function
## generic in `D` and given no `D` value has no other way to learn which
## format it is making. The dictionary this bound passes is that way.
## `float_name` is the format's name, so one bound is enough; it agrees
## with `Dtype`'s `dtype_name` for every format here. The seven formats
## are the dialect's arithmetic floats: the operands `mmaf` takes. The
## exponent-only `f8E8M0FNU` and the sub-byte `f4E2M1FN` are left out,
## as no arithmetic operation takes either.
pub trait FloatDtype[D] {
  fn float_dtype() -> D
  fn float_name(d: D) -> String
}

impl FloatDtype[F64] {
  fn float_dtype() -> F64 = F64
  fn float_name(d: F64) -> String = "f64"
}

impl FloatDtype[F32] {
  fn float_dtype() -> F32 = F32
  fn float_name(d: F32) -> String = "f32"
}

impl FloatDtype[TF32] {
  fn float_dtype() -> TF32 = TF32
  fn float_name(d: TF32) -> String = "tf32"
}

impl FloatDtype[F16] {
  fn float_dtype() -> F16 = F16
  fn float_name(d: F16) -> String = "f16"
}

impl FloatDtype[BF16] {
  fn float_dtype() -> BF16 = BF16
  fn float_name(d: BF16) -> String = "bf16"
}

impl FloatDtype[F8E4M3FN] {
  fn float_dtype() -> F8E4M3FN = F8E4M3FN
  fn float_name(d: F8E4M3FN) -> String = "f8E4M3FN"
}

impl FloatDtype[F8E5M2] {
  fn float_dtype() -> F8E5M2 = F8E5M2
  fn float_name(d: F8E5M2) -> String = "f8E5M2"
}

# The 64-bit integer format is std/gpu's `I64` and not one of this
# module's own. Knife T2 declared it here, beside `I1`, on the grounds that
# it was a tile element format and not a buffer format: `ptr_to_int` answers
# one and nothing allocated a buffer of it. Knife T3 allocates buffers of
# it, so the grounds are gone and there is one `I64` again. `I1` stays here,
# because the dialect has no i1 buffer at all and std/gpu has no marker for
# one.

## A tile of POINTERS inside a kernel. `D` is a phantom as `Tile[D]`'s is:
## the element format the pointers point AT, so a `Ptrs[F64]` where a
## `Ptrs[I32]` is wanted is a type error.
##
## Every `load` and `store` of the strided surface builds one of these
## inside the lowering and never shows it. This type is what the three
## pointer conversions of knife T2 convert, and it exists because they have
## nothing else to convert: `ptr_to_int`, `int_to_ptr` and `ptr_to_ptr` say
## nothing about tiles of numbers.
pub opaque type Ptrs[D] = Int

## The device, as operations a recording handler answers. Names carry a `t_`
## prefix for the reason std/gpu's carry `gpu_`: `use tileir/dev.{Dev}` brings
## every operation into the importing module's namespace (spec 6.5).
##
## `t_block_id` answers the handle of the block index along `axis` (0, 1, 2).
## `t_load` answers the handle of a tile of `dtype` and `shape` whose lane
## `[i, j, ..]` is element `base + i * strides[0] + j * strides[1] + ..` of
## parameter `param`; `t_store` writes one there. `base` is an index handle
## and `strides` are host constants in elements, so a tile of a larger array
## is a stride rather than an operation of its own. Both take an optional
## `mask` (an `i1` tile of `shape`: a lane whose mask bit is 0 is not read
## and not written), and `t_load` an optional `pad` (a tile of `dtype` and
## `shape`: what a masked-off lane reads instead). `None` for both is the
## unmasked memory operation of the earlier releases.
##
## `t_gather` / `t_scatter` are those same two operations with the element
## offsets given as an i32 TILE rather than built from `base` and
## `strides`: lane `[i, j, ..]` reads or writes element `index[i, j, ..]`
## of `param`. There is NO new dialect operation behind them (knife 12).
## `offset`, which every load already goes through, takes any `tile<Nxi32>`
## as its offset operand, so an index tile that came out of memory is the
## same instruction as one the stride ladder computed, and all the two
## spellings differ in is where the numbers come from. `mask` and `pad`
## mean what they mean on `t_load`: a lane the mask blocks is neither read
## nor written, so an index outside the array is legal there.
##
## A `t_scatter` whose `index` names one element twice has NO defined
## answer: the dialect does not order the lanes of a single store against
## each other. Every kernel and every corpus here writes a permutation, and
## scripts/tile-gpu-diff/gath_diff.dawn says so beside its data.
##
## `t_atomic_rmw` / `t_atomic_cas` are the two atomic operations (knife
## 14), addressed the way `t_gather` and `t_scatter` are: an i32 index tile
## rather than a base and a stride ladder, because the reason to want an
## atomic is that the destination is data dependent. Both answer the tile
## of values memory held BEFORE the update, and both take the same optional
## `mask` (a lane it blocks is not touched at all).
##
## `t_atomic_rmw(param, dtype, mode, index, shape, v, mask)` applies `mode`
## to the element and the matching lane of `v` in one transaction: `mode`
## is one of `and` / `or` / `xor` / `add` / `addf` / `max` / `min` /
## `umax` / `umin` / `xchg`. The integer modes want an integer buffer and
## `addf` a float one; `add` is the integer sum and `addf` the float one,
## two modes rather than one because the dialect spells them apart.
## `t_atomic_cas(param, dtype, index, shape, cmp, v, mask)` writes the lane
## of `v` where the element equals the matching lane of `cmp` and leaves it
## alone otherwise, answering what was there either way. Its comparison is
## on the BITS, so a float `cmp` that is a NaN never matches and the two
## zeroes are two values.
##
## Unlike a scatter, an atomic whose lanes name ONE element twice is
## defined: that is what an atomic is for. What is not defined is the
## order they arrive in, so the fold has to be one whose answer does not
## depend on it -- integer addition is, and `histogram` is the kernel that
## rests on it.
##
## `t_constf` / `t_consti` answer a tile of `shape` every lane of which
## holds the given host constant; `t_iota` the `n`-wide i32 tile
## `[0, 1, .., n-1]` (Tile IR's `iota` is one-dimensional and this is it);
## `t_lanes` the i32 tile of the ELEMENT OFFSETS a load at `base` with
## `shape` and `strides` reads, which is the same tile the pointer
## arithmetic of that load is built from.
##
## `t_unaryf(op, ..)` / `t_binaryf(op, ..)` / `t_fma` are the element-wise
## floating-point arithmetic: `op` is one of `negf` / `absf` for the unary
## form and `addf` / `subf` / `mulf` / `divf` / `maxf` / `minf` for the binary
## one. `t_cmpf(pred, ..)` / `t_cmpi(pred, ..)` answer an `i1` tile of the
## operands' shape, `pred` being one of `eq` / `ne` / `lt` / `le` / `gt` /
## `ge`; a float comparison is ORDERED, so every predicate answers 0 on a
## NaN operand. `t_select` takes an `i1` tile and two `dtype` tiles and
## answers the second where the condition is 1 and the third where it is 0.
## `t_mmaf` is the matrix multiply-accumulate: `a` is `[m, k]`, `b` is
## `[k, n]`, `c` and the answer are `[m, n]`. `dtype` is the operands'
## format and `acc` the accumulator's and the answer's, which may differ
## (tileir 0.10.0): the dialect's table pairs each operand format with the
## accumulators it allows, and the recording holds a kernel to it. `t_mmai` is the INTEGER one
## (knife 11): its `a` and `b` are `i8` tiles, its `c` and its answer are
## `i32` ones, and both operands are read SIGNED. It takes no dtype
## argument for that reason -- the three formats are fixed by the dialect
## (Ops.td's MmaIOp: `lhs` and `rhs` are `i8`, `acc` and `result` are
## `i32`), and there is nothing for a caller to choose.
##
## `t_unaryi(op, ..)` / `t_binaryi(op, ..)` are the element-wise INTEGER
## arithmetic (knife 10): `op` is `negi` / `absi` for the unary form and one
## of `addi` / `subi` / `muli` / `divi` / `remi` / `maxi` / `mini` /
## `mulhii` / `andi` / `ori` / `xori` / `shli` / `shri` / `shru` for the
## binary one. Every one of them is EXACT on the device: an i32 result has
## one value and no rounding mode, which is why the layer-2 corpus for
## these has no tolerance branch.
##
## `shri` and `shru` are one dialect opcode under two signedness
## attributes: `shri` is arithmetic (the sign bit is copied down) and
## `shru` is logical (zeros are shifted in), and the two differ on every
## negative operand. `divi` / `remi` / `maxi` / `mini` are signed, as
## `t_cmpi` is; `mulhii` takes no signedness at all (the dialect defines it
## for unsigned operands, and `bytecode.dawn` says so where it is encoded).
## Overflow is `none` everywhere: the device wraps, and so must a host
## reference (std/gpu's `wrap_i32`).
##
## `t_convert(op, from, to, shape, a)` is the width and format change:
## `ftof` (a float tile to another float format, `nearest_even`; knife T17
## adds `ftof_zero`, `ftof_neg_inf`, `ftof_pos_inf` and `ftof_away`, the
## same conversion under the other four IEEE modes, which bytecode 13.4
## allows on some pairs of formats and not on others),
## `itof` (integer tile to float, signed, `nearest_even`), `ftoi` (float
## tile to integer, signed, `nearest_int_to_zero`, the one mode the dialect
## accepts here; `ftoi_sat` is the same with 13.4's `saturating` modifier),
## `exti` (a narrower integer tile to a wider one, UNSIGNED,
## so an `i1` mask widens to 0 or 1 rather than to 0 or -1), `trunci` (a
## wider integer tile to a narrower one, which for `i32` to `i1` is the low
## bit) and `bitcast` (the same bits read as another format of the same
## width, `i32` and `f32` here). `extis` is `exti` under the OTHER
## signedness, spelled as a second name for the reason `shri` and `shru`
## are: one dialect opcode, two names, and the attribute is the whole
## difference.
##
## `t_repack(op, from, to, shape, a)` is the other two conversions, `pack`
## and `unpack`, and what separates them from the six above is that the two
## tiles have different SHAPES. Both reinterpret a rank-1 tile as the byte
## array it occupies, so `shape` is the SOURCE's and the answer's lane count
## is scaled by the ratio of the two element widths; `pack` answers an `i8`
## tile and `unpack` takes one. They are the only way to reach a sub-byte
## format (`i4`, `f4E2M1FN`), which no pointer type can hold.
##
## `t_idx_const` / `t_idx_add` / `t_idx_mul` answer scalar i32 handles: a
## host constant, and the sum and product of two index handles.
##
## `t_loop_begin` / `t_loop_end` bracket a region (tile-backend-design 5.2).
## `t_loop_begin(lower, upper, step, unsigned, inits)` opens a `for` over the index
## handles `[lower, upper)` by `step`, with `inits` as the loop-carried
## values entering it, and answers the induction variable's handle and one
## handle per carried value as the body sees them; the operations issued
## until the matching `t_loop_end` fall inside the region. `t_loop_end(outs)`
## closes it with `outs` as the values the body hands to the next iteration
## (one per carried value, in order) and answers one handle per carried
## value as they stand after the loop. `unsigned` is the loop's
## `unsignedCmp` attribute: false compares the induction variable against
## the bound as a SIGNED i32 and true as an unsigned one, which is a
## different loop whenever the range straddles 2^31. The handler carries
## the memory ordering token through the loop on its own; a body never
## sees it. Only
## the `d_range` family calls the pair; a body calls those.
##
## `t_while_begin` / `t_while_end` bracket the OTHER loop region, the one
## whose trip count is not known when it opens (knife T5).
## `t_while_begin(inits)` opens a `loop` with `inits` as the loop-carried
## values entering it and answers one handle per carried value as the body
## sees them; `t_while_end(cond, outs)` closes it with the rank-0 `i1`
## handle `cond` -- true when this iteration is the last -- and `outs`, the
## values the NEXT iteration receives, and answers one handle per carried
## value as they stand after the loop. What the loop answers when it stops
## is the values that ENTERED the iteration that stopped it, not `outs`:
## the handler writes `if cond { break <entering> } else { yield }` before
## the `continue`, so a body reads "run me while `cond` is false, and give
## me back the value I was called with". The memory ordering token rides
## through as the last carried value, exactly as `for`'s does, and it is
## carried by BOTH terminators (a `break` yields the loop's final values,
## and the token is one of them). Only the `d_loop` family calls the pair.
##
## `t_return_if(cond)` ends the WHOLE KERNEL for this tile block when the
## rank-0 `i1` handle `cond` is true and does nothing when it is false: the
## handler records `if cond { return } else { yield }` where the call is.
## Bytecode 13.4 is what lets that `if` sit inside a `loop` (knife T17:
## ReturnOp's parents became `entry`, `if` and `loop`, and its verifier walks
## through `if` and `loop` to the entry); inside a `for`, a reduction or a
## scan it is refused at recording time, because the dialect refuses it.
## Nothing is carried and nothing is answered: what the block stored before
## the `return` stays stored, and nothing after it runs.
##
## A `shape` is a list of tile dimensions, each a power of two, EXCEPT that
## `[]` is the rank-0 tile (`tile<f64>`): the shape a reduction answers and
## an `if` branches on. The typed surface reads every shape off its
## operands, so a kernel body never writes one for a value it already has.
##
## `t_constf` / `t_consti` of shape `[]` record NOTHING when they are
## issued: the recording handler keeps the value aside and answers a handle
## for it, and the constant is materialised where it is used, at the shape
## the use wants (one `constant` of `tile<1024xf64>` where a 1024-wide
## operation takes it, a rank-0 one where a region's body does). That is
## what "a constant takes no shape" (the batch's C3') costs the recording,
## and it is why a handle a body holds for a constant may never appear in
## the recorded program at all.
##
## `t_spread(dtype, shape, src)` widens a rank-0 tile to `shape`, every lane
## the same value: a `reshape` to one lane and a `broadcast` to `shape`.
## The typed surface never calls it directly: an element-wise operation
## whose operand is rank 0 has the recording spread it (the rank-0 rule),
## and `broadcast` is the explicit spelling.
##
## `t_reduce_begin` / `t_reduce_end` and `t_if_begin` / `t_if_else` /
## `t_if_end` bracket a region the way the loop pair does.
## `t_reduce_begin(dim, shape, identities, operands)` opens a reduction of
## the `operands`, tiles of `shape`, along `dim`, one identity per operand
## in the same order, and answers TWO handles per operand as the body sees
## them: for operand `i`, the ACCUMULATOR at `2 * i` and the ELEMENT at
## `2 * i + 1`. The
## result of a reduction of a rank-`r` tile is rank `r - 1`: the dimension
## `dim` is dropped.
##
## That order is MEASURED, not read: Ops.td's prose says the region
## arguments are `[op_0_current_iter, op_0_prev_iter, ...]` (element first)
## and its own mlirExample names them `(%acc, %elem)` (accumulator first),
## and the two cannot both be true. A kernel whose body answers its first
## region argument and nothing else answers the FIRST element of the
## dimension on the device, and one that answers its second answers the
## LAST, for `reduce` and for `scan`, forward and reversed (09-04, sm_86,
## tileiras 13.3.36). So argument `2 * i` is the fold of everything before
## this point and `2 * i + 1` is the value arriving now. It could never
## show under `reduce` alone -- every reduction body in this tree is
## commutative -- and it decides the answer under `scan`, whose bodies are
## not.
##
## The same probe says the IDENTITY is not folded in at the first position:
## the fold of one element is that element, not `f(identity, element)`.
## Every identity here is a real identity of its body, so the two readings
## agree, and this is written down rather than relied on.
## `t_reduce_end(yields)` closes it with the new accumulator of each operand
## and answers one result per operand.
## `t_scan_begin` / `t_scan_end` are the same bracket for the prefix scan:
## the same `dim`, `shape`, `identities` and `operands`, the same two
## handles per operand, and one attribute more, `reverse`. What differs is
## the SHAPE OF THE RESULT: a scan keeps every dimension (it answers the
## running accumulator at each position along `dim`) where a reduction
## drops the one it folded.
## `t_if_begin(cond)` opens the then-region of an `if` over the rank-0 `i1`
## handle `cond`; `t_if_else(yields)` closes it with what it yields and
## opens the else-region; `t_if_end(yields)` closes that one and answers one
## handle per yielded value. The plan's sketch put no arguments on
## `t_if_else`; the then-region's yields have to reach the record somewhere,
## and this is the only operation of the bracket that can carry them.
##
## `t_extract` / `t_cat` / `t_permute` are the shape operations (knife T2).
## `t_extract(dtype, from, to, src, indices)` answers the subtile of `src`
## whose SLICE number along dimension `k` is `indices[k]`: `to` must divide
## `from` evenly, there is one index per dimension, and the indices are
## slice numbers rather than element offsets (the dialect's own wording).
## `t_cat(dtype, dim, lhs_shape, rhs_shape, lhs, rhs)` joins two tiles that
## agree in every dimension but `dim`. `t_permute(dtype, shape, perm, src)`
## reorders the dimensions: dimension `k` of the answer is dimension
## `perm[k]` of the source, and the source's rank is at least two.
## `t_insert(dtype, sub, whole, src, dst, indices)` is `t_extract`'s other
## direction (knife T16, bytecode 13.4): it answers `dst` (of shape `whole`)
## with the subtile whose slice number along dimension `k` is `indices[k]`
## replaced by `src` (of shape `sub`). The same three rules hold with the
## two shapes' roles exchanged: `sub` divides `whole`, one index per
## dimension, and the indices are slice numbers.
##
## `t_powi(dtype, exp_dtype, shape, a, n)` is the one float operation here
## whose two operands have DIFFERENT formats (knife T16, bytecode 13.4):
## `a` is a float tile of `dtype` and `n` an integer tile of `exp_dtype`
## (i1, i8, i16 or i32, which the dialect reads as SIGNED) of the same
## shape, so it cannot travel through `t_binaryf`, whose one `dtype` is
## both operands'.
##
## `t_num_blocks(axis)` answers the extent of the grid along `axis`, which
## is `t_block_id`'s companion: `t_block_id` is where this block is and this
## is how many there are. A grid-stride loop needs both.
##
## `t_tok_get` / `t_tok_set` / `t_tok_join` are the handler's memory
## ordering cell, exposed. `t_tok_get` answers the token every memory
## operation issued here would take; `t_tok_set` puts one back, so that two
## chains can start from the same place; `t_tok_join` merges two or more of
## them into one and makes it the current token. They are the only
## operations here through which a body sees the token at all, and the
## typed surface has one client for them, `d_fork2`. Everything else keeps
## the chain a line.
##
## `t_shape_of(h)` is the other state query (knife C1'): the element format
## and the shape the handler holds for handle `h`, issuing nothing. For a
## tile it is the tile's type, `[]` for rank 0, a tile read through a view
## included. For a `tensor_view` it is the tensor's extent along each
## dimension (`DYN_DIM` where an operand carries it); for a partition,
## strided or gather/scatter view, the tile one `load_view` or
## `store_view` moves. A token has no shape, and the recording handler
## refuses the question under the kernel's name and the number of the
## operation about to be recorded. It is how a public function reads the
## shape off an operand rather than taking it as an argument, which since
## the batch's PR-3 is every public function that has an operand.
##
## `t_ptrs` / `t_ptr_offset` / `t_ptr_to_int` / `t_int_to_ptr` /
## `t_ptr_to_ptr` / `t_load_ptrs` are the pointer surface. `t_ptrs(param,
## dtype, shape)` answers a tile of `shape` every lane of which is the
## parameter's own address (the reshape and broadcast every ladder opens
## with); `t_ptr_offset` advances such a tile by an i32 tile of ELEMENT
## offsets, the elements being the pointee's; the three conversions are the
## dialect's own, address-preserving and pure type changes; and
## `t_load_ptrs` reads through a pointer tile the body built, sitting in the
## token chain exactly as `t_load` does. Between them they are the second
## way to address memory here, the first being the `base` and `strides` of
## `t_load` -- and they are the only way to say "the same bytes read as
## another format", which is what `t_ptr_to_ptr` is for.
##
## `t_assert` / `t_assume` / `t_print` are knife T6's three, and no two of
## them are the same kind of thing. `t_assert` issues an operation with no
## result that can STOP the launch: the host is told when a lane's
## condition is false. `t_assume` issues one whose result is its operand,
## carrying a claim the compiler may use and nobody checks. `t_print` is in
## the token chain (`print_tko` takes the current token and answers the
## next), and what it does is not visible in any buffer: it writes to the
## process's standard output when the context is synchronised.
##
## `t_store_ptrs` is `t_load_ptrs`'s other direction, and `t_global` /
## `t_get_global` are the static globals (knife T7).
## `t_global(sym, dtype, values, align, is_private, constant)` DECLARES one:
## it adds a record to the module beside the entry rather than an instruction
## to the body, so it answers nothing and may not be issued inside a region.
## `is_private` and `constant` are the two fields the Global section's record
## grew at bytecode 13.3 (knife T8); they are booleans here and the writer
## turns the first into a SymbolVisibility enum value, the way every other
## enum in this package lives in bytecode.dawn and not on this surface.
## `t_get_global(sym, dtype, shape)` answers a tile of `shape` every lane
## of which holds the global's own address, the same reshape and broadcast
## `t_ptrs` performs on a parameter; from there the pointer surface above
## reads and writes it. A `t_get_global` naming a symbol no `t_global`
## declared, or declaring the same symbol twice, is refused when the kernel
## is recorded.
##
## `t_mmaf_scaled` is the block-scaled matrix multiply (knife T10). It is
## `t_mmaf` with two more operands and three formats instead of one: the
## two matrices are `dtype`, the two scale tiles are `scale`, and the
## accumulator and the result are f32, which is the only output type the
## dialect allows. `dims` is `[m, k, n, block]`, where `block` is the scale
## vector size V: a scale tile is `[m, k / block]` on the left and
## `[k / block, n]` on the right, and one of its elements scales a run of
## `block` elements along K.
##
## The four numbers travel as ONE LIST rather than as four parameters
## because a Dawn function value takes at most eight parameters (the
## compiler emits `dawn/rt/Fn0` to `Fn9` and the evidence pack is one of
## the nine), and an effect operation is a function value. Eleven
## parameters compile and then fail at run time with
## `NoClassDefFoundError: dawn/rt/Fn12`; this shape has eight.
##
## `t_alloca(dtype, num_elem, align, shared, shape)` is the automatic
## allocation (knife T10). It answers a tile of `shape` every lane of which
## holds the SAME address, the way `t_get_global` does, because `alloca`
## answers a rank-0 `tile<ptr<D>>` too. `num_elem` elements of `dtype` are
## reserved, aligned to `align` bytes, and the allocation lives as long as
## the block the operation is in: it is scratch within one launch and
## nothing reads it afterwards. `shared` is the dialect's `global` unit
## attribute, which says the address may be handed to other tile threads;
## without it the address is private to this one.
##
## `t_tensor_view`'s `shape` and `strides` may each hold `DYN_DIM` where the
## extent is not known until the kernel runs (knife T12). Those positions
## print as `?` in the type and take an OPERAND instead: `dyn_shape` and
## `dyn_strides` are the handles for them, in the order the markers appear,
## and the recording handler refuses a count that does not match the
## markers. Every one of them is a rank-0 i32 tile, which is what an `Idx`
## already is.
##
## `t_tensor_shape(view, dim)` and `t_index_space_shape(view, dim)` are the
## two SHAPE QUERIES (knife T12). Each answers the extent along one
## dimension, and each is `t_block_id`'s shape: the dialect's operation has
## one result per dimension and the lowering issues the whole of it, binding
## the handle to the `dim`-th. `t_tensor_shape` asks the TENSOR (so its
## dimensions are the tensor view's own and a `?` one is the point of it);
## `t_index_space_shape` asks the GRID of tiles a partition view cuts the
## tensor into, so its rank is the tile's rank and its extent along `k` is
## `ceil(shape[dim_map[k]] / tile_shape[k])`.
##
## `t_strided_view` and `t_gather_view` are the other two views (knife
## T13). A strided view is a partition view whose TRAVERSAL is parametric:
## index `k` advances `traversal[k]` elements rather than `tile_shape[k]`,
## so consecutive tiles may overlap or skip. A gather/scatter view has no
## `dim_map`: its index at `sparse_dim` is a 1D tile of ROW NUMBERS rather
## than a tile index, and `t_load_view` takes that handle in that position.
## `t_atomic_red_view` reduces a whole tile into one tile of a partition or
## a strided view's grid and answers nothing, so it is a `Unit` operation
## that still moves the token chain on.
##
## A load or a store inside a reduction or an `if` is REFUSED: the dialect
## requires a reduction's body to be pure, and neither region carries the
## memory ordering token, so a memory operation inside one would have no
## order at all. `t_print` is refused there for the same reason, and
## `t_assert` and `t_assume` are not: neither is ordered against memory.
##
## `t_cell_view(param, dtype, free)` and `t_cell_fill(param, value)` read
## the CELLS a parameter's marker gives it (`prog.trace1` to `trace5`; the
## batch's PR-1, docs/tile-backend-design.md 6.25). `t_cell_view` answers a
## partition view over the parameter's whole tensor, cut into its cells and
## padded as the marker says, and the index of THIS block's cell in it: a
## dimension that follows grid axis `k` takes the block id along `k`, and
## the dimensions that follow no axis take the handles `free` names, in
## order. The view is the handler's to build and to reuse: one per
## parameter while it is in scope. For an In parameter it is the one view
## here whose base carries an alignment claim (`assume div_by<16>` on the
## parameter itself), because a buffer std/gpu allocates starts on a
## 256-byte boundary and an In's cells start at its first element; for an
## Out it carries none. `t_cell_fill` answers a tile of the parameter's
## cell shape and format with every lane `value`, which for an integer
## format must be a whole number. A parameter with no cells (a `Whole` or
## `Shared` marker, or any parameter under `trace_kernel`) is refused by
## both, under the kernel's name and the call that asked.
##
## `t_sub_view(param, dtype, sub, at)` is `t_cell_view`'s finer cut, for
## an Out written in pieces (`store_sub`): a partition view over the same
## tensor cut into tiles of `sub`, which must divide the cell's tile in
## every dimension, and the index of the piece `at` of THIS block's cell in
## it (`block * (tile / sub) + at` along each dimension). `at` is host
## numbers, each below `tile / sub`, so a piece can never leave the block's
## own cell; the recording refuses one that would.
##
## `t_retile(param, dtype, extent, tile, pad)` is the escape hatch for a
## parameter read two ways (the batch's C4): a partition view over the
## parameter's whole row-major tensor of `extent`, cut into `tile`, padded
## with `pad`, which `load_view` then reads at any index. It answers the
## view alone; an In's carries the alignment claim its cells do.
##
## `t_reshape(dtype, from, to, src)` regroups the lanes of `src` into `to`,
## which holds as many: what a reduction that keeps its dimension issues
## after the fold. `t_broadcast(dtype, from, to, src)` widens the
## dimensions of length 1 in `from` to their length in `to`, every other
## dimension unchanged and the rank the same; a rank-0 tile is `t_spread`'s.
##
## `t_call_enter(name)` and `t_call_exit()` record nothing a kernel computes.
## Every public function below wraps its body in `called(name, ..)`, which
## brackets it with the two, so a handler can tell which public call issued
## which operations: `prog.trace_calls` keeps the kernel's own calls as a
## side table beside the program, and every other handler answers `()`. They
## are the only way that is known exactly, because the mapping is not one to
## one (`tile_at` issues `t_idx_const` and `t_idx_mul`, `add` issues
## `t_binaryf`, `d_range` a whole region).
##
## `t_body_enter()` and `t_body_exit()` record nothing either. Every public
## function that takes a closure (`d_range`, `d_range`, `d_loop`, the
## reductions, the scans, `d_if`, `d_fork2`) runs that closure between the
## two, and runs nothing else between them; a region's trial (`Carry`) runs
## it between them too, and the trial's calls are thrown away with the rest. A call marked inside a body
## is one the KERNEL wrote, in the region the closure fills; a call marked
## anywhere else inside another call is one the library made on its own
## behalf (`idx_mul` inside `tile_at`). That difference is what lets
## `prog.trace_calls` keep a tree of the kernel's calls rather than only the
## outermost ones.
pub effect Dev {
  fn t_block_id(axis: Int) -> Int
  fn t_load(param: Int, dtype: String, base: Int, shape: List[Int], strides: List[Int],
    mask: Option[Int], pad: Option[Int], hints: Hints) -> Int
  fn t_store(param: Int, dtype: String, base: Int, shape: List[Int], strides: List[Int],
    v: Int, mask: Option[Int], hints: Hints) -> Unit
  fn t_gather(param: Int, dtype: String, index: Int, shape: List[Int],
    mask: Option[Int], pad: Option[Int]) -> Int
  fn t_scatter(param: Int, dtype: String, index: Int, shape: List[Int],
    v: Int, mask: Option[Int]) -> Unit
  fn t_atomic_rmw(param: Int, dtype: String, mode: String, index: Int, shape: List[Int],
    v: Int, mask: Option[Int]) -> Int
  fn t_atomic_cas(param: Int, dtype: String, index: Int, shape: List[Int],
    cmp: Int, v: Int, mask: Option[Int]) -> Int
  fn t_constf(dtype: String, shape: List[Int], value: Float) -> Int
  fn t_consti(dtype: String, shape: List[Int], value: Int) -> Int
  fn t_iota(n: Int) -> Int
  fn t_lanes(base: Int, shape: List[Int], strides: List[Int]) -> Int
  fn t_unaryf(op: String, dtype: String, shape: List[Int], a: Int) -> Int
  fn t_binaryf(op: String, dtype: String, shape: List[Int], a: Int, b: Int) -> Int
  fn t_fma(dtype: String, shape: List[Int], a: Int, b: Int, c: Int) -> Int
  fn t_mmaf(dtype: String, acc: String, m: Int, k: Int, n: Int, a: Int, b: Int, c: Int) -> Int
  fn t_mmaf_scaled(dtype: String, scale: String, dims: List[Int],
    a: Int, b: Int, c: Int, sa: Int, sb: Int) -> Int
  fn t_mmai(m: Int, k: Int, n: Int, a: Int, b: Int, c: Int) -> Int
  fn t_cmpf(pred: String, dtype: String, shape: List[Int], a: Int, b: Int) -> Int
  fn t_cmpi(pred: String, shape: List[Int], a: Int, b: Int) -> Int
  fn t_unaryi(op: String, dtype: String, shape: List[Int], a: Int) -> Int
  fn t_binaryi(op: String, dtype: String, shape: List[Int], a: Int, b: Int) -> Int
  fn t_convert(op: String, from: String, to: String, shape: List[Int], a: Int) -> Int
  fn t_repack(op: String, from: String, to: String, shape: List[Int], a: Int) -> Int
  fn t_select(dtype: String, shape: List[Int], cond: Int, a: Int, b: Int) -> Int
  fn t_idx_const(value: Int) -> Int
  fn t_idx_add(a: Int, b: Int) -> Int
  fn t_idx_mul(a: Int, b: Int) -> Int
  fn t_loop_begin(lower: Int, upper: Int, step: Int, unsigned: Bool, inits: List[Int]) -> (Int, List[Int])
  fn t_loop_end(outs: List[Int]) -> List[Int]
  fn t_while_begin(inits: List[Int]) -> List[Int]
  fn t_while_end(cond: Int, outs: List[Int]) -> List[Int]
  fn t_return_if(cond: Int) -> Unit
  fn t_spread(dtype: String, shape: List[Int], src: Int) -> Int
  fn t_reduce_begin(dim: Int, shape: List[Int], identities: List[RedId], operands: List[Int]) -> List[Int]
  fn t_reduce_end(yields: List[Int]) -> List[Int]
  fn t_scan_begin(dim: Int, reverse: Bool, shape: List[Int], identities: List[RedId], operands: List[Int]) -> List[Int]
  fn t_scan_end(yields: List[Int]) -> List[Int]
  fn t_if_begin(cond: Int) -> Unit
  fn t_if_else(yields: List[Int]) -> Unit
  fn t_if_end(yields: List[Int]) -> List[Int]
  fn t_extract(dtype: String, from: List[Int], to: List[Int], src: Int, indices: List[Int]) -> Int
  fn t_cat(dtype: String, dim: Int, lhs_shape: List[Int], rhs_shape: List[Int], lhs: Int, rhs: Int) -> Int
  fn t_permute(dtype: String, shape: List[Int], perm: List[Int], src: Int) -> Int
  fn t_insert(dtype: String, sub: List[Int], whole: List[Int], src: Int, dst: Int, indices: List[Int]) -> Int
  fn t_powi(dtype: String, exp_dtype: String, shape: List[Int], a: Int, n: Int) -> Int
  fn t_num_blocks(axis: Int) -> Int
  fn t_extent_of(param: Int, dim: Int, blocks: Bool) -> Int
  fn t_carry_new(init: Int) -> Int
  fn t_carry_get(c: Int) -> Int
  fn t_carry_set(c: Int, h: Int) -> Unit
  fn t_trial_begin() -> Unit
  fn t_trial_end() -> List[Int]
  fn t_tok_get() -> Int
  fn t_tok_set(tok: Int) -> Unit
  fn t_tok_join(toks: List[Int]) -> Int
  fn t_shape_of(h: Int) -> (String, List[Int])
  fn t_ptrs(param: Int, dtype: String, shape: List[Int]) -> Int
  fn t_ptr_offset(dtype: String, shape: List[Int], ptrs: Int, offs: Int) -> Int
  fn t_ptr_to_int(dtype: String, shape: List[Int], ptrs: Int) -> Int
  fn t_int_to_ptr(dtype: String, shape: List[Int], ints: Int) -> Int
  fn t_ptr_to_ptr(from: String, to: String, shape: List[Int], ptrs: Int) -> Int
  fn t_load_ptrs(dtype: String, shape: List[Int], ptrs: Int, mask: Option[Int], pad: Option[Int]) -> Int
  fn t_assert(shape: List[Int], cond: Int, message: String) -> Unit
  fn t_assume(pred: AssumePred, dtype: String, shape: List[Int], src: Int) -> Int
  fn t_print(fmt: String, dtype: String, shape: List[Int], args: List[Int]) -> Unit
  fn t_store_ptrs(dtype: String, shape: List[Int], ptrs: Int, value: Int, mask: Option[Int]) -> Unit
  fn t_global(sym: String, dtype: String, values: List[Float], align: Int, is_private: Bool, constant: Bool) -> Unit
  fn t_get_global(sym: String, dtype: String, shape: List[Int]) -> Int
  fn t_alloca(dtype: String, num_elem: Int, align: Int, shared: Bool, shape: List[Int]) -> Int
  fn t_tensor_view(param: Int, dtype: String, base: Int, shape: List[Int], strides: List[Int],
    dyn_shape: List[Int], dyn_strides: List[Int]) -> Int
  fn t_partition_view(dtype: String, view: Int, tile_shape: List[Int], dim_map: List[Int],
    padding: Padding) -> Int
  fn t_strided_view(dtype: String, view: Int, tile_shape: List[Int], traversal: List[Int],
    dim_map: List[Int], padding: Padding) -> Int
  fn t_gather_view(dtype: String, view: Int, tile_shape: List[Int], sparse_dim: Int,
    padding: Padding) -> Int
  fn t_atomic_red_view(dtype: String, view: Int, indices: List[Int], mode: String, scope: String,
    value: Int) -> Unit
  fn t_load_view(dtype: String, view: Int, indices: List[Int]) -> Int
  fn t_store_view(dtype: String, view: Int, indices: List[Int], value: Int) -> Unit
  fn t_tensor_shape(view: Int, dim: Int) -> Int
  fn t_index_space_shape(view: Int, dim: Int) -> Int
  fn t_cell_view(param: Int, dtype: String, free: List[Int]) -> (Int, List[Int])
  fn t_cell_fill(param: Int, value: Float) -> Int
  fn t_sub_view(param: Int, dtype: String, sub: List[Int], at: List[Int]) -> (Int, List[Int])
  fn t_retile(param: Int, dtype: String, extent: List[Int], tile: List[Int], pad: Padding) -> Int
  fn t_reshape(dtype: String, from: List[Int], to: List[Int], src: Int) -> Int
  fn t_broadcast(dtype: String, from: List[Int], to: List[Int], src: Int) -> Int
  fn t_call_enter(name: String) -> Unit
  fn t_call_exit() -> Unit
  fn t_body_enter() -> Unit
  fn t_body_exit() -> Unit
}

# `body` bracketed by the two call marks, under the public function's own
# name. Only the public surface is wrapped: a private helper's operations
# belong to the public call that reached it.
fn called[T](name: String, body: fn() -> T !Dev) -> T !Dev = {
  t_call_enter(name)
  let r = body()
  t_call_exit()
  r
}

# A closure the KERNEL passed to a region function, run between the two body
# marks: what it issues is the kernel's own calls inside that region, not the
# region function's. Every public function that takes a closure runs it
# through this and through nothing else, so a handler can tell the two apart
# (`prog.trace_calls` keeps the calls inside a body as children of the region
# call).
fn user_body[T](f: fn() -> T !Dev) -> T !Dev = {
  t_body_enter()
  let r = f()
  t_body_exit()
  r
}

## Whether `name` is one of the dialect's floating point formats. What the
## special padding values are confined to.
pub fn is_float_dtype(name: String) -> Bool =
  name == "f64" || name == "f32" || name == "tf32" || name == "f16" || name == "bf16"
  || name == "f8E4M3FN" || name == "f8E5M2" || name == "f8E8M0FNU" || name == "f4E2M1FN"

## A `tensor_view` value inside a kernel: a reference to a region of global
## memory with a static extent and a static stride along each dimension.
## `D` is a phantom, as `Tile[D]`'s is.
pub opaque type TensorView[D] = Int

## A GRID view value inside a kernel: a `tensor_view` cut into a grid of
## equally sized tiles, which is a `partition_view` when the grid steps by
## the tile and a `strided_view` when it steps by something else.
## `load_view` and `store_view` index the GRID, one index a tile dimension,
## and the tile they move is `tile_shape` wide. Knife T11 called this type
## `PartitionView[D]`; knife T13 renamed it when `strided_view` became the
## second constructor answering it, because the two are ONE surface: they
## differ in what the type says and in nothing a kernel does with the
## handle.
pub opaque type GridView[D] = Int

## A `gather_scatter_view` value inside a kernel (knife T13). It is a grid
## view in every dimension but `sparse_dim`, where the index is a 1D tile of
## ROW NUMBERS rather than one tile index: a load collects those rows and
## stacks them into the tile. It is a type of its own rather than a
## `GridView[D]` because its indices are a different shape, which is what
## `GatherIdx` spells, and because `atomic_red_view_tko` refuses it.
pub opaque type GatherScatterView[D] = Int

## One index of a gather/scatter load or store: `At` is the tile index every
## other view takes at every dimension, and `Rows` is the 1D tile the sparse
## dimension takes. Its length must be the tile's own extent there, which
## the lowering holds it to.
pub type GatherIdx =
  | At(i: Idx)
  | Rows(t: Tile[I32])

## The extent (or the stride) of a tensor view dimension that is not known
## until the kernel runs: the dialect prints it `?` and carries its value in
## an OPERAND of `make_tensor_view` (knife T12). It is a MARKER and not a
## number: what goes on the wire is `ShapedType::kDynamic`, and that lives
## in bytecode.dawn with every other value this package writes. Any
## non-positive marker would do, because a static extent and a static stride
## are both strictly positive; this one is minus one so that a shape printed
## in a diagnostic reads as one.
pub const DYN_DIM: Int = 0 - 1

## One dimension of a `tensor_view_dyn`: a constant extent or stride, or a
## value the kernel computed. `Fixed` is what `tensor_view` takes for every
## dimension, so the two spellings say the same thing when nothing is
## dynamic; `Dyn` is the `?` one.
pub type Dim =
  | Fixed(n: Int)
  | Dyn(v: Idx)

## The extent of a `Dim` as the type states it: the constant, or `DYN_DIM`
## for the ones an operand carries.
pub fn dim_extent(d: Dim) -> Int = match d {
  Fixed(n) -> n
  Dyn(_v) -> DYN_DIM
}

## The handles of the dynamic entries of `ds`, in order. What
## `make_tensor_view` takes as its `dynamicShape` or `dynamicStrides` group,
## and its length is how many `DYN_DIM` markers `dim_extent` produced.
pub fn dim_operands(ds: List[Dim]) -> List[Int] =
  list.fold(ds, [], (acc, d) => match d {
    Fixed(_n) -> acc
    Dyn(v) -> {
      let h: Int = v
      acc ++ [h]
    }
  })

## Which value an out-of-bounds lane of a `load_view` reads. `NoPadding` is
## the dialect's absent `padding_value`: out-of-bounds lanes then hold
## unspecified values, which is why no kernel here uses it for a lane it
## then stores.
##
## The four special values are only legal over a floating point element
## format; `PadZero` is legal over any (Types.cpp's
## `verifyPartitionViewLike`).
pub type Padding =
  | NoPadding
  | PadZero
  | PadNegZero
  | PadNan
  | PadPosInf
  | PadNegInf
derive Show

## The keyword the dialect spells a padding value with, for a diagnostic
## and for the renderer. The NUMBER each one carries on the wire is not
## here: it lives in bytecode.dawn with every other enum this package
## writes, and this surface only ever names the value.
pub fn padding_name(p: Padding) -> String = match p {
  NoPadding -> "none"
  PadZero -> "zero"
  PadNegZero -> "neg_zero"
  PadNan -> "nan"
  PadPosInf -> "pos_inf"
  PadNegInf -> "neg_inf"
}

## Whether `p` is one of the four SPECIAL padding values, which
## `verifyPartitionViewLike` allows only over a floating point element
## type. `zero` is legal over any format and the absent parameter is legal
## everywhere.
pub fn padding_is_special(p: Padding) -> Bool = match p {
  NoPadding -> false
  PadZero -> false
  _ -> true
}

## Whether the view carries a `padding_value` at all. An
## `atomic_red_view_tko` refuses one (AtomicRedViewTkoOp::verify) and a
## load past the end of the tensor reads it.
pub fn padding_present(p: Padding) -> Bool = match p {
  NoPadding -> false
  _ -> true
}

## Parameter `pos` of the entry, of format `d`. Positions count from zero and
## must agree with the `params` list given to `trace_kernel`; the handler
## refuses a load or store that disagrees.
pub fn param[D: Dtype](d: D, pos: Int) -> Param[D] = {
  let p: Param[D] = (pos, dtype_name(d))
  p
}

## The position `p` was declared at.
pub fn position[D](p: Param[D]) -> Int = {
  let t: (Int, String) = p
  let (pos, _dt) = t
  pos
}

## The dtype name `p` was declared with (`"f64"`, `"f32"`).
pub fn param_dtype[D](p: Param[D]) -> String = {
  let t: (Int, String) = p
  let (_pos, dt) = t
  dt
}

## The block index along `axis`: 0, 1 or 2.
pub fn block_id(axis: Int) -> Idx !Dev = called("block_id", () => {
  let h: Idx = t_block_id(axis)
  h
})

## The element offset of tile block `idx` in a run of `n`-element tiles:
## `idx * n`. What `load` and `store` want as their `base`, and the one
## place a block index becomes an element offset; a kernel over a
## multi-dimensional grid builds its base from several of these
## (`idx_add` / `idx_mul`), which is why the memory operations take the
## offset rather than the block index.
pub fn tile_at(idx: Idx, n: Int) -> Idx !Dev = called("tile_at", () => idx_mul(idx, idx_const(n)))

## The row-major strides of `shape`: the suffix products, `[1]` for a
## one-dimensional tile. What `load` and `store` use when the tile is a
## contiguous run of memory (`strides: None`); `strides: Some(..)` is the
## one to use when it is a block of a larger array.
pub fn row_major(shape: List[Int]) -> List[Int] = {
  var out: List[Int] = []
  var acc = 1
  for k in range(0, len(shape)) {
    let d = shape[len(shape) - 1 - k]
    out = [acc] ++ out
    acc = acc * d
  }
  out
}

## The strides of a PERMUTED view of an array laid out by `strides`:
## dimension `k` of the view is dimension `perm[k]` of the array, so
## `permute(row_major([r, c]), [1, 0])` is the layout that reads a row-major
## `r` by `c` array transposed. A permutation is a rearrangement of the
## strides and nothing else: no operation is issued, no element moves, and
## the tile a load answers is already in the order the permuted view has.
## This is not the dialect's `permute` (opcode 0x53), which knife T2 added
## as `permute_tile` below: a transpose of an array being READ is a layout
## and issues nothing, where a transpose of a tile already in registers is
## an instruction. Both are here because both are real; which one a kernel
## wants is decided by where the elements are.
##
## Why the layout is two lists rather than one `Layout` record: knife 8
## fixed the pointer path's load as a shape and a strides list, and since
## the batch's PR-3 the shape is the one geometry `load` still takes (the
## arithmetic reads every shape off its operands). A record would be a
## second spelling of the same pair, not a shorter one.
pub fn permute(strides: List[Int], perm: List[Int]) -> List[Int] =
  list.map(range(0, len(perm)), k => strides[perm[k]])

## The strides that walk ONE axis of a tile of `rank` dimensions and hold
## every other still: `step` at `axis` and zero elsewhere. A load with these
## reads the same element down a whole axis, and `lanes_strided` with them
## answers that axis's coordinate.
pub fn axis_strides(rank: Int, axis: Int, step: Int) -> List[Int] =
  list.map(range(0, rank), k => if k == axis { step } else { 0 })

## The i32 tile of `shape` whose lane `[i, j, ..]` holds the coordinate of
## that lane along `axis`, counted from `base` in steps of `step`: lane
## `[i, j]` of `coord(base, shape, 0, 1)` is `base + i`. The one thing a
## multi-dimensional boundary needs and a flat `lanes` cannot say, because a
## tile at the edge of an array is outside it along one axis and inside it
## along the other.
pub fn coord(base: Idx, shape: List[Int], axis: Int, step: Int) -> Tile[I32] !Dev = called("coord", () => {
  lanes_strided(base, shape, axis_strides(len(shape), axis, step))
})

## The lanes both masks select: a `select`, `a` where it is 1 choosing `b`
## and 0 elsewhere. Knife 10 brought `andi`, which computes the same tile
## over `i1` operands; this is still a `select` because switching it would
## re-record six kernels that were measured against a device under the
## spelling they have, and buy no claim the `andi` clients below do not
## already make. The shape is the masks' own.
pub fn and_mask(a: Tile[I1], b: Tile[I1]) -> Tile[I1] !Dev = called("and_mask", () => {
  select(a, b, bool_const(false))
})

## The lanes either mask selects: a `select`, `a` where it is 1 choosing
## the all-true tile and `b` elsewhere. The `or` to `and_mask`'s `and`,
## written the same way and for the same reason.
pub fn or_mask(a: Tile[I1], b: Tile[I1]) -> Tile[I1] !Dev = called("or_mask", () => {
  select(a, bool_const(true), b)
})

## The lanes whose coordinate `c` satisfies `lo <= c < hi`, as a mask of
## `c`'s shape. Both bounds are host constants; `lo` is not always zero,
## because a stencil reads a coordinate one before the tile's own.
pub fn in_range(c: Tile[I32], lo: Int, hi: Int) -> Tile[I1] !Dev = called("in_range", () => {
  and_mask(ge_i(c, i_const(lo)), lt_i(c, i_const(hi)))
})

## The lanes whose `axis` coordinate, counted from `base`, is below
## `limit`: `tail_mask` for one axis of a multi-dimensional tile. A tile
## over an array whose extent is not a multiple of the tile's covers the
## whole of the last block along each axis, and this is the mask that keeps
## it from reading or writing what is past the end along that one. Like
## `tail_mask` it tests the upper bound alone, because the coordinate it is
## given starts at a block's own base and counts up; a stencil, whose taps
## reach BELOW that base, wants `in_range`. `shape` is the tile's: a mask
## has no operand to read it from.
pub fn axis_mask(base: Idx, shape: List[Int], axis: Int, limit: Int) -> Tile[I1] !Dev = called("axis_mask", () => {
  lt_i(coord(base, shape, axis, 1), i_const(limit))
})

## The tile of `p`'s format and `shape` whose element `[i, j, ..]` is at
## element `base + i * strides[0] + j * strides[1] + ..` of `p`: THE load of
## the pointer path, the escape hatch beside `load_cell` for every read a
## parameter's cells do not describe (a stride of zero, a stencil's
## neighbour, a tile that starts between two cells). The five names 0.6.0
## spelled it with were folded into it in 0.7.0 and removed in 0.8.0.
##
## `shape` is the one shape this takes, because it is the one shape no
## operand carries: it is the block's geometry, what the load reads.
##
## - `strides`: `None` is `row_major(shape)`, a contiguous tile. `Some(s)`
##   is every other layout: `s` is in ELEMENTS and is a host constant, so a
##   tile of a larger array is a stride of that array's row length rather
##   than a new operation (the ladder is one `iota` per dimension, reshaped
##   and broadcast to `shape`, scaled by that dimension's stride and summed).
## - `mask`: `None` reads every lane, so every element named must be inside
##   `p`. `Some(m)`, an `i1` tile of `shape`, reads only the lanes whose bit
##   is 1; a lane whose bit is 0 is not read at all.
## - `pad`: what a lane the mask blocks answers, a tile of `p`'s format: a
##   rank-0 one (`f_const(F64, 0.0)`) is widened to `shape`. With a mask and
##   no pad such a lane answers an UNSPECIFIED value (the dialect's load
##   with no `paddingValue`), which is right for a lane that is only ever
##   stored back under the same mask. A pad with no mask is refused when the
##   kernel is recorded: every lane is read, so it would name a value
##   nothing can answer.
## - `hints`: `optimization_hints` on `load_ptr_tko` (knife T15); the one
##   key a load takes is `latency`. A hint does not change the answer, only
##   the bytes.
##
## Why `strides` is an Option rather than defaulting to `row_major(shape)`:
## the shape-once ruling makes strides the exception a kernel states, not a
## value every call recomputes and shows.
pub fn load[D](p: Param[D], base: Idx, shape: List[Int], strides: Option[List[Int]] = None,
  mask: Option[Tile[I1]] = None, pad: Option[Tile[D]] = None, hints: Hints = []) -> Tile[D] !Dev = called("load", () => {
    let i: Int = base
    let h: Tile[D] = t_load(position(p), param_dtype(p), i, shape, strides_or_row_major(shape, strides),
      handle_of(mask), handle_of(pad), hints)
    h
  })

## Write the tile `v` at `base`: THE store of the pointer path, `load`'s
## other direction, with the options `load` has and no `pad`. The shape is
## `v`'s own, so it cannot disagree with the value; a rank-0 `v` is refused
## (a store writes a tile with a dimension: `broadcast(v, [1])` is one).
## `strides` lays the tile out as `load`'s does; `mask` writes only the
## lanes whose bit is 1 and leaves memory as it was under the rest; `hints`
## is `optimization_hints` on `store_ptr_tko`, whose one key is `latency`.
## Without a mask every lane is written, so every element named must be
## inside `p`.
##
## An Out parameter is written through its cells (`store_cell`,
## `store_sub`) and nothing else: a `store` into one is refused when the
## kernel records, and so is one into an In. A `Shared` parameter, or any
## parameter of `trace_kernel`, takes this.
pub fn store[D](p: Param[D], base: Idx, v: Tile[D], strides: Option[List[Int]] = None,
  mask: Option[Tile[I1]] = None, hints: Hints = []) -> Unit !Dev = called("store", () => {
    let i: Int = base
    let hv: Int = v
    let shape = shape_of(hv)
    t_store(position(p), param_dtype(p), i, shape, strides_or_row_major(shape, strides), hv, handle_of(mask), hints)
  })

# The strides a `load` or a `store` walks: the ones given, or a contiguous
# tile's.
fn strides_or_row_major(shape: List[Int], strides: Option[List[Int]]) -> List[Int] = match strides {
  Some(s) -> s
  None -> row_major(shape)
}

# The handle an optional tile names, for the `t_` operations that take one.
fn handle_of[D](t: Option[Tile[D]]) -> Option[Int] = match t {
  Some(x) -> {
    let h: Int = x
    Some(h)
  }
  None -> None
}

# The format and the shape the recording holds for the handle `h`: what
# every function below reads instead of taking them as arguments.
fn row_of(h: Int) -> (String, List[Int]) !Dev = t_shape_of(h)

fn dtype_of(h: Int) -> String !Dev = {
  let (d, _s) = t_shape_of(h)
  d
}

fn shape_of(h: Int) -> List[Int] !Dev = {
  let (_d, s) = t_shape_of(h)
  s
}

# The shape an element-wise operation over the handles `hs` declares: the
# first operand of rank one or more, or rank 0 when every one is, with each
# of its dimensions of length 1 taken from a later operand of the same rank
# (tileir 0.8.2). A rank-0 operand beside a wider one is widened by the
# recording (the rank-0 rule), so is a same-rank one whose other dimensions
# agree (the same-rank rule), and any other disagreement is refused there,
# by number and name.
fn wider(hs: List[Int]) -> List[Int] !Dev = {
  var out: List[Int] = []
  for h in hs {
    let s = shape_of(h)
    if len(out) == 0 {
      out = s
    } else if len(s) == len(out) {
      let was = out
      out = list.map(range(0, len(was)), k => if was[k] == 1 { s[k] } else { was[k] })
    } else {
      ()
    }
  }
  out
}

# The format an element-wise operation over the handles `hs` is of: the
# first operand's that has one. Only a `lit` has none (`""`); it takes the
# operation's, and an operation of nothing but `lit`s is refused by the
# recording, which cannot give it one.
fn format_of(hs: List[Int]) -> String !Dev = {
  var out = ""
  for h in hs {
    if out == "" {
      out = dtype_of(h)
    } else {
      ()
    }
  }
  out
}

# The element format a pointer tile points at: its row says `ptr<f64>`.
fn pointee(h: Int) -> String !Dev = {
  let d = dtype_of(h)
  if str.starts_with(d, "ptr<") && str.ends_with(d, ">") {
    str.slice(d, 4, str.len(d) - 1)
  } else {
    d
  }
}

## The tile of `p`'s format whose lane `[i, j, ..]` is element
## `index[i, j, ..]` of `p`, shaped like `index`: a load whose element
## offsets come from a tile instead of from `base` and `strides`. Without a
## `mask` every lane is read, so every index must be inside `p`; with one,
## a lane whose bit is 0 is not read at all and answers the matching lane of
## `pad` (a rank-0 pad is widened). That is how an index OUTSIDE the array
## is handled, and the reason the corpora carry such indices: the mask, not
## the arithmetic, is what keeps the read inside the buffer.
##
## Nothing new reaches the device here (knife 12). A strided load already
## builds an i32 tile of element offsets and hands it to `offset`; this
## hands `offset` a tile somebody else computed. Which is why an index
## tile LOADED from a buffer is the whole of data-dependent addressing:
## `load` it, then gather with it. 0.8.0 folded `gather_masked` into the
## two options, as 0.7.0 did the pointer path's loads.
pub fn gather[D](p: Param[D], index: Tile[I32], mask: Option[Tile[I1]] = None,
  pad: Option[Tile[D]] = None) -> Tile[D] !Dev = called("gather", () => {
    let hi: Int = index
    let h: Tile[D] = t_gather(position(p), param_dtype(p), hi, shape_of(hi), handle_of(mask), handle_of(pad))
    h
  })

## Write lane `[i, j, ..]` of `v` to element `index[i, j, ..]` of `p`: a
## store whose element offsets come from a tile. Without a `mask` every
## lane is written, so every index must be inside `p`; with one, a lane
## whose bit is 0 leaves memory as it was, which is what an index outside
## the array gets. NO TWO LANES WRITTEN MAY NAME THE SAME ELEMENT: the
## dialect gives the lanes of one store no order against each other, so a
## duplicated index has no answer at all rather than one of two. A
## permutation is the shape every caller here writes. A scatter is not a
## cell write, so its parameter is a `Shared` one.
pub fn scatter[D](p: Param[D], index: Tile[I32], v: Tile[D], mask: Option[Tile[I1]] = None) -> Unit !Dev = called("scatter", () => {
  let hi: Int = index
  let hv: Int = v
  t_scatter(position(p), param_dtype(p), hi, shape_of(hi), hv, handle_of(mask))
})

## Apply `mode` to element `index[i, j, ..]` of `p` and lane `[i, j, ..]`
## of `v`, one indivisible transaction per lane, and answer what each
## element held BEFORE. Only the lanes `mask` selects take part (every lane
## without one); the others are not read and not written, which is how an
## index outside the array is handled, exactly as on `scatter`.
##
## Two lanes MAY name one element here -- that is the whole point of an
## atomic, and the difference between this and `scatter`. The order they
## arrive in is still unspecified, so a caller may only use a `mode` whose
## answer does not depend on it. Integer `add` is such a mode and is the
## one `histogram` uses; `xchg` is not, and a kernel that used it on
## colliding lanes would have no answer to compare against.
pub fn atomic_rmw[D](p: Param[D], mode: String, index: Tile[I32], v: Tile[D],
  mask: Option[Tile[I1]] = None) -> Tile[D] !Dev = called("atomic_rmw", () => {
    let hi: Int = index
    let hv: Int = v
    let h: Tile[D] = t_atomic_rmw(position(p), param_dtype(p), mode, hi, shape_of(hi), hv, handle_of(mask))
    h
  })

## Add lane `[i, j, ..]` of `v` to element `index[i, j, ..]` of the integer
## buffer `p` where `mask` selects it, and throw the old value away: the
## scatter-with-collisions a histogram is. Named because the returned tile
## is what a caller forgets to use, and a function that never answers it
## cannot be misread as a plain store.
pub fn atomic_add(p: Param[I32], index: Tile[I32], v: Tile[I32], mask: Option[Tile[I1]] = None) -> Unit !Dev = called("atomic_add", () => {
  let _old = atomic_rmw(p, "add", index, v, mask: mask)
  ()
})

## Compare element `index[i, j, ..]` of `p` against lane `[i, j, ..]` of
## `cmp`, write the matching lane of `v` where the two are equal, leave
## the element alone where they are not, and answer what was there either
## way -- one indivisible transaction per lane, on the lanes `mask`
## selects (every lane without one). The comparison is on the BITS and not
## on the format's own equality, so two NaNs with different payloads are
## two values.
pub fn atomic_cas[D](p: Param[D], index: Tile[I32], cmp: Tile[D], v: Tile[D],
  mask: Option[Tile[I1]] = None) -> Tile[D] !Dev = called("atomic_cas", () => {
    let hi: Int = index
    let hc: Int = cmp
    let hv: Int = v
    let h: Tile[D] = t_atomic_cas(position(p), param_dtype(p), hi, shape_of(hi), hc, hv, handle_of(mask))
    h
  })

# ---- element-wise arithmetic: the format and the shape are the operands'
#
# Every operation below reads its format and its shape off its operands
# (`row_of`), so a call cannot name a shape that disagrees with what it is
# handed; knife C1 refused that mistake after the fact, and since the
# batch's PR-3 (C3) there is nothing left to get wrong. A rank-0 operand
# beside a wider one is widened by the recording (the rank-0 rule, 6.25),
# so `sub(t, reduce_max(t))` and `mul(t, f_const(F64, 0.5))` need no
# shape either, and so is an operand of the operation's rank along its
# dimensions of length 1 (the same-rank rule, 0.8.2, 6.29); every other
# shape difference is refused, by number and name, and `broadcast` is the
# explicit spelling.
#
# The float names are `add`, `sub`, `mul`, `div`, `max`, `min`, `neg` and
# `abs` (0.9.0; `add`, `max` and `min` were `addf`, `maxf` and `minf`,
# the last of the suffixes 0.8.0 left). Integer arithmetic keeps its own
# names (`add_i`, `addi`): docs/std-defaults-design.md 3. A module that
# imports `max` or `min` from here shadows the prelude's for host numbers
# too (spec 10.3); `list.max` and a qualified `dev.max` are unaffected.

# The handle of a binary float operation over `a` and `b`.
fn binary[D](op: String, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Tile[D] = t_binaryf(op, format_of([x, y]), wider([x, y]), x, y)
  h
}

fn unary[D](op: String, a: Tile[D]) -> Tile[D] !Dev = {
  let x: Int = a
  let (dt, s) = row_of(x)
  let h: Tile[D] = t_unaryf(op, dt, s, x)
  h
}

fn compare[D](pred: String, a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Tile[I1] = t_cmpf(pred, format_of([x, y]), wider([x, y]), x, y)
  h
}

fn compare_int(pred: String, a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Tile[I1] = t_cmpi(pred, wider([x, y]), x, y)
  h
}

## The element-wise sum of two tiles of one format.
##
## `rounding` is the dialect's `rounding` attribute and `ftz` its
## `flush_to_zero` unit attribute, both at the dialect's own defaults
## (`nearest_even`, not set). `NearestEven` is the one mode
## tile-backend-design 3.2's theorem covers and what every kernel here
## writes unless it says otherwise. The other values this package writes
## are listed at "the attributes of float arithmetic" below.
pub fn add[D](a: Tile[D], b: Tile[D], rounding: Rounding = NearestEven, ftz: Bool = false) -> Tile[D] !Dev = called("add", () => {
  binary(float_op("addf", rounding, ftz), a, b)
})

## The element-wise difference `a - b`. `rounding` and `ftz` as for `add`.
pub fn sub[D](a: Tile[D], b: Tile[D], rounding: Rounding = NearestEven, ftz: Bool = false) -> Tile[D] !Dev = called("sub", () => {
  binary(float_op("subf", rounding, ftz), a, b)
})

## The element-wise product `a * b`. `rounding` and `ftz` as for `add`.
pub fn mul[D](a: Tile[D], b: Tile[D], rounding: Rounding = NearestEven, ftz: Bool = false) -> Tile[D] !Dev = called("mul", () => {
  binary(float_op("mulf", rounding, ftz), a, b)
})

## The element-wise quotient `a / b`. `rounding` and `ftz` as for `add`.
pub fn div[D](a: Tile[D], b: Tile[D], rounding: Rounding = NearestEven, ftz: Bool = false) -> Tile[D] !Dev = called("div", () => {
  binary(float_op("divf", rounding, ftz), a, b)
})

## The element-wise larger of `a` and `b`. Without `propagate_nan` (the
## dialect's default), a NaN operand answers the other operand; with it, a
## NaN operand answers a canonical NaN.
pub fn max[D](a: Tile[D], b: Tile[D], propagate_nan: Bool = false) -> Tile[D] !Dev = called("max", () => {
  binary(if propagate_nan { "maxf_nan" } else { "maxf" }, a, b)
})

## The element-wise smaller of `a` and `b`. `propagate_nan` as for `max`.
pub fn min[D](a: Tile[D], b: Tile[D], propagate_nan: Bool = false) -> Tile[D] !Dev = called("min", () => {
  binary(if propagate_nan { "minf_nan" } else { "minf" }, a, b)
})

# ---- the attributes of float arithmetic (knife T4, reshaped by knife K2) ----
#
# Tile IR's arithmetic carries attributes, and until knife T4 this module
# named only one value of each: `rounding<nearest_even>`, `overflow<none>`,
# `ordered`, `relaxed device`, and no unit attribute set anywhere. Knife T4
# wrote the other values as suffixed names (`addf_down`, `addf_ftz`,
# `maxf_nan`, `add_i_nsw`, ...) and gave a reason: the attribute is part of
# what the operation IS, as it is for `shr_i` and `shr_u`, a caller picks
# one at the point of use, and a name can be grepped for.
#
# Knife K2 made them parameters with the dialect's defaults, and the reason
# no longer holds, for four reasons of its own (docs/std-defaults-design.md
# 7.2):
#
#   1. A named argument greps as well as a suffix does, and better: one grep
#      for `rounding: Down` finds every operation rounded down, which no
#      suffix shared by `addf_down`, `mul_down` and `float_to_float_down`
#      could.
#   2. The values each operation accepts are not uniform (`approx` and
#      `flush_to_zero` are f32 only, SharedVerifiers.h's `verifyApprox` and
#      `verifyFtz`), and a suffix did not encode that either: `D` is generic,
#      so the width is refused by the assembler under both designs. A
#      combination the writer has not learned is refused when the kernel is
#      recorded; before, it had no name at all.
#   3. Combinations had no name. `addf_down` and `addf_ftz` existed and "down
#      and flush to zero" did not; `d_global_private` and `d_global_const`
#      excluded each other; `d_for2` to `d_for4` had no unsigned twin.
#   4. The dialect models these as attributes with defaults, and cuTile
#      Python as keyword arguments with defaults; the rounding direction is
#      std/narrow's `Rounding`, the same value the host reference takes.
#
# What stays a separate name: `sqrt_approx` (`approx` is a precision
# contract, a tolerance tier, and not a rounding direction, so `Rounding`
# has no `Approx`), `shr_i` / `shr_u` and the `*_u` comparisons (signedness
# changes the answer, not how it is rounded), and `add_i64` (another result
# type).
#
# Which values are written today, per operation; every other combination
# reaches the recording handler as an operation name it does not know and is
# refused there, with the kernel's name, before a renderer or a writer sees
# it:
#
#   addf, mul   rounding Down or Up; ftz with NearestEven
#   div         rounding Down or Up
#   sub         the defaults only
#   maxf, minf  propagate_nan
#
# docs/tile-backend-design.md 6.8 records what the device does with each.
# Extending the table is a writer and renderer change (bytecode.dawn's
# `float_rounding` / `float_flags`, render.dawn's `float_spelling` /
# `float_units`) with a layer-1 answer to show, not a change here.

## The dialect's spelling of a rounding direction: the keyword
## `rounding<..>` is written with, and the one std/narrow's file header
## pairs with each variant. The renderer spells the modes from the
## operation names, and this module's tests hold the two to each other.
pub fn rounding_name(r: Rounding) -> String = match r {
  NearestEven -> "nearest_even"
  NearestAway -> "nearest_away"
  TowardZero -> "zero"
  Down -> "negative_inf"
  Up -> "positive_inf"
}

# The suffix an operation name carries for a rounding direction. The
# suffixed names are knife T4's (`addf_neg_inf`) and knife T17's
# (`ftof_zero`, `ftof_away`); the recording handler, the renderer and the
# writer still read those names, so the IR is what it was before the
# surface took a `Rounding`.
fn rounding_suffix(r: Rounding) -> String = match r {
  NearestEven -> ""
  NearestAway -> "_away"
  TowardZero -> "_zero"
  Down -> "_neg_inf"
  Up -> "_pos_inf"
}

# The operation name of the float arithmetic `base` under `rounding` and
# `ftz`. A combination the handler does not know is still a name, and the
# handler's `check_binary` refuses it.
fn float_op(base: String, rounding: Rounding, ftz: Bool) -> String =
  base ++ rounding_suffix(rounding) ++ (if ftz { "_ftz" } else { "" })

## The element-wise square root under the APPROXIMATE rounding mode: the
## architecture's fast reciprocal-square-root path rather than the
## correctly rounded root. f32 only. A tolerance-tier operation by
## construction, and the tolerance is the hardware's, not a series'.
pub fn sqrt_approx[D](a: Tile[D]) -> Tile[D] !Dev = called("sqrt_approx", () => unary("sqrt_approx", a))

## The element-wise negation `-a`: a sign flip, exact for every value.
pub fn neg[D](a: Tile[D]) -> Tile[D] !Dev = called("neg", () => unary("negf", a))

## The element-wise absolute value `|a|`: a sign clear, exact for every value.
pub fn abs[D](a: Tile[D]) -> Tile[D] !Dev = called("abs", () => unary("absf", a))

## The element-wise exponential `e^a`. The device computes it with the CUDA
## Math API (the dialect's `full` rounding mode, its default and the only
## one an f64 tile accepts here), which is an APPROXIMATION: a kernel built
## on it is a tolerance-tier kernel and no corpus makes it exact
## (docs/tile-backend-design.md 6.5).
##
## At bytecode 13.2 `exp` carries no attribute at all. Its `rounding_mode`
## field was added in 13.3, and a 13.2 reader that met one would take the
## next byte of the stream for something else (measured: `failed to get
## result type 0 for CmpIOp`).
pub fn exp[D](a: Tile[D]) -> Tile[D] !Dev = called("exp", () => unary("exp", a))

## The element-wise `2^a`, without `flush_to_zero`. Tolerance tier.
pub fn exp2[D](a: Tile[D]) -> Tile[D] !Dev = called("exp2", () => unary("exp2", a))

## The element-wise natural logarithm. Tolerance tier.
pub fn log[D](a: Tile[D]) -> Tile[D] !Dev = called("log", () => unary("log", a))

## The element-wise base-2 logarithm. Tolerance tier.
pub fn log2[D](a: Tile[D]) -> Tile[D] !Dev = called("log2", () => unary("log2", a))

## The element-wise square root, `rounding<nearest_even>` and no
## `flush_to_zero`. Unlike its neighbours here this one is a CORRECTLY
## ROUNDED operation in IEEE 754, so a kernel built on it can be held to the
## bit-exact tier; the tier is a measurement, not an assumption, and
## scripts/tile-gpu-diff records which one each kernel passed under.
pub fn sqrt[D](a: Tile[D]) -> Tile[D] !Dev = called("sqrt", () => unary("sqrt", a))

## The element-wise reciprocal square root, without `flush_to_zero`: a
## hardware approximation, tolerance tier.
pub fn rsqrt[D](a: Tile[D]) -> Tile[D] !Dev = called("rsqrt", () => unary("rsqrt", a))

## The element-wise hyperbolic tangent, `rounding<full>` (the only mode an
## f64 tile accepts: `approx` is f32-only and `nearest_even` is refused,
## both measured). Tolerance tier.
pub fn tanh[D](a: Tile[D]) -> Tile[D] !Dev = called("tanh", () => unary("tanh", a))

## The element-wise largest integer not above `a`. Exact for every value it
## is defined on, so a kernel built on it stays in the bit-exact tier.
pub fn floor[D](a: Tile[D]) -> Tile[D] !Dev = called("floor", () => unary("floor", a))

## The element-wise smallest integer not below `a`. Exact.
pub fn ceil[D](a: Tile[D]) -> Tile[D] !Dev = called("ceil", () => unary("ceil", a))

## The element-wise `a` raised to the power `b`. Tolerance tier.
pub fn pow[D](a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = called("pow", () => binary("pow", a, b))

## The element-wise `a` raised to the INTEGER power `n`: Tile IR's `fpowi`
## (knife T16, bytecode 13.4), `pow`'s sibling with an exponent tile of an
## integer format (i1, i8, i16 or i32) instead of a float one. The dialect
## reads `n` as SIGNED whatever its width, so an i8 lane holding 0xFF is the
## power -1 and not 255.
##
## EXACT tier, but not against the power a mathematician means. Over f64
## the device answers right-to-left binary exponentiation of `a` to `|n|`
## (one correctly rounded product a step) and, for a negative `n`, the
## reciprocal of that: bit for bit on every lane measured on an RTX 3080
## (tileiras 13.4.92, sm_86), and up to 34 units in the last place away
## from the correctly rounded power on the same corpus
## (docs/tile-backend-design.md 6.19). `a^0` is 1.0 for every `a`, a NaN
## included. tileref's `ref_fpowi` is that sequence; `pow` above, with a
## float exponent, is a different operation and stays tolerance tier.
pub fn powi[D, E](a: Tile[D], n: Tile[E]) -> Tile[D] !Dev = called("powi", () => {
  let x: Int = a
  let y: Int = n
  let r: Tile[D] = t_powi(dtype_of(x), dtype_of(y), wider([x, y]), x, y)
  r
})

# ---- the trigonometric family and the float remainder (knife T1) ----
#
# Seven operations of the FloatingPoint group that carry NO attribute at
# all: their Ops.td records declare a source (or an lhs and an rhs) and
# nothing else, so the writer emits an opcode, a result type and the
# operands, and not one flags byte. That absence is invisible at layer 0
# and at layer 1 it is read as an operand index, which is why the mutant
# that writes the byte anyway is a layer-1 mutant.
#
# All five unary ones are libdevice approximations, so every kernel built
# on them is a tolerance-tier kernel. `remf` is exact by construction (see
# its own comment) and `atan2` is an approximation like the rest.

## The element-wise sine. The device runs the CUDA Math API's, an
## APPROXIMATION, and the host second opinion is `tileref/ref.ref_sin`, an
## independent range reduction and Taylor series. Tolerance tier.
pub fn sin[D](a: Tile[D]) -> Tile[D] !Dev = called("sin", () => unary("sin", a))

## The element-wise cosine. Tolerance tier.
pub fn cos[D](a: Tile[D]) -> Tile[D] !Dev = called("cos", () => unary("cos", a))

## The element-wise tangent. Tolerance tier, and the one of the five with
## poles: near an odd multiple of pi / 2 the answer is enormous and the
## relative part of the tolerance is what carries the comparison, so a
## corpus must not sit on a pole.
pub fn tan[D](a: Tile[D]) -> Tile[D] !Dev = called("tan", () => unary("tan", a))

## The element-wise hyperbolic sine. Tolerance tier. It grows like `e^|x|`,
## so a corpus reaching |x| = 700 in f64 is at the edge of the format.
pub fn sinh[D](a: Tile[D]) -> Tile[D] !Dev = called("sinh", () => unary("sinh", a))

## The element-wise hyperbolic cosine. Tolerance tier.
pub fn cosh[D](a: Tile[D]) -> Tile[D] !Dev = called("cosh", () => unary("cosh", a))

## The element-wise `atan2` of `a` over `b`, with the quadrant taken from
## the signs of both.
##
## THE ARGUMENT ORDER IS THE NUMERATOR FIRST, which is C's `atan2(y, x)`
## with the names swapped: the dialect calls its first operand `x` and its
## second `y` and defines the operation as "the arc tangent of the ratio of
## first and second input arguments x / y" (Ops.td, Atan2Op). So the
## dialect's `x` is C's `y`. Reading the operand names instead of the
## sentence gets the two backwards on every lane off the positive axis,
## which is what the layer-2 mutant atan2-operands-swapped is. The quadrant
## behaviour is measured rather than assumed, in scripts/tile-gpu-diff.
##
## Tolerance tier.
pub fn atan2[D](a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = called("atan2", () => binary("atan2", a, b))

## The element-wise floating-point remainder of `a` by `b`.
##
## TRUNCATED division, not IEEE `remainder`: the dialect states it as
## `a - trunc(a / b) * b`, so the answer takes the sign of the DIVIDEND and
## its magnitude is below `|b|` (Ops.td, RemFOp). That is C's `fmod` and
## not C's `remainder`, and the two differ on every lane where the true
## quotient is more than half a step from its truncation, so a corpus of
## negative dividends and of `|a| < |b|` is what tells them apart. The
## device is what settles it and scripts/tile-gpu-diff is where it was
## settled.
##
## The value is EXACT wherever it is defined: the remainder of two
## representable numbers is itself representable. So a kernel whose only
## operation is this one could be held to the bit-exact tier; the sweep
## that covers it here is a tolerance-tier kernel because its neighbours
## are.
pub fn remf[D](a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = called("remf", () => binary("remf", a, b))

## The element-wise fused multiply-add `a * b + c`, rounded ONCE (the product
## is not rounded before the sum). A host reference that multiplies and then
## adds agrees with this only where the product is exact.
pub fn fma[D](a: Tile[D], b: Tile[D], c: Tile[D]) -> Tile[D] !Dev = called("fma", () => {
  let x: Int = a
  let y: Int = b
  let z: Int = c
  let h: Tile[D] = t_fma(format_of([x, y, z]), wider([x, y, z]), x, y, z)
  h
})

# ---- what the dialect does not have (knife 15) ----
#
# `erf` is not one of Tile IR's hundred operations, and leetgpu 65 is
# stated in terms of one. It does not need to be an operation: it is a
# rational function of `exp` and the arithmetic already here. What follows
# costs ZERO new opcodes, which is the whole of the design decision, and it
# is the only function in this module that is an approximation rather than
# a spelling of something the device does.

## The coefficients of Abramowitz and Stegun 7.1.26, and the pole of its
## substitution `t = 1 / (1 + p x)`. Named rather than inlined so that a
## reader can check them against the handbook.
const AS_P: Float = 0.3275911
const AS_A1: Float = 0.254829592
const AS_A2: Float = 0.0 - 0.284496736
const AS_A3: Float = 1.421413741
const AS_A4: Float = 0.0 - 1.453152027
const AS_A5: Float = 1.061405429

## The error function of `a`, element-wise, BY COMPOSITION.
##
## Abramowitz and Stegun, Handbook of Mathematical Functions, formula
## 7.1.26: for `x >= 0`, with `t = 1 / (1 + 0.3275911 x)`,
##
##   erf(x) = 1 - (a1 t + a2 t^2 + a3 t^3 + a4 t^4 + a5 t^5) exp(-x^2) + e
##
## with `|e| <= 1.5e-7` for every `x >= 0` (the handbook's own bound; the
## largest this tree has measured is 1.385e-7, in a std/gpu test block).
## The negative half comes from the odd symmetry `erf(-x) = -erf(x)`, which
## is what the `select` below is: 7.1.26 holds for `x >= 0` only, and
## dropping the sign flip answers `erf(|x|)`.
##
## 1.5e-7 is inside the `atol = 1e-5` leetgpu compares under
## (docs/tile-backend-design.md 6.5), so every kernel built on this is a
## TOLERANCE tier kernel and cannot be anything else. The host reference it
## is compared against is `tileref/ref.ref_erf`, a series accurate to 4e-15, so
## the difference a device run reports IS this error and not a disagreement
## between two approximations.
##
## Operations used, all of them already here: `absf`, `mulf`, `addf`,
## `divf`, `negf`, `exp`, `subf`, a float compare and a `select`. The
## constants take no shape: each is materialised where it is used, at the
## operand's.
pub fn erf[D](a: Tile[D]) -> Tile[D] !Dev = called("erf", () => {
  let k = (v: Float) => {
    let c: Tile[D] = t_constf(dtype_of(handle(a)), [], v)
    c
  }
  let ax = abs(a)
  let one = k(1.0)
  let t = div(one, fma(k(AS_P), ax, one))
  let inner = fma(t, fma(t, fma(t, fma(t, k(AS_A5), k(AS_A4)), k(AS_A3)), k(AS_A2)), k(AS_A1))
  let m = sub(one, mul(mul(t, inner), exp(neg(mul(ax, ax)))))
  select(lt(a, k(0.0)), neg(m), m)
})

# The handle a tile is, for the effect operations that take one.
fn handle[D](t: Tile[D]) -> Int = {
  let h: Int = t
  h
}

## The matrix multiply-accumulate `a * b + acc`: `a` is `[m, k]`, `b` is
## `[k, n]` and `acc` and the answer are `[m, n]`. The two operands share
## one format and the accumulator may have another (tileir 0.10.0; 0.9's
## `mmaf` took three of one format): bf16 operands into an f32
## accumulator is `mma(a, b, acc)` with `a: Tile[BF16]` and
## `acc: Tile[F32]`. The pairs the dialect allows (Ops.td's MmaFOp table)
## are the only ones the recording takes:
##
## | operands | accumulator |
## |---|---|
## | `f8E4M3FN`, `f8E5M2`, `f16` | `f16` or `f32` |
## | `bf16`, `tf32`, `f32` | `f32` |
## | `f64` | `f64` |
##
## and it refuses any other pair with this table in the message. The
## accumulator's format is `C`, read from the type (`FloatDtype`), so a
## format-less `lit(0.0)` accumulator is made in it: `C` comes from the
## accumulator's own type or from what the answer is checked against, as
## in `let s: Tile[F32] = mma(a, b, lit(0.0))`.
##
## The three numbers are the operands' own, and the recording refuses a `b`
## whose K is not `a`'s; a rank-0 accumulator is widened to `[m, n]`. This
## is the ONE operation here whose summation over `k` has no specified
## order and no promised instruction: `tileiras --remarks=tensorcore` says
## whether the device used a tensor core or plain FMAs, and either way a
## kernel built on it is a tolerance-tier kernel
## (docs/tile-backend-design.md 6.5).
##
## `fast_acc` is a 13.3 flag and is never written here. The Tile IR
## operation is still `mmaf`; the integer one is `mmai` below.
pub fn mma[A, C: FloatDtype](a: Tile[A], b: Tile[A], acc: Tile[C]) -> Tile[C] !Dev = called("mma", () => {
  let x: Int = a
  let y: Int = b
  let z: Int = acc
  let (dt, sa) = row_of(x)
  let sb = shape_of(y)
  let (m, k) = matrix_dims(sa)
  let (_k2, n) = matrix_dims(sb)
  let c: C = float_dtype()
  let h: Tile[C] = t_mmaf(dt, float_name(c), m, k, n, x, y, z)
  h
})

# The two dimensions of a matrix operand, or ones for an operand that is not
# rank 2: the recording then refuses it as "not a matrix" (`check_k`), which
# is the message that names the mistake.
fn matrix_dims(s: List[Int]) -> (Int, Int) = if len(s) == 2 { (s[0], s[1]) } else { (1, 1) }

## The BLOCK-SCALED floating-point matrix multiply-accumulate (knife T10;
## `mmaf_scaled` before tileir 0.10.0): `mma` for the low-precision
## formats that carry a separate exponent per run of K. `a` is `[m, k]`, `b` is `[k, n]`, `c` and the answer are f32
## tiles of `[m, n]`, and `sa` and `sb` are scale tiles of `[m, k / block]`
## and `[k / block, n]`: each scale element multiplies a run of `block`
## elements along K in the matrix beside it, and `block` is read off `sa`.
##
## The dialect allows two combinations and nothing else (Ops.td's table):
## `f8E4M3FN`, `f8E5M2` or `f4E2M1FN` operands with `f8E8M0FNU` scales, and
## `f4E2M1FN` operands with `f8E4M3FN` scales. The result is f32 in both.
## There is no combination with a wide operand format, which is why this
## operation cannot be assembled for this machine's sm_86 at all: every
## operand type it takes is one `tileiras` refuses below sm_100.
pub fn mma_scaled[D, S](a: Tile[D], b: Tile[D], c: Tile[F32], sa: Tile[S], sb: Tile[S]) -> Tile[F32] !Dev = called("mma_scaled", () => {
  let x: Int = a
  let y: Int = b
  let z: Int = c
  let p: Int = sa
  let q: Int = sb
  let (dt, s_a) = row_of(x)
  let (m, k) = matrix_dims(s_a)
  let (_k2, n) = matrix_dims(shape_of(y))
  let (scale, s_sa) = row_of(p)
  let (_m2, per) = matrix_dims(s_sa)
  let block = if per > 0 && k % per == 0 { k / per } else { 0 }
  let h: Tile[F32] = t_mmaf_scaled(dt, scale, [m, k, n, block], x, y, z, p, q)
  h
})

## The INTEGER matrix multiply-accumulate `a * b + c` (knife 11): `a` is an
## `i8` tile of `[m, k]`, `b` an `i8` tile of `[k, n]`, and `c` and the
## answer are `i32` tiles of `[m, n]`. Both operands are read SIGNED (the
## dialect carries `signedness_lhs` and `signedness_rhs` separately; this
## surface fixes both, because a kernel that wanted the unsigned reading
## would want a `u8` tile type the dialect does not have).
##
## Unlike `mma`, this is an EXACT operation: every partial product of two
## i8 values fits in 15 bits and the accumulator is i32, so the sum over `k`
## is the same integer whatever order the device folds it in. A kernel built
## on it is exact tier, and that is a theorem rather than a corpus.
##
## It keeps its `i` where the float `mma` dropped its `f` (tileir 0.10.0),
## as the integer arithmetic keeps `addi` beside the float `add`: its
## formats are the dialect's and not the caller's, its tier is exact where
## `mma`'s is tolerance, and one name over both would check an `I8` operand
## against the float table and refuse it only when the kernel records.
pub fn mmai(a: Tile[I8], b: Tile[I8], c: Tile[I32]) -> Tile[I32] !Dev = called("mmai", () => {
  let x: Int = a
  let y: Int = b
  let z: Int = c
  let (m, k) = matrix_dims(shape_of(x))
  let (_k2, n) = matrix_dims(shape_of(y))
  let h: Tile[I32] = t_mmai(m, k, n, x, y, z)
  h
})

# ---- constants take no shape (the batch's C3') ----
#
# A constant is a value, and its shape is decided where it is used: the
# recording materialises it there, at the shape of the operation that takes
# it (`Dev`'s doc says how), so `mul(t, f_const(F64, 0.5))` over a
# `[1024]` tile records one `constant <f64: 0.5> : tile<1024xf64>` just
# before the `mulf`. A constant that is never used records nothing. A
# constant that must have a shape of its own (a loop's starting value) is
# `full([64, 64], 0.0)` under an annotation that names its format,
# `broadcast(f_const(F64, 0.0), [64, 64])` written out, or `zeros(p)` for a
# cell of `p`.

## The rank-0 tile of format `d` holding `value`, fixed when the kernel is
## recorded, which is what a host `Float` in a kernel body means.
pub fn f_const[D: Dtype](d: D, value: Float) -> Tile[D] !Dev = called("f_const", () => {
  let h: Tile[D] = t_constf(dtype_name(d), [], value)
  h
})

## A float constant with no format of its own: `mul(s, lit(0.5))` is
## `mul(s, f_const(F64, 0.5))` when `s` is a `Tile[F64]` and
## `mul(s, f_const(F32, 0.5))` when it is a `Tile[F32]` (tileir 0.8.2). As
## a constant's shape is the use's, so is its format: the recording makes
## it where it meets an element-wise operation, of that operation's format
## (JAX calls this a weakly typed constant). `D` is found from what the
## call is checked against, so `lit` is written after a typed operand
## (`mul(s, lit(0.5))`, not `mul(lit(0.5), s)`) or under an annotation.
## A place that needs a format of its own -- a `broadcast`, a reduction, a
## loop's starting value, a store, an integer operation -- refuses a `lit`
## by name and says to write `f_const` there.
pub fn lit[D](value: Float) -> Tile[D] !Dev = called("lit", () => {
  let h: Tile[D] = t_constf("", [], value)
  h
})

## The tile of `shape` every lane of which holds `value`, in the format the
## call is checked against (tileir 0.10.0): `let m: Tile[F32] =
## full([32, 1], 0.0)`, or a `Carry[F32]` annotation on the `carry` it
## starts. Like `lit`, its format comes from where it is used; unlike
## `lit`, it has one of its own once made, so it can be what a `broadcast`
## or a loop's starting value cannot take a `lit` for. It records exactly
## what `broadcast(f_const(F32, 0.0), [32, 1])` records (one `constant` of
## that shape, made where it is used), so swapping the two changes no byte.
##
## `zeros(p)` and `fill(p, v)` are the same tile shaped like a cell of `p`
## in `p`'s format; they stay, because there the parameter already says
## both, and they also make integer tiles, which this does not.
pub fn full[D: FloatDtype](shape: List[Int], value: Float) -> Tile[D] !Dev = called("full", () => {
  let d: D = float_dtype()
  let c: Tile[D] = t_constf(float_name(d), [], value)
  broadcast(c, shape)
})

## The rank-0 i32 tile holding `value`.
pub fn i_const(value: Int) -> Tile[I32] !Dev = called("i_const", () => {
  let h: Tile[I32] = t_consti("i32", [], value)
  h
})

## The rank-0 `i8` tile holding the low octet of `value`, read as a
## two's-complement signed byte. The padding value of a masked load over an
## 8-bit buffer, and the only way to name an i8 constant here: there is no
## i8 ARITHMETIC in this surface (`exti` widens to i32 and `trunci` comes
## back), so this and the memory operations are the whole of what an i8
## tile does.
pub fn i8_const(value: Int) -> Tile[I8] !Dev = called("i8_const", () => {
  let h: Tile[I8] = t_consti("i8", [], value)
  h
})

## The rank-0 `i1` tile holding `value`.
pub fn bool_const(value: Bool) -> Tile[I1] !Dev = called("bool_const", () => {
  let h: Tile[I1] = t_consti("i1", [], if value { 1 } else { 0 })
  h
})

## The `n`-wide i32 tile `[0, 1, .., n-1]`.
pub fn arange(n: Int) -> Tile[I32] !Dev = called("arange", () => {
  let h: Tile[I32] = t_iota(n)
  h
})

## The i32 tile of `shape` holding the ELEMENT OFFSET each lane of a tile
## at `base` laid out by `strides` reads: `base + i * strides[0] + ..`. The
## same ladder a load at that base builds, memoised, so a masked load costs
## no instruction more than an unmasked one. `shape` and `strides` are the
## block's geometry, which no operand carries.
pub fn lanes_strided(base: Idx, shape: List[Int], strides: List[Int]) -> Tile[I32] !Dev = called("lanes_strided", () => {
  let i: Int = base
  let h: Tile[I32] = t_lanes(i, shape, strides)
  h
})

## `lanes_strided` over a contiguous tile, which is the run of element
## indices `[base, base + 1, .., base + prod(shape) - 1]` in row-major
## order.
pub fn lanes(base: Idx, shape: List[Int]) -> Tile[I32] !Dev = called("lanes", () => {
  lanes_strided(base, shape, row_major(shape))
})

## `a == b` over two tiles of one float format, as a mask of their shape.
## Ordered: a NaN operand answers 0 for every one of the six comparisons
## this heads, `ne` included.
pub fn eq[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("eq", () => compare("eq", a, b))

## `a != b`: one of the six ordered predicates `eq` heads, so a NaN operand
## answers 0 here too.
pub fn ne[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("ne", () => compare("ne", a, b))

## `a < b`: one of the six ordered predicates `eq` heads.
pub fn lt[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("lt", () => compare("lt", a, b))

## `a <= b`: one of the six ordered predicates `eq` heads.
pub fn le[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("le", () => compare("le", a, b))

## `a > b`: one of the six ordered predicates `eq` heads.
pub fn gt[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("gt", () => compare("gt", a, b))

## `a >= b`: one of the six ordered predicates `eq` heads.
pub fn ge[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("ge", () => compare("ge", a, b))

# The same six predicates UNORDERED (knife T4). `cmpf` carries a
# `comparison_ordering` beside its predicate: `ordered` answers false
# whenever either operand is a NaN, `unordered` answers true. The two
# agree on every pair of numbers, so these six are the six above on any
# corpus without a NaN in it, and something else entirely on one with.

## `a == b` or either operand a NaN.
pub fn eq_u[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("eq_u", () => compare("ueq", a, b))

## `a != b` or either operand a NaN.
pub fn ne_u[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("ne_u", () => compare("une", a, b))

## `a < b` or either operand a NaN.
pub fn lt_u[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("lt_u", () => compare("ult", a, b))

## `a <= b` or either operand a NaN.
pub fn le_u[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("le_u", () => compare("ule", a, b))

## `a > b` or either operand a NaN.
pub fn gt_u[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("gt_u", () => compare("ugt", a, b))

## `a >= b` or either operand a NaN.
pub fn ge_u[D](a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = called("ge_u", () => compare("uge", a, b))

## The same six over two i32 tiles, signed: `a == b` as a mask of their
## shape.
pub fn eq_i(a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = called("eq_i", () => compare_int("eq", a, b))

## `a != b` over two i32 tiles, signed: one of the six `eq_i` heads.
pub fn ne_i(a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = called("ne_i", () => compare_int("ne", a, b))

## `a < b` over two i32 tiles, signed: one of the six `eq_i` heads.
pub fn lt_i(a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = called("lt_i", () => compare_int("lt", a, b))

## `a <= b` over two i32 tiles, signed: one of the six `eq_i` heads.
pub fn le_i(a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = called("le_i", () => compare_int("le", a, b))

## `a > b` over two i32 tiles, signed: one of the six `eq_i` heads.
pub fn gt_i(a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = called("gt_i", () => compare_int("gt", a, b))

## `a >= b` over two i32 tiles, signed: one of the six `eq_i` heads.
pub fn ge_i(a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = called("ge_i", () => compare_int("ge", a, b))

# ---- integer arithmetic (knife 10) ----
#
# Every function below is EXACT on the device: an i32 result is one value,
# there is no rounding mode to carry and there is no fold order to be
# unspecified. That is the whole point of this family as a control group for
# the tolerance tiers of the float kernels (docs/tile-backend-design.md 6.5).
#
# Overflow is `none`, which is Tile IR for "the compiler assumes nothing":
# the device wraps modulo 2^32 and a host reference must wrap too
# (std/gpu's `wrap_i32`).

fn binary_int(op: String, a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev =
  binary_int_at(op, a, b)

fn unary_int(op: String, a: Tile[I32]) -> Tile[I32] !Dev = {
  let x: Int = a
  let h: Tile[I32] = t_unaryi(op, "i32", shape_of(x), x)
  h
}

fn binary_int_at[D](op: String, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Tile[D] = t_binaryi(op, dtype_of(x), wider([x, y]), x, y)
  h
}

## The element-wise sum `a + b`, wrapping modulo 2^32 under the default
## `overflow`; see `Overflow` for the other three.
pub fn add_i(a: Tile[I32], b: Tile[I32], overflow: Overflow = NoAssumption) -> Tile[I32] !Dev = called("add_i", () => {
  binary_int(int_op("addi", overflow), a, b)
})

## The element-wise difference `a - b`, wrapping. `overflow` as for `add_i`.
pub fn sub_i(a: Tile[I32], b: Tile[I32], overflow: Overflow = NoAssumption) -> Tile[I32] !Dev = called("sub_i", () => {
  binary_int(int_op("subi", overflow), a, b)
})

## The element-wise product `a * b`, wrapping: the LOW 32 bits of the
## 64-bit product. `mulhi_i` is the other half. `overflow` as for `add_i`.
pub fn mul_i(a: Tile[I32], b: Tile[I32], overflow: Overflow = NoAssumption) -> Tile[I32] !Dev = called("mul_i", () => {
  binary_int(int_op("muli", overflow), a, b)
})

## The element-wise signed quotient `a / b`, rounded toward zero (the
## dialect's default rounding for `divi`, and `to_int`'s). Division by zero
## is undefined on the device, as it is in CUDA.
pub fn div_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("div_i", () => binary_int("divi", a, b))

## The element-wise signed remainder `a % b`, whose sign follows the
## dividend (the remainder of a quotient rounded toward zero).
pub fn rem_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("rem_i", () => binary_int("remi", a, b))

## The element-wise signed larger of `a` and `b`.
pub fn max_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("max_i", () => binary_int("maxi", a, b))

## The element-wise signed smaller of `a` and `b`.
pub fn min_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("min_i", () => binary_int("mini", a, b))

## The HIGH 32 bits of the 64-bit product of `a` and `b`, read as UNSIGNED
## operands: the dialect defines `mulhii` for unsigned integers and gives it
## no signedness attribute (Ops.td, `MulhiIOp`). A hash that needs the whole
## product takes this beside `mul_i`.
pub fn mulhi_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("mulhi_i", () => binary_int("mulhii", a, b))

## The element-wise bitwise `a & b`.
pub fn and_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("and_i", () => binary_int("andi", a, b))

## The element-wise bitwise `a | b`.
pub fn or_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("or_i", () => binary_int("ori", a, b))

## The element-wise bitwise `a ^ b`.
pub fn xor_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("xor_i", () => binary_int("xori", a, b))

## The element-wise left shift `a << b`, wrapping: the bits shifted past the
## top are dropped. A shift count outside `[0, 32)` is undefined on the
## device.
pub fn shl_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("shl_i", () => binary_int("shli", a, b))

## The element-wise ARITHMETIC right shift `a >> b`: the sign bit is copied
## into the vacated positions, so a negative operand stays negative. This
## is `shri` with `signedness<signed>`.
pub fn shr_i(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("shr_i", () => binary_int("shri", a, b))

## The element-wise LOGICAL right shift `a >>> b`: zeros are shifted in, so
## a negative operand becomes a large positive one. This is the SAME opcode
## as `shr_i` with `signedness<unsigned>`, and the two differ on every
## negative operand and nowhere else -- which is what
## scripts/tile-gpu-diff's shri-always-logical mutant measures.
pub fn shr_u(a: Tile[I32], b: Tile[I32]) -> Tile[I32] !Dev = called("shr_u", () => binary_int("shru", a, b))

## The element-wise negation `-a`, wrapping (so `-(-2^31)` is `-2^31`).
pub fn neg_i(a: Tile[I32]) -> Tile[I32] !Dev = called("neg_i", () => unary_int("negi", a))

## The element-wise absolute value `|a|`, wrapping (so `|-2^31|` is
## `-2^31`).
pub fn abs_i(a: Tile[I32]) -> Tile[I32] !Dev = called("abs_i", () => unary_int("absi", a))

# The integer OVERFLOW attribute (knife T4, a parameter since knife K2).
# `overflow<none>` is the dialect's default and what every integer
# operation here carries unless told otherwise: the compiler assumes nothing
# and the device wraps.

## What an integer operation lets the compiler assume about overflow: the
## dialect's `overflow` attribute. `NoAssumption` is `none`, the default; the
## other three tell it to assume the operation does not wrap, as a signed
## operation (`no_signed_wrap`), as an unsigned one (`no_unsigned_wrap`) or
## as either (`no_wrap`). They are assumptions and not arithmetic: a program
## that wraps under one of them is undefined, so a caller uses them only
## where it can prove the range, and no corpus can distinguish them from
## `NoAssumption` on a program that keeps its promise.
##
## Written today: `add_i` with `NoSignedWrap`, `sub_i` with
## `NoUnsignedWrap`, `mul_i` with `NoWrap` (knife T4's three, one per
## value). Any other pairing is refused when the kernel is recorded; the
## dialect allows all of them, and teaching the writer and the renderer the
## rest is a change with a layer-1 answer to show.
pub type Overflow =
  | NoAssumption
  | NoSignedWrap
  | NoUnsignedWrap
  | NoWrap
derive Show

## The dialect's spelling of an overflow assumption, as `overflow<..>`
## writes it.
pub fn overflow_name(o: Overflow) -> String = match o {
  NoAssumption -> "none"
  NoSignedWrap -> "no_signed_wrap"
  NoUnsignedWrap -> "no_unsigned_wrap"
  NoWrap -> "no_wrap"
}

# The operation name of the integer arithmetic `base` under `overflow`:
# knife T4's suffixed names, which the handler, the renderer and the writer
# read. A pairing the handler does not know is refused by its
# `check_binary_int`.
fn int_op(base: String, overflow: Overflow) -> String = {
  let suffix = match overflow {
    NoAssumption -> ""
    NoSignedWrap -> "_nsw"
    NoUnsignedWrap -> "_nuw"
    NoWrap -> "_nw"
  }
  base ++ suffix
}

# ---- integer arithmetic at any width (knife T3) ----
#
# The family above is i32's and nothing else's: it predates every other
# integer width and a hundred kernels spell it that way. The five below
# work at the width of their operands, because a tile of `i16` or `i64` has
# no spelling in that family at all. There is ONE implementation -- `add_i`
# and `addi` over i32 go through `binary_int_at` and emit the same
# instruction and the same bytes -- so this is two spellings of one
# operation and not two operations.
#
# Wrapping is the format's, not i32's: `addi` over an i16 tile wraps modulo
# 2^16, which std/gpu's `wrap_i16` is the host reading of, and over an i64
# tile modulo 2^64, which nothing in the `List[Float]` channel can see (a
# corpus for i64 stays inside +/-2^52; std/gpu's `I64` says why).
#
# `cmpi` is NOT here. The effect's `t_cmpi` carries no format -- the
# lowering gives its operands `i32` types -- so a comparison at another
# width would need the operation's signature to change, which is a knife of
# its own and not this one's. Everything else an integer tile does is either
# here or in the i32 family.

## The element-wise sum `a + b` over two integer tiles of one format,
## wrapping.
pub fn addi[D](a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = called("addi", () => binary_int_at("addi", a, b))

## The element-wise difference `a - b`, wrapping.
pub fn subi[D](a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = called("subi", () => binary_int_at("subi", a, b))

## The element-wise product `a * b`, wrapping: the low bits of the exact
## product, as many as the format holds.
pub fn muli[D](a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = called("muli", () => binary_int_at("muli", a, b))

## The element-wise left shift `a << b`, wrapping. A shift count outside
## `[0, width)` is undefined on the device.
pub fn shli[D](a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = called("shli", () => binary_int_at("shli", a, b))

## The element-wise ARITHMETIC right shift `a >> b`: the sign bit is copied
## into the vacated positions.
pub fn shri[D](a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = called("shri", () => binary_int_at("shri", a, b))

## The rank-0 tile of the integer format `d` holding `value`, truncated to
## the format's width. `i_const` is the i32 spelling.
pub fn consti[D: Dtype](d: D, value: Int) -> Tile[D] !Dev = called("consti", () => {
  let h: Tile[D] = t_consti(dtype_name(d), [], value)
  h
})

# ---- conversions (knife 10) ----
#
# A conversion reads its SOURCE format and its shape off the tile, and takes
# the TARGET format as a marker: the target is the one thing no operand
# says. The tile comes first, so a conversion reads in a chain:
# `t.int_to_float(F64)`.

## The float tile of format `to_d` holding each lane of the signed integer
## tile `a`, rounded to nearest even. Exact for every i32 into an f64 tile
## (a binary64 significand covers the whole range) and not always exact
## into an f32 one, nor from an i64 tile.
pub fn int_to_float[A, B: Dtype](a: Tile[A], to_d: B) -> Tile[B] !Dev = called("int_to_float", () => {
  let x: Int = a
  let (from, s) = row_of(x)
  let h: Tile[B] = t_convert("itof", from, dtype_name(to_d), s, x)
  h
})

## The integer tile of format `to_d` holding each lane of the float tile
## `a`, TRUNCATED TOWARD ZERO.
##
## Without `saturating` (the default) a lane that is infinite, NaN or
## outside the target's range is undefined on the device (the dialect says
## so), so a kernel that uses this owes a bound on its input. With it,
## bytecode 13.4's `saturating` modifier (knife T17), every lane has an
## answer: a lane above the target's largest value is that value, one below
## its smallest is that one, an infinity is the end of its own sign and a
## NaN is 0 (Ops.td's FToIOp says all four in as many words); the rest
## truncate toward zero either way. `saturating` is legal on every `ftoi`
## the dialect allows (FToIOp has no per-format rule for it), so the
## recording handler checks it by the same rule as the plain conversion:
## the operation name `ftoi_sat` is on its list.
pub fn float_to_int[A, B: Dtype](a: Tile[A], to_d: B, saturating: Bool = false) -> Tile[B] !Dev = called("float_to_int", () => {
  let x: Int = a
  let (from, s) = row_of(x)
  let op = if saturating { "ftoi_sat" } else { "ftoi" }
  let h: Tile[B] = t_convert(op, from, dtype_name(to_d), s, x)
  h
})

## The i32 tile holding 1 where the mask is set and 0 where it is not: an
## `exti` from `i1`, ZERO-extending. Signedness is the whole of the claim
## here -- a signed widening of a one-bit 1 is -1, not 1 -- and it is why a
## count of the lanes a comparison selects is this and not a `select`.
pub fn mask_to_int(a: Tile[I1]) -> Tile[I32] !Dev = called("mask_to_int", () => convert_to("exti", "i32", a))

## The mask holding the LOW BIT of each lane of `a`: a `trunci` from `i32`
## to `i1`. The parity test, and the one direction back from an integer to
## a mask that costs no comparison.
pub fn int_to_mask(a: Tile[I32]) -> Tile[I1] !Dev = called("int_to_mask", () => convert_to("trunci", "i1", a))

## The f32 tile whose lanes hold the BITS of `a` unchanged: a `bitcast`,
## which moves no bits and reads them as another format of the same width.
## Not `int_to_float`, which preserves the value rather than the pattern.
pub fn bits_to_float(a: Tile[I32]) -> Tile[F32] !Dev = called("bits_to_float", () => convert_to("bitcast", "f32", a))

## The i32 tile whose lanes hold the bits of the f32 tile `a` unchanged: the
## inverse of `bits_to_float`, and its round trip is the identity on every
## bit pattern.
pub fn bits_to_int(a: Tile[F32]) -> Tile[I32] !Dev = called("bits_to_int", () => convert_to("bitcast", "i32", a))

# The conversion `op` of `a` into the format named `to`, at `a`'s shape and
# from `a`'s format.
fn convert_to[A, B](op: String, to: String, a: Tile[A]) -> Tile[B] !Dev = {
  let x: Int = a
  let (from, s) = row_of(x)
  let h: Tile[B] = t_convert(op, from, to, s, x)
  h
}

# ---- the width changes knife 11 needs ----

## The float tile of format `to_d` holding each lane of the float tile `a`,
## rounded by `rounding`: the dialect's `ftof`. Widening (f16 to f64) is
## exact and narrowing rounds.
##
## Which modes a pair of formats may take is the dialect's table (Ops.td's
## FToFOp at bytecode 13.4, knife T17; `prog.ftof_modes` is it), and the
## recording handler refuses a kernel that asks for another, with the pair
## and the modes it allows. On an exact widening every mode is allowed;
## otherwise `NearestAway` only from f32 to tf32, `Down` only from f64 to
## f32, `Up` from f64 to f32 and to `f8E8M0FNU`, and `TowardZero` to every
## format but the 8-bit and 4-bit floats other than `f8E8M0FNU`. The table
## is the dialect's to the letter, so it is checked here rather than left
## to `tileiras`.
##
## The default is the one exception to "the mode it names": into
## `f8E8M0FNU`, which has no `nearest_even`, the default conversion writes
## `zero`, the dialect's own default there, as it did before `rounding` was
## a parameter. `TowardZero` writes the same mode under its own name.
##
## The two formats must DIFFER (Ops.td's FToFOp says so and its verifier
## enforces it); `ftof` from a format to itself is refused by `tileiras`,
## not here.
pub fn float_to_float[A, B: Dtype](a: Tile[A], to_d: B, rounding: Rounding = NearestEven) -> Tile[B] !Dev = called("float_to_float", () => {
  convert_to("ftof" ++ rounding_suffix(rounding), dtype_name(to_d), a)
})

## `a` in the float format `fmt`, rounded to nearest even: `p.to(BF16)`
## (tileir 0.10.0). `float_to_float` with its default rounding, except
## that a tile already in `fmt` is answered as it is and records nothing,
## where `float_to_float` would ask `tileiras` for an `ftof` between equal
## formats, which it refuses. A kernel generic in its format can then write
## `p.to(D)` and get no instruction where `D` is the format `p` has.
## Another rounding is `float_to_float`'s third argument.
pub fn to[A, B: Dtype](a: Tile[A], fmt: B) -> Tile[B] !Dev = called("to", () => {
  let x: Int = a
  let (from, _shape) = row_of(x)
  if from == dtype_name(fmt) {
    let same: Tile[B] = x
    same
  } else {
    float_to_float(a, fmt)
  }
})

## The i32 tile holding each lane of the `i8` tile `a` widened UNSIGNED, so
## an octet reads as a value in [0, 255]. This is how a kernel over a
## `Tensor[U8]` gets at its pixels: the dialect has no `u8` tile type, and
## the signedness of the widening is where the format's reading lives
## (std/gpu's `U8` says the same thing from the host's side).
pub fn ext_u8(a: Tile[I8]) -> Tile[I32] !Dev = called("ext_u8", () => convert_to("exti", "i32", a))

## The `i8` tile holding the LOW OCTET of each lane of the i32 tile `a`: a
## `trunci`, which keeps the bits and drops the rest. What a kernel stores
## back into an 8-bit buffer, and the reason a value outside [0, 255] is the
## caller's problem rather than an error: the octet is what the buffer
## holds, and std/gpu's `wrap_u8` is the host reading of the same byte.
pub fn trunc_u8(a: Tile[I32]) -> Tile[I8] !Dev = called("trunc_u8", () => convert_to("trunci", "i8", a))

## The i32 tile holding each lane of the `i4` tile `a` widened with its
## SIGN, so a nibble reads as a value in [-8, 7]. The dialect has no
## arithmetic at four bits at all (Types.td leaves `i4` out of
## `CudaTile_IntTileType`), so this is how a kernel computes over one:
## widen, compute at 32 bits, `trunc_i4` back.
##
## `ext_u4` is the same widening the other way and answers [0, 15]. Which
## of the two a kernel takes is a device answer on every nibble whose top
## bit is set, and scripts/tile-gpu-diff's exti-i4-zero-extends is that
## sentence as a mutant.
pub fn ext_i4(a: Tile[I4]) -> Tile[I32] !Dev = called("ext_i4", () => convert_to("extis", "i32", a))

## The i32 tile holding each lane of the `i4` tile `a` widened with zeros,
## so a nibble reads as a value in [0, 15].
pub fn ext_u4(a: Tile[I4]) -> Tile[I32] !Dev = called("ext_u4", () => convert_to("exti", "i32", a))

## The `i4` tile holding the LOW NIBBLE of each lane of the i32 tile `a`: a
## `trunci`, which keeps the bits and drops the rest. The wrap at four bits,
## and std/gpu's `wrap_i4` is the host reading of the same nibble.
pub fn trunc_i4(a: Tile[I32]) -> Tile[I4] !Dev = called("trunc_i4", () => convert_to("trunci", "i4", a))

# ---- the byte view knife T9 needs ----

## The rank-1 `i8` tile holding the BYTES of the rank-1 tile `a`: the
## dialect's `pack`. No bit moves; the tile is reinterpreted as the byte
## array it occupies, so the answer has `lanes * bits / 8` lanes.
##
## Both tiles must be RANK 1 (PackOp's verifier says so, to leave no
## ambiguity about which lane is which byte) and `a`'s format may not itself
## be an 8-bit format (`bitcast` is that one). A sub-byte format packs two
## lanes to a byte, the EVEN lane in the low nibble; Types.td writes that
## order out and `std/gpu.i4_lo` is the host reading of it.
pub fn pack_bytes[A](a: Tile[A]) -> Tile[I8] !Dev = called("pack_bytes", () => {
  let x: Int = a
  let (from, s) = row_of(x)
  let h: Tile[I8] = t_repack("pack", from, "i8", s, x)
  h
})

## The rank-1 tile of format `to_d` the rank-1 `i8` tile `a` holds: the
## dialect's `unpack`, and `pack_bytes`'s inverse. The answer has
## `lanes * 8 / bits(to_d)` lanes, so unpacking a byte tile into a sub-byte
## format DOUBLES the lane count.
pub fn unpack_bytes[B: Dtype](a: Tile[I8], to_d: B) -> Tile[B] !Dev = called("unpack_bytes", () => {
  let x: Int = a
  let h: Tile[B] = t_repack("unpack", "i8", dtype_name(to_d), shape_of(x), x)
  h
})

## The mask of the lanes at `base` that fall inside a buffer of `limit`
## elements: `lanes(base, shape) < limit`. The boundary of a pointer-path
## kernel over a vector whose length is not a multiple of the tile width; a
## parameter's cells (`load_cell`, `store_cell`) carry their own and need
## none. `shape` is the block's geometry.
pub fn tail_mask(base: Idx, shape: List[Int], limit: Int) -> Tile[I1] !Dev = called("tail_mask", () => {
  lt_i(lanes(base, shape), i_const(limit))
})

## The element-wise choice: lane `i` of `a` where lane `i` of `cond` is 1,
## lane `i` of `b` where it is 0. A rank-0 condition or value is widened to
## the shape of the others.
pub fn select[D](cond: Tile[I1], a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = called("select", () => {
  let c: Int = cond
  let x: Int = a
  let y: Int = b
  let h: Tile[D] = t_select(format_of([x, y]), wider([x, y, c]), c, x, y)
  h
})

## The scalar index tile holding the host constant `value`: a loop bound, a
## step, a stride. The constant is fixed when the kernel is recorded, which
## is what a host `Int` in a kernel body means (tile-backend-design 5.2).
pub fn idx_const(value: Int) -> Idx !Dev = called("idx_const", () => {
  let h: Idx = t_idx_const(value)
  h
})

## The sum of two index tiles.
pub fn idx_add(a: Idx, b: Idx) -> Idx !Dev = called("idx_add", () => {
  let x: Int = a
  let y: Int = b
  let h: Idx = t_idx_add(x, y)
  h
})

## The product of two index tiles.
pub fn idx_mul(a: Idx, b: Idx) -> Idx !Dev = called("idx_mul", () => {
  let x: Int = a
  let y: Int = b
  let h: Idx = t_idx_mul(x, y)
  h
})

# ---- index arithmetic beyond the sum and the product (tileir 0.8.2) ----
#
# A grid has three axes, and a kernel over batches x heads x row blocks x
# groups folds two of them into one; reading them back out is a division
# and a remainder, which until 0.8.2 an `Idx` did not have. These are the
# i32 operations `div_i`, `rem_i` and `sub_i` already issue, on the rank-0
# i32 tile an `Idx` is (`idx_as_tile`): nothing new reaches the device. The
# division and the remainder are SIGNED and round toward zero, as Tile IR's
# `divi`/`remi` signed are; every index a grid or a cell count produces is
# non-negative, where that is the floor.

## The quotient `a / b` of two index tiles, rounded toward zero.
pub fn idx_div(a: Idx, b: Idx) -> Idx !Dev = called("idx_div", () => idx_of(binary_int("divi", idx_as_tile(a), idx_as_tile(b))))

## The remainder of `a / b`, of `a`'s sign.
pub fn idx_rem(a: Idx, b: Idx) -> Idx !Dev = called("idx_rem", () => idx_of(binary_int("remi", idx_as_tile(a), idx_as_tile(b))))

## The difference `a - b` of two index tiles.
pub fn idx_sub(a: Idx, b: Idx) -> Idx !Dev = called("idx_sub", () => idx_of(binary_int("subi", idx_as_tile(a), idx_as_tile(b))))

# ---- device variables and the regions that carry them (tileir 0.9.0) ----
#
# A loop or an `if` in a kernel is a REGION whose values flow out through
# block arguments and results, which in SSA is a tuple of handles. Until
# 0.9.0 the kernel spelt that tuple: `d_for3(.., m0, l0, acc0, (j, m, l, acc)
# => { ..; (m_new, l_new, acc_new) })` named every carried value three times
# and needed one function per arity, because Dawn has no variadic generics
# to take a tuple apart (docs/tile-backend-design.md 6.30).
#
# A `Carry[D]` is a device variable instead: `carry(init)` makes one,
# `c.get()` reads its current tile and `c.set(t)` replaces it. The regions
# take bodies that answer Unit (`d_loop`'s answers its stop mask), and find
# what they carry themselves, the way Triton's code generator does
# (`_find_carries`): the body runs once as a TRIAL, the recording notes
# which carries made before the region the trial `set`, and everything the
# trial recorded is then thrown away (`t_trial_begin` / `t_trial_end`
# restore the whole recording). The body then runs again for real, with
# those carries as the region's carried values in the order they were made;
# inside, `get` answers the block argument, and after the region the
# carries hold its results. A carry the body only reads is not carried; the
# body sees the tile it held outside, as a closure would.
#
# A body is recorded twice per region, so a region nested `n` deep runs its
# innermost body 2^n times while recording; MAX_LOOP_DEPTH (16) bounds `n`.
# The kernels in scripts/tile-golden nest two deep at most. Recording is
# deterministic (every kernel is already traced twice and the two records
# compared), so the trial and the real run issue the same operations.
#
# Which carries are carried is "was set", not "holds another handle": a
# body that sets a carry to what it already holds still carries it, which
# is what a loop that answers its argument unchanged always meant.

## A device variable of format `D`: a tile a kernel body replaces as it goes,
## which a region carries when its body replaces it. Made by `carry`, read
## by `get`, replaced by `set`; its format and shape are its first tile's
## for good.
pub opaque type Carry[D] = Int

## A device variable starting at `init`. `init` must have a format of its
## own (`f_const`, not `lit`) and a shape: a loop's accumulator starts from
## `zeros(p)` or a `broadcast`, as before.
pub fn carry[D](init: Tile[D]) -> Carry[D] !Dev = called("carry", () => {
  let h: Int = init
  let c: Carry[D] = t_carry_new(h)
  c
})

## The tile `c` holds where the body stands: inside a region that carries
## it, the region's block argument; after the region, its result.
pub fn get[D](c: Carry[D]) -> Tile[D] !Dev = called("get", () => {
  let k: Int = c
  let h: Tile[D] = t_carry_get(k)
  h
})

## Replace the tile `c` holds with `t`, of the same format and shape (the
## recording refuses any other). Not inside a reduction's or a scan's body,
## whose regions carry nothing.
pub fn set[D](c: Carry[D], t: Tile[D]) -> Unit !Dev = called("set", () => {
  let k: Int = c
  let h: Int = t
  t_carry_set(k, h)
})

# The carries `body` sets, in the order they were made, found by a trial:
# `region` opens and closes the region around the body with nothing
# carried, and the recording is restored afterwards.
fn trial(region: fn() -> Unit !Dev) -> List[Int] !Dev = {
  t_trial_begin()
  region()
  t_trial_end()
}

fn carry_gets(cs: List[Int]) -> List[Int] !Dev = list.map(cs, c => t_carry_get(c))

fn carry_sets(cs: List[Int], hs: List[Int]) -> Unit !Dev = {
  for k in range(0, len(cs)) {
    t_carry_set(cs[k], hs[k])
  }
}

# A `for` over the index range `[lower, upper)` by `step` carrying what
# `body` sets (`trial`). Private: `d_range` is the spelling.
fn loop_carrying(lower: Idx, upper: Idx, step: Idx, unsigned: Bool, body: fn(Idx) -> Unit !Dev) -> Unit !Dev = {
  let lo: Int = lower
  let up: Int = upper
  let st: Int = step
  let none: List[Int] = []
  let cs = trial(() => {
    let (iv, _inside) = t_loop_begin(lo, up, st, unsigned, none)
    let i: Idx = iv
    user_body(() => body(i))
    let _r = t_loop_end(none)
    ()
  })
  let (iv, inside) = t_loop_begin(lo, up, st, unsigned, carry_gets(cs))
  carry_sets(cs, inside)
  let i: Idx = iv
  user_body(() => body(i))
  carry_sets(cs, t_loop_end(carry_gets(cs)))
}

## How a loop steps: by one, or by a bound's own kind of value. `One` is a
## constructor and not a literal because a parameter default must be pure
## (spec, default values): the constant 1 of an `Idx` loop is an operation
## the kernel records, so it is made when the loop starts, not when the
## range is written. A literal step is `By(2)`; a device step is
## `By(nprog)` (a grid-stride loop, ruling-drange-step-20261006).
pub type Step[B] = One | By(by: B)

## What a loop's bounds may be: a host number, fixed when the kernel is
## recorded (`Int`), or a value the device computes (`Idx`). Both come to
## an `Idx` when the loop starts; an `Int` records an `idx_const` for it.
pub trait RangeBound[B] {
  fn range_idx(b: B) -> Idx !Dev
}

impl RangeBound[Int] {
  fn range_idx(b: Int) -> Idx !Dev = idx_const(b)
}

impl RangeBound[Idx] {
  fn range_idx(b: Idx) -> Idx !Dev = b
}

## The index range `[lower, upper)` by `step`, to loop over with `for`:
##
##     for j in d_range(0, K / TK) { acc = mma(load_at(a, [j]), load_at(b, [j]), acc) }
##
## The body runs once, on the host, with the induction variable (an `Idx`
## whichever kind the bounds are), and what it issues falls inside the
## loop's region. A `var` the body assigns is carried through the loop and
## holds what the last iteration assigned after it. A body may nest a
## `for`; the handler bounds the depth. The memory ordering token is carried
## by the handler, so a store after the loop is ordered after every store
## inside it. `break`, `continue` and `return` are not allowed in the body
## (staged-for-design); a data-dependent exit is `d_loop`.
##
## With `Int` bounds the range records `idx_const` for lower, upper and step,
## in that order; with `Idx` bounds it records only what the step needs.
##
## `unsigned_cmp` sets the loop's `unsignedCmp` unit attribute (knife T4):
## the induction variable is compared against the upper bound as an
## UNSIGNED 32-bit integer, so a range whose bounds straddle 2^31 runs
## forward instead of not running at all. Its own kernel is
## scripts/tile-golden's attr_ucmp.
pub fn d_range[B: RangeBound](lower: B, upper: B, step: Step[B] = One, unsigned_cmp: Bool = false) -> DRange[B] =
  DRange { lower: lower, upper: upper, step: step, unsigned: unsigned_cmp }

## What `d_range` answers: the range, not yet recorded.
pub type DRange[B] = { lower: B, upper: B, step: Step[B], unsigned: Bool }

impl[B: RangeBound] StagedIter[DRange[B]] {
  type Item = Idx
  effect StagedIter = !Dev
  fn staged_for(r: DRange[B], body: fn(Idx) -> Unit !Dev) -> Unit !Dev = called("d_range", () => {
    let lo = range_idx(r.lower)
    let up = range_idx(r.upper)
    let st = match r.step {
      One -> idx_const(1)
      By(s) -> range_idx(s)
    }
    loop_carrying(lo, up, st, r.unsigned, body)
  })
}

## A tile a `for` over a `d_range` carries, as `var`: `var acc = zeros(c)`
## and `acc = mma(.., acc)` in the body are `carry`, `get` and `set`.
impl[D] StagedVar[Tile[D]] {
  type Cell = Carry[D]
  effect StagedVar = !Dev
  fn var_open(v: Tile[D]) -> Carry[D] !Dev = carry(v)
  fn var_get(c: Carry[D]) -> Tile[D] !Dev = get(c)
  fn var_set(c: Carry[D], v: Tile[D]) -> Unit !Dev = set(c, v)
}

## The loop whose trip count the DATA decides: `body` runs on the host and
## answers a rank-0 mask, true when the loop is to stop here; the carries it
## sets are carried (`Carry`). When the mask is true the loop stops with the
## carries as they ENTERED that iteration, so the loop reads "while the
## mask is false, keep what the body set"; what `body` set on the iteration
## that stopped it is discarded. Compute the mask from what the iteration
## started with, before the `set`s, unless that is not what you mean.
##
## This is `d_range`'s sibling and the only other region that iterates. The
## difference is where the trip count comes from: `d_range`'s bounds are
## index handles the host or the grid supplies, and this one's exit is a
## value the kernel computes from the tiles it is carrying. A body that
## never answers a true mask never terminates on the device, exactly as a
## `while (true)` would; nothing here bounds it.
##
## Do not store inside one unless the store is meant to happen on the
## discarded iteration too: `body` runs to the end every time, including
## the last.
pub fn d_loop(body: fn() -> Tile[I1] !Dev) -> Unit !Dev = called("d_loop", () => {
  let none: List[Int] = []
  let cs = trial(() => {
    let _inside = t_while_begin(none)
    let done: Tile[I1] = user_body(body)
    let c: Int = done
    let _r = t_while_end(c, none)
    ()
  })
  let inside = t_while_begin(carry_gets(cs))
  carry_sets(cs, inside)
  let done: Tile[I1] = user_body(body)
  let c: Int = done
  carry_sets(cs, t_while_end(c, carry_gets(cs)))
})

## End the kernel for this tile block where `cond` is true, from wherever the
## call is: the top of the kernel, an `if`, or -- what bytecode 13.4 added
## (knife T17) -- the body of a `d_loop`, where it leaves the loop AND the
## kernel at once. Stores issued before it are kept; nothing recorded after
## it runs for a block whose `cond` was true, including the code after the
## loop. Where `cond` is false it does nothing and the body carries on.
##
## Not inside `d_range`, a reduction or a scan: the dialect forbids a `return`
## under a `for` (use the `loop` for an early exit, Ops.td says) and the
## other two are pure regions. The recording refuses all three.
pub fn d_return_if(cond: Tile[I1]) -> Unit !Dev = called("d_return_if", () => {
  let c: Int = cond
  t_return_if(c)
})

# The comparison of two index tiles, as a rank-0 mask.
fn idx_compare(pred: String, a: Idx, b: Idx) -> Tile[I1] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Tile[I1] = t_cmpi(pred, [], x, y)
  h
}

## `a == b` over two index tiles, as the rank-0 mask `d_if` branches on.
## Signed, as every integer comparison here is.
pub fn idx_eq(a: Idx, b: Idx) -> Tile[I1] !Dev = called("idx_eq", () => idx_compare("eq", a, b))

## `a != b` over two index tiles, signed, as a rank-0 mask: one of the six
## index predicates `idx_eq` heads.
pub fn idx_ne(a: Idx, b: Idx) -> Tile[I1] !Dev = called("idx_ne", () => idx_compare("ne", a, b))

## `a < b` over two index tiles, signed, as a rank-0 mask: one of the six
## index predicates `idx_eq` heads.
pub fn idx_lt(a: Idx, b: Idx) -> Tile[I1] !Dev = called("idx_lt", () => idx_compare("lt", a, b))

## `a <= b` over two index tiles, signed, as a rank-0 mask: one of the six
## index predicates `idx_eq` heads.
pub fn idx_le(a: Idx, b: Idx) -> Tile[I1] !Dev = called("idx_le", () => idx_compare("le", a, b))

## `a > b` over two index tiles, signed, as a rank-0 mask: one of the six
## index predicates `idx_eq` heads.
pub fn idx_gt(a: Idx, b: Idx) -> Tile[I1] !Dev = called("idx_gt", () => idx_compare("gt", a, b))

## `a >= b` over two index tiles, signed, as a rank-0 mask: one of the six
## index predicates `idx_eq` heads.
pub fn idx_ge(a: Idx, b: Idx) -> Tile[I1] !Dev = called("idx_ge", () => idx_compare("ge", a, b))

# ---- reductions and scans with a body ----
#
# `reduce_sum`, `reduce_max`, `reduce_min` and `scan_sum` below are the
# named ones and what a kernel reaches for first. These four take the body
# themselves, for a fold the names do not cover (an argmax, an affine
# composition). Each was two to four functions before the batch's PR-3 (a
# float and an integer identity, dimension 0 or any, a rank-0 or a wider
# answer), because `Scalar[D]` and `Tile[D]` were two types; they are one
# now, so the dimension is an argument with a default and the identity is a
# number the operand's format decides how to write.

# A reduction or a scan's identity, written in the operand's format: a
# float format takes the Float as it is, an integer one takes it as the
# whole number it must be.
fn identity_in(dtype: String, v: Float) -> RedId =
  if is_float_dtype(dtype) { IdF(dtype, v) } else { IdI(dtype, to_int(v)) }

# `dim` counted from the front: a negative one counts from the back.
fn axis_of(dim: Int, rank: Int) -> Int = if dim < 0 { rank + dim } else { dim }

## The reduction of the tile `t` along dimension `dim` (the last by
## default; `-k` is the `k`-th from the end), which answers `t` with that
## dimension DROPPED: a `[64, 32]` tile along dimension 1 answers a `[64]`
## one, and a `[1024]` tile answers a rank-0 one. `body` runs ONCE, on the
## host, with the accumulator and an element of the tile as the region sees
## them, IN THAT ORDER, both rank 0, and answers the new accumulator; what
## it issues in between is the region. `identity` is what a fold that has
## seen nothing starts from (0.0 for a sum, -inf for a max), written in
## `t`'s format (a whole number for an integer one), and must be the
## identity of `body` or the answer is wrong on the device and nowhere else.
##
## THE ORDER IS NOT SPECIFIED. Tile IR requires the function to be
## associative and commutative and says nothing about the tree, so a host
## reference that folds left is not an oracle for this in general
## (docs/tile-backend-design.md 6.5). A corpus on which every order is
## exact, or a tolerance, is. Integer addition modulo 2^32 is exactly
## associative and commutative, so an integer sum's answer does not depend
## on the order at all.
pub fn d_reduce[D](t: Tile[D], identity: Float, body: fn(Tile[D], Tile[D]) -> Tile[D] !Dev,
  dim: Int = -1) -> Tile[D] !Dev = called("d_reduce", () => {
    let h: Int = t
    let (dt, shape) = row_of(h)
    let args = t_reduce_begin(axis_of(dim, len(shape)), shape, [identity_in(dt, identity)], [h])
    let acc: Tile[D] = args[0]
    let e: Tile[D] = args[1]
    let rs: Tile[D] = user_body(() => body(acc, e))
    let r: Int = rs
    let outs = t_reduce_end([r])
    let out: Tile[D] = outs[0]
    out
  })

## `d_reduce` over TWO tiles at once, a tile of values and the i32 index
## tile beside it: the shape argmax and argmin have, where the winning value
## and the lane it came from must travel together through one fold. `body`
## takes the accumulator of each and then the element of each, and answers
## the new accumulator of each.
pub fn d_reduce2[A](values: Tile[A], idxs: Tile[I32], value_identity: Float, index_identity: Int,
  body: fn(Tile[A], Tile[I32], Tile[A], Tile[I32]) -> (Tile[A], Tile[I32]) !Dev,
  dim: Int = -1) -> (Tile[A], Tile[I32]) !Dev = called("d_reduce2", () => {
    let hv: Int = values
    let hi: Int = idxs
    let (dt, shape) = row_of(hv)
    let args = t_reduce_begin(axis_of(dim, len(shape)), shape,
      [identity_in(dt, value_identity), IdI("i32", index_identity)], [hv, hi])
    let av: Tile[A] = args[0]
    let ev: Tile[A] = args[1]
    let ai: Tile[I32] = args[2]
    let ei: Tile[I32] = args[3]
    let (rv, ri) = user_body(() => body(av, ai, ev, ei))
    let xv: Int = rv
    let xi: Int = ri
    let outs = t_reduce_end([xv, xi])
    let ov: Tile[A] = outs[0]
    let oi: Tile[I32] = outs[1]
    (ov, oi)
  })

## The inclusive prefix scan of the tile `t` along dimension `dim` (the last
## by default): an answer of the SAME shape whose position `j` is the fold
## of everything at or before `j` along that dimension. `body` runs ONCE, on
## the host, with the ACCUMULATOR (everything folded so far) and the ELEMENT
## arriving now, in that order, and answers the new accumulator; what it
## issues in between is the region. With `reverse` the prefix runs the
## other way: position `j` folds everything at or after it, and the
## accumulator is still the first argument.
##
## `identity` is what a fold that has seen nothing starts from, as a
## reduction's is. The device does not fold it in at the first position
## (measured, see `t_reduce_begin` above), so it must be a real identity of
## `body` or nothing at all depends on it.
##
## THE EVALUATION ORDER IS NOT SPECIFIED, the same way `d_reduce`'s is
## not: the dialect asks the function to be associative and says the order
## within each prefix is implementation-defined. Measured on sm_86, the
## device's float prefix sum is NOT the sequential left fold -- it differs
## in the last bits from lane 2 onwards -- so a host reference that folds
## left is not a bit oracle for a float scan, and a float scan kernel is
## tolerance tier (docs/tile-backend-design.md 6.6). What a scan does NOT
## need is COMMUTATIVITY: every element keeps its side of the accumulator,
## which is why a non-commutative body (an affine composition, "the last
## value that carried a flag") is legal here and is not under `reduce`.
pub fn d_scan[D](t: Tile[D], identity: Float, body: fn(Tile[D], Tile[D]) -> Tile[D] !Dev,
  dim: Int = -1, reverse: Bool = false) -> Tile[D] !Dev = called("d_scan", () => {
    let h: Int = t
    let (dt, shape) = row_of(h)
    let args = t_scan_begin(axis_of(dim, len(shape)), reverse, shape, [identity_in(dt, identity)], [h])
    let acc: Tile[D] = args[0]
    let e: Tile[D] = args[1]
    let rs: Tile[D] = user_body(() => body(acc, e))
    let r: Int = rs
    let outs = t_scan_end([r])
    let out: Tile[D] = outs[0]
    out
  })

## `d_scan` over TWO tiles at once, both of one format: the shape a
## first-order linear recurrence has, where a step's coefficient and its
## addend must travel through one fold together. `body` takes the
## accumulator of each and then the element of each, and answers the new
## accumulator of each.
##
## The dialect's own description says `scan` "is restricted to only
## support single tile input". Its verifier does not say so, `tileiras`
## assembles a two-operand scan, and the DEVICE answers one correctly:
## measured on sm_86 with the affine composition
## `(c, v) . (c', v') = (c * c', c' * v + v')`, which is
## `h[t] = a[t] * h[t-1] + x[t]` (docs/tile-backend-design.md 6.6). The
## sentence in the dialect's prose is the only thing that says otherwise
## and nothing enforces it, so this is recorded as a measurement and the
## kernels that need it name it.
pub fn d_scan2[D](a: Tile[D], b: Tile[D], a_identity: Float, b_identity: Float,
  body: fn(Tile[D], Tile[D], Tile[D], Tile[D]) -> (Tile[D], Tile[D]) !Dev,
  dim: Int = -1, reverse: Bool = false) -> (Tile[D], Tile[D]) !Dev = called("d_scan2", () => {
    let ha: Int = a
    let hb: Int = b
    let (dt, shape) = row_of(ha)
    let args = t_scan_begin(axis_of(dim, len(shape)), reverse, shape,
      [identity_in(dt, a_identity), identity_in(dt, b_identity)], [ha, hb])
    let aa: Tile[D] = args[0]
    let ea: Tile[D] = args[1]
    let ab: Tile[D] = args[2]
    let eb: Tile[D] = args[3]
    let (ra, rb) = user_body(() => body(aa, ab, ea, eb))
    let xa: Int = ra
    let xb: Int = rb
    let outs = t_scan_end([xa, xb])
    let oa: Tile[D] = outs[0]
    let ob: Tile[D] = outs[1]
    (oa, ob)
  })

## The `if` over the rank-0 mask `cond`: `on_true` and `on_false` each run
## on the host, and what each issues is one of the operation's two regions.
## A carry either branch sets is a result of the `if` (`Carry`): each branch
## starts from the tile the carry held before the `if`, a branch that does
## not set it answers that tile, and after the `if` the carry holds the
## branch's answer the mask chose. Both must keep the carry's format and
## shape. A wider `cond` is refused when the kernel records.
##
## Both regions are always written, as the dialect's reader requires (an
## `if` with one region is refused, measured). Neither may load or store.
pub fn d_if(cond: Tile[I1], on_true: fn() -> Unit !Dev, on_false: fn() -> Unit !Dev) -> Unit !Dev = called("d_if", () => {
  let c: Int = cond
  let none: List[Int] = []
  # one trial per branch: each starts from what the carries held outside
  let on_t = trial(() => {
    t_if_begin(c)
    user_body(on_true)
    t_if_else(none)
    let _r = t_if_end(none)
    ()
  })
  let on_f = trial(() => {
    t_if_begin(c)
    t_if_else(none)
    user_body(on_false)
    let _r = t_if_end(none)
    ()
  })
  let cs = list.filter(range(0, 1 + list.fold(on_t ++ on_f, 0 - 1, (m, k) => if k > m { k } else { m })),
    k => list.contains(on_t, k) || list.contains(on_f, k))
  let before = carry_gets(cs)
  t_if_begin(c)
  user_body(on_true)
  let yields = carry_gets(cs)
  carry_sets(cs, before)
  t_if_else(yields)
  user_body(on_false)
  carry_sets(cs, t_if_end(carry_gets(cs)))
})

# ---- shapes, the grid's extent, token joins and pointers (knife T2) ----

# An index handle as the effect carries it. `Idx` is transparent here, but
# a `list.map` over `List[Idx]` wants a function and this is it.
fn idx_handle(i: Idx) -> Int = {
  let h: Int = i
  h
}

## The subtile of `t` of shape `to` whose slice number along dimension `k`
## is `indices[k]`. `to` must divide `t`'s shape evenly in every dimension,
## and there are `shape[k] / to[k]` slices along dimension `k`; the indices
## are SLICE numbers and not element offsets, which is the dialect's own
## wording and the one thing about `extract` that is easy to read
## backwards. An index outside its range is undefined behaviour, not an
## error. `to` is the one shape this takes: no operand carries it.
pub fn extract[D](t: Tile[D], to: List[Int], indices: List[Idx]) -> Tile[D] !Dev = called("extract", () => {
  let x: Int = t
  let (dt, from) = row_of(x)
  let r: Tile[D] = t_extract(dt, from, to, x, list.map(indices, idx_handle))
  r
})

## `t` with its subtile whose slice number along dimension `k` is
## `indices[k]` replaced by `s`: Tile IR's `insert` (knife T16, bytecode
## 13.4), `extract`'s other direction. `s`'s shape must divide `t`'s
## evenly in every dimension and the indices are SLICE numbers, exactly as
## `extract`'s are, so `extract(insert(s, t, i), shape(s), i)` is `s` and
## `insert(extract(t, shape(s), i), t, i)` is `t`. Every lane outside the
## named subtile is `t`'s own. An index outside its range is undefined
## behaviour, not an error.
pub fn insert[D](s: Tile[D], t: Tile[D], indices: List[Idx]) -> Tile[D] !Dev = called("insert", () => {
  let x: Int = s
  let y: Int = t
  let (dt, sub) = row_of(x)
  let r: Tile[D] = t_insert(dt, sub, shape_of(y), x, y, list.map(indices, idx_handle))
  r
})

## `a` and `b` joined along dimension `dim`: the two agree in every other
## dimension, and the answer's `dim` is the sum of theirs.
pub fn cat[D](a: Tile[D], b: Tile[D], dim: Int) -> Tile[D] !Dev = called("cat", () => {
  let x: Int = a
  let y: Int = b
  let (dt, lhs) = row_of(x)
  let r: Tile[D] = t_cat(dt, dim, lhs, shape_of(y), x, y)
  r
})

## `t` with its dimensions reordered: dimension `k` of the answer is
## dimension `perm[k]` of `t`, so `permute_tile(t, [1, 0, 2])` exchanges
## the first two axes of a rank-3 tile. `perm` is a permutation of
## `0 .. rank - 1` and `t` has rank two or more.
##
## NOT `permute` above, which takes strides and answers strides: that one is
## a LAYOUT for a load to read an array through, and no instruction comes of
## it. This one is the dialect's own `permute` (opcode 0x53) and moves the
## elements of a tile that is already in registers. Before knife T2 the
## layout was the only thing here that could be called a transpose, and the
## comment on `permute` said the opcode had no client; it has one now, and
## the two remain different operations at different times.
pub fn permute_tile[D](t: Tile[D], perm: List[Int]) -> Tile[D] !Dev = called("permute_tile", () => {
  let x: Int = t
  let (dt, shape) = row_of(x)
  let r: Tile[D] = t_permute(dt, shape, perm, x)
  r
})

## The rank-2 `t` with its two dimensions exchanged: `permute_tile(t,
## [1, 0])`, the same instruction (tileir 0.10.0). A tile of another rank
## is refused when the kernel records, by the check every permutation
## passes ("a permutation of a 3-dimensional tile has that many entries");
## `permute_tile` with the whole permutation is what a higher rank writes.
pub fn transpose[D](t: Tile[D]) -> Tile[D] !Dev = called("transpose", () => {
  let x: Int = t
  let (dt, shape) = row_of(x)
  let r: Tile[D] = t_permute(dt, shape, [1, 0], x)
  r
})

## The number of tile blocks along `axis` (0, 1 or 2): the extent of the
## grid this kernel was launched on, which is `block_id`'s companion. A grid
## smaller than the work is covered by stepping through it, and this is the
## step.
pub fn num_blocks(axis: Int) -> Idx !Dev = called("num_blocks", () => {
  let h: Idx = t_num_blocks(axis)
  h
})

## How many elements `p`'s tensor has along dimension `dim`, as an index:
## the number its cells declare, or for a `DYN_DIM` dimension the grid's
## blocks along the axis it follows times its tile, which is what such an
## extent is (`prog.cells`). `p` must have cells (an `In` or an `Out` of
## `trace1` to `trace5`; a dynamic dimension that follows no grid axis is
## refused by the markers already) (tileir 0.9.0).
pub fn extent_of[D](p: Param[D], dim: Int) -> Idx !Dev = called("extent_of", () => {
  let h: Idx = t_extent_of(position(p), dim, false)
  h
})

## How many cells `p` is cut into along dimension `dim`: the extent over
## the tile, rounded up, or for a `DYN_DIM` dimension the grid's blocks
## along the axis it follows. The upper bound of a loop over a dimension of
## an `In` that follows no grid axis: `d_range(idx_const(0), blocks_of(k, 0),
## idx_const(1)) { j => .. load_at(k, [j]) .. }` (tileir 0.9.0).
pub fn blocks_of[D](p: Param[D], dim: Int) -> Idx !Dev = called("blocks_of", () => {
  let h: Idx = t_extent_of(position(p), dim, true)
  h
})

## `a` and `b` issued as two INDEPENDENT chains of memory operations, joined
## afterwards: both start from the ordering token as it stands here, and
## everything after this call is ordered after both. Neither is ordered
## against the other, so the two must not touch the same element, and the
## recording refuses two chains it cannot show to be disjoint.
##
## This is the only client of `t_tok_get` / `t_tok_set` / `t_tok_join`, and
## the only thing in this package that makes the token graph a graph. A
## body that just issues its stores in order gets the line it already had.
pub fn d_fork2(a: fn() -> Unit !Dev, b: fn() -> Unit !Dev) -> Unit !Dev = called("d_fork2", () => {
  let start = t_tok_get()
  user_body(a)
  let after_a = t_tok_get()
  t_tok_set(start)
  user_body(b)
  let after_b = t_tok_get()
  let _joined = t_tok_join([after_a, after_b])
  ()
})

## The tile of `shape` every lane of which holds `p`'s own address: the
## reshape and broadcast every address ladder opens with, as a value a body
## can name. `ptr_offset` is what moves it. `shape` is the geometry of the
## pointer tile, which nothing else carries.
pub fn ptrs[D](p: Param[D], shape: List[Int]) -> Ptrs[D] !Dev = called("ptrs", () => {
  let r: Ptrs[D] = t_ptrs(position(p), param_dtype(p), shape)
  r
})

## `ps` advanced by `offs`, in ELEMENTS of the pointee format: lane `i` of
## the answer is lane `i` of `ps` plus `offs[i]` elements. The same
## `offset` instruction a strided load builds, with the body's own tile
## where its ladder would be.
pub fn ptr_offset[D](ps: Ptrs[D], offs: Tile[I32]) -> Ptrs[D] !Dev = called("ptr_offset", () => {
  let x: Int = ps
  let o: Int = offs
  let r: Ptrs[D] = t_ptr_offset(pointee(x), shape_of(x), x, o)
  r
})

## `ps` as a tile of i64 addresses. The values are to be read UNSIGNED; the
## inverse is `int_to_ptr`.
pub fn ptr_to_int[D](ps: Ptrs[D]) -> Tile[I64] !Dev = called("ptr_to_int", () => {
  let x: Int = ps
  let r: Tile[I64] = t_ptr_to_int(pointee(x), shape_of(x), x)
  r
})

## A tile of i64 addresses as pointers to `d`. The inverse of `ptr_to_int`,
## and the point of the pair is that an address can be COMPUTED: a kernel
## that wants a byte offset no `offset` can express takes the address apart
## here and puts it back. A write through what this answers cannot be
## followed back to a parameter, so it is refused in a kernel with an In or
## an Out parameter (`Shared` and `trace_kernel` ones take it).
pub fn int_to_ptr[D: Dtype](v: Tile[I64], d: D) -> Ptrs[D] !Dev = called("int_to_ptr", () => {
  let x: Int = v
  let r: Ptrs[D] = t_int_to_ptr(dtype_name(d), shape_of(x), x)
  r
})

## `ps` reinterpreted as pointers to `to_d`: the same addresses, another
## element format. Nothing is converted and nothing is read; what changes is
## what a later `ptr_offset` counts in and what a later `load_ptrs` reads.
## The dialect keeps this apart from `int_to_ptr` and `ptr_to_int` so that a
## compiler can still follow pointer provenance across it.
pub fn ptr_to_ptr[A, B: Dtype](ps: Ptrs[A], to_d: B) -> Ptrs[B] !Dev = called("ptr_to_ptr", () => {
  let x: Int = ps
  let r: Ptrs[B] = t_ptr_to_ptr(pointee(x), dtype_name(to_d), shape_of(x), x)
  r
})

## Declare a statically allocated global named `sym` holding `values`, one
## element of `d` each. The allocation lives as long as the loaded module
## does and is initialized at module load time, so what one launch writes
## the next launch of the same module reads;
## `scripts/tile-gpu-diff/global_diff.dawn` is the measurement of that
## sentence.
##
## This is a MODULE-LEVEL declaration and not an instruction: it answers
## nothing, and issuing it inside a `d_range`, a `d_loop`, a `d_if` or a
## reduction is refused. Declare each global once, before the
## `get_global` that names it.
##
## The three remaining parameters are the three fields of the Global
## section's record past the values, at the dialect's own defaults (public,
## writable, alignment 0), and any combination of them may be given:
##
## - `align`: the alignment in bytes. The record has carried the number
##   since 13.1, so this is the one field a corpus can give two different
##   values in one module.
## - `visibility`: `Private` says the symbol is not part of the module's
##   interface, so a host that has the module cannot look it up. That
##   sentence is the dialect's and not this machine's, and knife TG measured
##   the difference. What the value DOES reach is the cubin: `tileiras`
##   gives a private global a LOCAL ELF binding and a public one a GLOBAL
##   binding, which scripts/tile-golden holds on `global_syms`. What it does
##   not reach is any answer: the CUDA driver's `cuModuleGetGlobal`
##   (std/gpu's `module_global`) answers a LOCAL global as readily as a
##   GLOBAL one, the host reads and writes both, and the next launch reads
##   the write (scripts/tile-gpu-diff/sym_diff.dawn). So this buys the byte,
##   layer 1 and a binding, and scripts/tileir-features/attrs.txt carries
##   the exemption `visibility-not-in-the-lookup` on the row.
## - `constant`: the global is read-only, which is a promise to the compiler
##   and not a guard. The dialect does not say a store through a pointer got
##   from a constant global is diagnosed, so this tree does not store
##   through one. The flag reaches one byte of the bytecode and nothing
##   further: with the writer's flag forced to 0 the sm_86 cubin `tileiras`
##   writes is byte for byte the same one (measured, knife TG;
##   scripts/tile-golden's `constant-flag-as-mutable` is the gate). The
##   exemption on the row is `constant-not-in-the-cubin`.
pub fn d_global[D: Dtype](sym: String, d: D, values: List[Float],
  align: Int = 0, visibility: Visibility = Public, constant: Bool = false) -> Unit !Dev = called("d_global", () => {
    t_global(sym, dtype_name(d), values, align, visibility_is_private(visibility), constant)
  })

## A global's symbol visibility: the dialect's `symbol_visibility`, a field
## the Global section's record grew at 13.3. `Public` is the default.
pub type Visibility =
  | Public
  | Private
derive Show

## The dialect's spelling of a symbol visibility.
pub fn visibility_name(v: Visibility) -> String = match v {
  Public -> "public"
  Private -> "private"
}

fn visibility_is_private(v: Visibility) -> Bool = match v {
  Public -> false
  Private -> true
}

## The tile of `shape` every lane of which holds the address of the global
## named `sym`: `get_global` answers a rank-0 `tile<ptr<D>>`, and this is
## the same reshape and broadcast `ptrs` performs on a parameter. The
## element at position `x` of the global is `ptr_offset`'s `x` from here,
## which is what the dialect means by "the initial values are stored in
## memory in linear order".
pub fn global_ptrs[D: Dtype](sym: String, d: D, shape: List[Int]) -> Ptrs[D] !Dev = called("global_ptrs", () => {
  let r: Ptrs[D] = t_get_global(sym, dtype_name(d), shape)
  r
})

## The tile of `shape` every lane of which holds the address of a fresh
## automatic allocation of `num_elem` elements of `d`, aligned to `align`
## bytes (knife T10). `alloca` answers a rank-0 `tile<ptr<D>>`, so this is
## the same reshape and broadcast `global_ptrs` performs, and `ptr_offset`
## walks the elements from here.
##
## The allocation is SCRATCH: the dialect limits its lifetime to the block
## the operation is in, so what one launch writes is not there for the
## next, and each `alloca` in a block answers a region of its own. By
## default the address is private to this tile thread; `shared` sets the
## dialect's `global` unit attribute, and then the address may be read and
## written by other tile threads as well as this one. The lifetime is the
## same and so is everything else; what changes is one bit of the
## operation's flags word.
##
## `align` must be a non-zero power of two and at least the natural size of
## `d`, which the dialect's verifier requires and the recording handler
## refuses ahead of it.
pub fn alloca_ptrs[D: Dtype](d: D, num_elem: Int, align: Int, shape: List[Int],
  shared: Bool = false) -> Ptrs[D] !Dev = called("alloca_ptrs", () => {
    let r: Ptrs[D] = t_alloca(dtype_name(d), num_elem, align, shared, shape)
    r
  })

## The `tensor_view` over `p`'s buffer starting `base` ELEMENTS in, with
## `shape` elements along each dimension and `strides` elements between two
## neighbours along it (knife T11), in `p`'s format. This is the whole of
## the addressing: a view says where a tensor is and how it is laid out, and
## nothing about the tiles it will be read in. A kernel whose parameter's
## cells describe the tile it reads wants `load_cell`, which builds the view
## itself; this is the escape hatch for every other view.
##
## `base` is the same rank-0 index a strided `load` takes, and it becomes
## an `offset` on the parameter's own pointer, so a view may start anywhere
## in the buffer. Every stride is STRICTLY POSITIVE, which is where the two
## addressing schemes part: a strided `load` reads a broadcast with a
## stride of zero and `make_tensor_view` refuses one
## (docs/tile-backend-design.md 6.14).
pub fn tensor_view[D](p: Param[D], base: Idx, shape: List[Int], strides: List[Int]) -> TensorView[D] !Dev = called("tensor_view", () => {
  let b: Int = base
  let none: List[Int] = []
  let r: TensorView[D] = t_tensor_view(position(p), param_dtype(p), b, shape, strides, none, none)
  r
})

## `tensor_view` with dimensions the kernel computes (knife T12). A `Fixed`
## entry is an extent (or a stride) the TYPE states; a `Dyn` entry prints
## `?` there and hands `make_tensor_view` the value as an operand, so one
## cubin serves every tensor of that rank rather than one shape.
##
## Everything else is `tensor_view`'s: the base is an element offset on the
## parameter's own pointer, and a dynamic extent or stride is held to the
## same rule a static one is (strictly positive), except that the device
## rather than the recorder is what holds it.
pub fn tensor_view_dyn[D](p: Param[D], base: Idx, shape: List[Dim], strides: List[Dim]) -> TensorView[D] !Dev = called("tensor_view_dyn", () => {
  let b: Int = base
  let r: TensorView[D] = t_tensor_view(position(p), param_dtype(p), b,
    list.map(shape, dim_extent), list.map(strides, dim_extent),
    dim_operands(shape), dim_operands(strides))
  r
})

## A rank-0 `Tile[I32]` as an index. `Idx` and a rank-0 `Tile[I32]` are ONE
## lowered type (`tile<i32>`) with two surface names, and this and
## `idx_as_tile` are the only places a kernel crosses between them.
##
## It is here for knife T12: a dynamic extent has to come from somewhere,
## and the general somewhere is a buffer. The rank is not checkable here (a
## handle carries no shape at this layer), so the recording holds it
## instead: an index of rank one or more is refused where it is used (a
## loop bound, a cell index), and every dynamic operand of a
## `make_tensor_view` must be a rank-0 i32 tile and is refused by name in
## the lowering if it is not.
pub fn idx_of(t: Tile[I32]) -> Idx = {
  let h: Int = t
  let r: Idx = h
  r
}

## `idx_of` the other way: an index as the rank-0 i32 tile every
## element-wise operation takes, so a shape the device answered can be
## written out, or compared against a tile (the rank-0 rule widens it).
## Until the batch's PR-3 this was `idx_as_scalar`.
pub fn idx_as_tile(i: Idx) -> Tile[I32] = {
  let h: Int = i
  let r: Tile[I32] = h
  r
}

## `tv` cut into a grid of `tile_shape` tiles, in `tv`'s format.
## `dim_map[k]` says which dimension of the tensor view tile dimension `k`
## runs along, so the identity map is the plain partition and a
## permutation of it transposes the tile; `padding` says what an
## out-of-bounds lane of a `load_view` reads.
##
## The INDEX SPACE of the answer has one dimension per tile dimension, and
## its extent along `k` is the tensor view's extent along `dim_map[k]`
## divided by `tile_shape[k]`, rounded up: a tile may run past the end of
## the tensor and a tile index may not. `view_grid` computes it.
pub fn partition_view[D](tv: TensorView[D], tile_shape: List[Int], dim_map: List[Int],
  padding: Padding) -> GridView[D] !Dev = called("partition_view", () => {
    let v: Int = tv
    let r: GridView[D] = t_partition_view(dtype_of(v), v, tile_shape, dim_map, padding)
    r
  })

## `tv` cut into a grid of `tile_shape` tiles that ADVANCES by `traversal`
## (knife T13): index `k` of the grid covers `traversal[k]` elements along
## the tensor dimension `dim_map[k]` and reads `tile_shape[k]` of them, so
## the tiles overlap when the traversal is the shorter and skip when it is
## the longer. `traversal == tile_shape` is `partition_view` written the
## long way, and the dialect's own documentation says so.
##
## Every traversal stride is STRICTLY POSITIVE and the tile dimensions are
## powers of two, which is `StridedViewType::verify` and is what the
## recording handler holds. The index space along `k` is
## `ceil(shape[dim_map[k]] / traversal[k])`: `strided_grid` computes it, and
## partial tiles at the far end are IN it (the dialect includes them).
pub fn strided_view[D](tv: TensorView[D], tile_shape: List[Int], traversal: List[Int],
  dim_map: List[Int], padding: Padding) -> GridView[D] !Dev = called("strided_view", () => {
    let v: Int = tv
    let r: GridView[D] = t_strided_view(dtype_of(v), v, tile_shape, traversal, dim_map, padding)
    r
  })

## `tv` read a row at a time along `sparse_dim` (knife T13). The index at
## that dimension is a 1D tile of row numbers rather than a tile index, so
## one load collects `tile_shape[sparse_dim]` rows chosen while the kernel
## runs and stacks them into the tile; every other dimension is a grid view's
## tile index.
##
## There is no `dim_map`: what the dialect holds against the tensor view
## instead is that `sparse_dim` is one of its dimensions.
pub fn gather_scatter_view[D](tv: TensorView[D], tile_shape: List[Int], sparse_dim: Int,
  padding: Padding) -> GatherScatterView[D] !Dev = called("gather_scatter_view", () => {
    let v: Int = tv
    let r: GatherScatterView[D] = t_gather_view(dtype_of(v), v, tile_shape, sparse_dim, padding)
    r
  })

## The tile of `v`'s grid at `indices`, one index a tile dimension. In the
## token chain where every other load is; lanes that fall outside the
## underlying tensor read the view's padding value.
pub fn load_view[D](v: GridView[D], indices: List[Idx]) -> Tile[D] !Dev = called("load_view", () => {
  let x: Int = v
  let r: Tile[D] = t_load_view(dtype_of(x), x, list.map(indices, idx_handle))
  r
})

## `t` written into the tile of `v`'s grid at `indices`. In the token chain
## where every other store is; lanes that fall outside the underlying
## tensor are MASKED, which is the store's half of the same rule the
## padding value is the load's half of. A view of an Out parameter is not
## one of its cells, so the recording refuses this into one (`store_cell`
## and `store_sub` are an Out's writes); a `Shared` parameter takes it.
pub fn store_view[D](v: GridView[D], indices: List[Idx], t: Tile[D]) -> Unit !Dev = called("store_view", () => {
  let x: Int = v
  let y: Int = t
  t_store_view(dtype_of(x), x, list.map(indices, idx_handle), y)
})

## The handle behind one `GatherIdx`, whichever kind it is. Both are `Int`
## under the opaque types, and which one is legal WHERE is the view's own
## rule, held in the lowering against the type.
fn gather_handle(g: GatherIdx) -> Int = match g {
  At(i) -> {
    let h: Int = i
    h
  }
  Rows(t) -> {
    let h: Int = t
    h
  }
}

## The tile `v` gathers at `indices`: the rows named by the `Rows` entry at
## `sparse_dim`, each cut to the tile at the `At` indices of the other
## dimensions. In the token chain where every other load is.
pub fn load_gather[D](v: GatherScatterView[D], indices: List[GatherIdx]) -> Tile[D] !Dev = called("load_gather", () => {
  let x: Int = v
  let r: Tile[D] = t_load_view(dtype_of(x), x, list.map(indices, gather_handle))
  r
})

## `t` scattered back the way `load_gather` collects: row `k` of the tile
## goes to the row the `Rows` entry names at `k`. In the token chain where
## every other store is.
pub fn store_gather[D](v: GatherScatterView[D], indices: List[GatherIdx], t: Tile[D]) -> Unit !Dev = called("store_gather", () => {
  let x: Int = v
  let y: Int = t
  t_store_view(dtype_of(x), x, list.map(indices, gather_handle), y)
})

## `t` reduced into the tile of `v`'s grid at `indices`, one element at a
## time and ATOMICALLY: `atomic_red_view_tko` (knife T13). Unlike
## `atomic_rmw`, it answers nothing at all, so two tile blocks may reduce
## into one tile of the grid and the result does not depend on the order
## they arrive in.
##
## `mode` is one of the nine the operation takes (`and`, `or`, `xor`, `add`,
## `addf`, `max`, `min`, `umax`, `umin`; `xchg` is refused because a
## reduction that returns nothing cannot exchange). `scope` is `tl_blk` or
## `device`; the ordering is always `relaxed`, which is the only one the
## dialect allows here. A view carrying a `padding_value` is refused.
pub fn atomic_red_view[D](v: GridView[D], indices: List[Idx], mode: String, scope: String,
  t: Tile[D]) -> Unit !Dev = called("atomic_red_view", () => {
    let x: Int = v
    let y: Int = t
    t_atomic_red_view(dtype_of(x), x, list.map(indices, idx_handle), mode, scope, y)
  })

## The extent of `tv`'s tensor along dimension `dim`, asked of the DEVICE:
## `get_tensor_shape` (knife T12). The dialect's operation answers every
## dimension at once, the way `get_tile_block_id` answers every axis, and
## this names one of them; the lowering issues the whole operation and binds
## this handle to the `dim`-th result.
##
## For a static dimension the answer is the number already in the type, and
## for a `?` one it is the operand `make_tensor_view` was handed. That is
## what makes it worth asking: a kernel over a dynamic tensor has no other
## way to know where the tensor ends.
pub fn tensor_dim[D](tv: TensorView[D], dim: Int) -> Idx !Dev = called("tensor_dim", () => {
  let v: Int = tv
  let h: Idx = t_tensor_shape(v, dim)
  h
})

## The extent of `v`'s INDEX SPACE along tile dimension `dim`, asked of the
## device: `get_index_space_shape` (knife T12). The index space is the grid
## of tiles the partition view cuts its tensor into, so this is
## `ceil(shape[dim_map[dim]] / tile_shape[dim])` computed where the tensor's
## extent is known, which for a dynamic tensor is only on the device.
## `view_grid` is the same number computed on the host from a static shape.
pub fn index_space_dim[D](v: GridView[D], dim: Int) -> Idx !Dev = called("index_space_dim", () => {
  let x: Int = v
  let h: Idx = t_index_space_shape(x, dim)
  h
})

## The extent of a partition view's index space, as the grid a kernel over
## it is launched on: `ceil(shape[dim_map[k]] / tile_shape[k])` along tile
## dimension `k`. The host needs the same number, so this is the one place
## it is computed.
pub fn view_grid(shape: List[Int], tile_shape: List[Int], dim_map: List[Int]) -> List[Int] =
  list.map(range(0, len(tile_shape)), k =>
      (shape[dim_map[k]] + tile_shape[k] - 1) / tile_shape[k])

## The same for a STRIDED view, where the grid steps by the traversal and
## not by the tile: `ceil(shape[dim_map[k]] / traversal[k])`. Partial tiles
## at the far end of the tensor are in the index space, which is why this
## rounds up exactly as `view_grid` does.
pub fn strided_grid(shape: List[Int], traversal: List[Int], dim_map: List[Int]) -> List[Int] =
  list.map(range(0, len(traversal)), k =>
      (shape[dim_map[k]] + traversal[k] - 1) / traversal[k])

## The tile the pointers in `ps` point at, unmasked, shaped like `ps`. In
## the token chain where `load` is, and ordered against every other memory
## operation the same way.
pub fn load_ptrs[D](ps: Ptrs[D]) -> Tile[D] !Dev = called("load_ptrs", () => {
  let x: Int = ps
  let none: Option[Int] = None
  let r: Tile[D] = t_load_ptrs(pointee(x), shape_of(x), x, none, none)
  r
})

## Write `v` through the pointers in `ps`, unmasked: `load_ptrs`'s other
## direction, and the same `store_ptr_tko` a `store` through a parameter
## emits. In the token chain where `store` is. A write through pointers
## into an Out is refused (an Out's writes are its cells'), as is one the
## recording cannot follow to a parameter while any parameter is an In or
## an Out.
pub fn store_ptrs[D](ps: Ptrs[D], v: Tile[D]) -> Unit !Dev = called("store_ptrs", () => {
  let x: Int = ps
  let y: Int = v
  let none: Option[Int] = None
  t_store_ptrs(pointee(x), shape_of(x), x, y, none)
})

## The rank-0 i64 tile holding `value`. What an address is offset by, in
## bytes; the i64 spelling of `consti`.
pub fn i64_const(value: Int) -> Tile[I64] !Dev = called("i64_const", () => consti(I64, value))

## The element-wise i64 sum `a + b`, the spelling address arithmetic uses.
## `addi` over i64 tiles is the same instruction and the same bytes.
pub fn add_i64(a: Tile[I64], b: Tile[I64]) -> Tile[I64] !Dev = called("add_i64", () => addi(a, b))

## Stop the kernel with `message` when any lane of `cond` is false (knife
## T6). Every zero lane prints the message and its index, and the host is
## told that an assertion fired; the dialect leaves the tile block free to
## keep running, so what a failing kernel wrote before the assert is not
## defined away.
##
## The failure reaches the HOST, not this program: a launch whose assertion
## fired makes the CUDA context report an error, and that error is sticky --
## every later launch in the same process fails too. That is why
## scripts/tile-gpu-diff runs the failing corpus in a process of its own,
## and it is the reason "this launch should fail" is a judgement shape and
## not just another comparison.
pub fn d_assert(cond: Tile[I1], message: String) -> Unit !Dev = called("d_assert", () => {
  let c: Int = cond
  t_assert(shape_of(c), c, message)
})

## `t` with `pred` attached: the same value, and a claim about it the
## compiler may use. The claim is NOT checked, here or on the device, so a
## false one is undefined behaviour (`AssumePred` says where the dialect
## says so).
pub fn d_assume[D](t: Tile[D], pred: AssumePred) -> Tile[D] !Dev = called("d_assume", () => {
  let x: Int = t
  let (dt, s) = row_of(x)
  let r: Tile[D] = t_assume(pred, dt, s, x)
  r
})

## `t`, assumed to hold multiples of `divisor` in every lane.
pub fn assume_div_by[D](t: Tile[D], divisor: Int) -> Tile[D] !Dev = called("assume_div_by", () => {
  let none: Option[Int] = None
  d_assume(t, DivBy(divisor, none, none))
})

## `t`, assumed to repeat one value in every group of `groups[k]` along
## dimension `k`.
pub fn assume_same_elements[D](t: Tile[D], groups: List[Int]) -> Tile[D] !Dev = called("assume_same_elements", () => {
  d_assume(t, SameElements(groups))
})

## `t`, assumed to hold values between `lb` and `ub` inclusive, read
## signed. Either bound may be `None`.
pub fn assume_in_range[D](t: Tile[D], lb: Option[Int], ub: Option[Int]) -> Tile[D] !Dev = called("assume_in_range", () => {
  d_assume(t, Bounded(lb, ub))
})

## Print `fmt` with `args` interleaved, C printf style: one format
## expression (a `%` and its conversion) per argument, and the dialect
## refuses a count that disagrees (PrintTkoOp's verifier counts them the
## way `format_args` in prog.dawn does). Every argument is of one format,
## the first's.
##
## RANK-0 ARGUMENTS ONLY, and that is a decision about what can be JUDGED
## rather than a limit of the operation. The dialect takes a tile of any
## shape and says in as many words that prints "are not guaranteed to be
## atomic" and that simultaneous ones "may be interleaved", so the bytes a
## wide tile puts on standard output are not a value a test can compare.
## One rank-0 tile printed by one tile block is one line, and
## scripts/tile-gpu-diff compares it byte for byte. The effect operation
## underneath carries a shape, so nothing here has to change if a later
## knife finds a judgement for the wide case.
##
## TOKEN ORDERED, which is what the `_tko` in the opcode's name means: this
## takes the ordering token as it stands and answers the next one, so a
## print sits in the same chain as the loads and stores around it. Without
## that the compiler is free to move it (Ops.td says so).
pub fn d_print[D](fmt: String, args: List[Tile[D]]) -> Unit !Dev = called("d_print", () => {
  let hs = list.map(args, a => {
    let h: Int = a
    h
  })
  let dt = if len(hs) == 0 { "i32" } else { dtype_of(hs[0]) }
  let none: List[Int] = []
  t_print(fmt, dt, none, hs)
})

# ---- cells, the named reductions and broadcast (the batch's PR-1 and PR-3) ----
#
# docs/tile-backend-design.md 6.25 and 6.26. What these functions have in
# common is that they take no format marker and no shape. The format comes
# from the `Param[D]` or the `Tile[D]` (its name travels with the
# parameter, and the handler holds every tile's row), and the shape from
# where it already lives: a parameter's cells are on its marker
# (`prog.trace1` to `trace5`), a tile's shape is in the handler's table
# (`t_shape_of`). So none of them can be called with a shape that disagrees
# with the operand.

## This block's cell of `p`, read through a view of `p`'s cells: the tile
## of `p`'s marker, at the block ids of the grid axes its dimensions
## follow. Lanes past the extent read the marker's padding value, so
## `cells([1000], [1024], pad: PadNegInf)` reads a whole row with no mask.
## Every dimension must follow a grid axis; [`load_at`] names the cells of
## the ones that do not. `p` must be an `In` or an `Out` cut into cells.
pub fn load_cell[D](p: Param[D]) -> Tile[D] !Dev = called("load_cell", () => read_cell(p, []))

## [`load_cell`] for a parameter some of whose dimensions follow no grid
## axis (`FREE_AXIS` in its `along`): `free` names the cell along each of
## those, in dimension order, and the others are the block's own, as for
## `load_cell`. The left operand of a matrix product cut
## `cells([M, K], [TM, TK], along: [0, FREE_AXIS])` is read
## `load_at(a, [k])` inside the loop over `k`.
pub fn load_at[D](p: Param[D], free: List[Idx]) -> Tile[D] !Dev = called("load_at", () => read_cell(p, free))

fn read_cell[D](p: Param[D], free: List[Idx]) -> Tile[D] !Dev = {
  let (v, ix) = t_cell_view(position(p), param_dtype(p), list.map(free, idx_handle))
  let h: Tile[D] = t_load_view(param_dtype(p), v, ix)
  h
}

## `t` written into this block's cell of `p`, an `Out` cut into cells:
## the same view `load_cell` reads, at the block's own index. Lanes past
## the extent are not written. No format marker and no shape: `t` must be
## the tile of `p`'s marker, which the recording holds it to, and a rank-0
## `t` is widened to it (every lane of the cell the same value).
##
## This and `store_sub` are the only writes an Out takes (the batch's D-7):
## a `store`, a `scatter`, an atomic or a `store_view` into an Out is
## refused while the kernel records, so the claim "each block writes its own
## cell and nothing else" is not a convention but the only thing a kernel
## can say.
pub fn store_cell[D](p: Param[D], t: Tile[D]) -> Unit !Dev = called("store_cell", () => {
  let (v, ix) = t_cell_view(position(p), param_dtype(p), [])
  let y: Int = t
  t_store_view(param_dtype(p), v, ix, y)
})

## `t` written into piece `at` of this block's cell of `p`, an `Out`: the
## cell is cut into pieces shaped like `t` (which must divide the cell's
## tile in every dimension), and `at` names one by its number along each
## dimension, host numbers each below `tile / shape(t)`. What a block that
## writes its cell in several parts writes with: a slab per segment, the
## two halves of a rotated row. The piece can never leave the block's cell,
## which is the recording's claim and the reason `at` is a host number.
pub fn store_sub[D](p: Param[D], at: List[Int], t: Tile[D]) -> Unit !Dev = called("store_sub", () => {
  let y: Int = t
  let (v, ix) = t_sub_view(position(p), param_dtype(p), shape_of(y), at)
  t_store_view(param_dtype(p), v, ix, y)
})

## A tile shaped like one cell of `p`, in `p`'s format, every lane zero:
## the accumulator a block starts from before it stores its cell.
pub fn zeros[D](p: Param[D]) -> Tile[D] !Dev = called("zeros", () => {
  let h: Tile[D] = t_cell_fill(position(p), 0.0)
  h
})

## A tile shaped like one cell of `p`, in `p`'s format, every lane `v`.
## For an integer format `v` must be a whole number.
pub fn fill[D](p: Param[D], v: Float) -> Tile[D] !Dev = called("fill", () => {
  let h: Tile[D] = t_cell_fill(position(p), v)
  h
})

## `p`'s tensor, of `extent` elements row-major, cut into tiles of `tile`
## and padded with `pad`, as a grid view `load_view` reads at any index:
## the escape hatch for a parameter a kernel reads two ways (the batch's
## C4), when one marker can say only one of them. Read only: an Out's
## writes are its cells. An In's view carries the alignment claim its cells
## carry.
pub fn retile[D](p: Param[D], extent: List[Int], tile: List[Int], pad: Padding = PadZero) -> GridView[D] !Dev = called("retile", () => {
  let r: GridView[D] = t_retile(position(p), param_dtype(p), extent, tile, pad)
  r
})

## The sum of `t` along dimension `dim` (the last by default, `-k` the
## `k`-th from the end): the tile with that dimension dropped, or kept with
## length 1 when `keepdims` is true, so a `[BQ, BK]` tile's row sums are
## `[BQ]` or `[BQ, 1]`. The identity is the format's own (0), so a fold
## seeded wrongly cannot be written. The order of the fold is not
## specified, as `d_reduce`'s is not.
##
## A rank-1 tile reduces to a rank-0 one, which every element-wise
## operation of a wider shape widens on its own (the recording's rank-0
## rule, 6.25): `sub(t, reduce_max(t))` needs no `broadcast`.
pub fn reduce_sum[D](t: Tile[D], dim: Int = -1, keepdims: Bool = false) -> Tile[D] !Dev =
  called("reduce_sum", () => fold_along(t, "sum", dim, keepdims))

## [`reduce_sum`] for the largest element; the identity is -inf for a float
## format and the least value for an integer one.
pub fn reduce_max[D](t: Tile[D], dim: Int = -1, keepdims: Bool = false) -> Tile[D] !Dev =
  called("reduce_max", () => fold_along(t, "max", dim, keepdims))

## [`reduce_sum`] for the smallest element; the identity is +inf for a
## float format and the greatest value for an integer one.
pub fn reduce_min[D](t: Tile[D], dim: Int = -1, keepdims: Bool = false) -> Tile[D] !Dev =
  called("reduce_min", () => fold_along(t, "min", dim, keepdims))

## The running sum of `t` along `dim` (the last by default): the tile of
## `t`'s shape whose element `i` along `dim` is the sum of elements `0` to
## `i`, or `i` to the end when `reverse` is true.
pub fn scan_sum[D](t: Tile[D], dim: Int = -1, reverse: Bool = false) -> Tile[D] !Dev = called("scan_sum", () => {
  let h: Int = t
  let (dtype, shape) = t_shape_of(h)
  let at = axis_of(dim, len(shape))
  let args = t_scan_begin(at, reverse, shape, [identity_of(dtype, "sum")], [h])
  let outs = t_scan_end([fold_step(dtype, "sum", args[0], args[1])])
  let r: Tile[D] = outs[0]
  r
})

## `t` widened to `shape`: every dimension of length 1 in `t` takes its
## length in `shape`, and every other dimension must already have it. The
## rank does not change; a rank-0 `t` widens to any shape (a constant
## becomes one `constant` of that shape). This is the explicit half of the
## rank-0 rule: a `[BQ, 1]` row statistic is `broadcast(m, [BQ, BK])`
## before it meets a `[BQ, BK]` tile, and a loop's starting value is
## `broadcast(f_const(F64, 0.0), [64, 64])`, which `full` writes for you.
pub fn broadcast[D](t: Tile[D], shape: List[Int]) -> Tile[D] !Dev = called("broadcast", () => {
  let h: Int = t
  let (dtype, from) = t_shape_of(h)
  let r: Tile[D] = if len(from) == 0 { t_spread(dtype, shape, h) } else { t_broadcast(dtype, from, shape, h) }
  r
})

## `t` with its lanes regrouped into `shape`, in row-major order: the lanes
## are read off `t` row by row and laid into `shape` row by row, which is
## Tile IR's `reshape`. `shape` holds as many lanes as `t` and every
## dimension is a power of two; the recording refuses anything else. This
## is how a tile meets a cell of another rank: a `[T, T]` product is stored
## into a `[1, T, T]` cell as `store_cell(o, reshape(acc, [1, T, T]))`.
## Adding or dropping a dimension of length 1 moves no lane; regrouping the
## others may cost data movement the compiler chooses.
pub fn reshape[D](t: Tile[D], shape: List[Int]) -> Tile[D] !Dev = called("reshape", () => {
  let h: Int = t
  let (dtype, from) = t_shape_of(h)
  let one = list.fold(shape, 1, (acc, n) => acc * n) == 1
  let r: Tile[D] = if len(from) == 0 && one { t_spread(dtype, shape, h) } else { t_reshape(dtype, from, shape, h) }
  r
})

# A reduction of `t` along `dim` by one of the three named folds.
fn fold_along[D](t: Tile[D], kind: String, dim: Int, keepdims: Bool) -> Tile[D] !Dev = {
  let h: Int = t
  let (dtype, shape) = t_shape_of(h)
  let at = axis_of(dim, len(shape))
  let args = t_reduce_begin(at, shape, [identity_of(dtype, kind)], [h])
  let outs = t_reduce_end([fold_step(dtype, kind, args[0], args[1])])
  let kept = list.map(range(0, len(shape)), k => if k == at { 1 } else { shape[k] })
  let dropped = list.map(list.filter(range(0, len(shape)), k => k != at), k => shape[k])
  let r: Tile[D] = if keepdims { t_reshape(dtype, dropped, kept, outs[0]) } else { outs[0] }
  r
}

# The rank-0 step of a named fold: the accumulator and the element, in the
# order the region hands them over.
fn fold_step(dtype: String, kind: String, acc: Int, e: Int) -> Int !Dev =
  if is_float_dtype(dtype) {
    t_binaryf(if kind == "sum" { "addf" } else if kind == "max" { "maxf" } else { "minf" }, dtype, [], acc, e)
  } else {
    t_binaryi(if kind == "sum" { "addi" } else if kind == "max" { "maxi" } else { "mini" }, dtype, [], acc, e)
  }

# What a named fold that has seen nothing starts from, in `dtype`.
fn identity_of(dtype: String, kind: String) -> RedId =
  if is_float_dtype(dtype) {
    IdF(dtype, if kind == "sum" { 0.0 } else if kind == "max" { 0.0 - 1.0 / 0.0 } else { 1.0 / 0.0 })
  } else {
    IdI(dtype, if kind == "sum" { 0 } else if kind == "max" { int_least(dtype) } else { int_greatest(dtype) })
  }

# The least and the greatest SIGNED value of an integer format: the
# comparisons a max or a min fold makes are signed.
fn int_least(dtype: String) -> Int = match dtype {
  "i8" -> -128
  "i16" -> -32768
  "i64" -> -9223372036854775807 - 1
  _ -> -2147483648
}

fn int_greatest(dtype: String) -> Int = match dtype {
  "i8" -> 127
  "i16" -> 32767
  "i64" -> 9223372036854775807
  _ -> 2147483647
}

# ---- tests ----
#
# The recording handler lives in prog.dawn and is tested there. These blocks
# pin what this module owns: the handles a body holds are the raw values the
# operations answered, and the typed surface passes position, dtype and
# operation name through without touching them.

fn under_counter[T](body: fn() -> T !Dev) -> T = {
  with handle Dev {
    var next: Int = 100
    var carries: List[Int] = []
    var sets: List[Int] = []
    var snaps: List[(Int, List[Int], List[Int])] = []
    t_call_enter(_name) => ()
    t_call_exit() => ()
    t_body_enter() => ()
    t_body_exit() => ()
    t_block_id(_axis) => {
      let h = next
      next = next + 1
      h
    }
    t_load(_param, _dtype, _base, _shape, _strides, _mask, _pad, _hints) => {
      let h = next
      next = next + 1
      h
    }
    t_store(_param, _dtype, _base, _shape, _strides, _v, _mask, _hints) => ()
    t_gather(_param, _dtype, _index, _shape, _mask, _pad) => {
      let h = next
      next = next + 1
      h
    }
    t_scatter(_param, _dtype, _index, _shape, _v, _mask) => ()
    t_atomic_rmw(_param, _dtype, _mode, _index, _shape, _v, _mask) => {
      let h = next
      next = next + 1
      h
    }
    t_atomic_cas(_param, _dtype, _index, _shape, _cmp, _v, _mask) => {
      let h = next
      next = next + 1
      h
    }
    t_mmaf(_dtype, _acc, _m, _k, _n, _a, _b, _c) => {
      let h = next
      next = next + 1
      h
    }
    t_mmai(_m, _k, _n, _a, _b, _c) => {
      let h = next
      next = next + 1
      h
    }
    t_constf(_dtype, _shape, _value) => {
      let h = next
      next = next + 1
      h
    }
    t_consti(_dtype, _shape, _value) => {
      let h = next
      next = next + 1
      h
    }
    t_iota(_n) => {
      let h = next
      next = next + 1
      h
    }
    t_lanes(_base, _shape, _strides) => {
      let h = next
      next = next + 1
      h
    }
    t_unaryf(_op, _dtype, _shape, _a) => {
      let h = next
      next = next + 1
      h
    }
    t_binaryf(_op, _dtype, _shape, _a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_fma(_dtype, _shape, _a, _b, _c) => {
      let h = next
      next = next + 1
      h
    }
    t_cmpf(_pred, _dtype, _shape, _a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_cmpi(_pred, _shape, _a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_unaryi(_op, _dtype, _shape, _a) => {
      let h = next
      next = next + 1
      h
    }
    t_binaryi(_op, _dtype, _shape, _a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_convert(_op, _from, _to, _shape, _a) => {
      let h = next
      next = next + 1
      h
    }
    t_repack(_op, _from, _to, _shape, _a) => {
      let h = next
      next = next + 1
      h
    }
    t_select(_dtype, _shape, _cond, _a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_idx_const(_value) => {
      let h = next
      next = next + 1
      h
    }
    t_idx_add(_a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_idx_mul(_a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_loop_begin(_lower, _upper, _step, _unsigned, inits) => {
      let iv = next
      let base = next + 1
      next = next + 1 + len(inits)
      (iv, list.map(range(0, len(inits)), k => base + k))
    }
    t_loop_end(outs) => {
      let base = next
      next = next + len(outs)
      list.map(range(0, len(outs)), k => base + k)
    }
    t_while_begin(inits) => {
      let base = next
      next = next + len(inits)
      list.map(range(0, len(inits)), k => base + k)
    }
    t_while_end(_cond, outs) => {
      let base = next
      next = next + len(outs)
      list.map(range(0, len(outs)), k => base + k)
    }
    t_return_if(_cond) => ()
    t_spread(_dtype, _shape, _src) => {
      let h = next
      next = next + 1
      h
    }
    t_reduce_begin(_dim, _shape, _identities, operands) => {
      let base = next
      next = next + 2 * len(operands)
      list.map(range(0, 2 * len(operands)), k => base + k)
    }
    t_reduce_end(yields) => {
      let base = next
      next = next + len(yields)
      list.map(range(0, len(yields)), k => base + k)
    }
    t_scan_begin(_dim, _reverse, _shape, _identities, operands) => {
      let base = next
      next = next + 2 * len(operands)
      list.map(range(0, 2 * len(operands)), k => base + k)
    }
    t_scan_end(yields) => {
      let base = next
      next = next + len(yields)
      list.map(range(0, len(yields)), k => base + k)
    }
    t_if_begin(_cond) => ()
    t_if_else(_yields) => ()
    t_if_end(yields) => {
      let base = next
      next = next + len(yields)
      list.map(range(0, len(yields)), k => base + k)
    }
    t_extract(_dtype, _from, _to, _src, _indices) => {
      let h = next
      next = next + 1
      h
    }
    t_insert(_dtype, _sub, _whole, _src, _dst, _indices) => {
      let h = next
      next = next + 1
      h
    }
    t_powi(_dtype, _exp_dtype, _shape, _a, _n) => {
      let h = next
      next = next + 1
      h
    }
    t_cat(_dtype, _dim, _lhs_shape, _rhs_shape, _lhs, _rhs) => {
      let h = next
      next = next + 1
      h
    }
    t_permute(_dtype, _shape, _perm, _src) => {
      let h = next
      next = next + 1
      h
    }
    t_num_blocks(_axis) => {
      let h = next
      next = next + 1
      h
    }
    t_extent_of(_param, _dim, _blocks) => {
      let h = next
      next = next + 1
      h
    }
    t_carry_new(init) => {
      carries = carries ++ [init]
      sets = sets ++ [0]
      len(carries) - 1
    }
    t_carry_get(c) => carries[c]
    t_carry_set(c, h) => {
      let was = carries
      let n = sets
      carries = list.map(range(0, len(was)), k => if k == c { h } else { was[k] })
      sets = list.map(range(0, len(n)), k => if k == c { n[k] + 1 } else { n[k] })
    }
    t_trial_begin() => {
      snaps = snaps ++ [(next, carries, sets)]
    }
    t_trial_end() => {
      let (n0, c0, s0) = snaps[len(snaps) - 1]
      let n = sets
      let changed = list.filter(range(0, len(c0)), k => n[k] != s0[k])
      snaps = list.take(snaps, len(snaps) - 1)
      next = n0
      carries = c0
      sets = s0
      changed
    }
    t_tok_get() => 0
    t_shape_of(_h) => ("f64", [])
    t_tok_set(_tok) => ()
    t_tok_join(_toks) => {
      let h = next
      next = next + 1
      h
    }
    t_ptrs(_param, _dtype, _shape) => {
      let h = next
      next = next + 1
      h
    }
    t_ptr_offset(_dtype, _shape, _ptrs, _offs) => {
      let h = next
      next = next + 1
      h
    }
    t_ptr_to_int(_dtype, _shape, _ptrs) => {
      let h = next
      next = next + 1
      h
    }
    t_int_to_ptr(_dtype, _shape, _ints) => {
      let h = next
      next = next + 1
      h
    }
    t_ptr_to_ptr(_from, _to, _shape, _ptrs) => {
      let h = next
      next = next + 1
      h
    }
    t_load_ptrs(_dtype, _shape, _ptrs, _mask, _pad) => {
      let h = next
      next = next + 1
      h
    }
    t_assert(_shape, _cond, _message) => ()
    t_assume(_pred, _dtype, _shape, _src) => {
      let h = next
      next = next + 1
      h
    }
    t_print(_fmt, _dtype, _shape, _args) => ()
    t_store_ptrs(_dtype, _shape, _ptrs, _value, _mask) => ()
    t_global(_sym, _dtype, _values, _align, _is_private, _constant) => ()
    t_get_global(_sym, _dtype, _shape) => {
      let h = next
      next = next + 1
      h
    }
    t_alloca(_dtype, _num_elem, _align, _shared, _shape) => {
      let h = next
      next = next + 1
      h
    }
    t_mmaf_scaled(_dtype, _scale, _dims, _a, _b, _c, _sa, _sb) => {
      let h = next
      next = next + 1
      h
    }
    t_tensor_view(_param, _dtype, _base, _shape, _strides, _dyn_shape, _dyn_strides) => {
      let h = next
      next = next + 1
      h
    }
    t_partition_view(_dtype, _view, _tile_shape, _dim_map, _padding) => {
      let h = next
      next = next + 1
      h
    }
    t_strided_view(_dtype, _view, _tile_shape, _traversal, _dim_map, _padding) => {
      let h = next
      next = next + 1
      h
    }
    t_gather_view(_dtype, _view, _tile_shape, _sparse_dim, _padding) => {
      let h = next
      next = next + 1
      h
    }
    t_atomic_red_view(_dtype, _view, _indices, _mode, _scope, _value) => ()
    t_load_view(_dtype, _view, _indices) => {
      let h = next
      next = next + 1
      h
    }
    t_store_view(_dtype, _view, _indices, _value) => ()
    t_tensor_shape(_view, _dim) => {
      let h = next
      next = next + 1
      h
    }
    t_index_space_shape(_view, _dim) => {
      let h = next
      next = next + 1
      h
    }
    t_cell_view(_param, _dtype, free) => {
      let h = next
      next = next + 1
      (h, free)
    }
    t_cell_fill(_param, _value) => {
      let h = next
      next = next + 1
      h
    }
    t_sub_view(_param, _dtype, _sub, at) => {
      let h = next
      next = next + 1
      (h, at)
    }
    t_retile(_param, _dtype, _extent, _tile, _pad) => {
      let h = next
      next = next + 1
      h
    }
    t_reshape(_dtype, _from, _to, _src) => {
      let h = next
      next = next + 1
      h
    }
    t_broadcast(_dtype, _from, _to, _src) => {
      let h = next
      next = next + 1
      h
    }
  }
  body()
}

fn handles_seen() -> (Int, Int, Int, Int) !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let base = tile_at(i, 128)
  let ta = load(a, base, [128])
  let tb = load(a, base, [128])
  let s = add(ta, tb)
  store(a, base, s)
  let hi: Int = i
  let ha: Int = ta
  let hb: Int = tb
  let hs: Int = s
  (hi, ha, hb, hs)
}

test "a handle is the value the operation answered, in order" {
  # block_id 100, then tile_at's idx_const 101 and idx_mul 102, then the
  # two loads and the sum. Reading a shape answers no handle.
  assert under_counter(handles_seen) == (100, 103, 104, 105)
}

test "a parameter remembers its position and its format" {
  let a = param(F64, 0)
  let b = param(F32, 5)
  assert position(a) == 0
  assert param_dtype(a) == "f64"
  assert position(b) == 5
  assert param_dtype(b) == "f32"
}

test "a layout is a permutation of strides, and a transpose is one" {
  assert row_major([4, 6]) == [6, 1]
  assert permute(row_major([4, 6]), [1, 0]) == [1, 6]
  # a permutation twice over is the layout it started from
  assert permute(permute(row_major([4, 6]), [1, 0]), [1, 0]) == row_major([4, 6])
  assert permute(row_major([2, 3, 4]), [2, 0, 1]) == [1, 12, 4]
  # one axis walked, the others held: what a coordinate tile reads with
  assert axis_strides(2, 0, 1) == [1, 0]
  assert axis_strides(2, 1, 1) == [0, 1]
  assert axis_strides(3, 1, 5) == [0, 5, 0]
}

test "the tile element formats name themselves as Tile IR spells them" {
  assert (dtype_name(I32), dtype_bytes(I32)) == ("i32", 4)
  assert (dtype_name(I1), dtype_bytes(I1)) == ("i1", 1)
}

fn dtype_passed_to_load() -> List[String] !Dev = {
  let a = param(F32, 1)
  let i = block_id(2)
  let _t = load(a, tile_at(i, 64), [64])
  []
}

# What an operation looks like in the log below: `None` for an absent
# optional operand, its handle for a present one.
fn opt(o: Option[Int]) -> String = match o {
  Some(h) -> "Some(${h})"
  None -> "None"
}

# The row `logged` keeps for `h`: the last one it answered `h` with, or a
# rank-0 f64 for a handle it never answered.
fn row_in(rows: List[(Int, String, List[Int])], h: Int) -> (String, List[Int]) =
  match list.find(rows, r => {
    let (k, _d, _s) = r
    k == h
  }) {
    Some(r) -> {
      let (_k, d, s) = r
      (d, s)
    }
    None -> ("f64", [])
  }

# Run `body` under a handler that answers a fixed handle per operation and
# writes one line per operation it saw, and answer the lines. The state cell
# is the handler's own: a closure may not capture a `var` (spec 4.5), so the
# log cannot be passed in. It keeps a row for each handle it answers, the
# way the recording handler does, because the typed surface reads every
# operand's format and shape back (`t_shape_of`); a handle answered twice
# (every load is 1) has the row of the last answer. The reads are not
# logged: they record nothing.
fn logged(body: fn() -> Unit !Dev) -> List[String] = {
  with handle Dev {
    var log: List[String] = []
    var rows: List[(Int, String, List[Int])] = []
    var carries: List[Int] = []
    var sets: List[Int] = []
    var snaps: List[((List[String], List[(Int, String, List[Int])]), List[Int], List[Int])] = []
    t_call_enter(_name) => ()
    t_call_exit() => ()
    t_body_enter() => ()
    t_body_exit() => ()
    t_block_id(axis) => {
      log = log ++ ["block_id ${axis}"]
      0
    }
    t_load(param, dtype, base, shape, strides, mask, pad, hints) => {
      log = log ++ ["load ${param} ${dtype} ${base} ${show(shape)} ${show(strides)} ${opt(mask)} ${opt(pad)} ${show(hints)}"]
      rows = [(1, dtype, shape)] ++ rows
      1
    }
    t_store(param, dtype, base, shape, strides, v, mask, hints) => {
      log = log ++ ["store ${param} ${dtype} ${base} ${show(shape)} ${show(strides)} ${v} ${opt(mask)} ${show(hints)}"]
    }
    t_gather(param, dtype, index, shape, mask, pad) => {
      log = log ++ ["gather ${param} ${dtype} ${index} ${show(shape)} ${opt(mask)} ${opt(pad)}"]
      rows = [(1, dtype, shape)] ++ rows
      1
    }
    t_scatter(param, dtype, index, shape, v, mask) => {
      log = log ++ ["scatter ${param} ${dtype} ${index} ${show(shape)} ${v} ${opt(mask)}"]
    }
    t_atomic_rmw(param, dtype, mode, index, shape, v, mask) => {
      log = log ++ ["atomic_rmw ${param} ${dtype} ${mode} ${index} ${show(shape)} ${v} ${opt(mask)}"]
      1
    }
    t_atomic_cas(param, dtype, index, shape, cmp, v, mask) => {
      log = log ++ ["atomic_cas ${param} ${dtype} ${index} ${show(shape)} ${cmp} ${v} ${opt(mask)}"]
      1
    }
    t_constf(dtype, shape, value) => {
      log = log ++ ["constf ${dtype} ${show(shape)} ${value}"]
      rows = [(2, dtype, shape)] ++ rows
      2
    }
    t_consti(dtype, shape, value) => {
      log = log ++ ["consti ${dtype} ${show(shape)} ${value}"]
      rows = [(3, dtype, shape)] ++ rows
      3
    }
    t_iota(n) => {
      log = log ++ ["iota ${n}"]
      rows = [(4, "i32", [n])] ++ rows
      4
    }
    t_lanes(base, shape, strides) => {
      log = log ++ ["lanes ${base} ${show(shape)} ${show(strides)}"]
      rows = [(5, "i32", shape)] ++ rows
      5
    }
    t_unaryf(op, dtype, shape, a) => {
      log = log ++ ["unaryf ${op} ${dtype} ${show(shape)} ${a}"]
      rows = [(6, dtype, shape)] ++ rows
      6
    }
    t_binaryf(op, dtype, shape, a, b) => {
      log = log ++ ["binaryf ${op} ${dtype} ${show(shape)} ${a} ${b}"]
      rows = [(7, dtype, shape)] ++ rows
      7
    }
    t_fma(dtype, shape, a, b, c) => {
      log = log ++ ["fma ${dtype} ${show(shape)} ${a} ${b} ${c}"]
      rows = [(8, dtype, shape)] ++ rows
      8
    }
    t_mmaf(dtype, acc, m, k, n, a, b, c) => {
      log = log ++ ["mmaf ${dtype} ${acc} ${m} ${k} ${n} ${a} ${b} ${c}"]
      rows = [(17, acc, [m, n])] ++ rows
      17
    }
    t_mmai(m, k, n, a, b, c) => {
      log = log ++ ["mmai ${m} ${k} ${n} ${a} ${b} ${c}"]
      18
    }
    t_cmpf(pred, dtype, shape, a, b) => {
      log = log ++ ["cmpf ${pred} ${dtype} ${show(shape)} ${a} ${b}"]
      rows = [(9, "i1", shape)] ++ rows
      9
    }
    t_cmpi(pred, shape, a, b) => {
      log = log ++ ["cmpi ${pred} ${show(shape)} ${a} ${b}"]
      rows = [(10, "i1", shape)] ++ rows
      10
    }
    t_unaryi(op, dtype, shape, a) => {
      log = log ++ ["unaryi ${op} ${dtype} ${show(shape)} ${a}"]
      18
    }
    t_binaryi(op, dtype, shape, a, b) => {
      log = log ++ ["binaryi ${op} ${dtype} ${show(shape)} ${a} ${b}"]
      rows = [(19, dtype, shape)] ++ rows
      19
    }
    t_convert(op, from, to, shape, a) => {
      log = log ++ ["convert ${op} ${from} ${to} ${show(shape)} ${a}"]
      rows = [(20, to, shape)] ++ rows
      20
    }
    t_repack(op, from, to, shape, a) => {
      log = log ++ ["repack ${op} ${from} ${to} ${show(shape)} ${a}"]
      21
    }
    t_select(dtype, shape, cond, a, b) => {
      log = log ++ ["select ${dtype} ${show(shape)} ${cond} ${a} ${b}"]
      rows = [(11, dtype, shape)] ++ rows
      11
    }
    t_idx_const(_value) => 12
    t_idx_add(_a, _b) => 13
    t_idx_mul(_a, _b) => 14
    t_loop_begin(_lower, _upper, _step, _unsigned, inits) => (15, inits)
    t_loop_end(outs) => outs
    t_while_begin(inits) => inits
    t_while_end(_cond, outs) => outs
    t_return_if(cond) => {
      log = log ++ ["return_if ${cond}"]
    }
    t_spread(dtype, shape, src) => {
      log = log ++ ["spread ${dtype} ${show(shape)} ${src}"]
      rows = [(16, dtype, shape)] ++ rows
      16
    }
    t_reduce_begin(dim, shape, identities, operands) => {
      log = log ++ ["reduce_begin ${dim} ${show(shape)} ${show(identities)} ${show(operands)}"]
      list.map(range(0, 2 * len(operands)), k => 20 + k)
    }
    t_reduce_end(yields) => {
      log = log ++ ["reduce_end ${show(yields)}"]
      list.map(range(0, len(yields)), k => 30 + k)
    }
    t_scan_begin(dim, reverse, shape, identities, operands) => {
      log = log ++ ["scan_begin ${dim} ${reverse} ${show(shape)} ${show(identities)} ${show(operands)}"]
      list.map(range(0, 2 * len(operands)), k => 20 + k)
    }
    t_scan_end(yields) => {
      log = log ++ ["scan_end ${show(yields)}"]
      list.map(range(0, len(yields)), k => 30 + k)
    }
    t_if_begin(cond) => {
      log = log ++ ["if_begin ${cond}"]
    }
    t_if_else(yields) => {
      log = log ++ ["if_else ${show(yields)}"]
    }
    t_if_end(yields) => {
      log = log ++ ["if_end ${show(yields)}"]
      list.map(range(0, len(yields)), k => 40 + k)
    }
    t_extract(dtype, from, to, src, indices) => {
      log = log ++ ["extract ${dtype} ${show(from)} ${show(to)} ${src} ${show(indices)}"]
      rows = [(50, dtype, to)] ++ rows
      50
    }
    t_insert(dtype, sub, whole, src, dst, indices) => {
      log = log ++ ["insert ${dtype} ${show(sub)} ${show(whole)} ${src} ${dst} ${show(indices)}"]
      54
    }
    t_powi(dtype, exp_dtype, shape, a, n) => {
      log = log ++ ["powi ${dtype} ${exp_dtype} ${show(shape)} ${a} ${n}"]
      55
    }
    t_cat(dtype, dim, lhs_shape, rhs_shape, lhs, rhs) => {
      log = log ++ ["cat ${dtype} ${dim} ${show(lhs_shape)} ${show(rhs_shape)} ${lhs} ${rhs}"]
      51
    }
    t_permute(dtype, shape, perm, src) => {
      log = log ++ ["permute ${dtype} ${show(shape)} ${show(perm)} ${src}"]
      52
    }
    t_num_blocks(axis) => {
      log = log ++ ["num_blocks ${axis}"]
      53
    }
    t_extent_of(param, dim, blocks) => {
      log = log ++ ["extent_of ${param} ${dim} ${blocks}"]
      53
    }
    t_carry_new(init) => {
      carries = carries ++ [init]
      sets = sets ++ [0]
      len(carries) - 1
    }
    t_carry_get(c) => carries[c]
    t_carry_set(c, h) => {
      let was = carries
      let n = sets
      carries = list.map(range(0, len(was)), k => if k == c { h } else { was[k] })
      sets = list.map(range(0, len(n)), k => if k == c { n[k] + 1 } else { n[k] })
    }
    t_trial_begin() => {
      snaps = snaps ++ [((log, rows), carries, sets)]
    }
    t_trial_end() => {
      let ((l0, r0), c0, s0) = snaps[len(snaps) - 1]
      let n = sets
      let changed = list.filter(range(0, len(c0)), k => n[k] != s0[k])
      snaps = list.take(snaps, len(snaps) - 1)
      log = l0
      rows = r0
      carries = c0
      sets = s0
      changed
    }
    t_tok_get() => {
      log = log ++ ["tok_get"]
      60
    }
    t_shape_of(h) => row_in(rows, h)
    t_tok_set(tok) => {
      log = log ++ ["tok_set ${tok}"]
    }
    t_tok_join(toks) => {
      log = log ++ ["tok_join ${show(toks)}"]
      61
    }
    t_ptrs(param, dtype, shape) => {
      log = log ++ ["ptrs ${param} ${dtype} ${show(shape)}"]
      rows = [(70, "ptr<${dtype}>", shape)] ++ rows
      70
    }
    t_ptr_offset(dtype, shape, ptrs, offs) => {
      log = log ++ ["ptr_offset ${dtype} ${show(shape)} ${ptrs} ${offs}"]
      rows = [(71, "ptr<${dtype}>", shape)] ++ rows
      71
    }
    t_ptr_to_int(dtype, shape, ptrs) => {
      log = log ++ ["ptr_to_int ${dtype} ${show(shape)} ${ptrs}"]
      rows = [(72, "i64", shape)] ++ rows
      72
    }
    t_int_to_ptr(dtype, shape, ints) => {
      log = log ++ ["int_to_ptr ${dtype} ${show(shape)} ${ints}"]
      rows = [(73, "ptr<${dtype}>", shape)] ++ rows
      73
    }
    t_ptr_to_ptr(from, to, shape, ptrs) => {
      log = log ++ ["ptr_to_ptr ${from} ${to} ${show(shape)} ${ptrs}"]
      rows = [(74, "ptr<${to}>", shape)] ++ rows
      74
    }
    t_load_ptrs(dtype, shape, ptrs, mask, pad) => {
      log = log ++ ["load_ptrs ${dtype} ${show(shape)} ${ptrs} ${opt(mask)} ${opt(pad)}"]
      75
    }
    t_assert(shape, cond, message) => {
      log = log ++ ["assert ${show(shape)} ${cond} ${message}"]
      ()
    }
    t_assume(pred, dtype, shape, src) => {
      log = log ++ ["assume ${show(pred)} ${dtype} ${show(shape)} ${src}"]
      76
    }
    t_print(fmt, dtype, shape, args) => {
      log = log ++ ["print ${fmt} ${dtype} ${show(shape)} ${show(args)}"]
      ()
    }
    t_store_ptrs(dtype, shape, ptrs, value, mask) => {
      log = log ++ ["store_ptrs ${dtype} ${show(shape)} ${ptrs} ${value} ${opt(mask)}"]
    }
    t_global(sym, dtype, values, align, is_private, constant) => {
      log = log ++ ["global ${sym} ${dtype} ${show(values)} ${align} ${show(is_private)} ${show(constant)}"]
    }
    t_get_global(sym, dtype, shape) => {
      log = log ++ ["get_global ${sym} ${dtype} ${show(shape)}"]
      77
    }
    t_alloca(dtype, num_elem, align, shared, shape) => {
      log = log ++ ["alloca ${dtype} ${num_elem} ${align} ${show(shared)} ${show(shape)}"]
      78
    }
    t_mmaf_scaled(dtype, scale, dims, a, b, c, sa, sb) => {
      log = log ++ ["mmaf_scaled ${dtype} ${scale} ${show(dims)} ${a} ${b} ${c} ${sa} ${sb}"]
      79
    }
    t_tensor_view(param, dtype, base, shape, strides, dyn_shape, dyn_strides) => {
      log = log ++ ["tensor_view ${param} ${dtype} ${base} ${show(shape)} ${show(strides)}"
          ++ " ${show(dyn_shape)} ${show(dyn_strides)}"]
      rows = [(80, dtype, shape)] ++ rows
      80
    }
    t_partition_view(dtype, view, tile_shape, dim_map, padding) => {
      log = log ++ ["partition_view ${dtype} ${view} ${show(tile_shape)} ${show(dim_map)} ${padding_name(padding)}"]
      rows = [(81, dtype, tile_shape)] ++ rows
      81
    }
    t_strided_view(dtype, view, tile_shape, traversal, dim_map, padding) => {
      log = log ++ ["strided_view ${dtype} ${view} ${show(tile_shape)} ${show(traversal)}"
          ++ " ${show(dim_map)} ${padding_name(padding)}"]
      rows = [(85, dtype, tile_shape)] ++ rows
      85
    }
    t_gather_view(dtype, view, tile_shape, sparse_dim, padding) => {
      log = log ++ ["gather_view ${dtype} ${view} ${show(tile_shape)} ${sparse_dim}"
          ++ " ${padding_name(padding)}"]
      rows = [(86, dtype, tile_shape)] ++ rows
      86
    }
    t_atomic_red_view(dtype, view, indices, mode, scope, value) => {
      log = log ++ ["atomic_red_view ${dtype} ${view} ${show(indices)} ${mode} ${scope} ${value}"]
    }
    t_load_view(dtype, view, indices) => {
      log = log ++ ["load_view ${dtype} ${view} ${show(indices)}"]
      82
    }
    t_store_view(dtype, view, indices, value) => {
      log = log ++ ["store_view ${dtype} ${view} ${show(indices)} ${value}"]
    }
    t_tensor_shape(view, dim) => {
      log = log ++ ["tensor_shape ${view} ${dim}"]
      83
    }
    t_index_space_shape(view, dim) => {
      log = log ++ ["index_space_shape ${view} ${dim}"]
      84
    }
    t_cell_view(param, dtype, free) => {
      log = log ++ ["cell_view ${param} ${dtype} ${show(free)}"]
      (87, free)
    }
    t_cell_fill(param, value) => {
      log = log ++ ["cell_fill ${param} ${value}"]
      88
    }
    t_sub_view(param, dtype, sub, at) => {
      log = log ++ ["sub_view ${param} ${dtype} ${show(sub)} ${show(at)}"]
      (91, at)
    }
    t_retile(param, dtype, extent, tile, pad) => {
      log = log ++ ["retile ${param} ${dtype} ${show(extent)} ${show(tile)} ${padding_name(pad)}"]
      92
    }
    t_reshape(dtype, from, to, src) => {
      log = log ++ ["reshape ${dtype} ${show(from)} ${show(to)} ${src}"]
      89
    }
    t_broadcast(dtype, from, to, src) => {
      log = log ++ ["broadcast ${dtype} ${show(from)} ${show(to)} ${src}"]
      90
    }
  }
  body()
  log
}

test "load hands the handler the parameter's own format, not a fixed one" {
  let seen = logged(() => {
    let _r = dtype_passed_to_load()
    ()
  })
  assert seen == ["block_id 2", "load 1 f32 14 [64] [1] None None []"]
}

fn t16_surface() -> Unit !Dev = {
  let x = param(F64, 0)
  let n = param(I8, 1)
  let t = load(x, idx_const(0), [16, 8])
  let q = extract(t, [8, 4], [idx_const(1), idx_const(0)])
  let _r = insert(q, t, [idx_const(0), idx_const(1)])
  let _p = powi(t, load(n, idx_const(0), [16, 8]))
  ()
}

test "insert reads the subtile's shape and the whole tile's off its operands; powi both formats" {
  let seen = logged(t16_surface)
  # every idx_const answers 12 here, the loads 1, extract 50: the subtile's
  # shape is extract's answer and the whole tile's the first load's
  assert list.any(seen, l => l == "extract f64 [16, 8] [8, 4] 1 [12, 12]")
  assert list.any(seen, l => l == "insert f64 [8, 4] [16, 8] 50 1 [12, 12]")
  # both loads answer 1 here, so the two formats `powi` reads off its
  # operands are whichever load came last; prog.dawn's refusal of an i64
  # exponent is where the pairing is held
  assert list.any(seen, l => str.starts_with(l, "powi ") && str.ends_with(l, " [16, 8] 1 1"))
}

fn t17_surface() -> Unit !Dev = {
  let x = param(F64, 0)
  let t = load(x, idx_const(0), [8])
  let _s = t.float_to_int(I32, saturating: true)
  let _a = t.float_to_float(F32).float_to_float(TF32, rounding: NearestAway)
  d_return_if(gt(f_const(F64, 1.0), f_const(F64, 0.0)))
}

test "the knife T17 surface spells its conversions by name, reads the source format off the tile, and hands the handler the return's condition" {
  let seen = logged(t17_surface)
  # every load answers 1 and every convert 20 here
  assert list.any(seen, l => l == "convert ftoi_sat f64 i32 [8] 1")
  assert list.any(seen, l => l == "convert ftof_away f32 tf32 [8] 20")
  # the two constants are rank 0, and so is the comparison of them
  assert list.any(seen, l => l == "cmpf gt f64 [] 2 2")
  assert list.any(seen, l => str.starts_with(l, "return_if "))
}

# Every attribute value knife K2 turned into a parameter, once each, in the
# order knife T4 and knife T17 listed their suffixed names.
fn k2_surface() -> Unit !Dev = {
  let x = param(F32, 0)
  let t = load(x, idx_const(0), [8])
  let _r = [
    add(t, t, rounding: Down), add(t, t, rounding: Up),
    mul(t, t, rounding: Down), mul(t, t, rounding: Up),
    div(t, t, rounding: Down), div(t, t, rounding: Up),
    add(t, t, ftz: true), mul(t, t, ftz: true),
    max(t, t, propagate_nan: true), min(t, t, propagate_nan: true),
    add(t, t, rounding: NearestEven, ftz: false), sub(t, t, rounding: TowardZero),
    add(t, t, rounding: Down, ftz: true)
  ]
  let i = broadcast(i_const(1), [8])
  let _n = [
    add_i(i, i, overflow: NoSignedWrap), sub_i(i, i, overflow: NoUnsignedWrap),
    mul_i(i, i, overflow: NoWrap), add_i(i, i, overflow: NoWrap)
  ]
  let _c = [
    t.float_to_float(F64, rounding: TowardZero), t.float_to_float(F64, rounding: Down),
    t.float_to_float(F64, rounding: Up), t.float_to_float(F64, rounding: NearestAway)
  ]
  d_global("a", F64, [1.0], align: 256)
  d_global("b", F64, [1.0], visibility: Private, constant: true)
  let _p = alloca_ptrs(F64, 8, 8, [8], shared: true)
  ()
}

test "the knife K2 parameters hand the handler the names the suffixed functions did, and spell what they never could" {
  let seen = logged(k2_surface)
  # every load answers 1 here
  let want = [
    "binaryf addf_neg_inf f32 [8] 1 1", "binaryf addf_pos_inf f32 [8] 1 1",
    "binaryf mulf_neg_inf f32 [8] 1 1", "binaryf mulf_pos_inf f32 [8] 1 1",
    "binaryf divf_neg_inf f32 [8] 1 1", "binaryf divf_pos_inf f32 [8] 1 1",
    "binaryf addf_ftz f32 [8] 1 1", "binaryf mulf_ftz f32 [8] 1 1",
    "binaryf maxf_nan f32 [8] 1 1", "binaryf minf_nan f32 [8] 1 1",
    "binaryf addf f32 [8] 1 1",
    # the two a suffix could not spell: names the recording handler refuses
    "binaryf subf_zero f32 [8] 1 1", "binaryf addf_neg_inf_ftz f32 [8] 1 1",
    "convert ftof_zero f32 f64 [8] 1", "convert ftof_neg_inf f32 f64 [8] 1",
    "convert ftof_pos_inf f32 f64 [8] 1", "convert ftof_away f32 f64 [8] 1",
    "global a f64 [1.0] 256 false false", "global b f64 [1.0] 0 true true",
    "alloca f64 8 8 true [8]"
  ]
  assert list.all(want, w => list.any(seen, l => l == w))
  assert len(list.filter(seen, l => str.starts_with(l, "binaryi "))) == 4
  assert list.any(seen, l => l == "binaryi addi_nsw i32 [8] 16 16")
  assert list.any(seen, l => str.starts_with(l, "binaryi subi_nuw "))
  assert list.any(seen, l => str.starts_with(l, "binaryi muli_nw "))
  assert list.any(seen, l => str.starts_with(l, "binaryi addi_nw "))
}

test "a rounding direction is spelt as the dialect spells it and as std/narrow's header pairs it" {
  assert rounding_name(NearestEven) == "nearest_even"
  assert rounding_name(NearestAway) == "nearest_away"
  assert rounding_name(TowardZero) == "zero"
  assert rounding_name(Down) == "negative_inf"
  assert rounding_name(Up) == "positive_inf"
  assert overflow_name(NoAssumption) == "none"
  assert overflow_name(NoWrap) == "no_wrap"
  assert visibility_name(Private) == "private"
}

fn indexed_surface() -> Unit !Dev = {
  let idx = param(I32, 0)
  let src = param(F64, 1)
  let out = param(F64, 2)
  let i = load(idx, idx_const(0), [8])
  let ok = lt_i(i, i_const(8))
  let v = gather(src, i, mask: Some(ok), pad: Some(f_const(F64, 0.0)))
  scatter(out, i, v)
  scatter(out, i, gather(src, i), mask: Some(ok))
}

test "gather and scatter hand the handler the index tile, its shape and the parameter's own format, with no strides at all" {
  # the comparison is over the index tile's shape: the rank-0 constant 8 is
  # the recording's to widen, not the surface's
  assert logged(indexed_surface) == [
    "load 0 i32 12 [8] [1] None None []",
    "consti i32 [] 8",
    "cmpi lt [8] 1 3",
    "constf f64 [] 0.0",
    "gather 1 f64 1 [8] Some(10) Some(2)",
    "scatter 2 f64 1 [8] 1 None",
    "gather 1 f64 1 [8] None None",
    "scatter 2 f64 1 [8] 1 Some(10)"
  ]
}

fn atomic_surface() -> Unit !Dev = {
  let hist = param(I32, 0)
  let slots = param(I32, 1)
  let i = load(hist, idx_const(0), [8])
  let ok = lt_i(i, i_const(8))
  atomic_add(hist, i, i_const(1), mask: Some(ok))
  let _all = atomic_rmw(hist, "max", i, i_const(3))
  let _one = atomic_cas(slots, i, i_const(0), i_const(5), mask: Some(ok))
  let _two = atomic_cas(slots, i, i_const(0), i_const(5))
  ()
}

test "the atomics hand the handler the mode, the index tile and the parameter's own format" {
  assert logged(atomic_surface) == [
    "load 0 i32 12 [8] [1] None None []",
    "consti i32 [] 8",
    "cmpi lt [8] 1 3",
    "consti i32 [] 1",
    "atomic_rmw 0 i32 add 1 [8] 3 Some(10)",
    "consti i32 [] 3",
    "atomic_rmw 0 i32 max 1 [8] 3 None",
    "consti i32 [] 0",
    "consti i32 [] 5",
    "atomic_cas 1 i32 1 [8] 3 3 Some(10)",
    "consti i32 [] 0",
    "consti i32 [] 5",
    "atomic_cas 1 i32 1 [8] 3 3 None"
  ]
}

fn every_arithmetic_name() -> Unit !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let base = tile_at(i, 8)
  let m = tail_mask(base, [8], 5)
  let x = load(a, base, [8], mask: Some(m), pad: Some(f_const(F64, 0.0)))
  let y = load(a, base, [8])
  let s = add(x, y)
  let d = sub(s, y)
  let p = mul(d, y)
  let q = div(p, y)
  let hi = max(q, y)
  let lo = min(hi, y)
  let n1 = neg(lo)
  let a1 = abs(n1)
  let f1 = fma(a1, y, x)
  let c = lt(f1, y)
  let r = select(c, f1, y)
  store(a, base, r, mask: Some(m))
}

test "the typed surface spells every operation name the handler sees, and reads every shape off an operand" {
  let seen = logged(every_arithmetic_name)
  assert seen == [
    "block_id 0",
    "lanes 14 [8] [1]",
    "consti i32 [] 5",
    "cmpi lt [8] 5 3",
    "constf f64 [] 0.0",
    "load 0 f64 14 [8] [1] Some(10) Some(2) []",
    "load 0 f64 14 [8] [1] None None []",
    "binaryf addf f64 [8] 1 1",
    "binaryf subf f64 [8] 7 1",
    "binaryf mulf f64 [8] 7 1",
    "binaryf divf f64 [8] 7 1",
    "binaryf maxf f64 [8] 7 1",
    "binaryf minf f64 [8] 7 1",
    "unaryf negf f64 [8] 7",
    "unaryf absf f64 [8] 6",
    "fma f64 [8] 6 1 1",
    "cmpf lt f64 [8] 8 1",
    "select f64 [8] 9 8 1",
    "store 0 f64 14 [8] [1] 11 Some(10) []"
  ]
}

fn every_transcendental() -> Unit !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let x = load(a, tile_at(i, 8), [8])
  let _r = [
    exp(x), exp2(x), log(x), log2(x), sqrt(x), rsqrt(x), tanh(x), floor(x), ceil(x), pow(x, x),
    sin(x), cos(x), tan(x), sinh(x), cosh(x), atan2(x, x), remf(x, x)
  ]
  ()
}

test "the typed surface spells every transcendental's name the way Tile IR does" {
  let seen = {
    let log_lines = logged(every_transcendental)
    list.filter(log_lines, l => str.starts_with(l, "unaryf") || str.starts_with(l, "binaryf"))
  }
  assert seen == [
    "unaryf exp f64 [8] 1", "unaryf exp2 f64 [8] 1", "unaryf log f64 [8] 1", "unaryf log2 f64 [8] 1",
    "unaryf sqrt f64 [8] 1", "unaryf rsqrt f64 [8] 1", "unaryf tanh f64 [8] 1", "unaryf floor f64 [8] 1",
    "unaryf ceil f64 [8] 1", "binaryf pow f64 [8] 1 1",
    "unaryf sin f64 [8] 1", "unaryf cos f64 [8] 1", "unaryf tan f64 [8] 1", "unaryf sinh f64 [8] 1",
    "unaryf cosh f64 [8] 1", "binaryf atan2 f64 [8] 1 1", "binaryf remf f64 [8] 1 1"
  ]
}

fn one_reduction() -> Unit !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let x = load(a, tile_at(i, 8), [8])
  let s = d_reduce(x, 0.0, (acc, e) => add(acc, e))
  let _w = broadcast(s, [8])
  ()
}

test "a reduction hands the handler its dimension, the identity and the operand, and its region the accumulator and the element" {
  # `logged` answers 20 and 21 for the two region arguments and 30 for the
  # result; the body's addf is over those two, at rank 0
  assert logged(one_reduction) == [
    "block_id 0",
    "load 0 f64 14 [8] [1] None None []",
    "reduce_begin 0 [8] [IdF(\"f64\", 0.0)] [1]",
    "binaryf addf f64 [] 20 21",
    "reduce_end [7]",
    "spread f64 [8] 30"
  ]
}

test "a reduction writes its identity in the operand's format, and counts its dimension from the back when it is negative" {
  let seen = logged(() => {
    let a = param(I32, 0)
    let x = load(a, idx_const(0), [4, 8])
    let _s = d_reduce(x, 0.0 - 2000000000.0, (acc, e) => max_i(acc, e), dim: -2)
    let _c = d_scan(x, 0.0, (acc, e) => add_i(acc, e), reverse: true)
    ()
  })
  assert list.any(seen, l => l == "reduce_begin 0 [4, 8] [IdI(\"i32\", -2000000000)] [1]")
  assert list.any(seen, l => l == "scan_begin 1 true [4, 8] [IdI(\"i32\", 0)] [1]")
}

fn one_branch() -> Unit !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let x = load(a, tile_at(i, 8), [8])
  let r = carry(x)
  d_if(idx_eq(i, idx_const(0)), () => r.set(add(x, x)), () => r.set(mul(x, x)))
}

test "an if hands the handler its condition, then each branch's yield in turn" {
  assert logged(one_branch) == [
    "block_id 0",
    "load 0 f64 14 [8] [1] None None []",
    "cmpi eq [] 0 12",
    "if_begin 10",
    "binaryf addf f64 [8] 1 1",
    "if_else [7]",
    "binaryf mulf f64 [8] 1 1",
    "if_end [7]"
  ]
}

test "a loop carries the carries its body sets, in the order they were made, and leaves the trial no trace" {
  let seen = under_counter(() => {
    let a = param(F64, 0)
    let i = block_id(0)
    let x = load(a, tile_at(i, 8), [8])
    let z = idx_const(0)
    let p = carry(x)
    let q = carry(x)
    let r = carry(x)
    let w = carry(x)
    for _k in d_range(z, z, step: By(z)) {
      r.set(r.get())
      p.set(p.get())
      q.set(q.get())
    }
    let hp: Int = p.get()
    let hq: Int = q.get()
    let hr: Int = r.get()
    let hw: Int = w.get()
    (hp, hq, hr, hw)
  })
  # block_id 100, tile_at's idx_const 101 and idx_mul 102, load 103,
  # idx_const 104; the trial's handles are given back, so loop_begin takes
  # 105 for the induction variable and 106, 107, 108 for p, q and r (made in
  # that order, whatever order the body sets them in), and loop_end answers
  # 109, 110, 111 for them after the loop. `w` is never set: not carried,
  # still the load.
  assert seen == (109, 110, 111, 103)
}

test "d_range over host bounds issues its three bounds as index constants, then the loop, as d_range over those constants does" {
  let ranged = under_counter(() => {
    let c = carry(broadcast(f_const(F64, 0.0), [8]))
    for _k in d_range(2, 9, step: By(3)) { c.set(c.get()) }
    let h: Int = c.get()
    h
  })
  let spelled = under_counter(() => {
    let c = carry(broadcast(f_const(F64, 0.0), [8]))
    for _k in d_range(idx_const(2), idx_const(9), step: By(idx_const(3))) { c.set(c.get()) }
    let h: Int = c.get()
    h
  })
  assert ranged == spelled
}

test "d_range with no step records the constant 1 as the step, after the bounds, when the loop starts" {
  let unit = under_counter(() => {
    let c = carry(broadcast(f_const(F64, 0.0), [8]))
    for _k in d_range(2, 9) { c.set(c.get()) }
    let h: Int = c.get()
    h
  })
  let by_one = under_counter(() => {
    let c = carry(broadcast(f_const(F64, 0.0), [8]))
    for _k in d_range(2, 9, step: By(1)) { c.set(c.get()) }
    let h: Int = c.get()
    h
  })
  assert unit == by_one
}

test "the six comparison predicates reach the handler by name, floating point and integer alike" {
  let seen = {
    let log = logged(() => {
      let a = param(F64, 0)
      let i = block_id(0)
      let x = load(a, tile_at(i, 8), [8])
      let ints = arange(8)
      let _c = [eq(x, x), ne(x, x), lt(x, x), le(x, x), gt(x, x), ge(x, x)]
      let _d = [eq_i(ints, ints), ne_i(ints, ints), lt_i(ints, ints), le_i(ints, ints), gt_i(ints, ints), ge_i(ints, ints)]
      ()
    })
    list.filter(log, l => str.starts_with(l, "cmp"))
  }
  assert seen == [
    "cmpf eq f64 [8] 1 1", "cmpf ne f64 [8] 1 1", "cmpf lt f64 [8] 1 1",
    "cmpf le f64 [8] 1 1", "cmpf gt f64 [8] 1 1", "cmpf ge f64 [8] 1 1",
    "cmpi eq [8] 4 4", "cmpi ne [8] 4 4", "cmpi lt [8] 4 4",
    "cmpi le [8] 4 4", "cmpi gt [8] 4 4", "cmpi ge [8] 4 4"
  ]
}

test "a constant takes no shape: every one reaches the handler at rank 0" {
  let seen = logged(() => {
    let _a = f_const(F64, 0.5)
    let _b = i_const(12)
    let _c = bool_const(true)
    let _d = bool_const(false)
    let _e = consti(I64, 7)
    let _f = arange(8)
    ()
  })
  assert seen == ["constf f64 [] 0.5", "consti i32 [] 12", "consti i1 [] 1", "consti i1 [] 0", "consti i64 [] 7", "iota 8"]
}

test "an element-wise operation over a rank-0 operand and a wider one declares the wider shape, whichever side it is on" {
  let seen = logged(() => {
    let a = param(F64, 0)
    let x = load(a, idx_const(0), [4, 8])
    let half = f_const(F64, 0.5)
    let _l = mul(half, x)
    let _r = mul(x, half)
    let _s = select(lt(x, half), half, f_const(F64, 1.0))
    ()
  })
  assert list.filter(seen, l => str.starts_with(l, "binaryf") || str.starts_with(l, "select") || str.starts_with(l, "cmpf")) == [
    "binaryf mulf f64 [4, 8] 2 1",
    "binaryf mulf f64 [4, 8] 1 2",
    "cmpf lt f64 [4, 8] 1 2",
    "select f64 [4, 8] 9 2 2"
  ]
}

test "a matrix product reads m, k and n off its operands" {
  let seen = logged(() => {
    let a = param(F16, 0)
    let x = load(a, idx_const(0), [16, 32])
    let y = load(a, idx_const(0), [32, 8])
    let _c = mma(x, y, f_const(F32, 0.0))
    ()
  })
  # both loads answer 1, and the row of 1 is the last load's: what the
  # surface reads for `a` is therefore [32, 8] here, so this pins the
  # reading order rather than the numbers a real recording would see
  assert list.any(seen, l => str.starts_with(l, "mmaf f16 f32 "))
}

test "the cell writes and the escape hatch hand the handler what they are named with and nothing else" {
  let seen = logged(() => {
    let o = param(F64, 2)
    let t = load(o, idx_const(0), [4, 8])
    store_cell(o, t)
    store_sub(o, [1, 0], t)
    let v = retile(o, [100, 64], [4, 8], pad: PadNegInf)
    let _r = load_view(v, [idx_const(0), idx_const(1)])
    ()
  })
  assert seen == [
    "load 2 f64 12 [4, 8] [8, 1] None None []",
    "cell_view 2 f64 []",
    "store_view f64 87 [] 1",
    "sub_view 2 f64 [4, 8] [1, 0]",
    "store_view f64 91 [1, 0] 1",
    "retile 2 f64 [100, 64] [4, 8] neg_inf",
    "load_view f64 92 [12, 12]"
  ]
}

fn loop_seen() -> (Int, Int, Int, Int, Int) !Dev = {
  let a = param(F64, 0)
  let b = block_id(0)
  let lo = idx_const(0)
  let up = idx_add(b, idx_mul(b, lo))
  let first = load(a, b, [8])
  let acc = carry(first)
  for i in d_range(lo, up, step: By(lo)) { acc.set(add(acc.get(), load(a, i, [8]))) }
  let hb: Int = b
  let hup: Int = up
  let hfirst: Int = first
  let hacc: Int = acc.get()
  let hlo: Int = lo
  (hb, hlo, hup, hfirst, hacc)
}

test "a loop's induction variable, carried handle and result are the handles the operations answered" {
  # block_id 100, const 101, mul 102, add 103, load 104, then loop_begin
  # takes 105 (iv) and 106 (the carried tile), the body's load 107 and
  # addf 108, and loop_end answers 109 for the tile after the loop.
  assert under_counter(loop_seen) == (100, 101, 103, 104, 109)
}

test "d_range hands the body the carried handle and passes its answer back as the continue value" {
  let seen = {
    with handle Dev {
      var log: List[String] = []
      var carries: List[Int] = []
      var sets: List[Int] = []
      var snaps: List[(List[String], List[Int], List[Int])] = []
      t_call_enter(_name) => ()
      t_call_exit() => ()
      t_body_enter() => ()
      t_body_exit() => ()
      t_block_id(_axis) => 0
      t_load(_param, _dtype, _base, _shape, _strides, _mask, _pad, _hints) => 1
      t_store(_param, _dtype, _base, _shape, _strides, _v, _mask, _hints) => ()
      t_gather(_param, _dtype, _index, _shape, _mask, _pad) => 1
      t_scatter(_param, _dtype, _index, _shape, _v, _mask) => ()
      t_atomic_rmw(_param, _dtype, _mode, _index, _shape, _v, _mask) => 1
      t_atomic_cas(_param, _dtype, _index, _shape, _cmp, _v, _mask) => 1
      t_constf(_dtype, _shape, _value) => 2
      t_consti(_dtype, _shape, _value) => 3
      t_iota(_n) => 4
      t_lanes(_base, _shape, _strides) => 5
      t_unaryf(_op, _dtype, _shape, _a) => 6
      t_binaryf(op, _dtype, _shape, a, b) => {
        log = log ++ ["${op} ${a} ${b}"]
        2
      }
      t_fma(_dtype, _shape, _a, _b, _c) => 7
      t_mmaf(_dtype, _acc, _m, _k, _n, _a, _b, _c) => 17
      t_mmai(_m, _k, _n, _a, _b, _c) => 18
      t_cmpf(_pred, _dtype, _shape, _a, _b) => 8
      t_cmpi(_pred, _shape, _a, _b) => 9
      t_unaryi(_op, _dtype, _shape, _a) => 11
      t_binaryi(_op, _dtype, _shape, _a, _b) => 12
      t_convert(_op, _from, _to, _shape, _a) => 13
      t_repack(_op, _from, _to, _shape, _a) => 14
      t_select(_dtype, _shape, _cond, _a, _b) => 10
      t_idx_const(value) => value + 10
      t_idx_add(_a, _b) => 4
      t_idx_mul(_a, _b) => 5
      t_loop_begin(lower, upper, step, _unsigned, inits) => {
        log = log ++ ["loop_begin ${lower} ${upper} ${step} ${show(inits)}"]
        (30, [31])
      }
      t_loop_end(outs) => {
        log = log ++ ["loop_end ${show(outs)}"]
        [40]
      }
      t_while_begin(inits) => {
        log = log ++ ["while_begin ${show(inits)}"]
        [32]
      }
      t_while_end(cond, outs) => {
        log = log ++ ["while_end ${cond} ${show(outs)}"]
        [41]
      }
      t_return_if(cond) => {
        log = log ++ ["return_if ${cond}"]
      }
      t_spread(_dtype, _shape, _src) => 16
      t_reduce_begin(_dim, _shape, _identities, operands) => list.map(range(0, 2 * len(operands)), k => 20 + k)
      t_reduce_end(yields) => list.map(range(0, len(yields)), k => 30 + k)
      t_scan_begin(_dim, _reverse, _shape, _identities, operands) => list.map(range(0, 2 * len(operands)), k => 20 + k)
      t_scan_end(yields) => list.map(range(0, len(yields)), k => 30 + k)
      t_if_begin(_cond) => ()
      t_if_else(_yields) => ()
      t_if_end(yields) => list.map(range(0, len(yields)), k => 40 + k)
      t_extract(_dtype, _from, _to, _src, _indices) => 50
      t_insert(_dtype, _sub, _whole, _src, _dst, _indices) => 54
      t_powi(_dtype, _exp_dtype, _shape, _a, _n) => 55
      t_cat(_dtype, _dim, _lhs_shape, _rhs_shape, _lhs, _rhs) => 51
      t_permute(_dtype, _shape, _perm, _src) => 52
      t_num_blocks(_axis) => 53
      t_extent_of(_param, _dim, _blocks) => 53
      t_carry_new(init) => {
        carries = carries ++ [init]
        sets = sets ++ [0]
        len(carries) - 1
      }
      t_carry_get(c) => carries[c]
      t_carry_set(c, h) => {
        let was = carries
        let n = sets
        carries = list.map(range(0, len(was)), k => if k == c { h } else { was[k] })
        sets = list.map(range(0, len(n)), k => if k == c { n[k] + 1 } else { n[k] })
      }
      t_trial_begin() => {
        snaps = snaps ++ [(log, carries, sets)]
      }
      t_trial_end() => {
        let (l0, c0, s0) = snaps[len(snaps) - 1]
        let n = sets
        let changed = list.filter(range(0, len(c0)), k => n[k] != s0[k])
        snaps = list.take(snaps, len(snaps) - 1)
        log = l0
        carries = c0
        sets = s0
        changed
      }
      t_tok_get() => 60
      t_shape_of(_h) => ("f64", [])
      t_tok_set(_tok) => ()
      t_tok_join(_toks) => 61
      t_ptrs(_param, _dtype, _shape) => 70
      t_ptr_offset(_dtype, _shape, _ptrs, _offs) => 71
      t_ptr_to_int(_dtype, _shape, _ptrs) => 72
      t_int_to_ptr(_dtype, _shape, _ints) => 73
      t_ptr_to_ptr(_from, _to, _shape, _ptrs) => 74
      t_load_ptrs(_dtype, _shape, _ptrs, _mask, _pad) => 75
      t_assert(_shape, _cond, _message) => ()
      t_assume(_pred, _dtype, _shape, _src) => 76
      t_print(_fmt, _dtype, _shape, _args) => ()
      t_store_ptrs(_dtype, _shape, _ptrs, _value, _mask) => ()
      t_global(_sym, _dtype, _values, _align, _is_private, _constant) => ()
      t_get_global(_sym, _dtype, _shape) => 77
      t_alloca(_dtype, _num_elem, _align, _shared, _shape) => 78
      t_mmaf_scaled(_dtype, _scale, _dims, _a, _b, _c, _sa, _sb) => 79
      t_tensor_view(_param, _dtype, _base, _shape, _strides, _dyn_shape, _dyn_strides) => 80
      t_partition_view(_dtype, _view, _tile_shape, _dim_map, _padding) => 81
      t_strided_view(_dtype, _view, _tile_shape, _traversal, _dim_map, _padding) => 85
      t_gather_view(_dtype, _view, _tile_shape, _sparse_dim, _padding) => 86
      t_atomic_red_view(_dtype, _view, _indices, _mode, _scope, _value) => ()
      t_load_view(_dtype, _view, _indices) => 82
      t_store_view(_dtype, _view, _indices, _value) => ()
      t_tensor_shape(_view, _dim) => 83
      t_index_space_shape(_view, _dim) => 84
      t_cell_view(_param, _dtype, free) => (87, free)
      t_cell_fill(_param, _value) => 88
      t_sub_view(_param, _dtype, _sub, at) => (91, at)
      t_retile(_param, _dtype, _extent, _tile, _pad) => 92
      t_reshape(_dtype, _from, _to, _src) => 89
      t_broadcast(_dtype, _from, _to, _src) => 90
    }
    let _r = loop_seen()
    log
  }
  assert seen == ["loop_begin 10 4 10 [1]", "addf 31 1", "loop_end [2]"]
}

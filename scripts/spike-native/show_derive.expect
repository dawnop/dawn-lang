-- scalars --
42
-7
true
false
1.5
already a string
-- derived ADTs --
Point(1, 2)
Circle(3)
Rect(2, 5)
Origin
Rec { name: "o", at: Point(0, 0) }
-- a nested String is quoted; a top-level one is not --
Rec { name: "has \"quotes\", a \\, a \n and a \t", at: Point(1, 1) }
-- a type parameter passes through --
Boxed(7)
Boxed("s")
Boxed(Point(4, 5))
Boxed(Boxed(Boxed(1)))
Pair { l: Point(1, 2), r: "x" }
-- the prelude ADTs --
Some(3)
None
Some(Point(1, 2))
Ok(1)
Err("no")
-- tuples, which have no head to name an impl --
(1, "two")
(Point(0, 0), true, 2.5)
-- interpolation is the same operation --
point=Point(6, 7) n=8 flag=true

# A builtin taken as a function value is the same function as the builtin
# called directly (issue #283).
#
# `lower.lift_fn_value` used to write the wrapper's body as the bare intrinsic,
# skipping the rewrites a direct call goes through. `parse_int` and
# `parse_int_radix` then reached both emitters as names no backend implements
# (lowering always routes them to std/fmt) and the compile panicked, while
# `parse_float` reached the host's grammar with std/fmt's §11 scanner out of
# the way: `f("1.5d")` answered `Some(1.5)` where `parse_float("1.5d")` answers
# `None`. Each line below prints the direct call and the call through a value
# side by side, so a wrapper that disagrees shows up as a line that does not.
#
# The `const` section is the other half of the same confusion (#185): the
# builtins mirror marked `parse_int_radix` as refused in a `const`, but every
# numeric parser folds, through std/fmt's Core like any other call. Each const
# is printed beside the same call made at run time.
#
# Since K19 `parse_int` is no builtin: it is std/fmt's prelude function with a
# defaulted radix, and `parse_int_radix` is gone into it. Taken as a value it
# is the whole two-parameter function (a value carries no defaults, spec 3.1),
# so the value is called with the radix written out -- ten for the decimal
# lines, which is what the omitted argument means at a direct call.

use std/list

const C_INT: Option[Int] = parse_int("42")

const C_RADIX: Option[Int] = parse_int("ff", radix: 16)

const C_FLOAT: Option[Float] = parse_float("1.5d")

const C_FLOAT_OK: Option[Float] = parse_float("2.5e1")

fn show_both[T: Show](direct: T, through: T) -> String = "${direct} ${through}"

pub fn main() -> Unit !io = {
  let pi = parse_int
  let pf = parse_float
  println("-- parse_int --")
  for s in ["42", "-7", " 12 ", "1_000", "0x10", "", "x"] {
    println(show_both(parse_int(s), pi(s, 10)))
  }
  println("-- parse_int with a radix --")
  println(show_both(parse_int("ff", radix: 16), pi("ff", 16)))
  println(show_both(parse_int("-101", radix: 2), pi("-101", 2)))
  println(show_both(parse_int("z", radix: 10), pi("z", 10)))
  println("-- parse_float --")
  for s in ["1.5", "-0.25e2", "1.5d", "1.5f", "0x1p3", "inf", "Infinity", "NaN", ""] {
    println(show_both(parse_float(s), pf(s)))
  }
  println("-- in a const --")
  println(show_both(C_INT, parse_int("42")))
  println(show_both(C_RADIX, parse_int("ff", radix: 16)))
  println(show_both(C_FLOAT, parse_float("1.5d")))
  println(show_both(C_FLOAT_OK, parse_float("2.5e1")))
  println("-- through a higher-order call --")
  println("${list.map(["3", "4.5", "4.5d"], pf)}")
  let sorted: fn(List[Int], fn(Int, Int) -> Int) -> List[Int] = sort_by
  println("${sorted([3, 1, 2], (a, b) => a - b)}")
}

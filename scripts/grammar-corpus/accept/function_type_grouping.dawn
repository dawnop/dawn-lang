# A grouped type is erased from the AST, but it gives an outer function's
# suffix effect an unambiguous boundary around a returned function type.

alias Grouped = (Int)
alias OuterIo = fn() -> (fn() -> Int) !io
alias InnerIo = fn() -> fn() -> Int !io
alias BothIo = fn() -> (fn() -> Int !io) !io

fn preserve_group(x: (Int)) -> (Int) = x

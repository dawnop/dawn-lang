# EBNF expr and postfix forms: pipeline, match with guard, block, if/else,
# indexing, propagation, unwrap, interpolation, lambda, general application and
# named arguments. The last two are what the EBNF always described and the
# parser grew into: application became a postfix on 2026-07-30, and the
# `arg = [ IDENT ":" ] expr` production became true when the call special cases
# went (SYN-02/SYN-03). Names are grammatical at every call position here --
# that only a constructor *accepts* them is a type rule, and this corpus only
# parses.
use std/list

type Rect = { w: Float, h: Float }

fn add(a: Int) -> fn(Int) -> Int = fn(b) => a + b

fn classify(n: Int) -> String =
  match n {
    0 -> "zero"
    k if k < 0 -> "negative"
    _ -> "positive"
  }

fn pipeline(xs: List[Int]) -> Int =
  xs |> map(fn(x) => x * 2) |> fold(0, fn(a, x) => a + x)

fn postfixes(xs: List[Int], o: Option[Int]) -> Int = {
  let head = xs[0]
  let un = o!
  let applied = add(1)(2)
  head + un + applied
}

fn named_args(r: Rect, xs: List[Int]) -> Rect = {
  let ctor = Rect(w: 1.0, h: 2.0)
  let mixed = Rect(1.0, h: 2.0)
  let on_a_function = add(a: 1)(2)
  let on_a_dot_call = xs.at(i: 0)
  let on_an_applied_result = add(1)(b: 2)
  ctor
}

fn propagates(r: Result[Int, String]) -> Result[Int, String] = Ok(r? + 1)

fn interpolated(n: Int) -> String = "n=$n and ${n * 2}"

fn blocks(n: Int) -> Int = {
  var acc = 0
  var i = 0
  while i < n {
    acc = acc + i
    i = i + 1
  }
  for k in 0..3 {
    acc = acc + k
  }
  if acc > 0 { acc } else { 0 - acc }
}

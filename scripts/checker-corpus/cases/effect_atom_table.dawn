# An effect atom is classified by tables, not by its spelling
# (docs/effects-window-design.md 2). `String`, `T` and `Missing` are spelled
# alike -- one uppercase word each -- and only a lookup can say that the first
# is a builtin type, the second a type parameter in scope, and the third
# nothing at all. The golden pins the three different sentences; a resolver
# that went back to reading the first letter would print "unknown effect"
# three times.
type Point = { x: Int, y: Int }

fn builtin_row() -> Int !String = 1

fn param_row[T](x: T) -> T !T = x

fn declared_type_row() -> Int !Point = 2

fn nothing_row() -> Int !Missing = 3

# accepted: `io` is found in the ambient table, and `e` is introduced by
# appearing, which is what a lowercase name no table knows means
fn ambient_row(f: fn() -> Int !e) -> Int !io !e = f()

pub fn main() -> Unit !io = ()

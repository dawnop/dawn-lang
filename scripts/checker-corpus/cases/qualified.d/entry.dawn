# checker.dawn: `m.name` in type, value, call and pattern position
use lib as lib
use std/list as sl

pub fn priv_type(x: lib.Hidden) -> Int = 1

pub fn no_type(x: lib.Nope) -> Int = 1

pub fn no_alias_type(x: nomod.T) -> Int = 1

pub fn priv_fn() -> Int = lib.secret()

pub fn no_fn() -> Int = lib.nosuch()

pub fn not_a_type() -> Int = lib.Shown()

pub fn not_a_const() -> Int = lib.OPEN()

pub fn std_no_fn() -> Int = sl.nosuchfn([1])

pub fn no_alias_fn() -> Int = nomod.g()

pub fn priv_ctor(x: Int) -> Int =
  match x {
    lib.Invis -> 1
    _ -> 2
  }

pub fn no_ctor(x: Int) -> Int =
  match x {
    lib.Nope -> 1
    _ -> 2
  }

pub fn no_alias_pat(x: Int) -> Int =
  match x {
    nomod.Ctor -> 1
    _ -> 2
  }

# Execution counts prove actual reuse; same-version cold comparison separately
# guards output assembly. Full structural comparison lives in the private oracle.
#
# A module of the compiler package because checker state is `pub(pkg)`; it
# moved here from scripts/incremental-semantics-contract/src. Nothing in
# main.dawn or nmain.dawn imports contract/, so `dawn test selfhost` runs it
# and neither driver links it.
#
# The file keeps its name from when a session reused only an unchanged prefix
# of modules. It now holds the one rule that replaced that
# (docs/lsp-module-memo-design.md): a step is reused when its input and the
# carry it enters with are unchanged. Every test compares the session's
# Program with a cold analysis of the same input, positions included, so a
# reuse the rule does not license shows up as a difference, and asserts the
# counts, so a reuse the rule does license and the session skipped shows up
# too.

use std/io
use std/io.{Fs, Env}
use std/map
use driver/incremental
use driver/analyze.{LoadedModule, LoadResult, LocDiag, Program, analyze_program, rendered_diags}
use driver/stdlib.{StdCtx, load_std, std_load_error_text}
use driver/checkdump
use check/jsig.{jsig_refused}
use ir/interp.{ct_default}
use front/parser
use jvm/jreflect.{jsig_real}
use compiler_plan/envmem

fn source(name: String, text: String) -> LoadedModule = {
  let (m, pdiags) = parser.parse_module(text)
  LoadedModule {
    mod_path: name, class_name: name, path: name ++ ".dawn",
    text: text, m: m, pdiags: pdiags, pkg: None, entry: false
  }
}

fn std_ctx() -> StdCtx !Fs !Env !io =
  match load_std("std") {
    Ok(s) -> s
    Err(e) -> panic(std_load_error_text(e))
  }

## The session's Program is the cold one: the same modules, diagnostics,
## declaration views and rendered positions.
fn agrees_with_cold(prog: Program, input: LoadResult, std: StdCtx) -> Bool !Env !io = {
  let cold = analyze_program(input, std, ct_default(), jsig_refused())
  checkdump.render(prog) == checkdump.render(cold) && prog.diags == cold.diags &&
    prog.decl_spans == cold.decl_spans && map.keys(prog.decl_spans) == map.keys(cold.decl_spans) &&
    rendered_diags(prog) == rendered_diags(cold)
}

test "module memo reuses a step whose input and entering carry are unchanged" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let a = source("a", "pub type Box = { n: Int }\npub fn make() -> Box = Box { n: 1 }\n")
    let b = source("b", "pub type Other = { n: Int }\n")
    let c = source("c", "use a.{Box}\npub fn value() -> Box = Box { n: 1 }\n")
    let d = source("d", "pub fn extra() -> Int = 4\n")
    let loaded = LoadResult { modules: [a, b, c], diags: [] }
    let fresh = incremental.new(std, ct_default(), jsig_refused(), 10)
    let first = incremental.analyze(fresh, loaded)
    assert first.stats.reused_modules == 0
    assert first.stats.checked_modules == 3
    assert first.stats.retained_modules == 3
    let warm = incremental.analyze(first.session, loaded)
    assert warm.stats.reused_modules == 3
    assert warm.stats.checked_modules == 0
    assert warm.stats.comptime_modules == 0
    let edited_c = source("c", "use a.{Box}\npub fn value() -> Box = Box { n: 2 }\n")
    let body = source("a", "pub type Box = { n: Int }\npub fn make() -> Box = Box { n: 2 }\n")
    let signature = source("a", "pub type Box = { n: Int }\npub fn make() -> Int = 2\n")
    let moved = source("a", "# moved\n\n" ++ a.text)
    let edits = [
      # the edited module alone
      LoadResult { modules: [a, b, edited_c], diags: [] },
      # c enters with a carry that no longer holds b
      LoadResult { modules: [a, c], diags: [] },
      # every module enters with a carry it has not entered with before
      LoadResult { modules: [b, a, c], diags: [] },
      LoadResult { modules: [a, b, c, d], diags: [] },
      LoadResult { modules: [], diags: [] },
      # a body edit leaves a's exports as they were: b and c keep their steps
      LoadResult { modules: [body, b, c], diags: [] },
      # a signature edit does not
      LoadResult { modules: [signature, b, c], diags: [] },
      # nor does moving every declaration of a, as far as its exports go; the
      # positions it moved are the session's to put right
      LoadResult { modules: [moved, b, c], diags: [] }
    ]
    let expected_hits = [2, 1, 0, 3, 0, 2, 0, 2]
    var i = 0
    for input in edits {
      let result = incremental.analyze(warm.session, input)
      assert result.stats.reused_modules == expected_hits[i]
      assert result.stats.checked_modules == len(input.modules) - expected_hits[i]
      assert agrees_with_cold(result.program, input, std)
      i = i + 1
    }
    # Same raw text but a different loader-rewritten AST must invalidate.
    let rewritten = LoadedModule { ..c, m: edited_c.m }
    let rewrite = incremental.analyze(warm.session, LoadResult { modules: [a, b, rewritten], diags: [] })
    assert rewrite.stats.reused_modules == 2
    assert rewrite.stats.checked_modules == 1
  }))
}

test "module memo places a reused module's diagnostics and its predecessors' where they are now" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    # both modules carry a diagnostic inside a declaration, so both are
    # rendered through the Program's view of where their declarations sit
    let lib_text = "pub fn ok() -> Int = 1\n\npub fn bad() -> Int = false\n"
    let lib = source("lib", lib_text)
    let app = source("app", "use lib\npub fn use_it() -> Int = lib.ok()\n\npub fn worse() -> Bool = 1\n")
    let loaded = LoadResult { modules: [lib, app], diags: [] }
    let warm = incremental.analyze(incremental.new(std, ct_default(), jsig_refused(), 10), loaded)
    assert len(warm.program.diags) == 2
    # lines above lib's declarations, and no change to its signatures: lib is
    # checked again, app is not, and both diagnostics land where the text now
    # puts them
    let moved = source("lib", "# three\n# more\n# lines\n" ++ lib_text)
    let input = LoadResult { modules: [moved, app], diags: [] }
    let result = incremental.analyze(warm.session, input)
    assert result.stats.reused_modules == 1
    assert result.stats.checked_modules == 1
    assert agrees_with_cold(result.program, input, std)
    let cold = analyze_program(loaded, std, ct_default(), jsig_refused())
    assert rendered_diags(result.program) != rendered_diags(cold)
  }))
}

test "module memo compares what a module exports in order, not only as a set" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let lib = source("lib", "pub fn first() -> Int = 1\npub fn second() -> Int = 2\n")
    let app = source("app", "use lib\npub fn total() -> Int = lib.first() + lib.second()\n")
    let owner = incremental.new(std, ct_default(), jsig_refused(), 10)
    let warm = incremental.analyze(owner, LoadResult { modules: [lib, app], diags: [] })
    # the same two functions the other way round: equal as a set, and still a
    # different input to an importer that walks them
    let swapped = source("lib", "pub fn second() -> Int = 2\npub fn first() -> Int = 1\n")
    let input = LoadResult { modules: [swapped, app], diags: [] }
    let result = incremental.analyze(warm.session, input)
    assert result.stats.reused_modules == 0
    assert result.stats.checked_modules == 2
    assert agrees_with_cold(result.program, input, std)
    # two imports the other way round: lib declares the same things in the
    # same order, and the type tables it passes on hold them in another
    let p = source("p", "pub type P = { n: Int }\n")
    let q = source("q", "pub type Q = { n: Int }\n")
    let body = "pub fn make() -> Int = 1\n"
    let user = source("user", "use lib\npub fn made() -> Int = lib.make()\n")
    let forward = LoadResult { modules: [p, q, source("lib", "use p.{P}\nuse q.{Q}\n" ++ body), user], diags: [] }
    let backward = LoadResult { modules: [p, q, source("lib", "use q.{Q}\nuse p.{P}\n" ++ body), user], diags: [] }
    let before = incremental.analyze(owner, forward)
    let after = incremental.analyze(before.session, backward)
    assert after.stats.reused_modules == 2
    assert after.stats.checked_modules == 2
    assert agrees_with_cold(after.program, backward, std)
  }))
}

test "module memo keeps an importer's step across an edit above a pub alias" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let text = "pub alias Pair = (Int, Int)\npub opaque type Meters = Int\n" ++
      "pub fn two() -> Pair = (1, 2)\npub fn meters(n: Int) -> Meters = n\n"
    let lib = source("lib", text)
    let app = source("app", "use lib.{Pair, Meters, two, meters}\npub fn get() -> Pair = two()\n" ++
        "pub fn far() -> Meters = meters(3)\n")
    let warm = incremental.analyze(incremental.new(std, ct_default(), jsig_refused(), 10),
      LoadResult { modules: [lib, app], diags: [] })
    assert len(warm.program.diags) == 0
    let input = LoadResult { modules: [source("lib", "# moved\n" ++ text), app], diags: [] }
    let result = incremental.analyze(warm.session, input)
    assert result.stats.reused_modules == 1
    assert result.stats.checked_modules == 1
    assert agrees_with_cold(result.program, input, std)
  }))
}

test "module memo reuses modules with diagnostics and bounds what it keeps" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let a = source("a", "pub fn answer() -> Int = 42\n")
    let b = source("b", "pub fn other() -> Int = 1\n")
    let loaded = LoadResult { modules: [a, b], diags: [] }
    let fresh = incremental.new(std, ct_default(), jsig_refused(), 10)
    let warm = incremental.analyze(fresh, loaded)
    # a loader diagnostic is not an input of any step
    let broken = source("broken", "pub fn (\n")
    let loader = LocDiag { path: "loader", d: broken.pdiags[0] }
    let failed_input = LoadResult { modules: [a, b], diags: [loader] }
    let failed = incremental.analyze(warm.session, failed_input)
    assert failed.stats.reused_modules == 2
    assert failed.program.diags[0] == loader
    assert agrees_with_cold(failed.program, failed_input, std)
    # nor is a module's own diagnostic a reason to check it again
    let bad = source("bad", "pub fn bad() -> Int = false\n")
    let input = LoadResult { modules: [a, bad, b, broken], diags: [] }
    let recovered = incremental.analyze(warm.session, input)
    assert recovered.stats.reused_modules == 1
    assert recovered.stats.retained_modules == 4
    let again = incremental.analyze(recovered.session, input)
    assert again.stats.reused_modules == 4
    assert again.stats.checked_modules == 0
    assert agrees_with_cold(again.program, input, std)
    let evicted = incremental.analyze(incremental.evict(warm.session), loaded)
    assert evicted.stats.reused_modules == 0
    assert evicted.stats.checked_modules == 2
    let disabled = incremental.disable_reuse(warm.session)
    let cold_owner = incremental.analyze(disabled, loaded)
    assert cold_owner.stats.reused_modules == 0
    assert cold_owner.stats.retained_modules == 0
    assert incremental.analyze(cold_owner.session, loaded).stats.reused_modules == 0
    let bounded = incremental.new(std, ct_default(), jsig_refused(), 1)
    let one = incremental.analyze(bounded, loaded)
    assert one.stats.retained_modules == 1
    assert incremental.analyze(one.session, loaded).stats.reused_modules == 1
    let none = incremental.new(std, ct_default(), jsig_refused(), 0)
    assert incremental.analyze(none, loaded).stats.retained_modules == 0
  }))
}

test "module memo reuses modules that asked the Java oracle" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let pure = source("pure", "pub fn answer() -> Int = 42\n")
    let producer = source("producer",
      "use java \"java.util.ArrayList\"\npub fn items() -> ArrayList !io = ArrayList.new()\n")
    let consumer = source("consumer",
      "use producer\npub fn count() -> Int !io = producer.items().size()\n")
    let loaded = LoadResult { modules: [pure, producer, consumer], diags: [] }
    # the oracle is the owner's for its whole life: a host rebuilds the owner
    # whenever it replaces the lease the oracle answers from
    let js = jsig_real()
    let first = incremental.analyze(incremental.new(std, ct_default(), js, 10), loaded)
    assert len(first.program.diags) == 0
    assert first.stats.retained_modules == 3
    let warm = incremental.analyze(first.session, loaded)
    assert len(warm.program.diags) == 0
    assert warm.stats.reused_modules == 3
    assert warm.stats.checked_modules == 0
    assert checkdump.render(warm.program) == checkdump.render(analyze_program(loaded, std, ct_default(), js))
  }))
}

test "module memo rechecks std identity and refuses a negative bound" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_ctx()
    let raw = source("pretend", "pub fn answer() -> Int = 42\n")
    let input = LoadResult { modules: [LoadedModule { ..raw, path: "std/list.dawn" }], diags: [] }
    let owner = incremental.new(std, ct_default(), jsig_refused(), 10)
    let first = incremental.analyze(owner, input)
    assert len(first.program.diags) == 0
    assert first.stats.retained_modules == 1
    assert first.program.modules[0].class_name == "std/list"
    let (changed, _) = envmem.with_env_table("/different-cwd", [],
      () => incremental.analyze(first.session, input))
    assert changed.stats.reused_modules == 0
    assert changed.stats.checked_modules == 1
    assert changed.program.modules[0].class_name == "pretend"
    let result = catch_panic(() => {
      let _ = incremental.new(std, ct_default(), jsig_refused(), -1)
      ()
    })
    match result {
      Err(_) -> ()
      Ok(_) -> { assert false }
    }
  }))
}

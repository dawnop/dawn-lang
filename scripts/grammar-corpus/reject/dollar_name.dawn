# expect: `$` followed by a name is not an interpolation: `$a`
# expect: `$` followed by a name is not an interpolation: `$obj_x`
# The short interpolation form was removed in the syntax window (spec 1.6).
# `$a.b` used to splice `a` and append ".b", and `$obj_x` took the longest
# name in scope; both are refused rather than read as literal text, so a
# program written the old way cannot print something else. `$5` and a `$`
# before a space or the closing quote stay literal.
fn f(a: String, obj_x: String) -> String = "$a.b $5 $ ${a}" ++ "B:$obj_x$"

# checker.dawn: statement-position checks
pub fn discarded() -> Unit = {
  1 + 1
  ()
}

pub fn assert_outside() -> Unit = {
  assert true
}

pub fn while_cond() -> Unit = {
  while 1 { () }
}

pub fn while_body() -> Unit = {
  while true { 1 }
}

pub fn for_not_range(xs: List[Int]) -> Unit = {
  for x in 1 { () }
}

pub fn for_bounds() -> Unit = {
  for x in "a" .."b" { () }
}

pub fn for_body() -> Unit = {
  for x in 0 ..3 { 1 }
}

test "assert wants a Bool" {
  assert 1
}

test "a trailing value is discarded" {
  1 + 1
}

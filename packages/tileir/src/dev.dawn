## The device side of a kernel: a `Dev` effect whose operations are the tile
## instructions a kernel body issues, and the typed surface over them. A kernel
## body is an ordinary Dawn function of type `fn(...) -> Unit !Dev`; nothing
## here runs it. `prog.trace_kernel` runs it once under a recording handler and
## keeps what it issued as a `TileProg`; `render.render` turns that into Tile IR
## text. The host side (buffers, launch) is std/gpu, which never sees a
## `TileProg`: docs/tile-backend-design.md 5.
#
# The shape is std/gpu's. Effect operations cannot be generic (spec 6.5), so
# the operations traffic in SSA handles (`Int`), dtype names (`String`) and
# operation names (`String`), and the functions below add the phantom-typed
# `Tile[D]` / `Param[D]` and are the only surface a kernel body uses. The
# dtype markers for buffer formats are std/gpu's `F64` / `F32` / `BF16`, so a
# `Param[F64]` and a `Tensor[F64]` agree on what "f64" means without a second
# declaration; `I32` and `I1` are declared here instead, because they are tile
# element formats and not buffer formats: std/gpu's `element_bytes` does not
# know them and a `Tensor[I1]` cannot be allocated.
#
# One effect operation per shape rather than per operation: `t_binaryf` takes
# the operation's name, so adding `subf` is a name in a list rather than a
# tenth operation. The cost is that a misspelled name is a refusal when the
# kernel is recorded (prog.dawn checks the names against a whitelist) instead
# of a type error; the public functions below are the typed surface that
# spells the names, so a kernel body never writes one.
#
# Handles are minted by the handler; a body never invents one. The three
# opaque types below are three kinds of handle a body can hold, and mixing
# them is a type error rather than a malformed program: a `Tile[F32]` in a
# `Tile[F64]` slot, or a host `Int` where an index tile is wanted, are both
# refused by the checker.
use std/list
use std/str
use std/gpu.{Dtype, dtype_name, dtype_bytes, F64, F32}

## A tile value inside a kernel: the SSA handle the handler issued for it.
## `D` is a phantom (spec 2.7): `Tile[F64]` and `Tile[F32]` are two types over
## one representation, so `addf(F64, ..)` over an f32 tile is a type error.
pub opaque type Tile[D] = Int

## A scalar index tile inside a kernel: a block id, or later what is computed
## from one. Distinct from `Tile[D]` (it is `i32` and has no format marker)
## and from a host `Int` (a host number is not an SSA name; `load` wants the
## latter and the checker enforces it).
pub opaque type Idx = Int

## A kernel parameter: its position in the entry signature and its dtype
## name. The phantom `D` is fixed at `param()` and read back as the string,
## so `load` can tell the handler which format it is reading without a
## dictionary the effect could not carry.
pub opaque type Param[D] = (Int, String)

## A RANK-0 tile inside a kernel: `tile<f64>`, not `tile<128xf64>`. What a
## reduction answers, what its region folds over, and what an `if`'s
## condition is. Distinct from `Tile[D]` (which is rank 1 here) because the
## two are not interchangeable in Tile IR: `if` wants a rank-0 `i1` and
## refuses a rank-1 one (measured), and a store wants a tile as wide as its
## pointers. `spread` is the one way across.
##
## Distinct from `Idx` as well, though both are rank-0 `i32` at the machine
## level: `Idx` is a scalar index (a block id, a loop bound) and
## `Scalar[I32]` is a reduction's accumulator over an index tile. Nothing
## converts between them implicitly.
pub opaque type Scalar[D] = Int

## The identity of one operand of a reduction: what a fold that has seen
## nothing starts from, in that operand's tile format. `reduce` carries one
## per operand.
##
## Its FORMAT is checked outside this repository (`tileiras` refuses an f32
## identity for an f64 operand, measured) and its VALUE is not: a sum whose
## identity is 1.0 assembles into a cubin. So the value is a layer-2 claim
## and nothing else, which is what scripts/tile-gpu-diff's
## reduce-identity-wrong mutant is for.
pub type RedId =
  | IdF(dtype: String, value: Float)
  | IdI(dtype: String, value: Int)
derive Show

## The 32-bit signed integer tile format: what `arange` and `lanes` answer and
## what an integer comparison reads. A tile element format, not a buffer
## format: there is no `Tensor[I32]` in this release.
pub type I32 = | I32

## The one-bit tile format: what a comparison answers and what a mask is. A
## tile element format, not a buffer format.
pub type I1 = | I1

impl Dtype[I32] {
  fn dtype_name(d: I32) -> String = "i32"
  fn dtype_bytes(d: I32) -> Int = 4
}

impl Dtype[I1] {
  fn dtype_name(d: I1) -> String = "i1"
  fn dtype_bytes(d: I1) -> Int = 1
}

## The device, as operations a recording handler answers. Names carry a `t_`
## prefix for the reason std/gpu's carry `gpu_`: `use tileir/dev.{Dev}` brings
## every operation into the importing module's namespace (spec 6.5).
##
## `t_block_id` answers the handle of the block index along `axis` (0, 1, 2).
## `t_load` answers the handle of an `n`-wide tile of `dtype` read from
## parameter `param` at element offset `idx * n`; `t_store` writes one there.
## Both take an optional `mask` (an `n`-wide `i1` tile: a lane whose mask bit
## is 0 is not read and not written), and `t_load` an optional `pad` (an
## `n`-wide tile of `dtype`: what a masked-off lane reads instead). `None` for
## both is the unmasked memory operation of the earlier releases, which is
## what `load` and `store` still issue.
##
## `t_constf` / `t_consti` answer an `n`-wide tile every lane of which holds
## the given host constant; `t_iota` the `n`-wide i32 tile `[0, 1, .., n-1]`;
## `t_lanes` the `n`-wide i32 tile of the ELEMENT indices block `idx` covers,
## which is `idx * n + iota` and is the same tile the pointer arithmetic of a
## load at `idx` is built from.
##
## `t_unaryf(op, ..)` / `t_binaryf(op, ..)` / `t_fma` are the element-wise
## floating-point arithmetic: `op` is one of `negf` / `absf` for the unary
## form and `addf` / `subf` / `mulf` / `divf` / `maxf` / `minf` for the binary
## one. `t_cmpf(pred, ..)` / `t_cmpi(pred, ..)` answer an `n`-wide `i1` tile,
## `pred` being one of `eq` / `ne` / `lt` / `le` / `gt` / `ge`; a float
## comparison is ORDERED, so every predicate answers 0 on a NaN operand.
## `t_select` takes an `i1` tile and two `dtype` tiles and answers the second
## where the condition is 1 and the third where it is 0.
##
## `t_idx_const` / `t_idx_add` / `t_idx_mul` answer scalar i32 handles: a
## host constant, and the sum and product of two index handles.
##
## `t_loop_begin` / `t_loop_end` bracket a region (tile-backend-design 5.2).
## `t_loop_begin(lower, upper, step, inits)` opens a `for` over the index
## handles `[lower, upper)` by `step`, with `inits` as the loop-carried
## values entering it, and answers the induction variable's handle and one
## handle per carried value as the body sees them; the operations issued
## until the matching `t_loop_end` fall inside the region. `t_loop_end(outs)`
## closes it with `outs` as the values the body hands to the next iteration
## (one per carried value, in order) and answers one handle per carried
## value as they stand after the loop. The handler carries the memory
## ordering token through the loop on its own; a body never sees it. Only
## `d_for` and `d_for2` call the pair; a body calls those.
##
## `n` is a tile width, a power of two, EXCEPT that 0 means the rank-0 tile
## (`tile<f64>`): the shape a reduction answers and an `if` branches on. The
## typed surface spells rank 0 as `Scalar[D]` and passes the 0 itself, so a
## kernel body never writes it.
##
## `t_spread(dtype, n, src)` widens a rank-0 tile to `n` lanes, every lane
## the same value: a `reshape` to one lane and a `broadcast` to `n`.
##
## `t_reduce_begin` / `t_reduce_end` and `t_if_begin` / `t_if_else` /
## `t_if_end` bracket a region the way the loop pair does.
## `t_reduce_begin(dim, n, identities, operands)` opens a reduction of the
## `n`-wide tiles `operands` along `dim`, one identity per operand in the
## same order, and answers TWO rank-0 handles per operand as the body sees
## them: for operand `i`, the element at `2 * i` and the accumulator at
## `2 * i + 1`, which is the order the dialect's region takes them in.
## `t_reduce_end(yields)` closes it with the new accumulator of each operand
## and answers one rank-0 result per operand.
## `t_if_begin(cond)` opens the then-region of an `if` over the rank-0 `i1`
## handle `cond`; `t_if_else(yields)` closes it with what it yields and
## opens the else-region; `t_if_end(yields)` closes that one and answers one
## handle per yielded value. The plan's sketch put no arguments on
## `t_if_else`; the then-region's yields have to reach the record somewhere,
## and this is the only operation of the bracket that can carry them.
##
## A load or a store inside a reduction or an `if` is REFUSED: the dialect
## requires a reduction's body to be pure, and neither region carries the
## memory ordering token, so a memory operation inside one would have no
## order at all.
pub effect Dev {
  fn t_block_id(axis: Int) -> Int
  fn t_load(param: Int, dtype: String, idx: Int, n: Int, mask: Option[Int], pad: Option[Int]) -> Int
  fn t_store(param: Int, dtype: String, idx: Int, n: Int, v: Int, mask: Option[Int]) -> Unit
  fn t_constf(dtype: String, n: Int, value: Float) -> Int
  fn t_consti(dtype: String, n: Int, value: Int) -> Int
  fn t_iota(n: Int) -> Int
  fn t_lanes(idx: Int, n: Int) -> Int
  fn t_unaryf(op: String, dtype: String, n: Int, a: Int) -> Int
  fn t_binaryf(op: String, dtype: String, n: Int, a: Int, b: Int) -> Int
  fn t_fma(dtype: String, n: Int, a: Int, b: Int, c: Int) -> Int
  fn t_cmpf(pred: String, dtype: String, n: Int, a: Int, b: Int) -> Int
  fn t_cmpi(pred: String, n: Int, a: Int, b: Int) -> Int
  fn t_select(dtype: String, n: Int, cond: Int, a: Int, b: Int) -> Int
  fn t_idx_const(value: Int) -> Int
  fn t_idx_add(a: Int, b: Int) -> Int
  fn t_idx_mul(a: Int, b: Int) -> Int
  fn t_loop_begin(lower: Int, upper: Int, step: Int, inits: List[Int]) -> (Int, List[Int])
  fn t_loop_end(outs: List[Int]) -> List[Int]
  fn t_spread(dtype: String, n: Int, src: Int) -> Int
  fn t_reduce_begin(dim: Int, n: Int, identities: List[RedId], operands: List[Int]) -> List[Int]
  fn t_reduce_end(yields: List[Int]) -> List[Int]
  fn t_if_begin(cond: Int) -> Unit
  fn t_if_else(yields: List[Int]) -> Unit
  fn t_if_end(yields: List[Int]) -> List[Int]
}

## Parameter `pos` of the entry, of format `d`. Positions count from zero and
## must agree with the `params` list given to `trace_kernel`; the handler
## refuses a load or store that disagrees.
pub fn param[D: Dtype](d: D, pos: Int) -> Param[D] = {
  let p: Param[D] = (pos, dtype_name(d))
  p
}

## The position `p` was declared at.
pub fn position[D](p: Param[D]) -> Int = {
  let t: (Int, String) = p
  let (pos, _dt) = t
  pos
}

## The dtype name `p` was declared with (`"f64"`, `"f32"`).
pub fn param_dtype[D](p: Param[D]) -> String = {
  let t: (Int, String) = p
  let (_pos, dt) = t
  dt
}

## The block index along `axis`: 0, 1 or 2.
pub fn block_id(axis: Int) -> Idx !Dev = {
  let h: Idx = t_block_id(axis)
  h
}

## The `n`-wide tile of `p`'s format starting at element `idx * n` of `p`.
## Every lane is read, so `p` must hold at least `(idx + 1) * n` elements;
## `load_masked` is the one to use when it does not.
pub fn load[D](p: Param[D], idx: Idx, n: Int) -> Tile[D] !Dev = {
  let i: Int = idx
  let none: Option[Int] = None
  let h: Tile[D] = t_load(position(p), param_dtype(p), i, n, none, none)
  h
}

## `load`, reading only the lanes `mask` selects: a lane whose mask bit is 0
## is not read at all and answers the matching lane of `pad`. The mask and
## the padding tile are `n` wide, like the result.
pub fn load_masked[D](p: Param[D], idx: Idx, n: Int, mask: Tile[I1], pad: Tile[D]) -> Tile[D] !Dev = {
  let i: Int = idx
  let hm: Int = mask
  let hp: Int = pad
  let h: Tile[D] = t_load(position(p), param_dtype(p), i, n, Some(hm), Some(hp))
  h
}

## Write the `n`-wide tile `v` at element `idx * n` of `p`. Every lane is
## written; `store_masked` is the one to use when `p` is shorter than
## `(idx + 1) * n`.
pub fn store[D](p: Param[D], idx: Idx, n: Int, v: Tile[D]) -> Unit !Dev = {
  let i: Int = idx
  let hv: Int = v
  let none: Option[Int] = None
  t_store(position(p), param_dtype(p), i, n, hv, none)
}

## `store`, writing only the lanes `mask` selects: a lane whose mask bit is 0
## leaves memory as it was.
pub fn store_masked[D](p: Param[D], idx: Idx, n: Int, mask: Tile[I1], v: Tile[D]) -> Unit !Dev = {
  let i: Int = idx
  let hm: Int = mask
  let hv: Int = v
  t_store(position(p), param_dtype(p), i, n, hv, Some(hm))
}

# The handle of a binary float operation over two `n`-wide tiles of `d`.
fn binary[D: Dtype](d: D, op: String, n: Int, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Tile[D] = t_binaryf(op, dtype_name(d), n, x, y)
  h
}

fn unary[D: Dtype](d: D, op: String, n: Int, a: Tile[D]) -> Tile[D] !Dev = {
  let x: Int = a
  let h: Tile[D] = t_unaryf(op, dtype_name(d), n, x)
  h
}

fn compare[D: Dtype](d: D, pred: String, n: Int, a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Tile[I1] = t_cmpf(pred, dtype_name(d), n, x, y)
  h
}

fn compare_int(pred: String, n: Int, a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Tile[I1] = t_cmpi(pred, n, x, y)
  h
}

## The element-wise sum of two `n`-wide tiles of format `d`, rounded to
## nearest even (the one rounding mode tile-backend-design 3.2's theorem
## covers). Every arithmetic operation here carries that rounding mode and no
## other.
pub fn addf[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = binary(d, "addf", n, a, b)

## The element-wise difference `a - b`.
pub fn sub[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = binary(d, "subf", n, a, b)

## The element-wise product `a * b`.
pub fn mul[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = binary(d, "mulf", n, a, b)

## The element-wise quotient `a / b`.
pub fn div[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = binary(d, "divf", n, a, b)

## The element-wise larger of `a` and `b`. Neither `flush_to_zero` nor
## `propagate_nan` is set, so a NaN operand answers the other operand.
pub fn maxf[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = binary(d, "maxf", n, a, b)

## The element-wise smaller of `a` and `b`.
pub fn minf[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = binary(d, "minf", n, a, b)

## The element-wise negation `-a`: a sign flip, exact for every value.
pub fn neg[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "negf", n, a)

## The element-wise absolute value `|a|`: a sign clear, exact for every value.
pub fn abs[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "absf", n, a)

## The element-wise exponential `e^a`. The device computes it with the CUDA
## Math API (the dialect's `full` rounding mode, its default and the only
## one an f64 tile accepts here), which is an APPROXIMATION: a kernel built
## on it is a tolerance-tier kernel and no corpus makes it exact
## (docs/tile-backend-design.md 6.5).
##
## At bytecode 13.2 `exp` carries no attribute at all. Its `rounding_mode`
## field was added in 13.3, and a 13.2 reader that met one would take the
## next byte of the stream for something else (measured: `failed to get
## result type 0 for CmpIOp`).
pub fn exp[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "exp", n, a)

## The element-wise `2^a`, without `flush_to_zero`. Tolerance tier.
pub fn exp2[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "exp2", n, a)

## The element-wise natural logarithm. Tolerance tier.
pub fn log[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "log", n, a)

## The element-wise base-2 logarithm. Tolerance tier.
pub fn log2[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "log2", n, a)

## The element-wise square root, `rounding<nearest_even>` and no
## `flush_to_zero`. Unlike its neighbours here this one is a CORRECTLY
## ROUNDED operation in IEEE 754, so a kernel built on it can be held to the
## bit-exact tier; the tier is a measurement, not an assumption, and
## scripts/tile-gpu-diff records which one each kernel passed under.
pub fn sqrt[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "sqrt", n, a)

## The element-wise reciprocal square root, without `flush_to_zero`: a
## hardware approximation, tolerance tier.
pub fn rsqrt[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "rsqrt", n, a)

## The element-wise hyperbolic tangent, `rounding<full>` (the only mode an
## f64 tile accepts: `approx` is f32-only and `nearest_even` is refused,
## both measured). Tolerance tier.
pub fn tanh[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "tanh", n, a)

## The element-wise largest integer not above `a`. Exact for every value it
## is defined on, so a kernel built on it stays in the bit-exact tier.
pub fn floor[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "floor", n, a)

## The element-wise smallest integer not below `a`. Exact.
pub fn ceil[D: Dtype](d: D, n: Int, a: Tile[D]) -> Tile[D] !Dev = unary(d, "ceil", n, a)

## The element-wise `a` raised to the power `b`. Tolerance tier.
pub fn pow[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = binary(d, "pow", n, a, b)

## The element-wise fused multiply-add `a * b + c`, rounded ONCE (the product
## is not rounded before the sum). A host reference that multiplies and then
## adds agrees with this only where the product is exact.
pub fn fma[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D], c: Tile[D]) -> Tile[D] !Dev = {
  let x: Int = a
  let y: Int = b
  let z: Int = c
  let h: Tile[D] = t_fma(dtype_name(d), n, x, y, z)
  h
}

## The `n`-wide tile of format `d` every lane of which holds `value`. The
## constant is fixed when the kernel is recorded, which is what a host
## `Float` in a kernel body means.
pub fn f_const[D: Dtype](d: D, n: Int, value: Float) -> Tile[D] !Dev = {
  let h: Tile[D] = t_constf(dtype_name(d), n, value)
  h
}

## The `n`-wide i32 tile every lane of which holds `value`.
pub fn i_const(n: Int, value: Int) -> Tile[I32] !Dev = {
  let h: Tile[I32] = t_consti("i32", n, value)
  h
}

## The `n`-wide `i1` tile every lane of which holds `value`.
pub fn bool_const(n: Int, value: Bool) -> Tile[I1] !Dev = {
  let h: Tile[I1] = t_consti("i1", n, if value { 1 } else { 0 })
  h
}

## The `n`-wide i32 tile `[0, 1, .., n-1]`.
pub fn arange(n: Int) -> Tile[I32] !Dev = {
  let h: Tile[I32] = t_iota(n)
  h
}

## The `n`-wide i32 tile of the element indices block `idx` covers:
## `[idx * n, idx * n + 1, .., idx * n + n - 1]`.
pub fn lanes(idx: Idx, n: Int) -> Tile[I32] !Dev = {
  let i: Int = idx
  let h: Tile[I32] = t_lanes(i, n)
  h
}

## `a == b`, `a != b`, `a < b`, `a <= b`, `a > b`, `a >= b` over two `n`-wide
## tiles of format `d`, as an `n`-wide mask. Ordered: a NaN operand answers 0
## for every one of the six, `ne` included.
pub fn eq[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = compare(d, "eq", n, a, b)

pub fn ne[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = compare(d, "ne", n, a, b)

pub fn lt[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = compare(d, "lt", n, a, b)

pub fn le[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = compare(d, "le", n, a, b)

pub fn gt[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = compare(d, "gt", n, a, b)

pub fn ge[D: Dtype](d: D, n: Int, a: Tile[D], b: Tile[D]) -> Tile[I1] !Dev = compare(d, "ge", n, a, b)

## The same six over two `n`-wide i32 tiles, signed.
pub fn eq_i(n: Int, a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = compare_int("eq", n, a, b)

pub fn ne_i(n: Int, a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = compare_int("ne", n, a, b)

pub fn lt_i(n: Int, a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = compare_int("lt", n, a, b)

pub fn le_i(n: Int, a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = compare_int("le", n, a, b)

pub fn gt_i(n: Int, a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = compare_int("gt", n, a, b)

pub fn ge_i(n: Int, a: Tile[I32], b: Tile[I32]) -> Tile[I1] !Dev = compare_int("ge", n, a, b)

## The mask of the lanes of block `idx` that fall inside a buffer of `limit`
## elements: `lanes(idx, n) < limit`. The boundary of every kernel over a
## vector whose length is not a multiple of the tile width, and the reason
## `load_masked` and `store_masked` exist.
pub fn tail_mask(idx: Idx, n: Int, limit: Int) -> Tile[I1] !Dev =
  lt_i(n, lanes(idx, n), i_const(n, limit))

## The element-wise choice: lane `i` of `a` where lane `i` of `cond` is 1,
## lane `i` of `b` where it is 0.
pub fn select[D: Dtype](d: D, n: Int, cond: Tile[I1], a: Tile[D], b: Tile[D]) -> Tile[D] !Dev = {
  let c: Int = cond
  let x: Int = a
  let y: Int = b
  let h: Tile[D] = t_select(dtype_name(d), n, c, x, y)
  h
}

## The scalar index tile holding the host constant `value`: a loop bound, a
## step, a stride. The constant is fixed when the kernel is recorded, which
## is what a host `Int` in a kernel body means (tile-backend-design 5.2).
pub fn idx_const(value: Int) -> Idx !Dev = {
  let h: Idx = t_idx_const(value)
  h
}

## The sum of two index tiles.
pub fn idx_add(a: Idx, b: Idx) -> Idx !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Idx = t_idx_add(x, y)
  h
}

## The product of two index tiles.
pub fn idx_mul(a: Idx, b: Idx) -> Idx !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Idx = t_idx_mul(x, y)
  h
}

# A `for` over the index range `[lower, upper)` by `step` with `carried` as
# the loop-carried handles: `body` runs ONCE, on the host, with the induction
# variable and the carried handles as the loop sees them, and answers the
# handles the next iteration receives (as many as `carried`, in order); what
# it issues in between falls inside the loop's region. The answer is the
# carried handles after the loop. Private: handles are opaque outside this
# module, so a body can only reach this through the typed `d_for` / `d_for2`.
fn loop_handles(lower: Idx, upper: Idx, step: Idx, carried: List[Int],
  body: fn(Idx, List[Int]) -> List[Int] !Dev) -> List[Int] !Dev = {
  let lo: Int = lower
  let up: Int = upper
  let st: Int = step
  let (iv, inside) = t_loop_begin(lo, up, st, carried)
  let i: Idx = iv
  t_loop_end(body(i, inside))
}

## A `for` over the index range `[lower, upper)` by `step` inside the kernel,
## carrying one tile: `init` enters, `body` runs ONCE, on the host, with the
## induction variable and the carried tile as the loop sees them, and
## answers the tile the next iteration receives; what it issues in between
## falls inside the loop's region. The answer is the tile after the loop.
##
## This is an ordinary function rather than an operation because the
## operation's own declaration could not name a `!Dev` body
## (tile-backend-design 5.2). A body may nest `d_for`; the handler bounds the
## depth. The memory ordering token is carried through the loop by the
## handler, so a store after the loop is ordered after every store inside it.
pub fn d_for[D](lower: Idx, upper: Idx, step: Idx, init: Tile[D],
  body: fn(Idx, Tile[D]) -> Tile[D] !Dev) -> Tile[D] !Dev = {
  let h: Int = init
  let outs = loop_handles(lower, upper, step, [h], (i, inside) => {
    let t: Tile[D] = inside[0]
    let r: Int = body(i, t)
    [r]
  })
  let out: Tile[D] = outs[0]
  out
}

## `d_for` carrying two tiles, of formats `A` and `B`, in order.
pub fn d_for2[A, B](lower: Idx, upper: Idx, step: Idx, a: Tile[A], b: Tile[B],
  body: fn(Idx, Tile[A], Tile[B]) -> (Tile[A], Tile[B]) !Dev) -> (Tile[A], Tile[B]) !Dev = {
  let ha: Int = a
  let hb: Int = b
  let outs = loop_handles(lower, upper, step, [ha, hb], (i, inside) => {
    let ta: Tile[A] = inside[0]
    let tb: Tile[B] = inside[1]
    let (ra, rb) = body(i, ta, tb)
    let xa: Int = ra
    let xb: Int = rb
    [xa, xb]
  })
  let oa: Tile[A] = outs[0]
  let ob: Tile[B] = outs[1]
  (oa, ob)
}

## `d_for` carrying three tiles, of formats `A`, `B` and `C`, in order:
## what an online softmax needs (a running maximum, a running sum and an
## accumulator move through one loop together).
pub fn d_for3[A, B, C](lower: Idx, upper: Idx, step: Idx, a: Tile[A], b: Tile[B], c: Tile[C],
  body: fn(Idx, Tile[A], Tile[B], Tile[C]) -> (Tile[A], Tile[B], Tile[C]) !Dev) -> (Tile[A], Tile[B], Tile[C]) !Dev = {
  let ha: Int = a
  let hb: Int = b
  let hc: Int = c
  let outs = loop_handles(lower, upper, step, [ha, hb, hc], (i, inside) => {
    let ta: Tile[A] = inside[0]
    let tb: Tile[B] = inside[1]
    let tc: Tile[C] = inside[2]
    let (ra, rb, rc) = body(i, ta, tb, tc)
    let xa: Int = ra
    let xb: Int = rb
    let xc: Int = rc
    [xa, xb, xc]
  })
  let oa: Tile[A] = outs[0]
  let ob: Tile[B] = outs[1]
  let oc: Tile[C] = outs[2]
  (oa, ob, oc)
}

## `d_for` carrying four tiles, in order.
pub fn d_for4[A, B, C, E](lower: Idx, upper: Idx, step: Idx, a: Tile[A], b: Tile[B], c: Tile[C], e: Tile[E],
  body: fn(Idx, Tile[A], Tile[B], Tile[C], Tile[E]) -> (Tile[A], Tile[B], Tile[C], Tile[E]) !Dev) -> (Tile[A], Tile[B], Tile[C], Tile[E]) !Dev = {
  let ha: Int = a
  let hb: Int = b
  let hc: Int = c
  let he: Int = e
  let outs = loop_handles(lower, upper, step, [ha, hb, hc, he], (i, inside) => {
    let ta: Tile[A] = inside[0]
    let tb: Tile[B] = inside[1]
    let tc: Tile[C] = inside[2]
    let te: Tile[E] = inside[3]
    let (ra, rb, rc, re) = body(i, ta, tb, tc, te)
    let xa: Int = ra
    let xb: Int = rb
    let xc: Int = rc
    let xe: Int = re
    [xa, xb, xc, xe]
  })
  let oa: Tile[A] = outs[0]
  let ob: Tile[B] = outs[1]
  let oc: Tile[C] = outs[2]
  let oe: Tile[E] = outs[3]
  (oa, ob, oc, oe)
}

# ---- rank-0 tiles ----
#
# The rank-0 tile is width 0 at the operation layer (dev.dawn's `Dev` doc
# says why); everything below passes that 0 so that a kernel body never
# writes it.

# The rank-0 tile every lane of an `n`-wide tile widens from, and back.
fn rank0() -> Int = 0

## The `n`-wide tile every lane of which is `s`: a `reshape` to one lane and
## a `broadcast` to `n`. The one way from `Scalar[D]` to `Tile[D]`, and what
## a kernel does with a reduction's answer before it stores or divides by
## it.
pub fn spread[D: Dtype](d: D, n: Int, s: Scalar[D]) -> Tile[D] !Dev = {
  let h: Int = s
  let r: Tile[D] = t_spread(dtype_name(d), n, h)
  r
}

# A binary float operation over two rank-0 tiles of `d`.
fn s_binary[D: Dtype](d: D, op: String, a: Scalar[D], b: Scalar[D]) -> Scalar[D] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Scalar[D] = t_binaryf(op, dtype_name(d), rank0(), x, y)
  h
}

## The sum of two rank-0 tiles, `rounding<nearest_even>`: the body of a sum
## reduction.
pub fn s_addf[D: Dtype](d: D, a: Scalar[D], b: Scalar[D]) -> Scalar[D] !Dev = s_binary(d, "addf", a, b)

## The larger of two rank-0 tiles: the body of a max reduction. Neither
## `propagate_nan` nor `flush_to_zero`, as `maxf` here never is.
pub fn s_maxf[D: Dtype](d: D, a: Scalar[D], b: Scalar[D]) -> Scalar[D] !Dev = s_binary(d, "maxf", a, b)

## The smaller of two rank-0 tiles: the body of a min reduction.
pub fn s_minf[D: Dtype](d: D, a: Scalar[D], b: Scalar[D]) -> Scalar[D] !Dev = s_binary(d, "minf", a, b)

## `a > b` over two rank-0 float tiles, as a rank-0 mask: what an argmax
## reduction branches on. Ordered, like every comparison here.
pub fn s_gt[D: Dtype](d: D, a: Scalar[D], b: Scalar[D]) -> Scalar[I1] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Scalar[I1] = t_cmpf("gt", dtype_name(d), rank0(), x, y)
  h
}

## The rank-0 choice: `a` where `cond` is 1, `b` where it is 0.
pub fn s_select[D: Dtype](d: D, cond: Scalar[I1], a: Scalar[D], b: Scalar[D]) -> Scalar[D] !Dev = {
  let c: Int = cond
  let x: Int = a
  let y: Int = b
  let h: Scalar[D] = t_select(dtype_name(d), rank0(), c, x, y)
  h
}

# The comparison of two index tiles, as a rank-0 mask.
fn idx_compare(pred: String, a: Idx, b: Idx) -> Scalar[I1] !Dev = {
  let x: Int = a
  let y: Int = b
  let h: Scalar[I1] = t_cmpi(pred, rank0(), x, y)
  h
}

## `a == b`, `a != b`, `a < b`, `a <= b`, `a > b`, `a >= b` over two index
## tiles, as the rank-0 mask `d_if` branches on. Signed.
pub fn idx_eq(a: Idx, b: Idx) -> Scalar[I1] !Dev = idx_compare("eq", a, b)

pub fn idx_ne(a: Idx, b: Idx) -> Scalar[I1] !Dev = idx_compare("ne", a, b)

pub fn idx_lt(a: Idx, b: Idx) -> Scalar[I1] !Dev = idx_compare("lt", a, b)

pub fn idx_le(a: Idx, b: Idx) -> Scalar[I1] !Dev = idx_compare("le", a, b)

pub fn idx_gt(a: Idx, b: Idx) -> Scalar[I1] !Dev = idx_compare("gt", a, b)

pub fn idx_ge(a: Idx, b: Idx) -> Scalar[I1] !Dev = idx_compare("ge", a, b)

# ---- reductions ----

## The reduction of the `n`-wide tile `t` along its one dimension: `body`
## runs ONCE, on the host, with an element of the tile and the accumulator
## as the region sees them, and answers the new accumulator; what it issues
## in between is the region. `identity` is what a fold that has seen nothing
## starts from (0.0 for a sum, -inf for a max) and must be the identity of
## `body` or the answer is wrong on the device and nowhere else.
##
## THE ORDER IS NOT SPECIFIED. Tile IR requires the function to be
## associative and commutative and says nothing about the tree, so a host
## reference that folds left is not an oracle for this in general
## (docs/tile-backend-design.md 6.5). A corpus on which every order is
## exact, or a tolerance, is.
pub fn d_reduce[D: Dtype](d: D, n: Int, t: Tile[D], identity: Float,
  body: fn(Scalar[D], Scalar[D]) -> Scalar[D] !Dev) -> Scalar[D] !Dev = {
  let h: Int = t
  let args = t_reduce_begin(0, n, [IdF(dtype_name(d), identity)], [h])
  let e: Scalar[D] = args[0]
  let acc: Scalar[D] = args[1]
  let r: Int = body(e, acc)
  let outs = t_reduce_end([r])
  let out: Scalar[D] = outs[0]
  out
}

## `d_reduce` over TWO tiles at once, a float tile and the i32 index tile
## beside it: the shape argmax and argmin have, where the winning value and
## the lane it came from must travel together through one fold. `body` takes
## the element and accumulator of each, in that order, and answers the new
## accumulator of each.
pub fn d_reduce2[A: Dtype](a: A, n: Int, values: Tile[A], idxs: Tile[I32],
  value_identity: Float, index_identity: Int,
  body: fn(Scalar[A], Scalar[I32], Scalar[A], Scalar[I32]) -> (Scalar[A], Scalar[I32]) !Dev) -> (Scalar[A], Scalar[I32]) !Dev = {
  let hv: Int = values
  let hi: Int = idxs
  let args = t_reduce_begin(0, n, [IdF(dtype_name(a), value_identity), IdI("i32", index_identity)], [hv, hi])
  let ev: Scalar[A] = args[0]
  let av: Scalar[A] = args[1]
  let ei: Scalar[I32] = args[2]
  let ai: Scalar[I32] = args[3]
  let (rv, ri) = body(ev, ei, av, ai)
  let xv: Int = rv
  let xi: Int = ri
  let outs = t_reduce_end([xv, xi])
  let ov: Scalar[A] = outs[0]
  let oi: Scalar[I32] = outs[1]
  (ov, oi)
}

## The `if` over the rank-0 mask `cond`: `on_true` and `on_false` each run
## ONCE, on the host, and what each issues is one of the operation's two
## regions; each answers the tile its region yields and the two must have
## the same shape and format. The answer is the tile the operation defines.
##
## Both regions are always written, as the dialect's reader requires (an
## `if` with one region is refused, measured). Neither may load or store.
pub fn d_if[D](cond: Scalar[I1], on_true: fn() -> Tile[D] !Dev, on_false: fn() -> Tile[D] !Dev) -> Tile[D] !Dev = {
  let c: Int = cond
  t_if_begin(c)
  let th: Int = on_true()
  t_if_else([th])
  let el: Int = on_false()
  let outs = t_if_end([el])
  let out: Tile[D] = outs[0]
  out
}

# ---- tests ----
#
# The recording handler lives in prog.dawn and is tested there. These blocks
# pin what this module owns: the handles a body holds are the raw values the
# operations answered, and the typed surface passes position, dtype and
# operation name through without touching them.

fn under_counter[T](body: fn() -> T !Dev) -> T = {
  with handle Dev {
    var next: Int = 100
    t_block_id(_axis) => {
      let h = next
      next = next + 1
      h
    }
    t_load(_param, _dtype, _idx, _n, _mask, _pad) => {
      let h = next
      next = next + 1
      h
    }
    t_store(_param, _dtype, _idx, _n, _v, _mask) => ()
    t_constf(_dtype, _n, _value) => {
      let h = next
      next = next + 1
      h
    }
    t_consti(_dtype, _n, _value) => {
      let h = next
      next = next + 1
      h
    }
    t_iota(_n) => {
      let h = next
      next = next + 1
      h
    }
    t_lanes(_idx, _n) => {
      let h = next
      next = next + 1
      h
    }
    t_unaryf(_op, _dtype, _n, _a) => {
      let h = next
      next = next + 1
      h
    }
    t_binaryf(_op, _dtype, _n, _a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_fma(_dtype, _n, _a, _b, _c) => {
      let h = next
      next = next + 1
      h
    }
    t_cmpf(_pred, _dtype, _n, _a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_cmpi(_pred, _n, _a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_select(_dtype, _n, _cond, _a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_idx_const(_value) => {
      let h = next
      next = next + 1
      h
    }
    t_idx_add(_a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_idx_mul(_a, _b) => {
      let h = next
      next = next + 1
      h
    }
    t_loop_begin(_lower, _upper, _step, inits) => {
      let iv = next
      let base = next + 1
      next = next + 1 + len(inits)
      (iv, list.map(range(0, len(inits)), k => base + k))
    }
    t_loop_end(outs) => {
      let base = next
      next = next + len(outs)
      list.map(range(0, len(outs)), k => base + k)
    }
    t_spread(_dtype, _n, _src) => {
      let h = next
      next = next + 1
      h
    }
    t_reduce_begin(_dim, _n, _identities, operands) => {
      let base = next
      next = next + 2 * len(operands)
      list.map(range(0, 2 * len(operands)), k => base + k)
    }
    t_reduce_end(yields) => {
      let base = next
      next = next + len(yields)
      list.map(range(0, len(yields)), k => base + k)
    }
    t_if_begin(_cond) => ()
    t_if_else(_yields) => ()
    t_if_end(yields) => {
      let base = next
      next = next + len(yields)
      list.map(range(0, len(yields)), k => base + k)
    }
  }
  body()
}

fn handles_seen() -> (Int, Int, Int, Int) !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let ta = load(a, i, 128)
  let tb = load(a, i, 128)
  let s = addf(F64, 128, ta, tb)
  store(a, i, 128, s)
  let hi: Int = i
  let ha: Int = ta
  let hb: Int = tb
  let hs: Int = s
  (hi, ha, hb, hs)
}

test "a handle is the value the operation answered, in order" {
  assert under_counter(handles_seen) == (100, 101, 102, 103)
}

test "a parameter remembers its position and its format" {
  let a = param(F64, 0)
  let b = param(F32, 5)
  assert position(a) == 0
  assert param_dtype(a) == "f64"
  assert position(b) == 5
  assert param_dtype(b) == "f32"
}

test "the tile element formats name themselves as Tile IR spells them" {
  assert (dtype_name(I32), dtype_bytes(I32)) == ("i32", 4)
  assert (dtype_name(I1), dtype_bytes(I1)) == ("i1", 1)
}

fn dtype_passed_to_load() -> List[String] !Dev = {
  let a = param(F32, 1)
  let i = block_id(2)
  let _t = load(a, i, 64)
  []
}

# What an operation looks like in the log below: `None` for an absent
# optional operand, its handle for a present one.
fn opt(o: Option[Int]) -> String = match o {
  Some(h) -> "Some(${h})"
  None -> "None"
}

# Run `body` under a handler that answers a fixed handle per operation and
# writes one line per operation it saw, and answer the lines. The state cell
# is the handler's own: a closure may not capture a `var` (spec 4.5), so the
# log cannot be passed in.
fn logged(body: fn() -> Unit !Dev) -> List[String] = {
  with handle Dev {
    var log: List[String] = []
    t_block_id(axis) => {
      log = log ++ ["block_id ${axis}"]
      0
    }
    t_load(param, dtype, idx, n, mask, pad) => {
      log = log ++ ["load ${param} ${dtype} ${idx} ${n} ${opt(mask)} ${opt(pad)}"]
      1
    }
    t_store(param, dtype, idx, n, v, mask) => {
      log = log ++ ["store ${param} ${dtype} ${idx} ${n} ${v} ${opt(mask)}"]
    }
    t_constf(dtype, n, value) => {
      log = log ++ ["constf ${dtype} ${n} ${value}"]
      2
    }
    t_consti(dtype, n, value) => {
      log = log ++ ["consti ${dtype} ${n} ${value}"]
      3
    }
    t_iota(n) => {
      log = log ++ ["iota ${n}"]
      4
    }
    t_lanes(idx, n) => {
      log = log ++ ["lanes ${idx} ${n}"]
      5
    }
    t_unaryf(op, dtype, n, a) => {
      log = log ++ ["unaryf ${op} ${dtype} ${n} ${a}"]
      6
    }
    t_binaryf(op, dtype, n, a, b) => {
      log = log ++ ["binaryf ${op} ${dtype} ${n} ${a} ${b}"]
      7
    }
    t_fma(dtype, n, a, b, c) => {
      log = log ++ ["fma ${dtype} ${n} ${a} ${b} ${c}"]
      8
    }
    t_cmpf(pred, dtype, n, a, b) => {
      log = log ++ ["cmpf ${pred} ${dtype} ${n} ${a} ${b}"]
      9
    }
    t_cmpi(pred, n, a, b) => {
      log = log ++ ["cmpi ${pred} ${n} ${a} ${b}"]
      10
    }
    t_select(dtype, n, cond, a, b) => {
      log = log ++ ["select ${dtype} ${n} ${cond} ${a} ${b}"]
      11
    }
    t_idx_const(_value) => 12
    t_idx_add(_a, _b) => 13
    t_idx_mul(_a, _b) => 14
    t_loop_begin(_lower, _upper, _step, inits) => (15, inits)
    t_loop_end(outs) => outs
    t_spread(dtype, n, src) => {
      log = log ++ ["spread ${dtype} ${n} ${src}"]
      16
    }
    t_reduce_begin(dim, n, identities, operands) => {
      log = log ++ ["reduce_begin ${dim} ${n} ${show(identities)} ${show(operands)}"]
      list.map(range(0, 2 * len(operands)), k => 20 + k)
    }
    t_reduce_end(yields) => {
      log = log ++ ["reduce_end ${show(yields)}"]
      list.map(range(0, len(yields)), k => 30 + k)
    }
    t_if_begin(cond) => {
      log = log ++ ["if_begin ${cond}"]
    }
    t_if_else(yields) => {
      log = log ++ ["if_else ${show(yields)}"]
    }
    t_if_end(yields) => {
      log = log ++ ["if_end ${show(yields)}"]
      list.map(range(0, len(yields)), k => 40 + k)
    }
  }
  body()
  log
}

test "load hands the handler the parameter's own format, not a fixed one" {
  let seen = logged(() => {
    let _r = dtype_passed_to_load()
    ()
  })
  assert seen == ["block_id 2", "load 1 f32 0 64 None None"]
}

fn every_arithmetic_name() -> Unit !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let m = tail_mask(i, 8, 5)
  let pad = f_const(F64, 8, 0.0)
  let x = load_masked(a, i, 8, m, pad)
  let y = load(a, i, 8)
  let s = addf(F64, 8, x, y)
  let d = sub(F64, 8, s, y)
  let p = mul(F64, 8, d, y)
  let q = div(F64, 8, p, y)
  let hi = maxf(F64, 8, q, y)
  let lo = minf(F64, 8, hi, y)
  let n1 = neg(F64, 8, lo)
  let a1 = abs(F64, 8, n1)
  let f1 = fma(F64, 8, a1, y, x)
  let c = lt(F64, 8, f1, y)
  let r = select(F64, 8, c, f1, y)
  store_masked(a, i, 8, m, r)
}

test "the typed surface spells every operation name the handler sees" {
  let seen = logged(every_arithmetic_name)
  assert seen == [
    "block_id 0",
    "lanes 0 8",
    "consti i32 8 5",
    "cmpi lt 8 5 3",
    "constf f64 8 0.0",
    "load 0 f64 0 8 Some(10) Some(2)",
    "load 0 f64 0 8 None None",
    "binaryf addf f64 8 1 1",
    "binaryf subf f64 8 7 1",
    "binaryf mulf f64 8 7 1",
    "binaryf divf f64 8 7 1",
    "binaryf maxf f64 8 7 1",
    "binaryf minf f64 8 7 1",
    "unaryf negf f64 8 7",
    "unaryf absf f64 8 6",
    "fma f64 8 6 1 1",
    "cmpf lt f64 8 8 1",
    "select f64 8 9 8 1",
    "store 0 f64 0 8 11 Some(10)"
  ]
}

fn every_transcendental() -> Unit !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let x = load(a, i, 8)
  let _r = [
    exp(F64, 8, x), exp2(F64, 8, x), log(F64, 8, x), log2(F64, 8, x), sqrt(F64, 8, x),
    rsqrt(F64, 8, x), tanh(F64, 8, x), floor(F64, 8, x), ceil(F64, 8, x), pow(F64, 8, x, x)
  ]
  ()
}

test "the typed surface spells every transcendental's name the way Tile IR does" {
  let seen = {
    let log_lines = logged(every_transcendental)
    list.filter(log_lines, l => str.starts_with(l, "unaryf") || str.starts_with(l, "binaryf"))
  }
  assert seen == [
    "unaryf exp f64 8 1", "unaryf exp2 f64 8 1", "unaryf log f64 8 1", "unaryf log2 f64 8 1",
    "unaryf sqrt f64 8 1", "unaryf rsqrt f64 8 1", "unaryf tanh f64 8 1", "unaryf floor f64 8 1",
    "unaryf ceil f64 8 1", "binaryf pow f64 8 1 1"
  ]
}

fn one_reduction() -> Unit !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let x = load(a, i, 8)
  let s = d_reduce(F64, 8, x, 0.0, (e, acc) => s_addf(F64, e, acc))
  let _w = spread(F64, 8, s)
  ()
}

test "a reduction hands the handler the width, the identity and the operand, and its region the element and the accumulator" {
  # `logged` answers 20 and 21 for the two region arguments and 30 for the
  # result; the body's addf is over those two.
  assert logged(one_reduction) == [
    "block_id 0",
    "load 0 f64 0 8 None None",
    "reduce_begin 0 8 [IdF(\"f64\", 0.0)] [1]",
    "binaryf addf f64 0 20 21",
    "reduce_end [7]",
    "spread f64 8 30"
  ]
}

fn one_branch() -> Unit !Dev = {
  let a = param(F64, 0)
  let i = block_id(0)
  let x = load(a, i, 8)
  let _r = d_if(idx_eq(i, idx_const(0)), () => addf(F64, 8, x, x), () => mul(F64, 8, x, x))
  ()
}

test "an if hands the handler its condition, then each branch's yield in turn" {
  assert logged(one_branch) == [
    "block_id 0",
    "load 0 f64 0 8 None None",
    "cmpi eq 0 0 12",
    "if_begin 10",
    "binaryf addf f64 8 1 1",
    "if_else [7]",
    "binaryf mulf f64 8 1 1",
    "if_end [7]"
  ]
}

test "d_for3 carries three tiles into the loop and answers three after it" {
  let seen = under_counter(() => {
    let a = param(F64, 0)
    let i = block_id(0)
    let x = load(a, i, 8)
    let z = idx_const(0)
    let (p, q, r) = d_for3(z, z, z, x, x, x, (_k, u, v, w) => (u, v, w))
    let hp: Int = p
    let hq: Int = q
    let hr: Int = r
    (hp, hq, hr)
  })
  # block_id 100, load 101, idx_const 102; loop_begin takes 103 for the
  # induction variable and 104, 105, 106 for the three carried tiles, and
  # loop_end answers 107, 108, 109 for the three after the loop.
  assert seen == (107, 108, 109)
}

test "d_for4 carries four tiles into the loop and answers four after it" {
  let seen = under_counter(() => {
    let a = param(F64, 0)
    let i = block_id(0)
    let x = load(a, i, 8)
    let z = idx_const(0)
    let (p, q, r, s) = d_for4(z, z, z, x, x, x, x, (_k, u, v, w, y) => (u, v, w, y))
    let hp: Int = p
    let hq: Int = q
    let hr: Int = r
    let hs: Int = s
    (hp, hq, hr, hs)
  })
  # one carried value more than d_for3: the induction variable takes 103,
  # the four carried tiles 104 to 107, and loop_end answers 108 to 111.
  assert seen == (108, 109, 110, 111)
}

test "the six comparison predicates reach the handler by name, floating point and integer alike" {
  let seen = {
    let log = logged(() => {
      let a = param(F64, 0)
      let i = block_id(0)
      let x = load(a, i, 8)
      let ints = arange(8)
      let _c = [
        eq(F64, 8, x, x), ne(F64, 8, x, x), lt(F64, 8, x, x),
        le(F64, 8, x, x), gt(F64, 8, x, x), ge(F64, 8, x, x)
      ]
      let _d = [
        eq_i(8, ints, ints), ne_i(8, ints, ints), lt_i(8, ints, ints),
        le_i(8, ints, ints), gt_i(8, ints, ints), ge_i(8, ints, ints)
      ]
      ()
    })
    list.filter(log, l => str.starts_with(l, "cmp"))
  }
  assert seen == [
    "cmpf eq f64 8 1 1", "cmpf ne f64 8 1 1", "cmpf lt f64 8 1 1",
    "cmpf le f64 8 1 1", "cmpf gt f64 8 1 1", "cmpf ge f64 8 1 1",
    "cmpi eq 8 4 4", "cmpi ne 8 4 4", "cmpi lt 8 4 4",
    "cmpi le 8 4 4", "cmpi gt 8 4 4", "cmpi ge 8 4 4"
  ]
}

test "the constant and index tiles reach the handler with their format and their host value" {
  let seen = logged(() => {
    let _a = f_const(F64, 8, 0.5)
    let _b = i_const(8, 12)
    let _c = bool_const(8, true)
    let _d = bool_const(8, false)
    let _e = arange(8)
    ()
  })
  assert seen == ["constf f64 8 0.5", "consti i32 8 12", "consti i1 8 1", "consti i1 8 0", "iota 8"]
}

fn loop_seen() -> (Int, Int, Int, Int, Int) !Dev = {
  let a = param(F64, 0)
  let b = block_id(0)
  let lo = idx_const(0)
  let up = idx_add(b, idx_mul(b, lo))
  let first = load(a, b, 8)
  let acc = d_for(lo, up, lo, first, (i, t) => addf(F64, 8, t, load(a, i, 8)))
  let hb: Int = b
  let hup: Int = up
  let hfirst: Int = first
  let hacc: Int = acc
  let hlo: Int = lo
  (hb, hlo, hup, hfirst, hacc)
}

test "a loop's induction variable, carried handle and result are the handles the operations answered" {
  # block_id 100, const 101, mul 102, add 103, load 104, then loop_begin
  # takes 105 (iv) and 106 (the carried tile), the body's load 107 and
  # addf 108, and loop_end answers 109 for the tile after the loop.
  assert under_counter(loop_seen) == (100, 101, 103, 104, 109)
}

test "d_for hands the body the carried handle and passes its answer back as the continue value" {
  let seen = {
    with handle Dev {
      var log: List[String] = []
      t_block_id(_axis) => 0
      t_load(_param, _dtype, _idx, _n, _mask, _pad) => 1
      t_store(_param, _dtype, _idx, _n, _v, _mask) => ()
      t_constf(_dtype, _n, _value) => 2
      t_consti(_dtype, _n, _value) => 3
      t_iota(_n) => 4
      t_lanes(_idx, _n) => 5
      t_unaryf(_op, _dtype, _n, _a) => 6
      t_binaryf(op, _dtype, _n, a, b) => {
        log = log ++ ["${op} ${a} ${b}"]
        2
      }
      t_fma(_dtype, _n, _a, _b, _c) => 7
      t_cmpf(_pred, _dtype, _n, _a, _b) => 8
      t_cmpi(_pred, _n, _a, _b) => 9
      t_select(_dtype, _n, _cond, _a, _b) => 10
      t_idx_const(value) => value + 10
      t_idx_add(_a, _b) => 4
      t_idx_mul(_a, _b) => 5
      t_loop_begin(lower, upper, step, inits) => {
        log = log ++ ["loop_begin ${lower} ${upper} ${step} ${show(inits)}"]
        (30, [31])
      }
      t_loop_end(outs) => {
        log = log ++ ["loop_end ${show(outs)}"]
        [40]
      }
      t_spread(_dtype, _n, _src) => 16
      t_reduce_begin(_dim, _n, _identities, operands) => list.map(range(0, 2 * len(operands)), k => 20 + k)
      t_reduce_end(yields) => list.map(range(0, len(yields)), k => 30 + k)
      t_if_begin(_cond) => ()
      t_if_else(_yields) => ()
      t_if_end(yields) => list.map(range(0, len(yields)), k => 40 + k)
    }
    let _r = loop_seen()
    log
  }
  assert seen == ["loop_begin 10 4 10 [1]", "addf 31 1", "loop_end [2]"]
}

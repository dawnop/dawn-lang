# Checker refusals for the plan tables. A plan is looked up by the element
# format's type, so a format that has no table is refused where the factory is
# called, not by a panic after the lookup. `kernels` is scripts/tile-golden's
# kernels.dawn, which run.sh copies beside this file as a module.
use std/narrow.{F32, F16}
use std/dtype.{F64}
use kernels.{Sm90, mm_record, mm_shape, fa_record}

pub fn matmul_f32() -> Unit = { let _p = mm_record(F32, Sm90, mm_shape()) }
pub fn flash_f16() -> Unit = { let _p = fa_record(F16, Sm90, 64, 512, 1) }
pub fn flash_f32() -> Unit = { let _p = fa_record(F32, Sm90, 64, 512, 1) }
pub fn arch_is_not_a_string() -> Unit = { let _p = mm_record(F64, "sm_90", mm_shape()) }
pub fn dtype_is_not_a_string() -> Unit = { let _p = mm_record("f64", Sm90, mm_shape()) }

3, 4827493086139926451)\n    576 -> (8452712498170643941, 5879314530452927160)\n    577 -> (6762169998536515153, 2858777216991386566)\n    578 -> (5409735998829212122, 5976370588335019576)\n    579 -> (8655577598126739396, 2183495311852210675)\n    580 -> (6924462078501391516, 9125493878965589187)\n    581 -> (5539569662801113213, 5455720695801516188)\n    582 -> (8863311460481781141, 6884478705911470739)\n    583 -> (7090649168385424913, 3662908557358221429)\n    584 -> (5672519334708339930, 6619675660628487467)\n    585 -> (9076030935533343889, 1368109020150804139)\n    586 -> (7260824748426675111, 2939161623491598473)\n    587 -> (5808659798741340089, 506654891422323617)\n    588 -> (4646927838993072071, 2249998320508814055)\n    589 -> (7435084542388915313, 9134020534926967972)\n    590 -> (5948067633911132251, 1773193205828708893)\n    591 -> (4758454107128905800, 8797252194146787761)\n    592 -> (7613526571406249281, 4852231473780084609)\n    593 -> (6090821257124999425, 2037110771653112526)\n    594 -> (4872657005699999540, 1629688617322490021)\n    595 -> (7796251209119999264, 2607501787715984033)\n    596 -> (6237000967295999411, 3930675837543742388)\n    597 -> (4989600773836799529, 1299866262664038749)\n    598 -> (7983361238138879246, 5769134835004372321)\n    599 -> (6386688990511103397, 2770633460632542696)\n    _ -> panic(\"fmt: 10^k out of range\")\n  }\n\nfn g_chunk6(i: Int) -> (Int, Int) =\n  match i {\n    600 -> (5109351192408882717, 7750529990618899641)\n    601 -> (8174961907854212348, 5022150355506418780)\n    602 -> (6539969526283369878, 7707069099147045347)\n    603 -> (5231975621026695903, 631632057204770793)\n    604 -> (8371160993642713444, 8389308921011453915)\n    605 -> (6696928794914170755, 8556121544180118293)\n    606 -> (5357543035931336604, 6844897235344094635)\n    607 -> (8572068857490138567, 5417812354437685931)\n    608 -> (6857655085992110854, 644901068808238421)\n    609 -> (5486124068793688683, 2360595262417545899)\n    610 -> (8777798510069901893, 1932278012497118276)\n    611 -> (7022238808055921514, 5235171224739604944)\n    612 -> (5617791046444737211, 6032811387162639117)\n    613 -> (8988465674311579538, 5963149404718312264)\n    614 -> (7190772539449263630, 8459868338516560134)\n    615 -> (5752618031559410904, 6767894670813248108)\n    616 -> (9204188850495057447, 5294608251188331487)\n    _ -> panic(\"fmt: 10^k out of range\")\n  }\n# ---- Schubfach ----\n\n## Round-odd product: floor(g * cp / 2^127) with the low bit forced on when\n## any discarded bit was. `g = g1 * 2^63 + g0` is the 126-bit significand from\n## g_pair; `cp` stays under 2^61.\nfn rop(g1: Int, g0: Int, cp: Int) -> Int = {\n  let x1 = umulh(g0, cp)\n  let y0 = g1 * cp\n  let y1 = umulh(g1, cp)\n  let z = (y0 >>> 1) + x1\n  let vbp = y1 + (z >>> 63)\n  # the mask is 2^63 - 1: adding it pushes any nonzero low bits past bit 63\n  vbp | (((z & 9223372036854775807) + 9223372036854775807) >>> 63)\n}\n\nfn digits_len(f: Int) -> Int = {\n  var n = 1\n  while n < 18 && f >= pow10(n) {\n    n = n + 1\n  }\n  n\n}\n\n## Format the shortest digits `f` with `0.f * 10^e` as the value: plain\n## decimal inside 10^-3 <= |v| < 10^7, computerized scientific notation\n## outside (spec §4.3). Trailing zeros go, but a fraction keeps one digit.\nfn to_chars(f0: Int, e0: Int) -> String = {\n  let n0 = digits_len(f0)\n  let f = f0 * pow10(17 - n0)\n  let e = e0 + n0\n  var ds = str.pad_start(to_string(f), 17, \"0\")\n  var n = 17\n  while n > 1 && str.slice(ds, n - 1, n) == \"0\" {\n    n = n - 1\n  }\n  ds = str.take(ds, n)\n  if e > 0 && e <= 7 {\n    if n <= e {\n      ds ++ str.repeat(\"0\", e - n) ++ \".0\"\n    } else {\n      str.take(ds, e) ++ \".\" ++ str.slice(ds, e, n)\n    }\n  } else if e > -3 && e <= 0 {\n    \"0.\" ++ str.repeat(\"0\", -e) ++ ds\n  } else {\n    let head = str.take(ds, 1)\n    let frac = if n > 1 { str.slice(ds, 1, n) } else { \"0\" }\n    head ++ \".\" ++ frac ++ \"E\" ++ to_string(e - 1)\n  }\n}\n\n## The Schubfach core over `v = c * 2^q`: pick the shortest decimal in the\n## rounding interval, then the closest one (ties to even digits). A straight\n## port of the algorithm's figure-7 skeleton; `dk` is the decimal-exponent\n## debt the tiny-subnormal caller (`c` premultiplied by 10) hands in.\nfn to_decimal(q: Int, c: Int, dk: Int) -> String = {\n  let out = c & 1\n  let cb = c << 2\n  let cbr = cb + 2\n  var cbl = 0\n  var k = 0\n  if c != 4503599627370496 || q == -1074 {\n    # regular spacing: both neighbors half an ulp away\n    cbl = cb - 2\n    k = flog10pow2(q)\n  } else {\n    # the power of two just above a binade edge: the lower neighbor is closer\n    cbl = cb - 1\n    k = flog10_three_quarters_pow2(q)\n  }\n  let h = q + flog2pow10(-k) + 2\n  let (g1, g0) = g_pair(k + 324)\n  let vb = rop(g1, g0, cb << h)\n  let vbl = rop(g1, g0, cbl << h)\n  let vbr = rop(g1, g0, cbr << h)\n  let s = vb >> 2\n  if s >= 100 {\n    # is a 10-multiple (one digit shorter) already inside the interval?\n    let sp10 = 10 * (s / 10)\n    let tp10 = sp10 + 10\n    let upin = (vbl + out) <= (sp10 << 2)\n    let wpin = ((tp10 << 2) + out) <= vbr\n    if upin != wpin {\n      return to_chars(if upin { sp10 } else { tp10 }, k)\n    }\n  }\n  let t = s + 1\n  let uin = (vbl + out) <= (s << 2)\n  let win = ((t << 2) + out) <= vbr\n  if uin != win {\n    return to_chars(if uin { s } else { t }, k + dk)\n  }\n  let cmp = vb - ((s + t) << 1)\n  to_chars(if cmp < 0 || (cmp == 0 && (s & 1) == 0) { s } else { t }, k + dk)\n}\n\n## `to_string(Float)`: the shortest decimal string that reads back as exactly\n## `v`, in the two forms and three special spellings spec §4.3 fixes. This is\n## what both backends and comptime folding call; user code goes through\n## `to_string` and interpolation rather than calling it directly.\npub fn dtoa(v: Float) -> String = {\n  if v != v {\n    return \"NaN\"\n  }\n  let neg = v < 0.0 || (v == 0.0 && 1.0 / v < 0.0)\n  let sign = if neg { \"-\" } else { \"\" }\n  if v == 0.0 {\n    return sign ++ \"0.0\"\n  }\n  let a = if neg { -v } else { v }\n  # only an infinity survives `a - a != 0` with the NaN case gone\n  if a - a != 0.0 {\n    return sign ++ \"Infinity\"\n  }\n  # Decompose a = c * 2^q with c integral, q >= -1074, and c in [2^52, 2^53)\n  # unless q is pinned at -1074 (subnormals, and the smallest normals). Done\n  # by exact scaling instead of a bit cast: Dawn has no Float bit intrinsic,\n  # and none is needed — multiplying or dividing by a power of two is exact\n  # whenever the result is representable, and every intermediate here is\n  # (scaling up from below 2^52 cannot overflow; scaling down stops at 2^52).\n  let p52 = to_float(4503599627370496)\n  let p53 = p52 + p52\n  var p512 = 2.0\n  var j = 0\n  while j < 9 {\n    p512 = p512 * p512\n    j = j + 1\n  }\n  let tiny = p52 / p512\n  var m = a\n  var q = 0\n  while m >= p512 {\n    m = m / p512\n    q = q + 512\n  }\n  while m >= p53 {\n    m = m / 2.0\n    q = q + 1\n  }\n  while m < tiny && q >= -562 {\n    m = m * p512\n    q = q - 512\n  }\n  while m < p52 && q > -1074 {\n    m = m * 2.0\n    q = q - 1\n  }\n  let c = to_int(m)\n  if c >= 4503599627370496 {\n    # normal: integers with an exact short form skip the interval machinery\n    let mq = -q\n    if mq > 0 && mq < 53 {\n      let f = c >> mq\n      if (f << mq) == c {\n        return sign ++ to_chars(f, 0)\n      }\n    }\n    return sign ++ to_decimal(q, c, 0)\n  }\n  # subnormal: c < 3 has too few bits for the interval arithmetic, so run it\n  # on 10c and repay the borrowed decimal digit through dk\n  if c < 3 {\n    return sign ++ to_decimal(q, 10 * c, -1)\n  }\n  sign ++ to_decimal(q, c, 0)\n}\n\n# ---- parsing (spec §11's EBNF, scanned here, never by a host grammar) ----\n\n# This scanner works in code points, not characters: `cursor.char` answers an\n# Int and a `-1` past the end (spec §4.8), so a sentinel that is not a\n# character rules `Char` out one layer down. `char.code` names an ASCII bound\n# without leaving that currency.\nfn is_ascii_digit(c: Int) -> Bool = c >= char.code('0') && c <= char.code('9')\n\n## Digit value for radix parsing: ASCII `0-9a-zA-Z` and nothing else — no\n## Unicode digits, no full-width forms (spec §11). -1 for a non-digit.\nfn digit_val(c: Int) -> Int =\n  if c >= char.code('0') && c <= char.code('9') {\n    c - char.code('0')\n  } else if c >= char.code('a') && c <= char.code('z') {\n    c - char.code('a') + 10\n  } else if c >= char.code('A') && c <= char.code('Z') {\n    c - char.code('A') + 10\n  } else {\n    -1\n  }\n\n## `parse_int(s)`: optional sign, then ASCII decimal digits, nothing else\n## (spec §11) — trimmed by Dawn's own space table first. Out-of-range is\n## `None`, not a wrap.\n##\n## Not `pub`, since v0.55.0: the builtin is the spelling, this is where it\n## lands. `fmt.atoi` was a second name for one concept (CONTRIBUTING §naming),\n## and the one nobody should have been writing — the module exists because the\n## implementation is ordinary Dawn source, not because it is an API (spec\n## §10.6). `lower.parser_impl` is the only thing that names these three now.\nfn atoi(s: String) -> Option[Int] = atoi_radix(s, 10)\n\n## `parse_int_radix(s, radix)`: the same EBNF with the digit set widened to\n## `0-9a-zA-Z` cut off at `radix` (2..36; anything else is `None`).\n## Accumulates negated so that Int's minimum, whose magnitude has no positive\n## Int, still parses.\nfn atoi_radix(s: String, radix: Int) -> Option[Int] = {\n  if radix < 2 || radix > 36 {\n    return None\n  }\n  let t = str.trim(s)\n  var cur = cursor.start(t)\n  if cursor.done(t, cur) {\n    return None\n  }\n  var neg = false\n  let c0 = cursor.char(t, cur)\n  if c0 == char.code('+') || c0 == char.code('-') {\n    neg = c0 == char.code('-')\n    cur = cursor.next(t, cur)\n  }\n  if cursor.done(t, cur) {\n    return None\n  }\n  let limit = if neg { -9223372036854775807 - 1 } else { -9223372036854775807 }\n  let multmin = limit / radix\n  var acc = 0\n  while not cursor.done(t, cur) {\n    let d = digit_val(cursor.char(t, cur))\n    if d < 0 || d >= radix {\n      return None\n    }\n    if acc < multmin {\n      return None\n    }\n    acc = acc * radix\n    if acc < limit + d {\n      return None\n    }\n    acc = acc - d\n    cur = cursor.next(t, cur)\n  }\n  Some(if neg { acc } else { -acc })\n}\n\n## Does trimmed text match spec §11's float shape? sign? (digits [\".\" digits?]\n## | \".\" digits) ([eE] sign? digits)? — no suffixes, no hex floats, no\n## underscores. The special spellings are handled before this is asked.\nfn float_shape(t: String) -> Bool = {\n  var cur = cursor.start(t)\n  if cursor.done(t, cur) {\n    return false\n  }\n  let c0 = cursor.char(t, cur)\n  if c0 == char.code('+') || c0 == char.code('-') {\n    cur = cursor.next(t, cur)\n  }\n  var ipart = 0\n  while not cursor.done(t, cur) && is_ascii_digit(cursor.char(t, cur)) {\n    ipart = ipart + 1\n    cur = cursor.next(t, cur)\n  }\n  var fpart = 0\n  if not cursor.done(t, cur) && cursor.char(t, cur) == char.code('.') {\n    cur = cursor.next(t, cur)\n    while not cursor.done(t, cur) && is_ascii_digit(cursor.char(t, cur)) {\n      fpart = fpart + 1\n      cur = cursor.next(t, cur)\n    }\n  }\n  # a mantissa needs at least one digit somewhere; \"1.\" has one, \".\" has none\n  if ipart == 0 && fpart == 0 {\n    return false\n  }\n  if not cursor.done(t, cur) {\n    let ce = cursor.char(t, cur)\n    if ce != char.code('e') && ce != char.code('E') {\n      return false\n    }\n    cur = cursor.next(t, cur)\n    if not cursor.done(t, cur) {\n      let cs = cursor.char(t, cur)\n      if cs == char.code('+') || cs == char.code('-') {\n        cur = cursor.next(t, cur)\n      }\n    }\n    var epart = 0\n    while not cursor.done(t, cur) && is_ascii_digit(cursor.char(t, cur)) {\n      epart = epart + 1\n      cur = cursor.next(t, cur)\n    }\n    if epart == 0 {\n      return false\n    }\n  }\n  cursor.done(t, cur)\n}\n\n## `parse_float(s)`: the EBNF above, or exactly the three spellings `dtoa`\n## can emit — `Infinity`, `-Infinity`, `NaN` (no `+Infinity`, no signed NaN,\n## no lowercase variants), so parse(to_string(x)) always closes.\n##\n## A validated string is handed to the backend's `parse_float` primitive for\n## the decimal-to-binary conversion only. That delegation cannot reintroduce\n## host grammar skew: on this subset both hosts implement the same function —\n## IEEE 754 round-to-nearest-even of a decimal literal, which the Java spec\n## requires of `Double.parseDouble` and C's `strtod` implements on every\n## hosted platform this backend targets. Every input the two hosts ever\n## disagreed on (hex floats, `1.5f`, `inf`, Unicode digits) is refused here\n## before either host can see it.\nfn atod(s: String) -> Option[Float] = {\n  let t = str.trim(s)\n  if t == \"Infinity\" {\n    return Some(1.0 / 0.0)\n  }\n  if t == \"-Infinity\" {\n    return Some(-1.0 / 0.0)\n  }\n  if t == \"NaN\" {\n    return Some(0.0 / 0.0)\n  }\n  if not float_shape(t) {\n    return None\n  }\n  parse_float(t)\n}\n\n# The three parsers below had no test of their own. `dtoa` is pinned byte for\n# byte by scripts/dtoa-contract, which is why nothing here re-renders floats;\n# the direction that reads text was checked only by whatever happened to call\n# it, and what it *refuses* was checked by nothing at all. Refusal is most of\n# the promise: spec §11 fixes an accepted language precisely so a host parser's\n# extensions -- hex floats, `1.5f`, `inf`, Unicode digits -- cannot leak in\n# through whichever runtime is underneath.\n\ntest \"atoi takes a sign and ASCII decimal digits, and nothing around them\" {\n  assert atoi(\"0\") == Some(0)\n  assert atoi(\"42\") == Some(42)\n  assert atoi(\"+42\") == Some(42)\n  assert atoi(\"-42\") == Some(-42)\n  assert atoi(\"007\") == Some(7)\n  assert atoi(\"-0\") == Some(0)\n  # trimmed first, by Dawn's own space table -- so the pad is outside the number\n  assert atoi(\"  -5  \") == Some(-5)\n  assert atoi(\"\\t\\n 7 \\r\\n\") == Some(7)\n  # ... and only outside it: a space the trim cannot reach is a non-digit\n  assert atoi(\"4 2\") == None\n  assert atoi(\"- 5\") == None\n  # nothing left after the sign is not a number\n  assert atoi(\"\") == None\n  assert atoi(\"   \") == None\n  assert atoi(\"+\") == None\n  assert atoi(\"-\") == None\n  assert atoi(\"--5\") == None\n  # the whole string or nothing: no prefix parse, and no host spellings\n  assert atoi(\"12abc\") == None\n  assert atoi(\"0x10\") == None\n  assert atoi(\"1.0\") == None\n  assert atoi(\"1e3\") == None\n  # ASCII digits, not \"characters with a digit property\"\n  assert atoi(\"４\") == None\n  # and Dawn's space table, not Unicode's: U+00A0 is not whitespace to `trim`\n  assert atoi(\"\\u{00A0}42\") == None\n}\n\ntest \"atoi answers None at the edge of Int instead of wrapping\" {\n  # the magnitude of the minimum has no positive Int, which is why the\n  # accumulator runs negated -- the case that shape exists for\n  assert atoi(\"-9223372036854775808\") == Some(-9223372036854775807 - 1)\n  assert atoi(\"9223372036854775807\") == Some(9223372036854775807)\n  # one past each end, and far past\n  assert atoi(\"9223372036854775808\") == None\n  assert atoi(\"-9223372036854775809\") == None\n  assert atoi(\"99999999999999999999999\") == None\n  # There are two overflow guards and they catch different inputs. The three\n  # above are all stopped by the second one (`acc * radix` still fits, the\n  # digit is what does not), so a broken first guard survives them. These\n  # reach `multmin` itself: the running value is exactly one step from\n  # overflowing on the multiply, and nothing later would notice the wrap.\n  assert atoi(\"922337203685477581\") == Some(922337203685477581)\n  assert atoi(\"9223372036854775810\") == None\n  assert atoi(\"9223372036854775819\") == None\n  assert atoi(\"9223372036854775900\") == None\n  assert atoi(\"-9223372036854775810\") == None\n  assert atoi(\"-9223372036854775900\") == None\n  assert atoi(\"9999999999999999999\") == None\n  # the asymmetry is real: the positive limit is one short of the negative one\n  assert atoi(\"-9223372036854775807\") == Some(-9223372036854775807)\n}\n\ntest \"atoi_radix refuses a radix outside 2..36 and cuts the digits at it\" {\n  # a radix is a value the caller must get right, and 0 and 1 name no\n  # positional system -- so this is inquiry (spec 4.8 criterion 2), not a clamp\n  assert atoi_radix(\"1\", 0) == None\n  assert atoi_radix(\"1\", 1) == None\n  assert atoi_radix(\"1\", 37) == None\n  assert atoi_radix(\"1\", 0 - 2) == None\n  # both ends of the accepted range work\n  assert atoi_radix(\"1011\", 2) == Some(11)\n  assert atoi_radix(\"z\", 36) == Some(35)\n  assert atoi_radix(\"10\", 36) == Some(36)\n  # the digit set is cut at the radix, not at the alphabet\n  assert atoi_radix(\"102\", 2) == None\n  assert atoi_radix(\"z\", 35) == None\n  assert atoi_radix(\"y\", 35) == Some(34)\n  # case is not significant above 9, over the whole alphabet and not just the\n  # hex letters -- 'G'..'Z' is the stretch a hex-shaped digit table stops at\n  assert atoi_radix(\"ff\", 16) == Some(255)\n  assert atoi_radix(\"FF\", 16) == Some(255)\n  assert atoi_radix(\"fF\", 16) == Some(255)\n  assert atoi_radix(\"Z\", 36) == Some(35)\n  assert atoi_radix(\"G\", 36) == Some(16)\n  assert atoi_radix(\"Y\", 35) == Some(34)\n  assert atoi_radix(\"HELLO\", 36) == Some(29234652)\n  assert atoi_radix(\"HELLO\", 36) == atoi_radix(\"hello\", 36)\n  # the gap between '9' and 'A' in ASCII is not a digit\n  assert atoi_radix(\":\", 16) == None\n  assert atoi_radix(\"@\", 16) == None\n  # sign and trim work the same at every radix\n  assert atoi_radix(\"-ff\", 16) == Some(-255)\n  assert atoi_radix(\"  +11  \", 2) == Some(3)\n  # the range is the radix's, so it moves with it\n  assert atoi_radix(\"111111111111111111111111111111111111111111111111111111111111111\", 2)\n    == Some(9223372036854775807)\n  assert atoi_radix(\"1111111111111111111111111111111111111111111111111111111111111111\", 2)\n    == None\n  assert atoi_radix(\"1y2p0ij32e8e7\", 36) == Some(9223372036854775807)\n  assert atoi_radix(\"1y2p0ij32e8e8\", 36) == None\n  # atoi is this function at ten\n  assert atoi_radix(\"42\", 10) == atoi(\"42\")\n  assert atoi_radix(\"0x10\", 10) == atoi(\"0x10\")\n}\n\ntest \"atod accepts the shape spec 11 writes down, and refuses the near misses\" {\n  assert atod(\"0\") == Some(0.0)\n  assert atod(\"1\") == Some(1.0)\n  assert atod(\"-1\") == Some(-1.0)\n  assert atod(\"+1\") == Some(1.0)\n  assert atod(\"1.5\") == Some(1.5)\n  assert atod(\"+1.5\") == Some(1.5)\n  assert atod(\"00.50\") == Some(0.5)\n  # a mantissa needs a digit somewhere, but not on both sides of the point\n  assert atod(\".5\") == Some(0.5)\n  assert atod(\"-.5\") == Some(-0.5)\n  assert atod(\"1.\") == Some(1.0)\n  assert atod(\"1.e2\") == Some(100.0)\n  assert atod(\".\") == None\n  assert atod(\"-.\") == None\n  # the exponent, both cases and all three sign spellings\n  assert atod(\"1e5\") == Some(100000.0)\n  assert atod(\"1E5\") == Some(100000.0)\n  assert atod(\"1e+5\") == Some(100000.0)\n  assert atod(\"1e-5\") == Some(0.00001)\n  assert atod(\".5e1\") == Some(5.0)\n  assert atod(\"0e0\") == Some(0.0)\n  # an `e` with no digits after it is not an exponent\n  assert atod(\"1e\") == None\n  assert atod(\"1e+\") == None\n  assert atod(\"1e-\") == None\n  assert atod(\"e5\") == None\n  # trimmed at the ends, refused in the middle\n  assert atod(\"  1.5  \") == Some(1.5)\n  assert atod(\"1 5\") == None\n  assert atod(\"1 . 5\") == None\n  # nothing at all\n  assert atod(\"\") == None\n  assert atod(\"   \") == None\n  assert atod(\"-\") == None\n  assert atod(\"+\") == None\n  assert atod(\"--1\") == None\n  assert atod(\"1.2.3\") == None\n  # the host spellings this refusal exists to keep out\n  assert atod(\"0x10\") == None\n  assert atod(\"1.5f\") == None\n  assert atod(\"1d5\") == None\n  assert atod(\"1_000\") == None\n  assert atod(\"٤\") == None\n}\n\ntest \"atod knows exactly the three spellings dtoa emits, and no synonyms\" {\n  # the pair that closes: these are the only non-numeric strings dtoa produces\n  assert dtoa(1.0 / 0.0) == \"Infinity\"\n  assert dtoa(-1.0 / 0.0) == \"-Infinity\"\n  assert dtoa(0.0 / 0.0) == \"NaN\"\n  assert atod(\"Infinity\") == Some(1.0 / 0.0)\n  assert atod(\"-Infinity\") == Some(-1.0 / 0.0)\n  assert atod(\"  Infinity  \") == Some(1.0 / 0.0)\n  # NaN is not equal to itself, so it is asked about rather than compared\n  let nan_is_nan = match atod(\"NaN\") {\n    Some(v) -> v != v\n    None -> false\n  }\n  assert nan_is_nan\n  # every neighbouring spelling a host parser would have taken\n  assert atod(\"inf\") == None\n  assert atod(\"Inf\") == None\n  assert atod(\"INF\") == None\n  assert atod(\"infinity\") == None\n  assert atod(\"INFINITY\") == None\n  assert atod(\"nan\") == None\n  assert atod(\"NAN\") == None\n  # dtoa never writes these two, so atod does not read them\n  assert atod(\"+Infinity\") == None\n  assert atod(\"-NaN\") == None\n}\n\ntest \"atod saturates at the ends of Float rather than answering None\" {\n  # out of range is not a shape error: the conversion is IEEE, and IEEE says\n  # overflow is an infinity and underflow is a zero\n  assert atod(\"1e400\") == Some(1.0 / 0.0)\n  assert atod(\"-1e400\") == Some(-1.0 / 0.0)\n  assert atod(\"1e309\") == Some(1.0 / 0.0)\n  assert atod(\"1e-400\") == Some(0.0)\n  # ... and the last representable value on each side is not saturated\n  assert atod(\"1e308\") == Some(1.0e308)\n  assert atod(\"4.9e-324\") == Some(4.9e-324)\n  # more digits than a Float holds is a rounding, not a refusal\n  assert atod(\"123456789012345678901234567890\") == Some(1.2345678901234568e29)\n  assert atod(\"0.1\") == Some(0.1)\n\n  # dtoa's output is always readable by atod, which is the promise that makes\n  # the two a pair rather than two independent functions. Written out rather\n  # than looped: `for` needs `Iter[List[T]]`, and that impl lives in std/list,\n  # which this module does not import.\n  assert atod(dtoa(0.0)) == Some(0.0)\n  assert atod(dtoa(1.5)) == Some(1.5)\n  assert atod(dtoa(-1.5)) == Some(-1.5)\n  assert atod(dtoa(3.141592653589793)) == Some(3.141592653589793)\n  assert atod(dtoa(1.0e300)) == Some(1.0e300)\n  assert atod(dtoa(1.0e-300)) == Some(1.0e-300)\n  assert atod(dtoa(42.0)) == Some(42.0)\n  assert atod(dtoa(0.1)) == Some(0.1)\n  # negative zero survives the trip, and `==` cannot see it -- 1/x can\n  assert dtoa(-0.0) == \"-0.0\"\n  let keeps_the_sign = match atod(\"-0.0\") {\n    Some(v) -> 1.0 / v == -1.0 / 0.0\n    None -> false\n  }\n  assert keeps_the_sign\n}\n")
  } else if name == "list.dawn" {
    Some("## Operations on the persistent `List`: mapping, folding, searching,\n## sorting, and the quantifiers. `map`, `filter`, `fold` and the sort\n## family are in the prelude and need no `use`.\n#\n# These are the \"layer 2\" of docs/pure-ffi-design.md section 3.3: ordinary Dawn\n# recursion over the primitives that must stay in the compiler. Nothing here\n# needs `unsafe_pure` — and it could not use it anyway, since these functions\n# are effect-polymorphic and the stamp deliberately refuses to mask an effect\n# variable. That refusal is what pushed the higher-order functions onto this\n# path in the first place.\n#\n# The accumulator helpers are module-level rather than local functions because a\n# local function may not declare an effect variable (spec section 3.1). Each is\n# self-tail-recursive, which the compiler turns into a loop, and appends with\n# `++`, which is O(1) amortized on the list representation (spec section 2.2) —\n# without that, every one of these would be quadratic.\n\n# ---- iteration ----\n#\n# Everything that walks a whole list, here and in the compiler, goes through\n# the impl below. `for x in xs` desugars to the same four methods (lower.dawn's\n# lower_for_iter, #44 knife 2) rather than to an index loop, and so does every\n# sequential helper in this file — the unqualified `iter_*` calls resolve to\n# the prelude trait's methods and devirtualise straight back here.\n#\n# The difference is not style: an index walk hardwires \"this collection can be\n# randomly indexed\", which costs nothing on today's flat representation and\n# O(log n) on the tree D3 replaces it with — measured 8-18x slower and widening\n# with n. Behind a cursor, the representation changes and its callers do not.\n#\n# A cursor is an index today because the representation is flat. When it stops\n# being flat, `Cur` and these four bodies change and nothing else does.\n\nalias Cur = Int\n\nimpl[T] Iter[List[T]] {\n  type Cur = Int\n  type Item = T\n\n  fn iter_start(xs: List[T]) -> Int = 0\n  fn iter_done(xs: List[T], c: Int) -> Bool = c >= len(xs)\n  fn iter_next(xs: List[T], c: Int) -> Int = c + 1\n  fn iter_get(xs: List[T], c: Int) -> T = xs[c]\n}\n\n# ---- queries ----\n\n## Whether `xs` has no elements. The prelude answers \"how many\" (`len`) for\n## every container; this is the other half, spelled the same way for all of\n## them (CONTRIBUTING §naming). It asks the cursor rather than comparing a\n## count, so it stays O(1) on a representation whose length is not.\npub fn is_empty[T](xs: List[T]) -> Bool = iter_done(xs, iter_start(xs))\n\n# ---- sequential walks ----\n\nfn map_go[T, U](xs: List[T], f: fn(T) -> U !e, c: Cur, acc: List[U]) -> List[U] !e =\n  if iter_done(xs, c) { acc }\n  else { map_go(xs, f, iter_next(xs, c), acc ++ [f(iter_get(xs, c))]) }\n\n## `f` applied to every element, in order.\npub fn map[T, U](xs: List[T], f: fn(T) -> U !e) -> List[U] !e = {\n  let empty: List[U] = []\n  map_go(xs, f, iter_start(xs), empty)\n}\n\nfn filter_go[T](xs: List[T], f: fn(T) -> Bool !e, c: Cur, acc: List[T]) -> List[T] !e =\n  if iter_done(xs, c) { acc }\n  else {\n    let x = iter_get(xs, c)\n    filter_go(xs, f, iter_next(xs, c), if f(x) { acc ++ [x] } else { acc })\n  }\n\n## The elements satisfying `f`, in order.\npub fn filter[T](xs: List[T], f: fn(T) -> Bool !e) -> List[T] !e = {\n  let empty: List[T] = []\n  filter_go(xs, f, iter_start(xs), empty)\n}\n\nfn fold_go[T, A](xs: List[T], f: fn(A, T) -> A !e, c: Cur, acc: A) -> A !e =\n  if iter_done(xs, c) { acc }\n  else { fold_go(xs, f, iter_next(xs, c), f(acc, iter_get(xs, c))) }\n\n## Reduce from the left: `f(f(f(init, x0), x1), ...)`.\npub fn fold[T, A](xs: List[T], init: A, f: fn(A, T) -> A !e) -> A !e =\n  fold_go(xs, f, iter_start(xs), init)\n\nfn find_go[T](xs: List[T], pred: fn(T) -> Bool !e, c: Cur) -> Option[T] !e =\n  if iter_done(xs, c) { None }\n  else {\n    let x = iter_get(xs, c)\n    if pred(x) { Some(x) } else { find_go(xs, pred, iter_next(xs, c)) }\n  }\n\n## The first element satisfying `pred`, or `None`.\npub fn find[T](xs: List[T], pred: fn(T) -> Bool !e) -> Option[T] !e =\n  find_go(xs, pred, iter_start(xs))\n\n# ---- membership and quantifiers ----\n#\n# Each of these stops at the first element that settles the question. `fold`\n# cannot: it is defined to visit every element, so an `any` written as a fold\n# over `||` is a full walk wearing a short-circuit's name -- six of those were\n# in the tree, next to 31 `||` chains asking whether a constant was in a set of\n# three and 32 hand-written `var found = false` loops.\n#\n# They walk with the same four-function cursor everything else here does, so\n# \"stops early\" survives the representation change D3 makes.\n\nfn any_go[T](xs: List[T], f: fn(T) -> Bool !e, c: Cur) -> Bool !e =\n  if iter_done(xs, c) { false }\n  else if f(iter_get(xs, c)) { true }\n  else { any_go(xs, f, iter_next(xs, c)) }\n\n## Whether `f` holds for at least one element. `false` for the empty list.\n## Short-circuits: `f` runs on the elements up to the first that satisfies it\n## and no further, which is observable when `f` has an effect.\npub fn any[T](xs: List[T], f: fn(T) -> Bool !e) -> Bool !e = any_go(xs, f, iter_start(xs))\n\nfn all_go[T](xs: List[T], f: fn(T) -> Bool !e, c: Cur) -> Bool !e =\n  if iter_done(xs, c) { true }\n  else if f(iter_get(xs, c)) { all_go(xs, f, iter_next(xs, c)) }\n  else { false }\n\n## Whether `f` holds for every element. `true` for the empty list.\n## Short-circuits at the first element that fails, as `any` does.\npub fn all[T](xs: List[T], f: fn(T) -> Bool !e) -> Bool !e = all_go(xs, f, iter_start(xs))\n\n## Whether `f` holds for no element. `true` for the empty list.\n## Short-circuits at the first element that satisfies `f`, as `any` does.\n##\n## The third of the three quantifiers, and the one a caller otherwise spells\n## `not any(xs, f)` -- which reads as a negated question rather than as the\n## question it is, and puts the negation where a reader has to unwind it.\n## Defined as that negation, so the short-circuit and the empty-list answer are\n## `any`'s by construction rather than by a second walk agreeing with it.\npub fn none[T](xs: List[T], f: fn(T) -> Bool !e) -> Bool !e = not any(xs, f)\n\nfn index_go[T: Eq](xs: List[T], x: T, c: Cur, i: Int) -> Option[Int] =\n  if iter_done(xs, c) { None }\n  else if eq(iter_get(xs, c), x) { Some(i) }\n  else { index_go(xs, x, iter_next(xs, c), i + 1) }\n\n## The index of the first element equal to `x`, or `None`.\n##\n## An element index in `[0, len)`, and not a position: the `index_of` that\n## search for a *sub*sequence (`str`, `bytes`) can answer `len`, because an\n## empty needle matches past the last element. This one compares elements, so\n## every answer it gives names one.\n##\n## Inquiry (spec §4.8, criterion 2): a miss is a branch the caller takes. The\n## currency is `str.index_of`'s -- `Option[Int]`, never a `-1`, which is the\n## one sentinel this library does not hand out.\npub fn index_of[T: Eq](xs: List[T], x: T) -> Option[Int] =\n  index_go(xs, x, iter_start(xs), 0)\n\n## Whether some element equals `x`. Stops at the first match; the same answer\n## as `index_of(xs, x)` being `Some`, and the same walk.\npub fn contains[T: Eq](xs: List[T], x: T) -> Bool =\n  match index_of(xs, x) {\n    Some(_) -> true\n    None -> false\n  }\n\n## The elements with later duplicates dropped: every value survives once, at\n## the position of its first occurrence.\n##\n## `Eq + Hash` and not `Eq` alone, which is the one place this family asks for\n## more than the audit did. An `Eq`-only dedupe rescans the output for each\n## element and is quadratic, and what callers deduplicate here are lists of\n## module paths, file names and diagnostics -- the sizes where that starts to\n## cost. A `Set` is `Eq + Hash` by construction, and it already answers the\n## ordering clause: a set collapses duplicates keeping the first occurrence's\n## position and gives them back in that order, so this is one line rather than\n## a second implementation of the same rule.\n##\n## `set_from`/`set_to_list` are the same primitives `std/set` forwards to, not\n## a second route to the structure; why this module calls them directly is in\n## `docs/stdlib-impl-notes.md`.\npub fn unique[T: Eq + Hash](xs: List[T]) -> List[T] = set_to_list(set_from(xs))\n\n# ---- by position ----\n#\n# `take`/`drop`/`slice`/`reverse` are positional by nature: one asks for a\n# range, the other for the other end. They stay on `get` and stay O(1) per\n# element on a flat list. D3 does not de-index them — it replaces them, since\n# an ordered tree cuts a range by splitting in O(log n) rather than by copying\n# elements one at a time, and reverses by walking its own structure backwards.\n\nfn slice_go[T](xs: List[T], i: Int, stop: Int, acc: List[T]) -> List[T] =\n  if i >= stop { acc }\n  else { slice_go(xs, i + 1, stop, acc ++ [get(xs, i).expect(\"index below length\")]) }\n\nfn clamp(n: Int, hi: Int) -> Int = if n < 0 { 0 } else { if n > hi { hi } else { n } }\n\n## The first `n` elements; `n` is clamped into range, so this never panics.\npub fn take[T](xs: List[T], n: Int) -> List[T] = {\n  let empty: List[T] = []\n  slice_go(xs, 0, clamp(n, len(xs)), empty)\n}\n\n## Everything after the first `n` elements; `n` is clamped into range.\npub fn drop[T](xs: List[T], n: Int) -> List[T] = {\n  let empty: List[T] = []\n  slice_go(xs, clamp(n, len(xs)), len(xs), empty)\n}\n\n## The elements in `[from, to)`. Both ends are clamped into range, so\n## out-of-bounds indices never panic; `from >= to` yields the empty list.\npub fn slice[T](xs: List[T], from: Int, to: Int) -> List[T] = {\n  let empty: List[T] = []\n  slice_go(xs, clamp(from, len(xs)), clamp(to, len(xs)), empty)\n}\n\nfn reverse_go[T](xs: List[T], i: Int, acc: List[T]) -> List[T] =\n  if i < 0 { acc }\n  else { reverse_go(xs, i - 1, acc ++ [get(xs, i).expect(\"index below length\")]) }\n\n## A reversed copy; the input is not changed.\npub fn reverse[T](xs: List[T]) -> List[T] = {\n  let empty: List[T] = []\n  reverse_go(xs, len(xs) - 1, empty)\n}\n\n## Ascending stable sort; elements need `Ord`. Delegates to `sort_by` with the\n## bound `cmp` — the dictionary crosses as an ordinary captured value, which is\n## what let this leave the builtin table (docs/pure-ffi-design.md section 14).\npub fn sort[T: Ord](xs: List[T]) -> List[T] = sort_by(xs, (a, b) => cmp(a, b))\n\n# One walk serves max_by and min_by. `key` runs exactly once per element and\n# only a strictly better key replaces the champion, so the first extreme wins —\n# both observable (effectful keys, ties), both inherited from the retired\n# builtin. The direction is a Bool rather than a ±1 multiplier because `cmp`\n# contracts sign, not magnitude: scaling its result could overflow.\nfn best_by_go[T, K: Ord](\n  xs: List[T], key: fn(T) -> K !e, c: Cur, bx: T, bk: K, greater: Bool\n) -> T !e =\n  if iter_done(xs, c) { bx }\n  else {\n    let x = iter_get(xs, c)\n    let k = key(x)\n    let cp = cmp(k, bk)\n    let better = if greater { cp > 0 } else { cp < 0 }\n    if better { best_by_go(xs, key, iter_next(xs, c), x, k, greater) }\n    else { best_by_go(xs, key, iter_next(xs, c), bx, bk, greater) }\n  }\n\n## The first element whose key is greatest; `None` when empty. Keys need `Ord`;\n## `key` runs once per element.\npub fn max_by[T, K: Ord](xs: List[T], key: fn(T) -> K !e) -> Option[T] !e = {\n  let c = iter_start(xs)\n  if iter_done(xs, c) { None }\n  else {\n    let x0 = iter_get(xs, c)\n    Some(best_by_go(xs, key, iter_next(xs, c), x0, key(x0), true))\n  }\n}\n\n## The first element whose key is least; `None` when empty. Keys need `Ord`;\n## `key` runs once per element.\npub fn min_by[T, K: Ord](xs: List[T], key: fn(T) -> K !e) -> Option[T] !e = {\n  let c = iter_start(xs)\n  if iter_done(xs, c) { None }\n  else {\n    let x0 = iter_get(xs, c)\n    Some(best_by_go(xs, key, iter_next(xs, c), x0, key(x0), false))\n  }\n}\n\n## The first greatest element; `None` when empty. Elements need `Ord`.\npub fn max[T: Ord](xs: List[T]) -> Option[T] = max_by(xs, x => x)\n\n## The first least element; `None` when empty. Elements need `Ord`.\npub fn min[T: Ord](xs: List[T]) -> Option[T] = min_by(xs, x => x)\n\n# ---- Eq / Hash / Ord for List (trait-v2-design.md 决策 6) ----\n#\n# Until trait v2 these three were the compiler's business: `==` on a list fell\n# through to a `struct_eq` intrinsic, which each backend answered its own way,\n# and `Ord[List[T]]` did not exist at all, so `sort` refused a list of lists.\n# A conditional impl is how a container says what it means, in Dawn, once.\n#\n# The hash matches the shape the JVM's list hash already had (seed 1, step\n# `31 * acc + h`), because `hash` and the runtime's own bucketing must not\n# disagree about the same value.\n#\n# Two lists take two cursors: a cursor belongs to the list it walks, so there\n# is no single \"position i\" to share between them.\n\nfn eq_go[T: Eq](a: List[T], b: List[T], ca: Cur, cb: Cur) -> Bool =\n  if iter_done(a, ca) {\n    true\n  } else if eq(iter_get(a, ca), iter_get(b, cb)) {\n    eq_go(a, b, iter_next(a, ca), iter_next(b, cb))\n  } else {\n    false\n  }\n\n## Same length, and equal elements in order.\nimpl[T: Eq] Eq[List[T]] {\n  fn eq(a: List[T], b: List[T]) -> Bool =\n    if len(a) != len(b) { false } else { eq_go(a, b, iter_start(a), iter_start(b)) }\n}\n\nfn hash_go[T: Hash](xs: List[T], c: Cur, acc: Int) -> Int =\n  if iter_done(xs, c) {\n    acc\n  } else {\n    hash_go(xs, iter_next(xs, c), acc * 31 + hash(iter_get(xs, c)))\n  }\n\nimpl[T: Hash] Hash[List[T]] {\n  fn hash(xs: List[T]) -> Int = hash_go(xs, iter_start(xs), 1)\n}\n\nfn cmp_go[T: Ord](a: List[T], b: List[T], ca: Cur, cb: Cur) -> Int =\n  if iter_done(a, ca) {\n    if iter_done(b, cb) { 0 } else { -1 }\n  } else if iter_done(b, cb) {\n    1\n  } else {\n    let c = cmp(iter_get(a, ca), iter_get(b, cb))\n    if c != 0 { c } else { cmp_go(a, b, iter_next(a, ca), iter_next(b, cb)) }\n  }\n\n## Lexicographic: the first differing element decides, and a prefix is less\n## than what extends it.\nimpl[T: Ord] Ord[List[T]] {\n  fn cmp(a: List[T], b: List[T]) -> Int = cmp_go(a, b, iter_start(a), iter_start(b))\n}\n\n# \"Am I at the first element?\" was `i == 0`. A cursor cannot be asked that, so\n# the separator carries its own state -- the one thing dropping the index costs.\nfn show_go[T: Show](xs: List[T], c: Cur, first: Bool, acc: String) -> String =\n  if iter_done(xs, c) {\n    acc\n  } else {\n    show_go(xs, iter_next(xs, c), false,\n      acc ++ (if first { \"\" } else { \", \" }) ++ show(iter_get(xs, c)))\n  }\n\n## `[e0, e1]`, each element in its nested form -- so a String element is\n## quoted where the list itself is not.\nimpl[T: Show] Show[List[T]] {\n  fn show(xs: List[T]) -> String = \"[\" ++ show_go(xs, iter_start(xs), true, \"\") ++ \"]\"\n}\n\n# ---- tests ----\n#\n# The promises above, at the edges that a walk written the obvious way gets\n# wrong: the empty list, an index outside the list, and a tie.\n#\n# Short-circuiting is checked by making the predicate `panic` on the elements a\n# short-circuiting walk must never reach. A counter would need a `var` the\n# closure could write; a panic needs nothing, and it fails loudly in the one\n# direction that matters -- a full walk cannot pass.\n\ntest \"is_empty asks the cursor rather than comparing a count\" {\n  let e: List[Int] = []\n  assert is_empty(e)\n  assert not is_empty([0])\n  assert not is_empty([1, 2, 3])\n}\n\ntest \"the quantifiers are vacuous on the empty list and stop at the answer\" {\n  let e: List[Int] = []\n  assert not any(e, x => x > 0)\n  assert all(e, x => x > 0)\n  assert none(e, x => x > 0)\n  assert any([1, 2, 3], x => x == 2)\n  assert not any([1, 2, 3], x => x == 9)\n  assert all([1, 2, 3], x => x > 0)\n  assert not all([1, 2, 3], x => x > 1)\n  assert none([1, 2, 3], x => x == 9)\n  assert none([1, 2, 3], x => x > 99)\n  assert not none([1, 2, 3], x => x == 2)\n  # all three agree on the same predicate, which is what makes them one family\n  assert none([1, 2, 3], x => x > 9) == not any([1, 2, 3], x => x > 9)\n  assert none([1, 2, 3], x => x > 1) == not any([1, 2, 3], x => x > 1)\n  assert none([1, 2, 3], x => x > 0) == not all([1, 2, 3], x => x > 0)\n  # `any` stops at the first element that satisfies it: reaching the second\n  # would panic, so passing is the proof it stopped\n  assert any([1, 2, 3], x => if x == 1 { true } else { panic(\"any walked past the answer\") })\n  # and `all` stops at the first that fails\n  assert not all([1, 2, 3], x => if x == 1 { false } else { panic(\"all walked past the answer\") })\n  # `none` inherits the short circuit rather than re-implementing it\n  assert not none([1, 2, 3], x => if x == 1 { true } else { panic(\"none walked past the answer\") })\n}\n\ntest \"index_of and contains answer about the first match, never with a sentinel\" {\n  assert index_of([10, 20, 30, 20], 20).unwrap_or(0 - 1) == 1\n  assert index_of([10, 20], 10).unwrap_or(0 - 1) == 0\n  assert index_of([10, 20], 99) == None\n  let e: List[Int] = []\n  assert index_of(e, 1) == None\n  assert contains([10, 20], 20)\n  assert not contains([10, 20], 99)\n  assert not contains(e, 1)\n  assert contains([\"a\", \"b\"], \"b\")\n}\n\ntest \"take, drop and slice clamp their bounds instead of panicking\" {\n  let xs = [1, 2, 3, 4, 5]\n  let e: List[Int] = []\n  assert take(xs, 2) == [1, 2]\n  assert take(xs, 0) == e\n  assert take(xs, 99) == xs\n  assert take(xs, 0 - 1) == e\n  assert take(e, 3) == e\n  assert drop(xs, 2) == [3, 4, 5]\n  assert drop(xs, 0) == xs\n  assert drop(xs, 99) == e\n  assert drop(xs, 0 - 1) == xs\n  assert drop(e, 3) == e\n  assert slice(xs, 1, 3) == [2, 3]\n  assert slice(xs, 0, 5) == xs\n  assert slice(xs, 3, 1) == e\n  assert slice(xs, 2, 2) == e\n  assert slice(xs, 0 - 4, 2) == [1, 2]\n  assert slice(xs, 3, 99) == [4, 5]\n  assert slice(xs, 99, 200) == e\n}\n\ntest \"reverse copies, and leaves the input alone\" {\n  let xs = [1, 2, 3]\n  let e: List[Int] = []\n  assert reverse(xs) == [3, 2, 1]\n  assert xs == [1, 2, 3]\n  assert reverse(e) == e\n  assert reverse([1]) == [1]\n  assert reverse(reverse(xs)) == xs\n}\n\ntest \"max_by and min_by answer None on the empty list and keep the first extreme\" {\n  let e: List[Int] = []\n  assert max_by(e, x => x) == None\n  assert min_by(e, x => x) == None\n  assert max(e) == None\n  assert min(e) == None\n  assert max_by([3, 1, 4, 1], x => x).unwrap_or(0) == 4\n  assert min_by([3, 1, 4, 1], x => x).unwrap_or(0) == 1\n  assert max([3, 1, 4]).unwrap_or(0) == 4\n  assert min([3, 1, 4]).unwrap_or(0) == 1\n  assert max([7]).unwrap_or(0) == 7\n  # a tie goes to the first: only a strictly better key replaces the champion,\n  # and both directions inherit that from the one walk underneath. The key\n  # collides deliberately -- with distinct keys there is no tie to observe.\n  assert max_by([1, 2, 3], x => x % 2).unwrap_or(0) == 1\n  assert min_by([2, 4, 1], x => x % 2).unwrap_or(0) == 2\n  # the key decides, not the element\n  assert max_by([1, 2, 3], x => 0 - x).unwrap_or(0) == 1\n}\n\ntest \"sort is ascending, and sort_by is stable\" {\n  let e: List[Int] = []\n  assert sort([3, 1, 2]) == [1, 2, 3]\n  assert sort(e) == e\n  assert sort([1]) == [1]\n  assert sort([2, 2, 1]) == [1, 2, 2]\n  assert sort([\"b\", \"a\", \"c\"]) == [\"a\", \"b\", \"c\"]\n  # equal keys come back in the order they went in\n  assert sort_by([32, 21, 2, 11], (a, b) => cmp(a % 10, b % 10)) == [21, 11, 32, 2]\n}\n\ntest \"unique keeps every value once, at its first occurrence\" {\n  let e: List[Int] = []\n  assert unique([3, 1, 3, 2, 1]) == [3, 1, 2]\n  assert unique(e) == e\n  assert unique([1, 1, 1]) == [1]\n  assert unique([\"b\", \"a\", \"b\"]) == [\"b\", \"a\"]\n}\n\ntest \"map, filter, fold and find walk in order\" {\n  let e: List[Int] = []\n  assert map([1, 2, 3], x => x * 2) == [2, 4, 6]\n  assert map(e, x => x * 2) == e\n  assert map([1, 2], x => show(x)) == [\"1\", \"2\"]\n  assert filter([1, 2, 3, 4], x => x % 2 == 0) == [2, 4]\n  assert filter(e, x => true) == e\n  assert filter([1, 2], x => false) == e\n  assert fold([1, 2, 3], 0, (a, x) => a + x) == 6\n  assert fold(e, 7, (a, x) => a + x) == 7\n  # left to right, which only a non-commutative step can show\n  assert fold([\"a\", \"b\", \"c\"], \"\", (a, x) => a ++ x) == \"abc\"\n  assert find([1, 2, 3], x => x > 1).unwrap_or(0) == 2\n  assert find([1, 2, 3], x => x > 9) == None\n  assert find(e, x => true) == None\n}\n\ntest \"Eq, Ord, Hash and Show on List say what the container means\" {\n  let e: List[Int] = []\n  assert [1, 2] == [1, 2]\n  assert not ([1, 2] == [2, 1])\n  assert not ([1, 2] == [1, 2, 3])\n  assert e == e\n  assert not (e == [1])\n  assert [[1], [2]] == [[1], [2]]\n  assert not ([[1], [2]] == [[1], [3]])\n  # lexicographic, and a prefix is less than what extends it\n  assert cmp([1, 2], [1, 3]) < 0\n  assert cmp([1, 2], [1, 2]) == 0\n  assert cmp([2], [1, 9]) > 0\n  assert cmp(e, [1]) < 0\n  assert cmp([1], e) > 0\n  assert cmp(e, e) == 0\n  assert sort([[2], [1, 9], [1]]) == [[1], [1, 9], [2]]\n  # equal lists hash equal -- the runtime buckets by this\n  assert hash([1, 2]) == hash([1, 2])\n  assert hash(e) == hash(e)\n  # a String element is shown in its nested (quoted) form, the list is not\n  assert show([1, 2]) == \"[1, 2]\"\n  assert show(e) == \"[]\"\n  assert show([\"a\", \"b\"]) == \"[\\\"a\\\", \\\"b\\\"]\"\n  assert show([[1], [2]]) == \"[[1], [2]]\"\n}\n\ntest \"for over a List walks every element once, in order\" {\n  var seen = \"\"\n  var n = 0\n  for x in [10, 20, 30] {\n    seen = seen ++ show(x) ++ \";\"\n    n = n + 1\n  }\n  assert n == 3\n  assert seen == \"10;20;30;\"\n  let e: List[Int] = []\n  var empty = 0\n  for _x in e { empty = empty + 1 }\n  assert empty == 0\n}\n")
  } else if name == "bytes.dawn" {
    Some("## Byte strings: UTF-8 and Latin-1 decoding, slicing, search, and the hex\n## and base64 text encodings (spec §9.5.1).\n#\n# Short names, module-qualified at the call site: `use std/bytes`, then\n# `bytes.len(b)` / `bytes.at(b, i)`.\n#\n# These write over the bytes_* intrinsics the JVM backend emits into\n# dawn/rt/Bytes (utf8/decode/len/at/slice); the handwritten dawn.rt.StdBytes is\n# retired. No `unsafe_pure` and no `use java` any more — a bytes_* call is a\n# language primitive, not a Java call the checker has to be told is really pure.\n#\n# `Bytes` crosses the FFI boundary in both directions already (it is a JVM\n# `byte[]`), so nothing here needs a workaround for the argument or return type.\n# What needs one is the *result* shapes: out-of-range comes back as a -1\n# sentinel and a bad charset as `None`, turned into panic/`Option` on this side.\n#\n# `Bytes ++ Bytes` is an operator, not a function, and stays in the compiler.\n\nuse std/char\n\n# ---- building bytes ----\n\n## A byte buffer under construction.\n##\n## `Bytes` is finished and immutable, and until this existed it was also\n## *unproduceable*: you could take a string's UTF-8, slice it and read it, but\n## a byte you computed had no spelling at all -- `0x80` would need a string\n## whose UTF-8 encoding is that single byte, and there is none. Anything that\n## decompresses writes bytes it computed, so this is the missing half.\n##\n## It is a value like everything else -- `put` returns the buffer rather than\n## mutating it -- and it inherits `array_push`'s clause: the backend extends in\n## place exactly when the version it is handed is the only one that could be\n## reading the frontier, so building a megabyte is linear and not quadratic.\n## `buf_at` is here because the callers that need this are decompressors, and an\n## LZ77 back-reference reads output that was written a moment ago.\npub opaque type Buf = Array[Int]\n\n## An empty buffer.\npub fn buf() -> Buf = array_new()\n\n## Append one byte. A value outside 0..255 is truncated, as a byte store is.\npub fn put(b: Buf, byte: Int) -> Buf = array_push(b, byte & 0xFF)\n\n## Append all of `src`.\npub fn put_bytes(b: Buf, src: Bytes) -> Buf = {\n  var out = b\n  var i = 0\n  let n = bytes_len(src)\n  while i < n {\n    out = array_push(out, bytes_at(src, i))\n    i = i + 1\n  }\n  out\n}\n\n## How many bytes have been written.\n##\n## `size` and not `len`: a named exception to one-concept-one-name, because\n## `len(b: Bytes)` above already holds that name and Dawn has no overloading\n## (CONTRIBUTING §naming; history in `docs/stdlib-naming.md`).\npub fn size(b: Buf) -> Int = array_len(b)\n\n## The byte at `i`, as 0..255. Out of range panics, exactly as `at(b: Bytes, i)`\n## does — it is the same question asked of the half-built buffer.\n##\n## `buf_at` and not `at` for the reason `size` is not `len`, and not `get`\n## because `get` is criterion 2's word and this asserts (spec §4.8). The second\n## named exception to one-concept-one-name (CONTRIBUTING §naming; history and\n## the rejected alternative in `docs/stdlib-naming.md`).\npub fn buf_at(b: Buf, i: Int) -> Int = array_get(b, i)\n\n## The finished bytes.\npub fn freeze(b: Buf) -> Bytes = bytes_from_array(b)\n\n## The UTF-8 bytes of `s`.\npub fn utf8(s: String) -> Bytes = bytes_utf8(s)\n\n## `b` decoded as UTF-8; what it cannot read becomes U+FFFD.\npub fn decode_utf8(b: Bytes) -> String = bytes_decode_utf8(b)\n\n## `b` decoded as ISO-8859-1: one code point per byte, 0..255.\npub fn decode_latin1(b: Bytes) -> String = bytes_decode_latin1(b)\n\n## Number of bytes in `b`.\npub fn len(b: Bytes) -> Int = bytes_len(b)\n\n## Whether `b` has no bytes. The same question `str.is_empty` answers, in the\n## same words (CONTRIBUTING §naming).\npub fn is_empty(b: Bytes) -> Bool = bytes_len(b) == 0\n\n## The byte at `i` as 0..255. Panics when `i` is out of range — a programming\n## error, like indexing a list past its end. The -1 the intrinsic returns is\n## that signal, and cannot collide with a real (unsigned) byte value.\npub fn at(b: Bytes, i: Int) -> Int = {\n  let v = bytes_at(b, i)\n  if v < 0 { panic(\"bytes.at: index out of range\") } else { v }\n}\n\n## The bytes in `[start, end)`. Both ends are clamped into range and\n## `start > end` yields empty, so this never panics.\npub fn slice(b: Bytes, start: Int, end: Int) -> Bytes = bytes_slice(b, start, end)\n\n## Where the first occurrence of `needle` at or after `from` begins, or `None`.\n##\n## A *position* in `[0, len]` counted in bytes, not the index of an element: an\n## empty needle matches at the start when that position exists, and `len(b)` is\n## a legal answer though no byte lives there. A negative `from` is clamped to\n## zero; a `from` past `len(b)` is a miss, including for an empty needle. Pure\n## Dawn over bytes_len/bytes_at — the search loop is not an intrinsic.\npub fn index_of(b: Bytes, needle: Bytes, from: Int) -> Option[Int] = {\n  let hlen = bytes_len(b)\n  let nlen = bytes_len(needle)\n  let start = if from < 0 { 0 } else { from }\n  let last_start: Int = if nlen == 0 {\n    hlen\n  } else if start >= hlen {\n    0 - 1\n  } else {\n    let remaining: Int = hlen - start\n    if nlen > remaining { 0 - 1 } else { hlen - nlen }\n  }\n  index_scan(b, needle, nlen, start, last_start)\n}\n\nfn index_scan(b: Bytes, needle: Bytes, nlen: Int, start: Int, last_start: Int) -> Option[Int] = {\n  if start > last_start { return None }\n  var i: Int = start\n  while true {\n    if matches_at(b, needle, nlen, i) { return Some(i) }\n    if i >= last_start { return None }\n    i = i + 1\n  }\n  None\n}\n\nfn matches_at(b: Bytes, needle: Bytes, nlen: Int, start: Int) -> Bool = {\n  var hay_index: Int = start\n  var needle_index: Int = 0\n  while needle_index < nlen {\n    if bytes_at(b, hay_index) != bytes_at(needle, needle_index) { return false }\n    needle_index = needle_index + 1\n    if needle_index < nlen { hay_index = hay_index + 1 }\n  }\n  true\n}\n\n# ---- text encodings ----\n#\n# Hex and Base64 are byte arithmetic and a lookup table, which makes them the\n# kind of thing that has no business being a host call -- and yet the same\n# \"four bits to a hex digit\" was written eight times across this tree (two of\n# them disagreeing about case), and Base64 had no pure spelling at all, so\n# crypto and WebDAV each reached for `use java java.util.Base64` and stained\n# an otherwise pure call chain with `!io` all the way up\n# (audit RD-03/RD-10). Written here once, both backends get them for free.\n#\n# The alphabets are arithmetic rather than a string to index into: indexing a\n# constant string costs a code-point walk per digit, and the ranges are\n# contiguous in ASCII anyway.\n\n# The digits are characters, and arithmetic on them is not: `Char` is opaque\n# over `Int` outside std/char (spec §2.7), so a table walked by adding an\n# offset says `char.code` on the way in and `char_unchecked` on the way out.\n# Both directions are safe here by construction -- the offsets are bounded by\n# the radix, so every result is an ASCII digit or letter.\nfn hex_char(v: Int) -> Char =\n  char_unchecked(if v < 10 { char.code('0') + v } else { char.code('a') + (v - 10) })\n\nfn hex_val(c: Char) -> Int =\n  if c >= '0' && c <= '9' {\n    char.code(c) - char.code('0')\n  } else if c >= 'a' && c <= 'f' {\n    char.code(c) - char.code('a') + 10\n  } else if c >= 'A' && c <= 'F' {\n    char.code(c) - char.code('A') + 10\n  } else {\n    -1\n  }\n\n## `b` as hexadecimal: two digits per byte, most significant first, nothing\n## between them. Lower case, which is the canonical spelling this library\n## produces -- `from_hex` reads either case, `to_hex` writes one.\npub fn to_hex(b: Bytes) -> String = {\n  var out: List[Char] = []\n  var i = 0\n  let n = bytes_len(b)\n  while i < n {\n    let v = bytes_at(b, i)\n    out = out ++ [hex_char(v / 16), hex_char(v % 16)]\n    i = i + 1\n  }\n  from_code_points(out)\n}\n\n## `s` read as hexadecimal, or `None` when it is not an even-length run of hex\n## digits. Either case is accepted; nothing else is, not even whitespace.\n##\n## Inquiry (spec §4.8, criterion 2): text arriving from a file or a header is\n## checked, not asserted, so a malformed input is a branch and not a panic.\npub fn from_hex(s: String) -> Option[Bytes] = {\n  var out = buf()\n  var hi = -1\n  for c in code_points(s) {\n    let v = hex_val(c)\n    if v < 0 {\n      return None\n    }\n    if hi < 0 {\n      hi = v\n    } else {\n      out = put(out, hi * 16 + v)\n      hi = -1\n    }\n  }\n  if hi >= 0 {\n    None\n  } else {\n    Some(freeze(out))\n  }\n}\n\n# Base64 has two alphabets that differ only in the last two symbols, and two\n# padding conventions. Rather than four encoders they are two parameters:\n# `url` picks `-_` over `+/` (RFC 4648 §5) and `pad` decides whether the\n# output is rounded up to a multiple of four with `=`.\n\nfn b64_char(v: Int, url: Bool) -> Char =\n  if v < 26 {\n    char_unchecked(char.code('A') + v)\n  } else if v < 52 {\n    char_unchecked(char.code('a') + (v - 26))\n  } else if v < 62 {\n    char_unchecked(char.code('0') + (v - 52))\n  } else if v == 62 {\n    if url { '-' } else { '+' }\n  } else {\n    if url { '_' } else { '/' }\n  }\n\nfn b64_val(c: Char, url: Bool) -> Int =\n  if c >= 'A' && c <= 'Z' {\n    char.code(c) - char.code('A')\n  } else if c >= 'a' && c <= 'z' {\n    char.code(c) - char.code('a') + 26\n  } else if c >= '0' && c <= '9' {\n    char.code(c) - char.code('0') + 52\n  } else if c == (if url { '-' } else { '+' }) {\n    62\n  } else if c == (if url { '_' } else { '/' }) {\n    63\n  } else {\n    -1\n  }\n\nfn b64_encode(b: Bytes, url: Bool, pad: Bool) -> String = {\n  var out: List[Char] = []\n  let n = bytes_len(b)\n  var i = 0\n  while i + 3 <= n {\n    let x = bytes_at(b, i) * 65536 + bytes_at(b, i + 1) * 256 + bytes_at(b, i + 2)\n    out = out ++ [\n      b64_char(x / 262144, url), b64_char((x / 4096) % 64, url),\n      b64_char((x / 64) % 64, url), b64_char(x % 64, url)\n    ]\n    i = i + 3\n  }\n  let rest = n - i\n  if rest == 1 {\n    let x = bytes_at(b, i) * 16\n    out = out ++ [b64_char(x / 64, url), b64_char(x % 64, url)]\n    if pad {\n      out = out ++ ['=', '=']\n    }\n  } else if rest == 2 {\n    let x = bytes_at(b, i) * 1024 + bytes_at(b, i + 1) * 4\n    out = out ++ [b64_char(x / 4096, url), b64_char((x / 64) % 64, url), b64_char(x % 64, url)]\n    if pad {\n      out = out ++ ['=']\n    }\n  }\n  from_code_points(out)\n}\n\n# One decoder for both alphabets. It accepts a trailing `=` run or no padding\n# at all -- the padded and unpadded spellings of the same bytes have to read\n# back the same, since the url-safe encoder here omits padding -- but it\n# rejects everything else: a wrong number of `=`, a symbol after them, a\n# leftover group of one character (which encodes no byte), and a final group\n# whose unused low bits are not zero. That last check is what makes decoding\n# injective: without it `AB==` and `AC==` would both be one byte.\nfn b64_decode(s: String, url: Bool) -> Option[Bytes] = {\n  var out = buf()\n  var acc = 0\n  var have = 0\n  var pad = 0\n  for c in code_points(s) {\n    if c == '=' {\n      pad = pad + 1\n    } else if pad > 0 {\n      return None\n    } else {\n      let v = b64_val(c, url)\n      if v < 0 {\n        return None\n      }\n      acc = acc * 64 + v\n      have = have + 1\n      if have == 4 {\n        out = put(out, acc / 65536)\n        out = put(out, (acc / 256) % 256)\n        out = put(out, acc % 256)\n        acc = 0\n        have = 0\n      }\n    }\n  }\n  if have == 2 {\n    if acc % 16 != 0 || (pad != 0 && pad != 2) {\n      return None\n    }\n    out = put(out, acc / 16)\n  } else if have == 3 {\n    if acc % 4 != 0 || (pad != 0 && pad != 1) {\n      return None\n    }\n    out = put(out, acc / 1024)\n    out = put(out, (acc / 4) % 256)\n  } else if have != 0 || pad != 0 {\n    # `have == 1` encodes no byte at all, and padding with nothing to pad is\n    # not a spelling of anything either\n    return None\n  }\n  Some(freeze(out))\n}\n\n## `b` as Base64 with the standard alphabet (`A-Za-z0-9+/`, RFC 4648 §4) and\n## `=` padding to a multiple of four characters.\npub fn to_base64(b: Bytes) -> String = b64_encode(b, false, true)\n\n## `s` read as standard-alphabet Base64, or `None` when it is not.\n##\n## Inquiry (spec §4.8, criterion 2). Padding is optional on the way in even\n## though `to_base64` always writes it; the url-safe alphabet is not accepted\n## here -- `from_base64_url` is the function that reads it.\npub fn from_base64(s: String) -> Option[Bytes] = b64_decode(s, false)\n\n## `b` as Base64 with the url- and filename-safe alphabet (`A-Za-z0-9-_`,\n## RFC 4648 §5) and **no** padding, which is the shape a JWT segment, a\n## signature parameter and a path component all want -- `=` has to be\n## percent-encoded in a query and means nothing in a file name.\npub fn to_base64_url(b: Bytes) -> String = b64_encode(b, true, false)\n\n## `s` read as url-safe Base64, with or without padding, or `None` when it is\n## not. The standard alphabet's `+` and `/` are rejected here, as `-` and `_`\n## are by `from_base64`: which alphabet a string is in is the caller's claim,\n## and a decoder that guesses turns a mismatch into wrong bytes.\npub fn from_base64_url(s: String) -> Option[Bytes] = b64_decode(s, true)\n\n# ---- iteration (prelude Iter, #44 knife 2) ----\n\n## `for b in bs` yields each byte as an Int in `0..=255`, the same currency\n## `at` deals in. The cursor is a plain index: bytes are the one container\n## whose representation is contractually flat.\nimpl Iter[Bytes] {\n  type Cur = Int\n  type Item = Int\n\n  fn iter_start(b: Bytes) -> Int = 0\n  fn iter_done(b: Bytes, c: Int) -> Bool = c >= len(b)\n  fn iter_next(b: Bytes, c: Int) -> Int = c + 1\n  fn iter_get(b: Bytes, c: Int) -> Int = at(b, c)\n}\n\n# Nothing in this module had a test of its own. What that left uncovered is\n# mostly the refusals: `from_hex` and the two `from_base64` are inquiry\n# functions (spec §4.8 criterion 2) whose whole job is to answer None for text\n# that is not what it claims to be, and every caller of them is parsing\n# something that arrived from outside.\n#\n# The Base64 vectors below are RFC 4648 §10's, not a round trip through this\n# encoder. A round trip proves the two directions are inverses and says nothing\n# about whether either is Base64; these say it is.\n\ntest \"a Buf appends, reads back, and truncates what will not fit in a byte\" {\n  assert size(buf()) == 0\n  assert to_hex(freeze(buf())) == \"\"\n  assert is_empty(freeze(buf()))\n  let b = put(put(put(buf(), 0x00), 0x41), 0xFF)\n  assert size(b) == 3\n  assert buf_at(b, 0) == 0x00\n  assert buf_at(b, 1) == 0x41\n  assert buf_at(b, 2) == 0xFF\n  assert to_hex(freeze(b)) == \"0041ff\"\n  assert len(freeze(b)) == 3\n  # a byte store keeps the low eight bits, and says so rather than panicking.\n  # Asserted through `get` and not only through `freeze`: freezing narrows to\n  # bytes as well, so a `put` that stopped masking would still hex the same and\n  # only an unfrozen read can tell -- which is also where `get`'s own promise\n  # (\"as 0..255\") would be broken.\n  assert buf_at(put(buf(), 0x141), 0) == 0x41\n  assert buf_at(put(buf(), 256), 0) == 0x00\n  assert buf_at(put(buf(), -1), 0) == 0xFF\n  assert buf_at(put(buf(), -256), 0) == 0x00\n  assert to_hex(freeze(put(buf(), 0x141))) == \"41\"\n  assert to_hex(freeze(put(buf(), 256))) == \"00\"\n  assert to_hex(freeze(put(buf(), -1))) == \"ff\"\n  assert to_hex(freeze(put(buf(), -256))) == \"00\"\n  # put_bytes is the same append, in bulk\n  assert to_hex(freeze(put_bytes(buf(), utf8(\"AB\")))) == \"4142\"\n  assert to_hex(freeze(put_bytes(put(buf(), 0x41), utf8(\"B\")))) == \"4142\"\n  assert to_hex(freeze(put_bytes(buf(), utf8(\"\")))) == \"\"\n  # `get` is `at`'s clause, on the builder: a read past the frontier is a bug\n  match catch_panic(() => buf_at(b, 3)) {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  match catch_panic(() => buf_at(buf(), 0)) {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n}\n\ntest \"at asserts the index exists; slice names a stretch and clamps\" {\n  let b = utf8(\"abcdef\")\n  assert len(b) == 6\n  assert at(b, 0) == 0x61\n  assert at(b, 5) == 0x66\n  assert is_empty(utf8(\"\"))\n  assert not is_empty(b)\n  assert len(utf8(\"\")) == 0\n  # spec 4.8 criterion 1 -- the same split str.at and str.substring have\n  match catch_panic(() => at(b, 6)) {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  match catch_panic(() => at(b, -1)) {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  match catch_panic(() => at(utf8(\"\"), 0)) {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  # criterion 3: both ends clamp, and a reversed range is empty, never a panic\n  assert to_hex(slice(b, 0, 3)) == \"616263\"\n  assert to_hex(slice(b, 3, 6)) == \"646566\"\n  assert to_hex(slice(b, -5, 3)) == \"616263\"\n  assert to_hex(slice(b, 3, 99)) == \"646566\"\n  assert to_hex(slice(b, 0, 99)) == to_hex(b)\n  assert to_hex(slice(b, 4, 2)) == \"\"\n  assert to_hex(slice(b, 99, 99)) == \"\"\n  assert to_hex(slice(b, -9, -3)) == \"\"\n  assert to_hex(slice(b, 2, 2)) == \"\"\n  assert to_hex(slice(utf8(\"\"), 0, 5)) == \"\"\n  # a byte is a byte, not a code point: one astral character is four of them\n  assert len(utf8(\"😀\")) == 4\n  assert to_hex(utf8(\"😀\")) == \"f09f9880\"\n}\n\ntest \"index_of answers a byte offset, and an empty needle is at every one\" {\n  var b: Bytes = utf8(\"abcabc\")\n  assert index_of(b, utf8(\"abc\"), 0) == Some(0)\n  assert index_of(b, utf8(\"abc\"), 1) == Some(3)\n  assert index_of(b, utf8(\"c\"), 0) == Some(2)\n  assert index_of(b, utf8(\"c\"), 3) == Some(5)\n  assert index_of(b, utf8(\"c\"), 6) == None\n  assert index_of(b, utf8(\"zz\"), 0) == None\n  # a needle longer than what is left is a miss, not a partial match\n  assert index_of(utf8(\"ab\"), utf8(\"abc\"), 0) == None\n  assert index_of(b, utf8(\"abc\"), 4) == None\n  # `from` is clamped up to 0, so a negative one reads as \"from the start\"\n  assert index_of(b, utf8(\"abc\"), -5) == Some(0)\n  assert index_of(b, utf8(\"\"), -3) == Some(0)\n  # the empty needle is at every position including the end -- but not past it,\n  # which is the one place this differs from \"always Some\"\n  assert index_of(b, utf8(\"\"), 0) == Some(0)\n  assert index_of(b, utf8(\"\"), 3) == Some(3)\n  assert index_of(b, utf8(\"\"), 6) == Some(6)\n  assert index_of(b, utf8(\"\"), 7) == None\n  assert index_of(utf8(\"\"), utf8(\"\"), 0) == Some(0)\n  assert index_of(utf8(\"\"), utf8(\"a\"), 0) == None\n  # Every negative start, including Int.MIN, is the beginning.\n  assert index_of(b, utf8(\"abc\"), -9223372036854775807 - 1).unwrap_or(0 - 1) == 0\n  assert index_of(b, utf8(\"\"), -9223372036854775807 - 1).unwrap_or(0 - 1) == 0\n  assert index_of(utf8(\"\"), utf8(\"\"), -9223372036854775807 - 1).unwrap_or(0 - 1) == 0\n  # The end is a position only for an empty needle; anything past it is a miss.\n  assert index_of(b, utf8(\"\"), len(b)).unwrap_or(0 - 1) == len(b)\n  assert index_of(b, utf8(\"a\"), len(b)).unwrap_or(0 - 1) == 0 - 1\n  assert index_of(b, utf8(\"\"), 9223372036854775807).unwrap_or(0 - 1) == 0 - 1\n  assert index_of(b, utf8(\"a\"), 9223372036854775807).unwrap_or(0 - 1) == 0 - 1\n  assert index_of(utf8(\"\"), utf8(\"\"), 9223372036854775807).unwrap_or(0 - 1) == 0 - 1\n  assert index_of(utf8(\"\"), utf8(\"a\"), 9223372036854775807).unwrap_or(0 - 1) == 0 - 1\n  # The only legal start is also the last one. It must be tested before the\n  # loop decides whether another increment is possible.\n  assert index_of(utf8(\"xxabc\"), utf8(\"abc\"), 2).unwrap_or(0 - 1) == 2\n  assert index_of(utf8(\"xxabd\"), utf8(\"abc\"), 2).unwrap_or(0 - 1) == 0 - 1\n  assert index_of(utf8(\"ab\"), utf8(\"abc\"), -9223372036854775807 - 1).unwrap_or(0 - 1) == 0 - 1\n  # Doubling constructs a 131072-byte needle in 17 steps, without making this\n  # production module depend on std/str merely for a test helper.\n  b = utf8(\"a\")\n  while len(b) < 100000 { b = b ++ b }\n  assert index_of(utf8(\"x\") ++ b, b, 0).unwrap_or(0 - 1) == 1\n  assert index_of(utf8(\"x\") ++ slice(b, 0, len(b) - 1) ++ utf8(\"b\"), b, 1).unwrap_or(0 - 1) == 0 - 1\n}\n\ntest \"to_hex writes one case and from_hex reads both, or refuses\" {\n  assert to_hex(utf8(\"\")) == \"\"\n  assert to_hex(utf8(\"AB\")) == \"4142\"\n  assert to_hex(freeze(put(put(buf(), 0x0F), 0xF0))) == \"0ff0\"\n  # lower case is what this library produces -- the pin is on the case, since\n  # both spellings read back the same and only one is written\n  assert to_hex(freeze(put(buf(), 0xAB))) == \"ab\"\n  assert from_hex(\"\") == Some(utf8(\"\"))\n  assert from_hex(\"41\") == Some(utf8(\"A\"))\n  assert from_hex(\"4142\") == Some(utf8(\"AB\"))\n  assert from_hex(\"AbCd\") == from_hex(\"abcd\")\n  assert to_hex(unwrap_or(from_hex(\"AbCd\"), utf8(\"\"))) == \"abcd\"\n  # an odd digit count leaves half a byte, which is not a byte string\n  assert from_hex(\"4\") == None\n  assert from_hex(\"414\") == None\n  # and nothing else is a hex digit, not even the separators that usually are\n  assert from_hex(\"4G\") == None\n  assert from_hex(\"41 42\") == None\n  assert from_hex(\"41\\n\") == None\n  assert from_hex(\"0x41\") == None\n  assert from_hex(\"-1\") == None\n  # the round trip, in the direction that has a canonical answer\n  assert from_hex(to_hex(utf8(\"hello\"))) == Some(utf8(\"hello\"))\n}\n\ntest \"base64 answers RFC 4648's vectors, in both of its alphabets\" {\n  # §10's test vectors. These are the assertions that say this is Base64 and\n  # not merely a self-consistent pair of functions.\n  assert to_base64(utf8(\"\")) == \"\"\n  assert to_base64(utf8(\"f\")) == \"Zg==\"\n  assert to_base64(utf8(\"fo\")) == \"Zm8=\"\n  assert to_base64(utf8(\"foo\")) == \"Zm9v\"\n  assert to_base64(utf8(\"foob\")) == \"Zm9vYg==\"\n  assert to_base64(utf8(\"fooba\")) == \"Zm9vYmE=\"\n  assert to_base64(utf8(\"foobar\")) == \"Zm9vYmFy\"\n  assert from_base64(\"Zg==\") == Some(utf8(\"f\"))\n  assert from_base64(\"Zm8=\") == Some(utf8(\"fo\"))\n  assert from_base64(\"Zm9v\") == Some(utf8(\"foo\"))\n  assert from_base64(\"Zm9vYg==\") == Some(utf8(\"foob\"))\n  assert from_base64(\"Zm9vYmE=\") == Some(utf8(\"fooba\"))\n  assert from_base64(\"Zm9vYmFy\") == Some(utf8(\"foobar\"))\n  # the url-safe encoder writes the same characters and omits the padding\n  assert to_base64_url(utf8(\"\")) == \"\"\n  assert to_base64_url(utf8(\"f\")) == \"Zg\"\n  assert to_base64_url(utf8(\"fo\")) == \"Zm8\"\n  assert to_base64_url(utf8(\"foo\")) == \"Zm9v\"\n  assert to_base64_url(utf8(\"foobar\")) == \"Zm9vYmFy\"\n  # the two alphabets differ in exactly the last two symbols, which 0xFB 0xFF\n  # is chosen to reach: it encodes to values 62 and 63\n  let high = freeze(put(put(buf(), 0xFB), 0xFF))\n  assert to_base64(high) == \"+/8=\"\n  assert to_base64_url(high) == \"-_8\"\n  assert from_base64(\"+/8=\") == Some(high)\n  assert from_base64_url(\"-_8\") == Some(high)\n  assert from_base64_url(\"-_8=\") == Some(high)\n  # which alphabet a string is in is the caller's claim, so neither decoder\n  # guesses -- a mismatch is None rather than different bytes\n  assert from_base64(\"-_8=\") == None\n  assert from_base64_url(\"+/8=\") == None\n}\n\ntest \"from_base64 refuses everything that is not one spelling of some bytes\" {\n  # padding is optional on the way in, because the url-safe encoder omits it\n  assert from_base64(\"AQ==\") == from_base64(\"AQ\")\n  assert from_base64(\"Zm9vYg\") == Some(utf8(\"foob\"))\n  assert from_base64(\"\") == Some(utf8(\"\"))\n  # ... but the amount of it is not free: a group of two takes two `=`\n  assert from_base64(\"AQ=\") == None\n  assert from_base64(\"AQ===\") == None\n  assert from_base64(\"Zm9vYg=\") == None\n  assert from_base64(\"Zm9vYg===\") == None\n  assert from_base64(\"=\") == None\n  assert from_base64(\"====\") == None\n  assert from_base64(\"AAAA=\") == None\n  # a leftover group of one character encodes no byte at all\n  assert from_base64(\"A\") == None\n  assert from_base64(\"ZZZZA\") == None\n  # nothing may follow the padding\n  assert from_base64(\"A=B\") == None\n  assert from_base64(\"AQ==A\") == None\n  # This is the clause that makes decoding injective. `AB` and `AQ` both have\n  # two characters and would both be one byte, but only one of them has zero\n  # in the bits the byte does not reach -- without the check they would decode\n  # to the same 0x01 and no encoder could ever produce `AB`.\n  assert from_base64(\"AQ\") == Some(freeze(put(buf(), 0x01)))\n  assert from_base64(\"AA\") == Some(freeze(put(buf(), 0x00)))\n  assert from_base64(\"AB\") == None\n  assert from_base64(\"AC==\") == None\n  assert from_base64(\"AAB\") == None\n  assert from_base64(\"AAA\") == Some(freeze(put(put(buf(), 0x00), 0x00)))\n  # whitespace is not ignored the way some decoders ignore it\n  assert from_base64(\"Zm 9v\") == None\n  assert from_base64(\"Zm9v\\n\") == None\n  assert from_base64(\" Zm9v\") == None\n  # and neither is anything else outside the alphabet\n  assert from_base64(\"Zm9*\") == None\n  assert from_base64(\"Zm9v.\") == None\n}\n\ntest \"decode_latin1 is one code point per byte; decode_utf8 substitutes\" {\n  let high = freeze(put(put(buf(), 0x80), 0xFF))\n  # Latin-1 cannot fail: every byte names a code point, including the 0x80..0xFF\n  # half that is not valid UTF-8\n  assert decode_latin1(high) == \"\\u{0080}\\u{00FF}\"\n  assert decode_latin1(utf8(\"\")) == \"\"\n  assert decode_latin1(utf8(\"abc\")) == \"abc\"\n  # so the two decoders disagree on exactly those bytes, which is the point of\n  # having both\n  assert decode_utf8(high) == \"\\u{FFFD}\\u{FFFD}\"\n  assert decode_utf8(utf8(\"\")) == \"\"\n  assert decode_utf8(utf8(\"a中😀\")) == \"a中😀\"\n  assert utf8(decode_utf8(utf8(\"a中😀\"))) == utf8(\"a中😀\")\n  # a byte the Latin-1 round trip does not lose\n  assert utf8(decode_latin1(high)) == freeze(put_bytes(put_bytes(buf(),\n    utf8(\"\\u{0080}\")), utf8(\"\\u{00FF}\")))\n}\n\ntest \"for over Bytes yields each byte once, as 0..255\" {\n  var seen: List[Int] = []\n  var n = 0\n  for x in utf8(\"AB\") {\n    seen = seen ++ [x]\n    n = n + 1\n  }\n  assert n == 2\n  assert seen == [0x41, 0x42]\n  # the currency is `at`'s, so the high half arrives unsigned rather than as\n  # the negative byte a host `byte[]` would hand over\n  var high: List[Int] = []\n  for x in freeze(put(put(buf(), 0x80), 0xFF)) {\n    high = high ++ [x]\n  }\n  assert high == [128, 255]\n  var empty = 0\n  for _x in utf8(\"\") { empty = empty + 1 }\n  assert empty == 0\n}\n")
  } else if name == "io.dawn" {
    Some("## The outside world: console, files, environment and subprocesses.\n## Everything here is `!io`, and everything that can fail answers\n## `Result[T, ForeignError]` (spec §9.8.1).\n#\n# These write over the io_* intrinsics, which every backend implements; the\n# handwritten dawn.rt.StdIo is retired. They need no `unsafe_pure`: they are\n# honestly effectful, so their signatures just say `!io`.\n#\n# stderr was missing until 2026-07-28, and its absence was not free: the\n# compiler's own `errio.dawn` existed to reach `System.err`, a static field\n# the `use java` interop cannot name, through a method handle.\n#\n# `args` is deliberately NOT here: argv arrives on a static field of the program's\n# own entry class, and a std function compiles to a different class, so it cannot\n# name that field. Parking argv on a runtime class instead would make it shared\n# by every program in one JVM — see pure-ffi-design.md §十七.\n#\n# The failing ones compose with `catch_fault`, which is an intrinsic and stays\n# in the compiler. That is not a workaround: `Result` is a Dawn ADT and cannot be\n# a Java return type, and the barrier is precisely the built-in bridge from \"the\n# outside world said no\" to an `Err`.\n#\n# That `Err` carries a `ForeignError`, not a String (docs/audit/error-model-design.md\n# 六). A rendered message is a dead end for a caller: the only thing it can do\n# with one is match on its text, which is what spec §9.8 used to advise and what\n# the error model exists to stop. The record hands over `kind` (the backend's own\n# name for the failure class), `message` and `cause` separately, so a caller that\n# wants to *decide* reads `kind` and a caller that wants to *report* reads\n# `message` — neither has to parse. Rendering one back into a line of text is\n# still a `to_string(e)` away for whoever actually wants the line.\nuse std/list\nuse std/str\n\n## Print a string followed by a newline.\npub fn println(s: String) -> Unit !io = io_println(s)\n\n## Print a string without a newline.\npub fn print(s: String) -> Unit !io = io_print(s)\n\n## Print a string to stderr, followed by a newline.\npub fn eprintln(s: String) -> Unit !io = io_eprintln(s)\n\n## Print a string to stderr without a newline.\npub fn eprint(s: String) -> Unit !io = io_eprint(s)\n\n## End the process with an exit status. Nothing after the call runs.\n##\n## The result is `Unit` rather than `Never` because the intrinsic maps to\n## `System.exit`, which the JVM types as void; a `Never` here would need both\n## emitters to stop treating the call as falling through.\npub fn exit(code: Int) -> Unit !io = io_exit(code)\n\n## Read one line from stdin; `None` at end of input.\n## The intrinsic maps Java's `null`-or-line straight onto `Option`.\npub fn read_line() -> Option[String] !io = io_read_line()\n\n## Whether `path` names a directory. Invalid host path spellings, including an\n## embedded NUL, answer `false` rather than escaping this Bool interface.\npub fn is_dir(path: String) -> Bool !io = io_is_dir(path)\n\n## Whether anything exists at `path` -- a file, a directory, anything. Invalid\n## host path spellings, including an embedded NUL, answer `false`.\npub fn exists(path: String) -> Bool !io = io_exists(path)\n\n## Create `path` and every missing directory above it.\n## An existing directory is not a failure; an existing *file* is.\npub fn mkdirs(path: String) -> Result[Unit, ForeignError] !io =\n  catch_fault(() => io_mkdirs(path))\n\n## Read a whole file as a UTF-8 string.\npub fn read_file(path: String) -> Result[String, ForeignError] !io =\n  catch_fault(() => io_read_file(path))\n\n## Write a string to a file, creating missing parent directories.\n## `Ok` carries nothing: the only count worth returning would be bytes on disk.\npub fn write_file(path: String, content: String) -> Result[Unit, ForeignError] !io =\n  catch_fault(() => io_write_file(path, content))\n\n## The process's working directory, as an absolute path.\npub fn cwd() -> String !io = io_cwd()\n\n## The value of the environment variable `name`, or `None` when it is unset or\n## cannot be represented by the host environment API, including an embedded NUL.\npub fn getenv(name: String) -> Option[String] !io = io_getenv(name)\n\n## Read a whole file as bytes. The text half is `read_file`.\npub fn read_bytes(path: String) -> Result[Bytes, ForeignError] !io =\n  catch_fault(() => io_read_bytes(path))\n\n## Write bytes to a file, creating missing parent directories.\npub fn write_bytes(path: String, content: Bytes) -> Result[Unit, ForeignError] !io =\n  catch_fault(() => io_write_bytes(path, content))\n\n## The two normal outcomes of deleting a path. Host failures are not outcomes:\n## they stay in `delete`'s `Err` branch.\npub type DeleteOutcome = Deleted | NotFound\n\n## Delete a file or an empty directory. A missing path is `Ok(NotFound)`;\n## every other host refusal, including a non-empty directory, is an `Err`.\n##\n## The empty path and a path ending in `/` are rejected before a backend sees\n## them. Hosts normalize those spellings differently, and delete must never\n## change which filesystem object the caller named as a side effect of choosing\n## a backend.\npub fn delete(path: String) -> Result[DeleteOutcome, ForeignError] !io =\n  if path == \"\" {\n    Err(ForeignError {\n      kind: \"io.invalid_delete_path\",\n      message: \"io.delete: path must not be empty\",\n      cause: None\n    })\n  } else if str.ends_with(path, \"/\") {\n    Err(ForeignError {\n      kind: \"io.invalid_delete_path\",\n      message: \"io.delete: path must not end with '/'\",\n      cause: None\n    })\n  } else {\n    match catch_fault(() => io_delete(path)) {\n      Ok(gone) -> if gone { Ok(Deleted) } else { Ok(NotFound) }\n      Err(e) -> Err(e)\n    }\n  }\n\n## Move `src` onto `dst`, replacing it. Atomic when the two are on one\n## filesystem and an error when they are not -- which is the whole point: the\n## caller is publishing something it has already verified, and a move that can\n## be observed half-done would defeat that. Stage with `temp_dir` under the\n## destination's own directory to stay on one filesystem.\npub fn rename(src: String, dst: String) -> Result[Unit, ForeignError] !io =\n  catch_fault(() => io_rename(src, dst))\n\n## A fresh directory under `parent`, named after `prefix`. An empty `parent`\n## means the system temporary directory.\npub fn temp_dir(parent: String, prefix: String) -> Result[String, ForeignError] !io =\n  catch_fault(() => io_temp_dir(parent, prefix))\n\n## A fresh, empty file under `parent`, named after `prefix`. An empty `parent`\n## means the system temporary directory.\n##\n## The host picks the name *and creates the file* in one step (`mkstemp(3)`,\n## `Files.createTempFile`), which is the difference that matters: a caller that\n## spelled a name and opened it afterwards has a window in which another\n## process can put something else -- a symbolic link, say -- at that name. On a\n## POSIX host the file arrives readable and writable by its owner alone.\npub fn temp_file(parent: String, prefix: String) -> Result[String, ForeignError] !io =\n  catch_fault(() => io_temp_file(parent, prefix))\n\n## Give `dst` the permissions `src` has.\n##\n## `src` is inspected without following a link. POSIX hosts copy the mode bits;\n## a host with no POSIX permission model copies the read-only flag, which is\n## the whole of what it has. Neither copies ACLs or extended attributes.\n##\n## This exists because publishing by rename loses them: the file that ends up\n## at the destination is a *new* file, whose mode came from the call that\n## created it and the umask, and nothing else remembers what it replaced.\npub fn copy_permissions(src: String, dst: String) -> Result[Unit, ForeignError] !io =\n  catch_fault(() => io_copy_permissions(src, dst))\n\n## Whether `path` is a symbolic link. The link itself is examined, not its\n## target, so a link to a directory is a link and not a directory. Invalid host\n## path spellings, including an embedded NUL, answer `false`.\npub fn is_symlink(path: String) -> Bool !io = io_is_symlink(path)\n\n## Write `content` to `path` so that a reader ever only sees the old file or\n## the new one, never a half-written one and never nothing at all.\n##\n## The staging file is created by `temp_file` in the destination's own\n## directory -- the host picks its name, so nothing can be squatting on it, and\n## the shared directory is what keeps the final `rename` on one filesystem and\n## therefore atomic. What is written is read back and compared before anything\n## is published, the destination's permissions are carried over when it already\n## exists, and only then does a single `rename` install it. Any step that fails\n## takes the staging file away and leaves the destination exactly as it was.\n##\n## What this does **not** promise:\n##\n## - **Durability.** It orders nothing against a power cut: no `fsync` of the\n##   file and none of the directory. The guarantee is about what a *reader*\n##   can observe on a running system, which is what a manifest rewrite needs;\n##   surviving a crash is a different (and much more expensive) property.\n## - **Anything about concurrent writers.** Two of these racing both succeed\n##   and the last `rename` wins. Detecting that someone else changed the file\n##   since it was read is a compare-and-set, and that is a different primitive\n##   with a different signature.\n## - **Link identity.** A destination with other hard links to it is detached:\n##   this directory entry gets the new file and the other links keep the old\n##   one. Writing through to the shared inode is the opposite of what is wanted\n##   here -- it is exactly the non-atomic overwrite this replaces.\n##\n## A destination that *is* a symbolic link is refused rather than followed\n## (`io.atomic_write_target_is_symlink`). Following would let whatever placed\n## the link choose which file gets written, and a caller publishing a file it\n## named is not asking to write wherever that name currently points.\n##\n## The four failure kinds minted here are `io.invalid_atomic_write_path`,\n## `io.atomic_write_target_is_symlink`, `io.atomic_write_staging_failed` and\n## `io.atomic_write_verify_failed`; every other `Err` carries whatever the\n## backend called the failure, as everywhere else in this module.\n##\n## `io.atomic_write_staging_failed` is the one place that rewrites a backend\n## message instead of passing it on, and it earns the exception: the failure is\n## about a randomly named file this function invented, so passing it on would\n## name that file to a caller who never asked for it. The backend's own words\n## are kept in `cause`.\npub fn atomic_write_file(path: String, content: String) -> Result[Unit, ForeignError] !io =\n  if path == \"\" {\n    Err(ForeignError {\n      kind: \"io.invalid_atomic_write_path\",\n      message: \"io.atomic_write_file: path must not be empty\",\n      cause: None\n    })\n  } else if str.ends_with(path, \"/\") {\n    Err(ForeignError {\n      kind: \"io.invalid_atomic_write_path\",\n      message: \"io.atomic_write_file: path must not end with '/'\",\n      cause: None\n    })\n  } else if is_symlink(path) {\n    Err(ForeignError {\n      kind: \"io.atomic_write_target_is_symlink\",\n      message: \"io.atomic_write_file: refusing to replace a symbolic link: \" ++ path,\n      cause: None\n    })\n  } else {\n    match temp_file(parent_dir(path), \".dawn-atomic-\") {\n      # The staging file is this function's own device, and its name is a\n      # random one nobody asked for. Passing the backend's message through\n      # verbatim -- the way every other failure here does -- would put that\n      # name in front of a caller who never created it: `dawn lock` into an\n      # unwritable directory used to report a `.dawn-atomic-...tmp` it had\n      # never heard of. So this one failure is re-attributed to the directory\n      # that actually refused, and the backend's own words move to `cause`,\n      # which is where the layer below belongs (spec §9.8.1).\n      Err(e) -> Err(ForeignError {\n        kind: \"io.atomic_write_staging_failed\",\n        message: \"io.atomic_write_file: cannot create a staging file in \"\n          ++ parent_dir(path),\n        cause: Some(e.kind ++ \": \" ++ e.message)\n      })\n      Ok(tmp) -> stage_replace(path, content, tmp)\n    }\n  }\n\n## The directory `path` names a file in. Not a general path library: it answers\n## the one question `atomic_write_file` asks, which is where to stage, and a\n## staging directory that is merely *equivalent* to the destination's is enough\n## for both properties wanted of it -- same filesystem, and reachable.\nfn parent_dir(path: String) -> String =\n  match str.last_index_of(path, \"/\") {\n    None -> \".\"\n    Some(i) -> if i == 0 { \"/\" } else { str.slice(path, 0, i) }\n  }\n\n## Everything after the staging file exists. Split out because every failure\n## from here on has to take that file away again, and a single expression with\n## five nested `match`es would have five copies of the same cleanup.\nfn stage_replace(path: String, content: String, tmp: String) -> Result[Unit, ForeignError] !io =\n  match write_file(tmp, content) {\n    Err(e) -> abandon(tmp, e)\n    Ok(_) ->\n      match read_bytes(tmp) {\n        Err(e) -> abandon(tmp, e)\n        Ok(seen) ->\n          # Read back, rather than trust the write: `write_file` reports what\n          # the host accepted, and a host can accept bytes it did not keep --\n          # a short write on a full filesystem is the ordinary way. The\n          # comparison is on bytes and not on the string, because the string\n          # would come back through a decoder that replaces what it cannot\n          # read, and a corruption that decodes to the same text is still a\n          # corruption. `bytes_utf8` is the intrinsic behind `std/bytes.utf8`,\n          # spelled directly so this module gains no import for one call.\n          if seen != bytes_utf8(content) {\n            abandon(tmp, ForeignError {\n              kind: \"io.atomic_write_verify_failed\",\n              message: \"io.atomic_write_file: the staged file did not read back \" ++\n                \"as it was written: \" ++ path,\n              cause: None\n            })\n          } else {\n            match carry_permissions(path, tmp) {\n              Err(e) -> abandon(tmp, e)\n              Ok(_) ->\n                match rename(tmp, path) {\n                  Err(e) -> abandon(tmp, e)\n                  Ok(_) -> Ok(())\n                }\n            }\n          }\n      }\n  }\n\n## Carry the destination's permissions onto the staging file, when there is a\n## destination to carry them from. A path that does not exist yet has no mode\n## to preserve, and the new file keeps the one its creation gave it.\nfn carry_permissions(path: String, tmp: String) -> Result[Unit, ForeignError] !io =\n  if exists(path) { copy_permissions(path, tmp) } else { Ok(()) }\n\n## Give up: take the staging file away and hand back the failure that caused\n## it. The delete's own outcome is dropped on purpose -- the caller is being\n## told why the write did not happen, and replacing that with \"and also the\n## cleanup failed\" would lose the reason.\nfn abandon(tmp: String, e: ForeignError) -> Result[Unit, ForeignError] !io = {\n  let _ = delete(tmp)\n  Err(e)\n}\n\n## Exactly `n` bytes of standard input, shorter only at end of input -- so a\n## short read is how end of input is reported.\n##\n## This reads the stream directly while `read_line` reads a buffered reader\n## over it. A program that used both would lose whatever the reader had already\n## buffered; pick one.\npub fn read_stdin(n: Int) -> Bytes !io = io_read_stdin(n)\n\n## Whether at least one byte of standard input can be read right now, waiting\n## up to `timeout_ms` for one to arrive.\n##\n## **End of input is not readiness.** When the writer has gone away this\n## answers `false`, exactly as a silent-but-open stream does; the difference\n## is reported by `read_stdin`, which stays the only reader. A loop driven by\n## this alone would therefore spin once its input ended -- the third branch is\n## not optional:\n##\n##     if have_work_pending {\n##       if stdin_ready(window) { read a message } else { do the work }\n##     } else {\n##       read a message          # nothing to do, so blocking is the right thing\n##     }\n##\n## `timeout_ms` is an upper bound, not a lower one. Returning `false` early is\n## always allowed -- a regular file at end of input answers immediately -- and\n## it is safe because the only thing a caller may do with `false` is stop\n## waiting. `true` is the answer that is never given on a guess.\npub fn stdin_ready(timeout_ms: Int) -> Bool !io = io_stdin_ready(timeout_ms)\n\n## The entry names directly under `path`, sorted in code-point order.\n## A non-directory is reported as an `Err`, not a panic, and — matching the old\n## behaviour — is checked before anything is read, so a missing path and a plain\n## file give the same message.\n##\n## The sort happens here, not in the backends: the `io_list_names` intrinsic\n## answers whatever order the OS gave, and one `list.sort` over the language's\n## own `Ord[String]` is what makes every backend agree.\n##\n## Its `kind` is `\"io.not_a_directory\"`, one of the three failure kinds std\n## mints itself (`run`'s `io.no_program` and `delete`'s\n## `io.invalid_delete_path` are the others): every other one in this module is\n## whatever the backend called it, and this failure never reaches a backend,\n## because the check happens first. It is spelled as a name rather than a\n## sentence for the same reason every other `kind` is — a caller may match on it.\npub fn list_dir(path: String) -> Result[List[String], ForeignError] !io =\n  if is_dir(path) {\n    match catch_fault(() => io_list_names(path)) {\n      Ok(names) -> Ok(list.sort(names))\n      Err(e) -> Err(e)\n    }\n  } else {\n    Err(ForeignError {\n      kind: \"io.not_a_directory\",\n      message: \"not a directory: \" ++ path,\n      cause: None\n    })\n  }\n\n## Run `argv[0]` (found on PATH) with `argv` as its arguments, wait for it, and\n## answer its exit status. A non-zero status is not an error -- it is the\n## answer; an `Err` means the program could not be started at all.\n##\n## Each stream goes to the file named by its path, truncating it, and an empty\n## path leaves that stream pointing wherever this process's already points.\n## Files rather than pipes: see the note on the `io_run` intrinsic.\n##\n## An empty `argv` is `\"io.no_program\"`, another failure kind std mints itself,\n## and for `list_dir`'s reason: the check happens first, so the failure never\n## reaches a backend and every backend words it the same.\npub fn run(argv: List[String], out_path: String, err_path: String) -> Result[Int, ForeignError] !io =\n  if len(argv) == 0 {\n    Err(ForeignError {\n      kind: \"io.no_program\",\n      message: \"io.run: argv is empty, so there is no program to run\",\n      cause: None\n    })\n  } else {\n    catch_fault(() => io_run(argv, out_path, err_path))\n  }\n\n# What these blocks may and may not assert is decided by one fact: `kind` is\n# whatever the backend called the failure. On the JVM a missing file is\n# `java.nio.file.NoSuchFileException`; a second backend has no reason to spell\n# it the same, and `dawn test --stdlib` is run under both with the reports\n# compared byte for byte (scripts/native-cli-diff.sh). So a failure that\n# reaches a backend is asserted to *be* an `Err` and nothing more.\n#\n# The exceptions are `list_dir`'s `io.not_a_directory`, `run`'s\n# `io.no_program`, and `delete`'s `io.invalid_delete_path`, which std mints\n# itself above the barrier and which are the same string on every backend --\n# and being match-able is the whole reason they are names rather than\n# sentences, so they are the `kind`s worth pinning.\n#\n# `Unit` has no equality, so `Result[Unit, ForeignError]` cannot be compared\n# with `==` and the blocks below carry a local `ok` lambda instead of a\n# module-level helper -- a private `fn` here would be dead code in every build\n# that is not `dawn test --stdlib`, and would show up in std/io's own Core.\n#\n# Each block makes its own temp directory and takes it away again. Nothing here\n# reads the repository: a test that depends on the tree it is run from breaks\n# when the tree moves, and these run from wherever the runner was started.\n\ntest \"temp_dir makes a fresh directory, and a file round trips through it\" {\n  let ok = (r: Result[Unit, ForeignError]) => match r {\n    Ok(_) -> true\n    Err(_) -> false\n  }\n  let made = (r: Result[String, ForeignError]) => match r {\n    Ok(p) -> p\n    Err(_) -> \"\"\n  }\n  let d = made(temp_dir(\"\", \"dawn-std-test-\"))\n  assert d != \"\"\n  assert exists(d)\n  assert is_dir(d)\n  # fresh: a second call is a different directory, not the same one again\n  let d2 = made(temp_dir(\"\", \"dawn-std-test-\"))\n  assert d2 != \"\"\n  assert d != d2\n  # and `parent` is honoured, so a caller can stage on one filesystem\n  let inner = made(temp_dir(d, \"inner-\"))\n  assert inner != \"\"\n  assert is_dir(inner)\n\n  let f = d ++ \"/hello.txt\"\n  assert not exists(f)\n  assert ok(write_file(f, \"hello\"))\n  assert exists(f)\n  assert not is_dir(f)\n  assert read_file(f) == Ok(\"hello\")\n  # overwriting is not appending\n  assert ok(write_file(f, \"again\"))\n  assert read_file(f) == Ok(\"again\")\n  assert ok(write_file(f, \"\"))\n  assert read_file(f) == Ok(\"\")\n  # missing parents are created on the way\n  let nested = d ++ \"/a/b/c.txt\"\n  assert ok(write_file(nested, \"deep\"))\n  assert read_file(nested) == Ok(\"deep\")\n  assert is_dir(d ++ \"/a/b\")\n\n  assert delete(f) == Ok(Deleted)\n  assert delete(nested) == Ok(Deleted)\n  assert delete(d ++ \"/a/b\") == Ok(Deleted)\n  assert delete(d ++ \"/a\") == Ok(Deleted)\n  assert delete(inner) == Ok(Deleted)\n  assert delete(d) == Ok(Deleted)\n  assert delete(d2) == Ok(Deleted)\n  assert not exists(d)\n}\n\ntest \"a path that is not there is an Err, and never a panic\" {\n  let made = (r: Result[String, ForeignError]) => match r {\n    Ok(p) -> p\n    Err(_) -> \"\"\n  }\n  let d = made(temp_dir(\"\", \"dawn-std-test-\"))\n  # spec 9.8.1: the outside world saying no is a value, so every one of these\n  # is a branch the caller takes. Which failure it was is the backend's word\n  # and is not asserted here -- on the JVM these are java.nio names, and a\n  # second backend has no reason to spell them the same.\n  match read_file(d ++ \"/nope.txt\") {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  match read_bytes(d ++ \"/nope.bin\") {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  match rename(d ++ \"/nope\", d ++ \"/x\") {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  # a directory is not a file, in both directions\n  match read_file(d) {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  match write_file(d, \"x\") {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  # ... and the queries that answer Bool rather than Result just say no\n  assert not exists(d ++ \"/nope\")\n  assert not is_dir(d ++ \"/nope\")\n  assert not is_symlink(d ++ \"/nope\")\n  let nul_path = d ++ \"\\u{0}suffix\"\n  assert not exists(nul_path)\n  assert not is_dir(nul_path)\n  assert not is_symlink(nul_path)\n  assert is_dir(d)\n  assert delete(d ++ \"/nope\") == Ok(NotFound)\n  assert getenv(\"DAWN_STD_TEST_DEFINITELY_UNSET_VARIABLE\") == None\n  assert getenv(\"DAWN_STD_TEST\\u{0}INVALID_VARIABLE\") == None\n  # cwd is somewhere, and it is a directory\n  assert cwd() != \"\"\n  assert is_dir(cwd())\n  assert delete(d) == Ok(Deleted)\n}\n\ntest \"list_dir sorts by code point, and names a non-directory itself\" {\n  let ok = (r: Result[Unit, ForeignError]) => match r {\n    Ok(_) -> true\n    Err(_) -> false\n  }\n  let made = (r: Result[String, ForeignError]) => match r {\n    Ok(p) -> p\n    Err(_) -> \"\"\n  }\n  let d = made(temp_dir(\"\", \"dawn-std-test-\"))\n  let nothing: List[String] = []\n  assert list_dir(d) == Ok(nothing)\n  assert ok(write_file(d ++ \"/zeta\", \"1\"))\n  assert ok(write_file(d ++ \"/Alpha\", \"1\"))\n  assert ok(write_file(d ++ \"/mid\", \"1\"))\n  # not the order the OS handed over, and not case-insensitive: 'A' is 65\n  assert list_dir(d) == Ok([\"Alpha\", \"mid\", \"zeta\"])\n  assert delete(d ++ \"/zeta\") == Ok(Deleted)\n  assert delete(d ++ \"/Alpha\") == Ok(Deleted)\n  assert delete(d ++ \"/mid\") == Ok(Deleted)\n\n  # The clause the sort exists for. In code-point order U+FFFD (65533) comes\n  # before U+1F600 (128512); in UTF-16 unit order it does not, because the\n  # astral name begins with the surrogate 0xD83D (55357). A backend sorting\n  # its own way -- `Arrays.sort` is UTF-16 units -- answers these two the\n  # other way round, which is why the sort is in std and not below it.\n  assert ok(write_file(d ++ \"/\\u{1F600}\", \"1\"))\n  assert ok(write_file(d ++ \"/\\u{FFFD}\", \"1\"))\n  assert list_dir(d) == Ok([\"\\u{FFFD}\", \"\\u{1F600}\"])\n  assert delete(d ++ \"/\\u{1F600}\") == Ok(Deleted)\n  assert delete(d ++ \"/\\u{FFFD}\") == Ok(Deleted)\n\n  # the one kind std mints, so the one a caller may match on\n  assert ok(write_file(d ++ \"/plain.txt\", \"1\"))\n  match list_dir(d ++ \"/plain.txt\") {\n    Ok(_) -> { assert false }\n    Err(e) -> { assert e.kind == \"io.not_a_directory\" }\n  }\n  # a missing path is the same answer as a plain file: the check happens before\n  # anything is read, so the two are deliberately not told apart\n  match list_dir(d ++ \"/nope\") {\n    Ok(_) -> { assert false }\n    Err(e) -> { assert e.kind == \"io.not_a_directory\" }\n  }\n  assert delete(d ++ \"/plain.txt\") == Ok(Deleted)\n  assert delete(d) == Ok(Deleted)\n}\n\ntest \"mkdirs is idempotent on a directory; delete says what it removed\" {\n  let ok = (r: Result[Unit, ForeignError]) => match r {\n    Ok(_) -> true\n    Err(_) -> false\n  }\n  let made = (r: Result[String, ForeignError]) => match r {\n    Ok(p) -> p\n    Err(_) -> \"\"\n  }\n  let d = made(temp_dir(\"\", \"dawn-std-test-\"))\n  # every missing directory above it, in one call\n  assert ok(mkdirs(d ++ \"/m1/m2\"))\n  assert is_dir(d ++ \"/m1\")\n  assert is_dir(d ++ \"/m1/m2\")\n  # an existing directory is not a failure\n  assert ok(mkdirs(d ++ \"/m1/m2\"))\n  assert ok(mkdirs(d))\n  # an existing *file* is\n  assert ok(write_file(d ++ \"/f.txt\", \"x\"))\n  assert not ok(mkdirs(d ++ \"/f.txt\"))\n\n  # Missing is a normal outcome. A non-empty directory is a host refusal, not\n  # another spelling of absence, and delete never empties it for the caller.\n  assert delete(d ++ \"/nope\") == Ok(NotFound)\n  match delete(d ++ \"/m1\") {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  assert is_dir(d ++ \"/m1\")\n  assert delete(d ++ \"/m1/m2\") == Ok(Deleted)\n  assert delete(d ++ \"/m1\") == Ok(Deleted)\n  assert not exists(d ++ \"/m1\")\n  assert delete(d ++ \"/f.txt\") == Ok(Deleted)\n  assert delete(d ++ \"/f.txt\") == Ok(NotFound)\n  assert delete(d) == Ok(Deleted)\n}\n\ntest \"delete rejects ambiguous path spellings without changing the target\" {\n  let ok = (r: Result[Unit, ForeignError]) => match r {\n    Ok(_) -> true\n    Err(_) -> false\n  }\n  let made = (r: Result[String, ForeignError]) => match r {\n    Ok(p) -> p\n    Err(_) -> \"\"\n  }\n  let d = made(temp_dir(\"\", \"dawn-std-test-\"))\n  let f = d ++ \"/kept\"\n  assert ok(write_file(f, \"x\"))\n\n  match delete(\"\") {\n    Ok(_) -> { assert false }\n    Err(e) -> {\n      assert e.kind == \"io.invalid_delete_path\"\n      assert e.message == \"io.delete: path must not be empty\"\n    }\n  }\n  assert exists(f)\n\n  match delete(f ++ \"/\") {\n    Ok(_) -> { assert false }\n    Err(e) -> {\n      assert e.kind == \"io.invalid_delete_path\"\n      assert e.message == \"io.delete: path must not end with '/'\"\n    }\n  }\n  assert exists(f)\n\n  # A backend may name this failure differently, but it must reject the whole\n  # path rather than silently delete the prefix before the NUL.\n  match delete(f ++ \"\\u{0}suffix\") {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  assert exists(f)\n  assert delete(f) == Ok(Deleted)\n  assert delete(d) == Ok(Deleted)\n}\n\ntest \"rename replaces the destination; bytes survive what a String need not\" {\n  let ok = (r: Result[Unit, ForeignError]) => match r {\n    Ok(_) -> true\n    Err(_) -> false\n  }\n  let made = (r: Result[String, ForeignError]) => match r {\n    Ok(p) -> p\n    Err(_) -> \"\"\n  }\n  let d = made(temp_dir(\"\", \"dawn-std-test-\"))\n  assert ok(write_file(d ++ \"/src.txt\", \"moved\"))\n  assert ok(rename(d ++ \"/src.txt\", d ++ \"/dst.txt\"))\n  assert not exists(d ++ \"/src.txt\")\n  assert read_file(d ++ \"/dst.txt\") == Ok(\"moved\")\n  # onto an existing destination: replaced, not refused\n  assert ok(write_file(d ++ \"/src.txt\", \"second\"))\n  assert ok(rename(d ++ \"/src.txt\", d ++ \"/dst.txt\"))\n  assert read_file(d ++ \"/dst.txt\") == Ok(\"second\")\n  assert not exists(d ++ \"/src.txt\")\n  assert not ok(rename(d ++ \"/nope\", d ++ \"/dst.txt\"))\n\n  # the byte pair is the point: 0x00 0xFF is not UTF-8, so this round trip is\n  # one `read_file`/`write_file` could not make\n  let raw = bytes_from_array(array_push(array_push(array_new(), 0x00), 0xFF))\n  assert ok(write_bytes(d ++ \"/raw.bin\", raw))\n  assert read_bytes(d ++ \"/raw.bin\") == Ok(raw)\n  let none_at_all = bytes_from_array(array_new())\n  assert ok(write_bytes(d ++ \"/empty.bin\", none_at_all))\n  assert read_bytes(d ++ \"/empty.bin\") == Ok(none_at_all)\n  # and the two halves see the same file\n  assert ok(write_file(d ++ \"/text.txt\", \"abc\"))\n  assert read_bytes(d ++ \"/text.txt\") == Ok(bytes_utf8(\"abc\"))\n\n  assert delete(d ++ \"/dst.txt\") == Ok(Deleted)\n  assert delete(d ++ \"/raw.bin\") == Ok(Deleted)\n  assert delete(d ++ \"/empty.bin\") == Ok(Deleted)\n  assert delete(d ++ \"/text.txt\") == Ok(Deleted)\n  assert delete(d) == Ok(Deleted)\n}\n\ntest \"run answers the exit status; a program that cannot start is an Err\" {\n  let ok = (r: Result[Unit, ForeignError]) => match r {\n    Ok(_) -> true\n    Err(_) -> false\n  }\n  let made = (r: Result[String, ForeignError]) => match r {\n    Ok(p) -> p\n    Err(_) -> \"\"\n  }\n  let d = made(temp_dir(\"\", \"dawn-std-test-\"))\n  # `sh` rather than a coreutil, because POSIX guarantees it is on PATH\n  assert run([\"sh\", \"-c\", \"exit 0\"], \"\", \"\") == Ok(0)\n  # a non-zero status is the answer, not a failure -- the distinction this\n  # signature exists to make\n  assert run([\"sh\", \"-c\", \"exit 3\"], \"\", \"\") == Ok(3)\n  assert run([\"sh\", \"-c\", \"exit 1\"], \"\", \"\") == Ok(1)\n  # not being able to start it at all is the failure\n  match run([\"dawn-no-such-program-anywhere-on-this-path\"], \"\", \"\") {\n    Ok(_) -> { assert false }\n    Err(_) -> ()\n  }\n  # no argv[0] to run. std mints this one, so unlike every other kind here it\n  # is the same string on both backends and is worth pinning -- it is what the\n  # JVM used to answer with `java.lang.ArrayIndexOutOfBoundsException`.\n  match run([], \"\", \"\") {\n    Ok(_) -> { assert false }\n    Err(e) -> { assert e.kind == \"io.no_program\" }\n  }\n  # each stream goes to the file named, truncating it\n  let out = d ++ \"/out.txt\"\n  assert run([\"sh\", \"-c\", \"printf first\"], out, \"\") == Ok(0)\n  assert read_file(out) == Ok(\"first\")\n  assert run([\"sh\", \"-c\", \"printf second\"], out, \"\") == Ok(0)\n  assert read_file(out) == Ok(\"second\")\n  # stdout and stderr are separated\n  let err = d ++ \"/err.txt\"\n  assert run([\"sh\", \"-c\", \"printf out; printf err 1>&2\"], out, err) == Ok(0)\n  assert read_file(out) == Ok(\"out\")\n  assert read_file(err) == Ok(\"err\")\n  assert ok(write_file(d ++ \"/keep.txt\", \"x\"))\n  assert delete(d ++ \"/keep.txt\") == Ok(Deleted)\n  assert delete(out) == Ok(Deleted)\n  assert delete(err) == Ok(Deleted)\n  assert delete(d) == Ok(Deleted)\n}\n")
  } else if name == "map.dawn" {
    Some("## The persistent hash map. Insert and remove answer a new map and leave\n## the old one intact; keys need `Eq + Hash` (spec §2.2, §11).\n#\n# Short names, module-qualified at the call site: `use std/map`, then\n# `map.insert(m, k, v)`. Each function forwards to the compiler primitive that\n# owns the representation -- since S3 a pure-Dawn hash trie (std/hamt) rather\n# than a handwritten Java one; the wrappers are what give the operations their\n# public, qualified spelling.\n#\n# Everything that has to find an entry carries `[K: Eq + Hash]`, because\n# finding one means hashing the key and comparing it, and those are the key\n# type's own relations. Counting and listing entries do neither, so they stay\n# unbounded -- reading a map should not ask more of its keys than storing one\n# already did.\n#\n# Key validity (no Float/Bytes anywhere inside the key type) is enforced by the\n# checker at every Map type instantiation, so these wrappers need no checks.\n\n## A map with no entries. The key/value types come from the use site.\npub fn empty[K, V]() -> Map[K, V] = map_empty()\n\n## A map from a list of (key, value) pairs; a repeated key keeps the last value.\npub fn from[K: Eq + Hash, V](entries: List[(K, V)]) -> Map[K, V] = map_from(entries)\n\n## A copy with `key` bound to `value`; an existing key keeps its insertion position.\npub fn insert[K: Eq + Hash, V](m: Map[K, V], key: K, value: V) -> Map[K, V] =\n  map_insert(m, key, value)\n\n## A copy without `key`; absent keys are fine.\npub fn remove[K: Eq + Hash, V](m: Map[K, V], key: K) -> Map[K, V] = map_remove(m, key)\n\n## The value bound to `key`, or `None`.\npub fn get[K: Eq + Hash, V](m: Map[K, V], key: K) -> Option[V] = map_get(m, key)\n\n## Whether `key` is bound.\npub fn has[K: Eq + Hash, V](m: Map[K, V], key: K) -> Bool = map_has(m, key)\n\n## Number of entries.\npub fn len[K, V](m: Map[K, V]) -> Int = map_size(m)\n\n## Whether there are no entries. Cheaper to read than `len(m) == 0` and, since\n## the trie keeps its own count, no cheaper to compute -- the point is that one\n## question has one spelling across every container (CONTRIBUTING §naming).\npub fn is_empty[K, V](m: Map[K, V]) -> Bool = map_size(m) == 0\n\n## The keys, in insertion order.\npub fn keys[K, V](m: Map[K, V]) -> List[K] = map_keys(m)\n\n## The values, in insertion order of their keys.\npub fn values[K, V](m: Map[K, V]) -> List[V] = map_values(m)\n\n## The (key, value) pairs, in insertion order.\npub fn entries[K, V](m: Map[K, V]) -> List[(K, V)] = map_entries(m)\n\n# ---- Eq / Hash for Map ----\n#\n# Both are defined on the entries rather than on the structure holding them.\n# A hash trie has no canonical shape: the same entries inserted in a different\n# order, or with a removal in between, are a different tree. Until S3 this was\n# the JVM's business -- `AbstractMap` supplied an order-independent equality\n# that Dawn borrowed and could not state -- and stating it is what let the\n# container become Dawn source (docs/collections-dejava-research.md §3).\n#\n# There is deliberately no `Ord[Map[K, V]]`: entries have no order to compare.\n#\n# The three walks below carry the entry count as a parameter instead of asking\n# `len(es)` for it. `len` in this module is the one declared above (a module's\n# own declarations shadow the prelude, spec §10.6), so it answers for maps, not\n# for the entry list being walked; the count is `len(m)` either way, taken once\n# at the entry point.\n\nfn eq_go[K: Eq + Hash, V: Eq](b: Map[K, V], es: List[(K, V)], i: Int, n: Int) -> Bool =\n  if i == n {\n    true\n  } else {\n    let (k, v) = es[i]\n    match get(b, k) {\n      Some(bv) -> if eq(v, bv) { eq_go(b, es, i + 1, n) } else { false }\n      None -> false\n    }\n  }\n\n## Same size, and every entry of one present with an equal value in the other.\nimpl[K: Eq + Hash, V: Eq] Eq[Map[K, V]] {\n  fn eq(a: Map[K, V], b: Map[K, V]) -> Bool =\n    if len(a) != len(b) { false } else { eq_go(b, entries(a), 0, len(a)) }\n}\n\nfn hash_go[K: Hash, V: Hash](es: List[(K, V)], i: Int, n: Int, acc: Int) -> Int =\n  if i == n {\n    acc\n  } else {\n    let (k, v) = es[i]\n    hash_go(es, i + 1, n, acc + hash(k) * 31 + hash(v))\n  }\n\n## A sum over the entries, so it does not depend on the order they come out\n## in — the same requirement `eq` above is written to.\nimpl[K: Hash, V: Hash] Hash[Map[K, V]] {\n  fn hash(m: Map[K, V]) -> Int = hash_go(entries(m), 0, len(m), 0)\n}\n\nfn show_go[K: Show, V: Show](es: List[(K, V)], i: Int, n: Int, acc: String) -> String =\n  if i == n {\n    acc\n  } else {\n    let (k, v) = es[i]\n    show_go(es, i + 1, n, acc ++ (if i == 0 { \"\" } else { \", \" }) ++\n        \"(\" ++ show(k) ++ \", \" ++ show(v) ++ \")\")\n  }\n\n## The call that rebuilds it: `map.from([(k, v), ...])`. A map has no literal\n## syntax, so the rendering names a function the reader can paste back\n## (spec §2.2), and it is the *public* spelling of that function.\nimpl[K: Show, V: Show] Show[Map[K, V]] {\n  fn show(m: Map[K, V]) -> String =\n    \"map.from([\" ++ show_go(entries(m), 0, len(m), \"\") ++ \"])\"\n}\n\n# ---- iteration (prelude Iter, #44 knife 2) ----\n\n## `for e in m` yields `(K, V)` pairs in `entries`' order. The cursor\n## materialises `entries(m)` once up front and walks it by index: the trie\n## has no public \"next entry\" today, the list's random access is O(1), and\n## `map_size` is a stored count -- one allocation at the start, O(1) per\n## step. If std/hamt ever grows a real cursor, `Cur` changes here and no\n## caller does. Doneness asks the map, not the list: `len`/`get` are this\n## module's map operations, and the entry count is the same number.\nimpl[K: Eq + Hash, V] Iter[Map[K, V]] {\n  type Cur = (List[(K, V)], Int)\n  type Item = (K, V)\n\n  fn iter_start(m: Map[K, V]) -> (List[(K, V)], Int) = (entries(m), 0)\n  fn iter_done(m: Map[K, V], c: (List[(K, V)], Int)) -> Bool = {\n    let (_es, i) = c\n    i >= map_size(m)\n  }\n  fn iter_next(m: Map[K, V], c: (List[(K, V)], Int)) -> (List[(K, V)], Int) = {\n    let (es, i) = c\n    (es, i + 1)\n  }\n  fn iter_get(m: Map[K, V], c: (List[(K, V)], Int)) -> (K, V) = {\n    let (es, i) = c\n    es[i]\n  }\n}\n\n# `len` in this module is the map's, so the blocks below never ask a list for\n# its length -- they compare whole lists instead, which is the stronger\n# assertion anyway: it pins the order at the same time as the contents.\n#\n# Insertion order is the thing most worth pinning here. Nothing in the type\n# says a hash trie has one, three of the four functions below promise it in\n# prose, and a rewrite that lost it would leave every gate green.\n\ntest \"get and has answer about a key; a missing one is a branch, not a panic\" {\n  let m: Map[String, Int] = from([(\"a\", 1), (\"b\", 2)])\n  assert get(m, \"a\") == Some(1)\n  assert get(m, \"b\") == Some(2)\n  assert has(m, \"a\")\n  # spec 4.8 criterion 2: asking about a key that is not there is what this\n  # function is for, so the answer is None and never a panic\n  assert get(m, \"zz\") == None\n  assert not has(m, \"zz\")\n  let e: Map[String, Int] = empty()\n  assert get(e, \"a\") == None\n  assert not has(e, \"a\")\n  assert len(e) == 0\n  assert is_empty(e)\n  assert not is_empty(m)\n  assert len(m) == 2\n  # a key whose value is itself absent-looking is still a present key\n  let o: Map[String, Option[Int]] = from([(\"a\", None)])\n  assert has(o, \"a\")\n  assert get(o, \"a\") == Some(None)\n  # a Char keys a Map: an opaque type takes its Eq and its Hash from the type\n  # it is over (spec §2.7), and Int's are what the bucketing uses. std/char is\n  # checked before this module and so cannot state this itself.\n  let c: Map[Char, Int] = from([('a', 1), ('中', 2)])\n  assert get(c, 'a') == Some(1)\n  assert get(c, '中') == Some(2)\n  assert get(c, 'z') == None\n}\n\ntest \"insert replaces in place; remove of an absent key changes nothing\" {\n  let m: Map[String, Int] = from([(\"a\", 1), (\"b\", 2), (\"c\", 3)])\n  # an existing key keeps its insertion position -- the value moves, not the key\n  let m2 = insert(m, \"a\", 9)\n  assert get(m2, \"a\") == Some(9)\n  assert keys(m2) == [\"a\", \"b\", \"c\"]\n  assert len(m2) == 3\n  # a new key goes on the end\n  assert keys(insert(m, \"d\", 4)) == [\"a\", \"b\", \"c\", \"d\"]\n  # removing and re-adding is not the same as replacing: the key loses its place\n  assert keys(insert(remove(m, \"a\"), \"a\", 1)) == [\"b\", \"c\", \"a\"]\n  # absent removals are fine, and answer an equal map\n  assert remove(m, \"zz\") == m\n  assert len(remove(m, \"zz\")) == 3\n  let e: Map[String, Int] = empty()\n  assert remove(e, \"a\") == e\n  assert len(remove(m, \"a\")) == 2\n  assert get(remove(m, \"a\"), \"a\") == None\n  # persistent: the old map is untouched by either\n  assert get(m, \"a\") == Some(1)\n  assert keys(m) == [\"a\", \"b\", \"c\"]\n  # `from` takes the last value for a repeated key, and the first position\n  let dup = from([(\"a\", 1), (\"b\", 2), (\"a\", 3)])\n  assert get(dup, \"a\") == Some(3)\n  assert keys(dup) == [\"a\", \"b\"]\n  assert len(dup) == 2\n}\n\ntest \"keys, values and entries are one order, and it is insertion order\" {\n  let m: Map[String, Int] = from([(\"b\", 2), (\"a\", 1), (\"c\", 3)])\n  # not sorted, not hash order -- the order the keys arrived in\n  assert keys(m) == [\"b\", \"a\", \"c\"]\n  assert values(m) == [2, 1, 3]\n  assert entries(m) == [(\"b\", 2), (\"a\", 1), (\"c\", 3)]\n  let e: Map[String, Int] = empty()\n  assert keys(e) == []\n  assert values(e) == []\n  assert entries(e) == []\n  # the three agree with each other, not merely with a literal\n  assert entries(m) == [(keys(m)[0], values(m)[0]), (keys(m)[1], values(m)[1]),\n    (keys(m)[2], values(m)[2])]\n  # and they survive a round trip through `from`\n  assert from(entries(m)) == m\n  assert keys(from(entries(m))) == keys(m)\n}\n\ntest \"Eq and Hash are about the entries, not the shape holding them\" {\n  # the same entries in a different order, and with a removal in between, are\n  # a different trie and the same map\n  let a: Map[String, Int] = from([(\"x\", 1), (\"y\", 2)])\n  let b: Map[String, Int] = from([(\"y\", 2), (\"x\", 1)])\n  let c: Map[String, Int] = remove(from([(\"x\", 1), (\"y\", 2), (\"z\", 3)]), \"z\")\n  assert a == b\n  assert a == c\n  assert hash(a) == hash(b)\n  assert hash(a) == hash(c)\n  # ... while the order they come *out* in is still each one's own\n  assert keys(a) == [\"x\", \"y\"]\n  assert keys(b) == [\"y\", \"x\"]\n  # size is part of it, so a subset is not equal\n  assert not (a == from([(\"x\", 1)]))\n  assert not (a == from([(\"x\", 1), (\"y\", 2), (\"z\", 3)]))\n  # and so is every value\n  assert not (a == from([(\"x\", 1), (\"y\", 99)]))\n  assert not (a == from([(\"x\", 1), (\"z\", 2)]))\n  let e1: Map[String, Int] = empty()\n  let no_entries: List[(String, Int)] = []\n  let e2: Map[String, Int] = from(no_entries)\n  assert e1 == e2\n  assert hash(e1) == hash(e2)\n  assert not (e1 == a)\n}\n\ntest \"Show names the call that rebuilds it\" {\n  let m: Map[String, Int] = from([(\"a\", 1), (\"b\", 2)])\n  assert show(m) == \"map.from([(\\\"a\\\", 1), (\\\"b\\\", 2)])\"\n  let e: Map[String, Int] = empty()\n  assert show(e) == \"map.from([])\"\n  assert show(from([(\"a\", 1)])) == \"map.from([(\\\"a\\\", 1)])\"\n  # the rendering follows the same order everything else here does\n  assert show(from([(\"b\", 2), (\"a\", 1)])) == \"map.from([(\\\"b\\\", 2), (\\\"a\\\", 1)])\"\n}\n\ntest \"for over a Map yields every entry once, in entries' order\" {\n  let m: Map[String, Int] = from([(\"b\", 2), (\"a\", 1), (\"c\", 3)])\n  var seen: List[(String, Int)] = []\n  var n = 0\n  for kv in m {\n    seen = seen ++ [kv]\n    n = n + 1\n  }\n  assert n == 3\n  assert seen == entries(m)\n  assert seen == [(\"b\", 2), (\"a\", 1), (\"c\", 3)]\n  let e: Map[String, Int] = empty()\n  var empty_steps = 0\n  for _kv in e { empty_steps = empty_steps + 1 }\n  assert empty_steps == 0\n}\n")
  } else if name == "set.dawn" {
    Some("## The persistent hash set. Insert and remove answer a new set and leave\n## the old one intact; elements need `Eq + Hash` (spec §2.2, §11).\n#\n# Short names, module-qualified at the call site: `use std/set`, then\n# `set.insert(s, x)`. Forwards to the compiler primitives over the same Dawn\n# hash trie a Map is (std/hamt), exactly like std/map does -- a set is a map to\n# a value nobody reads. Bounds follow the same line: finding an element needs\n# `[T: Eq + Hash]`, counting and listing them do not.\n\n## A set with no elements. The element type comes from the use site.\npub fn empty[T]() -> Set[T] = set_empty()\n\n## A set from a list; duplicates collapse, first occurrence keeps its position.\npub fn from[T: Eq + Hash](xs: List[T]) -> Set[T] = set_from(xs)\n\n## A copy with `x` added; an existing element keeps its insertion position.\npub fn insert[T: Eq + Hash](s: Set[T], x: T) -> Set[T] = set_insert(s, x)\n\n## A copy without `x`; absent elements are fine.\npub fn remove[T: Eq + Hash](s: Set[T], x: T) -> Set[T] = set_remove(s, x)\n\n## Whether `x` is an element.\npub fn has[T: Eq + Hash](s: Set[T], x: T) -> Bool = set_has(s, x)\n\n## Number of elements.\npub fn len[T](s: Set[T]) -> Int = set_size(s)\n\n## Whether there are no elements. The same question `str.is_empty` answers, in\n## the same words (CONTRIBUTING §naming).\npub fn is_empty[T](s: Set[T]) -> Bool = set_size(s) == 0\n\n## The elements, in insertion order.\npub fn to_list[T](s: Set[T]) -> List[T] = set_to_list(s)\n\n# ---- Eq / Hash for Set ----\n#\n# Same reasoning as Map's, which these are: element order is an artifact of\n# insertion, not of the value, so both relations are defined on membership.\n# No `Ord[Set[T]]` for the same reason there is none for Map.\n#\n# As in std/map, the walks take the element count as a parameter: `len` here is\n# the set's, declared above, so it does not answer for the list being walked.\n\nfn eq_go[T: Eq + Hash](b: Set[T], xs: List[T], i: Int, n: Int) -> Bool =\n  if i == n {\n    true\n  } else if has(b, xs[i]) {\n    eq_go(b, xs, i + 1, n)\n  } else {\n    false\n  }\n\n## Same size, and every element of one an element of the other.\nimpl[T: Eq + Hash] Eq[Set[T]] {\n  fn eq(a: Set[T], b: Set[T]) -> Bool =\n    if len(a) != len(b) { false } else { eq_go(b, to_list(a), 0, len(a)) }\n}\n\nfn hash_go[T: Hash](xs: List[T], i: Int, n: Int, acc: Int) -> Int =\n  if i == n { acc } else { hash_go(xs, i + 1, n, acc + hash(xs[i])) }\n\n## A sum over the elements, order-independent like `eq` above.\nimpl[T: Hash] Hash[Set[T]] {\n  fn hash(s: Set[T]) -> Int = hash_go(to_list(s), 0, len(s), 0)\n}\n\nfn show_go[T: Show](xs: List[T], i: Int, n: Int, acc: String) -> String =\n  if i == n {\n    acc\n  } else {\n    show_go(xs, i + 1, n, acc ++ (if i == 0 { \"\" } else { \", \" }) ++ show(xs[i]))\n  }\n\n## `set.from([e0, e1])`, for the same reason a map renders as `map.from`: the\n## rendering names a function the reader can call.\nimpl[T: Show] Show[Set[T]] {\n  fn show(s: Set[T]) -> String = \"set.from([\" ++ show_go(to_list(s), 0, len(s), \"\") ++ \"])\"\n}\n\n# ---- iteration (prelude Iter, #44 knife 2) ----\n\n## `for x in s` yields elements in `to_list`'s order (first-occurrence\n## insertion order, like every set walk). Same materialised cursor as the\n## Map impl, for the same reasons -- see std/map.\nimpl[T: Eq + Hash] Iter[Set[T]] {\n  type Cur = (List[T], Int)\n  type Item = T\n\n  fn iter_start(s: Set[T]) -> (List[T], Int) = (to_list(s), 0)\n  fn iter_done(s: Set[T], c: (List[T], Int)) -> Bool = {\n    let (_es, i) = c\n    i >= set_size(s)\n  }\n  fn iter_next(s: Set[T], c: (List[T], Int)) -> (List[T], Int) = {\n    let (es, i) = c\n    (es, i + 1)\n  }\n  fn iter_get(s: Set[T], c: (List[T], Int)) -> T = {\n    let (es, i) = c\n    es[i]\n  }\n}\n\n# The insertion-order clause is the one with a caller depending on it:\n# `list.unique` is `set`'s ordering, observed from outside, and its promise\n# (\"every value once, at its first occurrence\") is only true while this one is.\n# std/list cannot see this module to say so, so it is said here.\n#\n# As in std/map, `len` is this module's, so the blocks compare whole lists\n# rather than asking one for its length.\n\ntest \"has and remove answer about an element; an absent one is fine\" {\n  let s: Set[String] = from([\"a\", \"b\"])\n  assert has(s, \"a\")\n  assert has(s, \"b\")\n  assert not has(s, \"zz\")\n  assert len(s) == 2\n  assert not is_empty(s)\n  let e: Set[String] = empty()\n  assert not has(e, \"a\")\n  assert len(e) == 0\n  assert is_empty(e)\n  # removing something that is not there answers an equal set, not an error\n  assert remove(s, \"zz\") == s\n  assert len(remove(s, \"zz\")) == 2\n  assert remove(e, \"a\") == e\n  assert len(remove(s, \"a\")) == 1\n  assert not has(remove(s, \"a\"), \"a\")\n  # persistent: the original is untouched\n  assert has(s, \"a\")\n  assert len(s) == 2\n}\n\ntest \"insertion order is first occurrence, and insert and remove keep it\" {\n  # This is what list.unique's promise rests on. Not sorted and not hash\n  # order: the order the elements first arrived in.\n  let s: Set[String] = from([\"b\", \"a\", \"c\"])\n  assert to_list(s) == [\"b\", \"a\", \"c\"]\n  # a duplicate collapses onto the *first* occurrence's position, so the\n  # earlier arrival is what survives in the ordering\n  assert to_list(from([\"b\", \"a\", \"b\", \"c\", \"a\"])) == [\"b\", \"a\", \"c\"]\n  assert len(from([\"b\", \"a\", \"b\", \"c\", \"a\"])) == 3\n  # re-inserting an element already there does not move it to the end\n  assert to_list(insert(s, \"b\")) == [\"b\", \"a\", \"c\"]\n  assert len(insert(s, \"b\")) == 3\n  # a genuinely new element does go on the end\n  assert to_list(insert(s, \"d\")) == [\"b\", \"a\", \"c\", \"d\"]\n  # removing one leaves the others in their order\n  assert to_list(remove(s, \"a\")) == [\"b\", \"c\"]\n  assert to_list(remove(s, \"b\")) == [\"a\", \"c\"]\n  # ... but a removed element that comes back has lost its place\n  assert to_list(insert(remove(s, \"b\"), \"b\")) == [\"a\", \"c\", \"b\"]\n  let e: Set[String] = empty()\n  assert to_list(e) == []\n  let nothing: List[String] = []\n  assert to_list(from(nothing)) == []\n  assert to_list(insert(e, \"only\")) == [\"only\"]\n  # numbers order by arrival too, not by value\n  assert to_list(from([3, 1, 2])) == [3, 1, 2]\n}\n\ntest \"Eq and Hash are about membership, not about arrival order\" {\n  let a: Set[String] = from([\"x\", \"y\"])\n  let b: Set[String] = from([\"y\", \"x\"])\n  let c: Set[String] = remove(from([\"x\", \"y\", \"z\"]), \"z\")\n  assert a == b\n  assert a == c\n  assert hash(a) == hash(b)\n  assert hash(a) == hash(c)\n  # ... while each keeps its own walk order\n  assert to_list(a) == [\"x\", \"y\"]\n  assert to_list(b) == [\"y\", \"x\"]\n  # size counts, so neither a subset nor a superset is equal\n  assert not (a == from([\"x\"]))\n  assert not (a == from([\"x\", \"y\", \"z\"]))\n  assert not (a == from([\"x\", \"z\"]))\n  let e1: Set[String] = empty()\n  let nothing: List[String] = []\n  let e2: Set[String] = from(nothing)\n  assert e1 == e2\n  assert hash(e1) == hash(e2)\n  assert not (e1 == a)\n}\n\ntest \"Show names the call that rebuilds it\" {\n  let s: Set[String] = from([\"b\", \"a\"])\n  assert show(s) == \"set.from([\\\"b\\\", \\\"a\\\"])\"\n  let e: Set[String] = empty()\n  assert show(e) == \"set.from([])\"\n  assert show(from([\"only\"])) == \"set.from([\\\"only\\\"])\"\n  assert show(from([2, 1])) == \"set.from([2, 1])\"\n}\n\ntest \"for over a Set yields every element once, in to_list's order\" {\n  let s: Set[String] = from([\"b\", \"a\", \"c\"])\n  var seen: List[String] = []\n  var n = 0\n  for x in s {\n    seen = seen ++ [x]\n    n = n + 1\n  }\n  assert n == 3\n  assert seen == to_list(s)\n  assert seen == [\"b\", \"a\", \"c\"]\n  let e: Set[String] = empty()\n  var empty_steps = 0\n  for _x in e { empty_steps = empty_steps + 1 }\n  assert empty_steps == 0\n}\n")
  } else if name == "hamt.dawn" {
    Some("# std/hamt — the persistent hash trie that Map and Set are both built from.\n#\n# A 32-way hash-array-mapped trie with path copying: `assoc` rebuilds the nodes\n# along one root-to-leaf path (at most seven of them) and shares everything\n# else with the version it came from. That is what makes an immutable map cheap\n# enough to pass around, and it is the same shape the handwritten Java DawnMap\n# had — the difference is that this one is Dawn source, so every backend gets\n# it for free (docs/collections-dejava-research.md §5.1).\n#\n# Two things it asks of the language, and nothing else:\n#\n#   * `Array[T]` — the single collection primitive a backend implements\n#     (docs/native-backend-plan.md §10). Node children live in one, and the\n#     bounded copy `array_with` performs is the path copy.\n#   * `Eq[K]` + `Hash[K]` — passed as dictionaries, so which equality decides\n#     \"same key\" is the one the key type declares. Before this, a map compared\n#     keys with the JVM's `Object.equals`, which is only *usually* the same\n#     relation as Dawn's `==`.\n#\n# Insertion order is observable (spec §2.2: `keys`/`entries` are in insertion\n# order), so every leaf carries the monotonic `seq` it was first inserted at,\n# and re-binding a key keeps the old one. Iteration sorts by it.\n#\n# Nothing in std imports this module and nothing should: `Map` and `Set` are\n# builtin type names, and the calls that reach here are the ones lowering\n# writes when it turns a `map_*`/`set_*` primitive into a direct call. That is\n# what keeps it a leaf of the module order.\n\n## One node of the trie. `NColl` holds leaves whose hashes are equal, which is\n## the only case a branch cannot separate.\npub type Node[K, V] =\n  | NEmpty\n  | NLeaf(h: Int, k: K, v: V, seq: Int)\n  | NColl(h: Int, kids: Array[Node[K, V]])\n  | NBranch(bitmap: Int, kids: Array[Node[K, V]])\n\n## A whole map: the trie, how many entries are live in it, and the counter the\n## next insertion takes its position from.\npub type Hamt[K, V] = { root: Node[K, V], count: Int, nseq: Int }\n\nconst BITS: Int = 5\n\nconst MASK: Int = 31\n\n## Hashes are used 32 bits at a time. Masking to the unsigned word costs\n## nothing and buys two things: the shift is unambiguous whatever `>>>` does\n## with a sign bit, and the descent is bounded at seven levels rather than\n## thirteen.\nfn hash32[K: Hash](k: K) -> Int = hash(k) & 4294967295\n\nfn idx_at(h: Int, shift: Int) -> Int = (h >>> shift) & MASK\n\n# ---- small array helpers ----\n#\n# `array_with` replaces in place-ish (a bounded copy); insert and remove change\n# the length, so they rebuild. Both run over <= 32 slots, which is what makes\n# the whole structure's O(log n) a small constant.\n\nfn arr1[T](x: T) -> Array[T] = {\n  let e: Array[T] = array_new()\n  array_push(e, x)\n}\n\nfn arr2[T](x: T, y: T) -> Array[T] = array_push(arr1(x), y)\n\nfn arr_insert[T](a: Array[T], i: Int, x: T) -> Array[T] = {\n  var out: Array[T] = array_new()\n  var j = 0\n  while j < i {\n    out = array_push(out, array_get(a, j))\n    j = j + 1\n  }\n  out = array_push(out, x)\n  while j < array_len(a) {\n    out = array_push(out, array_get(a, j))\n    j = j + 1\n  }\n  out\n}\n\nfn arr_remove[T](a: Array[T], i: Int) -> Array[T] = {\n  var out: Array[T] = array_new()\n  var j = 0\n  while j < array_len(a) {\n    if j != i {\n      out = array_push(out, array_get(a, j))\n    }\n    j = j + 1\n  }\n  out\n}\n\n# ---- lookup ----\n\n## The leaf holding `k`, or `None`. Returning the leaf rather than the value\n## lets `assoc` read the `seq` it must preserve without a second descent.\nfn node_leaf[K: Eq, V](n: Node[K, V], shift: Int, h: Int, k: K) -> Option[Node[K, V]] =\n  match n {\n    NEmpty -> None\n    NLeaf(lh, lk, _, _) -> if lh == h && eq(lk, k) { Some(n) } else { None }\n    NColl(ch, kids) -> if ch == h { coll_leaf(kids, 0, k) } else { None }\n    NBranch(bm, kids) -> {\n      let bit = 1 << idx_at(h, shift)\n      if bm & bit == 0 {\n        None\n      } else {\n        node_leaf(array_get(kids, popcount(bm & (bit - 1))), shift + BITS, h, k)\n      }\n    }\n  }\n\nfn coll_leaf[K: Eq, V](kids: Array[Node[K, V]], i: Int, k: K) -> Option[Node[K, V]] =\n  if i >= array_len(kids) {\n    None\n  } else {\n    let kid = array_get(kids, i)\n    match kid {\n      NLeaf(_, lk, _, _) -> if eq(lk, k) { Some(kid) } else { coll_leaf(kids, i + 1, k) }\n      _ -> coll_leaf(kids, i + 1, k)\n    }\n  }\n\n# ---- insertion ----\n\n## A one-child branch holding `n`, whose own hash prefix is `h`. Used to push a\n## leaf down a level when two hashes agree above the current shift.\nfn branch_of[K, V](n: Node[K, V], h: Int, shift: Int) -> Node[K, V] =\n  NBranch(1 << idx_at(h, shift), arr1(n))\n\n## Bind `k` to `v` at position `seq`. The caller has already decided whether\n## this is a fresh key (and so what `seq` is), which is why nothing here has to\n## report back whether the map grew — the alternative allocates a tuple per\n## level, and the levels are the whole cost of the operation.\nfn node_put[K: Eq, V](\n  n: Node[K, V], shift: Int, h: Int, k: K, v: V, seq: Int\n) -> Node[K, V] =\n  match n {\n    NEmpty -> NLeaf(h, k, v, seq)\n    NLeaf(lh, lk, _, _) ->\n      if lh == h {\n        if eq(lk, k) {\n          NLeaf(h, k, v, seq)\n        } else {\n          NColl(h, arr2(n, NLeaf(h, k, v, seq)))\n        }\n      } else {\n        node_put(branch_of(n, lh, shift), shift, h, k, v, seq)\n      }\n    NColl(ch, kids) ->\n      if ch == h {\n        NColl(ch, coll_put(kids, 0, h, k, v, seq))\n      } else {\n        node_put(branch_of(n, ch, shift), shift, h, k, v, seq)\n      }\n    NBranch(bm, kids) -> {\n      let bit = 1 << idx_at(h, shift)\n      let pos = popcount(bm & (bit - 1))\n      if bm & bit == 0 {\n        NBranch(bm | bit, arr_insert(kids, pos, NLeaf(h, k, v, seq)))\n      } else {\n        let sub = node_put(array_get(kids, pos), shift + BITS, h, k, v, seq)\n        NBranch(bm, array_with(kids, pos, sub))\n      }\n    }\n  }\n\nfn coll_put[K: Eq, V](\n  kids: Array[Node[K, V]], i: Int, h: Int, k: K, v: V, seq: Int\n) -> Array[Node[K, V]] =\n  if i >= array_len(kids) {\n    array_push(kids, NLeaf(h, k, v, seq))\n  } else {\n    match array_get(kids, i) {\n      NLeaf(_, lk, _, _) ->\n        if eq(lk, k) {\n          array_with(kids, i, NLeaf(h, k, v, seq))\n        } else {\n          coll_put(kids, i + 1, h, k, v, seq)\n        }\n      _ -> coll_put(kids, i + 1, h, k, v, seq)\n    }\n  }\n\n# ---- removal ----\n#\n# A branch that loses its last child becomes empty, and one left holding a\n# single leaf collapses into that leaf. Collapsing is safe because a leaf\n# carries its whole hash and `node_leaf` compares all of it, so a leaf is\n# correct at any depth — and without it, deleting from a large map would leave\n# a spine of one-child branches that every later lookup walks.\n\nfn node_del[K: Eq, V](n: Node[K, V], shift: Int, h: Int, k: K) -> Node[K, V] =\n  match n {\n    NEmpty -> n\n    NLeaf(lh, lk, _, _) -> if lh == h && eq(lk, k) { NEmpty } else { n }\n    NColl(ch, kids) ->\n      if ch != h {\n        n\n      } else {\n        let left = coll_del(kids, 0, k)\n        if array_len(left) == 1 { array_get(left, 0) } else { NColl(ch, left) }\n      }\n    NBranch(bm, kids) -> {\n      let bit = 1 << idx_at(h, shift)\n      if bm & bit == 0 {\n        n\n      } else {\n        let pos = popcount(bm & (bit - 1))\n        let sub = node_del(array_get(kids, pos), shift + BITS, h, k)\n        match sub {\n          NEmpty -> {\n            let left = arr_remove(kids, pos)\n            if array_len(left) == 0 {\n              NEmpty\n            } else if array_len(left) == 1 && is_leaf(array_get(left, 0)) {\n              array_get(left, 0)\n            } else {\n              NBranch(bm & (-1 - bit), left)\n            }\n          }\n          _ -> NBranch(bm, array_with(kids, pos, sub))\n        }\n      }\n    }\n  }\n\nfn is_leaf[K, V](n: Node[K, V]) -> Bool =\n  match n {\n    NLeaf(_, _, _, _) -> true\n    _ -> false\n  }\n\nfn coll_del[K: Eq, V](kids: Array[Node[K, V]], i: Int, k: K) -> Array[Node[K, V]] =\n  if i >= array_len(kids) {\n    kids\n  } else {\n    match array_get(kids, i) {\n      NLeaf(_, lk, _, _) -> if eq(lk, k) { arr_remove(kids, i) } else { coll_del(kids, i + 1, k) }\n      _ -> coll_del(kids, i + 1, k)\n    }\n  }\n\n# ---- the map surface ----\n\n## A map with no entries.\npub fn empty[K, V]() -> Hamt[K, V] = Hamt { root: NEmpty, count: 0, nseq: 0 }\n\n## Number of live entries.\npub fn count[K, V](m: Hamt[K, V]) -> Int = m.count\n\n## The value bound to `k`, or `None`.\npub fn get[K: Eq + Hash, V](m: Hamt[K, V], k: K) -> Option[V] =\n  match node_leaf(m.root, 0, hash32(k), k) {\n    Some(leaf) ->\n      match leaf {\n        NLeaf(_, _, v, _) -> Some(v)\n        _ -> None\n      }\n    None -> None\n  }\n\n## The value bound to `k`, panicking when it is absent — what `m[k]` means.\n## Naming the missing key is why this one asks for `Show` and nothing else\n## does.\npub fn index[K: Eq + Hash + Show, V](m: Hamt[K, V], k: K) -> V =\n  match get(m, k) {\n    Some(v) -> v\n    None -> panic(\"key not found: \" ++ show(k))\n  }\n\n## Whether `k` is bound.\npub fn has[K: Eq + Hash, V](m: Hamt[K, V], k: K) -> Bool =\n  match node_leaf(m.root, 0, hash32(k), k) {\n    Some(_) -> true\n    None -> false\n  }\n\n## A copy with `k` bound to `v`. A key already present keeps the position it\n## was first inserted at, which is what makes iteration order stable under\n## rebinding (spec §2.2).\n# The fields come out into bindings before the update is built: after the\n# last of these reads nothing touches `m`, so a caller that handed over its\n# only reference gets the map released *before* `node_put` runs -- which is\n# what lets the spine be rewritten in place instead of path-copied\n# (perceus-design.md 6). Written `..m`-style, `m` survives to the end of the\n# expression and pins the whole spine at rc 2.\npub fn assoc[K: Eq + Hash, V](m: Hamt[K, V], k: K, v: V) -> Hamt[K, V] = {\n  let h = hash32(k)\n  let root = m.root\n  let count = m.count\n  let nseq = m.nseq\n  match node_leaf(root, 0, h, k) {\n    Some(leaf) -> {\n      let s = leaf_seq(leaf)\n      Hamt { root: node_put(root, 0, h, k, v, s), count: count, nseq: nseq }\n    }\n    None ->\n      Hamt {\n        root: node_put(root, 0, h, k, v, nseq),\n        count: count + 1,\n        nseq: nseq + 1\n      }\n  }\n}\n\nfn leaf_seq[K, V](n: Node[K, V]) -> Int =\n  match n {\n    NLeaf(_, _, _, s) -> s\n    _ -> -1\n  }\n\n## A copy without `k`; absent keys are fine.\n# Field bindings before the rebuild, for assoc's reason.\npub fn dissoc[K: Eq + Hash, V](m: Hamt[K, V], k: K) -> Hamt[K, V] = {\n  let h = hash32(k)\n  let root = m.root\n  let count = m.count\n  let nseq = m.nseq\n  match node_leaf(root, 0, h, k) {\n    # `m` itself: on this path it is the arm's value, and on the other path\n    # it is dead before `node_del` runs -- per-path accounting keeps both\n    None -> m\n    Some(_) -> Hamt { root: node_del(root, 0, h, k), count: count - 1, nseq: nseq }\n  }\n}\n\n# ---- iteration ----\n#\n# Leaves come out of the trie in hash order, which is not insertion order, so\n# the walk collects `(seq, key, value)` and sorts. The sort is why `seq` is on\n# every leaf rather than kept in a side list: a side list would have to be\n# rewritten on every removal, and removals are rare while lookups are not.\n\nfn walk[K, V](n: Node[K, V], acc: List[(Int, K, V)]) -> List[(Int, K, V)] =\n  match n {\n    NEmpty -> acc\n    NLeaf(_, k, v, s) -> acc ++ [(s, k, v)]\n    NColl(_, kids) -> walk_kids(kids, 0, acc)\n    NBranch(_, kids) -> walk_kids(kids, 0, acc)\n  }\n\nfn walk_kids[K, V](kids: Array[Node[K, V]], i: Int, acc: List[(Int, K, V)]) -> List[(Int, K, V)] =\n  if i >= array_len(kids) {\n    acc\n  } else {\n    walk_kids(kids, i + 1, walk(array_get(kids, i), acc))\n  }\n\nfn by_seq[K, V](a: (Int, K, V), b: (Int, K, V)) -> Int = {\n  let (sa, _, _) = a\n  let (sb, _, _) = b\n  if sa < sb { -1 } else if sa > sb { 1 } else { 0 }\n}\n\nfn ordered[K, V](m: Hamt[K, V]) -> List[(Int, K, V)] = {\n  let empty_acc: List[(Int, K, V)] = []\n  sort_by(walk(m.root, empty_acc), (a, b) => by_seq(a, b))\n}\n\n## The (key, value) pairs, in insertion order.\npub fn entries[K, V](m: Hamt[K, V]) -> List[(K, V)] = {\n  var out: List[(K, V)] = []\n  for e in ordered(m) {\n    let (_, k, v) = e\n    out = out ++ [(k, v)]\n  }\n  out\n}\n\n## The keys, in insertion order.\npub fn keys[K, V](m: Hamt[K, V]) -> List[K] = {\n  var out: List[K] = []\n  for e in ordered(m) {\n    let (_, k, _) = e\n    out = out ++ [k]\n  }\n  out\n}\n\n## The values, in insertion order of their keys.\npub fn values[K, V](m: Hamt[K, V]) -> List[V] = {\n  var out: List[V] = []\n  for e in ordered(m) {\n    let (_, _, v) = e\n    out = out ++ [v]\n  }\n  out\n}\n\n## A map from a list of pairs; a repeated key keeps the last value and the\n## first position.\npub fn from[K: Eq + Hash, V](es: List[(K, V)]) -> Hamt[K, V] = {\n  var m: Hamt[K, V] = empty()\n  for e in es {\n    let (k, v) = e\n    m = assoc(m, k, v)\n  }\n  m\n}\n\n# ---- the set surface ----\n#\n# A set is a map to a value nobody reads, which is how DawnSet related to\n# DawnMap as well. Only the two operations whose shape differs need a name of\n# their own — `has`, `dissoc`, `count` and `keys` already do for a set exactly\n# what a set wants.\n\n## A copy with `x` added; an existing element keeps its position.\npub fn sadd[T: Eq + Hash](s: Hamt[T, Bool], x: T) -> Hamt[T, Bool] = assoc(s, x, true)\n\n## A set from a list; duplicates collapse onto the first occurrence.\npub fn sfrom[T: Eq + Hash](xs: List[T]) -> Hamt[T, Bool] = {\n  var s: Hamt[T, Bool] = empty()\n  for x in xs {\n    s = sadd(s, x)\n  }\n  s\n}\n\n# scripts/hamt-contract is a differential against the builtin Map: random\n# assoc/dissoc traffic, compared step by step. It is the right shape for\n# \"these two agree\" and the wrong one for everything below, which is why none\n# of it is repeated here. What it never calls at all: `index`, `from`, `sadd`,\n# `sfrom` -- the whole set surface -- and it never looks at a `Node`.\n#\n# These blocks look at the trie. `Node` and `Hamt` are ordinary types, so the\n# shape after an operation is observable, and the shapes are where the\n# interesting clauses live: which node a collision produces, which removals\n# collapse a branch and which do not.\n#\n# Int keys are the lever. `hash32` is `hash(k) & 0xFFFFFFFF` and `hash(Int)` is\n# `lo32(v) XOR hi32(v)`, so for `0 <= k < 2^31` the hash *is* the key and the\n# trie shape is a function of the literal. It also makes collisions cheap to\n# write: `k` and `-(k+1)` always collide, because `-(k+1)` is `~k`, whose low\n# half is `0xFFFFFFFF - k` and whose high half is `0xFFFFFFFF`. The contract\n# script's collision family is the \"Aa\"/\"BB\" String one; these are the Int\n# ones, and unlike the String family they come in every arity.\n\ntest \"empty is the trie's zero, and every reader agrees about it\" {\n  let e: Hamt[Int, String] = empty()\n  assert count(e) == 0\n  assert get(e, 0) == None\n  assert not has(e, 0)\n  assert keys(e) == []\n  assert values(e) == []\n  assert entries(e) == []\n  match e.root {\n    NEmpty -> ()\n    _ -> { assert false }\n  }\n  assert e.nseq == 0\n  # removing from nothing is not an error, and does not move the counter\n  let d = dissoc(e, 7)\n  assert count(d) == 0\n  assert d.nseq == 0\n  match d.root {\n    NEmpty -> ()\n    _ -> { assert false }\n  }\n  let none_at_all: List[(Int, String)] = []\n  assert count(from(none_at_all)) == 0\n  let no_elems: List[Int] = []\n  assert count(sfrom(no_elems)) == 0\n}\n\ntest \"index panics with the key it was given; get is the question form\" {\n  let m: Hamt[Int, String] = from([(1, \"one\"), (2, \"two\")])\n  assert index(m, 1) == \"one\"\n  assert index(m, 2) == \"two\"\n  assert get(m, 1) == Some(\"one\")\n  assert get(m, 99) == None\n  assert has(m, 1)\n  assert not has(m, 99)\n  # spec 4.8: `index` is criterion 1 and `get` is criterion 2, over the same\n  # question. The message renders the key with `show`, which is why `index`\n  # is the one function here that asks for it.\n  match catch_panic(() => index(m, 99)) {\n    Ok(_) -> { assert false }\n    Err(er) -> { assert er.message == \"key not found: 99\" }\n  }\n  match catch_panic(() => index(m, 0 - 1)) {\n    Ok(_) -> { assert false }\n    Err(er) -> { assert er.message == \"key not found: -1\" }\n  }\n  # a String key is shown quoted, because that is what `show` does to one\n  let s: Hamt[String, Int] = from([(\"a\", 1)])\n  assert index(s, \"a\") == 1\n  match catch_panic(() => index(s, \"zz\")) {\n    Ok(_) -> { assert false }\n    Err(er) -> { assert er.message == \"key not found: \\\"zz\\\"\" }\n  }\n  let e: Hamt[Int, String] = empty()\n  match catch_panic(() => index(e, 0)) {\n    Ok(_) -> { assert false }\n    Err(er) -> { assert er.message == \"key not found: 0\" }\n  }\n}\n\ntest \"keys that share a hash land in one collision node, and it shrinks back\" {\n  # 0 and -1 have the same hash32, so a branch cannot separate them\n  let two: Hamt[Int, String] = from([(0, \"a\"), (-1, \"b\")])\n  assert count(two) == 2\n  assert get(two, 0) == Some(\"a\")\n  assert get(two, -1) == Some(\"b\")\n  assert keys(two) == [0, -1]\n  match two.root {\n    NColl(_h, kids) -> { assert array_len(kids) == 2 }\n    _ -> { assert false }\n  }\n  # a wider family: three keys, one hash. The String family the contract\n  # script uses only comes in powers of two, so an odd arity is new here.\n  let three: Hamt[Int, String] = from([(0, \"a\"), (-1, \"b\"), (4294967297, \"c\")])\n  assert count(three) == 3\n  assert get(three, 0) == Some(\"a\")\n  assert get(three, -1) == Some(\"b\")\n  assert get(three, 4294967297) == Some(\"c\")\n  match three.root {\n    NColl(_h, kids) -> { assert array_len(kids) == 3 }\n    _ -> { assert false }\n  }\n  # rebinding inside a collision node neither widens it nor moves the key\n  let rebound = assoc(three, -1, \"B\")\n  assert count(rebound) == 3\n  assert get(rebound, -1) == Some(\"B\")\n  assert keys(rebound) == [0, -1, 4294967297]\n  match rebound.root {\n    NColl(_h, kids) -> { assert array_len(kids) == 3 }\n    _ -> { assert false }\n  }\n  # removing narrows it, and the last removal collapses it to a plain leaf\n  let narrowed = dissoc(three, 0)\n  assert count(narrowed) == 2\n  assert get(narrowed, 0) == None\n  match narrowed.root {\n    NColl(_h, kids) -> { assert array_len(kids) == 2 }\n    _ -> { assert false }\n  }\n  let collapsed = dissoc(narrowed, 4294967297)\n  assert count(collapsed) == 1\n  match collapsed.root {\n    NLeaf(_h, k, v, _s) -> {\n      assert k == -1\n      assert v == \"b\"\n    }\n    _ -> { assert false }\n  }\n  # and the one after that empties the trie\n  match dissoc(collapsed, -1).root {\n    NEmpty -> ()\n    _ -> { assert false }\n  }\n}\n\ntest \"a rebound key keeps its position; one that left and came back does not\" {\n  let m: Hamt[Int, String] = from([(0, \"a\"), (1, \"b\"), (2, \"c\")])\n  assert keys(m) == [0, 1, 2]\n  assert entries(m) == [(0, \"a\"), (1, \"b\"), (2, \"c\")]\n  assert values(m) == [\"a\", \"b\", \"c\"]\n  # spec 2.2: rebinding moves the value, not the key. The counter does not\n  # move either, which is the mechanism.\n  let rebound = assoc(m, 0, \"z\")\n  assert keys(rebound) == [0, 1, 2]\n  assert get(rebound, 0) == Some(\"z\")\n  assert count(rebound) == 3\n  assert rebound.nseq == m.nseq\n  # a genuinely new key goes on the end and takes the next position\n  let grown = assoc(m, 9, \"d\")\n  assert keys(grown) == [0, 1, 2, 9]\n  assert grown.nseq == m.nseq + 1\n  # `dissoc` keeps the counter where it is, so a key that leaves and returns\n  # is a new key and lands at the end\n  let gone = dissoc(m, 0)\n  assert keys(gone) == [1, 2]\n  assert gone.nseq == m.nseq\n  assert keys(assoc(gone, 0, \"z\")) == [1, 2, 0]\n  # removing something absent changes nothing at all\n  let same = dissoc(m, 99)\n  assert count(same) == 3\n  assert keys(same) == [0, 1, 2]\n  assert same.nseq == m.nseq\n  # `from` takes the last value and the first position\n  assert entries(from([(1, \"a\"), (2, \"b\"), (1, \"c\")])) == [(1, \"c\"), (2, \"b\")]\n  # the set surface says the same thing about elements\n  assert keys(sfrom([3, 1, 3, 2])) == [3, 1, 2]\n  assert count(sfrom([3, 1, 3, 2])) == 3\n  let s = sadd(sadd(sfrom([3, 1]), 2), 3)\n  assert keys(s) == [3, 1, 2]\n  assert count(s) == 3\n  assert has(s, 3)\n  assert not has(s, 9)\n}\n\ntest \"the trie separates by five bits, and dissoc collapses only a sibling\" {\n  # 0 and 1 differ in the lowest five bits, so one branch separates them\n  let flat: Hamt[Int, String] = from([(0, \"a\"), (1, \"b\")])\n  match flat.root {\n    NBranch(bm, kids) -> {\n      assert bm == 3\n      assert array_len(kids) == 2\n    }\n    _ -> { assert false }\n  }\n  # removing one of two leaf children collapses the branch to the survivor\n  match dissoc(flat, 1).root {\n    NLeaf(_h, k, _v, _s) -> { assert k == 0 }\n    _ -> { assert false }\n  }\n  # 0 and 32 agree in the low five and differ in the next, so the trie needs\n  # a second level\n  let deep: Hamt[Int, String] = from([(0, \"a\"), (32, \"b\")])\n  assert get(deep, 0) == Some(\"a\")\n  assert get(deep, 32) == Some(\"b\")\n  match deep.root {\n    NBranch(bm, kids) -> {\n      assert bm == 1\n      assert array_len(kids) == 1\n    }\n    _ -> { assert false }\n  }\n  # Recorded, not fixed. Collapsing is only checked where a *sibling* was\n  # removed; a child that collapsed on its own leaves its parent a\n  # one-child branch. So this answers a branch holding one leaf, where the\n  # two-key case above answers the leaf itself -- the same map, two shapes.\n  match dissoc(deep, 32).root {\n    NBranch(bm, kids) -> {\n      assert bm == 1\n      assert array_len(kids) == 1\n    }\n    _ -> { assert false }\n  }\n  assert count(dissoc(deep, 32)) == 1\n  assert get(dissoc(deep, 32), 0) == Some(\"a\")\n  # the deepest the trie ever goes: 0 and 2^30 agree in the low thirty bits,\n  # which is the last level `idx_at` can distinguish\n  let deepest: Hamt[Int, String] = from([(0, \"a\"), (1073741824, \"b\")])\n  assert count(deepest) == 2\n  assert get(deepest, 0) == Some(\"a\")\n  assert get(deepest, 1073741824) == Some(\"b\")\n  # a key whose hash has the sign bit set: `hash` is a 32-bit signed value, so\n  # this one is negative until `hash32` masks it back. Nothing else covers it.\n  let signed: Hamt[Int, String] = from([(2147483648, \"a\"), (0, \"b\")])\n  assert count(signed) == 2\n  assert get(signed, 2147483648) == Some(\"a\")\n  assert get(signed, 0) == Some(\"b\")\n  assert keys(signed) == [2147483648, 0]\n}\n")
  } else if name == "pvec.dawn" {
    Some("# std/pvec — the persistent vector behind List.\n#\n# A 32-way trie with a tail buffer: Clojure's PersistentVector, which is what\n# \"strict RB\" means in docs/collections-dejava-research.md §5.3. The last\n# (partial) block of elements lives in `tail`, an `Array` of at most 32 slots;\n# everything before it lives in a trie whose leaves are the same shape. An\n# append copies the tail — bounded work — and every 32nd one also pushes the\n# full tail into the trie, copying one root-to-leaf path.\n#\n# Why this and not the flat shared-array window it replaces: the window is\n# O(1) to append to only while one version owns the frontier, and O(n) to copy\n# the moment two versions want it. That is fine on a backend that can hand out\n# a mutable array and track who owns it — the JVM one did, with a CAS\n# watermark — but it is not something Dawn source can express, and a second\n# backend would have to reimplement it. Here the sharing is structural, so\n# both backends get it from the same source (docs/native-backend-plan.md §10).\n#\n# The one thing it still asks of the backend is that `array_push` extend in\n# place when the array it is given ends where the shared region ends. That is\n# exactly the accumulation shape — `out = out ++ [x]` — and it is what keeps\n# an append a constant-size copy rather than 32 slots every time.\n#\n# Nothing in std imports this module: `List` is a builtin type name, and the\n# calls that arrive here are the ones lowering writes for a list primitive.\n\nconst BITS: Int = 5\n\nconst WIDTH: Int = 32\n\nconst MASK: Int = 31\n\n## A trie node. Leaves hold elements, branches hold nodes, and both are one\n## `Array` of at most 32 slots — the shape that makes a path copy bounded.\npub type VNode[T] =\n  | VLeaf(items: Array[T])\n  | VBranch(kids: Array[VNode[T]])\n\n## A whole vector: how many elements, how deep the trie is, the trie, and the\n## unfinished last block.\npub type Vec[T] = { cnt: Int, shift: Int, root: VNode[T], tail: Array[T] }\n\n# ---- small array helpers ----\n\nfn arr1[T](x: T) -> Array[T] = {\n  let e: Array[T] = array_new()\n  array_push(e, x)\n}\n\nfn arr2[T](x: T, y: T) -> Array[T] = array_push(arr1(x), y)\n\nfn arr_slice[T](a: Array[T], from: Int, to: Int) -> Array[T] = {\n  var out: Array[T] = array_new()\n  var i = from\n  while i < to {\n    out = array_push(out, array_get(a, i))\n    i = i + 1\n  }\n  out\n}\n\n# ---- shape ----\n\n## Where the tail starts: everything at or after this index is in `tail`.\nfn tail_off(cnt: Int) -> Int = if cnt < WIDTH { 0 } else { ((cnt - 1) >>> BITS) << BITS }\n\n## The block holding element `i`. For any vector of fewer than 32 elements this\n## is the tail and costs nothing — which is most lists in most programs, and\n## the reason an index cursor stays cheap.\nfn leaf_for[T](v: Vec[T], i: Int) -> Array[T] =\n  if i >= tail_off(v.cnt) {\n    v.tail\n  } else {\n    var node = v.root\n    var level = v.shift\n    while level > 0 {\n      node = match node {\n        VBranch(kids) -> array_get(kids, (i >>> level) & MASK)\n        VLeaf(_) -> node\n      }\n      level = level - BITS\n    }\n    match node {\n      VLeaf(items) -> items\n      VBranch(_) -> panic(\"pvec: branch where a leaf belongs\")\n    }\n  }\n\n# ---- construction ----\n\n## A vector with no elements.\npub fn empty[T]() -> Vec[T] = {\n  let e: Array[VNode[T]] = array_new()\n  let t: Array[T] = array_new()\n  Vec { cnt: 0, shift: BITS, root: VBranch(e), tail: t }\n}\n\n## Number of elements.\npub fn count[T](v: Vec[T]) -> Int = v.cnt\n\nfn new_path[T](level: Int, node: VNode[T]) -> VNode[T] =\n  if level == 0 { node } else { VBranch(arr1(new_path(level - BITS, node))) }\n\n## Fold a full tail into the trie, copying the one path that changes.\nfn push_tail[T](cnt: Int, level: Int, parent: VNode[T], tail: Array[T]) -> VNode[T] =\n  match parent {\n    VLeaf(_) -> VLeaf(tail)\n    VBranch(kids) -> {\n      let sub = ((cnt - 1) >>> level) & MASK\n      if level == BITS {\n        if sub < array_len(kids) {\n          VBranch(array_with(kids, sub, VLeaf(tail)))\n        } else {\n          VBranch(array_push(kids, VLeaf(tail)))\n        }\n      } else if sub < array_len(kids) {\n        VBranch(array_with(kids, sub,\n          push_tail(cnt, level - BITS, array_get(kids, sub), tail)))\n      } else {\n        VBranch(array_push(kids, new_path(level - BITS, VLeaf(tail))))\n      }\n    }\n  }\n\n## A copy with `x` appended.\npub fn push[T](v: Vec[T], x: T) -> Vec[T] =\n  if array_len(v.tail) < WIDTH {\n    Vec { ..v, cnt: v.cnt + 1, tail: array_push(v.tail, x) }\n  } else if (v.cnt >>> BITS) > (1 << v.shift) {\n    # the trie is full at this depth: grow a level, with the old root beside a\n    # fresh path down to the tail that just came off\n    Vec {\n      cnt: v.cnt + 1,\n      shift: v.shift + BITS,\n      root: VBranch(arr2(v.root, new_path(v.shift, VLeaf(v.tail)))),\n      tail: arr1(x)\n    }\n  } else {\n    Vec {\n      cnt: v.cnt + 1,\n      shift: v.shift,\n      root: push_tail(v.cnt, v.shift, v.root, v.tail),\n      tail: arr1(x)\n    }\n  }\n\n# ---- reading ----\n#\n# One unchecked reader, private, and every public way in checks first. It was\n# the other way round until 2026-07-30: `nth` was `pub` and did no checking,\n# so `nth(v, 70)` on a 64-element vector answered `38` rather than failing --\n# `i & MASK` folds an out-of-range index back onto a legal slot in whichever\n# block `leaf_for` picked. That is the \"illegal input, silently wrong answer\"\n# shape, and spec 4.8's out-of-bounds criteria say a positional read past\n# the end is a panic (docs/audit/re-audit-2026-07-30.md RD-01).\n\n## Element `i`, whose range the caller has already established. Out of range\n## this answers with some other element rather than failing, which is why it\n## is not `pub`.\nfn at[T](v: Vec[T], i: Int) -> T = array_get(leaf_for(v, i), i & MASK)\n\n## Element `i`, panicking out of range — what `xs[i]` means.\npub fn index[T](v: Vec[T], i: Int) -> T =\n  if i < 0 || i >= v.cnt {\n    panic(\"index \" ++ to_string(i) ++ \" out of bounds for length \" ++ to_string(v.cnt))\n  } else {\n    at(v, i)\n  }\n\n## Element `i`, panicking out of range. The name Clojure gives the checked\n## accessor, and the same function `index` is: the comparison it costs is\n## nothing beside `leaf_for`, so there is no unchecked public reader to make\n## the saving worth a wrong answer.\npub fn nth[T](v: Vec[T], i: Int) -> T = index(v, i)\n\n## Element `i`, or `None` when it is out of range.\npub fn get[T](v: Vec[T], i: Int) -> Option[T] =\n  if i < 0 || i >= v.cnt { None } else { Some(at(v, i)) }\n\n# ---- bulk ----\n#\n# These walk by block rather than by index: `leaf_for` is cheap but not free,\n# and asking it once per 32 elements instead of once per element is what keeps\n# a copy linear with a small constant.\n\nfn each_block[T, A](v: Vec[T], i: Int, acc: A, f: fn(A, T) -> A !e) -> A !e =\n  if i >= v.cnt {\n    acc\n  } else {\n    let blk = leaf_for(v, i)\n    let base = i - (i & MASK)\n    let stop = if base + array_len(blk) < v.cnt { base + array_len(blk) } else { v.cnt }\n    each_block(v, stop, fold_block(blk, i - base, stop - base, acc, f), f)\n  }\n\nfn fold_block[T, A](blk: Array[T], i: Int, stop: Int, acc: A, f: fn(A, T) -> A !e) -> A !e =\n  if i >= stop { acc } else { fold_block(blk, i + 1, stop, f(acc, array_get(blk, i)), f) }\n\n## Every element in order, as one flat array.\npub fn to_array[T](v: Vec[T]) -> Array[T] = {\n  let e: Array[T] = array_new()\n  each_block(v, 0, e, (a, x) => array_push(a, x))\n}\n\n## A vector holding `a`'s elements in order.\npub fn from_array[T](a: Array[T]) -> Vec[T] = {\n  var v: Vec[T] = empty()\n  var i = 0\n  while i < array_len(a) {\n    v = push(v, array_get(a, i))\n    i = i + 1\n  }\n  v\n}\n\n## `a` then `b`. Linear in `b`, which is the shape `++` is used in: the right\n## side is almost always a single element being accumulated.\npub fn concat[T](a: Vec[T], b: Vec[T]) -> Vec[T] =\n  if b.cnt == 0 { a } else { each_block(b, 0, a, (v, x) => push(v, x)) }\n\n## The elements in `[from, to)`. Both ends are clamped into `[0, len]` and\n## `from > to` yields the empty vector, so this never panics — spec §4.8's\n## criterion 3, the clause `list.slice` and `bytes.slice` already answer to.\n##\n## It clamped nothing until v0.54.0, and so had three behaviours for one\n## question: `from > to` gave empty, a modest overshoot gave *other elements*\n## (`at`'s `i & MASK` folds the index back into the tail — `slice(v, 128, 131)`\n## on 100 elements answered with elements 96..98), and a larger one reached the\n## array layer's own panic, whose wording differs between the two backends. The\n## last public unchecked reader; RD-01 took `nth`'s away for the same reason.\npub fn slice[T](v: Vec[T], from: Int, to: Int) -> Vec[T] = {\n  var out: Vec[T] = empty()\n  var i = clamp_idx(from, v.cnt)\n  let stop = clamp_idx(to, v.cnt)\n  while i < stop {\n    out = push(out, at(v, i))\n    i = i + 1\n  }\n  out\n}\n\nfn clamp_idx(i: Int, n: Int) -> Int = if i < 0 { 0 } else if i > n { n } else { i }\n\n## `[from, to)` as a vector of Ints.\npub fn range(from: Int, to: Int) -> Vec[Int] = {\n  var out: Vec[Int] = empty()\n  var i = from\n  while i < to {\n    out = push(out, i)\n    i = i + 1\n  }\n  out\n}\n\n# ---- sorting ----\n#\n# A merge sort on the flat array, because a sort is the one bulk operation\n# that reads by position over and over: paying `leaf_for` per comparison would\n# put the trie in the inner loop. Stable, since a tie takes from the left.\n\nfn merge[T](a: Array[T], b: Array[T], cmp: fn(T, T) -> Int !e) -> Array[T] !e = {\n  var out: Array[T] = array_new()\n  var i = 0\n  var j = 0\n  while i < array_len(a) && j < array_len(b) {\n    let x = array_get(a, i)\n    let y = array_get(b, j)\n    if cmp(y, x) < 0 {\n      out = array_push(out, y)\n      j = j + 1\n    } else {\n      out = array_push(out, x)\n      i = i + 1\n    }\n  }\n  while i < array_len(a) {\n    out = array_push(out, array_get(a, i))\n    i = i + 1\n  }\n  while j < array_len(b) {\n    out = array_push(out, array_get(b, j))\n    j = j + 1\n  }\n  out\n}\n\nfn msort[T](a: Array[T], cmp: fn(T, T) -> Int !e) -> Array[T] !e = {\n  let n = array_len(a)\n  if n <= 1 {\n    a\n  } else {\n    let mid = n / 2\n    merge(msort(arr_slice(a, 0, mid), cmp), msort(arr_slice(a, mid, n), cmp), cmp)\n  }\n}\n\n## Stable ascending sort by `cmp`.\npub fn sort_by[T](v: Vec[T], cmp: fn(T, T) -> Int !e) -> Vec[T] !e =\n  from_array(msort(to_array(v), cmp))\n\n# scripts/pvec-contract drives `push`/`get`/`nth` at twelve sizes and compares\n# against the builtin List. What it never touches: `range` (nothing in the tree\n# calls it), `index` by name, both panic message strings, `slice` outside the\n# range its caller promised, and the sizes where the trie gains a level -- its\n# size list steps from 1025 straight to 32768, and the growth point is 1057.\n#\n# `Vec` and `VNode` are ordinary types, so the shape is observable, and the\n# shape is where the tail/trie split lives. There is no `Eq[Vec[T]]` -- an\n# `Array` is held by identity, so `==` on two vectors does not compile -- which\n# is why everything below compares element by element.\n\ntest \"empty, and the tail that holds everything until the trie starts\" {\n  let e: Vec[Int] = empty()\n  assert count(e) == 0\n  assert get(e, 0) == None\n  assert get(e, 0 - 1) == None\n  # not a leaf and not nothing: an empty branch, at the shallowest shift\n  match e.root {\n    VBranch(kids) -> { assert array_len(kids) == 0 }\n    VLeaf(_items) -> { assert false }\n  }\n  assert e.shift == 5\n  assert array_len(e.tail) == 0\n\n  # up to and including 32 elements the trie is still empty -- the tail holds\n  # the lot, and the first spill is at 33\n  var v: Vec[Int] = empty()\n  var i = 0\n  while i < 32 {\n    v = push(v, i)\n    i = i + 1\n  }\n  let at32 = v\n  assert count(at32) == 32\n  assert array_len(at32.tail) == 32\n  match at32.root {\n    VBranch(kids) -> { assert array_len(kids) == 0 }\n    VLeaf(_items) -> { assert false }\n  }\n  let at33 = push(at32, 32)\n  assert count(at33) == 33\n  assert array_len(at33.tail) == 1\n  match at33.root {\n    VBranch(kids) -> { assert array_len(kids) == 1 }\n    VLeaf(_items) -> { assert false }\n  }\n  # and every element is still where it was put, on both sides of the split\n  assert nth(at33, 0) == 0\n  assert nth(at33, 31) == 31\n  assert nth(at33, 32) == 32\n  # persistent: pushing did not disturb the vector that was pushed onto\n  assert count(at32) == 32\n  assert get(at32, 32) == None\n}\n\ntest \"index and nth are one function, and it names the bounds it refused\" {\n  var v: Vec[Int] = empty()\n  var i = 0\n  while i < 100 {\n    v = push(v, i * 10)\n    i = i + 1\n  }\n  let vv = v\n  assert count(vv) == 100\n  assert index(vv, 0) == 0\n  assert index(vv, 99) == 990\n  # `nth` is `index` under another name, deliberately: there is no unchecked\n  # public reader, so the two cannot disagree\n  assert nth(vv, 0) == index(vv, 0)\n  assert nth(vv, 63) == index(vv, 63)\n  assert nth(vv, 99) == index(vv, 99)\n  # the tail/trie split is at 96 here, and it is invisible from outside\n  assert nth(vv, 95) == 950\n  assert nth(vv, 96) == 960\n  # spec 4.8 criterion 1. The message is asserted, not just the panic: it is\n  # the only place either string is checked, and it carries both numbers.\n  match catch_panic(() => nth(vv, 100)) {\n    Ok(_) -> { assert false }\n    Err(er) -> { assert er.message == \"index 100 out of bounds for length 100\" }\n  }\n  match catch_panic(() => nth(vv, 0 - 1)) {\n    Ok(_) -> { assert false }\n    Err(er) -> { assert er.message == \"index -1 out of bounds for length 100\" }\n  }\n  match catch_panic(() => index(vv, 1000)) {\n    Ok(_) -> { assert false }\n    Err(er) -> { assert er.message == \"index 1000 out of bounds for length 100\" }\n  }\n  # The RD-01 regression, from the other side: 130 masks to 2 inside the tail,\n  # so an unchecked reader would answer element 98 rather than refuse.\n  match catch_panic(() => nth(vv, 130)) {\n    Ok(_) -> { assert false }\n    Err(er) -> { assert er.message == \"index 130 out of bounds for length 100\" }\n  }\n  let e: Vec[Int] = empty()\n  match catch_panic(() => nth(e, 0)) {\n    Ok(_) -> { assert false }\n    Err(er) -> { assert er.message == \"index 0 out of bounds for length 0\" }\n  }\n  # `get` is the same question, answered rather than asserted\n  assert get(vv, 0) == Some(0)\n  assert get(vv, 99) == Some(990)\n  assert get(vv, 100) == None\n  assert get(vv, 130) == None\n  assert get(vv, 0 - 1) == None\n}\n\ntest \"the trie gains a level at 1057, and not at 1056\" {\n  # The size list in scripts/pvec-contract steps from 1025 to 32768, so the\n  # boundary is between two of its entries and nothing sits on it. `push`\n  # deepens when `(cnt >>> 5) > (1 << shift)`, which first holds at 1056\n  # elements already stored -- so 1056 is still one level and 1057 is two.\n  var v: Vec[Int] = empty()\n  var i = 0\n  while i < 1058 {\n    v = push(v, i)\n    i = i + 1\n  }\n  let big = v\n  assert count(big) == 1058\n  assert slice(big, 0, 1055).shift == 5\n  assert slice(big, 0, 1056).shift == 5\n  assert slice(big, 0, 1057).shift == 10\n  assert slice(big, 0, 1058).shift == 10\n  assert big.shift == 10\n  # a full root at one level: 1025 elements is 32 leaves plus one in the tail\n  assert slice(big, 0, 1025).shift == 5\n  match slice(big, 0, 1025).root {\n    VBranch(kids) -> { assert array_len(kids) == 32 }\n    VLeaf(_items) -> { assert false }\n  }\n  # and reading still agrees with what was pushed, across the new level\n  assert nth(big, 0) == 0\n  assert nth(big, 1023) == 1023\n  assert nth(big, 1024) == 1024\n  assert nth(big, 1056) == 1056\n  assert nth(big, 1057) == 1057\n  assert get(big, 1058) == None\n}\n\ntest \"range is half-open, and empty whenever it is not\" {\n  # Nothing in the tree calls this function, so this block is all of its\n  # coverage.\n  let r = range(0, 5)\n  assert count(r) == 5\n  assert nth(r, 0) == 0\n  assert nth(r, 4) == 4\n  assert get(r, 5) == None\n  # negative bounds are ordinary\n  let neg = range(0 - 3, 3)\n  assert count(neg) == 6\n  assert nth(neg, 0) == -3\n  assert nth(neg, 3) == 0\n  assert nth(neg, 5) == 2\n  # backwards and degenerate ranges are empty rather than errors\n  assert count(range(5, 3)) == 0\n  assert count(range(0, 0)) == 0\n  assert count(range(3, 3)) == 0\n  assert count(range(0 - 1, 0 - 1)) == 0\n  assert count(range(0, 1)) == 1\n  assert nth(range(0, 1), 0) == 0\n  # and it crosses the tail boundary like anything else\n  assert count(range(0, 33)) == 33\n  assert nth(range(0, 33), 32) == 32\n}\n\ntest \"slice and concat at their edges, and slice's clamping\" {\n  var v: Vec[Int] = empty()\n  var i = 0\n  while i < 100 {\n    v = push(v, i)\n    i = i + 1\n  }\n  let vv = v\n  let e: Vec[Int] = empty()\n  assert count(slice(vv, 0, 100)) == 100\n  assert nth(slice(vv, 0, 100), 99) == 99\n  assert count(slice(vv, 10, 20)) == 10\n  assert nth(slice(vv, 10, 20), 0) == 10\n  assert nth(slice(vv, 10, 20), 9) == 19\n  # straddling the tail/trie split at 96\n  assert count(slice(vv, 90, 100)) == 10\n  assert nth(slice(vv, 90, 100), 0) == 90\n  assert nth(slice(vv, 90, 100), 9) == 99\n  # backwards and degenerate slices are empty\n  assert count(slice(vv, 5, 3)) == 0\n  assert count(slice(vv, 0, 0)) == 0\n  assert count(slice(vv, 100, 100)) == 0\n  assert count(slice(e, 0, 0)) == 0\n\n  # The three behaviours this function used to have, now one. Until v0.54.0 a\n  # modest overshoot read through the private unchecked reader and `i & MASK`\n  # folded the index back into the tail: `slice(vv, 128, 131)` answered with\n  # elements 96..98 rather than refusing -- the shape audit RD-01 took out of\n  # `nth`, left live behind this function. Further out it reached the array\n  # layer's own panic, whose text the two backends word differently. Both ends\n  # are clamped now, so all three cases are the one clause `list.slice` and\n  # `bytes.slice` already answer to (spec 4.8, criterion 3).\n  assert count(slice(vv, 128, 131)) == 0\n  assert count(slice(vv, 0, 101)) == 100\n  assert count(slice(vv, 0 - 5, 3)) == 3\n  assert nth(slice(vv, 0 - 5, 3), 0) == 0\n  assert count(slice(vv, 98, 200)) == 2\n  assert nth(slice(vv, 98, 200), 1) == 99\n  assert count(slice(e, 0 - 1, 99)) == 0\n\n  # `concat(a, empty())` is `a` itself; the other way round rebuilds\n  assert count(concat(vv, e)) == 100\n  assert count(concat(e, vv)) == 100\n  assert nth(concat(e, vv), 0) == 0\n  assert nth(concat(e, vv), 99) == 99\n  let pair = concat(slice(vv, 0, 30), slice(vv, 30, 40))\n  assert count(pair) == 40\n  assert nth(pair, 0) == 0\n  assert nth(pair, 29) == 29\n  assert nth(pair, 30) == 30\n  assert nth(pair, 39) == 39\n  # crossing the tail boundary in the middle of a concat\n  let crossed = concat(slice(vv, 0, 30), slice(vv, 30, 70))\n  assert count(crossed) == 70\n  assert nth(crossed, 32) == 32\n  assert nth(crossed, 69) == 69\n  assert count(concat(e, e)) == 0\n}\n\ntest \"sort_by is stable, and the degenerate inputs are not special cases\" {\n  let e: Vec[Int] = empty()\n  assert count(sort_by(e, (a, b) => a - b)) == 0\n  let one = push(e, 42)\n  assert count(sort_by(one, (a, b) => a - b)) == 1\n  assert nth(sort_by(one, (a, b) => a - b), 0) == 42\n  # two elements, both orders\n  let asc = push(push(e, 1), 2)\n  let desc = push(push(e, 2), 1)\n  assert nth(sort_by(asc, (a, b) => a - b), 0) == 1\n  assert nth(sort_by(asc, (a, b) => a - b), 1) == 2\n  assert nth(sort_by(desc, (a, b) => a - b), 0) == 1\n  assert nth(sort_by(desc, (a, b) => a - b), 1) == 2\n  # already sorted, reversed, and all equal\n  let rev = range(0, 40)\n  let backwards = sort_by(rev, (a, b) => b - a)\n  assert nth(backwards, 0) == 39\n  assert nth(backwards, 39) == 0\n  let forwards = sort_by(backwards, (a, b) => a - b)\n  assert nth(forwards, 0) == 0\n  assert nth(forwards, 39) == 39\n  assert count(forwards) == 40\n  var flat: Vec[Int] = empty()\n  var i = 0\n  while i < 40 {\n    flat = push(flat, 7)\n    i = i + 1\n  }\n  let same = sort_by(flat, (a, b) => a - b)\n  assert count(same) == 40\n  assert nth(same, 0) == 7\n  assert nth(same, 39) == 7\n\n  # Stability: the comparator sees only the first component, so equal keys must\n  # come out in the order they went in. Crossing the 32-element tail boundary,\n  # because a merge sort's blocks and the vector's blocks are different things.\n  var pairs: Vec[(Int, Int)] = empty()\n  var j = 0\n  while j < 40 {\n    pairs = push(pairs, (j % 3, j))\n    j = j + 1\n  }\n  let sorted = sort_by(pairs, (a, b) => {\n    let (ka, _va) = a\n    let (kb, _vb) = b\n    ka - kb\n  })\n  assert count(sorted) == 40\n  var prev_key = -1\n  var prev_val = -1\n  var k = 0\n  while k < 40 {\n    let (key, val) = nth(sorted, k)\n    assert key >= prev_key\n    if key == prev_key {\n      assert val > prev_val\n    }\n    prev_key = key\n    prev_val = val\n    k = k + 1\n  }\n  # the first group is every j with j % 3 == 0, in ascending j\n  let (k0, v0) = nth(sorted, 0)\n  assert k0 == 0\n  assert v0 == 0\n  let (k1, v1) = nth(sorted, 1)\n  assert k1 == 0\n  assert v1 == 3\n}\n")
  } else {
    None
  }

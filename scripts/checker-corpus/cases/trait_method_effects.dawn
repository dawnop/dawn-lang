# checker.dawn: a trait or impl method's row is pure or !io, never a user effect
effect Ask { fn ask() -> Int }

trait Eff[T] {
  fn a(x: T) -> Int !Ask
  fn b(x: T) -> Int !e
  fn c(x: T, f: fn() -> Int !Ask) -> Int
  fn d(x: T, f: fn() -> Int !e) -> Int
}

trait Plain[T] {
  fn m(x: T) -> Int
  fn n(x: T) -> Int
  fn o(x: T) -> Int
  fn p(x: T) -> Int
}

type Sub = S

impl Plain[Sub] {
  fn m(x: Sub) -> Int !Ask = 1
  fn n(x: Sub) -> Int !e = 1
  fn o(x: Sub) -> Int = 1
  fn p(x: Sub) -> Int = 1
}

trait Sigs[T] {
  fn sq(x: T) -> Int
  fn sr(x: T) -> Int
}

impl Sigs[Sub] {
  fn sq(x: Sub, f: fn() -> Int !Ask) -> Int = 1
  fn sr(x: Sub, f: fn() -> Int !e) -> Int = 1
}

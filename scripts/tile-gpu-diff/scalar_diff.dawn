# Layer 2 for runtime scalar kernel parameters (tileir 0.12.0, knife 3): one
# `!Gpu` program runs the four kernels scripts/tile-golden pins under
# `with_gpu_real` against the machine's GPU and under `with_gpu_fake`
# against hand-written host references, and prints what each device
# answered.
#
#   scalar_diff <scalar_scale.cubin> <scalar_len.cubin> <scalar_loop.cubin> <scalar_wide.cubin>
#
# WHAT ONLY A DEVICE CAN SAY, and what this program was written to ask:
#
#   * ONE CUBIN, TWO VALUES. `scalar_scale` is launched with an f32 scale
#     of 3 and again of -0.25, `scalar_len` with several lengths and
#     `scalar_loop` with several trip counts, all through ONE cubin each.
#     A constant spelled `f_const(F32, 3.0)` is a different program per
#     value; a scalar parameter is the same program, and the device is the
#     only thing that can say the value arrived.
#
#   * THE VALUE IS READ WHERE THE KERNEL USES IT: a mask bound
#     (`scalar_len`: lanes at or past `n` are neither read nor written, and
#     a negative `n` masks every lane) and a LOOP BOUND (`scalar_loop`: the
#     block sums the first `n` tiles in order, and 0 is the empty sum).
#
#   * THE ARGUMENT WORD'S HIGH HALF IS NOT READ (docs/tileir-k4-design.md
#     3.6). Every argument crosses `cuLaunchKernel` as one 8-byte word and
#     the kernel declares 4 of them for an i32 or an f32. Three cases hand
#     the device a word whose upper 32 bits are garbage (0xDEADBEEF, 0x7FFFFFFF,
#     0xFFFFFFFF), built with the `Word` constructor because `scalar` never
#     makes one, and the verdict says they answer what the clean words do.
#     `run.sh`'s `word-high-bits-cleared` mutant is the control that this
#     is a property of the device and not of the host.
#
#   * TWO SCALARS ARE TWO SCALARS. `scalar_wide` takes an f64 and an i64
#     beside four buffers, so the two 64-bit formats and the order of the
#     parameters are measured; `scalars-swapped` is the mutant.
#
# THE TIER IS EXACT, every case: each lane is one binary64 product or sum of
# values both sides hold exactly, or a masked copy.
use std/io
use std/io.{Exit, with_fs_real}
use std/gpu
use std/gpu.{Gpu, with_gpu_fake, with_gpu_real, WideRefFn, last_out_with, LaunchArg, Word, Buf}
use std/narrow
use std/int/i32
use std/int/i32.{I32}
use std/str
use tileref/ref.{scalar_scale_ref, scalar_len_ref, scalar_loop_ref, scalar_wide_ref}
use std/list
use std/map

## The sentinel every output buffer holds past its answer.
pub const SENTINEL: Float = 0.0 - 12345.678

## The tolerance tier's numbers; nothing here uses them.
pub const ATOL: Float = 1.0e-5
pub const RTOL: Float = 1.0e-5

## The block widths the kernels were recorded with. These must agree with
## scripts/tile-golden/kernels.dawn's SK_TILE and SK_WIDE_TILE.
pub const SK_TILE: Int = 128
pub const SK_WIDE_TILE: Int = 64

type Trace = {
  alloc: String,
  upload: String,
  launch: String,
  sync: String,
  download: String,
  result: Option[List[Float]],
  note: String
}

fn kind[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> "ok"
  Err(e) -> e.kind
}

fn message[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> ""
  Err(e) -> e.message
}

fn blank() -> Trace =
  Trace { alloc: "-", upload: "-", launch: "-", sync: "-", download: "-", result: None, note: "" }

# Allocate and fill one buffer per (format, contents) pair, in order.
fn alloc_all(bufs: List[(String, List[Float])]) -> Result[List[Int], ForeignError] !Gpu = {
  var hs: List[Int] = []
  for (dt, data) in bufs {
    hs = hs ++ [gpu.gpu_alloc(dt, len(data))?]
  }
  Ok(hs)
}

fn upload_all(hs: List[Int], bufs: List[(String, List[Float])]) -> Result[Unit, ForeignError] !Gpu = {
  for i in 0..len(hs) {
    let (dt, data) = bufs[i]
    gpu.gpu_upload(hs[i], gpu.pack_to(dt, data))?
  }
  Ok(())
}

fn release(hs: List[Int]) -> Unit !Gpu = {
  for h in hs {
    let _ = gpu.gpu_free(h)
  }
}

## One launch of `kernel` over `bufs` (each a format and its initial
## contents) with `spec` as its arguments, one stage at a time, stopping at
## the first refusal and saying which stage it was. The LAST buffer is the
## output, and the one this reads back, except that `back` names which buffers
## to read (the wide kernel writes two).
type Spec =
  | B(at: Int)
  | W(word: LaunchArg)

fn args_of(spec: List[Spec], hs: List[Int]) -> List[LaunchArg] =
  list.map(spec, s => match s {
    B(k) -> Buf(hs[k])
    W(w) -> w
  })

fn stages(kernel: String, gx: Int, bufs: List[(String, List[Float])], spec: List[Spec],
  back: List[Int]) -> Trace !Gpu =
  match alloc_all(bufs) {
    Err(e) -> Trace { ..blank(), alloc: e.kind, note: e.message }
    Ok(hs) -> {
      let t0 = Trace { ..blank(), alloc: "ok" }
      match upload_all(hs, bufs) {
        Err(e) -> {
          release(hs)
          Trace { ..t0, upload: e.kind, note: e.message }
        }
        Ok(_) -> {
          let t1 = Trace { ..t0, upload: "ok" }
          match gpu.gpu_launch(kernel, gx, 1, 1, args_of(spec, hs)) {
            Err(e) -> {
              release(hs)
              Trace { ..t1, launch: e.kind, note: e.message }
            }
            Ok(_) -> {
              let s = gpu.gpu_sync()
              var all: List[Float] = []
              var bad = "ok"
              for k in back {
                let (back_dt, _back) = bufs[k]
                match gpu.gpu_download(hs[k]) {
                  Ok(raw) -> {
                    all = all ++ gpu.unpack_from(back_dt, raw)
                  }
                  Err(e) -> {
                    bad = e.kind
                  }
                }
              }
              release(hs)
              Trace {
                ..t1,
                launch: "ok",
                sync: kind(s),
                download: bad,
                result: if bad == "ok" { Some(all) } else { None },
                note: message(s)
              }
            }
          }
        }
      }
    }
  }

## Where the real device stopped, as `<kind>@<stage>`, or "" if it did not.
fn stopped(t: Trace) -> String =
  if t.alloc != "ok" {
    t.alloc ++ "@alloc"
  } else if t.upload != "ok" {
    t.upload ++ "@upload"
  } else if t.launch != "ok" {
    t.launch ++ "@launch"
  } else if t.sync != "ok" {
    t.sync ++ "@sync"
  } else if t.download != "ok" {
    t.download ++ "@download"
  } else {
    ""
  }

# ---- the tier ----

## Whether `got` is within the tolerance tier's distance of `want`, by
## leetgpu's own criterion. A NaN on either side is never within: two NaNs
## are not agreement, they are two failures.
pub fn within(got: Float, want: Float) -> Bool =
  if got != got || want != want {
    false
  } else if got == want {
    true
  } else if got - got != 0.0 || want - want != 0.0 {
    false
  } else {
    let d = if got > want { got - want } else { want - got }
    let m = if want > 0.0 { want } else { 0.0 - want }
    d <= ATOL + RTOL * m
  }

fn all_within(got: List[Float], want: List[Float]) -> Bool =
  len(got) == len(want) && list.all(range(0, len(want)), i => within(got[i], want[i]))

## The largest miss as the tolerance criterion measures it: 1.0 is exactly
## the tolerance, 0.0 is bit-identical.
fn scaled_miss(got: List[Float], want: List[Float]) -> Float =
  list.fold(range(0, len(want)), 0.0, (acc, i) => {
    let a = got[i]
    let b = want[i]
    let d = if a > b { a - b } else { b - a }
    let m = if b > 0.0 { b } else { 0.0 - b }
    let s = d / (ATOL + RTOL * m)
    if s > acc { s } else { acc }
  })

fn pair(real: Trace, fake: Trace) -> Option[(List[Float], List[Float])] =
  match (real.result, fake.result) {
    (Some(a), Some(b)) -> if len(a) == len(b) { Some((a, b)) } else { None }
    _ -> None
  }

fn miss_line(real: Trace, fake: Trace) -> String = match pair(real, fake) {
  Some((a, b)) -> "${scaled_miss(a, b)} (1.0 is exactly the tolerance atol=${ATOL} rtol=${RTOL})"
  None -> "-"
}

fn rendered(o: Option[List[Float]]) -> String = match o {
  Some(v) -> to_string(v)
  None -> "-"
}

## The verdict for one kernel under its tier: `identical:exact` (bit for
## bit), `close:tolerance`, `identical:tolerance` (a tolerance-tier kernel
## that happened to agree bit for bit as well), `differ:result`, or
## `blocked:..`.
fn verdict(tier: String, fake: Trace, real: Trace) -> String = {
  let stop = stopped(real)
  if stop != "" {
    "blocked:" ++ stop
  } else if rendered(real.result) == rendered(fake.result) {
    "identical:" ++ tier
  } else if tier == "exact" {
    "differ:result"
  } else {
    match pair(real, fake) {
      Some((a, b)) -> if all_within(a, b) { "close:tolerance" } else { "differ:result" }
      None -> "differ:result"
    }
  }
}

# ---- the corpus ----

fn sentinel_buffer(n: Int) -> List[Float] = list.map(range(0, n), _i => SENTINEL)

## Lanes that are an eighth plus a multiple of a quarter, both signs, no
## zero: every product by a power-of-two scale and every sum is exact.
fn corpus_x(n: Int) -> List[Float] =
  list.map(range(0, n), i => 0.25 * to_float(i % 23 - 11) + 0.125)

fn corpus_ints(n: Int) -> List[Float] = list.map(range(0, n), i => to_float(i * 1000003 - 50000))

fn f32_word(v: Float) -> LaunchArg = gpu.erase(gpu.scalar(narrow.f32(v)))

## A word for an f32 or i32 whose upper half is garbage: what the device must
## not read.
fn dirty(dtype: String, low: Int, high: Int) -> LaunchArg = Word(dtype, low + high * 0x100000000)

type Case = {
  kernel: String,
  tag: String,
  grid: Int,
  bufs: List[(String, List[Float])],
  spec: List[Spec],
  back: List[Int],
  refs: Map[String, (Int, WideRefFn)]
}

fn scale_case(tag: String, word: LaunchArg, s: Float) -> Case =
  Case {
    kernel: "scalar_scale",
    tag: tag,
    grid: 2,
    bufs: [("f64", corpus_x(256)), ("f64", sentinel_buffer(264))],
    spec: [B(0), W(word), B(1)],
    back: [1],
    refs: map.from([("scalar_scale", (2, last_out_with((_d, ins, _ss) => scalar_scale_ref(256, ins, [s]))))])
  }

fn len_case(tag: String, word: LaunchArg, n: Int) -> Case =
  Case {
    kernel: "scalar_len",
    tag: tag,
    grid: 2,
    bufs: [("f64", corpus_x(256)), ("f64", sentinel_buffer(264))],
    spec: [B(0), W(word), B(1)],
    back: [1],
    refs: map.from([("scalar_len", (2, last_out_with((_d, ins, _ss) => scalar_len_ref(ins, [to_float(n)]))))])
  }

fn loop_case(tag: String, word: LaunchArg, n: Int) -> Case =
  Case {
    kernel: "scalar_loop",
    tag: tag,
    grid: 1,
    bufs: [("f64", corpus_x(4 * SK_TILE)), ("f64", sentinel_buffer(SK_TILE + 8))],
    spec: [B(0), W(word), B(1)],
    back: [1],
    refs: map.from([("scalar_loop", (2, last_out_with((_d, ins, _ss) => scalar_loop_ref(SK_TILE, ins, [to_float(n)]))))])
  }

fn wide_case(tag: String, a: Float, k: Int) -> Case =
  Case {
    kernel: "scalar_wide",
    tag: tag,
    grid: 2,
    bufs: [("f64", corpus_x(128)), ("i64", corpus_ints(128)), ("f64", sentinel_buffer(136)),
      ("i64", sentinel_buffer(136))],
    spec: [B(0), B(1), W(gpu.erase(gpu.scalar(a))), W(gpu.erase(gpu.scalar(k))), B(2), B(3)],
    back: [2, 3],
    refs: map.from([("scalar_wide", (4, (_d, ins, _ss) => scalar_wide_ref(128, ins, [a, to_float(k)])))])
  }

## A trip count here is never 1 or 2: the `scalar-passed-as-handle` mutant
## reads a scalar's value as a buffer handle, a loop with that bound would
## run off the end of its input, and a device fault ends the process's
## context. (`scalar_len` takes a 2 and survives it: its worst case is a mask
## that lets every lane through.)
##
## Every case, in the order the transcript prints them. Each kernel's cubin
## is launched on more than one value; `garbage` cases are the high-half
## measurement and have a clean twin earlier in the list.
fn cases() -> List[Case] = [
  scale_case("s3", f32_word(3.0), 3.0),
  scale_case("s-quarter", f32_word(0.0 - 0.25), 0.0 - 0.25),
  scale_case("s3-garbage", dirty("f32", 0x40400000, 0xDEADBEEF), 3.0),
  len_case("n200", gpu.erase(gpu.scalar(i32_of(200))), 200),
  len_case("n5", gpu.erase(gpu.scalar(i32_of(5))), 5),
  len_case("n128", gpu.erase(gpu.scalar(i32_of(128))), 128),
  len_case("n2", gpu.erase(gpu.scalar(i32_of(2))), 2),
  len_case("n-1", gpu.erase(gpu.scalar(i32_of(0 - 1))), 0 - 1),
  len_case("n3-garbage", dirty("i32", 3, 0x7FFFFFFF), 3),
  len_case("n-1-garbage", dirty("i32", 0xFFFFFFFF, 0xFFFFFFFF), 0 - 1),
  loop_case("t3", gpu.erase(gpu.scalar(i32_of(3))), 3),
  loop_case("t4", gpu.erase(gpu.scalar(i32_of(4))), 4),
  loop_case("t0", gpu.erase(gpu.scalar(i32_of(0))), 0),
  loop_case("t2-garbage", dirty("i32", 2, 0xDEADBEEF), 2),
  wide_case("a-big", 0.0 - 25000000000.0, 1250999896491),
  wide_case("a-3", 3.0, 0 - 7)
]

fn i32_of(n: Int) -> I32 = i32.wrap(n)

## Whether a case is one of the garbage-high-half measurements.
fn is_garbage(c: Case) -> Bool = str.ends_with(c.tag, "garbage")

## Every case is exact tier; written out because scripts/leetgpu-diff/check.py
## reads this list in every program in this directory.
pub fn tolerance_tier() -> List[String] = []

## A vector as a line: its length, its first lanes and its last ones.
fn digest(v: List[Float]) -> String =
  if len(v) <= 8 {
    to_string(v)
  } else {
    "len=${len(v)} head=${to_string(list.take(v, 3))} tail=${to_string(list.drop(v, len(v) - 3))}"
  }

fn shown(o: Option[List[Float]]) -> String = match o {
  Some(v) -> digest(v)
  None -> "-"
}

fn read_cubin(path: String) -> Bytes !Exit !io = match with_fs_real(() => io.read_bytes(path)) {
  Ok(b) -> b
  Err(e) -> {
    io.eprintln("scalar_diff: cannot read ${path}: ${e.message}")
    io.exit(2)
    bytes_of_nothing()
  }
}

fn usage() -> Unit !Exit !io = {
  io.eprintln("usage: scalar_diff <scalar_scale.cubin> <scalar_len.cubin> <scalar_loop.cubin> <scalar_wide.cubin>")
  io.exit(2)
}

## The corpus's own measurements, counted. run.sh holds every one above zero,
## which is what makes the claims in the header measurements rather than
## sentences.
fn shape_of() -> String = {
  let cs = cases()
  let garbage = list.filter(cs, c => is_garbage(c))
  # lanes of the two mask cases the bound switched off
  let masked = 256 - 5
  let trips = list.map(list.filter(cs, c => c.kernel == "scalar_loop"), c => c.tag)
  "cases=${len(cs)} garbage=${len(garbage)} masked=${masked} loops=${len(trips)} kernels=4"
}

pub fn main() -> Unit !io = io.with_exit_real(() => {
  let paths = args()
  if len(paths) != 4 { usage() } else { () }
  let names = ["scalar_scale", "scalar_len", "scalar_loop", "scalar_wide"]
  var cubins: Map[String, Bytes] = map.empty()
  for i in range(0, 4) {
    cubins = map.insert(cubins, names[i], read_cubin(paths[i]))
  }
  var all_agreed = true
  var blocked = ""
  var any_differ = false
  var exact_count = 0
  var real_results: Map[String, String] = map.empty()
  for c in cases() {
    let fake = with_gpu_fake(c.refs, () => stages(c.kernel, c.grid, c.bufs, c.spec, c.back))
    let real = with_gpu_real(cubins, () => stages(c.kernel, c.grid, c.bufs, c.spec, c.back))
    let v = verdict("exact", fake, real)
    real_results = map.insert(real_results, c.tag, rendered(real.result))
    io.println("kernel ${c.kernel} ${c.tag} tier=exact grid=(${c.grid}, 1, 1)")
    if c.tag == "s3" { io.println("  index ${shape_of()}") } else { () }
    io.println("  fake  launch=${fake.launch} result=${shown(fake.result)}")
    io.println("  real  alloc=${real.alloc} upload=${real.upload} launch=${real.launch}"
        ++ " sync=${real.sync} download=${real.download} result=${shown(real.result)}")
    if real.note != "" { io.println("  note  ${real.note}") } else { () }
    io.println("  verdict ${v}")
    if v == "identical:exact" { exact_count = exact_count + 1 } else { all_agreed = false }
    if v == "differ:result" { any_differ = true } else { () }
    if blocked == "" && not any_differ && v != "identical:exact" { blocked = v } else { () }
  }
  let done = real_results
  let got = (t: String) => unwrap_or(map.get(done, t), "-")
  let same_bits = got("s3") == got("s3-garbage") && got("s3") != "-"
  let scales_differ = got("s3") != got("s-quarter")
  let lens_differ = got("n200") != got("n5") && got("n5") != got("n2")
  let trips_differ = got("t3") != got("t4") && got("t4") != got("t0")
  io.println("tiers exact=${exact_count} tolerance=0")
  io.println("probe scalars highbits=${if same_bits { "ignored" } else { "read" }}"
      ++ " scales=${if scales_differ { "distinct" } else { "same" }}"
      ++ " lens=${if lens_differ { "distinct" } else { "same" }}"
      ++ " trips=${if trips_differ { "distinct" } else { "same" }}")
  if all_agreed {
    io.println("tile-gpu-diff: pass")
  } else if any_differ {
    io.println("tile-gpu-diff: fail")
    io.exit(1)
  } else {
    io.println("tile-gpu-diff: ${blocked}")
  }
})

# `io.exit` is typed Unit, so the branch that cannot continue still owes a
# Bytes; this is never reached.
fn bytes_of_nothing() -> Bytes = panic("unreachable: exit did not exit")

# Layer 2 for the boundary kernels (knife 7a), the twin of vadd_diff.dawn:
# one `!Gpu` program runs each of the six kernels scripts/tile-golden pins
# under `with_gpu_real` against the machine's GPU and under `with_gpu_fake`
# against std/gpu's hand-written references, and prints what each device
# answered, so run.sh can say whether the two agree bit for bit.
#
#   mask_diff <vadd_tail.cubin> <copy.cubin> <relu.cubin> <leaky_relu.cubin>
#             <clip.cubin> <elemops.cubin>
#
# What layer 2 adds here that layers 0 and 1 cannot reach:
#
#   * the mask is honoured. Every buffer is allocated to the BLOCK boundary
#     (1024 lanes for a vector of 1000, 384 for one of 333) and the output
#     buffer is filled with a sentinel before the launch. The kernel's answer
#     is the first n lanes; the sentinel must still be in the rest. A kernel
#     whose mask were all-true would compute the tail lanes too and overwrite
#     the sentinel, which is run.sh's mask-all-true mutant and the one claim
#     no golden and no assembler can make.
#   * an opcode means what its name says. `elemops` is subf, mulf, divf,
#     negf, absf, maxf, minf, fma, the six comparisons and select over one
#     pair of tiles; tileiras would accept any of those opcodes in any of
#     those places, and only an answer tells them apart.
#
# Every operation here is IEEE-exact under rounding<nearest_even> (the four
# arithmetic operations, the sign flips, the two selections and the fused
# multiply-add over an exact product), so the comparison is bit for bit, on
# the rendered text of the whole vector, which tells -0.0 from 0.0. The
# corpora keep NaN out of every kernel that uses `maxf` or `minf`, and
# signed zeros out of those too: `maxf` without `propagate_nan` answers the
# other operand on a NaN and either zero on (-0.0, +0.0), and this release
# has pinned neither (std/gpu's relu_ref says so as well).
use std/io
use std/io.{Exit, with_fs_real}
use std/gpu
use std/gpu.{Gpu, F64, Tensor, with_gpu_fake, with_gpu_real, WideRefFn, last_out, masked_vadd_ref, masked_copy_ref, relu_ref,
  leaky_relu_ref, clip_ref, alloc, upload, download, free, launch, sync, handle_of }
use std/list
use std/map

## The sentinel every output buffer holds before a launch: a value no kernel
## here computes, so a lane that still has it is a lane nothing wrote.
pub const SENTINEL: Float = 0.0 - 12345.678

## The length and tile width of the five 128-wide kernels, and of the
## clipping kernel: the numbers scripts/tile-golden/kernels.dawn recorded
## them with. A kernel is one shape; these must agree with that file.
pub const TAIL_N: Int = 1000
pub const TAIL_TILE: Int = 128
pub const CLIP_N: Int = 333
pub const CLIP_TILE: Int = 64

## The alpha of the leaky kernel and the bounds of the clipping one, again
## as recorded.
pub const ALPHA: Float = 0.01
pub const CLIP_LO: Float = -1.0
pub const CLIP_HI: Float = 1.0

type Trace = {
  alloc: String,
  upload: String,
  roundtrip: String,
  launch: String,
  sync: String,
  download: String,
  result: Option[List[Float]],
  note: String
}

fn kind[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> "ok"
  Err(e) -> e.kind
}

fn message[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> ""
  Err(e) -> e.message
}

fn blank() -> Trace =
  Trace {
    alloc: "-",
    upload: "-",
    roundtrip: "-",
    launch: "-",
    sync: "-",
    download: "-",
    result: None,
    note: ""
  }

fn release(ts: List[Tensor[F64]]) -> Unit !Gpu = {
  for t in ts {
    let _ = free(t)
  }
}

# `count` buffers of `size` f64 elements, or the first refusal.
fn alloc_many(count: Int, size: Int, acc: List[Tensor[F64]]) -> Result[List[Tensor[F64]], ForeignError] !Gpu =
  if count == 0 {
    Ok(acc)
  } else {
    match alloc(F64, size) {
      Ok(t) -> alloc_many(count - 1, size, acc ++ [t])
      Err(e) -> Err(e)
    }
  }

# The contents of every buffer uploaded in order, or the first refusal.
fn upload_all(ts: List[Tensor[F64]], data: List[List[Float]], i: Int) -> Result[Unit, ForeignError] !Gpu =
  if i >= len(ts) {
    Ok(())
  } else {
    match upload(ts[i], data[i]) {
      Ok(_) -> upload_all(ts, data, i + 1)
      Err(e) -> Err(e)
    }
  }

## One kernel over `data` (the input buffers, then the output buffer's
## initial contents), one stage at a time, stopping at the first refusal and
## saying which stage it was. Every buffer is `len(data[0])` long, the block
## boundary above the kernel's own length; `grid` is the block count the
## kernel was recorded for.
fn stages(kernel: String, grid: Int, data: List[List[Float]]) -> Trace !Gpu = {
  let size = len(data[0])
  match alloc_many(len(data), size, []) {
    Err(e) -> Trace { ..blank(), alloc: e.kind, note: e.message }
    Ok(ts) -> {
      let t0 = Trace { ..blank(), alloc: "ok" }
      match upload_all(ts, data, 0) {
        Err(e) -> {
          release(ts)
          Trace { ..t0, upload: e.kind, note: e.message }
        }
        Ok(_) -> {
          let t1 = Trace { ..t0, upload: "ok" }
          let back = download(ts[0])
          let rt = match back {
            Ok(v) -> if to_string(v) == to_string(data[0]) { "same" } else { "differ" }
            Err(e) -> e.kind
          }
          let t2 = Trace { ..t1, roundtrip: rt, note: message(back) }
          match launch(kernel, grid, list.map(ts, handle_of)) {
            Err(e) -> {
              release(ts)
              Trace { ..t2, launch: e.kind, note: e.message }
            }
            Ok(_) -> {
              let s = sync()
              let r = download(ts[len(ts) - 1])
              release(ts)
              let value = match r {
                Ok(v) -> Some(v)
                Err(_) -> None
              }
              Trace {
                ..t2,
                launch: "ok",
                sync: kind(s),
                download: kind(r),
                result: value,
                note: message(s) ++ message(r)
              }
            }
          }
        }
      }
    }
  }
}

## A vector as a line: whole when short, otherwise its length, its ends and
## the lanes around the boundary, which is where a mask shows.
fn digest(v: List[Float], n: Int) -> String = {
  let k = len(v)
  if k <= 16 {
    to_string(v)
  } else {
    "len=${k} head=${to_string(list.take(v, 3))}"
      ++ " last_inside=${to_string(list.take(list.drop(v, n - 2), 2))}"
      ++ " tail=${to_string(list.drop(v, n))}"
  }
}

fn rendered(o: Option[List[Float]]) -> String = match o {
  Some(v) -> to_string(v)
  None -> "-"
}

fn shown(o: Option[List[Float]], n: Int) -> String = match o {
  Some(v) -> digest(v, n)
  None -> "-"
}

## Where the real device stopped, as `<kind>@<stage>`, or "" if it did not.
fn stopped(t: Trace) -> String =
  if t.alloc != "ok" {
    t.alloc ++ "@alloc"
  } else if t.upload != "ok" {
    t.upload ++ "@upload"
  } else if t.roundtrip != "same" && t.roundtrip != "differ" {
    t.roundtrip ++ "@download"
  } else if t.launch != "ok" {
    t.launch ++ "@launch"
  } else if t.sync != "ok" {
    t.sync ++ "@sync"
  } else if t.download != "ok" {
    t.download ++ "@download"
  } else {
    ""
  }

fn verdict(fake: Trace, real: Trace) -> String = {
  let stop = stopped(real)
  if real.roundtrip == "differ" {
    "differ:roundtrip"
  } else if stop != "" {
    "blocked:" ++ stop
  } else if rendered(real.result) == rendered(fake.result) {
    "identical"
  } else {
    "differ:result"
  }
}

# `-0.0`; the sign comes from a product.
fn neg_zero() -> Float = 0.0 * (0.0 - 1.0)

fn cdiv(a: Int, b: Int) -> Int = (a + b - 1) / b

# ---- the corpora ----
#
# Each is `padded` long: the kernel's own length rounded up to the block
# boundary. What the kernel writes is the first `n` lanes; the rest is the
# sentinel on the way in and must be the sentinel on the way out.

fn padded_of(n: Int, tile: Int) -> Int = cdiv(n, tile) * tile

fn sentinel_buffer(padded: Int) -> List[Float] = list.map(range(0, padded), _i => SENTINEL)

# Crossing zero, with the two zeros, a few large magnitudes and values whose
# sums are not short decimals. Sound for addition and copying; `maxf` and
# `minf` never see it.
fn signed_corpus(padded: Int, scale: Float) -> List[Float] =
  list.map(range(0, padded), i =>
      if i == 0 {
        0.0
      } else if i == 1 {
        neg_zero()
      } else if i == 2 {
        1.0e300
      } else if i == 3 {
        0.0 - 1.0e-300
      } else {
        (to_float(i % 977) - 400.0) * scale
      })

# Crossing zero without either zero and without NaN: what the kernels built
# on `maxf` and `minf` are held to.
fn ordered_corpus(padded: Int, scale: Float) -> List[Float] =
  list.map(range(0, padded), i => (to_float(i % 811) - 405.0) * scale)

# The second operand of `elemops`: equal to the first on every seventh lane
# (so `eq` and `ne` are exercised), below it on some and above it on others.
fn paired_corpus(padded: Int, first: List[Float]) -> List[Float] =
  list.map(range(0, padded), i =>
      if i % 7 == 0 { first[i] } else if i % 3 == 0 { first[i] - 1.5 } else { first[i] + 2.25 })

# The reference for `elemops`, hand-written here rather than in std/gpu: it
# is an oracle for the opcodes, not one of the problems. It mirrors the
# kernel operation for operation, and every step is exact (the product in the
# fused multiply-add is a doubling).
fn elemops_lane(a: Float, b: Float) -> Float = {
  let d = a - b
  let q = a * b / 2.0
  let v = if 0.0 - q < 0.0 { q } else { 0.0 - q }
  let f = a * 2.0 + b
  let lo = if a < b { a } else { b }
  let hi = if a > b { a } else { b }
  let s1 = if a < b { d } else { v }
  let s2 = if a >= b { s1 } else { f }
  let s3 = if a == b { lo } else { s2 }
  let s4 = if a != b { s3 } else { hi }
  let s5 = if a > b { s4 } else { d }
  if a <= b { s5 } else { v }
}

fn elemops_ref(n: Int, _dtypes: List[String], ins: List[List[Float]]) -> List[Float] = {
  let a = ins[0]
  let b = ins[1]
  let old = ins[2]
  list.map(range(0, len(old)), i => if i < n { elemops_lane(a[i], b[i]) } else { old[i] })
}

fn kernels_map() -> Map[String, (Int, WideRefFn)] =
  map.from([
    ("vadd_tail", (3, last_out((dts, ins) => masked_vadd_ref(TAIL_N, dts, ins)))),
    ("copy", (2, last_out((dts, ins) => masked_copy_ref(TAIL_N, dts, ins)))),
    ("relu", (2, last_out((dts, ins) => relu_ref(TAIL_N, dts, ins)))),
    ("leaky_relu", (2, last_out((dts, ins) => leaky_relu_ref(TAIL_N, ALPHA, dts, ins)))),
    ("elemops", (3, last_out((dts, ins) => elemops_ref(TAIL_N, dts, ins))))
  ])

# The clipping kernel is the only one of a different length, so its reference
# is bound to its own; `kernels_map` above is the 1000-lane family and this
# is the map the clipping case runs under.
fn clip_kernels_map() -> Map[String, (Int, WideRefFn)] =
  map.from([("clip", (2, last_out((dts, ins) => clip_ref(CLIP_N, CLIP_LO, CLIP_HI, dts, ins))))])

## The kernels this program runs, in the order their cubins are given: the
## name, the vector's length, the tile width and the buffers to hand it.
fn case_name(i: Int) -> String = ["vadd_tail", "copy", "relu", "leaky_relu", "clip", "elemops"][i]

fn case_n(i: Int) -> Int = if case_name(i) == "clip" { CLIP_N } else { TAIL_N }

fn case_tile(i: Int) -> Int = if case_name(i) == "clip" { CLIP_TILE } else { TAIL_TILE }

fn case_data(i: Int) -> List[List[Float]] = {
  let padded = padded_of(case_n(i), case_tile(i))
  let out = sentinel_buffer(padded)
  let name = case_name(i)
  if name == "vadd_tail" {
    let a = signed_corpus(padded, 0.125)
    [a, list.map(range(0, padded), k => 1000003.0 * to_float(k) / 7.0), out]
  } else if name == "copy" {
    [signed_corpus(padded, 0.5), out]
  } else if name == "relu" {
    [ordered_corpus(padded, 0.25), out]
  } else if name == "leaky_relu" {
    [signed_corpus(padded, 0.25), out]
  } else if name == "clip" {
    [ordered_corpus(padded, 0.01), out]
  } else {
    let a = ordered_corpus(padded, 0.125)
    [a, paired_corpus(padded, a), out]
  }
}

fn read_cubin(path: String) -> Bytes !Exit !io = match with_fs_real(() => io.read_bytes(path)) {
  Ok(b) -> b
  Err(e) -> {
    io.eprintln("mask_diff: cannot read ${path}: ${e.message}")
    io.exit(2)
    bytes_of_nothing()
  }
}

# `io.exit` needs a handler above it now, and this program is the only
# frame with nothing above it. `Fs` stays where it was, installed per read.
pub fn main() -> Unit !io = io.with_exit_real(() => {
    let argv = args()
    if len(argv) != 6 {
      io.eprintln("usage: mask_diff <vadd_tail.cubin> <copy.cubin> <relu.cubin> <leaky_relu.cubin>"
          ++ " <clip.cubin> <elemops.cubin>")
      io.exit(2)
    }
    var cubins: Map[String, Bytes] = map.empty()
    for i in range(0, 6) {
      cubins = map.insert(cubins, case_name(i), read_cubin(argv[i]))
    }
    var all_identical = true
    var blocked = ""
    var any_differ = false
    for i in range(0, 6) {
      let name = case_name(i)
      let n = case_n(i)
      let data = case_data(i)
      let grid = cdiv(n, case_tile(i))
      let refs = if name == "clip" { clip_kernels_map() } else { kernels_map() }
      let fake = with_gpu_fake(refs, () => stages(name, grid, data))
      let real = with_gpu_real(cubins, () => stages(name, grid, data))
      let v = verdict(fake, real)
      io.println("kernel ${name} n=${n} tile=${case_tile(i)} padded=${len(data[0])} grid=${grid}")
      io.println("  fake  launch=${fake.launch} result=${shown(fake.result, n)}")
      io.println("  real  alloc=${real.alloc} upload=${real.upload} roundtrip=${real.roundtrip}"
          ++ " launch=${real.launch} sync=${real.sync} download=${real.download}"
          ++ " result=${shown(real.result, n)}")
      if real.note != "" { io.println("  note  ${real.note}") }
      io.println("  verdict ${v}")
      if v != "identical" { all_identical = false }
      if v == "differ:roundtrip" || v == "differ:result" { any_differ = true }
      if blocked == "" && v != "identical" && not any_differ { blocked = v }
    }
    if all_identical {
      io.println("tile-gpu-diff: pass")
    } else if any_differ {
      io.println("tile-gpu-diff: fail")
      io.exit(1)
    } else {
      io.println("tile-gpu-diff: ${blocked}")
    }
})

# `io.exit` is typed Unit, so the branch that cannot continue still owes a
# Bytes; this is never reached.
fn bytes_of_nothing() -> Bytes = panic("unreachable: exit did not exit")

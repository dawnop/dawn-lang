# expect: a trailing closure must use a tail block
# A bare arrow lambda cannot take the trailing-closure position: `g(xs) (x)` is
# already the curried call `g(xs)(x)`, and nothing distinguishes the two
# readings until the `=>` (spec §4.5). Use `g(xs) { x => x }` instead.
fn f(xs: List[Int]) -> Unit = g(xs) (x) => x

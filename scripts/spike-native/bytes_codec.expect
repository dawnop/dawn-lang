lone char    = none
wrong pads   = none
pad only     = none
after pad    = none
stray bits   = none
other set    = none
space        = none
-- from_base64_url --
unpadded     = [ff]
padded too   = [ff]
other set    = none
round trip   = true
round trip u = true

## String operations, over code points: trimming, case, search, slicing,
## splitting and padding (spec §11).
#
# Short names, module-qualified at the call site: `use std/str`, then
# `str.len(s)` / `str.trim(s)`; hot names can be pulled in selectively
# (`use std/str.{trim}`).
#
# Ordinary Dawn source, bundled into the compiler jar as a resource, checked
# before user code, and with its `pub` surface implicitly visible in every
# module — no `use` needed (spec §10.6). This is the landing place for functions
# moving out of the compiler's builtin table (docs/builtins-to-stdlib.md).
#
# Two implementation styles live here, on purpose (docs/pure-ffi-design.md §九):
#   - plain Dawn over the cursor walk, which is nearly everything;
#   - a str_* intrinsic, only where the answer is a Unicode table rather than a
#     walk: case folding, and `char_is_*` underneath `trim`.
#
# Length, trimming, and all four searches used to be intrinsics too. Each had a
# hand-written implementation in the JVM emitter and another in the C runtime,
# and they disagreed with nothing to say so; the comptime interpreter had no
# copy at all and reflected into the emitted JVM class, which is a route a
# native compiler does not have (docs/native-backend-plan.md 14.12). They are
# walks, not representation, so they are written here once and every consumer
# reads that one definition.
#
# Nothing here names a JVM class; the backend owns the seven cursor primitives
# and the two case foldings in dawn/rt/Strings (docs/runtime-intrinsics-design.md).

use std/cursor
use std/cursor.{Cursor}

## Number of Unicode code points in `s` (not UTF-16 units, and not `chars`' list length).
pub fn len(s: String) -> Int = count(s, cursor.start(s), 0)

fn count(s: String, c: Cursor, n: Int) -> Int =
  if cursor.done(s, c) { n } else { count(s, cursor.next(s, c), n + 1) }

## True when the string has no characters.
pub fn is_empty(s: String) -> Bool = cursor.done(s, cursor.start(s))

## `s` without leading or trailing whitespace.
pub fn trim(s: String) -> String = {
  let a = skip_space(s, cursor.start(s))
  cursor.slice(s, a, last_kept(s, a, a))
}

## `s` without leading whitespace.
pub fn trim_start(s: String) -> String =
  cursor.slice(s, skip_space(s, cursor.start(s)), cursor.end(s))

## `s` without trailing whitespace.
pub fn trim_end(s: String) -> String = {
  let a = cursor.start(s)
  cursor.slice(s, a, last_kept(s, a, a))
}

fn skip_space(s: String, c: Cursor) -> Cursor =
  if cursor.done(s, c) || not char_is_space(char_unchecked(cursor.char(s, c))) {
    c
  } else {
    skip_space(s, cursor.next(s, c))
  }

## The position just past the last non-space at or after `c`. Walking forward
## and remembering, rather than walking back from the end, so no two positions
## ever have to be compared.
fn last_kept(s: String, c: Cursor, best: Cursor) -> Cursor =
  if cursor.done(s, c) {
    best
  } else {
    let n = cursor.next(s, c)
    last_kept(s, n, if char_is_space(char_unchecked(cursor.char(s, c))) { best } else { n })
  }

## `s` lowercased by simple (1:1) Unicode mapping: one code point in, one out,
## no locale and no context, so the code-point count is unchanged.
pub fn to_lower(s: String) -> String = str_lower(s)

## `s` uppercased by simple (1:1) Unicode mapping. Not the length-changing full
## mapping -- `ß` stays `ß` rather than becoming `SS`, because full mapping is
## locale- and context-sensitive and so is not a function a second backend can
## implement from a table (spec 11). That belongs in a library taking a locale.
pub fn to_upper(s: String) -> String = str_upper(s)

## Whether `sub` occurs anywhere in `s`.
pub fn contains(s: String, sub: String) -> Bool =
  match cursor.find(s, sub, cursor.start(s)) {
    Some(_) -> true
    None -> false
  }

## Whether `s` begins with `prefix`.
pub fn starts_with(s: String, prefix: String) -> Bool =
  cursor.starts_at(s, cursor.start(s), prefix)

## Whether `s` ends with `suffix`.
pub fn ends_with(s: String, suffix: String) -> Bool = {
  let n = len(suffix)
  if n > len(s) {
    false
  } else {
    cursor.starts_at(s, cursor.back(s, cursor.end(s), n), suffix)
  }
}

## `s` with `prefix` removed, or `None` when `s` does not begin with it.
##
## Inquiry (spec §4.8, criterion 2): "no such prefix" is a branch the caller
## takes, not a bug. Testing and peeling in one call is the point -- the pair
## `starts_with` plus a hand-computed `slice(s, 16, len(s))` is what put
## magic offsets in 33 call sites, and an offset that is one out still compiles.
## No arithmetic happens here either: `cursor.skip` walks past the prefix.
pub fn strip_prefix(s: String, prefix: String) -> Option[String] =
  if starts_with(s, prefix) {
    Some(cursor.slice(s, cursor.skip(s, cursor.start(s), prefix), cursor.end(s)))
  } else {
    None
  }

## `s` with `suffix` removed, or `None` when `s` does not end with it.
## The mirror of `strip_prefix`, and the answer to `- 5` meaning `len(".dawn")`.
pub fn strip_suffix(s: String, suffix: String) -> Option[String] =
  if ends_with(s, suffix) {
    Some(cursor.slice(s, cursor.start(s), cursor.back(s, cursor.end(s), len(suffix))))
  } else {
    None
  }

## Where the first occurrence of `sub` begins, in code points, or `None`.
##
## The answer is a *position* in `[0, len]`, not the index of an element: an
## empty `sub` occurs at position 0 of the empty string, and `len(s)` is a
## legal answer here (see `last_index_of`) though no character lives there.
## "Index" in the name is the unit it counts in -- code points, not UTF-16
## units and not bytes -- and `cursor.find` is the one that answers with a
## position you can slice at directly.
pub fn index_of(s: String, sub: String) -> Option[Int] = idx(s, sub, cursor.start(s), 0)

fn idx(s: String, sub: String, c: Cursor, i: Int) -> Option[Int] =
  if cursor.starts_at(s, c, sub) {
    Some(i)
  } else if cursor.done(s, c) {
    None
  } else {
    idx(s, sub, cursor.next(s, c), i + 1)
  }

## Where the last occurrence of `sub` begins, in code points, or `None`. A
## position in `[0, len]`: an empty `sub` is found at the end, which is
## `len(s)` -- past the last character, which is why the answer is a position
## and not an element index.
pub fn last_index_of(s: String, sub: String) -> Option[Int] =
  last_idx(s, sub, cursor.start(s), 0, None)

fn last_idx(s: String, sub: String, c: Cursor, i: Int, best: Option[Int]) -> Option[Int] = {
  let seen = if cursor.starts_at(s, c, sub) { Some(i) } else { best }
  if cursor.done(s, c) { seen } else { last_idx(s, sub, cursor.next(s, c), i + 1, seen) }
}

## The one-character string for `c`. This is how a `Char` becomes text:
## `"${c}"` renders the code point as a number, because an opaque type shows
## the way its target does (spec §2.7).
pub fn from_char(c: Char) -> String = from_code_points([c])

## `s` repeated `n` times; n <= 0 yields the empty string.
##
## Doubling: O(len(s) * n) on both backends, and stack-safe at any `n`. Why the
## two obvious shapes are not, in `docs/stdlib-impl-notes.md`.
pub fn repeat(s: String, n: Int) -> String = {
  var out = ""
  var chunk = s
  var k = n
  while k > 0 {
    if k % 2 == 1 { out = out ++ chunk }
    k = k / 2
    if k > 0 { chunk = chunk ++ chunk }
  }
  out
}

# The code-point helpers below recurse over `code_points(s)` with an explicit
# index because `len` here is str.len (String → code points) and so shadows the
# builtin list length; `str.len(s)` doubles as the code-point count of that list.

## The code points of `s` in `[from, to)`. Both ends are clamped into range
## (a negative index reads as 0, one past the end as `len`) and `from > to`
## yields the empty string, so this never panics — a range parameter selects
## a stretch, it does not assert its endpoints exist (spec §4.8).
##
## Spelled `substring` until v0.54.0; rationale in `docs/stdlib-naming.md`.
pub fn slice(s: String, from: Int, to: Int) -> String = {
  let n = len(s)
  let f = clamp_cp(from, n)
  let t = clamp_cp(to, n)
  if f >= t {
    ""
  } else {
    let acc: List[Char] = []
    from_code_points(slice_cps(code_points(s), f, t, acc))
  }
}

fn clamp_cp(i: Int, n: Int) -> Int = if i < 0 { 0 } else if i > n { n } else { i }

## The first `n` characters, or all of them when there are fewer. `n` is
## clamped into `[0, len]`, so this never panics: it names a stretch rather
## than asserting that position `n` exists (spec §4.8, criterion 3), the same
## way `slice` and `list.take` do.
##
## `truncate` would be this function under another name, so there is no
## `truncate`.
pub fn take(s: String, n: Int) -> String = slice(s, 0, n)

## Everything after the first `n` characters; `n` is clamped into `[0, len]`,
## so this never panics. This is the "the rest of it" that 50 call sites spell
## `slice(x, i, str.len(x))`.
pub fn drop(s: String, n: Int) -> String = slice(s, n, len(s))

## The character at `i`. Panics when `i` is out of range -- `i` is a position
## the caller says exists, exactly like `xs[i]` and `bytes.at`
## (spec §4.8, criterion 1); `get`-style inquiry about a character is
## `cursor.char` on a position you already hold.
##
## A `Char`, not a one-character string: it is the currency `code_points` and
## `from_char` trade in, and `chars` is the function that answers with strings.
## `cursor.char` stays an `Int` one layer down, because it answers `-1` past
## the end and a sentinel cannot live in a type whose every value is a
## character (spec §4.8).
pub fn at(s: String, i: Int) -> Char = {
  let c = cursor.seek(s, i)
  if i < 0 || cursor.done(s, c) {
    panic("str.at: index out of range")
  } else {
    char_unchecked(cursor.char(s, c))
  }
}

fn slice_cps(cps: List[Char], i: Int, to: Int, acc: List[Char]) -> List[Char] =
  if i >= to { acc } else { slice_cps(cps, i + 1, to, acc ++ [get(cps, i).expect("in range")]) }

## `s` left-padded with `pad` until it is `width` code points wide. Returns `s`
## unchanged when it is already wide enough or `pad` is empty; the filler is
## truncated to land exactly on width.
pub fn pad_start(s: String, width: Int, pad: String) -> String = {
  let have = len(s)
  if have >= width || pad == "" {
    s
  } else {
    let acc: List[Char] = []
    from_code_points(pad_fill(code_points(pad), len(pad), width - have, 0, acc)) ++ s
  }
}

fn pad_fill(pad: List[Char], plen: Int, need: Int, i: Int, acc: List[Char]) -> List[Char] =
  if i >= need { acc }
  else { pad_fill(pad, plen, need, i + 1, acc ++ [get(pad, i % plen).expect("cycle in range")]) }

## `s` right-padded with `pad` until it is `width` code points wide. The mirror
## of `pad_start`, with the same clauses: `s` comes back unchanged when it is
## already wide enough or `pad` is empty, and the filler is truncated to land
## exactly on width.
pub fn pad_end(s: String, width: Int, pad: String) -> String = {
  let have = len(s)
  if have >= width || pad == "" {
    s
  } else {
    let acc: List[Char] = []
    s ++ from_code_points(pad_fill(code_points(pad), len(pad), width - have, 0, acc))
  }
}

## `s` with its code points in reverse order (surrogate pairs stay intact).
pub fn reverse(s: String) -> String = {
  let acc: List[Char] = []
  from_code_points(rev_cps(code_points(s), len(s) - 1, acc))
}

fn rev_cps(cps: List[Char], i: Int, acc: List[Char]) -> List[Char] =
  if i < 0 { acc } else { rev_cps(cps, i - 1, acc ++ [get(cps, i).expect("in range")]) }

# ---- cursors ----
#
# Positions come from std/cursor, whose `Cursor` is opaque: only that module
# may see one as the Int it is, so the raw `cursor_*` builtins have exactly
# one caller in the whole ecosystem. chars/split below thread positions
# without ever computing one, which is the guarantee the type carries.

## The characters of `s`, each as a one-character string.
## A surrogate pair stays one element — this splits by character, not by unit.
pub fn chars(s: String) -> List[String] = {
  let empty: List[String] = []
  chars_go(s, cursor.start(s), empty)
}

fn chars_go(s: String, c: Cursor, acc: List[String]) -> List[String] =
  if cursor.done(s, c) {
    acc
  } else {
    let n = cursor.next(s, c)
    chars_go(s, n, acc ++ [cursor.slice(s, c, n)])
  }

## `s` cut at each occurrence of `sep`, left to right. Adjacent separators yield
## empty pieces, and the result always has one more piece than there were
## separators. An empty `sep` yields the characters, as `chars` does.
pub fn split(s: String, sep: String) -> List[String] =
  if sep == "" {
    chars(s)
  } else {
    let empty: List[String] = []
    split_go(s, sep, cursor.start(s), empty)
  }

fn split_go(s: String, sep: String, at: Cursor, acc: List[String]) -> List[String] =
  match cursor.find(s, sep, at) {
    None -> acc ++ [cursor.slice(s, at, cursor.end(s))]
    # cursor.skip is the one sanctioned "advance past a known occurrence"
    Some(i) -> split_go(s, sep, cursor.skip(s, i, sep), acc ++ [cursor.slice(s, at, i)])
  }

## `s` cut in two at the *first* occurrence of `sep`: what came before it and
## what came after, or `None` when `sep` does not occur.
##
## Inquiry (spec §4.8, criterion 2), the same shape as `strip_prefix`: "no
## separator" is a branch the caller takes. `split` answers a different
## question -- it has no way to say "there was no separator", because one piece
## is also what a string with no separator yields, and the two are different
## answers to `key=value` parsing.
##
## Testing and cutting in one call is the point. The pair
## `index_of` plus two `slice` calls is three passes and two chances to be one
## out; this is one pass and no arithmetic. An empty `sep` occurs at the start,
## so it answers `("", s)`.
pub fn split_once(s: String, sep: String) -> Option[(String, String)] =
  match cursor.find(s, sep, cursor.start(s)) {
    None -> None
    Some(c) -> Some(cut_at(s, c, sep))
  }

## `s` cut in two at the *last* occurrence of `sep`. The mirror of
## `split_once`, and the one to reach for when the separator also occurs inside
## the left part: `rsplit_once("a/b/c.d", "/")` is `("a/b", "c.d")`.
pub fn rsplit_once(s: String, sep: String) -> Option[(String, String)] =
  match last_at(s, sep, cursor.start(s), None) {
    None -> None
    Some(c) -> Some(cut_at(s, c, sep))
  }

## The two sides of an occurrence of `sep` known to start at `c`. `cursor.skip`
## walks past it, so neither side is computed by subtracting a length.
fn cut_at(s: String, c: Cursor, sep: String) -> (String, String) =
  (cursor.slice(s, cursor.start(s), c),
    cursor.slice(s, cursor.skip(s, c, sep), cursor.end(s)))

## Where the last occurrence of `sep` begins. Walks forward remembering, the
## way `last_idx` does, rather than walking back from the end -- a backward
## search would have to compare two positions to know when to stop.
fn last_at(s: String, sep: String, c: Cursor, best: Option[Cursor]) -> Option[Cursor] = {
  let b2 = if cursor.starts_at(s, c, sep) { Some(c) } else { best }
  if cursor.done(s, c) { b2 } else { last_at(s, sep, cursor.next(s, c), b2) }
}

## `s` with every occurrence of `from` replaced by `to`, left to right and
## non-overlapping. An empty `from` splices `to` between the characters, the
## same way `split` with an empty separator yields them.
pub fn replace(s: String, from: String, to: String) -> String =
  join(split(s, from), to)

# ---- iteration (prelude Iter, #44 knife 2) ----

## `for ch in s` walks the string by code point; each element is a
## one-character String, the same shape `chars` hands out, without
## materialising the list. The cursor is `Cursor`, so a position mid-walk is
## as impossible to conjure from arithmetic here as anywhere else.
impl Iter[String] {
  type Cur = Cursor
  type Item = String

  fn iter_start(s: String) -> Cursor = cursor.start(s)
  fn iter_done(s: String, c: Cursor) -> Bool = cursor.done(s, c)
  fn iter_next(s: String, c: Cursor) -> Cursor = cursor.next(s, c)
  fn iter_get(s: String, c: Cursor) -> String = cursor.slice(s, c, cursor.next(s, c))
}

# ---- tests ----
#
# Behaviour, not implementation: every assertion below is a promise one of the
# doc comments above makes, and the ones about code points are made twice --
# once with a BMP character and once with an astral one. `中` is a single
# UTF-16 unit, so a walk written in units agrees with a walk written in code
# points about it and the test says nothing; `😀` (U+1F600) is a surrogate
# pair, and it is the character that tells the two apart.

test "len and is_empty count code points, not UTF-16 units" {
  assert len("") == 0
  assert is_empty("")
  assert not is_empty(" ")
  assert len("abc") == 3
  assert len("中文字") == 3
  assert len("😀") == 1
  assert len("a中😀z") == 4
}

test "the affix predicates ask about the ends, and the empty affix is at both" {
  assert starts_with("abcdef", "abc")
  assert starts_with("abc", "abc")
  assert starts_with("abc", "")
  assert not starts_with("abcdef", "bcd")
  assert not starts_with("ab", "abc")
  assert ends_with("abcdef", "def")
  assert ends_with("abc", "abc")
  assert ends_with("abc", "")
  assert not ends_with("abcdef", "cde")
  assert not ends_with("ab", "abc")
  assert starts_with("", "")
  assert ends_with("", "")
  assert not starts_with("", "a")
  assert not ends_with("", "a")
  # the walk back is by character, not by unit: half a surrogate pair is not
  # a suffix of anything
  assert ends_with("a😀", "😀")
  assert not ends_with("a😀", "a")
  assert starts_with("😀a", "😀")
}

test "strip_prefix and strip_suffix peel, or answer None" {
  assert strip_prefix("dawn.lang", "dawn.").unwrap_or("!") == "lang"
  assert strip_prefix("abc", "").unwrap_or("!") == "abc"
  assert strip_prefix("abc", "abc").unwrap_or("!") == ""
  assert strip_prefix("dawn.lang", "lang") == None
  assert strip_prefix("ab", "abc") == None
  assert strip_suffix("main.dawn", ".dawn").unwrap_or("!") == "main"
  assert strip_suffix("abc", "").unwrap_or("!") == "abc"
  assert strip_suffix("abc", "abc").unwrap_or("!") == ""
  assert strip_suffix("main.dawn", ".x") == None
  assert strip_suffix("ab", "abc") == None
  assert strip_prefix("😀ok", "😀").unwrap_or("!") == "ok"
  assert strip_suffix("ok😀", "😀").unwrap_or("!") == "ok"
}

test "index_of and last_index_of answer in code points, and find the empty string" {
  assert index_of("abcabc", "b").unwrap_or(0 - 1) == 1
  assert last_index_of("abcabc", "b").unwrap_or(0 - 1) == 4
  assert index_of("abc", "abc").unwrap_or(0 - 1) == 0
  assert index_of("abc", "z") == None
  assert last_index_of("abc", "z") == None
  # an empty needle is at the start, and last is at the end -- which is len,
  # a position no character occupies
  assert index_of("abc", "").unwrap_or(0 - 1) == 0
  assert last_index_of("abc", "").unwrap_or(0 - 1) == 3
  assert index_of("", "").unwrap_or(0 - 1) == 0
  assert index_of("", "a") == None
  # a code-point index, so the astral character before the needle counts once
  assert index_of("😀x", "x").unwrap_or(0 - 1) == 1
  assert last_index_of("x😀x", "x").unwrap_or(0 - 1) == 2
  assert contains("abcdef", "cd")
  assert contains("abc", "")
  assert not contains("abc", "cb")
}

test "split yields one more piece than there were separators" {
  assert join(split("a,b,c", ","), "|") == "a|b|c"
  # a separator that is not there leaves one piece, which is the whole string
  assert join(split("abc", ","), "|") == "abc"
  # adjacent, leading and trailing separators each yield an empty piece
  assert join(split("a,,b", ","), "|") == "a||b"
  assert join(split(",a,", ","), "|") == "|a|"
  assert join(split(",", ","), "|") == "|"
  assert join(split("", ","), "|") == ""
  # a multi-character separator matches as a whole, and overlapping runs of it
  # are consumed left to right without backtracking
  assert join(split("a--b---c", "--"), "|") == "a|b|-c"
  # the empty separator is `chars`
  assert join(split("a中😀", ""), "|") == "a|中|😀"
  assert join(split("", ""), "|") == ""
}

test "split_once and rsplit_once cut in two, or answer None" {
  assert split_once("k=v", "=") == Some(("k", "v"))
  assert split_once("k=v=w", "=") == Some(("k", "v=w"))
  assert rsplit_once("k=v=w", "=") == Some(("k=v", "w"))
  # "there was no separator" is an answer `split` cannot give: it and
  # `split_once("a=", "=")` would both be one-piece results
  assert split_once("abc", "=") == None
  assert rsplit_once("abc", "=") == None
  assert split_once("=v", "=") == Some(("", "v"))
  assert split_once("k=", "=") == Some(("k", ""))
  assert split_once("=", "=") == Some(("", ""))
  # a multi-character separator is consumed whole, and the empty one is at the
  # start (`cursor.find` finds it there), so it cuts before the first character
  assert split_once("a--b--c", "--") == Some(("a", "b--c"))
  assert rsplit_once("a--b--c", "--") == Some(("a--b", "c"))
  assert split_once("abc", "") == Some(("", "abc"))
  assert rsplit_once("abc", "") == Some(("abc", ""))
  assert split_once("", "") == Some(("", ""))
  assert split_once("", "a") == None
  # the halves are cut by character: an astral separator is not split, and
  # neither is an astral character next to one
  assert split_once("a😀b", "😀") == Some(("a", "b"))
  assert split_once("😀=😀", "=") == Some(("😀", "😀"))
}

test "replace is split then join, and an empty needle splices between characters" {
  assert replace("a,b,c", ",", ";") == "a;b;c"
  assert replace("aaa", "a", "bb") == "bbbbbb"
  assert replace("abc", "z", "!") == "abc"
  assert replace("a,b", ",", "") == "ab"
  assert replace("", "a", "b") == ""
  # non-overlapping, left to right: the second `aa` starts after the first ends
  assert replace("aaaa", "aa", "x") == "xx"
  assert replace("aaa", "aa", "x") == "xa"
  assert replace("ab", "", "-") == "a-b"
}

test "slice, take and drop clamp their ends instead of panicking" {
  assert slice("abcdef", 1, 4) == "bcd"
  assert slice("abcdef", 0, 6) == "abcdef"
  assert slice("abcdef", 4, 1) == ""
  assert slice("abcdef", 3, 3) == ""
  assert slice("abcdef", 0 - 5, 2) == "ab"
  assert slice("abcdef", 4, 99) == "ef"
  assert slice("abcdef", 99, 200) == ""
  assert slice("", 0, 5) == ""
  assert take("abcdef", 2) == "ab"
  assert take("abcdef", 0) == ""
  assert take("abcdef", 99) == "abcdef"
  assert take("abcdef", 0 - 1) == ""
  assert drop("abcdef", 2) == "cdef"
  assert drop("abcdef", 0) == "abcdef"
  assert drop("abcdef", 99) == ""
  assert drop("abcdef", 0 - 1) == "abcdef"
  # the cut is between characters: an astral one is never halved
  assert take("a😀z", 2) == "a😀"
  assert drop("a😀z", 1) == "😀z"
  assert slice("a😀z", 1, 2) == "😀"
}

test "at asserts the index exists -- it is the one that panics" {
  assert at("abc", 0) == 'a'
  assert at("abc", 2) == 'c'
  assert at("😀", 0) == '😀'
  assert at("a😀z", 2) == 'z'
  # spec 4.8 criterion 1: `i` is a position the caller says exists, so a miss
  # is a broken invariant and not a branch. `slice`/`take`/`drop` above are
  # criterion 3 and clamp; this one does not, and that difference is the pin.
  match catch_panic(() => at("abc", 3)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  match catch_panic(() => at("abc", 0 - 1)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  match catch_panic(() => at("", 0)) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
}

test "pad_start and pad_end land exactly on width, or hand the string back" {
  assert pad_start("7", 3, "0") == "007"
  assert pad_end("7", 3, "0") == "700"
  # already wide enough, and wider than asked: unchanged, never truncated
  assert pad_start("abcd", 4, "0") == "abcd"
  assert pad_start("abcd", 2, "0") == "abcd"
  assert pad_end("abcd", 2, "0") == "abcd"
  # an empty filler cannot reach the width, so it hands the string back
  assert pad_start("ab", 8, "") == "ab"
  assert pad_end("ab", 8, "") == "ab"
  assert pad_start("", 3, "x") == "xxx"
  # a multi-character filler cycles and is cut mid-cycle to hit the width
  assert pad_start("x", 6, "ab") == "ababax"
  assert pad_end("x", 6, "ab") == "xababa"
  assert pad_start("x", 4, "ab") == "abax"
  # width is in code points, so an astral filler counts one per character
  assert pad_start("x", 3, "😀") == "😀😀x"
  assert len(pad_start("x", 3, "😀")) == 3
}

test "trim removes whitespace at the ends and nothing in the middle" {
  assert trim("  ab  ") == "ab"
  assert trim_start("  ab  ") == "ab  "
  assert trim_end("  ab  ") == "  ab"
  assert trim("ab") == "ab"
  assert trim("") == ""
  assert trim("   ") == ""
  assert trim_start("   ") == ""
  assert trim_end("   ") == ""
  assert trim(" a b ") == "a b"
  assert trim("\t\n ab \r\n") == "ab"
  # not whitespace: an astral character at either end survives
  assert trim(" 😀 ") == "😀"
}

test "case mapping is simple and 1:1 -- the code-point count never moves" {
  assert to_lower("ABC") == "abc"
  assert to_upper("abc") == "ABC"
  assert to_lower("AbC1!") == "abc1!"
  assert to_upper("") == ""
  # the documented refusal: full mapping would make this "SS", and full
  # mapping is locale- and context-sensitive, so it is not this function
  assert to_upper("ß") == "ß"
  assert len(to_upper("ß")) == 1
  # a script without case passes through
  assert to_upper("中文") == "中文"
  assert to_lower("中文") == "中文"
  assert to_upper("😀") == "😀"
}

test "chars, reverse and repeat keep a surrogate pair whole" {
  assert join(chars("abc"), "|") == "a|b|c"
  assert join(chars(""), "|") == ""
  assert join(chars("a中😀"), "|") == "a|中|😀"
  assert reverse("abc") == "cba"
  assert reverse("") == ""
  assert reverse("a") == "a"
  # reversed by character: the pair moves as one, and is still one character
  assert len(reverse("a😀z")) == 3
  assert reverse("a😀z") == "z😀a"
  assert repeat("ab", 3) == "ababab"
  assert repeat("ab", 2) == "abab"
  assert repeat("ab", 1) == "ab"
  assert repeat("ab", 0) == ""
  assert repeat("ab", 0 - 2) == ""
  assert repeat("", 5) == ""
  # the odd/even split of the doubling loop, at every arity a carry can reach
  assert repeat("x", 5) == "xxxxx"
  assert repeat("x", 6) == "xxxxxx"
  assert repeat("x", 7) == "xxxxxxx"
  assert repeat("x", 8) == "xxxxxxxx"
  assert repeat("😀", 3) == "😀😀😀"
  assert len(repeat("😀", 3)) == 3
  assert from_char('😀') == "😀"
  assert from_char('a') == "a"
  assert at(from_char('中'), 0) == '中'
}

test "repeat needs no stack, at a count that used to exhaust it" {
  # The count here is chosen against the stack, and is the only assertion in
  # this block the old implementation fails. `s ++ repeat(s, n - 1)` is one
  # frame per repetition: it dies past n = 4000 under a default -Xss, but the
  # test runner forks programs with -Xss512m, where it survives to about 8.2
  # million. So a count that catches it has to clear that, and 9 million does --
  # measured, on both backends. A one-character unit keeps it affordable: 0.1s
  # and 9 MB, against 1.8s for the same count of "ab".
  #
  # First in the block on purpose. The implementation it guards against is also
  # quadratic, so putting the cheaper assertions ahead of this one would make a
  # reverted `repeat` grind through them for minutes before reaching the
  # assertion that actually indicts it.
  #
  # If a future runtime gets deeper stacks this stops distinguishing the two
  # implementations, but it degrades into an ordinary large-input test rather
  # than into a false red.
  let deep = repeat("a", 9000000)
  assert len(deep) == 9000000
  assert take(deep, 3) == "aaa"
  assert drop(deep, 8999997) == "aaa"

  # Content at scale, with a two-character unit so the assertions can see the
  # repetitions line up rather than just counting characters. Asserted through
  # the length and three windows -- comparing the whole 200000-character answer
  # would put it in the failure report.
  let big = repeat("ab", 100000)
  assert len(big) == 200000
  assert take(big, 6) == "ababab"
  assert drop(big, 199994) == "ababab"
  assert slice(big, 99999, 100003) == "baba"
  assert repeat("ab", 100000) == repeat("ab", 99999) ++ "ab"
}

test "for over a String walks it one code point at a time" {
  var seen = ""
  var n = 0
  for ch in "a中😀" {
    seen = seen ++ "[" ++ ch ++ "]"
    n = n + 1
  }
  assert n == 3
  assert seen == "[a][中][😀]"
  var empty = 0
  for _ch in "" { empty = empty + 1 }
  assert empty == 0
}

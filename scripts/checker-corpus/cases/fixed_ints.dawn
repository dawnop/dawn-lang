# std's fixed-width integers (docs/literal-system-design.md D13): two widths
# do not mix, and a float literal never becomes an integer type. The range
# of a literal is fixed_int_folds', a separate case because those errors
# surface when the program is folded, after checking has passed.
use std/int/u8
use std/int/u16

fn mixed(a: u8.U8, b: u16.U16) -> u8.U8 = a + b

fn floaty() -> u16.U16 = 1.5

pub fn main() -> Unit !io = println("${mixed(1, 2)} ${floaty()}")

# The search index: everything on this site a reader can be sent to, as one
# JSON asset per language.
#
# The site had no search at all. stdlib.html carries 186 API entries under a
# sidebar with 21 links in it, spec.html has 76 numbered sections, and the
# only way to reach any of them was to open the page and press ctrl-F. The
# panel that consumes this lives in examples/projects/tea_dom_search and runs
# as a wasm reactor; what is here is the half that has to be a build product.
#
# Generated, never written by hand. Every row below is derived from the file
# the page it points at was generated from -- the compiler's own
# `dawn doc --stdlib` output, the Markdown of the spec and the design notes,
# the tutorial's chapter split, the gallery walk, the nav table -- so an entry
# cannot describe a page that does not exist and cannot go stale when one
# moves. The anchors are the sharp end of that: `gen/stdlib.api_rows` hands
# them over from the same function that emits the ids, and gen/links checks
# every href in the written asset against the written pages, fragment
# included.
#
# One asset per language rather than one with both. The two differ in more
# than their labels: the section titles come from two different documents
# (docs/spec.en.md and docs/spec.md), and every href in the Chinese one is
# under `/zh/`. Merging them would make every page download the other
# language's titles.
#
# The rows are five strings, positional:
#
#   [group, title, detail, note, href]
#
# Positional and not an object because the order of an object's keys in this
# repository's JSON renderer is a fact about a hash table, and
# scripts/site-dist-diff.sh compares two builds of this file byte for byte.
# An array has one order and it is the one written here. `href` is relative to
# the SITE ROOT; the page supplies its own distance from it when it mounts.
#
# The five groups are the panel's, and the panel is what rejects an unknown
# one -- an entry whose group is not one of those five is simply never drawn.
# The test below is what keeps this file honest about that.
#
# The panel splits what it searches into words by a rule this file restates
# ([tokens]); see the words section below for why there are two copies.

use std/str
use std/list
use std/char
use std/io
use std/io.{Fs}
use json/parser.{parse}
use json/value.{Json, JStr, error_text}
use json/render.{render}
use md/ast.{Block}
use html/render.{render_doc}
use html/page.{Lang, En, Zh, lang_path, nav_items}
use gen/common.{pad2}
use gen/corpus.{Corpus, read_corpus}
use gen/stdlib.{api_rows}
use gen/tutorial.{chapter_titles, chapter_sections}
use gen/examples.{gallery_examples, must_describe}
use gen/copy.{load_copy, plain, body_text}
use gen/gpu.{prose_sections, copy_file}
use gen/packages.{read_packages, summary_text, row_id}

## One row of the index.
pub type Row = { group: String, title: String, detail: String, note: String, href: String }

## How much of a doc comment rides along. A note is a hint under a name, not
## the documentation: long enough to hold the first sentence of most doc
## comments in std (the median is about 60 characters, nine in ten are under
## 140), short enough that the index stays a few tens of kilobytes.
fn note_len() -> Int = 160

## The first sentence of a doc comment, cut to [note_len].
##
## The first sentence and not the first line: doc comments in this repository
## are wrapped at a fixed width, so the first line ends wherever the wrap fell
## -- regularly in the middle of a clause -- and a note that stops at "a
## handler answers," reads as a broken page. The sentence is looked for in the
## first paragraph only (up to the first blank line), with its lines joined.
## It ends at a full stop followed by a blank or by the end of the paragraph,
## or at an ideographic full stop.
pub fn note_of(doc: String) -> String = {
  var para: List[String] = []
  var done = false
  for line in str.split(doc, "\n") {
    let t = str.trim(line)
    if not done && t != "" {
      para = para ++ [t]
    } else if t == "" && len(para) > 0 {
      done = true
    }
  }
  bounded(first_sentence(join(para, " ")))
}

fn first_sentence(p: String) -> String = {
  let cs = code_points(p)
  var end = len(cs)
  var i = 0
  while i < len(cs) && end == len(cs) {
    let c = cs[i]
    if c == '。' || (c == '.' && (i + 1 == len(cs) || char.is_space(cs[i + 1]))) {
      end = i + 1
    }
    i = i + 1
  }
  from_code_points(list.take(cs, end))
}

## `s` when it fits in [note_len], or cut at the last blank that does and
## marked as cut. A run with no blank in it (Chinese, a long identifier) is cut
## where the bound falls.
fn bounded(s: String) -> String = {
  let cs = code_points(s)
  if len(cs) <= note_len() {
    s
  } else {
    var at = note_len()
    while at > 0 && not char.is_space(cs[at]) {
      at = at - 1
    }
    let keep = if at == 0 { note_len() } else { at }
    from_code_points(list.take(cs, keep)) ++ "..."
  }
}

# ---- the four sources ------------------------------------------------------

## The standard library reference, one row per anchored entry.
##
## `api` is the parsed `dawn doc --stdlib` document. The anchors come from
## gen/stdlib rather than from a second copy of its id rules; that module's
## own test holds them to the ids the page really emits.
fn api_index(api: Json, lang: Lang) -> List[Row] = {
  let page = lang_path(lang, "stdlib.html")
  list.map(api_rows(api), r =>
      Row {
        group: "stdlib",
        title: r.title,
        detail: r.decl,
        note: note_of(r.doc),
        href: "${page}#${r.anchor}",
      })
}

## One rendered document's headings, as rows.
##
## The ids are `render_doc`'s, which is the same call gen/pages makes to write
## the page, over the same parsed blocks (gen/corpus), so the fragments cannot
## drift from the anchors: a heading counter that moved would move both at
## once. The URL mapper is the identity because nothing here reads the
## rendered html -- only the table of contents.
fn doc_index(blocks: List[Block], group: String, page: String, detail: String) -> List[Row] = {
  list.map(render_doc(blocks, u => u).toc, e =>
      Row { group: group, title: e.text, detail: detail, note: "", href: "${page}#${e.id}" })
}

## The tutorial, one row per chapter page and one per `###` section in it.
##
## The sections are the half that used to be missing: chapters 16 and 17 have
## seven between them (`Sorting: Ord and the comparison operators`, `Handler
## state: a var in the arm table`, ...), and a reader searching for one of
## those found nothing. A section's note is its chapter's title, which is what
## tells two sections with similar names apart.
fn tutorial_index(blocks: List[Block], lang: Lang, detail: String) -> List[Row] = {
  var rows: List[Row] = []
  let titles = chapter_titles(blocks)
  let sections = chapter_sections(blocks)
  for i in range(0, len(titles)) {
    let page = lang_path(lang, "tutorial/${pad2(i + 1)}.html")
    rows = rows
      ++ [Row { group: "tutorial", title: titles[i], detail: detail, note: "", href: page }]
    for e in sections[i] {
      rows = rows
        ++ [Row {
          group: "tutorial",
          title: e.text,
          detail: detail,
          note: titles[i],
          href: "${page}#${e.id}",
        }]
    }
  }
  rows
}

## The gallery, one row per example, plus the site's own pages.
##
## The nav table is read rather than restated: the nine entries a reader can
## click in the header are nine pages the search has to be able to reach, and
## a nav item added without a row here would be a page the panel cannot find.
fn examples_index(lang: Lang, detail: String, home: String) -> List[Row] !Fs = {
  var rows: List[Row] = []
  rows = rows ++ [Row {
    group: "examples",
    title: home,
    detail: detail,
    note: "",
    href: lang_path(lang, "index.html"),
  }]
  for item in nav_items(lang) {
    let (_, label, path) = item
    rows = rows ++ [Row { group: "examples", title: label, detail: detail, note: "", href: path }]
  }
  for ex in gallery_examples() {
    rows = rows
      ++ [Row {
        group: "examples",
        title: ex.slug,
        detail: detail,
        note: note_of(must_describe(ex)),
        href: lang_path(lang, "examples/${ex.slug}.html"),
      }]
  }
  rows
}

## The cuTile backend's page, from the copy it is written from: one row for
## the page, under its title with the lede's first sentence as the note, and
## one per section, under its heading with the first sentence of its prose.
##
## In the "examples" group, which the panel draws as examples and pages: the
## page is a page of the site, as the nav's rows are. Its prose is in the
## title index's notes rather than in the body index because the panel draws
## a body section only for the four documents it knows (spec, tutorial,
## history, design); a fifth `doc` would be indexed, fetched and dropped.
## The figures are not indexed: they are numbers, and a search for one finds
## nothing a reader asked for.
fn gpu_index(lang: Lang, detail: String) -> List[Row] !Fs = {
  let c = load_copy(copy_file(lang))
  let page = lang_path(lang, "gpu.html")
  [Row { group: "examples", title: plain(c, "title"), detail: detail, note: note_of(plain(c, "lede")), href: page }]
    ++ list.map(prose_sections(), e => {
      let (id, key) = e
      Row {
        group: "examples",
        title: plain(c, "${key}-title"),
        detail: detail,
        note: note_of(body_text(c, "${key}-body")),
        href: "${page}#${id}",
      }
    })
}

## The packages page, one row per package: the name `use` lines spell, with
## its README's first sentence as the note, landing on its row of the table.
##
## In the "examples" group, as the cuTile page's rows are, for the reason
## given there. Read from the manifests and READMEs only, not from the `dawn
## doc` documents the page also reads: those are written by site/build.sh,
## and `dawn test site` runs without them.
fn packages_index(lang: Lang, detail: String) -> List[Row] !Fs = {
  let page = lang_path(lang, "packages.html")
  list.map(read_packages(), p =>
      Row {
        group: "examples",
        title: p.use_as,
        detail: detail,
        note: note_of(summary_text(p)),
        href: "${page}#${row_id(p.dir)}",
      })
}

# ---- the words the rows carry ----------------------------------------------
#
# The `detail` of a section row is the name of the document it is in, which is
# the only thing that tells `6.5 Named effects` on the spec from a chapter of
# the tutorial in a list.
#
# The history's rows are a group of their own, "history": the timeline's
# sections, whose detail says History as the nav does, and the early design
# notes' sections, whose detail says Early decisions -- the notes are frozen
# at M7, and a result that sat beside the spec's under one heading read as
# the current design. One table, both languages on adjacent lines, for the
# reason gen/stdlib's chrome gives.

type Words = {
  spec: String,
  history: String,
  design: String,
  tutorial: String,
  gallery: String,
  home: String,
  gpu: String,
  packages: String,
}

fn words(lang: Lang) -> Words =
  match lang {
    En -> Words {
      spec: "Spec",
      history: "History",
      design: "Early decisions",
      tutorial: "Tutorial",
      gallery: "Site",
      home: "Home",
      gpu: "cuTile backend",
      packages: "Packages",
    }
    Zh -> Words {
      spec: "规范",
      history: "历史",
      design: "早期设计决定",
      tutorial: "教程",
      gallery: "站点",
      home: "首页",
      gpu: "cuTile 后端",
      packages: "包",
    }
  }

# ---- the words a reader can search by -------------------------------------
#
# The panel splits every row into words, once, when it mounts, and matches a
# query word by word. The rule is restated here, in a program that cannot
# share a line of code with that one, so that the two are held to the same
# samples by a pair of tests that name each other (see the tests below and
# examples/projects/tea_dom_search/src/search.dawn). The generator holds it
# to the rows it writes: a row whose title has no words in it could be found
# only by typing its punctuation.
#
#   lowercase; split on every character that is not an ASCII letter or digit,
#   `_`, `!`, `.`, or a letter or digit beyond ASCII; strip the dots off both
#   ends of a run; then a run made of pieces joined by `.`, `_` or `!` yields
#   each piece and then the run itself, so `io.read_file` is `io`, `read`,
#   `file` and `io.read_file`, and `!Fs` is `fs` and `!fs`.

## Whether `c` can sit inside a run.
fn is_run_char(c: Char) -> Bool =
  (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '!' || c == '.'
  || (char.code(c) > 127 && char.is_alnum(c))

## Whether `c` joins two pieces of one run.
fn is_joint(c: Char) -> Bool = c == '.' || c == '_' || c == '!'

## The maximal runs of [is_run_char] in `s`, lowercased, with the dots off
## both ends.
fn runs(s: String) -> List[String] = {
  var out: List[String] = []
  var cur: List[Char] = []
  for c in code_points(str.to_lower(s)) ++ [' '] {
    if is_run_char(c) {
      cur = cur ++ [c]
    } else if len(cur) > 0 {
      out = out ++ [trim_dots(cur)]
      cur = []
    }
  }
  out
}

fn trim_dots(cs: List[Char]) -> String = {
  var from = 0
  while from < len(cs) && cs[from] == '.' {
    from = from + 1
  }
  var to = len(cs)
  while to > from && cs[to - 1] == '.' {
    to = to - 1
  }
  from_code_points(list.slice(cs, from, to))
}

## The pieces of a run, split at every [is_joint], empty ones dropped.
fn pieces(run: String) -> List[String] =
  list.filter(list.map(runs_split(code_points(run)), cs => from_code_points(cs)), p => p != "")

fn runs_split(cs: List[Char]) -> List[List[Char]] = {
  var out: List[List[Char]] = []
  var cur: List[Char] = []
  for c in cs {
    if is_joint(c) {
      out = out ++ [cur]
      cur = []
    } else {
      cur = cur ++ [c]
    }
  }
  out ++ [cur]
}

## The words of `s`, by the rule above.
pub fn tokens(s: String) -> List[String] = {
  var out: List[String] = []
  for whole in runs(s) {
    let ps = pieces(whole)
    if len(ps) > 0 {
      out = out ++ ps
      if not (len(ps) == 1 && ps[0] == whole) {
        out = out ++ [whole]
      }
    }
  }
  out
}

## The words of a paragraph of body text, for the body index
## (gen/search_body, docs/site-search-design.md 2.3): every Han character
## becomes a blank and the rest goes through [tokens]; then each Han character
## is a word of its own, in the order they occur.
##
## Single characters because Chinese has no blanks: [tokens] would make every
## run of Han text between two punctuation marks one word, and a query could
## only find it by scanning every paragraph. A query's characters each find
## their paragraphs by binary search instead, and the panel checks the few
## candidates for the whole string. The blanks first because `inline_text`
## joins inline code to the prose around it, and the Chinese documents put
## an identifier straight against the Han text after it all the time: left as
## one run, `Fs` followed by a Chinese word would not give `fs` as a word.
pub fn body_terms(s: String) -> List[String] = {
  var rest: List[Char] = []
  var han: List[String] = []
  for c in code_points(s) {
    if is_han(c) {
      rest = rest ++ [' ']
      han = han ++ [str.from_char(c)]
    } else {
      rest = rest ++ [c]
    }
  }
  tokens(from_code_points(rest)) ++ han
}

## Whether `c` is a Han character: the CJK unified ideographs, extension A,
## the compatibility block and the supplementary planes' extensions. Kana,
## Hangul and full-width punctuation are not.
pub fn is_han(c: Char) -> Bool = {
  let n = char.code(c)
  (n >= 0x3400 && n <= 0x4DBF) || (n >= 0x4E00 && n <= 0x9FFF) || (n >= 0xF900 && n <= 0xFAFF)
    || (n >= 0x20000 && n <= 0x2FA1F)
}

# ---- the asset -------------------------------------------------------------

fn quoted(s: String) -> String = render(JStr(value: s))

fn row_json(r: Row) -> String =
  "[" ++ join([quoted(r.group), quoted(r.title), quoted(r.detail), quoted(r.note),
    quoted(r.href)], ",") ++ "]"

## Every row of one language's index, in the order the file will carry them.
## `c` is the same language's documents, as gen/corpus parsed them for the
## pages.
pub fn index_rows(api: Json, lang: Lang, c: Corpus) -> List[Row] !Fs = {
  let w = words(lang)
  api_index(api, lang)
    ++ doc_index(c.spec, "spec", lang_path(lang, "spec.html"), w.spec)
    ++ doc_index(c.history, "history", lang_path(lang, "history.html"), w.history)
    ++ doc_index(c.design, "history", lang_path(lang, "design.html"), w.design)
    ++ tutorial_index(c.tutorial, lang, w.tutorial)
    ++ examples_index(lang, w.gallery, w.home)
    ++ gpu_index(lang, w.gpu)
    ++ packages_index(lang, w.packages)
}

## The index for one language, as the bytes that go into /assets/.
##
## `v` is a schema number the panel does not read yet and this file writes
## anyway: the asset is fetched by a wasm module built from a different source
## tree at a different time, and the day the two disagree the version is the
## only place the disagreement can be seen.
##
## `start` is what the panel suggests before anything is typed, as positions
## in `items`. Positions and not a second copy of the rows, so a suggestion's
## title and href are the row's own -- in this language, and checked by
## gen/links with every other href in the file.
pub fn search_index(api: Json, lang: Lang, c: Corpus) -> String !Fs = {
  let rows = index_rows(api, lang, c)
  "{\"v\":1,\"lang\":" ++ quoted(lang_code_of(lang))
    ++ ",\"start\":[" ++ join(list.map(start_ids(rows, lang), i => to_string(i)), ",") ++ "]"
    ++ ",\"items\":[" ++ join(list.map(rows, r => row_json(r)), ",") ++ "]}"
}

## Where a reader new to the site starts: the tutorial's first chapter, the
## spec's chapter on effects (the thing Dawn has that most languages do not),
## and the string module, which is the first API most programs reach for.
## Each is found among the rows by what it is rather than by position, and a
## build where one is missing stops: an empty "Start here" would ship
## silently otherwise.
pub fn start_ids(rows: List[Row], lang: Lang) -> List[Int] = {
  let first_chapter = lang_path(lang, "tutorial/01.html")
  [
    must_find(rows, "tutorial chapter 1", r => r.group == "tutorial" && r.href == first_chapter),
    must_find(rows, "spec chapter 6", r => r.group == "spec" && str.starts_with(r.title, "6. ")),
    must_find(rows, "std/str", r => r.group == "stdlib" && r.title == "std/str"),
  ]
}

fn must_find(rows: List[Row], what: String, p: fn(Row) -> Bool) -> Int = {
  var at = -1
  var i = 0
  for r in rows {
    if at < 0 && p(r) {
      at = i
    }
    i = i + 1
  }
  if at < 0 {
    panic("search index: no row for the suggested ${what}")
  }
  at
}

# The `lang` field is the page's own `lang` attribute, so that the panel can
# switch its labels on the same string the document does. html/page.lang_code
# is where it comes from; it is spelled through this wrapper only because this
# module has no `Assets` to reach for.
fn lang_code_of(lang: Lang) -> String =
  match lang {
    En -> "en"
    Zh -> "zh-CN"
  }

## The parsed `dawn doc --stdlib` document, or a stop. Read here rather than
## passed down from gen/pages, so that the asset and the page it indexes read
## the same file the same way.
pub fn read_api() -> Json !Fs = {
  let text =
    match io.read_file("site/build/stdlib.json") {
      Ok(t) -> t
      Err(_) ->
        panic("site/build/stdlib.json missing — run site/build.sh (it runs dawn doc --stdlib)")
    }
  match parse(text) {
    Ok(v) -> v
    Err(e) -> panic("stdlib.json: " ++ error_text(e))
  }
}

# ---- tests -----------------------------------------------------------------

## The shape the panel reads. This literal is the contract between two
## programs that cannot share a line of code; the same one is pinned in
## examples/projects/tea_dom_search/src/search.dawn's own test, and the two
## tests name each other so that a change to either is a change to both.
test "an index row is five strings, in this order" {
  assert row_json(Row {
    group: "spec",
    title: "6.5 Named effects",
    detail: "Spec",
    note: "",
    href: "spec.html#s6-5",
  }) == "[\"spec\",\"6.5 Named effects\",\"Spec\",\"\",\"spec.html#s6-5\"]"
  # a quote and a backslash in a title are the reason this goes through the
  # JSON renderer rather than through string concatenation
  assert row_json(Row { group: "g", title: "a\"b\\c", detail: "", note: "", href: "h" })
    == "[\"g\",\"a\\\"b\\\\c\",\"\",\"\",\"h\"]"
}

## The `dawn doc --stdlib` document, in miniature. Synthetic rather than the
## real one because `dawn test site` runs before site/build.sh writes it: the
## tests below are about what this module does with an API document, and
## gen/stdlib's own test is what says the anchors are the page's.
fn probe_api() -> Json =
  match parse("{\"groups\":[{\"name\":\"io\",\"fns\":[{\"name\":\"println\","
      ++ "\"sig\":\"fn println(s: String) -> Unit !io\",\"doc\":\"Print a line.\"}]}],"
      ++ "\"traits\":[],\"modules\":[{\"path\":\"std/str\",\"doc\":\"Strings.\","
      ++ "\"impls\":[],\"types\":[],\"traits\":[],\"consts\":[],\"effects\":[],"
      ++ "\"fns\":[{\"name\":\"trim\",\"sig\":\"fn trim(s: String) -> String\","
      ++ "\"doc\":\"Trim it.\"}]}]}") {
    Ok(v) -> v
    Err(e) -> panic("the probe document must parse: " ++ error_text(e))
  }

## Only the five groups the panel draws. A sixth would be scored, matched and
## then dropped without a word, so it is refused here instead. And every title
## has a word in it, by the panel's own rule, or the row could be reached only
## by typing its punctuation.
test "every row lands in one of the five groups the panel draws" {
  io.with_fs_real(() => {
    let drawn = ["stdlib", "spec", "tutorial", "examples", "history"]
    for lang in [En, Zh] {
      for r in index_rows(probe_api(), lang, read_corpus(lang)) {
        assert list.contains(drawn, r.group)
        assert r.title != ""
        assert r.href != ""
        assert len(tokens(r.title)) > 0
      }
    }
  })
}

## The words of a string, by the rule in the words section. These samples are
## the contract between two programs that cannot share a line of code; the same
## list is pinned in examples/projects/tea_dom_search/src/search.dawn's own
## test, and the two tests name each other so that a change to either is a
## change to both.
test "an index's words and a query's words split the same way" {
  let samples: List[(String, List[String])] = [
    ("io.read_file", ["io", "read", "file", "io.read_file"]),
    ("fn read_file(path: String) -> Unit !Fs", ["fn", "read", "file", "read_file", "path",
      "string", "unit", "fs", "!fs"]),
    ("6.5 Named effects", ["6", "5", "6.5", "named", "effects"]),
    ("Remove surrounding whitespace.", ["remove", "surrounding", "whitespace"]),
    ("str.", ["str"]),
    ("`with handle` 命名效果，处理器", ["with", "handle", "命名效果", "处理器"]),
    ("... ! -> ()", []),
  ]
  for sample in samples {
    let (s, words) = sample
    assert tokens(s) == words
  }
}

## The body index's words, by the table in docs/site-search-design.md 3.2.
## That table is the contract with the panel that will query the body index
## (examples/projects/tea_dom_search); its test copies the same rows and names
## the same section, so a change to either side is a change to the table.
test "a body's words split by the table in docs/site-search-design.md 3.2" {
  let samples: List[(String, List[String])] = [
    ("io.read_file", ["io", "read", "file", "io.read_file"]),
    ("!io 效果", ["io", "!io", "效", "果"]),
    ("!Fs", ["fs", "!fs"]),
    ("命名效果，处理器", ["命", "名", "效", "果", "处", "理", "器"]),
    ("Fs效果的 handler", ["fs", "handler", "效", "果", "的"]),
    ("str.trim 去掉空白", ["str", "trim", "str.trim", "去", "掉", "空", "白"]),
    ("6.5 具名效果", ["6", "5", "6.5", "具", "名", "效", "果"]),
    ("café λx", ["café", "λx"]),
    ("全角，标点。", ["全", "角", "标", "点"]),
    ("... ! -> ()", []),
  ]
  for sample in samples {
    let (s, words) = sample
    assert body_terms(s) == words
  }
}

## A note is one sentence and is bounded. The bound is what keeps the asset a
## few tens of kilobytes instead of a few hundred: doc comments in this
## repository regularly run to twenty lines.
test "a note is the first sentence of a doc comment, cut to a bound" {
  assert note_of("Remove surrounding whitespace.\n\nThe long reasoning follows.")
    == "Remove surrounding whitespace."
  assert note_of("\n\n  Leading blanks do not count.  ") == "Leading blanks do not count."
  assert note_of("") == ""
  # a sentence wrapped over three lines is one sentence, and the next one is
  # not part of it
  assert note_of("Run `body` and answer everything\nit emitted, in the order it\nemitted it. The rest.")
    == "Run `body` and answer everything it emitted, in the order it emitted it."
  # a dot inside a word is not the end of a sentence, and the first paragraph
  # is as far as the search goes
  assert note_of("Calls io.read_file and stops\n\nHere. Not here.") == "Calls io.read_file and stops"
  assert note_of("读取文件。然后关闭。") == "读取文件。"
  # too long: cut at a blank, marked as cut
  let words = str.repeat("word ", 50)
  let cut = note_of(words)
  assert str.ends_with(cut, "word...")
  assert len(code_points(cut)) <= note_len() + 3
  let long = str.repeat("x", 200)
  assert len(code_points(note_of(long))) == note_len() + 3
  assert str.ends_with(note_of(long), "...")
}

## The sections a chapter page anchors are searchable, under their chapter.
test "the tutorial's sections are indexed with their chapter as the note" {
  io.with_fs_real(() => {
    let rows = list.filter(index_rows(probe_api(), En, read_corpus(En)), r => r.group == "tutorial")
    let sections = list.filter(rows, r => str.contains(r.href, "#"))
    assert len(sections) > 0
    for r in sections {
      assert r.note != ""
      assert str.starts_with(r.href, "tutorial/")
    }
  })
}

## The whole asset, on the real inputs: every group is in it, the hrefs are
## relative to the site root rather than to a page, and the Chinese one is the
## Chinese one.
test "the index carries every group and addresses them from the site root" {
  io.with_fs_real(() => {
    let api = probe_api()
    let en = index_rows(api, En, read_corpus(En))
    let zh = index_rows(api, Zh, read_corpus(Zh))
    for group in ["stdlib", "spec", "tutorial", "examples", "history"] {
      assert len(list.filter(en, r => r.group == group)) > 0
      assert len(list.filter(zh, r => r.group == group)) > 0
    }
    # site-root relative: no leading slash, no `./`, no `../`
    for r in en ++ zh {
      assert not str.starts_with(r.href, "/")
      assert not str.starts_with(r.href, ".")
    }
    # and the Chinese tree is where the Chinese rows point
    for r in zh {
      assert str.starts_with(r.href, "zh/")
    }
    for r in en {
      assert not str.starts_with(r.href, "zh/")
    }
    # the stdlib rows are anchored into the stdlib page, in each language's tree
    assert list.filter(en, r => r.group == "stdlib")[0].href == "stdlib.html#g-io"
    assert list.filter(zh, r => r.group == "stdlib")[0].href == "zh/stdlib.html#g-io"
    # the timeline and the early design notes are History, and the spec is the spec
    let hist = list.filter(en, r => r.group == "history")
    for r in hist {
      assert str.starts_with(r.href, "history.html#") || str.starts_with(r.href, "design.html#")
    }
    assert len(list.filter(hist, r => str.starts_with(r.href, "history.html#") && r.detail == "History")) > 0
    assert len(list.filter(hist, r => str.starts_with(r.href, "design.html#") && r.detail == "Early decisions")) > 0
    assert len(list.filter(zh, r => r.group == "history" && str.starts_with(r.href, "zh/history.html#"))) > 0
    for r in list.filter(en, r => r.group == "spec") {
      assert str.starts_with(r.href, "spec.html#")
    }
  })
}

## The cuTile page is in the index in each language: the page under its
## title and every section of its prose under its heading, each with a note,
## in the group the panel draws as pages.
test "the cuTile page and its sections are rows of the index" {
  io.with_fs_real(() => {
    for lang in [En, Zh] {
      let page = lang_path(lang, "gpu.html")
      let rows = list.filter(index_rows(probe_api(), lang, read_corpus(lang)),
        r => r.href == page || str.starts_with(r.href, page ++ "#"))
      # the page row, one per section, and the nav's own row for it
      assert len(rows) == len(prose_sections()) + 2
      for r in rows {
        assert r.group == "examples"
      }
      for e in prose_sections() {
        let (id, _) = e
        let hit = list.filter(rows, r => r.href == "${page}#${id}")
        assert len(hit) == 1
        assert hit[0].note != ""
      }
    }
    let en = list.filter(index_rows(probe_api(), En, read_corpus(En)), r => r.href == "gpu.html")
    assert list.map(en, r => r.title) == ["GPU", "Dawn's cuTile backend"]
    let zh = list.filter(index_rows(probe_api(), Zh, read_corpus(Zh)), r => r.href == "zh/gpu.html")
    assert list.map(zh, r => r.title) == ["GPU", "Dawn 的 cuTile 后端"]
    assert str.starts_with(zh[1].note, "Dawn 里的 GPU kernel")
  })
}

## Every package is a row in each language, landing on its row of the
## packages page with its README's first sentence as the note.
test "each package is a row of the index, on its row of the packages page" {
  io.with_fs_real(() => {
    let n = len(read_packages())
    for lang in [En, Zh] {
      let page = lang_path(lang, "packages.html")
      let rows = list.filter(index_rows(probe_api(), lang, read_corpus(lang)),
        r => str.starts_with(r.href, page ++ "#pkg-"))
      assert len(rows) == n
      for r in rows {
        assert r.group == "examples"
        assert r.note != ""
      }
    }
    let en = list.filter(index_rows(probe_api(), En, read_corpus(En)), r => r.href == "packages.html#pkg-tea-dom")
    assert list.map(en, r => r.title) == ["tea_dom"]
  })
}

## The suggestions are rows of the same index, so a reader who picks one lands
## where a search for it would have sent them, in their own language.
test "the suggested starting points are rows of the index, in each language" {
  io.with_fs_real(() => {
    let api = probe_api()
    for lang in [En, Zh] {
      let rows = index_rows(api, lang, read_corpus(lang))
      let picked = list.map(start_ids(rows, lang), i => rows[i])
      assert list.map(picked, r => r.group) == ["tutorial", "spec", "stdlib"]
      assert picked[0].href == lang_path(lang, "tutorial/01.html")
      assert str.starts_with(picked[1].title, "6. ")
      assert picked[2].title == "std/str"
    }
    let en_rows = index_rows(api, En, read_corpus(En))
    let en = list.map(start_ids(en_rows, En), i => en_rows[i].href)
    assert en == ["tutorial/01.html", "spec.html#s6", "stdlib.html#m-std-str"]
  })
}

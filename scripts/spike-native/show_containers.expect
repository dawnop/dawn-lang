-- lists --
[1, 2, 3]
["a", "b"]
[Point(1, 1)]
[]
-- a map renders as the call that rebuilds it --
map_from([(1, "one")])
-- and so does a set --
set_from([7])
-- nested inside a value that does have structure --
Some([1, 2])
(["x"], 1)
-- a Unit rides an erased slot like any other value --
2
[1, 1]

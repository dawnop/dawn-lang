# Staged `for` (docs/staged-for-design.md), differentially, with no tileir in
# sight: the rewrite is the checker's, and these two libraries are the only
# things that know what a "staged" loop is.
#
# `Span` records a loop the way tileir does: the body runs once, on a symbolic
# index, and each carried `var` is a named slot whose open, reads and writes
# show up in the transcript. The transcript is what makes the carry order
# visible -- `acc` is declared last and mentioned first, so a cell order taken
# from first mention or from assignment position prints differently.
#
# `Times` runs the body n times on the host, and its cells live in a handler's
# state. It shows that the rewrite is an ordinary closure plus ordinary trait
# calls: the cells really are read and written, and the `var`s really hold
# the result afterwards.
use std/map

type Val = { name: String }
type Slot = { tag: String }
type Span = { n: Int }

fn span(n: Int) -> Span = Span { n: n }

impl StagedIter[Span] {
  type Item = Val
  effect StagedIter = !io
  fn staged_for(r: Span, body: fn(Val) -> Unit !io) -> Unit !io = {
    println("for %i < ${r.n} {")
    body(Val { name: "%i" })
    println("}")
  }
}

impl StagedVar[Val] {
  type Cell = Slot
  effect StagedVar = !io
  fn var_open(v: Val) -> Slot !io = {
    println("  carry ${v.name}")
    Slot { tag: v.name }
  }
  fn var_get(c: Slot) -> Val !io = Val { name: "%" ++ c.tag }
  fn var_set(c: Slot, v: Val) -> Unit !io = println("  yield %${c.tag} <- ${v.name}")
}

fn add(a: Val, b: Val) -> Val = Val { name: "(${a.name}+${b.name})" }

effect Mem {
  fn alloc(v: Int) -> Int
  fn load(i: Int) -> Int
  fn store(i: Int, v: Int) -> Unit
}

type Num = { v: Int }
type Ref = { i: Int }
type Times = { n: Int }

impl StagedIter[Times] {
  type Item = Int
  effect StagedIter = !Mem
  fn staged_for(r: Times, body: fn(Int) -> Unit !Mem) -> Unit !Mem = {
    var i = 0
    while i < r.n {
      body(i)
      i = i + 1
    }
  }
}

impl StagedVar[Num] {
  type Cell = Ref
  effect StagedVar = !Mem
  fn var_open(v: Num) -> Ref !Mem = Ref { i: alloc(v.v) }
  fn var_get(c: Ref) -> Num !Mem = Num { v: load(c.i) }
  fn var_set(c: Ref, v: Num) -> Unit !Mem = store(c.i, v.v)
}

# flash-attention's shape: carried values declared m, l, acc, and a body that
# mentions them acc-first and assigns m last. The read-only `var` bias is
# carried too; the `let` scale is captured as any closure captures it, and
# the `l` the inner block shadows is not a mention of the outer one.
fn recorded() -> Unit !io = {
  var m = Val { name: "m" }
  var l = Val { name: "l" }
  let scale = Val { name: "scale" }
  var acc = Val { name: "acc" }
  var bias = Val { name: "bias" }
  for j in span(4) {
    acc = add(acc, add(j, scale))
    {
      let l = Val { name: "shadow" }
      println("  note ${l.name}")
    }
    l = add(l, m)
    m = add(m, bias)
  }
  println("after ${m.name} ${l.name} ${acc.name} ${bias.name}")
}

# Nested staged loops: the inner one writes the outer `var` through the cell
# the outer loop opened, and opens its own cell only for the `var` declared in
# the outer body. A host loop sits inside the staged body, and a staged loop
# inside a host loop.
fn nested() -> Unit !io = {
  var s = Val { name: "s" }
  for i in span(2) {
    var t = Val { name: "t" }
    for k in span(3) {
      s = add(s, k)
      t = add(t, i)
    }
    for x in ["a", "b"] { println("  host ${x}") }
    s = add(s, t)
  }
  for round in 0..2 {
    var u = Val { name: "u${round}" }
    for q in span(1) { u = add(u, q) }
    println("round ${round}: ${u.name}")
  }
  println("after ${s.name}")
}

# A host run: the cells live in the handler's state, and every iteration
# really reads and writes them, so the `var`s hold the answer afterwards.
fn fib(n: Int) -> (Int, Int) = {
  with handle Mem {
    var mem: Map[Int, Int] = map.empty()
    alloc(v) => {
      let i = map.len(mem)
      mem = map.insert(mem, i, v)
      i
    }
    load(i) => mem[i]
    store(i, v) => { mem = map.insert(mem, i, v) }
  }
  var a = Num { v: 0 }
  var b = Num { v: 1 }
  let step = Num { v: 1 }
  var count = Num { v: 0 }
  for _ in (Times { n: n }) {
    let next = Num { v: a.v + b.v }
    a = b
    b = next
    count = Num { v: count.v + step.v }
  }
  (a.v, count.v)
}

# One type behind both traits: `Num` is iterated and carried in the same loop.
# Each trait's effect member is named like the trait, so a row over such a
# type can name both without `T.E` meaning two things.
impl StagedIter[Num] {
  type Item = Int
  effect StagedIter = !Mem
  fn staged_for(r: Num, body: fn(Int) -> Unit !Mem) -> Unit !Mem = {
    var i = 0
    while i < r.v {
      body(i)
      i = i + 1
    }
  }
}

fn doubled(t: Num, f: fn(Num, Int) -> Num) -> Num !Mem = {
  var acc = t
  for i in t { acc = f(acc, i) }
  acc
}

fn both() -> Int = {
  with handle Mem {
    var mem: Map[Int, Int] = map.empty()
    alloc(v) => {
      let i = map.len(mem)
      mem = map.insert(mem, i, v)
      i
    }
    load(i) => mem[i]
    store(i, v) => { mem = map.insert(mem, i, v) }
  }
  doubled(Num { v: 4 }, (a, i) => Num { v: a.v * 2 + i }).v
}

# A loop generic over its iterator: the projections stay rigid and the
# caller's dictionary answers them.
fn each[R: StagedIter](r: R, f: fn(R.Item) -> Unit !R.StagedIter) -> Unit !R.StagedIter = {
  for x in r { f(x) }
}

pub fn main() -> Unit !io = {
  recorded()
  nested()
  let (f, c) = fib(10)
  println("fib ${f} after ${c} steps")
  each(span(2), v => println("  each ${v.name}"))
  println("both ${both()}")
}

fn consume(xs: List[(
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
  Option[Bool],
)]) -> Unit = {
  for (
    Some(true) | Some(false) | None,
    Some(true) | Some(false) | None,
    Some(true) | Some(false) | None,
    Some(true) | Some(false) | None,
    Some(true) | Some(false) | None,
    Some(true) | Some(false) | None,
    Some(true) | Some(false) | None,
    Some(true) | Some(false) | None,
  ) in xs { () }
}

# The Dawn formatter, in Dawn — a faithful port of dawn.fmt.Formatter
# (compiler/src/main/kotlin/dawn/fmt/Formatter.kt). A token-stream reformatter:
# re-lex the source (collecting comments), reprint tokens verbatim from
# their source spans, and normalize the whitespace between tokens — intra-line
# spacing, 2-space indentation, blank-line collapsing. The author's physical
# line breaks are preserved. The one token normalization drops the optional
# first sum-type bar on a single physical line; all other tokens survive.
# Formatting is idempotent and only needs a successful lex.
#
# "Only needs a successful lex" is a precondition, not a shrug: a character the
# lexer does not recognize produces a diagnostic and *no token*, and a token is
# the only thing reflow reprints, so anything the lexer skipped would be deleted
# from the output. `1 \ 2` formatted to `1 2`; `let a = 1; let b = 2` lost its
# semicolons. That is not a layout difference, it is silent source destruction,
# and every caller wrote the result back. So `format` returns the lexer's
# diagnostics instead of a string whenever there are any, and the precondition
# is enforced where it is stated rather than assumed.
#
# The Kotlin original keys its unary-minus and postfix-bang sets on Token
# object identity; here a token is identified by its span start (`lo`), which
# is unique per token in a file.

use std/str
use std/list
use std/set
use front/lexer
use front/token.{
  Token, TokKind, Diag,
  INT, CHAR, FLOAT, STRING, IDENT, TYPEIDENT, UNDERSCORE, NEWLINE, EOF, COMMENT,
  USE, ELSE, FN, FOR, IF, MATCH, WHILE, NOT, TRUE, FALSE, IMPL, EFFECT, TYPE, PUB,
  LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
  COMMA, COLON, DOT, DOTDOT, QUESTION, ARROW, FATARROW,
  EQ, EQEQ, NEQ, LT, LE, GT, GE,
  PLUS, MINUS, STAR, SLASH, PERCENT, PLUSPLUS, PIPEGT, PIPE,
  AMPAMP, PIPEPIPE, AMP, CARET, TILDE, SHL, SHR, USHR,
  BANG
}

## Reformat `source`, or report the lexer diagnostics that make reformatting
## unsafe. `Err` means the caller must leave the file exactly as it found it.
pub fn format(source: String) -> Result[String, List[Diag]] = {
  let (cps, raw, comments, diags) = lexer.lex_with_comments_cps(source)
  if len(diags) > 0 { return Err(diags) }
  let bars = single_line_type_bars(cps, raw)
  var code: List[Token] = []
  for t in raw {
    if t.kind != NEWLINE && t.kind != EOF && not set.has(bars, t.lo) { code = code ++ [t] }
  }
  let stream = merge_by_lo(code, comments)
  if len(stream) == 0 { return Ok("") }
  let keywords = contextual_keywords(raw)
  let marks = Marks {
    unary: unary_minus(raw, keywords),
    postfix: postfix_bang(raw),
    keywords: keywords,
    signature: signature_arrows(raw)
  }
  Ok(reflow(cps, stream, marks, block_arrow(cps, raw)))
}

## Only a type declaration's optional first bar is redundant. Keep this a
## lexical recognition, not a parser precondition: incomplete editor buffers
## still format. Source spans settle physical lines because the lexer elides
## newlines after `=`/`|` and inside brackets. A constructor or derive on the
## next logical line also makes the declaration multiline.
fn single_line_type_bars(cps: List[Char], raw: List[Token]) -> Set[Int] = {
  var out: Set[Int] = set.empty()
  var i = 0
  var depth = 0
  while i < len(raw) {
    let k = raw[i].kind
    let opaque = i > 0 && raw[i - 1].kind == IDENT && raw[i - 1].text == "opaque"
    if k == TYPE && depth == 0 && not opaque {
      match single_line_type_bar(cps, raw, i) {
        Some(lo) -> { out = set.insert(out, lo) }
        None -> ()
      }
    }
    if k == LPAREN || k == LBRACKET || k == LBRACE { depth = depth + 1 }
    if k == RPAREN || k == RBRACKET || k == RBRACE { depth = depth - 1 }
    i = i + 1
  }
  out
}

fn single_line_type_bar(cps: List[Char], raw: List[Token], start: Int) -> Option[Int] = {
  var i = start + 1
  if i >= len(raw) || raw[i].kind != TYPEIDENT { return None }
  i = i + 1
  if i < len(raw) && raw[i].kind == LBRACKET {
    var depth = 1
    i = i + 1
    while i < len(raw) && depth > 0 {
      if raw[i].kind == LBRACKET { depth = depth + 1 }
      if raw[i].kind == RBRACKET { depth = depth - 1 }
      i = i + 1
    }
    if depth != 0 { return None }
  }
  if i + 2 >= len(raw) || raw[i].kind != EQ || raw[i + 1].kind != PIPE ||
    raw[i + 2].kind != TYPEIDENT { return None }
  let bar = raw[i + 1].lo
  i = i + 2
  var depth = 0
  while i < len(raw) && raw[i].kind != EOF && raw[i].kind != NEWLINE {
    let k = raw[i].kind
    if k == LPAREN || k == LBRACKET || k == LBRACE { depth = depth + 1 }
    if k == RPAREN || k == RBRACKET || k == RBRACE { depth = depth - 1 }
    i = i + 1
  }
  if depth != 0 { return None }
  var next = i
  while next < len(raw) && raw[next].kind == NEWLINE { next = next + 1 }
  if next < len(raw) && (raw[next].kind == PIPE ||
      (raw[next].kind == IDENT && raw[next].text == "derive")) { return None }
  let (_, lines) = count_to(cps, raw[start].lo, raw[i - 1].hi)
  if lines == 0 { Some(bar) } else { None }
}

## The two token channels interleaved by span start. Both arrive ascending by
## `lo` -- the lexer emits in source order and the comment sink is filled from
## the same loop -- and no two spans overlap, so a linear merge is enough and
## there are no ties for a stable sort to have to break. This was `sort_by` over
## the concatenation, which paid O(n log n) comparisons to rediscover an order
## both inputs already had.
fn merge_by_lo(code: List[Token], comments: List[Token]) -> List[Token] = {
  var out: List[Token] = []
  var i = 0
  var j = 0
  while i < len(code) && j < len(comments) {
    if code[i].lo <= comments[j].lo {
      out = out ++ [code[i]]
      i = i + 1
    } else {
      out = out ++ [comments[j]]
      j = j + 1
    }
  }
  while i < len(code) {
    out = out ++ [code[i]]
    i = i + 1
  }
  while j < len(comments) {
    out = out ++ [comments[j]]
    j = j + 1
  }
  out
}

## Span starts of FATARROW tokens that end a brace-block's head line -- the
## tail block's parameter head, `f(xs) { x =>` (spec §4.3). Same family as
## `unary_minus`: a token-level fact the spacing pass needs.
##
## Without this the `=>` hits `is_cont_ender` and the next line is read as a
## continuation, +1 level -- and the line after that, not a continuation,
## steps back, so the block body comes out staggered. The head's `=>` is not
## continued by the body: the body follows the *block*, like the statements
## after any `{`. The test is whether the innermost still-open bracket at the
## arrow is a brace opened on the arrow's own line; a handler arm's `op(a) =>`
## does not qualify (its brace opened on the `with handle` line above), and a
## wrapped lambda body `map(xs, x =>` does not either (innermost opener is a
## paren).
##
## A head written on the line after its brace (`map(xs) {` then `(x: Int) =>`)
## is still the head, and its body still follows the block (#535): before, the
## first body line took the arrow's continuation level and the next one stepped
## back to the block's. So an arrow also qualifies when the tokens between the
## innermost brace and it are the head `parser.tail_block_lambda` reads there,
## a name or one parenthesised group, and the brace stands where the parser
## takes a tail block: right after a call's `)` or a name, and not as the body
## of an `if`/`match`/`while`/`for` header. That brace opens a plain block, and
## in `if c {` then `req =>` the block's value is a lambda whose body continues
## the arrow. A handler arm (`op(a) =>`) is a name *and* a group, so no head.
##
## Lines are counted from the *source*, not from NEWLINE tokens: the lexer
## swallows the NEWLINE after every line-continuing token (`{`, `,`, `=>`
## themselves -- lexer.continues_line), so the token stream cannot say which
## line a brace was opened on. Spans are code-point indices and the tokens are
## in order, so one cursor pass answers it. The code points come from the lexer
## (`lex_with_comments_cps`) rather than from a `code_points(src)` of its own:
## this pass, `reflow` and the lex itself all want the same array, and decoding
## the file once per pass made `format` decode it three times.
fn block_arrow(cps: List[Char], raw: List[Token]) -> Set[Int] = {
  var out: Set[Int] = set.empty()
  var opener_kinds: List[TokKind] = []
  var opener_lines: List[Int] = []
  # the index of each open brace that stands in tail position, else -1
  var opener_at: List[Int] = []
  # the bracket depth of an `if`/`match`/`while`/`for` whose body brace has not
  # opened yet, else -1
  var header_depth = -1
  var line = 0
  var cur = 0
  var i = 0
  while i < len(raw) {
    let t = raw[i]
    while cur < t.lo && cur < len(cps) {
      if cps[cur] == '\n' { line = line + 1 }
      cur = cur + 1
    }
    let k = t.kind
    if k == IF || k == MATCH || k == WHILE || k == FOR {
      header_depth = len(opener_kinds)
    }
    if k == LPAREN || k == LBRACKET || k == LBRACE {
      let header = k == LBRACE && header_depth == len(opener_kinds)
      if header { header_depth = -1 }
      let tail = k == LBRACE && not header && i > 0 &&
        (raw[i - 1].kind == RPAREN || raw[i - 1].kind == IDENT)
      opener_kinds = opener_kinds ++ [k]
      opener_lines = opener_lines ++ [line]
      opener_at = opener_at ++ [if tail { i } else { -1 }]
    } else if k == RPAREN || k == RBRACKET || k == RBRACE {
      if len(opener_kinds) > 0 {
        opener_kinds = list.take(opener_kinds, len(opener_kinds) - 1)
        opener_lines = list.take(opener_lines, len(opener_lines) - 1)
        opener_at = list.take(opener_at, len(opener_at) - 1)
      }
    } else if k == FATARROW && len(opener_kinds) > 0 {
      let top = len(opener_kinds) - 1
      if opener_kinds[top] == LBRACE &&
        (opener_lines[top] == line ||
            (opener_at[top] >= 0 && is_block_head(raw, opener_at[top], i))) {
        out = set.insert(out, t.lo)
      }
    }
    i = i + 1
  }
  out
}

## Whether `raw[brace + 1 .. arrow - 1]` is a tail block's parameter head: one
## name, or one parenthesised group closed right before the arrow.
fn is_block_head(raw: List[Token], brace: Int, arrow: Int) -> Bool = {
  let first = brace + 1
  if arrow == first + 1 && raw[first].kind == IDENT { return true }
  if raw[first].kind != LPAREN || raw[arrow - 1].kind != RPAREN { return false }
  var depth = 0
  var j = first
  while j < arrow {
    let k = raw[j].kind
    if k == LPAREN || k == LBRACKET || k == LBRACE { depth = depth + 1 }
    if k == RPAREN || k == RBRACKET || k == RBRACE {
      depth = depth - 1
      if depth == 0 { return j == arrow - 1 }
    }
    j = j + 1
  }
  false
}

## Span starts of MINUS tokens that are unary (prefix), so they hug the
## following operand.
##
## Over the *raw* tokens, the same as `postfix_bang` and for the same reason: a
## NEWLINE is the evidence, and the NEWLINE-filtered list threw it away. `-` is
## one of the two operators that cannot lead a continuation line (the other is
## `+`; parser.lead_op excludes the arithmetic pair because a leading `-` is
## ambiguous with this very thing), so a `-` after a NEWLINE opens a statement
## and is prefix -- no matter that the line above ended in a value.
##
## Filtered, `print(a)` and a following line `-1` looked adjacent, so the `-`
## was read as the subtraction it would have been on one line. That cost two
## things at once: the spacing (`- 1`) and, through `is_continuation`, an
## indent, so the statement was printed as a continuation of the line above it.
##
## A contextual keyword in its position (`keywords`, from
## `contextual_keywords`) is a keyword, not the name the lexer handed over, so
## it ends no value: `for x in -1..1` negates, it does not subtract (#534).
## And a `}` on the same line does end one: a block, an `if` or a `match` is an
## operand like any other, so `{ ... } -x` subtracts. `}` stays out of
## `is_value_end`, whose other callers space a bracket or a `..` after it.
fn unary_minus(raw: List[Token], keywords: Set[Int]) -> Set[Int] = {
  var out: Set[Int] = set.empty()
  var i = 0
  while i < len(raw) {
    if raw[i].kind == MINUS {
      let left = if i > 0 { raw[i - 1] } else { raw[i] }
      let after_value = i > 0 && (left.kind == RBRACE ||
          (is_value_end(left.kind) && not set.has(keywords, left.lo)))
      if not after_value { out = set.insert(out, raw[i].lo) }
    }
    i = i + 1
  }
  out
}

## Span starts of BANG tokens that are the postfix unwrap (`x!`) rather than an
## effect marker (`-> T !io`). What tells them apart is what comes next: an
## effect marker names an effect (`!io`) or unions them (`!(e1 | e2)`), while
## postfix `!` can be followed by neither. Classified over the raw token list
## because NEWLINE is the separator that proves `foo()!` ends a line.
fn postfix_bang(raw: List[Token]) -> Set[Int] = {
  var out: Set[Int] = set.empty()
  var i = 0
  while i < len(raw) {
    if raw[i].kind == BANG {
      # `!()` is the empty row wherever a row is spellable (spec §6.6): after
      # an `effect NAME =` prefix -- an impl's binding or a trait member's
      # default (刀 5, #369), one classification -- and after the result type
      # of a signature or a function type (#187). Everywhere else it is the
      # postfix unwrap plus an empty call (`o!()`, `opts[0]!()`), and the two
      # spellings are the same three tokens, so only the left context can say.
      let empty_row =
        i + 2 < len(raw) && raw[i + 1].kind == LPAREN && raw[i + 2].kind == RPAREN &&
        ((i >= 3 && raw[i - 1].kind == EQ && raw[i - 2].kind == TYPEIDENT &&
            raw[i - 3].kind == EFFECT) || after_result_type(raw, i))
      let names_effect =
        i + 1 < len(raw) &&
        (is_effect_name(raw[i + 1].kind) ||
            (raw[i + 1].kind == LPAREN && is_effect_union(raw, i + 2)) ||
            empty_row)
      if not names_effect { out = set.insert(out, raw[i].lo) }
    }
    i = i + 1
  }
  out
}

## Whether the `!` at `bang` directly follows the result type of a signature or
## a function type, where a row belongs (`fn f() -> Int !()`,
## `h: fn(Int) -> Int !()`). Walks left over the result type at bracket depth 0
## to its `->`, then asks whether that arrow is a signature's: the `)` before it
## closes a parameter list, whose `(` follows the function's name, `fn` (a
## function type) or `]` (a type parameter list).
##
## A type is spelled with TYPEIDENT, `m.` qualifiers, brackets, commas, `fn`,
## arrows and rows, so anything else on the way (`=`, a lowercase call
## `f(a)`) ends the walk with no. A match arm's `->` fails the arrow test:
## its left side is a pattern, and a `)` there closes a constructor pattern
## (`Some(x) ->`), whose `(` follows a TYPEIDENT. The residue is an arm whose
## guard ends in a lowercase call and whose body is exactly `C!()`
## (`P if ok(x) -> None!()`), which reads as a row; it only moves a space.
fn after_result_type(raw: List[Token], bang: Int) -> Bool = {
  if bang < 1 { return false }
  let last = raw[bang - 1].kind
  if last != TYPEIDENT && last != RBRACKET && last != RPAREN { return false }
  var j = bang - 1
  var depth = 0
  while j >= 0 {
    let k = raw[j].kind
    if k == ARROW && depth == 0 { return is_signature_arrow(raw, j) }
    if k == RPAREN || k == RBRACKET {
      depth = depth + 1
    } else if k == LPAREN || k == LBRACKET {
      if depth == 0 { return false }
      depth = depth - 1
    } else if k == NEWLINE {
      if depth == 0 { return false }
    } else if k == IDENT {
      # a qualifier (`m.T`) anywhere; a bare name only inside brackets (an
      # effect name in a nested row, `fn() -> Int !(io | e)`)
      let qualifier = j + 1 < len(raw) && raw[j + 1].kind == DOT
      if depth == 0 && not qualifier { return false }
    } else if not is_type_token(k) {
      return false
    }
    j = j - 1
  }
  false
}

## The remaining tokens a type or a row inside one is spelled with.
fn is_type_token(k: TokKind) -> Bool =
  k == TYPEIDENT || k == DOT || k == COMMA || k == FN || k == ARROW || k == BANG || k == PIPE

## Whether the `->` at `arrow` is a signature's or a function type's: the token
## before it is the `)` of a parameter list whose `(` follows a name, `fn` or
## the `]` of a type parameter list.
fn is_signature_arrow(raw: List[Token], arrow: Int) -> Bool = {
  if arrow < 1 || raw[arrow - 1].kind != RPAREN { return false }
  var j = arrow - 1
  var depth = 0
  while j >= 0 {
    let k = raw[j].kind
    if k == RPAREN || k == RBRACKET || k == RBRACE {
      depth = depth + 1
    } else if k == LPAREN || k == LBRACKET || k == LBRACE {
      depth = depth - 1
      if depth == 0 {
        if k != LPAREN || j < 1 { return false }
        let before = raw[j - 1].kind
        return before == IDENT || before == FN || before == RBRACKET
      }
    }
    j = j - 1
  }
  false
}

## `!io`, `!e`, `!Ask`. A declared effect is spelled with its own (uppercase)
## name, so TYPEIDENT names an effect too -- without this the formatter reads
## `-> Int !Ask` as the postfix unwrap `Int!` and moves the space to the wrong
## side of the `!`.
fn is_effect_name(k: TokKind) -> Bool = k == IDENT || k == TYPEIDENT

## Whether the `(` a `!` opened holds an effect union rather than a call's
## arguments. `LPAREN` alone used to answer yes, which made every `o!(1)` an
## effect marker and printed it `o !(1)` -- the space on the side that says
## "effect", for an expression that is a postfix unwrap and a call.
##
## The grammar decides it wherever it can: a union is effect names separated by
## `|` and nothing else (parser.effect_group over parser.effect_atom), so
## `!(1)`, `!()`, `!(f(x))` and `!(a, b)` cannot be one. `!(g)` -- a single bare
## name -- is a legal union *and* a legal one-argument call, and stays read as
## the union, which is what it was before this function existed. That residue
## is the grammar's ambiguity, not a gap here, and a formatter that only lexes
## cannot close it.
##
## NEWLINE is skipped rather than treated as the end: a union wrapped across
## lines is still a union, and reading it as a call would move a space in code
## that is not what it looked like.
fn is_effect_union(raw: List[Token], start: Int) -> Bool = {
  var i = start
  var want_name = true
  while i < len(raw) {
    let k = raw[i].kind
    if k == NEWLINE {
      i = i + 1
    } else if want_name {
      if not is_effect_name(k) { return false }
      want_name = false
      i = i + 1
      # a projection atom `S.E` (刀 5) is one name for this walk's purposes
      if i + 1 < len(raw) && raw[i].kind == DOT && raw[i + 1].kind == TYPEIDENT {
        i = i + 2
      }
    } else if k == PIPE {
      want_name = true
      i = i + 1
    } else {
      return k == RPAREN
    }
  }
  false
}

## The token-level facts `space` and `reflow` need, each a set of span starts:
## unary `-`, postfix `!`, the contextual keywords standing in their position,
## and the `->` arrows that end a parameter list.
type Marks = { unary: Set[Int], postfix: Set[Int], keywords: Set[Int], signature: Set[Int] }

## Span starts of the `->` arrows that end a signature's or a function type's
## parameter list (`is_signature_arrow`). A line wrapped after one of these
## continues the signature with its result type; it does not begin the body, so
## a `{` further along the wrapped line still belongs to the declaration. A
## match arm's `->` is not one: what follows it is a new expression.
fn signature_arrows(raw: List[Token]) -> Set[Int] = {
  var out: Set[Int] = set.empty()
  var i = 0
  while i < len(raw) {
    if raw[i].kind == ARROW && is_signature_arrow(raw, i) { out = set.insert(out, raw[i].lo) }
    i = i + 1
  }
  out
}

## Span starts of the contextual keywords (spec §1.4) that sit where they are
## keywords rather than names, for the two that can be followed by a bracket
## or a prefix minus (`assert -x < 0`, #588):
## the `in` of a `for` header -- the first `in` at the `for`'s own bracket depth
## -- and an `assert` opening a line. The lexer hands both over as IDENT, and an
## identifier before `[` or `(` hugs it (`xs[0]`, `f(x)`), which would print
## `for x in[1, 2]`. The other contextual keywords are never followed by a
## bracket in their keyword position, so the ordinary rules already space them.
fn contextual_keywords(raw: List[Token]) -> Set[Int] = {
  var out: Set[Int] = set.empty()
  var depth = 0
  var for_depth = -1
  var i = 0
  while i < len(raw) {
    let t = raw[i]
    let k = t.kind
    if k == FOR {
      for_depth = depth
    } else if k == IDENT && t.text == "in" && depth == for_depth {
      out = set.insert(out, t.lo)
      for_depth = -1
    } else if k == IDENT && t.text == "assert" &&
      (i == 0 || raw[i - 1].kind == NEWLINE || raw[i - 1].kind == LBRACE) {
      out = set.insert(out, t.lo)
    }
    if k == LPAREN || k == LBRACKET || k == LBRACE { depth = depth + 1 }
    if k == RPAREN || k == RBRACKET || k == RBRACE { depth = depth - 1 }
    i = i + 1
  }
  out
}

## A still-open bracket: the indent (in levels) its closer aligns to, and whether
## it is a brace. The brace flag is what tells a *body* from a mid-expression
## bracket when `reflow` picks an anchor.
##
## `lat`/`ld` are the statement anchor (`logical_indent`, `logical_depth` in
## `reflow`) as it stood when the bracket opened; closing the bracket gives it
## back, because whatever the inside moved it to belongs to the inside (#545).
type Opener = { at: Int, brace: Bool, lat: Int, ld: Int }

## An `if` reflow has seen: the bracket depth it stands at and the indent of
## its line.
type IfAt = { depth: Int, at: Int }

fn reflow(cps: List[Char], toks: List[Token], marks: Marks, barrow: Set[Int]) -> String = {
  let unary = marks.unary
  var out: List[String] = []
  var openers: List[Opener] = []
  var line_indent = 0
  # The indent of the line the innermost construct began on, and the bracket depth
  # there. A `{` opening a body anchors to these rather than to the physical line
  # it sits on: in
  #
  #     match query(a,
  #       b) {
  #
  # the brace sits on the wrapped line, and anchoring the arms to it indented the
  # whole body one level too deep. The wrong answer was a stable fixpoint, so
  # `fmt --check` and the idempotence oracle both agreed with it -- it only
  # surfaced as "9 files are unformatted" in a repo whose files were right.
  #
  # The anchor moves where a statement or a new expression begins, never on a
  # line that only continues an operand (`if a &&` / `b {`, a signature wrapped
  # after `->`, a pattern after `|`): the brace there still opens the body of
  # what began a line further up (#532). And a line opening with a closer never
  # moves it: that line carries on what the bracket began, and closing the
  # bracket has already given back the anchor it found (#533, #545). Before, it
  # moved at the line's first token that is not a closer, so `) -> (` in a
  # wrapped signature made the `{` that ends it a statement body one level in.
  var logical_indent = 0
  var logical_depth = 0
  # the first token of the line the anchor last moved to
  var logical_first = toks[0].kind
  var anchor_pending = false
  var anchor_moves = false
  # The innermost `if`/`match`/`while`/`for` whose body brace has not opened
  # yet: the indent of the line its keyword is on, and the bracket depth there.
  # A header wrapped across lines continues that construct, so its lines step
  # in from the keyword's line, however that line was itself reached (`=` then
  # `if a &&` then `b {`), and its brace anchors there (#532). -1 is none.
  #
  # A header's own brackets can hold another header (`if (match (x) {` ... `}) {`,
  # a lambda body that is an `if`), whose brace opens first. So the pending headers
  # are a stack, innermost last: a brace at a header's depth closes that header
  # and the outer one is waiting again (#545).
  var hdrs: List[IfAt] = []
  # The `if` each still-open bracket depth last saw, innermost last. An `else` brace belongs to the `if` it follows, so
  # it anchors where that `if` did, even when the `else` sits on a line the
  # header was wrapped to; an `else if` is a new `if` on its own line.
  var ifs: List[IfAt] = []
  # The anchor of the parenthesis `)` last closed, and whether the `=>` just
  # seen stood right after it: a lambda `(a,` / `b) => {` whose parameters
  # wrapped. Its body follows the line the parameters began on, not the wrapped
  # line the arrow ended up on (#545).
  # whether the last `else` began its line
  var else_leads = false
  var rparen_at = 0
  var arrow_after_rparen = false
  var line_first = toks[0]
  var prev = toks[0]
  # Last *code* token seen, which is what decides whether a new line continues
  # the previous one. Tracked apart from `prev` so a comment on its own line is
  # transparent: a comment cannot end an expression, so the line after it
  # continues whatever the line before it did.
  var prev_code = toks[0]
  var have_prev_code = false
  # A single left-to-right cursor over the source's code points. Token spans are
  # sorted and non-overlapping, so we never rewind: reflow stays O(n) instead of
  # re-slicing the whole source per token (which made it O(n²), spec §1.8).
  #
  # Nothing between two tokens survives into the output except the number of
  # newlines in it, so the cursor counts instead of materializing: the gap and
  # the token span were each built into a string, one list cell per code point,
  # and the token's string was then discarded in favour of `t.text` -- see below.
  var cur_ci = 0
  var i = 0
  while i < len(toks) {
    let t = toks[i]
    # Advance to this token's start (counting the newlines in the gap since the
    # previous token), then across the token itself.
    let (gci, nl) = count_to(cps, cur_ci, t.lo)
    let (tci, _) = count_to(cps, gci, t.hi)
    cur_ci = tci
    # Every token reprints from `.text`, which for everything that can reach this
    # stream is the same string its span slices to -- comments included, since a
    # comment's text and its span both stop before the trailing whitespace. That
    # is an invariant of the lexer, not of this file, and it is not free: a lexer
    # that ever synthesized a token's text would silently rewrite the source
    # here. So it is stated and tested where it is established, by the "token
    # text is its source span" test in front/lexer.dawn.
    let ttext = t.text
    if i == 0 {
      out = out ++ [ttext]
    } else {
      if nl == 0 {
        let on_use_line = line_first.kind == USE
        if t.kind == COMMENT || space(prev, t, marks, on_use_line) {
          out = out ++ [" "]
        }
        out = out ++ [ttext]
      } else {
        line_first = t
        # collapse >=2 blank lines to 1
        out = out ++ [if nl >= 2 { "\n\n" } else { "\n" }]
        let pl = if have_prev_code { prev_code } else { prev }
        # a line-leading `|` in a brace is an alternative of a match arm's
        # pattern (the parser gives a line-leading bar to patterns alone), and
        # the alternatives line up with the arm instead of stepping in under
        # it; a bar in a bracket or at a declaration's `=` still continues
        let bracketed = len(openers) > 0
        let arm_bar = t.kind == PIPE && bracketed && openers[len(openers) - 1].brace &&
          not is_cont_ender(pl.kind, bracketed)
        let cont = not arm_bar && is_continuation(pl, t, unary, barrow, bracketed)
        while len(hdrs) > 0 && not cont && len(openers) <= hdrs[len(hdrs) - 1].depth {
          hdrs = list.take(hdrs, len(hdrs) - 1)
        }
        let in_header = len(hdrs) > 0 && hdrs[len(hdrs) - 1].depth == len(openers)
        let header_indent = if len(hdrs) > 0 { hdrs[len(hdrs) - 1].at } else { -1 }
        line_indent = indent_of(t, openers, line_indent, cont)
        if t.kind == ELSE {
          # a leading `else` lines up with the `if` it follows, not with the
          # line above, which a comment or a wrapped operand may have moved
          var k = len(ifs) - 1
          while k >= 0 && ifs[k].depth > len(openers) { k = k - 1 }
          if k >= 0 && ifs[k].depth == len(openers) { line_indent = ifs[k].at }
        }
        if cont && in_header && line_indent <= header_indent { line_indent = header_indent + 1 }
        let lvl = if line_indent < 0 { 0 } else { line_indent }
        out = out ++ [str.repeat("  ", lvl)]
        out = out ++ [ttext]
        anchor_pending = not is_closer(t.kind)
        # a `:` that ends a `let`/`var`/`const` line is its annotation's colon,
        # and the type on the next line is part of the same statement, so a `{`
        # after its `=` is that statement's body, not a new expression's
        let annotation = pl.kind == COLON && len(openers) == logical_depth &&
          (logical_first == LET || logical_first == VAR || logical_first == CONST)
        anchor_moves = not (cont && (annotation || continues_operand(pl, t, marks)))
      }
    }
    # A line with no `(`/`[` open above it begins a construct, even when it
    # continues the previous line: `fn f() =` then `match x {` is a wrapped
    # statement, and the arms follow the `match`, not the `fn`. A line inside
    # an unclosed `(` is mid-expression instead, and inherits the anchor.
    if anchor_pending && not is_closer(t.kind) {
      anchor_pending = false
      if anchor_moves && in_block(openers) {
        logical_indent = line_indent
        logical_depth = len(openers)
        logical_first = line_first.kind
      }
    }
    let headed = t.kind == IF || t.kind == MATCH || t.kind == WHILE || t.kind == FOR
    if headed {
      let d = len(openers)
      let top = if len(hdrs) > 0 { hdrs[len(hdrs) - 1].depth } else { -1 }
      let else_if = have_prev_code && prev_code.kind == ELSE
      if top == d && else_if { hdrs = list.take(hdrs, len(hdrs) - 1) }
      if top < d || else_if { hdrs = hdrs ++ [IfAt { depth: d, at: line_indent }] }
    }
    if t.kind == ELSE { else_leads = line_first.lo == t.lo }
    if t.kind == IF || t.kind == ELSE {
      let d = len(openers)
      while len(ifs) > 0 && ifs[len(ifs) - 1].depth > d { ifs = list.take(ifs, len(ifs) - 1) }
      let seen = len(ifs) > 0 && ifs[len(ifs) - 1].depth == d
      if t.kind == IF {
        # an `else if` that starts its line stays in its chain: the next `else`
        # lines up with the first `if`, not with the line this one was wrapped
        # to. After a `}` on the same line it is a new `if` on that line.
        let chained = seen && have_prev_code && prev_code.kind == ELSE && else_leads
        let at = if chained { ifs[len(ifs) - 1].at } else { line_indent }
        if seen { ifs = list.take(ifs, len(ifs) - 1) }
        ifs = ifs ++ [IfAt { depth: d, at: at }]
      } else if seen && (len(hdrs) == 0 || hdrs[len(hdrs) - 1].depth < d) {
        hdrs = hdrs ++ [IfAt { depth: d, at: ifs[len(ifs) - 1].at }]
      }
    }
    # a brace straight after a binary operator is a block operand, not the
    # header's body: a body brace follows the condition's last operand
    let operand = t.kind == LBRACE && have_prev_code &&
      (is_cont_starter(prev_code.kind) || prev_code.kind == NOT)
    let tail_brace = t.kind == LBRACE && have_prev_code &&
      (prev_code.kind == RPAREN || prev_code.kind == IDENT)
    let lambda_brace = t.kind == LBRACE && nl == 0 && arrow_after_rparen && have_prev_code &&
      prev_code.kind == FATARROW
    if t.kind == FATARROW {
      arrow_after_rparen = have_prev_code && prev_code.kind == RPAREN
    } else if t.kind != COMMENT {
      arrow_after_rparen = false
    }
    if t.kind != COMMENT {
      prev_code = t
      have_prev_code = true
    }
    if t.kind == LPAREN || t.kind == LBRACKET || t.kind == LBRACE {
      # A brace that closes no enclosing bracket since the logical line began is
      # this statement's body, and follows the statement. Anything else -- a
      # `(`/`[`, or a brace nested inside one (a closure argument, say) -- belongs
      # to the line it is written on.
      let header = t.kind == LBRACE && not operand && len(hdrs) > 0 &&
        hdrs[len(hdrs) - 1].depth == len(openers)
      let header_indent = if header { hdrs[len(hdrs) - 1].at } else { -1 }
      let body = t.kind == LBRACE && len(openers) == logical_depth
      openers = openers ++ [Opener {
        at: if header {
          header_indent
        } else if tail_brace || (operand && nl > 0) {
          line_indent
        } else if body {
          logical_indent
        } else if lambda_brace {
          rparen_at
        } else if operand && len(openers) > 0 && not openers[len(openers) - 1].brace {
          openers[len(openers) - 1].at
        } else {
          line_indent
        },
        brace: t.kind == LBRACE,
        lat: logical_indent,
        ld: logical_depth,
      }]
      if header { hdrs = list.take(hdrs, len(hdrs) - 1) }
    } else if t.kind == RPAREN || t.kind == RBRACKET || t.kind == RBRACE {
      if len(openers) > 0 {
        let inner = openers[len(openers) - 1]
        if t.kind == RPAREN { rparen_at = inner.at }
        logical_indent = inner.lat
        logical_depth = inner.ld
        openers = list.take(openers, len(openers) - 1)
      }
      while len(hdrs) > 0 && len(openers) < hdrs[len(hdrs) - 1].depth {
        hdrs = list.take(hdrs, len(hdrs) - 1)
      }
    }
    prev = t
    i = i + 1
  }
  "${join(out, "")}\n"
}

## Indent (2-space levels) for a line whose first token is `t`; the previous line
## sat at `prev_indent`, and `cont` says this line continues it.
fn indent_of(
  t: Token,
  openers: List[Opener],
  prev_indent: Int,
  cont: Bool
) -> Int = {
  let top = if len(openers) == 0 { -1 } else { openers[len(openers) - 1].at }
  let content = top + 1
  if is_closer(t.kind) {
    # align a leading closer with the indent its opener anchored to
    if len(openers) == 0 { 0 } else { top }
  } else if t.kind == ELSE {
    # A leading `else` lines up with its `if` rather than nesting under it.
    prev_indent
  } else if cont {
    content + 1
  } else {
    content
  }
}

## Whether a continuation line carries on an operand rather than beginning a new
## expression: the line above ended in a binary operator, `not`, `..` or a
## signature's `->`, or this line opens with a binary operator. After `=`, `<-`,
## `=>`, `:` or an arm's `->` a new expression begins, and a body brace on that
## line is its own construct's.
fn continues_operand(prev_line_last: Token, line_start: Token, marks: Marks) -> Bool =
  is_cont_starter(prev_line_last.kind) || prev_line_last.kind == NOT ||
  prev_line_last.kind == DOTDOT ||
  set.has(marks.signature, prev_line_last.lo) ||
  (is_cont_starter(line_start.kind) && not set.has(marks.unary, line_start.lo))

## Whether the innermost still-open bracket is a brace -- i.e. whether the next
## line sits in a statement list rather than inside a `(`/`[`.
fn in_block(openers: List[Opener]) -> Bool =
  len(openers) == 0 || openers[len(openers) - 1].brace

## A leading `-` means two different things: `a\n  - b` wraps a subtraction, so
## the second line is a continuation, while `{\n  -1\n}` opens an expression
## and is not. `unary` already tells them apart for spacing.
##
## A line ending in `..` is continued too, though the lexer does not continue
## it: outside brackets the lexer ends the line there and the parser refuses
## the `..`, so the case only arises inside a bracket, where the lexer drops
## every newline and leaves the joining to the parser. There a trailing `..`
## is a spread or range still waiting for its operand, or a rest pattern, whose
## next line opens with the closer and is placed by the closer rule (#537).
fn is_continuation(
  prev_line_last: Token,
  line_start: Token,
  unary: Set[Int],
  barrow: Set[Int],
  bracketed: Bool
) -> Bool =
  (is_cont_ender(prev_line_last.kind, bracketed) && not set.has(barrow, prev_line_last.lo)) ||
  prev_line_last.kind == DOTDOT ||
  (is_cont_starter(line_start.kind) && not set.has(unary, line_start.lo))

# ---- spacing between two tokens already known to be on the same line ----

fn space(prev: Token, cur: Token, marks: Marks, on_use_line: Bool) -> Bool = {
  let unary = marks.unary
  let postfix = marks.postfix
  let p = prev.kind
  let c = cur.kind
  # a contextual keyword in its position is spaced like the keyword it is:
  # `for x in [1, 2]`, `assert (a)`, not the call/index spacing an identifier
  # before a bracket would get
  if set.has(marks.keywords, prev.lo) { return true }
  # a module path prints tight: use greet/words.{Lang, greet} (spec §10.2)
  if on_use_line && (p == SLASH || c == SLASH || p == LBRACE || c == RBRACE) { return false }
  # openers hug what follows; closers/commas/colons/? hug what precedes
  if p == LPAREN || p == LBRACKET { return false }
  if c == RPAREN || c == RBRACKET { return false }
  if c == COMMA || c == COLON { return false }
  if c == QUESTION { return false }
  # postfix unwrap hugs its operand (`x!`); what follows it takes the normal
  # rules (`x! != y`, `x!.b()`), unlike the effect marker's tight `!io`
  if set.has(postfix, cur.lo) { return false }
  # member access and effect/attribute markers
  if p == DOT || c == DOT { return false }
  # `..` closes up on both sides when it is the range operator (`0..n`, spec
  # §777 and the tutorial), so only a token that ends a value pulls it left.
  # Its other roles are prefixes -- the record spread `{ ..base }`, the
  # list/constructor/record rest `[x, ..rest]`, and the list-literal element
  # spread `[a, ..xs]` (spec §4.11) -- where what precedes is an opener or a
  # comma, and the space there belongs to that token's rule. The element
  # spread needed no rule of its own for exactly that reason: it stands in a
  # position the two existing ones already covered.
  if p == DOTDOT { return false }
  if c == DOTDOT && is_value_end(p) { return false }
  if p == BANG && not set.has(postfix, prev.lo) { return false }
  # `~` is always prefix bitwise-not; it hugs its operand like unary `-`
  if p == TILDE { return false }
  # calls / indexing / generics: name(..), name[..], no space before the bracket
  if c == LPAREN && is_callable_before_paren(p) { return false }
  if c == LBRACKET && is_value_end(p) { return false }
  # a conditional impl carries its parameters right after the keyword --
  # `impl[T: Eq] Eq[List[T]]`, the way a fn's hug its name. IMPL is not in
  # is_value_end because it never ends a value; this is its own rule.
  if c == LBRACKET && p == IMPL { return false }
  # `pub(pkg)` is one modifier, spelled tight like a call; nothing else may
  # follow `pub` with a parenthesis (docs/package-visibility-design.md §三)
  if c == LPAREN && p == PUB { return false }
  # unary minus hugs its operand
  if set.has(unary, prev.lo) { return false }
  true
}

# ---- helpers ----

## Advance a cursor over `cps` from index `ci` up to code-point index `target`,
## returning the new index and how many newlines were crossed. Token spans are
## code-point indices, so this is one step per code point, and total work across
## a reflow is O(source length).
##
## The newline count is the whole of what `reflow` needs from the text between
## two tokens, so nothing is built: this replaced a version that assembled the
## stretch into a `String` (a list cell per code point) and then handed it to
## `len(str.split(s, "\n")) - 1`, which allocated a list of substrings to count
## the separators between them.
fn count_to(cps: List[Char], ci: Int, target: Int) -> (Int, Int) = {
  var i = ci
  var nl = 0
  while i < target && i < len(cps) {
    if cps[i] == '\n' { nl = nl + 1 }
    i = i + 1
  }
  (i, nl)
}

fn is_closer(k: TokKind) -> Bool = k == RPAREN || k == RBRACKET || k == RBRACE

# BANG ends a value the same way QUESTION does (`x!` unwraps): it keeps `x![0]`
# tight and makes the `-` in `x! - 1` binary. The effect marker never precedes
# `[` or `-`.
fn is_value_end(k: TokKind) -> Bool =
  k == IDENT || k == TYPEIDENT || k == INT || k == CHAR || k == FLOAT || k == STRING ||
  k == RPAREN || k == RBRACKET || k == TRUE || k == FALSE || k == QUESTION ||
  k == BANG || k == UNDERSCORE

# What the comment here used to say -- "only an identifier can be called, so a
# `(` after `!` is always the effect union" -- stopped being true when every
# application became one node: `o!(1)` and `{ g }(1)` both check today, and the
# formatter printed them `o !(1)` and `{ g } (1)`. BANG is safe to list because
# the effect marker never reaches this function: `p == BANG && not postfix`
# returns tight above, so a BANG that gets here is the postfix unwrap.
fn is_callable_before_paren(k: TokKind) -> Bool =
  k == IDENT || k == TYPEIDENT || k == RPAREN || k == RBRACKET || k == QUESTION ||
  k == FN || k == BANG || k == RBRACE

## Whether a line ending in `k` continues onto the next one, so the next line
## is indented one level further. The set is the lexer's (lexer.continues_line,
## spec §1.7) minus `fmt_exempt`, not a list of its own: it used to be a second
## hand-written copy, and the two drifted -- a trailing `|` (SYN-N10), then a
## trailing `:` (`let a:` then `Int = 6` parsed as one statement and printed as
## two, #188). Derived, a token the lexer starts continuing is indented here
## without anyone remembering to add it. `bracketed` says whether a bracket is
## open at the line's end.
fn is_cont_ender(k: TokKind, bracketed: Bool) -> Bool =
  lexer.continues_line(k) && not fmt_exempt(k, bracketed)

## The tokens the lexer continues a line after but the formatter does not add a
## continuation level for, each for its own reason.
fn fmt_exempt(k: TokKind, bracketed: Bool) -> Bool =
  match k {
    # the bracket stack (`openers` in reflow) already indents the lines inside
    # an opener one level in; a continuation level on top would double it
    LPAREN | LBRACKET | LBRACE -> true
    # a comma separates the items of the bracket it sits in, and those items
    # line up at that bracket's content indent rather than stepping in. With
    # no bracket open there are no such items and nothing indents the next
    # line, so there the comma continues like any other token the lexer joins:
    # `derive Show,` then `Ord` is one clause, and `Ord` at column 0 read as a
    # new declaration (#536)
    COMMA -> bracketed
    # never the last code token of a line: reflow's stream drops NEWLINE
    NEWLINE -> true
    _ -> false
  }

fn is_cont_starter(k: TokKind) -> Bool =
  k == PIPEGT || k == DOT || k == PIPE || k == PLUS || k == MINUS || k == STAR ||
  k == SLASH || k == PERCENT || k == PLUSPLUS || k == AMPAMP || k == PIPEPIPE ||
  k == AMP || k == CARET || k == SHL || k == SHR || k == USHR ||
  k == EQEQ || k == NEQ || k == LT || k == LE || k == GT || k == GE

## Test helper: the formatted text, or a failure naming the lexer diagnostics
## that stopped it. Every assertion below is about well-formed input; the
## refusal path has its own case.
fn fmt_of(source: String) -> String =
  match format(source) {
    Ok(s) -> s
    Err(ds) -> panic("expected a clean lex, got " ++ to_string(len(ds)) ++ " diagnostics")
  }

fn lexes(source: String) -> Bool =
  match format(source) {
    Ok(_) -> true
    Err(_) -> false
  }

test "a source the lexer cannot read whole is refused, not reprinted" {
  # Both of these once came back as a String, and every caller wrote it over
  # the file: `\` is not a Dawn token, so it produced a diagnostic and no
  # token, and `1 \ 2` reprinted as `1 2`. `;` is rejected with a message of
  # its own but is just as absent from the stream, so `let a = 1; let b = 2`
  # reprinted as two statements run together on one line.
  assert not lexes("fn f() -> Int = 1 \\ 2\n")
  assert not lexes("let a = 1; let b = 2\n")
  # The same shapes minus the offending character still format, so the refusal
  # is about what the lexer could not read and not about the surrounding text.
  assert lexes("fn f() -> Int = 1 + 2\n")
  assert lexes("let a = 1\nlet b = 2\n")
}

test "formatting is idempotent and fixes indentation" {
  let src = "fn f(x: Int) -> Int =\nmatch x {\n0 -> 1\n_ -> 2\n}\n"
  let once = fmt_of(src)
  assert once == "fn f(x: Int) -> Int =\n  match x {\n    0 -> 1\n    _ -> 2\n  }\n"
  assert fmt_of(once) == once
}

test "pub(pkg) prints as one tight modifier" {
  let src = "pub (pkg) fn g() -> Int = 1\npub(  pkg ) type T = { a: Int }\nfn pkg() -> Int = pkg2(pkg)\n"
  let want = "pub(pkg) fn g() -> Int = 1\npub(pkg) type T = { a: Int }\nfn pkg() -> Int = pkg2(pkg)\n"
  assert fmt_of(src) == want
  assert fmt_of(want) == want
}

test "single-line sum types omit only their optional first bar" {
  let src = "pub type Flag = | On | Off # keep | in comments\n" ++
    "type Tree[T] = | Leaf | Node(value: T, next: Tree[T])\n" ++
    "type Choice = | Left(value: Int) | Right derive Show\n"
  let want = "pub type Flag = On | Off # keep | in comments\n" ++
    "type Tree[T] = Leaf | Node(value: T, next: Tree[T])\n" ++
    "type Choice = Left(value: Int) | Right derive Show\n"
  assert fmt_of(src) == want
  assert fmt_of(want) == want
  assert fmt_of("type Flag = On | Off\n") == "type Flag = On | Off\n"
}

test "multiline sum types retain their first bar and physical layout" {
  for src in [
    "type Flag =\n  | On\n  | Off\n",
    "type Flag = | On\n  | Off\n",
    "type Flag = |\n  On\n",
    "type Tree[T] = | Node(\n  value: T,\n  next: Tree[T]\n)\n",
    "type Flag = | On\n# next constructor\n  | Off\n",
    "type Flag = | On\nderive Show\n",
    "type Tree[\n  T\n] = | Leaf | Node(value: T)\n",
  ] {
    let once = fmt_of(src)
    assert once == src
    assert fmt_of(once) == once
  }
  let other = "fn f(x: Int) -> Int !(Ask | Tell) = x\n" ++
    "let text = \"type Flag = | On\"\n"
  assert fmt_of(other) == other
}

test "single-line type boundaries do not consume the next declaration" {
  let src = "type First = | One\r\n" ++
    "type Second = | Two # trailing comment\r\n" ++
    "fn f() -> Int = {\r\n  1\r\n}\r\n" ++
    "type Last = | End"
  let want = "type First = One\n" ++
    "type Second = Two # trailing comment\n" ++
    "fn f() -> Int = {\n  1\n}\n" ++
    "type Last = End\n"
  assert fmt_of(src) == want
  assert fmt_of(want) == want
  assert fmt_of("type Item[T: Trait[Other[T]]] = | Item(value: T)\n") ==
    "type Item[T: Trait[Other[T]]] = Item(value: T)\n"
  for unchanged in [
    "type Flag = # comment\n  | On\n",
    "type Flag = | On # comment\n  | Off\n",
    "type Flag = | On\n# comment\nderive Show\n",
    "opaque type Flag = | On\n",
    "trait Item[T] {\n  type Value = | On\n}\n",
    "type Incomplete = |\n",
  ] {
    assert fmt_of(unchanged) == unchanged
  }
}

test "a multi-line or-pattern lines its bars up with the arm" {
  # a line-leading bar in a match body is an alternative, never a bitwise-or
  # continuation (the parser gives it to patterns alone), so it stands where
  # the arm stands instead of stepping in under it
  let src = "fn f(c: Choice) -> Int =\n" ++
    "  match c {\n" ++
    "    Left(x)\n" ++
    "      | Right(x) -> x\n" ++
    "    | Up\n" ++
    "        | Down -> 1\n" ++
    "    Other -> 0\n" ++
    "  }\n"
  let want = "fn f(c: Choice) -> Int =\n" ++
    "  match c {\n" ++
    "    Left(x)\n" ++
    "    | Right(x) -> x\n" ++
    "    | Up\n" ++
    "    | Down -> 1\n" ++
    "    Other -> 0\n" ++
    "  }\n"
  assert fmt_of(src) == want
  assert fmt_of(want) == want
  # inside a bracket, and at a declaration's `=`, a bar still continues
  let nested = "fn g(c: Choice) -> Int =\n  match c {\n    Some(A\n        | B) -> 1\n    _ -> 0\n  }\n"
  assert fmt_of(nested) == nested
  let decl = "type Flag =\n  | On\n  | Off\n"
  assert fmt_of(decl) == decl
  # a bitwise or wraps with its bar at the end of the line, and the next line
  # reads as the continuation it is (the lexer continues it: SYN-N10)
  let wrap = "fn f() -> Int = {\n  let a = 6 |\n    1\n  a\n}\n"
  assert fmt_of("fn f() -> Int = {\n  let a = 6 |\n  1\n  a\n}\n") == wrap
  assert fmt_of(wrap) == wrap
}

test "a trailing colon continues the line, as the lexer reads it" {
  # `let a:` then `Int = 6` is one statement to the lexer and the parser (the
  # annotation sits outside any bracket), so the type line is a continuation
  # and steps in (#188). It used to print at statement indentation, as if it
  # were a second statement.
  let want = "fn f() -> Int = {\n  let a:\n    Int = 6\n  a\n}\n"
  assert fmt_of("fn f() -> Int = {\n  let a:\n  Int = 6\n  a\n}\n") == want
  assert fmt_of(want) == want
  # inside a bracket, a value on the line after its field name is the name's
  # continuation too, one level in from the field
  let field = "fn g() -> P =\n  P(\n    reason:\n      \"r\",\n    code: 1\n  )\n"
  assert fmt_of("fn g() -> P =\n  P(\n    reason:\n    \"r\",\n    code: 1\n  )\n") == field
}

test "a trailing binary operator indents the line it continues" {
  # the pin for the derivation: every non-exempt token of the lexer's set is
  # a continuation here, so exempting one (say `+`) reds this
  let want = "fn f() -> Int = {\n  let a = 1 +\n    2\n  a\n}\n"
  assert fmt_of("fn f() -> Int = {\n  let a = 1 +\n  2\n  a\n}\n") == want
  assert fmt_of(want) == want
}

test "the formatter's continuation set is the lexer's minus its exemptions" {
  # every token kind the lexer produces from punctuation, plus NEWLINE
  let (toks, _) = lexer.lex(
    "+ - * / % ++ |> | && || & ^ << >> >>> == != < <= > >= , ( ) [ ] { } " ++
      "-> <- => = : . .. ? ! ~ not\nx"
  )
  assert len(toks) > 40
  for t in toks {
    let k = t.kind
    # derived, not a second list: disagreeing with the lexer needs an entry
    # in fmt_exempt
    for b in [true, false] {
      assert is_cont_ender(k, b) == (lexer.continues_line(k) && not fmt_exempt(k, b))
      # and no exemption is stale: each names a token the lexer continues
      assert not fmt_exempt(k, b) || lexer.continues_line(k)
    }
  }
}

test "a comment between the arrow and the body is transparent" {
  let src = "fn f(x: Int) -> Int =\n  match x {\n    0 -> 1\n    _ ->\n      # why\n      2\n  }\n"
  assert fmt_of(src) == src
}

test "a leading else aligns with its if" {
  let src = "fn f(b: Bool) -> Int =\n  if b { 1 }\n  else { 2 }\n"
  assert fmt_of(src) == src
}

test "qualified effect rows and handlers format idempotently" {
  let source = "fn f()->Int !(dep.Ask|T.E|io)={\nwith handle dep.Ask { ask()=>42 }\ndep.ask()\n}\n"
  let first = match format(source) { Ok(text) -> text, Err(_) -> panic("qualified effect format") }
  assert str.contains(first, "!(dep.Ask | T.E | io)")
  assert str.contains(first, "with handle dep.Ask")
  assert format(first) == Ok(first)
}

test "the associated-effect spellings keep their bang an effect marker" {
  # `!()` after an effect binding's `=` is the empty row, not a postfix unwrap
  # plus a call -- and only there: `o!()` in an expression stays tight.
  let bind = "impl P[A] {\n  effect E = !()\n  fn run(x: A) -> Int = x.v\n}\n"
  assert fmt_of(bind) == bind
  # the trait-side default (#369) is the same `effect NAME = !()` prefix, so
  # the classification covers it without a second key
  let deft = "trait P[T] {\n  effect E = !()\n  fn run(x: T) -> Int !T.E\n}\n"
  assert fmt_of(deft) == deft
  let post = "fn h(o: Option[fn() -> Int]) -> Int = o!()\n"
  assert fmt_of(post) == post
  # a projection atom inside a union is one effect name for the walk, so the
  # `!(` keeps the space that says "effect" rather than "call"
  let row = "fn g[T: P](x: T, f: fn() -> Int !e) -> Int !(e | T.E) = f()\n"
  assert fmt_of(row) == row
  let bare = "fn k[T: P](x: T) -> Int !T.E = run(x)\n"
  assert fmt_of(bare) == bare
}

test "a contextual keyword in its position is spaced as a keyword" {
  let src = "fn f(xs: List[Int]) -> Unit = {\n  for x in [1, 2] { () }\n  for (a, b) in (xs, xs) { () }\n" ++
    "  assert (true)\n  let in = xs\n  in[0]\n}\n"
  assert fmt_of(src) == src
  assert fmt_of("fn f() -> Unit = {\n  for x in[1] { () }\n}\n") ==
    "fn f() -> Unit = {\n  for x in [1] { () }\n}\n"
}

test "a dollar before a name is refused, not rewritten" {
  # v0.78.0 and v0.79.0 rewrote `$name` to `${name}` here; that migration is
  # gone, so the lexer's refusal reaches the caller like any other and the
  # file is left as it was, with the lexer's own diagnostic as the reason
  match format("fn f(a: String) -> String = \"\$a\"\n") {
    Ok(_) -> panic("a dollar before a name was reformatted")
    Err(ds) -> {
      assert len(ds) == 1
      assert ds[0].msg == "`\$` followed by a name is not an interpolation: `\$a`"
      assert ds[0].hint == "write `\${a}` to interpolate it, or `\\\$a` for a literal dollar sign"
    }
  }
  assert lexes("fn f(a: String) -> String = \"\${a}\"\n")
}

test "use paths print tight and unary minus hugs" {
  assert fmt_of("use std/list.{ take , drop }\n") == "use std/list.{take, drop}\n"
  let src = "fn f() -> Int = { -1 }\n"
  assert fmt_of(src) == src
}

## `..` is one token wearing five hats, and only the first is an infix operator.
## Pinning all of them here is what keeps "close the range up" from closing up a
## comma: the formatter had the tight-on-the-right half since the port, and
## adding the left half without a value-end guard prints `[x,..rest]`.
test "the range operator closes up and the spread and rest prefixes do not" {
  # `a..b` is what spec §5.4 and the tutorial write; the formatter printed
  # `0 ..n`, so the repository disagreed with both of its own documents.
  let r = "fn f(n: Int) -> Int = {\n  var s = 0\n  for i in 0..n { s = s + i }\n  s\n}\n"
  assert fmt_of(r) == r
  assert fmt_of("fn f(n: Int) -> Int = {\nvar s = 0\nfor i in 0 .. n { s = s+i }\ns\n}\n") == r
  # a call or an index ends a value too, so the operand can be either side
  let c = "fn g(xs: List[Int]) -> Int = {\n  for i in lo(xs)..len(xs) { use_it(i) }\n  0\n}\n"
  assert fmt_of(c) == c
  # A line-leading pattern pipe lines up the way a match pattern's does, with
  # the construct it continues. The formatter only sees tokens, so this also guards that it
  # does not invent a for-specific layout rule.
  let p = "fn each(xs: List[Bool]) -> Unit = {\n  for true\n  | false in xs { () }\n}\n"
  assert fmt_of(p) == p
  assert fmt_of(fmt_of(p)) == p
  # the record spread: the space belongs to the `{`, which is not a value end
  let s = "fn h(p: Point) -> Point = Point { ..p, y: 0 }\n"
  assert fmt_of(s) == s
  # the three rest patterns: the space belongs to the comma
  let l = "fn k(xs: List[Int]) -> Int =\n  match xs {\n    [x, ..rest] -> x + len(rest)\n" ++
    "    _ -> 0\n  }\n"
  assert fmt_of(l) == l
  # `..}` is the pre-existing right-hug (`p == DOTDOT`) meeting a brace, which
  # otherwise takes a space. Recorded as it is rather than quietly changed:
  # tightening the left side is SYN-18, the right side is nobody's finding yet.
  let n = "fn m(p: Pair) -> Int =\n  match p {\n    Pair(a, ..) -> a\n    Rec { a, ..} -> a\n  }\n"
  assert fmt_of(n) == n
}

## The list-literal element forms (spec §4.11) cost the formatter nothing, and
## this is the evidence rather than the claim: the spread lands where the rest
## pattern already put `..` -- after `[` or after a comma -- and a conditional
## element is an `if` expression, which needs no rule at an element position it
## does not need anywhere else. Written as a test because "we changed nothing"
## and "we did not look" produce the same diff.
test "the list element forms need no spacing rule of their own" {
  # one line: after `[` the spread hugs, after a comma it takes the comma's space
  let a = "fn a(xs: List[Int], c: Bool) -> List[Int] = [1, ..xs, if c { 2 }, 3]\n"
  assert fmt_of(a) == a
  assert fmt_of("fn a(xs: List[Int], c: Bool) -> List[Int] = [ 1 , .. xs , if c { 2 } , 3 ]\n") == a
  let b = "fn b(xs: List[Int]) -> List[Int] = [..xs]\n"
  assert fmt_of(b) == b
  # multi-line, trailing comma, an `else if` chain and a nested literal
  let m = "fn d(xs: List[Int], c: Bool) -> List[Int] = [\n  1,\n  ..xs,\n" ++
    "  if c { 2 } else if not c { 4 },\n  3,\n]\n"
  assert fmt_of(m) == m
  assert fmt_of(fmt_of(m)) == m
  let n = "fn e(xs: List[List[Int]]) -> List[List[Int]] = [[1], ..xs, if true { [2] }]\n"
  assert fmt_of(n) == n
  # a spread whose operand is itself an expression: `..` is still a prefix, and
  # the operator inside keeps its own spacing
  let o = "fn g(xs: List[Int]) -> List[Int] = [1, ..xs ++ xs]\n"
  assert fmt_of(o) == o
}

## A newline between two elements is a separator (spec §4.11), and the formatter
## has no opinion about which separator the author picked: it never turns commas
## into line breaks or line breaks into commas, and a literal mixing the two
## comes back mixed. What it does owe the new spelling is the *indent*, and the
## two line openers that could have got that wrong are the ones pinned below --
## `..` is not in `is_cont_starter` and `-` is classified by `unary_minus`, so
## an element line is a line opener rather than a continuation of the one above,
## which would have printed it one level too deep.
test "a newline-separated list keeps its own spelling" {
  let n = "fn a(xs: List[Int], c: Bool) -> List[Int] = [\n  1\n  ..xs\n" ++
    "  if c { 2 } else if not c { 4 }\n  3\n]\n"
  assert fmt_of(n) == n
  assert fmt_of(fmt_of(n)) == n
  # stripped of its indentation it comes back at element level, not staggered
  assert fmt_of("fn a(xs: List[Int], c: Bool) -> List[Int] = [\n1\n..xs\n" ++
      "if c { 2 } else if not c { 4 }\n3\n]\n") == n
  # the comma spelling is the author's too, and is not rewritten
  let c = "fn b(xs: List[Int]) -> List[Int] = [\n  1,\n  ..xs,\n  3,\n]\n"
  assert fmt_of(c) == c
  # nor is a literal that uses both separators
  let m = "fn c(xs: List[Int]) -> List[Int] = [\n  1, 2\n  ..xs\n  4,\n]\n"
  assert fmt_of(m) == m
  # a nested literal indents by its own bracket
  let d = "fn d(xs: List[List[Int]]) -> List[List[Int]] = [\n  [\n    1\n    2\n  ]\n  ..xs\n]\n"
  assert fmt_of(d) == d
  assert fmt_of(fmt_of(d)) == d
  # an element opening with `-` is a prefix minus opening a line, not the
  # subtraction the same two tokens would be on one line
  let e = "fn e(a: Int) -> List[Int] = [\n  a\n  -1\n]\n"
  assert fmt_of(e) == e
  # and an element that really is continued keeps the continuation's extra level
  let f = "fn f(xs: List[Int]) -> List[Int] = [\n  xs\n    |> id\n  xs\n]\n"
  assert fmt_of(f) == f
  assert fmt_of(fmt_of(f)) == f
}

## The two sugars are token-level to this file: `with`/`<-` and a tail block
## take the default spacing, and `<-` continues its line like `->` and `=` do.
## What is pinned here is that the defaults are the *right* answer, so nobody
## has to guess when reading `dawn fmt --check` output over code using them.
test "the with statement and tail blocks keep their spelling" {
  let w = "fn f(path: String) -> Unit !io = {\n  with h <- bracket(open(path), close)\n" ++
    "  write(h)\n}\n"
  assert fmt_of(w) == w
  assert fmt_of("fn f(path: String) -> Unit !io = {\nwith h <- bracket(open(path), close)\n" ++
      "write(h)\n}\n") == w

  # `<-` ends a line the way `=` does, so a wrapped header indents once
  let c = "fn f() -> Int !io = {\n  with h <-\n    bracket(open(\"p\"), close)\n  run(h)\n}\n"
  assert fmt_of(c) == c

  # a tail block is spaced off the call and its parameter head stays compact
  let t = "fn f(xs: List[Int]) -> List[Int] = map(xs) { (x: Int) => x + 1 }\n"
  assert fmt_of(t) == t
  assert fmt_of("fn f(xs: List[Int]) -> List[Int] = map(xs)  { ( x: Int ) => x+1 }\n") == t
}

## Both callees below type-check (`dawn check` on each is `ok`), so the space
## the formatter used to insert was not a hint that the code was wrong -- it
## was the formatter still believing the pre-application-node grammar.
test "an empty row after a signature's result type keeps its space" {
  # spec §6.6: `!()` is spellable wherever `!io` is (#187). It printed
  # `Int!()`, which reads as the postfix unwrap `Int!` and a call.
  let want = "fn f() -> Int !() = 1\n"
  assert fmt_of("fn f() -> Int!() = 1\n") == want
  assert fmt_of(want) == want
  # a type parameter list, a qualified and a generic result type
  let gen = "pub fn g[T](x: T) -> m.Box[T] !() = m.box(x)\n"
  assert fmt_of("pub fn g[T](x: T) -> m.Box[T]!() = m.box(x)\n") == gen
  let tup = "fn t() -> (Int, Int) !() = (1, 2)\n"
  assert fmt_of("fn t() -> (Int, Int)!() = (1, 2)\n") == tup
}

test "an empty row in a function type keeps its space" {
  let param = "fn k(h: fn(Int) -> Int !()) -> Int = h(1)\n"
  assert fmt_of("fn k(h: fn(Int) -> Int!()) -> Int = h(1)\n") == param
  assert fmt_of(param) == param
  # nested in a type argument, and a function type returning a function type
  let nest = "fn n(o: Option[fn() -> Int !()], f: fn() -> fn() -> Int !()) -> Int = 1\n"
  assert fmt_of("fn n(o: Option[fn() -> Int!()], f: fn() -> fn() -> Int!()) -> Int = 1\n") == nest
}

test "an empty row in a record field's function type keeps its space" {
  let want = "type T = { g: fn() -> Int !(), h: fn(Int) -> Unit !io }\n"
  assert fmt_of("type T = { g: fn() -> Int!(), h: fn(Int) -> Unit !io }\n") == want
  assert fmt_of(want) == want
}

test "an empty row in trait and impl members keeps its space" {
  let tr = "trait P[T] {\n  effect E = !()\n  fn run(x: T) -> Int !()\n}\n"
  assert fmt_of("trait P[T] {\n  effect E = !()\n  fn run(x: T) -> Int!()\n}\n") == tr
  let im = "impl P[A] {\n  effect E = !()\n  fn run(x: A) -> Int !() = x.v\n}\n"
  assert fmt_of("impl P[A] {\n  effect E = !()\n  fn run(x: A) -> Int!() = x.v\n}\n") == im
}

test "a postfix unwrap followed by an empty call stays tight" {
  # the same three tokens `! ( )` after a value: the left context is not a
  # result type, so these are the unwrap and a call, and stay `x!()`
  for src in [
    "fn u(o: Option[fn() -> Int]) -> Int = o!()\n",
    "fn u(opts: List[Option[fn() -> Int]]) -> Int = opts[0]!()\n",
    "fn u(f: fn() -> Option[fn() -> Int]) -> Int = f()!()\n",
    "fn u() -> Option[Int] = None!()\n",
    "fn u(o: Option[Int]) -> Int =\n  match o {\n    Some(x) -> None!()\n    _ -> Z!()\n  }\n",
  ] {
    assert fmt_of(src) == src
  }
}

test "a call hugs its callee even when the callee is not a name" {
  # postfix unwrap, then call. The effect marker keeps the other spelling:
  # `!(e1 | e2)` is tight on the left of `!`, and that is the branch above.
  let b = "fn a(o: Option[fn(Int) -> Int]) -> Int = o!(1)\n"
  assert fmt_of(b) == b
  assert fmt_of("fn a(o: Option[fn(Int) -> Int]) -> Int = o! (1)\n") == b
  let e = "fn s(f: fn() -> Unit !e1, g: fn() -> Unit !e2) -> Unit !(e1 | e2) = f()\n"
  assert fmt_of(e) == e
  # the union survives a line break inside it, and a declared effect's
  # uppercase name is a name like any other
  let u = "fn s(f: fn() -> Unit !e1) -> Unit !(e1 |\n    Ask) = f()\n"
  assert fmt_of(u) == u
  # neither of these can be a union, so both are calls
  let z = "fn c(o: Option[fn() -> Int]) -> Int = o!()\n"
  assert fmt_of(z) == z
  let m = "fn d(o: Option[fn(Int, Int) -> Int]) -> Int = o!(1, 2)\n"
  assert fmt_of(m) == m
  # a block is a callee too
  let r = "fn b(g: fn(Int) -> Int) -> Int = { g }(1)\n"
  assert fmt_of(r) == r
  assert fmt_of("fn b(g: fn(Int) -> Int) -> Int = { g } (1)\n") == r
}

test "a member call has one spelling whatever the case of its name" {
  # SYN-09 gave `Class.Member(args)` a second meaning -- a Java method call --
  # without giving it a second shape: it is still an application over a member
  # reference, and the formatter is not told which one the checker decided on.
  # So the two capitalizations print alike, and a member call cannot acquire a
  # layout of its own by being uppercase. The formatter itself was not touched;
  # this is the assertion that says so.
  let u = "fn f(x: Float) -> Float !io = Math.IEEEremainder(x, 3.0)\n"
  assert fmt_of(u) == u
  assert fmt_of(fmt_of(u)) == u
  let l = "fn f(x: Float) -> Float !io = Math.max(x, 3.0)\n"
  assert fmt_of(l) == l
  # a bare member reference is unchanged either way, with or without a receiver
  # that is itself a call
  let r = "fn f() -> Int !io = Integer.MAX_VALUE\n"
  assert fmt_of(r) == r
  let c = "fn f(b: StringBuilder) -> Int !io = b.LENGTH(1)\n"
  assert fmt_of(c) == c
  assert fmt_of("fn f(b: StringBuilder) -> Int !io = b.LENGTH (1)\n") == c
}

## The oracle here is parser.lead_op, not taste: `-` cannot lead a continuation
## line, so a `-` at the start of one opens a statement. Both halves of getting
## that wrong are pinned -- the space, and the indent that made a top-level
## statement look like it belonged to the line above.
test "a minus that opens a line is prefix, whatever the line above ended in" {
  let src = "fn h() -> Int !io = {\n  let a = 1\n  print(a)\n  -1\n}\n"
  assert fmt_of(src) == src
  # the same shape with the indentation stripped: it comes back at statement
  # level, not one in
  assert fmt_of("fn h() -> Int !io = {\nlet a = 1\nprint(a)\n-1\n}\n") == src
  # a line that ends in `-` really is continued, and the `-` there is binary.
  # The continuation sits one level in and does not stack, which is what it did
  # before this change too -- pinned so the two directions stay told apart.
  let c = "fn g(a: Int, b: Int) -> Int =\n  a -\n  b\n"
  assert fmt_of(c) == c
  # and on one line the same tokens are still a subtraction
  let o = "fn f(a: Int) -> Int = a - 1\n"
  assert fmt_of(o) == o
  assert fmt_of("fn f(a: Int) -> Int = a-1\n") == o
}

## The tail block (spec §4.3). The zero-parameter form needs no rule of its
## own -- `space()` already separates `column {` and `) {`, and reflow's body
## anchor already keeps a multi-line argument list's closing `) {` at the
## statement's level -- but that is a fact worth pinning, not assuming.
test "a tail block formats like the body it reads as" {
  let z = "fn f() -> Unit !io = {\n  column {\n    greeting(\"world\")\n    row {\n" ++
    "      button(\"ok\")\n    }\n  }\n  column(\n    align: Center,\n    gap: 12,\n" ++
    "  ) {\n    text(\"hi\")\n  }\n}\n"
  assert fmt_of(z) == z
  assert fmt_of("fn f() -> Unit !io = {\ncolumn {\ngreeting(\"world\")\nrow {\n" ++
      "button(\"ok\")\n}\n}\ncolumn(\nalign: Center,\ngap: 12,\n) {\ntext(\"hi\")\n}\n}\n") == z
}

## A parameter head's line-ending `=>` is not continued by the block body: the
## body follows the block, like the statements after any `{`. Without the
## `block_arrow` carve-out the first body line took a continuation indent and
## the second stepped back -- a staggered body, from a rule about wrapped
## binary expressions.
test "a tail block's parameter head does not stagger the body" {
  let src = "fn f(ys: List[Int]) -> Unit !io = {\n  let a = list.map(ys) { x =>\n" ++
    "    io.println(\"one\")\n    io.println(\"two\")\n  }\n  use_it(a)\n}\n"
  assert fmt_of(src) == src
  assert fmt_of("fn f(ys: List[Int]) -> Unit !io = {\nlet a = list.map(ys) { x =>\n" ++
      "io.println(\"one\")\nio.println(\"two\")\n}\nuse_it(a)\n}\n") == src
  # a handler arm's `=>` still continues its line: its brace opened a line up
  let h = "fn g() -> Int = {\n  with handle Ask {\n    ask() =>\n      42\n  }\n  ask()\n}\n"
  assert fmt_of(h) == h
}

test "a conditional impl's parameters hug the keyword" {
  let src = "impl[T: Eq] Eq[List[T]] {\n  fn eq(a: List[T], b: List[T]) -> Bool = true\n}\n"
  assert fmt_of(src) == src
  assert fmt_of("impl [T: Eq] Eq[List[T]] {\n}\n") == "impl[T: Eq] Eq[List[T]] {\n}\n"
}

## The three shapes where a body's `{` lands on a wrapped line. Each is written
## here the way it should come out, and asserted from *both* directions: left
## alone when already right, and recovered from a copy with the indentation
## stripped. The first check is the one that matters -- the bug these pin
## produced a *stable* wrong answer, so idempotence and `--check` both endorsed
## it, and only "is this specific shape correct" could tell.
test "a body under a wrapped header keeps the header's level" {
  # subject wraps: the arms follow the `match`, not the continuation line
  let m = "fn f(x: Int) -> Int =\n  match g(x,\n    x) {\n    0 -> 1\n    _ -> 2\n  }\n"
  assert fmt_of(m) == m
  assert fmt_of("fn f(x: Int) -> Int =\nmatch g(x,\nx) {\n0 -> 1\n_ -> 2\n}\n") == m

  # signature wraps: the body is one level in, not two (analyze.dawn's shape)
  let s = "fn h(\n  a: Int\n) -> Int = {\n  let y = a\n  y\n}\n"
  assert fmt_of(s) == s
  assert fmt_of("fn h(\na: Int\n) -> Int = {\nlet y = a\ny\n}\n") == s

  # but a brace *inside* an unclosed `(` still belongs to its own line: the
  # closure body is three levels in, under the lambda, not two under `map`.
  # Getting
  # the case above right by anchoring every brace to the construct broke this
  # one -- they need telling apart, so both directions are pinned.
  let c = "fn k(xs: List[Int]) -> List[Int] =\n  map(xs,\n    (x: Int) => {\n      x + 1\n    })\n"
  assert fmt_of(c) == c
  assert fmt_of("fn k(xs: List[Int]) -> List[Int] =\nmap(xs,\n(x: Int) => {\nx + 1\n})\n") == c
}

## #532: a header wrapped after an operator. The wrapped line continues the
## header; it does not begin the body, so the body sits one level inside the
## statement and the closing brace at the statement's column. The property
## checks (scripts/fmt-properties, rule (c)) found both shapes as stable fixed
## points, so each is pinned from both directions.
test "a body under a header wrapped after an operator follows the statement" {
  let i = "fn f(a: Bool, b: Bool) -> Int = {\n  if a &&\n    b {\n    1\n  } else {\n    2\n  }\n}\n"
  assert fmt_of(i) == i
  assert fmt_of("fn f(a: Bool, b: Bool) -> Int = {\nif a &&\nb {\n1\n} else {\n2\n}\n}\n") == i
  # the old answer, which was a fixed point, is now moved
  assert fmt_of("fn f(a: Bool, b: Bool) -> Int = {\n  if a &&\n    b {\n      1\n    } else {\n" ++
      "      2\n    }\n}\n") == i
  # a signature wrapped after its `->`: the result type continues the signature
  let s = "fn k(a: Int) ->\n  Int = {\n  a\n}\n"
  assert fmt_of(s) == s
  assert fmt_of("fn k(a: Int) ->\nInt = {\na\n}\n") == s
  # an or-pattern wrapped after `|`: the arm's body follows the arm
  let p = "fn m(x: T) -> Int =\n  match x {\n    A |\n      B -> {\n      1\n    }\n    _ -> 2\n  }\n"
  assert fmt_of(p) == p
  assert fmt_of("fn m(x: T) -> Int =\nmatch x {\nA |\nB -> {\n1\n}\n_ -> 2\n}\n") == p
  # an arm's `->` begins a new expression, so an `if` on the next line still
  # anchors its own body
  let a = "fn n(x: Int) -> Int =\n  match x {\n    _ ->\n      if x > 0 {\n        1\n      } else {\n" ++
    "        2\n      }\n  }\n"
  assert fmt_of(a) == a
  # a `match` on a signature's wrapped line owns the arms from its own line
  let w = "fn o(a: Int,\n  h: Option[Int]) -> Int = match h {\n    Some(x) -> x\n    None -> a\n  }\n"
  assert fmt_of(w) == w
}

## #532: a header that is itself on a continuation line. Continuations used to
## be one level past the bracket content whatever they continued, so `b {`
## landed at the `if`'s own column and read as its body.
test "a header wrapped twice steps in from the keyword's line" {
  let g = "fn g(a: Bool, b: Bool) -> Int =\n  if a &&\n    b {\n    1\n  } else {\n    2\n  }\n"
  assert fmt_of(g) == g
  assert fmt_of("fn g(a: Bool, b: Bool) -> Int =\n  if a &&\n  b {\n    1\n  } else {\n    2\n  }\n") == g
  # an operator chain that is no header keeps sharing one column
  let c = "fn h(a: Int, b: Int) -> Int =\n  a +\n  b\n"
  assert fmt_of(c) == c
}

## #533: a line that opens with a closing brace is weighed after that brace
## is popped. It used to refresh the body anchor with the brace still on the
## stack, and a record brace inside a later call matched the stale depth.
test "a closing brace line leaves no stale anchor behind" {
  let r = "fn f() -> Unit = [\n  S {\n  },\n  g(\n    S {\n      a: 1,\n    },\n  ),\n]\n"
  assert fmt_of(r) == r
  assert fmt_of("fn f() -> Unit = [\nS {\n},\ng(\nS {\na: 1,\n},\n),\n]\n") == r
  # `} else {` and `) {` still anchor where they did
  let e = "fn f(c: Bool) -> Int = {\n  if c {\n    1\n  } else {\n    2\n  }\n}\n"
  assert fmt_of(e) == e
  # an `else` left on a wrapped header line belongs to its `if`, and an
  # `else if` there is a new `if` on that line
  let w = "fn s(n: Int) -> Int =\n  if n <\n    0 { 1 } else {\n    2 }\n"
  assert fmt_of(w) == w
  let v = "fn s(n: Int) -> Int =\n  if n <\n    0 { 1 } else if n > 0 { 2 } else {\n      3 }\n"
  assert fmt_of(v) == v
}

## #534: `in` reaches the formatter as an IDENT, which ends a value, so the `-`
## after it was spaced as a subtraction. In a `for` header it is the keyword.
test "a minus after a for header's in is a negation" {
  let f = "fn f() -> Unit = {\n  for x in -1..1 { () }\n}\n"
  assert fmt_of(f) == f
  assert fmt_of("fn f() -> Unit = {\n  for x in - 1..1 { () }\n}\n") == f
  # a variable named `in` elsewhere is still a value
  let v = "fn g(in: Int) -> Int = in - 1\n"
  assert fmt_of(v) == v
  # and a closing brace ends one: the parser subtracts here
  let b = "fn h(c: Bool) -> Int = if c { 1 } else { 2 } - 3\n"
  assert fmt_of(b) == b
  assert fmt_of("fn h(c: Bool) -> Int = if c { 1 } else { 2 } -3\n") == b
}

## #535: a tail block's parameter head on the line after its brace is still the
## head, and the body follows the block as it does when the head shares the
## brace's line. The body's statements share one column.
test "a tail block's parameter head on its own line does not stagger the body" {
  let t = "fn f(xs: List[Int]) -> List[Int] = map(xs) {\n  (x: Int) =>\n  let y = x +\n" ++
    "    10\n  y\n}\n"
  assert fmt_of(t) == t
  assert fmt_of("fn f(xs: List[Int]) -> List[Int] = map(xs) {\n(x: Int) =>\nlet y = x +\n" ++
      "10\ny\n}\n") == t
  # the old answer, a fixed point, is moved
  assert fmt_of("fn f(xs: List[Int]) -> List[Int] = map(xs) {\n  (x: Int) =>\n    let y = x +\n" ++
      "    10\n  y\n}\n") == t
  # a one-name head the same
  let n = "fn f(xs: List[Int]) -> List[Int] = map(xs) {\n  x =>\n  x + 1\n}\n"
  assert fmt_of(n) == n
  # a handler arm is a name and a group, no head: its body still continues
  let h = "fn g() -> Int = {\n  with handle Ask {\n    ask() =>\n      42\n  }\n  ask()\n}\n"
  assert fmt_of(h) == h
  # an `if` body is a plain block, not a tail block: a lambda that is its
  # value keeps its body a continuation of the arrow
  let l = "fn k(c: Bool) -> fn(Int) -> Int =\n  if c {\n    x =>\n      x + 1\n  } else {\n" ++
    "    x => x\n  }\n"
  assert fmt_of(l) == l
}

## #536: with no bracket open, a trailing comma continues the line like any
## other token the lexer joins; inside a bracket the items still line up.
test "a comma outside brackets continues its line" {
  let d = "type T = A | B\nderive Show,\n  Ord\n"
  assert fmt_of(d) == d
  assert fmt_of("type T = A | B\nderive Show,\nOrd\n") == d
  let c = "fn f() -> List[Int] = [\n  1,\n  2,\n]\n"
  assert fmt_of(c) == c
}

## #537: a `..` that ends a line inside a bracket is still waiting for its
## operand, which is a continuation and not the next element.
test "the operand of a spread on the next line is a continuation" {
  let s = "fn f(xs: List[Int]) -> List[Int] = [\n  1,\n  ..\n    xs,\n]\n"
  assert fmt_of(s) == s
  assert fmt_of("fn f(xs: List[Int]) -> List[Int] = [\n1,\n..\nxs,\n]\n") == s
  # a rest pattern's closer still lines up with its opener
  let r = "fn k(xs: List[Int]) -> Int =\n  match xs {\n    [x, ..\n    ] -> x\n    _ -> 0\n  }\n"
  assert fmt_of(r) == r
}

## #545: the statement anchor is given back when a bracket closes. Arm lines
## inside a `match` that sits in an `if` header moved it to the arm's depth;
## after the header closed, a `{ {` whose depth happened to be the same took
## that stale anchor for its own statement's and printed the block one level
## too deep.
test "a bracket's close gives back the statement anchor it found" {
  let a = "fn f() -> Int = {\n  let v = (if (((1, 2) != match (3) {\n    x -> 1\n  })) { (if (false) { {\n    let a = 1\n    a\n  } } else { 3 }) } else { 4 })\n  v\n}\n"
  assert fmt_of(a) == a
  let b = "fn f() -> Int = {\nlet v = (if (((1, 2) != match (3) {\nx -> 1\n})) { (if (false) { {\nlet a = 1\na\n} } else { 3 }) } else { 4 })\nv\n}\n"
  assert fmt_of(b) == a
}

## #545: a line that opens with a closer carries on the construct the bracket
## began, so it does not start a statement. A signature wrapped inside its
## brackets put `) -> (` at the parameter level, and the anchor followed it, so
## the body of the function sat one level in.
test "a line that opens with a closer does not move the statement anchor" {
  let w = "pub fn w[T,\n  !e](\n    a: Int,\n    b: List[(\n      String,\n      String)]\n  ) -> (\n    T, Int) !e = {\n  let x = 1\n  x\n}\n"
  assert fmt_of(w) == w
  assert fmt_of("pub fn w[T,\n!e](\na: Int,\nb: List[(\nString,\nString)]\n) -> (\nT, Int) !e = {\nlet x = 1\nx\n}\n") == w
}

## #545: a lambda whose parameter list wrapped has its body follow the line the
## parameters began on. The arrow lands on the wrapped line, and the body used
## to step in from that one, a level too deep. A brace on a line of its own is
## the line's.
test "a lambda body follows the line its wrapped parameters began on" {
  let w = "fn f() -> Int = {\n  g(ps,\n    none, (acc,\n      p) => {\n    let r = h(p)\n    r\n  })\n}\n"
  assert fmt_of(w) == "fn f() -> Int = {\n  g(ps,\n    none, (acc,\n      p) => {\n      let r = h(p)\n      r\n    })\n}\n"
  let a = "fn f() -> Int = {\n  g(l, (\n    acc, k) => {\n      1\n    })\n}\n"
  assert fmt_of(a) == "fn f() -> Int = {\n  g(l, (\n    acc, k) => {\n    1\n  })\n}\n"
  let b = "fn f() -> Int = {\n  g(\n    () =>\n      {\n        1\n      })\n}\n"
  assert fmt_of(b) == b
}

## #545: a tail block starts a lambda at its brace, so its body follows the line
## the brace is on. With the call's arguments wrapped, that line is not the
## statement's, and the body used to step in from the statement.
test "a tail block's body follows the line its brace is on" {
  let w = "fn f() -> Int = {\n  let e = map(\n    xs) { x =>\n      let y = x\n      y\n    }\n  g(a,\n    b) {\n      s()\n    }\n  e\n}\n"
  assert fmt_of(w) == w
  assert fmt_of("fn f() -> Int = {\n  let e = map(\n    xs) { x =>\n    let y = x\n    y\n  }\n  g(a,\n    b) {\n    s()\n  }\n  e\n}\n") == w
  let o = "fn f() -> Int = {\n  xs.each { x =>\n    g(x)\n  }\n}\n"
  assert fmt_of(o) == o
}

## #545: a header can hold another header in its own brackets, and the inner
## brace opens first. With one pending slot the inner header was ignored and
## its body anchored to whatever line the brace sat on, so a condition written
## `if ((if (` / `c) { a } else {` / `b }))` printed the inner bodies at the
## wrong level, and a `match` in an `if` condition put its arms there too.
test "a header inside another header's brackets anchors its own body" {
  let n = "fn f() -> Int = {\n  let v =\n    (if ((if (\n      true) { false } else {\n      false })) { 1 } else { 2 })\n  v\n}\n"
  assert fmt_of(n) == n
  let m = "fn f() -> Int = {\n  if (match (\n    29) {\n    1 -> true\n    _ ->\n      false\n  }) { 3 } else { 4 }\n}\n"
  assert fmt_of(m) == m
  assert fmt_of("fn f() -> Int = {\nif (match (\n29) {\n1 -> true\n_ ->\nfalse\n}) { 3 } else { 4 }\n}\n") == m
}

## #545: after a binary operator a `{` opens a block operand, so it is not the
## header's body brace. Taking it for one anchored the operand's statements to
## the header and left them level with the brace that opens them.
test "a block operand in a header's condition anchors its own body" {
  let b = "fn f(rs: List[Int], i: Int) -> Int =\n  if i < len(rs) &&\n    {\n      let h = rs[i]\n      h < 3\n    } {\n    1\n  } else { 2 }\n"
  assert fmt_of(b) == b
  assert fmt_of("fn f(rs: List[Int], i: Int) -> Int =\nif i < len(rs) &&\n{\nlet h = rs[i]\nh < 3\n} {\n1\n} else { 2 }\n") == b
}

## #545: a leading `else` lines up with the `if` it follows. It took the indent
## of the line above, which is wrong after a comment (a comment line is placed
## by the brackets alone, column 0 here) and after an `else if` wrapped its condition.
test "a leading else lines up with its if past comments and wrapped chains" {
  let c = "fn j(d: String) -> Int =\n  if a(d) { 1 }\n  else if b(d,\n    \"D\") { 2 }\n# why\n  else { 3 }\n"
  assert fmt_of(c) == c
  assert fmt_of("fn j(d: String) -> Int =\n  if a(d) { 1 }\n  else if b(d,\n    \"D\") { 2 }\n# why\nelse { 3 }\n") == c
}

## #545: the `:` that ends a `let` line is the annotation's colon. The type on
## the next line belongs to the same statement, so the `{` after its `=` is
## that statement's body. Reading `:` as the start of a new expression
## anchored the body to the type's line, a level too deep.
test "a block after a wrapped let annotation follows the statement" {
  let a = "fn f(c: Bool) -> Bool = {\n  let v:\n    Bool = {\n    let a = 1\n    c\n  }\n  v\n}\n"
  assert fmt_of(a) == a
  assert fmt_of("fn f(c: Bool) -> Bool = {\nlet v:\nBool = {\nlet a = 1\nc\n}\nv\n}\n") == a
}

## #545: a block operand that ends a wrapped line inside brackets, `(a ++ [` /
## `b]) ++ {`, belongs to the expression the bracket opened, so its statements
## step in from the line that bracket is on and not from the continuation line
## the brace landed on.
test "a block operand inside brackets follows the bracket's line" {
  let o = "fn f(p: List[Int]) -> Int = {\n  let v: List[Int] = ((p ++ [\n    1]) ++ {\n    let b = 2\n    [b]\n  })\n  1\n}\n"
  assert fmt_of(o) == o
}

## #588: `assert` reaches the formatter as an IDENT, which ends a value, so a
## minus after it was spaced as a subtraction (`assert - x < 0`). `assert`
## opens an expression, so the minus is a negation. `return` is a real keyword
## token and already behaved.
test "a minus after assert is a negation" {
  let a = "fn f(x: Int, y: Float) -> Unit = {\n  assert -x < 0\n  assert -1e308 < y\n  assert x > -1\n  assert (x) > 0\n}\n"
  assert fmt_of(a) == a
  assert fmt_of("fn f(x: Int, y: Float) -> Unit = {\n  assert - x < 0\n  assert - 1e308 < y\n  assert x > -1\n  assert (x) > 0\n}\n") == a
  # a variable named `assert` elsewhere is still a value
  let v = "fn f(assert: Int) -> Int = assert - 1\n"
  assert fmt_of(v) == v
}

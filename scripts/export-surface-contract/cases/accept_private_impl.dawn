# A private trait and a private subject: the impl is not observable to anyone
# outside, so its associated binding may name a private type (design §四).
type Secret = | Secret
type Private = | Private

trait Hidden[T] {
  type Item
  fn item(x: T) -> T.Item
}

impl Hidden[Private] {
  type Item = Secret
  fn item(x: Private) -> Secret = Secret
}

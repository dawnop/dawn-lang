    id => None, id => Some(id + 30), id => None) == Some(Some([
      ReducedTypeEffects(TyAdt(11, []), [(31, TyAdt(12, []))], TyAdt(13, []))]))
  for missing in [1, 2, 3, 4] {
    assert project_with_locals(reads, s => None, t => if t == TyAdt(missing, []) { None } else { move(t) },
      id => None, e => None, (owner, source) => None, id => None,
      id => if missing == 4 { None } else { Some(id) }, id => None) == None
  }
}

test "semantic reads relocate effect reduction rows and ordered bindings" {
  let input = EffVar("e", 1)
  let answer = EffVar("f", 2)
  let reads = Some([ReducedEffect(input, [(1, TyAdt(1, [])), (2, TyInt)], answer)])
  let move: fn(Ty) -> Option[Ty] = t => match t { TyAdt(id, args) -> Some(TyAdt(id + 10, args)), _ -> Some(t) }
  let row: fn(Eff) -> Option[Eff] = e => match e { EffVar(n, id) -> Some(EffVar(n, id + 20)), _ -> None }
  assert project_with_locals(reads, s => None, move, id => None, row, (owner, source) => None,
    id => None, id => Some(id + 30), id => None) == Some(Some([
      ReducedEffect(EffVar("e", 21), [(31, TyAdt(11, [])), (32, TyInt)], EffVar("f", 22))]))
  for missing in [0, 1, 2, 3] {
    assert project_with_locals(reads, s => None, t => if missing == 0 { None } else { move(t) }, id => None,
      e => if (missing == 1 && e == input) || (missing == 2 && e == answer) { None } else { row(e) },
      (owner, source) => None, id => None, id => if missing == 3 { None } else { Some(id) }, id => None) == None
  }
}


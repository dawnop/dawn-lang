# Commands as data, the same discipline the widget tree and `Sub` already
# follow: a `Cmd` holds what should happen next, never a callback that makes it
# happen. `update` returns one alongside the new model, and the driver is the
# only thing that acts on it.
#
# Step one had one kind of command: another message. `SendMsg(msg)` means
# "fold this message too, in this same turn", which is enough to express the
# one shape applications were already hand-rolling before there was a channel
# for it -- an instruction that a later message clears, smuggled through the
# model because `update` had nowhere else to put it. `BatchCmd` sequences
# several, and `NoCmd` is the identity that a turn with nothing to say returns.
#
# Step two adds the first io arm, `Fetch(url, tag)`, and it is a description
# and nothing else: the guest says "get this, and call the answer `tag`", and
# the *host* does the getting. The old header ruled an io arm out because the
# driver would have to answer *after* the turn, on a wire with no op for it and
# through a re-entry `std/reactor`'s pure step callback forbids
# (docs/oneshot-design.md §6.1). What changes is that the answer is not a
# re-entry: it is the next turn. The host finishes the fetch on its own time,
# then sends a `supply` request carrying the tag and the outcome, which is an
# ordinary turn against whatever the model is by then. The guest never waits,
# so nothing here needs a suspended computation, and the transcript still
# replays identically on every backend because a supply is just one more line
# of input.
#
# The outcome is a `Result[String, String]` handed to the application's own
# function from (tag, outcome) to a message (`tea_dom/reactor`), and a failed
# request -- no network, a refused connection, a non-2xx status -- is an `Err`
# the application matches on, not a panic: whether a missing file is a
# degraded feature or a dead page is the application's call.
#
# `fold_msg` is the driver that has no host to ask. It folds the messages and
# refuses a turn that commanded a fetch, with a panic that names the arm,
# because the alternative -- dropping the command -- would leave an application
# waiting forever for an answer nobody was ever going to send. A driver that
# can fetch uses `fold_cmds` and gets the requests back beside the model.
#
# Why a synchronous fold rather than a queue the driver drains across turns.
# A turn is a function of its inputs on this boundary and a transcript has to
# replay identically on three backends; carrying commands between turns would
# put a second piece of state next to the model, which is exactly what the
# model text crossing the wire exists to avoid. So a command chain is finished
# before the reply is written, and `CMD_FOLD_LIMIT` is what keeps "finished"
# from meaning "never".

use std/list
use std/str

## What a turn asks for besides a new model.
##
## `NoCmd` is nothing, `SendMsg` is one more message for this turn, and
## `BatchCmd` is several commands in order. These are Elm's `Cmd.none`,
## `Cmd.msg` and `Cmd.batch`; the names differ because `None` is already
## `Option`'s and a constructor that shadows it in every importing module is
## not worth the resemblance.
##
## `Fetch(url, tag)` asks the host to GET `url` and to answer with a `supply`
## carrying `tag`, which the application's own function turns into a message
## for a *later* turn. The guest only describes the request; it is not run
## here and nothing about its answer is known in the turn that asked. `tag` is
## the application's name for the request (the same url may be asked for twice
## for different reasons) and is returned verbatim.
pub type Cmd[M] =
  | NoCmd
  | SendMsg(msg: M)
  | BatchCmd(cmds: List[Cmd[M]])
  | Fetch(url: String, tag: String)
derive Show

## One fetch a turn asked for, as the host receives it.
pub type FetchReq = { url: String, tag: String }
derive Show

## How many commanded messages one turn may fold before it is judged a loop.
##
## The bound is on the *total* messages a turn's commands add, not on how
## deeply they nest: a batch that fans out is the same runaway as a message
## that re-issues itself, and counting rounds would leave the first one
## unbounded. Sixty-four is far past any hand-written chain (the one client
## in tree issues a chain of length one) and far short of a wait a user would
## sit through.
pub const CMD_FOLD_LIMIT: Int = 64

## The messages a command asks for, left to right, batches flattened.
pub fn msgs[M](c: Cmd[M]) -> List[M] =
  match c {
    NoCmd -> []
    SendMsg(m) -> [m]
    Fetch(_, _) -> []
    BatchCmd(cs) -> {
      let empty: List[M] = []
      list.fold(cs, empty, (acc, inner) => acc ++ msgs(inner))
    }
  }

## The fetches a command asks for, left to right, batches flattened.
pub fn fetches[M](c: Cmd[M]) -> List[FetchReq] =
  match c {
    NoCmd -> []
    SendMsg(_) -> []
    Fetch(url, tag) -> [FetchReq { url: url, tag: tag }]
    BatchCmd(cs) -> {
      let empty: List[FetchReq] = []
      list.fold(cs, empty, (acc, inner) => acc ++ fetches(inner))
    }
  }

## Fold one message into the model, then everything its commands asked for,
## and answer the model the turn ends with.
##
## `step` is the application's `update`; a driver passes its own so that the
## fold is written once for every vocabulary rather than once per driver.
## A driver with no host to fetch for uses this one, and a turn that commanded
## a `Fetch` panics here (see the header).
pub fn fold_msg[Mo, M](m: Mo, msg: M, step: fn(Mo, M) -> (Mo, Cmd[M]) !e) -> Mo !e =
  fold_msgs(m, [msg], step)

## `fold_msg` for messages that arrive together, such as the timers a poll
## found due. The list is not itself commanded, so it does not count against
## `CMD_FOLD_LIMIT`; what the turn commands does.
pub fn fold_msgs[Mo, M](m: Mo, queue: List[M], step: fn(Mo, M) -> (Mo, Cmd[M]) !e) -> Mo !e = {
  let (next, wanted) = fold_cmds_all(m, queue, step)
  if len(wanted) > 0 {
    panic(
      "tea_core/cmd: this driver cannot run `Fetch` (asked for "
        ++ wanted[0].url
        ++ "); use cmd.fold_cmds in a driver that has a host",
    )
  } else {
    next
  }
}

## `fold_msg` for a driver that can fetch: the model the turn ends with, and
## every fetch its commands asked for, in the order they were asked.
pub fn fold_cmds[Mo, M](
  m: Mo,
  msg: M,
  step: fn(Mo, M) -> (Mo, Cmd[M]) !e,
) -> (Mo, List[FetchReq]) !e = fold_cmds_all(m, [msg], step)

fn fold_cmds_all[Mo, M](
  m: Mo,
  queue: List[M],
  step: fn(Mo, M) -> (Mo, Cmd[M]) !e,
) -> (Mo, List[FetchReq]) !e = {
  let none: List[FetchReq] = []
  drain(m, queue, 0, 0, none, step)
}

# The queue is first in, first out, and it grows at the end: a command's
# messages run after everything already waiting, which is what makes a batch's
# order the order it was written in and keeps one message's chain from cutting
# ahead of its siblings.
#
# `spent` counts only what commands added, messages and fetches alike: a turn
# that fans out a thousand fetches is the same runaway as one that fans out a
# thousand messages. Overrunning it is a panic and not a
# truncation because both alternatives to panicking lie: a truncated fold
# answers with a model no sequence of messages produces, and there is no field
# on this wire (nor any on the terminal's) in which a turn could report that it
# gave up. A panic lands at the driver's own barrier -- `tea_dom/reactor.serve`
# catches it and answers `{"ok":false,"kind":"panic",...}` while the host keeps
# the model it already had -- so a command loop is a visible failure of the
# turn rather than a quietly wrong document. `tea_term/runtime.run` has no such
# barrier and the session ends, which is what any panic in `update` already
# does there.
fn drain[Mo, M](
  m: Mo,
  q: List[M],
  i: Int,
  spent: Int,
  asked: List[FetchReq],
  step: fn(Mo, M) -> (Mo, Cmd[M]) !e,
) -> (Mo, List[FetchReq]) !e =
  if i >= len(q) {
    (m, asked)
  } else {
    let (next, c) = step(m, q[i])
    let more = msgs(c)
    let wanted = fetches(c)
    let now = spent + len(more) + len(wanted)
    if now > CMD_FOLD_LIMIT {
      panic(
        "tea_core/cmd: a turn's commands asked for more than "
          ++ to_string(CMD_FOLD_LIMIT)
          ++ " messages",
      )
    } else {
      drain(next, q ++ more, i + 1, now, asked ++ wanted, step)
    }
  }

# ---- tests -------------------------------------------------------------
#
# A counter whose messages can command other messages, because the smallest
# thing that pins a fold is an app where one message means two.

type Probe = { n: Int, log: String }

type ProbeMsg =
  | Bump
  | Twice
  | Both
  | Note(mark: String)
  | Spin
derive Show

fn probe_step(m: Probe, msg: ProbeMsg) -> (Probe, Cmd[ProbeMsg]) =
  match msg {
    Bump -> (Probe { ..m, n: m.n + 1 }, NoCmd)
    Twice -> (m, SendMsg(msg: Bump))
    Both -> (m, BatchCmd(cmds: [SendMsg(msg: Note(mark: "a")), SendMsg(msg: Note(mark: "b"))]))
    Note(mark) -> (Probe { ..m, log: m.log ++ mark }, NoCmd)
    # A message that re-issues itself: the one shape the limit exists for.
    Spin -> (Probe { ..m, n: m.n + 1 }, SendMsg(msg: Spin))
  }

fn blank() -> Probe = Probe { n: 0, log: "" }

test "a command-free turn is one update and nothing else" {
  assert fold_msg(blank(), Bump, probe_step) == Probe { n: 1, log: "" }
  let none: Cmd[ProbeMsg] = NoCmd
  assert msgs(none) == []
}

test "`SendMsg` is one more update in the same turn" {
  # `Twice` changes no field itself, so a model that moved is the fold moving
  # it: the commanded `Bump` ran and its result is what the turn answers.
  assert fold_msg(blank(), Twice, probe_step) == Probe { n: 1, log: "" }
}

test "a batch runs in the order it was written" {
  assert fold_msg(blank(), Both, probe_step) == Probe { n: 0, log: "ab" }
  assert msgs(BatchCmd(cmds: [SendMsg(msg: Note(mark: "a")), SendMsg(msg: Note(mark: "b"))]))
    == [Note(mark: "a"), Note(mark: "b")]
}

test "nested batches flatten left to right, and `NoCmd` is the identity" {
  let inner: Cmd[ProbeMsg] = BatchCmd(cmds: [SendMsg(msg: Bump), NoCmd])
  let outer: Cmd[ProbeMsg] = BatchCmd(cmds: [NoCmd, inner, SendMsg(msg: Note(mark: "z"))])
  assert msgs(outer) == [Bump, Note(mark: "z")]
  let empty: Cmd[ProbeMsg] = BatchCmd(cmds: [])
  assert msgs(empty) == []
}

test "messages that arrive together are folded in order, uncounted" {
  assert fold_msgs(blank(), [Note(mark: "x"), Bump, Note(mark: "y")], probe_step)
    == Probe { n: 1, log: "xy" }
  let nothing: List[ProbeMsg] = []
  assert fold_msgs(blank(), nothing, probe_step) == blank()
}

test "a chain shorter than the limit runs to its end and the model is the last one" {
  # The positive control for the bound: `CMD_FOLD_LIMIT` commanded messages is
  # allowed, so the counter reaches one more than that (the uncommanded first
  # `Spin` is not counted) and nothing panics.
  let m = fold_msg(blank(), Spin, spin_capped)
  assert m == Probe { n: CMD_FOLD_LIMIT + 1, log: "" }
}

# `Spin` stopped at the limit: the same runaway shape, cut off one message
# short of the panic so that the fold's own accounting is what is asserted.
fn spin_capped(m: Probe, msg: ProbeMsg) -> (Probe, Cmd[ProbeMsg]) =
  match msg {
    Spin ->
      if m.n >= CMD_FOLD_LIMIT {
        (Probe { ..m, n: m.n + 1 }, NoCmd)
      } else {
        (Probe { ..m, n: m.n + 1 }, SendMsg(msg: Spin))
      }
    _ -> probe_step(m, msg)
  }

test "a runaway chain panics rather than truncating" {
  match catch_panic(() => fold_msg(blank(), Spin, probe_step)) {
    Ok(_) -> { assert false }
    Err(e) -> {
      # the message ends with where the panic is written (spec 8.2)
      assert str.starts_with(e.message,
        "tea_core/cmd: a turn's commands asked for more than 64 messages at ")
    }
  }
}

test "the limit counts every commanded message, batch fan-out included" {
  # One turn, one command, `CMD_FOLD_LIMIT + 1` messages in it: a bound on
  # nesting depth would call this depth 1 and let it through.
  match catch_panic(() => fold_msg(blank(), Bump, fan_out)) {
    Ok(_) -> { assert false }
    Err(e) -> {
      # the message ends with where the panic is written (spec 8.2)
      assert str.starts_with(e.message,
        "tea_core/cmd: a turn's commands asked for more than 64 messages at ")
    }
  }
  # And one message under the limit is allowed, which is what says the
  # comparison is on the count and not on the shape.
  assert fold_msg(blank(), Bump, fan_out_ok) == Probe { n: 1, log: "" }
}

fn notes(n: Int) -> List[Cmd[ProbeMsg]] = {
  let empty: List[Cmd[ProbeMsg]] = []
  notes_go(0, n, empty)
}

fn notes_go(i: Int, n: Int, acc: List[Cmd[ProbeMsg]]) -> List[Cmd[ProbeMsg]] =
  if i >= n { acc } else { notes_go(i + 1, n, acc ++ [SendMsg(msg: Note(mark: ""))]) }

# Both fan out on the first message only: what is under test is the count one
# command contributes, and a step that fanned out on every message would be a
# runaway rather than a wide batch.
fn fan_out(m: Probe, msg: ProbeMsg) -> (Probe, Cmd[ProbeMsg]) =
  match msg {
    Bump -> (m, BatchCmd(cmds: notes(CMD_FOLD_LIMIT + 1)))
    _ -> probe_step(m, msg)
  }

fn fan_out_ok(m: Probe, msg: ProbeMsg) -> (Probe, Cmd[ProbeMsg]) =
  match msg {
    Bump -> (Probe { ..m, n: m.n + 1 }, BatchCmd(cmds: notes(CMD_FOLD_LIMIT)))
    _ -> probe_step(m, msg)
  }

# ---- Fetch ---------------------------------------------------------------
#
# `Fetch` is a description. What these pin is that asking for one runs nothing
# (no model change, no message), that the requests come back in the order they
# were written, and that a driver with no host refuses instead of dropping.

fn fetch_step(m: Probe, msg: ProbeMsg) -> (Probe, Cmd[ProbeMsg]) =
  match msg {
    Bump -> (Probe { ..m, n: m.n + 1 }, Fetch(url: "/a.json", tag: "a"))
    Both -> (m, BatchCmd(cmds: [
      Fetch(url: "/b.json", tag: "b"),
      SendMsg(msg: Bump),
      BatchCmd(cmds: [Fetch(url: "/c.json", tag: "c"), NoCmd]),
    ]))
    _ -> probe_step(m, msg)
  }

test "a fetch is not a message, and fetches flatten left to right" {
  let c: Cmd[ProbeMsg] = BatchCmd(cmds: [
    Fetch(url: "/x", tag: "1"),
    SendMsg(msg: Bump),
    BatchCmd(cmds: [Fetch(url: "/y", tag: "2")]),
  ])
  assert msgs(c) == [Bump]
  assert fetches(c) == [FetchReq { url: "/x", tag: "1" }, FetchReq { url: "/y", tag: "2" }]
  let none: Cmd[ProbeMsg] = NoCmd
  assert fetches(none) == []
}

test "fold_cmds answers the model and the requests, and runs nothing for them" {
  let (m, asked) = fold_cmds(blank(), Bump, fetch_step)
  # `Bump` moved the model once itself; the fetch it commanded added nothing.
  assert m == Probe { n: 1, log: "" }
  assert asked == [FetchReq { url: "/a.json", tag: "a" }]
}

test "fetches commanded through a batch keep their order next to messages" {
  let (m, asked) = fold_cmds(blank(), Both, fetch_step)
  # the batch's `SendMsg(Bump)` ran (and itself asked for /a.json, after /b and /c)
  assert m == Probe { n: 1, log: "" }
  assert asked == [
    FetchReq { url: "/b.json", tag: "b" },
    FetchReq { url: "/c.json", tag: "c" },
    FetchReq { url: "/a.json", tag: "a" },
  ]
}

test "a driver with no host refuses a fetch rather than dropping it" {
  match catch_panic(() => fold_msg(blank(), Bump, fetch_step)) {
    Ok(_) -> { assert false }
    Err(e) -> {
      assert str.starts_with(e.message, "tea_core/cmd: this driver cannot run `Fetch` (asked for /a.json)")
    }
  }
  # and the positive control: a fetch-free turn is untouched
  assert fold_msg(blank(), Note(mark: "k"), fetch_step) == Probe { n: 0, log: "k" }
}

test "fetches count against the turn's limit like messages" {
  match catch_panic(() => fold_cmds(blank(), Bump, fetch_fan_out)) {
    Ok(_) -> { assert false }
    Err(e) -> {
      assert str.starts_with(e.message,
        "tea_core/cmd: a turn's commands asked for more than 64 messages at ")
    }
  }
}

fn fetch_fan_out(m: Probe, msg: ProbeMsg) -> (Probe, Cmd[ProbeMsg]) =
  match msg {
    Bump -> (m, BatchCmd(cmds: many_fetches(0, CMD_FOLD_LIMIT + 1, empty_cmds())))
    _ -> probe_step(m, msg)
  }

fn empty_cmds() -> List[Cmd[ProbeMsg]] = []

fn many_fetches(i: Int, n: Int, acc: List[Cmd[ProbeMsg]]) -> List[Cmd[ProbeMsg]] =
  if i >= n {
    acc
  } else {
    let one: Cmd[ProbeMsg] = Fetch(url: "/z", tag: "z")
    many_fetches(i + 1, n, acc ++ [one])
  }

# A deep non-tail recursion run twice: once on the program's own stack, once
# inside a `ctl` block whose arm resumes, so the recursion runs on the
# continuation's carrier (docs/oneshot-design.md 11.10).
#
# On the JVM a Continuation mounts on a platform thread, so both runs get the
# -Xss512m that bin/dawn sets. Native gives a carrier DAWN_CTL_STACK_BYTES,
# which was 64 MiB until 2026-10-04 and now is DAWN_STACK_BYTES (512 MiB). At
# 64 MiB the second line died with SIGSEGV from about 7,000,000 levels while
# the first line and the JVM both finished: one program, two stack limits.
# 8,000,000 sits above that crash point and below the 512 MiB one, so putting
# the old size back turns this entry red (exit 139, nothing on the second
# line). It also clears the AddressSanitizer build (-O0), measured at about
# 1 s and 760 MB resident.
#
# `down` is not a tail call and the multiply-and-reduce keeps the C compiler
# from turning it into a loop; the answer itself is just a checksum both
# backends have to agree on.
use std/io

ctl effect Ask {
  fn ask(n: Int) -> Int
}

fn down(n: Int) -> Int = if n == 0 { 0 } else { (down(n - 1) * 3 + n) % 1000003 }

fn inside(n: Int) -> Int = {
  with handle Ask { ask(x) resume k => k(x + 1) }
  down(ask(n) - 1)
}

pub fn main() -> Unit !io = {
  io.println("main stack ${to_string(down(8000000))}")
  io.println("carrier ${to_string(inside(8000000))}")
}

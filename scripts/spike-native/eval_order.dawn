# Positional call arguments evaluate left to right (spec §4.3) -- on both
# backends. The C emitter used to hand effectful arguments to the C call
# expression inline, and C leaves that order unspecified: gcc on x86-64 went
# right to left, so this program printed c, b, a on native and a, b, c on the
# JVM. The corpus never had a call with two effectful arguments, which is why
# the divergence sat unseen until the named-arguments batch (#207) pinned
# written-order evaluation and went looking. `emit_ordered` is the fix.
use std/io

fn tap(label: String, v: Int) -> Int !io = {
  io.println("eval " ++ label)
  v
}

fn combine(a: Int, b: Int, c: Int) -> Int = a * 100 + b * 10 + c

fn range_lower_empty() -> Int !io = tap("range empty lower", 3)

fn range_upper_empty() -> Int !io = tap("range empty upper", 1)

fn range_lower_nonempty() -> Int !io = tap("range nonempty lower", 2)

fn range_upper_nonempty() -> Int !io = tap("range nonempty upper", 5)

pub fn main() -> Unit !io = {
  let r = combine(tap("a", 1), tap("b", 2), tap("c", 3))
  io.println(to_string(r))
  var empty_total = 0
  for i in range_lower_empty()..range_upper_empty() {
    io.println("range empty body " ++ to_string(i))
    empty_total = empty_total + i
  }
  io.println("range empty total " ++ to_string(empty_total))
  var nonempty_total = 0
  for i in range_lower_nonempty()..range_upper_nonempty() {
    io.println("range nonempty body " ++ to_string(i))
    nonempty_total = nonempty_total * 10 + i
  }
  io.println("range nonempty total " ++ to_string(nonempty_total))
}

## Assemble the 13.4 bytes `bytecode.encode` writes with the pinned
## tileiras 13.5.37, using its default O3 optimization level. The compiler
## fixes the loop exit miscompilation tracked by #558 and NVIDIA/cuda-tile#25.
## The old version's workaround and parameter policy are no longer supported.
##
## `std/gpu` consumes AOT cubins; it never invokes the assembler itself.
use std/bytes
use std/io.{Fs, Proc, temp_dir, write_bytes, read_bytes, read_file, write_file, copy_permissions, list_dir, delete, run, with_fs_real, with_proc_real}
use std/list
use std/str
use bytecode.{encode}
use std/dtype.{F64}
use prog.{TileProg, trace_kernel, trace1, cells, Out}
use dev.{d_loop, carry, get, set, f_const, broadcast, reduce_max, abs, gt, store_cell}

## Why [`assemble`] gave no cubin. `AssemblerNotFound` is a `tileiras` path
## nothing could start (missing, not executable), `AssemblerFailed` a run that
## exited non-zero (`args` is what it was given, `stderr` what it printed),
## `NoCubin` a run that exited zero and left no output file, and
## `UnknownVersion` a `--version` whose text has no unique, complete standard
## version record (see [`assemble`]). `UnsupportedVersion` is a valid
## record for a binary other than the supported 13.5.37. `Scratch` is the
## host refusing the temporary directory or a file in it.
pub type AssembleError =
  | AssemblerNotFound(path: String, detail: String)
  | AssemblerFailed(args: List[String], status: Int, stderr: String)
  | NoCubin(path: String)
  | UnknownVersion(output: String)
  | UnsupportedVersion(version: String)
  | Scratch(detail: String)
derive Show

## One English sentence for an [`AssembleError`], for a build script's log.
pub fn explain(e: AssembleError) -> String = match e {
  AssemblerNotFound(path, detail) -> "could not run tileiras at `${path}`: ${detail}"
  AssemblerFailed(args, status, stderr) ->
    "tileiras ${join(args, " ")} exited with status ${status}: ${str.trim(stderr)}"
  NoCubin(path) -> "tileiras exited with status 0 but wrote no cubin at `${path}`"
  UnknownVersion(output) -> "`tileiras --version` did not print one valid version record: ${str.trim(output)}"
  UnsupportedVersion(version) -> "tileiras ${version} is not supported; expected 13.5.37"
  Scratch(detail) -> "scratch files for tileiras: ${detail}"
}

# Canonical components keep numeric aliases from changing assembler identity.
fn version_component(s: String) -> Bool =
  not str.is_empty(s) && (s == "0" || not str.starts_with(s, "0"))
  && list.all(str.chars(s), c => str.contains("0123456789", c))

fn version_record(line: String) -> Option[String] =
  match str.split_once(line, ", V") {
    Some((release, v)) -> {
      let parts = str.split(v, ".")
      if len(parts) == 3 && list.all(parts, version_component)
        && release == "Cuda compilation tools, release ${parts[0]}.${parts[1]}" {
        Some(v)
      } else {
        None
      }
    }
    None -> None
  }

# Count all candidate records, including malformed ones; a second record must
# not override the identity used for a correctness workaround.
fn version_of(output: String) -> Option[String] = {
  var version: Option[String] = None
  var records = 0
  for raw in str.split(output, "\n") {
    let line = str.trim(raw)
    if str.starts_with(line, "Cuda compilation tools") || str.contains(line, ", V") {
      records = records + 1
      version = version_record(line)
    }
  }
  if records == 1 { version } else { None }
}

# Run `tileiras argv`, stdout and stderr each into a file under `dir`: the
# status and both texts, or the reason it could not start.
fn run_in(dir: String, tag: String, tileiras: String, argv: List[String]) -> Result[(Int, String, String), AssembleError] !Fs !Proc = {
  let out = "${dir}/${tag}.out"
  let err = "${dir}/${tag}.err"
  match run([tileiras] ++ argv, out, err) {
    Err(e) -> Err(AssemblerNotFound(tileiras, e.message))
    Ok(status) -> {
      let text = match read_file(out) {
        Ok(t) -> t
        Err(_e) -> ""
      }
      let errs = match read_file(err) {
        Ok(t) -> t
        Err(_e) -> ""
      }
      Ok((status, text, errs))
    }
  }
}

fn assemble_in(dir: String, bc: Bytes, gpu_name: String, tileiras: String) -> Result[Bytes, AssembleError] !Fs !Proc =
  match run_in(dir, "version", tileiras, ["--version"]) {
    Err(e) -> Err(e)
    Ok((vstatus, vout, verr)) ->
      if vstatus != 0 {
        Err(AssemblerFailed(["--version"], vstatus, verr))
      } else {
        match version_of(vout) {
          None -> Err(UnknownVersion(vout))
          Some(version) -> if version != "13.5.37" {
            Err(UnsupportedVersion(version))
          } else {
            let input = "${dir}/in.tilebc"
            let output = "${dir}/out.cubin"
            match write_bytes(input, bc) {
              Err(e) -> Err(Scratch(e.message))
              Ok(_u) -> {
                let args = ["--gpu-name", gpu_name, "-o", output, input]
                match run_in(dir, "asm", tileiras, args) {
                  Err(e) -> Err(e)
                  Ok((status, _o, errs)) ->
                    if status != 0 {
                      Err(AssemblerFailed(args, status, errs))
                    } else {
                      match read_bytes(output) {
                        Ok(cubin) -> Ok(cubin)
                        Err(_e) -> Err(NoCubin(output))
                      }
                    }
                }
              }
            }
          }
        }
      }
  }

# Best effort: the scratch directory is ours, and a failed delete must not
# replace the answer the caller is waiting for.
fn clean(dir: String) -> Unit !Fs = {
  for f in ["version.out", "version.err", "asm.out", "asm.err", "in.tilebc", "out.cubin"] {
    let _r = delete("${dir}/${f}")
  }
  let _d = delete(dir)
  ()
}

## Assemble `prog` for `gpu_name` (e.g. `"sm_86"`) with the `tileiras`
## executable at `tileiras` (a path, or a name found on PATH) and answer the
## cubin. This is the step `encode` and the assembler make by hand: the
## program is encoded, written to a temporary `.tilebc`, `tileiras --version`
## validates the complete version record, the target is passed with
## `--gpu-name`, and the cubin is read back at the default O3 level. The temporary directory is
## removed whatever the outcome.
##
## Version output must contain exactly one `Cuda compilation tools, release
## M.m, VM.m.p` record. Components are ASCII decimal without leading zeros
## except `0`; the release must agree with the version. Surrounding whitespace,
## LF and CRLF are accepted. Incomplete, suffixed or duplicate records are
## `UnknownVersion`, with the original stdout, before assembly starts. A
## complete version other than 13.5.37 is `UnsupportedVersion`, also before
## assembly starts; unsupported binaries never receive unprotected arguments.
##
## An assembler that cannot be started, one that exits non-zero, one that
## leaves no file and one whose version text cannot be read are four
## different [`AssembleError`]s. A program the encoder refuses panics with its
## message, before any file exists.
##
## It takes the file system and process effects rather than reaching for the
## host, so a test answers both without an assembler; `with_fs_real` and
## `with_proc_real` are the production handlers. Nothing is cached: an
## assembly takes well under a second, and a cache keyed on the bytes would
## also have to be keyed on the assembler's version, the target and the
## arguments, which this API deliberately leaves to its caller.
pub fn assemble(prog: TileProg, gpu_name: String, tileiras: String) -> Result[Bytes, AssembleError] !Fs !Proc = {
  let bc = encode(prog)
  match temp_dir("", "tileir-asm-") {
    Err(e) -> Err(Scratch(e.message))
    Ok(dir) -> {
      let r = assemble_in(dir, bc, gpu_name, tileiras)
      clean(dir)
      r
    }
  }
}

# The minimized loop remains a subprocess fixture for the default O3 policy.
fn repro_558() -> TileProg = {
  let (p, _e) = trace1("repro_558", Out(F64, cells([1], [1])), o => {
    let c = broadcast(f_const(F64, 0.25), [1])
    let half = f_const(F64, 0.5)
    let x = carry(broadcast(f_const(F64, 1.0), [1]))
    d_loop {
      let v = x.get()
      let worst = reduce_max(abs(v - c))
      x.set(half * (v + c))
      gt(f_const(F64, 0.2), worst)
    }
    store_cell(o, x.get())
  })
  p
}

# ---- assemble, against a stand-in for tileiras
#
# The stand-in is a shell script that answers `--version` the way the real
# one does and otherwise does what the case under test says. It is made
# executable by copying `sh`'s mode onto it (`copy_permissions`), because
# nothing in std can chmod. Nothing here needs a GPU or the real assembler;
# the real one is run by scripts/tile-gpu-diff and by the PR's own hardware
# check.

fn fake_program() -> TileProg = trace_kernel("fake", [], () => ())

fn made(r: Result[String, ForeignError]) -> String = match r {
  Ok(p) -> p
  Err(_e) -> ""
}

fn version_lines() -> String =
  "echo \"tileiras: fake\"\necho \"Cuda compilation tools, release 13.5, V13.5.37\"\n"

# The pinned assembler's version banner is a positive identity fixture.
fn pinned_version_output() -> String =
  "tileiras: NVIDIA (R) Cuda Tile IR optimizing assembler\n"
  ++ "Copyright (c) 2005-2026 NVIDIA Corporation\n"
  ++ "Built on Mon_Oct_12_19:27:40_PDT_2026\n"
  ++ "Cuda compilation tools, release 13.5, V13.5.37\n"
  ++ "Build local.local.39125733_\n"

fn bad_version_outputs() -> List[String] = [
  "",
  "garbage\n",
  "Cuda compilation tools, release 13.5, Vgarbage\n",
  "Cuda compilation tools, release 13.5, V13.5\n",
  "Cuda compilation tools, release 13.5, V13.5.\n",
  "Cuda compilation tools, release 13.5, V13..37\n",
  "Cuda compilation tools, release 13.5, V13.5.37-extra\n",
  "Cuda compilation tools, release 13.5, V13.5.37 extra\n",
  "Cuda compilation tools, release 13.5, V13.5.37.1\n",
  "Cuda compilation tools, release 13.5, V\n",
  "Cuda compilation tools, release 13.5, V13.5.-1\n",
  "Cuda compilation tools, release 13.5, V13.5.３７\n",
  "Cuda compilation tools, release 013.5, V013.5.37\n",
  "Cuda compilation tools, release 13.05, V13.05.37\n",
  "Cuda compilation tools, release 13.5, V13.5.037\n",
  "Cuda compilation tools, release 13.3, V13.5.37\n",
  "other program, V13.5.37\n",
  "Cuda compilation tools, release 13.5, V13.5.37\nCuda compilation tools, release 13.5, V13.5.38\n",
  "Cuda compilation tools, release 13.5, V13.5.37\nCuda compilation tools, release 13.5, V13.5.37\n",
  "Cuda compilation tools, release 13.5, Vgarbage\nCuda compilation tools, release 13.5, V13.5.37\n",
  "Cuda compilation tools, release 13.5, V13.5.37\nCuda compilation tools, release 13.5\n",
]

test "version identity requires one complete canonical record" {
  assert version_of(pinned_version_output()) == Some("13.5.37")
  assert version_of("\r\n\t Cuda compilation tools, release 13.5, V13.5.37 \t\r\nBuild x\r\n") == Some("13.5.37")
  assert version_of("Cuda compilation tools, release 13.5, V13.5.38") == Some("13.5.38")
  assert version_of("Cuda compilation tools, release 14.0, V14.0.0\n") == Some("14.0.0")
  for output in bad_version_outputs() {
    assert version_of(output) == None
  }
}

# A successful assembly records its invocation outside assemble's scratch
# directory, so cleanup cannot hide an incorrectly started subprocess.
fn sentinel_assembler(output: String) -> String =
  "if [ \"\$1\" = \"--version\" ]; then printf '%s' '" ++ str.replace(output, "'", "'\\''") ++ "'; exit 0; fi\n"
  ++ "printf '%s' invoked > \"\$0.assembled\"\n"
  ++ "for a in \"\$@\"; do if [ \"\$prev\" = \"-o\" ]; then out=\"\$a\"; fi; prev=\"\$a\"; done\n"
  ++ "printf '%s' \"\$*\" > \"\$out\"\n"

# A stand-in whose body (after the shebang) is `body`, in a fresh directory;
# `f` gets its path, and the directory is removed afterwards.
fn with_fake[T](body: String, f: fn(String) -> T !Fs !Proc) -> T !Fs !Proc = {
  let d = made(temp_dir("", "tileir-fake-"))
  let path = "${d}/tileiras"
  let _w = write_file(path, "#!/bin/sh\n${body}")
  let _p = copy_permissions("/bin/sh", path)
  let r = f(path)
  let _a = delete(path)
  let _b = delete(d)
  r
}

# The scratch directories assemble leaves behind in the temporary directory.
fn leftovers() -> List[String] !Fs = {
  let probe = made(temp_dir("", "tileir-probe-"))
  let parent = match str.rsplit_once(probe, "/") {
    Some((p, _name)) -> p
    None -> "."
  }
  let _d = delete(probe)
  match list_dir(parent) {
    Ok(names) -> list.filter(names, n => str.starts_with(n, "tileir-asm-"))
    Err(_e) -> []
  }
}

test "assemble rejects bad version identities before the assembly sentinel and preserves stdout" {
  with_fs_real(() => with_proc_real(() => {
    for output in bad_version_outputs() {
      let before = leftovers()
      let (answer, invoked) = with_fake(sentinel_assembler(output), path => {
        let r = assemble(repro_558(), "sm_100", path)
        let marker = "${path}.assembled"
        let seen = match read_file(marker) {
          Ok(_text) -> true
          Err(_e) -> false
        }
        let _d = delete(marker)
        (r, seen)
      })
      assert invoked == false
      match answer {
        Err(UnknownVersion(raw)) -> { assert raw == output }
        _ -> { assert false }
      }
      assert leftovers() == before
    }
  }))
}

test "assemble rejects unsupported exact versions before starting the assembler" {
  with_fs_real(() => with_proc_real(() => {
    for (release, version) in [("13.4", "13.4.92"), ("13.5", "13.5.38"), ("14.0", "14.0.0")] {
      let output = "Cuda compilation tools, release ${release}, V${version}\n"
      let (answer, invoked) = with_fake(sentinel_assembler(output), path => {
        let r = assemble(repro_558(), "sm_100", path)
        let marker = "${path}.assembled"
        let seen = match read_file(marker) {
          Ok(_text) -> true
          Err(_e) -> false
        }
        let _d = delete(marker)
        (r, seen)
      })
      assert invoked == false
      match answer {
        Err(UnsupportedVersion(actual)) -> { assert actual == version }
        _ -> { assert false }
      }
    }
  }))
}

test "assemble uses default O3 for the pinned version on every qualified target" {
  with_fs_real(() => with_proc_real(() => {
    for (output, gpu_name, prog, expected) in [
      (pinned_version_output(), "sm_100", repro_558(), "--gpu-name sm_100 -o "),
      (pinned_version_output(), "sm_90", repro_558(), "--gpu-name sm_90 -o "),
      (pinned_version_output(), "sm_100", fake_program(), "--gpu-name sm_100 -o "),
      (pinned_version_output(), "sm_86", repro_558(), "--gpu-name sm_86 -o "),
      ("\tCuda compilation tools, release 13.5, V13.5.37 \r\n", "sm_90", repro_558(), "--gpu-name sm_90 -o "),
    ] {
      let before = leftovers()
      let (answer, invoked) = with_fake(sentinel_assembler(output), path => {
        let r = assemble(prog, gpu_name, path)
        let marker = "${path}.assembled"
        let seen = match read_file(marker) {
          Ok(text) -> text == "invoked"
          Err(_e) -> false
        }
        let _d = delete(marker)
        (r, seen)
      })
      assert invoked
      match answer {
        Ok(cubin) -> { assert bytes.slice(cubin, 0, len(bytes.utf8(expected))) == bytes.utf8(expected) }
        _ -> { assert false }
      }
      assert leftovers() == before
    }
  }))
}

test "assemble hands tileiras the program bytes and target and answers the cubin" {
  with_fs_real(() => with_proc_real(() => {
    let script = version_lines() ++ "if [ \"\$1\" = \"--version\" ]; then exit 0; fi\n"
      ++ "for a in \"\$@\"; do if [ \"\$prev\" = \"-o\" ]; then out=\"\$a\"; fi; prev=\"\$a\"; in=\"\$a\"; done\n"
      ++ "{ echo \"args: \$*\"; cat \"\$in\"; } > \"\$out\"\n"
    let before = leftovers()
    let plain = fake_program()
    # The pinned compiler needs no loop-specific arguments on any target.
    for (prog, gpu, want) in [
      (repro_558(), "sm_90", "args: --gpu-name sm_90 -o "),
      (repro_558(), "sm_86", "args: --gpu-name sm_86 -o "),
      (plain, "sm_90", "args: --gpu-name sm_90 -o ")] {
      let bc = encode(prog)
      match with_fake(script, path => assemble(prog, gpu, path)) {
        Ok(cubin) -> {
          assert str.starts_with(bytes.decode_utf8_lossy(cubin), want)
          # the program's own bytes follow the one line the stand-in wrote
          assert bytes.slice(cubin, len(cubin) - len(bc), len(cubin)) == bc
        }
        Err(e) -> { assert explain(e) == "" }
      }
    }
    # and the scratch directory is gone
    assert leftovers() == before
  }))
}

test "assemble: a tileiras that cannot be started is AssemblerNotFound" {
  with_fs_real(() => with_proc_real(() => {
    let before = leftovers()
    match assemble(fake_program(), "sm_86", "/nonexistent/dir/tileiras") {
      Err(AssemblerNotFound(path, _detail)) -> { assert path == "/nonexistent/dir/tileiras" }
      _ -> { assert false }
    }
    assert leftovers() == before
  }))
}

test "assemble: a non-zero exit is AssemblerFailed with the arguments and stderr" {
  with_fs_real(() => with_proc_real(() => {
    let script = version_lines() ++ "if [ \"\$1\" = \"--version\" ]; then exit 0; fi\necho \"error: nope\" >&2\nexit 3\n"
    let before = leftovers()
    match with_fake(script, path => assemble(repro_558(), "sm_100", path)) {
      Err(AssemblerFailed(args, status, stderr)) -> {
        assert status == 3
        assert str.trim(stderr) == "error: nope"
        assert list.take(args, 3) == ["--gpu-name", "sm_100", "-o"]
      }
      _ -> { assert false }
    }
    assert leftovers() == before
  }))
}

test "assemble: a zero exit that wrote no file is NoCubin" {
  with_fs_real(() => with_proc_real(() => {
    let script = version_lines() ++ "exit 0\n"
    match with_fake(script, path => assemble(fake_program(), "sm_86", path)) {
      Err(NoCubin(path)) -> { assert str.ends_with(path, "/out.cubin") }
      _ -> { assert false }
    }
  }))
}

test "assemble: an unreadable version is UnknownVersion, and a failing --version is AssemblerFailed" {
  with_fs_real(() => with_proc_real(() => {
    match with_fake("echo garbage\n", path => assemble(fake_program(), "sm_86", path)) {
      Err(UnknownVersion(out)) -> { assert str.trim(out) == "garbage" }
      _ -> { assert false }
    }
    match with_fake("echo oops >&2\nexit 2\n", path => assemble(fake_program(), "sm_86", path)) {
      Err(AssemblerFailed(args, status, _stderr)) -> {
        assert args == ["--version"]
        assert status == 2
      }
      _ -> { assert false }
    }
  }))
}

test "explain says which assembler step failed" {
  assert explain(AssemblerNotFound("/x/tileiras", "no such file")) == "could not run tileiras at `/x/tileiras`: no such file"
  assert explain(AssemblerFailed(["--gpu-name", "sm_90"], 1, "bad\n")) == "tileiras --gpu-name sm_90 exited with status 1: bad"
  assert explain(UnknownVersion("bad\n")) == "`tileiras --version` did not print one valid version record: bad"
  assert version_of("a\nCuda compilation tools, release 13.5, V13.5.37\nBuild x\n") == Some("13.5.37")
  assert explain(UnsupportedVersion("13.4.92")) == "tileiras 13.4.92 is not supported; expected 13.5.37"
  assert version_of("nothing") == None
}

## `TileProg` as Tile IR text: the `cuda_tile` dialect's assembly, one module
## with one entry, spelled the way `cuda-tile-translate` prints it. The text is
## layer 0 of tile-backend-design 6.2: scripts/tile-golden pins it byte for
## byte, and it is what a person reads when the bytecode (bytecode.dawn)
## disagrees with the device.
#
# The renderer spells; it does not decide. Which operations a program becomes,
# in what order, with which operands and value numbers, is lower.dawn's
# answer, shared with the bytecode writer, so this module is one line of
# assembly per `Instr` and nothing else, a `ForLoop` being its header line, its
# body two columns further in, and a closing brace. Spelling follows the
# specification's appendix example (vector add over `tile<ptr<f32>>`
# parameters) and the dialect's own round-trip tests
# (`test/Bytecode/operationsTest.mlir`: `make_token`, `token=%N` on the
# token-ordered memory operations, `for %iv in (%lo to %hi, step %st) :
# tile<i32> iter_values(%a = %init) -> (ty) { ... continue %v : ty }`).
use std/list
use std/str
use std/gpu.{F64}
use dev.{RedId, IdF, IdI, AssumePred, DivBy, SameElements, Bounded, Hints, Padding, NoPadding, padding_name, DYN_DIM,
  Dev, Param, param, block_id, tile_at, load, store, add, idx_const, carry, get, set, d_global, global_ptrs, load_ptrs, t_block_id,
  t_body_enter, t_body_exit, d_scan, d_reduce, d_if, d_fork2, d_range, By, d_loop, max, f_const, lt, gt, d_assert, broadcast, mul,
  load_cell, store_cell, tail_mask, for_arch, hint_latency }
use prog.{TileProg, TileOp, Call, trace_kernel, trace_calls, trace3, In, Out, cells, op_count, ftof_mode, Global, GetGlobal, MakeToken, BlockId, Load, Store, Return, Convert, AtomicRMW, AtomicCAS, ConstF, ConstI, Lanes, UnaryF, BinaryF, BinaryI, CmpI, IdxConst, IdxAdd, IdxMul, For, Loop, Break, Continue, Spread, Reduce, If, Yield, Extract, Cat, Permute, NumBlocks, JoinToks, MakePtrs, PtrAdd, PtrInt, IntPtr, PtrCast, LoadAt}
use lower.{Kernel, Instr, Owner, Ty, Elem, Ref, lower, lower_spans, rank0_of, Token, Tile, Num, PtrTo, Arg, Val, MakeTok, BlockIds, ConstInt, ConstFloat, MulInt, AddInt, Reshape, Broadcast, IotaTile, Offset, LoadPtr, StorePtr, AtomicRMWPtr, AtomicCASPtr, FloatUn, FloatBin, FloatFma, FloatMma, FloatMmaScaled, IntMma, CmpFloat, CmpInt, IntUn, IntBin, Cast, SelectTile, ForLoop, WhileLoop, BreakVals, Cont, ReduceTile, ScanTile, IfElse, YieldVals, ExtractTile, InsertTile, FloatPowI, CatTile, PermuteTile, BlockCounts, JoinTokens, PtrToIntTile, IntToPtrTile, PtrToPtrTile, AssertTile, AssumeTile, PrintTile, GetGlobalPtr, TensorView, PartitionView, StridedView, GatherScatterView, MakeTensorView, MakePartitionView, MakeStridedView, MakeGatherScatterView, GetTensorShape, GetIndexSpaceShape, LoadViewTile, StoreViewTile, AtomicRedViewTile, AllocaPtr, Ret}

fn elem(e: Elem) -> String = match e {
  Num(name) -> name
  PtrTo(name) -> "ptr<${name}>"
}

## `t` as the assembly spells it: `token`, `tile<f64>`, `tile<128xf64>`,
## `tile<64x32xf64>`. Every dimension in order, `x`-separated, the element
## format last; the rank-0 tile is the element format alone.
pub fn ty(t: Ty) -> String = match t {
  Token -> "token"
  Tile(shape, e) -> "tile<" ++ list.fold(shape, "", (acc, d) => acc ++ "${d}x") ++ elem(e) ++ ">"
  TensorView(e, shape, strides) ->
    "tensor_view<" ++ list.fold(shape, "", (acc, d) => acc ++ "${extent(d)}x") ++ elem(e)
    ++ ", strides=[" ++ commas(list.map(strides, extent)) ++ "]>"
  PartitionView(tile_shape, e, shape, strides, dim_map, padding) ->
    "partition_view<tile=(" ++ crosses(tile_shape) ++ ")"
    ++ pad_clause(padding)
    ++ ", " ++ ty(TensorView(e, shape, strides))
    ++ ", dim_map=[" ++ commas(list.map(dim_map, k => "${k}")) ++ "]>"
  # `StridedViewType::print`'s order: the tile, the traversal strides, the
  # padding value if there is one, the tensor view, the dim map.
  StridedView(tile_shape, traversal, e, shape, strides, dim_map, padding) ->
    "strided_view<tile=(" ++ crosses(tile_shape) ++ ")"
    ++ ", traversal_strides=[" ++ commas(list.map(traversal, k => "${k}")) ++ "]"
    ++ pad_clause(padding)
    ++ ", " ++ ty(TensorView(e, shape, strides))
    ++ ", dim_map=[" ++ commas(list.map(dim_map, k => "${k}")) ++ "]>"
  # `GatherScatterViewType::print`'s: the tile, the padding value if there
  # is one, the tensor view, and `sparse_dim` LAST rather than a dim map.
  GatherScatterView(tile_shape, e, shape, strides, sparse_dim, padding) ->
    "gather_scatter_view<tile=(" ++ crosses(tile_shape) ++ ")"
    ++ pad_clause(padding)
    ++ ", " ++ ty(TensorView(e, shape, strides))
    ++ ", sparse_dim=${sparse_dim}>"
}

# The `padding_value` clause of a view type, which the printer leaves out
# entirely when the parameter is absent. All three views spell it the same
# way and in the same place: right after the tile.
fn pad_clause(padding: Padding) -> String = match padding {
  NoPadding -> ""
  _ -> ", padding_value = ${padding_name(padding)}"
}

# The index types a view operation prints after its view type: ONE when
# every index has the same type, and all of them when they do not. That is
# `printIndexTypes`'s own rule, and a gather/scatter view is the only thing
# here that takes the second branch (its sparse dimension's index is a 1D
# tile and the others are rank-0).
fn index_types(tys: List[Ty]) -> String =
  if len(tys) == 0 {
    ""
  } else if list.all(range(0, len(tys)), k => ty(tys[k]) == ty(tys[0])) {
    ", " ++ ty(tys[0])
  } else {
    list.fold(tys, "", (acc, t) => acc ++ ", " ++ ty(t))
  }

# One extent or stride of a tensor view as the type spells it: the number,
# or `?` for a dimension `make_tensor_view` carries in an operand (knife
# T12). `printDimensionList` and the type's own printer both write the
# question mark for `ShapedType::kDynamic`, which is what `DYN_DIM` marks.
fn extent(d: Int) -> String = if d == DYN_DIM { "?" } else { "${d}" }

# The `AxBxC` a partition view spells its tile with, which is the tile
# type's separator without the element format after it.
fn crosses(shape: List[Int]) -> String =
  list.fold(range(0, len(shape)), "", (acc, k) =>
      if acc == "" { "${shape[k]}" } else { acc ++ "x${shape[k]}" })

fn name(r: Ref) -> String = match r {
  Arg(pos) -> "%arg${pos}"
  Val(id) -> "%${id}"
}

fn v(id: Int) -> String = "%${id}"

fn commas(xs: List[String]) -> String =
  list.fold(xs, "", (acc, x) => if acc == "" { x } else { acc ++ ", " ++ x })

# `%a, %b = ` for the values an instruction defines, or nothing for none.
fn results(ids: List[Int]) -> String = if len(ids) == 0 { "" } else { commas(list.map(ids, v)) ++ " = " }

# The element format a tile type holds, as a constant's `<f64: ..>` prefix
# spells it.
fn elem_of(t: Ty) -> String = match t {
  Tile(_shape, e) -> elem(e)
  _ -> panic("tileir: `${show(t)}` holds no element format")
}

# `, %x` for an operand the assembly prints when it is there, "" for one it
# leaves out; `sep_ty` the same for the type list.
fn opt_operand(r: Option[Ref]) -> String = match r {
  Some(x) -> ", ${name(x)}"
  None -> ""
}

fn opt_ty(r: Option[Ref], t: Ty) -> String = match r {
  Some(_x) -> ", ${ty(t)}"
  None -> ""
}

# `optimization_hints=<sm_86 = {latency = 4}, default = {..}>`, as
# `OptimizationHintsAttr::print` spells it: one entry per architecture,
# each a brace-wrapped dictionary of key and value, comma separated with a
# space around every `=`. Empty hints print nothing at all, which is what
# the dialect's own parser does with `optimization_hints=<>` on the way
# back in and what leaves every kernel before knife T15 untouched.
fn hint_dict(hints: List[(String, Int)]) -> String =
  commas(list.map(hints, h => {
    let (key, value) = h
    "${key} = ${value}"
  }))

fn hints_attr(hints: Hints) -> String = if len(hints) == 0 { "" } else {
  " optimization_hints=<" ++ commas(list.map(hints, a => {
    let (arch, under) = a
    "${arch} = {${hint_dict(under)}}"
  })) ++ ">"
}

# The predicate, as `custom<ComparisonPredicate>` prints it. A `u` prefix
# is the same predicate under the other `comparison_ordering` (knife T4),
# so it spells the same word and `cmp_ordering` spells the difference.
fn predicate(pred: String) -> String = match pred {
  "eq" | "ueq" -> "equal"
  "ne" | "une" -> "not_equal"
  "lt" | "ult" -> "less_than"
  "le" | "ule" -> "less_than_or_equal"
  "gt" | "ugt" -> "greater_than"
  "ge" | "uge" -> "greater_than_or_equal"
  _ -> panic("tileir: `${pred}` is not a comparison predicate")
}

# The `comparison_ordering` a float comparison prints after its predicate.
fn cmp_ordering(pred: String) -> String =
  if list.any(["ueq", "une", "ult", "ule", "ugt", "uge"], u => u == pred) { "unordered" } else { "ordered" }

# The mnemonic of a float operation. A name with an attribute suffix (knife
# T4) is the same mnemonic; `float_rounding` and `float_units` spell what
# the suffix said.
fn float_spelling(op: String) -> String = match op {
  "addf_neg_inf" | "addf_pos_inf" | "addf_ftz" -> "addf"
  "mulf_neg_inf" | "mulf_pos_inf" | "mulf_ftz" -> "mulf"
  "divf_neg_inf" | "divf_pos_inf" -> "divf"
  "maxf_nan" -> "maxf"
  "minf_nan" -> "minf"
  "sqrt_approx" -> "sqrt"
  # 13.4 renamed the operation (`CudaTile_PowOp` became `CudaTile_FPowFOp`
  # beside the new integer-exponent `fpowi`); the opcode and its bytes did
  # not change. `pow` stays the Dawn name of the float power.
  "pow" -> "fpowf"
  _ -> op
}

# The unit attributes a float operation prints after its operands, as the
# `oilist` in Ops.td spells them. Nothing before knife T4 set one.
fn float_units(op: String) -> String = match op {
  "addf_ftz" | "mulf_ftz" -> " flush_to_zero"
  "maxf_nan" | "minf_nan" -> " propagate_nan"
  _ -> ""
}

# The memory ordering and scope an `atomic_rmw_tko` prints before its
# operands. Every atomic before knife T4 was `relaxed device`, and the
# renderer spelled those two words inline; the three suffixed mode names
# are the other orderings and scopes.
fn rmw_memory(mode: String) -> String = match mode {
  "add_acquire_tl_blk" -> "acquire tl_blk"
  "add_release_sys" -> "release sys"
  "add_acq_rel_device" -> "acq_rel device"
  _ -> "relaxed device"
}

# The mode itself, with any memory suffix taken off.
fn rmw_spelling(mode: String) -> String = match mode {
  "add_acquire_tl_blk" | "add_release_sys" | "add_acq_rel_device" -> "add"
  _ -> mode
}

# The rounding mode is spelled by the operations that take one, and by no
# other: `maxf` and `minf` have `flush_to_zero` and `propagate_nan` and no
# rounding mode at all, and this is the list the bytecode writer encodes
# from as well.
fn rounding(op: String) -> String = match op {
  "addf" | "subf" | "mulf" | "divf" | "addf_ftz" | "mulf_ftz" -> " rounding<nearest_even>"
  "addf_neg_inf" | "mulf_neg_inf" | "divf_neg_inf" -> " rounding<negative_inf>"
  "addf_pos_inf" | "mulf_pos_inf" | "divf_pos_inf" -> " rounding<positive_inf>"
  _ -> ""
}

# The unary operations that print a rounding mode. `sqrt` takes one and
# `nearest_even` is what makes it the correctly rounded square root; `tanh`
# takes one too but the only mode an f64 tile accepts is `full`, which is
# its default and which the dialect's own printer leaves out (its examples
# spell the default `tanh %in : tile<4xf32>`); `exp`'s field does not exist
# before bytecode 13.3 at all. `exp2` and `rsqrt` take `flush_to_zero`,
# which is never set here and so is never printed.
fn un_rounding(op: String) -> String = match op {
  "sqrt" -> " rounding<nearest_even>"
  "sqrt_approx" -> " rounding<approx>"
  _ -> ""
}

# One reduction identity, as the assembly spells an element of the
# `identities` array: the value and the format it is a value of.
fn identity(id: RedId) -> String = match id {
  IdF(dtype, value) -> "${value} : ${dtype}"
  IdI(dtype, value) -> "${value} : ${dtype}"
}

# A string as the assembly spells it, between quotes: the three characters
# MLIR's own printer escapes, and nothing else. The bytecode writes the
# string's own bytes, so this is the text's half of one value and not a
# second spelling of it.
fn quoted(s: String) -> String =
  "\"" ++ list.fold(str.chars(s), "", (acc, c) => acc ++ escape_char(c)) ++ "\""

fn escape_char(c: String) -> String =
  if c == "\"" {
    "\\\""
  } else if c == "\\" {
    "\\\\"
  } else if c == "\n" {
    "\\n"
  } else {
    c
  }

# One `assume` predicate, as `custom<AssumePredicate>` prints it: the
# attribute's own syntax with the `#cuda_tile.` prefix dropped
# (CudaTile.cpp's printAssumePredicate does exactly that). A `bounded` bound
# that is absent prints `?`.
fn assume_predicate(p: AssumePred) -> String = match p {
  DivBy(divisor, every, along) -> match (every, along) {
    (Some(e), Some(a)) -> "div_by<${divisor}, every ${e} along ${a}>"
    _ -> "div_by<${divisor}>"
  }
  SameElements(groups) -> "same_elements<[${commas(list.map(groups, g => "${g}"))}]>"
  Bounded(lb, ub) -> "bounded<${bound(lb)}, ${bound(ub)}>"
}

fn bound(b: Option[Int]) -> String = match b {
  Some(x) -> "${x}"
  None -> "?"
}

# An integer constant as the TILE holds it, not as the kernel spelled it: a
# host `Int` is 64 bits wide and an i32 lane is not, so a constant written
# `0x9E3779B1` (a hash multiplier, and the natural way to write one) holds
# -1640531527 on the device. The bytes have always said so -- the writer
# keeps the low 32 bits -- and this is the text saying the same thing. An
# i1 lane holds one bit, and every constant reaching it is already 0 or 1.
fn int_literal(elem: String, value: Int) -> Int =
  if elem == "i32" {
    let low = value & 0xFFFFFFFF
    if low >= 0x80000000 { low - 0x100000000 } else { low }
  } else {
    value
  }

# `shri` and `shru` are one opcode under two signedness attributes; the
# dialect's mnemonic is `shri` for both and the attribute is what says which
# (Ops.td, ShRIOp). Every other name here is its own mnemonic.
fn int_spelling(op: String) -> String = match op {
  "shru" -> "shri"
  "addi_nsw" -> "addi"
  "subi_nuw" -> "subi"
  "muli_nw" -> "muli"
  _ -> op
}

# The overflow assumption an integer operation prints, where it is not the
# default. `overflow<none>` is the default and the dialect's printer leaves
# it out, which is why every integer line before knife T4 has nothing here.
fn int_overflow(op: String) -> String = match op {
  "addi_nsw" -> " overflow<no_signed_wrap>"
  "subi_nuw" -> " overflow<no_unsigned_wrap>"
  "muli_nw" -> " overflow<no_wrap>"
  _ -> ""
}

# The signedness attribute an integer operation prints, as
# `custom<Signedness>` spells it: a leading space and the word, no comma
# (Ops.td's `maxi` example). The operations without one print nothing.
fn int_signedness(op: String) -> String = match op {
  "divi" -> " signed"
  "remi" -> " signed"
  "maxi" -> " signed"
  "mini" -> " signed"
  "shri" -> " signed"
  "shru" -> " unsigned"
  _ -> ""
}

# The attributes a conversion prints between its operand and its types.
# `exti` widens a mask or an octet, so it is UNSIGNED and an `i1` 1 becomes
# 1 rather than -1; `ftoi` takes the only integer rounding mode the dialect
# accepts (`nearest_int_to_zero`, Ops.td's FToIOp); `ftof` takes the only
# one it accepts for a target that is not `f8E8M0FNU`, which is also its
# DEFAULT -- printed here rather than left out, because a rounding mode that
# is not written down is a rounding mode a reader has to look up, and the
# bytes carry it either way (`DefaultValuedAttr` is written inline);
# `trunci` and `bitcast` take nothing.
fn cast_attrs(op: String, to: String) -> String = match op {
  "itof" -> " signed rounding<nearest_even>"
  "ftoi" -> " signed rounding<nearest_int_to_zero>"
  "ftoi_sat" -> " signed rounding<nearest_int_to_zero> saturating"
  "ftof" | "ftof_zero" | "ftof_neg_inf" | "ftof_pos_inf" | "ftof_away" -> " rounding<${ftof_mode(op, to)}>"
  "exti" -> " unsigned"
  "extis" -> " signed"
  _ -> ""
}

# The dialect's spelling of a conversion. `exti` and `extis` are one
# opcode under two signedness attributes and are two names here for the
# reason `shri` and `shru` are: the surface that spells one has to say
# which, and the difference is a device answer on every operand whose top
# bit is set.
#
# `ftoi_sat` and the four suffixed `ftof`s (knife T17) are the same two
# opcodes again, under the `saturating` modifier and the other rounding
# modes, and print as the opcode's own name with the attribute after it.
fn cast_spelling(op: String) -> String =
  if op == "extis" { "exti" } else if op == "ftoi_sat" { "ftoi" } else if str.starts_with(op, "ftof") { "ftof" } else { op }

fn line(i: Instr) -> String = match i {
  MakeTok(dst) -> "${v(dst)} = make_token : token"
  BlockIds(x, y, z) -> "${v(x)}, ${v(y)}, ${v(z)} = get_tile_block_id : tile<i32>"
  ConstInt(dst, t, value) -> "${v(dst)} = constant <${elem_of(t)}: ${int_literal(elem_of(t), value)}> : ${ty(t)}"
  ConstFloat(dst, t, value) -> "${v(dst)} = constant <${elem_of(t)}: ${value}> : ${ty(t)}"
  MulInt(dst, t, lhs, rhs) -> "${v(dst)} = muli ${name(lhs)}, ${name(rhs)} : ${ty(t)}"
  AddInt(dst, t, lhs, rhs) -> "${v(dst)} = addi ${name(lhs)}, ${name(rhs)} : ${ty(t)}"
  Reshape(dst, src, from, to) -> "${v(dst)} = reshape ${name(src)} : ${ty(from)} -> ${ty(to)}"
  Broadcast(dst, src, from, to) -> "${v(dst)} = broadcast ${name(src)} : ${ty(from)} -> ${ty(to)}"
  IotaTile(dst, t) -> "${v(dst)} = iota : ${ty(t)}"
  Offset(dst, ptrs, offs, ptr_ty, off_ty) ->
    "${v(dst)} = offset ${name(ptrs)}, ${name(offs)} : ${ty(ptr_ty)}, ${ty(off_ty)} -> ${ty(ptr_ty)}"
  LoadPtr(dst, tok_out, ptrs, mask, pad, tok_in, ptr_ty, mask_ty, val_ty, hints) ->
    "${v(dst)}, ${v(tok_out)} = load_ptr_tko weak ${name(ptrs)}${opt_operand(mask)}${opt_operand(pad)}"
    ++ " token=${name(tok_in)}${hints_attr(hints)} : ${ty(ptr_ty)}${opt_ty(mask, mask_ty)}${opt_ty(pad, val_ty)}"
    ++ " -> ${ty(val_ty)}, token"
  StorePtr(tok_out, ptrs, value, mask, tok_in, ptr_ty, mask_ty, val_ty, hints) ->
    "${v(tok_out)} = store_ptr_tko weak ${name(ptrs)}, ${name(value)}${opt_operand(mask)}"
    ++ " token=${name(tok_in)}${hints_attr(hints)} : ${ty(ptr_ty)}, ${ty(val_ty)}${opt_ty(mask, mask_ty)} -> token"
  AtomicRMWPtr(dst, tok_out, ptrs, mode, arg, mask, tok_in, ptr_ty, mask_ty, val_ty) ->
    "${v(dst)}, ${v(tok_out)} = atomic_rmw_tko ${rmw_memory(mode)} ${name(ptrs)}, ${rmw_spelling(mode)}, ${name(arg)}"
    ++ "${opt_operand(mask)} token=${name(tok_in)}"
    ++ " : ${ty(ptr_ty)}, ${ty(val_ty)}${opt_ty(mask, mask_ty)} -> ${ty(val_ty)}, token"
  AtomicCASPtr(dst, tok_out, ptrs, cmp, val, mask, tok_in, ptr_ty, mask_ty, val_ty) ->
    "${v(dst)}, ${v(tok_out)} = atomic_cas_tko relaxed device ${name(ptrs)}, ${name(cmp)}, ${name(val)}"
    ++ "${opt_operand(mask)} token=${name(tok_in)}"
    ++ " : ${ty(ptr_ty)}, ${ty(val_ty)}${opt_ty(mask, mask_ty)} -> ${ty(val_ty)}, token"
  FloatUn(dst, op, t, src) ->
    "${v(dst)} = ${float_spelling(op)} ${name(src)}${un_rounding(op)}${float_units(op)} : ${ty(t)}"
  FloatBin(dst, op, t, lhs, rhs) ->
    "${v(dst)} = ${float_spelling(op)} ${name(lhs)}, ${name(rhs)}${rounding(op)}${float_units(op)} : ${ty(t)}"
  FloatFma(dst, t, lhs, rhs, acc) ->
    "${v(dst)} = fma ${name(lhs)}, ${name(rhs)}, ${name(acc)} rounding<nearest_even> : ${ty(t)}"
  FloatMma(dst, t, lhs_ty, rhs_ty, lhs, rhs, acc) ->
    "${v(dst)} = mmaf ${name(lhs)}, ${name(rhs)}, ${name(acc)}"
    ++ " : ${ty(lhs_ty)}, ${ty(rhs_ty)}, ${ty(t)}"
  FloatMmaScaled(dst, t, lhs_ty, rhs_ty, scale_ty, rhs_scale_ty, lhs, rhs, acc, lhs_scale, rhs_scale) ->
    "${v(dst)} = mmaf_scaled ${name(lhs)}, ${name(rhs)}, ${name(acc)}"
    ++ ", ${name(lhs_scale)}, ${name(rhs_scale)}"
    ++ " : ${ty(lhs_ty)}, ${ty(rhs_ty)}, ${ty(t)}, ${ty(scale_ty)}, ${ty(rhs_scale_ty)}"
  IntMma(dst, t, lhs_ty, rhs_ty, lhs, rhs, acc) ->
    "${v(dst)} = mmai ${name(lhs)}, ${name(rhs)}, ${name(acc)} signed signed"
    ++ " : ${ty(lhs_ty)}, ${ty(rhs_ty)}, ${ty(t)}"
  CmpFloat(dst, pred, t, res_ty, lhs, rhs) ->
    "${v(dst)} = cmpf ${predicate(pred)} ${cmp_ordering(pred)} ${name(lhs)}, ${name(rhs)}"
    ++ " : ${ty(t)} -> ${ty(res_ty)}"
  CmpInt(dst, pred, t, res_ty, lhs, rhs) ->
    "${v(dst)} = cmpi ${predicate(pred)} ${name(lhs)}, ${name(rhs)}, signed : ${ty(t)} -> ${ty(res_ty)}"
  IntUn(dst, op, t, src) -> "${v(dst)} = ${op} ${name(src)} : ${ty(t)}"
  IntBin(dst, op, t, lhs, rhs) ->
    "${v(dst)} = ${int_spelling(op)} ${name(lhs)}, ${name(rhs)}${int_signedness(op)}${int_overflow(op)}"
    ++ " : ${ty(t)}"
  Cast(dst, op, from, to, src) ->
    "${v(dst)} = ${cast_spelling(op)} ${name(src)}${cast_attrs(op, elem_of(to))} : ${ty(from)} -> ${ty(to)}"
  SelectTile(dst, cond_ty, t, cond, lhs, rhs) ->
    "${v(dst)} = select ${name(cond)}, ${name(lhs)}, ${name(rhs)} : ${ty(cond_ty)}, ${ty(t)}"
  ForLoop(res, tys, iv, lower, upper, step, unsigned, inits, carried, _body) -> {
    let iters = if len(inits) == 0 {
      ""
    } else {
      let pairs = list.map(range(0, len(inits)), k => "${v(carried[k])} = ${name(inits[k])}")
      " iter_values(${commas(pairs)}) -> (${commas(list.map(tys, ty))})"
    }
    "${results(res)}for ${v(iv)} in (${name(lower)} to ${name(upper)}, step ${name(step)})"
      ++ "${if unsigned { " unsigned" } else { "" }} : tile<i32>${iters} {"
  }
  WhileLoop(res, tys, inits, carried, _body) -> {
    let pairs = list.map(range(0, len(inits)), k => "${v(carried[k])} = ${name(inits[k])}")
    "${results(res)}loop iter_values(${commas(pairs)}) : ${commas(list.map(tys, ty))} -> (${commas(list.map(tys, ty))}) {"
  }
  BreakVals(values, tys) ->
    if len(values) == 0 { "break" } else { "break ${commas(list.map(values, name))} : ${commas(list.map(tys, ty))}" }
  Cont(values, tys) ->
    if len(values) == 0 { "continue" } else { "continue ${commas(list.map(values, name))} : ${commas(list.map(tys, ty))}" }
  ReduceTile(res, tys, dim, identities, operands, operand_tys, args, _body) -> {
    let pairs = list.map(range(0, len(args)), k => "${v(args[k])}: ${ty(rank0_of(operand_tys[k / 2]))}")
    "${results(res)}reduce ${commas(list.map(operands, name))} dim=${dim}"
      ++ " identities=[${commas(list.map(identities, identity))}]"
      ++ " : ${commas(list.map(operand_tys, ty))} -> ${commas(list.map(tys, ty))}"
      ++ " (${commas(pairs)}) {"
  }
  ScanTile(res, tys, dim, reverse, identities, operands, operand_tys, args, _body) -> {
    let pairs = list.map(range(0, len(args)), k => "${v(args[k])}: ${ty(rank0_of(operand_tys[k / 2]))}")
    "${results(res)}scan ${commas(list.map(operands, name))} dim=${dim}"
      ++ " reverse=${if reverse { "true" } else { "false" }}"
      ++ " identities=[${commas(list.map(identities, identity))}]"
      ++ " : ${commas(list.map(operand_tys, ty))} -> ${commas(list.map(tys, ty))}"
      ++ " (${commas(pairs)}) {"
  }
  IfElse(res, tys, cond, _cond_ty, _on_true, _on_false) ->
    if len(tys) == 0 { "if ${name(cond)} {" } else { "${results(res)}if ${name(cond)} -> (${commas(list.map(tys, ty))}) {" }
  YieldVals(values, tys) ->
    if len(values) == 0 { "yield" } else { "yield ${commas(list.map(values, name))} : ${commas(list.map(tys, ty))}" }
  ExtractTile(dst, src, from, to, indices) ->
    "${v(dst)} = extract ${name(src)}[${commas(list.map(indices, name))}] : ${ty(from)} -> ${ty(to)}"
  InsertTile(dst, src, dest, sub, to, indices) ->
    "${v(dst)} = insert ${name(src)}, ${name(dest)}[${commas(list.map(indices, name))}] : ${ty(sub)}, ${ty(to)}"
  FloatPowI(dst, t, exp_ty, base, exp) -> "${v(dst)} = fpowi ${name(base)}, ${name(exp)} : ${ty(t)}, ${ty(exp_ty)}"
  CatTile(dst, dim, lhs, rhs, lhs_ty, rhs_ty, to) ->
    "${v(dst)} = cat ${name(lhs)}, ${name(rhs)} dim = ${dim} : ${ty(lhs_ty)}, ${ty(rhs_ty)} -> ${ty(to)}"
  PermuteTile(dst, src, perm, from, to) ->
    "${v(dst)} = permute ${name(src)} [${commas(list.map(perm, d => "${d}"))}]"
    ++ " : ${ty(from)} -> ${ty(to)}"
  BlockCounts(x, y, z) -> "${v(x)}, ${v(y)}, ${v(z)} = get_num_tile_blocks : tile<i32>"
  JoinTokens(dst, toks) -> "${v(dst)} = join_tokens ${commas(list.map(toks, name))} : token"
  PtrToIntTile(dst, src, from, to) -> "${v(dst)} = ptr_to_int ${name(src)} : ${ty(from)} -> ${ty(to)}"
  IntToPtrTile(dst, src, from, to) -> "${v(dst)} = int_to_ptr ${name(src)} : ${ty(from)} -> ${ty(to)}"
  PtrToPtrTile(dst, src, from, to) -> "${v(dst)} = ptr_to_ptr ${name(src)} : ${ty(from)} -> ${ty(to)}"
  AssertTile(cond, cond_ty, message) -> "assert ${name(cond)}, ${quoted(message)} : ${ty(cond_ty)}"
  AssumeTile(dst, src, pred, t) -> "${v(dst)} = assume ${assume_predicate(pred)}, ${name(src)} : ${ty(t)}"
  PrintTile(tok_out, fmt, args, arg_ty, tok_in) ->
    "${v(tok_out)} = print_tko ${quoted(fmt)}, ${commas(list.map(args, name))}"
    ++ " token=${name(tok_in)} : ${commas(list.map(args, _a => ty(arg_ty)))} -> token"
  GetGlobalPtr(dst, sym, t) -> "${v(dst)} = get_global @${sym} : ${ty(t)}"
  AllocaPtr(dst, num_elem, align, shared, t) ->
    "${v(dst)} = alloca num_elem = ${num_elem}, alignment = ${align}"
    ++ "${if shared { " global" } else { "" }} : ${ty(t)}"
  MakeTensorView(dst, base, _base_ty, t, dyn_shape, dyn_strides, dyn_ty) ->
    "${v(dst)} = make_tensor_view ${name(base)}, shape = [${commas(mixed(view_shape(t), dyn_shape))}]"
    ++ ", strides = [${commas(mixed(view_strides(t), dyn_strides))}] : "
    ++ (if len(dyn_shape) + len(dyn_strides) == 0 { "" } else { "${ty(dyn_ty)} -> " })
    ++ ty(t)
  GetTensorShape(dsts, src, src_ty, res_ty) ->
    "${commas(list.map(dsts, v))} = get_tensor_shape ${name(src)} : ${ty(src_ty)} -> ${ty(res_ty)}"
  GetIndexSpaceShape(dsts, src, src_ty, res_ty) ->
    "${commas(list.map(dsts, v))} = get_index_space_shape ${name(src)} : ${ty(src_ty)}"
    ++ " -> ${ty(res_ty)}"
  MakePartitionView(dst, src, _src_ty, t) -> "${v(dst)} = make_partition_view ${name(src)} : ${ty(t)}"
  MakeStridedView(dst, src, _src_ty, t) -> "${v(dst)} = make_strided_view ${name(src)} : ${ty(t)}"
  MakeGatherScatterView(dst, src, _src_ty, t) ->
    "${v(dst)} = make_gather_scatter_view ${name(src)} : ${ty(t)}"
  LoadViewTile(dst, tok_out, view, view_ty, indices, idx_tys, t, tok_in) ->
    "${v(dst)}, ${v(tok_out)} = load_view_tko weak ${name(view)}[${commas(list.map(indices, name))}]"
    ++ " token=${name(tok_in)} : ${ty(view_ty)}${index_types(idx_tys)} -> ${ty(t)}, token"
  StoreViewTile(tok_out, view, view_ty, value, val_ty, indices, idx_tys, tok_in) ->
    "${v(tok_out)} = store_view_tko weak ${name(value)}, ${name(view)}"
    ++ "[${commas(list.map(indices, name))}] token=${name(tok_in)}"
    ++ " : ${ty(val_ty)}, ${ty(view_ty)}${index_types(idx_tys)} -> token"
  # The value type comes FIRST here, as it does on a store: the dialect's
  # printer puts it there so that its own parser can find the end of the
  # optional index types by looking for the arrow.
  AtomicRedViewTile(tok_out, view, view_ty, value, val_ty, indices, idx_tys, mode, scope,
    tok_in) ->
    "${v(tok_out)} = atomic_red_view_tko relaxed ${scope} ${name(view)}"
    ++ "[${commas(list.map(indices, name))}], ${mode}, ${name(value)} token=${name(tok_in)}"
    ++ " : ${ty(val_ty)}, ${ty(view_ty)}${index_types(idx_tys)} -> token"
  Ret -> "return"
}

# The shape and the strides a `make_tensor_view` states beside its result
# type, as the type's own entries: a number, or `DYN_DIM` where an operand
# carries the value. The operation spells them a second time because the
# dialect lets either be an OPERAND instead, and `mixed` is what puts the
# operands back in.
fn view_shape(t: Ty) -> List[Int] = match t {
  TensorView(_e, shape, _strides) -> shape
  _ -> panic("tileir: `${show(t)}` is not a tensor view and has no shape to print")
}

fn view_strides(t: Ty) -> List[Int] = match t {
  TensorView(_e, _shape, strides) -> strides
  _ -> panic("tileir: `${show(t)}` is not a tensor view and has no strides to print")
}

# `dims` with each `DYN_DIM` replaced by the name of the operand that
# carries it, in order: `MakeTensorViewOp::print`'s `printMixedOperandList`.
# The type prints `?` in the same positions, so the two lists read
# together.
fn mixed(dims: List[Int], dyn: List[Ref]) -> List[String] = {
  var used = 0
  var out: List[String] = []
  for d in dims {
    if d == DYN_DIM {
      out = out ++ [name(dyn[used])]
      used = used + 1
    } else {
      out = out ++ ["${d}"]
    }
  }
  out
}

# An instruction at `indent` columns: one line, or for a region its header,
# its body two columns further in, and the closing brace; an `if` is two
# regions and the brace between them says which is which. Each line comes
# with the operation that owns it, read off `o` (`no_owner()` when nobody
# asked): a region's header and braces are the region operation's, and each
# line of a body is that body's own.
fn lines(indent: String, i: Instr, o: Owner) -> List[(String, Int)] = match i {
  ForLoop(_res, _tys, _iv, _lower, _upper, _step, _unsigned, _inits, _carried, body) ->
    [(indent ++ line(i), o.op)] ++ block(indent ++ "  ", body, inner_of(o, 0)) ++ [(indent ++ "}", o.op)]
  WhileLoop(_res, _tys, _inits, _carried, body) ->
    [(indent ++ line(i), o.op)] ++ block(indent ++ "  ", body, inner_of(o, 0)) ++ [(indent ++ "}", o.op)]
  ReduceTile(_res, _tys, _dim, _identities, _operands, _operand_tys, _args, body) ->
    [(indent ++ line(i), o.op)] ++ block(indent ++ "  ", body, inner_of(o, 0)) ++ [(indent ++ "}", o.op)]
  ScanTile(_res, _tys, _dim, _reverse, _identities, _operands, _operand_tys, _args, body) ->
    [(indent ++ line(i), o.op)] ++ block(indent ++ "  ", body, inner_of(o, 0)) ++ [(indent ++ "}", o.op)]
  IfElse(_res, _tys, _cond, _cond_ty, on_true, on_false) ->
    [(indent ++ line(i), o.op)] ++ block(indent ++ "  ", on_true, inner_of(o, 0)) ++ [(indent ++ "} else {", o.op)]
    ++ block(indent ++ "  ", on_false, inner_of(o, 1)) ++ [(indent ++ "}", o.op)]
  _ -> [(indent ++ line(i), o.op)]
}

fn block(indent: String, body: List[Instr], owners: List[Owner]) -> List[(String, Int)] = {
  let none: List[(String, Int)] = []
  list.fold(range(0, len(body)), none, (acc, k) => acc ++ lines(indent, body[k], owner_at(owners, k)))
}

# The owner of a line no operation issued, and of every line when the
# caller did not ask (`render_kernel`).
fn no_owner() -> Owner = Owner { op: 0 - 1, inner: [] }

fn owner_at(owners: List[Owner], k: Int) -> Owner = if k < len(owners) { owners[k] } else { no_owner() }

fn inner_of(o: Owner, k: Int) -> List[Owner] = if k < len(o.inner) { o.inner[k] } else { [] }

fn join(lines: List[String]) -> String = list.fold(lines, "", (acc, l) => acc ++ l ++ "\n")

# One `global` declaration, in the order GlobalOp's assembly format puts the
# pieces: the visibility keyword, then `constant`, then the name, then
# `alignment = n`, then the initializer and its type.
#
# `public` prints as NOTHING and `private` prints as a keyword, which is the
# dialect's own printer and not a choice here (CudaTile.cpp's
# printSymbolVisibility omits the default in as many words). Both of those
# words, and `constant`, became writable at bytecode 13.3, which knife T8
# pinned; before it the record had no field to put them in.
#
# `alignment = n` appears only when it is not the dialect's default 0. The
# element values are spelled the way `ConstFloat` spells a splat, which is
# this renderer's own spelling and not MLIR's printer's (`1.5` where it would
# print `1.500000e+00`); `tileiras` reads bytecode and never this text, so
# the text's job is to be read by a person.
fn global_line(g: Global) -> String = {
  let t = Tile([len(g.values)], Num(g.dtype))
  let vis = if g.is_private { "private " } else { "" }
  let ro = if g.constant { "constant " } else { "" }
  let align = if g.align == 0 { "" } else { "alignment = ${g.align} " }
  let vals = list.fold(range(0, len(g.values)), "", (acc, k) =>
      if acc == "" { "${g.values[k]}" } else { acc ++ ", ${g.values[k]}" })
  "  global ${vis}${ro}@${g.sym} ${align}<${g.dtype}: [${vals}]> : ${ty(t)}"
}

## `k` as one `cuda_tile.module @m` holding its globals and one
## `entry @<name>`. Every parameter is a scalar pointer tile of its dtype;
## the body is `k.body` in order, one line each. The globals come first,
## because `global` operations are directly nested in the module and the
## `get_global` in the entry names them. The text ends with a newline.
pub fn render_kernel(k: Kernel) -> String = {
  let (text, _owners) = kernel_lines(k, [])
  join(text)
}

# The lines `render_kernel` joins, and beside them the operation each line
# is owned by, from `owners` (`lower_spans`' table for `k.body`), or -1: the
# module, the globals, the entry, the closing `return` and the two braces,
# and every line when `owners` is empty. The one place the text is laid out,
# so the owners are the text's and not a recount of it.
fn kernel_lines(k: Kernel, owners: List[Owner]) -> (List[String], List[Int]) = {
  var args: List[String] = []
  var i = 0
  for dt in k.params {
    args = args ++ ["%arg${i}: ${ty(Tile([], PtrTo(dt)))}"]
    i = i + 1
  }
  let head = commas(args)
  let top = ["cuda_tile.module @m {"] ++ list.map(k.globals, global_line)
    ++ ["  entry @${k.name}(${head})${hints_attr(k.hints)} {"]
  let body = block("    ", k.body, owners)
  let text = top ++ list.map(body, x => {
    let (t, _o) = x
    t
  }) ++ ["  }", "}"]
  let own = list.map(top, _t => 0 - 1) ++ list.map(body, x => {
    let (_t, o) = x
    o
  }) ++ [0 - 1, 0 - 1]
  (text, own)
}

## The lines of `render(prog)` one call the kernel made is answerable for,
## its children's left out: its globals' lines and the lines of the
## operations it issued itself, each a 1-based half-open range, in text
## order, empty ranges left out. `parent` is the call's row's `parent`, so
## the rows are the side table's tree. A region call (`d_range`, `d_scan`)
## has the region's header line, its terminator and its closing brace; the
## lines between are its children's.
pub type CallLines = { name: String, parent: Int, lines: List[(Int, Int)] } derive Show

## `render(prog)` cut into who wrote each line. `head` is the module line,
## the entry line and `make_token`, which no call issued; `calls` is one row
## per row of `trace_calls`' side table, in its order; `tail` is `return`
## and the two closing braces. Every line of `text` is in exactly one of
## them.
pub type LineMap = { text: String, head: List[(Int, Int)], calls: List[CallLines], tail: (Int, Int) } derive Show

## The line map of `prog` from the side table `calls` that `trace_calls`
## answered with it: operations through `lower_spans` to instructions,
## instructions through the layout `render_kernel` uses to lines, and every
## operation to the innermost call whose range holds it. An `Err` names the
## first thing that does not fit: a row whose range is not inside its
## parent's, two rows of one parent that overlap, or an operation or a
## global no call issued, which is what a body that calls `t_*` directly, or
## a side table that is not this program's, looks like.
pub fn line_map(prog: TileProg, calls: List[Call]) -> Result[LineMap, String] = {
  let (k, owners) = lower_spans(prog)
  let (text, line_ops) = kernel_lines(k, owners)
  let n_ops = op_count(prog.ops)
  let n_globals = len(prog.globals)
  match tree_fault(prog.name, calls, n_ops, n_globals) {
    Some(e) -> Err(e)
    None -> {
      # the innermost row holding each operation and each global: a later
      # row is deeper than every row it is inside, and two rows of one
      # parent do not overlap, so the last row to claim one is its owner
      let op_row = list.fold(range(0, len(calls)), list.map(range(0, n_ops), _x => 0 - 1), (acc, j) => {
        let c = calls[j]
        list.map(range(0, n_ops), p => if p >= c.ops_from && p < c.ops_to { j } else { acc[p] })
      })
      let global_row = list.fold(range(0, len(calls)), list.map(range(0, n_globals), _x => 0 - 1), (acc, j) => {
        let c = calls[j]
        list.map(range(0, n_globals), g => if g >= c.globals_from && g < c.globals_to { j } else { acc[g] })
      })
      let lost_op = list.find(range(1, n_ops), p => op_row[p] < 0)
      let lost_global = list.find(range(0, n_globals), g => global_row[g] < 0)
      match (lost_op, lost_global) {
        (Some(p), _) -> Err("operation #${p} of `${prog.name}` belongs to no public call")
        (None, Some(g)) -> Err("global ${g} of `${prog.name}` belongs to no public call")
        (None, None) -> {
          # who owns each line: -2 the head, -3 the tail, else a row
          let entry = 2 + n_globals
          let n_lines = len(text)
          let who = list.map(range(1, n_lines + 1), n => {
            let op = line_ops[n - 1]
            if n == 1 || n == entry {
              0 - 2
            } else if n < entry {
              global_row[n - 2]
            } else if op == 0 {
              0 - 2
            } else if op > 0 {
              op_row[op]
            } else {
              0 - 3
            }
          })
          let ranges_of = (w: Int) => merge_ranges(list.map(list.filter(range(1, n_lines + 1), n => who[n - 1] == w), n => (n, n + 1)))
          let tail = ranges_of(0 - 3)
          if len(tail) != 1 {
            Err("`${prog.name}`'s text has lines no operation owns before its end")
          } else {
            let rows = list.map(range(0, len(calls)), j => CallLines { name: calls[j].name, parent: calls[j].parent, lines: ranges_of(j) })
            Ok(LineMap { text: join(text), head: ranges_of(0 - 2), calls: rows, tail: tail[0] })
          }
        }
      }
    }
  }
}

# The first way `calls` is not a tree of nested ranges over a program of
# `n_ops` operations and `n_globals` globals, or `None`: every row's parent
# is an earlier row or -1, its ranges are inside its parent's (or the
# program's), and it starts no earlier than where the previous row of the
# same parent ended.
fn tree_fault(name: String, calls: List[Call], n_ops: Int, n_globals: Int) -> Option[String] = {
  var fault: Option[String] = None
  var j = 0
  for c in calls {
    let here = j
    let (lo, hi, glo, ghi) =
      if c.parent >= 0 && c.parent < here {
        let p = calls[c.parent]
        (p.ops_from, p.ops_to, p.globals_from, p.globals_to)
      } else {
        (1, n_ops, 0, n_globals)
      }
    let prev = list.filter(list.take(calls, here), x => x.parent == c.parent)
    let (after, gafter) = if len(prev) == 0 { (lo, glo) } else { (prev[len(prev) - 1].ops_to, prev[len(prev) - 1].globals_to) }
    let why =
      if c.parent < 0 - 1 || c.parent >= here {
        Some("row ${here} (`${c.name}`) names row ${c.parent} as its parent")
      } else if c.ops_from > c.ops_to || c.globals_from > c.globals_to {
        Some("row ${here} (`${c.name}`) ends before it starts")
      } else if c.ops_from < after || c.ops_to > hi || c.globals_from < gafter || c.globals_to > ghi {
        Some("row ${here} (`${c.name}`) is not inside its parent, or overlaps the row before it, in `${name}`")
      } else {
        let fine: Option[String] = None
        fine
      }
    match fault {
      None -> {
        fault = why
      }
      Some(_f) -> ()
    }
    j = j + 1
  }
  fault
}

# Adjacent ranges joined and empty ones dropped, order kept.
fn merge_ranges(rs: List[(Int, Int)]) -> List[(Int, Int)] = {
  let none: List[(Int, Int)] = []
  list.fold(rs, none, (acc, r) => {
    let (a, b) = r
    if a >= b {
      acc
    } else if len(acc) > 0 {
      let (pa, pb) = acc[len(acc) - 1]
      if pb == a { list.take(acc, len(acc) - 1) ++ [(pa, b)] } else { acc ++ [r] }
    } else {
      acc ++ [r]
    }
  })
}

## `prog` lowered and rendered.
pub fn render(prog: TileProg) -> String = render_kernel(lower(prog))

# ---- tests ----
#
# The byte-for-byte pin is scripts/tile-golden (both backends, against the
# recorded .mlir). These blocks pin the pieces a golden diff would only show
# as a whole: the ladder is emitted once per parameter, the token chain is the
# program's, and the value names are the table's numbers.

fn two_loads_one_param() -> TileProg = TileProg {
  hints: [],
  name: "twice",
  params: ["f64"],
  globals: [],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 128),
    IdxMul(3, 1, 2),
    Load(4, 5, 0, "f64", 3, [128], [1], None, None, 0, []),
    Load(6, 7, 0, "f64", 3, [128], [1], None, None, 5, []),
    BinaryF(8, "addf", "f64", [128], 4, 6),
    Store(9, 0, "f64", 3, [128], [1], 8, None, 7, [])
  ]
}

fn count(hay: String, needle: String) -> Int = len(str.split(hay, needle)) - 1

test "the pointer ladder for one parameter at one index is emitted once, not once per memory operation" {
  let text = render(two_loads_one_param())
  assert count(text, " = offset ") == 1
  assert count(text, " = iota ") == 1
  assert count(text, "load_ptr_tko weak ") == 2
  assert count(text, "store_ptr_tko weak ") == 1
}

test "the token chain in the text is the program's: make_token feeds the first load, each memory op feeds the next" {
  let text = render(two_loads_one_param())
  assert str.contains(text, "%0 = make_token : token\n")
  assert str.contains(text, "%13, %14 = load_ptr_tko weak %12 token=%0 :")
  assert str.contains(text, "%15, %16 = load_ptr_tko weak %12 token=%14 :")
  assert str.contains(text, "%18 = store_ptr_tko weak %12, %17 token=%16 :")
  assert str.contains(text, "%17 = addf %13, %15 rounding<nearest_even> : tile<128xf64>\n")
}

test "an atomic spells its ordering, its scope and (for the rmw) its mode, and answers a value and a token" {
  let p = TileProg {
    hints: [],
    name: "atomics",
    params: ["i32", "i32"],
    globals: [],
    ops: [
      MakeToken(0),
      IdxConst(1, 0),
      Load(2, 3, 0, "i32", 1, [8], [1], None, None, 0, []),
      ConstI(4, "i32", [8], 1),
      CmpI(5, "lt", [8], 2, 4),
      AtomicRMW(6, 7, 0, "i32", "add", 2, [8], 4, Some(5), 3),
      AtomicCAS(8, 9, 1, "i32", 2, [8], 4, 6, None, 7)
    ]
  }
  let text = render(p)
  # the mask is an operand AND a type, and it stands between the value
  # operand and the token, which is the order the assembly format gives
  assert str.contains(text,
    " = atomic_rmw_tko relaxed device %15, add, %11, %12 token=%10"
      ++ " : tile<8xptr<i32>>, tile<8xi32>, tile<8xi1> -> tile<8xi32>, token\n")
  # the compare-and-swap has THREE tile operands and no mode
  assert str.contains(text,
    " = atomic_cas_tko relaxed device %20, %11, %16 token=%17"
      ++ " : tile<8xptr<i32>>, tile<8xi32> -> tile<8xi32>, token\n")
  # each answers two results, and the token of the first feeds the second
  assert count(text, "atomic_rmw_tko") == 1
  assert count(text, "atomic_cas_tko") == 1
}

test "the entry signature lists every parameter as a scalar pointer tile of its format" {
  let p = TileProg { hints: [], name: "k", params: ["f32", "f64"], globals: [], ops: [MakeToken(0)] }
  let text = render(p)
  assert str.starts_with(text, "cuda_tile.module @m {\n  entry @k(%arg0: tile<ptr<f32>>, %arg1: tile<ptr<f64>>) {\n")
  assert str.ends_with(text, "    return\n  }\n}\n")
}

test "block ids along the three axes bind the matching result of one get_tile_block_id" {
  let p = TileProg {
    hints: [],
    name: "axes",
    params: ["f64"],
    globals: [],
    ops: [MakeToken(0), BlockId(1, 2), IdxConst(2, 8), IdxMul(3, 1, 2),
      Load(4, 5, 0, "f64", 3, [8], [1], None, None, 0, [])]
  }
  let text = render(p)
  assert str.contains(text, "%1, %2, %3 = get_tile_block_id : tile<i32>\n")
  assert str.contains(text, "= muli %3, %4 : tile<i32>\n")
}

test "types are spelled as the assembly spells them" {
  assert ty(Token) == "token"
  assert ty(Tile([], Num("i32"))) == "tile<i32>"
  assert ty(Tile([64], PtrTo("f32"))) == "tile<64xptr<f32>>"
}

test "rendering the same program twice gives the same text" {
  assert render(two_loads_one_param()) == render(two_loads_one_param())
}

fn sum_prog() -> TileProg = TileProg {
  hints: [],
  name: "sum",
  params: ["f64", "f64"],
  globals: [],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 4),
    IdxMul(3, 1, 2),
    IdxConst(4, 128),
    IdxMul(5, 3, 4),
    Load(6, 7, 0, "f64", 5, [128], [1], None, None, 0, []),
    IdxConst(8, 1),
    IdxAdd(9, 3, 8),
    IdxAdd(10, 3, 2),
    For(11, 9, 10, 8, false, [6, 7], [12, 13], [19, 20], [
      IdxConst(14, 128),
      IdxMul(15, 11, 14),
      Load(16, 17, 0, "f64", 15, [128], [1], None, None, 13, []),
      BinaryF(18, "addf", "f64", [128], 12, 16),
      Continue([18, 17])
    ]),
    IdxConst(21, 128),
    IdxMul(22, 1, 21),
    Store(23, 1, "f64", 22, [128], [1], 19, None, 20, [])
  ]
}

test "a loop is its header with the carried values, a body two columns in, and a closing brace" {
  let text = render(sum_prog())
  assert str.contains(text, "\n    %20, %21 = for %22 in (%18 to %19, step %17) : tile<i32> iter_values(%23 = %15, %24 = %16) -> (tile<128xf64>, token) {\n")
  assert str.contains(text, "\n      %34, %35 = load_ptr_tko weak %33 token=%24 : tile<128xptr<f64>> -> tile<128xf64>, token\n")
  assert str.contains(text, "\n      %36 = addf %23, %34 rounding<nearest_even> : tile<128xf64>\n")
  assert str.contains(text, "\n      continue %36, %35 : tile<128xf64>, token\n    }\n")
  # after the loop, the store takes the loop's results
  assert str.contains(text, "store_ptr_tko weak %45, %20 token=%21 :")
  assert str.ends_with(text, "    return\n  }\n}\n")
}

fn spin_prog() -> TileProg = TileProg {
  hints: [],
  name: "spin",
  params: ["f64", "f64"],
  globals: [],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 8),
    IdxMul(3, 1, 2),
    Load(4, 5, 0, "f64", 3, [8], [1], None, None, 0, []),
    Loop([4, 5], [6, 7], [8, 9], [
      ConstI(10, "i1", [], 1),
      BinaryF(11, "addf", "f64", [8], 6, 6),
      If([], 10, [Break([6, 7])], [Yield([])]),
      Continue([11, 7])
    ]),
    Store(12, 1, "f64", 3, [8], [1], 8, None, 9, [])
  ]
}

test "a loop is its header with the carried values, an if that breaks, and the continue after it" {
  let text = render(spin_prog())
  assert str.contains(text, "\n    %15, %16 = loop iter_values(%17 = %13, %18 = %14) : tile<8xf64>, token -> (tile<8xf64>, token) {\n")
  # the exit: an `if` with no results, a break in one branch and an empty
  # yield in the other. The dialect's own spelling for both.
  assert str.contains(text, "\n      if %19 {\n        break %17, %18 : tile<8xf64>, token\n      } else {\n        yield\n      }\n")
  assert str.contains(text, "\n      continue %20, %18 : tile<8xf64>, token\n    }\n")
  # after the loop, the store takes the loop's results
  assert str.contains(text, "store_ptr_tko weak %23, %15 token=%16 :")
}

test "an early return inside a loop is an if around the dialect's bare return, and the conversions print the modifier and the mode" {
  let p = TileProg {
    hints: [],
    name: "t17",
    params: ["f64", "i32"],
    globals: [],
    ops: [
      MakeToken(0),
      BlockId(1, 0),
      IdxConst(2, 8),
      IdxMul(3, 1, 2),
      Load(4, 5, 0, "f64", 3, [8], [1], None, None, 0, []),
      Loop([4, 5], [6, 7], [8, 9], [
        ConstI(10, "i1", [], 1),
        If([], 10, [Return], [Yield([])]),
        BinaryF(11, "addf", "f64", [8], 6, 6),
        If([], 10, [Break([6, 7])], [Yield([])]),
        Continue([11, 7])
      ]),
      Convert(12, "ftoi_sat", "f64", "i32", [8], 8),
      Convert(13, "ftof_away", "f64", "f32", [8], 8),
      Store(14, 1, "i32", 3, [8], [1], 12, None, 9, [])
    ]
  }
  let text = render(p)
  # the then-branch is `return` with no operands, the 13.1 spelling, in the
  # place 13.4 first allowed it
  assert str.contains(text, "\n      if %19 {\n        return\n      } else {\n        yield\n      }\n")
  # the saturating modifier after the rounding mode, Ops.td's own order
  assert str.contains(text, " = ftoi %15 signed rounding<nearest_int_to_zero> saturating : tile<8xf64> -> tile<8xi32>\n")
  # (f64 to f32 does not take this mode; the recording holds that table and
  # refuses it, the renderer only spells what it is given)
  assert str.contains(text, " = ftof %15 rounding<nearest_away> : tile<8xf64> -> tile<8xf32>\n")
}

fn total_prog() -> TileProg = TileProg {
  hints: [],
  name: "total",
  params: ["f64", "f64"],
  globals: [],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 8),
    IdxMul(3, 1, 2),
    Load(4, 5, 0, "f64", 3, [8], [1], None, None, 0, []),
    Reduce([9], 0, [8], [IdF("f64", 0.0)], [4], [6, 7], [
      BinaryF(8, "addf", "f64", [], 6, 7),
      Yield([8])
    ]),
    Spread(10, "f64", [1], 9),
    Store(11, 1, "f64", 3, [1], [1], 10, None, 5, [])
  ]
}

test "a reduction is its header with the dimension, the identities and the region arguments, a body two columns in, and a closing brace" {
  let text = render(total_prog())
  assert str.contains(text, "\n    %15 = reduce %13 dim=0 identities=[0.0 : f64] : tile<8xf64> -> tile<f64>"
      ++ " (%16: tile<f64>, %17: tile<f64>) {\n")
  assert str.contains(text, "\n      %18 = addf %16, %17 rounding<nearest_even> : tile<f64>\n")
  assert str.contains(text, "\n      yield %18 : tile<f64>\n    }\n")
  # spread is a reshape to one lane and a broadcast to the width
  assert str.contains(text, "\n    %19 = reshape %15 : tile<f64> -> tile<1xf64>\n")
  assert str.contains(text, "\n    %20 = broadcast %19 : tile<1xf64> -> tile<1xf64>\n")
}

fn branch_prog() -> TileProg = TileProg {
  hints: [],
  name: "branch",
  params: ["f64", "f64"],
  globals: [],
  ops: [
    MakeToken(0),
    BlockId(1, 0),
    IdxConst(2, 8),
    IdxMul(3, 1, 2),
    Load(4, 5, 0, "f64", 3, [8], [1], None, None, 0, []),
    IdxConst(6, 0),
    CmpI(7, "eq", [], 1, 6),
    If([10], 7, [BinaryF(8, "addf", "f64", [8], 4, 4), Yield([8])],
      [BinaryF(9, "mulf", "f64", [8], 4, 4), Yield([9])]),
    Store(11, 1, "f64", 3, [8], [1], 10, None, 5, [])
  ]
}

test "an if is its header with the result types, two bodies and the brace between them" {
  let text = render(branch_prog())
  # the condition is a rank-0 comparison: tile<i1>, not tile<Nxi1>
  assert str.contains(text, "\n    %16 = cmpi equal %1, %15, signed : tile<i32> -> tile<i1>\n")
  assert str.contains(text, "\n    %17 = if %16 -> (tile<8xf64>) {\n")
  assert str.contains(text, "\n      yield %18 : tile<8xf64>\n    } else {\n")
  assert str.contains(text, "\n      %19 = mulf %13, %13 rounding<nearest_even> : tile<8xf64>\n")
  assert str.contains(text, "\n      yield %19 : tile<8xf64>\n    }\n")
}

test "the transcendentals spell the modifiers they carry and no others" {
  # sqrt prints its rounding mode; tanh's only f64 mode is `full`, which is
  # its default and which the dialect's own printer leaves out; exp has no
  # such field at all before bytecode 13.3; exp2 and rsqrt take
  # flush_to_zero, which is never set here
  let p = TileProg {
    hints: [],
    name: "m",
    params: ["f64"],
    globals: [],
    ops: [
      MakeToken(0),
      BlockId(1, 0),
      IdxConst(2, 8),
      IdxMul(3, 1, 2),
      Load(4, 5, 0, "f64", 3, [8], [1], None, None, 0, []),
      UnaryF(6, "exp", "f64", [8], 4),
      UnaryF(7, "exp2", "f64", [8], 4),
      UnaryF(8, "sqrt", "f64", [8], 4),
      UnaryF(9, "rsqrt", "f64", [8], 4),
      UnaryF(10, "tanh", "f64", [8], 4),
      UnaryF(11, "floor", "f64", [8], 4),
      UnaryF(12, "ceil", "f64", [8], 4),
      BinaryF(13, "pow", "f64", [8], 4, 4)
    ]
  }
  let text = render(p)
  assert str.contains(text, "\n    %15 = exp %13 : tile<8xf64>\n")
  assert str.contains(text, "\n    %16 = exp2 %13 : tile<8xf64>\n")
  assert str.contains(text, "\n    %17 = sqrt %13 rounding<nearest_even> : tile<8xf64>\n")
  assert str.contains(text, "\n    %18 = rsqrt %13 : tile<8xf64>\n")
  assert str.contains(text, "\n    %19 = tanh %13 : tile<8xf64>\n")
  assert str.contains(text, "\n    %20 = floor %13 : tile<8xf64>\n")
  assert str.contains(text, "\n    %21 = ceil %13 : tile<8xf64>\n")
  assert str.contains(text, "\n    %22 = fpowf %13, %13 : tile<8xf64>\n")
}

test "assert, assume and print_tko spell the dialect's own assembly, predicate prefix dropped and format string escaped" {
  let none: Option[Int] = None
  let p = TileProg {
    hints: [],
    name: "dbg",
    params: ["i32", "i32"],
    globals: [],
    ops: [
      MakeToken(0),
      BlockId(1, 0),
      IdxConst(2, 8),
      IdxMul(3, 1, 2),
      Load(4, 5, 0, "i32", 3, [8], [1], None, None, 0, []),
      CmpI(6, "lt", [8], 4, 4),
      Assert([8], 6, "a lane\nwent \"wrong\""),
      Assume(7, DivBy(32, none, none), "i32", [8], 4),
      Assume(8, DivBy(32, Some(4), Some(0)), "i32", [8], 4),
      Assume(9, SameElements([2]), "i32", [8], 4),
      Assume(10, Bounded(Some(0), none), "i32", [8], 4),
      Assume(11, Bounded(none, Some(7)), "i32", [8], 4),
      Spread(12, "i32", [8], 4),
      Print(13, "sum=%d and %% more\n", "i32", [], [12], 5)
    ]
  }
  let text = render(p)
  # `assert` has no result and prints its condition, the message and the
  # condition's type.
  assert str.contains(text, ", \"a lane\\nwent \\\"wrong\\\"\" : tile<8xi1>\n")
  assert str.contains(text, "\n    assert %")
  # `custom<AssumePredicate>` prints the attribute without its
  # `#cuda_tile.` prefix (CudaTile.cpp), and an absent bound is `?`.
  assert str.contains(text, " = assume div_by<32>, %13 : tile<8xi32>\n")
  assert str.contains(text, " = assume div_by<32, every 4 along 0>, %13 : tile<8xi32>\n")
  assert str.contains(text, " = assume same_elements<[2]>, %13 : tile<8xi32>\n")
  assert str.contains(text, " = assume bounded<0, ?>, %13 : tile<8xi32>\n")
  assert str.contains(text, " = assume bounded<?, 7>, %13 : tile<8xi32>\n")
  # `print_tko` prints its format, its operands, the token it takes and the
  # token it answers. `%%` is an escaped percent and takes no operand, so
  # one operand is right for this string.
  assert str.contains(text, " = print_tko \"sum=%d and %% more\\n\", %22 token=%14 : tile<i32> -> token\n")
}

test "an i32 constant prints what the tile holds, not what the kernel spelled" {
  # 0x9E3779B1 is a hash multiplier, and a host Int holds it as 2654435761;
  # an i32 lane holds -1640531527, which is what the writer's low 32 bits
  # have always said. An in-range constant and an i1 one are untouched.
  assert int_literal("i32", 2654435761) == 0 - 1640531535
  assert int_literal("i32", 4294967295) == 0 - 1
  assert int_literal("i32", 0 - 1) == 0 - 1
  assert int_literal("i32", 1000) == 1000
  assert int_literal("i32", 2147483647) == 2147483647
  assert int_literal("i1", 1) == 1
}

test "index arithmetic spells as scalar i32 constant, addi and muli" {
  let text = render(sum_prog())
  assert str.contains(text, "\n    %4 = constant <i32: 4> : tile<i32>\n    %5 = muli %1, %4 : tile<i32>\n")
  assert str.contains(text, "\n    %18 = addi %5, %17 : tile<i32>\n    %19 = addi %5, %4 : tile<i32>\n")
}

test "the shape operations spell the dialect's own assembly: brackets on extract, `dim =` on cat, a bare list on permute" {
  let p = TileProg {
    hints: [],
    name: "shapes",
    params: ["f64", "f64"],
    globals: [],
    ops: [
      MakeToken(0),
      BlockId(1, 0),
      NumBlocks(2, 0),
      Load(3, 4, 0, "f64", 1, [4, 4, 8], [32, 8, 1], None, None, 0, []),
      Permute(5, "f64", [4, 4, 8], [1, 0, 2], 3),
      IdxConst(6, 1),
      IdxConst(7, 0),
      Extract(8, "f64", [4, 4, 8], [2, 4, 8], 3, [6, 7, 7]),
      Extract(9, "f64", [4, 4, 8], [2, 4, 8], 3, [7, 7, 7]),
      Cat(10, "f64", 0, [2, 4, 8], [2, 4, 8], 8, 9),
      Store(11, 1, "f64", 1, [4, 4, 8], [32, 8, 1], 10, None, 4, [])
    ]
  }
  let text = render(p)
  # a permutation whose two swapped dimensions are equal keeps the shape,
  # which is what lets a wrong permutation be a wrong ANSWER here
  assert str.contains(text, " = permute %28 [1, 0, 2] : tile<4x4x8xf64> -> tile<4x4x8xf64>\n")
  assert str.contains(text, " = extract %28[%31, %32, %32] : tile<4x4x8xf64> -> tile<2x4x8xf64>\n")
  assert str.contains(text, " dim = 0 : tile<2x4x8xf64>, tile<2x4x8xf64> -> tile<4x4x8xf64>\n")
  assert str.contains(text, "%4, %5, %6 = get_num_tile_blocks : tile<i32>\n")
  assert count(text, "get_num_tile_blocks") == 1
  assert count(text, "get_tile_block_id") == 1
}

test "insert names its subtile, its destination in brackets and both types, and fpowi both formats" {
  let p = TileProg {
    hints: [],
    name: "t16",
    params: ["f64", "i32", "f64"],
    globals: [],
    ops: [
      MakeToken(0),
      BlockId(1, 0),
      Load(2, 3, 0, "f64", 1, [16, 8], [8, 1], None, None, 0, []),
      IdxConst(4, 1),
      IdxConst(5, 0),
      Extract(6, "f64", [16, 8], [8, 4], 2, [4, 5]),
      Insert(7, "f64", [8, 4], [16, 8], 6, 2, [5, 4]),
      Store(8, 2, "f64", 1, [16, 8], [8, 1], 7, None, 3, []),
      Load(9, 10, 0, "f64", 1, [128], [1], None, None, 8, []),
      Load(11, 12, 1, "i32", 1, [128], [1], None, None, 10, []),
      PowI(13, "f64", "i32", [128], 9, 11),
      Store(14, 2, "f64", 1, [128], [1], 13, None, 12, [])
    ]
  }
  let text = render(p)
  # the spelling `tileirdisasm` 13.4.92 prints for the same bytes
  # the subtile first, then the destination with the slice indices in
  # brackets, and the two types in that order: `insert` writes no `->`
  assert str.contains(text, "\n    %24 = insert %23, %19[%22, %21] : tile<8x4xf64>, tile<16x8xf64>\n")
  assert count(text, " = insert ") == 1
  # the base's type, then the exponent's, which is the one float operation
  # here whose two operands print two formats
  assert str.contains(text, "\n    %43 = fpowi %36, %41 : tile<128xf64>, tile<128xi32>\n")
}

test "the pointer surface spells the ladder a body built, its three conversions and a load through it" {
  let p = TileProg {
    hints: [],
    name: "ptrs",
    params: ["f64", "i32"],
    globals: [],
    ops: [
      MakeToken(0),
      BlockId(1, 0),
      MakePtrs(2, 0, "f64", [8]),
      Lanes(3, 1, [8], [1]),
      PtrAdd(4, "f64", [8], 2, 3),
      PtrInt(5, "f64", [8], 4),
      ConstI(6, "i64", [8], 24),
      BinaryI(7, "addi", "i64", [8], 5, 6),
      IntPtr(8, "f64", [8], 7),
      LoadAt(9, 10, "f64", [8], 8, None, None, 0),
      PtrCast(11, "f64", "i32", [8], 4),
      LoadAt(12, 13, "i32", [8], 11, None, None, 10),
      Store(14, 1, "i32", 1, [8], [1], 12, None, 13, [])
    ]
  }
  let text = render(p)
  assert str.contains(text, " = ptr_to_int %10 : tile<8xptr<f64>> -> tile<8xi64>\n")
  assert str.contains(text, " = int_to_ptr %13 : tile<8xi64> -> tile<8xptr<f64>>\n")
  assert str.contains(text, " = ptr_to_ptr %10 : tile<8xptr<f64>> -> tile<8xptr<i32>>\n")
  assert str.contains(text, " = addi %11, %12 : tile<8xi64>\n")
  # the body's own pointer tile is the reshape-and-broadcast the strided
  # ladder opens with, and the offset is the one instruction it ends with
  assert count(text, " = offset ") == 2
  assert count(text, "load_ptr_tko weak ") == 2
}

test "a fork issues two stores from one token and joins them before the load that follows" {
  let p = TileProg {
    hints: [],
    name: "fork",
    params: ["f64", "f64"],
    globals: [],
    ops: [
      MakeToken(0),
      BlockId(1, 0),
      ConstF(2, "f64", [8], 1.0),
      Store(3, 1, "f64", 1, [8], [1], 2, None, 0, []),
      Store(4, 1, "f64", 1, [8], [1], 2, None, 0, []),
      JoinToks(5, [3, 4]),
      Load(6, 7, 1, "f64", 1, [8], [1], None, None, 5, [])
    ]
  }
  let text = render(p)
  # both stores take %0, the entry token; the join takes both their tokens
  # and the load takes the join
  assert count(text, "token=%0 ") == 2
  assert str.contains(text, " = join_tokens %12, %13 : token\n")
  assert str.contains(text, "token=%14 :")
}

fn globals_prog() -> TileProg = TileProg {
  hints: [],
  name: "g",
  params: ["f64"],
  globals: [
    Global { sym: "tbl", dtype: "f64", values: [1.0, 2.5], align: 0, is_private: false, constant: false },
    Global { sym: "pad", dtype: "i32", values: [7.0], align: 128, is_private: false, constant: false },
    Global { sym: "hid", dtype: "f64", values: [3.0], align: 0, is_private: true, constant: false },
    Global { sym: "ro", dtype: "f64", values: [4.0], align: 0, is_private: false, constant: true },
    Global { sym: "both", dtype: "f64", values: [5.0], align: 64, is_private: true, constant: true }
  ],
  ops: [MakeToken(0), GetGlobal(1, "tbl", "f64", [8])]
}

test "a global prints above the entry, its alignment only when it is not the dialect's default, and get_global names the symbol" {
  let text = render(globals_prog())
  # the visibility keyword is absent on a public global: the dialect's own
  # printer omits the default (CudaTile.cpp's printSymbolVisibility)
  assert str.contains(text, "cuda_tile.module @m {\n  global @tbl <f64: [1.0, 2.5]> : tile<2xf64>\n")
  assert str.contains(text, "  global @pad alignment = 128 <i32: [7.0]> : tile<1xi32>\n")
  assert not str.contains(text, "public")
  # knife T8: the two words the record grew room for at 13.3, in the order
  # the assembly format puts them, and both before the symbol
  assert str.contains(text, "  global private @hid <f64: [3.0]> : tile<1xf64>\n")
  assert str.contains(text, "  global constant @ro <f64: [4.0]> : tile<1xf64>\n")
  assert str.contains(text, "  global private constant @both alignment = 64 <f64: [5.0]> : tile<1xf64>\n")
  # get_global answers a rank-0 pointer tile; the reshape and broadcast
  # after it are the same two the parameter ladder emits
  assert str.contains(text, "%1 = get_global @tbl : tile<ptr<f64>>\n")
  assert str.contains(text, "%2 = reshape %1 : tile<ptr<f64>> -> tile<1xptr<f64>>\n")
  assert str.contains(text, "%3 = broadcast %2 : tile<1xptr<f64>> -> tile<8xptr<f64>>\n")
}

test "a dynamic dimension prints `?` in the type and its operand's name in the operation" {
  let tv = TensorView(Num("f64"), [DYN_DIM, 4], [DYN_DIM, DYN_DIM])
  let idx = Tile([], Num("i32"))
  # the type says `?` where an operand carries the value, and the operation
  # spells the shape and the strides a second time with the operands put
  # back in their places: MakeTensorViewOp::print's printMixedOperandList.
  # The `tile<i32> -> ` before the result type appears only when there is
  # at least one operand, which is why a static view never prints it.
  assert ty(tv) == "tensor_view<?x4xf64, strides=[?, ?]>"
  assert line(MakeTensorView(9, Arg(0), Tile([], PtrTo("f64")), tv,
    [Val(1)], [Val(2), Val(3)], idx))
    == "%9 = make_tensor_view %arg0, shape = [%1, 4], strides = [%2, %3]"
    ++ " : tile<i32> -> tensor_view<?x4xf64, strides=[?, ?]>"
  # both queries name every result they define, in dimension order
  assert line(GetTensorShape([9, 10], Val(0), tv, idx))
    == "%9, %10 = get_tensor_shape %0 : tensor_view<?x4xf64, strides=[?, ?]> -> tile<i32>"
  let pv = PartitionView([2, 2], Num("f64"), [DYN_DIM, 4], [DYN_DIM, DYN_DIM], [0, 1], NoPadding)
  assert line(GetIndexSpaceShape([9, 10], Val(0), pv, idx))
    == "%9, %10 = get_index_space_shape %0 : partition_view<tile=(2x2),"
    ++ " tensor_view<?x4xf64, strides=[?, ?]>, dim_map=[0, 1]> -> tile<i32>"
}

test "a strided view spells its traversal, a gather/scatter view its sparse dimension, and a gather load its two index types" {
  let sv = StridedView([4, 2], [4, 3], Num("f32"), [64, 16], [16, 1], [1, 0], PadNan)
  assert ty(sv) == "strided_view<tile=(4x2), traversal_strides=[4, 3],"
    ++ " padding_value = nan, tensor_view<64x16xf32, strides=[16, 1]>, dim_map=[1, 0]>"
  let gv = GatherScatterView([8, 16], Num("f64"), [64, 16], [16, 1], 0, NoPadding)
  assert ty(gv) == "gather_scatter_view<tile=(8x16),"
    ++ " tensor_view<64x16xf64, strides=[16, 1]>, sparse_dim=0>"
  # both constructors read the way make_partition_view does: the whole of
  # the view is in the result type and the operation names one operand
  assert line(MakeStridedView(9, Val(0), TensorView(Num("f32"), [64, 16], [16, 1]), sv))
    == "%9 = make_strided_view %0 : " ++ ty(sv)
  assert line(MakeGatherScatterView(9, Val(0), TensorView(Num("f64"), [64, 16], [16, 1]), gv))
    == "%9 = make_gather_scatter_view %0 : " ++ ty(gv)
  # a gather load prints EVERY index type, because they are not all the
  # same; printIndexTypes prints one for the splat case, which is what
  # every other view operation in this tree takes
  let rows = Tile([8], Num("i32"))
  let idx = Tile([], Num("i32"))
  let tile = Tile([8, 16], Num("f64"))
  assert line(LoadViewTile(9, 10, Val(0), gv, [Val(1), Val(2)], [rows, idx], tile, Val(3)))
    == "%9, %10 = load_view_tko weak %0[%1, %2] token=%3 : " ++ ty(gv)
    ++ ", tile<8xi32>, tile<i32> -> tile<8x16xf64>, token"
  assert line(StoreViewTile(9, Val(0), gv, Val(4), tile, [Val(1), Val(2)], [rows, idx], Val(3)))
    == "%9 = store_view_tko weak %4, %0[%1, %2] token=%3 : tile<8x16xf64>, " ++ ty(gv)
    ++ ", tile<8xi32>, tile<i32> -> token"
}

test "an atomic reduction prints its ordering, its scope, its mode and its value, and answers a token" {
  let pv = PartitionView([2, 2], Num("f64"), [8, 4], [4, 1], [0, 1], NoPadding)
  let idx = Tile([], Num("i32"))
  let tile = Tile([2, 2], Num("f64"))
  # `relaxed` is the only ordering the operation takes, so it is spelled
  # and not chosen; the scope is `tl_blk` or `device` and is a required
  # argument here rather than the optional attribute a load's is
  assert line(AtomicRedViewTile(9, Val(0), pv, Val(4), tile, [Val(1), Val(2)], [idx, idx],
    "addf", "device", Val(3)))
    == "%9 = atomic_red_view_tko relaxed device %0[%1, %2], addf, %4 token=%3"
    ++ " : tile<2x2xf64>, " ++ ty(pv) ++ ", tile<i32> -> token"
  assert line(AtomicRedViewTile(9, Val(0), pv, Val(4), tile, [Val(1), Val(2)], [idx, idx],
    "umin", "tl_blk", Val(3)))
    == "%9 = atomic_red_view_tko relaxed tl_blk %0[%1, %2], umin, %4 token=%3"
    ++ " : tile<2x2xf64>, " ++ ty(pv) ++ ", tile<i32> -> token"
}

# ---- the side table: which public call wrote which line ----

# scripts/tile-golden/kernels.dawn's vadd, the kernel the cuTile page maps.
fn vadd(a: Param[F64], b: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let blk = tile_at(block_id(0), 128)
  let ta = load(a, blk, [128])
  let tb = load(b, blk, [128])
  store(out, blk, add(ta, tb))
}

fn vadd_body() -> Unit !Dev = vadd(param(F64, 0), param(F64, 1), param(F64, 2))

fn vadd_calls() -> (TileProg, List[Call]) = trace_calls("vadd", ["f64", "f64", "f64"], () => vadd_body())

fn names_of(calls: List[Call]) -> List[String] = list.map(calls, c => c.name)

# How many of `ranges` (1-based, half-open) hold line `n`.
fn owners(ranges: List[(Int, Int)], n: Int) -> Int = len(list.filter(ranges, r => {
  let (a, b) = r
  a <= n && n < b
}))

fn all_ranges(m: LineMap) -> List[(Int, Int)] = {
  let none: List[(Int, Int)] = []
  m.head ++ list.fold(m.calls, none, (acc, c) => acc ++ c.lines) ++ [m.tail]
}

fn must_map(prog: TileProg, calls: List[Call]) -> LineMap = match line_map(prog, calls) {
  Ok(m) -> m
  Err(e) -> panic(e)
}

test "the side table holds vadd's six calls in source order, the kernel's own only" {
  let (p, calls) = vadd_calls()
  # tile_at's idx_const and idx_mul are its own, not rows of their own
  assert names_of(calls) == ["block_id", "tile_at", "load", "load", "add", "store"]
  assert list.map(calls, c => (c.ops_from, c.ops_to)) == [(1, 2), (2, 4), (4, 5), (5, 6), (6, 7), (7, 8)]
  assert list.all(calls, c => c.parent == 0 - 1)
  assert len(p.ops) == 8
}

test "the marks put nothing into the program: trace_calls records what trace_kernel records" {
  let (p, _calls) = vadd_calls()
  assert p == trace_kernel("vadd", ["f64", "f64", "f64"], () => vadd_body())
}

test "every line of vadd's text belongs to exactly one call, the prologue or the epilogue" {
  let (p, calls) = vadd_calls()
  let m = must_map(p, calls)
  assert m.text == render(p)
  let n = len(str.split(m.text, "\n")) - 1
  assert n == 26
  assert list.all(range(1, n + 1), k => owners(all_ranges(m), k) == 1)
  assert m.head == [(1, 4)]
  assert m.tail == (24, 27)
  # the first load builds the offset ladder both later memory operations reuse
  assert list.map(m.calls, c => c.lines) == [[(4, 5)], [(5, 7)], [(7, 15)], [(15, 19)], [(19, 20)], [(20, 24)]]
  assert list.all(m.calls, c => c.parent == 0 - 1)
}

test "a side table shifted by one operation is refused, not drawn" {
  let (p, calls) = vadd_calls()
  # the negative control: the third call claims one operation too few, and
  # the fourth starts where the third used to end
  let shifted = list.map(range(0, len(calls)), k => {
    let c = calls[k]
    if k == 2 { Call { ..c, ops_to: c.ops_to - 1 } } else { c }
  })
  assert is_err(line_map(p, shifted))
  let dropped = list.take(calls, 5)
  assert is_err(line_map(p, dropped))
  assert is_ok(line_map(p, calls))
}

fn is_err(r: Result[LineMap, String]) -> Bool = match r {
  Ok(_m) -> false
  Err(_e) -> true
}

fn is_ok(r: Result[LineMap, String]) -> Bool = not is_err(r)

test "an operation issued outside any public call has no owner, and the map says so" {
  let (p, calls) = trace_calls("raw", ["f64"], () => {
    let _i: Int = t_block_id(0)
    ()
  })
  assert len(calls) == 0
  assert len(p.ops) == 2
  assert is_err(line_map(p, calls))
}

fn summed(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let b = block_id(0)
  let first = load(x, tile_at(b, 128), [128])
  let one = idx_const(1)
  let acc = carry(first)
  for k in d_range(one, idx_const(4), step: By(one)) { acc.set(add(acc.get(), load(x, tile_at(k, 128), [128]))) }
  store(out, tile_at(b, 128), acc.get())
}

# The rows of `calls` as (name, parent) pairs.
fn tree_of(calls: List[Call]) -> List[(String, Int)] = list.map(calls, c => (c.name, c.parent))

# The text of the lines `rs` (1-based, half-open) name, each trimmed.
fn texts(m: LineMap, rs: List[(Int, Int)]) -> List[String] = {
  let all = str.split(m.text, "\n")
  let none: List[String] = []
  list.fold(rs, none, (acc, r) => {
    let (a, b) = r
    acc ++ list.map(range(a, b), n => str.trim(all[n - 1]))
  })
}

fn every_line_once(m: LineMap) -> Bool = {
  let n = len(str.split(m.text, "\n")) - 1
  list.all(range(1, n + 1), k => owners(all_ranges(m), k) == 1)
}

test "what a loop's body calls are the d_range's children, and the d_range keeps its header, its continue and its brace" {
  let (p, calls) = trace_calls("summed", ["f64", "f64"], () => summed(param(F64, 0), param(F64, 1)))
  # `carry`, `get` and `set` are calls that record nothing, and the trial
  # that found the loop's carry left no row behind
  assert tree_of(calls) == [("block_id", 0 - 1), ("tile_at", 0 - 1), ("load", 0 - 1), ("idx_const", 0 - 1),
    ("carry", 0 - 1), ("idx_const", 0 - 1), ("d_range", 0 - 1), ("get", 6), ("tile_at", 6), ("load", 6), ("add", 6),
    ("set", 6), ("tile_at", 0 - 1), ("get", 0 - 1), ("store", 0 - 1)]
  # a call's range holds its children's
  assert calls[6].ops_from < calls[8].ops_from && calls[10].ops_to < calls[6].ops_to
  let m = must_map(p, calls)
  assert every_line_once(m)
  let own = texts(m, m.calls[6].lines)
  assert len(own) == 3
  assert str.contains(own[0], " = for ")
  assert str.starts_with(own[1], "continue ")
  assert own[2] == "}"
  # the body's lines are the children's, in the order the body issued them
  assert list.all([8, 9, 10], k => len(m.calls[k].lines) > 0)
}

fn scanned(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let t = load(x, idx_const(0), [8])
  store(out, idx_const(0), d_scan(t, 0.0, (best, e) => max(best, e)))
}

test "a call inside a scan's closure is the d_scan's child, and the d_scan keeps its header, its yield and its brace" {
  let (p, calls) = trace_calls("scanned", ["f64", "f64"], () => scanned(param(F64, 0), param(F64, 1)))
  assert tree_of(calls) == [("idx_const", 0 - 1), ("load", 0 - 1), ("idx_const", 0 - 1), ("d_scan", 0 - 1), ("max", 3),
    ("store", 0 - 1)]
  let m = must_map(p, calls)
  assert every_line_once(m)
  let own = texts(m, m.calls[3].lines)
  assert len(own) == 3
  assert str.contains(own[0], " = scan ")
  assert str.starts_with(own[1], "yield ")
  assert own[2] == "}"
  assert len(texts(m, m.calls[4].lines)) == 1
  assert str.contains(texts(m, m.calls[4].lines)[0], " = maxf ")
}

fn nested(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let z = idx_const(0)
  let one = idx_const(1)
  let first = load(x, z, [8])
  let acc = carry(first)
  for _i in d_range(z, one, step: By(one)) {
    for _j in d_range(z, one, step: By(one)) {
      let u = acc.get()
      acc.set(add(u, broadcast(d_reduce(u, 0.0, (a, e) => max(a, e)), [8])))
    }
  }
  store(out, z, acc.get())
}

test "regions inside regions nest the rows: each call's parent is the region whose closure it is in" {
  let (p, calls) = trace_calls("nested", ["f64", "f64"], () => nested(param(F64, 0), param(F64, 1)))
  assert tree_of(calls) == [("idx_const", 0 - 1), ("idx_const", 0 - 1), ("load", 0 - 1), ("carry", 0 - 1), ("d_range", 0 - 1),
    ("d_range", 4), ("get", 5), ("d_reduce", 5), ("max", 7), ("broadcast", 5), ("add", 5), ("set", 5), ("get", 0 - 1),
    ("store", 0 - 1)]
  let m = must_map(p, calls)
  assert every_line_once(m)
}

# A kernel that calls every region function that takes a closure, each
# closure doing something, so that every body mark is on the way.
fn regions(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let z = idx_const(0)
  let t = load(x, z, [8])
  let c = lt(t, t)
  let r = d_reduce(t, 0.0, (a, e) => max(a, e))
  let s = d_scan(t, 0.0, (a, e) => max(a, e), reverse: true)
  let stop = gt(r, r)
  let w = carry(s)
  d_loop {
    let u = w.get()
    w.set(mul(u, u))
    stop
  }
  let v = carry(w.get())
  d_if(stop, () => v.set(add(w.get(), w.get())), () => v.set(mul(w.get(), w.get())))
  d_assert(c, "never")
  d_fork2(() => store(out, z, v.get()), () => store(out, idx_const(8), v.get()))
}

test "the marks put nothing into the program: trace_calls records what trace_kernel records" {
  let (p, _calls) = vadd_calls()
  assert p == trace_kernel("vadd", ["f64", "f64", "f64"], () => vadd_body())
  # the body marks neither: every region function that takes a closure
  let (q, calls) = trace_calls("regions", ["f64", "f64"], () => regions(param(F64, 0), param(F64, 1)))
  assert q == trace_kernel("regions", ["f64", "f64"], () => regions(param(F64, 0), param(F64, 1)))
  assert every_line_once(must_map(q, calls))
  # and a pair issued by hand around a call is nothing either
  let bare = trace_kernel("bare", ["f64"], () => {
    let _b = block_id(0)
    ()
  })
  let marked = trace_kernel("bare", ["f64"], () => {
    t_body_enter()
    let _b = block_id(0)
    t_body_exit()
  })
  assert bare == marked
}

test "every region function's closure is a body: what it calls is the region call's child" {
  let (_q, calls) = trace_calls("regions", ["f64", "f64"], () => regions(param(F64, 0), param(F64, 1)))
  assert tree_of(calls) == [("idx_const", 0 - 1), ("load", 0 - 1), ("lt", 0 - 1), ("d_reduce", 0 - 1), ("max", 3),
    ("d_scan", 0 - 1), ("max", 5), ("gt", 0 - 1), ("carry", 0 - 1), ("d_loop", 0 - 1), ("get", 9), ("mul", 9), ("set", 9),
    ("get", 0 - 1), ("carry", 0 - 1), ("d_if", 0 - 1), ("get", 15), ("get", 15), ("add", 15), ("set", 15), ("get", 15),
    ("get", 15), ("mul", 15), ("set", 15), ("d_assert", 0 - 1), ("d_fork2", 0 - 1), ("get", 25), ("store", 25),
    ("idx_const", 25), ("get", 25), ("store", 25)]
}

# The sentinel oracle: a kernel with a `d_assert` between every two calls it
# makes, its message a marker. Cut at the sentinels' lines, the text falls
# into slots in the order the body ran, and each slot is one call's (or the
# head's or the tail's) by how the body is written, which is the
# expectation below. That is a second reading of who wrote which line,
# from text order alone, against the map's, from operation numbers.
fn sentinels(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  let z = broadcast(f_const(F64, 0.0), [8])
  let c = lt(z, z)
  let s = (m: String) => d_assert(c, "@@" ++ m)
  s("1")
  let i0 = idx_const(0)
  s("2")
  let t = load(x, i0, [8])
  s("3")
  let n = idx_const(2)
  s("4")
  let acc = carry(t)
  for k in d_range(i0, n, step: By(n)) {
    s("5")
    let v = load(x, k, [8])
    s("6")
    let w = d_scan(v, 0.0, (a, e) => {
      s("7")
      let r = max(a, e)
      s("8")
      r
    })
    s("9")
    let y = add(acc.get(), w)
    s("10")
    acc.set(y)
  }
  s("11")
  store(out, i0, acc.get())
  s("12")
}

test "the map agrees with sentinels: every line is the call that ran between the two sentinels around it" {
  let (p, calls) = trace_calls("sentinels", ["f64", "f64"], () => sentinels(param(F64, 0), param(F64, 1)))
  let m = must_map(p, calls)
  assert every_line_once(m)
  let lines = str.split(m.text, "\n")
  let n = len(lines) - 1
  # the map's reading of each line
  let who = list.map(range(1, n + 1), k => {
    let inside = (rs: List[(Int, Int)]) => owners(rs, k) == 1
    if inside(m.head) {
      "head"
    } else if inside([m.tail]) {
      "tail"
    } else {
      match list.find(m.calls, c => inside(c.lines)) {
        Some(c) -> c.name
        None -> "nobody"
      }
    }
  })
  # the slots between sentinel lines, each the names the map gives its lines
  let none: List[List[String]] = [[]]
  let slots = list.fold(range(0, n), none, (acc, k) => {
    if str.contains(lines[k], "\"@@") {
      assert who[k] == "d_assert"
      let fresh: List[String] = []
      acc ++ [fresh]
    } else {
      let last = acc[len(acc) - 1]
      let here = if len(last) > 0 && last[len(last) - 1] == who[k] { last } else { last ++ [who[k]] }
      list.take(acc, len(acc) - 1) ++ [here]
    }
  })
  # the constant is made where it is first used, by the broadcast, so the
  # `f_const` call has no line of its own
  assert slots == [["head", "broadcast", "lt"], ["idx_const"], ["load"], ["idx_const"], ["d_range"], ["load"], ["d_scan"],
    ["max"], ["d_scan"], ["add"], ["d_range"], ["store"], ["tail"]]
}

fn tabled(x: Param[F64], out: Param[F64]) -> Unit !Dev = {
  d_global("t", F64, [1.0, 2.0])
  let v = load_ptrs(global_ptrs("t", F64, [2]))
  store(out, idx_const(0), add(v, load(x, idx_const(0), [2])))
}

test "a global's line belongs to the call that declared it" {
  let (p, calls) = trace_calls("tabled", ["f64", "f64"], () => tabled(param(F64, 0), param(F64, 1)))
  # arguments left to right, each call after its own arguments: store's
  # `idx_const(0)` runs before anything inside its `add`
  assert names_of(calls) == ["d_global", "global_ptrs", "load_ptrs", "idx_const", "idx_const", "load", "add", "store"]
  let m = must_map(p, calls)
  # the module line, then the global, then the entry
  assert m.calls[0].lines == [(2, 3)]
  assert m.head == [(1, 2), (3, 5)]
  let n = len(str.split(m.text, "\n")) - 1
  assert list.all(range(1, n + 1), k => owners(all_ranges(m), k) == 1)
}

# ---- the batch's PR-1: where an In's alignment claim goes ----

fn vadd_cells(a: Param[F64], b: Param[F64], o: Param[F64]) -> Unit !Dev =
  store_cell(o, add(load_cell(a), load_cell(b)))

test "PR-2: every cell view, an In's and an Out's, claims 16-byte alignment on the parameter itself, ahead of the view" {
  let g = cells([1024], [128])
  let (p, _e) = trace3("vadd_cells", In(F64, g), In(F64, g), Out(F64, g), vadd_cells)
  let k = lower(p)
  let none: Option[Int] = None
  let claims = list.filter(k.body, i => match i {
    AssumeTile(_d, _src, _pred, _t) -> true
    _ -> false
  })
  assert list.map(claims, i => match i {
    AssumeTile(_d, src, pred, t) -> (src, pred, t)
    _ -> (Arg(9), DivBy(0, none, none), Tile([], PtrTo("f64")))
  }) == [
    (Arg(0), DivBy(16, none, none), Tile([], PtrTo("f64"))),
    (Arg(1), DivBy(16, none, none), Tile([], PtrTo("f64"))),
    (Arg(2), DivBy(16, none, none), Tile([], PtrTo("f64")))
  ]
  # each view starts from its parameter's claim; no `offset` sits between a
  # parameter and a view
  let bases = list.map(list.filter(k.body, i => match i {
    MakeTensorView(_d, _base, _bt, _t, _ds, _dst, _it) -> true
    _ -> false
  }), i => match i {
    MakeTensorView(_d, base, _bt, _t, _ds, _dst, _it) -> base
    _ -> Arg(9)
  })
  assert bases == list.map(claims, i => match i {
    AssumeTile(d, _src, _pred, _t) -> Val(d)
    _ -> Arg(9)
  })
  assert not list.any(k.body, i => match i {
    Offset(_d, _p, _o, _pt, _ot) -> true
    _ -> false
  })
  let text = render(p)
  assert str.contains(text, "%1 = assume div_by<16>, %arg0 : tile<ptr<f64>>")
  assert str.contains(text, "assume div_by<16>, %arg2 : tile<ptr<f64>>")
  assert not str.contains(text, "make_tensor_view %arg")
}

fn merged_combos(a: Param[F64], o: Param[F64]) -> Unit !Dev = {
  let b = tile_at(block_id(0), 128)
  let m = tail_mask(b, [128], 1000)
  let h = [for_arch("sm_86", [hint_latency(2)])]
  let t = load(a, b, [128], strides: Some([1]), hints: h)
  let u = load(a, b, [128], mask: Some(m))
  store(o, b, add(t, u), strides: Some([1]), mask: Some(m), hints: h)
}

test "PR-2: a hinted load, a masked load with no padding value and a masked hinted store render as the dialect spells them" {
  let text = render(trace_kernel("combos", ["f64", "f64"], () => merged_combos(param(F64, 0), param(F64, 1))))
  assert str.contains(text, "%15, %16 = load_ptr_tko weak %14 token=%0 optimization_hints=<sm_86 = {latency = 2}> : tile<128xptr<f64>> -> tile<128xf64>, token")
  assert str.contains(text, "%17, %18 = load_ptr_tko weak %14, %11 token=%16 : tile<128xptr<f64>>, tile<128xi1> -> tile<128xf64>, token")
  assert str.contains(text, "%23 = store_ptr_tko weak %22, %19, %11 token=%18 optimization_hints=<sm_86 = {latency = 2}> : tile<128xptr<f64>>, tile<128xf64>, tile<128xi1> -> token")
}

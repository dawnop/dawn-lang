# pub(pkg) roots answer to the package (docs/package-visibility-design.md
# §4.3): each of these names a package-private identity of its own package,
# which a package-private surface may, and nothing module-private.
pub(pkg) type Seam = { n: Int }

pub(pkg) trait Walk[T] {
  fn walk(x: T) -> Seam
}

pub(pkg) effect Trace {
  fn trace(s: Seam) -> Unit
}

pub(pkg) alias Seams = List[Seam]

pub type Open = { k: Int }

pub(pkg) fn inner(s: Seam) -> Seams = [s]

pub(pkg) fn walked[T: Walk](x: T) -> Seam !Trace = walk(x)

pub(pkg) const ORIGIN: Int = 0

# a package-private trait for a public type: observable to the package
impl Walk[Open] {
  fn walk(x: Open) -> Seam = Seam { n: x.k }
}

# A bare constructor is not a call, so the pipe applies it to the left side.
# One shape per file: a parse error takes its whole file down with it, so
# shapes that share a file cannot own separate assertions (measured).
type Sum = Zero | One(x: Int)

fn unbox(s: Sum) -> Int =
  match s {
    Zero -> 0
    One(x) -> x
  }

pub fn main() -> Unit !io = println("${unbox(7 |> One)}")

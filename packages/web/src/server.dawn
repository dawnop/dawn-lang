# The server: jdk.httpserver underneath (spec §9 interop), one virtual thread
# per request, a single root context that parses the exchange into a Request,
# routes it, and writes the Response back. nginx terminates TLS and everything
# hard in front — this only speaks HTTP/1.1.
use std/str
use std/bytes
use std/list
use std/map
use java "com.sun.net.httpserver.HttpServer"
use java "com.sun.net.httpserver.HttpExchange"
use java "com.sun.net.httpserver.Headers"
use java "java.net.InetSocketAddress"
use java "java.util.concurrent.Executors"
use java "java.util.concurrent.CountDownLatch"
use java "java.io.OutputStreamWriter"
use java "java.lang.String"
use java "java.util.Iterator"
use java "java.io.File"
use java "java.io.FileOutputStream"
use types.{Request, Response, HttpError, Handler, Middleware, RouteMeta, http_error, error_response, streaming}
use router.{Route, Dispatch, Found, NoPath, WrongMethod, dispatch, route_meta, validate_routes}
use java "java.io.InputStream"
use java "java.io.OutputStream"
use java "java.net.URI"
use java "java.net.URLDecoder"
use java "java.net.http.HttpClient"
use java "java.net.http.HttpRequest"
use java "java.net.http.HttpRequest.BodyPublisher"
use java "java.net.http.HttpRequest.BodyPublishers"
use java "java.net.http.HttpResponse.BodyHandlers"

## Close an upstream stream, swallowing a close failure (non-fatal — the
## response is already committed, or was never sent). Called after pumping a
## streaming body so the client connection frees.
fn close_stream(s: InputStream) -> Unit !io = {
  let _ = catch_fault(() => s.close())
  ()
}

## The rest of the releases `write_response` brackets with, innermost first.
## These do *not* swallow: a failure to flush the response body is the client's
## problem to hear about, and the exchange is the connection.
fn close_writer(w: OutputStreamWriter) -> Unit !io = w.close()

fn close_body(o: OutputStream) -> Unit !io = o.close()

fn close_exchange(ex: HttpExchange) -> Unit !io = ex.close()

# The Content-Length the client claims, or 0 when it does not say. A claim, not
# a fact — it only ever produces a fast rejection, never permission to read.
fn declared_length(ex: HttpExchange) -> Int !io =
  match ex.getRequestHeaders()!.getFirst("Content-Length") {
    Some(v) -> unwrap_or(parse_int(str.trim(v)), 0)
    None -> 0
  }

# Read the whole request body once as Bytes (spec §9.5.1), plus its UTF-8 decode
# for the common text/JSON/form handlers. Binary handlers (multipart upload,
# WebDAV PUT) take the raw Bytes and recover exact file bytes with no latin-1
# detour — a single decode, not two.
#
# `limit` is a hard ceiling on bytes read, and it is enforced *here* rather than
# by a middleware afterwards. The old arrangement called readAllBytes() and let
# with_body_limit compare the result against a budget, which cannot stop
# anything: by the time the 413 is decided, the whole body is already resident,
# and a handful of concurrent large POSTs is the entire attack. readNBytes stops
# one byte past the ceiling — enough to know the body is oversized, and the most
# that can ever be allocated for one.
#
# limit <= 0 means unbounded, for the routes that opt out (see `handle`).
fn read_body(ex: HttpExchange, limit: Int) -> Result[(String, Bytes), HttpError] !io = {
  let stream = ex.getRequestBody()!
  if limit <= 0 {
    let raw = stream.readAllBytes()!
    Ok((bytes.decode_utf8(raw), raw))
  } else if declared_length(ex) > limit {
    Err(http_error(413, "request body exceeds $limit bytes"))
  } else {
    let raw = stream.readNBytes(limit + 1)!
    if bytes.len(raw) > limit {
      Err(http_error(413, "request body exceeds $limit bytes"))
    } else {
      Ok((bytes.decode_utf8(raw), raw))
    }
  }
}

# Write a response. Length 0 selects chunked transfer encoding, so we never
# need the byte count up front; the Writer handles UTF-8.
fn write_response(ex: HttpExchange, r: Response) -> Unit !io = {
  with x <- bracket(ex, close_exchange)
  let headers = x.getResponseHeaders()!
  headers.set("Content-Type", r.content_type)
  set_extra_headers(headers, r.headers)
  x.sendResponseHeaders(r.status, 0)
  with out <- bracket(x.getResponseBody()!, close_body)
  match r.stream {
    # streaming body: pump the upstream InputStream straight to the socket, 8KB at a
    # time — constant memory, first byte out immediately. transferTo can throw if the
    # client disconnects mid-download; the bracket is the finally, so the upstream
    # stream is closed and the HttpClient connection frees either way. The
    # catch_panic outside it keeps a mid-download disconnect from being an error:
    # the response is already committed, there is nothing left to say. Close
    # failure is non-fatal too (close_stream swallows it).
    Some(s) -> {
      let _ = catch_panic(() => {
        with up <- bracket(s, close_stream)
        up.transferTo(out)
      })
      ()
    }
    None ->
      match r.bin {
        Some(raw) -> {
          # binary body: write the raw Bytes verbatim (Bytes -> Java byte[] param)
          out.write(raw)
          out.flush()
        }
        None -> {
          with writer <- bracket(OutputStreamWriter.new(out, "UTF-8"), close_writer)
          writer.write(r.body)
          writer.flush()
        }
      }
  }
}

fn set_extra_headers(headers: Headers, hs: List[(String, String)]) -> Unit !io = {
  for i in range(0, len(hs)) {
    let (k, v) = hs[i]
    headers.add(k, v)
  }
}

# Collect request headers into a lowercase-keyed map (first value per name;
# multi-valued request headers are rare in this API and the first wins). The
# key set is a Java collection, so it is walked with an iterator.
fn read_headers(ex: HttpExchange) -> Map[String, String] !io = {
  let headers = ex.getRequestHeaders()!
  let it = headers.keySet()!.iterator()!
  collect_headers(headers, it, map.empty())
}

fn collect_headers(headers: Headers, it: Iterator, acc: Map[String, String]) -> Map[String, String] !io =
  if it.hasNext() {
    let name = String.valueOf(it.next()!)!
    let v = headers.getFirst(name)!
    collect_headers(headers, it, map.insert(acc, str.to_lower(name), v))
  } else {
    acc
  }

# Percent-decode one application/x-www-form-urlencoded component: '+' is a
# space, %XX is a byte, and the resulting byte sequence is UTF-8.
#
# Decoding has to happen *after* splitting on '&' and '=', never before. The old
# code took `URI.getQuery()`, which is already decoded, and split that — so a
# value containing an encoded ampersand (`a=1%262`) arrived as `a=1&2` and split
# into two parameters. Anything that let a client forge a parameter boundary
# this way is a parameter-smuggling bug, not just a decoding nicety.
#
# URLDecoder throws on a truncated escape (`%A`, `%ZZ`); a malformed query is
# not worth failing a request over, so the raw component stands in.
#
# The `!io` on this and its two callers is bookkeeping, not a real effect:
# decoding a string is pure, but the JDK call that does it can throw and
# `catch_fault` — the only structured way to catch that — is itself `!io`. The
# alternative was a hand-written UTF-8 decoder, and the repo already has one of
# those to answer for (see the LSP); a second is not the fix.
fn pct_decode(s: String) -> String !io =
  match catch_fault(() => URLDecoder.decode(s, "UTF-8")!) {
    Ok(v) -> v
    Err(_) -> s
  }

# "a=1&b=x" -> [("a","1"),("b","x")], over the *raw* (still encoded) string.
# A value may itself contain '=', so only the first one splits — and since the
# split happens first, an encoded '=' in a value stays part of that value.
pub fn parse_query(q: String) -> List[(String, String)] !io =
  map(filter(str.split(q, "&"), pair => pair != ""), pair => {
    let parts = str.split(pair, "=")
    (pct_decode(parts[0]), pct_decode(join(tail(parts), "=")))
  })

# Parse an application/x-www-form-urlencoded body into a map. Same grammar and
# the same decoding as a query string — this used to replace '+' with a space
# and stop there, so every percent escape in a form field reached the handler
# still encoded (`%40` for '@' in an email, and so on).
pub fn parse_form(body: String) -> Map[String, String] !io = map.from(parse_query(body))

fn tail(xs: List[String]) -> List[String] =
  map(range(1, len(xs)), i => xs[i])

fn rev[T](xs: List[T]) -> List[T] =
  map(range(0, len(xs)), i => xs[len(xs) - 1 - i])

fn build_request(ex: HttpExchange, meta: Option[RouteMeta], max_body: Int) -> Result[Request, HttpError] !io = {
  let uri = ex.getRequestURI()!
  let no_query: Map[String, String] = map.from([])
  # getRawQuery, not getQuery: the split into parameters must see the encoded
  # form, or a client can put an encoded '&' in a value and forge a parameter.
  # Each component is decoded afterwards with form-urlencoded semantics ('+' is
  # a space), matching Starlette/FastAPI.
  let q = match uri.getRawQuery() {
    Some(s) -> map.from(parse_query(s))
    None -> no_query
  }
  # A "stream-body" route never sees the body in memory: it goes to a temp file
  # and the handler gets the path. Everything else reads as before, under the
  # ceiling — except routes tagged "raw-body" (uploads bounded by nginx's
  # client_max_body_size instead), which opt out of it.
  let streaming = meta_has_tag(meta, "stream-body")
  let limit = if meta_has_tag(meta, "raw-body") { 0 } else { max_body }
  let (body, raw) = if streaming { ("", bytes.utf8("")) } else { read_body(ex, limit)? }
  let bf: Option[String] = if streaming { Some(spill_body(ex)) } else { None }
  Ok(Request {
    method: ex.getRequestMethod()!,
    path: uri.getPath()!,
    params: no_query,
    query: q,
    headers: read_headers(ex),
    body: body,
    raw: raw,
    body_file: bf,
    route: meta,
  })
}

# Stream the request body to a temp file, 8KB at a time (transferTo's buffer), and
# return its path. Constant memory whatever the file's size — the point of the
# whole exercise. The caller deletes it once the handler is done.
fn spill_body(ex: HttpExchange) -> String !io = {
  let tmp = File.createTempFile("dawn-put-", ".tmp")!
  with out <- bracket(FileOutputStream.new(tmp), close_spill)
  let stream = ex.getRequestBody()!
  let _n = stream.transferTo(out)
  String.valueOf(tmp.getPath()!)!
}

fn close_spill(o: FileOutputStream) -> Unit !io = o.close()

fn delete_quietly(path: String) -> Unit !io = {
  let r: Result[Bool, ForeignError] = catch_fault(() => File.new(path).delete())
  match r {
    Ok(_) -> ()
    Err(m) -> println("temp body file not deleted: ${m.message}")
  }
}

## The release for the spilled request body: a Request owns its temp file for
## exactly the length of the handler call, and there is nothing to delete when
## the body never went to disk.
fn drop_body_file(req: Request) -> Unit !io =
  match req.body_file {
    Some(p) -> delete_quietly(p)
    None -> ()
  }

fn meta_has_tag(meta: Option[RouteMeta], tag: String) -> Bool =
  match meta {
    Some(m) -> list.find(m.tags, t => t == tag) != None
    None -> false
  }

# Execute an already-computed dispatch decision, itself shaped like a handler so
# middleware can wrap it — a logging middleware sees 404s and 405s too. The
# matched route's captures are injected as a fresh Request (records are immutable).
fn run_dispatch(d: Dispatch, req: Request) -> Result[Response, HttpError] !io =
  match d {
    NoPath -> Err(http_error(404, "Not Found"))
    WrongMethod -> Err(http_error(405, "Method Not Allowed"))
    Found(route, params) -> {
      route.handler(Request { ..req, params: params })
    }
  }

# The metadata middleware get for the matched route. Unmatched (404) and
# wrong-method (405) requests carry no route, hence no tags.
fn meta_of(d: Dispatch) -> Option[RouteMeta] =
  match d {
    Found(route, _) -> Some(route_meta(route))
    NoPath -> None
    WrongMethod -> None
  }

fn handle(routes: List[Route], middleware: List[Middleware], max_body: Int, ex: HttpExchange) -> Unit !io = {
  # a handler panic is isolated to this request: catch_panic turns it into a 500
  # instead of resetting the connection or leaking the virtual thread (spec §9.8).
  let outcome = catch_panic(() => {
    # Dispatch BEFORE touching the body: method and path come from the request
    # line, and the matched route's tags decide how the body is read at all
    # ("stream-body" spills it to disk instead of into memory). The same decision
    # is executed by run_dispatch below — no second table walk.
    let d = dispatch(routes, ex.getRequestMethod()!, ex.getRequestURI()!.getPath()!)
    # An oversized body is refused before it is read, which also means before any
    # middleware runs: there is no Request to hand them. That costs the 413 its
    # access-log line and its CORS headers, and is the price of the refusal
    # happening early enough to be worth anything.
    match build_request(ex, meta_of(d), max_body) {
      Err(e) -> {
        println("${ex.getRequestMethod()!} ${ex.getRequestURI()!.getPath()!} -> ${e.status} (${e.message})")
        error_response(e)
      }
      Ok(req) -> {
        # first middleware in the list is outermost: [a, b] runs a(b(core)). Middleware
        # still wraps the core, so CORS preflight and logging cover unmatched requests.
        let app = fold(rev(middleware), (rq: Request) => run_dispatch(d, rq), (h, m) => m(h))
        # the temp body file lives exactly as long as the handler call, and the
        # bracket is what makes that true on every way out — including the ones
        # the catch_panic below does not see, such as a panic while rendering
        # the 500 for a panic.
        with held <- bracket(req, drop_body_file)
        let served = catch_panic(() => app(held))
        match served {
          Ok(Ok(r)) -> r
          Ok(Err(e)) -> error_response(e)
          Err(m) -> {
            println("request panicked: ${m.message}")
            error_response(http_error(500, "服务器内部错误"))
          }
        }
      }
    }
  })
  let response = match outcome {
    Ok(r) -> r
    Err(m) -> {
      println("request panicked: ${m.message}")
      error_response(http_error(500, "服务器内部错误"))
    }
  }
  write_response(ex, response)
}

# The ceiling on a request body read into memory, in bytes. 8 MiB: comfortably
# above any JSON or form this framework is meant to carry, far below what a few
# concurrent requests could use to exhaust a heap. Routes that legitimately take
# more opt out with the "raw-body" tag (nginx bounds those) or the "stream-body"
# tag (those never touch the heap at all).
pub const DEFAULT_MAX_BODY: Int = 8388608

# Start on 127.0.0.1:port and block forever (main() returning would let the
# JVM exit out from under the request threads).
pub fn serve_app(port: Int, routes: List[Route], middleware: List[Middleware]) -> Unit !io =
  serve_app_bounded(port, DEFAULT_MAX_BODY, routes, middleware)

# Same, with the in-memory body ceiling chosen explicitly (0 = unbounded, which
# is what this framework did before the ceiling existed).
pub fn serve_app_bounded(port: Int, max_body: Int, routes: List[Route], middleware: List[Middleware]) -> Unit !io = {
  # WEB-09: a broken table fails here, at startup, with the two routes named —
  # not at runtime as a silent 404 on the route its author believes exists
  match validate_routes(routes) {
    Err(e) -> panic("route table: " ++ e)
    Ok(_) -> ()
  }
  let addr = InetSocketAddress.new("127.0.0.1", port)
  let server = HttpServer.create(addr, 0)!
  server.createContext("/", ex => handle(routes, middleware, max_body, ex))
  server.setExecutor(Executors.newVirtualThreadPerTaskExecutor()!)
  server.start()
  println("listening on http://127.0.0.1:$port")
  let latch = CountDownLatch.new(1)
  latch.await()
}

test "query strings parse, including empty and embedded =" {
  assert parse_query("a=1&b=x") == [("a", "1"), ("b", "x")]
  assert parse_query("") == []
  assert parse_query("k=a=b") == [("k", "a=b")]
  assert parse_query("flag") == [("flag", "")]
}

test "an encoded separator stays inside its value" {
  # the smuggling case: decoding before splitting turned this into two params
  assert parse_query("a=1%262") == [("a", "1&2")]
  assert parse_query("a=x%3Dy") == [("a", "x=y")]
  # keys are decoded too, and were not before
  assert parse_query("a%20b=c") == [("a b", "c")]
  # '+' is a space on both sides
  assert parse_query("a+b=c+d") == [("a b", "c d")]
  # UTF-8 percent escapes decode as bytes, not as characters
  assert parse_query("q=%E4%B8%AD%E6%96%87") == [("q", "\u{4e2d}\u{6587}")]
  # a truncated escape is not worth a 400; the component stands as written
  assert parse_query("a=%A") == [("a", "%A")]
}

test "form bodies parse, with + as space and %XX decoded" {
  let f = parse_form("username=admin&password=a+b+c")
  assert map.get(f, "username") == Some("admin")
  assert map.get(f, "password") == Some("a b c")
  # percent escapes used to reach the handler still encoded
  let g = parse_form("email=a%40b.com&note=1%262")
  assert map.get(g, "email") == Some("a@b.com")
  assert map.get(g, "note") == Some("1&2")
}

# ---- test-only HTTP client: the streaming test needs a real client to pump
# bytes through a socket; the app-side fetch helpers live with the app ----

fn test_get(url: String) -> HttpRequest !io = {
  let nobody: BodyPublisher = BodyPublishers.noBody()!
  HttpRequest.newBuilder()!.uri(URI.create(url)!)!.method("GET", nobody)!.build()!
}

# `body()` is an erased generic, and what it holds is decided by the handler
# passed one line up -- `ofInputStream` gives an `InputStream`, `ofByteArray`
# a `byte[]`. So the `Err` that `cast` now returns (LANG-02) means the pair
# was mismatched here, in test scaffolding, and stopping is what the uncaught
# ClassCastException already did: nothing upstream catches it, and a test that
# silently fetched nothing would be worse than one that stops.
fn test_fetch_stream(url: String) -> (Int, InputStream) !io = {
  let resp = HttpClient.newHttpClient()!.send(test_get(url), BodyHandlers.ofInputStream()!)!
  let got: Result[InputStream, ForeignError] = cast(resp.body()!)
  match got {
    Ok(s) -> (resp.statusCode(), s)
    Err(e) -> panic("test_fetch_stream: body is not an InputStream: " ++ e.message)
  }
}

fn test_fetch_bytes(url: String) -> (Int, Bytes) !io = {
  let resp = HttpClient.newHttpClient()!.send(test_get(url), BodyHandlers.ofByteArray()!)!
  let got: Result[Bytes, ForeignError] = cast(resp.body()!)
  match got {
    Ok(b) -> (resp.statusCode(), b)
    Err(e) -> panic("test_fetch_bytes: body is not a byte[]: " ++ e.message)
  }
}

test "write_response pumps an upstream stream to the client byte-exact (>8KB, multi-chunk)" {
  # The full realistic path: upstream HTTP -> ofInputStream + cast -> streaming() ->
  # write_response's stream branch -> transferTo pumps the InputStream to the socket
  # -> close. 12000 bytes forces transferTo's 8KB buffer across more than one chunk.
  let payload = bytes.utf8(join(map(range(0, 1200), i => "0123456789"), ""))
  # upstream: serves the payload
  let up = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  up.createContext("/", ex => {
    ex.sendResponseHeaders(200, bytes.len(payload))
    let os = ex.getResponseBody()!
    os.write(payload)
    os.close()
  })
  up.start()
  let upurl = "http://127.0.0.1:${up.getAddress()!.getPort()}/"
  # download: proxies upstream as a live stream through write_response's stream branch
  let dn = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  dn.createContext("/", ex => {
    let (st, stream) = test_fetch_stream(upurl)
    write_response(ex, streaming(st, "application/octet-stream", stream))
  })
  dn.start()
  let (st, got) = test_fetch_bytes("http://127.0.0.1:${dn.getAddress()!.getPort()}/")
  assert st == 200
  assert bytes.len(got) == 12000
  assert got == payload
  up.stop(0)
  dn.stop(0)
}

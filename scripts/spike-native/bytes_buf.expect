-- an empty buffer freezes to empty bytes --
len = 0
-- the values a UTF-8 round trip would destroy --
0 1 127 128 129 200 254 255
-- out of range truncates, as a byte store does --
0 1 255 255
-- reading back what was written, and appending bytes wholesale --
size    = 8
get 4   = 129
104 105 0 1 255 255
-- a run copied from its own output, the way inflate does --
7 9 7 9 7 9 7 9

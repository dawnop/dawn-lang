# Without a call suffix a member reference is still a static field read, and
# the same-name pair still resolves to the field. Nothing about the dispatch
# reaches a bare `EFieldAcc`.
use java "fixture.Syn09"

fn require(ok: Bool, message: String) -> Unit =
  if ok { () } else { panic(message) }

pub fn main() -> Unit !io = {
  require(Syn09.UPPER_FIELD == 7, "uppercase static field")
  require(Syn09.lower_field! == "lf", "lowercase static field")
  require(Syn09.PICK == 11, "uppercase same-name field")
  require(Syn09.pick == 21, "lowercase same-name field")
  println("ok")
}

# Within one chain an earlier arm settles the type for a later one, exactly as
# an earlier element does for a later element. Nothing outside the element
# settles it here: no annotation, no sibling.
pub type Tagged[T] = Tagged(label: String)

fn nameless[T](s: String) -> Tagged[T] = Tagged(label: s)

fn f(anchor: Tagged[Int], a: Bool, b: Bool) -> Int = {
  let out = [if a { anchor } else if b { nameless("y") }]
  len(out)
}

pub fn main() -> Unit = ()

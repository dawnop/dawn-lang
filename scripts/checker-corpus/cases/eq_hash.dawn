# checker.dawn: the capability messages behind ==, hash and Map/Set keys
use std/map
use std/set

pub type Boxed = B(f: fn() -> Int)

pub fn eq_fn(f: fn() -> Int, g: fn() -> Int) -> Bool = f == g

pub fn eq_unit(a: Unit, b: Unit) -> Bool = a == b

pub fn key_float() -> Map[Float, Int] = map.insert(map.empty(), 1.0, 1)

pub fn contains_boxed(b: Boxed) -> Set[Boxed] = set.insert(set.empty(), b)

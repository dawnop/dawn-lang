# A field and a method of the same name, in both spellings. Java keeps the two
# in separate namespaces, so the call suffix -- not the capitalization, and not
# a preference for one namespace -- is what picks the method. The values differ
# by 90 and 180 so a call that resolved to the field would be caught here even
# though it type-checks.
use java "fixture.Syn09"

fn require(ok: Bool, message: String) -> Unit =
  if ok { () } else { panic(message) }

pub fn main() -> Unit !io = {
  require(Syn09.PICK(1) == 101, "uppercase same-name method")
  require(Syn09.pick(1) == 201, "lowercase same-name method")
  println("ok")
}

# Markdown AST -> HTML. Top-level headings get numbered anchors (#s2, #s2-3)
# and feed the TOC; link URLs go through a caller-supplied mapper so this
# module knows nothing about the site's layout.
#
# What it knows about the page's look (docs/site-pages-design.md) it knows
# from the document's structure, never from where a block happens to sit in
# one particular file: a heading's printed section number is the run of
# digits and dots (or `D3`, `M5`) before its first space; the status note is
# the first block of the body; a timeline is a list whose every item opens
# with a milestone or a date in bold. The alternative, matching the HTML
# afterwards ("the first ul after id=s5"), breaks the day a section moves.

use std/str
use md/ast.{Inline, Text, Code, Bold, Em, Del, Link, Block, Heading, Para, CodeBlock, Fragment, Program, UList, OList, Table, Quote, Rule}
use md/text.{seg}
use html/escape.{escape_html, escape_attr}
use html/play.{Play, play_block, code_window}
use hl/dawn.{highlight_dawn}

## One rendered document: body HTML, its TOC, and the first h1's plain text.
##
## `heads` is every heading that got an id, h2 to h4, in document order -- the
## TOC plus the h4s it leaves out. The site search's body index
## (gen/search_body) cuts a page into sections at exactly these headings and
## takes their ids from here, so the fragment it writes is the id this call
## wrote, counted by the same counter.
pub type Doc = { html: String, toc: List[TocEntry], heads: List[TocEntry], title: String } derive Show

pub type TocEntry = { level: Int, id: String, text: String } derive Show

## The plain text of an inline run (for titles and TOC labels).
pub fn inline_text(items: List[Inline]) -> String =
  join(map(items, it =>
      match it {
        Text(s) -> s
        Code(s) -> s
        Bold(xs) -> inline_text(xs)
        Em(xs) -> inline_text(xs)
        Del(xs) -> inline_text(xs)
        Link(label, _) -> label
      }), "")

fn inline_html(it: Inline, map_url: fn(String) -> String) -> String =
  match it {
    Text(s) -> escape_html(s)
    Code(s) -> "<code>" ++ escape_html(s) ++ "</code>"
    Bold(xs) -> "<strong>" ++ inlines_html(xs, map_url) ++ "</strong>"
    Em(xs) -> "<em>" ++ inlines_html(xs, map_url) ++ "</em>"
    Del(xs) -> "<del>" ++ inlines_html(xs, map_url) ++ "</del>"
    Link(label, url) ->
      `<a href="` ++ escape_attr(map_url(url)) ++ `">` ++ escape_html(label) ++ "</a>"
  }

fn inlines_html(items: List[Inline], map_url: fn(String) -> String) -> String =
  join(map(items, it => inline_html(it, map_url)), "")

## An inline run as HTML, with no block wrapper. The front-page copy is
## Markdown (gen/copy.dawn) but the template supplies the element around it —
## a lede is a `<p class="lede">`, not whatever the renderer would have picked.
pub fn inline_run(items: List[Inline], map_url: fn(String) -> String) -> String =
  inlines_html(items, map_url)

## `play` is the offer a `dawn` block makes: given one, the block comes out
## as a window with a link that carries its own source to the Playground.
## Only the tutorial and the gallery pass it -- the spec quotes three lines of
## a match, and a link from there would open an editor on something that was
## never a program. `out` is the `output` fence that followed the block, or
## "" (see [offered_pair]).
fn code_html(lang: String, body: String, play: Option[Play], out: String) -> String =
  if lang == "dawn" {
    let pre = `<pre class="dawn"><code>` ++ highlight_dawn(body) ++ "</code></pre>"
    match play {
      Some(p) -> play_block(p, "dawn", pre, body, out)
      None -> pre
    }
  } else if lang == "output" {
    output_html(body)
  } else {
    "<pre><code>" ++ escape_html(body) ++ "</code></pre>"
  }

## A [Program] on a page that offers the Playground: the same window as an
## offered block, with its output under it, but no link, since the Playground
## runs one file and this program needs packages. The bar names them
## (`dawn · tileir`), which is the one thing the reader must know to run it.
## On a page that offers nothing it is an ordinary block.
fn program_html(lang: String, deps: List[String], body: String, play: Option[Play], out: String) -> String =
  match play {
    Some(_) ->
      if lang == "dawn" {
        let pre = `<pre class="dawn"><code>` ++ highlight_dawn(body) ++ "</code></pre>"
        let tail = if out == "" { "" } else { "\n" ++ out }
        code_window("dawn · " ++ join(deps, ", "), pre ++ tail)
      } else {
        code_html(lang, body, None, "")
      }
    None -> code_html(lang, body, None, "")
  }

fn output_html(body: String) -> String =
  `<pre class="output"><code>` ++ escape_html(body) ++ "</code></pre>"

## When block `i` is a `dawn` block the page offers to the Playground and
## block `i + 1` is the `output` fence the tutorial writes under it, the two as
## one window. The pair is made here, from the blocks, rather than by
## matching the markup afterwards: they are siblings in the source and the
## window is one element.
fn offered_pair(bs: List[Block], i: Int, play: Option[Play]) -> Option[String] =
  match play {
    Some(_) ->
      match get(bs, i) {
        Some(CodeBlock(lang, body)) ->
          if lang == "dawn" {
            match get(bs, i + 1) {
              Some(CodeBlock(next, out)) ->
                if next == "output" { Some(code_html(lang, body, play, output_html(out))) } else { None }
              _ -> None
            }
          } else {
            None
          }
        Some(Program(lang, deps, body)) ->
          match get(bs, i + 1) {
            Some(CodeBlock(next, out)) ->
              if next == "output" { Some(program_html(lang, deps, body, play, output_html(out))) } else { None }
            _ -> None
          }
        _ -> None
      }
    None -> None
  }

## A list item body: a lone paragraph renders tight (no <p>).
fn item_body(bs: List[Block], map_url: fn(String) -> String, play: Option[Play]) -> String =
  match bs {
    [Para(items)] -> inlines_html(items, map_url)
    _ -> blocks_html(bs, map_url, play)
  }

fn items_html(
  items: List[List[Block]],
  map_url: fn(String) -> String,
  play: Option[Play],
) -> String =
  join(map(items, bs => "<li>" ++ item_body(bs, map_url, play) ++ "</li>"), "\n")

## True when the `n` characters from `i` are all digits.
fn digits_at(cs: List[Char], i: Int, n: Int) -> Bool =
  i + n <= len(cs) && len(filter(range(i, i + n), j => not is_digit(cs[j]))) == 0

## True when position `i` is the end of the text or not a digit: a date must
## not be the front of a longer number.
fn digit_free(cs: List[Char], i: Int) -> Bool = i >= len(cs) || not is_digit(cs[i])

## How many characters of an ISO date start at `i`: 10 for `2026-07-23`, 19
## when a range end follows (`2026-08-31 to 09-01`), 0 when no date starts
## here.
fn date_len(cs: List[Char], i: Int) -> Int = {
  let starts = (i == 0 || not is_digit(cs[i - 1])) && digits_at(cs, i, 4)
  let date = starts && i + 10 <= len(cs) && cs[i + 4] == '-' && digits_at(cs, i + 5, 2)
    && cs[i + 7] == '-' && digits_at(cs, i + 8, 2) && digit_free(cs, i + 10)
  let j = i + 10
  let ranged = date && j + 9 <= len(cs) && seg(cs, j, j + 4) == " to " && digits_at(cs, j + 4, 2)
    && cs[j + 6] == '-' && digits_at(cs, j + 7, 2) && digit_free(cs, j + 9)
  if ranged { 19 } else if date { 10 } else { 0 }
}

## Table text with each ISO date in `span.date`, which the stylesheet keeps on
## one line: a narrow column otherwise breaks `2026-07-23` at its hyphen. Done
## with markup rather than a non-breaking hyphen in the text, so that what a
## reader copies or searches for is still the date as written.
fn dated_html(s: String) -> String = {
  let cs = code_points(s)
  let n = len(cs)
  var out: List[String] = []
  var start = 0
  var i = 0
  while i < n {
    let k = date_len(cs, i)
    if k > 0 {
      out = out ++ [escape_html(seg(cs, start, i)), `<span class="date">` ++ escape_html(seg(cs, i, i + k)) ++ "</span>"]
      i = i + k
      start = i
    } else {
      i = i + 1
    }
  }
  join(out ++ [escape_html(seg(cs, start, n))], "")
}

## [inline_html] for a table cell: the same markup, with dates kept whole.
## Code is left as written; a date inside it is code.
fn cell_inline_html(it: Inline, map_url: fn(String) -> String) -> String =
  match it {
    Text(s) -> dated_html(s)
    Bold(xs) -> "<strong>" ++ cell_inlines_html(xs, map_url) ++ "</strong>"
    Em(xs) -> "<em>" ++ cell_inlines_html(xs, map_url) ++ "</em>"
    Del(xs) -> "<del>" ++ cell_inlines_html(xs, map_url) ++ "</del>"
    _ -> inline_html(it, map_url)
  }

fn cell_inlines_html(items: List[Inline], map_url: fn(String) -> String) -> String =
  join(map(items, it => cell_inline_html(it, map_url)), "")

## A cell that is one piece of code and nothing else is a key -- a command, a
## flag, a type name -- and `td.key` keeps it on one line. Decided here, from
## the cell's inlines, because the stylesheet can only guess: the `:has()`
## rules it used to carry also caught a sentence that merely contained code,
## and one such sentence stretched a whole column to its full length.
fn is_key(cell: List[Inline]) -> Bool =
  match cell {
    [Code(_)] -> true
    _ -> false
  }

fn cell_html(tag: String, cells: List[List[Inline]], map_url: fn(String) -> String) -> String =
  join(map(cells, c => {
    let open = if tag == "td" && is_key(c) { `<td class="key">` } else { "<${tag}>" }
    open ++ cell_inlines_html(c, map_url) ++ "</${tag}>"
  }), "")

## A table in a scrolling frame: on a phone a wide table scrolls inside the
## frame instead of widening the page.
fn table_html(
  header: List[List[Inline]],
  rows: List[List[List[Inline]]],
  map_url: fn(String) -> String,
) -> String = {
  let head = "<thead>\n<tr>" ++ cell_html("th", header, map_url) ++ "</tr>\n</thead>"
  let body = join(map(rows, r => "<tr>" ++ cell_html("td", r, map_url) ++ "</tr>"), "\n")
  `<div class="table-wrap">` ++ "\n<table>\n" ++ head ++ "\n<tbody>\n" ++ body ++ "\n</tbody>\n</table>\n</div>"
}

fn is_digit(c: Char) -> Bool = c >= '0' && c <= '9'

## The section number a heading prints and the rest of its text: `2.1 Foo`
## -> ("2.1", "Foo"), `6. Effects` -> ("6.", "Effects"), `D3 comptime` ->
## ("D3", "comptime"), `M5 the site` -> ("M5", "the site"). A heading that
## does not open with one, or whose number is not followed by a space
## (`M0–M7: from nothing`), is all text: ("", s).
pub fn split_number(s: String) -> (String, String) = {
  let cs = code_points(s)
  let n = len(cs)
  var i = 0
  var ok = false
  if n > 0 && (cs[0] == 'D' || cs[0] == 'M') {
    i = 1
    while i < n && is_digit(cs[i]) {
      i = i + 1
    }
    ok = i > 1
  } else if n > 0 && is_digit(cs[0]) {
    while i < n && (is_digit(cs[i]) || cs[i] == '.') {
      i = i + 1
    }
    ok = true
  }
  if ok && i < n && cs[i] == ' ' {
    (seg(cs, 0, i), str.trim_start(seg(cs, i, n)))
  } else {
    ("", s)
  }
}

## A heading's inner markup. With an id, its printed number (if any) is set
## apart in `span.hn` -- gen/links reads it from there to hold it to the id --
## and a `#` link to the heading follows the text, for a reader who wants the
## address of the section in front of them.
fn heading_html(lvl: Int, id: String, items: List[Inline], map_url: fn(String) -> String) -> String =
  if id == "" {
    "<h${lvl}>" ++ inlines_html(items, map_url) ++ "</h${lvl}>"
  } else {
    let inner =
      match items {
        [Text(first), ..] -> {
          let (num, rest) = split_number(first)
          if num == "" {
            inlines_html(items, map_url)
          } else {
            `<span class="hn">` ++ escape_html(num) ++ "</span>"
              ++ inlines_html([Text(rest)] ++ drop_first(items), map_url)
          }
        }
        _ -> inlines_html(items, map_url)
      }
    let anchor = """<a class="anchor" href="#${id}" aria-hidden="true" tabindex="-1">#</a>"""
    """<h${lvl} id="${id}">""" ++ inner ++ anchor ++ "</h${lvl}>"
  }

fn drop_first(items: List[Inline]) -> List[Inline] = map(range(1, len(items)), i => items[i])

## What a timeline item opens with: a milestone (`M5 …`) or a date
## (`2026-07-11.`), in bold.
fn is_stamp(t: String) -> Bool = {
  let cs = code_points(t)
  let n = len(cs)
  let milestone = n >= 2 && cs[0] == 'M' && is_digit(cs[1])
  let date = n >= 5 && is_digit(cs[0]) && is_digit(cs[1]) && is_digit(cs[2]) && is_digit(cs[3])
    && cs[4] == '-'
  milestone || date
}

fn opens_with_stamp(bs: List[Block]) -> Bool =
  match bs {
    [Para(items), ..] ->
      match items {
        [Bold(xs), ..] -> is_stamp(inline_text(xs))
        _ -> false
      }
    _ -> false
  }

## A list whose every item opens with a milestone or a date in bold: the
## early design notes' milestones and each period of the history page. Drawn
## as a timeline.
fn is_timeline(items: List[List[Block]]) -> Bool =
  len(items) > 0 && len(filter(items, bs => not opens_with_stamp(bs))) == 0

## One block outside the numbered top level (list items, quotes): no anchors.
## `out` as in [code_html].
fn block_html(b: Block, map_url: fn(String) -> String, play: Option[Play]) -> String =
  match b {
    Heading(lvl, items) -> heading_html(lvl, "", items, map_url)
    Para(items) -> "<p>" ++ inlines_html(items, map_url) ++ "</p>"
    CodeBlock(lang, body) -> code_html(lang, body, play, "")
    # highlighted like any other block, never offered: see md/ast.Fragment
    Fragment(lang, body) -> code_html(lang, body, None, "")
    # in a window, never offered: see md/ast.Program
    Program(lang, deps, body) -> program_html(lang, deps, body, play, "")
    UList(items) -> {
      let open = if is_timeline(items) { `<ul class="timeline">` } else { "<ul>" }
      open ++ "\n" ++ items_html(items, map_url, play) ++ "\n</ul>"
    }
    OList(items) -> "<ol>\n" ++ items_html(items, map_url, play) ++ "\n</ol>"
    Table(header, rows) -> table_html(header, rows, map_url)
    Quote(bs) -> "<blockquote>\n" ++ blocks_html(bs, map_url, play) ++ "\n</blockquote>"
    Rule -> "<hr>"
  }

## A run of blocks, with a dawn block and the output under it paired into one
## window where the page offers the Playground.
fn blocks_html(bs: List[Block], map_url: fn(String) -> String, play: Option[Play]) -> String = {
  var chunks: List[String] = []
  var i = 0
  while i < len(bs) {
    match offered_pair(bs, i, play) {
      Some(win) -> {
        chunks = chunks ++ [win]
        i = i + 2
      }
      None -> {
        chunks = chunks ++ [block_html(bs[i], map_url, play)]
        i = i + 1
      }
    }
  }
  join(chunks, "\n")
}

## A page's head, taken off the front of its document: the `#` title, and the
## translation note that follows it when the document has one (a paragraph
## that is nothing but one `*…*`, such as "*[中文](spec.md) — the Chinese text is
## the original…*"). The page shell sets both in the sky band above the
## article; `body` is everything after them. Either is empty when the
## document does not have it.
pub type Parts = { title: List[Inline], twin: List[Inline], body: List[Block] } derive Show

pub fn split_head(blocks: List[Block]) -> Parts = {
  var title: List[Inline] = []
  var twin: List[Inline] = []
  var from = 0
  match get(blocks, 0) {
    Some(Heading(lvl, items)) -> {
      if lvl == 1 {
        title = items
        from = 1
      }
    }
    _ -> ()
  }
  match get(blocks, from) {
    Some(Para([Em(xs)])) -> {
      if from == 1 {
        twin = [Em(xs)]
        from = from + 1
      }
    }
    _ -> ()
  }
  Parts { title: title, twin: twin, body: map(range(from, len(blocks)), i => blocks[i]) }
}

## The translation note's link, as (label, url) with the url as the document
## wrote it: the note leads to the same document in the other language, and
## the page sets that link apart as a chip ("", "") when there is no note or
## it links nowhere.
pub fn twin_link(twin: List[Inline]) -> (String, String) = {
  var found = ("", "")
  for it in twin {
    let (l, _) = found
    if l == "" {
      found =
        match it {
          Link(label, url) -> (label, url)
          Em(xs) -> twin_link(xs)
          Bold(xs) -> twin_link(xs)
          _ -> ("", "")
        }
    }
  }
  found
}

## How many entries the document's timelines hold: the items of every top-
## level list drawn as a timeline (see [is_timeline]). What the history page
## counts in its band.
pub fn timeline_entries(blocks: List[Block]) -> Int = {
  var n = 0
  for b in blocks {
    match b {
      UList(items) -> {
        if is_timeline(items) {
          n = n + len(items)
        }
      }
      _ -> ()
    }
  }
  n
}

## Render a whole document: h2/h3 get numbered ids and TOC entries; the first
## h1 becomes the title. h4 gets a numbered id too but stays OUT of the TOC —
## the sidebar is a two-level map, and spec §9.5.1-style leaves would bury it.
pub fn render_doc(blocks: List[Block], map_url: fn(String) -> String) -> Doc =
  render_doc_play(blocks, map_url, None)

## `render_doc` with the Playground offer of the module comment on
## `code_html`. Two entry points rather than one with a defaulted argument, so
## that every page which does NOT hand out links says so by calling the short
## name instead of by omitting something.
##
## A quote that is the document's first block is its status note (`> Status:
## normative …`) and is marked so; a caller that took the title and the
## translation note off with [split_head] hands the body here, and the note is
## then its first block.
pub fn render_doc_play(
  blocks: List[Block],
  map_url: fn(String) -> String,
  play: Option[Play],
) -> Doc = {
  var chunks: List[String] = []
  var toc: List[TocEntry] = []
  var heads: List[TocEntry] = []
  var title = ""
  var h2 = 0
  var h3 = 0
  var h4 = 0
  var i = 0
  while i < len(blocks) {
    let b = blocks[i]
    var step = 1
    match b {
      Heading(lvl, items) -> {
        if lvl == 1 {
          if title == "" {
            title = inline_text(items)
          }
          chunks = chunks ++ [heading_html(1, "", items, map_url) ++ "\n"]
        } else if lvl == 2 {
          h2 = h2 + 1
          h3 = 0
          h4 = 0
          let id = "s${h2}"
          toc = toc ++ [TocEntry { level: 2, id: id, text: inline_text(items) }]
          heads = heads ++ [TocEntry { level: 2, id: id, text: inline_text(items) }]
          chunks = chunks ++ [heading_html(2, id, items, map_url) ++ "\n"]
        } else if lvl == 3 {
          h3 = h3 + 1
          h4 = 0
          let id = "s${h2}-${h3}"
          toc = toc ++ [TocEntry { level: 3, id: id, text: inline_text(items) }]
          heads = heads ++ [TocEntry { level: 3, id: id, text: inline_text(items) }]
          chunks = chunks ++ [heading_html(3, id, items, map_url) ++ "\n"]
        } else {
          h4 = h4 + 1
          let id = "s${h2}-${h3}-${h4}"
          heads = heads ++ [TocEntry { level: 4, id: id, text: inline_text(items) }]
          chunks = chunks ++ [heading_html(4, id, items, map_url) ++ "\n"]
        }
      }
      Quote(bs) -> {
        let cls = if i == 0 { ` class="status"` } else { "" }
        chunks = chunks
          ++ ["<blockquote${cls}>\n" ++ blocks_html(bs, map_url, play) ++ "\n</blockquote>\n"]
      }
      _ -> {
        match offered_pair(blocks, i, play) {
          Some(win) -> {
            chunks = chunks ++ [win ++ "\n"]
            step = 2
          }
          None -> {
            chunks = chunks ++ [block_html(b, map_url, play) ++ "\n"]
          }
        }
      }
    }
    i = i + step
  }
  Doc { html: join(chunks, ""), toc: toc, heads: heads, title: title }
}

fn keep_url(u: String) -> String = u

test "inline rendering escapes and maps links" {
  assert inlines_html([Text("a < b "), Code("x>y")], keep_url) ==
    "a &lt; b <code>x&gt;y</code>"
  assert inline_html(Link("规范", "spec.md"), u => "mapped/" ++ u) ==
    `<a href="mapped/spec.md">规范</a>`
}

## #316: the href is an attribute value, so a `"` in a URL must not end it.
test "a link's url is escaped for its attribute, its label for text" {
  let html = inline_html(Link("a \"b\" & c", "x.html?q=\"1\"&r=2"), keep_url)
  assert html == `<a href="x.html?q=&quot;1&quot;&amp;r=2">a "b" &amp; c</a>`
}

test "headings number their anchors and fill the toc" {
  let doc = render_doc([
    Heading(1, [Text("题")]),
    Heading(2, [Text("一")]),
    Heading(3, [Text("一点一")]),
    Heading(2, [Text("二")]),
  ], keep_url)
  assert doc.title == "题"
  assert doc.toc == [
    TocEntry { level: 2, id: "s1", text: "一" },
    TocEntry { level: 3, id: "s1-1", text: "一点一" },
    TocEntry { level: 2, id: "s2", text: "二" },
  ]
  assert str.contains(doc.html, `<h2 id="s1">一<a class="anchor" href="#s1" aria-hidden="true" tabindex="-1">#</a></h2>`)
  assert str.contains(doc.html, `<h3 id="s1-1">一点一<a class="anchor" href="#s1-1"`)
}

## The h4s the TOC leaves out are still anchored, and `heads` is where they
## are handed over: every id the page carries, in order, and nothing else.
test "heads lists every anchored heading, h4 included" {
  let doc = render_doc([
    Heading(2, [Text("a")]),
    Heading(4, [Text("a-0-1")]),
    Heading(3, [Text("b")]),
    Heading(4, [Text("c")]),
    UList([[Heading(3, [Text("nested")])]]),
  ], keep_url)
  assert map(doc.heads, e => e.id) == ["s1", "s1-0-1", "s1-1", "s1-1-1"]
  assert map(doc.toc, e => e.id) == ["s1", "s1-1"]
  for e in doc.heads {
    assert str.contains(doc.html, " id=\"${e.id}\"")
  }
}

## The number a heading prints is set apart, so the eye can run down the
## numbers and gen/links can hold each one to its id.
test "a heading's printed number is split off into span.hn" {
  assert split_number("2.1 Foo") == ("2.1", "Foo")
  assert split_number("6. 效果系统") == ("6.", "效果系统")
  assert split_number("D3 comptime rather than macros") == ("D3", "comptime rather than macros")
  assert split_number("M5 the site") == ("M5", "the site")
  # a number with no space after it is part of the text
  assert split_number("M0–M7: from nothing") == ("", "M0–M7: from nothing")
  assert split_number("Decisions") == ("", "Decisions")
  assert split_number("D is for Dawn") == ("", "D is for Dawn")
  let doc = render_doc([Heading(2, [Text("2. Types "), Code("Int")])], keep_url)
  assert str.contains(doc.html,
    `<h2 id="s1"><span class="hn">2.</span>Types <code>Int</code><a class="anchor" href="#s1"`)
  # the toc keeps the whole text; html/page splits it there
  assert doc.toc == [TocEntry { level: 2, id: "s1", text: "2. Types Int" }]
}

test "the title and the translation note come off the front of a document" {
  let parts = split_head([
    Heading(1, [Text("Spec")]),
    Para([Em([Link("中文", "spec.md"), Text(" — the original")])]),
    Quote([Para([Text("Status: normative")])]),
    Para([Text("body")]),
  ])
  assert parts.title == [Text("Spec")]
  assert parts.twin == [Em([Link("中文", "spec.md"), Text(" — the original")])]
  assert len(parts.body) == 2
  # the status note is now the body's first block, and is marked
  let doc = render_doc(parts.body, keep_url)
  assert str.starts_with(doc.html, "<blockquote class=\"status\">")
  # a quote further down is an ordinary quote
  let later = render_doc([Para([Text("x")]), Quote([Para([Text("y")])])], keep_url)
  assert str.contains(later.html, "<blockquote>\n<p>y</p>")
  # a document with no note keeps its first paragraph
  let plain = split_head([Heading(1, [Text("T")]), Para([Text("lede")])])
  assert plain.twin == []
  assert plain.body == [Para([Text("lede")])]
}

test "a list of milestones or dates in bold is a timeline, any other list is not" {
  let ms = render_doc([UList([
    [Para([Bold([Text("M0 end to end")]), Text(" (done)")])],
    [Para([Bold([Text("M1 looks like a language")])])],
  ])], keep_url)
  assert str.contains(ms.html, `<ul class="timeline">`)
  let dates = render_doc([UList([[Para([Bold([Text("2026-07-11.")]), Text(" M0")])]])], keep_url)
  assert str.contains(dates.html, `<ul class="timeline">`)
  let mixed = render_doc([UList([
    [Para([Bold([Text("M0 end to end")])])],
    [Para([Bold([Text("Note")]), Text(" not a milestone")])],
  ])], keep_url)
  assert not str.contains(mixed.html, "timeline")
}

test "struck text renders as del" {
  assert inlines_html([Del([Text("a < b")])], keep_url) == "<del>a &lt; b</del>"
}

test "tight and loose list items" {
  let tight = render_doc([UList([[Para([Text("甲")])], [Para([Text("乙")])]])], keep_url)
  assert str.contains(tight.html, "<li>甲</li>")
  let loose = render_doc([UList([[Para([Text("甲")]), CodeBlock("", "x")]])], keep_url)
  assert str.contains(loose.html, "<li><p>甲</p>\n<pre><code>x</code></pre></li>")
}

test "dawn code blocks come out highlighted" {
  let doc = render_doc([CodeBlock("dawn", "let x = 1")], keep_url)
  assert str.contains(doc.html, `<span class="k">let</span>`)
  let out = render_doc([CodeBlock("output", "1 < 2")], keep_url)
  assert str.contains(out.html, `<pre class="output"><code>1 &lt; 2</code></pre>`)
}

## The offer reaches a dawn block wherever one can appear, not only at the top
## level: the tutorial puts code inside list items and inside quotes, and a
## block that lost the link on the way down would be a link missing from a page
## that has one everywhere else.
test "the playground offer reaches nested dawn blocks and nothing else" {
  let p = Some(Play { href: "../playground.html", label: "Open in playground" })
  let paired = render_doc_play([CodeBlock("dawn", "let x = 1"), CodeBlock("output", "1")], keep_url, p)
  # the output under a program goes into its window, after the code
  assert str.contains(paired.html, "</code></pre>\n" ++ `<pre class="output"><code>1</code></pre>` ++ "\n</figure>")
  assert len(str.split(paired.html, "<figure")) == 2
  let nested = render_doc_play([
    UList([[CodeBlock("dawn", "let x = 1")]]),
    Quote([CodeBlock("dawn", "let y = 2")]),
    CodeBlock("output", "1"),
  ], keep_url, p)
  assert str.contains(nested.html, `href="../playground.html#bGV0IHggPSAx"`)
  assert str.contains(nested.html, `href="../playground.html#bGV0IHkgPSAy"`)
  # the output fence is prose about a program, not a program
  assert str.contains(nested.html, `<pre class="output"><code>1</code></pre>`)
}

## A `skip-check` fragment is not a program on its own, so a link to run it
## would be a link that always fails. Highlighted all the same.
test "a fragment is highlighted and never offered to the playground" {
  let p = Some(Play { href: "../playground.html", label: "Open in playground" })
  let doc = render_doc_play([Fragment("dawn", "let x = 1"), UList([[Fragment("dawn", "let y = 2")]])],
    keep_url, p)
  assert str.contains(doc.html, `<span class="k">let</span>`)
  assert not str.contains(doc.html, "play-open")
  assert not str.contains(doc.html, "playable")
}

## A program that needs packages is still a program with its output: one
## window, the packages named in its bar, and no link, because the Playground
## could not resolve its imports.
test "a program with deps keeps its output window and gets no playground link" {
  let p = Some(Play { href: "../playground.html", label: "Open in playground" })
  let doc = render_doc_play([Program("dawn", ["tileir"], "let x = 1"), CodeBlock("output", "1")], keep_url, p)
  assert str.contains(doc.html, `<figure class="win">`)
  assert str.contains(doc.html, `<span class="lbl">dawn · tileir</span>`)
  assert str.contains(doc.html, `<span class="k">let</span>`)
  assert str.contains(doc.html, "</code></pre>\n" ++ `<pre class="output"><code>1</code></pre>` ++ "\n</figure>")
  assert len(str.split(doc.html, "<figure")) == 2
  assert not str.contains(doc.html, "play-open")
  assert not str.contains(doc.html, "playable")
  # nested, alone, and with two packages
  let nested = render_doc_play([UList([[Program("dawn", ["tileir", "tileref"], "let y = 2")]])], keep_url, p)
  assert str.contains(nested.html, `<span class="lbl">dawn · tileir, tileref</span>`)
  assert not str.contains(nested.html, "play-open")
  # a page that offers nothing shows it like any other block
  let plain = render_doc([Program("dawn", ["tileir"], "let x = 1"), CodeBlock("output", "1")], keep_url)
  assert not str.contains(plain.html, "<figure")
  assert str.contains(plain.html, `<pre class="output"><code>1</code></pre>`)
}

test "tables render thead and tbody, inside a scrolling frame" {
  let doc = render_doc([Table([[Text("列")]], [[[Code("v")]]])], keep_url)
  assert str.starts_with(doc.html, `<div class="table-wrap">` ++ "\n<table>")
  assert str.contains(doc.html, "<thead>\n<tr><th>列</th></tr>\n</thead>")
  assert str.contains(doc.html, "<tbody>\n<tr><td class=\"key\"><code>v</code></td></tr>\n</tbody>")
}

## The stylesheet keeps a key cell on one line; a cell with code and words is
## prose and must be free to wrap.
test "a cell that is only code is a key, code with words is not" {
  let doc = render_doc([Table([[Text("a")], [Text("b")]], [[[Code("dawn run")], [Code("x"), Text(" is a list")]]])],
    keep_url)
  assert str.contains(doc.html, `<tr><td class="key"><code>dawn run</code></td><td><code>x</code> is a list</td></tr>`)
  # header cells are never keys
  let head = render_doc([Table([[Code("k")]], [])], keep_url)
  assert str.contains(head.html, "<tr><th><code>k</code></th></tr>")
}

test "dates in a table cell are wrapped whole, ranges included" {
  let doc = render_doc([Table([[Text("When")]], [
    [[Text("2026-07-30; 2026-09-02")]],
    [[Text("2026-08-31 to 09-01")]],
    [[Bold([Text("on 2026-07-12")]), Code(" 2026-07-13"), Text(" 12026-01-01 x")]],
  ])], keep_url)
  assert str.contains(doc.html,
    `<td><span class="date">2026-07-30</span>; <span class="date">2026-09-02</span></td>`)
  assert str.contains(doc.html, `<td><span class="date">2026-08-31 to 09-01</span></td>`)
  # bold text is dated, code is not, and a longer number is not a date
  assert str.contains(doc.html,
    `<td><strong>on <span class="date">2026-07-12</span></strong><code> 2026-07-13</code> 12026-01-01 x</td>`)
  # outside a table, prose is untouched
  let para = render_doc([Para([Text("2026-07-30")])], keep_url)
  assert para.html == "<p>2026-07-30</p>\n"
}

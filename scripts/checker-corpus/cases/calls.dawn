# checker.dawn: call shapes
type Rec = { f: fn(Int) -> Int }

pub fn plain(a: Int, b: Int) -> Int = a + b

pub fn not_a_fn(x: Int) -> Int = x(1)

pub fn wrong_arity() -> Int = plain(1)

pub fn wrong_arg() -> Int = plain(1, "a")

pub fn missing() -> Int = nosuch(1)

pub fn value_call(f: fn(Int) -> Int) -> Int = f("a")

pub fn value_arity(f: fn(Int) -> Int) -> Int = f(1, 2)

pub fn value_not_fn(x: Int) -> Int = {
  let g = x
  g(1)
}

pub fn named_args() -> Int = plain(a: 1, b: 2)

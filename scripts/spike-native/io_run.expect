-- the status is the child's own --
0  -> 0
3  -> 3
42 -> 42
-- the two streams stay apart --
stdout = out
stderr = err
-- each run truncates, it does not append --
stdout = second
-- more output than a pipe would buffer --
bytes = 524288
-- empty paths inherit, so nothing is redirected --
7 -> 7
-- argv reaches the program as given, unparsed --
argv = [a b][c*d][-n]
-- a program that is not there is a failure, not a status --
refused

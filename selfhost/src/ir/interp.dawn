# Compile-time evaluation (spec §7): a tree walker over Core IR's pure subset.
# Top-level const initializers and comptime blocks run here after checking;
# codegen embeds the results.
#
# It consumes Core rather than TAST on purpose. A comptime interpreter that
# walks the source tree is a second definition of the language: it has to
# decide what `match` means, what `?` returns, how `for` iterates, when a
# value is boxed -- and nothing forces those decisions to agree with the
# backends'. Reading the same IR the backends read makes the agreement
# structural instead of a promise. Note what is not in this file any more:
# no pattern matcher, no `for`/`while`, no `?`/`!`, no interpolation.
#
# Control flow: ER = Result[(ESt, Env, CValue), (ESt, Env, Ctl)] -- `?` is
# throw, a call catches KReturn, a loop catches KBreak/KContinue naming it.
# The state carries fuel (the real bound on runaway evaluation) and the call
# depth (turns a would-be stack overflow into a decent message). Both start
# over for every folded expression. What lowering produced does not: the
# `LowerCache` is built once per module and handed from one const or comptime
# block to the next, so a helper ten consts call is lowered once.
#
# Core still carries no precise source positions. Interpreter failures stay
# structured until the fold boundary, though: the original actionable hint
# is separate from a bounded call chain, and only that boundary chooses the
# enclosing const/comptime span and constructs a public diagnostic.
#
# The Kotlin interpreter ran on a dedicated 64MB thread; this one recurses on
# the host stack, so the selfhost JVM is launched with -Xss512m instead.

use std/char
use std/str
use std/fmt
use std/list
use std/map
use std/set
use front/token.{Diag}
use check/tast.{
  TExpr, TStmt, TFun, TModule, TJavaCall,
  XStr, XLambda, XApply, XJava, XPropagate, XUnwrap, XReturn, XIndex,
  XCallDyn, XCallBuiltin, XCallFn, XCtor, XField, XListLit, XTupleLit,
  TLEExpr, TLESpread, TLEIf,
  XBinary, XUnary, XIf, XMatch, XBlock, XComptime, XUnsafePure,
  XError,
  TSPText, TSPInterp,
  TSLet, TSLetPat, TSLocalFn, TSAssign, TSExpr, TSAssert, TSWhile, TSFor
}
use check/types.{
  Ty, TyInt, TyUnit, TyError, TyAdt, Sym, Sig, Traits, ImplI, Impls, Adts, adt_of,
  intrinsics, OPTION_ID, EPure, TyList, TyMap, TySet, TyArray, TyTuple,
  EV_PACK_ID, EV_MISS_MSG
}
use ir/core.{
  CValue, VInt, VFloat, VBool, VStr, VUnit, VList, VTuple, VAdt,
  VClosure, VDict,
  CExpr, CStmt, CFun, CDictDef, CSlotFn, CSlotDefault, ty_key,
  CInt, CFloat, CBool, CStr, CUnit, CLocal, CFnRef, CCall, CIntrinsic,
  CCtor, CField, CIsCtor, CTagOf, CClosure, CTuple, CTupleGet, CBox, CUnbox,
  CBinary, CUnary, CIf, CBlock, CListLit, CConstRef, CComptime,
  CReturn, CBreak, CContinue, CForeign, CDup, CDictRef, CDictApply, CDictArg, CJava,
  CSLet, CSAssign, CSDiscard, CSLoop, CSIf, CSDrop,
  CDirect, CDynamic, CMethod, CImpl, CDefault,
  CAdd, CSub, CMul, CDiv, CMod, CEq, CNe, CLt, CLe, CGt, CGe, CAnd, COr,
  CBand, CBor, CBxor, CShl, CShr, CUshr, CConcat, CNeg, CNot, CBnot,
  CBinOp
}
use ir/lower
use front/parser
use check/cx.{ModExports, Cx, cx_new}
use check/checker.{check_module, exports_of}
use check/jsig.{Jsig, JClass, JMethod, jsig_refused}

type CtFrame =
  | FDirect(owner: String, name: String)
  | FDynamic(owner: String, name: String)
  | FImpl(owner: String, trait_name: String, trait_id: Int, subject: String, method: String)
  | FDefault(owner: String, trait_name: String, trait_id: Int, method: String)

type CtOrigin = { lo: Int, hi: Int }

type CtFailure = {
  msg: String,
  hint: String,
  # nearest failure frame first; outer frames are the ones discarded at cap
  frames: List[CtFrame],
  truncated: Bool,
  # Core cannot fill this yet. The fold boundary records its enclosing span.
  origin: Option[CtOrigin]
}

type Ctl =
  | KErr(failure: CtFailure)
  | KReturn(v: CValue)
# break and continue name their loop: lowering turns a `match` into a
# once-loop, so a `break` inside an arm leaves a loop that is not the
# innermost one.
  | KBreak(loop_id: Int)
  | KContinue(loop_id: Int)

## What lowering has produced for this module so far. It is separate from
## `ESt` because it outlives the expression being folded: lowering reads the
## module's trait, impl, adt, signature and symbol tables, and those are fixed
## for the whole run, so the body it produces for a function does not depend
## on which const or comptime block asked for it. Ten consts calling one
## helper therefore lower that helper once.
##
## `next_lam` belongs here for the same reason and must not restart per
## expression. Lifted lambdas are keyed by their generated name (`lambda$0`,
## `lambda$1`, ...) in the very table above them; a counter that restarted
## would let the second expression's `lambda$0` land on the first's entry.
type LowerCache = {
  # bodies lowered so far, keyed "owner.name" -- including the lambdas
  # lowering lifted out of them. Lowering happens on demand because one
  # comptime run touches a handful of functions out of the whole program.
  fns: Map[String, CFun],
  # the dictionaries lowering registered while lowering those bodies, by key:
  # what `CMethod` looks a slot up in
  dicts: Map[String, CDictDef],
  # seeds the lifted-lambda counter so names stay unique across the module
  next_lam: Int
}

## One expression's evaluation. Fuel and depth are the per-evaluation half and
## start over for every fold; the cache is the module-level half and is handed
## on to the next one.
type ESt = {
  fuel: Int,
  depth: Int,
  cache: LowerCache
}

alias Env = Map[Int, CValue]

alias ER = Result[(ESt, Env, CValue), (ESt, Env, Ctl)]

alias SR = Result[(ESt, Env), (ESt, Env, Ctl)]

## What a comptime run is allowed to do, and how much of it.
##
## `fuel` is a tuning knob. `ffi` is not: it is the capability to reach
## `eval_java`, which invokes a JDK static method *inside the compiler
## process*. Compiling a source file must not be a way to run code on the
## machine doing the compiling, so this is off unless the person running the
## compiler passes `--comptime-ffi`. An `unsafe_pure` in the source vouches
## that a call is pure; it does not, and must not, also grant that call the
## run of the host -- those are promises to different parties.
##
## `jcall` is how a granted call actually happens: policy lives here, the
## reflective invoke lives in `jfold`, and a main that can host it wires
## `jfold.fold_call` in. The default refuses, so this module -- and every
## module a JVM-less main pulls in -- carries no `use java`.
pub type CtOpts = {
  fuel: Int,
  ffi: Bool,
  jcall: fn(TJavaCall, List[CValue]) -> Result[CValue, (String, String)] !io
}

pub const DEFAULT_FUEL: Int = 100000000

## The default `jcall`: a compiler with no host JVM wired in. Only reachable
## when policy said yes (--comptime-ffi) but no main provided the capability.
pub fn jcall_refused(
  jc: TJavaCall,
  args: List[CValue]
) -> Result[CValue, (String, String)] !io =
  Err(("compile-time Java calls are not available in this compiler",
    "this build cannot invoke a host JVM; make this a runtime call instead of a const"))

## Defaults: all the fuel a real compile gets, and no host FFI.
pub fn ct_default() -> CtOpts =
  CtOpts { fuel: DEFAULT_FUEL, ffi: false, jcall: jcall_refused }

## Defaults with the fuel dialled down (the fuel tests, and callers that want
## a comptime run bounded well below a real compile's).
pub fn ct_fuel(n: Int) -> CtOpts = CtOpts { fuel: n, ffi: false, jcall: jcall_refused }

## The interpreter's static context: how to find a function body, the tables
## lowering needs, and the results already folded.
type ICx = {
  # flat name → direct typed fn (module fns over std fns; local shadows std)
  fns: Map[String, TFun],
  # owner → (name → direct typed fn): qualified calls resolve by owner
  by_owner: Map[String, Map[String, TFun]],
  # flat name → the owner it was found under, so a function lowered on
  # demand resolves its own module's calls first
  owner_of: Map[String, String],
  std_names: Set[String],
  adts: Adts,
  consts: Map[String, CValue],
  # comptime block results by span: a block nested in the expression being
  # folded is itself folded first, and lowering leaves behind a reference
  blocks: Map[(Int, Int), CValue],
  # the module being folded, and the tables lowering needs from it
  owner: String,
  traits: Traits,
  impls: Impls,
  # Every CDirect signature lowering may consult, keyed by resolved owner.
  # CImpl/CDefault signatures come from `traits`/`impls`, not this lossy key.
  prog_fns: Map[(String, String), Sig],
  # Every impl method and trait default in the program, by the identity a
  # `CImpl`/`CDefault` node carries. A flat table is not a shortcut: coherence
  # means one impl per (trait, head) program-wide, so the key is unique --
  # which `by_owner` is not, since two impls in one module can both define
  # `eq`.
  impl_fns: Map[(Int, String, String), (String, TFun)],
  syms: Map[Int, Sym],
  # whether this run may call into the host JVM, and how (see CtOpts)
  ffi: Bool,
  jcall: fn(TJavaCall, List[CValue]) -> Result[CValue, (String, String)] !io
}

# A deliberate constant, not a value derived from the stack. Measured
# 2026-07-31 (docs/audit/ceval-trampoline-verdict.md 4): the interpreter's own
# frames exhaust -Xss below 128m before this counter fires, so the limit only
# binds at -Xss >= 128m -- at the shipped 512m it is what actually stops
# runaway comptime recursion. Anyone lowering -Xss below 128m trades this
# diagnostic for a raw StackOverflowError. Do not make it dynamic: the measured
# depth-per-stack is JIT-dependent, and a limit you only learn by running is
# worse than an honest constant.
const MAX_CALL_DEPTH: Int = 100000

const MAX_FAILURE_FRAMES: Int = 16

fn no_impls() -> Map[(Int, String, String), (String, TFun)] = map.empty()

fn ct_failure(msg: String, hint: String) -> CtFailure =
  CtFailure { msg: msg, hint: hint, frames: [], truncated: false, origin: None }

fn cerr(st: ESt, env: Env, msg: String) -> ER =
  Err((st, env, KErr(ct_failure(msg, ""))))

fn cerrh(st: ESt, env: Env, msg: String, hint: String) -> ER =
  Err((st, env, KErr(ct_failure(msg, hint))))

fn push_failure_frame(failure: CtFailure, frame: CtFrame) -> CtFailure =
  if len(failure.frames) < MAX_FAILURE_FRAMES {
    CtFailure { ..failure, frames: failure.frames ++ [frame] }
  } else {
    CtFailure { ..failure, truncated: true }
  }

fn frame_error(
  err: (ESt, Env, Ctl),
  frame: CtFrame
) -> (ESt, Env, Ctl) = {
  let (st, env, ctl) = err
  match ctl {
    KErr(failure) -> (st, env, KErr(push_failure_frame(failure, frame)))
    _ -> err
  }
}

fn framed(result: ER, frame: CtFrame) -> ER =
  match result {
    Ok(value) -> Ok(value)
    Err(err) -> Err(frame_error(err, frame))
  }

fn trait_frame_name(icx: ICx, trait_id: Int) -> String =
  match map.get(icx.traits, trait_id) {
    Some(tr) -> tr.name
    None -> "trait"
  }

fn render_frame(frame: CtFrame) -> String =
  match frame {
    FDirect(owner, name) -> "direct `" ++ owner ++ "." ++ name ++ "`"
    FDynamic(owner, name) -> "dynamic `" ++ owner ++ "." ++ name ++ "`"
    FImpl(owner, trait_name, trait_id, subject, method) ->
      "impl `" ++ owner ++ "::" ++ trait_name ++ "#" ++ to_string(trait_id) ++
      "[" ++ subject ++ "]." ++ method ++ "`"
    FDefault(owner, trait_name, trait_id, method) ->
      "default `" ++ owner ++ "::" ++ trait_name ++ "#" ++ to_string(trait_id) ++
      "." ++ method ++ "`"
  }

fn render_call_chain(failure: CtFailure) -> String = {
  if len(failure.frames) == 0 { return "" }
  var lines = ["comptime call chain (innermost first):"]
  for frame in failure.frames { lines = lines ++ ["  at " ++ render_frame(frame)] }
  if failure.truncated { lines = lines ++ ["  ... outer calls omitted"] }
  join(lines, "\n")
}

fn failure_diag(failure0: CtFailure, lo: Int, hi: Int) -> Diag = {
  let failure =
    match failure0.origin {
      Some(_) -> failure0
      None -> CtFailure { ..failure0, origin: Some(CtOrigin { lo: lo, hi: hi }) }
    }
  let origin = failure.origin.expect("comptime failure origin")
  let chain = render_call_chain(failure)
  let hint =
    if chain == "" { failure.hint }
    else if failure.hint == "" { chain }
    else { failure.hint ++ "\n\n" ++ chain }
  Diag {
    msg: "comptime: " ++ failure.msg,
    lo: origin.lo,
    hi: origin.hi,
    hint: hint
  }
}

fn burn(st: ESt, env: Env) -> ER =
  if st.fuel - 1 < 0 {
    cerrh(st, env, "fuel exhausted — evaluation did not finish within the step budget",
      "raise it with --comptime-fuel, or simplify the computation")
  } else {
    Ok((ESt { ..st, fuel: st.fuel - 1 }, env, VUnit))
  }

fn burn_n(st: ESt, env: Env, n: Int) -> ER = {
  let cost = if n > 0 { n } else { 0 }
  let left = st.fuel - cost
  if left < 0 {
    cerrh(st, env, "fuel exhausted — evaluation did not finish within the step budget",
      "raise it with --comptime-fuel, or simplify the computation")
  } else {
    Ok((ESt { ..st, fuel: left }, env, VUnit))
  }
}

fn some_v(v: CValue) -> CValue = VAdt(OPTION_ID, 0, [v])

fn none_v() -> CValue = VAdt(OPTION_ID, 1, [])

# ---- value helpers (a mismatch here is an interpreter bug, not a user error) ----

fn as_int(v: CValue) -> Int =
  match v {
    VInt(n) -> n
    _ -> panic("comptime interpreter bug: expected an Int")
  }

## A `Char` argument, which is a `VInt` here: `Char` is opaque over `Int`, so
## it has no runtime representation of its own and the interpreter's value
## domain needs no variant for it. Whatever produced the value has been
## through the checker, so a non-scalar integer is a compiler bug.
fn as_char(v: CValue) -> Char =
  char.of(as_int(v)).expect("comptime interpreter bug: not a code point")

fn as_bool(v: CValue) -> Bool =
  match v {
    VBool(b) -> b
    _ -> panic("comptime interpreter bug: expected a Bool")
  }

fn as_str(v: CValue) -> String =
  match v {
    VStr(s) -> s
    _ -> panic("comptime interpreter bug: expected a String")
  }

fn as_list(v: CValue) -> List[CValue] =
  match v {
    VList(xs) -> xs
    _ -> panic("comptime interpreter bug: expected a List")
  }

fn as_adt(v: CValue) -> (Int, Int, List[CValue]) =
  match v {
    VAdt(aid, ci, fs) -> (aid, ci, fs)
    _ -> panic("comptime interpreter bug: expected an ADT value")
  }

pub fn cvalue_kind(v: CValue) -> String =
  match v {
    VInt(_) -> "Int"
    VFloat(_) -> "Float"
    VBool(_) -> "Bool"
    VStr(_) -> "String"
    VUnit -> "Unit"
    VList(_) -> "List"
    VTuple(_) -> "tuple"
    VAdt(_, _, _) -> "ADT value"
    VClosure(_, _, _) -> "function"
    VDict(_, _) -> "trait dictionary"
  }

fn stringify(v: CValue) -> String =
  match v {
    VInt(n) -> to_string(n)
    # the shared dtoa, called directly rather than through `to_string`: the
    # first selfhost generation is compiled by a seed whose `to_string(Float)`
    # is still the host's, and a comptime fold must give the new answer from
    # generation one (the bootstrap lesson of audit RP-02)
    VFloat(f) -> fmt.dtoa(f)
    VBool(b) -> to_string(b)
    VStr(s) -> s
    # unreachable: the checker restricts printable types
    _ -> "<value>"
  }

## The trait method `show`, which is the *nested* rendering and so a different
## function from `stringify` above: `to_string("a")` is `a`, while a String
## reached through a `[T: Show]` bound is `"a"` (spec §4.3, and lower.dawn's
## show_at draws the same line at the other end). The two were one arm of
## `call_builtin` until 2026-07-30, and one arm cannot answer both.
##
## `None` is a refusal, and the reason it is not a rendering: `show` is what
## lowering emits for a value handed over *erased*, and the interpreter has no
## more run-time type to recover it from than the C backend does. The merged
## arm answered the literal string `"<value>"` for those -- a wrong answer
## rather than a refusal, and a const folds into the emitted program, so it
## would have been baked into both backends' output.
fn show_value(v: CValue) -> Option[String] =
  match v {
    VStr(s) -> Some(quote_str(s))
    VInt(_) | VFloat(_) | VBool(_) -> Some(stringify(v))
    _ -> None
  }

## Source-literal escaping, backslash first -- the same sequence `dawn/rt/Show`
## applies, and the order is load-bearing: escaping `\` last would double the
## one the quote escape had just introduced.
fn quote_str(s: String) -> String = {
  var out = str.replace(s, "\\", "\\\\")
  out = str.replace(out, "\"", "\\\"")
  out = str.replace(out, "\n", "\\n")
  out = str.replace(out, "\t", "\\t")
  out = str.replace(out, str.from_char('\r'), "\\r")
  "\"" ++ out ++ "\""
}

## Float `==` is IEEE (spec §4.3): NaN equals nothing, -0.0 equals 0.0. The
## interpreter is itself compiled by a backend that implements exactly that,
## so Dawn's own `==` on Float *is* the answer — no host query needed.
fn float_ieee_eq(a: Float, b: Float) -> Bool = a == b

fn value_eq(a: CValue, b: CValue) -> Bool =
  match a {
    VInt(x) ->
      match b {
        VInt(y) -> x == y
        _ -> false
      }
    VFloat(x) ->
      match b {
        VFloat(y) -> float_ieee_eq(x, y)
        _ -> false
      }
    VBool(x) ->
      match b {
        VBool(y) -> x == y
        _ -> false
      }
    VStr(x) ->
      match b {
        VStr(y) -> x == y
        _ -> false
      }
    VUnit ->
      match b {
        VUnit -> true
        _ -> false
      }
    VList(xs) ->
      match b {
        VList(ys) -> list_eq(xs, ys)
        _ -> false
      }
    VTuple(xs) ->
      match b {
        VTuple(ys) -> list_eq(xs, ys)
        _ -> false
      }
    VAdt(aid, ci, fs) ->
      match b {
        VAdt(bid, bci, gs) -> aid == bid && ci == bci && list_eq(fs, gs)
        _ -> false
      }
    _ -> false
  }

fn list_eq(xs: List[CValue], ys: List[CValue]) -> Bool = {
  if len(xs) != len(ys) { return false }
  var i = 0
  while i < len(xs) {
    if not value_eq(xs[i], ys[i]) { return false }
    i = i + 1
  }
  true
}

# ---- lowering on demand ----

## Lower one function and remember it, along with every lambda it lifted.
## Lowering panics are phase-invariant failures and deliberately cross this
## boundary; expected comptime refusals are returned by the interpreter.
fn lower_into(
  icx: ICx,
  st: ESt,
  env: Env,
  owner: String,
  f: TFun
) -> Result[(ESt, CFun), (ESt, Env, Ctl)] !io = {
  let (cf, lifted, dicts, next) =
    lower.lower_fn_only(owner, f, icx.traits, icx.impls, icx.adts, icx.prog_fns,
      icx.syms, st.cache.next_lam)
  var tbl = map.insert(st.cache.fns, cache_key(owner, f), cf)
  for lf in lifted { tbl = map.insert(tbl, lf.owner ++ "." ++ lf.name, lf) }
  var dts = st.cache.dicts
  for d in dicts { dts = map.insert(dts, d.key, d) }
  Ok((ESt { ..st, cache: LowerCache { fns: tbl, dicts: dts, next_lam: next } }, cf))
}

## The subject half of that identity: its *head*, because an impl method's
## `impl_of` names the declared subject (`List[T]`) while a `CImpl` node names
## the instantiated one (`List[Int]`). `ty_key` drops the arguments of an ADT
## but not of a builtin container, so it cannot be the key on its own.
fn subject_key(t: Ty) -> String =
  match t {
    TyList(_) -> "List"
    TyMap(_, _) -> "Map"
    TySet(_) -> "Set"
    TyArray(_) -> "Array"
    TyTuple(es) -> "Tup" ++ to_string(len(es))
    _ -> ty_key(t)
  }

## A TFun belongs in the spelling-keyed direct-call tables exactly when Core
## may name it as CDirect. Impl methods and trait defaults are legal name
## collisions; their identities live in `impl_fns` instead.
fn is_direct_fn(f: TFun) -> Bool = f.impl_of == None && f.default_of == None

## Add one direct function to a spelling-keyed table. The std loader and the
## module evaluator share this door so neither can silently reintroduce
## last-wins collisions with impl/default bodies.
pub fn note_direct_fn(tbl: Map[String, TFun], f: TFun) -> Map[String, TFun] =
  if is_direct_fn(f) { map.insert(tbl, f.name, f) } else { tbl }

## Record one function under the identity a `CImpl` or `CDefault` node names,
## if it is one. Shared by std's loader and the module being folded so the two
## tables are built by the same rule.
pub fn note_trait_fn(
  tbl: Map[(Int, String, String), (String, TFun)],
  owner: String,
  f: TFun
) -> Map[(Int, String, String), (String, TFun)] =
  match f.impl_of {
    Some(w) -> {
      let (tid, subject) = w
      map.insert(tbl, (tid, subject_key(subject), f.name), (owner, f))
    }
    None ->
      match f.default_of {
        Some(tid) -> map.insert(tbl, (tid, "\$default", f.name), (owner, f))
        None -> tbl
      }
  }

## Where a lowered body is cached. An impl method shares its name with the
## trait method it implements, and a module may hold several, so the key has to
## carry the impl's own identity rather than just the name.
fn cache_key(owner: String, f: TFun) -> String =
  match f.impl_of {
    Some(w) -> {
      let (tid, subject) = w
      owner ++ ".impl$" ++ to_string(tid) ++ "$" ++ ty_key(subject) ++ "$" ++ f.name
    }
    None ->
      match f.default_of {
        Some(tid) -> owner ++ ".default$" ++ to_string(tid) ++ "$" ++ f.name
        None -> owner ++ "." ++ f.name
      }
  }

## The lowered body of an impl method (or a trait default), found by the
## identity Core names it with rather than by its bare name.
fn get_trait_cfun(
  icx: ICx,
  st: ESt,
  env: Env,
  tid: Int,
  subject_key: String,
  method: String
) -> Result[(ESt, CFun), (ESt, Env, Ctl)] !io =
  match map.get(icx.impl_fns, (tid, subject_key, method)) {
    Some(pair) -> {
      let (owner, f) = pair
      match map.get(st.cache.fns, cache_key(owner, f)) {
        Some(cf) -> Ok((st, cf))
        None -> lower_into(icx, st, env, owner, f)
      }
    }
    None ->
      match cerr(st, env, "missing impl method `" ++ method ++ "`") {
        Err(t) -> Err(t)
        Ok(_) -> panic("unreachable")
      }
  }

## The checker's resolution order, as the interpreter sees it: the named owner
## first, then the flat table (module fns over std fns).
fn find_fn(icx: ICx, owner: String, name: String) -> Option[(String, TFun)] = {
  match map.get(icx.by_owner, owner) {
    Some(tbl) ->
      match map.get(tbl, name) {
        Some(f) -> return Some((owner, f))
        None -> ()
      }
    None -> ()
  }
  match map.get(icx.fns, name) {
    Some(f) -> {
      let o =
        match map.get(icx.owner_of, name) {
          Some(x) -> x
          None -> icx.owner
        }
      Some((o, f))
    }
    None -> None
  }
}

## The lowered body behind (owner, name). A lifted lambda only ever lives in
## the cache: it has no TFun to lower from, because it was never in the source.
fn get_cfun(
  icx: ICx,
  st: ESt,
  env: Env,
  owner: String,
  name: String
) -> Result[(ESt, CFun), (ESt, Env, Ctl)] !io = {
  match map.get(st.cache.fns, owner ++ "." ++ name) {
    Some(cf) -> return Ok((st, cf))
    None -> ()
  }
  match find_fn(icx, owner, name) {
    Some(pair) -> {
      let (o, f) = pair
      match map.get(st.cache.fns, cache_key(o, f)) {
        Some(cf) -> Ok((st, cf))
        None -> lower_into(icx, st, env, o, f)
      }
    }
    None ->
      match cerr(st, env, "missing function `" ++ name ++ "`") {
        Err(t) -> Err(t)
        Ok(_) -> panic("unreachable")
      }
  }
}

# ---- calls ----

fn call_cfun(
  icx: ICx,
  st: ESt,
  env: Env,
  cf: CFun,
  frame: CtFrame,
  caps: Map[Int, CValue],
  args: List[CValue]
) -> ER !io = {
  if st.depth + 1 > MAX_CALL_DEPTH {
    return framed(
      cerrh(st, env, "call depth limit (" ++ to_string(MAX_CALL_DEPTH) ++ ") exceeded",
        "deep recursion does not fit comptime; use a loop or fold"),
      frame)
  }
  var fenv = caps
  var i = 0
  for p in cf.params {
    fenv = map.insert(fenv, p.sym, args[i])
    i = i + 1
  }
  # a generic function's dictionaries arrive in the trailing slots; binding
  # them keeps the frame consistent even though nothing reads them
  for d in cf.dicts {
    if i < len(args) { fenv = map.insert(fenv, d.sym, args[i]) }
    i = i + 1
  }
  # Evidence rides in the slots behind them, and the binding is positional, so
  # it needs no rule of its own: a named function's slots are one per atom of
  # its ABI row, a function value's is one pack, and both are just arguments
  # here. Comptime still refuses declared effects, so what arrives is always a
  # placeholder or an empty pack -- the pack can get here, and a query cannot,
  # which is the whole of the representation knife's reach into comptime.
  for e in cf.evs {
    if i < len(args) { fenv = map.insert(fenv, e.sym, args[i]) }
    i = i + 1
  }
  match ceval(icx, ESt { ..st, depth: st.depth + 1 }, fenv, cf.body) {
    Ok(t) -> {
      let (st1, _, v) = t
      Ok((ESt { ..st1, depth: st1.depth - 1 }, env, v))
    }
    Err(t) -> {
      let (st1, _, ctl) = t
      match ctl {
        KReturn(v) -> Ok((ESt { ..st1, depth: st1.depth - 1 }, env, v))
        _ -> Err(frame_error((ESt { ..st1, depth: st1.depth - 1 }, env, ctl), frame))
      }
    }
  }
}

## A trait default body, which is keyed by its trait rather than a subject.
fn call_default(
  icx: ICx,
  st: ESt,
  env: Env,
  owner: String,
  tid: Int,
  method: String,
  args: List[CValue]
) -> ER !io = {
  let frame = FDefault(owner, trait_frame_name(icx, tid), tid, method)
  match get_trait_cfun(icx, st, env, tid, "\$default", method) {
    Err(err) -> Err(frame_error(err, frame))
    Ok(pair) -> {
      let (st1, cf) = pair
      let no_caps: Map[Int, CValue] = map.empty()
      call_cfun(icx, st1, env, cf, frame, no_caps, args)
    }
  }
}

fn apply_fn(icx: ICx, st: ESt, env: Env, f: CValue, args: List[CValue]) -> ER !io =
  match f {
    VClosure(owner, name, caps) -> {
      let frame = FDynamic(owner, name)
      match get_cfun(icx, st, env, owner, name) {
        Err(err) -> Err(frame_error(err, frame))
        Ok(pair) -> {
          let (st1, cf) = pair
          call_cfun(icx, st1, env, cf, frame, caps, args)
        }
      }
    }
    _ -> cerr(st, env, "cannot call a non-function value")
  }

## A direct call by name. A function with dictionary parameters is one the
## call site passed witnesses to; `call_cfun` binds them into the frame like
## any other argument.
fn call_named(
  icx: ICx,
  st: ESt,
  env: Env,
  owner: String,
  name: String,
  args: List[CValue]
) -> ER !io = {
  let frame = FDirect(owner, name)
  if owner == "std/hamt" {
    return framed(cerr(st, env, "Map and Set operations are not available at comptime"), frame)
  }
  match get_cfun(icx, st, env, owner, name) {
    Err(err) -> Err(frame_error(err, frame))
    Ok(pair) -> {
      let (st1, cf) = pair
      let no_caps: Map[Int, CValue] = map.empty()
      call_cfun(icx, st1, env, cf, frame, no_caps, args)
    }
  }
}

# ---- intrinsics (the pure ones; io never reaches the interpreter) ----
#
# This chain is the third dispatcher over intrinsic names, and until
# 2026-07-30 it was the only one that answered out of its own head: emit and
# emitc both look the name up in `types.intrinsics()`, so a primitive added
# there reaches them, while one added here reached nothing and no test said so.
# Both directions had drifted -- three arms below had no producer left, and
# `str_of_bytes` had to be added by hand when RP-02 introduced it (audit RP-12).
#
# The two lists below close that. Together they partition
# `types.intrinsics()` + `lower.internal_intrinsics()`: every intrinsic in the
# program is either interpreted here or deliberately refused, the gate test at
# the bottom of this file checks the partition is total and disjoint, and it
# probes each name to check the lists say what the chain does.

## Every name the chain below has an arm for -- 43 of them, 12 emitted by
## lowering and 31 writable by a user.
##
## Consulted *before* the chain rather than alongside it, so this is a gate and
## not a second copy: a name missing from here can never reach an arm, which
## makes an undeclared arm dead by construction instead of invisible. Omitting
## a name that should be here is caught rather than silent -- if the name is an
## intrinsic the partition check goes red, and if it is not, the arm was
## already unreachable from lowering.
fn interp_arms() -> List[String] = [
  # lowering's own intrinsics (lower.internal_intrinsics()); `cmp`, `hash` and
  # `java_hash` are the three it emits that are refused instead, below
  "java_eq", "show", "quote", "str_of_int", "str_of_bool",
  "str_of_bytes", "list_index", "list_slice", "list_push", "null_ref", "ev_get", "ev_append",
  # user builtins
  "panic", "todo", "expect", "unwrap_or", "to_float", "to_int", "to_string",
  "len", "get", "range", "sort_by", "join",
  "cursor_start", "cursor_end", "cursor_done", "cursor_char", "cursor_next",
  "cursor_prev", "cursor_slice",
  "code_points", "from_code_points",
  "char_is_letter", "char_is_digit", "char_is_alnum", "char_is_upper",
  "char_is_lower", "char_is_space",
  "str_lower", "str_upper", "parse_int", "parse_float"
]

## Every intrinsic a comptime run refuses, and why it is a group rather than an
## oversight.
##
## Read it as the real answer to "what can a `const` do". Spec §7.2.2 answers
## in prose, and the prose is short by an order of magnitude: it names Map and
## Set, which is 18 of the 74 names below (audit RP-11). The list is measured
## here -- the gate test calls each one and checks it really is refused -- and
## rewriting the spec against it is a separate job.
fn comptime_rejects() -> List[String] = {
  # `cmp`/`hash` are the prelude relation collapsed at a scalar and `java_hash`
  # is the host's; a const that needs an ordering says so as a trait call,
  # which comptime refuses one level up
  var out = ["cmp", "hash", "java_hash"]
  # `CValue` has no `VBytes`: comptime cannot hold a Bytes at all, so the
  # seven byte primitives have nothing to operate on
  for op in ["utf8", "decode_utf8", "decode_latin1", "len", "at", "slice",
    "from_array"] {
    out = out ++ ["bytes_" ++ op]
  }
  # io is the point: a compile must not read files or spawn processes because
  # a source file said so. `args` is the same rule at the process boundary.
  for op in ["print", "println", "eprint", "eprintln", "read_line", "is_dir", "read_file",
    "write_file", "exit", "exists", "mkdirs", "cwd", "getenv", "read_bytes", "write_bytes",
    "delete", "rename", "temp_dir", "temp_file", "copy_permissions", "is_symlink", "read_stdin",
    "stdin_ready", "list_names", "run"] {
    out = out ++ ["io_" ++ op]
  }
  # The two barriers are refused for a reason of their own, and it is not the
  # row they raise -- `catch_fault` raises none since 2026-09-01
  # (docs/audit/error-model-design.md §7.5), so "they take an `!io` thunk they
  # would have to run" stopped being the answer. What they would fold is a
  # `ForeignError`, and its fields belong to the build rather than to the
  # program: `kind` is declared backend-dependent
  # (`java.lang.NumberFormatException` on the JVM, `"fault"` on native --
  # runtime-intrinsics-design.md §12.4), and `catch_panic`'s `message` is too,
  # on top of being a function of the source text an `assert` was written with.
  # Folding either into a constant bakes the compiler that ran into the
  # artifact it produced.
  #
  # `bracket` needs a ground of its own, being effect-polymorphic and catching
  # nothing: a `const` cannot hold a resource, so there is nothing here to
  # protect and nothing for a release to give up, and folding it would be
  # inventing the answer rather than computing it.
  out = out ++ ["args", "catch_fault", "catch_panic", "bracket"]
  # The retained reactor root is process/module state. A comptime evaluation
  # has neither a reactor instance nor a turn boundary in which one could live.
  out = out ++ ["reactor_state_has", "reactor_state_get", "reactor_state_set"]
  # `cast` unerases a host object, and comptime never has one. Its failure
  # being a value rather than a throw (the error model's step B) did not change
  # that: there is still no host object to reclaim, and an `Err` here would be
  # a fabricated answer rather than a fold.
  out = out ++ ["cast"]
  # `char_unchecked` never gets here at all: lowering rewrites the call to its
  # argument (lower.lowered_intrinsics), because `Char`'s representation is
  # `Int`. It is listed as refused rather than given an arm for the reason
  # check 2 below exists -- an arm no producer can reach is the dead code that
  # rotted in this table before.
  out = out ++ ["char_unchecked"]
  # Map/Set/Array: `CValue` has no representation for any of the three, so
  # `const M = map.from([...])` does not fold. This is the group spec §7.2.2
  # names, and it is the smaller half of what is actually refused.
  for op in ["empty", "from", "insert", "remove", "get", "has", "size", "keys", "values",
    "entries", "fold"] {
    out = out ++ ["map_" ++ op]
  }
  for op in ["empty", "from", "insert", "remove", "has", "size", "to_list"] {
    out = out ++ ["set_" ++ op]
  }
  for op in ["new", "len", "get", "push", "with", "steal"] { out = out ++ ["array_" ++ op] }
  # a bitmap operation on the array representation, so it is refused with it
  out = out ++ ["popcount"]
  # the handler-local slot. Unreachable rather than unimplemented: a cell is
  # made where a handler is installed, and `with handle` is refused one level
  # up (checker.dawn's comptime gate), so nothing a `const` can contain
  # produces one. Listed rather than given arms because an arm no producer can
  # reach is the dead code check 2 below exists for -- and because `CValue` is
  # immutable, so an implementation would have to invent a store the rest of
  # this interpreter has no notion of.
  out = out ++ ["cell_new", "cell_get", "cell_set", "cell_take"]
  # one-shot resumption, refused for the same reason and one more. Unreachable:
  # a control arm exists only under a `with handle`, which is refused one level
  # up, so no `const` initialiser produces either name. And unimplemented
  # everywhere else too -- `lower.staged_intrinsics` refuses both on the way to
  # a backend -- so an arm here would be the only implementation of a feature
  # that does not run yet, in the one evaluator that cannot reach it.
  #
  # Before either name is ever admitted here, the continuation's effect
  # account has to be answered first, not after. comptime may call any pure
  # function (spec §7), and a continuation is an ordinary function value; the
  # only thing that keeps a pure `k` from smuggling a remainder's io into a
  # fold is that `k` carries the remainder's io bit (`types.cont_row`, spec
  # §6.5 "control arms"), which is a checker rule this evaluator inherits
  # rather than enforces. Admitting `ctl_*` here without re-reading that rule
  # against whatever the fold can then construct would reopen the hole spec
  # §9.8.1 used to record as an exception. Today the isolation is doubly
  # structural (no `with handle`, no `ctl_*`), which is why nothing here has
  # had to reason about it.
  out = out ++ ["ctl_yield", "ctl_run"]
  # `discard` is the user-facing third of that family and is refused for the
  # first of those reasons alone: its argument is a continuation, a `const`
  # initialiser cannot produce one, and a value that is not a continuation is
  # a run-time panic rather than a fold.
  out = out ++ ["discard"]
  # no arm, and no reason beyond that: `parse_int` folds and this one does not.
  # Left refused rather than quietly added, because a new arm is a new answer
  # the two backends then have to agree with.
  out = out ++ ["parse_int_radix"]
  out
}

fn has_name(xs: List[String], n: String) -> Bool = {
  for x in xs {
    if x == n { return true }
  }
  false
}

## The refusal a name with no arm gets. One function because the gate test
## recognises the refusal by its text, and a message that drifted from the
## test would make every probe read as "interpreted".
fn no_arm_msg(name: String) -> String =
  "builtin `" ++ name ++ "` is not available at comptime"

const NO_ARM_LISTED: String = "listed in interp_arms but has no arm: "

## The evidence-pack walk, on the interpreter's own values: the third
## implementation of `ev_get`, alongside the JVM's `INSTANCEOF` loop and
## `dawn_ev_get`. Its contract is written at `types.ev_pack_adt`.
##
## The shape test the other two get from the runtime is a `match` here, which
## is why this one is a plain function and testable: a `VAdt` at `EV_PACK_ID`
## is a node and everything else ends the walk. The three terminators the
## contract names all arrive as "not a `VAdt` at that id" -- the placeholder
## boxes to `VUnit`, a null pack cannot be constructed at all, and any other
## erased value is some other `CValue`.
##
## A miss panics rather than answering the placeholder, and panics *this
## compiler* rather than raising a comptime diagnostic: a pack without a key
## its own reader named is lowering's bug, not the interpreted program's, and
## `lower.impl_ev_sources` treats the same class of break the same way.
fn ev_get_value(pack: CValue, key: Int) -> CValue =
  match pack {
    VAdt(aid, _, fields) ->
      if aid != EV_PACK_ID {
        panic(EV_MISS_MSG)
      } else {
        match fields[0] {
          VInt(k) -> if k == key { fields[1] } else { ev_get_value(fields[2], key) }
          _ -> panic("comptime interpreter bug: an evidence pack's key is not an Int")
        }
      }
    _ -> panic(EV_MISS_MSG)
  }

## One pack node, in the shape `lower.ev_build` conses them.
fn ev_node(key: Int, ev: CValue, outer: CValue) -> CValue =
  VAdt(EV_PACK_ID, 0, [VInt(key), ev, outer])

## The evidence-pack join, on the interpreter's own values: the third
## implementation of `ev_append`, alongside the JVM's emitted static and
## `dawn_ev_append`. Its contract is written at `types.ev_pack_adt`.
##
## Recursion is the whole of it here, and the shape it recurses on is the same
## one `ev_get_value` walks: a `VAdt` at `EV_PACK_ID` is a node, anything else
## is where `front` stopped -- and where `front` stopped is where `back` goes.
## `front`'s own terminator is *dropped*, not copied, which is what makes the
## result one flat chain rather than a chain that ends in another chain.
##
## No panic. A miss is a broken invariant, but a `front` with nothing in it is
## an ordinary answer: a row whose first non-ground atom instantiated to pure
## carries the placeholder, and appending it must give `back` back.
fn ev_append_value(front: CValue, back: CValue) -> CValue =
  match front {
    VAdt(aid, _, fields) ->
      if aid != EV_PACK_ID {
        back
      } else {
        VAdt(EV_PACK_ID, 0, [fields[0], fields[1], ev_append_value(fields[2], back)])
      }
    _ -> back
  }

## Did the walk end in the contract's panic? `catch_panic` because that is
## what a panic is here, and the message because "some panic" would pass for
## an index-out-of-range just as well.
fn ev_get_panics(pack: CValue, key: Int) -> Bool !io =
  match catch_panic(() => ev_get_value(pack, key)) {
    Ok(_) -> false
    Err(e) -> str.contains(e.message, EV_MISS_MSG)
  }

# Nothing in a compiled program calls `ev_get` yet -- lowering emits no read
# until the knife that flips the semantics -- so these two tests are the whole
# oracle for the walk. They are written against the interpreter's copy because
# it is the one of the three that is a function rather than instructions; the
# other two are held to the same shape by scripts/intrinsic-parity.py and, for
# the C one, by emitc's test that the runtime declares what the emitter calls.

test "an evidence pack answers by key, not by position" {
  let empty: CValue = VUnit
  let one = ev_node(7, VInt(700), empty)
  let two = ev_node(4, VInt(400), one)
  let three = ev_node(1, VInt(100), two)
  # the node the walk starts on
  assert as_int(ev_get_value(three, 1)) == 100
  # and the ones it only reaches by following `outer`. Compare the keys or the
  # first node answers for every one of them; follow `outer` or the walk stops
  # at the first node and these are misses
  assert as_int(ev_get_value(three, 4)) == 400
  assert as_int(ev_get_value(three, 7)) == 700
  # a node answers the same whatever is consed in front of it: the pack is a
  # scope, and a node nobody asked for costs a step and nothing else
  assert as_int(ev_get_value(one, 7)) == 700
}

test "an evidence pack ends on the placeholder, and a miss is a panic" {
  let empty: CValue = VUnit
  let one = ev_node(7, VInt(700), empty)
  # the placeholder ends the walk rather than being read as a node -- the
  # whole reason the terminator test belongs to the runtime -- and the end of
  # a walk is the panic, never the placeholder handed back as evidence
  assert ev_get_panics(one, 8)
  # a bare placeholder is the empty pack: nothing to walk, same answer
  assert ev_get_panics(empty, 7)
  # any other erased value terminates too. This is the case native cannot
  # answer without the header's `kind` byte, and the one `CIsCtor` would have
  # read a tag off
  assert ev_get_panics(VStr("not a pack"), 7)
  # NULL is the fourth thing that ends a walk, and it has no CValue at all --
  # it comes from the hand-written shims, so `dawn_ev_get`'s own `p != NULL`
  # is the only place it is answered and nothing here reaches it.
}

test "an appended pack answers from both halves, and answers front's first" {
  let empty: CValue = VUnit
  # two chains that answer nothing of each other's: the shape a row with two
  # non-ground atoms hands one slot
  let front = ev_node(1, VInt(100), ev_node(4, VInt(400), empty))
  let back = ev_node(7, VInt(700), empty)
  let both = ev_append_value(front, back)
  # every key of front, in front's own order, then every key of back. Copy
  # only front and the last two are misses; return `back` alone and the first
  # two are
  assert as_int(ev_get_value(both, 1)) == 100
  assert as_int(ev_get_value(both, 4)) == 400
  assert as_int(ev_get_value(both, 7)) == 700
  # the join is a rebuild, so neither argument learned anything: front still
  # ends where it ended, and back is still just itself
  assert ev_get_panics(front, 7)
  assert ev_get_panics(back, 1)

  # front before back, stated as a lookup. Distinct atoms cannot collide, so
  # this same-key probe is the one place the order is observable -- and the
  # order is defined (types.ev_pack_adt), so it is pinned rather than left to
  # whichever half the rebuild happened to put first
  let a = ev_node(9, VInt(1), empty)
  let b = ev_node(9, VInt(2), empty)
  assert as_int(ev_get_value(ev_append_value(a, b), 9)) == 1
  assert as_int(ev_get_value(ev_append_value(b, a), 9)) == 2
}

test "appending an empty pack changes nothing on either side" {
  let empty: CValue = VUnit
  let back = ev_node(7, VInt(700), empty)
  # an empty front is the identity: a row whose non-ground atom instantiated
  # to pure brings the placeholder, and it must not cost `back` a key. Not a
  # panic either -- `ev_append` has no miss to have, only `ev_get` does
  assert value_eq(ev_append_value(empty, back), back)
  # and an empty back leaves a chain that ends on the placeholder, which is to
  # say a walk of it terminates rather than running off anything
  let front = ev_node(1, VInt(100), empty)
  let onto_empty = ev_append_value(front, empty)
  assert as_int(ev_get_value(onto_empty, 1)) == 100
  assert ev_get_panics(onto_empty, 7)
  # front's own terminator is dropped rather than copied, so two placeholders
  # never meet: the chain is flat, and `ev_get` stays one walk
  assert value_eq(onto_empty, front)
}

fn call_builtin(icx: ICx, st: ESt, env: Env, name: String, args: List[CValue]) -> ER !io =
  if not has_name(interp_arms(), name) {
    cerr(st, env, no_arm_msg(name))
  } else if name == "java_eq" {
    # equality of a host value (semantics-closure-design.md 3). Comptime never
    # reaches a real Java object -- `use java` is not foldable -- so this is
    # the interpreter's own value equality, kept so the arm is not a hole.
    Ok((st, env, VBool(value_eq(args[0], args[1]))))
  } else if name == "ev_get" {
    # An arm rather than a refusal, so that a `const` whose body reaches a
    # function value keeps folding once lowering starts emitting reads.
    # Comptime still refuses declared effects, so the packs that get here are
    # the ones lowering builds for a pure row -- which is why the terminator
    # matters more here than a hit does.
    Ok((st, env, ev_get_value(args[0], as_int(args[1]))))
  } else if name == "ev_append" {
    # the join, for the same reason the lookup has an arm: a `const` whose
    # body reaches a function value with two rows in one slot folds here, and
    # a refusal would make that fold a diagnostic instead of an answer.
    Ok((st, env, ev_append_value(args[0], args[1])))
  } else if name == "panic" {
    cerr(st, env, "panicked: " ++ as_str(args[0]))
  } else if name == "todo" {
    cerr(st, env, "panicked: not yet implemented")
  } else if name == "expect" {
    let (aid, ci, fields) = as_adt(args[0])
    if adt_of(icx.adts, aid).ctors[ci].name == "Some" {
      Ok((st, env, fields[0]))
    } else {
      cerr(st, env, "panicked: " ++ as_str(args[1]))
    }
  } else if name == "unwrap_or" {
    let (aid, ci, fields) = as_adt(args[0])
    if adt_of(icx.adts, aid).ctors[ci].name == "Some" {
      Ok((st, env, fields[0]))
    } else {
      Ok((st, env, args[1]))
    }
  } else if name == "to_float" {
    Ok((st, env, VFloat(to_float(as_int(args[0])))))
  } else if name == "to_int" {
    let f = match args[0] {
      VFloat(x) -> x
      _ -> panic("comptime interpreter bug: to_int expects Float")
    }
    Ok((st, env, VInt(to_int(f))))
    # str_of_* is what interpolation lowers to; to_string is the surface
    # builtin. These are the *top-level* rendering, where a String is itself
    # and not a quoted literal.
  } else if name == "to_string" || name == "str_of_int" || name == "str_of_bool" {
    Ok((st, env, VStr(stringify(args[0]))))
  } else if name == "show" {
    match show_value(args[0]) {
      Some(s) -> Ok((st, env, VStr(s)))
      None -> cerr(st, env, "`show` cannot render this value at comptime")
    }
  } else if name == "str_of_bytes" {
    # There is no `VBytes`: comptime has no Bytes values at all, so nothing
    # can reach this. Refusing by name beats falling through to the generic
    # "not available at comptime", which would read as a missing feature
    # rather than as a value the interpreter cannot hold.
    cerr(st, env, "a Bytes cannot be rendered at comptime")
    # the nested rendering of a String, which a synthesised `show` body reaches
    # for every String field
  } else if name == "quote" {
    Ok((st, env, VStr(quote_str(as_str(args[0])))))
  } else if name == "len" {
    Ok((st, env, VInt(len(as_list(args[0])))))
  } else if name == "get" {
    let xs = as_list(args[0])
    let i = as_int(args[1])
    if i >= 0 && i < len(xs) {
      Ok((st, env, some_v(xs[i])))
    } else {
      Ok((st, env, none_v()))
    }
    # `xs[i]`, and the element read that `for x in xs` lowers to
  } else if name == "list_index" {
    let xs = as_list(args[0])
    let i = as_int(args[1])
    if i < 0 || i >= len(xs) {
      cerr(st, env, "index " ++ to_string(i) ++ " out of bounds for length " ++
          to_string(len(xs)))
    } else {
      Ok((st, env, xs[i]))
    }
    # `xs ++ [x]`, rewritten from a one-element concat (lower.cat_list)
  } else if name == "list_push" {
    Ok((st, env, VList(as_list(args[0]) ++ [args[1]])))
    # the `..rest` of a list pattern
  } else if name == "list_slice" {
    let xs = as_list(args[0])
    let from = as_int(args[1])
    let to = as_int(args[2])
    Ok((st, env, VList(list.take(list.drop(xs, from), to - from))))
    # the placeholder a match or if result slot is declared with; every path
    # assigns before reading, so its value is never observed
  } else if name == "null_ref" {
    Ok((st, env, VUnit))
  } else if name == "range" {
    let from = as_int(args[0])
    let to = as_int(args[1])
    let (st1, _, _) = burn_n(st, env, to - from)?
    var out: List[CValue] = []
    var i = from
    while i < to {
      out = out ++ [VInt(i)]
      i = i + 1
    }
    Ok((st1, env, VList(out)))
  } else if name == "sort_by" {
    let (st1, sorted) = merge_sort(icx, st, env, as_list(args[0]), args[1])?
    Ok((st1, env, VList(sorted)))
  } else if name == "join" {
    var parts: List[String] = []
    for x in as_list(args[0]) { parts = parts ++ [as_str(x)] }
    Ok((st, env, VStr(join(parts, as_str(args[1])))))
    # ---- the cursor family ----
    #
    # A position is opaque, so nothing outside std/cursor can see the number
    # and no `const` can hold one -- the type is not nameable outside its
    # module, and a constant must declare its type. That leaves the
    # interpreter free to pick its own currency, and it picks the one that
    # needs no host: a *code-point index*, where the JVM backend uses a UTF-16
    # offset and the C runtime a byte offset. The seven only have to agree with
    # each other.
    #
    # They reached the emitted `dawn.rt.Strings` by reflection until 2026-07-28,
    # which is a route a native compiler does not have and which answered with
    # whatever the *seed* release emitted rather than what this compiler does
    # (docs/native-backend-plan.md 14.11, 14.13).
    #
    # `code_points` per character makes a walk quadratic. Comptime strings are
    # constants and the fuel counter bounds the loop, so this buys correctness
    # at a cost nothing here can feel.
  } else if name == "cursor_start" {
    Ok((st, env, VInt(0)))
  } else if name == "cursor_end" {
    Ok((st, env, VInt(str.len(as_str(args[0])))))
  } else if name == "cursor_done" {
    Ok((st, env, VBool(as_int(args[1]) >= str.len(as_str(args[0])))))
  } else if name == "cursor_char" {
    let s = as_str(args[0])
    let c = as_int(args[1])
    if c < 0 || c >= str.len(s) {
      Ok((st, env, VInt(-1)))
    } else {
      Ok((st, env, VInt(char.code(get(code_points(s), c).expect("in range")))))
    }
  } else if name == "cursor_next" {
    let n = str.len(as_str(args[0]))
    let c = as_int(args[1])
    Ok((st, env, VInt(if c < 0 { 0 } else if c >= n { n } else { c + 1 })))
  } else if name == "cursor_prev" {
    let n = str.len(as_str(args[0]))
    let c = as_int(args[1])
    Ok((st, env, VInt(if c <= 0 { 0 } else if c > n { n - 1 } else { c - 1 })))
  } else if name == "cursor_slice" {
    let s = as_str(args[0])
    let from = as_int(args[1])
    let to = as_int(args[2])
    if from < 0 || to > str.len(s) || from > to {
      cerr(st, env, "panicked: cursor_slice: invalid cursor range")
    } else {
      Ok((st, env, VStr(str.slice(s, from, to))))
    }
    # case folding is a Unicode table rather than a walk, so it stays a backend
    # primitive -- but calling it is not reflecting into one: this is the same
    # intrinsic every other module writes, compiled for whichever host the
    # compiler itself runs on.
    # code_points/from_code_points and the Unicode classifiers. These had no
    # arm at all until 2026-07-28: nothing reached them, because `substring`
    # and `trim` were intrinsics, so `const X = str.slice(...)` had never
    # been written down anywhere that would run it. Moving std off the
    # intrinsics is what asked the question.
  } else if name == "code_points" {
    var out: List[CValue] = []
    for cp in code_points(as_str(args[0])) { out = out ++ [VInt(char.code(cp))] }
    Ok((st, env, VList(out)))
  } else if name == "from_code_points" {
    var cps: List[Char] = []
    for v in as_list(args[0]) { cps = cps ++ [as_char(v)] }
    Ok((st, env, VStr(from_code_points(cps))))
  } else if name == "char_is_letter" {
    Ok((st, env, VBool(char_is_letter(as_char(args[0])))))
  } else if name == "char_is_digit" {
    Ok((st, env, VBool(char_is_digit(as_char(args[0])))))
  } else if name == "char_is_alnum" {
    Ok((st, env, VBool(char_is_alnum(as_char(args[0])))))
  } else if name == "char_is_upper" {
    Ok((st, env, VBool(char_is_upper(as_char(args[0])))))
  } else if name == "char_is_lower" {
    Ok((st, env, VBool(char_is_lower(as_char(args[0])))))
  } else if name == "char_is_space" {
    Ok((st, env, VBool(char_is_space(as_char(args[0])))))
  } else if name == "str_lower" {
    Ok((st, env, VStr(str.to_lower(as_str(args[0])))))
  } else if name == "str_upper" {
    Ok((st, env, VStr(str.to_upper(as_str(args[0])))))
  } else if name == "parse_int" {
    # The builtin spelling, which lowering routes to std/fmt.atoi -- so this
    # arm interprets the program's own std Core rather than a host grammar
    # (audit RP-05; same bootstrap rule as `stringify`'s Float arm). It said
    # `fmt.atoi` until v0.55.0, back when the builtin still had a host
    # primitive behind it in the seed; since RP-05 there is one route and the
    # two spellings emit the same call, and `atoi` is no longer pub.
    match parse_int(as_str(args[0])) {
      Some(n) -> Ok((st, env, some_v(VInt(n))))
      None -> Ok((st, env, none_v()))
    }
  } else if name == "parse_float" {
    match parse_float(as_str(args[0])) {
      Some(f) -> Ok((st, env, some_v(VFloat(f))))
      None -> Ok((st, env, none_v()))
    }
  } else {
    # unreachable while the gate test is green: the guard at the top let this
    # name through, so `interp_arms()` claims an arm the chain does not have
    panic(NO_ARM_LISTED ++ name)
  }

## Stable merge sort with the interpreted comparator (Kotlin sortedWith).
fn merge_sort(
  icx: ICx,
  st: ESt,
  env: Env,
  xs: List[CValue],
  f: CValue
) -> Result[(ESt, List[CValue]), (ESt, Env, Ctl)] !io = {
  if len(xs) <= 1 { return Ok((st, xs)) }
  let mid = len(xs) / 2
  let (st1, left) = merge_sort(icx, st, env, list.take(xs, mid), f)?
  let (st2, right) = merge_sort(icx, st1, env, list.drop(xs, mid), f)?
  var out: List[CValue] = []
  var i = 0
  var j = 0
  var st3 = st2
  while i < len(left) && j < len(right) {
    let (st4, _, cv) = apply_fn(icx, st3, env, f, [left[i], right[j]])?
    st3 = st4
    if as_int(cv) <= 0 {
      out = out ++ [left[i]]
      i = i + 1
    } else {
      out = out ++ [right[j]]
      j = j + 1
    }
  }
  while i < len(left) {
    out = out ++ [left[i]]
    i = i + 1
  }
  while j < len(right) {
    out = out ++ [right[j]]
    j = j + 1
  }
  Ok((st3, out))
}

# ---- route C: fold a vouched Java call ----

## The class's simple name, for diagnostics. A string split, not reflection:
## the messages this feeds must not be a reason to import `jreflect` here.
fn simple_of(fqcn: String) -> String = {
  let parts = str.split(fqcn, ".")
  parts[len(parts) - 1]
}

## Route C (docs/pure-ffi-design.md): only static methods, only across the
## scalar/String boundary. The policy checks live here; the marshalling and
## the reflective invoke live behind `icx.jcall` (see CtOpts) -- `jfold` on a
## JVM host, a refusal otherwise.
##
## There is no `unsafe_pure` check here any more, because Core drops the
## marker -- lowering treats the block as transparent. The effect system is
## the enforcement: without an `unsafe_pure` the call is `!io`, and an `!io`
## expression cannot reach a const or a comptime block in the first place.
##
## That enforcement answers "is this call pure?". It does not answer "may the
## compiler run it?", and `icx.ffi` is what does: reaching this function means
## invoking a JDK method in the compiler's own process, so it is a capability
## the person running the compiler grants, never one the source being compiled
## grants itself. The three limits below (static only, scalar boundary only)
## are real but they are not a sandbox -- `System.load(String)` is a static
## method taking a String and returning void.
fn eval_java(icx: ICx, st: ESt, env: Env, j: CJava) -> ER !io = {
  let jc = j.call
  let simple = simple_of(jc.fqcn)
  if not icx.ffi {
    return cerrh(st, env, "compile-time Java calls are disabled",
      "folding this would invoke `" ++ simple ++ "." ++
        jc.method ++ "` inside the compiler; pass --comptime-ffi to allow it, or " ++
        "make this a runtime call instead of a const")
  }
  if jc.is_ctor {
    return cerr(st, env, "Java constructors are not available at compile time")
  }
  if jc.is_field {
    return cerr(st, env, "Java static fields are not available at compile time")
  }
  if not jc.is_static {
    return cerrh(st, env, "only static Java methods can be folded",
      "`" ++ simple ++ "." ++ jc.method ++ "` needs a receiver, and comptime " ++
        "has no way to build a Java object")
  }
  var st1 = st
  var env1 = env
  var vals: List[CValue] = []
  for a in j.args {
    let (st2, env2, v) = ceval(icx, st1, env1, a)?
    st1 = st2
    env1 = env2
    vals = vals ++ [v]
  }
  # a Java call is opaque to the fuel counter, so charge a flat cost
  let (st3, env3, _) = burn_n(st1, env1, 100)?
  match icx.jcall(jc, vals) {
    Ok(v) -> Ok((st3, env3, v))
    Err((m, h)) -> cerrh(st3, env3, m, h)
  }
}

# ---- the evaluator ----

fn eval_all(
  icx: ICx,
  st: ESt,
  env: Env,
  es: List[CExpr]
) -> Result[(ESt, Env, List[CValue]), (ESt, Env, Ctl)] !io = {
  var st1 = st
  var env1 = env
  var vals: List[CValue] = []
  for e in es {
    let (st2, env2, v) = ceval(icx, st1, env1, e)?
    st1 = st2
    env1 = env2
    vals = vals ++ [v]
  }
  Ok((st1, env1, vals))
}

fn ceval(icx: ICx, st0: ESt, env0: Env, e: CExpr) -> ER !io = {
  let (st, env, _) = burn(st0, env0)?
  match e {
    CInt(v) -> Ok((st, env, VInt(v)))
    CFloat(v) -> Ok((st, env, VFloat(v)))
    CBool(v) -> Ok((st, env, VBool(v)))
    CStr(v) -> Ok((st, env, VStr(v)))
    CUnit -> Ok((st, env, VUnit))
    CLocal(sym, _) ->
      match map.get(env, sym) {
        Some(v) -> Ok((st, env, v))
        None -> cerr(st, env, "symbol " ++ to_string(sym) ++ " is not bound (interpreter bug)")
      }
    # boxing is a backend's business; every value here is already uniform
    CBox(inner, _) -> ceval(icx, st, env, inner)
    CUnbox(inner, _) -> ceval(icx, st, env, inner)
    CDup(inner, _) -> ceval(icx, st, env, inner)
    CClosure(name, owner, caps, _) -> {
      let (st1, env1, vals) = eval_all(icx, st, env, caps)?
      let (st2, cf) = get_cfun(icx, st1, env1, owner, name)?
      var cenv: Map[Int, CValue] = map.empty()
      var i = 0
      for p in cf.captures {
        if i < len(vals) { cenv = map.insert(cenv, p.sym, vals[i]) }
        i = i + 1
      }
      Ok((st2, env1, VClosure(owner, name, cenv)))
    }
    CFnRef(_, name, _) ->
      cerr(st, env, "`" ++ name ++ "` reached comptime unlifted (interpreter bug)")
    CCall(callee, args, _) -> {
      let (st1, env1, vals) = eval_all(icx, st, env, args)?
      match callee {
        CDirect(owner, name) -> call_named(icx, st1, env1, owner, name, vals)
        CDynamic(target) -> {
          let (st2, env2, f) = ceval(icx, st1, env1, target)?
          apply_fn(icx, st2, env2, f, vals)
        }
        # dispatch: the dictionary names its slot table, the slot names an
        # ordinary function, and the dictionary rides along as the trailing
        # argument -- which is exactly what the JVM's dictionary class does
        CMethod(dexpr, _, m, idx, _nev) -> {
          let (st2, env2, dv) = ceval(icx, st1, env1, dexpr)?
          match dv {
            VDict(key, _) ->
              match map.get(st2.cache.dicts, key) {
                Some(dd) ->
                  if idx >= len(dd.slots) {
                    cerr(st2, env2, "`" ++ m ++ "` has no slot " ++ to_string(idx))
                  } else {
                    match dd.slots[idx] {
                      CSlotFn(o, n) -> call_named(icx, st2, env2, o, n, vals ++ [dv])
                      CSlotDefault(o, _) ->
                        match map.get(icx.traits, dd.trait_id) {
                          Some(_) ->
                            call_default(icx, st2, env2, o, dd.trait_id, m, vals ++ [dv])
                          None -> cerr(st2, env2, "unknown trait behind `" ++ m ++ "`")
                        }
                    }
                  }
                None -> cerr(st2, env2, "no dictionary registered for `" ++ key ++ "`")
              }
            _ -> cerr(st2, env2, "`" ++ m ++ "` dispatched on a non-dictionary")
          }
        }
        CImpl(owner, tid, subject, m) -> {
          let frame = FImpl(owner, trait_frame_name(icx, tid), tid, ty_key(subject), m)
          match get_trait_cfun(icx, st1, env1, tid, subject_key(subject), m) {
            Err(err) -> Err(frame_error(err, frame))
            Ok(pair) -> {
              let (st2, cf) = pair
              let no_caps: Map[Int, CValue] = map.empty()
              call_cfun(icx, st2, env1, cf, frame, no_caps, vals)
            }
          }
        }
        CDefault(owner, tid, m) -> call_default(icx, st1, env1, owner, tid, m, vals)
      }
    }
    CIntrinsic(name, args, _) -> {
      let (st1, env1, vals) = eval_all(icx, st, env, args)?
      call_builtin(icx, st1, env1, name, vals)
    }
    CCtor(adt, ci, args, _) -> {
      let (st1, env1, vals) = eval_all(icx, st, env, args)?
      Ok((st1, env1, VAdt(adt, ci, vals)))
    }
    CField(target, _, _, idx, _) -> {
      let (st1, env1, v) = ceval(icx, st, env, target)?
      let (_, _, fields) = as_adt(v)
      Ok((st1, env1, fields[idx]))
    }
    CIsCtor(target, _, ci) -> {
      let (st1, env1, v) = ceval(icx, st, env, target)?
      let (_, vci, _) = as_adt(v)
      Ok((st1, env1, VBool(vci == ci)))
    }
    CTagOf(target, _) -> {
      let (st1, env1, v) = ceval(icx, st, env, target)?
      let (_, vci, _) = as_adt(v)
      Ok((st1, env1, VInt(vci)))
    }
    CTuple(elems, _) -> {
      let (st1, env1, vals) = eval_all(icx, st, env, elems)?
      Ok((st1, env1, VTuple(vals)))
    }
    CTupleGet(target, idx, _) -> {
      let (st1, env1, v) = ceval(icx, st, env, target)?
      match v {
        VTuple(xs) -> Ok((st1, env1, xs[idx]))
        _ -> cerr(st1, env1, "tuple projection on a non-tuple (interpreter bug)")
      }
    }
    CListLit(elems, _) -> {
      let (st1, env1, vals) = eval_all(icx, st, env, elems)?
      Ok((st1, env1, VList(vals)))
    }
    CBinary(op, l, r, _) -> eval_binary(icx, st, env, op, l, r)
    CUnary(op, operand, _) -> {
      let (st1, env1, v) = ceval(icx, st, env, operand)?
      match op {
        CNot -> Ok((st1, env1, VBool(not as_bool(v))))
        CNeg ->
          match v {
            VInt(n) -> Ok((st1, env1, VInt(-n)))
            # `-f`, not `0.0 - f`: the subtraction loses the sign of zero
            # (0.0 - 0.0 is +0.0), while the backends emit a true negate
            VFloat(f) -> Ok((st1, env1, VFloat(-f)))
            _ -> cerr(st1, env1, "negation needs a number")
          }
        CBnot ->
          match v {
            VInt(n) -> Ok((st1, env1, VInt(bnot_int(n))))
            _ -> cerr(st1, env1, "`~` needs an Int")
          }
      }
    }
    CIf(cond, thn, els, _) -> {
      let (st1, env1, cv) = ceval(icx, st, env, cond)?
      if as_bool(cv) {
        ceval(icx, st1, env1, thn)
      } else {
        match els {
          Some(eb) -> ceval(icx, st1, env1, eb)
          None -> Ok((st1, env1, VUnit))
        }
      }
    }
    CBlock(stmts, tail, _) -> {
      var st1 = st
      var env1 = env
      for s in stmts {
        let (st2, env2) = exec_cstmt(icx, st1, env1, s)?
        st1 = st2
        env1 = env2
      }
      match tail {
        Some(x) -> ceval(icx, st1, env1, x)
        None -> Ok((st1, env1, VUnit))
      }
    }
    CConstRef(owner, name, _) ->
      # `consts` is the folding module's view: its own constants plus the ones
      # it imported, keyed by simple name. A qualified reference names another
      # module, and comptime cannot see into a module it did not import, so a
      # miss here is the honest answer rather than a lookup by owner.
      match map.get(icx.consts, name) {
        Some(v) -> Ok((st, env, v))
        None ->
          cerr(st, env, "const `" ++ owner ++ "." ++ name ++ "` failed to evaluate")
      }
    # a comptime block nested in what is being folded: the driver folded it
    # first, exactly as codegen would have
    CComptime(lo, hi, _) ->
      match map.get(icx.blocks, (lo, hi)) {
        Some(v) -> Ok((st, env, v))
        None -> cerr(st, env, "a nested comptime block did not fold")
      }
    CReturn(v) ->
      match v {
        Some(x) -> {
          let (st1, env1, rv) = ceval(icx, st, env, x)?
          Err((st1, env1, KReturn(rv)))
        }
        None -> Err((st, env, KReturn(VUnit)))
      }
    CBreak(id) -> Err((st, env, KBreak(id)))
    CContinue(id) -> Err((st, env, KContinue(id)))
    CForeign(j, _) -> eval_java(icx, st, env, j)
    # A dictionary is a value here, the same three ways Core builds one: a
    # statically registered singleton, a construction from its parts', and a
    # part read back out of the one a slot body was handed.
    CDictRef(key, _, _, _) -> {
      let no_args: List[CValue] = []
      Ok((st, env, VDict(key, no_args)))
    }
    CDictApply(key, args, _) -> {
      let (st1, env1, vals) = eval_all(icx, st, env, args)?
      Ok((st1, env1, VDict(key, vals)))
    }
    CDictArg(dexpr, _, _, idx, _) -> {
      let (st1, env1, dv) = ceval(icx, st, env, dexpr)?
      match dv {
        VDict(_, args) ->
          if idx < len(args) {
            Ok((st1, env1, args[idx]))
          } else {
            cerr(st1, env1, "dictionary argument " ++ to_string(idx) ++ " is missing")
          }
        _ -> cerr(st1, env1, "dictionary argument read from a non-dictionary")
      }
    }
  }
}

## Two's-complement bitwise not, spelled with xor so the interpreter does not
## depend on its own host `~`.
fn bnot_int(n: Int) -> Int = -1 ^ n

## Ord[String] by hand -- code point order, sign only (spec 3.5) -- so a
## folded `"a" < "b"` does not ride on the host's own String `<`, which for
## one bootstrap step is still the seed compiler's order.
fn str_cmp_cp(a: String, b: String) -> Int = {
  let xs = code_points(a)
  let ys = code_points(b)
  var i = 0
  while i < len(xs) && i < len(ys) {
    if xs[i] != ys[i] { return if xs[i] < ys[i] { -1 } else { 1 } }
    i = i + 1
  }
  if len(xs) < len(ys) { -1 } else if len(xs) > len(ys) { 1 } else { 0 }
}

fn eval_binary(icx: ICx, st: ESt, env: Env, op: CBinOp, l: CExpr, r: CExpr) -> ER !io = {
  if op == CAnd || op == COr {
    let (st1, env1, lv) = ceval(icx, st, env, l)?
    let lb = as_bool(lv)
    if op == CAnd && not lb { return Ok((st1, env1, VBool(false))) }
    if op == COr && lb { return Ok((st1, env1, VBool(true))) }
    return ceval(icx, st1, env1, r)
  }
  let (st1, env1, lv) = ceval(icx, st, env, l)?
  let (st2, env2, rv) = ceval(icx, st1, env1, r)?
  if op == CAdd || op == CSub || op == CMul || op == CDiv || op == CMod {
    return arith(st2, env2, op, lv, rv)
  }
  if op == CBand || op == CBor || op == CBxor || op == CShl || op == CShr || op == CUshr {
    return bitwise(st2, env2, op, lv, rv)
  }
  if op == CConcat {
    match lv {
      VStr(a) ->
        match rv {
          VStr(b) -> return Ok((st2, env2, VStr(a ++ b)))
          _ -> ()
        }
      VList(a) ->
        match rv {
          VList(b) -> return Ok((st2, env2, VList(a ++ b)))
          _ -> ()
        }
      _ -> ()
    }
    return cerr(st2, env2, "`++` needs two Strings or two Lists")
  }
  if op == CEq { return Ok((st2, env2, VBool(value_eq(lv, rv)))) }
  if op == CNe { return Ok((st2, env2, VBool(not value_eq(lv, rv)))) }
  # ordered comparisons. `<` through an Ord impl never reaches here: lowering
  # made it an explicit cmp call, which comptime rejects as a trait call.
  var c = 0
  match lv {
    VInt(a) -> {
      let b = as_int(rv)
      c = if a < b { -1 } else if a > b { 1 } else { 0 }
    }
    VStr(a) -> {
      # Spelled as an explicit code point walk, not `a < b`: the host `<` here
      # is whatever the *seed* compiler emitted, so a fold through it would
      # answer with the previous generation's order for one bootstrap step.
      # Written out, the fold answers spec 4.3's code point order on the first
      # build (RP-12: interp and intrinsics must give one answer).
      c = str_cmp_cp(a, as_str(rv))
    }
    VFloat(a) -> {
      let b = match rv {
        VFloat(x) -> x
        _ -> panic("comptime interpreter bug: mixed comparison")
      }
      # NaN: every ordered comparison is false (spec §4.3). `x != x` is the
      # IEEE NaN test, and Dawn's Float `!=` is IEEE.
      if a != a || b != b { return Ok((st2, env2, VBool(false))) }
      # IEEE ordering, not Double.compare: the latter puts -0.0 below 0.0,
      # which folded `-0.0 < 0.0` to true while both backends answer false
      c = if a < b { -1 } else if a > b { 1 } else { 0 }
    }
    _ -> return cerr(st2, env2, "cannot order these values")
  }
  let res = if op == CLt {
    c < 0
  } else if op == CLe {
    c <= 0
  } else if op == CGt {
    c > 0
  } else {
    c >= 0
  }
  Ok((st2, env2, VBool(res)))
}

fn arith(st: ESt, env: Env, op: CBinOp, lv: CValue, rv: CValue) -> ER =
  match lv {
    VInt(a) ->
      match rv {
        VInt(b) ->
          if op == CAdd {
            Ok((st, env, VInt(a + b)))
          } else if op == CSub {
            Ok((st, env, VInt(a - b)))
          } else if op == CMul {
            Ok((st, env, VInt(a * b)))
          } else if op == CDiv {
            if b == 0 {
              cerr(st, env, "panicked: Int division by zero")
            } else {
              Ok((st, env, VInt(a / b)))
            }
          } else {
            if b == 0 {
              cerr(st, env, "panicked: Int modulo by zero")
            } else {
              Ok((st, env, VInt(a % b)))
            }
          }
        _ -> cerr(st, env, "arithmetic needs two numbers of the same type")
      }
    VFloat(a) ->
      match rv {
        VFloat(b) ->
          if op == CAdd {
            Ok((st, env, VFloat(a + b)))
          } else if op == CSub {
            Ok((st, env, VFloat(a - b)))
          } else if op == CMul {
            Ok((st, env, VFloat(a * b)))
          } else if op == CDiv {
            Ok((st, env, VFloat(a / b)))
          } else {
            Ok((st, env, VFloat(a % b)))
          }
        _ -> cerr(st, env, "arithmetic needs two numbers of the same type")
      }
    _ -> cerr(st, env, "arithmetic needs two numbers of the same type")
  }

fn bitwise(st: ESt, env: Env, op: CBinOp, lv: CValue, rv: CValue) -> ER =
  match lv {
    VInt(a) ->
      match rv {
        VInt(b) -> {
          let r = if op == CBand {
            a & b
          } else if op == CBor {
            a | b
          } else if op == CBxor {
            a ^ b
          } else if op == CShl {
            a << b
          } else if op == CShr {
            a >> b
          } else {
            a >>> b
          }
          Ok((st, env, VInt(r)))
        }
        _ -> cerr(st, env, "bitwise operators need two Ints")
      }
    _ -> cerr(st, env, "bitwise operators need two Ints")
  }

# ---- statements ----

fn exec_cstmt(icx: ICx, st0: ESt, env0: Env, s: CStmt) -> SR !io = {
  let (st, env, _) = burn(st0, env0)?
  match s {
    CSLet(sym, _, init) -> {
      let (st1, env1, v) = ceval(icx, st, env, init)?
      Ok((st1, map.insert(env1, sym, v)))
    }
    CSAssign(sym, value) -> {
      let (st1, env1, v) = ceval(icx, st, env, value)?
      Ok((st1, map.insert(env1, sym, v)))
    }
    CSDiscard(e) -> {
      let (st1, env1, _) = ceval(icx, st, env, e)?
      Ok((st1, env1))
    }
    CSIf(cond, thn, els) -> {
      let (st1, env1, cv) = ceval(icx, st, env, cond)?
      if as_bool(cv) {
        let (st2, env2, _) = ceval(icx, st1, env1, thn)?
        Ok((st2, env2))
      } else {
        match els {
          Some(eb) -> {
            let (st2, env2, _) = ceval(icx, st1, env1, eb)?
            Ok((st2, env2))
          }
          None -> Ok((st1, env1))
        }
      }
    }
    CSLoop(loop_id, body, step) -> exec_loop(icx, st, env, loop_id, body, step)
    # reference counting is a native-backend concern; these values are
    # ordinary Dawn values
    CSDrop(_) -> Ok((st, env))
  }
}

## Core's only loop: unconditional, left through a break naming it or a
## return. `step` runs on the way round, including after a `continue` -- it
## carries a `for`'s increment, which the body's end would otherwise skip.
fn exec_loop(
  icx: ICx,
  st: ESt,
  env: Env,
  loop_id: Int,
  body: CExpr,
  step: Option[CExpr]
) -> SR !io = {
  var st1 = st
  var env1 = env
  var go = true
  while go {
    let (stb, envb, _) = burn(st1, env1)?
    st1 = stb
    env1 = envb
    var stepping = true
    match ceval(icx, st1, env1, body) {
      Ok(t) -> {
        let (st2, env2, _) = t
        st1 = st2
        env1 = env2
      }
      Err(t) -> {
        let (st2, env2, ctl) = t
        st1 = st2
        env1 = env2
        match ctl {
          KBreak(id) ->
            if id == loop_id {
              go = false
              stepping = false
            } else {
              return Err((st1, env1, ctl))
            }
          KContinue(id) -> if id != loop_id { return Err((st1, env1, ctl)) }
          _ -> return Err((st1, env1, ctl))
        }
      }
    }
    if stepping {
      match step {
        Some(sx) -> {
          let (st3, env3, _) = ceval(icx, st1, env1, sx)?
          st1 = st3
          env1 = env3
        }
        None -> ()
      }
    }
  }
  Ok((st1, env1))
}

# ---- the module driver ----

## Accumulated results of one module's comptime evaluation: diagnostics,
## const values by name, comptime-block values by (lo, hi) span.
pub type CtOut = {
  diags: List[Diag],
  consts: Map[String, CValue],
  blocks: Map[(Int, Int), CValue]
}

## One module's evaluation in progress: what it has produced, and what
## lowering has produced for it. The second half is not part of `CtOut`
## because nothing downstream of comptime wants it. Driver, emitter and `doc`
## all keep a `CtOut` per module for the length of the build, and the lowered
## bodies would ride along there for no reader.
type CtRun = {
  out: CtOut,
  cache: LowerCache
}

fn empty_cache() -> LowerCache = {
  let no_fns: Map[String, CFun] = map.empty()
  let no_dicts: Map[String, CDictDef] = map.empty()
  LowerCache { fns: no_fns, dicts: no_dicts, next_lam: 0 }
}

## An evaluation seeded from what the module has lowered so far. Fuel and
## depth start over here and nowhere else, which is what keeps one const's
## budget from being spent by the one before it.
fn st_from(fuel: Int, cache: LowerCache) -> ESt =
  ESt { fuel: fuel, depth: 0, cache: cache }

fn fresh_st(fuel: Int) -> ESt = st_from(fuel, empty_cache())

## Lower one expression and run it. Every comptime evaluation goes through
## here, so lowering and interpretation are always the same pair. The cache
## goes in and comes back out. The expression's own body is lowered fresh,
## since no two initializers are the same expression; every function it
## reached stays lowered for the next one.
fn fold_expr(
  icx: ICx,
  fuel: Int,
  cache: LowerCache,
  e: TExpr,
  lo: Int,
  hi: Int
) -> (LowerCache, Result[CValue, Diag]) !io = {
  let env: Env = map.empty()
  let (ce, lifted, dicts, next) =
    lower.lower_expr_only(icx.owner, e, icx.traits, icx.impls, icx.adts,
      icx.prog_fns, icx.syms, cache.next_lam)
  var tbl = cache.fns
  for lf in lifted { tbl = map.insert(tbl, lf.owner ++ "." ++ lf.name, lf) }
  var dts = cache.dicts
  for d in dicts { dts = map.insert(dts, d.key, d) }
  let st = st_from(fuel, LowerCache { fns: tbl, dicts: dts, next_lam: next })
  match ceval(icx, st, env, ce) {
    Ok(r) -> {
      let (st1, _, v) = r
      (st1.cache, Ok(v))
    }
    Err(r) -> {
      let (st1, _, ctl) = r
      # a failure here is the interpreter refusing, not lowering failing:
      # invariant panics in lowering propagate (ARC-06). So what was lowered
      # on the way is still valid, and is kept
      match ctl {
        KErr(failure) -> (st1.cache, Err(failure_diag(failure, lo, hi)))
        _ -> (st1.cache, Err(failure_diag(
          ct_failure("control flow escaped the folded expression (interpreter bug)", ""), lo, hi)))
      }
    }
  }
}

fn eval_block(icx: ICx, fuel: Int, body: TExpr, run: CtRun, lo: Int, hi: Int) -> CtRun !io = {
  # a block nested inside this one folds first, so lowering's reference to it
  # resolves
  let run1 = walk_expr(icx, fuel, body, run)
  let icx1 = ICx { ..icx, blocks: run1.out.blocks }
  let (cache, r) = fold_expr(icx1, fuel, run1.cache, body, lo, hi)
  match r {
    Ok(v) ->
      CtRun {
        out: CtOut { ..run1.out, blocks: map.insert(run1.out.blocks, (lo, hi), v) },
        cache: cache
      }
    Err(d) ->
      CtRun { out: CtOut { ..run1.out, diags: run1.out.diags ++ [d] }, cache: cache }
  }
}

## Find comptime blocks in a checked body and evaluate each with a fresh fuel
## budget. This walk stays on TAST: it is a search for a syntactic form, not
## an evaluation, and by the time Core exists lowering has already replaced
## the form with a reference to its value.
fn walk_expr(icx: ICx, fuel: Int, e: TExpr, acc: CtRun) -> CtRun !io =
  match e {
    XComptime(body, lo, hi, ..) -> eval_block(icx, fuel, body, acc, lo, hi)
    XStr(parts, _, _) -> {
      var acc1 = acc
      for p in parts {
        match p {
          TSPInterp(x, _) -> { acc1 = walk_expr(icx, fuel, x, acc1) }
          TSPText(_) -> ()
        }
      }
      acc1
    }
    XLambda(_, _, body, ..) -> walk_expr(icx, fuel, body, acc)
    XApply(target, args, ..) -> {
      var acc1 = walk_expr(icx, fuel, target, acc)
      for a in args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XJava(jc, ..) -> {
      var acc1 = acc
      match jc.target {
        Some(t) -> { acc1 = walk_expr(icx, fuel, t, acc1) }
        None -> ()
      }
      for a in jc.args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XPropagate(operand, ..) -> walk_expr(icx, fuel, operand, acc)
    XUnwrap(operand, ..) -> walk_expr(icx, fuel, operand, acc)
    XReturn(v, _, _) ->
      match v {
        Some(x) -> walk_expr(icx, fuel, x, acc)
        None -> acc
      }
    XIndex(target, index, ..) ->
      walk_expr(icx, fuel, index, walk_expr(icx, fuel, target, acc))
    XCallDyn(_, _, args, ..) -> {
      var acc1 = acc
      for a in args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XCallBuiltin(_, args, ..) -> {
      var acc1 = acc
      for a in args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XCallFn(_, _, args, ..) -> {
      var acc1 = acc
      for a in args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XCtor(_, _, written, _, spread, ..) -> {
      var acc1 = acc
      match spread {
        Some(sp) -> { acc1 = walk_expr(icx, fuel, sp, acc1) }
        None -> ()
      }
      for w in written { acc1 = walk_expr(icx, fuel, w, acc1) }
      acc1
    }
    XField(target, ..) -> walk_expr(icx, fuel, target, acc)
    XListLit(elems, ..) -> {
      var acc1 = acc
      for x in elems {
        match x {
          TLEExpr(e) -> { acc1 = walk_expr(icx, fuel, e, acc1) }
          TLESpread(e) -> { acc1 = walk_expr(icx, fuel, e, acc1) }
          TLEIf(arms) -> {
            for a in arms {
              acc1 = walk_expr(icx, fuel, a.body, walk_expr(icx, fuel, a.cond, acc1))
            }
          }
        }
      }
      acc1
    }
    XTupleLit(elems, ..) -> {
      var acc1 = acc
      for x in elems { acc1 = walk_expr(icx, fuel, x, acc1) }
      acc1
    }
    XBinary(_, l, r, ..) -> walk_expr(icx, fuel, r, walk_expr(icx, fuel, l, acc))
    XUnary(_, operand, ..) -> walk_expr(icx, fuel, operand, acc)
    XIf(cond, thn, els, ..) -> {
      var acc1 = walk_expr(icx, fuel, thn, walk_expr(icx, fuel, cond, acc))
      match els {
        Some(eb) -> walk_expr(icx, fuel, eb, acc1)
        None -> acc1
      }
    }
    XMatch(scrut, arms, ..) -> {
      var acc1 = walk_expr(icx, fuel, scrut, acc)
      for arm in arms {
        match arm.guard {
          Some(g) -> { acc1 = walk_expr(icx, fuel, g, acc1) }
          None -> ()
        }
        acc1 = walk_expr(icx, fuel, arm.body, acc1)
      }
      acc1
    }
    XBlock(stmts, tail, ..) -> {
      var acc1 = acc
      for s in stmts { acc1 = walk_stmt(icx, fuel, s, acc1) }
      match tail {
        Some(x) -> walk_expr(icx, fuel, x, acc1)
        None -> acc1
      }
    }
    XUnsafePure(body, ..) -> walk_expr(icx, fuel, body, acc)
    _ -> acc
  }

fn walk_stmt(icx: ICx, fuel: Int, s: TStmt, acc: CtRun) -> CtRun !io =
  match s {
    TSLet(_, _, init, _, _) -> walk_expr(icx, fuel, init, acc)
    TSLetPat(_, init, _, _) -> walk_expr(icx, fuel, init, acc)
    TSLocalFn(_, _, _, _, body, _, _, _) -> walk_expr(icx, fuel, body, acc)
    TSAssign(_, _, value, _, _) -> walk_expr(icx, fuel, value, acc)
    TSExpr(e, _, _) -> walk_expr(icx, fuel, e, acc)
    TSAssert(cond, _, _, _) -> walk_expr(icx, fuel, cond, acc)
    TSWhile(cond, body, _, _, _) -> walk_expr(icx, fuel, body, walk_expr(icx, fuel, cond, acc))
    TSFor(_, _, from, to_opt, _, body, _, _, _) -> {
      var acc1 = walk_expr(icx, fuel, from, acc)
      match to_opt {
        Some(t) -> { acc1 = walk_expr(icx, fuel, t, acc1) }
        None -> ()
      }
      walk_expr(icx, fuel, body, acc1)
    }
  }

## The direct-function signature table lowering needs while evaluating one
## module. `by_owner` contains every previously loaded std module; the current
## module has not yet joined it, so its checked direct functions are added
## explicitly. The predicate is repeated defensively on `by_owner`: production
## builds it through `note_direct_fn`, but accepting a method body here would
## make this boundary lossy again for any other caller.
fn program_sigs(
  by_owner: Map[String, Map[String, TFun]],
  tm: TModule,
  owner: String
) -> Map[(String, String), Sig] = {
  var out: Map[(String, String), Sig] = map.empty()
  for o in map.keys(by_owner) {
    let tbl = map.get(by_owner, o).expect("owner table")
    for pr in map.entries(tbl) {
      let (name, f) = pr
      if is_direct_fn(f) { out = map.insert(out, (o, name), f.sig) }
    }
  }
  for f in tm.fns {
    if is_direct_fn(f) { out = map.insert(out, (owner, f.name), f.sig) }
  }
  out
}

## Evaluate all comptime constructs of a checked module: consts in declaration
## order (each gets a fresh fuel budget), then comptime blocks in function and
## test bodies. Failures become ordinary diagnostics.
##
## Callers get the results only. The lowering cache the run accumulated is
## dropped here, which is the whole of its lifetime: module in, module out.
pub fn eval_comptime(
  tm: TModule,
  std_fns: Map[String, TFun],
  by_owner: Map[String, Map[String, TFun]],
  std_impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  adts: Adts,
  traits: Traits,
  impls: Impls,
  owner: String,
  opts: CtOpts
) -> CtOut !io =
  eval_module(tm, std_fns, by_owner, std_impl_fns, std_names, adts, traits,
    impls, owner, opts).out

## The same run, with the cache still attached. Private because only this
## module's own tests have a reason to look at it: from the outside, whether
## two consts shared a lowered body is not observable, and that is the point.
fn eval_module(
  tm: TModule,
  std_fns: Map[String, TFun],
  by_owner: Map[String, Map[String, TFun]],
  std_impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  adts: Adts,
  traits: Traits,
  impls: Impls,
  owner: String,
  opts: CtOpts
) -> CtRun !io = {
  let fuel = opts.fuel
  # std is implicitly visible, so a const may call it; a local definition
  # still shadows it, matching the checker's local → std → builtin order
  var fns = std_fns
  for f in tm.fns { fns = note_direct_fn(fns, f) }
  # the owner each flat name came from, so a std function lowered on demand
  # resolves its own module's calls before falling back
  var owner_of: Map[String, String] = map.empty()
  for o in map.keys(by_owner) {
    let tbl = map.get(by_owner, o).expect("owner table")
    for n in map.keys(tbl) { owner_of = map.insert(owner_of, n, o) }
  }
  for f in tm.fns {
    if is_direct_fn(f) { owner_of = map.insert(owner_of, f.name, owner) }
  }
  let prog_fns = program_sigs(by_owner, tm, owner)
  # this module's own impl methods and trait defaults join std's
  var impl_fns = std_impl_fns
  for f in tm.fns { impl_fns = note_trait_fn(impl_fns, owner, f) }
  let empty_c: Map[String, CValue] = map.empty()
  let empty_b: Map[(Int, Int), CValue] = map.empty()
  var run = CtRun {
    out: CtOut { diags: [], consts: empty_c, blocks: empty_b },
    cache: empty_cache()
  }
  let base = ICx {
    fns: fns,
    by_owner: by_owner,
    owner_of: owner_of,
    std_names: std_names,
    adts: adts,
    consts: empty_c,
    blocks: empty_b,
    owner: owner,
    traits: traits,
    impls: impls,
    prog_fns: prog_fns,
    impl_fns: impl_fns,
    syms: tm.syms,
    ffi: opts.ffi,
    jcall: opts.jcall
  }
  for c in tm.consts {
    # a comptime block inside the initializer folds first
    run = walk_expr(ICx { ..base, consts: run.out.consts, blocks: run.out.blocks },
      fuel, c.init, run)
    let icx = ICx { ..base, consts: run.out.consts, blocks: run.out.blocks }
    let (cache, r) = fold_expr(icx, fuel, run.cache, c.init, c.lo, c.hi)
    match r {
      Ok(v) -> {
        run = CtRun {
          out: CtOut { ..run.out, consts: map.insert(run.out.consts, c.name, v) },
          cache: cache
        }
      }
      Err(d) -> {
        run = CtRun { out: CtOut { ..run.out, diags: run.out.diags ++ [d] }, cache: cache }
      }
    }
  }
  for f in tm.fns {
    run = walk_expr(ICx { ..base, consts: run.out.consts, blocks: run.out.blocks },
      fuel, f.body, run)
  }
  for t in tm.tests {
    run = walk_expr(ICx { ..base, consts: run.out.consts, blocks: run.out.blocks },
      fuel, t.body, run)
  }
  run
}

# ---- tests ----

# ---- the intrinsic gate (audit RP-12) ----

## An interpreter context with nothing in it, for asking `call_builtin` a
## question. The prelude tables come from the checker because two arms read
## `icx.adts` to find `Option`; everything else an arm could reach is empty,
## and no probe gets far enough to look.
fn probe_icx() -> ICx = {
  let cx = cx_new(None, None)
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let no_owner_of: Map[String, String] = map.empty()
  let no_consts: Map[String, CValue] = map.empty()
  let no_blocks: Map[(Int, Int), CValue] = map.empty()
  let no_syms: Map[Int, Sym] = map.empty()
  ICx {
    fns: no_fns,
    by_owner: no_owner,
    owner_of: no_owner_of,
    std_names: set.empty(),
    adts: cx.adts,
    consts: no_consts,
    blocks: no_blocks,
    owner: "probe",
    traits: cx.traits,
    impls: cx.impl_table,
    prog_fns: map.empty(),
    impl_fns: no_impls(),
    syms: no_syms,
    ffi: false,
    jcall: jcall_refused
  }
}

## What `call_builtin` really does with `name`, asked by calling it:
## `"arm"`, `"refused"`, or `"listed-no-arm"`.
##
## No arguments are passed, and that is the whole trick. Every arm that reads
## one panics on the empty list, and a panic is exactly the evidence wanted --
## control reached an arm. So no arm has to be handed a plausible argument, and
## an arm added later needs nothing here to be seen. The two non-arm outcomes
## have texts of their own (`no_arm_msg`, `NO_ARM_LISTED`), which is why both
## are written once and read from here.
fn probe_builtin(icx: ICx, name: String) -> String !io = {
  let env: Env = map.empty()
  let no_args: List[CValue] = []
  match catch_panic(() => call_builtin(icx, fresh_st(1000), env, name, no_args)) {
    Err(msg) -> if str.contains(msg.message, NO_ARM_LISTED) { "listed-no-arm" } else { "arm" }
    Ok(r) ->
      match r {
        Ok(_) -> "arm"
        Err(t) -> {
          let (_, _, ctl) = t
          match ctl {
            KErr(failure) ->
              if failure.msg == no_arm_msg(name) { "refused" } else { "arm" }
            _ -> "arm"
          }
        }
      }
  }
}

test "the comptime interpreter covers every intrinsic, or refuses it by name" {
  let arms = interp_arms()
  let rejects = comptime_rejects()
  # the two tables that between them name every intrinsic in the program:
  # what a user may write, and what lowering emits on top of that
  let user = map.keys(intrinsics())
  let internal = lower.internal_intrinsics()
  let icx = probe_icx()

  # 1. the lists partition the tables. This is the check that makes a new
  #    primitive impossible to forget: added to `types.intrinsics()` and to
  #    neither list here, it lands in no group and this fails.
  for n in user ++ internal {
    let a = has_name(arms, n)
    let r = has_name(rejects, n)
    assert a || r
    assert not (a && r)
  }

  # 2. nothing on either list is outside the tables. This is the direction
  #    that had rotted: `map_index`, `chars` and `split` had arms here long
  #    after their producers went away (`m[k]` became a `std/hamt.index` call,
  #    the other two moved into std/str), and nothing said so.
  for n in arms ++ rejects {
    assert has_name(user, n) || has_name(internal, n)
  }

  # 3. the lists say what the chain does. Without this the lists would be a
  #    second copy of the chain, free to drift from it the way the chain drifted
  #    from `types.intrinsics()`.
  for n in arms { assert probe_builtin(icx, n) == "arm" }
  for n in rejects { assert probe_builtin(icx, n) == "refused" }
  # and a name that is no intrinsic at all gets the same refusal, which is
  # what the probe reads as "no arm"
  assert probe_builtin(icx, "no_such_primitive") == "refused"

  # 4. the sizes the comments above quote. A count written in prose is what
  #    went wrong in the list this gate replaces -- lowering's own said
  #    "thirteen more" and "all twelve" in the same paragraph -- so the two
  #    numbers this file states are asserted rather than asserted-by-nobody.
  assert len(arms) == 43
  assert len(rejects) == 77
}

fn test_sig(name: String, params: List[Ty], ret: Ty) -> Sig =
  Sig {
    name: name,
    param_tys: params,
    param_names: [],
    param_defaults: [],
    ret: ret,
    eff: EPure,
    is_builtin: false,
    tparams: [],
    constraints: [],
    eparams: [],
    owner: None,
    trait_id: None,
    op_of: None,
    inferring: false
  }

fn test_tfun(name: String, params: List[Ty], ret: Ty, body: TExpr) -> TFun =
  TFun {
    name: name,
    sig: test_sig(name, params, ret),
    param_syms: [],
    dict_syms: [],
    ev_syms: [],
    defaults: [],
    body: body,
    is_test: false,
    impl_of: None,
    default_of: None
  }

test "an empty user impl calls its default; explicit methods still call their bodies" {
  let src = "trait Defaulted[T] {\n" ++
    "  fn defaulted(x: T) -> Int = 42\n" ++
    "}\n" ++
    "type Empty = Empty\n" ++
    "impl Defaulted[Empty] {\n" ++
    "}\n" ++
    "const A: Int = defaulted(Empty)\n" ++
    "trait Required[T] {\n" ++
    "  fn required(x: T) -> Int\n" ++
    "}\n" ++
    "type Filled = Filled\n" ++
    "impl Required[Filled] {\n" ++
    "  fn required(x: Filled) -> Int = 41\n" ++
    "}\n" ++
    "const B: Int = required(Filled)\n" ++
    "trait Overridden[T] {\n" ++
    "  fn overridden(x: T) -> Int = 1\n" ++
    "}\n" ++
    "type Override = Override\n" ++
    "impl Overridden[Override] {\n" ++
    "  fn overridden(x: Override) -> Int = 43\n" ++
    "}\n" ++
    "const C: Int = overridden(Override)\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(Some("m"), Some("traits.dawn")), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(1000000))
  assert len(out.diags) == 0
  assert map.get(out.consts, "A") == Some(VInt(42))
  assert map.get(out.consts, "B") == Some(VInt(41))
  assert map.get(out.consts, "C") == Some(VInt(43))

  let sigs = program_sigs(no_owner, tm, "m")
  let lowered = (i: Int) => {
    let (ce, _lifted, _dicts, _next) = lower.lower_expr_only("m", tm.consts[i].init,
      cx1.traits, cx1.impl_table, cx1.adts, sigs, tm.syms, 0)
    ce
  }
  match lowered(0) {
    CCall(CDefault(_, _, "defaulted"), _, _) -> ()
    _ -> { assert false }
  }
  match lowered(1) {
    CCall(CImpl(_, _, _, "required"), _, _) -> ()
    _ -> { assert false }
  }
  match lowered(2) {
    CCall(CImpl(_, _, _, "overridden"), _, _) -> ()
    _ -> { assert false }
  }
}

test "interpreter identity tables keep direct, impl, and default spellings separate" {
  # Importing a trait by name does not inject its methods. A local direct
  # function may therefore legally use the same spelling as the imported
  # trait's default and this module's impl method.
  let defs_src = "pub trait Same[T] {\n" ++
    "  fn same(x: T) -> Int = 9\n" ++
    "}\n"
  let (defs_m, defs_pdiags) = parser.parse_module(defs_src)
  assert len(defs_pdiags) == 0
  let empty_env: Map[String, ModExports] = map.empty()
  let (defs_cx, defs_tm) =
    check_module(cx_new(Some("defs"), Some("defs.dawn")), defs_m, empty_env)
  assert len(defs_cx.diags) == 0
  let defs_exp = exports_of(defs_cx, defs_m, "defs", "defs")

  let src = "use defs.{Same}\n" ++
    "pub type Empty = Empty\n" ++
    "pub type Explicit = Explicit\n" ++
    "pub fn same(a: Int, b: Int) -> Int = a + b\n" ++
    "impl Same[Empty] {\n" ++
    "}\n" ++
    "impl Same[Explicit] {\n" ++
    "  fn same(x: Explicit) -> Int = 7\n" ++
    "}\n" ++
    "const DIRECT: Int = same(20, 22)\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env = map.from([("defs", defs_exp)])
  let cx0 = cx_new(Some("same_impl"), Some("same_impl.dawn"))
  let (cx1, tm) = check_module(Cx { ..cx0, next_id: defs_cx.next_id }, m, env)
  assert len(cx1.diags) == 0
  let impl_exp = exports_of(cx1, m, "same_impl", "same_impl")
  let tid = map.get(cx1.traits_by_name, "Same").expect("Same trait")
  let explicit_id = map.get(cx1.adts_by_name, "Explicit").expect("Explicit ADT")

  # `defs` contains only the default body. It must not enter either direct
  # table, while the same-spelled local impl must not replace the direct fn.
  var defs_direct: Map[String, TFun] = map.empty()
  var all_impls = no_impls()
  for f in defs_tm.fns {
    defs_direct = note_direct_fn(defs_direct, f)
    all_impls = note_trait_fn(all_impls, "defs", f)
  }
  assert map.get(defs_direct, "same") == None
  var local_direct: Map[String, TFun] = map.empty()
  var prior_direct = defs_direct
  var explicit_fn: Option[TFun] = None
  for f in tm.fns {
    local_direct = note_direct_fn(local_direct, f)
    prior_direct = note_direct_fn(prior_direct, f)
    all_impls = note_trait_fn(all_impls, "same_impl", f)
    match f.impl_of {
      Some(_) -> { explicit_fn = Some(f) }
      None -> ()
    }
  }
  let direct_fn = map.get(local_direct, "same").expect("direct same")
  let impl_fn = explicit_fn.expect("impl same")
  let default_fn = defs_tm.fns[0]
  assert direct_fn.sig.param_tys == [TyInt, TyInt]
  assert impl_fn.sig.param_tys == [TyAdt(explicit_id, [])]
  assert default_fn.sig.param_tys != direct_fn.sig.param_tys
  assert default_fn.sig.param_tys != impl_fn.sig.param_tys

  let defs_owners = map.from([("defs", defs_direct)])
  let direct_out = eval_comptime(tm, defs_direct, defs_owners, all_impls, set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "same_impl", ct_fuel(1000000))
  assert len(direct_out.diags) == 0
  assert map.get(direct_out.consts, "DIRECT") == Some(VInt(42))

  # A third, ordinary source module imports the trait method and the two
  # subjects, so the checker -- not this test -- produces the CImpl/CDefault
  # call inputs. The evaluator context below is deliberately hand-assembled
  # from all three modules. Production driver/analyze does not yet carry prior
  # user modules' direct or trait bodies into eval_comptime; this is an
  # interpreter identity test, not an end-to-end cross-module comptime claim.
  let caller_src = "use defs.{same}\n" ++
    "use same_impl.{Empty, Explicit}\n" ++
    "const IMPL: Int = same(Explicit)\n" ++
    "const DEFAULT: Int = same(Empty)\n"
  let (caller_m, caller_pdiags) = parser.parse_module(caller_src)
  assert len(caller_pdiags) == 0
  let caller_env = map.from([("defs", defs_exp), ("same_impl", impl_exp)])
  let caller0 = cx_new(Some("caller"), Some("caller.dawn"))
  let caller_seed = Cx {
    ..caller0,
    next_id: cx1.next_id,
    impl_table: cx1.impl_table
  }
  let (caller_cx, caller_tm) = check_module(caller_seed, caller_m, caller_env)
  assert len(caller_cx.diags) == 0
  let owners = map.from([("defs", defs_direct), ("same_impl", local_direct)])
  let out = eval_comptime(caller_tm, prior_direct, owners, all_impls, set.empty(), caller_cx.adts,
    caller_cx.traits, caller_cx.impl_table, "caller", ct_fuel(1000000))
  assert len(out.diags) == 0
  assert map.get(out.consts, "IMPL") == Some(VInt(7))
  assert map.get(out.consts, "DEFAULT") == Some(VInt(9))

  let direct_sigs = program_sigs(defs_owners, tm, "same_impl")
  assert map.get(direct_sigs, ("defs", "same")) == None
  assert map.get(direct_sigs, ("same_impl", "same")).expect("direct signature").param_tys ==
    [TyInt, TyInt]
  let (direct_core, _direct_lifted, _direct_dicts, _direct_next) =
    lower.lower_expr_only("same_impl", tm.consts[0].init, cx1.traits, cx1.impl_table,
      cx1.adts, direct_sigs, tm.syms, 0)
  match direct_core {
    CCall(CDirect(o, "same"), _, _) -> { assert o == "same_impl" }
    _ -> { assert false }
  }

  let caller_sigs = program_sigs(owners, caller_tm, "caller")
  assert map.get(caller_sigs, ("defs", "same")) == None
  assert map.get(caller_sigs, ("same_impl", "same")).expect("direct signature").param_tys ==
    [TyInt, TyInt]
  let lowered = (i: Int) => {
    let (ce, _lifted, _dicts, _next) = lower.lower_expr_only("caller", caller_tm.consts[i].init,
      caller_cx.traits, caller_cx.impl_table, caller_cx.adts, caller_sigs, caller_tm.syms, 0)
    ce
  }
  match lowered(0) {
    CCall(CImpl(o, got_tid, subject, "same"), _, _) -> {
      assert o == "same_impl"
      assert got_tid == tid
      assert subject == TyAdt(explicit_id, [])
    }
    _ -> { assert false }
  }
  match lowered(1) {
    CCall(CDefault(o, got_tid, "same"), _, _) -> {
      assert o == "defs"
      assert got_tid == tid
    }
    _ -> { assert false }
  }
}

test "a standard helper keeps the fuel hint beside its inner and outer frames" {
  let helper_src = "pub fn burn() -> Int = {\n" ++
    "  var n = 0\n" ++
    "  while true { n = n + 1 }\n" ++
    "  n\n" ++
    "}\n" ++
    "pub fn wrap() -> Int = burn()\n"
  let (helper_m, helper_pdiags) = parser.parse_module(helper_src)
  assert len(helper_pdiags) == 0
  let empty_env: Map[String, ModExports] = map.empty()
  let (helper_cx, helper_tm) =
    check_module(cx_new(Some("std/helper"), Some("helper.dawn")), helper_m, empty_env)
  assert len(helper_cx.diags) == 0
  let helper_exp = exports_of(helper_cx, helper_m, "std/helper", "std/helper")

  let caller_src = "use std/helper.{wrap}\n" ++
    "fn outer() -> Int = wrap()\n" ++
    "const VALUE: Int = outer()\n"
  let (caller_m, caller_pdiags) = parser.parse_module(caller_src)
  assert len(caller_pdiags) == 0
  let caller_env = map.from([("std/helper", helper_exp)])
  let caller0 = cx_new(Some("caller"), Some("caller.dawn"))
  let (caller_cx, caller_tm) = check_module(
    Cx { ..caller0, next_id: helper_cx.next_id }, caller_m, caller_env)
  assert len(caller_cx.diags) == 0

  var helper_direct: Map[String, TFun] = map.empty()
  for f in helper_tm.fns { helper_direct = note_direct_fn(helper_direct, f) }
  let owners = map.from([("std/helper", helper_direct)])
  let out = eval_comptime(caller_tm, helper_direct, owners, no_impls(), set.empty(),
    caller_cx.adts, caller_cx.traits, caller_cx.impl_table, "caller", ct_fuel(250))
  assert len(out.diags) == 1
  let hint = out.diags[0].hint
  assert str.starts_with(hint,
    "raise it with --comptime-fuel, or simplify the computation\n\n")
  assert str.contains(hint, "at direct `std/helper.burn`")
  assert str.contains(hint, "at direct `std/helper.wrap`")
  assert str.contains(hint, "at direct `caller.outer`")
}

test "same-named direct failures retain their resolved owners" {
  let empty_env: Map[String, ModExports] = map.empty()
  let (left_m, left_pdiags) =
    parser.parse_module("pub fn same() -> Int = panic(\"left\")\n")
  assert len(left_pdiags) == 0
  let (left_cx, left_tm) =
    check_module(cx_new(Some("left"), Some("left.dawn")), left_m, empty_env)
  assert len(left_cx.diags) == 0
  let left_exp = exports_of(left_cx, left_m, "left", "left")

  let (right_m, right_pdiags) =
    parser.parse_module("pub fn same() -> Int = panic(\"right\")\n")
  assert len(right_pdiags) == 0
  let right0 = cx_new(Some("right"), Some("right.dawn"))
  let (right_cx, right_tm) =
    check_module(Cx { ..right0, next_id: left_cx.next_id }, right_m, empty_env)
  assert len(right_cx.diags) == 0
  let right_exp = exports_of(right_cx, right_m, "right", "right")

  let caller_src = "use left\nuse right\n" ++
    "const LEFT: Int = left.same()\n" ++
    "const RIGHT: Int = right.same()\n"
  let (caller_m, caller_pdiags) = parser.parse_module(caller_src)
  assert len(caller_pdiags) == 0
  let caller_env = map.from([("left", left_exp), ("right", right_exp)])
  let caller0 = cx_new(Some("caller"), Some("caller.dawn"))
  let (caller_cx, caller_tm) = check_module(
    Cx { ..caller0, next_id: right_cx.next_id }, caller_m, caller_env)
  assert len(caller_cx.diags) == 0

  var left_direct: Map[String, TFun] = map.empty()
  for f in left_tm.fns { left_direct = note_direct_fn(left_direct, f) }
  var right_direct: Map[String, TFun] = map.empty()
  for f in right_tm.fns { right_direct = note_direct_fn(right_direct, f) }
  var flat = left_direct
  for f in right_tm.fns { flat = note_direct_fn(flat, f) }
  let owners = map.from([("left", left_direct), ("right", right_direct)])
  let out = eval_comptime(caller_tm, flat, owners, no_impls(), set.empty(), caller_cx.adts,
    caller_cx.traits, caller_cx.impl_table, "caller", ct_fuel(1000000))
  assert len(out.diags) == 2
  assert str.contains(out.diags[0].hint, "at direct `left.same`")
  assert not str.contains(out.diags[0].hint, "at direct `right.same`")
  assert str.contains(out.diags[1].hint, "at direct `right.same`")
  assert not str.contains(out.diags[1].hint, "at direct `left.same`")
}

test "dynamic, impl, and default failures each carry their real frame" {
  let src = "trait Defaulted[T] {\n" ++
    "  fn explode(x: T) -> Int = panic(\"default\")\n" ++
    "}\n" ++
    "type Empty = Empty\n" ++
    "impl Defaulted[Empty] {}\n" ++
    "fn via_default() -> Int = explode(Empty)\n" ++
    "trait Required[T] { fn burst(x: T) -> Int }\n" ++
    "type Filled = Filled\n" ++
    "impl Required[Filled] { fn burst(x: Filled) -> Int = panic(\"impl\") }\n" ++
    "fn via_impl() -> Int = burst(Filled)\n" ++
    "fn dyn_boom() -> Int = panic(\"dynamic\")\n" ++
    "fn invoke(f: fn() -> Int) -> Int = f()\n" ++
    "const DEFAULT: Int = via_default()\n" ++
    "const IMPL: Int = via_impl()\n" ++
    "const DYNAMIC: Int = invoke(dyn_boom)\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(Some("m"), Some("frames.dawn")), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(1000000))
  assert len(out.diags) == 3

  let default_hint = out.diags[0].hint
  assert str.contains(default_hint, "at default `m::Defaulted#")
  assert str.contains(default_hint, ".explode`")
  assert str.contains(default_hint, "at direct `m.via_default`")

  let impl_hint = out.diags[1].hint
  assert str.contains(impl_hint, "at impl `m::Required#")
  assert str.contains(impl_hint, ".burst`")
  assert str.contains(impl_hint, "at direct `m.via_impl`")

  let dynamic_hint = out.diags[2].hint
  assert str.contains(dynamic_hint, "at dynamic `m.")
  assert str.contains(dynamic_hint, "at direct `m.dyn_boom`")
  assert str.contains(dynamic_hint, "at direct `m.invoke`")
}

test "comptime call chains retain the nearest sixteen frames" {
  let src = "fn limit_00() -> Int = limit_01()\n" ++
    "fn limit_01() -> Int = limit_02()\n" ++
    "fn limit_02() -> Int = limit_03()\n" ++
    "fn limit_03() -> Int = limit_04()\n" ++
    "fn limit_04() -> Int = limit_05()\n" ++
    "fn limit_05() -> Int = limit_06()\n" ++
    "fn limit_06() -> Int = limit_07()\n" ++
    "fn limit_07() -> Int = limit_08()\n" ++
    "fn limit_08() -> Int = limit_09()\n" ++
    "fn limit_09() -> Int = limit_10()\n" ++
    "fn limit_10() -> Int = limit_11()\n" ++
    "fn limit_11() -> Int = limit_12()\n" ++
    "fn limit_12() -> Int = limit_13()\n" ++
    "fn limit_13() -> Int = limit_14()\n" ++
    "fn limit_14() -> Int = limit_15()\n" ++
    "fn limit_15() -> Int = limit_16()\n" ++
    "fn limit_16() -> Int = limit_17()\n" ++
    "fn limit_17() -> Int = limit_18()\n" ++
    "fn limit_18() -> Int = limit_19()\n" ++
    "fn limit_19() -> Int = panic(\"bottom\")\n" ++
    "const VALUE: Int = limit_00()\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(Some("m"), Some("limit.dawn")), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(1000000))
  assert len(out.diags) == 1
  let hint = out.diags[0].hint
  assert len(str.split(hint, "\n  at ")) == MAX_FAILURE_FRAMES + 1
  assert str.contains(hint, "at direct `m.limit_19`")
  assert str.contains(hint, "at direct `m.limit_04`")
  assert not str.contains(hint, "at direct `m.limit_03`")
  assert str.ends_with(hint, "  ... outer calls omitted")
}

test "Map and Set calls have signatures but remain ordinary comptime refusals" {
  let src = "const M: Int = {\n" ++
    "  let m: Map[Int, Int] = map_empty()\n" ++
    "  map_size(m)\n" ++
    "}\n" ++
    "fn set_count() -> Int = {\n" ++
    "  let s: Set[Int] = set_from([1])\n" ++
    "  set_size(s)\n" ++
    "}\n" ++
    "const S: Int = set_count()\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(Some("std/t"), Some("collections.dawn")), m, env)
  assert len(cx1.diags) == 0

  var hamt: Map[String, TFun] = map.empty()
  hamt = map.insert(hamt, "empty",
    test_tfun("empty", [], TyMap(TyInt, TyInt), XError(0, 0)))
  hamt = map.insert(hamt, "sfrom",
    test_tfun("sfrom", [TyError], TySet(TyInt), XError(0, 0)))
  hamt = map.insert(hamt, "count",
    test_tfun("count", [TyError], TyInt, XError(0, 0)))
  var owners: Map[String, Map[String, TFun]] = map.empty()
  owners = map.insert(owners, "std/hamt", hamt)
  let no_fns: Map[String, TFun] = map.empty()
  let out = eval_comptime(tm, no_fns, owners, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "std/t", ct_fuel(1000000))
  assert len(out.diags) == 2
  assert out.diags[0].msg == "comptime: Map and Set operations are not available at comptime"
  assert out.diags[1].msg == "comptime: Map and Set operations are not available at comptime"
  assert map.get(out.consts, "M") == None
  assert map.get(out.consts, "S") == None
}

test "lowering invariant panics cross both comptime lowering boundaries" {
  let icx0 = probe_icx()
  match catch_panic(() => fold_expr(icx0, 1000, empty_cache(), XError(3, 4), 3, 4)) {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.message == "lower: XError reached lowering" }
  }

  let bad = test_tfun("bad", [], TyUnit, XError(5, 6))
  let fns = map.insert(icx0.fns, "bad", bad)
  let owner_of = map.insert(icx0.owner_of, "bad", "probe")
  let sigs = map.insert(icx0.prog_fns, ("probe", "bad"), bad.sig)
  let icx = ICx { ..icx0, fns: fns, owner_of: owner_of, prog_fns: sigs }
  let env: Env = map.empty()
  match catch_panic(() => call_named(icx, fresh_st(1000), env, "probe", "bad", [])) {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.message == "lower: XError reached lowering" }
  }
}

test "consts evaluate in declaration order and fold across references" {
  let src = "const A: Int = 1 + 2\n" ++
    "const B: List[Int] = [A, 4]\n" ++
    "const C: String = \"x\" ++ to_string(A)\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(None, None), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(1000000))
  assert len(out.diags) == 0
  assert map.get(out.consts, "A") == Some(VInt(3))
  assert map.get(out.consts, "B") == Some(VList([VInt(3), VInt(4)]))
  assert map.get(out.consts, "C") == Some(VStr("x3"))
}

test "one module's lowering cache outlives the expression that filled it" {
  # `helper` is called from two consts, and each of the last two consts lifts
  # a lambda of its own. Both halves of the cache are read from the run that
  # produced them, because from outside `eval_comptime` neither is visible.
  let src = "fn helper(x: Int) -> Int = x + 1\n" ++
    "const A: Int = helper(1)\n" ++
    "const B: Int = helper(10)\n" ++
    "const C: Int = {\n" ++
    "  let f = (x: Int) => x * 2\n" ++
    "  f(3)\n" ++
    "}\n" ++
    "const D: Int = {\n" ++
    "  let g = (x: Int) => x * 3\n" ++
    "  g(4)\n" ++
    "}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(Some("m"), Some("m.dawn")), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let run = eval_module(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(1000000))
  assert len(run.out.diags) == 0
  assert map.get(run.out.consts, "A") == Some(VInt(2))
  assert map.get(run.out.consts, "B") == Some(VInt(11))
  assert map.get(run.out.consts, "C") == Some(VInt(6))
  assert map.get(run.out.consts, "D") == Some(VInt(12))

  let cached = (k: String) =>
    match map.get(run.cache.fns, k) {
      Some(_) -> true
      None -> false
    }
  # lowered while folding `A`, and still there four expressions later
  assert cached("m.helper")
  # each lifted lambda kept a name of its own. Restarting the counter per
  # expression would file `g` on top of `f` under `m.lambda$0`
  assert cached("m.lambda$0")
  assert cached("m.lambda$1")
  assert run.cache.next_lam == 2
}

test "const initializers run blocks, local fns, matches and loops" {
  let src = "const D: Int = {\n" ++
    "  fn go(n: Int) -> Int = if n == 0 { 0 } else { n + go(n - 1) }\n" ++
    "  go(10)\n" ++
    "}\n" ++
    "const G: Int = match [1, 2, 3] {\n" ++
    "  [x, ..rest] -> x + len(rest) * 10\n" ++
    "  [] -> 0\n" ++
    "}\n" ++
    "const H: Int = {\n" ++
    "  var acc = 0\n" ++
    "  for i in 0 ..5 {\n" ++
    "    if i == 3 { continue }\n" ++
    "    acc = acc + i\n" ++
    "  }\n" ++
    "  acc\n" ++
    "}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(None, None), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(1000000))
  assert len(out.diags) == 0
  assert map.get(out.consts, "D") == Some(VInt(55))
  assert map.get(out.consts, "G") == Some(VInt(21))
  assert map.get(out.consts, "H") == Some(VInt(7))
}

test "a self tail call in a const folds without growing the interpreter stack" {
  # spec §12.4 is a lowering rewrite, so the interpreter inherits it: this
  # would blow past MAX_CALL_DEPTH if the call still built a frame
  let src = "const T: Int = {\n" ++
    "  fn up(i: Int, n: Int) -> Int = if i >= n { i } else { up(i + 1, n) }\n" ++
    "  up(0, 200000)\n" ++
    "}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(None, None), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_default())
  assert len(out.diags) == 0
  assert map.get(out.consts, "T") == Some(VInt(200000))
}

test "comptime failures become diagnostics; blocks in bodies fold" {
  let src = "const E: Int = 1 / 0\n" ++
    "fn f() -> Int = comptime { 6 * 7 }\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(None, None), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(1000000))
  assert len(out.diags) == 1
  assert out.diags[0].msg == "comptime: panicked: Int division by zero"
  assert map.len(out.blocks) == 1
  var vals: List[CValue] = []
  for k in map.keys(out.blocks) {
    vals = vals ++ [map.get(out.blocks, k).expect("block")]
  }
  assert vals == [VInt(42)]
}

test "float folds agree with the backends on signed zero and NaN" {
  # every one of these had (or could have had) a comptime answer that differed
  # from what the emitted program computes: Double.compare puts -0.0 below
  # 0.0, and a negation written as `0.0 - f` loses the sign of zero
  let src = "const A: Bool = comptime { (0.0 - 1.0) * 0.0 < 0.0 }\n" ++
    "const B: Bool = comptime { (0.0 - 1.0) * 0.0 <= 0.0 }\n" ++
    "const C: Bool = comptime { 1.0 / (-0.0) < 0.0 }\n" ++
    "const D: Bool = comptime { let n = 0.0 / 0.0\n  n == n }\n" ++
    "const E: Bool = comptime { let n = 0.0 / 0.0\n  n <= n }\n" ++
    "const F: Bool = comptime { -0.0 == 0.0 }\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(None, None), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(1000000))
  assert len(out.diags) == 0
  assert map.get(out.consts, "A") == Some(VBool(false))
  assert map.get(out.consts, "B") == Some(VBool(true))
  assert map.get(out.consts, "C") == Some(VBool(true))
  assert map.get(out.consts, "D") == Some(VBool(false))
  assert map.get(out.consts, "E") == Some(VBool(false))
  assert map.get(out.consts, "F") == Some(VBool(true))
}

test "`show` is the nested rendering and `to_string` is not" {
  # The one place the two operations differ is a String, and they shared an
  # arm of `call_builtin` until 2026-07-30 -- so comptime answered the
  # top-level form for both, against the contract lower.dawn writes down.
  # Nothing in Core reaches the `show` arm today (Bytes was its only producer
  # and is named now), which is exactly why this is a unit test: no program
  # can put the contract under a differential.
  assert show_value(VStr("a")) == Some("\"a\"")
  assert stringify(VStr("a")) == "a"
  assert show_value(VStr("a\nb\"c")) == Some("\"a\\nb\\\"c\"")
  # the scalars render the same either way -- quoting is the whole difference
  assert show_value(VInt(-3)) == Some("-3")
  assert show_value(VBool(true)) == Some("true")
  # and a value the interpreter cannot identify is a refusal rather than the
  # literal "<value>" the merged arm used to fold in
  assert show_value(VList([VInt(1)])) == None
  assert show_value(VUnit) == None
}

fn ffi_java_src() -> String =
  "use java \"java.lang.Math\"\n" ++
  "const F: Int = unsafe_pure { Math.abs(-5) }\n" ++
  "const S: String = unsafe_pure { Long.toHexString(255) }.expect(\"hex\")\n" ++
  "use java \"java.lang.Long\"\n"

fn nested_ffi_java_src() -> String =
  "use java \"java.lang.Math\"\n" ++
  "fn leaf() -> Int = unsafe_pure { Math.abs(-5) }\n" ++
  "fn outer() -> Int = leaf()\n" ++
  "const F: Int = outer()\n"

# A hand-written signature oracle for the two classes ffi_java_src touches:
# these tests exercise the *comptime* refusal, which only fires after the
# program checks, and checking may not reach for jreflect here — this module
# must stay compilable without a JVM host. That a pure-Dawn stand-in is
# enough to check a `use java` program is the point of the `Jsig` seam.

fn fake_jclass(fqcn: String, simple: String) -> JClass =
  JClass {
    fqcn: fqcn,
    simple: simple,
    display: simple,
    is_interface: false,
    is_primitive: false,
    is_array: false
  }

fn fake_find_class(fqcn: String) -> Option[JClass] !io =
  if fqcn == "java.lang.Math" {
    Some(fake_jclass(fqcn, "Math"))
  } else if fqcn == "java.lang.Long" {
    Some(fake_jclass(fqcn, "Long"))
  } else {
    None
  }

fn fake_class_info(fqcn: String) -> JClass !io =
  match fake_find_class(fqcn) {
    Some(j) -> j
    None -> panic("fake jsig: unknown class " ++ fqcn)
  }

fn fake_methods_of(fqcn: String) -> List[JMethod] !io =
  if fqcn == "java.lang.Math" {
    [JMethod {
      name: "abs",
      param_cls: ["long"],
      ret_cls: "long",
      is_static: true,
      is_varargs: false,
      is_abstract: false,
      desc: "public static long java.lang.Math.abs(long)",
      decl_cls: "java.lang.Math"
    }]
  } else if fqcn == "java.lang.Long" {
    [JMethod {
      name: "toHexString",
      param_cls: ["long"],
      ret_cls: "java.lang.String",
      is_static: true,
      is_varargs: false,
      is_abstract: false,
      desc: "public static java.lang.String java.lang.Long.toHexString(long)",
      decl_cls: "java.lang.Long"
    }]
  } else {
    []
  }

fn fake_jsig() -> Jsig = {
  let base = jsig_refused()
  Jsig {
    ..base,
    on: true,
    find_class: fake_find_class,
    class_info: fake_class_info,
    methods_of: fake_methods_of
  }
}

# the granted-and-folded case lives in jfold's tests: it needs the real
# reflective hook, and this module must stay compilable without one

test "route C reaches only a refusal when no host hook is wired in" {
  # policy said yes (ffi: true), but the default jcall is jcall_refused --
  # the shape a compiler without a JVM host is in
  let (m, pdiags) = parser.parse_module(ffi_java_src())
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  # a std-module fixture: unsafe_pure is std-only (LANG-01 step 1)
  let cx0 = cx_new(Some("std/t"), None)
  let (cx1, tm) = check_module(Cx { ..cx0, jsig: fake_jsig() }, m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m",
    CtOpts { fuel: 1000000, ffi: true, jcall: jcall_refused })
  assert len(out.diags) == 2
  assert str.contains(out.diags[0].msg, "not available in this compiler")
  assert map.get(out.consts, "F") == None
}

test "route C is refused by default, however well vouched the call is" {
  # the same source, and the `unsafe_pure` still type-checks -- purity is the
  # author's claim about the call, not permission to run it in this process
  let (m, pdiags) = parser.parse_module(ffi_java_src())
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  # a std-module fixture: unsafe_pure is std-only (LANG-01 step 1)
  let cx0 = cx_new(Some("std/t"), None)
  let (cx1, tm) = check_module(Cx { ..cx0, jsig: fake_jsig() }, m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(1000000))
  assert len(out.diags) == 2
  assert str.contains(out.diags[0].msg, "compile-time Java calls are disabled")
  assert str.contains(out.diags[0].hint, "--comptime-ffi")
  assert map.get(out.consts, "F") == None
}

test "nested route C refusal keeps its actionable hint before the call chain" {
  let (m, pdiags) = parser.parse_module(nested_ffi_java_src())
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let cx0 = cx_new(Some("std/t"), None)
  let (cx1, tm) = check_module(Cx { ..cx0, jsig: fake_jsig() }, m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "std/t", ct_fuel(1000000))
  assert len(out.diags) == 1
  let hint = out.diags[0].hint
  assert str.starts_with(hint, "folding this would invoke `Math.abs` inside the compiler;")
  assert str.contains(hint, "\n\ncomptime call chain (innermost first):")
  assert str.contains(hint, "at direct `std/t.leaf`")
  assert str.contains(hint, "at direct `std/t.outer`")
}

test "fuel exhaustion becomes a diagnostic" {
  # a loop burns fuel without growing the interpreter's host stack (deep
  # interpreted recursion needs the -Xss512m the real runner passes)
  let src = "const L: Int = {\n" ++
    "  var acc = 0\n" ++
    "  while true { acc = acc + 1 }\n" ++
    "  acc\n" ++
    "}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(cx_new(None, None), m, env)
  assert len(cx1.diags) == 0
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let out = eval_comptime(tm, no_fns, no_owner, no_impls(), set.empty(), cx1.adts,
    cx1.traits, cx1.impl_table, "m", ct_fuel(2000))
  assert len(out.diags) == 1
  assert str.contains(out.diags[0].msg, "fuel exhausted")
}

# The two decoders, `bytes_decode_utf8` and `bytes_decode_latin1` (audit
# RP-04, decision C: the charsets the language promises are two functions, and
# the function name is the domain).
#
# All three phases are done -- the primitives landed, std/bytes moved onto
# them, and the charset-taking `bytes_decode` is gone. This corpus reaches
# them through `stdext/raw.dawn`, the way every std-only primitive is reached
# here, so the two backends are compared on the primitive rather than on
# std's wrapper.
#
# ## The malformed sections
#
# Three families used to be excluded here, because the C walker answered them
# differently from the JVM (#112): it decoded the overlong forms, passed
# surrogate halves through, and emitted one U+FFFD per byte of a truncated
# sequence rather than one for the sequence. `c0 af` came out as `/`, which is
# a path-traversal primitive on any path that decodes before it checks.
#
# They are in now, and they are the point: what a decoder does with input that
# is not what it claims to be is the part of it that has to be pinned. Every
# expectation below is what the JVM prints -- the C side is the one that had
# to move.
use std/char
use std/io
use std/list
use std/bytes
use std/str
use std/raw

fn of(vals: List[Int]) -> Bytes = {
  var b = bytes.buf()
  for v in vals {
    b = bytes.put(b, v)
  }
  bytes.freeze(b)
}

## A decoded string as something a diff can read: its code-point count and the
## UTF-8 of the result. Printing the string itself would put a lone U+FFFD
## through a terminal and a diff on the way to being compared.
fn seen(s: String) -> String = to_string(str.len(s)) ++ " " ++ bytes.to_hex(bytes.utf8(s))

pub fn main() -> Unit !io = {
  io.println("-- valid UTF-8 round trips, astral included --")
  var text = "aA 中文 𝄞 ß"
  io.println(raw.decode_utf8(bytes.utf8(text)))
  io.println("${raw.decode_utf8(bytes.utf8(text)) == text} ${raw.decode_utf8(of([])) == ""}")

  io.println("-- latin1 is one code point per byte, over the whole range --")
  var all = raw.decode_latin1(of(range(0, 256)))
  io.println("${str.len(all)} ${list.map(code_points(all), c => char.code(c)) == range(0, 256)}")
  io.println(seen(raw.decode_latin1(of([0x00, 0x41, 0x7F, 0x80, 0xA9, 0xFF]))))

  io.println("-- the same bytes, two domains: the function name decides --")
  var pound = of([0xC2, 0xA3])
  io.println("${raw.decode_utf8(pound)} ${raw.decode_latin1(pound)}")
  io.println("${str.len(raw.decode_utf8(pound))} ${str.len(raw.decode_latin1(pound))}")

  io.println("-- malformed UTF-8 is replaced, not refused --")
  io.println("lone continuation " ++ seen(raw.decode_utf8(of([0x80]))))
  io.println("truncated 2-byte  " ++ seen(raw.decode_utf8(of([0xC3]))))
  io.println("bad continuation  " ++ seen(raw.decode_utf8(of([0xE4, 0x41, 0xB8]))))
  io.println("never a lead byte " ++ seen(raw.decode_utf8(of([0xFF]))))
  io.println("embedded          " ++ seen(raw.decode_utf8(of([0x61, 0xFF, 0x62]))))

  io.println("-- an overlong form is not the character it encodes --")
  io.println("c0 af             " ++ seen(raw.decode_utf8(of([0xC0, 0xAF]))))
  io.println("c0 80             " ++ seen(raw.decode_utf8(of([0xC0, 0x80]))))
  io.println("e0 80 af          " ++ seen(raw.decode_utf8(of([0xE0, 0x80, 0xAF]))))
  io.println("f0 8f bf bf       " ++ seen(raw.decode_utf8(of([0xF0, 0x8F, 0xBF, 0xBF]))))
  io.println("embedded          " ++ seen(raw.decode_utf8(of([0x61, 0xC0, 0xAF, 0x62]))))

  io.println("-- a surrogate half is not a code point a string may hold --")
  io.println("ed a0 80          " ++ seen(raw.decode_utf8(of([0xED, 0xA0, 0x80]))))
  io.println("ed bf bf          " ++ seen(raw.decode_utf8(of([0xED, 0xBF, 0xBF]))))
  io.println("ed 9f bf (valid)  " ++ seen(raw.decode_utf8(of([0xED, 0x9F, 0xBF]))))

  io.println("-- one replacement per sequence, not per byte --")
  io.println("e2 82 at end      " ++ seen(raw.decode_utf8(of([0xE2, 0x82]))))
  io.println("f0 9f 92 at end   " ++ seen(raw.decode_utf8(of([0xF0, 0x9F, 0x92]))))
  io.println("f0 9f then ascii  " ++ seen(raw.decode_utf8(of([0xF0, 0x9F, 0x61, 0x7A]))))
  io.println("ascii then f0 9f  " ++ seen(raw.decode_utf8(of([0x61, 0xF0, 0x9F, 0x7A]))))

  io.println("-- nothing above U+10FFFF --")
  io.println("f5                " ++ seen(raw.decode_utf8(of([0xF5]))))
  io.println("f5 80 80 80       " ++ seen(raw.decode_utf8(of([0xF5, 0x80, 0x80, 0x80]))))
  io.println("f4 90 80 80       " ++ seen(raw.decode_utf8(of([0xF4, 0x90, 0x80, 0x80]))))
  io.println("f4 8f bf bf (val) " ++ seen(raw.decode_utf8(of([0xF4, 0x8F, 0xBF, 0xBF]))))
}

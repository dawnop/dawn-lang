# Layer 2 for `alloca` (knife T10), the twenty-first of these programs: one
# `!Gpu` program runs each kernel scripts/tile-golden pins under
# `with_gpu_real` against the machine's GPU and under `with_gpu_fake`
# against hand-written host references, and prints what each device
# answered.
#
#   alloca_diff <alloca_scratch.cubin> <alloca_two.cubin> <alloca_ctl.cubin>
#
# WHAT ONLY A DEVICE CAN SAY, and what this program was written to ask:
#
#   * AN AUTOMATIC ALLOCATION IS MEMORY. Every pointer any kernel in this
#     directory held before this one came from a buffer the host allocated
#     (`ptrs`) or from a global the module declared (`get_global`). An
#     `alloca` answers an address nobody outside the launch ever sees, so
#     the only way to ask whether it is real memory is to make the kernel's
#     ANSWER depend on reading back what it wrote there.
#     `alloca_scratch` stores `x + x` through the pointer and adds the
#     input to what it loads back, so it answers `3 * x` while the
#     allocation keeps what was put in it and `x` if the load answered
#     zeros.
#
#   * TWO ALLOCATIONS IN ONE BLOCK ARE TWO REGIONS. `alloca_two` stores `x`
#     into the first and `-x - 1` into the second and answers the
#     difference: `2 * x + 1` while they are apart, and 0 for every lane if
#     they are the same address, because the second store would have
#     overwritten the first. The corpus's `unaliased` count is what makes
#     that a measurement; `run.sh`'s `alloca-aliased` is the mutant.
#
#   * THE `global` UNIT ATTRIBUTE DOES NOT CHANGE THE ANSWER, and that is
#     recorded rather than assumed. `alloca_two`'s second allocation
#     carries it and its first does not, so one kernel holds both states of
#     the flag bit and both answer the reference. What that buys is layer 1
#     for the attribute (`tileiras` takes both) and a named exemption in
#     scripts/tileir-features/attrs.txt, not layer 2.
#
# THE TIER IS EXACT, all three. Every lane is one binary64 `addf` or `subf`
# with `rounding<nearest_even>` over values both sides hold exactly.
#
# THE CONTROL IS A KERNEL. `alloca_ctl` computes `alloca_scratch`'s answer
# with no allocation in it, so its bytecode holds no `alloca` at all: no
# mutant of the allocation may move its bytes or its verdict, and it is
# what tells "the mutant broke alloca" from "the mutant broke the tree".
use std/io
use std/io.{Exit, with_fs_real}
use std/gpu
use std/gpu.{Gpu, with_gpu_fake, with_gpu_real, WideRefFn, last_out,
  alloca_scratch_ref, alloca_two_ref, alloca_ctl_ref }
use std/list
use std/map

## The sentinel every output buffer holds past its answer: a value no
## kernel here computes, so a lane that still has it is a lane nothing
## wrote.
pub const SENTINEL: Float = 0.0 - 12345.678

## The tolerance tier's numbers. Nothing here uses them (every kernel is
## exact tier), and they are kept so that `verdict` reads the same as every
## other program in this directory.
pub const ATOL: Float = 1.0e-5
pub const RTOL: Float = 1.0e-5

## The shape the kernels were recorded with. This must agree with
## scripts/tile-golden/kernels.dawn's ALLOCA_TILE.
pub const ALLOCA_TILE: Int = 128

type Trace = {
  alloc: String,
  upload: String,
  launch: String,
  sync: String,
  download: String,
  result: Option[List[Float]],
  note: String
}

fn kind[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> "ok"
  Err(e) -> e.kind
}

fn message[T](r: Result[T, ForeignError]) -> String = match r {
  Ok(_) -> ""
  Err(e) -> e.message
}

fn blank() -> Trace =
  Trace { alloc: "-", upload: "-", launch: "-", sync: "-", download: "-", result: None, note: "" }

# Allocate and fill one buffer per (format, contents) pair, in order.
# Written as recursion rather than a `for` with `?` in it, for the reason
# gath_diff gives (dawn-lang issue #68).
fn alloc_all(bufs: List[(String, List[Float])], i: Int, acc: List[Int]) -> Result[List[Int], ForeignError] !Gpu =
  if i >= len(bufs) {
    Ok(acc)
  } else {
    let (dt, data) = bufs[i]
    match gpu.gpu_alloc(dt, len(data)) {
      Ok(h) -> alloc_all(bufs, i + 1, acc ++ [h])
      Err(e) -> Err(e)
    }
  }

fn upload_all(hs: List[Int], bufs: List[(String, List[Float])], i: Int) -> Result[Unit, ForeignError] !Gpu =
  if i >= len(hs) {
    Ok(())
  } else {
    let (_dt, data) = bufs[i]
    match gpu.gpu_upload(hs[i], data) {
      Ok(_) -> upload_all(hs, bufs, i + 1)
      Err(e) -> Err(e)
    }
  }

fn release(hs: List[Int]) -> Unit !Gpu = {
  for h in hs {
    let _ = gpu.gpu_free(h)
  }
}

## One kernel over `bufs` (each a format and its initial contents) on a
## `gx` by 1 by 1 grid, one stage at a time, stopping at the first refusal
## and saying which stage it was. The LAST buffer is the output, and the
## one this reads back.
fn stages(kernel: String, gx: Int, bufs: List[(String, List[Float])]) -> Trace !Gpu =
  match alloc_all(bufs, 0, []) {
    Err(e) -> Trace { ..blank(), alloc: e.kind, note: e.message }
    Ok(hs) -> {
      let t0 = Trace { ..blank(), alloc: "ok" }
      match upload_all(hs, bufs, 0) {
        Err(e) -> {
          release(hs)
          Trace { ..t0, upload: e.kind, note: e.message }
        }
        Ok(_) -> {
          let t1 = Trace { ..t0, upload: "ok" }
          match gpu.gpu_launch(kernel, gx, 1, 1, hs) {
            Err(e) -> {
              release(hs)
              Trace { ..t1, launch: e.kind, note: e.message }
            }
            Ok(_) -> {
              let s = gpu.gpu_sync()
              let r = gpu.gpu_download(hs[len(hs) - 1])
              release(hs)
              let value = match r {
                Ok(v) -> Some(v)
                Err(_) -> None
              }
              Trace {
                ..t1,
                launch: "ok",
                sync: kind(s),
                download: kind(r),
                result: value,
                note: message(s) ++ message(r)
              }
            }
          }
        }
      }
    }
  }

## Where the real device stopped, as `<kind>@<stage>`, or "" if it did not.
fn stopped(t: Trace) -> String =
  if t.alloc != "ok" {
    t.alloc ++ "@alloc"
  } else if t.upload != "ok" {
    t.upload ++ "@upload"
  } else if t.launch != "ok" {
    t.launch ++ "@launch"
  } else if t.sync != "ok" {
    t.sync ++ "@sync"
  } else if t.download != "ok" {
    t.download ++ "@download"
  } else {
    ""
  }

# ---- the tier ----

## Whether `got` is within the tolerance tier's distance of `want`, by
## leetgpu's own criterion. A NaN on either side is never within: two NaNs
## are not agreement, they are two failures.
pub fn within(got: Float, want: Float) -> Bool =
  if got != got || want != want {
    false
  } else if got == want {
    true
  } else if got - got != 0.0 || want - want != 0.0 {
    false
  } else {
    let d = if got > want { got - want } else { want - got }
    let m = if want > 0.0 { want } else { 0.0 - want }
    d <= ATOL + RTOL * m
  }

fn all_within(got: List[Float], want: List[Float]) -> Bool =
  len(got) == len(want) && list.all(range(0, len(want)), i => within(got[i], want[i]))

## The largest miss as the tolerance criterion measures it: 1.0 is exactly
## the tolerance, 0.0 is bit-identical.
fn scaled_miss(got: List[Float], want: List[Float]) -> Float =
  list.fold(range(0, len(want)), 0.0, (acc, i) => {
    let a = got[i]
    let b = want[i]
    let d = if a > b { a - b } else { b - a }
    let m = if b > 0.0 { b } else { 0.0 - b }
    let s = d / (ATOL + RTOL * m)
    if s > acc { s } else { acc }
  })

fn pair(real: Trace, fake: Trace) -> Option[(List[Float], List[Float])] =
  match (real.result, fake.result) {
    (Some(a), Some(b)) -> if len(a) == len(b) { Some((a, b)) } else { None }
    _ -> None
  }

fn miss_line(real: Trace, fake: Trace) -> String = match pair(real, fake) {
  Some((a, b)) -> "${scaled_miss(a, b)} (1.0 is exactly the tolerance atol=${ATOL} rtol=${RTOL})"
  None -> "-"
}

fn rendered(o: Option[List[Float]]) -> String = match o {
  Some(v) -> to_string(v)
  None -> "-"
}

## The verdict for one kernel under its tier: `identical:exact` (bit for
## bit), `close:tolerance`, `identical:tolerance` (a tolerance-tier kernel
## that happened to agree bit for bit as well), `differ:result`, or
## `blocked:..`.
fn verdict(tier: String, fake: Trace, real: Trace) -> String = {
  let stop = stopped(real)
  if stop != "" {
    "blocked:" ++ stop
  } else if rendered(real.result) == rendered(fake.result) {
    "identical:" ++ tier
  } else if tier == "exact" {
    "differ:result"
  } else {
    match pair(real, fake) {
      Some((a, b)) -> if all_within(a, b) { "close:tolerance" } else { "differ:result" }
      None -> "differ:result"
    }
  }
}

# ---- the corpus ----

fn sentinel_buffer(n: Int) -> List[Float] = list.map(range(0, n), _i => SENTINEL)

## The input all three kernels read. Every lane is an eighth plus a
## multiple of a quarter, so every sum and difference here is exact in
## binary64 and the tier is exact by the values as well as by the
## operation. The lanes run from -2.625 to 2.875 and take both signs.
##
## NO LANE IS 0 and no lane is -0.5, and both are properties of the offset:
## `0.25 * k + 0.125` is 0 at `k = -0.5` and -0.5 at `k = -2.5`, and `k` is
## an integer. The first is what makes `alloca_scratch`'s `3 * x` differ
## from the `x` a dead scratch would answer; the second is what makes
## `alloca_two`'s `2 * x + 1` differ from the 0 two aliased allocations
## would answer.
fn corpus_x(n: Int) -> List[Float] =
  list.map(range(0, n), i => 0.25 * to_float(i % 23 - 11) + 0.125)

## The lanes of the corpus that matter, counted. run.sh holds every one of
## these above zero, which is what makes the claims above measurements
## rather than sentences.
fn shape_of() -> String = {
  let n = ALLOCA_TILE
  let x = corpus_x(n)
  let idx = range(0, n)
  # lanes where `3 * x` is not `x`: what a scratch that read back zeros,
  # or a store that never landed, needs somewhere to show
  let live = list.filter(idx, i => x[i] + x[i] != 0.0)
  # lanes where `2 * x + 1` is not 0: what alloca-aliased needs
  let unaliased = list.filter(idx, i => x[i] + x[i] + 1.0 != 0.0)
  # lanes where the two allocations hold different values, so that
  # overwriting one with the other is visible at all
  let apart = list.filter(idx, i => x[i] != (0.0 - x[i]) - 1.0)
  "lanes=${n} live=${len(live)} unaliased=${len(unaliased)} apart=${len(apart)}"
}

# ---- the cases ----

## The kernels this program runs, in the order their cubins are given.
fn case_name(i: Int) -> String = ["alloca_scratch", "alloca_two", "alloca_ctl"][i]

## Every kernel here is exact tier, so the list is empty and `tier_of`
## always answers `exact`. It is written out because
## scripts/leetgpu-diff/check.py READS THIS LIST in every program in this
## directory.
pub fn tolerance_tier() -> List[String] = []

fn tier_of(i: Int) -> String =
  if list.any(tolerance_tier(), n => n == case_name(i)) { "tolerance" } else { "exact" }

## Every kernel is one block wide: what is under test is the block's own
## scratch, not the grid.
fn case_grid(_i: Int) -> Int = 1

## The buffers each kernel is handed: a FORMAT and the initial contents, in
## argument order. Every output buffer is LONGER than the answer, so the
## sentinel in its tail says whether a write went past the end.
fn case_bufs(_i: Int) -> List[(String, List[Float])] = {
  let n = ALLOCA_TILE
  [("f64", corpus_x(n)), ("f64", sentinel_buffer(n + 8))]
}

## The reference table the fake device answers with, for one case.
fn case_kernels(i: Int) -> Map[String, (Int, WideRefFn)] = {
  let n = ALLOCA_TILE
  let name = case_name(i)
  if name == "alloca_scratch" {
    map.from([("alloca_scratch", (2, last_out((dts, ins) => alloca_scratch_ref(n, dts, ins))))])
  } else if name == "alloca_two" {
    map.from([("alloca_two", (2, last_out((dts, ins) => alloca_two_ref(n, dts, ins))))])
  } else {
    map.from([("alloca_ctl", (2, last_out((dts, ins) => alloca_ctl_ref(n, dts, ins))))])
  }
}

## A vector as a line: its length, its first lanes and its last ones.
fn digest(v: List[Float]) -> String =
  if len(v) <= 8 {
    to_string(v)
  } else {
    "len=${len(v)} head=${to_string(list.take(v, 3))} tail=${to_string(list.drop(v, len(v) - 3))}"
  }

fn shown(o: Option[List[Float]]) -> String = match o {
  Some(v) -> digest(v)
  None -> "-"
}

fn buffers_of(i: Int) -> String = {
  let bufs = case_bufs(i)
  list.fold(bufs, "", (acc, b) => {
    let (dt, data) = b
    let sep = if acc == "" { "" } else { "," }
    acc ++ sep ++ dt ++ "[" ++ to_string(len(data)) ++ "]"
  })
}

fn read_cubin(path: String) -> Bytes !Exit !io = match with_fs_real(() => io.read_bytes(path)) {
  Ok(b) -> b
  Err(e) -> {
    io.eprintln("alloca_diff: cannot read ${path}: ${e.message}")
    io.exit(2)
    bytes_of_nothing()
  }
}

fn usage() -> Unit !Exit !io = {
  io.eprintln("usage: alloca_diff <alloca_scratch.cubin> <alloca_two.cubin> <alloca_ctl.cubin>")
  io.exit(2)
}

pub fn main() -> Unit !io = io.with_exit_real(() => {
  let paths = args()
  let count = 3
  if len(paths) != count { usage() } else { () }
  var cubins: Map[String, Bytes] = map.empty()
  for i in range(0, count) {
    cubins = map.insert(cubins, case_name(i), read_cubin(paths[i]))
  }
  var all_agreed = true
  var blocked = ""
  var any_differ = false
  var exact_count = 0
  var tolerance_count = 0
  for i in range(0, count) {
    let name = case_name(i)
    let bufs = case_bufs(i)
    let gx = case_grid(i)
    let refs = case_kernels(i)
    let fake = with_gpu_fake(refs, () => stages(name, gx, bufs))
    let real = with_gpu_real(cubins, () => stages(name, gx, bufs))
    let tier = tier_of(i)
    let v = verdict(tier, fake, real)
    io.println("kernel ${name} tier=${tier} bufs=${buffers_of(i)} grid=(${gx}, 1, 1)")
    if name == "alloca_scratch" { io.println("  index ${shape_of()}") } else { () }
    io.println("  fake  launch=${fake.launch} result=${shown(fake.result)}")
    io.println("  real  alloc=${real.alloc} upload=${real.upload} launch=${real.launch}"
        ++ " sync=${real.sync} download=${real.download} result=${shown(real.result)}")
    io.println("  miss  ${miss_line(real, fake)}")
    if real.note != "" { io.println("  note  ${real.note}") } else { () }
    io.println("  verdict ${v}")
    if v == "identical:exact" { exact_count = exact_count + 1 } else { () }
    if v == "close:tolerance" || v == "identical:tolerance" {
      tolerance_count = tolerance_count + 1
    } else {
      ()
    }
    if v != "identical:exact" && v != "close:tolerance" && v != "identical:tolerance" {
      all_agreed = false
    } else {
      ()
    }
    if v == "differ:result" { any_differ = true } else { () }
    if blocked == "" && not any_differ && v != "identical:exact" && v != "close:tolerance"
      && v != "identical:tolerance" {
        blocked = v
      } else {
        ()
      }
  }
  io.println("tiers exact=${exact_count} tolerance=${tolerance_count}")
  if all_agreed {
    io.println("tile-gpu-diff: pass")
  } else if any_differ {
    io.println("tile-gpu-diff: fail")
    io.exit(1)
  } else {
    io.println("tile-gpu-diff: ${blocked}")
  }
})

# `io.exit` is typed Unit, so the branch that cannot continue still owes a
# Bytes; this is never reached.
fn bytes_of_nothing() -> Bytes = panic("unreachable: exit did not exit")

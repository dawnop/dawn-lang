# The cuTile page's call map: every call in flash_attn's source set beside the
# Tile IR lines that call wrote.
#
# Where the pairing comes from, and why nothing here guesses it. Which Tile IR
# line a call wrote is packages/tileir's to say: `trace_calls` keeps the tree
# of the kernel's calls (a call inside a `d_range` or `d_scan` closure is that
# region call's child) and `line_map` carries it to the rendered lines. Where
# each call is in the source is Dawn's parser's to say: `dawn parse` gives
# each call node its span. site/gpu-map/record.py pairs the two strictly and
# records the answer in site/gpu-map/flash_attn.map, and site/build.sh checks
# that recording against a fresh one on every build, so this module reads a
# file and never runs either.
#
# What it does check, because a file can be edited by hand or left behind by
# a kernels.dawn that moved: every call's name is at its name span in the
# text it is shown beside, every span is inside the function and inside its
# parent's, and every Tile IR line is owned exactly once (by the head, the
# tail or one call). A map that fails any of these stops the build.
#
# Rows are source lines, which is what a reader scans. A call's own Tile IR
# goes on the line its name is on; a region call's terminator and closing
# brace go on the line its span ends on, after its body, where the text puts
# them. That is the whole layout rule.
#
# A row starts folded to one line of its Tile IR, its key line, and the rule
# that picks it is computed here, never marked in the recording: of the calls
# named on the row that wrote lines, the outermost (the one no other's span
# holds) is what the source line is for, and the key is the line it wrote
# its result with (the run's last line that is not a closing brace). Why the
# outermost and not an op priority table: in `mul(mmaf(..), lit(..))` the
# line's value is the `mul`, whatever the ops are, and nesting is the
# parser's fact while a priority table would be one more thing to keep in
# step with the backend's opcodes. Why a named call over a region's
# terminator: a line like `addf(u, u))` that also closes a loop is about the
# `addf`; a row that only closes the region (`}`) shows its `continue`. The
# signature's row shows the line opening the entry, its counterpart, and the
# closing brace's the `return`. Folding is the browser's (`<details>`), so
# the page still folds and opens with no script; a click only highlights.

use std/str
use std/list

# ---- the recording ----

## A position in kernels.dawn: line and column, both from 1, columns in code
## points.
pub type Pos = { line: Int, col: Int }

## One call as flash_attn.map records it: its row, its parent's row (-1 at
## the top of the body), its name, its span `[from, to)` and its name's
## `[from, name_to)`, and the Tile IR lines it wrote itself (1-based,
## half-open, its children's left out).
pub type MCall = { id: Int, parent: Int, name: String, from: Pos, to: Pos, name_from: Pos, name_to: Pos, lines: List[(Int, Int)] }

## The whole recording: the kernel, the function's lines in kernels.dawn
## (both included), how many operations it recorded, and who owns each line.
pub type Recorded = {
  name: String,
  first: Int,
  last: Int,
  ops: Int,
  head: List[(Int, Int)],
  calls: List[MCall],
  tail: (Int, Int),
}

fn parse_range(s: String) -> Option[(Int, Int)] =
  match str.split_once(s, "-") {
    Some((a, b)) ->
      match (parse_int(a), parse_int(b)) {
        (Some(x), Some(y)) -> if x <= y { Some((x, y)) } else { None }
        _ -> None
      }
    None -> None
  }

fn parse_pos(s: String) -> Option[Pos] =
  match str.split_once(s, ":") {
    Some((a, b)) ->
      match (parse_int(a), parse_int(b)) {
        (Some(l), Some(c)) -> if l > 0 && c > 0 { Some(Pos { line: l, col: c }) } else { None }
        _ -> None
      }
    None -> None
  }

# `l:c-l:c`
fn parse_span(s: String) -> Option[(Pos, Pos)] =
  match str.split_once(s, "-") {
    Some((a, b)) ->
      match (parse_pos(a), parse_pos(b)) {
        (Some(x), Some(y)) -> if before_or_at(x, y) { Some((x, y)) } else { None }
        _ -> None
      }
    None -> None
  }

fn parse_ranges(toks: List[String]) -> Option[List[(Int, Int)]] = {
  let rs = map(toks, parse_range)
  if list.all(rs, r => r != None) {
    Some(map(rs, r => unwrap_or(r, (0, 0))))
  } else {
    None
  }
}

fn words(s: String) -> List[String] = filter(str.split(s, " "), w => w != "")

## Whether `a` is at or before `b` in the text.
pub fn before_or_at(a: Pos, b: Pos) -> Bool = a.line < b.line || (a.line == b.line && a.col <= b.col)

## flash_attn.map as a `Recorded`. Every line has to be one of the six shapes
## record.py writes, in its order, and every call its row number in turn; a
## line of any other shape is an error rather than a line skipped.
pub fn parse_map(text: String) -> Result[Recorded, String] = {
  var rec = Recorded { name: "", first: 0, last: 0, ops: 0 - 1, head: [], calls: [], tail: (0, 0) }
  var bad = ""
  var n = 0
  for raw in str.split(text, "\n") {
    n = n + 1
    let ws = words(raw)
    let at = n
    let fail = (why: String) => "flash_attn.map line ${at}: ${why}"
    if bad == "" && len(ws) > 0 {
      if ws[0] == "kernel" && len(ws) == 2 && n == 1 {
        rec = Recorded { ..rec, name: ws[1] }
      } else if rec.name == "" {
        bad = fail("the first line is not `kernel <name>`")
      } else if ws[0] == "fn" && len(ws) == 2 {
        match parse_range(ws[1]) {
          Some((a, b)) -> {
            rec = Recorded { ..rec, first: a, last: b }
          }
          None -> {
            bad = fail("`${raw}` is not the function's lines")
          }
        }
      } else if ws[0] == "ops" && len(ws) == 2 {
        rec = Recorded { ..rec, ops: unwrap_or(parse_int(ws[1]), 0 - 1) }
      } else if ws[0] == "head" {
        match parse_ranges(list.drop(ws, 1)) {
          Some(rs) -> {
            rec = Recorded { ..rec, head: rs }
          }
          None -> {
            bad = fail("`${raw}` is not a head")
          }
        }
      } else if ws[0] == "tail" && len(ws) == 2 {
        match parse_range(ws[1]) {
          Some(r) -> {
            rec = Recorded { ..rec, tail: r }
          }
          None -> {
            bad = fail("`${raw}` is not a tail")
          }
        }
      } else if ws[0] == "call" && len(ws) >= 6 {
        match (parse_int(ws[1]), parse_int(ws[2]), parse_span(ws[4]), parse_span(ws[5]), parse_ranges(list.drop(ws, 6))) {
          (Some(id), Some(parent), Some((from, to)), Some((nf, nt)), Some(rs)) -> {
            if id != len(rec.calls) {
              bad = fail("call ${id} is not row ${len(rec.calls)}")
            } else {
              let c = MCall { id: id, parent: parent, name: ws[3], from: from, to: to, name_from: nf, name_to: nt, lines: rs }
              rec = Recorded { ..rec, calls: rec.calls ++ [c] }
            }
          }
          _ -> {
            bad = fail("`${raw}` is not a call")
          }
        }
      } else {
        bad = fail("`${raw}` is none of kernel, fn, ops, head, call or tail")
      }
    }
  }
  if bad != "" {
    Err(bad)
  } else if rec.first == 0 || rec.ops < 0 || rec.tail == (0, 0) || len(rec.head) == 0 {
    Err("flash_attn.map has no fn, ops, head or tail line")
  } else {
    Ok(rec)
  }
}

# ---- the map ----

## One run of Tile IR lines on the page: who wrote it (a call's row, or -1 for
## the head and -2 for the tail) and the lines, 1-based, half-open.
pub type Seg = { owner: Int, ir: (Int, Int) }

## One source line of the kernel (its number in kernels.dawn) and the runs of
## Tile IR shown beside it, in Tile IR order.
pub type Row = { line: Int, segs: List[Seg] }

## The kernel lined up with its Tile IR: its name, the line of kernels.dawn
## its source starts on, both texts as lines, the calls and the rows.
pub type KernelMap = {
  name: String,
  first: Int,
  src: List[String],
  ir: List[String],
  calls: List[MCall],
  rows: List[Row],
  ops: Int,
}

# The owner value of the head's lines and of the tail's.
fn head_owner() -> Int = 0 - 1

fn tail_owner() -> Int = 0 - 2

# The text of `src` (the function's lines, the first being kernels.dawn's
# line `first`) from `a` to `b`, on one line.
fn text_at(src: List[String], first: Int, a: Pos, b: Pos) -> String =
  if a.line != b.line || a.line < first || a.line - first >= len(src) {
    ""
  } else {
    str.slice(src[a.line - first], a.col - 1, b.col - 1)
  }

## `rec` against the function's text (`src`, starting at kernels.dawn's line
## `first`) and its golden (`ir`, one string a line), or why the two do not
## fit.
pub fn check(rec: Recorded, first: Int, src: List[String], ir: List[String]) -> Result[KernelMap, String] = {
  let last = first + len(src) - 1
  let fault = list.find(rec.calls, c => call_fault(rec, first, last, src, c) != "")
  if rec.first != first || rec.last != last {
    Err("the recording is of lines ${rec.first}-${rec.last}, the function is ${first}-${last}: record again")
  } else {
    match fault {
      Some(c) -> Err(call_fault(rec, first, last, src, c))
      None -> {
        let n_ir = len(ir)
        let none: List[(Int, Int)] = []
        let all = rec.head ++ [rec.tail] ++ list.fold(rec.calls, none, (acc, c) => acc ++ c.lines)
        let count = (k: Int) => len(filter(all, r => {
          let (a, b) = r
          a <= k && k < b
        }))
        let outside = filter(all, r => {
          let (a, b) = r
          a < 1 || b > n_ir + 1
        })
        let doubled = list.find(range(1, n_ir + 1), k => count(k) != 1)
        if len(outside) > 0 {
          let (_a, b) = outside[0]
          Err("the recording names line ${b - 1} of a ${n_ir}-line golden")
        } else {
          match doubled {
            Some(k) -> Err("line ${k} of its Tile IR is owned ${count(k)} times")
            None -> Ok(KernelMap {
              name: rec.name,
              first: first,
              src: src,
              ir: ir,
              calls: rec.calls,
              rows: rows_of(rec, first, last),
              ops: rec.ops,
            })
          }
        }
      }
    }
  }
}

# Why call `c` does not fit the text, or "".
fn call_fault(rec: Recorded, first: Int, last: Int, src: List[String], c: MCall) -> String = {
  let inside_fn = c.from.line >= first && c.to.line <= last
  let named = text_at(src, first, c.name_from, c.name_to) == c.name
  let name_inside = before_or_at(c.from, c.name_from) && before_or_at(c.name_to, c.to)
  let parent_ok = c.parent >= 0 - 1 && c.parent < c.id
  let in_parent =
    if c.parent >= 0 && c.parent < c.id {
      let p = rec.calls[c.parent]
      before_or_at(p.from, c.from) && before_or_at(c.to, p.to)
    } else {
      true
    }
  if not inside_fn {
    "call ${c.id} (`${c.name}`) is outside the function"
  } else if not named {
    "call ${c.id} (`${c.name}`): the text at ${c.name_from.line}:${c.name_from.col} is `${text_at(src, first, c.name_from, c.name_to)}`"
  } else if not name_inside {
    "call ${c.id} (`${c.name}`): its name is outside its span"
  } else if not parent_ok {
    "call ${c.id} (`${c.name}`) names row ${c.parent} as its parent"
  } else if not in_parent {
    "call ${c.id} (`${c.name}`) is not inside its parent's span"
  } else {
    ""
  }
}

# The rows: one per source line, each with the runs anchored on it. A call's
# first run is on its name's line; a later run (a region's terminator and
# brace, after its body) on the line its span ends on. The head is on the
# signature's line and the tail on the closing brace's.
fn rows_of(rec: Recorded, first: Int, last: Int) -> List[Row] = {
  var anchored: List[(Int, Seg)] = []
  for r in rec.head {
    anchored = anchored ++ [(first, Seg { owner: head_owner(), ir: r })]
  }
  for c in rec.calls {
    var k = 0
    for r in c.lines {
      let at = if k == 0 { c.name_from.line } else { c.to.line }
      anchored = anchored ++ [(at, Seg { owner: c.id, ir: r })]
      k = k + 1
    }
  }
  anchored = anchored ++ [(last, Seg { owner: tail_owner(), ir: rec.tail })]
  let all = anchored
  map(range(first, last + 1), l => {
    let here = map(filter(all, x => {
      let (at, _s) = x
      at == l
    }), x => {
      let (_at, s) = x
      s
    })
    Row { line: l, segs: sort_by(here, (x, y) => {
      let (a, _b) = x.ir
      let (c, _d) = y.ir
      a - c
    }) }
  })
}

## The Tile IR lines of a run, in order.
pub fn seg_lines(s: Seg) -> List[Int] = {
  let (a, b) = s.ir
  range(a, b)
}

## The line a run is for: its last line that is not a closing brace (a
## region's body is written before the `}` that ends it, and a reduction's
## result is the reshape after its body), or None for a run of braces only.
pub fn result_line(ir: List[String], s: Seg) -> Option[Int] = {
  let real = filter(seg_lines(s), n => not str.starts_with(str.trim(ir[n - 1]), "}"))
  if len(real) == 0 { None } else { Some(real[len(real) - 1]) }
}

# Whether run `s` is call `c`'s first, the one put on its name's line.
fn first_of(calls: List[MCall], s: Seg) -> Bool =
  s.owner >= 0 && len(calls[s.owner].lines) > 0 && calls[s.owner].lines[0] == s.ir

# Of the runs `ss` (all calls'), the one whose call no other's span holds;
# of several such (two statements on one line), the one written last.
fn outermost(calls: List[MCall], ss: List[Seg]) -> Option[Seg] = {
  let inside = (c: MCall, p: MCall) => c.id != p.id && before_or_at(p.from, c.from) && before_or_at(c.to, p.to)
  let outer = filter(ss, s => not list.any(ss, o => inside(calls[s.owner], calls[o.owner])))
  if len(outer) == 0 { None } else { Some(outer[len(outer) - 1]) }
}

## The row's key line: the one Tile IR line a folded row shows. The rule:
## of the calls named on the row that wrote lines, the outermost (the one no
## other's span holds) is what the line is for, and its key is the line it
## wrote its result with (`result_line`). A row that names none but ends a
## region shows the region's terminator by the same rule. The signature's
## row shows the line that opens the entry, and the closing brace's the
## `return`. None when the row has no Tile IR.
pub fn key_line(m: KernelMap, r: Row) -> Option[Int] = {
  let calls = filter(r.segs, s => s.owner >= 0)
  let named = filter(calls, s => first_of(m.calls, s))
  let pick = if len(named) > 0 { outermost(m.calls, named) } else { outermost(m.calls, calls) }
  match pick {
    Some(s) -> result_line(m.ir, s)
    None -> {
      let none: List[Int] = []
      let opens = filter(list.fold(r.segs, none, (acc, s) => acc ++ seg_lines(s)), n => str.ends_with(str.trim_end(m.ir[n - 1]), "{"))
      if len(r.segs) > 0 && r.segs[0].owner == head_owner() && len(opens) > 0 {
        Some(opens[len(opens) - 1])
      } else if len(r.segs) > 0 {
        result_line(m.ir, r.segs[0])
      } else {
        None
      }
    }
  }
}

## How many Tile IR lines the row holds.
pub fn row_lines(r: Row) -> Int = list.fold(r.segs, 0, (n, s) => n + len(seg_lines(s)))

## The rows of `calls` whose span covers `[a, b)` of line `l`, in row order:
## the call the text is in, and every call around it.
pub fn covering(calls: List[MCall], l: Int, a: Int, b: Int) -> List[Int] =
  map(filter(calls, c => before_or_at(c.from, Pos { line: l, col: a }) && before_or_at(Pos { line: l, col: b }, c.to)), c => c.id)

## Where line `l` (`n` code points long) is cut for the calls on it: every
## call's start, end and name end that falls on it, and its two ends, in
## order and once each.
pub fn cuts(calls: List[MCall], l: Int, n: Int) -> List[Int] = {
  var at: List[Int] = [1, n + 1]
  for c in calls {
    for p in [c.from, c.to, c.name_from, c.name_to] {
      if p.line == l && p.col >= 1 && p.col <= n + 1 {
        at = at ++ [p.col]
      }
    }
  }
  list.unique(sort(at))
}

## The call whose name is exactly `[a, b)` of line `l`, if there is one.
pub fn named_at(calls: List[MCall], l: Int, a: Int, b: Int) -> Option[MCall] =
  list.find(calls, c => c.name_from.line == l && c.name_from.col == a && c.name_to.col == b)

# ---- tests ----

fn sample_map() -> String =
  "kernel k\nfn 10-15\nops 6\nhead 1-4\n"
  ++ "call 0 -1 load 11:11-11:32 11:11-11:15 4-12\n"
  ++ "call 1 -1 d_for 12:11-13:26 12:11-12:16 12-13 15-17\n"
  ++ "call 2 1 addf 13:5-13:25 13:5-13:9 13-15\n"
  ++ "call 3 -1 store 14:3-14:20 14:3-14:8 17-20\n"
  ++ "tail 20-23\n"

fn sample_src() -> List[String] =
  [
    "fn k(x: Param[F64]) -> Unit !Dev = {",
    "  let t = load(x, z, [8], s, q)",
    "  let a = d_for(z, o, o, t, (i, u) =>",
    "    addf(F64, [8], u, u))",
    "  store(x, z, a, b)",
    "}",
  ]

fn sample_ir() -> List[String] = map(range(0, 22), k => "line ${k + 1}")

fn must_parse(text: String) -> Recorded = match parse_map(text) {
  Ok(r) -> r
  Err(e) -> panic(e)
}

test "a recording reads back call by call, with its tree and its spans" {
  let r = must_parse(sample_map())
  assert r.name == "k"
  assert (r.first, r.last, r.ops) == (10, 15, 6)
  assert map(r.calls, c => (c.name, c.parent)) == [("load", 0 - 1), ("d_for", 0 - 1), ("addf", 1), ("store", 0 - 1)]
  assert r.calls[1].lines == [(12, 13), (15, 17)]
  assert r.calls[1].to == Pos { line: 13, col: 26 }
}

test "the rows put a call's first run on its name's line and a region's later run where its span ends" {
  match check(must_parse(sample_map()), 10, sample_src(), sample_ir()) {
    Ok(m) -> {
      assert map(m.rows, r => r.line) == [10, 11, 12, 13, 14, 15]
      assert map(m.rows, r => map(r.segs, s => s.owner)) == [[0 - 1], [0], [1], [2, 1], [3], [0 - 2]]
      assert m.rows[3].segs[1].ir == (15, 17)
    }
    Err(e) -> panic(e)
  }
}

## The negative controls: a name that is not at its span, a child outside its
## parent, a line owned twice, a function that moved and a golden that is
## shorter are each refused.
test "a recording that does not fit the text is refused, not drawn" {
  let src = sample_src()
  let ir = sample_ir()
  let shifted = str.replace(sample_map(), "11:11-11:15", "11:12-11:16")
  match check(must_parse(shifted), 10, src, ir) {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "the text at 11:12 is `oad(`") }
  }
  let escaped = str.replace(sample_map(), "call 2 1 addf 13:5-13:25", "call 2 1 addf 13:5-14:2")
  match check(must_parse(escaped), 10, src, ir) {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "not inside its parent") }
  }
  let doubled = str.replace(sample_map(), " 13-15\n", " 12-15\n")
  match check(must_parse(doubled), 10, src, ir) {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "line 12 of its Tile IR is owned 2 times") }
  }
  match check(must_parse(sample_map()), 11, src, ir) {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "record again") }
  }
  match check(must_parse(sample_map()), 10, src, list.take(ir, 21)) {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "names line 22 of a 21-line golden") }
  }
}

test "a map line of any other shape is an error" {
  match parse_map("kernel k\nfn 10-14\ncall 0 -1 load 11:11 11:11-11:15 4-12\n") {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "line 3") }
  }
  match parse_map("head 1-4\n") {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "not `kernel <name>`") }
  }
  match parse_map(str.replace(sample_map(), "call 2 1", "call 7 1")) {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.contains(e, "call 7 is not row 2") }
  }
}

test "a line is cut where the calls on it start, end and name themselves" {
  let r = must_parse(sample_map())
  assert cuts(r.calls, 13, 25) == [1, 5, 9, 25, 26]
  assert covering(r.calls, 13, 5, 9) == [1, 2]
  assert covering(r.calls, 11, 1, 11) == []
  match named_at(r.calls, 13, 5, 9) {
    Some(c) -> { assert c.name == "addf" }
    None -> { assert false }
  }
}

# A second kernel for the key line: a call inside another on one line, a
# region whose head, body and terminator are all on one line, a line whose
# only call wrote nothing, and Tile IR with the braces the rule skips.
fn nested_map() -> String =
  "kernel k\nfn 30-34\nops 5\nhead 1-3\n"
  ++ "call 0 -1 mmaf 31:15-31:25 31:15-31:19 3-5\n"
  ++ "call 1 -1 lit 31:27-31:35 31:27-31:30\n"
  ++ "call 2 -1 mul 31:11-31:36 31:11-31:14 5-7\n"
  ++ "call 3 -1 d_for 32:3-32:36 32:3-32:8 7-9 10-12\n"
  ++ "call 4 3 addf 32:25-32:35 32:25-32:29 9-10\n"
  ++ "call 5 -1 set 33:3-33:11 33:5-33:8\n"
  ++ "tail 12-15\n"

fn nested_src() -> List[String] =
  [
    "fn k(x: Param[F64]) -> Unit !Dev = {",
    "  let a = mul(mmaf(t, u), lit(2.0))",
    "  d_for(z, o, (i, u) => addf(u, u))",
    "  m.set(a)",
    "}",
  ]

fn nested_ir() -> List[String] =
  [
    "module {",
    "  entry @k() {",
    "    %0 = constant",
    "    %1 = mmaf %0",
    "    %2 = constant",
    "    %3 = mulf %1, %2",
    "    %4 = constant",
    "    %5 = for %i in (%4) {",
    "      %6 = addf %i, %i",
    "      continue %6",
    "    }",
    "    return",
    "  }",
    "}",
  ]

fn keys_of(m: KernelMap) -> List[Option[Int]] = map(m.rows, r => key_line(m, r))

## The key line is computed, and each wrong rule it could be mistaken for
## picks a different line somewhere here: the innermost call (`mmaf`, `addf`),
## the run written last (`continue`), a region's terminator over the call
## named on its row, or the head's `make_token`-like last line.
test "a folded row shows the line its outermost named call wrote its result with" {
  match check(must_parse(nested_map()), 30, nested_src(), nested_ir()) {
    Ok(m) -> {
      assert keys_of(m) == [Some(2), Some(6), Some(8), None, Some(12)]
      assert map(m.rows, r => row_lines(r)) == [2, 4, 5, 0, 3]
    }
    Err(e) -> panic(e)
  }
  let ir = map(range(0, 22), k => if k == 1 { "  entry {" } else if k == 15 { "}" } else { "line ${k + 1}" })
  match check(must_parse(sample_map()), 10, sample_src(), ir) {
    Ok(m) -> {
      # line 13 names `addf` and ends `d_for`: the call named wins over the
      # terminator; a run of braces only has no result line
      assert keys_of(m) == [Some(2), Some(11), Some(12), Some(14), Some(19), Some(22)]
      assert map(m.rows, r => row_lines(r)) == [3, 8, 1, 4, 3, 3]
      assert result_line(ir, m.rows[3].segs[1]) == Some(15)
      assert result_line(ir, Seg { owner: 1, ir: (16, 17) }) == None
    }
    Err(e) -> panic(e)
  }
}

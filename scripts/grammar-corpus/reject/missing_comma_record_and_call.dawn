# expect: expected `,` or `}`, found `y`
# expect: expected `,` or `)`, found `2`
# A missing comma inside a literal is reported where the comma belongs and the
# parse carries on as if it were there (#190), so the second slip on the next
# line -- inside an interpolation, in a call -- is found too, and nothing is
# reported at module top level. Before, the record's error ended the statement
# at the literal's own `}`, the block took that brace for its end, and the rest
# of the body fell out to the top level.
type P = { x: Int, y: Int }
fn f(a: Int, b: Int, c: Int) -> Int = a + b + c
pub fn main() -> Unit !io = {
  let p = P { x: 1 y: 2 }
  println("${f(1 2, 3)}")
}

#!/bin/sh
# dawn CLI launcher: the self-hosted toolchain, seeded from the previous
# release (M8 phase 5 — the Kotlin implementation is archived at the
# kotlin-final tag). In a repo checkout the standalone jar under build/ is
# rebuilt whenever any of its build inputs changed (see the v2 generation
# stamp below); outside one (the playground server rsyncs bin/ + build/) it
# just runs the shipped jar.
set -e

# Resolve symlinks (e.g. ~/.local/bin/dawn) so ROOT is the real repo checkout.
#
# Hop by hop rather than `readlink -f`: BSD readlink, which is what macOS ships,
# has no -f, so the one-liner failed on the exact platform the JAVA_HOME probe
# below goes out of its way to support. `readlink` with no options plus cd/pwd
# -P is portable, and handles a relative link target (the common case for a
# hand-made ~/.local/bin symlink).
SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in
    /*) SELF=$link ;;
    *) SELF=$(dirname "$SELF")/$link ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"

# if JAVA_HOME is unset, try GraalVM under ~/tools. Both layouts: macOS bundles
# the JDK under Contents/Home, Linux tarballs put bin/ at the top level.
if [ -z "$JAVA_HOME" ]; then
  for d in "$HOME"/tools/graalvm-*/Contents/Home "$HOME"/tools/graalvm-*; do
    if [ -x "$d/bin/java" ]; then
      JAVA_HOME="$d"
      export JAVA_HOME
      break
    fi
  done
fi
JAVA=java
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA="$JAVA_HOME/bin/java"
fi

SJAR="$ROOT/build/dawn-selfhost.jar"
STD="$ROOT/std"

# Heap: pinned, not left to JVM ergonomics. With no -Xmx the ceiling is
# MaxRAMPercentage=25% of the HOST's RAM, which makes "how much memory does a
# build need" a property of the machine instead of a property of the workload.
# Measured 2026-08-05: the same build got a 3.79 GiB ceiling on a 16 GiB box
# and 5.87 GiB on a 24 GiB one -- the latter is 98% of the 6 GiB cgroup builds
# run in here, leaving ~160 MiB for metaspace, code cache and the 512m stacks.
# UseContainerSupport is on but does NOT see that cgroup: MaxHeapSize measured
# identical inside and outside it, so the cgroup is not a backstop either.
#
# 2g is roughly 10x what a full selfhost build needs. Measured on 57 files /
# 54,179 lines: it completes at -Xmx192m with 577 MB peak RSS, and peak RSS
# tracks the ceiling rather than the workload (1.89 GiB at the default ceiling,
# 1.24 GiB at 2g, 829 MB at 768m) -- a smaller heap was also consistently
# faster. Deliberately not pinned near that floor: a limit set where it barely
# passes goes red on the next corpus growth, and reads as a compiler bug.
# Override for the genuinely heavy scripts, e.g. DAWN_JVM_OPTS="-Xss512m -Xmx6g".
#
# Collector: SerialGC, because a compile's resident set is almost entirely
# space G1 touched and never handed back. Measured on hello-world, where the
# live set never exceeds 15 MB: G1 still expands the young generation
# 10M -> 30M -> 90M -> 270M -> 810M, and ~99.9% of the resulting 466 MB RSS is
# fixed cost that does not scale with the input.
#
# End to end, peak RSS across the process tree, GraalVM CE 21.0.2, three runs
# each (2026-08-17): `run fib` 532 -> 390 MB, `check selfhost` 1365 -> 614 MB,
# `test selfhost` 1239 -> 610 MB. Wall time is inside the spread on all three.
# The win grows with input, so there is no size at which the old default would
# have been the better one. None of it comes from the -Xmx propagation added to
# the child spawns in the same change: with that alone `run fib` measures
# 525 MB and `check selfhost` 1327 MB, i.e. unmoved. A ceiling bounds how much
# a run may take, it does not reduce how much it does take.
#
# Two flags looked plausible here and are deliberately absent.
# -XX:TieredStopAtLevel=1 costs ~10% wall at selfhost scale and its
# interaction with the -Xss/MAX_CALL_DEPTH boundary below is unverified;
# -XX:MaxNewSize=64m on top of SerialGC measured inside the spread.
#
# This list is duplicated twice and all three copies must move together:
# child_java_cmd() in selfhost/src/main.dawn configures the JVMs the driver
# re-execs into, and scripts/selfhost-bench.py forks the release jar directly
# without going through this script, so a flag missing there means the recorded
# baseline measures a configuration nobody runs.
DAWN_JVM_OPTS="${DAWN_JVM_OPTS:--Xss512m -Xmx2g -XX:+UseSerialGC}"

# deployed form: no sources, no seed resolver — run the shipped jar as-is
if [ ! -f "$ROOT/scripts/seedjar.sh" ]; then
  if [ ! -f "$SJAR" ]; then
    echo "error: $SJAR not found (deployments must ship build/dawn-selfhost.jar)" >&2
    exit 2
  fi
  exec "$JAVA" $DAWN_JVM_OPTS -jar "$SJAR" "$@"
fi

. "$ROOT/scripts/seedjar.sh"

# What the jar was built from, as a content hash rather than a timestamp.
#
# `find -newer "$SJAR"` was the old test, and mtime does not answer the question
# it was asked. A fresh clone, a tarball extract, a `git checkout` of an older
# branch, a restored backup or a copied build/ all produce sources that are
# *older* than a jar built from different code — and then every later command
# silently runs a stale compiler. That failure is invisible: the toolchain works,
# it is simply not the one the sources describe.
#
# The hash covers the inputs the build reads -- the Planner's recursive
# source-input manifest plus `write_static_records` below, and getting that
# list wrong is the same failure in a different place -- so it changes exactly
# when the output should. It is recomputed before every exec, not only before a
# rebuild, so the cost lands on each `bin/dawn` call: ~3MB framed and hashed,
# ~0.16s of shell. That is why the stream below is assembled in bulk -- the
# per-file loop it replaced cost 0.69s a call and took CI over its timeout.
STAMP="$ROOT/build/dawn-selfhost.stamp"
INPUTS="$ROOT/build/dawn-selfhost.inputs"

if command -v sha256sum >/dev/null 2>&1; then
  SHA256_KIND=sha256sum
elif command -v shasum >/dev/null 2>&1; then
  SHA256_KIND=shasum
else
  echo "error: no sha256sum or shasum on PATH" >&2
  exit 1
fi

is_sha256_digest() {
  [ "${#1}" -eq 64 ] || return 1
  case $1 in
    *[!0-9a-f]*) return 1 ;;
  esac
}

# Every hasher invocation is checked directly. Piping through cut or awk would
# hide a failed hasher behind the parser's successful exit status.
sha256() {
  sha_output=$(mktemp "${TMPDIR:-/tmp}/dawn-sha256.XXXXXX") || return 1
  case $SHA256_KIND in
    sha256sum)
      if ! sha256sum > "$sha_output"; then
        rm -f "$sha_output"
        echo "error: sha256sum failed" >&2
        return 1
      fi
      ;;
    shasum)
      if ! shasum -a 256 > "$sha_output"; then
        rm -f "$sha_output"
        echo "error: shasum failed" >&2
        return 1
      fi
      ;;
    *)
      rm -f "$sha_output"
      echo "error: internal SHA-256 tool selection failure" >&2
      return 1
      ;;
  esac

  sha_last=$(tail -c 1 "$sha_output") || {
    rm -f "$sha_output"
    echo "error: cannot read SHA-256 output" >&2
    return 1
  }
  if [ -n "$sha_last" ]; then
    rm -f "$sha_output"
    echo "error: SHA-256 output is not newline-terminated" >&2
    return 1
  fi
  if ! IFS= read -r sha_line < "$sha_output"; then
    rm -f "$sha_output"
    echo "error: SHA-256 output is empty" >&2
    return 1
  fi
  if sed -n '2p' "$sha_output" | grep . >/dev/null 2>&1 ||
      [ "$(wc -l < "$sha_output" | tr -d ' ')" -ne 1 ]; then
    rm -f "$sha_output"
    echo "error: SHA-256 output is not a single line" >&2
    return 1
  fi
  rm -f "$sha_output"

  case $sha_line in
    *'  -') sha_digest=${sha_line%'  -'} ;;
    *)
      echo "error: malformed SHA-256 tool output" >&2
      return 1
      ;;
  esac
  if ! is_sha256_digest "$sha_digest"; then
    echo "error: SHA-256 output is not a lowercase 64-hex digest" >&2
    return 1
  fi
  printf '%s\n' "$sha_digest"
}

sha256_file() {
  if [ -L "$1" ] || [ ! -f "$1" ]; then
    echo "error: SHA-256 input is not a regular non-symbolic-link file: $1" >&2
    return 1
  fi
  sha256 < "$1"
}

sha_known=$(printf 'abc' | sha256) || exit 1
if [ "$sha_known" != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" ]; then
  echo "error: SHA-256 tool failed the abc known-vector check" >&2
  exit 1
fi

# Keep the sourced seed resolver under the same strict status/shape contract.
seed_sha_of() { sha256_file "$1"; }
seed_sha_stdin() { sha256; }

append_text_frame() {
  frame_output=$1
  frame_value=$2
  frame_size=$(LC_ALL=C printf '%s' "$frame_value" | wc -c | tr -d '[:space:]') || return 1
  case $frame_size in
    ''|*[!0-9]*) return 1 ;;
  esac
  printf '%s:%s' "$frame_size" "$frame_value" >> "$frame_output"
}

append_file_frame() {
  frame_output=$1
  frame_input=$2
  frame_size=$(LC_ALL=C wc -c < "$frame_input" | tr -d '[:space:]') || return 1
  case $frame_size in
    ''|*[!0-9]*) return 1 ;;
  esac
  printf '%s:' "$frame_size" >> "$frame_output" || return 1
  cat "$frame_input" >> "$frame_output"
}

write_inputs_stream() {
  inputs_manifest=$1
  inputs_stream=$2
  : > "$inputs_stream" || return 1
  append_text_frame "$inputs_stream" "dawn-inputs-digest-v2" || return 1
  append_text_frame "$inputs_stream" "manifest" || return 1
  append_file_frame "$inputs_stream" "$inputs_manifest"
}

write_manifest_records() (
  manifest_file=$1
  records_file=$2
  tab=$(printf '\t')
  record_count=0
  : > "$records_file" || exit 1
  last_byte=$(tail -c 1 "$manifest_file") || {
    echo "error: cannot read source input manifest" >&2
    exit 1
  }
  if [ -n "$last_byte" ]; then
    echo "error: source input manifest record is not newline-terminated" >&2
    exit 1
  fi
  exec 3< "$manifest_file" || exit 1
  if ! IFS= read -r header <&3; then
    echo "error: source input manifest is empty" >&2
    exit 1
  fi
  if [ "$header" != "dawn-source-inputs-v1" ]; then
    echo "error: invalid source input manifest header" >&2
    exit 1
  fi
  while IFS= read -r record || [ -n "$record" ]; do
    if [ -z "$record" ]; then
      echo "error: malformed source input manifest record" >&2
      exit 1
    fi
    case $record in
      *"$tab"*) scope=${record%%"$tab"*}; rest=${record#*"$tab"} ;;
      *)
        echo "error: malformed source input manifest record" >&2
        exit 1
        ;;
    esac
    case $rest in
      *"$tab"*) kind=${rest%%"$tab"*}; path=${rest#*"$tab"} ;;
      *)
        echo "error: malformed source input manifest record" >&2
        exit 1
        ;;
    esac
    case $kind in
      F|O|T) ;;
      *)
        echo "error: unknown source input manifest kind: $kind" >&2
        exit 1
        ;;
    esac
    case $scope in
      R)
        case $path in
          ''|.|/*|./*|../*|*/.|*/./*|..|*/..|*/../*|*//*|*/)
            echo "error: invalid repo-relative source input path" >&2
            exit 1
            ;;
        esac
        ;;
      A)
        case $path in
          /) ;;
          /*)
            case $path in
              *//*|*/.|*/./*|*/..|*/../*|*/)
                echo "error: non-canonical absolute source input path" >&2
                exit 1
                ;;
            esac
            ;;
          *)
            echo "error: invalid absolute source input path" >&2
            exit 1
            ;;
        esac
        ;;
      *)
        echo "error: unknown source input manifest scope: $scope" >&2
        exit 1
        ;;
    esac
    printf '%s\n' "$record" >> "$records_file" || exit 1
    record_count=$((record_count + 1))
  done <&3
  exec 3<&-
  if [ "$record_count" -eq 0 ]; then
    echo "error: source input manifest has no records" >&2
    exit 1
  fi
)

# The recipe half of "everything the built jar is a function of": the Planner
# manifest covers the source graph, and these records cover what surrounds it.
# dawn.lock pins the resolved [java-deps] closure, seed-checksums.txt decides
# which seed is trusted, seedjar.sh resolves it, and this script is the recipe
# -- change any of them and the jar that comes out is a different jar, or
# should have been. Withdrawing trust from a seed used not to trigger a
# rebuild at all.
write_static_records() {
  printf 'R\tT\tstd\n'
  printf 'R\tF\tscripts/seed-release.txt\n'
  printf 'R\tF\tscripts/seed-checksums.txt\n'
  printf 'R\tF\tscripts/seed-std-checksums.txt\n'
  printf 'R\tF\tscripts/seedjar.sh\n'
  printf 'R\tF\tbin/dawn\n'
}

path_has_symlink_component() {
  symlink_path=$1
  [ "$symlink_path" != "/" ] || return 1
  symlink_rest=${symlink_path#/}
  symlink_current=
  while [ -n "$symlink_rest" ]; do
    case $symlink_rest in
      */*)
        symlink_part=${symlink_rest%%/*}
        symlink_rest=${symlink_rest#*/}
        ;;
      *)
        symlink_part=$symlink_rest
        symlink_rest=
        ;;
    esac
    # empty parts are what a doubled or trailing slash leaves behind
    [ -n "$symlink_part" ] || continue
    symlink_current=$symlink_current/$symlink_part
    if [ -L "$symlink_current" ]; then
      return 0
    fi
  done
  return 1
}

index_tree() {
  tree_root=$1
  tree_leaves=$2
  tree_problem=$3
  : > "$tree_leaves" || return 1
  : > "$tree_problem" || return 1
  if ! find "$tree_root" -exec sh -c '
    root=$1
    leaves=$2
    problem=$3
    shift 3
    for entry do
      case $entry in
        *"
"*)
          printf "%s\n" "tree entry contains a newline" > "$problem"
          exit 1
          ;;
      esac
      if [ -L "$entry" ]; then
        printf "%s\n" "tree contains a symbolic link: $entry" > "$problem"
        exit 1
      fi
      if [ -d "$entry" ]; then
        continue
      fi
      if [ ! -f "$entry" ]; then
        printf "%s\n" "tree contains a non-regular entry: $entry" > "$problem"
        exit 1
      fi
      case $root in
        /) relative=${entry#/} ;;
        *) relative=${entry#"$root"/} ;;
      esac
      if [ "$relative" = "$entry" ] || [ -z "$relative" ]; then
        printf "%s\n" "tree traversal escaped its root: $entry" > "$problem"
        exit 1
      fi
      printf "%s\n" "$relative" >> "$leaves" || exit 1
    done
  ' dawn-tree "$tree_root" "$tree_leaves" "$tree_problem" {} +; then
    if [ -s "$tree_problem" ]; then
      sed -n '1p' "$tree_problem" >&2
    else
      echo "error: cannot traverse source input tree: $tree_root" >&2
    fi
    return 1
  fi
  if [ -s "$tree_problem" ]; then
    sed -n '1p' "$tree_problem" >&2
    return 1
  fi
}

write_source_stream() (
  source_manifest=$1
  source_stream=$2
  source_work=$3

  # The stream is assembled, not dribbled out: one pass validates the records
  # and collects every file whose bytes belong in it, a single `wc -c` measures
  # all of them, and a second pass writes the frame headers into staging chunks
  # that one `cat` interleaves with the sources. Byte for byte the same stream
  # -- same frames, same order, same length prefixes -- for a handful of
  # processes instead of ten per input file. This runs before every exec and
  # not only before a build, and CI runs it thousands of times, so the constant
  # is the whole cost of the check.
  #
  # C collation was already required for the sorts below; pinning the subshell
  # to it also makes ${#value} count bytes, which is what a frame header must
  # measure. A shell that does not follow the assignment keeps the old per-frame
  # `wc -c`, so the probe buys speed and never a wrong length. LC_ALL stays in
  # this subshell: the compiler runs in the caller's locale.
  LC_ALL=C
  export LC_ALL
  frame_len_kind=external
  frame_len_probe=$(printf '\303\251') || exit 1
  if [ "${#frame_len_probe}" -eq 2 ]; then
    frame_len_kind=shell
  fi

  parts=$(mktemp -d "$source_work/parts.XXXXXX") || exit 1
  trap 'rm -rf "$parts"' 0
  trap 'exit 1' 1 2 15
  records=$parts/records
  merged=$parts/merged
  sorted=$parts/sorted
  problem=$parts/problem
  sizes=$parts/sizes

  frame_len() {
    case $frame_len_kind in
      shell) frame_len_value=${#1} ;;
      *)
        frame_len_value=$(printf '%s' "$1" | wc -c | tr -d '[:space:]') || return 1
        case $frame_len_value in
          ''|*[!0-9]*) return 1 ;;
        esac
        ;;
    esac
  }

  # Frame headers accumulate in a variable and reach the stream through a
  # staging chunk, one per spliced file plus a final tail.
  frame_text=
  chunk_serial=0
  stream_size=0
  emit_frame() {
    frame_len "$1" || exit 1
    frame_text=$frame_text$frame_len_value:$1
  }
  splice_file() {
    splice_size=$1
    chunk_serial=$((chunk_serial + 1))
    chunk_file=$parts/chunk.$chunk_serial
    frame_len "$frame_text$splice_size:" || exit 1
    stream_size=$((stream_size + frame_len_value + splice_size))
    printf '%s%s:' "$frame_text" "$splice_size" > "$chunk_file" || exit 1
    frame_text=
  }
  # The measurements come back in the order the collection pass listed the
  # files, and the emitting pass walks the same records in the same order.
  size_count=0
  next_size() {
    # shellcheck disable=SC2034 # the second field is the path wc echoed back
    if ! read -r frame_size size_path <&4; then
      echo "error: cannot read the measured source input sizes" >&2
      exit 1
    fi
    case $frame_size in
      ''|*[!0-9]*)
        echo "error: malformed source input size measurement" >&2
        exit 1
        ;;
    esac
    size_count=$((size_count + 1))
  }

  if ! write_manifest_records "$source_manifest" "$records"; then
    exit 1
  fi
  if ! cat "$records" > "$merged" || ! write_static_records >> "$merged"; then
    echo "error: cannot merge source input records" >&2
    exit 1
  fi
  if ! LC_ALL=C sort "$merged" > "$sorted"; then
    echo "error: cannot sort source input records" >&2
    exit 1
  fi

  tab=$(printf '\t')
  set --
  record_index=0
  while IFS= read -r record || [ -n "$record" ]; do
    record_index=$((record_index + 1))
    scope=${record%%"$tab"*}
    rest=${record#*"$tab"}
    kind=${rest%%"$tab"*}
    path=${rest#*"$tab"}
    case $scope in
      R) absolute=$ROOT/$path ;;
      A) absolute=$path ;;
      *)
        echo "error: unknown source input scope while hashing: $scope" >&2
        exit 1
        ;;
    esac
    if path_has_symlink_component "$absolute"; then
      echo "error: source input has a symbolic-link path component: $absolute" >&2
      exit 1
    fi
    case $kind in
      F)
        if [ -L "$absolute" ] || [ ! -f "$absolute" ]; then
          echo "error: required source input is not a regular non-symbolic-link file: $absolute" >&2
          exit 1
        fi
        set -- "$@" "$absolute"
        ;;
      O)
        if [ -L "$absolute" ]; then
          echo "error: optional source input is a symbolic link: $absolute" >&2
          exit 1
        fi
        if [ -e "$absolute" ]; then
          if [ ! -f "$absolute" ]; then
            echo "error: optional source input is not a regular file: $absolute" >&2
            exit 1
          fi
          set -- "$@" "$absolute"
        fi
        ;;
      T)
        if [ -L "$absolute" ] || [ ! -d "$absolute" ]; then
          echo "error: required source input is not a non-symbolic-link directory tree: $absolute" >&2
          exit 1
        fi
        if ! index_tree "$absolute" "$parts/leaves.$record_index" "$problem"; then
          exit 1
        fi
        if ! LC_ALL=C sort "$parts/leaves.$record_index" > "$parts/tree.$record_index"; then
          echo "error: cannot sort source input tree: $absolute" >&2
          exit 1
        fi
        while IFS= read -r leaf || [ -n "$leaf" ]; do
          case $absolute in
            /) leaf_file=/$leaf ;;
            *) leaf_file=$absolute/$leaf ;;
          esac
          if [ -L "$leaf_file" ] || [ ! -f "$leaf_file" ]; then
            echo "error: source input tree entry changed type before it could be read: $leaf_file" >&2
            exit 1
          fi
          set -- "$@" "$leaf_file"
        done < "$parts/tree.$record_index"
        ;;
      *)
        echo "error: unknown source input kind while hashing: $kind" >&2
        exit 1
        ;;
    esac
  done < "$sorted"

  # One measurement of every source, in stream order. The per-file loop used to
  # snapshot each file and measure the snapshot; here the total is checked
  # against the assembled stream instead, so a source that changes size while
  # the launcher reads it still cannot produce a length prefix that disagrees
  # with the bytes it counts -- it stops the run.
  content_count=$#
  : > "$sizes" || exit 1
  if [ "$content_count" -gt 0 ] && ! wc -c "$@" > "$sizes"; then
    echo "error: cannot measure the source inputs" >&2
    exit 1
  fi

  # Scopes and kinds were checked above; this pass only lays out the bytes.
  set --
  record_index=0
  exec 4< "$sizes" || exit 1
  emit_frame "dawn-source-digest-v2"
  while IFS= read -r record || [ -n "$record" ]; do
    record_index=$((record_index + 1))
    scope=${record%%"$tab"*}
    rest=${record#*"$tab"}
    kind=${rest%%"$tab"*}
    path=${rest#*"$tab"}
    case $scope in
      R) absolute=$ROOT/$path ;;
      *) absolute=$path ;;
    esac

    emit_frame "record"
    emit_frame "$scope"
    emit_frame "$kind"
    emit_frame "$path"
    case $kind in
      F)
        next_size
        emit_frame "present-file"
        splice_file "$frame_size"
        set -- "$@" "$chunk_file" "$absolute"
        ;;
      O)
        if [ ! -e "$absolute" ]; then
          emit_frame "missing-file"
        else
          next_size
          emit_frame "present-file"
          splice_file "$frame_size"
          set -- "$@" "$chunk_file" "$absolute"
        fi
        ;;
      T)
        emit_frame "tree-root"
        emit_frame "$path"
        if [ ! -s "$parts/tree.$record_index" ]; then
          emit_frame "empty-tree"
        fi
        while IFS= read -r leaf || [ -n "$leaf" ]; do
          case $absolute in
            /) leaf_file=/$leaf ;;
            *) leaf_file=$absolute/$leaf ;;
          esac
          next_size
          emit_frame "tree-leaf"
          emit_frame "$leaf"
          splice_file "$frame_size"
          set -- "$@" "$chunk_file" "$leaf_file"
        done < "$parts/tree.$record_index"
        ;;
    esac
    emit_frame "record-end"
  done < "$sorted"
  exec 4<&-

  if [ "$size_count" -ne "$content_count" ]; then
    echo "error: the source input set changed while it was being read" >&2
    exit 1
  fi

  chunk_serial=$((chunk_serial + 1))
  chunk_file=$parts/chunk.$chunk_serial
  frame_len "$frame_text" || exit 1
  stream_size=$((stream_size + frame_len_value))
  printf '%s' "$frame_text" > "$chunk_file" || exit 1
  set -- "$@" "$chunk_file"

  if ! cat "$@" > "$source_stream"; then
    echo "error: cannot assemble the source input stream" >&2
    exit 1
  fi
  stream_written=$(LC_ALL=C wc -c < "$source_stream" | tr -d '[:space:]') || exit 1
  case $stream_written in
    ''|*[!0-9]*)
      echo "error: cannot measure the source input stream" >&2
      exit 1
      ;;
  esac
  if [ "$stream_written" -ne "$stream_size" ]; then
    echo "error: source input bytes changed while they were being read" >&2
    exit 1
  fi
)

compute_manifest_digests() {
  digest_manifest=$1
  digest_tag=$2
  DIGEST_SOURCE_STREAM="$ATTEMPT_DIR/$digest_tag.source"
  DIGEST_INPUTS_STREAM="$ATTEMPT_DIR/$digest_tag.inputs"
  if ! write_source_stream "$digest_manifest" "$DIGEST_SOURCE_STREAM" "$ATTEMPT_DIR"; then
    return 1
  fi
  if ! write_inputs_stream "$digest_manifest" "$DIGEST_INPUTS_STREAM"; then
    return 1
  fi
  DIGEST_SOURCE=$(sha256_file "$DIGEST_SOURCE_STREAM") || return 1
  DIGEST_INPUTS=$(sha256_file "$DIGEST_INPUTS_STREAM") || return 1
}

compute_bootstrap_digest() {
  bootstrap_stream="$ATTEMPT_DIR/bootstrap.stream"
  bootstrap_snapshot="$ATTEMPT_DIR/bootstrap.jar"
  if [ -L "$SEED" ] || [ ! -f "$SEED" ]; then
    echo "error: bootstrap seed is not a regular non-symbolic-link file: $SEED" >&2
    return 1
  fi
  if ! cat "$SEED" > "$bootstrap_snapshot"; then
    echo "error: cannot read bootstrap seed: $SEED" >&2
    return 1
  fi
  : > "$bootstrap_stream" || return 1
  append_text_frame "$bootstrap_stream" "dawn-bootstrap-digest-v2" || return 1
  if [ -n "${DAWN_SEED:-}" ]; then
    append_text_frame "$bootstrap_stream" "override" || return 1
  else
    append_text_frame "$bootstrap_stream" "default" || return 1
  fi
  append_text_frame "$bootstrap_stream" "seed-jar" || return 1
  append_file_frame "$bootstrap_stream" "$bootstrap_snapshot" || return 1
  sha256_file "$bootstrap_stream"
}

read_stamp() {
  stamp_file=$1
  if [ -L "$stamp_file" ] || [ ! -f "$stamp_file" ]; then
    return 1
  fi
  stamp_last=$(tail -c 1 "$stamp_file") || return 1
  [ -z "$stamp_last" ] || return 1
  {
    IFS= read -r stamp_header || return 1
    IFS= read -r stamp_source_line || return 1
    IFS= read -r stamp_bootstrap_line || return 1
    IFS= read -r stamp_inputs_line || return 1
    IFS= read -r stamp_jar_line || return 1
    # shellcheck disable=SC2034 # the sixth read only detects trailing lines
    if IFS= read -r stamp_extra; then
      return 1
    fi
  } < "$stamp_file"
  [ "$stamp_header" = "dawn-selfhost-stamp-v2" ] || return 1
  case $stamp_source_line in source=*) PARSED_SOURCE=${stamp_source_line#source=} ;; *) return 1 ;; esac
  case $stamp_bootstrap_line in bootstrap=*) PARSED_BOOTSTRAP=${stamp_bootstrap_line#bootstrap=} ;; *) return 1 ;; esac
  case $stamp_inputs_line in inputs=*) PARSED_INPUTS=${stamp_inputs_line#inputs=} ;; *) return 1 ;; esac
  case $stamp_jar_line in jar=*) PARSED_JAR=${stamp_jar_line#jar=} ;; *) return 1 ;; esac
  is_sha256_digest "$PARSED_SOURCE" || return 1
  is_sha256_digest "$PARSED_BOOTSTRAP" || return 1
  is_sha256_digest "$PARSED_INPUTS" || return 1
  is_sha256_digest "$PARSED_JAR" || return 1
}

validate_cache_full() {
  if [ -L "$SJAR" ] || [ ! -f "$SJAR" ] ||
      [ -L "$INPUTS" ] || [ ! -f "$INPUTS" ] ||
      [ -L "$STAMP" ] || [ ! -f "$STAMP" ]; then
    return 1
  fi
  if ! read_stamp "$STAMP"; then
    return 1
  fi
  cache_source=$PARSED_SOURCE
  cache_bootstrap=$PARSED_BOOTSTRAP
  cache_inputs=$PARSED_INPUTS
  cache_jar=$PARSED_JAR

  cache_records="$ATTEMPT_DIR/cache.records"
  if ! write_manifest_records "$INPUTS" "$cache_records" >/dev/null 2>&1; then
    return 1
  fi
  if ! cache_bootstrap_now=$(compute_bootstrap_digest); then
    return 2
  fi
  if ! compute_manifest_digests "$INPUTS" cache; then
    return 2
  fi
  cache_source_now=$DIGEST_SOURCE
  cache_inputs_now=$DIGEST_INPUTS
  if ! cache_jar_now=$(sha256_file "$SJAR"); then
    return 2
  fi
  if ! read_stamp "$STAMP"; then
    return 1
  fi
  if [ "$PARSED_SOURCE" != "$cache_source" ] ||
      [ "$PARSED_BOOTSTRAP" != "$cache_bootstrap" ] ||
      [ "$PARSED_INPUTS" != "$cache_inputs" ] ||
      [ "$PARSED_JAR" != "$cache_jar" ]; then
    return 1
  fi
  if [ "$cache_source_now" != "$cache_source" ] ||
      [ "$cache_bootstrap_now" != "$cache_bootstrap" ] ||
      [ "$cache_inputs_now" != "$cache_inputs" ] ||
      [ "$cache_jar_now" != "$cache_jar" ]; then
    return 1
  fi
  LOCKED_SOURCE=$cache_source
  LOCKED_BOOTSTRAP=$cache_bootstrap
  LOCKED_INPUTS=$cache_inputs
  LOCKED_JAR=$cache_jar
}

write_locked_stamp() {
  printf 'dawn-selfhost-stamp-v2\n'
  printf 'source=%s\n' "$LOCKED_SOURCE"
  printf 'bootstrap=%s\n' "$LOCKED_BOOTSTRAP"
  printf 'inputs=%s\n' "$LOCKED_INPUTS"
  printf 'jar=%s\n' "$LOCKED_JAR"
}

cache_pair_matches_locked() {
  if ! read_stamp "$STAMP"; then
    return 1
  fi
  pair_source=$PARSED_SOURCE
  pair_bootstrap=$PARSED_BOOTSTRAP
  pair_inputs=$PARSED_INPUTS
  pair_jar=$PARSED_JAR
  if [ "$pair_source" != "$LOCKED_SOURCE" ] ||
      [ "$pair_bootstrap" != "$LOCKED_BOOTSTRAP" ] ||
      [ "$pair_inputs" != "$LOCKED_INPUTS" ] ||
      [ "$pair_jar" != "$LOCKED_JAR" ]; then
    return 1
  fi
  pair_inputs_stream=$(mktemp "${TMPDIR:-/tmp}/dawn-pair-inputs.XXXXXX") || return 1
  if ! write_inputs_stream "$INPUTS" "$pair_inputs_stream"; then
    rm -f "$pair_inputs_stream"
    return 1
  fi
  pair_inputs_now=$(sha256_file "$pair_inputs_stream") || {
    rm -f "$pair_inputs_stream"
    return 1
  }
  rm -f "$pair_inputs_stream"
  pair_jar_now=$(sha256_file "$SJAR") || return 1
  if [ "$pair_inputs_now" != "$LOCKED_INPUTS" ] ||
      [ "$pair_jar_now" != "$LOCKED_JAR" ]; then
    return 1
  fi
  if ! read_stamp "$STAMP"; then
    return 1
  fi
  [ "$PARSED_SOURCE" = "$LOCKED_SOURCE" ] &&
    [ "$PARSED_BOOTSTRAP" = "$LOCKED_BOOTSTRAP" ] &&
    [ "$PARSED_INPUTS" = "$LOCKED_INPUTS" ] &&
    [ "$PARSED_JAR" = "$LOCKED_JAR" ]
}

produce_manifest() {
  producer_jar=$1
  producer_output=$2
  if ! "$JAVA" $DAWN_JVM_OPTS -jar "$producer_jar" \
      __source-inputs --base "$ROOT" "$ROOT/selfhost" > "$producer_output"; then
    echo "error: bootstrap compiler failed to produce source input manifest" >&2
    return 1
  fi
  if [ ! -s "$producer_output" ]; then
    echo "error: bootstrap compiler produced an empty source input manifest" >&2
    return 1
  fi
}

build_generation() {
  build_bootstrap_before=$(compute_bootstrap_digest) || return 1
  TXN=$(mktemp -d "$ROOT/build/.dawn-selfhost.XXXXXX") || {
    echo "error: cannot create selfhost staging directory" >&2
    return 1
  }
  stage1="$TXN/dawn-selfhost.stage1.jar"
  candidate="$TXN/dawn-selfhost.candidate.jar"
  inputs_pre="$TXN/inputs.pre"
  inputs_post="$TXN/inputs.post"
  stamp_candidate="$TXN/stamp"

  echo "dawn: rebuilding the selfhost toolchain (sources changed)..." >&2
  SEED_STD=$(seed_std_dir) || return 1
  if ! "$JAVA" $DAWN_JVM_OPTS -jar "$SEED" build "$ROOT/selfhost" -o "$stage1" \
      --std "$SEED_STD" \
      --vendor org/objectweb/asm --vendor coursierapi > /dev/null; then
    echo "error: bootstrap seed failed to build stage1" >&2
    return 1
  fi
  if ! produce_manifest "$stage1" "$inputs_pre"; then
    return 1
  fi
  if ! compute_manifest_digests "$inputs_pre" pre; then
    return 1
  fi
  pre_source=$DIGEST_SOURCE
  pre_inputs=$DIGEST_INPUTS
  pre_stream=$DIGEST_SOURCE_STREAM

  if ! "$JAVA" $DAWN_JVM_OPTS -jar "$stage1" build "$ROOT/selfhost" -o "$candidate" \
      --std "$STD" \
      --vendor org/objectweb/asm --vendor coursierapi > /dev/null; then
    echo "error: stage1 failed to build the selfhost candidate" >&2
    return 1
  fi
  if ! produce_manifest "$candidate" "$inputs_post"; then
    return 1
  fi
  if ! compute_manifest_digests "$inputs_post" post; then
    return 1
  fi
  post_source=$DIGEST_SOURCE
  post_inputs=$DIGEST_INPUTS
  post_stream=$DIGEST_SOURCE_STREAM

  if ! cmp -s "$inputs_pre" "$inputs_post" ||
      ! cmp -s "$pre_stream" "$post_stream" ||
      [ "$pre_inputs" != "$post_inputs" ] ||
      [ "$pre_source" != "$post_source" ]; then
    echo "error: bootstrap inputs changed during build" >&2
    return 1
  fi
  build_bootstrap_after=$(compute_bootstrap_digest) || return 1
  if [ "$build_bootstrap_before" != "$build_bootstrap_after" ]; then
    echo "error: bootstrap seed changed during build" >&2
    return 1
  fi
  candidate_jar=$(sha256_file "$candidate") || return 1

  {
    printf 'dawn-selfhost-stamp-v2\n'
    printf 'source=%s\n' "$post_source"
    printf 'bootstrap=%s\n' "$build_bootstrap_after"
    printf 'inputs=%s\n' "$post_inputs"
    printf 'jar=%s\n' "$candidate_jar"
  } > "$stamp_candidate" || return 1

  if ! mv "$candidate" "$SJAR"; then
    echo "error: cannot promote selfhost candidate jar" >&2
    return 1
  fi
  if ! mv "$inputs_post" "$INPUTS"; then
    echo "error: cannot promote selfhost input manifest" >&2
    return 1
  fi
  if ! mv "$stamp_candidate" "$STAMP"; then
    echo "error: cannot commit selfhost generation marker" >&2
    return 1
  fi
}

cleanup_attempt() {
  if [ -n "${TXN:-}" ]; then
    rm -rf "$TXN"
    TXN=
  fi
  if [ -n "${ATTEMPT_DIR:-}" ]; then
    rm -rf "$ATTEMPT_DIR"
    ATTEMPT_DIR=
  fi
}

ATTEMPT_DIR=
TXN=
trap cleanup_attempt 0
trap 'exit 1' 1 2 15
mkdir -p "$ROOT/build"
if ! SEED=$(seed_jar); then
  echo "error: cannot resolve bootstrap seed" >&2
  exit 1
fi

launcher_attempt=0
launcher_ready=0
while [ "$launcher_attempt" -le 2 ]; do
  ATTEMPT_DIR=$(mktemp -d "${TMPDIR:-/tmp}/dawn-launcher.XXXXXX") || {
    echo "error: cannot create launcher validation directory" >&2
    exit 1
  }
  cache_status=0
  if validate_cache_full; then
    cache_status=0
  else
    cache_status=$?
  fi
  if [ "$cache_status" -eq 2 ]; then
    exit 1
  fi
  if [ "$cache_status" -ne 0 ]; then
    if ! build_generation; then
      exit 1
    fi
    cache_status=0
    if validate_cache_full; then
      cache_status=0
    else
      cache_status=$?
    fi
    if [ "$cache_status" -eq 2 ]; then
      exit 1
    fi
    if [ "$cache_status" -ne 0 ]; then
      cleanup_attempt
      launcher_attempt=$((launcher_attempt + 1))
      continue
    fi
  fi

  cleanup_attempt
  if cache_pair_matches_locked; then
    launcher_ready=1
    break
  fi
  launcher_attempt=$((launcher_attempt + 1))
done

if [ "$launcher_ready" -ne 1 ]; then
  echo "error: selfhost cache generation did not stabilize after two retries" >&2
  exit 1
fi

if [ -n "${DAWN_PRINT_STAMP:-}" ]; then
  write_locked_stamp
  exit 0
fi

exec "$JAVA" $DAWN_JVM_OPTS -jar "$SJAR" "$@"

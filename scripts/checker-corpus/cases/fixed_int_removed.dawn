# The bitwise traits replace these exports completely; resurrecting any
# compatibility entry must change this diagnostic corpus.
use std/int/i8
use std/int/i16
use std/int/i32
use std/int/u8
use std/int/u16
use std/int/u32
use std/int/u64
fn removed_i8_and() -> i8.I8 = i8.and(i8.wrap(1), i8.wrap(2))
fn removed_i8_or() -> i8.I8 = i8.or(i8.wrap(1), i8.wrap(2))
fn removed_i8_xor() -> i8.I8 = i8.xor(i8.wrap(1), i8.wrap(2))
fn removed_i8_complement() -> i8.I8 = i8.complement(i8.wrap(1))
fn removed_i8_shl() -> i8.I8 = i8.shl(i8.wrap(1), 1)
fn removed_i8_shr() -> i8.I8 = i8.shr(i8.wrap(1), 1)
fn removed_i16_and() -> i16.I16 = i16.and(i16.wrap(1), i16.wrap(2))
fn removed_i16_or() -> i16.I16 = i16.or(i16.wrap(1), i16.wrap(2))
fn removed_i16_xor() -> i16.I16 = i16.xor(i16.wrap(1), i16.wrap(2))
fn removed_i16_complement() -> i16.I16 = i16.complement(i16.wrap(1))
fn removed_i16_shl() -> i16.I16 = i16.shl(i16.wrap(1), 1)
fn removed_i16_shr() -> i16.I16 = i16.shr(i16.wrap(1), 1)
fn removed_i32_and() -> i32.I32 = i32.and(i32.wrap(1), i32.wrap(2))
fn removed_i32_or() -> i32.I32 = i32.or(i32.wrap(1), i32.wrap(2))
fn removed_i32_xor() -> i32.I32 = i32.xor(i32.wrap(1), i32.wrap(2))
fn removed_i32_complement() -> i32.I32 = i32.complement(i32.wrap(1))
fn removed_i32_shl() -> i32.I32 = i32.shl(i32.wrap(1), 1)
fn removed_i32_shr() -> i32.I32 = i32.shr(i32.wrap(1), 1)
fn removed_u8_and() -> u8.U8 = u8.and(u8.wrap(1), u8.wrap(2))
fn removed_u8_or() -> u8.U8 = u8.or(u8.wrap(1), u8.wrap(2))
fn removed_u8_xor() -> u8.U8 = u8.xor(u8.wrap(1), u8.wrap(2))
fn removed_u8_complement() -> u8.U8 = u8.complement(u8.wrap(1))
fn removed_u8_shl() -> u8.U8 = u8.shl(u8.wrap(1), 1)
fn removed_u8_shr() -> u8.U8 = u8.shr(u8.wrap(1), 1)
fn removed_u16_and() -> u16.U16 = u16.and(u16.wrap(1), u16.wrap(2))
fn removed_u16_or() -> u16.U16 = u16.or(u16.wrap(1), u16.wrap(2))
fn removed_u16_xor() -> u16.U16 = u16.xor(u16.wrap(1), u16.wrap(2))
fn removed_u16_complement() -> u16.U16 = u16.complement(u16.wrap(1))
fn removed_u16_shl() -> u16.U16 = u16.shl(u16.wrap(1), 1)
fn removed_u16_shr() -> u16.U16 = u16.shr(u16.wrap(1), 1)
fn removed_u32_and() -> u32.U32 = u32.and(u32.wrap(1), u32.wrap(2))
fn removed_u32_or() -> u32.U32 = u32.or(u32.wrap(1), u32.wrap(2))
fn removed_u32_xor() -> u32.U32 = u32.xor(u32.wrap(1), u32.wrap(2))
fn removed_u32_complement() -> u32.U32 = u32.complement(u32.wrap(1))
fn removed_u32_shl() -> u32.U32 = u32.shl(u32.wrap(1), 1)
fn removed_u32_shr() -> u32.U32 = u32.shr(u32.wrap(1), 1)
fn removed_u64_and() -> u64.U64 = u64.and(u64.wrap(1), u64.wrap(2))
fn removed_u64_or() -> u64.U64 = u64.or(u64.wrap(1), u64.wrap(2))
fn removed_u64_xor() -> u64.U64 = u64.xor(u64.wrap(1), u64.wrap(2))
fn removed_u64_complement() -> u64.U64 = u64.complement(u64.wrap(1))
fn removed_u64_shl() -> u64.U64 = u64.shl(u64.wrap(1), 1)

# EBNF type_params: the `!e` item, an explicit binder for an effect variable
# (docs/effect-params-design.md decision 3). Optional everywhere -- every one of
# these functions is legal with the brackets left off, and means the same thing
# (decision 2) -- so what this file pins is only that the spelling parses.

fn bound_alone[!e](f: fn() -> Int !e) -> Int !e = f()

fn after_types[T, U, !e](xs: List[T], f: fn(T) -> U !e) -> List[U] !e = map(xs, f)

fn several[!a, !b](f: fn() -> Int !a, g: fn() -> Int !b) -> Int !(a | b) = f() + g()

fn beside_a_bound[T: Show, !e](x: T, f: fn(T) -> String !e) -> String !e = f(x)

# a binder and the implicit introduction of spec §6.3 in one signature: `b` has
# no binder and is introduced where it appears
fn mixed[!a](f: fn() -> Int !a, g: fn() -> Int !b) -> Int !(a | b) = f() + g()

# the binder need not be used, and the brackets need not be written
fn unused[!e](x: Int) -> Int = x

fn implicit(f: fn() -> Int !e) -> Int !e = f()

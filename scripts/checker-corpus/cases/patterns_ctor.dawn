# checker.dawn: constructor patterns
pub type Shape = Dot | Line(a: Int, b: Int)

type Other = Blob

pub fn wrong_adt(s: Shape) -> Int =
  match s {
    Blob -> 1
    _ -> 2
  }

pub fn unknown(s: Shape) -> Int =
  match s {
    Nope -> 1
    _ -> 2
  }

pub fn bare_with_fields(s: Shape) -> Int =
  match s {
    Line -> 1
    _ -> 2
  }

pub fn bad_field(s: Shape) -> Int =
  match s {
    Line { z: q } -> q
    _ -> 2
  }

pub fn positional_after_named(s: Shape) -> Int =
  match s {
    Line(a: p, q) -> p
    _ -> 2
  }

pub fn twice(s: Shape) -> Int =
  match s {
    Line { a: p, a: q } -> p
    _ -> 2
  }

pub fn wrong_arity(s: Shape) -> Int =
  match s {
    Line(p, q, r) -> p
    _ -> 2
  }

pub fn missing_fields(s: Shape) -> Int =
  match s {
    Line { a: p } -> p
    _ -> 2
  }

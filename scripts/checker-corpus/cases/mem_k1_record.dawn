# Known-bad acceptance baseline for #847, not a positive test.
# See docs/mem-capture-scope-design.md section 8 for the required rejection.
use std/mem
use std/mem.{Mem}
type Source[@s] = { read: fn(Int) -> Int !Mem[s] }
type Holder[@s] = { buffer: I64Buf@s }
fn source() !io = mem.with_mem([@s] () => {
  let cursor = mem.new(1)
  let held: Holder[s] = Holder { buffer = cursor }
  let result: Source[s] = Source { read = n => mem.with_mem([@inner] () => {
    let offset = mem.at(held.buffer, 0)
    mem.set(held.buffer, 0, offset + n)
    offset
  }) }
  result
})

pub fn main() -> Unit !io = {
  let s = source()
  println(to_string(s.read(1)))
  println(to_string(s.read(1)))
}

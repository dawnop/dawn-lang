-- Eq forwarded to a scalar (prelude impl) --
same(3, 3)      : yes
same(3, 4)      : no
same("a", "a")  : yes
same(true, true): yes
-- Eq forwarded to a user impl --
same(Money(5), Money(5)): yes
same(Money(5), Money(6)): no
-- Eq forwarded with no impl (structural) --
same(Key(1), Key(1)): yes
same(Key(1), Key(2)): no
-- Hash forwarded --
digest(Money(9)) == 9: yes
digest(7) == digest(7): yes
-- Ord forwarded --
bigger(3, 9) == 9      : yes
bigger("a", "c") == "c": yes

# A session must reuse actual bodies after the module prefix breaks, while
# replacing its bounded current generation and preserving the cold Program.
#
# A module of the compiler package because checker state is `pub(pkg)`; it
# moved here from scripts/incremental-semantics-contract/src. Nothing in
# main.dawn or nmain.dawn imports contract/, so `dawn test selfhost` runs it
# and neither driver links it.
use std/io
use std/str
use driver/incremental
use driver/analyze.{LoadedModule, LoadResult, LocDiag, analyze_program}
use driver/stdlib.{load_std, std_load_error_text}
use driver/checkdump
use check/jsig.{jsig_refused, refused_probe}
use ir/interp.{ct_default}
use jvm/jreflect.{jsig_real, query_probe}
use front/parser
use compiler_plan/envmem

fn source(name: String, text: String) -> LoadedModule = {
  let (syntax, diagnostics) = parser.parse_module(text)
  LoadedModule { mod_path: name, class_name: name, path: name ++ ".dawn",
    text: text, m: syntax, pdiags: diagnostics, pkg: None, entry: false }
}

test "session body cache revalidates after prefix divergence and replaces generations" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic(std_load_error_text(e))
    }
    let a = source("a", "pub fn value() -> Int = 1\n")
    let b = source("b", "use a\nfn same() -> Int = a.value()\nfn unrelated() -> Int = 3\n")
    let loaded = LoadResult { modules: [a, b], diags: [] }
    let first = incremental.analyze(incremental.new_with_body_cache(std, ct_default(),
      jsig_refused(), refused_probe, 10, 10000, 20), loaded)
    assert first.stats.checked_bodies == 3 && first.stats.reused_bodies == 0
    assert first.stats.retained_body_products == 3 && first.stats.retained_body_modules == 2
    assert first.stats.retained_total_modules == 4
    let whole = incremental.analyze(first.session, loaded)
    assert whole.stats.reused_modules == 2 && whole.stats.checked_modules == 0
    assert whole.stats.visited_bodies == 0 && whole.stats.reused_bodies == 0
    assert whole.stats.retained_body_products == 3
    let changed = source("a", "pub fn value() -> Int = 9\n")
    let edited = LoadResult { modules: [changed, b], diags: [] }
    let second = incremental.analyze(whole.session, edited)
    assert second.stats.reused_modules == 0 && second.stats.checked_modules == 2
    assert second.stats.checked_bodies == 1 && second.stats.reused_bodies == 2
    assert second.stats.unobserved_modules == 0 && second.stats.visited_bodies == 3
    assert second.stats.comptime_modules == 2
    let bool_a = source("a", "pub fn value() -> Bool = true\n")
    let bool_b = source("b", "use a\nfn same() -> Bool = a.value()\nfn unrelated() -> Int = 3\n")
    let type_change = LoadResult { modules: [bool_a, bool_b], diags: [] }
    let third = incremental.analyze(second.session, type_change)
    assert third.stats.checked_bodies == 2 && third.stats.reused_bodies == 1
    let moved_a = source("a", "# moved\npub fn value() -> Bool = true\n")
    let moved = LoadResult { modules: [moved_a, bool_b], diags: [] }
    let fourth = incremental.analyze(third.session, moved)
    assert fourth.stats.checked_bodies == 0 && fourth.stats.reused_bodies == 3
    for pair in [(loaded, first), (loaded, whole), (edited, second), (type_change, third), (moved, fourth)] {
      let (input, result) = pair
      let cold = analyze_program(input, std, ct_default(), jsig_refused())
      assert result.program.diags == cold.diags
      assert checkdump.render(result.program) == checkdump.render(cold)
      assert result.program.decl_spans == cold.decl_spans
      var index = 0
      for m in result.program.modules {
        assert m.tm == cold.modules[index].tm && m.ct == cold.modules[index].ct
        index = index + 1
      }
    }
    let deleted = incremental.analyze(fourth.session, LoadResult { modules: [moved_a], diags: [] })
    assert deleted.stats.retained_body_modules == 1 && deleted.stats.retained_body_products == 1
    let restored = incremental.analyze(deleted.session, moved)
    assert restored.stats.reused_modules == 1 && restored.stats.reused_bodies == 0
    assert restored.stats.checked_bodies == 2
    let evicted = incremental.analyze(incremental.evict(fourth.session), moved)
    assert evicted.stats.reused_modules == 0 && evicted.stats.reused_bodies == 0
    assert evicted.stats.checked_bodies == 3
    let disabled = incremental.analyze(incremental.disable_reuse(fourth.session), moved)
    assert disabled.stats.reused_modules == 0 && disabled.stats.reused_bodies == 0
    assert disabled.stats.unobserved_modules == 2 && disabled.stats.retained_total_modules == 0
    assert checkdump.render(disabled.program) == checkdump.render(evicted.program)
    let still_disabled = incremental.analyze(disabled.session, edited)
    assert still_disabled.stats.retained_total_modules == 0
    assert still_disabled.stats.reused_modules == 0 && still_disabled.stats.reused_bodies == 0
    assert still_disabled.stats.unobserved_modules == 2
    assert checkdump.render(still_disabled.program) ==
      checkdump.render(analyze_program(edited, std, ct_default(), jsig_refused()))
  }))
}

test "session body cache shares capacity with prefix representations" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic(std_load_error_text(e))
    }
    let raw = source("budget", "fn first() -> Int = 1\nfn second() -> Int = 2\n")
    let loaded = LoadResult { modules: [raw], diags: [] }
    let units = str.len(raw.text)
    for limits in [(0, 10000, 20, 0, 0), (10, 0, 20, 0, 0), (10, units * 2, 0, 1, 0),
      (1, units * 2, 2, 1, 1), (2, units, 2, 1, 1), (2, units * 2, 2, 2, 1),
      (2, units * 2, 1, 1, 0), (2, units - 1, 2, 0, 0)] {
      let (modules, text, products, expected_total, expected_bodies) = limits
      let result = incremental.analyze(incremental.new_with_body_cache(std, ct_default(),
        jsig_refused(), refused_probe, modules, text, products), loaded)
      assert result.stats.retained_total_modules == expected_total
      assert result.stats.retained_body_modules == expected_bodies
      assert result.stats.retained_total_modules <= modules
      assert result.stats.retained_total_text_units <= text
      assert result.stats.retained_body_products <= products
      assert result.stats.retained_total_text_units == units * expected_total
      let next = incremental.analyze(result.session, loaded)
      assert next.stats.retained_total_modules == expected_total
      assert next.stats.retained_body_products <= products
      assert checkdump.render(next.program) == checkdump.render(result.program)
    }
    for limits in [(-1, 100, 2), (2, -1, 2), (2, 100, -1)] {
      let (modules, text, products) = limits
      let result = catch_panic(() => {
        let _ = incremental.new_with_body_cache(std, ct_default(), jsig_refused(), refused_probe, modules, text, products)
        ()
      })
      assert match result { Err(_) -> true, Ok(_) -> false }
    }
    let large = source("large", "fn a() -> Int = 1\nfn b() -> Int = 2\nfn c() -> Int = 3\n")
    let small = source("small", "fn a() -> Int = 1\n")
    let competing = LoadResult { modules: [large, small], diags: [] }
    let owner = incremental.new_with_body_cache(std, ct_default(), jsig_refused(), refused_probe, 2, 10000, 2)
    let first = incremental.analyze(owner, competing)
    assert first.stats.retained_modules == 1 && first.stats.retained_body_modules == 1
    assert first.stats.retained_total_modules == 2 && first.stats.retained_body_products == 1
    assert first.stats.retained_total_text_units == str.len(large.text) + str.len(small.text)
    let second = incremental.analyze(first.session, competing)
    assert second.stats.reused_modules == 1 && second.stats.reused_bodies == 1
    assert second.stats.checked_bodies == 0
    let reordered = LoadResult { modules: [small, large], diags: [] }
    let moved = incremental.analyze(second.session, reordered)
    assert moved.stats.reused_modules == 0 && moved.stats.reused_bodies == 1
    assert moved.stats.checked_bodies == 3
    let cold = analyze_program(reordered, std, ct_default(), jsig_refused())
    assert moved.program.decl_spans == cold.decl_spans
    assert checkdump.render(moved.program) == checkdump.render(cold)
    assert moved.program.modules[0].tm == cold.modules[0].tm
    assert moved.program.modules[1].tm == cold.modules[1].tm
    # Multiple admitted modules must charge earlier body and prefix entries
    # before either representation can retain another module.
    let one = source("one", "fn value() -> Int = 1\n")
    let two = source("two", one.text)
    let three = source("three", one.text)
    let repeated = LoadResult { modules: [one, two, three], diags: [] }
    let charge = str.len(one.text)
    for limits in [(2, 10000, 2), (10, charge * 3, 3)] {
      let (modules, text, expected) = limits
      let result = incremental.analyze(incremental.new_with_body_cache(std, ct_default(),
        jsig_refused(), refused_probe, modules, text, 20), repeated)
      assert result.stats.retained_total_modules == expected
      assert result.stats.retained_total_text_units == expected * charge
      assert result.stats.retained_total_modules <= modules
      assert result.stats.retained_total_text_units <= text
    }
  }))
}

test "session body cache respects Java barriers and nonparse error recovery" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic(std_load_error_text(e))
    }
    let a = source("a", "pub fn value() -> Int = 1\n")
    let b = source("b", "pub fn other() -> Int = 2\n")
    let pure = LoadResult { modules: [a, b], diags: [] }
    let js = jsig_real()
    let first = incremental.analyze(incremental.new_with_body_cache(std, ct_default(), js, query_probe,
      10, 10000, 20), pure)
    let java_module = source("middle", "use java \"java.util.ArrayList\"\npub fn items() -> ArrayList !io = ArrayList.new()\n")
    let loaded = LoadResult { modules: [a, java_module, b], diags: [] }
    let barrier = incremental.analyze(first.session, loaded)
    assert barrier.program.diags == []
    assert barrier.stats.reused_modules == 1 && barrier.stats.reused_bodies == 0
    assert barrier.stats.retained_modules == 1 && barrier.stats.retained_body_modules == 1
    assert barrier.stats.unobserved_modules == 1
    assert checkdump.render(barrier.program) == checkdump.render(analyze_program(loaded, std, ct_default(), js))
    let no_barrier = incremental.analyze(barrier.session, pure)
    assert no_barrier.stats.reused_modules == 1 && no_barrier.stats.checked_bodies == 1
    assert no_barrier.stats.reused_bodies == 0
    for text in ["pub fn other() -> Int = false\n",
      "pub fn other() -> Int = 1 / 0\nconst VALUE: Int = other()\n"] {
      let broken = source("b", text)
      let input = LoadResult { modules: [a, broken], diags: [] }
      let failed = incremental.analyze(first.session, input)
      let cold = analyze_program(input, std, ct_default(), js)
      assert failed.program.diags != [] && failed.program.diags == cold.diags
      assert failed.stats.retained_body_modules == 1 && failed.stats.retained_modules == 1
      assert checkdump.render(failed.program) == checkdump.render(cold)
      let restored = incremental.analyze(failed.session, pure)
      assert restored.stats.reused_modules == 1 && restored.stats.checked_bodies == 1
      assert restored.stats.reused_bodies == 0
    }
  }))
}

test "session body cache refuses ambiguous identities and clears errors" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic(std_load_error_text(e))
    }
    let a = source("a", "pub fn value() -> Int = 1\n")
    let b = source("b", "pub fn other() -> Int = 2\n")
    let input = LoadResult { modules: [a, b], diags: [] }
    let first = incremental.analyze(incremental.new_with_body_cache(std, ct_default(),
      jsig_refused(), refused_probe, 10, 10000, 20), input)
    let (different_directory, _) = envmem.with_env_table("/another-analysis-root", [],
      () => incremental.analyze(first.session, input))
    assert different_directory.stats.reused_modules == 0
    assert different_directory.stats.reused_bodies == 0
    assert different_directory.stats.checked_bodies == 2
    for renamed in [LoadedModule { ..b, mod_path: "renamed" },
      LoadedModule { ..b, class_name: "renamed" }, LoadedModule { ..b, path: "renamed.dawn" }] {
      let changed = LoadResult { modules: [a, renamed], diags: [] }
      let result = incremental.analyze(first.session, changed)
      let cold = analyze_program(changed, std, ct_default(), jsig_refused())
      assert result.stats.reused_modules == 1 && result.stats.reused_bodies == 0
      assert result.stats.checked_bodies == 1
      assert result.program.modules[1].tm == cold.modules[1].tm
      assert result.program.modules[1].ct == cold.modules[1].ct
      assert result.program.decl_spans == cold.decl_spans
      assert checkdump.render(result.program) == checkdump.render(cold)
    }
    for duplicate in [LoadedModule { ..b, mod_path: a.mod_path },
      LoadedModule { ..b, class_name: a.class_name }, LoadedModule { ..b, path: a.path },
      LoadedModule { ..b, path: "./a.dawn" }] {
      let loaded = LoadResult { modules: [a, duplicate], diags: [] }
      let result = incremental.analyze(first.session, loaded)
      assert result.stats.retained_total_modules == 0
      assert result.stats.reused_modules == 0 && result.stats.reused_bodies == 0
      let cold = analyze_program(loaded, std, ct_default(), jsig_refused())
      assert result.program.diags == cold.diags
      assert checkdump.render(result.program) == checkdump.render(cold)
    }
    let broken = source("b", "fn broken(\n")
    let loader = LocDiag { path: "loader", d: broken.pdiags[0] }
    let failed = incremental.analyze(first.session, LoadResult { modules: [a, b], diags: [loader] })
    assert failed.stats.retained_total_modules == 0 && failed.stats.reused_bodies == 0
    let restored = incremental.analyze(failed.session, input)
    assert restored.stats.reused_modules == 0 && restored.stats.checked_bodies == 2
    let error = incremental.analyze(first.session, LoadResult { modules: [a, broken], diags: [] })
    assert error.stats.reused_modules == 1 && error.stats.retained_body_modules == 1
    let recovered = incremental.analyze(error.session, input)
    assert recovered.stats.reused_modules == 1 && recovered.stats.checked_bodies == 1
    assert recovered.stats.reused_bodies == 0
  }))
}

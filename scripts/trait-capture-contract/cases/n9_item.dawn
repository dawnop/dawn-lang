# An explicit contract isolates this propagation or boundary rule.
type Holder[@s] = { buffer: I64Buf@s }
trait OpenSubject[T: ^{c}, ^c] { type Item
  fn take(value: T) -> T.Item }
impl[@s] OpenSubject[Holder[s], ^{s}] { type Item = I64Buf@s
  fn take(value: Holder[s]) -> I64Buf@s = value.buffer }
pub fn main() -> Unit !io = { () }

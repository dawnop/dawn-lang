## GENERATED FILE -- do not edit. Regenerate with `python3 scripts/gen-stdsrc.py`
## after any edit under std/; the round-trip test in stdlib.dawn fails when stale.
##
## The embedded standard library: std/modules.txt and every module it lists,
## verbatim, as string constants. stdlib.std_read falls back to this when the
## --std directory is absent, which is what makes a standalone toolchain
## self-contained on every backend without a host resource API
## (docs/std-audit.md §2, native-backend-plan §14.20).

## The file's text, or None for a name that is not part of the embedded std.
pub fn source(name: String) -> Option[String] =
  if name == "modules.txt" {
    Some("# Bundled std modules, in dependency order (spec §10.6). Each name is a\n# resource std/<name>.dawn, importable as `use std/<name>`; the file's name is\n# the qualification alias (map.insert, str.trim, ...).\ncursor\nstr\nfmt\n# list precedes bytes: `for` desugars through the prelude Iter trait, and\n# bytes' own for-loops need the `impl Iter[List[T]]` std/list registers\nlist\nbytes\nio\nmap\nset\nhamt\npvec\n")
  } else if name == "cursor.dawn" {
    Some("## Positions in a `String`. A cursor is a position rather than a count, so\n## stepping through a string costs the same at every offset — where a\n## code-point index costs a walk from the start (spec §11).\n#\n# Short names, module-qualified at the call site: `use std/cursor`, then\n# `cursor.next(s, c)`. The underlying operations are compiler intrinsics; these\n# wrappers give them their public, qualified spelling.\n#\n# A position is opaque: `Cursor` is this module's own type, and only this\n# module may see it as the Int it is. Arithmetic on one is a type error\n# anywhere else, which is the point — only arithmetic can conjure a position\n# that lands in the middle of a surrogate pair.\n#\n# It used to be a type the compiler minted: a `Ty` variant, a `Head`, an entry\n# in the eq/hash scalar tables and an arm in seven files. Same guarantee, and\n# now no mechanism of its own — `opaque type` (spec §2.7) is the mechanism.\n\n## A position in a String: an index the language will not let you compute.\npub opaque type Cursor = Int\n\n## The position before the first character.\npub fn start(s: String) -> Cursor = cursor_start(s)\n\n## The position after the last character.\npub fn end(s: String) -> Cursor = cursor_end(s)\n\n## Whether `c` is at the end of `s`.\npub fn done(s: String, c: Cursor) -> Bool = cursor_done(s, c)\n\n## The code point at `c`, or -1 at the end.\npub fn char(s: String, c: Cursor) -> Int = cursor_char(s, c)\n\n## The position one character forward (clamped to the end).\npub fn next(s: String, c: Cursor) -> Cursor = cursor_next(s, c)\n\n## The position one character back (clamped to the start).\npub fn prev(s: String, c: Cursor) -> Cursor = cursor_prev(s, c)\n\n## The text between two positions.\npub fn slice(s: String, from: Cursor, to: Cursor) -> String = cursor_slice(s, from, to)\n\n# The three below used to be intrinsics too — `cursor_skip` and\n# `index_of_from`, each with a hand-written implementation in the JVM emitter\n# and another in the C runtime, and a third route in the comptime interpreter\n# that reflected into the emitted JVM class. Search is not a representation\n# question: it is a walk, and the walk is above. Writing it here leaves seven\n# intrinsics under this module, which is the whole representation boundary\n# (docs/native-backend-plan.md 14.12).\n\n## The position just past `sub`, which is known to start at `c` — the one\n## sanctioned \"advance past a literal\" that would otherwise be cursor arithmetic.\n##\n## Walks both strings together rather than counting `sub` first, so it needs no\n## length and no arithmetic.\npub fn skip(s: String, c: Cursor, sub: String) -> Cursor = skip_go(s, c, sub, start(sub))\n\nfn skip_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Cursor =\n  if done(t, tc) || done(s, sc) {\n    sc\n  } else {\n    skip_go(s, next(s, sc), t, next(t, tc))\n  }\n\n## Whether `sub` occurs in `s` starting exactly at `c`. An empty `sub` is at\n## every position, including the end.\npub fn starts_at(s: String, c: Cursor, sub: String) -> Bool =\n  match_go(s, c, sub, start(sub))\n\nfn match_go(s: String, sc: Cursor, t: String, tc: Cursor) -> Bool =\n  if done(t, tc) {\n    true\n  } else if done(s, sc) {\n    false\n  } else if char(s, sc) != char(t, tc) {\n    false\n  } else {\n    match_go(s, next(s, sc), t, next(t, tc))\n  }\n\n## The position of the first occurrence of `sub` at or after `from`, or `None`.\npub fn find(s: String, sub: String, from: Cursor) -> Option[Cursor] =\n  if starts_at(s, from, sub) {\n    Some(from)\n  } else if done(s, from) {\n    None\n  } else {\n    find(s, sub, next(s, from))\n  }\n\n## The position `n` characters back from `c` (clamped to the start).\npub fn back(s: String, c: Cursor, n: Int) -> Cursor =\n  if n <= 0 { c } else { back(s, prev(s, c), n - 1) }\n\n# ---- the bridge to code-point indices ----\n#\n# There are two ways to say where you are in a string -- a code-point `Int`\n# and a `Cursor` -- and until these two functions existed there was no way to\n# get from either to the other. `str.index_of` answers in the first and\n# `cursor.slice` demands the second, so a scanner whose state is an `Int` (the\n# TOML one, for instance) had to re-derive its position from the start of the\n# string on every character: O(n) per step, O(n^2) per line. Neither of these\n# makes that cheap -- each is one walk -- but one walk at the boundary is not\n# one walk per character.\n\n## The position `i` characters from the start of `s`.\n##\n## Clamped, not asserted: a negative `i` is the start and an `i` past the end\n## is the end (spec §4.8, criterion 3, the same clause `next`, `prev` and\n## `back` already answer to). Every position in a string is a legal *answer*\n## here -- the guarantee `Cursor` carries is that arithmetic cannot land you\n## between the halves of a surrogate pair, and walking `i` characters cannot.\n##\n## O(i). Use it once, at the point where an `Int` index arrives from outside;\n## a loop that calls it per character is the O(n^2) it exists to remove.\npub fn at(s: String, i: Int) -> Cursor = at_go(s, start(s), i)\n\nfn at_go(s: String, c: Cursor, i: Int) -> Cursor =\n  if i <= 0 || done(s, c) { c } else { at_go(s, next(s, c), i - 1) }\n\n## How many characters lie before `c`: the code-point index `at` would take.\n##\n## One pass, counting forward from the start, rather than the two-scan version\n## `packages/json` wrote for itself. `c` must be a position in `s`; a cursor\n## from another string counts to whichever end it compares past.\npub fn offset(s: String, c: Cursor) -> Int = offset_go(s, start(s), c, 0)\n\nfn offset_go(s: String, p: Cursor, c: Cursor, n: Int) -> Int = {\n  let x: Int = p\n  let y: Int = c\n  if x >= y || done(s, p) { n } else { offset_go(s, next(s, p), c, n + 1) }\n}\n\n## Positions in one string are ordered, and that order is the Int's.\n##\n## It used to come from a row in the compiler's scalar tables, and only half\n## of one: `a < b` was allowed while `list.sort` reported Cursor unordered,\n## because two different tables answered the two questions. One impl answers\n## both.\nimpl Ord[Cursor] {\n  fn cmp(a: Cursor, b: Cursor) -> Int = {\n    let x: Int = a\n    let y: Int = b\n    if x < y { -1 } else if x > y { 1 } else { 0 }\n  }\n}\n")
  } else if name == "str.dawn" {
    Some("## String operations, over code points: trimming, case, search, slicing,\n## splitting and padding (spec §11).\n#\n# Short names, module-qualified at the call site: `use std/str`, then\n# `str.len(s)` / `str.trim(s)`; hot names can be pulled in selectively\n# (`use std/str.{trim}`).\n#\n# Ordinary Dawn source, bundled into the compiler jar as a resource, checked\n# before user code, and with its `pub` surface implicitly visible in every\n# module — no `use` needed (spec §10.6). This is the landing place for functions\n# moving out of the compiler's builtin table (docs/builtins-to-stdlib.md).\n#\n# Two implementation styles live here, on purpose (docs/pure-ffi-design.md §九):\n#   - plain Dawn over the cursor walk, which is nearly everything;\n#   - a str_* intrinsic, only where the answer is a Unicode table rather than a\n#     walk: case folding, and `char_is_*` underneath `trim`.\n#\n# Length, trimming, and all four searches used to be intrinsics too. Each had a\n# hand-written implementation in the JVM emitter and another in the C runtime,\n# and they disagreed with nothing to say so; the comptime interpreter had no\n# copy at all and reflected into the emitted JVM class, which is a route a\n# native compiler does not have (docs/native-backend-plan.md 14.12). They are\n# walks, not representation, so they are written here once and every consumer\n# reads that one definition.\n#\n# Nothing here names a JVM class; the backend owns the seven cursor primitives\n# and the two case foldings in dawn/rt/Strings (docs/runtime-intrinsics-design.md).\n\nuse std/cursor\nuse std/cursor.{Cursor}\n\n## Number of Unicode code points in `s` (not UTF-16 units, and not `chars`' list length).\npub fn len(s: String) -> Int = count(s, cursor.start(s), 0)\n\nfn count(s: String, c: Cursor, n: Int) -> Int =\n  if cursor.done(s, c) { n } else { count(s, cursor.next(s, c), n + 1) }\n\n## True when the string has no characters.\npub fn is_empty(s: String) -> Bool = cursor.done(s, cursor.start(s))\n\n## `s` without leading or trailing whitespace.\npub fn trim(s: String) -> String = {\n  let a = skip_space(s, cursor.start(s))\n  cursor.slice(s, a, last_kept(s, a, a))\n}\n\n## `s` without leading whitespace.\npub fn trim_start(s: String) -> String =\n  cursor.slice(s, skip_space(s, cursor.start(s)), cursor.end(s))\n\n## `s` without trailing whitespace.\npub fn trim_end(s: String) -> String = {\n  let a = cursor.start(s)\n  cursor.slice(s, a, last_kept(s, a, a))\n}\n\nfn skip_space(s: String, c: Cursor) -> Cursor =\n  if cursor.done(s, c) || not char_is_space(cursor.char(s, c)) {\n    c\n  } else {\n    skip_space(s, cursor.next(s, c))\n  }\n\n## The position just past the last non-space at or after `c`. Walking forward\n## and remembering, rather than walking back from the end, so no two positions\n## ever have to be compared.\nfn last_kept(s: String, c: Cursor, best: Cursor) -> Cursor =\n  if cursor.done(s, c) {\n    best\n  } else {\n    let n = cursor.next(s, c)\n    last_kept(s, n, if char_is_space(cursor.char(s, c)) { best } else { n })\n  }\n\n## `s` lowercased by simple (1:1) Unicode mapping: one code point in, one out,\n## no locale and no context, so the code-point count is unchanged.\npub fn to_lower(s: String) -> String = str_lower(s)\n\n## `s` uppercased by simple (1:1) Unicode mapping. Not the length-changing full\n## mapping -- `ß` stays `ß` rather than becoming `SS`, because full mapping is\n## locale- and context-sensitive and so is not a function a second backend can\n## implement from a table (spec 11). That belongs in a library taking a locale.\npub fn to_upper(s: String) -> String = str_upper(s)\n\n## Whether `sub` occurs anywhere in `s`.\npub fn contains(s: String, sub: String) -> Bool =\n  match cursor.find(s, sub, cursor.start(s)) {\n    Some(_) -> true\n    None -> false\n  }\n\n## Whether `s` begins with `prefix`.\npub fn starts_with(s: String, prefix: String) -> Bool =\n  cursor.starts_at(s, cursor.start(s), prefix)\n\n## Whether `s` ends with `suffix`.\npub fn ends_with(s: String, suffix: String) -> Bool = {\n  let n = len(suffix)\n  if n > len(s) {\n    false\n  } else {\n    cursor.starts_at(s, cursor.back(s, cursor.end(s), n), suffix)\n  }\n}\n\n## `s` with `prefix` removed, or `None` when `s` does not begin with it.\n##\n## Inquiry (spec §4.8, criterion 2): \"no such prefix\" is a branch the caller\n## takes, not a bug. Testing and peeling in one call is the point -- the pair\n## `starts_with` plus a hand-computed `substring(s, 16, len(s))` is what put\n## magic offsets in 33 call sites, and an offset that is one out still compiles.\n## No arithmetic happens here either: `cursor.skip` walks past the prefix.\npub fn strip_prefix(s: String, prefix: String) -> Option[String] =\n  if starts_with(s, prefix) {\n    Some(cursor.slice(s, cursor.skip(s, cursor.start(s), prefix), cursor.end(s)))\n  } else {\n    None\n  }\n\n## `s` with `suffix` removed, or `None` when `s` does not end with it.\n## The mirror of `strip_prefix`, and the answer to `- 5` meaning `len(\".dawn\")`.\npub fn strip_suffix(s: String, suffix: String) -> Option[String] =\n  if ends_with(s, suffix) {\n    Some(cursor.slice(s, cursor.start(s), cursor.back(s, cursor.end(s), len(suffix))))\n  } else {\n    None\n  }\n\n## The code-point index of the first occurrence of `sub`, or `None`.\n##\n## A code-point index, not a position: `cursor.find` is the one that answers\n## with something you can slice at.\npub fn index_of(s: String, sub: String) -> Option[Int] = idx(s, sub, cursor.start(s), 0)\n\nfn idx(s: String, sub: String, c: Cursor, i: Int) -> Option[Int] =\n  if cursor.starts_at(s, c, sub) {\n    Some(i)\n  } else if cursor.done(s, c) {\n    None\n  } else {\n    idx(s, sub, cursor.next(s, c), i + 1)\n  }\n\n## The code-point index of the last occurrence of `sub`, or `None`. An empty\n## `sub` is found at the end, which is `len(s)`.\npub fn last_index_of(s: String, sub: String) -> Option[Int] =\n  last_idx(s, sub, cursor.start(s), 0, None)\n\nfn last_idx(s: String, sub: String, c: Cursor, i: Int, best: Option[Int]) -> Option[Int] = {\n  let seen = if cursor.starts_at(s, c, sub) { Some(i) } else { best }\n  if cursor.done(s, c) { seen } else { last_idx(s, sub, cursor.next(s, c), i + 1, seen) }\n}\n\n## The single-code-point string for `c`. Panics when `c` is not a valid code point.\npub fn from_char(c: Int) -> String = from_code_points([c])\n\n## `s` repeated `n` times; n <= 0 yields the empty string.\npub fn repeat(s: String, n: Int) -> String = if n <= 0 { \"\" } else { s ++ repeat(s, n - 1) }\n\n# The code-point helpers below recurse over `code_points(s)` with an explicit\n# index because `len` here is str.len (String → code points) and so shadows the\n# builtin list length; `str.len(s)` doubles as the code-point count of that list.\n\n## The code points of `s` in `[from, to)`. Both ends are clamped into range\n## (a negative index reads as 0, one past the end as `len`) and `from > to`\n## yields the empty string, so this never panics — a range parameter selects\n## a stretch, it does not assert its endpoints exist (spec §4.8).\npub fn substring(s: String, from: Int, to: Int) -> String = {\n  let n = len(s)\n  let f = clamp_cp(from, n)\n  let t = clamp_cp(to, n)\n  if f >= t {\n    \"\"\n  } else {\n    let acc: List[Int] = []\n    from_code_points(slice_cps(code_points(s), f, t, acc))\n  }\n}\n\nfn clamp_cp(i: Int, n: Int) -> Int = if i < 0 { 0 } else if i > n { n } else { i }\n\n## The first `n` characters, or all of them when there are fewer. `n` is\n## clamped into `[0, len]`, so this never panics: it names a stretch rather\n## than asserting that position `n` exists (spec §4.8, criterion 3), the same\n## way `substring` and `list.take` do.\n##\n## `truncate` would be this function under another name, so there is no\n## `truncate`.\npub fn take(s: String, n: Int) -> String = substring(s, 0, n)\n\n## Everything after the first `n` characters; `n` is clamped into `[0, len]`,\n## so this never panics. This is the \"the rest of it\" that 50 call sites spell\n## `substring(x, i, str.len(x))`.\npub fn drop(s: String, n: Int) -> String = substring(s, n, len(s))\n\n## The code point at `i`. Panics when `i` is out of range -- `i` is a position\n## the caller says exists, exactly like `xs[i]` and `bytes.at`\n## (spec §4.8, criterion 1); `get`-style inquiry about a character is\n## `cursor.char` on a position you already hold.\n##\n## A code point, not a one-character string: `Int` is the currency\n## `code_points`, `from_char` and `cursor.char` already trade in, and `chars`\n## is the function that answers with strings.\npub fn at(s: String, i: Int) -> Int = {\n  let c = cursor.at(s, i)\n  if i < 0 || cursor.done(s, c) {\n    panic(\"str.at: index out of range\")\n  } else {\n    cursor.char(s, c)\n  }\n}\n\nfn slice_cps(cps: List[Int], i: Int, to: Int, acc: List[Int]) -> List[Int] =\n  if i >= to { acc } else { slice_cps(cps, i + 1, to, acc ++ [get(cps, i).expect(\"in range\")]) }\n\n## `s` left-padded with `pad` until it is `width` code points wide. Returns `s`\n## unchanged when it is already wide enough or `pad` is empty; the filler is\n## truncated to land exactly on width.\npub fn pad_start(s: String, width: Int, pad: String) -> String = {\n  let have = len(s)\n  if have >= width || pad == \"\" {\n    s\n  } else {\n    let acc: List[Int] = []\n    from_code_points(pad_fill(code_points(pad), len(pad), width - have, 0, acc)) ++ s\n  }\n}\n\nfn pad_fill(pad: List[Int], plen: Int, need: Int, i: Int, acc: List[Int]) -> List[Int] =\n  if i >= need { acc }\n  else { pad_fill(pad, plen, need, i + 1, acc ++ [get(pad, i % plen).expect(\"cycle in range\")]) }\n\n## `s` right-padded with `pad` until it is `width` code points wide. The mirror\n## of `pad_start`, with the same clauses: `s` comes back unchanged when it is\n## already wide enough or `pad` is empty, and the filler is truncated to land\n## exactly on width.\npub fn pad_end(s: String, width: Int, pad: String) -> String = {\n  let have = len(s)\n  if have >= width || pad == \"\" {\n    s\n  } else {\n    let acc: List[Int] = []\n    s ++ from_code_points(pad_fill(code_points(pad), len(pad), width - have, 0, acc))\n  }\n}\n\n## `s` with its code points in reverse order (surrogate pairs stay intact).\npub fn reverse(s: String) -> String = {\n  let acc: List[Int] = []\n  from_code_points(rev_cps(code_points(s), len(s) - 1, acc))\n}\n\nfn rev_cps(cps: List[Int], i: Int, acc: List[Int]) -> List[Int] =\n  if i < 0 { acc } else { rev_cps(cps, i - 1, acc ++ [get(cps, i).expect(\"in range\")]) }\n\n# ---- cursors ----\n#\n# Positions come from std/cursor, whose `Cursor` is opaque: only that module\n# may see one as the Int it is, so the raw `cursor_*` builtins have exactly\n# one caller in the whole ecosystem. chars/split below thread positions\n# without ever computing one, which is the guarantee the type carries.\n\n## The characters of `s`, each as a one-character string.\n## A surrogate pair stays one element — this splits by character, not by unit.\npub fn chars(s: String) -> List[String] = {\n  let empty: List[String] = []\n  chars_go(s, cursor.start(s), empty)\n}\n\nfn chars_go(s: String, c: Cursor, acc: List[String]) -> List[String] =\n  if cursor.done(s, c) {\n    acc\n  } else {\n    let n = cursor.next(s, c)\n    chars_go(s, n, acc ++ [cursor.slice(s, c, n)])\n  }\n\n## `s` cut at each occurrence of `sep`, left to right. Adjacent separators yield\n## empty pieces, and the result always has one more piece than there were\n## separators. An empty `sep` yields the characters, as `chars` does.\npub fn split(s: String, sep: String) -> List[String] =\n  if sep == \"\" {\n    chars(s)\n  } else {\n    let empty: List[String] = []\n    split_go(s, sep, cursor.start(s), empty)\n  }\n\nfn split_go(s: String, sep: String, at: Cursor, acc: List[String]) -> List[String] =\n  match cursor.find(s, sep, at) {\n    None -> acc ++ [cursor.slice(s, at, cursor.end(s))]\n    # cursor.skip is the one sanctioned \"advance past a known occurrence\"\n    Some(i) -> split_go(s, sep, cursor.skip(s, i, sep), acc ++ [cursor.slice(s, at, i)])\n  }\n\n## `s` with every occurrence of `from` replaced by `to`, left to right and\n## non-overlapping. An empty `from` splices `to` between the characters, the\n## same way `split` with an empty separator yields them.\npub fn replace(s: String, from: String, to: String) -> String =\n  join(split(s, from), to)\n\n# ---- iteration (prelude Iter, #44 knife 2) ----\n\n## `for ch in s` walks the string by code point; each element is a\n## one-character String, the same shape `chars` hands out, without\n## materialising the list. The cursor is `Cursor`, so a position mid-walk is\n## as impossible to conjure from arithmetic here as anywhere else.\nimpl Iter[String] {\n  type Cur = Cursor\n  type Item = String\n\n  fn iter_start(s: String) -> Cursor = cursor.start(s)\n  fn iter_done(s: String, c: Cursor) -> Bool = cursor.done(s, c)\n  fn iter_next(s: String, c: Cursor) -> Cursor = cursor.next(s, c)\n  fn iter_get(s: String, c: Cursor) -> String = cursor.slice(s, c, cursor.next(s, c))\n}\n")
  } else if name == "fmt.dawn" {
    Some("## The language's own number rendering and parsing: `to_string(Float)` and\n## the `parse_*` family are answered here, by Dawn source rather than by\n## whichever host is running (spec §4.3 and §11's grammar).\n#\n# `to_string(Float)` is answered here, by a Dawn port of the Schubfach\n# algorithm (Giulietti, \"The Schubfach way to render doubles\"; the same\n# algorithm OpenJDK's `Double.toString` has used since JDK 19). Both backends\n# and the comptime interpreter call this one definition, so the answer no\n# longer depends on which host happens to be running — it is pinned by spec\n# §4.3, byte for byte. The C runtime's `%.17g` approximation and the JVM's\n# `String.valueOf(double)` used to be two different answers to the same\n# question (audit RP-01); this module is the one answer.\n#\n# `parse_int` / `parse_float` / `parse_int_radix` are answered here too\n# (audit RP-05): the accepted language is the EBNF in spec §11, checked by\n# this module's own scanner, never by a host parser's grammar. The one thing\n# still delegated is the final decimal-to-binary conversion of a *validated*\n# float string (`parse_float` below), because correct rounding of decimal\n# strings is a large algorithm both hosts already implement identically on\n# the validated subset.\n#\n# Rendering discipline: nothing in this module may render a Float with\n# `to_string` or `\${...}` — lowering rewrites those to `fmt.dtoa`, so a use\n# here would be a self-call. Ints are fine (`str_of_int` is a backend\n# intrinsic, not this module).\n\nuse std/str\nuse std/cursor\nuse std/cursor.{Cursor}\n\n# ---- shared integer helpers ----\n#\n# No module-level consts in here: a comptime fold interprets these bodies as\n# the program's own std Core, and the interpreter resolves const references\n# in the *folding module's* view only -- a std-module const would not be\n# found there. Literals are spelled inline instead (2^63 - 1 in rop()).\n\nfn pow10(e: Int) -> Int =\n  match e {\n    0 -> 1\n    1 -> 10\n    2 -> 100\n    3 -> 1000\n    4 -> 10000\n    5 -> 100000\n    6 -> 1000000\n    7 -> 10000000\n    8 -> 100000000\n    9 -> 1000000000\n    10 -> 10000000000\n    11 -> 100000000000\n    12 -> 1000000000000\n    13 -> 10000000000000\n    14 -> 100000000000000\n    15 -> 1000000000000000\n    16 -> 10000000000000000\n    17 -> 100000000000000000\n    _ -> panic(\"fmt: pow10 out of range\")\n  }\n\n## floor(a * b / 2^64) for 0 <= a, b < 2^63: the high word of the unsigned\n## product, from 32-bit halves. Both call sites keep the operands under 2^63,\n## so the signed/unsigned distinction never bites.\nfn umulh(a: Int, b: Int) -> Int = {\n  let a0 = a & 4294967295\n  let a1 = a >>> 32\n  let b0 = b & 4294967295\n  let b1 = b >>> 32\n  let lo = a0 * b0\n  let m1 = a1 * b0\n  let m2 = a0 * b1\n  let w = (lo >>> 32) + (m1 & 4294967295) + (m2 & 4294967295)\n  (a1 * b1) + (m1 >>> 32) + (m2 >>> 32) + (w >>> 32)\n}\n\n# ---- floor logarithms (multiplier-and-shift, exact over the needed ranges) --\n#\n# floor(e * log10(2)), floor(log10(3/4 * 2^e)) and floor(e * log2(10)) as one\n# multiply and an arithmetic shift. The constants are floor(log10(2) * 2^41),\n# floor(log10(3/4) * 2^41) and floor(log2(10) * 2^38); each identity was\n# checked exhaustively against exact rational arithmetic over |e| <= 1100\n# (flog10*) and |e| <= 350 (flog2pow10), which covers every exponent a double\n# can put through them.\n\nfn flog10pow2(e: Int) -> Int = (e * 661971961083) >> 41\n\nfn flog10_three_quarters_pow2(e: Int) -> Int = (e * 661971961083 - 274743187321) >> 41\n\nfn flog2pow10(e: Int) -> Int = (e * 913124641741) >> 38\n\n# ---- the powers-of-10 table ----\n#\n# g_pair(i) is the 126-bit significand of 10^(-k) for k = i - 324, split as\n# (high 63 bits, low 63 bits): write 10^(-k) = b * 2^r with 2^125 <= b < 2^126,\n# then the pair encodes g = floor(b) + 1. One entry per k in [-324, 292] —\n# every power a finite double's decimal exponent can ask for. GENERATED from\n# exact rational arithmetic (the table equals OpenJDK MathUtils.g, verified\n# entry for entry); the chunks keep any one function's match small.\n\nfn g_pair(i: Int) -> (Int, Int) =\n  if i < 300 {\n    if i < 100 { g_chunk0(i) } else if i < 200 { g_chunk1(i) } else { g_chunk2(i) }\n  } else {\n    if i < 400 { g_chunk3(i) } else if i < 500 { g_chunk4(i) } else if i < 600 {\n      g_chunk5(i)\n    } else {\n      g_chunk6(i)\n    }\n  }\n\nfn g_chunk0(i: Int) -> (Int, Int) =\n  match i {\n    0 -> (5696189077778435540, 6557778377634271669)\n    1 -> (9113902524445496865, 1269073367360058862)\n    2 -> (7291122019556397492, 1015258693888047090)\n    3 -> (5832897615645117993, 6346230177223303157)\n    4 -> (4666318092516094394, 8766332956520552849)\n    5 -> (7466108948025751031, 8492109508320019073)\n    6 -> (5972887158420600825, 4949013199285060097)\n    7 -> (4778309726736480660, 3959210559428048077)\n    8 -> (7645295562778369056, 6334736895084876923)\n    9 -> (6116236450222695245, 3223115108696946377)\n    10 -> (4892989160178156196, 2578492086957557102)\n    11 -> (7828782656285049914, 436238524390181040)\n    12 -> (6263026125028039931, 2193665226883099993)\n    13 -> (5010420900022431944, 9133629810990300641)\n    14 -> (8016673440035891111, 9079784475471615541)\n    15 -> (6413338752028712889, 5419153173006337271)\n    16 -> (5130671001622970311, 6179996945776024979)\n    17 -> (8209073602596752498, 6198646298499729642)\n    18 -> (6567258882077401998, 8648265853541694037)\n    19 -> (5253807105661921599, 1384589460720489745)\n    20 -> (8406091369059074558, 5904691951894693915)\n    21 -> (6724873095247259646, 8413102376257665455)\n    22 -> (5379898476197807717, 4885807493635177203)\n    23 -> (8607837561916492348, 438594360332462878)\n    24 -> (6886270049533193878, 4040224303007880625)\n    25 -> (5509016039626555102, 6921528257148214824)\n    26 -> (8814425663402488164, 3695747581953323071)\n    27 -> (7051540530721990531, 4801272472933613619)\n    28 ->
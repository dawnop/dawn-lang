# `bracket` is effect-polymorphic in its own row. `catch_panic` beside it
# raises `!io` whatever its argument raises, and `catch_fault` stopped doing so
# on 2026-09-01 (SEM-11, docs/audit/error-model-design.md 六.11, §7.3 and
# §7.5). The golden pins all three: a pure `bracket` and a pure `catch_fault`
# produce nothing, a pure `catch_panic` still produces the `!io` complaint it
# always did.
#
# All three bind an effect parameter over the closure they protect (#343),
# which is a different question and is `catch_effects.dawn` next door. The two
# lines at the bottom of this file are the part that tells the barriers apart.
effect Ask {
  fn get() -> Int
}

fn asks() -> Int !Ask = get()

# pure in, pure out -- protecting a resource is not itself an effect
fn pure_bracket(n: Int) -> Int = bracket(n, x => (), x => x + 1)

# the row is the closures' row, whatever it is: a label passes through
fn labelled(n: Int) -> Int !Ask = bracket(n, x => (), x => asks())

# ...and is still checked against the signature. Three ways to under-declare:
fn label_undeclared(n: Int) -> Int = bracket(n, x => (), x => asks())

fn use_impure(n: Int) -> Unit = bracket(n, x => (), x => println(to_string(x)))

fn release_impure(n: Int) -> Int = bracket(n, x => println("bye"), x => x)

# `catch_panic` holds `!io`, so this one is refused in a pure signature even
# though nothing it calls is impure.
fn caught_panic(n: Int) -> Result[Int, ForeignError] = catch_panic(() => n)

# ...and its neighbour, the same line one word apart, is not. A repair that
# reached both barriers instead of one shows up as this line going silent
# together with the one above it rather than on its own.
fn caught_fault(n: Int) -> Result[Int, ForeignError] = catch_fault(() => n)

pub fn main() -> Unit !io = { println(to_string(pure_bracket(1))) }

# Parsing an origin never enables observation, even when the binder is unused.
effect Ask { fn ask(n: Int) -> Int }
ctl effect Tell { fn tell(n: Int) -> Int }
fn tail() -> Int = {
  with handle Ask { ask(n) origin o => n }
  ask(1)
}
fn control() -> Int = {
  with handle Tell { tell(n) origin o resume k => k(n) }
  tell(2)
}
fn duplicate() -> Int = {
  with handle Ask { ask(n) origin n => n }
  ask(3)
}

# Hold the exact cold transition before allowing any result to be reused.
# The trace is test-owned host state; production analysis has no observer.
#
# A module of the compiler package because checker state is `pub(pkg)`; it
# moved here from scripts/incremental-semantics-contract/src. Nothing in
# main.dawn or nmain.dawn imports contract/, so `dawn test selfhost` runs it
# and neither driver links it.

use std/map
use std/io
use std/str
use front/parser
use front/lexer
use driver/analyze.{
  LoadedModule, LoadResult, LocDiag, Program, AnalysisStage,
  AnalyzeModule, AnalyzeCheck, AnalyzeComptime,
  analyze_program, analyze_observed, analyze_module_step, initial_carry
}
use check/identity
use driver/stdlib.{StdCtx, load_std, std_load_error_text}
use driver/checkdump
use check/jsig.{jsig_refused}
use ir/interp.{ct_default, ct_fuel}
use std/io.{Fs, Env}
use java "java.util.ArrayList"

fn std_context() -> StdCtx !Fs !Env !io =
  match load_std("std") {
    Ok(s) -> s
    Err(e) -> panic(std_load_error_text(e))
  }

fn source(name: String, text: String) -> LoadedModule = {
  let (m, pdiags, marks) = parser.parse_module_marked(text)
  LoadedModule {
    mod_path: name, class_name: name, path: name ++ ".dawn", site_path: name ++ ".dawn",
    text: text, line_starts: lexer.line_starts_of(text), m: m, pdiags: pdiags, marks: marks, pkg: None, entry: false
  }
}

fn stage_name(stage: AnalysisStage) -> String =
  match stage {
    AnalyzeModule -> "module"
    AnalyzeCheck -> "check"
    AnalyzeComptime -> "comptime"
  }

test "cold observation is nested and leaves the program unchanged" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_context()
    let m = source("answer", "pub fn answer() -> Int = 42\n")
    let loaded = LoadResult { modules: [m], diags: [] }
    let events = ArrayList.new()
    let observed = analyze_observed(loaded, std, ct_default(), jsig_refused(),
      Some((name, stage, entering) => {
        let _ = events.add(name ++ ":" ++ stage_name(stage) ++ ":" ++ to_string(entering))
      }))
    let cold = analyze_program(loaded, std, ct_default(), jsig_refused())
    assert checkdump.render(observed) == checkdump.render(cold)
    assert observed.modules[0].tm == cold.modules[0].tm
    assert observed.modules[0].cx.adts == cold.modules[0].cx.adts
    assert len(observed.diags) == 0
    assert events.toString().expect("trace") ==
      "[answer:module:true, answer:check:true, answer:check:false, answer:comptime:true, answer:comptime:false, answer:module:false]"
    let step = analyze_module_step(m, initial_carry(std), std, ct_default(), jsig_refused(), None)
    assert step.check_runs == 1
    assert step.comptime_runs == 1
    assert step.after.identities == cold.modules[0].cx.identities
    assert map.has(step.after.exports, "answer")
  }))
}

test "failed cold steps retain exports and only run the reachable phases" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_context()
    let parse_error = source("parse_error", "pub fn broken(\n")
    assert len(parse_error.pdiags) > 0
    let events = ArrayList.new()
    let parsed = analyze_module_step(parse_error, initial_carry(std), std, ct_default(), jsig_refused(),
      Some((name, stage, entering) => {
        let _ = events.add(stage_name(stage) ++ ":" ++ to_string(entering))
      }))
    assert parsed.check_runs == 0
    assert parsed.comptime_runs == 0
    assert len(parsed.diags) == len(parse_error.pdiags)
    assert map.has(parsed.after.exports, "parse_error")
    assert parsed.after.identities == std.identities
    assert events.toString().expect("trace") == "[module:true, module:false]"

    # what a failed parse recovered still publishes its headers: the type and
    # the impl reach the carry. The statement the parser skipped damages only
    # `torn`; `later` is whole, so its signature is checked and the type nobody
    # declares is reported (docs/lsp-module-memo-design.md §十四)
    let torn = source("torn",
      "pub type Box = { n: Int }\nimpl Show[Box] { fn show(b: Box) -> String = \"box\" }\n" ++
        "fn torn() -> Int = {\n  let = 1\n  1\n}\npub fn later() -> Missing = 1\n")
    assert len(torn.pdiags) > 0
    assert torn.marks.damaged == [false, false, true, false] && not torn.marks.lost
    let recovered = analyze_module_step(torn, parsed.after, std, ct_default(), jsig_refused(), None)
    assert recovered.check_runs == 1
    assert recovered.comptime_runs == 0
    assert len(recovered.checked.cx.diags) > 0
    assert len(recovered.diags) == len(torn.pdiags) + len(recovered.checked.cx.diags)
    let surface = map.get(recovered.after.exports, "torn").expect("torn's surface")
    assert map.has(surface.types_by_name, "Box")
    assert map.has(surface.fns, "later")
    assert len(map.keys(recovered.after.impls)) == len(map.keys(parsed.after.impls)) + 1
    assert recovered.after.identities == recovered.checked.cx.identities

    # a dropped declaration is the other case: nothing is trusted below the
    # headers, and not even those report
    let dropped = source("dropped",
      "pub type Box = { n: Int }\nfn broken( = 0\npub fn later() -> Missing = 1\n")
    assert dropped.marks.lost
    let fallback = analyze_module_step(dropped, parsed.after, std, ct_default(), jsig_refused(), None)
    assert fallback.check_runs == 0
    assert fallback.comptime_runs == 0
    assert len(fallback.diags) == len(dropped.pdiags)
    assert len(fallback.checked.cx.diags) == 0
    assert map.has(fallback.after.exports, "dropped")

    let type_error = source("type_error", "pub fn broken() -> Int = false\n")
    let typed = analyze_module_step(type_error, parsed.after, std, ct_default(), jsig_refused(), None)
    assert typed.check_runs == 1
    assert typed.comptime_runs == 0
    assert len(typed.diags) > 0
    assert map.has(typed.after.exports, "type_error")
    assert map.has(typed.after.exports, "parse_error")
    assert typed.after.identities == typed.checked.cx.identities

    let exhausted = source("exhausted", "pub const N: Int = 40 + 2\n")
    let evaluated = analyze_module_step(exhausted, typed.after, std, ct_fuel(0), jsig_refused(), None)
    assert evaluated.check_runs == 1
    assert evaluated.comptime_runs == 1
    assert len(evaluated.checked.cx.diags) == 0
    assert len(evaluated.checked.ct.diags) > 0
    assert map.has(evaluated.after.exports, "exhausted")
  }))
}

test "cold program diagnostics start with the current loader result" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_context()
    let bad = source("bad", "pub fn broken() -> Int = false\n")
    let (_, diagnostics) = parser.parse_module("pub fn (\n")
    assert len(diagnostics) > 0
    let loader = LocDiag { path: "loader", d: diagnostics[0] }
    let loaded = LoadResult { modules: [bad], diags: [loader] }
    let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
    let step = analyze_module_step(bad, initial_carry(std), std, ct_default(), jsig_refused(), None)
    assert len(prog.diags) == len(step.diags) + 1
    assert prog.diags[0].path == "loader"
    assert prog.diags[1].path == "bad.dawn"
    let assembled = Program { modules: [step.checked], diags: [loader] ++ step.diags,
      decl_spans: step.after.decl_spans, ct_world: step.after.ct_world }
    assert checkdump.render(prog) == checkdump.render(assembled)
  }))
}

## What the checker reports about a module beyond its parse errors, each as the
## message and the source text it points at. The text rather than the offset,
## so that two files that differ by a deleted declaration can be compared.
fn findings(std: StdCtx, text: String) -> List[String] !Fs !Env !io = {
  let mf = source("m", text)
  let step = analyze_module_step(mf, initial_carry(std), std, ct_default(), jsig_refused(), None)
  var out: List[String] = []
  var seen = 0
  for ld in step.diags {
    if seen >= len(mf.pdiags) {
      let at = identity.absolute(step.after.decl_spans, ld.d)
      out = out ++ [ld.d.msg ++ " @ " ++ str.slice(text, at.lo, at.hi)]
    }
    seen = seen + 1
  }
  out
}

test "a recovered module reports what the file without its damaged declarations reports" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_context()
    let whole = "fn later() -> Int = \"not an int\"\n\nfn also() -> Int = missing_name\n\nfn fine() -> Int = 1\n"

    # an unclosed `{`: the second pass closes it before the next declaration,
    # which is not damaged by the closer that sits at its first character
    let unclosed = "fn torn() = {\n  let xs = [1, 2]\n  for x in xs {\n    x\n}\n\n" ++ whole
    let u = source("m", unclosed)
    assert u.marks.damaged == [true, false, false, false] && not u.marks.lost
    let expected = findings(std, whole)
    assert len(expected) == 2
    assert findings(std, unclosed) == expected

    # a statement the parser skipped
    let statement = "fn torn() -> Int = {\n  let = 5\n  1\n}\n" ++ whole
    let s = source("m", statement)
    assert s.marks.damaged == [true, false, false, false] && not s.marks.lost
    assert findings(std, statement) == expected

    # stray text between declarations is dropped without losing one
    let stray = "fn fine() -> Int = 1\nlet x = 1\nfn later() -> Int = \"not an int\"\n"
    let t = source("m", stray)
    assert len(t.pdiags) > 0 && not t.marks.lost && t.marks.damaged == [false, false]
    let later_only = findings(std, "fn fine() -> Int = 1\nfn later() -> Int = \"not an int\"\n")
    assert len(later_only) == 1
    assert findings(std, stray) == later_only

    # a declaration the parser dropped: bodies are not trusted at all
    let dropped = "fn fine() -> Int = 1\nfn broken( = 0\nfn later() -> Int = \"not an int\"\n"
    assert source("m", dropped).marks.lost
    assert findings(std, dropped) == []
  }))
}

test "a damaged declaration seals its callers and its imports off from the recovery" {
  io.with_fs_real(() => io.with_env_real(() => {
    let std = std_context()
    # the damaged function infers a String; its caller wants an Int. Checked,
    # the body would hand the caller that String; unchecked, the return type
    # is the error type and the caller has nothing to report
    let cascade = "fn torn() = {\n  let = 1\n  \"text\"\n}\nfn uses() -> Int = torn()\nfn later() -> Int = \"not an int\"\n"
    let c = source("m", cascade)
    assert c.marks.damaged == [true, false, false]
    assert len(findings(std, cascade)) == 1
    let step = analyze_module_step(c, initial_carry(std), std, ct_default(), jsig_refused(), None)
    var names: List[String] = []
    for f in step.checked.tm.fns { names = names ++ [f.name] }
    assert names == ["uses", "later"]

    # an import used only by a statement the parser skipped is not unused
    let skipped = "use std/str\nfn torn() -> Int = {\n  let = str.len(\"x\")\n  1\n}\n"
    assert findings(std, skipped) == []
    let control = "use std/str\nfn torn() -> Int = {\n  let y = 0\n  1\n}\n"
    assert len(findings(std, control)) == 1
  }))
}

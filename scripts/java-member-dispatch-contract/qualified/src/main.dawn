# A module alias is not a value and never a Java receiver, so `m.C(args)`,
# `m.CONST` and `m.f(args)` keep their spec §10.3 readings whatever the Java
# lookup would have made of them. No `use java` here on purpose: the rule has
# to hold in a program that imports no Java at all.
use lib
use lib.{Tag}

fn require(ok: Bool, message: String) -> Unit =
  if ok { () } else { panic(message) }

fn tag_n(t: Tag) -> Int =
  match t {
    Mark(n) -> n
  }

pub fn main() -> Unit !io = {
  require(tag_n(lib.Mark(5)) == 5, "qualified constructor")
  require(lib.LIMIT == 42, "qualified constant")
  require(lib.twice(3) == 6, "qualified function")
  println("ok")
}

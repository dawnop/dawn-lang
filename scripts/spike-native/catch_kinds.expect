-- nothing went wrong --
no failure     ok
-- the language's own failures: the io barrier lets them past --
panic          through
todo           through
expect None    through
div by zero    through
mod by zero    through
list index     through
map key        through
bytes at       through
bad code point through
-- documented not to fail --
bytes slice    ok
-- the outside world's failures: the io barrier is for these --
read_file      caught
list_names     caught
-- catch_panic is the catch-all: both kinds stop here --
panic          caught
read_file      caught
no failure     ok
-- two io barriers deep --
panic          through
read_file      inner
no failure     ok
-- catch_fault is the same barrier under its new name --
no failure     ok
panic          through
read_file      caught

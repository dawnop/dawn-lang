# The iterator application includes the actual body environment.
use std/mem
type Range = { n: Int }
impl[^c] StagedIter[Range, c] {
  type Item = Int
  fn staged_for(range: Range, body: fn(Int) -> Unit ^{c}) -> Unit = body(range.n)
}
pub fn main() -> Unit !io = {
  let answer = mem.with_mem([@s] () => {
    let buffer = mem.new(3)
    let range = Range { n = 2 }
    for value in range { if len(buffer) + value != 5 { panic("incorrect body") } }
    9
  })
  println(to_string(answer))
}

# Fetching and verifying remote source packages (the Kotlin manifest/PkgFetch):
# download an archive, unpack it, d1-hash the file tree, and file it into the
# content-addressed cache. Errors are pre-formatted strings — the message plus,
# when the Kotlin side carries one, "\n  " and the hint — so callers print them
# behind "error: " exactly as the Kotlin CLI does.
#
# Nothing here reaches the host any more. What is left of the outside world is
# `curl`, spawned like any other program, and the filesystem through std/io.

use std/str
use std/bytes
use std/list
use std/io
use fspath
use sha2/sha256
use inflate/gzip
use inflate/zip

## The content-addressed cache root: $DAWN_PKG_CACHE, then ~/.dawn/pkg. An
## environment variable and nothing else — the tests set it too, and there is
## no JVM system property in the chain for a native build to be missing.
pub fn cache_root() -> String !io =
  match io.getenv("DAWN_PKG_CACHE") {
    Some(p) -> p
    None ->
      match io.getenv("HOME") {
        Some(h) -> h ++ "/.dawn/pkg"
        None -> ".dawn-pkg"
      }
  }

pub fn cache_dir(hash: String) -> String !io = cache_root() ++ "/" ++ str.replace(hash, ":", "-")

# ---- d1: SHA-256 over the sorted file tree, `relpath \0 size \0 bytes` ----

fn zero_byte() -> Bytes = bytes.utf8(str.from_char(0))

fn read_bytes(path: String) -> Result[Bytes, String] !io =
  match io.read_bytes(path) {
    Ok(b) -> Ok(b)
    Err(e) -> Err("cannot read " ++ path ++ ": " ++ e.message)
  }

## Regular files under `root`, sorted by relative path; symlinks are refused
## (they do not survive archives portably, so the hash refuses them).
fn collect_files(root: String, rel: String) -> Result[List[String], String] !io = {
  var out: List[String] = []
  let dir = if rel == "" { root } else { root ++ "/" ++ rel }
  match io.list_dir(dir) {
    Ok(names) -> {
      for f in sort(names) {
        let r2 = if rel == "" { f } else { rel ++ "/" ++ f }
        let full = root ++ "/" ++ r2
        if io.is_symlink(full) {
          return Err("symbolic link in package tree: " ++ r2 ++
              "\n  the d1 hash refuses symlinks — they do not survive archives portably")
        }
        if io.is_dir(full) {
          match collect_files(root, r2) {
            Ok(sub) -> { out = out ++ sub }
            Err(e) -> return Err(e)
          }
        } else {
          out = out ++ [r2]
        }
      }
      Ok(out)
    }
    Err(e) -> Err("cannot list " ++ dir ++ ": " ++ e.message)
  }
}

## The d1 canonical tree hash of a directory: `d1:` + 64 hex digits.
pub fn tree_hash(root: String) -> Result[String, String] !io = {
  let files = match collect_files(root, "") {
    Ok(fs) -> sort(fs)
    Err(e) -> return Err(e)
  }
  var digest = sha256.new()
  for rel in files {
    let content = match read_bytes(root ++ "/" ++ rel) {
      Ok(b) -> b
      Err(e) -> return Err(e)
    }
    digest = sha256.update(digest, bytes.utf8(rel))
    digest = sha256.update(digest, zero_byte())
    digest = sha256.update(digest, bytes.utf8(to_string(bytes.len(content))))
    digest = sha256.update(digest, zero_byte())
    digest = sha256.update(digest, content)
  }
  Ok("d1:" ++ sha256.finish(digest))
}

# ---- download ----

## Fetch over HTTP by running `curl`.
##
## Not a client of our own, and not the host's: TLS is the one thing in this
## file that cannot be written in Dawn, and reaching for the JDK's would mean
## the package manager only works on the backend that has a JDK under it --
## while fetching a source package by url and hash has nothing to do with what
## the compiler emits. One implementation, one dependency, both backends.
##
## Resource ceilings for fetching and unpacking a source package.
##
## A never-answering host used to hold the compiler forever (no connect or
## request timeout at all), and a zip or tar.gz bomb — a few hundred KB that
## expands to gigabytes — was unpacked without a single check on total size,
## entry count or per-entry size. Both are one hostile `[deps]` URL away, and
## `dawn build` is the thing that follows it. The numbers are far above any
## real source package (the largest thing this fetches is a GitHub tag
## archive) and far below anything that endangers the machine.
const FETCH_CONNECT_TIMEOUT_SECS: Int = 30
const FETCH_REQUEST_TIMEOUT_SECS: Int = 300
const MAX_ARCHIVE_BYTES: Int = 268435456
const MAX_ENTRIES: Int = 65536
const MAX_ENTRY_BYTES: Int = 67108864

fn too_big(what: String, n: Int, limit: Int) -> String =
  "archive rejected: " ++ what ++ " (" ++ to_string(n) ++ " exceeds the " ++
  to_string(limit) ++ " limit)" ++
  "\n  a source package that legitimately needs this much is not one this fetcher handles"

## `--fail` turns a 4xx/5xx into a non-zero status with a line on stderr, which
## is why no status code is parsed here. The proxy environment variables need
## no code at all: curl reads them, which the JDK never did. `--max-filesize`
## is advisory (servers may not send a length), so the size is checked again
## on the downloaded bytes.
fn http_get(url: String) -> Result[Bytes, String] !io = {
  let staged = match io.temp_dir("", "dawn-fetch-") {
    Ok(d) -> d
    Err(e) -> return Err("cannot create a temp directory: " ++ e.message)
  }
  with work <- bracket(staged, delete_tree)
  let body = work ++ "/body"
  let diag = work ++ "/stderr"
  let ran = io.run([
    "curl", "--silent", "--show-error", "--location", "--fail",
    "--connect-timeout", to_string(FETCH_CONNECT_TIMEOUT_SECS),
    "--max-time", to_string(FETCH_REQUEST_TIMEOUT_SECS),
    "--max-filesize", to_string(MAX_ARCHIVE_BYTES),
    url
  ], body, diag)
  let out: Result[Bytes, String] = match ran {
    Ok(0) ->
      match read_bytes(body) {
        Ok(b) ->
          if bytes.len(b) > MAX_ARCHIVE_BYTES {
            Err(too_big("downloaded " ++ url, bytes.len(b), MAX_ARCHIVE_BYTES))
          } else {
            Ok(b)
          }
        Err(e) -> Err("cannot fetch " ++ url ++ ": " ++ e)
      }
    Ok(code) -> {
      let said = str.trim(match io.read_file(diag) {
        Ok(s) -> s
        Err(_) -> ""
      })
      let why = if said == "" { "curl exited " ++ to_string(code) } else { said }
      Err("cannot fetch " ++ url ++ ": " ++ why ++
          "\n  check the network (https_proxy is honored) or pre-seed the cache")
    }
    Err(e) ->
      Err("cannot fetch " ++ url ++ ": " ++ e.message ++
          "\n  fetching a remote package needs `curl` on PATH")
  }
  out
}

fn download(url: String) -> Result[Bytes, String] !io =
  if str.starts_with(url, "file://") {
    let path = str.strip_prefix(url, "file://").unwrap_or(url)
    if io.is_dir(path) {
      Err("no such file: " ++ url)
    } else {
      match read_bytes(path) {
        Ok(b) -> Ok(b)
        Err(_) -> Err("no such file: " ++ url)
      }
    }
  } else {
    http_get(url)
  }

# ---- unpack: zip or tar.gz, told apart by magic bytes ----

fn mkdirs(path: String) -> Unit !io = {
  let _ = io.mkdirs(path)
  ()
}

fn write_file_bytes(path: String, bs: Bytes) -> Result[Unit, String] !io = {
  match str.last_index_of(path, "/") {
    Some(i) -> mkdirs(str.take(path, i))
    None -> ()
  }
  match io.write_bytes(path, bs) {
    Ok(_) -> Ok(())
    Err(e) -> Err("cannot write " ++ path ++ ": " ++ e.message)
  }
}

## The extraction target for an archive entry, with the zip-slip guard.
##
## The guard is lexical. It used to resolve both sides with getCanonicalPath,
## which also follows symbolic links -- but nothing has been extracted yet, so
## there are no links of the archive's making to follow, and a link already in
## the destination would be the caller's own. What has to be refused is `..`,
## and that is arithmetic on the name.
fn entry_path(dest: String, name: String) -> Result[String, String] !io = {
  let base = fspath.absolute(dest, io.cwd())
  let out = fspath.absolute(dest ++ "/" ++ name, io.cwd())
  if out == base || str.starts_with(out, base ++ "/") {
    Ok(dest ++ "/" ++ name)
  } else {
    Err("archive entry escapes the extraction root: " ++ name)
  }
}

## Unpack a zip. The whole archive is decompressed before anything is written,
## same as untar below: a source archive is a few megabytes, and the reader
## works from the central directory rather than a stream anyway.
fn unzip(bs: Bytes, dest: String) -> Result[Unit, String] !io = {
  let entries = match zip.entries(bs) {
    Ok(es) -> es
    Err(e) -> return Err(e ++
        "\n  .zip and .tar.gz archives are supported; for GitHub use .../archive/refs/tags/<tag>.zip")
  }
  if len(entries) > MAX_ENTRIES {
    return Err(too_big("entry count", len(entries), MAX_ENTRIES))
  }
  var any = false
  # running total, so a bomb is stopped while it lands rather than after
  var total = 0
  for entry in entries {
    let out = match entry_path(dest, entry.name) {
      Ok(p) -> p
      Err(e) -> return Err(e)
    }
    if entry.is_dir {
      mkdirs(out)
    } else {
      if bytes.len(entry.data) > MAX_ENTRY_BYTES {
        return Err(too_big("entry " ++ entry.name, bytes.len(entry.data), MAX_ENTRY_BYTES))
      }
      total = total + bytes.len(entry.data)
      if total > MAX_ARCHIVE_BYTES {
        return Err(too_big("expanded size", total, MAX_ARCHIVE_BYTES))
      }
      match write_file_bytes(out, entry.data) {
        Ok(_) -> ()
        Err(e) -> return Err(e)
      }
    }
    any = true
  }
  if not any {
    Err("not a zip archive (or an empty one)" ++
        "\n  .zip and .tar.gz archives are supported; for GitHub use .../archive/refs/tags/<tag>.zip")
  } else {
    Ok(())
  }
}

# ---- tar.gz: gunzip whole, then walk 512-byte ustar blocks in memory ----

## The NUL-terminated string in `[off, off+len)`.
fn tar_str(b: Bytes, off: Int, len_: Int) -> String = {
  var end = off
  while end < off + len_ && bytes.at(b, end) != 0 { end = end + 1 }
  bytes.decode_utf8(bytes.slice(b, off, end))
}

fn tar_octal(b: Bytes, off: Int, len_: Int) -> Result[Int, String] = {
  if bytes.at(b, off) >= 128 { return Err("GNU base-256 tar sizes are not supported") }
  let s = str.trim(tar_str(b, off, len_))
  if s == "" { return Ok(0) }
  var n = 0
  for c in str.chars(s) {
    match str.index_of("01234567", c) {
      Some(d) -> { n = n * 8 + d }
      None -> return Err("bad size field in tar header")
    }
  }
  Ok(n)
}

fn block_all_zero(b: Bytes, off: Int) -> Bool = {
  var i = off
  while i < off + 512 {
    if bytes.at(b, i) != 0 { return false }
    i = i + 1
  }
  true
}

## pax extended header records are "<len> key=value\n"; the path override wins.
fn pax_path(recs: String) -> Option[String] = {
  let n = str.len(recs)
  var out: Option[String] = None
  var i = 0
  while i < n {
    let sp = match str.index_of(str.substring(recs, i, n), " ") {
      Some(s) -> i + s
      None -> break
    }
    let rec_len = match parse_int(str.substring(recs, i, sp)) {
      Some(m) -> m
      None -> break
    }
    if rec_len <= 0 || i + rec_len > n { break }
    var rec = str.substring(recs, sp + 1, i + rec_len)
    rec = str.strip_suffix(rec, "\n").unwrap_or(rec)
    if str.starts_with(rec, "path=") {
      out = Some(str.strip_prefix(rec, "path=").unwrap_or(rec))
    }
    i = i + rec_len
  }
  out
}

fn untar(gz: Bytes, dest: String) -> Result[Unit, String] !io = {
  let raw = match gzip.gunzip(gz) {
    Ok(b) -> b
    Err(_) -> return Err("not a tar.gz archive (or an empty one)" ++
        "\n  .zip and .tar.gz archives are supported; for GitHub use .../archive/refs/tags/<tag>.tar.gz")
  }
  # gunzip materialises before this check can run, so a bomb costs memory but
  # never reaches the disk; stopping it mid-stream needs a cap inside
  # packages/inflate, recorded there rather than half-done here
  if bytes.len(raw) > MAX_ARCHIVE_BYTES {
    return Err(too_big("expanded size", bytes.len(raw), MAX_ARCHIVE_BYTES))
  }
  var any = false
  var off = 0
  var pending: Option[String] = None
  while off + 512 <= bytes.len(raw) {
    if block_all_zero(raw, off) { break }
    let size = match tar_octal(raw, off + 124, 12) {
      Ok(n) -> n
      Err(e) -> return Err(e)
    }
    let tchar = bytes.at(raw, off + 156)
    let magic = tar_str(raw, off + 257, 6)
    let prefix = if str.starts_with(magic, "ustar") { tar_str(raw, off + 345, 155) } else { "" }
    let raw_name = tar_str(raw, off, 100)
    let name = match pending {
      Some(p) -> p
      None -> if prefix == "" { raw_name } else { prefix ++ "/" ++ raw_name }
    }
    pending = None
    let data_start = off + 512
    if data_start + size > bytes.len(raw) { return Err("truncated tar archive") }
    let padded = size + (512 - size % 512) % 512
    # type bytes: 'L' 76, 'x' 120, 'g' 103, '5' 53, '0' 48, NUL 0, '7' 55, links 49/50
    if tchar == 76 {
      let long_name = bytes.decode_utf8(bytes.slice(raw, data_start, data_start + size))
      pending = Some(match str.index_of(long_name, str.from_char(0)) {
        Some(i) -> str.take(long_name, i)
        None -> long_name
      })
    } else if tchar == 120 {
      let recs = bytes.decode_utf8(bytes.slice(raw, data_start, data_start + size))
      pending = pax_path(recs)
    } else if tchar == 103 {
      ()
    } else if tchar == 53 {
      match entry_path(dest, name) {
        Ok(p) -> mkdirs(p)
        Err(e) -> return Err(e)
      }
      any = true
    } else if tchar == 48 || tchar == 0 || tchar == 55 {
      let out = match entry_path(dest, name) {
        Ok(p) -> p
        Err(e) -> return Err(e)
      }
      match write_file_bytes(out, bytes.slice(raw, data_start, data_start + size)) {
        Ok(_) -> ()
        Err(e) -> return Err(e)
      }
      any = true
    } else if tchar == 49 || tchar == 50 {
      return Err("link in tar archive: " ++ name ++
          "\n  the d1 hash refuses links — they do not survive archives portably")
    } else {
      return Err("unsupported tar entry type `" ++ str.from_char(tchar) ++ "`: " ++ name)
    }
    off = data_start + padded
  }
  if not any {
    Err("not a tar.gz archive (or an empty one)" ++
        "\n  .zip and .tar.gz archives are supported; for GitHub use .../archive/refs/tags/<tag>.tar.gz")
  } else {
    Ok(())
  }
}

fn unpack(bs: Bytes, dest: String) -> Result[Unit, String] !io =
  if bytes.len(bs) >= 2 && bytes.at(bs, 0) == 31 && bytes.at(bs, 1) == 139 {
    untar(bs, dest)
  } else {
    unzip(bs, dest)
  }

## GitHub-style archives wrap everything in `<repo>-<tag>/`: when the unpacked
## root holds exactly one directory and nothing else, that directory is the tree.
fn strip_single_top_dir(work: String) -> String !io =
  match io.list_dir(work) {
    Ok(names) ->
      if len(names) == 1 && io.is_dir(work ++ "/" ++ names[0]) {
        work ++ "/" ++ names[0]
      } else {
        work
      }
    Err(_) -> work
  }

fn delete_tree(path: String) -> Unit !io = {
  if io.is_dir(path) && not io.is_symlink(path) {
    match io.list_dir(path) {
      Ok(names) -> { for f in names { delete_tree(path ++ "/" ++ f) } }
      Err(_) -> ()
    }
  }
  let _ = io.delete(path)
  ()
}

## Fetch `url`, unpack, hash, and file the tree into the cache under its own
## (actual) hash. Returns (cache entry, d1 hash) — `add` uses this to learn the
## hash of an archive it has never seen.
pub fn fetch_and_hash(url: String) -> Result[(String, String), String] !io = {
  mkdirs(cache_root())
  # staged inside the cache root, so the publishing rename below stays on one
  # filesystem and is therefore atomic
  let staged = match io.temp_dir(cache_root(), "fetch-") {
    Ok(d) -> d
    Err(e) -> return Err("cannot create a temp directory under " ++ cache_root() ++ ": " ++ e.message)
  }
  with work <- bracket(staged, delete_tree)
  fetch_into(url, work)
}

## The body of the fetch. Still its own function, but no longer *because* of
## the release: the staging directory now has a bracket around it, and this
## keeps its four early `Err` returns, which the sugared region would refuse.
fn fetch_into(url: String, work: String) -> Result[(String, String), String] !io = {
  let body = match download(url) {
    Ok(b) -> b
    Err(e) -> return Err(e)
  }
  match unpack(body, work) {
    Ok(_) -> ()
    Err(e) -> return Err(e)
  }
  let root = strip_single_top_dir(work)
  let actual = match tree_hash(root) {
    Ok(h) -> h
    Err(e) -> return Err(e)
  }
  let target = cache_dir(actual)
  if not io.is_dir(target) {
    # rename into place; a concurrent fetch of the same hash yields the same bytes
    let moved = io.rename(root, target)
    match moved {
      Ok(_) -> ()
      Err(e) -> { if not io.is_dir(target) { return Err("cannot move into the cache: " ++ e.message) } }
    }
  }
  Ok((target, actual))
}

## Re-hash a cache entry and compare against the hash its directory name
## claims (PKG-02): the cache is content-addressed, so the name is the
## declaration and a fresh d1 walk is the whole verification — hand edits,
## disk rot and a half-written concurrent unpack all surface as a mismatch.
pub fn verify_cached(dir: String, hash: String) -> Result[Unit, String] !io =
  match tree_hash(dir) {
    Err(e) -> Err("cache entry " ++ dir ++ " is unreadable: " ++ e ++
        "\n  delete it and re-run; the next fetch re-downloads")
    Ok(actual) ->
      if actual != hash {
        Err("cache entry " ++ dir ++ " does not match its own name" ++
            "\n  named:     " ++ hash ++ "\n  actual:    " ++ actual ++
            "\n  the local copy was modified or damaged after fetch; delete it and re-run")
      } else {
        Ok(())
      }
  }

## The unpacked archive for `hash`, fetching from `url` on a cache miss.
## A hit is re-verified every time (PKG-02): fetch-time verification alone
## means a later modification of the local copy is trusted forever — the
## seed jars had the same hole until scripts/seed-checksums.txt. Re-hashing
## costs one read of the package's bytes (measured ~0.9s for a 7MB tree,
## milliseconds for typical source packages).
pub fn ensure_cached(url: String, hash: String) -> Result[String, String] !io = {
  let target = cache_dir(hash)
  if io.is_dir(target) {
    match verify_cached(target, hash) {
      Ok(_) -> return Ok(target)
      Err(e) -> return Err(e)
    }
  }
  match fetch_and_hash(url) {
    Ok(pr) -> {
      let (dir, actual) = pr
      if actual != hash {
        Err("hash mismatch for " ++ url ++
            "\n  declared:  " ++ hash ++ "\n  actual:    " ++ actual ++
            "\n  if you just wrote this dependency, copy the actual value into `hash`")
      } else {
        Ok(dir)
      }
    }
    Err(e) -> Err(e)
  }
}

test "tar octal and pax records parse" {
  let b = bytes.utf8("0000644" ++ str.from_char(0))
  assert tar_octal(b, 0, 8) == Ok(420)
  # the length field counts the whole record, its own digits included
  assert pax_path("32 path=some/very/long/name.txt\n") == Some("some/very/long/name.txt")
  assert pax_path("16 uid=1000\n") == None
}

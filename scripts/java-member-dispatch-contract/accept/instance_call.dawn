# The same question on an instance receiver. A static-only dispatch answers the
# uppercase static call above and still leaves this one broken, which is why the
# two are separate subjects.
use java "fixture.Syn09"

fn require(ok: Bool, message: String) -> Unit =
  if ok { () } else { panic(message) }

pub fn main() -> Unit !io = {
  let v = Syn09.new()
  require(v.UpperInstance(1) == 4, "uppercase instance method")
  require(v.lowerInstance(1) == 5, "lowercase instance method")
  println("ok")
}

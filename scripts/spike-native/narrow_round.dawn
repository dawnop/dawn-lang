  for (x, want) in cases {
    let got = f(x)
    if not same(got, want) {
      bad = bad + 1
      println("  ${label}(${x}) = ${got}, want ${want}")
    }
  }
  println("${label}: ${len(cases)} cases, ${bad} bad")
  bad
}

fn check2(label: String, f: fn(Float, Float) -> Float, cases: List[(Float, Float, Float)]) -> Int !io = {

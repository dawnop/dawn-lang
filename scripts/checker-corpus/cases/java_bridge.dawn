# checker.dawn: what crosses to Java -- SAM shapes, List element types, and the
# one return kind v0.1 refuses.
#
# Classes and members are picked for stability across JDK versions: the hints
# quote the host's own reflection, so an overload set that grew between
# releases would make this golden a JDK version test.
use java "java.util.ArrayList"
use java "java.lang.Character"

type Boxed = B(n: Int)

pub fn sam_shape() -> Int !io = {
  let a = ArrayList.new()
  a.forEach(x => 1)
  1
}

pub fn bridge_list(xs: List[Boxed]) -> Int !io = {
  let a = ArrayList.new(xs)
  1
}

pub fn char_return() -> Int !io = {
  let c = Character.forDigit(1, 10)
  1
}

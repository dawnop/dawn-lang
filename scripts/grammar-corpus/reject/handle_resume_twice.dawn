# expect: expected `=>` (an arm is a closure), found `resume`
# expect: allowed at module top level
# One arm has one continuation, so the clause appears at most once. The second
# `resume` lands where the arrow belongs and is reported there.
effect Ask {
  fn ask(n: Int) -> Int
}

fn f() -> Int = {
  with handle Ask { ask(n) resume k resume j => n + 1 }
  ask(1)
}

# The bundled standard library: std sources are read from a directory
# (`--std <dir>`, default std), or from the embedded copy in `stdsrc.dawn` --
# generated string constants compiled into the toolchain like any other
# module, so a standalone build works outside the repo on every backend with
# no host resource API. Whichever of the two answers for modules.txt supplies
# every module, never a mix: a directory that has modules.txt must be
# complete, and one that has none is not read at all (#206).
# Each module is parsed and checked once in modules.txt order, its pub
# surface handed to every user module. std is checked with no std of its
# own in scope — only the prelude, the builtins and explicit `use` edges —
# keeping the bootstrap acyclic.
#
# A std that fails to load is a compiler bug only when it is the embedded one.
# The directory can be any release, and `std` relative to the working
# directory is the default, so a toolchain run inside somebody else's checkout
# loads their std without being asked to. `StdLoadError` carries which half
# answered and what the directory stamps itself with, so the two cases can be
# told apart in words instead of both saying "bundled std is broken".

use std/io
use std/io.{Fs, Env}
use std/str
use std/map
use std/set
use front/ast.{Module}
use check/types.{
  Sig, Adts, Impls, first_minted_id, adt_of, TyList,
  OPTION_ID, RESULT_ID, FOREIGN_ERROR_ID
}
use check/tast.{TFun, TModule}
use check/cx.{ModExports, cx_new, Cx}
use check/checker.{check_module, exports_of, moved_module_key}
use check/identity.{Minted}
use ir/interp.{eval_comptime, note_direct_fn, note_trait_fn, CtOut, ct_default}
use ir/core.{VStr, VBool}
use front/parser
use front/lexer
use front/token.{Diag}
use embed/stdsrc
use ir/lower.{parser_impl}
use version.{VERSION}
use compiler_plan/envmem
use compiler_plan/source.{canon}
use driver/fsmem

## Everything user-module analysis needs from std.
pub(pkg) type StdCtx = {
  # modPath → exports, seeded into every program's import environment
  exports: Map[String, ModExports],
  # the implicitly-visible surface: the PRELUDE names only
  std_fns: Map[String, Sig],
  # a bare name → where it lives now (every std export, by its qualified
  # spelling), plus std/moved.txt's hints: flat entries under the old name,
  # module-qualified ones under `moved_module_key(module, old)`
  moved: Map[String, String],
  # flat name → direct typed fn, for the comptime interpreter
  fn_decls: Map[String, TFun],
  # className → (name → direct typed fn): qualified comptime calls
  by_owner: Map[String, Map[String, TFun]],
  # std's impl methods and trait defaults, by the identity Core names them
  # with. Separate from by_owner because two impls in one module can define
  # the same method name and that table is keyed by name alone.
  impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  # the ADT table after all of std (grafted ids for user comptime)
  adts: Adts,
  # Every impl std declares, seeded into every module the program checks.
  #
  # `impl[T: Eq] Eq[List[T]]` is not something a program opts into by writing
  # `use std/list` -- coherence is program-wide, so `a == b` on two lists has
  # to mean the same thing in a module that imports std/list and one that does
  # not. That makes std's impls part of the baseline, next to the prelude's.
  impls: Impls,
  # every nominal and trait id std derived, with the declaration behind each.
  # A user module goes on interning into this table, so a user declaration
  # whose digest lands on one of std's is reported rather than overwriting it
  identities: Map[Int, Minted],
  # per-module (modPath, checker state, typed module, comptime results), in
  # load order — codegen emits each std module's static class from these
  mods: List[(String, Cx, TModule, CtOut)],
  # per-module (modPath, source text, AST), in load order — `selfhost doc
  # --builtins` reads std doc comments and pub decls from these
  srcs: List[(String, String, Module)],
  # The directory this std was read from, canonicalized — `None` when the
  # embedded copy answered for modules.txt, because then there is no directory
  # anyone could open a file in.
  dir: Option[String],
  # canonical file path → the std module path that file was loaded as, for
  # every module whose text came off the directory rather than the embedded
  # copy. This is std's identity as a *fact about a file*, which is the only
  # form a later reader can check: an editor opening `std/list.dawn` and
  # `dawn check std/list.dawn` both arrive holding a path and nothing else,
  # and the answer has to be no for a project file named `src/std/list.dawn`,
  # which is spelled identically and is not this.
  dir_modules: Map[String, String],
  # the impl table each std module was checked against: everything the modules
  # before it in load order declared, and nothing of its own.
  #
  # Re-checking one std source on its own -- an editor buffer, `dawn check
  # std/list.dawn` -- has to start from this rather than from the finished
  # bundle. `impls` below is the whole library's, this module's own included,
  # and a module re-registering the impls it declares against a table that
  # already holds them is a duplicate-impl error per impl: 15 of the 17 that
  # survived the identity fix, all of them saying a std module conflicts with
  # itself.
  impls_before: Map[String, Impls]
}

pub fn prelude_names() -> List[String] =
  ["println", "print", "map", "filter", "fold", "sort", "max", "min", "max_by", "min_by"]

fn is_prelude(n: String) -> Bool = {
  for p in prelude_names() {
    if p == n { return true }
  }
  false
}

## The module a prelude name is harvested from. The harvest below used to go
## by name alone, so whichever module was checked *last* supplied the prelude
## function: invisible while exactly one module exported each name, and the
## moment std/map grew a `fold` of its own, every bare `fold(xs, ...)` in
## user code was checked against the map signature -- whose parameter types
## name ADTs the user program's tables have never heard of, so the symptom
## was an unknown-adt-id panic three tables downstream of the cause.
fn prelude_owner(n: String) -> String =
  if n == "println" || n == "print" { "std/io" } else { "std/list" }

## One line of std/moved.txt: a name that left std, how to write it now, and
## until which release the hint is kept (docs/std-moved-design.md).
##
## The data lives with std rather than in the compiler because it is std's
## release history, and a compiler only ever loads the std it shipped with.
pub(pkg) type MovedEntry = {
  # `builtin` for a flat spelling, else the `std/<module>` it left
  scope: String,
  old: String,
  # the spelling to use now, or `-`
  replacement: String,
  since: String,
  until: String,
  # the diagnostic hint, verbatim; `no-hint` is a removal on purpose
  hint: String
}

## A release number `X.Y.Z` as three integers, or `None` when `v` is not one.
## Digits only: `parse_int` alone would accept a sign or blanks.
pub(pkg) fn release_key(v: String) -> Option[(Int, Int, Int)] = {
  let parts = str.split(v, ".")
  if len(parts) != 3 { return None }
  var nums: List[Int] = []
  for p in parts {
    if p == "" { return None }
    for c in str.chars(p) {
      if not str.contains("0123456789", c) { return None }
    }
    match parse_int(p) {
      Some(n) -> { nums = nums ++ [n] }
      None -> return None
    }
  }
  Some((nums[0], nums[1], nums[2]))
}

## Is release `a` strictly before release `b`?
pub(pkg) fn release_before(a: (Int, Int, Int), b: (Int, Int, Int)) -> Bool = {
  let (a1, a2, a3) = a
  let (b1, b2, b3) = b
  if a1 != b1 { a1 < b1 } else if a2 != b2 { a2 < b2 } else { a3 < b3 }
}

## The first blank-separated field of `s` and the rest, both with their
## leading blanks dropped.
fn moved_field(s: String) -> (String, String) = {
  let t = str.trim_start(s)
  match str.split_once(t, " ") {
    Some(pair) -> {
      let (head, rest) = pair
      (head, str.trim_start(rest))
    }
    None -> (t, "")
  }
}

## std/moved.txt as entries, or the first line that is not one, as its
## 1-based number and what is wrong with it. `#` starts a comment anywhere,
## which is why a hint cannot contain one.
pub(pkg) fn parse_moved(text: String) -> Result[List[MovedEntry], (Int, String)] = {
  var out: List[MovedEntry] = []
  var seen: Set[String] = set.empty()
  var n = 0
  for raw in str.split(text, "\n") {
    n = n + 1
    let cut = match str.index_of(raw, "#") {
      Some(i) -> str.take(raw, i)
      None -> raw
    }
    let line = str.trim(str.replace(cut, "\t", " "))
    if line == "" { continue }
    let (scope, r1) = moved_field(line)
    let (old, r2) = moved_field(r1)
    let (replacement, r3) = moved_field(r2)
    let (since, r4) = moved_field(r3)
    let (until, hint) = moved_field(r4)
    if hint == "" {
      return Err((n, "expected `scope old new since until hint`"))
    }
    if scope != "builtin" && not str.starts_with(scope, "std/") {
      return Err((n, "scope `${scope}` is neither `builtin` nor `std/<module>`"))
    }
    match (release_key(since), release_key(until)) {
      (Some(s), Some(u)) ->
        if not release_before(s, u) {
          return Err((n, "until ${until} is not after since ${since}"))
        }
      _ -> return Err((n, "since and until must be releases written X.Y.Z"))
    }
    let key = moved_key(scope, old)
    if set.has(seen, key) {
      return Err((n, "`${old}` of `${scope}` is listed twice"))
    }
    seen = set.insert(seen, key)
    out = out ++ [MovedEntry {
      scope: scope,
      old: old,
      replacement: replacement,
      since: since,
      until: until,
      hint: hint
    }]
  }
  Ok(out)
}

## Where an entry goes in `cx.moved`: a flat spelling under its own name, a
## module-qualified one under the key `check_module_call` asks with.
fn moved_key(scope: String, old: String) -> String =
  if scope == "builtin" { old } else { moved_module_key(scope, old) }

## `moved` with every hinted entry added. Entries override the export-derived
## hints under the same key, as the hand-kept table this replaced did.
fn install_moved(moved0: Map[String, String], entries: List[MovedEntry]) -> Map[String, String] = {
  var moved = moved0
  for e in entries {
    if e.hint != "no-hint" {
      moved = map.insert(moved, moved_key(e.scope, e.old), e.hint)
    }
  }
  moved
}

## Which half of `std_read` answered for a file.
##
## The two are not interchangeable in a diagnostic. The embedded copy is
## compiled into the binary alongside the compiler that reads it, so it cannot
## be a release out of step; a directory can be anything, including a `std`
## that happened to sit in the current directory. Folding both into the phrase
## "bundled std" is what made a version skew read as a corrupt install.
pub type StdOrigin =
  | StdFromDir(dir: String)
  | StdEmbedded

## Why the std did not load. One variant per thing that can go wrong, so the
## driver can render them apart instead of concatenating them all onto one
## sentence. `StdVersionSkew` is the directory declaring a release this
## toolchain is not; `StdFileMissing` is a name in modules.txt that is in
## neither the directory nor the embedded copy; `StdModulesMissing` is every
## module modules.txt lists that the half which answered for it does not have;
## `StdMovedMalformed` is a line of moved.txt that is not an entry.
pub type StdFail =
  | StdVersionSkew
  | StdFileMissing(file: String, why: String)
  | StdModulesMissing(files: List[String])
  | StdModuleParse(mod_path: String, diag: String)
  | StdModuleCheck(mod_path: String, diag: String)
  | StdModuleEval(mod_path: String, diag: String)
  | StdMovedMalformed(line: Int, why: String)

## A failed `load_std`, with enough context to say which std failed and why.
pub type StdLoadError = {
  origin: StdOrigin,
  # what the std says its release is: `None` for a directory with no VERSION
  # file, which is every std published before the stamp existed and every
  # hand-assembled one a test builds
  declared: Option[String],
  why: StdFail
}

## A std file: the directory first, then the embedded copy `stdsrc.dawn`
## carries. The flag says which one answered.
##
## Only modules.txt is read this way, because that read is what decides which
## half the std is. Module sources go through `std_module_text`, which asks
## that half alone: a per-file fallback here is what let a directory missing
## `map.dawn` borrow the embedded one, and a stray `std/str.dawn` under the
## working directory replace the embedded one, both without a word (#206).
fn std_read_from(dir: String, name: String) -> Result[(String, Bool), String] !Fs =
  match io.read_file(dir ++ "/" ++ name) {
    Ok(t) -> Ok((t, true))
    Err(e) ->
      match stdsrc.source(name) {
        Some(t) -> Ok((t, false))
        None -> Err(e.message)
      }
  }

## A std module's source, from the half that answered for modules.txt and from
## nowhere else. `None` when that half has no such file.
fn std_module_text(dir: String, from_dir: Bool, name: String) -> Option[String] !Fs =
  if from_dir {
    match io.read_file(dir ++ "/" ++ name) {
      Ok(t) -> Some(t)
      Err(_) -> None
    }
  } else {
    stdsrc.source(name)
  }

fn std_read(dir: String, name: String) -> Result[String, String] !Fs = {
  let (text, _) = std_read_from(dir, name)?
  Ok(text)
}

## The release a std *directory* stamps itself with, or `None` when it carries
## no stamp.
##
## Deliberately not `std_read`: falling back to the embedded copy would answer
## with this binary's own version for every directory, and a comparison that
## reads one side twice can only ever agree. The absent case is a real answer
## rather than an error, because a std that predates the stamp, and the
## one-module stds tests assemble, both land there.
fn dir_declared_version(dir: String) -> Option[String] !Fs =
  match io.read_file("${dir}/VERSION") {
    Ok(t) -> Some(str.trim(t))
    Err(_) -> None
  }

fn index_names(text: String) -> List[String] = {
  var names: List[String] = []
  for line in str.split(text, "\n") {
    let cut = match str.index_of(line, "#") {
      Some(i) -> str.take(line, i)
      None -> line
    }
    let t = str.trim(cut)
    if t != "" { names = names ++ [t] }
  }
  names
}

## Read modules.txt: one name per line, `#` comments, blanks skipped.
pub fn read_index(dir: String) -> Result[List[String], String] !Fs = {
  let text = std_read(dir, "modules.txt")?
  Ok(index_names(text))
}

## The directory as a reader can act on it: a relative one is resolved against
## the working directory it was resolved against, because `std` on its own does
## not say which `std`, and the default `--std` is exactly that spelling.
fn located(dir: String) -> String !Env =
  if str.starts_with(dir, "/") {
    dir
  } else {
    dir ++ " (under " ++ io.cwd() ++ ")"
  }

fn origin_text(o: StdOrigin) -> String !Env =
  match o {
    StdFromDir(d) -> "the std in " ++ located(d)
    StdEmbedded -> "the std compiled into this toolchain"
  }

fn why_text(w: StdFail) -> String =
  match w {
    StdVersionSkew -> ""
    StdFileMissing(f, m) -> "`" ++ f ++ "` is in neither the directory nor the embedded copy: " ++ m
    StdModulesMissing(fs) -> {
      var named: List[String] = []
      for f in fs { named = named ++ ["`" ++ f ++ "`"] }
      "modules.txt lists modules this std has no file for: " ++ join(named, ", ") ++
        "\n  a std is read whole from where its modules.txt is; nothing is filled in from elsewhere"
    }
    StdModuleParse(mp, d) -> "module `" ++ mp ++ "` does not parse: " ++ d
    StdModuleCheck(mp, d) -> "module `" ++ mp ++ "` does not check: " ++ d
    StdModuleEval(mp, d) -> "module `" ++ mp ++ "` does not evaluate: " ++ d
    StdMovedMalformed(n, w) -> "`moved.txt` line ${n}: ${w}"
  }

## Whether this failure is the compiler's own fault. Only the embedded std is:
## it ships inside the same binary, so nothing a user did can make it disagree
## with the compiler that reads it.
pub fn std_load_is_bug(e: StdLoadError) -> Bool =
  match e.origin {
    StdEmbedded -> true
    StdFromDir(_) -> false
  }

## What to do about a std that failed for a reason other than its version.
## Three different answers, because three different things are wrong: the
## compiler is broken, the directory has been edited, or the directory is an
## unknown release and the version could not rule it in or out.
fn advice(e: StdLoadError) -> String =
  match e.origin {
    StdEmbedded ->
      "  This is a bug in dawn " ++ VERSION ++ ", not a problem with your project."
    StdFromDir(_) ->
      match e.declared {
        Some(v) ->
          "  That directory says it is " ++ v ++
          ", which is what this toolchain is, so the std has been edited."
        None ->
          join([
            "  That directory carries no VERSION stamp, so it is either older than " ++
              VERSION ++ " or assembled by hand.",
            "  Name a " ++ VERSION ++ " std with `--std <dir>`, or run where no `std`" ++
              " directory shadows the one compiled in."
          ], "\n")
      }
  }

## The one place a failed std load turns into words; both drivers render
## through it, so `scripts/native-cli-diff.sh` compares the same sentences.
pub fn std_load_error_text(e: StdLoadError) -> String !Env = {
  let head = origin_text(e.origin)
  match e.why {
    StdVersionSkew -> {
      let said = match e.declared {
        Some(v) -> v
        None -> "nothing"
      }
      join([
        "std version mismatch: " ++ head ++ " is " ++ said ++
          ", this toolchain is " ++ VERSION,
        "  a toolchain only ever checked the std it was released with.",
        "  Use the " ++ VERSION ++ " std, or run the " ++ said ++ " toolchain."
      ], "\n")
    }
    _ -> join(["${head} does not load", "  ${why_text(e.why)}", advice(e)], "\n")
  }
}

## Load, check and comptime-evaluate the bundled std from a directory.
pub(pkg) fn load_std(dir: String) -> Result[StdCtx, StdLoadError] !Fs !Env !io = {
  # modules.txt decides the whole load, so whichever half answers for it is
  # the std being loaded, and that is what the diagnostics below name.
  let (idx_text, idx_from_dir) = match std_read_from(dir, "modules.txt") {
    Ok(pair) -> pair
    Err(m) -> return Err(StdLoadError {
      origin: StdEmbedded,
      declared: Some(VERSION),
      why: StdFileMissing("modules.txt", m)
    })
  }
  let origin = if idx_from_dir { StdFromDir(dir) } else { StdEmbedded }
  let declared = if idx_from_dir { dir_declared_version(dir) } else { Some(VERSION) }
  # Checked before a single module is parsed: a skewed std fails much further
  # in, as a type error inside std that reads like a compiler bug, and by then
  # the version is not part of the story any more.
  match declared {
    Some(v) ->
      if v != VERSION {
        return Err(StdLoadError { origin: origin, declared: declared, why: StdVersionSkew })
      }
    None -> ()
  }
  let names = index_names(idx_text)
  # Every module's text before any is parsed, from the half that answered for
  # modules.txt alone, so a directory short of several modules is told about
  # all of them at once rather than one per run.
  var texts: List[(String, String)] = []
  var missing: List[String] = []
  for n in names {
    match std_module_text(dir, idx_from_dir, "${n}.dawn") {
      Some(t) -> { texts = texts ++ [(n, t)] }
      None -> { missing = missing ++ ["${n}.dawn"] }
    }
  }
  if len(missing) > 0 {
    return Err(StdLoadError { origin: origin, declared: declared, why: StdModulesMissing(missing) })
  }
  # The migration hints, from the same half as the modules and before any of
  # them is parsed. Optional: a std without the file has no hints, which is
  # every one-module std a test assembles and every copy of `*.dawn` plus
  # modules.txt; a hint is a sentence, and missing one changes no program.
  var moved_entries: List[MovedEntry] = []
  match std_module_text(dir, idx_from_dir, "moved.txt") {
    Some(t) ->
      match parse_moved(t) {
        Ok(es) -> { moved_entries = es }
        Err(bad) -> {
          let (n, w) = bad
          return Err(StdLoadError { origin: origin, declared: declared, why: StdMovedMalformed(n, w) })
        }
      }
    None -> ()
  }
  var exports: Map[String, ModExports] = map.empty()
  var std_fns: Map[String, Sig] = map.empty()
  var moved: Map[String, String] = map.empty()
  var fn_decls: Map[String, TFun] = map.empty()
  var by_owner: Map[String, Map[String, TFun]] = map.empty()
  var impl_fns: Map[(Int, String, String), (String, TFun)] = map.empty()
  var adts: Adts = map.empty()
  var impls: Impls = map.empty()
  # The id counter carried across std's modules. It opens where `cx_new` opens
  # it -- one past every prelude id -- rather than at a literal: this one said
  # 2 from before `ForeignError` took ADT id 2, and it is the copy the
  # production path actually reads, so the first id-claiming declaration in the
  # first std module would have been handed `ForeignError`'s slot and silently
  # replaced it.
  var interned: Map[Int, Minted] = map.empty()
  var mods: List[(String, Cx, TModule, CtOut)] = []
  var srcs: List[(String, String, Module)] = []
  var dir_modules: Map[String, String] = map.empty()
  var impls_before: Map[String, Impls] = map.empty()
  for entry in texts {
    let (n, text) = entry
    let mod_path = "std/${n}"
    # only a std the directory answered for has files: an embedded one has
    # none, and claiming `<dir>/<n>.dawn` for it would hand std identity to
    # whatever happens to sit at that path
    if idx_from_dir {
      dir_modules = map.insert(dir_modules, canon(dir ++ "/" ++ n ++ ".dawn"), mod_path)
    }
    let (m, pdiags) = parser.parse_module(text)
    if len(pdiags) > 0 {
      return Err(StdLoadError {
        origin: origin, declared: declared, why: StdModuleParse(mod_path, pdiags[0].msg)
      })
    }
    impls_before = map.insert(impls_before, mod_path, impls)
    var cx = cx_new(Some(mod_path), None)
    # said outright rather than left to `cx_new`'s name-shaped proposal: this
    # is the loader for the bundled library, so every module it builds a Cx
    # for is std by construction, whatever any of them is called
    cx = Cx {
      ..cx,
      is_std_module: true,
      line_starts: lexer.line_starts_of(text),
      identities: interned,
      impl_table: impls
    }
    # no std_fns here: std cannot implicitly import itself
    let (cx1, tm) = check_module(cx, m, exports)
    if len(cx1.diags) > 0 {
      return Err(StdLoadError {
        origin: origin, declared: declared, why: StdModuleCheck(mod_path, cx1.diags[0].msg)
      })
    }
    # std folds with no host FFI: it has no `use java` at all, and ct_default()
    # is where that stops being a convention
    let ct = eval_comptime(tm, fn_decls, by_owner, impl_fns, set.empty(), cx1.adts,
      cx1.traits, cx1.impl_table, mod_path, ct_default())
    if len(ct.diags) > 0 {
      return Err(StdLoadError {
        origin: origin, declared: declared, why: StdModuleEval(mod_path, ct.diags[0].msg)
      })
    }
    let exp = exports_of(cx1, m, mod_path, mod_path)
    exports = map.insert(exports, mod_path, exp)
    var own: Map[String, TFun] = map.empty()
    for f in tm.fns {
      fn_decls = note_direct_fn(fn_decls, f)
      own = note_direct_fn(own, f)
      impl_fns = note_trait_fn(impl_fns, mod_path, f)
    }
    by_owner = map.insert(by_owner, mod_path, own)
    for fname in map.keys(exp.fns) {
      if is_prelude(fname) {
        # only from the owning module: a prelude-named export elsewhere
        # (map.fold) keeps its qualified spelling and needs no hint either,
        # since the bare name still resolves through the owner's
        if mod_path == prelude_owner(fname) {
          std_fns = map.insert(std_fns, fname,
            map.get(exp.fns, fname).expect("prelude fn"))
        }
      } else {
        moved = map.insert(moved, fname, "use " ++ mod_path ++ ", then " ++ n ++ "." ++
            fname ++ "(...)")
      }
    }
    # union, like the impl table below it: std modules are checked with only
    # the prelude and their own `use` edges in scope, so a module that does
    # not import another does not carry that other's ADTs. Taking the last
    # module's table alone loses every ADT declared before it -- invisible
    # while no std module declared one, and a missing-adt-id panic the moment
    # one does.
    for pr in map.entries(cx1.adts) {
      let (k, v) = pr
      adts = map.insert(adts, k, v)
    }
    for pr in map.entries(cx1.impl_table) {
      let (k, v) = pr
      impls = map.insert(impls, k, v)
    }
    interned = cx1.identities
    mods = mods ++ [(mod_path, cx1, tm, ct)]
    srcs = srcs ++ [(mod_path, text, m)]
  }
  moved = install_moved(moved, moved_entries)
  var std_names: Set[String] = set.empty()
  for k in map.keys(fn_decls) { std_names = set.insert(std_names, k) }
  Ok(StdCtx {
    exports: exports,
    std_fns: std_fns,
    moved: moved,
    fn_decls: fn_decls,
    by_owner: by_owner,
    impl_fns: impl_fns,
    std_names: std_names,
    adts: adts,
    impls: impls,
    identities: interned,
    mods: mods,
    srcs: srcs,
    dir: match origin {
      StdFromDir(d) -> Some(canon(d))
      StdEmbedded -> None
    },
    dir_modules: dir_modules,
    impls_before: impls_before
  })
}

## The std module path `path` was loaded as, or `None` when this file is not
## one of the sources this compiler's std came from.
##
## Provenance, not spelling. Every caller that asks the question is holding a
## file path -- a `dawn check` target, an editor buffer -- and the two answers
## it has to keep apart look the same from the outside: `std/list.dawn` in the
## checkout `--std` pointed at is std, and `src/std/list.dawn` in somebody's
## project is not, however the module path reads.
##
## Comparison is lexical (`canon` normalizes, it does not resolve symlinks), so
## a std reached through a symlinked directory is not recognised through the
## other spelling. That fails closed: the file checks as user code and reports
## the std-only names it uses, which is the pre-existing behaviour.
pub(pkg) fn std_module_of(std: StdCtx, path: String) -> Option[String] !Env = {
  # an embedded std has no files at all, and canon() costs a cwd read
  if len(map.keys(std.dir_modules)) == 0 {
    let none: Option[String] = None
    return none
  }
  map.get(std.dir_modules, canon(path))
}

## The file this compiler read the std module `mod_path` from, or `None` when
## no file holds it because the embedded copy answered for that module.
##
## The inverse of `std_module_of`, over the same one table. Deliberately a scan
## rather than a second map built alongside `dir_modules`: the fact being asked
## for is "which file did this text come off", and `dir ++ "/" ++ name` would
## answer it for a module the embedded copy supplied, naming a file that either
## does not exist or is somebody else's.
##
## Today the answer is the same for every module of one std: a directory that
## answered for modules.txt supplied all of them, and the embedded copy none
## (#206). It stays a per-module question because that is the question every
## caller is holding.
pub(pkg) fn std_file_of(std: StdCtx, mod_path: String) -> Option[String] = {
  for pr in map.entries(std.dir_modules) {
    let (file, mp) = pr
    if mp == mod_path { return Some(file) }
  }
  None
}

## Is `dir` the very directory this compiler read its std from? Used to answer
## a directory target as what it is instead of as a malformed project.
pub(pkg) fn is_std_dir(std: StdCtx, dir: String) -> Bool !Env =
  match std.dir {
    Some(d) -> d == canon(dir)
    None -> false
  }

# ---- tests ----

fn put(p: String, text: String) -> Unit !Fs =
  match io.write_file(p, text) {
    Ok(_) -> ()
    Err(e) -> panic("test setup: ${e.message}")
  }

## Run `body` with no host environment behind it, for the tests below whose
## `--std` is an absolute directory of their own making: the working directory
## is a value none of them depend on, and a directory no host has says so.
fn no_host[T](body: fn() -> T !Env !Fs !io) -> T !Fs !io = {
  let (out, _) = envmem.with_env_table(envmem.TABLE_CWD, [], body)
  out
}

test "the embedded std matches std/ on disk" {
  # The real disk, deliberately: the working tree's std/ is the object under
  # assertion, so a table handler here would assert nothing.
  io.with_fs_real(() => {
    # the staleness gate for the generated stdsrc.dawn: an edit under std/
    # that forgot to regenerate fails here, in every `dawn test selfhost`
    let names = match read_index("std") {
      Ok(ns) -> ns
      Err(e) -> panic("std index: ${e}")
    }
    var files = ["modules.txt"]
    for n in names { files = files ++ ["${n}.dawn"] }
    # the migration hints ride along, and the loader reads them from the
    # embedded copy whenever the embedded copy answered for modules.txt
    match io.read_file("std/moved.txt") {
      Ok(_) -> { files = files ++ ["moved.txt"] }
      Err(_) -> ()
    }
    for f in files {
      let disk = match io.read_file("std/${f}") {
        Ok(t) -> t
        Err(e) -> panic("std/" ++ f ++ ": " ++ e.message)
      }
      match stdsrc.source(f) {
        Some(t) -> {
          if t != disk {
            println("stale embedded std: " ++ f ++ " (run python3 scripts/gen-stdsrc.py)")
          }
          assert t == disk
        }
        None -> {
          println("missing from embedded std: " ++ f ++ " (run python3 scripts/gen-stdsrc.py)")
          assert false
        }
      }
    }
  })
}

test "the loader's id counter opens past every prelude id" {
  io.with_fs_real(() => no_host(() => {
    # `load_std` used to open its counter at the literal 2, which is
    # `ForeignError`'s ADT id, and it is the counter the production path
    # actually reads. Nothing ever fired, for a reason that is not a
    # guarantee: std/cursor is first in modules.txt and its first declaration
    # is an `opaque type`, which claims no ADT id, so the opening value went to
    # a type variable instead -- a separate id space where a collision is
    # harmless. Reorder std, or give cursor a sum type, and the first minted ADT
    # id would land on `ForeignError`'s entry and replace it. A map insert has no
    # opinion about what was there, so the first symptom was several files away:
    # `e.message` on a `catch_fault` result, reported as a field access on
    # whatever the new ADT 2 happened to be.
    #
    # So this does not read the real std, whose declaration order is the very
    # thing not to depend on. It supplies a one-module std whose first
    # declaration is a plain sum type -- the case that does claim an id -- and
    # asks what the loader did with the prelude's ADT table.
    let root = "/tmp/dawn-selfhost-stdlib/idprobe"
    let _ = io.mkdirs(root)
    put("${root}/modules.txt", "idprobe\n")
    put("${root}/idprobe.dawn", "pub type IdProbe = | IpA | IpB\n")
    let probe = match load_std(root) {
      Ok(sc) -> sc
      Err(e) -> panic("probe std: ${std_load_error_text(e)}")
    }
    # the prelude ADTs came through unreplaced
    assert adt_of(probe.adts, OPTION_ID).name == "Option"
    assert adt_of(probe.adts, RESULT_ID).name == "Result"
    assert adt_of(probe.adts, FOREIGN_ERROR_ID).name == "ForeignError"
    # and the probe was minted an id of its own, past every prelude id
    var probe_id = -1
    for pr in map.entries(probe.adts) {
      let (i, a) = pr
      if a.name == "IdProbe" { probe_id = i }
    }
    assert probe_id >= first_minted_id()
  }))
}

test "production comptime body tables contain only direct std functions" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }

    # The real bundle supplies many impl bodies (std/list alone supplies Iter,
    # Eq, Hash, Ord and Show), so this is not a vacuous shape check. Bundled std
    # has no source trait default today; default_of is still checked because the
    # production table contract excludes both identities by the same rule.
    var saw_bundled_impl = false
    for entry in std.mods {
      let (mod_path, _cx, tm, _ct) = entry
      if mod_path == "std/list" {
        for f in tm.fns {
          match f.impl_of {
            Some(_) -> { saw_bundled_impl = true }
            None -> ()
          }
        }
      }
    }
    assert saw_bundled_impl

    for f in map.values(std.fn_decls) {
      assert f.impl_of == None
      assert f.default_of == None
    }
    for owner in map.keys(std.by_owner) {
      let tbl = map.get(std.by_owner, owner).expect("loaded owner table")
      for f in map.values(tbl) {
        assert f.impl_of == None
        assert f.default_of == None
      }
    }
  }))
}

test "the numeric parsers still have somewhere to land" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    # `lower` rewrites `parse_int(s)` into a direct call to std/fmt.atoi. Since
    # v0.55.0 those three are not exported, so no call site names them and no
    # export check sees them; the coupling is one table (`lower.parser_impl`) and
    # this is the other end.
    #
    # What this adds, measured rather than assumed (a rename of `atod` inside
    # std/fmt, tests and comments included, 2026-08-06): codegen already refuses
    # a `CDirect` to a name it cannot find -- `panic: codegen: unknown fn
    # std/fmt.atod` -- so the coupling is NOT silent, and the first claim written
    # here, that it stayed green until a NoSuchMethod at run time, was wrong.
    # What that panic depends on is somebody compiling a `parse_*` call, and
    # today that is only true because the compiler happens to use all three
    # (pkgfetch, lexer, interp). This test is what makes it true on purpose, and
    # it names the two ends instead of printing a mangled symbol.
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let own = match map.get(std.by_owner, "std/fmt") {
      Some(o) -> o
      None -> panic("std/fmt is not a loaded module")
    }
    for b in ["parse_int", "parse_int_radix", "parse_float"] {
      let target = match parser_impl(b) {
        Some(f) -> f
        None -> panic("lower has no std/fmt target for the builtin `" ++ b ++ "`")
      }
      assert map.has(own, target)
    }
    # and the builtins that must NOT be routed there
    assert parser_impl("to_string") == None
    assert parser_impl("atoi") == None
  }))
}

test "float rendering and parsing fold through std/fmt, not the host" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    # The RP-12 gate's float line, after audits RP-01/RP-05 moved the answers
    # into std: `to_string(Float)` lowers to std/fmt.dtoa and the parsers to
    # fmt.atoi/atod, so a comptime fold interprets the program's own std Core.
    # The expected strings below are spec §4.3's, written literally -- if the
    # fold ever rode a host renderer or host grammar again, a JDK could change
    # them out from under the spec and this test is what would say so.
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let src = "const A: String = comptime { to_string(0.1) }\n" ++
      "const B: String = comptime { to_string(3.0e-7) }\n" ++
      "const C: String = comptime { to_string(1.0e300) }\n" ++
      "const D: String = comptime { to_string(-0.0) }\n" ++
      "const E: String = comptime { to_string(0.0 / 0.0) }\n" ++
      "const F: String = comptime { to_string(1.0 / 0.0) }\n" ++
      "const G: String = comptime { to_string(9999999.0) }\n" ++
      "const H: String = comptime { to_string(10000000.0) }\n" ++
      "const P: Bool = comptime { parse_float(\"1.5f\") == None }\n" ++
      "const Q: Bool = comptime { parse_float(\"Infinity\") == Some(1.0 / 0.0) }\n" ++
      "const R: Bool = comptime { parse_int(\" 42 \") == Some(42) }\n" ++
      "const S: Bool = comptime { parse_int(\"9223372036854775808\") == None }\n"
    let (m, pdiags) = parser.parse_module(src)
    assert len(pdiags) == 0
    var cx = cx_new(None, None)
    cx = Cx { ..cx, identities: std.identities, impl_table: std.impls }
    let (cx1, tm) = check_module(cx, m, std.exports)
    assert len(cx1.diags) == 0
    let ct = eval_comptime(tm, std.fn_decls, std.by_owner, std.impl_fns,
      std.std_names, cx1.adts, cx1.traits, cx1.impl_table, "m", ct_default())
    if len(ct.diags) > 0 { println("FOLD DIAG: ${ct.diags[0].msg}") }
    assert len(ct.diags) == 0
    assert map.get(ct.consts, "A") == Some(VStr("0.1"))
    assert map.get(ct.consts, "B") == Some(VStr("3.0E-7"))
    assert map.get(ct.consts, "C") == Some(VStr("1.0E300"))
    assert map.get(ct.consts, "D") == Some(VStr("-0.0"))
    assert map.get(ct.consts, "E") == Some(VStr("NaN"))
    assert map.get(ct.consts, "F") == Some(VStr("Infinity"))
    assert map.get(ct.consts, "G") == Some(VStr("9999999.0"))
    assert map.get(ct.consts, "H") == Some(VStr("1.0E7"))
    assert map.get(ct.consts, "P") == Some(VBool(true))
    assert map.get(ct.consts, "Q") == Some(VBool(true))
    assert map.get(ct.consts, "R") == Some(VBool(true))
    assert map.get(ct.consts, "S") == Some(VBool(true))
  }))
}

test "the bundled std loads, checks and evaluates" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    match load_std("std") {
      Ok(std) -> {
        assert map.has(std.exports, "std/str")
        assert map.has(std.exports, "std/cursor")
        # the implicit surface is exactly the prelude names
        assert map.has(std.std_fns, "println")
        assert map.has(std.std_fns, "map")
        assert not map.has(std.std_fns, "trim")
        # ... harvested from their owning modules. `fold` is the name two
        # modules export: bare `fold` must stay std/list's (three parameters,
        # the subject a List), not map.fold, which the harvest would otherwise
        # take because std/map is checked later
        match map.get(std.std_fns, "fold") {
          Some(s) -> {
            assert s.owner == Some("std/list")
            match s.param_tys[0] {
              TyList(_) -> ()
              _ -> { assert false }
            }
          }
          None -> { assert false }
        }
        # everything else is reached through its module, and a bare use of
        # it is told which one
        assert map.get(std.moved, "trim") == Some("use std/str, then str.trim(...)")
        assert set.has(std.std_names, "trim")
      }
      Err(e) -> {
        println("STD LOAD FAILED: ${std_load_error_text(e)}")
        assert false
      }
    }
  }))
}

test "std/ stamps itself with this toolchain's version" {
  # The real disk, deliberately: the file in the working tree is the object
  # under assertion.
  io.with_fs_real(() => {
    # The stamp is only worth reading if it is kept true, and nothing about
    # editing `version.dawn` touches `std/VERSION`. This is what makes a release
    # that bumped one and not the other fail here instead of shipping a
    # toolchain that refuses its own std.
    let stamped = match io.read_file("std/VERSION") {
      Ok(t) -> str.trim(t)
      Err(e) -> panic("std/VERSION: ${e.message}")
    }
    if stamped != VERSION {
      println("std/VERSION says " ++ stamped ++ " but version.dawn says " ++ VERSION)
    }
    assert stamped == VERSION
  })
}

test "a std directory from another release is refused by version, not by symptom" {
  io.with_fs_real(() => no_host(() => {
    # The reachability half of the diagnostic. Before this, a std out of step
    # with the compiler surfaced wherever it first failed to type-check, and the
    # message that came out named a std module and a type error: true, and no
    # help at all in working out that the two halves came from different
    # releases.
    let root = "/tmp/dawn-selfhost-stdlib/skew"
    let _ = io.mkdirs(root)
    put("${root}/VERSION", "0.0.1-not-this-one\n")
    put("${root}/modules.txt", "skew\n")
    put("${root}/skew.dawn", "pub fn skew() -> Int = 1\n")
    match load_std(root) {
      Ok(_) -> {
        println("a std stamped 0.0.1-not-this-one loaded into a " ++ VERSION ++ " toolchain")
        assert false
      }
      Err(e) -> {
        # not the compiler's fault, and it says so rather than panicking
        assert not std_load_is_bug(e)
        let text = std_load_error_text(e)
        assert str.contains(text, "std version mismatch")
        # both halves are named, which is the whole point: one version alone
        # cannot tell you which of the two to change
        assert str.contains(text, "0.0.1-not-this-one")
        assert str.contains(text, VERSION)
        assert str.contains(text, root)
        # and the sentence that says what to do about it
        assert str.contains(text, "Use the " ++ VERSION ++ " std")
      }
    }
  }))
}

test "an unstamped std directory that will not load is not called a compiler bug" {
  io.with_fs_real(() => no_host(() => {
    # The other side of the same rule. A directory with no VERSION file is every
    # std published before the stamp existed, so it must stay loadable and its
    # failures must still point at the directory. Only the copy compiled into
    # this binary earns "this is a bug in dawn".
    let root = "/tmp/dawn-selfhost-stdlib/unstamped"
    let _ = io.mkdirs(root)
    put("${root}/modules.txt", "broken\n")
    put("${root}/broken.dawn", "pub fn broken() -> Int = \"not an Int\"\n")
    match load_std(root) {
      Ok(_) -> {
        println("a std whose only module does not check loaded anyway")
        assert false
      }
      Err(e) -> {
        assert not std_load_is_bug(e)
        let text = std_load_error_text(e)
        # the failure it actually hit, not a version claim it cannot make
        assert str.contains(text, "does not check")
        assert not str.contains(text, "std version mismatch")
        # the directory is named, and so is the reason there is no version to
        # compare against
        assert str.contains(text, root)
        assert str.contains(text, "no VERSION stamp")
        assert not str.contains(text, "bug in dawn")
      }
    }
  }))
}

test "a std directory with no modules.txt falls back to the embedded copy" {
  io.with_fs_real(() => no_host(() => {
    # `--std` pointed somewhere that has nothing to do with std is not a skew:
    # the embedded index answers, so the load is the embedded std's and must
    # succeed. This is the negative control for the version check, an absent
    # directory must not be reported as a version mismatch.
    let root = "/tmp/dawn-selfhost-stdlib/absent"
    let _ = io.mkdirs(root)
    match load_std("${root}/nothing-here") {
      Ok(std) -> { assert map.has(std.exports, "std/str") }
      Err(e) -> {
        println("embedded fallback failed: ${std_load_error_text(e)}")
        assert false
      }
    }
  }))
}

## `body` over an in-memory tree, with no host environment behind it either:
## what the loader reads is exactly what the test put there.
fn in_table[T](fs: fsmem.MemFs, body: fn() -> T !Env !Fs !io) -> T !io = {
  let (out, _) = fsmem.with_fs_mem(fs, () => no_host(body))
  out
}

## std/str as the embedded copy has it, except that `to_upper` lowers. A file
## that parses and checks, so the only way to tell it was read is what it
## computes.
fn lowering_str() -> String = {
  let real = match stdsrc.source("str.dawn") {
    Some(t) -> t
    None -> panic("the embedded std carries no str.dawn")
  }
  let line = "pub fn to_upper(s: String) -> String = str_upper(s)"
  if not str.contains(real, line) { panic("std/str.to_upper no longer reads: " ++ line) }
  str.replace(real, line, "pub fn to_upper(s: String) -> String = str_lower(s)")
}

test "a std directory missing modules it lists is refused, naming every one" {
  # #206. The directory answered for modules.txt, so it is the std being
  # loaded; a module it lacks used to be read from the embedded copy instead,
  # silently, and the program ran against a std assembled from two places.
  let root = fsmem.mem_std_dir(fsmem.MEM_BASE)
  let got = in_table(fsmem.mem_std(fsmem.MEM_BASE), () => {
    let _ = io.delete("${root}/map.dawn")
    let _ = io.delete("${root}/set.dawn")
    match load_std(root) {
      Ok(_) -> None
      Err(e) -> Some((e, std_load_error_text(e)))
    }
  })
  match got {
    None -> {
      println("a std directory without map.dawn and set.dawn loaded anyway")
      assert false
    }
    Some(pair) -> {
      let (e, text) = pair
      # all of them at once, in modules.txt order, before anything was parsed
      assert e.why == StdModulesMissing(["map.dawn", "set.dawn"])
      assert e.origin == StdFromDir(root)
      # the user's directory, not the compiler
      assert not std_load_is_bug(e)
      assert str.contains(text, "`map.dawn`")
      assert str.contains(text, "`set.dawn`")
      assert str.contains(text, root)
    }
  }
}

test "a std directory with no modules.txt is not read at all" {
  # #206. The embedded copy answered for modules.txt, so every module is the
  # embedded one; a lone `str.dawn` in the directory used to replace it and be
  # recorded as std's file for `std/str`.
  let st = fsmem.mem_put(fsmem.mem_empty(fsmem.MEM_BASE), "std/str.dawn", lowering_str())
  let std = in_table(st, () => match load_std(fsmem.mem_std_dir(fsmem.MEM_BASE)) {
    Ok(s) -> s
    Err(e) -> panic("embedded std: ${std_load_error_text(e)}")
  })
  let absent: Option[String] = None
  assert std_file_of(std, "std/str") == absent
  assert std.dir == absent
  assert len(map.keys(std.dir_modules)) == 0
  var text = ""
  for s in std.srcs {
    let (mp, t, _) = s
    if mp == "std/str" { text = t }
  }
  assert Some(text) == stdsrc.source("str.dawn")
}

test "a stray std/str.dawn under the working directory changes no program" {
  # #206, end to end through load, check and comptime evaluation. The command
  # line's default `--std` is the relative `std`, resolved here against the
  # table's base: the working directory of this test. That directory holds a
  # std/str.dawn whose `to_upper` lowers and no modules.txt. Before the fix the
  # same source answered `hello` from that directory and `HELLO` from any
  # other.
  let st = fsmem.mem_put(fsmem.mem_empty(fsmem.MEM_BASE), "std/str.dawn", lowering_str())
  let got = in_table(st, () => {
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("embedded std: ${std_load_error_text(e)}")
    }
    let src = "use std/str\n" ++
      "const U: String = comptime { str.to_upper(\"Hello\") }\n"
    let (m, pdiags) = parser.parse_module(src)
    assert len(pdiags) == 0
    var cx = cx_new(None, None)
    cx = Cx { ..cx, identities: std.identities, impl_table: std.impls }
    let (cx1, tm) = check_module(cx, m, std.exports)
    assert len(cx1.diags) == 0
    let ct = eval_comptime(tm, std.fn_decls, std.by_owner, std.impl_fns,
      std.std_names, cx1.adts, cx1.traits, cx1.impl_table, "m", ct_default())
    assert len(ct.diags) == 0
    map.get(ct.consts, "U")
  })
  assert got == Some(VStr("HELLO"))
}

test "a std module's file is only known when a directory supplied it" {
  # the real handler stays: `load_std("std")` names a relative directory, so
  # the working directory this runs in is one of the inputs.
  io.with_fs_real(() => io.with_env_real(() => {
    # `std_file_of` is what lets a reader jump into std, and the answer it must
    # not invent is the one for a module the embedded copy filled in: there is no
    # file, and naming `<dir>/<name>.dawn` anyway would point at whatever happens
    # to sit there.
    let std = match load_std("std") {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    let f = match std_file_of(std, "std/list") {
      Some(p) -> p
      None -> panic("std/list came off the directory and has a file")
    }
    # the same one fact read in both directions, not two records that could drift
    assert std_module_of(std, f) == Some("std/list")
    # absolute, because that is the spelling `dir_modules` is keyed by and the
    # spelling a definition reply has to survive being resolved from any cwd
    assert str.starts_with(f, "/")
    assert str.ends_with(f, "/std/list.dawn")
    # a module path no std ever had
    let absent: Option[String] = None
    assert std_file_of(std, "std/not-a-module") == absent

    # and the embedded half: every module loaded, none of them has a file
    let root = "/tmp/dawn-selfhost-stdlib/absent"
    let _ = io.mkdirs(root)
    match load_std("${root}/nothing-here") {
      Ok(emb) -> {
        assert map.has(emb.exports, "std/list")
        assert std_file_of(emb, "std/list") == absent
        assert emb.dir == absent
      }
      Err(e) -> panic("embedded fallback failed: ${std_load_error_text(e)}")
    }
  }))
}

## The diagnostic among `ds` whose message is `msg`, if any.
fn diag_with(ds: List[Diag], msg: String) -> Option[Diag] = {
  for d in ds {
    if d.msg == msg { return Some(d) }
  }
  None
}

test "a std/moved.txt entry answers both kinds of call with its hint" {
  io.with_fs_real(() => no_host(() => {
    # The shipped moved.txt has no live entries today (every one the two old
    # tables held had expired, docs/std-moved-design.md §2), so the path from
    # the file to the diagnostic is pinned on a std of this test's own.
    let root = "/tmp/dawn-selfhost-stdlib/moved"
    let _ = io.mkdirs(root)
    put("${root}/modules.txt", "mv\n")
    put("${root}/mv.dawn", "pub fn fresh() -> Int = 1\nfn kept() -> Int = 2\n")
    put("${root}/moved.txt", join([
      "# scope old new since until hint",
      "std/mv stale mv.fresh 0.79.0 0.89.0 renamed: write `mv.fresh()`",
      "std/mv kept - 0.79.0 0.89.0 std-internal now: write `fresh()`",
      "builtin old_flat mv.fresh 0.79.0 0.89.0 use std/mv, then mv.fresh()",
      "std/mv gone - 0.79.0 0.89.0 no-hint",
      ""
    ], "\n"))
    let std = match load_std(root) {
      Ok(s) -> s
      Err(e) -> panic("std: ${std_load_error_text(e)}")
    }
    # a `no-hint` line is a decision for the gate, not a hint
    assert not map.has(std.moved, moved_module_key("std/mv", "gone"))
    let src = join([
      "use std/mv",
      "pub fn a() -> Int = mv.stale()",
      "pub fn b() -> Int = mv.kept()",
      "pub fn c() -> Int = old_flat()",
      ""
    ], "\n")
    let (m, pdiags) = parser.parse_module(src)
    assert len(pdiags) == 0
    var cx = cx_new(None, None)
    cx = Cx { ..cx, identities: std.identities, impl_table: std.impls, moved: std.moved }
    let (cx1, _) = check_module(cx, m, std.exports)
    # the qualified entry, in the shape the checker's hand-kept table had
    match diag_with(cx1.diags, "module `std/mv` has no exported function `stale`") {
      Some(d) -> { assert d.hint == "renamed: write `mv.fresh()`" }
      None -> panic("no diagnostic for mv.stale()")
    }
    # asked before the private branch: a name std still declares is not told
    # to add `pub` to std
    match diag_with(cx1.diags, "module `std/mv` has no exported function `kept`") {
      Some(d) -> { assert d.hint == "std-internal now: write `fresh()`" }
      None -> panic("no diagnostic for mv.kept()")
    }
    # the flat entry, through `moved_or_suggest`
    match diag_with(cx1.diags, "undefined function: old_flat") {
      Some(d) -> { assert d.hint == "`old_flat` is not a builtin; use std/mv, then mv.fresh()" }
      None -> panic("no diagnostic for old_flat()")
    }
  }))
}

test "a malformed std/moved.txt fails the load with its line" {
  io.with_fs_real(() => no_host(() => {
    let root = "/tmp/dawn-selfhost-stdlib/moved-bad"
    let _ = io.mkdirs(root)
    put("${root}/modules.txt", "mv\n")
    put("${root}/mv.dawn", "pub fn fresh() -> Int = 1\n")
    put("${root}/moved.txt", "# header\n\nstd/mv stale mv.fresh 0.89.0 0.79.0 until before since\n")
    match load_std(root) {
      Ok(_) -> panic("a moved.txt whose until precedes its since loaded")
      Err(e) -> {
        assert not std_load_is_bug(e)
        assert str.contains(std_load_error_text(e), "`moved.txt` line 3: until 0.79.0 is not after since 0.89.0")
      }
    }
  }))
}

test "moved.txt lines are parsed or refused one field at a time" {
  let ok = match parse_moved("builtin  a\tstr.b  0.1.0 0.11.0   the rest, verbatim  # comment\n") {
    Ok(es) -> es
    Err(bad) -> {
      let (n, w) = bad
      panic("line ${n}: ${w}")
    }
  }
  assert len(ok) == 1
  assert ok[0].scope == "builtin" && ok[0].old == "a" && ok[0].replacement == "str.b"
  assert ok[0].since == "0.1.0" && ok[0].until == "0.11.0"
  assert ok[0].hint == "the rest, verbatim"
  for bad in [
    "builtin a b 0.1.0 0.11.0",
    "lib/x a b 0.1.0 0.11.0 hint",
    "builtin a b 0.1 0.11.0 hint",
    "builtin a b 0.1.0 +0.11.0 hint",
    "builtin a b 0.11.0 0.11.0 hint",
    "builtin a b 0.1.0 0.11.0 hint\nbuiltin a c 0.2.0 0.12.0 again"
  ] {
    match parse_moved(bad) {
      Ok(_) -> panic("accepted: ${bad}")
      Err(_) -> ()
    }
  }
  assert release_before((0, 9, 0), (0, 10, 0))
  assert not release_before((1, 0, 0), (0, 99, 0))
}

test "no std/moved.txt entry has outlived its until" {
  # The expiry rule (docs/std-moved-design.md §2): once VERSION reaches an
  # entry's `until`, the entry is deleted or its `until` is moved, and either
  # way somebody decided. The embedded copy is read because it is what ships;
  # the round-trip test above holds it to std/ on disk.
  let text = match stdsrc.source("moved.txt") {
    Some(t) -> t
    None -> panic("std/moved.txt is not embedded (run python3 scripts/gen-stdsrc.py)")
  }
  let now = release_key(VERSION).expect("VERSION is X.Y.Z")
  let entries = match parse_moved(text) {
    Ok(es) -> es
    Err(bad) -> {
      let (n, w) = bad
      panic("std/moved.txt line ${n}: ${w}")
    }
  }
  var expired = 0
  for e in entries {
    let until = release_key(e.until).expect("parse_moved checked it")
    if not release_before(now, until) {
      println("std/moved.txt: `${e.old}` of `${e.scope}` expired at ${e.until}; this is ${VERSION}")
      expired = expired + 1
    }
  }
  assert expired == 0
}

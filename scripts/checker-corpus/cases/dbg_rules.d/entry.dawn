# checker.dawn: where `dbg` may be written (docs/source-location-design.md
# section 6). The project's own module may call it, directly or through a
# pipe; it may not take it as a value, which has no call site and no argument
# text to print. The dependency's calls are refused (lib/src/calc.dawn).
use lib/calc

fn shown(n: Int) -> Int = dbg(calc.double(n)) + (n |> dbg)

fn taken() -> fn(Int) -> Int = dbg

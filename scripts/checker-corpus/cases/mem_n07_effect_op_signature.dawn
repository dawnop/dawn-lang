# checker.dawn: rule R3, the operation signature (N7). A handler installed
# outside `with_mem` answers in the place it was installed, so an operation
# that takes a buffer lets the arm keep it past the scope.
effect Stash {
  fn stash(b: I64Buf) -> Unit
}

effect Fetch {
  fn fetch() -> I64Buf
}

effect Nested {
  fn many(bs: List[I64Buf]) -> Unit
}

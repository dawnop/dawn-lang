        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [Permute(d, dtype, shape, perm, src)]
        d
      }
      t_num_blocks(axis) => {
        if axis < 0 || axis > 2 { refuse(name, "num_blocks axis is 0, 1 or 2, got ${axis}") } else { () }
        held = hold(held, next, "i32", [])
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [NumBlocks(d, axis)]
        d
      }
      t_tok_get() => tok
      t_shape_of(h) => {
        # The row, as `Held` describes it (a view's included). A handle
        # with no row is refused under the number of the operation about
        # to be recorded and the kernel's call asking (the innermost one
        # open, which is the call that needed the shape); outside one,
        # under the query's own name.
        let row = open_row(marks)
        let asking = if row >= 0 { calls[row].name } else { "t_shape_of" }
        match map.get(held, h) {
          Some(x) -> (x.dtype, x.shape)
          None -> refuse_at(name, frames, ops, asking, "handle ${h} has no recorded shape: it is a token, or no operation answered it")
        }
      }
      t_tok_set(t) => {
        tok = t
        ()
      }
      t_tok_join(toks) => {
        let open = frames
        if list.any(open, is_pure_region) {
          refuse(name, "a token join inside a reduce, scan or if region has no memory order")
        } else {
          ()
        }
        if len(toks) < 2 { refuse(name, "join_tokens wants two or more tokens, got ${len(toks)}") } else { () }
        check_fork(name, frames, ops, toks)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [JoinToks(d, toks)]
        tok = d
        d
      }
      t_ptrs(param, dtype, shape) => {
        check_param(name, params, param, dtype, "pointer tile")
        check_shape(name, shape)
        held = hold(held, next, ptr_of(dtype), shape)
        aims = map.insert(aims, next, param)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [MakePtrs(d, param, dtype, shape)]
        d
      }
      t_ptr_offset(dtype, shape, ptrs, offs0) => {
        check_shape(name, shape)
        let (g, offs) = widen(name, frames, grown(next, ops, held, spreads, pending), offs0, "i32", shape)
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        held = hold(held, next, ptr_of(dtype), shape)
        aims = follow(aims, ptrs, next)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [PtrAdd(d, dtype, shape, ptrs, offs)]
        d
      }
      t_ptr_to_int(dtype, shape, ptrs) => {
        check_shape(name, shape)
        held = hold(held, next, "i64", shape)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [PtrInt(d, dtype, shape, ptrs)]
        d
      }
      t_int_to_ptr(dtype, shape, ints0) => {
        check_shape(name, shape)
        let (g, ints) = settle(name, frames, grown(next, ops, held, spreads, pending), ints0)
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        held = hold(held, next, ptr_of(dtype), shape)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [IntPtr(d, dtype, shape, ints)]
        d
      }
      t_ptr_to_ptr(from, to, shape, ptrs) => {
        check_shape(name, shape)
        held = hold(held, next, ptr_of(to), shape)
        aims = follow(aims, ptrs, next)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [PtrCast(d, from, to, shape, ptrs)]
        d

build/
*.jar
*.class
# the native release artifact (scripts/release-native.sh builds it here)
/dawnc-linux-x86_64
/dawnc-linux-x86_64.sha256
# the bootstrap seed cache (bin/dawn downloads the pinned release jar here)
.dawn/
.idea/
.DS_Store
node_modules/
*.vsix

# M5 site
site/dist/
site/build/

# play-ui (built locally, vendored into site/assets)
site/play-ui/node_modules/
site/play-ui/dist/
site/play-ui/src/builtins.generated.ts
site/build/

# tool state (worktrees, session scratch)
.claude/

# python bytecode from the corpus tooling
__pycache__/

# stray cc/ld output: the native work drives a C compiler by hand often enough
# that an a.out or a loose object lands in the root
/a.out
*.o

# the demo reactor: examples/projects/tea_dom_counter/web/index.html loads it,
# `dawnc build --target wasm --reactor` produces it, and it is 480 KB of build
# output. scripts/wasm-dom-contract builds its own into a scratch directory.
*.wasm

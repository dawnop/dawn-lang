# expect: expected a variable name
# expect: expected an expression, found `alias`
# `alias` is a keyword (spec 2.6), so it cannot be a binding name. The header
# used to read `# expect: alias`, which the old harness satisfied from the
# *second* diagnostic -- the case never checked that the binding position is
# where the parser complains first.
fn f() -> Int = {
  let alias = 1
  alias
}

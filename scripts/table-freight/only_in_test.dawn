use std/str

# The point of this file is what it does NOT contain: no code outside the test
# block touches the Unicode tables. Adding a `str.to_upper` (or any char_is_*)
# to `shout` would make the gate pass for the wrong reason.
pub fn shout(s: String) -> String = s ++ "!"

test "the whole program's Unicode table use is in here" {
  assert shout("dawn") == "dawn!"
  # simple case mapping: dawn/rt/Strings.str_upper, backed by the case table
  assert str.to_upper("dawn") == "DAWN"
  assert str.to_lower("DAWN") == "dawn"
  # classification: the class table
  assert char_is_letter('a')
  assert char_is_space(' ')
}

# A declared callback axis includes actual free resource witnesses.
use std/mem
type Cond = { n: Int }
impl StagedCond[Cond, ^{}] {
  fn staged_if(cond: Cond, yes: fn() -> Unit ^{}, no: fn() -> Unit ^{}) -> Unit =
    if cond.n > 0 { yes() } else { no() }
}
pub fn main() -> Unit !io = {
  let answer = mem.with_mem([@s] () => {
    let buffer = mem.new(3)
    let condition = Cond { n = 1 }
    if condition { if len(buffer) != 3 { panic("incorrect length") } }
    7
  })
  println(to_string(answer))
}

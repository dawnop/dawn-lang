# Block-level parser for the Markdown subset used by docs/. Anything outside
# the subset is a hard Err, so the site generator doubles as a docs lint.

use std/str
use md/ast.{Inline, Text, Code, Bold, Block, Heading, Para, CodeBlock, UList, OList, Table, Quote, Rule}
use md/inline.{parse_inlines}
use md/text.{cp_at, indent_of, strip_indent}

fn line_at(lines: List[String], i: Int) -> String = unwrap_or(get(lines, i), "")

fn is_blank(s: String) -> Bool = str.trim(s) == ""

fn is_fence(s: String) -> Bool = str.starts_with(s, "```")

fn is_hr(s: String) -> Bool = str.trim(s) == "---"

fn is_quote(s: String) -> Bool = str.starts_with(s, ">")

fn is_table_line(s: String) -> Bool = str.starts_with(s, "|")

fn is_marker_ul(s: String) -> Bool = str.starts_with(s, "- ")

## Width of an ordered list marker ("12. " -> 4), or 0 when there is none.
fn marker_ol(s: String) -> Int = {
  let cs = code_points(s)
  var i = 0
  while cp_at(cs, i) >= '0' && cp_at(cs, i) <= '9' {
    i = i + 1
  }
  if i > 0 && cp_at(cs, i) == '.' && cp_at(cs, i + 1) == ' ' { i + 2 } else { 0 }
}

fn starts_block(s: String) -> Bool =
  is_fence(s) || str.starts_with(s, "#") || is_hr(s) || is_table_line(s) ||
  is_quote(s) || is_marker_ul(s) || marker_ol(s) > 0

## Parse a whole document.
pub fn parse(src: String) -> Result[List[Block], String] =
  parse_blocks(strip_comments(str.split(src, "\n")))

fn opens_comment(cs: List[Int], i: Int) -> Bool =
  cp_at(cs, i) == '<' && cp_at(cs, i + 1) == '!' &&
  cp_at(cs, i + 2) == '-' && cp_at(cs, i + 3) == '-'

fn closes_comment(cs: List[Int], i: Int) -> Bool =
  cp_at(cs, i) == '-' && cp_at(cs, i + 1) == '-' && cp_at(cs, i + 2) == '>'

## Strip the HTML comments out of one line. `carry` says a comment was left
## open by an earlier line; the returned flag says one is still open here.
## Fenced code never reaches this function, and an inline code span keeps its
## `<!--` verbatim — a doc that *talks about* a marker still shows it.
fn strip_line_comments(line: String, carry: Bool) -> (String, Bool) = {
  let cs = code_points(line)
  let n = len(cs)
  var out: List[Int] = []
  var in_comment = carry
  var in_code = false
  var i = 0
  while i < n {
    let c = cp_at(cs, i)
    if in_comment {
      if closes_comment(cs, i) {
        in_comment = false
        i = i + 3
        # "a <!-- c --> b" must not leave a double space where the comment was
        if len(out) > 0 && cp_at(out, len(out) - 1) == ' ' && cp_at(cs, i) == ' ' {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    } else if c == '`' {
      in_code = not in_code
      out = out ++ [c]
      i = i + 1
    } else if not in_code && opens_comment(cs, i) {
      in_comment = true
      i = i + 4
    } else {
      out = out ++ [c]
      i = i + 1
    }
  }
  (from_code_points(out), in_comment)
}

## Drop HTML comments before the block scan. The subset has no raw HTML, so a
## comment left in place would be escaped and printed at the reader — and
## docs/ carries machine markers written that way (`<!-- doc-check: version -->`).
## A comment may end a line or span several. A line that is nothing but comment
## disappears entirely rather than turning blank, so a paragraph wrapped around
## one does not get split in two.
fn strip_comments(lines: List[String]) -> List[String] = {
  let n = len(lines)
  var out: List[String] = []
  var in_fence = false
  var in_comment = false
  var i = 0
  while i < n {
    let line = line_at(lines, i)
    # a fence marker may be indented (inside a list item), so trim before asking
    let fence = is_fence(str.trim(line))
    if in_fence {
      out = out ++ [line]
      if fence {
        in_fence = false
      }
    } else if fence && not in_comment {
      out = out ++ [line]
      in_fence = true
    } else {
      let carry = in_comment
      let (rest, still) = strip_line_comments(line, carry)
      in_comment = still
      if rest == line {
        out = out ++ [line]
      } else {
        # only the seam left by the comment is trimmed; a line that resumed
        # mid-comment also loses the indent the comment used to hold
        let kept = if carry { str.trim(rest) } else { str.trim_end(rest) }
        if kept != "" {
          out = out ++ [kept]
        }
      }
    }
    i = i + 1
  }
  out
}

fn parse_blocks(lines: List[String]) -> Result[List[Block], String] = {
  let n = len(lines)
  var out: List[Block] = []
  var err = ""
  var i = 0
  while err == "" && i < n {
    let line = line_at(lines, i)
    if is_blank(line) {
      i = i + 1
    } else if is_fence(line) {
      match scan_fence(lines, i) {
        Ok(step) -> {
          let (b, j) = step
          out = out ++ [b]
          i = j
        }
        Err(e) -> {
          err = e
        }
      }
    } else if str.starts_with(line, "#") {
      match heading(line) {
        Ok(b) -> {
          out = out ++ [b]
          i = i + 1
        }
        Err(e) -> {
          err = e
        }
      }
    } else if is_hr(line) {
      out = out ++ [Rule]
      i = i + 1
    } else if is_quote(line) {
      match scan_quote(lines, i) {
        Ok(step) -> {
          let (b, j) = step
          out = out ++ [b]
          i = j
        }
        Err(e) -> {
          err = e
        }
      }
    } else if is_table_line(line) {
      match scan_table(lines, i) {
        Ok(step) -> {
          let (b, j) = step
          out = out ++ [b]
          i = j
        }
        Err(e) -> {
          err = e
        }
      }
    } else if is_marker_ul(line) || marker_ol(line) > 0 {
      match scan_list(lines, i, marker_ol(line) > 0) {
        Ok(step) -> {
          let (b, j) = step
          out = out ++ [b]
          i = j
        }
        Err(e) -> {
          err = e
        }
      }
    } else {
      var body: List[String] = []
      var stop = false
      while not stop && i < n {
        let l = line_at(lines, i)
        if is_blank(l) || starts_block(l) {
          stop = true
        } else {
          body = body ++ [l]
          i = i + 1
        }
      }
      out = out ++ [Para(parse_inlines(join(body, "\n")))]
    }
  }
  if err == "" { Ok(out) } else { Err(err) }
}

## ``` fenced code; "dawn skip-check" (a tutorial test marker) renders as dawn.
fn scan_fence(lines: List[String], start: Int) -> Result[(Block, Int), String] = {
  let first = line_at(lines, start)
  let raw = str.trim(str.drop(first, 3))
  let lang = if raw == "dawn skip-check" { "dawn" } else { raw }
  let n = len(lines)
  var body: List[String] = []
  var i = start + 1
  var closed = false
  while not closed && i < n {
    let l = line_at(lines, i)
    if str.trim(l) == "```" {
      closed = true
    } else {
      body = body ++ [l]
    }
    i = i + 1
  }
  if closed {
    Ok((CodeBlock(lang, join(body, "\n")), i))
  } else {
    Err("unclosed code fence: $first")
  }
}

fn heading(line: String) -> Result[Block, String] = {
  let cs = code_points(line)
  var lvl = 0
  while cp_at(cs, lvl) == '#' {
    lvl = lvl + 1
  }
  if lvl > 4 {
    Err("heading deeper than #### is outside the subset: $line")
  } else if cp_at(cs, lvl) == ' ' {
    Ok(Heading(lvl, parse_inlines(str.trim(str.drop(line, lvl + 1)))))
  } else {
    Err("malformed heading: $line")
  }
}

fn quote_body(l: String) -> String =
  if str.starts_with(l, "> ") { str.drop(l, 2) } else { str.drop(l, 1) }

fn scan_quote(lines: List[String], start: Int) -> Result[(Block, Int), String] = {
  let n = len(lines)
  var body: List[String] = []
  var i = start
  while i < n && is_quote(line_at(lines, i)) {
    body = body ++ [quote_body(line_at(lines, i))]
    i = i + 1
  }
  let bs = parse_blocks(body)?
  Ok((Quote(bs), i))
}

## Split a table row into trimmed cells; `|` inside inline code does not split.
fn split_cells(line: String) -> List[String] = {
  let cs = code_points(str.trim(line))
  let n = len(cs)
  var cells: List[String] = []
  var run: List[Int] = []
  var in_code = false
  var i = if cp_at(cs, 0) == '|' { 1 } else { 0 }
  while i < n {
    let c = cp_at(cs, i)
    if c == '\\' && cp_at(cs, i + 1) == '|' {
      # \| is a literal pipe in a table row (even inside inline code)
      run = run ++ ['|']
      i = i + 1
    } else if c == '`' {
      in_code = not in_code
      run = run ++ [c]
    } else if c == '|' && not in_code {
      cells = cells ++ [str.trim(from_code_points(run))]
      run = []
    } else {
      run = run ++ [c]
    }
    i = i + 1
  }
  if len(run) > 0 {
    cells ++ [str.trim(from_code_points(run))]
  } else {
    cells
  }
}

fn is_sep_cell(cell: String) -> Bool = {
  let cs = code_points(cell)
  var ok = len(cs) > 0
  var i = 0
  while i < len(cs) {
    let c = cp_at(cs, i)
    if c != '-' && c != ':' {
      ok = false
    }
    i = i + 1
  }
  ok
}

fn is_sep_row(line: String) -> Bool = {
  let cells = split_cells(line)
  len(cells) > 0 && len(filter(cells, c => not is_sep_cell(c))) == 0
}

fn scan_table(lines: List[String], start: Int) -> Result[(Block, Int), String] = {
  let n = len(lines)
  var rows: List[String] = []
  var i = start
  while i < n && is_table_line(line_at(lines, i)) {
    rows = rows ++ [line_at(lines, i)]
    i = i + 1
  }
  if len(rows) < 2 || not is_sep_row(line_at(lines, start + 1)) {
    Err("table needs a header and a separator row: ${line_at(lines, start)}")
  } else {
    let header = map(split_cells(line_at(lines, start)), parse_inlines)
    var data: List[List[List[Inline]]] = []
    var r = 2
    while r < len(rows) {
      data = data ++ [map(split_cells(unwrap_or(get(rows, r), "")), parse_inlines)]
      r = r + 1
    }
    Ok((Table(header, data), i))
  }
}

## A list run. Each item owns its continuation lines (indented by the marker
## width for ordered, 2 for unordered), reparsed recursively as blocks — so
## nested lists and fenced code inside an item just work.
fn scan_list(lines: List[String], start: Int, ordered: Bool) -> Result[(Block, Int), String] = {
  let n = len(lines)
  var items: List[List[Block]] = []
  var i = start
  var stop = false
  var err = ""
  while not stop && err == "" && i < n {
    let line = line_at(lines, i)
    let w = if ordered { marker_ol(line) } else { if is_marker_ul(line) { 2 } else { 0 } }
    if w == 0 {
      stop = true
    } else {
      var body: List[String] = [str.drop(line, w)]
      let cont = if ordered { w } else { 2 }
      i = i + 1
      var more = true
      while more && i < n {
        let l = line_at(lines, i)
        if is_blank(l) || indent_of(l) >= cont {
          body = body ++ [strip_indent(l, cont)]
          i = i + 1
        } else {
          more = false
        }
      }
      match parse_blocks(body) {
        Ok(bs) -> {
          items = items ++ [bs]
        }
        Err(e) -> {
          err = e
        }
      }
    }
  }
  if err == "" {
    Ok((if ordered { OList(items) } else { UList(items) }, i))
  } else {
    Err(err)
  }
}

test "headings, paragraphs, rules" {
  assert parse("# 标题\n\n一段话。\n\n---\n") ==
    Ok([Heading(1, [Text("标题")]), Para([Text("一段话。")]), Rule])
  assert parse("## 二级 `code`") == Ok([Heading(2, [Text("二级 "), Code("code")])])
}

test "multi-line paragraphs join with a newline" {
  assert parse("第一行\n第二行\n") == Ok([Para([Text("第一行\n第二行")])])
}

test "fenced code keeps its body verbatim" {
  assert parse("```dawn\nfn main() -> Unit\n```\n") ==
    Ok([CodeBlock("dawn", "fn main() -> Unit")])
  assert parse("```dawn skip-check\nx\n```\n") == Ok([CodeBlock("dawn", "x")])
  assert parse("```\n# not a heading\n```\n") == Ok([CodeBlock("", "# not a heading")])
  match parse("```dawn\nnever closed\n") {
    Ok(_) -> {
      assert false
    }
    Err(e) -> {
      assert str.contains(e, "unclosed")
    }
  }
}

test "unordered lists nest by indentation" {
  let src = "- 甲\n- 乙\n  - 乙一\n"
  assert parse(src) ==
    Ok([UList([
      [Para([Text("甲")])],
      [Para([Text("乙")]), UList([[Para([Text("乙一")])]])],
    ])])
}

test "ordered lists carry marker-width continuations" {
  let src = "1. 首行\n   续行\n2. 次项\n"
  assert parse(src) ==
    Ok([OList([
      [Para([Text("首行\n续行")])],
      [Para([Text("次项")])],
    ])])
}

test "a fenced block indented under a list item belongs to the item" {
  let src = "- 条目：\n\n  ```\n  code\n  ```\n\n- 下一条\n"
  assert parse(src) ==
    Ok([UList([
      [Para([Text("条目：")]), CodeBlock("", "code")],
      [Para([Text("下一条")])],
    ])])
}

test "tables split on pipes but not inside inline code" {
  let src = "| 形式 | 说明 |\n|------|------|\n| `a \\| b` | 竖线在码内 |\n"
  assert parse(src) ==
    Ok([Table(
      [[Text("形式")], [Text("说明")]],
      [[[Code("a | b")], [Text("竖线在码内")]]],
    )])
}

test "quotes reparse their body" {
  assert parse("> 引用 **加粗**\n") ==
    Ok([Quote([Para([Text("引用 "), Bold([Text("加粗")])])])])
}

test "html comments are dropped, never printed" {
  # the shape docs/spec.md uses: a machine marker at the end of a sentence
  assert parse("状态：**权威**。<!-- doc-check: version -->\n") ==
    Ok([Para([Text("状态："), Bold([Text("权威")]), Text("。")])])
  # a comment on its own line leaves no blank line behind, so the paragraph
  # around it stays one paragraph
  assert parse("第一行\n<!-- 注释 -->\n第二行\n") == Ok([Para([Text("第一行\n第二行")])])
  # ... and the same when the comment spans lines
  assert parse("前\n<!-- 一\n二\n三 -->\n后\n") == Ok([Para([Text("前\n后")])])
  # opening and closing mid-line, without leaving a double space
  assert parse("甲 <!-- x --> 乙\n") == Ok([Para([Text("甲 乙")])])
  # a comment opened mid-line and closed on the next one
  assert parse("甲 <!-- x\ny --> 乙\n") == Ok([Para([Text("甲\n乙")])])
  # a lone comment between paragraphs does not merge them
  assert parse("一\n\n<!-- c -->\n\n二\n") == Ok([Para([Text("一")]), Para([Text("二")])])
}

test "only comments are dropped; other angle brackets are still text" {
  # a bare `<` is not a comment opener; it stays for the renderer to escape
  assert parse("a < b 且 c > d\n") == Ok([Para([Text("a < b 且 c > d")])])
  assert parse("<p>不是注释</p>\n") == Ok([Para([Text("<p>不是注释</p>")])])
  # a doc that talks about a marker keeps it: inline code is verbatim
  assert parse("它带 `<!-- doc-check: version -->` 标记\n") ==
    Ok([Para([Text("它带 "), Code("<!-- doc-check: version -->"), Text(" 标记")])])
  # so is fenced code, including a fence indented under a list item
  assert parse("```\n<!-- 代码里的注释 -->\n```\n") ==
    Ok([CodeBlock("", "<!-- 代码里的注释 -->")])
  assert parse("- 条目：\n\n  ```\n  <!-- 也是代码 -->\n  ```\n") ==
    Ok([UList([[Para([Text("条目：")]), CodeBlock("", "<!-- 也是代码 -->")]])])
}

test "subset violations are loud" {
  # #### is in the subset (spec §9.5.1 uses one); ##### is where it stops
  assert parse("#### 四级\n") == Ok([Heading(4, [Text("四级")])])
  match parse("##### 太深了\n") {
    Ok(_) -> {
      assert false
    }
    Err(e) -> {
      assert str.contains(e, "outside the subset")
    }
  }
}

# The pack/unpack primitives, integer and float, exercised from the only place
# that may name them.
#
# `bytes_pack_int`, `bytes_unpack_int`, `bytes_pack_float` and
# `bytes_unpack_float` take and return `Array`, which only std can name (docs/native-backend-plan.md D1), so this file is dropped into a
# copy of std/ by run.sh rather than sitting in examples/. It does no more than
# convert `List[Int]` and `List[Float]` at the edge, so the probe can state its cases as list
# literals and every output line is the primitive's own answer. No `use java`
# for the reason scripts/array-contract/array.dawn gives.
use std/bytes

fn to_array(xs: List[Int]) -> Array[Int] = {
  var a: Array[Int] = array_new()
  for x in xs { a = array_push(a, x) }
  a
}

fn to_list(a: Array[Int]) -> List[Int] = {
  var out: List[Int] = []
  var i = 0
  while i < array_len(a) {
    out = out ++ [array_get(a, i)]
    i = i + 1
  }
  out
}

## The bytes of `xs` at `width`, and the byte order named by `little`.
pub fn pack(xs: List[Int], width: Int, little: Bool) -> Bytes =
  bytes_pack_int(to_array(xs), width, little)

## The integers `b` holds at `width`.
pub fn unpack(b: Bytes, width: Int, signed: Bool, little: Bool) -> List[Int] =
  to_list(bytes_unpack_int(b, width, signed, little))

## Bytes built from byte values, so a case can say exactly which bytes it feeds
## to `unpack` without going through `pack` (a round trip alone would pass a
## pair of mutually inverse mistakes).
pub fn of_bytes(vals: List[Int]) -> Bytes = bytes_pack_int(to_array(vals), 1, true)

pub fn size(b: Bytes) -> Int = bytes.len(b)

pub fn dump(b: Bytes) -> String = {
  var s = ""
  var i = 0
  while i < bytes.len(b) {
    if i > 0 { s = s ++ " " }
    s = s ++ "${bytes.at(b, i)}"
    i = i + 1
  }
  "[" ++ s ++ "]"
}

fn to_array_f(xs: List[Float]) -> Array[Float] = {
  var a: Array[Float] = array_new()
  for x in xs { a = array_push(a, x) }
  a
}

fn to_list_f(a: Array[Float]) -> List[Float] = {
  var out: List[Float] = []
  var i = 0
  while i < array_len(a) {
    out = out ++ [array_get(a, i)]
    i = i + 1
  }
  out
}

## The float bytes of `xs` at `width` (4 or 8), in the order `little` names.
pub fn packf(xs: List[Float], width: Int, little: Bool) -> Bytes =
  bytes_pack_float(to_array_f(xs), width, little)

## The floats `b` holds at `width`.
pub fn unpackf(b: Bytes, width: Int, little: Bool) -> List[Float] =
  to_list_f(bytes_unpack_float(b, width, little))

## The double whose bits are `hi` then `lo`, two 32-bit halves so every pattern
## is a small literal. The halves go through the integer family and
## `unpackf` -- no Dawn arithmetic builds the double -- which is what keeps a NaN
## payload from being rewritten on the way in.
pub fn f64_of(hi: Int, lo: Int) -> Float =
  unpackf(bytes_pack_int(to_array([lo, hi]), 4, true), 8, true)[0]

## The double a float of bits `bits` widens to.
pub fn f32_of(bits: Int) -> Float =
  unpackf(bytes_pack_int(to_array([bits]), 4, true), 4, true)[0]

type Shape =
  | Circle(r: Float)
  | Rect(w: Float, h: Float)
  | Point

fn describe(s: Shape) -> String =
  match s {
    Circle(r) -> "circle ${r}"
    Rect(w, h) -> "rect ${w} x ${h}"
    Point -> "a point"
  }

pub fn main() -> Unit !io = {
  let xs = [Circle(1.0), Point]
  for s in xs {
    println(describe(s))
  }
}

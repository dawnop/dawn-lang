# The native driver (docs/native-backend-plan.md §14.1): the shared frontend
# behind a `main` that wires no JVM hook. Everything host-specific is a
# default -- `use java` checking is refused (cx_new's jsig), compile-time
# Java folding is refused (ct_default's jcall), std comes embedded (stdsrc),
# and the C runtime comes embedded too (rtsrc, via cdriver) -- so the binary
# this module compiles to is a complete toolchain with no files of its own.
#
# `build` shells out to the system C compiler: emitting C *is* this
# backend's codegen, and cc is its assembler. Subcommands are a subset of
# the JVM driver's on purpose; what is missing is what needs a JVM
# (`build`-to-jar, `lock`, `cache`, `--vendor`).
#
# `fmt`, `doc` and `add` are wired here as second implementations of the JVM
# driver's argument handling rather than as calls into a shared one, and that
# is deliberate: `scripts/native-cli-diff.sh` holds the two byte for byte, and
# a differential over one shared function proves nothing. The *work* is shared
# (fmt.format, doc.*_json, add.run_add are the same modules); only the driver
# plumbing is doubled.
#
# `server` is one call either way -- there is no argument handling to double --
# and the only thing this driver decides is the `Jsig` the server analyses
# with. The JVM main passes jreflect's, so an editor there resolves `use java`
# imports; this one passes the refusal, which is the same answer this backend
# gives that program under `check`. `scripts/selfhost-lsp-diff.sh` takes
# DAWN_SELF and runs the whole scripted session against this binary.

use std/io
use std/str
use front/token.{Diag}
use front/diag
use driver/stdlib.{StdCtx, StdLoadError, load_std, std_load_error_text, std_load_is_bug}
use ir/interp.{ct_default}
use check/jsig.{JsigLease, jsig_refused, jsig_refused_lease}
use driver/analyze.{Program, LocDiag, load_directory, load_file, analyze_program}
use check/tast.{TModule}
use c/cdriver
use version.{VERSION}
use front/fmt
use doc
use pkg/add
use lsp/server.{LspLeaseHost, run_lsp}
use compiler_plan/pkgfetch
use compiler_plan/source

fn native_lsp_standalone_lease() -> JsigLease !io = jsig_refused_lease()

fn native_lsp_target_lease(
  _plan: source.SourcePlan
) -> Result[JsigLease, LocDiag] !io = Ok(jsig_refused_lease())

fn usage() -> String =
  join([
    "dawnc " ++ VERSION ++ " -- the Dawn compiler, native backend",
    "",
    "usage:",
    "  dawnc check [--std <dir>] <target>...       type-check, report diagnostics",
    "  dawnc build [--std <dir>] <target> [-o out] compile to a native binary via cc",
    "  dawnc emitc [--std <dir>] <target> [-o out] emit the C translation unit",
    "  dawnc run   [--std <dir>] <target> [-- <args>...]",
    "                                              compile and run",
    "  dawnc test  [--std <dir>] <target>          compile the test blocks and run them",
    "  dawnc test  [--std <dir>] --stdlib          run the bundled std's own test blocks",
    "  dawnc fmt [--check] <file.dawn | dir>...    format files in place",
    "  dawnc doc <target> | --stdlib | --builtins  emit the API reference as JSON",
    "  dawnc add <spec> [--subdir <p>] [--as <alias>] [--dir <project>]",
    "                                              add a dependency to dawn.toml",
    "  dawnc lsp                                   speak LSP over stdin/stdout",
    "  dawnc version                               print the version",
    "",
    "A <target> is a single .dawn file or a project directory (src/main.dawn entry).",
    "`use java` programs are rejected: Java interop needs the JVM toolchain."
  ], "\n") ++ "\n"

fn fail_usage() -> Unit !io = {
  io.eprint(usage())
  let _ = io.exit(2)
  ()
}

fn fail_compile(diags: List[LocDiag]) -> Unit !io = {
  var pairs: List[(String, Diag)] = []
  for ld in diags { pairs = pairs ++ [(ld.path, ld.d)] }
  io.eprint(diag.render_all(pairs))
  io.eprintln(diag.count_line(len(diags)))
  let _ = io.exit(1)
  ()
}

## The JVM driver's CLI error shape, exit code included: this used to exit 1
## while `main.dawn` exited 2 for the same class of mistake (a missing target,
## a file with the wrong suffix). Nothing compared the two drivers, so the
## divergence sat there; `scripts/native-cli-diff.sh` compares them now.
fn cli_error(msg: String) -> Unit !io = {
  io.eprintln("error: " ++ msg)
  let _ = io.exit(2)
  ()
}

## A std that will not load, said out loud. Only the copy compiled into this
## binary is the compiler's own fault; a directory is the user's environment,
## so it gets `error:` and the CLI exit code rather than a panic reading as
## "reinstall the toolchain". `cli_error` exits, so the panic under it is the
## unreachable value this function's type needs.
fn fail_std(e: StdLoadError) -> StdCtx !io = {
  let text = std_load_error_text(e)
  if std_load_is_bug(e) { panic(text) }
  cli_error(text)
  panic(text)
}

## Refuse a second positional for commands whose contract has one target.
## The wording matches main.dawn: the native driver is a second parser for the
## same command contract, not a second place to invent diagnostics.
fn refuse_second_target(cmd: String, have: String, got: String) -> Unit !io =
  if have != "" {
    cli_error(cmd ++ " takes one target, got `" ++ have ++ "` and `" ++ got ++
        "`; a bare word after the target is not a flag this subcommand knows")
  }

## Require exactly one input mode after parsing. This is duplicated at the
## driver boundary on purpose; native-cli-diff is the executable shared fact.
fn require_one_input(
  cmd: String,
  choices: String,
  usage_text: String,
  selected: Int
) -> Unit !io = {
  if selected == 0 { return cli_error(usage_text) }
  if selected > 1 { return cli_error(cmd ++ " accepts exactly one of " ++ choices) }
}

## `fmt`'s refusal shape: the lexer diagnostics, the count line, and the fact
## that nothing was written. Same words as `main.dawn`'s `fail_fmt`.
fn fail_fmt(pairs: List[(String, Diag)]) -> Unit !io = {
  io.eprint(diag.render_all(pairs))
  io.eprintln(diag.count_line(len(pairs)))
  io.eprintln("these files do not lex and were left unchanged")
  let _ = io.exit(1)
  ()
}

## Diagnostics without the count line, exit 1 -- `doc`'s failure shape.
fn fail_doc(diags: List[LocDiag]) -> Unit !io = {
  var pairs: List[(String, Diag)] = []
  for ld in diags { pairs = pairs ++ [(ld.path, ld.d)] }
  io.eprint(diag.render_all(pairs))
  let _ = io.exit(1)
  ()
}

type RunArgs = { std_dir: String, target: String, program_args: List[String] }

fn run_usage() -> String =
  "usage: dawn run [compiler-options] <target> [-- <program-args>...]"

## Independent native parser: compiler options end at the target.
fn parse_run_tail(rest: List[String]) -> RunArgs !io = {
  var std_dir = "std"
  var target = ""
  var seen_target = false
  var program_args: List[String] = []
  var i = 0
  while i < len(rest) && not seen_target {
    if rest[i] == "--std" {
      if i + 1 >= len(rest) { cli_error(run_usage()) }
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--" {
      cli_error(run_usage())
      i = i + 1
    } else {
      target = rest[i]
      seen_target = true
      i = i + 1
    }
  }
  if not seen_target { cli_error(run_usage()) }
  if i < len(rest) {
    if rest[i] != "--" { cli_error(run_usage()) }
    i = i + 1
    while i < len(rest) {
      program_args = program_args ++ [rest[i]]
      i = i + 1
    }
  }
  RunArgs { std_dir: std_dir, target: target, program_args: program_args }
}

## `--std <dir>` and `-o <out>` plus exactly one target, kept out of run.
fn parse_compile_tail(
  cmd: String,
  usage_text: String,
  rest: List[String]
) -> (String, String, String) !io = {
  var std_dir = "std"
  var out = ""
  var target = ""
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "-o" && i + 1 < len(rest) {
      out = rest[i + 1]
      i = i + 2
    } else {
      refuse_second_target(cmd, target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  if target == "" { cli_error(usage_text) }
  (std_dir, out, target)
}

## `[--std <dir>] <target>...`, matching main.dawn's public check parser.
fn check_args(rest: List[String]) -> (String, List[String]) = {
  var std_dir = "std"
  var targets: List[String] = []
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else {
      targets = targets ++ [rest[i]]
      i = i + 1
    }
  }
  (std_dir, targets)
}

fn load_or_die(std_dir: String) -> StdCtx !io =
  match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> fail_std(e)
  }

fn analyzed(std: StdCtx, target: String) -> Program !io = {
  if not io.exists(target) {
    cli_error("no such file or directory: " ++ target)
  }
  if not io.is_dir(target) && not str.ends_with(target, ".dawn") {
    cli_error("source files must end in .dawn: " ++ target)
  }
  let loaded = if io.is_dir(target) { load_directory(target) } else { load_file(target) }
  let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
  if len(prog.diags) > 0 { fail_compile(prog.diags) }
  prog
}

fn emitted(std_dir: String, target: String) -> String !io = {
  let std = load_or_die(std_dir)
  let prog = analyzed(std, target)
  match cdriver.c_text(std, prog) {
    Ok(s) -> s
    Err(e) -> {
      cli_error(e ++ " in " ++ target)
      ""
    }
  }
}

## The output name `build` defaults to: the target's basename, extension off.
fn default_out(target: String) -> String = {
  let base = match str.last_index_of(target, "/") {
    Some(i) -> str.drop(target, i + 1)
    None -> target
  }
  let stem = str.strip_suffix(base, ".dawn").unwrap_or(base)
  if stem == "" { "a.out" } else { stem }
}

## Write the C and the embedded runtime into a scratch directory, run cc, and
## leave the binary at `out`. The cc diagnostics stream to this process's
## stderr -- an empty err_path means "inherit", and cc failing is the user's
## compile error to read.
fn cc_build(ctext: String, out: String) -> Unit !io = {
  let work = match io.temp_dir("", "dawnc") {
    Ok(d) -> d
    Err(e) -> {
      cli_error("cannot make a scratch directory: " ++ e.message)
      return ()
    }
  }
  var wrote = io.write_file(work ++ "/main.c", ctext)
  for f in ["dawn_rt.c", "dawn_rt.h"] {
    match cdriver.runtime_source(f) {
      Some(t) -> { wrote = io.write_file(work ++ "/" ++ f, t) }
      None -> panic("embedded runtime is missing " ++ f)
    }
  }
  match wrote {
    Ok(_) -> ()
    Err(e) -> {
      cli_error("cannot stage the C sources: " ++ e.message)
      return ()
    }
  }
  let cc = match io.getenv("CC") {
    Some(c) -> c
    None -> "cc"
  }
  let argv = [
    cc, "-std=c11", "-O2", "-fwrapv", "-fexceptions", "-fno-strict-aliasing", "-pthread",
    "-I", work,
    "-o", out, work ++ "/main.c", work ++ "/dawn_rt.c", "-lm"
  ]
  # cc is done with the staging directory the moment it succeeds, and nothing
  # else ever removed it: 125 of them, a megabyte each (the emitted C plus the
  # embedded runtime), had accumulated in /tmp here. A cc that *failed* keeps
  # its directory on purpose -- the C it choked on is the only thing left to
  # look at, and the error names an exit code, not a file.
  match io.run(argv, "", "") {
    Ok(0) -> pkgfetch.delete_tree(work)
    Ok(code) -> cli_error(cc ++ " failed (exit code " ++ "${code}" ++ ")")
    Err(e) -> cli_error("cannot run " ++ cc ++ ": " ++ e.message)
  }
}

fn cmd_check(rest: List[String]) -> Unit !io = {
  let (std_dir, targets) = check_args(rest)
  if len(targets) == 0 {
    return cli_error("usage: dawn check [--std <dir>] <target>...")
  }
  for target in targets {
    if not io.exists(target) {
      return cli_error("no such file or directory: " ++ target)
    }
    if not io.is_dir(target) && not str.ends_with(target, ".dawn") {
      return cli_error("source files must end in .dawn: " ++ target)
    }
  }
  let std = load_or_die(std_dir)
  var all: List[LocDiag] = []
  for target in targets {
    let loaded = if io.is_dir(target) { load_directory(target) } else { load_file(target) }
    let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
    all = all ++ prog.diags
  }
  if len(all) > 0 { return fail_compile(all) }
  println("ok")
}

fn cmd_emitc(rest: List[String]) -> Unit !io = {
  let (std_dir, out, target) = parse_compile_tail(
    "dawn emitc",
    "usage: dawn emitc [--std <dir>] <file.dawn | project-dir> [-o out]",
    rest
  )
  let text = emitted(std_dir, target)
  if out == "" {
    print(text)
  } else {
    match io.write_file(out, text) {
      Ok(_) -> ()
      Err(e) -> cli_error("cannot write " ++ out ++ ": " ++ e.message)
    }
  }
}

fn cmd_build(rest: List[String]) -> Unit !io = {
  let (std_dir, out0, target) = parse_compile_tail(
    "dawn build",
    "usage: dawn build [--cp jars] <file.dawn | project-dir> [-o out] [--native]",
    rest
  )
  let out = if out0 == "" { default_out(target) } else { out0 }
  cc_build(emitted(std_dir, target), out)
}

## Build `ctext` into a scratch directory and become it: the process ends with
## the built program's own exit status, so nothing after the call runs.
##
## `dir_prefix`, `bin_name` and `what` are parameters rather than a shared
## spelling because the two callers' messages are compared byte for byte
## against the JVM driver's (scripts/native-cli-diff.sh); what is shared is the
## staging, not the wording.
fn build_and_exec(
  ctext: String,
  dir_prefix: String,
  bin_name: String,
  what: String,
  program_args: List[String]
) -> Unit !io = {
  let work = match io.temp_dir("", dir_prefix) {
    Ok(d) -> d
    Err(e) -> {
      cli_error("cannot make a scratch directory: " ++ e.message)
      return ()
    }
  }
  let bin = work ++ "/" ++ bin_name
  cc_build(ctext, bin)
  # The scratch tree goes before the exit, not after it: `io.exit` has no stack
  # to unwind, so a release placed on the way out is a release that never runs.
  # A build that failed keeps its directory -- `cc_build` reports and exits from
  # inside, and the emitted C is the only thing left to look at.
  match io.run([bin] ++ program_args, "", "") {
    Ok(code) -> {
      pkgfetch.delete_tree(work)
      let _ = io.exit(code)
      ()
    }
    Err(e) -> {
      pkgfetch.delete_tree(work)
      cli_error("cannot run the built " ++ what ++ ": " ++ e.message)
    }
  }
}

fn cmd_run(rest: List[String]) -> Unit !io = {
  let run = parse_run_tail(rest)
  build_and_exec(
    emitted(run.std_dir, run.target),
    "dawnc-run",
    "program",
    "program",
    run.program_args
  )
}

## Every .dawn file under `dir`, recursively; paths are `dir`-prefixed.
##
## The order `io.list_dir` returns is not the same on both backends (#114: the
## C reader does not sort), so the caller sorts the flat result -- which is
## also what the JVM driver does, for the same reason one layer down.
fn dawn_files_under(dir: String) -> List[String] !io = {
  var out: List[String] = []
  match io.list_dir(dir) {
    Ok(files) -> {
      for f in files {
        let p = dir ++ "/" ++ f
        if io.is_dir(p) {
          out = out ++ dawn_files_under(p)
        } else if str.ends_with(f, ".dawn") {
          out = out ++ [p]
        }
      }
    }
    Err(e) -> panic("cannot list " ++ dir ++ ": " ++ e.message)
  }
  out
}

## `dawnc fmt [--check] <file.dawn | dir>...` -- reformat in place, or report
## unformatted files and exit 1. Both refusals (a named non-`.dawn` file, a
## file the lexer cannot read whole) are documented at `main.dawn`'s `run_fmt`;
## the two drivers' output is compared byte for byte by
## `scripts/native-cli-diff.sh`, so they refuse in the same words.
fn cmd_fmt(rest: List[String]) -> Unit !io = {
  var check = false
  var paths: List[String] = []
  for a in rest {
    if a == "--check" { check = true } else { paths = paths ++ [a] }
  }
  if len(paths) == 0 { return cli_error("usage: dawn fmt [--check] <file.dawn | dir>...") }
  var files: List[String] = []
  for p in paths {
    if not io.exists(p) { return cli_error("no such file or directory: " ++ p) }
    if io.is_dir(p) {
      files = files ++ sort(dawn_files_under(p))
    } else {
      if not str.ends_with(p, ".dawn") {
        return cli_error("source files must end in .dawn: " ++ p)
      }
      files = files ++ [p]
    }
  }
  var unformatted = 0
  var refused: List[(String, Diag)] = []
  for f in files {
    match io.read_file(f) {
      Ok(original) -> {
        match fmt.format(original) {
          Err(ds) -> {
            for d in ds { refused = refused ++ [(f, d)] }
          }
          Ok(formatted) ->
            if formatted != original {
              if check {
                println(f)
                unformatted = unformatted + 1
              } else {
                match io.write_file(f, formatted) {
                  Ok(_) -> println("formatted " ++ f)
                  Err(e) -> panic("cannot write " ++ f ++ ": " ++ e.message)
                }
              }
            }
        }
      }
      Err(e) -> panic("cannot read " ++ f ++ ": " ++ e.message)
    }
  }
  if len(refused) > 0 { return fail_fmt(refused) }
  if check && unformatted > 0 { let _ = io.exit(1) }
}

## `dawnc doc <target>` / `--stdlib` / `--builtins`.
##
## The JVM driver hands `analyze_program` the reflecting `use java` hook; this
## one hands it the refusing hook, as every other native subcommand does. For a
## target without `use java` the two produce the same JSON, and a target with
## it is not a program this backend compiles at all.
fn cmd_doc(rest: List[String]) -> Unit !io = {
  var std_dir = "std"
  var builtins_mode = false
  var stdlib_mode = false
  var target = ""
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--builtins" {
      builtins_mode = true
      i = i + 1
    } else if rest[i] == "--stdlib" {
      stdlib_mode = true
      i = i + 1
    } else {
      refuse_second_target("dawn doc", target, rest[i])
      target = rest[i]
      i = i + 1
    }
  }
  require_one_input(
    "dawn doc",
    "a target, --stdlib, or --builtins",
    "usage: dawn doc <file.dawn | project-dir> | dawn doc --stdlib | dawn doc --builtins",
    (if target != "" { 1 } else { 0 }) +
      (if stdlib_mode { 1 } else { 0 }) +
      (if builtins_mode { 1 } else { 0 })
  )
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> fail_std(e)
  }
  if stdlib_mode {
    print(doc.stdlib_json(std))
    return
  }
  if builtins_mode {
    print(doc.builtins_json(std))
    return
  }
  if not io.exists(target) {
    return cli_error("no such file or directory: " ++ target)
  }
  let loaded = if io.is_dir(target) { load_directory(target) } else { load_file(target) }
  let prog = analyze_program(loaded, std, ct_default(), jsig_refused())
  if len(prog.diags) > 0 { fail_doc(prog.diags) }
  print(doc.project_json(prog))
}

## `dawnc test [--std <dir>] <target> | --stdlib` -- the native mirror of
## `dawn test`.
##
## The JVM driver emits every test block as a `dawn$test$i` method and then
## generates one more class, `dawn$TestMain`, to call them (testrun.dawn).
## There is no "generate one more class" on this backend, so the test bodies
## are compiled into the same translation unit as everything else and a
## generated C runner becomes its `main` (ctestrun.dawn). The report, the
## labels and the exit code are the JVM runner's.
##
## `--cp` is validated exactly as `main.extract_cp` validates it, and then the
## jars are dropped. They can only ever matter to a `use java` program, which
## this backend refuses at `check` -- so ignoring their contents is observable
## nowhere, while rejecting the flag outright would make `dawn test`'s argv
## toolchain-specific for no gain.
##
## The one thing that cannot be mirrored is where the separator comes from:
## `main.path_sep()` is `File.pathSeparator`, a java call, and a backend with
## no classpath has nothing to ask. `:` is the same POSIX assumption
## `default_out` above already makes by splitting paths on `/`.
##
## The comptime flags (`--comptime-fuel`, `--comptime-ffi`, `--closure`) are
## not taken here because no subcommand of this driver takes them; that gap is
## the driver's, not this subcommand's.
fn cmd_test(rest: List[String]) -> Unit !io = {
  var std_dir = "std"
  var target = ""
  var std_tests = false
  var i = 0
  while i < len(rest) {
    var spec = ""
    if rest[i] == "--std" && i + 1 < len(rest) {
      std_dir = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--stdlib" {
      std_tests = true
      i = i + 1
    } else if rest[i] == "--cp" && i + 1 < len(rest) {
      spec = rest[i + 1]
      i = i + 2
    } else if rest[i] == "--cp" {
      cli_error("--cp needs a path")
      i = i + 1
    } else if str.starts_with(rest[i], "--cp=") {
      spec = str.strip_prefix(rest[i], "--cp=").unwrap_or(rest[i])
      i = i + 1
    } else {
      refuse_second_target("dawn test", target, rest[i])
      target = rest[i]
      i = i + 1
    }
    if spec != "" {
      for pth in str.split(spec, ":") {
        if pth != "" && not io.exists(pth) { cli_error("--cp entry not found: " ++ pth) }
      }
    }
  }
  require_one_input(
    "dawn test",
    "a target or --stdlib",
    "usage: dawn test [--cp jars] <file.dawn | project-dir> | dawn test --stdlib",
    (if target != "" { 1 } else { 0 }) + (if std_tests { 1 } else { 0 })
  )
  let std = load_or_die(std_dir)
  let prog = if std_tests { Program { modules: [], diags: [] } } else { analyzed(std, target) }
  # the modules whose test blocks are being run: the target's, or std's own
  # under --stdlib
  var suite: List[(String, String, TModule)] = []
  if std_tests {
    for sm in std.mods {
      let (cls, _cx, tm, _ct) = sm
      suite = suite ++ [(cls, cls, tm)]
    }
  } else {
    for cm in prog.modules { suite = suite ++ [(cm.class_name, cm.mod_path, cm.tm)] }
  }
  # the module path prefixes a label only when more than one module has tests
  # -- run_test's rule, so that the two reports read the same
  var bearing = 0
  for s in suite {
    let (_c, _p, tm) = s
    if len(tm.tests) > 0 { bearing = bearing + 1 }
  }
  if bearing == 0 {
    return cli_error(if std_tests { std_dir ++ " has no test blocks" }
    else { target ++ " has no test blocks" })
  }
  var runner_tests: List[(String, Int, String)] = []
  for s in suite {
    let (cls, mod_path, tm) = s
    var idx = 0
    for tf in tm.tests {
      let label = if bearing > 1 { mod_path ++ " :: " ++ tf.name } else { tf.name }
      runner_tests = runner_tests ++ [(cls, idx, label)]
      idx = idx + 1
    }
  }
  let ctext = match cdriver.c_test_text(std, prog, runner_tests, std_tests) {
    Ok(s) -> s
    Err(e) -> {
      cli_error(e ++ " in " ++ target)
      ""
    }
  }
  build_and_exec(ctext, "dawnc-test", "tests", "tests", [])
}

pub fn main() -> Unit !io = {
  match args() {
    [] -> fail_usage()
    [mode, ..rest] ->
      if mode == "check" {
        cmd_check(rest)
      } else if mode == "build" {
        cmd_build(rest)
      } else if mode == "emitc" {
        cmd_emitc(rest)
      } else if mode == "run" {
        cmd_run(rest)
      } else if mode == "test" {
        cmd_test(rest)
      } else if mode == "fmt" {
        cmd_fmt(rest)
      } else if mode == "doc" {
        cmd_doc(rest)
      } else if mode == "add" {
        match add.run_add(rest) {
          Ok(s) -> println(s)
          Err(e) -> cli_error(e)
        }
      } else if mode == "lsp" {
        run_lsp("std", LspLeaseHost {
          standalone: native_lsp_standalone_lease,
          project: native_lsp_target_lease
        })
      } else if mode == "version" || mode == "--version" {
        println("dawnc " ++ VERSION ++ " (native)")
      } else {
        fail_usage()
      }
  }
}

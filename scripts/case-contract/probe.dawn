# Contract for simple (1:1) Unicode case mapping, and the generator for the C
# runtime's table.
#
# `str.lower`/`str.upper` are *simple* mapping: one code point in, one out, no
# locale and no context (docs/native-backend-plan.md 14.12). The JVM backend
# gets that from `Character.toUpperCase(int)`, which is exactly the simple
# mapping; the C runtime has no Unicode tables of its own, so it carries one
# generated from the same oracle.
#
# That makes the oracle the single definition and each backend an implementation
# of it, which is the whole point -- but only as long as the two stay tied
# together. Hence the two modes:
#
#   (default)            every code point that has a mapping, plus a spread of
#                        ones that should not, checked against the oracle. This
#                        is the JVM backend's half.
#   DAWN_CASE_EMIT=1     print the C table. run.sh diffs it against the checked
#                        in header, so a JDK whose Unicode version has moved on
#                        fails here rather than silently in a native binary.
use std/io
use std/list
use std/str
use java "java.lang.Character"

const LAST: Int = 0x10FFFF

## Surrogates are not characters; `Character.toUpperCase` maps them to
## themselves and no string can hold one, so they are left out of both halves.
fn is_surrogate(cp: Int) -> Bool = cp >= 0xD800 && cp <= 0xDFFF

fn oracle(cp: Int, up: Bool) -> Int !io =
  if up { Character.toUpperCase(cp) } else { Character.toLowerCase(cp) }

fn one(cp: Int) -> String = from_code_points([cp])

fn only_cp(s: String) -> Int = get(code_points(s), 0).expect("one code point")

# ---- the table ----

## Runs of consecutive code points whose mapping is the same offset from the
## code point itself, which is how a table this sparse stays small: 1.1M code
## points come out as a few hundred ranges.
fn ranges(up: Bool) -> List[(Int, Int, Int)] !io = {
  var out: List[(Int, Int, Int)] = []
  var lo = -1
  var hi = -1
  var delta = 0
  var cp = 0
  while cp <= LAST {
    if is_surrogate(cp) {
      cp = cp + 1
    } else {
      let d = oracle(cp, up) - cp
      if d == 0 {
        if lo >= 0 {
          out = out ++ [(lo, hi, delta)]
          lo = -1
        }
      } else if lo >= 0 && d == delta && cp == hi + 1 {
        hi = cp
      } else {
        if lo >= 0 { out = out ++ [(lo, hi, delta)] }
        lo = cp
        hi = cp
        delta = d
      }
      cp = cp + 1
    }
  }
  if lo >= 0 { out = out ++ [(lo, hi, delta)] }
  out
}

const HEX: String = "0123456789ABCDEF"

fn hex4(n: Int) -> String =
  if n >= 16 { hex4(n / 16) ++ hex_digit(n % 16) } else { hex_digit(n) }

fn hex_digit(n: Int) -> String = str.substring(HEX, n, n + 1)

fn pad4(s: String) -> String = if str.len(s) >= 4 { s } else { pad4("0" ++ s) }

fn cp_lit(n: Int) -> String = "0x" ++ pad4(hex4(n))

fn row(r: (Int, Int, Int)) -> String = {
  let (lo, hi, delta) = r
  "    {" ++ cp_lit(lo) ++ ", " ++ cp_lit(hi) ++ ", " ++ to_string(delta) ++ "},"
}

fn emit_table(name: String, rs: List[(Int, Int, Int)]) -> Unit !io = {
  io.println("static const dawn_case_range " ++ name ++ "[] = {")
  for r in rs { io.println(row(r)) }
  io.println("};")
  io.println("")
}

fn emit() -> Unit !io = {
  io.println("/* Simple (1:1) Unicode case mapping, as ranges of code points that share")
  io.println(" * one offset. GENERATED by scripts/case-contract/probe.dawn -- do not edit;")
  io.println(" * scripts/case-contract/run.sh regenerates this and fails on a difference.")
  io.println(" *")
  io.println(" * The JVM backend calls Character.toUpperCase/toLowerCase, which *is* this")
  io.println(" * mapping, so this table is how the C runtime answers the same function.")
  io.println(" * Full mapping (the one where a sharp s uppercases to two letters) is")
  io.println(" * locale- and context-sensitive and belongs in a library, not here. */")
  io.println("#ifndef DAWN_CASE_TABLE_H")
  io.println("#define DAWN_CASE_TABLE_H")
  io.println("")
  io.println("#include <stdint.h>")
  io.println("")
  io.println("typedef struct {")
  io.println("  int32_t lo;")
  io.println("  int32_t hi;")
  io.println("  int32_t delta;")
  io.println("} dawn_case_range;")
  io.println("")
  emit_table("dawn_upper_ranges", ranges(true))
  emit_table("dawn_lower_ranges", ranges(false))
  io.println("#endif /* DAWN_CASE_TABLE_H */")
}

# ---- the contract ----

## Every code point the oracle maps somewhere, plus one in every 1009 that it
## should leave alone. A spurious range would show up in the emitted table and
## so in run.sh's diff; what this catches is the *walk* -- surrogate pairs
## rebuilt wrong, a code point count that did not survive, a mapping applied
## to the wrong unit.
fn interesting(cp: Int) -> Bool !io =
  not is_surrogate(cp) &&
  (oracle(cp, true) != cp || oracle(cp, false) != cp || cp % 1009 == 0)

fn check() -> Unit !io = {
  var bad = 0
  var seen = 0
  var cp = 0
  while cp <= LAST {
    if interesting(cp) {
      seen = seen + 1
      let s = one(cp)
      let u = str.to_upper(s)
      let l = str.to_lower(s)
      if str.len(u) != 1 || str.len(l) != 1 {
        bad = bad + 1
        io.println("count " ++ cp_lit(cp) ++ " upper=" ++ to_string(str.len(u)) ++
            " lower=" ++ to_string(str.len(l)))
      } else if only_cp(u) != oracle(cp, true) {
        bad = bad + 1
        io.println("upper " ++ cp_lit(cp) ++ " got " ++ cp_lit(only_cp(u)) ++
            " want " ++ cp_lit(oracle(cp, true)))
      } else if only_cp(l) != oracle(cp, false) {
        bad = bad + 1
        io.println("lower " ++ cp_lit(cp) ++ " got " ++ cp_lit(only_cp(l)) ++
            " want " ++ cp_lit(oracle(cp, false)))
      }
    }
    cp = cp + 1
  }
  io.println("checked " ++ to_string(seen))
  io.println("mismatches " ++ to_string(bad))
}

pub fn main() -> Unit !io =
  match io.getenv("DAWN_CASE_EMIT") {
    Some(_) -> emit()
    None -> check()
  }

# The front page, "Horizon": one sky read top to bottom, from night over the
# hero to sunrise over the install section (docs/site-home-design.md).
#
# Its own module rather than more of gen/pages.dawn because it is the one page
# with its own shell. Every other page is `html/page.shell` around a body; this
# one puts the site header inside its sky, links a stylesheet and a script no
# other page loads (the dark theme and the motion are this page's alone for
# now), and carries figures read from the build's environment.
#
# Three rules shape everything below, and each is why some piece of text is
# read from a file instead of written here:
#
#   - every program on the page is a file a gate runs. The listings are
#     `site/pages/<stem>.dawn`, or the project a `<stem>.project` names, and
#     what is shown under each is `<stem>.out`, which scripts/doc-check.py
#     holds to a real `dawn run` byte for byte. A listing cut from a project
#     (the GPU section's two functions) is cut from the file that runs, and a
#     line of output picked from a run is picked from that run's `.out`, so
#     nothing on the page is a transcription;
#   - every figure comes from scripts/site-figures.sh through the environment,
#     and a missing or empty one stops the build rather than printing a guess;
#   - every word is in the page's language, from site/pages/home.md or its
#     translation. What is written here is markup, code-words that read the
#     same in both languages (`effect`, `!Dev`, file names), and the install
#     commands, which are shell.

use std/str
use std/list
use std/io.{Fs, Env, getenv, with_fs_real}
use md/ast.{Block}
use html/page.{Assets, Lang, En, Zh, head_html, header_html, footer_html, lang_path,
  plain_assets, playground_label }
use html/play.{play_hash}
use hl/dawn.{highlight_dawn}
use html/escape.{escape_html, escape_attr}
use gen/common.{must_read, write_page, map_doc_url, doc_files}
use gen/copy.{Copy, load_copy, line, plain}

# ---- the figures ----

## The numbers the page prints, each produced by scripts/site-figures.sh.
pub type Figures = { selfhost_lines: Int, native_corpus: Int } derive Show

## One figure out of the environment: a positive decimal integer, or why not.
##
## Absent and empty are both errors, and so is anything that is not digits or
## is zero: each is what a broken producer prints (a renamed file under
## `find`, a `grep` that matched nothing), and a page saying "0 programs" is
## the failure this exists to stop. There is no default, on purpose; a default
## is a number nobody measured.
pub fn read_figure(key: String, raw: Option[String]) -> Result[Int, String] = {
  let name = "DAWN_SITE_FIG_${key}"
  match raw {
    None -> Err("${name} is not set (site/build.sh exports it from scripts/site-figures.sh)")
    Some(v) -> {
      var digits = str.len(v) > 0
      for ch in code_points(v) {
        if ch < '0' || ch > '9' {
          digits = false
        }
      }
      if v == "" {
        Err("${name} is empty")
      } else if not digits {
        Err("${name} is \"${v}\", not a count")
      } else {
        match parse_int(v) {
          Some(n) -> if n > 0 { Ok(n) } else { Err("${name} is 0, which no producer means") }
          None -> Err("${name} is \"${v}\", not a count")
        }
      }
    }
  }
}

fn figure(key: String) -> Int !Env =
  match read_figure(key, getenv("DAWN_SITE_FIG_${key}")) {
    Ok(n) -> n
    Err(e) -> panic("front page figure: ${e}")
  }

## The figures this build was given. Read once, in site/src/main.dawn, the way
## gen/pages.build_stamp is.
pub fn site_figures() -> Figures !Env =
  Figures {
    selfhost_lines: figure("SELFHOST_LINES"),
    native_corpus: figure("NATIVE_CORPUS"),
  }

## A count with thousands separators, the way both languages of the page print
## it (and the way home.js prints it while counting up).
fn grouped(n: Int) -> String = {
  let s = "${n}"
  let k = str.len(s)
  var out = ""
  var i = 0
  for ch in str.chars(s) {
    if i > 0 && (k - i) % 3 == 0 {
      out = out ++ ","
    }
    out = out ++ ch
    i = i + 1
  }
  out
}

# ---- the programs ----

## A listing's recorded stdout, trimmed of the final newline.
fn recorded(stem: String) -> String !Fs = str.trim(must_read("site/pages/${stem}.out"))

## The project a `<stem>.project` names: one line, a directory under the root.
## scripts/doc-check.py reads the same line to know what to run.
fn project_of(stem: String) -> String !Fs = str.trim(must_read("site/pages/${stem}.project"))

## One top-level function, cut out of a source file: from its `fn <name>(`
## line through the first line that is a lone `}`. A function that moved,
## changed shape or was renamed stops the build; showing the wrong lines, or
## none, is the alternative.
pub fn fn_source(src: String, name: String) -> String = {
  let head = "fn ${name}("
  var out: List[String] = []
  var on = false
  var done = false
  for l in str.split(src, "\n") {
    if not done {
      if not on && str.starts_with(l, head) {
        on = true
      }
      if on {
        out = out ++ [l]
        if l == "}" {
          done = true
        }
      }
    }
  }
  if not done {
    panic("no `${head}...` closed by a lone `}` to show on the front page")
  }
  join(out, "\n")
}

## The one line of a recorded output that contains `needle`, trimmed. None or
## several stops the build: the strip under a listing shows a line the run
## printed, and which line is only well defined if it is exactly one.
pub fn line_with(out: String, needle: String) -> String = {
  let hits = list.filter(str.split(out, "\n"), l => str.contains(l, needle))
  if len(hits) != 1 {
    panic("expected exactly one line containing `${needle}` in a recorded output, found ${len(hits)}")
  }
  str.trim(hits[0])
}

# ---- markup helpers ----

fn hl_pre(src: String) -> String = "<pre><code>" ++ highlight_dawn(src) ++ "</code></pre>"

## The sun's cat and the moon's: the mark's own cat, read out of
## site/assets/logo.svg rather than copied, so there is one drawing of it.
## Awake, it is the whole path, eyes cut out by the even-odd rule; asleep, it
## is the first subpath alone, the outline with no eyes in it.
pub fn cat_path(logo: String) -> String = {
  let marker = `fill-rule="evenodd"`
  match str.index_of(logo, marker) {
    None -> panic("site/assets/logo.svg: no even-odd path, so no cat to put in the sun")
    Some(i) -> {
      let rest = str.drop(logo, i)
      match str.index_of(rest, ` d="`) {
        None -> panic("site/assets/logo.svg: the cat path has no d attribute")
        Some(j) -> {
          let from = str.drop(rest, j + 4)
          match str.index_of(from, `"`) {
            Some(k) -> str.take(from, k)
            None -> panic("site/assets/logo.svg: the cat path's d attribute never closes")
          }
        }
      }
    }
  }
}

fn cat_outline(path: String) -> String =
  match str.index_of(path, " Z") {
    Some(i) -> str.take(path, i + 2)
    None -> panic("site/assets/logo.svg: the cat path has no closed first subpath")
  }


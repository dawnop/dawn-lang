## The outside world: console, files, environment and subprocesses.
## Everything here is `!io`, and everything that can fail answers
## `Result[T, ForeignError]` (spec §9.8.1).
#
# These write over the io_* intrinsics, which every backend implements; the
# handwritten dawn.rt.StdIo is retired. They need no `unsafe_pure`: they are
# honestly effectful, so their signatures just say `!io`.
#
# stderr was missing until 2026-07-28, and its absence was not free: the
# compiler's own `errio.dawn` existed to reach `System.err`, a static field
# the `use java` interop cannot name, through a method handle.
#
# `args` is deliberately NOT here: argv arrives on a static field of the program's
# own entry class, and a std function compiles to a different class, so it cannot
# name that field. Parking argv on a runtime class instead would make it shared
# by every program in one JVM — see pure-ffi-design.md §十七.
#
# The failing ones compose with `catch_fault`, which is an intrinsic and stays
# in the compiler. That is not a workaround: `Result` is a Dawn ADT and cannot be
# a Java return type, and the barrier is precisely the built-in bridge from "the
# outside world said no" to an `Err`.
#
# That `Err` carries a `ForeignError`, not a String (docs/audit/error-model-design.md
# 六). A rendered message is a dead end for a caller: the only thing it can do
# with one is match on its text, which is what spec §9.8 used to advise and what
# the error model exists to stop. The record hands over `kind` (the backend's own
# name for the failure class), `message` and `cause` separately, so a caller that
# wants to *decide* reads `kind` and a caller that wants to *report* reads
# `message` — neither has to parse. Rendering one back into a line of text is
# still a `to_string(e)` away for whoever actually wants the line.
use std/list
use std/str

## Print a string followed by a newline.
pub fn println(s: String) -> Unit !io = io_println(s)

## Print a string without a newline.
pub fn print(s: String) -> Unit !io = io_print(s)

## Print a string to stderr, followed by a newline.
pub fn eprintln(s: String) -> Unit !io = io_eprintln(s)

## Print a string to stderr without a newline.
pub fn eprint(s: String) -> Unit !io = io_eprint(s)

## End the process with an exit status. Nothing after the call runs.
##
## The result remains `Unit`: `io_exit` is the existing void/Unit intrinsic ABI.
## Naming return-only `Never` does not change that public contract.
pub fn exit(code: Int) -> Unit !io = io_exit(code)

## Read one line from stdin; `None` at end of input.
## The intrinsic maps Java's `null`-or-line straight onto `Option`.
pub fn read_line() -> Option[String] !io = io_read_line()

## Whether `path` names a directory. Invalid host path spellings, including an
## embedded NUL, answer `false` rather than escaping this Bool interface.
pub fn is_dir(path: String) -> Bool !io = io_is_dir(path)

## Whether anything exists at `path` -- a file, a directory, anything. Invalid
## host path spellings, including an embedded NUL, answer `false`.
pub fn exists(path: String) -> Bool !io = io_exists(path)

## Create `path` and every missing directory above it.
## An existing directory is not a failure; an existing *file* is.
pub fn mkdirs(path: String) -> Result[Unit, ForeignError] !io =
  catch_fault(() => io_mkdirs(path))

## Read a whole file as a UTF-8 string.
pub fn read_file(path: String) -> Result[String, ForeignError] !io =
  catch_fault(() => io_read_file(path))

## Write a string to a file, creating missing parent directories.
## `Ok` carries nothing: the only count worth returning would be bytes on disk.
pub fn write_file(path: String, content: String) -> Result[Unit, ForeignError] !io =
  catch_fault(() => io_write_file(path, content))

## The process's working directory, as an absolute path.
pub fn cwd() -> String !io = io_cwd()

## The value of the environment variable `name`, or `None` when it is unset or
## cannot be represented by the host environment API, including an embedded NUL.
pub fn getenv(name: String) -> Option[String] !io = io_getenv(name)

## Read a whole file as bytes. The text half is `read_file`.
pub fn read_bytes(path: String) -> Result[Bytes, ForeignError] !io =
  catch_fault(() => io_read_bytes(path))

## Write bytes to a file, creating missing parent directories.
pub fn write_bytes(path: String, content: Bytes) -> Result[Unit, ForeignError] !io =
  catch_fault(() => io_write_bytes(path, content))

## The two normal outcomes of deleting a path. Host failures are not outcomes:
## they stay in `delete`'s `Err` branch.
pub type DeleteOutcome = Deleted | NotFound

## Delete a file or an empty directory. A missing path is `Ok(NotFound)`;
## every other host refusal, including a non-empty directory, is an `Err`.
##
## The empty path and a path ending in `/` are rejected before a backend sees
## them. Hosts normalize those spellings differently, and delete must never
## change which filesystem object the caller named as a side effect of choosing
## a backend.
pub fn delete(path: String) -> Result[DeleteOutcome, ForeignError] !io =
  if path == "" {
    Err(ForeignError {
      kind: "io.invalid_delete_path",
      message: "io.delete: path must not be empty",
      cause: None
    })
  } else if str.ends_with(path, "/") {
    Err(ForeignError {
      kind: "io.invalid_delete_path",
      message: "io.delete: path must not end with '/'",
      cause: None
    })
  } else {
    match catch_fault(() => io_delete(path)) {
      Ok(gone) -> if gone { Ok(Deleted) } else { Ok(NotFound) }
      Err(e) -> Err(e)
    }
  }

## Move `src` onto `dst`, replacing it. Atomic when the two are on one
## filesystem and an error when they are not -- which is the whole point: the
## caller is publishing something it has already verified, and a move that can
## be observed half-done would defeat that. Stage with `temp_dir` under the
## destination's own directory to stay on one filesystem.
pub fn rename(src: String, dst: String) -> Result[Unit, ForeignError] !io =
  catch_fault(() => io_rename(src, dst))

## A fresh directory under `parent`, named after `prefix`. An empty `parent`
## means the system temporary directory.
pub fn temp_dir(parent: String, prefix: String) -> Result[String, ForeignError] !io =
  catch_fault(() => io_temp_dir(parent, prefix))

## A fresh, empty file under `parent`, named after `prefix`. An empty `parent`
## means the system temporary directory.
##
## The host picks the name *and creates the file* in one step (`mkstemp(3)`,
## `Files.createTempFile`), which is the difference that matters: a caller that
## spelled a name and opened it afterwards has a window in which another
## process can put something else -- a symbolic link, say -- at that name. On a
## POSIX host the file arrives readable and writable by its owner alone.
pub fn temp_file(parent: String, prefix: String) -> Result[String, ForeignError] !io =
  catch_fault(() => io_temp_file(parent, prefix))

## Give `dst` the permissions `src` has.
##
## `src` is inspected without following a link. POSIX hosts copy the mode bits;
## a host with no POSIX permission model copies the read-only flag, which is
## the whole of what it has. Neither copies ACLs or extended attributes.
##
## This exists because publishing by rename loses them: the file that ends up
## at the destination is a *new* file, whose mode came from the call that
## created it and the umask, and nothing else remembers what it replaced.
pub fn copy_permissions(src: String, dst: String) -> Result[Unit, ForeignError] !io =
  catch_fault(() => io_copy_permissions(src, dst))

## Whether `path` is a symbolic link. The link itself is examined, not its
## target, so a link to a directory is a link and not a directory. Invalid host
## path spellings, including an embedded NUL, answer `false`.
pub fn is_symlink(path: String) -> Bool !io = io_is_symlink(path)

## Write `content` to `path` so that a reader ever only sees the old file or
## the new one, never a half-written one and never nothing at all.
##
## The staging file is created by `temp_file` in the destination's own
## directory -- the host picks its name, so nothing can be squatting on it, and
## the shared directory is what keeps the final `rename` on one filesystem and
## therefore atomic. What is written is read back and compared before anything
## is published, the destination's permissions are carried over when it already
## exists, and only then does a single `rename` install it. Any step that fails
## takes the staging file away and leaves the destination exactly as it was.
##
## What this does **not** promise:
##
## - **Durability.** It orders nothing against a power cut: no `fsync` of the
##   file and none of the directory. The guarantee is about what a *reader*
##   can observe on a running system, which is what a manifest rewrite needs;
##   surviving a crash is a different (and much more expensive) property.
## - **Anything about concurrent writers.** Two of these racing both succeed
##   and the last `rename` wins. Detecting that someone else changed the file
##   since it was read is a compare-and-set, and that is a different primitive
##   with a different signature.
## - **Link identity.** A destination with other hard links to it is detached:
##   this directory entry gets the new file and the other links keep the old
##   one. Writing through to the shared inode is the opposite of what is wanted
##   here -- it is exactly the non-atomic overwrite this replaces.
##
## A destination that *is* a symbolic link is refused rather than followed
## (`io.atomic_write_target_is_symlink`). Following would let whatever placed
## the link choose which file gets written, and a caller publishing a file it
## named is not asking to write wherever that name currently points.
##
## The four failure kinds minted here are `io.invalid_atomic_write_path`,
## `io.atomic_write_target_is_symlink`, `io.atomic_write_staging_failed` and
## `io.atomic_write_verify_failed`; every other `Err` carries whatever the
## backend called the failure, as everywhere else in this module.
##
## `io.atomic_write_staging_failed` is the one place that rewrites a backend
## message instead of passing it on, and it earns the exception: the failure is
## about a randomly named file this function invented, so passing it on would
## name that file to a caller who never asked for it. The backend's own words
## are kept in `cause`.
pub fn atomic_write_file(path: String, content: String) -> Result[Unit, ForeignError] !io =
  if path == "" {
    Err(ForeignError {
      kind: "io.invalid_atomic_write_path",
      message: "io.atomic_write_file: path must not be empty",
      cause: None
    })
  } else if str.ends_with(path, "/") {
    Err(ForeignError {
      kind: "io.invalid_atomic_write_path",
      message: "io.atomic_write_file: path must not end with '/'",
      cause: None
    })
  } else if is_symlink(path) {
    Err(ForeignError {
      kind: "io.atomic_write_target_is_symlink",
      message: "io.atomic_write_file: refusing to replace a symbolic link: " ++ path,
      cause: None
    })
  } else {
    match temp_file(parent_dir(path), ".dawn-atomic-") {
      # The staging file is this function's own device, and its name is a
      # random one nobody asked for. Passing the backend's message through
      # verbatim -- the way every other failure here does -- would put that
      # name in front of a caller who never created it: `dawn lock` into an
      # unwritable directory used to report a `.dawn-atomic-...tmp` it had
      # never heard of. So this one failure is re-attributed to the directory
      # that actually refused, and the backend's own words move to `cause`,
      # which is where the layer below belongs (spec §9.8.1).
      Err(e) -> Err(ForeignError {
        kind: "io.atomic_write_staging_failed",
        message: "io.atomic_write_file: cannot create a staging file in "
          ++ parent_dir(path),
        cause: Some(e.kind ++ ": " ++ e.message)
      })
      Ok(tmp) -> stage_replace(path, content, tmp)
    }
  }

## The directory `path` names a file in. Not a general path library: it answers
## the one question `atomic_write_file` asks, which is where to stage, and a
## staging directory that is merely *equivalent* to the destination's is enough
## for both properties wanted of it -- same filesystem, and reachable.
fn parent_dir(path: String) -> String =
  match str.last_index_of(path, "/") {
    None -> "."
    Some(i) -> if i == 0 { "/" } else { str.slice(path, 0, i) }
  }

## Everything after the staging file exists. Split out because every failure
## from here on has to take that file away again, and a single expression with
## five nested `match`es would have five copies of the same cleanup.
fn stage_replace(path: String, content: String, tmp: String) -> Result[Unit, ForeignError] !io =
  match write_file(tmp, content) {
    Err(e) -> abandon(tmp, e)
    Ok(_) ->
      match read_bytes(tmp) {
        Err(e) -> abandon(tmp, e)
        Ok(seen) ->
          # Read back, rather than trust the write: `write_file` reports what
          # the host accepted, and a host can accept bytes it did not keep --
          # a short write on a full filesystem is the ordinary way. The
          # comparison is on bytes and not on the string, because the string
          # would come back through a decoder that replaces what it cannot
          # read, and a corruption that decodes to the same text is still a
          # corruption. `bytes_utf8` is the intrinsic behind `std/bytes.utf8`,
          # spelled directly so this module gains no import for one call.
          if seen != bytes_utf8(content) {
            abandon(tmp, ForeignError {
              kind: "io.atomic_write_verify_failed",
              message: "io.atomic_write_file: the staged file did not read back " ++
                "as it was written: " ++ path,
              cause: None
            })
          } else {
            match carry_permissions(path, tmp) {
              Err(e) -> abandon(tmp, e)
              Ok(_) ->
                match rename(tmp, path) {
                  Err(e) -> abandon(tmp, e)
                  Ok(_) -> Ok(())
                }
            }
          }
      }
  }

## Carry the destination's permissions onto the staging file, when there is a
## destination to carry them from. A path that does not exist yet has no mode
## to preserve, and the new file keeps the one its creation gave it.
fn carry_permissions(path: String, tmp: String) -> Result[Unit, ForeignError] !io =
  if exists(path) { copy_permissions(path, tmp) } else { Ok(()) }

## Give up: take the staging file away and hand back the failure that caused
## it. The delete's own outcome is dropped on purpose -- the caller is being
## told why the write did not happen, and replacing that with "and also the
## cleanup failed" would lose the reason.
fn abandon(tmp: String, e: ForeignError) -> Result[Unit, ForeignError] !io = {
  let _ = delete(tmp)
  Err(e)
}

## Exactly `n` bytes of standard input, shorter only at end of input -- so a
## short read is how end of input is reported.
##
## This reads the stream directly while `read_line` reads a buffered reader
## over it. A program that used both would lose whatever the reader had already
## buffered; pick one.
pub fn read_stdin(n: Int) -> Bytes !io = io_read_stdin(n)

## Whether at least one byte of standard input can be read right now, waiting
## up to `timeout_ms` for one to arrive.
##
## **End of input is not readiness.** When the writer has gone away this
## answers `false`, exactly as a silent-but-open stream does; the difference
## is reported by `read_stdin`, which stays the only reader. A loop driven by
## this alone would therefore spin once its input ended -- the third branch is
## not optional:
##
##     if have_work_pending {
##       if stdin_ready(window) { read a message } else { do the work }
##     } else {
##       read a message          # nothing to do, so blocking is the right thing
##     }
##
## `timeout_ms` is an upper bound, not a lower one. Returning `false` early is
## always allowed -- a regular file at end of input answers immediately -- and
## it is safe because the only thing a caller may do with `false` is stop
## waiting. `true` is the answer that is never given on a guess.
pub fn stdin_ready(timeout_ms: Int) -> Bool !io = io_stdin_ready(timeout_ms)

## The entry names directly under `path`, sorted in code-point order.
## A non-directory is reported as an `Err`, not a panic, and — matching the old
## behaviour — is checked before anything is read, so a missing path and a plain
## file give the same message.
##
## The sort happens here, not in the backends: the `io_list_names` intrinsic
## answers whatever order the OS gave, and one `list.sort` over the language's
## own `Ord[String]` is what makes every backend agree.
##
## Its `kind` is `"io.not_a_directory"`, one of the three failure kinds std
## mints itself (`run`'s `io.no_program` and `delete`'s
## `io.invalid_delete_path` are the others): every other one in this module is
## whatever the backend called it, and this failure never reaches a backend,
## because the check happens first. It is spelled as a name rather than a
## sentence for the same reason every other `kind` is — a caller may match on it.
pub fn list_dir(path: String) -> Result[List[String], ForeignError] !io =
  if is_dir(path) {
    match catch_fault(() => io_list_names(path)) {
      Ok(names) -> Ok(list.sort(names))
      Err(e) -> Err(e)
    }
  } else {
    Err(ForeignError {
      kind: "io.not_a_directory",
      message: "not a directory: " ++ path,
      cause: None
    })
  }

## Run `argv[0]` (found on PATH) with `argv` as its arguments, wait for it, and
## answer its exit status. A non-zero status is not an error -- it is the
## answer; an `Err` means the program could not be started at all.
##
## Each stream goes to the file named by its path, truncating it, and an empty
## path leaves that stream pointing wherever this process's already points.
## Files rather than pipes: see the note on the `io_run` intrinsic.
##
## An empty `argv` is `"io.no_program"`, another failure kind std mints itself,
## and for `list_dir`'s reason: the check happens first, so the failure never
## reaches a backend and every backend words it the same.
pub fn run(argv: List[String], out_path: String, err_path: String) -> Result[Int, ForeignError] !io =
  if len(argv) == 0 {
    Err(ForeignError {
      kind: "io.no_program",
      message: "io.run: argv is empty, so there is no program to run",
      cause: None
    })
  } else {
    catch_fault(() => io_run(argv, out_path, err_path))
  }

# What these blocks may and may not assert is decided by one fact: `kind` is
# whatever the backend called the failure. On the JVM a missing file is
# `java.nio.file.NoSuchFileException`; a second backend has no reason to spell
# it the same, and `dawn test --stdlib` is run under both with the reports
# compared byte for byte (scripts/native-cli-diff.sh). So a failure that
# reaches a backend is asserted to *be* an `Err` and nothing more.
#
# The exceptions are `list_dir`'s `io.not_a_directory`, `run`'s
# `io.no_program`, and `delete`'s `io.invalid_delete_path`, which std mints
# itself above the barrier and which are the same string on every backend --
# and being match-able is the whole reason they are names rather than
# sentences, so they are the `kind`s worth pinning.
#
# `Unit` has no equality, so `Result[Unit, ForeignError]` cannot be compared
# with `==` and the blocks below carry a local `ok` lambda instead of a
# module-level helper -- a private `fn` here would be dead code in every build
# that is not `dawn test --stdlib`, and would show up in std/io's own Core.
#
# Each block makes its own temp directory and takes it away again. Nothing here
# reads the repository: a test that depends on the tree it is run from breaks
# when the tree moves, and these run from wherever the runner was started.

test "temp_dir makes a fresh directory, and a file round trips through it" {
  let ok = (r: Result[Unit, ForeignError]) => match r {
    Ok(_) -> true
    Err(_) -> false
  }
  let made = (r: Result[String, ForeignError]) => match r {
    Ok(p) -> p
    Err(_) -> ""
  }
  let d = made(temp_dir("", "dawn-std-test-"))
  assert d != ""
  assert exists(d)
  assert is_dir(d)
  # fresh: a second call is a different directory, not the same one again
  let d2 = made(temp_dir("", "dawn-std-test-"))
  assert d2 != ""
  assert d != d2
  # and `parent` is honoured, so a caller can stage on one filesystem
  let inner = made(temp_dir(d, "inner-"))
  assert inner != ""
  assert is_dir(inner)

  let f = d ++ "/hello.txt"
  assert not exists(f)
  assert ok(write_file(f, "hello"))
  assert exists(f)
  assert not is_dir(f)
  assert read_file(f) == Ok("hello")
  # overwriting is not appending
  assert ok(write_file(f, "again"))
  assert read_file(f) == Ok("again")
  assert ok(write_file(f, ""))
  assert read_file(f) == Ok("")
  # missing parents are created on the way
  let nested = d ++ "/a/b/c.txt"
  assert ok(write_file(nested, "deep"))
  assert read_file(nested) == Ok("deep")
  assert is_dir(d ++ "/a/b")

  assert delete(f) == Ok(Deleted)
  assert delete(nested) == Ok(Deleted)
  assert delete(d ++ "/a/b") == Ok(Deleted)
  assert delete(d ++ "/a") == Ok(Deleted)
  assert delete(inner) == Ok(Deleted)
  assert delete(d) == Ok(Deleted)
  assert delete(d2) == Ok(Deleted)
  assert not exists(d)
}

test "a path that is not there is an Err, and never a panic" {
  let made = (r: Result[String, ForeignError]) => match r {
    Ok(p) -> p
    Err(_) -> ""
  }
  let d = made(temp_dir("", "dawn-std-test-"))
  # spec 9.8.1: the outside world saying no is a value, so every one of these
  # is a branch the caller takes. Which failure it was is the backend's word
  # and is not asserted here -- on the JVM these are java.nio names, and a
  # second backend has no reason to spell them the same.
  match read_file(d ++ "/nope.txt") {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  match read_bytes(d ++ "/nope.bin") {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  match rename(d ++ "/nope", d ++ "/x") {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  # a directory is not a file, in both directions
  match read_file(d) {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  match write_file(d, "x") {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  # ... and the queries that answer Bool rather than Result just say no
  assert not exists(d ++ "/nope")
  assert not is_dir(d ++ "/nope")
  assert not is_symlink(d ++ "/nope")
  let nul_path = d ++ "\u{0}suffix"
  assert not exists(nul_path)
  assert not is_dir(nul_path)
  assert not is_symlink(nul_path)
  assert is_dir(d)
  assert delete(d ++ "/nope") == Ok(NotFound)
  assert getenv("DAWN_STD_TEST_DEFINITELY_UNSET_VARIABLE") == None
  assert getenv("DAWN_STD_TEST\u{0}INVALID_VARIABLE") == None
  # cwd is somewhere, and it is a directory
  assert cwd() != ""
  assert is_dir(cwd())
  assert delete(d) == Ok(Deleted)
}

test "list_dir sorts by code point, and names a non-directory itself" {
  let ok = (r: Result[Unit, ForeignError]) => match r {
    Ok(_) -> true
    Err(_) -> false
  }
  let made = (r: Result[String, ForeignError]) => match r {
    Ok(p) -> p
    Err(_) -> ""
  }
  let d = made(temp_dir("", "dawn-std-test-"))
  let nothing: List[String] = []
  assert list_dir(d) == Ok(nothing)
  assert ok(write_file(d ++ "/zeta", "1"))
  assert ok(write_file(d ++ "/Alpha", "1"))
  assert ok(write_file(d ++ "/mid", "1"))
  # not the order the OS handed over, and not case-insensitive: 'A' is 65
  assert list_dir(d) == Ok(["Alpha", "mid", "zeta"])
  assert delete(d ++ "/zeta") == Ok(Deleted)
  assert delete(d ++ "/Alpha") == Ok(Deleted)
  assert delete(d ++ "/mid") == Ok(Deleted)

  # The clause the sort exists for. In code-point order U+FFFD (65533) comes
  # before U+1F600 (128512); in UTF-16 unit order it does not, because the
  # astral name begins with the surrogate 0xD83D (55357). A backend sorting
  # its own way -- `Arrays.sort` is UTF-16 units -- answers these two the
  # other way round, which is why the sort is in std and not below it.
  assert ok(write_file(d ++ "/\u{1F600}", "1"))
  assert ok(write_file(d ++ "/\u{FFFD}", "1"))
  assert list_dir(d) == Ok(["\u{FFFD}", "\u{1F600}"])
  assert delete(d ++ "/\u{1F600}") == Ok(Deleted)
  assert delete(d ++ "/\u{FFFD}") == Ok(Deleted)

  # the one kind std mints, so the one a caller may match on
  assert ok(write_file(d ++ "/plain.txt", "1"))
  match list_dir(d ++ "/plain.txt") {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.kind == "io.not_a_directory" }
  }
  # a missing path is the same answer as a plain file: the check happens before
  # anything is read, so the two are deliberately not told apart
  match list_dir(d ++ "/nope") {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.kind == "io.not_a_directory" }
  }
  assert delete(d ++ "/plain.txt") == Ok(Deleted)
  assert delete(d) == Ok(Deleted)
}

test "mkdirs is idempotent on a directory; delete says what it removed" {
  let ok = (r: Result[Unit, ForeignError]) => match r {
    Ok(_) -> true
    Err(_) -> false
  }
  let made = (r: Result[String, ForeignError]) => match r {
    Ok(p) -> p
    Err(_) -> ""
  }
  let d = made(temp_dir("", "dawn-std-test-"))
  # every missing directory above it, in one call
  assert ok(mkdirs(d ++ "/m1/m2"))
  assert is_dir(d ++ "/m1")
  assert is_dir(d ++ "/m1/m2")
  # an existing directory is not a failure
  assert ok(mkdirs(d ++ "/m1/m2"))
  assert ok(mkdirs(d))
  # an existing *file* is
  assert ok(write_file(d ++ "/f.txt", "x"))
  assert not ok(mkdirs(d ++ "/f.txt"))

  # Missing is a normal outcome. A non-empty directory is a host refusal, not
  # another spelling of absence, and delete never empties it for the caller.
  assert delete(d ++ "/nope") == Ok(NotFound)
  match delete(d ++ "/m1") {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  assert is_dir(d ++ "/m1")
  assert delete(d ++ "/m1/m2") == Ok(Deleted)
  assert delete(d ++ "/m1") == Ok(Deleted)
  assert not exists(d ++ "/m1")
  assert delete(d ++ "/f.txt") == Ok(Deleted)
  assert delete(d ++ "/f.txt") == Ok(NotFound)
  assert delete(d) == Ok(Deleted)
}

test "delete rejects ambiguous path spellings without changing the target" {
  let ok = (r: Result[Unit, ForeignError]) => match r {
    Ok(_) -> true
    Err(_) -> false
  }
  let made = (r: Result[String, ForeignError]) => match r {
    Ok(p) -> p
    Err(_) -> ""
  }
  let d = made(temp_dir("", "dawn-std-test-"))
  let f = d ++ "/kept"
  assert ok(write_file(f, "x"))

  match delete("") {
    Ok(_) -> { assert false }
    Err(e) -> {
      assert e.kind == "io.invalid_delete_path"
      assert e.message == "io.delete: path must not be empty"
    }
  }
  assert exists(f)

  match delete(f ++ "/") {
    Ok(_) -> { assert false }
    Err(e) -> {
      assert e.kind == "io.invalid_delete_path"
      assert e.message == "io.delete: path must not end with '/'"
    }
  }
  assert exists(f)

  # A backend may name this failure differently, but it must reject the whole
  # path rather than silently delete the prefix before the NUL.
  match delete(f ++ "\u{0}suffix") {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  assert exists(f)
  assert delete(f) == Ok(Deleted)
  assert delete(d) == Ok(Deleted)
}

test "rename replaces the destination; bytes survive what a String need not" {
  let ok = (r: Result[Unit, ForeignError]) => match r {
    Ok(_) -> true
    Err(_) -> false
  }
  let made = (r: Result[String, ForeignError]) => match r {
    Ok(p) -> p
    Err(_) -> ""
  }
  let d = made(temp_dir("", "dawn-std-test-"))
  assert ok(write_file(d ++ "/src.txt", "moved"))
  assert ok(rename(d ++ "/src.txt", d ++ "/dst.txt"))
  assert not exists(d ++ "/src.txt")
  assert read_file(d ++ "/dst.txt") == Ok("moved")
  # onto an existing destination: replaced, not refused
  assert ok(write_file(d ++ "/src.txt", "second"))
  assert ok(rename(d ++ "/src.txt", d ++ "/dst.txt"))
  assert read_file(d ++ "/dst.txt") == Ok("second")
  assert not exists(d ++ "/src.txt")
  assert not ok(rename(d ++ "/nope", d ++ "/dst.txt"))

  # the byte pair is the point: 0x00 0xFF is not UTF-8, so this round trip is
  # one `read_file`/`write_file` could not make
  let raw = bytes_from_array(array_push(array_push(array_new(), 0x00), 0xFF))
  assert ok(write_bytes(d ++ "/raw.bin", raw))
  assert read_bytes(d ++ "/raw.bin") == Ok(raw)
  let none_at_all = bytes_from_array(array_new())
  assert ok(write_bytes(d ++ "/empty.bin", none_at_all))
  assert read_bytes(d ++ "/empty.bin") == Ok(none_at_all)
  # and the two halves see the same file
  assert ok(write_file(d ++ "/text.txt", "abc"))
  assert read_bytes(d ++ "/text.txt") == Ok(bytes_utf8("abc"))

  assert delete(d ++ "/dst.txt") == Ok(Deleted)
  assert delete(d ++ "/raw.bin") == Ok(Deleted)
  assert delete(d ++ "/empty.bin") == Ok(Deleted)
  assert delete(d ++ "/text.txt") == Ok(Deleted)
  assert delete(d) == Ok(Deleted)
}

test "run answers the exit status; a program that cannot start is an Err" {
  let ok = (r: Result[Unit, ForeignError]) => match r {
    Ok(_) -> true
    Err(_) -> false
  }
  let made = (r: Result[String, ForeignError]) => match r {
    Ok(p) -> p
    Err(_) -> ""
  }
  let d = made(temp_dir("", "dawn-std-test-"))
  # `sh` rather than a coreutil, because POSIX guarantees it is on PATH
  assert run(["sh", "-c", "exit 0"], "", "") == Ok(0)
  # a non-zero status is the answer, not a failure -- the distinction this
  # signature exists to make
  assert run(["sh", "-c", "exit 3"], "", "") == Ok(3)
  assert run(["sh", "-c", "exit 1"], "", "") == Ok(1)
  # not being able to start it at all is the failure
  match run(["dawn-no-such-program-anywhere-on-this-path"], "", "") {
    Ok(_) -> { assert false }
    Err(_) -> ()
  }
  # no argv[0] to run. std mints this one, so unlike every other kind here it
  # is the same string on both backends and is worth pinning -- it is what the
  # JVM used to answer with `java.lang.ArrayIndexOutOfBoundsException`.
  match run([], "", "") {
    Ok(_) -> { assert false }
    Err(e) -> { assert e.kind == "io.no_program" }
  }
  # each stream goes to the file named, truncating it
  let out = d ++ "/out.txt"
  assert run(["sh", "-c", "printf first"], out, "") == Ok(0)
  assert read_file(out) == Ok("first")
  assert run(["sh", "-c", "printf second"], out, "") == Ok(0)
  assert read_file(out) == Ok("second")
  # stdout and stderr are separated
  let err = d ++ "/err.txt"
  assert run(["sh", "-c", "printf out; printf err 1>&2"], out, err) == Ok(0)
  assert read_file(out) == Ok("out")
  assert read_file(err) == Ok("err")
  assert ok(write_file(d ++ "/keep.txt", "x"))
  assert delete(d ++ "/keep.txt") == Ok(Deleted)
  assert delete(out) == Ok(Deleted)
  assert delete(err) == Ok(Deleted)
  assert delete(d) == Ok(Deleted)
}

pub opaque type Money = Int

pub opaque type Tile[D] = Float

pub type F64 = F64

pub fn cents(n: Int) -> Money = n

pub fn sum[T: Add](xs: List[T], z: T) -> T !T.Add = fold(xs, z, (a, x) => a + x)

# no `impl Add[String]` outside std/str, and nothing to forward a type
# parameter's arithmetic to from a conditional impl
impl Add[String] {
  fn add(a: String, b: String) -> String = a ++ b
}

pub type Pair[T] = { a: T, b: T }

impl[T: Add] Add[Pair[T]] {
  fn add(p: Pair[T], q: Pair[T]) -> Pair[T] = Pair { a: p.a + q.a, b: p.b + q.b }
}

pub type V = { x: Int } derive Add

pub type Bad = { x: Int }

impl Add[Bad] {
  fn add(a: Bad, b: Float) -> Bad = a
}

# expect: `pure` is not an effect name
# `pure` is not reserved, so a row would take it for an ordinary effect
# variable and solve it with anything. `fn run(f: Thunk[!pure]) -> Int !pure`
# then accepts a closure that does io and runs it, which is the opposite of
# what everyone writing `!pure` means. The empty row is written `!()`.
alias Thunk[!e] = fn() -> Int !e

fn run_pure(f: Thunk[!pure]) -> Int !pure = f()

# The language server (the Kotlin Server.kt): LSP over stdio until the client
# disconnects. lsp4j is replaced by a hand-rolled JSON-RPC layer over
# packages/json — Content-Length framing (bytes, UTF-8), requests answered in
# order, publishDiagnostics pushed on every document update. Project documents
# share one root-scoped program, full live overlay and target Java lease;
# standalone buffers keep private programs behind the same query seam. The read
# loop debounces document syncs, so a burst of keystrokes is analysed once
# (LSP-04, docs/audit/lsp-robustness-design.md §2.2).

use std/char
use std/io
use std/str
use std/map
use std/list
use std/set
use std/bytes
use json/parser
use json/value.{Json, JNull, JBool, JNum, JInt, JStr, JArr, JObj, error_text}
use json/render.{render}
use driver/analyze.{
  Program, ProjectPlan, LocDiag,
  analyze_program, analyze_standalone, standalone_entry, project_plan,
  project_module_path, load_entries_over, canon
}
use compiler_plan/source
use ir/interp.{ct_default}
use check/jsig.{JsigLease, jsig_refused_lease}
use driver/stdlib.{StdCtx, load_std, std_load_error_text}
use check/checker.{exports_of, visible_bins}
use lsp/lspq.{QCx, Target, find_target}
use lsp/lspc.{CItem, completions_at}
use front/lexer.{line_starts_of, view_of, SourceView}
use front/diag.{utf16_len}
use check/types.{Sig, builtins, sig_render}
use front/ast.{
  Decl, DFn, DType, DConst, DTrait, DImpl, DUseJava, DUseModule, DTest, DEffect
}
use front/token.{Diag}
use front/fmt

fn crlf() -> String = from_code_points(['\r', '\n'])

## An ASCII code point as the character it names. Every call site below has
## already bounded the value (a byte read from a header, a nibble turned into a
## hex digit), so a failure here is a broken invariant and not an input.
## `char.of` is the checked bridge outside std; the unchecked one is internal.
fn char_of_code(n: Int) -> Char = char.of(n).expect("ASCII code point")

# ---- position mapping (offsets are UTF-16 code units, LSP's encoding) ----

fn line_of(ls: List[Int], offset: Int) -> Int = {
  var lo = 0
  var hi = len(ls) - 1
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if ls[mid] <= offset { lo = mid } else { hi = mid - 1 }
  }
  lo
}

## code-point offset → (0-based line, 0-based UTF-16 column), clamped. The line
## comes from the code-point line starts; the column is the UTF-16 distance from
## the line start (the wire encoding), read off the view's offset table. This is
## the only place code-point positions cross into UTF-16.
fn lsp_position(v: SourceView, ls: List[Int], cpoff: Int) -> (Int, Int) = {
  let n = len(v.cps)
  let clamped = if cpoff < 0 {
    0
  } else if cpoff > n {
    n
  } else {
    cpoff
  }
  let line = line_of(ls, clamped)
  (line, v.offs[clamped] - v.offs[ls[line]])
}

## (0-based line, 0-based UTF-16 column) → code-point offset, clamped to the
## line. The incoming UTF-16 column is resolved back to a code-point index by
## walking the line's offset table.
fn lsp_offset(v: SourceView, ls: List[Int], line0: Int, character: Int) -> Int = {
  let n = len(v.cps)
  if line0 < 0 { return 0 }
  if line0 >= len(ls) { return n }
  let line_start = ls[line0]
  let line_end = if line0 + 1 < len(ls) { ls[line0 + 1] - 1 } else { n }
  let target = v.offs[line_start] + character
  var cp = line_start
  while cp < line_end && v.offs[cp] < target { cp = cp + 1 }
  cp
}

fn jrange(v: SourceView, ls: List[Int], lo: Int, hi: Int) -> Json = {
  let (sl, sc) = lsp_position(v, ls, lo)
  let (el, ec) = lsp_position(v, ls, hi)
  jobj([("start", jpos(sl, sc)), ("end", jpos(el, ec))])
}

fn jpos(line: Int, ch: Int) -> Json =
  jobj([("line", JInt(line)), ("character", JInt(ch))])

test "positions bridge code-point offsets and utf-16 columns at the boundary" {
  # "a🎈b\nx": 🎈 is one code point but two UTF-16 units. `b` is code-point
  # offset 2; on the wire it must be UTF-16 column 3, and the round trip back
  # must recover the same code-point offset.
  let text = "a🎈b\nx"
  let v = view_of(text)
  let ls = line_starts_of(text)
  let (l0, c0) = lsp_position(v, ls, 2)
  assert l0 == 0
  assert c0 == 3
  assert lsp_offset(v, ls, 0, 3) == 2
  let (l1, c1) = lsp_position(v, ls, 4)
  assert l1 == 1
  assert c1 == 0
}

# ---- json helpers ----

fn jobj(entries: List[(String, Json)]) -> Json = {
  var m: Map[String, Json] = map.empty()
  for e in entries {
    let (k, v) = e
    m = map.insert(m, k, v)
  }
  JObj(m)
}

fn oget(j: Json, k: String) -> Option[Json] =
  match j {
    JObj(m) -> map.get(m, k)
    _ -> None
  }

fn ostr(j: Json, k: String) -> String =
  match oget(j, k) {
    Some(JStr(s)) -> s
    _ -> ""
  }

fn oint(j: Json, k: String) -> Int =
  match oget(j, k) {
    Some(JNum(f)) -> to_int(f)
    Some(JInt(n)) -> n
    _ -> 0
  }

## Echo a request id the way lsp4j does: integral numbers render as integers.
fn echo_id(id: Json) -> Json =
  match id {
    JNum(f) -> {
      let n = to_int(f)
      if to_float(n) == f { JInt(n) } else { JNum(f) }
    }
    _ -> id
  }

# ---- uri ↔ path ----

fn hex_val(c: Char) -> Int =
  if c >= '0' && c <= '9' {
    char.code(c) - char.code('0')
  } else if c >= 'a' && c <= 'f' {
    char.code(c) - char.code('a') + 10
  } else if c >= 'A' && c <= 'F' {
    char.code(c) - char.code('A') + 10
  } else {
    -1
  }

## file:// URI → filesystem path, or None for anything this process cannot
## open as a local file (LSP-02).
##
## Four things the old two-line version got wrong, all of them shapes a real
## client sends:
##
## * **authority**. `file://server/share/x` used to yield the *relative* path
##   `server/share/x` -- a path that either does not exist or, worse, exists
##   somewhere unrelated. An empty authority (`file:///x`, what every editor
##   sends) and `localhost` mean "this machine"; any other host is a file this
##   process cannot open, so it is `None` rather than a guess.
## * **query and fragment**. A URI may carry `?` / `#`; a path may not. They
##   are cut before decoding, so a percent escape inside them cannot leak into
##   the path either.
## * **Windows drive letters**. `file:///C:/x` decodes to `/C:/x`, which is not
##   a path on the platform that spells it `C:/x`. A leading slash before a
##   drive letter is dropped -- harmless on POSIX, where no such path exists.
## * **percent-decoding is still validated** (LSP-01): a malformed sequence
##   becomes U+FFFD, so the result is a path that does not exist rather than a
##   path assembled from bytes nobody wrote.
pub fn uri_to_path(uri: String) -> Option[String] = {
  if not str.starts_with(uri, "file://") { return None }
  var rest = str.strip_prefix(uri, "file://").unwrap_or(uri)
  # authority: everything before the first `/` of the path
  if not str.starts_with(rest, "/") {
    let cut = match str.index_of(rest, "/") {
      Some(i) -> i
      None -> str.len(rest)
    }
    let authority = str.take(rest, cut)
    if authority != "" && str.to_lower(authority) != "localhost" { return None }
    rest = str.drop(rest, cut)
  }
  # a path carries neither query nor fragment
  match str.index_of(rest, "#") {
    Some(i) -> { rest = str.take(rest, i) }
    None -> ()
  }
  match str.index_of(rest, "?") {
    Some(i) -> { rest = str.take(rest, i) }
    None -> ()
  }
  if rest == "" { return None }
  rest = drive_path(rest)
  # percent-decode into UTF-8 bytes, then decode
  var bs: List[Int] = []
  let cps = code_points(rest)
  var i = 0
  let n = len(cps)
  while i < n {
    let c = cps[i]
    if c == '%' && i + 2 < n {
      let h = hex_val(cps[i + 1])
      let l = hex_val(cps[i + 2])
      if h >= 0 && l >= 0 {
        bs = bs ++ [h * 16 + l]
        i = i + 3
      } else {
        bs = bs ++ utf8_bytes(c)
        i = i + 1
      }
    } else {
      bs = bs ++ utf8_bytes(c)
      i = i + 1
    }
  }
  Some(utf8_decode(bs))
}

## Decode UTF-8 bytes to a string (percent-decoded URI bytes), validating
## (LSP-01): a continuation byte must be 0x80..0xBF, an overlong encoding, a
## surrogate and anything past U+10FFFF are malformed. Each malformed
## sequence becomes one U+FFFD and decoding resumes at the next byte — the
## URI came from an editor, and a bad one should degrade, not crash or smuggle
## a code point the encoder could never have produced. One pure-Dawn
## implementation, shared by both toolchains (the JDK is not on the native
## side, and an unvalidating decoder was not worth keeping on either).
fn utf8_decode(bs: List[Int]) -> String = {
  var cps: List[Int] = []
  var i = 0
  let n = len(bs)
  while i < n {
    let b0 = bs[i]
    if b0 < 128 {
      cps = cps ++ [b0]
      i = i + 1
    } else if b0 >= 194 && b0 <= 223 && i + 1 < n && is_cont(bs[i + 1]) {
      # 0xC2..0xDF: two bytes; 0xC0/0xC1 would be overlong and fall through
      cps = cps ++ [(b0 - 192) * 64 + (bs[i + 1] - 128)]
      i = i + 2
    } else if b0 >= 224 && b0 <= 239 && i + 2 < n && is_cont(bs[i + 1]) &&
      is_cont(bs[i + 2]) {
        let cp = (b0 - 224) * 4096 + (bs[i + 1] - 128) * 64 + (bs[i + 2] - 128)
        # below 0x800 is overlong; D800..DFFF is a surrogate
        if cp < 2048 || (cp >= 55296 && cp <= 57343) {
          cps = cps ++ [65533]
          i = i + 1
        } else {
          cps = cps ++ [cp]
          i = i + 3
        }
      } else if b0 >= 240 && b0 <= 244 && i + 3 < n && is_cont(bs[i + 1]) &&
      is_cont(bs[i + 2]) && is_cont(bs[i + 3]) {
        let cp = (b0 - 240) * 262144 + (bs[i + 1] - 128) * 4096 +
          (bs[i + 2] - 128) * 64 + (bs[i + 3] - 128)
        # below 0x10000 is overlong; above 0x10FFFF is out of range
        if cp < 65536 || cp > 1114111 {
          cps = cps ++ [65533]
          i = i + 1
        } else {
          cps = cps ++ [cp]
          i = i + 4
        }
      } else {
        # lone continuation, overlong lead (C0/C1), out-of-range lead (F5..FF),
        # or a truncated sequence
        cps = cps ++ [65533]
        i = i + 1
      }
  }
  # every branch above has already established its value is a scalar -- the
  # overlong, surrogate and out-of-range cases are the ones that become U+FFFD
  from_code_points(list.map(cps, c => char_of_code(c)))
}

fn is_cont(b: Int) -> Bool = b >= 128 && b <= 191

test "file URIs: authority, query, fragment and drive letters (LSP-02)" {
  # the shape every editor sends
  assert uri_to_path("file:///tmp/a.dawn") == Some("/tmp/a.dawn")
  # localhost means this machine; another host is a file we cannot open
  assert uri_to_path("file://localhost/tmp/a.dawn") == Some("/tmp/a.dawn")
  assert uri_to_path("file://server/share/a.dawn") == None
  # a path carries neither query nor fragment
  assert uri_to_path("file:///tmp/a.dawn?v=2") == Some("/tmp/a.dawn")
  assert uri_to_path("file:///tmp/a.dawn#L10") == Some("/tmp/a.dawn")
  # a drive-letter path does not begin with a separator...
  assert uri_to_path("file:///C:/src/a.dawn") == Some("C:/src/a.dawn")
  # ...and a single letter without a colon is not a drive
  assert uri_to_path("file:///c/src/a.dawn") == Some("/c/src/a.dawn")
  # non-file schemes and the empty path stay None
  assert uri_to_path("http://x/y") == None
  assert uri_to_path("file://") == None
  # the other direction roots what it emits: three slashes, never two
  assert path_to_uri("/tmp/a.dawn") == "file:///tmp/a.dawn"
  assert path_to_uri("C:/src/a.dawn") == "file:///C:/src/a.dawn"
  # and both directions compose, drive letter included
  let accented = "/tmp/caf" ++ from_code_points(['\u{00E9}']) ++ ".dawn"
  assert uri_to_path(path_to_uri(accented)) == Some(accented)
}

test "uri decoding validates utf-8 instead of trusting it" {
  let fffd = from_code_points(['\u{FFFD}'])
  # the happy path: percent-encoded multibyte decodes exactly (U+00E9)
  assert uri_to_path("file:///tmp/caf%C3%A9.dawn") ==
    Some("/tmp/caf" ++ from_code_points(['\u{00E9}']) ++ ".dawn")
  # a continuation byte that never comes: C3 '(' is malformed, becomes U+FFFD
  assert uri_to_path("file:///a%C3%28b") == Some("/a" ++ fffd ++ "(b")
  # overlong '/' (C0 AF) must not decode to '/': two malformed bytes
  assert uri_to_path("file:///x%C0%AFy") == Some("/x" ++ fffd ++ fffd ++ "y")
  # a surrogate half is not a code point
  assert uri_to_path("file:///s%ED%A0%80e") == Some("/s" ++ fffd ++ fffd ++ fffd ++ "e")
  # a lone continuation byte
  assert uri_to_path("file:///l%80r") == Some("/l" ++ fffd ++ "r")
}

fn utf8_bytes(c: Char) -> List[Int] = {
  let cp = char.code(c)
  if cp < 128 {
    [cp]
  } else if cp < 2048 {
    [192 + cp / 64, 128 + cp % 64]
  } else if cp < 65536 {
    [224 + cp / 4096, 128 + cp / 64 % 64, 128 + cp % 64]
  } else {
    [240 + cp / 262144, 128 + cp / 4096 % 64, 128 + cp / 64 % 64, 128 + cp % 64]
  }
}

fn uri_ok(c: Char) -> Bool =
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
  c == '/' || c == '-' || c == '_' || c == '.' || c == '~' ||
  # ':' is a legal path character (RFC 3986 pchar) and has to survive
  # unencoded, or a Windows drive would round-trip as `%3A` -- readable to a
  # parser, unrecognisable to a human reading the log
  c == ':'

## `/C:/x` → `C:/x`: a drive-letter path does not begin with a separator.
## Left alone anywhere else, including `/c/x` (a single letter is not a drive
## without the colon) and plain POSIX paths.
fn drive_path(p: String) -> String = {
  let cps = code_points(p)
  if len(cps) < 3 { return p }
  if cps[0] != '/' { return p }
  let c = cps[1]
  let alpha = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
  if alpha && cps[2] == ':' { str.drop(p, 1) } else { p }
}

## filesystem path → file:// URI, with the empty authority the standard asks
## for: `file:///x`, never `file://x` (LSP-02). A Windows path (`C:/x`) gains
## the leading slash it needs -- without it the drive letter would parse as the
## authority, and the URI would name a host called `C:`.
pub fn path_to_uri(path: String) -> String = {
  var out: List[Char] = []
  for c in code_points(path) {
    if uri_ok(c) {
      out = out ++ [c]
    } else {
      for b in utf8_bytes(c) {
        out = out ++ ['%', hex_digit(b / 16), hex_digit(b % 16)]
      }
    }
  }
  let body = from_code_points(out)
  let rooted = if str.starts_with(body, "/") { body } else { "/" ++ body }
  "file://" ++ rooted
}

fn hex_digit(v: Int) -> Char =
  char_of_code(if v < 10 { char.code('0') + v } else { char.code('A') + v - 10 })

# ---- document and workspace ownership ----

## Host-specific Java setup without leaking Java-backed modules into this
## shared server. A project failure is already located at dawn.toml/dawn.lock
## so the server can publish it as an ordinary project diagnostic.
pub type LspLeaseHost = {
  standalone: fn() -> JsigLease !io,
  project: fn(source.SourcePlan) -> Result[JsigLease, LocDiag] !io
}

type WorkspaceIdentity = {
  source_root: String,
  lookup_key: String
}

## Length-prefixed components make the canonical path pair injective without
## assuming that any ordinary path character is unavailable as a separator.
fn workspace_key_part(value: String) -> String =
  to_string(str.len(value)) ++ ":" ++ value

fn workspace_identity(plan: ProjectPlan) -> WorkspaceIdentity !io = {
  let project = canon(plan.source.project)
  let source_root = canon(plan.source.source_root)
  WorkspaceIdentity {
    source_root: source_root,
    lookup_key: workspace_key_part(project) ++ workspace_key_part(source_root)
  }
}

type DocAnalysis =
  | Standalone(prog: Program, entry: String, modules: Option[Map[String, String]])
  | WorkspaceMember(identity: WorkspaceIdentity)

type Doc = {
  uri: String,
  version: Int,
  path: Option[String],
  canonical_path: Option[String],
  text: String,
  view: SourceView,
  ls: List[Int],
  analysis: DocAnalysis
}

## A target whose Java setup succeeded. `prog = None` is an intentional
## fail-closed conflict snapshot, never the previous successful program.
type Workspace = {
  plan: ProjectPlan,
  path_by_uri: Map[String, String],
  prog: Option[Program],
  entry_by_uri: Map[String, String],
  lease: JsigLease,
  diag_by_uri: Map[String, List[Json]]
}

## Maven, lock or loader setup failed before a usable workspace existed. Open
## buffers remain here for formatting and a later explicit retry, but semantic
## queries cannot observe a stale or half-installed program.
type UnavailableWorkspace = {
  plan: ProjectPlan,
  path_by_uri: Map[String, String],
  problem: LocDiag,
  diag_by_uri: Map[String, List[Json]]
}

type WorkspaceSlot = Ready(workspace: Workspace) | Unavailable(workspace: UnavailableWorkspace)

type Analysis = {
  prog: Program,
  entry: String,
  modules: Option[Map[String, String]],
  workspace_key: Option[String],
  definition_root: Option[String]
}

fn workspace_modules(ws: Workspace, current_uri: String) -> Map[String, String] = {
  let current_entry = map.get(ws.entry_by_uri, current_uri).expect("current workspace entry")
  var out = map.remove(ws.plan.modules.by_use, current_entry)
  for uri in sort(map.keys(ws.entry_by_uri)) {
    let entry = map.get(ws.entry_by_uri, uri).expect("workspace entry")
    if entry != current_entry {
      let path = map.get(ws.path_by_uri, uri).expect("workspace path")
      out = map.insert(out, entry, path)
    }
  }
  out
}

## The only semantic ownership seam. Every feature either gets one coherent
## analysis or fails closed while a workspace is unavailable/conflicted.
fn analysis_of(st: LspState, d: Doc) -> Option[Analysis] =
  match d.analysis {
    Standalone(prog, entry, modules) -> Some(Analysis {
      prog: prog,
      entry: entry,
      modules: modules,
      workspace_key: None,
      definition_root: None
    })
    WorkspaceMember(identity) ->
      match map.get(st.workspaces, identity.lookup_key) {
        Some(Ready(ws)) ->
          match ws.prog {
            Some(prog) ->
              match map.get(ws.entry_by_uri, d.uri) {
                Some(entry) -> Some(Analysis {
                  prog: prog,
                  entry: entry,
                  modules: Some(workspace_modules(ws, d.uri)),
                  workspace_key: Some(identity.lookup_key),
                  definition_root: Some(identity.source_root)
                })
                None -> None
              }
            None -> None
          }
        _ -> None
      }
  }

fn doc_qcx(st: LspState, analysis: Analysis) -> Option[QCx] = {
  let entry = list.find(analysis.prog.modules, cm => cm.mod_path == analysis.entry)
  match entry {
    Some(e) -> {
      var env = st.std.exports
      for cm in analysis.prog.modules {
        env = map.insert(env, cm.mod_path, exports_of(cm.cx, cm.m, cm.mod_path, cm.class_name))
      }
      Some(QCx {
        entry: e,
        prog: analysis.prog,
        std: st.std,
        exports_env: env,
        bins: visible_bins(st.bins, e.cx)
      })
    }
    None -> None
  }
}

type Lifecycle = PreInit | Running | Shutdown

type LifecycleGate =
  | LgActivate
  | LgDispatch
  | LgBeginShutdown
  | LgReject(code: Int, message: String)
  | LgIgnore
  | LgExit(code: Int)

type LspState = {
  std: StdCtx,
  bins: Map[String, Sig],
  docs: Map[String, Doc],
  workspaces: Map[String, WorkspaceSlot],
  standalone: Option[JsigLease],
  host: LspLeaseHost,
  lifecycle: Lifecycle
}

## Close one lease without allowing its failure to skip the remaining leases.
fn close_lease(lease: JsigLease) -> Unit !io =
  match catch_panic(() => lease.close()) {
    Ok(_) -> ()
    Err(e) -> io.eprintln("lsp: failed to close a Java signature lease: " ++ e.message)
  }

## Release every host resource exactly once. Clearing ownership in the
## returned state makes shutdown followed by exit harmless.
fn close_all_leases(st0: LspState) -> LspState !io = {
  var st = st0
  for workspace_key in sort(map.keys(st.workspaces)) {
    match map.get(st.workspaces, workspace_key).expect("workspace") {
      Ready(ws) -> close_lease(ws.lease)
      Unavailable(_) -> ()
    }
  }
  match st.standalone {
    Some(lease) -> close_lease(lease)
    None -> ()
  }
  let none: Option[JsigLease] = None
  let no_workspaces: Map[String, WorkspaceSlot] = map.empty()
  LspState { ..st, workspaces: no_workspaces, standalone: none }
}

fn has_request_id(msg: Json) -> Bool =
  match oget(msg, "id") {
    Some(_) -> true
    None -> false
  }

const ABNORMAL_EXIT_STATUS: Int = 1

fn lifecycle_gate(lifecycle: Lifecycle, msg: Json) -> LifecycleGate = {
  let method = ostr(msg, "method")
  let request = has_request_id(msg)
  match lifecycle {
    PreInit -> {
      if method == "exit" && not request {
        LgExit(ABNORMAL_EXIT_STATUS)
      } else if method == "initialize" && request {
        LgActivate
      } else if request {
        LgReject(-32002, "Server not initialized")
      } else {
        LgIgnore
      }
    }
    Running -> {
      if method == "exit" && not request {
        LgExit(ABNORMAL_EXIT_STATUS)
      } else if method == "exit" && request {
        LgReject(-32600, "Invalid Request")
      } else if method == "initialize" {
        if request { LgReject(-32600, "Invalid Request") } else { LgIgnore }
      } else if method == "shutdown" {
        if request { LgBeginShutdown } else { LgIgnore }
      } else {
        LgDispatch
      }
    }
    Shutdown -> {
      if method == "exit" && not request {
        LgExit(0)
      } else if request {
        LgReject(-32600, "Invalid Request")
      } else {
        LgIgnore
      }
    }
  }
}

# ---- the server loop ----

## The `--std <dir>` a client passed on the server's command line, if any.
##
## Every other subcommand parses this; `lsp` did not, so there was not even an
## escape hatch when the default landed somewhere wrong.
pub fn lsp_std_flag(rest: List[String]) -> Option[String] = {
  var i = 0
  while i < len(rest) {
    if rest[i] == "--std" && i + 1 < len(rest) {
      return Some(rest[i + 1])
    }
    i = i + 1
  }
  None
}

## Where a language server loads std from. Explicit flag first, then the std
## belonging to this toolchain, and only then the cwd-relative literal.
##
## Not the process cwd, which is what this used to be. Every other subcommand
## is run by someone who chose the directory they are standing in and can pass
## `--std`; a language server is spawned by an editor, whose cwd nobody chose
## and which is routinely not the checkout. The literal `"std"` then missed,
## `load_std` fell back to the embedded copy, and a source file of the very
## checkout being edited was no longer recognised as std: 281 phantom
## "undefined function" diagnostics on files that `dawn check` calls clean.
##
## A toolchain only ever checked the std it was released with, so the answer
## belongs to the toolchain. `bin/dawn` resolves its own location -- it already
## follows symlinks hop by hop to find the real checkout -- and exports
## DAWN_STD when a std directory is actually sitting there. An installed
## release has none, exports nothing, and falls through to the copy embedded
## in the jar, which is the std that release was built with and so is still the
## right answer. The launcher never names a directory that does not exist.
##
## The last resort stays cwd-relative rather than becoming an error: running
## the jar directly from a checkout is a real workflow, and it worked before.
pub fn lsp_std_dir(flag: Option[String], from_env: Option[String]) -> String =
  match flag {
    Some(d) -> d
    None ->
      match from_env {
        Some(d) -> d
        None -> "std"
      }
  }

## The driver supplies resource factories rather than one process-global Java
## oracle. The JVM host creates a platform-only standalone lease and one lease
## per target; the native host creates lifecycle-compatible refusals.
pub fn run_lsp(std_flag: Option[String], host: LspLeaseHost) -> Unit !io = {
  let std_dir = lsp_std_dir(std_flag, io.getenv("DAWN_STD"))
  let std = match load_std(std_dir) {
    Ok(sc) -> sc
    Err(e) -> panic(std_load_error_text(e))
  }
  let standalone = host.standalone()
  var st = LspState {
    std: std,
    bins: builtins(),
    docs: map.empty(),
    workspaces: map.empty(),
    standalone: Some(standalone),
    host: host,
    lifecycle: PreInit
  }
  # The newest text of the one document whose analysis has not run yet.
  #
  # At most one, and that is what makes deferring the work invisible: an
  # update naming a *different* document flushes the one already waiting, so
  # analyses still happen in the order the client asked for. Only repeats of
  # the same document coalesce — which is the whole point, since `didChange`
  # is Full sync and each one supersedes the last.
  var pending: Option[(String, String, Int)] = None
  var serving = true
  var exit_status: Option[Int] = None
  while serving {
    # Three branches, and the third is what makes the second safe. Readiness
    # never reports end of input (std/io.stdin_ready says why), so a loop that
    # only ever waited on it would spin the moment its client went away. With
    # nothing pending there is nothing to wait for and blocking is the right
    # thing to do — and the blocking read is what reports end of input.
    let take = match pending {
      Some(_) -> io.stdin_ready(DEBOUNCE_MS)
      None -> true
    }
    if take {
      match read_message() {
        Eof -> { serving = false }
        Message(msg) -> {
          let gate = lifecycle_gate(st.lifecycle, msg)
          match gate {
            LgActivate -> {
              st = LspState { ..st, lifecycle: Running }
              st = handle(st, msg)
            }
            LgDispatch ->
              match update_of(msg) {
                Some(u) -> {
                  let (uri, text, version) = u
                  match pending {
                    Some(p0) -> {
                      let (uri0, _, _) = p0
                      if uri0 != uri { st = flush(st, pending) }
                    }
                    None -> ()
                  }
                  pending = Some((uri, text, version))
                }
                # Anything else may read the analysed program or write about it,
                # so the deferred work has to have happened first. That is also
                # why the deferral is not observable: every answer about a
                # document passes this point.
                None -> {
                  st = flush(st, pending)
                  pending = None
                  st = handle(st, msg)
                }
              }
            LgBeginShutdown -> {
              pending = None
              st = LspState { ..st, lifecycle: Shutdown }
              st = handle(st, msg)
              st = close_all_leases(st)
            }
            LgReject(code, message) -> {
              let id = match oget(msg, "id") {
                Some(value) -> value
                None -> JNull
              }
              respond_error(id, code, message)
            }
            LgIgnore -> ()
            LgExit(code) -> {
              pending = None
              exit_status = Some(code)
              serving = false
            }
          }
        }
        # The declared body was read in full, so malformed JSON leaves the next
        # frame boundary known and the session can continue.
        Malformed(code, why) -> {
          st = flush(st, pending)
          pending = None
          send(jobj([("jsonrpc", JStr("2.0")), ("id", JNull),
            ("error", jobj([("code", JInt(code)), ("message", JStr(why))]))]))
        }
        # A framing failure has no trustworthy resynchronisation point. Emit
        # one fixed parse error and stop reading; bytes after the failure are
        # deliberately never interpreted as another frame.
        Fatal -> {
          pending = None
          send(jobj([("jsonrpc", JStr("2.0")), ("id", JNull),
            ("error", jobj([("code", JInt(-32700)), ("message", JStr("Parse error"))]))]))
          serving = false
        }
      }
    } else {
      # The window elapsed with nothing arriving: the client has stopped
      # typing, so analyse the newest text it sent.
      st = flush(st, pending)
      pending = None
    }
  }
  st = close_all_leases(st)
  match exit_status {
    Some(code) -> { let _ = io.exit(code) }
    None -> ()
  }
}

## How long standard input must stay quiet before a pending edit is analysed.
##
## The wait happens inside `io.stdin_ready`, which sleeps rather than polls, so
## a session that is merely idle costs nothing — scripts/lsp-liveness.py's
## `idle` assertion measures exactly that, and its `debounce` assertion
## measures the coalescing this number buys.
##
## 150 ms is the design's placeholder and has no measurement behind it yet
## (docs/audit/lsp-robustness-design.md §六 step 4 is the job of finding one:
## time `didChange` → published diagnostics while typing into selfhost's own
## 31k lines). It is stated here rather than inlined so that step has one place
## to land.
const DEBOUNCE_MS: Int = 150

## Run the analysis a document sync deferred, if there is one.
fn flush(st: LspState, pending: Option[(String, String, Int)]) -> LspState !io =
  match pending {
    Some(p) -> {
      let (uri, text, version) = p
      update_doc(st, uri, text, version)
    }
    None -> st
  }

## The (uri, text, version) a document-sync notification carries, or `None`
## when the message is anything else. Keeping the version beside the text is
## what makes a debounced publish name the snapshot it actually analyzed.
##
## A sync notification with no text in it — `didChange` with an empty
## `contentChanges` — is `None` too, and lands in `handle` where it has always
## been ignored. There is nothing to defer about an update that carries no
## document.
fn update_of(msg: Json) -> Option[(String, String, Int)] = {
  let method = ostr(msg, "method")
  let params = match oget(msg, "params") {
    Some(j) -> j
    None -> JNull
  }
  let td = get_or_null(params, "textDocument")
  if method == "textDocument/didOpen" {
    Some((ostr(td, "uri"), ostr(td, "text"), oint(td, "version")))
  } else if method == "textDocument/didChange" {
    match oget(params, "contentChanges") {
      Some(JArr(changes)) ->
        match get(changes, 0) {
          Some(c) -> Some((ostr(td, "uri"), ostr(c, "text"), oint(td, "version")))
          None -> None
        }
      _ -> None
    }
  } else {
    None
  }
}

const HEADER_MAX_BYTES: Int = 8192
const BODY_MAX_BYTES: Int = 67108864

fn ascii_ci_equal(left: String, right: String) -> Bool = {
  let left_cps = code_points(left)
  let right_cps = code_points(right)
  if len(left_cps) != len(right_cps) { return false }
  var index = 0
  while index < len(left_cps) {
    let left_code = char.code(left_cps[index])
    let right_code = char.code(right_cps[index])
    let left_folded = if left_code >= char.code('A') && left_code <= char.code('Z') {
      left_code + 32
    } else {
      left_code
    }
    let right_folded = if right_code >= char.code('A') && right_code <= char.code('Z') {
      right_code + 32
    } else {
      right_code
    }
    if left_folded != right_folded { return false }
    index = index + 1
  }
  true
}

fn is_header_pad(code: Int) -> Bool = code == char.code(' ') || code == char.code('\t')

fn is_header_name_code(code: Int) -> Bool =
  (code >= char.code('a') && code <= char.code('z')) ||
  (code >= char.code('A') && code <= char.code('Z')) ||
  (code >= char.code('0') && code <= char.code('9')) ||
  code == char.code('!') || code == char.code('#') || code == char.code('$') ||
  code == char.code('%') || code == char.code('&') || code == char.code('\'') ||
  code == char.code('*') || code == char.code('+') || code == char.code('-') ||
  code == char.code('.') || code == char.code('^') || code == char.code('_') ||
  code == char.code('`') || code == char.code('|') || code == char.code('~')

fn valid_header_name(name: String) -> Bool = {
  let cps = code_points(name)
  if len(cps) == 0 { return false }
  for cp in cps {
    if not is_header_name_code(char.code(cp)) { return false }
  }
  true
}

## Content-Length is deliberately not parsed by the language's general
## `parse_int`: the wire grammar has no sign and trims only SP/HTAB. Accumulate
## negatively so an oversized decimal is rejected before any host conversion.
fn parse_content_length_value(raw: String) -> Option[Int] = {
  let cps = code_points(raw)
  var first = 0
  var last = len(cps)
  while first < last && is_header_pad(char.code(cps[first])) { first = first + 1 }
  while last > first && is_header_pad(char.code(cps[last - 1])) { last = last - 1 }
  if first == last { return None }

  let limit = 0 - 9223372036854775807
  let multmin = limit / 10
  var value = 0
  var index = first
  while index < last {
    let code = char.code(cps[index])
    if code < char.code('0') || code > char.code('9') { return None }
    let digit = code - char.code('0')
    if value < multmin { return None }
    value = value * 10
    if value < limit + digit { return None }
    value = value - digit
    index = index + 1
  }
  Some(0 - value)
}

## Parse the completed header block. Duplicate Content-Length fields agree by
## value, not spelling; any invalid occurrence poisons the whole frame.
fn parse_content_length(header: String) -> Option[Int] = {
  if str.len(header) > HEADER_MAX_BYTES || not str.ends_with(header, "\r\n\r\n") {
    return None
  }
  var found: Option[Int] = None
  for line in str.split(header, "\r\n") {
    if line != "" {
      match str.split_once(line, ":") {
        Some((name, raw)) -> {
          if not valid_header_name(name) { return None }
          if ascii_ci_equal(name, "Content-Length") {
            let parsed = match parse_content_length_value(raw) {
              Some(value) -> value
              None -> return None
            }
            if parsed > BODY_MAX_BYTES { return None }
            match found {
              Some(previous) -> if previous != parsed { return None }
              None -> { found = Some(parsed) }
            }
          }
        }
        None -> return None
      }
    }
  }
  found
}

test "Content-Length accepts exact wire bounds and ASCII spelling variants" {
  let suffix = "\r\nContent-Length: 0\r\n\r\n"
  let exact = "X:" ++ str.repeat("a", HEADER_MAX_BYTES - 2 - str.len(suffix)) ++ suffix
  assert str.len(exact) == HEADER_MAX_BYTES
  assert parse_content_length(exact) == Some(0)
  assert parse_content_length("X:a" ++ exact) == None

  assert parse_content_length("Content-Length: 0\r\n\r\n") == Some(0)
  assert parse_content_length("cOnTeNt-LeNgTh:\t 00042 \t\r\n\r\n") == Some(42)
  assert parse_content_length("Content-Length: 67108864\r\n\r\n") == Some(67108864)
  assert parse_content_length("Content-Length: 67108865\r\n\r\n") == None
}

test "Content-Length is unsigned ASCII decimal within Int range" {
  for value in [
    "", "+1", "-0", "1.0", "1e2", "1_0", "４",
    "9223372036854775808", "2147483648"
  ] {
    assert parse_content_length("Content-Length: " ++ value ++ "\r\n\r\n") == None
  }
}

test "duplicate Content-Length fields agree by parsed value" {
  assert parse_content_length(
    "Content-Length: 42\r\ncontent-length:\t00042 \t\r\n\r\n"
  ) == Some(42)
  assert parse_content_length(
    "Content-Length: 42\r\nCONTENT-LENGTH: 43\r\n\r\n"
  ) == None
  assert parse_content_length(
    "Content-Length: 42\r\nCONTENT-LENGTH: +42\r\n\r\n"
  ) == None
  assert parse_content_length("X-Test: value\r\n\r\n") == None
}

test "header lines require a nonempty ASCII token name" {
  assert parse_content_length(
    "X-Test: ignored\r\nContent-Length: 0\r\n\r\n"
  ) == Some(0)
  for line in ["NoColon", ": value", "Bad Name: value", "Bad(Name): value"] {
    assert parse_content_length(line ++ "\r\nContent-Length: 0\r\n\r\n") == None
  }
}

fn bytes_of(values: List[Int]) -> Bytes = {
  var out = bytes.buf()
  for value in values { out = bytes.put(out, value) }
  bytes.freeze(out)
}

## The outcome of one read. `Malformed` is reserved for a complete, bounded
## frame whose JSON body is bad and therefore leaves the next boundary known;
## framing errors are fatal because their next byte cannot be trusted.
type Frame = Eof | Message(value: Json) | Malformed(code: Int, why: String) | Fatal

## A complete body, decoded and parsed. LSP JSON must reject malformed UTF-8
## rather than accept its replacement decoding, so the strict decoder is the
## boundary: `decode_utf8_checked` answers `Ok` for exactly the inputs the
## lossy one returns unchanged (LIB-06).
fn decode_body(body: Bytes) -> Frame =
  match bytes.decode_utf8_checked(body) {
    Ok(text) -> match parser.parse(text) {
      Ok(j) -> Message(j)
      Err(e) -> Malformed(-32700, "Parse error: " ++ error_text(e))
    }
    Err(_) -> Malformed(-32700, "Parse error: invalid UTF-8")
  }

test "LSP bodies require strict UTF-8 before decoding" {
  assert decode_body(bytes.utf8("\"plain 中😀�\"")) == Message(JStr("plain 中😀�"))
  # Replacement decoding turns each of these into the valid JSON string "�";
  # accepting the decoded text would therefore hide an invalid wire body.
  assert decode_body(bytes_of([0x22, 0x80, 0x22])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
  assert decode_body(bytes_of([0xC0, 0xAF])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
  assert decode_body(bytes_of([0xED, 0xA0, 0x80])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
  assert decode_body(bytes_of([0xF4, 0x90, 0x80, 0x80])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
  assert decode_body(bytes_of([0xE2, 0x82])) ==
    Malformed(-32700, "Parse error: invalid UTF-8")
}

## One framed message: headers to CRLFCRLF, then Content-Length bytes of JSON.
fn read_message() -> Frame !io = {
  var header: List[Int] = []
  var state = 0
  while state < 4 {
    let one = io.read_stdin(1)
    if bytes.len(one) == 0 {
      return if len(header) == 0 { Eof } else { Fatal }
    } else {
      let b = bytes.at(one, 0)
      header = header ++ [b]
      # CR LF CR LF
      if state == 0 && b == char.code('\r') {
        state = 1
      } else if state == 1 && b == char.code('\n') {
        state = 2
      } else if state == 2 && b == char.code('\r') {
        state = 3
      } else if state == 3 && b == char.code('\n') {
        state = 4
      } else {
        state = if b == char.code('\r') { 1 } else { 0 }
      }
      # Completion on byte 8192 is legal. Anything still incomplete at that
      # point is fatal immediately; byte 8193 is never read or accumulated.
      if state < 4 && len(header) >= HEADER_MAX_BYTES { return Fatal }
    }
  }
  # Preserve one code point per byte; Content-Length itself is ASCII-only.
  let htext = from_code_points(list.map(header, b => char_of_code(b)))
  let clen = match parse_content_length(htext) {
    Some(value) -> value
    None -> return Fatal
  }
  # The cap was checked by the pure parser before this call. Neither JVM's
  # L2I nor native's allocation can therefore observe an unbounded value.
  let body = io.read_stdin(clen)
  if bytes.len(body) < clen { return Fatal }
  # Exactly clen bytes were consumed, so a Malformed body still leaves the
  # next frame starting where it should.
  decode_body(body)
}

fn send(j: Json) -> Unit !io = {
  let payload = render(j)
  let n = bytes.len(bytes.utf8(payload))
  print("Content-Length: " ++ to_string(n) ++ crlf() ++ crlf() ++ payload)
}

fn respond(id: Json, result: Json) -> Unit !io =
  send(jobj([("jsonrpc", JStr("2.0")), ("id", echo_id(id)), ("result", result)]))

fn respond_error(id: Json, code: Int, message: String) -> Unit !io =
  send(jobj([
    ("jsonrpc", JStr("2.0")),
    ("id", echo_id(id)),
    ("error", jobj([("code", JInt(code)), ("message", JStr(message))]))
  ]))

fn notify(method: String, params: Json) -> Unit !io =
  send(jobj([("jsonrpc", JStr("2.0")), ("method", JStr(method)), ("params", params)]))

fn handle(st0: LspState, msg: Json) -> LspState !io = {
  var st = st0
  let method = ostr(msg, "method")
  let id = match oget(msg, "id") {
    Some(j) -> j
    None -> JNull
  }
  let params = match oget(msg, "params") {
    Some(j) -> j
    None -> JNull
  }
  if method == "initialize" {
    respond(id, jobj([("capabilities", jobj([
      ("textDocumentSync", JInt(1)),
      ("hoverProvider", JBool(true)),
      ("completionProvider", jobj([
        ("resolveProvider", JBool(false)),
        ("triggerCharacters", JArr([JStr("!")]))
      ])),
      ("definitionProvider", JBool(true)),
      ("documentSymbolProvider", JBool(true)),
      ("documentFormattingProvider", JBool(true))
    ]))]))
  } else if method == "initialized" {
    ()
  } else if method == "textDocument/didOpen" || method == "textDocument/didChange" {
    # `update_of` claimed every sync notification that carried a document, so
    # what reaches here is one that carried none — nothing to analyse, which
    # is what this arm did with it before the read loop debounced.
    ()
  } else if method == "textDocument/didClose" {
    let td = get_or_null(params, "textDocument")
    let uri = ostr(td, "uri")
    st = close_doc(st, uri)
  } else if method == "textDocument/didSave" {
    let td = get_or_null(params, "textDocument")
    st = retry_unavailable(st, ostr(td, "uri"))
  } else if method == "textDocument/completion" {
    respond(id, handle_completion(st, params))
  } else if method == "textDocument/hover" {
    respond(id, handle_hover(st, params))
  } else if method == "textDocument/definition" {
    respond(id, handle_definition(st, params))
  } else if method == "textDocument/documentSymbol" {
    respond(id, handle_symbols(st, params))
  } else if method == "textDocument/formatting" {
    respond(id, handle_formatting(st, params))
  } else if method == "shutdown" {
    respond(id, JNull)
  } else {
    # a request we do not implement: MethodNotFound; notifications are ignored
    if has_request_id(msg) {
      send(jobj([("jsonrpc", JStr("2.0")), ("id", echo_id(id)),
        ("error", jobj([
          ("code", JInt(-32601)),
          ("message", JStr("Unsupported request method: " ++ method))
        ]))]))
    }
  }
  st
}

fn get_or_null(j: Json, k: String) -> Json =
  match oget(j, k) {
    Some(v) -> v
    None -> JNull
  }

# ---- document sync ----

type WorkspaceInputs =
  | InputsReady(
    overlay: Map[String, String],
    entries: List[String],
    entry_by_uri: Map[String, String]
  )
  | InputsConflict(paths: Set[String])

fn diagnostic_json(view: SourceView, ls: List[Int], dg: Diag) -> Json = {
  let message = if dg.hint != "" { dg.msg ++ "\nhint: " ++ dg.hint } else { dg.msg }
  jobj([
    ("range", jrange(view, ls, dg.lo, dg.hi)),
    ("severity", JInt(1)),
    ("source", JStr("dawn")),
    ("message", JStr(message))
  ])
}

fn append_diagnostic(
  out0: Map[String, List[Json]],
  uri: String,
  value: Json
) -> Map[String, List[Json]] = {
  let before = match map.get(out0, uri) {
    Some(values) -> values
    None -> []
  }
  map.insert(out0, uri, before ++ [value])
}

fn add_loc_diag(
  st: LspState,
  path_by_uri: Map[String, String],
  out0: Map[String, List[Json]],
  ld: LocDiag
) -> Map[String, List[Json]] !io = {
  var out = out0
  let target = canon(ld.path)
  var matched = false
  for uri in sort(map.keys(path_by_uri)) {
    if map.get(path_by_uri, uri).expect("workspace path") == target {
      match map.get(st.docs, uri) {
        Some(d) -> {
          out = append_diagnostic(out, uri, diagnostic_json(d.view, d.ls, ld.d))
          matched = true
        }
        None -> ()
      }
    }
  }
  if not matched {
    let text = match io.read_file(target) {
      Ok(found) -> found
      Err(_) -> ""
    }
    out = append_diagnostic(out, path_to_uri(target),
      diagnostic_json(view_of(text), line_starts_of(text), ld.d))
  }
  out
}

fn diagnostics_of_program(
  st: LspState,
  path_by_uri: Map[String, String],
  prog: Program
) -> Map[String, List[Json]] !io = {
  var out: Map[String, List[Json]] = map.empty()
  for ld in prog.diags { out = add_loc_diag(st, path_by_uri, out, ld) }
  out
}

fn diagnostics_of_problem(
  st: LspState,
  path_by_uri: Map[String, String],
  problem: LocDiag
) -> Map[String, List[Json]] !io = {
  let out: Map[String, List[Json]] = map.empty()
  add_loc_diag(st, path_by_uri, out, problem)
}

fn workspace_inputs(
  st: LspState,
  plan: ProjectPlan,
  path_by_uri: Map[String, String]
) -> WorkspaceInputs !io = {
  var texts: Map[String, String] = map.empty()
  var overlay: Map[String, String] = map.empty()
  var entries: List[String] = []
  var entry_by_uri: Map[String, String] = map.empty()
  var conflicts: Set[String] = set.empty()
  for uri in sort(map.keys(path_by_uri)) {
    let path = map.get(path_by_uri, uri).expect("workspace path")
    let d = map.get(st.docs, uri).expect("workspace document")
    match map.get(texts, path) {
      Some(before) -> {
        if before != d.text { conflicts = set.insert(conflicts, path) }
      }
      None -> {
        texts = map.insert(texts, path, d.text)
        overlay = map.insert(overlay, path, d.text)
      }
    }
    entries = entries ++ [path]
    let entry = project_module_path(plan, path).expect("valid workspace member")
    entry_by_uri = map.insert(entry_by_uri, uri, entry)
  }
  if set.is_empty(conflicts) {
    InputsReady(overlay, entries, entry_by_uri)
  } else {
    InputsConflict(conflicts)
  }
}

fn conflict_diagnostics(
  st: LspState,
  path_by_uri: Map[String, String],
  paths: Set[String]
) -> Map[String, List[Json]] = {
  var out: Map[String, List[Json]] = map.empty()
  let dg = Diag {
    msg: "multiple open documents resolve to the same file with different text",
    lo: 0,
    hi: 0,
    hint: "close one duplicate URI or make their contents identical"
  }
  for uri in sort(map.keys(path_by_uri)) {
    let path = map.get(path_by_uri, uri).expect("workspace path")
    if set.has(paths, path) {
      let d = map.get(st.docs, uri).expect("workspace document")
      out = append_diagnostic(out, uri, diagnostic_json(d.view, d.ls, dg))
    }
  }
  out
}

## Rebuild one coherent workspace snapshot. Conflict detection happens before the
## overlay map can overwrite either live text, and discards the old program.
fn rebuild_workspace(st: LspState, ws0: Workspace) -> Workspace !io =
  match workspace_inputs(st, ws0.plan, ws0.path_by_uri) {
    InputsConflict(paths) -> {
      let no_entries: Map[String, String] = map.empty()
      let no_prog: Option[Program] = None
      Workspace {
        ..ws0,
        prog: no_prog,
        entry_by_uri: no_entries,
        diag_by_uri: conflict_diagnostics(st, ws0.path_by_uri, paths)
      }
    }
    InputsReady(overlay, entries, entry_by_uri) -> {
      let loaded = load_entries_over(ws0.plan, entries, overlay)
      let prog = analyze_program(loaded, st.std, ct_default(), ws0.lease.jsig)
      Workspace {
        ..ws0,
        prog: Some(prog),
        entry_by_uri: entry_by_uri,
        diag_by_uri: diagnostics_of_program(st, ws0.path_by_uri, prog)
      }
    }
  }

fn unavailable_workspace(
  st: LspState,
  plan: ProjectPlan,
  path_by_uri: Map[String, String],
  problem: LocDiag
) -> UnavailableWorkspace !io =
  UnavailableWorkspace {
    plan: plan,
    path_by_uri: path_by_uri,
    problem: problem,
    diag_by_uri: diagnostics_of_problem(st, path_by_uri, problem)
  }

## Construct the lease before installing a ready workspace. Failure installs
## only an explicit unavailable state, never a platform/system fallback.
fn activate_workspace(
  st: LspState,
  plan: ProjectPlan,
  path_by_uri: Map[String, String]
) -> WorkspaceSlot !io =
  match st.host.project(plan.source) {
    Ok(lease) -> {
      let no_prog: Option[Program] = None
      let no_entries: Map[String, String] = map.empty()
      let no_diags: Map[String, List[Json]] = map.empty()
      let candidate = Workspace {
        plan: plan,
        path_by_uri: path_by_uri,
        prog: no_prog,
        entry_by_uri: no_entries,
        lease: lease,
        diag_by_uri: no_diags
      }
      match catch_panic(() => rebuild_workspace(st, candidate)) {
        Ok(workspace) -> Ready(workspace)
        Err(e) -> {
          close_lease(lease)
          panic("lsp workspace rebuild failed before installation: " ++ e.message)
        }
      }
    }
    Err(problem) -> Unavailable(unavailable_workspace(st, plan, path_by_uri, problem))
  }

fn slot_paths(slot: WorkspaceSlot) -> Map[String, String] =
  match slot {
    Ready(ws) -> ws.path_by_uri
    Unavailable(ws) -> ws.path_by_uri
  }

fn slot_diagnostics(slot: WorkspaceSlot) -> Map[String, List[Json]] =
  match slot {
    Ready(ws) -> ws.diag_by_uri
    Unavailable(ws) -> ws.diag_by_uri
  }

fn add_uris(out0: Set[String], values: List[String]) -> Set[String] = {
  var out = out0
  for value in values { out = set.insert(out, value) }
  out
}

fn slot_uris(slot: WorkspaceSlot) -> Set[String] = {
  var out: Set[String] = set.empty()
  out = add_uris(out, map.keys(slot_paths(slot)))
  add_uris(out, map.keys(slot_diagnostics(slot)))
}

fn standalone_diagnostics(d: Doc, prog: Program) -> List[Json] !io = {
  var out: List[Json] = []
  for ld in prog.diags {
    let own = match d.canonical_path {
      Some(path) -> canon(ld.path) == path
      None -> true
    }
    if own { out = out ++ [diagnostic_json(d.view, d.ls, ld.d)] }
  }
  out
}

## Aggregate every root's contribution before publishing one URI. This is the
## clearing rule that prevents one root from erasing another root's diagnostic
## when both point at the same manifest, lock or dependency file.
fn diagnostics_for_uri(st: LspState, uri: String) -> List[Json] !io = {
  var out: List[Json] = []
  for workspace_key in sort(map.keys(st.workspaces)) {
    let slot = map.get(st.workspaces, workspace_key).expect("workspace")
    match map.get(slot_diagnostics(slot), uri) {
      Some(values) -> { out = out ++ values }
      None -> ()
    }
  }
  match map.get(st.docs, uri) {
    Some(d) ->
      match d.analysis {
        Standalone(prog, _, _) -> { out = out ++ standalone_diagnostics(d, prog) }
        WorkspaceMember(_) -> ()
      }
    None -> ()
  }
  out
}

fn publish_uris(st: LspState, uris: Set[String]) -> Unit !io = {
  for uri in sort(set.to_list(uris)) {
    var fields: List[(String, Json)] = [
      ("uri", JStr(uri)),
      ("diagnostics", JArr(diagnostics_for_uri(st, uri)))
    ]
    match map.get(st.docs, uri) {
      Some(d) -> { fields = fields ++ [("version", JInt(d.version))] }
      None -> ()
    }
    notify("textDocument/publishDiagnostics", jobj(fields))
  }
}

fn install_workspace(
  st0: LspState,
  identity: WorkspaceIdentity,
  slot: WorkspaceSlot,
  affected0: Set[String]
) -> LspState !io = {
  var affected = add_uris(affected0, set.to_list(slot_uris(slot)))
  let st = LspState {
    ..st0,
    workspaces: map.insert(st0.workspaces, identity.lookup_key, slot)
  }
  publish_uris(st, affected)
  st
}

fn standalone_doc(
  st: LspState,
  uri: String,
  path: Option[String],
  canonical_path: Option[String],
  text: String,
  version: Int,
  modules: Option[Map[String, String]]
) -> Doc !io = {
  let source_path = match path {
    Some(found) -> found
    None -> "<lsp>"
  }
  let prog = match st.standalone {
    Some(lease) -> analyze_standalone(source_path, text, st.std, ct_default(), lease.jsig)
    None -> panic("standalone LSP lease used after shutdown")
  }
  Doc {
    uri: uri,
    version: version,
    path: path,
    canonical_path: canonical_path,
    text: text,
    view: view_of(text),
    ls: line_starts_of(text),
    analysis: Standalone(prog, standalone_entry(prog), modules)
  }
}

fn open_new_doc(st0: LspState, uri: String, text: String, version: Int) -> LspState !io =
  match uri_to_path(uri) {
    None -> {
      let no_path: Option[String] = None
      let no_modules: Option[Map[String, String]] = None
      let d = standalone_doc(st0, uri, no_path, no_path, text, version, no_modules)
      let st = LspState { ..st0, docs: map.insert(st0.docs, uri, d) }
      publish_uris(st, set.from([uri]))
      st
    }
    Some(path) -> {
      let canonical_path = canon(path)
      let plan = project_plan(source.SourceFile(path))
      match project_module_path(plan, path) {
        None -> {
          let modules: Option[Map[String, String]] = Some(plan.modules.by_use)
          let d = standalone_doc(
            st0, uri, Some(path), Some(canonical_path), text, version, modules)
          let st = LspState { ..st0, docs: map.insert(st0.docs, uri, d) }
          publish_uris(st, set.from([uri]))
          st
        }
        Some(_) -> {
          let identity = workspace_identity(plan)
          let d = Doc {
            uri: uri,
            version: version,
            path: Some(path),
            canonical_path: Some(canonical_path),
            text: text,
            view: view_of(text),
            ls: line_starts_of(text),
            analysis: WorkspaceMember(identity)
          }
          var st = LspState { ..st0, docs: map.insert(st0.docs, uri, d) }
          let old = map.get(st0.workspaces, identity.lookup_key)
          var affected: Set[String] = set.empty()
          let captured = match old {
            Some(slot) -> {
              affected = slot_uris(slot)
              match slot {
                Ready(ws) -> ws.plan
                Unavailable(ws) -> ws.plan
              }
            }
            None -> plan
          }
          var paths = match old {
            Some(slot) -> slot_paths(slot)
            None -> {
              let empty: Map[String, String] = map.empty()
              empty
            }
          }
          paths = map.insert(paths, uri, canonical_path)
          let slot = match old {
            Some(Ready(ws)) -> Ready(rebuild_workspace(st, Workspace { ..ws, path_by_uri: paths }))
            Some(Unavailable(_)) -> activate_workspace(st, captured, paths)
            None -> activate_workspace(st, captured, paths)
          }
          install_workspace(st, identity, slot, affected)
        }
      }
    }
  }

fn update_existing_doc(st0: LspState, old: Doc, text: String, version: Int) -> LspState !io =
  match old.analysis {
    Standalone(_, _, modules) -> {
      let source_path = match old.path {
        Some(found) -> found
        None -> "<lsp>"
      }
      let prog = match st0.standalone {
        Some(lease) -> analyze_standalone(source_path, text, st0.std, ct_default(), lease.jsig)
        None -> panic("standalone LSP lease used after shutdown")
      }
      # re-read rather than carry the old one: the identity is settled by the
      # analysis, and an edit re-runs the analysis
      let d = Doc {
        ..old,
        version: version,
        text: text,
        view: view_of(text),
        ls: line_starts_of(text),
        analysis: Standalone(prog, standalone_entry(prog), modules)
      }
      let st = LspState { ..st0, docs: map.insert(st0.docs, old.uri, d) }
      publish_uris(st, set.from([old.uri]))
      st
    }
    WorkspaceMember(identity) -> {
      let d = Doc {
        ..old,
        version: version,
        text: text,
        view: view_of(text),
        ls: line_starts_of(text)
      }
      var st = LspState { ..st0, docs: map.insert(st0.docs, old.uri, d) }
      let before = map.get(st.workspaces, identity.lookup_key).expect("workspace member identity")
      let affected = slot_uris(before)
      let slot = match before {
        Ready(ws) -> Ready(rebuild_workspace(st, ws))
        Unavailable(ws) -> Unavailable(unavailable_workspace(
          st, ws.plan, ws.path_by_uri, ws.problem))
      }
      install_workspace(st, identity, slot, affected)
    }
  }

fn update_doc(st: LspState, uri: String, text: String, version: Int) -> LspState !io =
  match map.get(st.docs, uri) {
    Some(old) -> update_existing_doc(st, old, text, version)
    None -> open_new_doc(st, uri, text, version)
  }

## An unavailable root retries only at an explicit low-frequency boundary.
## didChange never reaches this function; new members use `activate_workspace`
## directly, and a fully closed root is newly planned when reopened.
fn retry_unavailable(st: LspState, uri: String) -> LspState !io =
  match map.get(st.docs, uri) {
    Some(d) ->
      match d.analysis {
        WorkspaceMember(identity) ->
          match map.get(st.workspaces, identity.lookup_key) {
            Some(Unavailable(ws)) -> {
              let affected = slot_uris(Unavailable(ws))
              let slot = activate_workspace(st, ws.plan, ws.path_by_uri)
              install_workspace(st, identity, slot, affected)
            }
            _ -> st
          }
        Standalone(_, _, _) -> st
      }
    None -> st
  }

fn close_doc(st0: LspState, uri: String) -> LspState !io =
  match map.get(st0.docs, uri) {
    None -> {
      publish_uris(st0, set.from([uri]))
      st0
    }
    Some(d) ->
      match d.analysis {
        Standalone(_, _, _) -> {
          let st = LspState { ..st0, docs: map.remove(st0.docs, uri) }
          publish_uris(st, set.from([uri]))
          st
        }
        WorkspaceMember(identity) -> {
          let before = map.get(st0.workspaces, identity.lookup_key)
            .expect("workspace member identity")
          var affected = slot_uris(before)
          affected = set.insert(affected, uri)
          let paths = map.remove(slot_paths(before), uri)
          var st = LspState { ..st0, docs: map.remove(st0.docs, uri) }
          if len(map.keys(paths)) == 0 {
            st = LspState {
              ..st,
              workspaces: map.remove(st.workspaces, identity.lookup_key)
            }
            publish_uris(st, affected)
            match before {
              Ready(ws) -> close_lease(ws.lease)
              Unavailable(_) -> ()
            }
            st
          } else {
            let slot = match before {
              Ready(ws) -> Ready(rebuild_workspace(st, Workspace { ..ws, path_by_uri: paths }))
              Unavailable(ws) -> Unavailable(unavailable_workspace(
                st, ws.plan, paths, ws.problem))
            }
            install_workspace(st, identity, slot, affected)
          }
        }
      }
  }

fn doc_of(st: LspState, params: Json) -> Option[Doc] = {
  let td = get_or_null(params, "textDocument")
  map.get(st.docs, ostr(td, "uri"))
}

fn pos_offset(d: Doc, params: Json) -> Int = {
  let p = get_or_null(params, "position")
  lsp_offset(d.view, d.ls, oint(p, "line"), oint(p, "character"))
}

# ---- language features ----

fn handle_completion(st: LspState, params: Json) -> Json !io = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, analysis) {
            Some(qc) -> {
              var items: List[Json] = []
              for it in completions_at(qc, analysis.modules, d.text, pos_offset(d, params)) {
                var fields: List[(String, Json)] = [("label", JStr(it.label))]
                fields = fields ++ [("kind", JInt(it.kind))]
                match it.detail {
                  Some(dt) -> { fields = fields ++ [("detail", JStr(dt))] }
                  None -> ()
                }
                match it.sort_text {
                  Some(s2) -> { fields = fields ++ [("sortText", JStr(s2))] }
                  None -> ()
                }
                items = items ++ [jobj(fields)]
              }
              JArr(items)
            }
            None -> JArr([])
          }
        None -> JArr([])
      }
    None -> JArr([])
  }
}

fn handle_hover(st: LspState, params: Json) -> Json !io = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, analysis) {
            Some(qc) ->
              match find_target(qc, pos_offset(d, params)) {
                Some(t) -> jobj([
                  ("contents", jobj([
                    ("kind", JStr("markdown")),
                    ("value", JStr("```dawn\n" ++ t.hover ++ "\n```"))
                  ])),
                  ("range", jrange(d.view, d.ls, t.lo, t.hi))
                ])
                None -> JNull
              }
            None -> JNull
          }
        None -> JNull
      }
    None -> JNull
  }
}

fn handle_definition(st: LspState, params: Json) -> Json !io = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, analysis) {
            Some(qc) ->
              match find_target(qc, pos_offset(d, params)) {
                Some(t) ->
                  match t.def {
                    Some(sp) -> {
                      let (dlo, dhi) = sp
                      match location_of(
                        st,
                        d,
                        analysis.workspace_key,
                        analysis.definition_root,
                        t.def_path,
                        dlo,
                        dhi
                      ) {
                        Some(loc) -> JArr([loc])
                        None -> JArr([])
                      }
                    }
                    None -> JArr([])
                  }
                None -> JArr([])
              }
            None -> JArr([])
          }
        None -> JArr([])
      }
    None -> JArr([])
  }
}

## Resolve a definition site to a Location: a None def_path (or one naming the
## requesting document) maps through the live buffer; another file maps
## through a live buffer only when it belongs to the requesting source root,
## else the text on disk. The lookup key is never interpreted as a path, and a
## standalone analysis never borrows another document's world.
fn path_in_root(path: String, root: String) -> Bool =
  if path == root {
    true
  } else if root == "/" {
    str.starts_with(path, "/")
  } else {
    str.starts_with(path, root ++ "/")
  }

fn location_of(
  st: LspState,
  d: Doc,
  workspace_key: Option[String],
  definition_root: Option[String],
  def_path: Option[String],
  lo: Int,
  hi: Int
) -> Option[Json] !io = {
  let same = match def_path {
    None -> true
    Some(dp) ->
      match d.canonical_path {
        Some(p) -> canon(dp) == p
        None -> false
      }
  }
  if same {
    return Some(jobj([("uri", JStr(d.uri)), ("range", jrange(d.view, d.ls, lo, hi))]))
  }
  let dp = match def_path {
    Some(p) -> p
    None -> return None
  }
  let dc = canon(dp)
  let slot = match workspace_key {
    Some(key) -> map.get(st.workspaces, key)
    None -> None
  }
  match slot {
    Some(Ready(ws)) ->
      match definition_root {
        Some(root) ->
          if path_in_root(dc, root) {
            for uri in sort(map.keys(ws.path_by_uri)) {
              if map.get(ws.path_by_uri, uri).expect("workspace path") == dc {
                let d2 = map.get(st.docs, uri).expect("workspace document")
                return Some(jobj([
                  ("uri", JStr(uri)),
                  ("range", jrange(d2.view, d2.ls, lo, hi))
                ]))
              }
            }
          }
        None -> ()
      }
    _ -> ()
  }
  match io.read_file(dc) {
    Ok(text) -> {
      Some(jobj([
        ("uri", JStr(path_to_uri(dc))),
        ("range", jrange(view_of(text), line_starts_of(text), lo, hi))
      ]))
    }
    Err(_) -> None
  }
}

fn handle_symbols(st: LspState, params: Json) -> Json !io = {
  match doc_of(st, params) {
    Some(d) ->
      match analysis_of(st, d) {
        Some(analysis) ->
          match doc_qcx(st, analysis) {
            Some(qc) -> {
              var out: List[Json] = []
              for dc in qc.entry.m.decls {
                match decl_symbol(qc, d, dc) {
                  Some(j) -> { out = out ++ [j] }
                  None -> ()
                }
              }
              JArr(out)
            }
            None -> JArr([])
          }
        None -> JArr([])
      }
    None -> JArr([])
  }
}

## One top-level declaration as a DocumentSymbol (Function=12, Class=5).
fn decl_symbol(qc: QCx, d: Doc, dc: Decl) -> Option[Json] !io = {
  let info: Option[(String, Bool, Int, Int, Int, Int)] = match dc {
    DFn(f) -> Some((f.name, true, f.lo, f.hi, f.nlo, f.nhi))
    DType(t) -> Some((t.name, false, t.lo, t.hi, t.nlo, t.nhi))
    DConst(name, _, _, _, lo, hi, nlo, nhi) -> Some((name, false, lo, hi, nlo, nhi))
    DTrait(name, _, _, _, _, _, _, _, lo, hi, nlo, nhi) -> Some((name, false, lo, hi, nlo, nhi))
    DEffect(e) -> Some((e.name, false, e.lo, e.hi, e.nlo, e.nhi))
    DImpl(_, trait_name, tlo, thi, _, _, _, _, lo, hi) -> Some((trait_name, false, lo, hi, tlo, thi))
    DUseJava(fqcn, lo, hi, nlo, nhi) -> {
      let simple = match str.last_index_of(fqcn, ".") {
        Some(i) -> str.drop(fqcn, i + 1)
        None -> fqcn
      }
      Some((simple, false, lo, hi, nlo, nhi))
    }
    DUseModule(segs, _, aname, lo, hi, nlo, nhi) -> {
      let nm = match aname {
        Some(a) -> a.name
        None -> segs[len(segs) - 1]
      }
      Some((nm, false, lo, hi, nlo, nhi))
    }
    DTest(name, _, lo, hi, nlo, nhi) -> Some((name, false, lo, hi, nlo, nhi))
  }
  match info {
    Some(k) -> {
      let (name, is_fn, lo, hi, nlo, nhi) = k
      var fields: List[(String, Json)] = [("name", JStr(name))]
      if is_fn {
        match map.get(qc.entry.cx.fns, name) {
          Some(sig) -> {
            fields = fields ++
              [("detail", JStr(sig_render(qc.entry.cx.adts, qc.entry.cx.traits, sig)))]
          }
          None -> ()
        }
      }
      fields = fields ++ [
        ("kind", JInt(if is_fn { 12 } else { 5 })),
        ("range", jrange(d.view, d.ls, lo, hi)),
        ("selectionRange", jrange(d.view, d.ls, nlo, nhi))
      ]
      Some(jobj(fields))
    }
    None -> None
  }
}

fn handle_formatting(st: LspState, params: Json) -> Json !io = {
  match doc_of(st, params) {
    Some(d) -> {
      # No edits when the document does not lex. The formatter reprints tokens,
      # and an unrecognized character produces none, so an edit built from a
      # failed lex deletes what the lexer skipped -- which format-on-save would
      # then apply to a file the user is in the middle of typing.
      let formatted = match fmt.format(d.text) {
        Ok(s) -> s
        Err(_) -> return JArr([])
      }
      if formatted == d.text { return JArr([]) }
      # replace the whole document
      let lines = str.split(d.text, "\n")
      let last = lines[len(lines) - 1]
      JArr([jobj([
        ("range", jobj([
          ("start", jpos(0, 0)),
          ("end", jpos(len(lines) - 1, utf16_len(last)))
        ])),
        ("newText", JStr(formatted))
      ])])
    }
    None -> JArr([])
  }
}

test "a bundled std buffer keeps its std identity through the document seam" {
  # `standalone_doc` is where `textDocument/didOpen` records what a buffer is.
  # It used to write the literal "main", which `analyze_standalone` proposes
  # and is not always what comes back: a source file of the bundled std is
  # checked under its real std module path, and every query keyed by mod_path
  # -- hover, go to definition -- resolves through `analysis.entry`. Writing
  # the literal here leaves the diagnostics right and every query on a std
  # buffer answering nothing, which is the shape of failure no diagnostic
  # count can see.
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ std_load_error_text(e))
  }
  let no_docs: Map[String, Doc] = map.empty()
  let no_ws: Map[String, WorkspaceSlot] = map.empty()
  let st = LspState {
    std: std,
    bins: builtins(),
    docs: no_docs,
    workspaces: no_ws,
    standalone: Some(jsig_refused_lease()),
    host: LspLeaseHost {
      standalone: () => jsig_refused_lease(),
      project: (_plan: source.SourcePlan) => Ok(jsig_refused_lease())
    },
    lifecycle: Running
  }
  let path = "std/cursor.dawn"
  let text = match io.read_file(path) {
    Ok(t) -> t
    Err(e) -> panic("std/cursor.dawn: " ++ e.message)
  }
  let no_modules: Option[Map[String, String]] = None
  let d = standalone_doc(st, "file://" ++ canon(path), Some(path), Some(canon(path)),
    text, 0, no_modules)
  match d.analysis {
    Standalone(prog, entry, _) -> {
      assert len(prog.diags) == 0
      assert entry == "std/cursor"
      # the identity is not decoration: this is the lookup every query makes
      match doc_qcx(st, Analysis {
        prog: prog,
        entry: entry,
        modules: no_modules,
        workspace_key: None,
        definition_root: None
      }) {
        Some(qc) -> { assert qc.entry.cx.is_std_module }
        None -> panic("the std buffer's entry module was not found by mod_path")
      }
    }
    WorkspaceMember(_) -> panic("a std source is not a workspace member")
  }

  # a buffer that is not one of the bundle's files stays `main`
  let elsewhere = "/tmp/dawn-selfhost-lsp-std/cursor.dawn"
  let _ = io.mkdirs("/tmp/dawn-selfhost-lsp-std")
  match io.write_file(elsewhere, text) {
    Ok(_) -> ()
    Err(e) -> panic("test setup: " ++ e.message)
  }
  let d2 = standalone_doc(st, "file://" ++ elsewhere, Some(elsewhere),
    Some(canon(elsewhere)), text, 0, no_modules)
  match d2.analysis {
    Standalone(prog2, entry2, _) -> {
      assert entry2 == "main"
      assert len(prog2.diags) > 0
    }
    WorkspaceMember(_) -> panic("a standalone buffer is not a workspace member")
  }
}

test "the language server's std is the toolchain's, not the client's cwd" {
  # `run_lsp` used to be called with the bare literal "std", resolved against
  # whatever directory the editor happened to spawn the server in. Same binary,
  # same file, cwd one level above the checkout: 0 diagnostics became 7, all of
  # them "undefined function" on a std source that `dawn check` calls clean.
  # The rule this pins is the order, and the middle entry is the fix.
  let none: Option[String] = None

  # an explicit --std is the client speaking and wins over everything
  assert lsp_std_dir(Some("/asked/for/std"), Some("/toolchain/std")) == "/asked/for/std"
  assert lsp_std_dir(Some("/asked/for/std"), none) == "/asked/for/std"

  # otherwise the std belonging to this toolchain, handed down by the launcher
  assert lsp_std_dir(none, Some("/toolchain/std")) == "/toolchain/std"

  # and only with nothing to go on does the cwd-relative literal answer. This
  # is the last resort, not the default: running the jar straight out of a
  # checkout still works, and an installed release has no directory either way,
  # so `load_std` falls through to the embedded copy.
  assert lsp_std_dir(none, none) == "std"

  # the flag itself, which `lsp` did not parse at all before
  assert lsp_std_flag(["--std", "/x"]) == Some("/x")
  assert lsp_std_flag(["--std", "/x", "--std", "/y"]) == Some("/x")
  assert lsp_std_flag([]) == none
  # a trailing `--std` names no directory, so there is nothing to honour
  assert lsp_std_flag(["--std"]) == none
  assert lsp_std_flag(["--stdlib", "/x"]) == none
}

# ---- go to definition: which file the reply names ----

fn def_probe_state(std: StdCtx) -> LspState = {
  let no_docs: Map[String, Doc] = map.empty()
  let no_ws: Map[String, WorkspaceSlot] = map.empty()
  LspState {
    std: std,
    bins: builtins(),
    docs: no_docs,
    workspaces: no_ws,
    standalone: Some(jsig_refused_lease()),
    host: LspLeaseHost {
      standalone: () => jsig_refused_lease(),
      project: (_plan: source.SourcePlan) => Ok(jsig_refused_lease())
    },
    lifecycle: Running
  }
}

## A buffer that names a std function, deliberately written outside the
## checkout: the file a definition reply names has to come from the std the
## compiler loaded, never from where the buffer happens to sit.
fn def_probe_text() -> String =
  join([
    "use std/list",
    "",
    "fn helper(n: Int) -> Int = n + 1",
    "",
    "pub fn main() -> Unit !io = {",
    "  let xs = list.reverse([1, 2, 3])",
    "  if helper(xs[0]) > 0 { println(\"ok\") }",
    "}",
    ""
  ], "\n")

fn def_probe_put(path: String, text: String) -> Unit !io =
  match io.write_file(path, text) {
    Ok(_) -> ()
    Err(e) -> panic("test setup: " ++ e.message)
  }

fn def_probe_doc_named(st: LspState, name: String, text: String) -> Doc !io = {
  let dir = "/tmp/dawn-selfhost-lsp-def"
  let path = dir ++ "/" ++ name
  let _ = io.mkdirs(dir)
  def_probe_put(path, text)
  let no_modules: Option[Map[String, String]] = None
  standalone_doc(st, path_to_uri(canon(path)), Some(path), Some(canon(path)), text,
    0, no_modules)
}

fn def_probe_doc(st: LspState, text: String) -> Doc !io =
  def_probe_doc_named(st, "main.dawn", text)

fn def_probe_at(st: LspState, d: Doc, text: String, needle: String, skip: Int) -> Target = {
  let off = match str.index_of(text, needle) {
    Some(i) -> i + skip
    None -> panic("probe text has no " ++ needle)
  }
  match analysis_of(st, d) {
    Some(analysis) ->
      match doc_qcx(st, analysis) {
        Some(qc) ->
          match find_target(qc, off) {
            Some(t) -> t
            None -> panic("nothing under the cursor at " ++ needle)
          }
        None -> panic("the probe buffer has no QCx")
      }
    None -> panic("the probe buffer has no analysis")
  }
}

fn def_probe_span(t: Target, what: String) -> (Int, Int) =
  match t.def {
    Some(sp) -> sp
    None -> panic("no definition offered for " ++ what)
  }

test "a definition in std names std's file and points at the declaration" {
  # The bug this pins: `def_path` None means "the document being analyzed", and
  # std used to answer with it. `location_of` then mapped std's offsets through
  # the requesting buffer's line table and replied with that buffer's uri, so
  # "go to definition" on `reverse` jumped to an unrelated place in the file the
  # request came from. A confidently wrong location, not a missing one.
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ std_load_error_text(e))
  }
  let st = def_probe_state(std)
  let text = def_probe_text()
  let d = def_probe_doc(st, text)

  let t = def_probe_at(st, d, text, "list.reverse", 5)
  let dp = match t.def_path {
    Some(p) -> p
    None -> panic("a definition in std must name std's file")
  }
  assert dp == canon("std/list.dawn")

  # The span is std's, so it only means anything read against std's own text.
  # Slicing the file is what tells a right answer from a plausible one: the
  # pre-fix reply had a range too, and it addressed the wrong document.
  let (lo, hi) = def_probe_span(t, "list.reverse")
  let src = match io.read_file(dp) {
    Ok(s) -> s
    Err(e) -> panic("std/list.dawn: " ++ e.message)
  }
  assert str.slice(src, lo, hi) == "reverse"

  # and the Location the client is handed names that file, not this buffer
  let nokey: Option[String] = None
  match location_of(st, d, nokey, nokey, t.def_path, lo, hi) {
    Some(loc) -> {
      assert ostr(loc, "uri") == path_to_uri(canon("std/list.dawn"))
      assert ostr(loc, "uri") != d.uri
    }
    None -> panic("a std file that exists must resolve to a Location")
  }

  # `use std/list` reaches location_of through DUseModule, which reads
  # ModExports.src_path -- and std modules are checked with no src_path on
  # purpose, so the bundle's own record is the only thing that can answer.
  let u = def_probe_at(st, d, text, "std/list", 0)
  assert u.def_path == Some(canon("std/list.dawn"))
}

test "an embedded std offers no definition instead of one in the wrong file" {
  # A released toolchain in a project with no std directory: the embedded copy
  # answers, and there is no file on disk to jump into. The honest reply is no
  # definition at all. Emitting a None path here would be the original bug --
  # None is the entry document, and std is not it.
  let emb = match load_std("/tmp/dawn-selfhost-lsp-def/no-std-here") {
    Ok(sc) -> sc
    Err(e) -> panic("embedded std: " ++ std_load_error_text(e))
  }
  let absent: Option[String] = None
  assert emb.dir == absent
  let st = def_probe_state(emb)
  let text = def_probe_text()
  let d = def_probe_doc(st, text)

  let t = def_probe_at(st, d, text, "list.reverse", 5)
  match t.def {
    Some(_) -> panic("an embedded std module has no file to point into")
    None -> ()
  }
  # `handle_definition` replies [] on a None def, so location_of is never
  # reached and cannot invent a range.

  # What must survive: hover travels independently of def/def_path, and losing
  # the jump must not cost the text.
  assert str.contains(t.hover, "reverse")
  assert str.contains(t.hover, "List[T]")

  # local definitions are unaffected by which half of std answered
  let l = def_probe_at(st, d, text, "helper(xs", 0)
  assert l.def_path == absent
  let (llo, lhi) = def_probe_span(l, "helper")
  assert str.slice(text, llo, lhi) == "helper"
}

test "a definition of a std constant names std's file too" {
  # `def_of_const_in` reaches std through its own loop rather than through
  # `module_ast_by_class`, and today's bundle declares no `pub const` at all,
  # so the real std cannot exercise it: a mutant reverting that branch on its
  # own survived the whole suite. The probe std is what makes the branch
  # reachable, and it is a one-module std for the same reason the id-counter
  # probe in driver/stdlib is -- the real bundle's contents are not the thing
  # under test.
  let root = "/tmp/dawn-selfhost-lsp-def/conststd"
  let _ = io.mkdirs(root)
  def_probe_put(root ++ "/modules.txt", "constprobe\n")
  def_probe_put(root ++ "/constprobe.dawn", "pub const PROBE_LIMIT: Int = 7\n")
  let cstd = match load_std(root) {
    Ok(sc) -> sc
    Err(e) -> panic("probe std: " ++ std_load_error_text(e))
  }
  let st = def_probe_state(cstd)
  let text = join([
    "use std/constprobe.{PROBE_LIMIT}",
    "",
    "fn limit() -> Int = PROBE_LIMIT + 1",
    ""
  ], "\n")
  let d = def_probe_doc_named(st, "constuser.dawn", text)

  let t = def_probe_at(st, d, text, "PROBE_LIMIT + 1", 0)
  let dp = match t.def_path {
    Some(p) -> p
    None -> panic("a std constant must name std's file")
  }
  assert dp == canon(root ++ "/constprobe.dawn")
  let (lo, hi) = def_probe_span(t, "PROBE_LIMIT")
  let src = match io.read_file(dp) {
    Ok(s) -> s
    Err(e) -> panic("probe std module: " ++ e.message)
  }
  assert str.slice(src, lo, hi) == "PROBE_LIMIT"
}

test "a local definition still resolves against the requesting document" {
  # The contract the std fix leans on, from the other side. `def_path` None has
  # to keep meaning "this buffer" -- that is what makes a definition in the file
  # being edited resolve against the live text rather than whatever is on disk.
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ std_load_error_text(e))
  }
  let st = def_probe_state(std)
  let text = def_probe_text()
  let d = def_probe_doc(st, text)

  let t = def_probe_at(st, d, text, "helper(xs", 0)
  let absent: Option[String] = None
  assert t.def_path == absent
  let (lo, hi) = def_probe_span(t, "helper")
  assert str.slice(text, lo, hi) == "helper"

  let nokey: Option[String] = None
  match location_of(st, d, nokey, nokey, t.def_path, lo, hi) {
    Some(loc) -> {
      assert ostr(loc, "uri") == d.uri
      let r = match oget(loc, "range") {
        Some(j) -> j
        None -> panic("a Location has a range")
      }
      let start = match oget(r, "start") {
        Some(j) -> j
        None -> panic("a range has a start")
      }
      # line 2 of the probe text, where `fn helper` is written
      assert oint(start, "line") == 2
    }
    None -> panic("a definition in the requesting document must resolve")
  }
}

# ---- handler state cells: what the reader points at, and what answers ----

## A `with handle` with one state cell, written at every spelling a cell has:
## the declaration, a write from inside an arm, a read inside that write's
## right-hand side, and a read from the block below the handler.
fn cell_probe_text() -> String =
  join([
    "effect Emit {",
    "  fn emit(w: Int) -> Unit",
    "}",
    "",
    "fn collect(body: fn() -> Unit !Emit) -> List[Int] = {",
    "  with handle Emit {",
    "    var acc: List[Int] = []",
    "    emit(w) => { acc = acc ++ [w * 2] }",
    "  }",
    "  body()",
    "  acc",
    "}",
    ""
  ], "\n")

test "a handler state cell answers at every spelling of it" {
  # A cell is not an ordinary binding by the time it is typed: the checker
  # rewrites every read into `cell_get`/`cell_take` and every write into
  # `cell_set`, and the binding itself holds an erased slot
  # (docs/handler-state-design.md). Left to the shapes an `XLocal` and a
  # `TSAssign` make, the query answers nothing here -- and the type it would
  # answer with is the erased cell, which names nothing the author wrote.
  let std = match load_std("std") {
    Ok(sc) -> sc
    Err(e) -> panic("std: " ++ std_load_error_text(e))
  }
  let st = def_probe_state(std)
  let text = cell_probe_text()
  let d = def_probe_doc_named(st, "cells.dawn", text)
  let absent: Option[String] = None

  # the declaration: the slot's type, not the erased cell, and its own name as
  # the place to jump to
  let decl = def_probe_at(st, d, text, "acc: List[Int]", 0)
  assert decl.hover == "var acc: List[Int]"
  let (dlo, dhi) = def_probe_span(decl, "the cell declaration")
  assert str.slice(text, dlo, dhi) == "acc"
  assert decl.def_path == absent

  # the write, whose left-hand side is a name the author wrote and the checker
  # did not keep: same text, and the jump lands on the declaration
  let w = def_probe_at(st, d, text, "acc = acc", 0)
  assert w.hover == "var acc: List[Int]"
  let (wlo, whi) = def_probe_span(w, "the cell write")
  assert (wlo, whi) == (dlo, dhi)

  # the read inside that write's right-hand side
  let r = def_probe_at(st, d, text, "acc ++", 0)
  assert r.hover == "var acc: List[Int]"
  assert def_probe_span(r, "the cell read") == (dlo, dhi)

  # the right-hand side itself has a type again -- `Int` and not the block's
  # `List[Int]`, which is what the whole handler answered with when nothing
  # inside it was walked
  let rhs = def_probe_at(st, d, text, "w * 2", 2)
  assert rhs.hover == "Int"

  # the arm's parameter, which is only reachable once the arm is paired with
  # the closure the checker made of it
  let p = def_probe_at(st, d, text, "emit(w) =>", 5)
  assert p.hover == "w: Int"
  let (plo, phi) = def_probe_span(p, "the arm parameter")
  assert str.slice(text, plo, phi) == "w"

  # and a read from the block below the handler, which is the remainder
  # closure rather than the arm
  let tail = def_probe_at(st, d, text, "acc\n}", 0)
  assert tail.hover == "var acc: List[Int]"
  assert def_probe_span(tail, "the cell read below the handler") == (dlo, dhi)
}

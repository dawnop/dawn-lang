# Effect parameters (docs/effect-params-design.md knives 2 and 3): the explicit
# binder `[T, U, !e]` on a `fn`, and the same binder on `alias` and `type`.
#
# A `fn`'s binder and a declaration's binder are not the same feature, and what
# is below is the half that stayed check-period. A `fn`'s `!e` has an evidence
# slot (rule 丁), so a row that needs evidence travels through it; a
# declaration's `!e` has none, and a type reference has no effect-argument
# position that could give it one per use site, so only rows that need no
# evidence -- pure and !io -- go into a field. Every field row written here is
# one of those two, which is why neither backend grows a case and both run this
# to the same bytes.
#
# The header used to claim more: that a closure settled its own row where it
# was created and carried the evidence it needed (SEM-01, effects-design.md
# §4.6), so any `!e` on a record field cost nothing at run time. The evidence
# flip removed that premise and left the claim standing over a hole -- a
# labelled closure in a field checked clean and then panicked. The refusal that
# closed it is pinned next door, in
# scripts/checker-corpus/cases/effect_params_carry.dawn.
use std/io

fn map_explicit[T, U, !e](xs: List[T], f: fn(T) -> U !e) -> List[U] !e = map(xs, f)

alias Mapper[T, U, !e] = fn(T) -> U !e

type Box[!e] = { f: fn(Int) -> Int !e }

type Carrier[T, !e] =
  | Now(v: T)
  | Later(mk: fn() -> T !e)

# the omitted effect argument at the use site: two type arguments for a table
# of three items, and a pure closure goes in
fn pure_mapper() -> Mapper[Int, String] = n => to_string(n)

fn run_box(b: Box) -> Int !io = b.f(1)

fn force[T](c: Carrier[T]) -> T !io =
  match c {
    Now(v) -> v
    Later(mk) -> mk()
  }

pub fn main() -> Unit !io = {
  println("-- an explicit binder forwards the argument's row --")
  println(to_string(map_explicit([1, 2, 3], x => x + 1)))
  println(to_string(map_explicit([1, 2], x => {
    println("mapping")
    x * 10
  })))

  println("-- a named function type --")
  println(pure_mapper()(41))

  println("-- a row on a record field: pure and io, the two that owe nothing --")
  println(to_string(run_box(Box { f: n => n * 2 })))
  println(to_string(run_box(Box { f: n => {
    println("in the field")
    n * 3
  } })))

  println("-- and on a variant field --")
  println(to_string(force(Now(7))))
  println(to_string(force(Later(() => {
    println("forcing")
    8
  }))))
}

# Scope and capture annotations must fail in the checker, after parsing.
# Each declaration isolates a kind error or an explicit bound that erases it.
use std/mem

effect Other { fn touch() -> Unit }
type Holder[@s] = { buffer: I64Buf@s }

fn user_effect[@s]() -> Unit !Other[s] = ()
fn unknown_effect[@s]() -> Unit !Missing[s] = ()
fn scope_as_effect[@s]() -> Unit !s = ()
fn capture_as_scope[^c](b: I64Buf@c) -> Unit = ()
fn effect_as_scope[!e](b: I64Buf@e) -> Unit = ()
fn unknown_scope(b: I64Buf@s) -> Unit = ()
fn unknown_capture(x: Int^{c}) -> Unit = ()
fn shadow_scope[@s](f: fn[@s]() -> Int) -> Unit = ()
fn non_buffer[@s](x: Int@s) -> Unit = ()
fn erase_buffer[@s](x: I64Buf@s^{}) -> Unit = ()
alias EraseFunction[@s] = (fn() -> Int ^{s})^{}
alias EraseValue[@s] = (Int^{s})^{}
fn missing_argument(h: Holder) -> Unit = ()
fn set_as_scope[@s, ^c](h: Holder[^{s, c}]) -> Unit = ()

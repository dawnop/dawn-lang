# expect: a record literal here needs parentheses
# expect: a record literal here needs parentheses
# expect: a record literal here needs parentheses
# expect: expected `,` or `}`, found `y`
# expect: expected `,` or `)`, found `2`
# The `if`, `while` and `for` headers, a `..base` spread included (#192). The
# header diagnostic comes before the ones the literal itself produces, since it
# explains them, and parsing goes on: the missing comma inside the last literal
# and the one in the body are both still found.
type P = { x: Int, y: Int }
fn f(p: P) -> Unit = {
  if p == P { x: 1, y: 2 } { g() }
  while p != P { ..p, x: 3 } { g() }
  for q in P { x: 1 y: 2 } {
    g(1 2)
  }
}

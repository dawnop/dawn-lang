# ---- scopes and symbols ----

pub fn push_scope(cx: Cx) -> Cx = {
  let empty: Map[String, Int] = map.empty()
  Cx { ..cx, frame: Frame { ..cx.frame, scopes: cx.frame.scopes ++ [empty] } }
}

pub fn pop_scope(cx: Cx) -> Cx = {
  let outer = list.take(cx.frame.scopes, len(cx.frame.scopes) - 1)
  Cx { ..cx, frame: Frame { ..cx.frame, scopes: outer } }
}

pub fn sym_of(cx: Cx, id: Int) -> Sym =
  match map.get(cx.syms, id) {
    Some(s) -> s
    None -> panic("unknown symbol id: ${id}")
  }

## Declare a name in the innermost scope (the Kotlin `declare`): re-binding in
## the same scope is an error; `_` never binds.
pub fn declare(cx: Cx, name: String, ty: Ty, mutable: Bool, lo: Int, hi: Int) -> (Cx, Int) = {
  var cx1 = cx
  let inner = cx1.frame.scopes[len(cx1.frame.scopes) - 1]
  if name != "_" && map.has(inner, name) {
    cx1 = cerr_h(cx1, "`" ++ name ++ "` is already bound in this scope", lo, hi,
      "let does not shadow; only nested blocks may reuse a name")
  }
  cx1 = alias_shadow(cx1, name, lo, hi)
  let (cx2, id) = fresh(cx1)
  let sym = Sym {
    name: name,
    ty: ty,
    mutable: mutable,
    dlo: lo,
    dhi: hi,
    dict_of: None,
    ev_of: None
  }
  var cx3 = Cx { ..cx2, syms: map.insert(cx2.syms, id, sym) }
  if name != "_" {
    let inner2 = map.insert(cx3.frame.scopes[len(cx3.frame.scopes) - 1], name, id)
    let scopes2 = list.take(cx3.frame.scopes, len(cx3.frame.scopes) - 1) ++ [inner2]
    cx3 = Cx { ..cx3, frame: Frame { ..cx3.frame, scopes: scopes2 } }
  }
  (cx3, id)
}

## Find a name in the scope stack, innermost first (no capture bookkeeping).
pub fn lookup(cx: Cx, name: String) -> Option[Int] = {
  var i = len(cx.frame.scopes) - 1
  while i >= 0 {
    match map.get(cx.frame.scopes[i], name) {
      Some(id) -> return Some(id)
      None -> ()
    }
    i = i - 1
  }
  None
}

## Every name currently in scope — the "did you mean" candidate pool.
pub fn local_names(cx: Cx) -> List[String] = {
  var out: List[String] = []
  for sc in cx.frame.scopes { out = out ++ map.keys(sc) }
  out
}

# ---- effect bookkeeping ----

fn eff_seen(cx: Cx, e: Eff) -> Bool = {
  for u in cx.frame.used_effects {
    if u == e { return true }
  }
  false
}

pub fn record_effect(cx: Cx, e: Eff, lo: Int, hi: Int, name: String) -> Cx = {
  if e == EPure { return cx }
  if eff_seen(cx, e) { return cx }
  Cx {
    ..cx,
    frame: Frame {
      ..cx.frame,
      used_effects: cx.frame.used_effects ++ [e],
      eff_witness: map.insert(cx.frame.eff_witness, e, (lo, hi, name))
    }
  }
}

## **Where a label's evidence comes from is no longer a question the closure
## asks.** `mark_settled` / `mark_unsettled` / `mark_unsettled_labels` /
## `with_top_lambda` and the `LambdaCx.settled` / `.unsettled` fields they wrote
## lived here, and they answered one question: had a `with handle` written
## inside this body answered the label, so that the closure being built could be
## charged with that handler's arms instead of the label itself.
##
## Nothing settles a closure's row now. A closure does not capture the evidence
## it was created under, so there is no creation-point fact to record: the label
## stays in the row, rides out with the closure, and is answered at the call
## that runs it. Subtraction moved to the one place that also supplies --
## `check_handle`'s remainder call, whose pack is the handler and whose
## `eff_minus` is the label coming off (docs/effects-soundness-design.md §4.2 is
## the argument this replaces, not one it refines).

## The name of the local that carries an effect's evidence. It is minted from
## the id, not just the name, so two modules declaring the same effect name
## cannot shadow each other's evidence; `$` keeps it unspellable, so nothing a
## user writes can bind or read it.
pub fn ev_local_name(cx: Cx, id: Int) -> String =
  "ev\$" ++ to_string(id) ++ "\$" ++ effect_of(cx, id).name

## The name of the local that carries a projection's erased evidence -- rule
## 丙's one hidden parameter per written `!C.E`. Minted from the atom's whole
## identity (subject tvar id, trait id, member name), so two members named E
## on different traits or subjects cannot shadow each other; `$` keeps it
## unspellable like every evidence local.
pub fn ev_assoc_local_name(vid: Int, tid: Int, name: String) -> String =
  "ev\$a\$" ++ to_string(vid) ++ "\$" ++ to_string(tid) ++ "\$" ++ name

## The name of the local that carries an effect *variable*'s erased evidence --
## rule 丁's one hidden parameter per `!e` written in the row. Minted from the
## variable's id, which `resolve_eff_at` hands out once per signature, so two
## signatures spelling their variable `e` do not share a name; `$` keeps it
## unspellable like every evidence local.
pub fn ev_var_local_name(vid: Int) -> String = "ev\$v\$" ++ to_string(vid)

## Resolve parsed effect atoms into a normalized Eff, interning variables per
## signature (the Kotlin resolveEff over currentEffVars).
##
## An atom that names a declared effect is a label; anything else is an effect
## variable, as it always was. The lookup is what decides -- not the spelling
## -- so a program with no effect declarations resolves exactly as before. An
## uppercase atom that resolves to nothing would silently become an effect
## variable named `Ask`, which is never what the author meant, so it reports.
pub fn resolve_eff(cx: Cx, atoms: List[String]) -> (Cx, Eff) =
  resolve_eff_at(cx, atoms, 0, 0)

# ---- evidence in scope ----

## Declare an evidence binding: an ordinary local, plus the atom key that makes
## it evidence (`types.Sym.ev_of`). The two declarers are `bind_evidence` (a
## signature's hidden slots) and `check_handle` (a `with handle`'s record), and
## between them they are the only way an evidence name ever enters a scope.
fn declare_evidence(cx: Cx, name: String, ty: Ty, key: Int, lo: Int, hi: Int) -> (Cx, Int) = {
  let (cx1, sid) = declare(cx, name, ty, false, lo, hi)
  let sym = sym_of(cx1, sid)
  (Cx { ..cx1, syms: map.insert(cx1.syms, sid, Sym { ..sym, ev_of: Some(key) }) }, sid)
}

## Was `name` found outside the innermost closure being checked?
##
## `resolve_local` asks the same question and answers it by capturing; this asks
## it about an evidence name, which does not capture, so the answer has to come
## back as a value. One extra scope walk per evidence resolution, which is per
## raise rather than per expression.
fn ev_crossed(cx: Cx, name: String) -> Bool = {
  var i = len(cx.frame.scopes) - 1
  while i >= 0 {
    if map.has(cx.frame.scopes[i], name) {
      for lc in cx.frame.lambda_stack {
        if i < lc.boundary { return true }
      }
      return false
    }
    i = i - 1
  }
  false
}

## One atom's evidence as an expression, from wherever the frame being checked
## can reach it. `None` means nothing answers it and the caller decides what to
## say about that.
##
## Three outcomes, and the middle one is the flip:
##
##   * found in this frame -- a hidden parameter of the signature being checked,
##     or a `with handle` in the same closure -- and it is an ordinary local
##     read;
##   * found **outside** this closure. Rule 乙 captured it; now the label stays
##     in this closure's row and the call that runs the closure supplies the
##     evidence, so the read is off this frame's own pack (`XEvRead`);
##   * not found at all. Inside a closure that is not an error either, and for
##     the same reason: the row carries the label out and the call site owes it.
##     `effect_row_verify`'s `as_value` is exactly this case, and it used to be
##     a refusal.
##
## Outside every closure a miss really is a miss: a named function's evidence
## can only come from its own signature, and there is no pack to read.
fn ev_expr(
  cx: Cx,
  name: String,
  key: Int,
  ty: Ty,
  lo: Int,
  hi: Int
) -> (Cx, Option[TExpr]) = {
  let crossed = ev_crossed(cx, name)
  let (cx1, found) = resolve_local(cx, name, lo, hi, false)
  match found {
    Some(sid) ->
      if crossed {
        (cx1, Some(XEvRead(key, lo, hi, ty)))
      } else {
        (cx1, Some(XLocal(sid, name, lo, hi, ty)))
      }
    None ->
      if len(cx1.frame.lambda_stack) > 0 {
        (cx1, Some(XEvRead(key, lo, hi, ty)))
      } else {
        (cx1, None)
      }
  }
}

# ---- type resolution ----

## `m.NAME` read as a qualified constant: Some((declaring module, its type))
## when `target` is a whole-module alias that exports a constant called
## `fname`. A miss is not an error here -- the caller has a Java-static-field
## path and a value path to try (LANG-06 step 3).
fn qual_const(cx: Cx, target: Expr, fname: String) -> Option[(String, Ty)] = {
  let alias_name = match target {
    # a bare lowercase name parses as a nullary constructor spelling
    ECtor(cn, cargs, sp, hp, _, _, _, _) ->
      if hp || len(cargs) > 0 || sp != None { return None } else { cn }
    EVar(n, _, _) -> n
    _ -> return None
  }
  match map.get(cx.module_exports, alias_name) {
    None -> None
    Some(exp) ->
      match map.get(exp.consts, fname) {
        None -> None
        Some(t) -> Some((exp.mod_path, t))
      }
  }
}

## Is `q` a value this module can name? Asked of the name before a `.`, where
## the alternative reading is a whole-module alias.
fn resolves_to_value(cx: Cx, q: String) -> Bool =
  lookup(cx, q) != None || lookup_fn_sig(cx, q) != None ||
  map.has(cx.ctors_by_name, q) || map.has(cx.consts, q) || map.has(cx.java_classes, q)

## `q.x` where `q` names nothing at all. Before a `.` a bare name can be a
## value or a whole-module alias (spec §10.3), and this used to be reported by
## checking `q` as if only the first reading existed -- "undefined variable",
## in the one position where a missing `use ... as q` is just as likely. The
## type and pattern positions have said "module alias" all along.
fn undefined_qualifier_err(cx: Cx, q: String, lo: Int, hi: Int) -> Cx =
  cerr_h(cx, "undefined variable or module alias: " ++ q, lo, hi,
    match moved_or_suggest(cx, q, local_names(cx) ++ fn_pool(cx)) {
      Some(h) -> h
      None -> "a qualified access needs a whole-module import in scope: `use <path> as " ++
        q ++ "`"
    })

## `m.x` where `m` IS a whole-module alias but `x` is none of the values it
## exports. Falling through to the value path reported the alias itself as an
## undefined variable, which is worse than inconsistent: `m` is defined.
fn qual_value_err(cx: Cx, exp: ModExports, fname: String, lo: Int, hi: Int) -> Cx = {
  let msg = "module `" ++ exp.mod_path ++ "` has no exported value `" ++ fname ++ "`"
  # a name it does export, as a type, is worth saying so: otherwise the author
  # reads "no exported value `Shown`", finds `pub type Shown` and stops there
  match map.get(exp.types_by_name, fname) {
    Some(aid) -> {
      var cs: List[String] = []
      for c in adt_of(exp.adt_infos, aid).ctors { cs = cs ++ [c.name] }
      return cerr_h(cx, msg, lo, hi, "`" ++ fname ++
          "` is a type there; a value of it comes from: " ++ join(cs, ", "))
    }
    None -> ()
  }
  cerr_o(cx, msg, lo, hi, suggest.hint(fname, map.keys(exp.consts) ++ map.keys(exp.ctors)))
}

## `m.C` read as a qualified constructor: the (adt id, slot) the alias exports
## under `fname`, or None (LANG-06).
fn qual_ctor(cx: Cx, target: Expr, fname: String) -> Option[(Int, Int)] = {
  let alias_name = match target {
    ECtor(cn, cargs, sp, hp, _, _, _, _) ->
      if hp || len(cargs) > 0 || sp != None { return None } else { cn }
    EVar(n, _, _) -> n
    _ -> return None
  }
  match map.get(cx.module_exports, alias_name) {
    None -> None
    Some(exp) -> map.get(exp.ctors, fname)
  }
}

## Is the receiver of `recv.name(args)` a whole-module alias that no local
## value shadows? Such a receiver is not a value at all, so a Java member
## lookup on it can only mislead; the qualified value/function/constructor
## rules of spec §10.3 own it. Same predicate as check_method_call's own
## module branch, asked one level earlier because check_apply must decide
## whether to delegate at all.
fn module_alias_receiver(cx: Cx, recv: Expr) -> Bool = {
  let alias_name = match recv {
    ECtor(cn, cargs, sp, hp, _, _, _, _) ->
      if hp || len(cargs) > 0 || sp != None { return false } else { cn }
    EVar(n, _, _) -> n
    _ -> return false
  }
  lookup(cx, alias_name) == None && map.has(cx.module_aliases, alias_name)
}

# ---- tests ----

test "scalar and container types resolve" {
  let cx = test_cx()
  let (cx1, t) = resolve_type(cx, TNamed("Int", [], [], 0, 3))
  assert t == TyInt
  let (cx2, t2) = resolve_type(cx1,
    TNamed("Map", [TNamed("Int", [], [], 4, 7), TNamed("String", [], [], 9, 15)], [], 0, 16))
  assert t2 == TyMap(TyInt, TyString)
  assert len(cx2.diags) == 0
}

test "Array names the backend primitive in std and nothing in user code" {
  let std_cx = cx_new(Some("std/list"), None)
  let (s1, t) = resolve_type(std_cx, TNamed("Array", [TNamed("Int", [], [], 6, 9)], [], 0, 10))
  assert t == TyArray(TyInt)
  assert len(s1.diags) == 0
  # outside std the name falls through to the ordinary lookups, so a user type
  # called Array still means their own -- here, nothing declares one
  let (u1, t2) = resolve_type(test_cx(), TNamed("Array", [TNamed("Int", [], [], 6, 9)], [], 0, 10))
  assert t2 == TyError
  assert str.contains(u1.diags[0].msg, "unknown type: Array")
}

test "which types may be a Map/Set key is what Hash answers" {
  let cx = seed_prelude(test_cx())
  # naming the type is not the error -- an empty `Map[Float, Int]` is a map
  # nobody can key into, and every operation that would key into it carries
  # `[K: Eq + Hash]`. That bound is where it is caught, and it is caught by
  # the same rule that gives `hash(1.5)` outside a map the same answer.
  let (cx1, t) = resolve_type(cx,
    TNamed("Map", [TNamed("Float", [], [], 4, 9), TNamed("Int", [], [], 11, 14)], [], 0, 15))
  assert t == TyMap(TyFloat, TyInt)
  assert len(cx1.diags) == 0
  assert structural_gap(cx1, HASH_ID, TyFloat, set.empty()) == Some(TyFloat)
  assert structural_gap(cx1, EQ_ID, TyFloat, set.empty()) == None
  assert structural_gap(cx1, HASH_ID, TyArray(TyInt), set.empty()) == Some(TyArray(TyInt))
  # Bytes was banned here too, for a reason that stopped being true: it
  # compares by content (Arrays.equals) and hashes by content (Arrays.hashCode)
  assert structural_gap(cx1, HASH_ID, TyBytes, set.empty()) == None
  assert structural_gap(cx1, EQ_ID, TyBytes, set.empty()) == None
}

test "unknown types get suggestions" {
  let cx = test_cx()
  let (cx1, t) = resolve_type(cx, TNamed("Strin", [], [], 0, 5))
  assert t == TyError
  assert cx1.diags[0].msg == "unknown type: Strin"
  assert cx1.diags[0].hint == "did you mean `String`?"
}

test "effects intern per signature" {
  let cx = test_cx()
  let (cx1, e1) = resolve_eff(cx, ["e"])
  let (cx2, e2) = resolve_eff(cx1, ["e"])
  assert e1 == e2
  let (cx3, e3) = resolve_eff(cx2, ["io"])
  assert e3 == EIo
  let (cx4, e4) = resolve_eff(cx3, ["e", "f"])
  assert eff_suffix(e4) == " !(e|f)"
}

test "declare and lookup with scope discipline" {
  var cx = push_scope(test_cx())
  let (cx1, id) = declare(cx, "x", TyInt, false, 0, 1)
  assert lookup(cx1, "x") == Some(id)
  assert sym_of(cx1, id).ty == TyInt
  # re-binding in the same scope errors
  let (cx2, id2) = declare(cx1, "x", TyBool, false, 2, 3)
  assert len(cx2.diags) == 1
  # a nested block may reuse the name
  var cx3 = push_scope(cx2)
  let (cx4, id3) = declare(cx3, "x", TyString, false, 4, 5)
  assert len(cx4.diags) == 1
  assert sym_of(cx4, lookup(cx4, "x").expect("bound")).ty == TyString
  let cx5 = pop_scope(cx4)
  # the erroring re-declaration still overwrote the outer binding (Kotlin does too)
  assert sym_of(cx5, lookup(cx5, "x").expect("bound")).ty == TyBool
}

# ---- assignability, unification, printability ----

## The declaring module -- and only it -- may convert between an opaque type
## and its target. This is the whole of opacity: one line of checking, no
## run-time representation of its own, and nothing for a backend to know.
fn sees_through(cx: Cx, owner: String) -> Bool =
  match cx.owner_class {
    Some(c) -> c == owner
    None -> false
  }

## Can `t` be used where `target` is expected? (Never/TyError as anything;
## a pure fn where an io fn is wanted.)
##
## The effect side is `eff_carries`, which is also what `unify_eff` answers
## with -- the two used to disagree. This gate said `te == EIo` was enough,
## `unify_eff`'s io arm additionally required the actual to carry no labels,
## and the disagreement was reachable: a labelled closure refused as a call
## argument (that goes through unify) was accepted by a `let`, a `return` or an
## assignment with the same declared type (those come here). One judgement, so
## the doors cannot answer differently again.
##
## Parameters stay strict equality. Unification recurses there because it is
## binding inference variables; here there are none to bind, and a function's
## parameters are the one position where being lenient is unsound.
pub fn assignable(cx: Cx, t: Ty, target: Ty) -> Bool = {
  if t == target || is_errorish(t) || target == TyError { return true }
  match t {
    TyFn(ps, r, e) ->
      match target {
        TyFn(tps, tr, te) -> ps == tps && assignable(cx, r, tr) && eff_carries(te, e)
        _ -> false
      }
    TyOpaque(_, _, ow, _, tgt) ->
      if sees_through(cx, ow) { assignable(cx, tgt, target) } else { false }
    _ ->
      match target {
        TyOpaque(_, _, ow, _, tgt) ->
          if sees_through(cx, ow) { assignable(cx, t, tgt) } else { false }
        _ -> false
      }
  }
}

## Unify branch types (Never and TyError are absorbed); errors mention `what`.
pub fn unify_branches(cx: Cx, a: Ty, b: Ty, lo: Int, hi: Int, what: String) -> (Cx, Ty) = {
  if a == TyNever || a == TyError { return (cx, b) }
  if b == TyNever || b == TyError { return (cx, a) }
  if a == b { return (cx, a) }
  (cerr(cx, what ++ " have mismatched types: " ++ ty_show(cx.adts, a) ++ " vs " ++
      ty_show(cx.adts, b), lo, hi), TyError)
}

## Structural unification of a declared type against an actual argument type,
## accumulating bindings (var id → type / effect). Returns the updated maps and
## whether the shapes agreed.
## Reduce projections through the impl table (assoc-types-design.md 4.2):
## `T.Item` whose subject has a concrete head reads the binding off the same
## impl a witness would use (D5) -- one door, one answer. An opaque subject
## answers for itself first and then through its target, mirroring
## resolve_witness. A projection over a still-rigid subject stays put: the
## canonical-form invariant only bans it from ground types.
pub fn reduce_assoc(cx: Cx, t: Ty) -> Ty =
  match t {
    TyAssoc(s0, tid, n) -> {
      let s = reduce_assoc(cx, s0)
      let keep = TyAssoc(s, tid, n)
      match head_of(s) {
        None -> keep
        Some(_) ->
          match assoc_impl_of(cx, tid, s) {
            None -> keep
            Some(ii) -> {
              var bound: Option[Ty] = None
              for pr in ii.assoc_bindings {
                let (bn, bt) = pr
                if bn == n { bound = Some(bt) }
              }
              match bound {
                # a missing binding already errored at the impl; stay put
                None -> keep
                Some(bt) -> {
                  let e0: Map[Int, Ty] = map.empty()
                  let ee0: Map[Int, Eff] = map.empty()
                  let (m2, em2, ok) = unify_into(cx, ii.subject, s, e0, ee0)
                  if ok { reduce_assoc(cx, subst(bt, m2, em2)) } else { keep }
                }
              }
            }
          }
      }
    }
    _ -> ty_map_children(t, x => reduce_assoc(cx, x))
  }

## The impl a projection reduces through: the subject's own, or -- for an
## opaque subject with no impl of its own -- its target's, the order
## resolve_witness uses.
fn assoc_impl_of(cx: Cx, tid: Int, s: Ty) -> Option[ImplI] =
  match impl_at(cx.impl_table, tid, s) {
    Some(ii) -> Some(ii)
    None ->
      match s {
        TyOpaque(_, _, _, _, tgt) -> assoc_impl_of(cx, tid, tgt)
        _ -> None
      }
  }

## `reduce_assoc`'s twin on the effect axis: rewrite a row's projections
## through the call-site type bindings. An atom whose subject was just bound
## to a concrete type reads the binding off the same impl a witness would use
## (D5, one door one answer); one whose subject was bound to another rigid
## variable is re-keyed onto it (the forwarding case -- the caller's own
## hidden parameter answers for it); one whose subject the bindings do not
## mention stays put. Binding rows are ground by construction, so unlike the
## type twin there is nothing to instantiate behind the substitution.
fn reduce_eff(cx: Cx, e: Eff, m: Map[Int, Ty]) -> Eff =
  eff_map_assocs(e, a => {
    let (s0, v0, t0, n0) = a
    let keep = EffAssoc(s0, v0, t0, n0)
    match map.get(m, v0) {
      None -> keep
      Some(t) ->
        match t {
          TyVar(n2, v2) -> EffAssoc(n2, v2, t0, n0)
          _ ->
            match head_of(t) {
              None -> keep
              Some(_) ->
                match assoc_impl_of(cx, t0, t) {
                  # a missing impl already errored at the witness; stay put
                  None -> keep
                  Some(ii) -> {
                    var bound: Option[Eff] = None
                    for pr in ii.eff_bindings {
                      let (bn, be) = pr
                      if bn == n0 { bound = Some(be) }
                    }
                    match bound {
                      # a missing binding already errored at the impl
                      None -> keep
                      Some(be) -> be
                    }
                  }
                }
            }
        }
    }
  })

## `reduce_eff` pushed through a type: a function type's row is licensed to
## carry a projection (D6 admits parameter and return positions), and
## `ty_map_children` deliberately lets effects ride through -- so the choke
## points that reduce a substituted type also walk it for rows. The type-axis
## reduction stays `reduce_assoc`'s.
fn reduce_ty_effs(cx: Cx, t: Ty, m: Map[Int, Ty]) -> Ty =
  match t {
    TyFn(ps, r, e) -> TyFn(
      map(ps, x => reduce_ty_effs(cx, x, m)),
      reduce_ty_effs(cx, r, m),
      reduce_eff(cx, e, m))
    _ -> ty_map_children(t, x => reduce_ty_effs(cx, x, m))
  }

pub fn unify_into(
  cx: Cx,
  declared: Ty,
  actual: Ty,
  m: Map[Int, Ty],
  em: Map[Int, Eff]
) -> (Map[Int, Ty], Map[Int, Eff], Bool) = {
  if is_errorish(actual) { return (m, em, true) }
  # An opaque type IS its target inside the declaring module -- in argument
  # position as much as in return position, and whichever side carries it.
  # `assignable` says so already; this path unifies instead of asking it, so
  # without this peel (and the one in the TyOpaque arm below) the conversion
  # held everywhere except at a call.
  match actual {
    TyOpaque(_, _, aow, _, atgt) ->
      match declared {
        # same type: match structurally, below
        TyOpaque(_, _, _, _, _) -> ()
        # a type variable BINDS rather than converts: `Some(c)` at a Cursor is
        # an `Option[Cursor]`, not an `Option[Int]`. Seeing through a type is
        # not the same as forgetting it
        TyVar(_, _) -> ()
        _ -> if sees_through(cx, aow) { return unify_into(cx, declared, atgt, m, em) }
      }
    _ -> ()
  }
  match declared {
    TyVar(_, id) ->
      match map.get(m, id) {
        None -> (map.insert(m, id, actual), em, true)
        Some(bound) ->
          if bound == actual {
            (m, em, true)
          } else {
            # The variable is already bound to an opaque type, and the actual
            # is that type's target, inside the module declaring it: `Some(n)`
            # against `Option[Char]` in std/char, where the expected type bound
            # `T` before the argument was checked. The peel at the top of this
            # function is the mirror case (an opaque *actual*); without this
            # one the conversion held everywhere except under a type
            # constructor, which is where a checked constructor puts it.
            match bound {
              TyOpaque(_, _, ow, _, tgt) ->
                if sees_through(cx, ow) {
                  unify_into(cx, tgt, actual, m, em)
                } else {
                  (m, em, false)
                }
              _ -> (m, em, false)
            }
          }
      }
    # a projection reduces first if what is known so far (m) makes its
    # subject concrete; a still-rigid one unifies only with the same
    # projection (assoc-types-design.md D7)
    TyAssoc(_, _, _) -> {
      let d2 = reduce_ty_effs(cx, reduce_assoc(cx, subst(declared, m, em)), m)
      match d2 {
        TyAssoc(_, _, _) -> (m, em, d2 == actual)
        _ -> unify_into(cx, d2, actual, m, em)
      }
    }
    TyAdt(aid, dargs) ->
      match actual {
        TyAdt(aid2, aargs) -> {
          if aid != aid2 { return (m, em, false) }
          var m1 = m
          var em1 = em
          var ok = true
          var i = 0
          for d in dargs {
            match get(aargs, i) {
              Some(a) -> {
                let (m2, em2, ok2) = unify_into(cx, d, a, m1, em1)
                m1 = m2
                em1 = em2
                if not ok2 { ok = false }
              }
              None -> { ok = false }
            }
            i = i + 1
          }
          (m1, em1, ok)
        }
        _ -> (m, em, false)
      }
    TyList(d) ->
      match actual {
        TyList(a) -> unify_into(cx, d, a, m, em)
        _ -> (m, em, false)
      }
    TyMap(dk, dv) ->
      match actual {
        TyMap(ak, av) -> {
          let (m1, em1, ok1) = unify_into(cx, dk, ak, m, em)
          let (m2, em2, ok2) = unify_into(cx, dv, av, m1, em1)
          (m2, em2, ok1 && ok2)
        }
        _ -> (m, em, false)
      }
    TySet(d) ->
      match actual {
        TySet(a) -> unify_into(cx, d, a, m, em)
        _ -> (m, em, false)
      }
    TyArray(d) ->
      match actual {
        TyArray(a) -> unify_into(cx, d, a, m, em)
        _ -> (m, em, false)
      }
    # `opaque type N[..] = T` is a type constructor, and matching one against
    # another means matching the arguments, not the targets: an argument the
    # target drops (`opaque type Phantom[T] = Unit`) is invisible there, so
    # comparing targets made every `Phantom[_]` one type. The ids must agree
    # first: two opaque types over the same target are still two types.
    TyOpaque(did, _, dow, dargs, dtgt) ->
      match actual {
        TyOpaque(aid, _, _, aargs, _) -> {
          if did != aid || len(dargs) != len(aargs) { return (m, em, false) }
          var m1 = m
          var em1 = em
          var ok = true
          var i = 0
          for d in dargs {
            let (m2, em2, ok2) = unify_into(cx, d, aargs[i], m1, em1)
            m1 = m2
            em1 = em2
            if not ok2 { ok = false }
            i = i + 1
          }
          (m1, em1, ok)
        }
        _ -> if sees_through(cx, dow) { unify_into(cx, dtgt, actual, m, em) } else { (m, em, false) }
      }
    TyTuple(delems) ->
      match actual {
        TyTuple(aelems) -> {
          if len(delems) != len(aelems) { return (m, em, false) }
          var m1 = m
          var em1 = em
          var ok = true
          var i = 0
          for d in delems {
            let (m2, em2, ok2) = unify_into(cx, d, aelems[i], m1, em1)
            m1 = m2
            em1 = em2
            if not ok2 { ok = false }
            i = i + 1
          }
          (m1, em1, ok)
        }
        _ -> (m, em, false)
      }
    TyFn(dps, dr, de) ->
      match actual {
        TyFn(aps, ar, ae) -> {
          if len(dps) != len(aps) { return (m, em, false) }
          var m1 = m
          var em1 = em
          var ok = true
          var i = 0
          for d in dps {
            let (m2, em2, ok2) = unify_into(cx, d, aps[i], m1, em1)
            m1 = m2
            em1 = em2
            if not ok2 { ok = false }
            i = i + 1
          }
          let (m3, em3, ok3) = unify_into(cx, dr, ar, m1, em1)
          let (em4, ok4) = unify_eff(cx, de, ae, m1, em3)
          (m3, em4, ok && ok3 && ok4)
        }
        _ -> (m, em, false)
      }
    _ -> (m, em, declared == actual)
  }
}

## Effect side of unification: pure ⊑ io; declared variables accumulate a lub.
##
## io is the top of the *base* axis only: a parameter declared `!io` does not
## accept a value that raises a declared effect, because nothing at that call
## site would supply the evidence (docs/effects-design.md §4.1). An effect
## variable does accept it -- that is what carries a labelled closure through
## `list.map`.
##
## Every arm that closes on a comparison answers with `eff_carries` rather than
## `eff_subsumes`, for the same reason `assignable` does: this is a *value*
## crossing into a slot, and the slot's row is what its eventual call site
## reads to build the pack. `!io` covering an effect variable is a statement a
## signature may make about itself and a value may not make about where it is
## going.
pub fn unify_eff(
  cx: Cx,
  declared: Eff,
  actual: Eff,
  m: Map[Int, Ty],
  em: Map[Int, Eff]
) -> (Map[Int, Eff], Bool) =
  match declared {
    # `eff_subsumes` is the whole answer for a declaration with nothing to
    # infer, and it is what `assignable` asks too -- see its header for what
    # the two disagreeing about io cost. Spelled out here rather than hoisted
    # above the match because the two arms below have something to add: a
    # variable binds, and a label's base may be one.
    EPure -> (em, eff_carries(EPure, actual))
    EIo -> (em, eff_carries(EIo, actual))
    EffVar(_, id) -> {
      let prev = match map.get(em, id) {
        Some(p) -> p
        None -> EPure
      }
      (map.insert(em, id, lub_eff(prev, actual)), true)
    }
    # a union in a declared parameter position is not inferred into; accept when
    # the actual is already subsumed
    EUnion(_, _, _) -> (em, eff_carries(reduce_eff(cx, subst_eff(declared, em), m), actual))
    # A declared projection is not inferred into either, but it does reduce
    # first: the bindings accumulated so far may have pinned its subject, and
    # comparing the unreduced atom would be a false mismatch (the half-loud
    # failure the coupling probe warned about).
    EffAssoc(_, _, _, _) ->
      (em, eff_carries(reduce_eff(cx, subst_eff(declared, em), m), actual))
    # A declared label *is* inferred into, through its base: the labels written
    # here name what the row already accounts for, so what the base has to
    # answer for is the actual minus exactly those -- the residual. That is the
    # whole rule for `!Ask !e`: the labels are spoken for and the variable is
    # the rest, including any label the declaration did not write down.
    #
    # Two ways to get this wrong, and this arm had both. Handing the base
    # `eff_base(actual)` drops the label axis on the floor, so the variable
    # never sees the actual's extra labels and defaults to pure -- which is
    # where the `expected !Ask` in the diagnostic came from, while the hint
    # beside it still printed the unsubstituted `!(Ask|e)`. And closing on the
    # labels *written* rather than on the substituted row asks a question that
    # ignores the binding the line above just made, so a row could be refused
    # against itself. The closing sentence is the one the two arms above use;
    # having three spellings of "does the declaration, once its variables are
    # known, cover the actual" was the bug's hiding place.
    #
    # With the residual right, that closing sentence can no longer *fail*:
    # `ls` plus whatever the base bound covers `actual` by construction, so
    # deleting it turns no gate red (measured, not assumed). It is kept for
    # the coupling it fences off rather than for a case it catches -- without
    # it this arm silently depends on the variable arm above binding a lub
    # rather than an exact row. Get the line wrong instead of deleting it and
    # the corpus does see it: both halves of the bug this arm had were wrong
    # spellings of exactly this sentence.
    ELabeled(b, ls) -> {
      var written: List[Int] = []
      for l in ls {
        let (id, _) = l
        written = written ++ [id]
      }
      let (em1, ok) = unify_eff(cx, b, eff_drop(actual, written), m, em)
      (em1, ok && eff_carries(reduce_eff(cx, subst_eff(declared, em1), m), actual))
    }
  }

## Every effect row written in a type, each paired with where it was written.
## The walk mirrors `ty_any_child`'s children exactly, plus the one thing that
## walk cannot report: a function type's row is not a child of the type, so it
## has to be picked up here by name.
##
## Missing a row makes `earg_cooccurs` say yes where it should say no, so the
## arms are spelled out rather than left to a wildcard over "container-ish"
## shapes.
fn ty_rows_at(t: Ty, place: String) -> List[(Eff, String)] =
  match t {
    TyFn(ps, r, e) -> {
      var out: List[(Eff, String)] = [(e, place)]
      for p in ps { out = out ++ ty_rows_at(p, place) }
      out ++ ty_rows_at(r, place)
    }
    TyAdt(_, targs) -> {
      var out: List[(Eff, String)] = []
      for a in targs { out = out ++ ty_rows_at(a, place) }
      out
    }
    TyList(e2) -> ty_rows_at(e2, place)
    TyMap(k, v) -> ty_rows_at(k, place) ++ ty_rows_at(v, place)
    TySet(e2) -> ty_rows_at(e2, place)
    TyArray(e2) -> ty_rows_at(e2, place)
    TyTuple(es) -> {
      var out: List[(Eff, String)] = []
      for e2 in es { out = out ++ ty_rows_at(e2, place) }
      out
    }
    TyOpaque(_, _, _, args, tgt) -> {
      var out: List[(Eff, String)] = []
      for a in args { out = out ++ ty_rows_at(a, place) }
      out ++ ty_rows_at(tgt, place)
    }
    TyAssoc(sb, _, _) -> ty_rows_at(sb, place)
    _ -> []
  }

## Every row a signature writes down, each with the position that wrote it.
## The scan `earg_cooccurs` runs over, and the whole of it: the criterion is
## about what the *declaration* says, so nothing outside these three places
## counts.
fn sig_rows(s: Sig) -> List[(Eff, String)] = {
  var out: List[(Eff, String)] = []
  var i = 0
  for pt in s.param_tys {
    let pn = match get(s.param_names, i) {
      Some(n) -> "parameter `" ++ n ++ "`"
      None -> "a parameter"
    }
    out = out ++ ty_rows_at(pt, pn)
    i = i + 1
  }
  out = out ++ ty_rows_at(s.ret, "the return type")
  out ++ [(s.eff, "the declared row")]
}

## The concrete atoms of a row: everything that is not an effect variable.
## `R` in the co-occurrence criterion below.
fn eff_concrete_atoms(e: Eff) -> Eff = {
  var parts: List[Eff] = []
  for a in eff_assocs(eff_base(e)) {
    let (sb, v, t, n) = a
    parts = parts ++ [EffAssoc(sb, v, t, n)]
  }
  if eff_subsumes(eff_base(e), EIo) { parts = parts ++ [EIo] }
  eff_with_labels(eff_union(parts), eff_labels(e))
}

## Does `e` occur in `row`?
fn eff_has_var(row: Eff, eid: Int) -> Bool = {
  for v in eff_vars(row) {
    let (id, _) = v
    if id == eid { return true }
  }
  false
}

## `S \ R`: the actual row with every concrete atom of the parameter row taken
## off. What is left is variables the closure's own row already carried plus
## the atoms `R` did not name, which is the row `e` has to stand for.
fn eff_row_minus(actual: Eff, r: Eff) -> Eff = {
  var parts: List[Eff] = []
  for v in eff_vars(actual) {
    let (id, n) = v
    parts = parts ++ [EffVar(n, id)]
  }
  let r_assocs = eff_assocs(eff_base(r))
  for a in eff_assocs(eff_base(actual)) {
    let (sb, v, t, n) = a
    var keep = true
    for d in r_assocs {
      let (_, dv, dt, dn) = d
      if dv == v && dt == t && dn == n { keep = false }
    }
    if keep { parts = parts ++ [EffAssoc(sb, v, t, n)] }
  }
  if eff_subsumes(eff_base(actual), EIo) && not eff_subsumes(eff_base(r), EIo) {
    parts = parts ++ [EIo]
  }
  var r_labels: List[Int] = []
  for l in eff_labels(r) {
    let (id, _) = l
    r_labels = r_labels ++ [id]
  }
  var ls: List[(Int, String)] = []
  for l in eff_labels(actual) {
    let (id, _) = l
    if not list.contains(r_labels, id) { ls = ls ++ [l] }
  }
  eff_with_labels(eff_union(parts), ls)
}

## The co-occurrence criterion (spec §6.6): every row of the callee's declared
## signature that mentions `e` also names every atom of `R`.
##
## Why this is the whole question: all solutions of `!(e|R) ~ !S` agree on the
## rows that contain `R`, so the choice of `e` can only be read off a row that
## mentions `e` without `R`. Where the signature has no such row, `e := S \ R`
## is the only observable answer, and picking it preserves principality.
##
## Answers with the first row that breaks the criterion, so the diagnostic can
## name the occurrence rather than restate the rule.
fn earg_cooccurs(s: Sig, eid: Int, r: Eff) -> Option[(Eff, String)] = {
  for pr in sig_rows(s) {
    let (row, place) = pr
    if eff_has_var(row, eid) && not eff_subsumes(eff_concrete_atoms(row), r) {
      return Some(pr)
    }
  }
  None
}

## Row subtraction at a function-value argument (spec §6.6, #350).
##
## A closure whose row is `S` reaching a parameter declared `!(e|R)`, where `e`
## is one effect variable this signature binds and `R` is concrete. Unification
## never binds `e` to the leftover on its own: `unify_eff`'s union arm is a
## containment test, so `!(e|io)` refused every closure that raised anything.
## Here the leftover is computed and handed to `em` before the test runs, and
## the containment test then passes on the substituted row.
##
## Returns the map to unify with, whether a binding was added, and the hint to
## print if the shape was right but a precondition said no.
##
## Deliberately narrow, and each guard is a decision:
##   * only a `TyFn` parameter, at the top of the parameter type. A row nested
##     under a constructor is not a function *value* arriving at a slot.
##   * exactly one effect variable in the row. Two variables have no principal
##     split of the leftover, and inventing one is a language question.
##   * `e` is bound by this signature. A rigid variable from an enclosing
##     declaration has no slot at this call to be answered in.
##   * `R` non-empty, and the row does not already fit. A row that fits is
##     accepted by the path that always accepted it, unchanged.
##
## `R ⊆ S` is **not** among them. It was, until 2026-08-26: a closure short of
## `R` left with the repair rather than with a binding, so `!(e|io)` took a
## pure closure and an `!io` one and refused the closure that only raised
## `!Tell`. The refused set was exactly "does something, but not `R`", which is
## the ordinary shape of a `run` / `with_timing` / `retry` / `bracket`
## combinator whose own body does the io. Padding is now accepted: `e` binds to
## `eff_row_minus(S, R)`, which for a short row is `S` with atoms taken off it
## that it never had.
##
## What makes the padding safe is that a pack is a **scope, not a transcript of
## a row**. `runtime/c/dawn_rt.c` says it in those words above
## `dawn_ev_is_node`. The pack is built by `evidence_pack` from the row this
## call site **instantiated**, never from the closure's own row, and it is read
## by a key-chained walk rather than by index, so a closure that does less than
## its slot is handed a superset and leaves the extra keys unread. `eff_carries`
## says the same from the other side: "a superset is always safe. What is
## refused is a row with an atom the slot does not have." That direction is
## unchanged, and it is the only one this rule ever had to be careful about.
##
## A second argument through the same variable **joins**, it does not replace:
## `lub_eff` is what `unify_eff`'s `EffVar` arm does for a bare `!e` parameter,
## and two spellings of one parameter row cannot answer that question
## differently. Replacing instead would make the verdict depend on the order
## the arguments were written, and would hand the earlier closure a pack with
## its own atom missing -- a program that checks clean and panics.
##
## The variable is read off the **unsubstituted** declared row for exactly that
## reason: once `em` binds `e`, the substituted row has no variable left to
## find, so a helper that looked only at the substituted row would see the
## second argument as an ordinary mismatch.
fn earg_row_subtract(
  cx: Cx,
  s: Sig,
  pt: Ty,
  at: Ty,
  m: Map[Int, Ty],
  em: Map[Int, Eff]
) -> (Map[Int, Eff], Bool, Option[String]) = {
  var dps: List[Ty] = []
  var dr = TyError
  var de = EPure
  var is_dfn = false
  match pt {
    TyFn(ps, r, e) -> {
      dps = ps
      dr = r
      de = e
      is_dfn = true
    }
    _ -> ()
  }
  var ae = EPure
  var is_afn = false
  match at {
    TyFn(_, _, e) -> {
      ae = e
      is_afn = true
    }
    _ -> ()
  }
  if not is_dfn || not is_afn { return (em, false, None) }
  # projections reduce (the subject may be pinned by `m` already); effect
  # variables do not, because one of them is what this is looking for
  let dred = reduce_eff(cx, de, m)
  if eff_carries(reduce_eff(cx, subst_eff(dred, em), m), ae) { return (em, false, None) }
  let vs = eff_vars(dred)
  if len(vs) != 1 { return (em, false, None) }
  let (eid, ename) = vs[0]
  var bound_here = false
  for ep in s.eparams {
    match ep {
      EffVar(_, id) -> if id == eid { bound_here = true }
      _ -> ()
    }
  }
  if not bound_here { return (em, false, None) }
  let r = eff_concrete_atoms(dred)
  if r == EPure { return (em, false, None) }
  let bare = ty_show(cx.adts, TyFn(dps, dr, EffVar(ename, eid)))
  let repair = "spell this parameter's row as `!" ++ ename ++ "` alone (`" ++ bare ++
    "`); the variable then takes the closure's whole row"
  match earg_cooccurs(s, eid, r) {
    Some(pr) -> {
      let (row, place) = pr
      (em, false, Some("`" ++ ename ++ "` occurs in " ++ place ++ " as `!" ++ eff_show(row) ++
          "`, without `!" ++ eff_show(r) ++ "`, so which row it binds to is observable there; " ++
          repair))
    }
    None -> {
      let prev = match map.get(em, eid) {
        Some(p) -> p
        None -> EPure
      }
      (map.insert(em, eid, lub_eff(prev, eff_row_minus(ae, r))), true, None)
    }
  }
}

## A rigid type parameter of the enclosing declaration is a known type; only a
## callee's still-unbound inference variables are not.
pub fn is_concrete(cx: Cx, t: Ty) -> Bool =
  match t {
    TyVar(_, id) -> {
      for v in map.values(cx.current_tparams) {
        match v {
          TyVar(_, id2) -> if id2 == id { return true }
          _ -> ()
        }
      }
      false
    }
    # The two variants this walk stops at rather than descending into. A
    # function type is concrete as a *value*: what an expected `fn(T) -> T`
    # licenses is passing a lambda, and a still-rigid T in it is the lambda's
    # to close over, not a hole in the expectation. A projection over a rigid
    # subject is the shape reduction is allowed to leave standing (D3), so
    # calling it unknown would put every `T.Item` parameter back in round two.
    #
    # Written out rather than left to the `_` below, because that is how
    # `TyOpaque` was missed once: it had no arm either, so it fell through to
    # the same wildcard and `Pair[T]` at a rigid T looked concrete, and the
    # expected result type then bound the callee's type parameters before its
    # arguments could. A stop has to be a decision, not an omission.
    TyFn(_, _, _) -> true
    TyAssoc(_, _, _) -> true
    _ -> not ty_any_child(t, x => not is_concrete(cx, x))
  }

## The first part of `t` that `tid` has no answer for, or None.
##
## One predicate for every door into the two traits that have a structural
## default. `==` used to ask a walk that did not descend into ADT fields, and
## a `[T: Eq]` bound used to ask nothing at all: the operator refused `f == g`
## while the bound accepted it and answered by reference -- not even
## reflexively, since a function value is a fresh object at each use site, so
## `eq2(f, f)` came out false. Same relation, two doors, two answers.
##
## The trait is a parameter because Eq and Hash bottom out at different
## scalars. A walk that asked Eq's table for both let `[T: Hash]` accept a
## `Float` and answer `Double.hashCode`, which is the pairing deleting
## `Hash[Float]` was meant to end.
##
## An impl ends the walk: the impl is the definition, and what its fields are
## made of is its own business.
pub fn structural_gap(cx: Cx, tid: Int, t: Ty, seen: Set[String]) -> Option[Ty] =
  if has_impl_at(cx.impl_table, tid, t) {
    None
  } else {
    match t {
      TyFn(_, _, _) -> Some(t)
      # the D1 growable vector: mutable, and compared by reference. Until it
      # is a Dawn type with an impl there is no content equality to give.
      TyArray(_) -> Some(t)
      # There is one Unit and it carries no information, so equality and hash
      # would be constants -- the same ground on which Show refuses it. A rule
      # about the relation, not about the representation: a Unit is an
      # ordinary reference on the JVM and an ordinary byte in C.
      TyUnit -> Some(t)
      # reached only for Hash: `Eq[Float]` is a prelude impl, so for equality
      # the table above has already answered
      TyFloat -> Some(t)
      TyTuple(elems) -> {
        for e in elems {
          match structural_gap(cx, tid, e, seen) {
            Some(b) -> return Some(b)
            None -> ()
          }
        }
        None
      }
      # In a whole program std's conditional impls answer for the containers
      # before the walk is asked, and the parts then arrive here one at a time
      # as that impl's sub-goals. These arms are for the contexts that have no
      # std -- a unit test's table, a module checked on its own -- where the
      # walk is all there is.
      TyList(e) -> structural_gap(cx, tid, e, seen)
      TySet(e) -> structural_gap(cx, tid, e, seen)
      TyMap(k, v) ->
        match structural_gap(cx, tid, k, seen) {
          Some(b) -> Some(b)
          None -> structural_gap(cx, tid, v, seen)
        }
      TyAdt(aid, targs) -> {
        let a = adt_of(cx.adts, aid)
        if set.has(seen, a.name) { return None }
        let seen2 = set.insert(seen, a.name)
        var m: Map[Int, Ty] = map.empty()
        var i = 0
        for tp in a.tparams {
          match tp {
            TyVar(_, id) ->
              match get(targs, i) {
                Some(arg) -> { m = map.insert(m, id, arg) }
                None -> ()
              }
            _ -> ()
          }
          i = i + 1
        }
        let em: Map[Int, Eff] = map.empty()
        for c in a.ctors {
          for f in c.fields {
            match structural_gap(cx, tid, subst(f.ty, m, em), seen2) {
              Some(b) -> return Some(b)
              None -> ()
            }
          }
        }
        None
      }
      # An opaque type answers whatever its target answers -- the `has_impl_at`
      # at the top already gave an `impl` on the opaque itself its chance.
      # `resolve_witness` peels before calling here, but only the outermost
      # type, so without this arm a `(Celsius, Int)` key walked past the Float
      # ban that `(Float, Int)` is caught by.
      TyOpaque(_, _, _, _, tgt) -> structural_gap(cx, tid, tgt, seen)
      # A projection is a gap, and unlike a type parameter it is one nothing
      # can close: a bound applies to a type parameter, and `C.Item` is not
      # one. Without this arm the `_` below called it "no gap", the goal was
      # accepted, and lowering then asked for its dictionary key -- where
      # `ty_key` panics on exactly this variant. That is the whole of #123:
      # `c[i] == c[j]` under `[C: Index]` passed the checker and crashed the
      # compiler, directly and inside a tuple.
      TyAssoc(_, _, _) -> Some(t)
      # A rigid type parameter is not a gap in the structure -- whether `T`
      # answers is the instantiation's business, and `resolve_witness` asks it
      # there, where the bound either is or is not in scope.
      _ -> None
    }
  }

## One wording for every door. `bad` is the part `tid` has no answer for; when
## it is the whole type the message says so directly rather than pointing at
## itself.
pub fn structural_gap_err(cx: Cx, tid: Int, t: Ty, bad: Ty, lo: Int, hi: Int) -> Cx = {
  let rel = if tid == HASH_ID { "hash" } else { "equality" }
  let (what, hint) = match bad {
    TyFn(_, _, _) ->
      if tid == HASH_ID {
        ("functions cannot be hashed", "hash the values they produce, not the functions")
      } else {
        ("functions cannot be compared", "compare the values they produce, not the functions")
      }
    TyUnit ->
      ("`Unit` has no " ++ rel,
        "there is one Unit and it carries no information, so the answer would be a constant")
    TyFloat ->
      ("`Float` has no hash",
        "NaN and -0.0 give Float two different equalities, so no hash can agree with `==`; " ++
          "use an Int encoding (scaled integer, bits) or a String rendering instead")
    TyArray(_) ->
      ("`" ++ ty_show(cx.adts, bad) ++ "` has no " ++ rel ++ ": an Array is held by identity, " ++
          "not by content",
        "use the List it backs instead")
    # Same head as the fallback, different way out: a projection has no
    # contents to derive an answer from, so it gets the one hint every
    # relation gives for this shape rather than one that cannot be followed.
    TyAssoc(_, _, _) -> ("`" ++ ty_show(cx.adts, bad) ++ "` has no " ++ rel,
      assoc_witness_hint(cx, bad))
    _ -> ("`" ++ ty_show(cx.adts, bad) ++ "` has no " ++ rel,
      "derive the answer from its contents instead")
  }
  let msg = if bad == t {
    what
  } else {
    what ++ ", and `" ++ ty_show(cx.adts, t) ++ "` contains one"
  }
  cerr_h(cx, msg, lo, hi, hint)
}

## One wording for "the subject of this goal is a projection", shared by every
## relation that can be asked for one.
##
## A projection is the shape no bound reaches. A bound applies to a type
## parameter, and `C.Item` is not one -- it is read off whichever impl the
## caller picks. Nor can the reader write the impl the other hints send them
## to: a projection has no head, and an impl is registered by its subject's
## head (`insert_impl` panics on a headless one). So the four prelude
## relations used to say four different things here, one of them instructing
## the reader to write an impl the compiler would refuse to accept.
##
## What does work is in `scripts/spike-native/index_dict.dawn`: hand the value
## back and do the work at the call site, where the projection has already
## been reduced to a concrete type.
pub fn assoc_witness_hint(cx: Cx, t: Ty) -> String =
  "a bound applies to a type parameter, and `" ++ ty_show(cx.adts, t) ++
  "` is not one -- it is read off whichever impl the caller picks; return the value " ++
  "and do this at the call site, where its type is concrete"

pub fn assoc_witness_err(cx: Cx, trait_name: String, t: Ty, lo: Int, hi: Int) -> Cx =
  cerr_h(cx, "no `" ++ trait_name ++ "` for the projection `" ++ ty_show(cx.adts, t) ++ "`",
    lo, hi, assoc_witness_hint(cx, t))

# ---- tests (slice 2) ----

test "assignability admits pure where io is wanted" {
  let cx = test_cx()
  assert assignable(cx, TyFn([TyInt], TyInt, EPure), TyFn([TyInt], TyInt, EIo))
  assert not assignable(cx, TyFn([TyInt], TyInt, EIo), TyFn([TyInt], TyInt, EPure))
  assert assignable(cx, TyNever, TyInt)
  assert not assignable(cx, TyInt, TyBool)
}

test "unification binds and checks variables" {
  let cx = test_cx()
  let t = TyVar("T", 100)
  let m0: Map[Int, Ty] = map.empty()
  let em0: Map[Int, Eff] = map.empty()
  let (m1, em1, ok1) = unify_into(cx, TyList(t), TyList(TyInt), m0, em0)
  assert ok1
  assert map.get(m1, 100) == Some(TyInt)
  # a second, conflicting binding fails
  let (m2, em2, ok2) = unify_into(cx, t, TyBool, m1, em1)
  assert not ok2
  # effect variables accumulate a lub
  let e = EffVar("e", 101)
  let (m3, em3, ok3) = unify_into(cx, TyFn([t], TyUnit, e), TyFn([TyInt], TyUnit, EIo), m1, em1)
  assert ok3
  assert map.get(em3, 101) == Some(EIo)
  let phantom_t = TyOpaque(7, "Phantom", "m", [t], TyUnit)
  let phantom_int = TyOpaque(7, "Phantom", "m", [TyInt], TyUnit)
  let phantom_string = TyOpaque(7, "Phantom", "m", [TyString], TyUnit)
  let (m4, _, ok4) = unify_into(cx, phantom_t, phantom_int, m0, em0)
  assert ok4
  assert map.get(m4, 100) == Some(TyInt)
  let (_, _, ok5) = unify_into(cx, phantom_int, phantom_string, m0, em0)
  assert not ok5
}

test "const-serializability" {
  let cx = test_cx()
  assert is_const_serializable(cx, opt_ty(TyTuple([TyInt, TyString])), set.empty())
  assert not is_const_serializable(cx, TyMap(TyInt, TyInt), set.empty())
  assert not is_const_serializable(cx, TyVar("T", 5), set.empty())
  # an opaque type is its target's answer ...
  let meters = TyOpaque(8, "Meters", "m", [], TyInt)
  assert is_const_serializable(cx, meters, set.empty())
  assert is_const_serializable(cx, TyList(meters), set.empty())
  # ... except where the target is a position in the backend's own
  # representation, which Core has no way to write down (SEM-04). Same shape,
  # same target, only the declaring module and the name differ.
  let cursor = TyOpaque(9, "Cursor", "std/cursor", [], TyInt)
  let impostor = TyOpaque(9, "Cursor", "m", [], TyInt)
  assert not is_const_serializable(cx, cursor, set.empty())
  assert not is_const_serializable(cx, TyList(cursor), set.empty())
  assert not is_const_serializable(cx, TyTuple([TyInt, cursor]), set.empty())
  assert is_const_serializable(cx, impostor, set.empty())
  # and it is the refusal the caller is told how to work around
  assert str.contains(const_refusal_hint(cursor), "walk to the position")
  assert str.contains(const_refusal_hint(meters), "constants hold")
  assert str.contains(const_refusal_hint(TyMap(TyInt, TyInt)), "constants hold")
}

# ---- declaration passes ----

test "a `use java` declaration is refused when no oracle is wired" {
  # cx_new's default jsig is the refusal: the shape a native compiler is in.
  # One diagnostic at the declaration, not a missing-class error — the class
  # path was never consulted, because there is none to consult.
  let (m, pdiags) = parser.parse_module("use java \"java.lang.Math\"\n")
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(cx_new(None, None), m, env)
  assert len(cx1.diags) == 1
  assert str.contains(cx1.diags[0].msg, "`use java` is not available in this compiler")
  assert str.contains(cx1.diags[0].hint, "java.lang.Math")
}

test "main cannot owe a declared effect" {
  let src = "effect Ask {\n  fn ask() -> Int\n}\n" ++
    "pub fn main() -> Unit !Ask !io = ()\n"
  let (m, _) = parser.parse_module(src)
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(test_cx(), m, env)
  var saw = false
  for d in cx1.diags {
    if d.msg == "main cannot declare the effect `Ask`" { saw = true }
  }
  assert saw
}

## Unary operators (the Kotlin inferExpr's Unary arm).
pub fn check_unary(
  cx: Cx,
  op: UnOp,
  t: Ty,
  operand: TExpr,
  olo: Int,
  ohi: Int,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) =
  match op {
    OpNot -> {
      if t != TyBool && not is_errorish(t) {
        let cx1 = cerr(cx, "`not` expects Bool, got " ++ ty_show(cx.adts, t), olo, ohi)
        (cx1, TyError, XError(lo, hi))
      } else {
        (cx, TyBool, XUnary(UNot, operand, lo, hi, TyBool))
      }
    }
    OpNeg -> {
      if not is_numeric(t) && not is_errorish(t) {
        let cx1 = cerr(cx, "negation expects a number, got " ++ ty_show(cx.adts, t), olo, ohi)
        (cx1, TyError, XError(lo, hi))
      } else {
        (cx, t, XUnary(UNeg, operand, lo, hi, t))
      }
    }
    OpBnot -> {
      if t != TyInt && not is_errorish(t) {
        let cx1 = cerr(cx, "`~` expects Int, got " ++ ty_show(cx.adts, t), olo, ohi)
        (cx1, TyError, XError(lo, hi))
      } else {
        (cx, TyInt, XUnary(UBnot, operand, lo, hi, TyInt))
      }
    }
  }

## ast.BinOp → tast.TBinOp.
pub fn tbin_of(op: BinOp) -> TBinOp =
  match op {
    OpAdd -> BAdd
    OpSub -> BSub
    OpMul -> BMul
    OpDiv -> BDiv
    OpMod -> BMod
    OpConcat -> BConcat
    OpEq -> BEq
    OpNeq -> BNeq
    OpLt -> BLt
    OpLe -> BLe
    OpGt -> BGt
    OpGe -> BGe
    OpAnd -> BAnd
    OpOr -> BOr
    OpBand -> BBand
    OpBor -> BBor
    OpBxor -> BBxor
    OpShl -> BShl
    OpShr -> BShr
    OpUshr -> BUshr
  }

test "unary checking types and poisons" {
  let cx = test_cx()
  let (cx1, t1, x1) = check_unary(cx, OpNot, TyBool, XBool(true, 0, 4), 0, 4, 0, 4)
  assert t1 == TyBool
  assert len(cx1.diags) == 0
  let (cx2, t2, x2) = check_unary(cx, OpNeg, TyString, XError(0, 1), 0, 1, 0, 1)
  assert t2 == TyError
  assert cx2.diags[0].msg == "negation expects a number, got String"
}

## A forwarded dictionary is an ordinary local as far as closures go: every
## enclosing lambda has to capture it, or the body cannot reach it.
fn capture_witness(cx: Cx, sym: Int) -> Cx = {
  var stack: List[LambdaCx] = []
  for lc in cx.frame.lambda_stack {
    var caps = lc.captures
    var have = false
    for c in caps {
      if c == sym { have = true }
    }
    if not have { caps = caps ++ [sym] }
    stack = stack ++ [LambdaCx { ..lc, captures: caps }]
  }
  Cx { ..cx, frame: Frame { ..cx.frame, lambda_stack: stack } }
}

## Satisfy one trait requirement at a use site (the Kotlin resolveWitness,
## specialized here for Ord over `<' family operators): a concrete subject
## resolves through the impl table; the caller's own rigid type parameter
## forwards the caller's dictionary (which every enclosing lambda captures).
## Returns the witness for the typed node.
## The type an ordering is really taken at: an opaque type with no `impl Ord`
## of its own is its target (spec §2.7). One definition, so the operator's fast
## path and the witness below cannot disagree about which type answers.
fn ord_subject(cx: Cx, t: Ty) -> Ty =
  match t {
    TyOpaque(_, _, _, _, tgt) ->
      if has_impl_at(cx.impl_table, ORD_ID, t) { t } else { ord_subject(cx, tgt) }
    _ -> t
  }

pub fn resolve_ord_witness(cx: Cx, t: Ty, lo: Int, hi: Int) -> (Cx, Option[WitRef]) = {
  if is_errorish(t) { return (cx, no_wit()) }
  # The same first question `resolve_witness` asks, and for the same reason:
  # `<` is the one relation with its own resolver, so the projection wording
  # had to be stated twice or Ord would keep its own.
  match t {
    TyAssoc(_, _, _) -> { return (assoc_witness_err(cx, "Ord", t, lo, hi), no_wit()) }
    _ -> ()
  }
  # An opaque type answers for itself if it has its own impl, and otherwise
  # falls back to its target -- the same clause `resolve_witness` states for
  # every other trait, and the reason `'a' < 'b'` is Int's `<`. This path is
  # the specialised one the `<` family takes, so it needed saying twice.
  match t {
    TyOpaque(_, _, _, _, tgt) ->
      match impl_at(cx.impl_table, ORD_ID, t) {
        None -> { return resolve_ord_witness(cx, tgt, lo, hi) }
        Some(_) -> ()
      }
    _ -> ()
  }
  match t {
    TyVar(_, vid) ->
      match map.get(cx.frame.dict_syms, (vid, ORD_ID)) {
        None -> {
          let cx1 = cerr_h(cx, "values of type " ++ ty_show(cx.adts, t) ++
              " cannot be ordered", lo, hi, "add the bound: [" ++ ty_show(cx.adts, t) ++ ": Ord]")
          (cx1, no_wit())
        }
        Some(sym) -> (capture_witness(cx, sym), Some(WForward(sym)))
      }
    _ ->
      match impl_at(cx.impl_table, ORD_ID, t) {
        Some(_) -> (cx, Some(WConcrete(ORD_ID, t)))
        None -> {
          let hint: Option[String] = match t {
            TyAdt(aid, _) ->
              if len(adt_of(cx.adts, aid).tparams) == 0 {
                let ts = ty_show(cx.adts, t)
                Some("implement it: impl Ord[" ++ ts ++ "] { fn cmp(a: " ++ ts ++ ", b: " ++
                    ts ++ ") -> Int = ... }")
              } else {
                None
              }
            _ -> None
          }
          (cerr_o(cx, "values of type " ++ ty_show(cx.adts, t) ++ " cannot be ordered",
            lo, hi, hint), no_wit())
        }
      }
  }
}

## Binary operators over already-checked operand types (the Kotlin checkBinary
## after both sides are typed; short-circuit evaluation order is the caller's
## job since it must thread Cx through left then right).
pub fn check_binary_typed(
  cx: Cx,
  op: BinOp,
  lt: Ty,
  rt: Ty,
  left: TExpr,
  right: TExpr,
  llo: Int,
  lhi: Int,
  rlo: Int,
  rhi: Int,
  olo: Int,
  ohi: Int,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) = {
  let node = (ord: Option[WitRef], t: Ty) => XBinary(tbin_of(op), left, right, ord, olo, ohi, lo, hi, t)
  # one side already failed: pick a plausible result type, stay silent
  if is_errorish(lt) || is_errorish(rt) {
    let t = match op {
      OpAdd | OpSub | OpMul | OpDiv | OpMod ->
        if is_numeric(lt) { lt } else if is_numeric(rt) { rt } else { TyError }
      OpBand | OpBor | OpBxor | OpShl | OpShr | OpUshr -> TyInt
      OpConcat ->
        match lt {
          TyList(_) -> lt
          _ ->
            match rt {
              TyList(_) -> rt
              _ -> TyString
            }
        }
      _ -> TyBool
    }
    return (cx, t, node(no_wit(), t))
  }
  match op {
    OpAdd | OpSub | OpMul | OpDiv | OpMod -> {
      if not is_numeric(lt) {
        return (cerr(cx, "arithmetic expects numbers, left side is " ++ ty_show(cx.adts, lt),
          llo, lhi), TyError, node(no_wit(), TyError))
      }
      if lt != rt {
        let hint: Option[String] = if is_numeric(rt) {
          Some("there are no implicit conversions; use to_float() or unify the literal types")
        } else {
          None
        }
        return (cerr_o(cx, "both sides must have the same type: " ++ ty_show(cx.adts, lt) ++
            " vs " ++ ty_show(cx.adts, rt), olo, ohi, hint), TyError, node(no_wit(), TyError))
      }
      (cx, lt, node(no_wit(), lt))
    }
    OpBand | OpBor | OpBxor | OpShl | OpShr | OpUshr -> {
      if lt != TyInt {
        return (cerr(cx, "bitwise operators expect Int, left side is " ++ ty_show(cx.adts, lt),
          llo, lhi), TyError, node(no_wit(), TyError))
      }
      if rt != TyInt {
        return (cerr(cx, "bitwise operators expect Int, right side is " ++ ty_show(cx.adts, rt),
          rlo, rhi), TyError, node(no_wit(), TyError))
      }
      (cx, TyInt, node(no_wit(), TyInt))
    }
    OpConcat -> {
      if lt == TyString && rt == TyString { return (cx, TyString, node(no_wit(), TyString)) }
      if lt == TyBytes && rt == TyBytes { return (cx, TyBytes, node(no_wit(), TyBytes)) }
      let both_lists = match lt {
        TyList(_) ->
          match rt {
            TyList(_) -> true
            _ -> false
          }
        _ -> false
      }
      if both_lists {
        if lt != rt {
          return (cerr(cx, "`++` needs lists of the same element type: " ++
              ty_show(cx.adts, lt) ++ " vs " ++ ty_show(cx.adts, rt), olo, ohi),
            TyError, node(no_wit(), TyError))
        }
        return (cx, lt, node(no_wit(), lt))
      }
      (cerr_h(cx, "`++` concatenates Strings, Bytes or Lists, got " ++ ty_show(cx.adts, lt) ++
          " ++ " ++ ty_show(cx.adts, rt), olo, ohi,
        "use + for numbers; interpolation \"\${x}\${y}\" also builds strings"), TyError,
        node(no_wit(), TyError))
    }
    OpEq | OpNeq -> {
      if lt != rt {
        return (cerr(cx, "== requires both sides to have the same type: " ++
            ty_show(cx.adts, lt) ++ " vs " ++ ty_show(cx.adts, rt), olo, ohi), TyError,
          node(no_wit(), TyError))
      }
      # One pipeline. `==` used to ask `resolve_eq_witness`, a second solver
      # that knew about impls but not about conditional ones, so `a == b` on
      # two lists reached a different answer than the same comparison through
      # a `[T: Eq]` bound. The design's claim that the two doors give the same
      # answer is now a fact about the code: they call the same function.
      let (cx1, w) = resolve_witness(cx, EQ_ID, lt, olo, ohi, "`==`")
      (cx1, TyBool, node(w, TyBool))
    }
    OpLt | OpLe | OpGt | OpGe -> {
      if lt != rt {
        return (cerr(cx, "comparison requires both sides to have the same type: " ++
            ty_show(cx.adts, lt) ++ " vs " ++ ty_show(cx.adts, rt), olo, ohi), TyError,
          node(no_wit(), TyError))
      }
      # Native fast path, and an opaque type over one of these takes it too:
      # with no `impl Ord` of its own it *is* its target at run time
      # (spec §2.7), which is what `resolve_ord_witness` peels to anyway.
      # Without the peel `'0' <= c` on a `Char` lowered to `cmp(a, b) <= 0` --
      # a call, where the same comparison one layer down is one instruction.
      let ol = ord_subject(cx, lt)
      if ol == TyInt || ol == TyFloat || ol == TyString {
        return (cx, TyBool, node(no_wit(), TyBool))
      }
      let (cx1, w) = resolve_ord_witness(cx, lt, olo, ohi)
      (cx1, TyBool, node(w, TyBool))
    }
    OpAnd | OpOr -> {
      if lt != TyBool {
        return (cerr(cx, "logical operators expect Bool, left side is " ++ ty_show(cx.adts, lt),
          llo, lhi), TyError, node(no_wit(), TyError))
      }
      if rt != TyBool {
        return (cerr(cx, "logical operators expect Bool, right side is " ++ ty_show(cx.adts, rt),
          rlo, rhi), TyError, node(no_wit(), TyError))
      }
      (cx, TyBool, node(no_wit(), TyBool))
    }
  }
}

test "binary checking covers the operator families" {
  let cx = test_cx()
  let l = XInt(1, 0, 1)
  let r = XInt(2, 4, 5)
  let (cx1, t1, _) = check_binary_typed(cx, OpAdd, TyInt, TyInt, l, r, 0, 1, 4, 5, 2, 3, 0, 5)
  assert t1 == TyInt
  let (cx2, t2, _) = check_binary_typed(cx, OpAdd, TyInt, TyFloat, l, r, 0, 1, 4, 5, 2, 3, 0, 5)
  assert t2 == TyError
  assert str.contains(cx2.diags[0].msg, "both sides must have the same type")
  let (cx3, t3, _) = check_binary_typed(cx, OpLt, TyInt, TyInt, l, r, 0, 1, 4, 5, 2, 3, 0, 5)
  assert t3 == TyBool
  assert len(cx3.diags) == 0
  # ordering a Bool needs an Ord impl and there is none
  let (cx4, t4, _) = check_binary_typed(cx, OpLt, TyBool, TyBool, l, r, 0, 1, 4, 5, 2, 3, 0, 5)
  assert cx4.diags[0].msg == "values of type Bool cannot be ordered"
  let (cx5, t5, _) = check_binary_typed(cx, OpConcat, TyString, TyString, l, r, 0, 1, 4, 5, 2, 3, 0, 5)
  assert t5 == TyString
  let (cx6, t6, _) = check_binary_typed(cx, OpEq,
    TyFn([], TyUnit, EPure), TyFn([], TyUnit, EPure), l, r, 0, 1, 4, 5, 2, 3, 0, 5)
  assert cx6.diags[0].msg == "functions cannot be compared"
}

## The rule itself, in one place: everything that decides whether a builtin
## name exists here goes through it -- resolution, the "did you mean" pool, and
## the language server's tables. When they disagreed, the server offered names
## the checker then refused.
pub fn builtin_visible(cx: Cx, hidden: Set[String], name: String) -> Bool =
  cx.is_std_module || not set.has(hidden, name)

## The builtin table as visible from this module: user-code resolution skips
## the internal intrinsics (the Kotlin `builtin(name)`).
##
## Both tables come off `cx`, built once by `cx_new`. They used to be built
## here: every name this function was asked about rebuilt the 90-entry builtin
## map, and `internal_builtins` rebuilt the intrinsic table on top of it --
## which is a third build of the same map, since the intrinsic table starts
## from `builtins()`. Three tables per unresolved name, on the path every name
## in a module walks.
pub fn builtin_sig(cx: Cx, name: String) -> Option[Sig] = {
  let sig = match map.get(cx.bins, name) {
    None -> return None
    Some(s) -> s
  }
  if builtin_visible(cx, cx.hidden_bins, name) { Some(sig) } else { None }
}

## `bins` keeping only what `cx`'s module may name. The language server builds
## its table once per query and every consumer -- hover, go to definition,
## completion -- reads it, so filtering here is what keeps them all honest.
pub fn visible_bins(bins: Map[String, Sig], cx: Cx) -> Map[String, Sig] = {
  if cx.is_std_module { return bins }
  let hidden = cx.hidden_bins
  var out: Map[String, Sig] = map.empty()
  for pr in map.entries(bins) {
    let (n, s) = pr
    if builtin_visible(cx, hidden, n) { out = map.insert(out, n, s) }
  }
  out
}

## The visible builtin names — the "did you mean" pool half.
## Resolution for a called/read function name: local decls → std → builtins
## (spec §10.6 — the shadowing is total in this module).
pub fn lookup_fn_sig(cx: Cx, name: String) -> Option[Sig] =
  match map.get(cx.fns, name) {
    Some(s) -> Some(s)
    None ->
      match map.get(cx.std_fns, name) {
        Some(s) -> Some(s)
        None -> builtin_sig(cx, name)
      }
  }

## The candidate pool for "did you mean" on a function name. Synthesized
## names (`f$default$k`) are not in it: no typo can mean one.
pub fn fn_pool(cx: Cx) -> List[String] = {
  var out: List[String] = []
  for n in map.keys(cx.fns) {
    if not str.contains(n, "\$") { out = out ++ [n] }
  }
  out ++ map.keys(cx.std_fns) ++ visible_builtin_names(cx)
}

pub fn visible_builtin_names(cx: Cx) -> List[String] = {
  var out: List[String] = []
  for n in map.keys(cx.bins) {
    if builtin_visible(cx, cx.hidden_bins, n) { out = out ++ [n] }
  }
  out
}

## One name from each std-only family, and one from each family that is
## deliberately language surface. Naming three of them was how half the table
## stayed missing until 2026-07-30: `io_*`, `bytes_*` and `str_lower/upper`
## were declared internal nowhere and asserted about nowhere, so user code
## could call `io_read_file` and take the fault raw
## (docs/audit/re-audit-2026-07-30.md RD-02). A per-family sample fails the
## day a family is added without a decision about it.
fn hidden_from_user_code() -> List[String] =
  ["map_insert", "set_has", "array_push", "popcount", "cursor_next",
    "io_read_file", "io_println", "io_run", "bytes_at", "bytes_from_array",
    "str_upper"]

## The prelude half: names spec 11 promises user code may write. A fix that
## over-reaches shows up here rather than in somebody's program.
fn visible_to_user_code() -> List[String] =
  ["len", "get", "range", "sort_by", "to_string", "join", "panic", "expect",
    "parse_int", "parse_int_radix", "char_is_alnum", "code_points",
    "from_code_points", "args", "catch_fault", "catch_panic", "bracket", "cast"]

test "internal builtins hide from user code but not std" {
  let user = test_cx()
  let std_cx = cx_new(Some("std/map"), None)
  # the table the language server reads has to hide exactly what the resolver
  # hides, or it offers names the checker then refuses
  let user_bins = visible_bins(builtins(), user)
  var user_names: Set[String] = set.empty()
  for n in visible_builtin_names(user) { user_names = set.insert(user_names, n) }

  for n in hidden_from_user_code() {
    # it is a builtin at all -- a typo here would pass every assertion below
    assert map.get(builtins(), n) != None
    assert builtin_sig(user, n) == None
    assert builtin_sig(std_cx, n) != None
    assert map.get(user_bins, n) == None
    assert not set.has(user_names, n)
  }
  for n in visible_to_user_code() {
    assert builtin_sig(user, n) != None
    assert map.get(user_bins, n) != None
    assert set.has(user_names, n)
  }
  # std sees the whole table, which is what makes std/io and std/bytes able to
  # write over the primitives they wrap
  let std_bins = visible_bins(builtins(), std_cx)
  assert map.get(std_bins, "map_insert") != None
  assert map.get(std_bins, "io_read_file") != None
  assert map.len(std_bins) == map.len(builtins())
}

## Is the innermost lambda one the parser synthesized from a `with` statement?
## Every diagnostic about crossing a closure boundary asks this first: the author
## of a `with` block wrote straight-line statements, so naming "a lambda" would
## point at code that is not on the screen.
pub fn in_with_sugar(cx: Cx) -> Bool =
  len(cx.frame.lambda_stack) > 0 && cx.frame.lambda_stack[len(cx.frame.lambda_stack) - 1].sugar

## Is the innermost lambda a `with handle` arm?
pub fn in_handler_arm(cx: Cx) -> Bool =
  len(cx.frame.lambda_stack) > 0 && cx.frame.lambda_stack[len(cx.frame.lambda_stack) - 1].arm

## The message for a jump that would have to leave a `with` region (spec §4.10),
## in the words of whichever of the two closures `with` makes it is standing in.
pub fn with_cross_msg_cx(cx: Cx, kw: String) -> String =
  if in_handler_arm(cx) {
    "`" ++ kw ++ "` cannot cross a `with handle` arm: the arm is a closure the " ++
      "handler calls, not part of the enclosing function"
  } else {
    with_cross_msg(kw)
  }

pub fn with_cross_msg(kw: String) -> String =
  "`" ++ kw ++ "` cannot cross the closure `with` introduced: the statements " ++
  "after `with` are that closure's body"

## A capture refusal, as (message, hint), in the words of whichever closure the
## name has to cross. Same rule as the jump diagnostics above, applied one frame
## at a time: `with` makes two closures the author never spelled -- an arm and
## the block remainder -- so saying "lambda" points at code that is not on the
## screen (docs/effects-design.md §7.1).
pub fn assign_across_msg(lc: LambdaCx, name: String) -> (String, String) =
  if lc.arm {
    ("cannot assign to `" ++ name ++ "` from inside a `with handle` arm",
      "an arm is a closure and captures by value; hand the value back as the " ++
        "operation's result instead")
  } else if lc.sugar {
    ("cannot assign to `" ++ name ++ "` from inside the closure `with` introduced",
      "the statements after `with` are that closure's body, and a closure " ++
        "captures by value")
  } else {
    ("cannot assign to `" ++ name ++ "` from inside a lambda",
      "lambdas capture by value; use the result of the lambda instead")
  }

pub fn capture_var_msg(lc: LambdaCx) -> (String, String) =
  if lc.arm {
    ("a `with handle` arm cannot capture `var` bindings (capture is by value)",
      "bind it to a let before the handler, or pass it in as an operation parameter")
  } else if lc.sugar {
    ("the closure `with` introduced cannot capture `var` bindings (capture is by value)",
      "bind it to a let before the `with`, or pass it as a parameter")
  } else {
    ("lambdas cannot capture `var` bindings (capture is by value)",
      "bind it to a let before the lambda, or pass it as a parameter")
  }

## return / return expr — early return from the enclosing fn (or lambda).
## The value is checked by the caller (recursion lives there); this decides the
## target type or errors. Returns Some(target) when a value should be checked
## against it, None when the return is malformed (already reported).
pub fn return_target(cx: Cx, lo: Int, hi: Int) -> (Cx, Option[Ty]) = {
  if len(cx.frame.lambda_stack) > 0 {
    # A `with` region is refused outright rather than quietly returning from the
    # synthesized closure: that reads as the enclosing function's return only
    # when the `with` block is itself in tail position, and nothing on the page
    # says which case the reader is in.
    if in_with_sugar(cx) {
      let hint = if in_handler_arm(cx) {
        "drop the `return` — the arm's last expression is what the operation call " ++
          "hands back"
      } else {
        "drop the `return` — the block's last expression is already what the " ++
          "`with` call hands back"
      }
      return (cerr_h(cx, with_cross_msg_cx(cx, "return"), lo, hi, hint), None)
    }
    let lc = cx.frame.lambda_stack[len(cx.frame.lambda_stack) - 1]
    match lc.expected_ret {
      Some(t) -> (cx, Some(t))
      None -> (cerr_h(cx,
        "`return` inside a lambda needs the lambda's return type to be known from context",
        lo, hi, "make the expected function type explicit, or drop the return"), None)
    }
  } else {
    match cx.frame.current_sig {
      None -> (cerr(cx, "`return` can only be used inside a function", lo, hi), None)
      Some(fs) ->
        if fs.inferring {
          (cerr_h(cx, "`return` needs the function's return type to be declared", lo, hi,
            "add `-> T` to fn " ++ fs.name ++ "(...)"), None)
        } else {
          (cx, Some(fs.ret))
        }
    }
  }
}

## break/continue — valid only inside a loop of the current function.
## Returns the loop's marker id (its span-lo works as identity) or -1.
pub fn check_loop_jump(cx: Cx, kw: String, lo: Int, hi: Int) -> (Cx, Bool) = {
  if len(cx.frame.loop_stack) == 0 {
    return (cerr(cx, "`" ++ kw ++ "` can only be used inside a loop body", lo, hi), false)
  }
  let depth = cx.frame.loop_stack[len(cx.frame.loop_stack) - 1]
  if depth != len(cx.frame.lambda_stack) {
    if in_with_sugar(cx) {
      let hint = if in_handler_arm(cx) {
        "the loop is outside the arm; an arm is called from wherever the operation " ++
          "is raised, which need not be inside any loop"
      } else {
        "the loop is outside that closure; move the `with` inside the loop body, " ++
          "or call the resource-using part as its own function"
      }
      return (cerr_h(cx, with_cross_msg_cx(cx, kw), lo, hi, hint), false)
    }
    return (cerr_h(cx, "`" ++ kw ++ "` cannot cross a lambda boundary to reach the loop outside",
      lo, hi, "a lambda is its own function: use `return` to exit it, or restructure the loop"),
      false)
  }
  (Cx { ..cx, loop_jumps: set.insert(cx.loop_jumps, len(cx.frame.loop_stack) - 1) }, true)
}

## expr? — unwrap Ok/Some or early-return the Err/None (spec §8.1).
pub fn check_propagate_typed(cx: Cx, ot: Ty, operand: TExpr, lo: Int, hi: Int) -> (Cx, Ty, TExpr) = {
  if is_errorish(ot) { return (cx, TyError, XError(lo, hi)) }
  # the node closes over the result type once it is known
  let node = (t: Ty) => XPropagate(operand, lo, hi, t)
  # inside a lambda, ? returns from the lambda — its return type must be known
  var sig_ret = TyError
  if len(cx.frame.lambda_stack) > 0 {
    let lc = cx.frame.lambda_stack[len(cx.frame.lambda_stack) - 1]
    sig_ret = match lc.expected_ret {
      Some(t) -> t
      None ->
        # `?` is meant to compose transparently through `with` (spec §4.10):
        # the synthesized closure's return type is the `with` call's, which is
        # the block's value. When that type is not yet known, say so in the
        # reader's terms rather than naming a lambda they did not write.
        if in_with_sugar(cx) {
          return (cerr_h(cx,
            "`?` after `with` needs the type of the `with` call to be known from context",
            lo, hi,
            "annotate the enclosing function's return type, so the closure `with` " ++
              "introduced knows what it hands back"), TyError, XError(lo, hi))
        } else {
          return (cerr_h(cx,
            "`?` inside a lambda needs the lambda's return type to be known from context",
            lo, hi,
            "handle the Option/Result with match, or make the expected function type explicit"),
            TyError, XError(lo, hi))
        }
    }
  } else {
    sig_ret = match cx.frame.current_sig {
      None -> return (cerr(cx,
        "`?` can only be used inside a function that returns Option or Result", lo, hi),
        TyError, XError(lo, hi))
      Some(fs) ->
        if fs.inferring {
          return (cerr_h(cx, "`?` needs the function's return type to be declared", lo, hi,
            "add `-> Option[...]` / `-> Result[...]` to fn " ++ fs.name ++ "(...)"),
            TyError, XError(lo, hi))
        } else {
          fs.ret
        }
    }
  }
  match ot {
    TyAdt(aid, targs) -> {
      if aid == OPTION_ID {
        let ret_is_opt = match sig_ret {
          TyAdt(rid, _) -> rid == OPTION_ID
          _ -> false
        }
        if not ret_is_opt {
          return (cerr(cx,
            "`?` on an Option requires the function to return Option[...], but it returns " ++
              ty_show(cx.adts, sig_ret), lo, hi), TyError, XError(lo, hi))
        }
        return (cx, targs[0], node(targs[0]))
      }
      if aid == RESULT_ID {
        match sig_ret {
          TyAdt(rid, rargs) -> {
            if rid != RESULT_ID {
              return (cerr(cx,
                "`?` on a Result requires the function to return Result[...], but it returns " ++
                  ty_show(cx.adts, sig_ret), lo, hi), TyError, XError(lo, hi))
            }
            if rargs[1] != targs[1] {
              return (cerr_h(cx, "`?` error types differ: " ++ ty_show(cx.adts, ot) ++ " vs " ++
                  ty_show(cx.adts, sig_ret), lo, hi,
                "there is no automatic error conversion; match and rewrap the error"),
                TyError, XError(lo, hi))
            }
            return (cx, targs[0], node(targs[0]))
          }
          _ -> return (cerr(cx,
            "`?` on a Result requires the function to return Result[...], but it returns " ++
              ty_show(cx.adts, sig_ret), lo, hi), TyError, XError(lo, hi))
        }
      }
      (cerr_h(cx, "`?` needs an Option or Result, got " ++ ty_show(cx.adts, ot), lo, hi,
        "`?` unwraps an Option or Result and early-returns on None/Err; this value is neither"),
        TyError, XError(lo, hi))
    }
    _ -> (cerr_h(cx, "`?` needs an Option or Result, got " ++ ty_show(cx.adts, ot), lo, hi,
      "`?` unwraps an Option or Result and early-returns on None/Err; this value is neither"),
      TyError, XError(lo, hi))
  }
}

test "propagate demands matching option and result shapes" {
  var cx = test_cx()
  let ret_sig = Sig {
    name: "f",
    param_tys: [],
    param_names: [],
    param_defaults: [],
    ret: opt_ty(TyInt),
    eff: EPure,
    is_builtin: false,
    tparams: [],
    constraints: [],
    eparams: [],
    owner: None,
    trait_id: None,
    op_of: None,
    inferring: false
  }
  cx = Cx { ..cx, frame: Frame { ..cx.frame, current_sig: Some(ret_sig) } }
  let (cx1, t1, _) = check_propagate_typed(cx, opt_ty(TyString), XError(0, 1), 0, 1)
  assert t1 == TyString
  assert len(cx1.diags) == 0
  let (cx2, t2, _) = check_propagate_typed(cx, result_ty(TyInt, TyString), XError(0, 1), 0, 1)
  assert str.contains(cx2.diags[0].msg, "requires the function to return Result")
  let (cx3, t3, _) = check_propagate_typed(cx, TyInt, XError(0, 1), 0, 1)
  assert str.contains(cx3.diags[0].msg, "`?` needs an Option or Result, got Int")
}

test "loop jumps respect lambda boundaries" {
  var cx = test_cx()
  let (cx1, ok1) = check_loop_jump(cx, "break", 0, 5)
  assert not ok1
  assert cx1.diags[0].msg == "`break` can only be used inside a loop body"
  cx = Cx { ..cx, frame: Frame { ..cx.frame, loop_stack: [0] } }
  let (cx2, ok2) = check_loop_jump(cx, "break", 0, 5)
  assert ok2
  cx = Cx {
    ..cx,
    frame: Frame {
      ..cx.frame,
      lambda_stack: [LambdaCx {
        boundary: 0,
        expected_ret: None,
        captures: [],
        sugar: false,
        arm: false
      }]
    }
  }
  let (cx3, ok3) = check_loop_jump(cx, "continue", 0, 8)
  assert not ok3
  assert str.contains(cx3.diags[0].msg, "cannot cross a lambda boundary")
}

## expr! — Option[T] -> T, panicking on None (spec §8.2). The panic message is
## assembled by the caller (it needs source/line info); this checks the type.
pub fn check_unwrap_typed(cx: Cx, ot: Ty, operand: TExpr, msg: String, lo: Int, hi: Int) -> (Cx, Ty, TExpr) = {
  if is_errorish(ot) { return (cx, TyError, XError(lo, hi)) }
  match ot {
    TyAdt(aid, targs) ->
      if aid == OPTION_ID {
        (cx, targs[0], XUnwrap(operand, msg, lo, hi, targs[0]))
      } else {
        let hint = if aid == RESULT_ID {
          "`!` unwraps an Option; on a Result use `?` to propagate, or match the Ok/Err"
        } else {
          "`!` unwraps an Option and panics on None; this value is not an Option"
        }
        (cerr_h(cx, "`!` needs an Option, got " ++ ty_show(cx.adts, ot), lo, hi, hint),
          TyError, XError(lo, hi))
      }
    _ -> (cerr_h(cx, "`!` needs an Option, got " ++ ty_show(cx.adts, ot), lo, hi,
      "`!` unwraps an Option and panics on None; this value is not an Option"),
      TyError, XError(lo, hi))
  }
}

## Does `t` -- or, if it is opaque and has none of its own, its target -- have
## an `Index` impl? The same order `resolve_witness` and `reduce_assoc` use, so
## the message below cannot refuse what they would have accepted.
fn has_index_impl(cx: Cx, t: Ty) -> Bool =
  match assoc_impl_of(cx, INDEX_ID, t) {
    Some(_) -> true
    None -> false
  }

## Record field access p.x — resolve against the record's single constructor.
pub fn check_field_access_typed(
  cx: Cx,
  tt: Ty,
  target: TExpr,
  fname: String,
  flo: Int,
  fhi: Int,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) = {
  if is_errorish(tt) { return (cx, TyError, XError(lo, hi)) }
  let bad_hint: Option[String] = match tt {
    TyAdt(aid, _) ->
      if adt_of(cx.adts, aid).is_record {
        None
      } else {
        Some("`" ++ adt_of(cx.adts, aid).name ++ "` is a sum type; destructure it with match")
      }
    _ -> None
  }
  let is_record = match tt {
    TyAdt(aid, _) -> adt_of(cx.adts, aid).is_record
    _ -> false
  }
  if not is_record {
    return (cerr_o(cx, "`.` field access needs a record value, got " ++ ty_show(cx.adts, tt),
      flo, fhi, bad_hint), TyError, XError(lo, hi))
  }
  match tt {
    TyAdt(aid, targs) -> {
      let a = adt_of(cx.adts, aid)
      let ci = a.ctors[0]
      var idx = -1
      var fty = TyError
      var i = 0
      for f in ci.fields {
        if f.name == fname {
          idx = i
          fty = f.ty
        }
        i = i + 1
      }
      if idx < 0 {
        var fnames: List[String] = []
        for f in ci.fields { fnames = fnames ++ [f.name] }
        let hint = match suggest.hint(fname, fnames) {
          Some(h) -> h
          None -> "fields: " ++ join(fnames, ", ")
        }
        return (cerr_h(cx, "`" ++ a.name ++ "` has no field `" ++ fname ++ "`", flo, fhi, hint),
          TyError, XError(lo, hi))
      }
      var m: Map[Int, Ty] = map.empty()
      var j = 0
      for tp in a.tparams {
        match tp {
          TyVar(_, vid) ->
            match get(targs, j) {
              Some(arg) -> { m = map.insert(m, vid, arg) }
              None -> ()
            }
          _ -> ()
        }
        j = j + 1
      }
      let em: Map[Int, Eff] = map.empty()
      {
        let rt = subst(fty, m, em)
        (cx, rt, XField(target, idx, lo, hi, rt))
      }
    }
    _ -> (cx, TyError, XError(lo, hi))
  }
}

test "unwrap and field access resolve their shapes" {
  let cx = test_cx()
  let (cx1, t1, _) = check_unwrap_typed(cx, opt_ty(TyInt), XError(0, 1), "m", 0, 2)
  assert t1 == TyInt
  let (cx2, t2, _) = check_unwrap_typed(cx, result_ty(TyInt, TyString), XError(0, 1), "m", 0, 2)
  assert str.contains(cx2.diags[0].hint, "on a Result use `?`")
}

test "field access follows record shape with substitution" {
  # type Box[T] = { v: T } — access .v on Box[Int]
  var cx = seed_prelude(test_cx())
  let (cx0, tv) = fresh_tvar(cx, "T")
  let (cx1, aid) = fresh(cx0)
  let info = AdtI {
    id: aid,
    name: "Box",
    is_record: true,
    tparams: [tv],
    eparams: no_eparam_names(),
    ctors: [CtorI { adt: aid, name: "Box", fields: [FieldI { name: "v", ty: tv }] }],
    derives_show: false,
    derives_ord: false,
    owner: None,
    audience: AWorld
  }
  cx = Cx {
    ..cx1,
    adts: map.insert(cx1.adts, aid, info),
    adts_by_name: map.insert(cx1.adts_by_name, "Box", aid)
  }
  let (cx2, t, x) = check_field_access_typed(cx, TyAdt(aid, [TyInt]), XError(0, 1), "v", 2, 3, 0, 3)
  assert t == TyInt
  assert x == XField(XError(0, 1), 0, 0, 3, TyInt)
  let (cx3, t2, _) = check_field_access_typed(cx, TyAdt(aid, [TyInt]), XError(0, 1), "w", 2, 3, 0, 3)
  assert cx3.diags[0].msg == "`Box` has no field `w`"
  # a single-character name never triggers a guess; the fields list shows instead
  assert cx3.diags[0].hint == "fields: v"
  let (cx4, t3, _) = check_field_access_typed(cx, opt_ty(TyInt), XError(0, 1), "v", 2, 3, 0, 3)
  assert str.contains(cx4.diags[0].hint, "sum type; destructure it with match")
}

# ---- pattern checking ----

## Does the pattern introduce any binding (recursively)?
pub fn binds_anything(p: Pattern) -> Bool =
  match p {
    PBind(_, _, _) -> true
    POr(alts) -> {
      for alt in alts {
        if binds_anything(alt) { return true }
      }
      false
    }
    PCtor(_, pargs, _, _, _, _, _, _) -> {
      for a in pargs {
        if binds_anything(a.pat) { return true }
      }
      false
    }
    PQual(_, _, pargs, _, _, _, _, _, _) -> {
      for a in pargs {
        if binds_anything(a.pat) { return true }
      }
      false
    }
    PTuple(elems, _, _) -> {
      for e in elems {
        if binds_anything(e) { return true }
      }
      false
    }
    PList(pre, _, rest_name, _, post, _, _) -> {
      match rest_name {
        Some(_) -> return true
        None -> ()
      }
      for e in pre ++ post {
        if binds_anything(e) { return true }
      }
      false
    }
    _ -> false
  }

fn refutable_span(cx: Cx, p: Pattern) -> Option[(Int, Int)] =
  match p {
    PWild(_, _) -> None
    PBind(_, _, _) -> None
    PLit(_, lo, hi) -> Some((lo, hi))
    POr(_) -> Some((pat_lo(p), pat_hi(p)))
    PTuple(elems, _, _) -> {
      for e in elems {
        match refutable_span(cx, e) {
          Some(s) -> return Some(s)
          None -> ()
        }
      }
      None
    }
    PList(pre, has_rest, _, _, post, lo, hi) ->
      # only [..rest] matches every list; any fixed element constrains the length
      if has_rest && len(pre) == 0 && len(post) == 0 { None } else { Some((lo, hi)) }
    PCtor(cname, pargs, _, _, _, _, lo, hi) -> {
      match map.get(cx.ctors_by_name, cname) {
        Some(key) -> {
          let (aid, _) = key
          if len(adt_of(cx.adts, aid).ctors) > 1 { return Some((lo, hi)) }
        }
        None -> ()
      }
      for a in pargs {
        match refutable_span(cx, a.pat) {
          Some(s) -> return Some(s)
          None -> ()
        }
      }
      None
    }
    PQual(q, cname, pargs, _, _, _, _, lo, hi) -> {
      match qual_ctor_key(cx, q, cname) {
        Some(key) -> {
          let (aid, _) = key
          if len(adt_of(cx.adts, aid).ctors) > 1 { return Some((lo, hi)) }
        }
        None -> ()
      }
      for a in pargs {
        match refutable_span(cx, a.pat) {
          Some(s) -> return Some(s)
          None -> ()
        }
      }
      None
    }
  }

## Check one pattern against the scrutinee type, declaring its bindings and
## producing the typed pattern (the Kotlin checkPattern).
pub fn check_pattern(cx: Cx, p: Pattern, scrut: Ty, mutable: Bool) -> (Cx, TPat) =
  match p {
    PWild(_, _) -> (cx, TPWild)
    PBind(name, lo, hi) -> {
      let (cx1, sym) = declare(cx, name, scrut, mutable, lo, hi)
      (cx1, TPBind(sym, name))
    }
    POr(alts) -> check_or_pattern(cx, alts, scrut, mutable)
    PLit(lit, lo, hi) -> check_lit_pattern(cx, lit, scrut, lo, hi)
    PTuple(elems, lo, hi) -> {
      let matches2 = match scrut {
        TyTuple(stys) -> len(stys) == len(elems)
        _ -> false
      }
      if matches2 {
        match scrut {
          TyTuple(stys) -> {
            var cx1 = cx
            var subs: List[TPat] = []
            var i = 0
            for sub in elems {
              let (cx2, tp) = check_pattern(cx1, sub, stys[i], mutable)
              cx1 = cx2
              subs = subs ++ [tp]
              i = i + 1
            }
            (cx1, TPTuple(subs))
          }
          _ -> (cx, TPWild)
        }
      } else {
        var cx1 = cx
        if not is_errorish(scrut) {
          let is_tuple = match scrut {
            TyTuple(_) -> true
            _ -> false
          }
          let msg = match scrut {
            TyTuple(stys) -> "this pattern has " ++ to_string(len(elems)) ++
              " elements but the scrutinee is " ++ ty_show(cx1.adts, scrut)
            _ -> "tuple pattern does not match scrutinee type " ++ ty_show(cx1.adts, scrut)
          }
          let hint = match scrut {
            TyTuple(stys) -> "a tuple pattern must bind exactly " ++ to_string(len(stys)) ++
              " element(s)"
            _ -> "match a tuple pattern only against a tuple value"
          }
          cx1 = cerr_h(cx1, msg, lo, hi, hint)
        }
        var subs: List[TPat] = []
        for sub in elems {
          let (cx2, tp) = check_pattern(cx1, sub, TyError, mutable)
          cx1 = cx2
          subs = subs ++ [tp]
        }
        (cx1, TPTuple(subs))
      }
    }
    PList(pre, has_rest, rest_name, rest_span, post, lo, hi) -> {
      var cx1 = cx
      let elem = match scrut {
        TyList(e) -> e
        _ -> {
          if not is_errorish(scrut) {
            cx1 = cerr(cx1, "list pattern does not match scrutinee type " ++
                ty_show(cx1.adts, scrut), lo, hi)
          }
          TyError
        }
      }
      var pres: List[TPat] = []
      for sub in pre {
        let (cx2, tp) = check_pattern(cx1, sub, elem, mutable)
        cx1 = cx2
        pres = pres ++ [tp]
      }
      var posts: List[TPat] = []
      for sub in post {
        let (cx2, tp) = check_pattern(cx1, sub, elem, mutable)
        cx1 = cx2
        posts = posts ++ [tp]
      }
      var rest_sym: Option[Int] = None
      match rest_name {
        Some(rn) -> {
          let (rlo, rhi) = match rest_span {
            Some(s) -> s
            None -> (lo, hi)
          }
          let (cx3, sym) = declare(cx1, rn, TyList(elem), mutable, rlo, rhi)
          cx1 = cx3
          rest_sym = Some(sym)
        }
        None -> ()
      }
      (cx1, TPList(pres, has_rest, rest_sym, posts))
    }
    PCtor(cname, pargs, has_rest, has_parens, nlo, nhi, lo, hi) ->
      check_ctor_pattern(cx, cname, pargs, has_rest, has_parens, nlo, nhi, lo, hi, scrut, mutable)
    PQual(q, cname, pargs, has_rest, has_parens, nlo, nhi, lo, hi) -> {
      match map.get(cx.module_exports, q) {
        None -> {
          var cx1 = cerr_h(cx, "unknown module alias `" ++ q ++ "` in a pattern", nlo, nhi,
            "a qualified pattern needs a whole-module import in scope: `use <path> as " ++
              q ++ "`")
          for a in pargs {
            let (cx2, _) = check_pattern(cx1, a.pat, TyError, mutable)
            cx1 = cx2
          }
          (cx1, TPWild)
        }
        Some(exp) ->
          match map.get(exp.ctors, cname) {
            None -> {
              var cx1 = cerr_o(cx, "module `" ++ exp.mod_path ++
                  "` has no exported constructor `" ++ cname ++ "`", nlo, nhi,
                suggest.hint(cname, map.keys(exp.ctors)))
              for a in pargs {
                let (cx2, _) = check_pattern(cx1, a.pat, TyError, mutable)
                cx1 = cx2
              }
              (cx1, TPWild)
            }
            Some(key) ->
              check_ctor_pattern_at(cx, key, cname, pargs, has_rest, has_parens,
                nlo, nhi, lo, hi, scrut, mutable)
          }
      }
    }
  }

type PatBind = { name: String, sym: Int, ty: Ty, lo: Int, hi: Int }

fn typed_binds(cx: Cx, p: TPat) -> List[PatBind] = {
  var out: List[PatBind] = []
  match p {
    TPBind(sid, _) -> {
      let s = sym_of(cx, sid)
      out = [PatBind {
        name: s.name,
        sym: sid,
        ty: s.ty,
        lo: s.dlo,
        hi: s.dhi
      }]
    }
    TPOr(alts) -> if len(alts) > 0 { out = typed_binds(cx, alts[0]) }
    TPTuple(elems) -> {
      for sub in elems { out = out ++ typed_binds(cx, sub) }
    }
    TPList(pre, _, rest_sym, post) -> {
      for sub in pre { out = out ++ typed_binds(cx, sub) }
      match rest_sym {
        Some(sid) -> {
          let s = sym_of(cx, sid)
          out = out ++ [PatBind {
            name: s.name,
            sym: sid,
            ty: s.ty,
            lo: s.dlo,
            hi: s.dhi
          }]
        }
        None -> ()
      }
      for sub in post { out = out ++ typed_binds(cx, sub) }
    }
    TPCtor(_, _, fields) -> {
      for field in fields {
        match field {
          Some(sub) -> { out = out ++ typed_binds(cx, sub) }
          None -> ()
        }
      }
    }
    _ -> ()
  }
  out
}

fn pat_bind_named(binds: List[PatBind], name: String) -> Option[PatBind] = {
  for bind in binds {
    if bind.name == name { return Some(bind) }
  }
  None
}

fn check_or_bindings(
  cx: Cx,
  canonical: List[PatBind],
  actual: List[PatBind],
  alt: Pattern
) -> Cx = {
  var cx1 = cx
  for want in canonical {
    match pat_bind_named(actual, want.name) {
      None -> {
        cx1 = cerr_h(cx1, "or-pattern alternative does not bind `" ++ want.name ++ "`",
          pat_lo(alt), pat_hi(alt), "every alternative must bind the same names as the first")
      }
      Some(got) -> {
        if got.ty != want.ty {
          cx1 = cerr_h(cx1, "or-pattern binding `" ++ want.name ++ "` has type " ++
              ty_show(cx1.adts, got.ty) ++ ", but the first alternative binds " ++
              ty_show(cx1.adts, want.ty), got.lo, got.hi,
            "bind `" ++ want.name ++ "` at the same type in every alternative")
        }
      }
    }
  }
  for got in actual {
    if pat_bind_named(canonical, got.name) == None {
      cx1 = cerr_h(cx1, "or-pattern alternative binds extra name `" ++ got.name ++ "`",
        got.lo, got.hi, "every alternative must bind the same names as the first")
    }
  }
  cx1
}

fn remap_or_binds(cx: Cx, p: TPat, canonical: List[PatBind]) -> TPat =
  match p {
    TPBind(sid, name) -> match pat_bind_named(canonical, name) {
      Some(bind) -> TPBind(bind.sym, name)
      None -> TPBind(sid, name)
    }
    TPOr(alts) -> TPOr(map(alts, alt => remap_or_binds(cx, alt, canonical)))
    TPTuple(elems) -> TPTuple(map(elems, sub => remap_or_binds(cx, sub, canonical)))
    TPList(pre, has_rest, rest_sym, post) -> {
      let mapped_rest: Option[Int] = match rest_sym {
        Some(sid) -> {
          let name = sym_of(cx, sid).name
          match pat_bind_named(canonical, name) {
            Some(bind) -> Some(bind.sym)
            None -> Some(sid)
          }
        }
        None -> None
      }
      TPList(
        map(pre, sub => remap_or_binds(cx, sub, canonical)),
        has_rest,
        mapped_rest,
        map(post, sub => remap_or_binds(cx, sub, canonical))
      )
    }
    TPCtor(aid, ci, fields) -> {
      var mapped: List[Option[TPat]] = []
      for field in fields {
        mapped = mapped ++ [match field {
          Some(sub) -> Some(remap_or_binds(cx, sub, canonical))
          None -> None
        }]
      }
      TPCtor(aid, ci, mapped)
    }
    _ -> p
  }

fn check_or_pattern(cx: Cx, alts: List[Pattern], scrut: Ty, mutable: Bool) -> (Cx, TPat) = {
  if len(alts) == 0 { return (cx, TPOr([])) }
  let first_diag_count = len(cx.diags)
  let (cx0, first) = check_pattern(cx, alts[0], scrut, mutable)
  var cx1 = cx0
  let first_ok = len(cx0.diags) == first_diag_count
  let canonical = typed_binds(cx1, first)
  var typed = [first]
  var i = 1
  while i < len(alts) {
    let alt_diag_count = len(cx1.diags)
    let isolated = push_scope(cx1)
    let (cxa, raw) = check_pattern(isolated, alts[i], scrut, mutable)
    cx1 = pop_scope(cxa)
    let actual = typed_binds(cx1, raw)
    if first_ok && len(cx1.diags) == alt_diag_count {
      cx1 = check_or_bindings(cx1, canonical, actual, alts[i])
    }
    typed = typed ++ [remap_or_binds(cx1, raw, canonical)]
    i = i + 1
  }
  (cx1, TPOr(typed))
}

fn usefulness_too_complex(cx: Cx, lo: Int, hi: Int) -> Cx =
  cerr_h(cx, "pattern analysis exceeded its complexity budget", lo, hi,
    "simplify nested alternatives or split the pattern into smaller matches")

fn check_lit_pattern(cx: Cx, lit: Expr, scrut: Ty, lo: Int, hi: Int) -> (Cx, TPat) = {
  # the literal's own type; string patterns are interpolation-free (parser ensured)
  let (lt, lv) = match lit {
    EInt(v, _, _) -> (TyInt, LInt(v))
    # a char literal is its code point: the same LInt every consumer already
    # handles, because a literal pattern lowers to an equality test on an Int
    EChar(v, _, _) -> (ty_char(), LInt(v))
    EFloat(v, _, _) -> (TyFloat, LFloat(v))
    EBool(v, _, _) -> (TyBool, LBool(v))
    EStr(parts, _, _) -> {
      var s = ""
      for pt in parts {
        match pt {
          SPText(v) -> { s = s ++ v }
          _ -> ()
        }
      }
      (TyString, LStr(s))
    }
    _ -> (TyError, LInt(0))
  }
  var cx1 = cx
  if lt != scrut && not is_errorish(scrut) && not is_errorish(lt) {
    cx1 = cerr(cx1, "pattern type " ++ ty_show(cx1.adts, lt) ++
        " does not match scrutinee type " ++ ty_show(cx1.adts, scrut), lo, hi)
  }
  (cx1, TPLit(lv))
}

fn check_ctor_pattern(
  cx: Cx,
  cname: String,
  pargs: List[PatArg],
  has_rest: Bool,
  has_parens: Bool,
  nlo: Int,
  nhi: Int,
  lo: Int,
  hi: Int,
  scrut: Ty,
  mutable: Bool
) -> (Cx, TPat) = {
  var cx1 = cx
  let key = match map.get(cx1.ctors_by_name, cname) {
    None -> {
      cx1 = cerr_o(cx1, "undefined constructor in pattern: " ++ cname, nlo, nhi,
        suggest.hint(cname, map.keys(cx1.ctors_by_name)))
      # still check subpatterns so their bindings exist (as TyError)
      for a in pargs {
        let (cx2, _) = check_pattern(cx1, a.pat, TyError, mutable)
        cx1 = cx2
      }
      return (cx1, TPWild)
    }
    Some(k) -> k
  }
  check_ctor_pattern_at(cx1, key, cname, pargs, has_rest, has_parens, nlo, nhi, lo, hi,
    scrut, mutable)
}

## The (adt id, ctor slot) a qualified pattern names, or None. Read-only:
## refutability asks without wanting diagnostics.
fn qual_ctor_key(cx: Cx, q: String, cname: String) -> Option[(Int, Int)] =
  match map.get(cx.module_exports, q) {
    None -> None
    Some(exp) -> map.get(exp.ctors, cname)
  }

## The shared tail: the constructor is resolved, check argument shape and
## subpatterns (both the local and the module-qualified spelling land here).
fn check_ctor_pattern_at(
  cx: Cx,
  key: (Int, Int),
  cname: String,
  pargs: List[PatArg],
  has_rest: Bool,
  has_parens: Bool,
  nlo: Int,
  nhi: Int,
  lo: Int,
  hi: Int,
  scrut: Ty,
  mutable: Bool
) -> (Cx, TPat) = {
  var cx1 = cx
  let (aid, cslot) = key
  let a2 = adt_of(cx1.adts, aid)
  let ci = a2.ctors[cslot]
  let scrut_matches = match scrut {
    TyAdt(said, _) -> said == aid
    _ -> false
  }
  if not scrut_matches {
    if not is_errorish(scrut) {
      cx1 = cerr(cx1, "`" ++ cname ++ "` is a " ++ a2.name ++
          " constructor, but the scrutinee is " ++ ty_show(cx1.adts, scrut), nlo, nhi)
    }
  }
  # instantiate field types with the scrutinee's type arguments
  var inst: Map[Int, Ty] = map.empty()
  if scrut_matches {
    match scrut {
      TyAdt(_, sargs) -> {
        var i = 0
        for tp in a2.tparams {
          match tp {
            TyVar(_, vid) ->
              match get(sargs, i) {
                Some(arg) -> { inst = map.insert(inst, vid, arg) }
                None -> ()
              }
            _ -> ()
          }
          i = i + 1
        }
      }
      _ -> ()
    }
  }
  let em: Map[Int, Eff] = map.empty()
  var field_tys: List[Ty] = []
  for f in ci.fields { field_tys = field_tys ++ [subst(f.ty, inst, em)] }
  let n = len(ci.fields)
  if not has_parens && n > 0 {
    cx1 = cerr_h(cx1, "constructor `" ++ ci.name ++ "` has " ++ to_string(n) ++
        " field(s); a bare name does not match it", lo, hi,
      "write " ++ ci.name ++ "(..) to ignore the fields, or destructure them")
    for a in pargs {
      let (cx2, _) = check_pattern(cx1, a.pat, TyError, mutable)
      cx1 = cx2
    }
    return (cx1, TPWild)
  }
  # (field, sub-pattern) pairs, collected in pattern order and turned into the
  # field-indexed list after the loop; an indexed write into a prefilled list
  # rebuilds the whole list per sub-pattern
  var matched: List[(Int, TPat)] = []
  # which field each sub-pattern is for: the same decision the call side makes
  # (types.ctor_slots). What is left here is the pattern half of it -- the
  # wording, the caret, and binding the sub-pattern against the field's type.
  # A sub-pattern with no field of its own is still checked, against TyError,
  # so the names it binds exist for the rest of the arm.
  var pnames: List[Option[String]] = []
  for a in pargs { pnames = pnames ++ [a.name] }
  let picks = ctor_slots(ci.fields, pnames, false)
  var i = 0
  for a in pargs {
    var idx = -1
    match picks[i] {
      SlotAt(at) -> { idx = at }
      SlotNoField(an) -> {
        var fnames: List[String] = []
        for f in ci.fields { fnames = fnames ++ [f.name] }
        let hint = match suggest.hint(an, fnames) {
          Some(h) -> h
          None -> "constructor: " ++ ctor_render(cx1.adts, ci)
        }
        cx1 = cerr_h(cx1, "`" ++ ci.name ++ "` has no field `" ++ an ++ "`",
          a.nlo, a.nhi, hint)
      }
      SlotAfterNamed -> {
        cx1 = cerr(cx1, "positional patterns cannot follow named patterns",
          pat_lo(a.pat), pat_hi(a.pat))
      }
      # counted below, as a whole
      SlotOverflow -> ()
      SlotTaken(at) -> {
        cx1 = cerr(cx1, "field `" ++ ci.fields[at].name ++ "` is matched twice",
          pat_lo(a.pat), pat_hi(a.pat))
      }
    }
    if idx < 0 {
      let (cx2, _) = check_pattern(cx1, a.pat, TyError, mutable)
      cx1 = cx2
    } else {
      let (cx3, tp) = check_pattern(cx1, a.pat, field_tys[idx], mutable)
      cx1 = cx3
      matched = matched ++ [(idx, tp)]
    }
    i = i + 1
  }
  # ctor_slots hands out each field at most once -- a second pattern for it
  # comes back SlotTaken with no pick -- so one scan per field answers which
  # sub-pattern matched it, and a later pair still wins as an indexed write did.
  var slots: List[Option[TPat]] = []
  var fk = 0
  for _fk in 0..n {
    var so: Option[TPat] = no_tpat()
    for mt in matched {
      let (mf, mp) = mt
      if mf == fk { so = Some(mp) }
    }
    slots = slots ++ [so]
    fk = fk + 1
  }
  if len(pargs) > n {
    cx1 = cerr_h(cx1, "`" ++ ci.name ++ "` has " ++ to_string(n) ++ " field(s), the pattern names " ++
        to_string(len(pargs)), lo, hi, "constructor: " ++ ctor_render(cx1.adts, ci))
  } else if not has_rest {
    var missing: List[String] = []
    var k = 0
    for f in ci.fields {
      match slots[k] {
        None -> { missing = missing ++ [f.name] }
        Some(_) -> ()
      }
      k = k + 1
    }
    if len(missing) > 0 {
      cx1 = cerr_h(cx1, "pattern for `" ++ ci.name ++ "` does not mention: " ++
          join(missing, ", "), lo, hi, "add `..` to ignore the remaining fields")
    }
  }
  (cx1, TPCtor(aid, cslot, slots))
}

fn no_tpat() -> Option[TPat] = None

test "patterns bind, refute, and lower" {
  var cx = seed_prelude(push_scope(test_cx()))
  # Some(x) against Option[Int] binds x: Int
  let p = PCtor("Some", [PatArg { name: None, nlo: 5, nhi: 6, pat: PBind("x", 5, 6) }],
    false, true, 0, 4, 0, 7)
  let (cx1, tp) = check_pattern(cx, p, opt_ty(TyInt), false)
  assert len(cx1.diags) == 0
  assert sym_of(cx1, lookup(cx1, "x").expect("bound")).ty == TyInt
  match tp {
    TPCtor(aid, ci, slots) -> {
      assert aid == OPTION_ID
      assert ci == 0
      assert len(slots) == 1
    }
    _ -> { assert false }
  }
  # refutability: Some(x) is refutable, (a, b) is not, [x] is
  assert refutable_span(cx, p) != None
  let tup = PTuple([PBind("a", 0, 1), PBind("b", 3, 4)], 0, 5)
  assert refutable_span(cx, tup) == None
  assert refutable_span(cx, PList([PWild(1, 2)], false, None, None, [], 0, 3)) != None
  assert binds_anything(p)
  assert not binds_anything(PWild(0, 1))
}

test "or-patterns share the first symbol" {
  let p = POr([
    PTuple([PBind("x", 1, 2), PWild(3, 4)], 0, 5),
    PTuple([PWild(7, 8), PBind("x", 9, 10)], 6, 11)
  ])
  let (cx1, tp) = check_pattern(push_scope(test_cx()), p, TyTuple([TyInt, TyInt]), false)
  assert len(cx1.diags) == 0
  match tp {
    TPOr(alts) -> {
      assert len(alts) == 2
      match alts[0] {
        TPTuple(first) -> match first[0] {
          TPBind(first_sym, _) -> match alts[1] {
            TPTuple(second) -> match second[1] {
              TPBind(second_sym, _) -> { assert first_sym == second_sym }
              _ -> { assert false }
            }
            _ -> { assert false }
          }
          _ -> { assert false }
        }
        _ -> { assert false }
      }
    }
    _ -> { assert false }
  }
}

test "or-patterns reject binding type mismatches" {
  let canonical = [
    PatBind { name: "x", sym: 1, ty: TyInt, lo: 1, hi: 2 }
  ]
  let actual = [
    PatBind { name: "x", sym: 2, ty: TyString, lo: 3, hi: 4 }
  ]
  let cx = check_or_bindings(test_cx(), canonical, actual, PWild(5, 6))
  assert len(cx.diags) == 1
  assert str.contains(cx.diags[0].msg, "binding `x` has type String")
}

test "or-patterns reject binding-set mismatches" {
  let canonical = [
    PatBind { name: "missing", sym: 1, ty: TyBool, lo: 1, hi: 2 }
  ]
  let actual = [
    PatBind { name: "extra", sym: 2, ty: TyBool, lo: 3, hi: 4 }
  ]
  let cx = check_or_bindings(test_cx(), canonical, actual, PWild(5, 6))
  assert len(cx.diags) == 2
  assert cx.diags[0].msg == "or-pattern alternative does not bind `missing`"
  assert cx.diags[1].msg == "or-pattern alternative binds extra name `extra`"
}

test "ctor pattern field discipline" {
  var cx = seed_prelude(push_scope(test_cx()))
  # Ok(v: x, ..) on Result[Int, String]; then a missing-field case
  let good = PCtor("Ok", [PatArg { name: Some("value"), nlo: 3, nhi: 8, pat: PBind("x", 10, 11) }],
    false, true, 0, 2, 0, 12)
  let (cx1, _) = check_pattern(cx, good, result_ty(TyInt, TyString), false)
  assert len(cx1.diags) == 0
  let bare = PCtor("Ok", no_pargs(), false, false, 0, 2, 0, 2)
  let (cx2, _) = check_pattern(cx, bare, result_ty(TyInt, TyString), false)
  assert str.contains(cx2.diags[0].msg, "a bare name does not match it")
  let wrong = PCtor("Ok", [PatArg { name: Some("nope"), nlo: 3, nhi: 7, pat: PWild(9, 10) }],
    false, true, 0, 2, 0, 11)
  let (cx3, _) = check_pattern(cx, wrong, result_ty(TyInt, TyString), false)
  assert cx3.diags[0].msg == "`Ok` has no field `nope`"
  # the caret is on the field name, not on the sub-pattern it was written for
  assert (cx3.diags[0].lo, cx3.diags[0].hi) == (3, 7)
  assert str.contains(cx3.diags[1].msg, "does not mention: value")
}

fn no_pargs() -> List[PatArg] = []

## What a name means at the point the call graph reaches it: the value binders
## in scope (parameters, `let`s, patterns, loop variables, local functions),
## the whole-module aliases, and the `use java` class names. All three answer
## the same question — is this spelling an edge to a top-level function of
## *this* module, or does it name something else entirely. Walking without them
## makes `fn a(b: Int) = b` depend on the top-level `b`, and rejects both as
## mutually recursive (audit ARC-01).
pub type RefScope = { bound: Set[String], mods: Set[String], javas: Set[String] }

## The scope a function body starts in: nothing bound yet, the module's aliases
## and Java class names fixed for the whole walk.
pub fn ref_scope(mods: Set[String], javas: Set[String]) -> RefScope =
  RefScope { bound: set.empty(), mods: mods, javas: javas }

pub fn rs_bind(sc: RefScope, name: String) -> RefScope =
  RefScope { ..sc, bound: set.insert(sc.bound, name) }

fn rs_params(sc: RefScope, ps: List[LambdaParam]) -> RefScope = {
  var o = sc
  for p in ps { o = rs_bind(o, p.name) }
  o
}

## Every name a pattern binds. `PLit`'s expression is a literal, so nothing in
## a pattern is a call position — only binders come out of here.
fn rs_pattern(sc: RefScope, p: Pattern) -> RefScope =
  match p {
    PBind(name, _, _) -> rs_bind(sc, name)
    POr(alts) -> {
      var o = sc
      for alt in alts { o = rs_pattern(o, alt) }
      o
    }
    PCtor(_, args, _, _, _, _, _, _) -> rs_pargs(sc, args)
    PQual(_, _, args, _, _, _, _, _, _) -> rs_pargs(sc, args)
    PTuple(elems, _, _) -> {
      var o = sc
      for x in elems { o = rs_pattern(o, x) }
      o
    }
    PList(pre, _, rest_name, _, post, _, _) -> {
      var o = sc
      for x in pre { o = rs_pattern(o, x) }
      match rest_name {
        Some(n) -> { o = rs_bind(o, n) }
        None -> ()
      }
      for x in post { o = rs_pattern(o, x) }
      o
    }
    _ -> sc
  }

fn rs_pargs(sc: RefScope, args: List[PatArg]) -> RefScope = {
  var o = sc
  for a in args { o = rs_pattern(o, a.pat) }
  o
}

## Is `target` a whole-module alias — i.e. is `target.f(..)` a call into
## another module rather than a UFCS rewrite of this module's `f`?
fn rs_qualified(sc: RefScope, target: Expr) -> Bool =
  match target {
    EVar(q, _, _) -> set.has(sc.mods, q)
    _ -> false
  }

## Is `target` a `use java` class name in receiver position — i.e. is
## `target.m(..)` a Java static call rather than a UFCS rewrite of this
## module's `m`? A bare capitalized receiver reaches the checker as a
## zero-argument `ECtor`, and check_method_call's static arm claims it only
## when no argument list was written; a receiver that *was* written with
## parentheses is an ordinary construction, so its edge stays. The names a
## constructor or a constant claims ahead of the Java class are already gone
## from `javas` (check_module builds it), so membership is the whole test.
fn rs_java_static(sc: RefScope, target: Expr) -> Bool =
  match target {
    ECtor(cn, cargs, spread, has_parens, _, _, _, _) ->
      not has_parens && len(cargs) == 0 && spread == None && set.has(sc.javas, cn)
    _ -> false
  }

## Every lowercase name mentioned in call/value position and *not* bound where
## it is mentioned — the call-graph over-approximation for return-type
## inference ordering (Kotlin nameRefs). The over-approximation is deliberate
## and one-sided: a spurious edge only costs ordering, but a spurious *cycle*
## rejects a legal program, which is why binders and module aliases are
## subtracted here rather than filtered downstream.
pub fn name_refs(e: Expr, out: Set[String], sc: RefScope) -> Set[String] =
  match e {
    EVar(name, _, _) ->
      if set.has(sc.bound, name) || set.has(sc.mods, name) { out } else { set.insert(out, name) }
    EMethod(target, name, args, _, _, _, _) -> {
      # `x.f(a)` can mean `f(x, a)` (UFCS, spec §4.3), so the method name is an
      # edge — unless the receiver settles the call elsewhere first. Two
      # receivers do, and both are decidable from the syntax alone here: a
      # module alias, where `f` lives in that other module, and a `use java`
      # class name, where `Class.f(..)` is a Java static and no local function
      # is reachable at all.
      #
      # Nothing else may be subtracted. A Java *instance* call `value.f(..)` is
      # also never a local function, but telling it apart from UFCS needs the
      # receiver's type, and this walk runs before any body is checked. And a
      # builtin or std method name keeps its edge on purpose: name resolution
      # is local-then-std-then-builtin with whole shadowing (spec §10.6), so
      # with a top-level `len` in this module `xs.len()` really does call it.
      let elsewhere = rs_qualified(sc, target) || rs_java_static(sc, target)
      var o = if elsewhere { out } else { set.insert(out, name) }
      o = name_refs(target, o, sc)
      for a in args { o = name_refs(a.e, o, sc) }
      o
    }
    # the callee is walked like any other subexpression: a named call reaches
    # the EVar arm above, which is where its name is recorded
    EApply(target, args, _, _) -> {
      var o = name_refs(target, out, sc)
      for a in args { o = name_refs(a.e, o, sc) }
      o
    }
    ELambda(params, body, _, _, _) -> name_refs(body, out, rs_params(sc, params))
    EBlock(stmts, tail, _, _) -> {
      var o = out
      var s = sc
      for st in stmts {
        let (o1, s1) = stmt_name_refs(st, o, s)
        o = o1
        s = s1
      }
      match tail {
        Some(t) -> name_refs(t, o, s)
        None -> o
      }
    }
    EIf(cond, thn, els, _, _) -> {
      var o = name_refs(thn, name_refs(cond, out, sc), sc)
      match els {
        Some(x) -> name_refs(x, o, sc)
        None -> o
      }
    }
    EMatch(scrut, arms, _, _) -> {
      var o = name_refs(scrut, out, sc)
      for arm in arms {
        let asc = rs_pattern(sc, arm.pat)
        match arm.guard {
          Some(g) -> { o = name_refs(g, o, asc) }
          None -> ()
        }
        o = name_refs(arm.body, o, asc)
      }
      o
    }
    ECtor(_, cargs, spread, _, _, _, _, _) -> {
      var o = out
      match spread {
        Some(sp) -> { o = name_refs(sp, o, sc) }
        None -> ()
      }
      for a in cargs { o = name_refs(a.e, o, sc) }
      o
    }
    EFieldAcc(target, _, _, _, _, _) -> name_refs(target, out, sc)
    EListLit(elems, _, _) -> {
      var o = out
      for x in elems {
        match x {
          LeExpr(e) -> { o = name_refs(e, o, sc) }
          LeSpread(e, _, _) -> { o = name_refs(e, o, sc) }
          LeIf(arms, _, _) -> {
            for a in arms {
              o = name_refs(a.body, name_refs(a.cond, o, sc), sc)
            }
          }
        }
      }
      o
    }
    ETupleLit(elems, _, _) -> {
      var o = out
      for x in elems { o = name_refs(x, o, sc) }
      o
    }
    EBinary(_, l, r, _, _, _, _) -> name_refs(r, name_refs(l, out, sc), sc)
    EUnary(_, operand, _, _) -> name_refs(operand, out, sc)
    EPropagate(operand, _, _) -> name_refs(operand, out, sc)
    EUnwrap(operand, _, _) -> name_refs(operand, out, sc)
    EIndex(target, index, _, _) -> name_refs(index, name_refs(target, out, sc), sc)
    EReturn(v, _, _) ->
      match v {
        Some(x) -> name_refs(x, out, sc)
        None -> out
      }
    EStr(parts, _, _) -> {
      var o = out
      for pt in parts {
        match pt {
          SPInterp(x) -> { o = name_refs(x, o, sc) }
          _ -> ()
        }
      }
      o
    }
    EComptime(body, _, _) -> name_refs(body, out, sc)
    EUnsafePure(body, _, _) -> name_refs(body, out, sc)
    # both halves of `with handle E { .. }` are ordinary code the function
    # runs: the arm bodies (each a lambda over the operation's parameters) and
    # the remainder of the block, which the parser packed into `rest` as a
    # parameterless lambda. An arm's *name* is the operation it answers, not a
    # call, so it is not an edge -- the operation itself is spelled bare at the
    # site that raises it, and that spelling is an EVar handled above.
    EHandle(_, arms, rest, _, _, _, _) -> {
      var o = out
      for a in arms { o = name_refs(a.body, o, rs_params(sc, a.params)) }
      name_refs(rest, o, sc)
    }
    _ -> out
  }

## A statement's references, plus the scope the *next* statement sees: a block
## binds left to right, so `let` and `for` have to hand their name forward.
fn stmt_name_refs(s: Stmt, out: Set[String], sc: RefScope) -> (Set[String], RefScope) =
  match s {
    SLet(name, _, _, init, _, _) -> (name_refs(init, out, sc), rs_bind(sc, name))
    SLetPat(pat, _, init, _, _) -> (name_refs(init, out, sc), rs_pattern(sc, pat))
    # a local function is in scope in its own body: it may recurse, and that
    # recursion is not an edge to a top-level function of the same name
    SLocalFn(name, params, _, _, body, _, _, _, _) -> {
      let inner = rs_bind(sc, name)
      (name_refs(body, out, rs_params(inner, params)), inner)
    }
    SAssign(_, value, _, _, _, _) -> (name_refs(value, out, sc), sc)
    SExpr(e, _, _) -> (name_refs(e, out, sc), sc)
    SAssert(cond, _, _, _) -> (name_refs(cond, out, sc), sc)
    SWhile(cond, body, _, _) -> (name_refs(body, name_refs(cond, out, sc), sc), sc)
    SFor(pat, from, to, body, _, _) -> {
      var o = name_refs(from, out, sc)
      match to {
        Some(t) -> { o = name_refs(t, o, sc) }
        None -> ()
      }
      (name_refs(body, o, rs_pattern(sc, pat)), sc)
    }
  }

test "name refs walk every call position" {
  let e = EBlock(
    [SLet("x", false, None,
      EApply(EVar("g", 0, 1), [pos_arg(EVar("y", 2, 3))], 0, 4), 0, 5)],
    Some(EMethod(EVar("m", 6, 7), "h",
      [pos_arg(ELambda(no_lparams(), EVar("z", 10, 11), false, 8, 12))], 8, 9, 6, 13)),
    0,
    14
  )
  let refs = name_refs(e, set.empty(), ref_scope(set.empty(), set.empty()))
  for n in ["g", "y", "m", "h", "z"] {
    assert set.has(refs, n)
  }
  assert not set.has(refs, "x")
}

test "a bound name is not an edge to the top-level function it shadows" {
  # b => { let c = 1; match d { Some(e) -> b(c, e) } } — every lowercase
  # name here is bound, so nothing but the scrutinee `d` comes out (ARC-01).
  let arm = MatchArm {
    pat: PCtor("Some", [PatArg { name: None, nlo: 0, nhi: 0, pat: PBind("e", 0, 1) }],
      false, true, 0, 1, 0, 1),
    guard: None,
    body: EApply(EVar("b", 0, 1), [pos_arg(EVar("c", 0, 1)), pos_arg(EVar("e", 0, 1))], 0, 1),
    lo: 0,
    hi: 1
  }
  let body = EBlock(
    [SLet("c", false, None, EInt(1, 0, 1), 0, 1)],
    Some(EMatch(EVar("d", 0, 1), [arm], 0, 1)),
    0,
    1
  )
  let lam = ELambda([LambdaParam { name: "b", ann: None, lo: 0, hi: 1 }], body, false, 0, 1)
  let refs = name_refs(lam, set.empty(), ref_scope(set.empty(), set.empty()))
  assert set.to_list(refs) == ["d"]
  # a for-loop variable and a local function's own name are binders too
  let loop_body = EBlock(
    [SLocalFn("k", no_lparams(), TNamed("Int", [], [], 0, 1), [], EApply(EVar("k", 0, 1), [], 0, 1),
      0, 1, 0, 1)],
    Some(EVar("i", 0, 1)),
    0,
    1
  )
  let floop = EBlock([
    SFor(PBind("i", 0, 1), EInt(0, 0, 1), Some(EInt(2, 0, 1)), loop_body, 0, 1)
  ], None, 0, 1)
  assert set.to_list(name_refs(floop, set.empty(), ref_scope(set.empty(), set.empty()))) == []
}

test "a module-qualified call is not an edge to a same-named local function" {
  # list.take([], n) mentions `take`, but that `take` is std/list's
  let call = EMethod(EVar("list", 0, 4), "take",
    [pos_arg(EListLit([], 0, 1)), pos_arg(EVar("n", 0, 1))], 0, 1, 0, 1)
  let mods = set.insert(set.empty(), "list")
  assert set.to_list(name_refs(call, set.empty(), ref_scope(mods, set.empty()))) == ["n"]
  # with no alias of that name in scope the receiver is a value, and UFCS puts
  # the edge back
  let refs = name_refs(call, set.empty(), ref_scope(set.empty(), set.empty()))
  assert set.has(refs, "take")
  assert set.has(refs, "list")
}

test "a Java static call is not an edge to a same-named local function" {
  # Integer.toHexString(n) mentions `toHexString`, but that call is answered by
  # java.lang.Integer and never reaches a local function of that name (ARC-01)
  let recv = ECtor("Integer", no_cargs(), None, false, 0, 7, 0, 7)
  let call = EMethod(recv, "toHexString", [pos_arg(EVar("n", 0, 1))], 0, 1, 0, 1)
  let javas = set.insert(set.empty(), "Integer")
  assert set.to_list(name_refs(call, set.empty(), ref_scope(set.empty(), javas))) == ["n"]
  # with no `use java` class of that name the receiver is a constructor, and
  # UFCS puts the edge back
  assert set.has(name_refs(call, set.empty(), ref_scope(set.empty(), set.empty())), "toHexString")
  # a written argument list is an ordinary construction, not the static
  # namespace: check_method_call declines it there too, so the edge stays
  let built = EMethod(ECtor("Integer", no_cargs(), None, true, 0, 7, 0, 9), "toHexString",
    [], 0, 1, 0, 1)
  assert set.has(name_refs(built, set.empty(), ref_scope(set.empty(), javas)), "toHexString")
}

fn no_cargs() -> List[Arg] = []

test "a handler's arms and its remainder are both call positions" {
  # with handle Ask { get(n) => p(n, q) }  r()
  let arm = HandlerArm {
    name: "get",
    params: [LambdaParam { name: "n", ann: None, lo: 0, hi: 1 }],
    body: EApply(EVar("p", 0, 1), [pos_arg(EVar("n", 0, 1)), pos_arg(EVar("q", 0, 1))], 0, 1),
    lo: 0,
    hi: 1,
    nlo: 0,
    nhi: 1
  }
  let rest = ELambda(no_lparams(), EApply(EVar("r", 0, 1), [], 0, 1), true, 0, 1)
  let h = EHandle("Ask", [arm], rest, 0, 1, 0, 1)
  let refs = name_refs(h, set.empty(), ref_scope(set.empty(), set.empty()))
  assert set.to_list(refs) == ["p", "q", "r"]
  # the arm's parameter is bound, and `get` names the operation the arm answers
  assert not set.has(refs, "n")
  assert not set.has(refs, "get")
}

fn no_lparams() -> List[LambdaParam] = []

# ---- effect isolation frames ----

## Enter a comptime-style isolated context: fresh scope, no enclosing function,
## empty effect record (the Kotlin checkComptimeBody's prologue). What comes
## back is the whole outgoing frame, which is what makes the restore in
## leave_isolated one write instead of eight.
pub fn enter_isolated(cx: Cx) -> (Cx, Frame) = {
  let empty_w: Map[Eff, (Int, Int, String)] = map.empty()
  let empty_d: Map[(Int, Int), Int] = map.empty()
  let fresh_scope: Map[String, Int] = map.empty()
  (Cx {
    ..cx,
    # spelled out rather than spread, so a field added to Frame has to be
    # answered for here instead of leaking through into the isolated body
    frame: Frame {
      scopes: [fresh_scope],
      used_effects: [],
      eff_witness: empty_w,
      current_sig: None,
      dict_syms: empty_d,
      lambda_stack: [],
      loop_stack: [],
      isolated: true
    }
  }, cx.frame)
}

## Leave the isolated context: every effect the body used is an error (`what`
## names the construct), then the frame is restored.
pub fn leave_isolated(cx: Cx, frame: Frame, what: String, blo: Int, bhi: Int) -> Cx = {
  var cx1 = cx
  for used in cx.frame.used_effects {
    let (wlo, whi, name) = match map.get(cx.frame.eff_witness, used) {
      Some(w) -> w
      None -> (blo, bhi, "?")
    }
    let hint = if len(eff_labels(used)) > 0 {
      "compile-time evaluation cannot raise a declared effect; v1 has no handlers " ++
        "at comptime (docs/effects-design.md §4.5)"
    } else {
      "compile-time evaluation cannot perform io (spec §7.2)"
    }
    cx1 = cerr_h(cx1, what ++ " must be pure, but `" ++ name ++ "` is !" ++ eff_show(used),
      wlo, whi, hint)
  }
  Cx { ..cx1, frame: frame }
}

test "an isolated context reports its own effects, then restores all eight fields" {
  var cx = test_cx()
  # The outer frame this enters an isolated context from. Every field differs
  # from what `enter_isolated` installs, including the ones the body then
  # writes -- otherwise "restored" and "left as the body had it" are the same
  # answer and the assertions below pass either way. The predecessor of this
  # test set `used_effects` to `[EIo]` and had the body record `EIo`, which is
  # exactly that degenerate shape (docs/arch-split-design.md §5.4). It is built
  # here rather than in a helper because a top-level fn would lower into the
  # module's Core and a test block does not.
  let outer_scope: Map[String, Int] = map.insert(map.empty(), "outer", 61)
  let outer_wit: Map[Eff, (Int, Int, String)] =
    map.insert(map.empty(), EIo, (1, 2, "outer_io"))
  let outer_dicts: Map[(Int, Int), Int] = map.insert(map.empty(), (900, EQ_ID), 77)
  cx = Cx {
    ..cx,
    frame: Frame {
      scopes: [outer_scope],
      # not EIo: the body below records EIo, and an outer record that already
      # held it could not tell restoring from keeping the body's
      used_effects: [EffVar("outer_e", 42)],
      # keyed on EIo *because* the body writes that key -- restoring gives back
      # the outer witness, not restoring leaves the body's
      eff_witness: outer_wit,
      current_sig: Some(Sig {
        name: "outer", param_tys: [], param_names: [], param_defaults: [], ret: TyInt,
        eff: EPure, is_builtin: false, tparams: [], constraints: [], eparams: [],
        owner: None, trait_id: None, op_of: None, inferring: false
      }),
      dict_syms: outer_dicts,
      lambda_stack: [LambdaCx {
        boundary: 3, expected_ret: None, captures: [], sugar: false, arm: false
      }],
      loop_stack: [7],
      isolated: false
    }
  }
  let (cx1, frame) = enter_isolated(cx)
  # nothing of the outer frame reaches the body
  assert len(cx1.frame.scopes) == 1
  assert map.get(cx1.frame.scopes[0], "outer") == None
  assert len(cx1.frame.used_effects) == 0
  assert map.get(cx1.frame.eff_witness, EIo) == None
  assert cx1.frame.current_sig == None
  assert map.get(cx1.frame.dict_syms, (900, EQ_ID)) == None
  assert len(cx1.frame.lambda_stack) == 0
  assert len(cx1.frame.loop_stack) == 0
  assert cx1.frame.isolated
  # the body records io of its own, at its own span, and that is what is reported
  let cx2 = record_effect(cx1, EIo, 5, 8, "println")
  let cx3 = leave_isolated(cx2, frame, "const initializers", 0, 10)
  assert len(cx3.diags) == 1
  assert cx3.diags[0].msg == "const initializers must be pure, but `println` is !io"
  assert cx3.diags[0].lo == 5
  # ... and every one of the eight fields comes back as the outer context left
  # it. It was nine: `handle_evs` mapped a `with handle`'s evidence symbol to
  # its arms' effects, which settlement read to decide whether a closure could
  # drop the label. Nothing settles, so the map has no reader and no field.
  assert map.get(cx3.frame.scopes[0], "outer") == Some(61)
  assert cx3.frame.used_effects == [EffVar("outer_e", 42)]
  assert map.get(cx3.frame.eff_witness, EIo) == Some((1, 2, "outer_io"))
  let sig_name = match cx3.frame.current_sig {
    Some(s) -> s.name
    None -> "<not restored>"
  }
  assert sig_name == "outer"
  assert map.get(cx3.frame.dict_syms, (900, EQ_ID)) == Some(77)
  assert len(cx3.frame.lambda_stack) == 1
  assert cx3.frame.lambda_stack[0].boundary == 3
  assert cx3.frame.loop_stack == [7]
  assert not cx3.frame.isolated
}

## Does this expression need an expected type to check at all? (drives the
## two-round argument checking; the Kotlin needsExpected.)
pub fn needs_expected(cx: Cx, e: Expr) -> Bool =
  match e {
    EListLit(elems, _, _) -> {
      if len(elems) == 0 { return true }
      for x in elems {
        if not needs_expected_elem(cx, x) { return false }
      }
      true
    }
    ETupleLit(elems, _, _) -> {
      for x in elems {
        if needs_expected(cx, x) { return true }
      }
      false
    }
    # a generic function used as a value is instantiated from the expected type
    EVar(name, _, _) -> {
      match lookup(cx, name) {
        Some(_) -> return false
        None -> ()
      }
      match lookup_fn_sig(cx, name) {
        Some(s) -> len(s.tparams) > 0
        None -> false
      }
    }
    ECtor(cname, cargs, spread, has_parens, _, _, _, _) ->
      match map.get(cx.ctors_by_name, cname) {
        None -> false
        Some(key) -> {
          let (aid, cslot) = key
          let a = adt_of(cx.adts, aid)
          let ci = a.ctors[cslot]
          # bare nullary generic ctor (None): element type comes from expected;
          # bare ctor-with-fields as a fn value (Some): needs the expected fn type
          (len(ci.fields) == 0 && len(a.tparams) > 0) ||
            (not has_parens && len(ci.fields) > 0 && not a.is_record)
        }
      }
    ELambda(params, _, _, _, _) -> {
      for p in params {
        match p.ann {
          None -> return true
          Some(_) -> ()
        }
      }
      false
    }
    # a zero-arg generic call (map_empty()) can only be typed from context, and
    # so can a written-out generic construction with no arguments (`Nil()`)
    EApply(target, args, _, _) ->
      match target {
        EVar(callee, _, _) -> {
          match lookup(cx, callee) {
            Some(_) -> return false
            None -> ()
          }
          match lookup_fn_sig(cx, callee) {
            Some(s) -> len(s.tparams) > 0 && len(args) == 0
            None -> false
          }
        }
        ECtor(cname, _, _, _, _, _, _, _) ->
          match map.get(cx.ctors_by_name, cname) {
            None -> false
            Some(key) -> {
              let (aid, cslot) = key
              let a = adt_of(cx.adts, aid)
              let ci = a.ctors[cslot]
              len(ci.fields) == 0 && len(a.tparams) > 0
            }
          }
        _ -> false
      }
    # same for its module-qualified spelling (map.empty(), spec §10.3) — needs
    # the import env, resolved by the caller via a pre-filled table; here the
    # alias fns live in cx via pass_imports' std handling at check time
    EMethod(target, name, args, _, _, _, _) ->
      match target {
        EVar(rname, _, _) -> {
          match lookup(cx, rname) {
            Some(_) -> return false
            None -> ()
          }
          match map.get(cx.module_fn_sigs, (rname, name)) {
            Some(s) -> len(s.tparams) > 0 && len(args) == 0
            None -> false
          }
        }
        _ -> false
      }
    _ -> false
  }

## The same question for one list-literal element. A spread asks it of its
## operand -- `..[]` is exactly as undecidable alone as `[]` is -- and a
## conditional element asks it of its bodies, under the rule the literal
## itself uses: one body that types on its own settles the element, so the
## whole form needs an expectation only when every body does.
pub fn needs_expected_elem(cx: Cx, x: ListElem) -> Bool =
  match x {
    LeExpr(e) -> needs_expected(cx, e)
    LeSpread(e, _, _) -> needs_expected(cx, e)
    LeIf(arms, _, _) -> {
      for a in arms {
        if not needs_expected(cx, if_body_value(a.body)) { return false }
      }
      true
    }
  }

## What an `if` body produces, with a one-expression block peeled off.
##
## The parser always makes an `if` body a block (`if_expr` calls `block_expr`),
## and `needs_expected` has no `EBlock` arm -- it falls to the wildcard and
## answers false. So without this peel the arm above could never return true,
## and `[if c { None }, Some(1)]` would be refused while `[None, Some(1)]` and
## `[..[], Some(1)]` are accepted: a rule written and never able to fire.
##
## Peeled here rather than by giving `needs_expected` an `EBlock` arm, which
## would re-order the two rounds for every argument and every match arm in the
## tree. `[{ None }, Some(1)]` is refused for the same missing arm and stays
## refused; that is the pre-existing shape, not this one.
fn if_body_value(e: Expr) -> Expr =
  match e {
    EBlock(stmts, tail, _, _) ->
      match tail {
        Some(t) -> if len(stmts) == 0 { t } else { e }
        None -> e
      }
    _ -> e
  }

## A top-level function or builtin used as a value; generics need the expected
## type (the Kotlin checkFnValue).
pub fn check_fn_value(
  cx: Cx,
  name: String,
  f: Sig,
  expected: Option[Ty],
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) = {
  # A declared effect used to be refused here: a function value's wrapper is a
  # lambda, a lambda captured its evidence where it was written, and a
  # synthesised wrapper would have captured whatever handler was in scope at
  # the *mention* rather than at the call. It does not capture any more --
  # `lower.lift_fn_value` unpacks the pack its caller hands over -- so `let g =
  # raises` is an ordinary function value of type `fn() -> Int !Leak` and the
  # call site owes the evidence.
  #
  # **An operation is still refused, and for a reason the label never was.**
  # `ask` names no function: an operation call is a field read off a handler's
  # record plus a closure call (`check_call`), so there is nothing for a
  # wrapper to call. The refusal that remains is about the missing callee, not
  # about the row, and it says so.
  if f.op_of != None {
    let ps2 = join(f.param_names, ", ")
    return (cerr_h(cx, "effect operation `" ++ name ++ "` cannot be used as a value", lo, hi,
      "wrap it in a lambda: (" ++ ps2 ++ ") => " ++ name ++ "(" ++ ps2 ++ ")"),
      TyError, XError(lo, hi))
  }
  # Counted off the type parameters rather than off `constraints` directly, so
  # "there are bounds" and "these are the bounds" are one walk: the eta
  # expansion below discharges exactly what this counts, and a second walk is
  # how the two could come to disagree.
  var nbounds = 0
  var bi = 0
  for _tp in f.tparams {
    nbounds = nbounds + len(bounds_of(f, bi))
    bi = bi + 1
  }
  let declared = TyFn(f.param_tys, f.ret, f.eff)
  let eff_is_var = match f.eff {
    EffVar(_, _) -> true
    _ -> false
  }
  let node = (t: Ty) => XFnValue(f.owner, name, f.is_builtin, t, lo, hi)
  if len(f.tparams) == 0 && not eff_is_var {
    return (cx, declared, node(declared))
  }
  let exp: Option[(List[Ty], Ty, Eff)] = match expected {
    Some(TyFn(eps, eret, eeff)) ->
      if len(eps) == len(f.param_tys) { Some((eps, eret, eeff)) } else { None }
    _ -> None
  }
  let (eps, eret, eeff) = match exp {
    None ->
      return (cerr_h(cx, "cannot infer the type parameter(s) of `" ++ name ++
          "` used as a value here", lo, hi,
        "wrap it in a lambda with annotated parameters: (x: Int) => " ++ name ++ "(x)"),
        TyError, XError(lo, hi))
    Some(v) -> v
  }
  var m: Map[Int, Ty] = map.empty()
  var em: Map[Int, Eff] = map.empty()
  var i = 0
  for d in f.param_tys {
    let a = eps[i]
    if is_concrete(cx, a) {
      let (m2, em2, _) = unify_into(cx, d, a, m, em)
      m = m2
      em = em2
    }
    i = i + 1
  }
  if is_concrete(cx, eret) {
    let (m3, em3, _) = unify_into(cx, f.ret, eret, m, em)
    m = m3
    em = em3
  }
  var unbound: List[String] = []
  for tp in f.tparams {
    match tp {
      TyVar(n, vid) -> if not map.has(m, vid) { unbound = unbound ++ [n] }
      _ -> ()
    }
  }
  if len(unbound) > 0 {
    return (cerr_h(cx, "cannot infer type parameter(s) " ++ join(unbound, ", ") ++ " for `" ++
        name ++ "` used as a value", lo, hi, "wrap it in a lambda with annotated parameters"),
      TyError, XError(lo, hi))
  }
  match f.eff {
    EffVar(_, eid) -> if not map.has(em, eid) { em = map.insert(em, eid, eeff) }
    _ -> ()
  }
  let cx1 = cx
  # the function-value instantiation choke: rows inside the value's type
  # reduce with the same bindings its types substituted under (SEM-13 path)
  let inst = reduce_ty_effs(cx1, subst(declared, m, em), m)
  if nbounds > 0 {
    return eta_bounded_fn_value(cx1, name, f, m, em, inst, lo, hi)
  }
  (cx1, inst, node(inst))
}

## A bounded function or a trait method used as a value: write the eta
## expansion that used to be demanded of the programmer (audit SEM-13).
##
## The dictionaries are the whole of the difficulty, and the reason this
## happens in the checker rather than in `lift_fn_value`: a bound is discharged
## against the checker's scopes, and a bound on the *enclosing* function's type
## parameter is discharged to that function's hidden dictionary parameter,
## which the wrapper then has to capture. So the wrapper is opened as a lambda
## first and the witnesses are resolved inside it. `resolve_witness` puts a
## forwarded dictionary into every open lambda's capture list by itself, and
## the synthesised wrapper is only one more of those.
##
## What comes out is an ordinary call node, so nothing downstream learns a new
## shape: `lower_trait_call` devirtualises a concrete subject, collapses a
## prelude witness to the primitive and dispatches a forwarded one through the
## dictionary, none of which this has to know.
fn eta_bounded_fn_value(
  cx: Cx,
  name: String,
  f: Sig,
  m: Map[Int, Ty],
  em: Map[Int, Eff],
  inst: Ty,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) = {
  let ctx = LambdaCx {
    boundary: len(cx.frame.scopes),
    expected_ret: None,
    captures: [],
    sugar: false,
    arm: false
  }
  var cx1 = Cx {
    ..cx,
    frame: Frame { ..cx.frame, lambda_stack: cx.frame.lambda_stack ++ [ctx] }
  }
  var wits: List[WitRef] = []
  var ok = true
  var i = 0
  for tp in f.tparams {
    for tr_id in bounds_of(f, i) {
      let (cxa, w) = resolve_witness(cx1, tr_id, subst(tp, m, em), lo, hi,
        "`" ++ name ++ "`")
      cx1 = cxa
      match w {
        Some(wr) -> { wits = wits ++ [wr] }
        None -> { ok = false }
      }
    }
    i = i + 1
  }
  let (ips, iret, _) = fn_ty_parts(inst)
  # The parameters are the compiler's, not the source's: naming them after the
  # callee's parameters would let a wrapper shadow a module alias, and nothing
  # reads these names but a hover.
  cx1 = push_scope(cx1)
  var psyms: List[Int] = []
  var pnames: List[String] = []
  var args: List[TExpr] = []
  var j = 0
  for pt in ips {
    let pn = "eta\$" ++ to_string(j)
    let (cxd, sid) = declare(cx1, pn, pt, false, lo, hi)
    cx1 = cxd
    psyms = psyms ++ [sid]
    pnames = pnames ++ [pn]
    args = args ++ [XLocal(sid, pn, lo, hi, pt)]
    j = j + 1
  }
  cx1 = pop_scope(cx1)
  let popped = cx1.frame.lambda_stack[len(cx1.frame.lambda_stack) - 1]
  let outer = list.take(cx1.frame.lambda_stack, len(cx1.frame.lambda_stack) - 1)
  cx1 = Cx { ..cx1, frame: Frame { ..cx1.frame, lambda_stack: outer } }
  if not ok { return (cx1, TyError, XError(lo, hi)) }
  # The eta wrapper's own body is a *named* call, so the evidence it owes is
  # per atom of the callee's ABI row, not one pack. A bounded function value
  # with a labelled row would need that list built here; none exists (a bound
  # and a label have never met in one signature in this tree), and building it
  # blind would be a second, untested copy of `check_call`'s evidence block.
  # The builtin side is uninhabited rather than merely empty, and the two
  # halves of the reason are in different files: only `sort_by` and `bracket`
  # have a row worth a slot (`types.nev`), and neither carries a bound, so
  # neither reaches this wrapper -- `check_fn_value` only opens one when
  # `nbounds > 0`, and an unbounded primitive taken as a value is an
  # `XFnValue` that `lower.lift_fn_value` unpacks a pack for.
  let evid: List[TExpr] = []
  let body =
    if f.is_builtin {
      XCallBuiltin(name, args, wits, evid, lo, hi, iret)
    } else {
      XCallFn(f.owner, name, args, wits, evid, f.trait_id, lo, hi, iret)
    }
  (cx1, inst, XLambda(psyms, pnames, body, popped.captures, lo, hi, inst))
}

test "fn values instantiate from the expected type" {
  let cx = test_cx()
  let bs = builtins()
  # len: List[T] -> Int as a value with expected fn(List[Int]) -> Int
  let len_sig = map.get(bs, "len").expect("len")
  let (cx1, t1, _) = check_fn_value(cx, "len", len_sig,
    Some(TyFn([TyList(TyInt)], TyInt, EPure)), 0, 3)
  assert len(cx1.diags) == 0
  assert t1 == TyFn([TyList(TyInt)], TyInt, EPure)
  # without context the generic cannot instantiate
  let (cx2, t2, _) = check_fn_value(cx, "len", len_sig, None, 0, 3)
  assert str.contains(cx2.diags[0].msg, "cannot infer the type parameter(s) of `len`")
  # a bounded sig eta-expands once the expected type settles its subject; the
  # bound is Eq because that one answers structurally, so the exemplar needs no
  # impl table (no table builtin carries bounds since the ordering family moved
  # to std/list, so the sig is hand-built)
  let tv = TyVar("T", 0)
  let bounded = Sig {
    name: "sortish", param_tys: [TyList(tv)], param_names: ["xs"], param_defaults: [],
    ret: TyList(tv),
    eff: EPure, is_builtin: true, tparams: [tv], constraints: [[EQ_ID]], eparams: [],
    owner: None, trait_id: None, op_of: None, inferring: false
  }
  let want = TyFn([TyList(TyInt)], TyList(TyInt), EPure)
  let (cx3, t3, x3) = check_fn_value(cx, "sortish", bounded, Some(want), 0, 4)
  assert len(cx3.diags) == 0
  assert t3 == want
  match x3 {
    XLambda(psyms, _, body, caps, _, _, _) -> {
      assert len(psyms) == 1
      # nothing to capture: the witness is settled at `Int`, not forwarded
      assert len(caps) == 0
      match body {
        XCallBuiltin(bn, bargs, bwits, _, _, _, _) -> {
          assert bn == "sortish"
          assert len(bargs) == 1
          assert bwits == [WConcrete(EQ_ID, TyInt)]
        }
        _ -> { assert false }
      }
    }
    _ -> { assert false }
  }
  # without an expected type the subject is unknown, so the bound has nothing
  # to be discharged at and the wrapper cannot be written
  let (cx3b, _, _) = check_fn_value(cx, "sortish", bounded, None, 0, 4)
  assert cx3b.diags[0].msg ==
    "cannot infer the type parameter(s) of `sortish` used as a value here"
  # a non-generic sig passes through untouched
  let join_sig = map.get(bs, "join").expect("join")
  let (cx4, t4, _) = check_fn_value(cx, "join", join_sig, None, 0, 4)
  assert t4 == TyFn([TyList(TyString), TyString], TyString, EPure)
}

## A constructor used bare as a function value: `map(xs, Some)`. Generics come
## from the expected fn type (the Kotlin checkCtorValue).
pub fn check_ctor_value(
  cx: Cx,
  aid: Int,
  cslot: Int,
  eps: List[Ty],
  eret: Ty,
  eeff: Eff,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) = {
  let a = adt_of(cx.adts, aid)
  let ci = a.ctors[cslot]
  var params: List[Ty] = []
  for f in ci.fields { params = params ++ [f.ty] }
  let ret = adt_self_ty(a)
  let node = (t: Ty) => XCtorValue(aid, cslot, lo, hi, t)
  if len(eps) != len(params) {
    return (cerr_h(cx, "`" ++ ci.name ++ "` takes " ++ to_string(len(params)) ++
        " field(s), but " ++ ty_show(cx.adts, TyFn(eps, eret, eeff)) ++ " is expected", lo, hi,
      "constructor: " ++ ctor_render(cx.adts, ci)), TyError, XError(lo, hi))
  }
  if len(a.tparams) == 0 {
    let t0 = TyFn(params, ret, EPure)
    return (cx, t0, node(t0))
  }
  var m: Map[Int, Ty] = map.empty()
  var em: Map[Int, Eff] = map.empty()
  var i = 0
  for d in params {
    let arg = eps[i]
    if is_concrete(cx, arg) {
      let (m2, em2, _) = unify_into(cx, d, arg, m, em)
      m = m2
      em = em2
    }
    i = i + 1
  }
  if is_concrete(cx, eret) {
    let (m3, em3, _) = unify_into(cx, ret, eret, m, em)
    m = m3
    em = em3
  }
  var unbound: List[String] = []
  for tp in a.tparams {
    match tp {
      TyVar(n, vid) -> if not map.has(m, vid) { unbound = unbound ++ [n] }
      _ -> ()
    }
  }
  if len(unbound) > 0 {
    return (cerr_h(cx, "cannot infer type parameter(s) " ++ join(unbound, ", ") ++ " for `" ++
        ci.name ++ "` used as a value", lo, hi,
      "annotate the surrounding context, or wrap it in a lambda"), TyError, XError(lo, hi))
  }
  var ips: List[Ty] = []
  for d in params { ips = ips ++ [subst(d, m, em)] }
  let t1 = TyFn(ips, subst(ret, m, em), EPure)
  (cx, t1, node(t1))
}

## Satisfy one trait requirement at a use site (the general resolveWitness):
## rigid type parameter → the caller's dictionary is forwarded (and captured by
## every enclosing lambda); concrete subject → coherence gives the unique impl.
pub fn resolve_witness(
  cx: Cx,
  trait_id: Int,
  t: Ty,
  lo: Int,
  hi: Int,
  requirer: String
) -> (Cx, Option[WitRef]) = {
  if is_errorish(t) { return (cx, no_wit()) }
  let tr = trait_of(cx.traits, trait_id)
  # A projection is answered here, before any of the per-trait paths below,
  # because all of them would answer it wrong: the impl lookup cannot hit (no
  # head), the structural default has nothing to walk, and the leftover hint
  # would tell the reader to write an impl whose subject the compiler rejects.
  match t {
    TyAssoc(_, _, _) -> { return (assoc_witness_err(cx, tr.name, t, lo, hi), no_wit()) }
    _ -> ()
  }
  # An opaque type answers for itself if it has its own impl, and otherwise
  # falls back to its target. Opacity hides a representation from other
  # modules; it does not give the value a second equality, hash or order --
  # at run time it IS the target, so a witness that disagreed with the target
  # would be a witness for a value that does not exist.
  match t {
    TyOpaque(_, _, _, _, tgt) ->
      match impl_at(cx.impl_table, trait_id, t) {
        None -> { return resolve_witness(cx, trait_id, tgt, lo, hi, requirer) }
        Some(_) -> ()
      }
    _ -> ()
  }
  match t {
    TyVar(_, vid) ->
      match map.get(cx.frame.dict_syms, (vid, trait_id)) {
        None -> {
          let ts = ty_show(cx.adts, t)
          (cerr_h(cx, requirer ++ " requires `" ++ tr.name ++ "[" ++ ts ++ "]`, but `" ++
              ts ++ "` has no such bound", lo, hi,
            "add the bound: [" ++ ts ++ ": " ++ tr.name ++ "]"), no_wit())
        }
        Some(sym) -> (capture_witness(cx, sym), Some(WForward(sym)))
      }
    _ ->
      match impl_at(cx.impl_table, trait_id, t) {
        Some(imp) ->
          if len(imp.tparams) == 0 {
            (cx, Some(WConcrete(trait_id, t)))
          } else {
            # A conditional impl is only a witness once its own bounds are:
            # `Ord[Box[T]]` holds exactly as far as `Ord[T]` does. Failure
            # here is a real error, unlike the synthesised case below --
            # the impl promised the bound, so nothing weaker is available.
            var cxg = cx
            var ws: List[WitRef] = []
            var ok = true
            for g in sub_goals(cx.impl_table, trait_id, t) {
              let (gt, gty) = g
              let (cxh, w) = resolve_witness(cxg, gt, gty, lo, hi, requirer)
              cxg = cxh
              match w {
                Some(wr) -> { ws = ws ++ [wr] }
                None -> { ok = false }
              }
            }
            if ok { (cxg, Some(WApply(trait_id, t, ws))) } else { (cxg, no_wit()) }
          }
        None -> {
          # Equality and hashing have a structural default, so a missing impl
          # is usually not a missing capability -- but "usually" is not
          # "always", and this used to say always. The same walk `==` asks
          # decides here, so the bound cannot accept what the operator refuses.
          #
          # The witness is a plain WConcrete: "which impl" and "is there one"
          # are the table's question, not a witness kind's, and lowering asks
          # the table either way.
          if trait_id == EQ_ID || trait_id == HASH_ID {
            match structural_gap(cx, trait_id, t, set.empty()) {
              None -> return solved_structurally(cx, trait_id, t, lo, hi, requirer)
              Some(bad) ->
                return (structural_gap_err(cx, trait_id, t, bad, lo, hi), no_wit())
            }
          }
          # Show has no structural default -- an ADT without `derive Show` is
          # not printable, and saying otherwise is how the flag became three
          # things. A tuple is the exception, and not a special case so much as
          # a missing spelling: it has no head, so there is no impl anyone
          # could write (trait-v2-design decision 7). Its elements still have
          # to answer, which is what the ground short-circuit above would have
          # skipped.
          if trait_id == SHOW_ID {
            match t {
              TyTuple(es) -> return show_tuple_witness(cx, t, es, lo, hi, requirer)
              _ -> ()
            }
          }
          let ts = ty_show(cx.adts, t)
          let hint = if trait_id == ORD_ID && not is_adt(t) {
            "orderable scalars are Int and String; Float has no total order (NaN), " ++
              "and everything else needs an `impl Ord`"
          } else if is_nongeneric_adt(cx, t) {
            "define `impl " ++ tr.name ++ "[" ++ ts ++ "] { ... }` in the module declaring `" ++
              ts ++ "` or `" ++ tr.name ++ "`"
          } else if t == TyInt || t == TyFloat || t == TyBool || t == TyString {
            "define `impl " ++ tr.name ++ "[" ++ ts ++ "] { ... }` in the module declaring `" ++
              tr.name ++ "`"
          } else {
            # Not "named non-generic types and the scalars" any more: trait v2
            # made a generic subject the ordinary case, so the old hint sent
            # the reader looking for a restriction the checker stopped having.
            # Same wording as impl_shape_bad, which is what would judge the
            # impl they write next.
            "a subject is a type constructor applied to the impl's own " ++
              "parameters, as in `impl[T: " ++ tr.name ++ "] " ++ tr.name ++
              "[List[T]]`; write it in the module declaring `" ++ tr.name ++
              "` or the type"
          }
          (cerr_h(cx, "no impl of `" ++ tr.name ++ "` for `" ++ ts ++ "`", lo, hi, hint), no_wit())
        }
      }
  }
}

## `Show[(A, B)]`: every element's witness, and the whole is `WConcrete` when
## it is ground -- lowering spells the rendering out then -- or `WApply` when
## it is not, so the dictionary is built from the elements'.
fn show_tuple_witness(
  cx: Cx,
  t: Ty,
  es: List[Ty],
  lo: Int,
  hi: Int,
  requirer: String
) -> (Cx, Option[WitRef]) = {
  var cx1 = cx
  var ws: List[WitRef] = []
  var ok = true
  for e in es {
    let (cx2, w) = resolve_witness(cx1, SHOW_ID, e, lo, hi, requirer)
    cx1 = cx2
    match w {
      Some(wr) -> { ws = ws ++ [wr] }
      None -> { ok = false }
    }
  }
  if not ok { return (cx1, no_wit()) }
  if is_ground(t) {
    (cx1, Some(WConcrete(SHOW_ID, t)))
  } else {
    (capture_wits(cx1, ws), Some(WApply(SHOW_ID, t, ws)))
  }
}

## No impl, but Eq/Hash hold structurally for every type, so the compiler
## supplies one (trait-v2-design §3.6). Which *shape* of witness that is comes
## down to one question: is the subject ground?
##
## Ground -- `Eq[Pair[Int, String]]` -- and the relation is fully determined
## here, so the witness stays `WConcrete` and lowering spells the comparison
## out. That is every witness the language had before trait v2, which is why
## this cut changes no existing program's bytecode.
##
## Not ground -- `Eq[Option[T]]`, `T` rigid -- and it is not determined here at
## all: it is a function of `Eq[T]`, and only the caller knows which. So the
## witness carries the arguments' witnesses (`WApply`) and lowering builds the
## dictionary from them.
##
## A synthesised impl is a witness exactly as far as its parts are, the same
## way a conditional impl is: an argument that cannot answer is an error here,
## not a reason to fall back. It used to fall back to `WConcrete`, and that is
## how `fn f[T](a: Box[T], b: Box[T]) -> Bool = a == b` compiled without a
## bound -- lowering had nothing left but the erased runtime walk, which the
## JVM answered by accident (`Object.equals` recursion) and native could not
## answer at all. `==` at a bare `T` has demanded the bound since trait v2;
## this is the same demand one level in.
fn solved_structurally(
  cx: Cx,
  trait_id: Int,
  t: Ty,
  lo: Int,
  hi: Int,
  requirer: String
) -> (Cx, Option[WitRef]) = {
  if is_ground(t) || not expandable(t) {
    return (cx, Some(WConcrete(trait_id, t)))
  }
  var cx1 = cx
  var ws: List[WitRef] = []
  var ok = true
  for a in type_args_of(t) {
    let (cx2, w) = resolve_witness(cx1, trait_id, a, lo, hi, requirer)
    cx1 = cx2
    match w {
      Some(wr) -> { ws = ws ++ [wr] }
      None -> { ok = false }
    }
  }
  if ok { (cx1, Some(WApply(trait_id, t, ws))) } else { (cx1, no_wit()) }
}

fn probe_args(cx: Cx, trait_id: Int, args: List[Ty]) -> Option[List[WitRef]] = {
  var out: List[WitRef] = []
  for a in args {
    match probe_witness(cx, trait_id, a) {
      Some(w) -> { out = out ++ [w] }
      None -> return None
    }
  }
  Some(out)
}

## `resolve_witness` without the diagnostics or the capture bookkeeping: can
## this goal be met at all? Both are side effects, and a probe that fails must
## leave none behind -- an unmet sub-goal falls back to the old witness rather
## than becoming an error.
fn probe_witness(cx: Cx, trait_id: Int, t: Ty) -> Option[WitRef] =
  match t {
    TyVar(_, vid) ->
      match map.get(cx.frame.dict_syms, (vid, trait_id)) {
        Some(sym) -> Some(WForward(sym))
        None -> None
      }
    _ ->
      match impl_at(cx.impl_table, trait_id, t) {
        Some(imp) ->
          if len(imp.tparams) == 0 {
            Some(WConcrete(trait_id, t))
          } else {
            var ws: List[WitRef] = []
            for g in sub_goals(cx.impl_table, trait_id, t) {
              let (gt, gty) = g
              match probe_witness(cx, gt, gty) {
                Some(w) -> { ws = ws ++ [w] }
                None -> return None
              }
            }
            Some(WApply(trait_id, t, ws))
          }
        None -> {
          if trait_id == SHOW_ID {
            match t {
              TyTuple(es) ->
                match probe_args(cx, SHOW_ID, es) {
                  Some(ws) ->
                    return Some(if is_ground(t) {
                      WConcrete(SHOW_ID, t)
                    } else {
                      WApply(SHOW_ID, t, ws)
                    })
                  None -> return None
                }
              _ -> return None
            }
          }
          if trait_id != EQ_ID && trait_id != HASH_ID { return None }
          match structural_gap(cx, trait_id, t, set.empty()) {
            Some(_) -> return None
            None -> ()
          }
          if is_ground(t) || not expandable(t) {
            return Some(WConcrete(trait_id, t))
          }
          match probe_args(cx, trait_id, type_args_of(t)) {
            Some(ws) -> Some(WApply(trait_id, t, ws))
            None -> None
          }
        }
      }
  }

## A forwarded dictionary reached through a `WApply` is used just as much as
## one reached directly, so an enclosing lambda has to capture it either way.
fn capture_wits(cx: Cx, ws: List[WitRef]) -> Cx = {
  var cx1 = cx
  for w in ws {
    cx1 =
      match w {
        WForward(sym) -> capture_witness(cx1, sym)
        WApply(_, _, inner) -> capture_wits(cx1, inner)
        WConcrete(_, _) -> cx1
      }
  }
  cx1
}

fn is_adt(t: Ty) -> Bool =
  match t {
    TyAdt(_, _) -> true
    _ -> false
  }

fn is_nongeneric_adt(cx: Cx, t: Ty) -> Bool =
  match t {
    TyAdt(aid, _) -> len(adt_of(cx.adts, aid).tparams) == 0
    _ -> false
  }

test "ctor values and witnesses" {
  var cx = seed_prelude(test_cx())
  # Some as fn(Int) -> Option[Int]
  let (cx1, t1, _) = check_ctor_value(cx, OPTION_ID, 0, [TyInt], opt_ty(TyInt), EPure, 0, 4)
  assert len(cx1.diags) == 0
  assert t1 == TyFn([TyInt], opt_ty(TyInt), EPure)
  # arity mismatch reports with the ctor render
  let (cx2, t2, _) = check_ctor_value(cx, OPTION_ID, 0, [TyInt, TyInt], TyUnit, EPure, 0, 4)
  assert str.contains(cx2.diags[0].msg, "`Some` takes 1 field(s)")
  # witness: Int has a prelude Ord impl, Bool does not
  let (cx3, ok3) = resolve_witness(cx, ORD_ID, TyInt, 0, 4, "`sort`")
  assert ok3 == Some(WConcrete(ORD_ID, TyInt))
  let (cx4, ok4) = resolve_witness(cx, ORD_ID, TyBool, 0, 4, "`sort`")
  assert ok4 == None
  assert cx4.diags[0].msg == "no impl of `Ord` for `Bool`"
  # Ord over a non-ADT gets the ordering-specific hint (the Kotlin implHint order)
  assert str.contains(cx4.diags[0].hint, "Float has no total order")
  # Eq over a type with no impl is the structural default, and it is the same
  # kind of witness as one an impl supplies -- the table, not the witness,
  # records which of the two it was
  let (cx5, ok5) = resolve_witness(cx, EQ_ID, TyList(TyInt), 0, 4, "`f`")
  assert len(cx5.diags) == 0
  assert ok5 == Some(WConcrete(EQ_ID, TyList(TyInt)))
  assert not has_impl_at(cx5.impl_table, EQ_ID, TyList(TyInt))
  # a function value still has no equality, and says so at the bound
  let (cx6, ok6) = resolve_witness(cx, EQ_ID, TyList(TyFn([TyInt], TyInt, EPure)), 0, 4, "`f`")
  assert ok6 == None
  assert str.contains(cx6.diags[0].msg, "cannot be compared")
}

test "an impl subject is a head applied to the impl's own parameters" {
  let cx = seed_prelude(test_cx())
  let t = TyVar("T", 901)
  let u = TyVar("U", 902)
  let none_tv: List[Ty] = []
  # the shapes v1 allowed, and the one v2 adds
  assert impl_shape_bad(cx, TyInt, none_tv) == None
  assert impl_shape_bad(cx, TyList(t), [t]) == None
  assert impl_shape_bad(cx, TyMap(t, u), [t, u]) == None
  # a concrete argument would make matching ask "which impl is more
  # specific", which is specialisation, not a minimal slice
  assert why_bad(cx, TyList(TyInt), none_tv) == "applied to types"
  # a repeated parameter has no unique binding
  assert why_bad(cx, TyMap(t, t), [t, u]) == "used twice"
  # and a variable is not a type constructor
  assert why_bad(cx, t, [t]) == "no type constructor"
}

## The reason `impl_shape_bad` gave, reduced to the phrase the test names.
fn why_bad(cx: Cx, subject: Ty, tvars: List[Ty]) -> String =
  match impl_shape_bad(cx, subject, tvars) {
    None -> "accepted"
    Some(why) -> {
      for phrase in ["applied to types", "used twice", "no type constructor",
        "not a parameter", "concrete argument"] {
        if str.contains(why, phrase) { return phrase }
      }
      why
    }
  }

test "a subject containing a rigid variable takes its arguments' witnesses" {
  let cx = seed_prelude(test_cx())
  let tv = TyVar("T", 900)
  # Nothing in scope for `T`, so the synthesised impl has no argument witness
  # to build from and says so, exactly as a conditional impl would. It used to
  # fall back to `WConcrete` and leave lowering the erased runtime walk.
  let (cx1, w1) = resolve_witness(cx, EQ_ID, opt_ty(tv), 0, 4, "`f`")
  assert w1 == None
  assert str.contains(cx1.diags[0].msg, "requires `Eq[T]`")
  # With `[T: Eq]` in scope, the whole's witness carries the part's -- which
  # is the only way to reach a relation the caller decides.
  let dicts = map.insert(cx.frame.dict_syms, (900, EQ_ID), 77)
  let bound = Cx { ..cx, frame: Frame { ..cx.frame, dict_syms: dicts } }
  let (cx2, w2) = resolve_witness(bound, EQ_ID, opt_ty(tv), 0, 4, "`f`")
  assert len(cx2.diags) == 0
  assert w2 == Some(WApply(EQ_ID, opt_ty(tv), [WForward(77)]))
  # Nesting: the argument is itself applied.
  let (cx3, w3) = resolve_witness(bound, EQ_ID, opt_ty(opt_ty(tv)), 0, 4, "`f`")
  assert w3 == Some(WApply(EQ_ID, opt_ty(opt_ty(tv)),
    [WApply(EQ_ID, opt_ty(tv), [WForward(77)])]))
  # A container is not `expandable`: there is no structure here to spell out,
  # because since S3 the relation is an ordinary conditional impl in std. This
  # table has no std in it, so the walk is what answers.
  let (cx4, w4) = resolve_witness(bound, EQ_ID, TyList(tv), 0, 4, "`f`")
  assert w4 == Some(WConcrete(EQ_ID, TyList(tv)))
  # A ground subject is untouched.
  let (cx5, w5) = resolve_witness(bound, EQ_ID, opt_ty(TyInt), 0, 4, "`f`")
  assert len(cx5.diags) == 0
  assert w5 == Some(WConcrete(EQ_ID, opt_ty(TyInt)))
}

# ---- the recursive expression checker (pass 5 core) ----

## Check one expression against an optional expected type (the Kotlin
## checkExpr/inferExpr pair). Returns (state, type, typed node).
pub fn check_expr(cx: Cx, e: Expr, expected: Option[Ty]) -> (Cx, Ty, TExpr) !io =
  match see_through_expected(cx, e, expected) {
    Some(t) -> check_expr_at(cx, e, Some(t))
    None -> check_expr_at(cx, e, expected)
  }

## The expectation as the declaring module sees it. Peeling here rather than
## at each leaf is the point: inference reaches `map.empty()`/`[]`/`None` with
## a concrete type, and the result converts back through `assignable`. Outside
## the declaring module nothing is peeled, so the expectation stays opaque.
fn see_through_expected(cx: Cx, e: Expr, expected: Option[Ty]) -> Option[Ty] =
  # Only for expressions that cannot be typed without an expectation. Anything
  # that types itself keeps the opaque expectation and converts at the
  # boundary instead -- peeling for those loses the type inside inference:
  # `generic_id(i)` at an `Id` would bind `T` to the target and then reject
  # the argument it was handed.
  if not needs_expected(cx, e) {
    None
  } else {
    match expected {
      Some(TyOpaque(_, _, ow, _, tgt)) -> if sees_through(cx, ow) { Some(tgt) } else { None }
      _ -> None
    }
  }

## One element of a list literal, at the element type agreed so far. Returns
## what this element contributes to that type: its own type for an ordinary
## element, the *item* type for a spread, the common body type for a
## conditional one. `EListLit` unifies the answer back in, so all three forms
## reach the literal's element type through the same door.
##
## `elem_t` is `TyNever` until something has settled it, and is passed down as
## the expectation once it is concrete. That push-down is the whole point of
## the feature and not an optimisation: `text(m.note)` is a call whose type
## parameter appears only in the return type, so a body that gets `None` here
## cannot be typed at all -- while the same call *as a sibling* of a
## `Widget[Msg]` types fine. Hand the bodies `None` and the tea_todo view
## stops compiling.
fn check_list_elem(cx: Cx, x: ListElem, elem_t: Ty) -> (Cx, Ty, TListElem) !io = {
  let el_exp: Option[Ty] =
    if elem_t != TyNever && is_concrete(cx, elem_t) { Some(elem_t) } else { None }
  match x {
    LeExpr(e) -> {
      let (cx1, t, tx) = check_expr(cx, e, el_exp)
      (cx1, t, TLEExpr(tx))
    }
    LeSpread(e, lo, hi) -> {
      # the expectation crosses the `..`: the operand of a spread is a list of
      # what the literal is a list of, so `[x, ..[]]` and `[x, ..if c { [] }
      # else { ys }]` reach their empty literals with an element type.
      let list_exp: Option[Ty] = match el_exp {
        Some(t) -> Some(TyList(t))
        None -> None
      }
      let (cx1, t, tx) = check_expr(cx, e, list_exp)
      match t {
        TyList(item) -> (cx1, item, TLESpread(tx))
        _ ->
          if is_errorish(t) {
            (cx1, TyError, TLESpread(tx))
          } else {
            (cerr_h(cx1, "`..` spreads a list, but this is " ++ ty_show(cx1.adts, t), lo, hi,
              "drop the `..` to make it one element"), TyError, TLESpread(tx))
          }
      }
    }
    LeIf(arms, _, _) -> {
      var cx1 = cx
      var t = TyNever
      var out: List[TListIfArm] = []
      for a in arms {
        let (cx2, ct, cndx) = check_expr(cx1, a.cond, no_expected())
        cx1 = cx2
        if ct != TyBool && not is_errorish(ct) {
          cx1 = cerr(cx1, "if condition must be Bool, got " ++ ty_show(cx1.adts, ct),
            e_lo(a.cond), e_hi(a.cond))
        }
        # an earlier arm of the same chain settles the type for a later one,
        # exactly as an earlier element settles it for a later element
        let body_exp: Option[Ty] =
          if t != TyNever && is_concrete(cx1, t) { Some(t) } else { el_exp }
        let (cx3, bt, bx) = check_expr(cx1, a.body, body_exp)
        cx1 = cx3
        let (cx4, u) = unify_branches(cx1, t, bt, e_lo(a.body), e_hi(a.body), "the if branches")
        cx1 = cx4
        t = u
        out = out ++ [TListIfArm { cond: cndx, body: bx }]
      }
      (cx1, t, TLEIf(out))
    }
  }
}

fn check_expr_at(cx: Cx, e: Expr, expected: Option[Ty]) -> (Cx, Ty, TExpr) !io =
  match e {
    EInt(v, lo, hi) -> (cx, TyInt, XInt(v, lo, hi))
    EChar(v, lo, hi) -> (cx, ty_char(), XChar(v, lo, hi))
    EFloat(v, lo, hi) -> (cx, TyFloat, XFloat(v, lo, hi))
    EBool(v, lo, hi) -> (cx, TyBool, XBool(v, lo, hi))
    EUnit(lo, hi) -> (cx, TyUnit, XUnit(lo, hi))
    EStr(parts, lo, hi) -> {
      var cx1 = cx
      var tparts: List[TStrPart] = []
      for pt in parts {
        match pt {
          SPText(v) -> { tparts = tparts ++ [TSPText(v)] }
          SPInterp(x) -> {
            let (cx2, t, tx) = check_expr(cx1, x, no_expected())
            cx1 = cx2
            # `${x}` is `show(x)` with the quoting undone at the top level, so
            # it asks for the same witness `to_string` does
            let (cx3, w) = resolve_witness(cx1, SHOW_ID, t, e_lo(x), e_hi(x), "interpolation")
            cx1 = cx3
            tparts = tparts ++ [TSPInterp(tx, w)]
          }
        }
      }
      (cx1, TyString, XStr(tparts, lo, hi))
    }
    EVar(name, lo, hi) -> check_var(cx, name, expected, lo, hi)
    EUnary(op, operand, lo, hi) -> {
      let (cx1, t, tx) = check_expr(cx, operand, no_expected())
      check_unary(cx1, op, t, tx, e_lo(operand), e_hi(operand), lo, hi)
    }
    EBinary(op, left, right, olo, ohi, lo, hi) -> {
      let (cx1, lt, lx) = check_expr(cx, left, no_expected())
      # == seeds the right side with the left side's type
      let eq_like = op == OpEq || op == OpNeq
      let rexp: Option[Ty] = if eq_like && is_concrete(cx1, lt) { Some(lt) } else { None }
      let (cx2, rt, rx) = check_expr(cx1, right, rexp)
      check_binary_typed(cx2, op, lt, rt, lx, rx,
        e_lo(left), e_hi(left), e_lo(right), e_hi(right), olo, ohi, lo, hi)
    }
    EIf(cond, thn, els, lo, hi) -> {
      let (cx1, ct, cndx) = check_expr(cx, cond, no_expected())
      var cx2 = cx1
      if ct != TyBool && not is_errorish(ct) {
        cx2 = cerr(cx2, "if condition must be Bool, got " ++ ty_show(cx2.adts, ct),
          e_lo(cond), e_hi(cond))
      }
      let (cx3, tt, thnx) = check_expr(cx2, thn, expected)
      match els {
        None -> {
          # no else: statement position only, branch must be Unit
          var cx4 = cx3
          if tt != TyUnit && not is_errorish(tt) {
            cx4 = cerr_h(cx4, "an if without else is a statement, so its branch must be Unit (got " ++
                ty_show(cx4.adts, tt) ++ ")", e_lo(thn), e_hi(thn),
              "add an else branch to produce a value")
          }
          (cx4, TyUnit, XIf(cndx, thnx, None, lo, hi, TyUnit))
        }
        Some(eb) -> {
          let (cx4, et, ex) = check_expr(cx3, eb, expected)
          let (cx5, t) = unify_branches(cx4, tt, et, lo, hi, "the if branches")
          (cx5, t, XIf(cndx, thnx, Some(ex), lo, hi, t))
        }
      }
    }
    EListLit(elems, lo, hi) -> {
      let expected_elem: Option[Ty] = match expected {
        Some(TyList(el)) -> if is_concrete(cx, el) { Some(el) } else { None }
        _ -> None
      }
      if len(elems) == 0 {
        match expected_elem {
          Some(el) -> return (cx, TyList(el), XListLit([], lo, hi, TyList(el)))
          None -> return (cerr_h(cx, "cannot infer the element type of an empty list", lo, hi,
            "add a type annotation: let xs: List[Int] = []"), TyError, XError(lo, hi))
        }
      }
      var elem_t = match expected_elem {
        Some(el) -> el
        None -> TyNever
      }
      # inference-needing elements (bare None, nested []) go last; the typed
      # nodes must come back in source order. The nodes are collected in check
      # order and put back in one pass at the end: `order` is two ascending
      # runs, so a walk over the elements takes from the run that claimed each
      # position. Assigning into a slot list as the nodes arrive is what this
      # replaces, and that rebuilt the whole list per element.
      var defer_at: List[Bool] = []
      var order: List[Int] = []
      var i = 0
      for x in elems {
        let d = needs_expected_elem(cx, x)
        defer_at = defer_at ++ [d]
        if not d { order = order ++ [i] }
        i = i + 1
      }
      let ready_n = len(order)
      i = 0
      for d in defer_at {
        if d { order = order ++ [i] }
        i = i + 1
      }
      var cx1 = cx
      var checked: List[TListElem] = []
      for idx in order {
        let x = elems[idx]
        let (cx2, t, tx) = check_list_elem(cx1, x, elem_t)
        cx1 = cx2
        let (cx3, unified) =
          unify_branches(cx1, elem_t, t, le_lo(x), le_hi(x), "the list elements")
        cx1 = cx3
        elem_t = unified
        checked = checked ++ [tx]
      }
      var txs: List[TListElem] = []
      var ri = 0
      var di = ready_n
      for d in defer_at {
        if d {
          txs = txs ++ [checked[di]]
          di = di + 1
        } else {
          txs = txs ++ [checked[ri]]
          ri = ri + 1
        }
      }
      (cx1, TyList(elem_t), XListLit(txs, lo, hi, TyList(elem_t)))
    }
    ETupleLit(elems, lo, hi) -> {
      let exps: Option[List[Ty]] = match expected {
        Some(TyTuple(ets)) -> Some(ets)
        _ -> None
      }
      var cx1 = cx
      var tys: List[Ty] = []
      var txs: List[TExpr] = []
      var i = 0
      for x in elems {
        let el_exp: Option[Ty] = match exps {
          Some(ets) ->
            match get(ets, i) {
              Some(et) -> if is_concrete(cx1, et) { Some(et) } else { None }
              None -> None
            }
          None -> None
        }
        let (cx2, t, tx) = check_expr(cx1, x, el_exp)
        cx1 = cx2
        tys = tys ++ [t]
        txs = txs ++ [tx]
        i = i + 1
      }
      (cx1, TyTuple(tys), XTupleLit(txs, lo, hi, TyTuple(tys)))
    }
    EPropagate(operand, lo, hi) -> {
      let (cx1, ot, ox) = check_expr(cx, operand, no_expected())
      check_propagate_typed(cx1, ot, ox, lo, hi)
    }
    EUnwrap(operand, lo, hi) -> {
      let (cx1, ot, ox) = check_expr(cx, operand, no_expected())
      let msg = unwrap_msg(cx1, operand, lo, hi)
      check_unwrap_typed(cx1, ot, ox, msg, lo, hi)
    }
    # `c[i]` (spec §4.8). The subject used to be matched against a two-arm
    # list of the types the compiler had heard of; now it is one witness, so a
    # user type joins by writing `impl Index`. `Idx` and `Item` are read off
    # the same impl the witness names -- reduced when the subject is concrete,
    # left as projections when it is a rigid parameter, which is exactly what
    # a projection in a parameter position is for (#119 D6).
    EIndex(target, index, lo, hi) -> {
      let (cx1, tt, tx) = check_expr(cx, target, no_expected())
      if is_errorish(tt) {
        let (cx2, _, _) = check_expr(cx1, index, no_expected())
        return (cx2, TyError, XError(lo, hi))
      }
      # A ground subject with no impl keeps its own message. The general one
      # ("no impl of `Index` for `Bool`") is true but drops the hint that
      # matters most here -- that absence has an answer, and it is `get`.
      if is_ground(tt) && not has_index_impl(cx1, tt) {
        let cx2 = cerr_h(cx1,
          "`[]` needs an `Index` impl for `" ++ ty_show(cx1.adts, tt) ++ "`", lo, hi,
          "List and Map have one; when absence is a normal case, " ++
            "use get(xs, i) / map.get(m, k)")
        let (cx3, _, _) = check_expr(cx2, index, no_expected())
        return (cx3, TyError, XError(lo, hi))
      }
      let (cx2, w) = resolve_witness(cx1, INDEX_ID, tt, lo, hi,
        "indexing a " ++ ty_show(cx1.adts, tt))
      match w {
        None -> {
          let (cx3, _, _) = check_expr(cx2, index, no_expected())
          (cx3, TyError, XError(lo, hi))
        }
        Some(wr) -> {
          let want_idx = reduce_assoc(cx2, TyAssoc(tt, INDEX_ID, "Idx"))
          let result = reduce_assoc(cx2, TyAssoc(tt, INDEX_ID, "Item"))
          let (cx3, it, ix) = check_expr(cx2, index, Some(want_idx))
          if it != want_idx && not is_errorish(it) {
            (cerr(cx3, "this index must be `" ++ ty_show(cx3.adts, want_idx) ++
                "`, got `" ++ ty_show(cx3.adts, it) ++ "`",
              e_lo(index), e_hi(index)), TyError, XError(lo, hi))
          } else {
            (cx3, result, XIndex(tx, ix, wr, lo, hi, result))
          }
        }
      }
    }
    EReturn(v, lo, hi) -> {
      let (cx1, target) = return_target(cx, lo, hi)
      match target {
        None -> {
          match v {
            Some(x) -> {
              let (cx2, _, _) = check_expr(cx1, x, no_expected())
              (cx2, TyError, XError(lo, hi))
            }
            None -> (cx1, TyError, XError(lo, hi))
          }
        }
        Some(t) -> {
          let (cx2, vt, vx) = match v {
            Some(x) -> {
              let (cxa, xt, xx) = check_expr(cx1, x, Some(t))
              (cxa, xt, Some(xx))
            }
            None -> (cx1, TyUnit, no_texpr())
          }
          var cx3 = cx2
          if not assignable(cx3, vt, t) {
            let (slo, shi) = match v {
              Some(x) -> (e_lo(x), e_hi(x))
              None -> (lo, hi)
            }
            cx3 = cerr(cx3, "`return` type mismatch: this function returns " ++
                ty_show(cx3.adts, t) ++ ", got " ++ ty_show(cx3.adts, vt), slo, shi)
          }
          (cx3, TyNever, XReturn(vx, lo, hi))
        }
      }
    }
    EBreak(lo, hi) -> {
      let (cx1, ok) = check_loop_jump(cx, "break", lo, hi)
      if ok { (cx1, TyNever, XBreak(lo, hi)) } else { (cx1, TyError, XError(lo, hi)) }
    }
    EContinue(lo, hi) -> {
      let (cx1, ok) = check_loop_jump(cx, "continue", lo, hi)
      if ok { (cx1, TyNever, XContinue(lo, hi)) } else { (cx1, TyError, XError(lo, hi)) }
    }
    EBlock(stmts, tail, lo, hi) -> check_block(cx, stmts, tail, expected, lo, hi)
    EHandle(name, arms, rest, nlo, nhi, lo, hi) ->
      check_handle(cx, name, arms, rest, nlo, nhi, lo, hi, expected)
    EComptime(body, lo, hi) -> {
      let (cx1, frame) = enter_isolated(cx)
      let (cx2, t, bx) = check_expr(cx1, body, expected)
      let cx3 = leave_isolated(cx2, frame, "comptime blocks", e_lo(body), e_hi(body))
      if not is_const_serializable(cx3, t, set.empty()) && not is_errorish(t) {
        (cerr_h(cx3, "a comptime result must be constant-serializable, got " ++
            ty_show(cx3.adts, t), lo, hi,
          "Int/Float/Bool/String/Unit and List/tuple/record/ADT values of them (spec §7.2)"),
          TyError, XError(lo, hi))
      } else {
        (cx3, t, XComptime(bx, lo, hi, t))
      }
    }
    EUnsafePure(body, lo, hi) -> check_unsafe_pure(cx, body, expected, lo, hi)
    ECtor(cname, cargs, spread, has_braces, cclo, cchi, lo, hi) ->
      # the ECtor node itself is only ever a head: bare, or the braced record
      # literal. The parenthesised spelling is an EApply over the bare head and
      # reaches check_ctor_call from check_apply, tagged CApply.
      check_ctor_call(cx, cname, cargs, spread, if has_braces { CBraces } else { CBare },
        expected, None, cclo, cchi, lo, hi)
    ELambda(params, body, sugar, lo, hi) ->
      check_lambda(cx, params, body, sugar, false, expected, lo, hi)
    EApply(target, args, lo, hi) -> check_apply(cx, target, args, expected, lo, hi)
    EMethod(target, name, args, nlo, nhi, lo, hi) ->
      check_method_call(cx, target, name, args, expected, nlo, nhi, lo, hi)
    EFieldAcc(target, fname, flo, fhi, lo, hi) ->
      # `m.NAME` where `m` is a whole-module alias: a qualified constant
      # (LANG-06 step 3). Checked before the Java and value paths because a
      # module alias is not a value -- spec 10.3 forbids anything else of that
      # name being in scope, so there is nothing to be ambiguous with.
      match qual_const(cx, target, fname) {
        Some(pr) -> {
          let (mod_path, ct) = pr
          (cx, ct, XConstRef(mod_path, fname, lo, hi, ct))
        }
        None ->
          # `m.C` with no arguments: a nullary constructor's value, or -- in a
          # function-typed position -- the constructor as a function. Decided
          # by the same code the unqualified spelling goes through, with the
          # constructor already resolved through the alias.
          match qual_ctor(cx, target, fname) {
            Some(k) -> {
              let no_args: List[Arg] = []
              check_ctor_call(cx, fname, no_args, None, CBare, expected, Some(k),
                flo, fhi, lo, hi)
            }
            None ->
              match static_field_target(cx, target) {
                # Class.FIELD reads a public static field (spec §9.1) — the receiver
                # is a java class name (a nullary ctor spelling), not an evaluable
                # expression
                Some(fq) -> check_java_static_field(cx, fq, fname, flo, fhi, lo, hi)
                None -> {
                  # a bare name that is not a value: the module readings, which
                  # the value path below can only call an undefined variable
                  match target {
                    EVar(q, qlo, qhi) ->
                      if not resolves_to_value(cx, q) {
                        match map.get(cx.module_exports, q) {
                          Some(exp) ->
                            return (qual_value_err(cx, exp, fname, flo, fhi),
                              TyError, XError(lo, hi))
                          None ->
                            if not map.has(cx.module_aliases, q) {
                              return (undefined_qualifier_err(cx, q, qlo, qhi),
                                TyError, XError(lo, hi))
                            }
                        }
                      }
                    _ -> ()
                  }
                  let (cx1, tt, tx) = check_expr(cx, target, no_expected())
                  check_field_access_typed(cx1, tt, tx, fname, flo, fhi, lo, hi)
                }
              }
          }
      }
    EMatch(scrut, arms, lo, hi) -> check_match(cx, scrut, arms, expected, lo, hi)
  }

fn no_expected() -> Option[Ty] = None

fn no_texpr() -> Option[TExpr] = None

## The panic message for `expr!` (the Kotlin unwrapMsg): names the producing
## call and the site, since codegen has neither source text nor line numbers.
fn unwrap_msg(cx: Cx, operand: Expr, lo: Int, hi: Int) -> String = {
  var msg = "unwrapped None"
  let desc: Option[String] = match operand {
    EMethod(recv, mname, _, _, _, _, _) ->
      match recv {
        ECtor(rname, _, _, _, _, _, _, _) -> Some(rname ++ "." ++ mname ++ "()")
        EVar(rname, _, _) -> Some(rname ++ "." ++ mname ++ "()")
        _ -> Some(mname ++ "()")
      }
    # a named call: `f(x)!`. A construction (`Some(x)!`) is also an EApply now,
    # and deliberately not named here -- the panic text stays what it was.
    EApply(EVar(callee, _, _), _, _, _) -> Some(callee ++ "()")
    _ -> None
  }
  match desc {
    Some(d) -> { msg = msg ++ " from " ++ d }
    None -> ()
  }
  match cx.src_path {
    Some(p) -> { msg = msg ++ " at " ++ p ++ ":" ++ to_string(line_of(cx, lo)) }
    None -> ()
  }
  msg
}

## 1-based line number of a code-point offset in the current source (set by the
## driver; the Kotlin SourceFile.lineOf). Line starts and offsets share the same
## code-point currency, so the line number is unit-invariant.
fn line_of(cx: Cx, off: Int) -> Int = {
  var line = 1
  for s in cx.line_starts {
    if s <= off && s > 0 { line = line + 1 }
  }
  line
}

# ---- name resolution with capture bookkeeping ----

fn no_int() -> Option[Int] = None

fn no_wit() -> Option[WitRef] = None

fn is_tyvar(t: Ty) -> Bool =
  match t {
    TyVar(_, _) -> true
    _ -> false
  }

fn is_tuple_ty(t: Ty) -> Bool =
  match t {
    TyTuple(_) -> true
    _ -> false
  }

fn is_list_ty(t: Ty) -> Bool =
  match t {
    TyList(_) -> true
    _ -> false
  }

fn is_java_node(x: TExpr) -> Bool =
  match x {
    XJava(_, _, _, _) -> true
    _ -> false
  }

## Find a name in the scope stack with lambda-capture bookkeeping (the Kotlin
## resolveLocal): a hit below a lambda boundary is captured by value into every
## crossing lambda; `var` bindings refuse to cross, and assignment never does.
##
## **Evidence is the one kind of name that crosses without being captured**
## (`Sym.ev_of`). Rule 乙 was exactly this line: a `with handle`'s record and a
## signature's hidden slots are ordinary locals, so an operation raised inside a
## lambda welded the handler in scope at the lambda's *creation* point into its
## capture list, and the closure kept answering to that handler wherever it was
## later run. Severing it here is the whole semantic flip: the label stays in
## the closure's row, so the call that runs the closure owes the evidence, and
## the closure reads it out of its own pack (`ev_expr`, `tast.XEvRead`).
##
## The test is the symbol's flag rather than its name because there are three
## spellings (`ev_local_name`, `ev_var_local_name`, `ev_assoc_local_name`) and
## a fourth would be caught by nothing. It is placed on the capture arm and not
## at the top so that a `var` refusal and an assignment refusal still read the
## same for an evidence name -- neither can happen, since nothing can name one,
## but the arm that is skipped should be exactly the arm that is wrong.
pub fn resolve_local(
  cx: Cx,
  name: String,
  lo: Int,
  hi: Int,
  for_assign: Bool
) -> (Cx, Option[Int]) = {
  var i = len(cx.frame.scopes) - 1
  while i >= 0 {
    match map.get(cx.frame.scopes[i], name) {
      Some(id) -> {
        let sym = sym_of(cx, id)
        var cx1 = cx
        var stack: List[LambdaCx] = []
        for lc in cx1.frame.lambda_stack {
          if i < lc.boundary {
            if for_assign {
              let (msg, hint) = assign_across_msg(lc, name)
              cx1 = cerr_h(cx1, msg, lo, hi, hint)
              stack = stack ++ [lc]
            } else if sym.mutable {
              let (msg, hint) = capture_var_msg(lc)
              cx1 = cerr_h(cx1, msg, lo, hi, hint)
              stack = stack ++ [lc]
            } else if sym.ev_of != None {
              # evidence does not join a capture list -- see the note above
              stack = stack ++ [lc]
            } else {
              var caps = lc.captures
              var have = false
              for c in caps {
                if c == id { have = true }
              }
              if not have { caps = caps ++ [id] }
              stack = stack ++ [LambdaCx { ..lc, captures: caps }]
            }
          } else {
            stack = stack ++ [lc]
          }
        }
        cx1 = Cx { ..cx1, frame: Frame { ..cx1.frame, lambda_stack: stack } }
        return (cx1, Some(id))
      }
      None -> ()
    }
    i = i - 1
  }
  (cx, None)
}

## The hint for a name that used to exist: where it moved (the v0.5.0 flat
## spellings, populated by the std loader, plus the intrinsics std has since
## taken over), else did-you-mean. No version in the message -- the names in
## that map left at different times.
pub fn moved_or_suggest(cx: Cx, name: String, pool: List[String]) -> Option[String] =
  match map.get(cx.moved, name) {
    Some(w) -> Some("`" ++ name ++ "` is not a builtin; " ++ w)
    None -> suggest.hint(name, pool)
  }

## A variable read: a local (with capture bookkeeping), else a top-level fn or
## builtin used as a value, else undefined.
fn check_var(cx: Cx, name: String, expected: Option[Ty], lo: Int, hi: Int) -> (Cx, Ty, TExpr) = {
  let (cx1, found) = resolve_local(cx, name, lo, hi, false)
  match found {
    Some(id) -> {
      let sym = sym_of(cx1, id)
      (cx1, sym.ty, XLocal(id, name, lo, hi, sym.ty))
    }
    None -> {
      match lookup_fn_sig(cx1, name) {
        Some(s) -> check_fn_value(cx1, name, s, expected, lo, hi)
        None ->
          (cerr_o(cx1, "undefined variable: " ++ name, lo, hi,
            moved_or_suggest(cx1, name, local_names(cx1) ++ fn_pool(cx1))),
            TyError, XError(lo, hi))
      }
    }
  }
}

# ---- unsafe_pure ----

## unsafe_pure { body } (docs/pure-ffi-design.md §3.2): the body checks as
## usual — locals stay in scope — but its effects are captured in isolation.
## Concrete io is masked to Pure; an effect variable is rejected; a body that
## did no io at all flags the stamp as redundant.
##
## std-only (LANG-01, docs/audit/purity-boundary-design.md step 1): the stamp
## unconditionally erases an effect the checker proved, and everything purity
## licenses — folding, reordering, dropping a call — believes it. That is a
## soundness escape hatch, and design.md's original ruling was that it does
## not open to user code. std is the one place a wrapper over a host call is
## reviewed, versioned and differentially tested with the compiler itself;
## nothing outside std uses the stamp today (ecosystem scanned 2026-07-30).
fn check_unsafe_pure(cx: Cx, body: Expr, expected: Option[Ty], lo: Int, hi: Int) -> (Cx, Ty, TExpr) !io = {
  if not cx.is_std_module {
    let (cxe, t0, bx0) = check_expr(cx, body, expected)
    return (cerr_h(cxe, "unsafe_pure is not available in user code", lo, hi,
      "the stamp erases a proven io effect, and everything purity licenses believes it; " ++
        "declare the function !io, or — if the computation truly is pure — ask for a std " ++
        "function (docs/audit/purity-boundary-design.md)"), t0, bx0)
  }
  let saved_used = cx.frame.used_effects
  let saved_wit = cx.frame.eff_witness
  let empty_w: Map[Eff, (Int, Int, String)] = map.empty()
  let cx0 = Cx { ..cx, frame: Frame { ..cx.frame, used_effects: [], eff_witness: empty_w } }
  let (cx1, t, bx) = check_expr(cx0, body, expected)
  let inner = cx1.frame.used_effects
  var cx2 = Cx { ..cx1, frame: Frame { ..cx1.frame, used_effects: saved_used, eff_witness: saved_wit } }
  # the stamp vouches that a concrete io effect is absent, and that is all it
  # can vouch for: a declared effect is served by evidence, and masking it
  # would leave a call with a parameter nothing fills (design §4.5)
  for u in inner {
    let ls = eff_labels(u)
    if len(ls) > 0 {
      let (wlo, whi, wname) = match map.get(cx1.frame.eff_witness, u) {
        Some(w) -> w
        None -> (lo, hi, "?")
      }
      cx2 = record_effect(cx2, eff_with_labels(EPure, ls), wlo, whi, wname)
    }
  }
  var poly: Option[Eff] = None
  for u in inner {
    match u {
      EffVar(_, _) -> if poly == None { poly = Some(u) }
      EUnion(_, _, _) -> if poly == None { poly = Some(u) }
      EffAssoc(_, _, _, _) -> if poly == None { poly = Some(u) }
      _ -> ()
    }
  }
  match poly {
    Some(p) -> {
      cx2 = cerr_h(cx2, "unsafe_pure cannot mask the effect variable !" ++ eff_show(p) ++
          " — it only vouches that a concrete io effect is absent", lo, hi,
        "the block calls an effect-polymorphic function (e.g. a higher-order `map`/`fold`); " ++
          "rewrite it as pure Dawn recursion over first-order pure primitives (docs/pure-ffi-design.md §3.3)")
    }
    None -> {
      var has_io = false
      for u in inner {
        if u == EIo { has_io = true }
      }
      if not has_io && not is_errorish(t) {
        cx2 = cerr_h(cx2, "redundant unsafe_pure: the block is already pure", lo, hi,
          "drop `unsafe_pure { … }` and keep the inner expression — the stamp is only for vouching " ++
            "a Java interop call the effect checker would otherwise flag !io")
      }
    }
  }
  # masked: the body's io is deliberately not folded back into the saved record
  (cx2, t, XUnsafePure(bx, lo, hi, t))
}

# ---- lambdas and application ----

## `settled_arm_eff` and `settle_lambda_eff` stood here: a closure's row,
## rewritten at its creation point, with a label answered by a `with handle` in
## the same body swapped for that handler's arm effects. Their argument was that
## the subtraction and the capture happened at the same node, so the label could
## not be charged to the wrong function.
##
## There is no capture to happen at the same node any more. A closure's row is
## whatever its body raised, full stop; the label leaves it at the call that
## supplies the evidence, which is `check_handle`'s remainder call and nowhere
## else. What used to be "this closure was built under a pure arm, so it is
## pure" is now "this closure raises !Ask, and whoever runs it says which
## handler answers" -- a different program with a different transcript
## (scripts/spike-native/effect_lexical.expect), and the point of the knife.

fn check_lambda(
  cx: Cx,
  params: List[LambdaParam],
  body: Expr,
  sugar: Bool,
  arm: Bool,
  expected: Option[Ty],
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  var cx1 = cx
  var have_exp = false
  var eps: List[Ty] = []
  var eret = TyUnit
  var eeff = EPure
  match expected {
    Some(TyFn(ps, r, ef)) -> {
      have_exp = true
      eps = ps
      eret = r
      eeff = ef
    }
    _ -> ()
  }
  # An arm's arity is checked against the operation it answers, and `check_handle`
  # has already said so in those terms; a second line naming "this lambda" would
  # point at a closure the author did not write.
  if have_exp && len(eps) != len(params) && not arm {
    let want = ty_show(cx1.adts, TyFn(eps, eret, eeff))
    let n = to_string(len(params))
    if sugar {
      cx1 = cerr_h(cx1, "the closure `with` introduced takes " ++ n ++ " parameter(s), but " ++
          want ++ " is expected", lo, hi,
        "`with` binds the names before `<-`, one per parameter")
    } else {
      cx1 = cerr(cx1, "this lambda takes " ++ n ++ " parameter(s), but " ++ want ++
          " is expected", lo, hi)
    }
  }
  var ptys: List[Ty] = []
  var i = 0
  for p in params {
    var t = TyError
    var have = false
    match p.ann {
      Some(ref) -> {
        let (cxa, tt) = resolve_type(cx1, ref)
        cx1 = cxa
        t = tt
        have = true
      }
      None -> ()
    }
    if not have && have_exp {
      # take the parameter type from the expected fn type; an enclosing
      # function's type parameter (a TyVar) is a legitimate opaque type here
      match get(eps, i) {
        Some(et) ->
          if is_concrete(cx1, et) || is_tyvar(et) {
            t = et
            have = true
          }
        None -> ()
      }
    }
    if not have {
      cx1 = cerr_h(cx1, "cannot infer the type of `" ++ p.name ++ "`", p.lo, p.hi,
        "annotate it: (" ++ p.name ++ ": Int) => ...")
      t = TyError
    }
    ptys = ptys ++ [t]
    i = i + 1
  }
  # the lambda's effects are its own — they happen when it is called
  let saved_used = cx1.frame.used_effects
  let saved_wit = cx1.frame.eff_witness
  let empty_w: Map[Eff, (Int, Int, String)] = map.empty()
  let exp_ret: Option[Ty] =
    if have_exp && is_concrete(cx1, eret) { Some(eret) } else { None }
  let ctx =
    LambdaCx {
      boundary: len(cx1.frame.scopes),
      expected_ret: exp_ret,
      captures: [],
      sugar: sugar,
      arm: arm
    }
  cx1 = Cx {
    ..cx1,
    frame: Frame {
      ..cx1.frame,
      used_effects: [],
      eff_witness: empty_w,
      lambda_stack: cx1.frame.lambda_stack ++ [ctx]
    }
  }
  cx1 = push_scope(cx1)
  var psyms: List[Int] = []
  var pnames: List[String] = []
  var j = 0
  for p in params {
    let (cxa, sid) = declare(cx1, p.name, ptys[j], false, p.lo, p.hi)
    cx1 = cxa
    psyms = psyms ++ [sid]
    pnames = pnames ++ [p.name]
    j = j + 1
  }
  let (cx2, bt, bx) = check_expr(cx1, body, exp_ret)
  var cx3 = pop_scope(cx2)
  let popped = cx3.frame.lambda_stack[len(cx3.frame.lambda_stack) - 1]
  let outer_lams = list.take(cx3.frame.lambda_stack, len(cx3.frame.lambda_stack) - 1)
  cx3 = Cx { ..cx3, frame: Frame { ..cx3.frame, lambda_stack: outer_lams } }
  # the closure's row is what its body raised, unrewritten: nothing this body
  # resolved can take a label off, because nothing this body resolved is
  # travelling with the closure
  let lam_eff = eff_union(cx3.frame.used_effects)
  cx3 = Cx { ..cx3, frame: Frame { ..cx3.frame, used_effects: saved_used, eff_witness: saved_wit } }
  let t = TyFn(ptys, bt, lam_eff)
  (cx3, t, XLambda(psyms, pnames, bx, popped.captures, lo, hi, t))
}

fn fn_ty_parts(t: Ty) -> (List[Ty], Ty, Eff) =
  match t {
    TyFn(ps, r, ef) -> (ps, r, ef)
    _ -> ([], TyError, EPure)
  }

## `with handle E { op(..) => ... }` and the rest of its block
## (docs/effects-design.md §3.3 and §4.3).
##
## Three things happen here and nowhere else.
##
## The arms are checked *before* the evidence is bound, so an arm raising the
## effect it answers reaches the outer handler rather than itself (§4.4).
##
## The remainder is a closure, and **this** is the call that runs it -- so this
## is the call that supplies its evidence: a pack of `E`'s record consed over
## whatever else is in scope. That is why the block is charged with the
## remainder's effects *minus* E again. Subtraction and supply are the same
## call now, and being the same call is the whole argument: a label can only be
## taken off a row by the site that answered it, so it cannot be taken off by a
## handler that did not.
##
## (The comment here used to argue the opposite, and it was right about the
## code it described: while the remainder *captured* the evidence, subtracting
## here would have been subtracting in the consuming half of a thing whose
## producing half was the capture, and a closure over one handler's evidence
## could have had its label taken off by a different one. There is no capture
## to be the producing half of any more.)
##
## And the record gets one more field than the effect declared operations: the
## environment the arms will run in (`passes.dawn`'s `env`). An arm is a
## closure, so it has exactly one evidence slot, and what goes in it is decided
## here rather than at the raise site.
fn check_handle(
  cx: Cx,
  name: String,
  arms: List[HandlerArm],
  rest: Expr,
  nlo: Int,
  nhi: Int,
  lo: Int,
  hi: Int,
  expected: Option[Ty]
) -> (Cx, Ty, TExpr) !io = {
  var cx1 = cx
  if cx1.frame.isolated {
    cx1 = cerr_h(cx1, "`with handle` is not available at compile time", lo, hi,
      "comptime blocks and const initializers are pure in v1 " ++
        "(docs/effects-design.md §4.5)")
  }
  let eid = match map.get(cx1.effects, name) {
    Some(id) -> id
    None -> {
      cx1 = cerr_o(cx1, "unknown effect `" ++ name ++ "`", nlo, nhi,
        suggest.hint(name, map.keys(cx1.effects)))
      var cxr0 = cx1
      let (cxr, rt, rx) = check_expr(cxr0, rest, rest_expected(expected))
      cxr0 = cxr
      let (_, rret, reff0) = fn_ty_parts(rt)
      let (cxr1, revs0, _) = evidence_pack(cxr0, reff0, false, lo, hi)
      return (cxr1, rret, XApply(rx, [], [revs0], lo, hi, rret))
    }
  }
  let info = effect_of(cx1, eid)
  let rec = adt_of(cx1.adts, eid).ctors[0]
  # one arm per declared operation: no fewer, no more, none unknown
  var chosen: List[Option[HandlerArm]] = []
  for _o in info.ops { chosen = chosen ++ [no_arm()] }
  for a in arms {
    match op_index(info.ops, a.name) {
      None -> {
        cx1 = cerr_o(cx1, "`" ++ a.name ++ "` is not an operation of effect `" ++ name ++ "`",
          a.nlo, a.nhi, suggest.hint(a.name, info.ops))
      }
      Some(idx) ->
        match chosen[idx] {
          Some(_) -> {
            cx1 = cerr(cx1, "operation `" ++ a.name ++ "` is answered twice", a.nlo, a.nhi)
          }
          None -> { chosen = list.take(chosen, idx) ++ [Some(a)] ++ list.drop(chosen, idx + 1) }
        }
    }
  }
  var missing: List[String] = []
  var i = 0
  for o in info.ops {
    match chosen[i] {
      None -> { missing = missing ++ [o] }
      Some(_) -> ()
    }
    i = i + 1
  }
  if len(missing) > 0 {
    cx1 = cerr_h(cx1, "handler for `" ++ name ++ "` does not answer " ++
        join(map(missing, o => "`" ++ o ++ "`"), ", "), nlo, nhi,
      "a handler answers every operation its effect declares")
  }
  # the arms, each against the operation's own signature. Their own effects
  # are charged to this block: an arm's body runs where the handler was
  # installed, not where the operation was raised
  var arm_nodes: List[TExpr] = []
  var slots: List[Option[Int]] = []
  # ... and charged to any closure this handler's evidence ends up inside, which
  # is what makes an escaping closure's type say what it will actually run
  # (docs/effects-soundness-design.md §4.2)
  var arms_eff = EPure
  var k = 0
  for o in info.ops {
    let field = rec.fields[k]
    let (fptys, fret, _) = fn_ty_parts(field.ty)
    let node = match chosen[k] {
      None -> XError(nlo, nhi)
      Some(a) -> {
        var cxa = cx1
        if len(a.params) != len(fptys) {
          cxa = cerr_h(cxa, "arm `" ++ a.name ++ "` takes " ++ to_string(len(a.params)) ++
              " parameter(s), but operation `" ++ a.name ++ "` declares " ++
              to_string(len(fptys)), a.nlo, a.nhi,
            "the arm is the operation's body: " ++ ty_show(cxa.adts, field.ty))
        }
        let (cxb, at, ax) = check_lambda(cxa, a.params, a.body, true, true,
          Some(field.ty), a.lo, a.hi)
        cxa = cxb
        let (_, aret, aeff) = fn_ty_parts(at)
        if not assignable(cxa, aret, fret) {
          cxa = cerr(cxa, "arm `" ++ a.name ++ "` returns " ++ ty_show(cxa.adts, aret) ++
              " but operation `" ++ a.name ++ "` declares " ++ ty_show(cxa.adts, fret),
            e_lo(a.body), e_hi(a.body))
        }
        cxa = record_effect(cxa, aeff, a.nlo, a.nhi, a.name)
        arms_eff = eff_union([arms_eff, aeff])
        cx1 = cxa
        ax
      }
    }
    arm_nodes = arm_nodes ++ [node]
    slots = slots ++ [Some(k)]
    k = k + 1
  }
  # **The environment the arms run in**, snapshotted here, before `E`'s own
  # evidence is bound -- an arm does not answer itself, and this is the same
  # `before` that the arms were checked in. What the arms need is what they
  # raise, so the row to pack is `arms_eff`. It reports nothing: an arm raising
  # something unanswerable already said so, inside the arm.
  let (cx1b, arm_env, _) = evidence_pack(cx1, arms_eff, false, lo, hi)
  cx1 = cx1b
  let ev_ty = TyAdt(eid, [])
  let ev_node = XCtor(eid, 0, arm_nodes ++ [arm_env], slots ++ [Some(len(slots))],
    no_expr(), lo, hi, ev_ty)
  # the evidence is in scope for the remainder only, which is exactly the
  # region `handle` claims
  cx1 = push_scope(cx1)
  let ev_name = ev_local_name(cx1, eid)
  let (cx2, ev_sym) = declare_evidence(cx1, ev_name, ev_ty, label_key(eid), nlo, nhi)
  cx1 = cx2
  let (cx3, rt, rx) = check_expr(cx1, rest, rest_expected(expected))
  cx1 = cx3
  let (_, rret, reff) = fn_ty_parts(rt)
  # the pack the remainder is run with: built while `E`'s record is still in
  # scope, because it is the thing being handed over
  let (cx4, revs, _) = evidence_pack(cx1, reff, false, lo, hi)
  cx1 = pop_scope(cx4)
  # ... and the block is charged with what the remainder does *minus* E, which
  # this very call just answered
  cx1 = record_effect(cx1, eff_minus(reff, eid), lo, hi, "the block after `with handle`")
  let call = XApply(rx, [], [revs], lo, hi, rret)
  (cx1, rret,
    XBlock([TSLet(Some(ev_sym), ev_name, ev_node, lo, hi)], Some(call), lo, hi, rret))
}

## A row without one label. `eff_drop` takes a list; this is its one-label
## caller, and it exists so that the subtraction `with handle` performs is
## spelled where the supply is rather than folded into a list literal.
fn eff_minus(e: Eff, eid: Int) -> Eff = eff_drop(e, [eid])

fn no_arm() -> Option[HandlerArm] = None

fn no_expr() -> Option[TExpr] = None

## The remainder closure takes no parameters and hands back the block's value,
## so an expected type for the block is an expected type for the closure.
fn rest_expected(expected: Option[Ty]) -> Option[Ty] =
  match expected {
    Some(t) -> Some(TyFn([], t, EPure))
    None -> None
  }

fn op_index(ops: List[String], name: String) -> Option[Int] = {
  var i = 0
  for o in ops {
    if o == name { return Some(i) }
    i = i + 1
  }
  None
}

fn named_arg_hint() -> String =
  "pass the arguments by position"

fn fn_value_named_arg_msg(name: String) -> String =
  "`" ++ name ++ "` is a function value, and a function type carries no parameter names"

fn java_named_arg_msg(name: String) -> String =
  "`" ++ name ++ "` is a Java member; Java methods carry no parameter names"

## What to say about `f(x: 1)` when the callee cannot take the names. A named
## callee resolves in check_call, where a signature's parameter names are; what
## reaches here is a function *value* or a Java member, and each says what it
## is, because that is the thing the author got wrong.
fn named_arg_msg(cx: Cx, target: Expr) -> String = {
  match target {
    EFieldAcc(recv, fname, _, _, _, _) ->
      match recv {
        ECtor(cn, _, _, _, _, _, _, _) ->
          match static_field_target(cx, recv) {
            Some(_) -> return java_named_arg_msg(cn ++ "." ++ fname)
            None -> ()
          }
        _ -> ()
      }
    _ -> ()
  }
  "this callee is a function value, and a function type carries no parameter names"
}

## Stop a call whose named arguments its callee cannot take: the caller has
## already reported why (one report per call, at the first named argument --
## repeating the same sentence once per argument is noise, not information).
##
## And neither is going on. The names already said the callee cannot be what
## this call needs it to be, so typing the call anyway reports the same mistake
## a second time in different words -- `Integer.MAX_VALUE(cap: 1)` used to say
## both "Java member" and "cannot call a value of type Int". The argument
## subtrees are still visited, so their own errors surface.
fn named_args_stop(cx: Cx, args: List[Arg], lo: Int, hi: Int) -> (Cx, Ty, TExpr) !io = {
  var cx1 = cx
  for e in arg_exprs(args) {
    let (cxa, _, _) = check_expr(cx1, e, no_expected())
    cx1 = cxa
  }
  (cx1, TyError, XError(lo, hi))
}

fn reject_named_args(
  cx: Cx,
  target: Expr,
  args: List[Arg],
  lo: Int,
  hi: Int
) -> Option[(Cx, Ty, TExpr)] !io =
  match first_named(args) {
    None -> None
    Some(a) -> {
      let cxe = cerr_h(cx, named_arg_msg(cx, target), a.lo, a.hi, named_arg_hint())
      Some(named_args_stop(cxe, args, lo, hi))
    }
  }

## `callee(args)` — the one application node, and the four things it can mean
## (docs/audit/application-syntax-design.md §3.2). The parser no longer decides
## any of this: what the callee resolves to does.
##
##   constructor name  -> construction, argument names ACCEPTED (the only place)
##   function name     -> static call (or a local holding a function: XCallDyn)
##   Java member       -> a Java call
##   any expression    -> apply a function value
##
## Argument names outside a construction are a type error here, not a syntax
## error in the parser: the shape is legal, the callee is what makes it wrong.
fn check_apply(
  cx: Cx,
  target: Expr,
  args0: List[Arg],
  expected: Option[Ty],
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  # a constructor: `Circle(1.0)`, `Rect(2.0, h: 3.0)`, or its qualified
  # spelling `m.C(a, b)` (LANG-06). Routed into check_ctor_call so field names,
  # arity, spread and generic instantiation are decided by one implementation.
  match target {
    ECtor(cname, cargs, sp, hp, cclo, cchi, _, _) ->
      if not hp && len(cargs) == 0 && sp == None {
        return check_ctor_call(cx, cname, args0, None, CApply, expected, None, cclo, cchi, lo, hi)
      }
    EFieldAcc(recv, fname, flo, fhi, _, _) ->
      match qual_ctor(cx, recv, fname) {
        # `expected` is deliberately not forwarded here: the qualified spelling
        # has never seen it, and threading it in is an inference change, not
        # part of unifying the syntax.
        Some(k) ->
          return check_ctor_call(cx, fname, args0, None, CApply, no_expected(), Some(k),
            flo, fhi, lo, hi)
        # `recv.member(args)` where the parser could not know `member` names a
        # method: after `.` an UPPERCASE word is EFieldAcc and a lowercase one
        # is EMethod, which made a Java member's ACCESSIBILITY depend on the
        # host's naming style (SYN-09). The call suffix is what distinguishes a
        # member read from a member call, so both spellings go to the same
        # place, and `Class.NAME` / `Class.NAME(args)` can be a field and a
        # method of the same name.
        #
        # A module alias is excluded rather than delegated: `m.CONST(1)` and
        # `m.missing(1)` have Dawn answers (a constant that is not callable, an
        # unexported name) that a Java lookup would overwrite with a worse one.
        None ->
          if not module_alias_receiver(cx, recv) {
            return check_method_call(cx, recv, fname, args0, expected, flo, fhi, lo, hi)
          }
      }
    _ -> ()
  }
  # a name: `f(x)`. check_call keeps the split a name has always had -- a local
  # holding a function value calls dynamically, anything else statically -- and
  # decides whether argument names are usable: they name a signature's
  # parameters, so the static path has them and the dynamic one does not.
  match target {
    EVar(name, vlo, vhi) ->
      return check_call(cx, name, args0, expected, None, no_sig(), vlo, vhi, lo, hi)
    _ -> ()
  }
  # everything below applies a function value, and a function type has no
  # parameter names to give
  match reject_named_args(cx, target, args0, lo, hi) {
    Some(r) -> return r
    None -> ()
  }
  let args = arg_exprs(args0)
  # piping into an unannotated lambda: the arguments determine its parameter types
  var lambda_unannotated = false
  match target {
    ELambda(ps, _, _, _, _) -> {
      for p in ps {
        match p.ann {
          None -> { lambda_unannotated = true }
          Some(_) -> ()
        }
      }
    }
    _ -> ()
  }
  var cx1 = cx
  var pre: Option[List[Ty]] = None
  var pre_txs: List[TExpr] = []
  var ft = TyError
  var fx: TExpr = XError(lo, hi)
  if lambda_unannotated {
    var ats: List[Ty] = []
    for a in args {
      let (cxa, at, ax) = check_expr(cx1, a, no_expected())
      cx1 = cxa
      ats = ats ++ [at]
      pre_txs = pre_txs ++ [ax]
    }
    pre = Some(ats)
    let (cxb, ftt, fxx) = check_expr(cx1, target, Some(TyFn(ats, TyNever, EIo)))
    cx1 = cxb
    ft = ftt
    fx = fxx
  } else {
    let (cxb, ftt, fxx) = check_expr(cx1, target, no_expected())
    cx1 = cxb
    ft = ftt
    fx = fxx
  }
  let pre_none = pre == None
  if is_errorish(ft) {
    if pre_none {
      for a in args {
        let (cxa, _, _) = check_expr(cx1, a, no_expected())
        cx1 = cxa
      }
    }
    return (cx1, TyError, XError(lo, hi))
  }
  var is_fn = false
  var fps: List[Ty] = []
  var fret = TyError
  var feff = EPure
  match ft {
    TyFn(ps, r, ef) -> {
      is_fn = true
      fps = ps
      fret = r
      feff = ef
    }
    _ -> ()
  }
  if not is_fn {
    if pre_none {
      for a in args {
        let (cxa, _, _) = check_expr(cx1, a, no_expected())
        cx1 = cxa
      }
    }
    return (cerr(cx1, "cannot call a value of type " ++ ty_show(cx1.adts, ft),
      e_lo(target), e_hi(target)), TyError, XError(lo, hi))
  }
  if len(args) != len(fps) {
    if pre_none {
      for a in args {
        let (cxa, _, _) = check_expr(cx1, a, no_expected())
        cx1 = cxa
      }
    }
    cx1 = cerr_h(cx1, "this function takes " ++ to_string(len(fps)) ++ " argument(s), got " ++
        to_string(len(args)), lo, hi, "type: " ++ ty_show(cx1.adts, ft))
    return (cx1, fret, XError(lo, hi))
  }
  var txs: List[TExpr] = []
  match pre {
    None -> {
      var i = 0
      for a in args {
        let pt = fps[i]
        let (cxa, at, ax) = check_expr(cx1, a, Some(pt))
        cx1 = cxa
        if not assignable(cx1, at, pt) {
          cx1 = cerr_h(cx1, "argument type mismatch: expected " ++ ty_show(cx1.adts, pt) ++
              ", got " ++ ty_show(cx1.adts, at), e_lo(a), e_hi(a),
            "type: " ++ ty_show(cx1.adts, ft))
        }
        txs = txs ++ [ax]
        i = i + 1
      }
    }
    Some(ats) -> {
      var i = 0
      for at in ats {
        if not assignable(cx1, at, fps[i]) {
          cx1 = cerr_h(cx1, "argument type mismatch: expected " ++ ty_show(cx1.adts, fps[i]) ++
              ", got " ++ ty_show(cx1.adts, at), e_lo(args[i]), e_hi(args[i]),
            "type: " ++ ty_show(cx1.adts, ft))
        }
        i = i + 1
      }
      txs = pre_txs
    }
  }
  # **The call is the supply point.** A function value's row is answered here,
  # not where the closure was written, so this is where the pack is built and
  # where a label nothing can answer is reported. What went unanswered comes
  # out of the row this body is charged with, exactly as `check_call` does for
  # a named callee: one failure, one diagnostic.
  let (cxe, evs, unanswered) = dyn_evidence_args(cx1, feff, e_lo(target), e_hi(target))
  cx1 = cxe
  cx1 = record_effect(cx1, eff_drop(feff, unanswered), e_lo(target), e_hi(target),
    "the applied function")
  (cx1, fret, XApply(fx, txs, evs, lo, hi, fret))
}

# ---- blocks and statements ----

fn check_block(
  cx: Cx,
  stmts: List[Stmt],
  tail: Option[Expr],
  expected: Option[Ty],
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  var cx1 = push_scope(cx)
  var tstmts: List[TStmt] = []
  for s in stmts {
    let (cxa, ts) = check_stmt(cx1, s)
    cx1 = cxa
    tstmts = tstmts ++ [ts]
  }
  var t = TyUnit
  var ttail: Option[TExpr] = None
  var tail_java = false
  match tail {
    Some(x) -> {
      let (cxa, xt, xx) = check_expr(cx1, x, expected)
      cx1 = cxa
      t = xt
      ttail = Some(xx)
      tail_java = is_java_node(xx)
    }
    None -> ()
  }
  cx1 = pop_scope(cx1)
  # a Java call in tail position of a Unit block is a discard, like in
  # statement position (spec §9) — codegen pops the leftover value
  let rt = if expected == Some(TyUnit) && t != TyUnit && tail_java { TyUnit } else { t }
  (cx1, rt, XBlock(tstmts, ttail, lo, hi, rt))
}

fn check_stmt(cx: Cx, s: Stmt) -> (Cx, TStmt) !io =
  match s {
    SLet(name, mutable, ann, init, lo, hi) -> {
      var cx1 = cx
      let ann_t: Option[Ty] = match ann {
        Some(ref) -> {
          let (cxa, t) = resolve_type(cx1, ref)
          cx1 = cxa
          Some(t)
        }
        None -> None
      }
      let (cxb, it, ix) = check_expr(cx1, init, ann_t)
      cx1 = cxb
      var t = match ann_t {
        Some(a) -> a
        None -> it
      }
      match ann_t {
        Some(a) ->
          if not assignable(cx1, it, a) {
            cx1 = cerr(cx1, "annotated type is " ++ ty_show(cx1.adts, a) ++
                " but the initializer is " ++ ty_show(cx1.adts, it), e_lo(init), e_hi(init))
            t = a
          }
        None -> ()
      }
      if t == TyNever {
        cx1 = cerr(cx1, "cannot bind Never (this expression does not return)", e_lo(init), e_hi(init))
        t = TyError
      }
      let (cxc, sid) = declare(cx1, name, t, mutable, lo, hi)
      # `_` binds nothing: codegen discards the value (sym None)
      let bind: Option[Int] = if name == "_" { None } else { Some(sid) }
      (cxc, TSLet(bind, name, ix, lo, hi))
    }
    SLocalFn(name, params, ret, effs, body, nlo, nhi, lo, hi) ->
      check_local_fn(cx, name, params, ret, effs, body, nlo, nhi, lo, hi)
    SLetPat(pat, mutable, init, lo, hi) -> {
      var cx1 = cx
      let (cxa, it0, ix) = check_expr(cx1, init, no_expected())
      cx1 = cxa
      var it = it0
      if it == TyNever {
        cx1 = cerr(cx1, "cannot bind Never (this expression does not return)", e_lo(init), e_hi(init))
        it = TyError
      }
      let (cxb, tp) = check_pattern(cx1, pat, it, mutable)
      cx1 = cxb
      if not is_errorish(it) {
        match useful_result(cx1.adts, [[to_spat(tp)]], [SWild], [it]) {
          Some(true) -> {
            let (plo, phi) = match refutable_span(cx1, pat) {
              Some(sp) -> sp
              None -> (pat_lo(pat), pat_hi(pat))
            }
            cx1 = cerr_h(cx1, "this pattern does not always match, so it cannot be used in a let",
              plo, phi, "use match to handle the other cases")
          }
          Some(false) -> ()
          None -> { cx1 = usefulness_too_complex(cx1, pat_lo(pat), pat_hi(pat)) }
        }
      }
      (cx1, TSLetPat(tp, ix, lo, hi))
    }
    SAssign(name, value, nlo, nhi, lo, hi) -> {
      var cx1 = cx
      let (cxa, found) = resolve_local(cx1, name, nlo, nhi, true)
      cx1 = cxa
      match found {
        None -> {
          cx1 = cerr_o(cx1, "undefined variable: " ++ name, nlo, nhi,
            moved_or_suggest(cx1, name, local_names(cx1) ++ fn_pool(cx1)))
          let (cxb, _, vx) = check_expr(cx1, value, no_expected())
          (cxb, TSExpr(vx, lo, hi))
        }
        Some(sid) -> {
          let sym = sym_of(cx1, sid)
          if not sym.mutable {
            cx1 = cerr_h(cx1, "`" ++ name ++ "` is a let binding and cannot be assigned", nlo, nhi,
              "declare it as var " ++ name ++ " = ... if it needs to change")
          }
          let (cxb, vt, vx) = check_expr(cx1, value, Some(sym.ty))
          cx1 = cxb
          if not assignable(cx1, vt, sym.ty) {
            cx1 = cerr(cx1, "`" ++ name ++ "` is " ++ ty_show(cx1.adts, sym.ty) ++
                ", cannot assign " ++ ty_show(cx1.adts, vt), e_lo(value), e_hi(value))
          }
          (cx1, TSAssign(sid, name, vx, lo, hi))
        }
      }
    }
    SExpr(e, lo, hi) -> {
      let (cx1, t, tx) = check_expr(cx, e, no_expected())
      var cx2 = cx1
      # Java results may be dropped freely — Java APIs return `this` and
      # status codes that Dawn code rarely wants (spec §9)
      if t != TyUnit && not is_errorish(t) && not is_java_node(tx) {
        cx2 = cerr_h(cx2, "this " ++ ty_show(cx2.adts, t) ++ " value is discarded", lo, hi,
          "write let _ = ... to discard it, or move it to the block's tail/return position")
      }
      (cx2, TSExpr(tx, lo, hi))
    }
    SAssert(cond, src, lo, hi) -> {
      var cx1 = cx
      if not cx1.in_test {
        cx1 = cerr_h(cx1, "`assert` is only allowed inside test blocks", lo, hi,
          "use panic(...) for runtime invariants in regular code")
      }
      let (cxa, ct, cnx) = check_expr(cx1, cond, no_expected())
      cx1 = cxa
      if ct != TyBool && not is_errorish(ct) {
        cx1 = cerr(cx1, "`assert` expects Bool, got " ++ ty_show(cx1.adts, ct), e_lo(cond), e_hi(cond))
      }
      (cx1, TSAssert(cnx, src, lo, hi))
    }
    SWhile(cond, body, lo, hi) -> {
      var cx1 = cx
      let (cxa, ct, cnx) = check_expr(cx1, cond, no_expected())
      cx1 = cxa
      if ct != TyBool && not is_errorish(ct) {
        cx1 = cerr(cx1, "while condition must be Bool, got " ++ ty_show(cx1.adts, ct),
          e_lo(cond), e_hi(cond))
      }
      let d = len(cx1.frame.loop_stack)
      let loops = cx1.frame.loop_stack ++ [len(cx1.frame.lambda_stack)]
      cx1 = Cx { ..cx1, frame: Frame { ..cx1.frame, loop_stack: loops } }
      let (cxb, bt, bx) = check_expr(cx1, body, Some(TyUnit))
      cx1 = cxb
      let hj = set.has(cx1.loop_jumps, d)
      cx1 = Cx {
        ..cx1,
        frame: Frame {
          ..cx1.frame,
          loop_stack: list.take(cx1.frame.loop_stack, len(cx1.frame.loop_stack) - 1)
        },
        loop_jumps: set.remove(cx1.loop_jumps, d)
      }
      if bt != TyUnit && not is_errorish(bt) {
        cx1 = cerr_h(cx1, "the loop body's value is discarded (" ++ ty_show(cx1.adts, bt) ++ ")",
          e_lo(body), e_hi(body),
          "the last statement of a loop body must not be a non-Unit expression")
      }
      (cx1, TSWhile(cnx, bx, hj, lo, hi))
    }
    SFor(pat, from, to_opt, body, lo, hi) -> {
      var cx1 = cx
      let (cxa, ft, fx) = check_expr(cx1, from, no_expected())
      cx1 = cxa
      var loop_t = TyError
      var tx_to: Option[TExpr] = None
      var wit: Option[WitRef] = None
      match to_opt {
        None -> {
          # `for x in xs` is a use of the Iter trait: resolve the witness the
          # way any bound does (rigid parameter forwards the caller's
          # dictionary, concrete subject devirtualises), and the loop
          # variable's type is the impl's `Item` -- reduced when the subject
          # is concrete, a rigid projection when it is not (generic for).
          if ft == TyNever {
            loop_t = TyNever
          } else if ft != TyError {
            if ft == TyInt {
              # the common slip deserves the range answer, not "no impl"
              cx1 = cerr_h(cx1, "for..in needs a range to iterate integers",
                e_lo(from), e_hi(from),
                "write `for x in a..b`, or iterate a value whose type implements `Iter`")
            } else {
              let (cxw, w) = resolve_witness(cx1, ITER_ID, ft, e_lo(from), e_hi(from),
                "for..in")
              cx1 = cxw
              match w {
                Some(_) -> {
                  wit = w
                  loop_t = reduce_assoc(cx1, TyAssoc(ft, ITER_ID, "Item"))
                }
                None -> ()
              }
            }
          }
        }
        Some(te) -> {
          let (cxb, tt2, tx2) = check_expr(cx1, te, no_expected())
          cx1 = cxb
          if (ft != TyInt && not is_errorish(ft)) || (tt2 != TyInt && not is_errorish(tt2)) {
            cx1 = cerr(cx1, "range bounds a..b must be Int (got " ++ ty_show(cx1.adts, ft) ++
                ".." ++ ty_show(cx1.adts, tt2) ++ ")", lo, hi)
          }
          loop_t = TyInt
          tx_to = Some(tx2)
        }
      }
      cx1 = push_scope(cx1)
      let pat_diag_count = len(cx1.diags)
      let (cxc, tp) = check_pattern(cx1, pat, loop_t, false)
      cx1 = cxc
      if not is_errorish(loop_t) && len(cx1.diags) == pat_diag_count {
        match useful_result(cx1.adts, [[to_spat(tp)]], [SWild], [loop_t]) {
          Some(true) -> {
            let (plo, phi) = match refutable_span(cx1, pat) {
              Some(sp) -> sp
              None -> (pat_lo(pat), pat_hi(pat))
            }
            cx1 = cerr_h(cx1, "for pattern must match every item", plo, phi,
              "use match or filter before the loop to handle items this pattern does not match")
          }
          Some(false) -> ()
          None -> { cx1 = usefulness_too_complex(cx1, pat_lo(pat), pat_hi(pat)) }
        }
      }
      let d = len(cx1.frame.loop_stack)
      let loops = cx1.frame.loop_stack ++ [len(cx1.frame.lambda_stack)]
      cx1 = Cx { ..cx1, frame: Frame { ..cx1.frame, loop_stack: loops } }
      let (cxd, bt, bx) = check_expr(cx1, body, Some(TyUnit))
      cx1 = cxd
      let hj = set.has(cx1.loop_jumps, d)
      cx1 = Cx {
        ..cx1,
        frame: Frame {
          ..cx1.frame,
          loop_stack: list.take(cx1.frame.loop_stack, len(cx1.frame.loop_stack) - 1)
        },
        loop_jumps: set.remove(cx1.loop_jumps, d)
      }
      if bt != TyUnit && not is_errorish(bt) {
        cx1 = cerr(cx1, "the loop body's value is discarded (" ++ ty_show(cx1.adts, bt) ++ ")",
          e_lo(body), e_hi(body))
      }
      cx1 = pop_scope(cx1)
      (cx1, TSFor(tp, loop_t, fx, tx_to, wit, bx, hj, lo, hi))
    }
  }

## fn name(params) -> T [!io] = body, statement form (the Kotlin checkLocalFn).
## The name is declared before the body is checked, so the body can call it;
## the self-capture is then dropped — codegen calls the impl method directly.
fn check_local_fn(
  cx: Cx,
  name: String,
  params: List[LambdaParam],
  ret_ref: TypeRef,
  effs: List[String],
  body: Expr,
  nlo: Int,
  nhi: Int,
  lo: Int,
  hi: Int
) -> (Cx, TStmt) !io = {
  var cx1 = cx
  var ptys: List[Ty] = []
  for p in params {
    var t = match p.ann {
      Some(ref) -> {
        let (cxa, tt) = resolve_type(cx1, ref)
        cx1 = cxa
        tt
      }
      # the parser requires annotations on local fn parameters
      None -> TyError
    }
    ptys = ptys ++ [t]
  }
  let (cxb, ret) = resolve_return_type(cx1, ret_ref)
  cx1 = cxb
  var eff = EPure
  if len(effs) == 0 {
    eff = EPure
  } else if len(effs) == 1 && effs[0] == "io" {
    eff = EIo
  } else {
    cx1 = cerr_h(cx1, "local functions cannot declare effect variables", nlo, nhi,
      "a local function is `!io` or pure; lift it to the top level for effect polymorphism")
    eff = EIo
  }
  let ft = TyFn(ptys, ret, eff)
  let (cxc, sid) = declare(cx1, name, ft, false, nlo, nhi)
  cx1 = cxc
  let (cxd, actual, lam) = check_lambda(cx1, params, body, false, false, Some(ft), lo, hi)
  cx1 = cxd
  match actual {
    TyFn(_, ar, ae) -> {
      if not assignable(cx1, ar, ret) {
        cx1 = cerr(cx1, "the body of `" ++ name ++ "` has type " ++ ty_show(cx1.adts, ar) ++
            " but the declared return type is " ++ ty_show(cx1.adts, ret), e_lo(body), e_hi(body))
      }
      if ae == EIo && eff == EPure {
        cx1 = cerr_h(cx1, "the body of `" ++ name ++ "` performs io", nlo, nhi,
          "declare it: fn " ++ name ++ "(...) -> " ++
            fn_return_show(cx1.adts, ret, EIo) ++ " !io = ...")
      }
    }
    _ -> ()
  }
  match lam {
    XLambda(psyms, pnames, bx, caps, ..) -> {
      var caps2: List[Int] = []
      for c in caps {
        if c != sid { caps2 = caps2 ++ [c] }
      }
      (cx1, TSLocalFn(sid, name, psyms, pnames, bx, caps2, lo, hi))
    }
    _ -> (cx1, TSExpr(XError(lo, hi), lo, hi))
  }
}

# ---- calls ----

fn is_lambda_or_var(e: Expr) -> Bool =
  match e {
    ELambda(_, _, _, _, _) -> true
    EVar(_, _, _) -> true
    _ -> false
  }

## Check argument i; a UFCS receiver (always args[0]) was already checked by
## check_method_call and its result is passed through.
fn check_arg_at(
  cx: Cx,
  a: Expr,
  i: Int,
  pre0: Option[(Ty, TExpr)],
  exp: Option[Ty]
) -> (Cx, Ty, TExpr) !io =
  if i == 0 {
    match pre0 {
      Some(p) -> {
        let (pt, px) = p
        (cx, pt, px)
      }
      None -> check_expr(cx, a, exp)
    }
  } else {
    check_expr(cx, a, exp)
  }

## Check every argument with no expected type (error paths: the subtrees still
## get visited so their own diagnostics surface).
fn check_args_plain(cx: Cx, args: List[Expr], pre0: Option[(Ty, TExpr)]) -> (Cx, List[TExpr]) !io = {
  var cx1 = cx
  var txs: List[TExpr] = []
  var i = 0
  for a in args {
    let (cxa, _, ax) = check_arg_at(cx1, a, i, pre0, no_expected())
    cx1 = cxa
    txs = txs ++ [ax]
    i = i + 1
  }
  (cx1, txs)
}

## Where a failed trait bound belongs. The bound is on a type parameter, and
## the argument that stands in for it is the thing the author can change --
## the callee name is the same for every bound the call has, so `Float has no
## hash` used to point at `insert` rather than at the `1.0` it is about.
##
## A parameter that IS the variable names that value directly; one that merely
## contains it (`Map[K, V]`) is a container, and blaming it would put the
## caret on `map.empty()`. So exact matches are preferred, containers are the
## fallback, and the callee remains the last resort.
fn bound_arg_span(s: Sig, args: List[Expr], tp: Ty, clo: Int, chi: Int) -> (Int, Int) = {
  let vid = match tp {
    TyVar(_, v) -> v
    _ -> return (clo, chi)
  }
  let n = if len(args) < len(s.param_tys) { len(args) } else { len(s.param_tys) }
  var i = 0
  while i < n {
    if s.param_tys[i] == tp { return (e_lo(args[i]), e_hi(args[i])) }
    i = i + 1
  }
  i = 0
  while i < n {
    if ty_mentions_var(s.param_tys[i], vid) { return (e_lo(args[i]), e_hi(args[i])) }
    i = i + 1
  }
  (clo, chi)
}

fn param_has_default(s: Sig, idx: Int) -> Bool =
  idx < len(s.param_defaults) && s.param_defaults[idx]

## The parameters a call cannot omit. Not a prefix: a default may sit before
## a required parameter (spec §4.3), so this counts rather than scans.
fn required_count(s: Sig) -> Int = {
  if len(s.param_defaults) == 0 { return len(s.param_tys) }
  var n = 0
  var i = 0
  for t in s.param_tys {
    if not param_has_default(s, i) { n = n + 1 }
    i = i + 1
  }
  n
}

## `f takes 2 argument(s), got 3` -- or `2 to 3` when defaults widen it.
fn arity_msg(callee: String, min_n: Int, max_n: Int, got: Int) -> String = {
  let takes = if min_n == max_n {
    to_string(max_n)
  } else {
    to_string(min_n) ++ " to " ++ to_string(max_n)
  }
  "`" ++ callee ++ "` takes " ++ takes ++ " argument(s), got " ++ to_string(got)
}

## The call an omitted defaulted argument becomes: `f$default$k()`, resolved
## to the declaring module. The synthesized function repeats the callee's type
## parameters and bounds, so this is an instantiated call like any other: the
## result type is the parameter's type under this call's substitution, and the
## witnesses are this call's own -- the same row, read in the same order, so
## the parent's list is the callee's list. It is pure and zero-parameter, so
## it needs no evidence.
fn default_call(
  cx: Cx,
  s: Sig,
  callee: String,
  idx: Int,
  m: Map[Int, Ty],
  em: Map[Int, Eff],
  wits: List[WitRef],
  lo: Int,
  hi: Int
) -> TExpr = {
  let none_tid: Option[Int] = None
  let pty = reduce_ty_effs(cx, reduce_assoc(cx, subst(s.param_tys[idx], m, em)), m)
  XCallFn(s.owner, callee ++ "\$default\$" ++ to_string(idx), [], wits, [], none_tid,
    lo, hi, pty)
}

## A named call f(args) (the Kotlin checkCall): a local fn value, else a
## top-level / std / builtin signature with two-round argument inference,
## trait witnesses and effect instantiation. `resolved_sig` bypasses locals
## (module-qualified calls); `pre0` is a pre-typed UFCS receiver at args[0].
fn check_call(
  cx: Cx,
  callee: String,
  args0: List[Arg],
  expected: Option[Ty],
  pre0: Option[(Ty, TExpr)],
  resolved_sig: Option[Sig],
  clo: Int,
  chi: Int,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  let args = arg_exprs(args0)
  var cx1 = cx
  var local: Option[Int] = None
  match resolved_sig {
    Some(_) -> ()
    None -> {
      let (cxa, found) = resolve_local(cx1, callee, clo, chi, false)
      cx1 = cxa
      local = found
    }
  }
  match local {
    Some(sid) -> {
      # a local holds a function *value*, and a function type has no parameter
      # names -- the boundary named arguments stop at (spec §4.3)
      match first_named(args0) {
        Some(a) -> {
          var cxn = cerr_h(cx1, fn_value_named_arg_msg(callee), a.lo, a.hi, named_arg_hint())
          let (cxa, _) = check_args_plain(cxn, args, pre0)
          return (cxa, TyError, XError(lo, hi))
        }
        None -> ()
      }
      let sym = sym_of(cx1, sid)
      let lt = sym.ty
      if is_errorish(lt) {
        let (cxa, _) = check_args_plain(cx1, args, pre0)
        return (cxa, TyError, XError(lo, hi))
      }
      var is_fn = false
      var lps: List[Ty] = []
      var lret = TyError
      var leff = EPure
      match lt {
        TyFn(ps, r, ef) -> {
          is_fn = true
          lps = ps
          lret = r
          leff = ef
        }
        _ -> ()
      }
      if not is_fn {
        let (cxa, _) = check_args_plain(cx1, args, pre0)
        return (cerr(cxa, "`" ++ callee ++ "` is not a function (it is " ++
            ty_show(cxa.adts, lt) ++ ")", clo, chi), TyError, XError(lo, hi))
      }
      if len(args) != len(lps) {
        let (cxa, _) = check_args_plain(cx1, args, pre0)
        return (cerr_h(cxa, "`" ++ callee ++ "` takes " ++ to_string(len(lps)) ++
            " argument(s), got " ++ to_string(len(args)), lo, hi,
          "type: " ++ ty_show(cxa.adts, lt)), lret, XError(lo, hi))
      }
      var txs: List[TExpr] = []
      var i = 0
      for a in args {
        let pt = lps[i]
        let (cxa, at, ax) = check_arg_at(cx1, a, i, pre0, Some(pt))
        cx1 = cxa
        if not assignable(cx1, at, pt) {
          cx1 = cerr_h(cx1, "argument type mismatch: expected " ++ ty_show(cx1.adts, pt) ++
              ", got " ++ ty_show(cx1.adts, at), e_lo(a), e_hi(a),
            "type: " ++ ty_show(cx1.adts, lt))
        }
        txs = txs ++ [ax]
        i = i + 1
      }
      # the supply point for a call through a local holding a function value;
      # see `check_apply` for why the row is answered here
      let (cxe, evs, unanswered) = dyn_evidence_args(cx1, leff, clo, chi)
      cx1 = cxe
      cx1 = record_effect(cx1, eff_drop(leff, unanswered), clo, chi, callee)
      return (cx1, lret, XCallDyn(sid, callee, txs, evs, lo, hi, lret))
    }
    None -> ()
  }
  let sig = match resolved_sig {
    Some(s0) -> Some(s0)
    None -> lookup_fn_sig(cx1, callee)
  }
  let s = match sig {
    Some(s2) -> s2
    None -> {
      # still check the arguments so their subtrees get types/symbols
      let (cxa, _) = check_args_plain(cx1, args, pre0)
      return (cerr_o(cxa, "undefined function: " ++ callee, clo, chi,
        moved_or_suggest(cxa, callee, fn_pool(cxa))),
        TyError, XError(lo, hi))
    }
  }
  # Arity first when every argument is positional -- the historical wording,
  # order and early return. A call with names resolves slots first, so its
  # report can name the parameter rather than count to the wrong number
  # (`xs.len(n: 1)` would otherwise count the receiver and report an arity
  # of 2). With defaults the count is a range; without, min == max and the
  # sentence is the one it always was.
  let named_present = first_named(args0) != None
  let min_arity = required_count(s)
  if not named_present && (len(args) > len(s.param_tys) || len(args) < min_arity) {
    let (cxa, _) = check_args_plain(cx1, args, pre0)
    let cxb = cerr_h(cxa, arity_msg(callee, min_arity, len(s.param_tys), len(args)), lo, hi,
      "signature: " ++ sig_render(cxa.adts, cxa.traits, s))
    # The declared return type survives a wrong argument count, so hand it back
    # and let the context judge the body on its own (see check_ctor_call). For a
    # generic signature it does not survive: inference is seeded from the
    # arguments, and with the wrong number of them `s.ret` still mentions type
    # variables nothing bound -- returning it puts a bare `T` in the next
    # diagnostic ("declares return type String but its body is T").
    let rt = if len(s.tparams) == 0 { s.ret } else { TyError }
    return (cxb, rt, XError(lo, hi))
  }
  var m: Map[Int, Ty] = map.empty()
  var em: Map[Int, Eff] = map.empty()
  # seed inference from the expected result type (helps nested cases like Some(None))
  match expected {
    Some(et) ->
      if len(s.tparams) > 0 && is_concrete(cx1, et) {
        let (m2, em2, _) = unify_into(cx1, s.ret, et, m, em)
        m = m2
        em = em2
      }
    None -> ()
  }
  # two rounds: self-sufficient arguments first (they bind type variables),
  # then inference-needing ones (bare None, []) with what was learned.
  #
  # Both lists are indexed by argument and the loops below walk the arguments
  # in order, so each one is grown by appending its own entry rather than
  # written into a prefilled list -- an indexed write costs a rebuild of the
  # whole list (list.take ++ .. ++ list.drop).
  var at_slots: List[Option[Ty]] = []
  var tx_slots: List[Option[TExpr]] = []
  # Which parameter each argument fills: the shared rule (types.arg_slots),
  # the function-call spelling of the decision constructors make. An
  # all-positional call of the right arity resolves to the identity mapping
  # and goes through exactly as before. An argument that landed on no
  # parameter is checked now, with no expected type, so its own errors are
  # reported and the rounds below skip it.
  var pidx: List[Int] = []
  # (parameter, argument) for the arguments that landed on a parameter;
  # `slot_of` is built from it after the loop, since it is indexed the other way
  var filled: List[(Int, Int)] = []
  var args_broken = false
  var given: List[Option[String]] = []
  for a0 in args0 { given = given ++ [a0.name] }
  let trailing = len(args0) > 0 && args0[len(args0) - 1].trailing
  let picks = arg_slots(s.param_names, given, trailing)
  var i0 = 0
  for a0 in args0 {
    var idx = -1
    match picks[i0] {
      SlotAt(at) -> { idx = at }
      SlotNoField(an) -> {
        let h = match suggest.hint(an, s.param_names) {
          Some(hh) -> hh
          None -> "signature: " ++ sig_render(cx1.adts, cx1.traits, s)
        }
        cx1 = cerr_h(cx1, "`" ++ callee ++ "` has no parameter `" ++ an ++ "`", a0.lo, a0.hi, h)
        args_broken = true
      }
      SlotAfterNamed -> {
        cx1 = cerr(cx1, "positional arguments cannot follow named arguments", a0.lo, a0.hi)
        args_broken = true
      }
      # counted after the rounds, with the arity wording
      SlotOverflow -> ()
      SlotTaken(at) -> {
        if trailing && i0 == len(args0) - 1 {
          # the trailing closure and an earlier argument both fill the last
          # parameter; say which parameter the block is for (spec §4.3)
          cx1 = cerr(cx1, "the last parameter `" ++ s.param_names[at] ++
              "` is already given; the tail block is what fills it", a0.lo, a0.hi)
        } else {
          cx1 = cerr(cx1, "parameter `" ++ s.param_names[at] ++ "` is given twice", a0.lo, a0.hi)
        }
        args_broken = true
      }
    }
    pidx = pidx ++ [idx]
    if idx >= 0 {
      filled = filled ++ [(idx, i0)]
      at_slots = at_slots ++ [no_expected()]
      tx_slots = tx_slots ++ [no_texpr()]
    } else {
      let (cxa, at, ax) = check_arg_at(cx1, a0.e, i0, pre0, no_expected())
      cx1 = cxa
      at_slots = at_slots ++ [Some(at)]
      tx_slots = tx_slots ++ [Some(ax)]
    }
    i0 = i0 + 1
  }
  # arg_slots hands out each parameter at most once -- a second argument for it
  # comes back SlotTaken with no pick -- so one scan of `filled` per parameter
  # answers who fills it, and a later pair still wins as an indexed write did.
  var slot_of: List[Option[Int]] = []
  var pk = 0
  for _pt in s.param_tys {
    var so: Option[Int] = no_int()
    for f in filled {
      let (fp, fa) = f
      if fp == pk { so = Some(fa) }
    }
    slot_of = slot_of ++ [so]
    pk = pk + 1
  }
  for round in 0..2 {
    var at_next: List[Option[Ty]] = []
    var tx_next: List[Option[TExpr]] = []
    var i = 0
    for a in args {
      var at_i = at_slots[i]
      var tx_i = tx_slots[i]
      let done = match at_i {
        Some(_) -> true
        None -> false
      }
      let skip = round == 0 && needs_expected(cx1, a)
      if not done && not skip {
        let pt = s.param_tys[pidx[i]]
        let substd = reduce_ty_effs(cx1, reduce_assoc(cx1, subst(pt, m, em)), m)
        # lambdas only need their parameter types, and function values unify
        # piecewise — a partially concrete expected type still helps
        let exp2: Option[Ty] =
          if is_concrete(cx1, substd) || is_lambda_or_var(a) { Some(substd) } else { None }
        let (cxa, at, ax) = check_arg_at(cx1, a, i, pre0, exp2)
        cx1 = cxa
        at_i = Some(at)
        tx_i = Some(ax)
        # A function value's row is answered here and nowhere else, so this is
        # where the leftover `!(e|R)` leaves for `e` is computed (#350). The
        # binding is offered to `unify_into` rather than made after it: the
        # union arm is a containment test over the *substituted* row, so a
        # binding that arrives late is a binding the test never sees.
        let (em_sub, subtracted, why) = earg_row_subtract(cx1, s, pt, at, m, em)
        var m3 = m
        var em3 = em_sub
        var ok = true
        let (m4, em4, ok4) = unify_into(cx1, pt, at, m, em_sub)
        m3 = m4
        em3 = em4
        ok = ok4
        # A subtraction that did not rescue the argument must leave nothing
        # behind: the argument is an error either way, and a stray binding for
        # `e` would answer the next argument's row with a row nothing chose.
        if not ok && subtracted {
          let (m5, em5, ok5) = unify_into(cx1, pt, at, m, em)
          m3 = m5
          em3 = em5
          ok = ok5
        }
        m = m3
        em = em3
        if not ok {
          let h = match why {
            Some(w) -> w
            None -> "signature: " ++ sig_render(cx1.adts, cx1.traits, s)
          }
          cx1 = cerr_h(cx1, "argument type mismatch: expected " ++
              ty_show(cx1.adts, reduce_ty_effs(cx1, reduce_assoc(cx1, subst(pt, m, em)), m)) ++ ", got " ++
              ty_show(cx1.adts, at), e_lo(a), e_hi(a), h)
        }
      }
      at_next = at_next ++ [at_i]
      tx_next = tx_next ++ [tx_i]
      i = i + 1
    }
    at_slots = at_next
    tx_slots = tx_next
  }
  # the named-call arity report, after the arguments so their own errors come
  # first (the all-positional path answered arity above and returned)
  if named_present && not args_broken &&
    (len(args) > len(s.param_tys) || len(args) < min_arity) {
      let cxb = cerr_h(cx1, arity_msg(callee, min_arity, len(s.param_tys), len(args)), lo, hi,
        "signature: " ++ sig_render(cx1.adts, cx1.traits, s))
      let rt = if len(s.tparams) == 0 { s.ret } else { TyError }
      return (cxb, rt, XError(lo, hi))
    }
  # a required parameter a named call skipped while the count stayed in
  # range, or a default-before-required signature called positionally short
  if not args_broken {
    var missing_req: List[String] = []
    var mi = 0
    for so in slot_of {
      let filled = match so {
        Some(_) -> true
        None -> false
      }
      if not filled && not param_has_default(s, mi) {
        missing_req = missing_req ++ [s.param_names[mi]]
      }
      mi = mi + 1
    }
    if len(missing_req) > 0 {
      let cxb = cerr_h(cx1, "missing argument(s) for `" ++ callee ++ "`: " ++
          join(missing_req, ", "), lo, hi,
        "signature: " ++ sig_render(cx1.adts, cx1.traits, s))
      let rt = if len(s.tparams) == 0 { s.ret } else { TyError }
      return (cxb, rt, XError(lo, hi))
    }
  }
  # return-position inference: let x: Option[Int] = ...
  var unbound_any = false
  for tp in s.tparams {
    match tp {
      TyVar(_, vid) -> if not map.has(m, vid) { unbound_any = true }
      _ -> ()
    }
  }
  if unbound_any {
    match expected {
      Some(et) -> {
        let (m4, em4, _) = unify_into(cx1, s.ret, et, m, em)
        m = m4
        em = em4
      }
      None -> ()
    }
  }
  var unbound: List[String] = []
  for tp in s.tparams {
    match tp {
      TyVar(n, vid) -> if not map.has(m, vid) { unbound = unbound ++ [n] }
      _ -> ()
    }
  }
  if len(unbound) > 0 {
    # Not "annotate the use site": Dawn has no call-site type arguments, so
    # there is nothing at the call to annotate, and the old wording sent people
    # looking for a turbofish. A type parameter is bound by what the arguments
    # and the expectation carry, and an argument that carries nothing -- a
    # `Never` from `panic`, an empty list with no expectation -- leaves it
    # unbound. The repair is upstream of the call.
    return (cerr_h(cx1, "cannot infer type parameter(s) " ++ join(unbound, ", ") ++
        " for `" ++ callee ++ "`", lo, hi,
      "Dawn has no call-site type arguments, so the type has to arrive as an " ++
        "expectation: annotate the binding an argument comes from, or the one " ++
        "that takes the result"),
      TyError, XError(lo, hi))
  }
  # trait bounds: each (type parameter, bound) pair needs a dictionary
  var wits: List[WitRef] = []
  var any_constraint = false
  for bs in s.constraints {
    if len(bs) > 0 { any_constraint = true }
  }
  if any_constraint {
    var all_ok = true
    var ws: List[WitRef] = []
    var i2 = 0
    for tp in s.tparams {
      let (blo, bhi) = bound_arg_span(s, args, tp, clo, chi)
      for tr_id in bounds_of(s, i2) {
        let (cxa, w) = resolve_witness(cx1, tr_id, subst(tp, m, em), blo, bhi,
          "`" ++ callee ++ "`")
        cx1 = cxa
        match w {
          Some(wr) -> { ws = ws ++ [wr] }
          None -> { all_ok = false }
        }
      }
      i2 = i2 + 1
    }
    if all_ok { wits = ws }
  }
  if s.is_builtin && s.name == "cast" {
    # T is bound here (an unbound type param already errored above). It must be
    # a reference type: CHECKCAST cannot target a primitive (docs/cast-interop.md §三)
    #
    # T is read from inside the `Result` the reclaim returns. It was a bare
    # return type until step B's stage 2, and a two-branch read for the one
    # release the transitional spelling lived through.
    let target = match subst(s.ret, m, em) {
      TyAdt(_, targs) -> targs[0]
      _ -> TyError
    }
    if target == TyInt || target == TyFloat || target == TyBool {
      cx1 = cerr_h(cx1, "`" ++ s.name ++ "` target must be a reference type, not " ++
          ty_show(cx1.adts, target), lo, hi,
        "cast reclaims an erased Java Object via CHECKCAST; primitive targets aren't supported")
    }
  }
  # `em` is final here, so this is where the instantiations can be read back.
  # A variable in a parameter type that this callee's ABI row does not carry
  # came from a type declaration's binder and has no evidence slot anywhere.
  cx1 = refuse_decl_eff_inst(cx1, s.param_tys ++ [s.ret], eff_vars(sig_abi_eff(s)), em, lo, hi)
  # Instantiate the callee's effect: an unbound effect variable means pure.
  # The effect half of the choke below: a projection whose subject was just
  # bound reduces here too (D3/D5), so no ground row ever carries one and the
  # evidence loop further down sees the same answers the witness solver gave.
  let callee_eff = reduce_eff(cx1, instantiate_eff(s.eff, em), m)
  # the one instantiation choke point: a projection whose subject just became
  # concrete reduces here, so no ground type ever carries one (D3)
  let ret = reduce_ty_effs(cx1, reduce_assoc(cx1, subst(s.ret, m, em)), m)
  # The call node's arguments are in parameter order; an all-positional call
  # already is, so this is the identity it always was. An unfilled parameter
  # with a default becomes a call of its synthesized `f$default$k` -- pure and
  # zero-parameter, so where it sits in the evaluation order is unobservable.
  var txs2: List[TExpr] = []
  var pi2 = 0
  for so in slot_of {
    let sl = match so {
      Some(wi) -> tx_slots[wi]
      None ->
        if param_has_default(s, pi2) {
          Some(default_call(cx1, s, callee, pi2, m, em, wits, lo, hi))
        } else {
          no_texpr()
        }
    }
    match sl {
      Some(ax) -> { txs2 = txs2 ++ [ax] }
      None -> { txs2 = txs2 ++ [XError(lo, hi)] }
    }
    pi2 = pi2 + 1
  }
  # Arguments evaluate in written order (spec §4.3). When a named argument
  # landed out of written order, every argument is bound to a local first, in
  # written order, and the call reads the locals in parameter order. A call
  # whose written order already is parameter order wraps nothing and emits
  # exactly what it always did.
  var arg_lets: List[TStmt] = []
  if named_present && not args_broken {
    var mono = true
    var prev = -1
    for so in slot_of {
      match so {
        Some(wi) -> {
          if wi < prev { mono = false }
          prev = wi
        }
        None -> ()
      }
    }
    if not mono {
      # the bindings live in the wrapper block, and in a scope of their own --
      # two reordered calls in one function must not collide on the names
      cx1 = push_scope(cx1)
      var locs: List[Option[TExpr]] = []
      var wi2 = 0
      for a0 in args0 {
        match tx_slots[wi2] {
          Some(ax) -> {
            let t = tex_ty(ax)
            let nm = "arg\$" ++ to_string(wi2)
            let (cxd, sidw) = declare(cx1, nm, t, false, a0.lo, a0.hi)
            cx1 = cxd
            arg_lets = arg_lets ++ [TSLet(Some(sidw), nm, ax, a0.lo, a0.hi)]
            locs = locs ++ [Some(XLocal(sidw, nm, a0.lo, a0.hi, t))]
          }
          None -> { locs = locs ++ [no_texpr()] }
        }
        wi2 = wi2 + 1
      }
      cx1 = pop_scope(cx1)
      txs2 = []
      var pi3 = 0
      for so in slot_of {
        let sl = match so {
          Some(wi) -> locs[wi]
          None ->
            if param_has_default(s, pi3) {
              Some(default_call(cx1, s, callee, pi3, m, em, wits, lo, hi))
            } else {
              no_texpr()
            }
        }
        match sl {
          Some(lx) -> { txs2 = txs2 ++ [lx] }
          None -> { txs2 = txs2 ++ [XError(lo, hi)] }
        }
        pi3 = pi3 + 1
      }
    }
  }
  # the evidence the callee's *written* labels need, in effect-id order. A
  # label that arrived by instantiating an effect variable is not here: it
  # belongs to the variable's own slot, which `evidence_var_args` fills with a
  # pack of that instance. (It used to be left out on the different grounds
  # that the closure the caller handed over carried its own evidence in its
  # captures -- rule 乙, which is what this knife severed. Same list, and now
  # for the reason the layout already said.)
  # the callee's ABI row, which is its declared row plus the effect variables
  # it binds -- the same list `bind_evidence` walked on the other side
  let callee_abi = sig_abi_eff(s)
  let (cxv, evs0, unanswered) = evidence_args(cx1, callee_abi, clo, chi)
  cx1 = cxv
  # ... one per effect variable, behind them (rule 丁) ...
  let (cxv2, vevs, vunanswered, vinsts) = evidence_var_args(cx1, callee_abi, em, clo, chi)
  cx1 = cxv2
  # ... and one per projection written in the row, behind those (rule 丙)
  let (cxa2, aevs, aunanswered, adropped) = evidence_assoc_args(cx1, callee_abi, m, clo, chi)
  cx1 = cxa2
  let evs = evs0 ++ vevs ++ aevs
  # **Charged is what was supplied.** The declared row is not enough on its
  # own, because a declared `!io` absorbs the effect variables beside it
  # (`base_union`) and the absorbed one is exactly the slot the line above just
  # filled: `fn run(t: fn() -> Int !e) -> Int !io` normalizes to `!io`, so
  # instantiating `!e := !Ask` charged the caller nothing and the caller's own
  # row lost the label -- and a row without the label builds a pack without the
  # node, which is `ev_get`'s compiler-invariant panic on a program that checks
  # clean. So every instantiation `evidence_var_args` packed is unioned in
  # before the withdrawal below: supplying evidence for an atom and not being
  # charged for it are the same bug seen from two sides.
  let charged = eff_union([callee_eff] ++ vinsts)
  # Charge the row -- minus any label `evidence_args` just reported as having
  # no handler. That call is already an error, at the raise site and in the
  # raise site's words; leaving the label in the body's row would have
  # `verify_effects` say the same thing over again at the signature.
  cx1 = record_effect(cx1,
    eff_drop_assocs(eff_drop(charged, unanswered ++ vunanswered ++ aunanswered), adropped),
    clo, chi, callee)
  # Nothing further to record about where the labels came from. That question
  # -- written here, or brought in by instantiating an effect variable -- was
  # asked so that a closure being built could drop the ones it had answered
  # itself; no closure drops anything now, so `instantiated_labels` and the
  # `mark_unsettled_labels` call that consumed it went with it.
  # A primitive is charged for its own row like anything else, and until
  # 2026-08-25 it was the one callee that did not *receive* what it charged:
  # this node dropped `evs`, and lowering filled the slots with placeholders
  # sized off the signature. Two primitives have a row to fill -- `sort_by`
  # (`!e`, body in std/pvec) and `bracket` (`!e`, body a hand-written shim) --
  # and both handed a closure a pack with nothing in it, so a labelled closure
  # through either was `ev_get`'s panic on a program that checks clean.
  let node = if s.is_builtin {
    XCallBuiltin(callee, txs2, wits, evs, lo, hi, ret)
  } else {
    match s.op_of {
      # an operation call is a field read off the evidence plus a closure
      # call: there is no symbol named `ask` anywhere in the output
      Some(pr) -> {
        let (eid, idx) = pr
        let recv = if len(evs) == 1 { evs[0] } else { XError(lo, hi) }
        # **The arm's evidence is the handler's, not this raise site's.** An arm
        # runs where the handler was installed, so the pack it gets is the one
        # `check_handle` stored in the record's trailing `env` field -- the last
        # field, behind every operation (`passes.dawn`). Handing over this
        # frame's environment instead would answer an arm's own raises out of
        # the scope that raised, which is the outer-handler rule backwards
        # (`scripts/spike-native/effect_lexical.dawn`'s `inner_ten`).
        let env_idx = len(adt_of(cx1.adts, eid).ctors[0].fields) - 1
        let env = XField(recv, env_idx, clo, chi, erased_ev_ty())
        XApply(XField(recv, idx, clo, chi, TyFn(s.param_tys, s.ret, EPure)), txs2,
          [env], lo, hi, ret)
      }
      None -> XCallFn(s.owner, callee, txs2, wits, evs, s.trait_id, lo, hi, ret)
    }
  }
  let out = if len(arg_lets) > 0 { XBlock(arg_lets, Some(node), lo, hi, ret) } else { node }
  (cx1, ret, out)
}

## Instantiate a callee's declared effect at a call site: an unbound effect
## variable means pure, and labels ride through unchanged.
##
## The substitution itself is `subst_eff`, the one every other caller uses.
## What is added here is only the call-site default, and it is added by
## completing the map rather than by walking the row a second time — the second
## walk is what used to drop `EUnion` on the floor, so a callee declared
## `!(e1|e2)` handed its own variables to its caller and no pure call site was
## accepted (audit SEM-02).
fn instantiate_eff(e: Eff, em: Map[Int, Eff]) -> Eff = {
  var em1 = em
  for v in eff_vars(e) {
    let (eid, _) = v
    if not map.has(em1, eid) { em1 = map.insert(em1, eid, EPure) }
  }
  subst_eff(e, em1)
}

## Refuse to instantiate a **type declaration's** effect parameter with a row
## that would need evidence.
##
## Knife 3 gave `type Box[!e]` and `alias Mapper[T, U, !e]` a binder and called
## the feature check-period only, on the argument that a closure settled its row
## where it was created and carried the evidence in its captures, so a `!e` on a
## record field cost nothing at run time (docs/effect-params-design.md 刀 3, and
## `scripts/spike-native/effect_params.dawn`'s header states it in those words).
## The evidence flip took that premise away. A closure carries no evidence now;
## the pack is handed over by whoever calls it, and a slot has to exist to hand
## it over in.
##
## For a variable a **signature** binds there is one: rule 丁 gives it a hidden
## parameter, the call site fills it with `evidence_pack` of the instance, and
## the body forwards it. For a variable a **declaration** binds there is none,
## and there is nowhere to put one either: a record is not a frame, and a type
## reference has no effect-argument position to instantiate per use site
## (decision 7 -- `Box` is one type however its field's row turns out). So the
## binder keeps admitting every row that needs no evidence, which is what pure
## and `!io` are and what the feature's own corpus asks of it, and refuses the
## rows whose evidence would have to travel a channel that does not exist.
## Before this refusal such a program checked clean and then met `ev_get`'s
## compiler-invariant panic (`types.EV_MISS_MSG`) at run time.
##
## The predicate is `types.nev` less the atom being solved: how much evidence
## the instantiation is worth, minus the variable standing for itself. Zero
## atoms left, nothing to carry, nothing to refuse.
##
## `bound` is the variables the callee's **ABI row** carries -- `eff_vars` of
## `sig_abi_eff`, which is the one definition of which atoms get a slot. Not
## `Sig.eparams`: a builtin is hand-built with an empty `eparams` and writes its
## variable in the row instead (`bracket`), and its callers do pass a pack for
## it. Asking the ABI rather than the binder list asks the question that
## matters, which is whether a slot exists, and it is also the fix the hint
## points at. A constructor has no ABI row at all and passes `[]`.
fn refuse_decl_eff_inst(
  cx: Cx,
  declared: List[Ty],
  bound: List[(Int, String)],
  em: Map[Int, Eff],
  lo: Int,
  hi: Int
) -> Cx = {
  var cx1 = cx
  for tv in ty_eff_vars_all(declared) {
    let (vid, vname) = tv
    var is_bound = false
    for b in bound {
      let (bid, _) = b
      if bid == vid { is_bound = true }
    }
    if is_bound { continue }
    let inst = match map.get(em, vid) {
      Some(e) -> e
      None -> EPure
    }
    # The variable standing for itself is the identity, not an instantiation:
    # `fn store(m: Mapper[Int, String]) -> Mapper[Int, String] = m` unifies the
    # declaration's binder against the very same binder, and forwarding a value
    # whose row is unchanged asks nobody for evidence. So the atom being solved
    # is discounted and what is left is what would have to travel.
    var owed = len(eff_labels(inst)) + len(eff_assocs(inst))
    for iv in eff_vars(inst) {
      let (ivid, _) = iv
      if ivid != vid { owed = owed + 1 }
    }
    if owed == 0 { continue }
    cx1 = cerr_h(cx1, "`!" ++ vname ++ "` is bound by a type declaration and cannot carry !" ++
        eff_show(inst), lo, hi,
      "a declaration's effect parameter has no evidence slot, so only pure and !io travel " ++
        "through it; bind the variable on the function that runs the closure instead -- " ++
        "`fn f(g: fn() -> Int !" ++ vname ++ ") -> Int !" ++ vname ++ "`")
  }
  cx1
}

## Resolve one evidence value per label written in `declared`, in effect-id
## order. A label with nothing to answer it is the "nobody is handling this"
## error, reported here -- at the call that raises it, which is the only place
## that knows which call it was.
fn evidence_args(cx: Cx, declared: Eff, lo: Int, hi: Int) -> (Cx, List[TExpr], List[Int]) = {
  var cx1 = cx
  var out: List[TExpr] = []
  var unanswered: List[Int] = []
  for l in eff_labels(declared) {
    let (eid, _) = l
    let (cx2, tx, answered) = resolve_label_evidence(cx1, eid, lo, hi)
    cx1 = cx2
    if not answered { unanswered = unanswered ++ [eid] }
    out = out ++ [tx]
  }
  (cx1, out, unanswered)
}

## Rule 丁's call-site half: one evidence value per effect *variable* written
## in the callee's ABI row, in `eff_vars` order, between the written labels'
## evidence and the projections'.
##
## The count comes from the declaration and the value from the call site, and
## those are two different questions. The count cannot follow the instance: a
## pure closure and a labelled one go into the same `!e` parameter, and the
## callee's arity is fixed before either call site exists. The value can, and
## does: what fills the slot is `evidence_pack` of the row the variable was
## instantiated with.
##
## This used to be the one of the three that never reported, on the grounds
## that nothing read a pack. Something reads it now, so instantiating `!e :=
## !Ask` where no `Ask` is in scope is the "nobody is handling this" error, at
## this call -- and like its two neighbours it hands the unanswered labels back
## so the caller can take them out of the row it charges. Reporting without
## withdrawing would say the same thing twice, once here and once at the
## signature.
##
## The fourth answer is the rows themselves, one per slot, because the caller
## has to charge what it packed and the declared row cannot tell it: `!io`
## absorbs the variables beside it, so a callee declared `!io !e` hands its
## caller a row with no trace of what `!e` turned out to be. See `check_call`'s
## `charged`.
fn evidence_var_args(
  cx: Cx,
  declared: Eff,
  em: Map[Int, Eff],
  lo: Int,
  hi: Int
) -> (Cx, List[TExpr], List[Int], List[Eff]) = {
  var cx1 = cx
  var out: List[TExpr] = []
  var unanswered: List[Int] = []
  var insts: List[Eff] = []
  for v in eff_vars(declared) {
    let (vid, _) = v
    let inst = match map.get(em, vid) {
      Some(e) -> e
      None -> EPure
    }
    let (cx2, slot, un) = evidence_pack(cx1, inst, true, lo, hi)
    cx1 = cx2
    out = out ++ [slot]
    unanswered = unanswered ++ un
    insts = insts ++ [inst]
  }
  (cx1, out, unanswered, insts)
}

## The evidence pack for a row: a **scope**, not a transcript.
##
## One build rule, and every call site that hands a pack over uses it -- a
## named callee's variable slot (`evidence_var_args`), a call through a
## function value, the remainder of a `with handle`, the environment an arm
## runs in. It is the whole of the design's §2:
##
##   * the **ground** atoms of the row -- its written labels -- become one
##     `ev$Pack{key, evidence, outer}` node each, keyed by `types.label_key`;
##   * they are consed **over the environment this frame already holds** for
##     the row's non-ground atoms (an effect variable, a rigid projection);
##   * no ground atom and exactly one non-ground atom means the pack **is**
##     that environment: identity, no node, no allocation. Every effect-
##     polymorphic signature in std is this case, which is why the convention
##     costs std nothing;
##   * **two or more** non-ground atoms are joined with `ev_append`, which is
##     the one case that cannot be a splice: two chains, one `outer` field.
##
## The forwarded environment is the **tail**, spliced, not a node of its own.
## `!Ask !e2` into an `!e` slot is one node over the caller's `e2` slot, not
## two nodes with the caller's pack wrapped as a value: a wrapped chain answers
## no key it used to answer, and a lookup miss is what that costs.
##
## A superset is safe. Lookup is by key, so a node nobody asks for is a step in
## a walk and nothing else; only a *missing* key is a fault. That is what lets
## the tail be an environment rather than a filtered copy of it, and it is the
## one step of the argument that is not obviously true.
##
## **Two or more non-ground atoms are joined, and the join is a primitive.** A
## row like `!e1 !e2` has two environments to put in one `outer` field, and
## merging two chains is not a cons -- it is a walk-and-rebuild, which needs to
## know where a chain ends, which is the shape test only a runtime can make
## (`types.ev_pack_adt`). So `ev_append` is the second walker, and the fold
## here is right-associative: `ev_append(e1, ev_append(e2, e3))` rebuilds each
## environment once, where folding the other way would rebuild the first one
## again for every atom after it.
##
## This is where the knife that landed the pack left a hole, and the hole was
## not academic. The short tail dropped every environment but one, so a reader
## asking for a key from a dropped one got `ev_get`'s compiler-invariant panic
## (`types.EV_MISS_MSG`) -- loud, and never another atom's evidence, but loud
## at run time, on a program that checks clean and that worked before the flip.
## The witness is eleven lines and now runs on both backends
## (scripts/spike-native/effect_two_vars.dawn):
##
##     fn thru(f: fn() -> Int !e) -> Int !e = f()
##     fn both(g: fn() -> Int !e1, h: fn() -> Int !e2) -> Int !e1 !e2 =
##       thru(() => g() + h())
##
## Nothing in this repository reached it -- all 20 effect-polymorphic
## signatures in std are a lone `!e`, and `packages/`, `selfhost/src` and the
## production ecosystem corpus declare no effects at all -- which is why every
## gate was green over the hole, and why the witness had to be written rather
## than found.
##
## **The one-atom case stays the identity forward.** It is not routed through
## `ev_append` for uniformity's sake: appending nothing to one chain would
## rebuild that chain to answer exactly what it already answered, which is a
## per-call allocation charged to every effect-polymorphic signature in std to
## make this function two lines shorter.
##
## `report` is the difference between a demand and a snapshot. A call site
## demanding a row it cannot answer is the "nobody is handling this" error, at
## the call -- the reporting surface the flip moves here from the raise site.
## The environment stored in a handler's `env` field is a snapshot of what is
## in scope, and reports nothing: whatever the arms raise was already resolved,
## and reported on, inside the arms themselves.
fn evidence_pack(cx: Cx, inst: Eff, report: Bool, lo: Int, hi: Int) -> (Cx, TExpr, List[Int]) = {
  var cx1 = cx
  let ground = eff_labels(inst)
  let vs = eff_vars(inst)
  let asx = eff_assocs(inst)
  # the environments this frame holds for the row's non-ground atoms, in row
  # order: the effect variables it names, then its projections. An atom the
  # frame has nothing for contributes nothing -- it is an error path, and the
  # slot it would have filled is answered by whatever is left.
  var envs: List[TExpr] = []
  for v in vs {
    let (svid, _) = v
    let (cxa, found) =
      ev_expr(cx1, ev_var_local_name(svid), var_key(svid), erased_ev_ty(), lo, hi)
    cx1 = cxa
    match found {
      Some(tx) -> { envs = envs ++ [tx] }
      None -> ()
    }
  }
  for a in asx {
    let (_, av, at2, an) = a
    let (cxa, found) =
      ev_expr(cx1, ev_assoc_local_name(av, at2, an), assoc_key(at2), erased_ev_ty(), lo, hi)
    cx1 = cxa
    match found {
      Some(tx) -> { envs = envs ++ [tx] }
      None -> ()
    }
  }
  # nothing to forward is the empty pack; one is that environment itself, no
  # node and no allocation; more than one is the join, folded from the right so
  # that each environment is rebuilt once and the first one stays frontmost.
  let no_wits: List[WitRef] = []
  # `ev_append`'s own row is pure, so it owes no evidence -- the packs it joins
  # are its ordinary arguments
  let no_ev: List[TExpr] = []
  var tail: TExpr = XUnit(lo, hi)
  if len(envs) > 0 {
    tail = envs[len(envs) - 1]
    var i = len(envs) - 1
    while i > 0 {
      i = i - 1
      tail = XCallBuiltin("ev_append", [envs[i], tail], no_wits, no_ev, lo, hi, erased_ev_ty())
    }
  }
  var acc = tail
  var unanswered: List[Int] = []
  for l in ground {
    let (eid, _) = l
    let (cxb, ev) =
      if report {
        let (cxr, tx, answered) = resolve_label_evidence(cx1, eid, lo, hi)
        if not answered { unanswered = unanswered ++ [eid] }
        (cxr, tx)
      } else {
        let nm = ev_local_name(cx1, eid)
        let (cxs, found) = ev_expr(cx1, nm, label_key(eid), TyAdt(eid, []), lo, hi)
        (cxs, match found {
          Some(tx) -> tx
          None -> XUnit(lo, hi)
        })
      }
    cx1 = cxb
    acc = XCtor(EV_PACK_ID, 0,
      [XInt(label_key(eid), lo, hi), ev, acc],
      [Some(0), Some(1), Some(2)], no_expr(), lo, hi, ev_pack_ty())
  }
  (cx1, acc, unanswered)
}

## The pack a call through a function **value** hands over, plus whatever the
## row's ground labels had to say about being unanswered.
##
## `types.fn_arity` says a function value takes exactly one evidence argument
## whatever its row, so this answers a one-element list and there is no second
## place that number is derived. The unanswered labels come back so the caller
## can take them out of the row it charges, exactly as `check_call` does for a
## named callee: one failure, one diagnostic.
fn dyn_evidence_args(cx: Cx, feff: Eff, lo: Int, hi: Int) -> (Cx, List[TExpr], List[Int]) = {
  let (cx1, pack, unanswered) = evidence_pack(cx, feff, true, lo, hi)
  (cx1, [pack], unanswered)
}

## One label's evidence out of the lexical environment -- the shared half of
## `evidence_args` (a written label), `evidence_assoc_args` (a projection that
## reduced to one) and `evidence_pack` (a ground atom of a row being packed).
## Answers the expression and whether anyone answered.
##
## It used to record, on the innermost closure, whether the hit was a `with
## handle` in this very body or a hidden parameter of the signature -- the
## distinction settlement was built on (docs/effects-soundness-design.md §4.2,
## and the p2 counterexample its long comment argued from). Nothing settles, so
## nothing asks: the label is charged either way and rides out with the row.
##
## What is new is the third outcome. Inside a closure, nothing in scope is not
## a failure: the label stays in the closure's row, and the call that runs the
## closure supplies the evidence (`ev_expr`). "Nobody is handling this" is
## still reported here, but for a named callee's own row and only outside every
## closure -- inside one it is reported at the call site instead, which is
## where a reader could actually name the call that went unanswered.
fn resolve_label_evidence(cx: Cx, eid: Int, lo: Int, hi: Int) -> (Cx, TExpr, Bool) = {
  var cx1 = cx
  let nm = ev_local_name(cx1, eid)
  let (cxa, found) = ev_expr(cx1, nm, label_key(eid), TyAdt(eid, []), lo, hi)
  cx1 = cxa
  match found {
    Some(tx) -> (cx1, tx, true)
    None -> {
      # inside comptime the refusal belongs to `leave_isolated`, which says
      # what the construct is; saying "declare it" there would be advice
      # that cannot be taken -- and because nothing is said here, the label
      # is not withdrawn from the row either: `leave_isolated` reads the row
      # to find out what to refuse
      if not cx1.frame.isolated {
        cx1 = unhandled_effect(cx1, eid, lo, hi)
        (cx1, XError(lo, hi), false)
      } else {
        (cx1, XError(lo, hi), true)
      }
    }
  }
}

## Rule 丙's call-site half: one evidence value per projection written in the
## callee's declared row, in `eff_assocs` order, behind the written labels'
## evidence.
##
## **A projection's slot carries a pack**, like an effect variable's and unlike
## a written label's, because a projection is the same kind of thing an effect
## variable is: an atom whose row the callee does not know. `lower.ev_from_pack`
## has said so all along -- "any other atom is answered by the chain as a
## whole" -- and this position used to hand over something else. A projection
## that reduced to a label handed over that label's evidence *record*, which is
## what a slot addressed by `label_key` holds, not what one addressed by
## `assoc_key` does. The two conventions agreed with each other for as long as
## nothing walked the slot: forwarding a projection through a rigid chain moves
## whatever arrived, and a devirtualised callee took the record straight back
## out with a cast. A row that reaches a *reader* is where they part, and the
## reader is a parameter: `fn f[T: P](t: fn() -> Int !T.E) -> Int !T.E = t()`
## calls a function value, the call hands the value the projection's slot as
## its pack, and the closure inside asks that pack for `label_key(Ask)`. A bare
## record answers no key at all, so a program that checks clean met `ev_get`'s
## compiler-invariant panic (`types.EV_MISS_MSG`) at run time (#355). It stayed
## hidden because `assoc_effects.dawn` writes its projections in *return* rows,
## where nothing walks them.
##
## So the reduction decides the row and `evidence_pack` decides the shape, once,
## the way it does for every other pack: a label becomes a node keyed by it,
## pure and io become the empty pack (the slot is erased and never read), and a
## projection still standing over a rigid subject *is* the caller's own hidden
## parameter -- identity, no allocation, which is what the rigid case always
## did. A binding is at most one atom today (`effect E = !(A | B)` is a parse
## error), so the first of those is one node; nothing here depends on that, and
## a rule that would have to be rewritten if it changed is a rule this position
## no longer owns.
##
## Returns (cx, args, unanswered label ids,
## unanswered atoms) -- the last two are withdrawn from the charged row so a
## single failure is a single diagnostic, like `evidence_args`' unanswered.
fn evidence_assoc_args(
  cx: Cx,
  declared: Eff,
  m: Map[Int, Ty],
  lo: Int,
  hi: Int
) -> (Cx, List[TExpr], List[Int], List[(String, Int, Int, String)]) = {
  var cx1 = cx
  var out: List[TExpr] = []
  var unanswered: List[Int] = []
  var dropped: List[(String, Int, Int, String)] = []
  for a in eff_assocs(declared) {
    let (s0, v0, t0, n0) = a
    let red = reduce_eff(cx1, EffAssoc(s0, v0, t0, n0), m)
    # A projection still standing over a rigid subject is answered by the
    # caller's own slot for the same atom, and nothing in scope is this
    # position's error to report. `evidence_pack` cannot report it -- an atom
    # it finds no environment for contributes nothing, on the grounds that the
    # miss was already diagnosed -- so the lookup is made here first, and the
    # diagnostic is the one the rigid case has always given.
    var missing = false
    for r in eff_assocs(red) {
      let (s2, v2, t2, n2) = r
      let nm = ev_assoc_local_name(v2, t2, n2)
      let (cxa, found) = ev_expr(cx1, nm, assoc_key(t2), erased_ev_ty(), lo, hi)
      cx1 = cxa
      match found {
        Some(_) -> ()
        None ->
          if not cx1.frame.isolated {
            cx1 = cerr_h(cx1, "the effect `" ++ s2 ++ "." ++ n2 ++
                "` needs evidence here, and nothing in scope supplies it", lo, hi,
              "a projection's evidence arrives through the signature: add `!" ++ s2 ++ "." ++
                n2 ++ "` to the enclosing function's row")
            dropped = dropped ++ [r]
            missing = true
          }
      }
    }
    if missing {
      out = out ++ [XError(lo, hi)]
    } else {
      let (cx2, pack, un) = evidence_pack(cx1, red, true, lo, hi)
      cx1 = cx2
      unanswered = unanswered ++ un
      out = out ++ [pack]
    }
  }
  (cx1, out, unanswered, dropped)
}

## A row without the named projection atoms -- `eff_drop`'s twin, for the one
## caller that withdraws what nobody answered.
fn eff_drop_assocs(e: Eff, atoms: List[(String, Int, Int, String)]) -> Eff = {
  if len(atoms) == 0 { return e }
  eff_map_assocs(e, a => {
    let (_, av, at2, an) = a
    var keep = true
    for d in atoms {
      let (_, dv, dt, dn) = d
      if dv == av && dt == at2 && dn == an { keep = false }
    }
    if keep {
      let (s2, v2, t2, n2) = a
      EffAssoc(s2, v2, t2, n2)
    } else {
      EPure
    }
  })
}

## A row without the named labels. The one caller drops the labels nobody
## answered, so a single unhandled call is a single diagnostic.
fn eff_drop(e: Eff, ids: List[Int]) -> Eff = {
  if len(ids) == 0 { return e }
  var ls: List[(Int, String)] = []
  for l in eff_labels(e) {
    let (id, _) = l
    if not list.contains(ids, id) { ls = ls ++ [l] }
  }
  eff_with_labels(eff_base(e), ls)
}

## docs/effects-design.md §4.2: the effect is used, and nothing in scope
## answers it. Either the signature admits it, or a handler discharges it.
##
## Inside `main` only the second way out exists: `pass_main_check` refuses a
## label on main's row outright (docs/effects-design.md §4.2, spec §6.5), so
## offering "add !E to the signature" here sends the reader into a second
## error. The narrowed hint says why the missing half is missing rather than
## dropping it silently.
fn unhandled_effect(cx: Cx, eid: Int, lo: Int, hi: Int) -> Cx = {
  let nm = effect_of(cx, eid).name
  let (who, is_main) = match cx.frame.current_sig {
    Some(sg) -> ("`" ++ sg.name ++ "`", sg.name == "main")
    None -> ("this code", false)
  }
  let hint = if is_main {
    "nothing calls main, so nothing can answer a declared effect: handle it here with " ++
      "`with handle " ++ nm ++ " { ... }`"
  } else {
    "add !" ++ nm ++ " to the signature, or answer it here with `with handle " ++ nm ++
      " { ... }`"
  }
  cerr_h(cx, who ++ " uses the effect `" ++ nm ++ "`, but its signature does not declare !" ++ nm,
    lo, hi, hint)
}

## Is `vid`'s inference failure nothing but an echo of the fields the call left
## out? True only when the fields that are missing are the *whole* story: `vid`
## is mentioned by at least one of them and by none of the fields that were
## supplied, so the constructor had no other place to learn it from.
##
## Why per parameter and not per call: `type Ph[T] = P(x: Int)` mentions `T` in
## no field at all, so `P()` still has to say `T` cannot be inferred -- and
## `P(1)`, which has no arity error, proves that sentence stands on its own.
## Why a supplied field disqualifies: an argument *was* given in a position
## mentioning `vid` and still did not bind it, so filling in the missing fields
## is not the only thing wrong and the annotation hint is not misleading.
##
## The expected type is the other source, and it does not need testing here: the
## caller already tried it (`unbound_any` above), so a parameter still unbound
## is one the context could not supply either.
fn infer_blocked_by_missing(ci: CtorI, slots: List[Option[Int]], vid: Int) -> Bool = {
  var in_missing = false
  var in_present = false
  var i = 0
  for f in ci.fields {
    if ty_mentions_var(f.ty, vid) {
      match slots[i] {
        Some(_) -> { in_present = true }
        None -> { in_missing = true }
      }
    }
    i = i + 1
  }
  in_missing && not in_present
}

## How the constructor was *spelled* at this use site. This used to be one
## `has_parens: Bool`, and that Bool could not tell `Point { x: 1 }` from
## `Point(1)`: both arrived as `true`, so the braces-only rule for records
## (spec §2.4) checked nothing on the parenthesised spelling and `Point(1, 2)`
## compiled. Three spellings, three cases -- the record rule then falls out of
## a match instead of out of a negation nobody could read.
type CtorUse =
  # `None`, `Point` -- no arguments written at all
  | CBare
# `Point { x: 1 }` / `Point { ..p }` -- the record literal, the only way to
# build a record
  | CBraces
# `Some(1)` / `m.C(1)` -- the general application postfix over a constructor
# head (SYN-02), including the one a pipe writes for you (SYN-05)
  | CApply

## Ctor(args) / Record { fields } / bare Name (the Kotlin checkCtorCall): also
## the landing site for SCREAMING_SNAKE constant references.
## `pre` is the constructor already resolved by the caller -- how a qualified
## spelling (`m.C`, LANG-06) reaches exactly this checking without the name
## being in scope. Everything after resolution (field names, arity, spread,
## generic instantiation, ctor-as-value) is then one implementation, so the
## qualified form cannot drift from the local one.
fn check_ctor_call(
  cx: Cx,
  cname: String,
  cargs: List[Arg],
  spread: Option[Expr],
  spelling: CtorUse,
  expected: Option[Ty],
  pre: Option[(Int, Int)],
  cclo: Int,
  cchi: Int,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  let spelled_out = spelling != CBare
  var cx1 = cx
  let has_spread = match spread {
    Some(_) -> true
    None -> false
  }
  let key = match pre {
    Some(k) -> Some(k)
    None -> map.get(cx1.ctors_by_name, cname)
  }
  match key {
    None -> {
      # a bare SCREAMING_SNAKE name may be a constant reference; inside a
      # const initializer only earlier constants are visible (spec §3.2)
      let visible = match cx1.const_cutoff {
        Some(cut) -> set.has(cut, cname)
        None -> true
      }
      var cd: Option[Ty] = None
      if visible { cd = map.get(cx1.consts, cname) }
      match cd {
        Some(ct) -> {
          if spelled_out || len(cargs) > 0 || has_spread {
            return (cerr(cx1, "`" ++ cname ++ "` is a constant, not a constructor", cclo, cchi),
              TyError, XError(lo, hi))
          }
          return (cx1, ct, XConstRef("", cname, lo, hi, ct))
        }
        None -> ()
      }
      match spread {
        Some(sp) -> {
          let (cxa, _, _) = check_expr(cx1, sp, no_expected())
          cx1 = cxa
        }
        None -> ()
      }
      for a in cargs {
        let (cxa, _, _) = check_expr(cx1, a.e, no_expected())
        cx1 = cxa
      }
      let hint: Option[String] = if map.has(cx1.adts_by_name, cname) {
        let aid0 = map.get(cx1.adts_by_name, cname).expect("has")
        let ad0 = adt_of(cx1.adts, aid0)
        var cnames: List[String] = []
        for c in ad0.ctors { cnames = cnames ++ [c.name] }
        Some("`" ++ cname ++ "` is a type; build a value with one of its constructors: " ++
            join(cnames, ", "))
      } else if set.has(cx1.all_const_names, cname) {
        Some("const `" ++ cname ++
            "` is declared later in the file; constants are evaluated top to bottom")
      } else {
        suggest.hint(cname, map.keys(cx1.ctors_by_name) ++ map.keys(cx1.consts))
      }
      return (cerr_o(cx1, "undefined constructor: " ++ cname, cclo, cchi, hint),
        TyError, XError(lo, hi))
    }
    Some(_) -> ()
  }
  let (aid, cslot) = key.expect("ctor")
  let ad = adt_of(cx1.adts, aid)
  let ci = ad.ctors[cslot]
  let n = len(ci.fields)
  let self_ty = adt_self_ty(ad)
  var exp_is_fn = false
  var exp_fn_ps: List[Ty] = []
  var exp_fn_ret = TyUnit
  var exp_fn_eff = EPure
  match expected {
    Some(TyFn(ps2, r2, ef2)) -> {
      exp_is_fn = true
      exp_fn_ps = ps2
      exp_fn_ret = r2
      exp_fn_eff = ef2
    }
    _ -> ()
  }
  # a record is built with braces and with nothing else (spec §2.4). `Point(1, 2)`
  # is the spelling this rule exists to refuse, and until CtorUse existed it was
  # indistinguishable here from `Point { x: 1, y: 2 }` -- so it compiled. The
  # check sits on the spelling rather than on the arguments because `Point()` is
  # the same mistake with nothing inside it, and because the pipe (SYN-05) can
  # now write an application over any head, including this one.
  if spelling == CApply && ad.is_record {
    return (cerr_h(cx1,
      "record `" ++ ci.name ++ "` must be built with braces: " ++ ci.name ++ " { ... }",
      lo, hi, "constructor: " ++ ctor_render(cx1.adts, ci)), TyError, XError(lo, hi))
  }
  if spelling == CBare && n > 0 {
    # a bare constructor with fields, in a function-typed position, is a function value
    if not ad.is_record && exp_is_fn {
      return check_ctor_value(cx1, aid, cslot, exp_fn_ps, exp_fn_ret, exp_fn_eff, lo, hi)
    }
    let msg = if ad.is_record {
      "record `" ++ ci.name ++ "` must be built with braces: " ++ ci.name ++ " { ... }"
    } else {
      "constructor `" ++ ci.name ++ "` has " ++ to_string(n) ++
        " field(s) and cannot be used bare"
    }
    return (cerr_h(cx1, msg, lo, hi, "constructor: " ++ ctor_render(cx1.adts, ci)),
      TyError, XError(lo, hi))
  }
  # a bare nullary constructor where a function is expected: a value, not a function
  if spelling == CBare && n == 0 && exp_is_fn {
    return (cerr_h(cx1, "`" ++ ci.name ++ "` is a value, not a function (it takes no fields)",
      lo, hi, "use it directly; only constructors with fields can be passed as functions"),
      TyError, XError(lo, hi))
  }
  var m: Map[Int, Ty] = map.empty()
  var em: Map[Int, Eff] = map.empty()
  # seed inference from the expected result type (helps nested cases like Some(None))
  match expected {
    Some(et) ->
      if len(ad.tparams) > 0 && is_concrete(cx1, et) {
        let (m2, em2, _) = unify_into(cx1, self_ty, et, m, em)
        m = m2
        em = em2
      }
    None -> ()
  }
  var spread_tx: Option[TExpr] = None
  match spread {
    Some(sp) -> {
      if not ad.is_record {
        cx1 = cerr(cx1, "`..base` functional update only works on records", e_lo(sp), e_hi(sp))
      }
      let sexp: Option[Ty] = if is_concrete(cx1, self_ty) { Some(self_ty) } else { None }
      let (cxa, bt, sx) = check_expr(cx1, sp, sexp)
      cx1 = cxa
      let (m3, em3, ok) = unify_into(cx1, self_ty, bt, m, em)
      m = m3
      em = em3
      if not ok {
        cx1 = cerr(cx1, "`..base` must be a " ++ ad.name ++ ", got " ++ ty_show(cx1.adts, bt),
          e_lo(sp), e_hi(sp))
      }
      spread_tx = Some(sx)
    }
    None -> ()
  }
  # resolve the argument → field mapping (positional prefix, then named) --
  # types.ctor_slots, the same decision the pattern side makes. What is left
  # here is the call half: the wording, and that an argument with no field of
  # its own is checked now, with no expected type, so its own errors are
  # reported and `atx` holds something for the emitter. An argument that *did*
  # land on a field is checked in the two rounds below instead, where the
  # field's type is known.
  # `idx_of` and `atx` are indexed by argument and the loops below walk the
  # arguments in order, so both grow by appending. `slots` is indexed by field,
  # so its pairs are collected here and assembled after the loop (see
  # check_call: an indexed write rebuilds the whole list).
  var claimed: List[(Int, Int)] = []
  var idx_of: List[Int] = []
  var atx: List[Option[TExpr]] = []
  var anames: List[Option[String]] = []
  for a in cargs { anames = anames ++ [a.name] }
  let trailing = len(cargs) > 0 && cargs[len(cargs) - 1].trailing
  let picks = ctor_slots(ci.fields, anames, trailing)
  var args_broken = false
  var i = 0
  for a in cargs {
    var idx = -1
    match picks[i] {
      SlotAt(at) -> { idx = at }
      SlotNoField(an) -> {
        var fnames: List[String] = []
        for f in ci.fields { fnames = fnames ++ [f.name] }
        let h = match suggest.hint(an, fnames) {
          Some(hh) -> hh
          None -> "constructor: " ++ ctor_render(cx1.adts, ci)
        }
        cx1 = cerr_h(cx1, "`" ++ ci.name ++ "` has no field `" ++ an ++ "`", a.lo, a.hi, h)
        args_broken = true
      }
      SlotAfterNamed -> {
        cx1 = cerr(cx1, "positional arguments cannot follow named arguments", a.lo, a.hi)
        args_broken = true
      }
      # counted below
      SlotOverflow -> ()
      SlotTaken(at) -> {
        if trailing && i == len(cargs) - 1 {
          cx1 = cerr(cx1, "the last field `" ++ ci.fields[at].name ++
              "` is already given; the tail block is what fills it", a.lo, a.hi)
        } else {
          cx1 = cerr(cx1, "field `" ++ ci.fields[at].name ++ "` is given twice", a.lo, a.hi)
        }
        args_broken = true
      }
    }
    if idx < 0 {
      let (cxa, _, ax) = check_expr(cx1, a.e, no_expected())
      cx1 = cxa
      atx = atx ++ [Some(ax)]
      idx_of = idx_of ++ [-1]
    } else {
      claimed = claimed ++ [(idx, i)]
      atx = atx ++ [no_texpr()]
      idx_of = idx_of ++ [idx]
    }
    i = i + 1
  }
  # ctor_slots hands out each field at most once -- a second argument for it
  # comes back SlotTaken with no pick -- so one scan per field answers who
  # claimed it, and a later pair still wins as an indexed write did.
  var slots: List[Option[Int]] = []
  var fk = 0
  for _fk in 0..n {
    var so: Option[Int] = no_int()
    for c in claimed {
      let (cf, ca) = c
      if cf == fk { so = Some(ca) }
    }
    slots = slots ++ [so]
    fk = fk + 1
  }
  # two rounds of checking (see check_call)
  for round in 0..2 {
    var atx_next: List[Option[TExpr]] = []
    var j = 0
    for a in cargs {
      let idx = idx_of[j]
      var atx_j = atx[j]
      let already = match atx_j {
        Some(_) -> true
        None -> false
      }
      if idx >= 0 && not already {
        if not (round == 0 && needs_expected(cx1, a.e)) {
          let declared = ci.fields[idx].ty
          let sub = subst(declared, m, em)
          let exp2: Option[Ty] = if is_concrete(cx1, sub) { Some(sub) } else { None }
          let (cxa, at, ax) = check_expr(cx1, a.e, exp2)
          cx1 = cxa
          atx_j = Some(ax)
          let (m3, em3, ok) = unify_into(cx1, declared, at, m, em)
          m = m3
          em = em3
          if not ok {
            cx1 = cerr_h(cx1, "field `" ++ ci.fields[idx].name ++ "` of `" ++ ci.name ++
                "` is " ++ ty_show(cx1.adts, subst(declared, m, em)) ++ ", got " ++
                ty_show(cx1.adts, at), e_lo(a.e), e_hi(a.e),
              "constructor: " ++ ctor_render(cx1.adts, ci))
          }
        }
      }
      atx_next = atx_next ++ [atx_j]
      j = j + 1
    }
    atx = atx_next
  }
  # `em` is final here. A constructor binds no effect variables of its own, so
  # every variable its field types write is the declaration's, and the row it
  # was just instantiated with has to be one nothing has to carry.
  var field_tys: List[Ty] = []
  for f in ci.fields { field_tys = field_tys ++ [f.ty] }
  let no_binders: List[(Int, String)] = []
  cx1 = refuse_decl_eff_inst(cx1, field_tys, no_binders, em, lo, hi)
  var missing_reported = false
  if not args_broken {
    var missing: List[String] = []
    var fi2 = 0
    for f in ci.fields {
      let filled = match slots[fi2] {
        Some(_) -> true
        None -> false
      }
      if not filled { missing = missing ++ [f.name] }
      fi2 = fi2 + 1
    }
    # Wrong arity does not destroy the knowledge of what is being constructed,
    # so this keeps reporting and returns the constructed type below -- the same
    # rule `check_call` follows for a wrong-arity function call. The knowledge
    # really is gone when a type parameter could not be inferred, and that case
    # is already handled: the `unbound` check further down returns TyError.
    #
    # It is tempting to return TyError here so that `fn f() -> Int = Zero(1)`
    # reports the arity and stops. But the second sentence there survives fixing
    # the first (`fn f() -> Int = Zero` still does not return an Int), so it is a
    # separate mistake, not a cascade -- suppressing it only defers it a rebuild.
    if len(cargs) > n {
      cx1 = cerr_h(cx1, "`" ++ ci.name ++ "` takes " ++ to_string(n) ++ " field(s), got " ++
          to_string(len(cargs)), lo, hi, "constructor: " ++ ctor_render(cx1.adts, ci))
    } else if len(missing) > 0 && not has_spread {
      cx1 = cerr_h(cx1, "missing field(s) in `" ++ ci.name ++ "`: " ++ join(missing, ", "),
        lo, hi, "constructor: " ++ ctor_render(cx1.adts, ci))
      missing_reported = true
    }
  }
  # instantiate the type arguments; fall back to the expected type (bare None etc.)
  var unbound_any = false
  for tp in ad.tparams {
    match tp {
      TyVar(_, vid) -> if not map.has(m, vid) { unbound_any = true }
      _ -> ()
    }
  }
  if unbound_any {
    match expected {
      Some(et) -> {
        let (m4, em4, _) = unify_into(cx1, self_ty, et, m, em)
        m = m4
        em = em4
      }
      None -> ()
    }
  }
  # A parameter whose only possible source of information was a field the call
  # left out is dropped from the sentence: it is an echo of the arity error
  # above, and its hint asks for an annotation that leaves the real mistake in
  # place. Per parameter, not per call -- see `infer_blocked_by_missing`. The
  # return type stays TyError whenever anything is unbound, reported or not:
  # the constructed type genuinely is unknown, and handing back a `Box[T]` with
  # a free `T` is what put a bare `T` in the next diagnostic.
  var unbound: List[String] = []
  var unbound_all = false
  for tp in ad.tparams {
    match tp {
      TyVar(nm, vid) ->
        if not map.has(m, vid) {
          unbound_all = true
          if not (missing_reported && infer_blocked_by_missing(ci, slots, vid)) {
            unbound = unbound ++ [nm]
          }
        }
      _ -> ()
    }
  }
  if len(unbound) > 0 {
    return (cerr_h(cx1, "cannot infer type parameter(s) " ++ join(unbound, ", ") ++
        " for `" ++ ci.name ++ "`", lo, hi,
      "add a type annotation, e.g. let x: " ++ ad.name ++ "[...] = " ++ ci.name),
      TyError, XError(lo, hi))
  }
  if unbound_all { return (cx1, TyError, XError(lo, hi)) }
  var written: List[TExpr] = []
  for sl in atx {
    match sl {
      Some(ax) -> { written = written ++ [ax] }
      None -> { written = written ++ [XError(lo, hi)] }
    }
  }
  let rt = subst(self_ty, m, em)
  (cx1, rt, XCtor(aid, cslot, written, slots, spread_tx, lo, hi, rt))
}

# ---- Java interop calls (spec §9) ----

fn is_java_ty(t: Ty) -> Bool =
  match t {
    TyJava(_, _) -> true
    _ -> false
  }

fn is_prim_name(p: String) -> Bool =
  p == "long" || p == "int" || p == "short" || p == "byte" || p == "double" ||
  p == "float" || p == "boolean" || p == "char" || p == "void"

fn sam_of_nonprim(js: Jsig, p: String) -> Option[JMethod] !io =
  if is_prim_name(p) { None } else { js.sam_of(p) }

fn sam_param_ty(js: Jsig, p: String) -> Option[Ty] !io =
  if p == "long" || p == "int" || p == "short" || p == "byte" {
    Some(TyInt)
  } else if p == "double" || p == "float" {
    Some(TyFloat)
  } else if p == "boolean" {
    Some(TyBool)
  } else if p == "char" {
    None
  } else if p == "java.lang.String" {
    Some(TyString)
  } else {
    Some(TyJava(p, js.class_info(p).display))
  }

## SAM signature → the Dawn function shape a converted argument must have
## (spec §9.4). Callback parameters arrive unwrapped. A char parameter remains
## unconvertible; a char return seeds Never, so only a diverging callback fits.
fn sam_fn_ty(js: Jsig, sm: JMethod) -> Option[(List[Ty], Ty)] !io = {
  var ps: List[Ty] = []
  for p in sm.param_cls {
    match sam_param_ty(js, p) {
      Some(t) -> { ps = ps ++ [t] }
      None -> return None
    }
  }
  let r = sm.ret_cls
  let ret: Option[Ty] = if r == "void" {
    Some(TyUnit)
  } else if r == "long" || r == "int" || r == "short" || r == "byte" {
    Some(TyInt)
  } else if r == "double" || r == "float" {
    Some(TyFloat)
  } else if r == "boolean" {
    Some(TyBool)
  } else if r == "char" {
    Some(TyNever)
  } else if r == "java.lang.String" {
    Some(TyString)
  } else {
    Some(TyJava(r, js.class_info(r).display))
  }
  match ret {
    Some(rt) -> Some((ps, rt))
    None -> None
  }
}

## May a Dawn return land where the SAM asks for j? (the boxed rep must be assignable)
fn sam_ret_compatible(js: Jsig, r: Ty, j: String) -> Bool !io =
  if j == "void" {
    r == TyUnit || r == TyNever
  } else if j == "long" || j == "int" || j == "short" || j == "byte" {
    r == TyInt || r == TyNever
  } else if j == "double" || j == "float" {
    r == TyFloat || r == TyNever
  } else if j == "boolean" {
    r == TyBool || r == TyNever
  } else if j == "char" {
    r == TyNever
  } else {
    match r {
      TyString -> js.is_assignable(j, "java.lang.String")
      TyInt -> js.is_assignable(j, "java.lang.Long")
      TyFloat -> js.is_assignable(j, "java.lang.Double")
      TyBool -> js.is_assignable(j, "java.lang.Boolean")
      TyJava(fq, _) -> js.is_assignable(j, fq)
      TyNever -> true
      _ -> false
    }
  }

## May a function value with this row cross to Java? Only if it owes no
## evidence (spec §9.4).
##
## A converted function value is entered from Java with no Dawn frame under
## it. `jvm/emit.gen_sam_bridge` has no call site to take an evidence pack
## from, so it passes null, and a row with anything to answer for is then an
## `ev_get` panic at run time on a body that checked clean. The check belongs
## here because the conversion is written here and happens once, while the
## calls into it are Java's and unbounded in number, time and thread.
##
## Pure and `!io` are the whole of the accepted set, and the normal form makes
## that a two-arm match: every other constructor names a slot the Java caller
## cannot fill. `ELabeled` always carries at least one label, `EUnion` at
## least one variable or projection, and a label and a projection each stand
## for evidence the way a variable does.
##
## An effect variable is refused even though the row it stands for might turn
## out pure. The conversion is checked once and the variable may equally be
## instantiated at a label, which would hand Java a function it cannot call;
## the refusal is what makes the accepted set closed under instantiation.
##
## Nothing here reduces a projection first. Reduction is eager (D3), so one
## that survives to a call site still has a rigid subject, which is exactly
## the case that owes.
##
## The precedent is the same shape in two other languages: Kotlin refuses
## `suspend` in a SAM conversion (KT-40978), and OCaml 5 will not resume an
## effect through a C frame. A foreign caller is not a handler site.
fn sam_row_ok(e: Eff) -> Bool =
  match e {
    EPure -> true
    EIo -> true
    _ -> false
  }

## The way out, named in terms of the row that was refused: a `with handle`
## written inside the function value discharges the label there, and what
## crosses is then pure or `!io`. A variable or a projection has no such
## rewrite, so that arm says why it is refused rather than offering one.
fn sam_row_hint(e: Eff) -> String = {
  let ls = eff_labels(e)
  if len(ls) == 0 {
    return "an effect variable or an associated-effect projection may stand " ++
      "for a label, so it does not cross either; give this function value a " ++
      "pure or `!io` row"
  }
  let (_, n) = ls[0]
  "write the handler inside the function value, so that the row crossing is " ++
    "pure or `!io`:\n  () => { with handle " ++ n ++ " { ... } ... }"
}

fn sam_row_err(cx: Cx, a: Expr, p: String, e: Eff) -> Cx !io =
  cerr_h(cx, "this function cannot cross to `" ++ cx.jsig.class_info(p).simple ++
      "`: its row" ++ eff_suffix(e) ++ " owes evidence",
    e_lo(a), e_hi(a),
    "a Java caller has no call site to supply an evidence pack, so only a " ++
      "pure or `!io` function value converts (spec §9.4)\n  " ++ sam_row_hint(e))

## Function-shaped arguments that need the target SAM to be typed are deferred:
## scored by arity now, checked once the winning overload is known.
fn sam_deferred(cx: Cx, a: Expr) -> Bool =
  match a {
    ELambda(ps, _, _, _, _) -> {
      for p in ps {
        match p.ann {
          None -> return true
          Some(_) -> ()
        }
      }
      false
    }
    ECtor(cn, cargs2, sp, hp, _, _, _, _) -> {
      if hp || len(cargs2) > 0 { return false }
      match sp {
        Some(_) -> return false
        None -> ()
      }
      match map.get(cx.ctors_by_name, cn) {
        Some(k) -> {
          let (aid, cslot) = k
          len(adt_of(cx.adts, aid).ctors[cslot].fields) > 0
        }
        None -> false
      }
    }
    _ -> false
  }

fn deferred_arity(cx: Cx, a: Expr) -> Int =
  match a {
    ELambda(ps, _, _, _, _) -> len(ps)
    ECtor(cn, _, _, _, _, _, _, _) ->
      match map.get(cx.ctors_by_name, cn) {
        Some(k) -> {
          let (aid, cslot) = k
          len(adt_of(cx.adts, aid).ctors[cslot].fields)
        }
        None -> 0
      }
    _ -> 0
  }

## How well one Java parameter class accepts an argument (spec §9.3); None = no fit.
fn param_score(cx: Cx, p: String, at: Option[Ty], arity: Int) -> Option[Int] !io =
  match at {
    # deferred lambda / bare constructor: match a convertible SAM by arity
    None ->
      match sam_of_nonprim(cx.jsig, p) {
        Some(sm) ->
          match sam_fn_ty(cx.jsig, sm) {
            Some(ft) -> {
              let (sps, _) = ft
              if len(sps) == arity { Some(2) } else { None }
            }
            None -> None
          }
        None -> None
      }
    Some(t) ->
      match t {
        TyInt -> if p == "long" { Some(2) } else if p == "int" { Some(1) } else { None }
        TyFloat -> if p == "double" { Some(2) } else if p == "float" { Some(1) } else { None }
        TyBool -> if p == "boolean" { Some(2) } else { None }
        TyString ->
          if p == "java.lang.String" {
            Some(2)
          } else if cx.jsig.is_assignable(p, "java.lang.String") {
            Some(1)
          } else {
            None
          }
        # Bytes is a raw byte[] at runtime, so it passes to Java byte[] params directly
        TyBytes ->
          if p == "[B" {
            Some(2)
          } else if not is_prim_name(p) && cx.jsig.is_assignable(p, "[B") {
            Some(1)
          } else {
            None
          }
        TyJava(fq, _) ->
          if p == fq {
            Some(2)
          } else if cx.jsig.is_assignable(p, fq) {
            Some(1)
          } else {
            None
          }
        TyFn(fps, fret, _) ->
          match sam_of_nonprim(cx.jsig, p) {
            Some(sm) ->
              match sam_fn_ty(cx.jsig, sm) {
                Some(ft) -> {
                  let (sps, _) = ft
                  if fps == sps && sam_ret_compatible(cx.jsig, fret, sm.ret_cls) {
                    Some(2)
                  } else {
                    None
                  }
                }
                None -> None
              }
            None -> None
          }
        # a Dawn List bridges to the three collection interfaces only (spec §9.6)
        TyList(_) ->
          if p == "java.util.List" {
            Some(2)
          } else if p == "java.util.Collection" || p == "java.lang.Iterable" {
            Some(1)
          } else {
            None
          }
        _ -> None
      }
  }

## Reflection returns methods in an unspecified, process-varying order; sort
## by rendering so resolution and candidate lists are deterministic.
fn sort_methods(ms: List[JMethod]) -> List[JMethod] = {
  var out: List[JMethod] = []
  for m2 in ms {
    var i = 0
    var placed = false
    var next: List[JMethod] = []
    for x in out {
      if not placed && m2.desc < x.desc {
        next = next ++ [m2]
        placed = true
      }
      next = next ++ [x]
    }
    if not placed { next = next ++ [m2] }
    out = next
  }
  out
}

fn sort_ctors(cs: List[JCtor]) -> List[JCtor] = {
  var out: List[JCtor] = []
  for c in cs {
    var placed = false
    var next: List[JCtor] = []
    for x in out {
      if not placed && c.desc < x.desc {
        next = next ++ [c]
        placed = true
      }
      next = next ++ [x]
    }
    if not placed { next = next ++ [c] }
    out = next
  }
  out
}

## The i-th parameter as the argument at i sees it: inside a packed variadic
## part that is the array's component type, not the array.
fn param_at(js: Jsig, params: List[String], packs: Bool, i: Int) -> String !io =
  if packs && i >= len(params) - 1 {
    js.component_of(params[len(params) - 1]).expect("varargs component")
  } else {
    params[i]
  }

fn score_with(
  cx: Cx,
  params: List[String],
  packs: Bool,
  ats: List[Option[Ty]],
  arities: List[Int]
) -> Option[Int] !io = {
  if packs {
    if len(ats) < len(params) - 1 { return None }
  } else if len(params) != len(ats) {
    return None
  }
  var total = 0
  var i = 0
  while i < len(ats) {
    match param_score(cx, param_at(cx.jsig, params, packs, i), ats[i], arities[i]) {
      Some(sc) -> { total = total + sc }
      None -> return None
    }
    i = i + 1
  }
  Some(total)
}

## Two-phase resolution (spec §9.3, after JLS): phase 1 tries every candidate
## without varargs packing; only if that fails does phase 2 pack. The phase,
## not the score, decides first — packing scores grow with arity.
fn fit_score(
  cx: Cx,
  params: List[String],
  is_varargs: Bool,
  ats: List[Option[Ty]],
  arities: List[Int]
) -> Option[(Int, Int)] !io = {
  match score_with(cx, params, false, ats, arities) {
    Some(sc) -> return Some((1, sc))
    None -> ()
  }
  if is_varargs {
    match score_with(cx, params, true, ats, arities) {
      Some(sc) -> return Some((0, sc))
      None -> ()
    }
  }
  None
}

## Error paths: type the deferred arguments so their subtrees get visited.
fn check_deferred(cx: Cx, args: List[Expr], ats: List[Option[Ty]]) -> Cx !io = {
  var cx1 = cx
  var i = 0
  for a in args {
    let deferred = match ats[i] {
      Some(_) -> false
      None -> true
    }
    if deferred {
      let (cxa, _, _) = check_expr(cx1, a, no_expected())
      cx1 = cxa
    }
    i = i + 1
  }
  cx1
}

## The winner is known: type deferred arguments against their SAM's shape and
## validate List-bridged positions (spec §9.4, §9.6). Positions in a packed
## variadic part resolve to the component type.
fn finalize_sams(
  cx: Cx,
  params: List[String],
  packs: Bool,
  args: List[Expr],
  ats: List[Option[Ty]],
  atx: List[Option[TExpr]]
) -> (Cx, List[Option[TExpr]], List[(Int, String, String, List[String], String)], List[Int]) !io = {
  var cx1 = cx
  # `atx` is the caller's per-argument list, so this walk rebuilds it by
  # appending each position's entry rather than writing into a copy
  var atx2: List[Option[TExpr]] = []
  var convs: List[(Int, String, String, List[String], String)] = []
  var bridges: List[Int] = []
  var i = 0
  for a in args {
    let p = param_at(cx1.jsig, params, packs, i)
    var out_i = atx[i]
    match ats[i] {
      None -> {
        let sm = sam_of_nonprim(cx1.jsig, p).expect("sam scored")
        let ft = sam_fn_ty(cx1.jsig, sm).expect("sam shape scored")
        let (sps, sret) = ft
        let (cxa, t, ax) = check_expr(cx1, a, Some(TyFn(sps, sret, EIo)))
        cx1 = cxa
        out_i = Some(ax)
        var fits = false
        # a row that owes evidence is a separate refusal from a shape mismatch,
        # and it gets its own diagnostic: the shape is right, the out is not
        # "write a different lambda" but "handle the label inside this one"
        var owes: Option[Eff] = None
        match t {
          TyFn(tps, tret, te) ->
            if tps == sps && sam_ret_compatible(cx1.jsig, tret, sm.ret_cls) {
              if sam_row_ok(te) { fits = true } else { owes = Some(te) }
            }
          _ -> ()
        }
        if fits { convs = convs ++ [(i, p, sm.name, sm.param_cls, sm.ret_cls)] }
        match owes {
          Some(te) -> { cx1 = sam_row_err(cx1, a, p, te) }
          None -> ()
        }
        if not fits && owes == None && not is_errorish(t) {
          cx1 = cerr_h(cx1, "this function does not fit `" ++ cx1.jsig.class_info(p).simple ++ "`",
            e_lo(a), e_hi(a),
            "expected shape: " ++ ty_show(cx1.adts, TyFn(sps, sret, EIo)) ++
              "\n  single abstract method: " ++ sm.desc)
        }
      }
      Some(t) ->
        match t {
          TyFn(_, _, te) ->
            match sam_of_nonprim(cx1.jsig, p) {
              Some(sm2) ->
                if sam_row_ok(te) {
                  convs = convs ++ [(i, p, sm2.name, sm2.param_cls, sm2.ret_cls)]
                } else {
                  cx1 = sam_row_err(cx1, a, p, te)
                }
              None -> ()
            }
          TyList(el) -> {
            # zero-copy bridge: elements cross as their boxed reps, so only
            # scalars, String and Java references may cross (spec §9.6)
            let bridgeable = el == TyInt || el == TyFloat || el == TyBool ||
              el == TyString || is_java_ty(el)
            if bridgeable { bridges = bridges ++ [i] }
            if not bridgeable {
              cx1 = cerr_h(cx1, "cannot bridge " ++ ty_show(cx1.adts, t) ++ " to `" ++
                  cx1.jsig.class_info(p).simple ++ "`: element type " ++ ty_show(cx1.adts, el) ++
                  " does not cross", e_lo(a), e_hi(a),
                "bridgeable elements: Int, Float, Bool, String, and Java classes; " ++
                  "nested containers, ADTs, tuples and functions stay on the Dawn side (spec §9.6)")
            }
          }
          _ -> ()
        }
    }
    atx2 = atx2 ++ [out_i]
    i = i + 1
  }
  (cx1, atx2, convs, bridges)
}

## Java return types → Dawn (spec §9.2): references land wrapped in Option.
fn map_java_return(cx: Cx, rc: String, nlo: Int, nhi: Int) -> (Cx, Ty) !io =
  if rc == "void" {
    (cx, TyUnit)
  } else if rc == "long" || rc == "int" || rc == "short" || rc == "byte" {
    (cx, TyInt)
  } else if rc == "double" || rc == "float" {
    (cx, TyFloat)
  } else if rc == "boolean" {
    (cx, TyBool)
  } else if rc == "char" {
    (cerr_h(cx, "`char` cannot map directly to Dawn `Char`", nlo, nhi,
      "Java `char` is one UTF-16 code unit, while Dawn `Char` is a Unicode scalar; " ++
        "use a Java adapter that returns a decoded code point as `int` (then call `char.of`) " ++
        "or returns `String`"), TyError)
  } else if rc == "java.lang.String" {
    (cx, opt_ty(TyString))
  } else if rc == "[B" {
    # a Java byte[] return is a first-class Bytes (spec §9.5)
    (cx, opt_ty(TyBytes))
  } else {
    # not-imported classes and arrays are still usable as opaque values
    (cx, opt_ty(TyJava(rc, cx.jsig.class_info(rc).display)))
  }

## Class.m(a) / value.m(a) / Class.new(a) — the Kotlin checkJavaCall.
fn check_java_call(
  cx: Cx,
  cls: JClass,
  target_tx: Option[TExpr],
  is_static: Bool,
  name: String,
  args: List[Expr],
  nlo: Int,
  nhi: Int,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  var cx1 = record_effect(cx, EIo, nlo, nhi, cls.simple ++ "." ++ name)
  var ats: List[Option[Ty]] = []
  var atx: List[Option[TExpr]] = []
  for a in args {
    if sam_deferred(cx1, a) {
      ats = ats ++ [no_expected()]
      atx = atx ++ [no_texpr()]
    } else {
      let (cxa, t, ax) = check_expr(cx1, a, no_expected())
      cx1 = cxa
      ats = ats ++ [Some(t)]
      atx = atx ++ [Some(ax)]
    }
  }
  var arities: List[Int] = []
  for a in args { arities = arities ++ [deferred_arity(cx1, a)] }
  var any_err = false
  for t0 in ats {
    match t0 {
      Some(t) -> if is_errorish(t) { any_err = true }
      None -> ()
    }
  }
  if any_err {
    cx1 = check_deferred(cx1, args, ats)
    return (cx1, TyError, XError(lo, hi))
  }
  var shown: List[String] = []
  var si = 0
  for t0 in ats {
    match t0 {
      Some(t) -> { shown = shown ++ [ty_show(cx1.adts, t)] }
      None -> { shown = shown ++ ["fn/" ++ to_string(arities[si])] }
    }
    si = si + 1
  }
  let show_args = join(shown, ", ")
  if name == "new" {
    if not is_static {
      return (cerr(cx1, "`.new` is called on the class, not on an instance", nlo, nhi),
        TyError, XError(lo, hi))
    }
    let cands = sort_ctors(cx1.jsig.ctors_of(cls.fqcn))
    var bph = -1
    var bsc = -1
    var best: List[JCtor] = []
    for c in cands {
      match fit_score(cx1, c.param_cls, c.is_varargs, ats, arities) {
        Some(f) -> {
          let (ph, sc) = f
          if ph > bph || (ph == bph && sc > bsc) {
            bph = ph
            bsc = sc
            best = [c]
          } else if ph == bph && sc == bsc {
            best = best ++ [c]
          }
        }
        None -> ()
      }
    }
    if len(best) == 0 {
      cx1 = check_deferred(cx1, args, ats)
      var descs: List[String] = []
      for c in cands { descs = descs ++ ["  " ++ c.desc] }
      return (cerr_h(cx1, "no constructor of `" ++ cls.fqcn ++ "` matches (" ++ show_args ++ ")",
        lo, hi, "candidates:\n" ++ join(descs, "\n")), TyError, XError(lo, hi))
    }
    if len(best) > 1 {
      cx1 = check_deferred(cx1, args, ats)
      var bdescs: List[String] = []
      for c in best { bdescs = bdescs ++ ["  " ++ c.desc] }
      return (cerr_h(cx1, "ambiguous constructor call on `" ++ cls.fqcn ++ "`", lo, hi,
        "candidates:\n" ++ join(bdescs, "\n")), TyError, XError(lo, hi))
    }
    let c = best[0]
    let packs = bph == 0
    let (cxa, atx2, convs, bridges) = finalize_sams(cx1, c.param_cls, packs, args, ats, atx)
    cx1 = cxa
    var fin: List[TExpr] = []
    for sl in atx2 {
      match sl {
        Some(ax) -> { fin = fin ++ [ax] }
        None -> { fin = fin ++ [XError(lo, hi)] }
      }
    }
    let vp: Option[Int] = if packs { Some(len(c.param_cls) - 1) } else { None }
    let call = TJavaCall {
      fqcn: cls.fqcn,
      decl_cls: cls.fqcn,
      method: "new",
      param_cls: c.param_cls,
      ret_cls: cls.fqcn,
      is_static: true,
      is_ctor: true,
      is_field: false,
      target: None,
      args: fin,
      varargs_pack: vp,
      sam_convs: convs,
      list_bridges: bridges,
      nlo: nlo,
      nhi: nhi
    }
    # .new returns T — a constructor never returns null; a constructed
    # java.lang.String is an ordinary Dawn String
    let rt = if cls.fqcn == "java.lang.String" { TyString } else { TyJava(cls.fqcn, cls.display) }
    return (cx1, rt, XJava(call, lo, hi, rt))
  }
  var matching: List[JMethod] = []
  for m0 in cx1.jsig.methods_of(cls.fqcn) {
    if m0.name == name && m0.is_static == is_static { matching = matching ++ [m0] }
  }
  var same_name: List[JMethod] = []
  var seen_sigs: List[String] = []
  for m2 in sort_methods(matching) {
    let sig_key = join(m2.param_cls, ",")
    var dup = false
    for s0 in seen_sigs {
      if s0 == sig_key { dup = true }
    }
    if not dup {
      seen_sigs = seen_sigs ++ [sig_key]
      same_name = same_name ++ [m2]
    }
  }
  if len(same_name) == 0 {
    cx1 = check_deferred(cx1, args, ats)
    let shape = if is_static {
      "Class.method(...) for statics"
    } else {
      "value.method(...) for instance methods"
    }
    let stat = if is_static { "static " } else { "" }
    return (cerr_h(cx1, "`" ++ cls.fqcn ++ "` has no " ++ stat ++ "method `" ++ name ++ "`",
      nlo, nhi, "Java calls are " ++ shape ++ "; a public static field is read as `Class.FIELD`, and no other field is readable"),
      TyError, XError(lo, hi))
  }
  var bph = -1
  var bsc = -1
  var best: List[JMethod] = []
  for m2 in same_name {
    match fit_score(cx1, m2.param_cls, m2.is_varargs, ats, arities) {
      Some(f) -> {
        let (ph, sc) = f
        if ph > bph || (ph == bph && sc > bsc) {
          bph = ph
          bsc = sc
          best = [m2]
        } else if ph == bph && sc == bsc {
          best = best ++ [m2]
        }
      }
      None -> ()
    }
  }
  if len(best) == 0 {
    cx1 = check_deferred(cx1, args, ats)
    var descs: List[String] = []
    for m2 in same_name { descs = descs ++ ["  " ++ m2.desc] }
    return (cerr_h(cx1, "no overload of `" ++ cls.simple ++ "." ++ name ++ "` matches (" ++
        show_args ++ ")", lo, hi, "candidates:\n" ++ join(descs, "\n")),
      TyError, XError(lo, hi))
  }
  if len(best) > 1 {
    cx1 = check_deferred(cx1, args, ats)
    var bdescs: List[String] = []
    for m2 in best { bdescs = bdescs ++ ["  " ++ m2.desc] }
    return (cerr_h(cx1, "ambiguous call to `" ++ cls.simple ++ "." ++ name ++ "`", lo, hi,
      "candidates:\n" ++ join(bdescs, "\n")), TyError, XError(lo, hi))
  }
  let m3 = best[0]
  let packs = bph == 0
  let (cxb, atx3, convs, bridges) = finalize_sams(cx1, m3.param_cls, packs, args, ats, atx)
  cx1 = cxb
  var fin: List[TExpr] = []
  for sl in atx3 {
    match sl {
      Some(ax) -> { fin = fin ++ [ax] }
      None -> { fin = fin ++ [XError(lo, hi)] }
    }
  }
  let (cxc, rt) = map_java_return(cx1, m3.ret_cls, nlo, nhi)
  cx1 = cxc
  let vp: Option[Int] = if packs { Some(len(m3.param_cls) - 1) } else { None }
  let call = TJavaCall {
    fqcn: cls.fqcn,
    decl_cls: m3.decl_cls,
    method: name,
    param_cls: m3.param_cls,
    ret_cls: m3.ret_cls,
    is_static: is_static,
    is_ctor: false,
    is_field: false,
    target: target_tx,
    args: fin,
    varargs_pack: vp,
    sam_convs: convs,
    list_bridges: bridges,
    nlo: nlo,
    nhi: nhi
  }
  (cx1, rt, XJava(call, lo, hi, rt))
}

## Is `target` a bare java class name (a nullary ctor spelling that resolves to a
## `use java` class and shadows nothing)? Returns its fqcn — the receiver of a
## `Class.FIELD` static field read. Mirrors the static-call guard in check_method_call.
fn static_field_target(cx: Cx, target: Expr) -> Option[String] =
  match target {
    ECtor(cn, cargs, sp, hp, _, _, _, _) ->
      if not hp && len(cargs) == 0 && sp == None &&
      not map.has(cx.ctors_by_name, cn) && not map.has(cx.consts, cn) {
        map.get(cx.java_classes, cn)
      } else {
        None
      }
    _ -> None
  }

## Class.FIELD — a read-only public static field (spec §9.1). The value maps by
## §9.2 exactly like a method return (references wrap in Option, small ints/floats
## widen); the read is !io like every Java interop.
fn check_java_static_field(
  cx: Cx,
  fq: String,
  fname: String,
  flo: Int,
  fhi: Int,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  var found: Option[JField] = None
  for f in cx.jsig.static_fields_of(fq) {
    match found {
      None -> if f.name == fname { found = Some(f) }
      Some(_) -> ()
    }
  }
  match found {
    None -> (cerr_h(cx, "`" ++ fq ++ "` has no static field `" ++ fname ++ "`", flo, fhi,
      "only public static fields are readable; instance fields and methods are not"),
      TyError, XError(lo, hi))
    Some(f) -> {
      let cx1 = record_effect(cx, EIo, flo, fhi, fq ++ "." ++ fname)
      let (cx2, ty) = map_java_return(cx1, f.type_cls, flo, fhi)
      let empty_params: List[String] = []
      let empty_args: List[TExpr] = []
      let no_convs: List[(Int, String, String, List[String], String)] = []
      let no_bridges: List[Int] = []
      let call = TJavaCall {
        fqcn: fq,
        decl_cls: f.decl_cls,
        method: fname,
        param_cls: empty_params,
        ret_cls: f.type_cls,
        is_static: true,
        is_ctor: false,
        is_field: true,
        target: None,
        args: empty_args,
        varargs_pack: None,
        sam_convs: no_convs,
        list_bridges: no_bridges,
        nlo: flo,
        nhi: fhi
      }
      (cx2, ty, XJava(call, lo, hi, ty))
    }
  }
}

# ---- method calls (x.f(a)) ----

## The std names that stopped being exported, and how to write them now.
##
## `cx.moved` cannot answer this. That table is keyed by the FLAT builtin
## spelling (`str_len`, `map_insert`) and is read only where a bare name fails
## to resolve; a module-qualified call is looked up by (alias, name) and, when
## that misses, reports "no exported function" without ever consulting it.
##
## Both halves measured by deleting the entries again (2026-08-06): without
## this table `str.substring` answers with an empty hint -- `suggest.hint` does
## not reach `slice` from `substring` -- and `fmt.atoi`, which is still there
## and merely no longer pub, answers "add `pub` to its declaration in std/fmt",
## which is advice to edit the standard library. That second one is also why
## the lookup goes *before* the private branch rather than after it.
##
## Keyed by module path rather than alias: `use std/str as s` renames the
## alias, not the module, and the hint is about the module.
fn renamed_std_fn(mod_path: String, name: String) -> Option[String] =
  if mod_path == "std/str" && name == "substring" {
    Some("renamed in v0.55.0: write `str.slice(s, from, to)`")
  } else if mod_path == "std/cursor" && name == "at" {
    Some("renamed in v0.55.0: write `cursor.seek(s, i)`")
  } else if mod_path == "std/bytes" && name == "get" {
    Some("renamed in v0.55.0: write `bytes.buf_at(b, i)`")
  } else if mod_path == "std/fmt" && name == "atoi" {
    Some("std-internal since v0.55.0: write the builtin `parse_int(s)`")
  } else if mod_path == "std/fmt" && name == "atoi_radix" {
    Some("std-internal since v0.55.0: write the builtin `parse_int_radix(s, radix)`")
  } else if mod_path == "std/fmt" && name == "atod" {
    Some("std-internal since v0.55.0: write the builtin `parse_float(s)`")
  } else {
    None
  }

## alias.fn(args): a call to a pub function of an imported module (spec §10.3).
fn check_module_call(
  cx: Cx,
  al: String,
  name: String,
  args0: List[Arg],
  expected: Option[Ty],
  nlo: Int,
  nhi: Int,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  var cx1 = cx
  match map.get(cx1.module_fn_sigs, (al, name)) {
    # reuse the ordinary call machinery with the resolved (imported) signature
    Some(s) -> check_call(cx1, name, args0, expected, None, Some(s), nlo, nhi, lo, hi)
    None -> {
      for a in arg_exprs(args0) {
        let (cxa, _, _) = check_expr(cx1, a, no_expected())
        cx1 = cxa
      }
      let mod_path = match map.get(cx1.module_aliases, al) {
        Some(p) -> p
        None -> al
      }
      # before the "private" and "did you mean" branches below, both of which
      # would answer a rename with something worse than silence
      match renamed_std_fn(mod_path, name) {
        Some(h) ->
          return (cerr_h(cx1, "module `" ++ mod_path ++ "` has no exported function `" ++
              name ++ "`", nlo, nhi, h), TyError, XError(lo, hi))
        None -> ()
      }
      match map.get(cx1.module_exports, al) {
        Some(ex) -> {
          var in_all = false
          for n2 in ex.all_names {
            if n2 == name { in_all = true }
          }
          if in_all {
            return (cerr_h(cx1, "`" ++ name ++ "` is private to module `" ++ ex.mod_path ++ "`",
              nlo, nhi, "add `pub` to its declaration in " ++ ex.mod_path),
              TyError, XError(lo, hi))
          }
          # There used to be a branch here for `name` in the module's types or
          # constants ("not a function; import it with `use m.{X}`"). It could
          # not run, twice over. A type or constant name is TYPEIDENT by
          # declaration (parser: `a type name (uppercase)`, `a constant name
          # (SCREAMING_SNAKE_CASE)`), and `postfix_expr` turns `.` + TYPEIDENT
          # into EFieldAcc, never EMethod -- and EMethod is the only way into
          # this function. Even hoisted above the `in_all` guard it never
          # fired: `lib.Shown()` still reported `undefined variable: lib`.
          # And `exports_of` puts every declared name into `all_names` before
          # it decides whether the declaration is pub, so anything in
          # `types_by_name` or `consts` is in `all_names` too and the guard
          # above would have returned first regardless.
          (cerr_o(cx1, "module `" ++ ex.mod_path ++ "` has no exported function `" ++ name ++ "`",
            nlo, nhi, suggest.hint(name, map.keys(ex.fns))), TyError, XError(lo, hi))
        }
        None ->
          (cerr(cx1, "module `" ++ mod_path ++ "` has no exported function `" ++ name ++ "`",
            nlo, nhi), TyError, XError(lo, hi))
      }
    }
  }
}

## x.f(a): module-qualified (alias.f), Java static (Class.m), Java instance
## (value.m), a fn-typed record field, or UFCS f(x, a) — the Kotlin checkMethodCall.
fn check_method_call(
  cx: Cx,
  target: Expr,
  name: String,
  args0: List[Arg],
  expected: Option[Ty],
  nlo: Int,
  nhi: Int,
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  var cx1 = cx
  let args = arg_exprs(args0)
  # module-qualified call: alias.fn(args), where alias is a whole-module import
  match target {
    EVar(rname, _, _) ->
      if lookup(cx1, rname) == None && map.has(cx1.module_aliases, rname) {
        return check_module_call(cx1, rname, name, args0, expected, nlo, nhi, lo, hi)
      }
    _ -> ()
  }
  # a bare name that is neither a value nor an alias: both readings of `q.f()`
  # fail, and the value path below would report only one of them
  match target {
    EVar(rname, rlo, rhi) ->
      if not resolves_to_value(cx1, rname) && not map.has(cx1.module_aliases, rname) &&
      not map.has(cx1.module_exports, rname) {
        var cxe = undefined_qualifier_err(cx1, rname, rlo, rhi)
        for a in args {
          let (cxa, _, _) = check_expr(cxe, a, no_expected())
          cxe = cxa
        }
        return (cxe, TyError, XError(lo, hi))
      }
    _ -> ()
  }
  # static namespace / constructor: System.exit(1), StringBuilder.new()
  match target {
    ECtor(cn, cargs2, sp2, hp2, _, _, _, _) ->
      if not hp2 && len(cargs2) == 0 && sp2 == None &&
      not map.has(cx1.ctors_by_name, cn) && not map.has(cx1.consts, cn) {
        match map.get(cx1.java_classes, cn) {
          Some(fq) -> {
            match first_named(args0) {
              Some(a) -> {
                let qual = cn ++ "." ++ name
                let cxe = cerr_h(cx1, java_named_arg_msg(qual), a.lo, a.hi, named_arg_hint())
                return named_args_stop(cxe, args0, lo, hi)
              }
              None -> ()
            }
            return check_java_call(cx1, cx1.jsig.class_info(fq), None, true, name, args,
              nlo, nhi, lo, hi)
          }
          None -> ()
        }
      }
    _ -> ()
  }
  let (cx2, tt, tx) = check_expr(cx1, target, no_expected())
  cx1 = cx2
  match tt {
    TyJava(fq, _) -> {
      match first_named(args0) {
        Some(a) -> {
          let cxe = cerr_h(cx1, java_named_arg_msg(name), a.lo, a.hi, named_arg_hint())
          return named_args_stop(cxe, args0, lo, hi)
        }
        None -> ()
      }
      return check_java_call(cx1, cx1.jsig.class_info(fq), Some(tx), false, name, args,
        nlo, nhi, lo, hi)
    }
    _ -> ()
  }
  if is_errorish(tt) {
    for a in args {
      let (cxa, _, _) = check_expr(cx1, a, no_expected())
      cx1 = cxa
    }
    return (cx1, TyError, XError(lo, hi))
  }
  # a record field holding a function: r.f(a) calls the field value. When a
  # function `f` is ALSO in scope the call is ambiguous and errors out (spec §2.4)
  match tt {
    TyAdt(aid, targs) -> {
      let ad = adt_of(cx1.adts, aid)
      if ad.is_record {
        let ci = ad.ctors[0]
        var fidx = -1
        var k = 0
        for f in ci.fields {
          if fidx < 0 && f.name == name { fidx = k }
          k = k + 1
        }
        if fidx >= 0 {
          var im: Map[Int, Ty] = map.empty()
          var ti = 0
          for tp in ad.tparams {
            match tp {
              TyVar(_, vid) ->
                match get(targs, ti) {
                  Some(ta) -> { im = map.insert(im, vid, ta) }
                  None -> ()
                }
              _ -> ()
            }
            ti = ti + 1
          }
          let em0: Map[Int, Eff] = map.empty()
          let ftype = subst(ci.fields[fidx].ty, im, em0)
          match ftype {
            TyFn(fps, fret, feff) -> {
              # the field holds a function value, and a function type carries
              # no parameter names
              match first_named(args0) {
                Some(a) -> {
                  let cxe = cerr_h(cx1, fn_value_named_arg_msg(name), a.lo, a.hi,
                    named_arg_hint())
                  return named_args_stop(cxe, args0, lo, hi)
                }
                None -> ()
              }
              let fn_in_scope = lookup(cx1, name) != None ||
                lookup_fn_sig(cx1, name) != None
              if fn_in_scope {
                for a in args {
                  let (cxa, _, _) = check_expr(cx1, a, no_expected())
                  cx1 = cxa
                }
                return (cerr_h(cx1, "`" ++ name ++
                    "` is both a function in scope and a fn-typed field of `" ++ ad.name ++
                    "` — ambiguous call", nlo, nhi,
                  "for the field, bind it first: `let g = <recv>." ++ name ++ "` then `g(...)`; " ++
                    "for the function, call it directly: `" ++ name ++ "(<recv>, ...)`"),
                  TyError, XError(lo, hi))
              }
              let fx = XField(tx, fidx, e_lo(target), nhi, ftype)
              if len(args) != len(fps) {
                for a in args {
                  let (cxa, _, _) = check_expr(cx1, a, no_expected())
                  cx1 = cxa
                }
                cx1 = cerr_h(cx1, "`" ++ name ++ "` takes " ++ to_string(len(fps)) ++
                    " argument(s), got " ++ to_string(len(args)), lo, hi,
                  "field type: " ++ ty_show(cx1.adts, ftype))
                return (cx1, fret, XError(lo, hi))
              }
              var txs: List[TExpr] = []
              var ai = 0
              for a in args {
                let pt = fps[ai]
                let (cxa, at, ax) = check_expr(cx1, a, Some(pt))
                cx1 = cxa
                if not assignable(cx1, at, pt) {
                  cx1 = cerr_h(cx1, "argument type mismatch: expected " ++
                      ty_show(cx1.adts, pt) ++ ", got " ++ ty_show(cx1.adts, at),
                    e_lo(a), e_hi(a), "field type: " ++ ty_show(cx1.adts, ftype))
                }
                txs = txs ++ [ax]
                ai = ai + 1
              }
              # ... and for a call through an fn-typed field
              let (cxe, evs, unanswered) = dyn_evidence_args(cx1, feff, nlo, nhi)
              cx1 = cxe
              cx1 = record_effect(cx1, eff_drop(feff, unanswered), nlo, nhi, name)
              return (cx1, fret, XApply(fx, txs, evs, lo, hi, fret))
            }
            _ -> ()
          }
        }
      }
    }
    _ -> ()
  }
  # UFCS: x.f(a) is f(x, a) (spec §4.3); the receiver is already checked and
  # rides as a positional argument at slot 0 -- so a named argument that names
  # the first parameter reports "given twice", which is the truth
  check_call(cx1, name, [pos_arg(target)] ++ args0, expected, Some((tt, tx)), no_sig(),
    nlo, nhi, lo, hi)
}

# ---- match ----

fn wilds_of(n: Int) -> List[SPat] = {
  var out: List[SPat] = []
  for _i in 0..n { out = out ++ [SWild] }
  out
}

## Lower a checked pattern for the exhaustiveness algorithm; broken patterns
## already became wildcards during checking (their errors are reported).
fn to_spat(p: TPat) -> SPat =
  match p {
    TPWild -> SWild
    TPBind(_, _) -> SWild
    TPLit(v) -> SLit(v)
    TPOr(alts) -> SOr(map(alts, alt => to_spat(alt)))
    TPTuple(elems) -> {
      var subs: List[SPat] = []
      for s in elems { subs = subs ++ [to_spat(s)] }
      STuple(subs)
    }
    TPList(pre, has_rest, _, post) -> {
      var pres: List[SPat] = []
      for s in pre { pres = pres ++ [to_spat(s)] }
      var posts: List[SPat] = []
      for s in post { posts = posts ++ [to_spat(s)] }
      SList(pres, has_rest, posts)
    }
    TPCtor(aid, ci, fps) -> {
      var subs: List[SPat] = []
      for fp in fps {
        match fp {
          Some(s) -> { subs = subs ++ [to_spat(s)] }
          None -> { subs = subs ++ [SWild] }
        }
      }
      SCtor(aid, ci, subs)
    }
  }

fn check_match(
  cx: Cx,
  scrut: Expr,
  arms: List[MatchArm],
  expected: Option[Ty],
  lo: Int,
  hi: Int
) -> (Cx, Ty, TExpr) !io = {
  let (cx0, st, sx) = check_expr(cx, scrut, no_expected())
  var cx1 = cx0
  # The scalars peel and the structures do not, and the line between them is
  # what a pattern of each kind does. A literal pattern is an equality test,
  # and an opaque type inherits its target's equality (spec §2.7) -- so
  # `match c { 'a' -> .. }` on a `Char` is the same test as on the Int, and
  # refusing it while allowing `match char.code(c)` would be a wall rather than
  # a type. A constructor, tuple or list pattern takes the value apart, which
  # is exactly the representation opacity hides, so those keep asking about the
  # opaque type itself and get refused outside the declaring module.
  let sp = peel_opaque(st)
  let scrut_ok = sp == TyInt || sp == TyFloat || sp == TyString || sp == TyBool ||
    is_adt(st) || is_tuple_ty(st) || is_list_ty(st)
  if not scrut_ok && not is_errorish(st) {
    cx1 = cerr(cx1, "match supports Int/Float/String/Bool, tuples, lists and user-defined types, got " ++
        ty_show(cx1.adts, st), e_lo(scrut), e_hi(scrut))
  }
  var result = TyNever
  # concrete-typed arms first so an inference-only arm body (bare `None`, `[]`)
  # can borrow the result type from its siblings as its expected — the empty-list
  # two-pass (§EListLit) applied to arm bodies. Typed arms are reassembled in
  # source order for exhaustiveness + codegen.
  # `order` is two ascending runs, so the arms it produces are collected in
  # check order and merged back by position below, in one pass.
  var defer_at: List[Bool] = []
  var order: List[Int] = []
  var oi = 0
  for arm in arms {
    let d = needs_expected(cx1, arm.body)
    defer_at = defer_at ++ [d]
    if not d { order = order ++ [oi] }
    oi = oi + 1
  }
  let ready_n = len(order)
  oi = 0
  for d in defer_at {
    if d { order = order ++ [oi] }
    oi = oi + 1
  }
  var checked: List[TArm] = []
  for idx in order {
    let arm = arms[idx]
    cx1 = push_scope(cx1)
    let (cxa, tpat) = check_pattern(cx1, arm.pat, st, false)
    cx1 = cxa
    var tguard: Option[TExpr] = None
    match arm.guard {
      Some(g) -> {
        let (cxa, gt, gx) = check_expr(cx1, g, no_expected())
        cx1 = cxa
        if gt != TyBool && not is_errorish(gt) {
          cx1 = cerr(cx1, "guard must be Bool, got " ++ ty_show(cx1.adts, gt), e_lo(g), e_hi(g))
        }
        tguard = Some(gx)
      }
      None -> ()
    }
    # prefer the match's own expected; else the result inferred from concrete arms
    let arm_exp: Option[Ty] = match expected {
      Some(e) -> Some(e)
      None -> if result != TyNever && is_concrete(cx1, result) { Some(result) } else { None }
    }
    let (cxb, bt, bx) = check_expr(cx1, arm.body, arm_exp)
    cx1 = cxb
    let (cxc, unified) = unify_branches(cx1, result, bt, e_lo(arm.body), e_hi(arm.body),
      "the match arms")
    cx1 = cxc
    result = unified
    cx1 = pop_scope(cx1)
    checked = checked ++ [TArm { pat: tpat, guard: tguard, body: bx }]
  }
  var tarms: List[TArm] = []
  var ri = 0
  var di = ready_n
  for d in defer_at {
    if d {
      tarms = tarms ++ [checked[di]]
      di = di + 1
    } else {
      tarms = tarms ++ [checked[ri]]
      ri = ri + 1
    }
  }
  # exhaustiveness (guarded arms can fail their guard, so they don't count)
  if scrut_ok {
    var rows: List[List[SPat]] = []
    var ai = 0
    for arm in arms {
      let unguarded = match arm.guard {
        Some(_) -> false
        None -> true
      }
      if unguarded {
        let ta = tarms[ai]
        rows = rows ++ [[to_spat(ta.pat)]]
      }
      ai = ai + 1
    }
    let tys = [st]
    match useful_result(cx1.adts, rows, [SWild], tys) {
      Some(true) -> {
        var too_complex = false
        let missing = match st {
          TyAdt(aid, _) -> {
            let ad = adt_of(cx1.adts, aid)
            var names: List[String] = []
            var ci2 = 0
            for c in ad.ctors {
              match useful_result(
                cx1.adts, rows, [SCtor(aid, ci2, wilds_of(len(c.fields)))], tys) {
                Some(true) -> { names = names ++ [c.name] }
                Some(false) -> ()
                None -> { too_complex = true }
              }
              ci2 = ci2 + 1
            }
            join(names, ", ")
          }
          TyBool -> {
            var names: List[String] = []
            match useful_result(cx1.adts, rows, [SLit(LBool(true))], tys) {
              Some(true) -> { names = names ++ ["true"] }
              Some(false) -> ()
              None -> { too_complex = true }
            }
            match useful_result(cx1.adts, rows, [SLit(LBool(false))], tys) {
              Some(true) -> { names = names ++ ["false"] }
              Some(false) -> ()
              None -> { too_complex = true }
            }
            join(names, ", ")
          }
          TyList(_) ->
            match missing_list_patterns_result(cx1.adts, rows, st) {
              Some(patterns) -> join(patterns, ", ")
              None -> {
                too_complex = true
                ""
              }
            }
          _ -> "_ (" ++ ty_show(cx1.adts, st) ++ " has too many values to enumerate)"
        }
        if too_complex {
          cx1 = usefulness_too_complex(cx1, lo, hi)
        } else {
          let hint = if is_adt(st) {
            "add arms for the missing constructors, or a catch-all _"
          } else {
            "add an unguarded catch-all arm (a binding or _)"
          }
          cx1 = cerr_h(cx1, "non-exhaustive match, missing: " ++ missing, lo, hi, hint)
        }
      }
      Some(false) -> ()
      None -> { cx1 = usefulness_too_complex(cx1, lo, hi) }
    }
  }
  (cx1, result, XMatch(sx, tarms, lo, hi, result))
}

# ---- expression checker tests ----

test "check_expr: literals, locals and undefined variables" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  let (cx0, _) = declare(cx, "x", TyInt, false, 0, 1)
  let (cx1, t, node) = check_expr(cx0, EVar("x", 2, 3), no_expected())
  assert t == TyInt
  assert len(cx1.diags) == 0
  match node {
    XLocal(_, n, ..) -> { assert n == "x" }
    _ -> { assert false }
  }
  let (cx2, t2, _) = check_expr(cx0, EVar("nope", 2, 6), no_expected())
  assert t2 == TyError
  assert cx2.diags[0].msg == "undefined variable: nope"
}

test "blocks scope lets, type tails and flag discards" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  # { let a = 1  a + 2 } : Int
  let blk = EBlock([SLet("a", false, None, EInt(1, 6, 7), 2, 7)],
    Some(EBinary(OpAdd, EVar("a", 10, 11), EInt(2, 14, 15), 12, 13, 10, 15)), 0, 16)
  let (cx1, t, _) = check_expr(cx, blk, no_expected())
  assert t == TyInt
  assert len(cx1.diags) == 0
  # a non-Unit statement value is discarded
  let blk2 = EBlock([SExpr(EInt(1, 2, 3), 2, 3)], None, 0, 5)
  let (cx2, t2, _) = check_expr(cx, blk2, no_expected())
  assert t2 == TyUnit
  assert str.contains(cx2.diags[0].msg, "value is discarded")
  # the let is scoped to the block
  let (cx3, _, _) = check_expr(cx1, EVar("a", 20, 21), no_expected())
  assert str.contains(cx3.diags[len(cx3.diags) - 1].msg, "undefined variable: a")
}

test "lambdas infer parameters from expected types and track captures" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  let (cxk, _) = declare(cx, "k", TyInt, false, 0, 1)
  # x => x + k against fn(Int) -> Int captures k
  let lam = ELambda([LambdaParam { name: "x", ann: None, lo: 3, hi: 4 }],
    EBinary(OpAdd, EVar("x", 9, 10), EVar("k", 13, 14), 11, 12, 9, 14), false, 0, 14)
  let (cx1, t, node) = check_expr(cxk, lam, Some(TyFn([TyInt], TyInt, EPure)))
  assert t == TyFn([TyInt], TyInt, EPure)
  assert len(cx1.diags) == 0
  match node {
    XLambda(_, _, _, caps, ..) -> { assert len(caps) == 1 }
    _ -> { assert false }
  }
  # without context the parameter cannot be inferred
  let (cx2, _, _) = check_expr(cxk, lam, no_expected())
  assert str.contains(cx2.diags[0].msg, "cannot infer the type of `x`")
  # a var cannot be captured
  let (cxv, _) = declare(cxk, "v", TyInt, true, 0, 1)
  let lam2 = ELambda([LambdaParam { name: "y", ann: None, lo: 3, hi: 4 }],
    EVar("v", 9, 10), false, 0, 10)
  let (cx3, _, _) = check_expr(cxv, lam2, Some(TyFn([TyInt], TyInt, EPure)))
  assert str.contains(cx3.diags[0].msg, "lambdas cannot capture `var` bindings")
}

test "apply: piping arguments into an unannotated lambda" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  let lam = ELambda([LambdaParam { name: "x", ann: None, lo: 1, hi: 2 }], EVar("x", 7, 8), false, 0, 8)
  let ap = EApply(lam, [pos_arg(EInt(1, 10, 11))], 0, 12)
  let (cx1, t, _) = check_expr(cx, ap, no_expected())
  assert t == TyInt
  assert len(cx1.diags) == 0
  # calling a non-function value: the callee is an expression, so the error is
  # about its type (a *name* goes through check_call and is named instead)
  let ap2 = EApply(EInt(1, 0, 1), [], 0, 3)
  let (cx2, _, _) = check_expr(cx, ap2, no_expected())
  assert str.contains(cx2.diags[0].msg, "cannot call a value of type Int")
  let (cxa, _) = declare(cx, "n", TyInt, false, 0, 1)
  let ap3 = EApply(EVar("n", 0, 1), [], 0, 3)
  let (cx3, _, _) = check_expr(cxa, ap3, no_expected())
  assert str.contains(cx3.diags[0].msg, "`n` is not a function (it is Int)")
}

test "calls: builtins, dynamic targets, arity and undefined" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  # len([1]) : Int
  let call = EApply(EVar("len", 0, 3), [pos_arg(EListLit([LeExpr(EInt(1, 5, 6))], 4, 7))], 0, 8)
  let (cx1, t, _) = check_expr(cx, call, no_expected())
  assert t == TyInt
  assert len(cx1.diags) == 0
  # a local fn value is a dynamic call target
  let (cxa, _) = declare(cx, "f", TyFn([TyInt], TyBool, EPure), false, 0, 1)
  let (cx2, t2, node2) =
    check_expr(cxa, EApply(EVar("f", 0, 1), [pos_arg(EInt(1, 2, 3))], 0, 4), no_expected())
  assert t2 == TyBool
  match node2 {
    XCallDyn(_, n, ..) -> { assert n == "f" }
    _ -> { assert false }
  }
  # arity mismatch reports the signature
  let bad = EApply(EVar("len", 0, 3), [], 0, 5)
  let (cx3, _, _) = check_expr(cx, bad, no_expected())
  assert str.contains(cx3.diags[0].msg, "`len` takes 1 argument(s), got 0")
  # undefined
  let (cx4, _, _) = check_expr(cx, EApply(EVar("nope", 0, 4), [], 0, 6), no_expected())
  assert cx4.diags[0].msg == "undefined function: nope"
}

test "argument names name a signature or a constructor; a value callee says so" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  let bare_some = ECtor("Some", [], None, false, 0, 4, 0, 4)
  # (1) a constructor accepts them -- and validates them against its fields
  let named = EApply(bare_some,
    [Arg { name: Some("value"), e: EInt(1, 12, 13), trailing: false, lo: 5, hi: 13 }], 0, 14)
  let (cx1, t1, _) = check_expr(cx, named, Some(opt_ty(TyInt)))
  assert t1 == opt_ty(TyInt)
  assert len(cx1.diags) == 0
  let wrong = EApply(bare_some,
    [Arg { name: Some("nope"), e: EInt(1, 11, 12), trailing: false, lo: 5, hi: 12 }], 0, 13)
  let (cx2, _, _) = check_expr(cx, wrong, Some(opt_ty(TyInt)))
  assert str.contains(cx2.diags[0].msg, "no field `nope`")
  # (2) a local holding a function is a function *value*: no parameter names
  let (cxf, _) = declare(cx, "f", TyFn([TyInt], TyInt, EPure), false, 0, 1)
  let on_fn = EApply(EVar("f", 0, 1),
    [Arg { name: Some("a"), e: EInt(1, 5, 6), trailing: false, lo: 2, hi: 6 }], 0, 7)
  let (cx3, _, _) = check_expr(cxf, on_fn, no_expected())
  assert cx3.diags[0].msg ==
    "`f` is a function value, and a function type carries no parameter names"
  assert cx3.diags[0].hint == "pass the arguments by position"
  assert cx3.diags[0].lo == 2
  # (3) an applied expression is a function value too, with no name to quote
  let lam = ELambda([LambdaParam { name: "x", ann: Some(TNamed("Int", [], [], 4, 7)), lo: 1, hi: 2 }],
    EVar("x", 11, 12), false, 0, 12)
  let on_value = EApply(lam, [Arg { name: Some("a"), e: EInt(1, 16, 17), trailing: false, lo: 13, hi: 17 }], 0, 18)
  let (cx4, _, _) = check_expr(cx, on_value, no_expected())
  assert cx4.diags[0].msg ==
    "this callee is a function value, and a function type carries no parameter names"
  # (4) a Java member: Java metadata has no parameter names
  cx = Cx { ..cx, jsig: test_jsig(),
    java_classes: map.insert(cx.java_classes, "Long", "java.lang.Long") }
  let jrecv = ECtor("Long", [], None, false, 0, 4, 0, 4)
  let on_java = EApply(EFieldAcc(jrecv, "MAX_VALUE", 5, 14, 0, 14),
    [Arg { name: Some("a"), e: EInt(1, 18, 19), trailing: false, lo: 15, hi: 19 }], 0, 20)
  let (cx5, _, _) = check_expr(cx, on_java, no_expected())
  assert cx5.diags[0].msg == "`Long.MAX_VALUE` is a Java member; " ++
    "Java methods carry no parameter names"
  # (5) a dot call on an undefined method reports the name, not the arguments
  let on_dot = EMethod(EVar("f", 0, 1), "g",
    [Arg { name: Some("a"), e: EInt(1, 6, 7), trailing: false, lo: 3, hi: 7 }], 2, 3, 0, 8)
  let (cx6, _, _) = check_expr(cxf, on_dot, no_expected())
  assert cx6.diags[0].msg == "undefined function: g"
}

test "named arguments land on a signature's parameters, and evaluate in written order" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  let sg = Sig {
    name: "move2",
    param_tys: [TyInt, TyBool],
    param_names: ["dx", "wrap"],
    param_defaults: [],
    ret: TyUnit,
    eff: EPure,
    is_builtin: false,
    tparams: [],
    constraints: [],
    eparams: [],
    owner: Some("m"),
    trait_id: None,
    op_of: None,
    inferring: false
  }
  cx = Cx { ..cx, fns: map.insert(cx.fns, "move2", sg) }
  let named_arg = (n: String, e: Expr) => Arg { name: Some(n), e: e, trailing: false, lo: e_lo(e), hi: e_hi(e) }
  # written in declaration order: a plain call node, no wrapper
  let ok = EApply(EVar("move2", 0, 5),
    [named_arg("dx", EInt(1, 6, 7)), named_arg("wrap", EBool(true, 8, 12))], 0, 13)
  let (cx1, t1, n1) = check_expr(cx, ok, no_expected())
  assert t1 == TyUnit
  assert len(cx1.diags) == 0
  match n1 {
    XCallFn(_, nm, cargs, ..) -> {
      assert nm == "move2"
      assert len(cargs) == 2
    }
    _ -> { assert false }
  }
  # mixed positional + named, still in order: plain node
  let mixed = EApply(EVar("move2", 0, 5),
    [pos_arg(EInt(1, 6, 7)), named_arg("wrap", EBool(true, 8, 12))], 0, 13)
  let (cx2, _, n2) = check_expr(cx, mixed, no_expected())
  assert len(cx2.diags) == 0
  match n2 {
    XCallFn(..) -> ()
    _ -> { assert false }
  }
  # written out of declaration order: the arguments are bound in written order
  # and the call reads the locals in parameter order
  let flipped = EApply(EVar("move2", 0, 5),
    [named_arg("wrap", EBool(true, 6, 10)), named_arg("dx", EInt(1, 11, 12))], 0, 13)
  let (cx3, _, n3) = check_expr(cx, flipped, no_expected())
  assert len(cx3.diags) == 0
  match n3 {
    XBlock(stmts, tail, ..) -> {
      assert len(stmts) == 2
      # the first binding is the first *written* argument -- the Bool
      match stmts[0] {
        TSLet(_, _, init, _, _) -> { assert tex_ty(init) == TyBool }
        _ -> { assert false }
      }
      match tail {
        # and the call takes the parameters in declaration order
        Some(XCallFn(_, _, cargs, ..)) -> { assert tex_ty(cargs[0]) == TyInt }
        _ -> { assert false }
      }
    }
    _ -> { assert false }
  }
  # an unknown name, with the spelling pool of the signature
  let unknown = EApply(EVar("move2", 0, 5), [named_arg("dz", EInt(1, 6, 7))], 0, 8)
  let (cx4, _, _) = check_expr(cx, unknown, no_expected())
  assert cx4.diags[0].msg == "`move2` has no parameter `dz`"
  assert str.contains(cx4.diags[0].hint, "dx")
  # a parameter given twice
  let twice = EApply(EVar("move2", 0, 5),
    [pos_arg(EInt(1, 6, 7)), named_arg("dx", EInt(2, 8, 9))], 0, 10)
  let (cx5, _, _) = check_expr(cx, twice, no_expected())
  assert cx5.diags[0].msg == "parameter `dx` is given twice"
  # a positional argument after a named one is still refused
  let after = EApply(EVar("move2", 0, 5),
    [named_arg("dx", EInt(1, 6, 7)), pos_arg(EBool(true, 8, 12))], 0, 13)
  let (cx6, _, _) = check_expr(cx, after, no_expected())
  assert cx6.diags[0].msg == "positional arguments cannot follow named arguments"
  # named with a missing required argument: the arity report, with the range
  let short = EApply(EVar("move2", 0, 5), [named_arg("wrap", EBool(true, 6, 10))], 0, 11)
  let (cx7, _, _) = check_expr(cx, short, no_expected())
  assert cx7.diags[0].msg == "`move2` takes 2 argument(s), got 1"
  # a defaulted parameter may be omitted: the slot becomes a call of the
  # synthesized `move2$default$1`, and the range shows in the arity message
  let sg2 = Sig { ..sg, param_defaults: [false, true] }
  var cxd = Cx { ..cx, fns: map.insert(cx.fns, "move2", sg2) }
  let omitted = EApply(EVar("move2", 0, 5), [pos_arg(EInt(1, 6, 7))], 0, 8)
  let (cx8, t8, n8) = check_expr(cxd, omitted, no_expected())
  assert t8 == TyUnit
  assert len(cx8.diags) == 0
  match n8 {
    XCallFn(_, _, cargs, ..) ->
      match cargs[1] {
        XCallFn(_, dn, dargs, ..) -> {
          assert dn == "move2\$default\$1"
          assert len(dargs) == 0
        }
        _ -> { assert false }
      }
    _ -> { assert false }
  }
  let none8 = EApply(EVar("move2", 0, 5), [], 0, 7)
  let (cx9, _, _) = check_expr(cxd, none8, no_expected())
  assert cx9.diags[0].msg == "`move2` takes 1 to 2 argument(s), got 0"
  # a generic callee: the synthesized default repeats the callee's type
  # parameters and bounds, so the omitted slot is an *instantiated* call --
  # the parameter type under this call's substitution, and this call's own
  # witnesses in this call's order (#207 §4.3)
  let tv = TyVar("T", 0)
  let gsig = Sig {
    name: "hold", param_tys: [TyList(tv), tv], param_names: ["xs", "probe"],
    param_defaults: [true, false],
    ret: TyInt,
    eff: EPure, is_builtin: false, tparams: [tv], constraints: [[EQ_ID]], eparams: [],
    owner: Some("m"), trait_id: None, op_of: None, inferring: false
  }
  let cxg = Cx { ..cx, fns: map.insert(cx.fns, "hold", gsig) }
  let gcall = EApply(EVar("hold", 0, 4), [named_arg("probe", EInt(1, 5, 6))], 0, 7)
  let (cx10, t10, n10) = check_expr(cxg, gcall, no_expected())
  assert len(cx10.diags) == 0
  assert t10 == TyInt
  match n10 {
    XCallFn(_, _, gargs, gwits, ..) -> {
      assert gwits == [WConcrete(EQ_ID, TyInt)]
      match gargs[0] {
        XCallFn(_, dn2, dargs2, dwits2, _, _, _, _, dty2) -> {
          assert dn2 == "hold\$default\$0"
          assert len(dargs2) == 0
          assert dwits2 == [WConcrete(EQ_ID, TyInt)]
          assert dty2 == TyList(TyInt)
        }
        _ -> { assert false }
      }
    }
    _ -> { assert false }
  }
}

test "the same call, four callees, four kinds of typed node" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  # a function name is a static call
  let (_, _, n1) = check_expr(cx,
    EApply(EVar("len", 0, 3), [pos_arg(EListLit([LeExpr(EInt(1, 5, 6))], 4, 7))], 0, 8), no_expected())
  match n1 {
    XCallBuiltin(n, ..) -> { assert n == "len" }
    _ -> { assert false }
  }
  # a local holding a function is a dynamic call, still by name
  let (cxb, _) = declare(cx, "h", TyFn([TyInt], TyInt, EPure), false, 0, 1)
  let (_, _, n2) = check_expr(cxb, EApply(EVar("h", 0, 1), [pos_arg(EInt(1, 2, 3))], 0, 4),
    no_expected())
  match n2 {
    XCallDyn(_, n, ..) -> { assert n == "h" }
    _ -> { assert false }
  }
  # a constructor name constructs
  let (_, _, n3) = check_expr(cx,
    EApply(ECtor("Some", [], None, false, 0, 4, 0, 4), [pos_arg(EInt(1, 5, 6))], 0, 7),
    no_expected())
  match n3 {
    XCtor(..) -> ()
    _ -> { assert false }
  }
  # anything else applies a function value
  let lam = ELambda([LambdaParam { name: "x", ann: Some(TNamed("Int", [], [], 4, 7)), lo: 1, hi: 2 }],
    EVar("x", 11, 12), false, 0, 12)
  let (_, _, n4) = check_expr(cx, EApply(lam, [pos_arg(EInt(1, 13, 14))], 0, 15), no_expected())
  match n4 {
    XApply(..) -> ()
    _ -> { assert false }
  }
}

test "ctor calls infer type arguments; constants land as refs" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  # Some(1) : Option[Int]
  let e = EApply(ECtor("Some", [], None, false, 0, 4, 0, 4), [pos_arg(EInt(1, 5, 6))], 0, 7)
  let (cx1, t, _) = check_expr(cx, e, no_expected())
  assert t == opt_ty(TyInt)
  assert len(cx1.diags) == 0
  # bare None cannot infer without context, lands with one
  let e2 = ECtor("None", [], None, false, 0, 4, 0, 4)
  let (cx2, _, _) = check_expr(cx, e2, no_expected())
  assert str.contains(cx2.diags[0].msg, "cannot infer type parameter(s) T for `None`")
  let (cx3, t3, _) = check_expr(cx, e2, Some(opt_ty(TyString)))
  assert t3 == opt_ty(TyString)
  assert len(cx3.diags) == 0
  # a SCREAMING const reference
  cx = Cx { ..cx, consts: map.insert(cx.consts, "LIMIT", TyInt) }
  let (cx4, t4, node4) = check_expr(cx, ECtor("LIMIT", [], None, false, 0, 5, 0, 5), no_expected())
  assert t4 == TyInt
  match node4 {
    XConstRef(_, n, ..) -> { assert n == "LIMIT" }
    _ -> { assert false }
  }
}

test "match checks arms, unifies results and demands exhaustiveness" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  let (cxo, _) = declare(cx, "o", opt_ty(TyInt), false, 0, 1)
  let arm = MatchArm {
    pat: PCtor("Some", [PatArg { name: None, nlo: 10, nhi: 11, pat: PBind("v", 10, 11) }],
      false, true, 5, 9, 5, 12),
    guard: None,
    body: EVar("v", 16, 17),
    lo: 5,
    hi: 17
  }
  let m1 = EMatch(EVar("o", 0, 1), [arm], 0, 18)
  let (cx1, t, _) = check_expr(cxo, m1, no_expected())
  assert t == TyInt
  assert cx1.diags[0].msg == "non-exhaustive match, missing: None"
  # a wildcard arm completes it
  let arm2 = MatchArm { pat: PWild(20, 21), guard: None, body: EInt(0, 25, 26), lo: 20, hi: 26 }
  let m2 = EMatch(EVar("o", 0, 1), [arm, arm2], 0, 27)
  let (cx2, t2, _) = check_expr(cxo, m2, no_expected())
  assert t2 == TyInt
  assert len(cx2.diags) == 0
  # a guarded arm does not count toward exhaustiveness
  let arm3 = MatchArm {
    pat: PWild(20, 21),
    guard: Some(EBool(true, 22, 26)),
    body: EInt(0, 30, 31),
    lo: 20,
    hi: 31
  }
  let m3 = EMatch(EVar("o", 0, 1), [arm, arm3], 0, 32)
  let (cx3, _, _) = check_expr(cxo, m3, no_expected())
  assert str.contains(cx3.diags[0].msg, "non-exhaustive match")
}

test "statements: assignment rules and loop jump tracking" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  # { var i = 0  while true { i = i + 1  break } } — has_jumps lands on the while
  let wbody = EBlock([
    SAssign("i", EBinary(OpAdd, EVar("i", 30, 31), EInt(1, 34, 35), 32, 33, 30, 35),
      26, 27, 26, 35),
    SExpr(EBreak(38, 43), 38, 43)
  ], None, 24, 45)
  let blk = EBlock([
    SLet("i", true, None, EInt(0, 10, 11), 2, 11),
    SWhile(EBool(true, 18, 22), wbody, 12, 45)
  ], None, 0, 47)
  let (cx1, t, node) = check_expr(cx, blk, no_expected())
  assert t == TyUnit
  assert len(cx1.diags) == 0
  match node {
    XBlock(stmts, ..) ->
      match stmts[1] {
        TSWhile(_, _, hj, _, _) -> { assert hj }
        _ -> { assert false }
      }
    _ -> { assert false }
  }
  # assigning to a let is rejected
  let blk2 = EBlock([
    SLet("a", false, None, EInt(0, 10, 11), 2, 11),
    SAssign("a", EInt(1, 16, 17), 12, 13, 12, 17)
  ], None, 0, 19)
  let (cx2, _, _) = check_expr(cx, blk2, no_expected())
  assert str.contains(cx2.diags[0].msg, "`a` is a let binding and cannot be assigned")
  # break outside a loop
  let (cx3, _, _) = check_expr(cx, EBreak(0, 5), no_expected())
  assert str.contains(cx3.diags[0].msg, "`break` can only be used inside a loop body")
}

# A hand-written oracle for the Java-path tests below: enough of Math, Long
# and Integer to exercise overload resolution, return mapping and field reads
# without asking a JVM — the metadata under test is spelled out right here,
# so the tests hold on any host (and in a native test runner some day).

fn tj_class(fqcn: String, simple: String) -> JClass =
  JClass {
    fqcn: fqcn,
    simple: simple,
    display: simple,
    is_interface: false,
    is_primitive: false,
    is_array: false
  }

fn tj_static(name: String, params: List[String], ret: String, owner: String) -> JMethod =
  JMethod {
    name: name,
    param_cls: params,
    ret_cls: ret,
    is_static: true,
    is_varargs: false,
    is_abstract: false,
    desc: "public static " ++ ret ++ " " ++ owner ++ "." ++ name ++
      "(" ++ join(params, ",") ++ ")",
    decl_cls: owner
  }

fn tj_find_class(fqcn: String) -> Option[JClass] !io =
  if fqcn == "java.lang.Math" {
    Some(tj_class(fqcn, "Math"))
  } else if fqcn == "java.lang.Long" {
    Some(tj_class(fqcn, "Long"))
  } else if fqcn == "java.lang.Integer" {
    Some(tj_class(fqcn, "Integer"))
  } else {
    None
  }

fn tj_class_info(fqcn: String) -> JClass !io =
  match tj_find_class(fqcn) {
    Some(j) -> j
    None -> panic("test jsig: unknown class " ++ fqcn)
  }

fn tj_methods_of(fqcn: String) -> List[JMethod] !io =
  if fqcn == "java.lang.Math" {
    # both abs overloads, so resolution has a choice to make
    [tj_static("abs", ["long"], "long", "java.lang.Math"),
      tj_static("abs", ["int"], "int", "java.lang.Math")]
  } else if fqcn == "java.lang.Long" {
    [tj_static("toHexString", ["long"], "java.lang.String", "java.lang.Long")]
  } else {
    []
  }

fn tj_fields_of(fqcn: String) -> List[JField] !io =
  if fqcn == "java.lang.Math" {
    [JField { name: "PI", type_cls: "double", decl_cls: "java.lang.Math" }]
  } else if fqcn == "java.lang.Integer" {
    [JField { name: "MAX_VALUE", type_cls: "int", decl_cls: "java.lang.Integer" }]
  } else {
    []
  }

fn tj_is_assignable(sup: String, sub: String) -> Bool !io =
  sup == sub || (sup == "java.lang.Object" && not is_prim_name(sub))

fn test_jsig() -> Jsig = {
  let base = jsig_refused()
  Jsig {
    ..base,
    on: true,
    find_class: tj_find_class,
    class_info: tj_class_info,
    methods_of: tj_methods_of,
    static_fields_of: tj_fields_of,
    is_assignable: tj_is_assignable
  }
}

test "Never fits every SAM return representation" {
  let js = test_jsig()
  for ret in [
    "void", "long", "int", "short", "byte", "float", "double", "boolean", "char",
    "java.lang.String"
  ] {
    assert sam_ret_compatible(js, TyNever, ret)
  }
  match sam_fn_ty(js, tj_static("getAsChar", [], "char", "Chars")) {
    Some((params, ret)) -> {
      assert len(params) == 0
      assert ret == TyNever
    }
    None -> { assert false }
  }
}

test "Java Object arguments require checked narrowing" {
  let cx = Cx { ..test_cx(), jsig: test_jsig() }
  let obj = TyJava("java.lang.Object", "Object")
  let string_ref = TyJava("java.lang.String", "String")
  assert param_score(cx, "java.lang.String", Some(obj), 0) == None
  assert param_score(cx, "java.lang.Object", Some(string_ref), 0) == Some(1)
  assert param_score(cx, "[B", Some(TyBytes), 0) == Some(2)
  assert param_score(cx, "java.util.List", Some(TyList(TyString)), 0) == Some(2)
}

test "a Java char return explains the incompatible character models" {
  let (cx, t) = map_java_return(test_cx(), "char", 2, 6)
  assert t == TyError
  assert len(cx.diags) == 1
  assert cx.diags[0].msg == "`char` cannot map directly to Dawn `Char`"
  assert cx.diags[0].hint ==
    "Java `char` is one UTF-16 code unit, while Dawn `Char` is a Unicode scalar; " ++
    "use a Java adapter that returns a decoded code point as `int` (then call `char.of`) " ++
    "or returns `String`"
}

test "unsafe_pure masks io and flags redundancy" {
  # std module: the stamp is std-only (purity-boundary step 1)
  var cx = seed_prelude(test_cx())
  cx = Cx { ..cx, is_std_module: true }
  cx = push_scope(cx)
  # a pure body makes the stamp a no-op
  let e = EUnsafePure(EInt(1, 12, 13), 0, 14)
  let (cx1, t, _) = check_expr(cx, e, no_expected())
  assert t == TyInt
  assert str.contains(cx1.diags[0].msg, "redundant unsafe_pure")
  # a Java-call body (io) is masked: no diags, no recorded effect
  cx = Cx { ..cx, jsig: test_jsig(),
    java_classes: map.insert(cx.java_classes, "Long", "java.lang.Long") }
  let recv = ECtor("Long", [], None, false, 12, 16, 12, 16)
  let jc = EMethod(recv, "toHexString", [pos_arg(EInt(5, 29, 30))], 17, 28, 12, 31)
  let p = EUnsafePure(jc, 0, 33)
  let (cx2, t2, _) = check_expr(cx, p, no_expected())
  assert t2 == opt_ty(TyString)
  assert len(cx2.diags) == 0
  assert len(cx2.frame.used_effects) == 0
}

test "unsafe_pure is refused outside std" {
  # the same expression a std module may write is an error in user code:
  # the stamp erases a proven effect, and that door does not open outward
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  let e = EUnsafePure(EInt(1, 12, 13), 0, 14)
  let (cx1, _, _) = check_expr(cx, e, no_expected())
  assert len(cx1.diags) > 0
  assert str.contains(cx1.diags[0].msg, "not available in user code")
}

test "java calls resolve overloads, wrap references and reject unknowns" {
  var cx = seed_prelude(test_cx())
  cx = Cx { ..cx, jsig: test_jsig(),
    java_classes: map.insert(cx.java_classes, "Math", "java.lang.Math") }
  cx = Cx { ..cx, java_classes: map.insert(cx.java_classes, "Long", "java.lang.Long") }
  cx = push_scope(cx)
  # Math.abs(1): the long overload beats int; primitive return is Int
  let recv = ECtor("Math", [], None, false, 0, 4, 0, 4)
  let call = EMethod(recv, "abs", [pos_arg(EInt(1, 9, 10))], 5, 8, 0, 11)
  let (cx1, t, node) = check_expr(cx, call, no_expected())
  assert t == TyInt
  assert len(cx1.diags) == 0
  match node {
    XJava(jc, ..) -> {
      assert jc.fqcn == "java.lang.Math"
      assert jc.param_cls == ["long"]
      assert jc.is_static
    }
    _ -> { assert false }
  }
  # a String return lands as Option[String]
  let recv2 = ECtor("Long", [], None, false, 0, 4, 0, 4)
  let call2 = EMethod(recv2, "toHexString", [pos_arg(EInt(5, 17, 18))], 5, 16, 0, 19)
  let (cx2, t2, _) = check_expr(cx, call2, no_expected())
  assert t2 == opt_ty(TyString)
  assert len(cx2.diags) == 0
  # unknown method names every candidate shape
  let call3 = EMethod(recv, "nosuch", [], 5, 11, 0, 13)
  let (cx3, _, _) = check_expr(cx, call3, no_expected())
  assert str.contains(cx3.diags[0].msg, "`java.lang.Math` has no static method `nosuch`")
}

test "static field access reads Class.FIELD, maps types, rejects unknowns" {
  var cx = seed_prelude(test_cx())
  cx = Cx { ..cx, jsig: test_jsig(),
    java_classes: map.insert(cx.java_classes, "Math", "java.lang.Math") }
  cx = Cx { ..cx, java_classes: map.insert(cx.java_classes, "Integer", "java.lang.Integer") }
  cx = push_scope(cx)
  # Math.PI is a double -> Float; the node is a field read
  let recv = ECtor("Math", [], None, false, 0, 4, 0, 4)
  let f1 = EFieldAcc(recv, "PI", 5, 7, 0, 7)
  let (cx1, t1, node) = check_expr(cx, f1, no_expected())
  assert t1 == TyFloat
  assert len(cx1.diags) == 0
  match node {
    XJava(jc, ..) -> {
      assert jc.is_field
      assert jc.method == "PI"
      assert jc.fqcn == "java.lang.Math"
    }
    _ -> { assert false }
  }
  # Integer.MAX_VALUE is an int -> Int
  let recv2 = ECtor("Integer", [], None, false, 0, 7, 0, 7)
  let f2 = EFieldAcc(recv2, "MAX_VALUE", 8, 17, 0, 17)
  let (cx2, t2, _) = check_expr(cx, f2, no_expected())
  assert t2 == TyInt
  # a bogus field name is a clear error
  let f3 = EFieldAcc(recv, "NOPE", 5, 9, 0, 9)
  let (cx3, _, _) = check_expr(cx, f3, no_expected())
  assert str.contains(cx3.diags[0].msg, "has no static field `NOPE`")
}

test "ufcs rewrites x.f(a) into f(x, a) with the receiver pre-typed" {
  var cx = seed_prelude(test_cx())
  cx = push_scope(cx)
  let (cxa, _) = declare(cx, "xs", TyList(TyInt), false, 0, 2)
  let u = EMethod(EVar("xs", 0, 2), "len", [], 3, 6, 0, 8)
  let (cx1, t, node) = check_expr(cxa, u, no_expected())
  assert t == TyInt
  assert len(cx1.diags) == 0
  match node {
    XCallBuiltin(n, args2, ..) -> {
      assert n == "len"
      assert len(args2) == 1
    }
    _ -> { assert false }
  }
}

# ---- pass 5 driver: function bodies, const initializers, tests ----

## Mint dictionary symbols for a signature's trait bounds (the Kotlin
## bindDicts): typed as the tvar itself, marked with (trait, tvar).
fn bind_dicts(cx: Cx, s: Sig, nlo: Int, nhi: Int) -> Cx = {
  let empty_d: Map[(Int, Int), Int] = map.empty()
  if not list.any(s.constraints, bs => len(bs) > 0) {
    return Cx { ..cx, frame: Frame { ..cx.frame, dict_syms: empty_d } }
  }
  var cx1 = Cx { ..cx, frame: Frame { ..cx.frame, dict_syms: empty_d } }
  var i = 0
  for tp in s.tparams {
    for tr_id in bounds_of(s, i) {
      match tp {
        TyVar(tn, vid) -> {
          let tr = trait_of(cx1.traits, tr_id)
          let (cx2, sid) = fresh(cx1)
          let sym = Sym {
            name: tr.name ++ "$" ++ tn,
            ty: tp,
            mutable: false,
            dlo: nlo,
            dhi: nhi,
            dict_of: Some((tr_id, vid)),
            ev_of: None
          }
          cx1 = Cx {
            ..cx2,
            syms: map.insert(cx2.syms, sid, sym),
            frame: Frame {
              ..cx2.frame,
              dict_syms: map.insert(cx2.frame.dict_syms, (vid, tr_id), sid)
            }
          }
        }
        _ -> ()
      }
    }
    i = i + 1
  }
  cx1
}

## The signature's dictionary symbols in bound order (codegen appends them
## behind the declared parameters in exactly this order).
fn dict_sym_list(cx: Cx, s: Sig) -> List[Int] = {
  var out: List[Int] = []
  var i = 0
  for tp in s.tparams {
    for tr_id in bounds_of(s, i) {
      match tp {
        TyVar(_, vid) ->
          match map.get(cx.frame.dict_syms, (vid, tr_id)) {
            Some(sid) -> { out = out ++ [sid] }
            None -> ()
          }
        _ -> ()
      }
    }
    i = i + 1
  }
  out
}

## The shared prologue of checkFn and friends: bind the signature frame and
## dictionaries, fresh effect record, one root scope.
##
## The effect variables come out of the signature, the same way the type
## parameters do. They used to arrive as a third parallel list registration
## handed out beside `sigs`, which made a signature's own binders the one
## thing about it that could not be read off it.
fn enter_fn(cx: Cx, s: Sig, nlo: Int, nhi: Int) -> Cx = {
  var ev: Map[String, Eff] = map.empty()
  for e in s.eparams {
    match e {
      EffVar(n, _) -> { ev = map.insert(ev, n, e) }
      _ -> ()
    }
  }
  var tp: Map[String, Ty] = map.empty()
  var bd = cx.current_tparam_bounds
  var ti = 0
  for tv in s.tparams {
    match tv {
      TyVar(tn, tvid) -> {
        tp = map.insert(tp, tn, tv)
        bd = map.insert(bd, tvid, bounds_of(s, ti))
      }
      _ -> ()
    }
    ti = ti + 1
  }
  var cx1 = Cx {
    ..cx,
    current_tparams: tp,
    current_tparam_bounds: bd,
    current_eff_vars: ev,
    frame: Frame { ..cx.frame, current_sig: Some(s) }
  }
  cx1 = bind_dicts(cx1, s, nlo, nhi)
  let empty_w: Map[Eff, (Int, Int, String)] = map.empty()
  cx1 = Cx {
    ..cx1,
    frame: Frame {
      ..cx1.frame,
      used_effects: [],
      eff_witness: empty_w,
      lambda_stack: [],
      loop_stack: [],
      scopes: []
    }
  }
  bind_evidence(push_scope(cx1), s, nlo, nhi)
}

## Bind one hidden evidence parameter per declared effect in the signature, in
## effect-id order (docs/effects-design.md §5.2 step 1). They are locals under
## an unspellable name, flagged as evidence (`Sym.ev_of`) so that they are the
## one kind of local a lambda reaches **without** capturing.
##
## That clause used to end "-- which is the whole of what makes an escaping
## closure keep its handler". It was, and that is the sentence the flip
## falsifies: an escaping closure keeps its *label*, and the handler is whoever
## the eventual caller has installed.
fn bind_evidence(cx: Cx, s: Sig, nlo: Int, nhi: Int) -> Cx = {
  var cx1 = cx
  # the ABI row, not the declared one: a signature that binds `!e` in a
  # parameter takes its slot whether or not its own row mentions it
  let abi = sig_abi_eff(s)
  for l in eff_labels(abi) {
    let (eid, _) = l
    let (cx2, _) =
      declare_evidence(cx1, ev_local_name(cx1, eid), TyAdt(eid, []), label_key(eid), nlo, nhi)
    cx1 = cx2
  }
  # one erased slot per effect variable written in the row, between the
  # labels' slots and the projections', in `eff_vars` order (rule 丁). Same
  # shape and same reason as a projection's: which evidence fills it is
  # decided by the caller's instantiation, so the callee can only forward it.
  for v in eff_vars(abi) {
    let (vid, _) = v
    let (cx2, _) =
      declare_evidence(cx1, ev_var_local_name(vid), erased_ev_ty(), var_key(vid), nlo, nhi)
    cx1 = cx2
  }
  # one erased slot per projection written in the row, behind the labels'
  # slots, in `eff_assocs` order (rule 丙). The body can only forward it --
  # nothing here knows which effect it will turn out to be -- which is
  # exactly what an erased local is good for.
  for a in eff_assocs(abi) {
    let (_, vid, tid, n) = a
    let (cx2, _) = declare_evidence(cx1, ev_assoc_local_name(vid, tid, n), erased_ev_ty(),
      assoc_key(tid), nlo, nhi)
    cx1 = cx2
  }
  cx1
}

## The signature's evidence symbols in effect-id order (lowering appends them
## behind the dictionaries in exactly this order).
fn ev_sym_list(cx: Cx, s: Sig) -> List[Int] = {
  let abi = sig_abi_eff(s)
  var out: List[Int] = []
  for l in eff_labels(abi) {
    let (eid, _) = l
    match lookup(cx, ev_local_name(cx, eid)) {
      Some(sid) -> { out = out ++ [sid] }
      None -> ()
    }
  }
  for v in eff_vars(abi) {
    let (vid, _) = v
    match lookup(cx, ev_var_local_name(vid)) {
      Some(sid) -> { out = out ++ [sid] }
      None -> ()
    }
  }
  for a in eff_assocs(abi) {
    let (_, vid, tid, n) = a
    match lookup(cx, ev_assoc_local_name(vid, tid, n)) {
      Some(sid) -> { out = out ++ [sid] }
      None -> ()
    }
  }
  out
}

## Is `vid` one of the effect variables this signature bound? A variable it
## bound can be written on its own row -- the name resolves to the same
## variable a second time -- and one it did not cannot.
fn eff_var_is_bound(eparams: List[Eff], vid: Int) -> Bool = {
  for p in eparams {
    match p {
      EffVar(_, id) -> if id == vid { return true }
      _ -> ()
    }
  }
  false
}

## The transparent alias whose declaration minted `vid`, if one did. Effect
## variables carry ids from one counter, so at most one declaration answers,
## and an alias is the only declaration whose parameter a use site can supply
## an argument for. Imported aliases are searched too: an elided
## `lib.Thunk` reaches a consumer the same way a local one does.
##
## Walked rather than indexed because this runs on the error path only, at the
## point a diagnostic is already being written.
fn alias_binding_evar(cx: Cx, vid: Int) -> Option[String] = {
  for al in map.values(cx.aliases) {
    if not al.is_opaque && eff_var_is_bound(al.eparams, vid) { return Some(al.name) }
  }
  for exp in map.values(cx.module_exports) {
    for al in map.values(exp.aliases) {
      if not al.is_opaque && eff_var_is_bound(al.eparams, vid) { return Some(al.name) }
    }
  }
  None
}

## The trait whose method this frame is implementing, if it is implementing
## one. `None` for an ordinary function, which is most of what reaches here.
##
## An impl method body is checked by `check_fn`, exactly like a top-level
## annotated function, so nothing on the frame says whose promise its row is
## being held to. The name span answers it: an impl's span covers its methods,
## so the impl that contains this name is the one being written, and the trait
## it implements is whose row the refusal came from.
##
## Containment alone would be too wide -- a `fn` written inside a method body
## is inside the impl's span as well -- so the trait has to declare a method of
## this name too. A local `fn` does not reach here today (an unannotated one is
## refused by its own inference, which says "the body of `f` performs io"), and
## the name check is what keeps that an accident rather than the reason.
##
## Walked rather than indexed for `alias_binding_evar`'s reason: this runs on
## the error path only, at the point a diagnostic is already being written.
fn impl_method_trait(cx: Cx, name: String, nlo: Int, nhi: Int) -> Option[TraitI] = {
  for im in cx.local_impls {
    if im.lo <= nlo && nhi <= im.hi {
      let tr = trait_of(cx.traits, im.trait_id)
      for mm in tr.methods {
        let (mn, _) = mm
        if mn == name { return Some(tr) }
      }
    }
  }
  None
}

## The signature is the promise: every used effect must be subsumed by the
## declared one. `where2` finishes the hint ("the end of the signature" /
## "the trait method").
fn verify_effects(
  cx: Cx,
  kind: String,
  name: String,
  declared: Eff,
  eparams: List[Eff],
  where2: String,
  nlo: Int,
  nhi: Int
) -> Cx = {
  var cx1 = cx
  for used in cx.frame.used_effects {
    # Both axes, not just the base. A label used to be left out on the grounds
    # that it answers for itself at the raise site, and that only ever covered
    # calls that named their callee: a call through a function *value* resolved
    # no evidence at all, so its label went unchecked
    # (docs/effects-soundness-design.md §4.3).
    #
    # Every call resolves evidence now -- a dynamic one through
    # `dyn_evidence_args`, a named one through `evidence_args` and
    # `evidence_var_args` -- so the reporting surface is wider than it was and
    # this check's job is narrower in what it is the *only* catcher of. It is
    # not narrower in what it holds. The two still do not overlap, for the same
    # reason as before and now at three sites rather than one: whatever reports
    # "nobody is handling this" hands the label back to be withdrawn from the
    # row it charges, so what reaches here is exactly the labels that found
    # evidence, and those are the ones a signature must admit.
    if not eff_subsumes(declared, used) {
      let (wlo, whi, wname) = match map.get(cx.frame.eff_witness, used) {
        Some(w) -> w
        None -> (nlo, nhi, "?")
      }
      # "add !e" is advice that cannot be taken when the effect is a variable
      # this signature does not bind: an effect variable is bound where it is
      # written, so writing `!e` on this signature binds a *new* one and the
      # row still will not subsume. This is the RX-10 hint the audit recorded
      # as pointing down a dead end (docs/audit/re-audit-b-decisions.md), and
      # it is reachable exactly when the variable came from a type
      # declaration's effect parameter, through an application that elided the
      # effect argument.
      #
      # Which is why the elided application is named when it can be found: the
      # repair is to stop eliding. `Thunk[!e]` with `!e` bound on this
      # signature substitutes this frame's variable into the expansion, and
      # then the row does subsume. Only a transparent alias has that repair; a
      # record or variant field's binder has no argument position, so the
      # advice there stays what it was.
      let advice = match used {
        EffVar(vn, vid) ->
          if eff_var_is_bound(eparams, vid) {
            "add !" ++ eff_show(used) ++ " to " ++ where2 ++ ", or remove the call"
          } else {
            match alias_binding_evar(cx, vid) {
              Some(owner) ->
                "`!" ++ vn ++ "` is `" ++ owner ++ "`'s own effect parameter, so writing `!" ++
                vn ++ "` on " ++ where2 ++ " would bind a different variable: write `" ++
                owner ++ "`'s effect argument at the type application, spelling a row " ++
                "this signature does bind, or declare !io, which covers any row"
              None ->
                "`!" ++ vn ++ "` is bound where it was written, so writing `!" ++ vn ++ "` on " ++
                where2 ++ " would bind a different variable: declare !io, which covers any " ++
                "row, or remove the call"
            }
          }
        # An impl method gets a third road, and it is the one that keeps the
        # other impls out of it. "Add !io here" is advice that can be taken,
        # unlike the variable case above, but taken alone it is refused at the
        # signature next (`passes.pass_register_impls`: the trait declares it
        # pure), and the edit that clears *that* widens the trait's row for
        # every impl there is. So the same sentence is offered from both ends.
        _ ->
          match impl_method_trait(cx, name, nlo, nhi) {
            Some(tr) ->
              "add !" ++ eff_show(used) ++ " to " ++ where2 ++ ", or remove the call; " ++
              assoc_effect_advice(cx.adts, tr)
            None -> "add !" ++ eff_show(used) ++ " to " ++ where2 ++ ", or remove the call"
          }
      }
      cx1 = cerr_h(cx1, kind ++ " `" ++ name ++ "` is not declared !" ++ eff_show(used) ++
          " but calls `" ++ wname ++ "` (!" ++ eff_show(used) ++ ")", wlo, whi, advice)
    }
  }
  cx1
}

## The signature of the function a defaulted parameter synthesizes: zero
## parameters, the parameter's type, pure -- `f$default$k` in f's module.
## `$` is not in the identifier lexicon, so the name cannot collide.
##
## It repeats the parent's type parameters and bounds verbatim (#207 §4.3):
## the parameter's type may mention them, and generics are erased before Core,
## so what survives instantiation is the dictionary row. Copying the row
## whole -- rather than the subset this one default happens to use -- is what
## lets a call site hand its own witnesses straight over: both sides read the
## row in `tparams x bounds_of` order, and a filtered row would renumber it.
## `eparams` stays empty because a default is refused any effect.
fn default_sig(parent: Sig, fname: String, k: Int, pty: Ty) -> Sig =
  Sig {
    name: fname ++ "\$default\$" ++ to_string(k),
    param_tys: [],
    param_names: [],
    param_defaults: [],
    ret: pty,
    eff: EPure,
    is_builtin: false,
    tparams: parent.tparams,
    constraints: parent.constraints,
    eparams: [],
    owner: parent.owner,
    trait_id: None,
    op_of: None,
    inferring: false
  }

## Strip parameter defaults off a declaration whose position refuses them
## (impl methods): registration already reported the refusal, and checking
## the expressions anyway would report their private mistakes twice.
pub fn strip_param_defaults(d: FnDecl) -> FnDecl = {
  var any = false
  for p in d.params {
    match p.default {
      Some(_) -> { any = true }
      None -> ()
    }
  }
  if not any { return d }
  let none_e: Option[Expr] = None
  FnDecl { ..d, params: map(d.params, p => Param { ..p, default: none_e }) }
}

fn no_tdefault() -> Option[TDefault] = None

## Check each parameter default in the declaring module's scope (#207 §4.2):
## no parameters, a pure frame of its own. The expression becomes the body of
## the synthesized `f$default$k`, so what is in scope here is exactly what is
## in scope there -- a reference to a sibling parameter is an ordinary
## `undefined variable`, by construction rather than by a rule.
##
## The frame does carry the function's type parameters and their bounds
## (`default_sig` repeats them), so a parameter whose type mentions them takes
## a default like any other; `enter_fn` mints the dictionary symbols and they
## are carried out here, because the synthesized function has to bind the very
## symbols its body was checked against.
fn check_param_defaults(cx: Cx, d: FnDecl, s: Sig) -> (Cx, List[Option[TDefault]]) !io = {
  var cx1 = cx
  var out: List[Option[TDefault]] = []
  var k = 0
  for p in d.params {
    match p.default {
      None -> { out = out ++ [no_tdefault()] }
      Some(de) -> {
        let pty = s.param_tys[k]
        let dsig = default_sig(s, d.name, k, pty)
        var cxd = enter_fn(cx1, dsig, p.lo, p.hi)
        let (cxe, dt, dx) = check_expr(cxd, de, Some(pty))
        cxd = cxe
        if not assignable(cxd, dt, pty) {
          cxd = cerr(cxd, "parameter `" ++ p.name ++ "` is " ++ ty_show(cxd.adts, pty) ++
              " but its default value is " ++ ty_show(cxd.adts, dt), e_lo(de), e_hi(de))
        }
        # the row would otherwise depend on whether the call site omits the
        # argument -- one signature, two effect rows (#207 §4.3)
        for used in cxd.frame.used_effects {
          if not eff_subsumes(EPure, used) {
            let (wlo, whi, wname) = match map.get(cxd.frame.eff_witness, used) {
              Some(w) -> w
              None -> (e_lo(de), e_hi(de), "?")
            }
            cxd = cerr_h(cxd, "a parameter default must be pure, but it calls `" ++ wname ++
                "` (!" ++ eff_show(used) ++ ")", wlo, whi,
              "the default runs at every call that omits the argument; " ++
                "take the argument explicitly, or drop the effect")
          }
        }
        let dsyms = dict_sym_list(cxd, dsig)
        cx1 = pop_scope(cxd)
        out = out ++ [Some(TDefault { body: dx, dict_syms: dsyms })]
      }
    }
    k = k + 1
  }
  (cx1, out)
}

## Check one annotated function body against its signature (the Kotlin checkFn).
pub fn check_fn(cx: Cx, d: FnDecl, s: Sig) -> (Cx, TFun) !io = {
  let (cx0, dtxs) = check_param_defaults(cx, d, s)
  var cx1 = enter_fn(cx0, s, d.nlo, d.nhi)
  var psyms: List[Int] = []
  var i = 0
  for p in d.params {
    let (cxa, sid) = declare(cx1, p.name, s.param_tys[i], false, p.lo, p.hi)
    cx1 = cxa
    psyms = psyms ++ [sid]
    i = i + 1
  }
  let (cx2, bt, bx) = check_expr(cx1, d.body, Some(s.ret))
  cx1 = cx2
  if not assignable(cx1, bt, s.ret) {
    cx1 = cerr(cx1, "function `" ++ d.name ++ "` declares return type " ++
        ty_show(cx1.adts, s.ret) ++ " but its body is " ++ ty_show(cx1.adts, bt),
      e_lo(d.body), e_hi(d.body))
  }
  cx1 = verify_effects(cx1, "function", d.name, s.eff, s.eparams, "the end of the signature",
    d.nlo, d.nhi)
  let dsyms = dict_sym_list(cx1, s)
  let esyms = ev_sym_list(cx1, s)
  cx1 = pop_scope(cx1)
  (cx1, TFun {
    name: d.name,
    sig: s,
    param_syms: psyms,
    dict_syms: dsyms,
    ev_syms: esyms,
    defaults: dtxs,
    body: bx,
    is_test: false,
    impl_of: None,
    default_of: None
  })
}

## Check the body of a signature-inferred function and seal its signature:
## ret = the body's type, eff = the body's effects (or the declared one, which
## is then enforced as usual). The Kotlin checkFnInferred.
pub fn check_fn_inferred(cx: Cx, d: FnDecl, s: Sig) -> (Cx, Sig, TFun) !io = {
  let (cx0, dtxs) = check_param_defaults(cx, d, s)
  var cx1 = enter_fn(cx0, s, d.nlo, d.nhi)
  var psyms: List[Int] = []
  var i = 0
  for p in d.params {
    let (cxa, sid) = declare(cx1, p.name, s.param_tys[i], false, p.lo, p.hi)
    cx1 = cxa
    psyms = psyms ++ [sid]
    i = i + 1
  }
  let (cx2, bt, bx) = check_expr(cx1, d.body, no_expected())
  cx1 = cx2
  var final_eff = EPure
  if len(d.effs) == 0 {
    # Effect *variables* and io are inferred; a declared effect is not. Its
    # evidence parameter is synthesised from the written signature, and a
    # label that appeared only after the body was checked would have no
    # parameter to arrive through. Every such label was already refused where
    # it was raised (no evidence was in scope to raise it with), so the seal
    # keeps the base row only.
    final_eff = eff_base(eff_union(cx1.frame.used_effects))
  } else {
    # the registration pass resolved the declared effect
    cx1 = verify_effects(cx1, "function", d.name, s.eff, s.eparams,
      "the end of the signature", d.nlo, d.nhi)
    final_eff = s.eff
  }
  let sealed = Sig { ..s, ret: bt, eff: final_eff, inferring: false }
  let dsyms = dict_sym_list(cx1, s)
  let esyms = ev_sym_list(cx1, s)
  var cx3 = pop_scope(cx1)
  # Not a binding, so not a bind_fn caller: the guard says this name already
  # resolves to exactly this signature, and sealing the inferred return type
  # replaces it in place. The origin it was bound under does not move.
  if map.get(cx3.fns, d.name) == Some(s) {
    cx3 = Cx { ..cx3, fns: map.insert(cx3.fns, d.name, sealed) }
  }
  (cx3, sealed,
    TFun {
      name: d.name,
      sig: sealed,
      param_syms: psyms,
      dict_syms: dsyms,
      ev_syms: esyms,
      defaults: dtxs,
      body: bx,
      is_test: false,
      impl_of: None,
      default_of: None
    })
}

## Check a trait's default method body against its own signature (T stays
## rigid). The Kotlin checkTraitDefault.
pub fn check_trait_default(cx: Cx, m2: TraitMethod, s: Sig, body: Expr) -> (Cx, TFun) !io = {
  var cx1 = enter_fn(cx, s, m2.nlo, m2.nhi)
  var psyms: List[Int] = []
  var i = 0
  for p in m2.params {
    let (cxa, sid) = declare(cx1, p.name, s.param_tys[i], false, p.lo, p.hi)
    cx1 = cxa
    psyms = psyms ++ [sid]
    i = i + 1
  }
  let (cx2, bt, bx) = check_expr(cx1, body, Some(s.ret))
  cx1 = cx2
  if not assignable(cx1, bt, s.ret) {
    cx1 = cerr(cx1, "method `" ++ m2.name ++ "` declares return type " ++
        ty_show(cx1.adts, s.ret) ++ " but its default body is " ++ ty_show(cx1.adts, bt),
      e_lo(body), e_hi(body))
  }
  cx1 = verify_effects(cx1, "method", m2.name, s.eff, s.eparams, "the trait method", m2.nlo, m2.nhi)
  let dsyms = dict_sym_list(cx1, s)
  let esyms = ev_sym_list(cx1, s)
  cx1 = pop_scope(cx1)
  (cx1, TFun {
    name: m2.name,
    sig: s,
    param_syms: psyms,
    dict_syms: dsyms,
    ev_syms: esyms,
    defaults: [],
    body: bx,
    is_test: false,
    impl_of: None,
    default_of: None
  })
}

fn test_sig(name: String) -> Sig =
  Sig {
    name: name,
    param_tys: [],
    param_names: [],
    param_defaults: [],
    ret: TyUnit,
    eff: EIo,
    is_builtin: false,
    tparams: [],
    constraints: [],
    eparams: [],
    owner: None,
    trait_id: None,
    op_of: None,
    inferring: false
  }

## Check one test block: fresh frame, assert allowed, io implicit (spec §3.4).
pub fn check_test(cx: Cx, name: String, body: Expr) -> (Cx, TFun) !io = {
  let empty_tp: Map[String, Ty] = map.empty()
  let empty_ev: Map[String, Eff] = map.empty()
  let empty_d: Map[(Int, Int), Int] = map.empty()
  let empty_w: Map[Eff, (Int, Int, String)] = map.empty()
  var cx1 = Cx {
    ..cx,
    current_tparams: empty_tp,
    current_eff_vars: empty_ev,
    frame: Frame {
      ..cx.frame,
      current_sig: None,
      dict_syms: empty_d,
      used_effects: [],
      eff_witness: empty_w,
      lambda_stack: [],
      loop_stack: [],
      scopes: []
    },
    in_test: true
  }
  cx1 = push_scope(cx1)
  let (cx2, bt, bx) = check_expr(cx1, body, Some(TyUnit))
  cx1 = cx2
  if not assignable(cx1, bt, TyUnit) {
    cx1 = cerr_h(cx1, "a test block's trailing value is discarded (" ++
        ty_show(cx1.adts, bt) ++ ")", e_lo(body), e_hi(body),
      "assert on it instead of leaving it as the last expression")
  }
  cx1 = pop_scope(cx1)
  cx1 = Cx { ..cx1, in_test: false }
  (cx1, TFun {
    name: name,
    sig: test_sig(name),
    param_syms: [],
    dict_syms: [],
    ev_syms: [],
    defaults: [],
    body: bx,
    is_test: true,
    impl_of: None,
    default_of: None
  })
}

## The initializer must be pure, comptime-evaluable, and match the declared
## type; only earlier constants are visible (the Kotlin checkConstInit).
pub fn check_const_init(
  cx: Cx,
  d: ConstView,
  declared: Ty,
  visible: Set[String]
) -> (Cx, TConst) !io = {
  let empty_tp: Map[String, Ty] = map.empty()
  let empty_ev: Map[String, Eff] = map.empty()
  var cx1 = Cx {
    ..cx,
    current_tparams: empty_tp,
    current_eff_vars: empty_ev,
    const_cutoff: Some(visible)
  }
  let (cx2, frame) = enter_isolated(cx1)
  let (cx3, bt, bx) = check_expr(cx2, d.init, Some(declared))
  cx1 = leave_isolated(cx3, frame, "const initializers", e_lo(d.init), e_hi(d.init))
  if not assignable(cx1, bt, declared) {
    cx1 = cerr(cx1, "`" ++ d.name ++ "` declares type " ++ ty_show(cx1.adts, declared) ++
        " but its initializer is " ++ ty_show(cx1.adts, bt), e_lo(d.init), e_hi(d.init))
  }
  cx1 = Cx { ..cx1, const_cutoff: None }
  (cx1, TConst { name: d.name, ty: declared, init: bx, lo: d.lo, hi: d.hi })
}

fn no_tfun() -> Option[TFun] = None

## The whole checking pipeline for one module (the Kotlin Checker.check()):
## passes 0–4 register declarations, pass 5 checks bodies — inferred functions
## first in call-dependency order, then consts, annotated fns, impl methods,
## trait defaults, tests.
pub fn check_module(cx: Cx, m: Module, env: Map[String, ModExports]) -> (Cx, TModule) !io = {
  var cx1 = seed_prelude(cx)
  # the header passes below record where each written type reference sat, so
  # the public surface validator can blame the innermost token the author
  # wrote rather than the declaration's name (docs/public-surface-design.md §八)
  cx1 = Cx { ..cx1, record_ty_spans: true }
  cx1 = pass_java_uses(cx1, m)
  cx1 = pass_imports(cx1, m, env)
  let (cxa, shells) = pass_type_shells(cx1, m)
  cx1 = cxa
  # **Effects before ctor fields.** A record field or a variant field may name
  # a declared effect now (`fn() -> Int !Ask` is a legal field type since the
  # written-label refusal went), and `resolve_eff_at` can only tell a label
  # from an effect variable by looking the name up. The two passes are
  # independent in the other direction: `pass_effects` resolves its operations'
  # parameter and return types, which need type *shells* and never a field.
  #
  # It costs an id shift in one shape and nothing anywhere else: both mint from
  # `Cx.next_id`, so a module that declares an effect *and* a type declaration
  # binding `[!e]` numbers the two the other way round than it used to.
  cx1 = pass_effects(cx1, m)
  cx1 = pass_ctor_fields(cx1, m, shells)
  cx1 = pass_resolve_aliases(cx1)
  cx1 = pass_register_traits(cx1, m)
  let (cxb, impl_sigs) = pass_register_impls(cx1, m, shells)
  cx1 = cxb
  let (cxc, sigs) = pass_fn_signatures(cx1, m)
  cx1 = cxc
  let (cxd, const_tys) = pass_const_decls(cx1, m)
  cx1 = cxd
  cx1 = pass_main_check(cx1, m, sigs)
  # SEM-07: the public surface is settled once the headers are, and it is
  # validated here rather than after the bodies on purpose (design §三). A
  # public contract's error then lands on its declaration whatever an
  # unrelated body does, and it lands *before* that body's diagnostics.
  cx1 = pass_export_surface(cx1, m)
  let no_spans: Map[(Int, Int), TySpan] = map.empty()
  cx1 = Cx { ..cx1, record_ty_spans: false, ty_spans: no_spans }
  # 5. inferred functions first, in call-dependency order — every callee's
  # signature is final before any caller is checked; a cycle must annotate
  let fnds = module_fns(m)
  # What the inferred pass produced, keyed by declaration index. It fills
  # scattered positions in dependency order, and writing each result into a
  # list made the pass O(F^2) in the module's function count: a 3200-function
  # module spent 1.02s above the floor on the rebuilds alone.
  var inferred: Map[Int, TFun] = map.empty()
  var pending: List[Int] = []
  var i = 0
  for d in fnds {
    if sigs[i].inferring { pending = pending ++ [i] }
    i = i + 1
  }
  if len(pending) > 0 {
    var pending_names: Set[String] = set.empty()
    for idx in pending { pending_names = set.insert(pending_names, fnds[idx].name) }
    var deps: Map[String, List[String]] = map.empty()
    # the aliases are fixed for the module: pass_imports has already run, and a
    # local declaration may not shadow one (spec §10.3)
    let mod_alias_names: Set[String] = set.from(map.keys(cx1.module_aliases))
    # `Class.m(..)` is a Java static call only when neither a constructor nor a
    # constant claims the name first — that is check_method_call's static arm,
    # and subtracting the two here keeps rs_java_static a membership test. All
    # three tables are final: pass_java_uses, the type passes and
    # pass_const_decls have all run.
    var java_recv: Set[String] = set.empty()
    for cn in map.keys(cx1.java_classes) {
      if not map.has(cx1.ctors_by_name, cn) && not map.has(cx1.consts, cn) {
        java_recv = set.insert(java_recv, cn)
      }
    }
    for idx in pending {
      let d = fnds[idx]
      var sc = ref_scope(mod_alias_names, java_recv)
      for p in fnds[idx].params { sc = rs_bind(sc, p.name) }
      let refs: Set[String] = name_refs(d.body, set.empty(), sc)
      var dlist: List[String] = []
      for r in set.to_list(refs) {
        if set.has(pending_names, r) { dlist = dlist ++ [r] }
      }
      deps = map.insert(deps, d.name, dlist)
    }
    var done: Set[String] = set.empty()
    var progress = true
    while progress {
      progress = false
      var remaining: List[Int] = []
      for idx in pending {
        let d = fnds[idx]
        let dlist = map.get(deps, d.name).expect("dep")
        var ready = true
        for r in dlist {
          if not set.has(done, r) { ready = false }
        }
        if ready {
          # each pending index is completed at most once, so the signature this
          # reads is still the unsealed one the list held
          let (cxe, _, tf) = check_fn_inferred(cx1, d, sigs[idx])
          cx1 = cxe
          inferred = map.insert(inferred, idx, tf)
          done = set.insert(done, d.name)
          progress = true
        } else {
          remaining = remaining ++ [idx]
        }
      }
      pending = remaining
    }
    # what remains is a dependency cycle
    for idx in pending {
      let d = fnds[idx]
      cx1 = cerr_h(cx1, "cannot infer the return type of `" ++ d.name ++
          "`: it is recursive (directly or mutually)", d.nlo, d.nhi,
        "declare it: fn " ++ d.name ++ "(...) -> T = ...")
    }
  }
  # 5.5. constant initializers, in declaration order (a const sees only
  # earlier consts; that order is also the evaluation order)
  var tconsts: List[TConst] = []
  var visible: Set[String] = set.empty()
  var ci = 0
  for d in module_consts(m) {
    match const_tys[ci] {
      Some(declared) -> {
        let (cxe, tc) = check_const_init(cx1, d, declared, visible)
        cx1 = cxe
        tconsts = tconsts ++ [tc]
      }
      None -> ()
    }
    visible = set.insert(visible, d.name)
    ci = ci + 1
  }
  # annotated function bodies. The typed functions are assembled here, in
  # declaration order, taking the inferred pass's result where it has one --
  # the sealed signature it also produced went into cx.fns at the time and is
  # not read back, and an inferring index never reaches check_fn.
  var tfuns: List[Option[TFun]] = []
  i = 0
  for d in fnds {
    if not sigs[i].inferring {
      let (cxe, tf) = check_fn(cx1, d, sigs[i])
      cx1 = cxe
      tfuns = tfuns ++ [Some(tf)]
    } else {
      match map.get(inferred, i) {
        Some(tf) -> { tfuns = tfuns ++ [Some(tf)] }
        None -> { tfuns = tfuns ++ [no_tfun()] }
      }
    }
    i = i + 1
  }
  # 5.75. impl method bodies and trait default bodies (full signatures, so
  # they check like ordinary annotated functions)
  var ii = 0
  var impl_tfuns: List[TFun] = []
  for imd in module_impls(m) {
    let msigs = impl_sigs[ii]
    # recover (trait id, subject) for codegen's mangled impl-method names;
    # both lookups re-run what registration already validated, diags discarded
    let imp_key: Option[(Int, Ty)] = match map.get(cx1.traits_by_name, imd.trait_name) {
      Some(t) -> {
        let (_, subj) = resolve_type(cx1, imd.subject)
        if subj == TyError { None } else { Some((t, subj)) }
      }
      None -> None
    }
    var mi = 0
    for me in imd.methods {
      match msigs[mi] {
        Some(ms) -> {
          # registration refused any parameter defaults; strip them so the
          # refusal is not followed by the value's own diagnostics
          let (cxe, tf) = check_fn(cx1, strip_param_defaults(me), ms)
          cx1 = cxe
          impl_tfuns = impl_tfuns ++ [TFun { ..tf, impl_of: imp_key }]
        }
        None -> ()
      }
      mi = mi + 1
    }
    ii = ii + 1
  }
  var default_tfuns: List[TFun] = []
  for td in module_traits(m) {
    let tid = map.get(cx1.traits_by_name, td.name)
    match tid {
      Some(t) -> {
        let tr = trait_of(cx1.traits, t)
        for me in td.methods {
          match me.body {
            Some(b) -> {
              var msig: Option[Sig] = None
              for entry in tr.methods {
                let (mname, ms2) = entry
                if mname == me.name { msig = Some(ms2.sig) }
              }
              match msig {
                Some(s2) -> {
                  let (cxe, tf) = check_trait_default(cx1, me, s2, b)
                  cx1 = cxe
                  default_tfuns = default_tfuns ++ [TFun { ..tf, default_of: Some(t) }]
                }
                None -> ()
              }
            }
            None -> ()
          }
        }
      }
      None -> ()
    }
  }
  var ttests: List[TFun] = []
  for t in module_tests(m) {
    let (cxe, tf) = check_test(cx1, t.name, t.body)
    cx1 = cxe
    ttests = ttests ++ [tf]
  }
  var fns_out: List[TFun] = []
  for sl in tfuns {
    match sl {
      Some(tf) -> { fns_out = fns_out ++ [tf] }
      None -> ()
    }
  }
  # Synthesize the default-value functions (#207 §4.4): one zero-parameter
  # pure function per defaulted parameter, appended as ordinary module
  # functions -- lowering, both backends and the comptime interpreter treat
  # them like anything else declared here. The signature is also bound into
  # the fn table so the drivers' program-wide descriptor tables pick it up;
  # the name has a `$`, which no source call can spell.
  var synth: List[TFun] = []
  for tf in fns_out {
    var k = 0
    for dv in tf.defaults {
      match dv {
        Some(dd) -> {
          let ds = default_sig(tf.sig, tf.name, k, tf.sig.param_tys[k])
          synth = synth ++ [TFun {
            name: ds.name,
            sig: ds,
            param_syms: [],
            # the signature repeats the parent's bounds, so the body binds one
            # dictionary per bound -- the same symbols `check_param_defaults`
            # checked it against. Leaving these empty while the signature
            # carries constraints is a descriptor/body disagreement, which is
            # a verification error at run time rather than a diagnostic.
            dict_syms: dd.dict_syms,
            ev_syms: [],
            defaults: [],
            body: dd.body,
            is_test: false,
            impl_of: None,
            default_of: None
          }]
          cx1 = Cx { ..cx1, fns: map.insert(cx1.fns, ds.name, ds) }
        }
        None -> ()
      }
      k = k + 1
    }
  }
  fns_out = fns_out ++ synth ++ impl_tfuns ++ default_tfuns
  (cx1, TModule { fns: fns_out, consts: tconsts, tests: ttests, syms: cx1.syms })
}

## The diagnostics of one source, in order.
fn msgs_of(src: String) -> List[String] !io = {
  let (m, pdiags) = parser.parse_module(src)
  if len(pdiags) > 0 { panic("the source does not parse: " ++ pdiags[0].msg) }
  let env: Map[String, ModExports] = map.empty()
  let (cx, _) = check_module(seed_prelude(test_cx()), m, env)
  map(cx.diags, d => d.msg)
}

fn hints_of(src: String) -> List[String] !io = {
  let (m, _) = parser.parse_module(src)
  let env: Map[String, ModExports] = map.empty()
  let (cx, _) = check_module(seed_prelude(test_cx()), m, env)
  map(cx.diags, d => d.hint)
}

test "`[]` names the subject it could not index, whatever shape it is" {
  # The requirer is built from the actual subject rather than being a fixed
  # phrase, so it says which Map -- and, more to the point, it says things
  # about types the compiler has never heard of. That is the difference the
  # trait buys: the old message enumerated the subjects it knew, and a user
  # type could not be one of them.
  #
  # One row per shape in docs/operator-traits-design.md D6.

  # a rigid key: three sub-goals of the conditional impl, all at the `[]`
  let ms = msgs_of("pub fn look[K](m: Map[K, Int], k: K) -> Int = m[k]\n")
  assert ms == ["indexing a Map[K, Int] requires `Eq[K]`, but `K` has no such bound",
    "indexing a Map[K, Int] requires `Hash[K]`, but `K` has no such bound",
    "indexing a Map[K, Int] requires `Show[K]`, but `K` has no such bound"]
  assert hints_of("pub fn look[K](m: Map[K, Int], k: K) -> Int = m[k]\n")[0] ==
    "add the bound: [K: Eq]"

  # a user type with an impl: it reaches the message at all, which is new
  let grid = "type Grid = { w: Int }\n" ++
    "impl Index[Grid] {\n  type Idx = Int\n  type Item = Int\n" ++
    "  fn index(g: Grid, i: Int) -> Int = g.w + i\n}\n"
  assert len(msgs_of(grid ++ "pub fn f(g: Grid) -> Int = g[1]\n")) == 0
  assert msgs_of(grid ++ "pub fn f(g: Grid) -> Int = g[\"x\"]\n") ==
    ["this index must be `Int`, got `String`"]

  # an opaque subject falls through to its target's impl, so the requirer
  # reports the *identity* (the opaque name applied to its arguments, which is
  # all the caller sees) while the trait and type report the gap inside the
  # target. `M[K]` and not `M`: an opaque type carries its arguments, so a
  # diagnostic about `M[Int]` cannot read as one about `M[String]`
  let opq = "opaque type M[K] = Map[K, Int]\n" ++
    "pub fn f[K](m: M[K], k: K) -> Int = m[k]\n"
  assert msgs_of(opq) == ["indexing a M[K] requires `Eq[K]`, but `K` has no such bound",
    "indexing a M[K] requires `Hash[K]`, but `K` has no such bound",
    "indexing a M[K] requires `Show[K]`, but `K` has no such bound"]

  # a ground gap inside the target does NOT read as the requirer: a missing
  # impl at a concrete type is `resolve_witness`'s own message, which never
  # mentions who asked. Pinned because docs/operator-traits-design.md D6
  # predicted otherwise.
  assert msgs_of("type Foo = { v: Int }\n" ++
      "opaque type Keyed = Map[Foo, Int]\n" ++
      "pub fn g(m: Keyed, k: Foo) -> Int = m[k]\n") ==
    ["no impl of `Show` for `Foo`"]

  # a bare rigid parameter: the bound it is missing is `Index` itself
  assert msgs_of("pub fn f[C](c: C, i: Int) -> Int = c[i]\n") ==
    ["indexing a C requires `Index[C]`, but `C` has no such bound"]
  assert hints_of("pub fn f[C](c: C, i: Int) -> Int = c[i]\n")[0] ==
    "add the bound: [C: Index]"
}

test "a ground subject with no `Index` impl keeps the message that points at get" {
  # `resolve_witness` would answer "no impl of `Index` for `Bool`", which is
  # true and drops the only part of this diagnostic anyone acts on: that
  # absence has an answer and it is `get`.
  let ms = msgs_of("pub fn f() -> Int = {\n  let b = true\n  b[0]\n}\n")
  assert ms == ["`[]` needs an `Index` impl for `Bool`"]
  assert hints_of("pub fn f() -> Int = {\n  let b = true\n  b[0]\n}\n")[0] ==
    "List and Map have one; when absence is a normal case, use get(xs, i) / map.get(m, k)"
  # a tuple has no head, so no impl could be written for it either
  assert msgs_of("pub fn f(p: (Int, Int)) -> Int = p[0]\n") ==
    ["`[]` needs an `Index` impl for `(Int, Int)`"]
}

test "an Eq impl must come with a Hash impl" {
  let eq_impl = "type P = { x: Int }\n" ++
    "impl Eq[P] {\n  fn eq(a: P, b: P) -> Bool = a.x == b.x\n}\n"
  let hash_impl = "impl Hash[P] {\n  fn hash(p: P) -> Int = p.x\n}\n"
  let env: Map[String, ModExports] = map.empty()
  let (m1, _) = parser.parse_module(eq_impl)
  let (cx1, _) = check_module(seed_prelude(test_cx()), m1, env)
  assert len(cx1.diags) == 1
  assert cx1.diags[0].msg == "`impl Eq[P]` needs a matching `impl Hash`"
  # the other way round reports symmetrically
  let (m2, _) = parser.parse_module("type P = { x: Int }\n" ++ hash_impl)
  let (cx2, _) = check_module(seed_prelude(test_cx()), m2, env)
  assert cx2.diags[0].msg == "`impl Hash[P]` needs a matching `impl Eq`"
  # together they check
  let (m3, _) = parser.parse_module(eq_impl ++ hash_impl)
  let (cx3, _) = check_module(seed_prelude(test_cx()), m3, env)
  assert len(cx3.diags) == 0
}

## The witness on the `==` that is the whole body of `fn f` in a checked
## module (the impl methods in these sources have `==` bodies of their own).
fn eq_wit_of(src: String) -> Option[WitRef] !io = {
  let (m, _) = parser.parse_module(src)
  let env: Map[String, ModExports] = map.empty()
  let (_cx, tm) = check_module(seed_prelude(test_cx()), m, env)
  var found: Option[WitRef] = None
  for tf in tm.fns {
    if tf.name == "f" {
      match tf.body {
        XBinary(_, _, _, w, _, _, _, _, _) -> { found = w }
        _ -> ()
      }
    }
  }
  found
}

test "== resolves its witness the same way a bound does" {
  # Every `==` now carries a witness, because it asks the one solver a
  # `[T: Eq]` bound asks. For a scalar or a plain ADT that witness names the
  # relation the compiler defines, so the emitted code is what it always was
  # -- what changed is that the two doors cannot answer differently.
  assert eq_wit_of("fn f(a: Int, b: Int) -> Bool = a == b") ==
    Some(WConcrete(EQ_ID, TyInt))
  var adt_tid = -1
  match eq_wit_of("type C = | R | G\nfn f(a: C, b: C) -> Bool = a == b") {
    Some(WConcrete(t, _)) -> { adt_tid = t }
    _ -> ()
  }
  assert adt_tid == EQ_ID
  # an overriding impl puts the operator on the dictionary rail
  let over = "type P = { x: Int }\n" ++
    "impl Eq[P] {\n  fn eq(a: P, b: P) -> Bool = a.x == b.x\n}\n" ++
    "impl Hash[P] {\n  fn hash(p: P) -> Int = p.x\n}\n" ++
    "fn f(a: P, b: P) -> Bool = a == b\n"
  var tid = -1
  match eq_wit_of(over) {
    Some(WConcrete(t, _)) -> { tid = t }
    _ -> ()
  }
  assert tid == EQ_ID
}

test "check_module: a whole module checks end to end" {
  let src = "fn add(a: Int, b: Int) -> Int = a + b\n" ++
    "fn twice(x: Int) = add(x, x)\n" ++
    "const K: Int = 41\n" ++
    "pub fn main() -> Unit !io = ()\n" ++
    "test \"k\" {\n  assert twice(K) == 82\n}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(test_cx(), m, env)
  assert len(cx1.diags) == 0
  # the inferred signature sealed to Int, pure
  let tw = map.get(cx1.fns, "twice").expect("twice")
  assert tw.ret == TyInt
  assert tw.eff == EPure
  assert not tw.inferring
  assert len(tm.fns) == 3
  assert len(tm.consts) == 1
  assert len(tm.tests) == 1
}

test "check_module: a bare None arm infers from a concrete sibling arm" {
  # `entry` is unannotated and the `[]` arm has no expected type of its own; it
  # must borrow Option[Int] from the concrete `Some` arm (match sibling inference)
  let src =
    "pub fn first(xs: List[Int]) -> Bool = {\n" ++
    "  let entry = match xs {\n" ++
    "    [x, ..] -> Some(x)\n" ++
    "    [] -> None\n" ++
    "  }\n" ++
    "  match entry { Some(v) -> true, None -> false }\n" ++
    "}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(test_cx(), m, env)
  assert len(cx1.diags) == 0
}

test "opaque type: the declaring module converts, and only it" {
  # `sees_through` is the whole of opacity, so both directions of the
  # conversion and the refusal belong in one test -- they are one line of code
  let src =
    "pub opaque type Id = Int\n" ++
    "pub fn wrap(n: Int) -> Id = n\n" ++
    "pub fn unwrap(i: Id) -> Int = i\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(cx_new(Some("ids"), None), m, env)
  assert len(cx1.diags) == 0

  # the same two conversions, seen from another module, are two errors
  let (cxo, _) = check_module(cx_new(Some("ids"), None), m, env)
  let env2 = map.insert(env, "ids", exports_of(cxo, m, "ids", "ids"))
  let src2 =
    "use ids.{Id}\n" ++
    "pub fn peek(i: Id) -> Int = i\n" ++
    "pub fn make(n: Int) -> Id = n\n"
  let (m2, pdiags2) = parser.parse_module(src2)
  assert len(pdiags2) == 0
  let (cx2, _) = check_module(cx_new(Some("other"), None), m2, env2)
  assert len(cx2.diags) == 2
  assert str.contains(cx2.diags[0].msg, "Id")
}

test "opaque type: where the conversion happens, and where it must not" {
  # The rule is one line (`sees_through`), but it is asked from two places --
  # `assignable` at a boundary and `unify_into` inside a call -- and it shipped
  # holding in one of them. Every position that has to convert is here, and so
  # is the one that must NOT: a type variable binds to the opaque type rather
  # than to its target, or inference forgets the type for good.
  let src =
    "pub opaque type Id = Int\n" ++
    "pub opaque type Ids = List[Id]\n" ++
    "fn wrap(n: Int) -> Id = n\n" ++
    "fn unwrap(i: Id) -> Int = i\n" ++
    "fn twice(n: Int) -> Int = n * 2\n" ++
    # argument position: the call path unifies, it does not ask `assignable`
    "fn at_arg(i: Id) -> Int = twice(i)\n" ++
    # a type variable binds: this is an Option[Id], and unwrapping it proves it
    "fn wrapped(i: Id) -> Option[Id] = Some(i)\n" ++
    "fn back(i: Id) -> Int = unwrap(wrapped(i).expect(\"x\"))\n" ++
    "fn ident[T](x: T) -> T = x\n" ++
    "fn through(i: Id) -> Id = ident(i)\n" ++
    # an expression that cannot type itself DOES take the peeled expectation
    "fn none() -> Ids = []\n" ++
    "fn one(i: Id) -> Ids = [i]\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(cx_new(Some("ids2"), None), m, env)
  if len(cx1.diags) > 0 { println("UNEXPECTED: " ++ cx1.diags[0].msg) }
  assert len(cx1.diags) == 0
}

test "check_module: an inference cycle must annotate" {
  let src = "fn a2(x: Int) = b2(x)\nfn b2(x: Int) = a2(x)\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(test_cx(), m, env)
  assert len(cx1.diags) == 2
  assert str.contains(cx1.diags[0].msg, "cannot infer the return type of `a2`")
  assert str.contains(cx1.diags[0].msg, "recursive")
}

test "check_module: impl methods and trait defaults check as bodies" {
  let src = "pub type Coin = { v: Int }\n" ++
    "trait Waxy[T] {\n  fn wax(x: T) -> Int\n  fn buff(x: T) -> Int = wax(x) + 1\n}\n" ++
    "impl Waxy[Coin] {\n  fn wax(x: Coin) -> Int = x.v * 2\n}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(test_cx(), m, env)
  assert len(cx1.diags) == 0
  # 2 bodies land: the impl's wax and the trait default buff
  assert len(tm.fns) == 2
  # an effectful body under a pure signature reports
  let bad = "fn f() -> Int = g()\nfn g() -> Int !io = 1\n"
  let (m2, _) = parser.parse_module(bad)
  let (cx2, _) = check_module(test_cx(), m2, env)
  assert len(cx2.diags) == 1
  assert cx2.diags[0].msg == "function `f` is not declared !io but calls `g` (!io)"
}

test "grouped function returns keep outer and inner effects distinct" {
  let src = "fn outer() -> (fn() -> Int) !io = panic(\"outer\")\n" ++
    "fn inner() -> fn() -> Int !io = panic(\"inner\")\n" ++
    "fn both() -> (fn() -> Int !io) !io = panic(\"both\")\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(test_cx(), m, env)
  assert len(cx1.diags) == 0

  let outer = map.get(cx1.fns, "outer").expect("outer")
  assert outer.eff == EIo
  assert outer.ret == TyFn([], TyInt, EPure)
  assert sig_render(cx1.adts, cx1.traits, outer) ==
    "fn outer() -> (fn() -> Int) !io"

  let inner = map.get(cx1.fns, "inner").expect("inner")
  assert inner.eff == EPure
  assert inner.ret == TyFn([], TyInt, EIo)
  assert sig_render(cx1.adts, cx1.traits, inner) ==
    "fn inner() -> fn() -> Int !io"

  let both = map.get(cx1.fns, "both").expect("both")
  assert both.eff == EIo
  assert both.ret == TyFn([], TyInt, EIo)
  assert sig_render(cx1.adts, cx1.traits, both) ==
    "fn both() -> (fn() -> Int !io) !io"
}

test "a local function io hint groups its returned function type" {
  let src = "fn noisy() -> Unit !io = ()\n" ++
    "fn outer() -> Unit = {\n" ++
    "  fn local() -> (fn() -> Int) = {\n" ++
    "    noisy()\n" ++
    "    () => 1\n" ++
    "  }\n" ++
    "  ()\n" ++
    "}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(test_cx(), m, env)
  assert len(cx1.diags) == 1
  assert cx1.diags[0].msg == "the body of `local` performs io"
  assert cx1.diags[0].hint ==
    "declare it: fn local(...) -> (fn() -> Int) !io = ..."
}

test "check_module: a type declaration refuses the effect names it did not bind" {
  let env: Map[String, ModExports] = map.empty()
  # record field
  let (m1, p1) = parser.parse_module("pub type Box = { f: fn(Int) -> Int !e }\n")
  assert len(p1) == 0
  let (cx1, _) = check_module(test_cx(), m1, env)
  assert len(cx1.diags) == 1
  assert cx1.diags[0].msg == "effect variable `e` has no binder here"
  assert str.starts_with(cx1.diags[0].hint, "bind it in the declaration's parameter list")
  # variant field
  let (m2, p2) = parser.parse_module("type T2 = | A(f: fn(Int) -> Int !e) | B\n")
  assert len(p2) == 0
  let (cx2, _) = check_module(test_cx(), m2, env)
  assert len(cx2.diags) == 1
  assert cx2.diags[0].msg == "effect variable `e` has no binder here"
  # alias target shares the same words
  let (m3, p3) = parser.parse_module("alias F = fn(Int) -> Int !e\n")
  assert len(p3) == 0
  let (cx3, _) = check_module(test_cx(), m3, env)
  assert len(cx3.diags) == 1
  assert cx3.diags[0].msg == "effect variable `e` has no binder here"
  # the binder is what lifts the refusal, in all three positions
  let (m5, p5) = parser.parse_module(
    "pub type Box2[!e] = { f: fn(Int) -> Int !e }\n" ++
      "type T3[!e] = | A(f: fn(Int) -> Int !e) | B\n" ++
      "alias F2[!e] = fn(Int) -> Int !e\n")
  assert len(p5) == 0
  let (cx5, _) = check_module(test_cx(), m5, env)
  assert len(cx5.diags) == 0
  # a label is not refused at all: a written label means the caller supplies
  # the handler, which is how evidence travels now. It needs no binder either
  # -- a label is not a variable, so the parameter list has nothing to say
  let (m6, p6) = parser.parse_module(
    "effect Ask { fn get() -> Int }\nalias F3[!e] = fn(Int) -> Int !Ask\n")
  assert len(p6) == 0
  let (cx6, _) = check_module(test_cx(), m6, env)
  assert len(cx6.diags) == 0
  # a concrete !io in the same positions stays legal
  let (m4, p4) = parser.parse_module(
    "pub type Cb = { f: fn(Int) -> Int !io }\nalias G = fn(Int) -> Int !io\n")
  assert len(p4) == 0
  let (cx4, _) = check_module(test_cx(), m4, env)
  assert len(cx4.diags) == 0
}

# ---- effect handlers (docs/effects-design.md) ----

fn eff_src(body: String) -> String = "effect Ask {\n  fn ask() -> Int\n}\n" ++ body

fn eff_check(body: String) -> Cx !io = {
  let (m, _) = parser.parse_module(eff_src(body))
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(test_cx(), m, env)
  cx1
}

test "an effect declaration synthesises an evidence record and an operation" {
  let (m, pdiags) = parser.parse_module(eff_src(""))
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(test_cx(), m, env)
  assert len(cx1.diags) == 0
  let eid = map.get(cx1.effects, "Ask").expect("Ask is declared")
  # the label's id IS the evidence record's ADT id: one identity, one table
  let rec = adt_of(cx1.adts, eid)
  assert rec.name == "ev\$Ask"
  assert rec.is_record
  assert rec.ctors[0].fields[0].name == "ask"
  assert rec.ctors[0].fields[0].ty == TyFn([], TyInt, EPure)
  # the operation is an ordinary name in the function namespace, and its own
  # effect is the label
  let sg = map.get(cx1.fns, "ask").expect("ask is in scope")
  assert sg.eff == ELabeled(EPure, [(eid, "Ask")])
  assert sg.op_of == Some((eid, 0))
}

test "an operation raised with nobody answering names the effect, not the row" {
  let cx = eff_check("fn f() -> Int = ask()\n")
  assert len(cx.diags) == 1
  assert cx.diags[0].msg == "`f` uses the effect `Ask`, but its signature does not declare !Ask"
  assert cx.diags[0].hint ==
    "add !Ask to the signature, or answer it here with `with handle Ask { ... }`"
  # declaring it is one of the two ways out
  let cx2 = eff_check("fn f() -> Int !Ask = ask()\n")
  assert len(cx2.diags) == 0
  # and answering it is the other
  let cx3 = eff_check("fn f() -> Int = {\n  with handle Ask { ask() => 1 }\n  ask()\n}\n")
  assert len(cx3.diags) == 0
}

test "in main the same diagnostic offers the handler alone" {
  # main may not carry a label at all (pass_main_check), so the "declare it"
  # half of the hint above would send the reader straight into a second error.
  let cx = eff_check("pub fn main() -> Unit !io = {\n  let _ = ask()\n  ()\n}\n")
  assert len(cx.diags) == 1
  assert cx.diags[0].msg == "`main` uses the effect `Ask`, but its signature does not declare !Ask"
  assert cx.diags[0].hint ==
    "nothing calls main, so nothing can answer a declared effect: handle it here with " ++
    "`with handle Ask { ... }`"
  # the one way out it names is a way out
  let cx2 = eff_check(
    "pub fn main() -> Unit !io = {\n  with handle Ask { ask() => 1 }\n  let _ = ask()\n  ()\n}\n")
  assert len(cx2.diags) == 0
}

# ---- the pack-shape oracle for `evidence_pack` ----
#
# Nothing reads an evidence pack under this knife, so a pack with the wrong
# contents computes the same answers as one with the right contents: every
# behavioural gate -- the corpus, the transcripts, both fixpoints, the RC
# contract, the sanitiser legs -- stays green while the wrong evidence is
# handed over. The shape of what the checker built is the only witness, which
# is the same argument `lower.dawn`'s two forwarding tests are written under.
#
# These pin the tree at the TAST rather than at the lowered Core because the
# rule lives here: `lower_ctor` turns an `XCtor` into a `CCtor` field for
# field, so a splice that is a splice here is a splice there.

## The evidence arguments of the single named call a test function's body is.
fn ev_args_of(f: TFun) -> List[TExpr] =
  match f.body {
    XCallFn(_, _, _, _, evs, _, _, _, _) -> evs
    _ -> []
  }

fn fn_named(tm: TModule, name: String) -> TFun = {
  for f in tm.fns {
    if f.name == name { return f }
  }
  panic("no function named " ++ name)
}

## One pack node, unwrapped: (key, evidence payload, outer).
fn pack_node(t: TExpr) -> (Int, TExpr, TExpr) =
  match t {
    XCtor(aid, ci, ws, _, _, _, _, _) -> {
      if aid != EV_PACK_ID || ci != 0 || len(ws) != 3 {
        panic("not an ev\$Pack constructor")
      }
      match ws[0] {
        XInt(k, _, _) -> (k, ws[1], ws[2])
        _ -> panic("pack key is not a literal")
      }
    }
    _ -> panic("not a pack node")
  }

fn local_sym(t: TExpr) -> Int =
  match t {
    XLocal(sid, _, _, _, _) -> sid
    _ -> panic("not a local")
  }

## One join, unwrapped: (front, back). Panics on anything else, which is what
## makes "no join here" assertable -- `local_sym` of a join is not a local.
fn append_args(t: TExpr) -> (TExpr, TExpr) =
  match t {
    XCallBuiltin(name, args, _, _, _, _, ty) -> {
      if name != "ev_append" || len(args) != 2 {
        panic("not an ev_append call")
      }
      if ty != erased_ev_ty() { panic("a join is not at the erased type") }
      (args[0], args[1])
    }
    _ -> panic("not a join")
  }

fn two_effects(body: String) -> String =
  "effect Ask {\n  fn ask() -> Int\n}\n" ++
  "effect Tell {\n  fn tell(v: Int) -> Int\n}\n" ++
  "fn thru(f: fn() -> Int !e) -> Int !e = f()\n" ++ body

fn pack_check(body: String) -> (Cx, TModule) !io = {
  let (m, pdiags) = parser.parse_module(two_effects(body))
  if len(pdiags) != 0 { panic("the fixture does not parse") }
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(test_cx(), m, env)
  if len(cx1.diags) != 0 { panic("the fixture does not check: " ++ cx1.diags[0].msg) }
  (cx1, tm)
}

test "a union instantiation conses one node per ground label over the empty pack" {
  # `!e := !(Ask|Tell)`: two written labels, no non-ground atom. The pack is
  # two nodes over the placeholder, keyed by `types.label_key` -- not one node
  # for "the union", and not a slot forwarded from a frame that has none.
  let (cx, tm) = pack_check("fn both() -> Int !Ask !Tell = thru(() => ask() + tell(1))\n")
  let both = fn_named(tm, "both")
  # the frame's own slots, in `atom_keys` order: Ask's, then Tell's
  assert len(both.ev_syms) == 2
  let ask_id = map.get(cx.effects, "Ask").expect("Ask")
  let tell_id = map.get(cx.effects, "Tell").expect("Tell")
  assert ask_id < tell_id
  let evs = ev_args_of(fn_named(tm, "both"))
  assert len(evs) == 1
  # the fold wraps in `eff_labels` order, so the last label is outermost --
  # the direction `lower.ev_build` folds `atom_keys` in
  let (k_out, ev_out, rest) = pack_node(evs[0])
  assert k_out == label_key(tell_id)
  assert local_sym(ev_out) == both.ev_syms[1]
  let (k_in, ev_in, tail) = pack_node(rest)
  assert k_in == label_key(ask_id)
  assert local_sym(ev_in) == both.ev_syms[0]
  # and the chain ends at the empty pack, which is the placeholder
  match tail {
    XUnit(_, _) -> ()
    _ -> { assert false }
  }
}

test "a mixed instantiation splices the forwarded environment as the tail" {
  # `!e := !Ask !e2`: exactly one node, and its `outer` **is** the caller's own
  # `e2` slot. Wrapping that slot as a node's payload instead would build two
  # nodes and answer no key `e2`'s own reader asks for -- a lookup miss, and
  # the reason this is a shape test rather than a count.
  let (cx, tm) = pack_check(
    "fn outer(g: fn() -> Int !e2) -> Int !Ask !e2 = thru(() => g() + ask())\n")
  let outer = fn_named(tm, "outer")
  # `outer`'s ABI row is one label and one variable: an exact slot then an
  # erased one
  assert len(outer.ev_syms) == 2
  let ask_id = map.get(cx.effects, "Ask").expect("Ask")
  let evs = ev_args_of(outer)
  assert len(evs) == 1
  let (k, ev, tail) = pack_node(evs[0])
  assert k == label_key(ask_id)
  assert local_sym(ev) == outer.ev_syms[0]
  # spliced, not wrapped: the tail is the slot itself, not a node over it
  assert local_sym(tail) == outer.ev_syms[1]
  assert tex_ty(tail) == erased_ev_ty()
}

test "a lone non-ground instantiation forwards the slot and builds no node" {
  # `!e := !e3`: no ground atom, one non-ground atom. The pack **is** that
  # slot. This is the whole of what the deleted `len(eff_vars(inst)) == 1`
  # branch used to do, and it has to survive the generalisation.
  let (_cx, tm) = pack_check("fn fwd(f: fn() -> Int !e3) -> Int !e3 = thru(f)\n")
  let fwd = fn_named(tm, "fwd")
  assert len(fwd.ev_syms) == 1
  let evs = ev_args_of(fwd)
  assert len(evs) == 1
  assert local_sym(evs[0]) == fwd.ev_syms[0]
  # a pure instantiation still has nothing to forward and nothing to cons
  let (_cx2, tm2) = pack_check("fn pure_call() -> Int = thru(() => 1)\n")
  let pc = fn_named(tm2, "pure_call")
  assert len(pc.ev_syms) == 0
  match ev_args_of(pc)[0] {
    XUnit(_, _) -> ()
    _ -> { assert false }
  }
}

test "two non-ground atoms join their environments rather than dropping one" {
  # `!e := !e1 !e2`: two environments, one `outer` field. Neither is a written
  # label to cons and neither can be spliced, so the tail is the join -- and
  # the two arguments are this frame's own slots, in row order. Fall back to
  # the placeholder here (what this fixture used to get) and the second
  # environment is silently gone: the program checks, and panics at the read.
  let (_cx, tm) = pack_check(
    "fn merge(g: fn() -> Int !e1, h: fn() -> Int !e2) -> Int !e1 !e2 =\n" ++
      "  thru(() => g() + h())\n")
  let merge = fn_named(tm, "merge")
  assert len(merge.ev_syms) == 2
  let evs = ev_args_of(merge)
  assert len(evs) == 1
  let (front, back) = append_args(evs[0])
  assert local_sym(front) == merge.ev_syms[0]
  assert local_sym(back) == merge.ev_syms[1]

  # three of them fold from the right, so each environment is rebuilt once.
  # Folded the other way this would be `ev_append(ev_append(a, b), c)` -- the
  # same answers, and the first environment rebuilt twice to get them.
  let (_cx2, tm2) = pack_check(
    "fn tri(a: fn() -> Int !e1, b: fn() -> Int !e2, c: fn() -> Int !e3) " ++
      "-> Int !e1 !e2 !e3 =\n  thru(() => a() + b() + c())\n")
  let tri = fn_named(tm2, "tri")
  assert len(tri.ev_syms) == 3
  let (a_env, rest) = append_args(ev_args_of(tri)[0])
  assert local_sym(a_env) == tri.ev_syms[0]
  let (b_env, c_env) = append_args(rest)
  assert local_sym(b_env) == tri.ev_syms[1]
  assert local_sym(c_env) == tri.ev_syms[2]
}

test "a ground label is consed over a joined tail, not folded into it" {
  # `!e := !Ask !e1 !e2`. The two rules compose in one direction only: the
  # label is a node, the join is what the node's `outer` is. A label folded
  # into the join instead would need the join to take a key, and a join that
  # took a key would be a cons.
  let (cx, tm) = pack_check(
    "fn over(g: fn() -> Int !e1, h: fn() -> Int !e2) -> Int !Ask !e1 !e2 =\n" ++
      "  thru(() => g() + h() + ask())\n")
  let over = fn_named(tm, "over")
  # the frame's slots: Ask's exact one, then the two erased ones
  assert len(over.ev_syms) == 3
  let ask_id = map.get(cx.effects, "Ask").expect("Ask")
  let (k, ev, tail) = pack_node(ev_args_of(over)[0])
  assert k == label_key(ask_id)
  assert local_sym(ev) == over.ev_syms[0]
  let (front, back) = append_args(tail)
  assert local_sym(front) == over.ev_syms[1]
  assert local_sym(back) == over.ev_syms[2]
}

test "one non-ground atom is forwarded, and is not joined with nothing" {
  # The identity case, asserted against the join rather than against the cons:
  # routing it through `ev_append` for uniformity would rebuild the chain to
  # answer exactly what it already answered, once per call, in every
  # effect-polymorphic signature std has. `local_sym` is the assertion -- a
  # join is not a local, so it panics rather than passing.
  let (_cx, tm) = pack_check("fn lone(f: fn() -> Int !e3) -> Int !e3 = thru(f)\n")
  let lone = fn_named(tm, "lone")
  assert local_sym(ev_args_of(lone)[0]) == lone.ev_syms[0]
  # and a lone label over nothing is still one node over the placeholder, with
  # no join underneath it
  let (_cx2, tm2) = pack_check("fn lbl() -> Int !Ask = thru(() => ask())\n")
  let (_k, _ev, tail) = pack_node(ev_args_of(fn_named(tm2, "lbl"))[0])
  match tail {
    XUnit(_, _) -> ()
    _ -> { assert false }
  }
}

test "a declared effect is served by a hidden evidence parameter" {
  let (m, pdiags) = parser.parse_module(eff_src("fn f() -> Int !Ask = ask()\n"))
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, tm) = check_module(test_cx(), m, env)
  assert len(cx1.diags) == 0
  let f = tm.fns[0]
  assert f.name == "f"
  # one label, so one evidence symbol -- behind the (empty) dictionary list
  assert len(f.dict_syms) == 0
  assert len(f.ev_syms) == 1
  let eid = map.get(cx1.effects, "Ask").expect("Ask")
  assert sym_of(cx1, f.ev_syms[0]).ty == TyAdt(eid, [])
}

test "io does not absorb a label, and a label does not absorb io" {
  let eid = 77
  let ask = ELabeled(EPure, [(eid, "Ask")])
  # the base axis keeps its atoms: io swallows no effect variable either
  assert eff_union([EIo, EffVar("e", 1)]) == EUnion([(1, "e")], [], true)
  # labels never merge into io, in either direction
  assert eff_union([EIo, ask]) == ELabeled(EIo, [(eid, "Ask")])
  assert not eff_subsumes(EIo, ask)
  assert eff_subsumes(ELabeled(EIo, [(eid, "Ask")]), ask)
  assert eff_subsumes(ask, ask)
  # and an empty label set is not representable: the normal form is the base
  assert eff_with_labels(EIo, []) == EIo
  assert eff_show(ELabeled(EIo, [(eid, "Ask")])) == "(Ask|io)"
}

test "the row loses E at the handle node, and only there" {
  # the block after the handler is charged with everything but Ask
  let cx = eff_check("fn g() -> Int !Ask = ask()\n" ++
      "fn f() -> Int = {\n  with handle Ask { ask() => 1 }\n  g()\n}\n")
  assert len(cx.diags) == 0
  # what the arm itself does is charged to the block that installs it: `f` is
  # pure, the arm is not, and the arm is where the report lands
  let cx2 = eff_check("fn noisy() -> Int !io = 1\n" ++
      "fn f() -> Int = {\n  with handle Ask { ask() => noisy() }\n  1\n}\n")
  assert len(cx2.diags) == 1
  assert cx2.diags[0].msg == "function `f` is not declared !io but calls `ask` (!io)"
}

test "an arm raising its own effect reaches the outer handler" {
  # no outer handler: the arm owes the label like any other body. It is the
  # signature that reports rather than the raise, because the raise is inside
  # a closure -- the arm -- and a closure carries its label out to whoever
  # runs it. `f` installs the handler, so `f` is who runs it.
  let cx = eff_check("fn f() -> Int = {\n" ++
      "  with handle Ask { ask() => ask() + 1 }\n  2\n}\n")
  assert len(cx.diags) == 1
  assert cx.diags[0].msg == "function `f` is not declared !Ask but calls `ask` (!Ask)"
  # with one, the arm binds to it
  let cx2 = eff_check("fn f() -> Int = {\n" ++
      "  with handle Ask { ask() => 1 }\n" ++
      "  with handle Ask { ask() => ask() + 1 }\n  ask()\n}\n")
  assert len(cx2.diags) == 0
}

test "a handler answers every operation its effect declares, and only those" {
  let two = "effect St {\n  fn get() -> Int\n  fn put(v: Int) -> Unit\n}\n"
  let env: Map[String, ModExports] = map.empty()
  let missing = two ++ "fn f() -> Int = {\n  with handle St { get() => 1 }\n  2\n}\n"
  let (m1, p1) = parser.parse_module(missing)
  assert len(p1) == 0
  let (cx1, _) = check_module(test_cx(), m1, env)
  assert len(cx1.diags) == 1
  assert cx1.diags[0].msg == "handler for `St` does not answer `put`"
  # an arm that is not of the effect, and one written twice
  let stray = two ++ "fn f() -> Int = {\n" ++
    "  with handle St {\n    get() => 1\n    put(v) => ()\n    nope() => 1\n  }\n  2\n}\n"
  let (m2, p2) = parser.parse_module(stray)
  assert len(p2) == 0
  let (cx2, _) = check_module(test_cx(), m2, env)
  assert cx2.diags[0].msg == "`nope` is not an operation of effect `St`"
  let twice = two ++ "fn f() -> Int = {\n" ++
    "  with handle St {\n    get() => 1\n    put(v) => ()\n    get() => 2\n  }\n  2\n}\n"
  let (m3, p3) = parser.parse_module(twice)
  assert len(p3) == 0
  let (cx3, _) = check_module(test_cx(), m3, env)
  assert cx3.diags[0].msg == "operation `get` is answered twice"
}

test "an arm answers with the operation's own signature" {
  let cx = eff_check("fn f() -> Int = {\n  with handle Ask { ask() => \"no\" }\n  1\n}\n")
  assert len(cx.diags) == 1
  assert cx.diags[0].msg == "arm `ask` returns String but operation `ask` declares Int"
  let cx2 = eff_check("fn f() -> Int = {\n  with handle Ask { ask(x) => x }\n  1\n}\n")
  assert str.contains(cx2.diags[0].msg, "arm `ask` takes 1 parameter(s)")
}

test "the two standing refusals: comptime and type declaration; trait rows carry labels" {
  let env: Map[String, ModExports] = map.empty()
  let base = "effect Ask {\n  fn ask() -> Int\n}\n"
  # a trait method's row may write a label now (effect-params-design.md 刀 5):
  # the label is one hidden evidence parameter, on the slot as on a fn
  let (m1, _) = parser.parse_module(base ++ "trait W[T] {\n  fn w(x: T) -> Int !Ask\n}\n")
  let (cx1, _) = check_module(test_cx(), m1, env)
  assert len(cx1.diags) == 0
  # an impl method's labels are held to the trait's row by the conformance
  # check -- a label the trait does not carry is refused there, in the row
  # comparison's own words, not by a blanket ban
  let (m2, _) = parser.parse_module(base ++
      "trait W[T] {\n  fn w(x: T) -> Int\n}\n" ++
      "type P = { v: Int }\n" ++
      "impl W[P] {\n  fn w(x: P) -> Int !Ask = 1\n}\n")
  let (cx2, _) = check_module(test_cx(), m2, env)
  var saw_impl = false
  for d in cx2.diags {
    if d.msg == "`w` is declared !Ask but trait `W` declares it pure" { saw_impl = true }
  }
  assert saw_impl
  # comptime is pure in v1, handlers included
  let (m3, _) = parser.parse_module(base ++ "const K: Int = comptime { ask() }\n")
  let (cx3, _) = check_module(test_cx(), m3, env)
  var saw_ct = false
  for d in cx3.diags {
    if str.contains(d.msg, "must be pure, but `ask` is !Ask") { saw_ct = true }
  }
  assert saw_ct
  # A type declaration takes a label now: `fn() -> Int !Ask` in a field means
  # whoever calls `f` supplies the handler, which is what evidence does. The
  # parameter list is beside the point either way -- a label is not a variable
  # and never needed a binder.
  let (m4, _) = parser.parse_module(base ++ "type Box[!e] = { f: fn() -> Int !Ask }\n")
  let (cx4, _) = check_module(test_cx(), m4, env)
  assert len(cx4.diags) == 0
  # ... and in a signature the label is accepted too. What it costs is that the
  # call through the value now owes the evidence, at the call, by name
  let (m5, _) = parser.parse_module(base ++ "fn sink(f: fn() -> Int !Ask) -> Int = f()\n")
  let (cx5, _) = check_module(test_cx(), m5, env)
  assert len(cx5.diags) == 1
  assert cx5.diags[0].msg ==
    "`sink` uses the effect `Ask`, but its signature does not declare !Ask"
  assert str.contains(cx5.diags[0].hint, "with handle Ask")
  # an effect variable in the same position is what the hint asks for, and it
  # is accepted: the ban is on the spelling that has no meaning, not on taking
  # a closure that raises
  let (m6, _) = parser.parse_module(base ++ "fn sink(f: fn() -> Int !e) -> Int !e = f()\n")
  let (cx6, _) = check_module(test_cx(), m6, env)
  assert len(cx6.diags) == 0
}

test "a trait or impl method's row may carry effect variables" {
  let env: Map[String, ModExports] = map.empty()
  # the shape #208 asks for: the closure's effect is the *caller's*, so the
  # trait method forwards a variable it neither picks nor settles
  let tr = "trait Container[C] {\n" ++
    "  fn wrap(c: C, body: fn() -> Int !e) -> Int !e\n}\n" ++
    "type P = { v: Int }\n"
  let check = (src: String) => {
    let (m, ps) = parser.parse_module(src)
    assert len(ps) == 0
    let (cx, _) = check_module(test_cx(), m, env)
    cx
  }
  # an impl that forwards the variable satisfies the row exactly
  assert len(check(tr ++
      "impl Container[P] {\n" ++
      "  fn wrap(c: P, body: fn() -> Int !e) -> Int !e = body()\n}\n").diags) == 0
  # so does a pure one: pure is the bottom of the base axis, and an impl that
  # does less than the row admits to is not a lie about the row
  assert len(check(tr ++
      "impl Container[P] {\n  fn wrap(c: P, body: fn() -> Int !e) -> Int = c.v\n}\n").diags) == 0
  # names do not have to agree -- the two sides' variables are paired by
  # position (mint order), not by spelling
  assert len(check(tr ++
      "impl Container[P] {\n" ++
      "  fn wrap(c: P, body: fn() -> Int !zz) -> Int !zz = body()\n}\n").diags) == 0
  # `!io` does not: the row promises "whatever the caller's closure does", and
  # an unconditionally effectful impl does more than that
  let cio = check(tr ++
      "impl Container[P] {\n" ++
      "  fn wrap(c: P, body: fn() -> Int !e) -> Int !io = body()\n}\n")
  assert len(cio.diags) == 1
  assert cio.diags[0].msg == "`wrap` is declared !io but trait `Container` declares it !e"
  # a permutation of the positions is not a renaming: the impl's row takes the
  # trait's *second* variable, so the pairing puts the first one on `body` and
  # the parameter types stop matching
  let cperm = check("trait Two[C] {\n" ++
      "  fn f(c: C, g: fn() -> Int !a, h: fn() -> Int !b) -> Int !a\n}\n" ++
      "type P = { v: Int }\n" ++
      "impl Two[P] {\n" ++
      "  fn f(c: P, g: fn() -> Int !a, h: fn() -> Int !b) -> Int !b = h()\n}\n")
  assert len(cperm.diags) == 1
  assert cperm.diags[0].msg == "`f` does not match the trait's signature"
  assert cperm.diags[0].hint ==
    "trait `Two` declares it as fn f(P, fn() -> Int !b, fn() -> Int !a) -> Int !b"
  # a variable the impl does not bind at all is an arity mismatch, reported
  # with both signatures
  let carity = check("trait One[C] {\n  fn f(c: C) -> Int !e\n}\n" ++
      "type P = { v: Int }\n" ++
      "impl One[P] {\n  fn f(c: P) -> Int = c.v\n}\n")
  assert len(carity.diags) == 1
  assert carity.diags[0].msg == "`f` binds 0 effect variable(s) but trait `One` binds 1"
  assert str.contains(carity.diags[0].hint, "this impl declares fn f(P) -> Int")
  # a named label is accepted on both sides now (effect-params-design.md 刀 5),
  # and the impl must *write* it: each label is one hidden evidence parameter,
  # so dropping one would change the method's arity, not just its promise
  let base5 = "effect Ask {\n  fn ask() -> Int\n}\n" ++
    "trait W[T] {\n  fn w(x: T) -> Int !Ask\n}\n" ++
    "type P = { v: Int }\n"
  assert len(check(base5 ++
      "impl W[P] {\n  fn w(x: P) -> Int !Ask = x.v + ask()\n}\n").diags) == 0
  let cdrop = check(base5 ++ "impl W[P] {\n  fn w(x: P) -> Int = x.v\n}\n")
  assert len(cdrop.diags) == 1
  assert cdrop.diags[0].msg ==
    "`w` must write the effect(s) `Ask`: the trait's row (after this impl's bindings) carries them"
}

test "a trait default body forwards the method's effect variable" {
  let env: Map[String, ModExports] = map.empty()
  let src = (row: String) => "trait Container[C] {\n" ++
    "  fn wrap(c: C, body: fn() -> Int !e) -> Int !e = body()\n" ++
    "  fn twice(c: C, body: fn() -> Int !e) -> Int" ++ row ++
    " = wrap(c, body) + wrap(c, body)\n}\n" ++
    "type P = { v: Int }\nimpl Container[P] { }\n"
  # the default body is checked like any other annotated function: it may call
  # through the variable, which is all a rigid effect can do (nothing installs
  # a handler for a row it cannot name)
  let (m1, p1) = parser.parse_module(src(" !e"))
  assert len(p1) == 0
  let (cx1, _) = check_module(test_cx(), m1, env)
  assert len(cx1.diags) == 0
  # and it is held to its own row: a pure default cannot forward one
  let (m2, p2) = parser.parse_module(src(""))
  assert len(p2) == 0
  let (cx2, _) = check_module(test_cx(), m2, env)
  assert len(cx2.diags) == 1
  assert str.contains(cx2.diags[0].msg, "`twice`")
}

test "an operation cannot be a value, and unsafe_pure cannot mask a label" {
  # not for its row -- a labelled *function* is an ordinary function value now
  # -- but because `ask` names no function at all: an operation call is a field
  # read off a handler's record plus a closure call, so there is nothing for a
  # wrapper to call
  let cx = eff_check("fn f() -> Int !Ask = {\n  let g = ask\n  g()\n}\n")
  assert cx.diags[0].msg == "effect operation `ask` cannot be used as a value"
  assert str.contains(cx.diags[0].hint, "wrap it in a lambda")
  # unsafe_pure vouches that io is absent; evidence is not something it can vouch for
  let (m2, p2) = parser.parse_module(eff_src("fn f() -> Int = unsafe_pure { ask() }\n"))
  assert len(p2) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx2, _) = check_module(cx_new(Some("std/x"), None), m2, env)
  var saw = false
  for d in cx2.diags {
    if str.contains(d.msg, "uses the effect `Ask`") { saw = true }
  }
  assert saw
}

test "a jump out of a handler arm names `with handle`, not a lambda" {
  let cx = eff_check("fn f() -> Int = {\n  with handle Ask { ask() => return 4 }\n  ask()\n}\n")
  assert len(cx.diags) == 1
  assert cx.diags[0].msg == with_cross_msg_cx(arm_cx(), "return")
  assert str.contains(cx.diags[0].msg, "with handle")
  # the remainder closure keeps the words `with` had before handlers existed
  let cx2 = eff_check("fn f() -> Int = {\n" ++
      "  with handle Ask { ask() => 1 }\n  return ask()\n}\n")
  assert cx2.diags[0].msg == with_cross_msg("return")
}

## A context standing inside a handler arm, for the message helpers to answer.
fn arm_cx() -> Cx =
  {
    let cx = cx_new(None, None)
    Cx {
      ..cx,
      frame: Frame {
        ..cx.frame,
        lambda_stack: [LambdaCx {
          boundary: 0,
          expected_ret: None,
          captures: [],
          sugar: true,
          arm: true
        }]
      }
    }
  }

test "a capture refused inside a handler arm names the arm, not a lambda" {
  # writing an enclosing `var` from an arm is the collecting-handler shape that
  # dogfood measured (docs/effects-design.md §7.1); the refusal stands, but it
  # has to name the arm the author wrote
  let cx = eff_check("fn f() -> Int = {\n  var n = 0\n" ++
      "  with handle Ask {\n    ask() => {\n      n = 1\n      2\n    }\n  }\n  ask()\n}\n")
  assert len(cx.diags) == 1
  assert cx.diags[0].msg == "cannot assign to `n` from inside a `with handle` arm"
  assert str.contains(cx.diags[0].hint, "the operation's result")
  # reading one is refused in the arm's words too
  let cx2 = eff_check("fn f() -> Int = {\n  var n = 0\n" ++
      "  with handle Ask { ask() => n + 1 }\n  ask()\n}\n")
  assert len(cx2.diags) == 1
  assert cx2.diags[0].msg ==
    "a `with handle` arm cannot capture `var` bindings (capture is by value)"
  assert str.contains(cx2.diags[0].hint, "before the handler")
  # a lambda the author *did* write, inside an arm, keeps the old message: the
  # frame that the name crosses is the one that gets named
  let cx3 = eff_check("fn ap(f: fn(Int) -> Int) -> Int = f(1)\n" ++
      "fn f() -> Int = {\n" ++
      "  with handle Ask {\n    ask() => {\n      var k = 0\n" ++
      "      ap((j: Int) => j + k)\n    }\n  }\n  ask()\n}\n")
  assert len(cx3.diags) == 1
  assert cx3.diags[0].msg == "lambdas cannot capture `var` bindings (capture is by value)"
  # an arm's arity is the handler's to report, and it says so once
  let cx4 = eff_check("fn f() -> Int = {\n  with handle Ask { ask(x) => 1 }\n  ask()\n}\n")
  var said_lambda = false
  for d in cx4.diags {
    if str.contains(d.msg, "this lambda takes") { said_lambda = true }
  }
  assert not said_lambda
  assert str.contains(cx4.diags[0].msg, "arm `ask` takes 1 parameter(s)")
}

test "a parameter declared !io does not accept a labelled closure" {
  # io is the top of the base axis only: nothing at the call site could supply
  # the evidence the closure would need
  let cx = eff_check("fn run(f: fn() -> Int !io) -> Int !io = f()\n" ++
      "fn f() -> Int !Ask !io = run(() => ask())\n")
  var saw = false
  for d in cx.diags {
    if str.contains(d.msg, "argument type mismatch") { saw = true }
  }
  assert saw
  # an effect variable does accept it -- that is what carries a labelled
  # closure through list.map
  let cx2 = eff_check("fn run(f: fn() -> Int !e) -> Int !e = f()\n" ++
      "fn f() -> Int !Ask = run(() => ask())\n")
  assert len(cx2.diags) == 0
}

test "a labelled closure does not escape through a let, a return or an assignment" {
  # The same refusal as the argument position above, at the other door. These
  # go through `assignable`, which used to accept anything at all when the
  # target said !io -- so a closure that could not be *passed* to an `!io`
  # parameter could still be bound, returned or stored as one, and from there
  # called with nothing to supply its evidence.
  let cx = eff_check("fn f() -> Int !Ask = {\n" ++
      "  let g: fn() -> Int !io = () => ask()\n" ++
      "  g()\n}\n")
  var saw_let = false
  for d in cx.diags {
    if str.contains(d.msg, "annotated type is") { saw_let = true }
  }
  assert saw_let

  let cx2 = eff_check("alias IoFn = fn() -> Int !io\n" ++
      "fn f() -> IoFn !Ask = () => ask()\n")
  var saw_ret = false
  for d in cx2.diags {
    if str.contains(d.msg, "declares return type fn() -> Int !io") { saw_ret = true }
  }
  assert saw_ret

  let cx3 = eff_check("fn f() -> Int !Ask = {\n" ++
      "  var g: fn() -> Int !io = () => 1\n" ++
      "  g = () => ask()\n" ++
      "  g()\n}\n")
  var saw_assign = false
  for d in cx3.diags {
    if str.contains(d.msg, "cannot assign fn() -> Int !Ask") { saw_assign = true }
  }
  assert saw_assign

  # and the pure-into-io direction is untouched: that is what the io arm is for
  let cx4 = eff_check("fn f() -> Int !io = {\n" ++
      "  let g: fn() -> Int !io = () => 1\n" ++
      "  g()\n}\n")
  assert len(cx4.diags) == 0
}

test "a declared effect crosses a module boundary with its operations" {
  let src = "pub effect Ask {\n  fn ask() -> Int\n}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env0: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(cx_new(Some("eff"), None), m, env0)
  assert len(cx1.diags) == 0
  let exp = exports_of(cx1, m, "eff", "eff")
  assert map.has(exp.effects, "Ask")
  assert map.has(exp.fns, "ask")
  # the importer says `!Ask` and `with handle Ask` with the same words
  let src2 = "use eff.{Ask}\n" ++
    "fn f() -> Int !Ask = ask()\n" ++
    "pub fn g() -> Int = {\n  with handle Ask { ask() => 3 }\n  f()\n}\n"
  let (m2, p2) = parser.parse_module(src2)
  assert len(p2) == 0
  let env = map.from([("eff", exp)])
  let (cx2, _) = check_module(cx_new(Some("use_site"), None), m2, env)
  assert len(cx2.diags) == 0
}

## The pub surface of a checked module for importers (the Kotlin exportsOf).
## The whole ADT/trait tables ride along — extra entries graft harmlessly.
pub fn exports_of(cx: Cx, m: Module, mod_path: String, class_name: String) -> ModExports = {
  var fns2: Map[String, Sig] = map.empty()
  var types2: Map[String, Int] = map.empty()
  var aliases2: Map[String, AliasE] = map.empty()
  var ares2: Map[String, Ty] = map.empty()
  var ctors2: Map[String, (Int, Int)] = map.empty()
  var consts2: Map[String, Ty] = map.empty()
  var traits2: Map[String, Int] = map.empty()
  var effects2: Map[String, Int] = map.empty()
  var all: List[String] = []
  for d in module_fns(m) {
    all = all ++ [d.name]
    if d.is_pub {
      match map.get(cx.fns, d.name) {
        Some(s) -> { fns2 = map.insert(fns2, d.name, s) }
        None -> ()
      }
    }
  }
  for d in module_types(m) {
    all = all ++ [d.name]
    if d.is_pub {
      match map.get(cx.adts_by_name, d.name) {
        Some(aid) -> {
          types2 = map.insert(types2, d.name, aid)
          # a pub type brings its constructors (spec §10.3)
          var ci = 0
          for c in adt_of(cx.adts, aid).ctors {
            ctors2 = map.insert(ctors2, c.name, (aid, ci))
            ci = ci + 1
          }
        }
        None -> ()
      }
      match map.get(cx.aliases, d.name) {
        Some(al) -> {
          aliases2 = map.insert(aliases2, d.name, al)
          match map.get(cx.alias_resolved, d.name) {
            Some(t) -> { ares2 = map.insert(ares2, d.name, t) }
            None -> ()
          }
        }
        None -> ()
      }
    }
  }
  for d in module_consts(m) {
    all = all ++ [d.name]
    if d.is_pub {
      match map.get(cx.consts, d.name) {
        Some(t) -> { consts2 = map.insert(consts2, d.name, t) }
        None -> ()
      }
    }
  }
  for d in module_effects(m) {
    all = all ++ [d.name]
    for op in d.ops { all = all ++ [op.name] }
    if d.is_pub {
      match map.get(cx.effects, d.name) {
        Some(eid) -> {
          effects2 = map.insert(effects2, d.name, eid)
          # a pub effect brings its operations, the way a pub trait brings its
          # methods: they are the only way to raise it
          for op in effect_of(cx, eid).ops {
            match map.get(cx.fns, op) {
              Some(sg) -> { fns2 = map.insert(fns2, op, sg) }
              None -> ()
            }
          }
        }
        None -> ()
      }
    }
  }
  for d in module_traits(m) {
    all = all ++ [d.name]
    for me in d.methods { all = all ++ [me.name] }
    if d.is_pub {
      match map.get(cx.traits_by_name, d.name) {
        Some(tid) -> {
          traits2 = map.insert(traits2, d.name, tid)
          let ti = trait_of(cx.traits, tid)
          # a pub trait's methods are importable like pub fns -- unless the
          # trait does not put them in a function namespace to begin with
          if ti.injects {
            for entry in ti.methods {
              let (mname, ms) = entry
              fns2 = map.insert(fns2, mname, ms.sig)
            }
          }
        }
        None -> ()
      }
    }
  }
  ModExports {
    mod_path: mod_path,
    class_name: class_name,
    fns: fns2,
    types_by_name: types2,
    aliases: aliases2,
    alias_resolved: ares2,
    ctors: ctors2,
    consts: consts2,
    all_names: all,
    src_path: cx.src_path,
    traits_by_name: traits2,
    effects: effects2,
    effect_infos: cx.effect_infos,
    impls: cx.local_impls,
    adt_infos: cx.adts,
    trait_infos: cx.traits
  }
}

test "exports_of exposes the pub surface, and imports consume it" {
  let src = "pub type Pt = { x: Int, y: Int }\n" ++
    "pub fn mk(x: Int, y: Int) -> Pt = Pt { x: x, y: y }\n" ++
    "fn hidden() -> Int = 1\n" ++
    "pub const ORIGIN_X: Int = 0\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env0: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(cx_new(Some("geom"), None), m, env0)
  assert len(cx1.diags) == 0
  let exp = exports_of(cx1, m, "geom", "geom")
  assert map.has(exp.fns, "mk")
  assert not map.has(exp.fns, "hidden")
  assert map.has(exp.types_by_name, "Pt")
  assert map.has(exp.ctors, "Pt")
  assert map.has(exp.consts, "ORIGIN_X")
  # a second module imports it, whole-module and selectively
  let src2 = "use geom\n" ++
    "pub fn go() -> Int = geom.mk(1, 2).x\n"
  let (m2, pdiags2) = parser.parse_module(src2)
  assert len(pdiags2) == 0
  let env = map.from([("geom", exp)])
  let (cx2, _) = check_module(cx_new(Some("use_site"), None), m2, env)
  assert len(cx2.diags) == 0
  # a private name reports as private
  let src3 = "use geom\n" ++
    "pub fn go() -> Int = geom.hidden()\n"
  let (m3, _) = parser.parse_module(src3)
  let (cx3, _) = check_module(cx_new(Some("use_site"), None), m3, env)
  assert cx3.diags[0].msg == "`hidden` is private to module `geom`"
}

## Two modules, each exporting an effect whose single operation is `ask` (test
## helper for the import-collision tests below).
fn two_ask_effects() -> Map[String, ModExports] !io = {
  let (ma, pda) = parser.parse_module("pub effect A { fn ask() -> Int }\n")
  let (mb, pdb) = parser.parse_module("pub effect B { fn ask() -> Int }\n")
  let env0: Map[String, ModExports] = map.empty()
  let (cxa, _) = check_module(cx_new(Some("a"), None), ma, env0)
  # the id counter runs across modules the way the driver runs it (analyze.dawn),
  # or the two effects mint the same id and the grafted tables collide
  let (cxb, _) = check_module(Cx { ..cx_new(Some("b"), None), next_id: cxa.next_id }, mb, env0)
  if len(pda) + len(pdb) + len(cxa.diags) + len(cxb.diags) > 0 {
    panic("two_ask_effects: the fixture modules should check clean")
  }
  map.from([("a", exports_of(cxa, ma, "a", "a")), ("b", exports_of(cxb, mb, "b", "b"))])
}

test "an operation imported from two effects is refused, whichever `use` is first" {
  # The operation name is never spelled in either `use` list, so it used to
  # miss `imported_names` entirely: the second import silently overwrote the
  # first and the program's meaning was decided by line order, with no
  # diagnostic either way (docs/prelude-namespace-design.md §3.4, measurement 3).
  let env = two_ask_effects()
  let (m_ab, _) = parser.parse_module("use a.{A}\nuse b.{B}\n")
  let (cx_ab, _) = check_module(cx_new(Some("m"), None), m_ab, env)
  assert len(cx_ab.diags) == 1
  assert cx_ab.diags[0].msg == "`ask` is imported more than once (from `a` and `b`)"
  assert str.contains(cx_ab.diags[0].hint, "an operation of both `A` and `B`")
  # the mirror image says the same thing, with the two modules the other way up
  let (m_ba, _) = parser.parse_module("use b.{B}\nuse a.{A}\n")
  let (cx_ba, _) = check_module(cx_new(Some("m"), None), m_ba, env)
  assert len(cx_ba.diags) == 1
  assert cx_ba.diags[0].msg == "`ask` is imported more than once (from `b` and `a`)"
  assert str.contains(cx_ba.diags[0].hint, "an operation of both `B` and `A`")
  # naming the operation beside its own effect is redundant, not a second
  # import: the name and the module it came from are both the same
  let (m_same, _) = parser.parse_module("use a.{A, ask}\n")
  let (cx_same, _) = check_module(cx_new(Some("m"), None), m_same, env)
  assert len(cx_same.diags) == 0
}

test "a local declaration collides with an imported operation as an import" {
  # This said "function `ask` is defined twice" about a file that defines it
  # once (design §3.4, measurement 4): the operation sat in `fns` without being
  # in `imported_names`, so the least fitting of the three wordings won.
  let env = two_ask_effects()
  let (m, _) = parser.parse_module("use a.{A}\nfn ask() -> Int = 9\n")
  let (cx, _) = check_module(cx_new(Some("m"), None), m, env)
  assert len(cx.diags) == 1
  assert cx.diags[0].msg == "function `ask` conflicts with a name imported from `a`"
}

## Every method name the prelude traits put in the function namespace, derived
## from the trait table rather than transcribed -- a trait added to the prelude
## extends the shadowing tests below without anyone remembering to.
fn prelude_method_names() -> List[String] = {
  let ts = prelude_traits()
  var out: List[String] = []
  for tid in prelude_trait_ids() {
    let tr = trait_of(ts, tid)
    if tr.injects {
      for entry in tr.methods {
        let (n, _) = entry
        out = out ++ [n]
      }
    }
  }
  out
}

test "a local declaration shadows a prelude trait method rather than colliding" {
  # This used to be a declaration-time error, and the error cascaded: `cx.fns`
  # still held the prelude signature, so the body was checked against the wrong
  # arity. `fn iter_next(x: Int) -> Int` measured three diagnostics for one
  # mistake that was not one (docs/prelude-namespace-design.md §3.4,
  # measurement 1). Adding a name to the prelude may not break a program that
  # checks today; shadowing is how that promise is kept.
  let env: Map[String, ModExports] = map.empty()
  assert len(prelude_method_names()) == 8
  for n in prelude_method_names() {
    # arity 1, where every prelude method of that name takes two or more
    let src = "fn " ++ n ++ "(x: Int) -> Int = x + 1\n" ++
      "pub fn f() -> Int = " ++ n ++ "(41)\n"
    let (m, pdiags) = parser.parse_module(src)
    assert len(pdiags) == 0
    let (cx, tm) = check_module(seed_prelude(test_cx()), m, env)
    assert len(cx.diags) == 0
    # the name now answers to the local function, not to the trait method
    let s = map.get(cx.fns, n).expect("the local declaration is bound")
    assert s.trait_id == None
    assert len(s.param_tys) == 1
    # and the call site went to it: no trait id means no dictionary dispatch
    for tf in tm.fns {
      if tf.name == "f" {
        match tf.body {
          XCallFn(_, cn, _, _, _, tid, _, _, _) -> {
            assert cn == n
            assert tid == None
          }
          _ -> panic("the body of `f` should be a direct call")
        }
      }
    }
  }
}

test "shadowing the prelude method names does not reach the operators or the sugar" {
  # Design §4.4 argument 2, mechanised: every prelude trait is consumed by an
  # operator or a piece of sugar that finds its impl by trait id, never through
  # the function namespace. So a module may take all eight names for itself and
  # still have `==`, `${...}`, `for..in` and its own impls behave exactly as
  # before -- what it gives up is the ability to spell those methods, and only
  # inside this module (argument 1).
  #
  # `for..in` is the one consumer missing here: `Iter` has no impl the compiler
  # supplies, so a checker fixture without std cannot iterate anything. It is
  # covered end to end, on both backends, by
  # scripts/spike-native/shadow_prelude.dawn.
  var shadows = ""
  for n in prelude_method_names() {
    shadows = shadows ++ "fn " ++ n ++ "(x: Int) -> Int = x + 1\n"
  }
  let src = shadows ++
    "type P = { x: Int }\n" ++
    "impl Show[P] {\n  fn show(p: P) -> String = \"P!\"\n}\n" ++
    "impl Eq[P] {\n  fn eq(a: P, b: P) -> Bool = a.x == b.x\n}\n" ++
    "impl Hash[P] {\n  fn hash(p: P) -> Int = p.x\n}\n" ++
    "fn f(a: P, b: P) -> Bool = a == b\n" ++
    "fn render(p: P) -> String = \"\${p}\" ++ to_string(p)\n" ++
    "fn local(x: Int) -> Int = show(x)\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx, _) = check_module(seed_prelude(test_cx()), m, env)
  assert len(cx.diags) == 0
  # argument 3: the impls declare and are found, with `show` pointing elsewhere
  let ptv = map.get(cx.adts_by_name, "P").expect("P")
  assert has_impl_at(cx.impl_table, SHOW_ID, TyAdt(ptv, []))
  assert has_impl_at(cx.impl_table, EQ_ID, TyAdt(ptv, []))
  # `==` still asks the solver and still gets the Eq impl, name or no name
  assert eq_wit_of(src) == Some(WConcrete(EQ_ID, TyAdt(ptv, [])))
  # while the bare name is the local function: one parameter, no trait
  let s = map.get(cx.fns, "show").expect("show is bound")
  assert s.trait_id == None
  assert len(s.param_tys) == 1
}

## Every XConstRef owner inside an expression, left to right (test helper).
fn const_owners(e: TExpr, out: List[String]) -> List[String] =
  match e {
    XConstRef(owner, _, _, _, _) -> out ++ [owner]
    XBinary(_, l, r, ..) -> const_owners(r, const_owners(l, out))
    _ -> out
  }

test "a module-qualified type resolves through the alias (LANG-06)" {
  let src = "pub type Pt = { x: Int, y: Int }\n" ++
    "pub type Box[T] = | One(v: T)\n" ++
    "pub alias Idx = Int\n" ++
    "type Secret = { s: Int }\n" ++
    "pub const ORIGIN_X: Int = 0\n" ++
    "pub fn mk(x: Int, y: Int) -> Pt = Pt { x: x, y: y }\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env0: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(cx_new(Some("geom"), None), m, env0)
  assert len(cx1.diags) == 0
  let env = map.from([("geom", exports_of(cx1, m, "geom", "geom"))])
  # annotation, generic argument, alias, and a local fn signature all take g.T
  let src2 = "use geom as g\n" ++
    "pub fn go(p: g.Pt) -> Int = p.x\n" ++
    "pub fn boxed(b: g.Box[Int]) -> g.Box[Int] = b\n" ++
    "pub fn take(i: g.Idx) -> Int = i\n" ++
    "pub fn deep(xs: List[g.Pt]) -> Int = len(xs)\n"
  let (m2, pdiags2) = parser.parse_module(src2)
  assert len(pdiags2) == 0
  let (cx2, _) = check_module(cx_new(Some("use_site"), None), m2, env)
  assert len(cx2.diags) == 0
  # a type the module does not export is an error that names the module
  let src3 = "use geom as g\n" ++
    "pub fn go(p: g.Secret) -> Int = 1\n"
  let (m3, _) = parser.parse_module(src3)
  let (cx3, _) = check_module(cx_new(Some("use_site"), None), m3, env)
  assert len(cx3.diags) > 0
  assert str.contains(cx3.diags[0].msg, "has no exported type `Secret`")
  # a dangling alias is named too
  let src4 = "pub fn go(p: nope.Pt) -> Int = 1\n"
  let (m4, _) = parser.parse_module(src4)
  let (cx4, _) = check_module(cx_new(Some("use_site"), None), m4, env)
  assert len(cx4.diags) > 0
  assert str.contains(cx4.diags[0].msg, "unknown module alias `nope`")
  # arity still checks through the alias
  let src5 = "use geom as g\n" ++
    "pub fn go(b: g.Box) -> Int = 1\n"
  let (m5, _) = parser.parse_module(src5)
  let (cx5, _) = check_module(cx_new(Some("use_site"), None), m5, env)
  assert len(cx5.diags) > 0
  assert str.contains(cx5.diags[0].msg, "takes 1 type parameter(s), got 0")
  # a qualified constructor pattern resolves and binds
  let src6 = "use geom as g\n" ++
    "pub fn open_box(b: g.Box[Int]) -> Int =\n" ++
    "  match b {\n" ++
    "    g.One(v) -> v\n" ++
    "  }\n"
  let (m6, pd6) = parser.parse_module(src6)
  assert len(pd6) == 0
  let (cx6, _) = check_module(cx_new(Some("use_site"), None), m6, env)
  assert len(cx6.diags) == 0
  let src12 = "use geom as g\n" ++
    "pub fn open_box(b: g.Box[Int]) -> Int = {\n" ++
    "  let g.One(v) = b\n" ++
    "  v\n" ++
    "}\n"
  let (m12, pd12) = parser.parse_module(src12)
  assert len(pd12) == 0
  let (cx12, _) = check_module(cx_new(Some("use_site"), None), m12, env)
  assert len(cx12.diags) == 0
  let src13 = "use geom as g\n" ++
    "pub fn recover(b: g.Box[Int]) -> Int = {\n" ++
    "  let missing.One(v) = b\n" ++
    "  v\n" ++
    "}\n"
  let (m13, pd13) = parser.parse_module(src13)
  assert len(pd13) == 0
  let (cx13, _) = check_module(cx_new(Some("use_site"), None), m13, env)
  assert len(cx13.diags) == 1
  assert cx13.diags[0].msg == "unknown module alias `missing` in a pattern"
  # a qualified constant, beside a local one of the same simple name: the
  # flat Core identity could not tell them apart (LANG-06 step 3)
  let src8 = "use geom as g\n" ++
    "const ORIGIN_X: Int = 7\n" ++
    "pub fn both() -> Int = ORIGIN_X + g.ORIGIN_X\n"
  let (m8, pd8) = parser.parse_module(src8)
  assert len(pd8) == 0
  let (cx8, tm8) = check_module(cx_new(Some("use_site"), None), m8, env)
  assert len(cx8.diags) == 0
  # the qualified reference carries the declaring module, the local one does not
  var owners: List[String] = []
  for f in tm8.fns {
    if f.name == "both" { owners = const_owners(f.body, owners) }
  }
  assert owners == ["", "geom"]
  # a qualified constructor in expression position: built through the alias,
  # generic and nullary alike, next to a local constructor of the same name
  let src10 = "use geom as g\n" ++
    "type Mine = | One(n: Int)\n" ++
    "pub fn f() -> Int =\n" ++
    "  match g.One(3) {\n" ++
    "    g.One(v) -> v\n" ++
    "  }\n" ++
    "pub fn local() -> Int =\n" ++
    "  match One(4) {\n" ++
    "    One(n) -> n\n" ++
    "  }\n"
  let (m10, pd10) = parser.parse_module(src10)
  assert len(pd10) == 0
  let (cx10, _) = check_module(cx_new(Some("use_site"), None), m10, env)
  assert len(cx10.diags) == 0
  # a constructor the module does not export is not reachable through the alias
  let src11 = "use geom as g\n" ++
    "pub fn f() -> Int = g.Nope(1)\n"
  let (m11, _) = parser.parse_module(src11)
  let (cx11, _) = check_module(cx_new(Some("use_site"), None), m11, env)
  assert len(cx11.diags) > 0

  # a constant the module does not export is not reachable through the alias
  let src9 = "use geom as g\n" ++
    "pub fn f() -> Int = g.NOPE\n"
  let (m9, _) = parser.parse_module(src9)
  let (cx9, _) = check_module(cx_new(Some("use_site"), None), m9, env)
  assert len(cx9.diags) > 0

  # an unexported constructor in a pattern names the module
  let src7 = "use geom as g\n" ++
    "pub fn f(b: g.Box[Int]) -> Int =\n" ++
    "  match b {\n" ++
    "    g.Nope(v) -> v\n" ++
    "  }\n"
  let (m7, _) = parser.parse_module(src7)
  let (cx7, _) = check_module(cx_new(Some("use_site"), None), m7, env)
  assert len(cx7.diags) > 0
  assert str.contains(cx7.diags[0].msg, "has no exported constructor `Nope`")
}

## The `with` sugar's whole checker surface. `with` is a parser rewrite, so
## nothing here type-checks differently -- what is pinned is that a jump out of
## the region is refused, and that the refusal talks about `with` rather than
## about the lambda the author never wrote (ast.dawn, spec §4.10).
test "a jump out of a `with` region names the sugar, not a lambda" {
  let head = "fn hold(r: Int, f: fn(Int) -> Int) -> Int = f(r)\n"
  let bad_return = head ++
    "fn go() -> Int = {\n" ++
    "  with x <- hold(1)\n" ++
    "  return x\n" ++
    "}\n"
  let (m, pdiags) = parser.parse_module(bad_return)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(test_cx(), m, env)
  assert len(cx1.diags) == 1
  assert cx1.diags[0].msg == with_cross_msg("return")
  assert str.contains(cx1.diags[0].hint, "drop the `return`")

  # break reaching a loop outside the region: the generic "crosses a lambda"
  # message would be a lie about what is on the page. A while loop, not for:
  # test_cx has no std, and `for..in` now needs std/list's Iter impl.
  let bad_break = head ++
    "fn go(xs: List[Int]) -> Int = {\n" ++
    "  while len(xs) > 0 {\n" ++
    "    with x <- hold(1)\n" ++
    "    break\n" ++
    "  }\n" ++
    "  0\n" ++
    "}\n"
  let (m2, pd2) = parser.parse_module(bad_break)
  assert len(pd2) == 0
  let (cx2, _) = check_module(test_cx(), m2, env)
  assert len(cx2.diags) > 0
  assert cx2.diags[0].msg == with_cross_msg("break")
  assert str.contains(cx2.diags[0].hint, "the loop is outside that closure")

  # a loop *inside* the region is untouched: its break never crosses anything
  let ok_break = head ++
    "fn go(xs: List[Int]) -> Int = {\n" ++
    "  with x <- hold(1)\n" ++
    "  while len(xs) > 0 { break }\n" ++
    "  x\n" ++
    "}\n"
  let (m3, pd3) = parser.parse_module(ok_break)
  assert len(pd3) == 0
  let (cx3, _) = check_module(test_cx(), m3, env)
  assert len(cx3.diags) == 0

  # a lambda the author *did* write, inside the region, keeps the old message
  let inner = head ++
    "fn go(xs: List[Int]) -> Int = {\n" ++
    "  with x <- hold(1)\n" ++
    "  while len(xs) > 0 {\n" ++
    "    let f = (k: Int) => { break }\n" ++
    "    ()\n" ++
    "  }\n" ++
    "  x\n" ++
    "}\n"
  let (m4, pd4) = parser.parse_module(inner)
  assert len(pd4) == 0
  let (cx4, _) = check_module(test_cx(), m4, env)
  assert len(cx4.diags) > 0
  assert str.contains(cx4.diags[0].msg, "cannot cross a lambda boundary")
}

test "a capture refused inside a `with` region names the sugar, not a lambda" {
  let head = "fn hold(r: Int, f: fn(Int) -> Int) -> Int = f(r)\n"
  let env: Map[String, ModExports] = map.empty()
  # assigning to a `var` from the block remainder
  let bad_assign = head ++
    "fn go() -> Int = {\n  var n = 0\n  with x <- hold(1)\n  n = x\n  0\n}\n"
  let (m1, pd1) = parser.parse_module(bad_assign)
  assert len(pd1) == 0
  let (cx1, _) = check_module(test_cx(), m1, env)
  assert len(cx1.diags) == 1
  assert cx1.diags[0].msg == "cannot assign to `n` from inside the closure `with` introduced"
  assert str.contains(cx1.diags[0].hint, "that closure's body")
  # and reading one
  let bad_read = head ++ "fn go() -> Int = {\n  var n = 0\n  with x <- hold(1)\n  x + n\n}\n"
  let (m2, pd2) = parser.parse_module(bad_read)
  assert len(pd2) == 0
  let (cx2, _) = check_module(test_cx(), m2, env)
  assert len(cx2.diags) == 1
  assert cx2.diags[0].msg ==
    "the closure `with` introduced cannot capture `var` bindings (capture is by value)"
  assert str.contains(cx2.diags[0].hint, "before the `with`")
  # binding the wrong number of names: the count is the `with` header's, so the
  # message counts what is written after `with`, not a lambda's parameters
  let bad_arity = "fn two(f: fn(Int, Int) -> Int) -> Int = f(1, 2)\n" ++
    "fn go() -> Int = {\n  with x <- two()\n  x\n}\n"
  let (m3, pd3) = parser.parse_module(bad_arity)
  assert len(pd3) == 0
  let (cx3, _) = check_module(test_cx(), m3, env)
  assert cx3.diags[0].msg ==
    "the closure `with` introduced takes 1 parameter(s), but fn(Int, Int) -> Int is expected"
  assert str.contains(cx3.diags[0].hint, "one per parameter")
}

## `?` composes through `with` (docs/core-move2-design.md §6): the synthesized
## closure hands back the `with` call's value, which is the block's value, so an
## `Err` propagated inside the region leaves the enclosing function.
test "`?` inside a `with` region propagates out of the function" {
  let src =
    "fn hold(r: Int, f: fn(Int) -> Result[Int, String]) -> Result[Int, String] = f(r)\n" ++
    "fn parse(s: String) -> Result[Int, String] = Ok(1)\n" ++
    "fn go(s: String) -> Result[Int, String] = {\n" ++
    "  with x <- hold(1)\n" ++
    "  let n = parse(s)?\n" ++
    "  Ok(n + x)\n" ++
    "}\n"
  let (m, pdiags) = parser.parse_module(src)
  assert len(pdiags) == 0
  let env: Map[String, ModExports] = map.empty()
  let (cx1, _) = check_module(test_cx(), m, env)
  if len(cx1.diags) > 0 { println("UNEXPECTED: " ++ cx1.diags[0].msg) }
  assert len(cx1.diags) == 0
}

# expect: unmatched ${ in interpolation
# The quote that ends the literal is taken as the string's own close, so the
# rest of the line still lexes as written: the `++` operand and the next
# declaration raise nothing further (#191).

fn label(a: Int, b: Int) -> String = "sum=${a + b" ++ " units"

fn other() -> String = "ok ${label(1, 2)}"

# The Java signature surface the checker consumes: plain-data records for
# classes, methods, constructors and fields, and the `Jsig` hook record that
# answers queries about them. Nothing here touches Java — `jreflect` implements
# the queries against the host's class path and offers them as `jsig_real()`,
# and `main` is where a `Cx` gets that oracle. Every other `Cx` keeps the
# default `jsig_refused()`: its gate bit is off, so `pass_java_uses` answers
# any `use java` declaration with a refusal instead of resolving it, and — as
# every other query is downstream of a resolved import — no stub is ever
# called. A compiler without a JVM host refuses `use java` programs by
# construction, not by conditional compilation.

## One method, as plain data. `desc` is Method.toString(), printed verbatim in
## overload-resolution error candidates.
pub type JMethod = {
  name: String,
  param_cls: List[String],
  ret_cls: String,
  is_static: Bool,
  is_varargs: Bool,
  is_abstract: Bool,
  desc: String,
  # the declaring class's name — codegen's invoke owner (Kotlin m.declaringClass)
  decl_cls: String
}

pub type JCtor = { param_cls: List[String], is_varargs: Bool, desc: String }

## One static field, as plain data (spec §9.1 — read-only static field access).
pub type JField = { name: String, type_cls: String, decl_cls: String }

## One class, as plain data. `display` is the TyJava display name (readable
## array names); `simple` is Class.getSimpleName() for error messages.
pub type JClass = {
  fqcn: String,
  simple: String,
  display: String,
  is_interface: Bool,
  is_primitive: Bool,
  is_array: Bool
}

## The signature oracle a `Cx` carries. `on` is the gate `pass_java_uses`
## consults; when it is false the other fields are unreachable, because every
## query below is made about a class that gate let in.
pub type Jsig = {
  on: Bool,
  find_class: fn(String) -> Option[JClass] !io,
  class_info: fn(String) -> JClass !io,
  methods_of: fn(String) -> List[JMethod] !io,
  ctors_of: fn(String) -> List[JCtor] !io,
  static_fields_of: fn(String) -> List[JField] !io,
  is_assignable: fn(String, String) -> Bool !io,
  sam_of: fn(String) -> Option[JMethod] !io,
  component_of: fn(String) -> Option[String] !io
}

## A signature oracle whose host resources have an explicit lifetime. JVM
## implementations close their target-local classloader; non-JVM hosts can
## pair a refusing oracle with a no-op release without importing Java here.
pub type JsigLease = {
  jsig: Jsig,
  close: fn() -> Unit !io
}

## A host-owned query counter. The checker cannot allocate shared mutable
## state: native hosts can provide a refusing probe, while JVM hosts own the
## counter beside their reflection implementation. Read it at the end of an
## analysis step; later tooling reads must not change that saved scalar.
pub type JsigProbe = { jsig: Jsig, queries: fn() -> Int !io }

## Observe every external query, including failed lookups, before forwarding
## it. Reading the fixed `on` gate is not an external query. No reflection or
## mutable host object crosses this boundary; the caller supplies the effect.
pub fn observe_queries(js: Jsig, note: fn() -> Unit !io) -> Jsig =
  Jsig {
    on: js.on,
    find_class: name => {
      note()
      js.find_class(name)
    },
    class_info: name => {
      note()
      js.class_info(name)
    },
    methods_of: name => {
      note()
      js.methods_of(name)
    },
    ctors_of: name => {
      note()
      js.ctors_of(name)
    },
    static_fields_of: name => {
      note()
      js.static_fields_of(name)
    },
    is_assignable: (sup, sub) => {
      note()
      js.is_assignable(sup, sub)
    },
    sam_of: name => {
      note()
      js.sam_of(name)
    },
    component_of: name => {
      note()
      js.component_of(name)
    }
  }

## Only a refusing host may claim zero queries without observing them.
pub fn refused_probe(js: Jsig) -> JsigProbe = {
  if js.on { panic("jsig: an enabled oracle needs a host query probe") }
  JsigProbe { jsig: js, queries: () => 0 }
}

# The stubs behind the refusal: reaching one means a Java type got past the
# gate, which is a checker bug, not a user error.
fn no_find_class(fqcn: String) -> Option[JClass] !io =
  panic("jsig: find_class(" ++ fqcn ++ ") after `use java` was refused")

fn no_class_info(fqcn: String) -> JClass !io =
  panic("jsig: class_info(" ++ fqcn ++ ") after `use java` was refused")

fn no_methods_of(fqcn: String) -> List[JMethod] !io =
  panic("jsig: methods_of(" ++ fqcn ++ ") after `use java` was refused")

fn no_ctors_of(fqcn: String) -> List[JCtor] !io =
  panic("jsig: ctors_of(" ++ fqcn ++ ") after `use java` was refused")

fn no_static_fields_of(fqcn: String) -> List[JField] !io =
  panic("jsig: static_fields_of(" ++ fqcn ++ ") after `use java` was refused")

fn no_is_assignable(sup: String, sub: String) -> Bool !io =
  panic("jsig: is_assignable(" ++ sup ++ ", " ++ sub ++ ") after `use java` was refused")

fn no_sam_of(fqcn: String) -> Option[JMethod] !io =
  panic("jsig: sam_of(" ++ fqcn ++ ") after `use java` was refused")

fn no_component_of(fqcn: String) -> Option[String] !io =
  panic("jsig: component_of(" ++ fqcn ++ ") after `use java` was refused")

## The default oracle: no host, so `use java` is refused at the declaration.
pub fn jsig_refused() -> Jsig =
  Jsig {
    on: false,
    find_class: no_find_class,
    class_info: no_class_info,
    methods_of: no_methods_of,
    ctors_of: no_ctors_of,
    static_fields_of: no_static_fields_of,
    is_assignable: no_is_assignable,
    sam_of: no_sam_of,
    component_of: no_component_of
  }

## A lifecycle-compatible refusal for hosts without Java. Keeping the no-op
## close beside the refusal prevents shared callers from inventing a second
## resource protocol for native execution.
pub fn jsig_refused_lease() -> JsigLease =
  JsigLease { jsig: jsig_refused(), close: () => () }

test "query observation precedes every hook including a failing query" {
  let js = observe_queries(jsig_refused(), () => panic("query-observed"))
  assert not js.on
  let calls: List[fn() -> Unit !io] = [
    () => { let _ = js.find_class("Missing") },
    () => { let _ = js.class_info("Missing") },
    () => { let _ = js.methods_of("Missing") },
    () => { let _ = js.ctors_of("Missing") },
    () => { let _ = js.static_fields_of("Missing") },
    () => { let _ = js.is_assignable("Super", "Sub") },
    () => { let _ = js.sam_of("Missing") },
    () => { let _ = js.component_of("Missing") }
  ]
  for call in calls {
    match catch_panic(call) {
      Err(e) -> { assert e.message == "query-observed" }
      Ok(_) -> { assert false }
    }
  }
}

test "a refused probe cannot claim an enabled oracle is query free" {
  let js = Jsig { ..jsig_refused(), on: true }
  match catch_panic(() => refused_probe(js)) {
    Err(e) -> { assert e.message == "jsig: an enabled oracle needs a host query probe" }
    Ok(_) -> { assert false }
  }
}

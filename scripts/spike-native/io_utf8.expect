-- read_file reads UTF-8 --
valid       ok
code points 2
-- and refuses what is not UTF-8 --
c0 af       caught
ed a0 80    caught
61 e2 82    caught
80          caught
-- the bytes are still there, for the primitive that wants bytes --
c0 af       c0af
61 e2 82    61e282
-- a filename that is not UTF-8 is a filename, not a failure --
sh exit     0
well formed true
ascii kept  true
-- and so is everything else the process was handed --
cwd         true
temp dir    true
PATH        true
cleaned up  true

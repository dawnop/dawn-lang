# checker.dawn: leaving a comptime block puts the enclosing dictionary
# bindings back (Frame.dict_syms) -- the bound on T outlives the block. The
# first function is the anchor: it has no bound, and says so either way.
pub fn unbounded[T](x: T) -> String = show(x)

pub fn bounded[T: Show](x: T) -> String = {
  let n = comptime { 2 }
  show(x)
}

# A function-typed field: the right side is a value, not a call, so the pipe
# applies it. Routing a dotted name into a call instead would look for a method
# named `run` that nobody declared.
type Handler = { name: String, run: fn(Int) -> Int }

pub fn main() -> Unit !io = {
  let h = Handler { name: "h", run: n => n * 10 }
  println("${5 |> h.run}")
}

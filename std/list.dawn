# Dawn's standard library: list operations.
#
# These are the "layer 2" of docs/pure-ffi-design.md section 3.3: ordinary Dawn
# recursion over the primitives that must stay in the compiler. Nothing here
# needs `unsafe_pure` — and it could not use it anyway, since these functions
# are effect-polymorphic and the stamp deliberately refuses to mask an effect
# variable. That refusal is what pushed the higher-order functions onto this
# path in the first place.
#
# The accumulator helpers are module-level rather than local functions because a
# local function may not declare an effect variable (spec section 3.1). Each is
# self-tail-recursive, which the compiler turns into a loop, and appends with
# `++`, which is O(1) amortized on the list representation (spec section 2.2) —
# without that, every one of these would be quadratic.

# ---- iteration ----
#
# Everything that walks a whole list, here and in the compiler, goes through
# these four. `for x in xs` lowers to them (lower.dawn's `lower_for_list`)
# rather than to an index loop, and so does every sequential helper below.
#
# The difference is not style: an index walk hardwires "this collection can be
# randomly indexed", which costs nothing on today's flat representation and
# O(log n) on the tree D3 replaces it with — measured 8-18x slower and widening
# with n. Behind a cursor, the representation changes and its callers do not.
#
# A cursor is an index today because the representation is flat. When it stops
# being flat, `Cur` and these four bodies change and nothing else does.
#
# Not `pub`: user code has no business holding one, and the compiler does not
# need it exported — an ordinary function is emitted public static either way.

alias Cur = Int

fn iter_start[T](xs: List[T]) -> Cur = 0

fn iter_done[T](xs: List[T], c: Cur) -> Bool = c >= len(xs)

fn iter_next[T](xs: List[T], c: Cur) -> Cur = c + 1

fn iter_get[T](xs: List[T], c: Cur) -> T = xs[c]

# ---- sequential walks ----

fn map_go[T, U](xs: List[T], f: fn(T) -> U !e, c: Cur, acc: List[U]) -> List[U] !e =
  if iter_done(xs, c) { acc }
  else { map_go(xs, f, iter_next(xs, c), acc ++ [f(iter_get(xs, c))]) }

## `f` applied to every element, in order.
pub fn map[T, U](xs: List[T], f: fn(T) -> U !e) -> List[U] !e = {
  let empty: List[U] = []
  map_go(xs, f, iter_start(xs), empty)
}

fn filter_go[T](xs: List[T], f: fn(T) -> Bool !e, c: Cur, acc: List[T]) -> List[T] !e =
  if iter_done(xs, c) { acc }
  else {
    let x = iter_get(xs, c)
    filter_go(xs, f, iter_next(xs, c), if f(x) { acc ++ [x] } else { acc })
  }

## The elements satisfying `f`, in order.
pub fn filter[T](xs: List[T], f: fn(T) -> Bool !e) -> List[T] !e = {
  let empty: List[T] = []
  filter_go(xs, f, iter_start(xs), empty)
}

fn fold_go[T, A](xs: List[T], f: fn(A, T) -> A !e, c: Cur, acc: A) -> A !e =
  if iter_done(xs, c) { acc }
  else { fold_go(xs, f, iter_next(xs, c), f(acc, iter_get(xs, c))) }

## Reduce from the left: `f(f(f(init, x0), x1), ...)`.
pub fn fold[T, A](xs: List[T], init: A, f: fn(A, T) -> A !e) -> A !e =
  fold_go(xs, f, iter_start(xs), init)

fn find_go[T](xs: List[T], pred: fn(T) -> Bool !e, c: Cur) -> Option[T] !e =
  if iter_done(xs, c) { None }
  else {
    let x = iter_get(xs, c)
    if pred(x) { Some(x) } else { find_go(xs, pred, iter_next(xs, c)) }
  }

## The first element satisfying `pred`, or `None`.
pub fn find[T](xs: List[T], pred: fn(T) -> Bool !e) -> Option[T] !e =
  find_go(xs, pred, iter_start(xs))

# ---- by position ----
#
# `take`/`drop`/`slice`/`reverse` are positional by nature: one asks for a
# range, the other for the other end. They stay on `get` and stay O(1) per
# element on a flat list. D3 does not de-index them — it replaces them, since
# an ordered tree cuts a range by splitting in O(log n) rather than by copying
# elements one at a time, and reverses by walking its own structure backwards.

fn slice_go[T](xs: List[T], i: Int, stop: Int, acc: List[T]) -> List[T] =
  if i >= stop { acc }
  else { slice_go(xs, i + 1, stop, acc ++ [get(xs, i).expect("index below length")]) }

fn clamp(n: Int, hi: Int) -> Int = if n < 0 { 0 } else { if n > hi { hi } else { n } }

## The first `n` elements; `n` is clamped into range, so this never panics.
pub fn take[T](xs: List[T], n: Int) -> List[T] = {
  let empty: List[T] = []
  slice_go(xs, 0, clamp(n, len(xs)), empty)
}

## Everything after the first `n` elements; `n` is clamped into range.
pub fn drop[T](xs: List[T], n: Int) -> List[T] = {
  let empty: List[T] = []
  slice_go(xs, clamp(n, len(xs)), len(xs), empty)
}

## The elements in `[from, to)`. Both ends are clamped into range, so
## out-of-bounds indices never panic; `from >= to` yields the empty list.
pub fn slice[T](xs: List[T], from: Int, to: Int) -> List[T] = {
  let empty: List[T] = []
  slice_go(xs, clamp(from, len(xs)), clamp(to, len(xs)), empty)
}

fn reverse_go[T](xs: List[T], i: Int, acc: List[T]) -> List[T] =
  if i < 0 { acc }
  else { reverse_go(xs, i - 1, acc ++ [get(xs, i).expect("index below length")]) }

## A reversed copy; the input is not changed.
pub fn reverse[T](xs: List[T]) -> List[T] = {
  let empty: List[T] = []
  reverse_go(xs, len(xs) - 1, empty)
}

## Ascending stable sort; elements need `Ord`. Delegates to `sort_by` with the
## bound `cmp` — the dictionary crosses as an ordinary captured value, which is
## what let this leave the builtin table (docs/pure-ffi-design.md section 14).
pub fn sort[T: Ord](xs: List[T]) -> List[T] = sort_by(xs, fn(a, b) => cmp(a, b))

# One walk serves max_by and min_by. `key` runs exactly once per element and
# only a strictly better key replaces the champion, so the first extreme wins —
# both observable (effectful keys, ties), both inherited from the retired
# builtin. The direction is a Bool rather than a ±1 multiplier because `cmp`
# contracts sign, not magnitude: scaling its result could overflow.
fn best_by_go[T, K: Ord](
  xs: List[T], key: fn(T) -> K !e, c: Cur, bx: T, bk: K, greater: Bool
) -> T !e =
  if iter_done(xs, c) { bx }
  else {
    let x = iter_get(xs, c)
    let k = key(x)
    let cp = cmp(k, bk)
    let better = if greater { cp > 0 } else { cp < 0 }
    if better { best_by_go(xs, key, iter_next(xs, c), x, k, greater) }
    else { best_by_go(xs, key, iter_next(xs, c), bx, bk, greater) }
  }

## The first element whose key is greatest; `None` when empty. Keys need `Ord`;
## `key` runs once per element.
pub fn max_by[T, K: Ord](xs: List[T], key: fn(T) -> K !e) -> Option[T] !e = {
  let c = iter_start(xs)
  if iter_done(xs, c) { None }
  else {
    let x0 = iter_get(xs, c)
    Some(best_by_go(xs, key, iter_next(xs, c), x0, key(x0), true))
  }
}

## The first element whose key is least; `None` when empty. Keys need `Ord`;
## `key` runs once per element.
pub fn min_by[T, K: Ord](xs: List[T], key: fn(T) -> K !e) -> Option[T] !e = {
  let c = iter_start(xs)
  if iter_done(xs, c) { None }
  else {
    let x0 = iter_get(xs, c)
    Some(best_by_go(xs, key, iter_next(xs, c), x0, key(x0), false))
  }
}

## The first greatest element; `None` when empty. Elements need `Ord`.
pub fn max[T: Ord](xs: List[T]) -> Option[T] = max_by(xs, fn(x) => x)

## The first least element; `None` when empty. Elements need `Ord`.
pub fn min[T: Ord](xs: List[T]) -> Option[T] = min_by(xs, fn(x) => x)

# ---- Eq / Hash / Ord for List (trait-v2-design.md 决策 6) ----
#
# Until trait v2 these three were the compiler's business: `==` on a list fell
# through to a `struct_eq` intrinsic, which each backend answered its own way,
# and `Ord[List[T]]` did not exist at all, so `sort` refused a list of lists.
# A conditional impl is how a container says what it means, in Dawn, once.
#
# The hash matches the shape the JVM's list hash already had (seed 1, step
# `31 * acc + h`), because `hash` and the runtime's own bucketing must not
# disagree about the same value.
#
# Two lists take two cursors: a cursor belongs to the list it walks, so there
# is no single "position i" to share between them.

fn eq_go[T: Eq](a: List[T], b: List[T], ca: Cur, cb: Cur) -> Bool =
  if iter_done(a, ca) {
    true
  } else if eq(iter_get(a, ca), iter_get(b, cb)) {
    eq_go(a, b, iter_next(a, ca), iter_next(b, cb))
  } else {
    false
  }

## Same length, and equal elements in order.
impl[T: Eq] Eq[List[T]] {
  fn eq(a: List[T], b: List[T]) -> Bool =
    if len(a) != len(b) { false } else { eq_go(a, b, iter_start(a), iter_start(b)) }
}

fn hash_go[T: Hash](xs: List[T], c: Cur, acc: Int) -> Int =
  if iter_done(xs, c) {
    acc
  } else {
    hash_go(xs, iter_next(xs, c), acc * 31 + hash(iter_get(xs, c)))
  }

impl[T: Hash] Hash[List[T]] {
  fn hash(xs: List[T]) -> Int = hash_go(xs, iter_start(xs), 1)
}

fn cmp_go[T: Ord](a: List[T], b: List[T], ca: Cur, cb: Cur) -> Int =
  if iter_done(a, ca) {
    if iter_done(b, cb) { 0 } else { 0 - 1 }
  } else if iter_done(b, cb) {
    1
  } else {
    let c = cmp(iter_get(a, ca), iter_get(b, cb))
    if c != 0 { c } else { cmp_go(a, b, iter_next(a, ca), iter_next(b, cb)) }
  }

## Lexicographic: the first differing element decides, and a prefix is less
## than what extends it.
impl[T: Ord] Ord[List[T]] {
  fn cmp(a: List[T], b: List[T]) -> Int = cmp_go(a, b, iter_start(a), iter_start(b))
}

# "Am I at the first element?" was `i == 0`. A cursor cannot be asked that, so
# the separator carries its own state -- the one thing dropping the index costs.
fn show_go[T: Show](xs: List[T], c: Cur, first: Bool, acc: String) -> String =
  if iter_done(xs, c) {
    acc
  } else {
    show_go(xs, iter_next(xs, c), false,
      acc ++ (if first { "" } else { ", " }) ++ show(iter_get(xs, c)))
  }

## `[e0, e1]`, each element in its nested form -- so a String element is
## quoted where the list itself is not.
impl[T: Show] Show[List[T]] {
  fn show(xs: List[T]) -> String = "[" ++ show_go(xs, iter_start(xs), true, "") ++ "]"
}

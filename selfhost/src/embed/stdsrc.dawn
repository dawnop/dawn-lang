\n    540 -> (6359114106063703798, 3414676654757950445)\n    541 -> (5087291284850963038, 6421090138548270680)\n    542 -> (8139666055761540861, 8429069814306277926)\n    543 -> (6511732844609232689, 4898581444074067179)\n    544 -> (5209386275687386151, 5763539562630208905)\n    545 -> (8335018041099817842, 5532314485466423924)\n    546 -> (6668014432879854274, 736502773631228816)\n    547 -> (5334411546303883419, 2433876626275938215)\n    548 -> (8535058474086213470, 7583551416783411467)\n    549 -> (6828046779268970776, 6066841133426729173)\n    550 -> (5462437423415176621, 3008798499370428177)\n    551 -> (8739899877464282594, 1124728784250774760)\n    552 -> (6991919901971426075, 2744457434771574970)\n    553 -> (5593535921577140860, 2195565947817259976)\n    554 -> (8949657474523425376, 3512905516507615961)\n    555 -> (7159725979618740301, 965650005835137607)\n    556 -> (5727780783694992240, 8151217634151930732)\n    557 -> (9164449253911987585, 3818576177788313364)\n    558 -> (7331559403129590068, 3054860942230650691)\n    559 -> (5865247522503672054, 6133237568526430876)\n    560 -> (4692198018002937643, 6751264462192099863)\n    561 -> (7507516828804700229, 8957348732136404618)\n    562 -> (6006013463043760183, 9010553393080078856)\n    563 -> (4804810770435008147, 1674419492351197600)\n    564 -> (7687697232696013035, 4523745595132871322)\n    565 -> (6150157786156810428, 3618996476106297057)\n    566 -> (4920126228925448342, 6584545995626947969)\n    567 -> (7872201966280717348, 3156575963519296104)\n    568 -> (6297761573024573878, 6214609585557347207)\n    569 -> (5038209258419659102, 8661036483187788089)\n    570 -> (8061134813471454564, 6478960743616640295)\n    571 -> (6448907850777163651, 7027843002264267398)\n    572 -> (5159126280621730921, 3777599994440458757)\n    573 -> (8254602048994769474, 2354811176362823687)\n    574 -> (6603681639195815579, 3728523348461214111)\n    575 -> (5282945311356652463, 4827493086139926451)\n    576 -> (8452712498170643941, 5879314530452927160)\n    577 -> (6762169998536515153, 2858777216991386566)\n    578 -> (5409735998829212122, 5976370588335019576)\n    579 -> (8655577598126739396, 2183495311852210675)\n    580 -> (6924462078501391516, 9125493878965589187)\n    581 -> (5539569662801113213, 5455720695801516188)\n    582 -> (8863311460481781141, 6884478705911470739)\n    583 -> (7090649168385424913, 3662908557358221429)\n    584 -> (5672519334708339930, 6619675660628487467)\n    585 -> (9076030935533343889, 1368109020150804139)\n    586 -> (7260824748426675111, 2939161623491598473)\n    587 -> (5808659798741340089, 506654891422323617)\n    588 -> (4646927838993072071, 2249998320508814055)\n    589 -> (7435084542388915313, 9134020534926967972)\n    590 -> (5948067633911132251, 1773193205828708893)\n    591 -> (4758454107128905800, 8797252194146787761)\n    592 -> (7613526571406249281, 4852231473780084609)\n    593 -> (6090821257124999425, 2037110771653112526)\n    594 -> (4872657005699999540, 1629688617322490021)\n    595 -> (7796251209119999264, 2607501787715984033)\n    596 -> (6237000967295999411, 3930675837543742388)\n    597 -> (4989600773836799529, 1299866262664038749)\n    598 -> (7983361238138879246, 5769134835004372321)\n    599 -> (6386688990511103397, 2770633460632542696)\n    _ -> panic(\"fmt: 10^k out of range\")\n  }\n\nfn g_chunk6(i: Int) -> (Int, Int) =\n  match i {\n    600 -> (5109351192408882717, 7750529990618899641)\n    601 -> (8174961907854212348, 5022150355506418780)\n    602 -> (6539969526283369878, 7707069099147045347)\n    603 -> (5231975621026695903, 631632057204770793)\n    604 -> (8371160993642713444, 8389308921011453915)\n    605 -> (6696928794914170755, 8556121544180118293)\n    606 -> (5357543035931336604, 6844897235344094635)\n    607 -> (8572068857490138567, 5417812354437685931)\n    608 -> (6857655085992110854, 644901068808238421)\n    609 -> (5486124068793688683, 2360595262417545899)\n    610 -> (8777798510069901893, 1932278012497118276)\n    611 -> (7022238808055921514, 5235171224739604944)\n    612 -> (5617791046444737211, 6032811387162639117)\n    613 -> (8988465674311579538, 5963149404718312264)\n    614 -> (7190772539449263630, 8459868338516560134)\n    615 -> (5752618031559410904, 6767894670813248108)\n    616 -> (9204188850495057447, 5294608251188331487)\n    _ -> panic(\"fmt: 10^k out of range\")\n  }\n# ---- Schubfach ----\n\n## Round-odd product: floor(g * cp / 2^127) with the low bit forced on when\n## any discarded bit was. `g = g1 * 2^63 + g0` is the 126-bit significand from\n## g_pair; `cp` stays under 2^61.\nfn rop(g1: Int, g0: Int, cp: Int) -> Int = {\n  let x1 = umulh(g0, cp)\n  let y0 = g1 * cp\n  let y1 = umulh(g1, cp)\n  let z = (y0 >>> 1) + x1\n  let vbp = y1 + (z >>> 63)\n  # the mask is 2^63 - 1: adding it pushes any nonzero low bits past bit 63\n  vbp | (((z & 9223372036854775807) + 9223372036854775807) >>> 63)\n}\n\nfn digits_len(f: Int) -> Int = {\n  var n = 1\n  while n < 18 && f >= pow10(n) {\n    n = n + 1\n  }\n  n\n}\n\n## Format the shortest digits `f` with `0.f * 10^e` as the value: plain\n## decimal inside 10^-3 <= |v| < 10^7, computerized scientific notation\n## outside (spec §4.3). Trailing zeros go, but a fraction keeps one digit.\nfn to_chars(f0: Int, e0: Int) -> String = {\n  let n0 = digits_len(f0)\n  let f = f0 * pow10(17 - n0)\n  let e = e0 + n0\n  var ds = str.pad_start(to_string(f), 17, \"0\")\n  var n = 17\n  while n > 1 && str.slice(ds, n - 1, n) == \"0\" {\n    n = n - 1\n  }\n  ds = str.take(ds, n)\n  if e > 0 && e <= 7 {\n    if n <= e {\n      ds ++ str.repeat(\"0\", e - n) ++ \".0\"\n    } else {\n      str.take(ds, e) ++ \".\" ++ str.slice(ds, e, n)\n    }\n  } else if e > -3 && e <= 0 {\n    \"0.\" ++ str.repeat(\"0\", -e) ++ ds\n  } else {\n    let head = str.take(ds, 1)\n    let frac = if n > 1 { str.slice(ds, 1, n) } else { \"0\" }\n    head ++ \".\" ++ frac ++ \"E\" ++ to_string(e - 1)\n  }\n}\n\n## The Schubfach core over `v = c * 2^q`: pick the shortest decimal in the\n## rounding interval, then the closest one (ties to even digits). A straight\n## port of the algorithm's figure-7 skeleton; `dk` is the decimal-exponent\n## debt the tiny-subnormal caller (`c` premultiplied by 10) hands in.\nfn to_decimal(q: Int, c: Int, dk: Int) -> String = {\n  let out = c & 1\n  let cb = c << 2\n  let cbr = cb + 2\n  var cbl = 0\n  var k = 0\n  if c != 4503599627370496 || q == -1074 {\n    # regular spacing: both neighbors half an ulp away\n    cbl = cb - 2\n    k = flog10pow2(q)\n  } else {\n    # the power of two just above a binade edge: the lower neighbor is closer\n    cbl = cb - 1\n    k = flog10_three_quarters_pow2(q)\n  }\n  let h = q + flog2pow10(-k) + 2\n  let (g1, g0) = g_pair(k + 324)\n  let vb = rop(g1, g0, cb << h)\n  let vbl = rop(g1, g0, cbl << h)\n  let vbr = rop(g1, g0, cbr << h)\n  let s = vb >> 2\n  if s >= 100 {\n    # is a 10-multiple (one digit shorter) already inside the interval?\n    let sp10 = 10 * (s / 10)\n    let tp10 = sp10 + 10\n    let upin = (vbl + out) <= (sp10 << 2)\n    let wpin = ((tp10 << 2) + out) <= vbr\n    if upin != wpin {\n      return to_chars(if upin { sp10 } else { tp10 }, k)\n    }\n  }\n  let t = s + 1\n  let uin = (vbl + out) <= (s << 2)\n  let win = ((t << 2) + out) <= vbr\n  if uin != win {\n    return to_chars(if uin { s } else { t }, k + dk)\n  }\n  let cmp = vb - ((s + t) << 1)\n  to_chars(if cmp < 0 || (cmp == 0 && (s & 1) == 0) { s } else { t }, k + dk)\n}\n\n## `to_string(Float)`: the shortest decimal string that reads back as exactly\n## `x`, in the two forms and three special spellings spec §4.3 fixes. This is\n## what both backends and comptime folding call; user code goes through\n## `to_string` and interpolation rather than calling it directly.\npub fn dtoa(x: Float) -> String = {\n  if x != x {\n    return \"NaN\"\n  }\n  let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)\n  let sign = if neg { \"-\" } else { \"\" }\n  if x == 0.0 {\n    return sign ++ \"0.0\"\n  }\n  let a = if neg { -x } else { x }\n  # only an infinity survives `a - a != 0` with the NaN case gone\n  if a - a != 0.0 {\n    return sign ++ \"Infinity\"\n  }\n  # Decompose a = c * 2^q with c integral, q >= -1074, and c in [2^52, 2^53)\n  # unless q is pinned at -1074 (subnormals, and the smallest normals). Done\n  # by exact scaling instead of a bit cast: Dawn has no Float bit intrinsic,\n  # and none is needed — multiplying or dividing by a power of two is exact\n  # whenever the result is representable, and every intermediate here is\n  # (scaling up from below 2^52 cannot overflow; scaling down stops at 2^52).\n  let p52 = to_float(4503599627370496)\n  let p53 = p52 + p52\n  var p512 = 2.0\n  var j = 0\n  while j < 9 {\n    p512 = p512 * p512\n    j = j + 1\n  }\n  let tiny = p52 / p512\n  var m = a\n  var q = 0\n  while m >= p512 {\n    m = m / p512\n    q = q + 512\n  }\n  while m >= p53 {\n    m = m / 2.0\n    q = q + 1\n  }\n  while m < tiny && q >= -562 {\n    m = m * p512\n    q = q - 512\n  }\n  while m < p52 && q > -1074 {\n    m = m * 2.0\n    q = q - 1\n  }\n  let c = to_int(m)\n  if c >= 4503599627370496 {\n    # normal: integers with an exact short form skip the interval machinery\n    let mq = -q\n    if mq > 0 && mq < 53 {\n      let f = c >> mq\n      if (f << mq) == c {\n        return sign ++ to_chars(f, 0)\n      }\n    }\n    return sign ++ to_decimal(q, c, 0)\n  }\n  # subnormal: c < 3 has too few bits for the interval arithmetic, so run it\n  # on 10c and repay the borrowed decimal digit through dk\n  if c < 3 {\n    return sign ++ to_decimal(q, 10 * c, -1)\n  }\n  sign ++ to_decimal(q, c, 0)\n}\n\n# ---- parsing (spec §11's EBNF, scanned here, never by a host grammar) ----\n\n# This scanner works in code points, not characters: `cursor.char` answers an\n# Int and a `-1` past the end (spec §4.8), so a sentinel that is not a\n# character rules `Char` out one layer down. `char.code` names an ASCII bound\n# without leaving that currency.\nfn is_ascii_digit(c: Int) -> Bool = c >= char.code('0') && c <= char.code('9')\n\n## Digit value for radix parsing: ASCII `0-9a-zA-Z` and nothing else — no\n## Unicode digits, no full-width forms (spec §11). -1 for a non-digit.\nfn digit_val(c: Int) -> Int =\n  if c >= char.code('0') && c <= char.code('9') {\n    c - char.code('0')\n  } else if c >= char.code('a') && c <= char.code('z') {\n    c - char.code('a') + 10\n  } else if c >= char.code('A') && c <= char.code('Z') {\n    c - char.code('A') + 10\n  } else {\n    -1\n  }\n\n# A prelude function since K19 (docs/std-defaults-design.md §7.4). It was a\n# builtin, and so was `parse_int_radix`, only because the builtin table has\n# no defaults; both already lowered to private functions here. A radix\n# outside 2..36 is `None` rather than a clamp or a panic: 0 and 1 name no\n# positional system, and asking is the caller's way to find out (spec 4.8\n# criterion 2). Accumulates negated so that Int's minimum, whose magnitude has\n# no positive Int, still parses.\n\n## An optional sign, then digits in `radix` and nothing else (spec §11),\n## after trimming by Dawn's own space table. Digits are `0-9a-zA-Z` cut off at\n## the radix, case-insensitive. `None` for malformed text, for a value outside\n## Int, and for a radix outside 2..36.\npub fn parse_int(s: String, radix: Int = 10) -> Option[Int] = {\n  if radix < 2 || radix > 36 {\n    return None\n  }\n  let t = str.trim(s)\n  var cur = cursor.start(t)\n  if cursor.done(t, cur) {\n    return None\n  }\n  var neg = false\n  let c0 = cursor.char(t, cur)\n  if c0 == char.code('+') || c0 == char.code('-') {\n    neg = c0 == char.code('-')\n    cur = cursor.next(t, cur)\n  }\n  if cursor.done(t, cur) {\n    return None\n  }\n  let limit = if neg { -9223372036854775807 - 1 } else { -9223372036854775807 }\n  let multmin = limit / radix\n  var acc = 0\n  while not cursor.done(t, cur) {\n    let d = digit_val(cursor.char(t, cur))\n    if d < 0 || d >= radix {\n      return None\n    }\n    if acc < multmin {\n      return None\n    }\n    acc = acc * radix\n    if acc < limit + d {\n      return None\n    }\n    acc = acc - d\n    cur = cursor.next(t, cur)\n  }\n  Some(if neg { acc } else { -acc })\n}\n\n## Does trimmed text match spec §11's float shape? sign? (digits [\".\" digits?]\n## | \".\" digits) ([eE] sign? digits)? — no suffixes, no hex floats, no\n## underscores. The special spellings are handled before this is asked.\nfn float_shape(t: String) -> Bool = {\n  var cur = cursor.start(t)\n  if cursor.done(t, cur) {\n    return false\n  }\n  let c0 = cursor.char(t, cur)\n  if c0 == char.code('+') || c0 == char.code('-') {\n    cur = cursor.next(t, cur)\n  }\n  var ipart = 0\n  while not cursor.done(t, cur) && is_ascii_digit(cursor.char(t, cur)) {\n    ipart = ipart + 1\n    cur = cursor.next(t, cur)\n  }\n  var fpart = 0\n  if not cursor.done(t, cur) && cursor.char(t, cur) == char.code('.') {\n    cur = cursor.next(t, cur)\n    while not cursor.done(t, cur) && is_ascii_digit(cursor.char(t, cur)) {\n      fpart = fpart + 1\n      cur = cursor.next(t, cur)\n    }\n  }\n  # a mantissa needs at least one digit somewhere; \"1.\" has one, \".\" has none\n  if ipart == 0 && fpart == 0 {\n    return false\n  }\n  if not cursor.done(t, cur) {\n    let ce = cursor.char(t, cur)\n    if ce != char.code('e') && ce != char.code('E') {\n      return false\n    }\n    cur = cursor.next(t, cur)\n    if not cursor.done(t, cur) {\n      let cs = cursor.char(t, cur)\n      if cs == char.code('+') || cs == char.code('-') {\n        cur = cursor.next(t, cur)\n      }\n    }\n    var epart = 0\n    while not cursor.done(t, cur) && is_ascii_digit(cursor.char(t, cur)) {\n      epart = epart + 1\n      cur = cursor.next(t, cur)\n    }\n    if epart == 0 {\n      return false\n    }\n  }\n  cursor.done(t, cur)\n}\n\n## `parse_float(s)`: the EBNF above, or exactly the three spellings `dtoa`\n## can emit — `Infinity`, `-Infinity`, `NaN` (no `+Infinity`, no signed NaN,\n## no lowercase variants), so parse(to_string(x)) always closes.\n##\n## A validated string is handed to the backend's `float_of_decimal` primitive\n## for the decimal-to-binary conversion only. That call is the raw one, and it\n## is marked by its name: lowering rewrites every `parse_float` into a call on\n## this function, here included, so writing `parse_float` below would make\n## atod call itself (lowering refuses that by name). That delegation cannot reintroduce\n## host grammar skew: on this subset both hosts implement the same function —\n## IEEE 754 round-to-nearest-even of a decimal literal, which the Java spec\n## requires of `Double.parseDouble` and C's `strtod` implements on every\n## hosted platform this backend targets. Every input the two hosts ever\n## disagreed on (hex floats, `1.5f`, `inf`, Unicode digits) is refused here\n## before either host can see it.\nfn atod(s: String) -> Option[Float] = {\n  let t = str.trim(s)\n  if t == \"Infinity\" {\n    return Some(1.0 / 0.0)\n  }\n  if t == \"-Infinity\" {\n    return Some(-1.0 / 0.0)\n  }\n  if t == \"NaN\" {\n    return Some(0.0 / 0.0)\n  }\n  if not float_shape(t) {\n    return None\n  }\n  float_of_decimal(t)\n}\n\n# The three parsers below had no test of their own. `dtoa` is pinned byte for\n# byte by scripts/dtoa-contract, which is why nothing here re-renders floats;\n# the direction that reads text was checked only by whatever happened to call\n# it, and what it *refuses* was checked by nothing at all. Refusal is most of\n# the promise: spec §11 fixes an accepted language precisely so a host parser's\n# extensions -- hex floats, `1.5f`, `inf`, Unicode digits -- cannot leak in\n# through whichever runtime is underneath.\n\ntest \"parse_int takes a sign and ASCII decimal digits, and nothing around them\" {\n  assert parse_int(\"0\") == Some(0)\n  assert parse_int(\"42\") == Some(42)\n  assert parse_int(\"+42\") == Some(42)\n  assert parse_int(\"-42\") == Some(-42)\n  assert parse_int(\"007\") == Some(7)\n  assert parse_int(\"-0\") == Some(0)\n  # trimmed first, by Dawn's own space table -- so the pad is outside the number\n  assert parse_int(\"  -5  \") == Some(-5)\n  assert parse_int(\"\\t\\n 7 \\r\\n\") == Some(7)\n  # ... and only outside it: a space the trim cannot reach is a non-digit\n  assert parse_int(\"4 2\") == None\n  assert parse_int(\"- 5\") == None\n  # nothing left after the sign is not a number\n  assert parse_int(\"\") == None\n  assert parse_int(\"   \") == None\n  assert parse_int(\"+\") == None\n  assert parse_int(\"-\") == None\n  assert parse_int(\"--5\") == None\n  # the whole string or nothing: no prefix parse, and no host spellings\n  assert parse_int(\"12abc\") == None\n  assert parse_int(\"0x10\") == None\n  assert parse_int(\"1.0\") == None\n  assert parse_int(\"1e3\") == None\n  # ASCII digits, not \"characters with a digit property\"\n  assert parse_int(\"４\") == None\n  # and Dawn's space table, not Unicode's: U+00A0 is not whitespace to `trim`\n  assert parse_int(\"\\u{00A0}42\") == None\n}\n\ntest \"parse_int answers None at the edge of Int instead of wrapping\" {\n  # the magnitude of the minimum has no positive Int, which is why the\n  # accumulator runs negated -- the case that shape exists for\n  assert parse_int(\"-9223372036854775808\") == Some(-9223372036854775807 - 1)\n  assert parse_int(\"9223372036854775807\") == Some(9223372036854775807)\n  # one past each end, and far past\n  assert parse_int(\"9223372036854775808\") == None\n  assert parse_int(\"-9223372036854775809\") == None\n  assert parse_int(\"99999999999999999999999\") == None\n  # There are two overflow guards and they catch different inputs. The three\n  # above are all stopped by the second one (`acc * radix` still fits, the\n  # digit is what does not), so a broken first guard survives them. These\n  # reach `multmin` itself: the running value is exactly one step from\n  # overflowing on the multiply, and nothing later would notice the wrap.\n  assert parse_int(\"922337203685477581\") == Some(922337203685477581)\n  assert parse_int(\"9223372036854775810\") == None\n  assert parse_int(\"9223372036854775819\") == None\n  assert parse_int(\"9223372036854775900\") == None\n  assert parse_int(\"-9223372036854775810\") == None\n  assert parse_int(\"-9223372036854775900\") == None\n  assert parse_int(\"9999999999999999999\") == None\n  # the asymmetry is real: the positive limit is one short of the negative one\n  assert parse_int(\"-9223372036854775807\") == Some(-9223372036854775807)\n}\n\ntest \"parse_int refuses a radix outside 2..36 and cuts the digits at it\" {\n  # a radix is a value the caller must get right, and 0 and 1 name no\n  # positional system -- so this is inquiry (spec 4.8 criterion 2), not a clamp\n  assert parse_int(\"1\", radix: 0) == None\n  assert parse_int(\"1\", radix: 1) == None\n  assert parse_int(\"1\", radix: 37) == None\n  assert parse_int(\"1\", radix: 0 - 2) == None\n  # both ends of the accepted range work\n  assert parse_int(\"1011\", radix: 2) == Some(11)\n  assert parse_int(\"z\", radix: 36) == Some(35)\n  assert parse_int(\"10\", radix: 36) == Some(36)\n  # the digit set is cut at the radix, not at the alphabet\n  assert parse_int(\"102\", radix: 2) == None\n  assert parse_int(\"z\", radix: 35) == None\n  assert parse_int(\"y\", radix: 35) == Some(34)\n  # case is not significant above 9, over the whole alphabet and not just the\n  # hex letters -- 'G'..'Z' is the stretch a hex-shaped digit table stops at\n  assert parse_int(\"ff\", radix: 16) == Some(255)\n  assert parse_int(\"FF\", radix: 16) == Some(255)\n  assert parse_int(\"fF\", radix: 16) == Some(255)\n  assert parse_int(\"Z\", radix: 36) == Some(35)\n  assert parse_int(\"G\", radix: 36) == Some(16)\n  assert parse_int(\"Y\", radix: 35) == Some(34)\n  assert parse_int(\"HELLO\", radix: 36) == Some(29234652)\n  assert parse_int(\"HELLO\", radix: 36) == parse_int(\"hello\", radix: 36)\n  # the gap between '9' and 'A' in ASCII is not a digit\n  assert parse_int(\":\", radix: 16) == None\n  assert parse_int(\"@\", radix: 16) == None\n  # sign and trim work the same at every radix\n  assert parse_int(\"-ff\", radix: 16) == Some(-255)\n  assert parse_int(\"  +11  \", radix: 2) == Some(3)\n  # the range is the radix's, so it moves with it\n  assert parse_int(\"111111111111111111111111111111111111111111111111111111111111111\", radix: 2)\n    == Some(9223372036854775807)\n  assert parse_int(\"1111111111111111111111111111111111111111111111111111111111111111\", radix: 2)\n    == None\n  assert parse_int(\"1y2p0ij32e8e7\", radix: 36) == Some(9223372036854775807)\n  assert parse_int(\"1y2p0ij32e8e8\", radix: 36) == None\n  # omitting the radix is writing ten, and the radix may be passed by position\n  assert parse_int(\"42\", radix: 10) == parse_int(\"42\")\n  assert parse_int(\"-42\", radix: 10) == parse_int(\"-42\")\n  assert parse_int(\"0x10\", radix: 10) == parse_int(\"0x10\")\n  assert parse_int(\"ff\", 16) == Some(255)\n  assert parse_int(\"ff\") == None\n}\n\ntest \"atod accepts the shape spec 11 writes down, and refuses the near misses\" {\n  assert atod(\"0\") == Some(0.0)\n  assert atod(\"1\") == Some(1.0)\n  assert atod(\"-1\") == Some(-1.0)\n  assert atod(\"+1\") == Some(1.0)\n  assert atod(\"1.5\") == Some(1.5)\n  assert atod(\"+1.5\") == Some(1.5)\n  assert atod(\"00.50\") == Some(0.5)\n  # a mantissa needs a digit somewhere, but not on both sides of the point\n  assert atod(\".5\") == Some(0.5)\n  assert atod(\"-.5\") == Some(-0.5)\n  assert atod(\"1.\") == Some(1.0)\n  assert atod(\"1.e2\") == Some(100.0)\n  assert atod(\".\") == None\n  assert atod(\"-.\") == None\n  # the exponent, both cases and all three sign spellings\n  assert atod(\"1e5\") == Some(100000.0)\n  assert atod(\"1E5\") == Some(100000.0)\n  assert atod(\"1e+5\") == Some(100000.0)\n  assert atod(\"1e-5\") == Some(0.00001)\n  assert atod(\".5e1\") == Some(5.0)\n  assert atod(\"0e0\") == Some(0.0)\n  # an `e` with no digits after it is not an exponent\n  assert atod(\"1e\") == None\n  assert atod(\"1e+\") == None\n  assert atod(\"1e-\") == None\n  assert atod(\"e5\") == None\n  # trimmed at the ends, refused in the middle\n  assert atod(\"  1.5  \") == Some(1.5)\n  assert atod(\"1 5\") == None\n  assert atod(\"1 . 5\") == None\n  # nothing at all\n  assert atod(\"\") == None\n  assert atod(\"   \") == None\n  assert atod(\"-\") == None\n  assert atod(\"+\") == None\n  assert atod(\"--1\") == None\n  assert atod(\"1.2.3\") == None\n  # the host spellings this refusal exists to keep out\n  assert atod(\"0x10\") == None\n  assert atod(\"1.5f\") == None\n  assert atod(\"1d5\") == None\n  assert atod(\"1_000\") == None\n  assert atod(\"٤\") == None\n}\n\ntest \"atod knows exactly the three spellings dtoa emits, and no synonyms\" {\n  # the pair that closes: these are the only non-numeric strings dtoa produces\n  assert dtoa(1.0 / 0.0) == \"Infinity\"\n  assert dtoa(-1.0 / 0.0) == \"-Infinity\"\n  assert dtoa(0.0 / 0.0) == \"NaN\"\n  assert atod(\"Infinity\") == Some(1.0 / 0.0)\n  assert atod(\"-Infinity\") == Some(-1.0 / 0.0)\n  assert atod(\"  Infinity  \") == Some(1.0 / 0.0)\n  # NaN is not equal to itself, so it is asked about rather than compared\n  let nan_is_nan = match atod(\"NaN\") {\n    Some(v) -> v != v\n    None -> false\n  }\n  assert nan_is_nan\n  # every neighbouring spelling a host parser would have taken\n  assert atod(\"inf\") == None\n  assert atod(\"Inf\") == None\n  assert atod(\"INF\") == None\n  assert atod(\"infinity\") == None\n  assert atod(\"INFINITY\") == None\n  assert atod(\"nan\") == None\n  assert atod(\"NAN\") == None\n  # dtoa never writes these two, so atod does not read them\n  assert atod(\"+Infinity\") == None\n  assert atod(\"-NaN\") == None\n}\n\ntest \"atod saturates at the ends of Float rather than answering None\" {\n  # out of range is not a shape error: the conversion is IEEE, and IEEE says\n  # overflow is an infinity and underflow is a zero\n  assert atod(\"1e400\") == Some(1.0 / 0.0)\n  assert atod(\"-1e400\") == Some(-1.0 / 0.0)\n  assert atod(\"1e309\") == Some(1.0 / 0.0)\n  assert atod(\"1e-400\") == Some(0.0)\n  # ... and the last representable value on each side is not saturated\n  assert atod(\"1e308\") == Some(1.0e308)\n  assert atod(\"4.9e-324\") == Some(4.9e-324)\n  # more digits than a Float holds is a rounding, not a refusal\n  assert atod(\"123456789012345678901234567890\") == Some(1.2345678901234568e29)\n  assert atod(\"0.1\") == Some(0.1)\n\n  # dtoa's output is always readable by atod, which is the promise that makes\n  # the two a pair rather than two independent functions. Written out rather\n  # than looped: `for` needs `Iter[List[T]]`, and that impl lives in std/list,\n  # which this module does not import.\n  assert atod(dtoa(0.0)) == Some(0.0)\n  assert atod(dtoa(1.5)) == Some(1.5)\n  assert atod(dtoa(-1.5)) == Some(-1.5)\n  assert atod(dtoa(3.141592653589793)) == Some(3.141592653589793)\n  assert atod(dtoa(1.0e300)) == Some(1.0e300)\n  assert atod(dtoa(1.0e-300)) == Some(1.0e-300)\n  assert atod(dtoa(42.0)) == Some(42.0)\n  assert atod(dtoa(0.1)) == Some(0.1)\n  # negative zero survives the trip, and `==` cannot see it -- 1/x can\n  assert dtoa(-0.0) == \"-0.0\"\n  let keeps_the_sign = match atod(\"-0.0\") {\n    Some(v) -> 1.0 / v == -1.0 / 0.0\n    None -> false\n  }\n  assert keeps_the_sign\n}\n")
  } else if name == "loc.dawn" {
    Some("## Call sites: the `Loc` a `caller()` default hands a function, and what\n## there is to ask of one (spec §8.4).\n#\n# `Loc` is minted by the compiler (`types.ty_loc`), for the reason `Char` is:\n# `panic`'s signature names it, so the checker needs the type before any\n# module is in scope. This module is its owner, the one place that sees the\n# text it is made of, `<path>:<line>:<col>`. A string rather than a record\n# because a call's site is then one string constant: passing it allocates\n# nothing, and a `panic` that omits its `at` folds the constant into its\n# message at compile time, the same bytes as before `at` existed\n# (docs/caller-location-design.md 3.1).\n#\n# Nothing outside this module can turn a String into a `Loc`, so every `Loc`\n# a program holds was measured by the compiler at some call.\n#\n# std has no position path (docs/source-location-design.md 4.1), so a call in\n# std that omits its `at` gets the empty `Loc`, which names no site: `panic`\n# adds nothing for it, it renders as nothing, and its line and column are 0.\n# It never reaches a program: std takes a `Loc` from its callers and never\n# hands one of its own back.\n\nuse std/str\nuse std/fmt\n\n## The location of the call of `here()`: the one place `caller()` is wanted\n## somewhere other than a parameter's default, given by a function whose\n## default it is.\npub fn here(at: Loc = caller()) -> Loc = at\n\n## The path of the file the call is in, as the program names it: relative to\n## the project root (`src/main.dawn`), to the entry file's directory for a\n## single file, `<package>/<path>` in a `[deps]` package.\npub fn path(l: Loc) -> String =\n  match parts(l) {\n    Some((p, _, _)) -> p\n    None -> \"\"\n  }\n\n## The 1-based line of the call.\npub fn line(l: Loc) -> Int =\n  match parts(l) {\n    Some((_, n, _)) -> n\n    None -> 0\n  }\n\n## The 1-based column of the call, counted in code points, the column the\n## compiler's diagnostics print.\npub fn col(l: Loc) -> Int =\n  match parts(l) {\n    Some((_, _, c)) -> c\n    None -> 0\n  }\n\n## Split from the right: the line and column are the last two fields, and a\n## path may itself contain a `:`.\nfn parts(l: Loc) -> Option[(String, Int, Int)] = {\n  let text: String = l\n  match str.rsplit_once(text, \":\") {\n    Some((rest, c)) ->\n      match str.rsplit_once(rest, \":\") {\n        Some((p, n)) ->\n          match (fmt.parse_int(n), fmt.parse_int(c)) {\n            (Some(ln), Some(cn)) -> Some((p, ln, cn))\n            _ -> None\n          }\n        None -> None\n      }\n    None -> None\n  }\n}\n\n## The site as the text a failure message carries after ` at `.\nimpl Display[Loc] {\n  fn display(l: Loc) -> String = l\n}\n\n## The same text nested: a `Loc` in a list reads `[src/a.dawn:1:2]`, not a\n## quoted string, because it is not a string a program wrote.\nimpl Show[Loc] {\n  fn show(l: Loc) -> String = l\n}\n\n# ---- tests ----\n\ntest \"a site splits from the right, so a path may hold a colon\" {\n  let l: Loc = \"c:/work/src/main.dawn:12:7\"\n  assert path(l) == \"c:/work/src/main.dawn\"\n  assert line(l) == 12\n  assert col(l) == 7\n  let plain: Loc = \"src/m.dawn:3:11\"\n  assert path(plain) == \"src/m.dawn\"\n  assert line(plain) == 3\n  assert col(plain) == 11\n}\n\ntest \"the no-site Loc names nothing\" {\n  let none: Loc = \"\"\n  assert path(none) == \"\"\n  assert line(none) == 0\n  assert col(none) == 0\n  assert to_string(none) == \"\"\n}\n\ntest \"a site renders as its text at both layers\" {\n  let l: Loc = \"src/m.dawn:3:11\"\n  assert to_string(l) == \"src/m.dawn:3:11\"\n  assert \"\${l}\" == \"src/m.dawn:3:11\"\n  assert show(l) == \"src/m.dawn:3:11\"\n}\n\ntest \"here() in std is the no-site Loc\" {\n  assert to_string(here()) == \"\"\n}\n")
  } else if name == "dtype.dawn" {
    Some("## The format a value has on a device: `Dtype[T]` names the format of `T`.\n#\n# Why this module exists: Dawn has no type arguments at a call site (spec 2.5),\n# so the only way to say \"the bf16 format\" where a function is called is to\n# pass a value. std/gpu's format markers were that value, and they cost a\n# second type per format beside the host value type of the same name\n# (`gpu.BF16` is a label, `narrow.BF16` is a number). Here the host value type\n# is the format: `Dtype[T]` carries its name at run time and `T` at the type\n# level, and a type that has a device format declares, in its own module, a\n# constant spelled like the type (`I8` beside `I8`) holding its `Dtype`. One\n# `use std/int/i8.{I8}` then brings in the type and its witness together, and\n# `alloc(I8, n)` reads as it always did. The premise std/gpu's header gave for\n# not reusing the host types, that doing so needs a value made just to be a\n# label, no longer holds; docs/tileir-011-design.md 2.4 has the whole account.\n#\n# Why a module of its own: the integer modules and std/narrow both declare\n# witnesses, and neither may depend on std/gpu (it uses narrow), so the format\n# type sits below all of them. This module imports nothing.\n#\n# Only std can mint a `Dtype`: its representation is opaque and `dtype_from_name`\n# is `pub(pkg)`, so a program cannot claim that its own type has a device\n# format. A type opts in with `impl HasDtype`, written in its own module. U16,\n# U32 and U64 have none on purpose: the tile dialect has no unsigned integer\n# types (signedness is a property of the operation), so a `Tensor[U32]` should\n# be a type error at `alloc` and not a wrong guess.\n#\n# The three builtin formats live here because Float, Int and Bool belong to no\n# module. Their witnesses are `F64`, `I64` and `I1`: a constant must be\n# SCREAMING_SNAKE_CASE, so `Float` cannot be the name of its own witness.\n\n## A device format for values of type `T`.\npub opaque type Dtype[T] = String\n\n## The format called `name`. Only std makes formats.\npub(pkg) fn dtype_from_name[T](name: String) -> Dtype[T] = name\n\n## The name the format goes by in a tile dialect, such as `f64` or `bf16`.\npub fn dtype_name[T](d: Dtype[T]) -> String = d\n\n## A type with a device format. `T` is only in the return position, so the\n## expected type picks the impl in any other module: `let f: Dtype[Float] =\n## dtype_of()`. (Inside this module an opaque type is its target, a `String`,\n## so `T` is unconstrained and nothing here can infer it;\n## scripts/spike-native/std_dtype.dawn covers the inference.)\npub trait HasDtype[T] {\n  fn dtype_of() -> Dtype[T]\n}\n\n## The bit pattern a value has as an element of a device buffer. A format\n## with no host value that can travel (`I1`, `I4`, `F4E2M1FN`, and the\n## unsigned widths, which have no format at all) has no impl, so moving one\n## is a type error and not a refusal at run time.\n##\n## The contract is one `Int` per element: the low `width` bits are the\n## format's pattern, read unsigned, and an 8-byte format fills the whole `Int`\n## (so `Float` and `Int` may answer a negative one). `from_bits` ignores the\n## bits above `width`. The width is not a method: a method without a `T` in\n## it cannot pick its impl, and the width is `element_bytes` of the format's\n## name. The wire form is these words, little-endian, packed once in std/gpu\n## (docs/gpu-typed-transfer-design.md section 2).\n##\n## A type's impl is written in its own module, beside its `HasDtype`; the\n## builtins `Float` and `Int` belong to no module, so theirs are here.\npub trait DeviceBits[T] {\n  fn to_bits(v: T) -> Int\n  fn from_bits(bits: Int) -> T\n}\n\n## The format of `Float`, 64-bit IEEE.\npub const F64: Dtype[Float] = dtype_from_name(\"f64\")\n\n## The format of `Int`, 64-bit two's complement.\npub const I64: Dtype[Int] = dtype_from_name(\"i64\")\n\n## The format of `Bool` in a tile: a one-bit mask.\npub const I1: Dtype[Bool] = dtype_from_name(\"i1\")\n\nimpl HasDtype[Float] {\n  fn dtype_of() -> Dtype[Float] = F64\n}\n\nimpl HasDtype[Int] {\n  fn dtype_of() -> Dtype[Int] = I64\n}\n\nimpl HasDtype[Bool] {\n  fn dtype_of() -> Dtype[Bool] = I1\n}\n\n# The raw pattern, not `narrow.f64_bits`: that one is arithmetic and answers\n# the canonical NaN, so a payload would not survive a trip to the device, and\n# std/narrow sits after this module anyway.\nimpl DeviceBits[Float] {\n  fn to_bits(v: Float) -> Int = float_to_bits(v)\n  fn from_bits(bits: Int) -> Float = float_of_bits(bits)\n}\n\nimpl DeviceBits[Int] {\n  fn to_bits(v: Int) -> Int = v\n  fn from_bits(bits: Int) -> Int = bits\n}\n\ntest \"the builtin witnesses carry the dialect's names\" {\n  assert dtype_name(F64) == \"f64\"\n  assert dtype_name(I64) == \"i64\"\n  assert dtype_name(I1) == \"i1\"\n}\n\ntest \"a format is as long-lived as its name\" {\n  let again: Dtype[Float] = dtype_from_name(\"f64\")\n  assert dtype_name(again) == dtype_name(F64)\n  assert dtype_name(F64) != dtype_name(I64)\n}\n\ntest \"Float bits are the IEEE pattern, the sign and a NaN's payload included\" {\n  let one: Float = from_bits(0x3FF0000000000000)\n  assert one == 1.0\n  assert to_bits(1.0) == 0x3FF0000000000000\n  assert to_bits(-2.0) == (1 << 63) | 0x4000000000000000\n  assert to_bits(0.0) == 0\n  assert to_bits(1.0 / 0.0) == 0x7FF0000000000000\n  let tiny: Float = from_bits(1)\n  assert to_bits(tiny) == 1\n  let neg_zero: Float = from_bits(1 << 63)\n  assert 1.0 / neg_zero < 0.0\n  assert to_bits(neg_zero) == 1 << 63\n  assert to_bits(0.1) == 0x3FB999999999999A\n  let payload = 0x7FF0000000000001\n  let nan: Float = from_bits(payload)\n  assert nan != nan\n  assert to_bits(nan) == payload\n  let quiet = 0x7FF8DEADBEEF1234\n  let q: Float = from_bits(quiet)\n  assert to_bits(q) == quiet\n  let signed = (1 << 63) | 0x7FF4000000000001\n  let s: Float = from_bits(signed)\n  assert to_bits(s) == signed\n}\n\ntest \"Int bits are the Int, past the 53 bits a Float holds\" {\n  let big = 9007199254740993\n  assert to_bits(big) == big\n  let back: Int = from_bits(big)\n  assert back == big\n  assert to_bits(-1) == -1\n  let min: Int = from_bits(1 << 63)\n  assert min == -9223372036854775807 - 1\n}\n")
  } else if name == "narrow.dawn" {
    Some("## Narrow binary floating point: bfloat16, IEEE binary16 and binary32 as\n## opaque types over Float, with correctly rounded arithmetic on each, and the\n## five storage-only formats the tile dialect also has.\n#\n# Dawn has one floating type, the 64-bit `Float`. Code that wants to know what\n# a computation does at a narrower width (quantised weights, a kernel that\n# will run on hardware in bf16) needs the narrow formats as *values* whose\n# every operation rounds the way the hardware rounds. The compiler owns two\n# numbers, Int and Float, and no float-to-bits primitive\n# (docs/literal-system-design.md D1), so this is not a new numeric type; it\n# is three opaque types (spec 2.7) whose invariant is \"the Float inside is\n# representable in the format\", a rounding function that establishes it, and\n# arithmetic whose every operation re-rounds.\n#\n# The arithmetic has two spellings and one definition. `a + b`, `a - b`,\n# `a * b`, `a / b`, `a % b` and `-a` on a BF16 are the impls of `Add` ..\n# `Neg` below (spec 3.5): the format's default operation, ties to even,\n# which is the only one the hardware's plain instruction performs. The\n# `Narrow` trait's members are the same operations by name; `+` IS\n# `narrow.add`, the impl calls it, and the names stay because `sqrt` and\n# `abs` have no operator and removing the others would break every caller\n# for nothing. A literal at one of these types goes through `FromFloat`\n# (`let w: BF16 = 0.1` is `bf16(0.1)`, folded at compile time), and an\n# integer literal does not: a format that only holds a few hundred integers\n# exactly should not look as if it took any. Inside this module none of that\n# applies to literals: the module sees through its own types, so\n# `let w: BF16 = 0.1` here is the unrounded Float (literal design D7), which\n# is why the code below builds its values with `bf16(..)` and friends.\n#\n# Why \"compute in Float, then round\" is the format's own answer, and for\n# which operations: Figueroa's double-rounding theorem. When the wide format\n# has at least 2p + 2 significand bits, rounding the exact result to wide and\n# then to narrow equals rounding it to narrow once, for + - * / and square\n# root. Float has 53 bits; the widest format here needs 2 * 24 + 2 = 50. So\n# `add`, `sub`, `mul` and `div` below are the correctly rounded operations of\n# their format, bit for bit, and scripts/narrow-contract pins that against an\n# exact rational oracle on both backends. `sqrt` is correctly rounded too,\n# by a different route: Dawn has no Float square root primitive, and a\n# p-bit root needs only about 2p + 2 bits of integer work, so it is computed\n# exactly in Int and never rounds twice. The theorem does not cover fused\n# multiply-add or the transcendental functions, and neither is offered: a\n# `bf16` exp would be \"exp in Float, then round\", which is a definition and\n# not the hardware's answer, and a name that looks like the others while\n# meaning something weaker is the mistake this module is here to avoid.\n#\n# `round_binary` is pure arithmetic on purpose. Without `float_to_bits` the\n# exponent is found by exact doublings and halvings, the significand is\n# scaled to the integer domain by an exact power of two, `to_int` truncates\n# it and ties are broken by hand. That is a few hundred iterations in the\n# worst case (a Float subnormal), which is what a reference implementation\n# may cost; a faster decomposition would be held to the same oracle.\n#\n# The widening member is `to_f64` and not `to_float`: a trait method shadows\n# the builtin of the same spelling throughout the declaring module (spec\n# 10.3), and `round_binary` needs the builtin `to_float` to bring its integer\n# significand back.\n\n# The rounding direction is a `Rounding` value and not a string or a family\n# of suffixed names. Before parameters had defaults the module grew\n# `round_binary_away`, `round_binary_toward(.., mode: String)` and three more\n# like them; a misspelt mode was a runtime panic and \"f32, ties away\" was a\n# function nobody had written. Now `mode` is the last parameter of\n# `round_binary`, `round_f32` and `round_tf32`, it defaults to the IEEE\n# default `NearestEven`, and a mode that does not exist cannot be spelt.\n# The variants follow IEEE 754's names, shortened, and correspond one to one\n# to the Tile IR dialect's rounding attribute:\n#\n#   NearestEven  roundTiesToEven      nearest_even\n#   NearestAway  roundTiesToAway      nearest_away\n#   TowardZero   roundTowardZero      zero\n#   Down         roundTowardNegative  negative_inf\n#   Up           roundTowardPositive  positive_inf\n#\n# The type is public so that packages/tileir can take the same value for its\n# own `rounding` attribute; the function from variant to dialect spelling\n# belongs there, next to the dialect, and not in a module about arithmetic.\n# The per-format functions (`round_bf16`, `round_f16`, the f8 family) take\n# no mode: the format is the function's identity, the f8 formats saturate\n# and so are not IEEE roundings at all, and no caller has asked for one.\n\n# ---- the formats ----\n\n# Each format is also a device format (std/dtype): the constant spelled like\n# its type is the format's witness, so that `use std/narrow.{BF16}` brings in\n# the type and the witness together, and `alloc(BF16, n)`, `p.to(BF16)` and\n# `Tile[BF16]` read as they always did. `impl HasDtype` lets generic code ask\n# for the witness by type. The names are the tile dialect's.\n\nuse std/dtype.{DeviceBits, Dtype, HasDtype, to_bits, dtype_name, dtype_from_name, dtype_of, from_bits}\n\n## A bfloat16 value: 8 significand bits, exponents -126..127.\npub opaque type BF16 = Float\n\n## The bfloat16 device format, the witness of [`BF16`].\npub const BF16: Dtype[BF16] = dtype_from_name(\"bf16\")\n\nimpl HasDtype[BF16] {\n  fn dtype_of() -> Dtype[BF16] = BF16\n}\n\nimpl DeviceBits[BF16] {\n  fn to_bits(v: BF16) -> Int = bf16_bits(v)\n  fn from_bits(bits: Int) -> BF16 = bf16_of_bits(bits)\n}\n\n## An IEEE binary16 value: 11 significand bits, exponents -14..15.\npub opaque type F16 = Float\n\n## The binary16 device format, the witness of [`F16`].\npub const F16: Dtype[F16] = dtype_from_name(\"f16\")\n\nimpl HasDtype[F16] {\n  fn dtype_of() -> Dtype[F16] = F16\n}\n\nimpl DeviceBits[F16] {\n  fn to_bits(v: F16) -> Int = f16_bits(v)\n  fn from_bits(bits: Int) -> F16 = f16_of_bits(bits)\n}\n\n## An IEEE binary32 value: 24 significand bits, exponents -126..127.\npub opaque type F32 = Float\n\n## The binary32 device format, the witness of [`F32`].\npub const F32: Dtype[F32] = dtype_from_name(\"f32\")\n\nimpl HasDtype[F32] {\n  fn dtype_of() -> Dtype[F32] = F32\n}\n\nimpl DeviceBits[F32] {\n  fn to_bits(v: F32) -> Int = f32_bits(v)\n  fn from_bits(bits: Int) -> F32 = f32_of_bits(bits)\n}\n\n# The storage-only formats: the dialect has them as tile and buffer element\n# types and gives them no arithmetic (tf32 only reaches `ftof` and memory,\n# the fp8 and fp4 types only conversions), so each is an opaque Float with a\n# literal and a rendering and nothing else, and its rounding is the\n# `round_*` function of the same format. There is no `to_f64` for them: that\n# name is a member of `Narrow` and trait methods share the function namespace,\n# so a second one would not compile. cutile-rs has the same split (\"no host\n# arithmetic, storage only\").\n\n## A TensorFloat-32 value: `round_tf32`'s grid.\npub opaque type TF32 = Float\n\n## The TensorFloat-32 device format, the witness of [`TF32`].\npub const TF32: Dtype[TF32] = dtype_from_name(\"tf32\")\n\nimpl HasDtype[TF32] {\n  fn dtype_of() -> Dtype[TF32] = TF32\n}\n\nimpl DeviceBits[TF32] {\n  fn to_bits(v: TF32) -> Int = tf32_bits(v)\n  fn from_bits(bits: Int) -> TF32 = tf32_of_bits(bits)\n}\n\n## An OCP fp8 value with four exponent bits and three significand bits and\n## no infinity: `round_f8e4m3fn`'s grid.\npub opaque type F8E4M3FN = Float\n\n## The `f8E4M3FN` device format, the witness of [`F8E4M3FN`].\npub const F8E4M3FN: Dtype[F8E4M3FN] = dtype_from_name(\"f8E4M3FN\")\n\nimpl HasDtype[F8E4M3FN] {\n  fn dtype_of() -> Dtype[F8E4M3FN] = F8E4M3FN\n}\n\nimpl DeviceBits[F8E4M3FN] {\n  fn to_bits(v: F8E4M3FN) -> Int = f8e4m3fn_bits(v)\n  fn from_bits(bits: Int) -> F8E4M3FN = f8e4m3fn_of_bits(bits)\n}\n\n## An OCP fp8 value with five exponent bits and two significand bits:\n## `round_f8e5m2`'s grid.\npub opaque type F8E5M2 = Float\n\n## The `f8E5M2` device format, the witness of [`F8E5M2`].\npub const F8E5M2: Dtype[F8E5M2] = dtype_from_name(\"f8E5M2\")\n\nimpl HasDtype[F8E5M2] {\n  fn dtype_of() -> Dtype[F8E5M2] = F8E5M2\n}\n\nimpl DeviceBits[F8E5M2] {\n  fn to_bits(v: F8E5M2) -> Int = f8e5m2_bits(v)\n  fn from_bits(bits: Int) -> F8E5M2 = f8e5m2_of_bits(bits)\n}\n\n## An fp8 exponent value, a power of two: `round_f8e8m0`'s grid.\npub opaque type F8E8M0FNU = Float\n\n## The `f8E8M0FNU` device format, the witness of [`F8E8M0FNU`].\npub const F8E8M0FNU: Dtype[F8E8M0FNU] = dtype_from_name(\"f8E8M0FNU\")\n\nimpl HasDtype[F8E8M0FNU] {\n  fn dtype_of() -> Dtype[F8E8M0FNU] = F8E8M0FNU\n}\n\nimpl DeviceBits[F8E8M0FNU] {\n  fn to_bits(v: F8E8M0FNU) -> Int = f8e8m0_bits(v)\n  fn from_bits(bits: Int) -> F8E8M0FNU = f8e8m0_of_bits(bits)\n}\n\n## An OCP MX fp4 value: `round_f4e2m1`'s grid.\npub opaque type F4E2M1FN = Float\n\n## The `f4E2M1FN` device format, the witness of [`F4E2M1FN`].\npub const F4E2M1FN: Dtype[F4E2M1FN] = dtype_from_name(\"f4E2M1FN\")\n\nimpl HasDtype[F4E2M1FN] {\n  fn dtype_of() -> Dtype[F4E2M1FN] = F4E2M1FN\n}\n\n# ---- rounding ----\n\n## How a value between two neighbours of a format picks one: the five\n## rounding-direction attributes of IEEE 754 section 4.3, under short names.\n##\n## - `NearestEven`: roundTiesToEven, the nearest neighbour, a tie to the one\n##   with an even last digit. The default everywhere, and the one Figueroa's\n##   theorem covers.\n## - `NearestAway`: roundTiesToAway, the nearest neighbour, a tie to the one\n##   of larger magnitude.\n## - `TowardZero`: roundTowardZero, the neighbour of smaller magnitude.\n## - `Down`: roundTowardNegative, the neighbour below.\n## - `Up`: roundTowardPositive, the neighbour above.\n##\n## The Tile IR dialect (`AttrDefs.td`'s `RoundingMode`) spells the same five\n## `nearest_even`, `nearest_away`, `zero`, `negative_inf` and `positive_inf`.\npub type Rounding = NearestEven | NearestAway | TowardZero | Down | Up\n\n## The value of the binary format with `p` significand bits (hidden bit\n## included), minimum normal exponent `emin` and maximum exponent `emax`\n## that `mode` picks for `x`. Below the normal range the answer lies on the\n## subnormal grid 2^(emin - p + 1), and may be zero of the sign. NaN, the\n## two zeros and the two infinities pass through unchanged.\n##\n## A finite `x` too big for the format is where the modes differ in kind,\n## not just in which neighbour: the two nearest modes overflow to the\n## infinity of the sign, and of the directed ones, rounding TOWARDS the\n## value's own infinity overflows to it while rounding away from it answers\n## the largest finite value. IEEE 754 section 4.3 says so, and a caller\n## comparing against hardware would otherwise read an infinity where the\n## device holds a finite number.\npub fn round_binary(x: Float, p: Int, emin: Int, emax: Int, mode: Rounding = NearestEven) -> Float =\n  if x != x || x == 0.0 {\n    x\n  } else {\n    let neg = x < 0.0\n    let a = if neg { -x } else { x }\n    let inf = 1.0 / 0.0\n    if a == inf {\n      x\n    } else {\n      let e = exponent(a)\n      # the quantum: one unit in the last place at this exponent, clamped\n      # to the subnormal grid below emin\n      let qe = (if e < emin { emin } else { e }) - p + 1\n      let q = pow2(qe)\n      # a / q is exact (a power-of-two scaling), and lies below 2^p, so\n      # `to_int` truncates without saturating; `r` is what was cut off\n      let m = a / q\n      let fl = to_int(m)\n      let r = m - to_float(fl)\n      # whether the magnitude goes up to the next quantum; the directed\n      # modes ask in terms of the sign, so they are answered in terms of it\n      let up = match mode {\n        NearestEven -> r > 0.5 || (r == 0.5 && fl % 2 == 1)\n        NearestAway -> r >= 0.5\n        TowardZero -> false\n        Down -> neg && r > 0.0\n        Up -> not neg && r > 0.0\n      }\n      let n = if up { fl + 1 } else { fl }\n      let v = to_float(n) * q\n      # the largest finite value is (2 - 2^(1 - p)) * 2^emax; a result above\n      # it (a carry out of the top exponent included) is the infinity,\n      # unless the mode rounds that sign's magnitude down\n      let max_finite = (2.0 - pow2(1 - p)) * pow2(emax)\n      let saturates = match mode {\n        NearestEven | NearestAway -> false\n        TowardZero -> true\n        Down -> not neg\n        Up -> neg\n      }\n      let out = if v > max_finite { if saturates { max_finite } else { inf } } else { v }\n      if neg { -out } else { out }\n    }\n  }\n\n# 2^k by exact doublings or halvings; k stays within Float's exponent range\n# for every caller here (the quantum of a Float subnormal is 2^-1074).\nfn pow2(k: Int) -> Float = {\n  var q = 1.0\n  var i = k\n  while i > 0 {\n    q = q * 2.0\n    i = i - 1\n  }\n  while i < 0 {\n    q = q * 0.5\n    i = i + 1\n  }\n  q\n}\n\n## `x` rounded to bfloat16.\npub fn round_bf16(x: Float) -> Float = round_binary(x, 8, -126, 127)\n\n## `x` rounded to binary16.\npub fn round_f16(x: Float) -> Float = round_binary(x, 11, -14, 15)\n\n## `x` rounded to binary32 in the direction `mode` names.\npub fn round_f32(x: Float, mode: Rounding = NearestEven) -> Float = round_binary(x, 24, -126, 127, mode)\n\n## `x` rounded to TensorFloat-32 in the direction `mode` names: binary32's\n## exponent range with eleven significand bits instead of twenty-four. It is\n## a rounding and not a storage format in this module's sense -- [`tf32_bits`]\n## puts it in a 32-bit word with thirteen zero bits at the bottom, which is\n## where the hardware keeps it. [`NearestAway`] is what the device answers for\n## `ftof` from f32 to tf32 under `nearest_away` (measured, knife T17).\npub fn round_tf32(x: Float, mode: Rounding = NearestEven) -> Float = round_binary(x, 11, -126, 127, mode)\n\n## `x` rounded to f8E5M2: three significand bits, exponents -14..15, and\n## SATURATING at the largest finite value.\n##\n## The format is an ordinary IEEE binary format at eight bits, infinities\n## and all, so [`round_binary`] is the arithmetic; what is not IEEE is the top\n## end. An IEEE conversion sends everything above the midpoint 61440 to\n## infinity, and this format has an infinity to send it to ([`f8e5m2_bits`]\n## and [`f8e5m2_of_bits`] keep the two 0x7C encodings, because a value ALREADY\n## in the format can be one). The device does not: knife TA converted\n## 1e30, -1e30 and an infinity on a B200 and got 57344, -57344 and 57344.\n##\n## So the codec and this function part company at exactly two inputs, and\n## the reason is that they answer different questions. [`f8e5m2_of_bits`] says\n## what an octet MEANS; this says what `ftof` DOES, and `ftof` saturates.\n## The two fp8 formats below say the same thing and f4E2M1FN says it too, so\n## saturation is this assembler's rule for the narrow floats and not a\n## property of any one of them.\npub fn round_f8e5m2(x: Float) -> Float =\n  if x != x {\n    x\n  } else {\n    let v = round_binary(x, 3, -14, 15)\n    if magnitude(v) <= 57344.0 { v } else if v < 0.0 { -57344.0 } else { 57344.0 }\n  }\n\n## `x` rounded to f8E4M3FN: four significand bits, exponents -6..8.\n##\n## FN is the whole of what this function adds to [`round_binary`]. The format\n## has no infinity: the all-ones exponent field is a normal exponent, and\n## only the single encoding with an all-ones significand under it is taken,\n## as NaN. So the largest finite value is 1.75 * 2^8 = 448 rather than the\n## 1.875 * 2^8 = 480 an IEEE format of these widths would have, and there is\n## nothing above it to overflow to except NaN.\n##\n## THE OVERFLOW ANSWER IS SATURATION, AND IT IS NOW MEASURED. The dialect\n## gives `ftof` no saturation attribute, so this function used to read IEEE's\n## rule with the infinity replaced by the only encoding left over: anything\n## above the midpoint 464 answered NaN. That was a guess, written down as\n## one, because no device this tree could reach accepted the type. Knife TA\n## reached one: on a B200 (sm_100) `ftof` answers 448 for 480, -448 for -480\n## and 448 for an infinity, and NaN only for NaN.\n##\n## 464 is unchanged and was never the question: it is the midpoint between\n## 448 and the 480 an IEEE format of these widths would have, and 448's\n## significand is the even one, so it ties DOWN under either reading. What\n## the measurement settled is everything above it.\npub fn round_f8e4m3fn(x: Float) -> Float =\n  if x != x {\n    x\n  } else {\n    let v = round_binary(x, 4, -6, 8)\n    if magnitude(v) <= 448.0 { v } else if v < 0.0 { -448.0 } else { 448.0 }\n  }\n\n## `x` rounded to f4E2M1FN: two significand bits, exponents 0..2, and\n## SIXTEEN VALUES IN ALL: +/-0, +/-0.5, +/-1, +/-1.5, +/-2, +/-3, +/-4,\n## +/-6. The whole value set fits on one line, which is what makes this\n## format different from the eight-bit ones rather than merely smaller.\n##\n## FN here is stronger than `f8E4M3FN`'s. That format has no infinity and\n## keeps two NaN encodings; this one has NEITHER, so every one of the\n## sixteen bit patterns is a finite number and there is nothing to answer\n## with when a value does not fit. So the two answers below are CHOICES,\n## and this tree cannot measure either: `tileiras` 13.3.36 refuses the type\n## at sm_86 and sm_89 and takes it only from sm_100, and the machine of the\n## ledger is an RTX 3080 (docs/tile-backend-design.md 6.12).\n##\n##   * a magnitude above the largest finite value SATURATES to it, sign\n##     kept, rather than overflowing. There is no infinity to overflow to,\n##     and the OCP MX specification's conversions saturate.\n##   * NaN answers +0.0. There is no NaN encoding either, and zero is the\n##     one value that is not a plausible answer to any finite input, so a\n##     corpus that reads it back knows it hit this arm.\n##\n## The rounding itself is [`round_binary`]'s: two significand bits (the\n## hidden one included), minimum normal exponent 0 and maximum 2, so the\n## subnormal grid is 2^-1 and 0.5 is the one subnormal. Types.td's own\n## example says the same in bits: 0001 is 0.5 and 0011 is 1.5.\npub fn round_f4e2m1(x: Float) -> Float =\n  if x != x {\n    0.0\n  } else {\n    let v = round_binary(x, 2, 0, 2)\n    if magnitude(v) <= 6.0 { v } else if v < 0.0 { -6.0 } else { 6.0 }\n  }\n\n## `x` rounded to f8E8M0FNU: the exponent alone.\n##\n## The value set is the 255 powers 2^-127 .. 2^127 and NaN, and that is all\n## of it: no sign bit, no significand, no zero, no infinity. So this is not\n## a [`round_binary`] at some width, it is a different function, and its\n## rounding mode is different too -- `ftof` accepts only `zero` and\n## `positive_inf` for this target (Ops.td's FToFOp), never the\n## `nearest_even` every other conversion here takes. This is the `zero` one,\n## which is what packages/tileir writes: the answer is the largest power of\n## two at or below `x`.\n##\n## NOTHING BUT NaN ANSWERS NaN, and that too is measured rather than\n## chosen. This function used to send zero, every negative number and the\n## infinities to NaN, on the reading that a format with no encoding for them\n## has nothing else to answer. Knife TA asked a B200: zero answers 2^-127,\n## -1 answers 1, an infinity answers 2^127, and 2^140 answers 2^127. So\n## `ftof` into this format takes the MAGNITUDE and then clamps into the\n## range, which is the same saturation the two fp8 formats above do, with\n## the sign dropped because there is no sign bit to keep it in.\n##\n## A positive number below 2^-127 has no representable value below it and\n## clamps UP to 2^-127; that arm was a guess too and the device agrees with\n## it (2^-140 answers 2^-127).\n##\n## [`f8e8m0_bits`] is NOT changed to match: it answers what an octet means,\n## and zero and the negatives are still not values of this format. The two\n## functions answer different questions, and [`round_f8e5m2`] records the same\n## split at the other end of the range.\npub fn round_f8e8m0(x: Float) -> Float =\n  if x != x {\n    x\n  } else {\n    let a = magnitude(x)\n    if a == 0.0 {\n      pow2(-127)\n    } else if a == 1.0 / 0.0 {\n      pow2(127)\n    } else {\n      let e = exponent(a)\n      if e > 127 {\n        pow2(127)\n      } else if e < -127 {\n        pow2(-127)\n      } else {\n        pow2(e)\n      }\n    }\n  }\n\n# ---- construction ----\n\n## The bfloat16 nearest to `x`.\npub fn bf16(x: Float) -> BF16 = round_bf16(x)\n\n## The binary16 nearest to `x`.\npub fn f16(x: Float) -> F16 = round_f16(x)\n\n## The binary32 nearest to `x`.\npub fn f32(x: Float) -> F32 = round_f32(x)\n\n# ---- rendering ----\n\n# Each format renders as the Float it holds: every value of a narrow format is\n# a Float, so the shortest round trip of that Float is also the shortest text\n# that reads back as the format's value. Written out because an opaque type\n# inherits no rendering from its target (spec 2.7); a narrow number is a value\n# a caller prints, which is what earns these three their impl. `to_f64` rather\n# than a conversion by binding keeps each body one expression.\n\nimpl Show[BF16] {\n  fn show(x: BF16) -> String = show(to_f64(x))\n}\n\nimpl Show[F16] {\n  fn show(x: F16) -> String = show(to_f64(x))\n}\n\nimpl Show[F32] {\n  fn show(x: F32) -> String = show(to_f64(x))\n}\n\n# ---- arithmetic ----\n\n## The operations every narrow format offers. `add`, `sub`, `mul`, `div` and\n## `sqrt` are the format's correctly rounded operations (ties to even, overflow\n## to infinity, gradual underflow); `neg` and `abs` are exact. Equality and\n## order are the Float's, as on any opaque type, so `==` and `<` need no\n## member. `a + b`, `a - b`, `a * b`, `a / b` and `-a` are `add`, `sub`,\n## `mul`, `div` and `neg` under the operator's name, and `a % b` is the\n## exact truncating remainder.\npub trait Narrow[T] {\n  ## The value as a Float; exact, since every value of the format is one.\n  fn to_f64(a: T) -> Float\n  ## Correctly rounded sum.\n  fn add(a: T, b: T) -> T\n  ## Correctly rounded difference.\n  fn sub(a: T, b: T) -> T\n  ## Correctly rounded product.\n  fn mul(a: T, b: T) -> T\n  ## Correctly rounded quotient.\n  fn div(a: T, b: T) -> T\n  ## Correctly rounded square root.\n  fn sqrt(a: T) -> T\n  ## The negation.\n  fn neg(a: T) -> T\n  ## The magnitude.\n  fn abs(a: T) -> T\n}\n\nimpl Narrow[BF16] {\n  fn to_f64(a: BF16) -> Float = a\n  fn add(a: BF16, b: BF16) -> BF16 = {\n    let x: Float = a\n    let y: Float = b\n    round_bf16(x + y)\n  }\n  fn sub(a: BF16, b: BF16) -> BF16 = {\n    let x: Float = a\n    let y: Float = b\n    round_bf16(x - y)\n  }\n  fn mul(a: BF16, b: BF16) -> BF16 = {\n    let x: Float = a\n    let y: Float = b\n    round_bf16(x * y)\n  }\n  fn div(a: BF16, b: BF16) -> BF16 = {\n    let x: Float = a\n    let y: Float = b\n    round_bf16(x / y)\n  }\n  fn sqrt(a: BF16) -> BF16 = {\n    let x: Float = a\n    sqrt_binary(x, 8)\n  }\n  fn neg(a: BF16) -> BF16 = {\n    let x: Float = a\n    -x\n  }\n  fn abs(a: BF16) -> BF16 = {\n    let x: Float = a\n    magnitude(x)\n  }\n}\n\nimpl Narrow[F16] {\n  fn to_f64(a: F16) -> Float = a\n  fn add(a: F16, b: F16) -> F16 = {\n    let x: Float = a\n    let y: Float = b\n    round_f16(x + y)\n  }\n  fn sub(a: F16, b: F16) -> F16 = {\n    let x: Float = a\n    let y: Float = b\n    round_f16(x - y)\n  }\n  fn mul(a: F16, b: F16) -> F16 = {\n    let x: Float = a\n    let y: Float = b\n    round_f16(x * y)\n  }\n  fn div(a: F16, b: F16) -> F16 = {\n    let x: Float = a\n    let y: Float = b\n    round_f16(x / y)\n  }\n  fn sqrt(a: F16) -> F16 = {\n    let x: Float = a\n    sqrt_binary(x, 11)\n  }\n  fn neg(a: F16) -> F16 = {\n    let x: Float = a\n    -x\n  }\n  fn abs(a: F16) -> F16 = {\n    let x: Float = a\n    magnitude(x)\n  }\n}\n\nimpl Narrow[F32] {\n  fn to_f64(a: F32) -> Float = a\n  fn add(a: F32, b: F32) -> F32 = {\n    let x: Float = a\n    let y: Float = b\n    round_f32(x + y)\n  }\n  fn sub(a: F32, b: F32) -> F32 = {\n    let x: Float = a\n    let y: Float = b\n    round_f32(x - y)\n  }\n  fn mul(a: F32, b: F32) -> F32 = {\n    let x: Float = a\n    let y: Float = b\n    round_f32(x * y)\n  }\n  fn div(a: F32, b: F32) -> F32 = {\n    let x: Float = a\n    let y: Float = b\n    round_f32(x / y)\n  }\n  fn sqrt(a: F32) -> F32 = {\n    let x: Float = a\n    sqrt_binary(x, 24)\n  }\n  fn neg(a: F32) -> F32 = {\n    let x: Float = a\n    -x\n  }\n  fn abs(a: F32) -> F32 = {\n    let x: Float = a\n    magnitude(x)\n  }\n}\n\n# ---- operators and literals ----\n#\n# The operators are the `Narrow` members above under the operator's name,\n# one impl per operator and format. Each body is a call, not a copy: the\n# rounding is written once, and scripts/narrow-contract runs the operator\n# and the named member over the same oracle cases, so a body that drifted\n# from its name would be red there. Inside an impl body `add` names the\n# `Narrow` member, since an operator trait's methods are not functions of\n# the module (docs/arith-operator-traits-design.md D9).\n#\n# `%` has no `Narrow` member and needs no rounding. Float's `%` is the\n# truncating remainder (the JVM's DREM, C's `fmod`), and that operation is\n# exact in every binary format: the answer is `a - n * b` for an integer `n`,\n# smaller in magnitude than `b`, and a multiple of the coarser of the two\n# operands' quanta, so it is a value of the format both came from. The\n# contract checks that against the rational definition rather than taking it\n# on trust. tileir's `remf` rests on the same fact.\n#\n# `FromFloat` is the constructor: a literal at a format is the format's\n# nearest value to the Float the literal denotes (literal design D8). There\n# is no `FromInt`. bf16 has 256 consecutive integers and f16 2048; a\n# `let w: BF16 = 1000001` that quietly meant 999424 is the surprise a\n# literal at a narrow type must not have, and `1000001.0` says what it\n# costs.\n\nimpl Add[BF16] {\n  fn add(a: BF16, b: BF16) -> BF16 = add(a, b)\n}\n\nimpl Sub[BF16] {\n  fn sub(a: BF16, b: BF16) -> BF16 = sub(a, b)\n}\n\nimpl Mul[BF16] {\n  fn mul(a: BF16, b: BF16) -> BF16 = mul(a, b)\n}\n\nimpl Div[BF16] {\n  fn div(a: BF16, b: BF16) -> BF16 = div(a, b)\n}\n\nimpl Rem[BF16] {\n  fn rem(a: BF16, b: BF16) -> BF16 = {\n    let x: Float = a\n    let y: Float = b\n    x % y\n  }\n}\n\nimpl Neg[BF16] {\n  fn neg(a: BF16) -> BF16 = neg(a)\n}\n\nimpl FromFloat[BF16] {\n  fn from_float(x: Float) -> BF16 = bf16(x)\n}\n\nimpl Add[F16] {\n  fn add(a: F16, b: F16) -> F16 = add(a, b)\n}\n\nimpl Sub[F16] {\n  fn sub(a: F16, b: F16) -> F16 = sub(a, b)\n}\n\nimpl Mul[F16] {\n  fn mul(a: F16, b: F16) -> F16 = mul(a, b)\n}\n\nimpl Div[F16] {\n  fn div(a: F16, b: F16) -> F16 = div(a, b)\n}\n\nimpl Rem[F16] {\n  fn rem(a: F16, b: F16) -> F16 = {\n    let x: Float = a\n    let y: Float = b\n    x % y\n  }\n}\n\nimpl Neg[F16] {\n  fn neg(a: F16) -> F16 = neg(a)\n}\n\nimpl FromFloat[F16] {\n  fn from_float(x: Float) -> F16 = f16(x)\n}\n\nimpl Add[F32] {\n  fn add(a: F32, b: F32) -> F32 = add(a, b)\n}\n\nimpl Sub[F32] {\n  fn sub(a: F32, b: F32) -> F32 = sub(a, b)\n}\n\nimpl Mul[F32] {\n  fn mul(a: F32, b: F32) -> F32 = mul(a, b)\n}\n\nimpl Div[F32] {\n  fn div(a: F32, b: F32) -> F32 = div(a, b)\n}\n\nimpl Rem[F32] {\n  fn rem(a: F32, b: F32) -> F32 = {\n    let x: Float = a\n    let y: Float = b\n    x % y\n  }\n}\n\nimpl Neg[F32] {\n  fn neg(a: F32) -> F32 = neg(a)\n}\n\nimpl FromFloat[F32] {\n  fn from_float(x: Float) -> F32 = f32(x)\n}\n\nimpl FromFloat[TF32] {\n  fn from_float(x: Float) -> TF32 = round_tf32(x)\n}\n\nimpl FromFloat[F8E4M3FN] {\n  fn from_float(x: Float) -> F8E4M3FN = round_f8e4m3fn(x)\n}\n\nimpl FromFloat[F8E5M2] {\n  fn from_float(x: Float) -> F8E5M2 = round_f8e5m2(x)\n}\n\nimpl FromFloat[F8E8M0FNU] {\n  fn from_float(x: Float) -> F8E8M0FNU = round_f8e8m0(x)\n}\n\nimpl FromFloat[F4E2M1FN] {\n  fn from_float(x: Float) -> F4E2M1FN = round_f4e2m1(x)\n}\n\nimpl Show[TF32] {\n  fn show(x: TF32) -> String = {\n    let v: Float = x\n    show(v)\n  }\n}\n\nimpl Show[F8E4M3FN] {\n  fn show(x: F8E4M3FN) -> String = {\n    let v: Float = x\n    show(v)\n  }\n}\n\nimpl Show[F8E5M2] {\n  fn show(x: F8E5M2) -> String = {\n    let v: Float = x\n    show(v)\n  }\n}\n\nimpl Show[F8E8M0FNU] {\n  fn show(x: F8E8M0FNU) -> String = {\n    let v: Float = x\n    show(v)\n  }\n}\n\nimpl Show[F4E2M1FN] {\n  fn show(x: F4E2M1FN) -> String = {\n    let v: Float = x\n    show(v)\n  }\n}\n\n# `<=` rather than `<` so that -0.0 comes out as +0.0, as the IEEE operation\n# does. NaN is not <= 0 and passes through.\nfn magnitude(x: Float) -> Float = if x <= 0.0 { 0.0 - x } else { x }\n\n# The correctly rounded p-bit square root of `x`, a value of the p-bit format.\n#\n# Scale x by an even power of two to an integer N in [2^(2p), 2^(2p + 2)), so\n# that sqrt(N) is in [2^p, 2^(p + 1)): p bits plus one. Scaling is exact\n# because x has at most p significant bits (the caller's invariant) and N is\n# at most 50 bits. The integer root t = floor(sqrt(N)) then carries the p-bit\n# significand in its high bits, the rounding bit in its low bit, and whether\n# anything was thrown away in N - t * t. A square root is never exactly\n# halfway between two p-bit values (the square of a midpoint has 2p + 2\n# significant bits and x has p), so the tie branch is unreachable and kept\n# only so the rule reads whole. No overflow or underflow is possible: the\n# root of the largest finite value is finite and the root of the smallest\n# subnormal is a normal number.\nfn sqrt_binary(x: Float, p: Int) -> Float =\n  if x != x || x == 0.0 || x == 1.0 / 0.0 {\n    x\n  } else if x < 0.0 {\n    0.0 / 0.0\n  } else {\n    let e = exponent(x)\n    # 2k = 2p - e, made even by taking one more when e is odd\n    let k2 = if e % 2 == 0 { 2 * p - e } else { 2 * p - e + 1 }\n    let n = to_int(x * pow2(k2))\n    let t = isqrt(n)\n    let q = t / 2\n    let rounded = if t % 2 == 0 {\n      q\n    } else if t * t != n {\n      q + 1\n    } else if q % 2 == 0 {\n      q\n    } else {\n      q + 1\n    }\n    # sqrt(x) = sqrt(N) / 2^k, and sqrt(N) rounds to 2 * rounded\n    to_float(rounded) * pow2(1 - k2 / 2)\n  }\n\n# floor(sqrt(n)) for n >= 0, by Newton's method from a power-of-two\n# overestimate; the iterate decreases monotonically to the answer.\nfn isqrt(n: Int) -> Int =\n  if n < 2 {\n    n\n  } else {\n    var guess = 1\n    while guess * guess < n {\n      guess = guess * 2\n    }\n    var next = (guess + n / guess) / 2\n    while next < guess {\n      guess = next\n      next = (guess + n / guess) / 2\n    }\n    guess\n  }\n\n# e with 2^e <= x < 2^(e + 1), for finite positive x, by exact doublings and\n# halvings of a running power of two.\nfn exponent(x: Float) -> Int = {\n  var pow = 1.0\n  var e = 0\n  while x >= pow * 2.0 {\n    pow = pow * 2.0\n    e = e + 1\n  }\n  while x < pow {\n    pow = pow * 0.5\n    e = e - 1\n  }\n  e\n}\n\n# ---- bit patterns ----\n#\n# The one place a narrow format's bits matter to a Dawn program is a device\n# whose memory holds them (std/gpu's bf16 tensors). There is no float-to-bits\n# primitive, so the pattern is assembled from the same exact arithmetic\n# `round_binary` uses: the exponent by doublings and halvings, the\n# significand by an exact power-of-two scaling. bfloat16 and binary16 have a\n# codec here, the second because a device buffer of f16 elements needed one\n# (std/gpu's `pack_f16`); binary32 would take the same shape with its own\n# widths, and gets one when something needs it.\n\n## The 16-bit pattern of the bfloat16 value `x`: the sign bit, eight exponent\n## bits biased by 127, seven significand bits, as the value sits in memory.\n## `x` is a value of the format, as [`round_bf16`] leaves it. For a Float off\n## the bf16 grid the answer is the pattern with the extra significand bits\n## dropped (truncation toward zero, what reading the high half of a binary32\n## gives), NOT the nearest bf16: round first. A value beyond the format's\n## range answers the infinity of its sign. NaN answers the canonical quiet\n## NaN `0x7FC0`: a Float carries no payload a program can read, so none can\n## be preserved.\npub fn bf16_bits(x: Float) -> Int =\n  if x != x {\n    0x7FC0\n  } else {\n    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)\n    let sign = if neg { 0x8000 } else { 0 }\n    let a = if neg { -x } else { x }\n    if a == 0.0 {\n      sign\n    } else if a == 1.0 / 0.0 {\n      sign | 0x7F80\n    } else {\n      let e = exponent(a)\n      if e < -126 {\n        # below the normal range: no hidden bit, the significand counts\n        # quanta of 2^-133\n        sign | to_int(a / pow2(-133))\n      } else if e > 127 {\n        sign | 0x7F80\n      } else {\n        sign | ((e + 127) << 7) | to_int((a / pow2(e) - 1.0) * 128.0)\n      }\n    }\n  }\n\n## The 16-bit pattern of the IEEE binary16 value `x`: the sign bit, five\n## exponent bits biased by 15, ten significand bits, as the value sits in\n## memory. The bfloat16 function's shape at binary16's widths, and the same\n## contract: `x` is a value of the format, as [`round_f16`] leaves it, and a\n## Float off the binary16 grid answers the pattern with the extra\n## significand bits dropped rather than the nearest binary16. A value beyond\n## the format's range answers the infinity of its sign; NaN answers the\n## canonical quiet NaN `0x7E00`.\n##\n## The subnormal arm counts quanta of 2^-24, which is binary16's least\n## positive value, where bfloat16 counts 2^-133; the two formats differ in\n## every constant here and in nothing else.\npub fn f16_bits(x: Float) -> Int =\n  if x != x {\n    0x7E00\n  } else {\n    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)\n    let sign = if neg { 0x8000 } else { 0 }\n    let a = if neg { -x } else { x }\n    if a == 0.0 {\n      sign\n    } else if a == 1.0 / 0.0 {\n      sign | 0x7C00\n    } else {\n      let e = exponent(a)\n      if e < -14 {\n        # below the normal range: no hidden bit, the significand counts\n        # quanta of 2^-24\n        sign | to_int(a / pow2(-24))\n      } else if e > 15 {\n        sign | 0x7C00\n      } else {\n        sign | ((e + 15) << 10) | to_int((a / pow2(e) - 1.0) * 1024.0)\n      }\n    }\n  }\n\n## The IEEE binary16 value whose 16-bit pattern is the low 16 bits of `bits`,\n## exactly, as a Float (every binary16 value is one). An exponent field of\n## all ones is the infinity of the sign when the significand field is zero\n## and NaN otherwise; an exponent field of zero is a subnormal, or the zero\n## of the sign.\npub fn f16_of_bits(bits: Int) -> Float = {\n  let b = bits & 0xFFFF\n  let neg = (b & 0x8000) != 0\n  let e = (b >>> 10) & 0x1F\n  let m = b & 0x3FF\n  let a = if e == 0x1F {\n    if m == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }\n  } else if e == 0 {\n    to_float(m) * pow2(-24)\n  } else {\n    (1.0 + to_float(m) / 1024.0) * pow2(e - 15)\n  }\n  if neg { -a } else { a }\n}\n\n## The bfloat16 value whose 16-bit pattern is the low 16 bits of `bits`,\n## exactly, as a Float (every bf16 value is one). An exponent field of all\n## ones is the infinity of the sign when the significand field is zero and\n## NaN otherwise; an exponent field of zero is a subnormal, or the zero of\n## the sign.\npub fn bf16_of_bits(bits: Int) -> Float = {\n  let b = bits & 0xFFFF\n  let neg = (b & 0x8000) != 0\n  let e = (b >>> 7) & 0xFF\n  let m = b & 0x7F\n  let a = if e == 0xFF {\n    if m == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }\n  } else if e == 0 {\n    to_float(m) * pow2(-133)\n  } else {\n    (1.0 + to_float(m) / 128.0) * pow2(e - 127)\n  }\n  if neg { -a } else { a }\n}\n\n## The 32-bit pattern of the binary32 value `x`: the sign bit, eight\n## exponent bits biased by 127, twenty-three significand bits. The bfloat16\n## function's shape at binary32's widths and the same contract: `x` is a\n## value of the format, as [`round_f32`] leaves it, and a Float off the grid\n## answers the pattern with the extra bits dropped rather than the nearest\n## binary32.\n##\n## This is the codec the module's header said would arrive \"when something\n## needs it\". [`tf32_bits`] is what needs it: TensorFloat-32 lives in a\n## binary32 word.\npub fn f32_bits(x: Float) -> Int =\n  if x != x {\n    0x7FC00000\n  } else {\n    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)\n    let sign = if neg { 0x80000000 } else { 0 }\n    let a = if neg { -x } else { x }\n    if a == 0.0 {\n      sign\n    } else if a == 1.0 / 0.0 {\n      sign | 0x7F800000\n    } else {\n      let e = exponent(a)\n      if e < -126 {\n        # below the normal range: no hidden bit, the significand counts\n        # quanta of 2^-149\n        sign | to_int(a / pow2(-149))\n      } else if e > 127 {\n        sign | 0x7F800000\n      } else {\n        sign | ((e + 127) << 23) | to_int((a / pow2(e) - 1.0) * pow2(23))\n      }\n    }\n  }\n\n## The binary32 value whose 32-bit pattern is the low 32 bits of `bits`,\n## exactly, as a Float (every binary32 value is one).\npub fn f32_of_bits(bits: Int) -> Float = {\n  let b = bits & 0xFFFFFFFF\n  let neg = (b & 0x80000000) != 0\n  let e = (b >>> 23) & 0xFF\n  let m = b & 0x7FFFFF\n  let a = if e == 0xFF {\n    if m == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }\n  } else if e == 0 {\n    to_float(m) * pow2(-149)\n  } else {\n    (1.0 + to_float(m) / pow2(23)) * pow2(e - 127)\n  }\n  if neg { -a } else { a }\n}\n\n## The 64-bit pattern of the binary64 value `x`, in an `Int` (the top bit is\n## the sign, so a negative value answers a negative `Int`): the sign bit,\n## eleven exponent bits biased by 1023, fifty-two significand bits. Every\n## `Float` is a binary64 value, so there is no off-the-grid case. The pattern\n## is the raw one: a NaN keeps its payload and its sign (what a NaN computed\n## as `0.0 / 0.0` carries is the host's, so this module's tests do not pin it).\npub fn f64_bits(x: Float) -> Int = float_to_bits(x)\n\n## The binary64 value whose 64-bit pattern is `bits`, exactly, a NaN's payload\n## included (the inverse of [`f64_bits`] on every pattern).\npub fn f64_of_bits(bits: Int) -> Float = float_of_bits(bits)\n\n## The 32-bit pattern of the TensorFloat-32 value `x`: a binary32 word whose\n## bottom THIRTEEN bits are zero. tf32 is nineteen bits of information (a\n## sign, binary32's eight exponent bits and ten significand bits) and the\n## hardware keeps it in a 32-bit slot, so a tf32 buffer is a buffer of\n## 32-bit words and this is how one is laid out. `x` is a value of the\n## format, as [`round_tf32`] leaves it.\npub fn tf32_bits(x: Float) -> Int = f32_bits(x) & 0xFFFFE000\n\n## The TensorFloat-32 value whose 32-bit pattern is the low 32 bits of\n## `bits`. The bottom thirteen bits are not part of the format and are\n## ignored, so this is total on every word and `tf32_of_bits(tf32_bits(v))`\n## is `v` for every value of the format.\npub fn tf32_of_bits(bits: Int) -> Float = f32_of_bits(bits & 0xFFFFE000)\n\n## The octet of the f8E5M2 value `x`: the sign bit, five exponent bits\n## biased by 15, two significand bits. The binary16 function's shape at\n## eight bits; the subnormal arm counts quanta of 2^-16 and the canonical\n## quiet NaN is `0x7E`.\npub fn f8e5m2_bits(x: Float) -> Int =\n  if x != x {\n    0x7E\n  } else {\n    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)\n    let sign = if neg { 0x80 } else { 0 }\n    let a = if neg { -x } else { x }\n    if a == 0.0 {\n      sign\n    } else if a == 1.0 / 0.0 {\n      sign | 0x7C\n    } else {\n      let e = exponent(a)\n      if e < -14 {\n        sign | to_int(a / pow2(-16))\n      } else if e > 15 {\n        sign | 0x7C\n      } else {\n        sign | ((e + 15) << 2) | to_int((a / pow2(e) - 1.0) * 4.0)\n      }\n    }\n  }\n\n## The f8E5M2 value whose octet is the low eight bits of `bits`, exactly.\npub fn f8e5m2_of_bits(bits: Int) -> Float = {\n  let b = bits & 0xFF\n  let neg = (b & 0x80) != 0\n  let e = (b >>> 2) & 0x1F\n  let m = b & 0x3\n  let a = if e == 0x1F {\n    if m == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }\n  } else if e == 0 {\n    to_float(m) * pow2(-16)\n  } else {\n    (1.0 + to_float(m) / 4.0) * pow2(e - 15)\n  }\n  if neg { -a } else { a }\n}\n\n## The octet of the f8E4M3FN value `x`: the sign bit, four exponent bits\n## biased by 7, three significand bits. The subnormal arm counts quanta of\n## 2^-9.\n##\n## THE ALL-ONES EXPONENT IS A NORMAL EXPONENT here, which is the whole\n## difference from [`f8e5m2_bits`]: `0x7F` and `0xFF` are the format's only\n## two NaN encodings and everything below them is finite, so `0x7E` is 448\n## and not an infinity. A value beyond the range answers the canonical NaN\n## `0x7F`, because there is no infinity to answer with.\npub fn f8e4m3fn_bits(x: Float) -> Int =\n  if x != x {\n    0x7F\n  } else {\n    let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)\n    let sign = if neg { 0x80 } else { 0 }\n    let a = if neg { -x } else { x }\n    if a == 0.0 {\n      sign\n    } else if a > 448.0 {\n      0x7F\n    } else {\n      let e = exponent(a)\n      if e < -6 {\n        sign | to_int(a / pow2(-9))\n      } else {\n        sign | ((e + 7) << 3) | to_int((a / pow2(e) - 1.0) * 8.0)\n      }\n    }\n  }\n\n## The f8E4M3FN value whose octet is the low eight bits of `bits`, exactly.\n## `0x7F` and `0xFF` are NaN and every other octet is a finite value.\npub fn f8e4m3fn_of_bits(bits: Int) -> Float = {\n  let b = bits & 0xFF\n  let neg = (b & 0x80) != 0\n  let e = (b >>> 3) & 0xF\n  let m = b & 0x7\n  if e == 0xF && m == 0x7 {\n    0.0 / 0.0\n  } else {\n    let a = if e == 0 {\n      to_float(m) * pow2(-9)\n    } else {\n      (1.0 + to_float(m) / 8.0) * pow2(e - 7)\n    }\n    if neg { -a } else { a }\n  }\n}\n\n## The NIBBLE of the f4E2M1FN value `x`: the sign bit, two exponent bits\n## biased by 1, one significand bit, in the low four bits of the answer.\n## The value set is small enough to lay out whole, and this does: the\n## magnitude picks one of eight patterns and the sign is the top bit.\n##\n## `x` is a value of the format, as [`round_f4e2m1`] leaves it. Anything else\n## is not on the grid and answers the nibble of the nearest value below it\n## in magnitude, which is what [`f8e8m0_bits`] does with the same problem.\npub fn f4e2m1_bits(x: Float) -> Int = {\n  let neg = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)\n  let a = magnitude(x)\n  let m = if x != x {\n    0\n  } else if a >= 6.0 {\n    7\n  } else if a >= 4.0 {\n    6\n  } else if a >= 3.0 {\n    5\n  } else if a >= 2.0 {\n    4\n  } else if a >= 1.5 {\n    3\n  } else if a >= 1.0 {\n    2\n  } else if a >= 0.5 {\n    1\n  } else {\n    0\n  }\n  if neg { m | 0x8 } else { m }\n}\n\n## The f4E2M1FN value whose nibble is the low four bits of `bits`, exactly.\n## Every one of the sixteen patterns is a finite number, so this is total\n## and has no NaN arm; `0x8` is negative zero.\npub fn f4e2m1_of_bits(bits: Int) -> Float = {\n  let b = bits & 0xF\n  let e = (b >>> 1) & 0x3\n  let m = b & 0x1\n  let a = if e == 0 {\n    to_float(m) * 0.5\n  } else {\n    (1.0 + to_float(m) / 2.0) * pow2(e - 1)\n  }\n  if (b & 0x8) != 0 { -a } else { a }\n}\n\n## The octet of the f8E8M0FNU value `x`: the biased exponent alone, `e + 127`\n## for `x = 2^e`, and `0xFF` for NaN. There is no sign bit and no\n## significand, so an octet is a value and the codec is a shift.\n## `x` is a value of the format, as [`round_f8e8m0`] leaves it; anything else\n## answers NaN rather than the nearest power of two.\npub fn f8e8m0_bits(x: Float) -> Int =\n  if x != x || x <= 0.0 || x == 1.0 / 0.0 {\n    0xFF\n  } else {\n    let e = exponent(x)\n    if e < -127 || e > 127 || x != pow2(e) { 0xFF } else { e + 127 }\n  }\n\n## The f8E8M0FNU value whose octet is the low eight bits of `bits`: `2^(b -\n## 127)`, and NaN for `0xFF`. Every one of the other 255 octets is a\n## distinct positive power of two, so this format has no zero.\npub fn f8e8m0_of_bits(bits: Int) -> Float = {\n  let b = bits & 0xFF\n  if b == 0xFF { 0.0 / 0.0 } else { pow2(b - 127) }\n}\n\n# ---- tests ----\n#\n# Representative cases only. The exact-oracle corpus that pins every path of\n# `round_binary` and every trait operation on both backends, boundaries and\n# random bit patterns alike, is scripts/spike-native/narrow_round.dawn, which\n# scripts/narrow-contract generates from a rational oracle.\n\ntest \"rounding breaks ties to even and rounds away otherwise\" {\n  # NearestEven is the default mode, so naming it changes nothing\n  assert round_f32(1.0 + 1.0 / 16777216.0, mode: NearestEven) == round_f32(1.0 + 1.0 / 16777216.0)\n  assert round_binary(1.0 + 3.0 / 256.0, 8, -126, 127, mode: NearestEven) == 1.0 + 1.0 / 64.0\n  # 1 + 2^-8 sits exactly between 1 and 1 + 2^-7 in bf16; the even one wins\n  assert round_bf16(1.0 + 1.0 / 256.0) == 1.0\n  # 1 + 3 * 2^-8 sits between 1 + 2^-7 and 1 + 2^-6; even is the upper one\n  assert round_bf16(1.0 + 3.0 / 256.0) == 1.0 + 1.0 / 64.0\n  # just above the midpoint rounds up, just below rounds down\n  assert round_bf16(1.0 + 3.0 / 512.0) == 1.0 + 1.0 / 128.0\n  assert round_bf16(1.0 + 1.0 / 512.0) == 1.0\n  # the same tie in the two other formats, at their own last places\n  assert round_f16(1.0 + 1.0 / 2048.0) == 1.0\n  assert round_f32(1.0 + 1.0 / 16777216.0) == 1.0\n}\n\ntest \"rounding overflows to infinity and keeps the largest finite value\" {\n  let inf = 1.0 / 0.0\n  # bf16 max finite is (2 - 2^-7) * 2^127\n  assert round_bf16(3.3895313892515355e38) == 3.3895313892515355e38\n  assert round_bf16(3.4e38) == inf\n  assert round_bf16(-3.4e38) == -inf\n  # f16 max finite is 65504; 65520 is the midpoint above it and rounds even,\n  # which is the carry out of the top exponent, so infinity\n  assert round_f16(65504.0) == 65504.0\n  assert round_f16(65519.0) == 65504.0\n  assert round_f16(65520.0) == inf\n  # f32 max finite\n  assert round_f32(3.4028234663852886e38) == 3.4028234663852886e38\n  assert round_f32(3.4028235677973366e38) == inf\n  # the non-finite values pass through\n  assert round_bf16(inf) == inf\n  assert round_f16(-inf) == -inf\n  let nan = round_f32(0.0 / 0.0)\n  assert nan != nan\n}\n\ntest \"rounding lands tiny values on the subnormal grid\" {\n  # the bf16 subnormal quantum is 2^-133; 1e-40 is 1.09 quanta, so one\n  assert round_bf16(1.0e-40) == 9.183549615799121e-41\n  # the smallest bf16 subnormal, and half of it, which is a tie down to zero\n  assert round_bf16(9.183549615799121e-41) == 9.183549615799121e-41\n  assert round_bf16(4.591774807899561e-41) == 0.0\n  # a negative underflow is the negative zero\n  assert 1.0 / round_bf16(-4.591774807899561e-41) == -1.0 / 0.0\n  # f16: quantum 2^-24, so 1e-7 (1.68 quanta) rounds to two of them\n  assert round_f16(1.0e-7) == 1.1920928955078125e-7\n  # f32: the smallest subnormal is 2^-149\n  assert round_f32(1.401298464324817e-45) == 1.401298464324817e-45\n  assert round_f32(1.0e-46) == 0.0\n  # a Float subnormal is far below every grid here\n  assert round_bf16(5.0e-324) == 0.0\n  assert round_f32(5.0e-324) == 0.0\n}\n\ntest \"the operators are the named members, and remainder is exact\" {\n  let one = bf16(1.0)\n  let half_ulp = bf16(1.0 / 256.0)\n  # 1 + 2^-8 is the bf16 tie from the first test: `+` rounds it, to even\n  assert to_f64(one + half_ulp) == 1.0\n  assert one + half_ulp == add(one, half_ulp)\n  assert to_f64(one - half_ulp) == round_bf16(1.0 - 1.0 / 256.0)\n  assert f16(3.0) * f16(1.0 / 3.0) == mul(f16(3.0), f16(1.0 / 3.0))\n  assert to_f64(f32(1.0) / f32(3.0)) == round_f32(1.0 / 3.0)\n  assert to_f64(-bf16(1.5)) == -1.5\n  # a negative zero survives negation, as the format's own does\n  assert 1.0 / to_f64(-bf16(0.0)) == -1.0 / 0.0\n  # 7 % 2.5 is 2 exactly, and so is 1e10 % 3, whose answer 1 lies far below\n  # the last place of 1e10 in binary32 (1024)\n  assert to_f64(bf16(7.0) % bf16(2.5)) == 2.0\n  assert to_f64(f32(1.0e10) % f32(3.0)) == 1.0\n  assert to_f64(f16(-7.0) % f16(2.0)) == -1.0\n}\n\ntest \"directed rounding takes the neighbour on the named side\" {\n  let inf = 1.0 / 0.0\n  # 1 + 2^-8 lies strictly between 1 and 1 + 2^-7 in bf16, so the three\n  # modes disagree with each other and with the tie-to-even answer above\n  let between = 1.0 + 1.0 / 256.0\n  assert round_binary(between, 8, -126, 127, mode: TowardZero) == 1.0\n  assert round_binary(between, 8, -126, 127, mode: Down) == 1.0\n  assert round_binary(between, 8, -126, 127, mode: Up) == 1.0 + 1.0 / 128.0\n  # the same value negated: `TowardZero` and `Up` now name the same\n  # neighbour and `Down` names the other one\n  assert round_binary(-between, 8, -126, 127, mode: TowardZero) == -1.0\n  assert round_binary(-between, 8, -126, 127, mode: Up) == -1.0\n  assert round_binary(-between, 8, -126, 127, mode: Down) == -(1.0 + 1.0 / 128.0)\n  # a value already on the grid does not move, in any mode or sign\n  assert round_binary(1.0 + 1.0 / 128.0, 8, -126, 127, mode: TowardZero) == 1.0 + 1.0 / 128.0\n  assert round_binary(-1.0, 8, -126, 127, mode: Down) == -1.0\n  assert round_f32(0.5, mode: Up) == 0.5\n  # binary32, where the last place is 2^-24 at 1: a third of it up and down\n  assert round_f32(1.0 + 1.0 / 50331648.0, mode: Up) == 1.0 + 1.0 / 8388608.0\n  assert round_f32(1.0 + 1.0 / 50331648.0, mode: Down) == 1.0\n  # subnormals: the f32 quantum below 2^-126 is 2^-149, and 1.5 quanta\n  # goes to one or to two depending on the side\n  let subnormal = 1.5 * 1.401298464324817e-45\n  assert round_f32(subnormal, mode: TowardZero) == 1.401298464324817e-45\n  assert round_f32(subnormal, mode: Up) == 2.802596928649634e-45\n  assert round_f32(-subnormal, mode: Down) == -2.802596928649634e-45\n  # under the smallest subnormal, one side is zero and the other is it\n  assert round_f32(1.0e-46, mode: TowardZero) == 0.0\n  assert round_f32(1.0e-46, mode: Up) == 1.401298464324817e-45\n  # OVERFLOW is the one place these differ from round_binary in kind:\n  # towards the sign it is the infinity, away from it the largest finite\n  assert round_f32(1.0e39, mode: Up) == inf\n  assert round_f32(1.0e39, mode: TowardZero) == 3.4028234663852886e38\n  assert round_f32(1.0e39, mode: Down) == 3.4028234663852886e38\n  assert round_f32(-1.0e39, mode: Down) == -inf\n  assert round_f32(-1.0e39, mode: TowardZero) == -3.4028234663852886e38\n  assert round_f32(-1.0e39, mode: Up) == -3.4028234663852886e38\n  # the non-finite values pass through, as they do for round_binary\n  assert round_f32(inf, mode: TowardZero) == inf\n  assert round_f32(-inf, mode: Up) == -inf\n  let nan = round_f32(0.0 / 0.0, mode: Down)\n  assert nan != nan\n  assert round_f32(0.0, mode: Up) == 0.0\n  assert 1.0 / round_f32(-0.0, mode: Up) == -inf\n}\n\ntest \"ties away from zero move a tie up in magnitude and leave everything else to round_binary\" {\n  let inf = 1.0 / 0.0\n  # tf32's last place at 1 is 2^-10, so 1 + 2^-11 is exactly halfway between\n  # 1 (even) and 1 + 2^-10 (odd): the two rules disagree, in both signs\n  let tie = 1.0 + 1.0 / 2048.0\n  assert round_tf32(tie) == 1.0\n  assert round_tf32(tie, mode: NearestAway) == 1.0 + 1.0 / 1024.0\n  assert round_tf32(-tie) == -1.0\n  assert round_tf32(-tie, mode: NearestAway) == -(1.0 + 1.0 / 1024.0)\n  # a tie whose lower neighbour is ODD goes up under both rules\n  let odd_tie = 1.0 + 3.0 / 2048.0\n  assert round_tf32(odd_tie) == 1.0 + 1.0 / 512.0\n  assert round_tf32(odd_tie, mode: NearestAway) == 1.0 + 1.0 / 512.0\n  # off a tie the two agree, on either side of it\n  assert round_tf32(tie + 1.0 / 1048576.0, mode: NearestAway) == round_tf32(tie + 1.0 / 1048576.0)\n  assert round_tf32(tie - 1.0 / 1048576.0, mode: NearestAway) == 1.0\n  # the general function, at bfloat16's eight bits: 1 + 2^-8 is a tie there\n  assert round_binary(1.0 + 1.0 / 256.0, 8, -126, 127, mode: NearestAway) == 1.0 + 1.0 / 128.0\n  assert round_binary(1.0 + 1.0 / 256.0, 8, -126, 127) == 1.0\n  # a tie on the subnormal grid: tf32's quantum below 2^-126 is 2^-136, and\n  # half of it rounds to it under ties-away and to zero under ties-to-even\n  let q = 1.401298464324817e-45 * 8192.0\n  assert round_tf32(q / 2.0, mode: NearestAway) == q\n  assert round_tf32(q / 2.0) == 0.0\n  # the largest binary32 value is past tf32's last midpoint, so it\n  # overflows under both rules\n  assert round_tf32(3.4028234663852886e38, mode: NearestAway) == inf\n  assert round_tf32(3.4028234663852886e38) == inf\n  # the non-finite values and the zeros pass through\n  assert round_tf32(inf, mode: NearestAway) == inf\n  assert round_tf32(-inf, mode: NearestAway) == -inf\n  let nan = round_tf32(0.0 / 0.0, mode: NearestAway)\n  assert nan != nan\n  assert 1.0 / round_tf32(-0.0, mode: NearestAway) == -inf\n}\n\ntest \"the trait operations are the format's, with the theorem's rounding\" {\n  # bf16 cannot hold 1 + 2^-8: the sum of two exact operands ties to even\n  let one = bf16(1.0)\n  let tiny = bf16(1.0 / 256.0)\n  assert to_f64(add(one, tiny)) == 1.0\n  assert to_f64(add(bf16(1.0 + 1.0 / 128.0), tiny)) == 1.0 + 1.0 / 64.0\n  # 0.1 is not a bf16; the constructor rounds and the value is closed\n  assert to_f64(bf16(0.1)) == 0.10009765625\n  assert to_f64(mul(bf16(0.1), bf16(3.0))) == round_bf16(0.10009765625 * 3.0)\n  # division and square root round the same way\n  assert to_f64(div(bf16(1.0), bf16(3.0))) == 0.333984375\n  assert to_f64(sqrt(bf16(2.0))) == 1.4140625\n  assert to_f64(sqrt(f16(2.0))) == 1.4140625\n  assert to_f64(sqrt(f32(2.0))) == 1.4142135381698608\n  # overflow is the infinity, underflow the zero of the sign\n  let inf = 1.0 / 0.0\n  assert to_f64(mul(bf16(3.0e38), bf16(2.0))) == inf\n  assert to_f64(div(f16(1.0), f16(0.0))) == inf\n  assert 1.0 / to_f64(mul(f16(-1.0e-7), f16(0.25))) == -inf\n  # the exact operations\n  assert to_f64(neg(bf16(1.5))) == -1.5\n  assert to_f64(abs(bf16(-1.5))) == 1.5\n  assert 1.0 / to_f64(abs(bf16(-0.0))) == inf\n  assert to_f64(sub(f32(1.0), f32(1.0e-8))) == 1.0\n  # equality and order are the Float's\n  assert bf16(1.0) == bf16(1.0 + 1.0 / 512.0)\n  assert bf16(1.0) < bf16(1.01)\n}\n\ntest \"every bf16 bit pattern round-trips through its value, and the value is on round_bf16's grid\" {\n  # 65536 patterns: every one that is not a NaN comes back as itself, and\n  # `round_bf16` leaves its value alone, so the codec's grid is the\n  # rounding's grid. The 254 NaN patterns (exponent all ones, significand\n  # nonzero, either sign) decode to a NaN and re-encode to the canonical one.\n  var bad = 0\n  var nans = 0\n  var b = 0\n  while b < 65536 {\n    let v = bf16_of_bits(b)\n    if v != v {\n      nans = nans + 1\n      if bf16_bits(v) != 0x7FC0 { bad = bad + 1 } else { () }\n    } else if bf16_bits(v) != b || round_bf16(v) != v {\n      bad = bad + 1\n    } else {\n      ()\n    }\n    b = b + 1\n  }\n  assert bad == 0\n  assert nans == 254\n}\n\ntest \"every f16 bit pattern round-trips through its value, and the value is on round_f16's grid\" {\n  # The bf16 exhaustive check at binary16's widths. 2046 NaN patterns here\n  # against bf16's 254: binary16 has a ten-bit significand under an\n  # all-ones exponent, and both signs.\n  var bad = 0\n  var nans = 0\n  var b = 0\n  while b < 65536 {\n    let v = f16_of_bits(b)\n    if v != v {\n      nans = nans + 1\n      if f16_bits(v) != 0x7E00 { bad = bad + 1 } else { () }\n    } else if f16_bits(v) != b || round_f16(v) != v {\n      bad = bad + 1\n    } else {\n      ()\n    }\n    b = b + 1\n  }\n  assert bad == 0\n  assert nans == 2046\n}\n\ntest \"the f16 codec spells the special values and the named boundaries\" {\n  let inf = 1.0 / 0.0\n  assert f16_bits(1.0) == 0x3C00\n  assert f16_bits(-1.5) == 0xBE00\n  assert f16_bits(0.0) == 0x0000\n  # the negative zero keeps its sign, both ways\n  assert f16_bits(0.0 * (0.0 - 1.0)) == 0x8000\n  assert 1.0 / f16_of_bits(0x8000) == -inf\n  assert f16_bits(inf) == 0x7C00\n  assert f16_bits(-inf) == 0xFC00\n  assert f16_of_bits(0x7C00) == inf\n  let nan = f16_of_bits(0x7C01)\n  assert nan != nan\n  assert f16_bits(0.0 / 0.0) == 0x7E00\n  # the smallest subnormal (2^-24), the largest subnormal, the smallest normal\n  assert f16_of_bits(0x0001) == 5.960464477539063e-8\n  assert f16_bits(5.960464477539063e-8) == 0x0001\n  assert f16_of_bits(0x03FF) == 1023.0 * 5.960464477539063e-8\n  assert f16_of_bits(0x0400) == 0.00006103515625\n  # the largest finite value\n  assert f16_of_bits(0x7BFF) == 65504.0\n  assert f16_bits(65504.0) == 0x7BFF\n  # off the grid: the bits truncate, the rounding does not; a value past the\n  # range is the infinity\n  assert f16_bits(1.0 + 3.0 / 4096.0) == 0x3C00\n  assert f16_bits(round_f16(1.0 + 3.0 / 4096.0)) == 0x3C01\n  assert f16_bits(1.0e300) == 0x7C00\n  # bits above the sixteenth are ignored\n  assert f16_of_bits(0x13C00) == 1.0\n}\n\ntest \"the bf16 codec spells the special values and the named boundaries\" {\n  let inf = 1.0 / 0.0\n  assert bf16_bits(1.0) == 0x3F80\n  assert bf16_bits(-1.5) == 0xBFC0\n  assert bf16_bits(0.0) == 0x0000\n  # the negative zero keeps its sign, both ways\n  assert bf16_bits(0.0 * (0.0 - 1.0)) == 0x8000\n  assert 1.0 / bf16_of_bits(0x8000) == -inf\n  assert bf16_bits(inf) == 0x7F80\n  assert bf16_bits(-inf) == 0xFF80\n  assert bf16_of_bits(0x7F80) == inf\n  let nan = bf16_of_bits(0x7F81)\n  assert nan != nan\n  assert bf16_bits(0.0 / 0.0) == 0x7FC0\n  # the smallest subnormal, the largest subnormal, the smallest normal\n  assert bf16_of_bits(0x0001) == 9.183549615799121e-41\n  assert bf16_bits(9.183549615799121e-41) == 0x0001\n  assert bf16_of_bits(0x007F) == 127.0 * 9.183549615799121e-41\n  assert bf16_of_bits(0x0080) == 1.1754943508222875e-38\n  # the largest finite value\n  assert bf16_of_bits(0x7F7F) == 3.3895313892515355e38\n  assert bf16_bits(3.3895313892515355e38) == 0x7F7F\n  # off the grid: the bits truncate, the rounding does not; a value past the\n  # range is the infinity\n  assert bf16_bits(1.0 + 3.0 / 512.0) == 0x3F80\n  assert bf16_bits(round_bf16(1.0 + 3.0 / 512.0)) == 0x3F81\n  assert bf16_bits(1.0e300) == 0x7F80\n  # bits above the sixteenth are ignored\n  assert bf16_of_bits(0x13F80) == 1.0\n}\n\n# ---- the formats knife T3 added ----\n#\n# Four roundings and five codecs, tested at the four places a rounding can\n# be wrong: a tie, the subnormal grid, the largest finite value and NaN.\n# The exhaustive checks are the two eight-bit ones, which are cheap enough\n# to run over every octet and are the only ones here where \"every pattern\"\n# is a small number.\n\ntest \"the tf32 rounding is binary32's exponents with eleven significand bits\" {\n  # 1 + 2^-11 is the midpoint between 1 and 1 + 2^-10; the even one wins\n  assert round_tf32(1.0 + 1.0 / 2048.0) == 1.0\n  assert round_tf32(1.0 + 3.0 / 2048.0) == 1.0 + 1.0 / 512.0\n  # just off the midpoint, both ways\n  assert round_tf32(1.0 + 3.0 / 4096.0) == 1.0 + 1.0 / 1024.0\n  assert round_tf32(1.0 + 1.0 / 4096.0) == 1.0\n  # binary32 keeps the whole of a value tf32 cuts: the two differ on\n  # anything with more than eleven significand bits\n  assert round_f32(1.0 + 1.0 / 4096.0) == 1.0 + 1.0 / 4096.0\n  # the exponent range is binary32's, so the largest finite value has\n  # binary32's exponent and tf32's significand\n  let max_tf32 = (2.0 - pow2(-10)) * pow2(127)\n  assert round_tf32(max_tf32) == max_tf32\n  assert round_f32(max_tf32) == max_tf32\n  # the midpoint above it carries out of the top exponent, so it is the\n  # infinity, exactly as binary16's 65520 is\n  assert round_tf32((2.0 - pow2(-11)) * pow2(127)) == 1.0 / 0.0\n  assert round_tf32(-3.5e38) == 0.0 - 1.0 / 0.0\n  # the subnormal grid is 2^(-126 - 10) = 2^-136\n  assert round_tf32(pow2(-136)) == pow2(-136)\n  assert round_tf32(pow2(-138)) == 0.0\n}\n\ntest \"the tf32 codec is a binary32 word with thirteen zero bits\" {\n  assert tf32_bits(1.0) == 0x3F800000\n  assert tf32_bits(-1.5) == 0xBFC00000\n  assert tf32_bits(0.0) == 0\n  assert tf32_bits(1.0 / 0.0) == 0x7F800000\n  assert tf32_bits(0.0 / 0.0) == 0x7FC00000\n  # the low thirteen bits are not part of the format, in both directions\n  assert tf32_bits(round_tf32(1.0 + 1.0 / 1024.0)) == 0x3F802000\n  assert tf32_of_bits(0x3F802000 | 0x1FFF) == 1.0 + 1.0 / 1024.0\n  # every value of the format round-trips, and it is on round_tf32's grid\n  var bad = 0\n  var b = 0\n  while b < 512 {\n    let word = (b << 23) | ((b % 1024) << 13)\n    let v = tf32_of_bits(word)\n    if v != v {\n      ()\n    } else if tf32_bits(v) != (word & 0xFFFFE000) || round_tf32(v) != v {\n      bad = bad + 1\n    } else {\n      ()\n    }\n    b = b + 1\n  }\n  assert bad == 0\n}\n\ntest \"every f8E5M2 octet round-trips through its value, and the value is on round_f8e5m2's grid\" {\n  var bad = 0\n  var nans = 0\n  var infinities = 0\n  var b = 0\n  while b < 256 {\n    let v = f8e5m2_of_bits(b)\n    if v != v {\n      nans = nans + 1\n      if f8e5m2_bits(v) != 0x7E { bad = bad + 1 } else { () }\n    } else if v - v != 0.0 {\n      # the two infinity octets: the codec keeps them (they are values of\n      # the format) and the conversion never answers one, so they are the\n      # only octets that are not fixed points of `round_f8e5m2`\n      infinities = infinities + 1\n      if f8e5m2_bits(v) != b { bad = bad + 1 } else { () }\n    } else if f8e5m2_bits(v) != b || round_f8e5m2(v) != v {\n      bad = bad + 1\n    } else {\n      ()\n    }\n    b = b + 1\n  }\n  assert bad == 0\n  # exponent all ones, significand nonzero, either sign: 3 + 3\n  assert nans == 6\n  # and the two whose significand is zero\n  assert infinities == 2\n}\n\ntest \"the f8E5M2 rounding and codec spell the named boundaries\" {\n  let inf = 1.0 / 0.0\n  assert f8e5m2_bits(1.0) == 0x3C\n  assert f8e5m2_bits(-1.5) == 0xBE\n  assert f8e5m2_bits(inf) == 0x7C\n  assert f8e5m2_of_bits(0x7C) == inf\n  # the largest finite value is 1.75 * 2^15, and the midpoint above it\n  # carries out of the top exponent\n  assert round_f8e5m2(57344.0) == 57344.0\n  assert round_f8e5m2(61439.0) == 57344.0\n  # and the conversion SATURATES rather than overflowing, although the\n  # format has an infinity and the codec above keeps it (knife TA measured\n  # it on a B200: 1e30, -1e30 and an infinity all answer +/-57344)\n  assert round_f8e5m2(61440.0) == 57344.0\n  assert round_f8e5m2(1.0e30) == 57344.0\n  assert round_f8e5m2(0.0 - 1.0e30) == 0.0 - 57344.0\n  assert round_f8e5m2(inf) == 57344.0\n  assert f8e5m2_of_bits(0x7B) == 57344.0\n  # ties to even at the last place: 1 + 2^-3 sits between 1 and 1 + 2^-2\n  assert round_f8e5m2(1.0 + 1.0 / 8.0) == 1.0\n  assert round_f8e5m2(1.0 + 3.0 / 8.0) == 1.0 + 1.0 / 2.0\n  # the subnormal quantum is 2^-16\n  assert f8e5m2_of_bits(0x01) == pow2(-16)\n  assert round_f8e5m2(pow2(-17)) == 0.0\n  assert round_f8e5m2(pow2(-16) * 1.5) == pow2(-16) * 2.0\n}\n\ntest \"every f8E4M3FN octet round-trips through its value, and the value is on round_f8e4m3fn's grid\" {\n  var bad = 0\n  var nans = 0\n  var b = 0\n  while b < 256 {\n    let v = f8e4m3fn_of_bits(b)\n    if v != v {\n      nans = nans + 1\n      if f8e4m3fn_bits(v) != 0x7F { bad = bad + 1 } else { () }\n    } else if f8e4m3fn_bits(v) != b || round_f8e4m3fn(v) != v {\n      bad = bad + 1\n    } else {\n      ()\n    }\n    b = b + 1\n  }\n  assert bad == 0\n  # FN: the ONLY NaN encodings are 0x7F and 0xFF, and there is no infinity,\n  # where f8E5M2 has three NaNs a sign\n  assert nans == 2\n}\n\ntest \"f8E4M3FN has no infinity, so its overflow is NaN and its largest finite value is 448\" {\n  assert f8e4m3fn_of_bits(0x7E) == 448.0\n  assert f8e4m3fn_bits(448.0) == 0x7E\n  assert round_f8e4m3fn(448.0) == 448.0\n  # 464 is the midpoint between 448 and the 480 an IEEE format of these\n  # widths would have; 448's significand is the even one, so it ties down\n  assert round_f8e4m3fn(464.0) == 448.0\n  # above it the conversion SATURATES; knife TA measured 480, -480 and an\n  # infinity on a B200 and got 448, -448 and 448\n  assert round_f8e4m3fn(465.0) == 448.0\n  assert round_f8e4m3fn(1.0e30) == 448.0\n  assert round_f8e4m3fn(-465.0) == 0.0 - 448.0\n  assert round_f8e4m3fn(1.0 / 0.0) == 448.0\n  let nan = round_f8e4m3fn(0.0 / 0.0)\n  assert nan != nan\n  # ties to even at the last place, and the subnormal quantum 2^-9\n  assert round_f8e4m3fn(1.0 + 1.0 / 16.0) == 1.0\n  assert round_f8e4m3fn(1.0 + 3.0 / 16.0) == 1.0 + 1.0 / 4.0\n  assert f8e4m3fn_of_bits(0x01) == pow2(-9)\n  assert round_f8e4m3fn(pow2(-10)) == 0.0\n  assert round_f8e4m3fn(pow2(-9) * 1.5) == pow2(-9) * 2.0\n}\n\ntest \"f8E8M0FNU is the exponent alone, rounded toward zero\" {\n  # the conversion takes the MAGNITUDE and clamps into the range; only NaN\n  # answers NaN (knife TA measured all four of these on a B200)\n  assert round_f8e8m0(0.0) == pow2(-127)\n  assert round_f8e8m0(-1.0) == 1.0\n  assert round_f8e8m0(-3.0) == 2.0\n  assert round_f8e8m0(1.0 / 0.0) == pow2(127)\n  let nan = round_f8e8m0(0.0 / 0.0)\n  assert nan != nan\n  # rounding toward zero is the largest power of two at or below x: 1.99\n  # answers 1 and not 2, which is where this differs from every other\n  # rounding in this module\n  assert round_f8e8m0(1.99) == 1.0\n  assert round_f8e8m0(2.0) == 2.0\n  assert round_f8e8m0(0.75) == 0.5\n  # the ends: 2^127 is the largest, 2^-127 the smallest, and there is\n  # nothing below it to round down to, so a smaller value clamps up\n  assert round_f8e8m0(pow2(127)) == pow2(127)\n  assert round_f8e8m0(pow2(128)) == pow2(127)\n  assert round_f8e8m0(pow2(-127)) == pow2(-127)\n  assert round_f8e8m0(pow2(-200)) == pow2(-127)\n  # every octet is a value and every value an octet; 0xFF alone is NaN\n  var bad = 0\n  var b = 0\n  while b < 256 {\n    let v = f8e8m0_of_bits(b)\n    if v != v {\n      if b != 0xFF { bad = bad + 1 } else { () }\n    } else if f8e8m0_bits(v) != b || round_f8e8m0(v) != v {\n      bad = bad + 1\n    } else {\n      ()\n    }\n    b = b + 1\n  }\n  assert bad == 0\n  assert f8e8m0_bits(1.0) == 127\n  assert f8e8m0_bits(0.0 / 0.0) == 0xFF\n  # a value off the grid is not a value of the format, and the codec says\n  # so rather than snapping it to a neighbour\n  assert f8e8m0_bits(1.5) == 0xFF\n}\n\ntest \"the binary32 codec spells the special values and the named boundaries\" {\n  let inf = 1.0 / 0.0\n  assert f32_bits(1.0) == 0x3F800000\n  assert f32_bits(-1.5) == 0xBFC00000\n  assert f32_bits(0.0) == 0\n  assert f32_bits(0.0 * (0.0 - 1.0)) == 0x80000000\n  assert 1.0 / f32_of_bits(0x80000000) == -inf\n  assert f32_bits(inf) == 0x7F800000\n  assert f32_bits(-inf) == 0xFF800000\n  assert f32_bits(0.0 / 0.0) == 0x7FC00000\n  let nan = f32_of_bits(0x7F800001)\n  assert nan != nan\n  # the smallest subnormal (2^-149), the smallest normal, the largest finite\n  assert f32_of_bits(0x00000001) == pow2(-149)\n  assert f32_bits(pow2(-149)) == 0x00000001\n  assert f32_of_bits(0x00800000) == pow2(-126)\n  assert f32_of_bits(0x7F7FFFFF) == 3.4028234663852886e38\n  assert f32_bits(3.4028234663852886e38) == 0x7F7FFFFF\n  # off the grid the bits truncate, as bf16_bits and f16_bits do\n  assert f32_bits(1.0 + pow2(-30)) == 0x3F800000\n}\n\ntest \"the sixteen f4E2M1FN nibbles are sixteen finite values, and the codec is a bijection\" {\n  var seen: List[Float] = []\n  var bad = 0\n  var b = 0\n  while b < 16 {\n    let v = f4e2m1_of_bits(b)\n    if v != v || f4e2m1_bits(v) != b || round_f4e2m1(v) != v {\n      bad = bad + 1\n    } else {\n      ()\n    }\n    seen = seen ++ [v]\n    b = b + 1\n  }\n  assert bad == 0\n  # 0x0 and 0x8 are the two zeros, so fifteen distinct Floats\n  assert seen == [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,\n    -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0]\n}\n\ntest \"f4E2M1FN rounds to nearest even, saturates instead of overflowing, and sends NaN to zero\" {\n  # Types.td's own example: 0.5 is 0001 and 1.5 is 0011\n  assert f4e2m1_bits(0.5) == 0x1\n  assert f4e2m1_bits(1.5) == 0x3\n  # ties to even on the two grids: 0.25 is between 0 and 0.5, 1.25 between 1 and 1.5\n  assert round_f4e2m1(0.25) == 0.0\n  assert round_f4e2m1(0.75) == 1.0\n  assert round_f4e2m1(1.25) == 1.0\n  assert round_f4e2m1(1.75) == 2.0\n  assert round_f4e2m1(2.5) == 2.0\n  assert round_f4e2m1(3.5) == 4.0\n  assert round_f4e2m1(5.0) == 4.0\n  assert round_f4e2m1(5.5) == 6.0\n  # saturation, the first of the two choices this format leaves open\n  assert round_f4e2m1(6.5) == 6.0\n  assert round_f4e2m1(1.0e30) == 6.0\n  assert round_f4e2m1(0.0 - 1.0e30) == -6.0\n  assert round_f4e2m1(1.0 / 0.0) == 6.0\n  # NaN, the second\n  assert round_f4e2m1(0.0 / 0.0) == 0.0\n  # the subnormal grid is 0.5 and nothing lives under it\n  assert round_f4e2m1(0.2) == 0.0\n  assert round_f4e2m1(0.3) == 0.5\n}\n\ntest \"every narrow format is a device format, named as the dialect names it, by witness and by type\" {\n  assert dtype_name(BF16) == \"bf16\"\n  assert dtype_name(F16) == \"f16\"\n  assert dtype_name(F32) == \"f32\"\n  assert dtype_name(TF32) == \"tf32\"\n  assert dtype_name(F8E4M3FN) == \"f8E4M3FN\"\n  assert dtype_name(F8E5M2) == \"f8E5M2\"\n  assert dtype_name(F8E8M0FNU) == \"f8E8M0FNU\"\n  assert dtype_name(F4E2M1FN) == \"f4E2M1FN\"\n  let by_type: Dtype[F16] = dtype_of()\n  assert dtype_name(by_type) == \"f16\"\n  let again: Dtype[BF16] = dtype_of()\n  assert dtype_name(again) == dtype_name(BF16)\n}\n\ntest \"a storage-only value shows as the Float it holds, and a literal at one is the nearest value (compile-time fold)\" {\n  # inside this module a literal at an own type is the unrounded Float (D7), so\n  # the values are made with the rounding functions; the literal rule itself\n  # is held by the impls' bodies, which are those functions\n  let a: TF32 = round_tf32(1.0000001)\n  assert show(a) == \"1.0\"\n  let b: F8E4M3FN = round_f8e4m3fn(0.3)\n  assert show(b) == \"0.3125\"\n  let c: F8E5M2 = round_f8e5m2(0.3)\n  assert show(c) == \"0.3125\"\n  let d: F8E8M0FNU = round_f8e8m0(3.0)\n  assert show(d) == \"2.0\"\n  let e: F4E2M1FN = round_f4e2m1(2.4)\n  assert show(e) == \"2.0\"\n}\n\ntest \"the binary64 codec spells the special values and the named boundaries, and round trips\" {\n  let inf = 1.0 / 0.0\n  assert f64_bits(1.0) == 0x3FF0000000000000\n  assert f64_bits(-2.0) == (1 << 63) | 0x4000000000000000\n  assert f64_bits(0.0) == 0\n  assert f64_bits(0.0 * (0.0 - 1.0)) == 1 << 63\n  assert f64_bits(inf) == 0x7FF0000000000000\n  assert f64_bits(-inf) == (1 << 63) | 0x7FF0000000000000\n  # the sign of a computed NaN is the host's; its exponent and quiet bit are not\n  assert (f64_bits(0.0 / 0.0) & 0x7FFFFFFFFFFFFFFF) == 0x7FF8000000000000\n  assert f64_bits(pow2(-1074)) == 1\n  assert f64_of_bits(1) == pow2(-1074)\n  assert f64_of_bits(0x0010000000000000) == pow2(-1022)\n  assert f64_of_bits(0x7FEFFFFFFFFFFFFF) == 1.7976931348623157e308\n  assert f64_bits(1.7976931348623157e308) == 0x7FEFFFFFFFFFFFFF\n  assert f64_bits(0.1) == 0x3FB999999999999A\n  assert f64_of_bits(0x3FB999999999999A) == 0.1\n  assert 1.0 / f64_of_bits(1 << 63) == -inf\n  let nan = f64_of_bits(0x7FF0000000000001)\n  assert nan != nan\n  # the payload of a NaN survives both ways, which the old arithmetic did not do\n  assert f64_bits(nan) == 0x7FF0000000000001\n  assert f64_bits(f64_of_bits(0x7FF8DEADBEEF1234)) == 0x7FF8DEADBEEF1234\n  assert f64_of_bits(f64_bits(1.5)) == 1.5\n  assert f64_of_bits(f64_bits(-3.25)) == -3.25\n  assert f64_of_bits(f64_bits(123456.789)) == 123456.789\n  assert f64_of_bits(f64_bits(1e-300)) == 1e-300\n  assert f64_of_bits(f64_bits(-1e300)) == -1e300\n  assert f64_of_bits(f64_bits(4.9e-324)) == 4.9e-324\n  assert f64_of_bits(f64_bits(2.2250738585072014e-308)) == 2.2250738585072014e-308\n}\n\ntest \"every narrow device format moves as its pattern, little ends known, high bits ignored\" {\n  # one known pattern per format fixes the width and the layout, so an impl\n  # that truncated, shifted or took the wrong half would not match\n  let bf: BF16 = round_bf16(1.0)\n  assert to_bits(bf) == 0x3F80\n  let hf: F16 = round_f16(1.0)\n  assert to_bits(hf) == 0x3C00\n  let f32: F32 = round_f32(-2.5)\n  assert to_bits(f32) == 0xC0200000\n  let tf: TF32 = round_tf32(1.0)\n  assert to_bits(tf) == 0x3F800000\n  let e4: F8E4M3FN = round_f8e4m3fn(1.0)\n  assert to_bits(e4) == 0x38\n  let e5: F8E5M2 = round_f8e5m2(1.0)\n  assert to_bits(e5) == 0x3C\n  let e8: F8E8M0FNU = round_f8e8m0(1.0)\n  assert to_bits(e8) == 0x7F\n  # a word with bits above the width reads as its low bits\n  let h: BF16 = from_bits(0xABCD0000 | 0x3F80)\n  assert to_bits(h) == 0x3F80\n  let b: F8E5M2 = from_bits(0x1234 << 16 | 0x3C)\n  assert to_bits(b) == 0x3C\n}\n\ntest \"every storage and narrow format round trips over its whole pattern space\" {\n  var i = 0\n  while i < 256 {\n    let e5: F8E5M2 = from_bits(i)\n    let e4: F8E4M3FN = from_bits(i)\n    let e8: F8E8M0FNU = from_bits(i)\n    # NaN has several patterns and answers its canonical one\n    let t5 = to_bits(e5)\n    let t4 = to_bits(e4)\n    let t8 = to_bits(e8)\n    assert t5 == i || (e5 != e5 && t5 == 0x7E)\n    assert t4 == i || (e4 != e4 && t4 == 0x7F)\n    assert t8 == i || (e8 != e8 && t8 == 0xFF)\n    i = i + 1\n  }\n  var w = 0\n  while w < 65536 {\n    let h: F16 = from_bits(w)\n    let g: BF16 = from_bits(w)\n    let th = to_bits(h)\n    let tg = to_bits(g)\n    assert th == w || (h != h && th == 0x7E00)\n    assert tg == w || (g != g && tg == 0x7FC0)\n    w = w + 1\n  }\n  let words = [0, 1, 0x3F800000, 0x80000000, 0x7F800000, 0xFF800000, 0x7F7FFFFF, 0x00800000, 0x00000001, 0xBF99999A]\n  var k = 0\n  while k < len(words) {\n    let x = words[k]\n    let f: F32 = from_bits(x)\n    assert to_bits(f) == x\n    let t: TF32 = from_bits(x & 0xFFFFE000)\n    assert to_bits(t) == x & 0xFFFFE000\n    k = k + 1\n  }\n  let nanf: F32 = from_bits(0x7FC00000)\n  assert nanf != nanf\n}\n")
  } else if name == "int/i8.dawn" {
    Some("## Signed 8-bit integers: `I8`, an opaque type over `Int` holding\n## -128..127, with arithmetic that wraps the way `Int`'s does.\n#\n# GENERATED by scripts/fixed-ints/gen.py -- edit there and rerun it; the\n# tree-policy gate fails on a hand edit here.\n#\n# One of seven sibling modules (std/int/i8, i16, i32, u8, u16, u32, u64) that\n# share one shape; docs/literal-system-design.md D13 is the design and spec\n# 11 the contract. Why they are std and not the compiler's: the compiler owns\n# two numbers, Int and Float (D1), and a fixed-width integer is an Int with\n# an invariant, which is what an opaque type is. Measured before this was\n# written: packages/sha2's compression loop over std/int/u32 runs within 1% of\n# the `Int` + `& MASK` form on both backends.\n#\n# They live under std/int/ so that seven of them do not crowd the top of\n# std; `use` binds a path's last segment, so `use std/int/u32` still\n# qualifies as `u32`.\n#\n# Why one module per width and not one module for all seven: a module is\n# Dawn's namespace, so `u32.wrap(n)`, `u32.rotr(x, 7)` and `u8.wrap(n)` are\n# the same names qualified differently, as `char.code` is for `Char`. One\n# module would need either a width in every name (`wrap_u32`) or a trait\n# whose `to_int` member shadows the builtin `to_int` in every importer, and\n# the constructors could not be trait members anyway, since their subject is\n# only in the return position. A program imports the widths it uses.\n#\n# The Int inside is always in -128..127, so equality, hashing and order\n# are the Int's, inherited (spec 2.7), and correct as they stand: an impl\n# of `Ord` of its own would say the same thing and turn every `<` from a\n# native comparison into a call. Arithmetic is not inherited (an opaque\n# type never inherits it, docs/arith-operator-traits-design.md D4) and is\n# written below: each result is computed in Int and wrapped back by\n# sign-extending its low 8 bits, so `I8.MAX + 1` is `I8.MIN`, as `Int`'s\n# overflow is. `/` and `%` are Int's (truncating, and a zero divisor panics\n# with Int's message); the one quotient out of range, MIN / -1, wraps to MIN.\n#\n# Wrapping and not trapping, as `Int` does (spec 4.3): two overflow rules in\n# one family of types would have every reader looking up which one applies.\n# `checked_add`, `checked_sub` and `checked_mul` answer `None` instead. A\n# literal at `I8` is `FromInt`'s, range-checked at compile time, so\n# `let b: I8 = 128` does not compile (outside this module: inside it the\n# type is seen through and a literal is the Int it always was, literal design\n# D7). The bitwise operations are named functions until the operators have\n# traits of their own; `complement` and not `not`, which is a keyword. A\n# shift or rotation count is taken modulo 8, as the JVM and the hardware do\n# for Int's own shifts.\n#\n# `I8` is also a device format (std/dtype): the constant `I8` below is its\n# witness, spelled like the type so that `use std/int/i8.{I8}` brings in both,\n# and `impl HasDtype[I8]` lets generic code ask for it by type.\n\nuse std/dtype.{DeviceBits, Dtype, HasDtype, to_bits, dtype_name, dtype_from_name, dtype_of, from_bits}\n\n## A signed 8-bit integer.\npub opaque type I8 = Int\n\n## The least `I8`, -128.\npub const MIN: I8 = -128\n\n## The greatest `I8`, 127.\npub const MAX: I8 = 127\n\n## The device format of `I8`: `i8`.\npub const I8: Dtype[I8] = dtype_from_name(\"i8\")\n\nimpl HasDtype[I8] {\n  fn dtype_of() -> Dtype[I8] = I8\n}\n\n# The low bits of the two's complement, read unsigned: what a device buffer\n# holds for this element. Bits above the width are ignored on the way back.\nimpl DeviceBits[I8] {\n  fn to_bits(v: I8) -> Int = to_int(v) & 0xFF\n  fn from_bits(bits: Int) -> I8 = wrap(bits)\n}\n\n## `n` as a `I8`, or `None` when it is outside -128..127.\npub fn of(n: Int) -> Option[I8] = if n < -128 || n > 127 { None } else { Some(n) }\n\n## The `I8` with the low 8 bits of `n`, read as two's complement:\n## `wrap(128)` is -128.\npub fn wrap(n: Int) -> I8 = ((n & 0xFF) ^ 0x80) - 0x80\n\n## The value of `x` as an Int.\npub fn to_int(x: I8) -> Int = x\n\n# The literal's range check, run at compile time for every literal at this\n# type outside this module.\nimpl FromInt[I8] {\n  fn from_int(n: Int) -> I8 = {\n    if n < -128 || n > 127 { panic(\"out of range for I8: \${n}\") }\n    n\n  }\n}\n\nimpl Show[I8] {\n  fn show(x: I8) -> String = {\n    let n: Int = x\n    to_string(n)\n  }\n}\n\nimpl Add[I8] {\n  fn add(a: I8, b: I8) -> I8 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x + y)\n  }\n}\n\nimpl Sub[I8] {\n  fn sub(a: I8, b: I8) -> I8 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x - y)\n  }\n}\n\nimpl Mul[I8] {\n  fn mul(a: I8, b: I8) -> I8 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x * y)\n  }\n}\n\nimpl Div[I8] {\n  fn div(a: I8, b: I8) -> I8 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x / y)\n  }\n}\n\nimpl Rem[I8] {\n  fn rem(a: I8, b: I8) -> I8 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x % y)\n  }\n}\n\nimpl Neg[I8] {\n  fn neg(a: I8) -> I8 = {\n    let x: Int = a\n    wrap(0 - x)\n  }\n}\n\n## `a + b`, or `None` where it wraps.\npub fn checked_add(a: I8, b: I8) -> Option[I8] = {\n  let x: Int = a\n  let y: Int = b\n  let r = x + y\n  if r < -128 || r > 127 { None } else { Some(r) }\n}\n\n## `a - b`, or `None` where it wraps.\npub fn checked_sub(a: I8, b: I8) -> Option[I8] = {\n  let x: Int = a\n  let y: Int = b\n  let r = x - y\n  if r < -128 || r > 127 { None } else { Some(r) }\n}\n\n## `a * b`, or `None` where it wraps.\npub fn checked_mul(a: I8, b: I8) -> Option[I8] = {\n  let x: Int = a\n  let y: Int = b\n  let r = x * y\n  if r < -128 || r > 127 { None } else { Some(r) }\n}\n\n## The bitwise and.\npub fn and(a: I8, b: I8) -> I8 = {\n  let x: Int = a\n  let y: Int = b\n  x & y\n}\n\n## The bitwise or.\npub fn or(a: I8, b: I8) -> I8 = {\n  let x: Int = a\n  let y: Int = b\n  x | y\n}\n\n## The bitwise exclusive or.\npub fn xor(a: I8, b: I8) -> I8 = {\n  let x: Int = a\n  let y: Int = b\n  x ^ y\n}\n\n## Every bit flipped.\npub fn complement(a: I8) -> I8 = {\n  let x: Int = a\n  wrap(~x)\n}\n\n## `a` shifted left by `n` modulo 8 places, zeros in at the bottom.\npub fn shl(a: I8, n: Int) -> I8 = {\n  let x: Int = a\n  wrap(x << (n & 7))\n}\n\n## `a` shifted right by `n` modulo 8 places, copies of the sign bit in at\n## the top (arithmetic, as Int's `>>`).\npub fn shr(a: I8, n: Int) -> I8 = {\n  let x: Int = a\n  x >> (n & 7)\n}\n\n## `a`'s 8 bits rotated left by `n` modulo 8 places.\npub fn rotl(a: I8, n: Int) -> I8 = {\n  let x: Int = a\n  let u = x & 0xFF\n  let k = n & 7\n  wrap((u << k) | (u >>> (8 - k)))\n}\n\n## `a`'s 8 bits rotated right by `n` modulo 8 places.\npub fn rotr(a: I8, n: Int) -> I8 = {\n  let x: Int = a\n  let u = x & 0xFF\n  let k = n & 7\n  wrap((u >>> k) | (u << (8 - k)))\n}\n\ntest \"the witness is the format the dialect names, found by value or by type\" {\n  let by_type: Dtype[I8] = dtype_of()\n  assert dtype_name(I8) == \"i8\"\n  assert dtype_name(by_type) == \"i8\"\n}\n\ntest \"I8 moves as its low bits, unsigned, and reads back from any word\" {\n  assert to_bits(wrap(1)) == 1\n  assert to_bits(MAX) == 0x7F\n  assert to_bits(MIN) == 0x80\n  assert to_bits(wrap(-1)) == 0xFF\n  let m: I8 = from_bits(0xFF)\n  assert m == wrap(-1)\n  assert to_int(from_bits(0xFF + 1)) == 0\n  # the bits above the width are ignored\n  let hi: I8 = from_bits(0x5A5A5A5A5A5A5A5A - (0x5A5A5A5A5A5A5A5A & 0xFF) + 3)\n  assert to_int(hi) == 3\n  var n = 0\n  while n < 300 {\n    let v: I8 = wrap(n * 7919 - 1000)\n    let back: I8 = from_bits(to_bits(v))\n    assert back == v\n    n = n + 1\n  }\n}\n\n# Representative cases; scripts/spike-native/fixed_ints holds the seven types\n# to an oracle computed outside Dawn, on both backends.\n\ntest \"the ends wrap into each other and the conversions agree\" {\n  assert MAX + wrap(1) == MIN\n  assert MIN - wrap(1) == MAX\n  assert to_int(wrap(7) / wrap(2)) == 3\n  assert to_int(wrap(7) % wrap(2)) == 1\n  assert rotl(wrap(1), 8) == wrap(1)\n  assert rotr(wrap(1), 1) == shl(wrap(1), 7)\n  assert checked_add(MAX, wrap(1)) == None\n  assert checked_sub(MIN, wrap(1)) == None\n  assert of(128) == None\n  assert of(-128) == Some(MIN)\n  assert to_int(wrap(128)) == -128\n  assert show(MIN) == \"-128\"\n  # the one quotient out of range wraps, as Int's MIN / -1 does\n  assert MIN / wrap(-1) == MIN\n  assert to_int(shr(MIN, 1)) == -64\n}\n")
  } else if name == "int/i16.dawn" {
    Some("## Signed 16-bit integers: `I16`, an opaque type over `Int` holding\n## -32768..32767, with arithmetic that wraps the way `Int`'s does.\n#\n# GENERATED by scripts/fixed-ints/gen.py -- edit there and rerun it; the\n# tree-policy gate fails on a hand edit here.\n#\n# One of seven sibling modules (std/int/i8, i16, i32, u8, u16, u32, u64) that\n# share one shape; docs/literal-system-design.md D13 is the design and spec\n# 11 the contract. Why they are std and not the compiler's: the compiler owns\n# two numbers, Int and Float (D1), and a fixed-width integer is an Int with\n# an invariant, which is what an opaque type is. Measured before this was\n# written: packages/sha2's compression loop over std/int/u32 runs within 1% of\n# the `Int` + `& MASK` form on both backends.\n#\n# They live under std/int/ so that seven of them do not crowd the top of\n# std; `use` binds a path's last segment, so `use std/int/u32` still\n# qualifies as `u32`.\n#\n# Why one module per width and not one module for all seven: a module is\n# Dawn's namespace, so `u32.wrap(n)`, `u32.rotr(x, 7)` and `u8.wrap(n)` are\n# the same names qualified differently, as `char.code` is for `Char`. One\n# module would need either a width in every name (`wrap_u32`) or a trait\n# whose `to_int` member shadows the builtin `to_int` in every importer, and\n# the constructors could not be trait members anyway, since their subject is\n# only in the return position. A program imports the widths it uses.\n#\n# The Int inside is always in -32768..32767, so equality, hashing and order\n# are the Int's, inherited (spec 2.7), and correct as they stand: an impl\n# of `Ord` of its own would say the same thing and turn every `<` from a\n# native comparison into a call. Arithmetic is not inherited (an opaque\n# type never inherits it, docs/arith-operator-traits-design.md D4) and is\n# written below: each result is computed in Int and wrapped back by\n# sign-extending its low 16 bits, so `I16.MAX + 1` is `I16.MIN`, as `Int`'s\n# overflow is. `/` and `%` are Int's (truncating, and a zero divisor panics\n# with Int's message); the one quotient out of range, MIN / -1, wraps to MIN.\n#\n# Wrapping and not trapping, as `Int` does (spec 4.3): two overflow rules in\n# one family of types would have every reader looking up which one applies.\n# `checked_add`, `checked_sub` and `checked_mul` answer `None` instead. A\n# literal at `I16` is `FromInt`'s, range-checked at compile time, so\n# `let b: I16 = 32768` does not compile (outside this module: inside it the\n# type is seen through and a literal is the Int it always was, literal design\n# D7). The bitwise operations are named functions until the operators have\n# traits of their own; `complement` and not `not`, which is a keyword. A\n# shift or rotation count is taken modulo 16, as the JVM and the hardware do\n# for Int's own shifts.\n#\n# `I16` is also a device format (std/dtype): the constant `I16` below is its\n# witness, spelled like the type so that `use std/int/i16.{I16}` brings in both,\n# and `impl HasDtype[I16]` lets generic code ask for it by type.\n\nuse std/dtype.{DeviceBits, Dtype, HasDtype, to_bits, dtype_name, dtype_from_name, dtype_of, from_bits}\n\n## A signed 16-bit integer.\npub opaque type I16 = Int\n\n## The least `I16`, -32768.\npub const MIN: I16 = -32768\n\n## The greatest `I16`, 32767.\npub const MAX: I16 = 32767\n\n## The device format of `I16`: `i16`.\npub const I16: Dtype[I16] = dtype_from_name(\"i16\")\n\nimpl HasDtype[I16] {\n  fn dtype_of() -> Dtype[I16] = I16\n}\n\n# The low bits of the two's complement, read unsigned: what a device buffer\n# holds for this element. Bits above the width are ignored on the way back.\nimpl DeviceBits[I16] {\n  fn to_bits(v: I16) -> Int = to_int(v) & 0xFFFF\n  fn from_bits(bits: Int) -> I16 = wrap(bits)\n}\n\n## `n` as a `I16`, or `None` when it is outside -32768..32767.\npub fn of(n: Int) -> Option[I16] = if n < -32768 || n > 32767 { None } else { Some(n) }\n\n## The `I16` with the low 16 bits of `n`, read as two's complement:\n## `wrap(32768)` is -32768.\npub fn wrap(n: Int) -> I16 = ((n & 0xFFFF) ^ 0x8000) - 0x8000\n\n## The value of `x` as an Int.\npub fn to_int(x: I16) -> Int = x\n\n# The literal's range check, run at compile time for every literal at this\n# type outside this module.\nimpl FromInt[I16] {\n  fn from_int(n: Int) -> I16 = {\n    if n < -32768 || n > 32767 { panic(\"out of range for I16: \${n}\") }\n    n\n  }\n}\n\nimpl Show[I16] {\n  fn show(x: I16) -> String = {\n    let n: Int = x\n    to_string(n)\n  }\n}\n\nimpl Add[I16] {\n  fn add(a: I16, b: I16) -> I16 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x + y)\n  }\n}\n\nimpl Sub[I16] {\n  fn sub(a: I16, b: I16) -> I16 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x - y)\n  }\n}\n\nimpl Mul[I16] {\n  fn mul(a: I16, b: I16) -> I16 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x * y)\n  }\n}\n\nimpl Div[I16] {\n  fn div(a: I16, b: I16) -> I16 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x / y)\n  }\n}\n\nimpl Rem[I16] {\n  fn rem(a: I16, b: I16) -> I16 = {\n    let x: Int = a\n    let y: Int = b\n    wrap(x % y)\n  }\n}\n\nimpl Neg[I16] {\n  fn neg(a: I16) -> I16 = {\n    let x: Int = a\n    wrap(0 - x)\n  }\n}\n\n## `a + b`, or `None` where it wraps.\npub fn checked_add(a: I16, b: I16) -> Option[I16] = {\n  let x: Int = a\n  let y: Int = b\n  let r = x + y\n  if r < -32768 || r > 32767 { None } else { Some(r) }\n}\n\n## `a - b`, or `None` where it wraps.\npub fn checked_sub(a: I16, b: I16) -> Option[I16] = {\n  let x: Int = a\n  let y: Int = b\n  let r = x - y\n  if r < -32768 || r > 32767 { None } else { Some(r) }\n}\n\n## `a * b`, or `None` where it wraps.\npub fn checked_mul(a: I16, b: I16) -> Option[I16] = {\n  let x: Int = a\n  let y: Int = b\n  let r = x * y\n  if r < -32768 || r > 32767 { None } else { Some(r) }\n}\n\n## The bitwise and.\npub fn and(a: I16, b: I16) -> I16 = {\n  let x: Int = a\n  let y: Int = b\n  x & y\n}\n\n## The bitwise or.\npub fn or(a: I16, b: I16) -> I16 = {\n  let x: Int = a\n  let y: Int = b\n  x | y\n}\n\n## The bitwise exclusive or.\npub fn xor(a: I16, b: I16) -> I16 = {\n  let x: Int = a\n  let y: Int = b\n  x ^ y\n}\n\n## Every bit flipped.\npub fn complement(a: I16) -> I16 = {\n  let x: Int = a\n  wrap(~x)\n}\n\n## `a` shifted left by `n` modulo 16 places, zeros in at the bottom.\npub fn shl(a: I16, n: Int) -> I16 = {\n  let x: Int = a\n  wrap(x << (n & 15))\n}\n\n## `a` shifted right by `n` modulo 16 places, copies of the sign bit in at\n## the top (arithmetic, as Int's `>>`).\npub fn shr(a: I16, n: Int) -> I16 = {\n  let x: Int = a\n  x >> (n & 15)\n}\n\n## `a`'s 16 bits rotated left by `n` modulo 16 places.\npub fn rotl(a: I16, n: Int) -> I16 = {\n  let x: Int = a\n  let u = x & 0xFFFF\n  let k = n & 15\n  wrap((u << k) | (u >>> (16 - k)))\n}\n\n## `a`'s 16 bits rotated right by `n` modulo 16 places.\npub fn rotr(a: I16, n: Int) -> I16 = {\n  let x: Int = a\n  let u = x & 0xFFFF\n  let k = n & 15\n  wrap((u >>> k) | (u << (16 - k)))\n}\n\ntest \"the witness is the format the dialect names, found by value or by type\" {\n  let by_type: Dtype[I16] = dtype_of()\n  assert dtype_name(I16) == \"i16\"\n  assert dtype_name(by_type) == \"i16\"\n}\n\ntest \"I16 moves as its low bits, unsigned, and reads back from any word\" {\n  assert to_bits(wrap(1)) == 1\n  assert to_bits(MAX) == 0x7FFF\n  assert to_bits(MIN) == 0x8000\n  assert to_bits(wrap(-1)) == 0xFFFF\n  let m: I16 = from_bits(0xFFFF)\n  assert m == wrap(-1)\n  assert to_int(from_bits(0xFFFF + 1)) == 0\n  # the bits above the width are ignored\n  let hi: I16 = from_bits(0x5A5A5A5A5A5A5A5A - (0x5A5A5A5A5A5A5A5A & 0xFFFF) + 3)\n  assert to_int(hi) == 3\n  var n = 0\n  while n < 300 {\n    let v: I16 = wrap(n * 7919 - 1000)\n    let back: I16 = from_bits(to_bits(v))\n    assert back == v\n    n = n + 1\n  }\n}\n\n# Representative cases; scripts/spike-native/fixed_ints holds the seven types\n# to an oracle computed outside Dawn, on both backends.\n\ntest \"the ends wrap into each other and the conversions agree\" {\n  assert MAX + wrap(1) == MIN\n  assert MIN - wrap(1) == MAX\n  assert to_int(wrap(7) / wrap(2)) == 3\n  assert to_int(wrap(7) % wrap(2)) == 1\n  assert rotl(wrap(1), 16) == wrap(1)\n  assert rotr(wrap(1), 1) == shl(wrap(1), 15)\n  assert checked_add(MAX, wrap(1)) == None\n  assert checked_sub(MIN, wrap(1)) == None\n  assert of(32768) == None\n  assert of(-32768) == Some(MIN)\n  assert to_int(wrap(32768)) == -32768\n  assert show(MIN) == \"-32768\"\n  # the one quotient out of range wraps, as Int's MIN / -1 does\n  assert MIN / wrap(-1) == MIN\n  assert to_int(shr(MIN, 1)) == -16384\n}\n")

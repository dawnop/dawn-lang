# C11 translates trigraphs before parsing string literals. Preserve all nine
# spellings and their lengths so a shortened C array cannot hide behind the
# Dawn string header. A final slash trigraph also used to consume the quote.
use std/io
use std/str

pub fn main() -> Unit !io = {
  let a = "what??!"
  io.println(a)
  io.println(to_string(str.len(a)))

  let all = "??= ??( ??/ ??) ??' ??< ??! ??> ??-"
  io.println(all)
  io.println(to_string(str.len(all)))

  let ending = "ends??/"
  io.println(ending)
  io.println(to_string(str.len(ending)))
}

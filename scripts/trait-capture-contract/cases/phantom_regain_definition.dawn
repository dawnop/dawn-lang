# Ordinary environments and delivered type support have separate contracts.
# A phantom token cannot discharge its old Mem effect through a fresh runner.
use std/mem
use std/mem.{Mem}
type PhantomAt[@s] = { n: Int }
fn allocate[@s](p: PhantomAt[s]) -> I64Buf@s !Mem[s] = mem.new(p.n)
fn attempt[@s](p: PhantomAt[s]) -> Int =
  mem.with_mem([@t] () => len(allocate(p)))
pub fn main() -> Unit !io = println("probe")

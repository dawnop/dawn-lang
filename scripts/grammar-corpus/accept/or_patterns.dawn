# Or-patterns use the same recursive grammar in match arms and structural lets.

type Choice = Left(value: Int) | Right(value: Int)

fn choose(c: Choice) -> Int =
  match c {
    Left(x) | Right(x) if x >= 0 -> x
    _ -> 0
  }

fn nested(v: Option[(Int, List[Int])]) -> Int =
  match v {
    Some((0 | 1 | (2), [0 | 1, ..])) -> 1
    _ -> 0
  }

fn structural(flag: Bool) -> Bool = {
  let true
    | false = flag
  flag
}

fn continued(c: Choice) -> Int =
  match c {
    Left(x)
      | Right(x) -> x
  }

# the optional first bar (spec 5.1): every alternative behind its own bar, and
# a body followed by a line-leading bar is the end of that arm, not `x | ...`
fn leading(c: Choice, x: Int) -> Int =
  match c {
    | Left(_)
    | Right(_) -> x
  }

fn leading_after_body(o: Option[Int], x: Int) -> Int =
  match o {
    Some(_) -> x
    | None -> 0
  }

fn separate_arms(c: Choice) -> Int =
  match c {
    Left(x) -> x
    Right(x) -> x
  }

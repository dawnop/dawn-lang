# What sits under the cursor (the Kotlin AstQuery): hover text in dawn
# pseudo-syntax plus an optional definition site, picked as the innermost
# (smallest) span containing the offset, later offers winning ties. The Kotlin
# walker reads annotations the checker wrote back onto the parse AST; here the
# parse tree (spans) and the typed tree (types, symbols, resolutions) are
# walked in parallel, pairing children positionally. Where the two trees fall
# out of step (error nodes, desugarings), the walk continues parse-only so
# spans still resolve.
#
# The walk starts at a declaration's typed tree, found by the declaration
# path the checker filed it under (`TFun.decl`, docs/symbol-id-design.md §5)
# rather than by scanning for a body with the same span: a key names one
# declaration, and a span only happens to.

use std/list
use std/map
use std/str
use front/ast.{
  Module, Decl, Expr, Pattern, Stmt, TypeRef, FnDecl, TypeParamDecl,
  Arg, arg_exprs, PatArg, LambdaParam, Param, TypeDeclR, ImportName,
  HandlerCell, HandlerArm, EffectDeclR,
  TNamed, TQual, TAssoc, TTuple, TFn,
  StrPart, SPText, SPInterp,
  EInt, EChar, EFloat, EStr, EVar, EApply, EMethod, ELambda,
  ECtor, ERecord, EFieldAcc, EListLit, ETupleLit, EPropagate, EUnwrap, EIndex, EReturn,
  ListElem, LeExpr, LeSpread, LeIf,
  EComptime, EBinary, EUnary, EIf, EMatch,
  EBlock, EHandle,
  PBind, POr, PCtor, PRecord, PQual, PQualRecord, PTuple, PList,
  SLet, SLetPat, SLocalFn, SAssign, SExpr, SAssert, SWhile, SFor,
  DFn, DType, DConst, DTrait, DImpl, DUseJava, DUseModule, DTest, DEffect,
  e_lo, e_hi, pat_lo, pat_hi, t_hi, module_fns, module_impls, module_traits
}
use check/tast.{
  TExpr, TPat, TStmt, TStrPart, TArm, TFun,
  TSPText, TSPInterp,
  XStr, XLocal, XFnValue, XCallDyn, XCallBuiltin,
  XCallFn, XApply, XJava, XLambda, XCtor, XConstRef, XCtorValue, XField,
  XListLit, XTupleLit, XPropagate, XUnwrap, XIndex, XReturn,
  TListElem, TLEExpr, TLESpread, TLEIf, TModule, TConst,
  XComptime, XBinary, XUnary, XIf, XMatch, XBlock,
  TPWild, TPBind, TPLit, TPOr, TPTuple, TPList, TPCtor,
  TSLet, TSLetPat, TSLocalFn, TSAssign, TSExpr, TSAssert, TSWhile, TSFor,
  x_lo, x_hi, tex_ty
}
use check/types.{
  Ty, TyAdt, TyFn, Sig, Sym, CtorI,
  ty_show, sig_render, ctor_render, trait_of, adt_of, arg_slots, SlotAt,
  builtin_type_at, builtin_type_hard_reserved, builtin_type_render
}
use check/cx.{ModExports, Cx}
use check/identity
use check/tast_positions
use driver/analyze.{Program, CheckedMod}
use driver/stdlib.{StdCtx, std_file_of}
use ir/interp.{CtOut}
use front/lexer.{slice_cps}
use lsp/lspv.{
  value_text, int_literal_text, char_literal_text, float_literal_text, string_literal_text
}
use lsp/lspinlay.{InlayOpts, Hint, type_hint, effect_hint, param_hint, default_args_hint}

## The document analysis a query runs against: the entry module's checked
## state plus everything needed to resolve names defined elsewhere.
pub(pkg) type QCx = {
  entry: CheckedMod,
  prog: Program,
  std: StdCtx,
  # mod_path → exports for every module in scope (std + program)
  exports_env: Map[String, ModExports],
  # the builtins this document may name -- already filtered, so no consumer
  # has to remember that std sees more than user code does
  bins: Map[String, Sig],
  # the entry module's typed trees by declaration path (`typed_trees`)
  typed: TypedTrees,
  # the analyzed document's code points, which the parse tree's spans index:
  # a literal's spelling (`0xFF` rather than `255`) is read back from here,
  # because the parse tree keeps only the value the lexer made of it
  cps: List[Char]
}

## The typed trees of one module, keyed by the `identity.path_text` each was
## filed under. A path declared twice belongs to a module already refused for
## it; the key names the first instance, as the header table's does
## (docs/symbol-id-design.md §4), so a repeat reads its twin's tree.
pub(pkg) type TypedTrees = { fns: Map[String, TFun], consts: Map[String, TConst] }

pub(pkg) fn typed_trees(tm: TModule) -> TypedTrees = {
  var fns: Map[String, TFun] = map.empty()
  for tf in tm.fns ++ tm.tests {
    if tf.decl != "" && not map.has(fns, tf.decl) { fns = map.insert(fns, tf.decl, tf) }
  }
  var consts: Map[String, TConst] = map.empty()
  for tc in tm.consts {
    if tc.decl != "" && not map.has(consts, tc.decl) { consts = map.insert(consts, tc.decl, tc) }
  }
  TypedTrees { fns: fns, consts: consts }
}

## What sits under the cursor: hover text plus an optional definition site.
##
## `def` None = there is no definition to jump to, and `def_path` is only read
## when `def` is `Some`. `def_path` None then means the analyzed document
## itself, so nothing defined in another file may leave it None: the two
## readings are indistinguishable downstream, and `location_of` resolves the
## second one against the requesting buffer.
pub type Target = {
  lo: Int,
  hi: Int,
  hover: String,
  def: Option[(Int, Int)],
  def_path: Option[String],
  # the signature `hover` renders, when the target is a callable: what
  # `textDocument/signatureHelp` lays out parameter by parameter
  sig: Option[Sig],
  # where the declaration's `##` doc is read from, when the target is a
  # declaration (docs/lsp-hover-design.md §A3); None for locals and literals
  doc: Option[DocSite],
  # the typed expression, when the generic fallback is what answered: the one
  # thing hover may fold into a value (`lspeval`, §C5). Every other target
  # names a declaration, a binding or a literal, which has its own text
  expr: Option[TExpr]
}

## The module text a declaration's doc lives in. The query only names it: the
## text of another project file may be a live buffer or a file on disk, which
## is the server's to read (`lsp/server.dawn` `hover_markdown`), and a query
## does no I/O.
##
## `DocStd` names a module path rather than a file because std's text is
## always at hand in `StdCtx.srcs`, embedded copy included, and those are the
## very texts std's spans index.
pub type DocHome = DocHere | DocFile(path: String) | DocStd(mod_path: String)

## Which doc of the text at `home` is meant (`at`).
pub type DocSite = { home: DocHome, at: DocAt }

## `DeclAt(lo)`: a declaration's, with `lo` an offset on its first line, which
## is all `front/docs.doc_of` reads (the `##` block ends on the line above it).
## `ModuleDoc`: the module's own, the block that opens the file
## (`front/docs.module_doc_of`), which a module path on a `use` line and a
## module offered by completion show (docs/lsp-hover-design.md §D7).
pub type DocAt = DeclAt(lo: Int) | ModuleDoc

## One walk over the module. `inlay` is the collector `inlay_hints` hands in;
## a hover query has none, and every hint site then costs one `match` and
## renders nothing. `found` is the collector `resolutions` hands in, in the
## same way.
##
## `tps` is the type parameters the declaration being walked binds: a written
## type resolves against them before anything else, as the checker's
## `cx.resolve_named` does, and the walk has no `Cx` of its own to ask.
type Q = {
  offset: Int,
  best: Option[Target],
  in_for_pattern: Bool,
  inlay: Option[InlayRun],
  found: Option[List[Resolution]],
  tps: List[TpBinder]
}

## A type parameter in scope, at the span of its name where it is declared.
type TpBinder = { name: String, lo: Int, hi: Int }

fn new_q(offset: Int) -> Q =
  Q { offset: offset, best: None, in_for_pattern: false, inlay: None, found: None, tps: [] }

fn query(qc: QCx, offset: Int) -> Q = {
  var q = new_q(offset)
  for d in qc.entry.m.decls { q = visit_decl(qc, q, d) }
  q
}

pub(pkg) fn find_target(qc: QCx, offset: Int) -> Option[Target] = query(qc, offset).best

pub(pkg) fn in_for_pattern(qc: QCx, offset: Int) -> Bool = query(qc, offset).in_for_pattern

# ---- resolutions (docs/lsp-references-design.md §T0) ----
#
# The same walk again, collecting instead of answering: every span the walk
# resolves to a declaration, with that declaration's site. Semantic tokens and
# references are two readings of this list, and neither wants hover text, so a
# collection renders no signature (`live` is false for every span of it).

## One name the walk resolved: its span, and the site of the declaration it
## names, `def_path` read as `Target.def_path` is. `role` is what the walk
## knew, at a local's own declaration, that the site alone does not say.
pub(pkg) type Resolution = { lo: Int, hi: Int, def: (Int, Int), def_path: Option[String], role: LocalRole }

## A local declared at its own name: a parameter, a local `fn`, a mutable
## binding (`var`, a handler's state cell), a `let`. Only a declaration carries
## one; a use of the local names the same site, and a reader looks the role up
## there. `NoRole` is every other name, a pattern binder included, which is
## its own site and needs no tag. Semantic tokens read it
## (docs/lsp-references-design.md §T1): a top-level declaration is found again
## by its name's span in its module, and a local has no such table. A `let`
## carries one because its site is the statement, not the name.
pub(pkg) type LocalRole = NoRole | LetRole | ParamRole | FnRole | MutableRole

## The resolved names starting in `lo..=hi`, by offset. A top-level
## declaration whose span misses the range is not walked, as for inlay hints.
pub(pkg) fn resolutions(qc: QCx, lo: Int, hi: Int) -> List[Resolution] = {
  var out: List[Resolution] = []
  for r in walked_resolutions(qc, lo, hi) {
    if r.lo >= lo && r.lo <= hi { out = out ++ [r] }
  }
  sort_by(out, (a, b) => a.lo - b.lo)
}

## Everything the walk of the declarations `lo..=hi` reaches resolved, in walk
## order and unclipped: a local used inside the range may be declared outside
## it, in the same declaration, and the declaration's role is read from here.
pub(pkg) fn walked_resolutions(qc: QCx, lo: Int, hi: Int) -> List[Resolution] = {
  let none: List[Resolution] = []
  var q = Q { ..new_q(-1), found: Some(none) }
  for d in qc.entry.m.decls {
    let (dlo, dhi) = decl_span(d)
    if dhi >= lo && dlo <= hi { q = visit_decl(qc, q, d) }
  }
  q.found.unwrap_or(none)
}

## Where a top-level declaration is written, from its first token to its last.
## Every name the walk resolves under a declaration lies inside it, a type's
## and an effect's included, so a range request walks only what it overlaps
## (docs/lsp-references-design.md §T1: walking every type and effect header
## of a 12k-line buffer was most of a viewport request's cost).
pub(pkg) fn decl_span(d: Decl) -> (Int, Int) =
  match d {
    DFn(f) -> (f.lo, f.hi)
    DEffect(e) -> (e.lo, e.hi)
    DType(t) -> (t.lo, t.hi)
    DConst(_, _, _, _, lo, hi, _, _) -> (lo, hi)
    DTrait(_, _, _, _, _, _, _, _, lo, hi, _, _) -> (lo, hi)
    DImpl(_, _, _, _, _, _, _, _, lo, hi) -> (lo, hi)
    DUseJava(_, lo, hi, _, _) -> (lo, hi)
    DUseModule(_, _, _, lo, hi, _, _) -> (lo, hi)
    DTest(_, _, lo, hi, _, _, _) -> (lo, hi)
  }

# ---- inlay hints (docs/lsp-hover-design.md §A4) ----
#
# The same walk as hover, with a collector: the hint sites are a let's name, a
# lambda parameter, a call, and the walk already pairs each with its typed node.
# What a site shows is `lspinlay`'s decision; where it is, is this file's.

## The hints collected so far, and the range a hint must fall in to be kept.
type InlayRun = { lo: Int, hi: Int, opts: InlayOpts, hints: List[Hint] }

## The hints whose offset lies in `lo..=hi` (code points, both ends included),
## by offset. A top-level declaration whose span misses the range is not walked
## at all, so a request for the visible part of a file costs what that part
## holds rather than what the file holds.
pub(pkg) fn inlay_hints(qc: QCx, lo: Int, hi: Int, opts: InlayOpts) -> List[Hint] = {
  let run = InlayRun { lo: lo, hi: hi, opts: opts, hints: [] }
  # an offset no span contains: every hover offer is refused at its first test
  var q = Q { ..new_q(-1), inlay: Some(run) }
  for d in qc.entry.m.decls {
    let walk = match decl_bounds(d) {
      Some(b) -> {
        let (dlo, dhi) = b
        dhi >= lo && dlo <= hi
      }
      None -> false
    }
    if walk { q = visit_decl(qc, q, d) }
  }
  match q.inlay {
    Some(r) -> sort_by(r.hints, (a, b) => a.at - b.at)
    None -> []
  }
}

## The span of a declaration that can hold a hint site; `None` for the ones
## that hold no expression (`use` lines, types, effects).
fn decl_bounds(d: Decl) -> Option[(Int, Int)] =
  match d {
    DFn(f) -> Some((f.lo, f.hi))
    DTest(_, _, lo, hi, _, _, _) -> Some((lo, hi))
    DConst(_, _, _, _, lo, hi, _, _) -> Some((lo, hi))
    DTrait(_, _, _, _, _, _, _, _, lo, hi, _, _) -> Some((lo, hi))
    DImpl(_, _, _, _, _, _, _, _, lo, hi) -> Some((lo, hi))
    _ -> None
  }

## The options of a running collection; `None` while answering a hover.
fn inlay_opts(q: Q) -> Option[InlayOpts] =
  match q.inlay {
    Some(r) -> Some(r.opts)
    None -> None
  }

fn add_hint(q: Q, h: Option[Hint]) -> Q =
  match q.inlay {
    Some(r) ->
      match h {
        Some(x) ->
          if x.at >= r.lo && x.at <= r.hi {
            Q { ..q, inlay: Some(InlayRun { ..r, hints: r.hints ++ [x] }) }
          } else {
            q
          }
        None -> q
      }
    None -> q
  }

## `: T` at `at` for the binding `sid`, when the collection wants this kind.
fn hint_binding(qc: QCx, q: Q, want: Bool, sid: Int, at: Int) -> Q =
  if not want {
    q
  } else {
    match sym_get(qc, sid) {
      Some(sym) -> add_hint(q, type_hint(at, show_ty(qc, sym.ty)))
      None -> q
    }
  }

fn is_ident_char(c: Char) -> Bool =
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'

## Where the name of `let name = ...` ends. Neither tree has the name's span:
## `SLet` keeps the statement's, and the checker declares the symbol over the
## statement too. The grammar is the keyword, blanks, the name -- nothing else
## can come between -- so reading it back off the text is exact; a name that
## does not read back as `name` (an analysis of another revision) gives `None`.
fn let_name_end(cps: List[Char], lo: Int, name: String) -> Option[Int] = {
  let n = len(cps)
  var i = lo + 3
  while i < n && (cps[i] == ' ' || cps[i] == '\t') { i = i + 1 }
  let start = i
  while i < n && is_ident_char(cps[i]) { i = i + 1 }
  if i > start && slice_cps(cps, start, i) == name { Some(i) } else { None }
}

## The binders of a typed pattern, in order.
fn pat_binders(tp: TPat) -> List[Int] =
  match tp {
    TPBind(sid, _) -> [sid]
    TPOr(alts) -> {
      var out: List[Int] = []
      for a in alts { out = out ++ pat_binders(a) }
      out
    }
    TPTuple(elems) -> {
      var out: List[Int] = []
      for e in elems { out = out ++ pat_binders(e) }
      out
    }
    TPList(pre, _, rest, post) -> {
      var out: List[Int] = []
      for e in pre { out = out ++ pat_binders(e) }
      match rest {
        Some(r) -> { out = out ++ [r] }
        None -> ()
      }
      for e in post { out = out ++ pat_binders(e) }
      out
    }
    TPCtor(_, _, fps) -> {
      var out: List[Int] = []
      for fp in fps {
        match fp {
          Some(p) -> { out = out ++ pat_binders(p) }
          None -> ()
        }
      }
      out
    }
    _ -> []
  }

## `: T` after each unannotated parameter of a lambda or local fn.
fn hint_lambda_params(qc: QCx, q0: Q, params: List[LambdaParam], psyms: List[Int]) -> Q = {
  let want = match inlay_opts(q0) {
    Some(o) -> o.lambda_param_types
    None -> false
  }
  if not want { return q0 }
  var q = q0
  var i = 0
  for p in params {
    match p.ann {
      None ->
        match get(psyms, i) {
          Some(sid) -> { q = hint_binding(qc, q, true, sid, p.hi) }
          None -> ()
        }
      Some(_) -> ()
    }
    i = i + 1
  }
  q
}

## Where a call's effect hint goes: its end, unless it ends in a trailing
## block, which can be a whole block long (`with x <- f(a)` hands `f` the rest
## of the enclosing block). Then it is after the `)` of the written arguments,
## found by skipping blanks and commas after the last of them; a `#` comment in
## the way leaves it at the end of that argument.
fn call_effect_at(cps: List[Char], args: List[Arg], name_hi: Int, call_hi: Int) -> Int = {
  var trailing = false
  var last = name_hi
  for a in args {
    if a.trailing { trailing = true } else if a.hi > last { last = a.hi }
  }
  if not trailing { return call_hi }
  let n = len(cps)
  var i = last
  while i < n && (cps[i] == ' ' || cps[i] == '\t' || cps[i] == '\n' || cps[i] == '\r' || cps[i] == ',') {
    i = i + 1
  }
  if i < n && cps[i] == '(' && last == name_hi {
    i = i + 1
    while i < n && (cps[i] == ' ' || cps[i] == '\t' || cps[i] == '\n' || cps[i] == '\r') { i = i + 1 }
  }
  if i < n && cps[i] == ')' { i + 1 } else { last }
}

## The parameter names of a call's written positional arguments. `first` is
## the parameter the first argument fills (1 when a UFCS receiver took 0). An
## argument left of the callee's name is a pipe's (`x |> f(a)`): not in the
## parentheses, so neither hinted nor counted.
fn hint_param_names(q0: Q, s: Sig, args: List[Arg], first: Int, name_hi: Int) -> Q = {
  let want = match inlay_opts(q0) {
    Some(o) -> o.param_names
    None -> false
  }
  if not want { return q0 }
  var shown = 0
  for a in args {
    if not a.trailing && a.lo >= name_hi { shown = shown + 1 }
  }
  var q = q0
  var i = first
  for a in args {
    if a.name == None && not a.trailing && a.lo >= name_hi {
      match get(s.param_names, i) {
        Some(pn) -> {
          let var_name: Option[String] = match a.e {
            EVar(vn, _, _) -> Some(vn)
            _ -> None
          }
          q = add_hint(q, param_hint(e_lo(a.e), pn, var_name, shown))
        }
        None -> ()
      }
    }
    i = i + 1
  }
  q
}

## The node a call checked to, past the block the checker wraps a call in when
## named arguments are written out of order (`checker.check_call`'s
## `arg_lets`): under an `EApply` that block can be nothing else.
fn call_node(te: Option[TExpr]) -> Option[TExpr] =
  match te {
    Some(XBlock(_, Some(tail), _, _, _)) -> Some(tail)
    _ -> te
  }

## The signature a call by name resolved to, read off its typed node; `None`
## when the node is not a call the checker resolved. An operation call
## (`ask()`) is an `XApply` on the evidence record by the time it is typed,
## so its signature is the operation's, found by name.
fn call_sig(qc: QCx, callee: String, te: Option[TExpr]) -> Option[Sig] =
  match call_node(te) {
    Some(XCallFn(owner, fname, _, _, _, trait_id, _, _, _)) -> sig_by_owner(qc, owner, fname, trait_id)
    Some(XCallBuiltin(bname, _, _, _, _, _, _)) -> map.get(qc.bins, bname)
    Some(XApply(_, _, _, _, _, _)) ->
      match sig_of(qc, callee) {
        Some(s) -> if s.op_of != None { Some(s) } else { None }
        None -> None
      }
    _ -> None
  }

## The arguments a call leaves to their defaults, as one hint inside its
## parentheses after the last argument written there (docs/lsp-hover-design.md
## §B1). Which parameter each written argument fills is the checker's own rule
## (`types.arg_slots`), with `first` receiver slots in front -- so a named
## argument out of order, a pipe's argument and a trailing block (which fills
## the last parameter) land where the call lands them. A call where an
## argument lands nowhere, or a parameter with no default is left out, is an
## error the diagnostics already report, and gets no hint.
fn hint_default_args(qc: QCx, q: Q, s: Sig, args: List[Arg], first: Int, name_hi: Int) -> Q = {
  let want = match inlay_opts(q) {
    Some(o) -> o.default_args
    None -> false
  }
  if not want || len(s.param_defaults) == 0 { return q }
  let unnamed: Option[String] = None
  var given: List[Option[String]] = []
  var r = 0
  while r < first {
    given = given ++ [unnamed]
    r = r + 1
  }
  for a in args { given = given ++ [a.name] }
  let trailing = len(args) > 0 && args[len(args) - 1].trailing
  var filled: Map[Int, Bool] = map.empty()
  for pick in arg_slots(s.param_names, given, trailing) {
    match pick {
      SlotAt(idx) -> { filled = map.insert(filled, idx, true) }
      _ -> return q
    }
  }
  var omitted: List[(String, String)] = []
  var pi = 0
  for pn in s.param_names {
    if not map.has(filled, pi) {
      match get(s.param_defaults, pi) {
        Some(Some(text)) -> { omitted = omitted ++ [(pn, text)] }
        _ -> return q
      }
    }
    pi = pi + 1
  }
  if len(omitted) == 0 { return q }
  # a pipe's argument sits left of the name, outside the parentheses
  var last = -1
  for a in args {
    if not a.trailing && a.lo >= name_hi && a.hi > last { last = a.hi }
  }
  if last >= 0 { return add_hint(q, default_args_hint(last, omitted, true, false)) }
  let cps = qc.cps
  let n = len(cps)
  var j = name_hi
  while j < n && (cps[j] == ' ' || cps[j] == '\t') { j = j + 1 }
  if j < n && cps[j] == '(' {
    add_hint(q, default_args_hint(j + 1, omitted, false, false))
  } else {
    # `x |> f` and `f { ... }`: no parentheses, so the hint brings its own
    add_hint(q, default_args_hint(name_hi, omitted, false, true))
  }
}

## The left-out defaults, the effect hint and the parameter names of one
## call. `first` as in `hint_param_names`; `name_hi` is the end of the
## callee's name. The defaults go in first: with no parentheses they share the
## effect hint's offset, and they read before it.
fn hint_call(qc: QCx, q0: Q, s: Sig, args: List[Arg], first: Int, name_hi: Int, call_hi: Int) -> Q = {
  var q = hint_default_args(qc, q0, s, args, first, name_hi)
  match inlay_opts(q) {
    Some(o) -> {
      if o.call_effects {
        q = add_hint(q, effect_hint(call_effect_at(qc.cps, args, name_hi, call_hi), s.eff))
      }
    }
    None -> ()
  }
  hint_param_names(q, s, args, first, name_hi)
}

## A call of a local function value: its row is the one in its type.
fn hint_dyn_call(qc: QCx, q: Q, sid: Int, args: List[Arg], name_hi: Int, call_hi: Int) -> Q = {
  let want = match inlay_opts(q) {
    Some(o) -> o.call_effects
    None -> false
  }
  if not want { return q }
  match sym_get(qc, sid) {
    Some(sym) ->
      match sym.ty {
        TyFn(_, _, eff) -> add_hint(q, effect_hint(call_effect_at(qc.cps, args, name_hi, call_hi), eff))
        _ -> q
      }
    None -> q
  }
}

## How many parameters a dotted call fills before its written arguments: 1
## for UFCS, whose typed arguments open with the receiver, 0 for a
## module-qualified call, where the receiver is an alias and not a value. Read
## off the first typed argument's span rather than the list's length, which a
## default left out makes shorter than the parameter list.
##
## A left-out first parameter is filled by a node the checker spans over the
## whole call, which starts where the receiver does; it is told apart by what
## it calls (`f$default$0`) or, when the call binds its arguments first, by
## the local it reads (`default$0`), and is never a receiver.
fn receiver_slots(recv: Expr, targs: List[TExpr]) -> Int =
  match get(targs, 0) {
    Some(t0) -> if x_lo(t0) == e_lo(recv) && not is_default_fill(t0) { 1 } else { 0 }
    None -> 0
  }

fn is_default_fill(t: TExpr) -> Bool =
  match t {
    XCallFn(_, fname, _, _, _, _, _, _, _) -> str.contains(fname, "\$default\$")
    XLocal(_, name, _, _, _) -> str.starts_with(name, "default\$")
    _ -> false
  }

## The hints of `f(args)`, `EApply` over a name.
fn hint_named_call(qc: QCx, q: Q, callee: String, args: List[Arg], name_hi: Int, call_hi: Int, te: Option[TExpr]) -> Q =
  match inlay_opts(q) {
    None -> q
    Some(_) ->
      match call_node(te) {
        Some(XCallDyn(sid, _, _, _, _, _, _)) -> hint_dyn_call(qc, q, sid, args, name_hi, call_hi)
        _ ->
          match call_sig(qc, callee, te) {
            Some(s) -> hint_call(qc, q, s, args, 0, name_hi, call_hi)
            None -> q
          }
      }
  }

## The hints of `recv.name(args)`; `receiver_slots` says where its written
## arguments start.
fn hint_method_call(
  qc: QCx,
  q: Q,
  recv: Expr,
  name: String,
  args: List[Arg],
  name_hi: Int,
  call_hi: Int,
  te: Option[TExpr]
) -> Q =
  match inlay_opts(q) {
    None -> q
    Some(_) ->
      match call_node(te) {
        Some(XCallFn(owner, fname, targs, _, _, trait_id, _, _, _)) ->
          if fname != name {
            q
          } else {
            match sig_by_owner(qc, owner, fname, trait_id) {
              Some(s) -> hint_call(qc, q, s, args, receiver_slots(recv, targs), name_hi, call_hi)
              None -> q
            }
          }
        Some(XCallBuiltin(bname, targs, _, _, _, _, _)) ->
          if bname != name {
            q
          } else {
            match map.get(qc.bins, bname) {
              Some(s) -> hint_call(qc, q, s, args, receiver_slots(recv, targs), name_hi, call_hi)
              None -> q
            }
          }
        _ -> q
      }
  }

# ---- the offer rule: innermost span containing the offset, later ties win ----

fn offer(q: Q, lo: Int, hi: Int, hover: String, def: Option[(Int, Int)], dp: Option[String]) -> Q =
  offer_target(q, Target { lo: lo, hi: hi, hover: hover, def: def, def_path: dp, sig: None, doc: None, expr: None })

## Can an offer at `lo..hi` become the answer? Only when it holds the offset,
## which no span does in a collection or an inlay run. A rendering that is
## not read is skipped on this: a signature costs a type printer per
## parameter, and a walk offers one at every call it passes.
fn live(q: Q, lo: Int, hi: Int) -> Bool = q.offset >= lo && q.offset < hi

## A callable's signature, rendered for hover and kept whole for signature help.
fn offer_sig(qc: QCx, q: Q, lo: Int, hi: Int, s: Sig, def: Option[(Int, Int)], dp: Option[String]) -> Q =
  offer_target(q, Target {
    lo: lo, hi: hi, hover: if live(q, lo, hi) { render_sig(qc, s) } else { "" }, def: def, def_path: dp,
    sig: Some(s), doc: None, expr: None
  })

## A declaration resolved to where it is: the jump target and the doc's home.
## The two are separate because an embedded std module has a text but no file:
## its declarations offer no jump and still carry their doc.
type Site = { def: Option[(Int, Int)], dp: Option[String], doc: Option[DocSite] }

fn no_site() -> Site = Site { def: None, dp: None, doc: None }

## A declaration of the entry document, at its own name.
fn here(nlo: Int, nhi: Int, lo: Int) -> Site =
  Site { def: Some((nlo, nhi)), dp: None, doc: Some(DocSite { home: DocHere, at: DeclAt(lo) }) }

fn offer_at(q: Q, lo: Int, hi: Int, hover: String, s: Site) -> Q =
  offer_target(q, Target { lo: lo, hi: hi, hover: hover, def: s.def, def_path: s.dp, sig: None, doc: s.doc, expr: None })

fn offer_sig_at(qc: QCx, q: Q, lo: Int, hi: Int, sg: Sig, s: Site) -> Q =
  offer_target(q, Target {
    lo: lo, hi: hi, hover: if live(q, lo, hi) { render_sig(qc, sg) } else { "" }, def: s.def,
    def_path: s.dp, sig: Some(sg), doc: s.doc, expr: None
  })

fn offer_target(q: Q, t: Target) -> Q = {
  match q.found {
    Some(rs) ->
      return match t.def {
        Some(d) -> Q { ..q, found: Some(rs ++ [Resolution { lo: t.lo, hi: t.hi, def: d, def_path: t.def_path, role: NoRole }]) }
        None -> q
      }
    None -> ()
  }
  let lo = t.lo
  let hi = t.hi
  if q.offset < lo || q.offset >= hi { return q }
  match q.best {
    None -> Q { ..q, best: Some(t) }
    Some(b) -> if hi - lo <= b.hi - b.lo { Q { ..q, best: Some(t) } } else { q }
  }
}

fn no_def() -> (Option[(Int, Int)], Option[String]) = (None, None)

## A call of a local (a parameter, a local `fn`, a `let` holding a lambda),
## collected as a use of that local. Only a collection takes it: hover and
## definition at such a call answer as they did before T1, and a local that
## shadows a top-level function of its name is R1's to resolve for them
## (docs/lsp-references-design.md §T1). Collected ahead of the walk's own
## offer at the same span, so a token reads the local.
fn collect_local_call(qc: QCx, q: Q, sid: Int, lo: Int, hi: Int) -> Q =
  match q.found {
    Some(rs) ->
      match sym_get(qc, sid) {
        Some(sym) -> Q { ..q, found: Some(rs ++ [Resolution { lo: lo, hi: hi, def: (sym.dlo, sym.dhi), def_path: None, role: NoRole }]) }
        None -> q
      }
    None -> q
  }

## A local of the entry document at its own declaration, `lo..hi`: offered as
## `offer` would, and collected with its role.
fn offer_local(q: Q, role: LocalRole, lo: Int, hi: Int, hover: String, def: (Int, Int)) -> Q =
  match q.found {
    Some(rs) -> Q { ..q, found: Some(rs ++ [Resolution { lo: lo, hi: hi, def: def, def_path: None, role: role }]) }
    None -> offer(q, lo, hi, hover, Some(def), None)
  }

# ---- name resolution helpers ----

## local -> std -> builtin, the same order the checker resolves names in.
pub(pkg) fn sig_of(qc: QCx, name: String) -> Option[Sig] =
  match map.get(qc.entry.cx.fns, name) {
    Some(s) -> Some(s)
    None ->
      match map.get(qc.std.std_fns, name) {
        Some(s) -> Some(s)
        None -> map.get(qc.bins, name)
      }
  }

## The Sig behind a resolved call: the owning module's surface.
pub(pkg) fn sig_by_owner(qc: QCx, owner: Option[String], name: String, trait_id: Option[Int]) -> Option[Sig] = {
  match trait_id {
    Some(tid) -> {
      let tr = trait_of(qc.entry.cx.traits, tid)
      for pr in tr.methods {
        let (mn, ms) = pr
        if mn == name { return Some(ms.sig) }
      }
      return None
    }
    None -> ()
  }
  match owner {
    None -> sig_of(qc, name)
    Some(o) -> {
      if o == qc.entry.class_name { return map.get(qc.entry.cx.fns, name) }
      for pr in map.entries(qc.exports_env) {
        let (_, exp) = pr
        if exp.class_name == o {
          return map.get(exp.fns, name)
        }
      }
      sig_of(qc, name)
    }
  }
}

## The module that holds a declaration: its parse AST, the file a definition
## jump opens (None = the entry document), and the home of its doc text.
##
## A std module answers with the file its text was read from. `load_std` builds
## every std `Cx` without a `src_path` -- that field renders into a user-visible
## duplicate-impl diagnostic, so std must not carry one -- and the bundle's own
## `dir_modules` record is where the file lives instead.
##
## When the embedded copy supplied the module there is no file, and `jump` is
## false: the declaration offers no definition rather than `None`. `None` here
## means "the document being analyzed", which is what makes a local definition
## resolve against the live buffer; a std module borrowing it hands
## `location_of` the requesting document's uri and std's offsets, and the reply
## is a confident range in an unrelated file rather than a missing one. The
## doc is unaffected: std's text is in `StdCtx.srcs` either way.
type Holder = { m: Module, def_path: Option[String], jump: Bool, home: DocHome }

fn holder_by_class(qc: QCx, owner: String) -> Option[Holder] = {
  if owner == qc.entry.class_name {
    return Some(Holder { m: qc.entry.m, def_path: None, jump: true, home: DocHere })
  }
  for cm in qc.prog.modules {
    if cm.class_name == owner {
      return Some(Holder { m: cm.m, def_path: Some(cm.path), jump: true, home: DocFile(cm.path) })
    }
  }
  for tr in qc.std.srcs {
    let (mp, _, m) = tr
    if mp == owner { return Some(std_holder(qc, mp, m)) }
  }
  None
}

fn std_holder(qc: QCx, mp: String, m: Module) -> Holder =
  match std_file_of(qc.std, mp) {
    Some(f) -> Holder { m: m, def_path: Some(f), jump: true, home: DocStd(mp) }
    None -> Holder { m: m, def_path: None, jump: false, home: DocStd(mp) }
  }

## A declaration found in `h`: named at `nlo..nhi`, starting on the line of `lo`.
fn site_in(h: Holder, nlo: Int, nhi: Int, lo: Int) -> Site = {
  let doc = Some(DocSite { home: h.home, at: DeclAt(lo) })
  if h.jump { Site { def: Some((nlo, nhi)), dp: h.def_path, doc: doc } } else { Site { ..no_site(), doc: doc } }
}

## Definition site of a signature (the Kotlin sig.nameSpan / sig.srcPath).
fn site_of_sig(qc: QCx, s: Sig) -> Site = {
  match s.trait_id {
    Some(tid) -> return site_of_trait_method(qc, tid, s.name)
    None -> ()
  }
  # an operation is declared in its effect, not as a function
  match s.op_of {
    Some(o) -> {
      let (eid, _) = o
      return site_of_op(qc, eid, s.name)
    }
    None -> ()
  }
  if s.is_builtin { return no_site() }
  let owner = match s.owner {
    Some(o) -> o
    None -> qc.entry.class_name
  }
  match holder_by_class(qc, owner) {
    Some(h) -> {
      for d in h.m.decls {
        match d {
          DFn(f) -> if f.name == s.name { return site_in(h, f.nlo, f.nhi, f.lo) }
          _ -> ()
        }
      }
      no_site()
    }
    None -> no_site()
  }
}

fn site_of_trait_method(qc: QCx, tid: Int, mname: String) -> Site = {
  let tr = trait_of(qc.entry.cx.traits, tid)
  let owner = match tr.owner {
    Some(o) -> o
    None -> qc.entry.class_name
  }
  match holder_by_class(qc, owner) {
    Some(h) -> {
      for d in h.m.decls {
        match d {
          DTrait(name, _, _, _, methods, _, _, _, _, _, _, _) ->
            if name == tr.name {
              for tm in methods {
                if tm.name == mname { return site_in(h, tm.nlo, tm.nhi, tm.lo) }
              }
            }
          _ -> ()
        }
      }
      no_site()
    }
    None -> no_site()
  }
}

## The DType declaration behind an ADT id, with the module holding it.
fn type_decl_of(qc: QCx, aid: Int) -> Option[(TypeDeclR, Holder)] = {
  let a = adt_of(qc.entry.cx.adts, aid)
  let owner = match a.owner {
    Some(o) -> o
    None -> qc.entry.class_name
  }
  match holder_by_class(qc, owner) {
    Some(h) -> {
      for d in h.m.decls {
        match d {
          DType(t) -> if t.name == a.name { return Some((t, h)) }
          _ -> ()
        }
      }
      None
    }
    None -> None
  }
}

fn site_of_type(qc: QCx, aid: Int) -> Site =
  match type_decl_of(qc, aid) {
    Some(pr) -> {
      let (t, h) = pr
      site_in(h, t.nlo, t.nhi, t.lo)
    }
    None -> no_site()
  }

## A constructor's doc is read with `doc_of` at its own line, not with
## `front/docs.member_doc_of`: on its type's line that reads the type's block,
## which hover shows as a fallback. `dawn doc` publishes no doc for such a
## constructor (spec §1.2); the fallback is presentation, and it is the reply
## hover gave before the rule existed. Fields (`site_of_field` and the
## declaration walk) read the same way.
fn site_of_ctor(qc: QCx, aid: Int, cname: String) -> Site =
  match type_decl_of(qc, aid) {
    Some(pr) -> {
      let (t, h) = pr
      for c in t.ctors {
        if c.name == cname { return site_in(h, c.nlo, c.nhi, c.lo) }
      }
      no_site()
    }
    None -> no_site()
  }

## A record field: its declaration to jump to, and the `##` block above its
## own line: the doc `dawn doc` publishes for it, or, on its record's line, the
## record's own block as a fallback (`site_of_ctor`).
fn site_of_field(qc: QCx, aid: Int, fi: Int) -> Site =
  match type_decl_of(qc, aid) {
    Some(pr) -> {
      let (t, h) = pr
      if len(t.ctors) > 0 {
        match get(t.ctors[0].fields, fi) {
          Some(f) -> return site_in(h, f.lo, f.hi, f.lo)
          None -> ()
        }
      }
      no_site()
    }
    None -> no_site()
  }

## Definition site of a constant by name, searched where the checker found it.
fn site_of_const(qc: QCx, name: String) -> Site = {
  match const_decl_span(qc.entry.m, name) {
    Some(sp) -> {
      let (nlo, nhi, lo) = sp
      return here(nlo, nhi, lo)
    }
    None -> ()
  }
  match map.get(qc.entry.cx.imported_names, name) {
    Some(mp) -> site_of_const_in(qc, mp, name)
    None -> no_site()
  }
}

fn site_of_const_in(qc: QCx, mod_path: String, name: String) -> Site = {
  let h = match holder_by_path(qc, mod_path) {
    Some(h) -> h
    None -> return no_site()
  }
  match const_decl_span(h.m, name) {
    Some(sp) -> {
      let (nlo, nhi, lo) = sp
      site_in(h, nlo, nhi, lo)
    }
    None -> no_site()
  }
}

## The same three places as `holder_by_class`, by module path: a const names
## its module by path, and the entry module is never one of them here (a bare
## const of this module resolved before this is reached).
fn holder_by_path(qc: QCx, mod_path: String) -> Option[Holder] = {
  for cm in qc.prog.modules {
    if cm.mod_path == mod_path {
      return Some(Holder { m: cm.m, def_path: Some(cm.path), jump: true, home: DocFile(cm.path) })
    }
  }
  for tr in qc.std.srcs {
    let (mp, _, m) = tr
    if mp == mod_path { return Some(std_holder(qc, mp, m)) }
  }
  None
}

## The module doc of the module at `mod_path`, when the program or std holds
## it: what a module path on a `use` line hovers with.
fn module_doc_site(qc: QCx, mod_path: String) -> Option[DocSite] =
  match holder_by_path(qc, mod_path) {
    Some(h) -> Some(DocSite { home: h.home, at: ModuleDoc })
    None -> None
  }

## The offset the top-level declaration named `name` starts at in `m`, or the
## one a constructor of that name starts at: functions, types and aliases,
## constants, traits and effects share one namespace per module, so a name
## names one of them. Read off the parse alone, which is all a module that a
## `use` line is about to import has (`lsp/server.dawn` reads the doc of one
## the program has not loaded through this).
pub(pkg) fn decl_lo_named(m: Module, name: String) -> Option[Int] = {
  for d in m.decls {
    match d {
      DFn(f) -> if f.name == name { return Some(f.lo) }
      DType(t) -> if t.name == name { return Some(t.lo) }
      DConst(n, _, _, _, lo, _, _, _) -> if n == name { return Some(lo) }
      DTrait(n, _, _, _, _, _, _, _, lo, _, _, _) -> if n == name { return Some(lo) }
      DEffect(e) -> if e.name == name { return Some(e.lo) }
      _ -> ()
    }
  }
  for d in m.decls {
    match d {
      DType(t) -> {
        for c in t.ctors {
          if c.name == name { return Some(c.lo) }
        }
      }
      _ -> ()
    }
  }
  None
}

## The doc site of `name` as module `mod_path` declares it.
fn member_doc_site(qc: QCx, mod_path: String, name: String) -> Option[DocSite] = {
  let h = match holder_by_path(qc, mod_path) {
    Some(h) -> h
    None -> return None
  }
  match decl_lo_named(h.m, name) {
    Some(lo) -> Some(DocSite { home: h.home, at: DeclAt(lo) })
    None -> None
  }
}

## Where a completion item's doc is read (docs/lsp-hover-design.md §D7), from
## what the item carries back to `completionItem/resolve`: its label, its LSP
## kind, and for an item a `use` line offered the module path it came from.
## The sites are hover's, so an item's doc is the doc its name hovers with.
##
## The kind is what tells apart the items one label can stand for: a local
## (Variable) shadows a function of its name and has no doc, a record type and
## its constructor share a name. `None` is an item with no declaration behind
## it (a keyword, a builtin, a local) or one whose module is not loaded, which
## the server then reads from the file a `use` line would load.
pub(pkg) fn item_doc_site(qc: QCx, label: String, kind: Int, from: Option[String]) -> Option[DocSite] =
  match from {
    Some(mp) -> if kind == 9 { module_doc_site(qc, mp) } else { member_doc_site(qc, mp, label) }
    None -> scope_doc_site(qc, label, kind)
  }

## An item offered in code, as the entry module's scope resolves its label.
fn scope_doc_site(qc: QCx, label: String, kind: Int) -> Option[DocSite] = {
  if kind == 3 {
    return match sig_of(qc, label) {
      Some(s) -> site_of_sig(qc, s).doc
      None -> None
    }
  }
  if kind == 9 {
    return match map.get(qc.entry.cx.module_aliases, label) {
      Some(mp) -> module_doc_site(qc, mp)
      None -> None
    }
  }
  if kind == 7 {
    match map.get(qc.entry.cx.adts_by_name, label) {
      Some(aid) -> return site_of_type(qc, aid).doc
      None -> ()
    }
  }
  if kind == 20 {
    match map.get(qc.entry.cx.ctors_by_name, label) {
      Some(k) -> {
        let (aid, _) = k
        return site_of_ctor(qc, aid, label).doc
      }
      None -> ()
    }
  }
  if kind == 21 { return site_of_const(qc, label).doc }
  if kind != 7 && kind != 8 && kind != 20 && kind != 23 { return None }
  # a trait, an effect, an alias: declared here, or brought in by name
  match decl_lo_named(qc.entry.m, label) {
    Some(lo) -> return Some(DocSite { home: DocHere, at: DeclAt(lo) })
    None -> ()
  }
  match map.get(qc.entry.cx.imported_names, label) {
    Some(mp) -> member_doc_site(qc, mp, unwrap_or(map.get(qc.entry.cx.import_renames, label), label))
    None -> None
  }
}

## The doc site of a callable's declaration, for signature help: the doc its
## name hovers with.
pub(pkg) fn sig_doc_site(qc: QCx, s: Sig) -> Option[DocSite] = site_of_sig(qc, s).doc

## A constant's name span and the offset its declaration starts at.
fn const_decl_span(m: Module, name: String) -> Option[(Int, Int, Int)] = {
  for d in m.decls {
    match d {
      DConst(n, _, _, _, lo, _, nlo, nhi) -> if n == name { return Some((nlo, nhi, lo)) }
      _ -> ()
    }
  }
  None
}

# ---- typed-tree pairing ----

fn syms_of(qc: QCx) -> Map[Int, Sym] = qc.entry.tm.syms

pub(pkg) fn sym_get(qc: QCx, id: Int) -> Option[Sym] = map.get(qc.entry.tm.syms, id)

## The typed tree of the declaration at `path`, spelled from the syntax the
## walk holds: `[Named(FunctionDecl, f)]`, an impl method under its impl head,
## a trait default under its trait, `[Named(TestDecl, t)]`.
fn tfun_at(qc: QCx, path: List[identity.Part]) -> Option[TFun] =
  map.get(qc.typed.fns, identity.path_text(path))

fn impl_head(tparams: List[TypeParamDecl], trait_name: String, subject: TypeRef) -> List[identity.Part] =
  [identity.ImplHead(trait_name, identity.type_shape(subject, map(tparams, tp => tp.name)))]

fn method_path(head: List[identity.Part], name: String) -> List[identity.Part] =
  head ++ [identity.Named(identity.MethodDecl, name)]

fn show_ty(qc: QCx, t: Ty) -> String = ty_show(qc.entry.cx.adts, t)

fn render_sig(qc: QCx, s: Sig) -> String =
  sig_render(qc.entry.cx.adts, qc.entry.cx.traits, s)

fn render_ctor(qc: QCx, c: CtorI) -> String = ctor_render(qc.entry.cx.adts, c)

type WrittenTypeUse = WtStorage | WtReturn

## A type as its author wrote it, resolved the way `cx.resolve_named` and
## `cx.resolve_qual` resolve it -- hard-reserved builtin, type parameter,
## alias, builtin, ADT -- but read-only: the checker's resolver writes
## diagnostics and records spans, and the analysis it ran already has both.
## A builtin has no declaration and stays silent here, except a return-only
## one at a return position, which has always answered with what it is.
fn visit_written_type(qc: QCx, q0: Q, tref: TypeRef, type_use: WrittenTypeUse) -> Q = {
  var q = q0
  match tref {
    TNamed(name, args, eargs, lo, hi) -> {
      let nhi = lo + str.len(name)
      match builtin_type_at(name) {
        Some(info) ->
          if builtin_type_hard_reserved(info) {
            if type_use == WtReturn && len(args) == 0 {
              let (d, dp) = no_def()
              q = offer(q, lo, hi, builtin_type_render(info), d, dp)
            }
          } else {
            q = offer_type_name(qc, q, name, lo, nhi)
          }
        None -> { q = offer_type_name(qc, q, name, lo, nhi) }
      }
      for arg in args { q = visit_written_type(qc, q, arg, WtStorage) }
      for ea in eargs { q = offer_row(qc, q, ea.lo, ea.hi) }
    }
    TQual(qual, name, args, eargs, lo, _) -> {
      q = offer_qual_type(qc, q, qual, name, lo)
      for arg in args { q = visit_written_type(qc, q, arg, WtStorage) }
      for ea in eargs { q = offer_row(qc, q, ea.lo, ea.hi) }
    }
    TAssoc(_, _, _, _) -> ()
    TTuple(elems, _, _) -> {
      for elem in elems { q = visit_written_type(qc, q, elem, WtStorage) }
    }
    TFn(params, ret, _, _, hi) -> {
      for param in params { q = visit_written_type(qc, q, param, WtStorage) }
      q = visit_written_type(qc, q, ret, WtReturn)
      q = offer_row(qc, q, t_hi(ret), hi)
    }
  }
  q
}

fn visit_param_types(qc: QCx, q0: Q, params: List[Param]) -> Q = {
  var q = q0
  for param in params { q = visit_written_type(qc, q, param.tref, WtStorage) }
  q
}

fn visit_lambda_param_types(qc: QCx, q0: Q, params: List[LambdaParam]) -> Q = {
  var q = q0
  for param in params {
    match param.ann {
      Some(tref) -> { q = visit_written_type(qc, q, tref, WtStorage) }
      None -> ()
    }
  }
  q
}

# ---- written names (docs/lsp-references-design.md §T0) ----
#
# The names a declaration's header and a few expression forms spell without a
# typed node to pair them with: written types, effect rows, `with handle E`,
# a handler arm's operation, the module alias of a qualified access, a
# record literal's field names, a call's argument names. Each is resolved from
# the entry module's tables, exactly as far as the checker resolved it.

## The spelling at `lo..hi` is `text`: the span is this revision's and the
## arithmetic that made it (a name's length from its start) holds.
fn spelled(qc: QCx, lo: Int, hi: Int, text: String) -> Bool = spelling(qc, lo, hi) == text

## A bare type name, at the span of the name.
fn offer_type_name(qc: QCx, q: Q, name: String, lo: Int, hi: Int) -> Q = {
  if not spelled(qc, lo, hi, name) { return q }
  # type parameters shadow everything
  for b in q.tps {
    if b.name == name { return offer(q, lo, hi, "type parameter " ++ name, Some((b.lo, b.hi)), None) }
  }
  match map.get(qc.entry.cx.aliases, name) {
    Some(al) -> return offer_at(q, lo, hi, alias_text(qc, al.name, al.is_opaque, map.get(qc.entry.cx.alias_resolved, name)),
      site_of_alias(qc, al.owner, al.name, al.nlo, al.nhi))
    None -> ()
  }
  match map.get(qc.entry.cx.btypes, name) {
    Some(_) -> return q
    None -> ()
  }
  match map.get(qc.entry.cx.adts_by_name, name) {
    Some(aid) -> offer_at(q, lo, hi, type_text(qc, aid), site_of_type(qc, aid))
    None -> q
  }
}

## `m.T`: the alias at its own span, then the type the exporter names `T`.
fn offer_qual_type(qc: QCx, q0: Q, qual: String, name: String, lo: Int) -> Q = {
  let q = offer_module_alias(qc, q0, qual, lo, lo + str.len(qual))
  let nlo = lo + str.len(qual) + 1
  let nhi = nlo + str.len(name)
  if not spelled(qc, nlo, nhi, name) { return q }
  match map.get(qc.entry.cx.module_exports, qual) {
    Some(exp) -> {
      match map.get(exp.aliases, name) {
        Some(al) -> return offer_at(q, nlo, nhi, alias_text(qc, al.name, al.is_opaque, map.get(exp.alias_resolved, name)),
          site_of_alias(qc, al.owner, al.name, al.nlo, al.nhi))
        None -> ()
      }
      match map.get(exp.types_by_name, name) {
        Some(aid) -> offer_at(q, nlo, nhi, type_text(qc, aid), site_of_type(qc, aid))
        None -> q
      }
    }
    None -> q
  }
}

## What a written type name hovers with: its declaration's own line.
fn type_text(qc: QCx, aid: Int) -> String = {
  let a = adt_of(qc.entry.cx.adts, aid)
  let summary = join(map(a.ctors, c => c.name), " | ")
  let derives =
    if len(a.derives) > 0 {
      " derive ${join(map(a.derives, t => trait_of(qc.entry.cx.traits, t).name), ", ")}"
    } else {
      ""
    }
  "type " ++ a.name ++ " = " ++ summary ++ derives
}

fn alias_text(qc: QCx, name: String, opaque: Bool, target: Option[Ty]) -> String =
  if opaque { "opaque type " ++ name }
  else {
    match target {
      Some(t) -> "alias " ++ name ++ " = " ++ show_ty(qc, t)
      None -> "alias " ++ name
    }
  }

## An alias declared in the module whose class is `owner` ("" for a context
## built outside a program, which can only be the entry's own).
fn site_of_alias(qc: QCx, owner: String, name: String, nlo: Int, nhi: Int) -> Site = {
  let o = if owner == "" { qc.entry.class_name } else { owner }
  match holder_by_class(qc, o) {
    Some(h) -> site_in(h, nlo, nhi, unwrap_or(decl_lo_named(h.m, name), nlo))
    None -> no_site()
  }
}

## A trait's declaration, and the line hover shows for it.
fn trait_ref(qc: QCx, tid: Int) -> Option[(String, Site)] = {
  let tr = trait_of(qc.entry.cx.traits, tid)
  let owner = match tr.owner {
    Some(o) -> o
    None -> qc.entry.class_name
  }
  match holder_by_class(qc, owner) {
    Some(h) -> {
      for d in h.m.decls {
        match d {
          DTrait(n, tp, _, _, _, _, _, _, lo, _, nlo, nhi) ->
            if n == tr.name { return Some(("trait " ++ n ++ "[" ++ tp ++ "]", site_in(h, nlo, nhi, lo))) }
          _ -> ()
        }
      }
      None
    }
    None -> None
  }
}

## A trait named by a bound (`[T: Ord]`).
fn offer_trait_name(qc: QCx, q: Q, name: String, lo: Int, hi: Int) -> Q =
  match map.get(qc.entry.cx.traits_by_name, name) {
    Some(tid) ->
      match trait_ref(qc, tid) {
        Some(r) -> {
          let (text, site) = r
          offer_at(q, lo, hi, text, site)
        }
        None -> q
      }
    None -> q
  }

## A function's or an impl's type parameters: each name, at its declaration,
## with its bounds; and the binders a written type in its scope resolves to.
fn visit_tparams(qc: QCx, q0: Q, tparams: List[TypeParamDecl]) -> (Q, List[TpBinder]) = {
  var q = q0
  var out: List[TpBinder] = []
  for tp in tparams {
    let b = TpBinder { name: tp.name, lo: tp.lo, hi: tp.lo + str.len(tp.name) }
    if spelled(qc, b.lo, b.hi, b.name) {
      out = out ++ [b]
      q = offer(q, b.lo, b.hi, "type parameter " ++ b.name, Some((b.lo, b.hi)), None)
    }
    for bd in tp.bounds { q = offer_trait_name(qc, q, bd.name, bd.lo, bd.hi) }
  }
  (q, out)
}

## The binders of a type's or a trait's parameter list, which the parse keeps
## as names only: read back off the text of the `[...]` that follows the
## declared name at `from`, in order. An effect binder (`!e`) is not a type
## parameter and is skipped; a name the text does not spell where the list
## says is not offered.
fn bracket_binders(qc: QCx, q0: Q, from: Int, names: List[String]) -> (Q, List[TpBinder]) = {
  var q = q0
  var out: List[TpBinder] = []
  let cps = qc.cps
  let n = len(cps)
  var i = from
  while i < n && (cps[i] == ' ' || cps[i] == '\t') { i = i + 1 }
  if i >= n || cps[i] != '[' || len(names) == 0 { return (q, out) }
  i = i + 1
  var k = 0
  var after_bang = false
  while i < n && cps[i] != ']' && k < len(names) {
    let c = cps[i]
    if is_ident_char(c) {
      let s0 = i
      while i < n && is_ident_char(cps[i]) { i = i + 1 }
      if not after_bang {
        let word = slice_cps(cps, s0, i)
        if word == names[k] {
          let b = TpBinder { name: word, lo: s0, hi: i }
          out = out ++ [b]
          q = offer(q, s0, i, "type parameter " ++ word, Some((s0, i)), None)
          k = k + 1
        }
      }
      after_bang = false
    } else {
      after_bang = c == '!'
      i = i + 1
    }
  }
  (q, out)
}

## A whole-module alias (`helper` in `helper.f`), as the `use` line that made
## it answers: the module it names. Anything else of that spelling is not an
## alias, since an alias and the module's other names share one namespace
## (spec §10.3).
fn offer_module_alias(qc: QCx, q: Q, mod_alias: String, lo: Int, hi: Int) -> Q =
  match map.get(qc.entry.cx.module_aliases, mod_alias) {
    Some(path) -> if spelled(qc, lo, hi, mod_alias) { offer_target(q, module_target(qc, path, lo, hi)) } else { q }
    None -> q
  }

## The receiver of a qualified access, when it is a module alias.
fn offer_alias_receiver(qc: QCx, q: Q, recv: Expr) -> Q =
  match recv {
    EVar(n, lo, hi) -> offer_module_alias(qc, q, n, lo, hi)
    _ -> q
  }

## A module as a `use` line names it: its path, its file (from the module's
## start), and its module doc.
fn module_target(qc: QCx, path: String, lo: Int, hi: Int) -> Target = {
  let (udef, upath) = match map.get(qc.exports_env, path) {
    Some(e) ->
      match e.src_path {
        Some(sp) -> {
          let d0: Option[(Int, Int)] = Some((0, 0))
          (d0, Some(sp))
        }
        # std exports carry no src_path, so the bundle's record answers for
        # them; an embedded std has no file and offers no jump
        None ->
          match std_file_of(qc.std, path) {
            Some(f) -> {
              let d0: Option[(Int, Int)] = Some((0, 0))
              (d0, Some(f))
            }
            None -> no_def()
          }
      }
    None -> no_def()
  }
  Target {
    lo: lo, hi: hi, hover: "use ${path}", def: udef, def_path: upath, sig: None,
    doc: module_doc_site(qc, path), expr: None
  }
}

## The declared effect an atom of a row names: `E` through this module's
## effect table, `m.E` through the alias's exports, as `cx.resolve_named_effect`
## reads them. `io`, an effect variable and a projection (`T.E`) name no
## declaration.
fn effect_id_of(qc: QCx, atom: String) -> Option[Int] =
  match str.split_once(atom, ".") {
    Some(pr) -> {
      let (m, e) = pr
      match map.get(qc.entry.cx.module_exports, m) {
        Some(exp) -> map.get(exp.effects, e)
        None -> None
      }
    }
    None -> map.get(qc.entry.cx.effects, atom)
  }

## The `effect` declaration behind an id, with the module that holds it.
fn effect_decl_of(qc: QCx, eid: Int) -> Option[(EffectDeclR, Holder)] = {
  let info = match map.get(qc.entry.cx.effect_infos, eid) {
    Some(i) -> i
    None -> return None
  }
  let owner = match info.owner {
    Some(o) -> o
    None -> qc.entry.class_name
  }
  match holder_by_class(qc, owner) {
    Some(h) -> {
      for d in h.m.decls {
        match d {
          DEffect(e) -> if e.name == info.name { return Some((e, h)) }
          _ -> ()
        }
      }
      None
    }
    None -> None
  }
}

fn site_of_effect(qc: QCx, eid: Int) -> Site =
  match effect_decl_of(qc, eid) {
    Some(pr) -> {
      let (e, h) = pr
      site_in(h, e.nlo, e.nhi, e.lo)
    }
    None -> no_site()
  }

fn site_of_op(qc: QCx, eid: Int, op: String) -> Site =
  match effect_decl_of(qc, eid) {
    Some(pr) -> {
      let (e, h) = pr
      for o in e.ops {
        if o.name == op { return site_in(h, o.nlo, o.nhi, o.lo) }
      }
      no_site()
    }
    None -> no_site()
  }

## One atom of a row or of `with handle`, written at `lo..hi`: a qualified one
## answers on both segments, the alias as a module and the name as the effect.
fn offer_effect_atom(qc: QCx, q0: Q, atom: String, lo: Int, hi: Int) -> Q = {
  if not spelled(qc, lo, hi, atom) { return q0 }
  let (q, nlo) = match str.split_once(atom, ".") {
    Some(pr) -> {
      let (m, _) = pr
      (offer_module_alias(qc, q0, m, lo, lo + str.len(m)), lo + str.len(m) + 1)
    }
    None -> (q0, lo)
  }
  match effect_id_of(qc, atom) {
    Some(eid) ->
      match map.get(qc.entry.cx.effect_infos, eid) {
        Some(info) -> offer_at(q, nlo, hi, "effect ${info.name}", site_of_effect(qc, eid))
        None -> q
      }
    None -> q
  }
}

## The atoms of the effect rows written in `from..to`, each with its span. The
## parse keeps a row as its atoms' names only (`FnDecl.effs`), so the spans
## are read back off the text: `!` opens a row, a name in it is an atom, and
## `=` or `{` -- the body -- ends the search. The callers start it past
## everything else a header can hold, so the only `!` it can meet is a row's.
fn effect_atoms(cps: List[Char], from: Int, to: Int) -> List[(String, Int, Int)] = {
  var out: List[(String, Int, Int)] = []
  let end = if to < len(cps) { to } else { len(cps) }
  var i = if from < 0 { 0 } else { from }
  var in_row = false
  while i < end {
    let c = cps[i]
    if c == '#' {
      while i < end && cps[i] != '\n' { i = i + 1 }
    } else if c == '=' || c == '{' {
      return out
    } else if c == '!' {
      in_row = true
      i = i + 1
    } else if in_row && is_ident_char(c) {
      let s0 = i
      while i < end && (is_ident_char(cps[i]) || cps[i] == '.') { i = i + 1 }
      out = out ++ [(slice_cps(cps, s0, i), s0, i)]
    } else {
      i = i + 1
    }
  }
  out
}

fn offer_row(qc: QCx, q0: Q, from: Int, to: Int) -> Q = {
  var q = q0
  for a in effect_atoms(qc.cps, from, to) {
    let (atom, lo, hi) = a
    q = offer_effect_atom(qc, q, atom, lo, hi)
  }
  q
}

## Where a declaration's own row starts: past its return type, or past the
## parameter list when it has none -- the list may hold `!` of its own, in a
## function-typed parameter.
fn row_start(qc: QCx, ret: Option[TypeRef], params_end: Int) -> Int =
  match ret {
    Some(r) -> t_hi(r)
    None -> {
      let cps = qc.cps
      var i = params_end
      while i < len(cps) && cps[i] != ')' { i = i + 1 }
      i + 1
    }
  }

## Where a parameter list's last entry ends, or the name before it when it is
## empty (`(` and `)` then sit between that and the row).
fn params_end(nhi: Int, params: List[Param]) -> Int =
  if len(params) == 0 { nhi } else { params[len(params) - 1].hi }

## The arguments of a call written with a name (`f(dy: 5)`), each at the name:
## the parameter it fills, at the declaration of that parameter.
fn offer_arg_names(qc: QCx, q0: Q, sg: Option[Sig], args: List[Arg]) -> Q = {
  let s = match sg {
    Some(s) -> s
    None -> return q0
  }
  var q = q0
  for a in args {
    match a.name {
      Some(n) ->
        if e_lo(a.e) != a.lo {
          match list.index_of(s.param_names, n) {
            Some(i) -> {
              let ty = match get(s.param_tys, i) {
                Some(t) -> show_ty(qc, t)
                None -> "?"
              }
              q = offer_at(q, a.lo, a.lo + str.len(n), n ++ ": " ++ ty, site_of_param(qc, s, i))
            }
            None -> ()
          }
        }
      None -> ()
    }
  }
  q
}

## The `i`th parameter of the function behind `s`, where it is declared. Only
## a top-level function takes a named argument (`ast.Param.default` says why
## the others refuse one), so only its declaration is looked in.
fn site_of_param(qc: QCx, s: Sig, i: Int) -> Site = {
  if s.is_builtin || s.trait_id != None || s.op_of != None { return no_site() }
  let owner = match s.owner {
    Some(o) -> o
    None -> qc.entry.class_name
  }
  match holder_by_class(qc, owner) {
    Some(h) -> {
      for d in h.m.decls {
        match d {
          DFn(f) ->
            if f.name == s.name {
              return match get(f.params, i) {
                Some(p) -> {
                  let st = site_in(h, p.lo, p.hi, p.lo)
                  Site { ..st, doc: None }
                }
                None -> no_site()
              }
            }
          _ -> ()
        }
      }
      no_site()
    }
    None -> no_site()
  }
}

## A `let`/`var` binding at its own name, which is where it is declared.
fn offer_binding(qc: QCx, q: Q, sid: Int, lo: Int, hi: Int) -> Q =
  match sym_get(qc, sid) {
    Some(sym) -> {
      let kw = if sym.mutable { "var" } else { "let" }
      let role = if sym.mutable { MutableRole } else { LetRole }
      offer_local(q, role, lo, hi, kw ++ " " ++ sym.name ++ ": " ++ show_ty(qc, sym.ty), (sym.dlo, sym.dhi))
    }
    None -> q
  }

## Field `fi` of constructor `ci`, at a span that names it.
fn offer_ctor_field(qc: QCx, q: Q, aid: Int, ci: Int, fi: Int, lo: Int, hi: Int) -> Q = {
  let a = adt_of(qc.entry.cx.adts, aid)
  match get(a.ctors, ci) {
    Some(c) ->
      match get(c.fields, fi) {
        Some(f) ->
          if spelled(qc, lo, hi, f.name) {
            offer_at(q, lo, hi, f.name ++ ": " ++ show_ty(qc, f.ty), site_of_ctor_field(qc, aid, ci, fi))
          } else {
            q
          }
        None -> q
      }
    None -> q
  }
}

fn site_of_ctor_field(qc: QCx, aid: Int, ci: Int, fi: Int) -> Site =
  match type_decl_of(qc, aid) {
    Some(pr) -> {
      let (t, h) = pr
      match get(t.ctors, ci) {
        Some(c) ->
          match get(c.fields, fi) {
            Some(f) -> site_in(h, f.lo, f.hi, f.lo)
            None -> no_site()
          }
        None -> no_site()
      }
    }
    None -> no_site()
  }

## The names a construction writes its arguments under (`Point { x: 1 }`,
## `Circle(r: 2.0)`). `{ x }` is also the local `x`, which the argument's own
## walk already answered for on that span, so a name that starts its
## expression is left to it.
fn offer_field_names(qc: QCx, q0: Q, aid: Int, ci: Int, args: List[Arg]) -> Q = {
  let a = adt_of(qc.entry.cx.adts, aid)
  let c = match get(a.ctors, ci) {
    Some(c) -> c
    None -> return q0
  }
  var q = q0
  for arg in args {
    match arg.name {
      Some(n) ->
        if e_lo(arg.e) != arg.lo {
          match field_index(c, n) {
            Some(fi) -> { q = offer_ctor_field(qc, q, aid, ci, fi, arg.lo, arg.lo + str.len(n)) }
            None -> ()
          }
        }
      None -> ()
    }
  }
  q
}

## The operation each arm of `with handle E` answers, at the arm's name.
fn offer_arm_names(qc: QCx, q0: Q, eff_name: String, arms: List[HandlerArm]) -> Q = {
  let eid = match effect_id_of(qc, eff_name) {
    Some(e) -> e
    None -> return q0
  }
  let owner = match map.get(qc.entry.cx.effect_infos, eid) {
    Some(info) -> info.owner
    None -> return q0
  }
  var q = q0
  for arm in arms {
    match sig_by_owner(qc, owner, arm.name, None) {
      Some(s) -> {
        if spelled(qc, arm.nlo, arm.nhi, arm.name) {
          q = offer_sig_at(qc, q, arm.nlo, arm.nhi, s, site_of_op(qc, eid, arm.name))
        }
      }
      None -> ()
    }
  }
  q
}

# ---- declarations ----

fn visit_decl(qc: QCx, q0: Q, d: Decl) -> Q = {
  # a declaration's type parameters are its own: none is in scope at the next
  var q = Q { ..q0, tps: [] }
  match d {
    DFn(f) -> {
      q = visit_fn_decl(qc, q, f, [identity.Named(identity.FunctionDecl, f.name)])
    }
    DTest(name, body, _, _, _, _, _) -> {
      let tf = tfun_at(qc, [identity.Named(identity.TestDecl, name)])
      q = walk_e(qc, q, body, tf_body(tf))
    }
    DConst(name, _, ann, init, lo, _, nlo, nhi) -> {
      q = visit_written_type(qc, q, ann, WtStorage)
      match map.get(qc.entry.cx.consts, name) {
        Some(t) -> {
          q = offer_at(q, nlo, nhi, const_text(qc, qc.entry.mod_path, name, t), here(nlo, nhi, lo))
        }
        None -> ()
      }
      q = walk_e(qc, q, init, tconst_init(qc, name))
    }
    DUseJava(fqcn, _, _, nlo, nhi) -> {
      q = offer(q, nlo, nhi, "use java \"" ++ fqcn ++ "\"", Some((nlo, nhi)), None)
    }
    DUseModule(segs, selective, _, _, _, nlo, nhi) -> {
      let path = join(segs, "/")
      let exp = map.get(qc.exports_env, path)
      q = offer_target(q, module_target(qc, path, nlo, nhi))
      match exp {
        Some(e) ->
          match selective {
            Some(names) -> {
              for imp in names { q = visit_selective(qc, q, e, imp) }
            }
            None -> ()
          }
        None -> ()
      }
    }
    DTrait(name, tp, _, _, methods, _, _, _, lo, _, nlo, nhi) -> {
      q = offer_at(q, nlo, nhi, "trait " ++ name ++ "[" ++ tp ++ "]", here(nlo, nhi, lo))
      let (qb, bs) = bracket_binders(qc, q, nhi, [tp])
      q = Q { ..qb, tps: bs }
      let tid = map.get(qc.entry.cx.traits_by_name, name)
      for m in methods {
        q = visit_param_types(qc, q, m.params)
        q = visit_written_type(qc, q, m.ret, WtReturn)
        let row_end = match m.body {
          Some(b) -> e_lo(b)
          None -> m.hi
        }
        q = offer_row(qc, q, t_hi(m.ret), row_end)
        match tid {
          Some(t) -> {
            let tr = trait_of(qc.entry.cx.traits, t)
            for pr in tr.methods {
              let (mn, ms) = pr
              if mn == m.name {
                q = offer_sig_at(qc, q, m.nlo, m.nhi, ms.sig, here(m.nlo, m.nhi, m.lo))
              }
            }
          }
          None -> ()
        }
        match m.body {
          Some(b) -> {
            let tf = tfun_at(qc, [identity.Named(identity.TraitDecl, name), identity.Named(identity.MethodDecl, m.name)])
            q = walk_e(qc, q, b, tf_body(tf))
          }
          None -> ()
        }
      }
    }
    DEffect(e) -> {
      q = offer_at(q, e.nlo, e.nhi, "effect ${e.name}", here(e.nlo, e.nhi, e.lo))
      for op in e.ops {
        q = visit_param_types(qc, q, op.params)
        q = visit_written_type(qc, q, op.ret, WtReturn)
        match map.get(qc.entry.cx.fns, op.name) {
          Some(sg) -> { q = offer_sig_at(qc, q, op.nlo, op.nhi, sg, here(op.nlo, op.nhi, op.lo)) }
          None -> ()
        }
      }
    }
    DImpl(tparams, trait_name, tlo, thi, subject, methods, assoc, _, _, _) -> {
      q = offer(q, tlo, thi, "impl " ++ trait_name ++ "[...]", Some((tlo, thi)), None)
      let (qb, bs) = visit_tparams(qc, q, tparams)
      q = Q { ..qb, tps: bs }
      q = visit_written_type(qc, q, subject, WtStorage)
      for binding in assoc { q = visit_written_type(qc, q, binding.tref, WtStorage) }
      let head = impl_head(tparams, trait_name, subject)
      for m in methods { q = visit_fn_decl(qc, q, m, method_path(head, m.name)) }
    }
    DType(t) -> {
      let (qb, bs) = bracket_binders(qc, q, t.nhi, t.tparams)
      q = Q { ..qb, tps: bs }
      match t.alias_target {
        Some(target) -> { q = visit_written_type(qc, q, target, WtStorage) }
        None -> ()
      }
      for ctor in t.ctors {
        for field in ctor.fields { q = visit_written_type(qc, q, field.tref, WtStorage) }
      }
      let info = map.get(qc.entry.cx.adts_by_name, t.name)
      let summary = match info {
        Some(aid) -> {
          let a = adt_of(qc.entry.cx.adts, aid)
          join(map(a.ctors, c => c.name), " | ")
        }
        None -> ""
      }
      let derives =
        if len(t.derives) > 0 {
          " derive ${join(map(t.derives, b => b.name), ", ")}"
        } else {
          ""
        }
      q = offer_at(q, t.nlo, t.nhi, "type " ++ t.name ++ " = " ++ summary ++ derives,
        here(t.nlo, t.nhi, t.lo))
      match info {
        Some(aid) -> {
          let a = adt_of(qc.entry.cx.adts, aid)
          var ci = 0
          for c in t.ctors {
            match get(a.ctors, ci) {
              Some(cinfo) -> {
                q = offer_at(q, c.nlo, c.nhi, render_ctor(qc, cinfo), here(c.nlo, c.nhi, c.lo))
                var fi = 0
                for f in c.fields {
                  match get(cinfo.fields, fi) {
                    Some(finfo) -> {
                      q = offer_at(q, f.lo, f.hi, f.name ++ ": " ++ show_ty(qc, finfo.ty),
                        here(f.lo, f.hi, f.lo))
                    }
                    None -> ()
                  }
                  fi = fi + 1
                }
              }
              None -> ()
            }
            ci = ci + 1
          }
        }
        None -> ()
      }
    }
  }
  q
}

# ---- comptime values (docs/lsp-hover-design.md §3) ----

## The checked state a constant's value is read from: the module that declared
## it, whose analysis already ran comptime over it (`analyze.analyze_module_step`) --
## hover evaluates nothing.
type ValueHome = { cx: Cx, tm: TModule, ct: CtOut, own: Bool }

## The module a constant reference names. A qualified `m.NAME` carries its
## owner; a bare one carries "" and is either declared here or imported by a
## `use m.{NAME}` line -- the same two places `site_of_const` looks.
fn const_owner(qc: QCx, owner: String, name: String) -> String =
  if owner != "" { owner }
  else {
    match const_decl_span(qc.entry.m, name) {
      Some(_) -> qc.entry.mod_path
      None ->
        match map.get(qc.entry.cx.imported_names, name) {
          Some(mp) -> mp
          None -> qc.entry.mod_path
        }
    }
  }

fn value_home(qc: QCx, mod_path: String) -> Option[ValueHome] = {
  let e = qc.entry
  if mod_path == e.mod_path { return Some(ValueHome { cx: e.cx, tm: e.tm, ct: e.ct, own: true }) }
  for cm in qc.prog.modules {
    if cm.mod_path == mod_path { return Some(ValueHome { cx: cm.cx, tm: cm.tm, ct: cm.ct, own: false }) }
  }
  for sm in qc.std.mods {
    let (mp, cx, tm, ct) = sm
    if mp == mod_path { return Some(ValueHome { cx: cx, tm: tm, ct: ct, own: false }) }
  }
  None
}

## `const NAME: T = value`, or the type alone with a second line saying why
## there is no value: comptime is skipped for a module the checker refused
## (`analyze.analyze_module_step` runs it only when `cx.diags` is empty), and a constant
## whose evaluation failed has its diagnostic in `ct.diags`, at the span the
## interpreter folded it under -- the constant's own (`interp.eval_module`).
fn const_text(qc: QCx, mod_path: String, name: String, t: Ty) -> String = {
  let head = "const " ++ name ++ ": " ++ show_ty(qc, t)
  match value_home(qc, mod_path) {
    None -> head
    Some(h) ->
      match map.get(h.ct.consts, name) {
        Some(v) ->
          match value_text(h.cx.adts, t, v) {
            Some(vt) -> head ++ " = " ++ vt
            None -> head
          }
        None -> {
          head ++ "\n" ++ not_evaluated(h, mod_path, tconst_span(h.tm, name))
        }
      }
  }
}

## `comptime: T = value` for the block folded at `(lo, hi)` -- the typed tree's
## span, the key `interp.eval_block` filed the value under.
fn comptime_text(qc: QCx, lo: Int, hi: Int, t: Ty) -> String = {
  let head = "comptime: " ++ show_ty(qc, t)
  let e = qc.entry
  match map.get(e.ct.blocks, (lo, hi)) {
    Some(v) ->
      match value_text(e.cx.adts, t, v) {
        Some(vt) -> head ++ " = " ++ vt
        None -> head
      }
    None ->
      head ++ "\n" ++
      not_evaluated(ValueHome { cx: e.cx, tm: e.tm, ct: e.ct, own: true }, e.mod_path, Some((lo, hi)))
  }
}

## The first constant of that name: a repeat is a module the checker refused,
## which never reaches the span lookup.
fn tconst_span(tm: TModule, name: String) -> Option[(Int, Int)] = {
  for tc in tm.consts {
    if tc.name == name { return Some((tc.lo, tc.hi)) }
  }
  None
}

fn not_evaluated(h: ValueHome, mod_path: String, span: Option[(Int, Int)]) -> String = {
  if len(h.cx.diags) > 0 {
    return if h.own { "(not evaluated: module has errors)" }
    else { "(not evaluated: module " ++ mod_path ++ " has errors)" }
  }
  match span {
    Some(sp) -> {
      let (lo, hi) = sp
      for d in h.ct.diags {
        if d.lo == lo && d.hi == hi {
          let first = match str.split_once(d.msg, "\n") {
            Some(pr) -> {
              let (a, _) = pr
              a
            }
            None -> d.msg
          }
          let reason = match str.strip_prefix(first, "comptime: ") {
            Some(r) -> r
            None -> first
          }
          return "(not evaluated: " ++ reason ++ ")"
        }
      }
    }
    None -> ()
  }
  "(not evaluated)"
}

fn tf_body(tf: Option[TFun]) -> Option[TExpr] =
  match tf {
    Some(f) -> Some(f.body)
    None -> None
  }

fn tconst_init(qc: QCx, name: String) -> Option[TExpr] =
  match map.get(qc.typed.consts, identity.path_text([identity.Named(identity.ConstDecl, name)])) {
    Some(tc) -> Some(tc.init)
    None -> None
  }

fn visit_fn_decl(qc: QCx, q0: Q, f: FnDecl, path: List[identity.Part]) -> Q = {
  # an impl method sees its impl's parameters as well as its own
  let (qb, bs) = visit_tparams(qc, q0, f.tparams)
  var q = Q { ..qb, tps: q0.tps ++ bs }
  q = visit_param_types(qc, q, f.params)
  match f.ret {
    Some(ret) -> { q = visit_written_type(qc, q, ret, WtReturn) }
    None -> ()
  }
  q = offer_row(qc, q, row_start(qc, f.ret, params_end(f.nhi, f.params)), e_lo(f.body))
  match sig_of(qc, f.name) {
    Some(s) -> { q = offer_sig_at(qc, q, f.nlo, f.nhi, s, here(f.nlo, f.nhi, f.lo)) }
    None -> ()
  }
  let tf = tfun_at(qc, path)
  match tf {
    Some(t) -> {
      var i = 0
      for p in f.params {
        match get(t.param_syms, i) {
          Some(sid) ->
            match sym_get(qc, sid) {
              Some(sym) -> {
                q = offer_local(q, ParamRole, p.lo, p.hi, p.name ++ ": " ++ show_ty(qc, sym.ty), (p.lo, p.hi))
              }
              None -> ()
            }
          None -> ()
        }
        i = i + 1
      }
    }
    None -> ()
  }
  Q { ..walk_e(qc, q, f.body, tf_body(tf)), tps: q0.tps }
}

## Hover and definition on one selective-import entry. A renamed entry
## (`Name as Local`) answers on both halves: the local name is the one the rest
## of the file writes, so it is the one a reader points at.
fn visit_selective(qc: QCx, q0: Q, exp: ModExports, imp: ImportName) -> Q = {
  let q1 = visit_selective_at(qc, q0, exp, imp)
  match imp.local {
    Some(r) -> visit_selective_at(qc, q1, exp, ImportName { ..imp, lo: r.lo, hi: r.hi })
    None -> q1
  }
}

fn visit_selective_at(qc: QCx, q0: Q, exp: ModExports, imp: ImportName) -> Q = {
  var q = q0
  match map.get(exp.fns, imp.name) {
    Some(s) -> {
      q = offer_sig_at(qc, q, imp.lo, imp.hi, s, site_of_sig(qc, s))
    }
    None -> ()
  }
  match map.get(exp.types_by_name, imp.name) {
    Some(aid) -> {
      let a = adt_of(qc.entry.cx.adts, aid)
      let summary = join(map(a.ctors, c => c.name), " | ")
      q = offer_at(q, imp.lo, imp.hi, "type " ++ a.name ++ " = " ++ summary, site_of_type(qc, aid))
    }
    None -> ()
  }
  match map.get(exp.ctors, imp.name) {
    Some(k) -> {
      let (aid, ci) = k
      let a = adt_of(qc.entry.cx.adts, aid)
      match get(a.ctors, ci) {
        Some(c) -> {
          q = offer_at(q, imp.lo, imp.hi, render_ctor(qc, c), site_of_ctor(qc, aid, c.name))
        }
        None -> ()
      }
    }
    None -> ()
  }
  match map.get(exp.consts, imp.name) {
    Some(t) -> {
      q = offer_at(q, imp.lo, imp.hi, const_text(qc, exp.mod_path, imp.name, t), site_of_const_in(qc, exp.mod_path, imp.name))
    }
    None -> ()
  }
  # a trait or an effect has no table that renders it, so its declaration does
  if map.has(exp.traits_by_name, imp.name) || map.has(exp.effects, imp.name) {
    match holder_by_path(qc, exp.mod_path) {
      Some(h) -> {
        for d in h.m.decls {
          match d {
            DTrait(n, tp, _, _, _, _, _, _, lo, _, nlo, nhi) -> if n == imp.name {
              q = offer_at(q, imp.lo, imp.hi, "trait " ++ n ++ "[" ++ tp ++ "]", site_in(h, nlo, nhi, lo))
            }
            DEffect(e) -> if e.name == imp.name {
              q = offer_at(q, imp.lo, imp.hi, "effect ${e.name}", site_in(h, e.nlo, e.nhi, e.lo))
            }
            _ -> ()
          }
        }
      }
      None -> ()
    }
  }
  q
}

# ---- expressions ----

## The function a synthesised eta wrapper stands for, as (owner, name). A
## wrapper's body is the call and nothing else, so anything with a shape of its
## own is somebody's real lambda and answers `None`.
fn eta_target(body: TExpr) -> Option[(Option[String], String)] =
  match body {
    XCallFn(owner, name, _, _, _, _, _, _, _) -> Some((owner, name))
    XCallBuiltin(name, _, _, _, _, _, _) -> {
      let no_owner: Option[String] = None
      Some((no_owner, name))
    }
    _ -> None
  }

## The parameters of a lambda-shaped thing, each at its own span. The written
## params and the checker's symbols are paired positionally; a handler arm is
## one of these too, since the checker makes a closure of it.
fn offer_lambda_params(qc: QCx, q0: Q, params: List[LambdaParam], psyms: List[Int]) -> Q = {
  var q = q0
  var i = 0
  for p in params {
    match get(psyms, i) {
      Some(sid) ->
        match sym_get(qc, sid) {
          Some(sym) -> {
            q = offer_local(q, ParamRole, p.lo, p.hi, sym.name ++ ": " ++ show_ty(qc, sym.ty), (p.lo, p.hi))
          }
          None -> ()
        }
      None -> ()
    }
    i = i + 1
  }
  q
}

# ---- handler state cells ----
#
# `with handle` has no typed node of its own: the checker rewrites it
# (`check.checker.check_handle`, docs/handler-state-design.md) into a block
# holding one `TSLet` per state cell, then a `TSLet` for the effect's evidence
# record whose fields are the arms, with the remainder applied as the tail. A
# cell's every read is a `cell_get`/`cell_take` on the slot and its every write
# is a `cell_set`, so neither reaches here as the `XLocal`/`TSAssign` an
# ordinary binding would. Pairing the two trees is therefore this file's job
# rather than a shape it can match on directly.

## The pieces of the typed block: its statements, and the remainder closure the
## tail call applies. Any other shape is not one `check_handle` builds, and the
## walk continues parse-only.
fn handle_parts(te: Option[TExpr]) -> (List[Option[TStmt]], Option[TExpr]) =
  match te {
    Some(XBlock(ts, tail, _, _, _)) -> {
      let trest: Option[TExpr] = match tail {
        Some(XApply(target, _, _, _, _, _)) -> Some(target)
        _ -> None
      }
      (opt_stmts(ts), trest)
    }
    _ -> {
      let none: List[Option[TStmt]] = []
      let notail: Option[TExpr] = None
      (none, notail)
    }
  }

## The initializer inside one cell's `TSLet`: the slot is made by `cell_new`,
## so what the author wrote is that primitive's only argument.
fn cell_init_of(ts: Option[TStmt]) -> Option[TExpr] =
  match ts {
    Some(TSLet(_, _, XCallBuiltin(prim, args, _, _, _, _, _), _, _)) ->
      if prim == "cell_new" { get(args, 0) } else { None }
    _ -> None
  }

## The arms, out of the evidence record they are stored in. The record's last
## field is the environment the arms run in rather than an arm, and an
## unanswered operation stands in it as an `XError`; `arm_node_at` is what
## tells the arms from both.
fn handle_arm_nodes(ts: Option[TStmt]) -> List[TExpr] =
  match ts {
    Some(TSLet(_, _, XCtor(_, _, written, _, _, _, _, _), _, _)) -> written
    _ -> []
  }

## The closure the checker made of one written arm, found by the arm's own
## span: the record holds the arms in the effect's *declared* operation order,
## which is not the order they were written in.
fn arm_node_at(tarms: List[TExpr], lo: Int, hi: Int) -> Option[TExpr] = {
  for a in tarms {
    if x_lo(a) == lo && x_hi(a) == hi { return Some(a) }
  }
  None
}

fn is_cell_read(prim: String) -> Bool = prim == "cell_get" || prim == "cell_take"

## The cell a cell primitive names. The slot is always its first argument and
## always the local `check.checker.cell_local` made of the binding.
fn cell_arg_sym(args: List[TExpr]) -> Option[Int] =
  match get(args, 0) {
    Some(XLocal(sid, _, _, _, _)) -> Some(sid)
    _ -> None
  }

## The right-hand side of a cell write, which is `cell_set`'s second argument.
fn cell_set_args(x: TExpr) -> Option[List[TExpr]] =
  match x {
    XCallBuiltin(prim, args, _, _, _, _, _) ->
      if prim == "cell_set" { Some(args) } else { None }
    _ -> None
  }

## A handler state cell at one of its spellings.
##
## The type is the slot's, read off `Sym.cell_of`, because `Sym.ty` is the
## erased cell the binding holds at run time (`check.types.Sym`) and no reader
## wants to see that. The keyword is `var` although the symbol is not
## `mutable`: what an arm writes is the slot, not the binding, and `var` is
## what the author wrote.
fn offer_cell(qc: QCx, q0: Q, sid: Int, lo: Int, hi: Int) -> Q =
  match sym_get(qc, sid) {
    Some(sym) ->
      match sym.cell_of {
        Some(co) -> {
          let (_, ct) = co
          let hover = "var " ++ sym.name ++ ": " ++ show_ty(qc, ct)
          # the declaration is the one span that is its own site
          if (lo, hi) == (sym.dlo, sym.dhi) {
            offer_local(q0, MutableRole, lo, hi, hover, (sym.dlo, sym.dhi))
          } else {
            offer(q0, lo, hi, hover, Some((sym.dlo, sym.dhi)), None)
          }
        }
        None -> q0
      }
    None -> q0
  }

## The declaration itself, at the name it declares -- the one span where a cell
## is its own definition.
fn offer_cell_decl(qc: QCx, q0: Q, ts: Option[TStmt], c: HandlerCell) -> Q =
  match ts {
    Some(TSLet(Some(sid), _, _, _, _)) -> offer_cell(qc, q0, sid, c.nlo, c.nhi)
    _ -> q0
  }

## One arm against the closure the checker made of it: `op(a, b) => body` is a
## lambda in everything but spelling, so the pairing is `ELambda`'s.
fn walk_handler_arm(qc: QCx, q0: Q, arm: HandlerArm, ta: Option[TExpr]) -> Q =
  match ta {
    Some(XLambda(psyms, _, tbody, _, _, _, _)) -> {
      let q = offer_lambda_params(qc, q0, arm.params, psyms)
      walk_e(qc, q, arm.body, Some(tbody))
    }
    _ -> walk_e(qc, q0, arm.body, None)
  }

## The rest of the block. `ast.EHandle.rest` is the parameterless sugar lambda
## the parser packed the remaining statements into, and the checker checked it
## as one; neither half of that pair is anything the author wrote, so the walk
## steps through both and pairs the bodies.
fn walk_rest(qc: QCx, q0: Q, rest: Expr, trest: Option[TExpr]) -> Q = {
  let tbody: Option[TExpr] = match trest {
    Some(XLambda(_, _, b, _, _, _, _)) -> Some(b)
    _ -> None
  }
  match rest {
    ELambda(_, body, _, _, _) -> walk_e(qc, q0, body, tbody)
    _ -> walk_e(qc, q0, rest, trest)
  }
}

# ---- literals (docs/lsp-hover-design.md §4) ----

## A literal's type, then the value line `lspv` renders for it, both in the one
## fence. Offered over the literal's own span after the generic fallback, so on
## the same span this one wins; with no typed tree there is no type line to
## head it, and the literal is left to the fallback's silence.
fn offer_literal(qc: QCx, q: Q, te: Option[TExpr], lo: Int, hi: Int, line: String) -> Q =
  match te {
    Some(t) -> offer(q, lo, hi, show_ty(qc, tex_ty(t)) ++ "\n" ++ line, None, None)
    None -> q
  }

## The source text of `lo..hi`, empty when the span is not inside the document
## (an analysis of another revision): the renderers then fall back to the
## value alone.
fn spelling(qc: QCx, lo: Int, hi: Int) -> String =
  if lo < 0 || hi > len(qc.cps) || lo >= hi { "" } else { slice_cps(qc.cps, lo, hi) }

## The text of a string literal with no interpolation; `None` for one with any.
fn literal_string(parts: List[StrPart]) -> Option[String] = {
  var out = ""
  for p in parts {
    match p {
      SPText(t) -> { out = out ++ t }
      SPInterp(_) -> return None
    }
  }
  Some(out)
}

fn walk_e(qc: QCx, q0: Q, pe: Expr, te: Option[TExpr]) -> Q = {
  var q = q0
  # generic fallback: the expression's own type, which names no declaration
  # and so is only worth printing where it can be the answer
  match te {
    Some(t) ->
      if live(q, e_lo(pe), e_hi(pe)) {
        q = offer_target(q, Target {
          lo: e_lo(pe), hi: e_hi(pe), hover: show_ty(qc, tex_ty(t)), def: None, def_path: None,
          sig: None, doc: None, expr: Some(t)
        })
      }
    None -> ()
  }
  match pe {
    EVar(name, lo, hi) ->
      match te {
        Some(XLocal(sid, _, _, _, _)) ->
          match sym_get(qc, sid) {
            Some(sym) -> {
              let kw = if sym.mutable { "var" } else { "let" }
              q = offer(q, lo, hi, kw ++ " " ++ sym.name ++ ": " ++ show_ty(qc, sym.ty),
                Some((sym.dlo, sym.dhi)), None)
            }
            None -> ()
          }
        Some(XFnValue(owner, fname, _, _, _, _)) ->
          match sig_by_owner(qc, owner, fname, None) {
            Some(s) -> {
              q = offer_sig_at(qc, q, lo, hi, s, site_of_sig(qc, s))
            }
            None -> ()
          }
        # A bounded name is an eta expansion by the time it is typed, and the
        # reader still pointed at a function name. Only a synthesised wrapper
        # can be here: a lambda somebody wrote is an `ELambda`, not an `EVar`.
        Some(XLambda(_, _, body, _, _, _, _)) ->
          match eta_target(body) {
            Some(t) -> {
              let (towner, fname) = t
              match sig_by_owner(qc, towner, fname, None) {
                Some(s) -> {
                  q = offer_sig_at(qc, q, lo, hi, s, site_of_sig(qc, s))
                }
                None -> ()
              }
            }
            None -> ()
          }
        # A handler state cell is not read through its binding: the checker
        # rewrites every read of the name into `cell_get`/`cell_take` on the
        # slot (docs/handler-state-design.md). The reader still wrote a name,
        # so the name still answers -- as the cell, at the type the slot holds.
        Some(XCallBuiltin(prim, cargs, _, _, _, _, _)) -> {
          if is_cell_read(prim) {
            match cell_arg_sym(cargs) {
              Some(sid) -> { q = offer_cell(qc, q, sid, lo, hi) }
              None -> ()
            }
          }
        }
        # no typed node: a qualified access's receiver, which the checker
        # never typed because it is a module alias rather than a value
        None -> { q = offer_module_alias(qc, q, name, lo, hi) }
        _ -> ()
      }
    ELambda(params, body, _, _, _) -> {
      q = visit_lambda_param_types(qc, q, params)
      match te {
        Some(XLambda(psyms, _, tbody, _, _, _, _)) -> {
          q = offer_lambda_params(qc, q, params, psyms)
          q = hint_lambda_params(qc, q, params, psyms)
          q = walk_e(qc, q, body, Some(tbody))
        }
        _ -> { q = walk_e(qc, q, body, None) }
      }
    }
    # one application node, so this arm answers for every shape of call: a name
    # (the sig at the name's span), a constructor, and a function value. The
    # callee of the first two is not walked as a value -- it is not one.
    EApply(target, args0, _, ahi) -> {
      let args = arg_exprs(args0)
      match target {
        EVar(callee, vlo, vhi) -> {
          q = walk_named_call(qc, q, callee, vlo, vhi, args, te)
          q = hint_named_call(qc, q, callee, args0, vhi, ahi, te)
          q = offer_arg_names(qc, q, call_sig(qc, callee, te), args0)
        }
        ECtor(cname, clo, chi) -> { q = walk_ctor_call(qc, q, args0, None, clo, chi, te) }
        # `recv.member(args)`, whose callee is never a value: the checker
        # decides what it is, and each answer parks the receiver and the
        # arguments in its own typed node rather than under an `XApply`. Left
        # to `walk_apply_value` the shapes would not match and every type
        # inside the call would be dropped.
        EFieldAcc(recv, _, flo, fhi, _, _) ->
          match te {
            # a Java call (SYN-09): receiver and arguments hang off TJavaCall
            Some(XJava(call, _, _, _)) -> {
              match call.target {
                Some(tt) -> { q = walk_e(qc, q, recv, Some(tt)) }
                None -> { q = walk_e(qc, q, recv, None) }
              }
              q = walk_list(qc, q, args, opt_list(call.args))
            }
            # `m.C(a, b)`: a module-qualified construction (LANG-06), which is
            # an `XCtor` exactly as the unqualified `C(a, b)` is. The receiver
            # is a module alias, not a value, so it is not walked -- and the
            # constructor's signature belongs at the *name's* span, which is
            # what `flo`/`fhi` carry.
            Some(XCtor(_, _, _, _, _, _, _, _)) -> {
              q = offer_alias_receiver(qc, q, recv)
              q = walk_ctor_call(qc, q, args0, None, flo, fhi, te)
            }
            # `x |> m.f`, `(m.f)(x)`: a module function in callee position is
            # the static call `m.f(x)`, the same `XCallFn` a bare `f` gets, so
            # it is answered as one: the signature at the name's span, the
            # typed arguments, the parameter-name hints. A default or a named
            # argument can wrap the call in a block, hence `call_node`.
            _ ->
              match call_node(te) {
                Some(XCallFn(_, fname, _, _, _, _, _, _, _)) -> {
                  q = offer_alias_receiver(qc, q, recv)
                  q = walk_named_call(qc, q, fname, flo, fhi, args, call_node(te))
                  q = hint_named_call(qc, q, fname, args0, fhi, ahi, te)
                  q = offer_arg_names(qc, q, call_sig(qc, fname, te), args0)
                }
                _ -> { q = walk_apply_value(qc, q, target, args, te) }
              }
          }
        _ -> { q = walk_apply_value(qc, q, target, args, te) }
      }
    }
    EIndex(target, index, _, _) ->
      match te {
        Some(XIndex(tt, ti, _, _, _, _)) -> {
          q = walk_e(qc, q, target, Some(tt))
          q = walk_e(qc, q, index, Some(ti))
        }
        _ -> {
          q = walk_e(qc, q, target, None)
          q = walk_e(qc, q, index, None)
        }
      }
    EReturn(v, _, _) ->
      match v {
        Some(e) ->
          match te {
            Some(XReturn(tv, _, _)) -> { q = walk_e(qc, q, e, tv) }
            _ -> { q = walk_e(qc, q, e, None) }
          }
        None -> ()
      }
    EMethod(target, name, args0, nlo, nhi, _, mhi) -> { q = walk_method(qc, q, target, name, args0, nlo, nhi, mhi, te) }
    EListLit(elems, _, _) -> {
      let es = elem_exprs(elems)
      match te {
        Some(XListLit(telems, _, _, _)) ->
          { q = walk_list(qc, q, es, opt_list(telem_exprs(telems))) }
        _ -> { q = walk_list(qc, q, es, no_texprs(es)) }
      }
    }
    ETupleLit(elems, _, _) ->
      match te {
        Some(XTupleLit(telems, _, _, _)) -> { q = walk_list(qc, q, elems, opt_list(telems)) }
        _ -> { q = walk_list(qc, q, elems, no_texprs(elems)) }
      }
    ECtor(_, clo, chi) -> {
      let none: List[Arg] = []
      q = walk_ctor_call(qc, q, none, None, clo, chi, te)
    }
    ERecord(_, fields, spread, nlo, nhi, _, _) -> {
      q = walk_ctor_call(qc, q, fields, spread, nlo, nhi, te)
    }
    EFieldAcc(target, _, flo, fhi, _, _) ->
      match te {
        Some(XField(tt, fi, _, _, _)) -> {
          q = walk_e(qc, q, target, Some(tt))
          match tex_ty(tt) {
            TyAdt(aid, _) -> {
              let a = adt_of(qc.entry.cx.adts, aid)
              if a.is_record && len(a.ctors) > 0 {
                match get(a.ctors[0].fields, fi) {
                  Some(f) -> {
                    q = offer_at(q, flo, fhi, f.name ++ ": " ++ show_ty(qc, f.ty), site_of_field(qc, aid, fi))
                  }
                  None -> ()
                }
              }
            }
            _ -> ()
          }
        }
        # `m.NAME`: a module-qualified constant (LANG-06 step 3). The receiver
        # is a module alias, not a value, so only the name is offered.
        Some(XConstRef(owner, cname, _, _, cty)) -> {
          q = offer_alias_receiver(qc, q, target)
          q = offer_at(q, flo, fhi, const_text(qc, owner, cname, cty), site_of_const_in(qc, owner, cname))
        }
        # `let g = m.f`: a module function used as a value (#66), answered as
        # the bare `f`'s `XFnValue` is. Only the name is offered: the receiver
        # is an alias, not a value.
        Some(XFnValue(owner, fname, _, _, _, _)) -> {
          q = offer_alias_receiver(qc, q, target)
          match sig_by_owner(qc, owner, fname, None) {
            Some(s) -> { q = offer_sig_at(qc, q, flo, fhi, s, site_of_sig(qc, s)) }
            None -> ()
          }
        }
        _ -> { q = walk_e(qc, q, target, None) }
      }
    EInt(v, lo, hi) ->
      # no line (a single decimal digit): the generic type offer above stands
      match int_literal_text(spelling(qc, lo, hi), v) {
        Some(line) -> { q = offer_literal(qc, q, te, lo, hi, line) }
        None -> ()
      }
    EChar(v, lo, hi) -> { q = offer_literal(qc, q, te, lo, hi, char_literal_text(v)) }
    EFloat(v, lo, hi) -> { q = offer_literal(qc, q, te, lo, hi, float_literal_text(spelling(qc, lo, hi), v)) }
    EStr(parts, lo, hi) -> {
      # only a string with no interpolation is a literal: one with `${...}`
      # is an expression, and its type is all there is to say about it
      match literal_string(parts) {
        Some(s) -> { q = offer_literal(qc, q, te, lo, hi, string_literal_text(s)) }
        None -> ()
      }
      let no_parts: List[Option[TExpr]] = []
      let tparts = match te {
        Some(XStr(tp, _, _)) -> interp_texprs(tp)
        _ -> no_parts
      }
      var i = 0
      for p in parts {
        match p {
          SPInterp(e) -> {
            q = walk_e(qc, q, e, opt_get2(tparts, i))
            i = i + 1
          }
          SPText(_) -> ()
        }
      }
    }
    EComptime(body, _, _) ->
      match te {
        Some(XComptime(tb, lo, hi, ty)) -> {
          # the whole block, so anywhere in it no inner node claims answers
          # with the block's value -- the `comptime` keyword above all
          q = offer(q, e_lo(pe), e_hi(pe), comptime_text(qc, lo, hi, ty), None, None)
          q = walk_e(qc, q, body, Some(tb))
        }
        _ -> { q = walk_e(qc, q, body, None) }
      }
    EPropagate(operand, _, _) ->
      match te {
        Some(XPropagate(t, _, _, _)) -> { q = walk_e(qc, q, operand, Some(t)) }
        _ -> { q = walk_e(qc, q, operand, None) }
      }
    EUnwrap(operand, _, _) ->
      match te {
        Some(XUnwrap(t, _, _, _, _)) -> { q = walk_e(qc, q, operand, Some(t)) }
        _ -> { q = walk_e(qc, q, operand, None) }
      }
    EBinary(_, left, right, _, _, _, _) ->
      match te {
        Some(XBinary(_, tl, tr2, _, _, _, _, _, _)) -> {
          q = walk_e(qc, q, left, Some(tl))
          q = walk_e(qc, q, right, Some(tr2))
        }
        _ -> {
          q = walk_e(qc, q, left, None)
          q = walk_e(qc, q, right, None)
        }
      }
    EUnary(_, operand, _, _) ->
      match te {
        Some(XUnary(_, t, _, _, _)) -> { q = walk_e(qc, q, operand, Some(t)) }
        _ -> { q = walk_e(qc, q, operand, None) }
      }
    EIf(cond, thn, els, _, _) ->
      match te {
        Some(XIf(tc, tt, tels, _, _, _)) -> {
          q = walk_e(qc, q, cond, Some(tc))
          q = walk_e(qc, q, thn, Some(tt))
          match els {
            Some(e) -> { q = walk_e(qc, q, e, tels) }
            None -> ()
          }
        }
        _ -> {
          q = walk_e(qc, q, cond, None)
          q = walk_e(qc, q, thn, None)
          match els {
            Some(e) -> { q = walk_e(qc, q, e, None) }
            None -> ()
          }
        }
      }
    EMatch(scrut, arms, _, _) -> {
      let tarms = match te {
        Some(XMatch(ts, ta, _, _, _)) -> {
          q = walk_e(qc, q, scrut, Some(ts))
          ta
        }
        _ -> {
          q = walk_e(qc, q, scrut, None)
          let none: List[TArm] = []
          none
        }
      }
      var i = 0
      for arm in arms {
        let ta = get(tarms, i)
        let tp: Option[TPat] = match ta {
          Some(a) -> Some(a.pat)
          None -> None
        }
        q = visit_pat(qc, q, arm.pat, tp)
        match arm.guard {
          Some(g) -> {
            let tg: Option[TExpr] = match ta {
              Some(a) -> a.guard
              None -> None
            }
            q = walk_e(qc, q, g, tg)
          }
          None -> ()
        }
        let tb: Option[TExpr] = match ta {
          Some(a) -> Some(a.body)
          None -> None
        }
        q = walk_e(qc, q, arm.body, tb)
        i = i + 1
      }
    }
    EHandle(ename, cells, arms, rest, enlo, enhi, _, _) -> {
      q = offer_effect_atom(qc, q, ename, enlo, enhi)
      q = offer_arm_names(qc, q, ename, arms)
      let (tstmts, trest) = handle_parts(te)
      var i = 0
      for c in cells {
        q = visit_written_type(qc, q, c.ann, WtStorage)
        let tc = opt_get3(tstmts, i)
        q = offer_cell_decl(qc, q, tc, c)
        q = walk_e(qc, q, c.init, cell_init_of(tc))
        i = i + 1
      }
      let tarms = handle_arm_nodes(opt_get3(tstmts, len(cells)))
      for arm in arms {
        q = visit_lambda_param_types(qc, q, arm.params)
        q = walk_handler_arm(qc, q, arm, arm_node_at(tarms, arm.lo, arm.hi))
      }
      q = walk_rest(qc, q, rest, trest)
    }
    EBlock(stmts, tail, _, _) -> {
      let (tstmts, ttail) = match te {
        Some(XBlock(ts, tt, _, _, _)) -> (opt_stmts(ts), tt)
        _ -> {
          let none: List[Option[TStmt]] = []
          let notail: Option[TExpr] = None
          (none, notail)
        }
      }
      var i = 0
      for s in stmts {
        q = visit_stmt(qc, q, s, opt_get3(tstmts, i))
        i = i + 1
      }
      match tail {
        Some(e) -> { q = walk_e(qc, q, e, ttail) }
        None -> ()
      }
    }
    _ -> ()
  }
  q
}

## `recv.name(args)`: a UFCS or module-qualified call, a builtin, a Java
## member or an operation through a module alias. Its own function so that
## `walk_e` stays under HotSpot's huge-method limit (scripts/method-size-gate.py).
fn walk_method(
  qc: QCx,
  q0: Q,
  target: Expr,
  name: String,
  args0: List[Arg],
  nlo: Int,
  nhi: Int,
  mhi: Int,
  te: Option[TExpr]
) -> Q = {
  var q = q0
  let args = arg_exprs(args0)
  q = hint_method_call(qc, q, target, name, args0, nhi, mhi, te)
  # module-qualified (alias.fn) and UFCS calls carry the resolved sig
  match te {
    # `x.g()` where `g` is a renamed import (`use m.{f as g}`) calls `f`
    Some(XCallFn(owner, fname, targs, _, _, trait_id, _, _, _)) -> {
      if fname == name || map.get(qc.entry.cx.import_renames, name) == Some(fname) {
        match sig_by_owner(qc, owner, fname, trait_id) {
          Some(s) -> {
            q = offer_sig_at(qc, q, nlo, nhi, s, site_of_sig(qc, s))
            q = offer_arg_names(qc, q, Some(s), args0)
          }
          None -> ()
        }
      }
      q = walk_method_children(qc, q, target, args, targs)
    }
    Some(XCallBuiltin(bname, targs, _, _, _, _, _)) -> {
      if bname == name {
        match map.get(qc.bins, name) {
          Some(s) -> { q = offer_sig(qc, q, nlo, nhi, s, None, None) }
          None -> ()
        }
      }
      # a sited failure's trailing site is not something the author wrote
      let (written, _) = tast_positions.split_site(bname, targs)
      q = walk_method_children(qc, q, target, args, written)
    }
    Some(XJava(call, _, _, _)) -> {
      match sig_of(qc, name) {
        Some(s) -> {
          q = offer_sig_at(qc, q, nlo, nhi, s, site_of_sig(qc, s))
        }
        None -> ()
      }
      match call.target {
        Some(tt) -> { q = walk_e(qc, q, target, Some(tt)) }
        None -> { q = walk_e(qc, q, target, None) }
      }
      q = walk_list(qc, q, args, opt_list(call.args))
    }
    # an operation called through a module alias (`m.ask()`) is an
    # `XApply` on the evidence by the time it is typed, so it is found by
    # the alias's surface; anything else by name
    _ -> {
      let qualified = match target {
        EVar(qual, _, _) -> map.get(qc.entry.cx.module_fn_sigs, (qual, name))
        _ -> None
      }
      let found = match qualified {
        Some(s) -> Some(s)
        None -> sig_of(qc, name)
      }
      match found {
        Some(s) -> {
          q = offer_sig_at(qc, q, nlo, nhi, s, site_of_sig(qc, s))
        }
        None -> ()
      }
      q = walk_e(qc, q, target, None)
      q = walk_list(qc, q, args, no_texprs(args))
    }
  }
  q
}

## The children of a dotted call. Two arities reach here and they mean
## different things: UFCS (`xs.map(f)`) passes the receiver as the first
## argument, so the typed list is one longer than the written one; a
## module-qualified call (`m.f(a)`) has no receiver value at all -- `m` is an
## alias, not an expression -- so the lists are the same length. Only the first
## was handled, which sent every `m.f(a)` down the parse-only path and dropped
## the type of every argument in it. Anything else is a shape the checker did
## not produce for this node, and walking parse-only is the honest answer.
fn walk_method_children(qc: QCx, q0: Q, target: Expr, args: List[Expr], targs: List[TExpr]) -> Q = {
  var q = q0
  if len(targs) == len(args) + 1 {
    q = walk_e(qc, q, target, get(targs, 0))
    var i = 0
    for a in args {
      q = walk_e(qc, q, a, get(targs, i + 1))
      i = i + 1
    }
  } else if len(targs) == len(args) {
    q = walk_e(qc, q, target, None)
    var j = 0
    for a in args {
      q = walk_e(qc, q, a, get(targs, j))
      j = j + 1
    }
  } else {
    q = walk_e(qc, q, target, None)
    q = walk_list(qc, q, args, no_texprs(args))
  }
  q
}

## A call whose callee is a name: `f(x)`, and the UFCS/module spellings that
## resolve to one. The signature is offered at the name's own span, which is
## what hover and go-to-definition point at.
fn walk_named_call(
  qc: QCx,
  q0: Q,
  callee: String,
  clo: Int,
  chi: Int,
  args: List[Expr],
  te: Option[TExpr]
) -> Q = {
  var q = q0
  match te {
    Some(XCallFn(owner, fname, targs, _, _, trait_id, _, _, _)) -> {
      match sig_by_owner(qc, owner, fname, trait_id) {
        Some(s) -> {
          q = offer_sig_at(qc, q, clo, chi, s, site_of_sig(qc, s))
        }
        None -> ()
      }
      q = walk_call_args(qc, q, args, targs)
    }
    Some(XCallBuiltin(bname, targs, _, _, _, _, _)) -> {
      match map.get(qc.bins, bname) {
        Some(s) -> { q = offer_sig(qc, q, clo, chi, s, None, None) }
        None -> ()
      }
      let (written, _) = tast_positions.split_site(bname, targs)
      q = walk_call_args(qc, q, args, written)
    }
    Some(XCallDyn(sid, _, targs, _, _, _, _)) -> {
      q = collect_local_call(qc, q, sid, clo, chi)
      match sig_of(qc, callee) {
        Some(s) -> {
          q = offer_sig_at(qc, q, clo, chi, s, site_of_sig(qc, s))
        }
        None -> ()
      }
      q = walk_call_args(qc, q, args, targs)
    }
    _ -> {
      match sig_of(qc, callee) {
        Some(s) -> {
          q = offer_sig_at(qc, q, clo, chi, s, site_of_sig(qc, s))
        }
        None -> ()
      }
      q = walk_list(qc, q, args, no_texprs(args))
    }
  }

  q
}

## A construction: `Some(1)`, `Point { x: 1 }`, a bare nullary constructor, or
## the SCREAMING_SNAKE constant that shares the spelling.
fn walk_ctor_call(
  qc: QCx,
  q0: Q,
  args: List[Arg],
  spread: Option[Expr],
  clo: Int,
  chi: Int,
  te: Option[TExpr]
) -> Q = {
  var q = q0
  match te {
    Some(XCtor(aid, ci, written, _, tspread, _, _, _)) -> {
      let a = adt_of(qc.entry.cx.adts, aid)
      match get(a.ctors, ci) {
        Some(c) -> {
          q = offer_at(q, clo, chi, render_ctor(qc, c), site_of_ctor(qc, aid, c.name))
        }
        None -> ()
      }
      match spread {
        Some(sp) ->
          match tspread {
            Some(tsp) -> { q = walk_e(qc, q, sp, Some(tsp)) }
            None -> { q = walk_e(qc, q, sp, None) }
          }
        None -> ()
      }
      var i = 0
      for a2 in args {
        q = walk_e(qc, q, a2.e, opt_get(written, i))
        i = i + 1
      }
      q = offer_field_names(qc, q, aid, ci, args)
    }
    Some(XConstRef(owner, cname, _, _, _)) -> {
      match map.get(qc.entry.cx.consts, cname) {
        Some(t) -> {
          q = offer_at(q, clo, chi, const_text(qc, const_owner(qc, owner, cname), cname, t), site_of_const(qc, cname))
        }
        None -> ()
      }
    }
    Some(XCtorValue(aid, ci, _, _, _)) -> {
      let a = adt_of(qc.entry.cx.adts, aid)
      match get(a.ctors, ci) {
        Some(c) -> {
          q = offer_at(q, clo, chi, render_ctor(qc, c), site_of_ctor(qc, aid, c.name))
        }
        None -> ()
      }
    }
    _ -> {
      match spread {
        Some(sp) -> { q = walk_e(qc, q, sp, None) }
        None -> ()
      }
      for a2 in args { q = walk_e(qc, q, a2.e, None) }
    }
  }
  q
}

## Applying a function value: nothing is named, so nothing is offered beyond
## the types the walk already carries.
fn walk_apply_value(qc: QCx, q0: Q, target: Expr, args: List[Expr], te: Option[TExpr]) -> Q = {
  var q = q0
  match te {
    Some(XApply(tt, targs, _, _, _, _)) -> {
      q = walk_e(qc, q, target, Some(tt))
      q = walk_list(qc, q, args, opt_list(targs))
    }
    _ -> {
      q = walk_e(qc, q, target, None)
      q = walk_list(qc, q, args, no_texprs(args))
    }
  }
  q
}

fn walk_call_args(qc: QCx, q0: Q, args: List[Expr], targs: List[TExpr]) -> Q = {
  var q = q0
  if len(targs) == len(args) {
    var i = 0
    for a in args {
      q = walk_e(qc, q, a, get(targs, i))
      i = i + 1
    }
  } else {
    q = walk_list(qc, q, args, no_texprs(args))
  }
  q
}

fn walk_list(qc: QCx, q0: Q, es: List[Expr], tes: List[Option[TExpr]]) -> Q = {
  var q = q0
  var i = 0
  for e in es {
    q = walk_e(qc, q, e, opt_get2(tes, i))
    i = i + 1
  }
  q
}

fn opt_list(tes: List[TExpr]) -> List[Option[TExpr]] = map(tes, t => Some(t))

fn no_texpr() -> Option[TExpr] = None

fn no_texprs(es: List[Expr]) -> List[Option[TExpr]] = {
  var out: List[Option[TExpr]] = []
  let n: Option[TExpr] = None
  for _e in es { out = out ++ [n] }
  out
}

## A list literal's elements as a flat sequence of expressions, in source
## order: an ordinary element and a spread contribute their operand, a
## conditional element its arms' conditions and bodies. `elem_exprs` and
## `telem_exprs` produce the same sequence for the same literal -- the checker
## keeps every element's form and every chain's arm count -- which is what lets
## the two be walked in lockstep by index, as every other node here is.
fn elem_exprs(elems: List[ListElem]) -> List[Expr] = {
  var out: List[Expr] = []
  for x in elems {
    match x {
      LeExpr(e) -> { out = out ++ [e] }
      LeSpread(e, _, _) -> { out = out ++ [e] }
      LeIf(arms, _, _) -> { for a in arms { out = out ++ [a.cond, a.body] } }
    }
  }
  out
}

fn telem_exprs(elems: List[TListElem]) -> List[TExpr] = {
  var out: List[TExpr] = []
  for x in elems {
    match x {
      TLEExpr(e) -> { out = out ++ [e] }
      TLESpread(e) -> { out = out ++ [e] }
      TLEIf(arms) -> { for a in arms { out = out ++ [a.cond, a.body] } }
    }
  }
  out
}

fn opt_stmts(ts: List[TStmt]) -> List[Option[TStmt]] = map(ts, t => Some(t))

fn opt_get(xs: List[TExpr], i: Int) -> Option[TExpr] = get(xs, i)

fn opt_get2(xs: List[Option[TExpr]], i: Int) -> Option[TExpr] =
  match get(xs, i) {
    Some(o) -> o
    None -> None
  }

fn opt_get3(xs: List[Option[TStmt]], i: Int) -> Option[TStmt] =
  match get(xs, i) {
    Some(o) -> o
    None -> None
  }

fn interp_texprs(parts: List[TStrPart]) -> List[Option[TExpr]] = {
  var out: List[Option[TExpr]] = []
  for p in parts {
    match p {
      TSPInterp(e, _) -> { out = out ++ [Some(e)] }
      TSPText(_) -> ()
    }
  }
  out
}

# ---- patterns ----

fn visit_pat(qc: QCx, q0: Q, pp: Pattern, tp: Option[TPat]) -> Q = {
  var q = q0
  match pp {
    PBind(name, lo, hi) ->
      match tp {
        Some(TPBind(sid, _)) ->
          match sym_get(qc, sid) {
            Some(sym) -> {
              q = offer(q, lo, hi, sym.name ++ ": " ++ show_ty(qc, sym.ty),
                Some((sym.dlo, sym.dhi)), None)
            }
            None -> ()
          }
        _ -> ()
      }
    POr(alts) -> {
      let talts = match tp {
        Some(TPOr(xs)) -> xs
        _ -> {
          let none: List[TPat] = []
          none
        }
      }
      var i = 0
      for alt in alts {
        q = visit_pat(qc, q, alt, get(talts, i))
        i = i + 1
      }
    }
    PCtor(_, args, _, nlo, nhi, _, _) -> {
      q = visit_ctor_pat(qc, q, args, nlo, nhi, tp)
    }
    PRecord(_, args, _, nlo, nhi, _, _) -> {
      q = visit_ctor_pat(qc, q, args, nlo, nhi, tp)
    }
    PQual(qual, _, args, _, nlo, nhi, lo, _) -> {
      q = offer_module_alias(qc, q, qual, lo, lo + str.len(qual))
      q = visit_ctor_pat(qc, q, args, nlo, nhi, tp)
    }
    PQualRecord(qual, _, args, _, nlo, nhi, lo, _) -> {
      q = offer_module_alias(qc, q, qual, lo, lo + str.len(qual))
      q = visit_ctor_pat(qc, q, args, nlo, nhi, tp)
    }
    PTuple(elems, _, _) -> {
      let telems = match tp {
        Some(TPTuple(ts)) -> ts
        _ -> {
          let none: List[TPat] = []
          none
        }
      }
      var i = 0
      for p in elems {
        q = visit_pat(qc, q, p, get(telems, i))
        i = i + 1
      }
    }
    PList(pre, _, rest_name, rest_span, post, _, _) -> {
      let tinfo: Option[(List[TPat], Option[Int], List[TPat])] = match tp {
        Some(TPList(tpre, _, trest, tpost)) -> Some((tpre, trest, tpost))
        _ -> None
      }
      var i = 0
      for p in pre {
        let sub: Option[TPat] = match tinfo {
          Some(k) -> {
            let (tpre, _, _) = k
            get(tpre, i)
          }
          None -> None
        }
        q = visit_pat(qc, q, p, sub)
        i = i + 1
      }
      var j = 0
      for p in post {
        let sub: Option[TPat] = match tinfo {
          Some(k) -> {
            let (_, _, tpost) = k
            get(tpost, j)
          }
          None -> None
        }
        q = visit_pat(qc, q, p, sub)
        j = j + 1
      }
      match rest_span {
        Some(rs) -> {
          let (rlo, rhi) = rs
          match tinfo {
            Some(k) -> {
              let (_, trest, _) = k
              match trest {
                Some(sid) ->
                  match sym_get(qc, sid) {
                    Some(sym) -> {
                      q = offer(q, rlo, rhi, sym.name ++ ": " ++ show_ty(qc, sym.ty),
                        Some((sym.dlo, sym.dhi)), None)
                    }
                    None -> ()
                  }
                None -> ()
              }
            }
            None -> ()
          }
        }
        None -> ()
      }
    }
    _ -> ()
  }
  q
}

fn visit_ctor_pat(
  qc: QCx,
  q0: Q,
  args: List[PatArg],
  nlo: Int,
  nhi: Int,
  tp: Option[TPat]
) -> Q = {
  var q = q0
  let resolved: Option[(Int, Int, List[Option[TPat]])] = match tp {
    Some(TPCtor(aid, ci, fps)) -> Some((aid, ci, fps))
    _ -> None
  }
  match resolved {
    Some(k) -> {
      let (aid, ci, fps) = k
      let a = adt_of(qc.entry.cx.adts, aid)
      match get(a.ctors, ci) {
        Some(c) -> {
          q = offer_at(q, nlo, nhi, render_ctor(qc, c), site_of_ctor(qc, aid, c.name))
          var pos = 0
          for pa in args {
            let fi = match pa.name {
              Some(n) -> field_index(c, n)
              None -> Some(pos)
            }
            let sub: Option[TPat] = match fi {
              Some(ix) ->
                match get(fps, ix) {
                  Some(o) -> o
                  None -> None
                }
              None -> None
            }
            q = visit_pat(qc, q, pa.pat, sub)
            # a field written by name (`Point { x: px }`) answers as the
            # field; `{ x }` is the binding too, which already answers there
            match pa.name {
              Some(n) ->
                if pa.nlo != pat_lo(pa.pat) {
                  match fi {
                    Some(ix) -> { q = offer_ctor_field(qc, q, aid, ci, ix, pa.nlo, pa.nhi) }
                    None -> ()
                  }
                }
              None -> ()
            }
            pos = pos + 1
          }
        }
        None -> { for pa in args { q = visit_pat(qc, q, pa.pat, None) } }
      }
    }
    None -> { for pa in args { q = visit_pat(qc, q, pa.pat, None) } }
  }
  q
}

fn field_index(c: CtorI, name: String) -> Option[Int] = {
  var i = 0
  for f in c.fields {
    if f.name == name { return Some(i) }
    i = i + 1
  }
  None
}

# ---- statements ----

fn visit_stmt(qc: QCx, q0: Q, ps: Stmt, ts: Option[TStmt]) -> Q = {
  var q = q0
  match ps {
    SLet(name, _, ann, init, lo, _) -> {
      match ts {
        Some(TSLet(Some(sid), _, _, _, _)) ->
          match let_name_end(qc.cps, lo, name) {
            Some(at) -> { q = offer_binding(qc, q, sid, at - str.len(name), at) }
            None -> ()
          }
        _ -> ()
      }
      match ann {
        Some(tref) -> { q = visit_written_type(qc, q, tref, WtStorage) }
        None ->
          match ts {
            Some(TSLet(Some(sid), _, _, _, _)) ->
              match inlay_opts(q) {
                Some(o) ->
                  match let_name_end(qc.cps, lo, name) {
                    Some(at) -> { q = hint_binding(qc, q, o.let_types, sid, at) }
                    None -> ()
                  }
                None -> ()
              }
            _ -> ()
          }
      }
      match ts {
        Some(TSLet(_, _, tinit, _, _)) -> { q = walk_e(qc, q, init, Some(tinit)) }
        _ -> { q = walk_e(qc, q, init, None) }
      }
    }
    SLetPat(pat, _, init, _, _) ->
      match ts {
        Some(TSLetPat(tpat, tinit, _, _)) -> {
          match inlay_opts(q) {
            Some(o) -> {
              for sid in pat_binders(tpat) {
                match sym_get(qc, sid) {
                  Some(sym) -> { q = hint_binding(qc, q, o.let_types, sid, sym.dhi) }
                  None -> ()
                }
              }
            }
            None -> ()
          }
          q = visit_pat(qc, q, pat, Some(tpat))
          q = walk_e(qc, q, init, Some(tinit))
        }
        _ -> {
          q = visit_pat(qc, q, pat, None)
          q = walk_e(qc, q, init, None)
        }
      }
    SLocalFn(name, params, ret, _, body, nlo, nhi, lo, hi) -> {
      q = visit_lambda_param_types(qc, q, params)
      q = visit_written_type(qc, q, ret, WtReturn)
      q = offer_row(qc, q, t_hi(ret), e_lo(body))
      match ts {
        Some(TSLocalFn(sid, _, psyms, _, tbody, _, _, _)) -> {
          match sym_get(qc, sid) {
            Some(sym) -> {
              q = offer_local(q, FnRole, nlo, nhi, "fn " ++ name ++ ": " ++ show_ty(qc, sym.ty), (nlo, nhi))
              # the desugared lambda's own type, at the whole-statement span
              q = offer(q, lo, hi, show_ty(qc, sym.ty), None, None)
            }
            None -> ()
          }
          q = hint_lambda_params(qc, q, params, psyms)
          var i = 0
          for p in params {
            match get(psyms, i) {
              Some(pid) ->
                match sym_get(qc, pid) {
                  Some(sym) -> {
                    q = offer_local(q, ParamRole, p.lo, p.hi, sym.name ++ ": " ++ show_ty(qc, sym.ty), (p.lo, p.hi))
                  }
                  None -> ()
                }
              None -> ()
            }
            i = i + 1
          }
          q = walk_e(qc, q, body, Some(tbody))
        }
        _ -> { q = walk_e(qc, q, body, None) }
      }
    }
    SAssign(name, value, nlo, nhi, _, _) ->
      match ts {
        Some(TSAssign(sid, _, tvalue, _, _)) -> {
          match sym_get(qc, sid) {
            Some(sym) -> {
              let kw = if sym.mutable { "var" } else { "let" }
              q = offer(q, nlo, nhi, kw ++ " " ++ sym.name ++ ": " ++ show_ty(qc, sym.ty),
                Some((sym.dlo, sym.dhi)), None)
            }
            None -> ()
          }
          q = walk_e(qc, q, value, Some(tvalue))
        }
        # Writing a handler state cell is not an assignment by the time it is
        # typed: the binding never changes, the slot does, so the checker left
        # a `cell_set` statement where the assignment was. The name is still
        # the cell and the right-hand side still has a type.
        Some(TSExpr(x, _, _)) ->
          match cell_set_args(x) {
            Some(cargs) -> {
              match cell_arg_sym(cargs) {
                Some(sid) -> { q = offer_cell(qc, q, sid, nlo, nhi) }
                None -> ()
              }
              q = walk_e(qc, q, value, get(cargs, 1))
            }
            None -> { q = walk_e(qc, q, value, None) }
          }
        _ -> { q = walk_e(qc, q, value, None) }
      }
    SExpr(e, _, _) ->
      match ts {
        Some(TSExpr(t, _, _)) -> { q = walk_e(qc, q, e, Some(t)) }
        _ -> { q = walk_e(qc, q, e, None) }
      }
    SAssert(cond, _, _, _) ->
      match ts {
        Some(TSAssert(t, _, _, _)) -> { q = walk_e(qc, q, cond, Some(t)) }
        _ -> { q = walk_e(qc, q, cond, None) }
      }
    SWhile(cond, body, _, _) ->
      match ts {
        Some(TSWhile(tc, tb, _, _, _)) -> {
          q = walk_e(qc, q, cond, Some(tc))
          q = walk_e(qc, q, body, Some(tb))
        }
        _ -> {
          q = walk_e(qc, q, cond, None)
          q = walk_e(qc, q, body, None)
        }
      }
    SFor(pat, from, to, body, _, _) -> {
      if pat_lo(pat) <= q.offset && q.offset <= pat_hi(pat) {
        q = Q { ..q, in_for_pattern: true }
      }
      match ts {
        Some(TSFor(tpat, _, tfrom, tto, _, tbody, _, _, _)) -> {
          q = visit_pat(qc, q, pat, Some(tpat))
          q = walk_e(qc, q, from, Some(tfrom))
          match to {
            Some(e) -> { q = walk_e(qc, q, e, tto) }
            None -> ()
          }
          q = walk_e(qc, q, body, Some(tbody))
        }
        _ -> {
          q = visit_pat(qc, q, pat, None)
          q = walk_e(qc, q, from, None)
          match to {
            Some(e) -> { q = walk_e(qc, q, e, None) }
            None -> ()
          }
          q = walk_e(qc, q, body, None)
        }
      }
    }
    _ -> ()
  }
  q
}

# ---- completion support: binders in scope (the Kotlin collectBinders) ----

fn param_detail(qc: QCx, tf: Option[TFun], i: Int) -> Option[String] =
  match tf {
    Some(t) ->
      match get(t.param_syms, i) {
        Some(sid) ->
          match sym_get(qc, sid) {
            Some(sym) -> Some(show_ty(qc, sym.ty))
            None -> None
          }
        None -> None
      }
    None -> None
  }

fn sym_detail(qc: QCx, sid: Int) -> Option[String] =
  match sym_get(qc, sid) {
    Some(sym) -> Some(show_ty(qc, sym.ty))
    None -> None
  }

## Locals visible at `pos`: the enclosing function's parameters plus every
## binder introduced textually before it, in the Kotlin collection order.
pub(pkg) fn locals_at(qc: QCx, pos: Int) -> List[(String, Option[String])] = {
  var out: List[(String, Option[String])] = []
  var fns: List[(FnDecl, List[identity.Part])] = []
  for f in module_fns(qc.entry.m) { fns = fns ++ [(f, [identity.Named(identity.FunctionDecl, f.name)])] }
  for iv in module_impls(qc.entry.m) {
    let head = impl_head(iv.tparams, iv.trait_name, iv.subject)
    for m2 in iv.methods { fns = fns ++ [(m2, method_path(head, m2.name))] }
  }
  var found = false
  for entry in fns {
    let (f, path) = entry
    if not found && pos >= f.lo && pos <= f.hi {
      found = true
      let tf = tfun_at(qc, path)
      var i = 0
      for p in f.params {
        out = out ++ [(p.name, param_detail(qc, tf, i))]
        i = i + 1
      }
      out = collect_e(qc, out, f.body, tf_body(tf), pos)
    }
  }
  for tv in module_traits(qc.entry.m) {
    for m2 in tv.methods {
      match m2.body {
        Some(b) -> {
          if pos >= m2.lo && pos <= m2.hi {
            let tf = tfun_at(qc, [identity.Named(identity.TraitDecl, tv.name), identity.Named(identity.MethodDecl, m2.name)])
            var i = 0
            for p in m2.params {
              out = out ++ [(p.name, param_detail(qc, tf, i))]
              i = i + 1
            }
            out = collect_e(qc, out, b, tf_body(tf), pos)
          }
        }
        None -> ()
      }
    }
  }
  out
}

## The binders a pattern introduces, off the *typed* pattern: TPBind and
## TPList's rest carry the symbol, and the symbol table carries both the name
## and the type, so this is one walk rather than a parallel walk of the source
## pattern for names and the typed one for types.
##
## Nothing collected these, so `match x { Some(v) -> <here> }` and
## `let (a, b) = p` offered no completion for v, a or b -- the two places in
## the language where a binding is introduced by a pattern instead of by a
## name, which is exactly the set that was missing.
fn collect_tpat(
  qc: QCx,
  acc0: List[(String, Option[String])],
  tp: TPat
) -> List[(String, Option[String])] = {
  var acc = acc0
  match tp {
    TPBind(sym, _) -> { acc = collect_sym(qc, acc, sym) }
    TPOr(alts) -> if len(alts) > 0 { acc = collect_tpat(qc, acc, alts[0]) }
    TPTuple(elems) -> {
      for e in elems { acc = collect_tpat(qc, acc, e) }
    }
    TPList(pre, _, rest_sym, post) -> {
      for e in pre { acc = collect_tpat(qc, acc, e) }
      match rest_sym {
        Some(sid) -> { acc = collect_sym(qc, acc, sid) }
        None -> ()
      }
      for e in post { acc = collect_tpat(qc, acc, e) }
    }
    TPCtor(_, _, field_pats) -> {
      for fp in field_pats {
        match fp {
          Some(e) -> { acc = collect_tpat(qc, acc, e) }
          None -> ()
        }
      }
    }
    TPWild -> ()
    TPLit(_) -> ()
  }
  acc
}

## The name a pattern bound comes from the symbol table rather than from the
## TPBind, because TPList's rest carries only the symbol.
fn collect_sym(
  qc: QCx,
  acc: List[(String, Option[String])],
  sid: Int
) -> List[(String, Option[String])] =
  match sym_get(qc, sid) {
    Some(sym) -> acc ++ [(sym.name, Some(show_ty(qc, sym.ty)))]
    None -> acc
  }

fn collect_e(
  qc: QCx,
  acc0: List[(String, Option[String])],
  pe: Expr,
  te: Option[TExpr],
  before: Int
) -> List[(String, Option[String])] = {
  var acc = acc0
  match pe {
    EBlock(stmts, tail, _, _) -> {
      let (tstmts, ttail) = match te {
        Some(XBlock(ts, tt, _, _, _)) -> (opt_stmts(ts), tt)
        _ -> {
          let none: List[Option[TStmt]] = []
          let notail: Option[TExpr] = None
          (none, notail)
        }
      }
      var i = 0
      for s in stmts {
        acc = collect_s(qc, acc, s, opt_get3(tstmts, i), before)
        i = i + 1
      }
      match tail {
        Some(e) -> { acc = collect_e(qc, acc, e, ttail, before) }
        None -> ()
      }
    }
    EIf(cond, thn, els, _, _) -> {
      let (tc, tt, tels) = match te {
        Some(XIf(c, t, e, _, _, _)) -> (Some(c), Some(t), e)
        _ -> {
          let n1: Option[TExpr] = None
          let n2: Option[TExpr] = None
          let n3: Option[TExpr] = None
          (n1, n2, n3)
        }
      }
      acc = collect_e(qc, acc, cond, tc, before)
      acc = collect_e(qc, acc, thn, tt, before)
      match els {
        Some(e) -> { acc = collect_e(qc, acc, e, tels, before) }
        None -> ()
      }
    }
    EMatch(scrut, arms, _, _) -> {
      let tarms = match te {
        Some(XMatch(ts, ta, _, _, _)) -> {
          acc = collect_e(qc, acc, scrut, Some(ts), before)
          ta
        }
        _ -> {
          acc = collect_e(qc, acc, scrut, None, before)
          let none: List[TArm] = []
          none
        }
      }
      var i = 0
      for arm in arms {
        let (tb, tpat) = match get(tarms, i) {
          Some(a) -> (Some(a.body), Some(a.pat))
          None -> {
            let n: Option[TExpr] = None
            let np: Option[TPat] = None
            (n, np)
          }
        }
        # an arm's binders belong to that arm, so unlike the binders in a block
        # they are offered only from inside it -- `before` is between the arm's
        # first token and its last
        if arm.lo < before && before <= arm.hi {
          match tpat {
            Some(tp) -> { acc = collect_tpat(qc, acc, tp) }
            None -> ()
          }
        }
        acc = collect_e(qc, acc, arm.body, tb, before)
        i = i + 1
      }
    }
    ELambda(params, body, _, lo, _) -> {
      if lo < before {
        for p in params {
          let nd: Option[String] = None
          acc = acc ++ [(p.name, nd)]
        }
      }
      let tb: Option[TExpr] = match te {
        Some(XLambda(_, _, b, _, _, _, _)) -> Some(b)
        _ -> None
      }
      acc = collect_e(qc, acc, body, tb, before)
    }
    EMethod(target, _, args0, _, _, _, _) -> {
      let args = arg_exprs(args0)
      let targs = match te {
        Some(XCallFn(_, _, ts, _, _, _, _, _, _)) -> ts
        Some(XCallBuiltin(_, ts, _, _, _, _, _)) -> ts
        _ -> {
          let none: List[TExpr] = []
          none
        }
      }
      if len(targs) == len(args) + 1 {
        acc = collect_e(qc, acc, target, get(targs, 0), before)
        var i = 0
        for a in args {
          acc = collect_e(qc, acc, a, get(targs, i + 1), before)
          i = i + 1
        }
      } else {
        acc = collect_e(qc, acc, target, None, before)
        for a in args { acc = collect_e(qc, acc, a, None, before) }
      }
    }
    # every call shape: the typed node is an XApply only when a function value
    # is applied -- a named call carries XCallFn/XCallBuiltin/XCallDyn and a
    # construction an XCtor, and their arguments are still these arguments
    EApply(target, args0, _, _) -> {
      let args = arg_exprs(args0)
      let (tt, targs) = match te {
        Some(XApply(t, ts, _, _, _, _)) -> (Some(t), opt_list(ts))
        Some(XCallFn(_, _, ts, _, _, _, _, _, _)) -> (no_texpr(), opt_list(ts))
        Some(XCallBuiltin(_, ts, _, _, _, _, _)) -> (no_texpr(), opt_list(ts))
        Some(XCallDyn(_, _, ts, _, _, _, _)) -> (no_texpr(), opt_list(ts))
        Some(XCtor(_, _, written, _, _, _, _, _)) -> (no_texpr(), opt_list(written))
        _ -> {
          let none: List[Option[TExpr]] = []
          (no_texpr(), none)
        }
      }
      match tt {
        Some(_) -> { acc = collect_e(qc, acc, target, tt, before) }
        # the callee of a named call or a construction is not a value: walking
        # it would offer a local named `f` for the `f` in `f(x)`
        None ->
          match target {
            EVar(_, _, _) -> ()
            ECtor(_, _, _) -> ()
            _ -> { acc = collect_e(qc, acc, target, None, before) }
          }
      }
      var i = 0
      for a in args {
        acc = collect_e(qc, acc, a, opt_get2(targs, i), before)
        i = i + 1
      }
    }
    ERecord(_, args, spread, _, _, _, _) -> {
      let (tspread, written) = match te {
        Some(XCtor(_, _, w, _, sp, _, _, _)) -> (sp, w)
        _ -> {
          let n: Option[TExpr] = None
          let none: List[TExpr] = []
          (n, none)
        }
      }
      match spread {
        Some(sp) -> { acc = collect_e(qc, acc, sp, tspread, before) }
        None -> ()
      }
      var i = 0
      for a in args {
        acc = collect_e(qc, acc, a.e, opt_get(written, i), before)
        i = i + 1
      }
    }
    EListLit(elems, _, _) -> {
      let es = elem_exprs(elems)
      let telems = match te {
        Some(XListLit(ts, _, _, _)) -> opt_list(telem_exprs(ts))
        _ -> no_texprs(es)
      }
      var i = 0
      for e in es {
        acc = collect_e(qc, acc, e, opt_get2(telems, i), before)
        i = i + 1
      }
    }
    ETupleLit(elems, _, _) -> {
      let telems = match te {
        Some(XTupleLit(ts, _, _, _)) -> opt_list(ts)
        _ -> no_texprs(elems)
      }
      var i = 0
      for e in elems {
        acc = collect_e(qc, acc, e, opt_get2(telems, i), before)
        i = i + 1
      }
    }
    EBinary(_, left, right, _, _, _, _) -> {
      let (tl, tr2) = match te {
        Some(XBinary(_, l, r, _, _, _, _, _, _)) -> (Some(l), Some(r))
        _ -> {
          let n1: Option[TExpr] = None
          let n2: Option[TExpr] = None
          (n1, n2)
        }
      }
      acc = collect_e(qc, acc, left, tl, before)
      acc = collect_e(qc, acc, right, tr2, before)
    }
    EUnary(_, operand, _, _) -> {
      let t: Option[TExpr] = match te {
        Some(XUnary(_, o, _, _, _)) -> Some(o)
        _ -> None
      }
      acc = collect_e(qc, acc, operand, t, before)
    }
    EPropagate(operand, _, _) -> {
      let t: Option[TExpr] = match te {
        Some(XPropagate(o, _, _, _)) -> Some(o)
        _ -> None
      }
      acc = collect_e(qc, acc, operand, t, before)
    }
    EUnwrap(operand, _, _) -> {
      let t: Option[TExpr] = match te {
        Some(XUnwrap(o, _, _, _, _)) -> Some(o)
        _ -> None
      }
      acc = collect_e(qc, acc, operand, t, before)
    }
    EIndex(target, index, _, _) -> {
      let (tt, ti) = match te {
        Some(XIndex(t, ix, _, _, _, _)) -> (Some(t), Some(ix))
        _ -> {
          let n1: Option[TExpr] = None
          let n2: Option[TExpr] = None
          (n1, n2)
        }
      }
      acc = collect_e(qc, acc, target, tt, before)
      acc = collect_e(qc, acc, index, ti, before)
    }
    EReturn(v, _, _) ->
      match v {
        Some(e) -> {
          let tv: Option[TExpr] = match te {
            Some(XReturn(t, _, _)) -> t
            _ -> None
          }
          acc = collect_e(qc, acc, e, tv, before)
        }
        None -> ()
      }
    # An interpolation holds an arbitrary expression, lambdas included, so a
    # cursor inside `"${ ... }"` was the one position where the walk stopped
    # short of itself. Same for the two block-shaped wrappers and a field
    # target: the sibling walk_e already goes into all four.
    EStr(parts, _, _) -> {
      let no_parts: List[Option[TExpr]] = []
      let tparts = match te {
        Some(XStr(tp, _, _)) -> interp_texprs(tp)
        _ -> no_parts
      }
      var i = 0
      for p in parts {
        match p {
          SPInterp(e) -> {
            acc = collect_e(qc, acc, e, opt_get2(tparts, i), before)
            i = i + 1
          }
          SPText(_) -> ()
        }
      }
    }
    EComptime(body, _, _) -> {
      let tb: Option[TExpr] = match te {
        Some(XComptime(t, _, _, _)) -> Some(t)
        _ -> None
      }
      acc = collect_e(qc, acc, body, tb, before)
    }
    EFieldAcc(target, _, _, _, _, _) -> {
      let tt: Option[TExpr] = match te {
        Some(XField(t, _, _, _, _)) -> Some(t)
        _ -> None
      }
      acc = collect_e(qc, acc, target, tt, before)
    }
    _ -> ()
  }
  acc
}

fn collect_s(
  qc: QCx,
  acc0: List[(String, Option[String])],
  ps: Stmt,
  ts: Option[TStmt],
  before: Int
) -> List[(String, Option[String])] = {
  var acc = acc0
  match ps {
    SLet(name, _, _, init, lo, _) -> {
      let (detail, tinit) = match ts {
        Some(TSLet(sid, _, ti, _, _)) -> {
          let d = match sid {
            Some(s) -> sym_detail(qc, s)
            None -> {
              let n: Option[String] = None
              n
            }
          }
          (d, Some(ti))
        }
        _ -> {
          let n1: Option[String] = None
          let n2: Option[TExpr] = None
          (n1, n2)
        }
      }
      if lo < before { acc = acc ++ [(name, detail)] }
      acc = collect_e(qc, acc, init, tinit, before)
    }
    SLocalFn(name, params, _, _, body, _, _, lo, _) -> {
      let (detail, psyms, tbody) = match ts {
        Some(TSLocalFn(sid, _, ps2, _, tb, _, _, _)) -> (sym_detail(qc, sid), ps2, Some(tb))
        _ -> {
          let n1: Option[String] = None
          let none: List[Int] = []
          let n2: Option[TExpr] = None
          (n1, none, n2)
        }
      }
      if lo < before {
        acc = acc ++ [(name, detail)]
        for p in params {
          let nd: Option[String] = None
          acc = acc ++ [(p.name, nd)]
        }
      }
      acc = collect_e(qc, acc, body, tbody, before)
    }
    SLetPat(_, _, init, lo, _) -> {
      let (tpat, tinit) = match ts {
        Some(TSLetPat(tp, ti, _, _)) -> (Some(tp), Some(ti))
        _ -> {
          let n1: Option[TPat] = None
          let n2: Option[TExpr] = None
          (n1, n2)
        }
      }
      # same rule as SLet: in scope for everything after the statement
      if lo < before {
        match tpat {
          Some(tp) -> { acc = collect_tpat(qc, acc, tp) }
          None -> ()
        }
      }
      acc = collect_e(qc, acc, init, tinit, before)
    }
    SFor(_, from, to, body, _, _) -> {
      let (tpat, tfrom, tto, tbody) = match ts {
        Some(TSFor(tp, _, tf, tt, _, tb, _, _, _)) -> (Some(tp), Some(tf), tt, Some(tb))
        _ -> {
          let n1: Option[TPat] = None
          let n2: Option[TExpr] = None
          let n3: Option[TExpr] = None
          let n4: Option[TExpr] = None
          (n1, n2, n3, n4)
        }
      }
      if e_lo(from) <= before && before <= e_hi(from) {
        acc = collect_e(qc, acc, from, tfrom, before)
      }
      match to {
        Some(e) -> if e_lo(e) <= before && before <= e_hi(e) {
          acc = collect_e(qc, acc, e, tto, before)
        }
        None -> ()
      }
      if e_lo(body) <= before && before <= e_hi(body) {
        match tpat {
          Some(tp) -> { acc = collect_tpat(qc, acc, tp) }
          None -> ()
        }
        acc = collect_e(qc, acc, body, tbody, before)
      }
    }
    SWhile(cond, body, _, _) -> {
      let (tc, tb) = match ts {
        Some(TSWhile(c, b, _, _, _)) -> (Some(c), Some(b))
        _ -> {
          let n1: Option[TExpr] = None
          let n2: Option[TExpr] = None
          (n1, n2)
        }
      }
      acc = collect_e(qc, acc, cond, tc, before)
      acc = collect_e(qc, acc, body, tb, before)
    }
    SAssign(_, value, _, _, _, _) -> {
      let tv: Option[TExpr] = match ts {
        Some(TSAssign(_, _, v, _, _)) -> Some(v)
        _ -> None
      }
      acc = collect_e(qc, acc, value, tv, before)
    }
    SExpr(e, _, _) -> {
      let t: Option[TExpr] = match ts {
        Some(TSExpr(x, _, _)) -> Some(x)
        _ -> None
      }
      acc = collect_e(qc, acc, e, t, before)
    }
    _ -> ()
  }
  acc
}

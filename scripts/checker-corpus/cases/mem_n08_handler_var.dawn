# checker.dawn: rule R3, the handler cell (N8). A cell whose type mentions a
# buffer would keep one alive in a handler that outlives the scope.
effect Tick {
  fn tick() -> Unit
}

fn body() -> Unit !Tick = tick()

pub fn held() -> Int = {
  with handle Tick {
    var h: List[I64Buf] = []
    tick() => { h = h }
  }
  body()
  0
}

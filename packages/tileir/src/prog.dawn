        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        let a = ws[0]
        let n = ws[1]
        check_operand(name, frames, ops, held, "powi", "base", a, dtype, shape)
        check_operand(name, frames, ops, held, "powi", "exponent", n, exp_dtype, shape)
        held = hold(held, next, dtype, shape)
        let d = next
        next = mint(name, next, 1)
        ops = ops ++ [PowI(d, dtype, exp_dtype, shape, a, n)]
        d
      }
      t_cat(dtype, dim, lhs_shape, rhs_shape, lhs0, rhs0) => {
        let (g, hs) = settle_all(name, frames, grown(next, ops, held, spreads, pending), [lhs0, rhs0])
        next = g.next
        ops = g.ops
        held = g.held
        spreads = g.spreads
        let lhs = hs[0]
        let rhs = hs[1]

# A function some other call returned. The callee is itself a call and is not
# re-wrapped: the left side goes into the *outer* argument list.
#
# `maker()` is deliberately commutative. This file is about inserting rather
# than wrapping, and an asymmetric result would let the argument-order mutant
# redden it too, which would leave the assertion owned by neither.
fn maker() -> fn(Int, Int) -> Int = (a, b) => a + b

pub fn main() -> Unit !io = println("${1 |> maker()(2)}")

# checker.dawn: two Java overloads the argument fits equally well
#
# Both pairs are stable across JDK versions, and the hint lists only the tied
# candidates, so the golden does not move with the host's reflection.
use java "java.lang.StringBuilder"
use java "java.util.PriorityQueue"
use java "java.util.TreeSet"

pub fn method_amb() -> Int !io = {
  let a = StringBuilder.new()
  let b = StringBuilder.new()
  let c = a.append(b)
  1
}

pub fn ctor_amb() -> Int !io = {
  let t = TreeSet.new()
  let q = PriorityQueue.new(t)
  1
}

# The project site's static site generator — written in Dawn (M5).
# Run via site/build.sh (which feeds it dawn doc --stdlib output), or
# directly from the repo root: dawn run site

use gen/pages.{build_stamp, play_run_endpoint, gen_assets, gen_spec, gen_design, gen_history, gen_playground, gen_tea}
use gen/home.{gen_index, site_figures}
use gen/gpu.{gen_gpu}
use html/page.{En, Zh}
use gen/tutorial.{gen_tutorial}
use gen/examples.{gen_examples}
use gen/stdlib.{gen_stdlib}
use gen/links.{check_links}
use gen/assets.{check_assets}
use gen/crawl.{gen_crawl}
use gen/corpus.{read_corpus}
use std/io.{with_fs_real, with_env_real}

pub fn main() -> Unit !io = {
  with_fs_real(() => {
    let out = "site/dist"
    # The spec, the timeline, the early design notes and the tutorial, each
    # parsed once per language and handed both to the search indexes (inside
    # gen_assets) and to the pages, so that the anchors the search writes are
    # counted over the very blocks the pages render (gen/corpus.dawn).
    let en = read_corpus(En)
    let zh = read_corpus(Zh)
    # The names the assets got: content-hashed, so that the one-year
    # `immutable` header /assets/ is served with stops holding a returning
    # visitor on a stale copy. Every page below links to what this hands back.
    # The release and commit the footer prints; see gen/pages.build_stamp.
    let assets = gen_assets(out, with_env_real(() => build_stamp()), en, zh)
    # The front page's figures, from scripts/site-figures.sh by way of the
    # environment site/build.sh sets. Read before anything is written: a build
    # without them stops here (gen/home.read_figure) rather than half way
    # through the site.
    let figs = with_env_real(() => site_figures())
    # Where the Playground's API lives (DAWN_SITE_PLAY_ORIGIN, see
    # gen/pages.play_origin): relative when unset, absolute on that origin
    # when set. Read here for the same reason as the figures.
    let play = with_env_real(() => play_run_endpoint())
    # English is the site's default and lives at `/`; the Chinese front page
    # is at `/zh/`. Every page below is paired the same way.
    gen_index(out, assets, En, figs)
    gen_index(out, assets, Zh, figs)
    # The tutorial is the second paired document: English at /tutorial/, its
    # translation at /zh/tutorial/, each page linked to its twin.
    gen_tutorial(out, assets, En, en.tutorial)
    gen_tutorial(out, assets, Zh, zh.tutorial)
    # And the rest of the paired ones. The standard library reference is a
    # translated intro over entries that are English in both runs -- the doc
    # comments are the compiler's own text; the gallery and the Playground are a
    # translated shell over programs and an editor that have no language.
    gen_examples(out, assets, En)
    gen_examples(out, assets, Zh)
    gen_stdlib(out, assets, En)
    gen_stdlib(out, assets, Zh)
    gen_playground(out, assets, En, play)
    gen_playground(out, assets, Zh, play)
    # The browser demo: two wasm reactors built by site/build.sh, mounted by the
    # bridge vendored alongside them. Translated shell and translated prose over
    # two applications that draw the same English either way.
    gen_tea(out, assets, En)
    gen_tea(out, assets, Zh)
    # The cuTile backend's page, a translated shell over numbers that are the
    # same in both: every one is read from the tile gates' tables and ledgers
    # under scripts/ (gen/gpu.dawn).
    gen_gpu(out, assets, En)
    gen_gpu(out, assets, Zh)
    # The last two to be paired (2026-08-07). These are the one pair whose
    # original is the Chinese half -- they are living documents, edited in
    # Chinese by every language batch, and the English is registered against
    # them in scripts/doc-check.py. The layout does not care which way that
    # runs: English at `/`, Chinese at `/zh/`, same as everything above.
    gen_spec(out, assets, En, en)
    gen_spec(out, assets, Zh, zh)
    gen_design(out, assets, En, en)
    gen_design(out, assets, Zh, zh)
    # The history: a timeline whose original is the English one, the way the
    # outward-facing documents run. The design notes above are its early
    # chapter and keep their own URL.
    gen_history(out, assets, En, en)
    gen_history(out, assets, Zh, zh)
    # robots.txt, the sitemap, the 404 page and the root favicon: last,
    # because the sitemap is read back off the pages above.
    gen_crawl(out, assets)
    check_links(out)
    # The chrome follows `Lang` because every function above takes one. The
    # stylesheet is copied verbatim into both trees and takes nothing, so the
    # text it injects is checked here instead.
    check_assets(out)
    println("site generated into ${out}")
  })
}

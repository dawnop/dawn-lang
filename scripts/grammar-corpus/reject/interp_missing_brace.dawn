# expect: unmatched ${ in interpolation
# An interpolation missing its `}` is reported at the `${`, not as an
# unterminated string (#191). Before the fix the closing quote started a
# nested literal that ran to the end of the line, and the `)` went with it,
# so the parser followed with a second error at the next `}`.

pub fn main() -> Unit !io = {
  let x = 1
  println("value = ${x")
}

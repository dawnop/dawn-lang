# These four sites were hidden by coverage.py's former prefix matching. Keep
# each real checker path reachable so tightening the matcher does not grow the
# ratchet while still refusing a diagnostic that merely echoes one chunk.

fn phantom_value[T](x: Int) -> Int = x

type Generic[T] = Generic(value: T)

type Phantom[T] = Phantom(value: Int)

trait BadDefault[T] {
  fn wrong(x: T) -> Int = "wrong"
}

fn function_value_without_evidence() -> Unit = {
  let _: fn(Int) -> Int = phantom_value
  ()
}

fn constructor_value_without_evidence() -> Unit = {
  let _: fn(Int) -> Int = Phantom
  ()
}

fn constructor_value_wrong_arity() -> Unit = {
  let _: fn(Int, Int) -> Generic[Int] = Generic
  ()
}

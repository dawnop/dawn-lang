# Prelude trait names reserve trait and effect positions, not method names.
trait BitAnd[T] { fn custom(a: T) -> T }
trait BitOr[T] { fn custom_or(a: T) -> T }
trait BitXor[T] { fn custom_xor(a: T) -> T }
trait Shl[T] { fn custom_shl(a: T) -> T }
trait Shr[T] { fn custom_shr(a: T) -> T }
trait Ushr[T] { fn custom_ushr(a: T) -> T }
trait BitNot[T] { fn custom_not(a: T) -> T }
effect BitAnd { fn ask() -> Int }

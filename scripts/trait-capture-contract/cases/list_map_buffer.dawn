# A callback may retain a buffer while map consumes it within its domain.
use std/mem
use std/list
pub fn main() -> Unit !io = {
  let answer = mem.with_mem([@s] () => {
    let buffer = mem.new(3)
    let lengths = list.map([0, 1], _index => len(buffer))
    lengths[0] + lengths[1]
  })
  println(to_string(answer))
}

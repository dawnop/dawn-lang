# checker.dawn: what an arity error leaves behind for the surrounding context.
#
# A wrong argument count does not destroy the knowledge of what the call
# returns, so every call form hands that type back and lets the context judge
# the body separately. The pairs below are the discriminating inputs: in each
# `_ok` case the declared return type already matches, so the policy is
# invisible; in each `_bad` case it does not, and the second diagnostic is the
# one at stake. Every `_bad` second sentence survives fixing the arity error on
# its own, which is why it is reported rather than suppressed.
#
# Five call forms reach that policy and this file is the only place any of them
# is discriminated. `calls`, `call_expr` and `fn_field` all reach four of the
# five, but every one of their callers declares a return type that already
# matches, so returning TyError there changes nothing they record. Measured, not
# assumed: flipping the two sites `e_bad` and `fld_bad` now cover back to
# TyError -- the exact edit this corpus exists to catch -- left all 80 cases and
# all 298 diagnostics byte for byte identical before those two cases existed.
#
# The two `g_` cases are the exception and the reason `check_call` tests
# `len(s.tparams) == 0`: with the wrong number of arguments a generic signature
# has nothing to infer from, so its return type is genuinely unknown and only
# the arity error is reported. Dropping that test puts an unbound `T` in the
# second sentence.
#
# `blk_bad` and `ret_only` are why "two diagnostics on one span" is not treated
# as a defect of these paths. The span the two share is the function body, so
# they coincide only when the body *is* the call: move the same call into a
# block and they separate on their own. And the second span comes from the one
# line in `check_fn` that every return-type mismatch in the language shares --
# `ret_only` has no arity error anywhere and lands on the same span rule. So
# there is nothing arity-shaped to retarget; the coincidence is a property of
# expression bodies.
#
# The `gc_` cases are the one thing here that really is a cascade, and they now
# record the fix rather than the symptom. With a field missing, a generic
# constructor used to report `cannot infer type parameter(s)` on top of the
# arity error, and that sentence does NOT survive fixing the arity error --
# `B(1)` needs no annotation -- so its hint asked for one that fixes nothing.
# `gc_missing_seeded` is the input that showed the cause: bind the parameter
# from the expected type and the second sentence goes away by itself.
#
# The suppression is per parameter, not per call: a parameter is dropped only
# when the fields the call left out are the *whole* source of information about
# it. The cases below are the discriminators for that rule, not illustrations
# of it: breaking either half of the predicate, or the trigger that gates it,
# reds one of them and only that one -- measured, three mutants, three reds.
# `gc_phantom` / `gc_phantom_ok` stop it from being a blanket suppression: `T`
# there is mentioned by no field at all, so the missing field has nothing to do
# with its being unbound, and `gc_phantom_ok` -- which has no arity error --
# shows the sentence standing on its own. `gc_mixed` holds both answers in one
# sentence: `T` comes only from the missing fields and goes, `U` is mentioned
# nowhere and stays. `gc_shared` is the other edge: a field that *was* supplied
# mentions `T` and still failed to bind it, so the missing field is not the
# whole story and the sentence stays. `gc_extra` has no missing field at all,
# so nothing is suppressed there whatever the predicate says. `gc_wrongname`
# pins the other half of the trigger: the suppression only fires for the
# `missing field(s)` diagnostic it is the echo of, so an unfilled field that
# was reported some other way keeps its cascade. That is a second, still-open
# cascade recorded as it is -- and the case is here so that widening the
# trigger cannot happen silently.

pub type Sum = Zero | One(x: Int)

pub type FnRec = { g: fn(Int) -> Int }

pub type Box[T] = B(x: T)

type Ph[T] = P(x: Int)

type Mix[T, U] = M(a: T, b: Int)

type Half[T] = H(a: List[T], b: T)

pub fn plain(a: Int, b: Int) -> Int = a + b

pub fn ident[T](x: T) -> T = x

pub fn pick(r: FnRec) -> fn(Int) -> Int = r.g

# constructor, too many fields, declared return type already correct
pub fn c_ok() -> Sum = One(1, 2)

# constructor, too many fields, declared return type genuinely wrong
pub fn c_bad() -> Int = Zero(1)

# constructor, too few fields, declared return type genuinely wrong
pub fn c_missing_bad() -> Int = One()

# function, wrong argument count, declared return type already correct
pub fn f_ok() -> Int = plain(1)

# function, wrong argument count, declared return type genuinely wrong
pub fn f_bad() -> String = plain(1)

# function value, wrong argument count, declared return type genuinely wrong
pub fn v_bad(f: fn(Int) -> Int) -> String = f(1, 2)

# expression callee, wrong argument count, declared return type genuinely wrong.
# `(r.g)(1, 2)` used to be spelled here; since SYN-09 that is the fn-field form
# below, so the expression callee has to be something that only ever produces a
# function value.
pub fn e_bad(r: FnRec) -> String = pick(r)(1, 2)

# fn-typed field, wrong argument count, declared return type genuinely wrong
pub fn fld_bad(r: FnRec) -> String = r.g(1, 2)

# generic function, wrong argument count: the return type is unknown, so the
# arity error is the only thing reported
pub fn g_ok() -> Int = ident(1, 2)

pub fn g_bad() -> String = ident(1, 2)

# the same wrong call one line deeper: the arity error stays on the call and the
# return-type mismatch moves to the block, so nothing looks duplicated
pub fn blk_bad() -> String = {
  let k = 1
  plain(k)
}

# no arity error at all, same span rule for the mismatch
pub fn ret_only() -> String = 1

# generic constructor, too few fields: `cannot infer T` is a cascade of the
# missing field, so only the missing field is reported
pub fn gc_missing() -> Int = B()

# the same call with `T` bound from the expected type: the arity error alone
pub fn gc_missing_seeded() -> Box[Int] = B()

# a type parameter no field mentions, so its inference failure is not a cascade
pub fn gc_phantom() -> Int = P()

pub fn gc_phantom_ok() -> Int = P(1)

# one parameter of each kind in one call: `T` is reachable only through the
# missing fields and is dropped, `U` is mentioned by no field and survives
pub fn gc_mixed() -> Int = M()

# `T` is mentioned by the field that WAS supplied and still did not bind, so
# the missing field is not the whole story and the sentence stays
pub fn gc_shared() -> Int = H([])

# a misspelled field name leaves `x` unfilled too, and `cannot infer T` is just
# as much an echo of it -- but the diagnostic reported is a different one, and
# nothing here suppresses the echo of an error it did not report. Recorded as
# it is: a second cascade, of the wrong-field-name error, still open
pub fn gc_wrongname() -> Int = B(y: 1)

# generic constructor, too many fields: the type argument still binds from the
# arguments that are there, so the constructed type survives
pub fn gc_extra() -> Int = B(1, 2)

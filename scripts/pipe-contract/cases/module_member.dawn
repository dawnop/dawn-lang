# A bare `m.f` on the right of a pipe is a *value* the pipe applies, not a call
# it builds. The exported function now resolves as a value (#66), whose type
# has arity but no declaration name. Keep that diagnostic distinct from the
# named static call the parser mutant would synthesize.
use std/str

pub fn module_member(n: String) -> Bool = n |> str.starts_with

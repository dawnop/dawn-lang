# `origin` is an ordinary identifier everywhere, including as an operation
# name, a parameter and the continuation binder of a handler arm.
ctl effect Ask { fn origin(n: Int) -> Int }
fn origin(origin: Int) -> Int = origin
fn arm() -> Int = {
  with handle Ask { origin(n) resume origin => origin(n) }
  origin(1)
}
fn tail() -> Int = {
  with handle Ask { origin(n) resume resume =>
    n
  }
  origin(1)
}

# Ordinary environments and delivered type support have separate contracts.
use std/mem
use std/mem.{Mem}
fn forged[@s]() -> Int = {
  with handle Mem {
    mem_alloc(n) => panic("cannot create an old buffer")
    mem_alloc_f64(n) => panic("cannot create an old buffer")
  }
  len(mem.new(3))
}
pub fn main() -> Unit !io = println("probe")

# checker.dawn: + - * / % and unary - past Int and Float (arith-operator-traits D11)
pub type V = { x: Int }

pub type W = { x: Int }

impl Add[W] {
  fn add(a: W, b: W) -> W = W { x: a.x + b.x }
}

pub type Pair[T] = { a: T, b: T }

pub fn on_string() -> String = "a" + "b"

pub fn on_list(xs: List[Int]) -> List[Int] = xs + xs

pub fn on_bool() -> Bool = true - false

pub fn on_char(c: Char) -> Char = c * c

pub fn on_record(v: V) -> V = v / v

pub fn on_generic_record(p: Pair[Int]) -> Pair[Int] = p % p

pub fn negate_string() -> String = -"s"

pub fn unbounded[T](a: T, b: T) -> T = a + b

pub fn no_row[T: Add](a: T, b: T) -> T = a + b

pub fn mismatch(w: W) -> W = w + 1

pub fn int_left(w: W) -> W = 1 + w

pub fn sum[T: Add](xs: List[T], z: T) -> T !T.Add = fold(xs, z, (a, x) => a + x)

pub fn sum_records(vs: List[V], z: V) -> V = sum(vs, z)

pub fn make[T]() -> Pair[T] = todo()

pub fn left_uninferred(p: Pair[Int]) -> Pair[Int] = make() + p

pub effect Log {
  fn note(s: String) -> Unit
}

pub type Traced = { v: Int }

impl Add[Traced] {
  effect Add = !Log
  fn add(a: Traced, b: Traced) -> Traced !Log = {
    note("add")
    Traced { v: a.v + b.v }
  }
}

pub fn undeclared(t: Traced) -> Traced = t + t

# a tuple has no head, so no impl could exist: today's wording stands
pub fn on_tuple() -> (Int, Int) = (1, 2) + (3, 4)

pub fn negate_tuple() -> (Int, Int) = -(1, 2)

# the same left operand with no expectation reaching it keeps the old diagnostic
pub fn left_uninferred_free(p: Pair[Int]) -> Pair[Int] = {
  let q = make() + p
  q
}

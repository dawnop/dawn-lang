# Page shells: <head>, top navigation, footer. Triple-quoted templates keep
# the attribute quotes unescaped; $-interpolation fills the holes.
#
# Every shell takes its language explicitly. There is no defaulted overload on
# purpose: the site's default language is English and its long documents are
# Chinese, so a wrapper that quietly picked one would be wrong on most of the
# pages whichever one it picked.

use std/str
use html/render.{TocEntry}
use html/escape.{escape_html}

## Which language a page is written in. English is the site's default and
## lives at `/`; the Chinese front page lives at `/zh/`. The long-form
## documents (tutorial, spec, design, stdlib) are Chinese and are not
## translated -- site/pages/home.md's closing section says so on the page
## itself, rather than leaving a reader to discover it by clicking.
pub type Lang =
  | En
  | Zh
derive Show

## The `lang` attribute for <html>.
pub fn lang_code(lang: Lang) -> String =
  match lang {
    En -> "en"
    Zh -> "zh-CN"
  }

fn other(lang: Lang) -> Lang =
  match lang {
    En -> Zh
    Zh -> En
  }

## What the link to the other language says -- written in the language it
## leads to, which is the only way it is readable to the person who needs it.
fn lang_switch_label(lang: Lang) -> String =
  match lang {
    En -> "中文"
    Zh -> "English"
  }

## "Contents": the heading over the sticky TOC, and the label on the link a
## tutorial chapter carries back to the table of contents. One definition
## because they are one word -- two would be two things to keep level.
pub fn contents_label(lang: Lang) -> String =
  match lang {
    En -> "Contents"
    Zh -> "目录"
  }

## site navigation: (key, label, path-from-root)
fn nav_items(lang: Lang) -> List[(String, String, String)] =
  match lang {
    En -> [
      ("tutorial", "Tutorial", "tutorial/index.html"),
      ("spec", "Spec", "spec.html"),
      ("examples", "Examples", "examples/index.html"),
      ("stdlib", "Stdlib", "stdlib.html"),
      ("design", "Design", "design.html"),
      ("playground", "Playground", "playground.html"),
    ]
    Zh -> [
      ("tutorial", "教程", "tutorial/index.html"),
      ("spec", "规范", "spec.html"),
      ("examples", "示例", "examples/index.html"),
      ("stdlib", "标准库", "stdlib.html"),
      ("design", "设计", "design.html"),
      ("playground", "Playground", "playground.html"),
    ]
  }

fn nav_link(root: String, active: String, item: (String, String, String)) -> String = {
  let (key, label, path) = item
  let cls = if key == active { ` class="active"` } else { "" }
  """<a$cls href="$root/$path">$label</a>"""
}

fn nav_html(lang: Lang, root: String, active: String) -> String =
  join(map(nav_items(lang), it => nav_link(root, active, it)), "\n")

## The alternate-language <link>s, emitted only on the pages that really have
## a twin. Absolute, because that is what hreflang wants; the pair is the same
## on both members of it, with x-default pointing at the English original.
fn alternates(alt: String) -> String =
  if alt == "" {
    ""
  } else {
    `<link rel="alternate" hreflang="en" href="https://dawn-lang.dawnop.com/">` ++ "\n" ++
      `<link rel="alternate" hreflang="zh-CN" href="https://dawn-lang.dawnop.com/zh/">` ++ "\n" ++
      `<link rel="alternate" hreflang="x-default" href="https://dawn-lang.dawnop.com/">`
  }

fn lang_switch(lang: Lang, alt: String) -> String =
  if alt == "" {
    ""
  } else {
    """<a class="lang" href="$alt" hreflang="${lang_code(other(lang))}">${lang_switch_label(lang)}</a>"""
  }

## The full page around an already-rendered <main>/<div> body. `alt` is the
## href of this same page in the other language, or "" when there is none.
pub fn shell(
  lang: Lang,
  alt: String,
  title: String,
  root: String,
  active: String,
  body: String,
) -> String =
  shell_ext(lang, alt, title, root, active, "", body)

## Like [shell], but with extra markup injected into <head> (e.g. the Playground
## page's stylesheet + module script).
pub fn shell_ext(
  lang: Lang,
  alt: String,
  title: String,
  root: String,
  active: String,
  head_extra: String,
  body: String,
) -> String = {
  let esc_title = escape_html(title)
  let nav = nav_html(lang, root, active)
  let code = lang_code(lang)
  let alts = alternates(alt)
  let switch = lang_switch(lang, alt)
  """
<!DOCTYPE html>
<html lang="$code">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$esc_title</title>
<link rel="icon" href="$root/assets/favicon.ico" sizes="32x32">
<link rel="apple-touch-icon" href="$root/assets/apple-touch-icon.png">
<meta property="og:title" content="$esc_title">
<meta property="og:image" content="https://dawn-lang.dawnop.com/assets/logo-512.png">
<link rel="stylesheet" href="$root/assets/style.css">
$alts
$head_extra
</head>
<body>
<header class="site-header">
<nav>
<a class="brand" href="$root/index.html"><img class="brand-logo" src="$root/assets/apple-touch-icon.png" alt="">Dawn</a>
$nav
$switch
<a class="gh" href="https://github.com/dawnop/dawn-lang">GitHub</a>
</nav>
</header>
$body
<footer class="site-footer">
<div class="inner">Dawn — a small, elegant functional language · <a href="https://github.com/dawnop/dawn-lang">GitHub</a> · Built by a generator written in Dawn</div>
</footer>
</body>
</html>
"""
}

## A plain content page. `alt` is the href of this same page in the other
## language, or "" when there is none -- which is what every caller passes
## today, because the documents these render are Chinese and untranslated. The
## parameter is here rather than hard-coded so that translating one of them is
## an edit at its own call site instead of a change to this shell.
pub fn page(
  lang: Lang,
  alt: String,
  title: String,
  root: String,
  active: String,
  inner: String,
) -> String =
  shell(lang, alt, title, root, active, `<main class="content">` ++ "\n" ++ inner ++ "\n</main>")

## A page with the sticky TOC sidebar (the spec and design pages). `alt` as in
## [page].
pub fn page_with_toc(
  lang: Lang,
  alt: String,
  title: String,
  root: String,
  active: String,
  toc: List[TocEntry],
  article: String,
) -> String = {
  let heading =
    match lang {
      En -> "Contents"
      Zh -> "目录"
    }
  let side = "<aside class=\"toc\">\n<nav>\n<div class=\"toc-title\">" ++ heading ++ "</div>\n" ++
    toc_list(toc) ++ "\n</nav>\n</aside>"
  let body = `<div class="with-toc">` ++ "\n" ++ side ++ "\n" ++
    `<article class="doc">` ++ "\n" ++ article ++ "\n</article>\n</div>"
  shell(lang, alt, title, root, active, body)
}

## Nested <ul> for h2/h3 toc entries.
pub fn toc_list(entries: List[TocEntry]) -> String = {
  var out = "<ul>"
  var open3 = false
  for e in entries {
    if e.level == 2 {
      if open3 {
        out = out ++ "</ul></li>"
        open3 = false
      }
      out = out ++ "\n" ++ """<li><a href="#${e.id}">""" ++ escape_html(e.text) ++ "</a>"
    } else {
      if not open3 {
        out = out ++ "\n<ul>"
        open3 = true
      }
      out = out ++ "\n" ++ """<li><a href="#${e.id}">""" ++ escape_html(e.text) ++ "</a></li>"
    }
  }
  if open3 {
    out = out ++ "</ul></li>"
  } else if len(entries) > 0 {
    out = out ++ "</li>"
  }
  out ++ "\n</ul>"
}

test "nav marks the active page and roots the links" {
  let n = nav_html(Zh, "..", "spec")
  assert str.contains(n, `<a class="active" href="../spec.html">规范</a>`)
  assert str.contains(n, `<a href="../tutorial/index.html">教程</a>`)
}

test "the nav is labelled in the page's own language" {
  assert str.contains(nav_html(En, ".", ""), `<a href="./tutorial/index.html">Tutorial</a>`)
  assert str.contains(nav_html(Zh, ".", ""), `<a href="./tutorial/index.html">教程</a>`)
}

test "shell carries title, css root, body" {
  let p = page(Zh, "", "测试页 — Dawn", ".", "stdlib", "<p>x</p>")
  assert str.contains(p, "<title>测试页 — Dawn</title>")
  assert str.contains(p, `href="./assets/style.css"`)
  assert str.contains(p, `<main class="content">`)
  assert str.contains(p, "Built by a generator written in Dawn")
}

test "only a page with a twin advertises one" {
  # the English front page: lang=en, a switch to the Chinese one, hreflang pair
  let home = shell(En, "./zh/index.html", "Dawn", ".", "", "<p>x</p>")
  assert str.contains(home, `<html lang="en">`)
  assert str.contains(home, `<a class="lang" href="./zh/index.html" hreflang="zh-CN">中文</a>`)
  assert str.contains(home, `hreflang="x-default" href="https://dawn-lang.dawnop.com/"`)
  # the Chinese one points back, and says so in the language it leads to
  let zh = shell(Zh, "../index.html", "Dawn", "..", "", "<p>x</p>")
  assert str.contains(zh, `<html lang="zh-CN">`)
  assert str.contains(zh, `<a class="lang" href="../index.html" hreflang="en">English</a>`)
  # a document page has no twin: no switch, no alternates
  let doc = page(Zh, "", "规范 — Dawn", ".", "spec", "<p>x</p>")
  assert not str.contains(doc, `class="lang"`)
  assert not str.contains(doc, "hreflang")
  # ...and one that is given a twin advertises it through the same shell
  let paired = page(Zh, "../spec.html", "规范 — Dawn", ".", "spec", "<p>x</p>")
  assert str.contains(paired, `<a class="lang" href="../spec.html" hreflang="en">English</a>`)
}

test "toc nests h3 under its h2" {
  let t = toc_list([
    TocEntry { level: 2, id: "s1", text: "一" },
    TocEntry { level: 3, id: "s1-1", text: "一点一" },
    TocEntry { level: 2, id: "s2", text: "二" },
  ])
  assert str.contains(t, `<li><a href="#s1">一</a>` ++ "\n<ul>\n" ++ `<li><a href="#s1-1">一点一</a></li>` ++ "</ul></li>")
  assert str.contains(t, `<li><a href="#s2">二</a></li>`)
}

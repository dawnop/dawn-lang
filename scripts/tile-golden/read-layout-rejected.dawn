# Both APIs enforce the public type boundary before recording.
use std/gpu.{arg_in}
use std/narrow.{F32}
use tileir/prog.{cells}
use tileir/dev.{Dev, Param, idx_const, read_prefix, store_view, full}

fn old_along() -> Unit = {
  let _g = cells([4], [4], along = [0])
  let _entry = arg_in([4], [4], [0])
}
fn write_prefix(x: Param[F32]) -> Unit !Dev = {
  let view = read_prefix(x, 0, idx_const(1))
  store_view(view, [idx_const(0)], full([4], 1.0))
}

pub fn main() -> Unit = old_along()

# Narrow floats: bfloat16 and binary16 as types that round the way hardware does.
#
# `std/narrow` wraps the 64-bit `Float` in opaque types whose every operation
# rounds back to the format, so a chain of `add` on `BF16` is the bfloat16
# result bit for bit. Rounding after every step and rounding once at the end
# are different numbers, and the first is what a bf16 accumulator computes.

use std/narrow.{BF16, bf16, fp16, to_f64, add, mul, sqrt}

## The same number in three widths. `to_f64` is exact, so this shows rounding.
fn widths(x: Float) -> List[Float] = [x, to_f64(bf16(x)), to_f64(fp16(x))]

## `x` added up `n` times, every intermediate rounded to bfloat16.
fn step_by_step(x: Float, n: Int) -> Float = {
  var acc: BF16 = bf16(0.0)
  for _i in range(0, n) {
    acc = add(acc, bf16(x))
  }
  to_f64(acc)
}

## The same sum kept in `Float` and rounded once at the end.
fn once_at_the_end(x: Float, n: Int) -> Float =
  to_f64(bf16(fold(range(0, n), 0.0, (a, _i) => a + x)))

## Products drift too; 1.01 is not a bfloat16, so the drift starts at the input.
fn compound(rate: Float, n: Int) -> Float = {
  var acc: BF16 = bf16(1.0)
  for _i in range(0, n) {
    acc = mul(acc, bf16(rate))
  }
  to_f64(acc)
}

pub fn main() -> Unit !io = {
  println("0.1 as Float, bf16, fp16: ${widths(0.1)}")
  println("ten times 0.1, rounded every step: ${step_by_step(0.1, 10)}")
  println("ten times 0.1, rounded once:       ${once_at_the_end(0.1, 10)}")
  println("1.01 compounded 100 times in bf16: ${compound(1.01, 100)}")
  println("sqrt 2 in bf16: ${to_f64(sqrt(bf16(2.0)))}")
  println("65504 and 70000 in fp16: ${to_f64(fp16(65504.0))} ${to_f64(fp16(70000.0))}")
  # order and equality come from the Float inside
  println("bf16(0.1) < bf16(0.2): ${bf16(0.1) < bf16(0.2)}")
}

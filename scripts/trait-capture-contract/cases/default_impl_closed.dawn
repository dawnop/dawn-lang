# Full witness support cannot widen an omitted implementation Type value bound.
trait Measure[T: ^{c}, ^c] { fn measure(value: T) -> Int }
type Box[T] = { value: T }
impl[T, ^c] Measure[Box[T], c] {
  fn measure(value: Box[T]) -> Int = 0
}
fn scoped[@s](value: I64Buf@s) -> Int = measure(Box { value = value })
pub fn main() -> Unit !io = ()

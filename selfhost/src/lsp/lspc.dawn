# Completion (the Kotlin Completion.kt): everything nameable at the cursor —
# locals of the enclosing function, module + imported functions, types and
# constructors, builtins, and keywords. Suppressed where a suggestion can only
# be noise: inside strings and comments, while naming a fresh binding, and
# after `.`. `!` completes the one builtin effect. All offsets are UTF-16 code
# units (the LSP wire encoding).
#
# A `use` line completes too, and to something else entirely: module paths one
# segment at a time, then the module's exported names inside `.{ }`. That is
# the toolchain half of "the directory tree IS the namespace" (#179) -- the
# tree is only a namespace you can navigate if something enumerates it, and
# until now nothing did. Project-aware documents receive the directory index
# during analysis; this branch reads disk only for unloaded module declarations.

use std/io
use std/str
use std/map
use std/set
use std/list
use check/types.{
  ty_show, sig_render, adt_of, trait_of, prelude_traits, prelude_trait_ids,
  public_builtin_type_names, return_only_builtin_type_names,
  ty_named, builtin_type_at, builtin_type_name_reserved, hard_reserved_builtin_type_name,
  Audience, AModule, audience_covers, declared_audience
}
use check/cx.{ModExports}
use lsp/lspq.{QCx, locals_at, in_for_pattern}
use front/lexer.{SourceView, view_of, slice_cp, lex}
use front/token.{
  Token, TokKind, FOR, IN, PIPE, NEWLINE, EOF, IDENT,
  LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET, COMMA, DOT, TYPEIDENT
}
use front/ast.{
  module_traits, module_fns, module_types, module_consts, module_effects, module_uses
}
use front/parser
use driver/analyze.{use_candidates}

## One completion item, ready to serialize. `kind` is the LSP CompletionItemKind
## code (Function=3, Variable=6, Class=7, Interface=8, Keyword=14, EnumMember=20).
pub type CItem = {
  label: String,
  kind: Int,
  detail: Option[String],
  sort_text: Option[String]
}

# ---- the lexical spot the cursor sits in (mirrors the tokenizer's rules) ----

# 0 = code, 1 = comment, 2 = string (no completion), 3 = interpolation (code)
fn lex_ctx(v: SourceView, pos: Int) -> Int = {
  let cps = v.cps
  var kind = 0
  var i = 0
  let n = len(cps)
  while i < n && i < pos {
    let ch = cps[i]
    if kind == 0 {
      if ch == '"' && i + 2 < n && cps[i + 1] == '"' && cps[i + 2] == '"' {
        kind = 3
        i = i + 3
      } else if ch == '#' {
        kind = 1
        i = i + 1
      } else if ch == '"' {
        kind = 2
        i = i + 1
      } else if ch == '`' {
        kind = 4
        i = i + 1
      } else if ch == '\'' {
        i = i + 1
        if i < n && cps[i] == '\\' { i = i + 1 }
        i = i + 1
        if i < n && cps[i] == '\'' { i = i + 1 }
      } else {
        i = i + 1
      }
    } else if kind == 1 {
      if ch == '\n' { kind = 0 }
      i = i + 1
    } else if kind == 2 {
      if ch == '\\' {
        i = i + 2
      } else if ch == '"' || ch == '\n' {
        kind = 0
        i = i + 1
      } else {
        i = i + 1
      }
    } else if kind == 3 {
      if ch == '\\' {
        i = i + 2
      } else if ch == '"' && i + 2 < n && cps[i + 1] == '"' && cps[i + 2] == '"' {
        kind = 0
        i = i + 3
      } else {
        i = i + 1
      }
    } else {
      if ch == '`' { kind = 0 }
      i = i + 1
    }
  }
  if kind == 1 {
    1
  } else if kind == 2 || kind == 3 {
    # a `$name` or `${expr}` being typed completes like code (a 200-code-point
    # look-back window is plenty to see the opening `$`/`${`)
    let lo = if pos - 200 > 0 { pos - 200 } else { 0 }
    if interp_tail(code_points(slice_cp(v, lo, pos))) { 3 } else { 2 }
  } else if kind == 4 {
    2
  } else {
    0
  }
}

## Does the tail end inside a `$name` or `${...}` interpolation being typed?
fn interp_tail(tail: List[Char]) -> Bool = {
  let n = len(tail)
  # `\$[A-Za-z_]\w*$`: a word run at the end, opened by `$` + letter/underscore
  var i = n
  while i > 0 && is_word(tail[i - 1]) { i = i - 1 }
  if i < n && i > 0 && tail[i - 1] == '$' {
    let c0 = tail[i]
    if c0 == '_' || (c0 >= 'a' && c0 <= 'z') || (c0 >= 'A' && c0 <= 'Z') { return true }
  }
  # `\$\{[^}"]*$`: an unclosed `${` with no `}` or `"` after it
  var j = n - 1
  while j >= 0 {
    let c = tail[j]
    if c == '}' || c == '"' { return false }
    if c == '{' {
      return j > 0 && tail[j - 1] == '$'
    }
    j = j - 1
  }
  false
}

fn is_word(c: Char) -> Bool =
  c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')

fn is_space(c: Char) -> Bool =
  c == ' ' || c == '\t' || c == '\n' || c == '\u{000B}' || c == '\u{000C}' || c == '\r'

## A conservative lexical test for the point immediately after a function
## return arrow. It scans across newlines, but stops at a surrounding body or
## match arm before accepting an older `fn`. Delimiters inside the parameter
## list do not stop it, so multiline signatures and default expressions work.
fn return_type_tail(before: List[Char]) -> Bool = {
  var i = len(before)
  while i > 0 && is_space(before[i - 1]) { i = i - 1 }
  if i < 2 || before[i - 2] != '-' || before[i - 1] != '>' { return false }
  i = i - 2
  var parens = 0
  var brackets = 0
  while i > 0 {
    let c = before[i - 1]
    if c == ')' {
      parens = parens + 1
      i = i - 1
    } else if c == '(' {
      if parens > 0 { parens = parens - 1 }
      i = i - 1
    } else if c == ']' {
      brackets = brackets + 1
      i = i - 1
    } else if c == '[' {
      if brackets > 0 { brackets = brackets - 1 }
      i = i - 1
    } else if parens == 0 && brackets == 0 && (c == '{' || c == '}' || c == ';') {
      return false
    } else if is_word(c) {
      let end = i
      while i > 0 && is_word(before[i - 1]) { i = i - 1 }
      if from_code_points(slice_cps(before, i, end)) == "fn" { return true }
    } else {
      i = i - 1
    }
  }
  false
}

## `(?:^|[^\w])(?:fn|let|var|const|type|for|derive|trait)\s+$`
fn fresh_name_tail(before: List[Char]) -> Bool = {
  let n = len(before)
  var i = n
  while i > 0 && is_space(before[i - 1]) { i = i - 1 }
  if i == n { return false }
  var j = i
  while j > 0 && is_word(before[j - 1]) { j = j - 1 }
  if j > 0 && is_word(before[j - 1]) { return false }
  let w = from_code_points(slice_cps(before, j, i))
  w == "fn" || w == "let" || w == "var" || w == "const" || w == "type" || w == "for" ||
    w == "derive" || w == "trait"
}

## `^\s*(?:pub\s+)?use\b` — everything after the keyword, or None when the
## cursor is not on a `use` line. The word being typed is peeled off before
## this sees the line (the client filters on it), so the tail always ends
## where a fresh segment or name would begin.
fn use_tail(before: List[Char]) -> Option[List[Char]] = {
  let n = len(before)
  var i = 0
  while i < n && is_space(before[i]) { i = i + 1 }
  if i + 3 <= n && from_code_points(slice_cps(before, i, i + 3)) == "pub" {
    if i + 3 < n && is_space(before[i + 3]) {
      var k = i + 3
      while k < n && is_space(before[k]) { k = k + 1 }
      i = k
    }
  }
  if i + 3 <= n && from_code_points(slice_cps(before, i, i + 3)) == "use" {
    if i + 3 == n || not is_word(before[i + 3]) {
      var j = i + 3
      while j < n && is_space(before[j]) { j = j + 1 }
      Some(slice_cps(before, j, n))
    } else {
      None
    }
  } else {
    None
  }
}

fn slice_cps(cps: List[Char], lo: Int, hi: Int) -> List[Char] = {
  var out: List[Char] = []
  var i = lo
  while i < hi {
    out = out ++ [cps[i]]
    i = i + 1
  }
  out
}

fn next_non_newline(toks: List[Token], at: Int) -> Int = {
  var i = at
  while i < len(toks) && toks[i].kind == NEWLINE { i = i + 1 }
  i
}

fn pattern_top(parens: Int, brackets: Int, braces: Int) -> Bool =
  parens == 0 && brackets == 0 && braces == 0

fn for_header_newline_continues(previous_pipe: Bool, next_kind: TokKind) -> Bool =
  previous_pipe || next_kind == PIPE

fn remember_latest_for(latest: Option[Int], found: Int) -> Option[Int] = Some(found)

fn previous_is_pipe(toks: List[Token], previous: Int) -> Bool =
  previous >= 0 && toks[previous].kind == PIPE

fn pattern_depth_before(toks: List[Token], at: Int, before: Int) -> (Int, Int, Int) = {
  var parens = 0
  var brackets = 0
  var braces = 0
  var i = at
  while i < before {
    let kind = toks[i].kind
    if kind == LPAREN {
      parens = parens + 1
    } else if kind == RPAREN {
      parens = parens - 1
    } else if kind == LBRACKET {
      brackets = brackets + 1
    } else if kind == RBRACKET {
      brackets = brackets - 1
    } else if kind == LBRACE {
      braces = braces + 1
    } else if kind == RBRACE {
      braces = braces - 1
    }
    i = i + 1
  }
  (parens, brackets, braces)
}

## Find the balanced top-level `in` that closes one `for` header. A top-level
## newline belongs to the header only around a continuation `|`; braces count
## as pattern nesting only after a constructor name, never as a loop body.
fn for_header_in(toks: List[Token], at: Int) -> Option[Int] = {
  var parens = 0
  var brackets = 0
  var braces = 0
  var previous_pipe = false
  var previous_type = false
  var i = at
  while i < len(toks) {
    let kind = toks[i].kind
    if kind == EOF { return None }
    if kind == NEWLINE {
      if pattern_top(parens, brackets, braces) {
        let next = next_non_newline(toks, i + 1)
        if next >= len(toks) || not for_header_newline_continues(previous_pipe, toks[next].kind) {
          return None
        }
      }
      i = i + 1
      continue
    }
    if kind == IN && pattern_top(parens, brackets, braces) {
      return Some(i)
    }
    if kind == LPAREN {
      parens = parens + 1
    } else if kind == RPAREN {
      if parens == 0 { return None }
      parens = parens - 1
    } else if kind == LBRACKET {
      brackets = brackets + 1
    } else if kind == RBRACKET {
      if brackets == 0 { return None }
      brackets = brackets - 1
    } else if kind == LBRACE {
      if not previous_type { return None }
      braces = braces + 1
    } else if kind == RBRACE {
      if braces == 0 { return None }
      braces = braces - 1
    }
    previous_pipe = kind == PIPE
    previous_type = kind == TYPEIDENT
    i = i + 1
  }
  None
}

fn recursive_pattern_boundary(
  boundary: TokKind,
  is_header_in: Bool,
  parens: Int,
  brackets: Int,
  braces: Int
) -> Bool =
  if boundary == IN {
    is_header_in && pattern_top(parens, brackets, braces)
  } else if boundary == PIPE {
    true
  } else if boundary == COMMA {
    parens > 0 || brackets > 0 || braces > 0
  } else if boundary == RPAREN {
    parens > 0
  } else if boundary == RBRACKET {
    brackets > 0
  } else if boundary == RBRACE {
    braces > 0
  } else {
    false
  }

## Is `pos` the empty atom after an or-pattern pipe? The token after the gap
## must be a boundary at the same recursive-pattern depth, rather than a typed
## atom whose span merely happens to start at the cursor.
fn missing_for_alternative_at(
  toks: List[Token],
  at: Int,
  header_in: Int,
  scan_end: Int,
  pos: Int
) -> Bool = {
  var previous = -1
  var next = scan_end
  var i = at
  while i <= scan_end {
    let tok = toks[i]
    if tok.lo < pos && pos < tok.hi { return false }
    if tok.hi <= pos {
      if tok.kind != NEWLINE { previous = i }
    } else if tok.lo >= pos && tok.kind != NEWLINE {
      next = i
      break
    }
    i = i + 1
  }
  if not previous_is_pipe(toks, previous) { return false }
  let (parens, brackets, braces) = pattern_depth_before(toks, at, previous)

  recursive_pattern_boundary(toks[next].kind, next == header_in, parens, brackets, braces)
}

fn qualified_incomplete_alternative_at(
  toks: List[Token],
  at: Int,
  header_in: Int,
  alias_lo: Int,
  pos: Int
) -> Bool = {
  var alias_at = -1
  var previous = -1
  var next = header_in
  var i = at
  while i <= header_in {
    let tok = toks[i]
    if tok.lo == alias_lo { alias_at = i }
    if tok.hi <= alias_lo && tok.kind != NEWLINE { previous = i }
    if tok.lo >= pos && tok.kind != NEWLINE {
      next = i
      break
    }
    i = i + 1
  }
  if alias_at < 0 || toks[alias_at].kind != IDENT || alias_at + 1 >= len(toks) ||
    toks[alias_at + 1].kind != DOT || not previous_is_pipe(toks, previous) {
      return false
    }
  let (parens, brackets, braces) = pattern_depth_before(toks, at, previous)
  recursive_pattern_boundary(toks[next].kind, next == header_in, parens, brackets, braces)
}

fn in_incomplete_qualified_for_pattern(text: String, alias_lo: Int, pos: Int) -> Bool = {
  let (toks, _) = lex(text)
  var latest_for: Option[Int] = None
  var i = 0
  while i < len(toks) && toks[i].lo <= alias_lo {
    if toks[i].kind == FOR && toks[i].hi <= alias_lo {
      latest_for = Some(i)
    }
    i = i + 1
  }
  match latest_for {
    Some(for_at) -> match for_header_in(toks, for_at + 1) {
      Some(header_in) ->
        pos <= toks[header_in].lo &&
        qualified_incomplete_alternative_at(toks, for_at + 1, header_in, alias_lo, pos)
      None -> false
    }
    None -> false
  }
}

## The parsed AST owns ordinary for-pattern completion. This recovery owns the
## one state where no SFor can exist yet: an or-pattern alternative whose atom
## has not been typed. It finds the enclosing header from lexer tokens, not
## from line text, and accepts a gap only when the next token is a pattern
## boundary and a balanced top-level `in` still closes the same header.
## Consequently the source, range upper bound, body and following statements
## are all beyond the delimiter and cannot be mistaken for pattern context.
fn in_incomplete_for_pattern(text: String, pos: Int) -> Bool = {
  let (toks, _) = lex(text)
  var latest_for: Option[Int] = None
  var i = 0
  while i < len(toks) && toks[i].lo <= pos {
    if toks[i].kind == FOR && toks[i].hi <= pos {
      latest_for = remember_latest_for(latest_for, i)
    }
    i = i + 1
  }
  match latest_for {
    Some(for_at) -> match for_header_in(toks, for_at + 1) {
      Some(header_in) ->
        pos <= toks[header_in].lo &&
        missing_for_alternative_at(toks, for_at + 1, header_in, header_in, pos)
      None -> false
    }
    None -> false
  }
}

# ---- assembly ----

type Items = { out: List[CItem], seen: Set[String] }

fn add(it: Items, name: String, kind: Int, detail: Option[String], rank: String) -> Items = {
  if name == "_" || set.has(it.seen, name) { return it }
  Items {
    out: it.out ++ [CItem {
      label: name,
      kind: kind,
      detail: detail,
      sort_text: Some(rank ++ name)
    }],
    seen: set.insert(it.seen, name)
  }
}

# ---- `use` lines: module paths, then the names inside `.{ }` ----
#
# Kinds are the LSP's, and two of them are new here: Module=9 for a module
# path that can be imported as it stands, Folder=19 for a directory that is
# only a step on the way to one. A directory's label carries its trailing `/`,
# so the list reads the way the line will: `front/`, then `lexer`.

fn path_char(c: Char) -> Bool = is_word(c) || c == '/'

## May the document being edited name the module `path` at all?
##
## A completion list is a surface being consumed, so it answers to the audience
## the checker will (docs/public-surface-design.md §7.1): `std/hamt` and
## `std/pvec` hold the representation of `Map`, `Set` and `List`, and
## `pass_imports` refuses a `use` of either from outside the bundled library.
## Offering them is offering a name the next keystroke is not allowed to write.
## The question is asked of the document's own module, not of a root audience:
## `std/map` is a world-facing module that may nonetheless name them.
fn may_name_module(qc: QCx, path: String) -> Bool =
  audience_covers(declared_audience(path), AModule(qc.entry.mod_path))

## Everything a `use` line admits at the cursor.
fn use_completions(
  qc: QCx,
  candidates: Map[String, String],
  tail: List[Char]
) -> List[CItem] !io = {
  let n = len(tail)
  var i = 0
  while i < n && path_char(tail[i]) { i = i + 1 }
  let path = from_code_points(slice_cps(tail, 0, i))
  let rest = slice_cps(tail, i, n)
  if len(rest) == 0 { return path_items(qc, candidates, path) }
  if rest[0] == '.' {
    return import_items(qc, candidates, path, slice_cps(rest, 1, len(rest)))
  }
  # `use java "com.x.Y"` names a class, not a module path. The quoted name is
  # already suppressed as a string (lex_ctx), so this is the gap before it,
  # where a module path would go and a class name cannot be guessed.
  if path == "java" {
    let none: List[CItem] = []
    return none
  }
  # After a whole path the grammar admits one more thing: `as <name>`. The
  # name is the user's to pick, so once `as` is there we are done.
  if str.trim(from_code_points(rest)) == "" && path != "" {
    let d: Option[String] =
      Some("`use " ++ path ++ " as <name>` — rename the module in this file")
    return [CItem { label: "as", kind: 14, detail: d, sort_text: Some("0as") }]
  }
  let none2: List[CItem] = []
  none2
}

## The next segment, for every candidate path under the segments already
## typed. A candidate that ends here is a module; one that continues is a
## directory, and the two can share a name (`a/b.dawn` beside `a/b/c.dawn`),
## which is why the trailing `/` is part of the label rather than decoration.
fn seg_items(it0: Items, prefix: List[String], paths: List[String], rank: String) -> Items = {
  var it = it0
  let d = len(prefix)
  for mp in paths {
    let segs = str.split(mp, "/")
    if len(segs) > d && list.take(segs, d) == prefix {
      if len(segs) == d + 1 {
        it = add(it, segs[d], 9, Some(mp), rank)
      } else {
        let dir = join(list.take(segs, d + 1), "/")
        it = add(it, segs[d] ++ "/", 19, Some(dir ++ "/…"), rank)
      }
    }
  }
  it
}

## Module paths one segment at a time. `typed` is the path so far; the segment
## being typed was peeled off with the word, so it ends at a `/` or is empty.
##
## Two sources, and they are ranked apart only because the first segment is
## where they meet: below it a path is either under `std/` or it is not, so
## the groups never interleave again.
fn path_items(
  qc: QCx,
  candidates: Map[String, String],
  typed: String
) -> List[CItem] !io = {
  let parts = str.split(typed, "/")
  let prefix = list.take(parts, len(parts) - 1)
  var it = Items { out: [], seen: set.empty() }
  it = seg_items(it, prefix, sort(map.keys(candidates)), "0")
  var std_paths: List[String] = []
  for mp in sort(map.keys(qc.std.exports)) {
    if may_name_module(qc, mp) { std_paths = std_paths ++ [mp] }
  }
  it = seg_items(it, prefix, std_paths, "1")
  if len(prefix) == 0 {
    let d: Option[String] = Some("`use java \"com.x.Y\"` — import a Java class")
    it = add(it, "java", 14, d, "2")
  }
  it.out
}

## The names inside `use a/b.{ }`. `after` is everything between the `.` and
## the word being typed.
fn import_items(
  qc: QCx,
  candidates: Map[String, String],
  path: String,
  after: List[Char]
) -> List[CItem] !io = {
  let none: List[CItem] = []
  let n = len(after)
  # `use a/b.` — a selective import is the only thing a `.` can open, and it
  # opens with `{`. A list already closed is not being added to.
  if n == 0 || after[0] != '{' { return none }
  # a module this document may not name has no names to offer it
  if not may_name_module(qc, path) { return none }
  var seen: Set[String] = set.empty()
  for nm in str.split(from_code_points(slice_cps(after, 1, n)), ",") {
    let t = str.trim(nm)
    if t == "}" || str.contains(t, "}") { return none }
    if t != "" { seen = set.insert(seen, t) }
  }
  var it = Items { out: [], seen: seen }
  # A module already in the program has been checked, so its exports carry
  # rendered signatures. The one being imported by the line under the cursor
  # has not -- that `use` is what would have loaded it, and it does not parse
  # yet -- so it is read and parsed here for its names alone.
  match map.get(qc.exports_env, path) {
    Some(ex) -> exported_items(qc, it, ex)
    None ->
      match map.get(candidates, path) {
        Some(f) ->
          match io.read_file(f) {
            Ok(text) -> declared_items(it, text)
            Err(_) -> none
          }
        None -> none
      }
  }
}

## A checked module's exports, with the signatures the checker rendered.
fn exported_items(qc: QCx, it0: Items, ex: ModExports) -> List[CItem] = {
  var it = it0
  let adts = qc.entry.cx.adts
  for pr in map.entries(ex.fns) {
    let (name, sig) = pr
    it = add(it, name, 3, Some(sig_render(adts, qc.entry.cx.traits, sig)), "0")
  }
  for name in map.keys(ex.types_by_name) { it = add(it, name, 7, Some("type " ++ name), "0") }
  for name in map.keys(ex.aliases) { it = add(it, name, 7, Some("alias " ++ name), "0") }
  for name in map.keys(ex.ctors) { it = add(it, name, 20, Some("constructor"), "0") }
  for pr in map.entries(ex.consts) {
    let (name, ty) = pr
    it = add(it, name, 21, Some("const " ++ name ++ ": " ++ ty_show(adts, ty)), "0")
  }
  for name in map.keys(ex.traits_by_name) { it = add(it, name, 8, Some("trait " ++ name), "0") }
  for name in map.keys(ex.effects) { it = add(it, name, 23, Some("effect " ++ name), "0") }
  it.out
}

## The same surface read off the source instead: every `pub` declaration the
## parser found. No signatures — nothing has checked this module — and no
## trait methods, which become importable only once the trait is known to
## inject them.
fn declared_items(it0: Items, text: String) -> List[CItem] = {
  var it = it0
  let (m, _) = parser.parse_module(text)
  for d in module_fns(m) {
    if d.is_pub { it = add(it, d.name, 3, Some("fn " ++ d.name), "0") }
  }
  for d in module_types(m) {
    if d.is_pub {
      let kind = match d.alias_target {
        Some(_) -> "alias "
        None -> "type "
      }
      it = add(it, d.name, 7, Some(kind ++ d.name), "0")
      for c in d.ctors { it = add(it, c.name, 20, Some("constructor of " ++ d.name), "0") }
    }
  }
  for d in module_consts(m) {
    if d.is_pub { it = add(it, d.name, 21, Some("const " ++ d.name), "0") }
  }
  for d in module_traits(m) {
    if d.is_pub { it = add(it, d.name, 8, Some("trait " ++ d.name), "0") }
  }
  for d in module_effects(m) {
    if d.is_pub { it = add(it, d.name, 23, Some("effect " ++ d.name), "0") }
  }
  it.out
}

pub fn keywords() -> List[String] =
  ["fn", "let", "var", "type", "alias", "const", "use", "java", "pub", "trait", "impl",
    "match", "if", "else", "for", "in", "while", "return", "break", "continue",
    "comptime", "unsafe_pure", "test", "assert", "with", "true", "false", "not"]

fn add_adt_completions(qc: QCx, it0: Items, include_types: Bool) -> Items = {
  var it = it0
  for pr in map.entries(qc.entry.cx.adts_by_name) {
    let (_, aid) = pr
    let a = adt_of(qc.entry.cx.adts, aid)
    if include_types { it = add(it, a.name, 7, Some("type " ++ a.name), "1") }
    for c in a.ctors {
      let detail =
        if len(c.fields) == 0 {
          c.name
        } else {
          c.name ++ "(" ++
            join(map(c.fields, f => f.name ++ ": " ++ ty_show(qc.entry.cx.adts, f.ty)), ", ") ++
            ")"
        }
      it = add(it, c.name, 20, Some(detail), "1")
    }
  }
  it
}

## A malformed declaration may preserve its parsed type declarations while
## checker recovery has no local ADT table. The incomplete-header path still
## needs those constructors, and source declarations are enough to name them.
fn checked_source_constructor(qc: QCx, type_name: String, ctor_name: String) -> Bool =
  match map.get(qc.entry.cx.ctors_by_name, ctor_name) {
    Some(pair) -> {
      let (aid, slot) = pair
      let a = adt_of(qc.entry.cx.adts, aid)
      if a.name != type_name || a.owner != Some(qc.entry.class_name) { return false }
      0 <= slot && slot < len(a.ctors) && a.ctors[slot].name == ctor_name
    }
    None -> false
  }

fn source_type_name_available(qc: QCx, name: String, seen: Set[String]) -> Bool = {
  if set.has(seen, name) { return false }
  if map.has(qc.entry.cx.java_classes, name) || map.has(qc.entry.cx.module_aliases, name) ||
    map.has(qc.entry.cx.imported_names, name) || map.has(qc.entry.cx.aliases, name) {
      return false
    }
  match builtin_type_at(name) {
    Some(info) -> if builtin_type_name_reserved(info, qc.entry.cx.is_std_module) {
      false
    } else {
      source_type_name_absent_or_local(qc, name)
    }
    None -> source_type_name_absent_or_local(qc, name)
  }
}

fn source_type_name_absent_or_local(qc: QCx, name: String) -> Bool = {
  for pair in map.entries(qc.entry.cx.adts) {
    let (_, a) = pair
    if a.name == name { return a.owner == Some(qc.entry.class_name) }
  }
  true
}

fn source_constructor_name_available(
  qc: QCx,
  type_name: String,
  ctor_name: String,
  seen: Set[String]
) -> Bool = {
  if set.has(seen, ctor_name) || hard_reserved_builtin_type_name(ctor_name) { return false }
  match ty_named(ctor_name) {
    Some(_) -> false
    None -> match map.get(qc.entry.cx.ctors_by_name, ctor_name) {
      Some(_) -> checked_source_constructor(qc, type_name, ctor_name)
      None -> true
    }
  }
}

fn add_source_constructor_completions(qc: QCx, text: String, it0: Items) -> Items = {
  let (m, _) = parser.parse_module(text)
  var it = it0
  var seen_types: Set[String] = set.empty()
  var seen_ctors: Set[String] = set.empty()
  for d in module_types(m) {
    let type_ok = source_type_name_available(qc, d.name, seen_types)
    seen_types = set.insert(seen_types, d.name)
    for c in d.ctors {
      if type_ok && source_constructor_name_available(qc, d.name, c.name, seen_ctors) {
        it = add(it, c.name, 20, Some("constructor of " ++ d.name), "1")
      }
      seen_ctors = set.insert(seen_ctors, c.name)
    }
  }
  it
}

fn qualified_alias_before_dot(cps: List[Char], word_start: Int) -> Option[(String, Int)] = {
  if word_start < 1 || cps[word_start - 1] != '.' { return None }
  var alias_lo = word_start - 1
  while alias_lo > 0 && is_word(cps[alias_lo - 1]) { alias_lo = alias_lo - 1 }
  if alias_lo == word_start - 1 { return None }
  Some((from_code_points(slice_cps(cps, alias_lo, word_start - 1)), alias_lo))
}

fn qualified_pattern_constructors(qc: QCx, module_alias: String) -> List[CItem] = {
  let none: List[CItem] = []
  var imported_path = map.get(qc.entry.cx.module_aliases, module_alias)
  if imported_path == None {
    for imported in module_uses(qc.entry.m) {
      match imported.selective {
        None -> if imported.alias_name == module_alias && map.has(qc.exports_env, imported.path) {
          match imported_path {
            Some(previous) -> if previous != imported.path { return none }
            None -> { imported_path = Some(imported.path) }
          }
        }
        Some(_) -> ()
      }
    }
  }
  match imported_path {
    Some(path) -> match map.get(qc.exports_env, path) {
      Some(ex) -> {
        var it = Items { out: [], seen: set.empty() }
        for name in map.keys(ex.ctors) {
          it = add(it, name, 20, Some("constructor from " ++ module_alias), "0")
        }
        it.out
      }
      None -> none
    }
    None -> none
  }
}

pub fn completions_at(
  qc: QCx,
  project_modules: Option[Map[String, String]],
  text: String,
  offset: Int
) -> List[CItem] !io = {
  let v = view_of(text)
  let cps = v.cps
  let n = len(cps)
  # `offset` is a code-point index (server.dawn converts the wire UTF-16 position at
  # the boundary), so it is the cursor's code-point index directly, clamped.
  let pos = if offset < 0 {
    0
  } else if offset > n {
    n
  } else {
    offset
  }
  let ctx = lex_ctx(v, pos)
  if ctx == 1 || ctx == 2 {
    let none: List[CItem] = []
    return none
  }
  # back over word chars from the cursor to the word start
  var k = pos
  var ws = k
  while ws > 0 && is_word(cps[ws - 1]) { ws = ws - 1 }
  var ls = ws
  while ls > 0 && cps[ls - 1] != '\n' { ls = ls - 1 }
  let before = slice_cps(cps, ls, ws)
  let nb = len(before)
  let in_return_type = return_type_tail(slice_cps(cps, 0, ws))
  # the effect row: `!` admits exactly one builtin effect
  if nb > 0 && before[nb - 1] == '!' {
    let d: Option[String] = Some("the IO effect — this function may perform input/output")
    let st: Option[String] = None
    return [CItem { label: "io", kind: 14, detail: d, sort_text: st }]
  }
  if fresh_name_tail(before) {
    let none: List[CItem] = []
    return none
  }
  match use_tail(before) {
    Some(tail) -> {
      # Project-aware documents reuse the module index captured during their
      # analysis. Only standalone buffers plan afresh, once for this request.
      let candidates = match project_modules {
        Some(modules) -> modules
        None -> use_candidates(qc.entry.path)
      }
      return use_completions(qc, candidates, tail)
    }
    None -> ()
  }
  if nb > 0 && before[nb - 1] == '.' && (nb < 2 || before[nb - 2] != '.') {
    match qualified_alias_before_dot(cps, ws) {
      Some(pair) -> {
        let (module_alias, alias_lo) = pair
        if in_for_pattern(qc, pos) || in_incomplete_qualified_for_pattern(text, alias_lo, pos) {
          return qualified_pattern_constructors(qc, module_alias)
        }
      }
      None -> ()
    }
    let none: List[CItem] = []
    return none
  }

  var it = Items { out: [], seen: set.empty() }
  if in_for_pattern(qc, pos) {
    return add_adt_completions(qc, it, false).out
  }
  if in_incomplete_for_pattern(text, pos) {
    it = add_adt_completions(qc, it, false)
    return add_source_constructor_completions(qc, text, it).out
  }
  # locals of the enclosing function: parameters + binders before the cursor
  for pr in locals_at(qc, pos) {
    let (name, detail) = pr
    it = add(it, name, 6, detail, "0")
  }
  for pr in map.entries(qc.entry.cx.fns) {
    let (name, sig) = pr
    # synthesized names (`f$default$k`) are unspellable and stay out of sight
    if not str.contains(name, "\$") {
      it = add(it, name, 3, Some(sig_render(qc.entry.cx.adts, qc.entry.cx.traits, sig)), "1")
    }
  }
  it = add_adt_completions(qc, it, true)
  for tv in module_traits(qc.entry.m) {
    it = add(it, tv.name, 8, Some("trait " ++ tv.name ++ "[" ++ tv.tp ++ "]"), "1")
  }
  # every prelude trait, read off the one table so a new one shows up here
  # without a second transcription (docs/prelude-namespace-design.md §4.3)
  let pts = prelude_traits()
  for tid in prelude_trait_ids() {
    let ptr = trait_of(pts, tid)
    it = add(it, ptr.name, 8,
      Some("trait " ++ ptr.name ++ "[" ++ ty_show(qc.entry.cx.adts, ptr.tvar) ++ "]"), "2")
  }
  # Both tables: a migrated function is still part of the implicitly-visible
  # surface, and users cannot tell which side it lives on.
  for pr in map.entries(qc.bins) {
    let (name, sig) = pr
    it = add(it, name, 3, Some(sig_render(qc.entry.cx.adts, qc.entry.cx.traits, sig)), "2")
  }
  for pr in map.entries(qc.std.std_fns) {
    let (name, sig) = pr
    it = add(it, name, 3, Some(sig_render(qc.entry.cx.adts, qc.entry.cx.traits, sig)), "2")
  }
  for t in public_builtin_type_names() {
    it = add(it, t, 7, Some("builtin type"), "2")
  }
  if in_return_type {
    for t in return_only_builtin_type_names() {
      it = add(it, t, 7, Some("builtin return type"), "2")
    }
  }
  for kw in keywords() {
    let nd: Option[String] = None
    it = add(it, kw, 14, nd, "3")
  }
  let nd2: Option[String] = None
  it = add(it, "derive", 14, nd2, "3")
  it.out
}

# ---- tests ----
#
# The `use` branch's disk-reading half is checked end to end against the real
# tree by scripts/lsp-use-completion.py -- an oracle a unit test cannot have,
# since the answer is what is on disk. What is left here is the two pure
# decisions it rests on: where the tail of a `use` line begins, and what one
# `/` does to a set of paths.

test "`use` lines are recognized, and everything after the keyword is the tail" {
  fn tail_of(s: String) -> String =
    match use_tail(code_points(s)) {
      Some(t) -> "|" ++ from_code_points(t)
      None -> "-"
    }
  assert tail_of("use ") == "|"
  assert tail_of("  pub use ") == "|"
  assert tail_of("use front/") == "|front/"
  assert tail_of("use front/lexer.{view_of, ") == "|front/lexer.{view_of, "
  # `-` = not a use line: the keyword has to be the line's first word, whole
  assert tail_of("let used = ") == "-"
  assert tail_of("  useful(") == "-"
  assert tail_of("") == "-"
}

test "one `/` steps down one level, and a directory keeps its slash" {
  fn show(items: List[CItem]) -> String =
    join(map(items, it => it.label ++ ":" ++ to_string(it.kind)), " ")
  let paths = ["front/lexer", "front/ast", "front/fmt/rules", "main", "check/types"]
  let none: List[String] = []
  let fresh = Items { out: [], seen: set.empty() }
  # Module=9 for a path that can be imported as it stands, Folder=19 for one
  # that is only a step -- and a directory is offered once however many
  # modules are under it.
  assert show(seg_items(fresh, none, paths, "0").out) == "front/:19 main:9 check/:19"
  assert show(seg_items(fresh, ["front"], paths, "0").out) == "lexer:9 ast:9 fmt/:19"
  assert show(seg_items(fresh, ["front", "fmt"], paths, "0").out) == "rules:9"
  # a prefix that names nothing offers nothing, rather than everything
  assert show(seg_items(fresh, ["nope"], paths, "0").out) == ""
}

test "return-only type completion recognizes function arrows but not match arms" {
  assert return_type_tail(code_points("fn f() -> "))
  assert return_type_tail(code_points("fn f(\n  x: Int\n) -> "))
  assert return_type_tail(code_points("alias F = fn() -> "))
  assert return_type_tail(code_points("type Box = { f: fn(Int) -> "))
  assert not return_type_tail(code_points("match x { _ -> "))
  assert not return_type_tail(code_points("let x: "))
}

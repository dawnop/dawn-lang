entry @foldif_debug(%arg0: tile<ptr<f64>>, %arg1: tile<ptr<f64>>) {
  %0 = make_token : token loc(#loc34)
  %blockId_x, %blockId_y, %blockId_z = get_tile_block_id : tile<i32> loc(#loc35)
  %cst_4_i32 = constant <i32: 4> : tile<i32> loc(#loc36)
  %1 = muli %blockId_x, %cst_4_i32 : tile<i32> loc(#loc37)
  %cst_1_i32 = constant <i32: 1> : tile<i32> loc(#loc38)
  %assume = assume div_by<16>, %arg0 : tile<ptr<f64>> loc(#loc39)
  %tview = make_tensor_view %assume, shape = [1024], strides = [1] : tensor_view<1024xf64, strides=[1]> loc(#loc40)
  %pview = make_partition_view %tview : partition_view<tile=(128), padding_value = zero, tensor_view<1024xf64, strides=[1]>> loc(#loc41)
  %tile, %result_token = load_view_tko weak %pview[%1] token = %0 : partition_view<tile=(128), padding_value = zero, tensor_view<1024xf64, strides=[1]>>, tile<i32> -> tile<128xf64>, token loc(#loc42)
  %2 = addi %1, %cst_1_i32 : tile<i32> loc(#loc43)
  %3 = addi %1, %cst_4_i32 : tile<i32> loc(#loc44)
  %for:3 = for %loopIdx in (%2 to %3, step %cst_1_i32) : tile<i32> iter_values(%iterArg0 = %tile, %iterArg1 = %tile, %iterArg2 = %tile) -> (tile<128xf64>, tile<128xf64>, tile<128xf64>) {
    %tile_6, %result_token_7 = load_view_tko weak %pview[%loopIdx] token = %0 : partition_view<tile=(128), padding_value = zero, tensor_view<1024xf64, strides=[1]>>, tile<i32> -> tile<128xf64>, token loc(#loc46)
    %8 = addf %iterArg0, %tile_6  : tile<128xf64> loc(#loc47)
    %9 = maxf %iterArg1, %tile_6 : tile<128xf64> loc(#loc48)
    %10 = minf %iterArg2, %tile_6 : tile<128xf64> loc(#loc49)
    continue %8, %9, %10 : tile<128xf64>, tile<128xf64>, tile<128xf64> loc(#loc50)
  } loc(#loc45)
  %cst_0_i32 = constant <i32: 0> : tile<i32> loc(#loc51)
  %4 = cmpi equal %blockId_x, %cst_0_i32, signed : tile<i32> -> tile<i1> loc(#loc52)
  %5 = if %4 -> (tile<128xf64>) {
    yield %for#0 : tile<128xf64> loc(#loc54)
  } else {
    %8 = subf %for#1, %for#2  : tile<128xf64> loc(#loc55)
    yield %8 : tile<128xf64> loc(#loc56)
  } loc(#loc53)
  %gridSize_x, %gridSize_y, %gridSize_z = get_num_tile_blocks : tile<i32> loc(#loc57)
  %cst_128_i32 = constant <i32: 128> : tile<i32> loc(#loc58)
  %6 = muli %gridSize_x, %cst_128_i32 : tile<i32> loc(#loc59)
  %assume_0 = assume div_by<16>, %arg1 : tile<ptr<f64>> loc(#loc60)
  %tview_1 = make_tensor_view %assume_0, shape = [%6], strides = [1] : tile<i32> -> tensor_view<?xf64, strides=[1]> loc(#loc61)
  %pview_2 = make_partition_view %tview_1 : partition_view<tile=(128), padding_value = zero, tensor_view<?xf64, strides=[1]>> loc(#loc62)
  %blockId_x_3, %blockId_y_4, %blockId_z_5 = get_tile_block_id : tile<i32> loc(#loc63)
  %7 = store_view_tko weak %5, %pview_2[%blockId_x_3] token = %0 : tile<128xf64>, partition_view<tile=(128), padding_value = zero, tensor_view<?xf64, strides=[1]>>, tile<i32> -> token loc(#loc64)
  return loc(#loc65)
} loc(#loc33)

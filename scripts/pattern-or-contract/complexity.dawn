fn classify(xs: List[Bool]) -> Int =
  match xs {
    [
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false,
      true | false
    ] -> 1
    _ -> 0
  }

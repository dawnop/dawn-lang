# A bare `m.f` on the right of a pipe is a *value* the pipe applies, not a call
# it builds. A module's functions are not bare function values, piped or
# written out, and the diagnostic has to say so rather than turning into an
# arity complaint about a call nobody wrote.
use std/str

pub fn module_member(n: String) -> Bool = n |> str.starts_with

# The Phase -1 seam spike from docs/native-backend-plan.md: a minimal
# TAST -> C emitter for the trivial subset (top-level functions, scalars,
# strings, arithmetic, control flow). Everything else panics with the node
# name, so the covered surface is exactly what the tests exercise.
#
# This is deliberately NOT the eventual emit_c. That one consumes Core IR
# (Phase 0) and handles ADTs, closures, dictionaries and collections. The
# point of this file is to prove three things and then get out of the way:
#
#   1. the codegen seam really is "TModule + tables in, target text out";
#   2. Dawn's expression orientation lowers onto C's statement orientation
#      by the usual emit-into-a-temp trick, with no surprises;
#   3. the toolchain path (emit .c -> cc -> run) works end to end.
#
# Its second job is to be the design probe for Core IR: every node handled
# here is one whose C shape is now known rather than guessed.

use std/str
use std/list
use std/map
use types.{
  Ty, TyInt, TyFloat, TyBool, TyString, TyUnit, TyNever, TyError, Sym, Sig
}
use tast.{
  TExpr, TStmt, TStrPart, TFun, TModule, TBinOp, TUnOp, tex_ty,
  XInt, XFloat, XBool, XUnit, XStr, XLocal, XCallBuiltin, XCallFn,
  XReturn, XBreak, XContinue, XBinary, XUnary, XIf, XBlock, XUnsafePure,
  TSPText, TSPInterp,
  BAdd, BSub, BMul, BDiv, BMod, BConcat, BEq, BNeq, BLt, BLe, BGt, BGe,
  BAnd, BOr, BBand, BBor, BBxor, BShl, BShr, BUshr, UNeg, UNot, UBnot,
  TSLet, TSAssign, TSExpr, TSWhile, TSFor
}

## Emitter state, threaded like the checker's Cx and emit.dawn's Gen.
## `out` is the C text built so far, `tmp` the temporary counter, `ind`
## the current indent, `syms` the module's symbol table (local types).
pub type CSt = { out: String, tmp: Int, ind: Int, syms: Map[Int, Sym] }

fn pad(n: Int) -> String = {
  var s = ""
  var i = 0
  while i < n {
    s = s ++ "  "
    i = i + 1
  }
  s
}

fn line(st: CSt, text: String) -> CSt =
  CSt { ..st, out: st.out ++ pad(st.ind) ++ text ++ "\n" }

fn fresh(st: CSt) -> (CSt, String) =
  (CSt { ..st, tmp: st.tmp + 1 }, "t" ++ to_string(st.tmp))

fn push(st: CSt) -> CSt = CSt { ..st, ind: st.ind + 1 }

fn pop(st: CSt) -> CSt = CSt { ..st, ind: st.ind - 1 }

## Drop a value while keeping its effects. Every place that discards an
## emitted expression must go through here: a C expression that is never
## written down is never evaluated, so silently dropping the string drops
## the call too. (This bit the spike on the first run -- a trailing
## `println` in a Unit-returning function vanished. It is an argument for
## making the statement/expression boundary explicit in Core IR rather
## than leaving each consumer to remember.)
fn discard(st: CSt, v: String) -> CSt =
  if v == "DAWN_UNIT" { st } else { line(st, "(void)(" ++ v ++ ");") }

# ---- names ----

## C identifiers admit only [A-Za-z0-9_], so module paths and any other
## punctuation fold to underscores. Distinct Dawn names can collide after
## folding; the spike accepts that, the real emitter will need a table.
fn sanitize(s: String) -> String = {
  var out = ""
  for cp in code_points(s) {
    let ok =
      (cp >= 97 && cp <= 122) || (cp >= 65 && cp <= 90) ||
      (cp >= 48 && cp <= 57) || cp == 95
    if ok {
      out = out ++ from_code_points([cp])
    } else {
      out = out ++ "_"
    }
  }
  out
}

fn mangle(owner: String, name: String) -> String =
  "dawn_" ++ sanitize(owner) ++ "__" ++ sanitize(name)

## Locals are named by symbol id, not source name: ids are already unique
## per module and cannot collide with C keywords.
fn local_name(sym: Int) -> String = "v" ++ to_string(sym)

# ---- types ----

pub fn c_type(t: Ty) -> String =
  if t == TyInt {
    "int64_t"
  } else if t == TyFloat {
    "double"
  } else if t == TyBool {
    "bool"
  } else if t == TyString {
    "dawn_str"
  } else if t == TyUnit {
    "dawn_unit"
  } else if t == TyNever {
    # a function that only panics still needs a return type in C
    "dawn_unit"
  } else if t == TyError {
    panic("emitc: XError reached codegen")
  } else {
    panic("emitc: unsupported type in the spike subset")
  }

## The zero of a C type, for declaring a temporary before the branches
## that assign it. C requires the declaration to precede the `if`.
fn c_zero(t: Ty) -> String =
  if t == TyInt {
    "0"
  } else if t == TyFloat {
    "0.0"
  } else if t == TyBool {
    "false"
  } else if t == TyString {
    "dawn_str_empty"
  } else {
    "0"
  }

# ---- string literals ----

## C string literal escaping. Dawn strings are UTF-8 already (the source is),
## so bytes above 0x7f pass through as-is inside the literal.
fn c_escape(s: String) -> String = {
  var out = ""
  for cp in code_points(s) {
    if cp == 34 {
      out = out ++ "\\\""
    } else if cp == 92 {
      out = out ++ "\\\\"
    } else if cp == 10 {
      out = out ++ "\\n"
    } else if cp == 13 {
      out = out ++ "\\r"
    } else if cp == 9 {
      out = out ++ "\\t"
    } else if cp < 32 {
      out = out ++ "\\" ++ oct3(cp)
    } else {
      out = out ++ from_code_points([cp])
    }
  }
  out
}

fn oct3(n: Int) -> String =
  to_string((n >>> 6) & 7) ++ to_string((n >>> 3) & 7) ++ to_string(n & 7)

## A `dawn_str` literal: pointer plus byte length, so the runtime never
## calls strlen and embedded NULs would survive.
fn str_lit(s: String) -> String = {
  let bs = bytes_len(bytes_utf8(s))
  "dawn_str_lit(\"" ++ c_escape(s) ++ "\", " ++ to_string(bs) ++ ")"
}

# ---- operators ----

fn bin_op_c(op: TBinOp) -> String =
  match op {
    BAdd -> "+"
    BSub -> "-"
    BMul -> "*"
    BDiv -> "/"
    BMod -> "%"
    BEq -> "=="
    BNeq -> "!="
    BLt -> "<"
    BLe -> "<="
    BGt -> ">"
    BGe -> ">="
    BAnd -> "&&"
    BOr -> "||"
    BBand -> "&"
    BBor -> "|"
    BBxor -> "^"
    BShl -> "<<"
    BShr -> ">>"
    BUshr -> ">>>"
    BConcat -> "++"
  }

# ---- expressions ----

## Emit `e`, appending any statements it needs, and return a C expression
## denoting its value. This is the whole trick that maps an expression
## language onto a statement language, and it is what Core IR will make
## explicit instead of rediscovering per backend.
pub fn emit_expr(st: CSt, e: TExpr) -> (CSt, String) =
  match e {
    XInt(v, _, _) -> (st, "INT64_C(" ++ to_string(v) ++ ")")
    XFloat(v, _, _) -> (st, to_string(v))
    XBool(v, _, _) -> (st, if v { "true" } else { "false" })
    XUnit(_, _) -> (st, "DAWN_UNIT")
    XLocal(sym, _, _, _, _) -> (st, local_name(sym))
    XStr(parts, _, _) -> emit_str(st, parts)
    XUnsafePure(body, _, _, _) -> emit_expr(st, body)
    XBinary(op, l, r, _, _, _, _, _, ty) -> emit_binary(st, op, l, r, ty)
    XUnary(op, operand, _, _, _) -> emit_unary(st, op, operand)
    XIf(cond, thn, els, _, _, ty) -> emit_if(st, cond, thn, els, ty)
    XBlock(stmts, tail, _, _, ty) -> emit_block(st, stmts, tail, ty)
    XCallFn(owner, name, args, wits, trait_id, _, _, ty) -> {
      if len(wits) > 0 {
        panic("emitc: trait witnesses are out of the spike subset (" ++ name ++ ")")
      }
      match trait_id {
        Some(_) -> panic("emitc: trait dispatch is out of the spike subset (" ++ name ++ ")")
        None -> ()
      }
      emit_call(st, owner, name, args, ty)
    }
    XCallBuiltin(name, args, wits, _, _, ty) -> {
      if len(wits) > 0 {
        panic("emitc: builtin witnesses are out of the spike subset (" ++ name ++ ")")
      }
      emit_builtin(st, name, args, ty)
    }
    XReturn(v, _, _) -> {
      match v {
        Some(inner) -> {
          let (st1, cv) = emit_expr(st, inner)
          (line(st1, "return " ++ cv ++ ";"), "DAWN_UNIT")
        }
        None -> (line(st, "return DAWN_UNIT;"), "DAWN_UNIT")
      }
    }
    XBreak(_, _) -> (line(st, "break;"), "DAWN_UNIT")
    XContinue(_, _) -> (line(st, "continue;"), "DAWN_UNIT")
    _ -> panic("emitc: expression out of the spike subset: " ++ node_name(e))
  }

fn emit_str(st: CSt, parts: List[TStrPart]) -> (CSt, String) = {
  # Build left-to-right with the runtime concat. Quadratic for long chains,
  # which is fine for a spike; the real emitter will use a builder.
  var st1 = st
  var acc = ""
  var first = true
  for p in parts {
    let piece =
      match p {
        TSPText(v) -> str_lit(v)
        TSPInterp(ie) -> {
          let (st2, cv) = emit_expr(st1, ie)
          st1 = st2
          let at = tex_ty(ie)
          if at == TyString {
            cv
          } else if at == TyInt {
            "dawn_str_of_int(" ++ cv ++ ")"
          } else if at == TyFloat {
            "dawn_str_of_float(" ++ cv ++ ")"
          } else if at == TyBool {
            "dawn_str_of_bool(" ++ cv ++ ")"
          } else {
            panic("emitc: interpolating a non-scalar is out of the spike subset")
          }
        }
      }
    if first {
      acc = piece
      first = false
    } else {
      acc = "dawn_str_concat(" ++ acc ++ ", " ++ piece ++ ")"
    }
  }
  if first {
    (st1, "dawn_str_empty")
  } else {
    (st1, acc)
  }
}

fn emit_binary(st: CSt, op: TBinOp, l: TExpr, r: TExpr, ty: Ty) -> (CSt, String) = {
  let lt = tex_ty(l)
  # && and || must not evaluate the right side eagerly, and the right side
  # may emit statements -- so they lower to an if, not to C's && operator.
  if op == BAnd || op == BOr {
    let (st1, lv) = emit_expr(st, l)
    let (st2, tmp) = fresh(st1)
    let st3 = line(st2, "bool " ++ tmp ++ " = " ++ lv ++ ";")
    let guard = if op == BAnd { tmp } else { "!" ++ tmp }
    let st4 = push(line(st3, "if (" ++ guard ++ ") {"))
    let (st5, rv) = emit_expr(st4, r)
    let st6 = pop(line(st5, tmp ++ " = " ++ rv ++ ";"))
    (line(st6, "}"), tmp)
  } else if op == BConcat {
    let (st1, lv) = emit_expr(st, l)
    let (st2, rv) = emit_expr(st1, r)
    if lt == TyString {
      (st2, "dawn_str_concat(" ++ lv ++ ", " ++ rv ++ ")")
    } else {
      panic("emitc: ++ on non-strings is out of the spike subset")
    }
  } else if (op == BEq || op == BNeq) && lt == TyString {
    let (st1, lv) = emit_expr(st, l)
    let (st2, rv) = emit_expr(st1, r)
    let call = "dawn_str_eq(" ++ lv ++ ", " ++ rv ++ ")"
    (st2, if op == BEq { call } else { "(!" ++ call ++ ")" })
  } else if op == BUshr {
    let (st1, lv) = emit_expr(st, l)
    let (st2, rv) = emit_expr(st1, r)
    # C has no >>> ; on int64 it is a cast to unsigned, shift, cast back
    (st2, "((int64_t)((uint64_t)(" ++ lv ++ ") >> (" ++ rv ++ ")))")
  } else if op == BDiv && ty == TyInt {
    let (st1, lv) = emit_expr(st, l)
    let (st2, rv) = emit_expr(st1, r)
    # matches the JVM: division by zero traps rather than being UB
    (st2, "dawn_idiv(" ++ lv ++ ", " ++ rv ++ ")")
  } else if op == BMod && ty == TyInt {
    let (st1, lv) = emit_expr(st, l)
    let (st2, rv) = emit_expr(st1, r)
    (st2, "dawn_imod(" ++ lv ++ ", " ++ rv ++ ")")
  } else {
    let (st1, lv) = emit_expr(st, l)
    let (st2, rv) = emit_expr(st1, r)
    (st2, "(" ++ lv ++ " " ++ bin_op_c(op) ++ " " ++ rv ++ ")")
  }
}

fn emit_unary(st: CSt, op: TUnOp, operand: TExpr) -> (CSt, String) = {
  let (st1, v) = emit_expr(st, operand)
  match op {
    UNeg -> (st1, "(-(" ++ v ++ "))")
    UNot -> (st1, "(!(" ++ v ++ "))")
    UBnot -> (st1, "(~(" ++ v ++ "))")
  }
}

fn emit_if(st: CSt, cond: TExpr, thn: TExpr, els: Option[TExpr], ty: Ty) -> (CSt, String) = {
  let (st1, cv) = emit_expr(st, cond)
  let is_value = ty != TyUnit && ty != TyNever
  let (st2, tmp) = fresh(st1)
  let st3 =
    if is_value {
      line(st2, c_type(ty) ++ " " ++ tmp ++ " = " ++ c_zero(ty) ++ ";")
    } else {
      st2
    }
  let st4 = push(line(st3, "if (" ++ cv ++ ") {"))
  let (st5, tv) = emit_expr(st4, thn)
  let st6 = if is_value { line(st5, tmp ++ " = " ++ tv ++ ";") } else { discard(st5, tv) }
  let st7 = pop(st6)
  let st8 =
    match els {
      Some(ee) -> {
        let sa = push(line(st7, "} else {"))
        let (sb, ev) = emit_expr(sa, ee)
        let sc = if is_value { line(sb, tmp ++ " = " ++ ev ++ ";") } else { discard(sb, ev) }
        line(pop(sc), "}")
      }
      None -> line(st7, "}")
    }
  (st8, if is_value { tmp } else { "DAWN_UNIT" })
}

fn emit_block(st: CSt, stmts: List[TStmt], tail: Option[TExpr], ty: Ty) -> (CSt, String) = {
  var st1 = st
  for s in stmts {
    st1 = emit_stmt(st1, s)
  }
  match tail {
    Some(t) -> emit_expr(st1, t)
    None -> (st1, "DAWN_UNIT")
  }
}

fn emit_call(st: CSt, owner: Option[String], name: String, args: List[TExpr], ty: Ty) -> (CSt, String) = {
  var st1 = st
  var cargs: List[String] = []
  for a in args {
    let (st2, v) = emit_expr(st1, a)
    st1 = st2
    cargs = cargs ++ [v]
  }
  match owner {
    Some(o) ->
      match std_shim(o, name) {
        Some(rt) -> (st1, rt ++ "(" ++ join(cargs, ", ") ++ ")")
        None -> (st1, mangle(o, name) ++ "(" ++ join(cargs, ", ") ++ ")")
      }
    None -> (st1, mangle("", name) ++ "(" ++ join(cargs, ", ") ++ ")")
  }
}

## The few std functions the spike needs, mapped straight onto runtime C.
## In the real backend std is compiled to C like any other Dawn module;
## this table exists only so the spike need not compile all of std.
fn std_shim(owner: String, name: String) -> Option[String] =
  if owner == "std/io" && name == "println" {
    Some("dawn_println")
  } else if owner == "std/io" && name == "print" {
    Some("dawn_print")
  } else {
    None
  }

fn emit_builtin(st: CSt, name: String, args: List[TExpr], ty: Ty) -> (CSt, String) = {
  var st1 = st
  var cargs: List[String] = []
  for a in args {
    let (st2, v) = emit_expr(st1, a)
    st1 = st2
    cargs = cargs ++ [v]
  }
  let a0 = if len(cargs) > 0 { cargs[0] } else { "" }
  if name == "io_println" {
    (st1, "dawn_println(" ++ a0 ++ ")")
  } else if name == "io_print" {
    (st1, "dawn_print(" ++ a0 ++ ")")
  } else if name == "panic" {
    (line(st1, "dawn_panic(" ++ a0 ++ ");"), "DAWN_UNIT")
  } else if name == "todo" {
    (line(st1, "dawn_panic(" ++ str_lit("not yet implemented") ++ ");"), "DAWN_UNIT")
  } else if name == "to_string" {
    let at = tex_ty(args[0])
    if at == TyInt {
      (st1, "dawn_str_of_int(" ++ a0 ++ ")")
    } else if at == TyFloat {
      (st1, "dawn_str_of_float(" ++ a0 ++ ")")
    } else if at == TyBool {
      (st1, "dawn_str_of_bool(" ++ a0 ++ ")")
    } else if at == TyString {
      (st1, a0)
    } else {
      panic("emitc: to_string on a non-scalar is out of the spike subset")
    }
  } else if name == "to_float" {
    (st1, "((double)(" ++ a0 ++ "))")
  } else if name == "to_int" {
    (st1, "((int64_t)(" ++ a0 ++ "))")
  } else if name == "str_len" {
    (st1, "dawn_str_len(" ++ a0 ++ ")")
  } else {
    panic("emitc: builtin out of the spike subset: " ++ name)
  }
}

# ---- statements ----

pub fn emit_stmt(st: CSt, s: TStmt) -> CSt =
  match s {
    TSLet(sym, name, init, _, _) -> {
      let (st1, v) = emit_expr(st, init)
      match sym {
        Some(sy) -> {
          let t = c_type(tex_ty(init))
          line(st1, t ++ " " ++ local_name(sy) ++ " = " ++ v ++ ";")
        }
        # `let _ = e`: keep the effect, drop the value
        None -> line(st1, "(void)(" ++ v ++ ");")
      }
    }
    TSAssign(sym, _, value, _, _) -> {
      let (st1, v) = emit_expr(st, value)
      line(st1, local_name(sym) ++ " = " ++ v ++ ";")
    }
    TSExpr(e, _, _) -> {
      let (st1, v) = emit_expr(st, e)
      discard(st1, v)
    }
    TSWhile(cond, body, _, _, _) -> {
      # The condition may emit statements, so it is re-emitted inside an
      # infinite loop with a break, rather than placed in the for-header.
      let st1 = push(line(st, "for (;;) {"))
      let (st2, cv) = emit_expr(st1, cond)
      let st3 = line(st2, "if (!(" ++ cv ++ ")) break;")
      let (st4, bv) = emit_expr(st3, body)
      line(pop(discard(st4, bv)), "}")
    }
    TSFor(sym, _, from, to, body, _, _, _) -> {
      match to {
        Some(hi) -> {
          let (st1, lo_v) = emit_expr(st, from)
          let (st2, hi_v) = emit_expr(st1, hi)
          let (st3, bound) = fresh(st2)
          let st4 = line(st3, "const int64_t " ++ bound ++ " = " ++ hi_v ++ ";")
          let iv = local_name(sym)
          let st5 = push(line(st4,
            "for (int64_t " ++ iv ++ " = " ++ lo_v ++ "; " ++ iv ++ " < " ++ bound ++ "; " ++ iv ++ "++) {"))
          let (st6, bv) = emit_expr(st5, body)
          line(pop(discard(st6, bv)), "}")
        }
        None -> panic("emitc: for-in over a collection is out of the spike subset")
      }
    }
    _ -> panic("emitc: statement out of the spike subset")
  }

# ---- functions and program ----

fn fn_signature(owner: String, f: TFun) -> String = {
  var ps: List[String] = []
  var i = 0
  for pt in f.sig.param_tys {
    ps = ps ++ [c_type(pt) ++ " " ++ local_name(f.param_syms[i])]
    i = i + 1
  }
  let plist = if len(ps) == 0 { "void" } else { join(ps, ", ") }
  c_type(f.sig.ret) ++ " " ++ mangle(owner, f.name) ++ "(" ++ plist ++ ")"
}

fn emit_fn(st: CSt, owner: String, f: TFun) -> CSt = {
  if len(f.dict_syms) > 0 {
    panic("emitc: dictionary parameters are out of the spike subset (" ++ f.name ++ ")")
  }
  let st1 = push(line(CSt { ..st, tmp: 0 }, fn_signature(owner, f) ++ " {"))
  let (st2, v) = emit_expr(st1, f.body)
  let st3 =
    if f.sig.ret == TyUnit {
      line(discard(st2, v), "return DAWN_UNIT;")
    } else if tex_ty(f.body) == TyNever {
      # the body already returned or panicked; C still wants a terminator
      line(st2, "return " ++ c_zero(f.sig.ret) ++ ";")
    } else {
      line(st2, "return " ++ v ++ ";")
    }
  line(pop(st3), "}")
}

## Emit one whole program: forward declarations first (Dawn has no ordering
## requirement between top-level functions, C does), then the bodies, then
## a C `main` that calls the entry point.
pub fn emit_program(mods: List[(String, TModule)], entry: String) -> String = {
  var st = CSt { out: "", tmp: 0, ind: 0, syms: map.empty() }
  st = line(st, "/* generated by dawn __emitc -- the Phase -1 native seam spike */")
  st = line(st, "#include \"dawn_rt.h\"")
  st = line(st, "")

  for m in mods {
    let (owner, tm) = m
    for f in tm.fns {
      st = line(st, fn_signature(owner, f) ++ ";")
    }
  }
  st = line(st, "")

  for m in mods {
    let (owner, tm) = m
    if len(tm.consts) > 0 {
      panic("emitc: comptime consts are out of the spike subset")
    }
    st = CSt { ..st, syms: tm.syms }
    for f in tm.fns {
      st = emit_fn(st, owner, f)
      st = line(st, "")
    }
  }

  st = line(st, "int main(int argc, char** argv) {")
  st = push(st)
  st = line(st, "dawn_rt_init(argc, argv);")
  st = line(st, "(void)" ++ mangle(entry, "main") ++ "();")
  st = line(st, "return 0;")
  st = pop(st)
  st = line(st, "}")
  st.out
}

# ---- diagnostics ----

fn node_name(e: TExpr) -> String =
  match e {
    XInt(_, _, _) -> "XInt"
    XFloat(_, _, _) -> "XFloat"
    XBool(_, _, _) -> "XBool"
    XUnit(_, _) -> "XUnit"
    XStr(_, _, _) -> "XStr"
    XLocal(_, _, _, _, _) -> "XLocal"
    XCallBuiltin(_, _, _, _, _, _) -> "XCallBuiltin"
    XCallFn(_, _, _, _, _, _, _, _) -> "XCallFn"
    XReturn(_, _, _) -> "XReturn"
    XBreak(_, _) -> "XBreak"
    XContinue(_, _) -> "XContinue"
    XBinary(_, _, _, _, _, _, _, _, _) -> "XBinary"
    XUnary(_, _, _, _, _) -> "XUnary"
    XIf(_, _, _, _, _, _) -> "XIf"
    XBlock(_, _, _, _, _) -> "XBlock"
    XUnsafePure(_, _, _, _) -> "XUnsafePure"
    _ -> "some other node"
  }

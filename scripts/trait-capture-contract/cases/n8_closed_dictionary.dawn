# Ordinary environments and delivered type support have separate contracts.
# A closed dictionary is the positive control for the N8 witness restriction.
trait Empty[T: ^{c}, ^c] { fn empty_value() -> T }
impl Empty[Int, ^{}] { fn empty_value() -> Int = 0 }
fn factory[T: Empty[c] + ^{c}, ^c](tag: T) -> (fn() -> Int ^{c}) = {
  let make: fn() -> T ^{c} = empty_value
  () => { let _value = make()
    0 }
}
pub fn main() -> Unit !io = {
  let f = factory(0)
  println(to_string(f()))
}

-- bare Bytes: the one place content equality was written --
utf8 == utf8    : yes
utf8 == concat  : yes
utf8 == slice   : yes
utf8 == other   : no
utf8 != other   : yes
-- in a constructor --
Wrap(a) == Wrap(b): yes
Wrap(a) == Wrap(c): yes
Wrap(a) == Wrap(o): no
-- in a record, and in a record inside a record --
Blob == Blob      : yes
Blob == Blob (diff): no
Nested == Nested  : yes
-- in Option and in a tuple --
Some(a) == Some(b): yes
Some(a) == None   : no
(a,1) == (b,1)    : yes
(a,1) == (b,2)    : no
-- empty and length-sensitive --
empty == empty  : yes
Wrap(e) == Wrap(e): yes
hi == h         : no

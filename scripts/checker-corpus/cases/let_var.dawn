# checker.dawn: let / var / assignment
pub type Pair = P(a: Int, b: Int)

pub fn annotated() -> Int = {
  let x: Int = "a"
  1
}

pub fn refutable(p: Pair) -> Int = {
  let P(a: 1, b: q) = p
  q
}

pub fn assign_let() -> Int = {
  let x = 1
  x = 2
  x
}

pub fn assign_type() -> Int = {
  var x = 1
  x = "a"
  x
}

pub fn assign_undefined() -> Int = {
  nope = 1
  1
}

pub fn undefined_read() -> Int = nope2

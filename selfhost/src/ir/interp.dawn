# Compile-time evaluation (spec §7): a tree walker over Core IR's pure subset.
# Top-level const initializers and comptime blocks run here after checking;
# codegen embeds the results.
#
# It consumes Core rather than TAST on purpose. A comptime interpreter that
# walks the source tree is a second definition of the language: it has to
# decide what `match` means, what `?` returns, how `for` iterates, when a
# value is boxed -- and nothing forces those decisions to agree with the
# backends'. Reading the same IR the backends read makes the agreement
# structural instead of a promise. Note what is not in this file any more:
# no pattern matcher, no `for`/`while`, no `?`/`!`, no interpolation.
#
# Control flow: ER = Result[(ESt, Env, CValue), (ESt, Env, Ctl)] -- `?` is
# throw, a call catches KReturn, a loop catches KBreak/KContinue naming it.
# The state carries fuel (the real bound on runaway evaluation) and the call
# depth (turns a would-be stack overflow into a decent message). Both start
# over for every folded expression. What lowering produced does not: the
# `LowerCache` is built once per module and handed from one const or comptime
# block to the next, so a helper ten consts call is lowered once.
#
# Core still carries no precise source positions. Interpreter failures stay
# structured until the fold boundary, though: the original actionable hint
# is separate from a bounded call chain, and only that boundary chooses the
# enclosing const/comptime span and constructs a public diagnostic.
#
# The Kotlin interpreter ran on a dedicated 64MB thread; this one recurses on
# the host stack, so the selfhost JVM is launched with -Xss512m instead.

use std/char
use std/str
use std/fmt
use std/list
use std/map
use std/set
use front/token.{Diag, mk_diag}
use check/tast.{
  TExpr, TStmt, TFun, TModule,
  XStr, XLambda, XApply, XJava, XPropagate, XUnwrap, XReturn, XIndex,
  XCallDyn, XCallBuiltin, XCallFn, XCtor, XField, XListLit, XTupleLit,
  TLEExpr, TLESpread, TLEIf,
  XBinary, XUnary, XIf, XMatch, XBlock, XComptime,
  XError, XInt, XFloat,
  TSPText, TSPInterp,
  TSLet, TSLetPat, TSLocalFn, TSAssign, TSExpr, TSAssert, TSWhile, TSFor
}
use check/types.{
  Ty, TyUnit, Sym, Sig, Traits, Impls, Adts, adt_of,
  intrinsics, Intr, OPTION_ID, EPure, TyList, TyMap, TySet, TyArray, TyTuple,
  EV_PACK_ID, EV_MISS_MSG, FROM_INT_ID, FROM_FLOAT_ID, ty_show
}
use ir/core.{
  CValue, VInt, VFloat, VBool, VStr, VUnit, VList, VTuple, VAdt,
  VClosure, VDict, VCursor,
  CExpr, CStmt, CFun, CDictDef, CSlotFn, CSlotDefault, ty_key, ty_key_inst,
  CInt, CFloat, CBool, CStr, CUnit, CLocal, CFnRef, CCall, CIntrinsic,
  CCtor, CField, CIsCtor, CTagOf, CClosure, CTuple, CTupleGet, CBox, CUnbox,
  CBinary, CUnary, CIf, CBlock, CListLit, CConstRef, CComptime, CUpdate, update_values,
  CReturn, CBreak, CContinue, CForeign, CDup, CReset, CReuse, CDictRef, CDictApply, CDictArg, CJava,
  CSLet, CSAssign, CSDiscard, CSLoop, CSIf, CSDrop,
  CCallee, CUpdField, CUnOp, CDirect, CDynamic, CMethod, CImpl, CDefault,
  CAdd, CSub, CMul, CDiv, CMod, CEq, CNe, CLt, CLe, CGt, CAnd, COr,
  CBand, CBor, CBxor, CShl, CShr, CUshr, CConcat, CNeg, CNot, CBnot,
  CBinOp
}
use ir/lower
use check/cx.{cx_new}

type CtFrame =
  | FDirect(owner: String, name: String)
  | FDynamic(owner: String, name: String)
  | FImpl(owner: String, trait_name: String, trait_id: Int, subject: String, method: String)
  | FDefault(owner: String, trait_name: String, trait_id: Int, method: String)

type CtOrigin = { lo: Int, hi: Int }

type CtFailure = {
  msg: String,
  hint: String,
  # nearest failure frame first; outer frames are the ones discarded at cap
  frames: List[CtFrame],
  truncated: Bool,
  # Core cannot fill this yet. The fold boundary records its enclosing span.
  origin: Option[CtOrigin]
}

type Ctl =
  | KErr(failure: CtFailure)
  | KReturn(v: CValue)
# break and continue name their loop: lowering turns a `match` into a
# once-loop, so a `break` inside an arm leaves a loop that is not the
# innermost one.
  | KBreak(loop_id: Int)
  | KContinue(loop_id: Int)

## What lowering has produced for this module so far. It is separate from
## `ESt` because it outlives the expression being folded: lowering reads the
## module's trait, impl, adt, signature and symbol tables, and those are fixed
## for the whole run, so the body it produces for a function does not depend
## on which const or comptime block asked for it. Ten consts calling one
## helper therefore lower that helper once.
##
## `next_lam` belongs here for the same reason and must not restart per
## expression. Lifted lambdas are keyed by their generated name (`lambda$0`,
## `lambda$1`, ...) in the very table above them; a counter that restarted
## would let the second expression's `lambda$0` land on the first's entry.
pub(pkg) type LowerCache = {
  # bodies lowered so far, keyed "owner.name" -- including the lambdas
  # lowering lifted out of them. Lowering happens on demand because one
  # comptime run touches a handful of functions out of the whole program.
  fns: Map[String, CFun],
  # the dictionaries lowering registered while lowering those bodies, by key:
  # what `CMethod` looks a slot up in
  dicts: Map[String, CDictDef],
  # seeds the lifted-lambda counter so names stay unique across the module
  next_lam: Int,
  # the other modules (by path) whose bodies or constants the run read, and
  # whether a lookup into another module found nothing. Kept beside the
  # bodies because it accumulates exactly as they do: once per module run.
  reads: Set[String],
  missed: Bool,
  # Folded literals by trait, instantiated type and value
  # (docs/literal-system-design.md D9). A module of byte-sized constants
  # repeats a few hundred values, and each fold is a lowering and an
  # interpretation (about 70 us measured at L0); a failed fold is not kept,
  # so every literal out of range is reported where it is.
  lits: Map[String, CValue]
}

## One expression's evaluation. Fuel and depth are the per-evaluation half and
## start over for every fold; the cache is the module-level half and is handed
## on to the next one.
type ESt = {
  fuel: Int,
  depth: Int,
  cache: LowerCache,
  texts: Texts
}

## The strings a fold has taken a cursor on, each decoded to code points once.
##
## A cursor names its string by number (`VCursor.text`) and indexes that
## string's code points, so a step is a list read rather than a decode of the
## whole string: the cursor arms used to call `code_points(s)` or `str.len(s)`
## on every step, which made a walk over a string quadratic while the fuel
## counted it as linear (20,000 characters took 20 s to `str.index_of`).
##
## `last` is the string the latest cursor was taken on, so a walk that keeps
## starting over on one string finds it without hashing it again. A string is
## added once per fold and pays its length in fuel when it is, which is the
## decode it costs.
type Texts = {
  ids: Map[String, Int],
  strs: List[String],
  cps: List[List[Char]],
  last: Int
}

fn no_texts() -> Texts = {
  let ids: Map[String, Int] = map.empty()
  Texts { ids: ids, strs: [], cps: [], last: -1 }
}

alias Env = Map[Int, CValue]

alias ER = Result[(ESt, Env, CValue), (ESt, Env, Ctl)]

alias SR = Result[(ESt, Env), (ESt, Env, Ctl)]

## How much a comptime run may do: `fuel` bounds the steps, `depth` the nested
## calls. There is no host-call flag since the compile-time Java route went
## with `unsafe_pure` (docs/effects-window-design.md 6): a `use java` call is
## `!io`, a const or comptime block is pure, and no source can put the one
## inside the other, so there is no host call left for a flag to grant.
##
## `depth` is a field rather than a constant because a caller may ask for less
## than the compiler's own limit: an editor folding one expression takes
## `ct_hover`. The compilers themselves take `ct_default`, the JVM and the
## native one alike, so one program gets one answer from both (see
## MAX_CALL_DEPTH).
pub type CtOpts = { fuel: Int, depth: Int }

pub const DEFAULT_FUEL: Int = 100000000

## Defaults: all the fuel and all the depth a real compile gets, on either
## compiler.
pub fn ct_default() -> CtOpts = CtOpts { fuel: DEFAULT_FUEL, depth: MAX_CALL_DEPTH }

## Defaults with the fuel dialled down (the fuel tests, and callers that want
## a comptime run bounded well below a real compile's).
pub fn ct_fuel(n: Int) -> CtOpts = CtOpts { ..ct_default(), fuel: n }

## The value of `--comptime-fuel`: a step count, so a number and not a
## negative one. A negative budget used to be taken as given, and every
## constant then reported running out of fuel, which is no way to say that
## the flag was wrong.
pub fn ct_fuel_value(text: String) -> Result[Int, String] =
  match parse_int(text) {
    Some(n) -> if n < 0 { Err("--comptime-fuel needs a number, 0 or more") } else { Ok(n) }
    None -> Err("--comptime-fuel needs a number")
  }

## `--comptime-fuel N` and `--comptime-fuel=N`, wherever they sit in `rest`:
## the budget asked for, if any, and the arguments without the flag. Both
## drivers take the flag through here for every command that folds constants,
## because the fuel-exhausted hint names the flag and has to be right whichever
## command printed it; `dawn check` and every dawnc command used to leave the
## flag in place and then read it as a file name.
pub fn take_ct_fuel(rest: List[String]) -> Result[(Option[Int], List[String]), String] = {
  var fuel: Option[Int] = None
  var out: List[String] = []
  var i = 0
  while i < len(rest) {
    let a = rest[i]
    if a == "--comptime-fuel" {
      if i + 1 >= len(rest) { return Err("--comptime-fuel needs a number") }
      fuel = Some(ct_fuel_value(rest[i + 1])?)
      i = i + 2
    } else if str.starts_with(a, "--comptime-fuel=") {
      fuel = Some(ct_fuel_value(str.strip_prefix(a, "--comptime-fuel=").unwrap_or(a))?)
      i = i + 1
    } else {
      out = out ++ [a]
      i = i + 1
    }
  }
  Ok((fuel, out))
}

## What an editor may spend folding one expression it was pointed at
## (docs/lsp-hover-design.md, C5): far below a build's budget, because the
## answer is wanted while the user waits and a refusal costs nothing. Both
## numbers are the same on the JVM and native compilers, so the same code
## shows the same value in VS Code and in the Playground.
##
## They live here rather than in lsp/ because the depth is a claim about the
## interpreter's host stack, not about editors: it may not exceed
## MAX_CALL_DEPTH, and it is this module that knows what the stack holds.
## lsp/ imports from here already (`ct_default`); a constant there would put
## the number one layer away from the limit it answers to. Every editor
## caller (hover now, the default-argument inlay later) takes them through
## `ct_hover`.
##
## 10^5 steps: on the 996 hover points of the examples corpus it shows one
## value fewer than 10^6, and its worst case is about 15 ms hot on the JVM and
## 40 ms on native, where 10^6 costs 360 ms.
pub(pkg) const HOVER_FUEL: Int = 100000

## 1,500 nested calls: the native compiler's limit when this was set. The
## limit is MAX_CALL_DEPTH on both compilers now, but an editor's fold runs in
## a language server session with a memory cap, and 1,500 calls of the
## heaviest measured shape stay near 70 MB where the full limit costs several
## times that (docs/audit/ceval-trampoline-verdict.md 5.2).
pub(pkg) const HOVER_DEPTH: Int = 1500

## The editor budget on a given host. The depth also stays under the host's
## own, should a host ever pass a smaller one.
pub(pkg) fn ct_hover(host: CtOpts) -> CtOpts =
  CtOpts { fuel: HOVER_FUEL, depth: if host.depth < HOVER_DEPTH { host.depth } else { HOVER_DEPTH } }

## 5,000 nested calls: what a language server's own analysis (the comptime
## behind its diagnostics) may reach, below MAX_CALL_DEPTH because a
## Playground session runs under MemoryMax=256M and a build does not. Measured
## 2026-10-04 on the native server (docs/audit/ceval-trampoline-verdict.md
## 5.2): the heaviest stack shape stays near 207 MB at the full 11,000, but a
## recursion that holds a list per level (`match xs { [h, ..t] -> ...` over a
## range) is 254 MB at 4,999 and is killed at 10,990. This bounds what depth
## alone costs, not what a session may allocate: a const can exhaust the cap
## at any depth, and then the cgroup ends that one session.
pub(pkg) const LSP_DEPTH: Int = 5000

## The budget behind a language server's diagnostics, on either compiler: a
## build's fuel, the smaller depth. Both servers take it, so VS Code and the
## Playground refuse the same program; between 5,000 and MAX_CALL_DEPTH that
## is a program `check` folds.
pub(pkg) fn ct_lsp() -> CtOpts = CtOpts { ..ct_default(), depth: LSP_DEPTH }

## The interpreter's static context: how to find a function body, the tables
## lowering needs, and the results already folded.
pub(pkg) type ICx = {
  # flat name → direct typed fn (module fns over std fns; local shadows std)
  fns: Map[String, TFun],
  # owner → (name → direct typed fn): qualified calls resolve by owner
  by_owner: Map[String, Map[String, TFun]],
  # flat name → the owner it was found under, so a function lowered on
  # demand resolves its own module's calls first
  owner_of: Map[String, String],
  std_names: Set[String],
  adts: Adts,
  consts: Map[String, CValue],
  # comptime block results by span: a block nested in the expression being
  # folded is itself folded first, and lowering leaves behind a reference
  blocks: Map[(Int, Int), CValue],
  # the module being folded, and the tables lowering needs from it
  owner: String,
  traits: Traits,
  impls: Impls,
  # Every CDirect signature lowering may consult, keyed by resolved owner.
  # CImpl/CDefault signatures come from `traits`/`impls`, not this lossy key.
  prog_fns: Map[(String, String), Sig],
  # Every impl method and trait default in the program, by the identity a
  # `CImpl`/`CDefault` node carries. A flat table is not a shortcut: coherence
  # means one impl per (trait, head) program-wide, so the key is unique --
  # which `by_owner` is not, since two impls in one module can both define
  # `eq`.
  impl_fns: Map[(Int, String, String), (String, TFun)],
  syms: Map[Int, Sym],
  # the modules analyzed before this one, and how the folding module itself
  # names constants
  world: CtWorld,
  scope: ConstScope,
  # the owner of the body being evaluated: `owner` until a call crosses into
  # another module, whose constants its body then names
  body: String,
  # how many calls may nest (CtOpts.depth)
  max_depth: Int,
  # The folding module's constants not reached yet, and the one being folded
  # ("" outside a module's constant run). A body that reads one of them
  # finds nothing, and these are what let the refusal say why rather than
  # call a constant that has not run yet one that failed.
  pending: Set[String],
  folding: String,
  # the intrinsic table every lowering reads (`types.intrinsics()`), built
  # once per context rather than once per function lowered
  intrs: Map[String, Intr]
}

## How a body names constants: the module it belongs to (`path`, the key
## `CtWorld.consts` files that module's values under) and the selective
## imports it wrote. A qualified reference (`m.MAX`) carries the declaring
## module's path and needs neither table. The same resolution as the
## emitters' (`cdriver.merged_consts`), done per lookup instead of as one
## merged table, because a comptime run moves between modules' bodies.
pub type ConstScope = {
  path: String,
  # local name → the module path it was imported from
  imported: Map[String, String],
  # local name → declared name, for each `Name as Local`
  renames: Map[String, String]
}

## What one module's comptime can reach beyond its own declarations and the
## std function tables: the modules analyzed before it (spec §7.2 item 1,
## "including dependency modules"). Bodies are filed by owner, the name Core
## calls them by; constants by module path, the name a `CConstRef` carries.
## std's bodies stay in their own tables (`by_owner`, `std_fns`), so only
## their scopes and constants are here.
pub type CtWorld = {
  # owner → direct functions, as `by_owner` holds std's
  owners: Map[String, Map[String, TFun]],
  # impl methods and trait defaults, by the identity Core names them with
  impl_fns: Map[(Int, String, String), (String, TFun)],
  # every direct signature lowering may consult, std's included: what
  # `program_sigs` would build from all of the above, kept as it grows
  # rather than rebuilt for each module
  sigs: Map[(String, String), Sig],
  # owner → the symbol table its bodies were checked against
  syms: Map[String, Map[Int, Sym]],
  # owner → how its bodies name constants
  scopes: Map[String, ConstScope],
  # module path → its folded constants
  consts: Map[String, Map[String, CValue]]
}

pub fn ct_world_empty() -> CtWorld = {
  let no_owners: Map[String, Map[String, TFun]] = map.empty()
  let no_syms: Map[String, Map[Int, Sym]] = map.empty()
  let no_scopes: Map[String, ConstScope] = map.empty()
  let no_consts: Map[String, Map[String, CValue]] = map.empty()
  let no_sigs: Map[(String, String), Sig] = map.empty()
  CtWorld { owners: no_owners, impl_fns: no_impls(), sigs: no_sigs, syms: no_syms,
    scopes: no_scopes, consts: no_consts }
}

## A module joins the world once it has folded. `bodies` is false for a std
## module, whose functions the std tables already hold.
pub fn ct_world_add(
  w: CtWorld,
  owner: String,
  scope: ConstScope,
  tm: TModule,
  consts: Map[String, CValue],
  bodies: Bool
) -> CtWorld = {
  var sigs = w.sigs
  for f in tm.fns {
    if is_direct_fn(f) { sigs = map.insert(sigs, (owner, f.name), f.sig) }
  }
  var out = CtWorld { ..w,
    sigs: sigs,
    scopes: map.insert(w.scopes, owner, scope),
    consts: map.insert(w.consts, scope.path, consts) }
  if bodies {
    var own: Map[String, TFun] = map.empty()
    var impl_fns = w.impl_fns
    for f in tm.fns {
      own = note_direct_fn(own, f)
      impl_fns = note_trait_fn(impl_fns, owner, f)
    }
    out = CtWorld { ..out,
      owners: map.insert(w.owners, owner, own),
      impl_fns: impl_fns,
      syms: map.insert(w.syms, owner, tm.syms) }
  }
  out
}

# A deliberate constant, not a value derived from the stack. Do not make it
# dynamic: the measured depth-per-stack is JIT-dependent on the JVM and
# shape-dependent everywhere, and a limit you only learn by running is worse
# than an honest constant.
#
# One limit for both compilers, so `dawn check` and `dawnc check` give one
# program one answer, and the native compiler sets it. Both stacks are
# 512 MiB: the JVM compiler runs on -Xss512m, and every native subcommand runs
# inside io's `Exit` handler, a `ctl` handler, so the whole native compiler
# runs on a continuation carrier of DAWN_CTL_STACK_BYTES (runtime/c/dawn_rt.c),
# which is the same number. The native frames are the bigger ones. Measured 2026-10-04 with the counter
# out of the way (docs/audit/ceval-trampoline-verdict.md 5.2), the deepest
# comptime recursion that folds before the host stack runs out:
#
#   shape (per level)               native     JVM
#   `1 + f(n - 1)`                  79,765     291,786
#   through a closure               46,259     320,937
#   a block, a `let` and a `match`  41,171     247,089
#
# 11,000 is the heaviest native figure over 3.5, rounded down to a thousand,
# so the counter, not the stack, is what stops the run on either compiler.
# It was 100,000 on the JVM and 1,500 on native until then; deep recursion
# was never part of what comptime promises (the diagnostic's hint is "use a
# loop or fold").
const MAX_CALL_DEPTH: Int = 11000

const MAX_FAILURE_FRAMES: Int = 16

fn no_impls() -> Map[(Int, String, String), (String, TFun)] = map.empty()

fn ct_failure(msg: String, hint: String) -> CtFailure =
  CtFailure { msg: msg, hint: hint, frames: [], truncated: false, origin: None }

fn cerr(st: ESt, env: Env, msg: String) -> ER =
  Err((st, env, KErr(ct_failure(msg, ""))))

fn cerrh(st: ESt, env: Env, msg: String, hint: String) -> ER =
  Err((st, env, KErr(ct_failure(msg, hint))))

fn push_failure_frame(failure: CtFailure, frame: CtFrame) -> CtFailure =
  if len(failure.frames) < MAX_FAILURE_FRAMES {
    CtFailure { ..failure, frames: failure.frames ++ [frame] }
  } else {
    CtFailure { ..failure, truncated: true }
  }

fn frame_error(
  err: (ESt, Env, Ctl),
  frame: CtFrame
) -> (ESt, Env, Ctl) = {
  let (st, env, ctl) = err
  match ctl {
    KErr(failure) -> (st, env, KErr(push_failure_frame(failure, frame)))
    _ -> err
  }
}

fn framed(result: ER, frame: CtFrame) -> ER =
  match result {
    Ok(value) -> Ok(value)
    Err(err) -> Err(frame_error(err, frame))
  }

fn trait_frame_name(icx: ICx, trait_id: Int) -> String =
  match map.get(icx.traits, trait_id) {
    Some(tr) -> tr.name
    None -> "trait"
  }

fn render_frame(frame: CtFrame) -> String =
  match frame {
    FDirect(owner, name) -> "direct `" ++ owner ++ "." ++ name ++ "`"
    FDynamic(owner, name) -> "dynamic `" ++ owner ++ "." ++ name ++ "`"
    FImpl(owner, trait_name, trait_id, subject, method) ->
      "impl `" ++ owner ++ "::" ++ trait_name ++ "#" ++ to_string(trait_id) ++
      "[" ++ subject ++ "]." ++ method ++ "`"
    FDefault(owner, trait_name, trait_id, method) ->
      "default `" ++ owner ++ "::" ++ trait_name ++ "#" ++ to_string(trait_id) ++
      "." ++ method ++ "`"
  }

fn render_call_chain(failure: CtFailure) -> String = {
  if len(failure.frames) == 0 { return "" }
  var lines = ["comptime call chain (innermost first):"]
  for frame in failure.frames { lines = lines ++ ["  at ${render_frame(frame)}"] }
  if failure.truncated { lines = lines ++ ["  ... outer calls omitted"] }
  join(lines, "\n")
}

fn failure_diag(failure0: CtFailure, lo: Int, hi: Int) -> Diag = {
  let failure =
    match failure0.origin {
      Some(_) -> failure0
      None -> CtFailure { ..failure0, origin: Some(CtOrigin { lo: lo, hi: hi }) }
    }
  let origin = failure.origin.expect("comptime failure origin")
  let chain = render_call_chain(failure)
  let hint =
    if chain == "" { failure.hint }
    else if failure.hint == "" { chain }
    else { failure.hint ++ "\n\n" ++ chain }
  mk_diag("comptime: ${failure.msg}", origin.lo, origin.hi, hint)
}

fn burn(st: ESt, env: Env) -> ER =
  if st.fuel - 1 < 0 {
    cerrh(st, env, "fuel exhausted — evaluation did not finish within the step budget",
      "raise it with --comptime-fuel, or simplify the computation")
  } else {
    Ok((ESt { ..st, fuel: st.fuel - 1 }, env, VUnit))
  }

## Charge `n` steps at once: what a primitive that produces `n` elements or
## code points pays, *before* it allocates them (spec §7.2 item 3).
##
## A step is otherwise one Core node, and that alone bounds neither memory nor
## the time of a single step: `s = s ++ s` costs a few nodes per turn while its
## result doubles, so a fuel of 10^5 built a 512 MB string before this charge
## existed, and twice that took the JVM down with an OutOfMemoryError that no
## barrier catches. Charging the size first is what makes the budget bound the
## allocation too; catching the failure after it happened is not an option,
## since a host that ran out of memory is not one to trust afterwards.
##
## The unit is the one the language defines and both hosts agree on, elements
## for a List and code points for a String, so a fold runs out of fuel at the
## same place on the JVM and native compilers.
##
## A negative `n` is over budget, not free. Every caller computes `n` as a
## size, and the only way a size comes out negative is a subtraction that
## wrapped: `range(-2, MAX)` asked for 2^63 elements and was charged nothing,
## and the loop that built them is not one this counter sees. A caller whose
## count can legitimately be empty clamps to zero itself, before calling.
fn burn_n(st: ESt, env: Env, n: Int) -> ER = {
  let left = if n < 0 { -1 } else { st.fuel - n }
  if left < 0 {
    cerrh(st, env, "fuel exhausted — evaluation did not finish within the step budget",
      "raise it with --comptime-fuel, or simplify the computation")
  } else {
    Ok((ESt { ..st, fuel: left }, env, VUnit))
  }
}

## The number this fold gives `s`, decoding it the first time it is seen.
fn text_id(st: ESt, env: Env, s: String) -> Result[(ESt, Int), (ESt, Env, Ctl)] = {
  let t = st.texts
  if t.last >= 0 && t.strs[t.last] == s { return Ok((st, t.last)) }
  match map.get(t.ids, s) {
    Some(id) -> Ok((ESt { ..st, texts: Texts { ..t, last: id } }, id))
    None -> {
      let (st1, _, _) = burn_n(st, env, str.len(s))?
      let id = len(t.strs)
      let texts = Texts {
        ids: map.insert(t.ids, s, id),
        strs: t.strs ++ [s],
        cps: t.cps ++ [code_points(s)],
        last: id
      }
      Ok((ESt { ..st1, texts: texts }, id))
    }
  }
}

## A cursor argument handed to a cursor arm together with `s`: its string's
## number and its code-point index, or a refusal when it was taken on another
## string. The comparison is of contents, so a position in one string is a
## position in any equal one, exactly as it is on both backends.
fn cursor_in(st: ESt, env: Env, s: String, v: CValue) -> Result[(Int, Int), (ESt, Env, Ctl)] =
  match v {
    VCursor(id, c) ->
      if st.texts.strs[id] == s {
        Ok((id, c))
      } else {
        cross_text(st, env)
      }
    _ -> panic("comptime interpreter bug: expected a Cursor")
  }

fn cross_text[T](st: ESt, env: Env) -> Result[T, (ESt, Env, Ctl)] =
  match cerrh(st, env, "a cursor from one string was used with another",
    "a position belongs to the string it was taken on; across strings the backends " ++
      "answer differently, so there is no value to fold (spec 11)") {
    Err(e) -> Err(e)
    Ok(_) -> panic("unreachable")
  }

fn some_v(v: CValue) -> CValue = VAdt(OPTION_ID, 0, [v])

fn none_v() -> CValue = VAdt(OPTION_ID, 1, [])

# ---- value helpers (a mismatch here is an interpreter bug, not a user error) ----

fn as_int(v: CValue) -> Int =
  match v {
    VInt(n) -> n
    _ -> panic("comptime interpreter bug: expected an Int")
  }

## A `Char` argument, which is a `VInt` here: `Char` is opaque over `Int`, so
## it has no runtime representation of its own and the interpreter's value
## domain needs no variant for it. Whatever produced the value has been
## through the checker, so a non-scalar integer is a compiler bug.
fn as_char(v: CValue) -> Char =
  char.of(as_int(v)).expect("comptime interpreter bug: not a code point")

fn as_bool(v: CValue) -> Bool =
  match v {
    VBool(b) -> b
    _ -> panic("comptime interpreter bug: expected a Bool")
  }

fn as_str(v: CValue) -> String =
  match v {
    VStr(s) -> s
    _ -> panic("comptime interpreter bug: expected a String")
  }

fn as_list(v: CValue) -> List[CValue] =
  match v {
    VList(xs) -> xs
    _ -> panic("comptime interpreter bug: expected a List")
  }

fn as_adt(v: CValue) -> (Int, Int, List[CValue]) =
  match v {
    VAdt(aid, ci, fs) -> (aid, ci, fs)
    _ -> panic("comptime interpreter bug: expected an ADT value")
  }

pub fn cvalue_kind(v: CValue) -> String =
  match v {
    VInt(_) -> "Int"
    VFloat(_) -> "Float"
    VBool(_) -> "Bool"
    VStr(_) -> "String"
    VUnit -> "Unit"
    VList(_) -> "List"
    VTuple(_) -> "tuple"
    VAdt(_, _, _) -> "ADT value"
    VClosure(_, _, _) -> "function"
    VDict(_, _) -> "trait dictionary"
    VCursor(_, _) -> "Cursor"
  }

fn stringify(v: CValue) -> String =
  match v {
    VInt(n) -> to_string(n)
    # the shared dtoa, called directly rather than through `to_string`: the
    # first selfhost generation is compiled by a seed whose `to_string(Float)`
    # is still the host's, and a comptime fold must give the new answer from
    # generation one (the bootstrap lesson of audit RP-02)
    VFloat(f) -> fmt.dtoa(f)
    VBool(b) -> to_string(b)
    VStr(s) -> s
    # unreachable: the checker restricts printable types
    _ -> "<value>"
  }

## The trait method `show`, which is the *nested* rendering and so a different
## function from `stringify` above: `to_string("a")` is `a`, while a String
## reached through a `[T: Show]` bound is `"a"` (spec §4.3, and lower.dawn's
## show_at draws the same line at the other end). The two were one arm of
## `call_builtin` until 2026-07-30, and one arm cannot answer both.
##
## `None` is a refusal, and the reason it is not a rendering: `show` is what
## lowering emits for a value handed over *erased*, and the interpreter has no
## more run-time type to recover it from than the C backend does. The merged
## arm answered the literal string `"<value>"` for those -- a wrong answer
## rather than a refusal, and a const folds into the emitted program, so it
## would have been baked into both backends' output.
fn show_value(v: CValue) -> Option[String] =
  match v {
    VStr(s) -> Some(quote_str(s))
    VInt(_) | VFloat(_) | VBool(_) -> Some(stringify(v))
    _ -> None
  }

## Source-literal escaping, backslash first -- the same sequence `dawn/rt/Show`
## applies, and the order is load-bearing: escaping `\` last would double the
## one the quote escape had just introduced.
fn quote_str(s: String) -> String = {
  var out = str.replace(s, "\\", "\\\\")
  out = str.replace(out, "\"", "\\\"")
  out = str.replace(out, "\n", "\\n")
  out = str.replace(out, "\t", "\\t")
  out = str.replace(out, str.from_char('\r'), "\\r")
  "\"" ++ out ++ "\""
}

## Float `==` is IEEE (spec §4.3): NaN equals nothing, -0.0 equals 0.0. The
## interpreter is itself compiled by a backend that implements exactly that,
## so Dawn's own `==` on Float *is* the answer — no host query needed.
fn float_ieee_eq(a: Float, b: Float) -> Bool = a == b

fn value_eq(a: CValue, b: CValue) -> Bool = value_eq_or_clash(a, b) == EQ_TRUE

const EQ_FALSE: Int = 0
const EQ_TRUE: Int = 1
## Two cursors on different strings met: the equality has no answer to fold.
const EQ_CLASH: Int = 2

## `==` and `!=` at comptime: the equality, or the refusal for two cursors
## taken on different strings, wherever in the two values they sit.
fn eq_or_refuse(st: ESt, env: Env, a: CValue, b: CValue) -> Result[Bool, (ESt, Env, Ctl)] = {
  let r = value_eq_or_clash(a, b)
  if r == EQ_CLASH { cross_text(st, env) } else { Ok(r == EQ_TRUE) }
}

fn eq_code(b: Bool) -> Int = if b { EQ_TRUE } else { EQ_FALSE }

fn value_eq_or_clash(a: CValue, b: CValue) -> Int =
  match a {
    VCursor(x, i) ->
      match b {
        VCursor(y, j) -> if x != y { EQ_CLASH } else { eq_code(i == j) }
        _ -> EQ_FALSE
      }
    VList(xs) ->
      match b {
        VList(ys) -> list_eq_or_clash(xs, ys)
        _ -> EQ_FALSE
      }
    VTuple(xs) ->
      match b {
        VTuple(ys) -> list_eq_or_clash(xs, ys)
        _ -> EQ_FALSE
      }
    VAdt(aid, ci, fs) ->
      match b {
        VAdt(bid, bci, gs) -> if aid == bid && ci == bci { list_eq_or_clash(fs, gs) } else { EQ_FALSE }
        _ -> EQ_FALSE
      }
    _ -> eq_code(scalar_eq(a, b))
  }

## In order, stopping at the first pair that is not equal, as the backends'
## equality does: a difference before any clash is an answer both of them
## give, and a clash before any difference is one they do not.
fn list_eq_or_clash(xs: List[CValue], ys: List[CValue]) -> Int = {
  if len(xs) != len(ys) { return EQ_FALSE }
  var i = 0
  while i < len(xs) {
    let e = value_eq_or_clash(xs[i], ys[i])
    if e != EQ_TRUE { return e }
    i = i + 1
  }
  EQ_TRUE
}

fn scalar_eq(a: CValue, b: CValue) -> Bool =
  match a {
    VInt(x) ->
      match b {
        VInt(y) -> x == y
        _ -> false
      }
    VFloat(x) ->
      match b {
        VFloat(y) -> float_ieee_eq(x, y)
        _ -> false
      }
    VBool(x) ->
      match b {
        VBool(y) -> x == y
        _ -> false
      }
    VStr(x) ->
      match b {
        VStr(y) -> x == y
        _ -> false
      }
    VUnit ->
      match b {
        VUnit -> true
        _ -> false
      }
    _ -> false
  }

# ---- lowering on demand ----

## Lower one function and remember it, along with every lambda it lifted.
## Lowering panics are phase-invariant failures and deliberately cross this
## boundary; expected comptime refusals are returned by the interpreter.
fn lower_into(
  icx: ICx,
  st: ESt,
  env: Env,
  owner: String,
  f: TFun
) -> Result[(ESt, CFun), (ESt, Env, Ctl)] !io = {
  # another module's body lowers against the symbol table it was checked
  # with; std's are not kept, and lower as they always have
  let syms = if owner == icx.owner { icx.syms } else {
    map.get(icx.world.syms, owner).unwrap_or(icx.syms)
  }
  let (cf, lifted, dicts, next) =
    lower.lower_fn_only(owner, f, icx.traits, icx.impls, icx.adts, icx.prog_fns,
      syms, st.cache.next_lam, icx.intrs)
  var tbl = map.insert(st.cache.fns, cache_key(owner, f), cf)
  for lf in lifted { tbl = map.insert(tbl, lf.owner ++ "." ++ lf.name, lf) }
  var dts = st.cache.dicts
  for d in dicts { dts = map.insert(dts, d.key, d) }
  let st1 = ESt { ..st, cache: LowerCache { ..st.cache, fns: tbl, dicts: dts, next_lam: next } }
  Ok((note_read(icx, st1, owner_path(icx, owner)), cf))
}

## The module path behind an owner, for the read set: a world module's scope
## knows it, and std's owner is its path.
fn owner_path(icx: ICx, owner: String) -> String =
  match map.get(icx.world.scopes, owner) {
    Some(sc) -> sc.path
    None -> owner
  }

## Record that this run read another module. Its own module is not a read:
## a step always depends on its own input.
fn note_read(icx: ICx, st: ESt, path: String) -> ESt =
  if path == icx.scope.path || set.has(st.cache.reads, path) { st } else {
    ESt { ..st, cache: LowerCache { ..st.cache, reads: set.insert(st.cache.reads, path) } }
  }

## Record that a lookup found nothing. What it would have found depends on
## modules this run cannot name, so the read set no longer bounds the result.
fn note_miss(st: ESt) -> ESt =
  if st.cache.missed { st } else { ESt { ..st, cache: LowerCache { ..st.cache, missed: true } } }

## The subject half of that identity: its *head*, because an impl method's
## `impl_of` names the declared subject (`List[T]`) while a `CImpl` node names
## the instantiated one (`List[Int]`). `ty_key` drops the arguments of an ADT
## but not of a builtin container, so it cannot be the key on its own.
fn subject_key(t: Ty) -> String =
  match t {
    TyList(_) -> "List"
    TyMap(_, _) -> "Map"
    TySet(_) -> "Set"
    TyArray(_) -> "Array"
    TyTuple(es) -> "Tup${to_string(len(es))}"
    _ -> ty_key(t)
  }

## A TFun belongs in the spelling-keyed direct-call tables exactly when Core
## may name it as CDirect. Impl methods and trait defaults are legal name
## collisions; their identities live in `impl_fns` instead.
fn is_direct_fn(f: TFun) -> Bool = f.impl_of == None && f.default_of == None

## Add one direct function to a spelling-keyed table. The std loader and the
## module evaluator share this door so neither can silently reintroduce
## last-wins collisions with impl/default bodies.
pub fn note_direct_fn(tbl: Map[String, TFun], f: TFun) -> Map[String, TFun] =
  if is_direct_fn(f) { map.insert(tbl, f.name, f) } else { tbl }

## Record one function under the identity a `CImpl` or `CDefault` node names,
## if it is one. Shared by std's loader and the module being folded so the two
## tables are built by the same rule.
pub fn note_trait_fn(
  tbl: Map[(Int, String, String), (String, TFun)],
  owner: String,
  f: TFun
) -> Map[(Int, String, String), (String, TFun)] =
  match f.impl_of {
    Some(w) -> {
      let (tid, subject) = w
      map.insert(tbl, (tid, subject_key(subject), f.name), (owner, f))
    }
    None ->
      match f.default_of {
        Some(tid) -> map.insert(tbl, (tid, "\$default", f.name), (owner, f))
        None -> tbl
      }
  }

## Where a lowered body is cached. An impl method shares its name with the
## trait method it implements, and a module may hold several, so the key has to
## carry the impl's own identity rather than just the name.
fn cache_key(owner: String, f: TFun) -> String =
  match f.impl_of {
    Some(w) -> {
      let (tid, subject) = w
      owner ++ ".impl$" ++ to_string(tid) ++ "$" ++ ty_key(subject) ++ "$" ++ f.name
    }
    None ->
      match f.default_of {
        Some(tid) -> owner ++ ".default$" ++ to_string(tid) ++ "$" ++ f.name
        None -> owner ++ "." ++ f.name
      }
  }

## The lowered body of an impl method (or a trait default), found by the
## identity Core names it with rather than by its bare name.
fn get_trait_cfun(
  icx: ICx,
  st: ESt,
  env: Env,
  tid: Int,
  subject_key: String,
  method: String
) -> Result[(ESt, CFun), (ESt, Env, Ctl)] !io = {
  # this module's and std's first, then the modules before it
  let found = match map.get(icx.impl_fns, (tid, subject_key, method)) {
    Some(pair) -> Some(pair)
    None -> map.get(icx.world.impl_fns, (tid, subject_key, method))
  }
  match found {
    Some(pair) -> {
      let (owner, f) = pair
      match map.get(st.cache.fns, cache_key(owner, f)) {
        Some(cf) -> Ok((st, cf))
        None -> lower_into(icx, st, env, owner, f)
      }
    }
    None ->
      match cerr(note_miss(st), env, "missing impl method `" ++ method ++ "`") {
        Err(t) -> Err(t)
        Ok(_) -> panic("unreachable")
      }
  }
}

## The checker's resolution order, as the interpreter sees it: the named owner
## (std's tables, then the modules before this one), then the flat table
## (module fns over std fns).
fn find_fn(icx: ICx, owner: String, name: String) -> Option[(String, TFun)] = {
  match map.get(icx.by_owner, owner) {
    Some(tbl) ->
      match map.get(tbl, name) {
        Some(f) -> return Some((owner, f))
        None -> ()
      }
    None -> ()
  }
  match map.get(icx.world.owners, owner) {
    Some(tbl) ->
      match map.get(tbl, name) {
        Some(f) -> return Some((owner, f))
        None -> ()
      }
    None -> ()
  }
  match map.get(icx.fns, name) {
    Some(f) -> {
      let o =
        match map.get(icx.owner_of, name) {
          Some(x) -> x
          None -> icx.owner
        }
      Some((o, f))
    }
    None -> None
  }
}

## The lowered body behind (owner, name). A lifted lambda only ever lives in
## the cache: it has no TFun to lower from, because it was never in the source.
fn get_cfun(
  icx: ICx,
  st: ESt,
  env: Env,
  owner: String,
  name: String
) -> Result[(ESt, CFun), (ESt, Env, Ctl)] !io = {
  match map.get(st.cache.fns, owner ++ "." ++ name) {
    Some(cf) -> return Ok((st, cf))
    None -> ()
  }
  match find_fn(icx, owner, name) {
    Some(pair) -> {
      let (o, f) = pair
      match map.get(st.cache.fns, cache_key(o, f)) {
        Some(cf) -> Ok((st, cf))
        None -> lower_into(icx, st, env, o, f)
      }
    }
    None ->
      match cerr(note_miss(st), env, "missing function `" ++ name ++ "`") {
        Err(t) -> Err(t)
        Ok(_) -> panic("unreachable")
      }
  }
}

# ---- constants ----

## A constant's value and the module path it was read from. The folding
## module's own constants are the ones folded so far (`icx.consts`), so an
## initializer still sees only earlier constants.
fn const_lookup(icx: ICx, owner: String, name: String) -> Option[(String, CValue)] = {
  if owner != "" {
    if owner == icx.scope.path {
      return match map.get(icx.consts, name) {
        Some(v) -> Some((owner, v))
        None -> None
      }
    }
    return world_const(icx, owner, name)
  }
  if icx.body == icx.owner {
    match map.get(icx.consts, name) {
      Some(v) -> return Some((icx.scope.path, v))
      None -> ()
    }
    return imported_const(icx, icx.scope, name)
  }
  match map.get(icx.world.scopes, icx.body) {
    Some(sc) ->
      match world_const(icx, sc.path, name) {
        Some(found) -> Some(found)
        None -> imported_const(icx, sc, name)
      }
    None -> None
  }
}

fn world_const(icx: ICx, path: String, name: String) -> Option[(String, CValue)] =
  match map.get(icx.world.consts, path) {
    Some(vals) ->
      match map.get(vals, name) {
        Some(v) -> Some((path, v))
        None -> None
      }
    None -> None
  }

## A simple name a selective import brought in, found under the name its
## declaring module gave it (spec §10.2).
fn imported_const(icx: ICx, sc: ConstScope, name: String) -> Option[(String, CValue)] =
  match map.get(sc.imported, name) {
    Some(from) -> world_const(icx, from, map.get(sc.renames, name).unwrap_or(name))
    None -> None
  }

# ---- calls ----

fn call_cfun(
  icx: ICx,
  st: ESt,
  env: Env,
  cf: CFun,
  frame: CtFrame,
  caps: Map[Int, CValue],
  args: List[CValue]
) -> ER !io = {
  if st.depth + 1 > icx.max_depth {
    return framed(
      cerrh(st, env, "call depth limit (" ++ to_string(icx.max_depth) ++ ") exceeded",
        "deep recursion does not fit comptime; use a loop or fold"),
      frame)
  }
  var fenv = caps
  var i = 0
  for p in cf.params {
    fenv = map.insert(fenv, p.sym, args[i])
    i = i + 1
  }
  # a generic function's dictionaries arrive in the trailing slots; binding
  # them keeps the frame consistent even though nothing reads them
  for d in cf.dicts {
    if i < len(args) { fenv = map.insert(fenv, d.sym, args[i]) }
    i = i + 1
  }
  # Evidence rides in the slots behind them, and the binding is positional, so
  # it needs no rule of its own: a named function's slots are one per atom of
  # its ABI row, a function value's is one pack, and both are just arguments
  # here. Comptime still refuses declared effects, so what arrives is always a
  # placeholder or an empty pack -- the pack can get here, and a query cannot,
  # which is the whole of the representation knife's reach into comptime.
  for e in cf.evs {
    if i < len(args) { fenv = map.insert(fenv, e.sym, args[i]) }
    i = i + 1
  }
  # a body names constants in its own module's terms
  let bicx = if cf.owner == icx.body { icx } else { ICx { ..icx, body: cf.owner } }
  match ceval(bicx, ESt { ..st, depth: st.depth + 1 }, fenv, cf.body) {
    Ok(t) -> {
      let (st1, _, v) = t
      Ok((ESt { ..st1, depth: st1.depth - 1 }, env, v))
    }
    Err(t) -> {
      let (st1, _, ctl) = t
      match ctl {
        KReturn(v) -> Ok((ESt { ..st1, depth: st1.depth - 1 }, env, v))
        _ -> Err(frame_error((ESt { ..st1, depth: st1.depth - 1 }, env, ctl), frame))
      }
    }
  }
}

## A trait default body, which is keyed by its trait rather than a subject.
fn call_default(
  icx: ICx,
  st: ESt,
  env: Env,
  owner: String,
  tid: Int,
  method: String,
  args: List[CValue]
) -> ER !io = {
  let frame = FDefault(owner, trait_frame_name(icx, tid), tid, method)
  match get_trait_cfun(icx, st, env, tid, "\$default", method) {
    Err(err) -> Err(frame_error(err, frame))
    Ok(pair) -> {
      let (st1, cf) = pair
      let no_caps: Map[Int, CValue] = map.empty()
      call_cfun(icx, st1, env, cf, frame, no_caps, args)
    }
  }
}

fn apply_fn(icx: ICx, st: ESt, env: Env, f: CValue, args: List[CValue]) -> ER !io =
  match f {
    VClosure(owner, name, caps) -> {
      let frame = FDynamic(owner, name)
      match get_cfun(icx, st, env, owner, name) {
        Err(err) -> Err(frame_error(err, frame))
        Ok(pair) -> {
          let (st1, cf) = pair
          call_cfun(icx, st1, env, cf, frame, caps, args)
        }
      }
    }
    _ -> cerr(st, env, "cannot call a non-function value")
  }

## A direct call by name. A function with dictionary parameters is one the
## call site passed witnesses to; `call_cfun` binds them into the frame like
## any other argument.
fn call_named(
  icx: ICx,
  st: ESt,
  env: Env,
  owner: String,
  name: String,
  args: List[CValue]
) -> ER !io = {
  let frame = FDirect(owner, name)
  if owner == "std/hamt" {
    return framed(cerr(st, env, "Map and Set operations are not available at comptime"), frame)
  }
  match get_cfun(icx, st, env, owner, name) {
    Err(err) -> Err(frame_error(err, frame))
    Ok(pair) -> {
      let (st1, cf) = pair
      let no_caps: Map[Int, CValue] = map.empty()
      call_cfun(icx, st1, env, cf, frame, no_caps, args)
    }
  }
}

# ---- intrinsics (the pure ones; io never reaches the interpreter) ----
#
# This chain is the third dispatcher over intrinsic names, and until
# 2026-07-30 it was the only one that answered out of its own head: emit and
# emitc both look the name up in `types.intrinsics()`, so a primitive added
# there reaches them, while one added here reached nothing and no test said so.
# Both directions had drifted -- three arms below had no producer left, and
# `str_of_bytes` had to be added by hand when RP-02 introduced it (audit RP-12).
#
# Three groups close that. Together they partition
# `types.intrinsics()` + `lower.internal_intrinsics()`: every intrinsic in the
# program is interpreted here, removed by lowering before this evaluator could
# see it (`lower.lowered_intrinsics()`, read rather than copied), or
# deliberately refused. The gate test at the bottom of this file checks the
# partition is total and pairwise disjoint, and it probes each name to check
# the lists say what the chain does.
#
# The middle group is the one this file lacked until 2026-09-30 (#185). With
# only "arm" and "refused" to choose from, a name lowering removes had to be
# put in one of them: `parse_int` got an arm no producer could reach, and
# `parse_int_radix` got a refusal the mirror in selfhost/builtins.dawn then
# published as "a `const` cannot use this" -- while `const Z = parse_int_radix
# ("ff", 16)` folds to `Some(255)`, through std/fmt's Core like any other call.

## Every name the chain below has an arm for -- 43 of them, 13 emitted by
## lowering and 30 writable by a user.
##
## Consulted *before* the chain rather than alongside it, so this is a gate and
## not a second copy: a name missing from here can never reach an arm, which
## makes an undeclared arm dead by construction instead of invisible. Omitting
## a name that should be here is caught rather than silent -- if the name is an
## intrinsic the partition check goes red, and if it is not, the arm was
## already unreachable from lowering.
fn interp_arms() -> List[String] = [
  # lowering's own intrinsics (lower.internal_intrinsics()); `hash` and
  # `java_hash` are the two it emits that are refused instead, below
  "cmp", "java_eq", "show", "quote", "str_of_int", "str_of_bool",
  "str_of_bytes", "list_index", "list_slice", "list_push", "null_ref", "ev_get", "ev_append",
  "dbg_line",
  # user builtins
  "panic", "todo", "expect", "unwrap_or", "to_float", "to_int", "to_string",
  "len", "get", "range", "sort_by", "join",
  "cursor_start", "cursor_end", "cursor_done", "cursor_char", "cursor_next",
  "cursor_prev", "cursor_slice",
  "code_points", "from_code_points",
  "char_is_letter", "char_is_digit", "char_is_alnum", "char_is_upper",
  "char_is_lower", "char_is_space",
  "str_lower", "str_upper", "float_of_decimal"
]

## Every intrinsic a comptime run refuses, and why it is a group rather than an
## oversight.
##
## Read it, with `comptime_refused_after_lowering` below, as the real answer to
## "what can a `const` do". The lists are measured -- the gate test calls each
## name and checks it really is refused -- and they are what users read too:
## spec §7.2 names the groups and sends a reader to the `comptime` field of
## `dawn doc --builtins` for the names (`comptime_refuses`), instead of a prose
## copy that was short of them by an order of magnitude (audit RP-11, #213).
fn comptime_rejects() -> List[String] = {
  # `hash` is the prelude Hash collapsed at a scalar and `java_hash` the
  # host's. A hash feeds a Map or a Set, which comptime cannot hold, so there
  # is nothing for one to fold into. `cmp`, the same collapse for `Ord`, used
  # to be here too, and that left `list.sort`, a derived `Ord` and `<` on a
  # tuple unfoldable while `<` on the scalars inside them folded: an order is
  # the language's (spec 3.5), so it has an arm now.
  var out = ["hash", "java_hash"]
  # `CValue` has no `VBytes`: comptime cannot hold a Bytes at all, so the
  # seven byte primitives have nothing to operate on
  for op in ["utf8", "decode_utf8", "decode_latin1", "len", "at", "slice",
    "from_array"] {
    out = out ++ ["bytes_" ++ op]
  }
  # io is the point: a compile must not read files or spawn processes because
  # a source file said so. `args` is the same rule at the process boundary.
  # The two clocks act on nothing, but a reading would make the bytes a build
  # produces depend on when it ran, which is the input reproducible builds
  # exist to remove; a fixed answer instead (0, say) would compile a `const`
  # stamped 1970 without a word. docs/clock-design.md has both halves.
  for op in ["print", "println", "eprint", "eprintln", "read_line", "is_dir", "read_file",
    "write_file", "exit", "exists", "mkdirs", "cwd", "getenv", "read_bytes", "write_bytes",
    "delete", "rename", "temp_dir", "temp_file", "copy_permissions", "is_symlink", "real_path",
    "read_stdin", "stdin_ready", "clock_wall_ns", "clock_mono_ns", "list_names", "run"] {
    out = out ++ ["io_" ++ op]
  }
  # The two barriers are refused for a reason of their own, and it is not the
  # row they raise -- `catch_fault` raises none since 2026-09-01
  # (docs/audit/error-model-design.md §7.5), so "they take an `!io` thunk they
  # would have to run" stopped being the answer. What they would fold is a
  # `ForeignError`, and its fields belong to the build rather than to the
  # program: `kind` is declared backend-dependent
  # (`java.lang.NumberFormatException` on the JVM, `"fault"` on native --
  # runtime-intrinsics-design.md §12.4), and `catch_panic`'s `message` is too,
  # on top of being a function of the source text an `assert` was written with.
  # Folding either into a constant bakes the compiler that ran into the
  # artifact it produced.
  #
  # `bracket` needs a ground of its own, being effect-polymorphic and catching
  # nothing: a `const` cannot hold a resource, so there is nothing here to
  # protect and nothing for a release to give up, and folding it would be
  # inventing the answer rather than computing it.
  out = out ++ ["args", "catch_fault", "catch_panic", "bracket"]
  # The retained reactor root is process/module state. A comptime evaluation
  # has neither a reactor instance nor a turn boundary in which one could live.
  out = out ++ ["reactor_state_has", "reactor_state_get", "reactor_state_set"]
  # The GPU primitives are io at a device: a compile must not open a driver
  # any more than it may read a file, and `CValue` has no Array to hand them.
  for op in ["load_module_host", "alloc_host", "upload_host", "download_host", "upload_bytes_host",
    "download_bytes_host", "launch_host", "module_global_host", "free_host", "sync_host",
    "close_host"] {
    out = out ++ ["gpu_" ++ op]
  }
  # `cast` unerases a host object, and comptime never has one. Its failure
  # being a value rather than a throw (the error model's step B) did not change
  # that: there is still no host object to reclaim, and an `Err` here would be
  # a fabricated answer rather than a fold.
  out = out ++ ["cast"]
  # Array: `CValue` has no representation for it. Map and Set are refused too
  # -- the group spec §7.2.2 names -- but not here: lowering turns them into
  # calls on std/hamt before this evaluator sees a name, and the refusal is
  # `call_named`'s (`comptime_refused_after_lowering` below).
  for op in ["new", "len", "get", "push", "with", "steal"] { out = out ++ ["array_" ++ op] }
  # a bitmap operation on the array representation, so it is refused with it
  out = out ++ ["popcount"]
  # the handler-local slot. Reachable, and refused here. The checker refuses a
  # `with handle` written in a `const` initialiser or comptime block itself
  # (checker.dawn's comptime gate, "`with handle` is not available at compile
  # time"), but not one inside a pure function the initialiser calls: such a
  # function's Core is what this evaluator runs. A handler without state
  # folds -- its arms are ordinary closures in an evidence pack, all arms
  # this file already has. A handler with a `var` installs a cell, and that
  # `cell_new` is where the fold stops ("builtin `cell_new` is not available
  # at comptime", interp_test.dawn pins it). Refused rather than given arms
  # because `CValue` is immutable, so an implementation would have to invent a
  # store the rest of this interpreter has no notion of. `cell_get`/`cell_set`/
  # `cell_take` only ever follow a `cell_new`, so the first refusal is the one
  # a program meets.
  out = out ++ ["cell_new", "cell_get", "cell_set", "cell_take"]
  # one-shot resumption, refused for the reason the next paragraph gives.
  # Reachable the same way: a `ctl` handler installed in a function a `const`
  # calls reaches `ctl_run` when it installs, and the fold stops there
  # ("builtin `ctl_run` is not available at comptime", pinned beside the cell
  # case); `ctl_yield` happens only under a `ctl_run`, so that refusal comes
  # first. Both backends run the pair (`lower.staged_intrinsics` is empty), so
  # this is the one evaluator in the compiler that does not.
  #
  # Before either name is ever admitted here, the continuation's effect
  # account has to be answered first, not after. comptime may call any pure
  # function (spec §7), and a continuation is an ordinary function value; the
  # only thing that keeps a pure `k` from smuggling a remainder's io into a
  # fold is that `k` carries the remainder's io bit (`types.cont_row`, spec
  # §6.5 "control arms"), which is a checker rule this evaluator inherits
  # rather than enforces. Admitting `ctl_*` here without re-reading that rule
  # against whatever the fold can then construct would reopen the hole spec
  # §9.8.1 used to record as an exception. Today the isolation is structural at
  # this one point: the checker keeps `with handle` out of the initialiser's
  # own text, but a handler a called function installs gets as far as
  # `ctl_run`, and this refusal is what stops it.
  out = out ++ ["ctl_yield", "ctl_run"]
  # `discard` is the user-facing third of that family and is refused for the
  # first of those reasons alone: its argument is a continuation, a `const`
  # initialiser cannot produce one, and a value that is not a continuation is
  # a run-time panic rather than a fold.
  out = out ++ ["discard"]
  out
}

## The names lowering removes that a `const` still cannot use: Map and Set.
##
## Refused, but not by the chain -- no name here ever reaches it. Lowering
## turns each into a call on the Dawn trie in std/hamt (`lower.hamt_fn`), and
## `call_named` refuses that module's Core, because `CValue` has no
## representation for a trie. So these are in the lowered group of the
## partition and in no list the chain reads; this list exists for the one
## reader that has to know the refusal is real all the same, the
## `# comptime: rejected` markers in selfhost/builtins.dawn
## (scripts/builtin-decl-contract, P5). The gate test holds it equal to the
## lowered names `hamt_fn` routes, in both directions, and checks the refusal
## itself.
fn comptime_refused_after_lowering() -> List[String] = {
  var out: List[String] = []
  for op in ["empty", "from", "insert", "remove", "get", "has", "size", "keys", "values",
    "entries", "fold"] {
    out = out ++ ["map_" ++ op]
  }
  for op in ["empty", "from", "insert", "remove", "has", "size", "to_list"] {
    out = out ++ ["set_" ++ op]
  }
  out
}

## Whether a `const` cannot use the builtin `name`: the union of the two lists
## above, the same set the mirror's `# comptime: rejected` markers are held to.
## `dawn doc --builtins` prints it per builtin, so the published answer is these
## lists rather than a third copy of them, and scripts/builtin-decl-contract
## holds that export to the markers as well.
pub(pkg) fn comptime_refuses(name: String) -> Bool =
  has_name(comptime_rejects(), name) || has_name(comptime_refused_after_lowering(), name)

fn has_name(xs: List[String], n: String) -> Bool = {
  for x in xs {
    if x == n { return true }
  }
  false
}

## The refusal a name with no arm gets. One function because the gate test
## recognises the refusal by its text, and a message that drifted from the
## test would make every probe read as "interpreted".
fn no_arm_msg(name: String) -> String =
  "builtin `" ++ name ++ "` is not available at comptime"

const NO_ARM_LISTED: String = "listed in interp_arms but has no arm: "

## The evidence-pack walk, on the interpreter's own values: the third
## implementation of `ev_get`, alongside the JVM's `INSTANCEOF` loop and
## `dawn_ev_get`. Its contract is written at `types.ev_pack_adt`.
##
## The shape test the other two get from the runtime is a `match` here, which
## is why this one is a plain function and testable: a `VAdt` at `EV_PACK_ID`
## is a node and everything else ends the walk. The three terminators the
## contract names all arrive as "not a `VAdt` at that id" -- the placeholder
## boxes to `VUnit`, a null pack cannot be constructed at all, and any other
## erased value is some other `CValue`.
##
## A miss panics rather than answering the placeholder, and panics *this
## compiler* rather than raising a comptime diagnostic: a pack without a key
## its own reader named is lowering's bug, not the interpreted program's, and
## `lower.impl_ev_sources` treats the same class of break the same way.
fn ev_get_value(pack: CValue, key: Int) -> CValue =
  match pack {
    VAdt(aid, _, fields) ->
      if aid != EV_PACK_ID {
        panic(EV_MISS_MSG)
      } else {
        match fields[0] {
          VInt(k) -> if k == key { fields[1] } else { ev_get_value(fields[2], key) }
          _ -> panic("comptime interpreter bug: an evidence pack's key is not an Int")
        }
      }
    _ -> panic(EV_MISS_MSG)
  }

## One pack node, in the shape `lower.ev_build` conses them.
fn ev_node(key: Int, ev: CValue, outer: CValue) -> CValue =
  VAdt(EV_PACK_ID, 0, [VInt(key), ev, outer])

## The evidence-pack join, on the interpreter's own values: the third
## implementation of `ev_append`, alongside the JVM's emitted static and
## `dawn_ev_append`. Its contract is written at `types.ev_pack_adt`.
##
## Recursion is the whole of it here, and the shape it recurses on is the same
## one `ev_get_value` walks: a `VAdt` at `EV_PACK_ID` is a node, anything else
## is where `front` stopped -- and where `front` stopped is where `back` goes.
## `front`'s own terminator is *dropped*, not copied, which is what makes the
## result one flat chain rather than a chain that ends in another chain.
##
## No panic. A miss is a broken invariant, but a `front` with nothing in it is
## an ordinary answer: a row whose first non-ground atom instantiated to pure
## carries the placeholder, and appending it must give `back` back.
fn ev_append_value(front: CValue, back: CValue) -> CValue =
  match front {
    VAdt(aid, _, fields) ->
      if aid != EV_PACK_ID {
        back
      } else {
        VAdt(EV_PACK_ID, 0, [fields[0], fields[1], ev_append_value(fields[2], back)])
      }
    _ -> back
  }

## Did the walk end in the contract's panic? `catch_panic` because that is
## what a panic is here, and the message because "some panic" would pass for
## an index-out-of-range just as well.
fn ev_get_panics(pack: CValue, key: Int) -> Bool =
  match catch_panic(() => ev_get_value(pack, key)) {
    Ok(_) -> false
    Err(e) -> str.contains(e.message, EV_MISS_MSG)
  }

# Nothing in a compiled program calls `ev_get` yet -- lowering emits no read
# until the knife that flips the semantics -- so these two tests are the whole
# oracle for the walk. They are written against the interpreter's copy because
# it is the one of the three that is a function rather than instructions; the
# other two are held to the same shape by scripts/intrinsic-parity.py and, for
# the C one, by emitc's test that the runtime declares what the emitter calls.

test "an evidence pack answers by key, not by position" {
  let empty: CValue = VUnit
  let one = ev_node(7, VInt(700), empty)
  let two = ev_node(4, VInt(400), one)
  let three = ev_node(1, VInt(100), two)
  # the node the walk starts on
  assert as_int(ev_get_value(three, 1)) == 100
  # and the ones it only reaches by following `outer`. Compare the keys or the
  # first node answers for every one of them; follow `outer` or the walk stops
  # at the first node and these are misses
  assert as_int(ev_get_value(three, 4)) == 400
  assert as_int(ev_get_value(three, 7)) == 700
  # a node answers the same whatever is consed in front of it: the pack is a
  # scope, and a node nobody asked for costs a step and nothing else
  assert as_int(ev_get_value(one, 7)) == 700
}

test "an evidence pack ends on the placeholder, and a miss is a panic" {
  let empty: CValue = VUnit
  let one = ev_node(7, VInt(700), empty)
  # the placeholder ends the walk rather than being read as a node -- the
  # whole reason the terminator test belongs to the runtime -- and the end of
  # a walk is the panic, never the placeholder handed back as evidence
  assert ev_get_panics(one, 8)
  # a bare placeholder is the empty pack: nothing to walk, same answer
  assert ev_get_panics(empty, 7)
  # any other erased value terminates too. This is the case native cannot
  # answer without the header's `kind` byte, and the one `CIsCtor` would have
  # read a tag off
  assert ev_get_panics(VStr("not a pack"), 7)
  # NULL is the fourth thing that ends a walk, and it has no CValue at all --
  # it comes from the hand-written shims, so `dawn_ev_get`'s own `p != NULL`
  # is the only place it is answered and nothing here reaches it.
}

test "an appended pack answers from both halves, and answers front's first" {
  let empty: CValue = VUnit
  # two chains that answer nothing of each other's: the shape a row with two
  # non-ground atoms hands one slot
  let front = ev_node(1, VInt(100), ev_node(4, VInt(400), empty))
  let back = ev_node(7, VInt(700), empty)
  let both = ev_append_value(front, back)
  # every key of front, in front's own order, then every key of back. Copy
  # only front and the last two are misses; return `back` alone and the first
  # two are
  assert as_int(ev_get_value(both, 1)) == 100
  assert as_int(ev_get_value(both, 4)) == 400
  assert as_int(ev_get_value(both, 7)) == 700
  # the join is a rebuild, so neither argument learned anything: front still
  # ends where it ended, and back is still just itself
  assert ev_get_panics(front, 7)
  assert ev_get_panics(back, 1)

  # front before back, stated as a lookup. Distinct atoms cannot collide, so
  # this same-key probe is the one place the order is observable -- and the
  # order is defined (types.ev_pack_adt), so it is pinned rather than left to
  # whichever half the rebuild happened to put first
  let a = ev_node(9, VInt(1), empty)
  let b = ev_node(9, VInt(2), empty)
  assert as_int(ev_get_value(ev_append_value(a, b), 9)) == 1
  assert as_int(ev_get_value(ev_append_value(b, a), 9)) == 2
}

test "appending an empty pack changes nothing on either side" {
  let empty: CValue = VUnit
  let back = ev_node(7, VInt(700), empty)
  # an empty front is the identity: a row whose non-ground atom instantiated
  # to pure brings the placeholder, and it must not cost `back` a key. Not a
  # panic either -- `ev_append` has no miss to have, only `ev_get` does
  assert value_eq(ev_append_value(empty, back), back)
  # and an empty back leaves a chain that ends on the placeholder, which is to
  # say a walk of it terminates rather than running off anything
  let front = ev_node(1, VInt(100), empty)
  let onto_empty = ev_append_value(front, empty)
  assert as_int(ev_get_value(onto_empty, 1)) == 100
  assert ev_get_panics(onto_empty, 7)
  # front's own terminator is dropped rather than copied, so two placeholders
  # never meet: the chain is flat, and `ev_get` stays one walk
  assert value_eq(onto_empty, front)
}

fn call_builtin(icx: ICx, st: ESt, env: Env, name: String, args: List[CValue]) -> ER !io =
  if not has_name(interp_arms(), name) {
    cerr(st, env, no_arm_msg(name))
  } else if name == "cmp" {
    let c = order(st, env, args[0], args[1])?
    Ok((st, env, VInt(c)))
  } else if name == "java_eq" {
    # equality of a host value (semantics-closure-design.md 3). Comptime never
    # reaches a real Java object -- `use java` is not foldable -- so this is
    # the interpreter's own value equality, kept so the arm is not a hole.
    let same = eq_or_refuse(st, env, args[0], args[1])?
    Ok((st, env, VBool(same)))
  } else if name == "ev_get" {
    # An arm rather than a refusal, so that a `const` whose body reaches a
    # function value keeps folding once lowering starts emitting reads.
    # Comptime still refuses declared effects, so the packs that get here are
    # the ones lowering builds for a pure row -- which is why the terminator
    # matters more here than a hit does.
    Ok((st, env, ev_get_value(args[0], as_int(args[1]))))
  } else if name == "ev_append" {
    # the join, for the same reason the lookup has an arm: a `const` whose
    # body reaches a function value with two rows in one slot folds here, and
    # a refusal would make that fold a diagnostic instead of an answer.
    Ok((st, env, ev_append_value(args[0], args[1])))
  } else if name == "dbg_line" {
    # `dbg` is the identity, and its line is no part of what a `const`
    # computes (docs/source-location-design.md section 6.5): nothing is
    # written and nothing is refused. Every other io primitive is refused
    # because a compile must not act on the world; this one does not act.
    Ok((st, env, VUnit))
  } else if name == "panic" {
    cerr(st, env, "panicked: ${as_str(args[0])}")
  } else if name == "todo" {
    cerr(st, env, "panicked: not yet implemented")
  } else if name == "expect" {
    let (aid, ci, fields) = as_adt(args[0])
    if adt_of(icx.adts, aid).ctors[ci].name == "Some" {
      Ok((st, env, fields[0]))
    } else {
      cerr(st, env, "panicked: ${as_str(args[1])}")
    }
  } else if name == "unwrap_or" {
    let (aid, ci, fields) = as_adt(args[0])
    if adt_of(icx.adts, aid).ctors[ci].name == "Some" {
      Ok((st, env, fields[0]))
    } else {
      Ok((st, env, args[1]))
    }
  } else if name == "to_float" {
    Ok((st, env, VFloat(to_float(as_int(args[0])))))
  } else if name == "to_int" {
    let f = match args[0] {
      VFloat(x) -> x
      _ -> panic("comptime interpreter bug: to_int expects Float")
    }
    Ok((st, env, VInt(to_int(f))))
    # str_of_* is what interpolation lowers to; to_string is the surface
    # builtin. These are the *top-level* rendering, where a String is itself
    # and not a quoted literal.
  } else if name == "to_string" || name == "str_of_int" || name == "str_of_bool" {
    Ok((st, env, VStr(stringify(args[0]))))
  } else if name == "show" {
    # Not charged by size: a String never reaches this arm (lowering renders a
    # known String through `quote`, which is charged; lower.show_erased), and
    # every other value it can render is a scalar of bounded length.
    match show_value(args[0]) {
      Some(s) -> Ok((st, env, VStr(s)))
      None -> cerr(st, env, "`show` cannot render this value at comptime")
    }
  } else if name == "str_of_bytes" {
    # There is no `VBytes`: comptime has no Bytes values at all, so nothing
    # can reach this. Refusing by name beats falling through to the generic
    # "not available at comptime", which would read as a missing feature
    # rather than as a value the interpreter cannot hold.
    cerr(st, env, "a Bytes cannot be rendered at comptime")
    # the nested rendering of a String, which a synthesised `show` body reaches
    # for every String field
  } else if name == "quote" {
    let s = as_str(args[0])
    let (st1, _, _) = burn_n(st, env, str.len(s))?
    Ok((st1, env, VStr(quote_str(s))))
  } else if name == "len" {
    Ok((st, env, VInt(len(as_list(args[0])))))
  } else if name == "get" {
    let xs = as_list(args[0])
    let i = as_int(args[1])
    if i >= 0 && i < len(xs) {
      Ok((st, env, some_v(xs[i])))
    } else {
      Ok((st, env, none_v()))
    }
    # `xs[i]`, and the element read that `for x in xs` lowers to
  } else if name == "list_index" {
    let xs = as_list(args[0])
    let i = as_int(args[1])
    if i < 0 || i >= len(xs) {
      cerr(st, env, "index " ++ to_string(i) ++ " out of bounds for length " ++
          to_string(len(xs)))
    } else {
      Ok((st, env, xs[i]))
    }
    # `xs ++ [x]`, rewritten from a one-element concat (lower.cat_list)
  } else if name == "list_push" {
    Ok((st, env, VList(as_list(args[0]) ++ [args[1]])))
    # the `..rest` of a list pattern
  } else if name == "list_slice" {
    let xs = as_list(args[0])
    let from = as_int(args[1])
    let to = as_int(args[2])
    # clamped into the list before subtracting, so the count is the number of
    # elements produced and cannot wrap
    let lo = if from < 0 { 0 } else if from > len(xs) { len(xs) } else { from }
    let hi = if to < lo { lo } else if to > len(xs) { len(xs) } else { to }
    let (st1, _, _) = burn_n(st, env, hi - lo)?
    Ok((st1, env, VList(list.take(list.drop(xs, lo), hi - lo))))
    # the placeholder a match or if result slot is declared with; every path
    # assigns before reading, so its value is never observed
  } else if name == "null_ref" {
    Ok((st, env, VUnit))
  } else if name == "range" {
    let from = as_int(args[0])
    let to = as_int(args[1])
    # An empty range costs nothing. Otherwise `to - from` is the count, and it
    # is negative exactly when the length does not fit in an Int, which
    # `burn_n` treats as over any budget.
    let (st1, _, _) = burn_n(st, env, if to <= from { 0 } else { to - from })?
    var out: List[CValue] = []
    var i = from
    while i < to {
      out = out ++ [VInt(i)]
      i = i + 1
    }
    Ok((st1, env, VList(out)))
  } else if name == "sort_by" {
    let (st1, sorted) = merge_sort(icx, st, env, as_list(args[0]), args[1])?
    Ok((st1, env, VList(sorted)))
  } else if name == "join" {
    let sep = as_str(args[1])
    var parts: List[String] = []
    var size = 0
    for x in as_list(args[0]) {
      let p = as_str(x)
      size = size + str.len(p) + (if len(parts) > 0 { str.len(sep) } else { 0 })
      parts = parts ++ [p]
    }
    let (st1, _, _) = burn_n(st, env, size)?
    Ok((st1, env, VStr(join(parts, sep))))
    # ---- the cursor family ----
    #
    # A position is opaque, so nothing outside std/cursor can see the number
    # and no `const` can hold one -- the type is not nameable outside its
    # module, and a constant must declare its type. That leaves the
    # interpreter free to pick its own currency, and it picks the one that
    # needs no host: a *code-point index*, where the JVM backend uses a UTF-16
    # offset and the C runtime a byte offset. The seven only have to agree with
    # each other.
    #
    # A position also names the string it was taken on (`VCursor.text`, see
    # `Texts`), and every arm below checks it against the string it is handed.
    # Across two strings the backends disagree with each other (spec 11 leaves
    # it undefined), so no folded answer could match the program at run time;
    # the interpreter refuses instead of inventing a third one.
    #
    # They reached the emitted `dawn.rt.Strings` by reflection until 2026-07-28,
    # which is a route a native compiler does not have and which answered with
    # whatever the *seed* release emitted rather than what this compiler does
    # (docs/native-backend-plan.md 14.11, 14.13).
    #
  } else if name == "cursor_start" {
    let (st1, id) = text_id(st, env, as_str(args[0]))?
    Ok((st1, env, VCursor(id, 0)))
  } else if name == "cursor_end" {
    let (st1, id) = text_id(st, env, as_str(args[0]))?
    Ok((st1, env, VCursor(id, len(st1.texts.cps[id]))))
  } else if name == "cursor_done" {
    let (id, c) = cursor_in(st, env, as_str(args[0]), args[1])?
    Ok((st, env, VBool(c >= len(st.texts.cps[id]))))
  } else if name == "cursor_char" {
    let (id, c) = cursor_in(st, env, as_str(args[0]), args[1])?
    let cps = st.texts.cps[id]
    if c < 0 || c >= len(cps) {
      Ok((st, env, VInt(-1)))
    } else {
      Ok((st, env, VInt(char.code(cps[c]))))
    }
  } else if name == "cursor_next" {
    let (id, c) = cursor_in(st, env, as_str(args[0]), args[1])?
    let n = len(st.texts.cps[id])
    Ok((st, env, VCursor(id, if c < 0 { 0 } else if c >= n { n } else { c + 1 })))
  } else if name == "cursor_prev" {
    let (id, c) = cursor_in(st, env, as_str(args[0]), args[1])?
    let n = len(st.texts.cps[id])
    Ok((st, env, VCursor(id, if c <= 0 { 0 } else if c > n { n - 1 } else { c - 1 })))
  } else if name == "cursor_slice" {
    let s = as_str(args[0])
    let (id, from) = cursor_in(st, env, s, args[1])?
    let (_, to) = cursor_in(st, env, s, args[2])?
    let cps = st.texts.cps[id]
    if from < 0 || to > len(cps) || from > to {
      cerr(st, env, "panicked: cursor_slice: invalid cursor range")
    } else {
      let (st1, _, _) = burn_n(st, env, to - from)?
      var out: List[Char] = []
      var i = from
      while i < to {
        out = out ++ [cps[i]]
        i = i + 1
      }
      Ok((st1, env, VStr(from_code_points(out))))
    }
    # case folding is a Unicode table rather than a walk, so it stays a backend
    # primitive -- but calling it is not reflecting into one: this is the same
    # intrinsic every other module writes, compiled for whichever host the
    # compiler itself runs on.
    # code_points/from_code_points and the Unicode classifiers. These had no
    # arm at all until 2026-07-28: nothing reached them, because `substring`
    # and `trim` were intrinsics, so `const X = str.slice(...)` had never
    # been written down anywhere that would run it. Moving std off the
    # intrinsics is what asked the question.
  } else if name == "code_points" {
    let s = as_str(args[0])
    let (st1, _, _) = burn_n(st, env, str.len(s))?
    var out: List[CValue] = []
    for cp in code_points(s) { out = out ++ [VInt(char.code(cp))] }
    Ok((st1, env, VList(out)))
  } else if name == "from_code_points" {
    let vs = as_list(args[0])
    let (st1, _, _) = burn_n(st, env, len(vs))?
    var cps: List[Char] = []
    for v in vs { cps = cps ++ [as_char(v)] }
    Ok((st1, env, VStr(from_code_points(cps))))
  } else if name == "char_is_letter" {
    Ok((st, env, VBool(char_is_letter(as_char(args[0])))))
  } else if name == "char_is_digit" {
    Ok((st, env, VBool(char_is_digit(as_char(args[0])))))
  } else if name == "char_is_alnum" {
    Ok((st, env, VBool(char_is_alnum(as_char(args[0])))))
  } else if name == "char_is_upper" {
    Ok((st, env, VBool(char_is_upper(as_char(args[0])))))
  } else if name == "char_is_lower" {
    Ok((st, env, VBool(char_is_lower(as_char(args[0])))))
  } else if name == "char_is_space" {
    Ok((st, env, VBool(char_is_space(as_char(args[0])))))
  } else if name == "str_lower" {
    let s = as_str(args[0])
    let (st1, _, _) = burn_n(st, env, str.len(s))?
    Ok((st1, env, VStr(str.to_lower(s))))
  } else if name == "str_upper" {
    let s = as_str(args[0])
    let (st1, _, _) = burn_n(st, env, str.len(s))?
    Ok((st1, env, VStr(str.to_upper(s))))
  } else if name == "float_of_decimal" {
    # std/fmt.atod's raw conversion, reached through the program's own std
    # Core after atod's scanner accepted and trimmed the text. The host's
    # `parse_float` is the same function on that subset -- it is atod over the
    # compiler's own std -- so the fold and the backends agree.
    match parse_float(as_str(args[0])) {
      Some(f) -> Ok((st, env, some_v(VFloat(f))))
      None -> Ok((st, env, none_v()))
    }
  } else {
    # unreachable while the gate test is green: the guard at the top let this
    # name through, so `interp_arms()` claims an arm the chain does not have
    panic(NO_ARM_LISTED ++ name)
  }

## Stable merge sort with the interpreted comparator, deciding each step the
## way std/pvec's `merge` does: the right element goes first only when
## `cmp(right, left) < 0`, and a tie takes from the left.
##
## Both orders agree for a total order, and `sort_by` does not ask for one:
## its comparator is any `fn(T, T) -> Int`. With `(a, b) => 1`, or the common
## "-1 if less, else 0", the two conventions answer differently, and this one
## used to ask `cmp(left, right) <= 0` instead, so a folded sort and the same
## sort at run time printed two different lists. pvec is what both backends
## run, so it is the definition; scripts/spike-native/const_fold.dawn holds a
## folded and a live sort with such comparators side by side.
fn merge_sort(
  icx: ICx,
  st: ESt,
  env: Env,
  xs: List[CValue],
  f: CValue
) -> Result[(ESt, List[CValue]), (ESt, Env, Ctl)] !io = {
  if len(xs) <= 1 { return Ok((st, xs)) }
  let mid = len(xs) / 2
  let (st1, left) = merge_sort(icx, st, env, list.take(xs, mid), f)?
  let (st2, right) = merge_sort(icx, st1, env, list.drop(xs, mid), f)?
  var out: List[CValue] = []
  var i = 0
  var j = 0
  var st3 = st2
  while i < len(left) && j < len(right) {
    let (st4, _, cv) = apply_fn(icx, st3, env, f, [right[j], left[i]])?
    st3 = st4
    if as_int(cv) < 0 {
      out = out ++ [right[j]]
      j = j + 1
    } else {
      out = out ++ [left[i]]
      i = i + 1
    }
  }
  while i < len(left) {
    out = out ++ [left[i]]
    i = i + 1
  }
  while j < len(right) {
    out = out ++ [right[j]]
    j = j + 1
  }
  Ok((st3, out))
}

# ---- a Java call reached at compile time ----

## Unreachable from any program that checks: a `use java` call is `!io` and a
## const or comptime block is pure, and nothing in the language vouches the
## one into the other since `unsafe_pure` was removed
## (docs/effects-window-design.md 6). It is a refusal rather than a panic
## because the interpreter is also driven by probes that skip the checker.
fn eval_java(st: ESt, env: Env, j: CJava) -> ER =
  cerr(st, env, "a Java call cannot be evaluated at compile time: `" ++ j.call.fqcn ++ "." ++
      j.call.method ++ "` is io")

# ---- the evaluator ----

fn eval_all(
  icx: ICx,
  st: ESt,
  env: Env,
  es: List[CExpr]
) -> Result[(ESt, Env, List[CValue]), (ESt, Env, Ctl)] !io = {
  var st1 = st
  var env1 = env
  var vals: List[CValue] = []
  for e in es {
    let (st2, env2, v) = ceval(icx, st1, env1, e)?
    st1 = st2
    env1 = env2
    vals = vals ++ [v]
  }
  Ok((st1, env1, vals))
}

## The dispatcher. Every arm that binds anything is its own function, and that
## is a measured decision about the native backend, not a style: a C function
## reserves one owned slot per local of *every* arm, so the old single-body
## ceval took 3,920 bytes of C stack per activation whichever arm ran, and a
## comptime call nests two to six of them. Split, an activation pays for the
## arm it takes. docs/audit/ceval-trampoline-verdict.md 5.2 has the numbers.
fn ceval(icx: ICx, st0: ESt, env0: Env, e: CExpr) -> ER !io = {
  let (st, env, _) = burn(st0, env0)?
  match e {
    CInt(v) -> Ok((st, env, VInt(v)))
    CFloat(v) -> Ok((st, env, VFloat(v)))
    CBool(v) -> Ok((st, env, VBool(v)))
    CStr(v) -> Ok((st, env, VStr(v)))
    CUnit -> Ok((st, env, VUnit))
    CLocal(sym, _) -> ceval_local(st, env, sym)
    # boxing is a backend's business; every value here is already uniform
    CBox(inner, _) -> ceval(icx, st, env, inner)
    CUnbox(inner, _) -> ceval(icx, st, env, inner)
    CDup(inner, _) -> ceval(icx, st, env, inner)
    # C-only nodes; a token is never observable, so the value is the inner one
    CReset(inner, _) -> ceval(icx, st, env, inner)
    CReuse(_, ctor, _) -> ceval(icx, st, env, ctor)
    CClosure(name, owner, caps, _) -> ceval_closure(icx, st, env, name, owner, caps)
    CFnRef(_, name, _) -> unlifted_fn(st, env, name)
    CCall(callee, args, _, _) -> ceval_call(icx, st, env, callee, args)
    CIntrinsic(name, args, _, _) -> ceval_intrinsic(icx, st, env, name, args)
    CCtor(adt, ci, args, _) -> ceval_ctor(icx, st, env, adt, ci, args)
    CUpdate(base, _, _, fields, _) -> ceval_update(icx, st, env, base, fields)
    CField(target, _, _, idx, _) -> ceval_field(icx, st, env, target, idx)
    CIsCtor(target, _, ci) -> ceval_is_ctor(icx, st, env, target, ci)
    CTagOf(target, _) -> ceval_tag_of(icx, st, env, target)
    CTuple(elems, _) -> ceval_tuple(icx, st, env, elems)
    CTupleGet(target, idx, _) -> ceval_tuple_get(icx, st, env, target, idx)
    CListLit(elems, _) -> ceval_list_lit(icx, st, env, elems)
    CBinary(op, l, r, _) -> eval_binary(icx, st, env, op, l, r)
    CUnary(op, operand, _) -> ceval_unary(icx, st, env, op, operand)
    CIf(cond, thn, els, _) -> ceval_if(icx, st, env, cond, thn, els)
    CBlock(stmts, tail, _) -> ceval_block(icx, st, env, stmts, tail)
    CConstRef(owner, name, _) -> ceval_const_ref(icx, st, env, owner, name)
    CComptime(lo, hi, _) -> ceval_comptime(icx, st, env, lo, hi)
    CReturn(v) -> ceval_return(icx, st, env, v)
    CBreak(id) -> Err((st, env, KBreak(id)))
    CContinue(id) -> Err((st, env, KContinue(id)))
    CForeign(j, _, _) -> eval_java(st, env, j)
    # A dictionary is a value here, the same three ways Core builds one: a
    # statically registered singleton, a construction from its parts', and a
    # part read back out of the one a slot body was handed.
    CDictRef(key, _, _, _) -> ceval_dict_ref(st, env, key)
    CDictApply(key, args, _) -> ceval_dict_apply(icx, st, env, key, args)
    CDictArg(dexpr, _, _, idx, _) -> ceval_dict_arg(icx, st, env, dexpr, idx)
  }
}

fn ceval_local(st: ESt, env: Env, sym: Int) -> ER =
  match map.get(env, sym) {
    Some(v) -> Ok((st, env, v))
    None -> cerr(st, env, "symbol " ++ to_string(sym) ++ " is not bound (interpreter bug)")
  }

fn unlifted_fn(st: ESt, env: Env, name: String) -> ER =
  cerr(st, env, "`" ++ name ++ "` reached comptime unlifted (interpreter bug)")

fn ceval_closure(
  icx: ICx,
  st: ESt,
  env: Env,
  name: String,
  owner: String,
  caps: List[CExpr]
) -> ER !io = {
  let (st1, env1, vals) = eval_all(icx, st, env, caps)?
  let (st2, cf) = get_cfun(icx, st1, env1, owner, name)?
  var cenv: Map[Int, CValue] = map.empty()
  var i = 0
  for p in cf.captures {
    if i < len(vals) { cenv = map.insert(cenv, p.sym, vals[i]) }
    i = i + 1
  }
  Ok((st2, env1, VClosure(owner, name, cenv)))
}

fn ceval_call(icx: ICx, st: ESt, env: Env, callee: CCallee, args: List[CExpr]) -> ER !io = {
  let (st1, env1, vals) = eval_all(icx, st, env, args)?
  match callee {
    CDirect(owner, name) -> call_named(icx, st1, env1, owner, name, vals)
    CDynamic(target) -> ceval_dynamic(icx, st1, env1, target, vals)
    CMethod(dexpr, _, m, idx, _nev) -> ceval_method(icx, st1, env1, dexpr, m, idx, vals)
    CImpl(owner, tid, subject, m) -> call_impl(icx, st1, env1, owner, tid, subject, m, vals)
    CDefault(owner, tid, m) -> call_default(icx, st1, env1, owner, tid, m, vals)
  }
}

fn ceval_dynamic(icx: ICx, st: ESt, env: Env, target: CExpr, vals: List[CValue]) -> ER !io = {
  let (st2, env2, f) = ceval(icx, st, env, target)?
  apply_fn(icx, st2, env2, f, vals)
}

## dispatch: the dictionary names its slot table, the slot names an ordinary
## function, and the dictionary rides along as the trailing argument -- which
## is exactly what the JVM's dictionary class does
fn ceval_method(
  icx: ICx,
  st1: ESt,
  env1: Env,
  dexpr: CExpr,
  m: String,
  idx: Int,
  vals: List[CValue]
) -> ER !io = {
  let (st2, env2, dv) = ceval(icx, st1, env1, dexpr)?
  match dv {
    VDict(key, _) ->
      match map.get(st2.cache.dicts, key) {
        Some(dd) ->
          if idx >= len(dd.slots) {
            cerr(st2, env2, "`" ++ m ++ "` has no slot " ++ to_string(idx))
          } else {
            match dd.slots[idx] {
              CSlotFn(o, n) -> call_named(icx, st2, env2, o, n, vals ++ [dv])
              CSlotDefault(o, _) ->
                match map.get(icx.traits, dd.trait_id) {
                  Some(_) -> call_default(icx, st2, env2, o, dd.trait_id, m, vals ++ [dv])
                  None -> cerr(st2, env2, "unknown trait behind `" ++ m ++ "`")
                }
            }
          }
        None -> cerr(st2, env2, "no dictionary registered for `" ++ key ++ "`")
      }
    _ -> cerr(st2, env2, "`" ++ m ++ "` dispatched on a non-dictionary")
  }
}

fn call_impl(
  icx: ICx,
  st1: ESt,
  env1: Env,
  owner: String,
  tid: Int,
  subject: Ty,
  m: String,
  vals: List[CValue]
) -> ER !io = {
  let frame = FImpl(owner, trait_frame_name(icx, tid), tid, ty_key(subject), m)
  match get_trait_cfun(icx, st1, env1, tid, subject_key(subject), m) {
    Err(err) -> Err(frame_error(err, frame))
    Ok(pair) -> {
      let (st2, cf) = pair
      let no_caps: Map[Int, CValue] = map.empty()
      call_cfun(icx, st2, env1, cf, frame, no_caps, vals)
    }
  }
}

fn ceval_intrinsic(icx: ICx, st: ESt, env: Env, name: String, args: List[CExpr]) -> ER !io = {
  let (st1, env1, vals) = eval_all(icx, st, env, args)?
  call_builtin(icx, st1, env1, name, vals)
}

fn ceval_ctor(icx: ICx, st: ESt, env: Env, adt: Int, ci: Int, args: List[CExpr]) -> ER !io = {
  let (st1, env1, vals) = eval_all(icx, st, env, args)?
  Ok((st1, env1, VAdt(adt, ci, vals)))
}

## Copy and overwrite: a value is immutable here, so the copy is the field
## list, and the result is the one the whole constructor would build.
fn ceval_update(icx: ICx, st: ESt, env: Env, base: CExpr, fields: List[CUpdField]) -> ER !io = {
  let (st1, env1, bv) = ceval(icx, st, env, base)?
  let (st2, env2, vals) = eval_all(icx, st1, env1, update_values(fields))?
  let (aid, ci, kept) = as_adt(bv)
  var out: List[CValue] = []
  var i = 0
  var k = 0
  for f in fields {
    match f.value {
      Some(_) -> {
        out = out ++ [vals[k]]
        k = k + 1
      }
      None -> { out = out ++ [kept[i]] }
    }
    i = i + 1
  }
  Ok((st2, env2, VAdt(aid, ci, out)))
}

fn ceval_field(icx: ICx, st: ESt, env: Env, target: CExpr, idx: Int) -> ER !io = {
  let (st1, env1, v) = ceval(icx, st, env, target)?
  let (_, _, fields) = as_adt(v)
  Ok((st1, env1, fields[idx]))
}

fn ceval_is_ctor(icx: ICx, st: ESt, env: Env, target: CExpr, ci: Int) -> ER !io = {
  let (st1, env1, v) = ceval(icx, st, env, target)?
  let (_, vci, _) = as_adt(v)
  Ok((st1, env1, VBool(vci == ci)))
}

fn ceval_tag_of(icx: ICx, st: ESt, env: Env, target: CExpr) -> ER !io = {
  let (st1, env1, v) = ceval(icx, st, env, target)?
  let (_, vci, _) = as_adt(v)
  Ok((st1, env1, VInt(vci)))
}

fn ceval_tuple(icx: ICx, st: ESt, env: Env, elems: List[CExpr]) -> ER !io = {
  let (st1, env1, vals) = eval_all(icx, st, env, elems)?
  Ok((st1, env1, VTuple(vals)))
}

fn ceval_tuple_get(icx: ICx, st: ESt, env: Env, target: CExpr, idx: Int) -> ER !io = {
  let (st1, env1, v) = ceval(icx, st, env, target)?
  match v {
    VTuple(xs) -> Ok((st1, env1, xs[idx]))
    _ -> cerr(st1, env1, "tuple projection on a non-tuple (interpreter bug)")
  }
}

fn ceval_list_lit(icx: ICx, st: ESt, env: Env, elems: List[CExpr]) -> ER !io = {
  let (st1, env1, vals) = eval_all(icx, st, env, elems)?
  Ok((st1, env1, VList(vals)))
}

fn ceval_unary(icx: ICx, st: ESt, env: Env, op: CUnOp, operand: CExpr) -> ER !io = {
  let (st1, env1, v) = ceval(icx, st, env, operand)?
  match op {
    CNot -> Ok((st1, env1, VBool(not as_bool(v))))
    CNeg ->
      match v {
        VInt(n) -> Ok((st1, env1, VInt(-n)))
        # `-f`, not `0.0 - f`: the subtraction loses the sign of zero
        # (0.0 - 0.0 is +0.0), while the backends emit a true negate
        VFloat(f) -> Ok((st1, env1, VFloat(-f)))
        _ -> cerr(st1, env1, "negation needs a number")
      }
    CBnot ->
      match v {
        VInt(n) -> Ok((st1, env1, VInt(bnot_int(n))))
        _ -> cerr(st1, env1, "`~` needs an Int")
      }
  }
}

fn ceval_if(
  icx: ICx,
  st: ESt,
  env: Env,
  cond: CExpr,
  thn: CExpr,
  els: Option[CExpr]
) -> ER !io = {
  let (st1, env1, cv) = ceval(icx, st, env, cond)?
  if as_bool(cv) {
    ceval(icx, st1, env1, thn)
  } else {
    match els {
      Some(eb) -> ceval(icx, st1, env1, eb)
      None -> Ok((st1, env1, VUnit))
    }
  }
}

fn ceval_block(icx: ICx, st: ESt, env: Env, stmts: List[CStmt], tail: Option[CExpr]) -> ER !io = {
  var st1 = st
  var env1 = env
  for s in stmts {
    let (st2, env2) = exec_cstmt(icx, st1, env1, s)?
    st1 = st2
    env1 = env2
  }
  match tail {
    Some(x) -> ceval(icx, st1, env1, x)
    None -> Ok((st1, env1, VUnit))
  }
}

## Resolved as the emitters resolve it ("" = the body's own module's view,
## otherwise the declaring module's path), against the module the running body
## belongs to rather than the one being folded.
fn ceval_const_ref(icx: ICx, st: ESt, env: Env, owner: String, name: String) -> ER =
  match const_lookup(icx, owner, name) {
    Some(pr) -> {
      let (path, v) = pr
      Ok((note_read(icx, st, path), env, v))
    }
    None -> cerr(note_miss(st), env, const_miss(icx, owner, name))
  }

## Why a constant a body named has no value. It used to be "failed to
## evaluate" every time, with the owner spliced in even when there was none
## (`.B`), which sent a reader looking for an error at `B` when `B` had simply
## not been folded yet: constants fold top to bottom, and a function that
## reads one declared below the constant being folded runs before it exists.
## The checker says that much for a direct reference; this is the same answer
## for one reached through a call.
fn const_miss(icx: ICx, owner: String, name: String) -> String = {
  let own = if owner == "" { icx.body == icx.owner } else { owner == icx.scope.path }
  if own && name == icx.folding {
    "const `" ++ name ++ "` needs its own value to fold"
  } else if own && set.has(icx.pending, name) {
    "const `" ++ name ++ "` is declared later in the file; constants are evaluated top to bottom"
  } else {
    let shown = if owner == "" { name } else { owner ++ "." ++ name }
    "const `" ++ shown ++ "` failed to evaluate"
  }
}

## a comptime block nested in what is being folded: the driver folded it
## first, exactly as codegen would have
fn ceval_comptime(icx: ICx, st: ESt, env: Env, lo: Int, hi: Int) -> ER =
  match map.get(icx.blocks, (lo, hi)) {
    Some(v) -> Ok((st, env, v))
    None -> cerr(st, env, "a nested comptime block did not fold")
  }

fn ceval_return(icx: ICx, st: ESt, env: Env, v: Option[CExpr]) -> ER !io =
  match v {
    Some(x) -> {
      let (st1, env1, rv) = ceval(icx, st, env, x)?
      Err((st1, env1, KReturn(rv)))
    }
    None -> Err((st, env, KReturn(VUnit)))
  }

fn ceval_dict_ref(st: ESt, env: Env, key: String) -> ER = {
  let no_args: List[CValue] = []
  Ok((st, env, VDict(key, no_args)))
}

fn ceval_dict_apply(icx: ICx, st: ESt, env: Env, key: String, args: List[CExpr]) -> ER !io = {
  let (st1, env1, vals) = eval_all(icx, st, env, args)?
  Ok((st1, env1, VDict(key, vals)))
}

fn ceval_dict_arg(icx: ICx, st: ESt, env: Env, dexpr: CExpr, idx: Int) -> ER !io = {
  let (st1, env1, dv) = ceval(icx, st, env, dexpr)?
  match dv {
    VDict(_, args) ->
      if idx < len(args) {
        Ok((st1, env1, args[idx]))
      } else {
        cerr(st1, env1, "dictionary argument " ++ to_string(idx) ++ " is missing")
      }
    _ -> cerr(st1, env1, "dictionary argument read from a non-dictionary")
  }
}

## Two's-complement bitwise not, spelled with xor so the interpreter does not
## depend on its own host `~`.
fn bnot_int(n: Int) -> Int = -1 ^ n

## Ord[String] by hand -- code point order, sign only (spec 3.5) -- so a
## folded `"a" < "b"` does not ride on the host's own String `<`, which for
## one bootstrap step is still the seed compiler's order.
fn str_cmp_cp(a: String, b: String) -> Int = {
  let xs = code_points(a)
  let ys = code_points(b)
  var i = 0
  while i < len(xs) && i < len(ys) {
    if xs[i] != ys[i] { return if xs[i] < ys[i] { -1 } else { 1 } }
    i = i + 1
  }
  if len(xs) < len(ys) { -1 } else if len(xs) > len(ys) { 1 } else { 0 }
}

fn eval_binary(icx: ICx, st: ESt, env: Env, op: CBinOp, l: CExpr, r: CExpr) -> ER !io = {
  if op == CAnd || op == COr {
    let (st1, env1, lv) = ceval(icx, st, env, l)?
    let lb = as_bool(lv)
    if op == CAnd && not lb { return Ok((st1, env1, VBool(false))) }
    if op == COr && lb { return Ok((st1, env1, VBool(true))) }
    return ceval(icx, st1, env1, r)
  }
  let (st1, env1, lv) = ceval(icx, st, env, l)?
  let (st2, env2, rv) = ceval(icx, st1, env1, r)?
  if op == CAdd || op == CSub || op == CMul || op == CDiv || op == CMod {
    return arith(st2, env2, op, lv, rv)
  }
  if op == CBand || op == CBor || op == CBxor || op == CShl || op == CShr || op == CUshr {
    return bitwise(st2, env2, op, lv, rv)
  }
  if op == CConcat {
    match lv {
      VStr(a) ->
        match rv {
          VStr(b) -> {
            # a String concat copies both sides, so it pays for the result
            let (st3, _, _) = burn_n(st2, env2, str.len(a) + str.len(b))?
            return Ok((st3, env2, VStr(a ++ b)))
          }
          _ -> ()
        }
      VList(a) ->
        match rv {
          VList(b) -> {
            # a List concat appends the right side onto the shared left one
            # (spec §2.2), so the right side is what it allocates
            let (st3, _, _) = burn_n(st2, env2, len(b))?
            return Ok((st3, env2, VList(a ++ b)))
          }
          _ -> ()
        }
      _ -> ()
    }
    return cerr(st2, env2, "`++` needs two Strings or two Lists")
  }
  if op == CEq || op == CNe {
    let same = eq_or_refuse(st2, env2, lv, rv)?
    return Ok((st2, env2, VBool(if op == CEq { same } else { not same })))
  }
  # Ordered comparisons. A Float is the one operand handled here rather than
  # in `order`: it is not Ord (types.ord_scalars), so only these operators
  # compare it, and NaN makes all four of them false rather than giving it a
  # place in an order.
  match lv {
    VFloat(a) -> {
      let b = match rv {
        VFloat(x) -> x
        _ -> panic("comptime interpreter bug: mixed comparison")
      }
      # NaN: every ordered comparison is false (spec §4.3). `x != x` is the
      # IEEE NaN test, and Dawn's Float `!=` is IEEE.
      if a != a || b != b { return Ok((st2, env2, VBool(false))) }
      # IEEE ordering, not Double.compare: the latter puts -0.0 below 0.0,
      # which folded `-0.0 < 0.0` to true while both backends answer false
      let c = if a < b { -1 } else if a > b { 1 } else { 0 }
      return Ok((st2, env2, VBool(holds(op, c))))
    }
    _ -> ()
  }
  let c = order(st2, env2, lv, rv)?
  Ok((st2, env2, VBool(holds(op, c))))
}

fn holds(op: CBinOp, c: Int) -> Bool =
  if op == CLt {
    c < 0
  } else if op == CLe {
    c <= 0
  } else if op == CGt {
    c > 0
  } else {
    c >= 0
  }

## The sign of comparing two values of one orderable scalar type. It answers
## both the ordered operators on those scalars and the `cmp` intrinsic, which
## is what lowering makes of the prelude `Ord` at a scalar: inside `list.sort`
## and `list.max`, at each field of a derived `Ord`, and for `<` on a tuple or
## a list. One function for both, so a fold cannot order a pair one way
## through `<` and the other way through `list.sort`, and the answer is a sign,
## as `dawn_cmp_*` and the JVM's scalar comparison return.
fn order(st: ESt, env: Env, lv: CValue, rv: CValue) -> Result[Int, (ESt, Env, Ctl)] =
  match lv {
    VInt(a) -> {
      let b = as_int(rv)
      Ok(if a < b { -1 } else if a > b { 1 } else { 0 })
    }
    # Spelled as an explicit code point walk, not `a < b`: the host `<` here
    # is whatever the *seed* compiler emitted, so a fold through it would
    # answer with the previous generation's order for one bootstrap step.
    # Written out, the fold answers spec 4.3's code point order on the first
    # build (RP-12: interp and intrinsics must give one answer).
    VStr(a) -> Ok(str_cmp_cp(a, as_str(rv)))
    # false < true, the order Ord[Bool] gives (types.ord_scalars)
    VBool(a) -> {
      let b = as_bool(rv)
      Ok(if a == b { 0 } else if a { 1 } else { -1 })
    }
    VUnit -> Ok(0)
    # Cursor's own Ord impl compares the positions it sees as Ints, and that
    # is where the interpreter's positions arrive
    VCursor(x, a) ->
      match rv {
        VCursor(y, b) ->
          if x != y {
            cross_text(st, env)
          } else {
            Ok(if a < b { -1 } else if a > b { 1 } else { 0 })
          }
        _ -> panic("comptime interpreter bug: mixed comparison")
      }
    _ -> match cerr(st, env, "cannot order these values") {
      Err(e) -> Err(e)
      Ok(_) -> panic("unreachable")
    }
  }

fn arith(st: ESt, env: Env, op: CBinOp, lv: CValue, rv: CValue) -> ER =
  match lv {
    VInt(a) ->
      match rv {
        VInt(b) ->
          if op == CAdd {
            Ok((st, env, VInt(a + b)))
          } else if op == CSub {
            Ok((st, env, VInt(a - b)))
          } else if op == CMul {
            Ok((st, env, VInt(a * b)))
          } else if op == CDiv {
            if b == 0 {
              cerr(st, env, "panicked: Int division by zero")
            } else {
              Ok((st, env, VInt(a / b)))
            }
          } else {
            if b == 0 {
              cerr(st, env, "panicked: Int modulo by zero")
            } else {
              Ok((st, env, VInt(a % b)))
            }
          }
        _ -> cerr(st, env, "arithmetic needs two numbers of the same type")
      }
    VFloat(a) ->
      match rv {
        VFloat(b) ->
          if op == CAdd {
            Ok((st, env, VFloat(a + b)))
          } else if op == CSub {
            Ok((st, env, VFloat(a - b)))
          } else if op == CMul {
            Ok((st, env, VFloat(a * b)))
          } else if op == CDiv {
            Ok((st, env, VFloat(a / b)))
          } else {
            Ok((st, env, VFloat(a % b)))
          }
        _ -> cerr(st, env, "arithmetic needs two numbers of the same type")
      }
    _ -> cerr(st, env, "arithmetic needs two numbers of the same type")
  }

fn bitwise(st: ESt, env: Env, op: CBinOp, lv: CValue, rv: CValue) -> ER =
  match lv {
    VInt(a) ->
      match rv {
        VInt(b) -> {
          let r = if op == CBand {
            a & b
          } else if op == CBor {
            a | b
          } else if op == CBxor {
            a ^ b
          } else if op == CShl {
            a << b
          } else if op == CShr {
            a >> b
          } else {
            a >>> b
          }
          Ok((st, env, VInt(r)))
        }
        _ -> cerr(st, env, "bitwise operators need two Ints")
      }
    _ -> cerr(st, env, "bitwise operators need two Ints")
  }

# ---- statements ----

fn exec_cstmt(icx: ICx, st0: ESt, env0: Env, s: CStmt) -> SR !io = {
  let (st, env, _) = burn(st0, env0)?
  match s {
    CSLet(sym, _, init) -> {
      let (st1, env1, v) = ceval(icx, st, env, init)?
      Ok((st1, map.insert(env1, sym, v)))
    }
    CSAssign(sym, value) -> {
      let (st1, env1, v) = ceval(icx, st, env, value)?
      Ok((st1, map.insert(env1, sym, v)))
    }
    CSDiscard(e) -> {
      let (st1, env1, _) = ceval(icx, st, env, e)?
      Ok((st1, env1))
    }
    CSIf(cond, thn, els) -> {
      let (st1, env1, cv) = ceval(icx, st, env, cond)?
      if as_bool(cv) {
        let (st2, env2, _) = ceval(icx, st1, env1, thn)?
        Ok((st2, env2))
      } else {
        match els {
          Some(eb) -> {
            let (st2, env2, _) = ceval(icx, st1, env1, eb)?
            Ok((st2, env2))
          }
          None -> Ok((st1, env1))
        }
      }
    }
    CSLoop(loop_id, body, step) -> exec_loop(icx, st, env, loop_id, body, step)
    # reference counting is a native-backend concern; these values are
    # ordinary Dawn values
    CSDrop(_) -> Ok((st, env))
  }
}

## Core's only loop: unconditional, left through a break naming it or a
## return. `step` runs on the way round, including after a `continue` -- it
## carries a `for`'s increment, which the body's end would otherwise skip.
fn exec_loop(
  icx: ICx,
  st: ESt,
  env: Env,
  loop_id: Int,
  body: CExpr,
  step: Option[CExpr]
) -> SR !io = {
  var st1 = st
  var env1 = env
  var go = true
  while go {
    let (stb, envb, _) = burn(st1, env1)?
    st1 = stb
    env1 = envb
    var stepping = true
    match ceval(icx, st1, env1, body) {
      Ok(t) -> {
        let (st2, env2, _) = t
        st1 = st2
        env1 = env2
      }
      Err(t) -> {
        let (st2, env2, ctl) = t
        st1 = st2
        env1 = env2
        match ctl {
          KBreak(id) ->
            if id == loop_id {
              go = false
              stepping = false
            } else {
              return Err((st1, env1, ctl))
            }
          KContinue(id) -> if id != loop_id { return Err((st1, env1, ctl)) }
          _ -> return Err((st1, env1, ctl))
        }
      }
    }
    if stepping {
      match step {
        Some(sx) -> {
          let (st3, env3, _) = ceval(icx, st1, env1, sx)?
          st1 = st3
          env1 = env3
        }
        None -> ()
      }
    }
  }
  Ok((st1, env1))
}

# ---- the module driver ----

## Accumulated results of one module's comptime evaluation: diagnostics,
## const values by name, comptime-block values by (lo, hi) span.
pub type CtOut = {
  diags: List[Diag],
  consts: Map[String, CValue],
  blocks: Map[(Int, Int), CValue],
  # The other modules, by path, whose bodies or constants the run read, and
  # whether some lookup into another module found nothing. Together they
  # bound what the result depends on beyond the module's own input: an
  # analysis that remembers this step may keep it while none of these
  # modules changed, and never once `missed` is set and anything before it
  # did (driver/incremental).
  reads: Set[String],
  missed: Bool
}

## One module's evaluation in progress: what it has produced, and what
## lowering has produced for it. The second half is not part of `CtOut`
## because nothing downstream of comptime wants it. Driver, emitter and `doc`
## all keep a `CtOut` per module for the length of the build, and the lowered
## bodies would ride along there for no reader.
pub(pkg) type CtRun = {
  out: CtOut,
  cache: LowerCache
}

fn empty_cache() -> LowerCache = {
  let no_fns: Map[String, CFun] = map.empty()
  let no_dicts: Map[String, CDictDef] = map.empty()
  let no_lits: Map[String, CValue] = map.empty()
  LowerCache { fns: no_fns, dicts: no_dicts, next_lam: 0, reads: set.empty(), missed: false,
    lits: no_lits }
}

## An evaluation seeded from what the module has lowered so far. Fuel and
## depth start over here and nowhere else, which is what keeps one const's
## budget from being spent by the one before it.
fn st_from(fuel: Int, cache: LowerCache) -> ESt =
  ESt { fuel: fuel, depth: 0, cache: cache, texts: no_texts() }

fn fresh_st(fuel: Int) -> ESt = st_from(fuel, empty_cache())

## Lower one expression and run it. Every comptime evaluation goes through
## here, so lowering and interpretation are always the same pair. The cache
## goes in and comes back out. The expression's own body is lowered fresh,
## since no two initializers are the same expression; every function it
## reached stays lowered for the next one.
fn fold_expr(
  icx: ICx,
  fuel: Int,
  cache: LowerCache,
  e: TExpr,
  lo: Int,
  hi: Int
) -> (LowerCache, Result[CValue, Diag]) !io = {
  let env: Env = map.empty()
  let (ce, lifted, dicts, next) =
    lower.lower_expr_in(icx.owner, e, icx.traits, icx.impls, icx.adts,
      icx.prog_fns, icx.syms, icx.intrs, cache.next_lam)
  var tbl = cache.fns
  for lf in lifted { tbl = map.insert(tbl, lf.owner ++ "." ++ lf.name, lf) }
  var dts = cache.dicts
  for d in dicts { dts = map.insert(dts, d.key, d) }
  let st = st_from(fuel, LowerCache { ..cache, fns: tbl, dicts: dts, next_lam: next })
  match ceval(icx, st, env, ce) {
    Ok(r) -> {
      let (st1, _, v) = r
      (st1.cache, Ok(v))
    }
    Err(r) -> {
      let (st1, _, ctl) = r
      # a failure here is the interpreter refusing, not lowering failing:
      # invariant panics in lowering propagate (ARC-06). So what was lowered
      # on the way is still valid, and is kept
      match ctl {
        KErr(failure) -> (st1.cache, Err(failure_diag(failure, lo, hi)))
        _ -> (st1.cache, Err(failure_diag(
          ct_failure("control flow escaped the folded expression (interpreter bug)", ""), lo, hi)))
      }
    }
  }
}

## The cache key of a block the checker inserted for a literal, or None. The
## Float is keyed by its rendering, which tells `-0.0` from `0.0`; a literal
## is never a NaN.
fn lit_fold_key(body: TExpr) -> Option[String] =
  match body {
    XCallFn(_, _, args, _, _, Some(tid), _, _, _, ty) ->
      if tid != FROM_INT_ID && tid != FROM_FLOAT_ID {
        None
      } else {
        let k = to_string(tid) ++ ":" ++ ty_key_inst(ty) ++ ":"
        match args[0] {
          XInt(v, _, _) -> Some(k ++ to_string(v))
          XFloat(v, _, _) -> Some(k ++ to_string(v))
          _ -> None
        }
      }
    _ -> None
  }

fn eval_block(icx: ICx, fuel: Int, body: TExpr, run: CtRun, lo: Int, hi: Int) -> CtRun !io = {
  let key = lit_fold_key(body)
  match key {
    Some(k) ->
      match map.get(run.cache.lits, k) {
        Some(v) -> return CtRun { ..run, out: CtOut { ..run.out, blocks: map.insert(run.out.blocks, (lo, hi), v) } }
        None -> ()
      }
    None -> ()
  }
  let r0 = fold_block(icx, fuel, body, run, lo, hi)
  match key {
    Some(k) ->
      match map.get(r0.out.blocks, (lo, hi)) {
        Some(v) -> CtRun { ..r0, cache: LowerCache { ..r0.cache, lits: map.insert(r0.cache.lits, k, v) } }
        None -> r0
      }
    None -> r0
  }
}

fn fold_block(icx: ICx, fuel: Int, body: TExpr, run: CtRun, lo: Int, hi: Int) -> CtRun !io = {
  # a block nested inside this one folds first, so lowering's reference to it
  # resolves
  let run1 = walk_expr(icx, fuel, body, run)
  let icx1 = ICx { ..icx, blocks: run1.out.blocks }
  let (cache, r) = fold_expr(icx1, fuel, run1.cache, body, lo, hi)
  match r {
    Ok(v) ->
      CtRun {
        out: CtOut { ..run1.out, blocks: map.insert(run1.out.blocks, (lo, hi), v) },
        cache: cache
      }
    Err(d) ->
      CtRun { out: CtOut { ..run1.out, diags: run1.out.diags ++ [lit_fold_diag(icx, body, d)] },
        cache: cache }
  }
}

## A fold the checker inserted for a literal fails in the literal's words
## (literal-system-design D6): `the literal `300` cannot be a `U8`: <why>`.
## No marker on the node is needed to know it is one: `from_int` and
## `from_float` are not injected, so no source can spell a call to either, and
## a comptime body that is exactly such a call came from a literal.
fn lit_fold_diag(icx: ICx, body: TExpr, d: Diag) -> Diag =
  match body {
    XCallFn(_, _, args, _, _, Some(tid), _, _, _, ty) ->
      if tid != FROM_INT_ID && tid != FROM_FLOAT_ID {
        d
      } else {
        let text = match args[0] {
          XInt(v, _, _) -> to_string(v)
          XFloat(v, _, _) -> to_string(v)
          _ -> "?"
        }
        let why = if str.starts_with(d.msg, "comptime: panicked: ") { str.drop(d.msg, 20) } else { d.msg }
        Diag { ..d, msg: "the literal `" ++ text ++ "` cannot be a `" ++ ty_show(icx.adts, ty) ++ "`: " ++ why,
          hint: "" }
      }
    _ -> d
  }

## Find comptime blocks in a checked body and evaluate each with a fresh fuel
## budget. This walk stays on TAST: it is a search for a syntactic form, not
## an evaluation, and by the time Core exists lowering has already replaced
## the form with a reference to its value.
fn walk_expr(icx: ICx, fuel: Int, e: TExpr, acc: CtRun) -> CtRun !io =
  match e {
    XComptime(body, lo, hi, ..) -> eval_block(icx, fuel, body, acc, lo, hi)
    XStr(parts, _, _) -> {
      var acc1 = acc
      for p in parts {
        match p {
          TSPInterp(x, _) -> { acc1 = walk_expr(icx, fuel, x, acc1) }
          TSPText(_) -> ()
        }
      }
      acc1
    }
    XLambda(_, _, body, ..) -> walk_expr(icx, fuel, body, acc)
    XApply(target, args, ..) -> {
      var acc1 = walk_expr(icx, fuel, target, acc)
      for a in args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XJava(jc, ..) -> {
      var acc1 = acc
      match jc.target {
        Some(t) -> { acc1 = walk_expr(icx, fuel, t, acc1) }
        None -> ()
      }
      for a in jc.args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XPropagate(operand, ..) -> walk_expr(icx, fuel, operand, acc)
    XUnwrap(operand, ..) -> walk_expr(icx, fuel, operand, acc)
    XReturn(v, _, _) ->
      match v {
        Some(x) -> walk_expr(icx, fuel, x, acc)
        None -> acc
      }
    XIndex(target, index, ..) ->
      walk_expr(icx, fuel, index, walk_expr(icx, fuel, target, acc))
    XCallDyn(_, _, args, ..) -> {
      var acc1 = acc
      for a in args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XCallBuiltin(_, args, ..) -> {
      var acc1 = acc
      for a in args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XCallFn(_, _, args, ..) -> {
      var acc1 = acc
      for a in args { acc1 = walk_expr(icx, fuel, a, acc1) }
      acc1
    }
    XCtor(_, _, written, _, spread, ..) -> {
      var acc1 = acc
      match spread {
        Some(sp) -> { acc1 = walk_expr(icx, fuel, sp, acc1) }
        None -> ()
      }
      for w in written { acc1 = walk_expr(icx, fuel, w, acc1) }
      acc1
    }
    XField(target, ..) -> walk_expr(icx, fuel, target, acc)
    XListLit(elems, ..) -> {
      var acc1 = acc
      for x in elems {
        match x {
          TLEExpr(e) -> { acc1 = walk_expr(icx, fuel, e, acc1) }
          TLESpread(e) -> { acc1 = walk_expr(icx, fuel, e, acc1) }
          TLEIf(arms) -> {
            for a in arms {
              acc1 = walk_expr(icx, fuel, a.body, walk_expr(icx, fuel, a.cond, acc1))
            }
          }
        }
      }
      acc1
    }
    XTupleLit(elems, ..) -> {
      var acc1 = acc
      for x in elems { acc1 = walk_expr(icx, fuel, x, acc1) }
      acc1
    }
    XBinary(_, l, r, ..) -> walk_expr(icx, fuel, r, walk_expr(icx, fuel, l, acc))
    XUnary(_, operand, ..) -> walk_expr(icx, fuel, operand, acc)
    XIf(cond, thn, els, ..) -> {
      var acc1 = walk_expr(icx, fuel, thn, walk_expr(icx, fuel, cond, acc))
      match els {
        Some(eb) -> walk_expr(icx, fuel, eb, acc1)
        None -> acc1
      }
    }
    XMatch(scrut, arms, ..) -> {
      var acc1 = walk_expr(icx, fuel, scrut, acc)
      for arm in arms {
        match arm.guard {
          Some(g) -> { acc1 = walk_expr(icx, fuel, g, acc1) }
          None -> ()
        }
        acc1 = walk_expr(icx, fuel, arm.body, acc1)
      }
      acc1
    }
    XBlock(stmts, tail, ..) -> {
      var acc1 = acc
      for s in stmts { acc1 = walk_stmt(icx, fuel, s, acc1) }
      match tail {
        Some(x) -> walk_expr(icx, fuel, x, acc1)
        None -> acc1
      }
    }
    _ -> acc
  }

fn walk_stmt(icx: ICx, fuel: Int, s: TStmt, acc: CtRun) -> CtRun !io =
  match s {
    TSLet(_, _, init, _, _) -> walk_expr(icx, fuel, init, acc)
    TSLetPat(_, init, _, _) -> walk_expr(icx, fuel, init, acc)
    TSLocalFn(_, _, _, _, body, _, _, _) -> walk_expr(icx, fuel, body, acc)
    TSAssign(_, _, value, _, _) -> walk_expr(icx, fuel, value, acc)
    TSExpr(e, _, _) -> walk_expr(icx, fuel, e, acc)
    TSAssert(cond, _, _, _) -> walk_expr(icx, fuel, cond, acc)
    TSWhile(cond, body, _, _, _) -> walk_expr(icx, fuel, body, walk_expr(icx, fuel, cond, acc))
    TSFor(_, _, from, to_opt, _, body, _, _, _) -> {
      var acc1 = walk_expr(icx, fuel, from, acc)
      match to_opt {
        Some(t) -> { acc1 = walk_expr(icx, fuel, t, acc1) }
        None -> ()
      }
      walk_expr(icx, fuel, body, acc1)
    }
  }

## The direct-function signature table lowering needs while evaluating one
## module. `by_owner` contains every previously loaded std module; the current
## module has not yet joined it, so its checked direct functions are added
## explicitly. The predicate is repeated defensively on `by_owner`: production
## builds it through `note_direct_fn`, but accepting a method body here would
## make this boundary lossy again for any other caller. Package-private for
## ir/interp_test (docs/unused-imports-design.md §4).
pub(pkg) fn program_sigs(
  by_owner: Map[String, Map[String, TFun]],
  tm: TModule,
  owner: String
) -> Map[(String, String), Sig] = {
  var out: Map[(String, String), Sig] = map.empty()
  for o in map.keys(by_owner) {
    let tbl = map.get(by_owner, o).expect("owner table")
    for pr in map.entries(tbl) {
      let (name, f) = pr
      if is_direct_fn(f) { out = map.insert(out, (o, name), f.sig) }
    }
  }
  for f in tm.fns {
    if is_direct_fn(f) { out = map.insert(out, (owner, f.name), f.sig) }
  }
  out
}

## Evaluate all comptime constructs of a checked module: consts in declaration
## order (each gets a fresh fuel budget), then comptime blocks in function and
## test bodies. Failures become ordinary diagnostics.
##
## Callers get the results only. The lowering cache the run accumulated is
## dropped here, which is the whole of its lifetime: module in, module out.
pub fn eval_comptime(
  tm: TModule,
  std_fns: Map[String, TFun],
  by_owner: Map[String, Map[String, TFun]],
  std_impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  adts: Adts,
  traits: Traits,
  impls: Impls,
  owner: String,
  opts: CtOpts
) -> CtOut !io =
  eval_comptime_in(tm, ct_world_empty(), alone(owner), std_fns, by_owner, std_impl_fns,
    std_names, adts, traits, impls, owner, opts)

## The scope of a module that imports no constants, filed under its owner.
fn alone(owner: String) -> ConstScope = {
  let none: Map[String, String] = map.empty()
  ConstScope { path: owner, imported: none, renames: none }
}

## The same, for a module in a program: `world` holds the modules analyzed
## before it, whose functions and constants its comptime may use, and `scope`
## says how this module names constants.
pub fn eval_comptime_in(
  tm: TModule,
  world: CtWorld,
  scope: ConstScope,
  std_fns: Map[String, TFun],
  by_owner: Map[String, Map[String, TFun]],
  std_impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  adts: Adts,
  traits: Traits,
  impls: Impls,
  owner: String,
  opts: CtOpts
) -> CtOut !io =
  eval_module_in(tm, world, scope, std_fns, by_owner, std_impl_fns, std_names, adts, traits,
    impls, owner, opts).out

## The same run, with the cache still attached. Only this module's tests have
## a reason to look at it: from the outside, whether two consts shared a
## lowered body is not observable, and that is the point. It is package-private
## rather than private because those tests live in ir/interp_test
## (docs/unused-imports-design.md §4).
pub(pkg) fn eval_module(
  tm: TModule,
  std_fns: Map[String, TFun],
  by_owner: Map[String, Map[String, TFun]],
  std_impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  adts: Adts,
  traits: Traits,
  impls: Impls,
  owner: String,
  opts: CtOpts
) -> CtRun !io =
  eval_module_in(tm, ct_world_empty(), alone(owner), std_fns, by_owner, std_impl_fns,
    std_names, adts, traits, impls, owner, opts)

## The context every fold in one module starts from: the module's own
## functions over std's, the owner each flat name came from, the signature and
## impl tables lowering consults, and the world before the module. Nothing in
## it depends on what the module has folded so far; the run fills `consts` and
## `blocks` in as it goes, and `eval_closed` with what a finished run produced.
## One assembly for both, so an expression folded for an editor resolves a
## call the way the same expression in a `comptime` block would.
fn module_icx(
  tm: TModule,
  world: CtWorld,
  scope: ConstScope,
  std_fns: Map[String, TFun],
  std_owners: Map[String, Map[String, TFun]],
  std_impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  adts: Adts,
  traits: Traits,
  impls: Impls,
  owner: String,
  depth: Int
) -> ICx = {
  # std is implicitly visible, so a const may call it; a local definition
  # still shadows it, matching the checker's local → std → builtin order
  var fns = std_fns
  for f in tm.fns { fns = note_direct_fn(fns, f) }
  # the owner each flat name came from, so a std function lowered on demand
  # resolves its own module's calls before falling back
  var owner_of: Map[String, String] = map.empty()
  for o in map.keys(std_owners) {
    let tbl = map.get(std_owners, o).expect("owner table")
    for n in map.keys(tbl) { owner_of = map.insert(owner_of, n, o) }
  }
  for f in tm.fns {
    if is_direct_fn(f) { owner_of = map.insert(owner_of, f.name, owner) }
  }
  # The modules before this one are found by owner, in `world.owners`, after
  # std's (`find_fn`). A call into one of them is always qualified by the
  # time it is Core (`CDirect(owner, name)`), so the flat table, which is the
  # fallback for std's unqualified prelude, stays std's and this module's:
  # two modules may each define `helper`. Their impl bodies likewise stay in
  # `world.impl_fns`, read after `impl_fns` (`get_trait_cfun`); coherence
  # makes that key unique program-wide. Neither is merged here, which would
  # cost every module a walk over every module before it.
  var prog_fns = world.sigs
  if map.len(prog_fns) == 0 {
    # a run with no world (std's own tests, the interpreter's) names its
    # tables directly
    prog_fns = program_sigs(std_owners, tm, owner)
  } else {
    for f in tm.fns {
      if is_direct_fn(f) { prog_fns = map.insert(prog_fns, (owner, f.name), f.sig) }
    }
  }
  # this module's own impl methods and trait defaults join std's
  var impl_fns = std_impl_fns
  for f in tm.fns { impl_fns = note_trait_fn(impl_fns, owner, f) }
  let no_consts: Map[String, CValue] = map.empty()
  let no_blocks: Map[(Int, Int), CValue] = map.empty()
  ICx {
    fns: fns,
    by_owner: std_owners,
    owner_of: owner_of,
    std_names: std_names,
    adts: adts,
    consts: no_consts,
    blocks: no_blocks,
    owner: owner,
    traits: traits,
    impls: impls,
    prog_fns: prog_fns,
    impl_fns: impl_fns,
    syms: tm.syms,
    world: world,
    scope: scope,
    body: owner,
    max_depth: depth,
    pending: set.empty(),
    folding: "",
    intrs: intrinsics()
  }
}

fn eval_module_in(
  tm: TModule,
  world: CtWorld,
  scope: ConstScope,
  std_fns: Map[String, TFun],
  std_owners: Map[String, Map[String, TFun]],
  std_impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  adts: Adts,
  traits: Traits,
  impls: Impls,
  owner: String,
  opts: CtOpts
) -> CtRun !io = {
  let fuel = opts.fuel
  let empty_c: Map[String, CValue] = map.empty()
  let empty_b: Map[(Int, Int), CValue] = map.empty()
  var run = CtRun {
    out: CtOut { diags: [], consts: empty_c, blocks: empty_b, reads: set.empty(), missed: false },
    cache: empty_cache()
  }
  let base = module_icx(tm, world, scope, std_fns, std_owners, std_impl_fns, std_names, adts,
    traits, impls, owner, opts.depth)
  var pending: Set[String] = set.empty()
  for c in tm.consts { pending = set.insert(pending, c.name) }
  for c in tm.consts {
    pending = set.remove(pending, c.name)
    let base_c = ICx { ..base, pending: pending, folding: c.name }
    # a comptime block inside the initializer folds first
    run = walk_expr(ICx { ..base_c, consts: run.out.consts, blocks: run.out.blocks },
      fuel, c.init, run)
    let icx = ICx { ..base_c, consts: run.out.consts, blocks: run.out.blocks }
    let (cache, r) = fold_expr(icx, fuel, run.cache, c.init, c.lo, c.hi)
    match r {
      Ok(v) -> {
        run = CtRun {
          out: CtOut { ..run.out, consts: map.insert(run.out.consts, c.name, v) },
          cache: cache
        }
      }
      Err(d) -> {
        run = CtRun { out: CtOut { ..run.out, diags: run.out.diags ++ [d] }, cache: cache }
      }
    }
  }
  for f in tm.fns {
    run = walk_expr(ICx { ..base, consts: run.out.consts, blocks: run.out.blocks },
      fuel, f.body, run)
  }
  for t in tm.tests {
    run = walk_expr(ICx { ..base, consts: run.out.consts, blocks: run.out.blocks },
      fuel, t.body, run)
  }
  CtRun { ..run, out: CtOut { ..run.out, reads: run.cache.reads, missed: run.cache.missed } }
}

## Fold one closed expression of a checked module, outside any `comptime`
## block: what an editor shows for the expression under the cursor
## (docs/lsp-hover-design.md, C5). `e` must name nothing bound outside itself
## and call nothing with an effect; the caller decides that, since only it has
## the source positions to decide by. The rest of the context is the one the
## module's own run had (`module_icx`): its functions, the world before it,
## and, from `ct`, the constants and comptime blocks that run folded. So `e`
## means here what it would mean inside a `comptime` block in that module.
##
## The budget is the caller's (`ct_hover` for an editor), and every way the
## fold can fail comes back as `Err(reason)`: the reason is one line, without
## the `comptime: ` prefix a build diagnostic carries. That includes a panic.
## Lowering reports a broken invariant by panicking (ARC-06), and so does the
## interpreter, and in a build that is right: the compiler stops. Here the
## process is a language server, and one hover must not take it down, so the
## whole fold runs under `catch_panic`. It is the second line, not the
## first: a module with errors holds `XError`, which lowering refuses by
## panicking, so a caller folds only in a module that checked clean, as the
## build does. The barrier is for whatever that rule does not foresee.
##
## Nothing is kept. The lowering cache starts empty and is dropped, so one
## fold cannot change what the next one sees.
pub(pkg) fn eval_closed(
  tm: TModule,
  world: CtWorld,
  scope: ConstScope,
  ct: CtOut,
  std_fns: Map[String, TFun],
  std_owners: Map[String, Map[String, TFun]],
  std_impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  adts: Adts,
  traits: Traits,
  impls: Impls,
  owner: String,
  e: TExpr,
  opts: CtOpts
) -> Result[CValue, String] !io =
  eval_closed_in(closed_icx(tm, world, scope, ct, std_fns, std_owners, std_impl_fns, std_names, adts,
    traits, impls, owner, opts), e, opts)

## The context `eval_closed` folds in, for a caller with several expressions
## of one module to fold (the left-out defaults of an inlay request, §C4).
## Building it walks every std function's owner table, which is most of what
## a small fold costs, so such a caller builds it once. It is a value, and no
## fold changes it: what is shared is only what every fold would have built
## the same.
pub(pkg) fn closed_icx(
  tm: TModule,
  world: CtWorld,
  scope: ConstScope,
  ct: CtOut,
  std_fns: Map[String, TFun],
  std_owners: Map[String, Map[String, TFun]],
  std_impl_fns: Map[(Int, String, String), (String, TFun)],
  std_names: Set[String],
  adts: Adts,
  traits: Traits,
  impls: Impls,
  owner: String,
  opts: CtOpts
) -> ICx = {
  let base = module_icx(tm, world, scope, std_fns, std_owners, std_impl_fns, std_names, adts,
    traits, impls, owner, opts.depth)
  ICx { ..base, consts: ct.consts, blocks: ct.blocks }
}

## `eval_closed` in a context `closed_icx` built: the fold and its barrier.
## The lowering cache still starts empty for each fold.
pub(pkg) fn eval_closed_in(icx: ICx, e: TExpr, opts: CtOpts) -> Result[CValue, String] !io = {
  match catch_panic(() => fold_expr(icx, opts.fuel, empty_cache(), e, 0, 0)) {
    Ok(pr) -> {
      let (_, r) = pr
      match r {
        Ok(v) -> Ok(v)
        Err(d) -> Err(closed_reason(d.msg))
      }
    }
    Err(fault) -> Err("panic: " ++ first_line(fault.message))
  }
}

fn closed_reason(msg: String) -> String = {
  let first = first_line(msg)
  match str.strip_prefix(first, "comptime: ") {
    Some(r) -> r
    None -> first
  }
}

fn first_line(s: String) -> String =
  match str.split_once(s, "\n") {
    Some(pr) -> {
      let (a, _) = pr
      a
    }
    None -> s
  }

# ---- tests ----

# ---- the intrinsic gate (audit RP-12) ----

## An interpreter context with nothing in it, for asking `call_builtin` a
## question. The prelude tables come from the checker because two arms read
## `icx.adts` to find `Option`; everything else an arm could reach is empty,
## and no probe gets far enough to look.
fn probe_icx() -> ICx = {
  let cx = cx_new(None, None)
  let no_fns: Map[String, TFun] = map.empty()
  let no_owner: Map[String, Map[String, TFun]] = map.empty()
  let no_owner_of: Map[String, String] = map.empty()
  let no_consts: Map[String, CValue] = map.empty()
  let no_blocks: Map[(Int, Int), CValue] = map.empty()
  let no_syms: Map[Int, Sym] = map.empty()
  ICx {
    fns: no_fns,
    by_owner: no_owner,
    owner_of: no_owner_of,
    std_names: set.empty(),
    adts: cx.adts,
    consts: no_consts,
    blocks: no_blocks,
    owner: "probe",
    traits: cx.traits,
    impls: cx.impl_table,
    prog_fns: map.empty(),
    impl_fns: no_impls(),
    syms: no_syms,
    world: ct_world_empty(),
    scope: alone("probe"),
    body: "probe",
    max_depth: MAX_CALL_DEPTH,
    pending: set.empty(),
    folding: "",
    intrs: intrinsics()
  }
}

## What `call_builtin` really does with `name`, asked by calling it:
## `"arm"`, `"refused"`, or `"listed-no-arm"`.
##
## No arguments are passed, and that is the whole trick. Every arm that reads
## one panics on the empty list, and a panic is exactly the evidence wanted --
## control reached an arm. So no arm has to be handed a plausible argument, and
## an arm added later needs nothing here to be seen. The two non-arm outcomes
## have texts of their own (`no_arm_msg`, `NO_ARM_LISTED`), which is why both
## are written once and read from here.
fn probe_builtin(icx: ICx, name: String) -> String !io = {
  let env: Env = map.empty()
  let no_args: List[CValue] = []
  match catch_panic(() => call_builtin(icx, fresh_st(1000), env, name, no_args)) {
    Err(msg) -> if str.contains(msg.message, NO_ARM_LISTED) { "listed-no-arm" } else { "arm" }
    Ok(r) ->
      match r {
        Ok(_) -> "arm"
        Err(t) -> {
          let (_, _, ctl) = t
          match ctl {
            KErr(failure) ->
              if failure.msg == no_arm_msg(name) { "refused" } else { "arm" }
            _ -> "arm"
          }
        }
      }
  }
}

## What a comptime call on std/hamt answers: the refusal's text, or `"folded"`
## if it did not refuse. The Map/Set group is refused here and not in the
## chain, so this is the probe that says the refusal is real.
fn probe_hamt(icx: ICx, name: String) -> String !io = {
  let env: Env = map.empty()
  let no_args: List[CValue] = []
  match call_named(icx, fresh_st(1000), env, "std/hamt", name, no_args) {
    Ok(_) -> "folded"
    Err(t) -> {
      let (_, _, ctl) = t
      match ctl {
        KErr(failure) -> failure.msg
        _ -> "folded"
      }
    }
  }
}

test "--comptime-fuel is a count of steps, wherever it sits in an argv" {
  assert take_ct_fuel(["a.dawn"]) == Ok((None, ["a.dawn"]))
  assert take_ct_fuel(["--comptime-fuel", "7", "a.dawn"]) == Ok((Some(7), ["a.dawn"]))
  assert take_ct_fuel(["a.dawn", "--comptime-fuel=0"]) == Ok((Some(0), ["a.dawn"]))
  # the last one wins, as it does for the JVM's own options
  assert take_ct_fuel(["--comptime-fuel=1", "--comptime-fuel", "2"]) == Ok((Some(2), []))
  assert take_ct_fuel(["--comptime-fuel"]) == Err("--comptime-fuel needs a number")
  assert take_ct_fuel(["--comptime-fuel=x"]) == Err("--comptime-fuel needs a number")
  assert take_ct_fuel(["--comptime-fuel", "-1"]) == Err("--comptime-fuel needs a number, 0 or more")
}

test "the comptime interpreter covers every intrinsic, removes it in lowering, or refuses it" {
  let arms = interp_arms()
  let rejects = comptime_rejects()
  # the third group is lowering's own list, read rather than copied: a name
  # lowering removes is one this evaluator never sees, and the list that says
  # which names those are is the one lowering acts on. A staged name is one
  # lowering refuses outright, so this evaluator never sees it either (#185
  # asked for both; the staged list is empty today and read all the same)
  let lowered = lower.lowered_intrinsics() ++ lower.staged_intrinsics()
  # the two tables that between them name every intrinsic in the program:
  # what a user may write, and what lowering emits on top of that
  let user = map.keys(intrinsics())
  let internal = lower.internal_intrinsics()
  let icx = probe_icx()

  # 1. the three groups partition the tables. This is the check that makes a
  #    new primitive impossible to forget: added to `types.intrinsics()` and to
  #    no group here, it lands nowhere and this fails.
  for n in user ++ internal {
    var groups = 0
    if has_name(arms, n) { groups = groups + 1 }
    if has_name(lowered, n) { groups = groups + 1 }
    if has_name(rejects, n) { groups = groups + 1 }
    if groups != 1 {
      panic("`" ++ n ++ "` is in " ++ to_string(groups) ++ " of the three comptime " ++
          "groups (interp_arms, lower.lowered_intrinsics, comptime_rejects); " ++
          "every intrinsic belongs to exactly one")
    }
  }
  #    The pair #185 was about, named on its own: an arm for a name lowering
  #    removes has no producer, which is how `parse_int`'s arm outlived its
  #    reason. The loop above already refuses it; this says which rule broke.
  for n in arms {
    if has_name(lowered, n) {
      panic("`" ++ n ++ "` has an arm here, but lowering removes every call to it " ++
          "(lower.lowered_intrinsics), so no Core the interpreter runs can name it")
    }
  }

  # 2. nothing on a list is outside the tables. This is the direction that had
  #    rotted: `map_index`, `chars` and `split` had arms here long after their
  #    producers went away (`m[k]` became a `std/hamt.index` call, the other
  #    two moved into std/str), and nothing said so.
  for n in arms ++ rejects {
    assert has_name(user, n) || has_name(internal, n)
  }

  # 3. the lists say what the chain does. Without this the lists would be a
  #    second copy of the chain, free to drift from it the way the chain drifted
  #    from `types.intrinsics()`. A lowered name has no arm either: were one to
  #    reach the chain, it would be refused rather than half-implemented.
  for n in arms { assert probe_builtin(icx, n) == "arm" }
  for n in rejects ++ lowered { assert probe_builtin(icx, n) == "refused" }
  # and a name that is no intrinsic at all gets the same refusal, which is
  # what the probe reads as "no arm"
  assert probe_builtin(icx, "no_such_primitive") == "refused"

  # 4. the lowered names a `const` still cannot use are exactly the ones
  #    lowering routes to std/hamt, and std/hamt really is refused. Both
  #    directions, because the list is what the builtins mirror's markers are
  #    held to (scripts/builtin-decl-contract, P5).
  let after = comptime_refused_after_lowering()
  for n in lowered {
    assert has_name(after, n) == (lower.hamt_fn(n) != None)
  }
  for n in after { assert has_name(lowered, n) }
  assert probe_hamt(icx, "empty") == "Map and Set operations are not available at comptime"

  # 5. the sizes the comments above quote. A count written in prose is what
  #    went wrong in the list this gate replaces -- lowering's own said
  #    "thirteen more" and "all twelve" in the same paragraph -- so the
  #    numbers this file states are asserted rather than asserted-by-nobody.
  assert len(arms) == 44
  assert len(rejects) == 70
  assert len(after) == 18
}

fn test_sig(name: String, params: List[Ty], ret: Ty) -> Sig =
  Sig {
    name: name,
    param_tys: params,
    param_names: [],
    param_defaults: [],
    caller_params: [],
    ret: ret,
    eff: EPure,
    is_builtin: false,
    tparams: [],
    constraints: [],
    eparams: [],
    owner: None,
    trait_id: None,
    op_of: None,
    inferring: false
  }

fn test_tfun(name: String, params: List[Ty], ret: Ty, body: TExpr) -> TFun =
  TFun {
    name: name,
    sig: test_sig(name, params, ret),
    param_syms: [],
    dict_syms: [],
    ev_syms: [],
    defaults: [],
    body: body,
    is_test: false,
    impl_of: None,
    default_of: None,
    decl: "",
    base: -1
  }

test "lowering invariant panics cross both comptime lowering boundaries" {
  let icx0 = probe_icx()
  match catch_panic(() => fold_expr(icx0, 1000, empty_cache(), XError(3, 4), 3, 4)) {
    Ok(_) -> { assert false }
    # the compiler's own panics carry their site like any program's
    Err(e) -> { assert str.starts_with(e.message, "lower: XError reached lowering at src/ir/lower.dawn:") }
  }

  let bad = test_tfun("bad", [], TyUnit, XError(5, 6))
  let fns = map.insert(icx0.fns, "bad", bad)
  let owner_of = map.insert(icx0.owner_of, "bad", "probe")
  let sigs = map.insert(icx0.prog_fns, ("probe", "bad"), bad.sig)
  let icx = ICx { ..icx0, fns: fns, owner_of: owner_of, prog_fns: sigs }
  let env: Env = map.empty()
  match catch_panic(() => call_named(icx, fresh_st(1000), env, "probe", "bad", [])) {
    Ok(_) -> { assert false }
    Err(e) -> { assert str.starts_with(e.message, "lower: XError reached lowering at src/ir/lower.dawn:") }
  }
}

test "`show` is the nested rendering and `to_string` is not" {
  # The one place the two operations differ is a String, and they shared an
  # arm of `call_builtin` until 2026-07-30 -- so comptime answered the
  # top-level form for both, against the contract lower.dawn writes down.
  # Nothing in Core reaches the `show` arm today (Bytes was its only producer
  # and is named now), which is exactly why this is a unit test: no program
  # can put the contract under a differential.
  assert show_value(VStr("a")) == Some("\"a\"")
  assert stringify(VStr("a")) == "a"
  assert show_value(VStr("a\nb\"c")) == Some("\"a\\nb\\\"c\"")
  # the scalars render the same either way -- quoting is the whole difference
  assert show_value(VInt(-3)) == Some("-3")
  assert show_value(VBool(true)) == Some("true")
  # and a value the interpreter cannot identify is a refusal rather than the
  # literal "<value>" the merged arm used to fold in
  assert show_value(VList([VInt(1)])) == None
  assert show_value(VUnit) == None
}

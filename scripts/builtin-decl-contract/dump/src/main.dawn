# The builtin table, dumped from the compiler's own source.
#
# `selfhost/builtins.dawn` is a mirror of this table that a reader can open,
# and a mirror is worth nothing unless something compares it. This is the side
# of that comparison the compiler owns: it imports `check/types` as a library
# and prints every entry of `intrinsics()` -- the name, whether user code may
# spell it, and the rendered signature.
#
# No new compiler API and no new subcommand. The table is an ordinary Dawn
# value in an ordinary Dawn module, and `selfhost` is an ordinary package, so a
# path dependency is the whole mechanism.
#
# The signature is rendered with `sig_render_fqn`, not `sig_render`: the mirror
# must be readable as Dawn source, and `cast`'s parameter is only a type any
# file could name when it is spelled `java.lang.Object`. Every other entry
# renders identically under both.
#
# Two record kinds, tab separated:
#
#     builtin\t<name>\t<pub|internal>\t<signature>
#     lowering\t<name>
#
# The second is `lower.internal_intrinsics()`, the names lowering emits that no
# source file may write. They carry no signature and are not mirrored; they are
# here so the checker can hold its reading of `ir/interp.dawn` against the whole
# intrinsic universe rather than against a slice of it. See check.py, M1.

use std/io
use std/list
use std/map
use std/str
use selfhost/check/cx.{Cx, cx_new}
use selfhost/check/passes.{pass_fn_signatures, seed_prelude}
use selfhost/check/types.{intrinsics, prelude_adts, prelude_traits, sig_render_fqn}
use selfhost/front/parser.{parse_module}
use selfhost/ir/lower.{internal_intrinsics}

## The one signature whose rendering is deliberately not Dawn source, and so
## the one that cannot be read back. `cast`'s parameter renders
## `java.lang.Object`, and a dotted type path is not a spelling the parser
## takes anywhere: the source form is `use java "java.lang.Object"` and then
## the bare `Object`. The mirror's own header already names this line as one
## that would not compile even with a body, and the reason it renders that way
## is that the short name is in no file's scope.
##
## Named here rather than skipped where the loop happens to fail, and the
## checker holds the skip set equal to this one name, so a second signature
## that stops parsing is red rather than absorbed.
fn roundtrip_skips() -> List[String] = ["cast"]

pub fn main() -> Unit !io = {
  let adts = prelude_adts()
  let traits = prelude_traits()
  let it = intrinsics()
  # Resolution happens as if inside `std/`: seven of the signatures name
  # `Array`, which is a std-only type (`BtStdOnly`), and outside std they
  # resolve to an error rather than to the type the table holds. That is the
  # same fact their bare `fn` states one level up, so reading them back where
  # they are legal is reading them back where they are meant.
  let base = seed_prelude(cx_new(Some("std/builtin_decl_dump"), None))
  for name in list.sort(map.keys(it)) {
    let i = map.get(it, name).expect("intrinsic listed")
    let vis = if i.internal { "internal" } else { "pub" }
    let sig = sig_render_fqn(adts, traits, i.sig)
    # A tab or a newline inside a rendering would make the line format lie
    # about how many fields it has. Neither can occur -- a signature is built
    # from identifiers, punctuation and single spaces -- so this is a guard
    # against a future rendering, not a case that has one.
    if str.contains(sig, "\t") || str.contains(sig, "\n") {
      panic("a rendered signature carries a field separator: " ++ name)
    }
    io.println("builtin\t" ++ name ++ "\t" ++ vis ++ "\t" ++ sig)
    if list.contains(roundtrip_skips(), name) {
      io.println("roundtrip-skip\t" ++ name)
    } else {
      io.println("roundtrip\t" ++ name ++ "\t" ++ sig ++ "\t" ++ reread(base, sig))
    }
  }
  for name in list.sort(internal_intrinsics()) {
    io.println("lowering\t" ++ name)
  }
}

## A rendering, read back as the declaration it claims to be, and rendered
## again. Identity is the judgement (check.py, P6): a rendering that loses
## something the signature carried comes back spelled differently.
##
## The body is `todo()` because a declaration with no body is a parse error --
## the same fact that keeps `selfhost/builtins.dawn` out of every build -- and
## `Never` types wherever a value is wanted, so one body serves all 94.
## Nothing here checks a body: `pass_fn_signatures` resolves signatures and
## that is the whole of what is compared.
##
## A failure to parse or resolve renders as a bracketed note rather than a
## panic. It is a difference like any other, and P6 prints both sides, so the
## note reaches the reader with the signature that produced it.
fn reread(base: Cx, sig: String) -> String !io = {
  let (m, ds) = parse_module(sig ++ " = todo()\n")
  if len(ds) > 0 {
    return "<parse: " ++ ds[0].msg ++ ">"
  }
  let (cx1, sigs) = pass_fn_signatures(base, m)
  if len(cx1.diags) > 0 {
    return "<resolve: " ++ cx1.diags[0].msg ++ ">"
  }
  if len(sigs) != 1 {
    return "<parsed " ++ to_string(len(sigs)) ++ " declarations>"
  }
  sig_render_fqn(cx1.adts, cx1.traits, sigs[0])
}

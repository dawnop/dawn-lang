# passes.dawn: expected impl signatures preserve which function layer owns !io
trait Factory[T] {
  fn make(x: T) -> (fn() -> Int) !io
}

type Sub = S

impl Factory[Sub] {
  fn make(x: Sub, extra: Int) -> (fn() -> Int) !io = panic("unreachable")
}

trait Missing[T] {
  fn absent(x: T) -> (fn() -> Int) !io
}

type Sub2 = S2

impl Missing[Sub2] {
}

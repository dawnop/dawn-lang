  println("const/ceil ${C82} ${C82}")
  println("const/ceil ${C83} ${C83}")
  println("const/trunc ${C84} ${C84}")
  println("const/trunc ${C85} ${C85}")
  println("const/trunc ${C86} ${C86}")
  println("const/trunc ${C87} ${C87}")
  println("const/round ${C88} ${C88}")
  println("const/round ${C89} ${C89}")
  println("const/round ${C90} ${C90}")
  println("const/round ${C91} ${C91}")
  println("const/round_even ${C92} ${C92}")
  println("const/round_even ${C93} ${C93}")
  println("const/round_even ${C94} ${C94}")
  println("const/round_even ${C95} ${C95}")
  println("const/pow ${C96} ${C96}")
  println("const/pow ${C97} ${C97}")
  println("const/pow ${C98} ${C98}")
  println("const/hypot ${C99} ${C99}")
  println("const/hypot ${C100} ${C100}")
  println("const/hypot ${C101} ${C101}")
  println("const/atan2 ${C102} ${C102}")
  println("const/atan2 ${C103} ${C103}")
  println("const/atan2 ${C104} ${C104}")
  println("const/fma ${C105} ${C105}")
  println("const/fma ${C106} ${C106}")
  println("const/fma ${C107} ${C107}")
  println("const/fma ${C108} ${C108}")
  println("const/fma ${C109} ${C109}")
  println("const/fma ${C110} ${C110}")
  var count = 0
  while true {
    match io.read_line() {
      None -> break
      Some(line) -> {
        let p = str.split(line, " ")
        let section = p[0]
        let op = str.split(section, "/")[0]
        let x = narrow.f64_of_bits(parse_int(p[1]).expect("input x"))
        let y = narrow.f64_of_bits(parse_int(p[2]).expect("input y"))
        let z = narrow.f64_of_bits(parse_int(p[3]).expect("input z"))
        let a = raw(direct(op, x, y, z))
        let b = raw(if op == "fma" { let f = math.fma
          f(x, y, z) } else if op == "pow" || op == "hypot" || op == "atan2" { binary(op)(x, y) } else { unary(op)(x) })
        println("${section} ${a} ${b}")
        count = count + 1
      }
    }
  }
  println("complete ${count}")
}

# dawn-lang.dawnop.com static site generator — written in Dawn (M5).
# Run via site/build.sh (which feeds it dawn doc --stdlib output), or
# directly from the repo root: dawn run site

use gen/pages.{gen_assets, gen_index, gen_spec, gen_design, gen_playground}
use html/page.{En, Zh}
use gen/tutorial.{gen_tutorial}
use gen/examples.{gen_examples}
use gen/stdlib.{gen_stdlib}
use gen/links.{check_links}

pub fn main() -> Unit !io = {
  let out = "site/dist"
  gen_assets(out)
  # English is the site's default and lives at `/`; the Chinese front page
  # is at `/zh/`. Everything below this pair is Chinese and unpaired.
  gen_index(out, En)
  gen_index(out, Zh)
  gen_spec(out)
  gen_design(out)
  gen_tutorial(out)
  gen_examples(out)
  gen_stdlib(out)
  gen_playground(out)
  check_links(out)
  println("site generated into $out")
}

# checker.dawn: a trait or impl method's row may carry effect variables and,
# since 刀 5 (docs/effect-params-design.md), written labels -- each label is
# one hidden evidence parameter on the slot, exactly as on a fn. A function
# *type* in a parameter position may name a label too, which it could not while
# #188's ban stood; what still holds is that an impl method's labels must match
# the trait's row exactly, because they are the method's arity.
effect Ask { fn ask() -> Int }

trait Eff[T] {
  fn a(x: T) -> Int !Ask
  fn b(x: T) -> Int !e
  fn c(x: T, f: fn() -> Int !Ask) -> Int
  fn d(x: T, f: fn() -> Int !e) -> Int
}

trait Plain[T] {
  fn m(x: T) -> Int
  fn n(x: T) -> Int
  fn o(x: T) -> Int
  fn p(x: T) -> Int
}

type Sub = S

# `m` writes a label the trait's row does not carry, so the row comparison
# refuses it -- in its own words, no blanket ban. `n` is a different failure:
# an effect variable is a legal row, but the trait's `n` binds none, and the
# two signatures' variables are paired by position -- so the impl is refused
# for the variable it introduced, not for having one.
impl Plain[Sub] {
  fn m(x: Sub) -> Int !Ask = 1
  fn n(x: Sub) -> Int !e = 1
  fn o(x: Sub) -> Int = 1
  fn p(x: Sub) -> Int = 1
}

trait Sigs[T] {
  fn sq(x: T) -> Int
  fn sr(x: T) -> Int
}

# These two are the same failure, and the label is not part of it. `sq` writes
# a label into a parameter's function type, which is legal on its own; what the
# golden reports is the second parameter, which the trait does not declare. `sr`
# writes an effect variable there instead, equally legal, and is reported for
# that same extra parameter. The pair is here to show the label buys no extra
# diagnostic: no ban survives for it to trip over.
impl Sigs[Sub] {
  fn sq(x: Sub, f: fn() -> Int !Ask) -> Int = 1
  fn sr(x: Sub, f: fn() -> Int !e) -> Int = 1
}

trait Two[T] {
  fn tw(x: T, g: fn() -> Int !a, h: fn() -> Int !b) -> Int !a
}

# The permutation. Both sides bind two variables and both spell them `a` and
# `b`, but the impl's row takes the *second* one, so mint order pairs the
# trait's first variable with the impl's `b` and the parameter types stop
# lining up. Pairing by spelling would have accepted this; pairing by position
# is what refuses it.
impl Two[Sub] {
  fn tw(x: Sub, g: fn() -> Int !a, h: fn() -> Int !b) -> Int !b = h()
}

# HTML escaping shared by the whole generator. Splices around the rare
# special characters instead of appending per code point.
#
# The spliced pieces are collected and joined once rather than concatenated
# into a growing string: a code-heavy paragraph has hundreds of them, and
# `acc = acc ++ piece` recopies the whole prefix on every one.

use std/str
use md/text.{cp_at}

fn entity(c: Char) -> String =
  if c == '&' { "&amp;" } else if c == '<' { "&lt;" } else { "&gt;" }

## Escape &, <, > for HTML text and attribute positions.
pub fn escape_html(s: String) -> String = {
  let cs = code_points(s)
  let n = len(cs)
  var parts: List[String] = []
  var start = 0
  var i = 0
  while i < n {
    let c = cp_at(cs, i)
    if c == '&' || c == '<' || c == '>' {
      parts = parts ++ [str.slice(s, start, i) ++ entity(c)]
      start = i + 1
    }
    i = i + 1
  }
  if len(parts) == 0 { s } else { join(parts ++ [str.slice(s, start, n)], "") }
}

test "escapes only what html needs" {
  assert escape_html("a < b && c > d") == "a &lt; b &amp;&amp; c &gt; d"
  assert escape_html("plain 中文") == "plain 中文"
}

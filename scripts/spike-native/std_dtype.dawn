# std/dtype's formats found by type, differentially. `HasDtype` has `T` only in
# the return position, so the expected type picks the impl; that works in a
# module other than std/dtype (inside it an opaque `Dtype[T]` is its String and
# T is unconstrained), which is why this is a program and not a std test. The
# integer witnesses are read both by value and by type.
use std/dtype.{Dtype, dtype_name, dtype_of, F64, I64, I1}
use std/int/i8.{I8}
use std/int/u8.{U8}

pub fn main() -> Unit !io = {
  let f: Dtype[Float] = dtype_of()
  let i: Dtype[Int] = dtype_of()
  let b: Dtype[Bool] = dtype_of()
  println("${dtype_name(f)} ${dtype_name(i)} ${dtype_name(b)}")
  println("${dtype_name(F64)} ${dtype_name(I64)} ${dtype_name(I1)}")
  let s: Dtype[I8] = dtype_of()
  let u: Dtype[U8] = dtype_of()
  println("${dtype_name(s)} ${dtype_name(I8)} ${dtype_name(u)} ${dtype_name(U8)}")
}

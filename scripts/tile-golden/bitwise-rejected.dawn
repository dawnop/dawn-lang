# Missing eligibility, mixed masks and missing Dev must remain checker
# errors. Deleted names are checked here so a compatibility shim is red.
use tileir/dev
use tileir/dev.{Tile, Dev}
use std/int/i32.{I32}
use std/int/u8.{U8}
use std/gpu.{I4}
pub fn floating(a: Tile[Float]) -> Tile[Float] !Dev = a & a
pub fn unsigned(a: Tile[U8]) -> Tile[U8] !Dev = ~a
pub fn packed(a: Tile[I4]) -> Tile[I4] !Dev = a ^ a
pub fn mixed(a: Tile[Bool], b: Tile[I32]) -> Tile[Bool] !Dev = a & b
pub fn pure(a: Tile[I32]) -> Tile[I32] = ~a
pub fn removed(a: Tile[I32], m: Tile[Bool]) -> Unit !Dev = {
  let _a = dev.and_i(a, a)
  let _b = dev.or_i(a, a)
  let _c = dev.xor_i(a, a)
  let _d = dev.and_mask(m, m)
  let _e = dev.or_mask(m, m)
  ()
}
pub fn float_shift(a: Tile[Float]) -> Tile[Float] !Dev = a << a
pub fn bool_shift(a: Tile[Bool]) -> Tile[Bool] !Dev = a >> a
pub fn unsigned_shift(a: Tile[U8]) -> Tile[U8] !Dev = a >>> a
pub fn packed_shift(a: Tile[I4]) -> Tile[I4] !Dev = a << a
pub fn amount(a: Tile[I32], n: Tile[Int]) -> Tile[I32] !Dev = a << n
pub fn pure_shift(a: Tile[I32]) -> Tile[I32] = a >>> a
pub fn old_shift(a: Tile[I32]) -> Unit !Dev = {
  let _a = dev.shl_i(a, a)
  let _b = dev.shr_i(a, a)
  let _c = dev.shr_u(a, a)
  let _d = dev.shli(a, a)
  let _e = dev.shri(a, a)
  ()
}
pub fn main() -> Unit = ()

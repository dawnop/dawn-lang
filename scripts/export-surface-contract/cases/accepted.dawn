# Everything SEM-07 must let through, in one module: an opaque type whose
# representation is private, a public effect on an ordinary function, a public
# trait whose default body calls a private function, and a phantom opaque type
# whose argument the target never mentions.
type Secret = Secret

pub opaque type Token = Secret
pub opaque type Vault[T] = Secret
pub opaque type Phantom[T] = Unit

pub effect Ask {
  fn ask() -> Int
}

fn private_default() -> Int = 1

pub trait Described[T] {
  fn describe(x: T) -> Int = private_default()
}

pub fn token() -> Token = Secret
pub fn vault() -> Vault[Int] = Secret
pub fn phantom() -> Phantom[Int] = ()
pub fn ask_one() -> Int !Ask = ask()

-- malformed UTF-8 is replaced, not refused --
lone continuation 1 efbfbd
truncated 2-byte  1 efbfbd
bad continuation  3 efbfbd41efbfbd
never a lead byte 1 efbfbd
embedded          3 61efbfbd62
-- an overlong form is not the character it encodes --
c0 af             2 efbfbdefbfbd
c0 80             2 efbfbdefbfbd
e0 80 af          3 efbfbdefbfbdefbfbd
f0 8f bf bf       4 efbfbdefbfbdefbfbdefbfbd

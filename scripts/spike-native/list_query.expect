-- contains / index_of (spec 4.8, criterion 2) --
contains 4      = true
contains 7      = false
contains empty  = false
index_of first  = 1
index_of last   = 7
index_of miss   = none
index_of empty  = none
contains string = true
contains list   = true
-- any / all --
any > 8         = true
any > 90        = false
any of empty    = false
all > 0         = true
all > 2         = false
all of empty    = true
-- and they stop --
any, hit at 4:
    saw 3
    saw 1
    saw 4
  = true
all, fails at 1:
    saw 3
    saw 1
  = false
any, never hits:
    saw 7
    saw 8
  = false
-- unique keeps the first occurrence --
ints            = [3, 1, 4, 5, 9, 2, 6]
empty           = []
strings         = ["b", "a", "c"]
all same        = [2]
nested          = [[1], [2]]

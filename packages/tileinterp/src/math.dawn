## GPU arithmetic adapters that do not belong to the host math contract:
## directed rounding, flush to zero and round to odd for narrow formats.
#
# Host operations come from std/math and std/float at their call sites. The
# reference in packages/tileref keeps its independent transcendental series.
# Products below are normalized before their residual is taken: fma gives
# the exact residual only when that residual is representable. In particular
# a subnormal product at the original scale can lose its residual entirely.
use std/math as host_math
use std/float
use std/narrow

## The zero with the sign of `x`.
pub fn signed_zero(x: Float) -> Float = host_math.copysign(0.0, x)

## Flush subnormals to the zero of their sign, for the binary64 dialect.
pub fn flush(x: Float) -> Float = if float.is_subnormal(x) { signed_zero(x) } else { x }

# Both operands have been normalized by frexp (the quotient in div_dir is
# within a factor of two). Neither the product nor its residual can underflow
# or overflow here; do not use this identity on unscaled extreme operands.
fn two_prod(a: Float, b: Float) -> (Float, Float) = {
  let p = a * b
  (p, host_math.fma(a, b, 0.0 - p))
}

## Knuth's TwoSum: `(s, e)` with `s = fl(a + b)` and `a + b = s + e` exactly,
## for finite operands whose sum does not overflow.
pub fn two_sum(a: Float, b: Float) -> (Float, Float) = {
  let s = a + b
  let bb = s - a
  let e = (a - (s - bb)) + (b - bb)
  (s, e)
}

## The ROUND-TO-ODD value of the exact sum `s + e`, where `s = fl(x + y)` and
## `e` is the error TwoSum reports: `s` itself when the sum was exact or its
## significand is already odd, otherwise the neighbour of `s` on the side of
## `e`, whose significand is odd. Rounding that value to nearest, or in any
## direction, at a format with at most 51 significand bits gives what
## rounding the EXACT sum once would (Boldo and Melquiond, "Emulation of FMA
## and correctly rounded sums: proved algorithms using rounding to odd",
## IEEE Trans. Computers 2008). It is the one device that lets binary64
## stand in for a wider format in the fused operations below.
pub fn odd_of(s: Float, e: Float) -> Float =
  if e == 0.0 || not float.is_finite(s) || (narrow.f64_bits(s) & 1) == 1 {
    s
  } else if e > 0.0 {
    float.next_up(s)
  } else {
    float.next_down(s)
  }

## `x + y` rounded to odd (see [`odd_of`]); `x` and `y` finite.
pub fn add_odd(x: Float, y: Float) -> Float = {
  let (s, e) = two_sum(x, y)
  odd_of(s, e)
}

## A rounding direction for the operations that take one.
pub type Dir = ToNearest | Downward | Upward

## The value `r`, the round-to-nearest result of an exact operation, moved to
## the directed result: `err` is the sign of `exact - r` (-1, 0 or 1).
pub fn directed(r: Float, err: Int, dir: Dir) -> Float = match dir {
  ToNearest -> r
  Downward -> if err < 0 { float.next_down(r) } else { r }
  Upward -> if err > 0 { float.next_up(r) } else { r }
}

fn sign_of(x: Float) -> Int = if x > 0.0 { 1 } else if x < 0.0 { 0 - 1 } else { 0 }

## `a + b` rounded in direction `dir`.
pub fn add_dir(a: Float, b: Float, dir: Dir) -> Float = {
  let s = a + b
  match dir {
    ToNearest -> s
    _ ->
      if not float.is_finite(a) || not float.is_finite(b) {
        s
      } else if not float.is_finite(s) {
        # finite operands that overflowed: the exact sum is finite
        directed(s, 0 - sign_of(s), dir)
      } else if s == 0.0 {
        exact_zero_sum(a, b, dir)
      } else {
        let (_s, e) = two_sum(a, b)
        directed(s, sign_of(e), dir)
      }
  }
}

# The sign of an exactly zero sum: IEEE 754 6.3 gives `-0` under roundTowardNegative
# when the operands have opposite signs (or are zeros of opposite sign), and
# `+0` under every other mode; two zeros of one sign keep it.
fn exact_zero_sum(a: Float, b: Float, dir: Dir) -> Float =
  if a == 0.0 && b == 0.0 && float.sign_bit(a) == float.sign_bit(b) {
    a
  } else {
    match dir {
      Downward -> host_math.copysign(0.0, -1.0)
      _ -> 0.0
    }
  }

## `a * b` rounded in direction `dir`.
pub fn mul_dir(a: Float, b: Float, dir: Dir) -> Float = {
  let p = a * b
  match dir {
    ToNearest -> p
    _ ->
      if not float.is_finite(a) || not float.is_finite(b) || a == 0.0 || b == 0.0 {
        p
      } else {
        # scale both factors into [0.5, 1) in magnitude so the product's error is exact,
        # then decide the sign of `exact - p` at the original scale
        let (ma, ea) = host_math.frexp(a)
        let (mb, eb) = host_math.frexp(b)
        let (pm, em) = two_prod(ma, mb)
        if not float.is_finite(p) {
          directed(p, 0 - sign_of(p), dir)
        } else {
          # `p * 2^-(ea+eb)` is exact (a scaling up never drops a bit), and
          # close enough to `pm` for their difference to be exact as well
          let back = host_math.ldexp(p, 0 - ea - eb)
          directed(p, cmp_sum(pm - back, em), dir)
        }
      }
  }
}

# The sign of `d + e`, decided without rounding the sum.
fn cmp_sum(d: Float, e: Float) -> Int = if d > 0.0 - e { 1 } else if d < 0.0 - e { 0 - 1 } else { 0 }

## `a / b` rounded in direction `dir`.
pub fn div_dir(a: Float, b: Float, dir: Dir) -> Float = {
  let q = a / b
  match dir {
    ToNearest -> q
    _ ->
      if not float.is_finite(a) || not float.is_finite(b) || a == 0.0 || b == 0.0 || not float.is_finite(q) {
        if float.is_finite(a) && float.is_finite(b) && b != 0.0 && not float.is_finite(q) {
          directed(q, 0 - sign_of(q), dir)
        } else {
          q
        }
      } else {
        let (ma, ea) = host_math.frexp(a)
        let (mb, eb) = host_math.frexp(b)
        # the RN quotient at the original scale, brought to the scaled one
        let qs = host_math.ldexp(q, eb - ea)
        let (p, e) = two_prod(qs, mb)
        # sign(exact - q) = sign(ma - qs * mb) * sign(mb): the scaling keeps
        # the signs of a and b, and `ma - p` is exact by Sterbenz's lemma
        let r = cmp_sum(ma - p, 0.0 - e)
        directed(q, if mb < 0.0 { 0 - r } else { r }, dir)
      }
  }
}

test "round to odd keeps the sticky bit that lets binary64 stand in for a narrower format" {
  # 1 + 2^-60 is not a binary64; its round-to-odd value is the next one up, whose last bit is set
  let (s, e) = two_sum(1.0, 8.673617379884035e-19)
  assert s == 1.0
  assert odd_of(s, e) == 1.0 + 2.220446049250313e-16
  # an exact sum is its own round-to-odd
  assert add_odd(1.0, 0.5) == 1.5
}

test "directed roundings move the round-to-nearest result by at most one ulp, toward their side" {
  let a = 0.1
  let b = 0.2
  let rn = a + b
  let lo = add_dir(a, b, Downward)
  let hi = add_dir(a, b, Upward)
  assert lo <= rn && rn <= hi && (narrow.f64_bits(hi) - narrow.f64_bits(lo)) == 1
  # an exact sum is not moved
  assert add_dir(1.0, 2.0, Downward) == 3.0 && add_dir(1.0, 2.0, Upward) == 3.0
  # x + (-x) is -0 rounding down and +0 otherwise
  assert float.sign_bit(add_dir(1.5, 0.0 - 1.5, Downward))
  assert not float.sign_bit(add_dir(1.5, 0.0 - 1.5, Upward))
  let pl = mul_dir(0.1, 0.3, Downward)
  let ph = mul_dir(0.1, 0.3, Upward)
  assert pl < ph && (narrow.f64_bits(ph) - narrow.f64_bits(pl)) == 1
  assert mul_dir(3.0, 0.5, Downward) == 1.5
  let ql = div_dir(1.0, 3.0, Downward)
  let qh = div_dir(1.0, 3.0, Upward)
  assert ql < qh && (narrow.f64_bits(qh) - narrow.f64_bits(ql)) == 1 && (ql == 1.0 / 3.0 || qh == 1.0 / 3.0)
  assert div_dir(1.0, 4.0, Downward) == 0.25
  let nl = div_dir(0.0 - 1.0, 3.0, Downward)
  assert nl < 0.0 - 1.0 / 3.0 || nl == 0.0 - 1.0 / 3.0
  assert div_dir(0.0 - 1.0, 3.0, Upward) >= nl
}

test "normalized directed residuals survive extreme exponents" {
  let tiny = narrow.f64_of_bits(1)
  let largest = narrow.f64_of_bits(0x7fefffffffffffff)
  assert mul_dir(tiny, 0.5, Downward) == 0.0
  assert mul_dir(tiny, 0.5, Upward) == tiny
  assert narrow.f64_bits(mul_dir(0.0 - tiny, 0.5, Upward)) == (1 << 63)
  assert mul_dir(0.0 - tiny, 0.5, Downward) == 0.0 - tiny
  assert mul_dir(largest, 2.0, Downward) == largest
  assert mul_dir(largest, 2.0, Upward) == float.INFINITY
  assert div_dir(tiny, 2.0, Downward) == 0.0
  assert div_dir(tiny, 2.0, Upward) == tiny
  assert div_dir(largest, 0.5, Downward) == largest
  assert div_dir(largest, 0.5, Upward) == float.INFINITY
  assert signed_zero(0.0 - tiny) == 0.0
  assert narrow.f64_bits(flush(0.0 - tiny)) == (1 << 63)
}

# An explicit contract isolates this propagation or boundary rule.
use std/mem
trait Relay[T: ^{c}, ^c] { fn relay(value: T) -> T = value }
impl[@s] Relay[I64Buf@s, ^{s}] { }
fn bad[@s](b: I64Buf@s) -> Int = mem.with_mem([@t] () => {
  let other: I64Buf@t = relay(b)
  len(other)
})
pub fn main() -> Unit !io = { () }

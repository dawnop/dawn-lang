# Value bounds do not provide the complete subject support of a staged witness.
type Range[T] = { value: T }
type Cond[T] = { value: T }
impl[T: ^{c}, ^c] StagedIter[Range[T], c] {
  type Item = Int
  fn staged_for(range: Range[T], body: fn(Int) -> Unit ^{c}) -> Unit = body(0)
}
impl[T: ^{c}, ^c] StagedCond[Cond[T], c] {
  fn staged_if(cond: Cond[T], yes: fn() -> Unit ^{c}, no: fn() -> Unit ^{c}) -> Unit = yes()
}
fn unproven_iter[T](range: Range[T]) -> Unit = {
  for item in range { let _ = item }
}
fn unproven_cond[T](cond: Cond[T]) -> Unit = {
  if cond { () }
}

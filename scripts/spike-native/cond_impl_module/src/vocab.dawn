# The conditional impl has a type parameter but no bounds, so its dictionary
# is a singleton even when the subject still contains a rigid M. Equality is
# deliberately not the record's structural equality: the oracle therefore
# also proves that synthesized outer equality dispatches through this impl.
pub type On[M] = { event: String, tag: Int }

impl[M] Eq[On[M]] {
  fn eq(a: On[M], b: On[M]) -> Bool = a.tag == b.tag
}

impl[M] Hash[On[M]] {
  fn hash(a: On[M]) -> Int = a.tag
}

pub type Node[M] =
  | Leaf(s: String)
  | Elem(on: List[On[M]])

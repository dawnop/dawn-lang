# One scenario, run once per injected host failure: replace a file that is
# already there, in a directory that holds nothing else.
#
# The golden for this probe is not a file but three lines the runner checks,
# because what varies between the runs is the first one. The other two are the
# whole point and never vary: whatever step failed, the destination still holds
# what it held, and the staging file is gone.
use std/io
use std/io.{Fs}
use std/str

pub fn main() -> Unit !io = {
  io.with_fs_real(() => {
    let r = io.atomic_write_file("target.toml", "new\n")
    io.println("result = " ++ verdict(r))
    io.println("content = " ++ slurp("target.toml"))
    io.println("entries = " ++ entries("."))
    # The staging file is the primitive's own device with a random name. It must
    # not turn up in a message a caller would print: `dawn lock` into a directory
    # it cannot write once reported a `.dawn-atomic-...tmp` the user had never
    # created. Asserted on every injection, not just the one that regressed.
    io.println("message-names-staging = " ++ names_staging(r))
  })
}

fn names_staging(r: Result[Unit, ForeignError]) -> String =
  match r {
    Ok(_) -> "no"
    Err(e) -> if str.contains(e.message, ".dawn-atomic-") { "yes" } else { "no" }
  }

fn verdict(r: Result[Unit, ForeignError]) -> String =
  match r {
    Ok(_) -> "ok"
    Err(e) -> if str.starts_with(e.kind, "io.") || str.starts_with(e.kind, "inject.") {
      e.kind
    } else {
      "err"
    }
  }

fn slurp(path: String) -> String !Fs =
  match io.read_file(path) {
    Ok(s) -> str.trim(s)
    Err(_) -> "<unreadable>"
  }

fn entries(dir: String) -> String !Fs =
  match io.list_dir(dir) {
    Ok(xs) -> to_string(xs)
    Err(_) -> "<unlistable>"
  }

# the declaring module: it may see through `Phantom`, so it is the only place
# a `Phantom[T]` can be minted out of the `Unit` it really is
pub opaque type Phantom[T] = Unit

pub fn of_int() -> Phantom[Int] = ()

pub fn of_string() -> Phantom[String] = ()

## Both arguments name one `T`, so the second is checked against whatever the
## first bound it to -- unification, not assignability, which is the judgement
## an opaque type's arguments have to survive.
pub fn require[T](witness: T, tagged: Phantom[T]) -> Unit = ()

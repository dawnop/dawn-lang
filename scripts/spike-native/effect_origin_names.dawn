# Contextual origin preserves operation, local, field and named argument names.
use std/io
ctl effect Ask { fn origin(n: Int) -> Int }
type Box = { origin: Int }
fn bump(origin: Int) -> Int = origin + 2
fn helper(n: Int) -> Int !Ask = origin(n)
pub fn main() -> Unit !io = {
  let origin = Box { origin = 40 }
  with handle Ask { origin(n) resume origin => origin(bump(origin = n)) }
  io.println("${helper(origin.origin)}")
}

# TAST -> Core IR (docs/native-backend-plan.md, Phase 0).
#
# This is where the sugar dies. Everything emit.dawn used to inline at code
# generation time -- match decision trees, `for`/`while` shape, `?`/`!`,
# string interpolation, and the boxing decision -- happens exactly once,
# here, and both backends consume the result.
#
# Two rules govern this file:
#
#   1. No target may be named. If a decision depends on "the JVM does X",
#      it belongs in a backend, not here. The one exception is CForeign,
#      which exists precisely to quarantine the unportable part.
#   2. Nothing implicit. A discarded value gets a CSDiscard; a boxed value
#      gets a CBox. If a backend has to re-derive it, it is not lowered.

use std/list
use std/map
use std/str
use check/types.{
  intr_at,
  intrinsics,
  subst,
  reduce_via_bindings,
  peel_opaque,
  Ty, TyInt, TyFloat, TyBool, TyString, TyUnit, TyNever, TyError, TyVar, TyAssoc,
  TyAdt, TyList, TyTuple, TyFn, TyBytes, TyMap, TySet, TyArray, TyJava,
  DICT_ADT_ID,
  Sym, Sig, EPure, Traits, TraitI, ImplI, MethodSig,
  Adts, AdtI, CtorI, adt_of, trait_of, prelude_adts,
  OPTION_ID, RESULT_ID, ORD_ID, EQ_ID, HASH_ID, SHOW_ID, ITER_ID, INDEX_ID,
  is_eq_scalar, is_ord_scalar, is_hash_scalar, builtins, Impls, impl_at, has_impl_at,
  is_ground, expandable, type_args_of, sub_goals
}
use check/tast.{
  TExpr, TStmt, TPat, TArm, TStrPart, TFun, TModule, TBinOp, TUnOp, TJavaCall,
  tex_ty,
  XInt, XChar, XFloat, XBool, XUnit, XStr, XLocal, XFnValue, XCallDyn, XCallBuiltin,
  XCallFn, XApply, XJava, XLambda, XCtor, XConstRef, XCtorValue, XField,
  XListLit, XTupleLit, XPropagate, XUnwrap, XIndex, XReturn, XBreak, XContinue,
  XComptime, XUnsafePure, XBinary, XUnary, XIf, XMatch, XBlock, XError,
  TSPText, TSPInterp,
  BAdd, BSub, BMul, BDiv, BMod, BConcat, BEq, BNeq, BLt, BLe, BGt, BGe,
  BAnd, BOr, BBand, BBor, BBxor, BShl, BShr, BUshr, UNeg, UNot, UBnot,
  TPWild, TPBind, TPLit, TPTuple, TPList, TPCtor,
  TSLet, TSLetPat, TSLocalFn, TSAssign, TSExpr, TSAssert, TSWhile, TSFor,
  WitRef, WForward, WConcrete, WApply
}
use check/exhaustive.{LitV, LInt, LFloat, LBool, LStr}
use ir/core.{
  CExpr, CStmt, CCallee, CFun, CModule, CParam, CMode, CBinOp, CUnOp,
  CInt, CFloat, CBool, CStr, CUnit, CLocal, CFnRef, CCall, CIntrinsic,
  CCtor, CField, CIsCtor, CClosure, CTuple, CTupleGet, CBox, CUnbox,
  CBinary, CUnary, CIf, CBlock, CListLit, CReturn, CBreak, CContinue,
  CForeign, CJava,
  CSLet, CSAssign, CSDiscard, CSLoop, CSIf, CSDrop,
  CDirect, CDynamic, CMethod, CImpl, CDefault, CDictRef, CDictApply, CDictArg,
  CDictDef, CDictSlot, CSlotFn, CSlotDefault,
  CAdd, CSub, CMul, CDiv, CMod, CEq, CNe, CLt, CLe, CGt, CGe, CAnd, COr,
  CBand, CBor, CBxor, CShl, CShr, CUshr, CConcat, CNeg, CNot, CBnot,
  COwned, CBorrowed, cex_ty, ty_key, ty_key_inst, diverges
}

# Prelude constructor indices, fixed by types.prelude_adts.
const SOME_CI: Int = 0
const NONE_CI: Int = 1
const OK_CI: Int = 0
const ERR_CI: Int = 1

## Lowering state: a fresh-symbol counter (match scrutinees, `?` temporaries),
## a loop-id counter, and the innermost enclosing loop. Symbol ids continue
## above the checker's, so a lowered temporary can never shadow a source
## local. `cur_loop` is -1 outside any loop; the checker has already rejected
## a stray `break`, so lowering may treat that as impossible.
pub type LSt = {
  next_sym: Int,
  next_loop: Int,
  owner: String,
  cur_loop: Int,
  # the enclosing function's declared return type, so `return` can box
  # against it here rather than in each backend
  ret_ty: Ty,
  # the checker's symbol table for this module: the authority on what a
  # pattern binding's type is, so lowering never has to consult the ADT
  # table to type a field projection
  syms: Map[Int, Sym],
  # lambda lifting: bodies hoisted to top level, and the counter that names
  # them. A lifted body keeps its captures' original symbol ids, so it needs
  # no substitution -- see core.CFun.captures.
  lifted: List[CFun],
  next_lam: Int,
  # trait metadata, needed to resolve a witness into a call form. It stops
  # here: Core carries the resolved answer, so no backend consults it.
  traits: Traits,
  impls: Impls,
  adts: Adts,
  # every directly-called function's declared signature, so a call site can
  # box its arguments against the DECLARED parameter types rather than leaving
  # each backend to recompute "is this slot a type variable". Trait calls do
  # not use this table: their signatures come from `traits` and are
  # specialised against `impls`, whose identities cannot collapse to a bare
  # (owner, name).
  prog_fns: Map[(String, String), Sig],
  dicts: List[CDictDef],
  # The dictionaries in scope right here, by the type each one witnesses
  # `Eq` for (`ty_key_inst`, so `Option[Int]` and `Option[T]` are distinct
  # keys). Only a non-ground type is ever looked up: a ground one's relation
  # is decided at compile time and needs no dictionary at all.
  #
  # It is scoped, not accumulated. A synthesised body reaches only the
  # dictionaries its own parameters carry -- the enclosing function's
  # symbols are not in scope inside a lifted one -- so entering one replaces
  # this map and leaving restores it.
  dict_env: Map[String, CExpr],
  # the function whose body is being lowered, as that body sees itself
  self_ctx: Option[SelfCtx],
  # whether the expression being lowered sits in tail position
  tail: Bool,
  # set once a self tail call was actually rewritten, so only the functions
  # that need the wrapper loop pay for it
  self_tail: Bool
}

## The function currently being lowered, as its own body sees it. Two things
## need this. A local named function is not in its own capture list -- the
## checker strips the binding -- so rebuilding its closure is the only way to
## name it inside its own body. And spec §12.4 guarantees a self tail call
## compiles to a loop rather than a frame, which is a rewrite, not an
## optimisation: without it deep self-recursion overflows the stack.
##
## Doing both here rather than in a backend is the point of Core. The JVM
## emitter used to carry `self_pending`/`cur_fn`/`fn_start` for exactly this,
## and the C backend would have needed its own copy.
pub type SelfCtx = {
  # Some for a local named function, reached through its binding; None for a
  # top-level one, reached by name
  sym: Option[Int],
  owner: String,
  name: String,
  # a lifted body takes its captures as leading parameters, so rebuilding the
  # closure means passing them again
  caps: List[CExpr],
  # what a tail call reassigns before jumping
  params: List[Int],
  ptys: List[Ty],
  fty: Ty,
  loop_id: Int
}

fn fresh_sym(st: LSt) -> (LSt, Int) =
  (LSt { ..st, next_sym: st.next_sym + 1 }, st.next_sym)

fn fresh_loop(st: LSt) -> (LSt, Int) =
  (LSt { ..st, next_loop: st.next_loop + 1 }, st.next_loop)

# ---- boxing ----

## The one erasure rule, materialised. A value heading into a slot whose
## declared type is a type variable gets boxed; coming back out it gets
## unboxed. emit.dawn recomputed this at every argument position; Core
## decides it once, here.
fn adapt_in(e: CExpr, actual: Ty, declared: Ty) -> CExpr =
  # peeled on both sides: whether a slot is erased is a question about the
  # representation, and an opaque type's representation is its target's.
  # A projection over a rigid subject is an erased slot exactly like the
  # TyVar it projects from (assoc-types-design.md 4.1).
  match peel_opaque(declared) {
    TyVar(_, _) | TyAssoc(_, _, _) ->
      match peel_opaque(actual) {
        TyVar(_, _) | TyAssoc(_, _, _) -> e
        _ -> CBox(e, actual)
      }
    _ -> e
  }

## The intrinsics whose declared signature *is* their ABI: a type variable in a
## slot means that slot is erased, exactly as it does for a Dawn function, and
## the backend emits one plain call against the declared descriptor. So the box
## and the unbox belong here, in Core, like they do at every other call.
##
## The rest of the table is excluded because its backend handlers read the
## Core node's own type rather than the declared one -- `unwrap_or` stores its
## fallback in a slot sized by the *result* type, so boxing it here would break
## it. That split has always been implicit; naming it is what makes calling one
## of these with a concrete argument work at all. Before, `map_insert(m, "k",
## 5)` written directly in std (rather than through the generic wrapper that
## had already erased 5) emitted a long where the descriptor said Object, and
## the class failed verification.
## The signature of an intrinsic whose arguments and result cross erased -- a
## container primitive. Which those are is declared with the intrinsic
## (types.intrinsics) rather than guessed from the name here.
fn erased_builtin_sig(name: String) -> Option[Sig] =
  match intr_at(name) {
    Some(i) -> if i.erased { Some(i.sig) } else { None }
    None -> None
  }

fn adapt_out(e: CExpr, declared: Ty, actual: Ty) -> CExpr =
  match peel_opaque(declared) {
    TyVar(_, _) | TyAssoc(_, _, _) ->
      match peel_opaque(actual) {
        TyVar(_, _) | TyAssoc(_, _, _) -> e
        _ -> CUnbox(e, actual)
      }
    _ -> e
  }

# ---- operators ----

fn bin_op(op: TBinOp) -> CBinOp =
  match op {
    BAdd -> CAdd
    BSub -> CSub
    BMul -> CMul
    BDiv -> CDiv
    BMod -> CMod
    BConcat -> CConcat
    BEq -> CEq
    BNeq -> CNe
    BLt -> CLt
    BLe -> CLe
    BGt -> CGt
    BGe -> CGe
    BAnd -> CAnd
    BOr -> COr
    BBand -> CBand
    BBor -> CBor
    BBxor -> CBxor
    BShl -> CShl
    BShr -> CShr
    BUshr -> CUshr
  }

fn un_op(op: TUnOp) -> CUnOp =
  match op {
    UNeg -> CNeg
    UNot -> CNot
    UBnot -> CBnot
  }

# ---- to-string, for interpolation ----

## Interpolation is lowered here rather than left to the backends, which is
## why the vocabulary is Core's own (`str_of_int`, ...) rather than any
## backend's. Each backend maps these names to its runtime.
## `to_string(e)` and `${e}`: the *unquoted* rendering, where a String is
## itself. Everything else is `show_at`, the trait method -- see its comment
## for why the two cannot be one.
##
## `wit` is what the call site resolved. It matters for exactly one shape: a
## rigid type variable, whose dictionary is a parameter of the enclosing
## function and so cannot be found from the type alone.
fn to_str(st: LSt, e: CExpr, t: Ty, wit: Option[WitRef]) -> (LSt, CExpr) =
  # `to_string` of a String is the String itself, and that is a fact about the
  # *representation* -- so an opaque type over String must not pick up the
  # quoting `show` gives a String inside a structure. It does not follow that
  # it inherits the identity: an `impl Show[Secret]` is the whole reason the
  # type was declared, and it wins here as it does everywhere else (spec §324,
  # and it already won inside a record). Peeling the whole stack up front is
  # how a redacting `Show` came to print the plaintext for `to_string(secret)`
  # while `Box { s: secret }` redacted it (audit SEM-03), so the peel is one
  # layer at a time with the impl question asked in between.
  if t == TyString {
    (st, e)
  } else if t == TyUnit {
    (st, CStr("()"))
  } else {
    match t {
      TyOpaque(_, _, _, tgt) ->
        if has_own_show(st, t) { show_at(st, e, t) } else { to_str(st, e, tgt, wit) }
      TyVar(_, _) ->
        match wit {
          Some(w) -> {
            let (st1, d) = witness_value(st, w)
            show_through_dict(st1, d, e, t)
          }
          None -> show_at(st, e, t)
        }
      _ -> show_at(st, e, t)
    }
  }

## Does `t` have a `Show` impl written on `t` itself -- the same question
## `show_at` asks before it lets an opaque type fall through to its target.
fn has_own_show(st: LSt, t: Ty) -> Bool =
  if has_impl_at(st.impls, SHOW_ID, t) {
    provides(impl_for(st, SHOW_ID, t), "show")
  } else {
    false
  }

# ---- constructor fields ----

## A constructor field is STORED at its declared type, which for a generic
## ADT is a type variable and therefore boxed. Reading it back at the
## concrete type is an unbox, and writing a concrete value into it is a box.
##
## The JVM emitter does this inline at every field access (adapt_from /
## adapt_to on the declared type); Core has to make it explicit, or the
## second backend simply will not know the field is erased. Getting it wrong
## is invisible on a backend whose fields are a union -- which is why the C
## backend was happy before this was written.
fn declared_field_ty(st: LSt, adt: Int, ci: Int, idx: Int) -> Ty = {
  let a = adt_of(st.adts, adt)
  let c = a.ctors[ci]
  if idx < len(c.fields) { c.fields[idx].ty } else { TyError }
}

## The declared field type with the ADT's type arguments substituted in.
fn concrete_field_ty(st: LSt, scrut: Ty, adt: Int, ci: Int, idx: Int) -> Ty = {
  let a = adt_of(st.adts, adt)
  let c = a.ctors[ci]
  if idx >= len(c.fields) {
    return TyError
  }
  let targs =
    match scrut {
      TyAdt(_, args) -> args
      _ -> []
    }
  var m: Map[Int, Ty] = map.empty()
  var k = 0
  for tp in a.tparams {
    match tp {
      TyVar(_, vid) ->
        if k < len(targs) {
          m = map.insert(m, vid, targs[k])
        }
      _ -> ()
    }
    k = k + 1
  }
  subst(c.fields[idx].ty, m, map.empty())
}

## Read a constructor field, unboxing if the field is declared at a type
## variable but used at a concrete type.
fn read_field(st: LSt, target: CExpr, scrut: Ty, adt: Int, ci: Int, idx: Int) -> CExpr = {
  let declared = declared_field_ty(st, adt, ci, idx)
  let concrete = concrete_field_ty(st, scrut, adt, ci, idx)
  adapt_out(CField(target, adt, ci, idx, declared), declared, concrete)
}

# ---- patterns ----

## A pattern compiles to (test, binds): a short-circuiting condition over
## projections of `subj`, and the bindings to establish once it holds.
##
## The test must short-circuit: a nested projection is only valid after the
## enclosing discriminant test passed, so `CAnd` carries a real obligation
## on both backends, not just an optimisation.
fn pat_test(st: LSt, subj: CExpr, p: TPat, t: Ty) -> (LSt, CExpr, List[CStmt]) =
  match p {
    TPWild -> (st, CBool(true), [])
    TPBind(sym, _) -> (st, CBool(true), [CSLet(sym, sym_ty(st, sym, t), subj)])
    TPLit(v) -> (st, lit_eq(subj, v, t), [])
    TPTuple(elems) -> {
      var st1 = st
      var cond: CExpr = CBool(true)
      var binds: List[CStmt] = []
      var i = 0
      let ets =
        match t {
          TyTuple(xs) -> xs
          _ -> []
        }
      for sub in elems {
        let et = if i < len(ets) { ets[i] } else { pat_ty(st1, sub) }
        let (st2, c, bs) = pat_test(st1, CTupleGet(subj, i, et), sub, et)
        st1 = st2
        cond = and_of(cond, c)
        binds = binds ++ bs
        i = i + 1
      }
      (st1, cond, binds)
    }
    TPCtor(adt, ci, field_pats) -> {
      var st1 = st
      var cond: CExpr = CIsCtor(subj, adt, ci)
      var binds: List[CStmt] = []
      var i = 0
      for fp in field_pats {
        match fp {
          Some(sub) -> {
            let ft = concrete_field_ty(st1, t, adt, ci, i)
            let proj = read_field(st1, subj, t, adt, ci, i)
            let (st2, c, bs) = pat_test(st1, proj, sub, ft)
            st1 = st2
            cond = and_of(cond, c)
            binds = binds ++ bs
          }
          None -> ()
        }
        i = i + 1
      }
      (st1, cond, binds)
    }
    TPList(pre, has_rest, rest_sym, post) ->
      lower_list_pattern(st, subj, t, pre, has_rest, rest_sym, post)
  }

## A list pattern: a length test plus element tests at fixed offsets from
## each end. `..rest` binds the middle. Once D2/D3 make List an ordinary
## Dawn ADT this becomes a plain constructor pattern and disappears.
fn lower_list_pattern(
  st: LSt,
  subj: CExpr,
  t: Ty,
  pre: List[TPat],
  has_rest: Bool,
  rest_sym: Option[Int],
  post: List[TPat]
) -> (LSt, CExpr, List[CStmt]) = {
  let et =
    match t {
      TyList(e) -> e
      _ -> TyError
    }
  let n = len(pre) + len(post)
  let count = CIntrinsic("len", [subj], TyInt)
  var cond: CExpr =
    if has_rest {
      CBinary(CGe, count, CInt(n), TyBool)
    } else {
      CBinary(CEq, count, CInt(n), TyBool)
    }
  var binds: List[CStmt] = []
  var st1 = st
  var i = 0
  for p in pre {
    let elem = adapt_out(
      CIntrinsic("list_index", [subj, CInt(i)], TyVar("E", 0)), TyVar("E", 0), et)
    let (st2, c, bs) = pat_test(st1, elem, p, et)
    st1 = st2
    cond = and_of(cond, c)
    binds = binds ++ bs
    i = i + 1
  }
  var j = len(post)
  for p in post {
    # counted from the end, so a `..rest` of unknown width does not shift it
    let idx = CBinary(CSub, count, CInt(j), TyInt)
    let elem = adapt_out(
      CIntrinsic("list_index", [subj, idx], TyVar("E", 0)), TyVar("E", 0), et)
    let (st2, c, bs) = pat_test(st1, elem, p, et)
    st1 = st2
    cond = and_of(cond, c)
    binds = binds ++ bs
    j = j - 1
  }
  match rest_sym {
    Some(rs) -> {
      binds = binds ++ [CSLet(rs, t,
        CIntrinsic("list_slice",
          [subj, CInt(len(pre)), CBinary(CSub, count, CInt(len(post)), TyInt)], t))]
    }
    None -> ()
  }
  (st1, cond, binds)
}

## The type a projection should be read at. TPCtor does not carry field
## types, but the checker already typed every binding, so the sub-pattern
## tells us: a bind knows its symbol's type, a literal knows its own, and a
## nested pattern is by construction a reference.
##
## Reaching for the ADT table here would work too, but it would put a table
## in Core's lowering that Core itself does not need.
fn pat_ty(st: LSt, p: TPat) -> Ty =
  match p {
    TPBind(sym, _) -> sym_ty(st, sym, TyError)
    TPLit(v) ->
      match v {
        LInt(_) -> TyInt
        LFloat(_) -> TyFloat
        LBool(_) -> TyBool
        LStr(_) -> TyString
      }
    TPCtor(adt, _, _) -> TyAdt(adt, [])
    TPTuple(elems) -> TyTuple([])
    TPList(_, _, _, _) -> TyError
    TPWild -> TyError
  }

fn sym_ty(st: LSt, sym: Int, fallback: Ty) -> Ty =
  match map.get(st.syms, sym) {
    Some(s) -> s.ty
    None -> fallback
  }

## Option/Result payload types, needed to rebuild an `Err` when `?`
## propagates it.
fn field_ty(t: Ty, adt: Int, ci: Int, idx: Int) -> Ty =
  if adt == OPTION_ID && ci == SOME_CI {
    match t {
      TyAdt(_, args) -> if len(args) > 0 { args[0] } else { TyError }
      _ -> TyError
    }
  } else if adt == RESULT_ID && ci == OK_CI {
    match t {
      TyAdt(_, args) -> if len(args) > 0 { args[0] } else { TyError }
      _ -> TyError
    }
  } else if adt == RESULT_ID && ci == ERR_CI {
    match t {
      TyAdt(_, args) -> if len(args) > 1 { args[1] } else { TyError }
      _ -> TyError
    }
  } else {
    TyError
  }

fn and_of(a: CExpr, b: CExpr) -> CExpr =
  match a {
    CBool(true) -> b
    _ ->
      match b {
        CBool(true) -> a
        _ -> CBinary(CAnd, a, b, TyBool)
      }
  }

fn lit_eq(subj: CExpr, v: LitV, t: Ty) -> CExpr =
  match v {
    LInt(n) -> CBinary(CEq, subj, CInt(n), TyBool)
    LFloat(f) -> CBinary(CEq, subj, CFloat(f), TyBool)
    LBool(b) -> CBinary(CEq, subj, CBool(b), TyBool)
    LStr(s) -> CBinary(CEq, subj, CStr(s), TyBool)
  }

# ---- the intrinsics lowering emits that no user ever writes ----

## The intrinsic names Core carries that `types.intrinsics()` does not declare.
##
## A different contract from the user builtins in where the name comes from --
## nobody can write one -- but not in what a backend owes: every name here is
## something lowering hands over on a path that has no alternative, and
## `inline_intrinsics` below says the same of the builtins that survive
## lowering. Both are checked together, by the test under those lists.
##
## This was a comment until 2026-07-30, and a comment cannot be checked: it
## still listed `map_index`, which stopped being emitted when `m[k]` became a
## call on `std/hamt.index`, and it counted the entries twice with two
## different answers ("thirteen more", "all twelve"). It is a list now because
## the comptime gate in interp.dawn reads it -- an intrinsic in neither this
## list nor `types.intrinsics()` is a name no dispatcher should have an arm
## for, which is how the three dead arms were found (audit RC-09).
##
##   cmp hash            the prelude relation at a scalar, after `prim_relation`
##                       collapses it -- these two are why `cmp(3, 9)` stopped
##                       looking for a trait default that does not exist
##   java_eq java_hash   equality and hash of a value that came from the host,
##                       the two Dawn does not define. `java_eq` was
##                       `struct_eq`, a runtime structural walk for anything
##                       lowering could not spell out; the checker refuses
##                       those now, so nothing but a foreign object reaches
##                       either and a backend with no Java owes nothing here
##   show quote          rendering an erased value, and a nested String
##   str_of_int/bool/bytes
##                       the scalar renderings `to_str` settles without a
##                       witness; `str_of_bytes` joined them when the erased
##                       `show` stopped having to guess at a Bytes (audit RP-02).
##                       `str_of_float` left the family when the Float
##                       rendering became Dawn source (std/fmt.dtoa, audit
##                       RP-01) -- `show_at` writes a direct call, so no
##                       backend owes a float renderer any more
##   list_index list_slice
##                       `xs[i]` and a list pattern's `..rest`
##   null_ref            the zero of a reference type, for an uninitialised slot
##
## Not an ADT, though the comment this replaces proposed one. Measured before
## deciding: `CIntrinsic` carries a `String` because it also carries the 89
## user builtin names, so an ADT for these twelve either splits the node in
## two or swallows all 101, and the `name == "..."` comparisons that would have
## to be rewritten numbered 44 in interp, 28 in emit and 24 in emitc when that
## was measured. A list the gate reads buys the property the ADT was wanted for
## -- a backend cannot forget one silently -- for twelve lines instead of that.
pub fn internal_intrinsics() -> List[String] = [
  "cmp", "hash", "java_eq", "java_hash", "show", "quote",
  "str_of_int", "str_of_bool", "str_of_bytes",
  "list_index", "list_slice", "null_ref"
]

# ---- who implements a primitive ----
#
# `types.Intr.rt` answers this for the primitives a runtime module owns, and
# both emitters read that one field: a runtime-owned primitive cannot be
# implemented on one backend and missing on the other, because neither backend
# gets to have an opinion about which ones they are.
#
# `rt == None` answered nothing at all. It covered three unrelated groups --
# written inline, written inline on one backend only, removed before any
# backend sees it -- and the only record of which was which was the
# `name == "..."` chain inside each emitter. So "this backend is short one
# primitive" and "no backend owes this primitive" were the same observation
# from inside an emitter, and the difference between them surfaced as a
# `panic` in the *user's* compile, on whichever backend was short, and only if
# something reached that name. scripts/spike-native/known-red.txt says the
# same thing about itself: an empty file means the corpus stopped catching
# these, not that the native backend is complete.
#
# The three groups are declared below and they partition the intrinsic
# universe -- `types.builtins()` plus `internal_intrinsics()` above. The test
# at the end of this section checks the partition; scripts/intrinsic-parity.py
# checks that each emitter's chain has exactly the arms the groups say it
# should, which is the half no test can reach (an arm is instructions, not a
# value).
#
# What is deliberately *not* declared here: the value representation and the
# reference-counting ABI -- `dawn_adt_new`, `dawn_box_int`, `dawn_rc_dup` and
# the rest of runtime/c/dawn_rt.h. Those are not intrinsics; no Dawn name
# reaches them and no JVM counterpart exists. `dawn_adt_new` takes a field
# mask, which is a C memory layout: hoisting it into a table both backends
# read would be putting one backend's habit in the shared layer and calling
# the layer neutral, the failure docs/runtime-intrinsics-design.md §8 names.
# The note on `Intr.rt` in types.dawn records this table committing exactly
# that once already, when it carried a `(class, method)` pair the second
# backend could not read.

## The primitives every backend writes the instructions for itself.
##
## Spelled out rather than derived from `internal_intrinsics()` and the
## builtins, because a derivation is only as good as the thing it derives
## from and this list is what the parity gate reads. The partition test below
## is what keeps it honest: drop a name here and the name lands in no group.
pub fn inline_intrinsics() -> List[String] = [
  # lowering's own vocabulary, all of it but the two host ones below
  "cmp", "hash", "show", "quote",
  "str_of_int", "str_of_bool", "str_of_bytes",
  "list_index", "list_slice", "null_ref",
  # neither of these returns, so both are instructions rather than a call
  "panic", "todo",
  # one instruction each: the JVM's L2D and D2L, and native's saturating
  # counterpart for the second (C's cast is undefined where D2L saturates)
  "to_float", "to_int",
  # the list primitives, which each backend turns into a call on the Dawn
  # vector in std/pvec -- one definition, compiled twice. They stay Core
  # intrinsics because the comptime interpreter implements them on its own
  # value representation (gen_list_intrinsic says why at length)
  "len", "get", "range", "sort_by",
  # an Option opened without a runtime call, so the failure is a panic raised
  # where the caller stands, and the reclaim, whose result shape each backend
  # builds itself
  "expect", "unwrap_or", "cast",
  # settled by lowering; a residual one is a lowering bug and both backends
  # refuse it in the same words. An arm all the same -- the refusal names the
  # operand type, which the generic "no mapping" panic cannot
  "to_string",
  # the ones that traffic in lists: each reaches a runtime function through a
  # List↔Array conversion the emitter wraps around the call, so the plain
  # table entry would promise a call neither emitter can make
  "join", "code_points", "from_code_points", "io_list_names", "io_run",
  # the range check belongs to the emitter on both backends, for opposite
  # reasons -- the JVM runtime answers null and this turns it into the panic,
  # the native runtime panics itself
  "cursor_slice",
  # argv arrives differently on each: a static field on the class here, a
  # runtime call there
  "args"
]

## The two only the JVM owes an arm for.
##
## Both take a value that came from the host, and `use java` is the only thing
## that produces one -- a node emitc refuses outright. So this is a fact about
## the backends rather than a gap in one of them, and emitc's generic refusal
## is the right answer if either ever reaches it.
pub fn jvm_only_intrinsics() -> List[String] = ["java_eq", "java_hash"]

## The builtins no backend ever sees: lowering rewrites each into something
## else, so an arm for one of these is dead code rather than an implementation.
##
## Map and Set become calls on the Dawn trie in std/hamt
## (collections-dejava-research §5.1); `parse_int`/`parse_int_radix` become
## calls on std/fmt, which is why `parse_float` is the only numeric parser
## left with a runtime method (audit RP-05).
##
## Written down because "nobody owes this" and "one backend is short" are
## indistinguishable from inside an emitter: both are `rt == None` with no
## case. Three arms of exactly this kind were found dead in the interpreter
## on 2026-07-30 (audit RC-09) and there was no equivalent check here.
## `char_unchecked` joins them for the plainest reason of all: `Char`'s
## representation is `Int`, so the bridge is the identity and lowering drops
## it. A backend never learns the name.
pub fn lowered_intrinsics() -> List[String] = {
  var out = ["parse_int", "parse_int_radix", "char_unchecked"]
  for op in ["empty", "from", "insert", "remove", "get", "has", "size", "keys", "values",
    "entries"] {
    out = out ++ ["map_" ++ op]
  }
  for op in ["empty", "from", "insert", "remove", "has", "size", "to_list"] {
    out = out ++ ["set_" ++ op]
  }
  out
}

test "every intrinsic is owned by a runtime module, written inline, or removed by lowering" {
  let inline = inline_intrinsics()
  let host = jvm_only_intrinsics()
  let gone = lowered_intrinsics()
  let it = intrinsics()
  let internal = internal_intrinsics()

  # 1. the four groups partition the universe. This is what makes a new
  #    primitive impossible to forget: added to `types.builtins()` and to none
  #    of the groups, it lands nowhere and this fails by name.
  for n in map.keys(it) ++ internal {
    var groups = 0
    match map.get(it, n) {
      Some(i) ->
        match i.rt {
          Some(_) -> { groups = groups + 1 }
          None -> ()
        }
      None -> ()
    }
    if list.contains(inline, n) { groups = groups + 1 }
    if list.contains(host, n) { groups = groups + 1 }
    if list.contains(gone, n) { groups = groups + 1 }
    if groups != 1 {
      panic("`" ++ n ++ "` is in " ++ to_string(groups) ++ " of the four " ++
          "implementation groups; every intrinsic belongs to exactly one")
    }
  }

  # 2. nothing on a list is outside the universe. This is the direction that
  #    rotted in the interpreter's copy -- arms outliving their producers --
  #    and a name misspelled here would otherwise read as a group of one.
  for n in inline ++ host ++ gone {
    if not (map.has(it, n) || list.contains(internal, n)) {
      panic("`" ++ n ++ "` is classified but is not an intrinsic")
    }
  }

  # 3. the sizes the comments above quote. A count written in prose is what
  #    went wrong in `internal_intrinsics`, whose comment gave two different
  #    answers for the same list in the same paragraph.
  assert len(inline) == 29
  assert len(host) == 2
  assert len(gone) == 20
  # and the four groups account for all 103 names, with none left over
  assert len(map.keys(it)) == 91
  assert len(internal) == 12
}

# ---- trait witnesses ----

## A stable name for the dictionary of (trait, subject). Backends use it as
## a symbol, so it must be spellable in both C and JVM identifiers.
## `ty_key_inst` and not `ty_key`: a structural witness names its subject
## here, and a structural subject can be an instantiated generic. `ty_key`
## drops ADT type arguments on purpose (it names v1 impl subjects, which are
## never generic), so it would give `Option[Int]` and `Option[String]` the
## same dictionary.
fn dict_key(tid: Int, subject: Ty) -> String =
  "dict$" ++ to_string(tid) ++ "$" ++ ty_key_inst(subject)

## The trait method's signature with the subject substituted in and its
## projections rewritten to the impl's own bindings: what the impl's own
## method actually takes (the checker pinned that shape at registration), so
## a devirtualised call boxes nothing -- and, since assoc types, so it boxes
## *correctly*: `Cur = Int` makes the slot an unboxed Int, `Item = T` keeps
## it erased, and the trait-side spelling `C.Cur`/`C.Item` says neither.
fn subst_subject(tr: TraitI, sg: Sig, subject: Ty, bindings: List[(String, Ty)]) -> Sig = {
  let vid =
    match tr.tvar {
      TyVar(_, v) -> v
      _ -> panic("lower: trait subject is not a type variable")
    }
  var m: Map[Int, Ty] = map.empty()
  m = map.insert(m, vid, subject)
  var ps: List[Ty] = []
  for p in sg.param_tys {
    ps = ps ++ [reduce_via_bindings(subst(p, m, map.empty()), tr.id, subject, bindings)]
  }
  Sig {
    ..sg,
    param_tys: ps,
    ret: reduce_via_bindings(subst(sg.ret, m, map.empty()), tr.id, subject, bindings)
  }
}

fn trait_method_sig(tr: TraitI, name: String) -> Sig = {
  for entry in tr.methods {
    let (mn, ms) = entry
    if mn == name { return ms.sig }
  }
  panic("lower: trait `" ++ tr.name ++ "` has no method `" ++ name ++ "`")
}

## Lower arguments and box each against its declared parameter type. This is
## the boxing materialisation: it happens once, here, instead of at every
## argument position in every backend.
fn lower_args_to(st: LSt, args: List[TExpr], decl: List[Ty]) -> (LSt, List[CExpr]) = {
  var st1 = st
  var out: List[CExpr] = []
  var i = 0
  for a in args {
    let (st2, v) = lower_expr(st1, a)
    st1 = st2
    let d = if i < len(decl) { decl[i] } else { tex_ty(a) }
    out = out ++ [adapt_in(v, tex_ty(a), d)]
    i = i + 1
  }
  (st1, out)
}

fn sig_of(st: LSt, owner: String, name: String) -> Option[Sig] =
  map.get(st.prog_fns, (owner, name))

fn impl_for(st: LSt, tid: Int, subject: Ty) -> ImplI =
  match impl_at(st.impls, tid, subject) {
    Some(i) -> i
    None -> panic("lower: no impl for trait " ++ to_string(tid))
  }

fn provides(imp: ImplI, name: String) -> Bool = {
  for p in imp.provided {
    if p == name { return true }
  }
  false
}

fn method_index(tr: TraitI, name: String) -> Int = {
  var i = 0
  for entry in tr.methods {
    let (mn, _ms) = entry
    if mn == name { return i }
    i = i + 1
  }
  panic("lower: trait `" ++ tr.name ++ "` has no method `" ++ name ++ "`")
}

fn owner_or(o: Option[String], fallback: String) -> String =
  match o {
    Some(x) -> x
    None -> fallback
  }

## The type of a dictionary as Core sees it: erased, like every other value a
## backend chooses its own representation for. The pseudo-id is named in
## types.dawn because `is_ref_ty` needs the same answer from the type alone.
fn dict_ty() -> Ty = TyAdt(DICT_ADT_ID, [])

## Build (once) the dictionary for a ground witness and return a reference to
## it. Every slot is resolved here, so a backend only has to lay out pointers.
fn dict_ref(st: LSt, tid: Int, subject: Ty) -> (LSt, CExpr) = {
  # Ground, so every sub-goal is ground too and its dictionary is a compile
  # time constant: this dictionary takes no arguments even where the impl
  # behind it is conditional. Its slots still have to *pass* those constants,
  # which is what `false` here tells them.
  let (st1, key) = dict_def(st, tid, subject, sub_goals(st.impls, tid, subject), false)
  (st1, CDictRef(key, tid, subject, dict_ty()))
}

## Register the definition of one dictionary, keyed so it is built once.
##
## `argtys` names the types this dictionary is a function of -- empty for
## every dictionary the language had before trait v2, and otherwise the
## subject's own type arguments (§3.8). A slot body finds those arguments
## back through the dictionary it is already handed, so the argument list
## changes what the slots may *read*, not what shape they have.
fn dict_def(
  st: LSt,
  tid: Int,
  subject: Ty,
  goals: List[(Int, Ty)],
  param: Bool
) -> (LSt, String) = {
  let key = dict_key(tid, subject)
  for d in st.dicts {
    if d.key == key { return (st, key) }
  }
  let tr = trait_of(st.traits, tid)
  # reserve the key first: a slot body may itself reference this same
  # dictionary, and without the reservation that would recurse forever
  var st1 = LSt {
    ..st,
    dicts: st.dicts ++
      [CDictDef {
        key: key,
        trait_id: tid,
        subject: subject,
        nargs: if param { len(goals) } else { 0 },
        slots: []
      }]
  }
  var slots: List[CDictSlot] = []
  for entry in tr.methods {
    let (mn, ms) = entry
    let (st2, slot) = dict_slot(st1, tr, tid, subject, key, goals, param, mn, ms)
    st1 = st2
    slots = slots ++ [slot]
  }
  var out: List[CDictDef] = []
  for d in st1.dicts {
    if d.key == key {
      out = out ++ [CDictDef { ..d, slots: slots }]
    } else {
      out = out ++ [d]
    }
  }
  (LSt { ..st1, dicts: out }, key)
}

## One slot: the impl's own method, the trait's default, or -- where there is
## neither -- the relation the language itself defines.
##
## That third case is the prelude Eq/Hash/Ord over a scalar and the structural
## default over everything else. It used to have no Core representation at
## all: the JVM hand-wrote the body twice in bytecode (`gen_prelude_*_impl`,
## `gen_structural_*_impl`) and Core emitted `CSlotDefault` naming a default
## the trait does not have, which is why the C backend named symbols nothing
## defined. Synthesising an ordinary function is the move `make_bridge`
## already makes -- past this point no backend knows the slot was special.
fn dict_slot(
  st: LSt,
  tr: TraitI,
  tid: Int,
  subject: Ty,
  key: String,
  goals: List[(Int, Ty)],
  param: Bool,
  mn: String,
  ms: MethodSig
) -> (LSt, CDictSlot) = {
  if has_impl_at(st.impls, tid, subject) {
    let imp = impl_for(st, tid, subject)
    if provides(imp, mn) {
      let (st1, bridge) =
        make_bridge(st, tr, tid, subject, owner_or(imp.owner, st.owner), mn, key, goals, param)
      return (st1, CSlotFn(st1.owner, bridge))
    }
  }
  if ms.has_default {
    return (st, CSlotDefault(owner_or(tr.owner, st.owner), mn))
  }
  let (st1, name) = make_prim_slot(st, tr, tid, subject, key, goals, param, mn)
  (st1, CSlotFn(st1.owner, name))
}

## Synthesise the bridge that lets an impl method sit in a dictionary slot:
## it takes the trait's generic (erased) parameters plus the dictionary,
## unboxes them into the impl's concrete signature, and boxes the result
## back. Ordinary top-level function from here on -- no backend knows it is
## special.
fn make_bridge(
  st: LSt,
  tr: TraitI,
  tid: Int,
  subject: Ty,
  iowner: String,
  method: String,
  key: String,
  goals: List[(Int, Ty)],
  param: Bool
) -> (LSt, String) = {
  let sg = trait_method_sig(tr, method)
  # only reached when the impl provides this method (dict_slot checked), so
  # the lookup cannot miss
  let psig = subst_subject(tr, sg, subject, impl_for(st, tid, subject).assoc_bindings)
  # `ty_key_inst`, not `ty_key`: a conditional impl's bridge names the
  # dictionary class it reads its arguments out of, so `Box[Int]` and
  # `Box[Box[Int]]` need different bridges. For a non-generic subject the two
  # spellings agree, which is why nothing that existed before changed name.
  let name = "bridge$" ++ to_string(tid) ++ "$" ++ ty_key_inst(subject) ++ "$" ++ method
  if list.any(st.lifted, f => f.name == name) {
    (st, name)
  } else {
    var st1 = st
    var ps: List[CParam] = []
    var args: List[CExpr] = []
    var i = 0
    for gt in sg.param_tys {
      let (st2, sym) = fresh_sym(st1)
      st1 = st2
      ps = ps ++ [CParam { sym: sym, ty: gt, mode: COwned }]
      args = args ++ [adapt_out(CLocal(sym, gt), gt, psig.param_tys[i])]
      i = i + 1
    }
    # Every slot has the same signature, so the dictionary parameter is always
    # there. For a conditional impl it is also where the impl's own
    # dictionaries come from.
    let (st3, dsym) = fresh_sym(st1)
    st1 = st3
    # A conditional impl's method is generic: it wants a dictionary per bound,
    # and the only place to get them is the dictionary this bridge was handed.
    var ds: List[CExpr] = []
    var gi = 0
    for g in goals {
      let (gt, gty) = g
      if param {
        ds = ds ++ [CDictArg(CLocal(dsym, dict_ty()), st1.owner, key, gi, dict_ty())]
      } else {
        let (stG, d) = dict_expr(st1, gt, gty)
        st1 = stG
        ds = ds ++ [d]
      }
      gi = gi + 1
    }
    let call = CCall(CImpl(iowner, tid, subject, method), args ++ ds, psig.ret)
    let f = CFun {
      name: name,
      owner: st1.owner,
      captures: [],
      params: ps,
      dicts: [CParam { sym: dsym, ty: TyAdt(-1, []), mode: COwned }],
      evs: [],
      ret: sg.ret,
      body: adapt_in(call, psig.ret, sg.ret),
      is_test: false,
      impl_of: None,
      default_of: None
    }
    (LSt { ..st1, lifted: st1.lifted ++ [f] }, name)
  }
}

## The body of a relation the language defines rather than a program.
##
## One definition, two callers: `lower_trait_call` uses it where the subject
## is statically known (no dictionary is built at all), and `make_prim_slot`
## uses it to fill a dictionary slot where one is. That the devirtualised
## form and the forwarded form are the same relation is now a fact about the
## code rather than a claim in a comment.
fn prim_relation(st: LSt, tid: Int, subject: Ty, args: List[CExpr]) -> (LSt, CExpr) = {
  if tid == EQ_ID { return eq_at(st, args[0], args[1], subject) }
  if tid == HASH_ID { return hash_at(st, args[0], subject) }
  if tid == ORD_ID { return cmp_at(st, args[0], args[1], subject) }
  if tid == SHOW_ID { return show_at(st, args[0], subject) }
  if tid == INDEX_ID { return index_at(st, args[0], args[1], subject) }
  panic("lower: no primitive relation for trait " ++ to_string(tid))
}

## What `prim_relation` actually takes and returns at one subject, as opposed
## to the erased slot signature the trait declares.
##
## Every crossing between the two is a box or an unbox, so both sides have to
## be spelled. Eq/Ord/Hash/Show take the subject in every parameter and answer
## with a scalar, which is why one `subject` used to stand in for the whole
## signature. `Index` is the first prelude relation for which that is false:
## parameter 1 is `C.Idx`, and adapting it as if it were `C` casts an Int to a
## List. Asked here rather than read off the impl because the impl's binding
## RHS is verbatim (`Item = T`, the impl's own parameter) -- right for a real
## callee's ABI, wrong for a relation spelled out at the instantiated subject.
fn prim_param_ty(tid: Int, subject: Ty, i: Int) -> Ty =
  if tid == INDEX_ID && i == 1 { index_idx_ty(subject) } else { subject }

fn prim_ret_ty(tid: Int, subject: Ty) -> Ty =
  if tid == EQ_ID {
    TyBool
  } else if tid == HASH_ID || tid == ORD_ID {
    TyInt
  } else if tid == SHOW_ID {
    TyString
  } else if tid == INDEX_ID {
    index_item_ty(subject)
  } else {
    panic("lower: no primitive relation for trait " ++ to_string(tid))
  }

## Wrap `prim_relation` in a top-level function with the trait method's own
## (erased) signature, so it can sit in a dictionary slot like any other.
##
## The trailing dictionary parameter used to be dead weight -- every slot has
## one, and a primitive relation needed nothing from it. For a parameterised
## dictionary it is the whole mechanism: the arguments the dictionary was
## built from are read back out of it. That is why the slot signature did not
## have to change, and why a `CMethod` call site looks the same whether or not
## the dictionary it dispatches through happens to take arguments.
fn make_prim_slot(
  st: LSt,
  tr: TraitI,
  tid: Int,
  subject: Ty,
  key: String,
  goals: List[(Int, Ty)],
  param: Bool,
  method: String
) -> (LSt, String) = {
  let sg = trait_method_sig(tr, method)
  let name = "prim$" ++ to_string(tid) ++ "$" ++ ty_key_inst(subject) ++ "$" ++ method
  if list.any(st.lifted, f => f.name == name) { return (st, name) }
  var st1 = st
  var ps: List[CParam] = []
  var args: List[CExpr] = []
  var i = 0
  for gt in sg.param_tys {
    let (st2, sym) = fresh_sym(st1)
    st1 = st2
    ps = ps ++ [CParam { sym: sym, ty: gt, mode: COwned }]
    # Per parameter, not `subject` for all of them: see `prim_param_ty`. For
    # Eq/Ord/Hash/Show every parameter *is* the subject, so this is the same
    # expression it always was.
    args = args ++ [adapt_out(CLocal(sym, gt), gt, prim_param_ty(tid, subject, i))]
    i = i + 1
  }
  let (st3, dsym) = fresh_sym(st1)
  st1 = st3
  var env: Map[String, CExpr] = map.empty()
  var ai = 0
  for g in goals {
    let (gt, gty) = g
    if param {
      env = map.insert(env, dict_key(gt, gty),
        CDictArg(CLocal(dsym, dict_ty()), st1.owner, key, ai, dict_ty()))
    }
    ai = ai + 1
  }
  let (st4, body0) = prim_relation(LSt { ..st1, dict_env: env }, tid, subject, args)
  # ...and the result crosses back out the same way. A scalar answer needs no
  # box, which is every relation but `Index`.
  let body = adapt_in(body0, prim_ret_ty(tid, subject), sg.ret)
  let f = CFun {
    name: name,
    owner: st4.owner,
    captures: [],
    params: ps,
    dicts: [CParam { sym: dsym, ty: dict_ty(), mode: COwned }],
    evs: [],
    ret: sg.ret,
    body: body,
    is_test: false,
    impl_of: None,
    default_of: None
  }
  (LSt { ..st4, lifted: st4.lifted ++ [f], dict_env: st.dict_env }, name)
}

# ---- structural equality (docs/semantics-closure-design.md 3) ----
#
# `a == b` used to reach the backends as a bare `CBinary(CEq, ..)` whatever
# the operand type was, and Core said nothing about what it meant. Each
# consumer therefore invented an answer: Object.equals on the JVM, C's `==`
# on native, a hand-written walk in the interpreter, another in the tuple
# class. Seven of them, and they disagreed.
#
# Now the relation is spelled out here, once, over the type's own structure.
# What a backend still gets to implement is only the two ends: the scalars it
# compares natively, and `java_eq` on a value that came from the host.

## Is there a dictionary this body could use for `t`, without inventing one?
##
## Three ways there is. One is in scope, put there by the enclosing witness or
## by the enclosing synthesised body's own parameters. Or `t` is ground, so a
## static singleton settles it. Or `t` has no structure for the compiler to
## walk, so its dictionary's slots need no dictionary for the parts either.
##
## The one case that fails is a bare rigid variable with nothing in scope for
## it, and the checker refuses that before lowering sees it. Asking first,
## rather than building and discovering, is what keeps the failure a question
## here instead of a half-built body to unwind.
fn dict_available(st: LSt, tid: Int, t: Ty) -> Bool =
  match map.get(st.dict_env, dict_key(tid, t)) {
    Some(_) -> true
    None ->
      match t {
        TyVar(_, _) -> false
        _ ->
          if is_ground(t) || not expandable(t) {
            true
          } else {
            goals_available(st, sub_goals(st.impls, tid, t))
          }
      }
  }

fn goals_available(st: LSt, goals: List[(Int, Ty)]) -> Bool = {
  for g in goals {
    let (gt, gty) = g
    if not dict_available(st, gt, gty) { return false }
  }
  true
}

fn goal_dicts(st: LSt, goals: List[(Int, Ty)]) -> (LSt, List[CExpr]) = {
  var st1 = st
  var out: List[CExpr] = []
  for g in goals {
    let (gt, gty) = g
    let (st2, d) = dict_expr(st1, gt, gty)
    st1 = st2
    out = out ++ [d]
  }
  (st1, out)
}

## The dictionary for `t`, as an expression. Only called where
## `dict_available` already said yes.
##
## A non-ground subject with structure is where trait v2 shows: its dictionary
## is not a constant but a construction, built from its arguments' -- and its
## arguments' may themselves be constructions.
fn dict_expr(st: LSt, tid: Int, t: Ty) -> (LSt, CExpr) =
  match map.get(st.dict_env, dict_key(tid, t)) {
    Some(d) -> (st, d)
    None ->
      if is_ground(t) || not expandable(t) {
        dict_ref(st, tid, t)
      } else {
        let goals = sub_goals(st.impls, tid, t)
        let (st1, ds) = goal_dicts(st, goals)
        let (st2, key) = dict_def(st1, tid, t, goals, true)
        (st2, CDictApply(key, ds, dict_ty()))
      }
  }

fn conj(acc: Option[CExpr], c: CExpr) -> CExpr =
  match acc {
    None -> c
    Some(e) -> CBinary(CAnd, e, c, TyBool)
  }

fn conj_or_true(acc: Option[CExpr]) -> CExpr =
  match acc {
    Some(e) -> e
    None -> CBool(true)
  }

## `a == b` at one type, as Core. **Every** producer of a Dawn equality goes
## through here: the `==` operator, a `[T: Eq]` bound instantiated at a
## concrete type, and each field inside a synthesised comparison. Before this
## the first two were separate pipelines from the language's first day -- the
## operator never consulted a witness at all -- which is the first cause of
## the relation having had several definitions.
## The type an equality is really taken at: an opaque type with no `impl Eq`
## of its own is its target (spec §2.7), which is the peel `eq_at` does below.
fn eq_subject(st: LSt, t: Ty) -> Ty =
  match t {
    TyOpaque(_, _, _, tgt) ->
      if has_impl_at(st.impls, EQ_ID, t) { t } else { eq_subject(st, tgt) }
    _ -> t
  }

fn eq_at(st: LSt, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) = {
  # the scalars a backend compares natively. From here on `CBinary(CEq, ..)`
  # means this and nothing else.
  if is_eq_scalar(t) { return (st, CBinary(CEq, a, b, TyBool)) }
  # an explicit `impl Eq` wins over structure, exactly as it does when the
  # same comparison arrives through a bound
  if has_impl_at(st.impls, EQ_ID, t) {
    let imp = impl_for(st, EQ_ID, t)
    if provides(imp, "eq") {
      let (st1, ds) = goal_dicts(st, sub_goals(st.impls, EQ_ID, t))
      return (st1, CCall(
        CImpl(owner_or(imp.owner, st1.owner), EQ_ID, t, "eq"), [a, b] ++ ds, TyBool))
    }
  }
  # An opaque type with no `impl Eq` of its own compares as its target: the
  # value behind the barrier *is* that target (spec 2.7). After the impl
  # check, for the reason show_at gives -- an `impl Eq[Id]` is the point of
  # declaring one -- and before `is_ground`, which would send it to
  # `foreign_eq` and panic.
  match t {
    TyOpaque(_, _, _, tgt) -> return eq_at(st, a, b, tgt)
    _ -> ()
  }
  if is_ground(t) {
    if expandable(t) {
      let (st1, name) = struct_eq_fn(st, t)
      return (st1, CCall(CDirect(st1.owner, name), [a, b], TyBool))
    }
    return (st, foreign_eq(a, b, t))
  }
  # Not ground: what this compares depends on a type only the caller knows.
  # If a dictionary for the whole is in scope, that dictionary *is* the
  # answer -- go through it rather than guessing at the structure behind it.
  match map.get(st.dict_env, dict_key(EQ_ID, t)) {
    Some(d) -> return eq_through_dict(st, d, a, b, t)
    None -> ()
  }
  # Otherwise spell the whole out over its parts, passing each part's
  # dictionary down. That is the same expansion the ground case gets, minus
  # the luxury of knowing what the parts are.
  if expandable(t) && goals_available(st, sub_goals(st.impls, EQ_ID, t)) {
    let (st1, ds) = goal_dicts(st, sub_goals(st.impls, EQ_ID, t))
    let (st2, name) = struct_eq_fn(st1, t)
    return (st2, CCall(CDirect(st2.owner, name), [a, b] ++ ds, TyBool))
  }
  (st, foreign_eq(a, b, t))
}

## The one equality Dawn does not define: a value that came from the host.
##
## This used to be `struct_eq`, a runtime structural walk reached by anything
## lowering could not spell out -- a Unit, a rigid variable, a composite over
## one. The checker closes all of those now (`structural_gap`,
## `solved_structurally`), so the only value left with no Dawn definition is a
## foreign object, and its equality belongs to the runtime it came from. A
## backend with no Java has nothing to implement here, which is why native
## stopped owing an implementation of the walk.
fn foreign_eq(a: CExpr, b: CExpr, t: Ty) -> CExpr =
  match t {
    TyJava(_, _) -> CIntrinsic("java_eq", [a, b], TyBool)
    _ -> panic("lower: no equality for `" ++ ty_key_inst(t) ++
        "`; the checker should have refused it")
  }

## Compare through a dictionary: the only shape available where the type is a
## rigid variable, since there is no structure to walk and no impl to name.
## The slot has the trait's own erased signature, so the operands are boxed
## exactly as they are for any other dictionary call.
fn eq_through_dict(st: LSt, d: CExpr, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) = {
  let tr = trait_of(st.traits, EQ_ID)
  let sg = trait_method_sig(tr, "eq")
  let idx = method_index(tr, "eq")
  (st, adapt_out(
    CCall(CMethod(d, EQ_ID, "eq", idx),
      [adapt_in(a, t, sg.param_tys[0]), adapt_in(b, t, sg.param_tys[1])], sg.ret),
    sg.ret, TyBool))
}

## The relation the compiler writes for one composite type, as an ordinary
## top-level function -- no backend knows it is special, the same way no
## backend knows about a dictionary bridge.
##
## Keyed by the *instantiated* type, not the declaration: `Option[Int]` and
## `Option[Point]` need different comparisons, and a JVM class (one per
## declaration) could not carry both.
##
## A non-ground type takes one dictionary parameter per type argument and
## reaches its parts through them. So `Option[T]` gets one function rather
## than one per instantiation: Dawn passes dictionaries instead of
## monomorphising, and this is that decision reaching the relations the
## compiler writes for itself.
##
## Equality and ordering share this scaffold because they are the same
## construction over the same structure. They used to share nothing: equality
## was lowered here and ordering was written directly as JVM bytecode, which
## is why the C backend emitted calls to a derived `cmp` it never defined.
fn struct_rel_fn(
  st: LSt,
  t: Ty,
  prefix: String,
  tid: Int,
  arity: Int,
  ret: Ty,
  zero: CExpr,
  body_of: fn(LSt, List[CExpr], Ty) -> (LSt, CExpr)
) -> (LSt, String) = {
  let name = prefix ++ ty_key_inst(t)
  for f in st.lifted {
    if f.name == name { return (st, name) }
  }
  var st1 = st
  var ps: List[CParam] = []
  var xs: List[CExpr] = []
  var k = 0
  while k < arity {
    let (stA, sym) = fresh_sym(st1)
    st1 = stA
    ps = ps ++ [CParam { sym: sym, ty: t, mode: COwned }]
    xs = xs ++ [CLocal(sym, t)]
    k = k + 1
  }
  let no_goals: List[(Int, Ty)] = []
  let goals = if is_ground(t) { no_goals } else { sub_goals(st.impls, tid, t) }
  var stD = st1
  var dps: List[CParam] = []
  var env: Map[String, CExpr] = map.empty()
  for g in goals {
    let (gt, gty) = g
    let (stA, dsym) = fresh_sym(stD)
    stD = stA
    dps = dps ++ [CParam { sym: dsym, ty: dict_ty(), mode: COwned }]
    env = map.insert(env, dict_key(gt, gty), CLocal(dsym, dict_ty()))
  }
  # publish the name before building the body: a recursive type reaches this
  # same function from inside itself, and without the reservation that
  # recurses until the stack ends
  let stub = CFun {
    name: name,
    owner: stD.owner,
    captures: [],
    params: ps,
    dicts: dps,
    evs: [],
    ret: ret,
    body: zero,
    is_test: false,
    impl_of: None,
    default_of: None
  }
  let st2 = LSt { ..stD, lifted: stD.lifted ++ [stub], dict_env: env }
  let (st3, body) = body_of(st2, xs, t)
  var out: List[CFun] = []
  for f in st3.lifted {
    if f.name == name {
      out = out ++ [CFun { ..f, body: body }]
    } else {
      out = out ++ [f]
    }
  }
  (LSt { ..st3, lifted: out, dict_env: st.dict_env }, name)
}

fn struct_eq_fn(st: LSt, t: Ty) -> (LSt, String) =
  struct_rel_fn(st, t, "structeq\$", EQ_ID, 2, TyBool, CBool(true),
    (s, xs, ty) => struct_eq_body(s, xs[0], xs[1], ty))

fn struct_eq_body(st: LSt, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) =
  match t {
    TyTuple(elems) -> {
      var st1 = st
      var acc: Option[CExpr] = None
      var i = 0
      for et in elems {
        let (st2, c) = eq_at(st1, CTupleGet(a, i, et), CTupleGet(b, i, et), et)
        st1 = st2
        acc = Some(conj(acc, c))
        i = i + 1
      }
      (st1, conj_or_true(acc))
    }
    TyAdt(aid, _) -> {
      let info = adt_of(st.adts, aid)
      # one constructor: there is no discriminant to disagree about
      if len(info.ctors) == 1 {
        return ctor_fields_eq(st, a, b, t, aid, 0)
      }
      # several: `a` picks the arm and `b` has to be in the same one. Built
      # back to front so the last `else` is the honest `false`.
      var st1 = st
      var chain: CExpr = CBool(false)
      var ci = len(info.ctors) - 1
      while ci >= 0 {
        let (st2, fe) = ctor_fields_eq(st1, a, b, t, aid, ci)
        st1 = st2
        let same = if len(info.ctors[ci].fields) == 0 {
          CIsCtor(b, aid, ci)
        } else {
          CBinary(CAnd, CIsCtor(b, aid, ci), fe, TyBool)
        }
        chain = CIf(CIsCtor(a, aid, ci), same, Some(chain), TyBool)
        ci = ci - 1
      }
      (st1, chain)
    }
    _ -> panic("lower: struct_eq_body on a type with no structure to compare")
  }

fn ctor_fields_eq(st: LSt, a: CExpr, b: CExpr, sc: Ty, aid: Int, ci: Int) -> (LSt, CExpr) = {
  let c = adt_of(st.adts, aid).ctors[ci]
  var st1 = st
  var acc: Option[CExpr] = None
  var idx = 0
  while idx < len(c.fields) {
    let ft = concrete_field_ty(st1, sc, aid, ci, idx)
    let (st2, e) = eq_at(st1,
      read_field(st1, a, sc, aid, ci, idx),
      read_field(st1, b, sc, aid, ci, idx), ft)
    st1 = st2
    acc = Some(conj(acc, e))
    idx = idx + 1
  }
  (st1, conj_or_true(acc))
}

# ---- structural ordering (docs/trait-v2-design.md 3.6) ----
#
# `derive Ord`'s body used to be written straight into JVM bytecode
# (`gen_derived_ord_cmp` / `emit_field_cmp` / `cmp_fields`), so Core never
# carried it. The C backend therefore emitted a *call* to `impl$0$Adt<n>$cmp`
# and no definition -- an undefined symbol, with no diagnostic anywhere. This
# is the same move `eq_at` is: one definition, spelled over the type's own
# structure, and both backends compile it.
#
# Writing it here is also what unblocks `derive Ord` on a generic type. The
# derived comparison of `Box[T]` needs `Ord[T]`, and a dictionary parameter is
# something a lowered function can take and a hand-written bytecode body
# cannot.

## `cmp(a, b)` at one type, as Core. The Ord counterpart of `eq_at`, and every
## producer of an ordering goes through it: `cmp`, the comparison operators,
## a `[T: Ord]` bound instantiated at a concrete type, and each field inside a
## derived comparison.
##
## There is no fallback branch. Unlike equality, ordering is not defined for
## every type -- the checker refuses `Ord` where no impl and no derive supply
## it -- so reaching the end here is a compiler bug rather than a gap.
fn cmp_at(st: LSt, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) = {
  if is_ord_scalar(t) { return (st, CIntrinsic("cmp", [a, b], TyInt)) }
  if has_impl_at(st.impls, ORD_ID, t) {
    let imp = impl_for(st, ORD_ID, t)
    if provides(imp, "cmp") {
      let (st1, ds) = goal_dicts(st, sub_goals(st.impls, ORD_ID, t))
      return (st1, CCall(
        CImpl(owner_or(imp.owner, st1.owner), ORD_ID, t, "cmp"), [a, b] ++ ds, TyInt))
    }
  }
  # as in eq_at: the target's ordering, once the impl has had its chance
  match t {
    TyOpaque(_, _, _, tgt) -> return cmp_at(st, a, b, tgt)
    _ -> ()
  }
  if is_ground(t) {
    if expandable(t) {
      let (st1, name) = struct_cmp_fn(st, t)
      return (st1, CCall(CDirect(st1.owner, name), [a, b], TyInt))
    }
    panic("lower: no ordering for " ++ ty_key_inst(t))
  }
  match map.get(st.dict_env, dict_key(ORD_ID, t)) {
    Some(d) -> return cmp_through_dict(st, d, a, b, t)
    None -> ()
  }
  if expandable(t) && goals_available(st, sub_goals(st.impls, ORD_ID, t)) {
    let (st1, ds) = goal_dicts(st, sub_goals(st.impls, ORD_ID, t))
    let (st2, name) = struct_cmp_fn(st1, t)
    return (st2, CCall(CDirect(st2.owner, name), [a, b] ++ ds, TyInt))
  }
  panic("lower: no ordering for " ++ ty_key_inst(t))
}

fn cmp_through_dict(st: LSt, d: CExpr, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) = {
  let tr = trait_of(st.traits, ORD_ID)
  let sg = trait_method_sig(tr, "cmp")
  let idx = method_index(tr, "cmp")
  (st, adapt_out(
    CCall(CMethod(d, ORD_ID, "cmp", idx),
      [adapt_in(a, t, sg.param_tys[0]), adapt_in(b, t, sg.param_tys[1])], sg.ret),
    sg.ret, TyInt))
}

fn struct_cmp_fn(st: LSt, t: Ty) -> (LSt, String) =
  struct_rel_fn(st, t, "structcmp$", ORD_ID, 2, TyInt, CInt(0),
    (s, xs, ty) => struct_cmp_body(s, xs[0], xs[1], ty))

fn struct_cmp_body(st: LSt, a: CExpr, b: CExpr, t: Ty) -> (LSt, CExpr) =
  match t {
    TyTuple(elems) -> {
      var st1 = st
      var parts: List[CExpr] = []
      var i = 0
      for et in elems {
        let (st2, c) = cmp_at(st1, CTupleGet(a, i, et), CTupleGet(b, i, et), et)
        st1 = st2
        parts = parts ++ [c]
        i = i + 1
      }
      lexicographic(st1, parts, 0)
    }
    TyAdt(aid, _) -> {
      let info = adt_of(st.adts, aid)
      # one constructor: nothing to disagree about but the fields
      if len(info.ctors) == 1 {
        return ctor_fields_cmp(st, a, b, t, aid, 0)
      }
      # Constructor order first, declaration order being the order. Built back
      # to front so the last `else` is unreachable-but-honest: `a` is one of
      # them, and the tags already agreed.
      var st1 = st
      var chain: CExpr = CInt(0)
      var ci = len(info.ctors) - 1
      while ci >= 0 {
        let (st2, fe) = ctor_fields_cmp(st1, a, b, t, aid, ci)
        st1 = st2
        chain = CIf(CIsCtor(a, aid, ci), fe, Some(chain), TyInt)
        ci = ci - 1
      }
      let (st3, ta) = fresh_sym(st1)
      let (st4, tb) = fresh_sym(st3)
      # Disagreeing tags answer -1/1, not the tag difference: `cmp` contracts
      # the sign only (spec 3.5), and the raw subtraction leaked how far apart
      # the constructors were declared.
      (st4, CBlock(
        [CSLet(ta, TyInt, CTagOf(a, aid)), CSLet(tb, TyInt, CTagOf(b, aid))],
        Some(CIf(
          CBinary(CNe, CLocal(ta, TyInt), CLocal(tb, TyInt), TyBool),
          CIf(
            CBinary(CLt, CLocal(ta, TyInt), CLocal(tb, TyInt), TyBool),
            CInt(-1), Some(CInt(1)), TyInt),
          Some(chain), TyInt)),
        TyInt))
    }
    _ -> panic("lower: struct_cmp_body on a type with no structure to order")
  }

fn ctor_fields_cmp(st: LSt, a: CExpr, b: CExpr, sc: Ty, aid: Int, ci: Int) -> (LSt, CExpr) = {
  let c = adt_of(st.adts, aid).ctors[ci]
  var st1 = st
  var parts: List[CExpr] = []
  var idx = 0
  while idx < len(c.fields) {
    let ft = concrete_field_ty(st1, sc, aid, ci, idx)
    let (st2, e) = cmp_at(st1,
      read_field(st1, a, sc, aid, ci, idx),
      read_field(st1, b, sc, aid, ci, idx), ft)
    st1 = st2
    parts = parts ++ [e]
    idx = idx + 1
  }
  lexicographic(st1, parts, 0)
}

## Fold field comparisons into one: the first non-zero wins, and each is
## evaluated only if every earlier one tied. A `let` per step, because the
## result is read twice -- once to test it, once to return it.
fn lexicographic(st: LSt, parts: List[CExpr], i: Int) -> (LSt, CExpr) = {
  if i >= len(parts) { return (st, CInt(0)) }
  if i == len(parts) - 1 { return (st, parts[i]) }
  let (st1, rest) = lexicographic(st, parts, i + 1)
  let (st2, sym) = fresh_sym(st1)
  (st2, CBlock(
    [CSLet(sym, TyInt, parts[i])],
    Some(CIf(
      CBinary(CNe, CLocal(sym, TyInt), CInt(0), TyBool),
      CLocal(sym, TyInt),
      Some(rest), TyInt)),
    TyInt))
}

# ---- structural hashing (docs/semantics-closure-design.md 3) ----
#
# The fourth member of the family, and until 2026-07-28 the only one still a
# bare `CIntrinsic("hash", ..)` whatever the subject was. On the JVM that
# reached `Object.hashCode`, which for a generated class is a method the
# emitter writes straight as bytecode; native had no answer past the scalars,
# so a tuple key was the first wall `dawn __emitc selfhost` hit.
#
# Two of the answers had to be chosen rather than preserved, because the JVM's
# were not answers a Core body can reproduce:
#
#   * A constructor with no fields got no `hashCode` at all, so it inherited
#     Object's -- the identity hash of the singleton instance. That is not a
#     function of the value: the same `Origin` hashes differently in two
#     programs, and no second backend can produce it. It is the fold over no
#     fields now.
#
#   * The tag was absent, while `==` and `cmp` both consult it. With the
#     identity hash gone, leaving it absent would put every nullary
#     constructor of every type in one bucket -- `TyInt`, `TyBool`, `TyString`
#     and the rest of this compiler's own `Ty` among them. So the tag folds in
#     as a leading field, and only where there is more than one constructor to
#     tell apart, which is the condition the other two relations already use.
#
# Everything else keeps the number it had: seed 1, `h = 31*h + hash(part)`,
# left to right, which is what the emitted `hashCode` did and what
# `java.util.Arrays.hashCode` does.

## One step of the fold.
fn mix(h: CExpr, part: CExpr) -> CExpr =
  CBinary(CAdd, CBinary(CMul, h, CInt(31), TyInt), part, TyInt)

## Sign-extend the low 32 bits back into Dawn's 64-bit Int.
##
## The fold is 32-bit arithmetic -- that is where the numbers come from, and
## the scalars hand back 32-bit answers to begin with. Running it wide and
## narrowing once at the end gives the same result as narrowing every step
## (both are the same arithmetic mod 2^32), and costs three instructions
## instead of three per field.
##
## Written as mask/flip/subtract rather than `(h << 32) >> 32` because every
## operand stays below 2^32: no shift of a negative, and nothing for C's
## signed-overflow rules to have an opinion about.
fn narrow32(e: CExpr) -> CExpr =
  CBinary(CSub,
    CBinary(CBxor, CBinary(CBand, e, CInt(0xFFFFFFFF), TyInt), CInt(0x80000000), TyInt),
    CInt(0x80000000), TyInt)

## `hash(x)` at one type, as Core. The Hash counterpart of `eq_at`, and every
## producer goes through it: the `hash` method, a `[K: Eq + Hash]` bound at a
## concrete key type, and each field inside a synthesised hash.
fn hash_at(st: LSt, x: CExpr, t: Ty) -> (LSt, CExpr) = {
  # the scalars a backend hashes itself. Float is deliberately not among them
  # (types.hash_scalars): no hash can agree with an equality where -0.0 == 0.0.
  if is_hash_scalar(t) { return (st, CIntrinsic("hash", [x], TyInt)) }
  if has_impl_at(st.impls, HASH_ID, t) {
    let imp = impl_for(st, HASH_ID, t)
    if provides(imp, "hash") {
      let (st1, ds) = goal_dicts(st, sub_goals(st.impls, HASH_ID, t))
      return (st1, CCall(
        CImpl(owner_or(imp.owner, st1.owner), HASH_ID, t, "hash"), [x] ++ ds, TyInt))
    }
  }
  # as in eq_at: an opaque type hashes as its target, once its own impl has
  # had its chance
  match t {
    TyOpaque(_, _, _, tgt) -> return hash_at(st, x, tgt)
    _ -> ()
  }
  if is_ground(t) {
    if expandable(t) {
      let (st1, name) = struct_hash_fn(st, t)
      return (st1, CCall(CDirect(st1.owner, name), [x], TyInt))
    }
    return (st, foreign_hash(x, t))
  }
  match map.get(st.dict_env, dict_key(HASH_ID, t)) {
    Some(d) -> return hash_through_dict(st, d, x, t)
    None -> ()
  }
  if expandable(t) && goals_available(st, sub_goals(st.impls, HASH_ID, t)) {
    let (st1, ds) = goal_dicts(st, sub_goals(st.impls, HASH_ID, t))
    let (st2, name) = struct_hash_fn(st1, t)
    return (st2, CCall(CDirect(st2.owner, name), [x] ++ ds, TyInt))
  }
  (st, foreign_hash(x, t))
}

## The one hash Dawn does not define, and `foreign_eq`'s twin: a value that
## came from the host hashes the way the host hashes it, or the two would stop
## agreeing inside the same Map. A backend with no Java owes nothing here.
fn foreign_hash(x: CExpr, t: Ty) -> CExpr =
  match t {
    TyJava(_, _) -> CIntrinsic("java_hash", [x], TyInt)
    _ -> panic("lower: no hash for `" ++ ty_key_inst(t) ++
        "`; the checker should have refused it")
  }

fn hash_through_dict(st: LSt, d: CExpr, x: CExpr, t: Ty) -> (LSt, CExpr) = {
  let tr = trait_of(st.traits, HASH_ID)
  let sg = trait_method_sig(tr, "hash")
  let idx = method_index(tr, "hash")
  (st, adapt_out(
    CCall(CMethod(d, HASH_ID, "hash", idx), [adapt_in(x, t, sg.param_tys[0])], sg.ret),
    sg.ret, TyInt))
}

fn struct_hash_fn(st: LSt, t: Ty) -> (LSt, String) =
  struct_rel_fn(st, t, "structhash\$", HASH_ID, 1, TyInt, CInt(1),
    (s, xs, ty) => struct_hash_body(s, xs[0], ty))

fn struct_hash_body(st: LSt, x: CExpr, t: Ty) -> (LSt, CExpr) =
  match t {
    TyTuple(elems) -> {
      var st1 = st
      var acc: CExpr = CInt(1)
      var i = 0
      for et in elems {
        let (st2, hp) = hash_at(st1, CTupleGet(x, i, et), et)
        st1 = st2
        acc = mix(acc, hp)
        i = i + 1
      }
      (st1, narrow32(acc))
    }
    TyAdt(aid, _) -> {
      let info = adt_of(st.adts, aid)
      # one constructor: there is no tag to tell anything apart with
      if len(info.ctors) == 1 {
        let (st1, e) = ctor_fields_hash(st, x, t, aid, 0, CInt(1))
        return (st1, narrow32(e))
      }
      # several: the tag folds in first, then that arm's fields.
      #
      # A constructor with no fields has nothing to fold, so its answer *is*
      # the seed -- which is what the final `else` says. Only the ones with
      # fields need an arm, and a union of bare tags needs no test at all:
      # `Ty` and `Head` in this compiler are exactly that shape, and asking
      # them thirteen times which one they are to arrive at the same
      # expression is the sort of thing a structural expansion writes if
      # nobody looks at what it wrote.
      let (st1, tsym) = fresh_sym(st)
      let seed = mix(CInt(1), CLocal(tsym, TyInt))
      var stx = st1
      var chain: CExpr = seed
      var ci = len(info.ctors) - 1
      while ci >= 0 {
        if len(info.ctors[ci].fields) > 0 {
          let (st2, fe) = ctor_fields_hash(stx, x, t, aid, ci, seed)
          stx = st2
          chain = CIf(CIsCtor(x, aid, ci), fe, Some(chain), TyInt)
        }
        ci = ci - 1
      }
      (stx, CBlock(
        [CSLet(tsym, TyInt, CTagOf(x, aid))], Some(narrow32(chain)), TyInt))
    }
    _ -> panic("lower: struct_hash_body on a type with no structure to walk")
  }

fn ctor_fields_hash(
  st: LSt,
  x: CExpr,
  sc: Ty,
  aid: Int,
  ci: Int,
  seed: CExpr
) -> (LSt, CExpr) = {
  let c = adt_of(st.adts, aid).ctors[ci]
  var st1 = st
  var acc = seed
  var idx = 0
  while idx < len(c.fields) {
    let ft = concrete_field_ty(st1, sc, aid, ci, idx)
    let (st2, hp) = hash_at(st1, read_field(st1, x, sc, aid, ci, idx), ft)
    st1 = st2
    acc = mix(acc, hp)
    idx = idx + 1
  }
  (st1, acc)
}

# ---- rendering (docs/semantics-closure-design.md 6) ----
#
# `to_string` and every `${...}` used to reach `dawn/rt/Show`, an instanceof
# chain that asks a value at run time what it is. A tagged union has no arm in
# that chain: it falls through to `String.valueOf`, which finds a `toString`
# the JVM emitter wrote straight as bytecode. Core carried neither end, so the
# C backend had nothing to compile -- `show_derive:emitc` is that gap.
#
# The rendering is spelled out here now, over the type's own structure, and
# both backends compile one definition. What a backend still implements is the
# two ends: the scalars, and (until S3) the builtin containers.

fn cat(a: CExpr, b: CExpr) -> CExpr = CBinary(CConcat, a, b, TyString)

## `show(x)` at one type, as Core.
##
## This is the *nested* rendering -- the trait method -- so a String is
## quoted. `to_str` is the other one: `to_string("a")` is `a`, while a String
## field inside a record renders as `"a"`. One trait cannot be both, and the
## language has drawn that line since its first day (Rust draws it as Display
## vs Debug); what changes here is only that both sides now come from Core.
fn show_at(st: LSt, x: CExpr, t: Ty) -> (LSt, CExpr) = {
  if t == TyInt { return (st, CIntrinsic("str_of_int", [x], TyString)) }
  # Float is the one scalar whose rendering is not a backend intrinsic: the
  # shortest-round-trip algorithm is Dawn source (std/fmt.dtoa, audit RP-01),
  # and both backends compile that one definition. std/fmt itself must never
  # render a Float through `to_string`/interpolation -- this rewrite would
  # make it a self-call.
  if t == TyFloat { return (st, CCall(CDirect("std/fmt", "dtoa"), [x], TyString)) }
  if t == TyBool { return (st, CIntrinsic("str_of_bool", [x], TyString)) }
  if t == TyString { return (st, CIntrinsic("quote", [x], TyString)) }
  # The fifth show scalar (types.dawn's `show_scalars`), and the only one that
  # used to fall off the end of this function into the erased `show` below.
  # It has no structure to walk -- the language renders it as a summary of its
  # length, not as its contents -- so it belongs with the other four: named,
  # unerased, one arm per backend. Erased, it was unimplementable on native,
  # where a `void*` and a kind tag are all there is to identify a value by.
  if t == TyBytes { return (st, CIntrinsic("str_of_bytes", [x], TyString)) }
  if has_impl_at(st.impls, SHOW_ID, t) {
    let imp = impl_for(st, SHOW_ID, t)
    if provides(imp, "show") {
      let (st1, ds) = goal_dicts(st, sub_goals(st.impls, SHOW_ID, t))
      return (st1, CCall(
        CImpl(owner_or(imp.owner, st1.owner), SHOW_ID, t, "show"), [x] ++ ds, TyString))
    }
  }
  # An opaque type with no impl of its own renders as its target: the value
  # on the other side of the barrier is that target. Placed *after* the impl
  # check, because an `impl Show[Id]` is exactly the reason to declare one.
  match t {
    TyOpaque(_, _, _, tgt) -> return show_at(st, x, tgt)
    _ -> ()
  }
  if is_ground(t) && expandable(t) {
    let (st1, name) = struct_show_fn(st, t)
    return (st1, CCall(CDirect(st1.owner, name), [x], TyString))
  }
  match map.get(st.dict_env, dict_key(SHOW_ID, t)) {
    Some(d) -> return show_through_dict(st, d, x, t)
    None -> ()
  }
  if expandable(t) {
    let goals = sub_goals(st.impls, SHOW_ID, t)
    if goals_available(st, goals) {
      let (st1, ds) = goal_dicts(st, goals)
      let (st2, name) = struct_show_fn(st1, t)
      return (st2, CCall(CDirect(st2.owner, name), [x] ++ ds, TyString))
    }
  }
  # The last resort: hand the value over erased and let a runtime identify it.
  #
  # This used to carry Bytes and the builtin containers. S3 made the
  # containers ordinary Dawn types with `impl[T: Show] Show[List[T]]` in std,
  # and Bytes is named above, so nothing known reaches this arm any more --
  # every type the checker gives a Show witness to is answered before here.
  #
  # It stays rather than becoming the panic below, and the reason is a cost
  # asymmetry rather than a producer. What the JVM does with an erased value
  # (`dawn/rt/Show.show`, an instanceof chain ending in `String.valueOf`) is a
  # real best-effort answer; native has none and cannot have one, so its
  # emitter refuses and says which type it refused. Deleting the arm would
  # turn a type this list has not foreseen into a compiler panic on *both*
  # backends, which is worse than the JVM keeping an answer native declines.
  if not expandable(t) {
    return (st, CIntrinsic("show", [adapt_in(x, t, TyVar("T", 0))], TyString))
  }
  panic("lower: no rendering for " ++ ty_key_inst(t))
}

fn show_through_dict(st: LSt, d: CExpr, x: CExpr, t: Ty) -> (LSt, CExpr) = {
  let tr = trait_of(st.traits, SHOW_ID)
  let sg = trait_method_sig(tr, "show")
  let idx = method_index(tr, "show")
  (st, adapt_out(
    CCall(CMethod(d, SHOW_ID, "show", idx), [adapt_in(x, t, sg.param_tys[0])], sg.ret),
    sg.ret, TyString))
}

fn struct_show_fn(st: LSt, t: Ty) -> (LSt, String) =
  struct_rel_fn(st, t, "structshow$", SHOW_ID, 1, TyString, CStr(""),
    (s, xs, ty) => struct_show_body(s, xs[0], ty))

fn struct_show_body(st: LSt, x: CExpr, t: Ty) -> (LSt, CExpr) =
  match t {
    TyTuple(elems) -> {
      var st1 = st
      var acc: CExpr = CStr("(")
      var i = 0
      for et in elems {
        if i > 0 { acc = cat(acc, CStr(", ")) }
        let (st2, s) = show_at(st1, CTupleGet(x, i, et), et)
        st1 = st2
        acc = cat(acc, s)
        i = i + 1
      }
      (st1, cat(acc, CStr(")")))
    }
    TyAdt(aid, _) -> {
      let info = adt_of(st.adts, aid)
      # one constructor: there is no tag to test
      if len(info.ctors) == 1 {
        return ctor_show(st, x, t, aid, 0)
      }
      # Built back to front, so the last `else` is unreachable-but-honest:
      # `x` is one of them.
      var st1 = st
      var chain: CExpr = CStr("")
      var ci = len(info.ctors) - 1
      while ci >= 0 {
        let (st2, r) = ctor_show(st1, x, t, aid, ci)
        st1 = st2
        chain = CIf(CIsCtor(x, aid, ci), r, Some(chain), TyString)
        ci = ci - 1
      }
      (st1, chain)
    }
    _ -> panic("lower: struct_show_body on a type with no structure to render")
  }

## `Name`, `Name(v0, v1)`, or `Name { f0: v0, f1: v1 }` -- the shape the JVM
## emitter wrote by hand, kept to the character so no program's output moves.
fn ctor_show(st: LSt, x: CExpr, sc: Ty, aid: Int, ci: Int) -> (LSt, CExpr) = {
  let info = adt_of(st.adts, aid)
  let c = info.ctors[ci]
  if len(c.fields) == 0 { return (st, CStr(c.name)) }
  let open = if info.is_record { " { " } else { "(" }
  var st1 = st
  var acc: CExpr = CStr(c.name ++ open)
  var idx = 0
  while idx < len(c.fields) {
    if idx > 0 { acc = cat(acc, CStr(", ")) }
    if info.is_record { acc = cat(acc, CStr(c.fields[idx].name ++ ": ")) }
    let ft = concrete_field_ty(st1, sc, aid, ci, idx)
    let (st2, s) = show_at(st1, read_field(st1, x, sc, aid, ci, idx), ft)
    st1 = st2
    acc = cat(acc, s)
    idx = idx + 1
  }
  (st1, cat(acc, CStr(if info.is_record { " }" } else { ")" })))
}

## Does this witness stand for a relation the language defines itself, rather
## than for an impl body to call?
##
## Three shapes qualify: the prelude Eq/Hash over a scalar, the prelude Ord
## over an ordered scalar, and the structural Eq/Hash default. None of them
## has an impl with a body, so a call has to reach `prim_relation` -- routing
## Ord's here instead is what fixes `cmp(3, 9)`, which used to compile and
## then die at run time looking for a trait default that does not exist.
fn subject_of(w: WitRef) -> Ty =
  match w {
    WConcrete(_, s) -> s
    WApply(_, s, _) -> s
    WForward(_) -> panic("lower: a forwarded witness has no subject")
  }

## Does this call have to reach `prim_relation` rather than a method body?
##
## The table says so. A derived impl is compiler-owned by definition; an
## underived bodyless impl is primitive only when it is one of the prelude
## rows minted without a source owner. A user's empty impl can inherit trait
## defaults, so treating every empty `provided` list as primitive skips the
## `CDefault` body. No impl at all means Eq/Hash's structural default.
fn primitive_witness(st: LSt, w: WitRef, tid: Int) -> Bool =
  match w {
    WConcrete(_, subject) -> primitive_subject(st, tid, subject)
    WApply(_, subject, _) -> primitive_subject(st, tid, subject)
    WForward(_) -> false
  }

fn primitive_subject(st: LSt, tid: Int, subject: Ty) -> Bool =
  match impl_at(st.impls, tid, subject) {
    # A derived impl has no body either -- the compiler is the one that
    # defines it, which is the same answer the prelude's scalar impls give.
    # It used to be the opposite, and that is how the derived comparison
    # ended up written twice: once in bytecode, never in Core.
    Some(imp) -> imp.derived ||
      (imp.owner == None && imp.src_path == None && len(imp.provided) == 0)
    None -> tid == EQ_ID || tid == HASH_ID
  }

## `!=`, given what `==` lowered to. A scalar comparison keeps its own node:
## `CNe` is a relation both backends implement directly, and wrapping it in a
## `not` would cost an instruction for nothing. This used to be decided by
## asking whether the type was a scalar, which stopped working when `==`
## started carrying a witness for every type -- the shape of the answer is the
## honest question, not the shape of the type.
fn negated(c: CExpr) -> CExpr =
  match c {
    CBinary(CEq, a, b, _) -> CBinary(CNe, a, b, TyBool)
    _ -> CUnary(CNot, c, TyBool)
  }

fn is_eq_op(op: TBinOp) -> Bool =
  match op {
    BEq -> true
    BNeq -> true
    _ -> false
  }

## A witness as a value, for the hidden trailing arguments of a generic call.
fn witness_value(st: LSt, w: WitRef) -> (LSt, CExpr) =
  match w {
    WForward(sym) -> (st, CLocal(sym, TyAdt(-1, [])))
    # The structural default is not a different kind of dictionary, only one
    # whose slots the compiler supplies -- which is why deleting WStructural
    # changed nothing here.
    WConcrete(tid, subject) -> dict_ref(st, tid, subject)
    # ...and a non-ground subject is not a different kind either, only one
    # that cannot be a constant: same slots, built per use out of the
    # arguments' dictionaries.
    #
    # Unless there are none. An impl that declares type parameters but bounds
    # none of them -- `impl[T] Dup[Box[T]]` -- has nothing to be a function
    # of, so its dictionary *is* a constant and `dict_def` gives it the
    # singleton scaffold (`nargs` is 0 either way). Asking for it with
    # `CDictApply` then emitted NEW against a private constructor. Handing
    # this case to `dict_ref` is what makes the two sides unable to disagree:
    # one call decides both the scaffold and the way it is reached.
    WApply(tid, subject, args) -> {
      let goals = sub_goals(st.impls, tid, subject)
      if len(goals) == 0 { return dict_ref(st, tid, subject) }
      let (st1, ds) = witness_values(st, args)
      let (st2, key) = dict_def(st1, tid, subject, goals, true)
      (st2, CDictApply(key, ds, dict_ty()))
    }
  }

fn witness_values(st: LSt, ws: List[WitRef]) -> (LSt, List[CExpr]) = {
  var st1 = st
  var out: List[CExpr] = []
  for w in ws {
    let (st2, v) = witness_value(st1, w)
    st1 = st2
    out = out ++ [v]
  }
  (st1, out)
}

## Put a witness's argument dictionaries in scope, keyed by the type each one
## witnesses for, and hand back what was there before. Extends rather than
## replaces: this runs at a call site inside a body whose own dictionaries are
## still in scope.
fn enter_wit_env(st: LSt, w: WitRef) -> (LSt, Map[String, CExpr]) =
  match w {
    WApply(tid, subject, args) -> {
      var st1 = st
      var env = st.dict_env
      var i = 0
      for g in sub_goals(st.impls, tid, subject) {
        let (gt, gty) = g
        if i < len(args) {
          let (st2, d) = witness_value(st1, args[i])
          st1 = st2
          env = map.insert(env, dict_key(gt, gty), d)
        }
        i = i + 1
      }
      (LSt { ..st1, dict_env: env }, st.dict_env)
    }
    _ -> (st, st.dict_env)
  }

## A trait method call. A concrete witness devirtualises to a direct call --
## Dawn is dictionary-passing, so this is where the dictionary disappears
## when it is statically known. A forwarded one dispatches through the slot.
fn lower_trait_call(
  st: LSt,
  tid: Int,
  name: String,
  args: List[TExpr],
  ws: List[WitRef],
  ty: Ty
) -> (LSt, CExpr) = {
  let tr = trait_of(st.traits, tid)
  let idx = method_index(tr, name)
  let sg = trait_method_sig(tr, name)
  if len(ws) == 0 {
    panic("lower: trait method call without a witness: " ++ name)
  }
  # A prelude or structural witness has no body to call. It collapses to the
  # primitive, which is not an optimisation but the definition -- the same
  # relation `==` emits, and what a bound instantiated at either has to end
  # up as. `prim_relation` is also what fills the dictionary slot when the
  # subject is not statically known, so the two forms cannot drift apart.
  if primitive_witness(st, ws[0], tid) {
    var st1 = st
    var vs: List[CExpr] = []
    for a in args {
      let (st2, v) = lower_expr(st1, a)
      st1 = st2
      vs = vs ++ [v]
    }
    # A witness with arguments brings its parts' dictionaries with it. Putting
    # them in scope here is what lets the relation be spelled out at the call
    # site -- no dictionary for the whole is ever built.
    let (st3, saved) = enter_wit_env(st1, ws[0])
    let (st4, e) = prim_relation(st3, tid, subject_of(ws[0]), vs)
    return (LSt { ..st4, dict_env: saved }, e)
  }
  match ws[0] {
    WForward(sym) -> {
      # the dictionary slot has the trait's generic signature, so the
      # subject position is erased and the argument is boxed
      let (st1, vs) = lower_args_to(st, args, sg.param_tys)
      (st1, adapt_out(
        CCall(CMethod(CLocal(sym, dict_ty()), tid, name, idx), vs, sg.ret),
        sg.ret, ty))
    }
    # An impl with a body, reached at a subject that is not ground: there is
    # nothing to devirtualise to, because which body runs depends on the
    # arguments. Build the dictionary and dispatch, exactly as a forwarded one
    # does. (No impl in the language is conditional yet, so nothing reaches
    # here today; leaving it as a panic would make the first conditional impl
    # a compiler crash rather than a call.)
    # A conditional impl at a known subject still devirtualises -- which
    # body runs is settled; only the dictionaries it needs are values.
    WApply(_, subject, wargs) -> {
      let imp = impl_for(st, tid, subject)
      if provides(imp, name) {
        let psig = subst_subject(tr, sg, subject, imp.assoc_bindings)
        let (st1, vs) = lower_args_to(st, args, psig.param_tys)
        let (st2, ds) = witness_values(st1, wargs)
        return (st2, adapt_out(
          CCall(CImpl(owner_or(imp.owner, st2.owner), tid, subject, name), vs ++ ds,
            psig.ret),
          psig.ret, ty))
      }
      let (st1, d) = witness_value(st, ws[0])
      let (st2, vs) = lower_args_to(st1, args, sg.param_tys)
      (st2, adapt_out(
        CCall(CMethod(d, tid, name, idx), vs, sg.ret), sg.ret, ty))
    }
    WConcrete(_, subject) -> {
      let imp = impl_for(st, tid, subject)
      if provides(imp, name) {
        # devirtualised: the impl's own method takes the concrete type, so
        # nothing is boxed. A conditional impl still wants its dictionaries,
        # and at a ground subject they are all statically known.
        let psig = subst_subject(tr, sg, subject, imp.assoc_bindings)
        let (st1, vs) = lower_args_to(st, args, psig.param_tys)
        let (st2, ds) = goal_dicts(st1, sub_goals(st1.impls, tid, subject))
        (st2, adapt_out(
          CCall(CImpl(owner_or(imp.owner, st2.owner), tid, subject, name), vs ++ ds,
            psig.ret),
          psig.ret, ty))
      } else {
        # the default body is generic and takes the dictionary like any
        # other dictionary-passing function
        let (st1, vs) = lower_args_to(st, args, sg.param_tys)
        let (st2, d) = dict_ref(st1, tid, subject)
        (st2, adapt_out(
          CCall(CDefault(owner_or(tr.owner, st2.owner), tid, name), vs ++ [d], sg.ret),
          sg.ret, ty))
      }
    }
  }
}

# ---- lambda lifting ----

fn fresh_lam(st: LSt) -> (LSt, String) =
  (LSt { ..st, next_lam: st.next_lam + 1 }, "lambda$" ++ to_string(st.next_lam))

fn params_of_fn_ty(t: Ty) -> List[Ty] =
  match t {
    TyFn(ps, _, _) -> ps
    _ -> []
  }

fn ret_of_fn_ty(t: Ty) -> Ty =
  match t {
    TyFn(_, r, _) -> r
    _ -> TyError
  }

## Hoist a lambda body to top level and leave a CClosure behind.
##
## The captured variables become leading parameters of the lifted function,
## keeping their original symbol ids -- so the body, which already refers to
## them by those ids, is copied across unchanged. That is the whole reason
## lifting here costs nothing: TAST already recorded the capture set.
## The function being lowered, referred to as a value from inside its own
## body. Only a local named function can be named this way -- a top-level one
## goes through XFnValue -- and it is not in its own capture list, so the
## closure has to be rebuilt from the captures the lifted body already holds.
## A function whose self tail call was rewritten becomes a loop whose only
## exits are returns: falling off the end of a Core loop would repeat it.
fn wrap_self_loop(used: Bool, lid: Int, body: CExpr, ret: Ty) -> CExpr =
  if used {
    CBlock([CSLoop(lid, CReturn(Some(body)), None)], None, ret)
  } else {
    body
  }

fn self_value(st: LSt, sym: Int) -> Option[CExpr] =
  match st.self_ctx {
    Some(sc) ->
      match sc.sym {
        Some(s) ->
          if s == sym {
            Some(CClosure(sc.name, sc.owner, sc.caps, sc.fty))
          } else {
            None
          }
        None -> None
      }
    None -> None
  }

fn is_self_fn(st: LSt, owner: String, name: String) -> Bool =
  match st.self_ctx {
    Some(sc) ->
      match sc.sym {
        Some(_) -> false
        None -> sc.owner == owner && sc.name == name
      }
    None -> false
  }

fn is_self_sym(st: LSt, sym: Int) -> Bool =
  match st.self_ctx {
    Some(sc) ->
      match sc.sym {
        Some(s) -> s == sym
        None -> false
      }
    None -> false
  }

## The §12.4 rewrite: evaluate the arguments, write them back over the
## parameters, jump to the top. The values go through temporaries first
## because the assignment is simultaneous -- `f(b, a)` must not read `a` back
## after `a` has been overwritten.
fn self_tail_jump(st: LSt, args: List[TExpr]) -> (LSt, CExpr) = {
  let sc = st.self_ctx.expect("self ctx")
  let (st1, vs) = lower_args_to(st, args, sc.ptys)
  var st2 = st1
  var stmts: List[CStmt] = []
  var tmps: List[(Int, Ty)] = []
  var i = 0
  for v in vs {
    let (st3, t) = fresh_sym(st2)
    st2 = st3
    stmts = stmts ++ [CSLet(t, sc.ptys[i], v)]
    tmps = tmps ++ [(t, sc.ptys[i])]
    i = i + 1
  }
  i = 0
  for tm in tmps {
    let (t, ty) = tm
    stmts = stmts ++ [CSAssign(sc.params[i], CLocal(t, ty))]
    i = i + 1
  }
  (LSt { ..st2, self_tail: true },
    CBlock(stmts, Some(CContinue(sc.loop_id)), TyNever))
}

fn lift_lambda(
  st: LSt,
  params: List[Int],
  body: TExpr,
  captures: List[Int],
  ty: Ty,
  # Some for a local named function: its own body may call it, and the
  # checker leaves that binding out of the capture list
  self_sym: Option[Int]
) -> (LSt, CExpr) = {
  let (st1, name) = fresh_lam(st)
  var caps: List[CParam] = []
  # the closure-allocation site sits in the ENCLOSING frame, so a capture of
  # an enclosing local named function rebuilds that function's closure; the
  # same captures seen from INSIDE the lifted body are plain parameters
  var cap_args: List[CExpr] = []
  var cap_inner: List[CExpr] = []
  for c in captures {
    let ct = sym_ty(st1, c, TyError)
    caps = caps ++ [CParam { sym: c, ty: ct, mode: COwned }]
    cap_args = cap_args ++ [
      match self_value(st1, c) {
        Some(v) -> v
        None -> CLocal(c, ct)
      }
    ]
    cap_inner = cap_inner ++ [CLocal(c, ct)]
  }
  var ps: List[CParam] = []
  var ptys: List[Ty] = []
  let pts = params_of_fn_ty(ty)
  var i = 0
  for p in params {
    let pt = if i < len(pts) { pts[i] } else { sym_ty(st1, p, TyError) }
    ps = ps ++ [CParam { sym: p, ty: pt, mode: COwned }]
    ptys = ptys ++ [pt]
    i = i + 1
  }
  let (st1b, lid) = fresh_loop(st1)
  let sc: Option[SelfCtx] =
    match self_sym {
      Some(sy) -> Some(SelfCtx {
        sym: Some(sy),
        owner: st1b.owner,
        name: name,
        caps: cap_inner,
        params: params,
        ptys: ptys,
        fty: ty,
        loop_id: lid
      })
      None -> None
    }
  let (st2, cbody0) = lower_expr(LSt {
    ..st1b,
    ret_ty: ret_of_fn_ty(ty),
    self_ctx: sc,
    tail: true,
    self_tail: false
  }, body)
  let cbody1 = adapt_in(cbody0, tex_ty(body), ret_of_fn_ty(ty))
  let cbody = wrap_self_loop(st2.self_tail, lid, cbody1, ret_of_fn_ty(ty))
  let f = CFun {
    name: name,
    owner: st2.owner,
    captures: caps,
    params: ps,
    dicts: [],
    evs: [],
    ret: ret_of_fn_ty(ty),
    body: cbody,
    is_test: false,
    impl_of: None,
    default_of: None
  }
  (LSt {
    ..st2,
    lifted: st2.lifted ++ [f],
    self_ctx: st.self_ctx,
    tail: st.tail,
    self_tail: st.self_tail
  }, CClosure(name, st2.owner, cap_args, ty))
}

## A constructor used as a function value (`map(xs, Some)`) becomes a
## closure over a wrapper that builds it -- same treatment as a top-level
## function, so function values have exactly one representation.
fn lift_ctor_value(st: LSt, adt: Int, ci: Int, ty: Ty) -> (LSt, CExpr) = {
  let (st1, lam) = fresh_lam(st)
  let pts = params_of_fn_ty(ty)
  let ret = ret_of_fn_ty(ty)
  var ps: List[CParam] = []
  var args: List[CExpr] = []
  var st2 = st1
  var i = 0
  for pt in pts {
    let (st3, sym) = fresh_sym(st2)
    st2 = st3
    ps = ps ++ [CParam { sym: sym, ty: pt, mode: COwned }]
    let declared = declared_field_ty(st2, adt, ci, i)
    args = args ++ [adapt_in(CLocal(sym, pt), pt, declared)]
    i = i + 1
  }
  let f = CFun {
    name: lam,
    owner: st2.owner,
    captures: [],
    params: ps,
    dicts: [],
    evs: [],
    ret: ret,
    body: CCtor(adt, ci, args, ret),
    is_test: false,
    impl_of: None,
    default_of: None
  }
  (LSt { ..st2, lifted: st2.lifted ++ [f] }, CClosure(lam, st2.owner, [], ty))
}

## A top-level function used as a value becomes a closure over a wrapper
## with no captures, so that every function value has one representation.
fn lift_fn_value(st: LSt, owner: String, name: String, is_builtin: Bool, ty: Ty) -> (LSt, CExpr) = {
  let (st1, lam) = fresh_lam(st)
  let pts = params_of_fn_ty(ty)
  var ps: List[CParam] = []
  var args: List[CExpr] = []
  var st2 = st1
  var i = 0
  for pt in pts {
    let (st3, sym) = fresh_sym(st2)
    st2 = st3
    ps = ps ++ [CParam { sym: sym, ty: pt, mode: COwned }]
    args = args ++ [CLocal(sym, pt)]
    i = i + 1
  }
  let f = CFun {
    name: lam,
    owner: st2.owner,
    captures: [],
    params: ps,
    dicts: [],
    evs: [],
    ret: ret_of_fn_ty(ty),
    body:
    if is_builtin {
      CIntrinsic(name, args, ret_of_fn_ty(ty))
    } else {
      CCall(CDirect(owner, name), args, ret_of_fn_ty(ty))
    },
    is_test: false,
    impl_of: None,
    default_of: None
  }
  (LSt { ..st2, lifted: st2.lifted ++ [f] }, CClosure(lam, st2.owner, [], ty))
}

# ---- expressions ----

pub fn lower_expr(st0: LSt, e: TExpr) -> (LSt, CExpr) = {
  # tail position is consumed here and re-established only by the arms that
  # propagate it, so every other descent is non-tail by construction
  let tl = st0.tail
  let st = LSt { ..st0, tail: false }
  match e {
    XInt(v, _, _) -> (st, CInt(v))
    # `Char` is opaque over Int, so a character literal is its code point --
    # exactly what XInt lowers to, and the reason no backend learns the node
    XChar(v, _, _) -> (st, CInt(v))
    XFloat(v, _, _) -> (st, CFloat(v))
    XBool(v, _, _) -> (st, CBool(v))
    XUnit(_, _) -> (st, CUnit)
    XLocal(sym, _, _, _, ty) ->
      match self_value(st, sym) {
        Some(c) -> (st, c)
        None -> (st, CLocal(sym, ty))
      }
    XUnsafePure(body, _, _, _) -> lower_expr(LSt { ..st, tail: tl }, body)
    XComptime(_, lo, hi, ty) -> (st, CComptime(lo, hi, ty))
    XError(_, _) -> panic("lower: XError reached lowering")
    XStr(parts, _, _) -> lower_str(st, parts)
    XUnary(op, operand, _, _, ty) -> {
      let (st1, v) = lower_expr(st, operand)
      (st1, CUnary(un_op(op), v, ty))
    }
    XBinary(op, l, r, ord, _, _, _, _, ty) ->
      match ord {
        # An operator that is really a trait method. Lowering spells the call
        # out, so neither backend needs a witness on a comparison node:
        # `<` becomes `cmp(l, r) <op> 0`, `==` becomes `eq(l, r)`.
        Some(w) ->
          if is_eq_op(op) {
            let (st1, c) = lower_trait_call(st, EQ_ID, "eq", [l, r], [w], TyBool)
            match op {
              BEq -> (st1, c)
              _ -> (st1, negated(c))
            }
          } else {
            let (st1, c) = lower_trait_call(st, ORD_ID, "cmp", [l, r], [w], TyInt)
            (st1, CBinary(bin_op(op), c, CInt(0), TyBool))
          }
        # No witness. For `==`/`!=` that is not "nothing to dispatch": the
        # checker returns no witness whenever the answer is the structural
        # default, so this is the operator's own path into the same relation
        # a bound reaches through `lower_trait_call` -- both end at `eq_at`.
        None ->
          # A scalar keeps its own node -- `CNe` is a relation both backends
          # implement directly, and routing it through `not (a == b)` would
          # cost a node for nothing.
          # `eq_subject`, not the operand type: an opaque over a scalar has
          # no equality of its own (`eq_at` peels to the target), so it keeps
          # the scalar's node here too rather than becoming `not (a == b)`.
          if is_eq_op(op) && not is_eq_scalar(eq_subject(st, tex_ty(l))) {
            let (st1, lv) = lower_expr(st, l)
            let (st2, rv) = lower_expr(st1, r)
            let (st3, c) = eq_at(st2, lv, rv, tex_ty(l))
            match op {
              BEq -> (st3, c)
              _ -> (st3, negated(c))
            }
          } else {
            let (st1, lv) = lower_expr(st, l)
            let (st2, rv) = lower_expr(st1, r)
            (st2, CBinary(bin_op(op), lv, rv, ty))
          }
      }
    XIf(cond, thn, els, _, _, ty) -> {
      let (st1, c) = lower_expr(st, cond)
      let (st2, t) = lower_expr(LSt { ..st1, tail: tl }, thn)
      match els {
        Some(ee) -> {
          let (st3, f) = lower_expr(LSt { ..st2, tail: tl }, ee)
          (st3, CIf(c, t, Some(f), ty))
        }
        None -> (st2, CIf(c, t, None, ty))
      }
    }
    XBlock(stmts, tail, _, _, ty) -> {
      let (st1, ss) = lower_stmts(st, stmts)
      match tail {
        Some(t) -> {
          let (st2, tv) = lower_expr(LSt { ..st1, tail: tl }, t)
          match t {
            XJava(_, _, _, tail_ty) ->
              if ty == TyUnit && tail_ty != TyUnit {
                (st2, CBlock(ss ++ [CSDiscard(tv)], None, ty))
              } else {
                (st2, CBlock(ss, Some(tv), ty))
              }
            _ -> (st2, CBlock(ss, Some(tv), ty))
          }
        }
        None -> (st1, CBlock(ss, None, ty))
      }
    }
    XReturn(v, _, _) ->
      match v {
        Some(inner) -> {
          let (st1, cv) = lower_expr(LSt { ..st, tail: true }, inner)
          if diverges(cv) { return (st1, cv) }
          (st1, CReturn(Some(adapt_in(cv, tex_ty(inner), st1.ret_ty))))
        }
        None -> (st, CReturn(None))
      }
    XBreak(_, _) -> (st, CBreak(st.cur_loop))
    XContinue(_, _) -> (st, CContinue(st.cur_loop))
    XMatch(scrut, arms, _, _, ty) -> lower_match(st, scrut, arms, ty, tl)
    XPropagate(operand, _, _, ty) -> lower_propagate(st, operand, ty)
    XUnwrap(operand, msg, _, _, ty) -> lower_unwrap(st, operand, msg, ty)
    XCtor(adt, ci, written, slots, spread, _, _, ty) ->
      lower_ctor(st, adt, ci, written, slots, spread, ty)
    XField(target, idx, _, _, ty) -> {
      let (st1, tv) = lower_expr(st, target)
      # a record-style read: the ADT has one constructor, so the
      # discriminant is statically known
      let tt = tex_ty(target)
      match tt {
        TyAdt(adt, _) -> (st1, read_field(st1, tv, tt, adt, 0, idx))
        _ -> panic("lower: field read on a non-ADT")
      }
    }
    XTupleLit(elems, _, _, ty) -> {
      let (st1, vs) = lower_all(st, elems)
      (st1, CTuple(vs, ty))
    }
    XListLit(elems, _, _, ty) -> {
      # elements cross into an erased container
      var st1 = st
      var vs: List[CExpr] = []
      for el in elems {
        let (st2, v) = lower_expr(st1, el)
        st1 = st2
        vs = vs ++ [adapt_in(v, tex_ty(el), TyVar("E", 0))]
      }
      (st1, CListLit(vs, ty))
    }
    XCallBuiltin(name, args, wits, _, _, ty) -> {
      # `char_unchecked` is the Int -> Char bridge, and `Char`'s representation
      # *is* `Int` -- so it disappears here rather than becoming a primitive
      # each backend would have to implement as a no-op. The check it skips was
      # the caller's to make; the checker already refused the name to anyone
      # outside std.
      if name == "char_unchecked" {
        return lower_expr(st, args[0])
      }
      # `to_string` is the surface spelling of a rendering, and rendering is
      # type-directed: it is settled here rather than left for each backend to
      # switch on the operand type (which is how they came to disagree).
      if name == "to_string" {
        let (st1, v) = lower_expr(st, args[0])
        let none_wit: Option[WitRef] = None
        let w = if len(wits) == 1 { Some(wits[0]) } else { none_wit }
        return to_str(st1, v, tex_ty(args[0]), w)
      }
      # The numeric parsers are Dawn source too (std/fmt, audit RP-05): the
      # accepted language is spec §11's EBNF, checked by fmt's own scanner,
      # so neither backend's host grammar is the definition any more. The one
      # exception is `parse_float` *inside* std/fmt itself: fmt.atod hands a
      # validated, trimmed string to the raw backend primitive for the
      # decimal-to-binary conversion, and that call must stay an intrinsic or
      # it would loop.
      match parser_impl(name) {
        Some(fname) ->
          if name != "parse_float" || st.owner != "std/fmt" {
            let (st1, vs) = lower_all(st, args)
            return (st1, CCall(CDirect("std/fmt", fname), vs, ty))
          }
        None -> ()
      }
      match hamt_fn(name) {
        Some(fname) -> return hamt_call(st, name, fname, args, wits, ty)
        None -> ()
      }
      match erased_builtin_sig(name) {
        Some(sg) -> {
          let (st1, vs) = lower_args_to(st, args, sg.param_tys)
          let (st2, ds) = witness_values(st1, wits)
          (st2, adapt_out(CIntrinsic(name, vs ++ ds, sg.ret), sg.ret, ty))
        }
        None -> {
          let (st1, vs) = lower_all(st, args)
          let (st2, ds) = witness_values(st1, wits)
          (st2, CIntrinsic(name, vs ++ ds, ty))
        }
      }
    }
    XCallFn(owner, name, args, wits, evid, trait_id, _, _, ty) ->
      match trait_id {
        Some(tid) -> lower_trait_call(st, tid, name, args, wits, ty)
        None -> {
          let o = match owner { Some(x) -> x, None -> st.owner }
          if tl && is_self_fn(st, o, name) {
            # neither dictionaries nor evidence are re-passed: a self call is
            # the same instantiation under the same handlers, so what is
            # already in scope still holds
            return self_tail_jump(st, args)
          }
          match sig_of(st, o, name) {
            Some(sg) -> {
              let (st1, vs) = lower_args_to(st, args, sg.param_tys)
              # a generic function takes its dictionaries as hidden trailing
              # arguments, in bound order -- the order the callee declares --
              # and an effectful one its evidence, right behind them
              let (st2, ds) = witness_values(st1, wits)
              let (st3, es) = lower_all(st2, evid)
              (st3, adapt_out(CCall(CDirect(o, name), vs ++ ds ++ es, sg.ret), sg.ret, ty))
            }
            None -> {
              let (st1, vs) = lower_all(st, args)
              let (st2, ds) = witness_values(st1, wits)
              let (st3, es) = lower_all(st2, evid)
              (st3, CCall(CDirect(o, name), vs ++ ds ++ es, ty))
            }
          }
        }
      }
    XConstRef(owner, name, _, _, ty) -> (st, CConstRef(owner, name, ty))
    # `c[i]` is a trait method call like any other: devirtualised where the
    # subject is known (which for List and Map means `index_at` inline, since
    # the prelude impls have no body), dispatched through the dictionary where
    # it is a rigid `[C: Index]`.
    XIndex(target, index, wit, _, _, ty) ->
      lower_trait_call(st, INDEX_ID, "index", [target, index], [wit], ty)
    XCtorValue(adt, ci, _, _, ty) -> lift_ctor_value(st, adt, ci, ty)
    XCallDyn(sym, _, args, _, _, ty) ->
      if is_self_sym(st, sym) {
        if tl {
          self_tail_jump(st, args)
        } else {
          # not a tail call, so the closure is rebuilt and called through
          let (st1, vs) = lower_all(st, args)
          let clo = self_value(st1, sym).expect("self closure")
          (st1, CCall(CDynamic(clo), vs, ty))
        }
      } else {
        let (st1, vs) = lower_all(st, args)
        (st1, CCall(CDynamic(CLocal(sym, sym_ty(st1, sym, TyError))), vs, ty))
      }
    XApply(target, args, _, _, ty) -> {
      let (st1, tv) = lower_expr(st, target)
      let (st2, vs) = lower_all(st1, args)
      (st2, CCall(CDynamic(tv), vs, ty))
    }
    XLambda(params, _, body, captures, _, _, ty) ->
      lift_lambda(st, params, body, captures, ty, None)
    XFnValue(owner, name, is_builtin, ty, _, _) -> {
      # a builtin taken as a value gets the same wrapper as a declared
      # function; only its body differs, and both backends already know how
      # to emit an intrinsic call
      let o = match owner { Some(x) -> x, None -> st.owner }
      lift_fn_value(st, o, name, is_builtin, ty)
    }
    XJava(call, _, _, ty) -> lower_java(st, call, ty)
  }
}

## `use java`: the receiver and the arguments lower like any other
## expression, so no backend has to walk TAST to emit them. Everything else
## about the call is JVM-shaped metadata and rides along unchanged.
fn lower_java(st: LSt, call: TJavaCall, ty: Ty) -> (LSt, CExpr) = {
  var st1 = st
  let tgt: Option[CExpr] =
    match call.target {
      Some(t) -> {
        let (st2, v) = lower_expr(st1, t)
        st1 = st2
        Some(v)
      }
      None -> None
    }
  var args: List[CExpr] = []
  var tys: List[Ty] = []
  for a in call.args {
    let (st2, v) = lower_expr(st1, a)
    st1 = st2
    args = args ++ [v]
    tys = tys ++ [tex_ty(a)]
  }
  (st1, CForeign(CJava { call: call, target: tgt, args: args, arg_tys: tys }, ty))
}

fn lower_all(st: LSt, es: List[TExpr]) -> (LSt, List[CExpr]) = {
  var st1 = st
  var vs: List[CExpr] = []
  for e in es {
    let (st2, v) = lower_expr(st1, e)
    st1 = st2
    vs = vs ++ [v]
  }
  (st1, vs)
}

fn lower_str(st: LSt, parts: List[TStrPart]) -> (LSt, CExpr) = {
  var st1 = st
  var acc: Option[CExpr] = None
  for p in parts {
    let piece =
      match p {
        TSPText(v) -> CStr(v)
        TSPInterp(ie, w) -> {
          let (st2, v) = lower_expr(st1, ie)
          let (st3, s) = to_str(st2, v, tex_ty(ie), w)
          st1 = st3
          s
        }
      }
    acc =
      match acc {
        None -> Some(piece)
        Some(a) -> Some(CBinary(CConcat, a, piece, TyString))
      }
  }
  match acc {
    Some(a) -> (st1, a)
    None -> (st1, CStr(""))
  }
}

fn lower_ctor(
  st: LSt,
  adt: Int,
  ci: Int,
  written: List[TExpr],
  slots: List[Option[Int]],
  spread: Option[TExpr],
  ty: Ty
) -> (LSt, CExpr) = {
  let (st0, base) =
    match spread {
      Some(b) -> {
        let (sa, bv) = lower_expr(st, b)
        let (sb, bsym) = fresh_sym(sa)
        (sb, Some((bsym, bv, tex_ty(b))))
      }
      None -> (st, None)
    }
  var st1 = st0
  let (stw, ws0) = lower_all(st1, written)
  st1 = stw
  var ws = ws0
  # Arguments evaluate in written order (spec §4.3). The constructor's
  # arguments arrive in field order, so when a named argument lands out of
  # position the written values are bound to temporaries first, in written
  # order, and the constructor reads the locals. A call whose written order
  # already IS field order (every call before named arguments could reorder,
  # and most after) takes no temporaries and emits exactly what it always did.
  var hoisted: List[CStmt] = []
  if not slots_monotonic(slots) {
    var lets: List[CStmt] = []
    var locs: List[CExpr] = []
    var wi = 0
    for w in ws {
      let (stA, sym) = fresh_sym(st1)
      st1 = stA
      let wt = tex_ty(written[wi])
      lets = lets ++ [CSLet(sym, wt, w)]
      locs = locs ++ [CLocal(sym, wt)]
      wi = wi + 1
    }
    hoisted = lets
    ws = locs
  }
  var args: List[CExpr] = []
  var fi = 0
  for s in slots {
    match s {
      Some(i) -> {
        let declared = declared_field_ty(st1, adt, ci, fi)
        args = args ++ [adapt_in(ws[i], tex_ty(written[i]), declared)]
      }
      # no written argument: the field comes from the spread base, and it
      # stays at its declared type -- copying erased to erased boxes nothing
      None ->
        match base {
          Some(trip) -> {
            let (bsym, _bv, bt) = trip
            args = args ++
              [CField(CLocal(bsym, bt), adt, ci, fi,
                declared_field_ty(st1, adt, ci, fi))]
          }
          None -> panic("lower: constructor field without an argument")
        }
    }
    fi = fi + 1
  }
  var built = CCtor(adt, ci, args, ty)
  if len(hoisted) > 0 { built = CBlock(hoisted, Some(built), ty) }
  match base {
    # the base is evaluated once, before any field is read from it -- which is
    # also written order, since `..base` can only be written first
    Some(trip) -> {
      let (bsym, bv, bt) = trip
      (st1, CBlock([CSLet(bsym, bt, bv)], Some(built), ty))
    }
    None -> (st1, built)
  }
}

## Do the written arguments already arrive in field order? The field-order
## walk over `slots` visits written indices; if that sequence ascends, field
## order and written order agree and no temporaries are needed.
fn slots_monotonic(slots: List[Option[Int]]) -> Bool = {
  var prev = -1
  for s in slots {
    match s {
      Some(i) -> {
        if i < prev { return false }
        prev = i
      }
      None -> ()
    }
  }
  true
}

test "constructor arguments evaluate in written order" {
  # The semantic pin for spec §4.3's evaluation-order rule (#207 ruling 1):
  # `ty:` is written first and fills the second field, and it still runs
  # first. Before the rule, arguments ran in field order and this list came
  # out backwards.
  var order: List[String] = []
  let pm = CParam {
    ty: {
      order = order ++ ["ty"]
      TyInt
    },
    sym: {
      order = order ++ ["sym"]
      7
    },
    mode: COwned
  }
  assert order == ["ty", "sym"]
  assert pm.sym == 7 && pm.ty == TyInt
}

## `match` becomes a once-loop: each arm is a guarded test that assigns the
## result and breaks. The loop exists so a failed guard falls through to the
## next arm without duplicating its test, which is exactly what the JVM
## emitter achieved with a `next_arm` label.
fn lower_match(st: LSt, scrut: TExpr, arms: List[TArm], ty: Ty, tl: Bool) -> (LSt, CExpr) = {
  let sty = tex_ty(scrut)
  let (st1, sv) = lower_expr(st, scrut)
  let (st2, ssym) = fresh_sym(st1)
  let (st3, rsym) = fresh_sym(st2)
  let (st4, lid) = fresh_loop(st3)
  let subj = CLocal(ssym, sty)
  let produces = ty != TyUnit && ty != TyNever

  var st5 = st4
  var body: List[CStmt] = []
  for arm in arms {
    # or-patterns duplicate the arm body, one branch per alternative; Dawn
    # binds nothing in them beyond what each alternative establishes
    for p in arm.pats {
      let (st6, cond, binds) = pat_test(st5, subj, p, sty)
      st5 = st6
      let (st7, armb) = lower_expr(LSt { ..st5, tail: tl }, arm.body)
      st5 = st7
      let taken =
        if produces {
          CBlock([CSAssign(rsym, armb)], Some(CBreak(lid)), TyNever)
        } else {
          CBlock([CSDiscard(armb)], Some(CBreak(lid)), TyNever)
        }
      let inner =
        match arm.guard {
          Some(g) -> {
            let (st8, gv) = lower_expr(st5, g)
            st5 = st8
            CBlock(binds ++ [CSIf(gv, taken, None)], None, TyUnit)
          }
          None -> CBlock(binds, Some(taken), TyNever)
        }
      body = body ++ [CSIf(cond, inner, None)]
    }
  }
  body = body ++ [CSDiscard(CIntrinsic("panic", [CStr("unreachable match")], TyNever))]

  var stmts: List[CStmt] = [CSLet(ssym, sty, sv)]
  if produces {
    stmts = stmts ++ [CSLet(rsym, ty, zero_of(ty))]
  }
  # Note that arm bodies are lowered WITHOUT cur_loop set to `lid`: the
  # once-loop is an implementation detail, so a user `break` inside an arm
  # must still refer to the enclosing source loop. Both breaks therefore
  # coexist, which is why CBreak names its loop instead of meaning
  # "innermost" -- a backend has to be able to leave a non-innermost loop.
  stmts = stmts ++ [CSLoop(lid, CBlock(body, None, TyUnit), None)]
  let tail: Option[CExpr] = if produces { Some(CLocal(rsym, ty)) } else { None }
  (st5, CBlock(stmts, tail, ty))
}

## A placeholder initialiser for the result slot of a match or if. Every
## path assigns it before use, but both targets want a definite
## initialisation at the declaration.
## The placeholder a slot holds before its arm writes one. Which zero a slot
## takes is decided by how wide it is, so this peels; the intrinsic keeps the
## unpeeled `t` because that is the slot's declared type.
fn zero_of(t: Ty) -> CExpr = {
  let p = peel_opaque(t)
  if p == TyInt {
    CInt(0)
  } else if p == TyFloat {
    CFloat(0.0)
  } else if p == TyBool {
    CBool(false)
  } else if p == TyString {
    CStr("")
  } else {
    CIntrinsic("null_ref", [], t)
  }
}

## `e?` -- return early on None/Err, otherwise take the payload.
fn lower_propagate(st: LSt, operand: TExpr, ty: Ty) -> (LSt, CExpr) = {
  let ot = tex_ty(operand)
  let (st1, ov) = lower_expr(st, operand)
  let (st2, sym) = fresh_sym(st1)
  let subj = CLocal(sym, ot)
  match ot {
    TyAdt(adt, _) ->
      if adt == OPTION_ID {
        (st2, CBlock(
          [CSLet(sym, ot, ov),
            CSIf(CIsCtor(subj, OPTION_ID, NONE_CI),
              CReturn(Some(CCtor(OPTION_ID, NONE_CI, [], ot))), None)],
          Some(read_field(st2, subj, ot, OPTION_ID, SOME_CI, 0)), ty))
      } else if adt == RESULT_ID {
        let err_ty = field_ty(ot, RESULT_ID, ERR_CI, 0)
        (st2, CBlock(
          [CSLet(sym, ot, ov),
            CSIf(CIsCtor(subj, RESULT_ID, ERR_CI),
              CReturn(Some(CCtor(RESULT_ID, ERR_CI,
                # re-wrapping, not consuming: the payload stays at its
                # declared (erased) type, so nothing is unboxed here
                [CField(subj, RESULT_ID, ERR_CI, 0,
                  declared_field_ty(st2, RESULT_ID, ERR_CI, 0))], ot))), None)],
          Some(read_field(st2, subj, ot, RESULT_ID, OK_CI, 0)), ty))
      } else {
        panic("lower: `?` on a non-Option/Result type")
      }
    _ -> panic("lower: `?` on a non-ADT")
  }
}

## `e!` -- take the payload or panic with the recorded message.
fn lower_unwrap(st: LSt, operand: TExpr, msg: String, ty: Ty) -> (LSt, CExpr) = {
  let ot = tex_ty(operand)
  let (st1, ov) = lower_expr(st, operand)
  let (st2, sym) = fresh_sym(st1)
  let subj = CLocal(sym, ot)
  match ot {
    TyAdt(adt, _) ->
      if adt == OPTION_ID {
        (st2, CBlock(
          [CSLet(sym, ot, ov),
            CSIf(CIsCtor(subj, OPTION_ID, NONE_CI),
              CIntrinsic("panic", [CStr(msg)], TyNever), None)],
          Some(read_field(st2, subj, ot, OPTION_ID, SOME_CI, 0)), ty))
      } else if adt == RESULT_ID {
        (st2, CBlock(
          [CSLet(sym, ot, ov),
            CSIf(CIsCtor(subj, RESULT_ID, ERR_CI),
              CIntrinsic("panic", [CStr(msg)], TyNever), None)],
          Some(read_field(st2, subj, ot, RESULT_ID, OK_CI, 0)), ty))
      } else {
        panic("lower: `!` on a non-Option/Result type")
      }
    _ -> panic("lower: `!` on a non-ADT")
  }
}

# ---- statements ----

fn lower_stmts(st: LSt, ss: List[TStmt]) -> (LSt, List[CStmt]) = {
  var st1 = st
  var out: List[CStmt] = []
  for s in ss {
    let (st2, cs) = lower_stmt(st1, s)
    st1 = st2
    out = out ++ cs
  }
  (st1, out)
}

fn lower_stmt(st: LSt, s: TStmt) -> (LSt, List[CStmt]) =
  match s {
    TSLet(sym, _, init, _, _) -> {
      let (st1, v) = lower_expr(st, init)
      match sym {
        # the binding's type is the checker's, not the initialiser's: a
        # `use java` constructor is typed narrower than its call node, and
        # taking the wrong one puts an Option where a ZipEntry belongs
        Some(sy) -> (st1, [CSLet(sy, sym_ty(st1, sy, tex_ty(init)), v)])
        # `let _ = e`: the value goes, the effect stays -- and Core says so
        None -> (st1, [CSDiscard(v)])
      }
    }
    TSAssign(sym, _, value, _, _) -> {
      let (st1, v) = lower_expr(st, value)
      (st1, [CSAssign(sym, v)])
    }
    TSExpr(e, _, _) -> {
      let (st1, v) = lower_expr(st, e)
      (st1, [CSDiscard(v)])
    }
    TSAssert(cond, src, _, _) -> {
      let (st1, c) = lower_expr(st, cond)
      let text = match src { Some(t) -> t, None -> "assertion failed" }
      (st1, [CSIf(CUnary(CNot, c, TyBool),
        CIntrinsic("panic", [CStr("assertion failed: " ++ text)], TyNever), None)])
    }
    TSWhile(cond, body, _, _, _) -> {
      let (st1, lid) = fresh_loop(st)
      # the condition is evaluated outside the loop's own scope but inside
      # it at runtime, so it is lowered with cur_loop already set: a
      # `break` in a condition is legal and belongs to this loop
      let inner_st = LSt { ..st1, cur_loop: lid }
      let (st2, c) = lower_expr(inner_st, cond)
      let (st3, b) = lower_expr(st2, body)
      # the test becomes an explicit break, so the loop node itself is
      # unconditional and both backends emit the same shape
      let inner = CBlock(
        [CSIf(CUnary(CNot, c, TyBool), CBreak(lid), None), CSDiscard(b)],
        None, TyUnit)
      (LSt { ..st3, cur_loop: st.cur_loop }, [CSLoop(lid, inner, None)])
    }
    TSFor(sym, _, from, to, wit, body, _, _, _) -> {
      match to {
        Some(hi) -> {
          let (st1, lid) = fresh_loop(st)
          # bounds are evaluated once, before the loop, so they are lowered
          # in the OUTER loop context
          let (st2, lo_v) = lower_expr(st1, from)
          let (st3, hi_v) = lower_expr(st2, hi)
          let (st4, bsym) = fresh_sym(st3)
          let (st5, b) = lower_expr(LSt { ..st4, cur_loop: lid }, body)
          let iv = CLocal(sym, TyInt)
          # induction is explicit: init, test, body, step. The step lives on
          # the loop node rather than at the end of the body so that
          # `continue` runs it -- see core.CSLoop.
          let inner = CBlock(
            [CSIf(CUnary(CNot, CBinary(CLt, iv, CLocal(bsym, TyInt), TyBool), TyBool),
              CBreak(lid), None),
              CSDiscard(b)],
            None, TyUnit)
          let step = CSAssign(sym, CBinary(CAdd, iv, CInt(1), TyInt))
          (LSt { ..st5, cur_loop: st.cur_loop }, [
            CSLet(bsym, TyInt, hi_v),
            CSLet(sym, TyInt, lo_v),
            CSLoop(lid, inner, Some(CBlock([step], None, TyUnit)))
          ])
        }
        None ->
          match wit {
            Some(w) -> lower_for_iter(st, sym, from, w, body)
            # unreachable on a checked program: the checker refuses a
            # witnessless for..in before lowering runs
            None -> panic("lower: for..in without an Iter witness")
          }
      }
    }
    TSLetPat(pat, init, _, _) -> {
      let (st1, v) = lower_expr(st, init)
      let it = tex_ty(init)
      let (st2, sym) = fresh_sym(st1)
      # the checker has already proved the pattern irrefutable, so only the
      # bindings survive; the test it produces is discarded
      let (st3, _cond, binds) = pat_test(st2, CLocal(sym, it), pat, it)
      (st3, [CSLet(sym, it, v)] ++ binds)
    }
    TSLocalFn(sym, _, params, _, body, captures, _, _) -> {
      # a named local function is a lambda that also binds a name
      let fty = sym_ty(st, sym, TyError)
      let (st1, clo) = lift_lambda(st, params, body, captures, fty, Some(sym))
      (st1, [CSLet(sym, fty, clo)])
    }
  }

## `for x in xs`: a cursor walk over the Iter trait's four methods, through
## the witness the checker resolved (#44 knife 2). A concrete subject
## devirtualises to the impl's own methods -- for a List, the same direct
## static calls the retired std/list quartet compiled to -- and a rigid one
## dispatches through the forwarded dictionary, which is what makes `for`
## inside a `[C: Iter]` function possible at all.
##
## The four calls go through lower_trait_call on synthetic XLocal nodes, so a
## `for` cannot disagree with a source-level `iter_get(xs, k)` about boxing,
## dictionaries or devirtualisation: same door, same answer.
fn lower_for_iter(
  st: LSt,
  sym: Int,
  from: TExpr,
  w: WitRef,
  body: TExpr
) -> (LSt, List[CStmt]) = {
  let ct = tex_ty(from)
  # the loop variable's type: the checker already reduced the impl's `Item`
  let et = sym_ty(st, sym, TyError)
  let cur_t = iter_cur_ty(st, w, ct)
  let (st1, lid) = fresh_loop(st)
  let (st2, coll) = lower_expr(st1, from)
  let (st3, csym) = fresh_sym(st2)
  let (st4, isym) = fresh_sym(st3)
  let cv: TExpr = XLocal(csym, "for$" ++ "xs", 0, 0, ct)
  let iv: TExpr = XLocal(isym, "for$" ++ "cur", 0, 0, cur_t)
  let (st5, start_v) = lower_trait_call(st4, ITER_ID, "iter_start", [cv], [w], cur_t)
  let (st6, done_v) = lower_trait_call(st5, ITER_ID, "iter_done", [cv, iv], [w], TyBool)
  let (st7, get_v) = lower_trait_call(st6, ITER_ID, "iter_get", [cv, iv], [w], et)
  let (st8, next_v) = lower_trait_call(st7, ITER_ID, "iter_next", [cv, iv], [w], cur_t)
  let (st9, b) = lower_expr(LSt { ..st8, cur_loop: lid }, body)
  let inner = CBlock(
    [CSIf(done_v, CBreak(lid), None),
      CSLet(sym, et, get_v),
      CSDiscard(b)],
    None, TyUnit)
  # the step lives on the loop node rather than at the end of the body so
  # that `continue` runs it -- see core.CSLoop
  let step = CSAssign(isym, next_v)
  (LSt { ..st9, cur_loop: st.cur_loop }, [
    CSLet(csym, ct, coll),
    CSLet(isym, cur_t, start_v),
    CSLoop(lid, inner, Some(CBlock([step], None, TyUnit)))
  ])
}

## The cursor local's Core type. For a known impl it is the `Cur` binding
## verbatim -- the callee-ABI shape subst_subject computes, so the local
## neither boxes an Int cursor nor unboxes a structural one. For a forwarded
## witness the subject is rigid and the projection stays: an erased slot,
## exactly what the dictionary's bridge traffics in.
fn iter_cur_ty(st: LSt, w: WitRef, ct: Ty) -> Ty =
  match w {
    WForward(_) -> TyAssoc(ct, ITER_ID, "Cur")
    WConcrete(_, subject) -> iter_cur_binding(st, subject)
    WApply(_, subject, _) -> iter_cur_binding(st, subject)
  }

fn iter_cur_binding(st: LSt, subject: Ty) -> Ty = {
  for pr in impl_for(st, ITER_ID, subject).assoc_bindings {
    let (bn, bt) = pr
    if bn == "Cur" { return bt }
  }
  # registration refuses an impl that leaves a declared assoc type unbound
  panic("lower: impl Iter[" ++ ty_key_inst(subject) ++ "] has no `Cur` binding")
}

## Which function on the Dawn trie a Map/Set primitive is.
##
## Map and Set are one structure -- a set is a map to a value nobody reads --
## so most of the two families land on the same name. Nothing here is a
## backend intrinsic any more: since S3 the only collection a backend
## implements is `Array`, and everything above it is std source
## (docs/collections-dejava-research.md §5.1).
## The std/fmt function each numeric-parser builtin lowers to (audit RP-05).
##
## Public because it is the whole reference to those three names from outside
## the module that owns them: since v0.55.0 they are not `pub` in std/fmt --
## `parse_int` is the only spelling user code has -- so nothing else in the
## repository mentions them, and a rename inside std/fmt would leave this
## lowering emitting a call to a function that is not there. `stdlib`'s
## "the numeric parsers still have somewhere to land" test reads this table
## and looks the names up in the std it loads.
pub fn parser_impl(name: String) -> Option[String] =
  match name {
    "parse_int" -> Some("atoi")
    "parse_int_radix" -> Some("atoi_radix")
    "parse_float" -> Some("atod")
    _ -> None
  }

fn hamt_fn(name: String) -> Option[String] =
  match name {
    "map_empty" -> Some("empty")
    "set_empty" -> Some("empty")
    "map_from" -> Some("from")
    "set_from" -> Some("sfrom")
    "map_insert" -> Some("assoc")
    "set_insert" -> Some("sadd")
    "map_remove" -> Some("dissoc")
    "set_remove" -> Some("dissoc")
    "map_get" -> Some("get")
    "map_has" -> Some("has")
    "set_has" -> Some("has")
    "map_size" -> Some("count")
    "set_size" -> Some("count")
    "map_keys" -> Some("keys")
    "set_to_list" -> Some("keys")
    "map_values" -> Some("values")
    "map_entries" -> Some("entries")
    _ -> None
  }

fn hamt_sig(st: LSt, name: String) -> Sig =
  match sig_of(st, "std/hamt", name) {
    Some(sg) -> sg
    None -> panic("lower: std/hamt." ++ name ++ " is missing")
  }

## A Map/Set primitive as a direct call on the trie. The primitive's own
## signature says which slots are erased, and the trie's says which the callee
## declares, so the adapts are the ordinary ones -- the two agree everywhere
## but on the container itself, which is a concrete type on both sides.
fn hamt_call(
  st: LSt, prim: String, fname: String, args: List[TExpr], wits: List[WitRef], ty: Ty
) -> (LSt, CExpr) = {
  let sg = hamt_sig(st, fname)
  let (st1, vs) = lower_args_to(st, args, sg.param_tys)
  let (st2, ds) = witness_values(st1, wits)
  (st2, adapt_out(CCall(CDirect("std/hamt", fname), vs ++ ds, sg.ret), sg.ret, ty))
}

# ---- indexing (docs/operator-traits-design.md §4.4) ----
#
# `c[i]` reaches here through `Index`, which the prelude implements for List
# and Map with no body -- so this is the body, the same way `eq_at` is the
# body of the scalar `Eq` impls. A user type's `impl Index` never comes here;
# it has a method, and a method is called.
#
# Both arms have to emit exactly what `XIndex` emitted directly before the
# trait existed. That is not a nicety: `list_index` staying a Core intrinsic
# is what keeps `const B: List[Int] = [A, 4]` foldable at comptime, and every
# golden Core dump in the tree pins the shape.

## `C.Idx` at a subject the language indexes: the position for a List, the key
## type for a Map.
fn index_idx_ty(subject: Ty) -> Ty =
  match peel_opaque(subject) {
    TyList(_) -> TyInt
    TyMap(k, _) -> k
    _ -> panic("lower: no indexing for " ++ ty_key_inst(subject))
  }

## `C.Item` at the same subjects.
fn index_item_ty(subject: Ty) -> Ty =
  match peel_opaque(subject) {
    TyList(el) -> el
    TyMap(_, v) -> v
    _ -> panic("lower: no indexing for " ++ ty_key_inst(subject))
  }

fn index_at(st: LSt, c: CExpr, i: CExpr, subject: Ty) -> (LSt, CExpr) =
  match peel_opaque(subject) {
    TyList(el) -> {
      # indexing yields an erased element, so the unbox is explicit
      let erased = TyVar("E", 0)
      (st, adapt_out(CIntrinsic("list_index", [c, i], erased), erased, el))
    }
    TyMap(k, v) -> {
      # `m[k]` is `hamt.index`, which needs the key's Eq, Hash and Show -- the
      # last only to name the key it could not find, which is why the message
      # survives without every lookup paying to build one. The three used to
      # be resolved at the `[]` and passed down; they are now the sub-goals of
      # `Index[Map[K, V]]`, which `lower_trait_call` has already put in scope.
      let sg = hamt_sig(st, "index")
      let (st1, ds) = goal_dicts(st, sub_goals(st.impls, INDEX_ID, subject))
      let call = CCall(CDirect("std/hamt", "index"),
        [c, adapt_in(i, k, sg.param_tys[1])] ++ ds, sg.ret)
      (st1, adapt_out(call, sg.ret, v))
    }
    _ -> panic("lower: no indexing for " ++ ty_key_inst(subject))
  }

# ---- functions and modules ----

## `continue` inside a lowered `for` must run the step before jumping, but
## Core's CContinue jumps to the loop head. The step is therefore emitted at
## the top of the next iteration instead of the bottom of this one for
## `for`; `while` has no step and is unaffected.
##
## Phase 0 marks every parameter COwned: the conservative choice, and the
## one Perceus starts from.
fn lower_fn(st: LSt, owner: String, f: TFun) -> (LSt, CFun) = {
  var params: List[CParam] = []
  var i = 0
  for pt in f.sig.param_tys {
    params = params ++ [CParam { sym: f.param_syms[i], ty: pt, mode: COwned }]
    i = i + 1
  }
  var dicts: List[CParam] = []
  for d in f.dict_syms {
    # the checker already typed the hidden dictionary parameters; carrying
    # that type here keeps a backend from having to reach behind Core into
    # the symbol table
    dicts = dicts ++ [CParam { sym: d, ty: sym_ty(st, d, TyError), mode: COwned }]
  }
  # evidence follows the dictionaries, in the order the checker recorded --
  # the callee's half of the convention whose caller half is in lower_expr
  var evs: List[CParam] = []
  for e in f.ev_syms {
    evs = evs ++ [CParam { sym: e, ty: sym_ty(st, e, TyError), mode: COwned }]
  }
  let (stl, lid) = fresh_loop(st)
  # spec §12.4 covers plain top-level functions and local named ones. An impl
  # method, a trait default and a test keep the shape they had, so that the
  # rewrite lands in one place at a time.
  let plain = f.impl_of == None && f.default_of == None && not f.is_test
  let sc: Option[SelfCtx] =
    if plain {
      Some(SelfCtx {
        sym: None,
        owner: owner,
        name: f.name,
        caps: [],
        params: f.param_syms,
        ptys: f.sig.param_tys,
        fty: TyUnit,
        loop_id: lid
      })
    } else {
      None
    }
  let st_in = LSt { ..stl, ret_ty: f.sig.ret, self_ctx: sc, tail: true, self_tail: false }
  let (st1, body0) = lower_expr(st_in, f.body)
  # the tail value is a return too
  let body1 = adapt_in(body0, tex_ty(f.body), f.sig.ret)
  let body = wrap_self_loop(st1.self_tail, lid, body1, f.sig.ret)
  (LSt { ..st1, ret_ty: st.ret_ty, self_ctx: st.self_ctx, tail: st.tail, self_tail: st.self_tail }, CFun {
    name: f.name,
    owner: owner,
    captures: [],
    params: params,
    dicts: dicts,
    evs: evs,
    ret: f.sig.ret,
    body: body,
    is_test: f.is_test,
    impl_of: f.impl_of,
    default_of: f.default_of
  })
}

## Lower one expression on its own: the comptime interpreter's entry, which
## folds a const initializer or a comptime block rather than a function body.
## The lifted lambdas come back with it, and so do the dictionaries, because
## the interpreter has to be able to call the one and dispatch through the
## other.
pub fn lower_expr_only(
  owner: String,
  e: TExpr,
  traits: Traits,
  impls: Impls,
  adts: Adts,
  prog_fns: Map[(String, String), Sig],
  syms: Map[Int, Sym],
  lam_start: Int
) -> (CExpr, List[CFun], List[CDictDef], Int) = {
  var top = 0
  for k in map.keys(syms) {
    if k > top { top = k }
  }
  let st = LSt {
    next_sym: top + 1,
    next_loop: 0,
    owner: owner,
    cur_loop: -1,
    ret_ty: tex_ty(e),
    syms: syms,
    lifted: [],
    next_lam: lam_start,
    traits: traits,
    impls: impls,
    adts: adts,
    prog_fns: prog_fns,
    dicts: [],
    dict_env: map.empty(),
    self_ctx: None,
    tail: false,
    self_tail: false
  }
  let (st1, ce) = lower_expr(st, e)
  (ce, st1.lifted, st1.dicts, st1.next_lam)
}

## Lower a single function, returning it plus whatever lambdas it hoisted.
##
## The comptime interpreter's entry, and the only one left: it lowers what
## evaluation reaches, one function at a time, across module boundaries, so
## there is no module to lower. Both real backends lower whole modules --
## the JVM one used to come through here too, and the two passes disagreed
## about which bodies exist (docs/audit/re-audit-2026-07-30.md RC-04).
pub fn lower_fn_only(
  owner: String,
  f: TFun,
  traits: Traits,
  impls: Impls,
  adts: Adts,
  prog_fns: Map[(String, String), Sig],
  syms: Map[Int, Sym],
  # lifted names must be unique across the whole class, not just this
  # function, so the caller seeds and carries the counter
  lam_start: Int
) -> (CFun, List[CFun], List[CDictDef], Int) = {
  var top = 0
  for k in map.keys(syms) {
    if k > top { top = k }
  }
  let st = LSt {
    next_sym: top + 1,
    next_loop: 0,
    owner: owner,
    cur_loop: -1,
    ret_ty: TyUnit,
    syms: syms,
    lifted: [],
    next_lam: lam_start,
    traits: traits,
    impls: impls,
    adts: adts,
    prog_fns: prog_fns,
    dicts: [],
    dict_env: map.empty(),
    self_ctx: None,
    tail: false,
    self_tail: false
  }
  let (st1, cf) = lower_fn(st, owner, f)
  (cf, st1.lifted, st1.dicts, st1.next_lam)
}

## One module lowered once, in the two shapes its consumers want.
##
## `fns` and `tests` keep the grouping the flat list loses: each source
## function paired with the bodies lowering hoisted while lowering *it*. The
## JVM emitter needs that, because it writes a hoisted body as a static
## method beside the function that asked for it.
##
## `m` is the same functions flat -- sources in source order, then the hoisted
## bodies in hoisting order -- which is what a whole-translation-unit backend
## (`emitc`) reads. Test bodies stay out of it, and so do the dictionaries only
## a test asks for: there is no test to compile natively. `dicts` is the
## unabridged list, tests included, for the backend that emits them, and
## `emitted_core` below puts the two halves back together for the consumer
## that has to see everything a jar holds.
pub type LMod = {
  m: CModule,
  fns: List[(CFun, List[CFun])],
  tests: List[(CFun, List[CFun])],
  dicts: List[CDictDef]
}

## Lower a whole module: one LSt for all of it, so a hoisted body is
## synthesised once however many functions need it, and symbol and lambda
## counters never restart.
##
## `include_tests` is the JVM path's; a test block has no native meaning.
pub fn lower_module_full(
  owner: String,
  tm: TModule,
  traits: Traits,
  impls: Impls,
  adts: Adts,
  prog_fns: Map[(String, String), Sig],
  include_tests: Bool
) -> LMod = {
  # temporaries continue above every checker-minted id in this module
  var top = 0
  for k in map.keys(tm.syms) {
    if k > top { top = k }
  }
  var st = LSt {
    next_sym: top + 1,
    next_loop: 0,
    owner: owner,
    cur_loop: -1,
    ret_ty: TyUnit,
    syms: tm.syms,
    lifted: [],
    next_lam: 0,
    traits: traits,
    impls: impls,
    adts: adts,
    prog_fns: prog_fns,
    dicts: [],
    dict_env: map.empty(),
    self_ctx: None,
    tail: false,
    self_tail: false
  }
  var fns: List[(CFun, List[CFun])] = []
  var flat: List[CFun] = []
  for f in tm.fns {
    let before = len(st.lifted)
    let (st1, cf) = lower_fn(st, owner, f)
    st = st1
    # whatever grew onto the shared list while this function was lowered is
    # what this function hoisted; a body an earlier function already
    # synthesised was reused and grows nothing
    fns = fns ++ [(cf, list.drop(st.lifted, before))]
    flat = flat ++ [cf]
  }
  # lifted bodies are appended after the source functions; they are ordinary
  # top-level functions from here on and no backend can tell the difference
  let m =
    CModule { owner: owner, fns: flat ++ st.lifted, dicts: st.dicts, next_sym: st.next_sym }
  var tests: List[(CFun, List[CFun])] = []
  if include_tests {
    for t in tm.tests {
      let before = len(st.lifted)
      let (st1, cf) = lower_fn(st, owner, t)
      st = st1
      tests = tests ++ [(cf, list.drop(st.lifted, before))]
    }
  }
  LMod { m: m, fns: fns, tests: tests, dicts: st.dicts }
}

test "the flat module and the grouped functions are one lowering" {
  # `reach` reads LMod.m to decide what Unicode freight a program carries and
  # the JVM emitter reads LMod.fns to write the methods. Those used to be two
  # separate lowerings, and a comment asserted they agreed
  # (docs/audit/re-audit-2026-07-30.md RC-04). They are one now; this is the
  # check, because "the same value" is only true while nobody rebuilds it.
  let tt = TyTuple([TyInt, TyInt])
  let sym = (nm: String) => Sym {
    name: nm,
    ty: tt,
    mutable: false,
    dlo: 0,
    dhi: 0,
    dict_of: None
  }
  var syms: Map[Int, Sym] = map.empty()
  syms = map.insert(syms, 1, sym("a"))
  syms = map.insert(syms, 2, sym("b"))
  let no_wit: Option[WitRef] = None
  # `a == b` over a tuple: lowering has to synthesise the structural
  # comparison, and both functions want the same one
  let body =
    XBinary(BEq, XLocal(1, "a", 0, 0, tt), XLocal(2, "b", 0, 0, tt), no_wit,
      0, 0, 0, 0, TyBool)
  let fn_named = (nm: String) => TFun {
    name: nm,
    sig: Sig {
      name: nm,
      param_tys: [tt, tt],
      param_names: ["a", "b"],
      param_defaults: [],
      ret: TyBool,
      eff: EPure,
      is_builtin: false,
      tparams: [],
      constraints: [],
      owner: None,
      trait_id: None,
      op_of: None,
      inferring: false
    },
    param_syms: [1, 2],
    dict_syms: [],
    ev_syms: [],
    defaults: [],
    body: body,
    is_test: false,
    impl_of: None,
    default_of: None
  }
  let no_traits: Traits = map.empty()
  let no_impls: Impls = map.empty()
  let no_sigs: Map[(String, String), Sig] = map.empty()
  let tm = TModule { fns: [fn_named("f"), fn_named("g")], consts: [], tests: [], syms: syms }
  let lm = lower_module_full("m", tm, no_traits, no_impls, prelude_adts(), no_sigs, false)

  # the flat list is the grouped one: sources in source order, then the
  # hoisted bodies in hoisting order
  var expect: List[String] = []
  for pr in lm.fns {
    let (cf, _lifts) = pr
    expect = expect ++ [cf.name]
  }
  for pr in lm.fns {
    let (_cf, lifts) = pr
    for lf in lifts { expect = expect ++ [lf.name] }
  }
  var got: List[String] = []
  for cf in lm.m.fns { got = got ++ [cf.name] }
  assert got == expect

  # and nothing was synthesised twice: one LSt for the module is what makes
  # the dedup module-wide, and what the two lowerings used to disagree about
  var seen: List[String] = []
  for nm in got {
    for s in seen { assert s != nm }
    seen = seen ++ [nm]
  }
  # the shared structural comparison is attributed to the first asker
  assert len(lm.m.fns) == 3
  let (_f, f_lifts) = lm.fns[0]
  let (_g, g_lifts) = lm.fns[1]
  assert len(f_lifts) == 1
  assert len(g_lifts) == 0
}

## Everything of this module a JVM artifact holds, as one flat CModule: `m`,
## then each test body followed by whatever lowering hoisted out of it, over
## the unabridged dictionary list.
##
## `m` alone is not that. The JVM emitter writes test blocks into every
## artifact it produces -- `dawn build` and `dawn test` walk the same
## `collect_program` -- so a question about what the emitted code can do has
## to be asked of this and not of `m`. `reach` is that question (reach.dawn);
## when it was asked about `m`, a Unicode table only a test could reach was
## pruned out from under the test that needed it.
##
## For a module lowered without tests this is `m` unchanged, which is what the
## std modules and the native path get.
pub fn emitted_core(l: LMod) -> CModule = {
  var fns = l.m.fns
  for pr in l.tests {
    let (cf, lifts) = pr
    fns = fns ++ [cf] ++ lifts
  }
  CModule { ..l.m, fns: fns, dicts: l.dicts }
}

test "emitted_core carries the test bodies and what they hoisted" {
  # `reach` walks this to decide what Unicode freight a jar takes. It walked
  # `m` until 2026-07-30, and `m` has no test in it: a program whose only
  # `str.to_upper` sat in a test block shipped without the case table and the
  # test died on a missing method. The two structural comparisons below stand
  # in for that -- one hoisted by a function, one by a test.
  let ti = TyTuple([TyInt, TyInt])
  let ts = TyTuple([TyString, TyString])
  let sym = (nm: String, t: Ty) => Sym {
    name: nm,
    ty: t,
    mutable: false,
    dlo: 0,
    dhi: 0,
    dict_of: None
  }
  var syms: Map[Int, Sym] = map.empty()
  syms = map.insert(syms, 1, sym("a", ti))
  syms = map.insert(syms, 2, sym("b", ti))
  syms = map.insert(syms, 3, sym("s", ts))
  syms = map.insert(syms, 4, sym("t", ts))
  let no_wit: Option[WitRef] = None
  let eq_of = (x: Int, y: Int, nx: String, ny: String, t: Ty) =>
    XBinary(BEq, XLocal(x, nx, 0, 0, t), XLocal(y, ny, 0, 0, t), no_wit, 0, 0, 0, 0, TyBool)
  let src = TFun {
    name: "f",
    sig: Sig {
      name: "f",
      param_tys: [ti, ti],
      param_names: ["a", "b"],
      param_defaults: [],
      ret: TyBool,
      eff: EPure,
      is_builtin: false,
      tparams: [],
      constraints: [],
      owner: None,
      trait_id: None,
      op_of: None,
      inferring: false
    },
    param_syms: [1, 2],
    dict_syms: [],
    ev_syms: [],
    defaults: [],
    body: eq_of(1, 2, "a", "b", ti),
    is_test: false,
    impl_of: None,
    default_of: None
  }
  # a test takes no parameters and answers Unit; the string tuple keeps its
  # comparison distinct from the one `f` asked for, so it really is hoisted
  let tst = TFun {
    ..src,
    name: "strings compare",
    sig: Sig { ..src.sig, name: "strings compare", param_tys: [], param_names: [], ret: TyUnit },
    param_syms: [],
    body: XBlock([TSAssert(eq_of(3, 4, "s", "t", ts), None, 0, 0)], None, 0, 0, TyUnit),
    is_test: true
  }
  let no_traits: Traits = map.empty()
  let no_impls: Impls = map.empty()
  let no_sigs: Map[(String, String), Sig] = map.empty()
  let tm = TModule { fns: [src], consts: [], tests: [tst], syms: syms }
  let lm = lower_module_full("m", tm, no_traits, no_impls, prelude_adts(), no_sigs, true)

  # `f` and the comparison it hoisted, and nothing of the test
  var flat: List[String] = []
  for cf in lm.m.fns { flat = flat ++ [cf.name] }
  assert len(flat) == 2
  assert flat[0] == "f"

  var whole: List[String] = []
  for cf in emitted_core(lm).fns { whole = whole ++ [cf.name] }
  # the same two, then the test body, then the comparison the test hoisted
  assert len(whole) == 4
  assert whole[0] == flat[0]
  assert whole[1] == flat[1]
  assert whole[2] == "strings compare"
  assert whole[3] != flat[1]
  # and the dictionaries are the unabridged list, not m's pre-test snapshot
  assert len(emitted_core(lm).dicts) == len(lm.dicts)
}

## The flat shape on its own, for the consumers that want nothing else.
##
## (There was a `node_name` below this, for a "not lowered yet" panic arm at
## the end of `lower_expr`. Every TExpr variant has an arm now, so the arm was
## unreachable and the four names it could print were all handled -- and an
## unreachable panic is worse than nothing, because it reads as a guard.
## Exhaustiveness is the guard; a variant added later is a compile error.)
pub fn lower_module(
  owner: String,
  tm: TModule,
  traits: Traits,
  impls: Impls,
  adts: Adts,
  prog_fns: Map[(String, String), Sig]
) -> CModule =
  lower_module_full(owner, tm, traits, impls, adts, prog_fns, false).m

# Each body reaches one F1 checker boundary; parsing remains legal throughout.
use java "java.lang.Math"

pub fn exported(x: Int) -> Int !io = extern c "exported" else x
fn pure() -> Int !() = extern c "pure" else 1
fn symbol() -> Int !io = extern c "a__b" else 1
fn parameter(xs: List[Int]) -> Int !io = extern c "parameter" else 1
fn result() -> List[Int] !io = extern c "result" else [1]
fn fallback() -> Int !io = extern c "fallback" else "wrong"
fn java_body(x: Int) -> Int !io = extern c "java_body" else Math.abs(x)
fn nested() -> Int !io = { extern c "nested" else 1 }

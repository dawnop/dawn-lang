# checker.dawn: a fn-typed field vs a function of the same name
pub type Rec = { run: fn(Int) -> Int, only: fn(Int) -> Int }

pub fn run(x: Int) -> Int = x

pub fn ambiguous(r: Rec) -> Int = r.run(1)

pub fn field_arity(r: Rec) -> Int = r.only(1, 2)

pub fn field_arg(r: Rec) -> Int = r.only("a")

# the value spellings read the field even with `run` in scope (spec §2.4)
pub fn by_parens(r: Rec) -> Int = (r.run)(1)

pub fn by_pipe(r: Rec) -> Int = 1 |> r.run

# checker.dawn: record and constructor construction
type Rec = { a: Int, b: Int }

type Sum = Zero | One(x: Int)

const K: Int = 1

pub fn base_not_record(x: Int) -> Rec = Rec { ..x, a: 1, b: 2 }

pub fn base_wrong(r: Rec, s: Sum) -> Sum = One { ..r, x: 1 }

pub fn no_field(r: Rec) -> Rec = Rec { ..r, z: 1 }

pub fn positional_after_named() -> Sum = One(x: 1, 2)

pub fn given_twice() -> Rec = Rec { a: 1, a: 2, b: 3 }

pub fn field_type() -> Rec = Rec { a: "s", b: 2 }

pub fn arity() -> Rec = Rec { a: 1, b: 2, c: 3 }

pub fn too_many() -> Sum = One(1, 2)

pub fn missing() -> Rec = Rec { a: 1 }

pub fn const_not_ctor() -> Int = K(1)

pub fn undefined_ctor() -> Int = Nope(1)

pub fn no_fields() -> Int = Zero(1)

pub fn nullary_as_fn(f: fn(Int) -> Sum) -> fn(Int) -> Sum = Zero

pub fn bare_with_fields() -> Sum = One

pub fn bare_record() -> Rec = Rec

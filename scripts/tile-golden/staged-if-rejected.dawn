# Checker refusals complement the recording-time rank and shape checks.
# Host values have no Tile result protocol, and arm types never promote.
use tileir/dev.{Dev, Tile, f_const}
use std/dtype.{F64}
use std/narrow.{F32}
use std/int/i32.{I32}

pub fn float_condition(c: Tile[Float]) -> Unit !Dev = { if c { () } }
pub fn integer_condition(c: Tile[I32]) -> Unit !Dev = { if c { () } }
pub fn different_results(c: Tile[Bool], a: Tile[Float], b: Tile[F32]) -> Unit !Dev = {
  let _x = if c { a } else { b }
}
pub fn host_result(c: Tile[Bool]) -> Int !Dev = if c { 1 } else { 2 }
pub fn missing_else(c: Tile[Bool]) -> Tile[Float] !Dev = if c { f_const(F64, 1.0) }
pub fn missing_assignment(c: Tile[Bool]) -> Unit !Dev = {
  let _x = if c { f_const(F64, 1.0) } else { () }
}

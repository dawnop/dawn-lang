# An opaque type over a List or a Map: what it gets for free, and what it must
# write itself.
#
# `==` and `${...}` of the representation resolve their witness through the
# opaque and land on the target's impl: `Eq`, `Hash` and `Ord` are the only
# traits an opaque type inherits (spec 2.7, 2026-10-07). `[]` and `for..in`
# are not among them: a subscript and an iteration hand the elements out of
# the module, which is what the opaque type was declared to hide, so `Vec` and
# `Env` write their own `impl Index` and `impl Iter` below, each one a
# two-line forward to the representation. Until 2026-10-07 this file had no
# such impls and the subscripts fell through to the target; the output is the
# same, and what changed is that the impls are now the only way in. The
# refusal itself is pinned by scripts/checker-corpus/cases/opaque_index_iter.dawn.
#
# The direction matters, and the two halves of `main` show both. An opaque as
# the *subject* of `[]` asks for its own impl. An opaque as the *index* is
# matched like any type: with `opaque type Key = String` and `m: Map[Key,
# Int]`, `m["b"]` is refused -- "this index must be `Key`, got `String`" --
# even inside the declaring module, exactly as `v == [1, 2, 4]` is refused
# below. `Env`'s `Idx` is written as `String` in its impl, so `e["a"]` works:
# the opacity there is on the container, not on the key.
#
# opaque.dawn next door covers opaque *scalars* -- that an opaque has no
# representation of its own at run time. This one is about witness
# resolution through one, which is a different mechanism.
#
# Single-module on purpose: the conversions between `Vec` and `List[Int]` are
# only legal inside the declaring module.
use std/map

opaque type Vec = List[Int]

opaque type Env = Map[String, Int]

fn mkv() -> Vec = [1, 2, 3]

impl Index[Vec] {
  type Idx = Int
  type Item = Int
  fn index(v: Vec, i: Int) -> Int = {
    let xs: List[Int] = v
    xs[i]
  }
}

impl Iter[Vec] {
  type Cur = Int
  type Item = Int

  fn iter_start(v: Vec) -> Int = 0
  fn iter_done(v: Vec, c: Int) -> Bool = {
    let xs: List[Int] = v
    c >= len(xs)
  }
  fn iter_next(v: Vec, c: Int) -> Int = c + 1
  fn iter_get(v: Vec, c: Int) -> Int = {
    let xs: List[Int] = v
    xs[c]
  }
}

fn mke() -> Env = map.from([("a", 1)])

impl Index[Env] {
  type Idx = String
  type Item = Int
  fn index(e: Env, k: String) -> Int = {
    let m: Map[String, Int] = e
    m[k]
  }
}

## The other side of an inequality has to be a `Vec` too: `v == [1, 2, 4]` is
## rejected even inside the declaring module (`== requires both sides to have
## the same type: Vec vs List[Int]`). The opaque converts on the way into a
## parameter or a return, and *binds* everywhere a type has to match -- so
## `==` sees two `Vec`s and resolves one witness, which is the whole subject
## here.
fn other_v() -> Vec = [1, 2, 4]

fn other_e() -> Env = map.from([("a", 2)])

# An opaque type inherits no `Show` from its target (2026-09-24), so the two
# are printed through the List and the Map they hold.
fn list_of(v: Vec) -> List[Int] = v

fn map_of(e: Env) -> Map[String, Int] = e

pub fn main() -> Unit !io = {
  let v = mkv()
  println("-- opaque over List --")
  println(to_string(v == mkv()))
  println(to_string(v == other_v()))
  println("${list_of(v)}")
  for x in v {
    println(to_string(x))
  }

  let e = mke()
  println("-- opaque over Map --")
  println(to_string(e == mke()))
  println(to_string(e == other_e()))
  println("${map_of(e)}")

  println("-- and the subscript, through the type's own impl --")
  println(to_string(v[0]))
  println(to_string(v[2]))
  println(to_string(e["a"]))
  for x in v {
    println(to_string(v[x - 1]))
  }
}

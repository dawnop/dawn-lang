# Runtime configuration, read from the environment so the same binary runs both
# locally (direct) and on the server (sandboxed). Sensible defaults everywhere.
use java "java.lang.System"

fn env_or(name: String, fallback: String) -> String !io =
  match System.getenv(name) {
    Some(v) -> v
    None -> fallback
  }

# The `dawn` CLI used to compile user code. Server sets DAWN_BIN=/opt/dawn/bin/dawn.
pub fn dawn_bin() -> String !io = env_or("DAWN_BIN", "dawn")

# The JDK the server runs everything on: the compiler and the user's program
# for /run and /check, and `javap` for /compile. It is a pinned GraalVM CE
# unpacked for the runner alone (playground/deploy/DEPLOY.md step 2), so that
# the server runs the toolchain CI tests on and no system package moves the JRE
# other JVM services on the host share. Empty means "whatever is on the PATH",
# which is how a dev box runs.
pub fn jdk_home() -> String !io = env_or("PLAY_JDK", "")

# `bin/<tool>` of a JDK, or the bare name when there is no JDK configured. An
# absolute path matters in the sandbox: a unit starts with an empty environment
# and its PATH is systemd's default, which has no such JDK on it.
pub fn jdk_tool(jdk: String, tool: String) -> String =
  if jdk == "" { tool } else { "${jdk}/bin/${tool}" }

test "a tool is the bare name without a JDK and an absolute path with one" {
  assert jdk_tool("", "javap") == "javap"
  assert jdk_tool("/opt/dawn/graalvm-21", "java") == "/opt/dawn/graalvm-21/bin/java"
}

# The `java` used to run the compiled jar. PLAY_JAVA names another one (the
# contract test sets it to the JDK it runs on); otherwise PLAY_JDK's.
pub fn java_bin() -> String !io = env_or("PLAY_JAVA", jdk_tool(jdk_home(), "java"))

# The `javap` that lists the class the JVM view shows. It must come from the
# same JDK major as the one `dawn` runs on (docs/source-span-map-design.md
# 13.6: the listing is read on the pinned JDK), which is why a deploy needs a
# JDK and not only a JRE. PLAY_JAVAP overrides, as PLAY_JAVA does.
pub fn javap_bin() -> String !io = env_or("PLAY_JAVAP", jdk_tool(jdk_home(), "javap"))

# Wall-clock seconds a user program may run before it is force-killed.
pub fn timeout_secs() -> Int !io =
  match parse_int(env_or("PLAY_TIMEOUT", "10")) {
    Some(n) -> n
    None -> 10
  }

# Wall-clock seconds the *compiler* may take. Its own budget, not the run
# budget: `comptime` runs user code inside the compiler, so the compile phase is
# just as attackable as the run phase, but a cold compile is legitimately slower
# than the program it produces. 30s is generous for a single-file program and
# still finite.
pub fn compile_timeout_secs() -> Int !io =
  match parse_int(env_or("PLAY_COMPILE_TIMEOUT", "30")) {
    Some(n) -> n
    None -> 30
  }

# Whether to wrap execution in a systemd-run sandbox (stage 4d).
#
# Fail-closed: the sandbox is ON unless something explicitly turns it off. This
# service exists to compile and run code sent by strangers, so "sandbox off" is
# not a default a misconfiguration, a hand-started process or a copied unit file
# gets to fall into — the production unit setting PLAY_SANDBOX=1 protected only
# the deployment that remembered to. Running without it is still possible, but
# it now takes saying so: PLAY_UNSAFE_LOCAL=1.
pub fn sandbox_enabled() -> Bool !io = env_or("PLAY_UNSAFE_LOCAL", "0") != "1"

# The sudo-whitelisted wrapper that runs one command in a throwaway systemd unit.
pub fn sandbox_script() -> String !io =
  env_or("PLAY_SANDBOX_SCRIPT", "/opt/dawn/playground/sandbox/run-sandboxed.sh")

# TCP port to listen on (127.0.0.1 only; nginx proxies to it).
pub fn port() -> Int !io =
  match parse_int(env_or("PLAY_PORT", "8087")) {
    Some(n) -> n
    None -> 8087
  }

# Root for per-request work dirs. Empty = fall back to java.io.tmpdir (local dev).
# Under the sandbox this MUST NOT be /tmp: DynamicUser implies a private /tmp, so
# a /tmp workdir can't be bind-mounted in. The server sets it to a dedicated
# path (e.g. /var/lib/dawn-play/work) that ReadWritePaths can grant.
pub fn work_root() -> String !io = env_or("PLAY_WORK_ROOT", "")

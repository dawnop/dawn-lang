  let prefix = Some([JavaClassName("Earlier", None)])
  assert capture(prefix, append(prefix, reads).expect("append Java reads")) == Some(reads)
}

test "semantic reads relocate constructor rendering inputs without rewriting answers" {
  let ctor = CtorI { adt: 7, name: "Box", fields: [FieldI { name: "value", ty: TyVar("T", 8) }] }
  let reads = Some([RenderedConstructor(ctor, "Box(value: T): Box[T]")])

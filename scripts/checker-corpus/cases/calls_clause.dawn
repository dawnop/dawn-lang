# checker: the four roles of an effect's `calls` clause are resolved against the
# effect's own operations, and a recorded function names one call site at most.
# Each refusal lands on the word that is wrong (the role's operation, or the
# function), so a generated enter or exit never fails inside code nobody wrote.
pub effect NotAnOperation calls(enter = na, exit = nb, body_enter = nc, body_exit = nope) {
  fn na(name: String, at: Option[Loc]) -> Unit
  fn nb() -> Unit
  fn nc() -> Unit
}

pub effect SharedOperation calls(enter = sa, exit = sb, body_enter = sb, body_exit = sd) {
  fn sa(name: String, at: Option[Loc]) -> Unit
  fn sb() -> Unit
  fn sd() -> Unit
}

pub effect WrongShape calls(enter = wa, exit = wb, body_enter = wc, body_exit = wd) {
  fn wa(name: String) -> Unit
  fn wb() -> Unit
  fn wc() -> Unit
  fn wd() -> Unit
}

pub effect Rec calls(enter = ra, exit = rb, body_enter = rc, body_exit = rd) {
  fn ra(name: String, at: Option[Loc]) -> Unit
  fn rb() -> Unit
  fn rc() -> Unit
  fn rd() -> Unit
}

pub fn twice(x: Int, a: Loc = caller(), b: Loc = caller()) -> Int !Rec = x

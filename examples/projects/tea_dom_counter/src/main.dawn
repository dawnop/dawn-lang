# The whole io surface of the demo: one call. The same binary answers a
# browser (built with `dawnc build --target wasm --reactor`) and a shell:
#
#   $ echo '{"op":"init"}' | dawn run examples/projects/tea_dom_counter

use tea_core/app.{update, view}
use tea_dom/reactor.{serve}
use counter.{init, encode, decode}

pub fn main() -> Unit !io = serve(init(), encode, decode, update, view)
